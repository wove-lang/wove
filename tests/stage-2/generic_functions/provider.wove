(module generic_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let bias 7i32)
	(struct Result (generic (type T)) (fields (value T) (tag i32)))

	(fn wrap (generic (type T) (const Tag i32)) (params (value T)) (returns (specialize Result T))
		(body
			(return (struct:new (specialize Result T) (value value)
				(tag (i32:add Tag bias)))))))
