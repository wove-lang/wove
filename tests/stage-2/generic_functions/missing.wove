	(fn identity (generic (type T) (const Key i32)) (params (value T)) (returns T)
		(body (return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (call (specialize identity i32) 42i32)))))
