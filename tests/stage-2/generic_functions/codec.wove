(module explicit_generic_functions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Result (generic (type T)) (fields (value T) (ok bool)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn wrap (generic (type T)) (params (value T)) (returns (specialize Result T))
		(body (return (struct.new (specialize Result T) (value (local value)) (ok (bool true))))))

	(fn last (generic (const Width i32)) (params (bytes (array u8 Width))) (returns u8)
		(body (return (array.load (local bytes) (i32.sub (local Width) 1i32)))))

	(fn read_result (params (call (specialize Result u8))) (returns u8)
		(body (return (struct.get (local call) value))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let first (call (specialize last 4i32) (array.new (array u8 4) 1u8 2u8 3u8 19u8)))
			(let second (call (specialize last 0x04i32) (array.new (array u8 4) 1u8 3u8 2u8 23u8)))
			(let other (call (specialize last 2i32) (array.new (array u8 2) 1u8 23u8)))
			(let typed (call (specialize wrap u8) (local first)))
			(let signed (call (specialize wrap i32) (i32.from-u8 (local second))))
			(if (bool.not (bool.and (struct.get (local typed) ok)
				(u8.eq (local second) (local other))))
				(then (return 1i32)))
			(return (i32.add (i32.from-u8 (call read_result (local typed))) (struct.get (local signed) value))))))
