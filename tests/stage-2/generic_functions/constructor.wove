(module generic_constructor_operand
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cell (fields (value i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn make (generic (type T)) (params) (returns T)
		(body (return (struct.new T (value 42i32)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let cell (call (specialize make Cell)))
			(return (struct.get (local cell) value)))))
