(module transitive_function_requests
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn inner (generic (const Value i32)) (params) (returns i32)
		(body (return (local Value))))
	(fn outer (generic (const Value i32)) (params) (returns i32)
		(body (return (call (specialize inner Value)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let minimum (call (specialize outer -2147483648i32)))
			(if (i32.not-eq (local minimum) -2147483648i32) (then (return 1i32)))
			(return (i32.add (call (specialize outer 19i32)) (call (specialize outer 23i32)))))))
