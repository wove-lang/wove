	(struct ArgSpan (fields (start i32) (end i32)))
	(fn identity (generic (type T) (const Key i32)) (params (value T)) (returns T)
		(body (return (local value))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(return (call (specialize identity i32 4i32) 42u8)))))
