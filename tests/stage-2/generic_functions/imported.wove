(module generic_call_importer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only (as wrap wrap_first) (as wrap wrap_second)))
	(let bias 100i32)
	(struct Cell (fields (byte u8)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let first (call (specialize wrap_first Cell 35i32) (struct.new Cell (byte 42u8))))
			(let second (call (specialize wrap_second Cell (i32 35)) (struct.new Cell (byte 42u8))))
			(if (bool.not (bool.and (u8.eq (struct.get (struct.get (local first) value) byte) 42u8)
				(i32.eq (struct.get (local second) tag) 42i32)))
				(then (return (local bias))))
			(return (struct.get (local first) tag)))))
