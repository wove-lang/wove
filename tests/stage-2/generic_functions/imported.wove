(module generic_call_importer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only (as wrap wrap_first) (as wrap wrap_second)))
	(let bias 100i32)
	(struct Cell (fields (byte u8)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (call (specialize wrap_first Cell 35i32) (struct.new Cell (byte 42u8))))
			(let second (call (specialize wrap_second Cell (i32 35)) (struct.new Cell (byte 42u8))))
			(if (bool.not (bool.and (u8.eq (struct.get (struct.get first value) byte) 42u8)
				(i32.eq (struct.get second tag) 42i32)))
				(then (return bias)))
			(return (struct.get first tag)))))
