(module hash_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32:add (call helper_uehmdxxl) (call helper_rinkgnqa)))))
	(fn helper_uehmdxxl (params) (returns i32) (body (return 19i32)))
	(fn helper_rinkgnqa (params) (returns i32) (body (return 23i32))))
