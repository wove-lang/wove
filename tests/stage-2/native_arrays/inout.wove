(module native_array_inout
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./inout.h" (only (type Word) (type WideCount) inout_groups inout_wide observed_entries))
	(bridge c-header "./inout.h"
		(type Word (c-type "uint16_t"))
		(type WideCount (c-type "uint64_t"))
		(fn inout_groups (:pragma (c_array data count))
			(params (data (mut-array Word)) (count (mut-ref i32))) (returns i32))
		(fn inout_wide (:pragma (c_array data count))
			(params (data (mut-array Word)) (count (mut-ref WideCount))) (returns i32))
		(fn observed_entries (params) (returns i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let arguments (i32:dec (array:len argv)))
			(let-mut short (array:alloc Word 1i32))
			(let-mut wide (int:convert WideCount 1u64))
			(if (i32:eq arguments 3i32)
				(then
					(set wide (int:convert WideCount 4294967296u64))
					(return (call inout_wide (borrow-mut short) (borrow-mut wide)))))
			(let-mut count 0i32)
			(if (i32:gtz arguments)
				(then
					(set count -1i32)
					(if (i32:eq arguments 2i32) (then (set count 4i32)))
					(return (call inout_groups (borrow-mut short) (borrow-mut count)))))
			(let-mut empty (array:alloc Word 0i32))
			(let zero (call inout_groups (borrow-mut empty) (borrow-mut count)))
			(if (bool:or (i32:not-eq zero -31i32) (i32:not-eq count 3i32)) (then (return 1i32)))
			(set count 1i32)
			(let insufficient (call inout_groups (borrow-mut short) (borrow-mut count)))
			(if (bool:or (i32:not-eq insufficient -31i32) (i32:not-eq count 3i32)) (then (return 2i32)))
			(let-mut full (array:alloc Word count))
			(let status (call inout_groups (borrow-mut full) (borrow-mut count)))
			(if (bool:or (i32:not-eq status 29i32) (i32:not-eq count 3i32)) (then (return 3i32)))
			(if (u32:not-eq (int:convert u32 (array:load full 0i32)) 17u32) (then (return 4i32)))
			(if (u32:not-eq (int:convert u32 (array:load full 1i32)) 513u32) (then (return 5i32)))
			(if (u32:not-eq (int:convert u32 (array:load full 2i32)) 65535u32) (then (return 6i32)))
			(let wide_status (call inout_wide (borrow-mut short) (borrow-mut wide)))
			(if (bool:or (i32:not-eq wide_status 17i32) (u64:not-eq (int:convert u64 wide) 0u64))
				(then (return 7i32)))
			(if (u32:not-eq (int:convert u32 (array:load short 0i32)) 42u32) (then (return 8i32)))
			(if (i32:not-eq (call observed_entries) 4i32) (then (return 9i32)))
			(return 42i32))))
