(module native_array_width
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./arrays.h" (only (type Wide) (type WideCount) write_wide read_wide empty_wide))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn check_values
		(params (data (shared-slice Wide)))
		(returns bool)
		(body
			(return (bool.and (i32.eq (slice.len (local data)) (i32 2))
				(bool.and
					(u64.eq (int.convert u64 (slice.load (local data) (i32 0))) (u64 1099511627781))
					(u64.eq (int.convert u64 (slice.load (local data) (i32 1))) (u64 562949953421319)))))))
	(fn main
		(params (arguments (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(let argument_count (slice.len (local argv)))
			(let empty (array.alloc Wide (i32 0)))
			(if (i32.eq (local argument_count) (i32 3))
				(then (return (call empty_wide (borrow-shared (local empty)) (int.convert WideCount (u64 18446744073709551615))))))
			(if (bool.not (i32.eq (call empty_wide (borrow-shared (local empty)) (int.convert WideCount (u64 0))) (i32 0)))
				(then (return (i32 1))))
			(let-mut count (i32 2))
			(if (i32.eq (local argument_count) (i32 1)) (then (set (local count) (i32 3))))
			(if (i32.eq (local argument_count) (i32 2)) (then (set (local count) (i32 -1))))
			(let-mut data (array.alloc Wide (i32 2)))
			(if (bool.not (i32.eq (call write_wide (borrow-mut (local data)) (local count)) (i32 0)))
				(then (return (i32 2))))
			(if (bool.not (i32.eq (call read_wide (borrow-shared (local data))) (i32 0)))
				(then (return (i32 3))))
			(if (bool.not (call check_values (borrow-shared (local data)))) (then (return (i32 4))))
			(return (i32 42)))))
