(module native_array_pipe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<unistd.h>" (only pipe close))
	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (i32:lt (i32 0) (i32:dec (array:len argv)))
				(then
					(let-mut short (array:repeat (array i32 1) (i32 -1)))
					(return (call pipe (borrow-mut short)))))
			(let-mut descriptors (array:repeat (array i32 2) (i32 -1)))
			(if (bool:not (i32:eq (call pipe (borrow-mut descriptors)) (i32 0)))
				(then (return (i32 1))))
			(let reader (array:load descriptors (i32 0)))
			(let writer (array:load descriptors (i32 1)))
			(let closed_reader (call close reader))
			(let closed_writer (call close writer))
			(if (bool:or (i32:eq reader writer)
				(bool:not (bool:and (i32:eq closed_reader (i32 0)) (i32:eq closed_writer (i32 0)))))
				(then (return (i32 2))))
			(return (i32 42)))))
