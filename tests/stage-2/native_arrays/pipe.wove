(module native_array_pipe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<unistd.h>" (only pipe close))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (arguments (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(if (i32.lt (i32 0) (slice.len (local argv)))
				(then
					(let-mut short (array.repeat (array i32 1) (i32 -1)))
					(return (call pipe (borrow-mut (local short))))))
			(let-mut descriptors (array.repeat (array i32 2) (i32 -1)))
			(if (bool.not (i32.eq (call pipe (borrow-mut (local descriptors))) (i32 0)))
				(then (return (i32 1))))
			(let reader (array.load (local descriptors) (i32 0)))
			(let writer (array.load (local descriptors) (i32 1)))
			(let closed_reader (call close (local reader)))
			(let closed_writer (call close (local writer)))
			(if (bool.or (i32.eq (local reader) (local writer))
				(bool.not (bool.and (i32.eq (local closed_reader) (i32 0)) (i32.eq (local closed_writer) (i32 0)))))
				(then (return (i32 2))))
			(return (i32 42)))))
