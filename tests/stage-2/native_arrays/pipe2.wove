(module native_array_pipe2
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<unistd.h>" (only pipe2 close))
	(use c-header "<fcntl.h>" (only O_CLOEXEC))
	(use c-header "./pipe_flags.h" (only has_close_on_exec))
	(bridge c-header "./pipe_flags.h"
		(fn has_close_on_exec (params (descriptor i32)) (returns bool)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(:expect (tests "stage-2/native_arrays/cases.tsv") (issues "gh:wove-lang/wove:283"))
		(params (arguments (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(if (i32.lt 0i32 (array.len (local argv)))
				(then
					(let-mut short (array.repeat (array i32 1) -1i32))
					(return (call pipe2 (borrow-mut (local short)) (local O_CLOEXEC)))))
			(let-mut descriptors (array.repeat (array i32 2) -1i32))
			(if (bool.not (i32.eq (call pipe2 (borrow-mut (local descriptors)) (local O_CLOEXEC)) 0i32))
				(then (return 1i32)))
			(let reader (array.load (local descriptors) 0i32))
			(let writer (array.load (local descriptors) 1i32))
			(let reader_flag (call has_close_on_exec (local reader)))
			(let writer_flag (call has_close_on_exec (local writer)))
			(let closed_reader (call close (local reader)))
			(let closed_writer (call close (local writer)))
			(if (bool.or (i32.eq (local reader) (local writer))
				(bool.not (bool.and (local reader_flag) (local writer_flag))))
				(then (return 2i32)))
			(if (bool.not (bool.and (i32.eq (local closed_reader) 0i32) (i32.eq (local closed_writer) 0i32)))
				(then (return 3i32)))
			(return 42i32))))
