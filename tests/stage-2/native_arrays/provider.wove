(module native_array_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./arrays.h"
		(type Wide (c-type "uint64_t"))
		(type OtherWide (c-type "uint64_t"))
		(type WideCount (c-type "uint64_t"))
		(fn write_wide
			(:pragma (c_array data count))
			(params (data (mut-array Wide)) (count i32))
			(returns i32))
		(fn read_wide
			(:pragma (c_array data 2))
			(params (data (shared-array Wide)))
			(returns i32))
		(fn empty_wide
			(:pragma (c_array data count))
			(params (data (shared-array Wide)) (count WideCount))
			(returns i32))
		(fn invalid_count
			(:pragma (c_array data -1))
			(params (data (shared-array Wide)))
			(returns i32))
		(fn invalid_named_count
			(:pragma (c_array data count))
			(params (data (shared-array Wide)) (count bool))
			(returns i32))
		(fn unbounded
			(params (data (shared-array Wide)))
			(returns i32))))
