(module invalid_shared_array_count
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./inout.h" (only checked))
	(bridge c-header "./inout.h"
		(fn checked (:pragma (c_array data count))
			(params (data (shared-array u16)) (count (mut-ref i32))) (returns i32)))
	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
