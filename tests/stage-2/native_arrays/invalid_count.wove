(module native_array_invalid_count
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./arrays.h" (only (type Wide) invalid_count))
	(fn main
		(params)
		(returns i32)
		(body
			(let data (array.alloc Wide (i32 2)))
			(return (call invalid_count (borrow-shared (local data)))))))
