(module native_array_wrong_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./arrays.h" (only (type OtherWide) read_wide))
	(fn main
		(params)
		(returns i32)
		(body
			(let data (array.alloc OtherWide (i32 2)))
			(return (call read_wide (borrow-shared (local data)))))))
