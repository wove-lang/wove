(module native_array_unbounded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./arrays.h" (only (type Wide) unbounded))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let data (array.alloc Wide (i32 2)))
			(return (call unbounded (borrow-shared (local data)))))))
