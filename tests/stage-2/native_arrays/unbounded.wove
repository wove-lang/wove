(module native_array_unbounded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./arrays.h" (only (type Wide) unbounded))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let data (array.alloc Wide (i32 2)))
			(return (call unbounded (borrow-shared data))))))
