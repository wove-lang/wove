	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Value (variants (Word i32) (Empty)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (match (enum.new Value Word 1i32) (case Word (bind saved) (local saved)) (case Empty (local saved)))))))
