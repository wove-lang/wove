(module match_native_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only fopen fclose))
	(let path "tests/stage-2/native_records/data.txt")
	(let read_mode "r")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared (local path)) (borrow-shared (local read_mode))))
			(let status (match (array.len (local args))
				(case 0i32 (call fclose (move (local stream))))
				(case _ (call fclose (move (local stream))))))
			(return (i32.add.wrapping 42i32 (local status))))))
