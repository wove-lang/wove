(module match_native_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only fopen fclose))
	(let path "tests/stage-2/native_records/data.txt")
	(let read_mode "r")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared read_mode)))
			(let status (match (i32:dec (array:len args))
				(case 0i32 (call fclose (move stream)))
				(case _ (call fclose (move stream)))))
			(return (i32:add 42i32 status)))))
