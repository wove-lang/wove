(module match_bytecode
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Instruction (variants (Push i64) (Add) (Drop)))
	(struct Request (fields (code i32) (size u32)))
	(enum Entry (variants (Accepted Request) (Invalid)))

	(fn read_opcode (params (opcode u32) (reads (mut-ref i32))) (returns u32)
		(body
			(set (local reads) (i32.add (local reads) 1i32))
			(return (local opcode))))

	(fn push (params (word i64) (reads (mut-ref i32))) (returns Instruction)
		(body
			(set (local reads) (i32.add (local reads) 1i32))
			(return (enum.new Instruction Push (local word)))))

	(fn decode
		(:expect (issues "gh:wove-lang/wove:378"))
		(params (opcode u32) (word i64) (subjects (mut-ref i32)) (values (mut-ref i32)))
		(returns Instruction)
		(body
			(return (match (call read_opcode (local opcode) (borrow-mut (local subjects)))
				(case 0u32 (call push (local word) (borrow-mut (local values))))
				(case (u32 1) (enum.new Instruction Add))
				(case 0xffffffffu32 (enum.new Instruction Drop))
				(case _ (enum.new Instruction Drop))))))

	(fn evaluate (params (instruction Instruction)) (returns i32)
		(body
			(let word 97i32)
			(return (match (local instruction)
				(case Push (bind word)
					(match (local word)
						(case -0x8000000000000000i64 40i32)
						(case 9223372036854775807i64 41i32)
						(case _ (int.convert i32 (local word)))))
				(case Add 2i32)
				(case Drop (local word))))))

	(fn request_code (params (entry Entry)) (returns i32)
		(body
			(return (match (struct.get
					(match (local entry)
						(case Accepted (bind request) (local request))
						(case _ (struct.new Request (code -1i32) (size 0u32))))
					code)
				(case 42 42i32)
				(case _ -1i32)))))

	(fn statement (params (value u32) (result (mut-ref i32))) (returns void)
		(body
			(match (local value)
				(case 1 (set (local result) 42i32))
				(case (u32 4294967295) (set (local result) 7i32))
				(case _ (set (local result) -1i32)))
			(return)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut reads 0i32)
			(let-mut values 0i32)
			(let instruction (call decode 0u32 -9223372036854775808i64 (borrow-mut (local reads)) (borrow-mut (local values))))
			(if (bool.not (i32.eq (call evaluate (local instruction)) 40i32)) (then (return 1i32)))
			(let add (call decode 1u32 0i64 (borrow-mut (local reads)) (borrow-mut (local values))))
			(if (bool.not (i32.eq (call evaluate (local add)) 2i32)) (then (return 2i32)))
			(let drop (call decode 2u32 0i64 (borrow-mut (local reads)) (borrow-mut (local values))))
			(if (bool.not (i32.eq (call evaluate (local drop)) 97i32)) (then (return 3i32)))
			(let top (call decode 0xffffffffu32 0i64 (borrow-mut (local reads)) (borrow-mut (local values))))
			(if (bool.not (i32.eq (call evaluate (local top)) 97i32)) (then (return 4i32)))
			(if (bool.not (i32.eq (local reads) 4i32)) (then (return 5i32)))
			(if (bool.not (i32.eq (local values) 1i32)) (then (return 6i32)))
			(let entry (enum.new Entry Accepted (struct.new Request (code 42i32) (size 4294967295u32))))
			(if (bool.not (i32.eq (call request_code (local entry)) 42i32)) (then (return 7i32)))
			(if (bool.not (i32.eq (call request_code (enum.new Entry Invalid)) -1i32)) (then (return 8i32)))
			(let-mut result 0i32)
			(call statement 4294967295u32 (borrow-mut (local result)))
			(if (bool.not (i32.eq (local result) 7i32)) (then (return 9i32)))
			(call statement 0u32 (borrow-mut (local result)))
			(if (bool.not (i32.eq (local result) -1i32)) (then (return 10i32)))
			(call statement 1u32 (borrow-mut (local result)))
			(return (local result)))))
