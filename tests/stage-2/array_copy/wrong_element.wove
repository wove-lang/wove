(module copy_wrong_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut output (array.alloc i32 1i32))
			(let input (array.new (array u32 1) 42u32))
			(let copied (array.try-copy-from (borrow-mut (local output)) (borrow-shared (local input))))
			(return 42i32)))
)
