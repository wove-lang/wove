(module copy_immutable_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let output (array:new (array u8 1) 9u8))
			(let input (array:new (array u8 1) 42u8))
			(let copied (array:try-copy-from (borrow-mut output) (borrow-shared input)))
			(return 42i32)))
)
