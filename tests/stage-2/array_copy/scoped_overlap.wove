(module copy_scoped_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Pair (fields (left (array i32 1)) (right (array i32 1))))
	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut pair (struct:new Pair
				(left (array:new (array i32 1) 0i32))
				(right (array:new (array i32 1) 42i32))))
			(let destination (borrow-mut (struct:get pair left)))
			(let copied (array:try-copy-from (borrow-mut destination)
				(borrow-shared (struct:get pair left))))
			(return 42i32)))
)
