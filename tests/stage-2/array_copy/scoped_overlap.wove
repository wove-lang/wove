(module copy_scoped_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Pair (fields (left (array i32 1)) (right (array i32 1))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut pair (struct.new Pair
				(left (array.new (array i32 1) 0i32))
				(right (array.new (array i32 1) 42i32))))
			(let destination (borrow-mut (struct.get (local pair) left)))
			(let copied (array.try-copy-from (borrow-mut (local destination))
				(borrow-shared (struct.get (local pair) left))))
			(return 42i32)))
)
