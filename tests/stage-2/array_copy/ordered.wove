(module copy_ordered_endpoints
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn endpoint
		(params (next (mut-ref i32)) (expected i32) (value i32))
		(returns i32)
		(body
			(if (i32.not-eq (local next) (local expected)) (then (return -1i32)))
			(set (local next) (i32.inc (local next)))
			(return (local value))))

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut next 0i32)
			(let-mut output (array.repeat (array f64 4) 1.25f64))
			(let input (array.new (array f64 2) 2.5f64 4.0f64))
			(if (bool.not (array.try-copy-from
				(borrow-mut (array.range (local output)
					(call endpoint (borrow-mut (local next)) 0i32 1i32)
					(call endpoint (borrow-mut (local next)) 1i32 4i32)))
				(borrow-shared (array.range (local input)
					(call endpoint (borrow-mut (local next)) 2i32 0i32)
					(call endpoint (borrow-mut (local next)) 3i32 2i32)))))
				(then (return 1i32)))
			(if (i32.not-eq (local next) 4i32) (then (return 2i32)))
			(if (f64.not-eq (array.load (local output) 0i32) 1.25f64) (then (return 3i32)))
			(if (f64.not-eq (array.load (local output) 1i32) 2.5f64) (then (return 4i32)))
			(if (f64.not-eq (array.load (local output) 2i32) 4.0f64) (then (return 5i32)))
			(if (f64.not-eq (array.load (local output) 3i32) 1.25f64) (then (return 6i32)))
			(return 42i32)))
)
