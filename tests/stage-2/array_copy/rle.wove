(module rle_literal_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn copy_literal
		(params (output (mut-array u8)) (input (shared-array u8)))
		(returns bool)
		(body
			(let window (borrow-mut (array.range (local output) 1i32 4i32)))
			(return (array.try-copy-from (borrow-mut (local window))
				(borrow-shared (array.range (local input) 1i32 3i32))))))

	(fn reject_large
		(params (output (mut-array u8)) (input (shared-array u8)))
		(returns bool)
		(body
			(return (array.try-copy-from (borrow-mut (array.range (local output) 1i32 3i32))
				(borrow-shared (local input))))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let input (array.new (array u8 4) 3u8 255u8 0u8 9u8))
			(let-mut output (array.repeat (array u8 4) 42u8))
			(if (call reject_large (borrow-mut (local output)) (borrow-shared (local input))) (then (return 1i32)))
			(for (bind byte) (borrow-shared (local output))
				(body
					(if (u8.not-eq (local byte) 42u8) (then (return 2i32)))))
			(if (bool.not (call copy_literal (borrow-mut (local output)) (borrow-shared (local input))))
				(then (return 3i32)))
			(if (u8.not-eq (array.load (local output) 0i32) 42u8) (then (return 4i32)))
			(if (u8.not-eq (array.load (local output) 1i32) 255u8) (then (return 5i32)))
			(if (u8.not-eqz (array.load (local output) 2i32)) (then (return 6i32)))
			(if (bool.not (array.try-copy-from
				(borrow-mut (array.range (local output) 4i32 4i32))
				(borrow-shared (array.range (local input) 4i32 4i32))))
				(then (return 7i32)))
			(return (i32.from-u8 (array.load (local output) 3i32)))))
)
