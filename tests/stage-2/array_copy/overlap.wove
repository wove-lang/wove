(module copy_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut output (array.alloc u8 4i32))
			(let copied (array.try-copy-from
				(borrow-mut (array.range output 1i32 4i32))
				(borrow-shared (array.range output 0i32 2i32))))
			(return 42i32)))
)
