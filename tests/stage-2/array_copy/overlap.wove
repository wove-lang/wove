(module copy_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut output (array.alloc u8 4i32))
			(let copied (array.try-copy-from
				(borrow-mut (array.range (local output) 1i32 4i32))
				(borrow-shared (array.range (local output) 0i32 2i32))))
			(return 42i32)))
)
