(module quantile_scratch_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Sketch (fields (values (array i32 4)) (spare (array i32 4))))

	(fn finish_merge
		(params (values (mut-array i32 4)) (scratch (shared-array i32)))
		(returns bool)
		(body
			(return (array.try-copy-from (borrow-mut values)
				(borrow-shared (array.range scratch 1i32 4i32))))))

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut sketch (struct.new Sketch
				(values (array.repeat (array i32 4) 42i32))
				(spare (array.new (array i32 4) 0i32 -2147483648i32 1i32 2147483647i32))))
			(let-mut scratch (array.alloc i32 5i32))
			(if (bool.not (array.try-copy-from
				(borrow-mut scratch) (borrow-shared (struct.get sketch spare))))
				(then (return 1i32)))
			(if (bool.not (call finish_merge
				(borrow-mut (struct.get sketch values)) (borrow-shared scratch)))
				(then (return 2i32)))
			(if (i32.not-eq (array.load (struct.get sketch values) 0i32) -2147483648i32)
				(then (return 3i32)))
			(if (i32.not-eq (array.load (struct.get sketch values) 1i32) 1i32) (then (return 4i32)))
			(if (i32.not-eq (array.load (struct.get sketch values) 2i32) 2147483647i32)
				(then (return 5i32)))
			(if (i32.not-eq (array.len scratch) 5i32) (then (return 6i32)))
			(if (bool.not (array.try-copy-from
				(borrow-mut (struct.get sketch spare))
				(borrow-shared (struct.get sketch values))))
				(then (return 7i32)))
			(return (array.load (struct.get sketch spare) 3i32))))
)
