(module copy_shared_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut output (array:alloc u8 1i32))
			(let input (array:new (array u8 1) 42u8))
			(let copied (array:try-copy-from (borrow-shared output) (borrow-shared input)))
			(return 42i32)))
)
