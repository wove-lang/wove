(module copy_shared_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut output (array.alloc u8 1i32))
			(let input (array.new (array u8 1) 42u8))
			(let copied (array.try-copy-from (borrow-shared (local output)) (borrow-shared (local input))))
			(return 42i32)))
)
