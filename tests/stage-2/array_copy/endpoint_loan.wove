(module copy_endpoint_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn disturb
		(params (output (mut-array u8)))
		(returns i32)
		(body
			(array:set output 0i32 7u8)
			(return 1i32)))

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut output (array:alloc u8 2i32))
			(let input (array:new (array u8 2) 17u8 42u8))
			(let copied (array:try-copy-from
				(borrow-mut output)
				(borrow-shared (array:range input
					0i32 (call disturb (borrow-mut output))))))
			(return 42i32)))
)
