(module copy_scoped_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Pair (fields (left (array i32 2)) (right (array i32 2))))

	(fn copy_shared_field (params (pair (mut-ref Pair))) (returns bool)
		(body
			(let source (borrow-shared (struct.get (local pair) left)))
			(return (array.try-copy-from (borrow-mut (struct.get (local pair) right))
				(borrow-shared (local source))))))

	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut pair (struct.new Pair
				(left (array.new (array i32 2) 0i32 0i32))
				(right (array.new (array i32 2) -2147483648i32 42i32))))
			(if (bool true)
				(then
					(let destination (borrow-mut (struct.get (local pair) left)))
					(if (bool.not (array.try-copy-from (borrow-mut (local destination))
						(borrow-shared (struct.get (local pair) right))))
						(then (return 1i32)))
					(if (i32.not-eq (array.load (local destination) 0i32) -2147483648i32)
						(then (return 2i32)))))
			(array.store (struct.get (local pair) right) 1i32 0i32)
			(if (bool.not (call copy_shared_field (borrow-mut (local pair))))
				(then (return 3i32)))
			(return (array.load (struct.get (local pair) right) 1i32))))
)
