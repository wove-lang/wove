(module rotate_right
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn input_word
		(params (evaluations (mut-ref i32)))
		(returns u64)
		(body
			(set (local evaluations) (i32.add (local evaluations) 1i32))
			(return 0x8123456789abcdefu64)))

	(fn input_count
		(params (evaluations (mut-ref i32)) (count i32))
		(returns i32)
		(body
			(if (bool.not (i32.eq (local evaluations) 1i32)) (then (return -1i32)))
			(set (local evaluations) (i32.add (local evaluations) 1i32))
			(return (local count))))

	(fn rotates_to
		(params (count i32) (expected u64))
		(returns bool)
		(body
			(let-mut evaluations 0i32)
			(let result (u64.rotr
				(call input_word (borrow-mut (local evaluations)))
				(call input_count (borrow-mut (local evaluations)) (local count))))
			(return (bool.and (i32.eq (local evaluations) 2i32)
				(int.eq u64 (local result) (local expected))))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool.not (call rotates_to 0i32 0x8123456789abcdefu64)) (then (return 1i32)))
			(if (bool.not (call rotates_to 1i32 0xc091a2b3c4d5e6f7u64)) (then (return 2i32)))
			(if (bool.not (call rotates_to 63i32 0x02468acf13579bdfu64)) (then (return 3i32)))
			(return 42i32))))
