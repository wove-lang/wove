(module u64_mix
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let maximum (u64 00018446744073709551615))

	(struct Lane (fields (a u64) (b u64) (c u64) (d u64)))

	(fn rotate
		(params (value u64) (count i32))
		(returns u64)
		(body
			(return (u64.or (u64.shr (local value) (local count))
				(u64.shl (local value) (i32.sub.wrapping (i32 64) (local count)))))))

	(fn mix
		(params (lane Lane) (x u64) (y u64))
		(returns Lane)
		(body
			(let-mut a (u64.add.wrapping (u64.add.wrapping (record.get (local lane) a)
				(record.get (local lane) b)) (local x)))
			(let-mut d (call rotate (u64.xor (record.get (local lane) d) (local a)) (i32 32)))
			(let-mut c (u64.add.wrapping (record.get (local lane) c) (local d)))
			(let-mut b (call rotate (u64.xor (record.get (local lane) b) (local c)) (i32 24)))
			(set (local a) (u64.add.wrapping (u64.add.wrapping (local a) (local b)) (local y)))
			(set (local d) (call rotate (u64.xor (local d) (local a)) (i32 16)))
			(set (local c) (u64.add.wrapping (local c) (local d)))
			(set (local b) (call rotate (u64.xor (local b) (local c)) (i32 63)))
			(return (record.make Lane (a (local a)) (b (local b)) (c (local c)) (d (local d))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let top (u64.shl (u64 1) (i32 63)))
			(if (bool.not (bool.and (u64.eq (local top) (u64 9223372036854775808))
					(u64.eq (u64.shr (local top) (i32 63)) (u64 1))))
				(then (return (i32 1))))
			(if (bool.not (bool.and (u64.eq (u64.shl (local maximum) (i32 0)) (local maximum))
					(u64.eq (u64.shr (local maximum) (i32 32)) (u64 4294967295))))
				(then (return (i32 2))))
			(if (bool.not (bool.and
					(u64.lt (u64 9223372036854775807) (local top))
					(u64.eq (u64.and (local maximum) (local top)) (local top))))
				(then (return (i32 3))))
			(if (bool.not (bool.and (int.eq u64 (u64.not (u64 -000)) (local maximum))
					(u64.eq (u64.add.wrapping (local maximum) (u64 1)) (u64 0))))
				(then (return (i32 4))))
			(let limbs (u32.xor (u32.not (u32 0)) (u32 4294901760)))
			(if (bool.not (bool.and
					(u64.eq (int.convert u64 (local limbs)) (u64 65535))
					(u32.eq (int.convert u32 (u64 4294967295)) (u32 4294967295))))
				(then (return (i32 5))))
			(if (bool.not (u64.eq (int.convert u64 (i32 2147483647)) (u64 2147483647)))
				(then (return (i32 6))))
			(let initial (record.make Lane
				(a (u64 7640891576956012808)) (b (u64 13503953896175478587))
				(c (u64 4354685564936845355)) (d (u64 11912009170470909681))))
			(let mixed (call mix (local initial) (local maximum) (u64 81985529216486895)))
			(if (bool.not (bool.and (u64.eq (record.get (local mixed) a) (u64 4652803580490146347))
					(u64.eq (record.get (local mixed) b) (u64 16424964169165427203))))
				(then (return (i32 7))))
			(if (bool.not (bool.and (u64.eq (record.get (local mixed) c) (u64 16718946414135823099))
					(u64.eq (record.get (local mixed) d) (u64 9510589798541684985))))
				(then (return (i32 8))))
			(return (i32 42)))))
