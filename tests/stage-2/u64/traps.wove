(module u64_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./ops.wove" (only shift narrow widen))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(let count (array.len (local argv)))
			(if (i32.eq (local count) (i32 0))
				(then (return (int.convert i32 (call shift (u64 1) (i32 -1))))))
			(if (i32.eq (local count) (i32 1))
				(then (return (int.convert i32 (call shift (u64 1) (i32 64))))))
			(if (i32.eq (local count) (i32 2))
				(then (return (int.convert i32 (call narrow (u64 18446744073709551615))))))
			(return (int.convert i32 (call widen (i32 -1)))))))
