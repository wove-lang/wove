(module rotate_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./rotate_provider.wove" (only rotate_word))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (if (i32:eq (i32:dec (array:len spans)) 0i32) (then -1i32) (else 64i32)))
			(let word (call rotate_word count))
			(return 1i32))))
