(module rotate_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./rotate_provider.wove" (only rotate_word))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let count (if (i32.eq (array.len (local spans)) 0i32) (then -1i32) (else 64i32)))
			(let word (call rotate_word (local count)))
			(return 1i32))))
