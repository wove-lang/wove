(module u64_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn shift
		(params (word u64) (count i32))
		(returns u64)
		(body (return (u64.shr (local word) (local count)))))

	(fn narrow
		(params (word u64))
		(returns u32)
		(body (return (int.convert u32 (local word)))))

	(fn widen
		(params (value i32))
		(returns u64)
		(body (return (int.convert u64 (local value))))))
