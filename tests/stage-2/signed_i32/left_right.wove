(module signed_shift_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn shift_left
		(params (value i32) (count i32)) (returns i32)
		(body (return (i32.and 0i32 (i32.shl (local value) (local count))))))

	(fn shift_right
		(params (value i32) (count i32)) (returns i32)
		(body (return (i32.or -1i32 (i32.shr (local value) (local count))))))
)
