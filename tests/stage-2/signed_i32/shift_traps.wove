(module signed_shift_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./left_right.wove" (only shift_left shift_right))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let argc (i32.dec (array.len (local args))))
			(if (i32.eq (local argc) 0i32) (then (return (call shift_left -1i32 -1i32))))
			(if (i32.eq (local argc) 1i32) (then (return (call shift_right -1i32 32i32))))
			(return (call shift_left -1i32 33i32))))
)
