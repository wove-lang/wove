(module signed_rle_header
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_header
		(params (decoded i32) (encoded i32)) (returns (array u8 4))
		(body
			(return (array:new (array u8 4)
				(u8:from-i32 (i32:and decoded 255i32))
				(u8:from-i32 (i32:shr decoded 8i32))
				(u8:from-i32 (i32:and encoded 255i32))
				(u8:from-i32 (i32:shr encoded 8i32))))))

	(fn read_size
		(params (low u8) (high u8)) (returns i32)
		(body (return (i32:or (i32:from-u8 low) (i32:shl (i32:from-u8 high) 8i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:310"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let header (call write_header 32768i32 33024i32))
			(if (bool:not (u8:eq (array:get header 0i32) 0u8)) (then (return 1i32)))
			(if (bool:not (u8:eq (array:get header 1i32) 128u8)) (then (return 2i32)))
			(if (bool:not (u8:eq (array:get header 2i32) 0u8)) (then (return 3i32)))
			(if (bool:not (u8:eq (array:get header 3i32) 129u8)) (then (return 4i32)))
			(if (bool:not (i32:eq (call read_size (array:get header 0i32) (array:get header 1i32)) 32768i32))
				(then (return 5i32)))
			(if (bool:not (i32:eq (call read_size (array:get header 2i32) (array:get header 3i32)) 33024i32))
				(then (return 6i32)))
			(let maximum (call write_header 65535i32 0i32))
			(if (bool:not (i32:eq (call read_size (array:get maximum 0i32) (array:get maximum 1i32)) 65535i32))
				(then (return 7i32)))
			(if (bool:not (i32:eq (call read_size (array:get maximum 2i32) (array:get maximum 3i32)) 0i32))
				(then (return 8i32)))

			(let sign (i32:shl 1i32 31i32))
			(if (bool:not (i32:eq sign -2147483648i32)) (then (return 9i32)))
			(if (bool:not (i32:eq (i32:shl sign 1i32) 0i32)) (then (return 10i32)))
			(if (bool:not (i32:eq (i32:shl -1i32 1i32) -2i32)) (then (return 11i32)))
			(if (bool:not (i32:eq (i32:shl sign 0i32) sign)) (then (return 12i32)))
			(if (bool:not (i32:eq (i32:shr sign 31i32) -1i32)) (then (return 13i32)))
			(if (bool:not (i32:eq (i32:shr sign 1i32) -1073741824i32)) (then (return 14i32)))
			(if (bool:not (i32:eq (i32:shr -3i32 1i32) -2i32)) (then (return 15i32)))
			(if (bool:not (i32:eq (i32:shr sign 0i32) sign)) (then (return 16i32)))
			(if (bool:not (i32:eq (i32:shr 2147483647i32 31i32) 0i32)) (then (return 17i32)))
			(if (bool:not (i32:eq (i32:and -1i32 sign) sign)) (then (return 18i32)))
			(if (bool:not (i32:eq (i32:or sign 1i32) -2147483647i32)) (then (return 19i32)))
			(return 42i32)))
)
