(module signed_rle_header
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn write_header
		(params (decoded i32) (encoded i32)) (returns (array u8 4))
		(body
			(return (array.new (array u8 4)
				(u8.from-i32 (i32.and (local decoded) 255i32))
				(u8.from-i32 (i32.shr (local decoded) 8i32))
				(u8.from-i32 (i32.and (local encoded) 255i32))
				(u8.from-i32 (i32.shr (local encoded) 8i32))))))

	(fn read_size
		(params (low u8) (high u8)) (returns i32)
		(body (return (i32.or (i32.from-u8 (local low)) (i32.shl (i32.from-u8 (local high)) 8i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:310"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let header (call write_header 32768i32 33024i32))
			(if (bool.not (u8.eq (array.load (local header) 0i32) 0u8)) (then (return 1i32)))
			(if (bool.not (u8.eq (array.load (local header) 1i32) 128u8)) (then (return 2i32)))
			(if (bool.not (u8.eq (array.load (local header) 2i32) 0u8)) (then (return 3i32)))
			(if (bool.not (u8.eq (array.load (local header) 3i32) 129u8)) (then (return 4i32)))
			(if (bool.not (i32.eq (call read_size (array.load (local header) 0i32) (array.load (local header) 1i32)) 32768i32))
				(then (return 5i32)))
			(if (bool.not (i32.eq (call read_size (array.load (local header) 2i32) (array.load (local header) 3i32)) 33024i32))
				(then (return 6i32)))
			(let maximum (call write_header 65535i32 0i32))
			(if (bool.not (i32.eq (call read_size (array.load (local maximum) 0i32) (array.load (local maximum) 1i32)) 65535i32))
				(then (return 7i32)))
			(if (bool.not (i32.eq (call read_size (array.load (local maximum) 2i32) (array.load (local maximum) 3i32)) 0i32))
				(then (return 8i32)))

			(let sign (i32.shl 1i32 31i32))
			(if (bool.not (i32.eq (local sign) -2147483648i32)) (then (return 9i32)))
			(if (bool.not (i32.eq (i32.shl (local sign) 1i32) 0i32)) (then (return 10i32)))
			(if (bool.not (i32.eq (i32.shl -1i32 1i32) -2i32)) (then (return 11i32)))
			(if (bool.not (i32.eq (i32.shl (local sign) 0i32) (local sign))) (then (return 12i32)))
			(if (bool.not (i32.eq (i32.shr (local sign) 31i32) -1i32)) (then (return 13i32)))
			(if (bool.not (i32.eq (i32.shr (local sign) 1i32) -1073741824i32)) (then (return 14i32)))
			(if (bool.not (i32.eq (i32.shr -3i32 1i32) -2i32)) (then (return 15i32)))
			(if (bool.not (i32.eq (i32.shr (local sign) 0i32) (local sign))) (then (return 16i32)))
			(if (bool.not (i32.eq (i32.shr 2147483647i32 31i32) 0i32)) (then (return 17i32)))
			(if (bool.not (i32.eq (i32.and -1i32 (local sign)) (local sign))) (then (return 18i32)))
			(if (bool.not (i32.eq (i32.or (local sign) 1i32) -2147483647i32)) (then (return 19i32)))
			(return 42i32)))
)
