(module integer_bits_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:310"))
		(body
			(if (i32:eqz (i32:dec (array:len args))) (then (return 42i32)))
			(let bytes (array:load args 1i32))
			(match (array:load bytes 0i32)
				(case 97u8 (let shifted (i8:shl 1i8 -1i32)) (return 99i32))
				(case 98u8 (let shifted (i8:shr 1i8 8i32)) (return 99i32))
				(case 99u8 (let shifted (u8:shl 1u8 -1i32)) (return 99i32))
				(case 100u8 (let shifted (u8:shr 1u8 8i32)) (return 99i32))
				(case 101u8 (let shifted (i16:shl 1i16 -1i32)) (return 99i32))
				(case 102u8 (let shifted (i16:shr 1i16 16i32)) (return 99i32))
				(case 103u8 (let shifted (u16:shl 1u16 -1i32)) (return 99i32))
				(case 104u8 (let shifted (u16:shr 1u16 16i32)) (return 99i32))
				(case 105u8 (let shifted (i32:shl 1i32 -1i32)) (return 99i32))
				(case 106u8 (let shifted (i32:shr 1i32 32i32)) (return 99i32))
				(case 107u8 (let shifted (u32:shl 1u32 -1i32)) (return 99i32))
				(case 108u8 (let shifted (u32:shr 1u32 32i32)) (return 99i32))
				(case 109u8 (let shifted (i64:shl 1i64 -1i32)) (return 99i32))
				(case 110u8 (let shifted (i64:shr 1i64 64i32)) (return 99i32))
				(case 111u8 (let shifted (u64:shl 1u64 -1i32)) (return 99i32))
				(case 112u8 (let shifted (u64:shr 1u64 64i32)) (return 99i32))
				(case 65u8 (let rotated (i8:rotl 1i8 -1i32)) (return 99i32))
				(case 66u8 (let rotated (i8:rotr 1i8 8i32)) (return 99i32))
				(case 67u8 (let rotated (u8:rotl 1u8 -1i32)) (return 99i32))
				(case 68u8 (let rotated (u8:rotr 1u8 8i32)) (return 99i32))
				(case 69u8 (let rotated (i16:rotl 1i16 -1i32)) (return 99i32))
				(case 70u8 (let rotated (i16:rotr 1i16 16i32)) (return 99i32))
				(case 71u8 (let rotated (u16:rotl 1u16 -1i32)) (return 99i32))
				(case 72u8 (let rotated (u16:rotr 1u16 16i32)) (return 99i32))
				(case 73u8 (let rotated (i32:rotl 1i32 -1i32)) (return 99i32))
				(case 74u8 (let rotated (i32:rotr 1i32 32i32)) (return 99i32))
				(case 75u8 (let rotated (u32:rotl 1u32 -1i32)) (return 99i32))
				(case 76u8 (let rotated (u32:rotr 1u32 32i32)) (return 99i32))
				(case 77u8 (let rotated (i64:rotl 1i64 -1i32)) (return 99i32))
				(case 78u8 (let rotated (i64:rotr 1i64 64i32)) (return 99i32))
				(case 79u8 (let rotated (u64:rotl 1u64 -1i32)) (return 99i32))
				(case 80u8 (let rotated (u64:rotr 1u64 64i32)) (return 99i32))
				(case _ (return 98i32)))))
)
