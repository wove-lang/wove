(module integer_bit_counts
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check_i8 (params (word i8) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (i8.clz (local word)) (local leading))
			(bool.and (i32.eq (i8.ctz (local word)) (local trailing))
				(i32.eq (i8.popcnt (local word)) (local population)))))))

	(fn check_u8 (params (word u8) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (u8.clz (local word)) (local leading))
			(bool.and (i32.eq (u8.ctz (local word)) (local trailing))
				(i32.eq (u8.popcnt (local word)) (local population)))))))

	(fn check_i16 (params (word i16) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (i16.clz (local word)) (local leading))
			(bool.and (i32.eq (i16.ctz (local word)) (local trailing))
				(i32.eq (i16.popcnt (local word)) (local population)))))))

	(fn check_u16 (params (word u16) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (u16.clz (local word)) (local leading))
			(bool.and (i32.eq (u16.ctz (local word)) (local trailing))
				(i32.eq (u16.popcnt (local word)) (local population)))))))

	(fn check_i32 (params (word i32) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (i32.clz (local word)) (local leading))
			(bool.and (i32.eq (i32.ctz (local word)) (local trailing))
				(i32.eq (i32.popcnt (local word)) (local population)))))))

	(fn check_u32 (params (word u32) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (u32.clz (local word)) (local leading))
			(bool.and (i32.eq (u32.ctz (local word)) (local trailing))
				(i32.eq (u32.popcnt (local word)) (local population)))))))

	(fn check_i64 (params (word i64) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (i64.clz (local word)) (local leading))
			(bool.and (i32.eq (i64.ctz (local word)) (local trailing))
				(i32.eq (i64.popcnt (local word)) (local population)))))))

	(fn check_u64 (params (word u64) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (u64.clz (local word)) (local leading))
			(bool.and (i32.eq (u64.ctz (local word)) (local trailing))
				(i32.eq (u64.popcnt (local word)) (local population)))))))

	(fn next (params (state (mut-ref i32))) (returns u32)
		(body
			(set (local state) (i32.inc (local state)))
			(return (u32.from-i32 (local state)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_i8 0i8 8i32 8i32 0i32)) (then (return 9i32)))
			(if (bool.not (call check_i8 1i8 7i32 0i32 1i32)) (then (return 9i32)))
			(if (bool.not (call check_i8 -128i8 0i32 7i32 1i32)) (then (return 9i32)))
			(if (bool.not (call check_i8 127i8 1i32 0i32 7i32)) (then (return 9i32)))
			(if (bool.not (call check_i8 -1i8 0i32 0i32 8i32)) (then (return 9i32)))
			(if (bool.not (call check_i8 -8i8 0i32 3i32 5i32)) (then (return 9i32)))
			(if (bool.not (call check_u8 0u8 8i32 8i32 0i32)) (then (return 10i32)))
			(if (bool.not (call check_u8 1u8 7i32 0i32 1i32)) (then (return 10i32)))
			(if (bool.not (call check_u8 128u8 0i32 7i32 1i32)) (then (return 10i32)))
			(if (bool.not (call check_u8 255u8 0i32 0i32 8i32)) (then (return 10i32)))
			(if (bool.not (call check_u8 132u8 0i32 2i32 2i32)) (then (return 10i32)))
			(if (bool.not (call check_i16 0i16 16i32 16i32 0i32)) (then (return 17i32)))
			(if (bool.not (call check_i16 1i16 15i32 0i32 1i32)) (then (return 17i32)))
			(if (bool.not (call check_i16 -32768i16 0i32 15i32 1i32)) (then (return 17i32)))
			(if (bool.not (call check_i16 32767i16 1i32 0i32 15i32)) (then (return 17i32)))
			(if (bool.not (call check_i16 -1i16 0i32 0i32 16i32)) (then (return 17i32)))
			(if (bool.not (call check_i16 -8i16 0i32 3i32 13i32)) (then (return 17i32)))
			(if (bool.not (call check_u16 0u16 16i32 16i32 0i32)) (then (return 18i32)))
			(if (bool.not (call check_u16 1u16 15i32 0i32 1i32)) (then (return 18i32)))
			(if (bool.not (call check_u16 32768u16 0i32 15i32 1i32)) (then (return 18i32)))
			(if (bool.not (call check_u16 65535u16 0i32 0i32 16i32)) (then (return 18i32)))
			(if (bool.not (call check_u16 32772u16 0i32 2i32 2i32)) (then (return 18i32)))
			(if (bool.not (call check_i32 0i32 32i32 32i32 0i32)) (then (return 33i32)))
			(if (bool.not (call check_i32 1i32 31i32 0i32 1i32)) (then (return 33i32)))
			(if (bool.not (call check_i32 -2147483648i32 0i32 31i32 1i32)) (then (return 33i32)))
			(if (bool.not (call check_i32 2147483647i32 1i32 0i32 31i32)) (then (return 33i32)))
			(if (bool.not (call check_i32 -1i32 0i32 0i32 32i32)) (then (return 33i32)))
			(if (bool.not (call check_i32 -8i32 0i32 3i32 29i32)) (then (return 33i32)))
			(if (bool.not (call check_u32 0u32 32i32 32i32 0i32)) (then (return 34i32)))
			(if (bool.not (call check_u32 1u32 31i32 0i32 1i32)) (then (return 34i32)))
			(if (bool.not (call check_u32 2147483648u32 0i32 31i32 1i32)) (then (return 34i32)))
			(if (bool.not (call check_u32 4294967295u32 0i32 0i32 32i32)) (then (return 34i32)))
			(if (bool.not (call check_u32 2147483652u32 0i32 2i32 2i32)) (then (return 34i32)))
			(if (bool.not (call check_i64 0i64 64i32 64i32 0i32)) (then (return 65i32)))
			(if (bool.not (call check_i64 1i64 63i32 0i32 1i32)) (then (return 65i32)))
			(if (bool.not (call check_i64 -9223372036854775808i64 0i32 63i32 1i32)) (then (return 65i32)))
			(if (bool.not (call check_i64 9223372036854775807i64 1i32 0i32 63i32)) (then (return 65i32)))
			(if (bool.not (call check_i64 -1i64 0i32 0i32 64i32)) (then (return 65i32)))
			(if (bool.not (call check_i64 -8i64 0i32 3i32 61i32)) (then (return 65i32)))
			(if (bool.not (call check_u64 0u64 64i32 64i32 0i32)) (then (return 66i32)))
			(if (bool.not (call check_u64 1u64 63i32 0i32 1i32)) (then (return 66i32)))
			(if (bool.not (call check_u64 9223372036854775808u64 0i32 63i32 1i32)) (then (return 66i32)))
			(if (bool.not (call check_u64 18446744073709551615u64 0i32 0i32 64i32)) (then (return 66i32)))
			(if (bool.not (call check_u64 9223372036854775812u64 0i32 2i32 2i32)) (then (return 66i32)))
			(let-mut state 0i32)
			(let leading (u32.clz (call next (borrow-mut (local state)))))
			(let trailing (u32.ctz (call next (borrow-mut (local state)))))
			(let population (u32.popcnt (call next (borrow-mut (local state)))))
			(if (i32.not-eq (local leading) 31i32) (then (return 3i32)))
			(if (i32.not-eq (local trailing) 1i32) (then (return 4i32)))
			(if (i32.not-eq (local population) 2i32) (then (return 5i32)))
			(if (i32.not-eq (local state) 3i32) (then (return 6i32)))
			(return 42i32)))
)
