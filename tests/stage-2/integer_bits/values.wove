	(fn check_i64 (params (top i64) (low i64)) (returns bool)
		(body
			(if (i64.not-eq (i64.and top low) 0i64) (then (return (bool false))))
			(if (i64.not-eq (i64.or top 3i64) -9223372036854775805i64) (then (return (bool false))))
			(if (i64.not-eq (i64.xor (i64.or top 3i64) 3i64) -9223372036854775808i64) (then (return (bool false))))
			(if (i64.not-eq (i64.not top) 9223372036854775807i64) (then (return (bool false))))
			(if (i64.not-eq (i64.shl 1i64 63i32) -9223372036854775808i64) (then (return (bool false))))
