			(if (i64.not-eq (i64.shr top 0i32) -9223372036854775808i64) (then (return (bool false))))
			(if (i64.not-eq (i64.shr top 1i32) -4611686018427387904i64) (then (return (bool false))))
			(if (i64.not-eq (i64.shr top 63i32) -1i64) (then (return (bool false))))
