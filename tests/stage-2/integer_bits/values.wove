	(fn check_i8 (params (top i8) (low i8)) (returns bool)
		(body
			(if (i8.not-eq (i8.and top low) 0i8) (then (return (bool false))))
			(if (i8.not-eq (i8.or top 3i8) -125i8) (then (return (bool false))))
			(if (i8.not-eq (i8.xor (i8.or top 3i8) 3i8) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.not top) 127i8) (then (return (bool false))))
			(if (i8.not-eq (i8.shl 1i8 7i32) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.shl top 1i32) 0i8) (then (return (bool false))))
			(if (i8.not-eq (i8.shr top 0i32) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.shr top 1i32) -64i8) (then (return (bool false))))
			(if (i8.not-eq (i8.shr top 7i32) -1i8) (then (return (bool false))))
			(if (i8.not-eq (i8.rotl top 0i32) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.rotr top 0i32) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.rotl top 1i32) 1i8) (then (return (bool false))))
			(if (i8.not-eq (i8.rotr top 1i32) 64i8) (then (return (bool false))))
			(if (i8.not-eq (i8.rotr 1i8 1i32) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.rotl 1i8 7i32) -128i8) (then (return (bool false))))
			(return (bool true))))

	(fn check_u8 (params (top u8) (low u8)) (returns bool)
		(body
			(if (u8.not-eq (u8.and top low) 0u8) (then (return (bool false))))
			(if (u8.not-eq (u8.or top 3u8) 131u8) (then (return (bool false))))
			(if (u8.not-eq (u8.xor (u8.or top 3u8) 3u8) 128u8) (then (return (bool false))))
			(if (u8.not-eq (u8.not top) 127u8) (then (return (bool false))))
			(if (u8.not-eq (u8.shl 1u8 7i32) 128u8) (then (return (bool false))))
			(if (u8.not-eq (u8.shl top 1i32) 0u8) (then (return (bool false))))
			(if (u8.not-eq (u8.shr top 0i32) 128u8) (then (return (bool false))))
			(if (u8.not-eq (u8.shr top 1i32) 64u8) (then (return (bool false))))
			(if (u8.not-eq (u8.shr top 7i32) 1u8) (then (return (bool false))))
			(if (u8.not-eq (u8.rotl top 0i32) 128u8) (then (return (bool false))))
			(if (u8.not-eq (u8.rotr top 0i32) 128u8) (then (return (bool false))))
			(if (u8.not-eq (u8.rotl top 1i32) 1u8) (then (return (bool false))))
			(if (u8.not-eq (u8.rotr top 1i32) 64u8) (then (return (bool false))))
			(if (u8.not-eq (u8.rotr 1u8 1i32) 128u8) (then (return (bool false))))
			(if (u8.not-eq (u8.rotl 1u8 7i32) 128u8) (then (return (bool false))))
			(return (bool true))))

	(fn check_i16 (params (top i16) (low i16)) (returns bool)
		(body
			(if (i16.not-eq (i16.and top low) 0i16) (then (return (bool false))))
			(if (i16.not-eq (i16.or top 3i16) -32765i16) (then (return (bool false))))
			(if (i16.not-eq (i16.xor (i16.or top 3i16) 3i16) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.not top) 32767i16) (then (return (bool false))))
			(if (i16.not-eq (i16.shl 1i16 15i32) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.shl top 1i32) 0i16) (then (return (bool false))))
			(if (i16.not-eq (i16.shr top 0i32) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.shr top 1i32) -16384i16) (then (return (bool false))))
			(if (i16.not-eq (i16.shr top 15i32) -1i16) (then (return (bool false))))
			(if (i16.not-eq (i16.rotl top 0i32) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.rotr top 0i32) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.rotl top 1i32) 1i16) (then (return (bool false))))
			(if (i16.not-eq (i16.rotr top 1i32) 16384i16) (then (return (bool false))))
			(if (i16.not-eq (i16.rotr 1i16 1i32) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.rotl 1i16 15i32) -32768i16) (then (return (bool false))))
			(return (bool true))))

	(fn check_u16 (params (top u16) (low u16)) (returns bool)
		(body
			(if (u16.not-eq (u16.and top low) 0u16) (then (return (bool false))))
			(if (u16.not-eq (u16.or top 3u16) 32771u16) (then (return (bool false))))
			(if (u16.not-eq (u16.xor (u16.or top 3u16) 3u16) 32768u16) (then (return (bool false))))
			(if (u16.not-eq (u16.not top) 32767u16) (then (return (bool false))))
			(if (u16.not-eq (u16.shl 1u16 15i32) 32768u16) (then (return (bool false))))
			(if (u16.not-eq (u16.shl top 1i32) 0u16) (then (return (bool false))))
			(if (u16.not-eq (u16.shr top 0i32) 32768u16) (then (return (bool false))))
			(if (u16.not-eq (u16.shr top 1i32) 16384u16) (then (return (bool false))))
			(if (u16.not-eq (u16.shr top 15i32) 1u16) (then (return (bool false))))
			(if (u16.not-eq (u16.rotl top 0i32) 32768u16) (then (return (bool false))))
			(if (u16.not-eq (u16.rotr top 0i32) 32768u16) (then (return (bool false))))
			(if (u16.not-eq (u16.rotl top 1i32) 1u16) (then (return (bool false))))
			(if (u16.not-eq (u16.rotr top 1i32) 16384u16) (then (return (bool false))))
			(if (u16.not-eq (u16.rotr 1u16 1i32) 32768u16) (then (return (bool false))))
			(if (u16.not-eq (u16.rotl 1u16 15i32) 32768u16) (then (return (bool false))))
			(return (bool true))))

	(fn check_i32 (params (top i32) (low i32)) (returns bool)
