			(if (i32.not-eq (i32.and top low) 0i32) (then (return (bool false))))
			(if (i32.not-eq (i32.or top 3i32) -2147483645i32) (then (return (bool false))))
			(if (i32.not-eq (i32.xor (i32.or top 3i32) 3i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.not top) 2147483647i32) (then (return (bool false))))
			(if (i32.not-eq (i32.shl 1i32 31i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.shl top 1i32) 0i32) (then (return (bool false))))
			(if (i32.not-eq (i32.shr top 0i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.shr top 1i32) -1073741824i32) (then (return (bool false))))
			(if (i32.not-eq (i32.shr top 31i32) -1i32) (then (return (bool false))))
			(if (i32.not-eq (i32.rotl top 0i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.rotr top 0i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.rotl top 1i32) 1i32) (then (return (bool false))))
			(if (i32.not-eq (i32.rotr top 1i32) 1073741824i32) (then (return (bool false))))
			(if (i32.not-eq (i32.rotr 1i32 1i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.rotl 1i32 31i32) -2147483648i32) (then (return (bool false))))
			(return (bool true))))

