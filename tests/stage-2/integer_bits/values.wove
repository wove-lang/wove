	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:310"))
		(body
			(if (bool.not (call check_i8 -128i8 127i8)) (then (return 1i32)))
			(if (bool.not (call check_u8 128u8 127u8)) (then (return 2i32)))
			(if (bool.not (call check_i16 -32768i16 32767i16)) (then (return 3i32)))
			(if (bool.not (call check_u16 32768u16 32767u16)) (then (return 4i32)))
			(if (bool.not (call check_i32 -2147483648i32 2147483647i32)) (then (return 5i32)))
			(if (bool.not (call check_u32 2147483648u32 2147483647u32)) (then (return 6i32)))
			(if (bool.not (call check_i64 -9223372036854775808i64 9223372036854775807i64)) (then (return 7i32)))
			(if (bool.not (call check_u64 9223372036854775808u64 9223372036854775807u64)) (then (return 8i32)))
			(return 42i32)))
)
