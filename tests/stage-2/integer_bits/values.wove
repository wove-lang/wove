	(fn check_u64 (params (top u64) (low u64)) (returns bool)
		(body
			(if (u64.not-eq (u64.and top low) 0u64) (then (return (bool false))))
			(if (u64.not-eq (u64.or top 3u64) 9223372036854775811u64) (then (return (bool false))))
			(if (u64.not-eq (u64.xor (u64.or top 3u64) 3u64) 9223372036854775808u64) (then (return (bool false))))
			(if (u64.not-eq (u64.not top) 9223372036854775807u64) (then (return (bool false))))
			(if (u64.not-eq (u64.shl 1u64 63i32) 9223372036854775808u64) (then (return (bool false))))
