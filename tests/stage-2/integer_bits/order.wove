(module integer_bits_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn word (params (trace (mut-ref i32)) (digit i32) (value i16)) (returns i16)
		(body
			(set (local trace) (i32.add (i32.mul (local trace) 10i32) (local digit)))
			(return (local value))))

	(fn count (params (trace (mut-ref i32)) (digit i32) (value i32)) (returns i32)
		(body
			(set (local trace) (i32.add (i32.mul (local trace) 10i32) (local digit)))
			(return (local value))))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:310"))
		(body
			(let-mut trace 0i32)
			(if
				(i16.not-eq (i16.xor (call word (borrow-mut (local trace)) 1i32 -1i16)
					(call word (borrow-mut (local trace)) 2i32 0i16)) -1i16)
				(then (return 1i32)))
			(if
				(i16.not-eq (i16.not (call word (borrow-mut (local trace)) 3i32 -1i16)) 0i16)
				(then (return 2i32)))
			(if
				(i16.not-eq (i16.shl (call word (borrow-mut (local trace)) 4i32 1i16)
					(call count (borrow-mut (local trace)) 5i32 15i32)) -32768i16)
				(then (return 3i32)))
			(if
				(i16.not-eq (i16.shr (call word (borrow-mut (local trace)) 6i32 -32768i16)
					(call count (borrow-mut (local trace)) 7i32 15i32)) -1i16)
				(then (return 4i32)))
			(if (i32.not-eq (local trace) 1234567i32) (then (return 5i32)))
			(set (local trace) 0i32)
			(if
				(i16.not-eq (i16.rotl (call word (borrow-mut (local trace)) 1i32 -32768i16)
					(call count (borrow-mut (local trace)) 2i32 1i32)) 1i16)
				(then (return 6i32)))
			(if
				(i16.not-eq (i16.rotr (call word (borrow-mut (local trace)) 3i32 1i16)
					(call count (borrow-mut (local trace)) 4i32 1i32)) -32768i16)
				(then (return 7i32)))
			(if (i32.not-eq (local trace) 1234i32) (then (return 8i32)))
			(return 42i32)))
)
