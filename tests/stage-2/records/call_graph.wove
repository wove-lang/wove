(module record_call_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./call_provider.wove" (only create read))
	(struct Token (fields (kind u32)))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (call create (u32 42)))
			(return (call read (local value))))))
