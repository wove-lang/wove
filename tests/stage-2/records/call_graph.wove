(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	record_call_graph
	(use wove-file "./call_provider.wove" (only create read))
	(struct Token (fields (kind u32)))
	(fn main (params) (returns i32)
		(body
			(let value (call create (u32 42)))
			(return (call read (local value))))))
