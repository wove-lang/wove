(module duplicate_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Token (fields (kind u32) (start i32)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let tok (struct.new Token (kind (u32 40))
				(kind (u32 1)) (start (i32 0))))
			(return (i32 42)))))
