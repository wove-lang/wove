(module record_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./left.wove" (only (as Token left)))
	(use wove-file "./right.wove" (only (as Token right)))
	(fn main (params) (returns i32)
		(body (return (i32.add.wrapping (call left) (call right))))))
