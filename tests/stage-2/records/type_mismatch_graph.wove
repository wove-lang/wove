(module type_mismatch_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./type_provider.wove" (only (as Token read_first) (type (as Token First))))
	(use wove-file "./call_provider.wove" (only (type (as Token Second))))
	(fn main (params) (returns i32)
		(body
			(let value (record.make Second (kind (u32 42))))
			(return (call read_first (local value))))))
