(module local_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_kind
		(params (kind u32))
		(returns u32)
		(body
			(let tok (struct.new Token (byte (u8 0)) (start (i32 0)) (flag (bool false)) (kind (local kind))))
			(let copy (local tok))
			(return (struct.get (local copy) kind))))

	(fn read_start
		(params (start i32))
		(returns i32)
		(body
			(let tok (struct.new Token (kind (u32 40)) (start (local start)) (flag (bool false)) (byte (u8 0))))
			(return (struct.get (local tok) start))))

	(fn flags
		(params (flag bool) (marker u8))
		(returns bool)
		(body
			(let tok (struct.new Token (flag (local flag)) (kind (u32 0)) (byte (local marker)) (start (i32 0))))
			(return (bool.and (struct.get (local tok) flag) (u8.eq (struct.get (local tok) byte) (u8 255))))))

	(fn step
		(params (state (mut-array u8)) (delta i32))
		(returns i32)
		(body
			(let before (int.convert i32 (array.load (local state) (i32 0))))
			(let value (i32.add.wrapping (local before) (local delta)))
			(array.store (local state) (i32 0) (int.convert u8 (local value)))
			(return (local value))))

	(fn ordered
		(params (state (mut-array u8)))
		(returns i32)
		(body
			(let tok (struct.new Token
				(start (call step (borrow-mut (local state)) (i32 3)))
				(kind (int.convert u32 (call step (borrow-mut (local state)) (i32 5))))
				(flag (bool true))
				(byte (u8 0))))
			(return (i32.add.wrapping
				(struct.get (local tok) start) (int.convert i32 (struct.get (local tok) kind))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 42))))

	(struct Token (fields (kind u32) (start i32) (flag bool) (byte u8))))
