(module local_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_kind
		(params (kind u32))
		(returns u32)
		(body
			(let tok (struct:new Token (byte (u8 0)) (start (i32 0)) (flag (bool false)) (kind kind)))
			(let copy tok)
			(return (struct:get copy kind))))

	(fn read_start
		(params (start i32))
		(returns i32)
		(body
			(let tok (struct:new Token (kind (u32 40)) (start start) (flag (bool false)) (byte (u8 0))))
			(return (struct:get tok start))))

	(fn flags
		(params (flag bool) (marker u8))
		(returns bool)
		(body
			(let tok (struct:new Token (flag flag) (kind (u32 0)) (byte marker) (start (i32 0))))
			(return (bool:and (struct:get tok flag) (u8:eq (struct:get tok byte) (u8 255))))))

	(fn step
		(params (state (mut-array u8)) (delta i32))
		(returns i32)
		(body
			(let before (int:convert i32 (array:load state (i32 0))))
			(let value (i32:add before delta))
			(array:store state (i32 0) (int:convert u8 value))
			(return value)))

	(fn ordered
		(params (state (mut-array u8)))
		(returns i32)
		(body
			(let tok (struct:new Token
				(start (call step (borrow-mut state) (i32 3)))
				(kind (int:convert u32 (call step (borrow-mut state) (i32 5))))
				(flag (bool true))
				(byte (u8 0))))
			(return (i32:add
				(struct:get tok start) (int:convert i32 (struct:get tok kind))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42))))

	(struct Token (fields (kind u32) (start i32) (flag bool) (byte u8))))
