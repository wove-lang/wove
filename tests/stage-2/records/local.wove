(module local_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_kind
		(params (kind u32))
		(returns u32)
		(body
			(let tok (record.make Token (byte (u8 0)) (start (i32 0)) (flag (bool false)) (kind (local kind))))
			(let copy (local tok))
			(return (record.get (local copy) kind))))

	(fn read_start
		(params (start i32))
		(returns i32)
		(body
			(let tok (record.make Token (kind (u32 40)) (start (local start)) (flag (bool false)) (byte (u8 0))))
			(return (record.get (local tok) start))))

	(fn flags
		(params (flag bool) (marker u8))
		(returns bool)
		(body
			(let tok (record.make Token (flag (local flag)) (kind (u32 0)) (byte (local marker)) (start (i32 0))))
			(return (bool.and (record.get (local tok) flag) (u8.eq (record.get (local tok) byte) (u8 255))))))

	(fn step
		(params (state (mut-slice u8)) (delta i32))
		(returns i32)
		(body
			(let before (int.convert i32 (slice.load (local state) (i32 0))))
			(let value (i32.add.wrapping (local before) (local delta)))
			(slice.store (local state) (i32 0) (int.convert u8 (local value)))
			(return (local value))))

	(fn ordered
		(params (state (mut-slice u8)))
		(returns i32)
		(body
			(let tok (record.make Token
				(start (call step (borrow-mut (local state)) (i32 3)))
				(kind (int.convert u32 (call step (borrow-mut (local state)) (i32 5))))
				(flag (bool true))
				(byte (u8 0))))
			(return (i32.add.wrapping
				(record.get (local tok) start) (int.convert i32 (record.get (local tok) kind))))))

	(fn main (params) (returns i32) (body (return (i32 42))))

	(struct Token (fields (kind u32) (start i32) (flag bool) (byte u8))))
