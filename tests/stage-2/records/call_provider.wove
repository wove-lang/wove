(module call_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn create (params (value u32)) (returns Token)
		(body (return (record.make Token (kind (local value))))))
	(fn read (params (value Token)) (returns i32)
		(body (return (int.convert i32 (record.get (local value) kind)))))
	(struct Token (fields (kind u32))))
