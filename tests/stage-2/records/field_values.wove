(module record_field_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (value i32)))
	(fn next
		(params (state (mut-array u8))) (returns Token)
		(body
			(let count (array.load (local state) (i32 0)))
			(array.store (local state) (i32 0)
				(int.convert u8 (i32.add.wrapping (int.convert i32 (local count)) (i32 1))))
			(return (struct.new Token (value (i32 42))))))
	(fn read
		(params (tokens (shared-array Token))) (returns i32)
		(body (return (struct.get (array.load (local tokens) (i32 0)) value))))
	(fn put
		(params (tokens (mut-array Token)) (value i32)) (returns void)
		(body (array.store (local tokens) (i32 0) (struct.new Token (value (local value))))))
	(fn count
		(params (state (shared-array u8))) (returns u8)
		(body (return (array.load (local state) (i32 0)))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let-mut tokens (array.alloc Token (i32 1)))
			(call put (borrow-mut (local tokens))
				(struct.get (call next (borrow-mut (local state))) value))
			(if (bool.not (u8.eq (call count (borrow-shared (local state))) (u8 1)))
				(then (return (i32 1))))
			(if (i32.lt (struct.get (struct.new Token (value (i32 0))) value) (i32 0))
				(then (return (i32 2))))
			(return (call read (borrow-shared (local tokens)))))))
