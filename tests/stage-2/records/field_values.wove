(module record_field_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (value i32)))
	(fn next
		(params (state (mut-slice u8))) (returns Token)
		(body
			(let count (slice.load (local state) (i32 0)))
			(slice.store (local state) (i32 0)
				(int.convert u8 (i32.add.wrapping (int.convert i32 (local count)) (i32 1))))
			(return (record.make Token (value (i32 42))))))
	(fn read
		(params (tokens (shared-slice Token))) (returns i32)
		(body (return (record.get (slice.load (local tokens) (i32 0)) value))))
	(fn put
		(params (tokens (mut-slice Token)) (value i32)) (returns void)
		(body (slice.store (local tokens) (i32 0) (record.make Token (value (local value))))))
	(fn count
		(params (state (shared-slice u8))) (returns u8)
		(body (return (slice.load (local state) (i32 0)))))
	(fn main
		(params) (returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let-mut tokens (array.alloc Token (i32 1)))
			(call put (borrow-mut (local tokens))
				(record.get (call next (borrow-mut (local state))) value))
			(if (bool.not (u8.eq (call count (borrow-shared (local state))) (u8 1)))
				(then (return (i32 1))))
			(if (i32.lt (record.get (record.make Token (value (i32 0))) value) (i32 0))
				(then (return (i32 2))))
			(return (call read (borrow-shared (local tokens)))))))
