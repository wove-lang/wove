(module record_field_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (value i32)))
	(fn next
		(params (state (mut-array u8))) (returns Token)
		(body
			(let count (array.load state (i32 0)))
			(array.store state (i32 0)
				(int.convert u8 (i32.add (int.convert i32 count) (i32 1))))
			(return (struct.new Token (value (i32 42))))))
	(fn read
		(params (tokens (shared-array Token))) (returns i32)
		(body (return (struct.get (array.load tokens (i32 0)) value))))
	(fn put
		(params (tokens (mut-array Token)) (value i32)) (returns void)
		(body (array.store tokens (i32 0) (struct.new Token (value value)))))
	(fn count
		(params (state (shared-array u8))) (returns u8)
		(body (return (array.load state (i32 0)))))
	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let-mut tokens (array.alloc Token (i32 1)))
			(call put (borrow-mut tokens)
				(struct.get (call next (borrow-mut state)) value))
			(if (bool.not (u8.eq (call count (borrow-shared state)) (u8 1)))
				(then (return (i32 1))))
			(if (i32.lt (struct.get (struct.new Token (value (i32 0))) value) (i32 0))
				(then (return (i32 2))))
			(return (call read (borrow-shared tokens))))))
