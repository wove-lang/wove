(module unknown_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Token (fields (kind u32) (start i32)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let tok (struct.new Token (kind (u32 40)) (start (i32 0))))
			(return (struct.get (local tok) stop)))))
