	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn make
		(params)
		(returns Token)
		(body
			(return
				(record.make Other (kind (u32 42))))))
	(fn main (params) (returns i32)
		(body (return (i32 42)))))
