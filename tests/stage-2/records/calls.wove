(module record_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make
		(params (kind u32) (start i32))
		(returns Token)
		(body
			(let bytes (array.alloc u8 (i32 3)))
			(return (struct.new Token
				(start (local start))
				(kind (local kind))
				(end (i32.add (local start) (call length (borrow-shared (local bytes)))))
				(active (bool true))
				(mark (u8 255))))))

	(fn length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array.len (local data)))))

	(fn change
		(params (token Token))
		(returns Token)
		(body
			(let-mut copy (local token))
			(set (local copy) (struct.new Token
				(kind (u32 2147483648))
				(start (i32 -7))
				(end (struct.get (local token) end))
				(active (bool false))
				(mark (struct.get (local token) mark))))
			(return (local copy))))

	(fn is_changed
		(params (value Token))
		(returns bool)
		(body
			(return (bool.and
				(u32.eq (struct.get (local value) kind) (u32 2147483648))
				(bool.and
					(i32.eq (struct.get (local value) start) (i32 -7))
					(bool.and
						(i32.eq (struct.get (local value) end) (i32 -2147483645))
						(bool.and (bool.not (struct.get (local value) active))
							(u8.eq (struct.get (local value) mark) (u8 255)))))))))

	(fn is_original
		(params (value Token))
		(returns bool)
		(body
			(return (bool.and
				(u32.eq (struct.get (local value) kind) (u32 4294967295))
				(bool.and
					(i32.eq (struct.get (local value) start) (i32 -2147483648))
					(bool.and
						(i32.eq (struct.get (local value) end) (i32 -2147483645))
						(bool.and (struct.get (local value) active)
							(u8.eq (struct.get (local value) mark) (u8 255)))))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let original (call make (u32 4294967295) (i32 -2147483648)))
			(if (bool.and
					(call is_changed (call change (local original)))
					(bool.and
						(call is_original (local original))
						(bool.and
							(u32.eq (struct.get (local original) kind) (u32 4294967295))
							(call is_original (struct.new Token
								(kind (u32 4294967295))
								(start (i32 -2147483648))
								(end (i32 -2147483645))
								(active (bool true))
								(mark (u8 255)))))))
				(then (return (i32 42))))
			(return (i32 1))))

	(struct Token (fields (kind u32) (start i32) (end i32) (active bool) (mark u8))))
