(module record_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make
		(params (kind u32) (start i32))
		(returns Token)
		(body
			(let bytes (array:alloc u8 (i32 3)))
			(return (struct:new Token
				(start start)
				(kind kind)
				(end (i32:add start (call length (borrow-shared bytes))))
				(active (bool true))
				(mark (u8 255))))))

	(fn length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array:len data))))

	(fn change
		(params (token Token))
		(returns Token)
		(body
			(let-mut copy token)
			(set copy (struct:new Token
				(kind (u32 2147483648))
				(start (i32 -7))
				(end (struct:get token end))
				(active (bool false))
				(mark (struct:get token mark))))
			(return copy)))

	(fn is_changed
		(params (value Token))
		(returns bool)
		(body
			(return (bool:and
				(u32:eq (struct:get value kind) (u32 2147483648))
				(bool:and
					(i32:eq (struct:get value start) (i32 -7))
					(bool:and
						(i32:eq (struct:get value end) (i32 -2147483645))
						(bool:and (bool:not (struct:get value active))
							(u8:eq (struct:get value mark) (u8 255)))))))))

	(fn is_original
		(params (value Token))
		(returns bool)
		(body
			(return (bool:and
				(u32:eq (struct:get value kind) (u32 4294967295))
				(bool:and
					(i32:eq (struct:get value start) (i32 -2147483648))
					(bool:and
						(i32:eq (struct:get value end) (i32 -2147483645))
						(bool:and (struct:get value active)
							(u8:eq (struct:get value mark) (u8 255)))))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let original (call make (u32 4294967295) (i32 -2147483648)))
			(if (bool:and
					(call is_changed (call change original))
					(bool:and
						(call is_original original)
						(bool:and
							(u32:eq (struct:get original kind) (u32 4294967295))
							(call is_original (struct:new Token
								(kind (u32 4294967295))
								(start (i32 -2147483648))
								(end (i32 -2147483645))
								(active (bool true))
								(mark (u8 255)))))))
				(then (return (i32 42))))
			(return (i32 1))))

	(struct Token (fields (kind u32) (start i32) (end i32) (active bool) (mark u8))))
