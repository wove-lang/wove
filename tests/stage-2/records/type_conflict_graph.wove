	(use wove-file "./type_provider.wove" (only (type (as Token Local))))
	(struct Local (fields (kind u32)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 0)))))
