(module wrong_record_argument
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn accept
		(params (value Token))
		(returns i32)
		(body (return (int.convert i32 (struct.get (local value) kind)))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let other (struct.new Other (kind (u32 42))))
			(return (call accept
				(local other))))))
