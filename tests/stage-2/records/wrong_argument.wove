	wrong_record_argument
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn accept
		(params (value Token))
		(returns i32)
		(body (return (int.convert i32 (record.get (local value) kind)))))
	(fn main (params) (returns i32)
		(body
			(let other (record.make Other (kind (u32 42))))
			(return (call accept
				(local other))))))
