(module wrong_record_argument
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn accept
		(params (value Token))
		(returns i32)
		(body (return (int:convert i32 (struct:get value kind)))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let other (struct:new Other (kind (u32 42))))
			(return (call accept
				other)))))
