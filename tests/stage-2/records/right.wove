(module provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (value u32) (active bool)))
	(fn Token (params) (returns i32)
		(body
			(let item (record.make Token (active (bool true)) (value (u32 22))))
			(return (int.convert i32 (record.get (local item) value))))))
