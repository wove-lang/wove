(module type_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./type_provider.wove" (only Token (type (as Token Alias)) (type Token)))
	(fn preserve (params (value Alias)) (returns Token)
		(body (return value)))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct:new Alias (kind (u32 42))))
			(return (call Token (call preserve value))))))
