(module type_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./type_provider.wove" (only Token (type (as Token Alias)) (type Token)))
	(fn preserve (params (value Alias)) (returns Token)
		(body (return (local value))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let value (struct.new Alias (kind (u32 42))))
			(return (call Token (call preserve (local value)))))))
