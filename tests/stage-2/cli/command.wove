			(if (bool:not (call check_setting field_2 (u32 1) (u32 1) (i32 0)))
				(then (return (i32 13))))
			(let field_3 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 4) (i32 20)))
			(if (bool:not (call check_setting field_3 (u32 2) (u32 17) (i32 1)))
				(then (return (i32 14))))
			(let field_5 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 0) (i32 -5)))
			(if (bool:not (call check_setting field_5 (u32 2) (u32 1) (i32 1)))
				(then (return (i32 16))))
			(let field_6 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 1) (i32 26)))
			(if (bool:not (call check_setting field_6 (u32 2) (u32 0) (i32 1)))
				(then (return (i32 17))))
			(let field_8 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 19)))
			(if (bool:not (call check_setting field_8 (u32 2) (u32 0) (i32 1)))
				(then (return (i32 19))))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				(struct:get field_8 row) (i32 3) (bool false)))
				(then (return (i32 119))))
			(let operand_0 (call first_command_argument (borrow-shared arguments) (i32 0)
				(struct:get result rows) (i32 -1)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				operand_0 (i32 1) (bool false)))
				(then (return (i32 170))))
			(let operand_1 (call first_command_argument (borrow-shared arguments) (i32:add operand_0 (i32 1))
				(struct:get result rows) (i32 -1)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				operand_1 (i32 8) (bool false)))
				(then (return (i32 171))))
			(let operand_2 (call first_command_argument (borrow-shared arguments) (i32:add operand_1 (i32 1))
				(struct:get result rows) (i32 -1)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				operand_2 (i32 10) (bool false)))
				(then (return (i32 172))))
			(let operand_3 (call first_command_argument (borrow-shared arguments) (i32:add operand_2 (i32 1))
				(struct:get result rows) (i32 -1)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				operand_3 (i32 11) (bool false)))
				(then (return (i32 173))))
			(return (i32 0))))

	(fn check_bin
		(params (result CommandInvocation) (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)))
		(returns i32)
		(body
			(if (bool:not (bool:and (u32:eq (struct:get result command) (u32 2)) (bool:and (u32:eq (struct:get result mode) (u32 2)) (i32:eq (struct:get result operands) (i32 1)))))
				(then (return (i32 20))))
			(let field_4 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 18)))
			(if (bool:not (call check_setting field_4 (u32 2) (u32 2) (i32 1)))
				(then (return (i32 25))))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				(struct:get field_4 row) (i32 15) (bool false)))
				(then (return (i32 125))))
			(let field_6 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 13)))
			(if (bool:not (call check_setting field_6 (u32 2) (u32 0) (i32 2)))
				(then (return (i32 27))))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				(struct:get field_6 row) (i32 5) (bool false)))
				(then (return (i32 127))))
			(let field_7 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 17)))
			(if (bool:not (call check_setting field_7 (u32 2) (u32 0) (i32 2)))
				(then (return (i32 28))))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				(struct:get field_7 row) (i32 9) (bool false)))
				(then (return (i32 128))))
			(let field_8 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 19)))
			(if (bool:not (call check_setting field_8 (u32 2) (u32 0) (i32 1)))
				(then (return (i32 29))))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				(struct:get field_8 row) (i32 13) (bool false)))
				(then (return (i32 129))))
			(let operand_0 (call first_command_argument (borrow-shared arguments) (i32 0)
				(struct:get result rows) (i32 -1)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				operand_0 (i32 6) (bool false)))
				(then (return (i32 180))))
			(let second_flag (call first_command_argument (borrow-shared arguments)
				(i32:add (struct:get field_6 row) (i32 1)) (struct:get result rows) (i32 13)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				second_flag (i32 7) (bool true)))
				(then (return (i32 205))))
			(let second_link (call first_command_argument (borrow-shared arguments)
				(i32:add (struct:get field_7 row) (i32 1)) (struct:get result rows) (i32 17)))
			(if (bool:not (call check_argument (borrow-shared bytes) (borrow-shared argv) (borrow-shared arguments)
				second_link (i32 11) (bool false)))
				(then (return (i32 206))))
			(return (i32 0))))

	(fn check_defaults
		(params (result CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (mode u32))
		(returns i32)
		(body
			(if (bool:not (bool:and (u32:eq (struct:get result command) (u32 2)) (bool:and (u32:eq (struct:get result mode) mode) (i32:eq (struct:get result operands) (i32 0)))))
				(then (return (i32 40))))
			(let field_0 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 1) (i32 6)))
			(if (bool:not (u32:eq (struct:get field_0 scalar) (u32 0)))
				(then (return (i32 41))))
			(let field_1 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 1) (i32 7)))
			(if (bool:not (call check_setting field_1 (u32 3) (u32 0) (i32 0)))
				(then (return (i32 42))))
			(let-mut flag_count (i32 1))
			(let-mut optimization (u8 49))
			(let-mut lto_default (u32 0))
			(if (u32:eq mode (u32 1))
				(then (set flag_count (i32 2)) (set optimization (u8 48))))
			(if (u32:eq mode (u32 2))
				(then (set lto_default (u32 1)) (set optimization (u8 51))))
			(let field_3 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 13)))
			(if (bool:not (call check_setting field_3 (u32 3) (u32 0) flag_count))
				(then (return (i32 44))))
			(let field_4 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 3) (i32 18)))
			(if (bool:not (call check_setting field_4 (u32 3) lto_default (i32 0)))
				(then (return (i32 45))))
			(let field_5 (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 4) (i32 20)))
			(if (bool:not (call check_setting field_5 (u32 3) (u32 11) (i32 0)))
				(then (return (i32 46))))
			(let-mut flag (array:alloc u8 (i32 3)))
			(if (bool:not (i32:eq (call write_default_cflag mode (i32 0) (borrow-mut flag)) (i32 3)))
				(then (return (i32 207))))
			(if (bool:not (u8:eq (call flag_byte (borrow-shared flag) (i32 2)) optimization))
				(then (return (i32 208))))
			(if (u32:eq mode (u32 1))
				(then
					(if (bool:not (i32:eq (call write_default_cflag mode (i32 1) (borrow-mut flag)) (i32 2)))
						(then (return (i32 209))))
					(if (bool:not (u8:eq (call flag_byte (borrow-shared flag) (i32 1)) (u8 103)))
						(then (return (i32 210))))))
			(array:store flag 0i32 255u8)
			(array:store flag 1i32 255u8)
			(array:store flag 2i32 255u8)
			(if (i32:not-eqz (call write_default_cflag mode 0i32 (borrow-mut (array:range flag 0i32 2i32))))
				(then (return 211i32)))
			(if (u32:eq mode 1u32)
				(then
					(if (i32:not-eqz (call write_default_cflag mode 1i32 (borrow-mut (array:range flag 0i32 1i32))))
						(then (return 212i32)))))
			(if (bool:or (i32:not-eqz (call write_default_cflag mode -1i32 (borrow-mut flag)))
					(i32:not-eqz (call write_default_cflag mode flag_count (borrow-mut flag))))
				(then (return 213i32)))
			(if (bool:or (u8:not-eq (array:load flag 0i32) 255u8)
					(bool:or (u8:not-eq (array:load flag 1i32) 255u8)
						(u8:not-eq (array:load flag 2i32) 255u8)))
				(then (return 214i32)))
			(return (i32 0))))

	(fn check_serial_budget
		(params (result CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)))
		(returns i32)
		(body
			(let parallel (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 1) (i32 6)))
			(let jobs (call command_setting result (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (u32 1) (i32 7)))
			(let actual (call compiler_job_budget (u32:eq (struct:get parallel scalar) (u32 1))
				(struct:get jobs scalar) (i32 6)))
			(if (bool:not (u32:eq actual (u32 1))) (then (return (i32 60))))
			(return (i32 0))))

	(fn check_setting
		(params (setting CommandSetting) (origin u32) (value u32) (count i32))
		(returns bool)
		(body (return (bool:and (u32:eq (struct:get setting origin) origin)
			(bool:and (u32:eq (struct:get setting scalar) value)
				(i32:eq (struct:get setting count) count))))))

	(fn flag_byte
		(params (bytes (shared-array u8)) (index i32))
		(returns u8)
		(body (return (array:load bytes index))))

	(fn check_argument
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (arguments (shared-array CommandArgument))
			(row i32) (index i32) (attached bool))
		(returns bool)
		(body
			(if (i32:lt row (i32 0)) (then (return (bool false))))
			(let argument (array:load arguments row))
			(let original (array:load argv index))
			(let-mut start (struct:get original start))
			(let end (struct:get original end))
			(if attached
				(then
					(while (bool:and (i32:lt start end)
						(bool:not (u8:eq (array:load bytes start) (u8 61))))
						(body (set start (i32:add start (i32 1)))))
					(set start (i32:add start (i32 1)))))
			(return (bool:and (i32:eq (struct:get argument argv_index) index)
				(bool:and (i32:eq (struct:get argument start) start)
					(i32:eq (struct:get argument end) end))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0))))
)
