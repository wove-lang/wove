				(then (return (i32 52))))
			(let field_2 (call command_setting (local result) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) (u32 7) (i32 45)))
			(if (bool.not (call check_setting (local field_2) (u32 1) (u32 27) (i32 0)))
				(then (return (i32 53))))
			(return (i32 0))))

	(fn check_setting
		(params (setting CommandSetting) (origin u32) (value u32) (count i32))
		(returns bool)
		(body (return (bool.and (u32.eq (record.get (local setting) origin) (local origin))
			(bool.and (u32.eq (record.get (local setting) scalar) (local value))
				(i32.eq (record.get (local setting) count) (local count)))))))

	(fn flag_byte
		(params (bytes (shared-slice u8)) (index i32))
		(returns u8)
		(body (return (slice.load (local bytes) (local index)))))

	(fn check_argument
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (arguments (shared-slice CommandArgument))
			(row i32) (index i32) (attached bool))
		(returns bool)
		(body
			(if (i32.lt (local row) (i32 0)) (then (return (bool false))))
			(let argument (slice.load (local arguments) (local row)))
			(let original (slice.load (local argv) (local index)))
			(let-mut start (record.get (local original) start))
			(let end (record.get (local original) end))
			(if (local attached)
				(then
					(while (bool.and (i32.lt (local start) (local end))
						(bool.not (u8.eq (slice.load (local bytes) (local start)) (u8 61))))
						(body (set (local start) (i32.add.wrapping (local start) (i32 1)))))
					(set (local start) (i32.add.wrapping (local start) (i32 1)))))
			(return (bool.and (i32.eq (record.get (local argument) argv_index) (local index))
				(bool.and (i32.eq (record.get (local argument) start) (local start))
					(i32.eq (record.get (local argument) end) (local end)))))))

	(fn main (params) (returns i32) (body (return (i32 0))))
)
