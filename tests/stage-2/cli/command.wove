	(fn check_invocation
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (config (shared-array u8)) (has_config bool)
			(scenario i32) (source u32) (error u32) (index i32) (start i32) (end i32))
		(returns i32)
		(body
			(let width (array:len config))
			(let-mut nodes (array:alloc JsonNode width))
			(let-mut settings (array:alloc ProjectSetting width))
			(let-mut arguments (array:alloc CommandArgument (array:len argv)))
			(let result (call resolve_command (borrow-shared bytes) (borrow-shared argv)
				(borrow-shared config) has_config
				(borrow-mut nodes) (borrow-mut settings) (borrow-mut arguments)))
			(if (bool:not (u32:eq (struct:get result source) source)) (then (return (i32 1))))
			(if (bool:not (u32:eq (struct:get result error) error)) (then (return (i32 2))))
			(if (bool:not (i32:eq (struct:get result argv_index) index)) (then (return (i32 3))))
			(if (bool:not (bool:and (i32:eq (struct:get result start) start)
				(i32:eq (struct:get result end) end))) (then (return (i32 4))))
			(if (i32:eq scenario (i32 0)) (then (return (i32 0))))
			(if (i32:eq scenario (i32 1))
				(then (return (call check_cc result (borrow-shared bytes) (borrow-shared argv)
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)))))
			(if (i32:eq scenario (i32 2))
				(then (return (call check_bin result (borrow-shared bytes) (borrow-shared argv)
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)))))
			(if (i32:eq scenario (i32 3))
				(then (return (call check_serial_budget result
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)))))
			(if (i32:eq scenario (i32 4))
				(then (return (call check_defaults result
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) (u32 1)))))
			(if (i32:eq scenario (i32 10))
				(then (return (call check_defaults result
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) (u32 0)))))
			(if (i32:eq scenario (i32 11))
				(then (return (call check_defaults result
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) (u32 2)))))
			(return (i32 5))))

	(fn check_cc
		(params (result CommandInvocation) (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)))
		(returns i32)
		(body
			(if (bool:not (bool:and (u32:eq (struct:get result command) (u32 1)) (bool:and (u32:eq (struct:get result mode) (u32 0)) (i32:eq (struct:get result operands) (i32 4)))))
				(then (return (i32 10))))
			(let field_2 (call command_setting result (borrow-shared arguments)
