(module argv_fixture_data
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan) (type ArgSpec)))

	(fn put_four
		(params (data (mut-array u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(array.store (local data) (local start) (local a))
			(array.store (local data) (i32.add.wrapping (local start) (i32 1)) (local b))
			(array.store (local data) (i32.add.wrapping (local start) (i32 2)) (local c))
			(array.store (local data) (i32.add.wrapping (local start) (i32 3)) (local d))))

	(fn set_arg
		(params (argv (mut-array ArgSpan)) (index i32) (start i32) (end i32))
		(returns void)
		(body (array.store (local argv) (local index)
			(struct.new ArgSpan (start (local start)) (end (local end))))))

	(fn spec
		(params (form u32) (kind u32) (start i32) (end i32))
		(returns ArgSpec)
		(body (return (struct.new ArgSpec
			(form (local form)) (value_kind (local kind)) (name_start (local start)) (name_end (local end)))))))
