(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	argv_fixture_data

	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan) (type ArgSpec)))

	(fn put_four
		(params (data (mut-slice u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(slice.store (local data) (local start) (local a))
			(slice.store (local data) (i32.add.wrapping (local start) (i32 1)) (local b))
			(slice.store (local data) (i32.add.wrapping (local start) (i32 2)) (local c))
			(slice.store (local data) (i32.add.wrapping (local start) (i32 3)) (local d))))

	(fn set_arg
		(params (argv (mut-slice ArgSpan)) (index i32) (start i32) (end i32))
		(returns void)
		(body (slice.store (local argv) (local index)
			(record.make ArgSpan (start (local start)) (end (local end))))))

	(fn spec
		(params (form u32) (kind u32) (start i32) (end i32))
		(returns ArgSpec)
		(body (return (record.make ArgSpec
			(form (local form)) (value_kind (local kind)) (name_start (local start)) (name_end (local end)))))))
