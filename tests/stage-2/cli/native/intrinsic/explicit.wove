(module intrinsic_explicit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(bridge c-header "./accept.h" (let (:pragma (c_macro)) TYPE_VISIBLE i32))
	(use c-header "./types.h" (only (type Wide)))
	(use c-header "./accept.h" (only (value TYPE_VISIBLE)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (:expect (issues "gh:wove-lang/wove:576"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (local TYPE_VISIBLE)))))
