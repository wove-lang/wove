(module intrinsic_mixed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./produce.h" (only (value INTRINSIC_SAMPLE)))
	(use c-header "./accept.h" (only (value TYPE_VISIBLE) match_intrinsic))
	(bridge c-header "./accept.h"
		(use c-header "./types.h" (only (type Wide) (type Count)))
		(let (:pragma (c_optional) (c_macro)) TYPE_VISIBLE Count)
		(fn match_intrinsic (params (value Wide)) (returns i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:576"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq (call match_intrinsic (local INTRINSIC_SAMPLE)) 42i32) (then (return 1i32)))
			(return (int.convert i32 (local TYPE_VISIBLE))))))
