(module intrinsic_type_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./types.h"
		(use c-header "./before.h" (only))
		(type Wide (c-type "double\tlong"))
		(type Count (c-type "NativeCount")))

	(bridge c-header "./produce.h"
		(use c-header "./types.h" (only (type (as Wide SampleType))))
		(let (:pragma (c_macro)) INTRINSIC_SAMPLE SampleType)))
