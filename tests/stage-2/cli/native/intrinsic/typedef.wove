(module intrinsic_typedef
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./accept.h" (only (value TYPE_VISIBLE)))
	(bridge c-header "./accept.h"
		(use c-header "./types.h" (only (type Count)))
		(let (:pragma (c_optional) (c_macro)) TYPE_VISIBLE Count))

	(fn main (:expect (issues "gh:wove-lang/wove:576"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (int.convert i32 TYPE_VISIBLE)))))
