	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./accept.h"
		(use c-header "./types.h" (only (type (as Wide Input))))
		(let (:pragma (c_optional) (c_macro)) TYPE_VISIBLE i32)
		(fn match_intrinsic (params (value Input)) (returns i32))))
