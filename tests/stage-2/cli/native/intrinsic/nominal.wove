(module intrinsic_nominal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./produce.h" (only (value INTRINSIC_SAMPLE)))
	(use c-header "./accept.h" (only match_intrinsic))
	(bridge c-header "./accept.h"
		(type Different (c-type "long double"))
		(fn match_intrinsic (params (value Different)) (returns i32)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (:expect (issues "gh:wove-lang/wove:576"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call match_intrinsic (local INTRINSIC_SAMPLE))))))
