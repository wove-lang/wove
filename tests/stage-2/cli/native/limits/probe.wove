(module bundled_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<limits.h>" (only LIMIT_SELECTORS))
	(use c-header "./oracle.h" (only ORACLE_SELECTORS))
	(bridge c-header "./oracle.h"
		ORACLE_DECLARATIONS)

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			LIMIT_CHECKS
			(return 42i32))))
