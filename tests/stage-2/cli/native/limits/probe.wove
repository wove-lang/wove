(module bundled_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<limits.h>"
		(only
			(value LIMIT_MEMBER)
		))
	(use c-header "./oracle.h"
		(only
			(value LIMIT_ORACLE)
		))
	(bridge c-header "./oracle.h"
		(let LIMIT_ORACLE (:pragma (c_macro)) LIMIT_TYPE)
	)

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (LIMIT_TYPE:not-eq LIMIT_MEMBER LIMIT_ORACLE) (then (return LIMIT_STATUSi32)))
			(return 42i32))))
