(module times_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type ClockTicks) (type ProcessTimes) times))
	(use c-header "./oracle.h" (only fixture_seed_times fixture_clock_error fixture_read_ticks
		fixture_is_clock_error fixture_ticks_between fixture_match_times))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type ClockTicks) (type ProcessTimes)))
		(fn fixture_seed_times (params (sample (mut-ref ProcessTimes))) (returns void))
		(fn fixture_clock_error (params) (returns ClockTicks))
		(fn fixture_read_ticks (params) (returns ClockTicks))
		(fn fixture_is_clock_error (params (value ClockTicks)) (returns bool))
		(fn fixture_ticks_between (params (before ClockTicks) (value ClockTicks) (after ClockTicks))
			(returns bool))
		(fn fixture_match_times
			(params (sample (shared-ref ProcessTimes)) (user ClockTicks) (system ClockTicks)
				(child_user ClockTicks) (child_system ClockTicks))
			(returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut seeded (struct:new ProcessTimes))
			(call fixture_seed_times (borrow-mut seeded))
			(if (bool:not (int:eq ClockTicks (struct:get seeded tms_utime) (int:convert ClockTicks 4294967307u64)))
				(then (return 1i32)))
			(if (bool:not (int:eq ClockTicks (struct:get seeded tms_stime) (int:convert ClockTicks 4294967309u64)))
				(then (return 2i32)))
			(if (bool:not (int:eq ClockTicks (struct:get seeded tms_cutime) (int:convert ClockTicks 4294967313u64)))
				(then (return 3i32)))
			(if (bool:not (int:eq ClockTicks (struct:get seeded tms_cstime) (int:convert ClockTicks 4294967315u64)))
				(then (return 4i32)))

			(let error (call fixture_clock_error))
			(if (bool:not (call fixture_is_clock_error error)) (then (return 5i32)))
			(let-mut sample (struct:new ProcessTimes (tms_utime error) (tms_stime error)
				(tms_cutime error) (tms_cstime error)))
			(let before (call fixture_read_ticks))
			(let result (call times (borrow-mut sample)))
			(let after (call fixture_read_ticks))
			(if (int:eq ClockTicks result error) (then (return 6i32)))
			(if (bool:not (call fixture_ticks_between before result after)) (then (return 7i32)))
			(if (bool:not (call fixture_match_times (borrow-shared sample)
				(struct:get sample tms_utime) (struct:get sample tms_stime)
				(struct:get sample tms_cutime) (struct:get sample tms_cstime))) (then (return 8i32)))
			(return 42i32))))
