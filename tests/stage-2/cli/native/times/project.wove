(module project_times
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(type ClockTicks (c-type "clock_t"))
		(struct ProcessTimes
			(c-type "struct tms")
			(fields (tms_utime ClockTicks) (tms_stime ClockTicks)
				(tms_cutime ClockTicks) (tms_cstime ClockTicks)))
		(fn times (params (sample (mut-ref ProcessTimes))) (returns ClockTicks))))
