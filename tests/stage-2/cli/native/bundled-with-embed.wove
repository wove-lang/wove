(module bundled_with_embed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdlib.h>" (only abs))

	(let empty (embed "assets/empty.bin"))
	(let empty_string "")

	(fn assets_match
		(params (empty (shared-array u8)) (payload (shared-array u8)))
		(returns bool)
		(body
			(return (bool:and (i32:eq (array:len empty) (array:len empty_string))
				(bool:and (i32:eq (array:len payload) (i32 6))
					(u8:eq (array:load payload (i32 3)) (u8 255)))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let payload (embed "assets/payload.bin"))
			(if (bool:not (call assets_match (borrow-shared empty) (borrow-shared payload)))
				(then (return (i32 1))))
			(return (call abs (i32 -42))))))
