(module bundled_with_embed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdlib.h>" (only abs))

	(fn assets_match
		(params (empty (shared-array u8)) (payload (shared-array u8)))
		(returns bool)
		(body
			(return (bool.and (i32.eq (array.len (local empty)) (i32 0))
				(bool.and (i32.eq (array.len (local payload)) (i32 6))
					(u8.eq (array.load (local payload) (i32 3)) (u8 255)))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let empty (embed "assets/empty.bin"))
			(let payload (embed "assets/payload.bin"))
			(if (bool.not (call assets_match (borrow-shared (local empty)) (borrow-shared (local payload))))
				(then (return (i32 1))))
			(return (call abs (i32 -42))))))
