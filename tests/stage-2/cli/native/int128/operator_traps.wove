(module wide_integer_operator_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body
			(let bytes (array.load args 1i32))
			(match (array.load bytes 0i32)
				(case 97u8 (let result (i128.add-checked 170141183460469231731687303715884105727i128 1i128)) (return 99i32))
				(case 98u8 (let result (i128.sub-checked -170141183460469231731687303715884105728i128 1i128)) (return 99i32))
				(case 99u8 (let result (i128.mul-checked -170141183460469231731687303715884105728i128 -1i128)) (return 99i32))
				(case 100u8 (let result (i128.div -170141183460469231731687303715884105728i128 -1i128)) (return 99i32))
				(case 101u8 (let result (i128.shl 1i128 -1i32)) (return 99i32))
				(case 102u8 (let result (i128.shr 1i128 128i32)) (return 99i32))
				(case 103u8 (let result (i128.rotl 1i128 -1i32)) (return 99i32))
				(case 104u8 (let result (i128.rotr 1i128 128i32)) (return 99i32))
				(case 105u8 (let result (u128.add-checked 340282366920938463463374607431768211455u128 1u128)) (return 99i32))
				(case 106u8 (let result (u128.sub-checked 0u128 1u128)) (return 99i32))
				(case 107u8 (let result (u128.mul-checked 18446744073709551616u128 18446744073709551616u128)) (return 99i32))
				(case 108u8 (let result (u128.div 340282366920938463463374607431768211455u128 0u128)) (return 99i32))
				(case 109u8 (let result (u128.shl 1u128 -1i32)) (return 99i32))
				(case 110u8 (let result (u128.shr 1u128 128i32)) (return 99i32))
				(case 111u8 (let result (u128.rotl 1u128 -1i32)) (return 99i32))
				(case 112u8 (let result (u128.rotr 1u128 128i32)) (return 99i32))
				(case _ (return 98i32)))))
)
