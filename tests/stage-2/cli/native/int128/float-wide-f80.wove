(module int128_float_f80
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./float-wide.h" (only varying_i128 varying_u128 varying_f80))
	(bridge c-header "./float-wide.h"
		(fn varying_i128 (params (input i128)) (returns i128))
		(fn varying_u128 (params (input u128)) (returns u128))
		(fn varying_f80 (params (input f80)) (returns f80)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let signed (call varying_i128 -1267650600228229401565422682113i128))
			(let unsigned (call varying_u128 1267650600228229401565422682113u128))
			(if (i128:not-eq (i128:from-f80 (f80:from-i128 signed)) -1267650600228229401634142158848i128)
				(then (return 1i32)))
			(if (u128:not-eq (u128:from-f80 (f80:from-u128 unsigned)) 1267650600228229401634142158848u128)
				(then (return 2i32)))
			(let minimum (call varying_f80 -170141183460469231731687303715884105728f80))
			(if (i128:not-eq (i128:from-f80 minimum) -170141183460469231731687303715884105728i128)
				(then (return 3i32)))
			(if (u128:not-eqz (u128:from-f80 (call varying_f80 -0.875f80))) (then (return 4i32)))
			(return 42i32)))
)
