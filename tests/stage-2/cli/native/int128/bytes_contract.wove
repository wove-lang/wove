(module wide_byte_contract
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./bytes_contract.h"
		(fn wide_bytes (:pragma (c_bytes data size count))
			(params (data (shared-array u8)) (size i128) (count u128)) (returns i32)))
	(use c-header "./bytes_contract.h" (only wide_bytes))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body
			(let data (array.new (array u8 1) 42u8))
			(let length (array.len (local args)))
			(if (i32.eqz (local length)) (then (return (call wide_bytes (borrow-shared (local data)) 1i128 1u128))))
			(if (i32.eq (local length) 1i32) (then
				(return (call wide_bytes (borrow-shared (local data)) 1i128 18446744073709551617u128))))
			(return (call wide_bytes (borrow-shared (local data)) -18446744073709551615i128 1u128))))
)
