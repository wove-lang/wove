(module wide_byte_contract
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./bytes_contract.h"
		(fn wide_bytes (:pragma (c_bytes data size count))
			(params (data (shared-array u8)) (size i128) (count u128)) (returns i32)))
	(use c-header "./bytes_contract.h" (only wide_bytes))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body
			(let data (array:new (array u8 1) 42u8))
			(let length (i32:dec (array:len args)))
			(if (i32:eqz length) (then (return (call wide_bytes (borrow-shared data) 1i128 1u128))))
			(if (i32:eq length 1i32) (then
				(return (call wide_bytes (borrow-shared data) 1i128 18446744073709551617u128))))
			(return (call wide_bytes (borrow-shared data) -18446744073709551615i128 1u128))))
)
