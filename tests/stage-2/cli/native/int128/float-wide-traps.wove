(module int128_float_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./float-wide.h" (only varying_u128 varying_f64))
	(bridge c-header "./float-wide.h"
		(fn varying_u128 (params (input u128)) (returns u128))
		(fn varying_f64 (params (input f64)) (returns f64)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let choice (i32.dec (array.len (local args))))
			(if (i32.eqz (local choice))
				(then
					(let high (call varying_f64 170141183460469231731687303715884105728f64))
					(let result (i128.from-f64 (local high)))
					(return 7i32)))
			(if (i32.eq (local choice) 1i32)
				(then
					(let low (call varying_f64 (f64.from-bits 0xc7e0000000000001u64)))
					(let result (i128.from-f64 (local low)))
					(return 7i32)))
			(if (i32.eq (local choice) 2i32)
				(then
					(let high (call varying_f64 340282366920938463463374607431768211456f64))
					(let result (u128.from-f64 (local high)))
					(return 7i32)))
			(if (i32.eq (local choice) 3i32)
				(then
					(let low (call varying_f64 -1f64))
					(let result (u128.from-f64 (local low)))
					(return 7i32)))
			(if (i32.eq (local choice) 4i32)
				(then
					(let nan (call varying_f64 (f64.from-bits 0x7ff8000000000001u64)))
					(let result (i128.from-f64 (local nan)))
					(return 7i32)))
			(if (i32.eq (local choice) 5i32)
				(then
					(let infinity (call varying_f64 (f64.from-bits 0x7ff0000000000000u64)))
					(let result (u128.from-f64 (local infinity)))
					(return 7i32)))
			(let big (call varying_u128 0xffffff00000000000000000000000001u128))
			(let rounded (f32.from-u128 (local big)))
			(return 7i32)))
)
