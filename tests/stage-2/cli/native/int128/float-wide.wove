(module int128_float_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./float-wide.h" (only varying_i128 varying_u128 varying_f32 varying_f64))
	(bridge c-header "./float-wide.h"
		(fn varying_i128 (params (input i128)) (returns i128))
		(fn varying_u128 (params (input u128)) (returns u128))
		(fn varying_f32 (params (input f32)) (returns f32))
		(fn varying_f64 (params (input f64)) (returns f64)))

	(fn counted (params (value i128) (calls (mut-ref i32))) (returns i128)
		(body (set calls (i32:inc calls)) (return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:595"))
		(body
			(let low (call varying_f64 -170141183460469231731687303715884105728f64))
			(if (i128:not-eq (i128:from-f64 low) -0x80000000000000000000000000000000i128)
				(then (return 1i32)))
			(let upper (call varying_f64 (f64:from-bits 0x47efffffffffffffu64)))
			(if (u128:not-eq (u128:from-f64 upper) 0xfffffffffffff8000000000000000000u128)
				(then (return 2i32)))
			(if (i128:not-eq (i128:from-f32 (call varying_f32 -7.875f32)) -7i128)
				(then (return 3i32)))
			(if (u128:not-eqz (u128:from-f32 (call varying_f32 -0.875f32))) (then (return 4i32)))
			(let-mut calls 0i32)
			(let near_halfway (call varying_i128 -0x10000010000000000000000001i128))
			(let rounded (f32:to-bits (f32:from-i128 (call counted near_halfway (borrow-mut calls)))))
			(if (bool:or (u32:not-eq rounded 0xf1800001u32) (i32:not-eq calls 1i32))
				(then (return 5i32)))
			(if (u32:not-eq (f32:to-bits (f32:from-u128 (call varying_u128 0xffffff00000000000000000000000000u128))) 0x7f7fffffu32)
				(then (return 6i32)))
			(if (u64:not-eq (f64:to-bits (f64:from-i128 (call varying_i128 0x10000000000000800000000001i128))) 0x4630000000000001u64)
				(then (return 7i32)))
			(if (u64:not-eq (f64:to-bits (f64:from-u128 (call varying_u128 0xffffffffffffffffffffffffffffffffu128))) 0x47f0000000000000u64)
				(then (return 8i32)))
			(return 42i32)))
)
