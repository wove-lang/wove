(module int128_float_half
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./float-wide.h" (only varying_i128 varying_u128))
	(bridge c-header "./float-wide.h"
		(fn varying_i128 (params (input i128)) (returns i128))
		(fn varying_u128 (params (input u128)) (returns u128)))

	(fn as_i128 (params (value f16)) (returns i128)
		(body (return (i128:from-f16 value))))

	(fn as_u128 (params (value f16)) (returns u128)
		(body (return (u128:from-f16 value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let choice (i32:dec (array:len args)))
			(if (i32:eq choice 1i32)
				(then
					(let overflow (call varying_i128 -65505i128))
					(let value (f16:from-i128 overflow))
					(return 7i32)))
			(if (i32:eq choice 2i32)
				(then
					(let overflow (call varying_u128 65505u128))
					(let value (f16:from-u128 overflow))
					(return 7i32)))
			(let low (f16:from-i128 (call varying_i128 -65504i128)))
			(let high (f16:from-u128 (call varying_u128 65504u128)))
			(if (i128:not-eq (call as_i128 low) -65504i128) (then (return 1i32)))
			(if (u128:not-eq (call as_u128 high) 65504u128) (then (return 2i32)))
			(if (u128:not-eqz (call as_u128 -0.875f16)) (then (return 3i32)))
			(if (u16:not-eq (f16:to-bits (f16:from-i128 (call varying_i128 2049i128))) 0x6800u16)
				(then (return 4i32)))
			(return 42i32)))
)
