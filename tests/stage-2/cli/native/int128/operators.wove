	(fn word (params (trace (mut-ref i32)) (digit i32)) (returns u128)
		(body
			(set trace (i32:add (i32:mul trace 10i32) digit))
			(return 1u128)))

	(fn count (params (trace (mut-ref i32))) (returns i32)
		(body
			(set trace (i32:add (i32:mul trace 10i32) 4i32))
			(return 65i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body
			(if (bool:not (call check_i128 -170141183460469231731687303715884105728i128 170141183460469231731687303715884105727i128))
				(then (return 1i32)))
			(if (bool:not (call check_u128 0u128 340282366920938463463374607431768211455u128))
				(then (return 2i32)))
			(let-mut trace 0i32)
			(let sum (u128:add (call word (borrow-mut trace) 1i32) (call word (borrow-mut trace) 2i32)))
			(if (u128:not-eq sum 2u128) (then (return 3i32)))
			(let rotated (u128:rotl (call word (borrow-mut trace) 3i32) (call count (borrow-mut trace))))
			(if (u128:not-eq rotated 36893488147419103232u128) (then (return 4i32)))
