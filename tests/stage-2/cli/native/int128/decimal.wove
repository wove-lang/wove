(module int128_decimal_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./decimal_128.wove" (only write_decimal_i128 write_decimal_u128))
	(use wove-file "./bytes.wove" (only same_bytes))

	(let minimum "-170141183460469231731687303715884105728")
	(let maximum "340282366920938463463374607431768211455")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body
			(let-mut buffer (array:repeat (array u8 42) 255u8))
			(let signed (call write_decimal_i128 (borrow-mut buffer) 1i32 -170141183460469231731687303715884105728i128))
			(if (i32:not-eq signed 41i32) (then (return 1i32)))
			(if (bool:not (call same_bytes (borrow-shared buffer) 1i32 signed
				(borrow-shared minimum) 0i32 40i32)) (then (return 2i32)))
			(if (bool:not (bool:and (u8:eq (array:load buffer 0i32) 255u8)
				(u8:eq (array:load buffer 41i32) 255u8))) (then (return 3i32)))
			(let unsigned (call write_decimal_u128 (borrow-mut buffer) 1i32 340282366920938463463374607431768211455u128))
			(if (i32:not-eq unsigned 40i32) (then (return 4i32)))
			(if (bool:not (call same_bytes (borrow-shared buffer) 1i32 unsigned
				(borrow-shared maximum) 0i32 39i32)) (then (return 5i32)))
			(let zero (call write_decimal_u128 (borrow-mut buffer) 0i32 0u128))
			(if (bool:not (bool:and (i32:eq zero 1i32) (u8:eq (array:load buffer 0i32) 48u8)))
				(then (return 6i32)))
			(let-mut short (array:repeat (array u8 4) 255u8))
			(let result (call write_decimal_i128 (borrow-mut short) 1i32 -170141183460469231731687303715884105728i128))
			(if (i32:not-eq result -1i32) (then (return 7i32)))
			(if (u8:not-eq (array:load short 0i32) 255u8) (then (return 8i32)))
			(if (bool:not (call same_bytes (borrow-shared short) 1i32 4i32
				(borrow-shared minimum) 0i32 3i32)) (then (return 9i32)))
			(return 42i32)))
)
