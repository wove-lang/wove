(module int128_conversion_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body

			(let count (array.len (local args)))
			(if (i32.eqz (local count)) (then
				(let unused (u64.from-u128 18446744073709551616u128))
				(return 90i32)))
			(if (i32.eq (local count) 1i32) (then
				(let unused (i128.from-u128 340282366920938463463374607431768211455u128))
				(return 91i32)))
			(let unused (u128.from-le-bytes (local bytes)))
			(return 92i32)))
)
