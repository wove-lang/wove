(module int128_conversion_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:234"))
		(body

			(let count (i32:dec (array:len args)))
			(if (i32:eqz count) (then
				(let unused (u64:from-u128 18446744073709551616u128))
				(return 90i32)))
			(if (i32:eq count 1i32) (then
				(let unused (i128:from-u128 340282366920938463463374607431768211455u128))
				(return 91i32)))
			(let bytes (array:get args 1i32))
			(let unused (u128:from-le-bytes bytes))
			(return 92i32)))
)
