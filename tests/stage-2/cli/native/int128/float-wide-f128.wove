(module int128_float_f128
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./float-wide.h" (only varying_i128 varying_u128 varying_f128))
	(bridge c-header "./float-wide.h"
		(fn varying_i128 (params (input i128)) (returns i128))
		(fn varying_u128 (params (input u128)) (returns u128))
		(fn varying_f128 (params (input f128)) (returns f128)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let signed (call varying_i128 -1329227995784915872903807060280344705i128))
			(let unsigned (call varying_u128 1329227995784915872903807060280344705u128))
			(if (i128:not-eq (i128:from-f128 (f128:from-i128 signed)) -1329227995784915872903807060280344832i128)
				(then (return 1i32)))
			(if (u128:not-eq (u128:from-f128 (f128:from-u128 unsigned)) 1329227995784915872903807060280344832u128)
				(then (return 2i32)))
			(let minimum (call varying_f128 -170141183460469231731687303715884105728f128))
			(if (i128:not-eq (i128:from-f128 minimum) -170141183460469231731687303715884105728i128)
				(then (return 3i32)))
			(if (u128:not-eqz (u128:from-f128 (call varying_f128 -0.875f128))) (then (return 4i32)))
			(return 42i32)))
)
