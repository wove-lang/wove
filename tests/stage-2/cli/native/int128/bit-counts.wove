(module wide_bit_counts
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check_i128 (params (word i128) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (i128.clz (local word)) (local leading))
			(bool.and (i32.eq (i128.ctz (local word)) (local trailing))
				(i32.eq (i128.popcnt (local word)) (local population)))))))

	(fn check_u128 (params (word u128) (leading i32) (trailing i32) (population i32)) (returns bool)
		(body (return (bool.and (i32.eq (u128.clz (local word)) (local leading))
			(bool.and (i32.eq (u128.ctz (local word)) (local trailing))
				(i32.eq (u128.popcnt (local word)) (local population)))))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (bool.not (call check_i128 0i128 128i32 128i32 0i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 1i128 127i32 0i32 1i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 -170141183460469231731687303715884105728i128 0i32 127i32 1i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 0x7fff_ffff_ffff_ffff_ffff_ffff_ffff_ffffi128 1i32 0i32 127i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 -1i128 0i32 0i32 128i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 -8i128 0i32 3i32 125i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 0x8000_0000_0000_0000i128 64i32 63i32 1i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 0x1_0000_0000_0000_0000i128 63i32 64i32 1i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 0x2_0000_0000_0000_0000i128 62i32 65i32 1i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 0xffff_ffff_ffff_ffffi128 64i32 0i32 64i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 -18446744073709551616i128 0i32 64i32 64i32)) (then (return 11i32)))
			(if (bool.not (call check_i128 -170141183460469231722463931679029329920i128 0i32 63i32 2i32)) (then (return 11i32)))
			(if (bool.not (call check_u128 0u128 128i32 128i32 0i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 1u128 127i32 0i32 1i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0x8000_0000_0000_0000_0000_0000_0000_0000u128 0i32 127i32 1i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffffu128 0i32 0i32 128i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0x8000_0000_0000_0000_0000_0000_0000_0004u128 0i32 2i32 2i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0x8000_0000_0000_0000u128 64i32 63i32 1i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0x1_0000_0000_0000_0000u128 63i32 64i32 1i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0x2_0000_0000_0000_0000u128 62i32 65i32 1i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0xffff_ffff_ffff_ffffu128 64i32 0i32 64i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0xffff_ffff_ffff_ffff_0000_0000_0000_0000u128 0i32 64i32 64i32)) (then (return 12i32)))
			(if (bool.not (call check_u128 0x8000_0000_0000_0000_8000_0000_0000_0000u128 0i32 63i32 2i32)) (then (return 12i32)))
			(return 42i32)))
)
