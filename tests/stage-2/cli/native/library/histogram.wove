(module histogram
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let buckets 256i32)
	(let output_bytes (i32.mul (local buckets) 4i32))

	(fn byte_histogram
		(:pragma (c_export))
		(params (input (shared-array u8)) (output (mut-array u8 output_bytes)))
		(returns void)
		(body
			(let-mut counts (array.repeat (array u32 buckets) 0u32))
			(for (bind byte) (borrow-shared (local input))
				(body
					(let bucket (i32.from-u8 (local byte)))
					(let previous (array.load (local counts) (local bucket)))
					(array.store (local counts) (local bucket) (u32.inc (local previous)))))
			(for (bind bucket) (range 0i32 (local buckets))
				(body
					(let count (array.load (local counts) (local bucket)))
					(let start (i32.mul (local bucket) 4i32))
					(array.store (local output) (local start)
						(u8.from-u32 (u32.and (local count) 255u32)))
					(array.store (local output) (i32.inc (local start))
						(u8.from-u32 (u32.and (u32.shr (local count) 8i32) 255u32)))
					(array.store (local output) (i32.add (local start) 2i32)
						(u8.from-u32 (u32.and (u32.shr (local count) 16i32) 255u32)))
					(array.store (local output) (i32.add (local start) 3i32)
						(u8.from-u32 (u32.shr (local count) 24i32)))))))

	(fn bias_words
		(:pragma (c_export))
		(params (input (shared-array u32 2)) (bias u32) (output (mut-array u32 2)))
		(returns u32)
		(body
			(let left (u32.add (array.load (local input) 0i32) (local bias)))
			(let right (u32.add (array.load (local input) 1i32) (local bias)))
			(array.store (local output) 0i32 (local left))
			(array.store (local output) 1i32 (local right))
			(return (u32.add (local left) (local right)))))

	(fn shared_count
		(:pragma (c_export))
		(params (left (shared-array u32)) (right (shared-array u32)))
		(returns i32)
		(body (return (i32.add (array.len (local left)) (array.len (local right))))))

	(fn mark_pair
		(:pragma (c_export))
		(params (left (mut-array u8)) (right (mut-array u8)))
		(returns void)
		(body
			(if (i32.gtz (array.len (local left)))
				(then (array.store (local left) 0i32 17u8)))
			(if (i32.gtz (array.len (local right)))
				(then (array.store (local right) 0i32 25u8)))))
)
