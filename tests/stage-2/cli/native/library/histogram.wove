(module histogram
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let buckets 256i32)
	(let output_bytes (i32:mul buckets 4i32))

	(fn byte_histogram
		(:pragma (c_export))
		(params (input (shared-array u8)) (output (mut-array u8 output_bytes)))
		(returns void)
		(body
			(let-mut counts (array:repeat (array u32 buckets) 0u32))
			(for (let byte) (borrow-shared input)
				(body
					(let bucket (i32:from-u8 byte))
					(let previous (array:get counts bucket))
					(array:set counts bucket (u32:inc previous))))
			(for (let bucket) (range 0i32 buckets)
				(body
					(let count (array:get counts bucket))
					(let start (i32:mul bucket 4i32))
					(array:set output start
						(u8:from-u32 (u32:and count 255u32)))
					(array:set output (i32:inc start)
						(u8:from-u32 (u32:and (u32:shr count 8i32) 255u32)))
					(array:set output (i32:add start 2i32)
						(u8:from-u32 (u32:and (u32:shr count 16i32) 255u32)))
					(array:set output (i32:add start 3i32)
						(u8:from-u32 (u32:shr count 24i32)))))))

	(fn bias_words
		(:pragma (c_export))
		(params (input (shared-array u32 2)) (bias u32) (output (mut-array u32 2)))
		(returns u32)
		(body
			(let left (u32:add (array:get input 0i32) bias))
			(let right (u32:add (array:get input 1i32) bias))
			(array:set output 0i32 left)
			(array:set output 1i32 right)
			(return (u32:add left right))))

	(fn shared_count
		(:pragma (c_export))
		(params (left (shared-array u32)) (right (shared-array u32)))
		(returns i32)
		(body (return (i32:add (array:len left) (array:len right)))))

	(fn mark_pair
		(:pragma (c_export))
		(params (left (mut-array u8)) (right (mut-array u8)))
		(returns void)
		(body
			(if (i32:gtz (array:len left))
				(then (array:set left 0i32 17u8)))
			(if (i32:gtz (array:len right))
				(then (array:set right 0i32 25u8)))))
)
