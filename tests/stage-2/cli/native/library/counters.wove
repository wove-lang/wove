(module counters
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn Double (:pragma (c_export)) (params (value i32)) (returns i32)
		(body (return (i32:add value value))))

	(fn Half (:pragma (c_export)) (params (value f64)) (returns f64)
		(body (return (f64:div value 2.0f64)))))
