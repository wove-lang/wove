(module counters
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn Double (:pragma (c_export)) (params (value i32)) (returns i32)
		(body (return (i32.add value value))))

	(fn Answer (:pragma (c_export)) (params) (returns i32)
		(body (return 13i32))))
