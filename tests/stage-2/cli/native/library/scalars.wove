(module scalars
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./counters.wove" (only (as Double scale)))

	(fn private_trip (params (value i32)) (returns i32)
		(body (return (i32.add-checked value 1i32))))

	(fn Answer (:pragma (c_export)) (params) (returns i32)
		(body (return (call private_trip (call scale 20i32)))))

	(fn Mix (:pragma (c_export))
		(params (a i8) (b u8) (c i16) (d u16) (e i32) (f u32) (g i64) (h u64) (i f32) (j f64) (ok bool))
		(returns bool)
		(body
			(return (bool.and ok
				(bool.and (bool.and (i8.eq a -8i8) (u8.eq b 8u8))
					(bool.and (bool.and (i16.eq c -16i16) (u16.eq d 16u16))
						(bool.and (bool.and (i32.eq e -32i32) (u32.eq f 32u32))
							(bool.and (bool.and (i64.eq g -64i64) (u64.eq h 64u64))
								(bool.and (f32.eq i 3.25f32) (f64.eq j 42.5f64))))))))))

	(fn Reset (:pragma (cfg (any (os "macos") (os "linux"))) (c_export))
		(params) (returns void) (body))

	(fn hidden_test (:pragma (cfg test) (c_export))
		(params) (returns i32) (body (return 5i32))))
