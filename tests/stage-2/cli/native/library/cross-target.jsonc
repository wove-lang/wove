{
	"profiles": [
		{
			"name": "default",
			"entry": {"lib": ["scalars.wove"]},
			"build": {"default": {"cflags": ["--target=aarch64-linux-gnu", "-Werror"], "ldflags": ["-lc"]}}
		},
		{
			"name": "darwin",
			"build": {"default": {"cflags": ["--target=arm64-apple-macos", "-Werror"]}}
		}
	]
}
