	(use c-header "./trampoline.h" (only (as wgy0000000prefix seed)))
	(bridge c-header "./trampoline.h"
		(fn wgy0000000prefix (params) (returns i32)))

	(fn Answer (:pragma (c_export)) (params) (returns i32)
		(body (return (call seed)))))
