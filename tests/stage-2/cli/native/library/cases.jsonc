{
	"platforms": {"darwin": {"suffix": ".dylib"}, "linux": {"suffix": ".so"}},
	"files": {"wovec.jsonc": "project.jsonc", "scalars.wove": "scalars.wove", "counters.wove": "counters.wove"},
	"cases": [
		{
			"name": "default name, exact exported symbols and consumer ABI",
			"files": {"consumer.c": "consumer.c"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"]},
			"absent": [".wovec-bin.*"],
			"inspect": {
				"libscalars.h": {"matches": ["int32_t Answer\\(void\\);", "int32_t Double\\(int32_t\\);", "double Half\\(double\\);", "void Reset\\(void\\);", "bool Mix\\(int8_t, uint8_t, int16_t, uint16_t, int32_t, uint32_t, int64_t, uint64_t, float, double, bool\\);"], "omits": ["private_trip", "hidden_test", "scale", "wvrt_", "WvrtCStatus"]},
				".wovec-cache/default/libscalars{suffix}/bin/main.c": {"matches": ["__asm__\\(WVEX_LABEL\\(__USER_LABEL_PREFIX__\\) \"Double\"", "wvrt_int_checked"]}
			},
			"verify": [
				{"argv": ["{clang}", "-x", "c++", "-std=c++20", "-fsyntax-only", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I.", "consumer.c"]},
				{"argv": ["{clang}", "-std=c17", "-O2", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I.", "consumer.c", "./libscalars{suffix}", "-Wl,-rpath,.", "-o", "consumer"]},
				{"argv": ["./consumer"], "exit": 42}
			],
			"darwin": [
				{"argv": ["nm", "-gU", "libscalars{suffix}"], "stdout": "[0-9a-f]+ T _Answer\n[0-9a-f]+ T _Double\n[0-9a-f]+ T _Half\n[0-9a-f]+ T _Mix\n[0-9a-f]+ T _Reset\n"},
				{"argv": ["otool", "-D", "libscalars{suffix}"], "stdout": "libscalars\\.dylib:\\n@rpath/libscalars\\.dylib\\n"}
			],
			"linux": [
				{"argv": ["nm", "-D", "--defined-only", "libscalars{suffix}"], "stdout": "[0-9a-f]+ T Answer\n[0-9a-f]+ T Double\n[0-9a-f]+ T Half\n[0-9a-f]+ T Mix\n[0-9a-f]+ T Reset\n"},
				{"argv": ["readelf", "-d", "libscalars{suffix}"], "stdout": "(?s).*\\(SONAME\\)\\s+Library soname: \\[libscalars\\.so\\].*"}
			]
		},
		{
			"name": "checked borrowed views and the complete Byte Histogram wire output",
			"files": {"histogram.wove": "histogram.wove", "histogram-consumer.c": "histogram-consumer.c"},
			"build": {"argv": ["{wovec}", "bin", "histogram.wove", "--profile", "custom"]},
			"absent": [".wovec-bin.*"],
			"inspect": {
				"libhistogram.h": {"matches": ["typedef int32_t WvrtCStatus;", "WvrtCStatus byte_histogram\\(const uint8_t\\*, size_t, uint8_t\\*, size_t\\);", "WvrtCStatus bias_words\\(const uint32_t\\*, size_t, uint32_t, uint32_t\\*, size_t, uint32_t\\*\\);"], "omits": ["wvrt_c_export_validate", "wvrt_slice"]}
			},
			"verify": [
				{"argv": ["{clang}", "-x", "c++", "-std=c++20", "-fsyntax-only", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I.", "histogram-consumer.c"]},
				{"argv": ["{clang}", "-std=c17", "-O2", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-I.", "histogram-consumer.c", "./libhistogram{suffix}", "-Wl,-rpath,.", "-o", "consumer"]},
				{"argv": ["./consumer"], "exit": 42}
			],
			"darwin": [
				{"argv": ["nm", "-gU", "libhistogram{suffix}"], "stdout": "[0-9a-f]+ T _bias_words\n[0-9a-f]+ T _byte_histogram\n[0-9a-f]+ T _mark_pair\n[0-9a-f]+ T _shared_count\n"}
			],
			"linux": [
				{"argv": ["nm", "-D", "--defined-only", "libhistogram{suffix}"], "stdout": "[0-9a-f]+ T bias_words\n[0-9a-f]+ T byte_histogram\n[0-9a-f]+ T mark_pair\n[0-9a-f]+ T shared_count\n"}
			]
		},
		{
			"name": "a failed link preserves the previous borrowed view interface and image",
			"files": {"histogram.wove": "histogram.wove"},
			"prepare": [{"argv": ["{wovec}", "bin", "histogram.wove"]}],
			"replace": {"histogram.wove": "replacement.wove"},
			"preserve": ["libhistogram{suffix}", "libhistogram.h", ".wovec-cache/default/libhistogram{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "histogram.wove", "--ldflag=-lwove_fixture_missing_library"], "exit": 1, "stderr": ".*wove_fixture_missing_library.*", "diagnostic": {"code": 68, "message": "clang failed with status 1", "location": {"kind": "argv", "index": 0}}},
			"absent": [".wovec-bin.*"]
		},
		{
			"name": "inherited list and explicit suffixless target",
			"build": {"argv": ["{wovec}", "bin", "scalars.wove", "--profile", "custom", "-o", "with, spaces/custom"]},
			"absent": ["with, spaces/.wovec-bin.*"],
			"inspect": {
				"with, spaces/custom.h": {"matches": ["int32_t Answer\\(void\\);", "int32_t Double\\(int32_t\\);", "double Half\\(double\\);", "void Reset\\(void\\);", "bool Mix\\(int8_t, uint8_t, int16_t, uint16_t, int32_t, uint32_t, int64_t, uint64_t, float, double, bool\\);"]},
				"with, spaces/.wovec-cache/custom/custom/bin/main.c": {"matches": ["wvex_Answer"]}
			},
			"darwin": [
				{"argv": ["otool", "-D", "with, spaces/custom"], "stdout": "with, spaces/custom:\n@rpath/custom\n"}
			],
			"linux": [
				{"argv": ["readelf", "-d", "with, spaces/custom"], "stdout": "(?s).*\\(SONAME\\)\\s+Library soname: \\[custom\\].*"}
			]
		},
		{
			"name": "empty list opts out",
			"build": {"argv": ["{wovec}", "bin", "scalars.wove", "--profile", "executable"], "exit": 1, "diagnostic": {"code": 12, "message": "bin requires one explicit source and an explicit output target", "location": {"kind": "argv", "index": 0}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-cache"]
		},
		{
			"name": "imported duplicate public name",
			"files": {"counters.wove": "duplicate.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 32, "message": "invalid Wove source", "location": {"kind": "source", "file": "counters.wove", "start": 259, "end": 265}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "reserved public name",
			"files": {"scalars.wove": "reserved.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 33, "message": "invalid Wove source", "location": {"kind": "source", "file": "scalars.wove", "start": 133, "end": 140}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "public export avoids the consumer name printf",
			"files": {"scalars.wove": "reserved-printf.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 33, "message": "invalid Wove source", "location": {"kind": "source", "file": "scalars.wove", "start": 133, "end": 139}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "public export avoids the consumer name puts",
			"files": {"scalars.wove": "reserved-puts.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 33, "message": "invalid Wove source", "location": {"kind": "source", "file": "scalars.wove", "start": 133, "end": 137}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "public export avoids the consumer name class",
			"files": {"scalars.wove": "reserved-class.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 33, "message": "invalid Wove source", "location": {"kind": "source", "file": "scalars.wove", "start": 133, "end": 138}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "public export avoids the consumer name operator",
			"files": {"scalars.wove": "reserved-operator.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 33, "message": "invalid Wove source", "location": {"kind": "source", "file": "scalars.wove", "start": 133, "end": 141}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "unsupported public parameter",
			"files": {"scalars.wove": "unsupported.wove"},
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 23, "message": "invalid Wove source", "location": {"kind": "source", "file": "scalars.wove", "start": 174, "end": 179}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "preserve handwritten header",
			"files": {"libscalars.h": "handwritten.h"},
			"preserve": ["libscalars.h"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 69, "message": "cannot replace the shared library's public header", "location": {"kind": "argv", "index": 1}}},
			"absent": ["libscalars{suffix}", ".wovec-bin.*", ".wovec-cache"]
		},
		{
			"name": "Clang compile failure retains all artifacts",
			"replace": {"scalars.wove": "replacement.wove"},
			"prepare": [{"argv": ["{wovec}", "bin", "scalars.wove"]}],
			"preserve": ["libscalars{suffix}", "libscalars.h", ".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove", "--cflag=-includewove_fixture_missing_compile.h"], "exit": 1, "stderr": ".*wove_fixture_missing_compile.h.*", "diagnostic": {"code": 68, "message": "clang failed with status 1", "location": {"kind": "argv", "index": 0}}},
			"absent": [".wovec-bin.*"]
		},
		{
			"name": "native link failure retains all artifacts",
			"replace": {"scalars.wove": "replacement.wove"},
			"prepare": [{"argv": ["{wovec}", "bin", "scalars.wove"]}],
			"preserve": ["libscalars{suffix}", "libscalars.h", ".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove", "--ldflag=-lwove_fixture_missing_library"], "exit": 1, "stderr": ".*wove_fixture_missing_library.*", "diagnostic": {"code": 68, "message": "clang failed with status 1", "location": {"kind": "argv", "index": 0}}},
			"absent": [".wovec-bin.*"]
		},
		{
			"name": "compile-only tool result retains the library",
			"replace": {"scalars.wove": "replacement.wove"},
			"prepare": [{"argv": ["{wovec}", "bin", "scalars.wove"]}],
			"preserve": ["libscalars{suffix}", "libscalars.h", ".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove", "--cflag=-c"], "exit": 1, "stderr": ".*-Wunused-command-line-argument.*", "diagnostic": {"code": 69, "message": "could not publish shared library", "location": {"kind": "argv", "index": 1}}},
			"absent": [".wovec-bin.*"]
		},
		{
			"name": "blocked library destination preserves retained C and the public header",
			"prepare": [{"argv": ["{wovec}", "bin", "scalars.wove"]}],
			"replace": {"scalars.wove": "replacement.wove"},
			"blocked_destinations": ["libscalars{suffix}"],
			"preserve": ["libscalars{suffix}", "libscalars.h", ".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 69, "message": "could not publish shared library", "location": {"kind": "argv", "index": 1}}},
			"absent": [".wovec-bin.*"]
		},
		{
			"name": "retained C failure restores both previous public entries",
			"prepare": [{"argv": ["{wovec}", "bin", "scalars.wove"]}],
			"replace": {"scalars.wove": "replacement.wove"},
			"blocked_destinations": [".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"preserve": ["libscalars{suffix}", "libscalars.h", ".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 65, "message": "could not publish retained C", "location": {"kind": "argv", "index": 1}}},
			"absent": [".wovec-bin.*", ".wovec-cache/default/libscalars{suffix}/bin/main.c.*"]
		},
		{
			"name": "retained C failure removes newly installed public entries",
			"blocked_destinations": [".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"preserve": [".wovec-cache/default/libscalars{suffix}/bin/main.c"],
			"build": {"argv": ["{wovec}", "bin", "scalars.wove"], "exit": 1, "diagnostic": {"code": 65, "message": "could not publish retained C", "location": {"kind": "argv", "index": 1}}},
			"absent": ["libscalars{suffix}", "libscalars.h", ".wovec-bin.*", ".wovec-cache/default/libscalars{suffix}/bin/main.c.*"]
		}
	]
}
