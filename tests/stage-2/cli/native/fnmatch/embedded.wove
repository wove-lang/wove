(module bundled_fnmatch_embedded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fnmatch.h>" (only fnmatch))
	(let pattern "a\0*")
	(let name "abc")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fnmatch (borrow-shared pattern) (borrow-shared name) 0i32)))))
