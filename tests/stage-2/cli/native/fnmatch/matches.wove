(module bundled_fnmatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fnmatch.h>"
		(only fnmatch (value FNM_PATHNAME) (value FNM_NOESCAPE) (value FNM_PERIOD) (value FNM_NOMATCH)
			(value FNM_LEADING_DIR) (value FNM_CASEFOLD) (value FNM_FILE_NAME) (value FNM_NOSYS)))
	(use (:pragma (cfg (os "macos"))) c-header "<fnmatch.h>" (only (value FNM_IGNORECASE)))
	(use (:pragma (cfg (os "linux"))) c-header "<fnmatch.h>" (only (value FNM_EXTMATCH)))
	(use c-header "./oracle.h" (only fixture_fnmatch fixture_fnmatch_constant))
	(bridge c-header "./oracle.h"
		(fn fixture_fnmatch
			(:pragma (c_cstr pattern name))
			(params (pattern (shared-array u8)) (name (shared-array u8)) (flags i32)) (returns i32))
		(fn fixture_fnmatch_constant (params (member i32)) (returns i32)))

	(let star "a*b")
	(let ordinary "axxb")
	(let wrong "axxc")
	(let slash "a/b")
	(let wildcard "*")
	(let leading_dot ".env")
	(let subdir_wildcard "x/*")
	(let subdir_dot "x/.env")
	(let escaped "a\\*b")
	(let literal_star "a*b")
	(let literal_backslash "a\\zzb")
	(let prefix "src")
	(let directory "src/mod.wove")
	(let lowercase "readme")
	(let uppercase "README")
	(let empty "")
	(let alternatives (:pragma (cfg (os "linux"))) "@(foo|bar)")
	(let alternative (:pragma (cfg (os "linux"))) "bar")

	(fn agrees
		(params (pattern (shared-array u8)) (name (shared-array u8)) (flags i32) (expected i32))
		(returns bool)
		(body
			(let actual (call fnmatch (borrow-shared pattern) (borrow-shared name) flags))
			(let direct (call fixture_fnmatch (borrow-shared pattern) (borrow-shared name) flags))
			(return (bool:and (i32:eq actual expected) (i32:eq actual direct)))))

	(fn platform_extension (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body
			(return (bool:and
				(bool:and (i32:eq FNM_IGNORECASE (call fixture_fnmatch_constant 8i32))
					(i32:eq FNM_IGNORECASE FNM_CASEFOLD))
				(call agrees (borrow-shared lowercase) (borrow-shared uppercase)
					FNM_IGNORECASE 0i32)))))
	(fn platform_extension (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body
			(return (bool:and
				(i32:eq FNM_EXTMATCH (call fixture_fnmatch_constant 9i32))
				(bool:and
					(call agrees (borrow-shared alternatives) (borrow-shared alternative) 0i32 FNM_NOMATCH)
					(call agrees (borrow-shared alternatives) (borrow-shared alternative) FNM_EXTMATCH 0i32))))))
	(fn platform_extension (:pragma (cfg (not (any (os "macos") (os "linux"))))) (params) (returns bool)
		(body (return (bool true))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq FNM_PATHNAME (call fixture_fnmatch_constant 0i32)) (then (return 1i32)))
			(if (i32:not-eq FNM_NOESCAPE (call fixture_fnmatch_constant 1i32)) (then (return 2i32)))
			(if (i32:not-eq FNM_PERIOD (call fixture_fnmatch_constant 2i32)) (then (return 3i32)))
			(if (i32:not-eq FNM_NOMATCH (call fixture_fnmatch_constant 3i32)) (then (return 4i32)))
			(if (i32:not-eq FNM_LEADING_DIR (call fixture_fnmatch_constant 4i32)) (then (return 5i32)))
			(if (i32:not-eq FNM_CASEFOLD (call fixture_fnmatch_constant 5i32)) (then (return 6i32)))
			(if (i32:not-eq FNM_FILE_NAME (call fixture_fnmatch_constant 6i32)) (then (return 7i32)))
			(if (i32:not-eq FNM_NOSYS (call fixture_fnmatch_constant 7i32)) (then (return 8i32)))
			(if (i32:not-eq FNM_FILE_NAME FNM_PATHNAME) (then (return 9i32)))
			(let no_match FNM_NOMATCH)
			(if (bool:not (call agrees (borrow-shared star) (borrow-shared ordinary) 0i32 0i32)) (then (return 10i32)))
			(if (bool:not (call agrees (borrow-shared star) (borrow-shared wrong) 0i32 no_match)) (then (return 11i32)))
			(if (bool:not (call agrees (borrow-shared empty) (borrow-shared empty) 0i32 0i32)) (then (return 12i32)))
			(if (bool:not (call agrees (borrow-shared star) (borrow-shared slash) 0i32 0i32)) (then (return 13i32)))
			(if (bool:not (call agrees (borrow-shared star) (borrow-shared slash) FNM_PATHNAME no_match)) (then (return 14i32)))
			(if (bool:not (call agrees (borrow-shared star) (borrow-shared slash) FNM_FILE_NAME no_match)) (then (return 15i32)))
			(if (bool:not (call agrees (borrow-shared wildcard) (borrow-shared leading_dot) 0i32 0i32)) (then (return 16i32)))
			(if (bool:not (call agrees (borrow-shared wildcard) (borrow-shared leading_dot) FNM_PERIOD no_match)) (then (return 17i32)))
			(if (bool:not (call agrees (borrow-shared subdir_wildcard) (borrow-shared subdir_dot)
				(i32:or FNM_PATHNAME FNM_PERIOD) no_match)) (then (return 18i32)))
			(if (bool:not (call agrees (borrow-shared escaped) (borrow-shared literal_star) 0i32 0i32)) (then (return 19i32)))
			(if (bool:not (call agrees (borrow-shared escaped) (borrow-shared literal_star) FNM_NOESCAPE no_match)) (then (return 20i32)))
			(if (bool:not (call agrees (borrow-shared escaped) (borrow-shared literal_backslash) FNM_NOESCAPE 0i32)) (then (return 21i32)))
			(if (bool:not (call agrees (borrow-shared prefix) (borrow-shared directory) 0i32 no_match)) (then (return 22i32)))
			(if (bool:not (call agrees (borrow-shared prefix) (borrow-shared directory) FNM_LEADING_DIR 0i32)) (then (return 23i32)))
			(if (bool:not (call agrees (borrow-shared lowercase) (borrow-shared uppercase) 0i32 no_match)) (then (return 24i32)))
			(if (bool:not (call agrees (borrow-shared lowercase) (borrow-shared uppercase) FNM_CASEFOLD 0i32)) (then (return 25i32)))
			(if (bool:not (call platform_extension)) (then (return 26i32)))
			(return 42i32))))
