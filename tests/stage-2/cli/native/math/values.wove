(module bundled_math_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<math.h>" (only (as cos cosine) sin sqrt cosf hypot fma j0 frexp modff remquo
		llround nan fpclassify isfinite (value FP_NAN) (value HUGE_VAL) (value M_PI_2)))
	(let payload "0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let angle (f64.from-i32 (i32.dec (array.len (local args)))))
			(if (f64.not-eq (call cosine (local angle)) 1.0f64) (then (return 1i32)))
			(if (f64.lt (call sin (local M_PI_2)) 0.999999999999999f64) (then (return 2i32)))
			(if (f64.not-eq (call sqrt 81.0f64) 9.0f64) (then (return 3i32)))
			(if (f32.not-eq (call cosf 0.0f32) 1.0f32) (then (return 4i32)))
			(if (f64.not-eq (call hypot 3.0f64 4.0f64) 5.0f64) (then (return 5i32)))
			(if (f64.not-eq (call fma 2.0f64 3.0f64 4.0f64) 10.0f64) (then (return 6i32)))
			(if (f64.not-eq (call j0 0.0f64) 1.0f64) (then (return 7i32)))

			(let-mut exponent 0i32)
			(let fraction (call frexp 12.0f64 (borrow-mut (local exponent))))
			(if (bool.or (f64.not-eq (local fraction) 0.75f64) (i32.not-eq (local exponent) 4i32))
				(then (return 8i32)))

			(let-mut integral 0.0f32)
			(let remaining (call modff -4.5f32 (borrow-mut (local integral))))
			(if (bool.or (f32.not-eq (local remaining) -0.5f32) (f32.not-eq (local integral) -4.0f32))
				(then (return 9i32)))

			(let-mut quotient 0i32)
			(let remainder (call remquo 7.0f64 4.0f64 (borrow-mut (local quotient))))
			(if (bool.or (f64.not-eq (local remainder) -1.0f64)
				(i32.not-eq (i32.and (local quotient) 7i32) 2i32)) (then (return 10i32)))

			(if (i32.not-eq (int.convert i32 (call llround 41.75f64)) 42i32) (then (return 11i32)))
			(let quiet_nan (call nan (borrow-shared (local payload))))
			(if (i32.not-eq (call fpclassify (local quiet_nan)) (local FP_NAN)) (then (return 12i32)))
			(if (call isfinite (local HUGE_VAL)) (then (return 13i32)))
			(return 42i32)))
)
