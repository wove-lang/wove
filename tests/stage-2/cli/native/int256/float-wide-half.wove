(module int256_float_half
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./float-wide.h" (only varying_signed varying_unsigned))
	(bridge c-header "./float-wide.h"
		(fn varying_signed (params (input i256)) (returns i256))
		(fn varying_unsigned (params (input u256)) (returns u256)))

	(fn as_i256 (params (value f16)) (returns i256)
		(body (return (i256.from-f16 value))))

	(fn as_u256 (params (value f16)) (returns u256)
		(body (return (u256.from-f16 value))))

	(fn verify_half (params (choice i32)) (returns i32)
		(body
			(if (i32.eq choice 1i32)
				(then
					(let overflow (call varying_signed -65505i256))
					(let value (f16.from-i256 overflow))
					(return 7i32)))
			(if (i32.eq choice 2i32)
				(then
					(let overflow (call varying_unsigned 65505u256))
					(let value (f16.from-u256 overflow))
					(return 7i32)))
			(let low (f16.from-i256 (call varying_signed -65504i256)))
			(let high (f16.from-u256 (call varying_unsigned 65504u256)))
			(if (i256.not-eq (call as_i256 low) -65504i256) (then (return 1i32)))
			(if (u256.not-eq (call as_u256 high) 65504u256) (then (return 2i32)))
			(if (u256.not-eqz (call as_u256 -0.875f16)) (then (return 3i32)))
			(if (u16.not-eq (f16.to-bits (f16.from-i256 (call varying_signed 2049i256))) 0x6800u16)
				(then (return 4i32)))
			(return 42i32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call verify_half (i32.dec (array.len args))))))
)
