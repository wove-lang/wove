(module int256_bit_sites
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn shift_left (params (word i256) (count i32)) (returns i256)
		(body (return (i256.shl
			word
			count))))

	(fn shift_right (params (word u256) (count i32)) (returns u256)
		(body (return (u256.shr
			word
			count))))

	(fn rotate_left (params (word i256) (count i32)) (returns i256)
		(body (return (i256.rotl
			word
			count))))

	(fn rotate_right (params (word u256) (count i32)) (returns u256)
		(body (return (u256.rotr
			word
			count))))
)
