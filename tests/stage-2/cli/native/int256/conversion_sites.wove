(module bitint_conversion_sites
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn too_narrow (params (value u256)) (returns i32)
		(body (return (i32:from-u256 value))))

	(fn needs_sign (params (value u256)) (returns i256)
		(body (return (int:convert i256 value))))

	(fn needs_unsigned (params (value i256)) (returns u256)
		(body (return (u256:from-i256 value))))

	(fn needs_width (params (bytes (shared-array u8))) (returns i256)
		(body (return (i256:from-be-bytes bytes))))
)
