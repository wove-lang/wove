	(fn ignore (:pragma (cfg (os "none"))) (params (word i256)) (returns i32)
		(body (let wide 1u256) (return 0i32)))
	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
