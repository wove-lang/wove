(module excluded_bitint
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Span (fields (start i32) (end i32)))
	(fn ignore (:pragma (cfg (os "none"))) (params (word i256)) (returns i32)
		(body (let wide 1u256) (return 0i32)))
	(fn main (params (argv (shared-array u8)) (spans (shared-array Span))) (returns i32)
		(body (return 42i32))))
