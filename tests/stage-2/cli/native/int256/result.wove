(module bitint_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Span (fields (start i32) (end i32)))
	(fn again (params) (returns u256) (body (return (call again))))
	(fn main (params (argv (shared-array u8)) (spans (shared-array Span))) (returns i32)
		(body (let value (call again)) (return 42i32))))
