(module bitint_fits_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Span (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (spans (shared-array Span))) (returns i32)
		(body
			(if (u256.fits 1u8) (then (return 42i32)))
			(return 1i32)))
)
