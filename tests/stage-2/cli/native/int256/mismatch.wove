(module bitint_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Span (fields (start i32) (end i32)))
	(fn inspect (params (word i256)) (returns i32) (body (return 0i32)))
	(fn main (params (argv (shared-array u8)) (spans (shared-array Span))) (returns i32)
		(body (return (call inspect 1u256)))))
