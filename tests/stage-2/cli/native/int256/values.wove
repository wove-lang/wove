(module bitint_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./forward.wove" (only take_pair (type Pair)))
	(use c-header "./values.h" (only check_wide))
	(bridge c-header "./values.h"
		(fn check_wide (params (minimum i256) (maximum i256) (unsigned u256) (binary u256))
			(returns i32)))
	(let maximum_unsigned 115792089237316195423570985008687907853269984665640564039457584007913129639935u256)
	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let maximum (i256 57896044618658097711785492504343953926634992332820282019728792003956564819967))
			(let minimum -0x8000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000i256)
			(let row (call take_pair (struct:new Pair (signed minimum) (unsigned maximum_unsigned))))
			(let binary 0b10000000000000000000000000000000_00000000000000000000000000000001_00000000000000000000000000000001_00000000000000000000000000000001_00000000000000000000000000000001_00000000000000000000000000000001_00000000000000000000000000000001_00000000000000000000000000000001u256)
			(return (call check_wide (struct:get row signed) maximum
				(struct:get row unsigned) binary)))))
