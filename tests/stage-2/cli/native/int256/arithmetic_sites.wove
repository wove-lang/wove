(module bitint_arithmetic_sites
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn signed_add_overflow (params (left i256) (right i256)) (returns i256)
		(body (return (i256.add-checked
			(local left) (local right)))))

	(fn signed_sub_overflow (params (left i256) (right i256)) (returns i256)
		(body (return (i256.sub-checked
			(local left) (local right)))))

	(fn signed_mul_overflow (params (left i256) (right i256)) (returns i256)
		(body (return (i256.mul-checked
			(local left) (local right)))))

	(fn unsigned_add_overflow (params (left u256) (right u256)) (returns u256)
		(body (return (u256.add-checked
			(local left) (local right)))))

	(fn unsigned_sub_overflow (params (left u256) (right u256)) (returns u256)
		(body (return (u256.sub-checked
			(local left) (local right)))))

	(fn unsigned_mul_overflow (params (left u256) (right u256)) (returns u256)
		(body (return (u256.mul-checked
			(local left) (local right)))))

	(fn signed_div_overflow (params (left i256) (right i256)) (returns i256)
		(body (return (i256.div
			(local left) (local right)))))

	(fn signed_div_zero (params (left i256) (right i256)) (returns i256)
		(body (return (i256.div
			(local left) (local right)))))

	(fn signed_rem_zero (params (left i256) (right i256)) (returns i256)
		(body (return (i256.rem
			(local left) (local right)))))

	(fn unsigned_div_zero (params (left u256) (right u256)) (returns u256)
		(body (return (u256.div
			(local left) (local right)))))

	(fn unsigned_rem_zero (params (left u256) (right u256)) (returns u256)
		(body (return (u256.rem
			(local left) (local right)))))
)
