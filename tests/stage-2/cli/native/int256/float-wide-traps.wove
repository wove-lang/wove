(module int256_float_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./float-wide.h" (only varying_signed varying_unsigned varying_f32 varying_f64))
	(bridge c-header "./float-wide.h"
		(fn varying_signed (params (input i256)) (returns i256))
		(fn varying_unsigned (params (input u256)) (returns u256))
		(fn varying_f32 (params (input f32)) (returns f32))
		(fn varying_f64 (params (input f64)) (returns f64)))

	(fn signed_upper (params) (returns i32)
		(body
			(let result (i256:from-f64 (call varying_f64 (f64:from-bits 0x4fe0000000000000u64))))
			(return 7i32)))

	(fn signed_below (params) (returns i32)
		(body
			(let result (i256:from-f64 (call varying_f64 (f64:from-bits 0xcfe0000000000001u64))))
			(return 7i32)))

	(fn unsigned_upper (params) (returns i32)
		(body
			(let result (u256:from-f64 (call varying_f64 (f64:from-bits 0x4ff0000000000000u64))))
			(return 7i32)))

	(fn unsigned_negative (params) (returns i32)
		(body
			(let result (u256:from-f64 (call varying_f64 -1f64)))
			(return 7i32)))

	(fn nan (params) (returns i32)
		(body
			(let result (i256:from-f32 (call varying_f32 (f32:from-bits 0x7fc00001u32))))
			(return 7i32)))

	(fn infinity (params) (returns i32)
		(body
			(let result (u256:from-f64 (call varying_f64 (f64:from-bits 0x7ff0000000000000u64))))
			(return 7i32)))

	(fn f32_unsigned_high (params) (returns i32)
		(body
			(let result (f32:from-u256 (call varying_unsigned 0xffffff00000000000000000000000001u256)))
			(return 7i32)))

	(fn f32_signed_high (params) (returns i32)
		(body
			(let result (f32:from-i256 (call varying_signed 0xffffff00000000000000000000000001i256)))
			(return 7i32)))

	(fn f32_signed_low (params) (returns i32)
		(body
			(let result (f32:from-i256 (call varying_signed -0xffffff00000000000000000000000001i256)))
			(return 7i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let choice (i32:dec (array:len args)))
			(if (i32:eq choice 0i32) (then (return (call signed_upper))))
			(if (i32:eq choice 1i32) (then (return (call signed_below))))
			(if (i32:eq choice 2i32) (then (return (call unsigned_upper))))
			(if (i32:eq choice 3i32) (then (return (call unsigned_negative))))
			(if (i32:eq choice 4i32) (then (return (call nan))))
			(if (i32:eq choice 5i32) (then (return (call infinity))))
			(if (i32:eq choice 6i32) (then (return (call f32_unsigned_high))))
			(if (i32:eq choice 7i32) (then (return (call f32_signed_high))))
			(return (call f32_signed_low))))
)
