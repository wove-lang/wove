(module int256_bit_shift_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Span (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (spans (shared-array Span))) (returns i32)
		(body (return (i32.from-u256 (u256.shl 1u256 1u32)))))
)
