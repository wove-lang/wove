(module int256_bit_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./bit_sites.wove" (only shift_left shift_right rotate_left rotate_right))
	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let argc (i32:dec (array:len spans)))
			(let choice (i32:rem argc 4i32))
			(let count (if (i32:lt argc 4i32) (then -1i32) (else 256i32)))
			(if (i32:eqz choice)
				(then (let word (call shift_left -1i256 count))))
			(if (i32:eq choice 1i32)
				(then (let word (call shift_right 1u256 count))))
			(if (i32:eq choice 2i32)
				(then (let word (call rotate_left -1i256 count))))
			(if (i32:eq choice 3i32)
				(then (let word (call rotate_right 1u256 count))))
			(return 43i32)))
)
