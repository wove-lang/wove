(module int256_bit_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./bit_sites.wove" (only shift_left shift_right rotate_left rotate_right))
	(struct Span (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (spans (shared-array Span))) (returns i32)
		(body
			(let argc (array.len (local spans)))
			(let choice (i32.rem (local argc) 4i32))
			(let count (if (i32.lt (local argc) 4i32) (then -1i32) (else 256i32)))
			(if (i32.eqz (local choice))
				(then (let word (call shift_left -1i256 (local count)))))
			(if (i32.eq (local choice) 1i32)
				(then (let word (call shift_right 1u256 (local count)))))
			(if (i32.eq (local choice) 2i32)
				(then (let word (call rotate_left -1i256 (local count)))))
			(if (i32.eq (local choice) 3i32)
				(then (let word (call rotate_right 1u256 (local count)))))
			(return 43i32)))
)
