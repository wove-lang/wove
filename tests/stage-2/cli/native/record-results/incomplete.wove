(module incomplete_native_record
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./pair.h" (only get_incomplete))
	(bridge c-header "./pair.h"
		(struct Incomplete (c-type "Incomplete") (fields))
		(fn get_incomplete (params) (returns Incomplete)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
