(module plain_native_pair
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./pair.h" (only (as get_pair pair)))
	(bridge c-header "./pair.h"
		(struct Pair (c-type "Pair") (fields (first i32) (second i32)))
		(fn get_pair (params (first i32) (second i32)) (returns Pair)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call pair -11i32 53i32))
			(if (i32.not-eq (struct.get result first) -11i32) (then (return 1i32)))
			(if (i32.not-eq (struct.get result second) 53i32) (then (return 2i32)))
			(return (i32.add (struct.get result first) (struct.get result second))))))
