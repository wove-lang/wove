(module wrong_native_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./pair.h" (only get_pair))
	(bridge c-header "./pair.h"
		(struct OtherPair (c-type "OtherPair") (fields (first i32) (second i32)))
		(fn get_pair (params (first i32) (second i32)) (returns OtherPair)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call get_pair 40i32 2i32))
			(return (struct.get result first)))))
