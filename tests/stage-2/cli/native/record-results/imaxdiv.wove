(module project_native_imaxdiv
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdint.h>" (only (type IntMax)))
	(bridge c-header "<stdint.h>"
		(type IntMax (c-type "intmax_t")))

	(use c-header "<inttypes.h>" (only imaxdiv))
	(bridge c-header "<inttypes.h>"
		(use c-header "<stdint.h>" (only (type IntMax)))
		(struct Division (c-type "imaxdiv_t") (fields (quot IntMax) (rem IntMax)))
		(fn imaxdiv (params (numerator IntMax) (denominator IntMax)) (returns Division)))

	(fn check_result (params (numerator i64) (denominator i64) (quotient i64) (remainder i64)) (returns bool)
		(body
			(let result (call imaxdiv (int:convert IntMax numerator) (int:convert IntMax denominator)))
			(return (bool:and (i64:eq (int:convert i64 (struct:get result quot)) quotient)
				(i64:eq (int:convert i64 (struct:get result rem)) remainder)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call check_result 43i64 7i64 6i64 1i64)) (then (return 1i32)))
			(if (bool:not (call check_result -43i64 7i64 -6i64 -1i64)) (then (return 2i32)))
			(if (bool:not (call check_result 43i64 -7i64 -6i64 1i64)) (then (return 3i32)))
			(if (bool:not (call check_result -43i64 -7i64 6i64 -1i64)) (then (return 4i32)))
			(if (bool:not (call check_result 9223372036854775807i64 1i64 9223372036854775807i64 0i64))
				(then (return 5i32)))
			(if (bool:not (call check_result -9223372036854775808i64 1i64 -9223372036854775808i64 0i64))
				(then (return 6i32)))
			(return 42i32))))
