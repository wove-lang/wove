(module wrong_native_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./pair.h" (only get_pair))
	(bridge c-header "./pair.h"
		(struct Pair (c-type "Pair") (fields (first i32) (second u32)))
		(fn get_pair (params (first i32) (second i32)) (returns Pair)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call get_pair 40i32 2i32))
			(return (i32:from-u32 (struct:get result second))))))
