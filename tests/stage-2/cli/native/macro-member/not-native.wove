(module native_macro_member
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (type (as FixtureRow Row)) (as FIXTURE_OFFSET field_offset) fixture_check))
	(bridge c-header "./native.h"
		(use c-header "<stddef.h>" (only (type Size)))
		(struct FixtureRow (c-type "struct fixture_row") (fields (first u8) (value u64)))
		(fn FIXTURE_OFFSET (:pragma (c_macro))
			(params (type c-type-token) (member c-member-token))
			(returns Size))
		(fn fixture_check (params (first Size) (value Size)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (call field_offset (c-type i32) (c-member first)))
			(let second (call field_offset (c-type Row) (c-member value)))
			(return (call fixture_check first second)))))
