(module native_macro_bitfield
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (type FixtureBits) (as FIXTURE_OFFSET field_offset) fixture_check))
	(bridge c-header "./native.h"
		(use c-header "<stddef.h>" (only (type Size)))
		(struct FixtureBits (c-type "FixtureBits") (fields (flags u32)))
		(fn FIXTURE_OFFSET (:pragma (c_macro))
			(params (type c-type-token) (member c-member-token))
			(returns Size))
		(fn fixture_check (params (first Size) (value Size)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let offset (call field_offset (c-type FixtureBits) (c-member flags)))
			(return (call fixture_check offset offset)))))
