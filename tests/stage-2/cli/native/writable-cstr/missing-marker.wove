(module native_string_without_write_contract
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (value fixture_full)))
	(bridge c-header "./fixture.h"
		(let-mut fixture_full (:pragma (c_snapshot cstr)) (optional (owned-array u8))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(set fixture_full "replacement")
			(return 42i32))))
