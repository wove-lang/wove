(module ephemeral_native_string
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (value (as fixture_full program_name))))
	(bridge c-header "./fixture.h"
		(let-mut fixture_full (:pragma (c_static_mut_cstr) (c_snapshot cstr)) (optional (owned-array u8))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array:alloc u8 2i32))
			(set program_name (borrow-mut bytes))
			(return 42i32))))
