(module rle_buffer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./codec.wove" (only (value (as PAYLOAD_SIZE PAYLOAD))))
	(struct Packet (fields (data (array u8 PAYLOAD))))
	(let PAYLOAD_SIZE 2i32)
	(let zero (u8 '\0'))
	(let flags (array:new (array u8 PAYLOAD_SIZE) 1u8 2u8))
	(let empty (array:new (array u8 zero)))

	(fn last
		(params (packet Packet)) (returns u8)
		(body (return (array:get (struct:get packet data) 33023i32))))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let PAYLOAD 1i32)
			(let packet (struct:new Packet (data (array:repeat (array u8 PAYLOAD) 39u8))))
			(if (bool:not (i32:eq (array:len (struct:get packet data)) 33024i32)) (then (return 1i32)))
			(return (i32:add PAYLOAD (i32:add
				(int:convert i32 (call last packet))
				(i32:add (array:len flags) (array:len empty)))))))
)
