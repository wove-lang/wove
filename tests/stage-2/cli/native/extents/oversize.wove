(module invalid_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(let Width 0x80000000u64)
	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body (let data (array.repeat (array u8 Width) 0u8)) (return 0i32)))
)
