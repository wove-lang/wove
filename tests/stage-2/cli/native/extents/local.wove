(module local_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Record (fields (words (array i32 WIDTH))))
	(let WIDTH (:doc "The record contains two words.") (u64 0X2))

	(fn make
		(params) (returns (array i32 WIDTH))
		(body (return (array.new (array i32 WIDTH) 40i32 2i32))))

	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let result (struct.new Record (words (call make))))
			(return (i32.add.wrapping (array.load (struct.get (local result) words) 0i32)
				(array.load (struct.get (local result) words) 1i32)))))
)
