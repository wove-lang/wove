(module local_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Record (fields (words (array i32 WIDTH))))
	(let WIDTH (:doc "The record contains two words.") (u64 0X2))

	(fn make
		(params) (returns (array i32 WIDTH))
		(body (return (array.new (array i32 WIDTH) 40i32 2i32))))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (struct.new Record (words (call make))))
			(return (i32.add (array.load (struct.get result words) 0i32)
				(array.load (struct.get result words) 1i32)))))
)
