(module bundled_gettimeofday_timezone
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<sys/time.h>" (only (type Timeval) (type Timezone)
		gettimeofday gettimeofday_timezone))
	(use c-header "./timezone-oracle.h" (only timezone_matches timezone_null_sample))
	(bridge c-header "./timezone-oracle.h"
		(use c-header "<sys/time.h>" (only (type Timeval) (type Timezone)))
		(fn timezone_matches
			(params (sample (shared-ref Timeval)) (zone (shared-ref Timezone))
				(west i32) (dst i32) (status i32))
			(returns bool))
		(fn timezone_null_sample (params (sample (shared-ref Timeval))) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut sample (struct:new Timeval))
			(let-mut zone (struct:new Timezone (tz_minuteswest 717i32) (tz_dsttime 19i32)))
			(let status (call gettimeofday_timezone (borrow-mut sample) (borrow-mut zone)))
			(if (bool:not (call timezone_matches (borrow-shared sample) (borrow-shared zone)
				(struct:get zone tz_minuteswest) (struct:get zone tz_dsttime) status))
				(then (return 1i32)))
			(set sample (struct:new Timeval))
			(if (i32:not-eqz (call gettimeofday (borrow-mut sample))) (then (return 2i32)))
			(if (bool:not (call timezone_null_sample (borrow-shared sample))) (then (return 3i32)))
			(return 42i32))))
