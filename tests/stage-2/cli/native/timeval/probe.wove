(module timeval_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (type Timeval) (type TimevalSeconds) (type TimevalMicros)
			(type IntervalTimer) (type IntervalTimerWhich) gettimeofday getitimer setitimer
			(value ITIMER_REAL) (value ITIMER_VIRTUAL) (value ITIMER_PROF)))
	(use c-header "./oracle.h"
		(only fixture_seed_timeval fixture_wall_status fixture_wall_time fixture_timer_selectors
			fixture_timer_status fixture_timer_fields fixture_timer_disarmed fixture_timer_armed))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER"
			(only (type Timeval) (type TimevalSeconds) (type TimevalMicros)
				(type IntervalTimer) (type IntervalTimerWhich)))
		(fn fixture_seed_timeval (params (sample (mut-ref Timeval))) (returns void))
		(fn fixture_wall_status (params) (returns i32))
		(fn fixture_wall_time
			(params (sample (shared-ref Timeval)) (seconds TimevalSeconds) (micros TimevalMicros))
			(returns bool))
		(fn fixture_timer_selectors
			(params (real IntervalTimerWhich) (virtual_time IntervalTimerWhich) (profiling IntervalTimerWhich))
			(returns bool))
		(fn fixture_timer_status (params (which IntervalTimerWhich)) (returns i32))
		(fn fixture_timer_fields
			(params (sample (shared-ref IntervalTimer)) (interval_sec TimevalSeconds)
				(interval_usec TimevalMicros) (value_sec TimevalSeconds) (value_usec TimevalMicros))
			(returns bool))
		(fn fixture_timer_disarmed (params (sample (shared-ref IntervalTimer))) (returns bool))
		(fn fixture_timer_armed (params (sample (shared-ref IntervalTimer))) (returns bool)))

	(fn wall_clock (params) (returns i32)
		(body
			(let-mut sample (struct.new Timeval))
			(call fixture_seed_timeval (borrow-mut sample))
			(if (bool.not (int.eq TimevalSeconds (struct.get sample tv_sec) (int.convert TimevalSeconds 4294967307u64)))
				(then (return 1i32)))
			(if (bool.not (int.eq TimevalMicros (struct.get sample tv_usec) (int.convert TimevalMicros 531234i32)))
				(then (return 2i32)))
			(set sample (struct.new Timeval
				(tv_sec (int.convert TimevalSeconds -1i32)) (tv_usec (int.convert TimevalMicros -1i32))))
			(let status (call gettimeofday (borrow-mut sample)))
			(if (bool.or (i32.not-eqz status) (i32.not-eq status (call fixture_wall_status)))
				(then (return 3i32)))
			(if (bool.not (call fixture_wall_time (borrow-shared sample)
				(struct.get sample tv_sec) (struct.get sample tv_usec))) (then (return 4i32)))
			(return 0i32)))

	(fn timer_fields (params (sample IntervalTimer)) (returns bool)
		(body
			(let interval (struct.get sample it_interval))
			(let value (struct.get sample it_value))
			(return (call fixture_timer_fields (borrow-shared sample)
				(struct.get interval tv_sec) (struct.get interval tv_usec)
				(struct.get value tv_sec) (struct.get value tv_usec)))))

	(fn read_timer (params (which IntervalTimerWhich)) (returns bool)
		(body
			(let-mut value (struct.new IntervalTimer))
			(let result (call getitimer which (borrow-mut value)))
			(return (bool.and (i32.eqz result)
				(bool.and (i32.eq result (call fixture_timer_status which))
					(call timer_fields value))))))

	(fn replace_timer (params) (returns i32)
		(body
			(let-mut original (struct.new IntervalTimer))
			(if (i32.not-eqz (call getitimer ITIMER_REAL (borrow-mut original))) (then (return 9i32)))
			(if (bool.not (call fixture_timer_disarmed (borrow-shared original))) (then (return 10i32)))
			(let replacement (struct.new IntervalTimer
				(it_interval (struct.new Timeval (tv_sec (int.convert TimevalSeconds 37i32))
					(tv_usec (int.convert TimevalMicros 530000i32))))
				(it_value (struct.new Timeval (tv_sec (int.convert TimevalSeconds 120i32))))))
			(let-mut previous replacement)
			(let armed (call setitimer ITIMER_REAL (borrow-shared replacement) (borrow-mut previous)))
			(if (i32.not-eqz armed) (then (return 11i32)))
			(let-mut live (struct.new IntervalTimer))
			(let read_status (call getitimer ITIMER_REAL (borrow-mut live)))
			(let-mut discarded (struct.new IntervalTimer))
			(let reset_status (call setitimer ITIMER_REAL (borrow-shared original) (borrow-mut discarded)))
			(if (i32.not-eqz reset_status) (then (return 12i32)))
			(if (bool.not (call fixture_timer_disarmed (borrow-shared previous))) (then (return 13i32)))
			(if (bool.or (i32.not-eqz read_status)
				(bool.not (call fixture_timer_armed (borrow-shared live)))) (then (return 14i32)))
			(if (bool.not (call timer_fields live)) (then (return 15i32)))
			(let-mut restored (struct.new IntervalTimer))
			(if (i32.not-eqz (call getitimer ITIMER_REAL (borrow-mut restored))) (then (return 16i32)))
			(if (bool.not (call fixture_timer_disarmed (borrow-shared restored))) (then (return 17i32)))
			(return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let wall_status (call wall_clock))
			(if (i32.not-eqz wall_status) (then (return wall_status)))
			(if (bool.not (call fixture_timer_selectors ITIMER_REAL ITIMER_VIRTUAL ITIMER_PROF)) (then (return 5i32)))
			(if (bool.not (call read_timer ITIMER_REAL)) (then (return 6i32)))
			(if (bool.not (call read_timer ITIMER_VIRTUAL)) (then (return 7i32)))
			(if (bool.not (call read_timer ITIMER_PROF)) (then (return 8i32)))
			(let timer_status (call replace_timer))
			(if (i32.not-eqz timer_status) (then (return timer_status)))
			(return 42i32))))
