	(struct Domain (generic (const Id i32)) (fields (salt u32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let invalid (struct.new (specialize Domain 0b1000_0000_0000_0000_0000_0000_0000_0000i32) (salt 7u32)))
			(return 0i32))))
