(module literal_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(let utf8_ranges (array.new (array u8 12) 0x80u8 0xbfu8 0xc2u8 0xdfu8 0xe0u8 0xefu8
		0xa0u8 0xedu8 0x9fu8 0xf0u8 0xf4u8 0x8fu8))
	(let csv (array.new (array u8 4) (u8 ',') (u8 '"') (u8 '\n') (u8 '\r')))
	(let largest_word 0xffffffffffffffffu64)
	(let smallest_signed -0x80000000i32)
	(let newline '\n')

	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let expected (array.new (array u8 12) 128u8 191u8 194u8 223u8 224u8 239u8
				160u8 237u8 159u8 240u8 244u8 143u8))
			(let-mut index 0i32)
			(while (i32.lt (local index) 12i32)
				(body
					(if (bool.not (u8.eq (array.load (local utf8_ranges) (local index)) (array.load (local expected) (local index))))
						(then (return 1i32)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(if (bool.not (bool.and (u8.eq (array.load (local csv) 0i32) 44u8) (u8.eq (array.load (local csv) 1i32) 34u8)))
				(then (return 2i32)))
			(if (bool.not (bool.and (u8.eq (array.load (local csv) 2i32) 10u8) (u8.eq (array.load (local csv) 3i32) 13u8)))
				(then (return 3i32)))
			(if (bool.not (u32.eq (u32.and 0x7fc00000u32 0x7f800000u32) 0x7f800000u32)) (then (return 4i32)))
			(if (u32.eq (u32.and 0x3f800000u32 0x7f800000u32) 0x7f800000u32) (then (return 5i32)))
			(if (bool.not (bool.and (u64.eq (local largest_word) 18446744073709551615u64) (u32.eq 0xFFFFFFFFu32 4294967295u32)))
				(then (return 6i32)))
			(if (bool.not (bool.and (i32.eq (local smallest_signed) -2147483648i32) (i32.eq 0X7FFFFFFFi32 2147483647i32)))
				(then (return 7i32)))
			(if (bool.not (bool.and (int.eq i8 -0x80i8 -128i8) (int.eq i8 0x000000007Fi8 127i8))) (then (return 8i32)))
			(if (bool.not (bool.and (u8.eq (u8 0X00fF) 255u8) (u8.eq 0x00u8 0u8))) (then (return 9i32)))
			(let controls (array.new (array i32 13) '\0' '\a' '\b' '\t' '\n' '\v' '\f' '\r' '\'' '\\' '(' ')' ';'))
			(let expected_controls (array.new (array i32 13) 0i32 7i32 8i32 9i32 10i32 11i32 12i32 13i32 39i32 92i32 40i32 41i32 59i32))
			(set (local index) 0i32)
			(while (i32.lt (local index) 13i32)
				(body
					(if (bool.not (i32.eq (array.load (local controls) (local index)) (array.load (local expected_controls) (local index))))
						(then (return 10i32)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(if (bool.not (bool.and (i32.eq (local newline) 10i32) (u8.eq (int.convert u8 '\xFF') (u8 '\xff'))))
				(then (return 11i32)))
			(if (bool.not (i32.eq '\x00' 0i32)) (then (return 12i32)))
			(return 42i32)))
)
