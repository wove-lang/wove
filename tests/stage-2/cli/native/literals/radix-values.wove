(module radix_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let WIDTH 0b0_0010i32)
	(let byte (u8 0b1100_0011))
	(let large 0xabcd_1234_5678_ef00u64)
	(let minimum (i64 -0B1000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000_0000))
	(let maximum 0b1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111_1111u64)

	(struct Pair (generic (const N i32)) (fields (items (array u8 N))))

	(fn read_pair (params (pair (specialize Pair (i32 0B1_0)))) (returns u8)
		(body (return (array:load (struct:get pair items) 0b1i32))))

	(fn take (params (bytes (shared-array u8 WIDTH))) (returns i32)
		(body (return (i32:from-u8 (array:load bytes 0b1i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (u8:eq byte 0xC_3u8)) (then (return 1i32)))
			(if (bool:not (u8:eq 1_9_5u8 byte)) (then (return 2i32)))
			(if (bool:not (u64:eq large 0xabcd12345678ef00u64)) (then (return 3i32)))
			(if (bool:not (i64:eq minimum -9_223_372_036_854_775_808i64)) (then (return 4i32)))
			(if (bool:not (u64:eq maximum 18_446_744_073_709_551_615u64)) (then (return 5i32)))
			(if (bool:not (u32:eq -0_0u32 0b0_0u32)) (then (return 6i32)))
			(if (bool:not (i32:eq (int:convert i32 -0b1000_0000i8) -128i32)) (then (return 7i32)))
			(let pair (struct:new (specialize Pair 0x0_2i32)
				(items (array:new (array u8 WIDTH) 0b0u8 4_2u8))))
			(if (bool:not (u8:eq (call read_pair pair) 42u8)) (then (return 8i32)))
			(let-mut buffer (array:alloc u8 0b11i32))
			(array:store buffer 0b1i32
				(match byte (case 0B1100_0011 4_2u8) (case 0xc_4u8 9u8) (case _ 0u8)))
			(return (call take (borrow-shared (array:range buffer 0b0i32 (i32 0b1_0))))))))
