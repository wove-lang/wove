(module bundled_fmtmsg_removal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<fmtmsg.h>"
		(only addseverity_remove (value MM_ERROR) (value MM_OK) (value MM_NOTOK)))
	(use (:pragma (cfg (os "linux"))) c-header "./oracle.h" (only fixture_register_severity))
	(bridge c-header "./oracle.h"
		(fn fixture_register_severity (params (severity i32)) (returns i32)))

	(fn main (:pragma (cfg (os "linux"))) (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let custom 127i32)
			(if (i32:not-eq (call fixture_register_severity custom) MM_OK) (then (return 1i32)))
			(if (i32:not-eq (call addseverity_remove custom) MM_OK) (then (return 2i32)))
			(if (i32:not-eq (call addseverity_remove custom) MM_NOTOK) (then (return 3i32)))
			(if (i32:not-eq (call addseverity_remove MM_ERROR) MM_NOTOK) (then (return 4i32)))
			(return 42i32)))
	(fn main (:pragma (cfg (not (os "linux")))) (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
