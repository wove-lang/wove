(module bundled_fmtmsg
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fmtmsg.h>" (only (type Long) fmtmsg fmtmsg_text
		(value MM_HARD) (value MM_SOFT) (value MM_FIRM) (value MM_APPL) (value MM_UTIL) (value MM_OPSYS)
		(value MM_RECOVER) (value MM_NRECOV) (value MM_PRINT) (value MM_CONSOLE)
		(value MM_NOSEV) (value MM_HALT) (value MM_ERROR) (value MM_WARNING) (value MM_INFO)
		(value MM_NULLSEV) (value MM_NULLMC) (value MM_OK) (value MM_NOMSG) (value MM_NOCON) (value MM_NOTOK)))
	(use c-header "<stdlib.h>" (only setenv))
	(use c-header "<unistd.h>" (only close))
	(use c-header "./oracle.h" (only fixture_fmtmsg_values))
	(bridge c-header "./oracle.h"
		(fn fixture_fmtmsg_values
			(:pragma (c_array values 20))
			(params (values (shared-array i32))) (returns i32)))

	(let verbosity_name "MSGVERB")
	(let verbosity "label:severity:text:action:tag")
	(let label "WOVE:fixture")
	(let message "test message")
	(let action "check result")
	(let tag "wove:01")
	(let text_only "text only")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_constants (params) (returns i32)
		(body
			(let values (array.new (array i32 20)
				MM_HARD MM_SOFT MM_FIRM MM_APPL MM_UTIL MM_OPSYS
				MM_RECOVER MM_NRECOV MM_PRINT MM_CONSOLE
				MM_NOSEV MM_HALT MM_ERROR MM_WARNING MM_INFO
				MM_NULLSEV MM_OK MM_NOMSG MM_NOCON MM_NOTOK))
			(return (call fixture_fmtmsg_values (borrow-shared values)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let constants (call check_constants))
			(if (i32.not-eqz constants) (then (return constants)))
			(if (i32.not-eqz (call setenv (borrow-shared verbosity_name) (borrow-shared verbosity) 1i32))
				(then (return 21i32)))
			(let classification (int.convert Long (i32.or MM_PRINT
				(i32.or MM_SOFT (i32.or MM_APPL MM_RECOVER)))))
			(let full (call fmtmsg classification (borrow-shared label) MM_WARNING
				(borrow-shared message) (borrow-shared action) (borrow-shared tag)))
			(if (i32.not-eq full MM_OK) (then (return 22i32)))
			(if (i32.not-eq (call fmtmsg_text classification (borrow-shared text_only)) MM_OK)
				(then (return 23i32)))
			(if (i32.not-eq (call fmtmsg classification null MM_NULLSEV
				(borrow-shared text_only) null null) MM_OK)
				(then (return 24i32)))
			(if (i32.not-eq (call fmtmsg MM_NULLMC null MM_NULLSEV null null null) MM_OK)
				(then (return 25i32)))
			(if (i32.not-eqz (call close 2i32)) (then (return 26i32)))
			(if (i32.not-eq (call fmtmsg_text classification (borrow-shared message)) MM_NOMSG)
				(then (return 27i32)))
			(return 42i32))))
