(module bundled_fmtmsg_registration
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<fmtmsg.h>"
		(only (type Long) addseverity addseverity_remove fmtmsg
			(value MM_PRINT) (value MM_INFO) (value MM_OK) (value MM_NOTOK)))
	(use c-header "<stdlib.h>" (only setenv unsetenv))

	(let verbosity (:pragma (cfg (os "linux"))) "MSGVERB")
	(let fields (:pragma (cfg (os "linux"))) "severity:text")
	(let levels (:pragma (cfg (os "linux"))) "SEV_LEVEL")
	(let text (:pragma (cfg (os "linux"))) "later")

	(fn register_initial (:pragma (cfg (os "linux"))) (params (severity i32)) (returns i32)
		(body (return (call addseverity severity "FIRST"))))

	(fn display (:pragma (cfg (os "linux"))) (params (severity i32)) (returns i32)
		(body (return (call fmtmsg (int:convert Long MM_PRINT)
			null severity (borrow-shared text) null null))))

	(fn main (:pragma (cfg (os "linux"))) (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let severity 91i32)
			(if (i32:not-eq (call setenv (borrow-shared verbosity) (borrow-shared fields) 1i32) 0i32)
				(then (return 1i32)))
			(if (i32:not-eq (call unsetenv (borrow-shared levels)) 0i32) (then (return 2i32)))
			(if (i32:not-eq (call register_initial severity) MM_OK) (then (return 3i32)))
			(if (i32:not-eq (call display severity) MM_OK) (then (return 4i32)))
			(if (i32:not-eq (call addseverity MM_INFO "FAILED") MM_NOTOK)
				(then (return 5i32)))
			(if (i32:not-eq (call display severity) MM_OK) (then (return 6i32)))
			(if (i32:not-eq (call addseverity severity "SECOND") MM_OK) (then (return 7i32)))
			(if (i32:not-eq (call display severity) MM_OK) (then (return 8i32)))
			(if (i32:not-eq (call addseverity_remove severity) MM_OK) (then (return 9i32)))
			(if (i32:not-eq (call display severity) MM_NOTOK) (then (return 10i32)))
			(if (i32:not-eq (call addseverity_remove severity) MM_NOTOK) (then (return 11i32)))
			(return 42i32)))
	(fn main (:pragma (cfg (not (os "linux")))) (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
