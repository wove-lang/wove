(module project_utsname
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(struct UtsName
			(:pragma (cfg (os "macos")))
			(c-type "struct utsname")
			(fields (sysname (array char 256)) (nodename (array char 256))
				(release (array char 256)) (version (array char 256)) (machine (array char 256))))
		(struct UtsName
			(:pragma (cfg (os "linux")))
			(c-type "struct utsname")
			(fields (sysname (array char 65)) (nodename (array char 65))
				(release (array char 65)) (version (array char 65)) (machine (array char 65))
				(domainname (:pragma (c_optional)) (array char 65))))
		(fn uname (params (name (mut-ref UtsName))) (returns i32))
		(const SYS_NMLN (:pragma (c_optional)) i32)))
