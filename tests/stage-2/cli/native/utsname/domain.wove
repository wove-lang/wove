(module utsname_domain
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type UtsName)))
	(use c-header "./oracle.h" (only fixture_seed_domain fixture_domain_byte))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type UtsName)))
		(fn fixture_seed_domain (params (value (mut-ref UtsName))) (returns void))
		(fn fixture_domain_byte (params (index i32) (value u8)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (struct:new UtsName))
			(call fixture_seed_domain (borrow-mut value))
			(let len (array:len value/domainname))
			(if (i32:not-eq len 65i32) (then (return 1i32)))
			(let-mut index 0i32)
			(while (i32:lt index len)
				(body
					(if (bool:not (call fixture_domain_byte index (array:get value/domainname index)))
						(then (return 2i32)))
					(set index (i32:inc index))))
			(return 42i32))))
