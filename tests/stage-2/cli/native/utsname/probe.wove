(module utsname_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type UtsName) uname))
	(use c-header "./oracle.h" (only fixture_capture_utsname fixture_utsname_widths fixture_utsname_bytes))
	(bridge c-header "./oracle.h"
		(fn fixture_capture_utsname (params) (returns i32))
		(fn fixture_utsname_widths
			(params (sysname i32) (nodename i32) (release i32) (version i32) (machine i32)) (returns bool))
		(fn fixture_utsname_bytes
			(params (index i32) (sysname u8) (nodename u8) (release u8) (version u8) (machine u8))
			(returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut name (struct.new UtsName))
			(let expected (call fixture_capture_utsname))
			(let actual (call uname (borrow-mut name)))
			(if (i32.not-eq actual expected) (then (return 1i32)))
			(if (i32.not-eqz actual) (then (return 2i32)))
			(let width (array.len (struct.get name sysname)))
			(let nodename_width (array.len (struct.get name nodename)))
			(let release_width (array.len (struct.get name release)))
			(let version_width (array.len (struct.get name version)))
			(let machine_width (array.len (struct.get name machine)))
			(if (bool.not (call fixture_utsname_widths width nodename_width release_width version_width machine_width))
				(then (return 3i32)))
			(let-mut index 0i32)
			(while (i32.lt index width)
				(body
					(let mismatch (call fixture_utsname_bytes index
						(array.load (struct.get name sysname) index)
						(array.load (struct.get name nodename) index)
						(array.load (struct.get name release) index)
						(array.load (struct.get name version) index)
						(array.load (struct.get name machine) index)))
					(if (i32.not-eqz mismatch) (then (return mismatch)))
					(set index (i32.inc index))))
			(return 42i32))))
