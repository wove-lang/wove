(module utsname_sys_nmln
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (value SYS_NMLN)))
	(use c-header "./oracle.h" (only fixture_sys_nmln))
	(bridge c-header "./oracle.h"
		(fn fixture_sys_nmln (params) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq SYS_NMLN (call fixture_sys_nmln)) (then (return 1i32)))
			(return 42i32))))
