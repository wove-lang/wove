(module partial
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./oracle.h" (only (type Glob) fixture_empty fixture_partial fixture_drops))
	(bridge c-header "./oracle.h"
		(type (:pragma (c_owned (drop fixture_drop) storage (cstr-vector gl_pathv gl_pathc gl_offs))) Glob (c-type "glob_t"))
		(fn fixture_empty (:pragma (c_init_always output)) (params (output (mut-ref Glob))) (returns i32))
		(fn fixture_partial (:pragma (c_init_always output)) (params (output (mut-ref Glob))) (returns i32))
		(fn fixture_drops (params) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool true)
				(then
					(let-mut empty (native.alloc Glob 2i64))
					(if (i32.not-eq (call fixture_empty (borrow-mut empty)) 17i32) (then (return 1i32)))
					(let paths (native.cstrs.view (borrow-shared empty)))
					(if (i32.not-eqz (native.cstrs.len paths)) (then (return 2i32)))))
			(if (i32.not-eq (call fixture_drops) 1i32) (then (return 3i32)))
			(if (bool true)
				(then
					(let-mut partial (native.alloc Glob))
					(if (i32.not-eq (call fixture_partial (borrow-mut partial)) 41i32) (then (return 4i32)))
					(let paths (native.cstrs.view (borrow-shared partial)))
					(if (i32.not-eq (native.cstrs.len paths) 2i32) (then (return 5i32)))
					(let first (native.cstrs.load paths 0i32))
					(let second (native.cstrs.load paths 1i32))
					(let a (array.load first 5i32))
					(let b (array.load second 5i32))
					(if (bool.not (bool.or (bool.and (u8.eq a 97u8) (u8.eq b 98u8))
						(bool.and (u8.eq a 98u8) (u8.eq b 97u8)))) (then (return 6i32)))))
			(if (i32.not-eq (call fixture_drops) 2i32) (then (return 7i32)))
			(return 42i32))))
