(module borrowed_append
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./oracle.h" (only (type Glob) fixture_start fixture_append))
	(bridge c-header "./oracle.h"
		(type Glob (:pragma (c_owned (drop globfree) storage (cstr-vector gl_pathv gl_pathc gl_offs))) (c-type "glob_t"))
		(fn fixture_start (:pragma (c_init_always output)) (params (output (mut-ref Glob))) (returns i32))
		(fn fixture_append (params (output (mut-ref Glob))) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut result (native.alloc Glob 2i64))
			(if (i32.not-eqz (call fixture_start (borrow-mut result))) (then (return 1i32)))
			(let paths (native.cstrs.view (borrow-shared result)))
			(let first (native.cstrs.load paths 0i32))
			(return (call fixture_append (borrow-mut result))))))
