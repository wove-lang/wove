(module optional_glob_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./oracle.h" (only (type OptionalGlob)))
	(bridge c-header "./oracle.h"
		(type OptionalGlob (:pragma (c_optional) (c_owned (drop globfree) storage (cstr-vector gl_pathv gl_pathc gl_offs))) (c-type "FixtureOptionalGlob")))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (native.alloc OptionalGlob))
			(return 42i32))))
