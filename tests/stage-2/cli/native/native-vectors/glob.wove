(module native_glob_vectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./oracle.h" (only (type Glob) fixture_start fixture_append fixture_original))
	(bridge c-header "./oracle.h"
		(type Glob (:pragma (c_owned (drop globfree) storage (cstr-vector gl_pathv gl_pathc gl_offs))) (c-type "glob_t"))
		(fn fixture_start (:pragma (c_init_always out)) (params (out (mut-ref Glob))) (returns i32))
		(fn fixture_append (params (out (mut-ref Glob))) (returns i32))
		(fn fixture_original (:pragma (c_bytes data length))
			(params (out (shared-ref Glob)) (data (shared-array u8)) (length i32)) (returns bool)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut result (native:alloc Glob 2i64))
			(if (i32:not-eqz (call fixture_start (borrow-mut result))) (then (return 1i32)))
			(if (bool true)
				(then
					(let paths (native:cstrs-view (borrow-shared result)))
					(if (i32:not-eq (native:cstrs-len paths) 2i32) (then (return 2i32)))
					(let first (native:cstrs-load paths 0i32))
					(if (u8:not-eq (array:get first 5i32) 97u8) (then (return 3i32)))
					(if (bool:not (call fixture_original (borrow-shared result) (borrow-shared first) (array:len first)))
						(then (return 4i32)))))
			(if (i32:not-eqz (call fixture_append (borrow-mut result))) (then (return 5i32)))
			(let updated (native:cstrs-view (borrow-shared result)))
			(if (i32:not-eq (updated.cstrs-len) 3i32) (then (return 6i32)))
			(let last (updated.cstrs-load 2i32))
			(if (u8:not-eq (array:get last 5i32) 99u8) (then (return 7i32)))
			(return 42i32))))
