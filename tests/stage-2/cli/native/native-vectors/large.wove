(module glibc_large_file_string_vector
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "./oracle.h" (only (type Glob64) fixture_start64))
	(bridge c-header "./oracle.h" (:pragma (cfg (os "linux")))
		(type (:pragma (c_optional) (c_owned (drop globfree64) storage (cstr-vector gl_pathv gl_pathc gl_offs)))
			Glob64 (c-type "glob64_t"))
		(fn fixture_start64 (:pragma (c_init_always output))
			(params (output (mut-ref Glob64))) (returns i32)))

	(fn probe (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let-mut result (native.alloc Glob64 2i64))
			(if (i32.not-eqz (call fixture_start64 (borrow-mut result))) (then (return 1i32)))
			(let paths (native.cstrs.view (borrow-shared result)))
			(if (i32.not-eq (native.cstrs.len paths) 2i32) (then (return 2i32)))
			(let row (native.cstrs.load paths 1i32))
			(if (i32.not-eq (array.len row) 10i32) (then (return 3i32)))
			(if (u8.not-eq (array.load row 5i32) 98u8) (then (return 4i32)))
			(return 42i32)))

	(fn probe (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call probe)))))
