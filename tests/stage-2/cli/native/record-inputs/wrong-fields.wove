(module mismatched_native_record_input_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type ByteRequest) fill_request))
	(bridge c-header "./fixture.h"
		(struct ByteRequest (c-type "struct wove_byte_request") (fields (marker i32)))
		(fn fill_request (:pragma (c_bytes data count) (c_record_in record data bytes size))
			(params (record (mut-ref ByteRequest)) (data (shared-array u8)) (count u32)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut request (struct:new ByteRequest (marker 11i32)))
			(let data (array:alloc u8 3i32))
			(return (call fill_request (borrow-mut request) (borrow-shared data) 3u32)))))
