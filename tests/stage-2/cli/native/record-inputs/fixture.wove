(module bounded_native_record_inputs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type Size) (type ByteRequest) (type Range)
		(type RangeRequest) remember_bytes_request remember_range_request remember_bytes remember_ranges
		fill_request bytes_restored check_ranges ranges_restored))

	(bridge c-header "./fixture.h"
		(type Size (c-type "size_t"))
		(struct ByteRequest (c-type "struct wove_byte_request")
			(fields (marker i32) (size Size)))
		(struct Range (c-type "struct wove_range")
			(fields (offset i32) (length u64)))
		(struct RangeRequest (c-type "struct wove_range_request")
			(fields (marker i32) (count u32)))
		(fn remember_bytes_request (params (record (mut-ref ByteRequest))) (returns void))
		(fn remember_range_request (params (record (mut-ref RangeRequest))) (returns void))
		(fn remember_bytes (:pragma (c_array data size))
			(params (data (shared-array u8)) (size Size)) (returns void))
		(fn remember_ranges (:pragma (c_array data count))
			(params (data (shared-array Range)) (count u32)) (returns void))
		(fn fill_request (:pragma (c_bytes data count) (c_record_in record data bytes size))
			(params (record (mut-ref ByteRequest)) (data (mut-array u8)) (count Size))
			(returns i32))
		(fn bytes_restored (params (record (shared-ref ByteRequest))) (returns i32))
		(fn check_ranges (:pragma (c_array data extent) (c_record_in record data ranges count))
			(params (record (mut-ref RangeRequest)) (data (shared-array Range)) (extent u32))
			(returns i32))
		(fn ranges_restored (params (record (shared-ref RangeRequest))) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut request (struct:new ByteRequest (marker 11i32) (size (int:convert Size 95i32))))
			(let-mut bytes (array:alloc u8 5i32))
			(array:set bytes 0i32 97u8)
			(array:set bytes 3i32 98u8)
			(call remember_bytes_request (borrow-mut request))
			(call remember_bytes (borrow-shared (array:range bytes 1i32 3i32)) (int:convert Size 2i32))
			(let-mut byte_count 2i32)
			(if (i32:eq (array:len args) 2i32) (then (set byte_count 3i32)))
			(let status (call fill_request (borrow-mut request)
				(borrow-mut (array:range bytes 1i32 3i32)) (int:convert Size byte_count)))
			(if (i32:not-eq status -7i32) (then (return 1i32)))
			(if (i32:not-eq (call bytes_restored (borrow-shared request)) 1i32)
				(then (return 2i32)))
			(if (bool:or (u8:not-eq (array:get bytes 0i32) 97u8)
				(bool:or (u8:not-eq (array:get bytes 1i32) 13u8)
					(bool:or (u8:not-eq (array:get bytes 2i32) 29u8)
						(u8:not-eq (array:get bytes 3i32) 98u8))))
				(then (return 3i32)))

			(let-mut ranges (array:alloc Range 3i32))
			(array:set ranges 1i32 (struct:new Range (offset 14i32) (length 4294967297u64)))
			(array:set ranges 2i32 (struct:new Range (offset 23i32) (length 59u64)))
			(let-mut query (struct:new RangeRequest (marker 61i32) (count 51u32)))
			(call remember_range_request (borrow-mut query))
			(call remember_ranges (borrow-shared (array:range ranges 1i32 3i32)) 2u32)
			(let-mut count 2u32)
			(if (i32:eq (array:len args) 3i32) (then (set count 3u32)))
			(let found (call check_ranges (borrow-mut query)
				(borrow-shared (array:range ranges 1i32 3i32)) count))
			(if (i32:not-eq found 42i32) (then (return 4i32)))
			(if (i32:not-eq (call ranges_restored (borrow-shared query)) 1i32) (then (return 5i32)))
			(if (i32:not-eq (call check_ranges (borrow-mut query)
				(borrow-shared (array:range ranges 1i32 1i32)) 0u32) 24i32)
				(then (return 6i32)))
			(return found))))
