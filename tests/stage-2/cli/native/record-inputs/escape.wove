(module escaping_record_input
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type Size) (type ByteRequest) fill_request))
	(bridge c-header "./fixture.h"
		(type Size (c-type "size_t"))
		(type Escaped (:pragma (c_owned (drop free))) (c-type "void *"))
		(struct ByteRequest (c-type "struct wove_byte_request") (fields (marker i32)))
		(fn fill_request (:pragma (c_bytes data count) (c_record_in record data bytes size))
			(params (record (mut-ref ByteRequest)) (data (mut-array u8)) (count Size)) (returns Escaped)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut request (struct:new ByteRequest (marker 11i32)))
			(let-mut bytes (array:alloc u8 3i32))
			(let result (call fill_request (borrow-mut request) (borrow-mut bytes) (int:convert Size 3i32)))
			(return 42i32))))
