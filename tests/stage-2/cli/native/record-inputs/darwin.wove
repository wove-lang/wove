(module darwin_bounded_record_input
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type Check) (type Off) (type Size) check_library))
	(use (:pragma (cfg (os "macos"))) c-header "<stdio.h>" (only tmpfile fileno fputs fflush))

	(bridge c-header "<fcntl.h>" (:pragma (cfg (os "macos")) (bridge_replace))
		(type Off (c-type "off_t"))
		(type Size (c-type "size_t"))
		(struct Check (c-type "fchecklv_t") (fields (lv_file_start Off) (lv_error_message_size Size)))
		(const F_CHECK_LV i32)
		(fn check_library
			(:pragma (c_variadic request) (c_bytes message count)
				(c_record_in request message lv_error_message lv_error_message_size))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_CHECK_LV) (request (mut-ref Check))
				(message (mut-array u8)) (count Size))
			(returns i32)))

	(bridge c-header "<stdio.h>" (:pragma (cfg (os "macos")) (bridge_replace))
		(type File (:pragma (c_owned (drop fclose))) (c-type "FILE *"))
		(fn tmpfile (params) (returns File))
		(fn fileno (params (stream (shared-ref File))) (returns i32))
		(fn fputs (:pragma (c_cstr text))
			(params (text (shared-array u8)) (stream (shared-ref File))) (returns i32))
		(fn fflush (params (stream (shared-ref File))) (returns i32)))

	(let fixture "unsigned fixture\n")

	(fn run (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let stream (call tmpfile))
			(if (owner:is-null stream) (then (return 1i32)))
			(if (i32:ltz (call fputs (borrow-shared fixture) (borrow-shared stream))) (then (return 2i32)))
			(if (i32:not-eqz (call fflush (borrow-shared stream))) (then (return 3i32)))
			(let fd (call fileno (borrow-shared stream)))
			(if (i32:ltz fd) (then (return 4i32)))
			(let-mut request (struct:new Check
				(lv_file_start (int:convert Off 0i32)) (lv_error_message_size (int:convert Size 7i32))))
			(let-mut message (array:alloc u8 514i32))
			(array:set message 0i32 165u8)
			(array:set message 513i32 166u8)
			(let status (call check_library fd (borrow-mut request)
				(borrow-mut (array:range message 1i32 513i32)) (int:convert Size 512i32)))
			(if (bool:and (i32:not-eqz status) (i32:not-eq status -1i32)) (then (return 5i32)))
			(if (bool:or (u8:not-eq (array:get message 0i32) 165u8)
				(u8:not-eq (array:get message 513i32) 166u8)) (then (return 6i32)))
			(if (i32:not-eq (int:convert i32 (struct:get request lv_error_message_size)) 7i32)
				(then (return 7i32)))
			(return 42i32)))

	(fn run (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:565"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call run)))))
