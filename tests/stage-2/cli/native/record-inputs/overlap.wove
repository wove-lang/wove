(module overlapping_record_inputs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type Size) (type ByteRequest) alias_request))
	(bridge c-header "./fixture.h"
		(type Size (c-type "size_t"))
		(struct ByteRequest (c-type "struct wove_byte_request") (fields (marker i32)))
		(fn alias_request
			(:pragma (c_bytes data count) (c_bytes other size) (c_record_in record data bytes size))
			(params (record (mut-ref ByteRequest)) (data (mut-array u8)) (count Size)
				(other (mut-array u8)) (size Size)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut request (struct:new ByteRequest (marker 11i32)))
			(let-mut bytes (array:alloc u8 3i32))
			(let count (int:convert Size 3i32))
			(return (call alias_request (borrow-mut request) (borrow-mut bytes) count (borrow-mut bytes) count)))))
