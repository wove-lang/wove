(module bundled_gnu_program_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<errno.h>" (only
		(value program_invocation_name) (value (as program_invocation_name full_alias))
		(value program_invocation_short_name) (value (as program_invocation_short_name short_alias))))
	(use c-header "./fixture.h" (only
		save_names mutate_names repeated_names alternate_names clear_short restore_names))

	(bridge c-header "./fixture.h"
		(fn save_names (params) (returns void))
		(fn mutate_names (params) (returns i32))
		(fn repeated_names (params) (returns i32))
		(fn alternate_names (params) (returns i32))
		(fn clear_short (params) (returns void))
		(fn restore_names (params) (returns i32)))

	(fn install (params) (returns void)
		(body
			(set program_invocation_name "front/tool")
			(set short_alias "tool")))

	(fn exercise (params) (returns i32)
		(body
			(let original program_invocation_name)
			(if (owner.is-null original) (then (return 1i32)))
			(call install)
			(let before full_alias)
			(let saved (move (optional.unwrap before)))
			(if (i32.not-eqz (call mutate_names)) (then (return 2i32)))
			(let long full_alias)
			(let short program_invocation_short_name)
			(let long_bytes (move (optional.unwrap long)))
			(let short_bytes (move (optional.unwrap short)))
			(if (bool.or (u8.not-eq (array.load long_bytes 0i32) 70u8)
				(bool.or (u8.not-eq (array.load short_bytes 0i32) 84u8)
					(u8.not-eq (array.load saved 0i32) 102u8)))
				(then (return 3i32)))
			(if (i32.not-eq (call restore_names) 1i32) (then (return 4i32)))
			(call install)
			(if (i32.not-eq (call repeated_names) 1i32) (then (return 5i32)))
			(set full_alias "other/path")
			(set program_invocation_short_name "path")
			(if (i32.not-eq (call alternate_names) 1i32) (then (return 6i32)))
			(call clear_short)
			(let absent short_alias)
			(if (bool.not (owner.is-null absent)) (then (return 7i32)))
			(return 42i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:532"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(call save_names)
			(let result (call exercise))
			(if (i32.not-eq (call restore_names) 1i32) (then (return 8i32)))
			(return result))))
