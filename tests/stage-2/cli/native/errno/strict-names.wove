(module strict_gnu_program_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<errno.h>" (only (value program_invocation_name) (value program_invocation_short_name)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(set program_invocation_name "front/tool")
			(set program_invocation_short_name "tool")
			(return 42i32))))
