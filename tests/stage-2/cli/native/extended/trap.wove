(module extended_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan))) (returns i32)
		(body
			(let count (array.len (local args)))
			(if (i32.eq (local count) 0i32)
				(then
					(let limit (f80.from-f64 (f64.from-bits 0x7fefffffffffffffu64)))
					(let narrowed (f64.from-f80 (f80.add (local limit) 1e290f80)))
					(return (i32.from-f64 (local narrowed)))))
			(if (i32.eq (local count) 1i32)
				(then
					(let limit (f80.from-f32 (f32.from-bits 0x7f7fffffu32)))
					(let narrowed (f32.from-f80 (f80.add (local limit) 1e21f80)))
					(return (i32.from-f32 (local narrowed)))))
			(if (i32.eq (local count) 2i32)
				(then
					(let result (i64.from-f80 -9223372036854775809f80))
					(return (i32.from-i64 (local result)))))
			(if (i32.eq (local count) 3i32)
				(then
					(let result (u64.from-f80 18446744073709551616f80))
					(return (i32.from-u64 (local result)))))
			(return (i32.from-f80 (f80.from-f64 (f64.from-bits 0x7ff8000000000000u64)))))))
