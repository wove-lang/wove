(module extended_half_conversion
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eq (i32.dec (array.len (local args))) 1i32)
				(then
					(let narrowed (f16.from-f80 (f80.add 65504f80 1e-14f80)))
					(return (i32.from-f16 (local narrowed)))))
			(if (f80.not-eq (f80.from-f16 1.5f16) 1.5f80) (then (return 1i32)))
			(if (u16.not-eq (f16.to-bits (f16.from-f80 1.000488281250000000108420217248550443400745280086994171142578125f80)) 0x3c01u16)
				(then (return 2i32)))
			(return 0i32))))
