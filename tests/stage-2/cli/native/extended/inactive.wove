(module extended_inactive
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "The word f80 is also allowed in documentation.")

	(disabled (struct Extended (fields (value f80))))
	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan))) (returns i32)
		(body
			(let f80 0i32)
			(return (local f80)))))
