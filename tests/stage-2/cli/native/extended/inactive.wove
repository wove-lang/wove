	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "The word f80 is also allowed in documentation.")

	(disabled (struct Extended (fields (value f80))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let f80 0i32)
			(return f80))))
