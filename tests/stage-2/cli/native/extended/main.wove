	(use c-header "./extended.h" (only (type ExtendedPacket) extended_twice extended_store extended_negative_zero))

	(bridge c-header "./extended.h"
		(struct ExtendedPacket (c-type "ExtendedPacket") (fields (marker u8) (value f80)))
		(fn extended_twice (:pragma (c_optional)) (params (value f80)) (returns f80))
		(fn extended_store (params (out (mut-ref ExtendedPacket)) (value f80)) (returns i32))
		(fn extended_negative_zero (params (value f80)) (returns i32)))

	(struct Extended (fields (value f80)))
	(let next 1.000000000000000000108420217248550443400745280086994171142578125f80)

	(fn preserve (params (value f80)) (returns f80)
		(body (return (local value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (struct.new Extended (value (call preserve (local next)))))
			(if (bool.not (f80.gt (struct.get (local first) value) 1f80)) (then (return 1i32)))
			(if (i32.not-eq (call extended_negative_zero (f80 -0)) 1i32) (then (return 2i32)))
			(if (f80.not-eq (f80.div (f80.mul (f80.sub 7f80 1f80) 2f80) 4f80) (f80.add 1f80 2f80))
				(then (return 3i32)))
			(if (bool.not (f80.lt (f80.neg 1f80) 0f80)) (then (return 4i32)))
			(if (i64.not-eq (i64.from-f80 (f80.from-i64 9223372036854775807i64)) 9223372036854775807i64)
				(then (return 5i32)))
			(if (i64.not-eq (i64.from-f80 -9223372036854775808f80) -9223372036854775808i64)
				(then (return 6i32)))
			(if (u64.not-eq (u64.from-f80 (f80.from-u64 18446744073709551615u64)) 18446744073709551615u64)
				(then (return 7i32)))
			(if (u8.not-eq (u8.from-f80 -0.875f80) 0u8) (then (return 8i32)))
			(if (u32.not-eq (f32.to-bits (f32.from-f80 1.000000059604644775499045217248550443400745280086994171142578125f80)) 0x3f800001u32)
				(then (return 9i32)))
			(if (u64.not-eq (f64.to-bits (f64.from-f80 1.000000000000000111130722679764204485763912089169025421142578125f80)) 0x3ff0000000000001u64)
				(then (return 10i32)))
			(if (f80.not-eq (f80.from-f32 -2.5f32) (f80 -2.5)) (then (return 11i32)))
			(let infinity (f80.from-f64 (f64.from-bits 0x7ff0000000000000u64)))
			(if (u64.not-eq (f64.to-bits (f64.from-f80 (local infinity))) 0x7ff0000000000000u64)
				(then (return 12i32)))
			(let nan (f32.from-f80 (f80.from-f64 (f64.from-bits 0x7ff8000000000000u64))))
			(if (bool.not (f32.not-eq (local nan) (local nan))) (then (return 13i32)))
			(let-mut packet (struct.new ExtendedPacket))
			(if (i32.not-eq (call extended_store (borrow-mut (local packet)) (call extended_twice 21f80)) 0i32)
				(then (return 14i32)))
			(if (u8.not-eq (struct.get (local packet) marker) 7u8) (then (return 15i32)))
			(return (i32.from-f80 (struct.get (local packet) value))))))
