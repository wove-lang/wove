(module native_string_macros
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value (as FIXTURE_PATH path)) (value FIXTURE_EMPTY)
		(value FIXTURE_UNUSED) (value FIXTURE_NUMBER)))
	(use wove-file "./second.wove" (only tail))
	(bridge c-header "./native.h"
		(const FIXTURE_PATH (:pragma (c_optional)) (shared-array u8))
		(const FIXTURE_EMPTY (shared-array u8))
		(const FIXTURE_UNUSED (shared-array u8))
		(const FIXTURE_NUMBER (:pragma (c_optional)) i32))

	(fn check_bytes (params (bytes (shared-array u8))) (returns bool)
		(body
			(return (bool.and (i32.eq (array.len bytes) 3i32)
				(bool.and (u8.eq (array.load bytes 0i32) 65u8)
					(bool.and (u8.eq (array.load bytes 1i32) 255u8)
						(u8.eq (array.load bytes 2i32) 90u8)))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_bytes (borrow-shared path))) (then (return 1i32)))
			(if (i32.not-eqz (array.len FIXTURE_EMPTY)) (then (return 2i32)))
			(let-mut count 0i32)
			(for (let byte) (borrow-shared path)
				(body (set count (i32.inc count))))
			(if (u8.not-eq (call tail) 90u8) (then (return 3i32)))
			(return (i32.add FIXTURE_NUMBER count)))))
