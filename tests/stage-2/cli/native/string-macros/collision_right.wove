(module string_right
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./collision_right.h"
		(const FIXTURE_SEQUENCE (shared-array u8)))
	(use c-header "./collision_right.h" (only (value (as FIXTURE_SEQUENCE answer))))

	(fn right_value (params) (returns u8)
		(body (return (array:load answer 0i32)))))
