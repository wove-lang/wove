(module darwin_group_path
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (value (as _PATH_GROUP group_path))))
	(bridge c-header "<grp.h>"
		(const _PATH_GROUP (:pragma (c_optional)) (shared-array u8)))

	(let expected "/etc/group")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (array:len group_path) (array:len expected))
				(then (return 1i32)))
			(for (let index byte) (borrow-shared group_path)
				(body
					(if (u8:not-eq byte (array:load expected index))
						(then (return 2i32)))))
			(return 42i32))))
