(module native_string_mutation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value FIXTURE_EMPTY)))
	(bridge c-header "./native.h"
		(const FIXTURE_EMPTY (shared-array u8)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(array.store FIXTURE_EMPTY 0i32 42u8)
			(return 1i32))))
