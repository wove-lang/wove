(module string_left
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./collision_left.h"
		(const FIXTURE_SEQUENCE (shared-array u8)))
	(use c-header "./collision_left.h"
		(only (value (as FIXTURE_SEQUENCE first)) (value (as FIXTURE_SEQUENCE second))))

	(fn left_value (params) (returns u8)
		(body
			(let byte (array:load first 0i32))
			(if (u8:not-eq byte (array:load second 0i32)) (then (return 0u8)))
			(return byte))))
