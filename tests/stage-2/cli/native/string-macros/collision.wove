(module string_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./string_left_00aa3d.wove" (only left_value))
	(use wove-file "./string_right_0037fe.wove" (only right_value))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let left (call left_value))
			(let right (call right_value))
			(if (bool.or (u8.eq left right) (i32.not-eq (i32.add (i32.from-u8 left) (i32.from-u8 right)) 97i32))
				(then (return 1i32)))
			(return 42i32))))
