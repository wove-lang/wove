(module named
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (type NativeNull)))
	(bridge c-header "./native.h"
		(type NativeNull (:pragma (c_nullptr_t)) (c-type "FixtureNull")))

	(fn forward (params (value NativeNull)) (returns NativeNull)
		(body (return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
