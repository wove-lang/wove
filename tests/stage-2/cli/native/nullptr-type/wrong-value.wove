(module wrong_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_roundtrip))
	(bridge c-header "./native.h"
		(type NativeNull (:pragma (c_nullptr_t)) (c-type "FixtureNull"))
		(fn fixture_roundtrip (params (value NativeNull)) (returns NativeNull)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let native (call fixture_roundtrip 0i32))
			(return 42i32))))
