(module signatures
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (type (as NativeNull NullValue)) (type FixtureBox)
		fixture_null fixture_roundtrip fixture_read fixture_write))
	(bridge c-header "./native.h"
		(type NativeNull (:pragma (c_nullptr_t) (c_optional)) (c-type "FixtureNull"))
		(struct FixtureBox (c-type "FixtureBox") (fields (item NativeNull)))
		(fn fixture_null (params) (returns NativeNull))
		(fn fixture_roundtrip (params (value NativeNull)) (returns NativeNull))
		(fn fixture_read (:pragma (c_nullable storage)) (params (storage (shared-ref NativeNull))) (returns i32))
		(fn fixture_write (params (storage (mut-ref NativeNull))) (returns i32)))

	(fn forward (params (value NullValue)) (returns NullValue)
		(body (return (call fixture_roundtrip value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let box (struct:new FixtureBox (item (call forward (call fixture_null)))))
			(let-mut value (box.get item))
			(if (i32:not-eq (call fixture_write (borrow-mut value)) 1i32) (then (return 1i32)))
			(if (i32:not-eq (call fixture_read (borrow-shared value)) 1i32) (then (return 2i32)))
			(if (i32:not-eq (call fixture_read null) 1i32) (then (return 3i32)))
			(return 42i32))))
