(module wrong_argument
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_null fixture_wrong_argument))
	(bridge c-header "./native.h"
		(type NativeNull (:pragma (c_nullptr_t)) (c-type "FixtureNull"))
		(fn fixture_null (params) (returns NativeNull))
		(fn fixture_wrong_argument (params (value NativeNull)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_wrong_argument (call fixture_null))))))
