(module record_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./storage.h" (only (type (as Storage Output)) storage_address storage_write))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (struct:new Output (first 17u64) (last 0u64)))
			(let address (call storage_address (borrow-shared value)))
			(let status (call storage_write 7i32 (borrow-mut value) address))
			(if (bool:or (i32:not-eq status 7i32) (u64:not-eq value/first 4294967313u64))
				(then (return 1i32)))
			(let failed (call storage_write -19i32 (borrow-mut value) address))
			(if (bool:or (i32:not-eq failed -19i32) (u64:not-eq value/first 8589934609u64))
				(then (return 2i32)))
			(if (u64:not-eq value/last 18364758544493064720u64)
				(then (return 3i32)))
			(return 42i32))))
