(module void_pointer_record_qualifiers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type Sample) wrong_shared_record wrong_mutable_record))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut sample (struct:new Sample))
			(if (call wrong_shared_record (borrow-shared sample)) (then (return 1i32)))
			(if (call wrong_mutable_record (borrow-mut sample)) (then (return 2i32)))
			(return 42i32))))
