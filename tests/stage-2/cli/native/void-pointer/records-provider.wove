(module void_pointer_record_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./records.h"
		(struct Sample (c-type "struct record_sample") (fields (tag i32) (value u64)))
		(struct Other (c-type "struct other_sample") (fields (tag i32) (value u64)))

		(fn same_record
			(:pragma (c_void_ptr raw))
			(params (raw (shared-ref Sample)) (typed (shared-ref Sample)))
			(returns bool))
		(fn copy_record
			(:pragma (c_void_ptr input output))
			(params (input (shared-ref Sample)) (output (mut-ref Sample)))
			(returns void))
		(fn wrong_shared_record
			(:pragma (c_void_ptr raw))
			(params (raw (shared-ref Sample)))
			(returns bool))
		(fn wrong_mutable_record
			(:pragma (c_void_ptr raw))
			(params (raw (mut-ref Sample)))
			(returns bool))))
