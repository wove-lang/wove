(module wrong_scalar_pointee
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (type Word) (type OtherWord) copy_word))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let input (int:convert OtherWord 42i32))
			(let-mut output (int:convert Word 0i32))
			(return (call copy_word 1i32 (borrow-shared input) 2i32 (borrow-mut output))))))
