(module typed_scalar_void_pointer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (type Word) mark copy_word))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let input (int.convert Word 42i32))
			(let-mut output (int.convert Word 0i32))
			(let status (call copy_word (call mark 1i32) (borrow-shared (local input))
				(call mark 2i32) (borrow-mut (local output))))
			(if (i32.not-eqz (local status)) (then (return 1i32)))
			(return (int.convert i32 (local output))))))
