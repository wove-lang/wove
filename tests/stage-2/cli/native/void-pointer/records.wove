(module void_pointer_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type (as Sample Cell)) same_record copy_record))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let input (struct:new Cell (tag 17i32) (value 4294967307u64)))
			(let-mut output (struct:new Cell (tag -1i32) (value 0u64)))
			(if (bool:not (call same_record (borrow-shared input) (borrow-shared input)))
				(then (return 1i32)))
			(call copy_record (borrow-shared input) (borrow-mut output))
			(if (u64:not-eq (struct:get output value) 4294967308u64) (then (return 2i32)))
			(return (struct:get output tag)))))
