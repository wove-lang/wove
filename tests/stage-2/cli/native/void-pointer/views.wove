(module exact_void_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./views.h"
		(fn remember_views
			(:pragma (c_bytes input count) (c_bytes output count))
			(params (input (shared-array u8)) (output (mut-array u8)) (count i32))
			(returns void))
		(fn view_step (params (expected i32) (value i32)) (returns i32))
		(fn set_view
			(:pragma (c_void_ptr input))
			(params (const selector i32 42) (input (shared-array u8 16)) (token i32))
			(returns i32))
		(fn get_view
			(:pragma (c_void_ptr output))
			(params (output (mut-array u8 16)) (token i32))
			(returns i32))
		(fn loan_pair
			(:pragma (c_void_ptr input output))
			(params (input (shared-array u8 16)) (output (mut-array u8 16)))
			(returns void))))
