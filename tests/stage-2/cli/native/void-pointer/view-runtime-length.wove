(module wrong_void_view_length
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only view_step set_view get_view))

	(fn too_short (params (size i32)) (returns i32)
		(body
			(let input (array.alloc u8 size))
			(return (call set_view (borrow-shared input) (call view_step -1i32 17i32)))))

	(fn too_long (params (size i32)) (returns i32)
		(body
			(let-mut output (array.alloc u8 size))
			(return (call get_view (borrow-mut output) (call view_step -1i32 19i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.gtz (i32.dec (array.len args))) (then (return (call too_long 17i32))))
			(return (call too_short 15i32)))))
