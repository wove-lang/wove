(module storage_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./storage.h"
		(type StorageAddress (c-type "uint64_t"))
		(struct Storage (c-type "struct native_storage") (fields (first u64) (last u64)))
		(fn storage_address (params (record (shared-ref Storage))) (returns StorageAddress))
		(fn storage_write
			(:pragma (c_record_storage record (c-type "uint64_t")))
			(params (status i32) (record (mut-ref Storage)) (address StorageAddress))
			(returns i32))))
