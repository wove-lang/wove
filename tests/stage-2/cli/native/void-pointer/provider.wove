(module scalar_void_pointer_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./fixture.h"
		(type Word (c-type "fixture_word"))
		(type OtherWord (c-type "fixture_other_word"))

		(fn mark (params (value i32)) (returns i32))
		(fn copy_word
			(:pragma (c_void_ptr input output))
			(params (first i32) (const operation (c-type "fixture_operation") FIXTURE_COPY)
				(input (shared-ref Word)) (second i32) (output (mut-ref Word)))
			(returns i32))))
