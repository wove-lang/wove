(module wrong_native_qualifier
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./fixture.h"
		(fn wrong_qualifier
			(:pragma (c_void_ptr input output))
			(c-name "copy_word")
			(params (first i32) (const operation (c-type "fixture_operation") FIXTURE_COPY)
				(input (mut-ref i32)) (second i32) (output (mut-ref i32)))
			(returns i32)))
	(use c-header "./fixture.h" (only wrong_qualifier))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut input 42i32)
			(let-mut output 0i32)
			(return (call wrong_qualifier 1i32 (borrow-mut (local input)) 2i32 (borrow-mut (local output)))))))
