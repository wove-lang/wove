(module wrong_void_view_qualifier
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./views.h"
		(fn wrong_shared
			(:pragma (c_void_ptr bytes))
			(params (bytes (shared-array u8 16)))
			(returns void))
		(fn wrong_mutable
			(:pragma (c_void_ptr bytes))
			(params (bytes (mut-array u8 16)))
			(returns void)))
	(use c-header "./views.h" (only wrong_shared wrong_mutable))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (entry_bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut bytes (array.repeat (array u8 16) 0u8))
			(call wrong_shared (borrow-shared (local bytes)))
			(call wrong_mutable (borrow-mut (local bytes)))
			(return 0i32))))
