(module short_fixed_void_view
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only set_view))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let bytes (array:repeat (array u8 15) 0u8))
			(return (call set_view (borrow-shared bytes) 17i32)))))
