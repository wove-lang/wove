(module short_fixed_void_view
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only set_view))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (entry_bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let bytes (array.repeat (array u8 15) 0u8))
			(return (call set_view (borrow-shared (local bytes)) 17i32)))))
