(module darwin_byte_void_pointer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fcntl.h>" (:pragma (cfg (os "macos")))
		(type (:pragma (c_owned (drop filesec_free))) Security (c-type "filesec_t"))
		(fn filesec_init (params) (returns Security))
		(fn filesec_free (params (security Security)) (returns void))
		(fn write_uuid
			(:pragma (c_void_ptr input))
			(c-name "filesec_set_property")
			(params (security (mut-ref Security)) (const property (c-type "filesec_property_t") FILESEC_UUID)
				(input (shared-array u8 16)))
			(returns i32))
		(fn read_uuid
			(:pragma (c_void_ptr output))
			(c-name "filesec_get_property")
			(params (security (shared-ref Security)) (const property (c-type "filesec_property_t") FILESEC_UUID)
				(output (mut-array u8 16)))
			(returns i32)))
	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>" (only filesec_init write_uuid read_uuid))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ENOENT)))

	(fn check_uuid (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let-mut output (array.repeat (array u8 16) 165u8))
			(if (i32.not-eq (call read_uuid (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 2i32)))
			(if (i32.not-eq errno ENOENT) (then (return 3i32)))
			(let-mut input (array.repeat (array u8 16) 0u8))
			(let-mut index 0i32)
			(while (i32.lt index 16i32)
				(body
					(if (u8.not-eq (array.load output index) 165u8) (then (return 4i32)))
					(array.store input index (int.convert u8 (i32.add 137i32 index)))
					(set index (i32.inc index))))
			(if (i32.not-eqz (call write_uuid (borrow-mut security) (borrow-shared input)))
				(then (return 5i32)))
			(set input (array.repeat (array u8 16) 0u8))
			(if (i32.not-eqz (call read_uuid (borrow-shared security) (borrow-mut output)))
				(then (return 6i32)))
			(set index 0i32)
			(while (i32.lt index 16i32)
				(body
					(if (u8.not-eq (array.load output index) (int.convert u8 (i32.add 137i32 index)))
						(then (return 7i32)))
					(set index (i32.inc index))))
			(return 42i32)))

	(fn check_uuid (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_uuid)))))
