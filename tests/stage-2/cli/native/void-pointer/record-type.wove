(module void_pointer_record_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type Sample) (type Other) copy_record))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let input (struct.new Other))
			(let-mut output (struct.new Sample))
			(call copy_record (borrow-shared input) (borrow-mut output))
			(return 42i32))))
