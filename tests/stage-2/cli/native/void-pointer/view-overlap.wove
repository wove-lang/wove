(module competing_exact_void_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only loan_pair))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (entry_bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut bytes (array.repeat (array u8 16) 0u8))
			(call loan_pair (borrow-shared (local bytes)) (borrow-mut (local bytes)))
			(return 0i32))))
