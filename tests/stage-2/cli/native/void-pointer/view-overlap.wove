(module competing_exact_void_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only loan_pair))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array.repeat (array u8 16) 0u8))
			(call loan_pair (borrow-shared (local bytes)) (borrow-mut (local bytes)))
			(return 0i32))))
