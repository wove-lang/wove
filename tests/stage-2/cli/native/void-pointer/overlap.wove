(module overlapping_scalar_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (type Word) copy_word))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut slot (int.convert Word 42i32))
			(return (call copy_word 1i32 (borrow-shared (local slot)) 2i32 (borrow-mut (local slot)))))))
