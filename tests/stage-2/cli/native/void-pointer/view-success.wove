(module check_exact_void_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only remember_views view_step set_view get_view))

	(fn buffers_match (params (output (shared-array u8)) (start i32) (expected u8)) (returns bool)
		(body
			(let-mut index (local start))
			(let end (i32.add (local start) 16i32))
			(while (i32.lt (local index) (local end))
				(body
					(if (u8.not-eq (array.load (local output) (local index)) (local expected))
						(then (return (bool false))))
					(set (local index) (i32.inc (local index)))))
			(return (bool true))))

	(fn fixed_buffers (params) (returns bool)
		(body
			(let input (array.repeat (array u8 16) 5u8))
			(let-mut output (array.repeat (array u8 16) 0u8))
			(call remember_views (borrow-shared (local input)) (borrow-mut (local output)) 16i32)
			(let stored (call set_view (borrow-shared (local input)) (call view_step 0i32 17i32)))
			(let loaded (call get_view (borrow-mut (local output)) (call view_step 1i32 19i32)))
			(return (bool.and (bool.and (i32.eqz (local stored)) (i32.eqz (local loaded)))
				(call buffers_match (borrow-shared (local output)) 0i32 5u8)))))

	(fn runtime_buffers (params (size i32)) (returns bool)
		(body
			(let-mut input (array.alloc u8 (local size)))
			(let-mut output (array.alloc u8 (local size)))
			(let-mut index 0i32)
			(while (i32.lt (local index) (local size))
				(body
					(array.store (local input) (local index) 9u8)
					(set (local index) (i32.inc (local index)))))
			(call remember_views (borrow-shared (local input)) (borrow-mut (local output)) 16i32)
			(let stored (call set_view (borrow-shared (local input)) (call view_step 0i32 17i32)))
			(let loaded (call get_view (borrow-mut (local output)) (call view_step 1i32 19i32)))
			(return (bool.and (bool.and (i32.eqz (local stored)) (i32.eqz (local loaded)))
				(call buffers_match (borrow-shared (local output)) 0i32 9u8)))))

	(fn windows (params) (returns bool)
		(body
			(let-mut input (array.alloc u8 24i32))
			(let-mut output (array.alloc u8 24i32))
			(let-mut index 0i32)
			(while (i32.lt (local index) 24i32)
				(body
					(array.store (local input) (local index) 7u8)
					(array.store (local output) (local index) 91u8)
					(set (local index) (i32.inc (local index)))))
			(call remember_views (borrow-shared (array.range (local input) 2i32 18i32))
				(borrow-mut (array.range (local output) 3i32 19i32)) 16i32)
			(let stored (call set_view
				(borrow-shared (array.range (local input) (call view_step 0i32 2i32) (call view_step 1i32 18i32)))
				(call view_step 2i32 17i32)))
			(let loaded (call get_view
				(borrow-mut (array.range (local output) (call view_step 3i32 3i32) (call view_step 4i32 19i32)))
				(call view_step 5i32 19i32)))
			(if (bool.or (i32.not-eqz (local stored)) (i32.not-eqz (local loaded))) (then (return (bool false))))
			(if (u8.not-eq (array.load (local output) 2i32) 91u8) (then (return (bool false))))
			(if (u8.not-eq (array.load (local output) 19i32) 91u8) (then (return (bool false))))
			(return (call buffers_match (borrow-shared (local output)) 3i32 7u8))))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (bool.not (call fixed_buffers)) (then (return 1i32)))
			(if (bool.not (call runtime_buffers 16i32)) (then (return 2i32)))
			(if (bool.not (call windows)) (then (return 3i32)))
			(return 42i32))))
