(module check_exact_void_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./views.wove" (only))
	(use c-header "./views.h" (only remember_views view_step set_view get_view))

	(fn buffers_match (params (output (shared-array u8)) (start i32) (expected u8)) (returns bool)
		(body
			(let-mut index start)
			(let end (i32:add start 16i32))
			(while (i32:lt index end)
				(body
					(if (u8:not-eq (array:load output index) expected)
						(then (return (bool false))))
					(set index (i32:inc index))))
			(return (bool true))))

	(fn fixed_buffers (params) (returns bool)
		(body
			(let input (array:repeat (array u8 16) 5u8))
			(let-mut output (array:repeat (array u8 16) 0u8))
			(call remember_views (borrow-shared input) (borrow-mut output) 16i32)
			(let stored (call set_view (borrow-shared input) (call view_step 0i32 17i32)))
			(let loaded (call get_view (borrow-mut output) (call view_step 1i32 19i32)))
			(return (bool:and (bool:and (i32:eqz stored) (i32:eqz loaded))
				(call buffers_match (borrow-shared output) 0i32 5u8)))))

	(fn runtime_buffers (params (size i32)) (returns bool)
		(body
			(let-mut input (array:alloc u8 size))
			(let-mut output (array:alloc u8 size))
			(let-mut index 0i32)
			(while (i32:lt index size)
				(body
					(array:store input index 9u8)
					(set index (i32:inc index))))
			(call remember_views (borrow-shared input) (borrow-mut output) 16i32)
			(let stored (call set_view (borrow-shared input) (call view_step 0i32 17i32)))
			(let loaded (call get_view (borrow-mut output) (call view_step 1i32 19i32)))
			(return (bool:and (bool:and (i32:eqz stored) (i32:eqz loaded))
				(call buffers_match (borrow-shared output) 0i32 9u8)))))

	(fn windows (params) (returns bool)
		(body
			(let-mut input (array:alloc u8 24i32))
			(let-mut output (array:alloc u8 24i32))
			(let-mut index 0i32)
			(while (i32:lt index 24i32)
				(body
					(array:store input index 7u8)
					(array:store output index 91u8)
					(set index (i32:inc index))))
			(call remember_views (borrow-shared (array:range input 2i32 18i32))
				(borrow-mut (array:range output 3i32 19i32)) 16i32)
			(let stored (call set_view
				(borrow-shared (array:range input (call view_step 0i32 2i32) (call view_step 1i32 18i32)))
				(call view_step 2i32 17i32)))
			(let loaded (call get_view
				(borrow-mut (array:range output (call view_step 3i32 3i32) (call view_step 4i32 19i32)))
				(call view_step 5i32 19i32)))
			(if (bool:or (i32:not-eqz stored) (i32:not-eqz loaded)) (then (return (bool false))))
			(if (u8:not-eq (array:load output 2i32) 91u8) (then (return (bool false))))
			(if (u8:not-eq (array:load output 19i32) 91u8) (then (return (bool false))))
			(return (call buffers_match (borrow-shared output) 3i32 7u8))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixed_buffers)) (then (return 1i32)))
			(if (bool:not (call runtime_buffers 16i32)) (then (return 2i32)))
			(if (bool:not (call windows)) (then (return 3i32)))
			(return 42i32))))
