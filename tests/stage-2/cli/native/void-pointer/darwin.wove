(module darwin_scalar_void_pointer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fcntl.h>" (:pragma (cfg (os "macos")))
		(type Security (:pragma (c_owned (drop filesec_free))) (c-type "filesec_t"))
		(type FileMode (c-type "mode_t"))
		(fn filesec_init (params) (returns Security))
		(fn filesec_free (params (security Security)) (returns void))
		(fn write_mode
			(:pragma (c_void_ptr input))
			(c-name "filesec_set_property")
			(params (security (mut-ref Security)) (const property (c-type "filesec_property_t") FILESEC_MODE)
				(input (shared-ref FileMode)))
			(returns i32))
		(fn read_mode
			(:pragma (c_void_ptr output))
			(c-name "filesec_get_property")
			(params (security (shared-ref Security)) (const property (c-type "filesec_property_t") FILESEC_MODE)
				(output (mut-ref FileMode)))
			(returns i32)))
	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type FileMode) filesec_init write_mode read_mode))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ENOENT)))

	(fn check_mode (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let initial (int.convert FileMode 0i32))
			(let-mut output initial)
			(if (i32.not-eq (call read_mode (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 2i32)))
			(if (i32.not-eq errno ENOENT) (then (return 3i32)))
			(if (int.not-eq FileMode output initial) (then (return 4i32)))
			(let-mut input (int.convert FileMode 384i32))
			(if (i32.not-eqz (call write_mode (borrow-mut security) (borrow-shared input)))
				(then (return 5i32)))
			(set input initial)
			(if (i32.not-eqz (call read_mode (borrow-shared security) (borrow-mut output)))
				(then (return 6i32)))
			(if (int.not-eq FileMode output (int.convert FileMode 384i32)) (then (return 7i32)))
			(return 42i32)))

	(fn check_mode (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_mode)))))
