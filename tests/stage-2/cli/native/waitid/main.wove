(module bundled_waitid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<sys/wait.h>" (only (type Id) (type IdType) (type SignalInfo) waitid
		(value P_ALL) (value P_PID) (value P_PGID)
		(value WCONTINUED) (value WEXITED) (value WNOHANG) (value WNOWAIT)
		(value WSTOPPED) (value WUNTRACED)))
	(use c-header "<unistd.h>" (only (type Pid) _exit fork getpgrp))
	(use c-header "<errno.h>" (only errno (value ECHILD)))
	(use c-header "./oracle.h" (only fixture_wait_selectors fixture_wait_flags fixture_wait_kind fixture_wait_user))
	(bridge c-header "./oracle.h"
		(use c-header "<sys/wait.h>" (only (type IdType)))
		(fn fixture_wait_selectors (params (all IdType) (pid IdType) (pgid IdType)) (returns i32))
		(fn fixture_wait_flags
			(params (continued i32) (exited i32) (nohang i32) (nowait i32) (stopped i32) (untraced i32))
			(returns i32))
		(fn fixture_wait_kind (params (signal i32) (code i32)) (returns i32))
		(fn fixture_wait_user (params (uid u32)) (returns i32)))

	(fn check_child (params (kind IdType) (id Id) (child Pid) (flags i32)) (returns i32)
		(body
			(let-mut info (struct.new SignalInfo (si_status -1i32)))
			(if (i32.not-eqz (call waitid kind id (borrow-mut info) flags)) (then (return 1i32)))
			(if (i32.not-eq (int.convert i32 (struct.get info si_pid)) (int.convert i32 child))
				(then (return 2i32)))
			(if (i32.not-eq (struct.get info si_status) 37i32) (then (return 3i32)))
			(if (i32.not-eqz (struct.get info si_errno)) (then (return 4i32)))
			(if (i32.eqz (call fixture_wait_kind (struct.get info si_signo) (struct.get info si_code)))
				(then (return 5i32)))
			(if (i32.eqz (call fixture_wait_user (int.convert u32 (struct.get info si_uid))))
				(then (return 6i32)))
			(return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eqz (call fixture_wait_selectors P_ALL P_PID P_PGID)) (then (return 7i32)))
			(if (i32.eqz (call fixture_wait_flags WCONTINUED WEXITED WNOHANG WNOWAIT WSTOPPED WUNTRACED))
				(then (return 8i32)))
			(let child (call fork))
			(if (i32.ltz (int.convert i32 child)) (then (return 9i32)))
			(if (int.eq Pid child (int.convert Pid 0i32)) (then (call _exit 37i32)))
			(let id (int.convert Id child))
			(let group (int.convert Id (call getpgrp)))
			(let observe (i32.or WEXITED WNOWAIT))
			(let by_pid (call check_child P_PID id child observe))
			(if (i32.not-eqz by_pid) (then (return (i32.add 10i32 by_pid))))
			(let by_group (call check_child P_PGID group child observe))
			(if (i32.not-eqz by_group) (then (return (i32.add 20i32 by_group))))
			(let by_any (call check_child P_ALL (int.convert Id 0i32) child WEXITED))
			(if (i32.not-eqz by_any) (then (return (i32.add 30i32 by_any))))
			(let-mut info (struct.new SignalInfo))
			(set errno 0i32)
			(if (i32.not-eq (call waitid P_PID id (borrow-mut info) (i32.or WEXITED WNOHANG)) -1i32)
				(then (return 40i32)))
			(if (i32.not-eq errno ECHILD) (then (return 41i32)))
			(return 42i32))))
