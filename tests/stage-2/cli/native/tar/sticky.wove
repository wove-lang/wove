(module tar_sticky
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (value TSVTX)))
	(use c-header "./oracle.h" (only fixture_tar_sticky))
	(bridge c-header "./oracle.h"
		(fn fixture_tar_sticky (params) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq TSVTX (call fixture_tar_sticky)) (then (return 1i32)))
			(return 42i32))))
