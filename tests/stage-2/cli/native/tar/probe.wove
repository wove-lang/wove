(module tar_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (value AREGTYPE) (value BLKTYPE) (value CHRTYPE) (value CONTTYPE) (value DIRTYPE)
			(value FIFOTYPE) (value LNKTYPE) (value REGTYPE) (value SYMTYPE) (value TGEXEC)
			(value TGREAD) (value TGWRITE) (value TMAGLEN) (value TOEXEC) (value TOREAD)
			(value TOWRITE) (value TSGID) (value TSUID) (value TUEXEC) (value TUREAD)
			(value TUWRITE) (value TVERSLEN) (value TMAGIC) (value TVERSION)))
	(use c-header "./oracle.h" (only fixture_tar_integers fixture_tar_strings))
	(bridge c-header "./oracle.h"
		(fn fixture_tar_integers
			(:pragma (c_array values 22))
			(params (values (shared-array i32))) (returns i32))
		(fn fixture_tar_strings
			(:pragma (c_bytes magic magic_length) (c_bytes version version_length))
			(params (magic (shared-array u8)) (magic_length i32)
				(version (shared-array u8)) (version_length i32)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let values (array.new (array i32 22)
				AREGTYPE BLKTYPE CHRTYPE CONTTYPE DIRTYPE FIFOTYPE LNKTYPE
				REGTYPE SYMTYPE TGEXEC TGREAD TGWRITE TMAGLEN TOEXEC
				TOREAD TOWRITE TSGID TSUID TUEXEC TUREAD TUWRITE TVERSLEN))
			(let mismatch (call fixture_tar_integers (borrow-shared values)))
			(if (i32.not-eqz mismatch) (then (return mismatch)))
			(let text_mismatch (call fixture_tar_strings (borrow-shared TMAGIC) (array.len TMAGIC)
				(borrow-shared TVERSION) (array.len TVERSION)))
			(if (i32.not-eqz text_mismatch) (then (return text_mismatch)))
			(return 42i32))))
