(module extend_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "<stdio.h>" (only seek tmpfile ftell SEEK_SET (type Long)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let stream (call tmpfile))
			(if (owner.is-null (local stream)) (then (return (i32 1))))
			(let position (call ftell (borrow-shared (local stream))))
			(return (i32.add (call seek (borrow-shared (local stream)) (local position) (local SEEK_SET)) (i32 42))))))
