(module extend_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "<stdio.h>" (only seek tmpfile ftell SEEK_SET (type Long)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call tmpfile))
			(if (owner.is-null stream) (then (return (i32 1))))
			(let position (call ftell (borrow-shared stream)))
			(return (i32.add (call seek (borrow-shared stream) position SEEK_SET) (i32 42))))))
