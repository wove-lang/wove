(module replace_member
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdlib.h>" (only abs EXIT_SUCCESS))
	(let digits "42")

	(bridge c-header "<stdlib.h>"
		(fn abs (:pragma (c_cstr digits)) (c-name "atoi")
			(params (digits (shared-array u8))) (returns i32)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (i32.add (call abs (borrow-shared (local digits))) (local EXIT_SUCCESS))))))
