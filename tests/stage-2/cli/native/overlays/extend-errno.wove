(module extend_errno
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<errno.h>" (const WOVE_EIO i32))
	(use c-header "<errno.h>" (only WOVE_EIO EINTR))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.and (i32.lt 0i32 WOVE_EIO) (bool.not (i32.eq WOVE_EIO EINTR)))
				(then (return 42i32)))
			(return 1i32)))
)
