(module replace_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only tmpfile fclose (type File)))

	(bridge c-header "<stdio.h>"
		(type (:pragma (c_owned (drop fclose))) File (c-type "FILE *")))

	(fn close_file (params) (returns i32)
		(body
			(let stream (call tmpfile))
			(if (owner.is-null (local stream)) (then (return (i32 1))))
			(return (call fclose (move (local stream))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (i32.add.wrapping (call close_file) (i32 42))))))
