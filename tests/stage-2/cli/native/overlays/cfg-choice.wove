(module cfg_choice
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdlib.h>" (only chosen EXIT_SUCCESS))
	(bridge c-header "<stdlib.h>"
		(:pragma (cfg (os "macos")))
		(fn chosen (c-name "abs") (params (value i32)) (returns i32)))
	(bridge c-header "<stdlib.h>"
		(:pragma (cfg (os "linux")))
		(decls (:pragma (cfg (arch "x86_64")))
			(fn chosen (c-name "abs") (params (value i32)) (returns i32)))
		(decls (:pragma (cfg (not (arch "x86_64"))))
			(fn chosen (c-name "abs") (params (value i32)) (returns i32))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32:add (call chosen (i32 -42)) EXIT_SUCCESS)))))
