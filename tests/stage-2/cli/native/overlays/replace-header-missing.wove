(module replace_header_missing
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdlib.h>" (only magnitude EXIT_SUCCESS))

	(bridge c-header "<stdlib.h>"
		(:pragma (bridge_replace))
		(fn magnitude (c-name "abs") (params (value i32)) (returns i32)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (call magnitude (i32 -42))))))
