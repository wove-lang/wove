(module header_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<limits.h>" (only INT_MAX))
	(use wove-file "./pkg/header.wove" (only))
	(fn main (params) (returns i32)
		(body
			(if (i32.eq (local INT_MAX) (i32 2147483647)) (then (return (i32 42))))
			(return (i32 1))))
)
