(module entry_embed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./dep.wove" (only shared_value))

	(fn first (params (bytes (shared-slice u8))) (returns i32)
		(body (return (int.convert i32 (slice.load (local bytes) (i32 0))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let payload (embed "./payload.bin"))
			(return (i32.add.wrapping (call shared_value) (call first (borrow-shared (local payload))))))))
