(module entry_embed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./dep.wove" (only shared_value))

	(fn first (params (bytes (shared-array u8))) (returns i32)
		(body (return (int:convert i32 (array:get bytes (i32 0))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let payload (embed "./payload.bin"))
			(return (i32:add (call shared_value) (call first (borrow-shared payload)))))))
