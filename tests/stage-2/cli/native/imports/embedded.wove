(module embedded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn first (params (bytes (shared-array u8))) (returns i32)
		(body (return (int.convert i32 (array.load (local bytes) (i32 0))))))
	(fn value (params) (returns i32)
		(body
			(let bytes (embed "./payload.bin"))
			(return (call first (borrow-shared (local bytes))))))
)
