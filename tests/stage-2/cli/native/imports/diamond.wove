(module native_diamond
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./left/branch.wove" (only left))
	(use wove-file "./right/branch.wove" (only right))
	(fn main (params) (returns i32)
		(body (return (i32.add.wrapping (call left) (call right))))))
