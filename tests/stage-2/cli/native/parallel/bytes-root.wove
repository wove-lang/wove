(module native_parallel_bytes_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./bytes-leaf.wove" (only fill))
	(use c-header "<native-bytes.h>" (only (type (as Size Extent)) fixture_sum))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 5i32))
			(if (i32:not-eq (call fill (borrow-mut data)) 2i32) (then (return 1i32)))
			(if (u8:not-eq (array:get data 4i32) 0u8) (then (return 2i32)))
			(let width (int:convert Extent 2i32))
			(let-mut count (int:convert Extent 2i32))
			(if (i32:gt (array:len argv) 1i32) (then (set count (int:convert Extent 3i32))))
			(let sum (call fixture_sum (borrow-shared data) width count))
			(if (i32:not-eq sum 46i32) (then (return 3i32)))
			(return 42i32))))
