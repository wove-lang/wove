(module native_parallel_mutable_cstr_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-mutable-cstr.h>" (only fixture_edit))
	(bridge c-header "<native-mutable-cstr.h>"
		(fn fixture_edit
			(:pragma (c_cstr path) (c_snapshot cstr))
			(params (path (mut-array u8))) (returns (optional (owned-array u8)))))

	(fn prepare
		(params (path (mut-array u8)) (first u8)) (returns void)
		(body
			(array.store path 0i32 first)
			(array.store path 1i32 97u8)
			(array.store path 2i32 116u8)
			(array.store path 3i32 104u8)))

	(fn verify_failure
		(params) (returns i32)
		(body
			(let-mut path (array.alloc u8 4i32))
			(call prepare (borrow-mut path) 102u8)
			(let result (call fixture_edit (borrow-mut path)))
			(if (bool.not (owner.is-null result)) (then (return 1i32)))
			(if (i32.not-eq (array.len path) 4i32) (then (return 2i32)))
			(if (u8.not-eq (array.load path 0i32) 70u8) (then (return 3i32)))
			(if (u8.not-eq (array.load path 1i32) 97u8) (then (return 4i32)))
			(if (u8.not-eq (array.load path 2i32) 116u8) (then (return 5i32)))
			(if (u8.not-eq (array.load path 3i32) 104u8) (then (return 6i32)))
			(return 42i32))))
