(module native_parallel_storage_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./storage-leaf.wove" (only fail_init read_current init_and_destroy))
	(use c-header "<native-storage.h>" (only (type (as Box Storage)) fixture_init fixture_read fixture_drops))

	(fn scoped_owner
		(params) (returns i32)
		(body
			(let-mut box (native:alloc Storage))
			(if (i32:not-eqz (call fixture_init (borrow-mut box) 73i32)) (then (return 1i32)))
			(if (i32:not-eq (call read_current) 73i32) (then (return 2i32)))
			(return (call fixture_read (borrow-shared box)))))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fail_init) 17i32) (then (return 1i32)))
			(if (i32:not-eqz (call fixture_drops)) (then (return 2i32)))
			(if (i32:not-eq (call scoped_owner) 73i32) (then (return 3i32)))
			(if (i32:not-eq (call fixture_drops) 1i32) (then (return 4i32)))
			(if (i32:not-eqz (call read_current)) (then (return 5i32)))
			(if (i32:not-eq (call init_and_destroy) 23i32) (then (return 6i32)))
			(if (i32:not-eq (call fixture_drops) 2i32) (then (return 7i32)))
			(return 42i32))))
