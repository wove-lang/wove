(module native_parallel_lvalue_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-lvalue.h>" (only
		(value fixture_lvalue) (value (as fixture_lvalue leaf_alias)) fixture_barrier))
	(bridge c-header "<native-lvalue.h>"
		(let-mut fixture_lvalue i32)
		(fn fixture_barrier (params) (returns void)))

	(struct LvalueJob (fields (value i32)))

	(fn run_worker (params (job LvalueJob)) (returns (owned-array u8))
		(body
			(let initial leaf_alias)
			(let value (struct.get job value))
			(set fixture_lvalue value)
			(call fixture_barrier)
			(let first leaf_alias)
			(set leaf_alias (i32.inc value))
			(let second fixture_lvalue)
			(if (bool.and (i32.eqz initial) (bool.and (i32.eq first value) (i32.eq second (i32.inc value))))
				(then (return (array.alloc u8 42i32))))
			(return (array.alloc u8 1i32)))))
