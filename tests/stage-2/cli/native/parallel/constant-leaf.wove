(module native_parallel_constant_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-constant.h>" (only (value FIXTURE_FLAG) (value FIXTURE_OFFSET)))
	(bridge c-header "<native-constant.h>"
		(const FIXTURE_FLAG u8)
		(const FIXTURE_OFFSET i32))

	(fn adjust (params (flag u8)) (returns i32)
		(body
			(if (u8.not-eq flag FIXTURE_FLAG) (then (return 1i32)))
			(return (i32.add (int.convert i32 flag) FIXTURE_OFFSET)))))
