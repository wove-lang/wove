(module native_parallel_vector_pair_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-vector-pair.h>"
		(only (type Pid) (type Actions) (type Attributes) fixture_actions_init fixture_attributes_init spawn))
	(bridge c-header "<native-vector-pair.h>"
		(type Pid (c-type "fixture_pid"))
		(type Actions (:pragma (c_owned (drop fixture_actions_drop) storage)) (c-type "fixture_actions"))
		(type Attributes (:pragma (c_owned (drop fixture_attributes_drop) storage)) (c-type "fixture_attributes"))
		(fn fixture_actions_init
			(:pragma (c_init actions))
			(params (actions (mut-ref Actions))) (returns i32))
		(fn fixture_attributes_init
			(:pragma (c_init attributes))
			(params (attributes (mut-ref Attributes))) (returns i32))
		(fn fixture_actions_drop (params (actions Actions)) (returns i32))
		(fn fixture_attributes_drop (params (attributes Attributes)) (returns i32))
		(fn fixture_spawn_drops (params) (returns i32))
		(fn spawn
			(:pragma (c_cstr file) (c_nullable actions attributes) (c_cstrs arguments environment))
			(c-name "fixture_spawn")
			(params (pid (mut-ref Pid)) (file (shared-array u8)) (actions (shared-ref Actions))
				(attributes (shared-ref Attributes)) (arguments (shared-array (owned-array u8)))
				(environment (shared-array (owned-array u8))))
			(returns i32)))

	(fn copy_row
		(params (bytes (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut row (array:alloc u8 (array:len bytes)))
			(for (let index) (range 0i32 (array:len bytes))
				(body (array:set row index (array:get bytes index))))
			(return (move row))))

	(fn verify_present
		(params (file (shared-array u8)) (arguments (shared-array (owned-array u8)))
			(environment (shared-array (owned-array u8)))) (returns i32)
		(body
			(let-mut actions (native:alloc Actions))
			(let-mut attributes (native:alloc Attributes))
			(if (i32:not-eqz (call fixture_actions_init (borrow-mut actions))) (then (return 1i32)))
			(if (i32:not-eqz (call fixture_attributes_init (borrow-mut attributes))) (then (return 2i32)))
			(let-mut pid (int:convert Pid 0i32))
			(let action_status (call spawn (borrow-mut pid) (borrow-shared file) (borrow-shared actions) null
				(borrow-shared arguments) (borrow-shared environment)))
			(if (bool:or (i32:not-eq action_status 18i32) (i32:not-eq (int:convert i32 pid) 101i32))
				(then (return 3i32)))
			(let attribute_status (call spawn (borrow-mut pid) (borrow-shared file) null (borrow-shared attributes)
				(borrow-shared arguments) (borrow-shared environment)))
			(if (bool:or (i32:not-eq attribute_status 19i32) (i32:not-eq (int:convert i32 pid) 102i32))
				(then (return 4i32)))
			(let both_status (call spawn (borrow-mut pid) (borrow-shared file) (borrow-shared actions)
				(borrow-shared attributes) (borrow-shared arguments) (borrow-shared environment)))
			(if (bool:or (i32:not-eq both_status 20i32) (i32:not-eq (int:convert i32 pid) 103i32))
				(then (return 5i32)))
			(return 0i32))))
