(module native_parallel_vector_pair_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./vector-pair-leaf.wove" (only copy_row verify_present))
	(use c-header "<native-vector-pair.h>" (only (type Pid) (as spawn spawn_fixture) fixture_spawn_drops))

	(let file "fixture tool")
	(let child "fixture-child")
	(let argument "space arg")
	(let empty "")
	(let first_environment "FIRST=env value")
	(let second_environment "SECOND=distinct")

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut arguments (array.alloc (owned-array u8) 3i32))
			(array.store arguments 0i32 (call copy_row (borrow-shared child)))
			(array.store arguments 1i32 (call copy_row (borrow-shared argument)))
			(array.store arguments 2i32 (call copy_row (borrow-shared empty)))
			(let-mut environment (array.alloc (owned-array u8) 2i32))
			(array.store environment 0i32 (call copy_row (borrow-shared first_environment)))
			(array.store environment 1i32 (call copy_row (borrow-shared second_environment)))
			(let-mut pid (int.convert Pid 0i32))
			(let bad (array.repeat (array u8 1) 0u8))
			(if (i32.eq (array.len argv) 2i32)
				(then (return (call spawn_fixture (borrow-mut pid) (borrow-shared bad) null null
					(borrow-shared arguments) (borrow-shared environment)))))
			(if (i32.eq (array.len argv) 3i32)
				(then (array.store arguments 1i32 (call copy_row (borrow-shared bad)))))
			(if (i32.eq (array.len argv) 4i32)
				(then (array.store environment 1i32 (call copy_row (borrow-shared bad)))))
			(let status (call spawn_fixture (borrow-mut pid) (borrow-shared file) null null
				(borrow-shared arguments) (borrow-shared environment)))
			(if (bool.or (i32.not-eq status 17i32) (i32.not-eq (int.convert i32 pid) 100i32))
				(then (return 6i32)))
			(let present (call verify_present (borrow-shared file) (borrow-shared arguments) (borrow-shared environment)))
			(if (i32.not-eqz present) (then (return present)))
			(if (i32.not-eq (call fixture_spawn_drops) 2i32) (then (return 7i32)))
			(let arg_row (borrow-shared (array.load arguments 0i32)))
			(let env_row (borrow-shared (array.load environment 0i32)))
			(if (bool.or (u8.not-eq (array.load arg_row 0i32) 102u8) (u8.not-eq (array.load env_row 0i32) 70u8))
				(then (return 8i32)))
			(return 42i32))))
