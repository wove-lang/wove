(module native_parallel_storage_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-storage.h>"
		(only (type Box) fixture_init fixture_read fixture_increment fixture_destroy fixture_current))
	(bridge c-header "<native-storage.h>"
		(type Box (:pragma (c_owned (drop fixture_destroy) storage)) (c-type "fixture_storage"))
		(fn fixture_init
			(:pragma (c_init box))
			(params (box (mut-ref Box)) (value i32)) (returns i32))
		(fn fixture_read (params (box (shared-ref Box))) (returns i32))
		(fn fixture_increment (params (box (mut-ref Box))) (returns i32))
		(fn fixture_destroy (params (box Box)) (returns i32))
		(fn fixture_current (params) (returns i32))
		(fn fixture_drops (params) (returns i32)))

	(fn read_current
		(params) (returns i32)
		(body (return (call fixture_current))))

	(fn fail_init
		(params) (returns i32)
		(body
			(let-mut box (native:alloc Box))
			(return (call fixture_init (borrow-mut box) 0i32))))

	(fn init_and_destroy
		(params) (returns i32)
		(body
			(let-mut box (native:alloc Box))
			(if (i32:not-eqz (call fixture_init (borrow-mut box) 49i32)) (then (return 1i32)))
			(if (i32:not-eq (call fixture_read (borrow-shared box)) 49i32) (then (return 2i32)))
			(if (i32:not-eq (call fixture_increment (borrow-mut box)) 50i32) (then (return 3i32)))
			(if (i32:not-eq (call fixture_read (borrow-shared box)) 50i32) (then (return 4i32)))
			(return (call fixture_destroy (move box))))))
