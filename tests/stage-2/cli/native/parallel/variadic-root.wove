(module native_parallel_variadic_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./variadic-leaf.wove" (only open_leaf))
	(use c-header "<native-variadic.h>" (only (type Mode) (as fixture_open open_root)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (array:len argv) 2i32) (then (return 3i32)))
			(let path (borrow-shared (array:load argv 1i32)))
			(if (i32:not-eq (call open_root (borrow-shared path) 13i32 (int:convert Mode 384i32)) 23i32)
				(then (return 4i32)))
			(return (call open_leaf (borrow-shared path))))))
