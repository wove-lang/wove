(module native_parallel_record_refs_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-record-refs.h>" (only (type Info) fixture_read fixture_update))
	(bridge c-header "<native-record-refs.h>"
		(struct Info (c-type "fixture_info") (fields (value i32)))
		(fn fixture_capture (:pragma (c_cstr path))
			(params (path (shared-array u8)) (info (mut-ref Info))) (returns i32))
		(fn fixture_read (params (info (shared-ref Info))) (returns i32))
		(fn fixture_update (params (value i32) (info (mut-ref Info))) (returns i32)))

	(fn read_original
		(params (info (shared-ref Info))) (returns i32)
		(body (return (call fixture_read (borrow-shared info)))))

	(fn update_local
		(params) (returns i32)
		(body
			(let-mut info (struct.new Info))
			(if (i32.not-eq (call fixture_update 73i32 (borrow-mut info)) 23i32) (then (return 1i32)))
			(return (struct.get info value)))))
