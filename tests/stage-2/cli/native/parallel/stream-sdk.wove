(module native_parallel_stream_sdk
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./leaf.wove" (only answer))
	(use c-header "<stdio.h>" (only fputc (value stdout) (value stderr)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let output (call fputc 65i32 stdout))
			(let errors (call fputc 97i32 stderr))
			(if (bool.and (i32.eq output 65i32) (i32.eq errors 97i32)) (then (return (call answer))))
			(return 1i32))))
