(module native_parallel_scalar_owner_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-scalar-owner.h>" (only (type Descriptor) (type Stream) fixture_adopt))
	(bridge c-header "<native-scalar-owner.h>"
		(type Descriptor (c-type "fixture_descriptor"))
		(type Stream (:pragma (c_owned (drop fixture_close))) (c-type "fixture_handle"))
		(fn fixture_adopt (params (descriptor Descriptor)) (returns Stream))
		(fn fixture_close (params (stream Stream)) (returns i32))
		(fn fixture_stream_counts (params) (returns i32)))

	(fn adopt_here
		(params (descriptor Descriptor)) (returns bool)
		(body
			(let stream (call fixture_adopt descriptor))
			(return (bool:not (owner:is-null stream))))))
