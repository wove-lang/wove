(module native_parallel_prototype_attributes_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-prototype-attributes.h>" (only (type Size) (type Block) fixture_allocate fixture_score))
	(bridge c-header "<native-prototype-attributes.h>"
		(type Size (c-type "unsigned long"))
		(type Block (:pragma (c_owned (drop fixture_release))) (c-type "fixture_block"))
		(fn fixture_allocate (params (width Size)) (returns Block))
		(fn fixture_release (params (block Block)) (returns i32))
		(fn fixture_score (params (value i32)) (returns i32))
		(fn fixture_live (params) (returns i32)))

	(fn scoped_score
		(params (value i32)) (returns i32)
		(body
			(let block (call fixture_allocate (int:convert Size 32u64)))
			(if (owner:is-null block) (then (return -1i32)))
			(return (call fixture_score value)))))
