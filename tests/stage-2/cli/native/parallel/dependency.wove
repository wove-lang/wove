(module native_parallel_bridge_dependency
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./leaf.wove" (only answer))
	(use c-header "<dependent.h>" (only getpid))
	(bridge c-header "<dependent.h>"
		(use c-header "<dependency.h>" (only))
		(fn getpid (params) (returns i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.lez (call getpid)) (then (return 1i32)))
			(return (call answer)))))
