(module native_parallel_owner_consume_moved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./owner-consume-leaf.wove" (only close_here))
	(use c-header "<native-owner-consume.h>" (only fixture_open_resource close_resource))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let resource (call fixture_open_resource (call close_here 0i32)))
			(let status (call close_resource (move resource)))
			(return (call close_resource (move resource))))))
