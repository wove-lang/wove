(module native_parallel_borrowed_cstr_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-borrowed-cstr.h>" (only fixture_lookup fixture_replace))
	(bridge c-header "<native-borrowed-cstr.h>"
		(fn fixture_lookup
			(:pragma (c_cstr name) (c_snapshot cstr))
			(params (name (shared-array u8))) (returns (optional (owned-array u8))))
		(fn fixture_replace (params) (returns i32)))

	(let missing "missing")
	(let empty "empty")
	(let present "present")

	(fn verify_leaf
		(params) (returns i32)
		(body
			(let absent (call fixture_lookup (borrow-shared missing)))
			(if (bool:not (owner:is-null absent)) (then (return 1i32)))
			(let empty_result (call fixture_lookup (borrow-shared empty)))
			(if (owner:is-null empty_result) (then (return 2i32)))
			(let empty_copy (move (optional:unwrap empty_result)))
			(if (i32:not-eqz (array:len empty_copy)) (then (return 3i32)))
			(if (i32:not-eqz (call fixture_replace)) (then (return 4i32)))
			(let result (call fixture_lookup (borrow-shared present)))
			(if (owner:is-null result) (then (return 5i32)))
			(let updated (move (optional:unwrap result)))
			(if (i32:not-eq (array:len updated) 6i32) (then (return 6i32)))
			(if (u8:not-eq (array:load updated 0i32) 97u8) (then (return 7i32)))
			(return 42i32))))
