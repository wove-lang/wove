(module native_parallel_owner_consume_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./owner-consume-leaf.wove" (only close_here))
	(use c-header "<native-owner-consume.h>" (only fixture_resource_drops))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eqz (call close_here 0i32)) (then (return 1i32)))
			(if (i32.not-eq (call fixture_resource_drops) 1i32) (then (return 2i32)))
			(if (i32.not-eq (call close_here -37i32) -37i32) (then (return 3i32)))
			(if (i32.not-eq (call fixture_resource_drops) 2i32) (then (return 4i32)))
			(return 42i32))))
