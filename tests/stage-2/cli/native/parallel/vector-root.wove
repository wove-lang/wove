(module native_parallel_vector_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./vector-leaf.wove" (only advance_rows))
	(use c-header "<native-vector.h>" (only (value (as fixture_vector root_rows)) (value fixture_nullable)))

	(fn has_row
		(params (rows (shared-array (owned-array u8))) (index i32) (expected u8)) (returns bool)
		(body
			(if (i32:le (array:len rows) index) (then (return (bool false))))
			(let row (borrow-shared (array:load rows index)))
			(return (bool:and (i32:eq (array:len row) 1i32) (u8:eq (array:load row 0i32) expected)))))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let before root_rows)
			(let after (call advance_rows))
			(let again root_rows)
			(let empty fixture_nullable)
			(if (bool:not (call has_row (borrow-shared before) 0i32 97u8)) (then (return 1i32)))
			(if (bool:not (call has_row (borrow-shared after) 0i32 98u8)) (then (return 2i32)))
			(if (bool:not (call has_row (borrow-shared again) 1i32 99u8)) (then (return 3i32)))
			(if (i32:not-eqz (array:len empty)) (then (return 4i32)))
			(return 42i32))))
