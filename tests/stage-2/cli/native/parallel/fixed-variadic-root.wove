(module native_parallel_fixed_variadic_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./fixed-variadic-leaf.wove" (only verify_leaf))
	(use c-header "<native-fixed-variadic.h>" (only (as fixture_set set_flags)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call set_flags 8i32 7u16) 15i32) (then (return 1i32)))
			(return (call verify_leaf)))))
