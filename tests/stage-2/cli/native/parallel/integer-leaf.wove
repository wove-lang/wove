(module native_parallel_integer_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<integer-alias.h>" (only getpgid (type Pid)))
	(bridge c-header "<integer-alias.h>"
		(type Pid (c-type "fixture_pid"))
		(fn getpgid (params (value Pid)) (returns Pid)))

	(fn process_group (params (value Pid)) (returns Pid)
		(body (return (call getpgid value)))))
