(module native_parallel_prototype_attributes_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./prototype-attributes-leaf.wove" (only scoped_score))
	(use c-header "<native-prototype-attributes.h>" (only fixture_live fixture_score))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (call scoped_score 6i32))
			(if (i32:not-eqz (call fixture_live)) (then (return 1i32)))
			(return (i32:add first (call fixture_score 8i32))))))
