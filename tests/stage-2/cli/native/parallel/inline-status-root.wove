(module native_parallel_inline_status_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./inline-status-leaf.wove" (only read_error))
	(use c-header "<native-inline-status.h>" (only fixture_eof fixture_flags (value fixture_status)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(call fixture_flags 64i32)
			(if (i32:not-eqz (call fixture_eof fixture_status)) (then (return 1i32)))
			(if (i32:not-eqz (call read_error)) (then (return 2i32)))
			(call fixture_flags 80i32)
			(if (i32:not-eq (call fixture_eof fixture_status) 1i32) (then (return 3i32)))
			(if (i32:not-eqz (call read_error)) (then (return 4i32)))
			(call fixture_flags 96i32)
			(if (i32:not-eqz (call fixture_eof fixture_status)) (then (return 5i32)))
			(if (i32:not-eq (call read_error) 1i32) (then (return 6i32)))
			(call fixture_flags 112i32)
			(if (i32:not-eq (call fixture_eof fixture_status) 1i32) (then (return 7i32)))
			(if (i32:not-eq (call read_error) 1i32) (then (return 8i32)))
			(return 42i32))))
