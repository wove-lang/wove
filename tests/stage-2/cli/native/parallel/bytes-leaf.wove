(module native_parallel_bytes_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-bytes.h>" (only (type Size) fixture_fill))
	(bridge c-header "<native-bytes.h>"
		(type Size (c-type "fixture_size"))
		(fn fixture_sum (:pragma (c_bytes data width count))
			(params (data (shared-array u8)) (width Size) (count Size)) (returns i32))
		(fn fixture_fill (:pragma (c_bytes data width count))
			(params (data (mut-array u8)) (width Size) (count Size)) (returns i32)))

	(fn fill
		(params (data (mut-array u8))) (returns i32)
		(body
			(let width (int:convert Size 2i32))
			(let count (int:convert Size 2i32))
			(return (call fixture_fill (borrow-mut data) width count)))))
