(module native_parallel_constant_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./constant-leaf.wove" (only adjust))
	(use c-header "<native-constant.h>" (only (value (as FIXTURE_FLAG root_flag))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return (call adjust root_flag)))))
