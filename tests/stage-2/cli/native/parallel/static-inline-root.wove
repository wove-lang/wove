(module native_parallel_static_inline_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./static-inline-leaf.wove" (only check_leaf))
	(use c-header "<native-static-inline.h>" (only fixture_identity16 fixture_swap16 fixture_swap32))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (u16:not-eq (call fixture_identity16 0xab08u16) 0xab08u16) (then (return 1i32)))
			(if (u16:not-eq (call fixture_swap16 0xab08u16) 0x08abu16) (then (return 2i32)))
			(if (u32:not-eq (call fixture_swap32 0x01020304u32) 0x04030201u32) (then (return 3i32)))
			(return (call check_leaf 0x11223344u32 0x1122334455667788u64)))))
