(module native_parallel_borrowed_cstr_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./borrowed-cstr-leaf.wove" (only verify_leaf))
	(use c-header "<native-borrowed-cstr.h>" (only (as fixture_lookup lookup)))

	(let present "present")

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.gt (array.len argv) 1i32)
				(then
					(let-mut embedded (array.alloc u8 3i32))
					(array.store embedded 0i32 112u8)
					(array.store embedded 2i32 113u8)
					(let ignored (call lookup (borrow-shared embedded)))
					(return 1i32)))
			(let result (call lookup (borrow-shared present)))
			(if (owner.is-null result) (then (return 2i32)))
			(let snapshot (move (optional.unwrap result)))
			(if (i32.not-eq (call verify_leaf) 42i32) (then (return 3i32)))
			(if (i32.not-eq (array.len snapshot) 5i32) (then (return 4i32)))
			(if (u8.not-eq (array.load snapshot 0i32) 102u8) (then (return 5i32)))
			(if (u8.not-eq (array.load snapshot 4i32) 116u8) (then (return 6i32)))
			(return 42i32))))
