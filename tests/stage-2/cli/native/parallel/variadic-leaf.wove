(module native_parallel_variadic_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-variadic.h>" (only (type Mode) fixture_open))
	(bridge c-header "<native-variadic.h>"
		(type Mode (c-type "fixture_mode"))
		(fn fixture_open
			(:pragma (c_cstr path) (c_variadic mode))
			(params (path (shared-array u8)) (flags i32) (mode Mode)) (returns i32)))

	(fn open_leaf
		(params (path (shared-array u8))) (returns i32)
		(body (return (call fixture_open (borrow-shared path) 17i32 (int.convert Mode 416i32))))))
