{
	"files": {
		"main.wove": "main.wove",
		"leaf.wove": "leaf.wove",
		"clang": "tool.py",
		"wovec.jsonc": "wovec.jsonc"
	},
	"arguments": {
		"serial-prefix": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{stage}"],
		"split-prefix": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{stage}/"],
		"c11": ["-std=c11", "-Xclang", "-std=c11"],
		"c17": ["-std=c17", "-Xclang", "-std=c17"],
		"c23": ["-std=c23", "-Xclang", "-std=c23"],
		"trace": ["-Xclang", "-dependency-dot", "-Xclang", "-"],
		"audit-sinks": ["-Xclang", "-dependency-file", "-Xclang", "/dev/null", "-Xclang", "-MT", "-Xclang", "wove-probe", "-MJ", "/dev/null", "-Xclang", "-dependency-dot", "-Xclang", "/dev/null", "-Xclang", "-header-include-file", "-Xclang", "/dev/null"],
		"audit-trace": ["audit-sinks", "-H", "-fshow-skipped-includes"],
		"audit-deployment": ["audit-sinks", "-Wno-everything", "-Werror=unguarded-availability", "-fsyntax-only", "--"],
		"audit-preprocess": ["audit-trace", "-Wno-everything", "-E", "-P", "-dD", "--"],
		"audit-ast": ["audit-trace", "-Wno-everything", "-Werror=unguarded-availability", "-Xclang", "-ast-dump=json", "-fsyntax-only", "--"],
		"bridge-argv": ["--cstd=c17", "--cflag=-O1", "--cflag=-I", "--cflag=headers"],
		"bridge-options": ["-O1", "-I", "headers"],
		"fixture-library-argv": ["bridge-argv", "--cflag=-L.", "--ldlib=wove_native_fixture"],
		"fixture-link-options": ["bridge-options", "-L[.]"],
		"prototype-argv": ["--cstd=c23", "--cflag=-O1", "--cflag=-I", "--cflag=headers", "--cflag=-L.", "--ldlib=wove_native_fixture"],
		"pic": ["-fPIC", "-fvisibility=hidden"],
		"object-only": ["-Qunused-arguments", "-c", "-x", "c"],
		"link-only": ["-Qunused-arguments", "-x", "none"]
	},
	"platforms": {
		"darwin": {
			"values": {
				"stage": ".*/\\.wovec-bin\\.[^/]+",
				"fixture-library": "libwove_native_fixture.dylib"
			},
			"arguments": {
				"stream-override-arg": ["--cflag=-Dstdout=__stdoutp"],
				"availability-argv": ["--cflag=-mmacosx-version-min=12.0"],
				"availability-options": ["-mmacosx-version-min=12[.]0"],
				"availability-fixture-options": ["-mmacosx-version-min=11.0"],
				"stream-override": ["-Dstdout=__stdoutp"],
				"system-math": [],
				"fixture-library-options": ["-dynamiclib", "-Xlinker", "-install_name", "-Xlinker", "{root}/{fixture-library}"],
				"shared-library": ["-dynamiclib", "-Xlinker", "-exported_symbols_list", "-Xlinker", "{stage}/library\\.exports", "-Xlinker", "-install_name", "-Xlinker", "@rpath/libanswer\\.shared"]
			}
		},
		"linux": {
			"values": {
				"stage": ".*/\\.wovec-bin\\.[^/]+",
				"fixture-library": "libwove_native_fixture.so"
			},
			"arguments": {
				"stream-override-arg": ["--cflag=-Dstdout=stdout"],
				"availability-argv": [],
				"availability-options": [],
				"availability-fixture-options": [],
				"stream-override": ["-Dstdout=stdout"],
				"system-math": ["-lm"],
				"fixture-library-options": ["-shared", "-fPIC", "-Xlinker", "-soname", "-Xlinker", "{root}/{fixture-library}"],
				"shared-library": ["-shared", "-Xlinker", "--version-script", "-Xlinker", "{stage}/library\\.exports", "-Xlinker", "-soname", "-Xlinker", "libanswer\\.shared"]
			}
		}
	},
	"cases": [
		{
			"name": "serial-and-numbered-equivalence",
			"phases": [
				{
					"argv": ["bin", "main.wove", "-o", "default"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "default",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "disabled", "--no-parallel", "--parallel-jobs=8"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "disabled",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "one", "--parallel", "--parallel-jobs", "1"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "one",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "parallel", "--parallel", "--parallel-jobs", "2"],
					"isolated_path": true,
					"actions": {
						"object-0.o": {
							"start": ["zero-start"],
							"wait": ["one-start"]
						},
						"object-1.o": {
							"start": ["one-start"],
							"wait": ["zero-start"]
						}
					},
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-O1", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c11", "-o", "{stage}/program"]
					},
					"run": {
						"path": "parallel",
						"exit": 42
					},
					"same_c": [
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]
					]
				},
				{
					"argv": ["bin", "main.wove", "-o", "profile", "--profile=grouped", "--parallel-jobs=0", "--cstd=c17", "--cflag=-std=c11", "--cflag=-O2", "--cflag=-Werror"],
					"calls": {
						"object-0.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-std=c11", "-O2", "-Werror", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {
						"path": "profile",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "wide", "--parallel", "--parallel-jobs=4294967295", "--cstd=c17", "--cflag=-std=c11", "--cflag=-O2", "--cflag=-Werror"],
					"calls": {
						"object-0.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-std=c11", "-O2", "-Werror", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {
						"path": "wide",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "override", "--profile=grouped", "--no-parallel"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "override",
						"exit": 42
					}
				}
			]
		},
		{
			"name": "ineligible-bridge-and-shared-depfile",
			"files": {
				"native.wove": "native.wove"
			},
			"phases": [
				{
					"argv": ["bin", "native.wove", "-o", "native", "--parallel", "--parallel-jobs=2"],
					"preflight_count": 2,
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "native",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "depfile", "--parallel", "--parallel-jobs=2", "--cflag=-O1", "--cflag=-MMD", "--cflag=-MF", "--cflag=dependencies.d"],
					"calls": {
						"program": ["serial-prefix", "-O1", "-MMD", "-MF", "dependencies\\.d", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "depfile",
						"exit": 42
					},
					"present": ["dependencies.d"]
				}
			]
		},
		{
			"name": "verified-bridge-and-serial-fallback",
			"files": {
				"verified.wove": "verified.wove",
				"headers/ordinary.h": "ordinary.h"
			},
			"phases": [
				{
					"argv": ["bin", "verified.wove", "-o", "default", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=0", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "default", "exit": 42}
				},
				{
					"argv": ["bin", "verified.wove", "-o", "one", "--parallel", "--parallel-jobs=1", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=0", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "one", "exit": 42}
				},
				{
					"argv": ["bin", "verified.wove", "-o", "parallel", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"isolated_path": true,
					"preflight": [
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/main\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/main\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-ast", "{stage}/main\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/unit-0000000\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/unit-0000001\\.c"]
					],
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "parallel", "exit": 42},
					"same_c": [
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/one/bin/main.c"],
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]
					]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "nothrow", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=3"],
					"preflight_count": 8,
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=3", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=3", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=3", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "nothrow", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/nothrow/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "nothrow-changed", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=3"],
					"preflight_count": 8,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=3", "{stage}/main[.]c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"actions": {"preflight": [
						{"flag": "-ast-dump=json", "file": "unit-0000001.c", "replace_stdout": ["\"mangledName\": \"_?getpid\"", "\"mangledName\": \"different_getpid\""]}
					]},
					"run": {"path": "nothrow-changed", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/nothrow-changed/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "ordinary-availability", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=4", "availability-argv"],
					"preflight": [
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-preprocess", "{stage}/main[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-preprocess", "{stage}/main[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-ast", "{stage}/main[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-ast", "{stage}/main[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-preprocess", "{stage}/unit-0000000[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-ast", "{stage}/unit-0000000[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-preprocess", "{stage}/unit-0000001[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-ast", "{stage}/unit-0000001[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-deployment", "{stage}/unit-0000000[.]c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "audit-deployment", "{stage}/unit-0000001[.]c"]
					],
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "ordinary-availability", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-availability/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "ordinary-availability-changed", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=4", "availability-argv"],
					"preflight_count": 8,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=4", "availability-options", "{stage}/main[.]c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"actions": {"preflight": [
						{"flag": "-ast-dump=json", "file": "unit-0000001.c", "replace_stdout": ["\"kind\": \"AvailabilityAttr\"", "\"kind\": \"AvailabilityAttr\", \"implicit\": true"]}
					]},
					"run": {"path": "ordinary-availability-changed", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-availability-changed/bin/main.c"]]
				},
				{
					"platform": "darwin",
					"argv": ["bin", "verified.wove", "-o", "ordinary-below-deployment", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=4", "--cflag=-mmacosx-version-min=11.0", "--cflag=-Wno-unguarded-availability"],
					"preflight_count": 9,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=4", "-mmacosx-version-min=11[.]0", "-Wno-unguarded-availability", "{stage}/main[.]c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "ordinary-below-deployment", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-below-deployment/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "ordinary-restrict", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=5"],
					"preflight_count": 8,
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=5", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=5", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=5", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "ordinary-restrict", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-restrict/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "ordinary-restrict-changed", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=5"],
					"preflight_count": 8,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=5", "{stage}/main[.]c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"actions": {"preflight": [
						{"flag": "-ast-dump=json", "file": "unit-0000001.c", "replace_stdout": ["\"kind\": \"RestrictAttr\"", "\"kind\": \"RestrictAttr\", \"implicit\": true"]}
					]},
					"run": {"path": "ordinary-restrict-changed", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-restrict-changed/bin/main.c"]]
				},
				{
					"platform": "darwin",
					"argv": ["bin", "verified.wove", "-o", "ordinary-availability-unused", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=6", "--cflag=-mmacosx-version-min=11.0"],
					"preflight_count": 10,
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=6", "-mmacosx-version-min=11[.]0", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=6", "-mmacosx-version-min=11[.]0", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=6", "-mmacosx-version-min=11[.]0", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "ordinary-availability-unused", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-availability-unused/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "ordinary-printf", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=7"],
					"preflight_count": 8,
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=7", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=7", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=7", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "ordinary-printf", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/ordinary-printf/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "ordinary-builtin-changed", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=7"],
					"preflight_count": 8,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=7", "{stage}/main[.]c", "system-math", "c17", "-o", "{stage}/program", "trace"]
