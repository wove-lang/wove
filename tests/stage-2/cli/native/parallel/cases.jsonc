{
	"files": {
		"main.wove": "main.wove",
		"leaf.wove": "leaf.wove",
		"clang": "tool.py",
		"wovec.jsonc": "wovec.jsonc"
	},
	"arguments": {
		"serial-prefix": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{stage}"],
		"split-prefix": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{stage}/"],
		"c11": ["-std=c11", "-Xclang", "-std=c11"],
		"c17": ["-std=c17", "-Xclang", "-std=c17"],
		"trace": ["-Xclang", "-dependency-dot", "-Xclang", "-"],
		"audit-trace": ["-Xclang", "-dependency-file", "-Xclang", "/dev/null", "-Xclang", "-MT", "-Xclang", "wove-probe", "-MJ", "/dev/null", "-Xclang", "-dependency-dot", "-Xclang", "/dev/null", "-Xclang", "-header-include-file", "-Xclang", "/dev/null", "-H", "-fshow-skipped-includes"],
		"audit-preprocess": ["audit-trace", "-Wno-everything", "-E", "-P", "-dD", "--"],
		"audit-ast": ["audit-trace", "-Wno-everything", "-Xclang", "-ast-dump=json", "-fsyntax-only", "--"],
		"bridge-argv": ["--cstd=c17", "--cflag=-O1", "--cflag=-I", "--cflag=headers"],
		"bridge-options": ["-O1", "-I", "headers"],
		"fixture-library-argv": ["bridge-argv", "--cflag=-L.", "--ldlib=wove_native_fixture"],
		"fixture-link-options": ["bridge-options", "-L[.]"],
		"pic": ["-fPIC", "-fvisibility=hidden"],
		"object-only": ["-Qunused-arguments", "-c", "-x", "c"],
		"link-only": ["-Qunused-arguments", "-x", "none"]
	},
	"platforms": {
		"darwin": {
			"values": {
				"stage": ".*/\\.wovec-bin\\.[^/]+",
				"fixture-library": "libwove_native_fixture.dylib"
			},
			"arguments": {
				"stream-override-arg": ["--cflag=-Dstdout=__stdoutp"],
				"stream-override": ["-Dstdout=__stdoutp"],
				"system-math": [],
				"fixture-library-options": ["-dynamiclib", "-Xlinker", "-install_name", "-Xlinker", "{root}/{fixture-library}"],
				"shared-library": ["-dynamiclib", "-Xlinker", "-exported_symbols_list", "-Xlinker", "{stage}/library\\.exports", "-Xlinker", "-install_name", "-Xlinker", "@rpath/libanswer\\.shared"]
			}
		},
		"linux": {
			"values": {
				"stage": ".*/\\.wovec-bin\\.[^/]+",
				"fixture-library": "libwove_native_fixture.so"
			},
			"arguments": {
				"stream-override-arg": ["--cflag=-Dstdout=stdout"],
				"stream-override": ["-Dstdout=stdout"],
				"system-math": ["-lm"],
				"fixture-library-options": ["-shared", "-fPIC", "-Xlinker", "-soname", "-Xlinker", "{root}/{fixture-library}"],
				"shared-library": ["-shared", "-Xlinker", "--version-script", "-Xlinker", "{stage}/library\\.exports", "-Xlinker", "-soname", "-Xlinker", "libanswer\\.shared"]
			}
		}
	},
	"cases": [
		{
			"name": "serial-and-numbered-equivalence",
			"phases": [
				{
					"argv": ["bin", "main.wove", "-o", "default"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "default",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "disabled", "--no-parallel", "--parallel-jobs=8"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "disabled",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "one", "--parallel", "--parallel-jobs", "1"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "one",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "parallel", "--parallel", "--parallel-jobs", "2"],
					"isolated_path": true,
					"actions": {
						"object-0.o": {
							"start": ["zero-start"],
							"wait": ["one-start"]
						},
						"object-1.o": {
							"start": ["one-start"],
							"wait": ["zero-start"]
						}
					},
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-O1", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c11", "-o", "{stage}/program"]
					},
					"run": {
						"path": "parallel",
						"exit": 42
					},
					"same_c": [
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]
					]
				},
				{
					"argv": ["bin", "main.wove", "-o", "profile", "--profile=grouped", "--parallel-jobs=0", "--cstd=c17", "--cflag=-std=c11", "--cflag=-O2", "--cflag=-Werror"],
					"calls": {
						"object-0.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-std=c11", "-O2", "-Werror", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {
						"path": "profile",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "wide", "--parallel", "--parallel-jobs=4294967295", "--cstd=c17", "--cflag=-std=c11", "--cflag=-O2", "--cflag=-Werror"],
					"calls": {
						"object-0.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-std=c11", "-O2", "-Werror", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {
						"path": "wide",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "override", "--profile=grouped", "--no-parallel"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "override",
						"exit": 42
					}
				}
			]
		},
		{
			"name": "ineligible-bridge-and-shared-depfile",
			"files": {
				"native.wove": "native.wove"
			},
			"phases": [
				{
					"argv": ["bin", "native.wove", "-o", "native", "--parallel", "--parallel-jobs=2"],
					"preflight_count": 2,
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "native",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "depfile", "--parallel", "--parallel-jobs=2", "--cflag=-O1", "--cflag=-MMD", "--cflag=-MF", "--cflag=dependencies.d"],
					"calls": {
						"program": ["serial-prefix", "-O1", "-MMD", "-MF", "dependencies\\.d", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "depfile",
						"exit": 42
					},
					"present": ["dependencies.d"]
				}
			]
		},
		{
			"name": "verified-bridge-and-serial-fallback",
			"files": {
				"verified.wove": "verified.wove",
				"headers/ordinary.h": "ordinary.h"
			},
			"phases": [
				{
					"argv": ["bin", "verified.wove", "-o", "default", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=0", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "default", "exit": 42}
				},
				{
					"argv": ["bin", "verified.wove", "-o", "one", "--parallel", "--parallel-jobs=1", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=0", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "one", "exit": 42}
				},
				{
					"argv": ["bin", "verified.wove", "-o", "parallel", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"isolated_path": true,
					"preflight": [
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/main\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/main\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-ast", "{stage}/main\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/unit-0000000\\.c"],
						["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "audit-preprocess", "{stage}/unit-0000001\\.c"]
					],
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "parallel", "exit": 42},
					"same_c": [
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/one/bin/main.c"],
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]
					]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "state", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=1"],
					"preflight_count": 3,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=1", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "state", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/state/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "filename", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=2"],
					"isolated_path": true,
					"preflight_count": 4,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=2", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "filename", "exit": 42},
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/filename/bin/main.c"]]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "headers/ordinary.h", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=0"],
					"preflight_count": 5,
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "bridge-options", "-DBRIDGE_MODE=0", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"exit": 1,
					"diagnostic": {"code": 71, "message": "output would overwrite input", "location": {"kind": "source", "file": "headers/ordinary.h", "start": 0, "end": 0}},
					"preserve": ["headers/ordinary.h"],
					"absent": ["headers/.wovec-cache/default/ordinary.h/bin/main.c"]
				},
				{
					"argv": ["bin", "verified.wove", "-o", "filename", "--parallel", "--parallel-jobs=2", "bridge-argv", "--cflag=-DBRIDGE_MODE=2"],
					"preflight_count": 4,
					"calls": {
						"program": ["serial-prefix", "bridge-options", "-DBRIDGE_MODE=2", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"actions": {"program": {"exit": 17, "stderr": "serial fallback failed\n"}},
					"exit": 17,
					"stderr": "serial fallback failed\n",
					"diagnostic": {"code": 68, "message": "clang failed with status 17", "location": {"kind": "argv", "index": 0}},
					"preserve": ["filename"],
					"same_c": [[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/filename/bin/main.c"]]
				}
			]
		},
		{
			"name": "verified-native-integer-alias",
			"files": {
				"integer-alias.wove": "integer-alias.wove",
				"integer-leaf.wove": "integer-leaf.wove",
				"headers/integer-alias.h": "integer-alias.h"
			},
			"phases": [
				{
					"argv": ["bin", "integer-alias.wove", "-o", "serial", "bridge-argv"],
					"calls": {
						"program": ["serial-prefix", "bridge-options", "{stage}/main\\.c", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "serial", "exit": 42}
				},
				{
					"argv": ["bin", "integer-alias.wove", "-o", "parallel", "--parallel", "--parallel-jobs=2", "bridge-argv"],
					"preflight_count": 5,
					"calls": {
						"object-0.o": ["split-prefix", "bridge-options", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "bridge-options", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "bridge-options", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "parallel", "exit": 42},
					"same_c": [[".wovec-cache/default/serial/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]]
				}
			]
		},
		{
			"name": "verified-writable-native-integers",
			"files": {
				"lvalue-root.wove": "lvalue-root.wove",
				"lvalue-leaf.wove": "lvalue-leaf.wove",
				"headers/native-lvalue.h": "native-lvalue.h",
				"native-lvalue.c": "native-lvalue.c",
				"context/stdint.h": "lvalue-context-stdint.h"
			},
			"prepare": [
				["-std=c11", "-Iheaders", "fixture-library-options", "native-lvalue.c", "-o", "{fixture-library}"]
			],
			"phases": [
				{
					"argv": ["bin", "lvalue-root.wove", "-o", "serial", "fixture-library-argv"],
					"calls": {
						"program": ["serial-prefix", "fixture-link-options", "{stage}/main[.]c", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "serial", "exit": 42}
				},
				{
					"argv": ["bin", "lvalue-root.wove", "-o", "parallel", "--parallel", "--parallel-jobs=2", "fixture-library-argv"],
					"preflight_count": 9,
					"calls": {
						"object-0.o": ["split-prefix", "fixture-link-options", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "fixture-link-options", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "fixture-link-options", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "parallel", "exit": 42},
					"same_c": [[".wovec-cache/default/serial/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]]
				},
				{
					"argv": ["bin", "lvalue-root.wove", "-o", "nested", "--parallel", "--parallel-jobs=2", "fixture-library-argv", "--cflag=-I", "--cflag=context"],
					"preflight_count": 6,
					"calls": {
						"program": ["serial-prefix", "fixture-link-options", "-I", "context", "{stage}/main[.]c", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "nested", "exit": 42},
					"same_c": [[".wovec-cache/default/serial/bin/main.c", ".wovec-cache/default/nested/bin/main.c"]]
				}
			]
		},
		{
			"name": "verified-native-vector-snapshots",
			"files": {
				"vector-root.wove": "vector-root.wove",
				"vector-leaf.wove": "vector-leaf.wove",
				"headers/native-vector.h": "native-vector.h",
				"native-vector.c": "native-vector.c",
				"context/stdint.h": "vector-context-stdint.h"
			},
			"prepare": [
				["-std=c11", "-Iheaders", "fixture-library-options", "native-vector.c", "-o", "{fixture-library}"]
			],
			"phases": [
				{
					"argv": ["bin", "vector-root.wove", "-o", "serial", "fixture-library-argv"],
					"calls": {
						"program": ["serial-prefix", "fixture-link-options", "{stage}/main[.]c", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "serial", "exit": 42}
				},
				{
					"argv": ["bin", "vector-root.wove", "-o", "parallel", "--parallel", "--parallel-jobs=2", "fixture-library-argv"],
					"preflight_count": 6,
					"calls": {
						"object-0.o": ["split-prefix", "fixture-link-options", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "fixture-link-options", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
						"program": ["split-prefix", "fixture-link-options", "link-only", "{stage}/object-0[.]o", "{stage}/object-1[.]o", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {"path": "parallel", "exit": 42},
					"same_c": [[".wovec-cache/default/serial/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]]
				},
				{
					"argv": ["bin", "vector-root.wove", "-o", "nested", "--parallel", "--parallel-jobs=2", "fixture-library-argv", "--cflag=-I", "--cflag=context"],
					"preflight_count": 5,
					"calls": {
						"program": ["serial-prefix", "fixture-link-options", "-I", "context", "{stage}/main[.]c", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "nested", "exit": 42},
					"same_c": [[".wovec-cache/default/serial/bin/main.c", ".wovec-cache/default/nested/bin/main.c"]]
				}
			]
		},
		{
			"name": "verified-native-storage-owners",
			"files": {
				"storage-root.wove": "storage-root.wove",
				"storage-leaf.wove": "storage-leaf.wove",
				"headers/native-storage.h": "native-storage.h",
				"native-storage.c": "native-storage.c",
				"context/stdint.h": "storage-context-stdint.h"
			},
			"prepare": [
				["-std=c11", "-Iheaders", "fixture-library-options", "native-storage.c", "-o", "{fixture-library}"]
			],
			"phases": [
				{
					"argv": ["bin", "storage-root.wove", "-o", "serial", "fixture-library-argv"],
					"calls": {
						"program": ["serial-prefix", "fixture-link-options", "{stage}/main[.]c", "-lwove_native_fixture", "system-math", "c17", "-o", "{stage}/program", "trace"]
					},
					"run": {"path": "serial", "exit": 42}
				},
				{
					"argv": ["bin", "storage-root.wove", "-o", "parallel", "--parallel", "--parallel-jobs=2", "fixture-library-argv"],
					"preflight_count": 9,
					"calls": {
						"object-0.o": ["split-prefix", "fixture-link-options", "c17", "object-only", "{stage}/unit-0000000[.]c", "-o", "{stage}/object-0[.]o", "trace"],
						"object-1.o": ["split-prefix", "fixture-link-options", "c17", "object-only", "{stage}/unit-0000001[.]c", "-o", "{stage}/object-1[.]o", "trace"],
