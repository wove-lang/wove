{
	"files": {
		"main.wove": "main.wove",
		"leaf.wove": "leaf.wove",
		"clang": "tool.py",
		"wovec.jsonc": "wovec.jsonc"
	},
	"arguments": {
		"serial-prefix": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{stage}"],
		"split-prefix": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{stage}/"],
		"c11": ["-std=c11", "-Xclang", "-std=c11"],
		"c17": ["-std=c17", "-Xclang", "-std=c17"],
		"trace": ["-Xclang", "-dependency-dot", "-Xclang", "-"],
		"pic": ["-fPIC", "-fvisibility=hidden"],
		"object-only": ["-Qunused-arguments", "-c", "-x", "c"],
		"link-only": ["-Qunused-arguments", "-x", "none"]
	},
	"platforms": {
		"darwin": {
			"values": {
				"stage": ".*/\\.wovec-bin\\.[^/]+"
			},
			"arguments": {
				"system-math": [],
				"shared-library": ["-dynamiclib", "-Xlinker", "-exported_symbols_list", "-Xlinker", "{stage}/library\\.exports", "-Xlinker", "-install_name", "-Xlinker", "@rpath/libanswer\\.shared"]
			}
		},
		"linux": {
			"values": {
				"stage": ".*/\\.wovec-bin\\.[^/]+"
			},
			"arguments": {
				"system-math": ["-lm"],
				"shared-library": ["-shared", "-Xlinker", "--version-script", "-Xlinker", "{stage}/library\\.exports", "-Xlinker", "-soname", "-Xlinker", "libanswer\\.shared"]
			}
		}
	},
	"cases": [
		{
			"name": "serial-and-numbered-equivalence",
			"phases": [
				{
					"argv": ["bin", "main.wove", "-o", "default"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "default",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "disabled", "--no-parallel", "--parallel-jobs=8"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "disabled",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "one", "--parallel", "--parallel-jobs", "1"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "one",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "parallel", "--parallel", "--parallel-jobs", "2"],
					"actions": {
						"object-0.o": {
							"start": ["zero-start"],
							"wait": ["one-start"]
						},
						"object-1.o": {
							"start": ["one-start"],
							"wait": ["zero-start"]
						}
					},
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-O1", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c11", "-o", "{stage}/program"]
					},
					"run": {
						"path": "parallel",
						"exit": 42
					},
					"same_c": [
						[".wovec-cache/default/default/bin/main.c", ".wovec-cache/default/parallel/bin/main.c"]
					]
				},
				{
					"argv": ["bin", "main.wove", "-o", "profile", "--profile=grouped", "--parallel-jobs=0", "--cstd=c17", "--cflag=-std=c11", "--cflag=-O2", "--cflag=-Werror"],
					"calls": {
						"object-0.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-std=c11", "-O2", "-Werror", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {
						"path": "profile",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "wide", "--parallel", "--parallel-jobs=4294967295", "--cstd=c17", "--cflag=-std=c11", "--cflag=-O2", "--cflag=-Werror"],
					"calls": {
						"object-0.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-std=c11", "-O2", "-Werror", "c17", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-std=c11", "-O2", "-Werror", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c17", "-o", "{stage}/program"]
					},
					"run": {
						"path": "wide",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "override", "--profile=grouped", "--no-parallel"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "override",
						"exit": 42
					}
				}
			]
		},
		{
			"name": "ineligible-bridge-and-shared-depfile",
			"files": {
				"native.wove": "native.wove"
			},
			"phases": [
				{
					"argv": ["bin", "native.wove", "-o", "native", "--parallel", "--parallel-jobs=2"],
					"calls": {
						"program": ["serial-prefix", "-O1", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "native",
						"exit": 42
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "depfile", "--parallel", "--parallel-jobs=2", "--cflag=-O1", "--cflag=-MMD", "--cflag=-MF", "--cflag=dependencies.d"],
					"calls": {
						"program": ["serial-prefix", "-O1", "-MMD", "-MF", "dependencies\\.d", "{stage}/main\\.c", "system-math", "c11", "-o", "{stage}/program", "trace"]
					},
					"run": {
						"path": "depfile",
						"exit": 42
					},
					"present": ["dependencies.d"]
				}
			]
		},
		{
			"name": "object-and-link-failures",
			"phases": [
				{
					"argv": ["bin", "main.wove", "-o", "published", "--parallel", "--parallel-jobs=2"],
					"previous": {
						"target": "published",
						"source": "previous.sh"
					},
					"preserve": ["published"],
					"present": [".wovec-cache/default/published/bin/main.c", "slow-completed"],
					"stderr": "second compile failed\n",
					"exit": 23,
					"diagnostic": {
						"code": 68,
						"message": "clang failed with status 23 while compiling unit-0000001\\.c",
						"location": {
							"kind": "argv",
							"index": 0
						}
					},
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"]
					},
					"actions": {
						"object-0.o": {
							"start": ["slow-started"],
							"wait": ["other-failed"],
							"delay": 0.12,
							"finish": ["slow-completed"]
						},
						"object-1.o": {
							"wait": ["slow-started"],
							"finish": ["other-failed"],
							"exit": 23,
							"stderr": "second compile failed\n"
						}
					},
					"run": {
						"path": "published",
						"exit": 31
					}
				},
				{
					"argv": ["bin", "main.wove", "-o", "published", "--parallel", "--parallel-jobs=2"],
					"previous": {
						"target": "published",
						"source": "previous.sh"
					},
					"preserve": ["published"],
					"present": [".wovec-cache/default/published/bin/main.c"],
					"stderr": "link failed\n",
					"exit": 24,
					"diagnostic": {
						"code": 68,
						"message": "clang failed with status 24",
						"location": {
							"kind": "argv",
							"index": 0
						}
					},
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "c11", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-O1", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c11", "-o", "{stage}/program"]
					},
					"actions": {
						"program": {
							"output": "partial private result",
							"exit": 24,
							"stderr": "link failed\n"
						}
					},
					"run": {
						"path": "published",
						"exit": 31
					}
				}
			]
		},
		{
			"name": "resolved-header-protection",
			"files": {
				"headers/stdint.h": "stdint.h"
			},
			"phases": [
				{
					"argv": ["bin", "main.wove", "-o", "headers/stdint.h", "--parallel", "--parallel-jobs=2", "--cflag=-O1", "--cflag=-isystem", "--cflag=headers"],
					"preserve": ["headers/stdint.h"],
					"absent": [".wovec-cache/default/stdint.h/bin/main.c"],
					"exit": 1,
					"diagnostic": {"code": 71, "message": "output would overwrite input", "location": {"kind": "source", "file": "headers/stdint.h", "start": 0, "end": 0}},
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "-isystem", "headers", "c11", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "-isystem", "headers", "c11", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-O1", "-isystem", "headers", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "c11", "-o", "{stage}/program"]
					}
				}
			]
		},
		{
			"name": "native-shared-library",
			"files": {
				"library.wove": "library.wove",
				"consumer.c": "../staged_build/consumer.c"
			},
			"phases": [
				{
					"argv": ["bin", "library.wove", "-o", "libanswer.shared", "--parallel", "--parallel-jobs=2"],
					"calls": {
						"object-0.o": ["split-prefix", "-O1", "c11", "pic", "object-only", "{stage}/unit-0000000\\.c", "-o", "{stage}/object-0\\.o", "trace"],
						"object-1.o": ["split-prefix", "-O1", "c11", "pic", "object-only", "{stage}/unit-0000001\\.c", "-o", "{stage}/object-1\\.o", "trace"],
						"program": ["split-prefix", "-O1", "link-only", "{stage}/object-0\\.o", "{stage}/object-1\\.o", "system-math", "shared-library", "c11", "-o", "{stage}/program"]
					},
					"present": ["libanswer.shared", "libanswer.shared.h"],
					"consumers": [
						{
							"compile": ["consumer.c", "./libanswer.shared", "-Xlinker", "-rpath", "-Xlinker", "{root}", "-o", "consumer"],
							"path": "consumer",
							"exit": 42
						}
					]
				}
			]
		}
	]
}
