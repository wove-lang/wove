(module native_parallel_mutable_cstr_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./mutable-cstr-leaf.wove" (only prepare verify_failure))
	(use c-header "<native-mutable-cstr.h>" (only (as fixture_edit edit)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut path (array:alloc u8 4i32))
			(call prepare (borrow-mut path) 112u8)
			(if (i32:gt (array:len argv) 1i32)
				(then
					(array:store path 1i32 0u8)
					(let ignored (call edit (borrow-mut path)))
					(return 1i32)))
			(let result (call edit (borrow-mut path)))
			(if (owner:is-null result) (then (return 2i32)))
			(let snapshot (move (optional:unwrap result)))
			(if (i32:not-eq (array:len path) 4i32) (then (return 3i32)))
			(if (u8:not-eq (array:load path 0i32) 80u8) (then (return 4i32)))
			(if (u8:not-eq (array:load path 1i32) 88u8) (then (return 5i32)))
			(if (u8:not-eq (array:load path 2i32) 0u8) (then (return 6i32)))
			(if (u8:not-eq (array:load path 3i32) 81u8) (then (return 7i32)))
			(call prepare (borrow-mut path) 110u8)
			(if (i32:not-eq (call verify_failure) 42i32) (then (return 8i32)))
			(if (i32:not-eq (array:len snapshot) 1i32) (then (return 9i32)))
			(if (u8:not-eq (array:load snapshot 0i32) 88u8) (then (return 10i32)))
			(return 42i32))))
