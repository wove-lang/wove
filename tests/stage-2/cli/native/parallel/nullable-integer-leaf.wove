(module native_parallel_nullable_integer_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-nullable-integer.h>" (only (type Child) fixture_wait))
	(bridge c-header "<native-nullable-integer.h>"
		(type Child (c-type "fixture_child"))
		(fn fixture_wait
			(:pragma (c_nullable status))
			(params (child Child) (status (mut-ref i32)) (options i32))
			(returns Child)))

	(fn verify_status
		(params) (returns i32)
		(body
			(let-mut status 7i32)
			(let child (int:convert Child 17i32))
			(let waited (call fixture_wait child (borrow-mut status) 35i32))
			(if (i32:not-eq (int:convert i32 waited) 17i32) (then (return 2i32)))
			(return status))))
