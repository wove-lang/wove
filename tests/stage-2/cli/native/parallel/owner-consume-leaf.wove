(module native_parallel_owner_consume_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-owner-consume.h>" (only fixture_open_resource close_resource))
	(bridge c-header "<native-owner-consume.h>"
		(type Resource (:pragma (c_owned (drop fixture_close_resource))) (c-type "fixture_resource_handle"))
		(fn fixture_open_resource (params (status i32)) (returns Resource))
		(fn close_resource (c-name "fixture_close_resource") (params (resource Resource)) (returns i32))
		(fn fixture_resource_drops (params) (returns i32)))

	(fn close_here
		(params (status i32)) (returns i32)
		(body
			(let resource (call fixture_open_resource status))
			(if (owner:is-null resource) (then (return 9i32)))
			(return (call close_resource (move resource))))))
