(module native_parallel_pointer_owner_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-pointer-owner.h>" (only (type Stream) fixture_open))
	(bridge c-header "<native-pointer-owner.h>"
		(type Stream (:pragma (c_owned (drop fixture_close))) (c-type "fixture_handle"))
		(fn fixture_open
			(:pragma (c_cstr path mode))
			(params (path (shared-array u8)) (mode (shared-array u8)))
			(returns Stream))
		(fn fixture_close (params (handle Stream)) (returns i32))
		(fn fixture_stream_counts (params) (returns i32)))

	(fn open_scoped
		(params (path (shared-array u8)) (mode (shared-array u8))) (returns bool)
		(body
			(let stream (call fixture_open (borrow-shared path) (borrow-shared mode)))
			(return (bool.not (owner.is-null stream))))))
