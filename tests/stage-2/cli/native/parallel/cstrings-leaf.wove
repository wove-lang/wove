(module native_parallel_cstrings_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-cstrings.h>" (only fixture_unlink fixture_rename))
	(bridge c-header "<native-cstrings.h>"
		(type Mode (c-type "fixture_path_mode"))
		(fn fixture_mkdir
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (mode Mode)) (returns i32))
		(fn fixture_unlink (:pragma (c_cstr path))
			(params (path (shared-array u8))) (returns i32))
		(fn fixture_rename (:pragma (c_cstr from to))
			(params (from (shared-array u8)) (to (shared-array u8))) (returns i32)))

	(let source_path "p")
	(let target_path "q")

	(fn check_paths
		(params (directory (shared-array u8)) (missing (shared-array u8))) (returns i32)
		(body
			(if (i32:not-eqz (call fixture_unlink (borrow-shared directory))) (then (return 3i32)))
			(if (i32:not-eq (call fixture_unlink (borrow-shared missing)) -1i32) (then (return 4i32)))
			(if (i32:not-eq (call fixture_rename (borrow-shared target_path) (borrow-shared source_path)) -1i32)
				(then (return 5i32)))
			(return (call fixture_rename (borrow-shared source_path) (borrow-shared target_path))))))
