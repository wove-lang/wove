(module native_parallel_verified
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./leaf.wove" (only answer))
	(use c-header "<ordinary.h>" (only getpid))
	(bridge c-header "<ordinary.h>"
		(fn getpid (params) (returns i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:le (call getpid) 0i32) (then (return 1i32)))
			(return (call answer)))))
