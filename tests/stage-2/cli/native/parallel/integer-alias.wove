(module native_parallel_integer_alias
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./integer-leaf.wove" (only process_group))
	(use c-header "<integer-alias.h>" (only (type (as Pid RootPid))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let self (int.convert RootPid 0i32))
			(let group (call process_group self))
			(if (i32.gtz (int.convert i32 group)) (then (return 42i32)))
			(return 1i32))))
