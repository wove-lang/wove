(module native_parallel_pure_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-pure.h>" (only atof))
	(bridge c-header "<native-pure.h>"
		(fn atof
			(:pragma (c_cstr text))
			(params (text (shared-array u8))) (returns f64)))

	(let leaf_input "-4.5")

	(fn parse_leaf (params) (returns f64)
		(body (return (call atof (borrow-shared leaf_input))))))
