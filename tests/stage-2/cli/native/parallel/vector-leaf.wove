(module native_parallel_vector_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-vector.h>" (only (value (as fixture_vector leaf_rows)) fixture_advance))
	(bridge c-header "<native-vector.h>"
		(let fixture_vector (:pragma (c_snapshot cstrs)) (owned-array (owned-array u8)))
		(let fixture_nullable (:pragma (c_snapshot cstrs)) (owned-array (owned-array u8)))
		(fn fixture_advance (params) (returns void)))

	(fn advance_rows
		(params) (returns (owned-array (owned-array u8)))
		(body
			(call fixture_advance)
			(let result leaf_rows)
			(return (move result)))))
