(module native_parallel_fixed_variadic_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-fixed-variadic.h>" (only fixture_set fixture_dup))
	(bridge c-header "<native-fixed-variadic.h>"
		(fn fixture_set
			(:pragma (c_variadic flags))
			(c-name "fixture_control")
			(params (descriptor i32) (const command i32 FIXTURE_SET) (flags u16)) (returns i32))
		(fn fixture_dup
			(:pragma (c_variadic minimum))
			(c-name "fixture_control")
			(params (descriptor i32) (const command i32 FIXTURE_DUP) (minimum i32)) (returns i32)))

	(fn verify_leaf
		(params) (returns i32)
		(body (return (call fixture_dup 65i32 23i32)))))
