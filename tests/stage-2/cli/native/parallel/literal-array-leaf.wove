(module native_parallel_literal_array_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-literal-array.h>" (only fixture_fill))
	(bridge c-header "<native-literal-array.h>"
		(fn fixture_fill
			(:pragma (c_array descriptors 2))
			(params (descriptors (mut-array i32)) (flags i32)) (returns i32)))

	(fn verify_leaf
		(params) (returns i32)
		(body
			(let-mut descriptors (array:repeat (array i32 2) -1i32))
			(if (i32:not-eqz (call fixture_fill (borrow-mut descriptors) 31i32)) (then (return 5i32)))
			(if (i32:not-eq (array:get descriptors 0i32) 32i32) (then (return 6i32)))
			(if (i32:not-eq (array:get descriptors 1i32) 33i32) (then (return 7i32)))
			(return 42i32))))
