(module native_parallel_asm_label_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./leaf.wove" (only answer))
	(use c-header "<native-asm-label.h>" (only fixture_read))
	(bridge c-header "<native-asm-label.h>"
		(fn fixture_read (params (value i32)) (returns i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_read (call answer))))))
