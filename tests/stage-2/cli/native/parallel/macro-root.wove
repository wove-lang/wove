(module native_parallel_macro_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./macro-leaf.wove" (only score))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut state (array:alloc i32 1i32))
			(array:store state 0i32 2i32)
			(let result (call score (borrow-mut state)))
			(if (i32:not-eq (array:load state 0i32) 4i32) (then (return 1i32)))
			(return result))))
