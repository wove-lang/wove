(module native_parallel_extern_inline_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./extern-inline-leaf.wove" (only forward_leaf))
	(use c-header "<native-extern-inline.h>" (only fixture_forward))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32:add (call forward_leaf) (call fixture_forward 22i32))))))
