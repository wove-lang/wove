(module native_parallel_macro_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-macro.h>" (only (type Mode) (as FIXTURE_SCORE native_score) FIXTURE_NONZERO))
	(bridge c-header "<native-macro.h>"
		(type Mode (c-type "fixture_mode"))
		(fn FIXTURE_SCORE (:pragma (c_macro)) (params (used Mode) (unused i32)) (returns i32))
		(fn FIXTURE_NONZERO (:pragma (c_macro)) (params (value i32)) (returns bool)))

	(fn next_value
		(params (state (mut-array i32))) (returns i32)
		(body
			(let value (i32:inc (array:load state 0i32)))
			(array:store state 0i32 value)
			(return value)))

	(fn score
		(params (state (mut-array i32))) (returns i32)
		(body
			(let result (call native_score (int:convert Mode (call next_value (borrow-mut state)))
				(call next_value (borrow-mut state))))
			(if (call FIXTURE_NONZERO result) (then (return result)))
			(return 2i32))))
