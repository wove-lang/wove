(module native_parallel_stream_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stream-views.h>" (only fputc (value stdout) (value stderr)))

	(fn write_streams (params) (returns i32)
		(body
			(let output (call fputc 66i32 stdout))
			(let errors (call fputc 98i32 stderr))
			(if (bool:and (i32:eq output 66i32) (i32:eq errors 98i32)) (then (return 42i32)))
			(return 1i32))))
