(module native_parallel_inline_write_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-inline-write.h>" (only fixture_write (value fixture_output)))
	(bridge c-header "<native-inline-write.h>"
		(type Writer (:pragma (c_owned (drop fixture_close))) (c-type "struct fixture_writer *"))
		(let fixture_output (shared-ref Writer))
		(fn fixture_write (params (stream (shared-ref Writer)) (value i32)) (returns i32))
		(fn fixture_written (params (index i32)) (returns i32)))

	(fn write_leaf (params (value i32)) (returns i32)
		(body (return (call fixture_write fixture_output value)))))
