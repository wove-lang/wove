(module native_parallel_inline_read_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./inline-read-leaf.wove" (only read_leaf))
	(use c-header "<native-inline-read.h>" (only fixture_read (value fixture_input)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_read fixture_input) 225i32) (then (return 1i32)))
			(if (i32:not-eq (call read_leaf) 90i32) (then (return 2i32)))
			(if (i32:not-eq (call fixture_read fixture_input) -1i32) (then (return 3i32)))
			(if (i32:not-eq (call read_leaf) -1i32) (then (return 4i32)))
			(return 42i32))))
