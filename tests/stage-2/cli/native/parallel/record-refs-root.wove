(module native_parallel_record_refs_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./record-refs-leaf.wove" (only read_original update_local))
	(use c-header "<native-record-refs.h>" (only (type (as Info Status)) (as fixture_capture capture)))

	(let entry_name "entry")
	(let missing_name "missing")

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut info (struct.new Status))
			(if (i32.not-eqz (call capture (borrow-shared entry_name) (borrow-mut info))) (then (return 1i32)))
			(if (i32.not-eq (call read_original (borrow-shared info)) 42i32) (then (return 2i32)))
			(if (i32.not-eq (call capture (borrow-shared missing_name) (borrow-mut info)) -1i32) (then (return 3i32)))
			(if (i32.not-eq (call update_local) 73i32) (then (return 4i32)))
			(return (struct.get info value)))))
