(module native_parallel_pure_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pure-leaf.wove" (only parse_leaf))
	(use c-header "<native-pure.h>" (only atof))

	(let main_input "46.5")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let left (call atof (borrow-shared main_input)))
			(let right (call parse_leaf))
			(if (bool:and (f64:eq left 46.5f64) (f64:eq right -4.5f64)) (then (return 42i32)))
			(return 1i32))))
