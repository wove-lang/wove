(module native_parallel_field_snapshot_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./field-snapshot-leaf.wove" (only verify_snapshots))
	(use c-header "<native-field-snapshot.h>" (only fixture_open_directory fixture_read_entry fixture_directory_drops))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.gt (array.len argv) 1i32)
				(then
					(let-mut directory (call fixture_open_directory (i32.dec (array.len argv))))
					(let text (call fixture_read_entry (borrow-mut directory)))
					(return 9i32)))
			(let status (call verify_snapshots))
			(if (i32.not-eqz status) (then (return status)))
			(if (i32.not-eq (call fixture_directory_drops) 1i32) (then (return 10i32)))
			(return 42i32))))
