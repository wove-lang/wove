(module native_parallel_lvalue_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./lvalue-leaf.wove" (only (type LvalueJob) run_worker))
	(use c-header "<native-lvalue.h>" (only (value (as fixture_lvalue root_slot)) fixture_barrier))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let receipt (worker.spawn run_worker (struct.new LvalueJob (value 23i32))))
			(set root_slot 17i32)
			(call fixture_barrier)
			(let retained root_slot)
			(let result (worker.join receipt))
			(if (bool.and (i32.eq retained 17i32) (i32.eq root_slot 17i32))
				(then (return (array.len result))))
			(return 2i32))))
