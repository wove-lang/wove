(module native_parallel_snapshot_call_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-snapshot-call.h>" (only fixture_resolve fixture_releases))
	(bridge c-header "<native-snapshot-call.h>"
		(fn fixture_resolve
			(:pragma (c_cstr path output) (c_null output) (c_snapshot cstr (drop fixture_release)))
			(params (path (shared-array u8)) (output (mut-array u8)))
			(returns (optional (owned-array u8))))
		(fn fixture_releases (params) (returns i32)))

	(let second "second")
	(let missing "missing")

	(fn verify_leaf
		(params) (returns i32)
		(body
			(let absent (call fixture_resolve (borrow-shared missing) null))
			(if (bool:not (owner:is-null absent)) (then (return 1i32)))
			(if (i32:not-eq (call fixture_releases) 1i32) (then (return 2i32)))
			(let result (call fixture_resolve (borrow-shared second) null))
			(if (owner:is-null result) (then (return 3i32)))
			(let snapshot (move (optional:unwrap result)))
			(if (i32:not-eq (array:len snapshot) 6i32) (then (return 4i32)))
			(if (u8:not-eq (array:load snapshot 0i32) 115u8) (then (return 5i32)))
			(return 42i32))))
