(module native_parallel_snapshot_call_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./snapshot-call-leaf.wove" (only verify_leaf))
	(use c-header "<native-snapshot-call.h>" (only (as fixture_resolve resolve) fixture_releases))

	(let first "first")

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:gt (array:len argv) 1i32)
				(then
					(let-mut embedded (array:alloc u8 3i32))
					(array:set embedded 0i32 102u8)
					(array:set embedded 2i32 105u8)
					(let ignored (call resolve (borrow-shared embedded) null))
					(return 1i32)))
			(let result (call resolve (borrow-shared first) null))
			(if (owner:is-null result) (then (return 2i32)))
			(let snapshot (move (optional:unwrap result)))
			(if (i32:not-eq (call fixture_releases) 1i32) (then (return 3i32)))
			(if (i32:not-eq (call verify_leaf) 42i32) (then (return 4i32)))
			(if (i32:not-eq (call fixture_releases) 2i32) (then (return 5i32)))
			(if (i32:not-eq (array:len snapshot) 5i32) (then (return 6i32)))
			(if (u8:not-eq (array:get snapshot 0i32) 102u8) (then (return 7i32)))
			(return 42i32))))
