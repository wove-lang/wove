(module native_parallel_stream_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./stream-leaf.wove" (only write_streams))
	(use c-header "<stream-views.h>" (only fputc (value (as stdout output)) (value (as stderr errors))))
	(bridge c-header "<stream-views.h>"
		(type File (:pragma (c_owned (drop fclose))) (c-type "FILE *"))
		(let stdout (shared-ref File))
		(let stderr (shared-ref File))
		(fn fputc (params (ch i32) (stream (shared-ref File))) (returns i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (call fputc 65i32 output))
			(let second (call fputc 97i32 errors))
			(if (bool.or (i32.not-eq first 65i32) (i32.not-eq second 97i32)) (then (return 1i32)))
			(return (call write_streams)))))
