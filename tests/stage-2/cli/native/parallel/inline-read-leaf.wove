(module native_parallel_inline_read_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-inline-read.h>" (only fixture_read (value fixture_input)))
	(bridge c-header "<native-inline-read.h>"
		(type Stream (:pragma (c_owned (drop fixture_close))) (c-type "struct fixture_stream *"))
		(let fixture_input (shared-ref Stream))
		(fn fixture_read (params (stream (shared-ref Stream))) (returns i32)))

	(fn read_leaf (params) (returns i32)
		(body (return (call fixture_read fixture_input)))))
