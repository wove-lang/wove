(module native_parallel_literal_array_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./literal-array-leaf.wove" (only verify_leaf))
	(use c-header "<native-literal-array.h>" (only (as fixture_fill fill)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.gt (array.len argv) 1i32)
				(then
					(let-mut short (array.repeat (array i32 1) -1i32))
					(return (call fill (borrow-mut short) -1i32))))
			(let-mut descriptors (array.repeat (array i32 3) -1i32))
			(if (i32.not-eqz (call fill (borrow-mut descriptors) 17i32)) (then (return 1i32)))
			(if (i32.not-eq (array.load descriptors 0i32) 18i32) (then (return 2i32)))
			(if (i32.not-eq (array.load descriptors 1i32) 19i32) (then (return 3i32)))
			(if (i32.not-eq (array.load descriptors 2i32) -1i32) (then (return 4i32)))
			(return (call verify_leaf)))))
