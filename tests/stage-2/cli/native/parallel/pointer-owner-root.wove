(module native_parallel_pointer_owner_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pointer-owner-leaf.wove" (only open_scoped))
	(use c-header "<native-pointer-owner.h>" (only (as fixture_open open_stream) fixture_stream_counts))

	(let path "native stream")
	(let absent "missing")
	(let mode "rb")

	(fn open_here
		(params (name (shared-array u8))) (returns bool)
		(body
			(let stream (call open_stream (borrow-shared name) (borrow-shared mode)))
			(return (bool.not (owner.is-null stream)))))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let bad (array.repeat (array u8 1) 0u8))
			(if (i32.eq (array.len argv) 2i32)
				(then
					(let invalid (call open_stream (borrow-shared bad) (borrow-shared mode)))
					(return 1i32)))
			(if (i32.eq (array.len argv) 3i32)
				(then
					(let invalid (call open_stream (borrow-shared path) (borrow-shared bad)))
					(return 2i32)))
			(if (bool.not (call open_scoped (borrow-shared path) (borrow-shared mode)))
				(then (return 3i32)))
			(if (i32.not-eq (call fixture_stream_counts) 101i32) (then (return 4i32)))
			(if (call open_here (borrow-shared absent)) (then (return 5i32)))
			(if (i32.not-eq (call fixture_stream_counts) 111i32) (then (return 6i32)))
			(if (bool.not (call open_here (borrow-shared path))) (then (return 7i32)))
			(if (i32.not-eq (call fixture_stream_counts) 212i32) (then (return 8i32)))
			(return 42i32))))
