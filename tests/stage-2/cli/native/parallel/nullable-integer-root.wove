(module native_parallel_nullable_integer_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./nullable-integer-leaf.wove" (only verify_status))
	(use c-header "<native-nullable-integer.h>" (only (type Child) (as fixture_wait wait_child)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let child (int:convert Child 29i32))
			(let waited (call wait_child child null 11i32))
			(if (i32:not-eq (int:convert i32 waited) 40i32) (then (return 1i32)))
			(return (call verify_status)))))
