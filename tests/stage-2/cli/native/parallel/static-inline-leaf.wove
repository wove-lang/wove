(module native_parallel_static_inline_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-static-inline.h>" (only (type Wide) fixture_identity32 fixture_identity64 fixture_swap32 fixture_swap64))
	(bridge c-header "<native-static-inline.h>"
		(type Wide (c-type "unsigned long long"))
		(fn fixture_identity16 (params (value u16)) (returns u16))
		(fn fixture_identity32 (params (value u32)) (returns u32))
		(fn fixture_identity64 (params (value Wide)) (returns Wide))
		(fn fixture_swap16 (params (value u16)) (returns u16))
		(fn fixture_swap32 (params (value u32)) (returns u32))
		(fn fixture_swap64 (params (value Wide)) (returns Wide)))

	(fn check_leaf (params (value u32) (wide u64)) (returns i32)
		(body
			(let native (int:convert Wide wide))
			(if (u32:not-eq (call fixture_identity32 value) value) (then (return 5i32)))
			(if (u64:not-eq (int:convert u64 (call fixture_identity64 native)) wide) (then (return 6i32)))
			(if (u32:not-eq (call fixture_swap32 value) 0x44332211u32) (then (return 7i32)))
			(if (u64:not-eq (int:convert u64 (call fixture_swap64 native)) 0x8877665544332211u64) (then (return 8i32)))
			(return 42i32))))
