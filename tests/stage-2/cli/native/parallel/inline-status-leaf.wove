(module native_parallel_inline_status_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-inline-status.h>" (only fixture_error (value fixture_status)))
	(bridge c-header "<native-inline-status.h>"
		(type Stream (:pragma (c_owned (drop fixture_close))) (c-type "struct fixture_stream *"))
		(let fixture_status (shared-ref Stream))
		(fn fixture_eof (params (stream (shared-ref Stream))) (returns i32))
		(fn fixture_error (params (stream (shared-ref Stream))) (returns i32))
		(fn fixture_flags (params (flags i32)) (returns void)))

	(fn read_error (params) (returns i32)
		(body (return (call fixture_error fixture_status)))))
