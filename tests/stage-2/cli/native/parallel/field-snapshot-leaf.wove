(module native_parallel_field_snapshot_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-field-snapshot.h>" (only (type Directory) fixture_open_directory fixture_read_entry))
	(bridge c-header "<native-field-snapshot.h>"
		(type Directory (:pragma (c_owned (drop fixture_close_directory))) (c-type "fixture_handle"))
		(fn fixture_open_directory (params (mode i32)) (returns Directory))
		(fn fixture_close_directory (params (directory Directory)) (returns i32))
		(fn fixture_read_entry
			(:pragma (c_snapshot cstr (field name) (extent extent)))
			(params (directory (mut-ref Directory)))
			(returns (optional (owned-array u8))))
		(fn fixture_directory_drops (params) (returns i32)))

	(fn verify_snapshots
		(params) (returns i32)
		(body
			(let-mut directory (call fixture_open_directory 0i32))
			(if (owner.is-null directory) (then (return 1i32)))
			(let first (call fixture_read_entry (borrow-mut directory)))
			(if (owner.is-null first) (then (return 2i32)))
			(let retained (move (optional.unwrap first)))
			(if (i32.not-eq (array.len retained) 9i32) (then (return 3i32)))
			(let second (call fixture_read_entry (borrow-mut directory)))
			(if (owner.is-null second) (then (return 4i32)))
			(let next (move (optional.unwrap second)))
			(if (i32.not-eq (array.len next) 4i32) (then (return 5i32)))
			(let eof (call fixture_read_entry (borrow-mut directory)))
			(if (bool.not (owner.is-null eof)) (then (return 6i32)))
			(if (bool.or (u8.not-eq (array.load retained 0i32) 108u8)
				(bool.or (u8.not-eq (array.load retained 4i32) 45u8) (u8.not-eq (array.load retained 8i32) 101u8)))
				(then (return 7i32)))
			(if (u8.not-eq (array.load next 0i32) 110u8) (then (return 8i32)))
			(return 0i32))))
