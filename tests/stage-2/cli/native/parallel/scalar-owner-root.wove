(module native_parallel_scalar_owner_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./scalar-owner-leaf.wove" (only adopt_here))
	(use c-header "<native-scalar-owner.h>" (only (type Descriptor) (as fixture_adopt adopt) fixture_stream_counts))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call adopt (int.convert Descriptor -1i32)))
			(if (bool.not (owner.is-null absent)) (then (return 1i32)))
			(if (i32.not-eq (call fixture_stream_counts) 10i32) (then (return 2i32)))
			(if (bool.not (call adopt_here (int.convert Descriptor 17i32))) (then (return 3i32)))
			(if (i32.not-eq (call fixture_stream_counts) 111i32) (then (return 4i32)))
			(return 42i32))))
