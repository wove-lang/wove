(module native_parallel_record_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./record-leaf.wove" (only calculate))
	(use c-header "<native-record.h>" (only (type (as Record RootRecord)) (type (as Detail RootDetail))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let detail (struct.new RootDetail (amount 39i32) (alternate_amount 1i32)))
			(let record (struct.new RootRecord (detail detail) (extra 2i32)))
			(return (call calculate record)))))
