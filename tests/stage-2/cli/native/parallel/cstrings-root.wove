(module native_parallel_cstrings_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./cstrings-leaf.wove" (only check_paths))
	(use c-header "<native-cstrings.h>" (only (type Mode) (as fixture_mkdir make_directory)))

	(let directory "d")
	(let missing "m")

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (int:convert Mode 416i32))
			(if (i32:not-eq (call make_directory (borrow-shared directory) mode) 23i32) (then (return 1i32)))
			(if (i32:not-eq (call make_directory (borrow-shared missing) mode) -1i32) (then (return 2i32)))
			(return (call check_paths (borrow-shared directory) (borrow-shared missing))))))
