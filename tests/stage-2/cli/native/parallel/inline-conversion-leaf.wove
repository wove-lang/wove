(module native_parallel_inline_conversion_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-inline-conversion.h>" (only fixture_as_long (value fixture_long_text)))
	(bridge c-header "<native-inline-conversion.h>"
		(type Text (:pragma (c_owned (drop fixture_drop_text))) (c-type "const char *"))
		(type Long (c-type "long"))
		(let fixture_negative_text (shared-ref Text))
		(let fixture_long_text (shared-ref Text))
		(fn fixture_as_int (params (text (shared-ref Text))) (returns i32))
		(fn fixture_as_long (params (text (shared-ref Text))) (returns Long)))

	(fn parsed_long (params) (returns i64)
		(body (return (int:convert i64 (call fixture_as_long fixture_long_text))))))
