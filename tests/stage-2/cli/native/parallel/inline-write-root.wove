(module native_parallel_inline_write_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./inline-write-leaf.wove" (only write_leaf))
	(use c-header "<native-inline-write.h>" (only fixture_write fixture_written (value fixture_output)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_write fixture_output 481i32) 225i32) (then (return 1i32)))
			(if (i32:not-eq (call write_leaf 90i32) 90i32) (then (return 2i32)))
			(if (i32:not-eq (call fixture_write fixture_output 387i32) 131i32) (then (return 3i32)))
			(if (i32:not-eq (call write_leaf 1i32) -1i32) (then (return 4i32)))
			(if (i32:not-eq (call fixture_written 0i32) 225i32) (then (return 5i32)))
			(if (i32:not-eq (call fixture_written 1i32) 90i32) (then (return 6i32)))
			(if (i32:not-eq (call fixture_written 2i32) 131i32) (then (return 7i32)))
			(if (i32:not-eq (call fixture_written 3i32) -1i32) (then (return 8i32)))
			(return 42i32))))
