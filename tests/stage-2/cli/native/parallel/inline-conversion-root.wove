(module native_parallel_inline_conversion_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./inline-conversion-leaf.wove" (only parsed_long))
	(use c-header "<native-inline-conversion.h>" (only fixture_as_int (value fixture_negative_text)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_as_int fixture_negative_text) -42i32) (then (return 1i32)))
			(if (i64:not-eq (call parsed_long) 123456789i64) (then (return 2i32)))
			(return 42i32))))
