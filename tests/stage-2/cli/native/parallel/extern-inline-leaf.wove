(module native_parallel_extern_inline_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-extern-inline.h>" (only fixture_forward))
	(bridge c-header "<native-extern-inline.h>"
		(fn fixture_forward (params (value i32)) (returns i32)))

	(fn forward_leaf (params) (returns i32)
		(body (return (call fixture_forward 20i32)))))
