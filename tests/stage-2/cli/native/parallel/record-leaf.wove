(module native_parallel_record_leaf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<native-record.h>" (only (type Record)))
	(bridge c-header "<native-record.h>"
		(struct Detail (c-type "struct fixture_detail") (fields (amount i32) (alternate_amount i32)))
		(struct Record (c-type "struct fixture_record") (fields (detail Detail) (extra i32))))

	(fn calculate (params (record Record)) (returns i32)
		(body
			(let detail (struct.get record detail))
			(return (i32.add (i32.add (struct.get detail amount) (struct.get detail alternate_amount))
				(struct.get record extra))))))
