(module check_graph_siblings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./parse.wove" (only broken))
	(use wove-file "./semantic.wove" (only rejected))
	(use wove-file "./valid.wove" (only (as value chosen)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan)))
		(returns i32) (body (return (call chosen))))
)
