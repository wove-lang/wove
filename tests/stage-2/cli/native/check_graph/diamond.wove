(module check_graph_diamond
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./left.wove" (only first))
	(use wove-file "./right.wove" (only second))
	(use wove-file "./semantic.wove" (only (as rejected chosen)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan)))
		(returns i32) (body (return (call chosen))))
)
