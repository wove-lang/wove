(module check_graph_selection
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./valid.wove" (only missing))
	(use wove-file "./parse.wove" (only broken))
	(use wove-file "./semantic.wove" (only (as rejected chosen)))
	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32) (body (return (call chosen))))
)
