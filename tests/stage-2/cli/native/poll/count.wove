(module poll_count
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<poll.h>" (only (type PollFd) (type PollCount) poll))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut descriptors (array.alloc PollFd 3i32))
			(let ignored (struct.new PollFd (fd -1i32)))
			(array.store descriptors 0i32 ignored)
			(array.store descriptors 1i32 ignored)
			(array.store descriptors 2i32 ignored)
			(return (call poll (borrow-mut (array.range descriptors 0i32 2i32))
				(int.convert PollCount 3i32) 0i32)))))
