(module poll_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type PollFd) (type PollCount) poll
		(value POLLERR) (value POLLHUP) (value POLLIN) (value POLLNVAL) (value POLLOUT) (value POLLPRI)))
	(use c-header "<unistd.h>" (only (type Size) pipe write close))
	(use c-header "./oracle.h" (only fixture_poll_events))
	(bridge c-header "./oracle.h"
		(fn fixture_poll_events
			(:pragma (c_array values 6))
			(params (values (shared-array i32))) (returns bool)))

	(let data "x")

	(fn exercise (params (reader i32) (writer i32)) (returns i32)
		(body
			(let-mut descriptors (array:alloc PollFd 2i32))
			(let events (int:convert i16 POLLIN))
			(let sentinel (struct:new PollFd (fd reader) (events events) (revents 99i16)))
			(array:store descriptors 0i32 sentinel)
			(array:store descriptors 1i32 (struct:new PollFd (fd -1i32) (revents 99i16)))
			(let full (int:convert PollCount (array:len descriptors)))
			(if (i32:not-eqz (call poll (borrow-mut descriptors) full 1i32))
				(then (return 3i32)))
			(if (bool:or (i16:not-eq (struct:get (array:load descriptors 0i32) revents) 0i16)
				(i16:not-eq (struct:get (array:load descriptors 1i32) revents) 0i16))
				(then (return 4i32)))
			(if (i64:not-eq (int:convert i64
				(call write writer (borrow-shared data) (int:convert Size (array:len data)))) 1i64)
				(then (return 5i32)))
			(let write_events (int:convert i16 POLLOUT))
			(array:store descriptors 1i32 (struct:new PollFd (fd writer) (events write_events) (revents 99i16)))
			(if (i32:not-eq (call poll (borrow-mut descriptors) (int:convert PollCount 1i32) 0i32) 1i32)
				(then (return 6i32)))
			(if (bool:or (i16:not-eq (struct:get (array:load descriptors 0i32) revents) events)
				(i16:not-eq (struct:get (array:load descriptors 1i32) revents) 99i16))
				(then (return 7i32)))
			(if (i32:not-eq (call poll (borrow-mut descriptors) full 0i32) 2i32)
				(then (return 8i32)))
			(let first (array:load descriptors 0i32))
			(let second (array:load descriptors 1i32))
			(if (bool:or (i16:not-eq (struct:get first revents) events)
				(i16:not-eq (struct:get second revents) write_events))
				(then (return 9i32)))
			(if (bool:or (i32:not-eq (struct:get first fd) reader) (i32:not-eq (struct:get second fd) writer))
				(then (return 10i32)))
			(if (bool:or (i16:not-eq (struct:get first events) events) (i16:not-eq (struct:get second events) write_events))
				(then (return 11i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let flags (array:new (array i32 6) POLLERR POLLHUP POLLIN POLLNVAL POLLOUT POLLPRI))
			(if (bool:not (call fixture_poll_events (borrow-shared flags))) (then (return 1i32)))
			(let-mut empty (array:alloc PollFd 0i32))
			(if (i32:not-eqz (call poll (borrow-mut empty) (int:convert PollCount 0i32) 0i32))
				(then (return 12i32)))
			(let-mut pipe_fds (array:new (array i32 2) -1i32 -1i32))
			(if (i32:not-eqz (call pipe (borrow-mut pipe_fds))) (then (return 2i32)))
			(let reader (array:load pipe_fds 0i32))
			(let writer (array:load pipe_fds 1i32))
			(let result (call exercise reader writer))
			(let closed_reader (call close reader))
			(let closed_writer (call close writer))
			(if (bool:or (i32:not-eqz closed_reader) (i32:not-eqz closed_writer)) (then (return 13i32)))
			(return result))))
