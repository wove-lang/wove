(module nullable_native_references
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type Key) (type Pair) fixture_remember fixture_probe))
	(bridge c-header "./fixture.h"
		(type Key (c-type "fixture_key"))
		(struct Pair (c-type "struct fixture_pair") (fields (tag u32)))
		(fn fixture_remember
			(:pragma (c_nullable key))
			(params (key (shared-ref Key)) (input (shared-ref Pair)) (output (shared-ref Pair)))
			(returns void))
		(fn fixture_probe
			(:pragma (c_nullable key input output))
			(params (key (shared-ref Key)) (input (shared-ref Pair)) (output (mut-ref Pair)))
			(returns i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:686"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let key (int.convert Key 4294967313u64))
			(let input (struct.new Pair (tag 31u32)))
			(let-mut output (struct.new Pair (tag 0u32)))
			(call fixture_remember (borrow-shared key) (borrow-shared input) (borrow-shared output))
			(if (i32.not-eq (call fixture_probe null null null) 0i32) (then (return 1i32)))
			(if (i32.not-eq (call fixture_probe (borrow-shared key) null null) 1i32) (then (return 2i32)))
			(if (i32.not-eq (call fixture_probe null (borrow-shared input) null) 2i32) (then (return 3i32)))
			(if (i32.not-eq (call fixture_probe (borrow-shared key) (borrow-shared input) null) 3i32)
				(then (return 4i32)))
			(if (u32.not-eqz (struct.get output tag)) (then (return 5i32)))
			(if (i32.not-eq (call fixture_probe null null (borrow-mut output)) 4i32) (then (return 6i32)))
			(if (i32.not-eq (call fixture_probe (borrow-shared key) null (borrow-mut output)) 5i32)
				(then (return 7i32)))
			(if (i32.not-eq (call fixture_probe null (borrow-shared input) (borrow-mut output)) 6i32)
				(then (return 8i32)))
			(if (i32.not-eq (call fixture_probe (borrow-shared key) (borrow-shared input) (borrow-mut output)) 7i32)
				(then (return 9i32)))
			(if (u32.not-eq (struct.get output tag) 77u32) (then (return 10i32)))
			(return 42i32))))
