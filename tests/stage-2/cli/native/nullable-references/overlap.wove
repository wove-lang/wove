(module nullable_native_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type Key) (type Pair) fixture_probe))
	(bridge c-header "./fixture.h"
		(type Key (c-type "fixture_key"))
		(struct Pair (c-type "struct fixture_pair") (fields (tag u32)))
		(fn fixture_probe
			(:pragma (c_nullable key input output))
			(params (key (shared-ref Key)) (input (shared-ref Pair)) (output (mut-ref Pair)))
			(returns i32)))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut pair (struct.new Pair (tag 0u32)))
			(return (call fixture_probe null (borrow-shared pair) (borrow-mut pair))))))
