(module nullable_native_unprojected
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type Empty) fixture_empty_probe))
	(bridge c-header "./fixture.h"
		(struct Empty (c-type "struct fixture_empty") (fields))
		(fn fixture_empty_probe
			(:pragma (c_nullable record))
			(params (record (shared-ref Empty)))
			(returns i32)))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_empty_probe null)))))
