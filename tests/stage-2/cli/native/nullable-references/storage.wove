(module nullable_native_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./storage.h" (only (type Storage) fixture_init fixture_probe fixture_drops))
	(bridge c-header "./storage.h"
		(type Storage
			(:pragma (c_owned (drop fixture_destroy) storage))
			(c-type "fixture_slot"))
		(fn fixture_init
			(:pragma (c_init storage))
			(params (storage (mut-ref Storage))) (returns i32))
		(fn fixture_destroy (params (storage Storage)) (returns i32))
		(fn fixture_probe
			(:pragma (c_nullable left right))
			(params (left (shared-ref Storage)) (right (shared-ref Storage))) (returns i32))
		(fn fixture_drops (params) (returns i32)))

	(fn verify
		(params (inactive bool)) (returns i32)
		(body
			(if (i32:not-eqz (call fixture_probe null null)) (then (return 1i32)))
			(let-mut storage (native:alloc Storage))
			(if inactive (then (return (call fixture_probe (borrow-shared storage) null))))
			(if (i32:not-eqz (call fixture_init (borrow-mut storage))) (then (return 2i32)))
			(if (i32:not-eq (call fixture_probe (borrow-shared storage) null) 1i32) (then (return 3i32)))
			(if (i32:not-eq (call fixture_probe null (borrow-shared storage)) 2i32) (then (return 4i32)))
			(if (i32:not-eq (call fixture_probe (borrow-shared storage) (borrow-shared storage)) 3i32)
				(then (return 5i32)))
			(return 42i32)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let status (call verify (i32:gt (array:len argv) 1i32)))
			(if (i32:not-eq status 42i32) (then (return status)))
			(if (i32:not-eq (call fixture_drops) 1i32) (then (return 6i32)))
			(return 42i32))))
