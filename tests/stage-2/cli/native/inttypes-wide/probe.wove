(module inttypes_wide_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./project.wove" (only))
	(use c-header "<stddef.h>" (only (type WChar)))
	(use c-header "<stdint.h>" (only (type IntMax) (type UIntMax)))
	(use c-header "<errno.h>" (only (value errno) EDOM))
	(use c-header "TEST_HEADER" (only wcstoimax wcstoumax))
	(use c-header "./oracle.h" (only fixture_signed fixture_unsigned))
	(bridge c-header "./oracle.h"
		(use c-header "<stdint.h>" (only (type IntMax) (type UIntMax)))
		(fn fixture_signed (params (test i32) (base i32) (result IntMax) (end i32) (error i32) (omitted bool)) (returns bool))
		(fn fixture_unsigned (params (test i32) (base i32) (result UIntMax) (end i32) (error i32) (omitted bool)) (returns bool)))

	(let absent " -?")
	(let partial " -0x2a!")
	(let complete "-42")
	(let small "-92233720368547758090!")
	(let partial_unsigned " +42!")
	(let complete_unsigned "52")
	(let large "184467440737095516160!")
	(let binary "0b101!")

	(fn widen (params (bytes (shared-array u8))) (returns (owned-array WChar))
		(body
			(let-mut input (array.alloc WChar (array.len bytes)))
			(let-mut index 0i32)
			(while (i32.lt index (array.len bytes))
				(body
					(array.store input index (int.convert WChar (array.load bytes index)))
					(set index (i32.inc index))))
			(return (move input))))

	(fn check_signed (params (text (shared-array u8)) (test i32) (base i32)) (returns bool)
		(body
			(let input (call widen (borrow-shared text)))
			(let-mut end -1i32)
			(set errno EDOM)
			(let full (call wcstoimax (borrow-shared input) (borrow-mut end) base))
			(let error errno)
			(if (bool.not (call fixture_signed test base full end error (bool false)))
				(then (return (bool false))))
			(set errno EDOM)
			(let omitted (call wcstoimax (borrow-shared input) null base))
			(return (call fixture_signed test base omitted -1i32 errno (bool true)))))

	(fn check_unsigned (params (text (shared-array u8)) (test i32) (base i32)) (returns bool)
		(body
			(let input (call widen (borrow-shared text)))
			(let-mut end -1i32)
			(set errno EDOM)
			(let full (call wcstoumax (borrow-shared input) (borrow-mut end) base))
			(let error errno)
			(if (bool.not (call fixture_unsigned test base full end error (bool false)))
				(then (return (bool false))))
			(set errno EDOM)
			(let omitted (call wcstoumax (borrow-shared input) null base))
			(return (call fixture_unsigned test base omitted -1i32 errno (bool true)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_signed (borrow-shared absent) 0i32 0i32)) (then (return 1i32)))
			(if (bool.not (call check_signed (borrow-shared partial) 1i32 0i32)) (then (return 2i32)))
			(if (bool.not (call check_signed (borrow-shared complete) 2i32 10i32)) (then (return 3i32)))
			(if (bool.not (call check_signed (borrow-shared small) 3i32 10i32)) (then (return 4i32)))
			(if (bool.not (call check_signed (borrow-shared binary) 4i32 0i32)) (then (return 5i32)))
			(if (bool.not (call check_unsigned (borrow-shared absent) 0i32 0i32)) (then (return 6i32)))
			(if (bool.not (call check_unsigned (borrow-shared partial_unsigned) 1i32 10i32)) (then (return 7i32)))
			(if (bool.not (call check_unsigned (borrow-shared complete_unsigned) 2i32 10i32)) (then (return 8i32)))
			(if (bool.not (call check_unsigned (borrow-shared large) 3i32 10i32)) (then (return 9i32)))
			(if (bool.not (call check_unsigned (borrow-shared binary) 4i32 0i32)) (then (return 10i32)))
			(return 42i32))))
