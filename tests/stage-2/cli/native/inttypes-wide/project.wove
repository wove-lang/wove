(module inttypes_wide_project
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(use c-header "<stddef.h>" (only (type WChar)))
		(use c-header "<stdint.h>" (only (type IntMax) (type UIntMax)))
		(fn wcstoimax
			(:pragma (c_terminated_array input) (c_terminated_array_offset end input))
			(params (input (shared-array WChar)) (end (mut-ref i32)) (base i32))
			(returns IntMax))
		(fn wcstoumax
			(:pragma (c_terminated_array input) (c_terminated_array_offset end input))
			(params (input (shared-array WChar)) (end (mut-ref i32)) (base i32))
			(returns UIntMax))))
