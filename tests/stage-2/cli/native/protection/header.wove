(module protected_header
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "protected-value.h"
		(fn fixture_value (params) (returns i32)))
	(use c-header "protected-value.h" (only fixture_value))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (call fixture_value)))))
