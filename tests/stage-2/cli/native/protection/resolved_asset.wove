(module retained_asset
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn first (params (data (shared-slice u8))) (returns i32)
		(body (return (int.convert i32 (slice.load (local data) 0i32)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let payload (embed "asset-tree/bin/payload.bin"))
			(return (call first (borrow-shared (local payload)))))))
