(module retained_asset
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let payload (embed "asset-tree/bin/payload.bin"))

	(fn first (params (data (shared-array u8))) (returns i32)
		(body (return (int:convert i32 (array:load data 0i32)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (call first (borrow-shared payload))))))
