(module retained_asset
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn first (params (data (shared-array u8))) (returns i32)
		(body (return (int.convert i32 (array.load (local data) 0i32)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let payload (embed "build/.wovec-cache/default/input/bin/payload.bin"))
			(return (call first (borrow-shared (local payload)))))))
