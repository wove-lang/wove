(module selected_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only puts))
	(use (:pragma (cfg test)) c-header "<inactive.h>" (only missing))
	(use c-header "<math.h>" (only fabs))
	(use c-header "<stdio.h>" (only EOF))

	(let message "selected libc")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call puts (borrow-shared message)))
			(if (i32.eq result EOF) (then (return 1i32)))
			(return 42i32))))
