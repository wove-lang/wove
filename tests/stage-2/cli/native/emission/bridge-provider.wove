(module bridge_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./mode.h"
		(use c-header "<stddef.h>" (only))
		(use c-header "<sys/stat.h>" (only (type Mode)))
		(let FIXTURE_MODE (:pragma (c_macro)) Mode)))
