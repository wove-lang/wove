{
	"profiles": [
		{
			"name": "default",
			"build": { "default": { "cflags": ["-I.", "--target=arm64-apple-macos", "-mmacosx-version-min=26.4"] } },
		},
		{ "name": "arm-old", "build": { "default": { "cflags": ["--target=arm64-apple-macos26.3"] } } },
		{ "name": "x86-old", "build": { "default": { "cflags": ["--target=x86_64-apple-macos26.3"] } } },
		{ "name": "x86-new", "build": { "default": { "cflags": ["-I.", "--target=x86_64-apple-macos26.4"] } } },
		{
			"name": "frontend-override",
			"build": { "default": { "cflags": ["--target=arm64-apple-macos26.4", "-Xclang", "-triple", "-Xclang", "arm64-apple-macosx26.3", "-I."] } },
		},
		{ "name": "unknown", "build": { "default": { "cflags": ["--target=x86_64-unknown-linux-gnu"] } } },
	],
}
