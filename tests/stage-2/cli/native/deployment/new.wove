(module newer_deployment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./version.h" (only native_version_result))
	(bridge c-header "./version.h"
		(fn native_version_result (:pragma (c_optional)) (params) (returns i32)))

	(fn version_result (params) (returns i32)
		(body (return (call native_version_result)))))
