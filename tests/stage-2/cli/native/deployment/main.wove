(module deployment_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (all (os "macos") (os_min 260400)))) wove-file "./new.wove" (only version_result))
	(use (:pragma (cfg (all (os "macos") (os_max 260399)))) wove-file "./old.wove" (only version_result))
	(use (:pragma (cfg (all (not (os_min 260400)) (not (os_max 260399))))) wove-file "./unknown.wove" (only version_result))

	(fn main
		(:expect (issues "gh:wove-lang/wove:535"))
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return (call version_result)))))
