(module bundled_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only (type Long) (as getchar read_byte) putchar))

	(fn keep_position (params (position Long)) (returns Long)
		(body (return position)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let byte (call read_byte))
			(if (i32.eq byte (i32 -1)) (then (return (i32 42))))
			(return (i32 1)))))
