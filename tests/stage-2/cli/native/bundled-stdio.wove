(module bundled_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only (type Long) (as getchar read_byte) putchar))

	(fn keep_position (params (position Long)) (returns Long)
		(body (return (local position))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let byte (call read_byte))
			(if (i32.eq (local byte) (i32 -1)) (then (return (i32 42))))
			(return (i32 1)))))
