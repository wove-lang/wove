(module statvfs_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (type StatVfs) (type FsBlockCount) (type FsFileCount) (type StatVfsWord)
			statvfs fstatvfs ST_RDONLY ST_NOSUID))
	(use c-header "<fcntl.h>" (only (type Mode) open O_RDONLY))
	(use c-header "<unistd.h>" (only close))
	(use c-header "./oracle.h" (only fixture_stable_fields fixture_counts fixture_words fixture_seed fixture_failures fixture_flags))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type StatVfs) (type FsBlockCount) (type FsFileCount) (type StatVfsWord)))
		(fn fixture_stable_fields
			(params (fd i32) (path (shared-ref StatVfs)) (descriptor (shared-ref StatVfs)))
			(returns bool))
		(fn fixture_counts
			(params (data (shared-ref StatVfs)) (f_blocks FsBlockCount) (f_bfree FsBlockCount) (f_bavail FsBlockCount)
				(f_files FsFileCount) (f_ffree FsFileCount) (f_favail FsFileCount))
			(returns bool))
		(fn fixture_words
			(params (data (shared-ref StatVfs)) (f_bsize StatVfsWord) (f_frsize StatVfsWord)
				(f_fsid StatVfsWord) (f_flag StatVfsWord) (f_namemax StatVfsWord))
			(returns bool))
		(fn fixture_seed (params (data (mut-ref StatVfs))) (returns void))
		(fn fixture_failures (params (path_status i32) (fd_status i32)) (returns bool))
		(fn fixture_flags (params (read_only i32) (no_suid i32)) (returns bool)))

	(let cwd ".")
	(let missing "wove-statvfs-missing")

	(fn projections (params (data (shared-ref StatVfs))) (returns bool)
		(body
			(return (bool.and
				(call fixture_counts (borrow-shared data)
					(struct.get data f_blocks) (struct.get data f_bfree) (struct.get data f_bavail)
					(struct.get data f_files) (struct.get data f_ffree) (struct.get data f_favail))
				(call fixture_words (borrow-shared data) (struct.get data f_bsize) (struct.get data f_frsize)
					(struct.get data f_fsid) (struct.get data f_flag) (struct.get data f_namemax))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let fd (call open (borrow-shared cwd) O_RDONLY (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 1i32)))
			(let-mut path_info (struct.new StatVfs))
			(let-mut fd_info (struct.new StatVfs))
			(let path_status (call statvfs (borrow-shared cwd) (borrow-mut path_info)))
			(let fd_status (call fstatvfs fd (borrow-mut fd_info)))
			(let stable (bool.and (bool.and (i32.eqz path_status) (i32.eqz fd_status))
				(call fixture_stable_fields fd (borrow-shared path_info) (borrow-shared fd_info))))
			(let closed (call close fd))
			(if (bool.not (bool.and stable (i32.eqz closed))) (then (return 2i32)))
			(if (bool.not (bool.and (call projections (borrow-shared path_info))
				(call projections (borrow-shared fd_info)))) (then (return 3i32)))
			(let-mut seeded (struct.new StatVfs))
			(call fixture_seed (borrow-mut seeded))
			(if (bool.not (call projections (borrow-shared seeded))) (then (return 6i32)))
			(let path_failure (call statvfs (borrow-shared missing) (borrow-mut path_info)))
			(let fd_failure (call fstatvfs -1i32 (borrow-mut fd_info)))
			(if (bool.not (call fixture_failures path_failure fd_failure)) (then (return 4i32)))
			(if (bool.not (call fixture_flags ST_RDONLY ST_NOSUID)) (then (return 5i32)))
			(return 42i32))))
