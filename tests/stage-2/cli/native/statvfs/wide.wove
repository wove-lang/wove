(module statvfs_largefile
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type StatVfs64) (type FsBlockCount64) (type FsFileCount64)
		statvfs64 fstatvfs64))
	(use c-header "<fcntl.h>" (only (type Mode) open O_RDONLY))
	(use c-header "<unistd.h>" (only close))
	(use c-header "./oracle.h" (only fixture_wide_counts))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type StatVfs64) (type FsBlockCount64) (type FsFileCount64)))
		(fn fixture_wide_counts
			(params (fd i32) (path (shared-ref StatVfs64)) (descriptor (shared-ref StatVfs64))
				(blocks FsBlockCount64) (files FsFileCount64))
			(returns bool)))

	(let cwd ".")
	(let missing "wove-statvfs-missing")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let fd (call open (borrow-shared cwd) O_RDONLY (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 1i32)))
			(let-mut path_info (struct.new StatVfs64))
			(let-mut fd_info (struct.new StatVfs64))
			(let path_status (call statvfs64 (borrow-shared cwd) (borrow-mut path_info)))
			(let fd_status (call fstatvfs64 fd (borrow-mut fd_info)))
			(let matched (bool.and (bool.and (i32.eqz path_status) (i32.eqz fd_status))
				(call fixture_wide_counts fd (borrow-shared path_info) (borrow-shared fd_info)
					(struct.get path_info f_blocks) (struct.get fd_info f_files))))
			(let closed (call close fd))
			(if (bool.not (bool.and matched (i32.eqz closed))) (then (return 2i32)))
			(if (i32.not-eq (call statvfs64 (borrow-shared missing) (borrow-mut path_info)) -1i32)
				(then (return 3i32)))
			(if (i32.not-eq (call fstatvfs64 -1i32 (borrow-mut fd_info)) -1i32)
				(then (return 4i32)))
			(return 42i32))))
