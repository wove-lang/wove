(module escaping_error_callback_path
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./error.h" (only fixture_error fixture_retain_error_path))
	(bridge c-header "./error.h"
		(fn fixture_error (:pragma (c_callback_sync report) (c_nullable report))
			(params (report (fn-type (params c-cstr i32) (returns i32)))) (returns i32))
		(fn fixture_retain_error_path (:pragma (c_static_cstr path))
			(params (path (shared-array u8))) (returns i32)))

	(fn report_error (params (path (shared-array u8)) (error i32)) (returns i32)
		(body (return (call fixture_retain_error_path (borrow-shared path)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_error (fn-ref report_error))))))
