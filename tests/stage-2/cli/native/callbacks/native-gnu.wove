(module native_gnu_walk_callback_actions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<ftw.h>" (only (type Status) (type Walk) nftw FTW_ACTIONRETVAL FTW_CONTINUE FTW_STOP FTW_SKIP_SUBTREE))
	(bridge c-header "<ftw.h>" (:pragma (cfg (os "linux")))
		(const FTW_ACTIONRETVAL i32)
		(const FTW_CONTINUE i32)
		(const FTW_STOP i32)
		(const FTW_SKIP_SUBTREE i32)
		(struct Status (c-type "struct stat") (fields (st_size i64)))
		(struct Walk (c-type "struct FTW") (fields (base i32) (level i32)))
		(fn nftw (:pragma (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat FTW_NS) i32
					(c-mut-record FTW)) (returns i32)))
				(descriptors i32) (flags i32))
			(returns i32)))

	(let root "walk-root")

	(fn skip_root (:pragma (cfg (os "linux")))
		(params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32) (position (shared-ref Walk)))
		(returns i32)
		(body
			(if (i32:eqz (struct:get position level)) (then (return FTW_SKIP_SUBTREE)))
			(return FTW_STOP)))

	(fn stop_on_leaf (:pragma (cfg (os "linux")))
		(params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32) (position (shared-ref Walk)))
		(returns i32)
		(body
			(if (i32:eqz (struct:get position level)) (then (return FTW_CONTINUE)))
			(return FTW_STOP)))

	(fn check_native (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32:not-eqz (call nftw (borrow-shared root) (fn-ref skip_root) 2i32 FTW_ACTIONRETVAL))
				(then (return 109i32)))
			(if (i32:not-eq (call nftw (borrow-shared root) (fn-ref stop_on_leaf) 2i32 FTW_ACTIONRETVAL) FTW_STOP)
				(then (return 110i32)))
			(return 42i32)))

	(fn check_native (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_native)))))
