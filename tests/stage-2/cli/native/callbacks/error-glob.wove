(module native_glob_error_callback
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./error-glob.h" (only fixture_glob_error fixture_loop_error))
	(bridge c-header "./error-glob.h"
		(fn fixture_glob_error (:pragma (c_callback_sync report) (c_nullable report))
			(params (report (fn-type (params c-cstr i32) (returns i32)))) (returns i32))
		(fn fixture_loop_error (params) (returns i32)))

	(let directory "loop")

	(fn report_error (params (path (shared-array u8)) (error i32)) (returns i32)
		(body
			(if (i32:not-eq error (call fixture_loop_error)) (then (return 0i32)))
			(let length (array:len path))
			(if (bool:or (i32:lt length 4i32) (i32:gt length 5i32)) (then (return 0i32)))
			(if (bool:and (i32:eq length 5i32) (u8:not-eq (array:get path 4i32) 47u8))
				(then (return 0i32)))
			(for (let index) (range 0i32 4i32)
				(body
					(if (u8:not-eq (array:get path index) (array:get directory index))
						(then (return 0i32)))))
			(return 1i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_glob_error (fn-ref report_error))))))
