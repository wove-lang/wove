(module native_large_file_walk_callbacks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<ftw.h>" (only (type Status) (type Walk) ftw64 nftw64 FTW_F FTW_D FTW_PHYS))
	(bridge c-header "<ftw.h>" (:pragma (cfg (os "linux")))
		(const FTW_F i32)
		(const FTW_D i32)
		(const FTW_PHYS i32)
		(struct Status (c-type "struct stat64") (fields (st_size i64)))
		(struct Walk (c-type "struct FTW") (fields (base i32) (level i32)))
		(fn ftw64 (:pragma (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat64 FTW_NS) i32) (returns i32)))
				(descriptors i32))
			(returns i32))
		(fn nftw64 (:pragma (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat64 FTW_NS) i32
					(c-mut-record FTW)) (returns i32)))
				(descriptors i32) (flags i32))
			(returns i32)))

	(let root "walk-root")

	(fn visit (:pragma (cfg (os "linux"))) (params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32)) (returns i32)
		(body
			(if (optional.is-none (local status)) (then (return 100i32)))
			(if (i32.eq (local kind) (local FTW_D))
				(then
					(if (i32.not-eq (array.len (local path)) (array.len (local root))) (then (return 101i32)))
					(return 0i32)))
			(let info (optional.unwrap (local status)))
			(if (bool.or (i32.not-eq (local kind) (local FTW_F)) (i64.not-gtz (struct.get (local info) st_size)))
				(then (return 102i32)))
			(return 77i32)))

	(fn visit_nftw (:pragma (cfg (os "linux")))
		(params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32) (position (shared-ref Walk)))
		(returns i32)
		(body
			(if (i32.eq (local kind) (local FTW_D))
				(then
					(if (bool.or (i32.not-eqz (struct.get (local position) level)) (i32.not-eqz (struct.get (local position) base)))
						(then (return 103i32)))
					(return (call visit (borrow-shared (local path)) (local status) (local kind)))))
			(let base (struct.get (local position) base))
			(if (bool.or (i32.not-eq (struct.get (local position) level) 1i32)
				(i32.not-eq (local base) (i32.inc (array.len (local root)))))
				(then (return 104i32)))
			(if (u8.not-eq (array.load (local path) (local base)) 108u8) (then (return 105i32)))
			(if (i32.not-eq (call visit (borrow-shared (local path)) (local status) (local kind)) 77i32)
				(then (return 106i32)))
			(return 78i32)))

	(fn check_native (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32.not-eq (call ftw64 (borrow-shared (local root)) (fn-ref visit) 2i32) 77i32) (then (return 107i32)))
			(if (i32.not-eq (call nftw64 (borrow-shared (local root)) (fn-ref visit_nftw) 2i32 (local FTW_PHYS)) 78i32)
				(then (return 108i32)))
			(return 42i32)))

	(fn check_native (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_native)))))
