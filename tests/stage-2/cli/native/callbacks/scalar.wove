(module synchronous_callback_probe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_invoke))
	(bridge c-header "./native.h"
		(fn fixture_invoke (:pragma (c_callback_sync callback))
			(params (callback (fn-type (params i32) (returns i32)))) (returns i32)))

	(fn visit (params (value i32)) (returns i32)
		(body (return (i32.inc value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_invoke (fn-ref visit))))))
