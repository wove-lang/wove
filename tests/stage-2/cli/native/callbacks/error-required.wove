(module required_error_callback
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./error.h" (only fixture_error))
	(bridge c-header "./error.h"
		(fn fixture_error (:pragma (c_callback_sync report))
			(params (report (fn-type (params c-cstr i32) (returns i32)))) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_error null)))))
