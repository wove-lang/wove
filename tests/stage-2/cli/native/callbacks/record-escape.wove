(module synchronous_callback_record_escape
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./walk.h" (only (type Status) (type Walk) fixture_extended))
	(bridge c-header "./walk.h"
		(struct Status (c-type "struct fixture_status") (fields (value i32)))
		(struct Walk (c-type "struct fixture_walk") (fields (base i32) (level i32)))
		(fn fixture_extended (:pragma (c_cstr root) (c_callback_sync receiver))
			(params (root (shared-array u8))
				(receiver (fn-type (params c-cstr (c-optional-record fixture_status FIXTURE_NO_STATUS) i32
					(c-mut-record fixture_walk)) (returns i32))))
			(returns i32)))

	(let root "root")

	(fn visit (params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32) (walk (shared-ref Walk)))
		(returns (shared-ref Walk) (from walk))
		(body (return (local walk))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_extended (borrow-shared (local root)) (fn-ref visit))))))
