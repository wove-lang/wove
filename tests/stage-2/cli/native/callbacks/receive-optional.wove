(module synchronous_callback_record_option_probe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only (type Entry) opendir next closedir))
	(bridge c-header "<dirent.h>"
		(type (:pragma (c_owned (drop closedir))) Directory (c-type "DIR *"))
		(struct Entry (c-type "struct dirent") (fields (d_reclen u16)))
		(fn opendir (:pragma (c_cstr path))
			(params (path (shared-array u8))) (returns Directory))
		(fn next (c-name "readdir") (params (directory (mut-ref Directory)))
			(returns (optional (shared-ref Entry)) (from directory)))
		(fn closedir (params (directory Directory)) (returns i32)))

	(let path ".")

	(fn consumed (params (status (optional (shared-ref Entry)))) (returns i32)
		(body
			(if (optional.is-none status) (then (return 0i32)))
			(let entry (optional.unwrap status))
			(if (u16.eqz (struct.get entry d_reclen)) (then (return 2i32)))
			(return 1i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared path)))
			(if (owner.is-null directory) (then (return 3i32)))
			(let-mut seen (bool false))
			(while (bool true)
				(body
					(let loan (call next (borrow-mut directory)))
					(let state (call consumed loan))
					(if (i32.eqz state) (then (break)))
					(if (i32.not-eq state 1i32) (then (return 4i32)))
					(set seen (bool true))))
			(if (bool.not seen) (then (return 5i32)))
			(if (i32.not-eq (call closedir (move directory)) 0i32) (then (return 6i32)))
			(return 42i32))))
