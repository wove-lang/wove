(module synchronous_error_callback
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./error.h" (only fixture_error fixture_original_error_path))
	(bridge c-header "./error.h"
		(fn fixture_error (:pragma (c_callback_sync report) (c_nullable report))
			(params (report (fn-type (params c-cstr i32) (returns i32)))) (returns i32))
		(fn fixture_original_error_path (:pragma (c_bytes path length))
			(params (path (shared-array u8)) (length i32)) (returns bool)))

	(fn report_error (params (path (shared-array u8)) (error i32)) (returns i32)
		(body
			(if (bool:not (call fixture_original_error_path (borrow-shared path) (array:len path)))
				(then (return 92i32)))
			(if (u8:not-eq (array:load path 2i32) 255u8) (then (return 93i32)))
			(if (i32:eq error -13i32) (then (return -21i32)))
			(if (i32:eq error 13i32) (then (return 42i32)))
			(return 94i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_error null) 17i32) (then (return 91i32)))
			(return (call fixture_error (fn-ref report_error))))))
