(module synchronous_borrowed_callback_probe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./walk.h" (only (type Status) (type Walk) fixture_original fixture_direct fixture_extended))
	(bridge c-header "./walk.h"
		(struct Status (c-type "struct\tfixture_status") (fields (value i32)))
		(struct Walk (c-type "  struct fixture_walk  ") (fields (base i32) (level i32)))
		(fn fixture_original (:pragma (c_bytes path length))
			(params (path (shared-array u8)) (length i32)) (returns bool))
		(fn fixture_direct (:pragma (c_callback_sync receiver))
			(params (receiver (fn-type (params c-cstr (c-optional-record fixture_status FIXTURE_NO_STATUS) i32) (returns i32))))
			(returns i32))
		(fn fixture_extended (:pragma (c_cstr root) (c_callback_sync receiver))
			(params (root (shared-array u8))
				(receiver (fn-type (params c-cstr (c-optional-record fixture_status FIXTURE_NO_STATUS) i32
					(c-mut-record fixture_walk)) (returns i32))))
			(returns i32)))

	(let root "root")

	(fn read_status (params (status (optional (shared-ref Status)))) (returns i32)
		(body
			(if (optional:is-none status) (then (return -1i32)))
			(let value (optional:unwrap status))
			(return (struct:get value value))))

	(fn read_path (params (path (shared-array u8))) (returns bool)
		(body
			(return (bool:and (i32:eq (array:len path) 3i32)
				(bool:and (u8:eq (array:get path 2i32) 255u8)
					(call fixture_original (borrow-shared path) (array:len path)))))))

	(fn visit (params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32)) (returns i32)
		(body
			(if (bool:or (i32:not-eqz kind) (bool:not (call read_path (borrow-shared path))))
				(then (return 90i32)))
			(return (call read_status status))))

	(fn visit_walk
		(params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32) (position (shared-ref Walk)))
		(returns i32)
		(body
			(if (bool:or (i32:not-eq (struct:get position base) 2i32)
				(bool:not (call read_path (borrow-shared path))))
				(then (return 91i32)))
			(let value (call read_status status))
			(if (i32:eqz kind)
				(then
					(if (bool:or (i32:not-eq value 20i32) (i32:not-eqz (struct:get position level)))
						(then (return 92i32)))
					(return 11i32)))
			(if (i32:eq (struct:get position level) 1i32)
				(then
					(if (i32:not-eq value -1i32) (then (return 93i32)))
					(return 0i32)))
			(if (bool:or (i32:not-eq kind 1i32) (i32:not-eq (struct:get position level) 2i32))
				(then (return 94i32)))
			(return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_direct (fn-ref visit)) 42i32)
				(then (return 95i32)))
			(return (call fixture_extended (borrow-shared root) (fn-ref visit_walk))))))
