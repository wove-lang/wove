(module synchronous_callback_path_escape
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./walk.h" (only (type Status) fixture_direct fixture_retain))
	(bridge c-header "./walk.h"
		(struct Status (c-type "struct fixture_status") (fields (value i32)))
		(fn fixture_direct (:pragma (c_callback_sync receiver))
			(params (receiver (fn-type (params c-cstr (c-optional-record fixture_status FIXTURE_NO_STATUS) i32) (returns i32))))
			(returns i32))
		(fn fixture_retain (:pragma (c_static_cstr path))
			(params (path (shared-array u8))) (returns i32)))

	(fn visit (params (path (shared-array u8)) (status (optional (shared-ref Status))) (kind i32)) (returns i32)
		(body (return (call fixture_retain (borrow-shared (local path))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_direct (fn-ref visit))))))
