	(fn apply (params (f (fn-type (params i32) (returns i32)))) (returns i32)
		(body (return (call-value f 41i32))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call apply (fn-ref missing)))))
)
