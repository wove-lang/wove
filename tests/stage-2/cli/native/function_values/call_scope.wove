(module call_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(type Unary (fn-type (params i32) (returns i32)))

	(fn step (params (value i32)) (returns i32)
		(body (return (i32:inc value))))

	(fn plus_two (params (value i32)) (returns i32)
		(body (return (i32:add value 2i32))))

	(fn plus_thirteen (params (value i32)) (returns i32)
		(body (return (i32:add value 13i32))))

	(fn apply (params (step Unary) (value i32)) (returns i32)
		(body (return (call step value))))

	(fn twice_through (generic (fn Operation)) (params (value i32)) (returns i32)
		(body
			(let before (call Operation value))
			(if (bool true)
				(then
					(let Operation (fn-ref plus_thirteen))
					(if (i32:not-eq (call Operation value) (i32:add value 13i32))
						(then (return 1i32)))))
			(return (call Operation before))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let step (i32:add (call step 10i32) 0i32))
			(let-mut result step)
			(if (bool true)
				(then
					(let step (fn-ref plus_two))
					(set result (call step result))
					(if (bool true)
						(then
							(let step (fn-ref plus_thirteen))
							(set result (call step result))))
					(set result (call step result))))
			(let explicit (call apply (fn-ref step) result))
			(if (i32:not-eq (call apply (fn-ref plus_thirteen) explicit) 42i32)
				(then (return 2i32)))
			(return (call (specialize twice_through step) 40i32)))))
