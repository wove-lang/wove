(module binding_spellings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdlib.h>" (only realpath))
	(let null ".")

	(fn step (params (value i32)) (returns i32)
		(body (return (i32:add value 17i32))))

	(fn finish (params (value i32)) (returns i32)
		(body (return (i32:add value 25i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let path (call realpath (borrow-shared null) null))
			(if (owner:is-null path) (then (return 1i32)))
			(let true (call step 0i32))
			(let step (fn-ref finish))
			(return (call step true)))))
