(module function_dispatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only (as increment increase)))
	(use c-header "<stdio.h>" (only putchar))

	(fn decrement (params (value i32)) (returns i32)
		(body (return (i32.dec value))))

	(fn apply (params (f (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call-value f value))))

	(fn forward (params (operation (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call apply operation value))))

	(fn next (params (state (mut-ref i32))) (returns i32)
		(body
			(set state (i32.inc state))
			(return state)))

	(fn digits (params (tens i32) (ones i32)) (returns i32)
		(body (return (i32.add (i32.mul tens 10i32) ones))))

	(fn mark (params) (returns void)
		(body
			(let written (call putchar 42i32))
			(if (i32.not-eq written 42i32) (then (return)))))

	(fn run_action (params (action (fn-type (params) (returns void)))) (returns void)
		(body (call-value action)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut pass 0i32)
			(let-mut total 0i32)
			(while (i32.lt pass 2i32)
				(body
					(let op (if (i32.eqz pass)
						(then (fn-ref increase))
						(else (fn-ref decrement))))
					(set total (i32.add total (call forward op 15i32)))
					(set pass (i32.inc pass))))
			(let ordered (fn-ref digits))
			(let-mut counter 0i32)
			(let value (call-value ordered
				(call next (borrow-mut counter))
				(call next (borrow-mut counter))))
			(if (i32.not-eq counter 2i32) (then (return 1i32)))
			(call run_action (fn-ref mark))
			(return (i32.add total value))))
)
