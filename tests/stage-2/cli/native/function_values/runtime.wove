(module function_dispatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only (as increment increase)))
	(use c-header "<stdio.h>" (only putchar))

	(fn decrement (params (value i32)) (returns i32)
		(body (return (i32.dec (local value)))))

	(fn apply (params (f (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call (local f) (local value)))))

	(fn forward (params (operation (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call apply (local operation) (local value)))))

	(fn next (params (state (mut-ref i32))) (returns i32)
		(body
			(set (local state) (i32.inc (local state)))
			(return (local state))))

	(fn digits (params (tens i32) (ones i32)) (returns i32)
		(body (return (i32.add (i32.mul (local tens) 10i32) (local ones)))))

	(fn mark (params) (returns void)
		(body
			(let written (call putchar 42i32))
			(if (i32.not-eq (local written) 42i32) (then (return)))))

	(fn run_action (params (action (fn-type (params) (returns void)))) (returns void)
		(body (call (local action))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut pass 0i32)
			(let-mut total 0i32)
			(while (i32.lt (local pass) 2i32)
				(body
					(let op (if (i32.eqz (local pass))
						(then (fn-ref increase))
						(else (fn-ref decrement))))
					(set (local total) (i32.add (local total) (call forward (local op) 15i32)))
					(set (local pass) (i32.inc (local pass)))))
			(let ordered (fn-ref digits))
			(let-mut counter 0i32)
			(let value (call (local ordered)
				(call next (borrow-mut (local counter)))
				(call next (borrow-mut (local counter)))))
			(if (i32.not-eq (local counter) 2i32) (then (return 1i32)))
			(call run_action (fn-ref mark))
			(return (i32.add (local total) (local value)))))
)
