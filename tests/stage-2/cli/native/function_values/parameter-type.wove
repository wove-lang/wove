(module parameter_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn apply (params (f (fn-type (params i32) (returns i32)))) (returns i32)
		(body (return (call-value f 41i32))))
	(fn unsigned (params (value u32)) (returns i32)
		(body (return (i32.from-u32 value))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call apply (fn-ref unsigned)))))
)
