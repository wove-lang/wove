(module result_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn apply (params (f (fn-type (params i32) (returns i32)))) (returns i32)
		(body (return (call (local f) 41i32))))
	(fn test (params (value i32)) (returns bool)
		(body (return (i32.eqz (local value)))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call apply (fn-ref test)))))
)
