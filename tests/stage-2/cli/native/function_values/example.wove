(module example
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn apply (params (f (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call f value))))
	(fn increment (params (value i32)) (returns i32)
		(body (return (i32.inc value))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call apply (fn-ref increment) 41i32))))
)
