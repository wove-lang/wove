(module checked_record_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (type Group) (type Size) fixture_group consume_group))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (i32:dec (array:len args)))
			(let-mut entry (struct:new Group (gid 0u32)))
			(let-mut scratch (array:alloc u8 128i32))
			(let-mut status 99i32)
			(let result (call fixture_group mode (borrow-mut entry) (borrow-mut scratch)
				(int:convert Size 96i32) (borrow-mut status)))
			(if (bool:or (i32:not-eqz status) (optional:is-none result)) (then (return 2i32)))
			(let group (optional:unwrap result))
			(let name (struct:get group name))
			(let password (struct:get group password))
			(let members (struct:get group members))
			(if (i32:not-eq (array:len name) 4i32) (then (return 3i32)))
			(if (i32:not-eq (array:len password) 8i32) (then (return 4i32)))
			(if (i32:not-eq (native:cstrs-len members) 1i32) (then (return 5i32)))
			(if (i32:eq mode 8i32)
				(then (return (call consume_group (borrow-shared group)))))
			(let-mut index 0i32)
			(if (i32:eq mode 9i32) (then (set index 1i32)))
			(let member (native:cstrs-load members index))
			(if (i32:not-eq (array:len member) 3i32) (then (return 6i32)))
			(return 42i32))))
