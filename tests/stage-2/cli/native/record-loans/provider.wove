(module loan_fixture_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./fixture.h"
		(type Size (c-type "size_t"))
		(struct Group (c-type "struct loan_group")
			(fields (gid u32) (name cstr) (password cstr) (members cstrs)))
		(fn fixture_group (:pragma (c_bytes buffer length) (c_record_out buffer status))
			(params (mode i32) (record (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from record)))
		(fn consume_group (params (group (shared-ref Group))) (returns i32)))
)
