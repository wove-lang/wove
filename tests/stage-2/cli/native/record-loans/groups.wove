(module native_group_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type Group) (type Gid) (type Size) getgrgid_r getgrnam_r))
	(use c-header "<errno.h>" (only ERANGE))
	(use (:pragma (cfg (os "linux"))) c-header "<grp.h>"
		(only setgrent endgrent getgrent_r fgetgrent_r putgrent))
	(use (:pragma (cfg (os "linux"))) c-header "<stdio.h>" (only tmpfile fputs fflush rewind))
	(use (:pragma (cfg (os "macos"))) c-header "<grp.h>" (only getgruuid_r))
	(use (:pragma (cfg (os "macos"))) c-header "<membership.h>" (only mbr_gid_to_uuid))

	(bridge c-header "<grp.h>"
		(:pragma (bridge_replace))
		(use (:pragma (cfg (os "linux"))) c-header "<stdio.h>" (only (type File)))
		(type Gid (c-type "gid_t"))
		(type Size (c-type "size_t"))
		(struct Group (c-type "struct group")
			(fields (gr_gid Gid) (gr_name cstr) (gr_passwd cstr) (gr_mem cstrs)))

		(fn getgrgid_r (:pragma (c_bytes buffer length) (c_record_out buffer status))
			(params (gid Gid) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))
		(fn getgrnam_r (:pragma (c_cstr name) (c_bytes buffer length) (c_record_out buffer status))
			(params (name (shared-array u8)) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))
		(fn getgruuid_r
			(:pragma (cfg (os "macos")) (c_array uuid 16) (c_bytes buffer length) (c_record_out buffer status))
			(params (uuid (mut-array u8)) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))
		(fn setgrent (:pragma (cfg (os "linux"))) (params) (returns void))
		(fn endgrent (:pragma (cfg (os "linux"))) (params) (returns void))
		(fn getgrent_r (:pragma (cfg (os "linux")) (c_bytes buffer length) (c_record_out buffer status))
			(params (entry (mut-ref Group)) (buffer (mut-array u8)) (length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))
		(fn fgetgrent_r (:pragma (cfg (os "linux")) (c_bytes buffer length) (c_record_out buffer status))
			(params (file (shared-ref File)) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))
		(fn putgrent (:pragma (cfg (os "linux")))
			(params (entry (shared-ref Group)) (file (shared-ref File))) (returns i32)))

	(bridge c-header "<membership.h>" (:pragma (cfg (os "macos")))
		(use c-header "<grp.h>" (only (type Gid)))
		(fn mbr_gid_to_uuid (:pragma (c_array uuid 16))
			(params (gid Gid) (uuid (mut-array u8))) (returns i32)))

	(fn lookups (params (gid Gid)) (returns i32)
		(body
			(let-mut first (struct.new Group (gr_gid gid)))
			(let-mut second (struct.new Group (gr_gid gid)))
			(let-mut scratch (array.alloc u8 8193i32))
			(let-mut other (array.alloc u8 8192i32))
			(let-mut status 99i32)
			(let capacity (int.convert Size 8192i32))
			(let result (call getgrgid_r gid (borrow-mut first)
				(borrow-mut (array.range scratch 1i32 8193i32)) capacity (borrow-mut status)))
			(if (bool.or (i32.not-eqz status) (optional.is-none result)) (then (return 1i32)))
			(let view (optional.unwrap result))
			(let name (struct.get view gr_name))
			(let password (struct.get view gr_passwd))
			(let members (struct.get view gr_mem))
			(let count (native.cstrs.len members))
			(if (i32.eqz (array.len name)) (then (return 2i32)))
			(if (i32.ltz (array.len password)) (then (return 3i32)))
			(let next (call getgrnam_r (borrow-shared name) (borrow-mut second) (borrow-mut other)
				capacity (borrow-mut status)))
			(if (bool.or (i32.not-eqz status) (optional.is-none next)) (then (return 4i32)))
			(let same (optional.unwrap next))
			(let next_name (struct.get same gr_name))
			(if (i32.not-eq (array.len name) (array.len next_name)) (then (return 5i32)))
			(if (u32.not-eq (int.convert u32 (struct.get view gr_gid)) (int.convert u32 gid))
				(then (return 6i32)))
			(if (i32.not-eq (native.cstrs.len members) count) (then (return 7i32)))
			(if (i32.gtz count)
				(then
					(let member (native.cstrs.load members 0i32))
					(if (i32.eqz (array.len member)) (then (return 8i32)))))
			(return 0i32)))

	(fn empty_results (params (gid Gid)) (returns i32)
		(body
			(let-mut entry (struct.new Group (gr_gid gid)))
			(let-mut scratch (array.alloc u8 8192i32))
			(let-mut status 99i32)
			(if (bool true)
				(then
					(let small (call getgrgid_r gid (borrow-mut entry) (borrow-mut scratch)
						(int.convert Size 1i32) (borrow-mut status)))
					(if (bool.or (i32.not-eq status ERANGE) (bool.not (optional.is-none small)))
						(then (return 9i32)))))
			(let missing (call getgrgid_r (int.convert Gid 4294967111u32) (borrow-mut entry) (borrow-mut scratch)
				(int.convert Size 8192i32) (borrow-mut status)))
			(if (bool.or (i32.not-eqz status) (bool.not (optional.is-none missing))) (then (return 10i32)))
			(return 0i32)))

	(fn platform_group (:pragma (cfg (os "macos"))) (params (gid Gid)) (returns i32)
		(body
			(let-mut uuid (array.alloc u8 16i32))
			(if (i32.not-eqz (call mbr_gid_to_uuid gid (borrow-mut uuid))) (then (return 11i32)))
			(let-mut entry (struct.new Group (gr_gid gid)))
			(let-mut scratch (array.alloc u8 8192i32))
			(let-mut status 99i32)
			(let result (call getgruuid_r (borrow-mut uuid) (borrow-mut entry) (borrow-mut scratch)
				(int.convert Size 8192i32) (borrow-mut status)))
			(if (bool.or (i32.not-eqz status) (optional.is-none result)) (then (return 12i32)))
			(let view (optional.unwrap result))
			(let name (struct.get view gr_name))
			(if (i32.eqz (array.len name)) (then (return 13i32)))
			(return 0i32)))

	(let group_line "sample:x:2468:first,second\n")

	(fn platform_group (:pragma (cfg (os "linux"))) (params (gid Gid)) (returns i32)
		(body
			(let-mut entry (struct.new Group (gr_gid gid)))
			(let-mut scratch (array.alloc u8 8192i32))
			(let-mut status 99i32)
			(let capacity (int.convert Size 8192i32))
			(if (bool true)
				(then
					(call setgrent)
					(let observed (call getgrent_r (borrow-mut entry) (borrow-mut scratch)
						capacity (borrow-mut status)))
					(call endgrent)
					(if (bool.or (i32.not-eqz status) (optional.is-none observed)) (then (return 14i32)))))
			(let input (call tmpfile))
			(let output (call tmpfile))
			(if (bool.or (owner.is-null input) (owner.is-null output)) (then (return 15i32)))
			(if (i32.ltz (call fputs (borrow-shared group_line) (borrow-shared input))) (then (return 16i32)))
			(if (i32.not-eqz (call fflush (borrow-shared input))) (then (return 17i32)))
			(call rewind (borrow-shared input))
			(if (bool true)
				(then
					(let result (call fgetgrent_r (borrow-shared input) (borrow-mut entry) (borrow-mut scratch)
						capacity (borrow-mut status)))
					(if (bool.or (i32.not-eqz status) (optional.is-none result)) (then (return 18i32)))
					(let view (optional.unwrap result))
					(let members (struct.get view gr_mem))
					(if (i32.not-eq (native.cstrs.len members) 2i32) (then (return 19i32)))
					(if (i32.not-eqz (call putgrent (borrow-shared view) (borrow-shared output)))
						(then (return 20i32)))))
			(if (i32.not-eqz (call fflush (borrow-shared output))) (then (return 21i32)))
			(call rewind (borrow-shared output))
			(let readback (call fgetgrent_r (borrow-shared output) (borrow-mut entry) (borrow-mut scratch)
				capacity (borrow-mut status)))
			(if (bool.or (i32.not-eqz status) (optional.is-none readback)) (then (return 22i32)))
			(let view (optional.unwrap readback))
			(let members (struct.get view gr_mem))
			(if (i32.not-eq (native.cstrs.len members) 2i32) (then (return 23i32)))
			(let second (native.cstrs.load members 1i32))
			(if (i32.not-eq (array.len second) 6i32) (then (return 24i32)))
			(if (u32.not-eq (int.convert u32 (struct.get view gr_gid)) 2468u32) (then (return 25i32)))
			(return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let gid (int.convert Gid 0u32))
			(let lookup (call lookups gid))
			(if (i32.not-eqz lookup) (then (return lookup)))
			(let empty (call empty_results gid))
			(if (i32.not-eqz empty) (then (return empty)))
			(let platform (call platform_group gid))
			(if (i32.not-eqz platform) (then (return platform)))
			(return 42i32))))
