(module group_loan_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (type Group) (type Size) fixture_group))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut entry (struct:new Group (gid 0u32)))
			(let-mut scratch (array:alloc u8 128i32))
			(let-mut status 99i32)
			(let result (call fixture_group 0i32 (borrow-mut entry) (borrow-mut scratch)
				(int:convert Size 96i32) (borrow-mut status)))
			(set entry (struct:new Group (gid 1u32)))
			(return 42i32))))
