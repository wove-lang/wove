(module optional_scalar_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type (as Scalar Local)) (type Mode) (type Packet)))
	(bridge c-header "./fixture.h"
		(use c-header "./feature.h" (only))
		(type Scalar (:pragma (c_optional)) (c-type " native_alias_t "))
		(type Mode (:pragma (c_optional)) (c-type "native_mode_t"))
		(struct Packet (:pragma (c_optional)) (c-type "native_packet_t") (fields (adjustment i32))))
	(bridge c-header "./feature.h")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (int:convert Local 19u32))
			(let mode (int:convert Mode 22u32))
			(let packet (struct:new Packet (adjustment 1i32)))
			(return (i32:add (struct:get packet adjustment) (i32:add (int:convert i32 value) (int:convert i32 mode)))))))
