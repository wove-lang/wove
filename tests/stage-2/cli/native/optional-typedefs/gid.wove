(module optional_grp_gid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type (as GroupId Gid))))
	(bridge c-header "<grp.h>"
		(type GroupId (:pragma (c_optional)) (c-type "gid_t")))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (int:convert i32 (int:convert Gid 42u32))))))
