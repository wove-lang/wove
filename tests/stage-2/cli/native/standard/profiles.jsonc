{
	"profiles": [
		{
			"name": "default",
			"build": { "default": { "cflags": ["-I.", "-std=c99"] } },
		},
		{ "name": "c11", "cc": { "cstd": "c11" } },
		{ "name": "c17", "cc": { "cstd": "c17" } },
		{ "name": "c23", "cc": { "cstd": "c23" } },
		{
			"name": "c17-frontend",
			"cc": { "cstd": "c17" },
			"build": { "default": { "cflags": ["-I.", "-Xclang", "-std=c11"] } },
		},
	],
}
