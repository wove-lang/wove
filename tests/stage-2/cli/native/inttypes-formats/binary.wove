(module inttypes_binary_formats
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (value PRIb8) (value PRIB8) (value SCNb8)
			(value PRIb16) (value PRIB16) (value SCNb16)
			(value PRIb32) (value PRIB32) (value SCNb32)
			(value PRIb64) (value PRIB64) (value SCNb64)
			(value PRIbLEAST8) (value PRIBLEAST8) (value SCNbLEAST8)
			(value PRIbLEAST16) (value PRIBLEAST16) (value SCNbLEAST16)
			(value PRIbLEAST32) (value PRIBLEAST32) (value SCNbLEAST32)
			(value PRIbLEAST64) (value PRIBLEAST64) (value SCNbLEAST64)
			(value PRIbFAST8) (value PRIBFAST8) (value SCNbFAST8)
			(value PRIbFAST16) (value PRIBFAST16) (value SCNbFAST16)
			(value PRIbFAST32) (value PRIBFAST32) (value SCNbFAST32)
			(value PRIbFAST64) (value PRIBFAST64) (value SCNbFAST64)
			(value PRIbPTR) (value PRIBPTR) (value SCNbPTR)
			(value PRIbMAX) (value PRIBMAX) (value SCNbMAX)
			(value (as SCNbMAX binary_scan_maximum))))
	(use c-header "./oracle.h" (only fixture_inttypes_format))
	(bridge c-header "./oracle.h"
		(fn fixture_inttypes_format
			(:pragma (c_bytes bytes length))
			(params (row i32) (column i32) (bytes (shared-array u8)) (length i32)) (returns bool)))

	(fn check_format (params (row i32) (column i32) (bytes (shared-array u8))) (returns bool)
		(body (return (call fixture_inttypes_format row column (borrow-shared bytes) (array.len bytes)))))

	(fn check_binary_formats
		(params (row i32) (lower_binary (shared-array u8)) (upper_binary (shared-array u8))
			(scan_binary (shared-array u8))) (returns bool)
		(body
			(return (bool.and (call check_format row 0i32 (borrow-shared lower_binary))
				(bool.and (call check_format row 1i32 (borrow-shared upper_binary))
					(call check_format row 2i32 (borrow-shared scan_binary)))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_binary_formats 28i32
				(borrow-shared PRIb8) (borrow-shared PRIB8) (borrow-shared SCNb8))) (then (return 1i32)))
			(if (bool.not (call check_binary_formats 29i32
				(borrow-shared PRIb16) (borrow-shared PRIB16) (borrow-shared SCNb16))) (then (return 2i32)))
			(if (bool.not (call check_binary_formats 30i32
				(borrow-shared PRIb32) (borrow-shared PRIB32) (borrow-shared SCNb32))) (then (return 3i32)))
			(if (bool.not (call check_binary_formats 31i32
				(borrow-shared PRIb64) (borrow-shared PRIB64) (borrow-shared SCNb64))) (then (return 4i32)))
			(if (bool.not (call check_binary_formats 32i32
				(borrow-shared PRIbLEAST8) (borrow-shared PRIBLEAST8) (borrow-shared SCNbLEAST8))) (then (return 5i32)))
			(if (bool.not (call check_binary_formats 33i32
				(borrow-shared PRIbLEAST16) (borrow-shared PRIBLEAST16) (borrow-shared SCNbLEAST16))) (then (return 6i32)))
			(if (bool.not (call check_binary_formats 34i32
				(borrow-shared PRIbLEAST32) (borrow-shared PRIBLEAST32) (borrow-shared SCNbLEAST32))) (then (return 7i32)))
			(if (bool.not (call check_binary_formats 35i32
				(borrow-shared PRIbLEAST64) (borrow-shared PRIBLEAST64) (borrow-shared SCNbLEAST64))) (then (return 8i32)))
			(if (bool.not (call check_binary_formats 36i32
				(borrow-shared PRIbFAST8) (borrow-shared PRIBFAST8) (borrow-shared SCNbFAST8))) (then (return 9i32)))
			(if (bool.not (call check_binary_formats 37i32
				(borrow-shared PRIbFAST16) (borrow-shared PRIBFAST16) (borrow-shared SCNbFAST16))) (then (return 10i32)))
			(if (bool.not (call check_binary_formats 38i32
				(borrow-shared PRIbFAST32) (borrow-shared PRIBFAST32) (borrow-shared SCNbFAST32))) (then (return 11i32)))
			(if (bool.not (call check_binary_formats 39i32
				(borrow-shared PRIbFAST64) (borrow-shared PRIBFAST64) (borrow-shared SCNbFAST64))) (then (return 12i32)))
			(if (bool.not (call check_binary_formats 40i32
				(borrow-shared PRIbPTR) (borrow-shared PRIBPTR) (borrow-shared SCNbPTR))) (then (return 13i32)))
			(if (bool.not (call check_binary_formats 41i32
				(borrow-shared PRIbMAX) (borrow-shared PRIBMAX) (borrow-shared SCNbMAX))) (then (return 14i32)))
			(if (bool.not (call check_format 41i32 2i32 (borrow-shared binary_scan_maximum))) (then (return 15i32)))
			(return 42i32))))
