(module inttypes_formats
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (value PRId8) (value PRIi8) (value PRIo8) (value PRIu8) (value PRIx8) (value PRIX8)
			(value PRId16) (value PRIi16) (value PRIo16) (value PRIu16) (value PRIx16) (value PRIX16)
			(value PRId32) (value PRIi32) (value PRIo32) (value PRIu32) (value PRIx32) (value PRIX32)
			(value PRId64) (value PRIi64) (value PRIo64) (value PRIu64) (value PRIx64) (value PRIX64)
			(value PRIdLEAST8) (value PRIiLEAST8) (value PRIoLEAST8) (value PRIuLEAST8) (value PRIxLEAST8) (value PRIXLEAST8)
			(value PRIdLEAST16) (value PRIiLEAST16) (value PRIoLEAST16) (value PRIuLEAST16) (value PRIxLEAST16) (value PRIXLEAST16)
			(value PRIdLEAST32) (value PRIiLEAST32) (value PRIoLEAST32) (value PRIuLEAST32) (value PRIxLEAST32) (value PRIXLEAST32)
			(value PRIdLEAST64) (value PRIiLEAST64) (value PRIoLEAST64) (value PRIuLEAST64) (value PRIxLEAST64) (value PRIXLEAST64)
			(value PRIdFAST8) (value PRIiFAST8) (value PRIoFAST8) (value PRIuFAST8) (value PRIxFAST8) (value PRIXFAST8)
			(value PRIdFAST16) (value PRIiFAST16) (value PRIoFAST16) (value PRIuFAST16) (value PRIxFAST16) (value PRIXFAST16)
			(value PRIdFAST32) (value PRIiFAST32) (value PRIoFAST32) (value PRIuFAST32) (value PRIxFAST32) (value PRIXFAST32)
			(value PRIdFAST64) (value PRIiFAST64) (value PRIoFAST64) (value PRIuFAST64) (value PRIxFAST64) (value PRIXFAST64)
			(value PRIdPTR) (value PRIiPTR) (value PRIoPTR) (value PRIuPTR) (value PRIxPTR) (value PRIXPTR)
			(value PRIdMAX) (value PRIiMAX) (value PRIoMAX) (value PRIuMAX) (value PRIxMAX) (value PRIXMAX)
			(value (as PRIdMAX print_decimal_maximum))
			(value SCNd8) (value SCNi8) (value SCNo8) (value SCNu8) (value SCNx8)
			(value SCNd16) (value SCNi16) (value SCNo16) (value SCNu16) (value SCNx16)
			(value SCNd32) (value SCNi32) (value SCNo32) (value SCNu32) (value SCNx32)
			(value SCNd64) (value SCNi64) (value SCNo64) (value SCNu64) (value SCNx64)
			(value SCNdLEAST8) (value SCNiLEAST8) (value SCNoLEAST8) (value SCNuLEAST8) (value SCNxLEAST8)
			(value SCNdLEAST16) (value SCNiLEAST16) (value SCNoLEAST16) (value SCNuLEAST16) (value SCNxLEAST16)
			(value SCNdLEAST32) (value SCNiLEAST32) (value SCNoLEAST32) (value SCNuLEAST32) (value SCNxLEAST32)
			(value SCNdLEAST64) (value SCNiLEAST64) (value SCNoLEAST64) (value SCNuLEAST64) (value SCNxLEAST64)
			(value SCNdFAST8) (value SCNiFAST8) (value SCNoFAST8) (value SCNuFAST8) (value SCNxFAST8)
			(value SCNdFAST16) (value SCNiFAST16) (value SCNoFAST16) (value SCNuFAST16) (value SCNxFAST16)
			(value SCNdFAST32) (value SCNiFAST32) (value SCNoFAST32) (value SCNuFAST32) (value SCNxFAST32)
			(value SCNdFAST64) (value SCNiFAST64) (value SCNoFAST64) (value SCNuFAST64) (value SCNxFAST64)
			(value SCNdPTR) (value SCNiPTR) (value SCNoPTR) (value SCNuPTR) (value SCNxPTR)
			(value SCNdMAX) (value SCNiMAX) (value SCNoMAX) (value SCNuMAX) (value SCNxMAX)
			(value (as SCNdMAX scan_decimal_maximum))))
	(use c-header "./oracle.h" (only fixture_inttypes_format))
	(bridge c-header "./oracle.h"
		(fn fixture_inttypes_format
			(:pragma (c_bytes bytes length))
			(params (row i32) (column i32) (bytes (shared-array u8)) (length i32)) (returns bool)))

	(fn check_format (params (row i32) (column i32) (bytes (shared-array u8))) (returns bool)
		(body (return (call fixture_inttypes_format row column (borrow-shared bytes) (array:len bytes)))))

	(fn check_common_formats
		(params (row i32) (decimal (shared-array u8)) (signed_integer (shared-array u8))
			(octal (shared-array u8)) (unsigned_decimal (shared-array u8)) (lower_hex (shared-array u8))) (returns bool)
		(body
			(if (bool:not (call check_format row 0i32 (borrow-shared decimal))) (then (return (bool false))))
			(if (bool:not (call check_format row 1i32 (borrow-shared signed_integer))) (then (return (bool false))))
			(if (bool:not (call check_format row 2i32 (borrow-shared octal))) (then (return (bool false))))
			(if (bool:not (call check_format row 3i32 (borrow-shared unsigned_decimal))) (then (return (bool false))))
			(return (call check_format row 4i32 (borrow-shared lower_hex)))))

	(fn check_print_formats
		(params (row i32) (decimal (shared-array u8)) (signed_integer (shared-array u8))
			(octal (shared-array u8)) (unsigned_decimal (shared-array u8)) (lower_hex (shared-array u8))
			(upper_hex (shared-array u8))) (returns bool)
		(body
			(return (bool:and (call check_common_formats row (borrow-shared decimal) (borrow-shared signed_integer)
				(borrow-shared octal) (borrow-shared unsigned_decimal) (borrow-shared lower_hex))
				(call check_format row 5i32 (borrow-shared upper_hex))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call check_print_formats 0i32
				(borrow-shared PRId8) (borrow-shared PRIi8) (borrow-shared PRIo8)
				(borrow-shared PRIu8) (borrow-shared PRIx8) (borrow-shared PRIX8))) (then (return 1i32)))
			(if (bool:not (call check_print_formats 1i32
				(borrow-shared PRId16) (borrow-shared PRIi16) (borrow-shared PRIo16)
				(borrow-shared PRIu16) (borrow-shared PRIx16) (borrow-shared PRIX16))) (then (return 2i32)))
			(if (bool:not (call check_print_formats 2i32
				(borrow-shared PRId32) (borrow-shared PRIi32) (borrow-shared PRIo32)
				(borrow-shared PRIu32) (borrow-shared PRIx32) (borrow-shared PRIX32))) (then (return 3i32)))
			(if (bool:not (call check_print_formats 3i32
				(borrow-shared PRId64) (borrow-shared PRIi64) (borrow-shared PRIo64)
				(borrow-shared PRIu64) (borrow-shared PRIx64) (borrow-shared PRIX64))) (then (return 4i32)))
			(if (bool:not (call check_print_formats 4i32
				(borrow-shared PRIdLEAST8) (borrow-shared PRIiLEAST8) (borrow-shared PRIoLEAST8)
				(borrow-shared PRIuLEAST8) (borrow-shared PRIxLEAST8) (borrow-shared PRIXLEAST8))) (then (return 5i32)))
			(if (bool:not (call check_print_formats 5i32
				(borrow-shared PRIdLEAST16) (borrow-shared PRIiLEAST16) (borrow-shared PRIoLEAST16)
				(borrow-shared PRIuLEAST16) (borrow-shared PRIxLEAST16) (borrow-shared PRIXLEAST16))) (then (return 6i32)))
			(if (bool:not (call check_print_formats 6i32
				(borrow-shared PRIdLEAST32) (borrow-shared PRIiLEAST32) (borrow-shared PRIoLEAST32)
				(borrow-shared PRIuLEAST32) (borrow-shared PRIxLEAST32) (borrow-shared PRIXLEAST32))) (then (return 7i32)))
			(if (bool:not (call check_print_formats 7i32
				(borrow-shared PRIdLEAST64) (borrow-shared PRIiLEAST64) (borrow-shared PRIoLEAST64)
				(borrow-shared PRIuLEAST64) (borrow-shared PRIxLEAST64) (borrow-shared PRIXLEAST64))) (then (return 8i32)))
			(if (bool:not (call check_print_formats 8i32
				(borrow-shared PRIdFAST8) (borrow-shared PRIiFAST8) (borrow-shared PRIoFAST8)
				(borrow-shared PRIuFAST8) (borrow-shared PRIxFAST8) (borrow-shared PRIXFAST8))) (then (return 9i32)))
			(if (bool:not (call check_print_formats 9i32
				(borrow-shared PRIdFAST16) (borrow-shared PRIiFAST16) (borrow-shared PRIoFAST16)
				(borrow-shared PRIuFAST16) (borrow-shared PRIxFAST16) (borrow-shared PRIXFAST16))) (then (return 10i32)))
			(if (bool:not (call check_print_formats 10i32
				(borrow-shared PRIdFAST32) (borrow-shared PRIiFAST32) (borrow-shared PRIoFAST32)
				(borrow-shared PRIuFAST32) (borrow-shared PRIxFAST32) (borrow-shared PRIXFAST32))) (then (return 11i32)))
			(if (bool:not (call check_print_formats 11i32
				(borrow-shared PRIdFAST64) (borrow-shared PRIiFAST64) (borrow-shared PRIoFAST64)
				(borrow-shared PRIuFAST64) (borrow-shared PRIxFAST64) (borrow-shared PRIXFAST64))) (then (return 12i32)))
			(if (bool:not (call check_print_formats 12i32
				(borrow-shared PRIdPTR) (borrow-shared PRIiPTR) (borrow-shared PRIoPTR)
				(borrow-shared PRIuPTR) (borrow-shared PRIxPTR) (borrow-shared PRIXPTR))) (then (return 13i32)))
			(if (bool:not (call check_print_formats 13i32
				(borrow-shared PRIdMAX) (borrow-shared PRIiMAX) (borrow-shared PRIoMAX)
				(borrow-shared PRIuMAX) (borrow-shared PRIxMAX) (borrow-shared PRIXMAX))) (then (return 14i32)))
			(if (bool:not (call check_format 13i32 0i32 (borrow-shared print_decimal_maximum))) (then (return 15i32)))
			(if (bool:not (call check_common_formats 14i32
				(borrow-shared SCNd8) (borrow-shared SCNi8) (borrow-shared SCNo8)
				(borrow-shared SCNu8) (borrow-shared SCNx8))) (then (return 16i32)))
			(if (bool:not (call check_common_formats 15i32
				(borrow-shared SCNd16) (borrow-shared SCNi16) (borrow-shared SCNo16)
				(borrow-shared SCNu16) (borrow-shared SCNx16))) (then (return 17i32)))
			(if (bool:not (call check_common_formats 16i32
				(borrow-shared SCNd32) (borrow-shared SCNi32) (borrow-shared SCNo32)
				(borrow-shared SCNu32) (borrow-shared SCNx32))) (then (return 18i32)))
			(if (bool:not (call check_common_formats 17i32
				(borrow-shared SCNd64) (borrow-shared SCNi64) (borrow-shared SCNo64)
				(borrow-shared SCNu64) (borrow-shared SCNx64))) (then (return 19i32)))
			(if (bool:not (call check_common_formats 18i32
				(borrow-shared SCNdLEAST8) (borrow-shared SCNiLEAST8) (borrow-shared SCNoLEAST8)
				(borrow-shared SCNuLEAST8) (borrow-shared SCNxLEAST8))) (then (return 20i32)))
			(if (bool:not (call check_common_formats 19i32
				(borrow-shared SCNdLEAST16) (borrow-shared SCNiLEAST16) (borrow-shared SCNoLEAST16)
				(borrow-shared SCNuLEAST16) (borrow-shared SCNxLEAST16))) (then (return 21i32)))
			(if (bool:not (call check_common_formats 20i32
				(borrow-shared SCNdLEAST32) (borrow-shared SCNiLEAST32) (borrow-shared SCNoLEAST32)
				(borrow-shared SCNuLEAST32) (borrow-shared SCNxLEAST32))) (then (return 22i32)))
			(if (bool:not (call check_common_formats 21i32
				(borrow-shared SCNdLEAST64) (borrow-shared SCNiLEAST64) (borrow-shared SCNoLEAST64)
				(borrow-shared SCNuLEAST64) (borrow-shared SCNxLEAST64))) (then (return 23i32)))
			(if (bool:not (call check_common_formats 22i32
				(borrow-shared SCNdFAST8) (borrow-shared SCNiFAST8) (borrow-shared SCNoFAST8)
				(borrow-shared SCNuFAST8) (borrow-shared SCNxFAST8))) (then (return 24i32)))
			(if (bool:not (call check_common_formats 23i32
				(borrow-shared SCNdFAST16) (borrow-shared SCNiFAST16) (borrow-shared SCNoFAST16)
				(borrow-shared SCNuFAST16) (borrow-shared SCNxFAST16))) (then (return 25i32)))
			(if (bool:not (call check_common_formats 24i32
				(borrow-shared SCNdFAST32) (borrow-shared SCNiFAST32) (borrow-shared SCNoFAST32)
				(borrow-shared SCNuFAST32) (borrow-shared SCNxFAST32))) (then (return 26i32)))
			(if (bool:not (call check_common_formats 25i32
				(borrow-shared SCNdFAST64) (borrow-shared SCNiFAST64) (borrow-shared SCNoFAST64)
				(borrow-shared SCNuFAST64) (borrow-shared SCNxFAST64))) (then (return 27i32)))
			(if (bool:not (call check_common_formats 26i32
				(borrow-shared SCNdPTR) (borrow-shared SCNiPTR) (borrow-shared SCNoPTR)
				(borrow-shared SCNuPTR) (borrow-shared SCNxPTR))) (then (return 28i32)))
			(if (bool:not (call check_common_formats 27i32
				(borrow-shared SCNdMAX) (borrow-shared SCNiMAX) (borrow-shared SCNoMAX)
				(borrow-shared SCNuMAX) (borrow-shared SCNxMAX))) (then (return 29i32)))
			(if (bool:not (call check_format 27i32 0i32 (borrow-shared scan_decimal_maximum))) (then (return 30i32)))
			(return 42i32))))
