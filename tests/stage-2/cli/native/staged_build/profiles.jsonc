{
	"profiles": [
		{
			"name": "default",
			"cc": {"cstd": "c17"},
			"build": {"default": {"cflags": ["-std=c11", "-O2", "-Werror"]}}
		},
		{
			"name": "controlled",
			"cc": {"cstd": "c17"},
			"build": {"default": {
				"cflags": ["--target=arm64-apple-macos", "-isysroot", "/Original SDK", "-std=c11", "-Werror"],
				"defines": ["LABEL=with spaces"],
				"ldflags": ["--target=x86_64-linux-gnu", "-isysroot", "/Selected SDK", "-Xlinker", "--as-needed"],
				"links": ["first archive.a", "-second.a", "@third.a"],
				"ldlibs": ["first", "second"],
				"lto": "thin"
			}}
		}
	]
}
