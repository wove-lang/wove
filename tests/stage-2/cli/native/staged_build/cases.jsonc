{
	"defaults": {
		"files": {"stage/10-entry.c": "entry.c", "stage/02-leaf.c": "leaf.c", "probe.py": "tool.py", "published": "previous.txt"},
		"units": ["stage/10-entry.c", "stage/02-leaf.c"],
		"config": "profiles.jsonc",
		"image": "stage/program",
		"target": "published",
		"budget": 2,
		"arguments": ["bin", "input.wove"]
	},
	"arguments": {
		"common": ["-D_GNU_SOURCE", "-D_DARWIN_C_SOURCE", "-I", "{root}/stage/"],
		"controlled-options": ["common", "--target=arm64-apple-macos", "-isysroot", "/Original SDK", "-std=c11",
			"-Werror", "-DLABEL=with spaces", "-flto=thin"],
		"controlled-driver": ["--target=x86_64-linux-gnu", "-isysroot", "/Selected SDK", "-Xlinker", "--as-needed"],
		"standard": ["-std=c17", "-Xclang", "-std=c17"],
		"compile": ["-Qunused-arguments", "-c", "-x", "c"],
		"pic": ["-fPIC", "-fvisibility=hidden"],
		"unit-0": ["{root}/stage/10-entry.c", "-o", "{root}/stage/object-0.o"],
		"unit-1": ["{root}/stage/02-leaf.c", "-o", "{root}/stage/object-1.o"],
		"controlled-compile": ["controlled-options", "controlled-driver", "standard"],
		"native-default": ["common", "-std=c11", "-O2", "-Werror"],
		"objects": ["-Qunused-arguments", "-x", "none", "{root}/stage/object-0.o", "{root}/stage/object-1.o"],
		"controlled-link": ["controlled-options", "objects", "controlled-driver",
			"first archive.a", "./-second.a", "./@third.a", "-lfirst", "-lsecond", "-lm"],
		"link-output": ["standard", "-o", "{root}/stage/program"]
	},
	"cases": [
		{
			"name": "linux-shared-effective-settings",
			"os": "linux",
			"exports": "stage/lib.exports",
			"arguments": ["bin", "input.wove", "--profile", "controlled"],
			"tool": "probe.py",
			"actions": {
				"object-0.o": {"output": "first object", "stdout": "first stdout"},
				"object-1.o": {"output": "second object", "stderr": "second stderr"},
				"program": {"output": "linked", "stdout": "link stdout", "stderr": "link stderr"}
			},
			"build": {"stdout": "0 -1 2 1\n"},
			"calls": {
				"stage/object-0.o.argv": ["controlled-compile", "pic", "compile", "unit-0"],
				"stage/object-1.o.argv": ["controlled-compile", "pic", "compile", "unit-1"],
				"stage/program.argv": ["controlled-link", "-shared", "-Xlinker", "--version-script", "-Xlinker",
					"{root}/stage/lib.exports", "-Xlinker", "-soname", "-Xlinker", "published", "link-output"]
			},
			"outputs": {"stage/object-0.stdout": "first stdout", "stage/object-1.stderr": "second stderr",
				"stage/link.stdout": "link stdout", "stage/link.stderr": "link stderr", "published": "linked"}
		},
		{
			"name": "darwin-shared-effective-settings",
			"os": "macos",
			"exports": "stage/lib.exports",
			"arguments": ["bin", "input.wove", "--ldflag=--target=arm64-apple-macos"],
			"tool": "probe.py",
			"actions": {
				"object-0.o": {"output": "first object"},
				"object-1.o": {"output": "second object"},
				"program": {"output": "linked"}
			},
			"build": {"stdout": "0 -1 2 1\n"},
			"calls": {
				"stage/object-0.o.argv": ["native-default", "--target=arm64-apple-macos", "standard", "pic", "compile", "unit-0"],
				"stage/object-1.o.argv": ["native-default", "--target=arm64-apple-macos", "standard", "pic", "compile", "unit-1"],
				"stage/program.argv": ["native-default", "objects", "--target=arm64-apple-macos",
					"-dynamiclib", "-Xlinker", "-exported_symbols_list", "-Xlinker", "{root}/stage/lib.exports",
					"-Xlinker", "-install_name", "-Xlinker", "@rpath/published", "link-output"]
			}
		},
		{
			"name": "object-failure-skips-link",
			"os": "linux",
			"arguments": ["bin", "input.wove", "--profile", "controlled"],
			"tool": "probe.py",
			"actions": {
				"object-0.o": {"output": "first object"},
				"object-1.o": {"exit": 23, "stderr": "object compile failed"}
			},
			"build": {"stdout": "23 1 2 0\n"},
			"calls": {
				"stage/object-0.o.argv": ["controlled-compile", "compile", "unit-0"],
				"stage/object-1.o.argv": ["controlled-compile", "compile", "unit-1"]
			},
			"preserve": ["published"],
			"absent": ["stage/link.stdout", "stage/program"],
			"outputs": {"stage/object-1.stderr": "object compile failed"}
		},
		{
			"name": "missing-object-skips-link",
			"os": "linux",
			"arguments": ["bin", "input.wove", "--profile", "controlled"],
			"tool": "probe.py",
			"actions": {"object-0.o": {}, "object-1.o": {"output": "second object"}},
			"build": {"stdout": "-3 0 2 0\n"},
			"calls": {
				"stage/object-0.o.argv": ["controlled-compile", "compile", "unit-0"],
				"stage/object-1.o.argv": ["controlled-compile", "compile", "unit-1"]
			},
			"preserve": ["published"],
			"absent": ["stage/link.stdout", "stage/program"]
		},
		{
			"name": "link-failure-preserves-publication",
			"os": "linux",
			"arguments": ["bin", "input.wove", "--profile", "controlled"],
			"tool": "probe.py",
			"actions": {
				"object-0.o": {"output": "first object"},
				"object-1.o": {"output": "second object"},
				"program": {"output": "partial private image", "exit": 24, "stderr": "linker failed"}
			},
			"build": {"stdout": "24 -1 2 1\n"},
			"calls": {
				"stage/object-0.o.argv": ["controlled-compile", "compile", "unit-0"],
				"stage/object-1.o.argv": ["controlled-compile", "compile", "unit-1"],
				"stage/program.argv": ["controlled-link", "link-output"]
			},
			"preserve": ["published"],
			"outputs": {"stage/program": "partial private image", "stage/link.stderr": "linker failed"}
		},
		{
			"name": "link-success-without-image",
			"os": "linux",
			"arguments": ["bin", "input.wove", "--profile", "controlled"],
			"tool": "probe.py",
			"actions": {"object-0.o": {"output": "first object"}, "object-1.o": {"output": "second object"}, "program": {}},
			"build": {"stdout": "-3 -1 2 1\n"},
			"calls": {
				"stage/object-0.o.argv": ["controlled-compile", "compile", "unit-0"],
				"stage/object-1.o.argv": ["controlled-compile", "compile", "unit-1"],
				"stage/program.argv": ["controlled-link", "link-output"]
			},
			"preserve": ["published"],
			"absent": ["stage/program"]
		},
		{
			"name": "link-log-alias-rejects-before-launch",
			"image": "stage/link.stdout",
			"tool": "probe.py",
			"actions": {},
			"build": {"stdout": "-1 -1 0 0\n"},
			"calls": {},
			"preserve": ["published"]
		},
		{
			"name": "occupied-private-image-rejects-before-launch",
			"image": "published",
			"tool": "probe.py",
			"actions": {},
			"build": {"stdout": "-1 -1 0 0\n"},
			"calls": {},
			"preserve": ["published"]
		},
		{
			"name": "native-executable",
			"build": {"stdout": "0 -1 2 1\n"},
			"verify": [{"argv": ["{root}/published"], "exit": 42}]
		},
		{
			"name": "native-macho-library",
			"host": "macos",
			"files": {"stage/10-entry.c": "entry.c", "stage/02-leaf.c": "leaf.c",
				"stage/lib.exports": "exports-darwin.txt", "consumer.c": "consumer.c"},
			"exports": "stage/lib.exports",
			"target": "libstaged.dylib",
			"arguments": ["bin", "input.wove", "--define=STAGED_LIBRARY"],
			"build": {"stdout": "0 -1 2 1\n"},
			"verify": [
				{"argv": ["{clang}", "consumer.c", "./libstaged.dylib", "-Xlinker", "-rpath", "-Xlinker", "{root}", "-o", "consumer"]},
				{"argv": ["{root}/consumer"], "exit": 42}
			]
		},
		{
			"name": "native-elf-library",
			"host": "linux",
			"files": {"stage/10-entry.c": "entry.c", "stage/02-leaf.c": "leaf.c",
				"stage/lib.exports": "exports-linux.txt", "consumer.c": "consumer.c"},
			"exports": "stage/lib.exports",
			"target": "libstaged.so",
			"arguments": ["bin", "input.wove", "--define=STAGED_LIBRARY"],
			"build": {"stdout": "0 -1 2 1\n"},
			"verify": [
				{"argv": ["{clang}", "consumer.c", "./libstaged.so", "-Xlinker", "-rpath", "-Xlinker", "{root}", "-o", "consumer"]},
				{"argv": ["{root}/consumer"], "exit": 42}
			]
		}
	]
}
