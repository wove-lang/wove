(module staged_build_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../../stage-2/driver/bin/staged.wove" (only build_staged_units (type StagedBuild)))
	(use wove-file "../../../../../stage-2/driver/paths.wove" (only directory_width))
	(use wove-file "../../../../../stage-2/cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "../../../../../stage-2/cli/command/args.wove" (only (type CommandArgument)))
	(use wove-file "../../../../../stage-2/cli/command/resolve.wove" (only resolve_command))
	(use wove-file "../../../../../stage-2/cli/values.wove" (only argv_decimal))
	(use wove-file "../../../../../stage-2/config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../../../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../../../stage-2/source/target.wove" (only target_os))
	(use wove-file "../../../../../stage-2/io/process.wove" (only copy_argument))
	(use wove-file "../../../../../stage-2/io/write.wove" (only write_all))
	(use wove-file "../../../../../stage-2/text/copy.wove" (only append_bytes))
	(use wove-file "../../../../../stage-2/text/decimal_write.wove" (only write_decimal_i32))
	(use c-header "<stdio.h>" (only rename))

	(let first_unit 9i32)

	(fn magnitude (params (bytes (shared-array u8))) (returns u32)
		(body
			(let parsed (call argv_decimal (borrow-shared bytes) 0i32 (array:len bytes) (bool false)))
			(return (struct:get parsed magnitude))))

	(fn report (params (result StagedBuild)) (returns bool)
		(body
			(let-mut line (array:alloc u8 48i32))
			(let status (call write_decimal_i32 (borrow-mut line) 0i32 (struct:get result status)))
			(array:set line status 32u8)
			(let failed (call write_decimal_i32 (borrow-mut line) (i32:inc status) (struct:get result failed_unit)))
			(array:set line failed 32u8)
			(let attempted (call write_decimal_i32 (borrow-mut line) (i32:inc failed) (struct:get result attempted)))
			(array:set line attempted 32u8)
			(let linked (if (struct:get result link_attempted) (then 49u8) (else 48u8)))
			(array:set line (i32:inc attempted) linked)
			(array:set line (i32:add attempted 2i32) 10u8)
			(return (call write_all 1i32 (borrow-shared (array:range line 0i32 (i32:add attempted 3i32)))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let program (borrow-shared (array:get argv 1i32)))
			(let binary (borrow-shared (array:get argv 2i32)))
			(let target (borrow-shared (array:get argv 3i32)))
			(let os (call target_os (borrow-shared (array:get argv 4i32))))
			(let exports (borrow-shared (array:get argv 5i32)))
			(let library (i32:gtz (array:len exports)))
			(let config (borrow-shared (array:get argv 6i32)))
			(let budget (call magnitude (borrow-shared (array:get argv 7i32))))
			(let count (i32:from-u32 (call magnitude (borrow-shared (array:get argv 8i32)))))
			(let-mut units (array:alloc (owned-array u8) count))
			(for (let index) (range 0i32 count)
				(body (array:set units index (call copy_argument (borrow-shared (array:get argv (i32:add first_unit index)))))))
			(let first (i32:add first_unit count))
			(let argc (array:len argv))
			(let-mut length 0i32)
			(for (let row) (range first argc)
				(body (set length (i32:add length (array:len (array:get argv row))))))
			(let-mut bytes (array:alloc u8 length))
			(let rows (i32:sub argc first))
			(let-mut spans (array:alloc ArgSpan rows))
			(let-mut start 0i32)
			(for (let row) (range first argc)
				(body
					(let end (call append_bytes (borrow-shared (array:get argv row)) (borrow-mut bytes) start))
					(array:set spans (i32:sub row first) (struct:new ArgSpan (start start) (end end)))
					(set start end)))
			(let-mut nodes (array:alloc JsonNode (array:len config)))
			(let-mut settings (array:alloc ProjectSetting (array:len config)))
			(let-mut arguments (array:alloc CommandArgument rows))
			(let invocation (call resolve_command (borrow-shared bytes) (borrow-shared spans)
				(borrow-shared config) (i32:gtz (array:len config))
				(borrow-mut nodes) (borrow-mut settings) (borrow-mut arguments)))
			(if (u32:not-eqz (struct:get invocation error)) (then (return 1i32)))
			(let-mut no_traces (array:alloc i32 0i32))
			(let result (call build_staged_units (borrow-shared program) (borrow-shared units) (borrow-shared binary)
				budget os library (borrow-shared exports)
				(borrow-shared (array:range target (call directory_width (borrow-shared target)) (array:len target)))
				(borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) (borrow-mut no_traces)))
			(if (i32:eqz (struct:get result status))
				(then
					(if (i32:not-eqz (call rename (borrow-shared binary) (borrow-shared target)))
						(then (return 2i32)))))
			(if (bool:not (call report result)) (then (return 3i32)))
			(return 0i32))))
