(module native_inline_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./tag.h" (only (type Tag)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let tag (struct.new Tag))
			(array.store (struct.get tag name) 0i32 23u8)
			(return 0i32))))
