(module native_inline_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./tag.h" (only (type Tag) exchange_tag))

	(fn main (:expect (issues "gh:wove-lang/wove:564"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut tag (struct:new Tag (before 0x12345678u32) (after 0xcafefeedu32)))
			(let mode (i32:dec (array:len args)))
			(if (i32:eq mode 1i32)
				(then
					(let index (i32:add mode 16i32))
					(array:store (struct:get tag name) index 99u8)
					(return 5i32)))
			(if (i32:eq mode 2i32)
				(then
					(let index (i32:sub 1i32 mode))
					(return (int:convert i32 (array:load (struct:get tag name) index)))))
			(array:store (struct:get tag name) 0i32 255u8)
			(let extent (array:len (struct:get tag name)))
			(if (i32:not-eq extent 17i32) (then (return 1i32)))
			(array:store (struct:get tag name) (i32:dec extent) 128u8)
			(if (i32:not-eqz (call exchange_tag (borrow-mut tag))) (then (return 2i32)))
			(if (bool:or (u8:not-eq (array:load (struct:get tag name) 0i32) 227u8)
				(u8:not-eq (array:load (struct:get tag name) 16i32) 165u8)) (then (return 3i32)))
			(if (bool:or (u32:not-eq (struct:get tag before) 0x12345678u32)
				(u32:not-eq (struct:get tag after) 0xcafefeedu32)) (then (return 4i32)))
			(return 42i32))))
