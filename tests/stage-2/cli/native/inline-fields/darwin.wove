(module native_inline_darwin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "./darwin.h"
		(only (type Tag) query_tag (value F_QUERY_TAG)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value EBADF)))
	(bridge c-header "./darwin.h" (:pragma (cfg (os "macos")))
		(type TagHash (c-type "unsigned long long"))
		(struct Tag (c-type "fattributiontag_t")
			(fields (ft_flags u32) (ft_hash TagHash) (ft_attribution_name (array char 255))))
		(const F_ATTRIBUTION_TAG i32)
		(const F_QUERY_TAG i32)
		(fn query_tag (:pragma (c_variadic request)) (c-name "fcntl")
			(params (fd i32) (const command i32 F_ATTRIBUTION_TAG) (request (mut-ref Tag)))
			(returns i32)))

	(fn check_tag (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let flags (int.convert u32 F_QUERY_TAG))
			(let-mut tag (struct.new Tag (ft_flags flags)))
			(let extent (array.len (struct.get tag ft_attribution_name)))
			(if (i32.not-eq extent 255i32) (then (return 1i32)))
			(array.store (struct.get tag ft_attribution_name) 254i32 165u8)
			(if (i32.not-eq (call query_tag -1i32 (borrow-mut tag)) -1i32) (then (return 2i32)))
			(if (i32.not-eq errno EBADF) (then (return 3i32)))
			(if (u8.not-eq (array.load (struct.get tag ft_attribution_name) 254i32) 165u8)
				(then (return 4i32)))
			(return 42i32)))

	(fn check_tag (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:564"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_tag)))))
