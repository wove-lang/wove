(module native_inline_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./tag.h" (only (type Tag) exchange_tag))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut tag (struct.new Tag))
			(array.store (struct.get tag name) 0i32
				(int.convert u8 (call exchange_tag (borrow-mut tag))))
			(return 0i32))))
