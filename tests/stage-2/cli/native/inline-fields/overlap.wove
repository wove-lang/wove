(module native_inline_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./tag.h" (only (type Tag) exchange_tag))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut tag (struct.new Tag))
			(array.store (struct.get (local tag) name) 0i32
				(int.convert u8 (call exchange_tag (borrow-mut (local tag)))))
			(return 0i32))))
