(module constant_shadow_bool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only (type (as Transform ImportedUnary))))
	(fn invoke (generic (const ImportedUnary bool)) (params (action ImportedUnary)) (returns i32)
		(body (return (call (local action) 41i32))))

	(fn increment (params (value i32)) (returns i32)
		(body (return (i32.inc (local value)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call (specialize invoke (bool false)) (fn-ref increment)))))
)
