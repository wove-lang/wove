(module callable_aliases
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only (type (as Transform ImportedUnary))))

	(type UnaryI32 (fn-type (params i32) (returns i32)))

	(fn apply (params (operation (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call (local operation) (local value)))))

	(fn invoke (params (operation UnaryI32) (value i32)) (returns i32)
		(body (return (call (local operation) (local value)))))

	(fn forward (params (operation UnaryI32) (value i32)) (returns i32)
		(body (return (call apply (local operation) (local value)))))

	(fn UnaryI32 (params (value i32)) (returns i32)
		(body (return (i32.inc (local value)))))

	(fn imported (params (operation ImportedUnary) (value i32)) (returns i32)
		(body (return (call forward (local operation) (local value)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call imported (fn-ref UnaryI32) (call invoke (fn-ref UnaryI32) 40i32)))))
)
