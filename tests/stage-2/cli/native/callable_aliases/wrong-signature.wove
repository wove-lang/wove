(module wrong_signature
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(type UnaryI32 (fn-type (params i32) (returns i32)))

	(fn apply (params (operation (fn-type (params i32) (returns i32))) (value i32)) (returns i32)
		(body (return (call operation value))))

	(fn invoke (params (operation UnaryI32) (value i32)) (returns i32)
		(body (return (call operation value))))

	(fn forward (params (operation UnaryI32) (value i32)) (returns i32)
		(body (return (call apply operation value))))

	(fn unsigned (params (value u32)) (returns i32)
		(body (return (i32.from-u32 value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call forward (fn-ref unsigned) 41i32))))
)
