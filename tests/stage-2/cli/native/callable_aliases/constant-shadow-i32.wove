(module constant_shadow_i32
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(type Op (fn-type (params i32) (returns i32)))
	(fn invoke (generic (const Op i32)) (params (action Op)) (returns i32)
		(body (return (call (local action) 41i32))))

	(fn increment (params (value i32)) (returns i32)
		(body (return (i32.inc (local value)))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call (specialize invoke 0i32) (fn-ref increment)))))
)
