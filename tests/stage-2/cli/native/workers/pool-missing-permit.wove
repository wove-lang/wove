(module pool_missing_permit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn handle (params (job (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local job)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let missing (worker.open-pool 0i32 1i32))
			(let permit (worker.try-reserve (local missing)))
			(let receipt (worker.spawn-on handle (move (local permit)) (array.alloc u8 -1i32)))
			(return 0i32))))
