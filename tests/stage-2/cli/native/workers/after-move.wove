(module worker_rejection
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn handle (params (job (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local job)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let job (array.alloc u8 1i32))
			(let result (worker.spawn-join handle (move (local job))))
			(return (array.len (local job))))))
