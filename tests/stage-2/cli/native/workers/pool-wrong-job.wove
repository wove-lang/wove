(module pool_wrong_job
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn handle (params (job (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local job)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let pool (worker.open-pool 1i32 1i32))
			(let permit (worker.try-reserve (local pool)))
			(let receipt (worker.spawn-on handle (move (local permit)) (array.alloc i32 1i32)))
			(return 0i32))))
