(module joined_worker
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./thread.h" (only worker_first_visit))
	(bridge c-header "./thread.h"
		(fn worker_first_visit (params) (returns i32)))

	(fn widen (params (job (owned-array u8))) (returns (owned-array i32))
		(body
			(let count (array.len (local job)))
			(let-mut values (array.alloc i32 (local count)))
			(if (i32.eqz (call worker_first_visit)) (then (return (move (local values)))))
			(for (bind index) (range 0i32 (local count))
				(body
					(array.store (local values) (local index) (i32.from-u8 (array.load (local job) (local index))))))
			(return (move (local values)))))

	(fn echo (params (job (owned-array u8))) (returns (owned-array u8))
		(body
			(if (i32.eqz (call worker_first_visit)) (then (return (array.alloc u8 1i32))))
			(return (move (local job)))))

	(fn forward (params (job (owned-array u8))) (returns (owned-array i32))
		(body (return (worker.spawn-join widen (move (local job))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq (call worker_first_visit) 1i32) (then (return 1i32)))
			(let-mut job (array.alloc u8 2i32))
			(array.store (local job) 0i32 19u8)
			(array.store (local job) 1i32 23u8)
			(let result (call forward (move (local job))))
			(let empty (worker.spawn-join echo (array.alloc u8 0i32)))
			(if (i32.not-eqz (array.len (local empty))) (then (return 2i32)))
			(if (i32.not-eqz (call worker_first_visit)) (then (return 3i32)))
			(return (i32.add (array.load (local result) 0i32) (array.load (local result) 1i32))))))
