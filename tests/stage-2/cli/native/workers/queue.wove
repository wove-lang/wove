(module worker_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./queue.h" (only queue_enter queue_finish_second_first queue_release_unclaimed queue_finished))
	(bridge c-header "./queue.h"
		(fn queue_enter (params (mask i32)) (returns i32))
		(fn queue_finish_second_first (params) (returns i32))
		(fn queue_release_unclaimed (params) (returns i32))
		(fn queue_finished (params) (returns i32)))

	(struct Digest (fields (item i32) (bytes i32)))

	(fn input (params (id u8)) (returns (owned-array u8))
		(body
			(let-mut items (array.alloc u8 1i32))
			(array.store (local items) 0i32 (local id))
			(return (move (local items)))))

	(fn handle (params (job (owned-array u8))) (returns (owned-array Digest))
		(body
			(let id (i32.from-u8 (array.load (local job) 0i32)))
			(let entered (call queue_enter (local id)))
			(let-mut result (array.alloc Digest 1i32))
			(array.store (local result) 0i32 (struct.new Digest (item (local id)) (bytes (i32.add 18i32 (local id)))))
			(return (move (local result)))))

	(fn handle_same_result (params (job (owned-array u8))) (returns (owned-array Digest))
		(body (return (call handle (move (local job))))))

	(fn empty (params) (returns (owned-array (owned-array Digest)))
		(body
			(let pending (worker.receipt-queue handle))
			(return (worker.join-all (local pending)))))

	(fn ordered (params) (returns (owned-array (owned-array Digest)))
		(body
			(let-mut pending (worker.receipt-queue handle))
			(let first (worker.spawn handle (call input 1u8)))
			(let second (worker.spawn handle_same_result (call input 2u8)))
			(worker.push (local pending) (move (local first)))
			(worker.push (local pending) (move (local second)))
			(let completed (call queue_finish_second_first))
			(if (i32.not-eq (local completed) 2i32) (then (return (call empty))))
			(let moved (move (local pending)))
			(return (worker.join-all (local moved)))))

	(fn unclaimed (params) (returns i32)
		(body
			(let-mut pending (worker.receipt-queue handle))
			(let receipt (worker.spawn handle (call input 4u8)))
			(worker.push (local pending) (move (local receipt)))
			(let released (call queue_release_unclaimed))
			(return 3i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let no_results (call empty))
			(if (i32.not-eqz (array.len (local no_results))) (then (return 1i32)))
			(let results (call ordered))
			(if (i32.not-eq (array.len (local results)) 2i32) (then (return 2i32)))
			(let first (borrow-shared (array.load (local results) 0i32)))
			(let second (borrow-shared (array.load (local results) 1i32)))
			(let one (array.load (local first) 0i32))
			(let two (array.load (local second) 0i32))
			(if (i32.not-eq (struct.get (local one) item) 1i32) (then (return 3i32)))
			(if (i32.not-eq (struct.get (local two) item) 2i32) (then (return 4i32)))
			(let discarded (call unclaimed))
			(if (i32.not-eq (call queue_finished) 7i32) (then (return 5i32)))
			(return (i32.add (i32.add (struct.get (local one) bytes) (struct.get (local two) bytes)) (local discarded))))))
