(module worker_rejection
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn handle (params (job (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local job)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let job (array.alloc i32 1i32))
			(let result (worker.spawn-join handle (move (local job))))
			(return 0i32))))
