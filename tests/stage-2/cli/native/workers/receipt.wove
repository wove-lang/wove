(module submitted_workers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./receipt.h" (only receipt_enter receipt_wait_started receipt_release receipt_finish receipt_completed))
	(bridge c-header "./receipt.h"
		(fn receipt_enter (params (mask i32)) (returns i32))
		(fn receipt_wait_started (params (mask i32)) (returns i32))
		(fn receipt_release (params (mask i32)) (returns i32))
		(fn receipt_finish (params (mask i32)) (returns i32))
		(fn receipt_completed (params) (returns i32)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn make_job (params (mask u8)) (returns (owned-array u8))
		(body
			(let-mut job (array.alloc u8 1i32))
			(array.store (local job) 0i32 (local mask))
			(return (move (local job)))))

	(fn handle (params (job (owned-array u8))) (returns (owned-array i32))
		(body
			(let mask (i32.from-u8 (array.load (local job) 0i32)))
			(let entered (call receipt_enter (local mask)))
			(let-mut result (array.alloc i32 1i32))
			(array.store (local result) 0i32 (local mask))
			(let finished (call receipt_finish (local mask)))
			(return (move (local result)))))

	(fn abandon (params (job (owned-array u8))) (returns void)
		(body
			(if (bool true) (then (let unclaimed (worker.spawn handle (move (local job))))))))

	(fn early (params (job (owned-array u8))) (returns i32)
		(body
			(let unclaimed (worker.spawn handle (move (local job))))
			(return 42i32)))

	(fn collect (params (job (owned-array u8))) (returns (owned-array i32))
		(body
			(let receipt (worker.spawn handle (move (local job))))
			(return (worker.join (local receipt)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let first (worker.spawn handle (call make_job 1u8)))
			(let second (worker.spawn handle (call make_job 2u8)))
			(let ready (call receipt_wait_started 3i32))
			(let released (call receipt_release 31i32))
			(let moved (move (local first)))
			(let right (worker.join (local second)))
			(let left (worker.join (local moved)))
			(if (i32.not-eq (array.load (local left) 0i32) 1i32) (then (return 1i32)))
			(if (i32.not-eq (array.load (local right) 0i32) 2i32) (then (return 2i32)))
			(call abandon (call make_job 4u8))
			(let status (call early (call make_job 8u8)))
			(let last (call collect (call make_job 16u8)))
			(if (i32.not-eq (array.load (local last) 0i32) 16i32) (then (return 3i32)))
			(if (i32.not-eq (call receipt_completed) 31i32) (then (return 4i32)))
			(return (local status)))))
