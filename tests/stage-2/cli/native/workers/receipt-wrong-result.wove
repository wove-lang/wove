(module receipt_validation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn handle (params (job (owned-array u8))) (returns (owned-array i32))
		(body (return (array.alloc i32 (array.len job)))))

	(fn collect (params) (returns (owned-array u8))
		(body
			(let receipt (worker.spawn handle (array.alloc u8 0i32)))
			(return (worker.join receipt))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (let unused (call collect)) (return 0i32))))
