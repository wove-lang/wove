(module receipt_validation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn handle (params (job (owned-array u8))) (returns (owned-array i32))
		(body (return (array.alloc i32 (array.len (local job))))))

	(fn collect (params) (returns (owned-array u8))
		(body
			(let receipt (worker.spawn handle (array.alloc u8 0i32)))
			(return (worker.join (local receipt)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (let unused (call collect)) (return 0i32))))
