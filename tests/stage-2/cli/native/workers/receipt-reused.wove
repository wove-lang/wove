(module receipt_validation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn handle (params (job (owned-array u8))) (returns (owned-array i32))
		(body (return (array.alloc i32 (array.len (local job))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let receipt (worker.spawn handle (array.alloc u8 0i32)))
			(let first (worker.join (local receipt)))
			(let second (worker.join (local receipt)))
			(return 0i32))))
