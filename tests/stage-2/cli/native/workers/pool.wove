(module worker_pool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Digest (fields (value i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn input (params (id u8)) (returns (owned-array u8))
		(body
			(let-mut job (array.alloc u8 1i32))
			(array.store (local job) 0i32 (local id))
			(return (move (local job)))))

	(fn digest (params (job (owned-array u8))) (returns (owned-array Digest))
		(body
			(let id (i32.from-u8 (array.load (local job) 0i32)))
			(let-mut result (array.alloc Digest 1i32))
			(array.store (local result) 0i32 (struct.new Digest (value (local id))))
			(return (move (local result)))))

	(fn collect_mixed (params) (returns i32)
		(body
			(let pool (worker.open-pool (i32.inc 0i32) 1i32))
			(if (owner.is-null (local pool)) (then (return 1i32)))
			(let job (call input 20u8))
			(if (bool true)
				(then
					(let unused (worker.try-reserve (local pool)))
					(if (owner.is-null (local unused)) (then (return 2i32)))
					(let blocked (worker.reserve-wait (local pool)))
					(if (bool.not (owner.is-null (local blocked))) (then (return 3i32)))
					(if (worker.try-close (local pool)) (then (return 4i32)))))
			(let permit (worker.reserve-wait (local pool)))
			(if (owner.is-null (local permit)) (then (return 5i32)))
			(let pooled (worker.spawn-on digest (move (local permit)) (move (local job))))
			(let dedicated (worker.spawn digest (call input 13u8)))
			(let-mut pending (worker.receipt-queue digest))
			(worker.push (local pending) (move (local pooled)))
			(worker.push (local pending) (move (local dedicated)))
			(if (bool.not (worker.try-close (local pool))) (then (return 6i32)))
			(let closed (worker.try-reserve (local pool)))
			(if (bool.not (owner.is-null (local closed))) (then (return 7i32)))
			(let results (worker.join-all (local pending)))
			(let first (borrow-shared (array.load (local results) 0i32)))
			(let second (borrow-shared (array.load (local results) 1i32)))
			(let one (struct.get (array.load (local first) 0i32) value))
			(let two (struct.get (array.load (local second) 0i32) value))
			(if (i32.not-eq (local one) 20i32) (then (return 8i32)))
			(return (i32.add (local one) (local two)))))

	(fn submit_after_pool_scope (params) (returns i32)
		(body
			(let pool (worker.open-pool 1i32 1i32))
			(let reserved (worker.try-reserve (local pool)))
			(let permit (move (local reserved)))
			(if (owner.is-null (local permit)) (then (return 0i32)))
			(if (bool true) (then (let retired (move (local pool)))))
			(let receipt (worker.spawn-on digest (move (local permit)) (call input 9u8)))
			(let result (worker.join (local receipt)))
			(return (struct.get (array.load (local result) 0i32) value))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let missing (worker.open-pool 0i32 1i32))
			(if (bool.not (owner.is-null (local missing))) (then (return 1i32)))
			(let mixed (call collect_mixed))
			(if (i32.not-eq (local mixed) 33i32) (then (return (local mixed))))
			(return (i32.add (local mixed) (call submit_after_pool_scope))))))
