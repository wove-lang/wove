(module worker_pool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Digest (fields (value i32)))

	(fn input (params (id u8)) (returns (owned-array u8))
		(body
			(let-mut job (array:alloc u8 1i32))
			(array:set job 0i32 id)
			(return (move job))))

	(fn digest (params (job (owned-array u8))) (returns (owned-array Digest))
		(body
			(let id (i32:from-u8 (array:get job 0i32)))
			(let-mut result (array:alloc Digest 1i32))
			(array:set result 0i32 (struct:new Digest (value id)))
			(return (move result))))

	(fn collect_mixed (params) (returns i32)
		(body
			(let pool (worker:open-pool (i32:inc 0i32) 1i32))
			(if (owner:is-null pool) (then (return 1i32)))
			(let job (call input 20u8))
			(if (bool true)
				(then
					(let unused (worker:try-reserve pool))
					(if (owner:is-null unused) (then (return 2i32)))
					(let blocked (worker:reserve-wait pool))
					(if (bool:not (owner:is-null blocked)) (then (return 3i32)))
					(if (worker:try-close pool) (then (return 4i32)))))
			(let permit (worker:reserve-wait pool))
			(if (owner:is-null permit) (then (return 5i32)))
			(let pooled (worker:spawn-on digest (move permit) (move job)))
			(let dedicated (worker:spawn digest (call input 13u8)))
			(let-mut pending (worker:receipt-queue digest))
			(worker:push pending (move pooled))
			(worker:push pending (move dedicated))
			(if (bool:not (worker:try-close pool)) (then (return 6i32)))
			(let closed (worker:try-reserve pool))
			(if (bool:not (owner:is-null closed)) (then (return 7i32)))
			(let results (worker:join-all pending))
			(let first (borrow-shared (array:get results 0i32)))
			(let second (borrow-shared (array:get results 1i32)))
			(let one (struct:get (array:get first 0i32) value))
			(let two (struct:get (array:get second 0i32) value))
			(if (i32:not-eq one 20i32) (then (return 8i32)))
			(return (i32:add one two))))

	(fn submit_after_pool_scope (params) (returns i32)
		(body
			(let pool (worker:open-pool 1i32 1i32))
			(let reserved (worker:try-reserve pool))
			(let permit (move reserved))
			(if (owner:is-null permit) (then (return 0i32)))
			(if (bool true) (then (let retired (move pool))))
			(let receipt (worker:spawn-on digest (move permit) (call input 9u8)))
			(let result (worker:join receipt))
			(return (struct:get (array:get result 0i32) value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let missing (worker:open-pool 0i32 1i32))
			(if (bool:not (owner:is-null missing)) (then (return 1i32)))
			(let mixed (call collect_mixed))
			(if (i32:not-eq mixed 33i32) (then (return mixed)))
			(return (i32:add mixed (call submit_after_pool_scope))))))
