(module worker_queue_validation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Digest (fields (length i32)))
	(struct Other (fields (length i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn digests (params (job (owned-array u8))) (returns (owned-array Digest))
		(body (return (array.alloc Digest 0i32))))
	(fn other (params (job (owned-array u8))) (returns (owned-array Other))
		(body (return (array.alloc Other 0i32))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut pending (worker.receipt-queue digests))
			(let receipt (worker.spawn digests (array.alloc u8 0i32)))
			(worker.push (local pending) (move (local receipt)))
			(let again (worker.join (local receipt)))
			(return 0i32))))
