(module selected
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (as available invoke) companion))

	(bridge c-header "./fixture.h"
		(fn available (returns i32) (c-name "native_found") (params) (:pragma (c_optional)))
		(fn companion (:pragma (c_optional)) (params) (returns i32)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (i32.add (call invoke) (call companion))))))
