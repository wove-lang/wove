(module unselected
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only regular))

	(bridge c-header "./fixture.h"
		(fn absent (:pragma (c_optional)) (params) (returns i32))
		(fn regular (params) (returns i32)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call regular)))))
