(module optional_context
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./context.h" (only leading))
	(use c-header "./fixture.h" (only (as available invoke) companion))

	(bridge c-header "./context.h" (fn leading (params) (returns i32)))
	(bridge c-header "./fixture.h"
		(fn available (returns i32) (c-name "native_found") (params) (:pragma (c_optional)))
		(fn companion (:pragma (c_optional)) (params) (returns i32)))

	(fn main (params) (returns i32)
		(body (return (i32.add.wrapping (call leading)
			(i32.add.wrapping (call invoke) (call companion)))))))
