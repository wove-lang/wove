{
	"profiles": [
		{ "name": "default" },
		{
			"name": "native",
			"cc": { "cstd": "c17" },
			"build": {
				"default": {
					"cflags": ["-O0", "-DPROFILE_TEXT=two words"],
					"defines": ["PROFILE_MARKER"],
					"ldflags": ["-pthread"],
					"ldlibs": ["m"],
					"lto": "off",
				},
			},
		},
	],
}
