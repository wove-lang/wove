(module bundled_fenv_common
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fenv.h>"
		(only (type Environment) (type ExceptionFlags)
			feclearexcept fegetexceptflag feraiseexcept fesetexceptflag fetestexcept
			fegetround fesetround fegetenv feholdexcept fesetenv feupdateenv
			fesetenv_default feupdateenv_default
			(value FE_ALL_EXCEPT) (value FE_DIVBYZERO) (value FE_DOWNWARD)
			(value FE_INEXACT) (value FE_INVALID) (value FE_OVERFLOW)
			(value FE_TONEAREST) (value FE_TOWARDZERO) (value FE_UNDERFLOW) (value FE_UPWARD)))
	(use c-header "<math.h>" (only nearbyint))
	(use c-header "./constants.h" (only native_fenv_constant))
	(bridge c-header "./constants.h"
		(fn native_fenv_constant (params (index i32)) (returns i32)))


	(fn rounding_is (params (mode i32) (positive f64) (negative f64)) (returns bool)
		(body
			(if (i32:not-eqz (call fesetround mode)) (then (return (bool false))))
			(if (i32:not-eq (call fegetround) mode) (then (return (bool false))))
			(return (bool:and (f64:eq (call nearbyint 1.5f64) positive)
				(f64:eq (call nearbyint -1.5f64) negative)))))

	(fn check_rounding (params) (returns i32)
		(body
			(let constants (array:new (array i32 10)
				FE_ALL_EXCEPT FE_DIVBYZERO FE_DOWNWARD
				FE_INEXACT FE_INVALID FE_OVERFLOW
				FE_TONEAREST FE_TOWARDZERO FE_UNDERFLOW FE_UPWARD))
			(let-mut index 0i32)
			(while (i32:lt index (array:len constants))
				(body
					(if (i32:not-eq (array:get constants index) (call native_fenv_constant index))
						(then (return (i32:add 2i32 index))))
					(set index (i32:inc index))))
			(if (bool:not (call rounding_is FE_DOWNWARD 1.0f64 -2.0f64)) (then (return 12i32)))
			(if (bool:not (call rounding_is FE_UPWARD 2.0f64 -1.0f64)) (then (return 13i32)))
			(if (bool:not (call rounding_is FE_TOWARDZERO 1.0f64 -1.0f64)) (then (return 14i32)))
			(if (bool:not (call rounding_is FE_TONEAREST 2.0f64 -2.0f64)) (then (return 15i32)))
			(return 0i32)))

	(fn check_exceptions (params) (returns i32)
		(body
			(let all FE_ALL_EXCEPT)
			(let each (array:new (array i32 5)
				FE_DIVBYZERO FE_INEXACT FE_INVALID
				FE_OVERFLOW FE_UNDERFLOW))
			(let-mut index 0i32)
			(while (i32:lt index (array:len each))
				(body
					(let bit (array:get each index))
					(if (i32:not-eqz (call feclearexcept all)) (then (return 16i32)))
					(if (i32:not-eqz (call fetestexcept all)) (then (return 17i32)))
					(if (i32:not-eqz (call feraiseexcept bit)) (then (return 18i32)))
					(if (i32:not-eq (call fetestexcept bit) bit) (then (return 19i32)))
					(set index (i32:inc index))))
			(let selected (i32:or FE_INVALID FE_DIVBYZERO))
			(let-mut flags (struct:new ExceptionFlags))
			(if (i32:not-eqz (call feclearexcept all)) (then (return 20i32)))
			(if (i32:not-eqz (call feraiseexcept selected)) (then (return 21i32)))
			(if (i32:not-eqz (call fegetexceptflag (borrow-mut flags) selected)) (then (return 22i32)))
			(if (i32:not-eqz (call feclearexcept all)) (then (return 23i32)))
			(if (i32:not-eqz (call feraiseexcept FE_INEXACT)) (then (return 24i32)))
			(if (i32:not-eqz (call fesetexceptflag (borrow-shared flags) selected)) (then (return 25i32)))
			(if (i32:not-eq (call fetestexcept (i32:or selected FE_INEXACT))
				(i32:or selected FE_INEXACT)) (then (return 26i32)))
			(return 0i32)))

	(fn check_environment (params) (returns i32)
		(body
			(let invalid FE_INVALID)
			(let all FE_ALL_EXCEPT)
			(let-mut downward (struct:new Environment))
			(let-mut held (struct:new Environment))
			(if (i32:not-eqz (call fesetround FE_DOWNWARD)) (then (return 27i32)))
			(if (i32:not-eqz (call fegetenv (borrow-mut downward))) (then (return 28i32)))
			(if (i32:not-eqz (call fesetround FE_UPWARD)) (then (return 29i32)))
			(if (i32:not-eqz (call feraiseexcept invalid)) (then (return 30i32)))
			(if (i32:not-eqz (call fesetenv (borrow-shared downward))) (then (return 31i32)))
			(if (i32:not-eq (call fegetround) FE_DOWNWARD) (then (return 32i32)))
			(if (i32:not-eqz (call fetestexcept all)) (then (return 33i32)))
			(if (i32:not-eqz (call feraiseexcept invalid)) (then (return 34i32)))
			(if (i32:not-eqz (call feholdexcept (borrow-mut held))) (then (return 35i32)))
			(if (i32:not-eqz (call fetestexcept all)) (then (return 36i32)))
			(if (i32:not-eqz (call fesetenv (borrow-shared held))) (then (return 37i32)))
			(if (i32:not-eq (call fetestexcept invalid) invalid) (then (return 38i32)))
			(if (i32:not-eqz (call fesetround FE_UPWARD)) (then (return 39i32)))
			(if (i32:not-eqz (call feupdateenv (borrow-shared downward))) (then (return 40i32)))
			(if (i32:not-eq (call fegetround) FE_DOWNWARD) (then (return 45i32)))
			(if (i32:not-eq (call fetestexcept invalid) invalid) (then (return 46i32)))
			(if (i32:not-eqz (call feupdateenv_default)) (then (return 47i32)))
			(if (i32:not-eq (call fegetround) FE_TONEAREST) (then (return 48i32)))
			(if (i32:not-eq (call fetestexcept invalid) invalid) (then (return 49i32)))
			(if (i32:not-eqz (call fesetenv_default)) (then (return 50i32)))
			(if (i32:not-eqz (call fetestexcept all)) (then (return 51i32)))
			(return 0i32)))

	(fn check_mode (params (mode i32)) (returns i32)
		(body
			(if (i32:not-eqz (call fesetenv_default)) (then (return 52i32)))
			(if (i32:eqz mode) (then (return (call check_rounding))))
			(if (i32:eq mode 1i32) (then (return (call check_exceptions))))
			(return (call check_environment))))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut original (struct:new Environment))
			(if (i32:not-eqz (call feholdexcept (borrow-mut original))) (then (return 1i32)))
			(let mode (i32:dec (array:len args)))
			(let result (call check_mode mode))
			(if (i32:not-eqz (call fesetenv (borrow-shared original))) (then (return 53i32)))
			(if (i32:not-eqz result) (then (return result)))
			(return (i32:add 42i32 mode)))))
