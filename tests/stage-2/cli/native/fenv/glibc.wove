(module bundled_fenv_glibc
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fenv.h>" (only (type Environment) feholdexcept fesetenv))
	(use (:pragma (cfg (os "linux"))) c-header "<fenv.h>"
		(only (type ExceptionFlags) (type ControlModes)
			feclearexcept fegetexceptflag fetestexcept
			fegetround fesetround fesetenv_default
			fesetexcept fetestexceptflag fegetmode fesetmode fesetmode_default
			feenableexcept fedisableexcept fegetexcept fesetenv_nomask feupdateenv_nomask
			(value FE_ALL_EXCEPT) (value FE_DIVBYZERO) (value FE_DOWNWARD)
			(value FE_INVALID) (value FE_TONEAREST) (value FE_UPWARD)))
	(use (:pragma (cfg (all (os "linux") (arch "aarch64")))) c-header "<fenv.h>"
		(only (value FE_EXCEPT_SHIFT)))
	(use (:pragma (cfg (os "linux"))) c-header "./glibc.h" (only native_fenv_nomask))
	(use (:pragma (cfg (all (os "linux") (arch "aarch64")))) c-header "./glibc.h"
		(only native_fenv_except_shift))
	(bridge c-header "./glibc.h" (:pragma (cfg (os "linux")))
		(fn native_fenv_nomask (params (update i32)) (returns i32))
		(fn native_fenv_except_shift (:pragma (cfg (arch "aarch64"))) (params) (returns i32)))


	(fn check_flags_and_modes (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let all FE_ALL_EXCEPT)
			(let invalid FE_INVALID)
			(let divzero FE_DIVBYZERO)
			(let-mut flags (struct:new ExceptionFlags))
			(let-mut modes (struct:new ControlModes))
			(if (i32:not-eqz (call fesetexcept invalid)) (then (return 2i32)))
			(if (i32:not-eq (call fetestexcept all) invalid) (then (return 3i32)))
			(if (i32:not-eqz (call fegetexceptflag (borrow-mut flags) all)) (then (return 4i32)))
			(if (i32:not-eqz (call feclearexcept all)) (then (return 5i32)))
			(if (i32:not-eqz (call fesetexcept divzero)) (then (return 6i32)))
			(if (i32:not-eq (call fetestexceptflag (borrow-shared flags) all) invalid)
				(then (return 7i32)))
			(if (i32:not-eqz (call fetestexceptflag (borrow-shared flags) divzero))
				(then (return 8i32)))
			(if (i32:not-eqz (call fesetround FE_DOWNWARD)) (then (return 9i32)))
			(if (i32:not-eqz (call fegetmode (borrow-mut modes))) (then (return 10i32)))
			(if (i32:not-eqz (call fesetround FE_UPWARD)) (then (return 11i32)))
			(if (i32:not-eqz (call fesetmode (borrow-shared modes))) (then (return 12i32)))
			(if (i32:not-eq (call fegetround) FE_DOWNWARD) (then (return 13i32)))
			(if (i32:not-eq (call fetestexcept all) divzero) (then (return 14i32)))
			(if (i32:not-eqz (call fesetmode_default)) (then (return 15i32)))
			(if (i32:not-eq (call fegetround) FE_TONEAREST) (then (return 16i32)))
			(if (i32:not-eq (call fetestexcept all) divzero) (then (return 17i32)))
			(return 0i32)))

	(fn allows_unavailable_traps (:pragma (cfg (all (os "linux") (arch "aarch64")))) (params) (returns bool)
		(body (return (bool true))))

	(fn allows_unavailable_traps (:pragma (cfg (all (os "linux") (not (arch "aarch64"))))) (params) (returns bool)
		(body (return (bool false))))

	(fn check_mask (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let bit FE_DIVBYZERO)
			(if (i32:not-eqz (call fegetexcept)) (then (return 18i32)))
			(let previous (call feenableexcept bit))
			(let current (call fegetexcept))
			(let disabled (call fedisableexcept bit))
			(if (i32:not-eqz (call fegetexcept)) (then (return 19i32)))
			(if (bool:and (i32:eq previous -1i32) (call allows_unavailable_traps))
				(then (if (i32:eqz (i32:or current disabled)) (then (return 0i32)))))
			(if (i32:not-eqz previous) (then (return 20i32)))
			(if (i32:not-eq current bit) (then (return 21i32)))
			(if (i32:not-eq disabled bit) (then (return 22i32)))
			(return 0i32)))

	(fn check_nomask (:pragma (cfg (os "linux"))) (params (update i32)) (returns i32)
		(body
			(let expected (call native_fenv_nomask update))
			(let expected_mask (call fegetexcept))
			(if (i32:not-eqz (call fesetenv_default)) (then (return 23i32)))
			(let-mut status 0i32)
			(if (i32:eqz update)
				(then (set status (call fesetenv_nomask)))
				(else (set status (call feupdateenv_nomask))))
			(let mask (call fegetexcept))
			(if (i32:not-eqz (call fesetenv_default)) (then (return 24i32)))
			(if (i32:not-eq status expected) (then (return 25i32)))
			(if (i32:not-eq mask expected_mask) (then (return 26i32)))
			(return 0i32)))

	(fn check_shift (:pragma (cfg (all (os "linux") (arch "aarch64")))) (params) (returns i32)
		(body
			(if (i32:not-eq FE_EXCEPT_SHIFT (call native_fenv_except_shift)) (then (return 27i32)))
			(return 0i32)))

	(fn check_shift (:pragma (cfg (all (os "linux") (not (arch "aarch64"))))) (params) (returns i32)
		(body (return 0i32)))

	(fn check_extensions (:pragma (cfg (os "linux"))) (params (mode i32)) (returns i32)
		(body
			(if (i32:not-eqz (call fesetenv_default)) (then (return 28i32)))
			(if (i32:eqz mode) (then (return (call check_flags_and_modes))))
			(let mask_status (call check_mask))
			(if (i32:not-eqz mask_status) (then (return mask_status)))
			(let install_status (call check_nomask 0i32))
			(if (i32:not-eqz install_status) (then (return install_status)))
			(let update_status (call check_nomask 1i32))
			(if (i32:not-eqz update_status) (then (return update_status)))
			(return (call check_shift))))

	(fn check_extensions (:pragma (cfg (not (os "linux")))) (params (mode i32)) (returns i32)
		(body (return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (i32:dec (array:len args)))
			(let-mut original (struct:new Environment))
			(if (i32:not-eqz (call feholdexcept (borrow-mut original))) (then (return 1i32)))
			(let result (call check_extensions mode))
			(if (i32:not-eqz (call fesetenv (borrow-shared original))) (then (return 29i32)))
			(if (i32:not-eqz result) (then (return result)))
			(return (i32:add 42i32 mode)))))
