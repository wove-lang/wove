(module bundled_fenv_darwin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fenv.h>" (only (type Environment) feholdexcept fesetenv))
	(use (:pragma (cfg (os "macos"))) c-header "<fenv.h>"
		(only fesetenv_default feraiseexcept fetestexcept (value FE_ALL_EXCEPT) (value FE_INVALID)))
	(use (:pragma (cfg (all (os "macos") (arch "aarch64")))) c-header "<fenv.h>"
		(only (as fesetenv_disable_denorms set_no_denormals)
			(as feupdateenv_disable_denorms update_no_denormals)
			(value (as FE_FLUSHTOZERO DenormalFlag))))
	(use (:pragma (cfg (all (os "macos") (arch "x86_64")))) c-header "<fenv.h>"
		(only (as fesetenv_disable_sse_denorms set_no_denormals)
			(as feupdateenv_disable_sse_denorms update_no_denormals)
			(value (as FE_DENORMALOPERAND DenormalFlag))))
	(use (:pragma (cfg (os "macos"))) c-header "./darwin.h"
		(only native_fenv_denormal_flag native_fenv_subnormal))
	(bridge c-header "./darwin.h" (:pragma (cfg (os "macos")))
		(fn native_fenv_denormal_flag (params) (returns i32))
		(fn native_fenv_subnormal (params) (returns f64)))


	(fn check_presets (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(if (i32.not-eq (call native_fenv_denormal_flag) DenormalFlag) (then (return 2i32)))
			(if (i32.not-eqz (call fesetenv_default)) (then (return 3i32)))
			(if (bool.not (f64.gt (call native_fenv_subnormal) 0.0f64)) (then (return 4i32)))
			(if (i32.not-eqz (call feraiseexcept FE_INVALID)) (then (return 5i32)))
			(if (i32.not-eqz (call set_no_denormals)) (then (return 6i32)))
			(if (i32.not-eqz (call fetestexcept FE_ALL_EXCEPT)) (then (return 7i32)))
			(if (f64.not-eq (call native_fenv_subnormal) 0.0f64) (then (return 8i32)))
			(if (i32.not-eqz (call fesetenv_default)) (then (return 9i32)))
			(if (i32.not-eqz (call feraiseexcept FE_INVALID)) (then (return 10i32)))
			(if (i32.not-eqz (call update_no_denormals)) (then (return 11i32)))
			(if (i32.not-eq (call fetestexcept FE_INVALID) FE_INVALID) (then (return 12i32)))
			(if (f64.not-eq (call native_fenv_subnormal) 0.0f64) (then (return 13i32)))
			(return 0i32)))

	(fn check_presets (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut original (struct.new Environment))
			(if (i32.not-eqz (call feholdexcept (borrow-mut original))) (then (return 1i32)))
			(let result (call check_presets))
			(if (i32.not-eqz (call fesetenv (borrow-shared original))) (then (return 14i32)))
			(if (i32.not-eqz result) (then (return result)))
			(return 42i32))))
