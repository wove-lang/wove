(module stdint_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (type Int8) (type UInt8) (type Int16) (type UInt16)
			(type Int32) (type UInt32) (type Int64) (type UInt64)
			(type IntLeast8) (type UIntLeast8) (type IntLeast16) (type UIntLeast16)
			(type IntLeast32) (type UIntLeast32) (type IntLeast64) (type UIntLeast64)
			(type IntFast8) (type UIntFast8) (type IntFast16) (type UIntFast16)
			(type IntFast32) (type UIntFast32) (type IntFast64) (type UIntFast64)
			(type IntPtr) (type UIntPtr) (type IntMax) (type UIntMax)
			(type Long) (type ULong)
			(value INT8_MIN) (value INT8_MAX) (value UINT8_MAX)
			(value INT16_MIN) (value INT16_MAX) (value UINT16_MAX)
			(value INT32_MIN) (value INT32_MAX) (value UINT32_MAX)
			(value INT64_MIN) (value INT64_MAX) (value UINT64_MAX)
			(value INT_LEAST8_MIN) (value INT_LEAST8_MAX) (value UINT_LEAST8_MAX)
			(value INT_LEAST16_MIN) (value INT_LEAST16_MAX) (value UINT_LEAST16_MAX)
			(value INT_LEAST32_MIN) (value INT_LEAST32_MAX) (value UINT_LEAST32_MAX)
			(value INT_LEAST64_MIN) (value INT_LEAST64_MAX) (value UINT_LEAST64_MAX)
			(value INT_FAST8_MIN) (value INT_FAST8_MAX) (value UINT_FAST8_MAX)
			(value INT_FAST16_MIN) (value INT_FAST16_MAX) (value UINT_FAST16_MAX)
			(value INT_FAST32_MIN) (value INT_FAST32_MAX) (value UINT_FAST32_MAX)
			(value INT_FAST64_MIN) (value INT_FAST64_MAX) (value UINT_FAST64_MAX)
			(value INTPTR_MIN) (value INTPTR_MAX) (value UINTPTR_MAX)
			(value INTMAX_MIN) (value INTMAX_MAX) (value UINTMAX_MAX)
			(value PTRDIFF_MIN) (value PTRDIFF_MAX) (value SIZE_MAX)
			(value SIG_ATOMIC_MIN) (value SIG_ATOMIC_MAX) (value WCHAR_MIN) (value WCHAR_MAX)
			(value WINT_MIN) (value WINT_MAX)
			INT8_C UINT8_C INT16_C UINT16_C INT32_C UINT32_C INT64_C UINT64_C INTMAX_C UINTMAX_C))
	(use c-header "./oracle.h"
		(only fixture_bounds8 fixture_bounds16 fixture_bounds32 fixture_bounds64
			fixture_least8 fixture_least16 fixture_least32 fixture_least64
			fixture_fast8 fixture_fast16 fixture_fast32 fixture_fast64
			fixture_pointer_limits fixture_maximum_limits
			fixture_traditional_limits fixture_wchar_limits fixture_wint_limits))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER"
			(only (type Int8) (type UInt8) (type Int16) (type UInt16)
				(type Int32) (type UInt32) (type Int64) (type UInt64)
				(type IntLeast8) (type UIntLeast8) (type IntLeast16) (type UIntLeast16)
				(type IntLeast32) (type UIntLeast32) (type IntLeast64) (type UIntLeast64)
				(type IntFast8) (type UIntFast8) (type IntFast16) (type UIntFast16)
				(type IntFast32) (type UIntFast32) (type IntFast64) (type UIntFast64)
				(type IntPtr) (type UIntPtr) (type IntMax) (type UIntMax) (type Long) (type ULong)))
		(fn fixture_bounds8 (params (minimum Int8) (maximum Int8) (unsigned_maximum UInt8))
			(returns bool))
		(fn fixture_bounds16 (params (minimum Int16) (maximum Int16) (unsigned_maximum UInt16))
			(returns bool))
		(fn fixture_bounds32 (params (minimum Int32) (maximum Int32) (unsigned_maximum UInt32))
			(returns bool))
		(fn fixture_bounds64 (params (minimum Int64) (maximum Int64) (unsigned_maximum UInt64))
			(returns bool))
		(fn fixture_least8
			(params (minimum IntLeast8) (maximum IntLeast8) (unsigned_maximum UIntLeast8)) (returns bool))
		(fn fixture_least16
			(params (minimum IntLeast16) (maximum IntLeast16) (unsigned_maximum UIntLeast16)) (returns bool))
		(fn fixture_least32
			(params (minimum IntLeast32) (maximum IntLeast32) (unsigned_maximum UIntLeast32)) (returns bool))
		(fn fixture_least64
			(params (minimum IntLeast64) (maximum IntLeast64) (unsigned_maximum UIntLeast64)) (returns bool))
		(fn fixture_fast8
			(params (minimum IntFast8) (maximum IntFast8) (unsigned_maximum UIntFast8)) (returns bool))
		(fn fixture_fast16
			(params (minimum IntFast16) (maximum IntFast16) (unsigned_maximum UIntFast16)) (returns bool))
		(fn fixture_fast32
			(params (minimum IntFast32) (maximum IntFast32) (unsigned_maximum UIntFast32)) (returns bool))
		(fn fixture_fast64
			(params (minimum IntFast64) (maximum IntFast64) (unsigned_maximum UIntFast64)) (returns bool))
		(fn fixture_pointer_limits
			(params (minimum IntPtr) (maximum IntPtr) (unsigned_maximum UIntPtr)) (returns bool))
		(fn fixture_maximum_limits
			(params (minimum IntMax) (maximum IntMax) (unsigned_maximum UIntMax)) (returns bool))
		(fn fixture_traditional_limits
			(params (pointer_minimum Long) (pointer_maximum Long) (size_maximum ULong)
				(signal_minimum i32) (signal_maximum i32)) (returns bool))
		(fn fixture_wchar_limits
			(:pragma (cfg (all (os "linux") (arch "aarch64"))))
			(params (minimum u32) (maximum u32)) (returns bool))
		(fn fixture_wchar_limits
			(:pragma (cfg (any (os "macos") (all (os "linux") (arch "x86_64")))))
			(params (minimum i32) (maximum i32)) (returns bool))
		(fn fixture_wint_limits
			(:pragma (cfg (os "linux")))
			(params (minimum u32) (maximum u32)) (returns bool))
		(fn fixture_wint_limits
			(:pragma (cfg (os "macos")))
			(params (minimum i32) (maximum i32)) (returns bool)))

	(fn check_bounds8 (params (minimum i32) (maximum i32) (unsigned_maximum i32)) (returns bool)
		(body
			(return (call fixture_bounds8 (int.convert Int8 minimum) (int.convert Int8 maximum)
				(int.convert UInt8 unsigned_maximum)))))

	(fn check_bounds16 (params (minimum i32) (maximum i32) (unsigned_maximum i32)) (returns bool)
		(body
			(return (call fixture_bounds16 (int.convert Int16 minimum) (int.convert Int16 maximum)
				(int.convert UInt16 unsigned_maximum)))))

	(fn check_bounds32 (params (minimum i32) (maximum i32) (unsigned_maximum u32)) (returns bool)
		(body
			(return (call fixture_bounds32 (int.convert Int32 minimum) (int.convert Int32 maximum)
				(int.convert UInt32 unsigned_maximum)))))

	(fn check_least8
		(params (minimum i32) (maximum i32) (unsigned_maximum i32)) (returns bool)
		(body
			(return (call fixture_least8 (int.convert IntLeast8 minimum) (int.convert IntLeast8 maximum)
				(int.convert UIntLeast8 unsigned_maximum)))))

	(fn check_least16
		(params (minimum i32) (maximum i32) (unsigned_maximum i32)) (returns bool)
		(body
			(return (call fixture_least16 (int.convert IntLeast16 minimum) (int.convert IntLeast16 maximum)
				(int.convert UIntLeast16 unsigned_maximum)))))

	(fn check_least32
		(params (minimum i32) (maximum i32) (unsigned_maximum u32)) (returns bool)
		(body
			(return (call fixture_least32 (int.convert IntLeast32 minimum) (int.convert IntLeast32 maximum)
				(int.convert UIntLeast32 unsigned_maximum)))))

	(fn check_fast8
		(params (minimum i32) (maximum i32) (unsigned_maximum i32)) (returns bool)
		(body
			(return (call fixture_fast8 (int.convert IntFast8 minimum) (int.convert IntFast8 maximum)
				(int.convert UIntFast8 unsigned_maximum)))))

	(fn check_fast16
		(:pragma (cfg (os "macos")))
		(params (minimum i32) (maximum i32) (unsigned_maximum i32)) (returns bool)
		(body
			(return (call fixture_fast16 (int.convert IntFast16 minimum) (int.convert IntFast16 maximum)
				(int.convert UIntFast16 unsigned_maximum)))))

	(fn check_fast16
		(:pragma (cfg (os "linux")))
		(params (minimum IntFast16) (maximum IntFast16) (unsigned_maximum UIntFast16)) (returns bool)
		(body (return (call fixture_fast16 minimum maximum unsigned_maximum))))

	(fn check_fast32
		(:pragma (cfg (os "macos")))
		(params (minimum i32) (maximum i32) (unsigned_maximum u32)) (returns bool)
		(body
			(return (call fixture_fast32 (int.convert IntFast32 minimum) (int.convert IntFast32 maximum)
				(int.convert UIntFast32 unsigned_maximum)))))

	(fn check_fast32
		(:pragma (cfg (os "linux")))
		(params (minimum IntFast32) (maximum IntFast32) (unsigned_maximum UIntFast32)) (returns bool)
		(body (return (call fixture_fast32 minimum maximum unsigned_maximum))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_bounds8 INT8_MIN INT8_MAX UINT8_MAX))
				(then (return 1i32)))
			(if (bool.not (call check_bounds16 INT16_MIN INT16_MAX UINT16_MAX))
				(then (return 2i32)))
			(if (bool.not (call check_bounds32 INT32_MIN INT32_MAX UINT32_MAX))
				(then (return 3i32)))
			(if (bool.not (call fixture_bounds64 INT64_MIN INT64_MAX UINT64_MAX))
				(then (return 4i32)))
			(if (bool.not (call check_least8 INT_LEAST8_MIN INT_LEAST8_MAX UINT_LEAST8_MAX))
				(then (return 5i32)))
			(if (bool.not (call check_least16 INT_LEAST16_MIN INT_LEAST16_MAX UINT_LEAST16_MAX))
				(then (return 6i32)))
			(if (bool.not (call check_least32 INT_LEAST32_MIN INT_LEAST32_MAX UINT_LEAST32_MAX))
				(then (return 7i32)))
			(if (bool.not (call fixture_least64 INT_LEAST64_MIN INT_LEAST64_MAX UINT_LEAST64_MAX))
				(then (return 8i32)))
			(if (bool.not (call check_fast8 INT_FAST8_MIN INT_FAST8_MAX UINT_FAST8_MAX))
				(then (return 9i32)))
			(if (bool.not (call check_fast16 INT_FAST16_MIN INT_FAST16_MAX UINT_FAST16_MAX))
				(then (return 10i32)))
			(if (bool.not (call check_fast32 INT_FAST32_MIN INT_FAST32_MAX UINT_FAST32_MAX))
				(then (return 11i32)))
			(if (bool.not (call fixture_fast64 INT_FAST64_MIN INT_FAST64_MAX UINT_FAST64_MAX))
				(then (return 12i32)))
			(if (bool.not (call fixture_pointer_limits INTPTR_MIN INTPTR_MAX UINTPTR_MAX))
				(then (return 13i32)))
			(if (bool.not (call fixture_maximum_limits INTMAX_MIN INTMAX_MAX UINTMAX_MAX))
				(then (return 14i32)))
			(if (bool.not (call fixture_traditional_limits PTRDIFF_MIN PTRDIFF_MAX SIZE_MAX SIG_ATOMIC_MIN SIG_ATOMIC_MAX))
				(then (return 15i32)))
			(if (bool.not (call fixture_wchar_limits WCHAR_MIN WCHAR_MAX))
				(then (return 16i32)))
			(if (bool.not (call fixture_wint_limits WINT_MIN WINT_MAX))
				(then (return 17i32)))
			(if (bool.not (bool.and (i32.eq (call INT8_C 0i8) 0i32)
					(i32.eq (call INT8_C 0x7fi8) 127i32)))
				(then (return 18i32)))
			(if (bool.not (bool.and (i32.eq (call UINT8_C 0u8) 0i32)
					(i32.eq (call UINT8_C 255u8) 255i32)))
				(then (return 19i32)))
			(if (bool.not (bool.and (i32.eq (call INT16_C 0i16) 0i32)
					(i32.eq (call INT16_C 32767i16) 32767i32)))
				(then (return 20i32)))
			(if (bool.not (bool.and (i32.eq (call UINT16_C 0u16) 0i32)
					(i32.eq (call UINT16_C 0b1111_1111_1111_1111u16) 65535i32)))
				(then (return 21i32)))
			(if (bool.not (bool.and (i32.eq (call INT32_C 0i32) 0i32)
					(i32.eq (call INT32_C 2147483647i32) 2147483647i32)))
				(then (return 22i32)))
			(if (bool.not (bool.and (u32.eq (call UINT32_C 0u32) 0u32)
					(u32.eq (call UINT32_C 0XFFFF_FFFFu32) 4294967295u32)))
				(then (return 23i32)))
			(if (bool.not (bool.and (i64.eq (int.convert i64 (call INT64_C 0i64)) 0i64)
					(i64.eq (int.convert i64 (call INT64_C (i64 9_223_372_036_854_775_807))) 9223372036854775807i64)))
				(then (return 24i32)))
			(if (bool.not (bool.and (u64.eq (int.convert u64 (call UINT64_C 0u64)) 0u64)
					(u64.eq (int.convert u64 (call UINT64_C (u64 0xffff_ffff_ffff_ffff))) 18446744073709551615u64)))
				(then (return 25i32)))
			(if (bool.not (bool.and (i64.eq (int.convert i64 (call INTMAX_C 0i64)) 0i64)
					(i64.eq (int.convert i64 (call INTMAX_C 9223372036854775807i64)) 9223372036854775807i64)))
				(then (return 26i32)))
			(if (bool.not (bool.and (u64.eq (int.convert u64 (call UINTMAX_C 0u64)) 0u64)
					(u64.eq (int.convert u64 (call UINTMAX_C 18446744073709551615u64)) 18446744073709551615u64)))
				(then (return 27i32)))
			(return 42i32))))
