(module stdint_widths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (value INT8_WIDTH) (value UINT8_WIDTH) (value INT16_WIDTH)
			(value UINT16_WIDTH) (value INT32_WIDTH) (value UINT32_WIDTH)
			(value INT64_WIDTH) (value UINT64_WIDTH)
			(value INT_LEAST8_WIDTH) (value UINT_LEAST8_WIDTH) (value INT_LEAST16_WIDTH)
			(value UINT_LEAST16_WIDTH) (value INT_LEAST32_WIDTH) (value UINT_LEAST32_WIDTH)
			(value INT_LEAST64_WIDTH) (value UINT_LEAST64_WIDTH)
			(value INT_FAST8_WIDTH) (value UINT_FAST8_WIDTH) (value INT_FAST16_WIDTH)
			(value UINT_FAST16_WIDTH) (value INT_FAST32_WIDTH) (value UINT_FAST32_WIDTH)
			(value INT_FAST64_WIDTH) (value UINT_FAST64_WIDTH)
			(value INTPTR_WIDTH) (value UINTPTR_WIDTH) (value INTMAX_WIDTH)
			(value UINTMAX_WIDTH)
			(value PTRDIFF_WIDTH) (value SIG_ATOMIC_WIDTH) (value SIZE_WIDTH)
			(value WCHAR_WIDTH) (value WINT_WIDTH)))
	(use c-header "./oracle.h"
		(only fixture_widths_exact fixture_widths_least fixture_widths_fast
			fixture_widths_pointer_maximum fixture_widths_traditional))

	(bridge c-header "./oracle.h"
		(fn fixture_widths_exact
			(params (signed8 i32) (unsigned8 i32) (signed16 i32) (unsigned16 i32)
				(signed32 i32) (unsigned32 i32) (signed64 i32) (unsigned64 i32)) (returns bool))
		(fn fixture_widths_least
			(params (signed8 i32) (unsigned8 i32) (signed16 i32) (unsigned16 i32)
				(signed32 i32) (unsigned32 i32) (signed64 i32) (unsigned64 i32)) (returns bool))
		(fn fixture_widths_fast
			(params (signed8 i32) (unsigned8 i32) (signed16 i32) (unsigned16 i32)
				(signed32 i32) (unsigned32 i32) (signed64 i32) (unsigned64 i32)) (returns bool))
		(fn fixture_widths_pointer_maximum
			(params (intptr i32) (uintptr i32) (intmax i32) (uintmax i32)) (returns bool))
		(fn fixture_widths_traditional
			(params (ptrdiff i32) (sig_atomic i32) (size i32) (wchar i32)
				(wint i32)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call fixture_widths_exact
					INT8_WIDTH UINT8_WIDTH INT16_WIDTH UINT16_WIDTH
					INT32_WIDTH UINT32_WIDTH INT64_WIDTH UINT64_WIDTH))
				(then (return 1i32)))
			(if (bool.not (call fixture_widths_least
					INT_LEAST8_WIDTH UINT_LEAST8_WIDTH INT_LEAST16_WIDTH UINT_LEAST16_WIDTH
					INT_LEAST32_WIDTH UINT_LEAST32_WIDTH INT_LEAST64_WIDTH UINT_LEAST64_WIDTH))
				(then (return 2i32)))
			(if (bool.not (call fixture_widths_fast
					INT_FAST8_WIDTH UINT_FAST8_WIDTH INT_FAST16_WIDTH UINT_FAST16_WIDTH
					INT_FAST32_WIDTH UINT_FAST32_WIDTH INT_FAST64_WIDTH UINT_FAST64_WIDTH))
				(then (return 3i32)))
			(if (bool.not (call fixture_widths_pointer_maximum
					INTPTR_WIDTH UINTPTR_WIDTH INTMAX_WIDTH UINTMAX_WIDTH))
				(then (return 4i32)))
			(if (bool.not (call fixture_widths_traditional
					PTRDIFF_WIDTH SIG_ATOMIC_WIDTH SIZE_WIDTH WCHAR_WIDTH
					WINT_WIDTH))
				(then (return 5i32)))
			(return 42i32))))
