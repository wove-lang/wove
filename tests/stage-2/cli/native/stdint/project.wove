(module project_stdint
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(type Int8 (c-type "int8_t"))
		(type UInt8 (c-type "uint8_t"))
		(type Int16 (c-type "int16_t"))
		(type UInt16 (c-type "uint16_t"))
		(type Int32 (c-type "int32_t"))
		(type UInt32 (c-type "uint32_t"))
		(type Int64 (c-type "int64_t"))
		(type UInt64 (c-type "uint64_t"))

		(const INT8_MIN i32)
		(const INT8_MAX i32)
		(const UINT8_MAX i32)

		(const INT16_MIN i32)
		(const INT16_MAX i32)
		(const UINT16_MAX i32)

		(const INT32_MIN i32)
		(const INT32_MAX i32)
		(const UINT32_MAX u32)

		(const INT64_MIN Int64)
		(const INT64_MAX Int64)
		(const UINT64_MAX UInt64)

		(type IntLeast8 (c-type "int_least8_t"))
		(type UIntLeast8 (c-type "uint_least8_t"))
		(type IntLeast16 (c-type "int_least16_t"))
		(type UIntLeast16 (c-type "uint_least16_t"))
		(type IntLeast32 (c-type "int_least32_t"))
		(type UIntLeast32 (c-type "uint_least32_t"))
		(type IntLeast64 (c-type "int_least64_t"))
		(type UIntLeast64 (c-type "uint_least64_t"))

		(type IntFast8 (c-type "int_fast8_t"))
		(type UIntFast8 (c-type "uint_fast8_t"))
		(type IntFast16 (c-type "int_fast16_t"))
		(type UIntFast16 (c-type "uint_fast16_t"))
		(type IntFast32 (c-type "int_fast32_t"))
		(type UIntFast32 (c-type "uint_fast32_t"))
		(type IntFast64 (c-type "int_fast64_t"))
		(type UIntFast64 (c-type "uint_fast64_t"))

		(const INT_LEAST8_MIN i32)
		(const INT_LEAST8_MAX i32)
		(const UINT_LEAST8_MAX i32)

		(const INT_LEAST16_MIN i32)
		(const INT_LEAST16_MAX i32)
		(const UINT_LEAST16_MAX i32)

		(const INT_LEAST32_MIN i32)
		(const INT_LEAST32_MAX i32)
		(const UINT_LEAST32_MAX u32)

		(const INT_LEAST64_MIN IntLeast64)
		(const INT_LEAST64_MAX IntLeast64)
		(const UINT_LEAST64_MAX UIntLeast64)

		(const INT_FAST8_MIN i32)
		(const INT_FAST8_MAX i32)
		(const UINT_FAST8_MAX i32)

		(decls
			(:pragma (cfg (os "macos")))
			(const INT_FAST16_MIN i32)
			(const INT_FAST16_MAX i32)
			(const UINT_FAST16_MAX i32)

			(const INT_FAST32_MIN i32)
			(const INT_FAST32_MAX i32)
			(const UINT_FAST32_MAX u32))

		(decls
			(:pragma (cfg (os "linux")))
			(const INT_FAST16_MIN IntFast16)
			(const INT_FAST16_MAX IntFast16)
			(const UINT_FAST16_MAX UIntFast16)

			(const INT_FAST32_MIN IntFast32)
			(const INT_FAST32_MAX IntFast32)
			(const UINT_FAST32_MAX UIntFast32))

		(const INT_FAST64_MIN IntFast64)
		(const INT_FAST64_MAX IntFast64)
		(const UINT_FAST64_MAX UIntFast64)

		(type IntPtr (c-type "intptr_t"))
		(type UIntPtr (c-type "uintptr_t"))
		(const INTPTR_MIN IntPtr)
		(const INTPTR_MAX IntPtr)
		(const UINTPTR_MAX UIntPtr)

		(type IntMax (c-type "intmax_t"))
		(type UIntMax (c-type "uintmax_t"))
		(const INTMAX_MIN IntMax)
		(const INTMAX_MAX IntMax)
		(const UINTMAX_MAX UIntMax)

		(type Long (c-type "long"))
		(type ULong (c-type "unsigned long"))
		(const PTRDIFF_MIN Long)
		(const PTRDIFF_MAX Long)
		(const SIZE_MAX ULong)
		(const SIG_ATOMIC_MIN i32)
		(const SIG_ATOMIC_MAX i32)

		(decls
			(:pragma (cfg (all (os "linux") (arch "aarch64"))))
			(const WCHAR_MIN u32)
			(const WCHAR_MAX u32))

		(decls
			(:pragma (cfg (any (os "macos") (all (os "linux") (arch "x86_64")))))
			(const WCHAR_MIN i32)
			(const WCHAR_MAX i32))

		(decls
			(:pragma (cfg (os "linux")))
			(const WINT_MIN u32)
			(const WINT_MAX u32))

		(decls
			(:pragma (cfg (os "macos")))
			(const WINT_MIN i32)
			(const WINT_MAX i32))))
