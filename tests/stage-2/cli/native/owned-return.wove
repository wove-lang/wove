(module owned_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns void)
		(body (slice.store (local data) (local index) (local value))))

	(fn create
		(params (size i32) (early bool))
		(returns (owned-array u8))
		(body
			(let-mut result (array.alloc u8 (local size)))
			(let scratch (array.alloc u8 (i32 1)))
			(if (i32.eq (local size) (i32 0))
				(then (return (move (local result)))))
			(slice.store (local result) (i32 0) (u8 41))
			(if (i32.lt (i32 1) (local size))
				(then (slice.store (local result) (call size (borrow-shared (local scratch))) (u8 43))))
			(if (local early)
				(then
					(let nested (array.alloc u8 (i32 1)))
					(return (move (local result)))))
			(let replacement (move (local result)))
			(return (move (local replacement)))))

	(fn forward
		(params (size i32) (early bool))
		(returns (owned-array u8))
		(body
			(let scratch (array.alloc u8 (i32 1)))
			(return (call create (local size) (local early)))))

	(fn size
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local data)))))

	(fn byte_at
		(params (data (shared-slice u8)) (index i32))
		(returns u8)
		(body (return (slice.load (local data) (local index)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let early (call create (i32 1) (bool true)))
			(if (bool.not (u8.eq (call byte_at (borrow-shared (local early)) (i32 0)) (u8 41)))
				(then (return (i32 1))))
			(let empty (call forward (i32 0) (bool false)))
			(if (bool.not (i32.eq (call size (borrow-shared (local empty))) (i32 0)))
				(then (return (i32 2))))
			(let-mut data (call forward (i32 2) (bool false)))
			(if (bool.not (i32.eq (call size (borrow-shared (local data))) (i32 2)))
				(then (return (i32 3))))
			(if (bool.not (u8.eq (call byte_at (borrow-shared (local data)) (i32 0)) (u8 41)))
				(then (return (i32 4))))
			(if (bool.not (u8.eq (call byte_at (borrow-shared (local data)) (i32 1)) (u8 43)))
				(then (return (i32 5))))
			(call put (borrow-mut (local data)) (i32 1) (u8 42))
			(let moved (move (local data)))
			(return (int.convert i32 (call byte_at (borrow-shared (local moved)) (i32 1)))))))
