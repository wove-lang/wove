(module owned_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body (array.store data index value)))

	(fn create
		(params (length i32) (early bool))
		(returns (owned-array u8))
		(body
			(let-mut result (array.alloc u8 length))
			(let scratch (array.alloc u8 (i32 1)))
			(if (i32.eq length (i32 0))
				(then (return (move result))))
			(array.store result (i32 0) (u8 41))
			(if (i32.lt (i32 1) length)
				(then (array.store result (call size (borrow-shared scratch)) (u8 43))))
			(if early
				(then
					(let nested (array.alloc u8 (i32 1)))
					(return (move result))))
			(let replacement (move result))
			(return (move replacement))))

	(fn forward
		(params (size i32) (early bool))
		(returns (owned-array u8))
		(body
			(let scratch (array.alloc u8 (i32 1)))
			(return (call create size early))))

	(fn size
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array.len data))))

	(fn byte_at
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body (return (array.load data index))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let early (call create (i32 1) (bool true)))
			(if (bool.not (u8.eq (call byte_at (borrow-shared early) (i32 0)) (u8 41)))
				(then (return (i32 1))))
			(let empty (call forward (i32 0) (bool false)))
			(if (bool.not (i32.eq (call size (borrow-shared empty)) (i32 0)))
				(then (return (i32 2))))
			(let-mut data (call forward (i32 2) (bool false)))
			(if (bool.not (i32.eq (call size (borrow-shared data)) (i32 2)))
				(then (return (i32 3))))
			(if (bool.not (u8.eq (call byte_at (borrow-shared data) (i32 0)) (u8 41)))
				(then (return (i32 4))))
			(if (bool.not (u8.eq (call byte_at (borrow-shared data) (i32 1)) (u8 43)))
				(then (return (i32 5))))
			(call put (borrow-mut data) (i32 1) (u8 42))
			(let moved (move data))
			(return (int.convert i32 (call byte_at (borrow-shared moved) (i32 1)))))))
