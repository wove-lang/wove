	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./unrelated.h" (only))
	(use c-header "./fixture.h" (only (type (as Packet View))))
	(bridge c-header "./unrelated.h")
	(bridge c-header "./fixture.h"
		(struct (:pragma (c_optional)) Packet (c-type "struct packet") (fields (value i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
