(module optional_record_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (type (as Packet Value)) (type Variant) (type Alias)
			(type Early) (type Nested) (type NestedVariant)))
	(bridge c-header "./fixture.h"
		(use c-header "./feature.h" (only))
		(struct Packet (:pragma (c_optional)) (c-type "  struct\tpacket  ") (fields (value i32)))
		(struct Variant (:pragma (c_optional)) (c-type "union variant") (fields (value i32)))
		(struct Alias (:pragma (c_optional)) (c-type "packet_alias") (fields (value i32)))
		(struct Early (:pragma (c_optional)) (c-type "packet_before_definition") (fields (value i32)))
		(struct Nested (:pragma (c_optional)) (c-type "struct nested_record") (fields (value i32)))
		(struct NestedVariant (:pragma (c_optional)) (c-type "union nested_variant") (fields (value i32))))
	(bridge c-header "./feature.h")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let tagged (struct.new Value (value 13i32)))
			(let variant (struct.new Variant (value 14i32)))
			(let aliased (struct.new Alias (value 15i32)))
			(let early (struct.new Early (value 21i32)))
			(let nested (struct.new Nested (value 22i32)))
			(let nested_variant (struct.new NestedVariant (value 23i32)))
			(if (i32.not-eq (struct.get early value) 21i32) (then (return 1i32)))
			(if (i32.not-eq (struct.get nested value) 22i32) (then (return 2i32)))
			(if (i32.not-eq (struct.get nested_variant value) 23i32) (then (return 3i32)))
			(return (i32.add (struct.get tagged value)
				(i32.add (struct.get variant value) (struct.get aliased value)))))))
