(module resource_priority
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type PriorityId) (type PriorityWhich)
		getpriority setpriority PRIO_PROCESS PRIO_PGRP PRIO_USER))
	(use c-header "<errno.h>" (only errno EINVAL))
	(use c-header "./oracle.h" (only fixture_priority_selectors fixture_priority_pid fixture_priority_matches))

	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type PriorityId) (type PriorityWhich)))
		(fn fixture_priority_selectors
			(params (process PriorityWhich) (group PriorityWhich) (user PriorityWhich)) (returns bool))
		(fn fixture_priority_pid (params) (returns PriorityId))
		(fn fixture_priority_matches (params (id PriorityId) (expected i32)) (returns bool)))

	(fn main
		(:doc "Change the priority of this fixture subprocess only.")
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_priority_selectors PRIO_PROCESS PRIO_PGRP PRIO_USER))
				(then (return 1i32)))
			(let pid (call fixture_priority_pid))
			(if (int:eq PriorityId pid (int:convert PriorityId 0u32)) (then (return 2i32)))
			(set errno 0i32)
			(let original (call getpriority PRIO_PROCESS (int:convert PriorityId 0u32)))
			(let read_error errno)
			(if (i32:not-eqz read_error) (then (return 3i32)))
			(if (bool:not (call fixture_priority_matches pid original)) (then (return 4i32)))

			(let invalid (int:convert PriorityWhich 999i32))
			(set errno 0i32)
			(let bad_get (call getpriority invalid pid))
			(let get_error errno)
			(if (bool:or (i32:not-eq bad_get -1i32) (i32:not-eq get_error EINVAL))
				(then (return 5i32)))
			(set errno 0i32)
			(let bad_set (call setpriority invalid pid original))
			(let set_error errno)
			(if (bool:or (i32:not-eq bad_set -1i32) (i32:not-eq set_error EINVAL))
				(then (return 6i32)))

			(let-mut next original)
			(if (i32:lt original 19i32) (then (set next (i32:inc original))))
			(if (i32:not-eqz (call setpriority PRIO_PROCESS pid next)) (then (return 7i32)))
			(set errno 0i32)
			(let updated (call getpriority PRIO_PROCESS pid))
			(let update_error errno)
			(if (bool:or (i32:not-eq updated next) (i32:not-eqz update_error)) (then (return 8i32)))
			(if (bool:not (call fixture_priority_matches pid updated)) (then (return 9i32)))
			(return 42i32))))
