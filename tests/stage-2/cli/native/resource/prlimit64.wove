(module explicit_process_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type LimitPid) (type LimitKind)
		(type LimitValue64) (type ResourceLimit64) RLIMIT_NOFILE getrlimit64 prlimit64))
	(use c-header "<errno.h>" (only errno EINVAL))

	(fn main
		(:doc "Exercise both nullable slots while changing only this fixture subprocess.")
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let pid (int:convert LimitPid 0i32))
			(let-mut original (struct:new ResourceLimit64))
			(if (i32:not-eqz (call prlimit64 pid RLIMIT_NOFILE null (borrow-mut original))) (then (return 1i32)))
			(if (i32:not-eqz (call prlimit64 pid RLIMIT_NOFILE null null)) (then (return 2i32)))
			(let old_count (int:convert u64 original/rlim_cur))
			(if (u64:eqz old_count) (then (return 3i32)))
			(let-mut new_count 64u64)
			(if (u64:lt old_count 65u64) (then (set new_count (u64:dec old_count))))
			(let next (struct:new ResourceLimit64 (rlim_cur (int:convert LimitValue64 new_count))
				(rlim_max original/rlim_max)))
			(if (i32:not-eqz (call prlimit64 pid RLIMIT_NOFILE (borrow-shared next) null)) (then (return 4i32)))
			(let-mut observed (struct:new ResourceLimit64))
			(if (i32:not-eqz (call getrlimit64 RLIMIT_NOFILE (borrow-mut observed))) (then (return 5i32)))
			(if (bool:or (int:not-eq LimitValue64 observed/rlim_cur next/rlim_cur)
				(int:not-eq LimitValue64 observed/rlim_max original/rlim_max))
				(then (return 6i32)))

			(let-mut previous (struct:new ResourceLimit64))
			(if (i32:not-eqz (call prlimit64 pid RLIMIT_NOFILE (borrow-shared original) (borrow-mut previous)))
				(then (return 7i32)))
			(if (bool:or (int:not-eq LimitValue64 previous/rlim_cur next/rlim_cur)
				(int:not-eq LimitValue64 previous/rlim_max original/rlim_max))
				(then (return 8i32)))
			(if (i32:not-eqz (call getrlimit64 RLIMIT_NOFILE (borrow-mut observed))) (then (return 9i32)))
			(if (bool:or (int:not-eq LimitValue64 observed/rlim_cur original/rlim_cur)
				(int:not-eq LimitValue64 observed/rlim_max original/rlim_max))
				(then (return 10i32)))

			(set errno 0i32)
			(let status (call prlimit64 pid (int:convert LimitKind 999i32) null null))
			(let saved errno)
			(if (bool:or (i32:not-eq status -1i32) (i32:not-eq saved EINVAL)) (then (return 11i32)))
			(return 42i32))))
