(module native_io_policy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only getiopolicy_np setiopolicy_np
			IOPOL_TYPE_DISK
			IOPOL_TYPE_VFS_ATIME_UPDATES
			IOPOL_TYPE_VFS_MATERIALIZE_DATALESS_FILES
			IOPOL_TYPE_VFS_STATFS_NO_DATA_VOLUME
			IOPOL_TYPE_VFS_TRIGGER_RESOLVE
			IOPOL_TYPE_VFS_CONTENT_PROTECTION
			IOPOL_TYPE_VFS_IGNORE_PERMISSIONS
			IOPOL_TYPE_VFS_SKIP_MTIME_UPDATE
			IOPOL_TYPE_VFS_ALLOW_LOW_SPACE_WRITES
			IOPOL_TYPE_VFS_DISALLOW_RW_FOR_O_EVTONLY
			IOPOL_TYPE_VFS_ENTITLED_RESERVE_ACCESS
			IOPOL_TYPE_VFS_IGNORE_CONTENT_PROTECTION
			IOPOL_SCOPE_PROCESS
			IOPOL_SCOPE_THREAD
			IOPOL_SCOPE_DARWIN_BG
			IOPOL_DEFAULT
			IOPOL_IMPORTANT
			IOPOL_PASSIVE
			IOPOL_THROTTLE
			IOPOL_UTILITY
			IOPOL_STANDARD
			IOPOL_APPLICATION
			IOPOL_NORMAL
			IOPOL_ATIME_UPDATES_DEFAULT
			IOPOL_ATIME_UPDATES_OFF
			IOPOL_MATERIALIZE_DATALESS_FILES_DEFAULT
			IOPOL_MATERIALIZE_DATALESS_FILES_OFF
			IOPOL_MATERIALIZE_DATALESS_FILES_ON
			IOPOL_MATERIALIZE_DATALESS_FILES_ORIG
			IOPOL_MATERIALIZE_DATALESS_FILES_BASIC_MASK
			IOPOL_VFS_STATFS_NO_DATA_VOLUME_DEFAULT
			IOPOL_VFS_STATFS_FORCE_NO_DATA_VOLUME
			IOPOL_VFS_TRIGGER_RESOLVE_DEFAULT
			IOPOL_VFS_TRIGGER_RESOLVE_OFF
			IOPOL_VFS_CONTENT_PROTECTION_DEFAULT
			IOPOL_VFS_CONTENT_PROTECTION_IGNORE
			IOPOL_VFS_CONTENT_PROTECTION_STRICT
			IOPOL_VFS_IGNORE_PERMISSIONS_OFF
			IOPOL_VFS_IGNORE_PERMISSIONS_ON
			IOPOL_VFS_SKIP_MTIME_UPDATE_OFF
			IOPOL_VFS_SKIP_MTIME_UPDATE_ON
			IOPOL_VFS_SKIP_MTIME_UPDATE_IGNORE
			IOPOL_VFS_ALLOW_LOW_SPACE_WRITES_OFF
			IOPOL_VFS_ALLOW_LOW_SPACE_WRITES_ON
			IOPOL_VFS_DISALLOW_RW_FOR_O_EVTONLY_DEFAULT
			IOPOL_VFS_DISALLOW_RW_FOR_O_EVTONLY_ON
			IOPOL_VFS_NOCACHE_WRITE_FS_BLKSIZE_DEFAULT
			IOPOL_VFS_NOCACHE_WRITE_FS_BLKSIZE_ON
			IOPOL_VFS_ENTITLED_RESERVE_ACCESS_OFF
			IOPOL_VFS_ENTITLED_RESERVE_ACCESS_ON))
	(use c-header "<errno.h>" (only errno EINVAL))
	(use c-header "./oracle.h" (only fixture_iopol_value fixture_iopol_matches))
	(bridge c-header "./oracle.h"
		(fn fixture_iopol_value (params (index i32) (value i32)) (returns bool))
		(fn fixture_iopol_matches (params (io_type i32) (scope i32) (observed i32)) (returns bool)))

	(fn constants (params) (returns bool)
		(body
			(let values (array:new (array i32 50)
				IOPOL_TYPE_DISK
				IOPOL_TYPE_VFS_ATIME_UPDATES
				IOPOL_TYPE_VFS_MATERIALIZE_DATALESS_FILES
				IOPOL_TYPE_VFS_STATFS_NO_DATA_VOLUME
				IOPOL_TYPE_VFS_TRIGGER_RESOLVE
				IOPOL_TYPE_VFS_CONTENT_PROTECTION
				IOPOL_TYPE_VFS_IGNORE_PERMISSIONS
				IOPOL_TYPE_VFS_SKIP_MTIME_UPDATE
				IOPOL_TYPE_VFS_ALLOW_LOW_SPACE_WRITES
				IOPOL_TYPE_VFS_DISALLOW_RW_FOR_O_EVTONLY
				IOPOL_TYPE_VFS_ENTITLED_RESERVE_ACCESS
				IOPOL_TYPE_VFS_IGNORE_CONTENT_PROTECTION
				IOPOL_SCOPE_PROCESS
				IOPOL_SCOPE_THREAD
				IOPOL_SCOPE_DARWIN_BG
				IOPOL_DEFAULT
				IOPOL_IMPORTANT
				IOPOL_PASSIVE
				IOPOL_THROTTLE
				IOPOL_UTILITY
				IOPOL_STANDARD
				IOPOL_APPLICATION
				IOPOL_NORMAL
				IOPOL_ATIME_UPDATES_DEFAULT
				IOPOL_ATIME_UPDATES_OFF
				IOPOL_MATERIALIZE_DATALESS_FILES_DEFAULT
				IOPOL_MATERIALIZE_DATALESS_FILES_OFF
				IOPOL_MATERIALIZE_DATALESS_FILES_ON
				IOPOL_MATERIALIZE_DATALESS_FILES_ORIG
				IOPOL_MATERIALIZE_DATALESS_FILES_BASIC_MASK
				IOPOL_VFS_STATFS_NO_DATA_VOLUME_DEFAULT
				IOPOL_VFS_STATFS_FORCE_NO_DATA_VOLUME
				IOPOL_VFS_TRIGGER_RESOLVE_DEFAULT
				IOPOL_VFS_TRIGGER_RESOLVE_OFF
				IOPOL_VFS_CONTENT_PROTECTION_DEFAULT
				IOPOL_VFS_CONTENT_PROTECTION_IGNORE
				IOPOL_VFS_CONTENT_PROTECTION_STRICT
				IOPOL_VFS_IGNORE_PERMISSIONS_OFF
				IOPOL_VFS_IGNORE_PERMISSIONS_ON
				IOPOL_VFS_SKIP_MTIME_UPDATE_OFF
				IOPOL_VFS_SKIP_MTIME_UPDATE_ON
				IOPOL_VFS_SKIP_MTIME_UPDATE_IGNORE
				IOPOL_VFS_ALLOW_LOW_SPACE_WRITES_OFF
				IOPOL_VFS_ALLOW_LOW_SPACE_WRITES_ON
				IOPOL_VFS_DISALLOW_RW_FOR_O_EVTONLY_DEFAULT
				IOPOL_VFS_DISALLOW_RW_FOR_O_EVTONLY_ON
				IOPOL_VFS_NOCACHE_WRITE_FS_BLKSIZE_DEFAULT
				IOPOL_VFS_NOCACHE_WRITE_FS_BLKSIZE_ON
				IOPOL_VFS_ENTITLED_RESERVE_ACCESS_OFF
				IOPOL_VFS_ENTITLED_RESERVE_ACCESS_ON))
			(for (let index value) (borrow-shared values)
				(body
					(if (bool:not (call fixture_iopol_value index value))
						(then (return (bool false))))))
			(return (bool:and (i32:eq IOPOL_NORMAL IOPOL_IMPORTANT)
				(bool:and (i32:eq IOPOL_APPLICATION IOPOL_STANDARD)
					(i32:eq IOPOL_TYPE_VFS_IGNORE_CONTENT_PROTECTION IOPOL_TYPE_VFS_CONTENT_PROTECTION))))))

	(fn main
		(:doc "Use the native policy calls only on the test subprocess and its current thread.")
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call constants)) (then (return 1i32)))
			(set errno 0i32)
			(let process_policy (call getiopolicy_np IOPOL_TYPE_DISK IOPOL_SCOPE_PROCESS))
			(let process_error errno)
			(if (bool:or (i32:ltz process_policy) (i32:not-eqz process_error)) (then (return 2i32)))
			(if (bool:not (call fixture_iopol_matches IOPOL_TYPE_DISK IOPOL_SCOPE_PROCESS process_policy))
				(then (return 3i32)))
			(set errno 0i32)
			(let thread_policy (call getiopolicy_np IOPOL_TYPE_DISK IOPOL_SCOPE_THREAD))
			(let thread_error errno)
			(if (bool:or (i32:ltz thread_policy) (i32:not-eqz thread_error)) (then (return 4i32)))
			(if (bool:not (call fixture_iopol_matches IOPOL_TYPE_DISK IOPOL_SCOPE_THREAD thread_policy))
				(then (return 5i32)))

			(let-mut next IOPOL_THROTTLE)
			(if (i32:eq process_policy IOPOL_THROTTLE) (then (set next IOPOL_PASSIVE)))
			(if (i32:not-eqz (call setiopolicy_np IOPOL_TYPE_DISK IOPOL_SCOPE_PROCESS next))
				(then (return 6i32)))
			(set errno 0i32)
			(let observed (call getiopolicy_np IOPOL_TYPE_DISK IOPOL_SCOPE_PROCESS))
			(let update_error errno)
			(if (bool:or (i32:not-eq observed next) (i32:not-eqz update_error)) (then (return 7i32)))
			(if (bool:not (call fixture_iopol_matches IOPOL_TYPE_DISK IOPOL_SCOPE_PROCESS next))
				(then (return 8i32)))

			(set errno 0i32)
			(let bad_get (call getiopolicy_np 999i32 IOPOL_SCOPE_PROCESS))
			(let get_error errno)
			(if (bool:or (i32:not-eq bad_get -1i32) (i32:not-eq get_error EINVAL)) (then (return 9i32)))
			(set errno 0i32)
			(let bad_set (call setiopolicy_np 999i32 IOPOL_SCOPE_PROCESS IOPOL_THROTTLE))
			(let set_error errno)
			(if (bool:or (i32:not-eq bad_set -1i32) (i32:not-eq set_error EINVAL)) (then (return 10i32)))
			(return 42i32))))
