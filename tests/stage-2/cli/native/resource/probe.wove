(module resource_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (type ResourceWho) (type ResourceUsage)
			getrusage (value RUSAGE_SELF) (value RUSAGE_CHILDREN)))
	(use c-header "<sys/time.h>" (only (type TimevalSeconds) (type TimevalMicros)))
	(use c-header "./oracle.h"
		(only fixture_seed_usage fixture_usage_selectors fixture_usage_status fixture_match_usage))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER"
			(only (type ResourceWho) (type ResourceUsage)))
		(use c-header "<sys/time.h>" (only (type TimevalSeconds) (type TimevalMicros)))
		(fn fixture_seed_usage (params (usage (mut-ref ResourceUsage))) (returns void))
		(fn fixture_usage_selectors (params (self ResourceWho) (children ResourceWho)) (returns bool))
		(fn fixture_usage_status (params (who ResourceWho)) (returns i32))
		(fn fixture_match_usage
			(params (usage (shared-ref ResourceUsage)) (user_seconds TimevalSeconds) (user_micros TimevalMicros)
				(system_seconds TimevalSeconds) (system_micros TimevalMicros))
			(returns bool)))

	(fn check_seed (params) (returns i32)
		(body
			(let-mut usage (struct:new ResourceUsage))
			(call fixture_seed_usage (borrow-mut usage))
			(let user (struct:get usage ru_utime))
			(let system (struct:get usage ru_stime))
			(if (bool:not (int:eq TimevalSeconds (struct:get user tv_sec) (int:convert TimevalSeconds 4294967307u64)))
				(then (return 1i32)))
			(if (bool:not (int:eq TimevalMicros (struct:get user tv_usec) (int:convert TimevalMicros 123456i32)))
				(then (return 2i32)))
			(if (bool:not (int:eq TimevalSeconds (struct:get system tv_sec) (int:convert TimevalSeconds 4294967309u64)))
				(then (return 3i32)))
			(if (bool:not (int:eq TimevalMicros (struct:get system tv_usec) (int:convert TimevalMicros 654321i32)))
				(then (return 4i32)))
			(return 0i32)))

	(fn check_usage (params (who ResourceWho)) (returns bool)
		(body
			(let-mut usage (struct:new ResourceUsage))
			(call fixture_seed_usage (borrow-mut usage))
			(let actual (call getrusage who (borrow-mut usage)))
			(if (i32:not-eqz actual) (then (return (bool false))))
			(if (i32:not-eq actual (call fixture_usage_status who)) (then (return (bool false))))
			(let user (struct:get usage ru_utime))
			(let system (struct:get usage ru_stime))
			(return (call fixture_match_usage (borrow-shared usage)
				(struct:get user tv_sec) (struct:get user tv_usec)
				(struct:get system tv_sec) (struct:get system tv_usec)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let seed_status (call check_seed))
			(if (i32:not-eqz seed_status) (then (return seed_status)))
			(if (bool:not (call fixture_usage_selectors RUSAGE_SELF RUSAGE_CHILDREN)) (then (return 5i32)))
			(if (bool:not (call check_usage RUSAGE_SELF)) (then (return 6i32)))
			(if (bool:not (call check_usage RUSAGE_CHILDREN)) (then (return 7i32)))
			(let-mut failure (struct:new ResourceUsage))
			(let invalid (int:convert ResourceWho 999i32))
			(let status (call getrusage invalid (borrow-mut failure)))
			(if (bool:or (i32:not-eq status -1i32) (i32:not-eq status (call fixture_usage_status invalid)))
				(then (return 8i32)))
			(return 42i32))))
