(module explicit_resource_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type LimitValue64) (type ResourceLimit64) (type LimitKind)
		RLIMIT_NOFILE RLIM64_INFINITY getrlimit64 setrlimit64))
	(use c-header "<errno.h>" (only errno EINVAL))
	(use c-header "./oracle.h" (only fixture_limit64_sentinel fixture_limit64_matches))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type LimitKind) (type LimitValue64)))
		(fn fixture_limit64_sentinel (params (value LimitValue64)) (returns bool))
		(fn fixture_limit64_matches
			(params (resource LimitKind) (current LimitValue64) (maximum LimitValue64)) (returns bool)))

	(fn main
		(:doc "Lower the soft file descriptor limit only in this fixture subprocess.")
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_limit64_sentinel RLIM64_INFINITY)) (then (return 1i32)))
			(let-mut original (struct:new ResourceLimit64))
			(if (i32:not-eqz (call getrlimit64 RLIMIT_NOFILE (borrow-mut original))) (then (return 2i32)))
			(if (bool:not (call fixture_limit64_matches RLIMIT_NOFILE original/rlim_cur original/rlim_max))
				(then (return 3i32)))

			(let invalid (int:convert LimitKind 999i32))
			(let-mut rejected (struct:new ResourceLimit64))
			(set errno 0i32)
			(let bad_get (call getrlimit64 invalid (borrow-mut rejected)))
			(let get_error errno)
			(if (bool:or (i32:not-eq bad_get -1i32) (i32:not-eq get_error EINVAL)) (then (return 4i32)))
			(set errno 0i32)
			(let bad_set (call setrlimit64 invalid (borrow-shared original)))
			(let set_error errno)
			(if (bool:or (i32:not-eq bad_set -1i32) (i32:not-eq set_error EINVAL)) (then (return 5i32)))

			(let old_count (int:convert u64 original/rlim_cur))
			(if (u64:eqz old_count) (then (return 6i32)))
			(let-mut new_count 64u64)
			(if (u64:lt old_count 65u64) (then (set new_count (u64:dec old_count))))
			(let next (struct:new ResourceLimit64 (rlim_cur (int:convert LimitValue64 new_count))
				(rlim_max original/rlim_max)))
			(if (i32:not-eqz (call setrlimit64 RLIMIT_NOFILE (borrow-shared next))) (then (return 7i32)))
			(let-mut observed (struct:new ResourceLimit64))
			(if (i32:not-eqz (call getrlimit64 RLIMIT_NOFILE (borrow-mut observed))) (then (return 8i32)))
			(if (bool:or (int:not-eq LimitValue64 observed/rlim_cur next/rlim_cur)
				(int:not-eq LimitValue64 observed/rlim_max original/rlim_max))
				(then (return 9i32)))
			(if (bool:not (call fixture_limit64_matches RLIMIT_NOFILE observed/rlim_cur observed/rlim_max))
				(then (return 10i32)))
			(return 42i32))))
