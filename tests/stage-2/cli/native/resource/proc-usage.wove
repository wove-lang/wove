(module darwin_process_usage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only
		(type RusageInfoV0) (type RusageInfoV1) (type RusageInfoV2) (type RusageInfoV3)
		(type RusageInfoV4) (type RusageInfoV5) (type RusageInfoCurrent)
		RUSAGE_INFO_V0 RUSAGE_INFO_V1 RUSAGE_INFO_V2 RUSAGE_INFO_V3 RUSAGE_INFO_V4 RUSAGE_INFO_V5
		RUSAGE_INFO_CURRENT RU_PROC_RUNS_RESLIDE))
	(use c-header TEST_SELECTOR (only proc_pid_rusage_v0 proc_pid_rusage_v1 proc_pid_rusage_v2
		proc_pid_rusage_v3 proc_pid_rusage_v4 proc_pid_rusage_v5 proc_pid_rusage_current))
	(use c-header "<unistd.h>" (only getpid))
	(use c-header "<errno.h>" (only errno ESRCH))
	(use c-header "./oracle.h" (only fixture_proc_usage_values))

	(bridge c-header "./oracle.h"
		(fn fixture_proc_usage_values
			(params (v0 i32) (v1 i32) (v2 i32) (v3 i32) (v4 i32) (v5 i32)
				(current i32) (reslide i32)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_proc_usage_values RUSAGE_INFO_V0 RUSAGE_INFO_V1 RUSAGE_INFO_V2
				RUSAGE_INFO_V3 RUSAGE_INFO_V4 RUSAGE_INFO_V5 RUSAGE_INFO_CURRENT RU_PROC_RUNS_RESLIDE))
				(then (return 1i32)))
			(let pid (int:convert i32 (call getpid)))
			(let-mut v0 (struct:new RusageInfoV0))
			(if (i32:not-eqz (call proc_pid_rusage_v0 pid (borrow-mut v0))) (then (return 2i32)))
			(let start v0/ri_proc_start_abstime)
			(if (u64:eqz start)
				(then (return 3i32)))
			(let-mut v1 (struct:new RusageInfoV1))
			(if (bool:or (i32:not-eqz (call proc_pid_rusage_v1 pid (borrow-mut v1)))
				(u64:not-eq start v1/ri_proc_start_abstime)) (then (return 4i32)))
			(let-mut v2 (struct:new RusageInfoV2))
			(if (bool:or (i32:not-eqz (call proc_pid_rusage_v2 pid (borrow-mut v2)))
				(u64:not-eq start v2/ri_proc_start_abstime)) (then (return 5i32)))
			(let-mut v3 (struct:new RusageInfoV3))
			(if (bool:or (i32:not-eqz (call proc_pid_rusage_v3 pid (borrow-mut v3)))
				(u64:not-eq start v3/ri_proc_start_abstime)) (then (return 6i32)))
			(let-mut v4 (struct:new RusageInfoV4))
			(if (bool:or (i32:not-eqz (call proc_pid_rusage_v4 pid (borrow-mut v4)))
				(u64:not-eq start v4/ri_proc_start_abstime)) (then (return 7i32)))
			(let-mut v5 (struct:new RusageInfoV5 (ri_flags 18446744073709551615u64)))
			(if (bool:or (i32:not-eqz (call proc_pid_rusage_v5 pid (borrow-mut v5)))
				(u64:not-eq start v5/ri_proc_start_abstime)) (then (return 8i32)))
			(if (u64:eq v5/ri_flags 18446744073709551615u64) (then (return 9i32)))
			(let-mut current (struct:new RusageInfoCurrent))
			(if (bool:or (i32:not-eqz (call proc_pid_rusage_current pid (borrow-mut current)))
				(u64:not-eq start current/ri_proc_start_abstime)) (then (return 10i32)))
			(set errno 0i32)
			(let missing (call proc_pid_rusage_current 2147483647i32 (borrow-mut current)))
			(let native_error errno)
			(if (bool:or (i32:not-eq missing -1i32) (i32:not-eq native_error ESRCH)) (then (return 11i32)))
			(if (u64:not-eq start current/ri_proc_start_abstime) (then (return 12i32)))
			(return 42i32))))
