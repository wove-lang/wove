(module resource_priority_sentinel
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type PriorityId) (type PriorityWhich)
		getpriority PRIO_PROCESS PRIO_PGRP PRIO_USER))
	(use c-header "<errno.h>" (only errno EINVAL))
	(use c-header "./oracle.h" (only fixture_priority_selectors))

	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type PriorityWhich)))
		(fn fixture_priority_selectors
			(params (process PriorityWhich) (group PriorityWhich) (user PriorityWhich)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_priority_selectors PRIO_PROCESS PRIO_PGRP PRIO_USER))
				(then (return 1i32)))
			(let self (int:convert PriorityId 0u32))
			(set errno 0i32)
			(let priority (call getpriority PRIO_PROCESS self))
			(let success_errno errno)
			(if (bool:or (i32:not-eq priority -1i32) (i32:not-eqz success_errno))
				(then (return 2i32)))
			(set errno 0i32)
			(let failure (call getpriority (int:convert PriorityWhich 999i32) self))
			(let failure_errno errno)
			(if (bool:or (i32:not-eq failure -1i32) (i32:not-eq failure_errno EINVAL))
				(then (return 3i32)))
			(return 42i32))))
