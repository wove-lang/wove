(module project_resource
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(use c-header "<sys/time.h>" (only (type Timeval)))

		(type ResourceWho (:pragma (cfg (os "macos"))) (c-type "int"))
		(type ResourceWho (:pragma (cfg (os "linux"))) (c-type "__rusage_who_t"))
		(type ResourceCount (c-type "long"))
		(struct ResourceUsage
			(c-type "struct rusage")
			(fields (ru_utime Timeval) (ru_stime Timeval)
				(ru_maxrss (:pragma (c_optional)) ResourceCount)
				(ru_ixrss (:pragma (c_optional)) ResourceCount)
				(ru_idrss (:pragma (c_optional)) ResourceCount)
				(ru_isrss (:pragma (c_optional)) ResourceCount)
				(ru_minflt (:pragma (c_optional)) ResourceCount)
				(ru_majflt (:pragma (c_optional)) ResourceCount)
				(ru_nswap (:pragma (c_optional)) ResourceCount)
				(ru_inblock (:pragma (c_optional)) ResourceCount)
				(ru_oublock (:pragma (c_optional)) ResourceCount)
				(ru_msgsnd (:pragma (c_optional)) ResourceCount)
				(ru_msgrcv (:pragma (c_optional)) ResourceCount)
				(ru_nsignals (:pragma (c_optional)) ResourceCount)
				(ru_nvcsw (:pragma (c_optional)) ResourceCount)
				(ru_nivcsw (:pragma (c_optional)) ResourceCount)))

		(const RUSAGE_SELF ResourceWho)
		(const RUSAGE_CHILDREN ResourceWho)
		(const RUSAGE_THREAD (:pragma (c_optional)) ResourceWho)
		(const RUSAGE_LWP (:pragma (c_optional)) ResourceWho)

		(fn getrusage
			(params (who ResourceWho) (usage (mut-ref ResourceUsage)))
			(returns i32))

		(type PriorityId (c-type "id_t"))
		(type PriorityWhich (:pragma (cfg (os "macos"))) (c-type "int"))
		(type PriorityWhich (:pragma (cfg (os "linux"))) (c-type "__priority_which_t"))

		(const PRIO_PROCESS PriorityWhich)
		(const PRIO_PGRP PriorityWhich)
		(const PRIO_USER PriorityWhich)
		(const PRIO_MIN (:pragma (c_optional)) i32)
		(const PRIO_MAX (:pragma (c_optional)) i32)
		(const PRIO_DARWIN_THREAD (:pragma (c_optional)) PriorityWhich)
		(const PRIO_DARWIN_PROCESS (:pragma (c_optional)) PriorityWhich)
		(const PRIO_DARWIN_BG (:pragma (c_optional)) i32)
		(const PRIO_DARWIN_NONUI (:pragma (c_optional)) i32)

		(fn getpriority
			(:doc "Return the native priority. Clear errno before calling to distinguish a valid minus one from failure.")
			(params (which PriorityWhich) (who PriorityId))
			(returns i32))

		(fn setpriority
			(:doc "Pass the requested priority to libc and preserve its native status and errno.")
			(params (which PriorityWhich) (who PriorityId) (priority i32))
			(returns i32))

		(type LimitKind (:pragma (cfg (os "macos"))) (c-type "int"))
		(type LimitKind (:pragma (cfg (os "linux"))) (c-type "__rlimit_resource_t"))
		(type LimitValue (c-type "rlim_t"))
		(struct ResourceLimit
			(c-type "struct rlimit")
			(fields (rlim_cur LimitValue) (rlim_max LimitValue)))

		(const RLIMIT_AS LimitKind)
		(const RLIMIT_CORE LimitKind)
		(const RLIMIT_CPU LimitKind)
		(const RLIMIT_DATA LimitKind)
		(const RLIMIT_FSIZE LimitKind)
		(const RLIMIT_NOFILE LimitKind)
		(const RLIMIT_STACK LimitKind)
		(const RLIM_INFINITY LimitValue)
		(const RLIM_SAVED_CUR LimitValue)
		(const RLIM_SAVED_MAX LimitValue)

		(const RLIMIT_RSS (:pragma (c_optional)) LimitKind)
		(const RLIMIT_MEMLOCK (:pragma (c_optional)) LimitKind)
		(const RLIMIT_NPROC (:pragma (c_optional)) LimitKind)
		(const RLIMIT_OFILE (:pragma (c_optional)) LimitKind)
		(const RLIMIT_LOCKS (:pragma (c_optional)) LimitKind)
		(const RLIMIT_SIGPENDING (:pragma (c_optional)) LimitKind)
		(const RLIMIT_MSGQUEUE (:pragma (c_optional)) LimitKind)
		(const RLIMIT_NICE (:pragma (c_optional)) LimitKind)
		(const RLIMIT_RTPRIO (:pragma (c_optional)) LimitKind)
		(const RLIMIT_RTTIME (:pragma (c_optional)) LimitKind)
		(const RLIM_NLIMITS (:pragma (c_optional)) i32)
		(const RLIMIT_NLIMITS (:pragma (c_optional)) i32)

		(fn getrlimit
			(:doc "Read the current and hard limits into the caller's native record and return C status.")
			(params (resource LimitKind) (limits (mut-ref ResourceLimit)))
			(returns i32))

		(fn setrlimit
			(:doc "Request the supplied soft and hard limits for the current process through a shared record loan.")
			(params (resource LimitKind) (limits (shared-ref ResourceLimit)))
			(returns i32))

		(fn getiopolicy_np
			(:doc "Return the current Darwin I/O policy for the native type and scope.")
			(:pragma (c_optional))
			(params (io_type i32) (scope i32))
			(returns i32))
		(fn setiopolicy_np
			(:doc "Set the native policy for the selected Darwin type and scope and preserve C status and errno.")
			(:pragma (c_optional))
			(params (io_type i32) (scope i32) (policy i32))
			(returns i32))

		(const IOPOL_TYPE_DISK (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_ATIME_UPDATES (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_MATERIALIZE_DATALESS_FILES (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_STATFS_NO_DATA_VOLUME (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_TRIGGER_RESOLVE (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_CONTENT_PROTECTION (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_IGNORE_PERMISSIONS (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_SKIP_MTIME_UPDATE (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_ALLOW_LOW_SPACE_WRITES (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_DISALLOW_RW_FOR_O_EVTONLY (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_ENTITLED_RESERVE_ACCESS (:pragma (c_optional)) i32)
		(const IOPOL_TYPE_VFS_IGNORE_CONTENT_PROTECTION (:pragma (c_optional)) i32)
		(const IOPOL_SCOPE_PROCESS (:pragma (c_optional)) i32)
		(const IOPOL_SCOPE_THREAD (:pragma (c_optional)) i32)
		(const IOPOL_SCOPE_DARWIN_BG (:pragma (c_optional)) i32)
		(const IOPOL_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_IMPORTANT (:pragma (c_optional)) i32)
		(const IOPOL_PASSIVE (:pragma (c_optional)) i32)
		(const IOPOL_THROTTLE (:pragma (c_optional)) i32)
		(const IOPOL_UTILITY (:pragma (c_optional)) i32)
		(const IOPOL_STANDARD (:pragma (c_optional)) i32)
		(const IOPOL_APPLICATION (:pragma (c_optional)) i32)
		(const IOPOL_NORMAL (:pragma (c_optional)) i32)
		(const IOPOL_ATIME_UPDATES_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_ATIME_UPDATES_OFF (:pragma (c_optional)) i32)
		(const IOPOL_MATERIALIZE_DATALESS_FILES_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_MATERIALIZE_DATALESS_FILES_OFF (:pragma (c_optional)) i32)
		(const IOPOL_MATERIALIZE_DATALESS_FILES_ON (:pragma (c_optional)) i32)
		(const IOPOL_MATERIALIZE_DATALESS_FILES_ORIG (:pragma (c_optional)) i32)
		(const IOPOL_MATERIALIZE_DATALESS_FILES_BASIC_MASK (:pragma (c_optional)) i32)
		(const IOPOL_VFS_STATFS_NO_DATA_VOLUME_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_VFS_STATFS_FORCE_NO_DATA_VOLUME (:pragma (c_optional)) i32)
		(const IOPOL_VFS_TRIGGER_RESOLVE_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_VFS_TRIGGER_RESOLVE_OFF (:pragma (c_optional)) i32)
		(const IOPOL_VFS_CONTENT_PROTECTION_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_VFS_CONTENT_PROTECTION_IGNORE (:pragma (c_optional)) i32)
		(const IOPOL_VFS_CONTENT_PROTECTION_STRICT (:pragma (c_optional)) i32)
		(const IOPOL_VFS_IGNORE_PERMISSIONS_OFF (:pragma (c_optional)) i32)
		(const IOPOL_VFS_IGNORE_PERMISSIONS_ON (:pragma (c_optional)) i32)
		(const IOPOL_VFS_SKIP_MTIME_UPDATE_OFF (:pragma (c_optional)) i32)
		(const IOPOL_VFS_SKIP_MTIME_UPDATE_ON (:pragma (c_optional)) i32)
		(const IOPOL_VFS_SKIP_MTIME_UPDATE_IGNORE (:pragma (c_optional)) i32)
		(const IOPOL_VFS_ALLOW_LOW_SPACE_WRITES_OFF (:pragma (c_optional)) i32)
		(const IOPOL_VFS_ALLOW_LOW_SPACE_WRITES_ON (:pragma (c_optional)) i32)
		(const IOPOL_VFS_DISALLOW_RW_FOR_O_EVTONLY_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_VFS_DISALLOW_RW_FOR_O_EVTONLY_ON (:pragma (c_optional)) i32)
		(const IOPOL_VFS_NOCACHE_WRITE_FS_BLKSIZE_DEFAULT (:pragma (c_optional)) i32)
		(const IOPOL_VFS_NOCACHE_WRITE_FS_BLKSIZE_ON (:pragma (c_optional)) i32)
		(const IOPOL_VFS_ENTITLED_RESERVE_ACCESS_OFF (:pragma (c_optional)) i32)
		(const IOPOL_VFS_ENTITLED_RESERVE_ACCESS_ON (:pragma (c_optional)) i32)

		(decls
			(:pragma (cfg (os "linux")))
			(type LimitPid (c-type "__pid_t"))

			(type LimitValue64 (:pragma (c_optional)) (c-type "rlim64_t"))
			(struct ResourceLimit64 (:pragma (c_optional))
				(c-type "struct rlimit64")
				(fields (rlim_cur LimitValue64) (rlim_max LimitValue64)))
			(const RLIM64_INFINITY (:pragma (c_optional)) LimitValue64)
			(fn getrlimit64
				(:doc "Read the current process's limits into a mutable explicit 64-bit record.")
				(:pragma (c_optional))
				(params (resource LimitKind) (limits (mut-ref ResourceLimit64)))
				(returns i32))
			(fn setrlimit64
				(:doc "Request the current process's limits through a shared explicit 64-bit record.")
				(:pragma (c_optional))
				(params (resource LimitKind) (limits (shared-ref ResourceLimit64)))
				(returns i32))
			(fn prlimit64
				(:doc "Apply or retrieve the selected process limit, with independent nullable record slots.")
				(:pragma (c_optional) (c_nullable requested previous))
				(params (pid LimitPid) (resource LimitKind) (requested (shared-ref ResourceLimit64))
					(previous (mut-ref ResourceLimit64)))
				(returns i32)))))
