(module resource_priority_member
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (value TEST_MEMBER)))
	(use c-header "./oracle.h" (only fixture_priority_constant))
	(bridge c-header "./oracle.h"
		(fn fixture_priority_constant (params) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (int:convert i32 TEST_MEMBER) (call fixture_priority_constant))
				(then (return 1i32)))
			(return 42i32))))
