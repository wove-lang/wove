(module darwin_process_usage_v6
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type RusageInfoV6) RUSAGE_INFO_V6))
	(use c-header TEST_SELECTOR (only proc_pid_rusage_v6))
	(use c-header "<unistd.h>" (only getpid))
	(use c-header "./oracle.h" (only fixture_proc_usage_v6))
	(bridge c-header "./oracle.h"
		(fn fixture_proc_usage_v6 (params (flavor i32)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_proc_usage_v6 RUSAGE_INFO_V6)) (then (return 1i32)))
			(let pid (int:convert i32 (call getpid)))
			(let-mut output (struct:new RusageInfoV6 (ri_flags 18446744073709551615u64)))
			(if (i32:not-eqz (call proc_pid_rusage_v6 pid (borrow-mut output))) (then (return 2i32)))
			(if (bool:or (u64:eqz output/ri_proc_start_abstime)
				(u64:eq output/ri_flags 18446744073709551615u64)) (then (return 3i32)))
			(return 42i32))))
