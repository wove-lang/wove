(module darwin_process_usage_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type RusageInfoV0)))
	(use c-header TEST_SELECTOR (only proc_pid_rusage_v1))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut wrong (struct:new RusageInfoV0))
			(return (call proc_pid_rusage_v1 1i32 (borrow-mut wrong))))))
