(module extended_resource_selectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type LimitKind) (type LimitValue) (type ResourceLimit)
		getrlimit RLIMIT_AS RLIMIT_RSS RLIMIT_MEMLOCK RLIMIT_NPROC RLIM_NLIMITS))
	(use (:pragma (cfg (os "linux"))) c-header "TEST_HEADER"
		(only RLIMIT_NOFILE RLIMIT_OFILE RLIMIT_LOCKS RLIMIT_SIGPENDING RLIMIT_MSGQUEUE
			RLIMIT_NICE RLIMIT_RTPRIO RLIMIT_RTTIME RLIMIT_NLIMITS))
	(use c-header "./oracle.h" (only fixture_extended_limit_selectors fixture_limit_matches))
	(use (:pragma (cfg (os "linux"))) c-header "./oracle.h" (only fixture_glibc_limit_selectors))

	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type LimitKind) (type LimitValue)))
		(fn fixture_extended_limit_selectors
			(params (rss LimitKind) (memlock LimitKind) (nproc LimitKind) (count i32)) (returns bool))
		(fn fixture_limit_matches
			(params (resource LimitKind) (current LimitValue) (maximum LimitValue)) (returns bool))
		(fn fixture_glibc_limit_selectors
			(:pragma (cfg (os "linux")))
			(params (ofile LimitKind) (locks LimitKind) (sigpending LimitKind) (msgqueue LimitKind)
				(nice_limit LimitKind) (rtprio LimitKind) (rttime LimitKind) (count i32))
			(returns bool)))

	(fn check_read (params (selector LimitKind)) (returns bool)
		(body
			(let-mut observed (struct:new ResourceLimit))
			(if (i32:not-eqz (call getrlimit selector (borrow-mut observed))) (then (return (bool false))))
			(return (call fixture_limit_matches selector observed/rlim_cur observed/rlim_max))))

	(fn check_profile (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body (return (int:eq LimitKind RLIMIT_RSS RLIMIT_AS))))

	(fn check_profile (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body
			(if (bool:not (call fixture_glibc_limit_selectors RLIMIT_OFILE RLIMIT_LOCKS RLIMIT_SIGPENDING
				RLIMIT_MSGQUEUE RLIMIT_NICE RLIMIT_RTPRIO RLIMIT_RTTIME RLIMIT_NLIMITS))
				(then (return (bool false))))
			(if (bool:or (int:eq LimitKind RLIMIT_RSS RLIMIT_AS) (int:not-eq LimitKind RLIMIT_OFILE RLIMIT_NOFILE))
				(then (return (bool false))))
			(if (i32:not-eq RLIMIT_NLIMITS RLIM_NLIMITS) (then (return (bool false))))
			(return (bool:and (call check_read RLIMIT_OFILE)
				(bool:and (call check_read RLIMIT_SIGPENDING) (call check_read RLIMIT_RTTIME))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_extended_limit_selectors RLIMIT_RSS RLIMIT_MEMLOCK RLIMIT_NPROC RLIM_NLIMITS))
				(then (return 1i32)))
			(if (bool:not (call check_read RLIMIT_RSS)) (then (return 2i32)))
			(if (bool:not (call check_read RLIMIT_MEMLOCK)) (then (return 3i32)))
			(if (bool:not (call check_read RLIMIT_NPROC)) (then (return 4i32)))
			(if (bool:not (call check_profile)) (then (return 5i32)))
			(return 42i32))))
