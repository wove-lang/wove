(module resource_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type LimitKind) (type LimitValue) (type ResourceLimit)
		getrlimit setrlimit RLIMIT_AS RLIMIT_CORE RLIMIT_CPU RLIMIT_DATA RLIMIT_FSIZE RLIMIT_NOFILE
		RLIMIT_STACK RLIM_INFINITY RLIM_SAVED_CUR RLIM_SAVED_MAX))
	(use c-header "<errno.h>" (only errno EINVAL))
	(use c-header "./oracle.h" (only fixture_limit_selectors fixture_limit_sentinels fixture_limit_matches))

	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type LimitKind) (type LimitValue)))
		(fn fixture_limit_selectors
			(params (address LimitKind) (core LimitKind) (cpu LimitKind) (data LimitKind)
				(file_size LimitKind) (files LimitKind) (stack LimitKind))
			(returns bool))
		(fn fixture_limit_sentinels
			(params (infinity LimitValue) (saved_current LimitValue) (saved_maximum LimitValue))
			(returns bool))
		(fn fixture_limit_matches
			(params (resource LimitKind) (current LimitValue) (maximum LimitValue))
			(returns bool)))

	(fn main
		(:doc "Change only the soft file descriptor limit of this fixture subprocess.")
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_limit_selectors RLIMIT_AS RLIMIT_CORE RLIMIT_CPU RLIMIT_DATA
				RLIMIT_FSIZE RLIMIT_NOFILE RLIMIT_STACK))
				(then (return 1i32)))
			(if (bool:not (call fixture_limit_sentinels RLIM_INFINITY RLIM_SAVED_CUR RLIM_SAVED_MAX))
				(then (return 2i32)))

			(let-mut original (struct:new ResourceLimit))
			(if (i32:not-eqz (call getrlimit RLIMIT_NOFILE (borrow-mut original))) (then (return 3i32)))
			(if (bool:not (call fixture_limit_matches RLIMIT_NOFILE original/rlim_cur original/rlim_max))
				(then (return 4i32)))

			(let invalid (int:convert LimitKind 999i32))
			(let-mut rejected (struct:new ResourceLimit))
			(set errno 0i32)
			(let bad_get (call getrlimit invalid (borrow-mut rejected)))
			(let get_error errno)
			(if (bool:or (i32:not-eq bad_get -1i32) (i32:not-eq get_error EINVAL))
				(then (return 5i32)))
			(set errno 0i32)
			(let bad_set (call setrlimit invalid (borrow-shared original)))
			(let set_error errno)
			(if (bool:or (i32:not-eq bad_set -1i32) (i32:not-eq set_error EINVAL))
				(then (return 6i32)))

			(let old_count (int:convert u64 original/rlim_cur))
			(if (u64:eqz old_count) (then (return 7i32)))
			(let-mut new_count 64u64)
			(if (u64:lt old_count 65u64) (then (set new_count (u64:dec old_count))))
			(let next (struct:new ResourceLimit (rlim_cur (int:convert LimitValue new_count))
				(rlim_max original/rlim_max)))
			(if (i32:not-eqz (call setrlimit RLIMIT_NOFILE (borrow-shared next))) (then (return 8i32)))
			(let-mut observed (struct:new ResourceLimit))
			(if (i32:not-eqz (call getrlimit RLIMIT_NOFILE (borrow-mut observed))) (then (return 9i32)))
			(if (bool:or (int:not-eq LimitValue observed/rlim_cur next/rlim_cur)
				(int:not-eq LimitValue observed/rlim_max original/rlim_max))
				(then (return 10i32)))
			(if (bool:not (call fixture_limit_matches RLIMIT_NOFILE observed/rlim_cur observed/rlim_max))
				(then (return 11i32)))
			(return 42i32))))
