(module resource_optional
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (value TEST_MEMBER) (type ResourceWho)))
	(use c-header "./oracle.h" (only fixture_optional_usage_scope))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type ResourceWho)))
		(fn fixture_optional_usage_scope (params) (returns ResourceWho)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (int.eq ResourceWho TEST_MEMBER (call fixture_optional_usage_scope)))
				(then (return 1i32)))
			(return 42i32))))
