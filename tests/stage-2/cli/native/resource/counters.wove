(module resource_counters
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type ResourceUsage)))
	(use c-header "./oracle.h" (only fixture_seed_counters fixture_counter_value))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type ResourceUsage) (type ResourceCount)))
		(fn fixture_seed_counters (params (value (mut-ref ResourceUsage))) (returns void))
		(fn fixture_counter_value (params (index i32) (value ResourceCount)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (struct:new ResourceUsage))
			(call fixture_seed_counters (borrow-mut value))
			(if (bool:not (call fixture_counter_value 0i32 value/ru_maxrss))
				(then (return 1i32)))
			(if (bool:not (call fixture_counter_value 1i32 value/ru_ixrss))
				(then (return 2i32)))
			(if (bool:not (call fixture_counter_value 2i32 value/ru_idrss))
				(then (return 3i32)))
			(if (bool:not (call fixture_counter_value 3i32 value/ru_isrss))
				(then (return 4i32)))
			(if (bool:not (call fixture_counter_value 4i32 value/ru_minflt))
				(then (return 5i32)))
			(if (bool:not (call fixture_counter_value 5i32 value/ru_majflt))
				(then (return 6i32)))
			(if (bool:not (call fixture_counter_value 6i32 value/ru_nswap))
				(then (return 7i32)))
			(if (bool:not (call fixture_counter_value 7i32 value/ru_inblock))
				(then (return 8i32)))
			(if (bool:not (call fixture_counter_value 8i32 value/ru_oublock))
				(then (return 9i32)))
			(if (bool:not (call fixture_counter_value 9i32 value/ru_msgsnd))
				(then (return 10i32)))
			(if (bool:not (call fixture_counter_value 10i32 value/ru_msgrcv))
				(then (return 11i32)))
			(if (bool:not (call fixture_counter_value 11i32 value/ru_nsignals))
				(then (return 12i32)))
			(if (bool:not (call fixture_counter_value 12i32 value/ru_nvcsw))
				(then (return 13i32)))
			(if (bool:not (call fixture_counter_value 13i32 value/ru_nivcsw))
				(then (return 14i32)))
			(return 42i32))))
