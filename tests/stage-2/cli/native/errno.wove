(module bundled_errno
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<errno.h>" (only
		(value errno) (value E2BIG) (value EACCES) (value EADDRINUSE) (value EADDRNOTAVAIL)
		(value EAFNOSUPPORT) (value EAGAIN) (value EALREADY) (value EBADF) (value EBADMSG)
		(value EBUSY) (value ECANCELED) (value ECHILD) (value ECONNABORTED) (value ECONNREFUSED)
		(value ECONNRESET) (value EDEADLK) (value EDESTADDRREQ) (value EDOM) (value EDQUOT)
		(value EEXIST) (value EFAULT) (value EFBIG) (value EHOSTDOWN) (value EHOSTUNREACH)
		(value EIDRM) (value EILSEQ) (value EINPROGRESS) (value EINTR) (value EINVAL) (value EIO)
		(value EISCONN) (value EISDIR) (value ELOOP) (value EMFILE) (value EMLINK) (value EMSGSIZE)
		(value EMULTIHOP) (value ENAMETOOLONG) (value ENETDOWN) (value ENETRESET)
		(value ENETUNREACH) (value ENFILE) (value ENOBUFS) (value ENODATA) (value ENODEV)
		(value ENOENT) (value ENOEXEC) (value ENOLCK) (value ENOLINK) (value ENOMEM) (value ENOMSG)
		(value ENOPROTOOPT) (value ENOSPC) (value ENOSR) (value ENOSTR) (value ENOSYS)
		(value ENOTBLK) (value ENOTCONN) (value ENOTDIR) (value ENOTEMPTY) (value ENOTRECOVERABLE)
		(value ENOTSOCK) (value ENOTSUP) (value ENOTTY) (value ENXIO) (value EOPNOTSUPP)
		(value EOVERFLOW) (value EOWNERDEAD) (value EPERM) (value EPFNOSUPPORT) (value EPIPE)
		(value EPROTO) (value EPROTONOSUPPORT) (value EPROTOTYPE) (value ERANGE) (value EREMOTE)
		(value EROFS) (value ESHUTDOWN) (value ESOCKTNOSUPPORT) (value ESPIPE) (value ESRCH)
		(value ESTALE) (value ETIME) (value ETIMEDOUT) (value ETOOMANYREFS) (value ETXTBSY)
		(value EUSERS) (value EWOULDBLOCK) (value EXDEV)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only
		(value EAUTH) (value EBADARCH) (value EBADEXEC) (value EBADMACHO) (value EBADRPC)
		(value EDEVERR) (value EFTYPE) (value ELAST) (value ENEEDAUTH) (value ENOATTR)
		(value ENOPOLICY) (value ENOTCAPABLE) (value EPROCLIM) (value EPROCUNAVAIL)
		(value EPROGMISMATCH) (value EPROGUNAVAIL) (value EPWROFF) (value EQFULL)
		(value ERPCMISMATCH) (value ESHLIBVERS)))
	(use (:pragma (cfg (os "linux"))) c-header "<errno.h>" (only
		(value EADV) (value EBADE) (value EBADFD) (value EBADR) (value EBADRQC) (value EBADSLT)
		(value EBFONT) (value ECHRNG) (value ECOMM) (value EDEADLOCK) (value EDOTDOT)
		(value EHWPOISON) (value EISNAM) (value EKEYEXPIRED) (value EKEYREJECTED)
		(value EKEYREVOKED) (value EL2HLT) (value EL2NSYNC) (value EL3HLT) (value EL3RST)
		(value ELIBACC) (value ELIBBAD) (value ELIBEXEC) (value ELIBMAX) (value ELIBSCN)
		(value ELNRNG) (value EMEDIUMTYPE) (value ENAVAIL) (value ENOANO) (value ENOCSI)
		(value ENOKEY) (value ENOMEDIUM) (value ENONET) (value ENOPKG) (value ENOTNAM)
		(value ENOTUNIQ) (value EREMCHG) (value EREMOTEIO) (value ERESTART) (value ERFKILL)
		(value ESRMNT) (value ESTRPIPE) (value EUCLEAN) (value EUNATCH) (value EXFULL)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn all_positive (params (codes (shared-array i32))) (returns bool)
		(body
			(let-mut index 0i32)
			(while (i32.lt index (array.len codes))
				(body
					(if (i32.le (array.load codes index) 0i32)
						(then (return (bool false))))
					(set index (i32.inc index))))
			(return (bool true))))

	(fn common_codes (params) (returns bool)
		(body
			(let codes (array.new (array i32 89)
				E2BIG EACCES EADDRINUSE EADDRNOTAVAIL
				EAFNOSUPPORT EAGAIN EALREADY EBADF EBADMSG
				EBUSY ECANCELED ECHILD ECONNABORTED
				ECONNREFUSED ECONNRESET EDEADLK EDESTADDRREQ
				EDOM EDQUOT EEXIST EFAULT EFBIG
				EHOSTDOWN EHOSTUNREACH EIDRM EILSEQ
				EINPROGRESS EINTR EINVAL EIO EISCONN
				EISDIR ELOOP EMFILE EMLINK EMSGSIZE
				EMULTIHOP ENAMETOOLONG ENETDOWN ENETRESET
				ENETUNREACH ENFILE ENOBUFS ENODATA ENODEV
				ENOENT ENOEXEC ENOLCK ENOLINK ENOMEM
				ENOMSG ENOPROTOOPT ENOSPC ENOSR ENOSTR
				ENOSYS ENOTBLK ENOTCONN ENOTDIR ENOTEMPTY
				ENOTRECOVERABLE ENOTSOCK ENOTSUP ENOTTY
				ENXIO EOPNOTSUPP EOVERFLOW EOWNERDEAD EPERM
				EPFNOSUPPORT EPIPE EPROTO EPROTONOSUPPORT
				EPROTOTYPE ERANGE EREMOTE EROFS ESHUTDOWN
				ESOCKTNOSUPPORT ESPIPE ESRCH ESTALE ETIME
				ETIMEDOUT ETOOMANYREFS ETXTBSY EUSERS
				EWOULDBLOCK EXDEV))
			(return (call all_positive (borrow-shared codes)))))

	(fn sdk_codes (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body
			(let codes (array.new (array i32 20)
				EAUTH EBADARCH EBADEXEC EBADMACHO EBADRPC
				EDEVERR EFTYPE ELAST ENEEDAUTH ENOATTR
				ENOPOLICY ENOTCAPABLE EPROCLIM EPROCUNAVAIL
				EPROGMISMATCH EPROGUNAVAIL EPWROFF EQFULL
				ERPCMISMATCH ESHLIBVERS))
			(return (call all_positive (borrow-shared codes)))))

	(fn sdk_codes (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body
			(let codes (array.new (array i32 45)
				EADV EBADE EBADFD EBADR EBADRQC
				EBADSLT EBFONT ECHRNG ECOMM EDEADLOCK
				EDOTDOT EHWPOISON EISNAM EKEYEXPIRED
				EKEYREJECTED EKEYREVOKED EL2HLT EL2NSYNC
				EL3HLT EL3RST ELIBACC ELIBBAD ELIBEXEC
				ELIBMAX ELIBSCN ELNRNG EMEDIUMTYPE ENAVAIL
				ENOANO ENOCSI ENOKEY ENOMEDIUM ENONET
				ENOPKG ENOTNAM ENOTUNIQ EREMCHG EREMOTEIO
				ERESTART ERFKILL ESRMNT ESTRPIPE EUCLEAN
				EUNATCH EXFULL))
			(return (call all_positive (borrow-shared codes)))))

	(fn socket_error_contract (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body (return (i32.not-eq ENOTSUP EOPNOTSUPP))))

	(fn socket_error_contract (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body (return (bool.and (i32.eq ENOTSUP EOPNOTSUPP)
			(i32.eq EDEADLOCK EDEADLK)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (bool.not (call common_codes)) (then (return 1i32)))
			(if (bool.not (call sdk_codes)) (then (return 2i32)))
			(if (bool.not (call socket_error_contract)) (then (return 3i32)))
			(if (i32.not-eq EAGAIN EWOULDBLOCK) (then (return 4i32)))
			(let saved errno)
			(set errno EDOM)
			(let valid (i32.eq errno EDOM))
			(set errno saved)
			(if (bool.not valid) (then (return 5i32)))
			(return 42i32))))
