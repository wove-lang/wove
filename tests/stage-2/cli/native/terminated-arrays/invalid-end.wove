(module terminated_array_invalid_end
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native.h" (only (type Unit) fixture_bad))
	(bridge c-header "./native.h"
		(type Unit (c-type "FixtureUnit"))
		(fn fixture_bad
			(:pragma (c_terminated_array text) (c_terminated_array_offset end text))
			(params (text (shared-array Unit)) (end (mut-ref i32)) (mode i32))
			(returns i32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut text (array:alloc Unit 2i32))
			(let mode (array:len args))
			(array:set text 0i32 (int:convert Unit 256u32))
			(if (i32:not-eq mode 6i32) (then (array:set text 1i32 (int:convert Unit 17u32))))
			(let-mut end -1i32)
			(return (call fixture_bad (borrow-shared text) (borrow-mut end) mode)))))
