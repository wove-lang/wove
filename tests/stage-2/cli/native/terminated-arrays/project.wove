(module terminated_array_project
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<errno.h>" (only (value errno) EDOM))
	(use c-header "./native.h" (only (type Unit) (type Word) fixture_scan fixture_empty fixture_no_end))
	(bridge c-header "./native.h"
		(type Unit (c-type "FixtureUnit"))
		(type Word (c-type "FixtureWord"))
		(fn fixture_scan
			(:pragma (c_terminated_array_offset prefix text) (c_terminated_array text word)
				(c_terminated_array_offset suffix word))
			(params (prefix (mut-ref i32)) (text (shared-array Unit))
				(word (shared-array Word)) (suffix (mut-ref i32)))
			(returns i32))
		(fn fixture_empty
			(:pragma (c_terminated_array text) (c_terminated_array_offset end text))
			(params (text (shared-array Unit)) (end (mut-ref i32)))
			(returns i32))
		(fn fixture_no_end
			(:pragma (c_terminated_array word))
			(params (word (shared-array Word)))
			(returns i32)))

	(fn check_scan (params (text (shared-array Unit)) (word (shared-array Word))) (returns i32)
		(body
			(let-mut prefix -1i32)
			(let-mut suffix -1i32)
			(set errno 0i32)
			(let scanned (call fixture_scan (borrow-mut prefix) (borrow-shared text)
				(borrow-shared word) (borrow-mut suffix)))
			(if (bool.or (i32.not-eq scanned 42i32) (i32.not-eq errno EDOM)) (then (return 5i32)))
			(if (bool.or (i32.not-eq prefix 2i32) (i32.not-eq suffix 1i32)) (then (return 6i32)))
			(set prefix -1i32)
			(set suffix -1i32)
			(if (i32.not-eq (call fixture_scan null (borrow-shared text) (borrow-shared word)
				(borrow-mut suffix)) 42i32) (then (return 7i32)))
			(if (bool.or (i32.not-eq prefix -1i32) (i32.not-eq suffix 1i32)) (then (return 8i32)))
			(if (i32.not-eq (call fixture_scan (borrow-mut prefix) (borrow-shared text)
				(borrow-shared word) null) 42i32) (then (return 9i32)))
			(if (i32.not-eq prefix 2i32) (then (return 10i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut text (array.alloc Unit 5i32))
			(let-mut word (array.alloc Word 1i32))
			(array.store text 1i32 (int.convert Unit 256u32))
			(array.store text 2i32 (int.convert Unit 17u32))
			(array.store text 3i32 (int.convert Unit -512i32))
			(array.store word 0i32 (int.convert Word 65536u32))
			(let-mut end -1i32)
			(if (i32.not-eq (call fixture_empty (borrow-shared (array.range text 1i32 1i32))
				(borrow-mut end)) 42i32) (then (return 11i32)))
			(if (i32.not-eq end 0i32) (then (return 12i32)))
			(if (i32.not-eq (call fixture_empty (borrow-shared (array.range text 1i32 1i32)) null) 42i32)
				(then (return 13i32)))
			(if (i32.not-eq (call fixture_no_end (borrow-shared word)) 42i32) (then (return 14i32)))
			(return (call check_scan (borrow-shared (array.range text 1i32 4i32)) (borrow-shared word))))))
