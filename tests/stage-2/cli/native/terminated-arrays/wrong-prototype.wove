(module terminated_array_wrong_prototype
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native.h" (only (type Unit) fixture_wrong))
	(bridge c-header "./native.h"
		(type Unit (c-type "FixtureUnit"))
		(fn fixture_wrong
			(:pragma (c_terminated_array text) (c_terminated_array_offset end text))
			(params (text (shared-array Unit)) (end (mut-ref i32)))
			(returns i32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let text (array:alloc Unit 0i32))
			(return (call fixture_wrong (borrow-shared text) null)))))
