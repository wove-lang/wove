(module record_init_duplicate
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type (as Words Projected))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct.new Projected (second 1i32) (second 2i32)))
			(return 42i32))))
