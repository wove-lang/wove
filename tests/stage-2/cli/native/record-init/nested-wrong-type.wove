(module record_init_nested_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./inner.wove" (only))
	(use wove-file "./outer.wove" (only))
	(use c-header "./inner.h" (only (type (as OtherCell Other))))
	(use c-header "./outer.h" (only (type (as Container Projected))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let value (struct.new Projected (first (struct.new Other (word 1i32)))))
			(return 42i32))))
