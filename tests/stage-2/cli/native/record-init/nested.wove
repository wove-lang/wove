(module record_init_nested
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./inner.wove" (only))
	(use wove-file "./outer.wove" (only))
	(use c-header "./inner.h" (only (type (as Cell Part)) next_inner_word))
	(use c-header "./outer.h" (only (type (as Container Projected)) verify_outer))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let existing (struct.new Part (word 7i32)))
			(let value (struct.new Projected
				(second (struct.new Part (word (call next_inner_word))))
				(supplied (local existing))
				(first (struct.new Part (word (call next_inner_word))))))
			(if (i32.not-eq (struct.get (struct.get (local value) first) word) 22i32)
				(then (return 2i32)))
			(return (call verify_outer (borrow-shared (local value)))))))
