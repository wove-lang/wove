(module record_init_lock
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only (type (as Lock FileLock)) (type Mode) (type Offset) (type Short)
		open fcntl_getlk fcntl_setlk fcntl_setlkw (value O_RDWR) (value F_WRLCK) (value F_UNLCK)))
	(use c-header "<unistd.h>" (only close (value SEEK_SET)))

	(let filename "sample")

	(fn checked_lock (params (fd i32)) (returns i32)
		(body
			(let writing (int.convert Short F_WRLCK))
			(let unlocked (int.convert Short F_UNLCK))
			(let origin (int.convert Short SEEK_SET))
			(let-mut request (struct.new FileLock (l_type writing) (l_whence origin)
				(l_len (int.convert Offset 2i32))))
			(if (i32.not-eqz (call fcntl_setlk fd (borrow-mut request)))
				(then (return 2i32)))
			(let-mut query request)
			(if (i32.not-eqz (call fcntl_getlk fd (borrow-mut query)))
				(then (return 3i32)))
			(if (bool.not (int.eq Short (struct.get query l_type) unlocked))
				(then (return 4i32)))
			(let-mut release (struct.new FileLock (l_type unlocked) (l_whence origin)))
			(if (i32.not-eqz (call fcntl_setlkw fd (borrow-mut release)))
				(then (return 5i32)))
			(return 42i32)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let fd (call open (borrow-shared filename) O_RDWR (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 1i32)))
			(let result (call checked_lock fd))
			(if (i32.not-eqz (call close fd)) (then (return 6i32)))
			(return result))))
