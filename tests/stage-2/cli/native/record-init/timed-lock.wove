(module record_init_timed_lock
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./time.wove" (only))
	(use (:pragma (cfg (os "macos"))) c-header "<time.h>"
		(only (type (as Stamp Duration)) (type Long)))
	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type (as Lock NativeLock)) (type TimedLock) (type Mode) (type Short) (type Offset)
			open fcntl_timed_lock fcntl_setlk (value O_RDWR) (value F_WRLCK) (value F_UNLCK)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only close (value SEEK_SET)))

	(bridge c-header "<fcntl.h>" (:pragma (cfg (os "macos")))
		(use c-header "<time.h>" (only (type (as Stamp Timeout))))
		(struct TimedLock (c-type "struct flocktimeout") (fields (fl Lock) (timeout Timeout)))
		(fn fcntl_timed_lock
			(:pragma (c_variadic lock))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_SETLKWTIMEOUT) (lock (mut-ref TimedLock)))
			(returns i32)))

	(let file "sample")

	(fn check_lock (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let origin (int.convert Short SEEK_SET))
			(let extent (int.convert Offset 2i32))
			(let locking (struct.new NativeLock
				(l_type (int.convert Short F_WRLCK)) (l_whence origin) (l_len extent)))
			(let-mut timed (struct.new TimedLock (fl locking)
				(timeout (struct.new Duration (tv_nsec (int.convert Long 20000000i32))))))
			(if (i32.not-eqz (call fcntl_timed_lock fd (borrow-mut timed)))
				(then (return 2i32)))
			(let-mut release (struct.new NativeLock
				(l_type (int.convert Short F_UNLCK)) (l_whence origin) (l_len extent)))
			(if (i32.not-eqz (call fcntl_setlk fd (borrow-mut release))) (then (return 3i32)))
			(return 42i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let fd (call open (borrow-shared file) O_RDWR (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 1i32)))
			(let result (call check_lock fd))
			(if (i32.not-eqz (call close fd)) (then (return 4i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_platform)))))
