(module record_init_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./records.h"
		(type Word (c-type "wove_word"))
		(type OtherWord (c-type "wove_other_word"))
		(struct Child (c-type "struct wove_child") (fields (marker i32)))
		(struct Words (c-type "struct wove_words")
			(fields (first Word) (second i32) (visible_zero i32) (nested Child)))
		(fn next_word (params) (returns Word))
		(fn next_number (params) (returns i32))
		(fn verify_words (params (value (shared-ref Words))) (returns i32))))
