	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type (as Words Projected)) (type OtherWord)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct:new Projected (first (int:convert OtherWord 1i32))))
			(return 42i32))))
