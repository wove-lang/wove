(module record_init_outer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./outer.h"
		(use c-header "./inner.h" (only (type (as Cell NativeCell))))
		(struct Container (c-type "struct wove_outer")
			(fields (first NativeCell) (second NativeCell) (supplied NativeCell) (omitted NativeCell)))
		(fn verify_outer (params (value (shared-ref Container))) (returns i32))))
