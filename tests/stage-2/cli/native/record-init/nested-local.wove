(module record_init_nested_local
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type (as Words Projected)) (type Child)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct.new Projected (nested (struct.new Child (marker 1i32)))))
			(if (i32.eq (struct.get (struct.get (local value) nested) marker) 1i32)
				(then (return 42i32)))
			(return 1i32))))
