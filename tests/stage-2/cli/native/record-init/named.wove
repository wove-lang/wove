(module record_init_named
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./records.h" (only (type (as Words Projected)) next_word next_number verify_words))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct.new Projected (second (call next_number)) (first (call next_word))))
			(return (call verify_words (borrow-shared (local value)))))))
