(module native_duplicate_field_case
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(struct Record (fields (value i32)))

	(fn main (params (bytes (shared-array u8)) (argv (shared-array EntryArgSpan))) (returns i32)
		(body
			(let record (struct.new Record (value 0i32) (value 1i32)))
			(return 0i32))))
