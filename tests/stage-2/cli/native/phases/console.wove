(module native_console_case
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Port the archive console case to the shared host argument entry.")

	(use c-header "<stdio.h>" (only getchar putchar fputc (value stderr) EOF))

	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (bytes (shared-array u8)) (argv (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (bool.not (i32.eq (array.len (local argv)) 2i32))
				(then (return 8i32)))
			(let-mut ch (call getchar))
			(while (bool.not (i32.eq (local ch) (local EOF)))
				(body
					(let written (call putchar (local ch)))
					(set (local ch) (call getchar))))
			(let marker (call fputc 33i32 (local stderr)))
			(let newline (call fputc 10i32 (local stderr)))
			(return 7i32))))
