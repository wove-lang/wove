(module native_console_case
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Port the archive console case to the shared host argument entry.")

	(use c-header "<stdio.h>" (only getchar putchar fputc (value stderr) EOF))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (i32:eq (i32:dec (array:len argv)) 2i32))
				(then (return 8i32)))
			(let-mut ch (call getchar))
			(while (bool:not (i32:eq ch EOF))
				(body
					(let written (call putchar ch))
					(set ch (call getchar))))
			(let marker (call fputc 33i32 stderr))
			(let newline (call fputc 10i32 stderr))
			(return 7i32))))
