(module native_division_case
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Exercise signed truncation and the archive's runtime divisor failure.")

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(let divisor 4i32)

	(fn quotient
		(params (value i32) (divisor i32)) (returns i32)
		(body (return (i32.div (local value) (local divisor)))))

	(fn main
		(params (bytes (shared-slice u8)) (argv (shared-slice EntryArgSpan))) (returns i32)
		(body
			(if (bool.and (i32.lt 0i32 (slice.len (local bytes)))
				(u8.eq (slice.load (local bytes) 0i32) 122u8))
				(then (return (call quotient 9i32 0i32))))
			(if (bool.and (i32.eq (i32.div -7i32 4i32) -1i32)
				(bool.and (i32.eq (i32.div -2147483648i32 (local divisor)) -536870912i32)
					(i32.eq (call quotient -7i32 3i32) -2i32)))
				(then (return 0i32)))
			(return 2i32))))
