(module native_use_after_transfer_case
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-slice u8)) (argv (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let data (array.alloc u8 1i32))
			(let transferred (move (local data)))
			(return (slice.len (local data))))))
