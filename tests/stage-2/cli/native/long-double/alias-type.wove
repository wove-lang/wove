(module float_typedef_type_only
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./alias.h" (only (type FixtureLong)))
	(bridge c-header "./alias.h"
		(type FixtureLong (:pragma (c_long_double) (c_optional)) (c-type "FixtureLongDouble")))

	(fn copy (params (value FixtureLong)) (returns FixtureLong)
		(body (return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
