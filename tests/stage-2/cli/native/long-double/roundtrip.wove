(module native_long_double_roundtrip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>"
		(only (type (as NativeLongDouble LongDouble))
			(value LDBL_EPSILON) (value LDBL_MAX) (value LDBL_MIN) (value LDBL_TRUE_MIN)))
	(bridge c-header "<float.h>"
		(type NativeLongDouble (c-type "long double"))
		(let (:pragma (c_macro)) LDBL_EPSILON NativeLongDouble)
		(let (:pragma (c_macro)) LDBL_MAX NativeLongDouble)
		(let (:pragma (c_macro)) LDBL_MIN NativeLongDouble)
		(let (:pragma (c_macro)) LDBL_TRUE_MIN NativeLongDouble))
	(use c-header "./native.h" (only (type NativeLongBox) native_long_roundtrip native_long_successor native_long_matches))
	(bridge c-header "./native.h"
		(use c-header "<float.h>" (only (type (as NativeLongDouble Exact))))
		(struct NativeLongBox (c-type "NativeLongBox") (fields (value Exact)))
		(fn native_long_roundtrip (params (value Exact)) (returns Exact))
		(fn native_long_successor (params) (returns Exact))
		(fn native_long_matches (params (value Exact) (index i32)) (returns i32)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn preserves (params (value LongDouble) (index i32)) (returns bool)
		(body
			(let forwarded (call native_long_roundtrip (local value)))
			(return (i32.eq (call native_long_matches (local forwarded) (local index)) 1i32))))

	(fn main (:expect (issues "gh:wove-lang/wove:571"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (bool.not (call preserves (local LDBL_EPSILON) 0i32)) (then (return 1i32)))
			(if (bool.not (call preserves (local LDBL_MAX) 1i32)) (then (return 2i32)))
			(if (bool.not (call preserves (local LDBL_MIN) 2i32)) (then (return 3i32)))
			(let-mut value (local LDBL_TRUE_MIN))
			(if (bool.not (call preserves (local value) 3i32)) (then (return 4i32)))
			(set (local value) (call native_long_successor))
			(let boxed (struct.new NativeLongBox (value (local value))))
			(if (bool.not (call preserves (struct.get (local boxed) value) 4i32)) (then (return 5i32)))
			(return 42i32))))
