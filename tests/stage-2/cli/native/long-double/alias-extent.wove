(module float_typedef_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./alias.h" (only invalid_extent))
	(bridge c-header "./alias.h"
		(type Floating (:pragma (c_long_double)) (c-type "FixtureLongDouble"))
		(fn invalid_extent
			(:pragma (c_bytes data count))
			(params (data (shared-array u8)) (count Floating))
			(returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
