(module native_long_double_nominal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (type Second) (value LDBL_EPSILON)))
	(bridge c-header "./native.h"
		(type First (c-type "long double"))
		(type Second (c-type "long double"))
		(let (:pragma (c_macro)) LDBL_EPSILON First))

	(fn requires_second (params (value Second)) (returns i32)
		(body (return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call requires_second (local LDBL_EPSILON))))))
