(module native_long_double_wrong_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only native_double_result))
	(bridge c-header "./native.h"
		(type LongDouble (c-type "long double"))
		(fn native_double_result (params) (returns LongDouble)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (call native_double_result))
			(return 42i32))))
