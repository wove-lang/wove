(module native_long_double_const
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value LDBL_EPSILON)))
	(bridge c-header "./native.h"
		(type LongDouble (c-type "long double"))
		(const LDBL_EPSILON LongDouble))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value LDBL_EPSILON)
			(return 42i32))))
