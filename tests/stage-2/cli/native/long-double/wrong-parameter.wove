(module native_long_double_wrong_parameter
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only native_long_successor native_double_argument))
	(bridge c-header "./native.h"
		(type LongDouble (c-type "long double"))
		(fn native_long_successor (params) (returns LongDouble))
		(fn native_double_argument (params (value LongDouble)) (returns i32)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call native_double_argument (call native_long_successor))))))
