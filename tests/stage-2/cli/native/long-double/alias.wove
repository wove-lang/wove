(module float_typedef
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (type NativeLongBox) (value NATIVE_LONG_EXPRESSION)
			native_long_roundtrip native_long_read native_long_successor native_long_matches))
	(bridge c-header "./alias.h"
		(type FixtureLong (:pragma (c_long_double)) (c-type "FixtureLongDouble")))
	(bridge c-header "./native.h"
		(use c-header "./alias.h" (only (type (as FixtureLong Value))))
		(struct NativeLongBox (c-type "NativeLongBox") (fields (value Value)))
		(let NATIVE_LONG_EXPRESSION (:pragma (c_macro)) Value)
		(fn native_long_roundtrip (params (value Value)) (returns Value))
		(fn native_long_read (params (value (mut-ref Value))) (returns Value))
		(fn native_long_successor (params) (returns Value))
		(fn native_long_matches (params (value Value) (index i32)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call native_long_matches NATIVE_LONG_EXPRESSION 4i32) 1i32)
				(then (return 1i32)))
			(let-mut value (call native_long_successor))
			(let boxed (struct:new NativeLongBox (value (call native_long_roundtrip (call native_long_read (borrow-mut value))))))
			(if (i32:eq (call native_long_matches (struct:get boxed value) 4i32) 1i32)
				(then (return 42i32)))
			(return 2i32))))
