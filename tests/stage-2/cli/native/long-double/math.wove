(module native_long_double_math
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<math.h>"
		(only (type LongDouble) (value HUGE_VALL) (value FP_NORMAL)
			nextafterl frexpl modfl ldexpl sqrtl fpclassifyl nanl isnanl))
	(use c-header "./native.h" (only native_long_midpoint native_long_matches))
	(bridge c-header "./native.h"
		(use c-header "<math.h>" (only (type (as LongDouble Exact))))
		(fn native_long_midpoint (params) (returns Exact))
		(fn native_long_matches (params (value Exact) (index i32)) (returns i32)))

	(let tag "")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:571"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut whole (call native_long_midpoint))
			(let fraction (call modfl (local whole) (borrow-mut (local whole))))
			(if (i32.not-eq (call native_long_matches (local fraction) 5i32) 1i32) (then (return 1i32)))
			(if (i32.not-eq (call native_long_matches (local whole) 6i32) 1i32) (then (return 2i32)))
			(let next (call nextafterl (local whole) (local HUGE_VALL)))
			(if (i32.not-eq (call native_long_matches (local next) 4i32) 1i32) (then (return 3i32)))
			(let-mut exponent 0i32)
			(let scaled (call frexpl (local whole) (borrow-mut (local exponent))))
			(if (i32.not-eq (call native_long_matches (local scaled) 5i32) 1i32) (then (return 4i32)))
			(if (i32.not-eq (local exponent) 1i32) (then (return 5i32)))
			(let root (call sqrtl (call ldexpl (local whole) 2i32)))
			(if (i32.not-eq (call native_long_matches (local root) 7i32) 1i32) (then (return 6i32)))
			(if (i32.not-eq (call fpclassifyl (local root)) (local FP_NORMAL)) (then (return 7i32)))
			(if (bool.not (call isnanl (call nanl (borrow-shared (local tag))))) (then (return 8i32)))
			(return 42i32))))
