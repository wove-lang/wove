(module native_long_double_math
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<math.h>"
		(only (type LongDouble) (value HUGE_VALL) (value FP_NORMAL)
			nextafterl frexpl modfl ldexpl sqrtl fpclassifyl nanl isnanl))
	(use c-header "./native.h" (only native_long_midpoint native_long_matches))
	(bridge c-header "./native.h"
		(use c-header "<math.h>" (only (type (as LongDouble Exact))))
		(fn native_long_midpoint (params) (returns Exact))
		(fn native_long_matches (params (value Exact) (index i32)) (returns i32)))

	(let tag "")

	(fn main (:expect (issues "gh:wove-lang/wove:571"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut whole (call native_long_midpoint))
			(let fraction (call modfl whole (borrow-mut whole)))
			(if (i32:not-eq (call native_long_matches fraction 5i32) 1i32) (then (return 1i32)))
			(if (i32:not-eq (call native_long_matches whole 6i32) 1i32) (then (return 2i32)))
			(let next (call nextafterl whole HUGE_VALL))
			(if (i32:not-eq (call native_long_matches next 4i32) 1i32) (then (return 3i32)))
			(let-mut exponent 0i32)
			(let scaled (call frexpl whole (borrow-mut exponent)))
			(if (i32:not-eq (call native_long_matches scaled 5i32) 1i32) (then (return 4i32)))
			(if (i32:not-eq exponent 1i32) (then (return 5i32)))
			(let root (call sqrtl (call ldexpl whole 2i32)))
			(if (i32:not-eq (call native_long_matches root 7i32) 1i32) (then (return 6i32)))
			(if (i32:not-eq (call fpclassifyl root) FP_NORMAL) (then (return 7i32)))
			(if (bool:not (call isnanl (call nanl (borrow-shared tag)))) (then (return 8i32)))
			(return 42i32))))
