	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./alias.h" (only (value TEST_FLOATING_CONSTANT)))
	(bridge c-header "./alias.h"
		(type Floating (:pragma (c_long_double)) (c-type "FixtureLongDouble"))
		(const TEST_FLOATING_CONSTANT Floating))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
