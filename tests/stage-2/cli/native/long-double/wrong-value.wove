(module native_long_double_wrong_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value NATIVE_DOUBLE_EXPRESSION)))
	(bridge c-header "./native.h"
		(type LongDouble (c-type "long double"))
		(let (:pragma (c_macro)) NATIVE_DOUBLE_EXPRESSION LongDouble))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let value (local NATIVE_DOUBLE_EXPRESSION))
			(return 42i32))))
