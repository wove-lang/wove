(module native_long_double_wrong_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value NATIVE_DOUBLE_EXPRESSION)))
	(bridge c-header "./native.h"
		(type LongDouble (c-type "long double"))
		(let (:pragma (c_macro)) NATIVE_DOUBLE_EXPRESSION LongDouble))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value NATIVE_DOUBLE_EXPRESSION)
			(return 42i32))))
