(module stddef_nullptr
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stddef.h>" (only (type (as Nullptr NativeNull))))
	(use c-header "./activation.h" (only fixture_nullptr fixture_nullptr_copy fixture_nullptr_read))
	(bridge c-header "./activation.h"
		(use c-header "<stddef.h>" (only (type (as Nullptr Value))))
		(fn fixture_nullptr (params) (returns Value))
		(fn fixture_nullptr_copy (params (value Value)) (returns Value))
		(fn fixture_nullptr_read (:pragma (c_nullable value))
			(params (value (shared-ref Value))) (returns i32)))

	(fn copy (params (value NativeNull)) (returns NativeNull)
		(body (return (call fixture_nullptr_copy value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (call copy (call fixture_nullptr)))
			(if (i32:not-eq (call fixture_nullptr_read (borrow-shared value)) 42i32) (then (return 1i32)))
			(if (i32:not-eq (call fixture_nullptr_read null) 7i32) (then (return 2i32)))
			(return 42i32))))
