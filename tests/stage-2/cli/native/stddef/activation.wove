(module stddef_activation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stddef.h>" (only (value (as NULL absent)) (as offsetof byte_offset)))
	(use c-header "./activation.h" (only (type (as FixtureLayout Layout)) fixture_nullable fixture_offsets))
	(bridge c-header "./activation.h"
		(use c-header "<stddef.h>" (only (type Size)))
		(struct FixtureLayout (c-type "struct fixture_layout") (fields (tag u8) (payload u64)))
		(fn fixture_nullable (:pragma (c_nullable value))
			(params (value (mut-ref i32))) (returns i32))
		(fn fixture_offsets (params (tag Size) (payload Size)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_nullable absent) 42i32) (then (return 1i32)))
			(let-mut present 41i32)
			(if (i32:not-eq (call fixture_nullable (borrow-mut present)) 42i32) (then (return 2i32)))
			(if (i32:not-eq present 42i32) (then (return 3i32)))
			(let tag (call byte_offset (c-type Layout) (c-member tag)))
			(let payload (call byte_offset (c-type Layout) (c-member payload)))
			(return (call fixture_offsets tag payload)))))
