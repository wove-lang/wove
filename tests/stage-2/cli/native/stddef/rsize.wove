(module stddef_rsize
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type RSize)))
	(use c-header "./oracle.h" (only fixture_rsize fixture_check_rsize))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type RSize)))
		(fn fixture_rsize (params) (returns RSize))
		(fn fixture_check_rsize (params (value RSize)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (call fixture_check_rsize (int:convert RSize (int:convert u64 (call fixture_rsize)))) (then (return 42i32)))
			(return 1i32))))
