(module stddef_alignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type MaxAlign)))
	(use c-header "./oracle.h" (only fixture_check_alignment))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type MaxAlign)))
		(fn fixture_check_alignment (params (value (shared-ref MaxAlign))) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct:new MaxAlign))
			(if (call fixture_check_alignment (borrow-shared value)) (then (return 42i32)))
			(return 1i32))))
