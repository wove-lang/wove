(module stddef_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type Size) (type PtrDiff) (type WChar)))
	(use c-header "./oracle.h" (only fixture_size fixture_difference fixture_wide fixture_matches))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type Size) (type PtrDiff) (type WChar)))
		(fn fixture_size (params) (returns Size))
		(fn fixture_difference (params) (returns PtrDiff))
		(fn fixture_wide (params) (returns WChar))
		(fn fixture_matches (params (size Size) (difference PtrDiff) (wide WChar)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let size (call fixture_size))
			(let difference (call fixture_difference))
			(let wide (call fixture_wide))
			(if (call fixture_matches (int.convert Size (int.convert u64 size))
					(int.convert PtrDiff (int.convert i64 difference)) (int.convert WChar (int.convert u64 wide)))
				(then (return 42i32)))
			(return 1i32))))
