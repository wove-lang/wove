(module stddef_alignment_float
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "./oracle.h" (only fixture_max_align_value fixture_max_align_matches))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type DarwinMaxAlign)))
		(fn fixture_max_align_value (params) (returns DarwinMaxAlign))
		(fn fixture_max_align_matches (params (value DarwinMaxAlign)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (call fixture_max_align_value))
			(if (call fixture_max_align_matches value) (then (return 42i32)))
			(return 1i32))))
