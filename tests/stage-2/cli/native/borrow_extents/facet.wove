(module exact_stl_facet
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(let FACET 50i32)

	(fn unrestricted
		(params (bytes (shared-array u8))) (returns i32)
		(body (return (array:len bytes))))

	(fn inspect
		(params (facet (shared-array u8 FACET)) (extra i32)) (returns i32)
		(body
			(let coordinate (u32:from-le-bytes (borrow-shared (array:range facet 0i32 4i32))))
			(if (bool:not (u32:eq coordinate 42u32)) (then (return 2i32)))
			(if (bool:not (i32:eq (call unrestricted (borrow-shared facet)) 50i32)) (then (return 3i32)))
			(return (i32:add extra 42i32))))

	(fn later
		(params (arguments i32)) (returns i32)
		(body (return (i32:div 0i32 (i32:sub arguments 1i32)))))

	(fn inspect_window
		(params (bytes (shared-array u8)) (arguments i32)) (returns i32)
		(body
			(let literal (call inspect (borrow-shared (array:range bytes 1i32 51i32)) 0i32))
			(if (bool:not (i32:eq literal 42i32)) (then (return 4i32)))
			(let limit (i32:sub 51i32 arguments))
			(return (call inspect (borrow-shared (array:range bytes 1i32 limit))
				(call later arguments)))))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut buffer (array:repeat (array u8 51) 0u8))
			(array:set buffer 1i32 42u8)
			(return (call inspect_window (borrow-shared buffer) (i32:dec (array:len spans))))))
)
