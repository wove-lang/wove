(module dynamic_mutable_window
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (window (mut-array u8 2))) (returns i32)
		(body
			(array.store (local window) 1i32 42u8)
			(return (array.len (local window)))))

	(fn write_window
		(params (bytes (mut-array u8)) (limit i32)) (returns i32)
		(body (return (call write_byte (borrow-mut (array.range (local bytes) 1i32 (local limit)))))))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut buffer (array.repeat (array u8 4) 0u8))
			(let limit (i32.sub 3i32 (i32.dec (array.len (local spans)))))
			(let length (call write_window (borrow-mut (local buffer)) (local limit)))
			(if (bool.not (i32.eq (local length) 2i32)) (then (return 1i32)))
			(return (int.convert i32 (array.load (local buffer) 2i32)))))
)
