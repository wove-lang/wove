(module exact_rle_codec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(let PAYLOAD_SIZE 33024u32)

	(fn write_payload
		(params (output (mut-array u8 PAYLOAD_SIZE))) (returns i32)
		(body
			(array.store output 33023i32 42u8)
			(return (array.len output))))
)
