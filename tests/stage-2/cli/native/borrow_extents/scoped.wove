(module exact_scoped_window
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_pair
		(params (window (mut-array u8 2))) (returns void)
		(body
			(array:set window 0i32 19u8)
			(array:set window 1i32 23u8)))

	(fn read_pair
		(params (window (shared-array u8 2))) (returns i32)
		(body (return (i32:add (int:convert i32 (array:get window 0i32))
			(int:convert i32 (array:get window 1i32))))))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut buffer (array:alloc u8 4i32))
			(let window (borrow-mut (array:range buffer 1i32 3i32)))
			(call write_pair (borrow-mut window))
			(return (call read_pair (borrow-shared window)))))
)
