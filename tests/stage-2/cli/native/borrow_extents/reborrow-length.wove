(module borrow_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn take
		(params (data (shared-array u8 2))) (returns i32)
		(body (return (array.len (local data)))))
	(fn forward (params (view (shared-array u8 3))) (returns i32)
		(body (return (call take (borrow-shared (local view))))))
	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body (return 0i32)))
)
