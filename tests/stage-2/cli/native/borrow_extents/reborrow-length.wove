(module borrow_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn take
		(params (data (shared-array u8 2))) (returns i32)
		(body (return (array.len data))))
	(fn forward (params (view (shared-array u8 3))) (returns i32)
		(body (return (call take (borrow-shared view)))))
	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32)))
)
