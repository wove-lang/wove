(module exact_rle_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./codec.wove" (only (value PAYLOAD_SIZE) write_payload))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn forward
		(params (output (mut-array u8 PAYLOAD_SIZE))) (returns i32)
		(body (return (call write_payload (borrow-mut (local output))))))

	(fn first_word
		(params (words (shared-array i32 2))) (returns i32)
		(body (return (array.load (local words) 0i32))))

	(fn empty_extent
		(params (empty (shared-array u8 0))) (returns i32)
		(body (return (array.len (local empty)))))

	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut buffer (array.repeat (array u8 PAYLOAD_SIZE) 0u8))
			(let count (call forward (borrow-mut (local buffer))))
			(if (bool.not (i32.eq (local count) 33024i32)) (then (return 1i32)))
			(let words (array.new (array i32 2) 0i32 1i32))
			(let empty (call empty_extent (borrow-shared (array.range (local bytes) 0i32 0i32))))
			(return (i32.add.wrapping (local empty) (i32.add.wrapping (call first_word (borrow-shared (local words)))
				(int.convert i32 (array.load (local buffer) 33023i32)))))))
)
