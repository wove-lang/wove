(module borrow_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn take
		(params (data (shared-array u8 3))) (returns i32)
		(body (return (array.len (local data)))))
	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body (let data (array.alloc u8 4i32)) (return (call take (borrow-shared (array.range (local data) 1i32 3i32))))))
)
