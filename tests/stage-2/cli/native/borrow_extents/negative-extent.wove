(module borrow_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn take
		(params (data (shared-array u8 -1))) (returns i32)
		(body (return (array.len (local data)))))
	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32)))
)
