(module fixed_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (words (array u32 8)) (block (array u8 128))))

	(fn iv
		(:doc "Use the high limbs of the archive's eight initialization words.")
		(params)
		(returns (array u32 8))
		(body
			(return (array.new (array u32 8)
				(u32 1779033703) (u32 3144134277) (u32 1013904242) (u32 2773480762)
				(u32 1359893119) (u32 2600822924) (u32 528734635) (u32 1541459225)))))

	(fn sigma
		(:doc "Use the low limbs of the archive's ten packed permutation words.")
		(params)
		(returns (array u32 10))
		(body
			(return (array.new (array u32 10)
				(u32 1985229328) (u32 1845068974) (u32 3743747211) (u32 3956085655)
				(u32 4198659337) (u32 951101122) (u32 2766074204) (u32 2468145085)
				(u32 2151390966) (u32 1365723178)))))

	(fn tick
		(params (counter (mut-array u8)))
		(returns u8)
		(body
			(let current (array.load (local counter) (i32 0)))
			(let next (int.convert u8 (i32.add (int.convert i32 (local current)) (i32 1))))
			(array.store (local counter) (i32 0) (local next))
			(return (local next))))

	(fn state
		(params (counter (mut-array u8)))
		(returns State)
		(body
			(return (struct.new State
				(words (call iv))
				(block (array.repeat (array u8 128) (call tick (borrow-mut (local counter)))))))))

	(fn last_word
		(params (words (array u32 8)))
		(returns u32)
		(body (return (array.load (local words) (i32 7)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut counter (array.alloc u8 (i32 1)))
			(let-mut original (call state (borrow-mut (local counter))))
			(let saved (local original))
			(let-mut block (struct.get (local original) block))
			(array.store (local block) (i32 127) (u8 42))
			(set (local original) (struct.new State (words (call iv)) (block (local block))))
			(if (bool.not (u8.eq (array.load (struct.get (local saved) block) (i32 127)) (u8 1)))
				(then (return (i32 1))))
			(if (bool.not (u8.eq (array.load (struct.get (local original) block) (i32 0)) (u8 1)))
				(then (return (i32 2))))
			(if (bool.not (u32.eq (call last_word (struct.get (local saved) words)) (u32 1541459225)))
				(then (return (i32 3))))
			(if (bool.not (u32.eq (array.load (call sigma) (i32 9)) (u32 1365723178)))
				(then (return (i32 4))))
			(let empty (array.repeat (array u8 0) (call tick (borrow-mut (local counter)))))
			(let empty_list (array.new (array u8 0)))
			(if (bool.not (u8.eq (call tick (borrow-mut (local counter))) (u8 3)))
				(then (return (i32 5))))
			(return (int.convert i32 (array.load (struct.get (local original) block) (i32 127)))))))
