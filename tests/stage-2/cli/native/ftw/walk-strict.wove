(module bundled_ftw_strict_walk
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<ftw.h>" (only ftw FTW_D FTW_F))
	(use c-header "<sys/stat.h>" (only (type WalkStatus)))
	(bridge c-header "<sys/stat.h>"
		(struct WalkStatus (c-type "struct stat") (fields (st_size i64))))

	(let root "walk-root")

	(fn visit (params (path (shared-array u8)) (status (optional (shared-ref WalkStatus))) (kind i32)) (returns i32)
		(body
			(if (optional.is-none status) (then (return 101i32)))
			(if (i32.eq kind FTW_D) (then (return 0i32)))
			(let info (optional.unwrap status))
			(if (bool.and (i32.eq kind FTW_F) (i64.gtz (struct.get info st_size)))
				(then (return 42i32)))
			(return 102i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call ftw (borrow-shared root) (fn-ref visit) 2i32)))))
