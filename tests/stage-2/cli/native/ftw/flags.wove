(module bundled_ftw_flags
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<ftw.h>"
		(only (value FTW_F) (value FTW_D) (value FTW_DNR) (value FTW_NS) (value FTW_SL) (value FTW_DP) (value FTW_SLN)
			(value FTW_PHYS) (value FTW_MOUNT) (value FTW_CHDIR) (value FTW_DEPTH)))
	(use (:pragma (cfg (os "linux"))) c-header "<ftw.h>"
		(only (value FTW_ACTIONRETVAL) (value FTW_CONTINUE) (value FTW_STOP)
			(value FTW_SKIP_SUBTREE) (value FTW_SKIP_SIBLINGS)))
	(use c-header "./oracle.h" (only fixture_ftw_constant))
	(bridge c-header "./oracle.h"
		(fn fixture_ftw_constant (params (member i32)) (returns i32)))

	(fn check_gnu (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32.not-eq FTW_ACTIONRETVAL (call fixture_ftw_constant 11i32)) (then (return 12i32)))
			(if (i32.not-eq FTW_CONTINUE (call fixture_ftw_constant 12i32)) (then (return 13i32)))
			(if (i32.not-eq FTW_STOP (call fixture_ftw_constant 13i32)) (then (return 14i32)))
			(if (i32.not-eq FTW_SKIP_SUBTREE (call fixture_ftw_constant 14i32)) (then (return 15i32)))
			(if (i32.not-eq FTW_SKIP_SIBLINGS (call fixture_ftw_constant 15i32)) (then (return 16i32)))
			(return 0i32)))
	(fn check_gnu (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq FTW_F (call fixture_ftw_constant 0i32)) (then (return 1i32)))
			(if (i32.not-eq FTW_D (call fixture_ftw_constant 1i32)) (then (return 2i32)))
			(if (i32.not-eq FTW_DNR (call fixture_ftw_constant 2i32)) (then (return 3i32)))
			(if (i32.not-eq FTW_NS (call fixture_ftw_constant 3i32)) (then (return 4i32)))
			(if (i32.not-eq FTW_SL (call fixture_ftw_constant 4i32)) (then (return 5i32)))
			(if (i32.not-eq FTW_DP (call fixture_ftw_constant 5i32)) (then (return 6i32)))
			(if (i32.not-eq FTW_SLN (call fixture_ftw_constant 6i32)) (then (return 7i32)))
			(if (i32.not-eq FTW_PHYS (call fixture_ftw_constant 7i32)) (then (return 8i32)))
			(if (i32.not-eq FTW_MOUNT (call fixture_ftw_constant 8i32)) (then (return 9i32)))
			(if (i32.not-eq FTW_CHDIR (call fixture_ftw_constant 9i32)) (then (return 10i32)))
			(if (i32.not-eq FTW_DEPTH (call fixture_ftw_constant 10i32)) (then (return 11i32)))
			(let gnu (call check_gnu))
			(if (i32.not-eq gnu 0i32) (then (return gnu)))
			(return 42i32))))
