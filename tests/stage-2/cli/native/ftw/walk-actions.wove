(module bundled_ftw_walk_actions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<sys/stat.h>" (only (type Stat)))
	(use (:pragma (cfg (os "linux"))) c-header "<ftw.h>" (only (type Ftw) nftw FTW_ACTIONRETVAL FTW_CONTINUE FTW_STOP FTW_SKIP_SUBTREE))

	(let root "walk-root")

	(fn skip_root (:pragma (cfg (os "linux")))
		(params (path (shared-array u8)) (status (optional (shared-ref Stat))) (kind i32) (position (shared-ref Ftw)))
		(returns i32)
		(body
			(if (i32.eqz (struct.get position level)) (then (return FTW_SKIP_SUBTREE)))
			(return FTW_STOP)))

	(fn stop_on_leaf (:pragma (cfg (os "linux")))
		(params (path (shared-array u8)) (status (optional (shared-ref Stat))) (kind i32) (position (shared-ref Ftw)))
		(returns i32)
		(body
			(if (i32.eqz (struct.get position level)) (then (return FTW_CONTINUE)))
			(return FTW_STOP)))

	(fn check_native (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32.not-eqz (call nftw (borrow-shared root) (fn-ref skip_root) 2i32 FTW_ACTIONRETVAL))
				(then (return 109i32)))
			(if (i32.not-eq (call nftw (borrow-shared root) (fn-ref stop_on_leaf) 2i32 FTW_ACTIONRETVAL) FTW_STOP)
				(then (return 110i32)))
			(return 42i32)))

	(fn check_native (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_native)))))
