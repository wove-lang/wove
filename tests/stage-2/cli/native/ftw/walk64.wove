(module bundled_ftw_walk64
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<sys/stat.h>" (only (type Stat64)))
	(use (:pragma (cfg (os "linux"))) c-header "<ftw.h>" (only (type Ftw) ftw64 nftw64 FTW_F FTW_D FTW_PHYS))

	(use (:pragma (cfg (os "linux"))) c-header "./walk64-oracle.h" (only (type StatWord) ftw_oracle_stat64_matches))
	(bridge c-header "./walk64-oracle.h" (:pragma (cfg (os "linux")))
		(type StatWord (c-type "uint64_t"))
		(fn ftw_oracle_stat64_matches
			(params (device StatWord) (inode StatWord) (mode StatWord) (links StatWord) (uid StatWord) (gid StatWord)
				(special StatWord) (size StatWord) (block_size StatWord) (blocks StatWord))
			(returns bool)))

	(let root "walk-root")

	(fn visit (:pragma (cfg (os "linux"))) (params (path (shared-array u8)) (status (optional (shared-ref Stat64))) (kind i32)) (returns i32)
		(body
			(if (optional.is-none status) (then (return 100i32)))
			(if (i32.eq kind FTW_D)
				(then
					(if (i32.not-eq (array.len path) (array.len root)) (then (return 101i32)))
					(return 0i32)))
			(let info (optional.unwrap status))
			(if (bool.or (i32.not-eq kind FTW_F) (i64.not-gtz (struct.get info st_size)))
				(then (return 102i32)))
			(if (bool.not (call ftw_oracle_stat64_matches
				(int.convert StatWord (struct.get info st_dev)) (int.convert StatWord (struct.get info st_ino))
				(int.convert StatWord (struct.get info st_mode)) (int.convert StatWord (struct.get info st_nlink))
				(int.convert StatWord (struct.get info st_uid)) (int.convert StatWord (struct.get info st_gid))
				(int.convert StatWord (struct.get info st_rdev)) (int.convert StatWord (struct.get info st_size))
				(int.convert StatWord (struct.get info st_blksize)) (int.convert StatWord (struct.get info st_blocks))))
				(then (return 109i32)))
			(return 77i32)))

	(fn visit_nftw (:pragma (cfg (os "linux")))
		(params (path (shared-array u8)) (status (optional (shared-ref Stat64))) (kind i32) (position (shared-ref Ftw)))
		(returns i32)
		(body
			(if (i32.eq kind FTW_D)
				(then
					(if (bool.or (i32.not-eqz (struct.get position level)) (i32.not-eqz (struct.get position base)))
						(then (return 103i32)))
					(return (call visit (borrow-shared path) status kind))))
			(let base (struct.get position base))
			(if (bool.or (i32.not-eq (struct.get position level) 1i32)
				(i32.not-eq base (i32.inc (array.len root))))
				(then (return 104i32)))
			(if (u8.not-eq (array.load path base) 108u8) (then (return 105i32)))
			(if (i32.not-eq (call visit (borrow-shared path) status kind) 77i32)
				(then (return 106i32)))
			(return 78i32)))

	(fn check_native (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32.not-eq (call ftw64 (borrow-shared root) (fn-ref visit) 2i32) 77i32) (then (return 107i32)))
			(if (i32.not-eq (call nftw64 (borrow-shared root) (fn-ref visit_nftw) 2i32 FTW_PHYS) 78i32)
				(then (return 108i32)))
			(return 42i32)))

	(fn check_native (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_native)))))
