(module bundled_ftw_walk
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<sys/stat.h>" (only (type Stat)))
	(use c-header "<ftw.h>" (only (type Ftw) ftw nftw FTW_F FTW_D FTW_PHYS))

	(let root "walk-root")

	(fn visit (params (path (shared-array u8)) (status (optional (shared-ref Stat))) (kind i32)) (returns i32)
		(body
			(if (optional.is-none status) (then (return 100i32)))
			(if (i32.eq kind FTW_D)
				(then
					(if (i32.not-eq (array.len path) (array.len root)) (then (return 101i32)))
					(return 0i32)))
			(let info (optional.unwrap status))
			(if (bool.or (i32.not-eq kind FTW_F) (i64.not-gtz (int.convert i64 (struct.get info st_size))))
				(then (return 102i32)))
			(return 77i32)))

	(fn visit_nftw
		(params (path (shared-array u8)) (status (optional (shared-ref Stat))) (kind i32) (position (shared-ref Ftw)))
		(returns i32)
		(body
			(if (i32.eq kind FTW_D)
				(then
					(if (bool.or (i32.not-eqz (struct.get position level)) (i32.not-eqz (struct.get position base)))
						(then (return 103i32)))
					(return (call visit (borrow-shared path) status kind))))
			(let base (struct.get position base))
			(if (bool.or (i32.not-eq (struct.get position level) 1i32)
				(i32.not-eq base (i32.inc (array.len root))))
				(then (return 104i32)))
			(if (u8.not-eq (array.load path base) 108u8) (then (return 105i32)))
			(if (i32.not-eq (call visit (borrow-shared path) status kind) 77i32)
				(then (return 106i32)))
			(return 78i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq (call ftw (borrow-shared root) (fn-ref visit) 2i32) 77i32) (then (return 107i32)))
			(if (i32.not-eq (call nftw (borrow-shared root) (fn-ref visit_nftw) 2i32 FTW_PHYS) 78i32)
				(then (return 108i32)))
			(return 42i32))))
