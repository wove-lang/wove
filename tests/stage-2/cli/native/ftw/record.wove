(module bundled_ftw_record
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<ftw.h>" (only (type Ftw)))
	(use (:pragma (cfg (os "macos"))) c-header "./oracle.h"
		(only fixture_ftw_write fixture_ftw_base fixture_ftw_level))
	(bridge c-header "./oracle.h"
		(use (:pragma (cfg (os "macos"))) c-header "<ftw.h>" (only (type Ftw)))
		(fn fixture_ftw_write (:pragma (cfg (os "macos")))
			(params (record (mut-ref Ftw)) (base i32) (level i32)) (returns i32))
		(fn fixture_ftw_base (:pragma (cfg (os "macos"))) (params (record (shared-ref Ftw))) (returns i32))
		(fn fixture_ftw_level (:pragma (cfg (os "macos"))) (params (record (shared-ref Ftw))) (returns i32)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (:pragma (cfg (os "macos"))) (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut native (struct.new Ftw))
			(if (i32.not-eq (call fixture_ftw_write (borrow-mut native) 19i32 3i32) 0i32)
				(then (return 5i32)))
			(if (i32.not-eq (struct.get native base) 19i32) (then (return 1i32)))
			(if (i32.not-eq (struct.get native level) 3i32) (then (return 2i32)))
			(let authored (struct.new Ftw (base 27i32) (level 9i32)))
			(if (i32.not-eq (call fixture_ftw_base (borrow-shared authored)) 27i32) (then (return 3i32)))
			(if (i32.not-eq (call fixture_ftw_level (borrow-shared authored)) 9i32) (then (return 4i32)))
			(return 42i32)))
	(fn main (:pragma (cfg (not (os "macos")))) (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 42i32))))
