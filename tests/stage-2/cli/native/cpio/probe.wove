(module cpio_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "CPIO_HEADER"
		(only (value C_IRGRP) (value C_IROTH) (value C_IRUSR) (value C_ISBLK) (value C_ISCHR)
			(value C_ISCTG) (value C_ISDIR) (value C_ISFIFO) (value C_ISGID) (value C_ISLNK)
			(value C_ISREG) (value C_ISSOCK) (value C_ISUID) (value C_ISVTX) (value C_IWGRP)
			(value C_IWOTH) (value C_IWUSR) (value C_IXGRP) (value C_IXOTH) (value C_IXUSR) (value MAGIC)))
	(use c-header "./oracle.h" (only fixture_cpio_modes fixture_cpio_magic))
	(bridge c-header "./oracle.h"
		(fn fixture_cpio_modes
			(:pragma (c_array values 20))
			(params (values (shared-array i32))) (returns i32))
		(fn fixture_cpio_magic
			(:pragma (c_bytes bytes length))
			(params (bytes (shared-array u8)) (length i32)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let values (array.new (array i32 20)
				C_IRGRP C_IROTH C_IRUSR C_ISBLK C_ISCHR C_ISCTG C_ISDIR
				C_ISFIFO C_ISGID C_ISLNK C_ISREG C_ISSOCK C_ISUID C_ISVTX
				C_IWGRP C_IWOTH C_IWUSR C_IXGRP C_IXOTH C_IXUSR))
			(let mismatch (call fixture_cpio_modes (borrow-shared values)))
			(if (i32.not-eqz mismatch) (then (return mismatch)))
			(if (bool.not (call fixture_cpio_magic (borrow-shared MAGIC) (array.len MAGIC)))
				(then (return 21i32)))
			(return 42i32))))
