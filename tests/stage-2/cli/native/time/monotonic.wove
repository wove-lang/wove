(module bundled_monotonic_clock
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<time.h>" (only (type Clock) (type Stamp) (type Time) (type Long)
		(value CLOCK_MONOTONIC) clock_gettime))


	(fn read_clock (params (clock Clock)) (returns i32)
		(body
			(let-mut stamp (struct:new Stamp
				(tv_sec (int:convert Time -1i32)) (tv_nsec (int:convert Long -1i32))))
			(if (i32:not-eqz (call clock_gettime clock (borrow-mut stamp)))
				(then (return 1i32)))
			(let seconds (int:convert i64 (struct:get stamp tv_sec)))
			(let nanoseconds (int:convert i64 (struct:get stamp tv_nsec)))
			(if (bool:or (i64:ltz seconds)
					(bool:or (i64:ltz nanoseconds) (i64:not-lt nanoseconds 1000000000i64)))
				(then (return 2i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call read_clock CLOCK_MONOTONIC)))))
