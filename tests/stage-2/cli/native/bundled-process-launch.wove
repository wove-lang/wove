(module bundled_process_launch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./io/process.wove" (only run_process_capture))
	(use c-header "<errno.h>" (only EINTR))

	(let program "printf")
	(let arguments "42!\u0000")

	(fn prefix_matches
		(params (output (shared-array u8))) (returns bool)
		(body
			(return (bool:and (u8:eq (array:get output 0i32) 52u8)
				(u8:eq (array:get output 1i32) 50u8)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array:alloc u8 2i32))
			(let result (call run_process_capture (borrow-shared program)
				(borrow-shared arguments) (borrow-mut output)))
			(if (bool:not (bool:and (i32:eq (struct:get result status) 0i32)
				(bool:and (i32:eq (struct:get result length) 2i32) (struct:get result overflow))))
				(then (return 1i32)))
			(if (bool:not (call prefix_matches (borrow-shared output))) (then (return 2i32)))
			(if (i32:lt 0i32 EINTR) (then (return 42i32)))
			(return 3i32)))
)
