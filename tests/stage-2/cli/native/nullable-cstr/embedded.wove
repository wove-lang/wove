(module native_nullable_cstr_embedded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_single))
	(bridge c-header "./native.h"
		(fn fixture_single
			(:pragma (c_cstr value) (c_nullable value))
			(params (value (shared-array u8))) (returns i32)))

	(let bad "before\u0000after")
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call fixture_single (borrow-shared (local bad)))))))
