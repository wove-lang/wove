(module native_unmarked_cstr
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_single))
	(bridge c-header "./native.h"
		(fn fixture_single
			(:pragma (c_cstr value))
			(params (value (shared-array u8))) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_single null)))))
