(module native_nullable_cstr
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_next fixture_nullable fixture_mutate))
	(bridge c-header "./native.h"
		(fn fixture_next (params (step i32)) (returns i32))
		(fn fixture_nullable
			(:pragma (c_nullable first second third) (c_cstr first second third))
			(params (first (shared-array u8)) (stamp i32) (const fixed (c-type "const char *") null)
				(second (shared-array u8)) (third (shared-array u8)) (tail i32))
			(returns i32))
		(fn fixture_mutate
			(:pragma (c_cstr omitted value suffix) (c_nullable omitted suffix))
			(params (omitted (shared-array u8)) (value (mut-array u8)) (suffix (shared-array u8)))
			(returns i32)))

	(let empty "")
	(let padded "..value")
	(let text "value")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mixed (call fixture_nullable null (call fixture_next 1i32)
				(borrow-shared empty)
				(borrow-shared (array:range padded (call fixture_next 2i32) 7i32)) (call fixture_next 3i32)))
			(if (i32:not-eq mixed 42i32) (then (return 1i32)))
			(if (i32:not-eq (call fixture_nullable null 4i32 null null 5i32) 42i32)
				(then (return 2i32)))
			(if (i32:not-eq (call fixture_nullable (borrow-shared text) 6i32 null
				(borrow-shared empty) 7i32) 42i32)
				(then (return 3i32)))
			(let-mut writable (array:new (array u8 2) 97u8 98u8))
			(if (i32:not-eq (call fixture_mutate null (borrow-mut writable) (borrow-shared text)) 42i32)
				(then (return 4i32)))
			(if (u8:not-eq (array:get writable 0i32) 122u8) (then (return 5i32)))
			(if (u8:not-eq (array:get writable 1i32) 98u8) (then (return 6i32)))
			(return 42i32))))
