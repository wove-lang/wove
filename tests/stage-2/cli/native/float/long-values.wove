(module bundled_float_long_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>"
		(only (value LDBL_EPSILON) (value LDBL_MAX) (value LDBL_MIN) (value LDBL_TRUE_MIN)))
	(use c-header "<math.h>" (only fabsl))
	(use c-header "./native.h" (only native_long_matches))
	(bridge c-header "./native.h"
		(use c-header "<math.h>" (only (type LongDouble)))
		(fn native_long_matches (params (value LongDouble) (index i32)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq (call native_long_matches (call fabsl LDBL_EPSILON) 0i32) 1i32)
				(then (return 1i32)))
			(if (i32.not-eq (call native_long_matches (call fabsl LDBL_MAX) 1i32) 1i32)
				(then (return 2i32)))
			(if (i32.not-eq (call native_long_matches (call fabsl LDBL_MIN) 2i32) 1i32)
				(then (return 3i32)))
			(if (i32.not-eq (call native_long_matches (call fabsl LDBL_TRUE_MIN) 3i32) 1i32)
				(then (return 4i32)))
			(return 42i32))))
