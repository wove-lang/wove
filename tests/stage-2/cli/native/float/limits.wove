(module bundled_float_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>"
		(only (value DECIMAL_DIG) (value FLT_EVAL_METHOD) (value FLT_RADIX) (value FLT_ROUNDS)
			(value FLT_DECIMAL_DIG) (value FLT_DIG) (value FLT_HAS_SUBNORM) (value FLT_MANT_DIG)
			(value FLT_MAX_10_EXP) (value FLT_MAX_EXP) (value FLT_MIN_10_EXP) (value FLT_MIN_EXP)
			(value DBL_DECIMAL_DIG) (value DBL_DIG) (value DBL_HAS_SUBNORM) (value DBL_MANT_DIG)
			(value DBL_MAX_10_EXP) (value DBL_MAX_EXP) (value DBL_MIN_10_EXP) (value DBL_MIN_EXP)
			(value LDBL_DECIMAL_DIG) (value LDBL_DIG) (value LDBL_HAS_SUBNORM) (value LDBL_MANT_DIG)
			(value LDBL_MAX_10_EXP) (value LDBL_MAX_EXP) (value LDBL_MIN_10_EXP) (value LDBL_MIN_EXP)))
	(use c-header "<fenv.h>"
		(only (type Environment) feholdexcept fesetenv fesetround
			(value FE_DOWNWARD) (value FE_TONEAREST) (value FE_TOWARDZERO) (value FE_UPWARD)))
	(use c-header "./integer.h" (only native_float_limit native_float_rounds))
	(bridge c-header "./integer.h"
		(fn native_float_limit (params (index i32)) (returns i32))
		(fn native_float_rounds (params) (returns i32)))


	(fn check_limits (params) (returns i32)
		(body
			(let limits (array.new (array i32 27)
				DECIMAL_DIG FLT_EVAL_METHOD FLT_RADIX
				FLT_DECIMAL_DIG FLT_DIG FLT_HAS_SUBNORM FLT_MANT_DIG
				FLT_MAX_10_EXP FLT_MAX_EXP FLT_MIN_10_EXP FLT_MIN_EXP
				DBL_DECIMAL_DIG DBL_DIG DBL_HAS_SUBNORM DBL_MANT_DIG
				DBL_MAX_10_EXP DBL_MAX_EXP DBL_MIN_10_EXP DBL_MIN_EXP
				LDBL_DECIMAL_DIG LDBL_DIG LDBL_HAS_SUBNORM LDBL_MANT_DIG
				LDBL_MAX_10_EXP LDBL_MAX_EXP LDBL_MIN_10_EXP LDBL_MIN_EXP))
			(let-mut index 0i32)
			(while (i32.lt index (array.len limits))
				(body
					(if (i32.not-eq (array.load limits index) (call native_float_limit index))
						(then (return (i32.add 1i32 index))))
					(set index (i32.inc index))))
			(return 0i32)))

	(fn check_rounds (params) (returns i32)
		(body
			(let modes (array.new (array i32 4)
				FE_TOWARDZERO FE_TONEAREST FE_UPWARD FE_DOWNWARD))
			(let-mut index 0i32)
			(while (i32.lt index (array.len modes))
				(body
					(if (i32.not-eqz (call fesetround (array.load modes index)))
						(then (return 29i32)))
					(let mode FLT_ROUNDS)
					(if (i32.not-eq mode (call native_float_rounds))
						(then (return 30i32)))
					(if (i32.not-eq mode index)
						(then (return (i32.add 31i32 index))))
					(set index (i32.inc index))))
			(return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let limits (call check_limits))
			(if (i32.not-eqz limits) (then (return limits)))
			(let-mut original (struct.new Environment))
			(if (i32.not-eqz (call feholdexcept (borrow-mut original))) (then (return 28i32)))
			(let rounds (call check_rounds))
			(if (i32.not-eqz (call fesetenv (borrow-shared original))) (then (return 35i32)))
			(if (i32.not-eqz rounds) (then (return rounds)))
			(return 42i32))))
