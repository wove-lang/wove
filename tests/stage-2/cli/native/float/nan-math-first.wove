(module bundled_float_nan_math_first
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<math.h>" (only fabsl))
	(use c-header "<float.h>" (only (value (as NAN expression))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (u32.eq (u32.and (f32.to-bits expression) 0x7fc00000u32) 0x7fc00000u32)
				(then (return 42i32)))
			(return 1i32))))
