(module bundled_float_norm_long
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as LDBL_NORM_MAX maximum))))
	(use c-header "./native.h" (only native_long_matches))
	(bridge c-header "./native.h"
		(use c-header "<math.h>" (only (type LongDouble)))
		(fn native_long_matches (params (value LongDouble) (index i32)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eq (call native_long_matches maximum 1i32) 1i32)
				(then (return 42i32)))
			(return 1i32))))
