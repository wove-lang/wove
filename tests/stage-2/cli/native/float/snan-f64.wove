(module bundled_float_snan_f64
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as DBL_SNAN expression))))
	(use c-header "./snan.h" (only native_double_snan_matches))
	(bridge c-header "./snan.h"
		(fn native_double_snan_matches (params (value f64)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value expression)
			(let bits (f64:to-bits value))
			(if (i32:not-eq (call native_double_snan_matches value) 1i32)
				(then (return 1i32)))
			(if (bool:not (u64:eq (u64:and bits 0x7ff8000000000000u64) 0x7ff0000000000000u64))
				(then (return 2i32)))
			(if (u64:eq (u64:and bits 0x0007ffffffffffffu64) 0u64)
				(then (return 3i32)))
			(return 42i32))))
