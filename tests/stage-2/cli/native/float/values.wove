(module bundled_float_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>"
		(only (value FLT_EPSILON) (value FLT_MAX) (value FLT_MIN) (value FLT_TRUE_MIN)
			(value DBL_EPSILON) (value DBL_MAX) (value DBL_MIN) (value DBL_TRUE_MIN)))
	(use c-header "./floating.h" (only native_float_value native_double_value))
	(bridge c-header "./floating.h"
		(fn native_float_value (params (index i32)) (returns f32))
		(fn native_double_value (params (index i32)) (returns f64)))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let floats (array:new (array f32 4)
				FLT_EPSILON FLT_MAX FLT_MIN FLT_TRUE_MIN))
			(let doubles (array:new (array f64 4)
				DBL_EPSILON DBL_MAX DBL_MIN DBL_TRUE_MIN))
			(let-mut index 0i32)
			(while (i32:lt index (array:len floats))
				(body
					(if (f32:not-eq (array:load floats index) (call native_float_value index))
						(then (return (i32:add 1i32 index))))
					(if (f64:not-eq (array:load doubles index) (call native_double_value index))
						(then (return (i32:add 5i32 index))))
					(set index (i32:inc index))))
			(return 42i32))))
