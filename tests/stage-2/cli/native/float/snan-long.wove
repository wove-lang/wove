(module bundled_float_snan_long
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as LDBL_SNAN expression))))
	(use c-header "./snan.h" (only native_long_double_snan_matches))
	(bridge c-header "./snan.h"
		(use c-header "<math.h>" (only (type LongDouble)))
		(fn native_long_double_snan_matches (params (value LongDouble)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:eq (call native_long_double_snan_matches expression) 1i32)
				(then (return 42i32)))
			(return 1i32))))
