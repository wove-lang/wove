(module bundled_float_norm_f32
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as FLT_NORM_MAX expression)) (value FLT_MAX)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (f32.eq expression FLT_MAX)
				(then (return 42i32)))
			(return 1i32))))
