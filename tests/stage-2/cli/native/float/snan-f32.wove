(module bundled_float_snan_f32
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as FLT_SNAN expression))))
	(use c-header "./snan.h" (only native_float_snan_bits))
	(bridge c-header "./snan.h"
		(fn native_float_snan_bits (params) (returns u32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let bits (f32.to-bits expression))
			(if (bool.not (u32.eq bits (call native_float_snan_bits)))
				(then (return 1i32)))
			(if (bool.not (u32.eq (u32.and bits 0x7fc00000u32) 0x7f800000u32))
				(then (return 2i32)))
			(if (u32.eq (u32.and bits 0x003fffffu32) 0u32)
				(then (return 3i32)))
			(return 42i32))))
