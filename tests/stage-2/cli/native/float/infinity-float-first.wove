(module bundled_float_infinity_float_first
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as INFINITY expression))))
	(use c-header "<math.h>" (only fabsl))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (u32.eq (f32.to-bits expression) 0x7f800000u32)
				(then (return 42i32)))
			(return 1i32))))
