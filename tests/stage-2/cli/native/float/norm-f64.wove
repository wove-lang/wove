(module bundled_float_norm_f64
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as DBL_NORM_MAX expression)) (value DBL_MAX)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (f64.eq expression DBL_MAX)
				(then (return 42i32)))
			(return 1i32))))
