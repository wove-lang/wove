(module object_job_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../../stage-2/driver/bin/object_jobs.wove"
		(only run_object_jobs (type ObjectJob)))
	(use wove-file "../../../../../stage-2/driver/jobs.wove" (only compiler_job_budget))
	(use wove-file "../../../../../stage-2/io/process.wove" (only copy_argument run_process_capture))
	(use wove-file "../../../../../stage-2/io/process_file.wove" (only start_process_files))
	(use wove-file "../../../../../stage-2/io/capture/child.wove" (only reap_capture_child))
	(use wove-file "../../../../../stage-2/text/bytes.wove" (only same_bytes))
	(use wove-file "../../../../../stage-2/text/copy.wove" (only append_bytes))
	(use c-header "<sys/wait.h>" (only waitpid WNOHANG (type Pid)))
	(use c-header "<errno.h>" (only errno ECHILD))
	(use c-header "<unistd.h>" (only environ))

	(let program "python3")
	(let script (embed "./tool.py"))
	(let eval_flag "-c")
	(let inherited_stderr "")
	(let unrelated_file "unrelated")
	(let stdout_path "stdout-0")
	(let stderr_path "stderr-0")
	(let invalid_path ".")
	(let serial_name "serial")
	(let fail_name "failure")
	(let order_name "order")
	(let launch_name "launch")
	(let wide_name "wide-budget")

	(fn matches (params (left (shared-array u8)) (right (shared-array u8))) (returns bool)
		(body (return (call same_bytes (borrow-shared left) 0i32 (array.len left)
			(borrow-shared right) 0i32 (array.len right)))))

	(fn packed_arguments (params (mode (shared-array u8)) (tag u8)) (returns (owned-array u8))
		(body
			(let-mut packed (array.alloc u8 (i32.add (i32.add (array.len script) (array.len mode)) 7i32)))
			(let flag_end (call append_bytes (borrow-shared eval_flag) (borrow-mut packed) 0i32))
			(let script_end (call append_bytes (borrow-shared script) (borrow-mut packed) (i32.inc flag_end)))
			(let mode_end (call append_bytes (borrow-shared mode) (borrow-mut packed) (i32.inc script_end)))
			(array.store packed (i32.inc mode_end) tag)
			(return (move packed))))

	(fn output_name (params (pattern (shared-array u8)) (digit u8)) (returns (owned-array u8))
		(body
			(let-mut result (call copy_argument (borrow-shared pattern)))
			(let last (i32.dec (array.len result)))
			(array.store result last digit)
			(return (move result))))

	(fn make_job (params (mode (shared-array u8)) (index i32) (reject bool)) (returns ObjectJob)
		(body
			(let digit (u8.from-i32 (i32.add 48i32 index)))
			(let-mut output (call output_name (borrow-shared stdout_path) digit))
			(if reject (then (set output (call copy_argument (borrow-shared invalid_path)))))
			(let environment environ)
			(return (struct.new ObjectJob
				(arguments (call packed_arguments (borrow-shared mode) digit))
				(stdout_path (move output))
				(stderr_path (call output_name (borrow-shared stderr_path) digit))
				(environment (move environment))))))

	(fn all_reaped (params) (returns bool)
		(body
			(let-mut status 0i32)
			(let pid (call waitpid (int.convert Pid -1i32) (borrow-mut status) WNOHANG))
			(return (bool.and (i32.eq (int.convert i32 pid) -1i32) (i32.eq errno ECHILD)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (borrow-shared (array.load argv 1i32)))
			(let serial (call matches (borrow-shared mode) (borrow-shared serial_name)))
			(let failure (call matches (borrow-shared mode) (borrow-shared fail_name)))
			(let order (call matches (borrow-shared mode) (borrow-shared order_name)))
			(let launch (call matches (borrow-shared mode) (borrow-shared launch_name)))
			(let wide (call matches (borrow-shared mode) (borrow-shared wide_name)))
			(let-mut budget (call compiler_job_budget (bool.not serial) 2u32 1i32))
			(if wide (then (set budget 4294967295u32)))
			(let-mut jobs (array.alloc ObjectJob 4i32))
			(for (let index) (range 0i32 4i32)
				(body (array.store jobs index (call make_job (borrow-shared mode) index (bool.and launch (i32.eq index 1i32))))))
			(let no_jobs (array.alloc ObjectJob 0i32))
			(let empty (call run_object_jobs (borrow-shared program) (borrow-shared no_jobs) 0u32))
			(if (bool.or (i32.not-eqz (struct.get empty attempted)) (i32.not-eqz (struct.get empty status)))
				(then (return 1i32)))
			(let invalid (call run_object_jobs (borrow-shared program) (borrow-shared jobs) 0u32))
			(if (i32.not-eq (struct.get invalid status) -1i32) (then (return 2i32)))
			(let sent_args (call packed_arguments (borrow-shared mode) 117u8))
			(let environment environ)
			(let sent (call start_process_files (borrow-shared program) (borrow-shared sent_args)
				(borrow-shared unrelated_file) (borrow-shared inherited_stderr) (borrow-shared environment)))
			(if (bool.not (struct.get sent ok)) (then (return 3i32)))
			(let result (call run_object_jobs (borrow-shared program) (borrow-shared jobs) budget))
			(let own_status (call reap_capture_child (struct.get sent pid)))
			(if (i32.not-eq own_status 37i32) (then (return 4i32)))
			(if (bool.not (call all_reaped)) (then (return 5i32)))
			(let stopped (bool.or (bool.or failure order) launch))
			(let expected_count (if stopped (then 2i32) (else 4i32)))
			(let expected_job (if order (then 0i32) (else (if stopped (then 1i32) (else -1i32)))))
			(let expected_status (if order (then 7i32) (else (if launch (then -1i32) (else (if failure (then 22i32) (else 0i32)))))))
			(if (bool.or (i32.not-eq (struct.get result attempted) expected_count)
				(bool.or (i32.not-eq (struct.get result failed_job) expected_job)
					(i32.not-eq (struct.get result status) expected_status)))
				(then (return 6i32)))
			(let statuses (borrow-shared (struct.get result statuses)))
			(let second (if launch (then -1i32) (else (if (bool.or failure order) (then 22i32) (else 0i32)))))
			(if (bool.or (i32.not-eq (array.load statuses 0i32) (if order (then 7i32) (else 0i32)))
				(i32.not-eq (array.load statuses 1i32) second))
				(then (return 7i32)))
			(let check_args (call packed_arguments (borrow-shared mode) 97u8))
			(let-mut quiet (array.alloc u8 0i32))
			(let audit (call run_process_capture (borrow-shared program) (borrow-shared check_args) (borrow-mut quiet)))
			(if (i32.not-eqz (struct.get audit status)) (then (return 8i32)))
			(return 42i32))))
