{
    "streams": {
        "stdout": {"filename": "stdout-{job}", "prefix": "stdout-{job}:", "fill": "x", "length": 2097152},
        "stderr": {"filename": "stderr-{job}", "prefix": "stderr-{job}:", "fill": "y", "length": 2097152}
    },
    "unrelated_status": 37,
    "cases": {
        "serial": {
            "expected": {"started": [0, 1, 2, 3], "peak": 1, "ordered": true}
        },
        "parallel": {
            "jobs": {
                "0": {"wait": [["started", 2]]},
                "1": {"wait": [["started", 0]]}
            },
            "expected": {"started": [0, 1, 2, 3], "peak": 2}
        },
        "failure": {
            "jobs": {
                "0": {"wait": [["reaped", 1]]},
                "1": {"wait": [["started", 0]], "status": 22}
            },
            "expected": {"started": [0, 1], "peak": 2}
        },
        "order": {
            "jobs": {
                "0": {"wait": [["reaped", 1]], "status": 7},
                "1": {"wait": [["started", 0]], "status": 22}
            },
            "expected": {"started": [0, 1], "peak": 2}
        },
        "launch": {
            "expected": {"started": [0], "peak": 1}
        },
        "wide-budget": {
            "expected": {"started": [0, 1, 2, 3]}
        }
    }
}
