(module integer_macro_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./native.h"
		(only (type ULongLong) (as FIXTURE_SUFFIX paste) (as FIXTURE_SMALL small)
			(as FIXTURE_MIX mixed) (as FIXTURE_REPEAT repeat) (as FIXTURE_BOUNDED bounded)))

	(fn next_byte (params (data (mut-array u8))) (returns u8)
		(body
			(let count (u8:inc (array:load data 0i32)))
			(array:store data 0i32 count)
			(return count)))

	(fn matches (params (actual ULongLong) (value u64)) (returns bool)
		(body (return (u64:eq (int:convert u64 actual) value))))

	(fn main
		(:expect (tests "stage-2/cli/native/macro-integer/cases.tsv") (issues "gh:wove-lang/wove:718"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call matches (call paste 18_446_744_073_709_551_615u64) 18446744073709551615u64))
				(then (return 1i32)))
			(if (bool:not (call matches (call paste (u64 00042)) 42u64))
				(then (return 2i32)))
			(if (bool:not (call matches (call paste 0XaB_CDu64) 43981u64))
				(then (return 3i32)))
			(if (bool:not (call matches (call paste 0b10_1010u64) 42u64))
				(then (return 4i32)))
			(if (bool:not (call matches (call paste (u64 -0)) 0u64))
				(then (return 5i32)))
			(if (i32:not-eq (call small 255u8) 255i32)
				(then (return 6i32)))
			(let-mut data (array:alloc u8 1i32))
			(array:store data 0i32 0u8)
			(let joined (call mixed 0x10u64 (call next_byte (borrow-mut data))
				(call next_byte (borrow-mut data))))
			(if (bool:not (call matches joined 18u64))
				(then (return 7i32)))
			(let repeated (call repeat (call next_byte (borrow-mut data)) (call next_byte (borrow-mut data))))
			(if (i32:not-eq repeated 10i32)
				(then (return 8i32)))
			(if (i32:not-eq (call bounded (borrow-mut data) 1i32) 4i32)
				(then (return 9i32)))
			(return 42i32))))
