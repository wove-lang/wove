(module integer_macro_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./native.h"
		(type ULongLong (c-type "unsigned long long"))
		(fn FIXTURE_SUFFIX (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u64)) (returns ULongLong))
		(fn FIXTURE_SIGNED (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i32)) (returns i32))
		(fn FIXTURE_SMALL (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u8)) (returns i32))
		(fn FIXTURE_MIX (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u64) (first u8) (ignored u8)) (returns ULongLong))
		(fn FIXTURE_REPEAT (:pragma (c_macro))
			(params (first u8) (second u8)) (returns i32))
		(fn FIXTURE_BOUNDED (:pragma (c_macro) (c_bytes data count))
			(params (data (mut-array u8)) (count (:pragma (c_macro_integer_literal)) i32)) (returns i32))
		(fn FIXTURE_WRONG_RESULT (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i32)) (returns i32))
		(fn fixture_non_macro
			(params (value (:pragma (c_macro_integer_literal)) i32)) (returns i32))
		(fn FIXTURE_BAD_OPERAND_TYPE (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) bool)) (returns i32))
		(fn FIXTURE_MARKER_OPERAND (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal unexpected)) u8)) (returns i32))
		(fn FIXTURE_DUPLICATE_MARKER (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal) (c_macro_integer_literal)) u8)) (returns i32))))
