(module integer_macro_stdint
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdint.h>"
		(only INT8_C UINT8_C INT16_C UINT16_C INT32_C UINT32_C INT64_C UINT64_C INTMAX_C UINTMAX_C))
	(bridge c-header "<stdint.h>"
		(:pragma (bridge_replace))
		(type Int64 (c-type "int64_t"))
		(type UInt64 (c-type "uint64_t"))
		(type IntMax (c-type "intmax_t"))
		(type UIntMax (c-type "uintmax_t"))
		(fn INT8_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i8)) (returns i32))
		(fn UINT8_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u8)) (returns i32))
		(fn INT16_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i16)) (returns i32))
		(fn UINT16_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u16)) (returns i32))
		(fn INT32_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i32)) (returns i32))
		(fn UINT32_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u32)) (returns u32))
		(fn INT64_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i64)) (returns Int64))
		(fn UINT64_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u64)) (returns UInt64))
		(fn INTMAX_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) i64)) (returns IntMax))
		(fn UINTMAX_C (:pragma (c_macro))
			(params (value (:pragma (c_macro_integer_literal)) u64)) (returns UIntMax)))

	(fn main
		(:expect (tests "stage-2/cli/native/macro-integer/cases.tsv") (issues "gh:wove-lang/wove:718"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (bool.and (i32.eq (call INT8_C 0i8) 0i32)
					(i32.eq (call INT8_C 127i8) 127i32)))
				(then (return 1i32)))
			(if (bool.not (bool.and (i32.eq (call UINT8_C 0u8) 0i32)
					(i32.eq (call UINT8_C 255u8) 255i32)))
				(then (return 2i32)))
			(if (bool.not (bool.and (i32.eq (call INT16_C 0i16) 0i32)
					(i32.eq (call INT16_C 32767i16) 32767i32)))
				(then (return 3i32)))
			(if (bool.not (bool.and (i32.eq (call UINT16_C 0u16) 0i32)
					(i32.eq (call UINT16_C 65535u16) 65535i32)))
				(then (return 4i32)))
			(if (bool.not (bool.and (i32.eq (call INT32_C 0i32) 0i32)
					(i32.eq (call INT32_C 2147483647i32) 2147483647i32)))
				(then (return 5i32)))
			(if (bool.not (bool.and (u32.eq (call UINT32_C 0u32) 0u32)
					(u32.eq (call UINT32_C 4294967295u32) 4294967295u32)))
				(then (return 6i32)))
			(if (bool.not (bool.and (i64.eq (int.convert i64 (call INT64_C 0i64)) 0i64)
					(i64.eq (int.convert i64 (call INT64_C 9223372036854775807i64)) 9223372036854775807i64)))
				(then (return 7i32)))
			(if (bool.not (bool.and (u64.eq (int.convert u64 (call UINT64_C 0u64)) 0u64)
					(u64.eq (int.convert u64 (call UINT64_C 18446744073709551615u64)) 18446744073709551615u64)))
				(then (return 8i32)))
			(if (bool.not (bool.and (i64.eq (int.convert i64 (call INTMAX_C 0i64)) 0i64)
					(i64.eq (int.convert i64 (call INTMAX_C 9223372036854775807i64)) 9223372036854775807i64)))
				(then (return 9i32)))
			(if (bool.not (bool.and (u64.eq (int.convert u64 (call UINTMAX_C 0u64)) 0u64)
					(u64.eq (int.convert u64 (call UINTMAX_C 18446744073709551615u64)) 18446744073709551615u64)))
				(then (return 10i32)))
			(return 42i32))))
