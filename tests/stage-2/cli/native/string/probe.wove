(module checked_string_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only (type Size) strlen strcmp strncmp strcoll strerror))
	(use c-header "<errno.h>" (only EINVAL ENOENT))
	(use c-header "./oracle.h" (only fixture_c_collation fixture_save_error fixture_matches_saved fixture_matches_error))
	(bridge c-header "./oracle.h"
		(fn fixture_c_collation (params) (returns bool))
		(fn fixture_save_error (params (error i32)) (returns bool))
		(fn fixture_matches_saved (:pragma (c_cstr text))
			(params (text (shared-array u8))) (returns bool))
		(fn fixture_matches_error (:pragma (c_cstr text))
			(params (text (shared-array u8)) (error i32)) (returns bool)))

	(let empty "")
	(let prefix "ab")
	(let longer "abc")
	(let other "ac")
	(let utf8 "\u00e9")

	(fn check_text (params) (returns i32)
		(body
			(let zero (int:convert Size 0i32))
			(let two (int:convert Size 2i32))
			(let three (int:convert Size 3i32))
			(if (bool:not (int:eq Size (call strlen (borrow-shared empty)) zero)) (then (return 1i32)))
			(if (bool:not (int:eq Size (call strlen (borrow-shared longer)) three)) (then (return 2i32)))
			(if (bool:not (int:eq Size (call strlen (borrow-shared utf8)) two)) (then (return 3i32)))

			(if (i32:not-eqz (call strcmp (borrow-shared empty) (borrow-shared empty))) (then (return 4i32)))
			(if (i32:not-ltz (call strcmp (borrow-shared empty) (borrow-shared longer))) (then (return 5i32)))
			(if (i32:not-gtz (call strcmp (borrow-shared longer) (borrow-shared empty))) (then (return 6i32)))

			(if (i32:not-eqz (call strncmp (borrow-shared empty) (borrow-shared longer) zero)) (then (return 7i32)))
			(if (i32:not-eqz (call strncmp (borrow-shared prefix) (borrow-shared longer) two)) (then (return 8i32)))
			(if (i32:not-ltz (call strncmp (borrow-shared prefix) (borrow-shared longer) three)) (then (return 9i32)))
			(if (i32:not-gtz (call strncmp (borrow-shared longer) (borrow-shared prefix) three)) (then (return 10i32)))

			(if (bool:not (call fixture_c_collation)) (then (return 11i32)))
			(if (i32:not-eqz (call strcoll (borrow-shared empty) (borrow-shared empty))) (then (return 12i32)))
			(if (i32:not-ltz (call strcoll (borrow-shared prefix) (borrow-shared other))) (then (return 13i32)))
			(if (i32:not-gtz (call strcoll (borrow-shared other) (borrow-shared prefix))) (then (return 14i32)))
			(return 0i32)))

	(fn check_snapshot (params) (returns i32)
		(body
			(if (bool:not (call fixture_save_error EINVAL)) (then (return 20i32)))
			(let original (call strerror EINVAL))
			(if (owner:is-null original) (then (return 21i32)))
			(let recent (call strerror ENOENT))
			(if (owner:is-null recent) (then (return 22i32)))
			(let before (move (optional:unwrap original)))
			(let after (move (optional:unwrap recent)))
			(if (bool:not (call fixture_matches_error (borrow-shared after) ENOENT)) (then (return 23i32)))
			(if (call fixture_matches_saved (borrow-shared after)) (then (return 24i32)))
			(if (bool:not (call fixture_matches_saved (borrow-shared before))) (then (return 25i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let status (call check_text))
			(if (i32:not-eqz status) (then (return status)))
			(return (call check_snapshot)))))
