(module project_string
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(type Size (c-type "size_t"))

		(fn strlen
			(:pragma (c_cstr text))
			(params (text (shared-array u8)))
			(returns Size))

		(fn strcmp
			(:pragma (c_cstr left right))
			(params (left (shared-array u8)) (right (shared-array u8)))
			(returns i32))

		(fn strncmp
			(:pragma (c_cstr left right))
			(params (left (shared-array u8)) (right (shared-array u8)) (count Size))
			(returns i32))

		(fn strcoll
			(:pragma (c_cstr left right))
			(params (left (shared-array u8)) (right (shared-array u8)))
			(returns i32))

		(fn strerror
			(:pragma (c_snapshot cstr))
			(params (error i32))
			(returns (optional (owned-array u8))))))
