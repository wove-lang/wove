(module signal_scalar_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER"
		(only (type Atomic) raise
			SIGABRT SIGFPE SIGILL SIGINT SIGSEGV SIGTERM SIGHUP
			SIGQUIT SIGTRAP SIGBUS SIGKILL SIGUSR1 SIGUSR2 SIGPIPE
			SIGALRM SIGCHLD SIGCONT SIGSTOP SIGTSTP SIGTTIN SIGTTOU
			SIGURG SIGXCPU SIGXFSZ SIGVTALRM SIGPROF))
	(use c-header "./oracle.h" (only fixture_signals fixture_catch fixture_seen))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type Atomic)))
		(fn fixture_signals
			(params
				(sigabrt i32) (sigfpe i32) (sigill i32) (sigint i32) (sigsegv i32)
				(sigterm i32) (sighup i32) (sigquit i32) (sigtrap i32) (sigbus i32)
				(sigkill i32) (sigusr1 i32) (sigusr2 i32) (sigpipe i32) (sigalrm i32)
				(sigchld i32) (sigcont i32) (sigstop i32) (sigtstp i32) (sigttin i32)
				(sigttou i32) (sigurg i32) (sigxcpu i32) (sigxfsz i32) (sigvtalrm i32)
				(sigprof i32))
			(returns bool))
		(fn fixture_catch (params (signum i32)) (returns bool))
		(fn fixture_seen (params) (returns Atomic)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call fixture_signals
					SIGABRT SIGFPE SIGILL SIGINT SIGSEGV SIGTERM SIGHUP
					SIGQUIT SIGTRAP SIGBUS SIGKILL SIGUSR1 SIGUSR2 SIGPIPE
					SIGALRM SIGCHLD SIGCONT SIGSTOP SIGTSTP SIGTTIN SIGTTOU
					SIGURG SIGXCPU SIGXFSZ SIGVTALRM SIGPROF))
				(then (return 1i32)))
			(if (bool:not (call fixture_catch SIGTERM)) (then (return 2i32)))
			(if (i32:not-eqz (call raise SIGTERM)) (then (return 3i32)))
			(if (bool:not (int:eq Atomic (call fixture_seen) (int:convert Atomic SIGTERM)))
				(then (return 4i32)))
			(return 42i32))))
