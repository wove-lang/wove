(module signal_process_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "<signal.h>" (only (type Pid) SIGUSR1 SIGUSR2 kill killpg))
	(use c-header "./posix.h" (only fixture_isolate fixture_received))
	(bridge c-header "./posix.h"
		(use c-header "<signal.h>" (only (type Pid)))
		(fn fixture_isolate (params (signum i32)) (returns Pid))
		(fn fixture_received (params (signum i32)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let process (call fixture_isolate SIGUSR1))
			(if (i32:not-gtz (int:convert i32 process)) (then (return 1i32)))
			(if (i32:not-eqz (call kill process SIGUSR1)) (then (return 2i32)))
			(if (bool:not (call fixture_received SIGUSR1)) (then (return 3i32)))
			(let group (call fixture_isolate SIGUSR2))
			(if (i32:not-gtz (int:convert i32 group)) (then (return 4i32)))
			(if (i32:not-eqz (call killpg group SIGUSR2)) (then (return 5i32)))
			(if (bool:not (call fixture_received SIGUSR2)) (then (return 6i32)))
			(return 42i32))))
