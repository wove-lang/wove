(module project_posix_signal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<signal.h>"
		(:pragma (bridge_replace))
		(type Pid (:pragma (cfg (os "macos"))) (c-type "pid_t"))
		(type Pid (:pragma (cfg (os "linux"))) (c-type "__pid_t"))
		(fn kill (:pragma (c_optional)) (params (pid Pid) (signal i32)) (returns i32))
		(fn killpg (:pragma (c_optional)) (params (group Pid) (signal i32)) (returns i32))
		(const SIGUSR1 i32)
		(const SIGUSR2 i32)))
