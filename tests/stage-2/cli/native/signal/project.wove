(module project_signal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(type Atomic (c-type "sig_atomic_t"))
		(fn raise (params (signal i32)) (returns i32))
		(const SIGABRT i32)
		(const SIGFPE i32)
		(const SIGILL i32)
		(const SIGINT i32)
		(const SIGSEGV i32)
		(const SIGTERM i32)
		(const SIGHUP i32)
		(const SIGQUIT i32)
		(const SIGTRAP i32)
		(const SIGBUS i32)
		(const SIGKILL i32)
		(const SIGUSR1 i32)
		(const SIGUSR2 i32)
		(const SIGPIPE i32)
		(const SIGALRM i32)
		(const SIGCHLD i32)
		(const SIGCONT i32)
		(const SIGSTOP i32)
		(const SIGTSTP i32)
		(const SIGTTIN i32)
		(const SIGTTOU i32)
		(const SIGURG i32)
		(const SIGXCPU i32)
		(const SIGXFSZ i32)
		(const SIGVTALRM i32)
		(const SIGPROF i32)

		(const SIGPOLL (:pragma (c_optional)) i32)
		(const SIGEMT (:pragma (c_optional)) i32)
		(const SIGINFO (:pragma (c_optional)) i32)
		(const SIGWINCH (:pragma (c_optional)) i32)
		(const SIG_BLOCK (:pragma (c_optional)) i32)
		(const SIG_UNBLOCK (:pragma (c_optional)) i32)
		(const SIG_SETMASK (:pragma (c_optional)) i32)
		(const CLD_EXITED (:pragma (c_optional)) i32)
		(const CLD_KILLED (:pragma (c_optional)) i32)
		(const CLD_DUMPED (:pragma (c_optional)) i32)
		(const CLD_TRAPPED (:pragma (c_optional)) i32)
		(const CLD_STOPPED (:pragma (c_optional)) i32)
		(const CLD_CONTINUED (:pragma (c_optional)) i32)))
