(module signal_optional_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "TEST_HEADER" (only TEST_MEMBER))
	(use c-header "./oracle.h" (only fixture_signal_member))
	(bridge c-header "./oracle.h"
		(fn fixture_signal_member (params) (returns i32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq TEST_MEMBER (call fixture_signal_member)) (then (return 1i32)))
			(return 42i32))))
