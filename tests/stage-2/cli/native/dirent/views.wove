(module borrowed_directory_entries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir readdir_entry entry_name (value DT_WHT)))
	(use (:pragma (cfg (os "linux"))) c-header "<dirent.h>" (only readdir64_entry entry64_name))
	(use wove-file "./equal.wove" (only equal_bytes))

	(let location ".")

	(fn check_platform (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(if (owner:is-null directory) (then (return 1i32)))
			(let result (call readdir_entry (borrow-mut directory)))
			(if (optional:is-none result) (then (return 2i32)))
			(let entry (optional:unwrap result))
			(if (u64:eqz (int:convert u64 (struct:get entry d_ino))) (then (return 3i32)))
			(if (u16:eqz (struct:get entry d_reclen)) (then (return 4i32)))
			(if (i32:gt (int:convert i32 (struct:get entry d_type)) DT_WHT) (then (return 5i32)))
			(let copied (call entry_name (borrow-shared entry)))
			(if (owner:is-null copied) (then (return 6i32)))
			(let name (move (optional:unwrap copied)))
			(if (i32:not-eq (int:convert i32 (struct:get entry d_namlen)) (array:len name))
				(then (return 7i32)))

			(let-mut second (call opendir (borrow-shared location)))
			(if (owner:is-null second) (then (return 8i32)))
			(let again (call readdir_entry (borrow-mut second)))
			(if (optional:is-none again) (then (return 9i32)))
			(let next (optional:unwrap again))
			(if (u64:not-eq (struct:get entry d_seekoff) (struct:get next d_seekoff))
				(then (return 10i32)))
			(let another (call entry_name (borrow-shared next)))
			(if (owner:is-null another) (then (return 11i32)))
			(let other_name (move (optional:unwrap another)))
			(if (bool:not (call equal_bytes (borrow-shared name) (borrow-shared other_name)))
				(then (return 12i32)))
			(return 42i32)))

	(fn check_platform (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(if (owner:is-null directory) (then (return 1i32)))
			(let result (call readdir_entry (borrow-mut directory)))
			(if (optional:is-none result) (then (return 2i32)))
			(let entry (optional:unwrap result))
			(let inode (int:convert u64 (struct:get entry d_ino)))
			(let cookie (int:convert i64 (struct:get entry d_off)))
			(let length (struct:get entry d_reclen))
			(let kind (struct:get entry d_type))
			(if (bool:or (u64:eqz inode) (u16:eqz length)) (then (return 3i32)))
			(if (i32:gt (int:convert i32 kind) DT_WHT) (then (return 4i32)))
			(let copied (call entry_name (borrow-shared entry)))
			(if (owner:is-null copied) (then (return 5i32)))
			(let name (move (optional:unwrap copied)))

			(let-mut second (call opendir (borrow-shared location)))
			(if (owner:is-null second) (then (return 6i32)))
			(let again (call readdir64_entry (borrow-mut second)))
			(if (optional:is-none again) (then (return 7i32)))
			(let next (optional:unwrap again))
			(if (u64:not-eq inode (int:convert u64 (struct:get next d_ino))) (then (return 8i32)))
			(if (i64:not-eq cookie (int:convert i64 (struct:get next d_off))) (then (return 9i32)))
			(if (u16:not-eq length (struct:get next d_reclen)) (then (return 10i32)))
			(if (u8:not-eq kind (struct:get next d_type)) (then (return 11i32)))
			(let another (call entry64_name (borrow-shared next)))
			(if (owner:is-null another) (then (return 12i32)))
			(let other_name (move (optional:unwrap another)))
			(if (bool:not (call equal_bytes (borrow-shared name) (borrow-shared other_name)))
				(then (return 13i32)))
			(return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:531"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_platform)))))
