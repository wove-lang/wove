(module directory_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir readdir closedir))
	(use c-header "<errno.h>" (only (value errno)))
	(use wove-file "./equal.wove" (only equal_bytes))

	(let location "entries")
	(let alpha "alpha")
	(let bravo "bravo-long")

	(fn name_index
		(params (name (shared-array u8))) (returns i32)
		(body
			(if (call equal_bytes (borrow-shared (local name)) (borrow-shared (local alpha)))
				(then (return 0i32)))
			(if (call equal_bytes (borrow-shared (local name)) (borrow-shared (local bravo)))
				(then (return 1i32)))
			(return -1i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:379"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared (local location))))
			(if (owner.is-null (local directory)) (then (return 1i32)))
			(let-mut names (array.alloc (owned-array u8) 2i32))
			(let-mut count 0i32)
			(while (bool true)
				(body
					(set (local errno) 0i32)
					(let entry (call readdir (borrow-mut (local directory))))
					(if (owner.is-null (local entry))
						(then
							(if (bool.not (i32.eq (local errno) 0i32)) (then (return 2i32)))
							(break)))
					(let name (move (optional.unwrap (local entry))))
					(let index (call name_index (borrow-shared (local name))))
					(if (i32.lt (local index) 0i32) (then (continue)))
					(array.store (local names) (local index) (move (local name)))
					(set (local count) (i32.add (local count) 1i32))))
			(if (bool.not (i32.eq (local count) 2i32)) (then (return 3i32)))

			(if (bool.not (i32.eq (call closedir (move (local directory))) 0i32)) (then (return 4i32)))
			(let-mut again (call opendir (borrow-shared (local location))))
			(if (owner.is-null (local again)) (then (return 5i32)))
			(let later (call readdir (borrow-mut (local again))))
			(if (owner.is-null (local later)) (then (return 6i32)))
			(if (bool.not (i32.eq (call closedir (move (local again))) 0i32)) (then (return 7i32)))

			(if (bool.not (call equal_bytes (borrow-shared (array.load (local names) 0i32)) (borrow-shared (local alpha))))
				(then (return 8i32)))
			(if (bool.not (call equal_bytes (borrow-shared (array.load (local names) 1i32)) (borrow-shared (local bravo))))
				(then (return 9i32)))
			(return 42i32)))
)
