(module directory_descriptor_transfer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (all (os "macos") (os_min 260400))))
		c-header "<dirent.h>" (only opendir dirfd fdclosedir fdopendir readdir closedir))
	(use (:pragma (cfg (all (os "macos") (os_min 260400))))
		c-header "<unistd.h>" (only close))

	(let location ".")

	(fn check_transfer
		(:pragma (cfg (all (os "macos") (os_min 260400))))
		(params) (returns i32)
		(body
			(let directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return 1i32)))
			(let original (call dirfd (borrow-shared directory)))
			(let descriptor (call fdclosedir (move directory)))
			(if (i32.ltz descriptor) (then (return 2i32)))
			(if (i32.not-eq descriptor original)
				(then
					(let closed (call close descriptor))
					(return 3i32)))
			(let-mut adopted (call fdopendir descriptor))
			(if (owner.is-null adopted)
				(then
					(let closed (call close descriptor))
					(return 4i32)))
			(if (i32.not-eq (call dirfd (borrow-shared adopted)) descriptor)
				(then (return 5i32)))
			(let name (call readdir (borrow-mut adopted)))
			(if (owner.is-null name) (then (return 6i32)))
			(if (i32.not-eqz (call closedir (move adopted))) (then (return 7i32)))
			(return 42i32)))

	(fn check_transfer
		(:pragma (cfg (not (all (os "macos") (os_min 260400)))))
		(params) (returns i32)
		(body (return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:535"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_transfer)))))
