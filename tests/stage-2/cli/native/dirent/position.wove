(module directory_positions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir fdopendir dirfd closedir telldir seekdir rewinddir readdir
		(value DT_UNKNOWN) (value DT_FIFO) (value DT_CHR) (value DT_DIR) (value DT_BLK)
		(value DT_REG) (value DT_LNK) (value DT_SOCK) (value DT_WHT) (value MAXNAMLEN) IFTODT DTTOIF))
	(use (:pragma (cfg (os "macos"))) c-header "<dirent.h>" (only (value DIRBLKSIZ)))
	(use c-header "<errno.h>" (only (value errno) (value EBADF)))
	(use c-header "<unistd.h>" (only dup close))
	(use wove-file "./equal.wove" (only equal_bytes))

	(let location "entries")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn mode_matches (params (entry_type i32) (mode i32)) (returns bool)
		(body (return (bool.and
			(i32.eq (call DTTOIF entry_type) mode)
			(i32.eq (call IFTODT (i32.or mode 511i32)) entry_type)))))

	(fn transfer_duplicate (params (descriptor i32)) (returns bool)
		(body
			(let duplicate (call dup descriptor))
			(if (i32.lt duplicate 0i32) (then (return (bool false))))
			(let directory (call fdopendir duplicate))
			(if (owner.is-null directory)
				(then
					(let failure_close (call close duplicate))
					(return (bool false))))
			(let stream_descriptor (call dirfd (borrow-shared directory)))
			(let closed (call closedir (move directory)))
			(if (bool.or (i32.not-eq stream_descriptor duplicate)
				(i32.not-eq closed 0i32))
				(then (return (bool false))))
			(set errno 0i32)
			(let second_close (call close duplicate))
			(return (bool.and (i32.eq second_close -1i32) (i32.eq errno EBADF)))))

	(fn valid_limits (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body (return (bool.and (i32.eq MAXNAMLEN 255i32) (i32.eq DIRBLKSIZ 1024i32)))))

	(fn valid_limits (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body (return (i32.eq MAXNAMLEN 255i32))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (bool.not (call mode_matches DT_UNKNOWN 0i32)) (then (return 1i32)))
			(if (bool.not (call mode_matches DT_FIFO 4096i32)) (then (return 2i32)))
			(if (bool.not (call mode_matches DT_CHR 8192i32)) (then (return 3i32)))
			(if (bool.not (call mode_matches DT_DIR 16384i32)) (then (return 4i32)))
			(if (bool.not (call mode_matches DT_BLK 24576i32)) (then (return 5i32)))
			(if (bool.not (call mode_matches DT_REG 32768i32)) (then (return 6i32)))
			(if (bool.not (call mode_matches DT_LNK 40960i32)) (then (return 7i32)))
			(if (bool.not (call mode_matches DT_SOCK 49152i32)) (then (return 8i32)))
			(if (bool.not (call mode_matches DT_WHT 57344i32)) (then (return 9i32)))

			(let-mut directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return 10i32)))

			(let first (call readdir (borrow-mut directory)))
			(if (owner.is-null first) (then (return 11i32)))
			(let position (call telldir (borrow-shared directory)))
			(let second (call readdir (borrow-mut directory)))
			(if (owner.is-null second) (then (return 12i32)))
			(call seekdir (borrow-mut directory) position)
			(let sought (call readdir (borrow-mut directory)))
			(if (owner.is-null sought) (then (return 13i32)))
			(let second_name (move (optional.unwrap second)))
			(let sought_name (move (optional.unwrap sought)))
			(if (bool.not (call equal_bytes (borrow-shared second_name) (borrow-shared sought_name)))
				(then (return 14i32)))

			(call rewinddir (borrow-mut directory))
			(let rewound (call readdir (borrow-mut directory)))
			(if (owner.is-null rewound) (then (return 15i32)))
			(let first_name (move (optional.unwrap first)))
			(let rewound_name (move (optional.unwrap rewound)))
			(if (bool.not (call equal_bytes (borrow-shared first_name) (borrow-shared rewound_name)))
				(then (return 16i32)))

			(let descriptor (call dirfd (borrow-shared directory)))
			(if (bool.not (call transfer_duplicate descriptor)) (then (return 17i32)))
			(if (bool.not (call valid_limits)) (then (return 18i32)))
			(return 42i32))))
