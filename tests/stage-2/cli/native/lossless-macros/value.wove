(module lossless_macro_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only
		(value (as WOVE_SAMPLE sample))
		(value (as WOVE_SAMPLE sample_again)) wove_ordered_samples))

	(bridge c-header "./native.h"
		(let WOVE_SAMPLE (:pragma (c_macro_lossless)) i64)
		(fn wove_ordered_samples (params (first i64) (second i64)) (returns i32)))

	(fn main (params (arguments (shared-array (shared-array u8)))) (returns i32)
		(body (return (call wove_ordered_samples sample sample_again)))))
