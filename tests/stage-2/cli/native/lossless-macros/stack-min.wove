(module glibc_stack_min
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<limits.h>" (only (value (as PTHREAD_STACK_MIN stack_min))))
	(use c-header "./stack-min.h" (only wove_stack_min_c))
	(bridge c-header "./stack-min.h"
		(fn wove_stack_min_c (params) (returns i64)))

	(fn main (params (arguments (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.and (i64.gtz stack_min) (i64.eq stack_min (call wove_stack_min_c)))
				(then (return 42i32)))
			(return 1i32))))
