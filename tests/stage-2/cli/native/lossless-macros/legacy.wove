(module legacy_macro_contracts
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value WOVE_EXACT) (value WOVE_CONSTANT)))
	(bridge c-header "./native.h"
		(let WOVE_EXACT (:pragma (c_macro)) i32)
		(const WOVE_CONSTANT i32))

	(fn main (params (arguments (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:eq WOVE_EXACT WOVE_CONSTANT) (then (return WOVE_CONSTANT)))
			(return 1i32))))
