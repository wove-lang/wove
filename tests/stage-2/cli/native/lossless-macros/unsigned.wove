(module lossless_macro_unsigned
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value WOVE_BYTE)))
	(bridge c-header "./native.h"
		(let WOVE_BYTE (:pragma (c_macro_lossless)) u8))

	(fn main (params (arguments (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32.from-u8 WOVE_BYTE)))))
