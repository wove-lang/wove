(module invalid_lossless_macro_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only (value WOVE_SAMPLE)))
	(bridge c-header "./native.h"
		(let WOVE_SAMPLE (:pragma (c_macro_lossless)) f32))

	(fn main (params (arguments (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
