(module bundled_dynamic_loader
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dlfcn.h>" (only dlopen dlopen_self dlclose dlerror
		(value RTLD_LAZY) (value RTLD_NOW) (value RTLD_LOCAL) (value RTLD_GLOBAL)
		(value RTLD_NOLOAD) (value RTLD_NODELETE)))
	(use (:pragma (cfg (os "macos"))) c-header "<dlfcn.h>" (only dlopen_preflight (value RTLD_FIRST)))
	(use (:pragma (cfg (os "linux"))) c-header "<dlfcn.h>" (only dlmopen (type LoaderNamespace)
		(value LM_ID_BASE) (value LM_ID_NEWLM) (value RTLD_BINDING_MASK) (value RTLD_DEEPBIND)
		(value RTLD_DI_CONFIGADDR) (value RTLD_DI_LINKMAP) (value RTLD_DI_LMID) (value RTLD_DI_MAX)
		(value RTLD_DI_ORIGIN) (value RTLD_DI_PHDR) (value RTLD_DI_PROFILENAME) (value RTLD_DI_PROFILEOUT)
		(value RTLD_DI_SERINFO) (value RTLD_DI_SERINFOSIZE) (value RTLD_DI_TLS_DATA) (value RTLD_DI_TLS_MODID)
		(value RTLD_DL_LINKMAP) (value RTLD_DL_SYMENT)
		(value DLFO_STRUCT_HAS_EH_COUNT) (value DLFO_STRUCT_HAS_EH_DBASE)))

	(let darwin_library "/usr/lib/libSystem.B.dylib")
	(let glibc_library "libc.so.6")
	(let missing "./missing-wove-loader-fixture")

	(fn open_and_close (params (path (shared-array u8)) (flags i32)) (returns bool)
		(body
			(let library (call dlopen (borrow-shared path) flags))
			(if (owner:is-null library) (then (return (bool false))))
			(return (i32:eqz (call dlclose (move library))))))

	(fn loader_status (params) (returns i32)
		(body
			(let absent (call dlopen (borrow-shared missing) (i32:or RTLD_NOW RTLD_LOCAL)))
			(if (bool:not (owner:is-null absent)) (then (return 1i32)))
			(let error (call dlerror))
			(if (owner:is-null error) (then (return 2i32)))
			(let message (move (optional:unwrap error)))
			(let cleared (call dlerror))
			(if (bool:not (owner:is-null cleared)) (then (return 3i32)))
			(if (i32:eqz (array:len message)) (then (return 4i32)))
			(let self (call dlopen_self (i32:or RTLD_NOW RTLD_GLOBAL)))
			(if (owner:is-null self) (then (return 5i32)))
			(if (i32:not-eq (call dlclose (move self)) 0i32) (then (return 6i32)))
			(return 0i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(if (bool:not (call dlopen_preflight (borrow-shared darwin_library))) (then (return 7i32)))
			(if (call dlopen_preflight (borrow-shared missing)) (then (return 8i32)))
			(let loaded (call open_and_close (borrow-shared darwin_library)
				(i32:or RTLD_NOW (i32:or RTLD_FIRST RTLD_NOLOAD))))
			(if (bool:not loaded) (then (return 9i32)))
			(let pinned (call open_and_close (borrow-shared darwin_library)
				(i32:or RTLD_LAZY RTLD_NODELETE)))
			(if (bool:not pinned) (then (return 10i32)))
			(return 42i32)))

	(fn check_linux_codes (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body
			(let requests (array:new (array i32 15)
				RTLD_DEEPBIND RTLD_DI_CONFIGADDR RTLD_DI_LINKMAP RTLD_DI_LMID
				RTLD_DI_MAX RTLD_DI_ORIGIN RTLD_DI_PHDR RTLD_DI_PROFILENAME
				RTLD_DI_PROFILEOUT RTLD_DI_SERINFO RTLD_DI_SERINFOSIZE
				RTLD_DI_TLS_DATA RTLD_DI_TLS_MODID RTLD_DL_LINKMAP RTLD_DL_SYMENT))
			(let-mut index 0i32)
			(while (i32:lt index 15i32)
				(body
					(if (i32:le (array:load requests index) 0i32)
						(then (return (bool false))))
					(set index (i32:inc index))))
			(if (i32:not-eq (i32:or DLFO_STRUCT_HAS_EH_COUNT DLFO_STRUCT_HAS_EH_DBASE) 0i32)
				(then (return (bool false))))
			(return (bool:and (i32:eq LM_ID_NEWLM -1i32)
				(i32:eq (i32:or RTLD_LAZY RTLD_NOW) RTLD_BINDING_MASK)))))

	(fn check_platform (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (bool:not (call check_linux_codes)) (then (return 7i32)))
			(let loaded (call open_and_close (borrow-shared glibc_library)
				(i32:or RTLD_NOW RTLD_NOLOAD)))
			(if (bool:not loaded) (then (return 8i32)))
			(let pinned (call open_and_close (borrow-shared glibc_library)
				(i32:or RTLD_LAZY RTLD_NODELETE)))
			(if (bool:not pinned) (then (return 9i32)))
			(let library (call dlmopen (int:convert LoaderNamespace LM_ID_BASE)
				(borrow-shared glibc_library) RTLD_NOW))
			(if (owner:is-null library) (then (return 10i32)))
			(if (i32:not-eq (call dlclose (move library)) 0i32) (then (return 11i32)))
			(return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let status (call loader_status))
			(if (i32:not-eq status 0i32) (then (return status)))
			(return (call check_platform)))))
