(module bundled_grp_gid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type (as Gid GroupId))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let id (int:convert GroupId 4000000000u32))
			(if (u32:not-eq (int:convert u32 id) 4000000000u32) (then (return 1i32)))
			(return 42i32))))
