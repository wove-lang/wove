(module bundled_grp_getgrouplist
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type Gid)))
	(use (:pragma (cfg (os "linux"))) c-header "<grp.h>" (only getgrouplist))

	(let user "root")

	(fn main (:pragma (cfg (os "linux")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let base (int:convert Gid 0u32))
			(let-mut count 0i32)
			(let-mut empty (array:alloc Gid 0i32))
			(let zero (call getgrouplist (borrow-shared user) base (borrow-mut empty) (borrow-mut count)))
			(if (bool:or (i32:not-eq zero -1i32) (i32:not-gtz count)) (then (return 1i32)))

			(let required count)
			(let guest_groups (i32:lt 1i32 (array:len args)))
			(if (bool:and guest_groups (i32:not-eq required 2i32)) (then (return 2i32)))

			(set count (i32:dec required))
			(let-mut short (array:alloc Gid count))
			(let insufficient (call getgrouplist (borrow-shared user) base (borrow-mut short) (borrow-mut count)))
			(if (bool:or (i32:not-eq insufficient -1i32) (i32:not-eq count required)) (then (return 3i32)))

			(let-mut groups (array:alloc Gid count))
			(let status (call getgrouplist (borrow-shared user) base (borrow-mut groups) (borrow-mut count)))
			(if (bool:or (i32:not-eq status required) (i32:not-eq count required)) (then (return 4i32)))
			(if (u32:not-eqz (int:convert u32 (array:load groups 0i32))) (then (return 5i32)))
			(if (bool:and guest_groups (u32:not-eq (int:convert u32 (array:load groups 1i32)) 4321u32))
				(then (return 6i32)))
			(return 42i32)))

	(fn main (:pragma (cfg (os "macos")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let base (int:convert Gid 0u32))
			(if (u32:not-eqz (int:convert u32 base)) (then (return 1i32)))
			(return 42i32))))
