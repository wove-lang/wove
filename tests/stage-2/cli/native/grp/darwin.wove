(module bundled_grp_darwin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<grp.h>"
		(only (type Gid) setgroupent group_from_gid setgrent endgrent))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only getgid))
	(use (:pragma (cfg (os "macos"))) c-header "./oracle.h"
		(only fixture_group_warm fixture_group_missing fixture_group_matches))
	(bridge c-header "./oracle.h"
		(use c-header "<grp.h>" (only (type Gid)))
		(fn fixture_group_warm (params) (returns i32))
		(fn fixture_group_missing (params) (returns Gid))
		(fn fixture_group_matches
			(:pragma (c_cstr name))
			(params (id Gid) (name (shared-array u8))) (returns i32)))

	(fn main (:pragma (cfg (os "macos")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(call setgrent)
			(if (i32:not-eq (call setgroupent 1i32) 0i32) (then (return 1i32)))
			(if (i32:eqz (call fixture_group_warm)) (then (return 2i32)))
			(if (i32:not-eq (call setgroupent 1i32) 1i32) (then (return 3i32)))
			(call endgrent)
			(if (i32:not-eq (call setgroupent 0i32) 0i32) (then (return 4i32)))
			(let real_id (int:convert Gid (call getgid)))
			(let real (call group_from_gid real_id 1i32))
			(if (owner:is-null real) (then (return 5i32)))
			(let real_name (move (optional:unwrap real)))
			(let missing_id (call fixture_group_missing))
			(let missing (call group_from_gid missing_id 1i32))
			(if (bool:not (owner:is-null missing)) (then (return 6i32)))
			(let fallback (call group_from_gid missing_id 0i32))
			(if (owner:is-null fallback) (then (return 7i32)))
			(let decimal (move (optional:unwrap fallback)))
			(if (i32:eqz (call fixture_group_matches real_id (borrow-shared real_name)))
				(then (return 8i32)))
			(if (i32:eqz (call fixture_group_matches missing_id (borrow-shared decimal)))
				(then (return 9i32)))
			(return 42i32)))

	(fn main (:pragma (cfg (os "linux")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
