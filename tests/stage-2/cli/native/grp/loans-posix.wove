(module reentrant_group_posix
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type Group) (type Size) getgrnam_r))

	(let root_group (:pragma (cfg (os "macos"))) "wheel")
	(let root_group (:pragma (cfg (not (os "macos")))) "root")

	(fn main
		(:expect (issues "gh:wove-lang/wove:665"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut entry (struct:new Group (gr_gid 0u32)))
			(let-mut buffer (array:alloc u8 8192i32))
			(let-mut status 99i32)
			(let capacity (int:convert Size 8192i32))
			(let result (call getgrnam_r (borrow-shared root_group) (borrow-mut entry)
				(borrow-mut buffer) capacity (borrow-mut status)))
			(if (bool:or (i32:not-eqz status) (optional:is-none result)) (then (return 1i32)))
			(let group (optional:unwrap result))
			(if (u32:not-eqz (struct:get group gr_gid)) (then (return 2i32)))
			(return 42i32))))
