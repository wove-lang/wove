(module bundled_grp_enumeration
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only setgrent endgrent))
	(use c-header "./oracle.h" (only fixture_group_warm))
	(bridge c-header "./oracle.h"
		(fn fixture_group_warm (params) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(call setgrent)
			(if (i32:eqz (call fixture_group_warm)) (then (return 1i32)))
			(call endgrent)
			(return 42i32))))
