(module bundled_grp_glibc
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<grp.h>"
		(only (type Gid) (type Size) (value NSS_BUFLEN_GROUP) initgroups setgroups))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only getgid))
	(use (:pragma (cfg (os "linux"))) c-header "./oracle.h"
		(only fixture_group_buffer_size fixture_group_status fixture_group_selected))
	(bridge c-header "./oracle.h"
		(use c-header "<grp.h>" (only (type Gid)))
		(fn fixture_group_buffer_size (params) (returns i32))
		(fn fixture_group_status (params (status i32)) (returns i32))
		(fn fixture_group_selected (params (id Gid)) (returns i32)))

	(let user "root")

	(fn main (:pragma (cfg (os "linux")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq NSS_BUFLEN_GROUP (call fixture_group_buffer_size))
				(then (return 1i32)))
			(let id (int:convert Gid (call getgid)))
			(let initialized (call initgroups (borrow-shared user) id))
			(if (i32:eqz (call fixture_group_status initialized)) (then (return 2i32)))
			(let-mut groups (array:alloc Gid 1i32))
			(array:set groups 0i32 id)
			(let changed (call setgroups (int:convert Size 1i32) (borrow-shared groups)))
			(if (i32:eqz (call fixture_group_status changed)) (then (return 3i32)))
			(if (i32:eqz changed)
				(then
					(if (i32:eqz (call fixture_group_selected id)) (then (return 4i32)))))
			(return 42i32)))

	(fn main (:pragma (cfg (os "macos")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
