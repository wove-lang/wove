(module bundled_grp_base
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type Group) (type Size)))
	(use c-header "./oracle.h" (only fixture_group_id))
	(bridge c-header "./oracle.h"
		(use c-header "<grp.h>" (only (type Group) (type Size)))
		(fn fixture_group_id (params (record (shared-ref Group)) (width Size)) (returns u32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let group (struct:new Group (gr_gid 4000000000u32)))
			(if (u32:not-eq (struct:get group gr_gid) 4000000000u32) (then (return 1i32)))
			(if (u32:not-eq (call fixture_group_id (borrow-shared group) (int:convert Size 8i32))
					4000000000u32)
				(then (return 2i32)))
			(return 42i32))))
