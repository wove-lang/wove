(module posix_group_lookup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<errno.h>" (only ERANGE))
	(use c-header "<grp.h>" (only (type Gid) (type Group) (type Size) getgrgid_r))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut entry (struct:new Group (gr_gid 0u32)))
			(let-mut buffer (array:alloc u8 8192i32))
			(let-mut status 99i32)
			(let capacity (int:convert Size 8192u32))
			(if (bool true)
				(then
					(let found (call getgrgid_r (int:convert u32 (int:convert Gid 0u32)) (borrow-mut entry) (borrow-mut buffer) capacity (borrow-mut status)))
					(if (bool:or (i32:not-eqz status) (optional:is-none found)) (then (return 1i32)))
					(let view (optional:unwrap found))
					(if (u32:not-eqz (struct:get view gr_gid)) (then (return 2i32)))
					(let name (struct:get view gr_name))
					(if (i32:eqz (array:len name)) (then (return 3i32)))))
			(if (bool true)
				(then
					(set status 99i32)
					(let small (call getgrgid_r (int:convert u32 (int:convert Gid 0u32)) (borrow-mut entry) (borrow-mut buffer)
						(int:convert Size 1u32) (borrow-mut status)))
					(if (bool:or (i32:not-eq status ERANGE) (bool:not (optional:is-none small)))
						(then (return 5i32)))))
			(set status 99i32)
			(let missing (call getgrgid_r (int:convert u32 (int:convert Gid 4294967111u32)) (borrow-mut entry) (borrow-mut buffer) capacity (borrow-mut status)))
			(if (bool:or (i32:not-eqz status) (bool:not (optional:is-none missing))) (then (return 4i32)))
			(return 42i32))))
