(module bundled_grp_path
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type Size)))
	(use (:pragma (cfg (os "macos"))) c-header "<grp.h>" (only (value (as _PATH_GROUP group_path))))

	(let expected (:pragma (cfg (os "macos"))) "/etc/group")

	(fn main (:pragma (cfg (os "macos")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let length (int:convert Size (array:len group_path)))
			(if (i32:not-eq (int:convert i32 length) (array:len expected)) (then (return 1i32)))
			(for (let index byte) (borrow-shared group_path)
				(body
					(if (u8:not-eq byte (array:get expected index)) (then (return 2i32)))))
			(return 42i32)))

	(fn main (:pragma (cfg (os "linux")))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let zero (int:convert Size 0u32))
			(if (u32:not-eqz (int:convert u32 zero)) (then (return 1i32)))
			(return 42i32))))
