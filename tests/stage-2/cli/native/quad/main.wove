	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./quad.h" (only (type QuadPacket) quad_twice quad_store quad_negative_zero))

	(bridge c-header "./quad.h"
		(struct QuadPacket (c-type "QuadPacket") (fields (marker u8) (value f128)))
		(fn quad_twice (:pragma (c_optional)) (params (value f128)) (returns f128))
		(fn quad_store (params (out (mut-ref QuadPacket)) (value f128)) (returns i32))
		(fn quad_negative_zero (params (value f128)) (returns i32)))

	(struct Quad (fields (value f128)))
	(let next 1.0000000000000000000000000000000001925929944387235853055977942584927318538101648215388195239938795566558837890625f128)

	(fn preserve (params (value f128)) (returns f128)
		(body (return (local value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (struct.new Quad (value (call preserve (local next)))))
			(if (f128.not-eq (f128.add (f128 1) 1.925929944387235853055977942584927318538101648215388195239938795566558837890625E-34f128) (struct.get (local first) value)) (then (return 1i32)))
			(if (f128.le (local next) 1f128) (then (return 2i32)))
			(if (i32.not-eq (call quad_negative_zero (f128 -0)) 1i32) (then (return 3i32)))
			(if (f128.not-eq (f128.div (f128.mul (f128.sub 7f128 1f128) 2f128) 4f128) 3f128)
				(then (return 4i32)))
			(if (f128.ge (f128.neg 1f128) 0f128) (then (return 5i32)))
			(if (i64.not-eq (i64.from-f128 -9223372036854775808.5f128) -9223372036854775808i64)
				(then (return 6i32)))
			(if (u64.not-eq (u64.from-f128 (f128.from-u64 18446744073709551615u64)) 18446744073709551615u64)
				(then (return 7i32)))
			(if (u8.not-eq (u8.from-f128 -0.875f128) 0u8) (then (return 8i32)))
			(if (u32.not-eq (f32.to-bits (f32.from-f128 1.0000000596046447753906250000000001925929944387235853055977942584927318538101648215388195239938795566558837890625f128)) 0x3f800001u32)
				(then (return 9i32)))
			(if (u64.not-eq (f64.to-bits (f64.from-f128 1.0000000000000001110223024625156542349561612478056165555977942584927318538101648215388195239938795566558837890625f128)) 0x3ff0000000000001u64)
				(then (return 10i32)))
			(if (f128.not-eq (f128.from-f32 -2.5f32) (f128 -2.5)) (then (return 11i32)))
			(let infinity (f128.from-f64 (f64.from-bits 0x7ff0000000000000u64)))
			(if (u64.not-eq (f64.to-bits (f64.from-f128 (local infinity))) 0x7ff0000000000000u64)
				(then (return 12i32)))
			(let nan (f32.from-f128 (f128.from-f64 (f64.from-bits 0x7ff8000000000000u64))))
			(if (f32.eq (local nan) (local nan)) (then (return 13i32)))
			(let-mut packet (struct.new QuadPacket))
			(if (i32.not-eq (call quad_store (borrow-mut (local packet)) (call quad_twice 21f128)) 0i32)
				(then (return 14i32)))
			(if (u8.not-eq (struct.get (local packet) marker) 7u8) (then (return 15i32)))
			(return (i32.from-f128 (struct.get (local packet) value))))))
