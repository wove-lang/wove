	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (i32.eq (array.len (local args)) 1i32)
				(then
					(let narrowed (f80.from-f128 1.18973149535723176506e4932f128))
					(return (i32.from-f80 (local narrowed)))))
			(if (f128.not-eq (f128.from-f80 1.5f80) 1.5f128) (then (return 1i32)))
			(if (f80.not-eq (f80.from-f128 1.0000000000000000000542101086242754142933670787670823911690833209927318538101648215388195239938795566558837890625f128) 1.000000000000000000108420217248550443400745280086994171142578125f80)
				(then (return 2i32)))
			(return 0i32))))
