(module quad_inactive
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "A doc can mention f128.")

	(disabled (struct Quad (fields (value f128))))
	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan))) (returns i32)
		(body
			(let f128 0i32)
			(return (local f128)))))
