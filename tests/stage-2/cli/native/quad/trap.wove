(module quad_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32.dec (array.len args)))
			(if (i32.eq count 0i32)
				(then
					(let limit (f128.from-f64 (f64.from-bits 0x7fefffffffffffffu64)))
					(let narrowed (f64.from-f128 (f128.add limit 1e280f128)))
					(return (i32.from-f64 narrowed))))
			(if (i32.eq count 1i32)
				(then
					(let limit (f128.from-f32 (f32.from-bits 0x7f7fffffu32)))
					(let narrowed (f32.from-f128 (f128.add limit 1e10f128)))
					(return (i32.from-f32 narrowed))))
			(if (i32.eq count 2i32)
				(then
					(let result (i64.from-f128 -9223372036854775809f128))
					(return (i32.from-i64 result))))
			(if (i32.eq count 3i32)
				(then
					(let result (u64.from-f128 18446744073709551616f128))
					(return (i32.from-u64 result))))
			(return (i32.from-f128 (f128.from-f64 (f64.from-bits 0x7ff8000000000000u64)))))))
