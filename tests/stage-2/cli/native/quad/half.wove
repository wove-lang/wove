	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eq (i32.dec (array.len args)) 1i32)
				(then
					(let narrowed (f16.from-f128 (f128.add 65504f128 1e-20f128)))
					(return (i32.from-f16 narrowed))))
			(if (f128.not-eq (f128.from-f16 1.5f16) 1.5f128) (then (return 1i32)))
			(if (u16.not-eq (f16.to-bits (f16.from-f128 1.0004882812500000000000000000000001925929944387235853055977942584927318538101648215388195239938795566558837890625f128)) 0x3c01u16)
				(then (return 2i32)))
			(return 0i32))))
