(module owner_marker_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./probe.h"
		(type ProbeAcl (:pragma (c_owned (drop drop_probe void-pointer))) (c-type "ProbeAcl"))
		(type OtherAcl (:pragma (c_owned (drop drop_probe void-pointer))) (c-type "OtherAcl"))
		(fn get_probe
			(:pragma (c_owner_out output removed PROBE_REMOVE))
			(params (mode i32) (removed (mut-ref bool)) (const selector i32 13)
				(output (mut-ref ProbeAcl)) (token i32))
			(returns i32))
		(fn read_probe
			(:pragma (c_void_ptr input))
			(params (input (shared-ref ProbeAcl))) (returns i32))
		(fn mark_probe
			(params (const marker (c-type "const void *") PROBE_REMOVE)) (returns i32))
		(fn drop_count (params) (returns i32))))
