(module marker_wrong_flag_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./probe.h"
		(type ProbeAcl (:pragma (c_owned (drop drop_probe void-pointer))) (c-type "ProbeAcl"))
		(fn wrong_get
			(:pragma (c_owner_out output removed PROBE_REMOVE))
			(params (output (mut-ref ProbeAcl)) (removed (mut-ref i32))) (returns i32)))
	(use c-header "./probe.h" (only (type ProbeAcl) wrong_get))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (native.empty ProbeAcl))
			(let-mut removed 0i32)
			(return (call wrong_get (borrow-mut output) (borrow-mut removed))))))
