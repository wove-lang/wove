(module marker_wrong_flag_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./probe.h"
		(type (:pragma (c_owned (drop drop_probe void-pointer))) ProbeAcl (c-type "ProbeAcl"))
		(fn wrong_get
			(:pragma (c_owner_out output removed PROBE_REMOVE))
			(params (output (mut-ref ProbeAcl)) (removed (mut-ref i32))) (returns i32)))
	(use c-header "./probe.h" (only (type ProbeAcl) wrong_get))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut output (native.empty ProbeAcl))
			(let-mut removed 0i32)
			(return (call wrong_get (borrow-mut (local output)) (borrow-mut (local removed)))))))
