(module marker_wrong_native_signature
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./probe.h"
		(type (:pragma (c_owned (drop drop_probe void-pointer))) ProbeAcl (c-type "ProbeAcl"))
		(type (:pragma (c_owned (drop wrong_drop void-pointer))) OtherAcl (c-type "OtherAcl"))
		(fn wrong_get
			(:pragma (c_owner_out output removed PROBE_REMOVE))
			(params (output (mut-ref ProbeAcl)) (removed (mut-ref bool))) (returns i32))
		(fn wrong_marker
			(c-name "mark_probe")
			(params (const marker (c-type "const void *") PROBE_INTEGER)) (returns i32)))
	(use c-header "./probe.h" (only (type ProbeAcl) (type OtherAcl) wrong_get wrong_marker))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (native.empty ProbeAcl))
			(let other (native.empty OtherAcl))
			(if (bool.not (owner.is-null other)) (then (return 1i32)))
			(let-mut removed (bool false))
			(let status (call wrong_get (borrow-mut output) (borrow-mut removed)))
			(return (i32.add status (call wrong_marker))))))
