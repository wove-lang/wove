(module controlled_owner_markers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./probe.h" (only (type ProbeAcl) get_probe read_probe mark_probe drop_count))

	(struct Holder (fields (acl ProbeAcl)))

	(fn check_case (params (mode i32)) (returns i32)
		(body
			(let-mut result (struct:new Holder (acl (native:empty ProbeAcl))))
			(let marker (bool:or (i32:eq mode 1i32) (i32:eq mode 4i32)))
			(let-mut removed (bool:not marker))
			(let status (call get_probe mode (borrow-mut removed)
				(borrow-mut (struct:get result acl)) 29i32))
			(let expected (array:new (array i32 5) -13i32 0i32 9i32 -8i32 -5i32))
			(if (i32:not-eq status (array:get expected mode)) (then (return 1i32)))
			(if (bool:not (if marker (then removed) (else (bool:not removed))))
				(then (return 2i32)))
			(let present (bool:or (i32:eq mode 2i32) (i32:eq mode 3i32)))
			(if present
				(then
					(if (owner:is-null (struct:get result acl)) (then (return 3i32)))
					(if (i32:not-eq (call read_probe (borrow-shared (struct:get result acl))) 42i32)
						(then (return 4i32))))
				(else
					(if (bool:not (owner:is-null (struct:get result acl))) (then (return 5i32)))))
			(return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut mode 0i32)
			(let expected_drops (array:new (array i32 5) 0i32 0i32 1i32 2i32 2i32))
			(while (i32:lt mode 5i32)
				(body
					(let result (call check_case mode))
					(if (i32:not-eqz result) (then (return result)))
					(if (i32:not-eq (call drop_count) (array:get expected_drops mode))
						(then (return 6i32)))
					(set mode (i32:inc mode))))
			(if (i32:not-eq (call mark_probe) 17i32) (then (return 7i32)))
			(return 42i32))))
