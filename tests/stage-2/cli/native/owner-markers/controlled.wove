(module controlled_owner_markers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./probe.h" (only (type ProbeAcl) get_probe read_probe mark_probe drop_count))

	(struct Holder (fields (acl ProbeAcl)))

	(fn check_case (params (mode i32)) (returns i32)
		(body
			(let-mut result (struct.new Holder (acl (native.empty ProbeAcl))))
			(let marker (bool.or (i32.eq (local mode) 1i32) (i32.eq (local mode) 4i32)))
			(let-mut removed (bool.not (local marker)))
			(let status (call get_probe (local mode) (borrow-mut (local removed))
				(borrow-mut (struct.get (local result) acl)) 29i32))
			(let expected (array.new (array i32 5) -13i32 0i32 9i32 -8i32 -5i32))
			(if (i32.not-eq (local status) (array.load (local expected) (local mode))) (then (return 1i32)))
			(if (bool.not (if (local marker) (then (local removed)) (else (bool.not (local removed)))))
				(then (return 2i32)))
			(let present (bool.or (i32.eq (local mode) 2i32) (i32.eq (local mode) 3i32)))
			(if (local present)
				(then
					(if (owner.is-null (struct.get (local result) acl)) (then (return 3i32)))
					(if (i32.not-eq (call read_probe (borrow-shared (struct.get (local result) acl))) 42i32)
						(then (return 4i32))))
				(else
					(if (bool.not (owner.is-null (struct.get (local result) acl))) (then (return 5i32)))))
			(return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut mode 0i32)
			(let expected_drops (array.new (array i32 5) 0i32 0i32 1i32 2i32 2i32))
			(while (i32.lt (local mode) 5i32)
				(body
					(let result (call check_case (local mode)))
					(if (i32.not-eqz (local result)) (then (return (local result))))
					(if (i32.not-eq (call drop_count) (array.load (local expected_drops) (local mode)))
						(then (return 6i32)))
					(set (local mode) (i32.inc (local mode)))))
			(if (i32.not-eq (call mark_probe) 17i32) (then (return 7i32)))
			(return 42i32))))
