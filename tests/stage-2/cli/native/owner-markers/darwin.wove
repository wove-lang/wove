(module darwin_acl_owner_marker
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/acl.h>" (:pragma (cfg (os "macos")))
		(type Acl (:pragma (c_owned (drop acl_free void-pointer))) (c-type "acl_t")))
	(bridge c-header "<fcntl.h>" (:pragma (cfg (os "macos")))
		(use c-header "<sys/acl.h>" (only (type Acl)))
		(type Security (:pragma (c_owned (drop filesec_free))) (c-type "filesec_t"))
		(fn filesec_init (params) (returns Security))
		(fn get_acl
			(:pragma (c_owner_out output removed _FILESEC_REMOVE_ACL))
			(c-name "filesec_get_property")
			(params (security (shared-ref Security)) (const property (c-type "filesec_property_t") FILESEC_ACL)
				(output (mut-ref Acl)) (removed (mut-ref bool)))
			(returns i32))
		(fn set_acl
			(:pragma (c_void_ptr input))
			(c-name "filesec_set_property")
			(params (security (mut-ref Security)) (const property (c-type "filesec_property_t") FILESEC_ACL)
				(input (shared-ref Acl)))
			(returns i32))
		(fn mark_acl
			(c-name "filesec_set_property")
			(params (security (mut-ref Security)) (const property (c-type "filesec_property_t") FILESEC_ACL)
				(const marker (c-type "const void *") _FILESEC_REMOVE_ACL))
			(returns i32))
		(fn unset_acl
			(c-name "filesec_unset_property")
			(params (security (mut-ref Security)) (const property (c-type "filesec_property_t") FILESEC_ACL))
			(returns i32)))
	(bridge c-header "./darwin.h" (:pragma (cfg (os "macos")))
		(use c-header "<sys/acl.h>" (only (type Acl)))
		(fn make_acl_fixture (params) (returns Acl))
		(fn check_acl_fixture (params (acl (shared-ref Acl))) (returns i32)))
	(use (:pragma (cfg (os "macos"))) c-header "<sys/acl.h>" (only (type Acl)))
	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>" (only filesec_init get_acl set_acl mark_acl unset_acl))
	(use (:pragma (cfg (os "macos"))) c-header "./darwin.h" (only make_acl_fixture check_acl_fixture))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ENOENT)))

	(fn verify (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner:is-null security) (then (return 1i32)))
			(let-mut output (native:empty Acl))
			(let-mut removed (bool true))
			(let missing (call get_acl (borrow-shared security)
				(borrow-mut output) (borrow-mut removed)))
			(if (i32:not-eq missing -1i32) (then (return 2i32)))
			(if (i32:not-eq errno ENOENT) (then (return 3i32)))
			(if (bool:or removed (bool:not (owner:is-null output))) (then (return 4i32)))

			(let-mut original (call make_acl_fixture))
			(if (owner:is-null original) (then (return 5i32)))
			(if (i32:not-eqz (call set_acl (borrow-mut security) (borrow-shared original)))
				(then (return 6i32)))
			(if (i32:not-eqz (call check_acl_fixture (borrow-shared original))) (then (return 7i32)))
			(set original (native:empty Acl))
			(if (i32:not-eqz (call get_acl (borrow-shared security)
					(borrow-mut output) (borrow-mut removed)))
				(then (return 8i32)))
			(if (bool:or removed (owner:is-null output)) (then (return 9i32)))
			(if (i32:not-eqz (call unset_acl (borrow-mut security))) (then (return 10i32)))
			(if (i32:not-eqz (call check_acl_fixture (borrow-shared output))) (then (return 11i32)))

			(let-mut marked (native:empty Acl))
			(if (i32:not-eqz (call mark_acl (borrow-mut security))) (then (return 12i32)))
			(if (i32:not-eqz (call get_acl (borrow-shared security)
					(borrow-mut marked) (borrow-mut removed)))
				(then (return 13i32)))
			(if (bool:not (bool:and removed (owner:is-null marked))) (then (return 14i32)))
			(if (i32:not-eqz (call unset_acl (borrow-mut security))) (then (return 15i32)))
			(let absent (call get_acl (borrow-shared security)
				(borrow-mut marked) (borrow-mut removed)))
			(if (i32:not-eq absent -1i32) (then (return 16i32)))
			(if (i32:not-eq errno ENOENT) (then (return 17i32)))
			(if (bool:or removed (bool:not (owner:is-null marked))) (then (return 18i32)))
			(return 42i32)))

	(fn verify (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call verify)))))
