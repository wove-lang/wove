(module marker_wrong_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./probe.h" (only (type OtherAcl) get_probe))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut wrong (native.empty OtherAcl))
			(let-mut removed (bool false))
			(return (call get_probe 0i32 (borrow-mut removed) (borrow-mut wrong) 29i32)))))
