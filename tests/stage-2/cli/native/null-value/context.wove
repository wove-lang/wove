(module project_null_context
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "./project.h" (only fixture_nullable (value (as PROJECT_NULL absent))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (call fixture_nullable absent))
			(if (i32:eq first 42i32) (then (return (call fixture_nullable absent))))
			(return 1i32))))
