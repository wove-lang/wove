(module native_null_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "<stddef.h>" (only (type Size) (value (as NULL system_absent))))
	(use c-header "./project.h"
		(only fixture_nullable fixture_nullable_string fixture_nullable_void fixture_literal_only (value (as PROJECT_NULL absent))))

	(fn check_shadow (params (absent (mut-ref i32))) (returns i32)
		(body (return (call fixture_nullable (borrow-mut absent)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call fixture_nullable system_absent) 42i32) (then (return 1i32)))
			(if (i32:not-eq (call fixture_nullable absent) 42i32) (then (return 2i32)))
			(if (i32:not-eq (call fixture_nullable_string absent) 42i32) (then (return 3i32)))
			(if (i32:not-eq (call fixture_nullable_void system_absent) 42i32) (then (return 6i32)))
			(let-mut value 15i32)
			(if (i32:not-eq (call check_shadow (borrow-mut value)) 16i32) (then (return 4i32)))
			(if (i32:not-eq value 16i32) (then (return 5i32)))
			(return (call fixture_literal_only null)))))
