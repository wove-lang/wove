(module project_null_bridge
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./project.h"
		(const PROJECT_NULL (:pragma (c_null_value)))
		(fn fixture_nullable
			(:pragma (c_nullable value))
			(params (value (mut-ref i32))) (returns i32))
		(fn fixture_nullable_string
			(:pragma (c_cstr value) (c_nullable value))
			(params (value (shared-array u8))) (returns i32))
		(fn fixture_nullable_void
			(:pragma (c_cstr value) (c_nullable value))
			(params (value (shared-array u8))) (returns i32))
		(fn fixture_plain (params (value (mut-ref i32))) (returns i32))
		(fn fixture_literal_only
			(:pragma (c_null value))
			(params (value (mut-array u8))) (returns i32))
		(fn fixture_variadic
			(:pragma (c_variadic ...))
			(params (value i32)) (returns i32))))
