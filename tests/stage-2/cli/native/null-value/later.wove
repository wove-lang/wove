(module null_later_include
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "./project.h" (only fixture_nullable (value (as PROJECT_NULL absent))))

	(use c-header "./later.h" (only (value FIXTURE_LATER_HEADER)))
	(bridge c-header "./later.h"
		(const FIXTURE_LATER_HEADER i32))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (call fixture_nullable absent)))))
