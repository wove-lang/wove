(module cstr_offset_unconverted_input
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native.h" (only fixture_wrong))
	(bridge c-header "./native.h"
		(fn fixture_wrong
			(:pragma (c_cstr_raw text) (c_cstr_offset stop text))
			(params (text (shared-array u8)) (stop (mut-ref i32)))
			(returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
