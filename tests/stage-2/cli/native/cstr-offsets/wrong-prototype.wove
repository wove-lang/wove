(module cstr_offset_wrong_native_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native.h" (only fixture_wrong))
	(bridge c-header "./native.h"
		(fn fixture_wrong
			(:pragma (c_cstr text) (c_cstr_offset stop text))
			(params (text (shared-array u8)) (stop (mut-ref i32)))
			(returns i32)))

	(let text "input")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut stop -1i32)
			(return (call fixture_wrong (borrow-shared text) (borrow-mut stop))))))
