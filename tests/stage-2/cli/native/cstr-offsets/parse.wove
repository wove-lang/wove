(module cstr_offset_inttypes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<errno.h>" (only (value errno) ERANGE))
	(use c-header "<inttypes.h>" (only (type IntMax) (type UIntMax) strtoimax strtoumax))
	(bridge c-header "<inttypes.h>"
		(type IntMax (c-type "intmax_t"))
		(type UIntMax (c-type "uintmax_t"))
		(fn strtoimax
			(:pragma (c_cstr text) (c_cstr_offset stop text))
			(params (text (shared-array u8)) (stop (mut-ref i32)) (base i32))
			(returns IntMax))
		(fn strtoumax
			(:pragma (c_cstr_offset stop text) (c_cstr text))
			(params (text (shared-array u8)) (stop (mut-ref i32)) (base i32))
			(returns UIntMax)))

	(let empty "")
	(let invalid " -?")
	(let partial " -0x2a!")
	(let unsigned_partial " +0x2a!")
	(let full "42")
	(let underflow "-92233720368547758090!")
	(let overflow "184467440737095516160!")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut stop -1i32)
			(let a (call strtoimax (borrow-shared empty) (borrow-mut stop) 0i32))
			(if (bool:or (i64:not-eq (int:convert i64 a) 0i64) (i32:not-eq stop 0i32))
				(then (return 1i32)))
			(set stop -1i32)
			(let b (call strtoumax (borrow-shared invalid) (borrow-mut stop) 0i32))
			(if (bool:or (u64:not-eq (int:convert u64 b) 0u64) (i32:not-eq stop 0i32))
				(then (return 2i32)))
			(let c (call strtoimax (borrow-shared partial) (borrow-mut stop) 0i32))
			(if (bool:or (i64:not-eq (int:convert i64 c) -42i64) (i32:not-eq stop 6i32))
				(then (return 3i32)))
			(let d (call strtoumax (borrow-shared unsigned_partial) (borrow-mut stop) 0i32))
			(if (bool:or (u64:not-eq (int:convert u64 d) 42u64) (i32:not-eq stop 6i32))
				(then (return 4i32)))
			(let e (call strtoimax (borrow-shared full) (borrow-mut stop) 10i32))
			(if (bool:or (i64:not-eq (int:convert i64 e) 42i64) (i32:not-eq stop 2i32))
				(then (return 5i32)))
			(set stop -1i32)
			(let f (call strtoumax (borrow-shared full) (borrow-mut stop) 10i32))
			(if (bool:or (u64:not-eq (int:convert u64 f) 42u64) (i32:not-eq stop 2i32))
				(then (return 6i32)))
			(set errno 0i32)
			(let g (call strtoimax (borrow-shared underflow) (borrow-mut stop) 10i32))
			(if (bool:or (i64:not-eq (int:convert i64 g) -9223372036854775808i64)
				(bool:or (i32:not-eq stop 21i32) (i32:not-eq errno ERANGE)))
				(then (return 7i32)))
			(set errno 0i32)
			(let h (call strtoumax (borrow-shared overflow) (borrow-mut stop) 10i32))
			(if (bool:or (u64:not-eq (int:convert u64 h) 18446744073709551615u64)
				(bool:or (i32:not-eq stop 21i32) (i32:not-eq errno ERANGE)))
				(then (return 8i32)))
			(return 42i32))))
