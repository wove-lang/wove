(module cstr_offset_project
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<errno.h>" (only (value errno) EDOM))
	(use c-header "./native.h" (only fixture_positions))
	(bridge c-header "./native.h"
		(fn fixture_positions
			(:pragma (c_cstr_offset first text) (c_cstr before text) (c_nullable before)
				(c_cstr_offset last text))
			(params (before (shared-array u8)) (first (mut-ref i32))
				(text (shared-array u8)) (last (mut-ref i32)))
			(returns i32)))

	(let before "earlier")
	(let text "..two!")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut first -1i32)
			(let-mut last -1i32)
			(set errno 0i32)
			(let result (call fixture_positions null (borrow-mut first)
				(borrow-shared (array:range text 2i32 5i32)) (borrow-mut last)))
			(if (bool:or (i32:not-eq result -7i32) (i32:not-eq errno EDOM)) (then (return 1i32)))
			(if (bool:or (i32:not-eq first 1i32) (i32:not-eq last 3i32)) (then (return 2i32)))
			(set first -1i32)
			(set last -1i32)
			(set errno 0i32)
			(let again (call fixture_positions (borrow-shared before) (borrow-mut first)
				(borrow-shared (array:range text 2i32 5i32)) (borrow-mut last)))
			(if (bool:or (i32:not-eq again 7i32) (i32:not-eq errno EDOM)) (then (return 3i32)))
			(if (bool:or (i32:not-eq first 1i32) (i32:not-eq last 3i32)) (then (return 4i32)))
			(return 42i32))))
