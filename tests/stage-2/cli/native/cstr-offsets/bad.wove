(module cstr_offset_invalid_native
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native.h" (only fixture_invalid))
	(bridge c-header "./native.h"
		(fn fixture_invalid
			(:pragma (c_cstr before text after) (c_cstr_offset stop text))
			(params (before (shared-array u8)) (text (shared-array u8)) (after (shared-array u8))
				(stop (mut-ref i32)) (scenario i32))
			(returns i32)))

	(let before "before")
	(let text "input")
	(let after "after")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut stop -1i32)
			(return (call fixture_invalid (borrow-shared before) (borrow-shared text)
				(borrow-shared after) (borrow-mut stop) (i32:dec (array:len args)))))))
