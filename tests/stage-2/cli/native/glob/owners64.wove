(module glibc_glob_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<glob.h>"
		(only (type Glob64) glob64 glob64_append globfree64 GLOB_APPEND GLOB_DOOFFS))

	(let first_pattern "rows/*.txt")
	(let appended_pattern "rows/*.new")

	(fn walk (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let-mut result (native:alloc Glob64 2i64))
			(if (i32:not-eqz (call glob64 (borrow-shared first_pattern) GLOB_DOOFFS null (borrow-mut result)))
				(then (return 1i32)))
			(if (i32:not-eqz (call glob64_append (borrow-shared appended_pattern)
					(i32:or GLOB_DOOFFS GLOB_APPEND) null (borrow-mut result)))
				(then (return 2i32)))
			(if (bool true)
				(then
					(let paths (native:cstrs-view (borrow-shared result)))
					(if (i32:not-eq (native:cstrs-len paths) 3i32) (then (return 3i32)))
					(let last (native:cstrs-load paths 2i32))
					(if (u8:not-eq (array:get last 5i32) 99u8) (then (return 4i32)))))
			(call globfree64 (move result))
			(return 42i32)))

	(fn walk (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call walk)))))
