(module bundled_glob_base
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<glob.h>" (only GLOB_ABORTED GLOB_APPEND GLOB_DOOFFS GLOB_ERR GLOB_MARK GLOB_NOCHECK GLOB_NOESCAPE GLOB_NOMATCH GLOB_NOSORT GLOB_NOSPACE GLOB_NOSYS))
	(use c-header "./oracle.h" (only glob_core_ok))
	(bridge c-header "./oracle.h"
		(fn glob_core_ok
			(params (aborted i32) (append i32) (dooffs i32) (err i32) (mark i32) (nocheck i32) (noescape i32) (nomatch i32) (nosort i32) (nospace i32) (nosys i32)) (returns bool)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (call glob_core_ok GLOB_ABORTED GLOB_APPEND GLOB_DOOFFS GLOB_ERR GLOB_MARK GLOB_NOCHECK GLOB_NOESCAPE GLOB_NOMATCH GLOB_NOSORT GLOB_NOSPACE GLOB_NOSYS) (then (return 42i32)))
			(return 1i32))))
