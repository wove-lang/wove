(module bundled_glob_extensions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<glob.h>" (only GLOB_ABEND GLOB_ALTDIRFUNC GLOB_BRACE GLOB_MAGCHAR GLOB_NOMAGIC GLOB_TILDE))
	(use (:pragma (cfg (os "macos"))) c-header "<glob.h>" (only GLOB_LIMIT GLOB_MAXPATH GLOB_QUOTE))
	(use (:pragma (cfg (os "linux"))) c-header "<glob.h>" (only GLOB_ONLYDIR GLOB_PERIOD GLOB_TILDE_CHECK glob_pattern_p))
	(use c-header "./oracle.h" (only glob_common_ok glob_platform_ok))
	(bridge c-header "./oracle.h"
		(fn glob_common_ok
			(params (abend i32) (altdirfunc i32) (brace i32) (magchar i32) (nomagic i32) (tilde i32)) (returns bool))
		(fn glob_platform_ok (params (first i32) (second i32) (third i32)) (returns bool)))

	(let word "file")
	(let wildcard "[ab]")
	(let escaped "file\\*")

	(fn check_platform (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body (return (call glob_platform_ok GLOB_LIMIT GLOB_MAXPATH GLOB_QUOTE))))

	(fn check_platform (:pragma (cfg (os "linux"))) (params) (returns bool)
		(body
			(if (bool.not (call glob_platform_ok GLOB_ONLYDIR GLOB_PERIOD GLOB_TILDE_CHECK)) (then (return (bool false))))
			(if (i32.not-eqz (call glob_pattern_p (borrow-shared word) 0i32)) (then (return (bool false))))
			(if (i32.eqz (call glob_pattern_p (borrow-shared wildcard) 0i32)) (then (return (bool false))))
			(if (i32.not-eqz (call glob_pattern_p (borrow-shared escaped) 1i32)) (then (return (bool false))))
			(return (i32.not-eqz (call glob_pattern_p (borrow-shared escaped) 0i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call glob_common_ok GLOB_ABEND GLOB_ALTDIRFUNC GLOB_BRACE GLOB_MAGCHAR GLOB_NOMAGIC GLOB_TILDE)) (then (return 1i32)))
			(if (call check_platform) (then (return 42i32)))
			(return 2i32))))
