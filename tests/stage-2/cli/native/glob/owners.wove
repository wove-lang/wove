(module bundled_glob_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<errno.h>" (only ELOOP))
	(use c-header "<glob.h>" (only (type Glob) glob glob_append globfree
		GLOB_ABORTED GLOB_APPEND GLOB_DOOFFS GLOB_NOMATCH))

	(let first_pattern "rows/*.txt")
	(let appended_pattern "rows/*.new")
	(let empty_pattern "missing/*.txt")
	(let loop_pattern "loop/*")

	(fn report_error (params (path (shared-array u8)) (error i32)) (returns i32)
		(body
			(if (i32:not-eq error ELOOP) (then (return 0i32)))
			(if (i32:lt (array:len path) 4i32) (then (return 0i32)))
			(if (u8:not-eq (array:get path 0i32) 108u8) (then (return 0i32)))
			(return 1i32)))

	(fn walk_and_append (params) (returns i32)
		(body
			(let-mut result (native:alloc Glob 2i64))
			(if (i32:not-eqz (call glob (borrow-shared first_pattern) GLOB_DOOFFS null (borrow-mut result)))
				(then (return 1i32)))
			(if (bool true)
				(then
					(let paths (native:cstrs-view (borrow-shared result)))
					(if (i32:not-eq (native:cstrs-len paths) 2i32) (then (return 2i32)))
					(let first (native:cstrs-load paths 0i32))
					(if (u8:not-eq (array:get first 5i32) 97u8) (then (return 3i32)))))
			(if (i32:not-eqz (call glob_append (borrow-shared appended_pattern)
					(i32:or GLOB_DOOFFS GLOB_APPEND) null (borrow-mut result)))
				(then (return 4i32)))
			(if (i32:not-eq (call glob_append (borrow-shared loop_pattern)
					(i32:or GLOB_DOOFFS GLOB_APPEND) (fn-ref report_error) (borrow-mut result)) GLOB_ABORTED)
				(then (return 11i32)))
			(if (bool true)
				(then
					(let paths (native:cstrs-view (borrow-shared result)))
					(if (i32:not-eq (native:cstrs-len paths) 3i32) (then (return 5i32)))
					(let last (native:cstrs-load paths 2i32))
					(if (u8:not-eq (array:get last 5i32) 99u8) (then (return 6i32)))))
			(call globfree (move result))
			(return 42i32)))

	(fn empty_and_error (params) (returns i32)
		(body
			(let-mut empty (native:alloc Glob))
			(if (i32:not-eq (call glob (borrow-shared empty_pattern) 0i32 null (borrow-mut empty)) GLOB_NOMATCH)
				(then (return 7i32)))
			(let empty_paths (native:cstrs-view (borrow-shared empty)))
			(if (i32:not-eqz (native:cstrs-len empty_paths)) (then (return 8i32)))
			(let-mut failed (native:alloc Glob))
			(if (i32:not-eq (call glob (borrow-shared loop_pattern) 0i32 (fn-ref report_error)
					(borrow-mut failed)) GLOB_ABORTED)
				(then (return 9i32)))
			(let failed_paths (native:cstrs-view (borrow-shared failed)))
			(if (i32:not-eqz (native:cstrs-len failed_paths)) (then (return 10i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let walked (call walk_and_append))
			(if (i32:not-eq walked 42i32) (then (return walked)))
			(return (call empty_and_error)))))
