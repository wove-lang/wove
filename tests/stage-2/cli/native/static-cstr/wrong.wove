(module static_cstr_wrong
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_wrong))
	(bridge c-header "./native.h"
		(fn fixture_wrong (:pragma (c_static_cstr text))
			(params (severity i32) (text (shared-array u8))) (returns i32)))
	(let bytes "borrowed")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call fixture_wrong 91i32 "immutable")))))
