(module static_cstr_embedded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_register))
	(bridge c-header "./native.h"
		(fn fixture_register (:pragma (c_static_cstr text))
			(params (severity i32) (text (shared-array u8))) (returns i32)))
	(let bytes "borrowed")
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call fixture_register 91i32 "abc\u0000tail")))))
