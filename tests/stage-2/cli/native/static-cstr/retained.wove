(module native_retained_cstr
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native.h" (only fixture_register fixture_remove fixture_read))
	(bridge c-header "./native.h"
		(fn fixture_register
			(:pragma (c_static_cstr text))
			(params (severity i32) (text (shared-array u8))) (returns i32))
		(fn fixture_remove
			(params (severity i32) (const text (c-type "const char *") null))
			(returns i32) (c-name "fixture_register"))
		(fn fixture_read (params (index i32)) (returns i32)))

	(fn register (params) (returns i32)
		(body (return (call fixture_register 91i32 "A\u00e9?9"))))

	(fn check_first (params) (returns bool)
		(body
			(return (bool.and
				(bool.and (i32.eq (call fixture_read 0i32) 65i32) (i32.eq (call fixture_read 1i32) 195i32))
				(bool.and
					(bool.and (i32.eq (call fixture_read 2i32) 169i32) (i32.eq (call fixture_read 3i32) 63i32))
					(bool.and (i32.eq (call fixture_read 4i32) 57i32) (i32.eq (call fixture_read 5i32) 0i32)))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq (call register) 0i32) (then (return 1i32)))
			(if (bool.not (call check_first)) (then (return 2i32)))
			(if (i32.not-eq (call fixture_register 91i32 "!rejected") -1i32) (then (return 3i32)))
			(if (bool.not (call check_first)) (then (return 4i32)))
			(if (i32.not-eq (call fixture_register 91i32 `Z```) 0i32) (then (return 5i32)))
			(if (i32.not-eq (call fixture_read 0i32) 90i32) (then (return 6i32)))
			(if (i32.not-eq (call fixture_read 1i32) 96i32) (then (return 7i32)))
			(if (i32.not-eq (call fixture_read 2i32) 0i32) (then (return 8i32)))
			(if (i32.not-eq (call fixture_register 91i32 "") 0i32) (then (return 9i32)))
			(if (i32.not-eq (call fixture_read 0i32) 0i32) (then (return 10i32)))
			(if (i32.not-eq (call fixture_remove 91i32) 0i32) (then (return 11i32)))
			(if (i32.not-eq (call fixture_read 0i32) -1i32) (then (return 12i32)))
			(if (i32.not-eq (call fixture_remove 91i32) -1i32) (then (return 13i32)))
			(return 42i32))))
