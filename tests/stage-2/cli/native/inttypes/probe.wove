(module inttypes_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "<stdint.h>" (only (type IntMax)))
	(use c-header "TEST_HEADER" (only imaxabs imaxdiv (type Division)))
	(use c-header "./oracle.h" (only fixture_division_fields))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type Division)))
		(fn fixture_division_fields (params (observed (shared-ref Division))) (returns bool)))

	(fn check_magnitude (params (input i64) (expected i64)) (returns bool)
		(body
			(return (i64.eq (int.convert i64 (call imaxabs (int.convert IntMax input))) expected))))

	(fn check_division (params (numerator i64) (denominator i64) (quotient i64) (remainder i64)) (returns bool)
		(body
			(let result (call imaxdiv (int.convert IntMax numerator) (int.convert IntMax denominator)))
			(return (bool.and (i64.eq (int.convert i64 (struct.get result quot)) quotient)
				(i64.eq (int.convert i64 (struct.get result rem)) remainder)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_magnitude 0i64 0i64)) (then (return 1i32)))
			(if (bool.not (call check_magnitude 42i64 42i64)) (then (return 2i32)))
			(if (bool.not (call check_magnitude -42i64 42i64)) (then (return 3i32)))
			(if (bool.not (call check_magnitude 9223372036854775807i64 9223372036854775807i64))
				(then (return 4i32)))
			(if (bool.not (call check_magnitude -9223372036854775807i64 9223372036854775807i64))
				(then (return 5i32)))
			(let result (struct.new Division (quot (int.convert IntMax -6i64)) (rem (int.convert IntMax -1i64))))
			(if (i64.not-eq (int.convert i64 (struct.get result quot)) -6i64) (then (return 6i32)))
			(if (i64.not-eq (int.convert i64 (struct.get result rem)) -1i64) (then (return 7i32)))
			(if (bool.not (call fixture_division_fields (borrow-shared result))) (then (return 8i32)))
			(if (bool.not (call check_division 43i64 7i64 6i64 1i64)) (then (return 9i32)))
			(if (bool.not (call check_division -43i64 7i64 -6i64 -1i64)) (then (return 10i32)))
			(if (bool.not (call check_division 43i64 -7i64 -6i64 1i64)) (then (return 11i32)))
			(if (bool.not (call check_division -43i64 -7i64 6i64 -1i64)) (then (return 12i32)))
			(if (bool.not (call check_division 0i64 -7i64 0i64 0i64)) (then (return 13i32)))
			(if (bool.not (call check_division 9223372036854775807i64 1i64 9223372036854775807i64 0i64))
				(then (return 14i32)))
			(if (bool.not (call check_division -9223372036854775808i64 1i64 -9223372036854775808i64 0i64))
				(then (return 15i32)))
			(return 42i32))))
