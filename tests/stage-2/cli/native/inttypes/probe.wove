(module inttypes_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "<errno.h>" (only (value errno) ERANGE))
	(use c-header "<stdint.h>" (only (type IntMax) (type UIntMax) INTMAX_MIN UINTMAX_MAX))
	(use c-header "TEST_HEADER" (only imaxabs imaxdiv strtoimax strtoumax (type Division)))
	(use c-header "./oracle.h" (only fixture_division_fields fixture_binary_prefix))
	(bridge c-header "./oracle.h"
		(use c-header "TEST_HEADER" (only (type Division)))
		(use c-header "<stdint.h>" (only (type IntMax) (type UIntMax)))
		(fn fixture_division_fields (params (observed (shared-ref Division))) (returns bool))
		(fn fixture_binary_prefix
			(params (signed IntMax) (signed_end i32) (unsigned UIntMax) (unsigned_end i32))
			(returns bool)))

	(fn check_magnitude (params (input i64) (expected i64)) (returns bool)
		(body
			(return (i64:eq (int:convert i64 (call imaxabs (int:convert IntMax input))) expected))))

	(fn check_division (params (numerator i64) (denominator i64) (quotient i64) (remainder i64)) (returns bool)
		(body
			(let result (call imaxdiv (int:convert IntMax numerator) (int:convert IntMax denominator)))
			(return (bool:and (i64:eq (int:convert i64 (struct:get result quot)) quotient)
				(i64:eq (int:convert i64 (struct:get result rem)) remainder)))))

	(let invalid " -?")
	(let partial " -0x2a!")
	(let full "52")
	(let binary "0b101!")
	(let underflow "-92233720368547758090!")
	(let overflow "184467440737095516160!")

	(fn check_conversions (params) (returns i32)
		(body
			(let-mut end -1i32)
			(let none (call strtoimax (borrow-shared invalid) (borrow-mut end) 0i32))
			(if (bool:not (bool:and (int:eq IntMax none (int:convert IntMax 0i32)) (i32:eq end 0i32)))
				(then (return 16i32)))
			(let prefix (call strtoimax (borrow-shared partial) (borrow-mut end) 0i32))
			(if (bool:not (bool:and (int:eq IntMax prefix (int:convert IntMax -42i32)) (i32:eq end 6i32)))
				(then (return 17i32)))
			(let whole (call strtoumax (borrow-shared full) (borrow-mut end) 10i32))
			(if (bool:not (bool:and (int:eq UIntMax whole (int:convert UIntMax 52i32)) (i32:eq end 2i32)))
				(then (return 18i32)))
			(set errno 0i32)
			(let small (call strtoimax (borrow-shared underflow) (borrow-mut end) 10i32))
			(if (bool:not (bool:and (int:eq IntMax small INTMAX_MIN)
				(bool:and (i32:eq end 21i32) (i32:eq errno ERANGE))))
				(then (return 19i32)))
			(set errno 0i32)
			(let large (call strtoumax (borrow-shared overflow) (borrow-mut end) 10i32))
			(if (bool:not (bool:and (int:eq UIntMax large UINTMAX_MAX)
				(bool:and (i32:eq end 21i32) (i32:eq errno ERANGE))))
				(then (return 20i32)))
			(let binary_signed (call strtoimax (borrow-shared binary) (borrow-mut end) 0i32))
			(let signed_end end)
			(let binary_unsigned (call strtoumax (borrow-shared binary) (borrow-mut end) 0i32))
			(if (bool:not (call fixture_binary_prefix binary_signed signed_end binary_unsigned end))
				(then (return 21i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call check_magnitude 0i64 0i64)) (then (return 1i32)))
			(if (bool:not (call check_magnitude 42i64 42i64)) (then (return 2i32)))
			(if (bool:not (call check_magnitude -42i64 42i64)) (then (return 3i32)))
			(if (bool:not (call check_magnitude 9223372036854775807i64 9223372036854775807i64))
				(then (return 4i32)))
			(if (bool:not (call check_magnitude -9223372036854775807i64 9223372036854775807i64))
				(then (return 5i32)))
			(let result (struct:new Division (quot (int:convert IntMax -6i64)) (rem (int:convert IntMax -1i64))))
			(if (i64:not-eq (int:convert i64 (struct:get result quot)) -6i64) (then (return 6i32)))
			(if (i64:not-eq (int:convert i64 (struct:get result rem)) -1i64) (then (return 7i32)))
			(if (bool:not (call fixture_division_fields (borrow-shared result))) (then (return 8i32)))
			(if (bool:not (call check_division 43i64 7i64 6i64 1i64)) (then (return 9i32)))
			(if (bool:not (call check_division -43i64 7i64 -6i64 -1i64)) (then (return 10i32)))
			(if (bool:not (call check_division 43i64 -7i64 -6i64 1i64)) (then (return 11i32)))
			(if (bool:not (call check_division -43i64 -7i64 6i64 -1i64)) (then (return 12i32)))
			(if (bool:not (call check_division 0i64 -7i64 0i64 0i64)) (then (return 13i32)))
			(if (bool:not (call check_division 9223372036854775807i64 1i64 9223372036854775807i64 0i64))
				(then (return 14i32)))
			(if (bool:not (call check_division -9223372036854775808i64 1i64 -9223372036854775808i64 0i64))
				(then (return 15i32)))
			(return (call check_conversions)))))
