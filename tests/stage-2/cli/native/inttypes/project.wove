(module project_inttypes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./user.h"
		(use c-header "<stdint.h>" (only (type IntMax)))
		(struct Division (c-type "imaxdiv_t") (fields (quot IntMax) (rem IntMax)))
		(fn imaxabs (params (value IntMax)) (returns IntMax))
		(fn imaxdiv (params (numerator IntMax) (denominator IntMax)) (returns Division))))
