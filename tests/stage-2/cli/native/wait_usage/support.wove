(module wait_usage_support
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<sys/wait.h>" (only (type Pid)))
	(use c-header "<sys/resource.h>" (only (type ResourceUsage)))
	(use c-header "<unistd.h>" (only fork _exit))
	(use c-header "./oracle.h" (only fixture_usage))
	(bridge c-header "./oracle.h"
		(use c-header "<sys/wait.h>" (only (type Pid)))
		(use c-header "<sys/resource.h>"
			(only (type ResourceUsage)))
		(use c-header "<sys/time.h>" (only (type TimevalSeconds) (type TimevalMicros)))
		(fn fixture_seed_usage (params (usage (mut-ref ResourceUsage))) (returns void))
		(fn fixture_usage
			(params (usage (shared-ref ResourceUsage)) (user_sec TimevalSeconds) (user_usec TimevalMicros)
				(system_sec TimevalSeconds) (system_usec TimevalMicros))
			(returns bool))
		(fn fixture_reaped (params (child Pid)) (returns bool))
		(fn fixture_exit_matches (params (status i32) (expected i32)) (returns bool)))

	(fn child_with_exit (params (exit_code i32)) (returns Pid)
		(body
			(let child (int.convert Pid (call fork)))
			(if (int.eq Pid child (int.convert Pid 0i32)) (then (call _exit exit_code)))
			(return child)))

	(fn check_usage (params (usage ResourceUsage)) (returns bool)
		(body
			(let user (struct.get usage ru_utime))
			(let system (struct.get usage ru_stime))
			(return (call fixture_usage (borrow-shared usage)
				(struct.get user tv_sec) (struct.get user tv_usec)
				(struct.get system tv_sec) (struct.get system tv_usec))))))
