(module wait_core_mask
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "<sys/wait.h>" (only WCOREDUMP))
	(use c-header "./oracle.h" (only fixture_core_mask))
	(bridge c-header "./oracle.h"
		(fn fixture_core_mask (params (status i32)) (returns i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let ordinary 0i32)
			(let flagged 128i32)
			(let a (call WCOREDUMP ordinary))
			(let b (call WCOREDUMP flagged))
			(if (i32:not-eq a (call fixture_core_mask ordinary)) (then (return 1i32)))
			(if (i32:not-eq b (call fixture_core_mask flagged)) (then (return 2i32)))
			(if (bool:or (i32:not-eqz a) (i32:not-eq b 128i32)) (then (return 3i32)))
			(return 42i32))))
