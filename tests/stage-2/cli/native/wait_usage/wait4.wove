(module wait4_usage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use wove-file "./support.wove" (only child_with_exit check_usage))
	(use c-header "<sys/wait.h>" (only (type Pid) wait4))
	(use c-header "<sys/resource.h>" (only (type ResourceUsage)))
	(use c-header "./oracle.h" (only fixture_seed_usage fixture_reaped fixture_exit_matches))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let child (call child_with_exit 53i32))
			(if (i32.ltz (int.convert i32 child)) (then (return 1i32)))
			(let-mut status -1i32)
			(let-mut usage (struct.new ResourceUsage))
			(call fixture_seed_usage (borrow-mut usage))
			(let without_status (i32.lt 1i32 (array.len args)))
			(let-mut observed (int.convert Pid 0i32))
			(if without_status
				(then (set observed (call wait4 child null 0i32 (borrow-mut usage))))
				(else (set observed (call wait4 child (borrow-mut status) 0i32 (borrow-mut usage)))))
			(let reaped (call fixture_reaped child))
			(if (bool.not (int.eq Pid observed child)) (then (return 2i32)))
			(if (bool.not reaped) (then (return 3i32)))
			(if (bool.not (call check_usage usage)) (then (return 4i32)))
			(if without_status
				(then
					(if (i32.not-eq status -1i32) (then (return 5i32))))
				(else
					(if (bool.not (call fixture_exit_matches status 53i32)) (then (return 6i32)))))
			(return 42i32))))
