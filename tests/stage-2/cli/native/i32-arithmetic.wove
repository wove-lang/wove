(module i32_arithmetic
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let pair (i32 24))
			(let bit (i32:mul pair (i32 10)))
			(let word (i32:div bit (i32 32)))
			(let round (i32 11))
			(let permutation (i32:rem round (i32 10)))
			(if (bool:not (bool:and (i32:eq bit (i32 240))
				(bool:and (i32:eq word (i32 7)) (i32:eq permutation (i32 1)))))
				(then (return (i32 1))))

			(let minimum (i32 -2147483648))
			(let maximum (i32 2147483647))
			(if (bool:not (bool:and
				(i32:eq (i32:mul maximum (i32 2)) (i32 -2))
				(bool:and (i32:eq (i32:mul minimum (i32 -1)) minimum)
					(i32:eq (i32:mul minimum minimum) (i32 0)))))
				(then (return (i32 2))))
			(if (bool:not (bool:and
				(i32:eq (i32:div (i32 -7) (i32 3)) (i32 -2))
				(bool:and (i32:eq (i32:div (i32 7) (i32 -3)) (i32 -2))
					(i32:eq (i32:div (i32 -7) (i32 -3)) (i32 2)))))
				(then (return (i32 3))))
			(if (bool:not (bool:and
				(i32:eq (i32:rem (i32 -7) (i32 3)) (i32 -1))
				(bool:and (i32:eq (i32:rem (i32 7) (i32 -3)) (i32 1))
					(i32:eq (i32:rem (i32 -7) (i32 -3)) (i32 -1)))))
				(then (return (i32 4))))
			(if (bool:not (bool:and
				(i32:eq (i32:rem minimum (i32 -1)) (i32 0))
				(bool:and (i32:eq (i32:div minimum (i32 1)) minimum)
					(i32:eq (i32:rem minimum (i32 3)) (i32 -2)))))
				(then (return (i32 5))))
			(return (i32 42)))))
