(module darwin_group_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Text (fields (present bool) (bytes (owned-array u8))))
	(struct Group (fields (gid u32) (name (owned-array u8)) (password Text)
		(members (owned-array (owned-array u8)))))
	(enum GroupResult (variants (Missing) (Found Group)))

	(use (:pragma (cfg (os "macos"))) c-header "<grp.h>"
		(only (type Gid) getgrnam getgrgid getgruuid getgrent setgrent endgrent))
	(use (:pragma (cfg (os "macos"))) c-header "<membership.h>" (only mbr_gid_to_uuid))
	(bridge c-header "<grp.h>" (:pragma (cfg (os "macos")))
		(type Gid (c-type "gid_t"))
		(snapshot Group
			(:doc "Copy Darwin's borrowed group record before another group lookup.")
			(c-type "struct group")
			(fields (gid gr_gid u32) (name gr_name cstr) (password gr_passwd (optional cstr)) (members gr_mem cstrs)))
		(fn getgrnam (:pragma (c_cstr name) (c_snapshot record Group (lifetime thread_local)))
			(params (name (shared-array u8))) (returns GroupResult))
		(fn getgrgid (:pragma (c_snapshot record Group (lifetime thread_local)))
			(params (gid Gid)) (returns GroupResult))
		(fn getgruuid (:pragma (c_array id 16) (c_snapshot record Group (lifetime thread_local)))
			(params (id (mut-array u8))) (returns GroupResult))
		(fn getgrent (:pragma (c_snapshot record Group (lifetime thread_local))) (params) (returns GroupResult))
		(fn setgrent (params) (returns void))
		(fn endgrent (params) (returns void)))
	(bridge c-header "<membership.h>" (:pragma (cfg (os "macos")))
		(use c-header "<grp.h>" (only (type Gid)))
		(fn mbr_gid_to_uuid (:pragma (c_array id 16))
			(params (gid Gid) (id (mut-array u8))) (returns i32)))

	(let wheel "wheel")
	(let star "*")
	(let root_member "root")
	(let absent "wove-636-intentionally-missing-1c65")

	(fn same (params (left (shared-array u8)) (right (shared-array u8))) (returns bool)
		(body
			(if (i32.not-eq (array.len left) (array.len right)) (then (return (bool false))))
			(for (let index byte) (borrow-shared left)
				(body
					(if (u8.not-eq byte (array.load right index)) (then (return (bool false))))))
			(return (bool true))))

	(fn check_wheel (params (group (shared-ref Group))) (returns bool)
		(body
			(if (u32.not-eqz (struct.get group gid)) (then (return (bool false))))
			(if (bool.not (call same (borrow-shared (struct.get group name)) (borrow-shared wheel)))
				(then (return (bool false))))
			(if (bool.not (struct.get (struct.get group password) present)) (then (return (bool false))))
			(if (bool.not (call same (borrow-shared (struct.get (struct.get group password) bytes)) (borrow-shared star)))
				(then (return (bool false))))
			(for (let member) (borrow-shared (struct.get group members))
				(body
					(if (call same (borrow-shared member) (borrow-shared root_member)) (then (return (bool true))))))
			(return (bool false))))

	(fn verify_lookup (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(match (call getgrnam (borrow-shared wheel))
				(case Missing (return 1i32))
				(case Found (let first)
					(match (call getgrnam (borrow-shared absent))
						(case Missing)
						(case Found (let _) (return 2i32)))
					(match (call getgrgid (int.convert Gid 1u32))
						(case Missing (return 3i32))
						(case Found (let daemon)
							(if (u32.not-eq (struct.get daemon gid) 1u32) (then (return 4i32)))))
					(if (bool.not (call check_wheel (borrow-shared first))) (then (return 5i32)))
					(let-mut uuid (array.alloc u8 16i32))
					(if (i32.not-eqz (call mbr_gid_to_uuid (int.convert Gid 0u32) (borrow-mut uuid)))
						(then (return 6i32)))
					(match (call getgruuid (borrow-mut uuid))
						(case Missing (return 7i32))
						(case Found (let uuid_group)
							(if (bool.not (call check_wheel (borrow-shared uuid_group))) (then (return 8i32)))))))
			(return 0i32)))

	(fn verify_enumeration (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(call setgrent)
			(match (call getgrent)
				(case Missing (return 9i32))
				(case Found (let first)
					(match (call getgrent)
						(case Missing (return 10i32))
						(case Found (let _)))
					(call endgrent)
					(call setgrent)
					(match (call getgrent)
						(case Missing (return 11i32))
						(case Found (let reset)
							(if (bool.not (call same (borrow-shared (struct.get first name)) (borrow-shared (struct.get reset name))))
								(then (return 12i32)))))
					(call endgrent)))
			(return 0i32)))

	(struct Job (fields (id u32)))

	(fn check_on_worker (:pragma (cfg (os "macos")))
		(params (job Job)) (returns (owned-array u8))
		(body
			(let id (struct.get job id))
			(match (call getgrgid (int.convert Gid id))
				(case Missing (return (array.alloc u8 0i32)))
				(case Found (let group)
					(if (u32.not-eq (struct.get group gid) id) (then (return (array.alloc u8 0i32))))
					(if (u32.eqz id)
						(then (if (bool.not (call check_wheel (borrow-shared group)))
							(then (return (array.alloc u8 0i32))))))
					(return (array.alloc u8 42i32))))))

	(fn verify_workers (:pragma (cfg (os "macos"))) (params) (returns bool)
		(body
			(match (call getgrnam (borrow-shared wheel))
				(case Missing (return (bool false)))
				(case Found (let saved)
					(let first (worker.spawn check_on_worker (struct.new Job (id 0u32))))
					(let second (worker.spawn check_on_worker (struct.new Job (id 1u32))))
					(let a (worker.join first))
					(let b (worker.join second))
					(return (bool.and (bool.and (i32.eq (array.len a) 42i32) (i32.eq (array.len b) 42i32))
						(call check_wheel (borrow-shared saved))))))))

	(fn platform_check (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let lookup (call verify_lookup))
			(if (i32.not-eqz lookup) (then (return lookup)))
			(let enumeration (call verify_enumeration))
			(if (i32.not-eqz enumeration) (then (return enumeration)))
			(if (bool.not (call verify_workers)) (then (return 13i32)))
			(return 42i32)))

	(fn platform_check (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:636"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call platform_check)))))
