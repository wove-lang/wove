(module native_record_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Text (fields (present bool) (bytes (owned-array u8))))
	(struct Ticket (fields (number u32) (name (owned-array u8)) (password Text)
		(members (owned-array (owned-array u8)))))
	(enum Result (variants (Found Ticket) (Missing)))

	(use c-header "./fixture.h"
		(only (as snapshot fixture_snapshot_alias)))
	(bridge c-header "./fixture.h"
		(snapshot Ticket
			(:doc "Copy the native record while its borrowed storage is live.")
			(c-type "struct fixture_record")
			(:doc "The mapping preserves field order.")
			(fields (number number u32) (name name cstr)
				(password password (optional cstr)) (members members cstrs))
			(:doc "The owned result survives the next native call."))
		(fn snapshot (:pragma (c_snapshot record Ticket (lifetime thread_local))) (c-name "fixture_snapshot")
			(params (input i32)) (returns Result)))

	(fn byte_count (params (bytes (shared-array u8))) (returns i32)
		(body (return (array:len bytes))))

	(fn verify (params) (returns i32)
		(body
			(match (call fixture_snapshot_alias 0i32)
				(case Missing (return 1i32))
				(case Found (let first)
					(match (call fixture_snapshot_alias 1i32)
						(case Missing (return 2i32))
						(case Found (let next)
							(if (bool:not (struct:get (struct:get next password) present)) (then (return 3i32)))
							(if (i32:not-eqz (call byte_count (borrow-shared (struct:get (struct:get next password) bytes)))) (then (return 4i32)))
							(let next_rows (borrow-shared (struct:get next members)))
							(if (i32:not-eqz (array:len next_rows)) (then (return 5i32)))))
					(match (call fixture_snapshot_alias -1i32)
						(case Missing)
						(case Found (let _) (return 6i32)))
					(if (struct:get (struct:get first password) present) (then (return 7i32)))
					(if (i32:not-eqz (call byte_count (borrow-shared (struct:get (struct:get first password) bytes)))) (then (return 8i32)))
					(if (u32:not-eq (struct:get first number) 42u32) (then (return 9i32)))
					(let first_name (borrow-shared (struct:get first name)))
					(if (i32:not-eq (array:len first_name) 3i32) (then (return 10i32)))
					(if (bool:or (u8:not-eq (array:load first_name 0i32) 97u8)
						(bool:or (u8:not-eq (array:load first_name 1i32) 98u8)
							(u8:not-eq (array:load first_name 2i32) 99u8)))
						(then (return 10i32)))
					(let rows (borrow-shared (struct:get first members)))
					(if (i32:not-eq (array:len rows) 3i32) (then (return 11i32)))
					(let left (borrow-shared (array:load rows 0i32)))
					(let middle (borrow-shared (array:load rows 1i32)))
					(let right (borrow-shared (array:load rows 2i32)))
					(if (i32:not-eq (array:len left) 2i32) (then (return 12i32)))
					(if (i32:not-eqz (array:len middle)) (then (return 13i32)))
					(if (i32:not-eq (array:len right) 3i32) (then (return 14i32)))
					(if (u8:not-eq (array:load left 0i32) 100u8) (then (return 15i32)))
					(if (u8:not-eq (array:load left 1i32) 101u8) (then (return 16i32)))
					(if (u8:not-eq (array:load right 0i32) 102u8) (then (return 17i32)))
					(if (u8:not-eq (array:load right 1i32) 103u8) (then (return 18i32)))
					(if (u8:not-eq (array:load right 2i32) 104u8) (then (return 19i32)))))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call verify)))))
