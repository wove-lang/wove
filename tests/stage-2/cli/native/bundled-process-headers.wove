(module bundled_process_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only open O_RDONLY (type (as Mode OpenMode))))
	(use c-header "<errno.h>" (only errno ECHILD))
	(use c-header "<sys/stat.h>" (only (type Stat) fstat S_ISDIR))
	(use c-header "<sys/wait.h>" (only (type Pid) waitpid))
	(use c-header "<unistd.h>" (only close))

	(let cwd ".")

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let fd (call open (borrow-shared (local cwd)) (local O_RDONLY) (int.convert OpenMode 0i32)))
			(if (i32.lt (local fd) 0i32) (then (return 1i32)))
			(let-mut info (struct.new Stat))
			(let queried (call fstat (local fd) (borrow-mut (local info))))
			(let closed (call close (local fd)))
			(if (bool.not (bool.and (i32.eq (local queried) 0i32) (i32.eq (local closed) 0i32)))
				(then (return 2i32)))
			(if (bool.not (call S_ISDIR (struct.get (local info) st_mode))) (then (return 3i32)))
			(let-mut status 0i32)
			(set (local errno) 0i32)
			(let waited (call waitpid (int.convert Pid -1i32) (borrow-mut (local status)) 0i32))
			(if (bool.and (int.eq Pid (local waited) (int.convert Pid -1i32)) (i32.eq (local errno) (local ECHILD)))
				(then (return 42i32)))
			(return 4i32)))
)
