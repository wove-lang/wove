(module optional_macro_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (value (as OPTIONAL_SAMPLE sample)) sample_reads))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.and (f32.eq sample 42.0f32) (i32.eq (call sample_reads) 1i32))
				(then (return 42i32)))
			(return 1i32))))
