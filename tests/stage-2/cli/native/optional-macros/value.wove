(module optional_macro_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only))
	(use c-header "./fixture.h" (only (value (as OPTIONAL_SAMPLE sample)) sample_reads))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (bool.and (f32.eq (local sample) 42.0f32) (i32.eq (call sample_reads) 1i32))
				(then (return 42i32)))
			(return 1i32))))
