(module optional_macro_unselected
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (value MAYBE_OTHER)))

	(bridge c-header "./fixture.h"
		(const MAYBE (:pragma (c_optional)) i32)
		(const MAYBE_OTHER i32))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return MAYBE_OTHER))))
