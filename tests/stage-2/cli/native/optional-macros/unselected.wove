(module optional_macro_unselected
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (value MAYBE_OTHER)))

	(bridge c-header "./fixture.h"
		(const (:pragma (c_optional)) MAYBE i32)
		(const MAYBE_OTHER i32))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (local MAYBE_OTHER)))))
