(module optional_macros
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only (value DIRECT) increment
		(value (as ALIAS alternate)) (value CONDITIONAL)))

	(bridge c-header "./fixture.h"
		(const DIRECT i32 (:pragma (c_optional)))
		(fn increment (:pragma (c_optional)) (params) (returns i32))
		(const ALIAS (:pragma (c_optional)) u32)
		(const CONDITIONAL (:pragma (c_optional)) i32))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32.add (i32.add DIRECT (i32.from-u32 alternate))
			(i32.add CONDITIONAL (call increment)))))))
