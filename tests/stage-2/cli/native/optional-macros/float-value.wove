(module optional_float_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as FLT_NORM_MAX maximum))))

	(bridge c-header "<float.h>"
		(let (:pragma (c_optional) (c_macro)) FLT_NORM_MAX f32))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (f32.eq (local maximum) (f32.from-bits 0x7f7fffffu32))
				(then (return 42i32)))
			(return 1i32))))
