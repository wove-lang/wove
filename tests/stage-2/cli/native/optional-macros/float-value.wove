(module optional_float_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<float.h>" (only (value (as FLT_NORM_MAX maximum))))

	(bridge c-header "<float.h>"
		(let FLT_NORM_MAX (:pragma (c_optional) (c_macro)) f32))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (f32:eq maximum (f32:from-bits 0x7f7fffffu32))
				(then (return 42i32)))
			(return 1i32))))
