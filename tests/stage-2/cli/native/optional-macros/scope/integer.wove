(module macro_integer_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./unrelated.h" (const UNRELATED_MARKER i32))
	(bridge c-header "./selected.h" (const (:pragma (c_optional)) SCOPE_NUMBER i32))
	(use c-header "./unrelated.h" (only (value UNRELATED_MARKER)))
	(use c-header "./selected.h" (only (value (as SCOPE_NUMBER renamed))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
