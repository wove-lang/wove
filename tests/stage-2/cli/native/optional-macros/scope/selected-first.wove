(module macro_selected_first
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./unrelated.h" (const UNRELATED_MARKER i32))
	(bridge c-header "./selected.h" (let (:pragma (c_optional) (c_macro)) SCOPE_READ f32))
	(use c-header "./selected.h" (only (value (as SCOPE_READ renamed))))
	(use c-header "./unrelated.h" (only (value UNRELATED_MARKER)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
