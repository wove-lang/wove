(module macro_declared_prerequisites
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./typed.h"
		(use c-header "./required.h" (only))
		(type Value (c-type "WoveMacroType")))
	(bridge c-header "./declared.h"
		(use c-header "./typed.h" (only (type Value)))
		(const SCOPE_NUMBER (:pragma (c_optional)) i32)
		(let SCOPE_READ (:pragma (c_optional) (c_macro)) f32))
	(bridge c-header "./selected.h" (const SELECTED_MARKER i32))
	(use c-header "./selected.h" (only (value SELECTED_MARKER)))
	(use c-header "./declared.h" (only (value (as SCOPE_NUMBER count)) (value (as SCOPE_READ sample))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq count 40i32) (then (return 1i32)))
			(if (u32.not-eq (f32.to-bits sample) 0x3f000000u32) (then (return 2i32)))
			(return (i32.add count 2i32)))))
