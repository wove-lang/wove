(module half_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./half.h" (only (type HalfPacket) half_twice half_store))

	(bridge c-header "./half.h"
		(struct HalfPacket (c-type "HalfPacket") (fields (value f16)))
		(fn half_twice (:pragma (c_optional)) (params (value f16)) (returns f16))
		(fn half_store (params (out (mut-ref HalfPacket)) (value f16)) (returns i32)))

	(struct Half (fields (value f16)))
	(let midpoint 1.000488281250000000001f16)

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (struct:new Half (value midpoint)))
			(if (u16:not-eq (f16:to-bits (struct:get first value)) 0x3c01u16) (then (return 1i32)))
			(if (u16:not-eq (f16:to-bits (f16 -0)) 0x8000u16) (then (return 2i32)))
			(if (u16:not-eq (f16:to-bits 5.9604644775390625e-8f16) 1u16) (then (return 3i32)))
			(let nan (f16:from-bits 0x7e03u16))
			(if (u16:not-eq (f16:to-bits nan) 0x7e03u16) (then (return 4i32)))
			(if (bool:not (f16:not-eq nan nan)) (then (return 5i32)))
			(if (f16:not-eq (f16:div (f16:mul (f16:sub 7f16 1f16) 2f16) 4f16) (f16:add 1f16 2f16))
				(then (return 6i32)))
			(if (bool:not (f16:lt (f16:neg 1f16) 0f16)) (then (return 7i32)))
			(if (bool:not (f16:ge (f16:from-u16 65504u16) (f16 65504))) (then (return 8i32)))
			(if (f32:not-eq (f32:from-f16 (f16:from-f64 1.5f64)) 1.5f32) (then (return 9i32)))
			(if (f64:not-eq (f64:from-f16 (f16:from-f32 -2.5f32)) -2.5f64) (then (return 10i32)))
			(if (u16:not-eq (f16:to-bits (f16:from-f64 (f64:from-bits 0x7ff0000000000000u64))) 0x7c00u16)
				(then (return 11i32)))
			(if (u8:not-eq (u8:from-f16 1.875f16) 1u8) (then (return 12i32)))
			(let-mut packet (struct:new HalfPacket))
			(if (i32:not-eq (call half_store (borrow-mut packet) (call half_twice (f16:from-i32 21i32))) 0i32)
				(then (return 13i32)))
			(return (i32:from-f16 (struct:get packet value))))))
