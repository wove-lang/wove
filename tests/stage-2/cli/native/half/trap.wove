(module half_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (i32.eq (array.len (local args)) 1i32)
				(then (return (i32.from-f16 (f16.from-f64 -65505f64)))))
			(if (i32.eq (array.len (local args)) 2i32)
				(then (return (i32.from-f16 (f16.from-u16 65505u16)))))
			(return (int.convert i32 (u8.from-f16 256f16))))))
