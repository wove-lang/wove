(module half_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eq (i32.dec (array.len args)) 1i32)
				(then (return (i32.from-f16 (f16.from-f64 -65505f64)))))
			(if (i32.eq (i32.dec (array.len args)) 2i32)
				(then (return (i32.from-f16 (f16.from-u16 65505u16)))))
			(return (int.convert i32 (u8.from-f16 256f16))))))
