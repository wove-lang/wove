(module profile_field_common
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "./native.h" (only (type ProfileRecord) fixture_seed fixture_layout))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (struct:new ProfileRecord))
			(call fixture_seed (borrow-mut value))
			(if (bool:not (call fixture_layout (borrow-shared value))) (then (return 1i32)))
			(if (u32:not-eq value/prefix 42u32) (then (return 2i32)))
			(if (u64:not-eq value/tail 0x123456789abcdef0u64) (then (return 3i32)))
			(return 42i32))))
