(module profile_field_selected
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "./native.h" (only (type ProfileRecord) fixture_seed))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (struct:new ProfileRecord (counter 42i32)))
			(call fixture_seed (borrow-mut value))
			(array:set value/label 0i32 42u8)
			(if (i32:not-eq value/counter 42i32) (then (return 1i32)))
			(if (i32:not-eq (array:len value/label) 8i32) (then (return 2i32)))
			(return (int:convert i32 (array:get value/label 0i32))))))
