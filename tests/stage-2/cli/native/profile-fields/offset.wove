(module profile_field_offset
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./project.wove" (only))
	(use c-header "./native.h" (only (type ProfileRecord) fixture_offset))
	(use c-header "<stddef.h>" (only offsetof))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (int:convert i32 (call offsetof (c-type ProfileRecord) (c-member label))))
			(if (i32:not-eq value (call fixture_offset)) (then (return 1i32)))
			(return 42i32))))
