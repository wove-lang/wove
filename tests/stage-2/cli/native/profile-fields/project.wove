(module profile_field_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./native.h"
		(struct ProfileRecord (c-type "ProfileRecord")
			(fields (prefix u32) (counter (:pragma (c_optional)) i32)
				(label (:pragma (c_optional)) (array char 8)) (tail u64)))
		(fn fixture_seed (params (value (mut-ref ProfileRecord))) (returns void))
		(fn fixture_layout (:pragma (c_macro))
			(params (value (shared-ref ProfileRecord))) (returns bool))
		(fn fixture_offset (params) (returns i32))))
