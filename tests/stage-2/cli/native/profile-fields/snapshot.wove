(module profile_field_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./snapshot.h" (only (type ProfileSnapshot) fixture_seed_snapshot copy_snapshot))

	(bridge c-header "./snapshot.h"
		(struct ProfileSnapshot (c-type "ProfileSnapshot")
			(fields (extent (:pragma (c_optional)) u32) (text (:pragma (c_optional)) (array char 4))))
		(fn fixture_seed_snapshot (params (value (mut-ref ProfileSnapshot))) (returns void))
		(fn copy_snapshot
			(:pragma (c_snapshot cstr (field text) (extent extent) (from value)))
			(params (value (shared-ref ProfileSnapshot)))
			(returns (optional (owned-array u8)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (struct:new ProfileSnapshot))
			(call fixture_seed_snapshot (borrow-mut value))
			(let copy (call copy_snapshot (borrow-shared value)))
			(if (owner:is-null copy) (then (return 1i32)))
			(let text (move (optional:unwrap copy)))
			(if (i32:not-eq text.len 1i32) (then (return 2i32)))
			(if (u8:not-eq (text.get 0i32) 65u8) (then (return 3i32)))
			(return 42i32))))
