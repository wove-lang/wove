	(use wove-file "./project.wove" (only))
	(use c-header "./native.h" (only (type ProfileRecord)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let value (struct:new ProfileRecord (counter 42i32)))
			(return 42i32))))
