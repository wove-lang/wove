(module owned_return_unmoved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn create
		(params)
		(returns (owned-array u8))
		(body
			(let data (array.alloc u8 (i32 1)))
			(return (local data))))

	(fn main
		(params)
		(returns i32)
		(body (return (i32 0)))))
