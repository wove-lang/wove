(module owned_return_unmoved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn create
		(params)
		(returns (owned-array u8))
		(body
			(let data (array.alloc u8 (i32 1)))
			(return data)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return (i32 0)))))
