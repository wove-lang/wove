(module darwin_file_security_properties
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type FileProperty) (type FileSecurity) (type Mode)
			filesec_init filesec_query_property filesec_unset_property
			(value FILESEC_OWNER) (value FILESEC_GROUP) (value FILESEC_UUID) (value FILESEC_GUID)
			(value FILESEC_MODE) (value FILESEC_ACL) (value FILESEC_GRPUUID)))
	(use (:pragma (cfg (os "macos"))) c-header "./filesec-properties.h" (only seed_mode))
	(bridge c-header "./filesec-properties.h" (:pragma (cfg (os "macos")))
		(use c-header "<fcntl.h>" (only (type FileSecurity) (type Mode)))
		(fn seed_mode
			(params (security (mut-ref FileSecurity)) (mode Mode))
			(returns i32)))


	(fn check_properties (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let properties (array.new (array i32 7)
				(int.convert i32 FILESEC_OWNER) (int.convert i32 FILESEC_GROUP)
				(int.convert i32 FILESEC_UUID) (int.convert i32 FILESEC_GUID)
				(int.convert i32 FILESEC_MODE) (int.convert i32 FILESEC_ACL)
				(int.convert i32 FILESEC_GRPUUID)))
			(for (let selector) (borrow-shared properties)
				(body
					(let property (int.convert FileProperty selector))
					(let-mut empty -1i32)
					(if (i32.not-eqz (call filesec_query_property
							(borrow-shared security) property (borrow-mut empty)))
						(then (return 2i32)))
					(if (i32.not-eqz empty) (then (return 3i32)))))
			(if (int.not-eq FileProperty FILESEC_UUID FILESEC_GUID) (then (return 4i32)))
			(if (i32.not-eqz (call seed_mode (borrow-mut security) (int.convert Mode 384i32)))
				(then (return 5i32)))
			(let-mut present 0i32)
			(if (i32.not-eqz (call filesec_query_property
					(borrow-shared security) FILESEC_MODE (borrow-mut present)))
				(then (return 6i32)))
			(if (i32.eqz present) (then (return 7i32)))
			(if (i32.not-eqz (call filesec_unset_property (borrow-mut security) FILESEC_MODE))
				(then (return 8i32)))
			(if (i32.not-eqz (call filesec_query_property
					(borrow-shared security) FILESEC_MODE (borrow-mut present)))
				(then (return 9i32)))
			(if (i32.not-eqz present) (then (return 10i32)))
			(return 42i32)))

	(fn check_properties (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_properties)))))
