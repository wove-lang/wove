(module darwin_fcntl_requests
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type Mode) (type Offset) (type Short) (type Pid) (type Lock)
			(type ReadAdvice) (type FileHole) (type ActiveFileTrim) (type SpeculativeRead)
			(type FileSignatureInfo) (type FileSignatureSupplement)
			open fcntl_rdadvise fcntl_punchhole fcntl_trim_active_file fcntl_speculative_read
			fcntl_setlk fcntl_getlkpid fcntl_getsigsinfo fcntl_addfilesuppl
			(value O_RDONLY) (value O_RDWR) (value F_WRLCK) (value F_UNLCK)
			(value GETSIGSINFO_PLATFORM_BINARY)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>"
		(only (type (as Offset SeekOffset)) (type Size) close write pread lseek fsync
			getpid fork _exit (value SEEK_SET) (value SEEK_END)))
	(use (:pragma (cfg (os "macos"))) c-header "<sys/wait.h>"
		(only (type (as Pid WaitPid)) waitpid WIFEXITED WEXITSTATUS))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>"
		(only errno (value EBADF) (value EINVAL) (value EACCES) (value ENOENT)
			(value ENOTSUP) (value EOPNOTSUPP) (value ENOSYS)))

	(let filename "sample")
	(let executable "./out")

	(fn unsupported (:pragma (cfg (os "macos"))) (params (failure i32)) (returns bool)
		(body (return (bool:or (i32:eq failure ENOTSUP)
			(bool:or (i32:eq failure EOPNOTSUPP) (i32:eq failure ENOSYS))))))

	(fn prepare_file (:pragma (cfg (os "macos"))) (params (fd i32)) (returns bool)
		(body
			(let data (array:repeat (array u8 16384) 53u8))
			(let count (int:convert Size 16384i32))
			(if (i64:not-eq (int:convert i64 (call write fd (borrow-shared data) count)) 16384i64)
				(then (return (bool false))))
			(return (i32:eqz (call fsync fd)))))

	(fn test_read_advice (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let region (struct:new ReadAdvice (ra_offset (int:convert Offset 4096i64)) (ra_count 1024i32)))
			(let invalid (struct:new ReadAdvice (ra_offset (int:convert Offset -1i64)) (ra_count 1024i32)))
			(if (i32:not-eq (call fcntl_rdadvise fd (borrow-shared invalid)) -1i32)
				(then (return 3i32)))
			(if (i32:not-eq errno EINVAL) (then (return 4i32)))
			(let result (call fcntl_rdadvise fd (borrow-shared region)))
			(if (bool:and (i32:not-eqz result) (bool:not (call unsupported errno)))
				(then (return 5i32)))
			(return 0i32)))

	(fn test_speculative_read (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let region (struct:new SpeculativeRead (fsr_offset (int:convert Offset 4096i64))
				(fsr_length (int:convert Offset 1024i64))))
			(let invalid (struct:new SpeculativeRead (fsr_offset (int:convert Offset 4096i64))
				(fsr_length (int:convert Offset -1i64))))
			(if (i32:not-eq (call fcntl_speculative_read fd (borrow-shared invalid)) -1i32)
				(then (return 6i32)))
			(if (i32:not-eq errno EINVAL) (then (return 7i32)))
			(let result (call fcntl_speculative_read fd (borrow-shared region)))
			(if (bool:and (i32:not-eqz result) (bool:not (call unsupported errno)))
				(then (return 8i32)))
			(return 0i32)))

	(fn test_hole (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let range (struct:new FileHole (fp_offset (int:convert Offset 4096i64))
				(fp_length (int:convert Offset 4096i64))))
			(if (i32:not-eq (call fcntl_punchhole -1i32 (borrow-shared range)) -1i32)
				(then (return 9i32)))
			(if (i32:not-eq errno EBADF) (then (return 10i32)))
			(let result (call fcntl_punchhole fd (borrow-shared range)))
			(if (i32:not-eqz result)
				(then
					(if (call unsupported errno) (then (return 0i32)))
					(return 11i32)))
			(let-mut data (array:repeat (array u8 4098) 165u8))
			(let count (call pread fd (borrow-mut data) (int:convert Size 4098i32)
				(int:convert SeekOffset 4095i64)))
			(if (i64:not-eq (int:convert i64 count) 4098i64) (then (return 12i32)))
			(if (bool:or (u8:not-eq (array:load data 0i32) 53u8)
				(u8:not-eq (array:load data 4097i32) 53u8)) (then (return 13i32)))
			(let-mut i 1i32)
			(while (i32:lt i 4097i32)
				(body
					(if (u8:not-eq (array:load data i) 0u8) (then (return 14i32)))
					(set i (i32:inc i))))
			(let size (call lseek fd (int:convert SeekOffset 0i64) SEEK_END))
			(if (i64:not-eq (int:convert i64 size) 16384i64) (then (return 15i32)))
			(return 0i32)))

	(fn test_trim (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let range (struct:new ActiveFileTrim (fta_offset (int:convert Offset 4096i64))
				(fta_length (int:convert Offset 4096i64))))
			(let result (call fcntl_trim_active_file fd (borrow-shared range)))
			(if (i32:eqz result) (then (return 0i32)))
			(if (i32:not-eq result -1i32) (then (return 16i32)))
			(let failure errno)
			(if (bool:or (i32:eq failure EACCES) (call unsupported failure))
				(then (return 0i32)))
			(return 17i32)))

	(fn lock_range (:pragma (cfg (os "macos"))) (params (pid Pid)) (returns Lock)
		(body (return (struct:new Lock (l_type (int:convert Short F_WRLCK))
			(l_whence (int:convert Short SEEK_SET)) (l_start (int:convert Offset 4096i64))
			(l_len (int:convert Offset 1024i64)) (l_pid pid)))))

	(fn check_lock_filter (:pragma (cfg (os "macos"))) (params (fd i32) (parent Pid)) (returns i32)
		(body
			(let-mut query (call lock_range parent))
			(if (i32:not-eqz (call fcntl_getlkpid fd (borrow-mut query))) (then (return 18i32)))
			(if (int:not-eq Short (struct:get query l_type) (int:convert Short F_WRLCK))
				(then (return 19i32)))
			(if (int:not-eq Pid (struct:get query l_pid) parent) (then (return 20i32)))
			(let-mut unmatched (call lock_range (int:convert Pid (call getpid))))
			(if (i32:not-eqz (call fcntl_getlkpid fd (borrow-mut unmatched))) (then (return 21i32)))
			(if (int:not-eq Short (struct:get unmatched l_type) (int:convert Short F_UNLCK))
				(then (return 22i32)))
			(return 0i32)))

	(fn test_lock_pid (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let parent (int:convert Pid (call getpid)))
			(let-mut held (call lock_range (int:convert Pid 0i32)))
			(if (i32:not-eqz (call fcntl_setlk fd (borrow-mut held))) (then (return 23i32)))
			(let child (int:convert i32 (call fork)))
			(if (i32:ltz child) (then (return 24i32)))
			(if (i32:eqz child)
				(then
					(call _exit (call check_lock_filter fd parent))
					(return 25i32)))
			(let-mut status 0i32)
			(let waited (call waitpid (int:convert WaitPid child) (borrow-mut status) 0i32))
			(if (i32:not-eq (int:convert i32 waited) child) (then (return 26i32)))
			(if (bool:not (call WIFEXITED status)) (then (return 27i32)))
			(return (call WEXITSTATUS status))))

	(fn test_signature_info (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let selector GETSIGSINFO_PLATFORM_BINARY)
			(let-mut query (struct:new FileSignatureInfo (fg_info_request selector) (fg_sig_is_platform -42i32)))
			(if (i32:not-eq (call fcntl_getsigsinfo fd (borrow-mut query)) -1i32) (then (return 28i32)))
			(if (i32:not-eq errno ENOENT) (then (return 29i32)))
			(if (i32:not-eq (struct:get query fg_sig_is_platform) -42i32) (then (return 30i32)))
			(let image (call open (borrow-shared executable) O_RDONLY (int:convert Mode 0i32)))
			(if (i32:ltz image) (then (return 31i32)))
			(let status (call fcntl_getsigsinfo image (borrow-mut query)))
			(let failure errno)
			(let closed (call close image))
			(if (i32:not-eqz closed) (then (return 32i32)))
			(if (bool:and (i32:eq status -1i32) (i32:eq failure ENOENT))
				(then (return 0i32)))
			(if (i32:not-eqz status) (then (return 33i32)))
			(let platform (struct:get query fg_sig_is_platform))
			(if (bool:and (i32:not-eq platform 0i32) (i32:not-eq platform 1i32))
				(then (return 34i32)))
			(if (i32:not-eq (struct:get query fg_info_request) selector) (then (return 35i32)))
			(return 0i32)))

	(fn test_signature_supplement (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let supplement (struct:new FileSignatureSupplement (fs_blob_start (int:convert Offset 4096i64))
				(fs_blob_size (int:convert Size 1024i32)) (fs_orig_fd -1i32)))
			(if (i32:not-eq (call fcntl_addfilesuppl fd (borrow-shared supplement)) -1i32)
				(then (return 36i32)))
			(let failure errno)
			(if (bool:or (i32:eq failure EBADF) (i32:eq failure EINVAL))
				(then (return 0i32)))
			(return 37i32)))

	(fn check_request (:pragma (cfg (os "macos"))) (params (fd i32) (mode i32)) (returns i32)
		(body
			(if (i32:eq mode 4i32) (then (return (call test_lock_pid fd))))
			(if (i32:eq mode 5i32) (then (return (call test_signature_info fd))))
			(if (i32:eq mode 6i32) (then (return (call test_signature_supplement fd))))
			(if (bool:not (call prepare_file fd)) (then (return 2i32)))
			(if (i32:eqz mode) (then (return (call test_read_advice fd))))
			(if (i32:eq mode 1i32) (then (return (call test_speculative_read fd))))
			(if (i32:eq mode 2i32) (then (return (call test_hole fd))))
			(return (call test_trim fd))))

	(fn check_platform (:pragma (cfg (os "macos"))) (params (mode i32)) (returns i32)
		(body
			(let fd (call open (borrow-shared filename) O_RDWR (int:convert Mode 0i32)))
			(if (i32:ltz fd) (then (return 1i32)))
			(let result (call check_request fd mode))
			(let closed (call close fd))
			(if (i32:not-eqz closed) (then (return 38i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params (mode i32)) (returns i32)
		(body (return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (i32:dec (array:len args)))
			(let result (call check_platform mode))
			(if (i32:not-eqz result) (then (return result)))
			(return (i32:add 42i32 mode)))))
