(module strict_fcntl_getfd
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only (type Mode) (value O_RDONLY) open fcntl_getfd))
	(use c-header "<unistd.h>" (only close))

	(let sample "sample")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let fd (call open (borrow-shared sample) O_RDONLY (int:convert Mode 0i32)))
			(if (i32:ltz fd) (then (return 1i32)))
			(let flags (call fcntl_getfd fd))
			(if (i32:not-eqz (call close fd)) (then (return 2i32)))
			(if (i32:ltz flags) (then (return 3i32)))
			(return 42i32))))
