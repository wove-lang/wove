(module common_fcntl_constants
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only
		(value F_GETLEASE) (value F_OFD_GETLK) (value F_OFD_SETLK)
		(value F_OFD_SETLKW) (value F_SETLEASE) (value LOCK_EX)
		(value LOCK_NB) (value LOCK_SH) (value LOCK_UN)
		(value O_ASYNC) (value O_FSYNC) (value O_NDELAY)))


	(fn check_constants (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(if (i32:not-eq F_GETLEASE 107i32) (then (return 1i32)))
			(if (i32:not-eq F_OFD_GETLK 92i32) (then (return 2i32)))
			(if (i32:not-eq F_OFD_SETLK 90i32) (then (return 3i32)))
			(if (i32:not-eq F_OFD_SETLKW 91i32) (then (return 4i32)))
			(if (i32:not-eq F_SETLEASE 106i32) (then (return 5i32)))
			(if (i32:not-eq LOCK_EX 2i32) (then (return 6i32)))
			(if (i32:not-eq LOCK_NB 4i32) (then (return 7i32)))
			(if (i32:not-eq LOCK_SH 1i32) (then (return 8i32)))
			(if (i32:not-eq LOCK_UN 8i32) (then (return 9i32)))
			(if (i32:not-eq O_ASYNC 64i32) (then (return 10i32)))
			(if (i32:not-eq O_FSYNC 128i32) (then (return 11i32)))
			(if (i32:not-eq O_NDELAY 4i32) (then (return 12i32)))
			(return 42i32)))

	(fn check_constants (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32:not-eq F_GETLEASE 1025i32) (then (return 1i32)))
			(if (i32:not-eq F_OFD_GETLK 36i32) (then (return 2i32)))
			(if (i32:not-eq F_OFD_SETLK 37i32) (then (return 3i32)))
			(if (i32:not-eq F_OFD_SETLKW 38i32) (then (return 4i32)))
			(if (i32:not-eq F_SETLEASE 1024i32) (then (return 5i32)))
			(if (i32:not-eq LOCK_EX 2i32) (then (return 6i32)))
			(if (i32:not-eq LOCK_NB 4i32) (then (return 7i32)))
			(if (i32:not-eq LOCK_SH 1i32) (then (return 8i32)))
			(if (i32:not-eq LOCK_UN 8i32) (then (return 9i32)))
			(if (i32:not-eq O_ASYNC 8192i32) (then (return 10i32)))
			(if (i32:not-eq O_FSYNC 1052672i32) (then (return 11i32)))
			(if (i32:not-eq O_NDELAY 2048i32) (then (return 12i32)))
			(return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_constants)))))
