(module darwin_fcntl_timed_locks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type Lock) (type TimedLock) (type Mode) (type Short) (type Offset)
			open fcntl_setlk fcntl_ofd_setlk fcntl_setlkwtimeout fcntl_ofd_setlkwtimeout
			(value O_RDWR) (value F_WRLCK) (value F_UNLCK)))
	(use (:pragma (cfg (os "macos"))) c-header "<time.h>" (only (type Stamp) (type Long)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only close (value SEEK_SET)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ETIMEDOUT)))

	(let filename "sample")

	(fn set_lock (:pragma (cfg (os "macos")))
		(params (fd i32) (ofd bool) (payload Lock)) (returns i32)
		(body
			(let-mut request payload)
			(if ofd
				(then (return (call fcntl_ofd_setlk fd (borrow-mut request)))))
			(return (call fcntl_setlk fd (borrow-mut request)))))

	(fn timed_lock (:pragma (cfg (os "macos")))
		(params (fd i32) (ofd bool) (payload TimedLock)) (returns i32)
		(body
			(let-mut request payload)
			(if ofd
				(then (return (call fcntl_ofd_setlkwtimeout fd (borrow-mut request)))))
			(return (call fcntl_setlkwtimeout fd (borrow-mut request)))))

	(fn verify_wait (:pragma (cfg (os "macos")))
		(params (first i32) (second i32) (ofd bool)) (returns i32)
		(body
			(let origin (int:convert Short SEEK_SET))
			(let extent (int:convert Offset 2i32))
			(let requested (struct:new Lock
				(l_type (int:convert Short F_WRLCK)) (l_whence origin) (l_len extent)))
			(let released (struct:new Lock
				(l_type (int:convert Short F_UNLCK)) (l_whence origin) (l_len extent)))
			(let pending (struct:new TimedLock (fl requested)
				(timeout (struct:new Stamp (tv_nsec (int:convert Long 20000000i32))))))
			(if (i32:not-eqz (call set_lock first (bool:not ofd) requested))
				(then (return 3i32)))
			(if (i32:not-eq (call timed_lock second ofd pending) -1i32)
				(then (return 4i32)))
			(if (i32:not-eq errno ETIMEDOUT) (then (return 5i32)))
			(if (i32:not-eqz (call set_lock first (bool:not ofd) released))
				(then (return 6i32)))
			(if (i32:not-eqz (call timed_lock second ofd pending))
				(then (return 7i32)))
			(if (i32:not-eqz (call set_lock second ofd released))
				(then (return 8i32)))
			(return 0i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params (ofd bool)) (returns i32)
		(body
			(let mode (int:convert Mode 0i32))
			(let first (call open (borrow-shared filename) O_RDWR mode))
			(if (i32:ltz first) (then (return 1i32)))
			(let second (call open (borrow-shared filename) O_RDWR mode))
			(if (i32:ltz second)
				(then
					(let closed (call close first))
					(return 2i32)))
			(let result (call verify_wait first second ofd))
			(let first_closed (call close first))
			(let second_closed (call close second))
			(if (i32:not-eqz (i32:or first_closed second_closed)) (then (return 9i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params (ofd bool)) (returns i32)
		(body (return 0i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let ofd (i32:gtz (i32:dec (array:len args))))
			(let status (call check_platform ofd))
			(if (i32:not-eqz status) (then (return status)))
			(if ofd (then (return 43i32)))
			(return 42i32))))
