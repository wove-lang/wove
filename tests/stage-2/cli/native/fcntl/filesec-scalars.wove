(module darwin_filesec_scalars
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type Mode) filesec_init filesec_unset_property
			filesec_get_owner filesec_set_owner filesec_get_group filesec_set_group filesec_get_mode filesec_set_mode
			(value FILESEC_OWNER) (value FILESEC_GROUP) (value FILESEC_MODE)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only (type Uid) (type Gid)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ENOENT)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_owner (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let empty (int.convert Uid 55i32))
			(let-mut output empty)
			(if (i32.not-eq (call filesec_get_owner (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 2i32)))
			(if (i32.not-eq errno ENOENT) (then (return 3i32)))
			(if (int.not-eq Uid output empty) (then (return 4i32)))
			(let expected (int.convert Uid 501i32))
			(let-mut input expected)
			(if (i32.not-eqz (call filesec_set_owner (borrow-mut security) (borrow-shared input)))
				(then (return 5i32)))
			(set input empty)
			(if (i32.not-eqz (call filesec_get_owner (borrow-shared security) (borrow-mut output)))
				(then (return 6i32)))
			(if (int.not-eq Uid output expected) (then (return 7i32)))
			(if (i32.not-eqz (call filesec_unset_property (borrow-mut security) FILESEC_OWNER))
				(then (return 8i32)))
			(if (i32.not-eq (call filesec_get_owner (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 9i32)))
			(if (i32.not-eq errno ENOENT) (then (return 10i32)))
			(if (int.not-eq Uid output expected) (then (return 11i32)))
			(return 0i32)))

	(fn check_group (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let empty (int.convert Gid 55i32))
			(let-mut output empty)
			(if (i32.not-eq (call filesec_get_group (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 2i32)))
			(if (i32.not-eq errno ENOENT) (then (return 3i32)))
			(if (int.not-eq Gid output empty) (then (return 4i32)))
			(let expected (int.convert Gid 20i32))
			(let-mut input expected)
			(if (i32.not-eqz (call filesec_set_group (borrow-mut security) (borrow-shared input)))
				(then (return 5i32)))
			(set input empty)
			(if (i32.not-eqz (call filesec_get_group (borrow-shared security) (borrow-mut output)))
				(then (return 6i32)))
			(if (int.not-eq Gid output expected) (then (return 7i32)))
			(if (i32.not-eqz (call filesec_unset_property (borrow-mut security) FILESEC_GROUP))
				(then (return 8i32)))
			(if (i32.not-eq (call filesec_get_group (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 9i32)))
			(if (i32.not-eq errno ENOENT) (then (return 10i32)))
			(if (int.not-eq Gid output expected) (then (return 11i32)))
			(return 0i32)))

	(fn check_mode (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let empty (int.convert Mode 55i32))
			(let-mut output empty)
			(if (i32.not-eq (call filesec_get_mode (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 2i32)))
			(if (i32.not-eq errno ENOENT) (then (return 3i32)))
			(if (int.not-eq Mode output empty) (then (return 4i32)))
			(let expected (int.convert Mode 384i32))
			(let-mut input expected)
			(if (i32.not-eqz (call filesec_set_mode (borrow-mut security) (borrow-shared input)))
				(then (return 5i32)))
			(set input empty)
			(if (i32.not-eqz (call filesec_get_mode (borrow-shared security) (borrow-mut output)))
				(then (return 6i32)))
			(if (int.not-eq Mode output expected) (then (return 7i32)))
			(if (i32.not-eqz (call filesec_unset_property (borrow-mut security) FILESEC_MODE))
				(then (return 8i32)))
			(if (i32.not-eq (call filesec_get_mode (borrow-shared security) (borrow-mut output)) -1i32)
				(then (return 9i32)))
			(if (i32.not-eq errno ENOENT) (then (return 10i32)))
			(if (int.not-eq Mode output expected) (then (return 11i32)))
			(return 0i32)))

	(fn check_property (:pragma (cfg (os "macos"))) (params (selected i32)) (returns i32)
		(body
			(if (i32.eqz selected) (then (return (call check_owner))))
			(if (i32.eq selected 1i32) (then (return (call check_group))))
			(return (call check_mode))))

	(fn check_property (:pragma (cfg (not (os "macos")))) (params (selected i32)) (returns i32)
		(body (return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:549"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let selected (array.len args))
			(let status (call check_property selected))
			(if (i32.not-eqz status) (then (return status)))
			(return (i32.add 42i32 selected)))))
