(module darwin_fcntl_files
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only filesec_init filesec_dup filesec_free openx_np openx_plain flock
			(value O_RDONLY) (value LOCK_EX) (value LOCK_NB) (value LOCK_UN)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value EWOULDBLOCK)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only close))

	(let fixture "sample")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_locks (:pragma (cfg (os "macos")))
		(params (first i32) (second i32)) (returns i32)
		(body
			(let lock (i32.or LOCK_EX LOCK_NB))
			(if (i32.not-eqz (call flock first lock)) (then (return 5i32)))
			(if (i32.not-eq (call flock second lock) -1i32) (then (return 6i32)))
			(if (i32.not-eq errno EWOULDBLOCK) (then (return 7i32)))
			(if (i32.not-eqz (call flock first LOCK_UN)) (then (return 8i32)))
			(if (i32.not-eqz (call flock second lock)) (then (return 9i32)))
			(if (i32.not-eqz (call flock second LOCK_UN)) (then (return 10i32)))
			(return 42i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let original (call filesec_init))
			(if (owner.is-null original) (then (return 1i32)))
			(let copied (call filesec_dup (borrow-shared original)))
			(if (owner.is-null copied) (then (return 2i32)))
			(call filesec_free (move original))
			(let first (call openx_np (borrow-shared fixture) O_RDONLY (borrow-shared copied)))
			(if (i32.ltz first) (then (return 3i32)))
			(let second (call openx_plain (borrow-shared fixture) O_RDONLY))
			(if (i32.ltz second)
				(then
					(let closed (call close first))
					(return 4i32)))
			(let checked (call check_locks first second))
			(let first_closed (call close first))
			(let second_closed (call close second))
			(if (i32.not-eqz (i32.or first_closed second_closed)) (then (return 11i32)))
			(return checked)))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call check_platform)))))
