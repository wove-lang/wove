(module linux_fcntl_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<fcntl.h>"
		(only (type SignalOwner) (type OwnerKind) (type (as Pid SignalPid))
			fcntl_getown_ex fcntl_setown_ex
			(value F_OWNER_TID) (value F_OWNER_PID) (value F_OWNER_PGRP) (value F_OWNER_GID)))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only pipe close getpid getpgrp))


	(fn matches_owner (:pragma (cfg (os "linux")))
		(params (fd i32) (kind OwnerKind) (pid SignalPid)) (returns bool)
		(body
			(let request (struct:new SignalOwner (type kind) (pid pid)))
			(if (i32:not-eqz (call fcntl_setown_ex fd (borrow-shared request)))
				(then (return (bool false))))
			(let-mut current (struct:new SignalOwner))
			(if (i32:not-eqz (call fcntl_getown_ex fd (borrow-mut current)))
				(then (return (bool false))))
			(return (bool:and (int:eq OwnerKind kind (struct:get current type))
				(int:eq SignalPid pid (struct:get current pid))))))

	(fn check_owner_modes (:pragma (cfg (os "linux"))) (params (fd i32)) (returns i32)
		(body
			(let pid (int:convert SignalPid (call getpid)))
			(let group (int:convert SignalPid (call getpgrp)))
			(if (bool:not (int:eq OwnerKind F_OWNER_GID F_OWNER_PGRP))
				(then (return 2i32)))
			(if (bool:not (call matches_owner fd F_OWNER_PID pid))
				(then (return 3i32)))
			(if (bool:not (call matches_owner fd F_OWNER_TID pid))
				(then (return 4i32)))
			(if (bool:not (call matches_owner fd F_OWNER_PGRP group))
				(then (return 5i32)))
			(return 42i32)))

	(fn check_platform (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let-mut descriptors (array:alloc i32 2i32))
			(if (i32:not-eqz (call pipe (borrow-mut descriptors))) (then (return 1i32)))
			(let writer (array:get descriptors 1i32))
			(let result (call check_owner_modes writer))
			(let reader_closed (call close (array:get descriptors 0i32)))
			(let writer_closed (call close writer))
			(if (i32:not-eqz (i32:or reader_closed writer_closed)) (then (return 6i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_platform)))))
