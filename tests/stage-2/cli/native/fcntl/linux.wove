(module glibc_fcntl_constants
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<fcntl.h>" (only
		(value AT_EMPTY_PATH) (value AT_HANDLE_FID) (value AT_NO_AUTOMOUNT) (value AT_RECURSIVE)
		(value AT_STATX_DONT_SYNC) (value AT_STATX_FORCE_SYNC) (value AT_STATX_SYNC_AS_STAT) (value AT_STATX_SYNC_TYPE)
		(value DN_ACCESS) (value DN_ATTRIB) (value DN_CREATE) (value DN_DELETE)
		(value DN_MODIFY) (value DN_MULTISHOT) (value DN_RENAME) (value FALLOC_FL_COLLAPSE_RANGE)
		(value FALLOC_FL_INSERT_RANGE) (value FALLOC_FL_KEEP_SIZE) (value FALLOC_FL_PUNCH_HOLE) (value FALLOC_FL_UNSHARE_RANGE)
		(value FALLOC_FL_ZERO_RANGE) (value F_ADD_SEALS) (value F_EXLCK) (value F_GETLK64)
		(value F_GETOWN_EX) (value F_GETPIPE_SZ) (value F_GETSIG) (value F_GET_FILE_RW_HINT)
		(value F_GET_RW_HINT) (value F_GET_SEALS) (value F_LOCK) (value F_NOTIFY)
		(value F_SEAL_EXEC) (value F_SEAL_FUTURE_WRITE) (value F_SEAL_GROW) (value F_SEAL_SEAL)
		(value F_SEAL_SHRINK) (value F_SEAL_WRITE) (value F_SETLK64) (value F_SETLKW64)
		(value F_SETOWN_EX) (value F_SETPIPE_SZ) (value F_SETSIG) (value F_SET_FILE_RW_HINT)
		(value F_SET_RW_HINT) (value F_SHLCK) (value F_TEST) (value F_TLOCK)
		(value F_ULOCK) (value LOCK_MAND) (value LOCK_READ) (value LOCK_RW)
		(value LOCK_WRITE) (value O_DIRECT) (value O_LARGEFILE) (value O_NOATIME)
		(value O_PATH) (value O_RSYNC) (value O_TMPFILE) (value POSIX_FADV_DONTNEED)
		(value POSIX_FADV_NOREUSE) (value POSIX_FADV_NORMAL) (value POSIX_FADV_RANDOM) (value POSIX_FADV_SEQUENTIAL)
		(value POSIX_FADV_WILLNEED) (value SPLICE_F_GIFT) (value SPLICE_F_MORE) (value SPLICE_F_MOVE)
		(value SPLICE_F_NONBLOCK) (value SYNC_FILE_RANGE_WAIT_AFTER) (value SYNC_FILE_RANGE_WAIT_BEFORE) (value SYNC_FILE_RANGE_WRITE)
		(value SYNC_FILE_RANGE_WRITE_AND_WAIT)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_arch
		(:pragma (cfg (all (os "linux") (arch "aarch64"))))
		(params) (returns i32)
		(body
			(if (i32.not-eq O_DIRECT 65536i32) (then (return 1i32)))
			(if (i32.not-eq O_TMPFILE 4210688i32) (then (return 2i32)))
			(return 42i32)))

	(fn check_arch
		(:pragma (cfg (all (os "linux") (arch "x86_64"))))
		(params) (returns i32)
		(body
			(if (i32.not-eq O_DIRECT 16384i32) (then (return 1i32)))
			(if (i32.not-eq O_TMPFILE 4259840i32) (then (return 2i32)))
			(return 42i32)))

	(fn check_constants (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(if (i32.not-eq AT_EMPTY_PATH 4096i32) (then (return 60i32)))
			(if (i32.not-eq AT_HANDLE_FID 512i32) (then (return 61i32)))
			(if (i32.not-eq AT_NO_AUTOMOUNT 2048i32) (then (return 62i32)))
			(if (i32.not-eq AT_RECURSIVE 32768i32) (then (return 63i32)))
			(if (i32.not-eq AT_STATX_DONT_SYNC 16384i32) (then (return 64i32)))
			(if (i32.not-eq AT_STATX_FORCE_SYNC 8192i32) (then (return 65i32)))
			(if (i32.not-eq AT_STATX_SYNC_AS_STAT 0i32) (then (return 66i32)))
			(if (i32.not-eq AT_STATX_SYNC_TYPE 24576i32) (then (return 67i32)))
			(if (i32.not-eq DN_ACCESS 1i32) (then (return 68i32)))
			(if (i32.not-eq DN_ATTRIB 32i32) (then (return 69i32)))
			(if (i32.not-eq DN_CREATE 4i32) (then (return 70i32)))
			(if (i32.not-eq DN_DELETE 8i32) (then (return 71i32)))
			(if (i32.not-eq DN_MODIFY 2i32) (then (return 72i32)))
			(if (u32.not-eq DN_MULTISHOT 2147483648u32) (then (return 73i32)))
			(if (i32.not-eq DN_RENAME 16i32) (then (return 74i32)))
			(if (i32.not-eq FALLOC_FL_COLLAPSE_RANGE 8i32) (then (return 75i32)))
			(if (i32.not-eq FALLOC_FL_INSERT_RANGE 32i32) (then (return 76i32)))
			(if (i32.not-eq FALLOC_FL_KEEP_SIZE 1i32) (then (return 77i32)))
			(if (i32.not-eq FALLOC_FL_PUNCH_HOLE 2i32) (then (return 78i32)))
			(if (i32.not-eq FALLOC_FL_UNSHARE_RANGE 64i32) (then (return 79i32)))
			(if (i32.not-eq FALLOC_FL_ZERO_RANGE 16i32) (then (return 80i32)))
			(if (i32.not-eq F_ADD_SEALS 1033i32) (then (return 81i32)))
			(if (i32.not-eq F_EXLCK 4i32) (then (return 82i32)))
			(if (i32.not-eq F_GETLK64 5i32) (then (return 83i32)))
			(if (i32.not-eq F_GETOWN_EX 16i32) (then (return 84i32)))
			(if (i32.not-eq F_GETPIPE_SZ 1032i32) (then (return 85i32)))
			(if (i32.not-eq F_GETSIG 11i32) (then (return 86i32)))
			(if (i32.not-eq F_GET_FILE_RW_HINT 1037i32) (then (return 87i32)))
			(if (i32.not-eq F_GET_RW_HINT 1035i32) (then (return 88i32)))
			(if (i32.not-eq F_GET_SEALS 1034i32) (then (return 89i32)))
			(if (i32.not-eq F_LOCK 1i32) (then (return 90i32)))
			(if (i32.not-eq F_NOTIFY 1026i32) (then (return 91i32)))
			(if (i32.not-eq F_SEAL_EXEC 32i32) (then (return 92i32)))
			(if (i32.not-eq F_SEAL_FUTURE_WRITE 16i32) (then (return 93i32)))
			(if (i32.not-eq F_SEAL_GROW 4i32) (then (return 94i32)))
			(if (i32.not-eq F_SEAL_SEAL 1i32) (then (return 95i32)))
			(if (i32.not-eq F_SEAL_SHRINK 2i32) (then (return 96i32)))
			(if (i32.not-eq F_SEAL_WRITE 8i32) (then (return 97i32)))
			(if (i32.not-eq F_SETLK64 6i32) (then (return 98i32)))
			(if (i32.not-eq F_SETLKW64 7i32) (then (return 99i32)))
			(if (i32.not-eq F_SETOWN_EX 15i32) (then (return 100i32)))
			(if (i32.not-eq F_SETPIPE_SZ 1031i32) (then (return 101i32)))
			(if (i32.not-eq F_SETSIG 10i32) (then (return 102i32)))
			(if (i32.not-eq F_SET_FILE_RW_HINT 1038i32) (then (return 103i32)))
			(if (i32.not-eq F_SET_RW_HINT 1036i32) (then (return 104i32)))
			(if (i32.not-eq F_SHLCK 8i32) (then (return 105i32)))
			(if (i32.not-eq F_TEST 3i32) (then (return 106i32)))
			(if (i32.not-eq F_TLOCK 2i32) (then (return 107i32)))
			(if (i32.not-eq F_ULOCK 0i32) (then (return 108i32)))
			(if (i32.not-eq LOCK_MAND 32i32) (then (return 109i32)))
			(if (i32.not-eq LOCK_READ 64i32) (then (return 110i32)))
			(if (i32.not-eq LOCK_RW 192i32) (then (return 111i32)))
			(if (i32.not-eq LOCK_WRITE 128i32) (then (return 112i32)))
			(if (i32.not-eq O_LARGEFILE 0i32) (then (return 113i32)))
			(if (i32.not-eq O_NOATIME 262144i32) (then (return 114i32)))
			(if (i32.not-eq O_PATH 2097152i32) (then (return 115i32)))
			(if (i32.not-eq O_RSYNC 1052672i32) (then (return 116i32)))
			(if (i32.not-eq POSIX_FADV_DONTNEED 4i32) (then (return 117i32)))
			(if (i32.not-eq POSIX_FADV_NOREUSE 5i32) (then (return 118i32)))
			(if (i32.not-eq POSIX_FADV_NORMAL 0i32) (then (return 119i32)))
			(if (i32.not-eq POSIX_FADV_RANDOM 1i32) (then (return 120i32)))
			(if (i32.not-eq POSIX_FADV_SEQUENTIAL 2i32) (then (return 121i32)))
			(if (i32.not-eq POSIX_FADV_WILLNEED 3i32) (then (return 122i32)))
			(if (i32.not-eq SPLICE_F_GIFT 8i32) (then (return 123i32)))
			(if (i32.not-eq SPLICE_F_MORE 4i32) (then (return 124i32)))
			(if (i32.not-eq SPLICE_F_MOVE 1i32) (then (return 125i32)))
			(if (i32.not-eq SPLICE_F_NONBLOCK 2i32) (then (return 126i32)))
			(if (i32.not-eq SYNC_FILE_RANGE_WAIT_AFTER 4i32) (then (return 127i32)))
			(if (i32.not-eq SYNC_FILE_RANGE_WAIT_BEFORE 1i32) (then (return 128i32)))
			(if (i32.not-eq SYNC_FILE_RANGE_WRITE 2i32) (then (return 129i32)))
			(if (i32.not-eq SYNC_FILE_RANGE_WRITE_AND_WAIT 7i32) (then (return 130i32)))
			(return (call check_arch))))

	(fn check_constants (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call check_constants)))))
