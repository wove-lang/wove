(module darwin_file_security_uuid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type FileProperty) (type FileSecurity) (value FILESEC_UUID) (value FILESEC_GRPUUID)
			filesec_init filesec_get_uuid filesec_set_uuid filesec_get_grpuuid filesec_set_grpuuid))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ENOENT)))
	(use (:pragma (cfg (os "macos"))) c-header "./filesec-uuid.h" (only seed_uuid verify_uuid))
	(bridge c-header "./filesec-uuid.h" (:pragma (cfg (os "macos")))
		(use c-header "<fcntl.h>" (only (type FileProperty) (type FileSecurity)))
		(fn seed_uuid
			(params (security (mut-ref FileSecurity)) (property FileProperty) (first u8))
			(returns i32))
		(fn verify_uuid
			(params (security (shared-ref FileSecurity)) (property FileProperty) (first u8))
			(returns i32)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_read (:pragma (cfg (os "macos"))) (params (group bool)) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 1i32)))
			(let property (if group
				(then FILESEC_GRPUUID) (else FILESEC_UUID)))
			(let other (if group
				(then FILESEC_UUID) (else FILESEC_GRPUUID)))
			(if (i32.not-eqz (call seed_uuid (borrow-mut security) other 45u8)) (then (return 2i32)))
			(let-mut output (array.repeat (array u8 16) 165u8))
			(let missing (if group
				(then (call filesec_get_grpuuid (borrow-shared security) (borrow-mut output)))
				(else (call filesec_get_uuid (borrow-shared security) (borrow-mut output)))))
			(if (i32.not-eq missing -1i32) (then (return 3i32)))
			(if (i32.not-eq errno ENOENT) (then (return 4i32)))
			(let-mut index 0i32)
			(while (i32.lt index 16i32)
				(body
					(if (u8.not-eq (array.load output index) 165u8) (then (return 5i32)))
					(set index (i32.inc index))))
			(if (i32.not-eqz (call seed_uuid (borrow-mut security) property 137u8)) (then (return 6i32)))
			(let loaded (if group
				(then (call filesec_get_grpuuid (borrow-shared security) (borrow-mut output)))
				(else (call filesec_get_uuid (borrow-shared security) (borrow-mut output)))))
			(if (i32.not-eqz loaded) (then (return 7i32)))
			(set index 0i32)
			(while (i32.lt index 16i32)
				(body
					(let expected (int.convert u8 (i32.add 137i32 index)))
					(if (u8.not-eq (array.load output index) expected) (then (return 8i32)))
					(set index (i32.inc index))))
			(return 0i32)))

	(fn check_write (:pragma (cfg (os "macos"))) (params (group bool)) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(if (owner.is-null security) (then (return 9i32)))
			(let property (if group
				(then FILESEC_GRPUUID) (else FILESEC_UUID)))
			(let other (if group
				(then FILESEC_UUID) (else FILESEC_GRPUUID)))
			(if (i32.not-eqz (call seed_uuid (borrow-mut security) other 45u8)) (then (return 10i32)))
			(let-mut input (array.repeat (array u8 16) 0u8))
			(let-mut index 0i32)
			(while (i32.lt index 16i32)
				(body
					(array.store input index (int.convert u8 (i32.add 173i32 index)))
					(set index (i32.inc index))))
			(let stored (if group
				(then (call filesec_set_grpuuid (borrow-mut security) (borrow-shared input)))
				(else (call filesec_set_uuid (borrow-mut security) (borrow-shared input)))))
			(if (i32.not-eqz stored) (then (return 11i32)))
			(set input (array.repeat (array u8 16) 0u8))
			(if (i32.not-eqz (call verify_uuid (borrow-shared security) property 173u8))
				(then (return 12i32)))
			(if (i32.not-eqz (call verify_uuid (borrow-shared security) other 45u8))
				(then (return 13i32)))
			(return 0i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params (mode i32)) (returns i32)
		(body
			(let group (i32.not-lt mode 2i32))
			(let writing (bool.or (i32.eq mode 1i32) (i32.eq mode 3i32)))
			(let result (if writing
				(then (call check_write group)) (else (call check_read group))))
			(if (i32.not-eqz result) (then (return result)))
			(return (i32.add 42i32 mode))))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params (mode i32)) (returns i32)
		(body (return (i32.add 42i32 mode))))

	(fn main (:expect (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:557"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call check_platform (array.len args))))))
