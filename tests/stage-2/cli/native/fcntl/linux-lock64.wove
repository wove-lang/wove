(module glibc_large_file_locks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<fcntl.h>"
		(only (type Lock) (type Lock64) (type Offset) (type Offset64) (type Mode) (type Pid) (type Short)
			open fcntl_ofd_setlk fcntl64_getlk fcntl64_setlk fcntl64_setlkw
			(value O_RDWR) (value F_WRLCK) (value F_UNLCK)))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only close (value SEEK_SET)))
	(use (:pragma (cfg (os "linux"))) c-header "<errno.h>" (only errno (value EAGAIN) (value EACCES)))

	(let fixture "sample")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_locks (:pragma (cfg (os "linux"))) (params (first i32) (second i32)) (returns i32)
		(body
			(let write_lock (int.convert Short F_WRLCK))
			(let unlocked (int.convert Short F_UNLCK))
			(let origin (int.convert Short SEEK_SET))
			(let start (int.convert Offset 5368709137i64))
			(let start64 (int.convert Offset64 5368709137i64))
			(let extent (int.convert Offset 2i32))
			(let extent64 (int.convert Offset64 2i32))
			(let-mut held (struct.new Lock (l_type write_lock) (l_whence origin)
				(l_start start) (l_len extent)))
			(if (i32.not-eqz (call fcntl_ofd_setlk first (borrow-mut held)))
				(then (return 3i32)))
			(let-mut request (struct.new Lock64 (l_type write_lock) (l_whence origin)
				(l_start start64) (l_len extent64)))
			(let-mut query request)
			(if (i32.not-eqz (call fcntl64_getlk second (borrow-mut query)))
				(then (return 4i32)))
			(if (bool.not (bool.and (int.eq Short (struct.get query l_type) write_lock)
					(bool.and (int.eq Offset64 (struct.get query l_start) start64)
						(bool.and (int.eq Offset64 (struct.get query l_len) extent64)
							(int.eq Pid (struct.get query l_pid) (int.convert Pid -1i32))))))
				(then (return 5i32)))
			(if (i32.not-eq (call fcntl64_setlk second (borrow-mut request)) -1i32)
				(then (return 6i32)))
			(let status errno)
			(if (bool.not (bool.or (i32.eq status EAGAIN) (i32.eq status EACCES)))
				(then (return 7i32)))
			(let-mut release (struct.new Lock (l_type unlocked) (l_whence origin)
				(l_start start) (l_len extent)))
			(if (i32.not-eqz (call fcntl_ofd_setlk first (borrow-mut release)))
				(then (return 8i32)))
			(if (i32.not-eqz (call fcntl64_setlkw second (borrow-mut request)))
				(then (return 9i32)))
			(let-mut release64 (struct.new Lock64 (l_type unlocked) (l_whence origin)
				(l_start start64) (l_len extent64)))
			(if (i32.not-eqz (call fcntl64_setlk second (borrow-mut release64)))
				(then (return 10i32)))
			(return 42i32)))

	(fn check_platform (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let mode (int.convert Mode 0i32))
			(let first (call open (borrow-shared fixture) O_RDWR mode))
			(if (i32.ltz first) (then (return 1i32)))
			(let second (call open (borrow-shared fixture) O_RDWR mode))
			(if (i32.ltz second)
				(then
					(let closed (call close first))
					(return 2i32)))
			(let result (call check_locks first second))
			(let first_closed (call close first))
			(let second_closed (call close second))
			(if (i32.not-eqz (i32.or first_closed second_closed)) (then (return 11i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call check_platform)))))
