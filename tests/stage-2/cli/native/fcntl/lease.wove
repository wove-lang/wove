(module fcntl_leases
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only (type Mode) open fcntl_getlease (value O_RDWR) (value F_UNLCK)))
	(use (:pragma (cfg (os "linux"))) c-header "<fcntl.h>" (only fcntl_setlease (value F_WRLCK)))
	(use c-header "<unistd.h>" (only close))
	(use c-header "<errno.h>" (only errno (value EBADF)))

	(let fixture "sample")

	(fn check_setter (:pragma (cfg (os "linux"))) (params (fd i32)) (returns i32)
		(body
			(if (i32.not-eq (call fcntl_setlease -1i32 F_WRLCK) -1i32) (then (return 4i32)))
			(if (i32.not-eq errno EBADF) (then (return 5i32)))
			(if (i32.not-eqz (call fcntl_setlease fd F_WRLCK)) (then (return 6i32)))
			(let active (call fcntl_getlease fd))
			(if (i32.not-eqz (call fcntl_setlease fd F_UNLCK)) (then (return 7i32)))
			(if (i32.not-eq active F_WRLCK) (then (return 8i32)))
			(if (i32.not-eq (call fcntl_getlease fd) F_UNLCK) (then (return 9i32)))
			(return 42i32)))

	(fn check_setter (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body (return 42i32)))

	(fn check_lease (params (fd i32)) (returns i32)
		(body
			(if (i32.not-eq (call fcntl_getlease -1i32) -1i32) (then (return 1i32)))
			(if (i32.not-eq errno EBADF) (then (return 2i32)))
			(if (i32.not-eq (call fcntl_getlease fd) F_UNLCK) (then (return 3i32)))
			(return (call check_setter fd))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let fd (call open (borrow-shared fixture) O_RDWR (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 10i32)))
			(let result (call check_lease fd))
			(if (i32.not-eqz (call close fd)) (then (return 11i32)))
			(return result))))
