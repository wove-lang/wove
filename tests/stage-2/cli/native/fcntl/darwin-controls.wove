(module darwin_fcntl_descriptor_controls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type Mode) open fcntl_nocache fcntl_rdahead fcntl_getnosigpipe fcntl_setnosigpipe
			(value O_RDONLY)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>"
		(only (type SignedSize) (type Size) close pipe write))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value EPIPE)))

	(let fixture "sample")
	(let payload "x")

	(fn check_cache_flags (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(if (i32.not-eqz (call fcntl_nocache fd 1i32)) (then (return 2i32)))
			(if (i32.not-eqz (call fcntl_nocache fd 0i32)) (then (return 3i32)))
			(if (i32.not-eqz (call fcntl_rdahead fd 0i32)) (then (return 4i32)))
			(if (i32.not-eqz (call fcntl_rdahead fd 1i32)) (then (return 5i32)))
			(return 42i32)))

	(fn check_signal_flag (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(if (i32.not-eqz (call fcntl_getnosigpipe fd)) (then (return 8i32)))
			(if (i32.not-eqz (call fcntl_setnosigpipe fd 1i32)) (then (return 9i32)))
			(if (i32.not-eq (call fcntl_getnosigpipe fd) 1i32) (then (return 10i32)))
			(let count (call write fd (borrow-shared payload) (int.convert Size 1i32)))
			(if (bool.not (int.eq SignedSize count (int.convert SignedSize -1i32))) (then (return 11i32)))
			(if (i32.not-eq errno EPIPE) (then (return 12i32)))
			(if (i32.not-eqz (call fcntl_setnosigpipe fd 0i32)) (then (return 13i32)))
			(if (i32.not-eqz (call fcntl_getnosigpipe fd)) (then (return 14i32)))
			(return 42i32)))

	(fn check_pipe (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut descriptors (array.alloc i32 2i32))
			(if (i32.not-eqz (call pipe (borrow-mut descriptors))) (then (return 6i32)))
			(let write_end (array.load descriptors 1i32))
			(if (i32.not-eqz (call close (array.load descriptors 0i32)))
				(then
					(let closed (call close write_end))
					(return 7i32)))
			(let result (call check_signal_flag write_end))
			(if (i32.not-eqz (call close write_end)) (then (return 15i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let fd (call open (borrow-shared fixture) O_RDONLY (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 1i32)))
			(let checked (call check_cache_flags fd))
			(if (i32.not-eqz (call close fd)) (then (return 16i32)))
			(if (i32.not-eq checked 42i32) (then (return checked)))
			(return (call check_pipe))))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_platform)))))
