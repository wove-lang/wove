(module glibc_fcntl_files
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "linux"))) c-header "<fcntl.h>"
		(only (type Mode) (type Offset) (type Offset64) (type Size)
			creat64 open64 openat64 fcntl64_getfd lockf64 posix_fadvise64 posix_fallocate64
			fallocate fallocate64 readahead sync_file_range tee splice
			(value O_RDONLY) (value AT_FDCWD) (value F_TEST) (value POSIX_FADV_NORMAL)))
	(use (:pragma (cfg (os "linux"))) c-header "<errno.h>" (only (value EBADF)))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only close))

	(let fixture "sample")
	(let output "created")

	(fn check_failed_operations (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let start (int.convert Offset64 0i32))
			(let length (int.convert Offset64 1i32))
			(let count (int.convert Size 1i32))
			(if (i32.not-eq (call fallocate -1i32 0i32 (int.convert Offset 0i32) (int.convert Offset 1i32)) -1i32)
				(then (return 7i32)))
			(if (i32.not-eq (call fallocate64 -1i32 0i32 start length) -1i32) (then (return 8i32)))
			(if (i64.not-eq (int.convert i64 (call readahead -1i32 start count)) -1i64)
				(then (return 9i32)))
			(if (i32.not-eq (call sync_file_range -1i32 start length 0u32) -1i32)
				(then (return 10i32)))
			(if (i64.not-eq (int.convert i64 (call tee -1i32 -1i32 count 0u32)) -1i64)
				(then (return 11i32)))
			(let-mut mut_offset (int.convert Offset64 0i32))
			(if (i64.not-eq (int.convert i64 (call splice -1i32 (borrow-mut mut_offset) -1i32 null count 0u32)) -1i64)
				(then (return 12i32)))
			(return 42i32)))

	(fn check_large_file (:pragma (cfg (os "linux"))) (params (input i32) (created i32)) (returns i32)
		(body
			(let start (int.convert Offset64 0i32))
			(let length (int.convert Offset64 1i32))
			(if (i32.ltz (call fcntl64_getfd input)) (then (return 4i32)))
			(if (i32.not-eqz (call posix_fadvise64 input start length POSIX_FADV_NORMAL))
				(then (return 5i32)))
			(if (i32.not-eq (call posix_fallocate64 -1i32 start length) EBADF) (then (return 6i32)))
			(if (i32.not-eqz (call lockf64 created F_TEST start)) (then (return 13i32)))
			(return (call check_failed_operations))))

	(fn check_platform (:pragma (cfg (os "linux"))) (params) (returns i32)
		(body
			(let mode (int.convert Mode 384i32))
			(let input (call open64 (borrow-shared fixture) O_RDONLY mode))
			(if (i32.ltz input) (then (return 1i32)))
			(let relative (call openat64 AT_FDCWD (borrow-shared fixture) O_RDONLY mode))
			(let input_closed (call close input))
			(if (bool.or (i32.ltz relative) (i32.not-eqz input_closed)) (then (return 2i32)))
			(let created (call creat64 (borrow-shared output) mode))
			(if (i32.ltz created)
				(then
					(let closed (call close relative))
					(return 3i32)))
			(let checked (call check_large_file relative created))
			(let relative_closed (call close relative))
			(let created_closed (call close created))
			(if (i32.not-eqz (i32.or relative_closed created_closed)) (then (return 14i32)))
			(return checked)))

	(fn check_platform (:pragma (cfg (not (os "linux")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_platform)))))
