(module darwin_fcntl_constants
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>" (only F_SETLEASE_ARG
		(value AT_FDONLY) (value AT_REALDEV) (value AT_SYMLINK_NOFOLLOW_ANY) (value FD_CLOFORK)
		(value F_ADDFILESIGS) (value F_ADDFILESIGS_FOR_DYLD_SIM) (value F_ADDFILESIGS_INFO) (value F_ADDFILESIGS_RETURN)
		(value F_ADDFILESUPPL) (value F_ADDSIGS) (value F_ADDSIGS_MAIN_BINARY) (value F_ALLOCATEALL)
		(value F_ALLOCATECONTIG) (value F_ALLOCATEPERSIST) (value F_ATTRIBUTION_TAG) (value F_BARRIERFSYNC)
		(value F_CHECK_LV) (value F_CHKCLEAN) (value F_CREATE_TAG) (value F_DELETE_TAG)
		(value F_FINDSIGS) (value F_FLUSH_DATA) (value F_FREEZE_FS) (value F_FULLFSYNC)
		(value F_GETCODEDIR) (value F_GETLKPID) (value F_GETNOSIGPIPE) (value F_GETPATH)
		(value F_GETPATH_MTMINFO) (value F_GETPATH_NOFIRMLINK) (value F_GETPROTECTIONCLASS) (value F_GETPROTECTIONLEVEL)
		(value F_GETSIGSINFO) (value F_GLOBAL_NOCACHE) (value F_LOG2PHYS) (value F_LOG2PHYS_EXT)
		(value F_NOCACHE) (value F_NOCACHE_EXT) (value F_NODIRECT) (value F_OFD_SETLKWTIMEOUT)
		(value F_PATHPKG_CHECK) (value F_PEOFPOSMODE) (value F_PREALLOCATE) (value F_PUNCHHOLE)
		(value F_QUERY_TAG) (value F_RDADVISE) (value F_RDAHEAD) (value F_SETBACKINGSTORE)
		(value F_SETLKWTIMEOUT) (value F_SETNOSIGPIPE) (value F_SETPROTECTIONCLASS) (value F_SETSIZE)
		(value F_SINGLE_WRITER) (value F_SPECULATIVE_READ) (value F_THAW_FS) (value F_TRANSCODEKEY)
		(value F_TRANSFEREXTENTS) (value F_TRIM_ACTIVE_FILE) (value F_VOLPOSMODE) (value O_ALERT)
		(value O_CLOFORK) (value O_DP_AUTHENTICATE) (value O_DP_GETRAWENCRYPTED) (value O_DP_GETRAWUNENCRYPTED)
		(value O_EVTONLY) (value O_EXEC) (value O_EXLOCK) (value O_NOFOLLOW_ANY)
		(value O_POPUP) (value O_SEARCH) (value O_SHLOCK) (value O_SYMLINK)))


	(fn check_constants (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(if (i32.not-eq AT_FDONLY 1024i32) (then (return 60i32)))
			(if (i32.not-eq AT_REALDEV 512i32) (then (return 61i32)))
			(if (i32.not-eq AT_SYMLINK_NOFOLLOW_ANY 2048i32) (then (return 62i32)))
			(if (i32.not-eq FD_CLOFORK 2i32) (then (return 63i32)))
			(if (i32.not-eq F_ADDFILESIGS 61i32) (then (return 64i32)))
			(if (i32.not-eq F_ADDFILESIGS_FOR_DYLD_SIM 83i32) (then (return 65i32)))
			(if (i32.not-eq F_ADDFILESIGS_INFO 103i32) (then (return 66i32)))
			(if (i32.not-eq F_ADDFILESIGS_RETURN 97i32) (then (return 67i32)))
			(if (i32.not-eq F_ADDFILESUPPL 104i32) (then (return 68i32)))
			(if (i32.not-eq F_ADDSIGS 59i32) (then (return 69i32)))
			(if (i32.not-eq F_ADDSIGS_MAIN_BINARY 113i32) (then (return 70i32)))
			(if (i32.not-eq F_ALLOCATEALL 4i32) (then (return 71i32)))
			(if (i32.not-eq F_ALLOCATECONTIG 2i32) (then (return 72i32)))
			(if (i32.not-eq F_ALLOCATEPERSIST 8i32) (then (return 73i32)))
			(if (i32.not-eq F_ATTRIBUTION_TAG 111i32) (then (return 74i32)))
			(if (i32.not-eq F_BARRIERFSYNC 85i32) (then (return 75i32)))
			(if (i32.not-eq F_CHECK_LV 98i32) (then (return 76i32)))
			(if (i32.not-eq F_CHKCLEAN 41i32) (then (return 77i32)))
			(if (i32.not-eq F_CREATE_TAG 1i32) (then (return 78i32)))
			(if (i32.not-eq F_DELETE_TAG 2i32) (then (return 79i32)))
			(if (i32.not-eq F_FINDSIGS 78i32) (then (return 80i32)))
			(if (i32.not-eq F_FLUSH_DATA 40i32) (then (return 81i32)))
			(if (i32.not-eq F_FREEZE_FS 53i32) (then (return 82i32)))
			(if (i32.not-eq F_FULLFSYNC 51i32) (then (return 83i32)))
			(if (i32.not-eq F_GETCODEDIR 72i32) (then (return 84i32)))
			(if (i32.not-eq F_GETLKPID 66i32) (then (return 85i32)))
			(if (i32.not-eq F_GETNOSIGPIPE 74i32) (then (return 86i32)))
			(if (i32.not-eq F_GETPATH 50i32) (then (return 87i32)))
			(if (i32.not-eq F_GETPATH_MTMINFO 71i32) (then (return 88i32)))
			(if (i32.not-eq F_GETPATH_NOFIRMLINK 102i32) (then (return 89i32)))
			(if (i32.not-eq F_GETPROTECTIONCLASS 63i32) (then (return 90i32)))
			(if (i32.not-eq F_GETPROTECTIONLEVEL 77i32) (then (return 91i32)))
			(if (i32.not-eq F_GETSIGSINFO 105i32) (then (return 92i32)))
			(if (i32.not-eq F_GLOBAL_NOCACHE 55i32) (then (return 93i32)))
			(if (i32.not-eq F_LOG2PHYS 49i32) (then (return 94i32)))
			(if (i32.not-eq F_LOG2PHYS_EXT 65i32) (then (return 95i32)))
			(if (i32.not-eq F_NOCACHE 48i32) (then (return 96i32)))
			(if (i32.not-eq F_NOCACHE_EXT 112i32) (then (return 97i32)))
			(if (i32.not-eq F_NODIRECT 62i32) (then (return 98i32)))
			(if (i32.not-eq F_OFD_SETLKWTIMEOUT 93i32) (then (return 99i32)))
			(if (i32.not-eq F_PATHPKG_CHECK 52i32) (then (return 100i32)))
			(if (i32.not-eq F_PEOFPOSMODE 3i32) (then (return 101i32)))
			(if (i32.not-eq F_PREALLOCATE 42i32) (then (return 102i32)))
			(if (i32.not-eq F_PUNCHHOLE 99i32) (then (return 103i32)))
			(if (i32.not-eq F_QUERY_TAG 4i32) (then (return 104i32)))
			(if (i32.not-eq F_RDADVISE 44i32) (then (return 105i32)))
			(if (i32.not-eq F_RDAHEAD 45i32) (then (return 106i32)))
			(if (i32.not-eq F_SETBACKINGSTORE 70i32) (then (return 107i32)))
			(if (i32.not-eq F_SETLKWTIMEOUT 10i32) (then (return 108i32)))
			(if (i32.not-eq F_SETNOSIGPIPE 73i32) (then (return 109i32)))
			(if (i32.not-eq F_SETPROTECTIONCLASS 64i32) (then (return 110i32)))
			(if (i32.not-eq F_SETSIZE 43i32) (then (return 111i32)))
			(if (i32.not-eq F_SINGLE_WRITER 76i32) (then (return 112i32)))
			(if (i32.not-eq F_SPECULATIVE_READ 101i32) (then (return 113i32)))
			(if (i32.not-eq F_THAW_FS 54i32) (then (return 114i32)))
			(if (i32.not-eq F_TRANSCODEKEY 75i32) (then (return 115i32)))
			(if (i32.not-eq F_TRANSFEREXTENTS 110i32) (then (return 116i32)))
			(if (i32.not-eq F_TRIM_ACTIVE_FILE 100i32) (then (return 117i32)))
			(if (i32.not-eq F_VOLPOSMODE 4i32) (then (return 118i32)))
			(if (i32.not-eq O_ALERT 536870912i32) (then (return 119i32)))
			(if (i32.not-eq O_CLOFORK 134217728i32) (then (return 120i32)))
			(if (i32.not-eq O_DP_AUTHENTICATE 4i32) (then (return 121i32)))
			(if (i32.not-eq O_DP_GETRAWENCRYPTED 1i32) (then (return 122i32)))
			(if (i32.not-eq O_DP_GETRAWUNENCRYPTED 2i32) (then (return 123i32)))
			(if (i32.not-eq O_EVTONLY 32768i32) (then (return 124i32)))
			(if (i32.not-eq O_EXEC 1073741824i32) (then (return 125i32)))
			(if (i32.not-eq O_EXLOCK 32i32) (then (return 126i32)))
			(if (i32.not-eq O_NOFOLLOW_ANY 536870912i32) (then (return 127i32)))
			(if (u32.not-eq O_POPUP 2147483648u32) (then (return 128i32)))
			(if (i32.not-eq O_SEARCH 1074790400i32) (then (return 129i32)))
			(if (i32.not-eq O_SHLOCK 16i32) (then (return 130i32)))
			(if (i32.not-eq O_SYMLINK 2097152i32) (then (return 131i32)))
			(if (i32.not-eq (call F_SETLEASE_ARG 3i32 7i32) 31i32) (then (return 132i32)))
			(return 42i32)))

	(fn check_constants (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_constants)))))
