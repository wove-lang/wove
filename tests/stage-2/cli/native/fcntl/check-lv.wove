(module bundled_darwin_library_validation
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type LibraryValidation) (type Mode) (type Offset)
			(value O_RDONLY) fcntl_check_lv open))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only (type Size) close))

	(let filename "sample")

	(fn run (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let fd (call open (borrow-shared filename) O_RDONLY (int:convert Mode 0i32)))
			(if (i32:ltz fd) (then (return 1i32)))
			(let-mut request (struct:new LibraryValidation
				(lv_file_start (int:convert Offset 0i32)) (lv_error_message_size (int:convert Size 7i32))))
			(let-mut message (array:alloc u8 514i32))
			(array:set message 0i32 165u8)
			(array:set message 513i32 166u8)
			(let status (call fcntl_check_lv fd (borrow-mut request)
				(borrow-mut (array:range message 1i32 513i32)) (int:convert Size 512i32)))
			(if (i32:not-eqz (call close fd)) (then (return 2i32)))
			(if (bool:and (i32:not-eqz status) (i32:not-eq status -1i32)) (then (return 3i32)))
			(if (bool:or (u8:not-eq (array:get message 0i32) 165u8)
				(u8:not-eq (array:get message 513i32) 166u8)) (then (return 4i32)))
			(if (i32:not-eq (int:convert i32 (struct:get request lv_error_message_size)) 7i32)
				(then (return 5i32)))
			(return 42i32)))

	(fn run (:pragma (cfg (not (os "macos")))) (params) (returns i32)
		(body (return 42i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:565"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call run)))))
