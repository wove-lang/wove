(module darwin_file_security_acl
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<sys/acl.h>" (only (type Acl) acl_init acl_valid))
	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type FileSecurity) (value FILESEC_ACL) filesec_init filesec_get_acl filesec_set_acl
			filesec_mark_remove_acl filesec_unset_property))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value ENOENT)))
	(use (:pragma (cfg (os "macos"))) c-header "./filesec-acl.h"
		(only make_acl_fixture check_acl_fixture seed_filesec_acl seed_filesec_marker native_acl_state))
	(bridge c-header "./filesec-acl.h" (:pragma (cfg (os "macos")))
		(use c-header "<fcntl.h>" (only (type FileSecurity)))
		(use c-header "<sys/acl.h>" (only (type Acl)))
		(fn make_acl_fixture (params) (returns Acl))
		(fn check_acl_fixture (params (acl (shared-ref Acl))) (returns i32))
		(fn seed_filesec_acl (params (security (mut-ref FileSecurity)) (acl (shared-ref Acl))) (returns i32))
		(fn seed_filesec_marker (params (security (mut-ref FileSecurity))) (returns i32))
		(fn native_acl_state (params (security (shared-ref FileSecurity))) (returns i32)))


	(fn getter (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(let fresh (call acl_init 1i32))
			(if (bool:or (owner:is-null security) (owner:is-null fresh)) (then (return 1i32)))
			(let-mut output (native:empty Acl))
			(let-mut removed (bool true))
			(let missing (call filesec_get_acl (borrow-shared security)
				(borrow-mut output) (borrow-mut removed)))
			(if (i32:not-eq missing -1i32) (then (return 2i32)))
			(if (i32:not-eq errno ENOENT) (then (return 3i32)))
			(if (bool:or removed (bool:not (owner:is-null output))) (then (return 4i32)))

			(let-mut seed (call make_acl_fixture))
			(if (owner:is-null seed) (then (return 5i32)))
			(if (i32:not-eqz (call seed_filesec_acl (borrow-mut security) (borrow-shared seed)))
				(then (return 6i32)))
			(set seed (native:empty Acl))
			(if (i32:not-eqz (call filesec_get_acl (borrow-shared security)
					(borrow-mut output) (borrow-mut removed)))
				(then (return 7i32)))
			(if (bool:or removed (owner:is-null output)) (then (return 8i32)))
			(if (i32:not-eqz (call filesec_unset_property (borrow-mut security) FILESEC_ACL))
				(then (return 9i32)))
			(if (i32:not-eqz (call acl_valid (borrow-shared output))) (then (return 10i32)))
			(if (i32:not-eqz (call check_acl_fixture (borrow-shared output))) (then (return 11i32)))

			(if (i32:not-eqz (call seed_filesec_marker (borrow-mut security))) (then (return 12i32)))
			(let-mut marked (native:empty Acl))
			(if (i32:not-eqz (call filesec_get_acl (borrow-shared security)
					(borrow-mut marked) (borrow-mut removed)))
				(then (return 13i32)))
			(if (bool:not (bool:and removed (owner:is-null marked))) (then (return 14i32)))
			(return 42i32)))

	(fn setter (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(let-mut input (call make_acl_fixture))
			(if (bool:or (owner:is-null security) (owner:is-null input)) (then (return 15i32)))
			(if (i32:not-eqz (call filesec_set_acl (borrow-mut security) (borrow-shared input)))
				(then (return 16i32)))
			(if (i32:not-eqz (call check_acl_fixture (borrow-shared input))) (then (return 17i32)))
			(set input (native:empty Acl))
			(if (i32:not-eq (call native_acl_state (borrow-shared security)) 1i32) (then (return 18i32)))
			(return 43i32)))

	(fn marker (:pragma (cfg (os "macos"))) (params) (returns i32)
		(body
			(let-mut security (call filesec_init))
			(let input (call make_acl_fixture))
			(if (bool:or (owner:is-null security) (owner:is-null input)) (then (return 19i32)))
			(if (i32:not-eqz (call seed_filesec_acl (borrow-mut security) (borrow-shared input)))
				(then (return 20i32)))
			(if (i32:not-eqz (call filesec_mark_remove_acl (borrow-mut security))) (then (return 21i32)))
			(if (i32:not-eq (call native_acl_state (borrow-shared security)) 2i32) (then (return 22i32)))
			(if (i32:not-eqz (call filesec_unset_property (borrow-mut security) FILESEC_ACL))
				(then (return 23i32)))
			(if (i32:not-eqz (call native_acl_state (borrow-shared security))) (then (return 24i32)))
			(return 44i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params (mode i32)) (returns i32)
		(body
			(if (i32:eqz mode) (then (return (call getter))))
			(if (i32:eq mode 1i32) (then (return (call setter))))
			(return (call marker))))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params (mode i32)) (returns i32)
		(body (return (i32:add 42i32 mode))))

	(fn main (:expect (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:560"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check_platform (i32:dec (array:len args)))))))
