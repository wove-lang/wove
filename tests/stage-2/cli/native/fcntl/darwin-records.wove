(module darwin_fcntl_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type FileStore) (type Log2Phys) (type Mode) (type Offset) open
			fcntl_preallocate fcntl_log2phys fcntl_log2phys_ext (value O_RDWR)
			(value F_ALLOCATEALL) (value F_PEOFPOSMODE)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>"
		(only (type (as Offset SeekOffset)) (type Size) close write fsync lseek
			(value SEEK_SET) (value SEEK_CUR) (value SEEK_END)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>"
		(only errno (value EBADF) (value EINVAL) (value ENOTSUP) (value EOPNOTSUPP) (value ENOSYS)))
	(use (:pragma (cfg (os "macos"))) c-header "./darwin-records.h" (only native_log2phys_at))
	(bridge c-header "./darwin-records.h" (:pragma (cfg (os "macos")))
		(use c-header "<fcntl.h>" (only (type Offset) (type Log2Phys)))
		(fn native_log2phys_at
			(params (fd i32) (position Offset) (output (mut-ref Log2Phys))) (returns i32)))

	(let filename "sample")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn unsupported (:pragma (cfg (os "macos"))) (params (failure i32)) (returns bool)
		(body (return (bool.or (i32.eq failure ENOTSUP)
			(bool.or (i32.eq failure EOPNOTSUPP) (i32.eq failure ENOSYS))))))

	(fn test_preallocate (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let zero (int.convert Offset 0i64))
			(let length (int.convert Offset 16384i64))
			(let flags (int.convert u32 F_ALLOCATEALL))
			(let-mut request (struct.new FileStore (fst_flags flags)
				(fst_posmode F_PEOFPOSMODE) (fst_offset zero) (fst_length length)
				(fst_bytesalloc (int.convert Offset -1i64))))
			(let invalid (call fcntl_preallocate -1i32 (borrow-mut request)))
			(if (i32.not-eq invalid -1i32) (then (return 2i32)))
			(if (i32.not-eq errno EBADF) (then (return 3i32)))
			(let status (call fcntl_preallocate fd (borrow-mut request)))
			(let failure errno)
			(if (i32.not-eqz status)
				(then
					(if (bool.and (i32.eq status -1i32) (call unsupported failure))
						(then (return 0i32)))
					(return 4i32)))
			(if (i64.lt (int.convert i64 (struct.get request fst_bytesalloc)) 16384i64) (then (return 5i32)))
			(if (u32.not-eq (struct.get request fst_flags) flags) (then (return 6i32)))
			(if (i32.not-eq (struct.get request fst_posmode) F_PEOFPOSMODE) (then (return 7i32)))
			(if (int.not-eq Offset (struct.get request fst_offset) zero) (then (return 8i32)))
			(if (int.not-eq Offset (struct.get request fst_length) length) (then (return 9i32)))
			(let size (int.convert i64 (call lseek fd (int.convert SeekOffset 0i64) SEEK_END)))
			(if (i64.not-eq size 0i64) (then (return 10i32)))
			(let-mut bad_offset (struct.new FileStore (fst_flags flags)
				(fst_posmode F_PEOFPOSMODE) (fst_offset (int.convert Offset 1i64)) (fst_length length)))
			(if (i32.not-eq (call fcntl_preallocate fd (borrow-mut bad_offset)) -1i32)
				(then (return 11i32)))
			(if (i32.not-eq errno EINVAL) (then (return 12i32)))
			(return 0i32)))

	(fn prepare_mapping (:pragma (cfg (os "macos"))) (params (fd i32) (position i64)) (returns bool)
		(body
			(let bytes (array.repeat (array u8 16384) 53u8))
			(let written (call write fd (borrow-shared bytes) (int.convert Size 16384i32)))
			(if (i64.not-eq (int.convert i64 written) 16384i64) (then (return (bool false))))
			(if (i32.not-eqz (call fsync fd)) (then (return (bool false))))
			(let actual (call lseek fd (int.convert SeekOffset position) SEEK_SET))
			(return (i64.eq (int.convert i64 actual) position))))

	(fn test_legacy (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(if (bool.not (call prepare_mapping fd 4096i64)) (then (return 13i32)))
			(let-mut output (struct.new Log2Phys (l2p_devoffset (int.convert Offset -1i64))))
			(let invalid (call fcntl_log2phys -1i32 (borrow-mut output)))
			(if (i32.not-eq invalid -1i32) (then (return 14i32)))
			(if (i32.not-eq errno EBADF) (then (return 15i32)))
			(let status (call fcntl_log2phys fd (borrow-mut output)))
			(let failure errno)
			(if (i32.not-eqz status)
				(then
					(if (bool.and (i32.eq status -1i32) (call unsupported failure))
						(then (return 0i32)))
					(return 16i32)))
			(if (i64.ltz (int.convert i64 (struct.get output l2p_devoffset))) (then (return 17i32)))
			(let current (call lseek fd (int.convert SeekOffset 0i64) SEEK_CUR))
			(if (i64.not-eq (int.convert i64 current) 4096i64) (then (return 18i32)))
			(return 0i32)))

	(fn test_extended (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(if (bool.not (call prepare_mapping fd 0i64)) (then (return 19i32)))
			(let file_offset (int.convert Offset 4096i64))
			(let-mut mapping (struct.new Log2Phys (l2p_contigbytes (int.convert Offset 256i64)) (l2p_devoffset file_offset)))
			(let invalid (call fcntl_log2phys_ext -1i32 (borrow-mut mapping)))
			(if (i32.not-eq invalid -1i32) (then (return 20i32)))
			(if (i32.not-eq errno EBADF) (then (return 21i32)))
			(let status (call fcntl_log2phys_ext fd (borrow-mut mapping)))
			(let failure errno)
			(if (i32.not-eqz status)
				(then
					(if (bool.and (i32.eq status -1i32) (call unsupported failure))
						(then (return 0i32)))
					(return 22i32)))
			(if (i64.le (int.convert i64 (struct.get mapping l2p_contigbytes)) 0i64) (then (return 23i32)))
			(let-mut oracle (struct.new Log2Phys))
			(if (i32.not-eqz (call native_log2phys_at fd file_offset (borrow-mut oracle)))
				(then (return 24i32)))
			(if (int.not-eq Offset (struct.get mapping l2p_devoffset) (struct.get oracle l2p_devoffset))
				(then (return 25i32)))
			(let current (call lseek fd (int.convert SeekOffset 0i64) SEEK_CUR))
			(if (i64.not-eq (int.convert i64 current) 0i64) (then (return 26i32)))
			(return 0i32)))

	(fn test_record (:pragma (cfg (os "macos"))) (params (fd i32) (mode i32)) (returns i32)
		(body
			(if (i32.eqz mode) (then (return (call test_preallocate fd))))
			(if (i32.eq mode 1i32) (then (return (call test_legacy fd))))
			(return (call test_extended fd))))

	(fn check_platform (:pragma (cfg (os "macos"))) (params (mode i32)) (returns i32)
		(body
			(let fd (call open (borrow-shared filename) O_RDWR (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 1i32)))
			(let result (call test_record fd mode))
			(let closed (call close fd))
			(if (i32.not-eqz closed) (then (return 27i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params (mode i32)) (returns i32)
		(body (return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let mode (array.len args))
			(let result (call check_platform mode))
			(if (i32.not-eqz result) (then (return result)))
			(return (i32.add 42i32 mode)))))
