(module darwin_fcntl_attribution
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<fcntl.h>"
		(only (type FileAttributionTag) (type AttributionHash) (type Mode)
			open fcntl_attribution_tag (value O_RDWR) (value F_QUERY_TAG) (value ATTRIBUTION_NAME_MAX)))
	(use (:pragma (cfg (os "macos"))) c-header "<errno.h>" (only errno (value EBADF)))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only close))
	(use (:pragma (cfg (os "macos"))) c-header "./attribution.h" (only native_attribution_query))
	(bridge c-header "./attribution.h" (:pragma (cfg (os "macos")))
		(use c-header "<fcntl.h>" (only (type FileAttributionTag)))
		(fn native_attribution_query
			(params (fd i32) (tag (mut-ref FileAttributionTag))) (returns i32)))

	(let sample "sample")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check_query (:pragma (cfg (os "macos"))) (params (fd i32)) (returns i32)
		(body
			(let-mut actual (struct.new FileAttributionTag
				(ft_flags (int.convert u32 F_QUERY_TAG)) (ft_hash (int.convert AttributionHash 37u64))))
			(let extent (array.len (struct.get actual ft_attribution_name)))
			(if (i32.not-eq extent ATTRIBUTION_NAME_MAX) (then (return 1i32)))
			(array.store (struct.get actual ft_attribution_name) 0i32 119u8)
			(array.store (struct.get actual ft_attribution_name) 1i32 111u8)
			(array.store (struct.get actual ft_attribution_name) 2i32 118u8)
			(array.store (struct.get actual ft_attribution_name) 3i32 101u8)
			(array.store (struct.get actual ft_attribution_name) 254i32 165u8)
			(let-mut expected actual)
			(let native_status (call native_attribution_query fd (borrow-mut expected)))
			(let native_error errno)
			(let status (call fcntl_attribution_tag fd (borrow-mut actual)))
			(let failure errno)
			(if (i32.not-eq status native_status) (then (return 2i32)))
			(if (bool.and (i32.eq status -1i32) (i32.not-eq failure native_error))
				(then (return 3i32)))
			(if (bool.and (i32.ltz fd)
				(bool.or (i32.not-eq status -1i32) (i32.not-eq failure EBADF)))
				(then (return 4i32)))
			(if (u32.not-eq (struct.get actual ft_flags) (struct.get expected ft_flags))
				(then (return 5i32)))
			(if (int.not-eq AttributionHash (struct.get actual ft_hash) (struct.get expected ft_hash))
				(then (return 6i32)))
			(let-mut index 0i32)
			(while (i32.lt index extent)
				(body
					(if (u8.not-eq (array.load (struct.get actual ft_attribution_name) index)
						(array.load (struct.get expected ft_attribution_name) index))
						(then (return 7i32)))
					(set index (i32.inc index))))
			(return 0i32)))

	(fn check_platform (:pragma (cfg (os "macos"))) (params (valid bool)) (returns i32)
		(body
			(if (bool.not valid) (then (return (call check_query -1i32))))
			(let fd (call open (borrow-shared sample) O_RDWR (int.convert Mode 0i32)))
			(if (i32.ltz fd) (then (return 8i32)))
			(let result (call check_query fd))
			(let closed (call close fd))
			(if (i32.not-eqz closed) (then (return 9i32)))
			(return result)))

	(fn check_platform (:pragma (cfg (not (os "macos")))) (params (valid bool)) (returns i32)
		(body (return 0i32)))

	(fn main (:expect (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:564"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let count (array.len args))
			(let result (call check_platform (i32.gtz count)))
			(if (i32.not-eqz result) (then (return result)))
			(return (i32.add 42i32 count)))))
