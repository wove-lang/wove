(module fcntl_ofd_locks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>"
		(only (type Lock) (type Short) (type Offset) (type Mode)
			open fcntl_ofd_getlk fcntl_ofd_setlk fcntl_ofd_setlkw
			(value O_RDWR) (value F_WRLCK) (value F_UNLCK)))
	(use c-header "<unistd.h>" (only dup close (value SEEK_SET)))
	(use c-header "<errno.h>" (only errno (value EACCES) (value EAGAIN)))

	(let path "sample")

	(fn distinguish_descriptions (params (first i32) (same i32) (other i32)) (returns i32)
		(body
			(let write_lock (int:convert Short F_WRLCK))
			(let unlocked (int:convert Short F_UNLCK))
			(let origin (int:convert Short SEEK_SET))
			(let extent (int:convert Offset 2i32))
			(let-mut request (struct:new Lock (l_type write_lock) (l_whence origin) (l_len extent)))
			(if (i32:not-eqz (call fcntl_ofd_setlk first (borrow-mut request)))
				(then (return 4i32)))

			(let-mut query request)
			(if (bool:or (i32:not-eqz (call fcntl_ofd_getlk same (borrow-mut query)))
					(bool:not (int:eq Short (struct:get query l_type) unlocked)))
				(then (return 5i32)))
			(set query request)
			(if (bool:or (i32:not-eqz (call fcntl_ofd_getlk other (borrow-mut query)))
					(bool:not (int:eq Short (struct:get query l_type) write_lock)))
				(then (return 6i32)))
			(if (i32:not-eq (call fcntl_ofd_setlk other (borrow-mut request)) -1i32)
				(then (return 7i32)))
			(let status errno)
			(if (bool:not (bool:or (i32:eq status EACCES) (i32:eq status EAGAIN)))
				(then (return 8i32)))

			(if (i32:not-eqz (call fcntl_ofd_setlkw same (borrow-mut request)))
				(then (return 9i32)))
			(let-mut release (struct:new Lock (l_type unlocked) (l_whence origin) (l_len extent)))
			(if (i32:not-eqz (call fcntl_ofd_setlk same (borrow-mut release)))
				(then (return 10i32)))
			(if (i32:not-eqz (call fcntl_ofd_setlk other (borrow-mut request)))
				(then (return 11i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (int:convert Mode 0i32))
			(let first (call open (borrow-shared path) O_RDWR mode))
			(if (i32:ltz first) (then (return 1i32)))
			(let same (call dup first))
			(if (i32:ltz same)
				(then
					(let closed (call close first))
					(return 2i32)))
			(let other (call open (borrow-shared path) O_RDWR mode))
			(if (i32:ltz other)
				(then
					(let closed_first (call close first))
					(let closed_same (call close same))
					(return 3i32)))
			(let result (call distinguish_descriptions first same other))
			(let closed_first (call close first))
			(let closed_same (call close same))
			(let closed_other (call close other))
			(if (i32:not-eqz (i32:or (i32:or closed_first closed_same) closed_other))
				(then (return 12i32)))
			(return result))))
