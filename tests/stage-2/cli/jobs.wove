	(use wove-file "../../../stage-2/driver/jobs.wove" (only compiler_job_budget))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool.not (u32.eq (call compiler_job_budget (bool false) (u32 7) (i32 6)) (u32 1)))
				(then (return (i32 1))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 7) (i32 6)) (u32 7)))
				(then (return (i32 2))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 4294967295) (i32 0)) (u32 4294967295)))
				(then (return (i32 3))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 0) (i32 6)) (u32 12)))
				(then (return (i32 4))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 0) (i32 0)) (u32 2)))
				(then (return (i32 5))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 0) (i32 -1)) (u32 2)))
				(then (return (i32 6))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 0) (i32 1073741823)) (u32 2147483646)))
				(then (return (i32 7))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 0) (i32 1073741824)) (u32 2147483647)))
				(then (return (i32 8))))
			(if (bool.not (u32.eq (call compiler_job_budget (bool true) (u32 0) (i32 2147483647)) (u32 2147483647)))
				(then (return (i32 9))))
			(return (i32 0)))))
