{
	"profiles": [
		{
			"name": "default",
			"parallelJobs": 3,
			"human": true,
			"max-errors": 42,
			"color": true,
			"build": {
				"release": { "cflags": ["-O3"], "cache": true, "lto": "thin", "output": null, },
			},
			"fmt": {
				"lineWidth": 80,
			},
		},
		{
			"name": "fast",
			"parallelJobs": 8,
			"color": false,
			"build": { "release": { "cache": false, }, },
			"fmt": { "lineWidth": 104, },
		},
	],
}
