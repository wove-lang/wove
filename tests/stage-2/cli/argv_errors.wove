	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan) (type ArgSpec) (type ArgValue) parse_argv))
	(use wove-file "./fixture_data.wove" (only put_four set_arg spec))

	(fn
		(:doc "verbose | jobs | limit | enabled | no-verbose")
		fill_names
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local data)) (i32 0) (u8 118) (u8 101) (u8 114) (u8 98))
			(call put_four (borrow-mut (local data)) (i32 4) (u8 111) (u8 115) (u8 101) (u8 106))
			(call put_four (borrow-mut (local data)) (i32 8) (u8 111) (u8 98) (u8 115) (u8 108))
			(call put_four (borrow-mut (local data)) (i32 12) (u8 105) (u8 109) (u8 105) (u8 116))
			(call put_four (borrow-mut (local data)) (i32 16) (u8 101) (u8 110) (u8 97) (u8 98))
			(call put_four (borrow-mut (local data)) (i32 20) (u8 108) (u8 101) (u8 100) (u8 110))
			(call put_four (borrow-mut (local data)) (i32 24) (u8 111) (u8 45) (u8 118) (u8 101))
			(call put_four (borrow-mut (local data)) (i32 28) (u8 114) (u8 98) (u8 111) (u8 115))
			(slice.store (local data) (i32 32) (u8 101))
		))

