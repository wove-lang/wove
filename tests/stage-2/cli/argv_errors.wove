	(fn fill_specs
		(params (specs (mut-slice ArgSpec)))
		(returns void)
		(body
			(slice.store (local specs) (i32 0) (call spec (u32 1) (u32 1) (i32 0) (i32 7)))
			(slice.store (local specs) (i32 1) (call spec (u32 2) (u32 3) (i32 7) (i32 11)))
			(slice.store (local specs) (i32 2) (call spec (u32 3) (u32 4) (i32 -1) (i32 -1)))
			(slice.store (local specs) (i32 3) (call spec (u32 2) (u32 2) (i32 11) (i32 16)))
			(slice.store (local specs) (i32 4) (call spec (u32 2) (u32 1) (i32 16) (i32 23)))
		))

	(fn check_error
		(params (data (shared-slice u8)) (names (shared-slice u8)) (specs (shared-slice ArgSpec))
			(count i32) (a i32) (b i32) (c i32) (d i32) (e i32) (f i32) (error u32) (index i32) (row i32))
		(returns bool)
		(body
			(let-mut argv (array.alloc ArgSpan (local count)))
			(let-mut output (array.alloc ArgValue (slice.len (local specs))))
			(call set_arg (borrow-mut (local argv)) (i32 0) (local a) (local b))
			(if (i32.lt (i32 1) (local count))
				(then (call set_arg (borrow-mut (local argv)) (i32 1) (local c) (local d))))
			(if (i32.lt (i32 2) (local count))
				(then (call set_arg (borrow-mut (local argv)) (i32 2) (local e) (local f))))
			(let parsed (call parse_argv (borrow-shared (local data)) (borrow-shared (local argv))
				(borrow-shared (local names)) (borrow-shared (local specs)) (borrow-mut (local output))))
			(return (bool.and (u32.eq (record.get (local parsed) error) (local error))
				(bool.and (i32.eq (record.get (local parsed) argv_index) (local index))
					(i32.eq (record.get (local parsed) spec_index) (local row)))))))

	(fn colliding_spec
		(params (specs (mut-slice ArgSpec)))
		(returns void)
		(body (slice.store (local specs) (i32 4) (call spec (u32 2) (u32 4)
			(i32 23) (i32 33)))))

	(fn
		(:expect
			(tests "stage-2/cli/argv_errors.wove")
			(issues "gh:wove-lang/wove:121"))
		main
		(params)
		(returns i32)
		(body
			(let-mut args (array.alloc u8 (i32 167)))
			(let-mut names (array.alloc u8 (i32 33)))
			(let-mut specs (array.alloc ArgSpec (i32 5)))
			(call fill_args (borrow-mut (local args)))
			(call fill_names (borrow-mut (local names)))
			(call fill_specs (borrow-mut (local specs)))
			(if
				(:doc "sample | --unknown")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 2) (i32 0) (i32 6) (i32 6) (i32 15) (i32 0) (i32 0)
					(u32 1) (i32 1) (i32 -1)))
				(then (return (i32 1))))
			(if
				(:doc "--verbose | --jobs")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 2) (i32 15) (i32 24) (i32 24) (i32 30) (i32 0) (i32 0)
					(u32 2) (i32 1) (i32 1)))
				(then (return (i32 2))))
			(if
				(:doc "sample | --jobs | --verbose")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 3) (i32 0) (i32 6) (i32 24) (i32 30) (i32 15) (i32 24)
					(u32 2) (i32 1) (i32 1)))
				(then (return (i32 3))))
			(if
				(:doc "--jobs | zero")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 2) (i32 24) (i32 30) (i32 30) (i32 34) (i32 0) (i32 0)
					(u32 3) (i32 1) (i32 1)))
				(then (return (i32 4))))
			(if
				(:doc "--jobs=4294967296")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 34) (i32 51) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 1)))
				(then (return (i32 5))))
			(if
				(:doc "--limit=-2147483649")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 51) (i32 70) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 3)))
				(then (return (i32 6))))
			(if
				(:doc "--limit=2147483648")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 70) (i32 88) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 3)))
				(then (return (i32 7))))
			(if
				(:doc "--jobs=-0")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 88) (i32 97) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 1)))
				(then (return (i32 8))))
			(if
				(:doc "--verbose=false")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 97) (i32 112) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 0)))
				(then (return (i32 9))))
			(if
				(:doc "--verbose | --no-verbose")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 2) (i32 15) (i32 24) (i32 112) (i32 124) (i32 0) (i32 0)
					(u32 5) (i32 1) (i32 0)))
				(then (return (i32 10))))
			(if
				(:doc "--no-jobs")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 124) (i32 133) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 1) (i32 0) (i32 -1)))
				(then (return (i32 11))))
			(if
				(:doc "-- | x | y")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 3) (i32 133) (i32 135) (i32 135) (i32 136) (i32 136) (i32 137)
					(u32 4) (i32 2) (i32 -1)))
				(then (return (i32 12))))
			(if
				(:doc "--enabled=maybe")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 137) (i32 152) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 4)))
				(then (return (i32 13))))
			(if
				(:doc "--jobs=")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 152) (i32 159) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 3) (i32 0) (i32 1)))
				(then (return (i32 14))))
			(if
				(:doc "--jobs | --")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 2) (i32 24) (i32 30) (i32 133) (i32 135) (i32 0) (i32 0)
					(u32 2) (i32 0) (i32 1)))
				(then (return (i32 15))))
			(if
				(:doc "--limit | -")
				(bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 2) (i32 159) (i32 166) (i32 166) (i32 167) (i32 0) (i32 0)
					(u32 3) (i32 1) (i32 3)))
				(then (return (i32 16))))
			(if (bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 1) (i32 -1) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 7) (i32 0) (i32 -1)))
				(then (return (i32 20))))
			(let empty (array.alloc ArgSpan (i32 0)))
			(let-mut too_short (array.alloc ArgValue (i32 4)))
			(let capacity (call parse_argv (borrow-shared (local args)) (borrow-shared (local empty))
				(borrow-shared (local names)) (borrow-shared (local specs)) (borrow-mut (local too_short))))
			(if (bool.not (u32.eq (record.get (local capacity) error) (u32 8)))
				(then (return (i32 22))))
			(call colliding_spec (borrow-mut (local specs)))
			(if (bool.not (call check_error (borrow-shared (local args)) (borrow-shared (local names))
					(borrow-shared (local specs)) (i32 1) (i32 0) (i32 0) (i32 0) (i32 0) (i32 0) (i32 0)
					(u32 6) (i32 -1) (i32 4)))
				(then (return (i32 21))))
			(return (i32 0)))))
