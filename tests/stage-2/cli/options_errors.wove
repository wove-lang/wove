(module compiler_option_errors_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/cli/options.wove" (only resolve_compiler_options))
	(use wove-file "../../../stage-2/config/compiler.wove" (only (type CompilerOptions)))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "./fixture_data.wove" (only put_four set_arg))

	(fn fill_configs
		(:doc "Pack the config fixture documents as separate spans.")
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(call
				(:doc "{\"human\":}")
				put_four (borrow-mut (local bytes)) (i32 0) (u8 123) (u8 34) (u8 104) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 4) (u8 109) (u8 97) (u8 110) (u8 34))
			(slice.store (local bytes) (i32 8) (u8 58))
			(slice.store (local bytes) (i32 9) (u8 125))

			(slice.store
				(:doc "[]")
				(local bytes) (i32 10) (u8 91))
			(slice.store (local bytes) (i32 11) (u8 93))

			(call
				(:doc "{\"human\":0}")
				put_four (borrow-mut (local bytes)) (i32 12) (u8 123) (u8 34) (u8 104) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 16) (u8 109) (u8 97) (u8 110) (u8 34))
			(slice.store (local bytes) (i32 20) (u8 58))
			(slice.store (local bytes) (i32 21) (u8 48))
			(slice.store (local bytes) (i32 22) (u8 125))

			(call
				(:doc "{\"color\":\"false\"}")
				put_four (borrow-mut (local bytes)) (i32 23) (u8 123) (u8 34) (u8 99) (u8 111))
			(call put_four (borrow-mut (local bytes)) (i32 27) (u8 108) (u8 111) (u8 114) (u8 34))
			(call put_four (borrow-mut (local bytes)) (i32 31) (u8 58) (u8 34) (u8 102) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 35) (u8 108) (u8 115) (u8 101) (u8 34))
			(slice.store (local bytes) (i32 39) (u8 125))

			(call
				(:doc "{\"max-errors\":4294967296}")
				put_four (borrow-mut (local bytes)) (i32 40) (u8 123) (u8 34) (u8 109) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 44) (u8 120) (u8 45) (u8 101) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 48) (u8 114) (u8 111) (u8 114) (u8 115))
			(call put_four (borrow-mut (local bytes)) (i32 52) (u8 34) (u8 58) (u8 52) (u8 50))
			(call put_four (borrow-mut (local bytes)) (i32 56) (u8 57) (u8 52) (u8 57) (u8 54))
			(call put_four (borrow-mut (local bytes)) (i32 60) (u8 55) (u8 50) (u8 57) (u8 54))
			(slice.store (local bytes) (i32 64) (u8 125))

			(call
				(:doc "{\"max-errors\":1.0}")
				put_four (borrow-mut (local bytes)) (i32 65) (u8 123) (u8 34) (u8 109) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 69) (u8 120) (u8 45) (u8 101) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 73) (u8 114) (u8 111) (u8 114) (u8 115))
			(call put_four (borrow-mut (local bytes)) (i32 77) (u8 34) (u8 58) (u8 49) (u8 46))
			(slice.store (local bytes) (i32 81) (u8 48))
			(slice.store (local bytes) (i32 82) (u8 125))

			(call
				(:doc "{\"max-errors\":-0}")
				put_four (borrow-mut (local bytes)) (i32 83) (u8 123) (u8 34) (u8 109) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 87) (u8 120) (u8 45) (u8 101) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 91) (u8 114) (u8 111) (u8 114) (u8 115))
			(call put_four (borrow-mut (local bytes)) (i32 95) (u8 34) (u8 58) (u8 45) (u8 48))
			(slice.store (local bytes) (i32 99) (u8 125))

			(call
				(:doc "{\"human\":true,\"h\\u0075man\":false}")
				put_four (borrow-mut (local bytes)) (i32 100) (u8 123) (u8 34) (u8 104) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 104) (u8 109) (u8 97) (u8 110) (u8 34))
			(call put_four (borrow-mut (local bytes)) (i32 108) (u8 58) (u8 116) (u8 114) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 112) (u8 101) (u8 44) (u8 34) (u8 104))
			(call put_four (borrow-mut (local bytes)) (i32 116) (u8 92) (u8 117) (u8 48) (u8 48))
			(call put_four (borrow-mut (local bytes)) (i32 120) (u8 55) (u8 53) (u8 109) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 124) (u8 110) (u8 34) (u8 58) (u8 102))
			(call put_four (borrow-mut (local bytes)) (i32 128) (u8 97) (u8 108) (u8 115) (u8 101))
			(slice.store (local bytes) (i32 132) (u8 125))

			(call
				(:doc "{\"unknown-option\":0}")
				put_four (borrow-mut (local bytes)) (i32 133) (u8 123) (u8 34) (u8 117) (u8 110))
			(call put_four (borrow-mut (local bytes)) (i32 137) (u8 107) (u8 110) (u8 111) (u8 119))
			(call put_four (borrow-mut (local bytes)) (i32 141) (u8 110) (u8 45) (u8 111) (u8 112))
			(call put_four (borrow-mut (local bytes)) (i32 145) (u8 116) (u8 105) (u8 111) (u8 110))
			(call put_four (borrow-mut (local bytes)) (i32 149) (u8 34) (u8 58) (u8 48) (u8 125))

			(call
				(:doc "{\"extra\":0}")
				put_four (borrow-mut (local bytes)) (i32 153) (u8 123) (u8 34) (u8 101) (u8 120))
			(call put_four (borrow-mut (local bytes)) (i32 157) (u8 116) (u8 114) (u8 97) (u8 34))
			(slice.store (local bytes) (i32 161) (u8 58))
			(slice.store (local bytes) (i32 162) (u8 48))
			(slice.store (local bytes) (i32 163) (u8 125))
		))

	(fn fill_argv_bytes
		(:doc "--human | --unknown | --max-errors | no | --max-errors=0")
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local bytes)) (i32 0) (u8 45) (u8 45) (u8 104) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 4) (u8 109) (u8 97) (u8 110) (u8 45))
			(call put_four (borrow-mut (local bytes)) (i32 8) (u8 45) (u8 117) (u8 110) (u8 107))
			(call put_four (borrow-mut (local bytes)) (i32 12) (u8 110) (u8 111) (u8 119) (u8 110))
			(call put_four (borrow-mut (local bytes)) (i32 16) (u8 45) (u8 45) (u8 109) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 20) (u8 120) (u8 45) (u8 101) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 24) (u8 114) (u8 111) (u8 114) (u8 115))
			(call put_four (borrow-mut (local bytes)) (i32 28) (u8 110) (u8 111) (u8 45) (u8 45))
			(call put_four (borrow-mut (local bytes)) (i32 32) (u8 109) (u8 97) (u8 120) (u8 45))
			(call put_four (borrow-mut (local bytes)) (i32 36) (u8 101) (u8 114) (u8 114) (u8 111))
			(call put_four (borrow-mut (local bytes)) (i32 40) (u8 114) (u8 115) (u8 61) (u8 48))
		))

	(fn set_unknown
		(params (argv (mut-slice ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 0) (i32 7))
			(call set_arg (borrow-mut (local argv)) (i32 1) (i32 7) (i32 16))
		))

	(fn set_missing
		(params (argv (mut-slice ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 0) (i32 7))
			(call set_arg (borrow-mut (local argv)) (i32 1) (i32 16) (i32 28))
		))

	(fn set_invalid
		(params (argv (mut-slice ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 0) (i32 7))
			(call set_arg (borrow-mut (local argv)) (i32 1) (i32 16) (i32 28))
			(call set_arg (borrow-mut (local argv)) (i32 2) (i32 28) (i32 30))
		))

	(fn set_override
		(params (argv (mut-slice ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 30) (i32 44))
		))

	(fn set_sentinel
		(params (output (mut-slice CompilerOptions)))
		(returns void)
		(body (slice.store (local output) (i32 0)
			(record.make CompilerOptions (human (bool true)) (max_errors (u32 123)) (color (bool false))))))

	(fn unchanged
		(params (output (shared-slice CompilerOptions)))
		(returns bool)
		(body
			(let options (slice.load (local output) (i32 0)))
			(return (bool.and (record.get (local options) human)
				(bool.and (u32.eq (record.get (local options) max_errors) (u32 123))
					(bool.not (record.get (local options) color)))))))

	(fn check_failure
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (config (shared-slice u8)) (supplied bool)
			(source u32) (error u32) (start i32) (end i32) (index i32) (spec i32))
		(returns bool)
		(body
			(let-mut nodes (array.alloc JsonNode (i32 8)))
			(let-mut output (array.alloc CompilerOptions (i32 1)))
			(call set_sentinel (borrow-mut (local output)))
			(let result (call resolve_compiler_options (borrow-shared (local bytes)) (borrow-shared (local argv))
				(local supplied) (borrow-shared (local config)) (borrow-mut (local nodes)) (borrow-mut (local output))))
			(return
				(bool.and (call unchanged (borrow-shared (local output)))
					(bool.and (bool.and (u32.eq (record.get (local result) error) (local error))
							(u32.eq (record.get (local result) source) (local source)))
						(bool.and
							(bool.and (i32.eq (record.get (local result) start) (local start))
								(i32.eq (record.get (local result) end) (local end)))
							(bool.and (i32.eq (record.get (local result) argv_index) (local index))
								(i32.eq (record.get (local result) spec_index) (local spec)))))))))

	(fn main
		(:expect
			(tests "stage-2/cli/options_errors.wove")
			(issues "gh:wove-lang/wove:123"))
		(params)
		(returns i32)
		(body
			(let-mut config (array.alloc u8 (i32 164)))
			(let-mut argv (array.alloc u8 (i32 44)))
			(let empty (array.alloc ArgSpan (i32 0)))
			(let-mut unknown (array.alloc ArgSpan (i32 2)))
			(let-mut missing (array.alloc ArgSpan (i32 2)))
			(let-mut invalid (array.alloc ArgSpan (i32 3)))
			(let-mut override (array.alloc ArgSpan (i32 1)))
			(call fill_configs (borrow-mut (local config)))
			(call fill_argv_bytes (borrow-mut (local argv)))
			(call set_unknown (borrow-mut (local unknown)))
			(call set_missing (borrow-mut (local missing)))
			(call set_invalid (borrow-mut (local invalid)))
			(call set_override (borrow-mut (local override)))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 0) (i32 0))) (bool true) (u32 1) (u32 2) (i32 0) (i32 0) (i32 -1) (i32 -1)))
				(then (return (i32 1))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 0) (i32 10))) (bool true) (u32 1) (u32 2) (i32 9) (i32 10) (i32 -1) (i32 -1)))
				(then (return (i32 2))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 10) (i32 12))) (bool true) (u32 1) (u32 13) (i32 0) (i32 2) (i32 -1) (i32 -1)))
				(then (return (i32 3))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 12) (i32 23))) (bool true) (u32 1) (u32 16) (i32 9) (i32 10) (i32 -1) (i32 -1)))
				(then (return (i32 4))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 23) (i32 40))) (bool true) (u32 1) (u32 16) (i32 9) (i32 16) (i32 -1) (i32 -1)))
				(then (return (i32 5))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 40) (i32 65))) (bool true) (u32 1) (u32 16) (i32 14) (i32 24) (i32 -1) (i32 -1)))
				(then (return (i32 6))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 65) (i32 83))) (bool true) (u32 1) (u32 16) (i32 14) (i32 17) (i32 -1) (i32 -1)))
				(then (return (i32 7))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 83) (i32 100))) (bool true) (u32 1) (u32 16) (i32 14) (i32 16) (i32 -1) (i32 -1)))
				(then (return (i32 8))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 100) (i32 133))) (bool true) (u32 1) (u32 15) (i32 14) (i32 26) (i32 -1) (i32 -1)))
				(then (return (i32 9))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 133) (i32 153))) (bool true) (u32 1) (u32 14) (i32 1) (i32 17) (i32 -1) (i32 -1)))
				(then (return (i32 10))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 153) (i32 164))) (bool true) (u32 1) (u32 14) (i32 1) (i32 8) (i32 -1) (i32 -1)))
				(then (return (i32 11))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local unknown))
					(borrow-shared (slice.range (local config) (i32 0) (i32 0))) (bool false) (u32 2) (u32 1) (i32 -1) (i32 -1) (i32 1) (i32 -1)))
				(then (return (i32 20))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local missing))
					(borrow-shared (slice.range (local config) (i32 0) (i32 0))) (bool false) (u32 2) (u32 2) (i32 -1) (i32 -1) (i32 1) (i32 1)))
				(then (return (i32 21))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local invalid))
					(borrow-shared (slice.range (local config) (i32 0) (i32 0))) (bool false) (u32 2) (u32 3) (i32 -1) (i32 -1) (i32 2) (i32 1)))
				(then (return (i32 22))))
			(if (bool.not (call check_failure (borrow-shared (local argv)) (borrow-shared (local override))
					(borrow-shared (slice.range (local config) (i32 40) (i32 65))) (bool true) (u32 1) (u32 16) (i32 14) (i32 24) (i32 -1) (i32 -1)))
				(then (return (i32 23))))
			(return (i32 0)))))
