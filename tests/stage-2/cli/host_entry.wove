(module host_entry_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (not bootstrap))) wove-file "../../../stage-2/cli/argv.wove"
		(only (type (as ArgSpan HostSpan)) (type ArgSpec) (type ArgValue) parse_argv))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:pragma (cfg bootstrap))
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body (return (i32 17))))

	(fn main
		(:pragma (cfg (not bootstrap)))
		(:expect (tests "stage-2/scalar_graphs.tsv" "stage-2/cli/cases.tsv") (issues "gh:wove-lang/wove:148"))
		(params (bytes (shared-slice u8)) (argv (shared-slice HostSpan)))
		(returns i32)
		(body
			(let-mut names (array.alloc u8 (i32 4)))
			(let-mut specs (array.alloc ArgSpec (i32 3)))
			(let-mut values (array.alloc ArgValue (i32 3)))
			(return (call check_args (borrow-shared (local bytes)) (borrow-shared (local argv))
				(borrow-mut (local names)) (borrow-mut (local specs)) (borrow-mut (local values))))))

	(fn check_args
		(:pragma (cfg (not bootstrap)))
		(params (bytes (shared-slice u8)) (argv (shared-slice HostSpan))
			(names (mut-slice u8)) (specs (mut-slice ArgSpec)) (values (mut-slice ArgValue)))
		(returns i32)
		(body
			(slice.store (local names) (i32 0) (u8 102))
			(slice.store (local names) (i32 1) (u8 108))
			(slice.store (local names) (i32 2) (u8 97))
			(slice.store (local names) (i32 3) (u8 103))
			(slice.store (local specs) (i32 0)
				(struct.new ArgSpec (form (u32 1)) (value_kind (u32 1)) (name_start (i32 0)) (name_end (i32 4))))
			(let positional (struct.new ArgSpec (form (u32 3)) (value_kind (u32 4)) (name_start (i32 0)) (name_end (i32 0))))
			(slice.store (local specs) (i32 1) (local positional))
			(slice.store (local specs) (i32 2) (local positional))
			(let parsed (call parse_argv (borrow-shared (local bytes)) (borrow-shared (local argv))
				(borrow-shared (local names)) (borrow-shared (local specs)) (borrow-mut (local values))))
			(let error (struct.get (local parsed) error))
			(if (u32.eq (local error) (u32 1))
				(then (return (i32.add.wrapping (i32 10) (struct.get (local parsed) argv_index)))))
			(if (u32.lt (u32 0) (local error))
				(then (return (i32 1))))
			(let flag (slice.load (local values) (i32 0)))
			(let text (slice.load (local values) (i32 1)))
			(let empty (slice.load (local values) (i32 2)))
			(let count (slice.len (local argv)))
			(if (i32.eq (local count) (i32 0))
				(then
					(if (bool.or (bool.not (i32.eq (slice.len (local bytes)) (i32 0)))
						(bool.or (struct.get (local flag) present)
							(bool.or (struct.get (local text) present) (struct.get (local empty) present))))
						(then (return (i32 2))))
					(return (i32 0))))
			(if (bool.not (bool.and (i32.eq (local count) (i32 3)) (i32.eq (slice.len (local bytes)) (i32 9))))
				(then (return (i32 3))))
			(if (bool.not (bool.and (struct.get (local flag) present)
				(bool.and (struct.get (local flag) bool_value) (i32.eq (struct.get (local flag) argv_index) (i32 0)))))
				(then (return (i32 4))))
			(if (bool.not (bool.and (struct.get (local text) present) (i32.eq (struct.get (local text) argv_index) (i32 1))))
				(then (return (i32 5))))
			(if (bool.not (bool.and (i32.eq (struct.get (local text) start) (i32 6)) (i32.eq (struct.get (local text) end) (i32 9))))
				(then (return (i32 6))))
			(if (bool.not (bool.and (struct.get (local empty) present) (i32.eq (struct.get (local empty) argv_index) (i32 2))))
				(then (return (i32 7))))
			(if (bool.not (bool.and (i32.eq (struct.get (local empty) start) (i32 9)) (i32.eq (struct.get (local empty) end) (i32 9))))
				(then (return (i32 8))))
			(if (bool.and (u8.eq (slice.load (local bytes) (i32 6)) (u8 97))
				(bool.and (u8.eq (slice.load (local bytes) (i32 7)) (u8 32)) (u8.eq (slice.load (local bytes) (i32 8)) (u8 98))))
				(then (return (i32 42))))
			(return (i32 9)))))
