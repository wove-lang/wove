(module host_entry_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (not bootstrap))) wove-file "../../../stage-2/cli/argv.wove"
		(only (type (as ArgSpan HostSpan)) (type ArgSpec) (type ArgValue) parse_argv))

	(fn main
		(:pragma (cfg bootstrap))
		(params (entry (shared-array (shared-array u8))))
		(returns i32)
		(body (return (i32 17))))

	(fn main
		(:pragma (cfg (not bootstrap)))
		(:expect (tests "stage-2/scalar_graphs.tsv" "stage-2/cli/cases.tsv") (issues "gh:wove-lang/wove:148"))
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (array:len argv))
			(let-mut length 0i32)
			(let-mut index 1i32)
			(while (i32:lt index count)
				(body
					(set length (i32:add length (array:len (array:load argv index))))
					(set index (i32:inc index))))
			(let-mut bytes (array:alloc u8 length))
			(let-mut spans (array:alloc HostSpan (i32:dec count)))
			(let-mut offset 0i32)
			(set index 1i32)
			(while (i32:lt index count)
				(body
					(let row (array:load argv index))
					(let end (i32:add offset (array:len row)))
					(let copied (array:try-copy-from (borrow-mut (array:range bytes offset end))
						(borrow-shared row)))
					(if (bool:not copied) (then (return 16i32)))
					(array:store spans (i32:dec index)
						(struct:new HostSpan (start offset) (end end)))
					(set offset end)
					(set index (i32:inc index))))
			(let-mut names (array:alloc u8 (i32 4)))
			(let-mut specs (array:alloc ArgSpec (i32 3)))
			(let-mut values (array:alloc ArgValue (i32 3)))
			(return (call check_args (borrow-shared bytes) (borrow-shared spans)
				(borrow-mut names) (borrow-mut specs) (borrow-mut values)))))

	(fn check_args
		(:pragma (cfg (not bootstrap)))
		(params (bytes (shared-array u8)) (argv (shared-array HostSpan))
			(names (mut-array u8)) (specs (mut-array ArgSpec)) (values (mut-array ArgValue)))
		(returns i32)
		(body
			(array:store names (i32 0) (u8 102))
			(array:store names (i32 1) (u8 108))
			(array:store names (i32 2) (u8 97))
			(array:store names (i32 3) (u8 103))
			(array:store specs (i32 0)
				(struct:new ArgSpec (form (u32 1)) (value_kind (u32 1)) (name_start (i32 0)) (name_end (i32 4))))
			(let positional (struct:new ArgSpec (form (u32 3)) (value_kind (u32 4)) (name_start (i32 0)) (name_end (i32 0))))
			(array:store specs (i32 1) positional)
			(array:store specs (i32 2) positional)
			(let parsed (call parse_argv (borrow-shared bytes) (borrow-shared argv)
				(borrow-shared names) (borrow-shared specs) (borrow-mut values)))
			(let error (struct:get parsed error))
			(if (u32:eq error (u32 1))
				(then (return (i32:add (i32 10) (struct:get parsed argv_index)))))
			(if (u32:lt (u32 0) error)
				(then (return (i32 1))))
			(let flag (array:load values (i32 0)))
			(let text (array:load values (i32 1)))
			(let empty (array:load values (i32 2)))
			(let count (array:len argv))
			(if (i32:eq count (i32 0))
				(then
					(if (bool:or (bool:not (i32:eq (array:len bytes) (i32 0)))
						(bool:or (struct:get flag present)
							(bool:or (struct:get text present) (struct:get empty present))))
						(then (return (i32 2))))
					(return (i32 0))))
			(if (bool:not (bool:and (i32:eq count (i32 3)) (i32:eq (array:len bytes) (i32 9))))
				(then (return (i32 3))))
			(if (bool:not (bool:and (struct:get flag present)
				(bool:and (struct:get flag bool_value) (i32:eq (struct:get flag argv_index) (i32 0)))))
				(then (return (i32 4))))
			(if (bool:not (bool:and (struct:get text present) (i32:eq (struct:get text argv_index) (i32 1))))
				(then (return (i32 5))))
			(if (bool:not (bool:and (i32:eq (struct:get text start) (i32 6)) (i32:eq (struct:get text end) (i32 9))))
				(then (return (i32 6))))
			(if (bool:not (bool:and (struct:get empty present) (i32:eq (struct:get empty argv_index) (i32 2))))
				(then (return (i32 7))))
			(if (bool:not (bool:and (i32:eq (struct:get empty start) (i32 9)) (i32:eq (struct:get empty end) (i32 9))))
				(then (return (i32 8))))
			(if (bool:and (u8:eq (array:load bytes (i32 6)) (u8 97))
				(bool:and (u8:eq (array:load bytes (i32 7)) (u8 32)) (u8:eq (array:load bytes (i32 8)) (u8 98))))
				(then (return (i32 42))))
			(return (i32 9)))))
