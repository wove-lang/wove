(module argv_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan) (type ArgSpec) (type ArgValue) parse_argv))
	(use wove-file "./fixture_data.wove" (only put_four set_arg spec))

	(fn fill_names
		(:doc "color | jobs | verbose | limit | enabled | unused | count")
		(params (data (mut-array u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local data)) (i32 0) (u8 99) (u8 111) (u8 108) (u8 111))
			(call put_four (borrow-mut (local data)) (i32 4) (u8 114) (u8 106) (u8 111) (u8 98))
			(call put_four (borrow-mut (local data)) (i32 8) (u8 115) (u8 118) (u8 101) (u8 114))
			(call put_four (borrow-mut (local data)) (i32 12) (u8 98) (u8 111) (u8 115) (u8 101))
			(call put_four (borrow-mut (local data)) (i32 16) (u8 108) (u8 105) (u8 109) (u8 105))
			(call put_four (borrow-mut (local data)) (i32 20) (u8 116) (u8 101) (u8 110) (u8 97))
			(call put_four (borrow-mut (local data)) (i32 24) (u8 98) (u8 108) (u8 101) (u8 100))
			(call put_four (borrow-mut (local data)) (i32 28) (u8 117) (u8 110) (u8 117) (u8 115))
			(call put_four (borrow-mut (local data)) (i32 32) (u8 101) (u8 100) (u8 99) (u8 111))
			(array.store (local data) (i32 36) (u8 117))
			(array.store (local data) (i32 37) (u8 110))
			(array.store (local data) (i32 38) (u8 116))
		))

	(fn fill_args
		(:doc "--no-color | --jobs | +0 | --verbose | --limit=-2147483648 | --enabled=true | -- | --literal | 4294967295")
		(params (data (mut-array u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local data)) (i32 0) (u8 45) (u8 45) (u8 110) (u8 111))
			(call put_four (borrow-mut (local data)) (i32 4) (u8 45) (u8 99) (u8 111) (u8 108))
			(call put_four (borrow-mut (local data)) (i32 8) (u8 111) (u8 114) (u8 45) (u8 45))
			(call put_four (borrow-mut (local data)) (i32 12) (u8 106) (u8 111) (u8 98) (u8 115))
			(call put_four (borrow-mut (local data)) (i32 16) (u8 43) (u8 48) (u8 45) (u8 45))
			(call put_four (borrow-mut (local data)) (i32 20) (u8 118) (u8 101) (u8 114) (u8 98))
			(call put_four (borrow-mut (local data)) (i32 24) (u8 111) (u8 115) (u8 101) (u8 45))
			(call put_four (borrow-mut (local data)) (i32 28) (u8 45) (u8 108) (u8 105) (u8 109))
			(call put_four (borrow-mut (local data)) (i32 32) (u8 105) (u8 116) (u8 61) (u8 45))
			(call put_four (borrow-mut (local data)) (i32 36) (u8 50) (u8 49) (u8 52) (u8 55))
			(call put_four (borrow-mut (local data)) (i32 40) (u8 52) (u8 56) (u8 51) (u8 54))
			(call put_four (borrow-mut (local data)) (i32 44) (u8 52) (u8 56) (u8 45) (u8 45))
			(call put_four (borrow-mut (local data)) (i32 48) (u8 101) (u8 110) (u8 97) (u8 98))
			(call put_four (borrow-mut (local data)) (i32 52) (u8 108) (u8 101) (u8 100) (u8 61))
			(call put_four (borrow-mut (local data)) (i32 56) (u8 116) (u8 114) (u8 117) (u8 101))
			(call put_four (borrow-mut (local data)) (i32 60) (u8 45) (u8 45) (u8 45) (u8 45))
			(call put_four (borrow-mut (local data)) (i32 64) (u8 108) (u8 105) (u8 116) (u8 101))
			(call put_four (borrow-mut (local data)) (i32 68) (u8 114) (u8 97) (u8 108) (u8 52))
			(call put_four (borrow-mut (local data)) (i32 72) (u8 50) (u8 57) (u8 52) (u8 57))
			(call put_four (borrow-mut (local data)) (i32 76) (u8 54) (u8 55) (u8 50) (u8 57))
			(array.store (local data) (i32 80) (u8 53))
		))

	(fn fill_specs
		(params (specs (mut-array ArgSpec)))
		(returns void)
		(body
			(array.store (local specs) (i32 0) (call spec (u32 1) (u32 1) (i32 0) (i32 5)))
			(array.store (local specs) (i32 1) (call spec (u32 2) (u32 3) (i32 5) (i32 9)))
			(array.store (local specs) (i32 2) (call spec (u32 3) (u32 4) (i32 -1) (i32 -1)))
			(array.store (local specs) (i32 3) (call spec (u32 1) (u32 1) (i32 9) (i32 16)))
			(array.store (local specs) (i32 4) (call spec (u32 2) (u32 2) (i32 16) (i32 21)))
			(array.store (local specs) (i32 5) (call spec (u32 2) (u32 1) (i32 21) (i32 28)))
			(array.store (local specs) (i32 6) (call spec (u32 1) (u32 1) (i32 28) (i32 34)))
			(array.store (local specs) (i32 7) (call spec (u32 2) (u32 3) (i32 34) (i32 39)))
			(array.store (local specs) (i32 8) (call spec (u32 3) (u32 3) (i32 -1) (i32 -1)))
		))

	(fn fill_spans
		(params (argv (mut-array ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 0) (i32 10))
			(call set_arg (borrow-mut (local argv)) (i32 1) (i32 10) (i32 16))
			(call set_arg (borrow-mut (local argv)) (i32 2) (i32 16) (i32 18))
			(call set_arg (borrow-mut (local argv)) (i32 3) (i32 18) (i32 27))
			(call set_arg (borrow-mut (local argv)) (i32 4) (i32 27) (i32 46))
			(call set_arg (borrow-mut (local argv)) (i32 5) (i32 46) (i32 60))
			(call set_arg (borrow-mut (local argv)) (i32 6) (i32 60) (i32 62))
			(call set_arg (borrow-mut (local argv)) (i32 7) (i32 62) (i32 71))
			(call set_arg (borrow-mut (local argv)) (i32 8) (i32 71) (i32 81))
		))

	(fn row_matches
		(params (out (shared-array ArgValue)) (row i32) (kind u32) (index i32) (start i32) (end i32))
		(returns bool)
		(body
			(let value (array.load (local out) (local row)))
			(return (bool.and
				(bool.or (bool.and (struct.get (local value) present) (bool.not (i32.lt (local index) (i32 0))))
					(bool.and (bool.not (struct.get (local value) present)) (i32.lt (local index) (i32 0))))
				(bool.and (u32.eq (struct.get (local value) kind) (local kind))
					(bool.and (i32.eq (struct.get (local value) argv_index) (local index))
						(bool.and (i32.eq (struct.get (local value) start) (local start))
							(i32.eq (struct.get (local value) end) (local end)))))))))

	(fn check_values
		(params (out (shared-array ArgValue)))
		(returns i32)
		(body
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 0) (u32 1)
					(i32 0) (i32 -1) (i32 -1)))
				(then (return (i32 2))))
			(if (struct.get (array.load (local out) (i32 0)) bool_value)
				(then (return (i32 20))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 1) (u32 3)
					(i32 2) (i32 16) (i32 18)))
				(then (return (i32 3))))
			(if (bool.not (u32.eq (struct.get (array.load (local out) (i32 1)) u32_value) (u32 0)))
				(then (return (i32 21))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 2) (u32 4)
					(i32 7) (i32 62) (i32 71)))
				(then (return (i32 4))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 3) (u32 1)
					(i32 3) (i32 -1) (i32 -1)))
				(then (return (i32 5))))
			(if (bool.not (struct.get (array.load (local out) (i32 3)) bool_value))
				(then (return (i32 23))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 4) (u32 2)
					(i32 4) (i32 35) (i32 46)))
				(then (return (i32 6))))
			(if (bool.not (i32.eq (struct.get (array.load (local out) (i32 4)) i32_value) (i32 -2147483648)))
				(then (return (i32 24))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 5) (u32 1)
					(i32 5) (i32 56) (i32 60)))
				(then (return (i32 7))))
			(if (bool.not (struct.get (array.load (local out) (i32 5)) bool_value))
				(then (return (i32 25))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 6) (u32 1)
					(i32 -1) (i32 -1) (i32 -1)))
				(then (return (i32 8))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 7) (u32 3)
					(i32 -1) (i32 -1) (i32 -1)))
				(then (return (i32 9))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 8) (u32 3)
					(i32 8) (i32 71) (i32 81)))
				(then (return (i32 10))))
			(if (bool.not (u32.eq (struct.get (array.load (local out) (i32 8)) u32_value) (u32 4294967295)))
				(then (return (i32 28))))
			(return (i32 0))))

	(fn main
		(:expect
			(tests "stage-2/cli/argv.wove")
			(issues "gh:wove-lang/wove:121"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut names (array.alloc u8 (i32 39)))
			(let-mut args (array.alloc u8 (i32 81)))
			(let-mut specs (array.alloc ArgSpec (i32 9)))
			(let-mut spans (array.alloc ArgSpan (i32 9)))
			(let-mut out (array.alloc ArgValue (i32 9)))
			(call fill_names (borrow-mut (local names)))
			(call fill_args (borrow-mut (local args)))
			(call fill_specs (borrow-mut (local specs)))
			(call fill_spans (borrow-mut (local spans)))
			(let parsed (call parse_argv (borrow-shared (local args)) (borrow-shared (local spans))
				(borrow-shared (local names)) (borrow-shared (local specs)) (borrow-mut (local out))))
			(if (bool.not (u32.eq (struct.get (local parsed) error) (u32 0)))
				(then (return (i32 1))))
			(let status (call check_values (borrow-shared (local out))))
			(if (bool.not (i32.eq (local status) (i32 0))) (then (return (local status))))
			(let empty (array.alloc ArgSpan (i32 0)))
			(let second (call parse_argv (borrow-shared (local args)) (borrow-shared (local empty))
				(borrow-shared (local names)) (borrow-shared (local specs)) (borrow-mut (local out))))
			(if (bool.not (u32.eq (struct.get (local second) error) (u32 0)))
				(then (return (i32 30))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 0) (u32 1) (i32 -1) (i32 -1) (i32 -1)))
				(then (return (i32 31))))
			(if (bool.not (call row_matches (borrow-shared (local out)) (i32 1) (u32 3) (i32 -1) (i32 -1) (i32 -1)))
				(then (return (i32 32))))
			(return (i32 0)))))
