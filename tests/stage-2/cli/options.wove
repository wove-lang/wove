(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	compiler_options_fixture

	(use wove-file "../../../stage-2/cli/options.wove" (only resolve_compiler_options))
	(use wove-file "../../../stage-2/config/compiler.wove" (only (type CompilerOptions)))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "./fixture_data.wove" (only put_four set_arg))

	(fn
		(:doc "Pack the config fixture documents as separate spans.")
		fill_configs
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(call
				(:doc "/* defaults from the project */ {\"h\\u0075man\":true,\"max-errors\":7,\"color\":false}")
				put_four (borrow-mut (local bytes)) (i32 0) (u8 47) (u8 42) (u8 32) (u8 100))
			(call put_four (borrow-mut (local bytes)) (i32 4) (u8 101) (u8 102) (u8 97) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 8) (u8 108) (u8 116) (u8 115) (u8 32))
			(call put_four (borrow-mut (local bytes)) (i32 12) (u8 102) (u8 114) (u8 111) (u8 109))
			(call put_four (borrow-mut (local bytes)) (i32 16) (u8 32) (u8 116) (u8 104) (u8 101))
			(call put_four (borrow-mut (local bytes)) (i32 20) (u8 32) (u8 112) (u8 114) (u8 111))
			(call put_four (borrow-mut (local bytes)) (i32 24) (u8 106) (u8 101) (u8 99) (u8 116))
			(call put_four (borrow-mut (local bytes)) (i32 28) (u8 32) (u8 42) (u8 47) (u8 32))
			(call put_four (borrow-mut (local bytes)) (i32 32) (u8 123) (u8 34) (u8 104) (u8 92))
			(call put_four (borrow-mut (local bytes)) (i32 36) (u8 117) (u8 48) (u8 48) (u8 55))
			(call put_four (borrow-mut (local bytes)) (i32 40) (u8 53) (u8 109) (u8 97) (u8 110))
			(call put_four (borrow-mut (local bytes)) (i32 44) (u8 34) (u8 58) (u8 116) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 48) (u8 117) (u8 101) (u8 44) (u8 34))
			(call put_four (borrow-mut (local bytes)) (i32 52) (u8 109) (u8 97) (u8 120) (u8 45))
			(call put_four (borrow-mut (local bytes)) (i32 56) (u8 101) (u8 114) (u8 114) (u8 111))
			(call put_four (borrow-mut (local bytes)) (i32 60) (u8 114) (u8 115) (u8 34) (u8 58))
			(call put_four (borrow-mut (local bytes)) (i32 64) (u8 55) (u8 44) (u8 34) (u8 99))
			(call put_four (borrow-mut (local bytes)) (i32 68) (u8 111) (u8 108) (u8 111) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 72) (u8 34) (u8 58) (u8 102) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 76) (u8 108) (u8 115) (u8 101) (u8 125))

			(slice.store
				(:doc "{}")
				(local bytes) (i32 80) (u8 123))
			(slice.store (local bytes) (i32 81) (u8 125))

			(call
				(:doc "{\"max-errors\":0}")
				put_four (borrow-mut (local bytes)) (i32 82) (u8 123) (u8 34) (u8 109) (u8 97))
			(call put_four (borrow-mut (local bytes)) (i32 86) (u8 120) (u8 45) (u8 101) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 90) (u8 114) (u8 111) (u8 114) (u8 115))
			(call put_four (borrow-mut (local bytes)) (i32 94) (u8 34) (u8 58) (u8 48) (u8 125))
		))

	(fn
		(:doc "--human | --max-errors | 42 | --no-human | --max-errors=0")
		fill_argv_bytes
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local bytes)) (i32 0) (u8 45) (u8 45) (u8 104) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 4) (u8 109) (u8 97) (u8 110) (u8 45))
			(call put_four (borrow-mut (local bytes)) (i32 8) (u8 45) (u8 109) (u8 97) (u8 120))
			(call put_four (borrow-mut (local bytes)) (i32 12) (u8 45) (u8 101) (u8 114) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 16) (u8 111) (u8 114) (u8 115) (u8 52))
			(call put_four (borrow-mut (local bytes)) (i32 20) (u8 50) (u8 45) (u8 45) (u8 110))
			(call put_four (borrow-mut (local bytes)) (i32 24) (u8 111) (u8 45) (u8 104) (u8 117))
			(call put_four (borrow-mut (local bytes)) (i32 28) (u8 109) (u8 97) (u8 110) (u8 45))
			(call put_four (borrow-mut (local bytes)) (i32 32) (u8 45) (u8 109) (u8 97) (u8 120))
			(call put_four (borrow-mut (local bytes)) (i32 36) (u8 45) (u8 101) (u8 114) (u8 114))
			(call put_four (borrow-mut (local bytes)) (i32 40) (u8 111) (u8 114) (u8 115) (u8 61))
			(slice.store (local bytes) (i32 44) (u8 48))
		))

	(fn set_cli
		(params (argv (mut-slice ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 0) (i32 7))
			(call set_arg (borrow-mut (local argv)) (i32 1) (i32 7) (i32 19))
			(call set_arg (borrow-mut (local argv)) (i32 2) (i32 19) (i32 21))
		))

	(fn set_mixed
		(params (argv (mut-slice ArgSpan)))
		(returns void)
		(body
			(call set_arg (borrow-mut (local argv)) (i32 0) (i32 21) (i32 31))
			(call set_arg (borrow-mut (local argv)) (i32 1) (i32 31) (i32 45))
		))

	(fn options_match
		(params (output (shared-slice CompilerOptions)) (human bool) (max_errors u32) (color bool))
		(returns bool)
		(body
			(let options (slice.load (local output) (i32 0)))
			(return
				(bool.and
					(bool.not (bool.or
						(bool.and (local human) (bool.not (record.get (local options) human)))
						(bool.and (bool.not (local human)) (record.get (local options) human))))
					(bool.and
						(u32.eq (record.get (local options) max_errors) (local max_errors))
						(bool.not (bool.or
							(bool.and (local color) (bool.not (record.get (local options) color)))
							(bool.and (bool.not (local color)) (record.get (local options) color)))))))))

	(fn check_resolution
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (config (shared-slice u8)) (supplied bool)
			(human bool) (max_errors u32) (color bool))
		(returns bool)
		(body
			(let-mut nodes (array.alloc JsonNode (i32 4)))
			(let-mut output (array.alloc CompilerOptions (i32 1)))
			(let result (call resolve_compiler_options (borrow-shared (local bytes)) (borrow-shared (local argv))
				(local supplied) (borrow-shared (local config)) (borrow-mut (local nodes)) (borrow-mut (local output))))
			(return
				(bool.and (u32.eq (record.get (local result) error) (u32 0))
					(bool.and (u32.eq (record.get (local result) source) (u32 0))
						(call options_match (borrow-shared (local output)) (local human) (local max_errors) (local color)))))))

	(fn
		(:expect
			(tests "stage-2/cli/options.wove")
			(issues "gh:wove-lang/wove:123"))
		main
		(params)
		(returns i32)
		(body
			(let-mut config (array.alloc u8 (i32 98)))
			(let-mut argv (array.alloc u8 (i32 45)))
			(let empty (array.alloc ArgSpan (i32 0)))
			(let-mut cli (array.alloc ArgSpan (i32 3)))
			(let-mut mixed (array.alloc ArgSpan (i32 2)))
			(call fill_configs (borrow-mut (local config)))
			(call fill_argv_bytes (borrow-mut (local argv)))
			(call set_cli (borrow-mut (local cli)))
			(call set_mixed (borrow-mut (local mixed)))
			(if (bool.not (call check_resolution (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 0) (i32 0))) (bool false) (bool false) (u32 20) (bool true)))
				(then (return (i32 1))))
			(if (bool.not (call check_resolution (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 0) (i32 80))) (bool true) (bool true) (u32 7) (bool false)))
				(then (return (i32 2))))
			(if (bool.not (call check_resolution (borrow-shared (local argv)) (borrow-shared (local cli))
					(borrow-shared (slice.range (local config) (i32 0) (i32 0))) (bool false) (bool true) (u32 42) (bool true)))
				(then (return (i32 3))))
			(if (bool.not (call check_resolution (borrow-shared (local argv)) (borrow-shared (local mixed))
					(borrow-shared (slice.range (local config) (i32 0) (i32 80))) (bool true) (bool false) (u32 0) (bool false)))
				(then (return (i32 4))))
			(if (bool.not (call check_resolution (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 80) (i32 82))) (bool true) (bool false) (u32 20) (bool true)))
				(then (return (i32 5))))
			(if (bool.not (call check_resolution (borrow-shared (local argv)) (borrow-shared (local empty))
					(borrow-shared (slice.range (local config) (i32 82) (i32 98))) (bool true) (bool false) (u32 0) (bool true)))
				(then (return (i32 6))))
			(return (i32 0)))))
