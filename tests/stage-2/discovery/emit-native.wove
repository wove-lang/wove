(module test_inventory_native
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg test)) wove-file "./unavailable.wove" (only))

	(fn invalid
		(:pragma (test))
		(params (value i32))
		(returns i32)
		(body (return (local value))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:pragma (cfg (not test)))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (i32 42)))))
