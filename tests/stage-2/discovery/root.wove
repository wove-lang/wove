(module test_inventory_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../lib/left.wove" (only))
	(use wove-file "../lib/right.wove" (only))
	(use (:pragma (test)) wove-file "./test helpers.wove" (only))
	(use (:pragma (cfg test)) wove-file "./qualified.wove" (only))
	(use (:pragma (test)) c-header "<stdlib.h>" (only abs))

	(fn root_first
		(:pragma (test))
		(params)
		(returns void)
		(body (let absolute (call abs (i32 -1)))))

	(decls
		(:pragma (cfg test))
		(fn test_helper (params) (returns void) (body))
		(fn root_second
			(:pragma (test) (cfg (not bootstrap)))
			(params)
			(returns void)
			(body (return))))

	(fn root_ordinary
		(:pragma (cfg (not test)))
		(params)
		(returns void)
		(body))

	(fn bootstrap_only_test
		(:pragma (test) (cfg bootstrap))
		(params)
		(returns void)
		(body)))
