(module conversion_high_bit_trap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (call signed (u32 2147483648)))))
	(fn signed (params (value u32)) (returns i32)
		(body
			(return (int.convert i32 (local value))))))
