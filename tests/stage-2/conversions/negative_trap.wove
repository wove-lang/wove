(module conversion_negative_trap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call unsigned (i32 -1)))))
	(fn unsigned (params (value i32)) (returns i32)
		(body
			(let word (int:convert u32 value))
			(return (int:convert i32 word)))))
