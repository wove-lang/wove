(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	conversion_negative_trap
	(fn main (params) (returns i32)
		(body (return (call unsigned (i32 -1)))))
	(fn unsigned (params (value i32)) (returns i32)
		(body
			(let word (int.convert u32 (local value)))
			(return (int.convert i32 (local word))))))
