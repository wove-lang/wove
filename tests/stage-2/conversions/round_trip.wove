(module conversion_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params) (returns i32)
		(body
			(if (bool.and (bool false) (u8.eq (int.convert u8 (i32 256)) (u8 0)))
				(then (return (i32 1))))
			(let widened (call widen_i32 (u8 255)))
			(let narrowed (int.convert u8 (int.convert u32 (local widened))))
			(return (i32.sub.wrapping (int.convert i32 (local narrowed)) (i32 213)))))
	(fn widen_i32 (params (byte u8)) (returns i32)
		(body (return (int.convert i32 (local byte)))))
	(fn widen_u32 (params (byte u8)) (returns u32)
		(body (return (int.convert u32 (local byte)))))
	(fn narrow_i32 (params (value i32)) (returns u8)
		(body (return (int.convert u8 (local value)))))
	(fn narrow_u32 (params (value u32)) (returns u8)
		(body
			(let byte (int.convert u8 (local value)))
			(return (local byte))))
	(fn from_word (params (value u32)) (returns i32)
		(body (return (int.convert i32 (local value)))))
	(fn from_signed (params (value i32)) (returns u32)
		(body (return (int.convert u32 (local value)))))
	(fn same_signed (params (value i32)) (returns i32)
		(body (return (int.convert i32 (local value)))))
	(fn same_word (params (value u32)) (returns u32)
		(body (return (int.convert u32 (local value))))))
