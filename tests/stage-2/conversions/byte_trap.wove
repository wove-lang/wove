(module conversion_byte_trap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body (return (call narrow (i32 256)))))
	(fn narrow (params (value i32)) (returns i32)
		(body
			(let byte (int.convert u8 (local value)))
			(return (int.convert i32 (local byte))))))
