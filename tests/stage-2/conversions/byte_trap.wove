(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	conversion_byte_trap
	(fn main (params) (returns i32)
		(body (return (call narrow (i32 256)))))
	(fn narrow (params (value i32)) (returns i32)
		(body
			(let byte (int.convert u8 (local value)))
			(return (int.convert i32 (local byte))))))
