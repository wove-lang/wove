(module runtime_numeric_csr
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn weights_for (params (count i32)) (returns (owned-array f64))
		(body
			(let weights (array:alloc f64 count))
			(return (move weights))))

	(fn set_pair (params (values (mut-array f64)) (first f64) (second f64)) (returns void)
		(body
			(array:store values 0i32 first)
			(array:store values 1i32 second)))

	(fn dot (params (weights (shared-array f64)) (vector (shared-array f64))) (returns f64)
		(body
			(let-mut total 0.0f64)
			(let-mut index 0i32)
			(while (i32:lt index (array:len weights))
				(body
					(set total (f64:add total
						(f64:mul (array:load weights index) (array:load vector index))))
					(set index (i32:add index 1i32))))
			(return total)))

	(fn length (params (values (shared-array f64))) (returns i32)
		(body (return (array:len values))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32:add (i32:dec (array:len args)) 3i32))
			(let-mut weights (call weights_for count))
			(let vector_count (i32:add count 1i32))
			(let-mut vectors (array:alloc f64 vector_count))
			(let zero (array:alloc f64 (i32:sub count count)))
			(if (bool:not (i32:eq (call length (borrow-shared zero)) 0i32)) (then (return 1i32)))
			(if (bool:not (i32:eq (call length (borrow-shared (array:range vectors
				vector_count vector_count))) 0i32)) (then (return 2i32)))
			(if (bool:not (f64:eq (array:load weights 2i32) 0.0f64)) (then (return 3i32)))
			(call set_pair (borrow-mut weights) 2.0f64 3.0f64)
			(call set_pair (borrow-mut (array:range vectors 1i32 vector_count)) 6.0f64 10.0f64)
			(if (bool:not (f64:eq (array:load vectors 0i32) 0.0f64)) (then (return 4i32)))
			(let result (call dot (borrow-shared weights)
				(borrow-shared (array:range vectors 1i32 vector_count))))
			(if (bool:not (f64:eq result 42.0f64)) (then (return 5i32)))
			(return 42i32))))
