(module runtime_numeric_csr
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn weights_for (params (count i32)) (returns (owned-array f64))
		(body
			(let weights (array.alloc f64 (local count)))
			(return (move (local weights)))))

	(fn set_pair (params (values (mut-array f64)) (first f64) (second f64)) (returns void)
		(body
			(array.store (local values) 0i32 (local first))
			(array.store (local values) 1i32 (local second))))

	(fn dot (params (weights (shared-array f64)) (vector (shared-array f64))) (returns f64)
		(body
			(let-mut total 0.0f64)
			(let-mut index 0i32)
			(while (i32.lt (local index) (array.len (local weights)))
				(body
					(set (local total) (f64.add (local total)
						(f64.mul (array.load (local weights) (local index)) (array.load (local vector) (local index)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (local total))))

	(fn length (params (values (shared-array f64))) (returns i32)
		(body (return (array.len (local values)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let count (i32.add.wrapping (array.len (local args)) 3i32))
			(let-mut weights (call weights_for (local count)))
			(let vector_count (i32.add.wrapping (local count) 1i32))
			(let-mut vectors (array.alloc f64 (local vector_count)))
			(let zero (array.alloc f64 (i32.sub.wrapping (local count) (local count))))
			(if (bool.not (i32.eq (call length (borrow-shared (local zero))) 0i32)) (then (return 1i32)))
			(if (bool.not (i32.eq (call length (borrow-shared (array.range (local vectors)
				(local vector_count) (local vector_count)))) 0i32)) (then (return 2i32)))
			(if (bool.not (f64.eq (array.load (local weights) 2i32) 0.0f64)) (then (return 3i32)))
			(call set_pair (borrow-mut (local weights)) 2.0f64 3.0f64)
			(call set_pair (borrow-mut (array.range (local vectors) 1i32 (local vector_count))) 6.0f64 10.0f64)
			(if (bool.not (f64.eq (array.load (local vectors) 0i32) 0.0f64)) (then (return 4i32)))
			(let result (call dot (borrow-shared (local weights))
				(borrow-shared (array.range (local vectors) 1i32 (local vector_count)))))
			(if (bool.not (f64.eq (local result) 42.0f64)) (then (return 5i32)))
			(return 42i32))))
