(module runtime_numeric_wrong_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn length (params (values (shared-array u32))) (returns i32)
		(body (return (array.len (local values)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let values (array.alloc i32 1i32))
			(return (call length (borrow-shared (array.range (local values) 0i32 1i32)))))))
