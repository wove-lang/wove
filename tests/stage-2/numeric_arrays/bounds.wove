(module runtime_numeric_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn length (params (values (shared-array f64))) (returns i32)
		(body (return (array.len values))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32.dec (array.len args)))
			(if (i32.eq count 0i32)
				(then
					(let queue (array.alloc i32 (i32.sub count 1i32)))
					(return (array.len queue))))
			(let-mut values (array.alloc f64 (i32.sub count 1i32)))
			(if (i32.eq count 1i32)
				(then
					(if (f64.eq (array.load values 0i32) 0.0f64) (then (return 2i32)))))
			(if (i32.eq count 2i32)
				(then (array.store values 1i32 0.0f64)))
			(return (call length (borrow-shared (array.range values 1i32 3i32)))))))
