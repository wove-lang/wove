(module runtime_numeric_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn length (params (values (shared-array f64))) (returns i32)
		(body (return (array.len (local values)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32.dec (array.len (local args))))
			(if (i32.eq (local count) 0i32)
				(then
					(let queue (array.alloc i32 (i32.sub (local count) 1i32)))
					(return (array.len (local queue)))))
			(let-mut values (array.alloc f64 (i32.sub (local count) 1i32)))
			(if (i32.eq (local count) 1i32)
				(then
					(if (f64.eq (array.load (local values) 0i32) 0.0f64) (then (return 2i32)))))
			(if (i32.eq (local count) 2i32)
				(then (array.store (local values) 1i32 0.0f64)))
			(return (call length (borrow-shared (array.range (local values) 1i32 3i32)))))))
