(module runtime_numeric_widths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn wide_value (params (values (shared-array i64)) (index i32)) (returns i64)
		(body (return (array.load (local values) (local index)))))

	(fn set_small (params (values (mut-array f32)) (index i32)) (returns void)
		(body (array.store (local values) (local index) 1.25f32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let index (i32.dec (array.len (local args))))
			(let count (i32.add (local index) 1i32))
			(let-mut wide (array.alloc i64 (local count)))
			(let-mut small (array.alloc f32 (local count)))
			(if (bool.not (i64.eq (call wide_value (borrow-shared (local wide)) (local index)) 0i64))
				(then (return 1i32)))
			(array.store (local wide) (local index) -9223372036854775808i64)
			(if (bool.not (i64.eq (call wide_value (borrow-shared (local wide)) (local index)) -9223372036854775808i64))
				(then (return 2i32)))
			(call set_small (borrow-mut (local small)) (local index))
			(if (bool.not (f32.eq (array.load (local small) (local index)) 1.25f32))
				(then (return 3i32)))
			(return 42i32))))
