(module runtime_numeric_widths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn wide_value (params (values (shared-array i64)) (index i32)) (returns i64)
		(body (return (array:get values index))))

	(fn set_small (params (values (mut-array f32)) (index i32)) (returns void)
		(body (array:set values index 1.25f32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let index (i32:dec (array:len args)))
			(let count (i32:add index 1i32))
			(let-mut wide (array:alloc i64 count))
			(let-mut small (array:alloc f32 count))
			(if (bool:not (i64:eq (call wide_value (borrow-shared wide) index) 0i64))
				(then (return 1i32)))
			(array:set wide index -9223372036854775808i64)
			(if (bool:not (i64:eq (call wide_value (borrow-shared wide) index) -9223372036854775808i64))
				(then (return 2i32)))
			(call set_small (borrow-mut small) index)
			(if (bool:not (f32:eq (array:get small index) 1.25f32))
				(then (return 3i32)))
			(return 42i32))))
