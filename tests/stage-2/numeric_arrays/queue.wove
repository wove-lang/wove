(module runtime_numeric_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn make_queue (params (count i32)) (returns (owned-array i32))
		(body
			(let queue (array.alloc i32 (local count)))
			(return (move (local queue)))))

	(fn enqueue (params (queue (mut-array i32)) (tail (mut-ref i32)) (cell i32)) (returns void)
		(body
			(array.store (local queue) (local tail) (local cell))
			(set (local tail) (i32.add.wrapping (local tail) 1i32))))

	(fn front_pair (params (queue (shared-array i32 2))) (returns i32)
		(body (return (i32.add.wrapping (array.load (local queue) 0i32) (array.load (local queue) 1i32)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let count (i32.add.wrapping (array.len (local args)) 3i32))
			(let-mut queue (call make_queue (local count)))
			(if (bool.not (i32.eq (array.len (local queue)) (local count))) (then (return 1i32)))
			(if (bool.not (i32.eq (array.load (local queue) (i32.sub.wrapping (local count) 1i32)) 0i32))
				(then (return 2i32)))
			(let-mut tail 0i32)
			(call enqueue (borrow-mut (local queue)) (borrow-mut (local tail)) 99i32)
			(if (i32.eq (local tail) 1i32)
				(then
					(let pending (borrow-mut (array.range (local queue) 1i32 3i32)))
					(let-mut frontier 0i32)
					(call enqueue (borrow-mut (local pending)) (borrow-mut (local frontier)) 2i32)
					(call enqueue (borrow-mut (local pending)) (borrow-mut (local frontier)) 40i32)
					(if (bool.not (i32.eq (local frontier) 2i32)) (then (return 3i32))))
				(else (return 4i32)))
			(if (bool.not (i32.eq (array.load (local queue) 0i32) 99i32)) (then (return 5i32)))
			(let moved (move (local queue)))
			(let begin 1i32)
			(let end 3i32)
			(return (call front_pair (borrow-shared (array.range (local moved) (local begin) (local end))))))))
