(module runtime_numeric_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make_queue (params (count i32)) (returns (owned-array i32))
		(body
			(let queue (array.alloc i32 count))
			(return (move queue))))

	(fn enqueue (params (queue (mut-array i32)) (tail (mut-ref i32)) (cell i32)) (returns void)
		(body
			(array.store queue tail cell)
			(set tail (i32.add tail 1i32))))

	(fn front_pair (params (queue (shared-array i32 2))) (returns i32)
		(body (return (i32.add (array.load queue 0i32) (array.load queue 1i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32.add (i32.dec (array.len args)) 3i32))
			(let-mut queue (call make_queue count))
			(if (bool.not (i32.eq (array.len queue) count)) (then (return 1i32)))
			(if (bool.not (i32.eq (array.load queue (i32.sub count 1i32)) 0i32))
				(then (return 2i32)))
			(let-mut tail 0i32)
			(call enqueue (borrow-mut queue) (borrow-mut tail) 99i32)
			(if (i32.eq tail 1i32)
				(then
					(let pending (borrow-mut (array.range queue 1i32 3i32)))
					(let-mut frontier 0i32)
					(call enqueue (borrow-mut pending) (borrow-mut frontier) 2i32)
					(call enqueue (borrow-mut pending) (borrow-mut frontier) 40i32)
					(if (bool.not (i32.eq frontier 2i32)) (then (return 3i32))))
				(else (return 4i32)))
			(if (bool.not (i32.eq (array.load queue 0i32) 99i32)) (then (return 5i32)))
			(let moved (move queue))
			(let begin 1i32)
			(let end 3i32)
			(return (call front_pair (borrow-shared (array.range moved begin end)))))))
