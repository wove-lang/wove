(module runtime_numeric_live_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let queue (array:alloc i32 2i32))
			(let front (borrow-shared (array:range queue 0i32 1i32)))
			(let moved (move queue))
			(return (array:load front 0i32)))))
