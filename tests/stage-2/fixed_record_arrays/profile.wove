(module csv_profile_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./columns.wove"
		(only (type Profile) (type (as Column Stat)) (value (as LIMIT COLUMN_LIMIT)) (value initial_columns)))

	(fn zero_column (params (calls (mut-ref i32))) (returns Stat)
		(body
			(set calls (i32:add calls 1i32))
			(return (struct:new Stat (empty 0u64) (bytes 0u64) (longest 0u64)))))

	(fn finish_field (params (profile (mut-ref Profile)) (index i32) (size u64)) (returns void)
		(body
			(let prior (array:get (struct:get profile stats) index))
			(let-mut longest (struct:get prior longest))
			(if (u64:lt longest size) (then (set longest size)))
			(array:set (struct:get profile stats) index
				(struct:new Stat
					(empty (struct:get prior empty))
					(bytes (u64:add (struct:get prior bytes) size))
					(longest longest)))))

	(fn saved_stats (params (profile Profile)) (returns (array Stat 3))
		(body (return (struct:get profile stats))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut calls 0i32)
			(let-mut columns (array:repeat (array Stat COLUMN_LIMIT) (call zero_column (borrow-mut calls))))
			(if (bool:not (i32:eq calls 1i32)) (then (return 1i32)))
			(let index (i32:add (i32:dec (array:len args)) 1i32))
			(let-mut profile (struct:new Profile (rows 0u64) (stats columns)))
			(let before profile)
			(array:set columns index (struct:new Stat (empty 1u64) (bytes 5u64) (longest 5u64)))
			(call finish_field (borrow-mut profile) index 9u64)
			(call finish_field (borrow-mut profile) index 33u64)
			(let saved (call saved_stats profile))
			(call finish_field (borrow-mut profile) index 1u64)
			(if (bool:not (u64:eq (struct:get (array:get saved index) bytes) 42u64))
				(then (return 2i32)))
			(if (bool:not (u64:eq (struct:get (array:get saved index) longest) 33u64))
				(then (return 3i32)))
			(if (bool:not (u64:eq (struct:get (array:get columns index) bytes) 5u64))
				(then (return 4i32)))
			(if (bool:not (u64:eq (struct:get (array:get (struct:get before stats) index) bytes) 0u64))
				(then (return 5i32)))
			(if (bool:not (u64:eq (struct:get (array:get initial_columns index) bytes) 0u64))
				(then (return 6i32)))
			(return 42i32))))
