(module csv_profile_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./columns.wove"
		(only (type Profile) (type (as Column Stat)) (value (as LIMIT COLUMN_LIMIT)) (value initial_columns)))

	(fn zero_column (params (calls (mut-ref i32))) (returns Stat)
		(body
			(set (local calls) (i32.add (local calls) 1i32))
			(return (struct.new Stat (empty 0u64) (bytes 0u64) (longest 0u64)))))

	(fn finish_field (params (profile (mut-ref Profile)) (index i32) (size u64)) (returns void)
		(body
			(let prior (array.load (struct.get (local profile) stats) (local index)))
			(let-mut longest (struct.get (local prior) longest))
			(if (u64.lt (local longest) (local size)) (then (set (local longest) (local size))))
			(array.store (struct.get (local profile) stats) (local index)
				(struct.new Stat
					(empty (struct.get (local prior) empty))
					(bytes (u64.add (struct.get (local prior) bytes) (local size)))
					(longest (local longest))))))

	(fn saved_stats (params (profile Profile)) (returns (array Stat 3))
		(body (return (struct.get (local profile) stats))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut calls 0i32)
			(let-mut columns (array.repeat (array Stat COLUMN_LIMIT) (call zero_column (borrow-mut (local calls)))))
			(if (bool.not (i32.eq (local calls) 1i32)) (then (return 1i32)))
			(let index (i32.add (i32.dec (array.len (local args))) 1i32))
			(let-mut profile (struct.new Profile (rows 0u64) (stats (local columns))))
			(let before (local profile))
			(array.store (local columns) (local index) (struct.new Stat (empty 1u64) (bytes 5u64) (longest 5u64)))
			(call finish_field (borrow-mut (local profile)) (local index) 9u64)
			(call finish_field (borrow-mut (local profile)) (local index) 33u64)
			(let saved (call saved_stats (local profile)))
			(call finish_field (borrow-mut (local profile)) (local index) 1u64)
			(if (bool.not (u64.eq (struct.get (array.load (local saved) (local index)) bytes) 42u64))
				(then (return 2i32)))
			(if (bool.not (u64.eq (struct.get (array.load (local saved) (local index)) longest) 33u64))
				(then (return 3i32)))
			(if (bool.not (u64.eq (struct.get (array.load (local columns) (local index)) bytes) 5u64))
				(then (return 4i32)))
			(if (bool.not (u64.eq (struct.get (array.load (struct.get (local before) stats) (local index)) bytes) 0u64))
				(then (return 5i32)))
			(if (bool.not (u64.eq (struct.get (array.load (local initial_columns) (local index)) bytes) 0u64))
				(then (return 6i32)))
			(return 42i32))))
