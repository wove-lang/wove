(module scoped_inline_array
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (bytes (array u8 2))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let packet (struct:new Packet (bytes (array:new (array u8 2) 40u8 2u8))))
			(let view (borrow-shared (struct:get packet bytes)))
			(return (i32:add (i32:from-u8 (array:load view 0i32))
				(i32:from-u8 (array:load view 1i32)))))))
