(module profile_columns
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let LIMIT 3i32)
	(struct Profile (fields (rows u64) (stats (array Column LIMIT))))
	(struct Column (fields (empty u64) (bytes u64) (longest u64)))

	(let initial_columns (array:repeat (array Column LIMIT)
		(struct:new Column (empty 0u64) (bytes 0u64) (longest 0u64)))))
