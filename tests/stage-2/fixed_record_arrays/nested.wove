(module nested_fixed_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let WIDTH 3i32)
	(struct Cube (fields (data (array (array (array i32 WIDTH) 2) 4))))
	(struct Cell (fields (value i32)))

	(fn plane (params) (returns (array (array i32 WIDTH) 2))
		(body
			(let line (array.new (array i32 WIDTH) 4i32 17i32 5i32))
			(return (array.repeat (array (array i32 WIDTH) 2) line))))

	(fn value (params (cube (array (array (array i32 WIDTH) 2) 4))) (returns i32)
		(body
			(return (array.load (array.load (array.load cube 0i32) 1i32) 2i32))))

	(fn nominal_leaf (params) (returns i32)
		(body
			(let entries
				(array.new (array (array Cell 1) 2)
					(array.new (array Cell 1) (struct.new Cell (value 13i32)))
					(array.new (array Cell 1) (struct.new Cell (value 31i32)))))
			(let cell (array.load (array.load entries 1i32) 0i32))
			(return (struct.get cell value))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut cube (struct.new Cube
				(data (array.repeat (array (array (array i32 WIDTH) 2) 4) (call plane)))))
			(let copy (struct.get cube data))
			(array.store (array.load (array.load (struct.get cube data) 0i32) 1i32) 2i32 42i32)
			(if (i32.not-eq (call value copy) 5i32) (then (return 1i32)))
			(if (i32.not-eq (array.len (array.load (array.load copy 3i32) 0i32)) 3i32)
				(then (return 2i32)))
			(if (i32.not-eq (call nominal_leaf) 31i32) (then (return 3i32)))
			(let-mut mutable_copy copy)
			(array.store (array.load (array.load mutable_copy 0i32) 1i32) 2i32 11i32)
			(if (i32.not-eq (call value mutable_copy) 11i32) (then (return 4i32)))
			(return (call value (struct.get cube data))))))
