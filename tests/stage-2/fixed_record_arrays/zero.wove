(module zero_record_array
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Holder (fields (units (array Unit 0))))
	(struct Unit (fields (bytes u64)))

	(fn make_unit (params (calls (mut-ref i32))) (returns Unit)
		(body
			(set calls (i32:add calls 1i32))
			(return (struct:new Unit (bytes 42u64)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut calls 0i32)
			(let box (struct:new Holder (units (array:repeat (array Unit 0) (call make_unit (borrow-mut calls))))))
			(if (bool:not (i32:eq calls 1i32)) (then (return 1i32)))
			(if (bool:not (i32:eq (array:len (struct:get box units)) 0i32)) (then (return 2i32)))
			(return 42i32))))
