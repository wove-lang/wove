(module fixed_record_array_payload
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Snapshot (variants (Saved (array Column 2)) (Empty)))
	(struct Column (fields (bytes u64)))
	(let initial (array.repeat (array Column 2) (struct.new Column (bytes 42u64))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn total (params (snapshot Snapshot)) (returns i32)
		(body
			(match (local snapshot)
				(case Saved (bind columns)
					(return (i32.from-u64 (struct.get (array.load (local columns) 1i32) bytes))))
				(case Empty (return 0i32)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut columns (local initial))
			(let snapshot (enum.new Snapshot Saved (local columns)))
			(array.store (local columns) 1i32 (struct.new Column (bytes 0u64)))
			(return (call total (local snapshot))))))
