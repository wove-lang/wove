(module fixed_record_array_payload
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Snapshot (variants (Saved (array Column 2)) (Empty)))
	(struct Column (fields (bytes u64)))
	(let initial (array:repeat (array Column 2) (struct:new Column (bytes 42u64))))

	(fn total (params (snapshot Snapshot)) (returns i32)
		(body
			(match snapshot
				(case Saved (let columns)
					(return (i32:from-u64 (struct:get (array:get columns 1i32) bytes))))
				(case Empty (return 0i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut columns initial)
			(let snapshot (enum:new Snapshot Saved columns))
			(array:set columns 1i32 (struct:new Column (bytes 0u64)))
			(return (call total snapshot)))))
