(module nested_fixed_extent_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let rows (array.repeat (array (array i32 2) 3)
				(array.repeat (array i32 1) 0i32)))
			(return (array.len (local rows))))))
