(module wrong_fixed_record_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Column (fields (bytes u64)))
	(struct Other (fields (bytes u64)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let columns (array.repeat (array Column 2) (struct.new Other (bytes 0u64))))
			(return (array.len columns)))))
