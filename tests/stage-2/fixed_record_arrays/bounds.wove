(module fixed_record_array_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Column (fields (bytes u64)))
	(struct Profile (fields (stats (array Column 1))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut profile (struct:new Profile (stats (array:new (array Column 1) (struct:new Column (bytes 42u64))))))
			(if (i32:eq (i32:dec (array:len args)) 0i32)
				(then (return (i32:from-u64 (struct:get (array:get (struct:get profile stats) 1i32) bytes)))))
			(array:set (struct:get profile stats) -1i32 (struct:new Column (bytes 0u64)))
			(return 0i32))))
