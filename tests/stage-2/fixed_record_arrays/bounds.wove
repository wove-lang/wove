(module fixed_record_array_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Column (fields (bytes u64)))
	(struct Profile (fields (stats (array Column 1))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut profile (struct.new Profile (stats (array.new (array Column 1) (struct.new Column (bytes 42u64))))))
			(if (i32.eq (array.len (local args)) 0i32)
				(then (return (i32.from-u64 (struct.get (array.load (struct.get (local profile) stats) 1i32) bytes)))))
			(array.store (struct.get (local profile) stats) -1i32 (struct.new Column (bytes 0u64)))
			(return 0i32))))
