(module wrong_fixed_record_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Column (fields (bytes u64)))
	(struct Profile (fields (stats (array Column 2))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let profile (struct.new Profile
				(stats (array.new (array Column 1) (struct.new Column (bytes 0u64))))))
			(return (array.len (struct.get (local profile) stats))))))
