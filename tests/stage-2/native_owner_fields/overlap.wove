(module native_owner_fields_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_dual))

	(struct Row (fields (value Handle)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut row (struct.new Row (value (native.empty Handle))))
			(return (call fixture_dual
				(borrow-mut (struct.get row value))
				(borrow-shared (struct.get row value))))))
)
