(module native_owner_fields_moved_into_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle)))
	(struct Box (fields (handle Handle)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let unbound (native.empty Handle))
			(let box (struct.new Box (handle (move (local unbound)))))
			(if (owner.is-null (local unbound)) (then (return 1i32)))
			(return 0i32)))
)
