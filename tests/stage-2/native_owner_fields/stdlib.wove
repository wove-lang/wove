(module native_owner_fields_stdlib
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type (as File FileHandle)) fopen fgetc fclose))
	(use c-header "<dirent.h>" (only (type (as Directory DirHandle)) opendir dirfd))
	(let input "input.txt")
	(let here ".")
	(let read_mode "rb")

	(struct Stream (fields (file FileHandle) (buffer (array u8 4)) (position i32)))
	(struct Input (fields (stream Stream) (directory DirHandle)))

	(fn open (params) (returns Input)
		(body
			(let file (call fopen (borrow-shared input) (borrow-shared read_mode)))
			(return (struct.new Input
				(stream (struct.new Stream (file (move file)) (buffer (array.new (array u8 4) 0u8 0u8 0u8 0u8)) (position 0i32)))
				(directory (call opendir (borrow-shared here)))))))

	(fn available (params (item (mut-ref Input))) (returns bool)
		(body
			(let character (call fgetc (borrow-shared (struct.get (struct.get item stream) file))))
			(let fd (call dirfd (borrow-shared (struct.get item directory))))
			(return (bool.and (i32.not-ltz character) (i32.not-ltz fd)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc Input 0i32))
			(let row (call open))
			(array.push rows (move row))
			(let-mut removed (array.remove rows 0i32))
			(if (bool.not (call available (borrow-mut removed))) (then (return 1i32)))
			(if (owner.is-null (struct.get (struct.get removed stream) file)) (then (return 2i32)))
			(if (i32.not-eqz (call fclose (move (struct.get (struct.get removed stream) file))))
				(then (return 4i32)))
			(if (i32.ltz (call dirfd (borrow-shared (struct.get removed directory))))
				(then (return 3i32)))
			(return 42i32)))
)
