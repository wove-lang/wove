(module native_owner_fields_consume_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_open fixture_drop))
	(struct Box (fields (handle Handle)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut box (struct.new Box (handle (native.empty Handle))))
			(return (call fixture_open (borrow-mut (struct.get (local box) handle))
				(call fixture_drop (move (struct.get (local box) handle)))))))
)
