(module native_owner_fields_consumed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_drop))
	(struct Box (fields (handle Handle)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let box (struct:new Box (handle (native:empty Handle))))
			(let status (call fixture_drop (move (struct:get box handle))))
			(if (owner:is-null (struct:get box handle)) (then (return 1i32)))
			(return status)))
)
