(module native_owner_fields_moved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_read))

	(struct Row (fields (value Handle)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let row (struct:new Row (value (native:empty Handle))))
			(let detached (move (struct:get row value)))
			(return (call fixture_read (borrow-shared (struct:get row value))))))
)
