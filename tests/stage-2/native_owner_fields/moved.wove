(module native_owner_fields_moved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_read))

	(struct Row (fields (value Handle)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let row (struct.new Row (value (native.empty Handle))))
			(let detached (move (struct.get (local row) value)))
			(return (call fixture_read (borrow-shared (struct.get (local row) value))))))
)
