(module native_owner_fields_tracked
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type (as Handle Resource)) fixture_open fixture_read fixture_dual
		fixture_drop fixture_opens fixture_drops fixture_live))

	(struct Handles (fields (left Resource) (right Resource)))
	(struct Row (fields (handles Handles) (tag i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn empty (params (tag i32)) (returns Row)
		(body
			(return (struct.new Row
				(handles (struct.new Handles (left (native.empty Resource)) (right (native.empty Resource))))
				(tag (local tag))))))

	(fn attempt (params (scenario i32)) (returns i32)
		(body
			(let-mut row (call empty (local scenario)))
			(return (call fixture_open (borrow-mut (struct.get (struct.get (local row) handles) left))
				(local scenario)))))

	(fn open_pair (params (row (mut-ref Row))) (returns i32)
		(body
			(let status (call fixture_open (borrow-mut (struct.get (struct.get (local row) handles) right)) 2i32))
			(if (i32.not-eqz (local status)) (then (return (local status))))
			(return (call fixture_dual (borrow-mut (struct.get (struct.get (local row) handles) left))
				(borrow-shared (struct.get (struct.get (local row) handles) right))))))

	(fn traverse (params) (returns i32)
		(body
			(let-mut rows (array.alloc Row 0i32))
			(let-mut front (call empty 21i32))
			(if (i32.not-eqz (call open_pair (borrow-mut (local front)))) (then (return 1i32)))
			(array.push (local rows) (move (local front)))
			(let-mut back (call empty 84i32))
			(if (i32.not-eqz (call fixture_open (borrow-mut (struct.get (struct.get (local back) handles) left)) 2i32))
				(then (return 2i32)))
			(array.push (local rows) (move (local back)))

			(let first (array.remove (local rows) 0i32))
			(if (i32.not-eq (struct.get (local first) tag) 21i32) (then (return 3i32)))
			(let detached (move (struct.get (struct.get (local first) handles) left)))
			(if (i32.not-eq (call fixture_read (borrow-shared (local detached))) 42i32) (then (return 4i32)))
			(if (i32.not-eq (call fixture_read
				(borrow-shared (struct.get (struct.get (local first) handles) right))) 42i32) (then (return 5i32)))
			(return (call fixture_drop (move (local detached))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (i32.not-eq (call attempt 0i32) -7i32) (then (return 11i32)))
			(if (i32.not-eqz (call fixture_drops)) (then (return 12i32)))
			(if (i32.not-eq (call attempt 1i32) 8i32) (then (return 13i32)))
			(if (i32.not-eq (call fixture_drops) 1i32) (then (return 14i32)))
			(if (i32.not-eqz (call traverse)) (then (return 15i32)))
			(if (i32.not-eq (call fixture_opens) 5i32) (then (return 16i32)))
			(if (i32.not-eq (call fixture_drops) 4i32) (then (return 17i32)))
			(if (i32.not-eqz (call fixture_live)) (then (return 18i32)))
			(return 42i32)))
)
