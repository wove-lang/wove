(module native_owner_fields_tracked
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type (as Handle Resource)) fixture_open fixture_read fixture_dual
		fixture_drop fixture_opens fixture_drops fixture_live))

	(struct Handles (fields (left Resource) (right Resource)))
	(struct Row (fields (handles Handles) (tag i32)))

	(fn empty (params (tag i32)) (returns Row)
		(body
			(return (struct.new Row
				(handles (struct.new Handles (left (native.empty Resource)) (right (native.empty Resource))))
				(tag tag)))))

	(fn attempt (params (scenario i32)) (returns i32)
		(body
			(let-mut row (call empty scenario))
			(if (bool.not (owner.is-null (struct.get (struct.get row handles) left))) (then (return 19i32)))
			(return (call fixture_open (borrow-mut (struct.get (struct.get row handles) left))
				scenario))))

	(fn open_pair (params (row (mut-ref Row))) (returns i32)
		(body
			(let status (call fixture_open (borrow-mut (struct.get (struct.get row handles) right)) 2i32))
			(if (i32.not-eqz status) (then (return status)))
			(return (call fixture_dual (borrow-mut (struct.get (struct.get row handles) left))
				(borrow-shared (struct.get (struct.get row handles) right))))))

	(fn traverse (params) (returns i32)
		(body
			(let-mut rows (array.alloc Row 0i32))
			(let-mut front (call empty 21i32))
			(if (i32.not-eqz (call open_pair (borrow-mut front))) (then (return 1i32)))
			(array.push rows (move front))
			(let-mut back (call empty 84i32))
			(if (i32.not-eqz (call fixture_open (borrow-mut (struct.get (struct.get back handles) left)) 2i32))
				(then (return 2i32)))
			(array.push rows (move back))

			(let first (array.remove rows 0i32))
			(if (i32.not-eq (struct.get first tag) 21i32) (then (return 3i32)))
			(let detached (move (struct.get (struct.get first handles) left)))
			(if (i32.not-eq (call fixture_read (borrow-shared detached)) 42i32) (then (return 4i32)))
			(if (i32.not-eq (call fixture_read
				(borrow-shared (struct.get (struct.get first handles) right))) 42i32) (then (return 5i32)))
			(if (owner.is-null (struct.get (struct.get first handles) right)) (then (return 6i32)))
			(if (i32.not-eqz (call fixture_drop (move (struct.get (struct.get first handles) right))))
				(then (return 7i32)))
			(return (call fixture_drop (move detached)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.not-eq (call attempt 0i32) -7i32) (then (return 11i32)))
			(if (i32.not-eqz (call fixture_drops)) (then (return 12i32)))
			(if (i32.not-eq (call attempt 1i32) 8i32) (then (return 13i32)))
			(if (i32.not-eq (call fixture_drops) 1i32) (then (return 14i32)))
			(if (i32.not-eqz (call traverse)) (then (return 15i32)))
			(if (i32.not-eq (call fixture_opens) 5i32) (then (return 16i32)))
			(if (i32.not-eq (call fixture_drops) 4i32) (then (return 17i32)))
			(if (i32.not-eqz (call fixture_live)) (then (return 18i32)))
			(return 42i32)))
)
