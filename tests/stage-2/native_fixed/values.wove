(module native_fixed_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./values.h"
		(fn check_fixed
			(params (first i32) (const minimum i32 -2_147_483_648) (const tail (c-type "const char **") null)
				(const radix i32 -0x10i32) (const tag i32 FIXED_TAG) (const maximum i32 (i32 2147483647)) (last i32))
			(returns i32))
		(fn check_empty_tail
			(:pragma (c_variadic))
			(params (const tail (c-type "const char **") null) (const code i32 -1))
			(returns i32)))
	(use c-header "./values.h" (only (as check_fixed verify) check_empty_tail))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eqz (call check_empty_tail)) (then (return 1i32)))
			(return (call verify 11i32 31i32)))))
