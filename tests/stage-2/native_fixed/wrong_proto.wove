(module native_fixed_wrong_proto
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./values.h"
		(fn wrong_tail
			(params (const tail (c-type "const char **") null))
			(returns i32)))
	(use c-header "./values.h" (only wrong_tail))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call wrong_tail)))))
