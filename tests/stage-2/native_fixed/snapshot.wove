(module fixed_path_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<stdlib.h>"
		(fn resolve_path
			(:pragma (c_cstr path) (c_snapshot cstr (drop free)))
			(c-name "realpath")
			(params (path (shared-array u8)) (const buffer (c-type "char *") null))
			(returns (optional (owned-array u8)))))
	(use c-header "<stdlib.h>" (only resolve_path))

	(let here ".")
	(let missing "tests/stage-2/native_records/data.txt/absent")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call resolve_path (borrow-shared (local missing))))
			(if (bool.not (owner.is-null (local absent))) (then (return 1i32)))
			(let path (call resolve_path (borrow-shared (local here))))
			(if (owner.is-null (local path)) (then (return 2i32)))
			(return 42i32))))
