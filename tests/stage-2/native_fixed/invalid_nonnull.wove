	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./values.h"
		(fn check_fixed (params (const tail (c-type "const char **") 0i32)) (returns i32)))
	(use c-header "./values.h" (only check_fixed))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
