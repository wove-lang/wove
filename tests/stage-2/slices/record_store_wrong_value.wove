	record_store_wrong_value
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn write_token
		(params (data (mut-slice Token)) (value Other))
		(returns i32)
		(body
			(slice.store (local data) (i32 0) (local value))
			(return (i32 0))))
	(fn main (params) (returns i32) (body (return (i32 42)))))
