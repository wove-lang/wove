(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	record_wrong_borrow
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn token_count
		(params (data (shared-slice Token)))
		(returns i32)
		(body (return (slice.len (local data)))))
	(fn wrong_element
		(params (data (shared-slice Other)))
		(returns i32)
		(body (return (call token_count (borrow-shared (local data))))))
	(fn main (params) (returns i32) (body (return (i32 42)))))
