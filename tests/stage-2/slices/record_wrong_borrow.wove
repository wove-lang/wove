(module record_wrong_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn token_count
		(params (data (shared-array Token)))
		(returns i32)
		(body (return (array:len data))))
	(fn wrong_element
		(params (data (shared-array Other)))
		(returns i32)
		(body (return (call token_count (borrow-shared data)))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
