(module record_wrong_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn token_count
		(params (data (shared-slice Token)))
		(returns i32)
		(body (return (slice.len (local data)))))
	(fn wrong_element
		(params (data (shared-slice Other)))
		(returns i32)
		(body (return (call token_count (borrow-shared (local data))))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 42)))))
