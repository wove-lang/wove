(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	mutable_bytes

	(fn write_byte
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns u8)
		(body
			(slice.store (local data) (local index) (local value))
			(return (slice.load (local data) (local index)))))

	(fn read_byte
		(params (data (shared-slice u8)) (index i32))
		(returns u8)
		(body (return (slice.load (local data) (local index)))))

	(fn forward_write
		(params (data (mut-slice u8)) (index i32))
		(returns u8)
		(body
			(let written (call write_byte (borrow-mut (local data)) (local index) (u8 255)))
			(let observed (call read_byte (borrow-shared (local data)) (local index)))
			(if (u8.eq (local written) (local observed))
				(then (return (local written))))
			(return (u8 0))))

	(fn main (params) (returns i32) (body (return (i32 42)))))
