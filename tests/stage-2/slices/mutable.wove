(module mutable_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns u8)
		(body
			(array:store data index value)
			(return (array:load data index))))

	(fn read_byte
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body (return (array:load data index))))

	(fn forward_write
		(params (data (mut-array u8)) (index i32))
		(returns u8)
		(body
			(let written (call write_byte (borrow-mut data) index (u8 255)))
			(let observed (call read_byte (borrow-shared data) index))
			(if (u8:eq written observed)
				(then (return written)))
			(return (u8 0))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
