(module record_store_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(fn write_token
		(params (data (shared-array Token)) (value Token))
		(returns i32)
		(body
			(array.store (local data) (i32 0) (local value))
			(return (i32 0))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 42)))))
