(module record_store_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(fn write_token
		(params (data (shared-slice Token)) (value Token))
		(returns i32)
		(body
			(slice.store (local data) (i32 0) (local value))
			(return (i32 0))))
	(fn main (params) (returns i32) (body (return (i32 42)))))
