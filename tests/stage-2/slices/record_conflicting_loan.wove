(module record_conflicting_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(fn consume
		(params (writer (mut-array Token)) (reader (shared-array Token)))
		(returns i32)
		(body (return (i32 0))))
	(fn conflict
		(params (data (mut-array Token)))
		(returns i32)
		(body
			(return (call consume
				(borrow-mut (local data))
				(borrow-shared (local data))))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
