(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	record_conflicting_loan
	(struct Token (fields (kind u32)))
	(fn consume
		(params (writer (mut-slice Token)) (reader (shared-slice Token)))
		(returns i32)
		(body (return (i32 0))))
	(fn conflict
		(params (data (mut-slice Token)))
		(returns i32)
		(body
			(return (call consume
				(borrow-mut (local data))
				(borrow-shared (local data))))))
	(fn main (params) (returns i32) (body (return (i32 42)))))
