(module mutable_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (start i32) (ready bool) (flag u8)))
	(fn write_token
		(params (data (mut-array Token)) (index i32) (value Token))
		(returns i32)
		(body
			(array:set data index value)
			(return (array:len data))))
	(fn read_token
		(params (data (shared-array Token)) (index i32))
		(returns Token)
		(body (return (array:get data index))))
	(fn replace_token
		(params (data (mut-array Token)) (index i32) (value Token))
		(returns Token)
		(body
			(let count (call write_token (borrow-mut data) index value))
			(if (i32:eq count (i32 2))
				(then (return (call read_token (borrow-shared data) index))))
			(return (array:get data index))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
