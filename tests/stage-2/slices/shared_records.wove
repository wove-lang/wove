(module shared_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (start i32) (ready bool) (flag u8)))
	(fn read_token
		(params (data (shared-array Token)) (index i32))
		(returns Token)
		(body (return (array:get data index))))
	(fn forward_token
		(params (data (shared-array Token)) (index i32))
		(returns Token)
		(body
			(let value (call read_token (borrow-shared data) index))
			(return value)))
	(fn token_count
		(params (data (shared-array Token)))
		(returns i32)
		(body (return (array:len data))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
