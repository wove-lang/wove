(module shared_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (start i32) (ready bool) (flag u8)))
	(fn read_token
		(params (data (shared-slice Token)) (index i32))
		(returns Token)
		(body (return (slice.load (local data) (local index)))))
	(fn forward_token
		(params (data (shared-slice Token)) (index i32))
		(returns Token)
		(body
			(let value (call read_token (borrow-shared (local data)) (local index)))
			(return (local value))))
	(fn token_count
		(params (data (shared-slice Token)))
		(returns i32)
		(body (return (slice.len (local data)))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 42)))))
