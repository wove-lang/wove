(module conflicting_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns i32)
		(body
			(slice.store (local data) (local index) (local value))
			(return (i32 42))))

	(fn forward_write
		(params (data (mut-slice u8)) (index i32))
		(returns i32)
		(body
			(return (call write_byte
				(borrow-mut (local data))
				(local index)
				(slice.load
					(local data)
					(local index))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 42)))))
