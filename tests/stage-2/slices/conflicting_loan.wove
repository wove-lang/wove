(module conflicting_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns i32)
		(body
			(array:store data index value)
			(return (i32 42))))

	(fn forward_write
		(params (data (mut-array u8)) (index i32))
		(returns i32)
		(body
			(return (call write_byte
				(borrow-mut data)
				index
				(array:load
					data
					index)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
