(module shared_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn seed
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array.store (local data) (i32 1) (u8 17))
			(array.store (local data) (i32 2) (u8 25))
			(return (i32 0))))

	(fn advance
		(params (data (mut-array u8)) (delta i32))
		(returns i32)
		(body
			(let prior (int.convert i32 (array.load (local data) (i32 0))))
			(let next (i32.add.wrapping (local prior) (local delta)))
			(array.store (local data) (i32 0) (int.convert u8 (local next)))
			(return (local next))))

	(fn pair
		(params (data (shared-array u8)))
		(returns bool)
		(body
			(return (bool.and
				(i32.eq (array.len (local data)) (i32 2))
				(bool.and
					(u8.eq (array.load (local data) (i32 0)) (u8 17))
					(u8.eq (array.load (local data) (i32 1)) (u8 25)))))))

	(fn forward_pair
		(params (data (shared-array u8)))
		(returns bool)
		(body
			(return (call pair
				(borrow-shared (array.range (local data) (i32 1) (i32 3)))))))

	(fn length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array.len (local data)))))

	(fn empty_at_end
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let end (array.len (local data)))
			(return (call length
				(borrow-shared (array.range (local data) (local end) (local end)))))))

	(fn first
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local data) (i32 0))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 3)))
			(let seeded (call seed (borrow-mut (local data))))
			(let-mut cursor (array.new (array u8 1) (u8 0)))
			(if (call pair
					(borrow-shared (array.range (local data)
						(call advance (borrow-mut (local cursor)) (i32 1))
						(call advance (borrow-mut (local cursor)) (i32 2)))))
				(then
					(if (bool.and
							(call forward_pair (borrow-shared (local data)))
							(bool.and
								(i32.eq (call empty_at_end (borrow-shared (local data))) (i32 0))
								(i32.eq (call first (borrow-shared (local cursor))) (i32 3))))
						(then (return (i32 42))))))
			(return (i32 1)))))
