	record_wrong_result
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn wrong_element
		(params (data (shared-slice Token)) (index i32))
		(returns Other)
		(body (return (slice.load (local data) (local index)))))
	(fn main (params) (returns i32) (body (return (i32 42)))))
