(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	shared_bytes

	(fn read_byte
		(params (data (shared-slice u8)) (index i32))
		(returns u8)
		(body (return (slice.load (local data) (local index)))))

	(fn forward_read
		(params (data (shared-slice u8)) (index i32))
		(returns u8)
		(body (return (call read_byte (borrow-shared (local data)) (local index)))))

	(fn read_length
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local data)))))

	(fn forward_length
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (call read_length (borrow-shared (local data))))))

	(fn has_last_byte
		(params (data (shared-slice u8)) (value u8))
		(returns bool)
		(body
			(return (bool.and
				(i32.lt (i32 0) (slice.len (local data)))
				(u8.eq (slice.load (local data) (i32.sub.wrapping (slice.len (local data)) (i32 1)))
					(local value))))))

	(fn main (params) (returns i32) (body (return (i32 42)))))
