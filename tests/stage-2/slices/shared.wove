(module shared_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_byte
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body (return (array.load (local data) (local index)))))

	(fn forward_read
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body (return (call read_byte (borrow-shared (local data)) (local index)))))

	(fn read_length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array.len (local data)))))

	(fn forward_length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (call read_length (borrow-shared (local data))))))

	(fn has_last_byte
		(params (data (shared-array u8)) (value u8))
		(returns bool)
		(body
			(return (bool.and
				(i32.lt (i32 0) (array.len (local data)))
				(u8.eq (array.load (local data) (i32.sub.wrapping (array.len (local data)) (i32 1)))
					(local value))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 42)))))
