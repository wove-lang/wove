(module shared_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_byte
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body (return (array:load data index))))

	(fn forward_read
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body (return (call read_byte (borrow-shared data) index))))

	(fn read_length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array:len data))))

	(fn forward_length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (call read_length (borrow-shared data)))))

	(fn has_last_byte
		(params (data (shared-array u8)) (value u8))
		(returns bool)
		(body
			(return (bool:and
				(i32:lt (i32 0) (array:len data))
				(u8:eq (array:load data (i32:sub (array:len data) (i32 1)))
					value)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
