(module wrong_store_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store
				(local data)
				(i32 1)
				(i32 255))
			(return (i32 42))))

	(fn main (params) (returns i32) (body (return (i32 42)))))
