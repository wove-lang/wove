	(fn write_byte
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array:set
				data
				(i32 1)
				(i32 255))
			(return (i32 42))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 42)))))
