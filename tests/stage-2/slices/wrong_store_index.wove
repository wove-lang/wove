(module wrong_store_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store
				(local data)
				(u32 1)
				(u8 255))
			(return (i32 42))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 42)))))
