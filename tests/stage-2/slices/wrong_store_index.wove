	wrong_store_index

	(fn write_byte
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store
				(local data)
				(u32 1)
				(u8 255))
			(return (i32 42))))

	(fn main (params) (returns i32) (body (return (i32 42)))))
