(module ref_round
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./state.wove" (only (type (as State DigestState)) initial high high_copy advance same_high))

	(fn check
		(params (state (shared-ref DigestState)))
		(returns bool)
		(body
			(return (bool.and (i32.eq (struct.get state used) (i32 128))
				(bool.and (u64.eq (struct.get (struct.get state count) low) (u64 127))
					(bool.and (u64.eq (array.load (struct.get state words) (i32 7)) (u64 7640891576956012808))
						(u8.eq (array.load (struct.get state block) (i32 127)) (u8 0))))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (call initial))
			(let original (call high_copy state (call advance (borrow-mut state) (i32 128))))
			(if (bool.not (u64.eq original (u64 7))) (then (return (i32 1))))
			(if (bool.not (u64.eq (call high (borrow-shared state)) (u64 8)))
				(then (return (i32 2))))
			(if (bool.not (call check (borrow-shared state))) (then (return (i32 3))))
			(if (bool.not (call same_high (borrow-shared state) (borrow-shared state)))
				(then (return (i32 4))))
			(return (i32 42)))))
