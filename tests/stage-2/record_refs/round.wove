(module ref_round
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./state.wove" (only (type (as State DigestState)) initial high high_copy advance same_high))

	(fn check
		(params (state (shared-ref DigestState)))
		(returns bool)
		(body
			(return (bool.and (i32.eq (record.get (local state) used) (i32 128))
				(bool.and (u64.eq (record.get (record.get (local state) count) low) (u64 127))
					(bool.and (u64.eq (array.load (record.get (local state) words) (i32 7)) (u64 7640891576956012808))
						(u8.eq (array.load (record.get (local state) block) (i32 127)) (u8 0))))))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut state (call initial))
			(let original (call high_copy (local state) (call advance (borrow-mut (local state)) (i32 128))))
			(if (bool.not (u64.eq (local original) (u64 7))) (then (return (i32 1))))
			(if (bool.not (u64.eq (call high (borrow-shared (local state))) (u64 8)))
				(then (return (i32 2))))
			(if (bool.not (call check (borrow-shared (local state)))) (then (return (i32 3))))
			(if (bool.not (call same_high (borrow-shared (local state)) (borrow-shared (local state))))
				(then (return (i32 4))))
			(return (i32 42)))))
