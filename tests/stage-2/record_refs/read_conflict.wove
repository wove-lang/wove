(module ref_read_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn update (params (state (mut-ref State)) (used i32)) (returns i32) (body (return (i32 0))))

	(fn relay
		(params (state (mut-ref State)))
		(returns i32)
		(body (return (call update (borrow-mut (local state)) (struct.get (local state) used)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0)))))
