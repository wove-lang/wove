(module ref_read_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn update (params (state (mut-ref State)) (used i32)) (returns i32) (body (return (i32 0))))

	(fn relay
		(params (state (mut-ref State)))
		(returns i32)
		(body (return (call update (borrow-mut (local state)) (record.get (local state) used)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 0)))))
