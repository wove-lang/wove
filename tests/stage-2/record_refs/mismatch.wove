(module ref_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))
	(struct Other (fields (used i32)))

	(fn read (params (state (shared-ref State))) (returns i32) (body (return (i32 0))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let other (struct:new Other (used (i32 0))))
			(return (call read (borrow-shared other))))))
