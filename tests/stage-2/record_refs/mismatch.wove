(module ref_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))
	(struct Other (fields (used i32)))

	(fn read (params (state (shared-ref State))) (returns i32) (body (return (i32 0))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let other (struct.new Other (used (i32 0))))
			(return (call read (borrow-shared (local other)))))))
