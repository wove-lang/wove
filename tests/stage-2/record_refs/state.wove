(module ref_state
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Counter (fields (low u64) (high u64)))
	(struct State (fields (words (array u64 8)) (block (array u8 128)) (count Counter) (used i32)))

	(fn initial
		(params)
		(returns State)
		(body
			(return (record.make State
				(words (array.repeat (array u64 8) (u64 7640891576956012808)))
				(block (array.repeat (array u8 128) (u8 0)))
				(count (record.make Counter (low (u64 18446744073709551615)) (high (u64 7))))
				(used (i32 0))))))

	(fn high
		(params (state (shared-ref State)))
		(returns u64)
		(body (return (record.get (record.get (local state) count) high))))

	(fn high_copy
		(params (state State) (later u64))
		(returns u64)
		(body (return (call high (borrow-shared (local state))))))

	(fn add_count
		(params (state (mut-ref State)) (length i32))
		(returns void)
		(body
			(let before (record.get (record.get (local state) count) low))
			(let low (u64.add.wrapping (local before) (int.convert u64 (local length))))
			(if (u64.lt (local low) (local before))
				(then (set (record.get (record.get (local state) count) high)
					(u64.add.wrapping (record.get (record.get (local state) count) high) (u64 1)))))
			(set (record.get (record.get (local state) count) low) (local low))))

	(fn advance
		(params (state (mut-ref State)) (length i32))
		(returns u64)
		(body
			(call add_count (borrow-mut (local state)) (local length))
			(set (record.get (local state) used) (local length))
			(return (call high (borrow-shared (local state))))))

	(fn same_high
		(params (left (shared-ref State)) (right (shared-ref State)))
		(returns bool)
		(body
			(return (u64.eq (call high (borrow-shared (local left)))
				(call high (borrow-shared (local right))))))))
