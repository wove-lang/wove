(module ref_state
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Counter (fields (low u64) (high u64)))
	(struct State (fields (words (array u64 8)) (block (array u8 128)) (count Counter) (used i32)))

	(fn initial
		(params)
		(returns State)
		(body
			(return (struct:new State
				(words (array:repeat (array u64 8) (u64 7640891576956012808)))
				(block (array:repeat (array u8 128) (u8 0)))
				(count (struct:new Counter (low (u64 18446744073709551615)) (high (u64 7))))
				(used (i32 0))))))

	(fn high
		(params (state (shared-ref State)))
		(returns u64)
		(body (return (struct:get (struct:get state count) high))))

	(fn high_copy
		(params (state State) (later u64))
		(returns u64)
		(body (return (call high (borrow-shared state)))))

	(fn add_count
		(params (state (mut-ref State)) (length i32))
		(returns void)
		(body
			(let before (struct:get (struct:get state count) low))
			(let low (u64:add before (int:convert u64 length)))
			(if (u64:lt low before)
				(then (set (struct:get (struct:get state count) high)
					(u64:add (struct:get (struct:get state count) high) (u64 1)))))
			(set (struct:get (struct:get state count) low) low)))

	(fn advance
		(params (state (mut-ref State)) (length i32))
		(returns u64)
		(body
			(call add_count (borrow-mut state) length)
			(set (struct:get state used) length)
			(return (call high (borrow-shared state)))))

	(fn same_high
		(params (left (shared-ref State)) (right (shared-ref State)))
		(returns bool)
		(body
			(return (u64:eq (call high (borrow-shared left))
				(call high (borrow-shared right)))))))
