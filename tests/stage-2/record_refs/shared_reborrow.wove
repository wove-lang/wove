(module ref_shared_reborrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn update (params (state (mut-ref State))) (returns i32) (body (return (i32 0))))

	(fn relay
		(params (state (shared-ref State)))
		(returns i32)
		(body (return (call update (borrow-mut (local state))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 0)))))
