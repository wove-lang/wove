(module ref_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn update (params (state (mut-ref State))) (returns i32) (body (return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let state (record.make State (used (i32 0))))
			(return (call update (borrow-mut (local state)))))))
