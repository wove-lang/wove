(module ref_shared_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn update
		(params (state (shared-ref State)))
		(returns void)
		(body (set (struct.get (local state) used) (i32 1))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 0)))))
