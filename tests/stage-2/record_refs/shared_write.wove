(module ref_shared_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn update
		(params (state (shared-ref State)))
		(returns void)
		(body (set (struct.get state used) (i32 1))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0)))))
