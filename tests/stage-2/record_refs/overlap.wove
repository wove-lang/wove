(module ref_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn use_both (params (before (shared-ref State)) (write (mut-ref State))) (returns i32)
		(body (return (i32 0))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (struct.new State (used (i32 0))))
			(return (call use_both (borrow-shared state) (borrow-mut state))))))
