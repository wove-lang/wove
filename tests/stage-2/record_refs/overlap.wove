(module ref_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (used i32)))

	(fn use_both (params (before (shared-ref State)) (write (mut-ref State))) (returns i32)
		(body (return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut state (record.make State (used (i32 0))))
			(return (call use_both (borrow-shared (local state)) (borrow-mut (local state)))))))
