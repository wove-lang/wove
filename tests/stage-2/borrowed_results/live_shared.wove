(module borrowed_results_live_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "cursor.wove" (only forward_cursor))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut input (array.alloc u8 3i32))
			(let-mut scratch (array.alloc u8 1i32))
			(let cursor (call forward_cursor
				(borrow-shared (local input)) (borrow-mut (local scratch))))
			(array.store (local input) 0i32 42u8)
			(return (array.len (struct.get (local cursor) bytes))))))
