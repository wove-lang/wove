(module borrowed_results_live_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "cursor.wove" (only forward_cursor))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut input (array:alloc u8 3i32))
			(let-mut scratch (array:alloc u8 1i32))
			(let cursor (call forward_cursor
				(borrow-shared input) (borrow-mut scratch)))
			(array:set input 0i32 42u8)
			(return (array:len (struct:get cursor bytes))))))
