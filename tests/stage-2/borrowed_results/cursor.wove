(module returned_cursor
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (at i32) (first i32) (last i32)))

	(fn start_cursor
		(params (scratch (mut-array u8)) (bytes (shared-array u8)))
		(returns Cursor (from bytes))
		(body
			(array:store scratch 0i32 19u8)
			(return (struct:new Cursor
				(bytes (borrow-shared bytes)) (at 0i32) (first -1i32) (last 0i32)))))

	(fn forward_cursor
		(params (bytes (shared-array u8)) (scratch (mut-array u8)))
		(returns Cursor (from bytes))
		(body
			(let view (borrow-shared bytes))
			(let cursor (call start_cursor (borrow-mut scratch) (borrow-shared view)))
			(return cursor)))

	(fn tail
		(params (bytes (shared-array u8)))
		(returns (shared-array u8) (from bytes))
		(body (return (borrow-shared (array:range bytes 1i32 3i32)))))

	(fn cursor_view
		(params (scratch (mut-array u8)) (bytes (shared-array u8)))
		(returns (shared-array u8) (from bytes))
		(body
			(let cursor (call forward_cursor (borrow-shared bytes) (borrow-mut scratch)))
			(let projected_cursor (struct:new Cursor
				(bytes (borrow-shared (struct:get cursor bytes))) (at 0i32) (first -1i32) (last 0i32)))
			(return (call tail (borrow-shared (struct:get projected_cursor bytes))))))

	(fn next
		(params (cursor (mut-ref Cursor)))
		(returns u8)
		(body
			(let index (struct:get cursor at))
			(let byte (array:load (struct:get cursor bytes) index))
			(set (struct:get cursor at) (i32:inc index))
			(set (struct:get cursor last) index)
			(return byte))))
