(module borrowed_results_unequal_forward
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn exclusive
		(params (bytes (mut-array u8)))
		(returns (mut-array u8) (from bytes))
		(body (return (borrow-mut (local bytes)))))

	(fn shared
		(params (bytes (mut-array u8)))
		(returns (shared-array u8) (from bytes))
		(body (return (call exclusive (borrow-mut (local bytes))))))

	(fn main (params (spans (shared-array (shared-array u8))))
		(returns i32) (body (return 0i32))))
