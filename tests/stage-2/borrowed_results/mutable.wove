(module borrowed_results_mutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Pair (fields (input (array i32 3)) (scratch (array i32 1))))

	(fn mutable_tail
		(params (items (mut-array i32)))
		(returns (mut-array i32) (from items))
		(body
			(let view (borrow-mut (array.range items 1i32 3i32)))
			(return (borrow-mut view))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut pair (struct.new Pair
				(input (array.new (array i32 3) 9i32 8i32 7i32))
				(scratch (array.new (array i32 1) 0i32))))
			(if (bool true)
				(then
					(let view (call mutable_tail (borrow-mut (struct.get pair input))))
					(array.store (struct.get pair scratch) 0i32 20i32)
					(array.store view 0i32 13i32)))
			(return (i32.add (array.load (struct.get pair input) 0i32)
				(i32.add (array.load (struct.get pair input) 1i32)
					(array.load (struct.get pair scratch) 0i32)))))))
