(module borrowed_static_view
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let bytes "abc")

	(fn view
		(params (source (shared-array u8)))
		(returns (shared-array u8) (from source))
		(body (return (borrow-shared source))))

	(fn padding
		(:doc "Put the following scratch parameter at the same table index as the bytes source node.")
		(params (p0 i32) (p1 i32) (p2 i32) (p3 i32) (p4 i32) (p5 i32)
			(p6 i32) (p7 i32) (p8 i32) (p9 i32) (p10 i32))
		(returns i32)
		(body (return 0i32)))

	(fn work
		(params (scratch (mut-array u8)))
		(returns i32)
		(body
			(let result (call view (borrow-shared bytes)))
			(array:set scratch 0i32 42u8)
			(if (u8:not-eq (array:get result 1i32) 98u8) (then (return 1i32)))
			(return (i32:from-u8 (array:get scratch 0i32)))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array:alloc u8 1i32))
			(return (call work (borrow-mut buffer))))))
