(module borrowed_results_wrong_parameter
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (separator (shared-array u8))))

	(fn wrong
		(params (bytes (shared-array u8)) (other (shared-array u8)))
		(returns Cursor (from bytes))
		(body
			(let cursor (struct.new Cursor
				(bytes (borrow-shared (local bytes)))
				(separator (borrow-shared (local other)))))
			(return (local cursor))))

	(fn main (params (spans (shared-array (shared-array u8))))
		(returns i32) (body (return 0i32))))
