(module borrowed_results_temporary
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "cursor.wove" (only tail))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let bytes (array:alloc u8 3i32))
			(return (array:len (call tail (borrow-shared bytes)))))))
