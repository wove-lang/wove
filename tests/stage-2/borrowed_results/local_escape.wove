(module borrowed_results_local_escape
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "cursor.wove" (only tail))
	(fn escape
		(params (bytes (shared-array u8)))
		(returns (shared-array u8) (from bytes))
		(body
			(let buffer (array.alloc u8 3i32))
			(let view (borrow-shared (local buffer)))
			(return (call tail (borrow-shared (local view))))))

	(fn main (params (spans (shared-array (shared-array u8))))
		(returns i32) (body (return 0i32))))
