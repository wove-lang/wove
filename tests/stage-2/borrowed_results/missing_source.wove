(module borrowed_results_missing_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn view
		(params (bytes (shared-array u8)))
		(returns (shared-array u8) (from missing))
		(body (return (borrow-shared (local bytes)))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32) (body (return 0i32))))
