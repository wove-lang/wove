	(fn view
		(params (bytes (shared-array u8)))
		(returns (shared-array u8) (from missing))
		(body (return (borrow-shared (local bytes)))))

	(fn main (params (spans (shared-array (shared-array u8))))
		(returns i32) (body (return 0i32))))
