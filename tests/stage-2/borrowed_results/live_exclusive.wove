(module borrowed_results_live_exclusive
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn view
		(params (bytes (mut-array u8)))
		(returns (shared-array u8) (from bytes))
		(body (return (borrow-shared (local bytes)))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut input (array.alloc u8 3i32))
			(let bytes (call view (borrow-mut (local input))))
			(return (array.len (local input))))))
