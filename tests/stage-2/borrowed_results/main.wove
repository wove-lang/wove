(module borrowed_results
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "cursor.wove" (only (as forward_cursor open_cursor) cursor_view next))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut input (array.alloc u8 3i32))
			(let-mut scratch (array.new (array u8 1) 0u8))
			(array.store (local input) 1i32 19u8)
			(array.store (local input) 2i32 23u8)
			(if (bool true)
				(then
					(let-mut cursor (call open_cursor
						(borrow-shared (local input)) (borrow-mut (local scratch))))
					(array.store (local scratch) 0i32 42u8)
					(if (i32.not-eq (struct.get (local cursor) first) -1i32) (then (return 1i32)))
					(if (u8.not-eq (call next (borrow-mut (local cursor))) 0u8) (then (return 2i32)))
					(if (u8.not-eq (call next (borrow-mut (local cursor))) 19u8) (then (return 3i32)))
					(if (i32.not-eq (struct.get (local cursor) last) 1i32) (then (return 4i32)))
					(let tail (call cursor_view (borrow-mut (local scratch)) (borrow-shared (local input))))
					(if (i32.not-eq (array.len (local tail)) 2i32) (then (return 5i32)))
					(if (u8.not-eq (array.load (local tail) 1i32) 23u8) (then (return 6i32)))
					(if (u8.not-eq (array.load (local input) 1i32) 19u8) (then (return 7i32)))))
			(array.store (local input) 0i32 42u8)
			(let received (move (local input)))
			(return (i32.from-u8 (array.load (local received) 0i32))))))
