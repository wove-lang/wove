(module borrowed_results
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "cursor.wove" (only (as forward_cursor open_cursor) cursor_view next))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut input (array:alloc u8 3i32))
			(let-mut scratch (array:new (array u8 1) 0u8))
			(array:store input 1i32 19u8)
			(array:store input 2i32 23u8)
			(if (bool true)
				(then
					(let-mut cursor (call open_cursor
						(borrow-shared input) (borrow-mut scratch)))
					(array:store scratch 0i32 42u8)
					(if (i32:not-eq (struct:get cursor first) -1i32) (then (return 1i32)))
					(if (u8:not-eq (call next (borrow-mut cursor)) 0u8) (then (return 2i32)))
					(if (u8:not-eq (call next (borrow-mut cursor)) 19u8) (then (return 3i32)))
					(if (i32:not-eq (struct:get cursor last) 1i32) (then (return 4i32)))
					(let tail (call cursor_view (borrow-mut scratch) (borrow-shared input)))
					(if (i32:not-eq (array:len tail) 2i32) (then (return 5i32)))
					(if (u8:not-eq (array:load tail 1i32) 23u8) (then (return 6i32)))
					(if (u8:not-eq (array:load input 1i32) 19u8) (then (return 7i32)))))
			(array:store input 0i32 42u8)
			(let received (move input))
			(return (i32:from-u8 (array:load received 0i32))))))
