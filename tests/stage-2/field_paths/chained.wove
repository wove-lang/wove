(module field_path_chained
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (size i32)))
	(struct Packet (fields (header Header)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let packet (struct:new Packet (header (struct:new Header (size 42i32)))))
			(return packet/header/size.inc.len))))
