(module field_path_places
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (size i32) (bytes (owned-array u8)) (samples (array u8 2))))
	(struct Packet (fields (header Header)))

	(fn paint
		(params (bytes (mut-array u8)))
		(returns void)
		(body (bytes.set 0i32 38u8)))

	(fn size_with
		(generic (const extra i32))
		(params (packet (shared-ref Packet)))
		(returns i32)
		(body (return (i32:add packet/header/size extra))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut packet (struct:new Packet
				(header (struct:new Header (size 0i32) (bytes (array:alloc u8 1i32))
					(samples (array:repeat (array u8 2) 0u8))))))
			(if (i32:not-eq (array:len packet/header/samples) 2i32)
				(then (return 1i32)))
			(set packet/header/size 4i32)
			(call paint (borrow-mut packet/header/bytes))
			(let taken (move packet/header/bytes))
			(set packet/header/bytes (array:alloc u8 1i32))
			(call paint (borrow-mut packet/header/bytes))
			(let size (call (specialize size_with 0i32) (borrow-shared packet)))
			(return (i32:add size (i32:from-u8 (taken.get 0i32)))))))
