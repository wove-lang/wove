(module field_path_receivers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (count i32) (ready bool) (samples (array u8 2))))
	(struct Packet (fields (header Header)))

	(fn next_index
		(params (ticks (mut-array i32)))
		(returns i32)
		(body
			(ticks.set 0i32 (i32:inc (ticks.get 0i32)))
			(return 0i32)))

	(fn read_samples
		(params (packet (shared-ref Packet)))
		(returns u8)
		(body
			(let size packet/header/samples.len)
			(if (i32:not-eq size (packet/header/samples.len)) (then (return 1u8)))
			(if (i32:not-eq size (array:len (struct:get (struct:get packet header) samples)))
				(then (return 2u8)))
			(let value (packet/header/samples.get (:doc "Use the original array place.") 0i32))
			(if (u8:not-eq value (array:get (struct:get (struct:get packet header) samples) 0i32))
				(then (return 3u8)))
			(return value)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut packet (struct:new Packet
				(header (struct:new Header (count 1i32) (ready (bool false))
					(samples (array:repeat (array u8 2) 0u8))))))
			(let-mut ticks (array:alloc i32 1i32))
			(packet/header/samples.set (call next_index (borrow-mut ticks)) 40u8)
			(if (i32:not-eq (ticks.get 0i32) 1i32) (then (return 4i32)))
			(if (packet/header/ready.and (u8:eq (packet/header/samples.get -1i32) 0u8))
				(then (return 5i32)))
			(if (i32:not-eq (packet/header.get count) 1i32) (then (return 6i32)))
			(let bytes packet/header/count.to-le-bytes)
			(if (u8:not-eq (bytes.get 0i32) 1u8) (then (return 7i32)))
			(return (i32:add packet/header/count.inc
				(i32:from-u8 (call read_samples (borrow-shared packet))))))))
