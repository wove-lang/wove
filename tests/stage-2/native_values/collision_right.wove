(module readonly_right
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./readonly_right.h"
		(type Number (c-type "ReadonlyAlias"))
		(let readonly_shared Number))
	(use c-header "./readonly_right.h" (only (type Number) (value (as readonly_shared answer))))

	(fn right_value (params) (returns i32)
		(body (return (int.convert i32 answer)))))
