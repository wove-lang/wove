(module readonly_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./readonly_left_0110bc.wove" (only left_value))
	(use wove-file "./readonly_right_007c09.wove" (only right_value))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32.add (call left_value) (call right_value))))))
