(module native_values_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./values.h"
		(type Magnitude (c-type "uint64_t"))
		(const TEST_BYTE u8)
		(const TEST_WIDE Magnitude)
		(const TEST_TRUE bool)
		(let test_live_value i32)
		(let test_readonly i32)
		(fn check_flags (params (close_on_exec i32) (nonblocking i32) (no_entry i32)) (returns bool))
		(fn set_errno_for_test (params (value i32)) (returns i32))
		(fn read_errno_for_test (params) (returns i32))
		(fn change_live_value (params (value i32)) (returns i32))
		(let-mut TEST_SLOT i32)
		(fn choose_second_slot (params) (returns i32))
		(fn slot_matches (params) (returns bool))
		(type QualifiedNumber (c-type "ReadonlyNumber"))
		(let test_qualified QualifiedNumber)
		(type ExplicitNumber (c-type "const int32_t"))
		(let test_explicit ExplicitNumber)))
