(module native_typed_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./values.h"
		(only (type Magnitude) (value (as TEST_BYTE byte)) (value TEST_WIDE) (value TEST_TRUE)
			(value (as test_live_value live)) (value (as test_readonly answer)) change_live_value
			(value (as TEST_SLOT slot)) choose_second_slot slot_matches))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(if (bool.not (bool.and (local TEST_TRUE) (u8.eq (local byte) (u8 255))))
				(then (return (i32 1))))
			(if (int.eq Magnitude (local TEST_WIDE) (int.convert Magnitude (u32 4294967295)))
				(then (return (i32 2))))
			(let old (local live))
			(let new (call change_live_value (local answer)))
			(if (bool.not (bool.and (i32.eq (local old) (i32 0)) (i32.eq (local live) (local new))))
				(then (return (i32 3))))
			(set (local slot) (call choose_second_slot))
			(if (bool.not (call slot_matches))
				(then (return (i32 4))))
			(return (local answer)))))
