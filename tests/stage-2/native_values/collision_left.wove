(module readonly_left
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./readonly_left.h"
		(type Number (c-type "int32_t"))
		(let readonly_shared Number))
	(use c-header "./readonly_left.h"
		(only (type Number) (value (as readonly_shared first)) (value (as readonly_shared second))))

	(fn left_value (params) (returns i32)
		(body
			(let value (int:convert i32 first))
			(if (i32:not-eq value (int:convert i32 second)) (then (return 0i32)))
			(return value))))
