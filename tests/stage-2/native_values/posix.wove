(module native_posix_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<fcntl.h>" (only (value (as O_CLOEXEC close_on_exec)) O_NONBLOCK))
	(use c-header "<errno.h>" (only (value (as errno indicator)) (as ENOENT no_entry)))
	(use c-header "<stdio.h>" (only (value (as stderr diagnostics)) fputc))
	(use c-header "./values.h" (only check_flags set_errno_for_test read_errno_for_test))

	(fn main
		(:expect (tests "stage-2/native_values/cases.tsv") (issues "gh:wove-lang/wove:222"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (call check_flags close_on_exec O_NONBLOCK no_entry))
				(then (return (i32 1))))
			(set indicator (i32 0))
			(if (bool.not (i32.eq (call read_errno_for_test) (i32 0)))
				(then (return (i32 2))))
			(if (i32.eq indicator (call set_errno_for_test no_entry))
				(then (return (i32 4))))
			(if (bool.not (i32.eq indicator no_entry))
				(then (return (i32 5))))
			(if (bool.not (i32.eq (call fputc (i32 65) diagnostics) (i32 65)))
				(then (return (i32 6))))
			(if (bool.not (i32.eq (call fputc (i32 66) (borrow-shared diagnostics)) (i32 66)))
				(then (return (i32 7))))
			(return (i32 42)))))
