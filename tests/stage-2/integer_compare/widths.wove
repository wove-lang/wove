(module comparison_widths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn signed_order
		(params) (returns bool)
		(body
			(if (bool.not (bool.and (i8.lt -128i8 127i8) (i8.le -128i8 -128i8)))
				(then (return (bool false))))
			(if (bool.not (bool.and (i16.gt 32767i16 -32768i16) (i16.ge 32767i16 32767i16)))
				(then (return (bool false))))
			(if (bool.not (bool.and (i32.le -2147483648i32 2147483647i32) (i32.gt 2147483647i32 -2147483648i32)))
				(then (return (bool false))))
			(return (bool.and (i64.lt -9223372036854775808i64 9223372036854775807i64)
				(i64.ge 9223372036854775807i64 9223372036854775807i64)))))

	(fn unsigned_order
		(params) (returns bool)
		(body
			(if (bool.not (bool.and (u8.gt 255u8 0u8) (u8.le 255u8 255u8)))
				(then (return (bool false))))
			(if (bool.not (bool.and (u16.lt 0u16 65535u16) (u16.ge 65535u16 65535u16)))
				(then (return (bool false))))
			(if (bool.not (bool.and (u32.gt 4294967295u32 0u32) (u32.le 4294967295u32 4294967295u32)))
				(then (return (bool false))))
			(return (bool.and (u64.gt 18446744073709551615u64 9223372036854775808u64)
				(u64.ge 18446744073709551615u64 18446744073709551615u64)))))

	(fn zero_order
		(params) (returns bool)
		(body
			(if (bool.not (bool.and (i8.eqz 0i8) (i8.eq -128i8 -128i8)))
				(then (return (bool false))))
			(if (bool.not (bool.and (i16.ltz -32768i16) (i32.lez 0i32)))
				(then (return (bool false))))
			(if (bool.not (bool.and (i64.gtz 9223372036854775807i64) (i8.gez 0i8)))
				(then (return (bool false))))
			(if (bool.not (bool.and (u8.eqz 0u8) (u16.lez 0u16)))
				(then (return (bool false))))
			(return (bool.and (u32.gtz 4294967295u32) (u64.gez 0u64)))))

	(fn negated_order
		(params) (returns bool)
		(body
			(if (bool.not (bool.and (u8.not.eq 0u8 255u8) (i8.not.lt 127i8 -128i8)))
				(then (return (bool false))))
			(if (bool.not (bool.and (u16.not.le 65535u16 0u16) (i16.not.gt -32768i16 32767i16)))
				(then (return (bool false))))
			(if (bool.not (bool.and (i32.not.ge -2147483648i32 2147483647i32) (i64.not.eqz -1i64)))
				(then (return (bool false))))
			(if (bool.not (bool.and (u32.not.ltz 0u32) (u64.not.lez 1u64)))
				(then (return (bool false))))
			(return (bool.and (u64.not.gtz 0u64) (i8.not.gez -128i8)))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(if (bool.not (call signed_order)) (then (return 1i32)))
			(if (bool.not (call unsigned_order)) (then (return 2i32)))
			(if (bool.not (call zero_order)) (then (return 3i32)))
			(if (bool.not (call negated_order)) (then (return 4i32)))
			(return 42i32))))
