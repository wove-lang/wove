(module comparison_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn set_and_read
		(params (slot (mut-ref i32)) (value i32)) (returns i32)
		(body
			(let old (local slot))
			(set (local slot) (local value))
			(return (local old))))

	(fn counted_unsigned
		(params (count (mut-ref i32))) (returns u64)
		(body
			(set (local count) (i32.add (local count) 1i32))
			(return 18446744073709551615u64)))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut slot 1i32)
			(let ordered (i32.le
				(call set_and_read (borrow-mut (local slot)) 2i32)
				(call set_and_read (borrow-mut (local slot)) 3i32)))
			(if (bool.not (bool.and (local ordered) (i32.eq (local slot) 3i32))) (then (return 1i32)))
			(let reversed (i32.not-gt
				(local slot)
				(call set_and_read (borrow-mut (local slot)) 4i32)))
			(if (bool.not (bool.and (local reversed) (i32.eq (local slot) 4i32))) (then (return 2i32)))
			(let-mut count 0i32)
			(if (u64.ltz (call counted_unsigned (borrow-mut (local count)))) (then (return 3i32)))
			(if (u64.not-gez (call counted_unsigned (borrow-mut (local count)))) (then (return 4i32)))
			(if (bool.not (u64.gez (call counted_unsigned (borrow-mut (local count))))) (then (return 5i32)))
			(if (bool.not (u64.not-ltz (call counted_unsigned (borrow-mut (local count))))) (then (return 6i32)))
			(if (bool.not (u64.not-eqz (call counted_unsigned (borrow-mut (local count))))) (then (return 7i32)))
			(if (bool.not (i32.eq (local count) 5i32)) (then (return 8i32)))
			(return 42i32))))
