(module comparison_alias
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./values.h" (only (type Magnitude) (value TEST_WIDE)))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let limit (int.convert Magnitude 18446744073709551615u64))
			(let lower (int.convert Magnitude 4294967295u32))
			(if (int.not-eq Magnitude (local TEST_WIDE) (local limit)) (then (return 1i32)))
			(if (bool.not (int.not-eq Magnitude (local TEST_WIDE) (local lower))) (then (return 2i32)))
			(return 42i32))))
