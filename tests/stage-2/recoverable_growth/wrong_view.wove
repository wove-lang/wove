(module recoverable_wrong_view
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc u8 0i32))
			(let words (array.alloc i32 1i32))
			(let appended (array.try-extend (local data) (borrow-shared (local words))))
			(return 42i32)))
)
