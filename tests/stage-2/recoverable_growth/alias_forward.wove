(module recoverable_alias_forward
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type (as Size LocalCount)) check_count))
	(use wove-file "./alias_loader.wove" (only load))

	(fn forward (params (count i32)) (returns (optional (owned-array LocalCount)))
		(body (return (call load (local count)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call forward -1i32))
			(if (bool.not (owner.is-null (local absent))) (then (return 1i32)))
			(let empty (call forward 0i32))
			(if (owner.is-null (local empty)) (then (return 2i32)))
			(let empty_owner (move (optional.unwrap (local empty))))
			(if (i32.not-eqz (array.len (local empty_owner))) (then (return 3i32)))
			(let present (call forward 1i32))
			(if (owner.is-null (local present)) (then (return 4i32)))
			(let owner (move (optional.unwrap (local present))))
			(if (i32.not-eq (call check_count (array.load (local owner) 0i32)) 42i32)
				(then (return 5i32)))
			(let-mut result (array.try-alloc LocalCount 1i32))
			(if (owner.is-null (local result)) (then (return 6i32)))
			(set (local result) (optional.none (owned-array LocalCount)))
			(if (bool.not (owner.is-null (local result))) (then (return 7i32)))
			(return 42i32)))
)
