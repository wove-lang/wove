	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Result (variants (Added) (Rejected u32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc i32 0i32))
			(let added (array.try-push (local data) Result 1i32))
			(return 42i32)))
)
