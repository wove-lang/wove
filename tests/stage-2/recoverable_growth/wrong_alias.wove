(module recoverable_wrong_alias
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type (as Size Count)) (type Other)))

	(fn wrong (params) (returns (optional (owned-array Count)))
		(body (return (optional.none (owned-array Other)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (let missing (call wrong)) (return 42i32)))
)
