(module recoverable_word_frequency
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./faults.h" (only fail_descriptor fail_backing_after))
	(struct Entry (fields (start i32) (length i32) (hash u64) (count u64)))
	(struct Table (fields (slots (owned-array i32)) (entries (owned-array Entry)) (keys (owned-array u8))))
	(enum Inserted (variants (Added) (Rejected Entry)))
	(enum InsertedRow (variants (Rejected (owned-array u8)) (Added)))
	(let old_word "a")
	(let new_word "bc")
	(let empty_word "")

	(fn key_length (params (items (shared-array u8))) (returns i32)
		(body (return (array:len items))))
	(fn entry_length (params (items (shared-array Entry))) (returns i32)
		(body (return (array:len items))))
	(fn slot_length (params (items (shared-array i32))) (returns i32)
		(body (return (array:len items))))
	(fn set_slot (params (slots (mut-array i32)) (hash u64) (index i32)) (returns void)
		(body
			(let mask (u64:from-i32 (i32:dec (array:len slots))))
			(array:store slots (i32:from-u64 (u64:and hash mask)) index)))

	(fn new_slots (params (length i32)) (returns (optional (owned-array i32)))
		(body (return (array:try-alloc i32 length))))

	(fn grow (params (table (mut-ref Table))) (returns bool)
		(body
			(let size (call slot_length (borrow-shared (struct:get table slots))))
			(let next (call new_slots (i32:add size size)))
			(if (owner:is-null next) (then (return (bool false))))
			(let-mut slots (move (optional:unwrap next)))
			(for (let index entry) (borrow-shared (struct:get table entries))
				(body (call set_slot (borrow-mut slots) (struct:get entry hash) (i32:inc index))))
			(set (struct:get table slots) (move slots))
			(return (bool true))))

	(fn add (params (table (mut-ref Table)) (word (shared-array u8)) (hash u64)) (returns bool)
		(body
			(let start (call key_length (borrow-shared (struct:get table keys))))
			(if (bool:not (array:try-extend (struct:get table keys) (borrow-shared word)))
				(then (return (bool false))))
			(let entry (struct:new Entry (start start) (length (array:len word)) (hash hash) (count 1u64)))
			(match (array:try-push (struct:get table entries) Inserted entry)
				(case Added
					(let count (call entry_length (borrow-shared (struct:get table entries))))
					(call set_slot (borrow-mut (struct:get table slots)) hash count)
					(return (bool true)))
				(case Rejected (let returned)
					(if (bool:or (u64:not-eq (struct:get returned hash) hash)
						(bool:or (u64:not-eq (struct:get returned count) 1u64)
							(i32:not-eq (struct:get returned length) (array:len word))))
						(then (return (bool true))))
					(array:truncate (struct:get table keys) (struct:get returned start))
					(return (bool false))))))

	(fn intact (params (slots (shared-array i32)) (entries (shared-array Entry)) (keys (shared-array u8))) (returns bool)
		(body
			(if (bool:or (i32:not-eq (array:len entries) 1i32) (i32:not-eq (array:len keys) 1i32))
				(then (return (bool false))))
			(let first (array:load entries 0i32))
			(return (bool:and
				(bool:and (i32:eq (struct:get first start) 0i32) (u64:eq (struct:get first hash) 1u64))
				(bool:and (u8:eq (array:load keys 0i32) 97u8)
					(bool:and (i32:eq (array:load slots 1i32) 1i32) (i32:eqz (array:load slots 2i32))))))))

	(fn check_prefix (params (table (shared-ref Table))) (returns bool)
		(body (return (call intact
			(borrow-shared (struct:get table slots))
			(borrow-shared (struct:get table entries))
			(borrow-shared (struct:get table keys))))))

	(fn recovered_row (params) (returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 0i32))
			(let first (array:alloc u8 3i32))
			(let added (array:try-push rows InsertedRow (move first)))
			(match (move added)
				(case Added)
				(case Rejected (let _) (return 1i32)))
			(let-mut value (array:alloc u8 1i32))
			(array:store value 0i32 42u8)
			(call fail_backing_after 0i32)
			(let rejected (array:try-push rows InsertedRow (move value)))
			(match (move rejected)
				(case Added (return 2i32))
				(case Rejected (let recovered)
					(if (i32:not-eq (array:len rows) 1i32) (then (return 3i32)))
					(let saved (array:remove rows 0i32))
					(if (i32:not-eq (array:len saved) 3i32) (then (return 4i32)))
					(return (i32:from-u8 (array:load recovered 0i32)))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let invalid (call new_slots -1i32))
			(if (bool:not (owner:is-null invalid)) (then (return 10i32)))
			(call fail_descriptor)
			(let no_descriptor (array:try-alloc Entry 1i32))
			(if (bool:not (owner:is-null no_descriptor)) (then (return 11i32)))
			(call fail_backing_after 0i32)
			(let no_backing (array:try-alloc Entry 1i32))
			(if (bool:not (owner:is-null no_backing)) (then (return 12i32)))
			(let slots (call new_slots 8i32))
			(let entries (array:try-alloc Entry 0i32))
			(let keys (array:try-alloc u8 0i32))
			(if (bool:or (owner:is-null slots) (bool:or (owner:is-null entries) (owner:is-null keys)))
				(then (return 13i32)))
			(let-mut table (struct:new Table (slots (move (optional:unwrap slots)))
				(entries (move (optional:unwrap entries))) (keys (move (optional:unwrap keys)))))
			(if (bool:not (call add (borrow-mut table) (borrow-shared old_word) 1u64)) (then (return 14i32)))
			(call fail_backing_after 0i32)
			(if (call grow (borrow-mut table)) (then (return 15i32)))
			(if (bool:not (call check_prefix (borrow-shared table))) (then (return 16i32)))
			(if (bool:not (call grow (borrow-mut table))) (then (return 17i32)))
			(if (bool:not (array:try-extend (struct:get table keys) (borrow-shared empty_word))) (then (return 18i32)))
			(let key_capacity (array:capacity (struct:get table keys)))
			(call fail_backing_after 0i32)
			(if (call add (borrow-mut table) (borrow-shared new_word) 9223372036854775810u64) (then (return 19i32)))
			(if (i32:not-eq (array:capacity (struct:get table keys)) key_capacity) (then (return 26i32)))
			(if (bool:not (call check_prefix (borrow-shared table))) (then (return 20i32)))
			(let entry_capacity (array:capacity (struct:get table entries)))
			(call fail_backing_after 1i32)
			(if (call add (borrow-mut table) (borrow-shared new_word) 9223372036854775810u64) (then (return 21i32)))
			(if (i32:not-eq (array:capacity (struct:get table entries)) entry_capacity) (then (return 27i32)))
			(if (bool:not (call check_prefix (borrow-shared table))) (then (return 22i32)))
			(if (bool:not (call add (borrow-mut table) (borrow-shared new_word) 9223372036854775810u64)) (then (return 23i32)))
			(if (i32:not-eq (call key_length (borrow-shared (struct:get table keys))) 3i32) (then (return 24i32)))
			(if (i32:not-eq (call entry_length (borrow-shared (struct:get table entries))) 2i32) (then (return 25i32)))
			(return (call recovered_row))))
)
