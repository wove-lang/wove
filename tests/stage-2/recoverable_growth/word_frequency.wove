(module recoverable_word_frequency
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./faults.h" (only fail_descriptor fail_backing_after))
	(struct Entry (fields (start i32) (length i32) (hash u64) (count u64)))
	(struct Table (fields (slots (owned-array i32)) (entries (owned-array Entry)) (keys (owned-array u8))))
	(enum Inserted (variants (Added) (Rejected Entry)))
	(enum InsertedRow (variants (Rejected (owned-array u8)) (Added)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(let old_word "a")
	(let new_word "bc")
	(let empty_word "")

	(fn key_length (params (items (shared-array u8))) (returns i32)
		(body (return (array.len (local items)))))
	(fn entry_length (params (items (shared-array Entry))) (returns i32)
		(body (return (array.len (local items)))))
	(fn slot_length (params (items (shared-array i32))) (returns i32)
		(body (return (array.len (local items)))))
	(fn set_slot (params (slots (mut-array i32)) (hash u64) (index i32)) (returns void)
		(body
			(let mask (u64.from-i32 (i32.dec (array.len (local slots)))))
			(array.store (local slots) (i32.from-u64 (u64.and (local hash) (local mask))) (local index))))

	(fn new_slots (params (length i32)) (returns (optional (owned-array i32)))
		(body (return (array.try-alloc i32 (local length)))))

	(fn grow (params (table (mut-ref Table))) (returns bool)
		(body
			(let size (call slot_length (borrow-shared (struct.get (local table) slots))))
			(let next (call new_slots (i32.add (local size) (local size))))
			(if (owner.is-null (local next)) (then (return (bool false))))
			(let-mut slots (move (optional.unwrap (local next))))
			(for (bind index entry) (borrow-shared (struct.get (local table) entries))
				(body (call set_slot (borrow-mut (local slots)) (struct.get (local entry) hash) (i32.inc (local index)))))
			(set (struct.get (local table) slots) (move (local slots)))
			(return (bool true))))

	(fn add (params (table (mut-ref Table)) (word (shared-array u8)) (hash u64)) (returns bool)
		(body
			(let start (call key_length (borrow-shared (struct.get (local table) keys))))
			(if (bool.not (array.try-extend (struct.get (local table) keys) (borrow-shared (local word))))
				(then (return (bool false))))
			(let entry (struct.new Entry (start (local start)) (length (array.len (local word))) (hash (local hash)) (count 1u64)))
			(match (array.try-push (struct.get (local table) entries) Inserted (local entry))
				(case Added
					(let count (call entry_length (borrow-shared (struct.get (local table) entries))))
					(call set_slot (borrow-mut (struct.get (local table) slots)) (local hash) (local count))
					(return (bool true)))
				(case Rejected (bind returned)
					(if (bool.or (u64.not-eq (struct.get (local returned) hash) (local hash))
						(bool.or (u64.not-eq (struct.get (local returned) count) 1u64)
							(i32.not-eq (struct.get (local returned) length) (array.len (local word)))))
						(then (return (bool true))))
					(array.truncate (struct.get (local table) keys) (struct.get (local returned) start))
					(return (bool false))))))

	(fn intact (params (slots (shared-array i32)) (entries (shared-array Entry)) (keys (shared-array u8))) (returns bool)
		(body
			(if (bool.or (i32.not-eq (array.len (local entries)) 1i32) (i32.not-eq (array.len (local keys)) 1i32))
				(then (return (bool false))))
			(let first (array.load (local entries) 0i32))
			(return (bool.and
				(bool.and (i32.eq (struct.get (local first) start) 0i32) (u64.eq (struct.get (local first) hash) 1u64))
				(bool.and (u8.eq (array.load (local keys) 0i32) 97u8)
					(bool.and (i32.eq (array.load (local slots) 1i32) 1i32) (i32.eqz (array.load (local slots) 2i32))))))))

	(fn check_prefix (params (table (shared-ref Table))) (returns bool)
		(body (return (call intact
			(borrow-shared (struct.get (local table) slots))
			(borrow-shared (struct.get (local table) entries))
			(borrow-shared (struct.get (local table) keys))))))

	(fn recovered_row (params) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 0i32))
			(let first (array.alloc u8 3i32))
			(let added (array.try-push (local rows) InsertedRow (move (local first))))
			(match (move (local added))
				(case Added)
				(case Rejected (bind _) (return 1i32)))
			(let-mut value (array.alloc u8 1i32))
			(array.store (local value) 0i32 42u8)
			(call fail_backing_after 0i32)
			(let rejected (array.try-push (local rows) InsertedRow (move (local value))))
			(match (move (local rejected))
				(case Added (return 2i32))
				(case Rejected (bind recovered)
					(if (i32.not-eq (array.len (local rows)) 1i32) (then (return 3i32)))
					(let saved (array.remove (local rows) 0i32))
					(if (i32.not-eq (array.len (local saved)) 3i32) (then (return 4i32)))
					(return (i32.from-u8 (array.load (local recovered) 0i32)))))))

	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let invalid (call new_slots -1i32))
			(if (bool.not (owner.is-null (local invalid))) (then (return 10i32)))
			(call fail_descriptor)
			(let no_descriptor (array.try-alloc Entry 1i32))
			(if (bool.not (owner.is-null (local no_descriptor))) (then (return 11i32)))
			(call fail_backing_after 0i32)
			(let no_backing (array.try-alloc Entry 1i32))
			(if (bool.not (owner.is-null (local no_backing))) (then (return 12i32)))
			(let slots (call new_slots 8i32))
			(let entries (array.try-alloc Entry 0i32))
			(let keys (array.try-alloc u8 0i32))
			(if (bool.or (owner.is-null (local slots)) (bool.or (owner.is-null (local entries)) (owner.is-null (local keys))))
				(then (return 13i32)))
			(let-mut table (struct.new Table (slots (move (optional.unwrap (local slots))))
				(entries (move (optional.unwrap (local entries)))) (keys (move (optional.unwrap (local keys))))))
			(if (bool.not (call add (borrow-mut (local table)) (borrow-shared (local old_word)) 1u64)) (then (return 14i32)))
			(call fail_backing_after 0i32)
			(if (call grow (borrow-mut (local table))) (then (return 15i32)))
			(if (bool.not (call check_prefix (borrow-shared (local table)))) (then (return 16i32)))
			(if (bool.not (call grow (borrow-mut (local table)))) (then (return 17i32)))
			(if (bool.not (array.try-extend (struct.get (local table) keys) (borrow-shared (local empty_word)))) (then (return 18i32)))
			(let key_capacity (array.capacity (struct.get (local table) keys)))
			(call fail_backing_after 0i32)
			(if (call add (borrow-mut (local table)) (borrow-shared (local new_word)) 9223372036854775810u64) (then (return 19i32)))
			(if (i32.not-eq (array.capacity (struct.get (local table) keys)) (local key_capacity)) (then (return 26i32)))
			(if (bool.not (call check_prefix (borrow-shared (local table)))) (then (return 20i32)))
			(let entry_capacity (array.capacity (struct.get (local table) entries)))
			(call fail_backing_after 1i32)
			(if (call add (borrow-mut (local table)) (borrow-shared (local new_word)) 9223372036854775810u64) (then (return 21i32)))
			(if (i32.not-eq (array.capacity (struct.get (local table) entries)) (local entry_capacity)) (then (return 27i32)))
			(if (bool.not (call check_prefix (borrow-shared (local table)))) (then (return 22i32)))
			(if (bool.not (call add (borrow-mut (local table)) (borrow-shared (local new_word)) 9223372036854775810u64)) (then (return 23i32)))
			(if (i32.not-eq (call key_length (borrow-shared (struct.get (local table) keys))) 3i32) (then (return 24i32)))
			(if (i32.not-eq (call entry_length (borrow-shared (struct.get (local table) entries))) 2i32) (then (return 25i32)))
			(return (call recovered_row))))
)
