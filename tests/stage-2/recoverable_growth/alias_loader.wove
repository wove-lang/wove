(module recoverable_alias_loader
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type (as Size Count)) wide_count))

	(fn load (params (count i32)) (returns (optional (owned-array Count)))
		(body
			(if (i32:ltz count) (then (return (optional:none (owned-array Count)))))
			(let allocated (array:try-alloc Count count))
			(if (bool:or (owner:is-null allocated) (i32:eqz count))
				(then (return (move allocated))))
			(let-mut owner (move (optional:unwrap allocated)))
			(array:store owner 0i32 (call wide_count))
			(return (optional:some (move owner)))))
)
