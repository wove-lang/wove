(module recoverable_alias_loader
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type (as Size Count)) wide_count))

	(fn load (params (count i32)) (returns (optional (owned-array Count)))
		(body
			(if (i32.ltz (local count)) (then (return (optional.none (owned-array Count)))))
			(let allocated (array.try-alloc Count (local count)))
			(if (bool.or (owner.is-null (local allocated)) (i32.eqz (local count)))
				(then (return (move (local allocated)))))
			(let-mut owner (move (optional.unwrap (local allocated))))
			(array.store (local owner) 0i32 (call wide_count))
			(return (optional.some (move (local owner))))))
)
