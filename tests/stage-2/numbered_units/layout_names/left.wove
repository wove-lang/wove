(module collision_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (generic (type T)) (fields (bytes T)))
	(enum State (variants (Empty) (Posted (specialize Packet (owned-array u8)))))

	(fn make_left
		(params) (returns State)
		(body
			(let packet (struct:new (specialize Packet (owned-array u8))
				(bytes (array:alloc u8 42i32))))
			(return (enum:new State Posted (move packet))))))
