(module layout_name_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only make_left))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove"
		(only read_right (type (as Packet RightPacket)) (type (as State RightState))))

	(fn count_left
		(params) (returns i32)
		(body
			(match (call make_left)
				(case Empty (return 0i32))
				(case Posted (let packet)
					(let bytes (borrow-shared (struct:get packet bytes)))
					(return (array:len bytes))))))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call count_left) 42i32) (then (return 1i32)))
			(let right (struct:new (specialize RightPacket (owned-array u8))
				(bytes (array:alloc u8 42i32)) (offset 19i32)))
			(let extra (enum:new RightState Posted -19i32))
			(return (call read_right (move right) extra)))))
