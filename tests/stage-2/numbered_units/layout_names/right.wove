(module collision_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (generic (type T)) (fields (bytes T) (offset i32)))
	(enum State (variants (Empty) (Posted i32)))

	(fn read_right
		(params (packet (specialize Packet (owned-array u8))) (state State)) (returns i32)
		(body
			(match state
				(case Empty (return 0i32))
				(case Posted (let extra)
					(let bytes (borrow-shared (struct:get packet bytes)))
					(return (i32:add (struct:get packet offset)
						(i32:add (array:len bytes) extra))))))))
