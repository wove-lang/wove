(module fixed_layout_helper
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only (type (as Packet LeftAlias))))

	(fn take_left
		(params (row (array (specialize LeftAlias (owned-array u8)) 1))) (returns i32)
		(body
			(let-mut working (move row))
			(let packet (move (array.load working 0i32)))
			(let bytes (borrow-shared (struct.get packet bytes)))
			(return (array.len bytes)))))
