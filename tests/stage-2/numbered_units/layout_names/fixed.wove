(module fixed_layout_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only (type (as Packet Left))))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove" (only (type (as Packet Right))))
	(use wove-file "./fixed_helper.wove" (only take_left take_right))

	(fn right_length
		(params (packet (shared-ref (specialize Right (owned-array u8))))) (returns i32)
		(body
			(let bytes (borrow-shared (struct:get packet bytes)))
			(return (i32:add (array:len bytes) (struct:get packet offset)))))

	(fn count_right
		(params (rows (shared-array (array (specialize Right (owned-array u8)) 1)))) (returns i32)
		(body
			(return (call right_length (borrow-shared (array:load (array:load rows 0i32) 0i32))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut left (array:alloc (array (specialize Left (owned-array u8)) 1) 1i32))
			(let-mut right (array:alloc (array (specialize Right (owned-array u8)) 1) 1i32))
			(array:store left 0i32 (array:new (array (specialize Left (owned-array u8)) 1)
				(struct:new (specialize Left (owned-array u8)) (bytes (array:alloc u8 19i32)))))
			(array:store right 0i32 (array:new (array (specialize Right (owned-array u8)) 1)
				(struct:new (specialize Right (owned-array u8)) (bytes (array:alloc u8 20i32)) (offset 3i32))))
			(let empty_left (array:new (array (array (specialize Left (owned-array u8)) 1) 0)))
			(let empty_right (array:new (array (array (specialize Right (owned-array u8)) 1) 0)))
			(if (i32:not-eqz (i32:add (array:len empty_left) (array:len empty_right))) (then (return 1i32)))
			(let left_size (call take_left (array:remove left 0i32)))
			(let right_size (call count_right (borrow-shared right)))
			(if (i32:not-eq right_size (call take_right (array:remove right 0i32))) (then (return 2i32)))
			(return (i32:add left_size right_size)))))
