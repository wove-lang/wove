(module local_scope_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Counter (variants (Empty) (Count i32)))

	(fn collect
		(generic (type T))
		(params (value T)) (returns T)
		(body
			(let bytes (array.alloc u8 1i32))
			(let item value)
			(return item)))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut total 0i32)
			(if (bool true)
				(then
					(let item 4i32)
					(if (bool true)
						(then
							(let item 5i32)
							(set total item)))
					(if (bool true)
						(then
							(let item 6i32)
							(set total (i32.add total item))))
					(set total (i32.add total item))))
			(let values (array.new (array i32 3) 0i32 1i32 2i32))
			(for (let position item) (borrow-shared values)
				(body (set total (i32.add total (i32.add position item)))))
			(match (enum.new Counter Count 21i32)
				(case Empty (return 1i32))
				(case Count (let item) (set total (i32.add total item))))
			(if (u8.not-eqz (call (specialize collect u8) 0u8)) (then (return 2i32)))
			(return (call (specialize collect i32) total)))))
