(module numbered_bridge_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./context.h" (only bridge_context))
	(use c-header "./native-headers/shared.h" (only (as shared root_shared)))
	(use c-header "./native-headers/root.h" (only bridge_root))
	(use wove-file "./child.wove" (only child_value))

	(fn read_root (params) (returns i32)
		(body (return (call bridge_root))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32:add (call root_shared 7i32) (i32:add (call read_root) (call child_value)))))))
