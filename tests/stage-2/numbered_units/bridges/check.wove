(module numbered_headers_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../stage-2/driver/numbered_headers.wove" (only certify_numbered_includes))
	(use wove-file "../../../../stage-2/cli/values.wove" (only argv_decimal))
	(use wove-file "../../../../stage-2/text/copy.wove" (only append_bytes))

	(let no_borrowed_guards "")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.lt (array.len argv) 5i32) (then (return 2i32)))
			(let program (borrow-shared (array.load argv 1i32)))
			(let serial_path (borrow-shared (array.load argv 2i32)))
			(let requested (borrow-shared (array.load argv 3i32)))
			(let prefix (borrow-shared (array.load argv 4i32)))
			(let count (call argv_decimal (borrow-shared requested) 0i32 (array.len requested) (bool false)))
			(if (bool.not (struct.get count valid)) (then (return 2i32)))
			(let-mut width 0i32)
			(for (let index) (range 5i32 (array.len argv))
				(body
					(let flag (borrow-shared (array.load argv index)))
					(set width (i32.add width (i32.inc (array.len flag))))))
			(let-mut options (array.alloc u8 width))
			(let-mut cursor 0i32)
			(for (let index) (range 5i32 (array.len argv))
				(body
					(let flag (borrow-shared (array.load argv index)))
					(set cursor (i32.inc (call append_bytes (borrow-shared flag) (borrow-mut options) cursor)))))
			(if (call certify_numbered_includes (borrow-shared program) (borrow-shared options) (borrow-shared serial_path)
					(i32.from-u32 (struct.get count magnitude)) (borrow-shared prefix) (borrow-shared no_borrowed_guards)
					(borrow-shared no_borrowed_guards) 0u8 (bool false) (bool false) (bool false) (bool false))
				(then (return 0i32)))
			(return 1i32)))
)
