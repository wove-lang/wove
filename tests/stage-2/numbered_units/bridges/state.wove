(module numbered_bridge_state
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./state.h" (only bridge_next))
	(bridge c-header "./state.h"
		(fn bridge_next (params) (returns i32)))

	(fn next (params) (returns i32)
		(body (return (call bridge_next))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32.add 39i32 (i32.add (call bridge_next) (call next)))))))
