(module numbered_bridge_child
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./native-headers/shared.h" (only (as shared child_shared)))
	(use c-header "<native-headers/child.h>" (only bridge_child))

	(fn child_value (params) (returns i32)
		(body (return (i32:add (call child_shared 10i32) (call bridge_child))))))
