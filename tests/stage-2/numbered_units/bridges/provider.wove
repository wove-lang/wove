(module numbered_bridge_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./context.h"
		(fn bridge_context (params) (returns i32)))
	(bridge c-header "./native-headers/shared.h"
		(fn shared (c-name "bridge_shared") (params (value i32)) (returns i32)))
	(bridge c-header "./native-headers/root.h"
		(fn bridge_root (params) (returns i32)))
	(bridge c-header "<native-headers/child.h>"
		(fn bridge_child (params) (returns i32))))
