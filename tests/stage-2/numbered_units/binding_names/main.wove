(module binding_name_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only left_value (value (as payload left))))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove" (only (value (as payload right))))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (u8:not-eq (array:load left 0i32) (call left_value)) (then (return 1i32)))
			(return (i32:add (i32:from-u8 (array:load left 0i32)) (i32:from-u8 (array:load right 0i32)))))))
