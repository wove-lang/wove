(module worker_adapter_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../job.wove" (only (type Job)))

	(fn render (params (job Job)) (returns (owned-array u8))
		(body (return (array:alloc u8 (i32:inc (struct:get job count)))))))
