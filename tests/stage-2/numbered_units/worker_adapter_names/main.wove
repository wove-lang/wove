(module worker_adapter_main
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./job.wove" (only (type Job)))
	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only (as render draw)))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove" (only (as render paint)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let job (struct:new Job (count 19i32)))
			(let left (worker:spawn-join draw job))
			(if (i32:not-eq (array:len left) 20i32) (then (return 1i32)))
			(let pool (worker:open-pool 1i32 1i32))
			(let permit (worker:reserve-wait pool))
			(let receipt (worker:spawn-on paint (move permit) job))
			(if (bool:not (worker:try-close pool)) (then (return 2i32)))
			(let right (worker:join receipt))
			(if (i32:not-eq (array:len right) 22i32) (then (return 3i32)))
			(return (i32:add (array:len left) (array:len right))))))
