(module numbered_worker_main
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type (as Job Tile)) (as render draw)))
	(use wove-file "./worker_helper.wove" (only other_tile))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let job (struct.new Tile (image (struct.new Image (width 1i32) (height 1i32) (limit 19i32))) (tile 2i32)))
			(let first (worker.spawn draw job))
			(let second (worker.spawn draw job))
			(let one (worker.join first))
			(let two (worker.join second))
			(if (u8.not-eq (array.load one 0i32) (array.load two 0i32)) (then (return 1i32)))
			(return (i32.add (i32.from-u8 (array.load one 0i32)) (call other_tile))))))
