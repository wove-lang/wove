(module temporary_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn run
		(generic (const N i32))
		(params) (returns i32)
		(body
			(let-mut count 0i32)
			(while (bool true)
				(body
					(let outer (array:alloc u8 N))
					(while (bool true)
						(body
							(let inner (array:alloc u8 1i32))
							(set count (i32:add (array:len outer) (array:len inner)))
							(break)))
					(break)))
			(return count)))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (i32:add (call (specialize run 18i32)) (call (specialize run 22i32)))))))
