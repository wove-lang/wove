(module numbered_unit_read_data
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./data.wove" (only (value answer) (value (as table values)) (value label) (value payload) (value empty) (value unused)))
	(use wove-file "./check_data.wove" (only check_data))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (array:len label) 4i32) (then (return 5i32)))
			(if (u8:not-eq (array:get label 1i32) 0u8) (then (return 6i32)))
			(if (u8:not-eq (array:get payload 2i32) 42u8) (then (return 7i32)))
			(if (i32:not-eqz (array:len empty)) (then (return 8i32)))
			(if (i32:not-eq (array:get values 0i32) 7i32) (then (return 9i32)))
			(return (i32:add answer (call check_data))))))
