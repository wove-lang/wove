(module numbered_worker_helper
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) (as render paint)))

	(fn other_tile (params) (returns i32)
		(body
			(let job (struct.new Job (image (struct.new Image (width 1i32) (height 1i32) (limit 20i32))) (tile 1i32)))
			(let pixels (worker.spawn-join paint job))
			(return (i32.from-u8 (array.load pixels 0i32))))))
