(module worker_drop_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only (type (as Packet LeftPacket))))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove" (only (type (as Packet RightPacket))))

	(fn relay_left
		(params (packet (specialize LeftPacket (owned-array u8))))
		(returns (specialize LeftPacket (owned-array u8)))
		(body (return (move packet))))

	(fn relay_right
		(params (packet (specialize RightPacket (owned-array u8))))
		(returns (specialize RightPacket (owned-array u8)))
		(body (return (move packet))))

	(fn left_length
		(params (packet (shared-ref (specialize LeftPacket (owned-array u8))))) (returns i32)
		(body
			(let bytes (borrow-shared (struct:get packet bytes)))
			(return (array:len bytes))))

	(fn right_length
		(params (packet (shared-ref (specialize RightPacket (owned-array u8))))) (returns i32)
		(body
			(let bytes (borrow-shared (struct:get packet bytes)))
			(return (i32:add (array:len bytes) (struct:get packet offset)))))

	(fn left_count (params) (returns i32)
		(body
			(let input (struct:new (specialize LeftPacket (owned-array u8)) (bytes (array:alloc u8 20i32))))
			(let output (worker:spawn-join relay_left (move input)))
			(let-mut slots (array:alloc (specialize LeftPacket (owned-array u8)) 1i32))
			(array:set slots 0i32
				(struct:new (specialize LeftPacket (owned-array u8)) (bytes (array:alloc u8 1i32))))
			(array:set slots 0i32 (move output))
			(return (call left_length (borrow-shared (array:get slots 0i32))))))

	(fn right_count (params) (returns i32)
		(body
			(let pool (worker:open-pool 1i32 1i32))
			(let permit (worker:reserve-wait pool))
			(let input (struct:new (specialize RightPacket (owned-array u8))
				(bytes (array:alloc u8 13i32)) (offset 9i32)))
			(let receipt (worker:spawn-on relay_right (move permit) (move input)))
			(if (bool:not (worker:try-close pool)) (then (return 1i32)))
			(let-mut pending (worker:receipt-queue relay_right))
			(worker:push pending (move receipt))
			(let slots (worker:join-all pending))
			(return (call right_length (borrow-shared (array:get slots 0i32))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let left (call left_count))
			(let right (call right_count))
			(if (i32:not-eq left 20i32) (then (return 2i32)))
			(return (i32:add left right)))))
