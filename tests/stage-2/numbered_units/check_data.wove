(module numbered_unit_check_data
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./data.wove" (only (value (as answer expected)) (value table) (value label) (value payload) (value empty)))

	(fn check_data
		(params) (returns i32)
		(body
			(if (u8:not-eq (array:get label 3i32) 169u8) (then (return 1i32)))
			(if (u8:not-eq (array:get payload 1i32) 255u8) (then (return 2i32)))
			(if (i32:not-eqz (array:len empty)) (then (return 3i32)))
			(if (i32:not-eq (array:get table 2i32) 7i32) (then (return 4i32)))
			(return expected))))
