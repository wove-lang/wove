(module callable_name_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only apply (type (as Transform Selected))))

	(type Reordered (fn-type (params u16 i32 u16 i64 u16 u16) (returns i32)))
	(type Shorter (fn-type (params i32 u16 u16 i64 u16) (returns i32)))
	(type DifferentResult (fn-type (params i32 u16 u16 i64 u16 u16) (returns bool)))
	(type EmptyAction (fn-type (params) (returns void)))

	(fn left (params (value i32) (a u16) (b u16) (c i64) (d u16) (e u16)) (returns i32)
		(body (return value)))

	(fn right (params (tag u32) (tens i32) (ones i32) (ready bool) (a bool) (b bool)) (returns i32)
		(body
			(if ready (then (return (i32:add (i32:mul tens 10i32) ones))))
			(return 0i32)))

	(fn zero_arguments (params) (returns i32)
		(body (return 2i32)))

	(fn relay (params (action Selected)) (returns i32)
		(body (return (call apply action))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (call relay (fn-ref left)))
			(let alternate (fn-ref right))
			(let second (call alternate 1u32 2i32 3i32 (bool true) (bool false) (bool false)))
			(let constant (fn-ref zero_arguments))
			(return (i32:add first (i32:add second (call constant)))))))
