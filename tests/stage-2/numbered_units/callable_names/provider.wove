(module callable_name_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(type Earlier (:pragma (cfg (os "linux"))) (fn-type (params u8) (returns u32)))
	(type Transform (fn-type (params i32 u16 u16 i64 u16 u16) (returns i32)))

	(fn apply (params (action Transform)) (returns i32)
		(body (return (call action 17i32 1u16 2u16 3i64 4u16 5u16)))))
