(module records_immutable_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(fn write (params (tokens (mut-array Token))) (returns i32)
		(body (return (array.len tokens))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call write (borrow-mut tokens))))))
