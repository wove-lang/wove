(module store_shared_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn value
		(params (bytes (shared-slice u8)))
		(returns u8)
		(body (return (slice.load (local bytes) (i32 0)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(slice.store (local data) (i32 0) (call value (borrow-shared (local data))))
			(return (i32 42)))))
