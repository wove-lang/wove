(module store_shared_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn value
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array.load (local bytes) (i32 0)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(array.store (local data) (i32 0) (call value (borrow-shared (local data))))
			(return (i32 42)))))
