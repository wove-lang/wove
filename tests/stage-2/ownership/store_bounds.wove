(module store_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(let index (i32.sub (i32.dec (array.len (local argv))) (i32 1)))
			(array.store (local data) (local index) (u8 42))
			(return (i32 42)))))
