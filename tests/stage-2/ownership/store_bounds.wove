(module store_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(let index (i32.sub (array.len (local argv)) (i32 1)))
			(array.store (local data) (local index) (u8 42))
			(return (i32 42)))))
