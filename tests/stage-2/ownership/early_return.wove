(module early_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_zero
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (i32.add.wrapping
				(int.convert i32 (array.load (local data) (i32 2))) (i32 42)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let data (array.alloc u8 (i32 3)))
			(if (bool true)
				(then (return (call read_zero (borrow-shared (local data))))))
			(return (i32 1)))))
