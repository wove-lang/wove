(module store_moved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(let received (move (local data)))
			(slice.store (local data) (i32 0) (u8 42))
			(return (i32 42)))))
