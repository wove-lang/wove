(module move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array.store (local data) (i32 1) (u8 41))
			(return (i32 1))))

	(fn read
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local data) (i32 1))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 3)))
			(let before (call put (borrow-mut (local data))))
			(let received (move (local data)))
			(return (i32.add (local before) (call read (borrow-shared (local received))))))))
