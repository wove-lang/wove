(module move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store (local data) (i32 1) (u8 41))
			(return (i32 1))))

	(fn read
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (int.convert i32 (slice.load (local data) (i32 1))))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 3)))
			(let before (call put (borrow-mut (local data))))
			(let received (move (local data)))
			(return (i32.add.wrapping (local before) (call read (borrow-shared (local received))))))))
