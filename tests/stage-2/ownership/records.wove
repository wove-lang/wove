(module owned_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (start i32) (marker u8)))
	(fn matches
		(params (actual Token) (expected Token))
		(returns bool)
		(body
			(return (bool.and
				(u32.eq (record.get (local actual) kind) (record.get (local expected) kind))
				(bool.and
					(i32.eq (record.get (local actual) start) (record.get (local expected) start))
					(u8.eq (record.get (local actual) marker) (record.get (local expected) marker)))))))
	(fn verify
		(params (tokens (shared-slice Token)) (first Token) (second Token))
		(returns bool)
		(body
			(return (bool.and
				(i32.eq (slice.len (local tokens)) (i32 2))
				(bool.and
					(call matches (slice.load (local tokens) (i32 0)) (local first))
					(call matches (slice.load (local tokens) (i32 1)) (local second)))))))
	(fn write
		(params (tokens (mut-slice Token)) (first Token) (second Token))
		(returns i32)
		(body
			(slice.store (local tokens) (i32 0) (local first))
			(slice.store (local tokens) (i32 1) (local second))
			(return (slice.len (local tokens)))))
	(fn exercise
		(params (count i32) (early bool))
		(returns i32)
		(body
			(let-mut tokens (array.alloc Token (local count)))
			(let zero (record.make Token (kind (u32 0)) (start (i32 0)) (marker (u8 0))))
			(if (bool.not (call verify (borrow-shared (local tokens)) (local zero) (local zero)))
				(then (return (i32 1))))
			(if (local early)
				(then (return (i32 17))))
			(let first (record.make Token (kind (u32 4294967295)) (start (i32 -2147483648)) (marker (u8 255))))
			(let second (record.make Token (kind (u32 2147483648)) (start (i32 2147483647)) (marker (u8 9))))
			(let written (call write (borrow-mut (local tokens)) (local first) (local second)))
			(if (bool.not (bool.and
					(i32.eq (local written) (i32 2))
					(call verify (borrow-shared (local tokens)) (local first) (local second))))
				(then (return (i32 2))))
			(return (i32 42))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let early (call exercise (i32 2) (bool true)))
			(let normal (call exercise (i32 2) (bool false)))
			(if (bool.and (i32.eq (local early) (i32 17)) (i32.eq (local normal) (i32 42)))
				(then (return (i32 42))))
			(return (i32 1)))))
