(module move_immutable_receiver
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store (local data) (i32 1) (u8 41))
			(return (i32 1))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 3)))
			(let received (move (local data)))
			(return (call put (borrow-mut (local received)))))))
