(module move_immutable_receiver
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array:store data (i32 1) (u8 41))
			(return (i32 1))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array:alloc u8 (i32 3)))
			(let received (move data))
			(return (call put (borrow-mut received))))))
