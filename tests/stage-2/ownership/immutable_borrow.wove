(module immutable_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array.store (local data) (i32 0) (u8 255))
			(return (i32 42))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let data (array.alloc u8 (i32 3)))
			(return (call write_byte (borrow-mut (local data)))))))
