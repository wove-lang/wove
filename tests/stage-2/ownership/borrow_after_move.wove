(module borrow_after_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local data) (i32 1))))))

	(fn attempt
		(params)
		(returns i32)
		(body
			(let data (array.alloc u8 (i32 3)))
			(let received (move (local data)))
			(return (call read
				(borrow-shared
					(local data))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (call attempt)))))
