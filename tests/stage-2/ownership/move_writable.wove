(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	move_writable

	(fn put
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store (local data) (i32 1) (u8 41))
			(return (i32 1))))

	(fn read
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (int.convert i32 (slice.load (local data) (i32 1))))))

	(fn run
		(params (early bool))
		(returns i32)
		(body
			(let data (array.alloc u8 (i32 3)))
			(let before (call read (borrow-shared (local data))))
			(if (local early)
				(then (return (i32.add.wrapping (local before) (i32 42)))))
			(let-mut received (move (local data)))
			(let written (call put (borrow-mut (local received))))
			(return (i32.add.wrapping (local written) (call read (borrow-shared (local received)))))))

	(fn main (params) (returns i32) (body (return (call run (bool false))))))
