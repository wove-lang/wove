(module move_writable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn put
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array.store (local data) (i32 1) (u8 41))
			(return (i32 1))))

	(fn read
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local data) (i32 1))))))

	(fn run
		(params (early bool))
		(returns i32)
		(body
			(let data (array.alloc u8 (i32 3)))
			(let before (call read (borrow-shared (local data))))
			(if (local early)
				(then (return (i32.add (local before) (i32 42)))))
			(let-mut received (move (local data)))
			(let written (call put (borrow-mut (local received))))
			(return (i32.add (local written) (call read (borrow-shared (local received)))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (call run (bool false))))))
