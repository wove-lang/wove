(module buffer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_byte
		(params (data (mut-array u8)) (value u8))
		(returns u8)
		(body
			(array.store (local data) (i32 1) (local value))
			(return (array.load (local data) (i32 1)))))

	(fn matches
		(params (data (shared-array u8)) (middle u8))
		(returns bool)
		(body
			(return (bool.and
				(u8.eq (array.load (local data) (i32 0)) (u8 0))
				(bool.and
					(u8.eq (array.load (local data) (i32 1)) (local middle))
					(u8.eq (array.load (local data) (i32 2)) (u8 0)))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut status (i32 1))
			(if (bool true)
				(then
					(let-mut data (array.alloc u8 (i32 3)))
					(if (call matches (borrow-shared (local data)) (u8 0))
						(then
							(let written (call write_byte (borrow-mut (local data)) (u8 255)))
							(if (bool.and (u8.eq (local written) (u8 255))
									(call matches (borrow-shared (local data)) (u8 255)))
								(then (set (local status) (i32 42))))))))
			(return (local status)))))
