(module store_mut_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn index
		(params (bytes (mut-slice u8)))
		(returns i32)
		(body (return (i32.sub.wrapping (slice.len (local bytes)) (i32 1)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(slice.store (local data) (call index (borrow-mut (local data))) (u8 42))
			(return (i32 42)))))
