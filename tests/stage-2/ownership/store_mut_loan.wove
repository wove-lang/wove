(module store_mut_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn index
		(params (bytes (mut-array u8)))
		(returns i32)
		(body (return (i32.sub (array.len (local bytes)) (i32 1)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(array.store (local data) (call index (borrow-mut (local data))) (u8 42))
			(return (i32 42)))))
