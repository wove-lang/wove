(module records_wrong_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn read (params (tokens (shared-array Other))) (returns i32)
		(body (return (array:len tokens))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let tokens (array:alloc Token (i32 2)))
			(return (call read (borrow-shared tokens))))))
