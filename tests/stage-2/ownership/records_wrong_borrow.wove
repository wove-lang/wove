(module records_wrong_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct Other (fields (kind u32)))
	(fn read (params (tokens (shared-slice Other))) (returns i32)
		(body (return (slice.len (local tokens)))))
	(fn main (params) (returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call read (borrow-shared (local tokens)))))))
