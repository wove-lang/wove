(module store_wrong_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(array.store (local data) (i32 0) (i8 42))
			(return (i32 42)))))
