	(fn write
		(params (value (mut-ref i32))) (returns void)
		(body (set (local value) 42u32)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(return 0i32))))
