(module scalar_ref_missing_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write
		(params (value (mut-ref i32))) (returns void)
		(body (set (local value) 42i32)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut out 0i32)
			(call write (local out))
			(return 0i32))))
