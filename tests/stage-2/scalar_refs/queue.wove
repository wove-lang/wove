(module scalar_ref_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct QueueState (fields (tail i32) (capacity i32)))

	(fn advance
		(params (tail (mut-ref i32)))
		(returns void)
		(body (set (local tail) (i32.add (local tail) 1i32))))

	(fn visit
		(params (queue (mut-array i32)) (next i32) (tail (mut-ref i32)))
		(returns void)
		(body
			(array.store (local queue) (local tail) (local next))
			(call advance (borrow-mut (local tail)))))

	(fn reset
		(params (tail (mut-ref i32)))
		(returns i32)
		(body
			(set (local tail) 0i32)
			(return 1i32)))

	(fn keep_first
		(params (first i32) (second i32))
		(returns i32)
		(body
			(if (i32.eq (local second) 1i32) (then (return (local first))))
			(return -1i32)))

	(fn drain
		(params (tail (mut-ref i32)))
		(returns i32)
		(body (return (call keep_first (local tail) (call reset (borrow-mut (local tail)))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:369"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut queue (array.new (array i32 2) -1i32 -1i32))
			(let-mut state (struct.new QueueState (tail 0i32) (capacity 2i32)))
			(call visit (borrow-mut (local queue)) 17i32 (borrow-mut (struct.get (local state) tail)))
			(call visit (borrow-mut (local queue)) 42i32 (borrow-mut (struct.get (local state) tail)))
			(let count (call drain (borrow-mut (struct.get (local state) tail))))
			(if (bool.not (i32.eq (local count) (struct.get (local state) capacity))) (then (return 1i32)))
			(if (bool.not (i32.eq (struct.get (local state) tail) 0i32)) (then (return 2i32)))
			(if (bool.not (i32.eq (array.load (local queue) 0i32) 17i32)) (then (return 3i32)))
			(return (array.load (local queue) 1i32)))))
