(module scalar_ref_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct QueueState (fields (tail i32) (capacity i32)))

	(fn advance
		(params (tail (mut-ref i32)))
		(returns void)
		(body (set tail (i32:add tail 1i32))))

	(fn visit
		(params (queue (mut-array i32)) (next i32) (tail (mut-ref i32)))
		(returns void)
		(body
			(array:set queue tail next)
			(call advance (borrow-mut tail))))

	(fn reset
		(params (tail (mut-ref i32)))
		(returns i32)
		(body
			(set tail 0i32)
			(return 1i32)))

	(fn keep_first
		(params (first i32) (second i32))
		(returns i32)
		(body
			(if (i32:eq second 1i32) (then (return first)))
			(return -1i32)))

	(fn drain
		(params (tail (mut-ref i32)))
		(returns i32)
		(body (return (call keep_first tail (call reset (borrow-mut tail))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:369"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut queue (array:new (array i32 2) -1i32 -1i32))
			(let-mut state (struct:new QueueState (tail 0i32) (capacity 2i32)))
			(call visit (borrow-mut queue) 17i32 (borrow-mut (struct:get state tail)))
			(call visit (borrow-mut queue) 42i32 (borrow-mut (struct:get state tail)))
			(let count (call drain (borrow-mut (struct:get state tail))))
			(if (bool:not (i32:eq count (struct:get state capacity))) (then (return 1i32)))
			(if (bool:not (i32:eq (struct:get state tail) 0i32)) (then (return 2i32)))
			(if (bool:not (i32:eq (array:get queue 0i32) 17i32)) (then (return 3i32)))
			(return (array:get queue 1i32)))))
