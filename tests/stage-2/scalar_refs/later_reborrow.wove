(module scalar_ref_later_reborrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write
		(params (value (mut-ref i32)) (next (mut-ref i32))) (returns void)
		(body (set (local value) (local next))))

	(fn forward
		(params (pointer (mut-ref i32))) (returns void)
		(body (call write
			(borrow-mut (local pointer))
			(borrow-mut (local pointer)))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut out 0i32)
			(call forward (borrow-mut (local out)))
			(return 0i32))))
