(module scalar_ref_octal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let field " 52\u0000 ")
	(let invalid "58 ")
	(let extra "52 7")

	(fn octal
		(params (bytes (shared-array u8)) (output (mut-ref u64)))
		(returns bool)
		(body
			(let-mut value 0u64)
			(let-mut digit_seen (bool false))
			(let-mut ended (bool false))
			(for (bind byte) (borrow-shared (local bytes))
				(body
					(if (bool.or (u8.eq (local byte) 32u8)
						(bool.and (local digit_seen) (u8.eq (local byte) 0u8)))
						(then
							(set (local ended) (local digit_seen))
							(continue)))
					(if (bool.or (local ended) (bool.or (u8.lt (local byte) 48u8) (u8.lt 55u8 (local byte))))
						(then (return (bool false))))
					(let digit (u64.from-i32 (i32.sub (i32.from-u8 (local byte)) 48i32)))
					(set (local value) (u64.or (u64.shl (local value) 3i32) (local digit)))
					(set (local digit_seen) (bool true))))
			(if (bool.not (bool.and (local digit_seen) (local ended))) (then (return (bool false))))
			(set (local output) (local value))
			(return (bool true))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:369"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut parsed 18446744073709551615u64)
			(if (call octal (borrow-shared (local invalid)) (borrow-mut (local parsed))) (then (return 1i32)))
			(if (call octal (borrow-shared (local extra)) (borrow-mut (local parsed))) (then (return 4i32)))
			(if (bool.not (u64.eq (local parsed) 18446744073709551615u64)) (then (return 2i32)))
			(if (bool.not (call octal (borrow-shared (local field)) (borrow-mut (local parsed)))) (then (return 3i32)))
			(return (i32.from-u64 (local parsed))))))
