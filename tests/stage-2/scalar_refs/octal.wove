(module scalar_ref_octal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let field " 52\u0000 ")
	(let invalid "58 ")
	(let extra "52 7")

	(fn octal
		(params (bytes (shared-array u8)) (output (mut-ref u64)))
		(returns bool)
		(body
			(let-mut value 0u64)
			(let-mut digit_seen (bool false))
			(let-mut ended (bool false))
			(for (let byte) (borrow-shared bytes)
				(body
					(if (bool.or (u8.eq byte 32u8)
						(bool.and digit_seen (u8.eq byte 0u8)))
						(then
							(set ended digit_seen)
							(continue)))
					(if (bool.or ended (bool.or (u8.lt byte 48u8) (u8.lt 55u8 byte)))
						(then (return (bool false))))
					(let digit (u64.from-i32 (i32.sub (i32.from-u8 byte) 48i32)))
					(set value (u64.or (u64.shl value 3i32) digit))
					(set digit_seen (bool true))))
			(if (bool.not (bool.and digit_seen ended)) (then (return (bool false))))
			(set output value)
			(return (bool true))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:369"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut parsed 18446744073709551615u64)
			(if (call octal (borrow-shared invalid) (borrow-mut parsed)) (then (return 1i32)))
			(if (call octal (borrow-shared extra) (borrow-mut parsed)) (then (return 4i32)))
			(if (bool.not (u64.eq parsed 18446744073709551615u64)) (then (return 2i32)))
			(if (bool.not (call octal (borrow-shared field) (borrow-mut parsed))) (then (return 3i32)))
			(return (i32.from-u64 parsed)))))
