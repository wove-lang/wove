(module invalid_native_row_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn conflicting
		(params (row (shared-array u8)) (rows (mut-array (owned-array u8))))
		(returns i32)
		(body (return 0i32)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 1i32))
			(return (call conflicting
				(borrow-shared (array:load rows 0i32))
				(borrow-mut rows))))))
