(module native_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make_row
		(params (value u8) (size i32))
		(returns (owned-array u8))
		(body
			(let-mut bytes (array.alloc u8 (local size)))
			(if (i32.lt 0i32 (local size))
				(then (array.store (local bytes) 0i32 (local value))))
			(return (move (local bytes)))))

	(fn new_rows
		(params)
		(returns (owned-array (owned-array u8)))
		(body
			(let-mut rows (array.alloc (owned-array u8) 2i32))
			(let first (call make_row 40u8 1i32))
			(array.store (local rows) 0i32 (move (local first)))
			(return (move (local rows)))))

	(fn fill_empty
		(params (rows (mut-array (owned-array u8))))
		(returns void)
		(body (array.store (local rows) 1i32 (call make_row 0u8 0i32))))

	(fn count
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (array.len (local bytes)))))

	(fn first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local bytes) 0i32)))))

	(fn row_size
		(params (rows (shared-array (owned-array u8))) (index i32))
		(returns i32)
		(body (return (call count (borrow-shared (array.load (local rows) (local index)))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut rows (call new_rows))
			(let empty (array.alloc (owned-array u8) 0i32))
			(if (bool.not (i32.eq (array.len (local empty)) 0i32)) (then (return 1i32)))
			(if (bool.not (i32.eq (array.len (local rows)) 2i32)) (then (return 2i32)))
			(call fill_empty (borrow-mut (local rows)))
			(if (bool.not (i32.eq (call row_size (borrow-shared (local rows)) 1i32) 0i32)) (then (return 3i32)))
			(if (bool.not (i32.eq (call first (borrow-shared (array.load (local rows) 0i32))) 40i32))
				(then (return 4i32)))
			(array.store (local rows) 0i32 (call make_row 42u8 1i32))
			(return (call first (borrow-shared (array.load (local rows) 0i32)))))))
