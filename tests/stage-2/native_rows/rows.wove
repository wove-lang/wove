(module native_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make_row
		(params (value u8) (size i32))
		(returns (owned-array u8))
		(body
			(let-mut bytes (array:alloc u8 size))
			(if (i32:lt 0i32 size)
				(then (array:set bytes 0i32 value)))
			(return (move bytes))))

	(fn new_rows
		(params)
		(returns (owned-array (owned-array u8)))
		(body
			(let-mut rows (array:alloc (owned-array u8) 2i32))
			(let first (call make_row 40u8 1i32))
			(array:set rows 0i32 (move first))
			(return (move rows))))

	(fn fill_empty
		(params (rows (mut-array (owned-array u8))))
		(returns void)
		(body (array:set rows 1i32 (call make_row 0u8 0i32))))

	(fn count
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (array:len bytes))))

	(fn first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int:convert i32 (array:get bytes 0i32)))))

	(fn row_size
		(params (rows (shared-array (owned-array u8))) (index i32))
		(returns i32)
		(body (return (call count (borrow-shared (array:get rows index))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (call new_rows))
			(let empty (array:alloc (owned-array u8) 0i32))
			(if (bool:not (i32:eq (array:len empty) 0i32)) (then (return 1i32)))
			(if (bool:not (i32:eq (array:len rows) 2i32)) (then (return 2i32)))
			(call fill_empty (borrow-mut rows))
			(if (bool:not (i32:eq (call row_size (borrow-shared rows) 1i32) 0i32)) (then (return 3i32)))
			(if (bool:not (i32:eq (call first (borrow-shared (array:get rows 0i32))) 40i32))
				(then (return 4i32)))
			(array:set rows 0i32 (call make_row 42u8 1i32))
			(return (call first (borrow-shared (array:get rows 0i32)))))))
