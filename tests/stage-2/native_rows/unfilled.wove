(module unfilled_native_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn count_row
		(params (bytes (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local bytes)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let rows (array.alloc (owned-array u8) 1i32))
			(return (call count_row (borrow-shared (slice.load (local rows) 0i32)))))))
