(module invalid_native_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 1i32))
			(let row (array:alloc u8 1i32))
			(array:store rows 0i32 row)
			(return 0i32))))
