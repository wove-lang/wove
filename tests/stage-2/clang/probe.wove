(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	clang_fixture

	(use wove-file "../../../stage-2/clang/source.wove" (only (type ProbeSource) render_clang_probe))
	(use wove-file "../../../stage-2/clang/index.wove" (only (type ClangDeclaration) (type ClangIndex) clang_index clang_declaration))
	(use wove-file "../../../stage-2/clang/values.wove" (only (type ProbeWord) clang_probe_value clang_probe_u32))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))

	(struct Inspection (fields (error u32) (start i32) (end i32) (count i32)
		(match_start i32) (match_end i32) (probe_error u32) (probe_start i32) (probe_end i32) (probe_value u32)))

	(fn emit_probe
		(params (template (shared-slice u8)) (header (shared-slice u8)) (extra (shared-slice u8)) (output (mut-slice u8)))
		(returns ProbeSource)
		(body (return (call render_clang_probe (borrow-shared (local template)) (borrow-shared (local header))
			(borrow-shared (local extra)) (borrow-mut (local output))))))

	(fn inspect
		(params (source (shared-slice u8)) (offset i32) (kind (shared-slice u8)) (name (shared-slice u8)) (probe (shared-slice u8)))
		(returns Inspection)
		(body
			(let width (slice.len (local source)))
			(let-mut nodes (array.alloc JsonNode (local width)))
			(let-mut entries (array.alloc ClangDeclaration (local width)))
			(let-mut names (array.alloc u8 (local width)))
			(let index (call clang_index (borrow-shared (local source)) (local offset) (borrow-mut (local nodes))
				(borrow-mut (local entries)) (borrow-mut (local names))))
			(if (u32.lt (u32 0) (record.get (local index) error))
				(then (return (record.make Inspection (error (record.get (local index) error))
					(start (record.get (local index) start)) (end (record.get (local index) end)) (count (i32 0))
					(match_start (i32 -1)) (match_end (i32 -1)) (probe_error (u32 0))
					(probe_start (i32 -1)) (probe_end (i32 -1)) (probe_value (u32 0))))))
			(let declaration (call clang_declaration (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local kind)) (borrow-shared (local name))))
			(if (i32.eq (slice.len (local probe)) (i32 0))
				(then (return (call inspection (local index) (local declaration)
					(record.make ProbeWord (error (u32 0)) (start (i32 -1)) (end (i32 -1)) (value (u32 0)))))))
			(let selected (call clang_probe_value (borrow-shared (local source)) (local index) (borrow-shared (local nodes))
				(borrow-shared (local entries)) (borrow-shared (local names)) (borrow-shared (local probe))))
			(let value (call clang_probe_u32 (borrow-shared (local source)) (local selected)))
			(return (call inspection (local index) (local declaration) (local value)))))

	(fn inspection
		(params (index ClangIndex) (declaration ClangDeclaration) (probe ProbeWord))
		(returns Inspection)
		(body (return (record.make Inspection (error (u32 0)) (start (record.get (local index) start))
			(end (record.get (local index) end)) (count (record.get (local index) entries))
			(match_start (record.get (local declaration) start)) (match_end (record.get (local declaration) end))
			(probe_error (record.get (local probe) error)) (probe_start (record.get (local probe) start))
			(probe_end (record.get (local probe) end)) (probe_value (record.get (local probe) value))))))

	(fn main (params) (returns i32) (body (return (i32 0)))))
