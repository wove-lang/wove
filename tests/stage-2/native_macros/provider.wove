(module macro_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./macros.h"
		(fn MACRO_REPEAT (:pragma (c_macro)) (params (first u8) (second u8)) (returns u32))
		(fn MACRO_IGNORE (:pragma (c_macro)) (params (value u8)) (returns u32))
		(fn MACRO_IS_BYTE (:pragma (c_macro)) (params (value u8)) (returns bool))
		(fn MACRO_BAD_MARKER (:pragma (c_macro value)) (params (value u8)) (returns u8))
		(fn MACRO_DUPLICATE (:pragma (c_macro)) (:pragma (c_macro)) (params) (returns u8))
		(fn MACRO_FIRST_BYTE (:pragma (c_macro) (c_cstr data))
			(params (data (shared-array u8))) (returns i32))
		(fn MACRO_VIEW (:pragma (c_macro) (c_bytes bytes count))
			(params (bytes (mut-array u8)) (count i32)) (returns u8)))
)
