(module evaluate_macros
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./macros.h"
		(only (as MACRO_REPEAT repeat) (as MACRO_IGNORE ignore) (as MACRO_IS_BYTE exact_byte)))

	(fn next_byte
		(params (data (mut-array u8))) (returns u8)
		(body
			(let old (int:convert i32 (array:get data (i32 0))))
			(let next (int:convert u8 (i32:add old (i32 1))))
			(array:set data (i32 0) next)
			(return next)))

	(fn current_byte
		(params (data (shared-array u8))) (returns u8)
		(body (return (array:get data (i32 0)))))

	(fn main
		(:expect (tests "stage-2/native_macros/cases.tsv") (issues "gh:wove-lang/wove:255"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 (i32 1)))
			(let value (call repeat
				(call next_byte (borrow-mut data))
				(call next_byte (borrow-mut data))))
			(let ignored (call ignore (call next_byte (borrow-mut data))))
			(if (bool:and (u32:eq value (u32 4)) (u32:eq ignored (u32 4294967295)))
				(then
					(if (bool:and (call exact_byte (u8 255)) (u8:eq (call current_byte (borrow-shared data)) (u8 3)))
						(then (return (i32 42))))))
			(return (i32 1))))
)
