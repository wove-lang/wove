(module stat_macros
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<sys/stat.h>" (only (type Stat) stat (as S_ISREG regular_mode)))
	(let regular_path "tests/stage-2/native_records/data.txt")
	(let directory_path "tests/stage-2/native_records")

	(fn classify
		(:expect (tests "stage-2/native_macros/cases.tsv") (issues "gh:wove-lang/wove:255"))
		(params (path (shared-slice u8))) (returns i32)
		(body
			(let-mut info (record.make Stat))
			(if (bool.not (i32.eq (call stat (borrow-shared (local path)) (borrow-mut (local info))) (i32 0)))
				(then (return (i32 0))))
			(if (call regular_mode (record.get (local info) st_mode))
				(then (return (i32 1))))
			(return (i32 2))))

	(fn main (params) (returns i32)
		(body
			(if (i32.eq (call classify (borrow-shared (local regular_path))) (i32 1))
				(then
					(if (i32.eq (call classify (borrow-shared (local directory_path))) (i32 2))
						(then (return (i32 42))))))
			(return (i32 1))))
)
