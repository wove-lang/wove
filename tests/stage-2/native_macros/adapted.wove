(module adapted_macros
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./macros.h" (only (as MACRO_FIRST_BYTE first_byte) (as MACRO_VIEW write_byte)))
	(let message "*")

	(fn read_byte (params (data (shared-array u8))) (returns u8)
		(body (return (array.load data (i32 0)))))

	(fn main
		(:expect (tests "stage-2/native_macros/cases.tsv") (issues "gh:wove-lang/wove:255"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 1)))
			(let first (call first_byte (borrow-shared message)))
			(let written (call write_byte (borrow-mut data) (i32 1)))
			(if (bool.and (i32.eq first (i32 42)) (u8.eq written (u8 42)))
				(then
					(return (int.convert i32 (call read_byte (borrow-shared data))))))
			(return (i32 1))))
)
