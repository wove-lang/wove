(module macro_statements
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./macros.h" (only (as MACRO_VOID_STMT check_first) (as wove_test_visit visit)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn next (params (count (mut-ref i32))) (returns i32)
		(body
			(set (local count) (i32.add (local count) 1i32))
			(return (local count))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut count 0i32)
			(call check_first (call next (borrow-mut (local count))) (call next (borrow-mut (local count))))
			(call visit (borrow-mut (local count)))
			(if (i32.eq (local count) 3i32) (then (return 42i32)))
			(return 1i32))))
