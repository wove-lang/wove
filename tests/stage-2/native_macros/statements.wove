(module macro_statements
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./macros.h" (only (as MACRO_VOID_STMT check_first) (as wove_test_visit visit)))

	(fn next (params (count (mut-ref i32))) (returns i32)
		(body
			(set count (i32:add count 1i32))
			(return count)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut count 0i32)
			(call check_first (call next (borrow-mut count)) (call next (borrow-mut count)))
			(call visit (borrow-mut count))
			(if (i32:eq count 3i32) (then (return 42i32)))
			(return 1i32))))
