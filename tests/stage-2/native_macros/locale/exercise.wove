(module locale_macro_capture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./locale_macros.h" (only tracked_newlocale isascii_l toascii_l next_character tracked_locale_ok))

	(struct ArgSpan (fields (start i32) (end i32)))
	(let c_locale "C")

	(fn exercise (params) (returns i32)
		(body
			(let locale (call tracked_newlocale (borrow-shared (local c_locale))))
			(if (owner.is-null (local locale)) (then (return 1i32)))
			(if (i32.eqz (call isascii_l (call next_character 65i32) (borrow-shared (local locale)))) (then (return 2i32)))
			(if (i32.not-eqz (call isascii_l (call next_character 193i32) (borrow-shared (local locale)))) (then (return 3i32)))
			(if (i32.not-eq (call toascii_l (call next_character 193i32) (borrow-shared (local locale))) 65i32) (then (return 4i32)))
			(if (i32.not-eq (call toascii_l (call next_character -1i32) (borrow-shared (local locale))) 127i32) (then (return 5i32)))
			(return 42i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let result (call exercise))
			(if (i32.not-eq (local result) 42i32) (then (return (local result))))
			(if (i32.eqz (call tracked_locale_ok)) (then (return 6i32)))
			(return 42i32))))
