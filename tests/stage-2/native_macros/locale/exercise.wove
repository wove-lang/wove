(module locale_macro_capture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./locale_macros.h" (only tracked_newlocale isascii_l toascii_l next_character tracked_locale_ok))

	(let c_locale "C")

	(fn exercise (params) (returns i32)
		(body
			(let locale (call tracked_newlocale (borrow-shared c_locale)))
			(if (owner.is-null locale) (then (return 1i32)))
			(if (i32.eqz (call isascii_l (call next_character 65i32) (borrow-shared locale))) (then (return 2i32)))
			(if (i32.not-eqz (call isascii_l (call next_character 193i32) (borrow-shared locale))) (then (return 3i32)))
			(if (i32.not-eq (call toascii_l (call next_character 193i32) (borrow-shared locale)) 65i32) (then (return 4i32)))
			(if (i32.not-eq (call toascii_l (call next_character -1i32) (borrow-shared locale)) 127i32) (then (return 5i32)))
			(return 42i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call exercise))
			(if (i32.not-eq result 42i32) (then (return result)))
			(if (i32.eqz (call tracked_locale_ok)) (then (return 6i32)))
			(return 42i32))))
