(module non_macro_discard
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./locale_macros.h"
		(type (:pragma (c_owned (drop tracked_freelocale))) Locale (c-type "locale_t"))
		(fn isascii_l
			(params (c i32) (locale (:pragma (c_macro_discard)) (shared-ref Locale))) (returns i32)))
	(use c-header "./locale_macros.h" (only isascii_l (type Locale)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let locale (native.empty Locale))
			(return (call isascii_l 65i32 (borrow-shared (local locale)))))))
