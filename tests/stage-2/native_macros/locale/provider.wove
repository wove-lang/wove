(module locale_macro_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./locale_macros.h"
		(type (:pragma (c_owned (drop tracked_freelocale))) Locale (c-type "locale_t"))
		(fn tracked_newlocale
			(:pragma (c_cstr name))
			(params (const mask i32 LC_CTYPE_MASK) (name (shared-array u8)) (const base (c-type "locale_t") null))
			(returns Locale))
		(fn isascii_l (:pragma (c_macro))
			(params (c i32) (locale (:pragma (c_macro_discard)) (shared-ref Locale))) (returns i32))
		(fn toascii_l (:pragma (c_macro))
			(params (c i32) (locale (:pragma (c_macro_discard)) (shared-ref Locale))) (returns i32))
		(fn next_character (params (c i32)) (returns i32))
		(fn tracked_locale_ok (params) (returns i32))))
