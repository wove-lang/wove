(module assert_call
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<assert.h>" (only assert))

	(fn condition (params (count (mut-ref i32)) (passes bool)) (returns bool)
		(body
			(set count (i32.add count 1i32))
			(return passes)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut count 0i32)
			(call assert (call condition (borrow-mut count) (i32.eq (i32.dec (array.len args)) 0i32)))
			(if (i32.eq count 1i32) (then (return 42i32)))
			(return 1i32))))
