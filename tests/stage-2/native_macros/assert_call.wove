(module assert_call
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./assert-provider.wove" (only))
	(use c-header "<assert.h>" (only assert))

	(fn condition (params (count (mut-ref i32)) (passes bool)) (returns bool)
		(body
			(set (local count) (i32.add (local count) 1i32))
			(return (local passes))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut count 0i32)
			(call assert (call condition (borrow-mut (local count)) (i32.eq (i32.dec (array.len (local args))) 0i32)))
			(if (i32.eq (local count) 1i32) (then (return 42i32)))
			(return 1i32))))
