(module wrong_macro_argument
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<sys/stat.h>" (only (as S_ISREG regular_mode)))
	(fn main (params) (returns i32)
		(body
			(if (call regular_mode (u32 0)) (then (return (i32 1))))
			(return (i32 0))))
)
