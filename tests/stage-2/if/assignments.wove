(module branch_assignments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params) (returns i32)
		(body
			(let on_true (call choose (bool true)))
			(let on_false (call choose (bool false)))
			(return (i32.sub.wrapping (local on_true) (local on_false)))))
	(fn choose (params (condition bool)) (returns i32)
		(body
			(let-mut score (i32 0))
			(let bonus (i32 3))
			(if (call pass_bool (local condition))
				(then
					(let bonus (i32.add.wrapping (local bonus) (i32 1)))
					(let points (i32 43))
					(if (local condition)
						(then
							(set (local score) (call credit (i32.add.wrapping (local points) (local bonus)))))))
				(else
					(let points (i32 5))
					(set (local score) (call credit (local points)))))
			(return (i32.add.wrapping (local score) (local bonus)))))
	(fn pass_bool (params (value bool)) (returns bool)
		(body (return (local value))))
	(fn credit (params (value i32)) (returns i32)
		(body (return (local value)))))
