(module branch_assignments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let on_true (call choose (bool true)))
			(let on_false (call choose (bool false)))
			(return (i32:sub on_true on_false))))
	(fn choose (params (condition bool)) (returns i32)
		(body
			(let-mut score (i32 0))
			(let bonus (i32 3))
			(if (call pass_bool condition)
				(then
					(let bonus (i32:add bonus (i32 1)))
					(let points (i32 43))
					(if condition
						(then
							(set score (call credit (i32:add points bonus))))))
				(else
					(let points (i32 5))
					(set score (call credit points))))
			(return (i32:add score bonus))))
	(fn pass_bool (params (value bool)) (returns bool)
		(body (return value)))
	(fn credit (params (value i32)) (returns i32)
		(body (return value))))
