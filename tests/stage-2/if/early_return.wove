(module branch_early_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (i32.sub (call early (bool true)) (call early (bool false))))))
	(fn early (params (take_branch bool)) (returns i32)
		(body
			(if take_branch
				(then
					(if (bool false)
						(then (return (i32 -9)))
						(else (return (i32 47))))))
			(return (i32 5)))))
