(module branch_early_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(return (i32.sub.wrapping (call early (bool true)) (call early (bool false))))))
	(fn early (params (take_branch bool)) (returns i32)
		(body
			(if (local take_branch)
				(then
					(if (bool false)
						(then (return (i32 -9)))
						(else (return (i32 47))))))
			(return (i32 5)))))
