(module branch_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (bool true)
				(then (:doc "The selected empty arm falls through."))
				(else))
			(if (i32.lt (i32 0) (i32 -1))
				(then (return (i32 -2)))
				(else (return (i32 42)))))))
