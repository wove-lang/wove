(module native_scalar_ref_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./refs.h" (only update_status capture_status))

	(fn check
		(params (before i32) (result i32) (after i32))
		(returns i32)
		(body
			(if (bool.and (i32.eq before (i32 21))
				(bool.and (i32.eq result (i32 17)) (i32.eq after (i32 99))))
				(then (return (i32 42))))
			(return (i32 1))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut status (i32 21))
			(let before (call capture_status status (borrow-mut status)))
			(if (bool.not (i32.eq before (i32 21)))
				(then (return (i32 2))))
			(set status (i32 21))
			(return (call check status (call update_status (borrow-mut status)) status)))))
