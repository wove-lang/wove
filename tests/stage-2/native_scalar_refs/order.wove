(module native_scalar_ref_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./refs.h" (only update_status capture_status))

	(fn check
		(params (before i32) (result i32) (after i32))
		(returns i32)
		(body
			(if (bool.and (i32.eq (local before) (i32 21))
				(bool.and (i32.eq (local result) (i32 17)) (i32.eq (local after) (i32 99))))
				(then (return (i32 42))))
			(return (i32 1))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut status (i32 21))
			(let before (call capture_status (local status) (borrow-mut (local status))))
			(if (bool.not (i32.eq (local before) (i32 21)))
				(then (return (i32 2))))
			(set (local status) (i32 21))
			(return (call check (local status) (call update_status (borrow-mut (local status))) (local status))))))
