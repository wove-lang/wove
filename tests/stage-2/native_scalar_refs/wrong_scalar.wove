(module scalar_ref_wrong_scalar
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<sys/wait.h>" (only (type Pid) waitpid))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut status (u32 0))
			(return (int:convert i32 (call waitpid (int:convert Pid (i32 1)) (borrow-mut status) (i32 0)))))))
