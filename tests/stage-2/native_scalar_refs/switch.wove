(module native_scalar_ref_switch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./switch.h" (only set_switch))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut enabled (bool false))
			(if (bool.not (i32.eq (call set_switch (borrow-mut (local enabled))) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (local enabled))
				(then (return (i32 2))))
			(if (bool.not (i32.eq (call set_switch null) (i32 7)))
				(then (return (i32 3))))
			(return (i32 42)))))
