(module scalar_ref_wrong_alias
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./refs.h" (only (type OtherPid) fill_pid))
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut slot (int.convert OtherPid (i32 0)))
			(return (call fill_pid (borrow-mut (local slot)))))))
