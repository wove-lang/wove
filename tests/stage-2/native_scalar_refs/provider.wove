(module native_scalar_ref_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./refs.h"
		(type Pid (c-type "pid_t"))
		(type OtherPid (c-type "pid_t"))
		(fn start_child
			(params (status i32))
			(returns Pid))
		(fn fill_pid
			(params (destination (mut-ref Pid)))
			(returns i32))
		(fn update_status
			(params (destination (mut-ref i32)))
			(returns i32))
		(fn capture_status
			(params (before i32) (destination (mut-ref i32)))
			(returns i32)))
	(bridge c-header "./switch.h"
		(fn set_switch
			(:pragma (c_nullable value))
			(params (value (mut-ref bool)))
			(returns i32))))
