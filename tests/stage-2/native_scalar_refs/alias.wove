(module native_scalar_ref_alias
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./refs.h" (only (type Pid) fill_pid update_status))

	(struct Slots (fields (first i32) (second i32)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut slot (int.convert Pid (i32 -1)))
			(if (bool.not (i32.eq (call fill_pid (borrow-mut slot)) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (i32.eq (int.convert i32 slot) (i32 12345)))
				(then (return (i32 2))))
			(let-mut fields (struct.new Slots (first (i32 -1)) (second (i32 7))))
			(if (bool.not (i32.eq (call update_status (borrow-mut (struct.get fields first))) (i32 17)))
				(then (return (i32 3))))
			(if (bool.not (i32.eq (struct.get fields first) (i32 99)))
				(then (return (i32 4))))
			(if (bool.not (i32.eq (struct.get fields second) (i32 7)))
				(then (return (i32 5))))
			(return (i32 42)))))
