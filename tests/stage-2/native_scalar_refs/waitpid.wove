(module native_waitpid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./refs.h" (only start_child))
	(use c-header "<sys/wait.h>" (only (type Pid) waitpid WIFEXITED WEXITSTATUS))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let child (int.convert Pid (call start_child (i32 37))))
			(if (i32.lt (int.convert i32 (local child)) (i32 1))
				(then (return (i32 1))))
			(let-mut status (i32 -1))
			(let reaped (call waitpid (local child) (borrow-mut (local status)) (i32 0)))
			(if (bool.not (i32.eq (int.convert i32 (local reaped)) (int.convert i32 (local child))))
				(then (return (i32 2))))
			(if (bool.not (call WIFEXITED (local status)))
				(then (return (i32 3))))
			(if (bool.not (i32.eq (call WEXITSTATUS (local status)) (i32 37)))
				(then (return (i32 4))))
			(let other (int.convert Pid (call start_child (i32 0))))
			(if (i32.lt (int.convert i32 (local other)) (i32 1))
				(then (return (i32 5))))
			(let ignored_status (call waitpid (local other) null (i32 0)))
			(if (bool.not (i32.eq (int.convert i32 (local ignored_status)) (int.convert i32 (local other))))
				(then (return (i32 6))))
			(return (i32 42)))))
