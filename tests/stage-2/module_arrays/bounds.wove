(module module_table_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let digits (array:new (array i32 1) 42i32))
	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let index (i32:sub (i32:dec (array:len args)) 1i32))
			(return (array:get digits index)))))
