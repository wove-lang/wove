(module nested_static_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let table (array.new (array (array i32 2) 2)
		(array.new (array i32 2) 1i32 2i32)
		(array.new (array i32 2) 3i32 42i32)))
	(let matrix (array.repeat (array (array u8 1) 3)
		(array.new (array u8 1) 12u8)))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let repeated (array.load (array.load (local matrix) 2i32) 0i32))
			(if (u8.not-eq (local repeated) 12u8) (then (return 1i32)))
			(return (array.load (array.load (local table) 1i32) 1i32)))))
