(module module_tables
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./model.wove" (only (type (as Row Cell))))
	(let words (array:new (array u32 2) 4294967295u32 17u32))
	(let entries
		(array:new (array Cell 2)
			(struct:new Cell (code 4294967295u32) (amount -2147483648i32)
				(flags (array:new (array bool 2) (bool false) (bool true))))
			(struct:new Cell (flags (array:repeat (array bool 2) (bool true)))
				(amount 42i32) (code 2147483648u32))))
	(let empty (array:new (array Cell 0)))
	(let repeated
		(array:repeat (array Cell 3)
			(struct:new Cell (amount 17i32) (flags (array:repeat (array bool 2) (bool false))) (code 0u32))))
	(let unused (array:new (array u8 1) 255u8)))
