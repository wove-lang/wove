(module module_table_record
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./model.wove" (only (type Row) (type Other)))
	(let cells (array.new (array Row 1)
		(struct.new Other (amount 0i32) (flags (array.repeat (array bool 2) (bool false))) (code 0u32))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body (return 42i32))))
