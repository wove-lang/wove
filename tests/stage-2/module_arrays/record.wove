	(use wove-file "./model.wove" (only (type Row) (type Other)))
	(let cells (array.new (array Row 1)
		(struct.new Other (amount 0i32) (flags (array.repeat (array bool 2) (bool false))) (code 0u32))))
	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body (return 42i32))))
