(module read_module_tables
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tables.wove" (only (value words) (value (as entries cells)) (value empty) (value repeated)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:230"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let first (array.load cells 0i32))
			(let second (array.load cells 1i32))
			(if (bool.not (u32.eq (array.load words 0i32) 4294967295u32)) (then (return 1i32)))
			(if (bool.not (i32.eq (array.len cells) 2i32)) (then (return 2i32)))
			(if (bool.not (i32.eq (array.len empty) 0i32)) (then (return 3i32)))
			(if (bool.not (i32.eq (struct.get first amount) -2147483648i32)) (then (return 4i32)))
			(if (bool.not (u32.eq (struct.get second code) 2147483648u32)) (then (return 5i32)))
			(if (bool.not (array.load (struct.get second flags) 1i32)) (then (return 6i32)))
			(if (array.load (struct.get first flags) 0i32) (then (return 7i32)))
			(if (bool.not (i32.eq (struct.get (array.load repeated 2i32) amount) 17i32)) (then (return 8i32)))
			(return (struct.get second amount)))))
