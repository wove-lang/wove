(module owning_enum_fixed_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Input (variants (Ready Grid) (Invalid)))
	(struct Grid (fields (cells (owned-array u8))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let fixed (array.repeat Input 1i32 (enum.new Input Invalid)))
			(return (array.len fixed)))))
