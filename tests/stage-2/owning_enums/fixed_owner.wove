(module owning_enum_fixed_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Input (variants (Ready Grid) (Invalid)))
	(struct Grid (fields (cells (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let fixed (array.repeat Input 1i32 (enum.new Input Invalid)))
			(return (array.len (local fixed))))))
