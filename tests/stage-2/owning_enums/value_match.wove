(module owning_enum_value_match
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Input (variants (Ready Grid) (Invalid)))
	(struct Grid (fields (cells (owned-array u8))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let result (match (enum.new Input Invalid)
				(case Invalid 0i32)
				(case Ready (let _) 1i32)))
			(return result))))
