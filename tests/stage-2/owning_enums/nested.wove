(module nested_owning_enums
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Outer (variants (Present Inner) (Empty)))
	(enum Inner (variants (Bytes (owned-array u8)) (Invalid)))

	(fn make
		(params)
		(returns Outer)
		(body
			(let bytes (array.alloc u8 42i32))
			(let inner (enum.new Inner Bytes (move bytes)))
			(let outer (enum.new Outer Present (move inner)))
			(return (move outer))))

	(fn extract
		(params)
		(returns (owned-array u8))
		(body
			(match (call make)
				(case Present (let inner)
					(match (move inner)
						(case Bytes (let bytes) (return (move bytes)))
						(case Invalid (return (array.alloc u8 42i32)))))
				(case Empty (return (array.alloc u8 42i32))))))

	(fn release
		(params)
		(returns void)
		(body (let value (call make))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(call release)
			(let bytes (call extract))
			(return (array.len bytes)))))
