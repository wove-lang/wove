(module nested_owning_enums
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Outer (variants (Present Inner) (Empty)))
	(enum Inner (variants (Bytes (owned-array u8)) (Invalid)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn make
		(params)
		(returns Outer)
		(body
			(let bytes (array.alloc u8 42i32))
			(let inner (enum.new Inner Bytes (move (local bytes))))
			(let outer (enum.new Outer Present (move (local inner))))
			(return (move (local outer)))))

	(fn extract
		(params)
		(returns (owned-array u8))
		(body
			(match (call make)
				(case Present (bind inner)
					(match (move (local inner))
						(case Bytes (bind bytes) (return (move (local bytes))))
						(case Invalid (return (array.alloc u8 42i32)))))
				(case Empty (return (array.alloc u8 42i32))))))

	(fn release
		(params)
		(returns void)
		(body (let value (call make))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(call release)
			(let bytes (call extract))
			(return (array.len (local bytes))))))
