(module owning_enum_unwrap_reuse
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./tracked.h" (only acquire_path))
	(enum Result (variants (Ready (owned-array u8)) (Missing)))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let path (call acquire_path 2i32))
			(let result (enum:new Result Ready (move (optional:unwrap path))))
			(if (owner:is-null path) (then (return 1i32)))
			(return 0i32))))
