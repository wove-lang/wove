(module owning_enum_unwrap_reuse
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./tracked.h" (only acquire_path))
	(enum Result (variants (Ready (owned-array u8)) (Missing)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let path (call acquire_path 2i32))
			(let result (enum.new Result Ready (move (optional.unwrap (local path)))))
			(if (owner.is-null (local path)) (then (return 1i32)))
			(return 0i32))))
