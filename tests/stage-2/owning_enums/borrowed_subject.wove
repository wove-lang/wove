(module owning_enum_borrowed_subject
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Input (variants (Ready Grid) (Invalid)))
	(struct Grid (fields (cells (owned-array u8))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let input (enum:new Input Ready (struct:new Grid (cells (array:alloc u8 1i32)))))
			(match input
				(case Ready (let grid) (return 0i32))
				(case Invalid (return 1i32))))))
