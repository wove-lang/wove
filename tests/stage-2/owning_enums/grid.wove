(module owning_enum_grid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Input (variants (Ready Grid) (Invalid) (Count i32)))
	(struct Grid (fields (cells (owned-array u8)) (width i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn read
		(params (ready bool))
		(returns Input)
		(body
			(if (bool.not (local ready)) (then (return (enum.new Input Invalid))))
			(let bytes (array.alloc u8 42i32))
			(let grid (struct.new Grid (cells (move (local bytes))) (width 42i32)))
			(return (enum.new Input Ready (move (local grid))))))

	(fn size
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (array.len (local bytes)))))

	(fn bound
		(params (early bool))
		(returns i32)
		(body
			(let-mut result 0i32)
			(match (call read (bool true))
				(case Ready (bind grid)
					(let width (call size (borrow-shared (struct.get (local grid) cells))))
					(if (local early) (then (return (local width))))
					(let transferred (move (local grid)))
					(set (local result) (struct.get (local transferred) width)))
				(case Invalid (return 1i32))
				(case Count (bind _) (return 2i32)))
			(return (local result))))

	(fn discard
		(params (wildcard bool))
		(returns i32)
		(body
			(let input (call read (bool true)))
			(if (local wildcard)
				(then
					(match (move (local input))
						(case Invalid (return 3i32))
						(case _ (return 42i32)))))
			(match (move (local input))
				(case Ready (bind _))
				(case _ (return 4i32)))
			(return 42i32)))

	(fn inactive
		(params (count bool))
		(returns i32)
		(body
			(let input (if (local count)
				(then (enum.new Input Count 42i32))
				(else (call read (bool false)))))
			(match (move (local input))
				(case Ready (bind _) (return 5i32))
				(case _ (return 42i32)))))

	(fn untouched
		(params)
		(returns i32)
		(body
			(let input (call read (bool true)))
			(return 42i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(if (bool.not (i32.eq (call bound (bool true)) 42i32)) (then (return 6i32)))
			(if (bool.not (i32.eq (call bound (bool false)) 42i32)) (then (return 7i32)))
			(if (bool.not (i32.eq (call discard (bool true)) 42i32)) (then (return 8i32)))
			(if (bool.not (i32.eq (call discard (bool false)) 42i32)) (then (return 9i32)))
			(if (bool.not (i32.eq (call inactive (bool true)) 42i32)) (then (return 10i32)))
			(if (bool.not (i32.eq (call inactive (bool false)) 42i32)) (then (return 11i32)))
			(return (call untouched)))))
