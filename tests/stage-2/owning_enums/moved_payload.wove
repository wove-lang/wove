(module owning_enum_moved_payload
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Input (variants (Ready Grid) (Invalid)))
	(struct Grid (fields (cells (owned-array u8))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(let input (enum.new Input Ready (move (local grid))))
			(let again (move (local grid)))
			(return 0i32))))
