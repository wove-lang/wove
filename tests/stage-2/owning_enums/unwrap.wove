(module owning_enum_unwrap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./tracked.h" (only acquire_path releases))
	(enum Result (variants (Ready (owned-array u8)) (Missing)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn read
		(params (mode i32))
		(returns Result)
		(body
			(let path (call acquire_path (local mode)))
			(return (enum.new Result Ready (move (optional.unwrap (local path)))))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(match (call read 2i32)
				(case Ready (bind path)
					(if (bool.and (i32.eq (call releases) 1i32)
						(i32.eq (array.len (local path)) 2i32))
						(then (return 42i32)))
					(return 1i32))
				(case Missing (return 2i32))))))
