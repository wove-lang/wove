(module owning_enum_unwrap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./tracked.h" (only acquire_path releases))
	(enum Result (variants (Ready (owned-array u8)) (Missing)))

	(fn read
		(params (mode i32))
		(returns Result)
		(body
			(let path (call acquire_path mode))
			(return (Result:Ready (move (optional:unwrap path))))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(match (call read 2i32)
				(case Ready (let path)
					(if (bool:and (i32:eq (call releases) 1i32)
						(i32:eq (array:len path) 2i32))
						(then (return 42i32)))
					(return 1i32))
				(case Missing (return 2i32))))))
