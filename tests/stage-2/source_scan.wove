(module source_scan_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Load the Stage 2 source and compiler APIs exercised by the C probe.

	The probe supplies its own C entry. Its generated symbol mappings depend on
	the order of the imports below.`)

	(use wove-file "../../stage-2/source/scan.wove" (only))
	(use wove-file "../../stage-2/source/strings.wove" (only))
	(use wove-file "../../stage-2/source/module.wove" (only))
	(use wove-file "../../stage-2/emit/c.wove" (only))
	(use wove-file "../../stage-2/source/graph.wove" (only))
	(use wove-file "../../stage-2/source/callers.wove" (only))
	(use wove-file "../../stage-2/emit/graph.wove" (only))
	(use wove-file "../../stage-2/scalar/tests.wove" (only))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc `Supply the parameterless fixture entry required by the seed.`)
		(:expect (tests "stage-2/source_scan.probe.c") (issues "gh:wove-lang/wove:182"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (i32 0)))))
