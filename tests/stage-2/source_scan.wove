(module source_scan_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Load the Stage 2 source and compiler APIs exercised by the C probe.

	The probe supplies its own C entry and calls this module's entry for the
	decimal emission fixture. Its generated symbol mappings depend on the
	order of the imports below.`)

	(use wove-file "../../stage-2/source/scan.wove" (only))
	(use wove-file "../../stage-2/source/strings.wove" (only))
	(use wove-file "../../stage-2/source/module.wove" (only))
	(use wove-file "../../stage-2/emit/c.wove" (only))
	(use wove-file "../../stage-2/source/graph.wove" (only))
	(use wove-file "../../stage-2/source/callers.wove" (only))
	(use wove-file "../../stage-2/source/expectations.wove" (only))
	(use wove-file "../../stage-2/emit/graph.wove" (only))
	(use wove-file "../../stage-2/scalar/tests.wove" (only))

	(use wove-file "../../stage-2/emit/runtime.wove" (only write_c_number write_runtime_site))
	(use wove-file "../../stage-2/text/bytes.wove" (only same_bytes))

	(let expected_number "-2147483648")
	(let expected_site ",-1,0,2147483647")

	(fn check_decimal_emission
		(:doc "Check count-only and writing cursors, signed decimal bytes, and saturation.")
		(:expect (issues "gh:wove-lang/wove:434"))
		(params)
		(returns i32)
		(body
			(let-mut output (array.alloc u8 32i32))
			(array.store output 0i32 33u8)
			(array.store output 31i32 63u8)
			(let number_end (call write_c_number (borrow-mut output) 1u32 -2147483648i32 (bool false)))
			(let site_end (call write_runtime_site (borrow-mut output) number_end
				-1i32 0i32 2147483647i32 (bool false)))
			(if (bool.not (bool.and (u32.eq number_end 12u32) (u32.eq site_end 28u32)))
				(then (return 1i32)))
			(if (bool.not (u32.eq (call write_c_number (borrow-mut output) 2147483636u32
				-2147483648i32 (bool false)) 2147483647u32)) (then (return 2i32)))
			(if (bool.not (u32.eq (call write_c_number (borrow-mut output) 2147483638u32
				-2147483648i32 (bool false)) 2147483648u32)) (then (return 3i32)))
			(if (bool.not (u32.eq (call write_runtime_site (borrow-mut output) 2147483647u32
				-1i32 0i32 2147483647i32 (bool false)) 2147483648u32)) (then (return 4i32)))
			(if (bool.not (u32.eq (call write_runtime_site (borrow-mut output) 2147483648u32
				-1i32 0i32 2147483647i32 (bool true)) 2147483648u32)) (then (return 5i32)))
			(let-mut index 1i32)
			(while (i32.lt index 31i32)
				(body
					(if (bool.not (u8.eq (array.load output index) 0u8)) (then (return 6i32)))
					(set index (i32.add index 1i32))))
			(let written_number (call write_c_number (borrow-mut output) 1u32 -2147483648i32 (bool true)))
			(let written_site (call write_runtime_site (borrow-mut output) written_number
				-1i32 0i32 2147483647i32 (bool true)))
			(if (bool.not (bool.and (u32.eq number_end written_number)
				(u32.eq site_end written_site))) (then (return 7i32)))
			(if (bool.not (call same_bytes (borrow-shared output) 1i32 12i32
				(borrow-shared expected_number) 0i32 11i32)) (then (return 8i32)))
			(if (bool.not (call same_bytes (borrow-shared output) 12i32 28i32
				(borrow-shared expected_site) 0i32 16i32)) (then (return 9i32)))
			(if (bool.not (bool.and (u8.eq (array.load output 0i32) 33u8)
				(bool.and (u8.eq (array.load output 28i32) 0u8)
					(u8.eq (array.load output 31i32) 63u8)))) (then (return 10i32)))
			(return 0i32)))

	(fn main
		(:doc `Run the seed-built decimal emission checks.`)
		(:expect (tests "stage-2/source_scan.probe.c") (issues "gh:wove-lang/wove:182"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return (call check_decimal_emission)))))
