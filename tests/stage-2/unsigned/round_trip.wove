(module unsigned_scalars
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32 42))))
	(fn byte_max (params) (returns u8)
		(body (return (call exchange_byte (u8 000255)))))
	(fn word_high (params) (returns u32)
		(body (return (call exchange_word (u32 2147483648)))))
	(fn word_max (params) (returns u32)
		(body
			(let maximum (u32 4294967295))
			(return (call exchange_word maximum))))
	(fn exchange_byte (params (replacement u8)) (returns u8)
		(body
			(let initial (u8 0))
			(let-mut slot initial)
			(set slot (call byte_identity replacement))
			(return (call byte_identity slot))))
	(fn exchange_word (params (replacement u32)) (returns u32)
		(body
			(let copy replacement)
			(let-mut slot (call word_identity (u32 0)))
			(set slot copy)
			(return (call word_identity slot))))
	(fn byte_identity (params (value u8)) (returns u8)
		(body (return value)))
	(fn word_identity (params (value u32)) (returns u32)
		(body (return value))))
