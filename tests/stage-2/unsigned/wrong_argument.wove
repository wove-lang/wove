(module unsigned_bad
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (i32 0))))
	(fn read (params) (returns u8)
		(body
			(let word (u32 42))
			(return (call identity
				(local word)))))
	(fn identity (params (value u8)) (returns u8)
		(body (return (local value)))))
