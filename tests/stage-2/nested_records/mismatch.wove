(module nested_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Work (fields (lane Lane)))
	(struct Lane (fields (word u64)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut work (record.make Work (lane (record.make Lane (word (u64 0))))))
			(set (record.get (record.get (local work) lane) word) (u32 1))
			(return (i32 0)))))
