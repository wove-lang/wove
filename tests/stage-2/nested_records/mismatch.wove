(module nested_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Work (fields (lane Lane)))
	(struct Lane (fields (word u64)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut work (struct.new Work (lane (struct.new Lane (word (u64 0))))))
			(set (struct.get (struct.get (local work) lane) word) (u32 1))
			(return (i32 0)))))
