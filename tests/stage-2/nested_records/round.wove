(module nested_round
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./work.wove" (only (type (as Work State)) initial_work evolve))

	(struct Envelope (fields (contents Contents) (checksum u32)))
	(struct Contents (fields (state State)))

	(fn replace_state
		(params (before Envelope) (updated State))
		(returns Envelope)
		(body
			(return (record.make Envelope (checksum (record.get (local before) checksum))
				(contents (record.make Contents (state (local updated))))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let original (record.make Envelope
				(contents (record.make Contents (state (call initial_work)))) (checksum (u32 83))))
			(let-mut active (call replace_state (local original)
				(call evolve (record.get (record.get (local original) contents) state))))
			(let copied (local active))
			(set (record.get (record.get (record.get (record.get (local active) contents) state) c0) a)
				(u64 18446744073709551615))
			(set (record.get (record.get (record.get (local active) contents) state) c2)
				(record.get (record.get (record.get (local copied) contents) state) c3))
			(let active_state (record.get (record.get (local active) contents) state))
			(let copied_state (record.get (record.get (local copied) contents) state))
			(if (bool.not (bool.and (u64.eq (record.get (record.get (local active_state) c0) a) (u64 18446744073709551615))
					(u64.eq (record.get (record.get (local copied_state) c0) a) (u64 4652803580490146347))))
				(then (return (i32 1))))
			(if (bool.not (bool.and (u64.eq (record.get (record.get (local active_state) c2) b) (u64 22))
					(u64.eq (record.get (record.get (local copied_state) c2) b) (u64 12))))
				(then (return (i32 2))))
			(if (bool.not (bool.and (u64.eq (record.get (record.get (local active_state) c1) d) (u64 4))
					(u32.eq (record.get (local active) checksum) (u32 83))))
				(then (return (i32 3))))
			(set (local active) (local original))
			(if (bool.not (u64.eq (record.get (record.get
					(record.get (record.get (local active) contents) state) c0) a) (u64 7640891576956012808)))
				(then (return (i32 4))))
			(return (i32 42)))))
