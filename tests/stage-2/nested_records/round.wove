(module nested_round
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./work.wove" (only (type (as Work State)) initial_work evolve))

	(struct Envelope (fields (contents Contents) (checksum u32)))
	(struct Contents (fields (state State)))

	(fn replace_state
		(params (before Envelope) (updated State))
		(returns Envelope)
		(body
			(return (struct:new Envelope (checksum (struct:get before checksum))
				(contents (struct:new Contents (state updated)))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let original (struct:new Envelope
				(contents (struct:new Contents (state (call initial_work)))) (checksum (u32 83))))
			(let-mut active (call replace_state original
				(call evolve (struct:get (struct:get original contents) state))))
			(let copied active)
			(set (struct:get (struct:get (struct:get (struct:get active contents) state) c0) a)
				(u64 18446744073709551615))
			(set (struct:get (struct:get (struct:get active contents) state) c2)
				(struct:get (struct:get (struct:get copied contents) state) c3))
			(let active_state (struct:get (struct:get active contents) state))
			(let copied_state (struct:get (struct:get copied contents) state))
			(if (bool:not (bool:and (u64:eq (struct:get (struct:get active_state c0) a) (u64 18446744073709551615))
					(u64:eq (struct:get (struct:get copied_state c0) a) (u64 4652803580490146347))))
				(then (return (i32 1))))
			(if (bool:not (bool:and (u64:eq (struct:get (struct:get active_state c2) b) (u64 22))
					(u64:eq (struct:get (struct:get copied_state c2) b) (u64 12))))
				(then (return (i32 2))))
			(if (bool:not (bool:and (u64:eq (struct:get (struct:get active_state c1) d) (u64 4))
					(u32:eq (struct:get active checksum) (u32 83))))
				(then (return (i32 3))))
			(set active original)
			(if (bool:not (u64:eq (struct:get (struct:get
					(struct:get (struct:get active contents) state) c0) a) (u64 7640891576956012808)))
				(then (return (i32 4))))
			(return (i32 42)))))
