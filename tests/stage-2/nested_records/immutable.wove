(module nested_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Work (fields (lane Lane)))
	(struct Lane (fields (word u64)))

	(fn main
		(params)
		(returns i32)
		(body
			(let work (record.make Work (lane (record.make Lane (word (u64 0))))))
			(set (record.get (record.get (local work) lane) word) (u64 1))
			(return (i32 0)))))
