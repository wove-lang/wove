(module nested_work
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../u64/mix.wove" (only (type (as Lane WordLane)) mix))

	(struct Work (fields (c0 WordLane) (c1 WordLane) (c2 WordLane) (c3 WordLane)))

	(fn lane
		(params (word u64))
		(returns WordLane)
		(body
			(return (struct.new WordLane (a word) (b (u64.add word (u64 1)))
				(c (u64.add word (u64 2))) (d (u64.add word (u64 3)))))))

	(fn initial_work
		(params)
		(returns Work)
		(body
			(return (struct.new Work
				(c0 (struct.new WordLane
					(a (u64 7640891576956012808)) (b (u64 13503953896175478587))
					(c (u64 4354685564936845355)) (d (u64 11912009170470909681))))
				(c1 (call lane (u64 1))) (c2 (call lane (u64 11))) (c3 (call lane (u64 21)))))))

	(fn evolve
		(params (input Work))
		(returns Work)
		(body
			(let-mut output input)
			(set (struct.get output c0)
				(call mix (struct.get input c0) (u64 18446744073709551615) (u64 81985529216486895)))
			(return output))))
