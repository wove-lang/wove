(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	local_calls

	(fn read-flag
		(params (value bool))
		(returns bool)
		(body (return (local value))))
	(fn read-count (params (value u32)) (returns u32) (body (return (local value))))
	(fn pick.a (params (low i32) (high i32)) (returns i32) (body (return (local high))))
	(fn pick-a (params)
		(returns i32)
		(body (return (i32 7))))
	(fn read-byte (params (value u8)) (returns u8) (body (return (local value))))

	(fn main
		(params)
		(returns i32)
		(body
			(return
				(call choose
					(call pick-a)
					(call pick.a (i32 3) (i32 42))
					(call read-byte (u8 255))
					(call read-count (u32 4294967295))
					(call read-flag (bool true))))))
	(fn choose
		(params (other-value i32) (other.value i32) (byte u8) (count u32) (flag bool))
		(returns i32)
		(body (return (local other.value)))))
