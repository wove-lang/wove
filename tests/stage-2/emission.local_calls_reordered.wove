(module local_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_flag
		(params (value bool))
		(returns bool)
		(body (return (local value))))
	(fn read_count (params (value u32)) (returns u32) (body (return (local value))))
	(fn pick_a (params (low i32) (high i32)) (returns i32) (body (return (local high))))
	(fn pick_b (params)
		(returns i32)
		(body (return (i32 7))))
	(fn read_byte (params (value u8)) (returns u8) (body (return (local value))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(return
				(call choose
					(call pick_b)
					(call pick_a (i32 3) (i32 42))
					(call read_byte (u8 255))
					(call read_count (u32 4294967295))
					(call read_flag (bool true))))))
	(fn choose
		(params (other_value i32) (other_total i32) (byte u8) (count u32) (flag bool))
		(returns i32)
		(body (return (local other_total)))))
