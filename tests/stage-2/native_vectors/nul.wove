(module native_vector_nul
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./vectors.h" (only test_vectors))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 1i32))
			(let-mut row (array.alloc u8 3i32))
			(slice.store (local row) 0i32 65u8)
			(slice.store (local row) 2i32 66u8)
			(slice.store (local rows) 0i32 (move (local row)))
			(let empty (array.alloc (owned-array u8) 0i32))
			(return (call test_vectors (borrow-shared (local rows)) (borrow-shared (local empty)))))))
