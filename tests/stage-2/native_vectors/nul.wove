(module native_vector_nul
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./vectors.h" (only test_vectors))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 1i32))
			(let-mut row (array.alloc u8 3i32))
			(array.store (local row) 0i32 65u8)
			(array.store (local row) 2i32 66u8)
			(array.store (local rows) 0i32 (move (local row)))
			(let empty (array.alloc (owned-array u8) 0i32))
			(return (call test_vectors (borrow-shared (local rows)) (borrow-shared (local empty)))))))
