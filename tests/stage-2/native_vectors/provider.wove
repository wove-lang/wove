(module native_vector_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./vectors.h"
		(fn test_vectors
			(:pragma (c_cstrs rows empty))
			(params (rows (shared-array (owned-array u8))) (empty (shared-array (owned-array u8))))
			(returns i32))
		(let test_vector_global
			(:pragma (c_snapshot cstrs))
			(owned-array (owned-array u8)))
		(fn test_null_vector
			(params)
			(returns i32))
		(fn test_vector_result
			(:pragma (c_cstrs rows) (c_cstr text) (c_snapshot cstr))
			(params (rows (shared-array (owned-array u8))) (text (mut-array u8)))
			(returns (optional (owned-array u8))))
		(fn test_vector_errno
			(params)
			(returns i32))))
