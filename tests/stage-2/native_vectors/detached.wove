(module detached_native_vectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./vectors.h" (only test_vectors test_vector_errno test_vector_result))
	(use wove-file "./rows.wove" (only copy_row first_byte))

	(let first "first row")
	(let empty_row "")
	(let last "last")

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 3i32))
			(array.store rows 0i32 (call copy_row (borrow-shared first)))
			(array.store rows 1i32 (call copy_row (borrow-shared empty_row)))
			(array.store rows 2i32 (call copy_row (borrow-shared last)))
			(let empty (array.alloc (owned-array u8) 0i32))
			(let result (call test_vectors (borrow-shared rows) (borrow-shared empty)))
			(if (bool.not (i32.eq (call test_vector_errno) 0i32)) (then (return 4i32)))
			(if (bool.not (i32.eq (call first_byte (borrow-shared (array.load rows 0i32))) 102i32))
				(then (return 5i32)))
			(if (bool.not (i32.eq result 42i32)) (then (return 6i32)))
			(let-mut text (array.alloc u8 1i32))
			(array.store text 0i32 65u8)
			(let snapshot (call test_vector_result (borrow-shared rows) (borrow-mut text)))
			(let copied (move (optional.unwrap snapshot)))
			(if (bool.not (i32.eq (call first_byte (borrow-shared copied)) 102i32))
				(then (return 7i32)))
			(if (bool.not (i32.eq (call first_byte (borrow-shared text)) 90i32)) (then (return 8i32)))
			(return 42i32))))
