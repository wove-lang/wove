(module native_vector_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn copy_row
		(params (bytes (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let len (array.len (local bytes)))
			(let-mut row (array.alloc u8 (local len)))
			(let-mut index 0i32)
			(while (i32.lt (local index) (local len))
				(body
					(array.store (local row) (local index) (array.load (local bytes) (local index)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (move (local row)))))

	(fn first_byte
		(params (row (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local row) 0i32)))))
)
