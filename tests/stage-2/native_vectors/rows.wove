(module native_vector_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn copy_row
		(params (bytes (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let len (array:len bytes))
			(let-mut row (array:alloc u8 len))
			(let-mut index 0i32)
			(while (i32:lt index len)
				(body
					(array:store row index (array:load bytes index))
					(set index (i32:add index 1i32))))
			(return (move row))))

	(fn first_byte
		(params (row (shared-array u8)))
		(returns i32)
		(body (return (int:convert i32 (array:load row 0i32)))))
)
