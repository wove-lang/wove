(module spawn_native_vectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<spawn.h>" (only (type Pid) (type Actions) (type Attributes)
		posix_spawn_file_actions_init posix_spawnattr_init posix_spawnp))
	(use c-header "<sys/wait.h>" (only (type (as Pid WaitPid)) waitpid))
	(use wove-file "./rows.wove" (only copy_row))

	(let shell "/bin/sh")
	(let sh "sh")
	(let command "-c")
	(let program `test "$0" = wove-child && test "$#" = 3 && test "$1" = distinct && test "$2" = "two words" && test -z "$3" && test "$WOVE_VECTOR_MARKER" = "env value"`)
	(let child_name "wove-child")
	(let plain "distinct")
	(let spaced "two words")
	(let blank "")
	(let marker "WOVE_VECTOR_MARKER=env value")

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut arguments (array.alloc (owned-array u8) 7i32))
			(array.store (local arguments) 0i32 (call copy_row (borrow-shared (local sh))))
			(array.store (local arguments) 1i32 (call copy_row (borrow-shared (local command))))
			(array.store (local arguments) 2i32 (call copy_row (borrow-shared (local program))))
			(array.store (local arguments) 3i32 (call copy_row (borrow-shared (local child_name))))
			(array.store (local arguments) 4i32 (call copy_row (borrow-shared (local plain))))
			(array.store (local arguments) 5i32 (call copy_row (borrow-shared (local spaced))))
			(array.store (local arguments) 6i32 (call copy_row (borrow-shared (local blank))))
			(let-mut environment (array.alloc (owned-array u8) 1i32))
			(array.store (local environment) 0i32 (call copy_row (borrow-shared (local marker))))
			(let-mut actions (native.alloc Actions))
			(let-mut attributes (native.alloc Attributes))
			(if (bool.not (i32.eq (call posix_spawn_file_actions_init (borrow-mut (local actions))) 0i32))
				(then (return 1i32)))
			(if (bool.not (i32.eq (call posix_spawnattr_init (borrow-mut (local attributes))) 0i32))
				(then (return 2i32)))
			(let-mut pid (int.convert Pid 0i32))
			(let spawned (call posix_spawnp (borrow-mut (local pid)) (borrow-shared (local shell))
				(borrow-shared (local actions)) (borrow-shared (local attributes))
				(borrow-shared (local arguments)) (borrow-shared (local environment))))
			(if (bool.not (i32.eq (local spawned) 0i32)) (then (return 3i32)))
			(let-mut status -1i32)
			(let reaped (call waitpid (int.convert WaitPid (local pid)) (borrow-mut (local status)) 0i32))
			(if (bool.not (i32.eq (int.convert i32 (local reaped)) (int.convert i32 (local pid)))) (then (return 4i32)))
			(if (bool.not (i32.eq (local status) 0i32)) (then (return 5i32)))
			(return 42i32))))
