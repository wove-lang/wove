(module spawn_native_vectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<spawn.h>" (only (type Pid) (type Actions) (type Attributes)
		posix_spawn_file_actions_init posix_spawnattr_init posix_spawnp))
	(use c-header "<sys/wait.h>" (only (type (as Pid WaitPid)) waitpid))
	(use wove-file "./rows.wove" (only copy_row))

	(let shell "/bin/sh")
	(let sh "sh")
	(let command "-c")
	(let program `test "$0" = wove-child && test "$#" = 3 && test "$1" = distinct && test "$2" = "two words" && test -z "$3" && test "$WOVE_VECTOR_MARKER" = "env value"`)
	(let child_name "wove-child")
	(let plain "distinct")
	(let spaced "two words")
	(let blank "")
	(let marker "WOVE_VECTOR_MARKER=env value")

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut arguments (array:alloc (owned-array u8) 7i32))
			(array:set arguments 0i32 (call copy_row (borrow-shared sh)))
			(array:set arguments 1i32 (call copy_row (borrow-shared command)))
			(array:set arguments 2i32 (call copy_row (borrow-shared program)))
			(array:set arguments 3i32 (call copy_row (borrow-shared child_name)))
			(array:set arguments 4i32 (call copy_row (borrow-shared plain)))
			(array:set arguments 5i32 (call copy_row (borrow-shared spaced)))
			(array:set arguments 6i32 (call copy_row (borrow-shared blank)))
			(let-mut environment (array:alloc (owned-array u8) 1i32))
			(array:set environment 0i32 (call copy_row (borrow-shared marker)))
			(let-mut actions (native:alloc Actions))
			(let-mut attributes (native:alloc Attributes))
			(if (bool:not (i32:eq (call posix_spawn_file_actions_init (borrow-mut actions)) 0i32))
				(then (return 1i32)))
			(if (bool:not (i32:eq (call posix_spawnattr_init (borrow-mut attributes)) 0i32))
				(then (return 2i32)))
			(let-mut pid (int:convert Pid 0i32))
			(let spawned (call posix_spawnp (borrow-mut pid) (borrow-shared shell)
				(borrow-shared actions) (borrow-shared attributes)
				(borrow-shared arguments) (borrow-shared environment)))
			(if (bool:not (i32:eq spawned 0i32)) (then (return 3i32)))
			(let-mut status -1i32)
			(let reaped (call waitpid (int:convert WaitPid pid) (borrow-mut status) 0i32))
			(if (bool:not (i32:eq (int:convert i32 reaped) (int:convert i32 pid))) (then (return 4i32)))
			(if (bool:not (i32:eq status 0i32)) (then (return 5i32)))
			(return 42i32))))
