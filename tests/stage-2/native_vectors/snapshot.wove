(module snapshot_native_environment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only setenv unsetenv))
	(use c-header "<unistd.h>" (only environ))
	(use wove-file "./rows.wove" (only copy_row))

	(let marker "WOVE_SNAPSHOT_FIXTURE_302")
	(let old "first value")
	(let changed "second value")
	(let old_row "WOVE_SNAPSHOT_FIXTURE_302=first value")
	(let changed_row "WOVE_SNAPSHOT_FIXTURE_302=second value")

	(fn equal_row
		(params (row (shared-slice u8)) (expected (shared-slice u8)))
		(returns bool)
		(body
			(let len (slice.len (local row)))
			(if (bool.not (i32.eq (local len) (slice.len (local expected))))
				(then (return (bool false))))
			(let-mut index 0i32)
			(while (i32.lt (local index) (local len))
				(body
					(if (bool.not (u8.eq (slice.load (local row) (local index))
						(slice.load (local expected) (local index))))
						(then (return (bool false))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (bool true))))

	(fn find_row
		(params (rows (shared-slice (owned-array u8))) (expected (shared-slice u8)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while (i32.lt (local index) (slice.len (local rows)))
				(body
					(if (call equal_row (borrow-shared (slice.load (local rows) (local index)))
						(borrow-shared (local expected)))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return -1i32)))

	(fn main
		(params)
		(returns i32)
		(body
			(if (bool.not (i32.eq (call setenv (borrow-shared (local marker)) (borrow-shared (local old)) 1i32) 0i32))
				(then (return 1i32)))
			(let-mut first (local environ))
			(let duplicate (local environ))
			(if (bool.not (i32.eq (call setenv (borrow-shared (local marker)) (borrow-shared (local changed)) 1i32) 0i32))
				(then (return 2i32)))
			(let second (local environ))
			(if (bool.not (i32.eq (call unsetenv (borrow-shared (local marker))) 0i32)) (then (return 3i32)))
			(let position (call find_row (borrow-shared (local first)) (borrow-shared (local old_row))))
			(if (i32.lt (local position) 0i32) (then (return 4i32)))
			(slice.store (local first) (local position) (call copy_row (borrow-shared (local changed_row))))
			(if (bool.not (i32.eq (call find_row (borrow-shared (local first)) (borrow-shared (local old_row))) -1i32))
				(then (return 5i32)))
			(if (i32.lt (call find_row (borrow-shared (local duplicate)) (borrow-shared (local old_row))) 0i32)
				(then (return 6i32)))
			(if (i32.lt (call find_row (borrow-shared (local second)) (borrow-shared (local changed_row))) 0i32)
				(then (return 7i32)))
			(let removed (local environ))
			(if (bool.not (i32.eq (call find_row (borrow-shared (local removed)) (borrow-shared (local changed_row))) -1i32))
				(then (return 8i32)))
			(return 42i32))))
