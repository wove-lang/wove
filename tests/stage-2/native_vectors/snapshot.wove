(module snapshot_native_environment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only setenv unsetenv))
	(use c-header "<unistd.h>" (only environ))
	(use wove-file "./rows.wove" (only copy_row))

	(let marker "WOVE_SNAPSHOT_FIXTURE_302")
	(let old "first value")
	(let changed "second value")
	(let old_row "WOVE_SNAPSHOT_FIXTURE_302=first value")
	(let changed_row "WOVE_SNAPSHOT_FIXTURE_302=second value")

	(fn equal_row
		(params (row (shared-array u8)) (expected (shared-array u8)))
		(returns bool)
		(body
			(let len (array:len row))
			(if (bool:not (i32:eq len (array:len expected)))
				(then (return (bool false))))
			(let-mut index 0i32)
			(while (i32:lt index len)
				(body
					(if (bool:not (u8:eq (array:get row index)
						(array:get expected index)))
						(then (return (bool false))))
					(set index (i32:add index 1i32))))
			(return (bool true))))

	(fn find_row
		(params (rows (shared-array (owned-array u8))) (expected (shared-array u8)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while (i32:lt index (array:len rows))
				(body
					(if (call equal_row (borrow-shared (array:get rows index))
						(borrow-shared expected))
						(then (return index)))
					(set index (i32:add index 1i32))))
			(return -1i32)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:not (i32:eq (call setenv (borrow-shared marker) (borrow-shared old) 1i32) 0i32))
				(then (return 1i32)))
			(let-mut first environ)
			(let duplicate environ)
			(if (bool:not (i32:eq (call setenv (borrow-shared marker) (borrow-shared changed) 1i32) 0i32))
				(then (return 2i32)))
			(let second environ)
			(if (bool:not (i32:eq (call unsetenv (borrow-shared marker)) 0i32)) (then (return 3i32)))
			(let position (call find_row (borrow-shared first) (borrow-shared old_row)))
			(if (i32:lt position 0i32) (then (return 4i32)))
			(array:set first position (call copy_row (borrow-shared changed_row)))
			(if (bool:not (i32:eq (call find_row (borrow-shared first) (borrow-shared old_row)) -1i32))
				(then (return 5i32)))
			(if (i32:lt (call find_row (borrow-shared duplicate) (borrow-shared old_row)) 0i32)
				(then (return 6i32)))
			(if (i32:lt (call find_row (borrow-shared second) (borrow-shared changed_row)) 0i32)
				(then (return 7i32)))
			(let removed environ)
			(if (bool:not (i32:eq (call find_row (borrow-shared removed) (borrow-shared changed_row)) -1i32))
				(then (return 8i32)))
			(return 42i32))))
