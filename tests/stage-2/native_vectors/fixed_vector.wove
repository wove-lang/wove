(module fixed_vector
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./rows.wove" (only copy_row first_byte))
	(use c-header "./vectors.h" (only test_fixed_vector))
	(bridge c-header "./vectors.h"
		(fn test_fixed_vector
			(:pragma (c_cstrs rows))
			(params (const left i32 WOVE_TEST_FIXED_LEFT) (rows (shared-slice (owned-array u8))) (const right i32 WOVE_TEST_FIXED_RIGHT))
			(returns i32)))
	(let payload "two words")

	(fn main (params) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 1i32))
			(slice.store (local rows) 0i32 (call copy_row (borrow-shared (local payload))))
			(let code (call test_fixed_vector (borrow-shared (local rows))))
			(if (bool.not (i32.eq (call first_byte (borrow-shared (slice.load (local rows) 0i32))) 116i32))
				(then (return 2i32)))
			(return (local code))))
)
