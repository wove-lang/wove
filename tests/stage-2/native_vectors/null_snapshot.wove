(module native_null_vector
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./vectors.h" (only test_vector_global test_null_vector))
	(use wove-file "./rows.wove" (only first_byte))

	(fn row_len
		(params (row (shared-array u8)))
		(returns i32)
		(body (return (array.len row))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let rows test_vector_global)
			(if (bool.not (i32.eq (call test_null_vector) 0i32)) (then (return 1i32)))
			(let empty test_vector_global)
			(if (bool.not (i32.eq (array.len empty) 0i32)) (then (return 2i32)))
			(if (bool.not (i32.eq (array.len rows) 2i32)) (then (return 3i32)))
			(if (bool.not (i32.eq (call row_len (borrow-shared (array.load rows 1i32))) 0i32))
				(then (return 4i32)))
			(if (bool.not (i32.eq (call first_byte (borrow-shared (array.load rows 0i32))) 98i32))
				(then (return 5i32)))
			(return 42i32))))
