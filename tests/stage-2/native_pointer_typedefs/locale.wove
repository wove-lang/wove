(module native_pointer_typedef_locale
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./locale_fixture.h"
		(type Locale (:pragma (c_owned (drop freelocale))) (c-type "locale_t"))
		(fn create (c-name "newlocale") (:pragma (c_cstr name))
			(params (const mask i32 LC_CTYPE_MASK) (name (shared-array u8)) (const base (c-type "locale_t") null))
			(returns Locale))
		(fn isalpha_l (params (character i32) (locale (shared-ref Locale))) (returns i32)))
	(use c-header "./locale_fixture.h" (only create isalpha_l))

	(let c_locale "C")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let locale (call create (borrow-shared c_locale)))
			(if (owner:is-null locale) (then (return 1i32)))
			(if (i32:eqz (call isalpha_l 65i32 (borrow-shared locale))) (then (return 2i32)))
			(if (i32:not-eq (call isalpha_l 55i32 (borrow-shared locale)) 0i32) (then (return 3i32)))
			(return 42i32))))
