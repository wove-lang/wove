	(bridge c-header "./locale_fixture.h"
		(type Locale (:pragma (c_owned (drop freelocale))) (c-type "locale_t"))
		(fn create (c-name "newlocale") (:pragma (c_cstr name))
			(params (const mask i32 LC_CTYPE_MASK) (name (shared-array u8)) (const base (c-type "WrongLocale") null))
			(returns Locale)))
	(use c-header "./locale_fixture.h" (only create))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
