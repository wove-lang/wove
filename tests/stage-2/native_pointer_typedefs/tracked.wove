(module native_pointer_typedef_tracked
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tracked_fixture.h"
		(type (:pragma (c_owned (drop release))) Resource (c-type "TrackedOwner"))
		(fn acquire (params) (returns Resource))
		(fn drop_count (params) (returns i32)))
	(use c-header "./tracked_fixture.h" (only acquire drop_count (type Resource)))

	(struct Box (fields (handle Resource)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn exercise (params) (returns i32)
		(body
			(let-mut resource (call acquire))
			(set (local resource) (call acquire))
			(if (i32.not-eq (call drop_count) 1i32) (then (return 1i32)))
			(let-mut box (struct.new Box (handle (call acquire))))
			(set (struct.get (local box) handle) (call acquire))
			(if (i32.not-eq (call drop_count) 2i32) (then (return 2i32)))
			(return 42i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let result (call exercise))
			(if (i32.not-eq (local result) 42i32) (then (return (local result))))
			(if (i32.not-eq (call drop_count) 4i32) (then (return 3i32)))
			(return 42i32))))
