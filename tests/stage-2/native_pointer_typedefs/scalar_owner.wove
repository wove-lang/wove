	(bridge c-header "./locale_fixture.h"
		(type BadOwner (:pragma (c_owned (drop drop_scalar))) (c-type "ScalarAlias"))
		(fn make_scalar (params) (returns BadOwner)))
	(use c-header "./locale_fixture.h" (only make_scalar))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
