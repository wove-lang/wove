	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./locale_fixture.h"
		(type (:pragma (c_owned (drop drop_scalar))) BadOwner (c-type "ScalarAlias"))
		(fn make_scalar (params) (returns BadOwner)))
	(use c-header "./locale_fixture.h" (only make_scalar))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 0i32))))
