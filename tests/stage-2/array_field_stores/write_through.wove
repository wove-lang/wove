(module array_field_write_through
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Pending (fields (block (array u8 2))))
	(struct State (fields (pending Pending) (source (array u8 2)) (used i32)))

	(fn byte_at
		(params (bytes (shared-slice u8)) (at i32))
		(returns u8)
		(body (return (slice.load (local bytes) (local at)))))

	(fn fill
		(params (state (mut-ref State)))
		(returns void)
		(body
			(array.store (record.get (record.get (local state) pending) block)
				(record.get (local state) used) (u8 42))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut state (record.make State
				(pending (record.make Pending (block (array.repeat (array u8 2) (u8 0)))))
				(source (array.make (array u8 2) (u8 17) (u8 31)))
				(used (i32 1))))
			(array.store (record.get (record.get (local state) pending) block) (i32 0)
				(call byte_at (borrow-shared (record.get (local state) source)) (i32 1)))
			(if (bool.not (u8.eq (array.load (record.get (record.get (local state) pending) block) (i32 0)) (u8 31)))
				(then (return (i32 1))))
			(call fill (borrow-mut (local state)))
			(if (bool.not (u8.eq (array.load (record.get (record.get (local state) pending) block) (i32 0)) (u8 31)))
				(then (return (i32 2))))
			(if (bool.not (u8.eq (array.load (record.get (record.get (local state) pending) block) (i32 1)) (u8 42)))
				(then (return (i32 3))))
			(if (bool.not (u8.eq (array.load (record.get (local state) source) (i32 1)) (u8 31)))
				(then (return (i32 4))))
			(if (bool.not (i32.eq (record.get (local state) used) (i32 1)))
				(then (return (i32 5))))
			(return (i32 42)))))
