(module array_field_write_through
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Pending (fields (block (array u8 2))))
	(struct State (fields (pending Pending) (source (array u8 2)) (used i32)))

	(fn byte_at
		(params (bytes (shared-array u8)) (at i32))
		(returns u8)
		(body (return (array.load bytes at))))

	(fn fill
		(params (state (mut-ref State)))
		(returns void)
		(body
			(array.store (struct.get (struct.get state pending) block)
				(struct.get state used) (u8 42))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (struct.new State
				(pending (struct.new Pending (block (array.repeat (array u8 2) (u8 0)))))
				(source (array.new (array u8 2) (u8 17) (u8 31)))
				(used (i32 1))))
			(array.store (struct.get (struct.get state pending) block) (i32 0)
				(call byte_at (borrow-shared (struct.get state source)) (i32 1)))
			(if (bool.not (u8.eq (array.load (struct.get (struct.get state pending) block) (i32 0)) (u8 31)))
				(then (return (i32 1))))
			(call fill (borrow-mut state))
			(if (bool.not (u8.eq (array.load (struct.get (struct.get state pending) block) (i32 0)) (u8 31)))
				(then (return (i32 2))))
			(if (bool.not (u8.eq (array.load (struct.get (struct.get state pending) block) (i32 1)) (u8 42)))
				(then (return (i32 3))))
			(if (bool.not (u8.eq (array.load (struct.get state source) (i32 1)) (u8 31)))
				(then (return (i32 4))))
			(if (bool.not (i32.eq (struct.get state used) (i32 1)))
				(then (return (i32 5))))
			(return (i32 42)))))
