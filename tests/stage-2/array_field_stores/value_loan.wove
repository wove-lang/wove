(module array_field_value_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 2))))

	(fn first
		(params (bytes (shared-slice u8)))
		(returns u8)
		(body (return (slice.load (local bytes) (i32 0)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut state (record.make State (block (array.repeat (array u8 2) (u8 0)))))
			(array.store (record.get (local state) block) (i32 0)
				(call first (borrow-shared (record.get (local state) block))))
			(return (i32 0)))))
