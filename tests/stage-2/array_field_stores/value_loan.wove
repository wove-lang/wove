(module array_field_value_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 2))))

	(fn first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array.load bytes (i32 0)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (struct.new State (block (array.repeat (array u8 2) (u8 0)))))
			(array.store (struct.get state block) (i32 0)
				(call first (borrow-shared (struct.get state block))))
			(return (i32 0)))))
