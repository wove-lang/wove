(module array_field_immutable_ref
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 2))))

	(fn check
		(params (state (shared-ref State)))
		(returns void)
		(body (array.store (struct.get (local state) block) (i32 0) (u8 42))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 0)))))
