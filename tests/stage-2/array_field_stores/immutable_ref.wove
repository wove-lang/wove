(module array_field_immutable_ref
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 2))))

	(fn check
		(params (state (shared-ref State)))
		(returns void)
		(body (array.store (record.get (local state) block) (i32 0) (u8 42))))

	(fn main (params) (returns i32) (body (return (i32 0)))))
