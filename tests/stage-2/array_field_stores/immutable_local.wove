(module array_field_immutable_local
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 2))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let state (struct.new State (block (array.repeat (array u8 2) (u8 0)))))
			(array.store (struct.get (local state) block) (i32 0) (u8 42))
			(return (i32 0)))))
