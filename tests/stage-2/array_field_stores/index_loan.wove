(module array_field_index_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 2))))

	(fn index_of
		(params (state (shared-ref State)))
		(returns i32)
		(body (return (i32 0))))

	(fn check
		(params (state (mut-ref State)))
		(returns void)
		(body (array.store (record.get (local state) block) (call index_of (borrow-shared (local state))) (u8 42))))

	(fn main (params) (returns i32) (body (return (i32 0)))))
