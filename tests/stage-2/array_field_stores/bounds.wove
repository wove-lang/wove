(module array_field_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 1))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn fill
		(params (state (mut-ref State)) (index i32))
		(returns void)
		(body (array.store (record.get (local state) block) (local index) (u8 42))))

	(fn main
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(let-mut state (record.make State (block (array.make (array u8 1) (u8 0)))))
			(let index (i32.sub.wrapping (slice.len (local argv)) (i32 1)))
			(if (i32.lt (local index) (i32 0))
				(then (array.store (record.get (local state) block) (local index) (u8 42))))
			(call fill (borrow-mut (local state)) (local index))
			(return (int.convert i32 (array.load (record.get (local state) block) (i32 0)))))))
