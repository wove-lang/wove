(module array_field_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (block (array u8 1))))

	(fn fill
		(params (state (mut-ref State)) (index i32))
		(returns void)
		(body (array.store (struct.get state block) index (u8 42))))

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (struct.new State (block (array.new (array u8 1) (u8 0)))))
			(let index (i32.sub (i32.dec (array.len argv)) (i32 1)))
			(if (i32.lt index (i32 0))
				(then (array.store (struct.get state block) index (u8 42))))
			(call fill (borrow-mut state) index)
			(return (int.convert i32 (array.load (struct.get state block) (i32 0)))))))
