(module byte_equality_cases
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/text/equal.wove" (only equal_bytes))

	(fn has_rle_magic
		(params (header (shared-array u8))) (returns bool)
		(body
			(let magic (array:new (array u8 5) 87u8 82u8 76u8 69u8 1u8))
			(return (call equal_bytes (borrow-shared header) (borrow-shared magic)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:380"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let header (array:new (array u8 5) 87u8 82u8 76u8 69u8 1u8))
			(let wrong_version (array:new (array u8 5) 87u8 82u8 76u8 69u8 2u8))
			(if (bool:not (call has_rle_magic (borrow-shared header))) (then (return 1i32)))
			(if (call has_rle_magic (borrow-shared wrong_version)) (then (return 2i32)))

			(let-mut left (array:alloc u8 5i32))
			(let-mut right (array:alloc u8 5i32))
			(array:set left 1i32 17u8)
			(array:set left 2i32 42u8)
			(array:set right 1i32 17u8)
			(array:set right 2i32 42u8)
			(if (bool:not (call equal_bytes (borrow-shared left) (borrow-shared right))) (then (return 3i32)))
			(if (call equal_bytes (borrow-shared left)
				(borrow-shared (array:range right 0i32 4i32)))
				(then (return 4i32)))

			(array:set right 2i32 17u8)
			(if (call equal_bytes (borrow-shared left) (borrow-shared right)) (then (return 5i32)))
			(array:set right 3i32 42u8)
			(if (bool:not (call equal_bytes (borrow-shared (array:range left 1i32 3i32))
				(borrow-shared (array:range right 2i32 4i32))))
				(then (return 6i32)))
			(if (bool:not (call equal_bytes (borrow-shared (array:range left 5i32 5i32))
				(borrow-shared (array:range right 0i32 0i32))))
				(then (return 7i32)))
			(return 42i32)))
)
