(module record_worker_pool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) render describe))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let pool (worker.open-pool 1i32 1i32))
			(let job (struct.new Job (image (struct.new Image (width 1i32) (height 1i32) (limit 3i32))) (tile 39i32)))
			(let render_permit (worker.reserve-wait (local pool)))
			(let rendered (worker.spawn-on render (move (local render_permit)) (local job)))
			(let pixels (worker.join (local rendered)))
			(if (i32.not-eq (struct.get (local job) tile) 39i32) (then (return 1i32)))
			(let describe_permit (worker.reserve-wait (local pool)))
			(let described (worker.spawn-on describe (move (local describe_permit)) (move (local pixels))))
			(if (bool.not (worker.try-close (local pool))) (then (return 2i32)))
			(let image (worker.join (local described)))
			(if (i32.not-eq (struct.get (local image) width) 1i32) (then (return 3i32)))
			(return (struct.get (local image) limit)))))
