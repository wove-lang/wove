(module record_worker_scoped_job
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (text (shared-array u8))))
	(fn read_job (params (cursor (shared-ref Cursor))) (returns (owned-array u8))
		(body (return (array:alloc u8 (array:len (struct:get cursor text))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let bytes (array:get args 0i32))
			(let cursor (struct:new Cursor (text (borrow-shared bytes))))
			(let receipt (worker:spawn read_job (borrow-shared cursor)))
			(return 0i32)))
)
