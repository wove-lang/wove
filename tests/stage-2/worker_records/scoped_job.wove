(module record_worker_scoped_job
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Cursor (fields (text (shared-array u8))))
	(fn read_job (params (cursor (shared-ref Cursor))) (returns (owned-array u8))
		(body (return (array.alloc u8 (array.len (struct.get (local cursor) text))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let cursor (struct.new Cursor (text (borrow-shared (local bytes)))))
			(let receipt (worker.spawn read_job (borrow-shared (local cursor))))
			(return 0i32)))
)
