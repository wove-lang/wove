(module record_worker_queue_pop_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn echo (params (input (owned-array u8))) (returns (owned-array u8))
		(body (return (move input))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let pending (worker.receipt-queue echo))
			(let oldest (worker.pop-front pending))
			(return 0i32))))
