(module record_worker_queue_pop_empty
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn echo (params (input (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local input)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut pending (worker.receipt-queue echo))
			(let oldest (worker.pop-front (local pending)))
			(return 0i32))))
