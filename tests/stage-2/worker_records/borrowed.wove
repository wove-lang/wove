(module record_worker_borrowed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Cursor (fields (text (shared-array u8))))
	(fn cursor (params (input (shared-array u8))) (returns Cursor (from input))
		(body (return (struct.new Cursor (text (borrow-shared (local input)))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let receipt (worker.spawn cursor (borrow-shared (local bytes))))
			(return 0i32)))
)
