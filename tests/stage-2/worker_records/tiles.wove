(module record_worker_tiles
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Image (fields (width i32) (height i32) (limit i32)))
	(struct Job (fields (image Image) (tile i32)))

	(fn render (params (job Job)) (returns (owned-array u8))
		(body
			(let image (struct.get (local job) image))
			(let width (struct.get (local image) width))
			(let height (struct.get (local image) height))
			(let-mut pixels (array.alloc u8 (i32.mul (local width) (local height))))
			(array.store (local pixels) 0i32
				(u8.from-i32 (i32.add (struct.get (local job) tile) (struct.get (local image) limit))))
			(return (move (local pixels)))))

	(fn describe (params (bytes (owned-array u8))) (returns Image)
		(body
			(return (struct.new Image (width (array.len (local bytes))) (height 1i32)
				(limit (i32.from-u8 (array.load (local bytes) 0i32))))))))
