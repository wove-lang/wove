(module record_worker_queue_moved_receipt
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Job (fields (size i32)))
	(struct Encoded (fields (bytes (owned-array u8))))
	(fn encode (params (job Job)) (returns Encoded)
		(body (return (struct.new Encoded (bytes (array.alloc u8 (struct.get (local job) size)))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut queue (worker.receipt-queue encode))
			(let receipt (worker.spawn encode (struct.new Job (size 1i32))))
			(worker.push (local queue) (move (local receipt)))
			(let result (worker.join (local receipt)))
			(return 0i32))))
