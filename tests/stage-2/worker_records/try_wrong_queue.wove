(module fallible_worker_wrong_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Launch (variants (Joined) (Rejected (owned-array u8))))

	(fn echo (params (input (owned-array u8))) (returns (owned-array u8))
		(body (return (move input))))

	(fn other (params (input (owned-array u8))) (returns (owned-array i32))
		(body (return (array:alloc i32 (array:len input)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut pending (worker:receipt-queue other))
			(let outcome (worker:try-spawn echo pending Launch (array:alloc u8 1i32)))
			(return 0i32))))
