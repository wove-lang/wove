(module record_worker_pipeline
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./ledger.h"
		(fn begin (params) (returns i32))
		(fn before_spawn (params) (returns void))
		(fn before_result (params) (returns void)))

	(use c-header "./ledger.h" (only begin before_spawn before_result))

	(struct Block (fields (bytes (owned-array u8)) (scratch (owned-array u8))))
	(struct Job (fields (block Block) (length i32)))
	(struct Encoded (fields (block Block) (used i32) (original i32)))

	(fn source_job (params) (returns Job)
		(body
			(let-mut bytes (array:alloc u8 3i32))
			(array:store bytes 0i32 39u8)
			(array:store bytes 1i32 39u8)
			(array:store bytes 2i32 39u8)
			(return (struct:new Job
				(block (struct:new Block (bytes (move bytes)) (scratch (array:alloc u8 1i32))))
				(length 3i32)))))

	(fn run_length (params (input (shared-array u8)) (length i32)) (returns i32)
		(body
			(let value (array:load input 0i32))
			(let-mut count 1i32)
			(while (bool:and (i32:lt count length) (u8:eq (array:load input count) value))
				(body (set count (i32:inc count))))
			(return count)))

	(fn encode (params (job Job)) (returns Encoded)
		(body
			(let length (struct:get job length))
			(let input (move (struct:get (struct:get job block) bytes)))
			(let run (call run_length (borrow-shared input) length))
			(let-mut output (array:alloc u8 2i32))
			(array:store output 0i32 (u8:from-i32 run))
			(array:store output 1i32 (array:load input 0i32))
			(let encoded (struct:new Encoded
				(block (struct:new Block (bytes (move output)) (scratch (array:alloc u8 1i32))))
				(used 2i32) (original length)))
			(call before_result)
			(return (move encoded))))

	(fn consume (params (encoded Encoded)) (returns i32)
		(body
			(if (i32:not-eq (struct:get encoded used) 2i32) (then (return 1i32)))
			(let bytes (move (struct:get (struct:get encoded block) bytes)))
			(if (i32:not-eq (i32:from-u8 (array:load bytes 0i32)) (struct:get encoded original))
				(then (return 2i32)))
			(return (i32:add (i32:from-u8 (array:load bytes 1i32)) (struct:get encoded original)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (call begin))
			(let job (call source_job))
			(call before_spawn)
			(if (i32:eq mode 2i32)
				(then (return (call consume (worker:spawn-join encode (move job))))))
			(let receipt (worker:spawn encode (move job)))
			(if (i32:eq mode 1i32) (then (return 42i32)))
			(let forwarded (move receipt))
			(return (call consume (worker:join forwarded))))))
