(module fallible_worker_queue_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Launch (variants (Joined) (Rejected (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn echo (params (input (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local input)))))

	(fn consume (params (rows (owned-array (owned-array u8)))) (returns (owned-array u8))
		(body (return (array.alloc u8 (array.len (local rows))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut pending (worker.receipt-queue echo))
			(let outcome (worker.try-spawn echo (local pending) Launch (call consume (worker.join-all (local pending)))))
			(return 0i32))))
