(module fallible_worker_queue_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Launch (variants (Joined) (Rejected (owned-array u8))))

	(fn echo (params (input (owned-array u8))) (returns (owned-array u8))
		(body (return (move input))))

	(fn consume (params (rows (owned-array (owned-array u8)))) (returns (owned-array u8))
		(body (return (array:alloc u8 (array:len rows)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut pending (worker:receipt-queue echo))
			(let outcome (worker:try-spawn echo pending Launch (call consume (worker:join-all pending))))
			(return 0i32))))
