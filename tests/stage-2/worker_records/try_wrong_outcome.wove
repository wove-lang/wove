(module fallible_worker_wrong_outcome
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Launch (variants (Joined) (Rejected i32)))

	(fn echo (params (input (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local input)))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut pending (worker.receipt-queue echo))
			(let outcome (worker.try-spawn echo (local pending) Launch (array.alloc u8 1i32)))
			(return 0i32))))
