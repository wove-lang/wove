(module record_worker_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) (as render draw) describe))

	(fn original (params (bytes (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local bytes)))))

	(fn tile_job (params (tile i32)) (returns Job)
		(body
			(return (struct.new Job (image (struct.new Image (width 2i32) (height 3i32) (limit 40i32)))
				(tile (local tile))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut queue (worker.receipt-queue draw))
			(let first_draw (worker.spawn draw (call tile_job 1i32)))
			(let untouched (worker.spawn original (array.alloc u8 3i32)))
			(let next_draw (worker.spawn draw (call tile_job 2i32)))
			(let forwarded (move (local next_draw)))
			(worker.push (local queue) (move (local untouched)))
			(worker.push (local queue) (move (local forwarded)))
			(worker.push (local queue) (move (local first_draw)))
			(let pending (move (local queue)))
			(let-mut pixels (worker.join-all (local pending)))
			(if (i32.not-eq (array.len (local pixels)) 3i32) (then (return 1i32)))
			(let blank (array.remove (local pixels) 0i32))
			(let next (array.remove (local pixels) 0i32))
			(let first (array.remove (local pixels) 0i32))
			(if (i32.not-eq (array.len (local blank)) 3i32) (then (return 2i32)))
			(if (u8.not-eq (array.load (local first) 0i32) 41u8) (then (return 3i32)))
			(let-mut descriptions (worker.receipt-queue describe))
			(let descriptor (worker.spawn describe (move (local next))))
			(worker.push (local descriptions) (move (local descriptor)))
			(let images (worker.join-all (local descriptions)))
			(let image (array.load (local images) 0i32))
			(if (i32.not-eq (struct.get (local image) width) 6i32) (then (return 4i32)))
			(return (struct.get (local image) limit)))))
