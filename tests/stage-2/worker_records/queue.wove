(module record_worker_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) render))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn original (params (bytes (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local bytes)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut queue (worker.receipt-queue original))
			(let receipt (worker.spawn render (struct.new Job (image (struct.new Image (width 1i32) (height 1i32) (limit 0i32))) (tile 0i32))))
			(let forwarded (move (local receipt)))
			(worker.push (local queue) (move (local forwarded)))
			(return 0i32)))
)
