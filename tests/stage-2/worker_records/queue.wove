(module record_worker_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) (as render draw) describe))

	(fn original (params (bytes (owned-array u8))) (returns (owned-array u8))
		(body (return (move bytes))))

	(fn tile_job (params (tile i32)) (returns Job)
		(body
			(return (struct:new Job (image (struct:new Image (width 2i32) (height 3i32) (limit 40i32)))
				(tile tile)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut queue (worker:receipt-queue draw))
			(let first_draw (worker:spawn draw (call tile_job 1i32)))
			(let untouched (worker:spawn original (array:alloc u8 3i32)))
			(let next_draw (worker:spawn draw (call tile_job 2i32)))
			(let forwarded (move next_draw))
			(worker:push queue (move untouched))
			(worker:push queue (move forwarded))
			(worker:push queue (move first_draw))
			(let pending (move queue))
			(let-mut pixels (worker:join-all pending))
			(if (i32:not-eq (array:len pixels) 3i32) (then (return 1i32)))
			(let blank (array:remove pixels 0i32))
			(let next (array:remove pixels 0i32))
			(let first (array:remove pixels 0i32))
			(if (i32:not-eq (array:len blank) 3i32) (then (return 2i32)))
			(if (u8:not-eq (array:load first 0i32) 41u8) (then (return 3i32)))
			(let-mut descriptions (worker:receipt-queue describe))
			(let descriptor (worker:spawn describe (move next)))
			(worker:push descriptions (move descriptor))
			(let images (worker:join-all descriptions))
			(let image (array:load images 0i32))
			(if (i32:not-eq (struct:get image width) 6i32) (then (return 4i32)))
			(return (struct:get image limit)))))
