(module record_worker_pipeline_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pipeline.wove" (only (type Block) (type Job) (type Encoded) encode consume))
	(use c-header "./ledger.h" (only begin (as before_spawn before_collect)))

	(fn make_job (params (value u8)) (returns Job)
		(body
			(let-mut bytes (array:alloc u8 3i32))
			(array:store bytes 0i32 value)
			(array:store bytes 1i32 value)
			(array:store bytes 2i32 value)
			(return (struct:new Job
				(block (struct:new Block (bytes (move bytes)) (scratch (array:alloc u8 1i32))))
				(length 3i32)))))

	(fn verify_queue (params (mode i32)) (returns i32)
		(body
			(let-mut queue (worker:receipt-queue encode))
			(let first (worker:spawn encode (call make_job 37u8)))
			(let next (worker:spawn encode (call make_job 38u8)))
			(let last (worker:spawn encode (call make_job 39u8)))
			(worker:push queue (move last))
			(worker:push queue (move first))
			(worker:push queue (move next))
			(if (i32:eq mode 1i32) (then (return 42i32)))
			(call before_collect)
			(let-mut results (worker:join-all queue))
			(if (i32:not-eq (array:len results) 3i32) (then (return 1i32)))
			(let encoded (array:remove results 0i32))
			(let original (array:remove results 0i32))
			(if (i32:not-eq (call consume (move original)) 40i32) (then (return 2i32)))
			(return (call consume (move encoded)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call verify_queue (call begin))))))
