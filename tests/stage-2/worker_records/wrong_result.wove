(module record_worker_wrong_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) describe))
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Other (fields (width i32) (height i32) (limit i32)))
	(fn consume (params (other Other)) (returns i32) (body (return 0i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let receipt (worker.spawn describe (array.alloc u8 1i32)))
			(return (call consume (worker.join (local receipt))))))
)
