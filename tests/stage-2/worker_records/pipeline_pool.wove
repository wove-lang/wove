(module record_worker_pipeline_pool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pipeline.wove" (only (type Job) (as encode process_job) consume))
	(use wove-file "./pipeline_queue.wove" (only make_job))
	(use c-header "./ledger.h" (only begin before_spawn))

	(fn prepare_job (params) (returns Job)
		(body
			(let job (call make_job 39u8))
			(call before_spawn)
			(return (move job))))

	(fn submit_retired (params (threads i32)) (returns i32)
		(body
			(let pool (worker.open-pool threads 1i32))
			(let permit (worker.try-reserve pool))
			(if (bool true) (then (let retired (move pool))))
			(let receipt (worker.spawn-on process_job (move permit) (call prepare_job)))
			(return (call consume (worker.join receipt)))))

	(fn run_pipeline (params (discard bool)) (returns i32)
		(body
			(let pool (worker.open-pool 2i32 2i32))
			(let-mut pending (worker.receipt-queue process_job))
			(let permit (worker.reserve-wait pool))
			(if (worker.try-close pool) (then (return 1i32)))
			(let first_job (call make_job 37u8))
			(let first (worker.spawn-on process_job (move permit) (move first_job)))
			(let dedicated (worker.spawn process_job (call make_job 38u8)))
			(let last_permit (worker.reserve-wait pool))
			(let last (worker.spawn-on process_job (move last_permit) (call make_job 39u8)))
			(worker.push pending (move dedicated))
			(worker.push pending (move last))
			(worker.push pending (move first))
			(if discard (then (return 42i32)))
			(if (bool.not (worker.try-close pool)) (then (return 2i32)))
			(let-mut frames (worker.join-all pending))
			(if (i32.not-eq (array.len frames) 3i32) (then (return 3i32)))
			(let one (array.remove frames 0i32))
			(let two (array.remove frames 0i32))
			(let three (array.remove frames 0i32))
			(if (i32.not-eq (call consume (move one)) 41i32) (then (return 4i32)))
			(if (i32.not-eq (call consume (move three)) 40i32) (then (return 5i32)))
			(return (call consume (move two)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (call begin))
			(if (i32.eq mode 3i32) (then (return (call submit_retired 0i32))))
			(if (i32.eq mode 2i32) (then (return (call submit_retired 1i32))))
			(return (call run_pipeline (i32.eq mode 1i32))))))
