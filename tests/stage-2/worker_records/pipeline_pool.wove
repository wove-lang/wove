(module record_worker_pipeline_pool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pipeline.wove" (only (type Job) (as encode process_job) consume))
	(use wove-file "./pipeline_queue.wove" (only make_job))
	(use c-header "./ledger.h" (only begin before_spawn))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn prepare_job (params) (returns Job)
		(body
			(let job (call make_job 39u8))
			(call before_spawn)
			(return (move (local job)))))

	(fn submit_retired (params (threads i32)) (returns i32)
		(body
			(let pool (worker.open-pool (local threads) 1i32))
			(let permit (worker.try-reserve (local pool)))
			(if (bool true) (then (let retired (move (local pool)))))
			(let receipt (worker.spawn-on process_job (move (local permit)) (call prepare_job)))
			(return (call consume (worker.join (local receipt))))))

	(fn run_pipeline (params (discard bool)) (returns i32)
		(body
			(let pool (worker.open-pool 2i32 2i32))
			(let-mut pending (worker.receipt-queue process_job))
			(let permit (worker.reserve-wait (local pool)))
			(if (worker.try-close (local pool)) (then (return 1i32)))
			(let first_job (call make_job 37u8))
			(let first (worker.spawn-on process_job (move (local permit)) (move (local first_job))))
			(let dedicated (worker.spawn process_job (call make_job 38u8)))
			(let last_permit (worker.reserve-wait (local pool)))
			(let last (worker.spawn-on process_job (move (local last_permit)) (call make_job 39u8)))
			(worker.push (local pending) (move (local dedicated)))
			(worker.push (local pending) (move (local last)))
			(worker.push (local pending) (move (local first)))
			(if (local discard) (then (return 42i32)))
			(if (bool.not (worker.try-close (local pool))) (then (return 2i32)))
			(let-mut frames (worker.join-all (local pending)))
			(if (i32.not-eq (array.len (local frames)) 3i32) (then (return 3i32)))
			(let one (array.remove (local frames) 0i32))
			(let two (array.remove (local frames) 0i32))
			(let three (array.remove (local frames) 0i32))
			(if (i32.not-eq (call consume (move (local one))) 41i32) (then (return 4i32)))
			(if (i32.not-eq (call consume (move (local three))) 40i32) (then (return 5i32)))
			(return (call consume (move (local two))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let mode (call begin))
			(if (i32.eq (local mode) 3i32) (then (return (call submit_retired 0i32))))
			(if (i32.eq (local mode) 2i32) (then (return (call submit_retired 1i32))))
			(return (call run_pipeline (i32.eq (local mode) 1i32))))))
