(module record_worker_try_pipeline
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pipeline.wove" (only (type Block) (type (as Job Request)) (type Encoded) (as encode compress) consume))
	(use c-header "./ledger.h" (only begin before_spawn))

	(enum Launch (variants (Returned Request) (Queued)))

	(fn make_job (params (value u8)) (returns Request)
		(body
			(let-mut bytes (array:alloc u8 3i32))
			(array:store bytes 0i32 value)
			(array:store bytes 1i32 value)
			(array:store bytes 2i32 value)
			(let-mut scratch (array:alloc u8 1i32))
			(array:store scratch 0i32 99u8)
			(return (struct:new Request
				(block (struct:new Block (bytes (move bytes)) (scratch (move scratch))))
				(length 3i32)))))

	(fn read_marker (params (bytes (shared-array u8))) (returns u8)
		(body (return (array:load bytes 0i32))))

	(fn prefix (params (rows (owned-array Encoded)) (count i32)) (returns i32)
		(body
			(let-mut results (move rows))
			(if (i32:not-eq (array:len results) count) (then (return 1i32)))
			(let first (array:remove results 0i32))
			(let second (array:remove results 0i32))
			(if (i32:not-eq (call consume (move first)) 40i32) (then (return 2i32)))
			(if (i32:not-eq (call consume (move second)) 41i32) (then (return 3i32)))
			(if (i32:eq count 2i32) (then (return 42i32)))
			(return (call consume (array:remove results 0i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (call begin))
			(let-mut pending (worker:receipt-queue compress))
			(let first (worker:spawn compress (call make_job 37u8)))
			(let next (worker:spawn compress (call make_job 38u8)))
			(worker:push pending (move first))
			(worker:push pending (move next))
			(let input (call make_job 39u8))
			(call before_spawn)
			(match (worker:try-spawn compress pending Launch (move input))
				(case Queued
					(if (i32:not-eqz mode) (then (return 4i32)))
					(return (call prefix (worker:join-all pending) 3i32)))
				(case Returned (let original)
					(if (i32:eqz mode) (then (return 5i32)))
					(if (u8:not-eq (call read_marker
						(borrow-shared (struct:get (struct:get original block) scratch))) 99u8)
						(then (return 6i32)))
					(if (i32:not-eq (call prefix (worker:join-all pending) 2i32) 42i32)
						(then (return 7i32)))
					(return (call consume (call compress (move original)))))))))
