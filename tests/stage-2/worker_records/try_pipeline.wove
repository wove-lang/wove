(module record_worker_try_pipeline
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./pipeline.wove" (only (type Block) (type (as Job Request)) (type Encoded) (as encode compress) consume))
	(use c-header "./ledger.h" (only begin before_spawn))

	(enum Launch (variants (Returned Request) (Queued)))

	(fn make_job (params (value u8)) (returns Request)
		(body
			(let-mut bytes (array.alloc u8 3i32))
			(array.store (local bytes) 0i32 (local value))
			(array.store (local bytes) 1i32 (local value))
			(array.store (local bytes) 2i32 (local value))
			(let-mut scratch (array.alloc u8 1i32))
			(array.store (local scratch) 0i32 99u8)
			(return (struct.new Request
				(block (struct.new Block (bytes (move (local bytes))) (scratch (move (local scratch)))))
				(length 3i32)))))

	(fn read_marker (params (bytes (shared-array u8))) (returns u8)
		(body (return (array.load (local bytes) 0i32))))

	(fn prefix (params (rows (owned-array Encoded)) (count i32)) (returns i32)
		(body
			(let-mut results (move (local rows)))
			(if (i32.not-eq (array.len (local results)) (local count)) (then (return 1i32)))
			(let first (array.remove (local results) 0i32))
			(let second (array.remove (local results) 0i32))
			(if (i32.not-eq (call consume (move (local first))) 40i32) (then (return 2i32)))
			(if (i32.not-eq (call consume (move (local second))) 41i32) (then (return 3i32)))
			(if (i32.eq (local count) 2i32) (then (return 42i32)))
			(return (call consume (array.remove (local results) 0i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (call begin))
			(let-mut pending (worker.receipt-queue compress))
			(let first (worker.spawn compress (call make_job 37u8)))
			(let next (worker.spawn compress (call make_job 38u8)))
			(worker.push (local pending) (move (local first)))
			(worker.push (local pending) (move (local next)))
			(let input (call make_job 39u8))
			(call before_spawn)
			(match (worker.try-spawn compress (local pending) Launch (move (local input)))
				(case Queued
					(if (i32.not-eqz (local mode)) (then (return 4i32)))
					(return (call prefix (worker.join-all (local pending)) 3i32)))
				(case Returned (bind original)
					(if (i32.eqz (local mode)) (then (return 5i32)))
					(if (u8.not-eq (call read_marker
						(borrow-shared (struct.get (struct.get (local original) block) scratch))) 99u8)
						(then (return 6i32)))
					(if (i32.not-eq (call prefix (worker.join-all (local pending)) 2i32) 42i32)
						(then (return 7i32)))
					(return (call consume (call compress (move (local original))))))))))
