(module record_worker_pool_wrong_job
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) render))

	(struct OtherJob (fields (image Image) (tile i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let pool (worker.open-pool 1i32 1i32))
			(let permit (worker.reserve-wait (local pool)))
			(let job (struct.new OtherJob (image (struct.new Image (width 1i32) (height 1i32) (limit 0i32))) (tile 0i32)))
			(let receipt (worker.spawn-on render (move (local permit)) (local job)))
			(return 0i32))))
