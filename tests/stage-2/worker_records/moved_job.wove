(module record_worker_moved_job
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Job (fields (bytes (owned-array u8))))
	(fn read_job (params (job Job)) (returns (owned-array u8))
		(body (return (move (struct.get (local job) bytes)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let job (struct.new Job (bytes (array.alloc u8 1i32))))
			(let receipt (worker.spawn read_job (move (local job))))
			(return (array.len (struct.get (local job) bytes)))))
)
