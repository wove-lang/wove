(module record_worker_empty_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Job (fields (length i32)))
	(struct Encoded (fields (bytes (owned-array u8))))

	(fn encode (params (job Job)) (returns Encoded)
		(body (return (struct.new Encoded (bytes (array.alloc u8 (struct.get (local job) length)))))))

	(fn empty (params) (returns (owned-array Encoded))
		(body
			(let queue (worker.receipt-queue encode))
			(return (worker.join-all (local queue)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let owner (call empty))
			(return (i32.add 42i32 (array.len (local owner)))))))
