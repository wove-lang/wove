(module record_worker_empty_queue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Job (fields (length i32)))
	(struct Encoded (fields (bytes (owned-array u8))))

	(fn encode (params (job Job)) (returns Encoded)
		(body (return (struct.new Encoded (bytes (array.alloc u8 (struct.get job length)))))))

	(fn empty (params) (returns (owned-array Encoded))
		(body
			(let queue (worker.receipt-queue encode))
			(if (i32.not-eqz (worker.len queue))
				(then (return (array.alloc Encoded 1i32))))
			(return (worker.join-all queue))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let owner (call empty))
			(return (i32.add 42i32 (array.len owner))))))
