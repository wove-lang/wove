(module record_worker_try_array
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only describe))

	(enum Launch (variants (Started) (Rejected (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn echo (params (bytes (owned-array u8))) (returns (owned-array u8))
		(body (return (move (local bytes)))))

	(fn input (params) (returns (owned-array u8))
		(body
			(let-mut bytes (array.alloc u8 1i32))
			(array.store (local bytes) 0i32 42u8)
			(return (move (local bytes)))))

	(fn start (params (bytes (owned-array u8))) (returns Launch)
		(body
			(let-mut queue (worker.receipt-queue echo))
			(return (worker.try-spawn echo (local queue) Launch (move (local bytes))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(match (call start (call input))
				(case Rejected (bind original) (return 1i32))
				(case Started))
			(let-mut images (worker.receipt-queue describe))
			(match (worker.try-spawn describe (local images) Launch (call input))
				(case Rejected (bind original) (return 2i32))
				(case Started))
			(let results (worker.join-all (local images)))
			(return (struct.get (array.load (local results) 0i32) limit)))))
