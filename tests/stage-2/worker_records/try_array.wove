(module record_worker_try_array
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only describe))

	(enum Launch (variants (Started) (Rejected (owned-array u8))))

	(fn echo (params (bytes (owned-array u8))) (returns (owned-array u8))
		(body (return (move bytes))))

	(fn input (params) (returns (owned-array u8))
		(body
			(let-mut bytes (array:alloc u8 1i32))
			(array:store bytes 0i32 42u8)
			(return (move bytes))))

	(fn start (params (bytes (owned-array u8))) (returns Launch)
		(body
			(let-mut queue (worker:receipt-queue echo))
			(return (worker:try-spawn echo queue Launch (move bytes)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(match (call start (call input))
				(case Rejected (let original) (return 1i32))
				(case Started))
			(let-mut images (worker:receipt-queue describe))
			(match (worker:try-spawn describe images Launch (call input))
				(case Rejected (let original) (return 2i32))
				(case Started))
			(if (i32:not-eq (worker:len images) 1i32) (then (return 3i32)))
			(let receipt (worker:pop-front images))
			(if (i32:not-eqz (worker:len images)) (then (return 4i32)))
			(let result (worker:join receipt))
			(return (struct:get result limit)))))
