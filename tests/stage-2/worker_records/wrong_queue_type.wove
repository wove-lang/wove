(module record_worker_wrong_queue_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Job (fields (size i32)))
	(struct Encoded (fields (bytes (owned-array u8))))
	(struct Other (fields (bytes (owned-array u8))))

	(fn encode (params (job Job)) (returns Encoded)
		(body (return (struct.new Encoded (bytes (array.alloc u8 (struct.get job size)))))))
	(fn other (params (job Job)) (returns Other)
		(body (return (struct.new Other (bytes (array.alloc u8 (struct.get job size)))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut queue (worker.receipt-queue encode))
			(let receipt (worker.spawn other (struct.new Job (size 1i32))))
			(worker.push queue (move receipt))
			(return 0i32))))
