(module record_worker_try_tiles
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) (as render draw)))
	(bridge c-header "./ledger.h" (fn begin (params) (returns i32)))
	(use c-header "./ledger.h" (only begin))

	(enum Launch (variants (Started) (Rejected Job)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn tile_job (params (tile i32)) (returns Job)
		(body
			(return (struct.new Job (image (struct.new Image (width 2i32) (height 3i32) (limit 40i32)))
				(tile (local tile))))))

	(fn check_tiles (params (rows (owned-array (owned-array u8))) (count i32)) (returns i32)
		(body
			(let-mut tiles (move (local rows)))
			(if (i32.not-eq (array.len (local tiles)) (local count)) (then (return 1i32)))
			(let first (array.remove (local tiles) 0i32))
			(if (u8.not-eq (array.load (local first) 0i32) 41u8) (then (return 2i32)))
			(if (i32.eq (local count) 1i32) (then (return 42i32)))
			(let next (array.remove (local tiles) 0i32))
			(return (i32.from-u8 (array.load (local next) 0i32)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let mode (call begin))
			(let-mut pending (worker.receipt-queue draw))
			(let first (worker.spawn draw (call tile_job 1i32)))
			(worker.push (local pending) (move (local first)))
			(let job (call tile_job 2i32))
			(match (worker.try-spawn draw (local pending) Launch (local job))
				(case Started
					(if (i32.not-eqz (local mode)) (then (return 3i32)))
					(if (i32.not-eq (struct.get (local job) tile) 2i32) (then (return 4i32)))
					(return (call check_tiles (worker.join-all (local pending)) 2i32)))
				(case Rejected (bind original)
					(if (i32.eqz (local mode)) (then (return 5i32)))
					(if (i32.not-eq (call check_tiles (worker.join-all (local pending)) 1i32) 42i32)
						(then (return 6i32)))
					(let pixels (call draw (local original)))
					(if (i32.not-eq (array.len (local pixels)) 6i32) (then (return 7i32)))
					(return (i32.from-u8 (array.load (local pixels) 0i32))))))))
