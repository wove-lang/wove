(module record_worker_try_tiles
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) (as render draw)))
	(bridge c-header "./ledger.h" (fn begin (params) (returns i32)))
	(use c-header "./ledger.h" (only begin))

	(enum Launch (variants (Started) (Rejected Job)))

	(fn tile_job (params (tile i32)) (returns Job)
		(body
			(return (struct.new Job (image (struct.new Image (width 2i32) (height 3i32) (limit 40i32)))
				(tile tile)))))

	(fn check_tiles (params (rows (owned-array (owned-array u8))) (count i32)) (returns i32)
		(body
			(let-mut tiles (move rows))
			(if (i32.not-eq (array.len tiles) count) (then (return 1i32)))
			(let first (array.remove tiles 0i32))
			(if (u8.not-eq (array.load first 0i32) 41u8) (then (return 2i32)))
			(if (i32.eq count 1i32) (then (return 42i32)))
			(let next (array.remove tiles 0i32))
			(return (i32.from-u8 (array.load next 0i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (call begin))
			(let-mut pending (worker.receipt-queue draw))
			(let first (worker.spawn draw (call tile_job 1i32)))
			(worker.push pending (move first))
			(let job (call tile_job 2i32))
			(match (worker.try-spawn draw pending Launch job)
				(case Started
					(if (i32.not-eqz mode) (then (return 3i32)))
					(if (i32.not-eq (struct.get job tile) 2i32) (then (return 4i32)))
					(return (call check_tiles (worker.join-all pending) 2i32)))
				(case Rejected (let original)
					(if (i32.eqz mode) (then (return 5i32)))
					(if (i32.not-eq (call check_tiles (worker.join-all pending) 1i32) 42i32)
						(then (return 6i32)))
					(let pixels (call draw original))
					(if (i32.not-eq (array.len pixels) 6i32) (then (return 7i32)))
					(return (i32.from-u8 (array.load pixels 0i32))))))))
