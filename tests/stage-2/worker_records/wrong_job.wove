(module record_worker_wrong_job
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type Job) render))

	(struct Other (fields (image Image) (tile i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let input (struct.new Other (image (struct.new Image (width 1i32) (height 1i32) (limit 0i32))) (tile 0i32)))
			(let pixels (worker.spawn-join render (local input)))
			(return 0i32)))
)
