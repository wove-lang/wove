(module record_worker_copyable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type (as Job Tile)) (as render draw) (as render redraw) describe))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut job (struct:new Tile (image (struct:new Image (width 6i32) (height 7i32) (limit 39i32))) (tile 3i32)))
			(let receipt (worker:spawn draw job))
			(set (struct:get job tile) 2i32)
			(let pixels (worker:join receipt))
			(let second (worker:spawn-join redraw job))
			(let description (worker:spawn-join describe (move pixels)))
			(if (i32:not-eq (struct:get job tile) 2i32) (then (return 1i32)))
			(if (u8:not-eq (array:get second 0i32) 41u8) (then (return 2i32)))
			(if (i32:not-eq (struct:get description width) 42i32) (then (return 3i32)))
			(return (struct:get description limit)))))
