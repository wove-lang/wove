(module record_worker_copyable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./tiles.wove" (only (type Image) (type (as Job Tile)) (as render draw) (as render redraw) describe))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut job (struct.new Tile (image (struct.new Image (width 6i32) (height 7i32) (limit 39i32))) (tile 3i32)))
			(let receipt (worker.spawn draw (local job)))
			(set (struct.get (local job) tile) 2i32)
			(let pixels (worker.join (local receipt)))
			(let second (worker.spawn-join redraw (local job)))
			(let description (worker.spawn-join describe (move (local pixels))))
			(if (i32.not-eq (struct.get (local job) tile) 2i32) (then (return 1i32)))
			(if (u8.not-eq (array.load (local second) 0i32) 41u8) (then (return 2i32)))
			(if (i32.not-eq (struct.get (local description) width) 42i32) (then (return 3i32)))
			(return (struct.get (local description) limit)))))
