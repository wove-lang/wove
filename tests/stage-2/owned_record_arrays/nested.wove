(module nested_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Digest (fields (checksum u32) (length i32)))

	(fn make_digests (params (length i32)) (returns (owned-array Digest))
		(body
			(let-mut row (array.alloc Digest 1i32))
			(array.store row 0i32 (struct.new Digest (checksum 7u32) (length length)))
			(return (move row))))

	(fn batches (params) (returns (owned-array (owned-array Digest)))
		(body
			(let-mut rows (array.alloc (owned-array Digest) 1i32))
			(array.store rows 0i32 (call make_digests 16i32))
			(let tail (call make_digests 17i32))
			(array.push rows (move tail))
			(return (move rows))))

	(fn read_length (params (row (shared-array Digest))) (returns i32)
		(body (return (struct.get (array.load row 0i32) length))))

	(fn first_length (params (rows (shared-array (owned-array Digest)))) (returns i32)
		(body
			(let first (borrow-shared (array.load rows 0i32)))
			(return (call read_length (borrow-shared first)))))

	(fn remove_length (params (length i32)) (returns i32)
		(body
			(let-mut rows (call batches))
			(let element (array.remove rows 1i32))
			(return (call read_length (borrow-shared element)))))

	(fn byte_cube (params) (returns (owned-array (owned-array (owned-array u8))))
		(body
			(let-mut row (array.alloc u8 1i32))
			(array.store row 0i32 9u8)
			(let-mut sheet (array.alloc (owned-array u8) 0i32))
			(array.push sheet (move row))
			(let-mut cube (array.alloc (owned-array (owned-array u8)) 0i32))
			(array.push cube (move sheet))
			(return (move cube))))

	(fn read_cube (params (cube (owned-array (owned-array (owned-array u8))))) (returns i32)
		(body
			(let-mut total 0i32)
			(for (let sheet) (move cube)
				(body
					(for (let row) (move sheet)
						(body
							(set total (i32.add total (i32.from-u8 (array.load row 0i32))))))))
			(return total)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let rows (call batches))
			(let first (call first_length (borrow-shared rows)))
			(let second (call remove_length 0i32))
			(let pixel (call read_cube (call byte_cube)))
			(return (i32.add (i32.add first second) pixel)))))
