(module nested_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Digest (fields (checksum u32) (length i32)))

	(fn make_digests (params (length i32)) (returns (owned-array Digest))
		(body
			(let-mut row (array.alloc Digest 1i32))
			(array.store (local row) 0i32 (struct.new Digest (checksum 7u32) (length (local length))))
			(return (move (local row)))))

	(fn batches (params) (returns (owned-array (owned-array Digest)))
		(body
			(let-mut rows (array.alloc (owned-array Digest) 1i32))
			(array.store (local rows) 0i32 (call make_digests 16i32))
			(let tail (call make_digests 17i32))
			(array.push (local rows) (move (local tail)))
			(return (move (local rows)))))

	(fn read_length (params (row (shared-array Digest))) (returns i32)
		(body (return (struct.get (array.load (local row) 0i32) length))))

	(fn first_length (params (rows (shared-array (owned-array Digest)))) (returns i32)
		(body
			(let first (borrow-shared (array.load (local rows) 0i32)))
			(return (call read_length (borrow-shared (local first))))))

	(fn remove_length (params (length i32)) (returns i32)
		(body
			(let-mut rows (call batches))
			(let element (array.remove (local rows) 1i32))
			(return (call read_length (borrow-shared (local element))))))

	(fn byte_cube (params) (returns (owned-array (owned-array (owned-array u8))))
		(body
			(let-mut row (array.alloc u8 1i32))
			(array.store (local row) 0i32 9u8)
			(let-mut sheet (array.alloc (owned-array u8) 0i32))
			(array.push (local sheet) (move (local row)))
			(let-mut cube (array.alloc (owned-array (owned-array u8)) 0i32))
			(array.push (local cube) (move (local sheet)))
			(return (move (local cube)))))

	(fn read_cube (params (cube (owned-array (owned-array (owned-array u8))))) (returns i32)
		(body
			(let-mut total 0i32)
			(for (bind sheet) (move (local cube))
				(body
					(for (bind row) (move (local sheet))
						(body
							(set (local total) (i32.add (local total) (i32.from-u8 (array.load (local row) 0i32))))))))
			(return (local total))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let rows (call batches))
			(let first (call first_length (borrow-shared (local rows))))
			(let second (call remove_length 0i32))
			(let pixel (call read_cube (call byte_cube)))
			(return (i32.add (i32.add (local first) (local second)) (local pixel))))))
