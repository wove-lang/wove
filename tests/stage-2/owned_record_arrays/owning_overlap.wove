(module owning_record_array_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (data (owned-array u8))))

	(fn consume (params (entry (shared-ref Entry)) (count i32)) (returns i32)
		(body (return count)))

	(fn take (params (entries (owned-array Entry))) (returns i32)
		(body (return 0i32)))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut entries (array:alloc Entry 1i32))
			(return (call consume (borrow-shared (array:get entries 0i32))
				(call take (move entries)))))))
