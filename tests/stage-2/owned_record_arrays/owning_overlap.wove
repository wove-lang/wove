(module owning_record_array_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (data (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn consume (params (entry (shared-ref Entry)) (count i32)) (returns i32)
		(body (return (local count))))

	(fn take (params (entries (owned-array Entry))) (returns i32)
		(body (return 0i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut entries (array.alloc Entry 1i32))
			(return (call consume (borrow-shared (array.load (local entries) 0i32))
				(call take (move (local entries))))))))
