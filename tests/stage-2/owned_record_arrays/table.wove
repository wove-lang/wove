(module owned_record_table
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (key u32) (count i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn slots
		(params (count i32))
		(returns (owned-array Entry))
		(body (return (array.alloc Entry (local count)))))

	(fn table
		(params (count i32))
		(returns (owned-array Entry))
		(body
			(let-mut entries (call slots (local count)))
			(array.store (local entries) 1i32 (struct.new Entry (key 7u32) (count 42i32)))
			(return (move (local entries)))))

	(fn forward
		(params (count i32))
		(returns (owned-array Entry))
		(body (return (call table (local count)))))

	(fn read_count
		(params (entries (shared-array Entry)))
		(returns i32)
		(body
			(let entry (array.load (local entries) 1i32))
			(if (u32.eq (struct.get (local entry) key) 7u32)
				(then (return (struct.get (local entry) count))))
			(return 1i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let entries (call forward 2i32))
			(if (i32.eq (array.len (local entries)) 2i32)
				(then (return (call read_count (borrow-shared (local entries))))))
			(return 2i32))))
