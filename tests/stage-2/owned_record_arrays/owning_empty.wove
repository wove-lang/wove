(module owning_record_array_empty
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (data (owned-array u8))))

	(fn length (params (data (shared-array u8))) (returns i32)
		(body (return (array:len data))))

	(fn inspect (params (entry (shared-ref Entry))) (returns i32)
		(body (return (call length (borrow-shared (struct:get entry data))))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut entries (array:alloc Entry 1i32))
			(let argc (i32:dec (array:len spans)))
			(if (i32:eq argc 1i32)
				(then (return (call inspect (borrow-shared (array:get entries 0i32))))))
			(if (i32:eq argc 2i32)
				(then
					(let entry (array:remove entries 1i32))
					(return 0i32)))
			(let entry (array:remove entries 0i32))
			(return 0i32))))
