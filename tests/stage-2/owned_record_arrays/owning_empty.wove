(module owning_record_array_empty
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (data (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn length (params (data (shared-array u8))) (returns i32)
		(body (return (array.len (local data)))))

	(fn inspect (params (entry (shared-ref Entry))) (returns i32)
		(body (return (call length (borrow-shared (struct.get (local entry) data))))))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut entries (array.alloc Entry 1i32))
			(let argc (array.len (local spans)))
			(if (i32.eq (local argc) 1i32)
				(then (return (call inspect (borrow-shared (array.load (local entries) 0i32))))))
			(if (i32.eq (local argc) 2i32)
				(then
					(let entry (array.remove (local entries) 1i32))
					(return 0i32)))
			(let entry (array.remove (local entries) 0i32))
			(return 0i32))))
