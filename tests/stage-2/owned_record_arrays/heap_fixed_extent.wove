(module heap_fixed_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut grid (array.alloc (array (owned-array u8) 2) 1i32))
			(let row (array.new (array (owned-array u8) 1) (array.alloc u8 1i32)))
			(array.push (local grid) (move (local row)))
			(return 0i32))))
