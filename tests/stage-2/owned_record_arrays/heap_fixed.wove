(module heap_owning_fixed_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn cell (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut items (array:alloc i32 1i32))
			(array:set items 0i32 value)
			(return (move items))))

	(fn make_tile (params (base i32)) (returns (array (array (owned-array i32) 2) 2))
		(body
			(return (array:new (array (array (owned-array i32) 2) 2)
				(array:new (array (owned-array i32) 2) (call cell base) (call cell (i32:inc base)))
				(array:new (array (owned-array i32) 2) (call cell (i32:add base 2i32)) (call cell (i32:add base 3i32)))))))

	(fn paint (params (items (mut-array i32)) (value i32)) (returns void)
		(body (array:set items 0i32 value)))

	(fn paint_at (params (grid (mut-array (array (array (owned-array i32) 2) 2)))) (returns void)
		(body
			(call paint (borrow-mut (array:get (array:get (array:get grid 0i32) 1i32) 0i32)) 39i32)))

	(fn first_at (params (grid (shared-array (array (array (owned-array i32) 2) 2))) (index i32)) (returns i32)
		(body
			(let items (borrow-shared (array:get (array:get (array:get grid index) 0i32) 0i32)))
			(return (array:get items 0i32))))

	(fn last_at (params (grid (shared-array (array (array (owned-array i32) 2) 2)))) (returns i32)
		(body
			(let items (borrow-shared (array:get (array:get
				(array:get grid (i32:dec (array:len grid))) 0i32) 0i32)))
			(return (array:get items 0i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut grid (array:alloc (array (array (owned-array i32) 2) 2) 3i32))
			(let first (call make_tile 10i32))
			(array:set grid 0i32 (move first))
			(array:set grid 2i32 (call make_tile 20i32))
			(if (i32:not-eq (array:len (array:get grid 0i32)) 2i32) (then (return 1i32)))
			(call paint_at (borrow-mut grid))
			(let leaf (move (array:get (array:get (array:get grid 0i32) 1i32) 0i32)))
			(if (i32:not-eq (array:get leaf 0i32) 39i32) (then (return 2i32)))
			(let tile (move (array:get grid 2i32)))
			(if (i32:not-eq (array:len grid) 3i32) (then (return 3i32)))
			(array:set grid 2i32 (call make_tile 30i32))
			(array:set grid 2i32 (call make_tile 40i32))
			(let removed (array:remove grid 2i32))
			(let removed_first (borrow-shared (array:get (array:get removed 0i32) 0i32)))
			(if (i32:not-eq (array:get removed_first 0i32) 40i32) (then (return 4i32)))
			(array:push grid (move tile))
			(array:push grid (call make_tile 50i32))
			(if (i32:not-eq (array:len grid) 4i32) (then (return 5i32)))
			(if (i32:not-eq (call first_at (borrow-shared grid) 2i32) 20i32) (then (return 6i32)))
			(if (i32:not-eq (call last_at (borrow-shared grid)) 50i32) (then (return 7i32)))
			(array:truncate grid 3i32)
			(let empty (array:new (array (owned-array i32) 0)))
			(let forwarded (move empty))
			(if (i32:not-eqz (array:len forwarded)) (then (return 8i32)))
			(return 42i32))))
