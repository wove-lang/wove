(module heap_owning_fixed_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn cell (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut items (array.alloc i32 1i32))
			(array.store (local items) 0i32 (local value))
			(return (move (local items)))))

	(fn make_tile (params (base i32)) (returns (array (array (owned-array i32) 2) 2))
		(body
			(return (array.new (array (array (owned-array i32) 2) 2)
				(array.new (array (owned-array i32) 2) (call cell (local base)) (call cell (i32.inc (local base))))
				(array.new (array (owned-array i32) 2) (call cell (i32.add (local base) 2i32)) (call cell (i32.add (local base) 3i32)))))))

	(fn paint (params (items (mut-array i32)) (value i32)) (returns void)
		(body (array.store (local items) 0i32 (local value))))

	(fn paint_at (params (grid (mut-array (array (array (owned-array i32) 2) 2)))) (returns void)
		(body
			(call paint (borrow-mut (array.load (array.load (array.load (local grid) 0i32) 1i32) 0i32)) 39i32)))

	(fn first_at (params (grid (shared-array (array (array (owned-array i32) 2) 2))) (index i32)) (returns i32)
		(body
			(let items (borrow-shared (array.load (array.load (array.load (local grid) (local index)) 0i32) 0i32)))
			(return (array.load (local items) 0i32))))

	(fn last_at (params (grid (shared-array (array (array (owned-array i32) 2) 2)))) (returns i32)
		(body
			(let items (borrow-shared (array.load (array.load
				(array.load (local grid) (i32.dec (array.len (local grid)))) 0i32) 0i32)))
			(return (array.load (local items) 0i32))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut grid (array.alloc (array (array (owned-array i32) 2) 2) 3i32))
			(let first (call make_tile 10i32))
			(array.store (local grid) 0i32 (move (local first)))
			(array.store (local grid) 2i32 (call make_tile 20i32))
			(if (i32.not-eq (array.len (array.load (local grid) 0i32)) 2i32) (then (return 1i32)))
			(call paint_at (borrow-mut (local grid)))
			(let leaf (move (array.load (array.load (array.load (local grid) 0i32) 1i32) 0i32)))
			(if (i32.not-eq (array.load (local leaf) 0i32) 39i32) (then (return 2i32)))
			(let tile (move (array.load (local grid) 2i32)))
			(if (i32.not-eq (array.len (local grid)) 3i32) (then (return 3i32)))
			(array.store (local grid) 2i32 (call make_tile 30i32))
			(array.store (local grid) 2i32 (call make_tile 40i32))
			(let removed (array.remove (local grid) 2i32))
			(let removed_first (borrow-shared (array.load (array.load (local removed) 0i32) 0i32)))
			(if (i32.not-eq (array.load (local removed_first) 0i32) 40i32) (then (return 4i32)))
			(array.push (local grid) (move (local tile)))
			(array.push (local grid) (call make_tile 50i32))
			(if (i32.not-eq (array.len (local grid)) 4i32) (then (return 5i32)))
			(if (i32.not-eq (call first_at (borrow-shared (local grid)) 2i32) 20i32) (then (return 6i32)))
			(if (i32.not-eq (call last_at (borrow-shared (local grid))) 50i32) (then (return 7i32)))
			(array.truncate (local grid) 3i32)
			(return 42i32))))
