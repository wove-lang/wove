(module heap_fixed_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut grid (array.alloc (array (owned-array u8) 1) 1i32))
			(array.store grid 0i32 (array.new (array (owned-array u8) 1) (array.alloc u8 1i32)))
			(let leaf (borrow-shared (array.load (array.load grid 0i32) 0i32)))
			(let grown (array.try-reserve grid 16i32))
			(return (array.len leaf)))))
