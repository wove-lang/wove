(module nested_wrong_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Left (fields (length i32)))
	(struct Right (fields (length i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array Left) 0i32))
			(let item (array.alloc Right 0i32))
			(array.push (local rows) (move (local item)))
			(return 0i32))))
