(module nested_wrong_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Left (fields (length i32)))
	(struct Right (fields (length i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc (owned-array Left) 0i32))
			(let item (array:alloc Right 0i32))
			(array:push rows (move item))
			(return 0i32))))
