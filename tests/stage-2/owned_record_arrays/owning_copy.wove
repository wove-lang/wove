(module owning_record_array_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (data (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let entries (array.alloc Entry 1i32))
			(let copy (array.load (local entries) 0i32))
			(return 0i32))))
