(module wrong_record_array_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (count i32)))
	(struct Other (fields (count i32)))

	(fn table
		(params)
		(returns (owned-array Entry))
		(body (return (array:alloc Other 1i32))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return 0i32))))
