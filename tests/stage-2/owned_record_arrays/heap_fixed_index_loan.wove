(module heap_fixed_reserve_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn zero (params (condition bool)) (returns i32)
		(body (return 0i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut grid (array.alloc (array (owned-array u8) 1) 1i32))
			(array.store (local grid) 0i32 (array.new (array (owned-array u8) 1) (array.alloc u8 1i32)))
			(let leaf (borrow-shared (array.load (array.load (local grid) 0i32)
				(call zero (array.try-reserve (local grid) 16i32)))))
			(return (array.len (local leaf))))))
