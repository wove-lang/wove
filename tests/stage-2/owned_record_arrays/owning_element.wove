(module owning_record_array_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Label (fields (bytes (owned-array u8))))
	(struct Entry (fields (label Label) (extra (owned-array i32)) (count i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn slots (params) (returns (owned-array Entry))
		(body (return (array.alloc Entry 3i32))))

	(fn make_entry (params (count i32)) (returns Entry)
		(body
			(return (struct.new Entry (label (struct.new Label (bytes (array.alloc u8 1i32))))
				(extra (array.alloc i32 1i32)) (count (local count))))))

	(fn paint_label (params (bytes (mut-array u8))) (returns void)
		(body (array.store (local bytes) 0i32 9u8)))

	(fn paint (params (entry (mut-ref Entry))) (returns void)
		(body
			(set (struct.get (local entry) count) 12i32)
			(call paint_label (borrow-mut (struct.get (struct.get (local entry) label) bytes)))))

	(fn paint_at (params (entries (mut-array Entry)) (index i32)) (returns void)
		(body (call paint (borrow-mut (array.load (local entries) (local index))))))

	(fn label_value (params (bytes (shared-array u8))) (returns i32)
		(body (return (i32.from-u8 (array.load (local bytes) 0i32)))))

	(fn total (params (entry (shared-ref Entry))) (returns i32)
		(body (return (i32.add (struct.get (local entry) count)
			(call label_value (borrow-shared (struct.get (struct.get (local entry) label) bytes)))))))

	(fn read_entry (params (entries (shared-array Entry)) (index i32)) (returns i32)
		(body (return (call total (borrow-shared (array.load (local entries) (local index)))))))

	(fn take_first (params (entries (owned-array Entry))) (returns Entry)
		(body
			(let-mut writable (move (local entries)))
			(return (array.remove (local writable) 0i32))))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut entries (call slots))
			(array.store (local entries) 2i32 (call make_entry 1i32))
			(let next (call make_entry 22i32))
			(array.store (local entries) 0i32 (move (local next)))
			(call paint_at (borrow-mut (local entries)) 2i32)
			(let painted (call read_entry (borrow-shared (local entries)) 2i32))
			(if (i32.not-eq (local painted) 21i32) (then (return 1i32)))
			(array.store (local entries) 2i32 (call make_entry 20i32))
			(let removed (array.remove (local entries) 0i32))
			(let appended (call make_entry 11i32))
			(array.push (local entries) (move (local appended)))
			(array.truncate (local entries) 2i32)
			(let present (call total (borrow-shared (array.load (local entries) 1i32))))
			(return (i32.add (local present) (call total (borrow-shared (local removed))))))))
