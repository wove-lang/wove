(module owning_record_array_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Label (fields (bytes (owned-array u8))))
	(struct Entry (fields (label Label) (extra (owned-array i32)) (count i32)))

	(fn slots (params) (returns (owned-array Entry))
		(body (return (array:alloc Entry 3i32))))

	(fn make_entry (params (count i32)) (returns Entry)
		(body
			(return (struct:new Entry (label (struct:new Label (bytes (array:alloc u8 1i32))))
				(extra (array:alloc i32 1i32)) (count count)))))

	(fn paint_label (params (bytes (mut-array u8))) (returns void)
		(body (array:store bytes 0i32 9u8)))

	(fn paint (params (entry (mut-ref Entry))) (returns void)
		(body
			(set (struct:get entry count) 12i32)
			(call paint_label (borrow-mut (struct:get (struct:get entry label) bytes)))))

	(fn paint_at (params (entries (mut-array Entry)) (index i32)) (returns void)
		(body (call paint (borrow-mut (array:load entries index)))))

	(fn label_value (params (bytes (shared-array u8))) (returns i32)
		(body (return (i32:from-u8 (array:load bytes 0i32)))))

	(fn total (params (entry (shared-ref Entry))) (returns i32)
		(body (return (i32:add (struct:get entry count)
			(call label_value (borrow-shared (struct:get (struct:get entry label) bytes)))))))

	(fn read_entry (params (entries (shared-array Entry)) (index i32)) (returns i32)
		(body (return (call total (borrow-shared (array:load entries index))))))

	(fn take_first (params (entries (owned-array Entry))) (returns Entry)
		(body
			(let-mut writable (move entries))
			(return (array:remove writable 0i32))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut entries (call slots))
			(array:store entries 2i32 (call make_entry 1i32))
			(let next (call make_entry 22i32))
			(array:store entries 0i32 (move next))
			(call paint_at (borrow-mut entries) 2i32)
			(let painted (call read_entry (borrow-shared entries) 2i32))
			(if (i32:not-eq painted 21i32) (then (return 1i32)))
			(array:store entries 2i32 (call make_entry 20i32))
			(let removed (array:remove entries 0i32))
			(let appended (call make_entry 11i32))
			(array:push entries (move appended))
			(array:truncate entries 2i32)
			(let present (call total (borrow-shared (array:load entries 1i32))))
			(return (i32:add present (call total (borrow-shared removed)))))))
