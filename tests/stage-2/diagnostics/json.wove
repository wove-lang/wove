			(array:set bytes (i32 84) (u8 116))
			(array:set bytes (i32 85) (u8 105))
			(array:set bytes (i32 86) (u8 111))
			(array:set bytes (i32 87) (u8 110))
			(array:set (:doc "invalid_utf8") bytes (i32 88) (u8 255))))

	(fn matches_key
		(params (json (shared-array u8)) (node JsonNode) (parent i32) (expected (shared-array u8)))
		(returns bool)
		(body
			(return (bool:and
				(i32:eq (struct:get node parent) parent)
				(call same_bytes (borrow-shared json)
					(i32:add (struct:get node key_start) (i32 1))
					(i32:sub (struct:get node key_end) (i32 1))
					(borrow-shared expected) (i32 0) (array:len expected))))))

	(fn matches_number
		(params (json (shared-array u8)) (node JsonNode) (parent i32) (key (shared-array u8)) (expected u32))
		(returns bool)
		(body
			(if (bool:not (bool:and (u32:eq (struct:get node kind) (u32 4))
					(call matches_key (borrow-shared json) node parent (borrow-shared key))))
				(then (return (bool false))))
			(let number (call read_decimal_digits (borrow-shared json)
				(struct:get node start) (struct:get node end) (u32 429496729) (u32 5)))
			(return (bool:and (bool:not (i32:lt (struct:get number digits) (i32 0)))
				(u32:eq (struct:get number magnitude) expected)))))

	(fn matches_text
		(params (json (shared-array u8)) (node JsonNode) (parent i32)
			(key (shared-array u8)) (expected (shared-array u8)))
		(returns bool)
		(body
			(if (bool:not (bool:and (u32:eq (struct:get node kind) (u32 3))
					(call matches_key (borrow-shared json) node parent (borrow-shared key))))
				(then (return (bool false))))
			(let length (array:len expected))
			(let-mut decoded (array:alloc u8 length))
			(let text (call json_decode_string (borrow-shared json)
				(struct:get node start) (struct:get node end) (borrow-mut decoded)))
			(return (bool:and (u32:eq (struct:get text error) (u32 0))
				(bool:and (i32:eq (struct:get text written) length)
					(call same_bytes (borrow-shared decoded) (i32 0) length
						(borrow-shared expected) (i32 0) length))))))

	(fn matches_common
		(params (json (shared-array u8)) (nodes (shared-array JsonNode)) (text (shared-array u8))
			(message (shared-array u8)) (code u32))
		(returns bool)
		(body
			(let root (array:get nodes (i32 0)))
			(let location (array:get nodes (i32 3)))
			(if (bool:not (bool:and (u32:eq (struct:get root kind) (u32 1))
					(u32:eq (struct:get location kind) (u32 1))))
				(then (return (bool false))))
			(if (bool:not (call matches_key (borrow-shared json) location (i32 0)
					(borrow-shared (array:range text (i32 11) (i32 19)))))
				(then (return (bool false))))
			(if (bool:not (call matches_number (borrow-shared json) (array:get nodes (i32 1)) (i32 0)
					(borrow-shared (array:range text (i32 0) (i32 4))) code))
				(then (return (bool false))))
			(return (call matches_text (borrow-shared json) (array:get nodes (i32 2)) (i32 0)
				(borrow-shared (array:range text (i32 4) (i32 11))) (borrow-shared message)))))

	(fn fixture_node
		(params (nodes (shared-array JsonNode)) (index i32))
		(returns JsonNode)
		(body (return (array:get nodes index))))

	(fn matches_source
		(params (json (shared-array u8)) (text (shared-array u8)))
		(returns bool)
		(body
			(let-mut nodes (array:alloc JsonNode (i32 8)))
			(let parsed (call json_parse (borrow-shared json) (borrow-mut nodes)))
			(if (bool:not (bool:and (u32:eq (struct:get parsed error) (u32 0))
					(i32:eq (struct:get parsed rows) (i32 8))))
				(then (return (bool false))))
			(if (bool:not (call matches_common (borrow-shared json) (borrow-shared nodes)
					(borrow-shared text) (borrow-shared (array:range text (i32 50) (i32 63))) (u32 4294967295)))
				(then (return (bool false))))
			(if (bool:not (call matches_text (borrow-shared json) (call fixture_node (borrow-shared nodes) (i32 4)) (i32 3)
					(borrow-shared (array:range text (i32 19) (i32 23))) (borrow-shared (array:range text (i32 23) (i32 29)))))
				(then (return (bool false))))
			(if (bool:not (call matches_text (borrow-shared json) (call fixture_node (borrow-shared nodes) (i32 5)) (i32 3)
					(borrow-shared (array:range text (i32 33) (i32 37))) (borrow-shared (array:range text (i32 63) (i32 74)))))
				(then (return (bool false))))
			(return (bool:and
				(call matches_number (borrow-shared json) (call fixture_node (borrow-shared nodes) (i32 6)) (i32 3)
					(borrow-shared (array:range text (i32 37) (i32 42))) (u32 3))
				(call matches_number (borrow-shared json) (call fixture_node (borrow-shared nodes) (i32 7)) (i32 3)
					(borrow-shared (array:range text (i32 42) (i32 45))) (u32 19))))))

	(fn matches_argv
		(params (json (shared-array u8)) (text (shared-array u8)))
		(returns bool)
		(body
			(let-mut nodes (array:alloc JsonNode (i32 6)))
			(let parsed (call json_parse (borrow-shared json) (borrow-mut nodes)))
			(if (bool:not (bool:and (u32:eq (struct:get parsed error) (u32 0))
					(i32:eq (struct:get parsed rows) (i32 6))))
				(then (return (bool false))))
			(if (bool:not (call matches_common (borrow-shared json) (borrow-shared nodes)
					(borrow-shared text) (borrow-shared (array:range text (i32 74) (i32 88))) (u32 7)))
				(then (return (bool false))))
			(return (bool:and
				(call matches_text (borrow-shared json) (call fixture_node (borrow-shared nodes) (i32 4)) (i32 3)
					(borrow-shared (array:range text (i32 19) (i32 23))) (borrow-shared (array:range text (i32 29) (i32 33))))
				(call matches_number (borrow-shared json) (call fixture_node (borrow-shared nodes) (i32 5)) (i32 3)
					(borrow-shared (array:range text (i32 45) (i32 50))) (u32 0))))))

	(fn check_source_capacity
		(params (diagnostic Diagnostic) (text (shared-array u8)) (reference (shared-array u8)) (stack (mut-array u8)))
		(returns i32)
		(body
			(let size (array:len reference))
			(let-mut exact (array:alloc u8 size))
			(let exact_result (call write_diagnostic_json diagnostic
				(borrow-shared (array:range text (i32 50) (i32 63))) (borrow-shared (array:range text (i32 63) (i32 74)))
				(borrow-mut exact) (borrow-mut stack)))
			(if (bool:not (bool:and (u32:eq (struct:get exact_result error) (u32 0))
					(i32:eq (struct:get exact_result written) size)))
				(then (return (i32 5))))
			(if (bool:not (call same_bytes (borrow-shared exact) (i32 0) size
					(borrow-shared reference) (i32 0) size))
				(then (return (i32 6))))
			(let-mut short (array:alloc u8 (i32:sub size (i32 1))))
			(let short_result (call write_diagnostic_json diagnostic
				(borrow-shared (array:range text (i32 50) (i32 63))) (borrow-shared (array:range text (i32 63) (i32 74)))
				(borrow-mut short) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get short_result error) (u32 1))) (then (return (i32 7))))
			(let-mut empty (array:alloc u8 (i32 0)))
			(let empty_result (call write_diagnostic_json diagnostic
				(borrow-shared (array:range text (i32 50) (i32 63))) (borrow-shared (array:range text (i32 63) (i32 74)))
				(borrow-mut empty) (borrow-mut stack)))
			(if (bool:not (bool:and (u32:eq (struct:get empty_result error) (u32 1))
					(i32:eq (struct:get empty_result written) (i32 0))))
				(then (return (i32 8))))
			(return (i32 0))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut text (array:alloc u8 (i32 89)))
			(call fill_fixture_text (borrow-mut text))
			(let-mut output (array:alloc u8 (i32 256)))
			(let-mut stack (array:alloc u8 (i32 2)))
			(let source (call diagnostic_source (u32 4294967295) (i32 3) (i32 19)))
			(let source_result (call write_diagnostic_json source
				(borrow-shared (array:range text (i32 50) (i32 63))) (borrow-shared (array:range text (i32 63) (i32 74)))
				(borrow-mut output) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get source_result error) (u32 0))) (then (return (i32 1))))
			(let size (struct:get source_result written))
			(if (bool:not (call matches_source (borrow-shared (array:range output (i32 0) size))
					(borrow-shared text)))
				(then (return (i32 2))))
			(let capacity (call check_source_capacity source (borrow-shared text)
				(borrow-shared (array:range output (i32 0) size)) (borrow-mut stack)))
			(if (bool:not (i32:eq capacity (i32 0))) (then (return capacity)))
			(let argument (call diagnostic_argv (u32 7) (i32 0)))
			(let argument_result (call write_diagnostic_json argument
				(borrow-shared (array:range text (i32 74) (i32 88))) (borrow-shared (array:range text (i32 88) (i32 89)))
				(borrow-mut output) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get argument_result error) (u32 0))) (then (return (i32 3))))
			(if (bool:not (call matches_argv
					(borrow-shared (array:range output (i32 0) (struct:get argument_result written)))
					(borrow-shared text)))
				(then (return (i32 4))))
			(let-mut shallow (array:alloc u8 (i32 1)))
			(let nesting (call write_diagnostic_json source
				(borrow-shared (array:range text (i32 50) (i32 63))) (borrow-shared (array:range text (i32 63) (i32 74)))
				(borrow-mut output) (borrow-mut shallow)))
			(if (bool:not (u32:eq (struct:get nesting error) (u32 2))) (then (return (i32 9))))
			(let bad_text (call write_diagnostic_json source
				(borrow-shared (array:range text (i32 88) (i32 89))) (borrow-shared (array:range text (i32 63) (i32 74)))
				(borrow-mut output) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get bad_text error) (u32 4))) (then (return (i32 10))))
			(let bad_file (call write_diagnostic_json source
				(borrow-shared (array:range text (i32 50) (i32 63))) (borrow-shared (array:range text (i32 88) (i32 89)))
				(borrow-mut output) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get bad_file error) (u32 4))) (then (return (i32 11))))
			(let bad (struct:new Diagnostic (code (u32 7)) (location (u32 0))
				(start (i32 -1)) (end (i32 -1)) (argv_index (i32 -1))))
			(let bad_tag (call write_diagnostic_json bad
				(borrow-shared (array:range text (i32 88) (i32 89))) (borrow-shared (array:range text (i32 88) (i32 89)))
				(borrow-mut output) (borrow-mut stack)))
			(if (bool:not (bool:and (u32:eq (struct:get bad_tag error) (u32 3))
					(i32:eq (struct:get bad_tag written) (i32 0))))
				(then (return (i32 12))))
			(return (i32 0)))))
