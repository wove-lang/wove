	diagnostic_json_fixture

	(use wove-file "../../../stage-2/diagnostics/record.wove" (only (type Diagnostic) diagnostic_source diagnostic_argv))
	(use wove-file "../../../stage-2/diagnostics/json.wove" (only write_diagnostic_json))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode) json_parse json_decode_string))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))
	(use wove-file "../../../stage-2/text/decimal.wove" (only read_decimal_digits))

	(fn fill_fixture_text
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(slice.store (:doc "code") (local bytes) (i32 0) (u8 99))
			(slice.store (local bytes) (i32 1) (u8 111))
			(slice.store (local bytes) (i32 2) (u8 100))
			(slice.store (local bytes) (i32 3) (u8 101))
			(slice.store (:doc "message") (local bytes) (i32 4) (u8 109))
			(slice.store (local bytes) (i32 5) (u8 101))
			(slice.store (local bytes) (i32 6) (u8 115))
			(slice.store (local bytes) (i32 7) (u8 115))
			(slice.store (local bytes) (i32 8) (u8 97))
			(slice.store (local bytes) (i32 9) (u8 103))
			(slice.store (local bytes) (i32 10) (u8 101))
			(slice.store (:doc "location") (local bytes) (i32 11) (u8 108))
			(slice.store (local bytes) (i32 12) (u8 111))
			(slice.store (local bytes) (i32 13) (u8 99))
			(slice.store (local bytes) (i32 14) (u8 97))
			(slice.store (local bytes) (i32 15) (u8 116))
			(slice.store (local bytes) (i32 16) (u8 105))
			(slice.store (local bytes) (i32 17) (u8 111))
			(slice.store (local bytes) (i32 18) (u8 110))
			(slice.store (:doc "kind") (local bytes) (i32 19) (u8 107))
			(slice.store (local bytes) (i32 20) (u8 105))
			(slice.store (local bytes) (i32 21) (u8 110))
			(slice.store (local bytes) (i32 22) (u8 100))
			(slice.store (:doc "source") (local bytes) (i32 23) (u8 115))
			(slice.store (local bytes) (i32 24) (u8 111))
			(slice.store (local bytes) (i32 25) (u8 117))
			(slice.store (local bytes) (i32 26) (u8 114))
			(slice.store (local bytes) (i32 27) (u8 99))
			(slice.store (local bytes) (i32 28) (u8 101))
			(slice.store (:doc "argv") (local bytes) (i32 29) (u8 97))
			(slice.store (local bytes) (i32 30) (u8 114))
			(slice.store (local bytes) (i32 31) (u8 103))
			(slice.store (local bytes) (i32 32) (u8 118))
			(slice.store (:doc "file") (local bytes) (i32 33) (u8 102))
			(slice.store (local bytes) (i32 34) (u8 105))
			(slice.store (local bytes) (i32 35) (u8 108))
			(slice.store (local bytes) (i32 36) (u8 101))
			(slice.store (:doc "start") (local bytes) (i32 37) (u8 115))
			(slice.store (local bytes) (i32 38) (u8 116))
			(slice.store (local bytes) (i32 39) (u8 97))
			(slice.store (local bytes) (i32 40) (u8 114))
			(slice.store (local bytes) (i32 41) (u8 116))
			(slice.store (:doc "end") (local bytes) (i32 42) (u8 101))
			(slice.store (local bytes) (i32 43) (u8 110))
			(slice.store (local bytes) (i32 44) (u8 100))
			(slice.store (:doc "index") (local bytes) (i32 45) (u8 105))
			(slice.store (local bytes) (i32 46) (u8 110))
			(slice.store (local bytes) (i32 47) (u8 100))
			(slice.store (local bytes) (i32 48) (u8 101))
			(slice.store (local bytes) (i32 49) (u8 120))
			(slice.store (:doc "source_message") (local bytes) (i32 50) (u8 98))
			(slice.store (local bytes) (i32 51) (u8 97))
			(slice.store (local bytes) (i32 52) (u8 100))
			(slice.store (local bytes) (i32 53) (u8 32))
			(slice.store (local bytes) (i32 54) (u8 34))
			(slice.store (local bytes) (i32 55) (u8 110))
			(slice.store (local bytes) (i32 56) (u8 97))
			(slice.store (local bytes) (i32 57) (u8 109))
			(slice.store (local bytes) (i32 58) (u8 101))
			(slice.store (local bytes) (i32 59) (u8 34))
			(slice.store (local bytes) (i32 60) (u8 10))
			(slice.store (local bytes) (i32 61) (u8 195))
			(slice.store (local bytes) (i32 62) (u8 169))
			(slice.store (:doc "source_name") (local bytes) (i32 63) (u8 115))
			(slice.store (local bytes) (i32 64) (u8 114))
			(slice.store (local bytes) (i32 65) (u8 99))
			(slice.store (local bytes) (i32 66) (u8 47))
			(slice.store (local bytes) (i32 67) (u8 195))
			(slice.store (local bytes) (i32 68) (u8 169))
			(slice.store (local bytes) (i32 69) (u8 46))
			(slice.store (local bytes) (i32 70) (u8 119))
			(slice.store (local bytes) (i32 71) (u8 111))
			(slice.store (local bytes) (i32 72) (u8 118))
			(slice.store (local bytes) (i32 73) (u8 101))
			(slice.store (:doc "argument_message") (local bytes) (i32 74) (u8 117))
			(slice.store (local bytes) (i32 75) (u8 110))
			(slice.store (local bytes) (i32 76) (u8 107))
			(slice.store (local bytes) (i32 77) (u8 110))
			(slice.store (local bytes) (i32 78) (u8 111))
			(slice.store (local bytes) (i32 79) (u8 119))
			(slice.store (local bytes) (i32 80) (u8 110))
			(slice.store (local bytes) (i32 81) (u8 32))
			(slice.store (local bytes) (i32 82) (u8 111))
			(slice.store (local bytes) (i32 83) (u8 112))
			(slice.store (local bytes) (i32 84) (u8 116))
			(slice.store (local bytes) (i32 85) (u8 105))
			(slice.store (local bytes) (i32 86) (u8 111))
			(slice.store (local bytes) (i32 87) (u8 110))
			(slice.store (:doc "invalid_utf8") (local bytes) (i32 88) (u8 255))))

	(fn matches_key
		(params (json (shared-slice u8)) (node JsonNode) (parent i32) (expected (shared-slice u8)))
		(returns bool)
		(body
			(return (bool.and
				(i32.eq (record.get (local node) parent) (local parent))
				(call same_bytes (borrow-shared (local json))
					(i32.add.wrapping (record.get (local node) key_start) (i32 1))
					(i32.sub.wrapping (record.get (local node) key_end) (i32 1))
					(borrow-shared (local expected)) (i32 0) (slice.len (local expected)))))))

	(fn matches_number
		(params (json (shared-slice u8)) (node JsonNode) (parent i32) (key (shared-slice u8)) (expected u32))
		(returns bool)
		(body
			(if (bool.not (bool.and (u32.eq (record.get (local node) kind) (u32 4))
					(call matches_key (borrow-shared (local json)) (local node) (local parent) (borrow-shared (local key)))))
				(then (return (bool false))))
			(let number (call read_decimal_digits (borrow-shared (local json))
				(record.get (local node) start) (record.get (local node) end) (u32 429496729) (u32 5)))
			(return (bool.and (bool.not (i32.lt (record.get (local number) digits) (i32 0)))
				(u32.eq (record.get (local number) magnitude) (local expected))))))

	(fn matches_text
		(params (json (shared-slice u8)) (node JsonNode) (parent i32)
			(key (shared-slice u8)) (expected (shared-slice u8)))
		(returns bool)
		(body
			(if (bool.not (bool.and (u32.eq (record.get (local node) kind) (u32 3))
					(call matches_key (borrow-shared (local json)) (local node) (local parent) (borrow-shared (local key)))))
				(then (return (bool false))))
			(let length (slice.len (local expected)))
			(let-mut decoded (array.alloc u8 (local length)))
			(let text (call json_decode_string (borrow-shared (local json))
				(record.get (local node) start) (record.get (local node) end) (borrow-mut (local decoded))))
			(return (bool.and (u32.eq (record.get (local text) error) (u32 0))
				(bool.and (i32.eq (record.get (local text) written) (local length))
					(call same_bytes (borrow-shared (local decoded)) (i32 0) (local length)
						(borrow-shared (local expected)) (i32 0) (local length)))))))

	(fn matches_common
		(params (json (shared-slice u8)) (nodes (shared-slice JsonNode)) (text (shared-slice u8))
			(message (shared-slice u8)) (code u32))
		(returns bool)
		(body
			(let root (slice.load (local nodes) (i32 0)))
			(let location (slice.load (local nodes) (i32 3)))
			(if (bool.not (bool.and (u32.eq (record.get (local root) kind) (u32 1))
					(u32.eq (record.get (local location) kind) (u32 1))))
				(then (return (bool false))))
			(if (bool.not (call matches_key (borrow-shared (local json)) (local location) (i32 0)
					(borrow-shared (slice.range (local text) (i32 11) (i32 19)))))
				(then (return (bool false))))
			(if (bool.not (call matches_number (borrow-shared (local json)) (slice.load (local nodes) (i32 1)) (i32 0)
					(borrow-shared (slice.range (local text) (i32 0) (i32 4))) (local code)))
				(then (return (bool false))))
			(return (call matches_text (borrow-shared (local json)) (slice.load (local nodes) (i32 2)) (i32 0)
				(borrow-shared (slice.range (local text) (i32 4) (i32 11))) (borrow-shared (local message))))))

	(fn fixture_node
		(params (nodes (shared-slice JsonNode)) (index i32))
		(returns JsonNode)
		(body (return (slice.load (local nodes) (local index)))))

	(fn matches_source
		(params (json (shared-slice u8)) (text (shared-slice u8)))
		(returns bool)
		(body
			(let-mut nodes (array.alloc JsonNode (i32 8)))
			(let parsed (call json_parse (borrow-shared (local json)) (borrow-mut (local nodes))))
			(if (bool.not (bool.and (u32.eq (record.get (local parsed) error) (u32 0))
					(i32.eq (record.get (local parsed) rows) (i32 8))))
				(then (return (bool false))))
			(if (bool.not (call matches_common (borrow-shared (local json)) (borrow-shared (local nodes))
					(borrow-shared (local text)) (borrow-shared (slice.range (local text) (i32 50) (i32 63))) (u32 4294967295)))
				(then (return (bool false))))
			(if (bool.not (call matches_text (borrow-shared (local json)) (call fixture_node (borrow-shared (local nodes)) (i32 4)) (i32 3)
					(borrow-shared (slice.range (local text) (i32 19) (i32 23))) (borrow-shared (slice.range (local text) (i32 23) (i32 29)))))
				(then (return (bool false))))
			(if (bool.not (call matches_text (borrow-shared (local json)) (call fixture_node (borrow-shared (local nodes)) (i32 5)) (i32 3)
					(borrow-shared (slice.range (local text) (i32 33) (i32 37))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))))
				(then (return (bool false))))
			(return (bool.and
				(call matches_number (borrow-shared (local json)) (call fixture_node (borrow-shared (local nodes)) (i32 6)) (i32 3)
					(borrow-shared (slice.range (local text) (i32 37) (i32 42))) (u32 3))
				(call matches_number (borrow-shared (local json)) (call fixture_node (borrow-shared (local nodes)) (i32 7)) (i32 3)
					(borrow-shared (slice.range (local text) (i32 42) (i32 45))) (u32 19))))))

	(fn matches_argv
		(params (json (shared-slice u8)) (text (shared-slice u8)))
		(returns bool)
		(body
			(let-mut nodes (array.alloc JsonNode (i32 6)))
			(let parsed (call json_parse (borrow-shared (local json)) (borrow-mut (local nodes))))
			(if (bool.not (bool.and (u32.eq (record.get (local parsed) error) (u32 0))
					(i32.eq (record.get (local parsed) rows) (i32 6))))
				(then (return (bool false))))
			(if (bool.not (call matches_common (borrow-shared (local json)) (borrow-shared (local nodes))
					(borrow-shared (local text)) (borrow-shared (slice.range (local text) (i32 74) (i32 88))) (u32 7)))
				(then (return (bool false))))
			(return (bool.and
				(call matches_text (borrow-shared (local json)) (call fixture_node (borrow-shared (local nodes)) (i32 4)) (i32 3)
					(borrow-shared (slice.range (local text) (i32 19) (i32 23))) (borrow-shared (slice.range (local text) (i32 29) (i32 33))))
				(call matches_number (borrow-shared (local json)) (call fixture_node (borrow-shared (local nodes)) (i32 5)) (i32 3)
					(borrow-shared (slice.range (local text) (i32 45) (i32 50))) (u32 0))))))

	(fn check_source_capacity
		(params (diagnostic Diagnostic) (text (shared-slice u8)) (reference (shared-slice u8)) (stack (mut-slice u8)))
		(returns i32)
		(body
			(let size (slice.len (local reference)))
			(let-mut exact (array.alloc u8 (local size)))
			(let exact_result (call write_diagnostic_json (local diagnostic)
				(borrow-shared (slice.range (local text) (i32 50) (i32 63))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))
				(borrow-mut (local exact)) (borrow-mut (local stack))))
			(if (bool.not (bool.and (u32.eq (record.get (local exact_result) error) (u32 0))
					(i32.eq (record.get (local exact_result) written) (local size))))
				(then (return (i32 5))))
			(if (bool.not (call same_bytes (borrow-shared (local exact)) (i32 0) (local size)
					(borrow-shared (local reference)) (i32 0) (local size)))
				(then (return (i32 6))))
			(let-mut short (array.alloc u8 (i32.sub.wrapping (local size) (i32 1))))
			(let short_result (call write_diagnostic_json (local diagnostic)
				(borrow-shared (slice.range (local text) (i32 50) (i32 63))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))
				(borrow-mut (local short)) (borrow-mut (local stack))))
			(if (bool.not (u32.eq (record.get (local short_result) error) (u32 1))) (then (return (i32 7))))
			(let-mut empty (array.alloc u8 (i32 0)))
			(let empty_result (call write_diagnostic_json (local diagnostic)
				(borrow-shared (slice.range (local text) (i32 50) (i32 63))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))
				(borrow-mut (local empty)) (borrow-mut (local stack))))
			(if (bool.not (bool.and (u32.eq (record.get (local empty_result) error) (u32 1))
					(i32.eq (record.get (local empty_result) written) (i32 0))))
				(then (return (i32 8))))
			(return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut text (array.alloc u8 (i32 89)))
			(call fill_fixture_text (borrow-mut (local text)))
			(let-mut output (array.alloc u8 (i32 256)))
			(let-mut stack (array.alloc u8 (i32 2)))
			(let source (call diagnostic_source (u32 4294967295) (i32 3) (i32 19)))
			(let source_result (call write_diagnostic_json (local source)
				(borrow-shared (slice.range (local text) (i32 50) (i32 63))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if (bool.not (u32.eq (record.get (local source_result) error) (u32 0))) (then (return (i32 1))))
			(let size (record.get (local source_result) written))
			(if (bool.not (call matches_source (borrow-shared (slice.range (local output) (i32 0) (local size)))
					(borrow-shared (local text))))
				(then (return (i32 2))))
			(let capacity (call check_source_capacity (local source) (borrow-shared (local text))
				(borrow-shared (slice.range (local output) (i32 0) (local size))) (borrow-mut (local stack))))
			(if (bool.not (i32.eq (local capacity) (i32 0))) (then (return (local capacity))))
			(let argument (call diagnostic_argv (u32 7) (i32 0)))
			(let argument_result (call write_diagnostic_json (local argument)
				(borrow-shared (slice.range (local text) (i32 74) (i32 88))) (borrow-shared (slice.range (local text) (i32 88) (i32 89)))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if (bool.not (u32.eq (record.get (local argument_result) error) (u32 0))) (then (return (i32 3))))
			(if (bool.not (call matches_argv
					(borrow-shared (slice.range (local output) (i32 0) (record.get (local argument_result) written)))
					(borrow-shared (local text))))
				(then (return (i32 4))))
			(let-mut shallow (array.alloc u8 (i32 1)))
			(let nesting (call write_diagnostic_json (local source)
				(borrow-shared (slice.range (local text) (i32 50) (i32 63))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))
				(borrow-mut (local output)) (borrow-mut (local shallow))))
			(if (bool.not (u32.eq (record.get (local nesting) error) (u32 2))) (then (return (i32 9))))
			(let bad_text (call write_diagnostic_json (local source)
				(borrow-shared (slice.range (local text) (i32 88) (i32 89))) (borrow-shared (slice.range (local text) (i32 63) (i32 74)))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if (bool.not (u32.eq (record.get (local bad_text) error) (u32 4))) (then (return (i32 10))))
			(let bad_file (call write_diagnostic_json (local source)
				(borrow-shared (slice.range (local text) (i32 50) (i32 63))) (borrow-shared (slice.range (local text) (i32 88) (i32 89)))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if (bool.not (u32.eq (record.get (local bad_file) error) (u32 4))) (then (return (i32 11))))
			(let bad (record.make Diagnostic (code (u32 7)) (location (u32 0))
				(start (i32 -1)) (end (i32 -1)) (argv_index (i32 -1))))
			(let bad_tag (call write_diagnostic_json (local bad)
				(borrow-shared (slice.range (local text) (i32 88) (i32 89))) (borrow-shared (slice.range (local text) (i32 88) (i32 89)))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if (bool.not (bool.and (u32.eq (record.get (local bad_tag) error) (u32 3))
					(i32.eq (record.get (local bad_tag) written) (i32 0))))
				(then (return (i32 12))))
			(return (i32 0)))))
