	(use wove-file "../../../stage-2/diagnostics/record.wove" (only (type Diagnostic) diagnostic_source diagnostic_argv))
	(use wove-file "../../../stage-2/diagnostics/json.wove" (only write_diagnostic_json))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode) json_parse json_decode_string))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))
	(use wove-file "../../../stage-2/text/decimal.wove" (only read_decimal_digits))

	(fn fill_fixture_text
		(params (bytes (mut-array u8)))
		(returns void)
		(body
			(array:set (:doc "code") bytes (i32 0) (u8 99))
			(array:set bytes (i32 1) (u8 111))
			(array:set bytes (i32 2) (u8 100))
			(array:set bytes (i32 3) (u8 101))
			(array:set (:doc "message") bytes (i32 4) (u8 109))
			(array:set bytes (i32 5) (u8 101))
			(array:set bytes (i32 6) (u8 115))
			(array:set bytes (i32 7) (u8 115))
			(array:set bytes (i32 8) (u8 97))
			(array:set bytes (i32 9) (u8 103))
			(array:set bytes (i32 10) (u8 101))
			(array:set (:doc "location") bytes (i32 11) (u8 108))
			(array:set bytes (i32 12) (u8 111))
			(array:set bytes (i32 13) (u8 99))
			(array:set bytes (i32 14) (u8 97))
			(array:set bytes (i32 15) (u8 116))
			(array:set bytes (i32 16) (u8 105))
			(array:set bytes (i32 17) (u8 111))
			(array:set bytes (i32 18) (u8 110))
			(array:set (:doc "kind") bytes (i32 19) (u8 107))
			(array:set bytes (i32 20) (u8 105))
			(array:set bytes (i32 21) (u8 110))
			(array:set bytes (i32 22) (u8 100))
			(array:set (:doc "source") bytes (i32 23) (u8 115))
			(array:set bytes (i32 24) (u8 111))
			(array:set bytes (i32 25) (u8 117))
			(array:set bytes (i32 26) (u8 114))
			(array:set bytes (i32 27) (u8 99))
			(array:set bytes (i32 28) (u8 101))
			(array:set (:doc "argv") bytes (i32 29) (u8 97))
			(array:set bytes (i32 30) (u8 114))
			(array:set bytes (i32 31) (u8 103))
			(array:set bytes (i32 32) (u8 118))
			(array:set (:doc "file") bytes (i32 33) (u8 102))
			(array:set bytes (i32 34) (u8 105))
			(array:set bytes (i32 35) (u8 108))
			(array:set bytes (i32 36) (u8 101))
			(array:set (:doc "start") bytes (i32 37) (u8 115))
			(array:set bytes (i32 38) (u8 116))
			(array:set bytes (i32 39) (u8 97))
			(array:set bytes (i32 40) (u8 114))
			(array:set bytes (i32 41) (u8 116))
			(array:set (:doc "end") bytes (i32 42) (u8 101))
			(array:set bytes (i32 43) (u8 110))
			(array:set bytes (i32 44) (u8 100))
			(array:set (:doc "index") bytes (i32 45) (u8 105))
			(array:set bytes (i32 46) (u8 110))
			(array:set bytes (i32 47) (u8 100))
			(array:set bytes (i32 48) (u8 101))
			(array:set bytes (i32 49) (u8 120))
			(array:set (:doc "source_message") bytes (i32 50) (u8 98))
			(array:set bytes (i32 51) (u8 97))
			(array:set bytes (i32 52) (u8 100))
			(array:set bytes (i32 53) (u8 32))
			(array:set bytes (i32 54) (u8 34))
			(array:set bytes (i32 55) (u8 110))
			(array:set bytes (i32 56) (u8 97))
			(array:set bytes (i32 57) (u8 109))
			(array:set bytes (i32 58) (u8 101))
			(array:set bytes (i32 59) (u8 34))
			(array:set bytes (i32 60) (u8 10))
			(array:set bytes (i32 61) (u8 195))
			(array:set bytes (i32 62) (u8 169))
			(array:set (:doc "source_name") bytes (i32 63) (u8 115))
			(array:set bytes (i32 64) (u8 114))
			(array:set bytes (i32 65) (u8 99))
			(array:set bytes (i32 66) (u8 47))
			(array:set bytes (i32 67) (u8 195))
			(array:set bytes (i32 68) (u8 169))
			(array:set bytes (i32 69) (u8 46))
			(array:set bytes (i32 70) (u8 119))
			(array:set bytes (i32 71) (u8 111))
			(array:set bytes (i32 72) (u8 118))
			(array:set bytes (i32 73) (u8 101))
			(array:set (:doc "argument_message") bytes (i32 74) (u8 117))
