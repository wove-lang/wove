(module c_name_body
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only absolute))
	(bridge c-header "<stdlib.h>"
		(fn absolute
			(returns i32)
			(c-name "abs")
			(:doc "A C bridge declaration must be bodyless.")
			(body (return 0i32))
			(params (value i32))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (call absolute -42i32)))))
