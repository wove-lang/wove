(module native_alias_convert_char
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type Char)))

	(fn main (params) (returns i32)
		(body
			(let native (int.convert Char (i32 -1)))
			(return (i32.add.wrapping (int.convert i32 (local native)) (i32 43))))))
