(module native_alias_adapted_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only wide_text_count check_count))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let text (array.alloc u8 (i32 0)))
			(let count (call wide_text_count (borrow-shared (local text))))
			(return (call check_count (local count))))))
