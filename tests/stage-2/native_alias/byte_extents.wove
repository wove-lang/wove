(module native_alias_byte_extents
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h"
		(only (type Size) distinct_count check_byte_count check_byte_product))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let empty (array.alloc u8 (i32 0)))
			(let data (array.alloc u8 (i32 1)))
			(let max (int.convert Size (call distinct_count)))
			(let zero (int.convert Size (i32 0)))
			(let left (call check_byte_product (borrow-shared empty) max zero))
			(let right (call check_byte_product (borrow-shared empty) zero max))
			(let result (call check_byte_count (borrow-shared data) (int.convert Size (u32 1))))
			(return (i32.add result (i32.add left right))))))
