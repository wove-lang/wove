(module native_alias_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type (as Size Count)) wide_count check_count))

	(fn forward (params (value Count)) (returns Count)
		(body (let copied (local value)) (return (local copied))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut value (call wide_count))
			(set (local value) (call forward (local value)))
			(return (call check_count (local value))))))
