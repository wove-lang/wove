(module c_name_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only (as absolute-value absolute) parse))

	(bridge c-header "<stdlib.h>"
		(fn absolute-value (c-name "abs") (params (value i32)) (returns i32))
		(fn parse (:pragma (c_cstr bytes)) (c-name "atoi")
			(params (bytes (shared-slice u8))) (returns i32)))

	(fn main (params) (returns i32)
		(body
			(let-mut digits (array.alloc u8 (i32 2)))
			(slice.store (local digits) (i32 0) (u8 50))
			(slice.store (local digits) (i32 1) (u8 57))
			(return (i32.add.wrapping (call absolute (i32 -13)) (call parse (borrow-shared (local digits))))))))
