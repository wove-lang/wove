(module c_name_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only (as absolute-value absolute) parse))

	(bridge c-header "<stdlib.h>"
		(fn absolute-value (returns i32) (params (value i32)) (c-name "abs"))
		(fn parse (returns i32) (c-name "atoi")
			(params (bytes (shared-array u8))) (:pragma (c_cstr bytes))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut digits (array.alloc u8 (i32 2)))
			(array.store (local digits) (i32 0) (u8 50))
			(array.store (local digits) (i32 1) (u8 57))
			(return (i32.add (call absolute (i32 -13)) (call parse (borrow-shared (local digits))))))))
