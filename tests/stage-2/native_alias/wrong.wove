	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type Size) (type Other) distinct_count check_count))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (let wrong (call distinct_count)) (return (call check_count (local wrong))))))
