(module native_alias_extent_negative
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type Size) (type SignedSize) check_signed_product))

	(fn main (params) (returns i32)
		(body
			(let data (array.alloc u8 (i32 0)))
			(let size (int.convert SignedSize (i32 -1)))
			(return (call check_signed_product (borrow-shared (local data)) (local size) (int.convert Size (i32 0)))))))
