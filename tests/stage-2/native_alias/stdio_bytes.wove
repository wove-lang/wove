(module native_alias_stdio_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type (as Size ByteCount)) (type Long) tmpfile fread fwrite fseek))

	(fn fill (params (data (mut-slice u8))) (returns void)
		(body (slice.store (local data) (i32 1) (u8 42))))

	(fn read_back (params (data (shared-slice u8))) (returns i32)
		(body (return (int.convert i32 (slice.load (local data) (i32 1))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 2)))
			(call fill (borrow-mut (local data)))
			(let stream (call tmpfile))
			(let unit (int.convert ByteCount (u8 1)))
			(let count (int.convert ByteCount (u32 2)))
			(let written (int.convert i32
				(call fwrite (borrow-shared (local data)) (local unit) (local count) (borrow-shared (local stream)))))
			(let reset (call fseek (borrow-shared (local stream)) (int.convert Long (i32 0)) (i32 0)))
			(let-mut output (array.alloc u8 (i32 2)))
			(let read (int.convert u32
				(call fread (borrow-mut (local output)) (local unit) (local count) (borrow-shared (local stream)))))
			(if (bool.and (i32.eq (local written) (i32 2))
					(bool.and (i32.eq (local reset) (i32 0)) (u32.eq (local read) (u32 2))))
				(then (return (call read_back (borrow-shared (local output))))))
			(return (i32 1)))))
