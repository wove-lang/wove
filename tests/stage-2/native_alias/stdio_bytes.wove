(module native_alias_stdio_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type (as Size ByteCount)) (type Long) tmpfile fread fwrite fseek))

	(fn fill (params (data (mut-array u8))) (returns void)
		(body (array:store data (i32 1) (u8 42))))

	(fn read_back (params (data (shared-array u8))) (returns i32)
		(body (return (int:convert i32 (array:load data (i32 1))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 (i32 2)))
			(call fill (borrow-mut data))
			(let stream (call tmpfile))
			(let unit (int:convert ByteCount (u8 1)))
			(let count (int:convert ByteCount (u32 2)))
			(let written (int:convert i32
				(call fwrite (borrow-shared data) unit count (borrow-shared stream))))
			(let reset (call fseek (borrow-shared stream) (int:convert Long (i32 0)) (i32 0)))
			(let-mut output (array:alloc u8 (i32 2)))
			(let read (int:convert u32
				(call fread (borrow-mut output) unit count (borrow-shared stream))))
			(if (bool:and (i32:eq written (i32 2))
					(bool:and (i32:eq reset (i32 0)) (u32:eq read (u32 2))))
				(then (return (call read_back (borrow-shared output)))))
			(return (i32 1)))))
