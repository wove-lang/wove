(module native_corpus_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type (as Size ByteCount)) tmpfile ftell fseek))

	(fn retain_size (params (value ByteCount)) (returns ByteCount)
		(body (let copied (local value)) (return (local copied))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let stream (call tmpfile))
			(let position (call ftell (borrow-shared (local stream))))
			(let status (call fseek (borrow-shared (local stream)) (local position) (i32 0)))
			(return (i32.add.wrapping (local status) (i32 42))))))
