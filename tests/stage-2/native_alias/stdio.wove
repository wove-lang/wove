(module native_corpus_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type (as Size ByteCount)) tmpfile ftell fseek))

	(fn retain_size (params (value ByteCount)) (returns ByteCount)
		(body (let copied value) (return copied)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call tmpfile))
			(let position (call ftell (borrow-shared stream)))
			(let status (call fseek (borrow-shared stream) position (i32 0)))
			(return (i32:add status (i32 42))))))
