(module native_alias_extent_oversized
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only wide_count check_byte_count))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let data (array.alloc u8 (i32 1)))
			(return (call check_byte_count (borrow-shared data) (call wide_count))))))
