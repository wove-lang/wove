(module native_alias_extent_overflow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./native_alias.h" (only (type Size) wide_count check_byte_product))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let data (array.alloc u8 (i32 1)))
			(return (call check_byte_product (borrow-shared (local data)) (call wide_count) (int.convert Size (u8 2)))))))
