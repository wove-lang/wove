(module native_alias_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./native_alias.h"
		(type Size (c-type "size_t"))
		(type Other (c-type "size_t"))
		(fn wide_count (params) (returns Size))
		(fn distinct_count (params) (returns Other))
		(fn check_count (params (value Size)) (returns i32))
		(fn wide_text_count
			(:pragma (c_cstr text))
			(params (text (shared-array u8))) (returns Size))
		(type Broken (c-type "size_t /"))
		(type SignedSize (c-type "long"))
		(fn check_byte_count
			(:pragma (c_bytes data count))
			(params (data (shared-array u8)) (count Size)) (returns i32))
		(fn check_byte_product
			(:pragma (c_bytes data size count))
			(params (data (shared-array u8)) (size Size) (count Size)) (returns i32))
		(fn check_signed_product
			(:pragma (c_bytes data size count))
			(params (data (shared-array u8)) (size SignedSize) (count Size)) (returns i32))))
