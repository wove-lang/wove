(module compare
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./compare.wove" (only (type Row)))

	(fn before (params (a Row) (b Row)) (returns bool)
		(body (return (i32.gt (struct.get (local a) key) (struct.get (local b) key)))))
)
