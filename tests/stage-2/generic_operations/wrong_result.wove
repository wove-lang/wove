(module generic_operation_wrong_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./compare.wove" (only (type Row) wrong_result))
	(use wove-file "./merge.wove" (only choose))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let a (struct.new Row (key 1i32) (payload 42i32)))
			(let chosen (call (specialize choose Row wrong_result) a a))
			(return (struct.get chosen payload))))
)
