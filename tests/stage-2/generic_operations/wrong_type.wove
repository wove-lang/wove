(module generic_operation_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./compare.wove" (only (type Row) wrong))
	(use wove-file "./merge.wove" (only choose))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let a (struct.new Row (key 1i32) (payload 42i32)))
			(let chosen (call (specialize choose Row wrong) (local a) (local a)))
			(return (struct.get (local chosen) payload))))
)
