(module record_sort
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./compare.wove" (only (type (as Row Entry)) (as before ascending) (as before lower)))
	(use wove-file "./reverse.wove" (only (as before descending)))
	(use wove-file "./merge.wove" (only choose sort_pass))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let a (struct:new Entry (key 1i32) (payload 17i32)))
			(let b (struct:new Entry (key 2i32) (payload 7i32)))
			(let c (struct:new Entry (key 1i32) (payload 25i32)))
			(let d (struct:new Entry (key 3i32) (payload 9i32)))
			(let-mut input (array:alloc Entry 4i32))
			(array:set input 0i32 a)
			(array:set input 1i32 b)
			(array:set input 2i32 c)
			(array:set input 3i32 d)
			(let-mut result (array:alloc Entry 4i32))
			(call (specialize sort_pass Entry ascending) (borrow-shared input) (borrow-mut result))
			(if (i32:not-eq (struct:get (array:get result 0i32) payload) 17i32) (then (return 1i32)))
			(if (i32:not-eq (struct:get (array:get result 1i32) payload) 25i32) (then (return 2i32)))
			(if (i32:not-eq (struct:get (array:get result 2i32) payload) 7i32) (then (return 3i32)))
			(if (i32:not-eq (struct:get (array:get result 3i32) payload) 9i32) (then (return 4i32)))
			(call (specialize sort_pass Entry lower) (borrow-shared input) (borrow-mut result))
			(let first (call (specialize choose Entry ascending) a b))
			(let alias (call (specialize choose Entry lower) a b))
			(let reverse (call (specialize choose Entry descending) a b))
			(if (i32:not-eq (struct:get first payload) 17i32) (then (return 5i32)))
			(if (i32:not-eq (struct:get alias payload) 17i32) (then (return 6i32)))
			(if (i32:not-eq (struct:get reverse payload) 7i32) (then (return 7i32)))
			(return (i32:add (struct:get (array:get result 0i32) payload)
				(struct:get (array:get result 1i32) payload)))))
)
