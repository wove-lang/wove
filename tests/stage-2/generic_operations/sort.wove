(module record_sort
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./compare.wove" (only (type (as Row Entry)) (as before ascending) (as before lower)))
	(use wove-file "./reverse.wove" (only (as before descending)))
	(use wove-file "./merge.wove" (only choose sort_pass))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let a (struct.new Entry (key 1i32) (payload 17i32)))
			(let b (struct.new Entry (key 2i32) (payload 7i32)))
			(let c (struct.new Entry (key 1i32) (payload 25i32)))
			(let d (struct.new Entry (key 3i32) (payload 9i32)))
			(let-mut input (array.alloc Entry 4i32))
			(array.store (local input) 0i32 (local a))
			(array.store (local input) 1i32 (local b))
			(array.store (local input) 2i32 (local c))
			(array.store (local input) 3i32 (local d))
			(let-mut result (array.alloc Entry 4i32))
			(call (specialize sort_pass Entry ascending) (borrow-shared (local input)) (borrow-mut (local result)))
			(if (i32.not-eq (struct.get (array.load (local result) 0i32) payload) 17i32) (then (return 1i32)))
			(if (i32.not-eq (struct.get (array.load (local result) 1i32) payload) 25i32) (then (return 2i32)))
			(if (i32.not-eq (struct.get (array.load (local result) 2i32) payload) 7i32) (then (return 3i32)))
			(if (i32.not-eq (struct.get (array.load (local result) 3i32) payload) 9i32) (then (return 4i32)))
			(call (specialize sort_pass Entry lower) (borrow-shared (local input)) (borrow-mut (local result)))
			(let first (call (specialize choose Entry ascending) (local a) (local b)))
			(let alias (call (specialize choose Entry lower) (local a) (local b)))
			(let reverse (call (specialize choose Entry descending) (local a) (local b)))
			(if (i32.not-eq (struct.get (local first) payload) 17i32) (then (return 5i32)))
			(if (i32.not-eq (struct.get (local alias) payload) 17i32) (then (return 6i32)))
			(if (i32.not-eq (struct.get (local reverse) payload) 7i32) (then (return 7i32)))
			(return (i32.add (struct.get (array.load (local result) 0i32) payload)
				(struct.get (array.load (local result) 1i32) payload)))))
)
