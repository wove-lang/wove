(module generic_operation_template
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn identity (generic (type T)) (params (value T)) (returns T)
		(body (return (local value))))

	(fn apply (generic (fn F)) (params) (returns i32)
		(body (return (call F 42i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call (specialize apply identity)))))
)
