(module generic_operation_foreign
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only putchar))

	(fn apply (generic (fn Emit)) (params) (returns i32)
		(body (return (call Emit 42i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call (specialize apply putchar)))))
)
