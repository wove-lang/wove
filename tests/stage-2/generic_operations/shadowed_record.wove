(module generic_operation_shadowed_record
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Operation (generic (type T)) (fields (value T)))

	(fn selected (params) (returns i32)
		(body (return 42i32)))

	(fn apply (generic (fn Operation)) (params) (returns i32)
		(body
			(let result (struct:new (specialize Operation i32) (value 7i32)))
			(return (struct:get result value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call (specialize apply selected)))))
)
