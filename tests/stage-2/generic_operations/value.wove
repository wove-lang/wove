(module generic_operation_as_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(let Operation 19i32)

	(fn example (params) (returns i32)
		(body (return 42i32)))

	(fn apply (generic (fn Operation)) (params) (returns i32)
		(body (return (local Operation))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call (specialize apply example)))))
)
