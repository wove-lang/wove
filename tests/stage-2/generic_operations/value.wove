(module generic_operation_as_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(let Operation 19i32)

	(fn example (params) (returns i32)
		(body (return 42i32)))

	(fn apply (generic (fn Operation)) (params) (returns i32)
		(body (return (local Operation))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call (specialize apply example)))))
)
