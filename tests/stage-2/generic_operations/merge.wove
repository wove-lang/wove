(module merge
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn choose (generic (type T) (fn Before)) (params (left T) (right T)) (returns T)
		(body
			(return (if (call Before (local right) (local left))
				(then (local right))
				(else (local left))))))

	(fn merge_runs (generic (type T) (fn Before))
		(params (input (shared-array T)) (output (mut-array T))) (returns void)
		(body
			(let-mut left 0i32)
			(let-mut right 2i32)
			(let-mut index 0i32)
			(while (bool.and (i32.lt (local left) 2i32) (i32.lt (local right) 4i32))
				(body
					(let a (array.load (local input) (local left)))
					(let b (array.load (local input) (local right)))
					(if (call Before (local b) (local a))
						(then
							(array.store (local output) (local index) (local b))
							(set (local right) (i32.inc (local right))))
						(else
							(array.store (local output) (local index) (local a))
							(set (local left) (i32.inc (local left)))))
					(set (local index) (i32.inc (local index)))))
			(while (i32.lt (local left) 2i32)
				(body
					(array.store (local output) (local index) (array.load (local input) (local left)))
					(set (local left) (i32.inc (local left)))
					(set (local index) (i32.inc (local index)))))
			(while (i32.lt (local right) 4i32)
				(body
					(array.store (local output) (local index) (array.load (local input) (local right)))
					(set (local right) (i32.inc (local right)))
					(set (local index) (i32.inc (local index)))))))

	(fn sort_pass (generic (type T) (fn Before))
		(params (input (shared-array T)) (output (mut-array T))) (returns void)
		(body
			(call (specialize merge_runs T Before) (borrow-shared (local input)) (borrow-mut (local output)))))
)
