(module merge
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn choose (generic (type T) (fn Before)) (params (left T) (right T)) (returns T)
		(body
			(return (if (call Before right left)
				(then right)
				(else left)))))

	(fn merge_runs (generic (type T) (fn Before))
		(params (input (shared-array T)) (output (mut-array T))) (returns void)
		(body
			(let-mut left 0i32)
			(let-mut right 2i32)
			(let-mut index 0i32)
			(while (bool.and (i32.lt left 2i32) (i32.lt right 4i32))
				(body
					(let a (array.load input left))
					(let b (array.load input right))
					(if (call Before b a)
						(then
							(array.store output index b)
							(set right (i32.inc right)))
						(else
							(array.store output index a)
							(set left (i32.inc left))))
					(set index (i32.inc index))))
			(while (i32.lt left 2i32)
				(body
					(array.store output index (array.load input left))
					(set left (i32.inc left))
					(set index (i32.inc index))))
			(while (i32.lt right 4i32)
				(body
					(array.store output index (array.load input right))
					(set right (i32.inc right))
					(set index (i32.inc index))))))

	(fn sort_pass (generic (type T) (fn Before))
		(params (input (shared-array T)) (output (mut-array T))) (returns void)
		(body
			(call (specialize merge_runs T Before) (borrow-shared input) (borrow-mut output))))
)
