(module compare
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Row (fields (key i32) (payload i32)))
	(struct Other (fields (key i32) (payload i32)))

	(fn before (params (a Row) (b Row)) (returns bool)
		(body (return (i32.lt (struct.get (local a) key) (struct.get (local b) key)))))

	(fn wrong (params (a Other) (b Other)) (returns bool)
		(body (return (i32.lt (struct.get (local a) key) (struct.get (local b) key)))))

	(fn wrong_result (params (a Row) (b Row)) (returns i32)
		(body (return (i32.sub (struct.get (local a) key) (struct.get (local b) key)))))
)
