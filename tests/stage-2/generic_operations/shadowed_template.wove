(module generic_operation_shadowed_template
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn Operation (generic (type T)) (params) (returns i32)
		(body (return 7i32)))

	(fn selected (params) (returns i32)
		(body (return 42i32)))

	(fn apply (generic (fn Operation)) (params) (returns i32)
		(body (return (call (specialize Operation i32)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call (specialize apply selected)))))
)
