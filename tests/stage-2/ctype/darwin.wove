(module ctype_darwin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<ctype.h>" (only
		digittoint ishexnumber isideogram isnumber isphonogram isrune isspecial (type CTypeRune) (type Rune)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let character (int.convert CTypeRune 65i32))
			(let rune (int.convert Rune 65i32))
			(if (i32.not-eq (call digittoint 102i32) 15i32) (then (return 1i32)))
			(if (i32.not-eq (call isideogram 65i32) 0i32) (then (return 2i32)))
			(if (i32.not-eq (call isphonogram 65i32) 0i32) (then (return 3i32)))
			(if (i32.not-eq (call isspecial 65i32) 0i32) (then (return 4i32)))
			(if (i32.eq (call ishexnumber 102i32) 0i32) (then (return 5i32)))
			(if (i32.eq (call isnumber 55i32) 0i32) (then (return 6i32)))
			(if (i32.eq (call isrune (int.convert i32 rune)) 0i32) (then (return 7i32)))
			(if (i32.not-eq (int.convert i32 character) 65i32) (then (return 8i32)))
			(return 42i32))))
