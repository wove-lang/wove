(module ctype_linux
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<ctype.h>" (only
		isctype _ISupper _ISlower _ISalpha _ISdigit _ISxdigit _ISspace
		_ISprint _ISgraph _ISblank _IScntrl _ISpunct _ISalnum))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eq (call isctype 65i32 _ISupper) 0i32) (then (return 1i32)))
			(if (i32.eq (call isctype 122i32 _ISlower) 0i32) (then (return 2i32)))
			(if (i32.eq (call isctype 66i32 _ISalpha) 0i32) (then (return 3i32)))
			(if (i32.eq (call isctype 55i32 _ISdigit) 0i32) (then (return 4i32)))
			(if (i32.eq (call isctype 102i32 _ISxdigit) 0i32) (then (return 5i32)))
			(if (i32.eq (call isctype 10i32 _ISspace) 0i32) (then (return 6i32)))
			(if (i32.eq (call isctype 32i32 _ISprint) 0i32) (then (return 7i32)))
			(if (i32.eq (call isctype 44i32 _ISgraph) 0i32) (then (return 8i32)))
			(if (i32.eq (call isctype 9i32 _ISblank) 0i32) (then (return 9i32)))
			(if (i32.eq (call isctype 1i32 _IScntrl) 0i32) (then (return 10i32)))
			(if (i32.eq (call isctype 33i32 _ISpunct) 0i32) (then (return 11i32)))
			(if (i32.eq (call isctype 57i32 _ISalnum) 0i32) (then (return 12i32)))
			(if (i32.not-eq (call isctype 65i32 _ISdigit) 0i32) (then (return 13i32)))
			(return 42i32))))
