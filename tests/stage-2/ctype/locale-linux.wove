(module ctype_locale_linux
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<ctype.h>" (only
		isalnum_l isalpha_l isblank_l iscntrl_l isdigit_l isgraph_l
		islower_l isprint_l ispunct_l isspace_l isupper_l isxdigit_l
		tolower_l toupper_l))
	(use c-header "<locale.h>" (only newlocale (value LC_CTYPE_MASK)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(let c_locale "C")
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let locale (call newlocale LC_CTYPE_MASK (borrow-shared c_locale)))
			(if (owner.is-null locale) (then (return 1i32)))
			(if (i32.eqz (call isalnum_l 65i32 (borrow-shared locale))) (then (return 2i32)))
			(if (i32.eqz (call isalpha_l 65i32 (borrow-shared locale))) (then (return 3i32)))
			(if (i32.eqz (call isblank_l 32i32 (borrow-shared locale))) (then (return 4i32)))
			(if (i32.eqz (call iscntrl_l 10i32 (borrow-shared locale))) (then (return 5i32)))
			(if (i32.eqz (call isdigit_l 57i32 (borrow-shared locale))) (then (return 6i32)))
			(if (i32.eqz (call isgraph_l 33i32 (borrow-shared locale))) (then (return 7i32)))
			(if (i32.eqz (call islower_l 97i32 (borrow-shared locale))) (then (return 8i32)))
			(if (i32.eqz (call isprint_l 32i32 (borrow-shared locale))) (then (return 9i32)))
			(if (i32.eqz (call ispunct_l 33i32 (borrow-shared locale))) (then (return 10i32)))
			(if (i32.eqz (call isspace_l 9i32 (borrow-shared locale))) (then (return 11i32)))
			(if (i32.eqz (call isupper_l 65i32 (borrow-shared locale))) (then (return 12i32)))
			(if (i32.eqz (call isxdigit_l 70i32 (borrow-shared locale))) (then (return 13i32)))
			(if (i32.not-eq (call tolower_l 65i32 (borrow-shared locale)) 97i32) (then (return 14i32)))
			(if (i32.not-eq (call toupper_l 97i32 (borrow-shared locale)) 65i32) (then (return 15i32)))
			(return 42i32))))
