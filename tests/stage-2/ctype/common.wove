(module ctype_common
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<ctype.h>" (only
		isalnum isalpha isblank iscntrl isdigit isgraph islower isprint ispunct isspace
		isupper isxdigit tolower toupper isascii toascii _tolower _toupper))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (i32.eq (call isalnum 48i32) 0i32) (then (return 1i32)))
			(if (i32.eq (call isalpha 65i32) 0i32) (then (return 2i32)))
			(if (i32.eq (call isblank 9i32) 0i32) (then (return 3i32)))
			(if (i32.eq (call iscntrl 1i32) 0i32) (then (return 4i32)))
			(if (i32.eq (call isdigit 55i32) 0i32) (then (return 5i32)))
			(if (i32.eq (call isgraph 33i32) 0i32) (then (return 6i32)))
			(if (i32.eq (call islower 122i32) 0i32) (then (return 7i32)))
			(if (i32.eq (call isprint 32i32) 0i32) (then (return 8i32)))
			(if (i32.eq (call ispunct 46i32) 0i32) (then (return 9i32)))
			(if (i32.eq (call isspace 10i32) 0i32) (then (return 10i32)))
			(if (i32.eq (call isupper 65i32) 0i32) (then (return 11i32)))
			(if (i32.eq (call isxdigit 102i32) 0i32) (then (return 12i32)))
			(if (i32.eq (call isascii 127i32) 0i32) (then (return 13i32)))
			(if (i32.not-eq (call tolower 65i32) 97i32) (then (return 14i32)))
			(if (i32.not-eq (call toupper 122i32) 90i32) (then (return 15i32)))
			(if (i32.not-eq (call toascii 255i32) 127i32) (then (return 16i32)))
			(if (i32.not-eq (call _tolower 66i32) 98i32) (then (return 17i32)))
			(if (i32.not-eq (call _toupper 121i32) 89i32) (then (return 18i32)))
			(if (i32.not-eq (call isdigit -1i32) 0i32) (then (return 19i32)))
			(if (i32.not-eq (call isascii 128i32) 0i32) (then (return 20i32)))
			(if (i32.not-eq (call isgraph 32i32) 0i32) (then (return 21i32)))
			(return 42i32))))
