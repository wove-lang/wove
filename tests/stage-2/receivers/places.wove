(module receiver_places
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (payload (owned-array u8))))

	(fn fill
		(params (bytes (mut-array u8)))
		(returns void)
		(body (bytes.set 0i32 42u8)))

	(fn first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (bytes.get 0i32))))

	(fn fixed_length
		(generic (const N i32))
		(params (bytes (array u8 N)))
		(returns i32)
		(body (return bytes.len)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array:new (array (owned-array u8) 1) (array:alloc u8 1i32)))
			(call fill (borrow-mut (rows.get 0i32)))
			(let-mut packet (struct:new Packet (payload (move (rows.get 0i32)))))
			(let taken (move (packet.get payload)))
			(set (packet.get payload) (array:alloc u8 1i32))
			(rows.set 0i32 (array:alloc u8 1i32))
			(let-mut dynamic (array:alloc u8 0i32))
			(if (bool:not (dynamic.try-reserve 2i32)) (then (return 1i32)))
			(dynamic.push 42u8)
			(if (u8:not-eq (dynamic.get 0i32) 42u8) (then (return 2i32)))
			(let sample (array:repeat (array u8 2) 1u8))
			(if (i32:not-eq (call (specialize fixed_length 2i32) sample) 2i32) (then (return 3i32)))
			(return (i32:from-u8 (call first (borrow-shared taken)))))))
