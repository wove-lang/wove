(module receiver_chain_missing_argument
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let data (array:alloc i32 1i32))
			(if (data.len.gt (:doc "The terminal comparison requires a threshold."))
				(then (return 1i32)))
			(return 42i32))))
