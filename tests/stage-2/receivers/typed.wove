(module typed_receiver_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn hold
		(params (bytes (owned-array u8)))
		(returns (owned-array u8))
		(body (return (move bytes))))

	(fn exact_parameter
		(params (number (mut-ref i32)))
		(returns bool)
		(body (return number.gtz)))

	(fn specialized
		(generic (const Enabled bool) (const Start i32))
		(params)
		(returns i32)
		(body
			(if Enabled.not (then (return 0i32)))
			(return Start.inc)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let value 2.5f32)
			(if (bool:not (value.gt 1.0f32)) (then (return 1i32)))
			(let negative value.neg)
			(if (negative.not-eq (f32:neg value)) (then (return 2i32)))
			(let width 3u32)
			(if (u32:not-eq (width.shl 2i32) (u32:shl width 2i32)) (then (return 3i32)))
			(let encoded width.to-le-bytes)
			(if (u8:not-eq (encoded.get 0i32) 3u8) (then (return 7i32)))
			(if (u32:not-eq value.to-bits (f32:to-bits value)) (then (return 8i32)))
			(let offset 40i32)
			(let-mut answer 0i32)
			(if (bool:not (offset.try_add 2i32 (borrow-mut answer))) (then (return 4i32)))
			(let-mut pending (worker:receipt-queue hold))
			(let work (worker:spawn hold (array:alloc u8 1i32)))
			(pending.push (move work))
			(if (i32:not-eq pending.len 1i32) (then (return 5i32)))
			(let next pending.pop-front)
			(let bytes next.join)
			(if (i32:not-eq bytes.len 1i32) (then (return 6i32)))
			(if (bool:not (call exact_parameter (borrow-mut answer))) (then (return 9i32)))
			(if (i32:not-eq (call (specialize specialized (bool true) 4i32)) 5i32) (then (return 10i32)))
			(return answer))))
