(module receiver_chained_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (count u32) (values (array u8 2))))
	(struct Packet (fields (header Header)))

	(fn change_count
		(params (packet (mut-ref Packet)))
		(returns u32)
		(body
			(set packet/header/count 0u32)
			(return 41u32)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut packet (struct:new Packet
				(header (struct:new Header (count 42u32) (values (array:repeat (array u8 2) 0u8))))))
			(if packet/header/values.len.eqz (then (return 1i32)))
			(if (bool:not (packet/header/values.len.gt 1i32)) (then (return 2i32)))
			(if (i32:not-eq packet/header/count.to-le-bytes.len 4i32)
				(then (return 3i32)))
			(let value (packet/header/count.to-le-bytes.get 0i32))
			(if (u8:not-eq value (array:get (u32:to-le-bytes packet/header/count) 0i32))
				(then (return 4i32)))
			(if (bool:not (packet/header/count.inc.gt (call change_count (borrow-mut packet))))
				(then (return 5i32)))
			(if packet/header/count.not-eqz (then (return 6i32)))
			(return (i32:from-u8 value)))))
