(module fallible_absent_unwrap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let bytes (array.try-slice (borrow-shared (local argv)) -1i32 4))
			(return (i32.from-u32 (u32.from-le-bytes (optional.unwrap (local bytes))))))))
