(module weighted_path_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(let wire "ABCDéYZ")

	(fn word
		(params (cursor (mut-ref Cursor)))
		(returns u32)
		(body
			(let at (struct.get (local cursor) at))
			(set (struct.get (local cursor) at) (i32.add (local at) 4i32))
			(let bytes (array.try-slice (borrow-shared (struct.get (local cursor) bytes)) (local at) 4))
			(if (optional.is-none (local bytes)) (then (return 0u32)))
			(return (u32.from-le-bytes (borrow-shared (optional.unwrap (local bytes)))))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut cursor (struct.new Cursor (bytes (borrow-shared (local wire))) (at 0i32)))
			(if (u32.not-eq (call word (borrow-mut (local cursor))) 0x44434241u32) (then (return 1i32)))
			(if (u32.not-eq (call word (borrow-mut (local cursor))) 0x5A59A9C3u32) (then (return 2i32)))
			(if (u32.not-eqz (call word (borrow-mut (local cursor)))) (then (return 3i32)))
			(if (i32.not-eq (struct.get (local cursor) at) 12i32) (then (return 4i32)))
			(return 42i32))))
