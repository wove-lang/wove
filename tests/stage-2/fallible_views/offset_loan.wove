(module fallible_offset_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn offset (params (data (mut-array u8))) (returns i32)
		(body (array:store data 0i32 42u8) (return 0i32)))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 4i32))
			(let bytes (array:try-slice (borrow-shared data) (call offset (borrow-mut data)) 4))
			(return 0i32))))
