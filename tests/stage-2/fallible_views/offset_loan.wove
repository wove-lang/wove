(module fallible_offset_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn offset (params (data (mut-array u8))) (returns i32)
		(body (array.store (local data) 0i32 42u8) (return 0i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 4i32))
			(let bytes (array.try-slice (borrow-shared (local data)) (call offset (borrow-mut (local data))) 4))
			(return 0i32))))
