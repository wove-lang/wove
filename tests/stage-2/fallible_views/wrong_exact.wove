(module fallible_wrong_exact
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn exact (params (bytes (shared-array u8 3))) (returns i32)
		(body (return (array.len (local bytes)))))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let bytes (array.try-slice (borrow-shared (local argv)) 0i32 4))
			(let view (borrow-shared (optional.unwrap (local bytes))))
			(return (call exact (borrow-shared (local view)))))))
