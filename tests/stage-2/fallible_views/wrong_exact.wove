(module fallible_wrong_exact
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn exact (params (bytes (shared-array u8 3))) (returns i32)
		(body (return (array:len bytes))))

	(fn main (params (arguments (shared-array (shared-array u8)))) (returns i32)
		(body
			(let argv (array:load arguments 0i32))
			(let bytes (array:try-slice (borrow-shared argv) 0i32 4))
			(let view (borrow-shared (optional:unwrap bytes)))
			(return (call exact (borrow-shared view))))))
