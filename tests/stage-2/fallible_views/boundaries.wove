(module fallible_boundaries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(let window 2i32)
	(let empty "")

	(fn next
		(params (offset (mut-ref i32))) (returns i32)
		(body
			(let value (local offset))
			(set (local offset) (i32.inc (local value)))
			(return (local value))))

	(fn sum
		(params (values (shared-array i32 2))) (returns i32)
		(body (return (i32.add (array.load (local values) 0i32) (array.load (local values) 1i32)))))

	(fn forward
		(params (values (shared-array i32)))
		(returns (shared-array i32) (from values))
		(body
			(let slot (array.try-slice (borrow-shared (local values)) 1i32 window))
			(return (borrow-shared (optional.unwrap (local slot))))))
	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut data (array.new (array i32 3) 9i32 19i32 23i32))
			(let-mut offset 1i32)
			(if (bool true)
				(then
					(let last (array.try-slice (borrow-shared (local data)) (call next (borrow-mut (local offset))) window))
					(if (optional.is-none (local last)) (then (return 1i32)))
					(let items (borrow-shared (optional.unwrap (local last))))
					(let view (borrow-shared (local items)))
					(if (i32.not-eq (call sum (borrow-shared (local view))) 42i32) (then (return 2i32)))
					(if (i32.not-eq (local offset) 2i32) (then (return 3i32)))
					(let present (array.try-slice (borrow-shared (local data)) 3i32 0))
					(if (optional.is-none (local present)) (then (return 4i32)))
					(let none (array.try-slice (borrow-shared (local data)) 2i32 window))
					(if (bool.not (optional.is-none (local none))) (then (return 5i32)))
					(let negative (array.try-slice (borrow-shared (local data)) -2147483648i32 window))
					(if (bool.not (optional.is-none (local negative))) (then (return 6i32)))
					(let high (array.try-slice (borrow-shared (local data)) 2147483647i32 window))
					(if (bool.not (optional.is-none (local high))) (then (return 7i32)))
					(let too_far (array.try-slice (borrow-shared (local data)) 4i32 0))
					(if (bool.not (optional.is-none (local too_far))) (then (return 8i32)))
					(let huge (array.try-slice (borrow-shared (local data)) 2i32 2147483647))
					(if (bool.not (optional.is-none (local huge))) (then (return 9i32)))
					(let zero (array.try-slice (borrow-shared (local empty)) 0i32 0))
					(if (optional.is-none (local zero)) (then (return 10i32)))
					(let zero_data (borrow-shared (optional.unwrap (local zero))))
					(if (i32.not-eqz (array.len (local zero_data))) (then (return 11i32)))
					(let supplied (call forward (borrow-shared (local data))))
					(if (i32.not-eq (array.load (local supplied) 1i32) 23i32) (then (return 12i32)))))
			(array.store (local data) 0i32 42i32)
			(return (array.load (local data) 0i32)))))
