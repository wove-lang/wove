(module fallible_boundaries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let window 2i32)
	(let empty "")

	(fn next
		(params (offset (mut-ref i32))) (returns i32)
		(body
			(let value offset)
			(set offset (i32:inc value))
			(return value)))

	(fn sum
		(params (values (shared-array i32 2))) (returns i32)
		(body (return (i32:add (array:get values 0i32) (array:get values 1i32)))))

	(fn forward
		(params (values (shared-array i32)))
		(returns (shared-array i32) (from values))
		(body
			(let slot (array:try-slice (borrow-shared values) 1i32 window))
			(return (borrow-shared (optional:unwrap slot)))))
	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:new (array i32 3) 9i32 19i32 23i32))
			(let-mut offset 1i32)
			(if (bool true)
				(then
					(let last (array:try-slice (borrow-shared data) (call next (borrow-mut offset)) window))
					(if (optional:is-none last) (then (return 1i32)))
					(let items (borrow-shared (optional:unwrap last)))
					(let view (borrow-shared items))
					(if (i32:not-eq (call sum (borrow-shared view)) 42i32) (then (return 2i32)))
					(if (i32:not-eq offset 2i32) (then (return 3i32)))
					(let present (array:try-slice (borrow-shared data) 3i32 0))
					(if (optional:is-none present) (then (return 4i32)))
					(let none (array:try-slice (borrow-shared data) 2i32 window))
					(if (bool:not (optional:is-none none)) (then (return 5i32)))
					(let negative (array:try-slice (borrow-shared data) -2147483648i32 window))
					(if (bool:not (optional:is-none negative)) (then (return 6i32)))
					(let high (array:try-slice (borrow-shared data) 2147483647i32 window))
					(if (bool:not (optional:is-none high)) (then (return 7i32)))
					(let too_far (array:try-slice (borrow-shared data) 4i32 0))
					(if (bool:not (optional:is-none too_far)) (then (return 8i32)))
					(let huge (array:try-slice (borrow-shared data) 2i32 2147483647))
					(if (bool:not (optional:is-none huge)) (then (return 9i32)))
					(let zero (array:try-slice (borrow-shared empty) 0i32 0))
					(if (optional:is-none zero) (then (return 10i32)))
					(let zero_data (borrow-shared (optional:unwrap zero)))
					(if (i32:not-eqz (array:len zero_data)) (then (return 11i32)))
					(let supplied (call forward (borrow-shared data)))
					(if (i32:not-eq (array:get supplied 1i32) 23i32) (then (return 12i32)))))
			(array:set data 0i32 42i32)
			(return (array:get data 0i32)))))
