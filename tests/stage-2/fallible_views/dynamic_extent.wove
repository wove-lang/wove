(module fallible_dynamic_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let count (array.len (local argv)))
			(let bytes (array.try-slice (borrow-shared (local argv)) 0i32 count))
			(return 0i32))))
