(module fallible_wrong_provenance
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn invalid (params (source (shared-array u8))) (returns (shared-array u8) (from source))
		(body
			(let buffer (array.alloc u8 4i32))
			(let bytes (array.try-slice (borrow-shared (local buffer)) 0i32 4))
			(return (borrow-shared (optional.unwrap (local bytes))))))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body (return 0i32))))
