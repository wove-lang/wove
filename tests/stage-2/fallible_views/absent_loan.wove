(module fallible_absent_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let missing (array.try-slice (borrow-shared (local data)) -1i32 4))
			(let grown (array.try-reserve (local data) 8i32))
			(return 0i32))))
