(module fallible_absent_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 1i32))
			(let missing (array:try-slice (borrow-shared data) -1i32 4))
			(let grown (array:try-reserve data 8i32))
			(return 0i32))))
