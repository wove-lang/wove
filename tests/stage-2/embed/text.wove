(module embed_text
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let literal "abc\n")
	(let bytes (embed "payload.txt"))

	(fn same (params (a (shared-array u8)) (b (shared-array u8))) (returns bool)
		(body
			(if (i32.not-eq (array.len a) (array.len b)) (then (return (bool false))))
			(for (let index item) (borrow-shared a)
				(body
					(if (u8.not-eq item (array.load b index))
						(then (return (bool false))))))
			(return (bool true))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let local_bytes (embed "payload.txt"))
			(if (call same (borrow-shared bytes) (borrow-shared literal))
				(then
					(if (call same (borrow-shared local_bytes) (borrow-shared bytes))
						(then (return 42i32)))))
			(return 1i32))))
