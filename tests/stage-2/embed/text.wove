(module embed_text
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let literal "abc\n")
	(let bytes (embed "payload.txt"))

	(fn same (params (a (shared-array u8)) (b (shared-array u8))) (returns bool)
		(body
			(if (i32.not-eq (array.len (local a)) (array.len (local b))) (then (return (bool false))))
			(for (bind index item) (borrow-shared (local a))
				(body
					(if (u8.not-eq (local item) (array.load (local b) (local index)))
						(then (return (bool false))))))
			(return (bool true))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let local_bytes (embed "payload.txt"))
			(if (call same (borrow-shared (local bytes)) (borrow-shared (local literal)))
				(then
					(if (call same (borrow-shared (local local_bytes)) (borrow-shared (local bytes)))
						(then (return 42i32)))))
			(return 1i32))))
