(module embed_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../pkg/provider.wove" (only (as main verify_asset) (type EntryArgSpan)))

	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (call verify_asset (borrow-shared (local entry_bytes)) (borrow-shared (local entry_spans)))))))
