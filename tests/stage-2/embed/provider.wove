(module embed_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn unused
		(:pragma (cfg bootstrap))
		(params)
		(returns i32)
		(body
			(let missing (embed "not-supplied.bin"))
			(return (i32 0))))

	(let module_payload (embed "./assets/payload.bin"))
	(let skipped (:pragma (cfg bootstrap)) (embed "disabled-module.bin"))

	(fn verify_bytes
		(params (data (shared-array u8)))
		(returns bool)
		(body
			(return (bool.and (i32.eq (array.len data) (i32 6))
				(bool.and (u8.eq (array.load data (i32 0)) (u8 0))
					(bool.and (u8.eq (array.load data (i32 1)) (u8 195))
						(bool.and (u8.eq (array.load data (i32 2)) (u8 169))
							(bool.and (u8.eq (array.load data (i32 3)) (u8 255))
								(bool.and (u8.eq (array.load data (i32 4)) (u8 34))
									(u8.eq (array.load data (i32 5)) (u8 65)))))))))))

	(fn overwrite
		(params (data (mut-array u8)))
		(returns void)
		(body (array.store data (i32 0) (u8 99))))

	(fn view_length
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array.len data))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(disabled (let ignored (embed "disabled.bin")))
			(let empty (embed `assets/empty.bin`))
			(if (bool.not (i32.eq (call view_length (borrow-shared empty)) (i32 0)))
				(then (return (i32 1))))
			(let original (embed "./assets/payload\u002ebin"))
			(if (bool.not (call verify_bytes (borrow-shared module_payload)))
				(then (return (i32 2))))
			(let-mut cursor (i32 0))
			(while (i32.lt cursor (i32 2))
				(body
					(let-mut copy (array.alloc u8 (array.len original)))
					(if (bool.not (array.try-copy-from (borrow-mut copy) (borrow-shared original)))
						(then (return (i32 3))))
					(if (bool.not (call verify_bytes (borrow-shared copy)))
						(then (return (i32 4))))
					(call overwrite (borrow-mut copy))
					(if (bool.not (call verify_bytes (borrow-shared original)))
						(then (return (i32 5))))
					(set cursor (i32.add cursor (i32 1)))))
			(return (i32 42)))))
