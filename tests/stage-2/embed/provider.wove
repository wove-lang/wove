(module embed_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn unused
		(:pragma (cfg bootstrap))
		(params)
		(returns i32)
		(body
			(let missing (embed "not-supplied.bin"))
			(return (i32 0))))

	(fn verify_bytes
		(params (data (shared-slice u8)))
		(returns bool)
		(body
			(return (bool.and (i32.eq (slice.len (local data)) (i32 6))
				(bool.and (u8.eq (slice.load (local data) (i32 0)) (u8 0))
					(bool.and (u8.eq (slice.load (local data) (i32 1)) (u8 195))
						(bool.and (u8.eq (slice.load (local data) (i32 2)) (u8 169))
							(bool.and (u8.eq (slice.load (local data) (i32 3)) (u8 255))
								(bool.and (u8.eq (slice.load (local data) (i32 4)) (u8 34))
									(u8.eq (slice.load (local data) (i32 5)) (u8 65)))))))))))

	(fn overwrite
		(params (data (mut-slice u8)))
		(returns void)
		(body (slice.store (local data) (i32 0) (u8 99))))

	(fn view_length
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local data)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(disabled (let ignored (embed "disabled.bin")))
			(let empty (embed `assets/empty.bin`))
			(if (bool.not (i32.eq (call view_length (borrow-shared (local empty))) (i32 0)))
				(then (return (i32 1))))
			(let original (embed "./assets/payload\u002ebin"))
			(let-mut cursor (i32 0))
			(while (i32.lt (local cursor) (i32 2))
				(body
					(let-mut copy (embed "assets/payload.bin"))
					(if (bool.not (call verify_bytes (borrow-shared (local copy))))
						(then (return (i32 2))))
					(call overwrite (borrow-mut (local copy)))
					(if (bool.not (call verify_bytes (borrow-shared (local original))))
						(then (return (i32 3))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (i32 42)))))
