(module callback_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./dispatch.h" (only fixture_dispatch))

	(fn visit
		(params (path (shared-array u8)) (value i32)) (returns i32)
		(body (return (i32.sub value (array.len path)))))

	(fn dispatch
		(generic (const Bias i32))
		(params (first i32) (second i32)) (returns i32)
		(body
			(let a (call fixture_dispatch (i32.add first Bias) (fn-ref visit)))
			(let b (call fixture_dispatch (i32.add second Bias) (fn-ref visit)))
			(return (i32.add a b)))))
