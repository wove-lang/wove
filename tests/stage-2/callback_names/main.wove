(module callback_collision_probe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only (as dispatch left)))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove" (only (as dispatch right)))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (array.len argv))
			(if (i32.eq count 2i32) (then (return (call (specialize left 1i32) -2i32 2i32))))
			(if (i32.eq count 3i32) (then (return (call (specialize right 1i32) 1i32 -3i32))))
			(if (i32.not-eq (call (specialize left 1i32) 1i32 2i32) 13i32) (then (return 90i32)))
			(if (i32.not-eq (call (specialize left 2i32) 1i32 2i32) 15i32) (then (return 91i32)))
			(return (i32.add (call (specialize right 1i32) 10i32 11i32) 27i32)))))
