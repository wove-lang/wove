(module process_capture_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/io/process.wove" (only run_process_capture))
	(use wove-file "../../../stage-2/cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "../../../stage-2/cli/values.wove" (only argv_decimal argv_signed))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(fn read_number
		(params (bytes (shared-array u8)) (span ArgSpan))
		(returns i32)
		(body
			(let parsed (call argv_decimal (borrow-shared (local bytes)) (struct.get (local span) start)
				(struct.get (local span) end) (bool true)))
			(if (bool.not (struct.get (local parsed) valid)) (then (return (i32 -2147483648))))
			(return (call argv_signed (local parsed)))))

	(fn pack_arguments
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (packed (mut-array u8)))
		(returns void)
		(body
			(let-mut row (i32 5))
			(let-mut offset (i32 0))
			(while (i32.lt (local row) (array.len (local argv)))
				(body
					(let span (array.load (local argv) (local row)))
					(let-mut cursor (struct.get (local span) start))
					(while (i32.lt (local cursor) (struct.get (local span) end))
						(body
							(array.store (local packed) (local offset) (array.load (local bytes) (local cursor)))
							(set (local cursor) (i32.add (local cursor) (i32 1)))
							(set (local offset) (i32.add (local offset) (i32 1)))))
					(array.store (local packed) (local offset) (u8 0))
					(set (local offset) (i32.add (local offset) (i32 1)))
					(set (local row) (i32.add (local row) (i32 1)))))))

	(fn fill_output
		(params (output (mut-array u8)))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while (i32.lt (local index) (array.len (local output)))
				(body
					(array.store (local output) (local index) (u8 255))
					(set (local index) (i32.add (local index) (i32 1)))))))

	(fn check_tail
		(params (output (shared-array u8)) (start i32))
		(returns bool)
		(body
			(let-mut index (local start))
			(while (i32.lt (local index) (array.len (local output)))
				(body
					(if (bool.not (u8.eq (array.load (local output) (local index)) (u8 255)))
						(then (return (bool false))))
					(set (local index) (i32.add (local index) (i32 1)))))
			(return (bool true))))

	(fn main
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(let count (array.len (local argv)))
			(if (i32.eq (local count) (i32 0)) (then (return (i32 0))))
			(if (i32.lt (local count) (i32 5)) (then (return (i32 1))))

			(let capacity (call read_number (borrow-shared (local bytes)) (array.load (local argv) (i32 0))))
			(let status (call read_number (borrow-shared (local bytes)) (array.load (local argv) (i32 1))))
			(let overflow (i32.eq (call read_number (borrow-shared (local bytes)) (array.load (local argv) (i32 2))) (i32 1)))
			(let prefix (array.load (local argv) (i32 3)))
			(let program (array.load (local argv) (i32 4)))
			(let packed_length (i32.add
				(i32.sub (array.len (local bytes)) (struct.get (local program) end))
				(i32.sub (local count) (i32 5))))
			(let-mut packed (array.alloc u8 (local packed_length)))
			(call pack_arguments (borrow-shared (local bytes)) (borrow-shared (local argv)) (borrow-mut (local packed)))

			(let-mut output (array.alloc u8 (local capacity)))
			(call fill_output (borrow-mut (local output)))
			(let capture (call run_process_capture
				(borrow-shared (array.range (local bytes) (struct.get (local program) start) (struct.get (local program) end)))
				(borrow-shared (local packed)) (borrow-mut (local output))))
			(let length (struct.get (local capture) length))
			(if (bool.not (i32.eq (struct.get (local capture) status) (local status))) (then (return (i32 2))))
			(if (bool.not (bool.and
				(bool.or (local overflow) (bool.not (struct.get (local capture) overflow)))
				(bool.or (bool.not (local overflow)) (struct.get (local capture) overflow))))
				(then (return (i32 3))))
			(if (bool.not (call same_bytes (borrow-shared (local output)) (i32 0) (local length)
				(borrow-shared (local bytes)) (struct.get (local prefix) start) (struct.get (local prefix) end)))
				(then (return (i32 4))))
			(if (bool.not (call check_tail (borrow-shared (local output)) (local length)))
				(then (return (i32 5))))
			(return (i32 42)))))
