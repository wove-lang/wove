(module process_capture_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/io/process.wove" (only run_process_capture))
	(use wove-file "../../../stage-2/cli/values.wove" (only argv_decimal argv_signed))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(fn read_number
		(params (bytes (shared-array u8)))
		(returns i32)
		(body
			(let parsed (call argv_decimal (borrow-shared bytes) 0i32 (array:len bytes) (bool true)))
			(if (bool:not (struct:get parsed valid)) (then (return (i32 -2147483648))))
			(return (call argv_signed parsed))))

	(fn pack_arguments
		(params (argv (shared-array (shared-array u8))) (packed (mut-array u8)))
		(returns void)
		(body
			(let-mut row 6i32)
			(let-mut offset (i32 0))
			(while (i32:lt row (array:len argv))
				(body
					(let bytes (array:get argv row))
					(let-mut cursor 0i32)
					(while (i32:lt cursor (array:len bytes))
						(body
							(array:set packed offset (array:get bytes cursor))
							(set cursor (i32:add cursor (i32 1)))
							(set offset (i32:add offset (i32 1)))))
					(array:set packed offset (u8 0))
					(set offset (i32:add offset (i32 1)))
					(set row (i32:add row (i32 1)))))))

	(fn fill_output
		(params (output (mut-array u8)))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while (i32:lt index (array:len output))
				(body
					(array:set output index (u8 255))
					(set index (i32:add index (i32 1)))))))

	(fn check_tail
		(params (output (shared-array u8)) (start i32))
		(returns bool)
		(body
			(let-mut index start)
			(while (i32:lt index (array:len output))
				(body
					(if (bool:not (u8:eq (array:get output index) (u8 255)))
						(then (return (bool false))))
					(set index (i32:add index (i32 1)))))
			(return (bool true))))

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (array:len argv))
			(if (i32:eq count 1i32) (then (return (i32 0))))
			(if (i32:lt count 6i32) (then (return (i32 1))))

			(let capacity (call read_number (borrow-shared (array:get argv 1i32))))
			(let status (call read_number (borrow-shared (array:get argv 2i32))))
			(let overflow (i32:eq (call read_number (borrow-shared (array:get argv 3i32))) (i32 1)))
			(let prefix (array:get argv 4i32))
			(let program (array:get argv 5i32))
			(let-mut packed_length 0i32)
			(let-mut row 6i32)
			(while (i32:lt row count)
				(body
					(let width (array:len (array:get argv row)))
					(set packed_length (i32:add packed_length (i32:inc width)))
					(set row (i32:inc row))))
			(let-mut packed (array:alloc u8 packed_length))
			(call pack_arguments (borrow-shared argv) (borrow-mut packed))

			(let-mut output (array:alloc u8 capacity))
			(call fill_output (borrow-mut output))
			(let capture (call run_process_capture
				(borrow-shared program)
				(borrow-shared packed) (borrow-mut output)))
			(let length (struct:get capture length))
			(if (bool:not (i32:eq (struct:get capture status) status)) (then (return (i32 2))))
			(if (bool:not (bool:and
				(bool:or overflow (bool:not (struct:get capture overflow)))
				(bool:or (bool:not overflow) (struct:get capture overflow))))
				(then (return (i32 3))))
			(if (bool:not (call same_bytes (borrow-shared output) (i32 0) length
				(borrow-shared prefix) 0i32 (array:len prefix)))
				(then (return (i32 4))))
			(if (bool:not (call check_tail (borrow-shared output) length))
				(then (return (i32 5))))
			(return (i32 42)))))
