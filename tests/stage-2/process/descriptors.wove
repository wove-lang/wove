(module capture_descriptors_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "../../../stage-2/io/capture/descriptors.wove" (only (type CaptureDescriptors)
		open_capture_fifo open_capture_descriptors close_capture_descriptors))
	(use c-header "<fcntl.h>" (only fcntl_getfd fcntl_getfl FD_CLOEXEC O_NONBLOCK))
	(use c-header "<stdlib.h>" (only setenv))
	(use c-header "<unistd.h>" (only read write close STDIN_FILENO STDOUT_FILENO STDERR_FILENO (type Size)))

	(let message "C")
	(let temporary_key "TMPDIR")
	(let fixture_root ".")
	(let invalid_root "tests/stage-2/native_records/data.txt/fifo-root")

	(fn received (params (data (shared-array u8))) (returns bool)
		(body (return (u8.eq (array.load (local data) 0i32) 67u8))))

	(fn verify (params (ends CaptureDescriptors) (relocated bool)) (returns i32)
		(body
			(let reader (struct.get (local ends) reader))
			(let writer (struct.get (local ends) writer))
			(if (bool.or (i32.lt (local reader) 0i32) (i32.lt (local writer) 0i32))
				(then (return 1i32)))
			(let read_fd (call fcntl_getfd (local reader)))
			(let write_fd (call fcntl_getfd (local writer)))
			(let read_flags (call fcntl_getfl (local reader)))
			(if (bool.or (i32.lt (local read_fd) 0i32) (bool.or (i32.lt (local write_fd) 0i32) (i32.lt (local read_flags) 0i32)))
				(then (return 2i32)))
			(let cloexec (int.convert u32 (local FD_CLOEXEC)))
			(if (bool.or (u32.eq (u32.and (int.convert u32 (local read_fd)) (local cloexec)) 0u32)
				(u32.eq (u32.and (int.convert u32 (local write_fd)) (local cloexec)) 0u32))
				(then (return 3i32)))
			(if (bool.not (u32.eq (u32.and (int.convert u32 (local read_flags)) (int.convert u32 (local O_NONBLOCK))) 0u32))
				(then (return 4i32)))
			(if (bool.and (local relocated) (bool.not (bool.and (i32.lt (local STDERR_FILENO) (local reader))
				(i32.lt (local STDERR_FILENO) (local writer)))))
				(then (return 5i32)))
			(let written (int.convert i32 (call write (local writer) (borrow-shared (local message)) (int.convert Size 1i32))))
			(if (bool.not (i32.eq (local written) 1i32)) (then (return 6i32)))
			(let-mut byte (array.alloc u8 1i32))
			(let count (int.convert i32 (call read (local reader) (borrow-mut (local byte)) (int.convert Size 1i32))))
			(if (bool.not (bool.and (i32.eq (local count) 1i32) (call received (borrow-shared (local byte)))))
				(then (return 7i32)))
			(return 42i32)))

	(fn verify_and_close (params (ends CaptureDescriptors) (relocated bool)) (returns i32)
		(body
			(let result (call verify (local ends) (local relocated)))
			(call close_capture_descriptors (local ends))
			(return (local result))))

	(fn verify_failure (params) (returns i32)
		(body
			(let changed (call setenv (borrow-shared (local temporary_key)) (borrow-shared (local invalid_root)) 1i32))
			(if (bool.not (i32.eq (local changed) 0i32)) (then (return 8i32)))
			(let ends (call open_capture_fifo))
			(let failed (bool.and (i32.eq (struct.get (local ends) reader) -1i32)
				(i32.eq (struct.get (local ends) writer) -1i32)))
			(call close_capture_descriptors (local ends))
			(if (local failed) (then (return 42i32)))
			(return 9i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32.dec (array.len (local argv))))
			(if (i32.lt 1i32 (local count)) (then (return (call verify_failure))))
			(let changed (call setenv (borrow-shared (local temporary_key)) (borrow-shared (local fixture_root)) 1i32))
			(if (bool.not (i32.eq (local changed) 0i32)) (then (return 10i32)))
			(if (i32.eq (local count) 1i32)
				(then
					(let input (call close (local STDIN_FILENO)))
					(let output (call close (local STDOUT_FILENO)))))
			(let fifo (call verify_and_close (call open_capture_fifo) (bool false)))
			(if (bool.not (i32.eq (local fifo) 42i32)) (then (return (local fifo))))
			(return (call verify_and_close (call open_capture_descriptors) (bool true)))))
)
