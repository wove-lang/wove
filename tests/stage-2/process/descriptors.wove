(module capture_descriptors_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "../../../stage-2/io/capture/descriptors.wove" (only (type CaptureDescriptors)
		open_capture_fifo open_capture_descriptors close_capture_descriptors))
	(use c-header "<fcntl.h>" (only fcntl_getfd fcntl_getfl FD_CLOEXEC O_NONBLOCK))
	(use c-header "<stdlib.h>" (only setenv))
	(use c-header "<unistd.h>" (only read write close STDIN_FILENO STDOUT_FILENO STDERR_FILENO (type Size)))

	(let message "C")
	(let temporary_key "TMPDIR")
	(let fixture_root ".")
	(let invalid_root "tests/stage-2/native_records/data.txt/fifo-root")

	(fn received (params (data (shared-array u8))) (returns bool)
		(body (return (u8:eq (array:get data 0i32) 67u8))))

	(fn verify (params (ends CaptureDescriptors) (relocated bool)) (returns i32)
		(body
			(let reader (struct:get ends reader))
			(let writer (struct:get ends writer))
			(if (bool:or (i32:lt reader 0i32) (i32:lt writer 0i32))
				(then (return 1i32)))
			(let read_fd (call fcntl_getfd reader))
			(let write_fd (call fcntl_getfd writer))
			(let read_flags (call fcntl_getfl reader))
			(if (bool:or (i32:lt read_fd 0i32) (bool:or (i32:lt write_fd 0i32) (i32:lt read_flags 0i32)))
				(then (return 2i32)))
			(let cloexec (int:convert u32 FD_CLOEXEC))
			(if (bool:or (u32:eq (u32:and (int:convert u32 read_fd) cloexec) 0u32)
				(u32:eq (u32:and (int:convert u32 write_fd) cloexec) 0u32))
				(then (return 3i32)))
			(if (bool:not (u32:eq (u32:and (int:convert u32 read_flags) (int:convert u32 O_NONBLOCK)) 0u32))
				(then (return 4i32)))
			(if (bool:and relocated (bool:not (bool:and (i32:lt STDERR_FILENO reader)
				(i32:lt STDERR_FILENO writer))))
				(then (return 5i32)))
			(let written (int:convert i32 (call write writer (borrow-shared message) (int:convert Size 1i32))))
			(if (bool:not (i32:eq written 1i32)) (then (return 6i32)))
			(let-mut byte (array:alloc u8 1i32))
			(let count (int:convert i32 (call read reader (borrow-mut byte) (int:convert Size 1i32))))
			(if (bool:not (bool:and (i32:eq count 1i32) (call received (borrow-shared byte))))
				(then (return 7i32)))
			(return 42i32)))

	(fn verify_and_close (params (ends CaptureDescriptors) (relocated bool)) (returns i32)
		(body
			(let result (call verify ends relocated))
			(call close_capture_descriptors ends)
			(return result)))

	(fn verify_failure (params) (returns i32)
		(body
			(let changed (call setenv (borrow-shared temporary_key) (borrow-shared invalid_root) 1i32))
			(if (bool:not (i32:eq changed 0i32)) (then (return 8i32)))
			(let ends (call open_capture_fifo))
			(let failed (bool:and (i32:eq (struct:get ends reader) -1i32)
				(i32:eq (struct:get ends writer) -1i32)))
			(call close_capture_descriptors ends)
			(if failed (then (return 42i32)))
			(return 9i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (i32:dec (array:len argv)))
			(if (i32:lt 1i32 count) (then (return (call verify_failure))))
			(let changed (call setenv (borrow-shared temporary_key) (borrow-shared fixture_root) 1i32))
			(if (bool:not (i32:eq changed 0i32)) (then (return 10i32)))
			(if (i32:eq count 1i32)
				(then
					(let input (call close STDIN_FILENO))
					(let output (call close STDOUT_FILENO))))
			(let fifo (call verify_and_close (call open_capture_fifo) (bool false)))
			(if (bool:not (i32:eq fifo 42i32)) (then (return fifo)))
			(return (call verify_and_close (call open_capture_descriptors) (bool true)))))
)
