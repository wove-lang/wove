(module directory_raw_reads
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only (type Size) (type Char) (type Offset) (type Offset64)
		opendir dirfd readdir readdir64 rewinddir getdents64 getdirentries getdirentries64))
	(use c-header "<errno.h>" (only (value errno) (value EBADF)))
	(use wove-file "./equal.wove" (only equal_bytes))

	(let location ".")

	(fn valid_read (params (count i32)) (returns bool)
		(body (return (bool.and (i32.gt count 0i32) (i32.le count 1024i32)))))

	(fn check_bytes (params (count Size)) (returns bool)
		(body
			(let directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return (bool false))))
			(let descriptor (call dirfd (borrow-shared directory)))
			(let-mut bytes (array.alloc u8 1024i32))
			(let read (int.convert i32 (call getdents64 descriptor (borrow-mut bytes) count)))
			(if (bool.not (call valid_read read)) (then (return (bool false))))
			(set errno 0i32)
			(let invalid (int.convert i32 (call getdents64 -1i32 (borrow-mut bytes) count)))
			(return (bool.and (i32.eq invalid -1i32) (i32.eq errno EBADF)))))

	(fn check_entries (params (count Size)) (returns bool)
		(body
			(let directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return (bool false))))
			(let descriptor (call dirfd (borrow-shared directory)))
			(let-mut buffer (array.alloc Char 1024i32))
			(let-mut base (int.convert Offset -1i32))
			(let read (int.convert i32
				(call getdirentries descriptor (borrow-mut buffer) count (borrow-mut base))))
			(return (bool.and (call valid_read read) (i64.eq (int.convert i64 base) 0i64)))))

	(fn check_wide_entries (params (count Size)) (returns bool)
		(body
			(let directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return (bool false))))
			(let descriptor (call dirfd (borrow-shared directory)))
			(let-mut buffer (array.alloc Char 1024i32))
			(let-mut base (int.convert Offset64 -1i32))
			(let read (int.convert i32
				(call getdirentries64 descriptor (borrow-mut buffer) count (borrow-mut base))))
			(return (bool.and (call valid_read read) (i64.eq (int.convert i64 base) 0i64)))))

	(fn check_wide_name (params) (returns bool)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return (bool false))))
			(let first (call readdir (borrow-mut directory)))
			(if (owner.is-null first) (then (return (bool false))))
			(call rewinddir (borrow-mut directory))
			(let wide (call readdir64 (borrow-mut directory)))
			(if (owner.is-null wide) (then (return (bool false))))
			(let name (move (optional.unwrap first)))
			(let wide_name (move (optional.unwrap wide)))
			(return (call equal_bytes (borrow-shared name) (borrow-shared wide_name)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:318"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let count (int.convert Size 1024i32))
			(if (bool.not (call check_bytes count)) (then (return 1i32)))
			(if (bool.not (call check_entries count)) (then (return 2i32)))
			(if (bool.not (call check_wide_entries count)) (then (return 3i32)))
			(if (bool.not (call check_wide_name)) (then (return 4i32)))
			(return 42i32))))
