(module bounded_snapshot_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only snapshot_read snapshot_const))
	(use c-header "<errno.h>" (only (value errno) (value EDOM)))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:eq (i32:dec (array:len args)) 1i32)
				(then
					(let invalid (call snapshot_read 3i32))
					(return 1i32)))
			(set errno 0i32)
			(let first (call snapshot_read 1i32))
			(if (bool:not (i32:eq errno EDOM)) (then (return 2i32)))
			(let second (call snapshot_read 2i32))
			(let empty (call snapshot_read 0i32))
			(set errno 0i32)
			(let missing (call snapshot_read -1i32))
			(if (bool:not (owner:is-null missing)) (then (return 3i32)))
			(if (bool:not (i32:eq errno EDOM)) (then (return 4i32)))
			(let readonly (call snapshot_const))
			(let name_a (move (optional:unwrap first)))
			(let name_b (move (optional:unwrap second)))
			(let blank (move (optional:unwrap empty)))
			(let name_c (move (optional:unwrap readonly)))
			(if (bool:not (i32:eq (array:len name_a) 3i32)) (then (return 5i32)))
			(if (bool:not (i32:eq (array:len name_b) 3i32)) (then (return 6i32)))
			(if (bool:not (i32:eq (array:len blank) 0i32)) (then (return 7i32)))
			(if (bool:not (u8:eq (array:get name_a 0i32) 98u8)) (then (return 8i32)))
			(if (bool:not (u8:eq (array:get name_b 0i32) 99u8)) (then (return 9i32)))
			(if (bool:not (u8:eq (array:get name_c 2i32) 110u8)) (then (return 10i32)))
			(return 42i32)))
)
