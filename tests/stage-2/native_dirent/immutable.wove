(module immutable_directory
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir readdir))
	(let path ".")

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let directory (call opendir (borrow-shared path)))
			(let name (call readdir (borrow-mut directory)))
			(return 42i32)))
)
