(module immutable_directory
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir readdir))
	(let path ".")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let directory (call opendir (borrow-shared (local path))))
			(let name (call readdir (borrow-mut (local directory))))
			(return 42i32)))
)
