(module snapshot_field_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./fixture.h"
		(fn snapshot_read
			(:pragma (c_snapshot cstr (field name)))
			(params (mode i32))
			(returns (optional (owned-array u8))))
		(fn snapshot_const
			(:pragma (c_snapshot cstr (field name)))
			(params)
			(returns (optional (owned-array u8))))
		(fn snapshot_pointer
			(:pragma (c_snapshot cstr (field name)))
			(params)
			(returns (optional (owned-array u8))))
		(fn snapshot_flexible
			(:pragma (c_snapshot cstr (field name)))
			(params)
			(returns (optional (owned-array u8))))
		(fn snapshot_directory_name
			(:pragma (c_snapshot cstr))
			(params)
			(returns (optional (owned-array u8)))))
)
