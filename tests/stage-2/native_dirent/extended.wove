(module extended_directory_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./fixture.h" (only snapshot_directory_name (value snapshot_directory_reads)))
	(use c-header "<errno.h>" (only (value errno) (value EDOM)))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(set errno 0i32)
			(let entry (call snapshot_directory_name))
			(if (owner:is-null entry) (then (return 1i32)))
			(if (bool:not (i32:eq errno EDOM)) (then (return 2i32)))
			(let name (move (optional:unwrap entry)))
			(if (bool:not (i32:eq (array:len name) 9i32)) (then (return 3i32)))
			(if (bool:not (u8:eq (array:load name 4i32) 45u8)) (then (return 4i32)))
			(if (bool:not (u8:eq (array:load name 8i32) 101u8)) (then (return 5i32)))
			(if (i32:not-eq snapshot_directory_reads 1i32) (then (return 6i32)))
			(return 42i32)))
)
