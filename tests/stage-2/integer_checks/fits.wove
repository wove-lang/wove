(module integer_fits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn next
		(params (count (mut-ref i32)))
		(returns u64)
		(body
			(set (local count) (i32.add.wrapping (local count) 1i32))
			(return 18446744073709551615u64)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:381"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(if (bool.or (i8.fits -129i32) (i8.fits 128u8)) (then (return 1i32)))
			(if (bool.not (bool.and (i8.fits -128i32) (i8.fits 127u8))) (then (return 2i32)))
			(if (bool.or (u8.fits -1i8) (u8.fits 256u16)) (then (return 3i32)))
			(if (bool.not (u8.fits 255u64)) (then (return 4i32)))
			(if (bool.or (i16.fits -32769i32) (i16.fits 32768u16)) (then (return 5i32)))
			(if (bool.not (i16.fits -32768i32)) (then (return 6i32)))
			(if (bool.or (u16.fits -1i16) (u16.fits 65536u32)) (then (return 7i32)))
			(if (bool.not (u16.fits 65535u64)) (then (return 8i32)))
			(if (bool.or (i32.fits 2147483648u32) (u32.fits 4294967296u64)) (then (return 9i32)))
			(if (bool.not (bool.and (i32.fits -2147483648i32) (u32.fits 4294967295u64))) (then (return 10i32)))
			(if (u64.fits -1i32) (then (return 11i32)))
			(let-mut count 0i32)
			(if (bool.not (u64.fits (call next (borrow-mut (local count))))) (then (return 12i32)))
			(if (bool.not (i32.eq (local count) 1i32)) (then (return 13i32)))
			(return 42i32))))
