(module recoverable_wrong_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut output 0u32)
			(let checked (i32.try_add 3i32 4i32 (borrow-mut output)))
			(return 0i32))))
