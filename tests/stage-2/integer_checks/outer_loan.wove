(module recoverable_outer_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn store
		(params (output (mut-ref i32)) (checked bool))
		(returns bool)
		(body (return (local checked))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut output 0i32)
			(let checked (call store (borrow-mut (local output))
				(i32.try_add 3i32 4i32 (borrow-mut (local output)))))
			(return 0i32))))
