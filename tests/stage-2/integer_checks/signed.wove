(module recoverable_signed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:381"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut output 71i32)
			(if (bool.or (i32.try_add 2147483647i32 1i32 (borrow-mut (local output)))
				(bool.not (i32.eq (local output) 71i32))) (then (return 1i32)))
			(if (bool.or (i32.try_sub -2147483648i32 1i32 (borrow-mut (local output)))
				(bool.not (i32.eq (local output) 71i32))) (then (return 2i32)))
			(if (bool.or (i32.try_mul 2147483647i32 2i32 (borrow-mut (local output)))
				(bool.not (i32.eq (local output) 71i32))) (then (return 3i32)))
			(if (bool.or (i32.try_div 17i32 0i32 (borrow-mut (local output)))
				(bool.not (i32.eq (local output) 71i32))) (then (return 4i32)))
			(if (bool.or (i32.try_div -2147483648i32 -1i32 (borrow-mut (local output)))
				(bool.not (i32.eq (local output) 71i32))) (then (return 5i32)))
			(if (bool.or (i32.try_rem 17i32 0i32 (borrow-mut (local output)))
				(bool.not (i32.eq (local output) 71i32))) (then (return 6i32)))
			(if (bool.not (bool.and (i32.try_rem -2147483648i32 -1i32 (borrow-mut (local output)))
				(i32.eq (local output) 0i32))) (then (return 7i32)))
			(if (bool.not (bool.and (i32.try_div -43i32 5i32 (borrow-mut (local output)))
				(i32.eq (local output) -8i32))) (then (return 8i32)))
			(if (bool.not (bool.and (i32.try_rem -43i32 5i32 (borrow-mut (local output)))
				(i32.eq (local output) -3i32))) (then (return 9i32)))
			(if (bool.not (i32.try_sub (local output) -45i32 (borrow-mut (local output)))) (then (return 10i32)))
			(return (local output)))))
