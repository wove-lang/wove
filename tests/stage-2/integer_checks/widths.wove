(module recoverable_widths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(:expect (issues "gh:wove-lang/wove:381"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut small -128i8)
			(if (bool.or (i8.try_div (local small) -1i8 (borrow-mut (local small)))
				(bool.not (i32.eq (i32.from-i8 (local small)) -128i32))) (then (return 1i32)))
			(if (bool.not (bool.and (i8.try_rem (local small) -1i8 (borrow-mut (local small)))
				(i32.eq (i32.from-i8 (local small)) 0i32))) (then (return 2i32)))
			(let-mut byte 255u8)
			(if (bool.or (u8.try_add (local byte) 1u8 (borrow-mut (local byte)))
				(bool.not (u8.eq (local byte) 255u8))) (then (return 3i32)))
			(if (bool.not (bool.and (u8.try_sub (local byte) 213u8 (borrow-mut (local byte)))
				(u8.eq (local byte) 42u8))) (then (return 4i32)))
			(let-mut half -32768i16)
			(if (bool.or (i16.try_div (local half) -1i16 (borrow-mut (local half)))
				(bool.not (i16.eq (local half) -32768i16))) (then (return 5i32)))
			(if (bool.not (bool.and (i16.try_rem (local half) -1i16 (borrow-mut (local half)))
				(i16.eq (local half) 0i16))) (then (return 6i32)))
			(let-mut unsigned_half 65535u16)
			(if (bool.or (u16.try_add (local unsigned_half) 1u16 (borrow-mut (local unsigned_half)))
				(bool.not (u16.eq (local unsigned_half) 65535u16))) (then (return 7i32)))
			(if (bool.not (bool.and (u16.try_div (local unsigned_half) 3u16 (borrow-mut (local unsigned_half)))
				(u16.eq (local unsigned_half) 21845u16))) (then (return 8i32)))
			(let-mut word 4294967295u32)
			(if (bool.or (u32.try_sub 0u32 1u32 (borrow-mut (local word)))
				(bool.not (u32.eq (local word) 4294967295u32))) (then (return 9i32)))
			(if (bool.not (bool.and (u32.try_rem (local word) 2u32 (borrow-mut (local word)))
				(u32.eq (local word) 1u32))) (then (return 10i32)))
			(let-mut wide 18446744073709551615u64)
			(if (bool.or (u64.try_mul (local wide) 2u64 (borrow-mut (local wide)))
				(bool.not (u64.eq (local wide) 18446744073709551615u64))) (then (return 11i32)))
			(if (bool.not (bool.and (u64.try_div (local wide) 2u64 (borrow-mut (local wide)))
				(u64.eq (local wide) 9223372036854775807u64))) (then (return 12i32)))
			(if (bool.not (bool.and (u64.try_mul (local wide) 2u64 (borrow-mut (local wide)))
				(u64.eq (local wide) 18446744073709551614u64))) (then (return 13i32)))
			(return (i32.from-u8 (local byte))))))
