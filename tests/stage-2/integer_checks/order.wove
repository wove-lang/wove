(module recoverable_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cell (fields (value i32) (other i32)))

	(fn step
		(params (state (mut-ref i32)))
		(returns i32)
		(body
			(let previous state)
			(set state (i32.add state 1i32))
			(return previous)))

	(fn touch
		(params (state (mut-ref i32)))
		(returns i32)
		(body
			(set state 99i32)
			(return 25i32)))

	(fn update
		(params (value (mut-ref i32)))
		(returns bool)
		(body (return (i32.try_add value (call touch (borrow-mut value)) (borrow-mut value)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:381"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut cell (struct.new Cell (value 17i32) (other 23i32)))
			(if (bool.not (call update (borrow-mut (struct.get cell value)))) (then (return 1i32)))
			(if (bool.not (i32.eq (struct.get cell value) 42i32)) (then (return 2i32)))
			(let-mut state 7i32)
			(if (bool.not (i32.try_sub (call step (borrow-mut state)) (call step (borrow-mut state))
				(borrow-mut (struct.get cell other)))) (then (return 3i32)))
			(if (bool.not (i32.eq state 9i32)) (then (return 4i32)))
			(if (bool.not (i32.eq (struct.get cell other) -1i32)) (then (return 5i32)))
			(return (struct.get cell value)))))
