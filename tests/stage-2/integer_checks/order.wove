(module recoverable_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cell (fields (value i32) (other i32)))

	(fn step
		(params (state (mut-ref i32)))
		(returns i32)
		(body
			(let previous (local state))
			(set (local state) (i32.add (local state) 1i32))
			(return (local previous))))

	(fn touch
		(params (state (mut-ref i32)))
		(returns i32)
		(body
			(set (local state) 99i32)
			(return 25i32)))

	(fn update
		(params (value (mut-ref i32)))
		(returns bool)
		(body (return (i32.try_add (local value) (call touch (borrow-mut (local value))) (borrow-mut (local value))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:381"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut cell (struct.new Cell (value 17i32) (other 23i32)))
			(if (bool.not (call update (borrow-mut (struct.get (local cell) value)))) (then (return 1i32)))
			(if (bool.not (i32.eq (struct.get (local cell) value) 42i32)) (then (return 2i32)))
			(let-mut state 7i32)
			(if (bool.not (i32.try_sub (call step (borrow-mut (local state))) (call step (borrow-mut (local state)))
				(borrow-mut (struct.get (local cell) other)))) (then (return 3i32)))
			(if (bool.not (i32.eq (local state) 9i32)) (then (return 4i32)))
			(if (bool.not (i32.eq (struct.get (local cell) other) -1i32)) (then (return 5i32)))
			(return (struct.get (local cell) value)))))
