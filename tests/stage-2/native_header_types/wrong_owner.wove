(module unrelated_locale_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./locale.wove" (only))
	(use wove-file "./linux.wove" (only))
	(use c-header "<ctype.h>" (only isalpha_l))
	(use c-header "<locale.h>" (only (type OtherLocale)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let different (native.empty OtherLocale))
			(return (call isalpha_l 65i32 (borrow-shared (local different)))))))
