(module native_header_cycle
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./first.h"
		(use c-header "./second.h" (only (type Second)))
		(type First (c-type "int32_t"))
		(fn value (params (input Second)) (returns i32)))
	(bridge c-header "./second.h"
		(use c-header "./first.h" (only (type First)))
		(type Second (c-type "int32_t")))
	(use c-header "./first.h" (only value))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
