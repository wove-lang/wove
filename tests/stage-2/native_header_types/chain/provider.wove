(module chain_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./owner.h"
		(use c-header "./base.h" (only))
		(type Owner (:pragma (c_owned (drop release_chain))) (c-type "ChainOwner")))
	(bridge c-header "./consumer.h"
		(use c-header "./owner.h" (only))
		(use c-header "./owner.h" (only (type Owner)))
		(fn make_chain (params (value i32)) (returns Owner))
		(fn default_chain (params) (returns Owner))
		(fn read_chain (params (value (shared-ref Owner))) (returns i32))
		(fn count_chain_drops (params) (returns i32))))
