(module chain_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./consumer.h" (only make_chain read_chain count_chain_drops))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn exercise (params) (returns i32)
		(body
			(let owned (call make_chain 42i32))
			(return (call read_chain (borrow-shared (local owned))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let result (call exercise))
			(if (i32.not-eq (call count_chain_drops) 1i32) (then (return 1i32)))
			(return (local result)))))
