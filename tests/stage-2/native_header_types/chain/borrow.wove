(module chain_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./provider.wove" (only))
	(use c-header "./consumer.h" (only make_chain read_chain count_chain_drops))

	(fn exercise (params) (returns i32)
		(body
			(let owned (call make_chain 42i32))
			(return (call read_chain (borrow-shared owned)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call exercise))
			(if (i32:not-eq (call count_chain_drops) 1i32) (then (return 1i32)))
			(return result))))
