(module macos_classifier
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "<xlocale.h>"
		(use c-header "<ctype.h>" (only))
		(use c-header "<locale.h>" (only (type (as Locale ClassifierLocale))))
		(fn isalpha_l (params (character i32) (locale (shared-ref ClassifierLocale))) (returns i32))))
