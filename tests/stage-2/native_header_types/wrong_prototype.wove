(module wrong_locale_abi
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./locale.wove" (only))

	(bridge c-header "<stdlib.h>"
		(use c-header "<locale.h>" (only (type Locale)))
		(fn inspect (c-name "free") (params (locale (shared-ref Locale))) (returns void)))
	(use c-header "<stdlib.h>" (only inspect))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 0i32))))
