(module locale_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "<locale.h>"
		(type Locale (:pragma (c_owned (drop freelocale))) (c-type "locale_t"))
		(type OtherLocale (:pragma (c_owned (drop freelocale))) (c-type "locale_t"))
		(fn create (c-name "newlocale") (:pragma (c_cstr name))
			(params (const mask i32 LC_CTYPE_MASK) (name (shared-array u8)) (const base (c-type "locale_t") null))
			(returns Locale))))
