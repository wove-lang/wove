(module apply_locale
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./linux.wove" (only))
	(use wove-file "./macos.wove" (only))
	(use wove-file "./locale.wove" (only))
	(use (:pragma (cfg (os "linux"))) c-header "<ctype.h>" (only isalpha_l))
	(use (:pragma (cfg (os "macos"))) c-header "<xlocale.h>" (only isalpha_l))
	(use c-header "<locale.h>" (only create (type Locale)))

	(let c_locale "C")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let locale (call create (borrow-shared c_locale)))
			(if (owner.is-null locale) (then (return 1i32)))
			(if (i32.eqz (call isalpha_l 65i32 (borrow-shared locale))) (then (return 2i32)))
			(return 42i32))))
