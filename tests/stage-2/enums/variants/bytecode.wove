(module bytecode_payload
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Instruction (variants (Push i64) (Add) (Skip i32) (Table (array i32 2))))

	(fn argument
		(params (calls (mut-ref i32)))
		(returns i64)
		(body
			(set (local calls) (i32.add (local calls) 1i32))
			(return -9223372036854775808i64)))

	(fn decode
		(params (calls (mut-ref i32)))
		(returns Instruction)
		(body (return (enum.new Instruction Push (call argument (borrow-mut (local calls)))))))

	(fn evaluate
		(params (instruction Instruction))
		(returns i32)
		(body
			(match (local instruction)
				(case Push (bind word)
					(if (i64.eq (local word) -9223372036854775808i64) (then (return 42i32)))
					(return 1i32))
				(case Add (return 2i32))
				(case Skip (bind _) (return 3i32))
				(case Table (bind pair) (return (array.load (local pair) 1i32))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:376"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut calls 0i32)
			(let-mut outcome 0i32)
			(match (call decode (borrow-mut (local calls)))
				(case Push (bind word) (set (local outcome) (call evaluate (enum.new Instruction Push (local word)))))
				(case Add (return 4i32))
				(case Skip (bind ignored) (return 5i32))
				(case Table (bind ignored) (return 6i32)))
			(if (bool.not (i32.eq (local calls) 1i32)) (then (return 7i32)))
			(if (bool.not (i32.eq (call evaluate (enum.new Instruction Add)) 2i32)) (then (return 8i32)))
			(if (bool.not (i32.eq (call evaluate (enum.new Instruction Skip 7i32)) 3i32)) (then (return 9i32)))
			(if (bool.not (i32.eq (call evaluate (enum.new Instruction Table (array.new (array i32 2) 7i32 19i32))) 19i32))
				(then (return 10i32)))
			(return (local outcome)))))
