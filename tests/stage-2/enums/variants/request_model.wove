(module request_model
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Envelope (fields (parsed Parsed)))
	(enum Parsed (variants (Record Request) (Invalid)))
	(struct Request (fields (key Key) (status u32) (latency u32)))
	(struct Key (fields (start i32) (end i32) (hash u32)))

	(fn parse
		(params (line (shared-array u8)))
		(returns Envelope)
		(body
			(if (i32:eq (array:len line) 0i32)
				(then (return (struct:new Envelope (parsed Parsed:Invalid)))))
			(let key (struct:new Key (start 0i32) (end (array:len line)) (hash 4294967295u32)))
			(let request (struct:new Request (key key) (status 201u32) (latency 42u32)))
			(return (struct:new Envelope (parsed (Parsed:Record request)))))))
