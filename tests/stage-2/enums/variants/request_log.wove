(module request_log_payload
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./request_model.wove" (only (type (as Parsed Incoming)) parse))
	(let request_name "lookup")
	(let empty "")

	(fn consume
		(params (parsed Incoming))
		(returns i32)
		(body
			(match parsed
				(case Record (let request)
					(let-mut copy request)
					(set (struct.get copy status) 500u32)
					(if (bool.not (u32.eq (struct.get request status) 201u32)) (then (return 3i32)))
					(if (bool.not (i32.eq (struct.get (struct.get request key) end) 6i32)) (then (return 4i32)))
					(if (bool.not (u32.eq (struct.get (struct.get request key) hash) 4294967295u32)) (then (return 5i32)))
					(return (i32.from-u32 (struct.get copy latency))))
				(case Invalid (return 2i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:376"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (i32.lt 0i32 (i32.dec (array.len args)))
				(then (return (call consume (struct.get (call parse (borrow-shared empty)) parsed)))))
			(return (call consume (struct.get (call parse (borrow-shared request_name)) parsed))))))
