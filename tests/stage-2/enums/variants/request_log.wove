(module request_log_payload
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./request_model.wove" (only (type (as Parsed Incoming)) parse))
	(struct ArgSpan (fields (start i32) (end i32)))
	(let request_name "lookup")
	(let empty "")

	(fn consume
		(params (parsed Incoming))
		(returns i32)
		(body
			(match (local parsed)
				(case Record (bind request)
					(let-mut copy (local request))
					(set (struct.get (local copy) status) 500u32)
					(if (bool.not (u32.eq (struct.get (local request) status) 201u32)) (then (return 3i32)))
					(if (bool.not (i32.eq (struct.get (struct.get (local request) key) end) 6i32)) (then (return 4i32)))
					(if (bool.not (u32.eq (struct.get (struct.get (local request) key) hash) 4294967295u32)) (then (return 5i32)))
					(return (i32.from-u32 (struct.get (local copy) latency))))
				(case Invalid (return 2i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:376"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(if (i32.lt 0i32 (array.len (local args)))
				(then (return (call consume (struct.get (call parse (borrow-shared (local empty))) parsed)))))
			(return (call consume (struct.get (call parse (borrow-shared (local request_name))) parsed))))))
