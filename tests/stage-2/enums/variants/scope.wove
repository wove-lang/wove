(module payload_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Token (variants (Number i32) (End)))
	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(match (enum.new Token Number 42i32) (case Number (bind payload)) (case End))
			(return (local payload)))))
