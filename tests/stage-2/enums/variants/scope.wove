(module payload_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Token (variants (Number i32) (End)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(match (enum.new Token Number 42i32) (case Number (bind payload)) (case End))
			(return (local payload)))))
