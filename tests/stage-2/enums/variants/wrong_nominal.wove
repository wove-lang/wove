	(enum Token (variants (Entry Left) (End)))
	(struct Left (fields (value i32)))
	(struct Right (fields (value i32)))
	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let token (enum:new Token Entry (struct:new Right (value 42i32))))
			(return 0i32))))
