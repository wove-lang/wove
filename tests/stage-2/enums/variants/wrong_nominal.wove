	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Token (variants (Entry Left) (End)))
	(struct Left (fields (value i32)))
	(struct Right (fields (value i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let token (enum.new Token Entry (struct.new Right (value 42i32))))
			(return 0i32))))
