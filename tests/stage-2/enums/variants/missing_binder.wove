(module payload_missing_binder
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Token (variants (Number i32) (End)))
	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(match (enum:new Token Number 42i32)
				(case Number (return 0i32)) (case End (return 1i32))))))
