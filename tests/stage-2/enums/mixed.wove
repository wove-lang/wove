(module enum_mixed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Status (variants (Ok) (Error)))
	(enum Other (variants (Ok) (Error)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body (let-mut value (enum.new Status Ok)) (set (local value) (enum.new Other Ok)) (return 0i32))))
