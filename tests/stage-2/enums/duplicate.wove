(module enum_duplicate
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Status (variants (Ok) (Error)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body (match (enum.new Status Ok) (case Ok (return 0i32)) (case Ok (return 1i32))))))
