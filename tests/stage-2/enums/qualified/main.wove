(module enum_constructors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./model.wove" (only (type (as Status status))))

	(enum Bag (variants (Empty) (Data (owned-array u8))))
	(enum Mode (variants (On) (Off)))
	(struct Selection (generic (const choice Mode)) (fields (code i32)))

	(fn observe (params (value status)) (returns u32)
		(body
			(match value
				(case Ok (return 0u32))
				(case IoError (let code) (return code)))))

	(fn payload (params (calls (mut-ref i32))) (returns u32)
		(body
			(set calls calls.inc)
			(return 18u32)))

	(fn wrapped_owner (params) (returns Bag)
		(body
			(let bytes (array:alloc u8 3i32))
			(return (Bag.new Data (move bytes)))))

	(fn short_owner (params) (returns Bag)
		(body
			(let bytes (array:alloc u8 3i32))
			(return (Bag:Data (move bytes)))))

	(fn size (params (shortened bool)) (returns i32)
		(body
			(let value (if shortened (then (call short_owner)) (else (call wrapped_owner))))
			(match (move value)
				(case Empty (return 0i32))
				(case Data (let bytes) (return bytes.len)))))

	(fn default_value (generic (type T)) (params) (returns T)
		(body (return T:Ok)))

	(fn pick (generic (const choice Mode)) (params) (returns i32)
		(body
			(match choice
				(case On (return 0i32))
				(case Off (return 1i32)))))

	(fn selected
		(params (value (specialize Selection (Mode.new On))))
		(returns i32)
		(body (return value/code)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let status 4i32)
			(let-mut calls 0i32)
			(let explicit (status.new (:doc "One payload evaluation.") IoError (call payload (borrow-mut calls))))
			(let short (status:IoError 18u32))
			(if (i32:not-eq calls 1i32) (then (return 1i32)))
			(if (u32:not-eq (call observe explicit) (call observe short)) (then (return 2i32)))
			(if (u32:not-eq (call observe status:Ok) (call observe (status:Ok))) (then (return 3i32)))
			(if (u32:not-eq (call observe (status.new Ok)) (call observe (enum:new status Ok))) (then (return 4i32)))
			(if (u32:not-eq (call observe (call (specialize default_value status))) 0u32) (then (return 5i32)))
			(if (i32:not-eq (call (specialize pick Mode:On)) 0i32) (then (return 6i32)))
			(if (i32:not-eq (call (specialize pick (Mode.new On))) 0i32) (then (return 7i32)))
			(if (i32:not-eq (call size (bool false)) 3i32) (then (return 8i32)))
			(if (i32:not-eq (call size (bool true)) 3i32) (then (return 9i32)))
			(let marker (struct:new (specialize Selection Mode:On) (code 20i32)))
			(return (i32:add status (i32:add (int:convert i32 (call observe short)) (call selected marker)))))))
