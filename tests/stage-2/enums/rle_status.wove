(module rle_status
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Status (variants (Ok) (IoError) (Invalid)))

	(fn run_codec
		(params (mode i32) (hits (mut-array u8)))
		(returns Status)
		(body
			(let previous (u32.from-u8 (array.load (local hits) 0i32)))
			(array.store (local hits) 0i32 (u8.from-u32 (u32.add (local previous) 1u32)))
			(let-mut status (enum.new Status Ok))
			(if (i32.eq (local mode) 1i32)
				(then (set (local status) (enum.new Status IoError))))
			(if (i32.lt 1i32 (local mode))
				(then (set (local status) (enum.new Status Invalid))))
			(return (local status))))

	(fn report
		(params (status Status))
		(returns i32)
		(body
			(match (local status)
				(case Ok (return 0i32))
				(case IoError (return 1i32))
				(case Invalid (return 3i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:356"))
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut hits (array.alloc u8 1i32))
			(match (call run_codec (i32.dec (array.len (local argv))) (borrow-mut (local hits)))
				(case Invalid
					(if (bool.not (u8.eq (array.load (local hits) 0i32) 1u8)) (then (return 4i32)))
					(return (call report (enum.new Status Invalid))))
				(case Ok
					(if (bool.not (u8.eq (array.load (local hits) 0i32) 1u8)) (then (return 4i32)))
					(return (call report (enum.new Status Ok))))
				(case IoError
					(if (bool.not (u8.eq (array.load (local hits) 0i32) 1u8)) (then (return 4i32)))
					(return (call report (enum.new Status IoError))))))))
