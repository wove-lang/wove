(module rle_status
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Status (variants (Ok) (IoError) (Invalid)))

	(fn run_codec
		(params (mode i32) (hits (mut-array u8)))
		(returns Status)
		(body
			(let previous (u32:from-u8 (array:get hits 0i32)))
			(array:set hits 0i32 (u8:from-u32 (u32:add previous 1u32)))
			(let-mut status Status:Ok)
			(if (i32:eq mode 1i32)
				(then (set status Status:IoError)))
			(if (i32:lt 1i32 mode)
				(then (set status Status:Invalid)))
			(return status)))

	(fn report
		(params (status Status))
		(returns i32)
		(body
			(match status
				(case Ok (return 0i32))
				(case IoError (return 1i32))
				(case Invalid (return 3i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:356"))
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut hits (array:alloc u8 1i32))
			(match (call run_codec (i32:dec (array:len argv)) (borrow-mut hits))
				(case Invalid
					(if (bool:not (u8:eq (array:get hits 0i32) 1u8)) (then (return 4i32)))
					(return (call report Status:Invalid)))
				(case Ok
					(if (bool:not (u8:eq (array:get hits 0i32) 1u8)) (then (return 4i32)))
					(return (call report Status:Ok)))
				(case IoError
					(if (bool:not (u8:eq (array:get hits 0i32) 1u8)) (then (return 4i32)))
					(return (call report Status:IoError)))))))
