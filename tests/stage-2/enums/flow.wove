(module enum_flow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./model.wove" (only (type (as Stream Signal)) start))
	(enum Channel (variants (Ready) (Quiet)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct SignalBox (fields (signal Signal)))

	(fn dispatch
		(params (channel Channel) (signal Signal))
		(returns i32)
		(body
			(let-mut number 1i32)
			(match (local channel)
				(case Quiet
					(let scratch (array.alloc u8 1i32))
					(return (array.len (local scratch))))
				(case Ready
					(let scratch (array.alloc u8 2i32))
					(match (local signal)
						(case Ready (set (local number) (array.len (local scratch))))
						(case Quiet (return 3i32)))))
			(match (local signal)
				(case Quiet)
				(case Ready (set (local number) (i32.add.wrapping (local number) 40i32))))
			(return (local number))))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let box (struct.new SignalBox (signal (call start))))
			(if (i32.lt 0i32 (array.len (local args)))
				(then (return (call dispatch (enum.new Channel Quiet) (enum.new Signal Quiet)))))
			(return (call dispatch (enum.new Channel Ready) (struct.get (local box) signal))))))
