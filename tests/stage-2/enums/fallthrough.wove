(module enum_fallthrough
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Status (variants (Ok) (Error)))
	(fn main (params (args (shared-array (shared-array u8))))
		(returns i32)
		(body (match (enum.new Status Ok) (case Ok (return 0i32)) (case Error)))))
