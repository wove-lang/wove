(module blake2b_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../stage-2/hashing/blake2b.wove" (only (type Blake2b) blake2b
		blake2b_update blake2b_number blake2b_field blake2b_words blake2b_finish))
	(use wove-file "../../../../stage-2/text/bytes.wove" (only same_bytes))

	(fn check_raw
		(params (input (shared-array u8)) (split i32)
			(early_raw (shared-array u8)) (early_text (shared-array u8))
			(final_raw (shared-array u8)) (final_text (shared-array u8)))
		(returns i32)
		(body
			(let-mut state (call blake2b))
			(call blake2b_update (borrow-mut state)
				(borrow-shared (array:range input (i32 0) split)))
			(if (bool:not (call matches state
				(borrow-shared early_raw) (borrow-shared early_text)))
				(then (return (i32 1))))
			(call blake2b_update (borrow-mut state)
				(borrow-shared (array:range input split split)))
			(if (bool:not (call matches state
				(borrow-shared early_raw) (borrow-shared early_text)))
				(then (return (i32 2))))
			(call blake2b_update (borrow-mut state)
				(borrow-shared (array:range input split (array:len input))))
			(if (bool:not (call matches state
				(borrow-shared final_raw) (borrow-shared final_text)))
				(then (return (i32 3))))
			(set state (call blake2b))
			(call blake2b_update (borrow-mut state) (borrow-shared input))
			(if (bool:not (call matches state
				(borrow-shared final_raw) (borrow-shared final_text)))
				(then (return (i32 4))))
			(return (i32 0))))

	(fn check_fields
		(params (input (shared-array u8)) (split i32)
			(expected_raw (shared-array u8)) (expected_text (shared-array u8)))
		(returns i32)
		(body
			(let-mut state (call blake2b))
			(call blake2b_number (borrow-mut state) (u64 81985529216486895))
			(call blake2b_field (borrow-mut state)
				(borrow-shared (array:range input (i32 0) split)))
			(call blake2b_field (borrow-mut state)
				(borrow-shared (array:range input split split)))
			(call blake2b_number (borrow-mut state) (u64 18446744073709551615))
			(call blake2b_field (borrow-mut state)
				(borrow-shared (array:range input split (array:len input))))
			(if (bool:not (call matches state
				(borrow-shared expected_raw) (borrow-shared expected_text)))
				(then (return (i32 5))))
			(return (i32 0))))

	(fn matches
		(params (state Blake2b) (expected_raw (shared-array u8)) (expected_text (shared-array u8)))
		(returns bool)
		(body
			(let words (call blake2b_words state))
			(let text (call blake2b_finish state))
			(return (call check_outputs words (borrow-shared text)
				(borrow-shared expected_raw) (borrow-shared expected_text)))))

	(fn check_outputs
		(params (words (array u64 4)) (text (shared-array u8))
			(expected_raw (shared-array u8)) (expected_text (shared-array u8)))
		(returns bool)
		(body
			(if (bool:not (bool:and (i32:eq (array:len expected_raw) (i32 32))
				(i32:eq (array:len text) (i32 43))))
				(then (return (bool false))))
			(let-mut index (i32 0))
			(while
				(i32:lt index (i32 32))
				(body
					(let word (array:get words (i32:div index (i32 8))))
					(let shift (i32:mul (i32:rem index (i32 8)) (i32 8)))
					(let byte (int:convert u8 (u64:and (u64:shr word shift) (u64 255))))
					(if (bool:not (u8:eq byte (array:get expected_raw index)))
						(then (return (bool false))))
					(set index (i32:add index (i32 1)))))
			(return (call same_bytes (borrow-shared text) (i32 0) (array:len text)
				(borrow-shared expected_text) (i32 0) (array:len expected_text)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0)))))
