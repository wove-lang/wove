(module blake2b_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../stage-2/hashing/blake2b.wove" (only blake2b_state_width blake2b_init
		blake2b_update blake2b_number blake2b_field blake2b_digest blake2b_finish))
	(use wove-file "../../../../stage-2/hashing/blake2b/word.wove" (only (type Blake2bWord) word))
	(use wove-file "../../../../stage-2/text/bytes.wove" (only same_bytes))

	(fn check_raw
		(params (input (shared-slice u8)) (split i32)
			(early_raw (shared-slice u8)) (early_text (shared-slice u8))
			(final_raw (shared-slice u8)) (final_text (shared-slice u8)))
		(returns i32)
		(body
			(let-mut state (array.alloc Blake2bWord (call blake2b_state_width)))
			(call blake2b_init (borrow-mut (local state)))
			(call blake2b_update (borrow-mut (local state))
				(borrow-shared (slice.range (local input) (i32 0) (local split))))
			(if (bool.not (call matches (borrow-shared (local state))
				(borrow-shared (local early_raw)) (borrow-shared (local early_text))))
				(then (return (i32 1))))
			(call blake2b_update (borrow-mut (local state))
				(borrow-shared (slice.range (local input) (local split) (local split))))
			(if (bool.not (call matches (borrow-shared (local state))
				(borrow-shared (local early_raw)) (borrow-shared (local early_text))))
				(then (return (i32 2))))
			(call blake2b_update (borrow-mut (local state))
				(borrow-shared (slice.range (local input) (local split) (slice.len (local input)))))
			(if (bool.not (call matches (borrow-shared (local state))
				(borrow-shared (local final_raw)) (borrow-shared (local final_text))))
				(then (return (i32 3))))
			(call blake2b_init (borrow-mut (local state)))
			(call blake2b_update (borrow-mut (local state)) (borrow-shared (local input)))
			(if (bool.not (call matches (borrow-shared (local state))
				(borrow-shared (local final_raw)) (borrow-shared (local final_text))))
				(then (return (i32 4))))
			(return (i32 0))))

	(fn check_fields
		(params (input (shared-slice u8)) (split i32)
			(expected_raw (shared-slice u8)) (expected_text (shared-slice u8)))
		(returns i32)
		(body
			(let-mut state (array.alloc Blake2bWord (call blake2b_state_width)))
			(call blake2b_init (borrow-mut (local state)))
			(call blake2b_number (borrow-mut (local state)) (call word (u32 2309737967) (u32 19088743)))
			(call blake2b_field (borrow-mut (local state))
				(borrow-shared (slice.range (local input) (i32 0) (local split))))
			(call blake2b_field (borrow-mut (local state))
				(borrow-shared (slice.range (local input) (local split) (local split))))
			(call blake2b_number (borrow-mut (local state)) (call word (u32 4294967295) (u32 4294967295)))
			(call blake2b_field (borrow-mut (local state))
				(borrow-shared (slice.range (local input) (local split) (slice.len (local input)))))
			(if (bool.not (call matches (borrow-shared (local state))
				(borrow-shared (local expected_raw)) (borrow-shared (local expected_text))))
				(then (return (i32 5))))
			(return (i32 0))))

	(fn matches
		(params (state (shared-slice Blake2bWord)) (expected_raw (shared-slice u8)) (expected_text (shared-slice u8)))
		(returns bool)
		(body
			(let-mut raw (array.alloc u8 (i32 33)))
			(let-mut text (array.alloc u8 (i32 53)))
			(return (call check_outputs (borrow-shared (local state)) (borrow-shared (local expected_raw))
				(borrow-shared (local expected_text)) (borrow-mut (local raw)) (borrow-mut (local text))))))

	(fn check_outputs
		(params (state (shared-slice Blake2bWord)) (expected_raw (shared-slice u8)) (expected_text (shared-slice u8))
			(raw (mut-slice u8)) (text (mut-slice u8)))
		(returns bool)
		(body
			(slice.store (local raw) (i32 32) (u8 165))
			(slice.store (local text) (i32 52) (u8 165))
			(if (bool.not (bool.and (call blake2b_digest (borrow-shared (local state)) (borrow-mut (local raw)))
				(call blake2b_finish (borrow-shared (local state)) (borrow-mut (local text)))))
				(then (return (bool false))))
			(if (bool.not (bool.and (u8.eq (slice.load (local raw) (i32 32)) (u8 165))
				(u8.eq (slice.load (local text) (i32 52)) (u8 165))))
				(then (return (bool false))))
			(return (bool.and
				(call same_bytes (borrow-shared (local raw)) (i32 0) (i32 32)
					(borrow-shared (local expected_raw)) (i32 0) (slice.len (local expected_raw)))
				(call same_bytes (borrow-shared (local text)) (i32 0) (i32 52)
					(borrow-shared (local expected_text)) (i32 0) (slice.len (local expected_text)))))))

	(fn main (params) (returns i32) (body (return (i32 0)))))
