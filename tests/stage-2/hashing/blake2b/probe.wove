(module blake2b_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../stage-2/hashing/blake2b.wove" (only (type Blake2b) blake2b
		blake2b_update blake2b_number blake2b_field blake2b_words blake2b_finish))
	(use wove-file "../../../../stage-2/text/bytes.wove" (only same_bytes))

	(fn check_raw
		(params (input (shared-array u8)) (split i32)
			(early_raw (shared-array u8)) (early_text (shared-array u8))
			(final_raw (shared-array u8)) (final_text (shared-array u8)))
		(returns i32)
		(body
			(let-mut state (call blake2b))
			(call blake2b_update (borrow-mut (local state))
				(borrow-shared (array.range (local input) (i32 0) (local split))))
			(if (bool.not (call matches (local state)
				(borrow-shared (local early_raw)) (borrow-shared (local early_text))))
				(then (return (i32 1))))
			(call blake2b_update (borrow-mut (local state))
				(borrow-shared (array.range (local input) (local split) (local split))))
			(if (bool.not (call matches (local state)
				(borrow-shared (local early_raw)) (borrow-shared (local early_text))))
				(then (return (i32 2))))
			(call blake2b_update (borrow-mut (local state))
				(borrow-shared (array.range (local input) (local split) (array.len (local input)))))
			(if (bool.not (call matches (local state)
				(borrow-shared (local final_raw)) (borrow-shared (local final_text))))
				(then (return (i32 3))))
			(set (local state) (call blake2b))
			(call blake2b_update (borrow-mut (local state)) (borrow-shared (local input)))
			(if (bool.not (call matches (local state)
				(borrow-shared (local final_raw)) (borrow-shared (local final_text))))
				(then (return (i32 4))))
			(return (i32 0))))

	(fn check_fields
		(params (input (shared-array u8)) (split i32)
			(expected_raw (shared-array u8)) (expected_text (shared-array u8)))
		(returns i32)
		(body
			(let-mut state (call blake2b))
			(call blake2b_number (borrow-mut (local state)) (u64 81985529216486895))
			(call blake2b_field (borrow-mut (local state))
				(borrow-shared (array.range (local input) (i32 0) (local split))))
			(call blake2b_field (borrow-mut (local state))
				(borrow-shared (array.range (local input) (local split) (local split))))
			(call blake2b_number (borrow-mut (local state)) (u64 18446744073709551615))
			(call blake2b_field (borrow-mut (local state))
				(borrow-shared (array.range (local input) (local split) (array.len (local input)))))
			(if (bool.not (call matches (local state)
				(borrow-shared (local expected_raw)) (borrow-shared (local expected_text))))
				(then (return (i32 5))))
			(return (i32 0))))

	(fn matches
		(params (state Blake2b) (expected_raw (shared-array u8)) (expected_text (shared-array u8)))
		(returns bool)
		(body
			(let words (call blake2b_words (local state)))
			(let text (call blake2b_finish (local state)))
			(return (call check_outputs (local words) (borrow-shared (local text))
				(borrow-shared (local expected_raw)) (borrow-shared (local expected_text))))))

	(fn check_outputs
		(params (words (array u64 4)) (text (shared-array u8))
			(expected_raw (shared-array u8)) (expected_text (shared-array u8)))
		(returns bool)
		(body
			(if (bool.not (bool.and (i32.eq (array.len (local expected_raw)) (i32 32))
				(i32.eq (array.len (local text)) (i32 52))))
				(then (return (bool false))))
			(let-mut index (i32 0))
			(while
				(i32.lt (local index) (i32 32))
				(body
					(let word (array.load (local words) (i32.div (local index) (i32 8))))
					(let shift (i32.mul.wrapping (i32.rem (local index) (i32 8)) (i32 8)))
					(let byte (int.convert u8 (u64.and (u64.shr (local word) (local shift)) (u64 255))))
					(if (bool.not (u8.eq (local byte) (array.load (local expected_raw) (local index))))
						(then (return (bool false))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call same_bytes (borrow-shared (local text)) (i32 0) (array.len (local text))
				(borrow-shared (local expected_text)) (i32 0) (array.len (local expected_text))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 0)))))
