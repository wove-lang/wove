(module hashing_base32hex_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/hashing/base32hex.wove" (only base32hex31_width encode_base32hex31))

	(fn matches
		(params (bytes (shared-slice u8)) (first u8) (middle u8) (sixth u8) (last u8))
		(returns bool)
		(body
			(if (bool.not (bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 0))
					(u8.eq (slice.load (local bytes) (i32 8)) (u8 0))))
				(then (return (bool false))))
			(let-mut index (i32 2))
			(while (i32.lt (local index) (i32 6))
				(body
					(if (bool.not (u8.eq (slice.load (local bytes) (local index)) (local middle)))
						(then (return (bool false))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (bool.and (u8.eq (slice.load (local bytes) (i32 1)) (local first))
				(bool.and (u8.eq (slice.load (local bytes) (i32 6)) (local sixth))
					(u8.eq (slice.load (local bytes) (i32 7)) (local last)))))))

	(fn main
		(:expect
			(tests "stage-2/hashing/base32hex.wove")
			(issues "gh:wove-lang/wove:91"))
		(params)
		(returns i32)
		(body
			(if (bool.not (i32.eq (call base32hex31_width) (i32 7)))
				(then (return (i32 1))))
			(let-mut bytes (array.alloc u8 (i32 9)))
			(if (bool.not (bool.and
					(call encode_base32hex31 (u32 0) (borrow-mut (local bytes)) (i32 1))
					(call matches (borrow-shared (local bytes)) (u8 48) (u8 48) (u8 48) (u8 48))))
				(then (return (i32 2))))
			(if (bool.not (bool.and
					(call encode_base32hex31 (u32 31) (borrow-mut (local bytes)) (i32 1))
					(call matches (borrow-shared (local bytes)) (u8 48) (u8 48) (u8 48) (u8 118))))
				(then (return (i32 3))))
			(if (bool.not (bool.and
					(call encode_base32hex31 (u32 32) (borrow-mut (local bytes)) (i32 1))
					(call matches (borrow-shared (local bytes)) (u8 48) (u8 48) (u8 49) (u8 48))))
				(then (return (i32 4))))
			(if (bool.not (bool.and
					(call encode_base32hex31 (u32 2147483647) (borrow-mut (local bytes)) (i32 1))
					(call matches (borrow-shared (local bytes)) (u8 49) (u8 118) (u8 118) (u8 118))))
				(then (return (i32 5))))
			(if (call encode_base32hex31 (u32 2147483648) (borrow-mut (local bytes)) (i32 1))
				(then (return (i32 6))))
			(if (call encode_base32hex31 (u32 0) (borrow-mut (local bytes)) (i32 3))
				(then (return (i32 7))))
			(if (bool.not (call matches (borrow-shared (local bytes)) (u8 49) (u8 118) (u8 118) (u8 118)))
				(then (return (i32 8))))
			(return (i32 0)))))
