(module hashing_base62_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/hashing/base62.wove" (only base62_width encode_base62_padded write_base62_filename))
	(use (:pragma (cfg (not bootstrap))) wove-file "../../../stage-2/hashing/base62.wove"
		(only digest_base62 (value digest_base62_width)))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(fn padded_matches
		(params (value u32) (width i32) (expected (shared-array u8)))
		(returns bool)
		(body
			(let-mut output (array:alloc u8 8i32))
			(if (bool:not (call encode_base62_padded value (borrow-mut output) 1i32 width))
				(then (return (bool false))))
			(return (bool:and
				(call same_bytes (borrow-shared output) 1i32 (i32:inc width) (borrow-shared expected) 0i32 width)
				(bool:and (u8:eqz (array:get output 0i32)) (u8:eqz (array:get output (i32:inc width))))))))

	(let zero_digest "0000000000000000000000000000000000000000000")
	(let full_digest "YHJSKWDa6oz1al1yMhwzwM8llg7hJNUca2J5RoW8xP1")
	(let ascending_digest "003AuLtjc7TJLctqJ2Unu3mfAGcxg9lrkrCWgKbidLF")

	(fn digest_matches
		(:pragma (cfg (not bootstrap)))
		(params (words (array u32 8)) (expected (shared-array u8)))
		(returns bool)
		(body
			(let encoded (call digest_base62 words))
			(return (call matches_bytes (borrow-shared encoded) (borrow-shared expected)))))

	(fn matches_bytes
		(:pragma (cfg (not bootstrap)))
		(params (encoded (shared-array u8)) (expected (shared-array u8)))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared encoded) (i32 0) (array:len encoded)
				(borrow-shared expected) (i32 0) (array:len expected)))))

	(fn check_digests
		(:pragma (cfg bootstrap))
		(params)
		(returns i32)
		(body (return (i32 0))))

	(fn check_digests
		(:pragma (cfg (not bootstrap)))
		(params)
		(returns i32)
		(body
			(if (bool:not (i32:eq digest_base62_width 43i32))
				(then (return (i32 9))))
			(if (bool:not (call digest_matches (array:repeat (array u32 8) (u32 0)) (borrow-shared zero_digest)))
				(then (return (i32 10))))
			(if (bool:not (call digest_matches (array:repeat (array u32 8) (u32 4294967295)) (borrow-shared full_digest)))
				(then (return (i32 11))))
			(let ascending (array:new (array u32 8)
				(u32 66051) (u32 67438087) (u32 134810123) (u32 202182159) (u32 269554195)
				(u32 336926231) (u32 404298267) (u32 471670303)))
			(if (bool:not (call digest_matches ascending (borrow-shared ascending_digest)))
				(then (return (i32 12))))
			(return (i32 0))))

	(fn main
		(:expect (tests "stage-2/hashing/base62.wove"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (i32:eq (call base62_width 0u32) 1i32)) (then (return 1i32)))
			(if (bool:not (call padded_matches 0u32 6i32 "000000")) (then (return 2i32)))
			(if (bool:not (call padded_matches 61u32 1i32 "Z")) (then (return 3i32)))
			(if (bool:not (call padded_matches 62u32 2i32 "10")) (then (return 4i32)))
			(if (bool:not (call padded_matches 4294967295u32 6i32 "4GFfc3")) (then (return 5i32)))
			(let-mut output (array:alloc u8 2i32))
			(array:set output 1i32 33u8)
			(if (call encode_base62_padded 62u32 (borrow-mut output) 1i32 1i32) (then (return 6i32)))
			(if (call encode_base62_padded 0u32 (borrow-mut output) 2i32 1i32) (then (return 7i32)))
			(if (u8:not-eq (array:get output 1i32) 33u8) (then (return 8i32)))
			(let-mut digits (array:alloc u8 3i32))
			(let short (call write_base62_filename 10u32 (borrow-mut digits) 0i32 1i32))
			(if (bool:not (i32:eq short 1i32)) (then (return 13i32)))
			(let escaped (call write_base62_filename 36u32 (borrow-mut digits) short 1i32))
			(if (bool:not (i32:eq escaped 3i32)) (then (return 14i32)))
			(if (bool:not (call same_bytes (borrow-shared digits) 0i32 3i32 "a_a" 0i32 3i32))
				(then (return 15i32)))
			(return (call check_digests)))))
