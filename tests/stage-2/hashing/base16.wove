(module hashing_base16_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/hashing/base16.wove" (only base16_digit))

	(fn main
		(params)
		(returns i32)
		(body
			(:doc "Check the ASCII bytes of 0123456789abcdef in nibble order.")
			(if (bool.not (u8.eq (call base16_digit (u32 0)) (u8 48)))
				(then (return (i32 1))))
			(if (bool.not (u8.eq (call base16_digit (u32 1)) (u8 49)))
				(then (return (i32 2))))
			(if (bool.not (u8.eq (call base16_digit (u32 2)) (u8 50)))
				(then (return (i32 3))))
			(if (bool.not (u8.eq (call base16_digit (u32 3)) (u8 51)))
				(then (return (i32 4))))
			(if (bool.not (u8.eq (call base16_digit (u32 4)) (u8 52)))
				(then (return (i32 5))))
			(if (bool.not (u8.eq (call base16_digit (u32 5)) (u8 53)))
				(then (return (i32 6))))
			(if (bool.not (u8.eq (call base16_digit (u32 6)) (u8 54)))
				(then (return (i32 7))))
			(if (bool.not (u8.eq (call base16_digit (u32 7)) (u8 55)))
				(then (return (i32 8))))
			(if (bool.not (u8.eq (call base16_digit (u32 8)) (u8 56)))
				(then (return (i32 9))))
			(if (bool.not (u8.eq (call base16_digit (u32 9)) (u8 57)))
				(then (return (i32 10))))
			(if (bool.not (u8.eq (call base16_digit (u32 10)) (u8 97)))
				(then (return (i32 11))))
			(if (bool.not (u8.eq (call base16_digit (u32 11)) (u8 98)))
				(then (return (i32 12))))
			(if (bool.not (u8.eq (call base16_digit (u32 12)) (u8 99)))
				(then (return (i32 13))))
			(if (bool.not (u8.eq (call base16_digit (u32 13)) (u8 100)))
				(then (return (i32 14))))
			(if (bool.not (u8.eq (call base16_digit (u32 14)) (u8 101)))
				(then (return (i32 15))))
			(if (bool.not (u8.eq (call base16_digit (u32 15)) (u8 102)))
				(then (return (i32 16))))
			(return (i32 0)))))
