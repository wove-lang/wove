(module hashing_base16_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/emit/text.wove" (only c_hex_byte))

	(let expected "0123456789abcdef")

	(fn check_bytes
		(params (output (mut-array u8)))
		(returns i32)
		(body
			(let-mut high (i32 0))
			(while (i32:lt high (i32 16))
				(body
					(let-mut low (i32 0))
					(while (i32:lt low (i32 16))
						(body
							(let byte (int:convert u8 (u32:or
								(u32:shl (int:convert u32 high) (i32 4))
								(int:convert u32 low))))
							(let end (call c_hex_byte byte (borrow-mut output) (u32 1) (bool true)))
							(if (bool:not (bool:and (u32:eq end (u32 3))
									(bool:and
										(u8:eq (array:load output (i32 1)) (array:load expected high))
										(u8:eq (array:load output (i32 2)) (array:load expected low)))))
								(then (return (i32 1))))
							(set low (i32:add low (i32 1)))))
					(set high (i32:add high (i32 1)))))
			(let count (call c_hex_byte (u8 0) (borrow-mut output) (u32 1) (bool false)))
			(if (bool:not (bool:and (u32:eq count (u32 3))
					(bool:and
						(u8:eq (array:load output (i32 0)) (u8 0))
						(bool:and
							(u8:eq (array:load output (i32 1)) (u8 102))
							(bool:and
								(u8:eq (array:load output (i32 2)) (u8 102))
								(u8:eq (array:load output (i32 3)) (u8 0)))))))
				(then (return (i32 2))))
			(return (i32 0))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut output (array:alloc u8 (i32 4)))
			(return (call check_bytes (borrow-mut output))))))
