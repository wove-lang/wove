(module hashing_fnv1a_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/hashing/fnv1a.wove" (only (value fnv1a_seed) fnv1a_byte fnv1a_span fnv1a_u32_le))

	(let text "xhelloy")

	(fn main
		(:expect
			(tests "stage-2/hashing/fnv1a.wove")
			(issues "gh:wove-lang/wove:91" "gh:wove-lang/wove:812"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let seed fnv1a_seed)
			(if (bool:not (u32:eq seed 0x811c9dc5u32))
				(then (return (i32 1))))
			(let h (call fnv1a_byte seed (u8 104)))
			(let he (call fnv1a_byte h (u8 101)))
			(let hel (call fnv1a_byte he (u8 108)))
			(let hell (call fnv1a_byte hel (u8 108)))
			(let hello (call fnv1a_byte hell (u8 111)))
			(if (bool:not (u32:eq hello (u32 1335831723)))
				(then (return (i32 2))))
			(let zero (call fnv1a_byte seed (u8 0)))
			(let raw (call fnv1a_byte zero (u8 255)))
			(if (bool:not (u32:eq raw 0xd277c7a0u32))
				(then (return (i32 3))))
			(let span (call fnv1a_span seed (borrow-shared text) 1i32 6i32))
			(if (u32:not-eq span hello) (then (return (i32 4))))
			(let prefix (call fnv1a_span seed (borrow-shared text) 1i32 3i32))
			(let joined (call fnv1a_span prefix (borrow-shared text) 3i32 6i32))
			(if (u32:not-eq joined hello) (then (return (i32 5))))
			(let custom 0x12345678u32)
			(let empty (call fnv1a_span custom (borrow-shared text) 7i32 7i32))
			(if (u32:not-eq empty custom) (then (return (i32 6))))
			(let bytes (array:new (array u8 6) 221u8 18u8 165u8 0u8 255u8 238u8))
			(let raw_span (call fnv1a_span seed (borrow-shared bytes) 3i32 5i32))
			(if (u32:not-eq raw_span raw) (then (return (i32 7))))
			(let word_span (call fnv1a_span custom (borrow-shared bytes) 1i32 5i32))
			(let word (call fnv1a_u32_le custom 0xff00a512u32))
			(if (bool:or (u32:not-eq word_span 0xd6bea464u32) (u32:not-eq word word_span))
				(then (return (i32 8))))
			(if (u32:not-eq (call fnv1a_u32_le seed 0x00000068u32) 0xc7700b7du32)
				(then (return (i32 9))))
			(return (i32 0)))))
