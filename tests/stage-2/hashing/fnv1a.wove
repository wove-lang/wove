(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	hashing_fnv1a_fixture

	(use wove-file "../../../stage-2/hashing/fnv1a.wove" (only fnv1a_seed fnv1a_byte))

	(fn
		(:expect hashing.fnv1a_vectors
			(issue "https://github.com/wove-lang/wove/issues/91"))
		main
		(params)
		(returns i32)
		(body
			(let seed (call fnv1a_seed))
			(if (bool.not (u32.eq (local seed) (u32 18652613)))
				(then (return (i32 1))))
			(let h (call fnv1a_byte (local seed) (u8 104)))
			(let he (call fnv1a_byte (local h) (u8 101)))
			(let hel (call fnv1a_byte (local he) (u8 108)))
			(let hell (call fnv1a_byte (local hel) (u8 108)))
			(let hello (call fnv1a_byte (local hell) (u8 111)))
			(if (bool.not (u32.eq (local hello) (u32 1335831723)))
				(then (return (i32 2))))
			(let zero (call fnv1a_byte (local seed) (u8 0)))
			(let raw (call fnv1a_byte (local zero) (u8 255)))
			(if (bool.not (u32.eq (local raw) (u32 1383581600)))
				(then (return (i32 3))))
			(return (i32 0)))))
