(module fixed_array_length
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn empty_after_write
		(params (view (mut-array u8))) (returns (array u8 0))
		(body
			(array.store (local view) 1i32 40u8)
			(return (array.new (array u8 0)))))

	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.new (array u8 2) 0u8 0u8))
			(let empty (array.len (call empty_after_write (borrow-mut (local data)))))
			(return (i32.add.wrapping (local empty)
				(i32.add.wrapping (array.len (local data))
					(int.convert i32 (array.load (local data) 1i32))))))))
