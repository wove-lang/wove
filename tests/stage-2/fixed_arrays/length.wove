(module fixed_array_length
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn empty_after_write
		(params (view (mut-array u8))) (returns (array u8 0))
		(body
			(array:set view 1i32 40u8)
			(return (array:new (array u8 0)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:new (array u8 2) 0u8 0u8))
			(let empty (array:len (call empty_after_write (borrow-mut data))))
			(return (i32:add empty
				(i32:add (array:len data)
					(int:convert i32 (array:get data 1i32))))))))
