(module slice_conflict_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take
		(params (left (mut-slice u32)) (value u32))
		(returns i32)
		(body (return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut words (array.repeat (array u32 1) (u32 1)))
			(return (call take (borrow-mut (local words)) (array.load (local words) (i32 0)))))))
