(module slice_parameter
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take
		(params (words (shared-slice u32)))
		(returns i32)
		(body (return (slice.len (local words)))))

	(fn relay
		(params (words (array u32 1)))
		(returns i32)
		(body (return (call take (borrow-shared (local words))))))

	(fn main
		(params)
		(returns i32)
		(body (return (call relay (array.make (array u32 1) (u32 1)))))))
