(module slice_parameter
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take
		(params (words (shared-array u32)))
		(returns i32)
		(body (return (array.len (local words)))))

	(fn relay
		(params (words (array u32 1)))
		(returns i32)
		(body (return (call take (borrow-shared (local words))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (call relay (array.new (array u32 1) (u32 1)))))))
