(module slice_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take
		(params (left (shared-slice u64)) (right (mut-slice u64)))
		(returns i32)
		(body (return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut words (array.repeat (array u64 1) (u64 1)))
			(return (call take (borrow-shared (local words)) (borrow-mut (local words)))))))
