(module fixed_byte_loan_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn consume
		(params (view (shared-slice u8)))
		(returns i32)
		(body (return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut bytes (array.make (array u32 2) (u32 0) (u32 0)))
			(return (call consume (borrow-shared (local bytes)))))))
