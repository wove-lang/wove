(module slice_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn replace
		(params (words (mut-array u64)))
		(returns u64)
		(body
			(array.store words (i32 0) (u64 18446744073709551615))
			(return (array.load words (i32 0)))))

	(fn first
		(params (old (array u64 1)) (replacement u64))
		(returns u64)
		(body (return (array.load old (i32 0)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut words (array.new (array u64 1) (u64 9223372036854775808)))
			(let original (call first words (call replace (borrow-mut words))))
			(if (bool.not (u64.eq original (u64 9223372036854775808)))
				(then (return (i32 1))))
			(if (bool.not (u64.eq (array.load words (i32 0)) (u64 18446744073709551615)))
				(then (return (i32 2))))
			(return (i32 42)))))
