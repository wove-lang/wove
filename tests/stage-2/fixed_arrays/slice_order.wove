(module slice_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn replace
		(params (words (mut-slice u64)))
		(returns u64)
		(body
			(slice.store (local words) (i32 0) (u64 18446744073709551615))
			(return (slice.load (local words) (i32 0)))))

	(fn first
		(params (old (array u64 1)) (replacement u64))
		(returns u64)
		(body (return (array.load (local old) (i32 0)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut words (array.make (array u64 1) (u64 9223372036854775808)))
			(let original (call first (local words) (call replace (borrow-mut (local words)))))
			(if (bool.not (u64.eq (local original) (u64 9223372036854775808)))
				(then (return (i32 1))))
			(if (bool.not (u64.eq (array.load (local words) (i32 0)) (u64 18446744073709551615)))
				(then (return (i32 2))))
			(return (i32 42)))))
