(module fixed_byte_loan_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn consume
		(params (view (shared-slice u8)))
		(returns i32)
		(body (return (i32 0))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut bytes (array.make (array u8 2) (u8 0) (u8 0)))
			(return (call consume (borrow-shared (slice.range (local bytes) (i32 0) (i32 1))))))))
