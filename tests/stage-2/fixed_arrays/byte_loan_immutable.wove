(module fixed_byte_loan_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn consume
		(params (view (mut-array u8)))
		(returns i32)
		(body (return (i32 0))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let bytes (array.new (array u8 2) (u8 0) (u8 0)))
			(return (call consume (borrow-mut (local bytes)))))))
