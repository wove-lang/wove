(module fixed_byte_loan_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn consume
		(params (read (shared-array u8)) (write (mut-array u8)))
		(returns i32)
		(body (return (i32 0))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut bytes (array:new (array u8 2) (u8 0) (u8 0)))
			(return (call consume (borrow-shared bytes) (borrow-mut bytes))))))
