(module slice_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take
		(params (words (mut-slice u64)))
		(returns i32)
		(body (return (slice.len (local words)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let words (array.repeat (array u64 1) (u64 1)))
			(return (call take (borrow-mut (local words)))))))
