(module slice_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take
		(params (words (mut-array u64)))
		(returns i32)
		(body (return (array.len (local words)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let words (array.repeat (array u64 1) (u64 1)))
			(return (call take (borrow-mut (local words)))))))
