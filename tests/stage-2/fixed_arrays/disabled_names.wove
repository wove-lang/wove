(module fixed_array_disabled_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Named (fields (disabled (array u8 17))))

	(fn read
		(params (disabled (array u8 19)))
		(returns u8)
		(body (return (array.load (local disabled) (i32 18)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(disabled (let hidden (array.repeat (array u8 99) (u8 0))))
			(return (i32 42)))))
