	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Named (fields (disabled (array u8 17))))

	(fn read
		(params (disabled (array u8 19)))
		(returns u8)
		(body (return (array:get disabled (i32 18)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(disabled (let hidden (array:repeat (array u8 99) (u8 0))))
			(return (i32 42)))))
