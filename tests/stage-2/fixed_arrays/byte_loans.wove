(module fixed_byte_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check_framing
		(params (bytes (shared-slice u8)))
		(returns bool)
		(body
			(if (bool.not (i32.eq (slice.len (local bytes)) (i32 8))) (then (return (bool false))))
			(let expected (array.new (array u8 8)
				(u8 239) (u8 205) (u8 171) (u8 137) (u8 103) (u8 69) (u8 35) (u8 1)))
			(let-mut index (i32 0))
			(while
				(i32.lt (local index) (i32 8))
				(body
					(if (bool.not (u8.eq (slice.load (local bytes) (local index)) (array.load (local expected) (local index))))
						(then (return (bool false))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (bool true))))

	(fn number
		(params (value u64))
		(returns bool)
		(body
			(let-mut bytes (array.repeat (array u8 8) (u8 0)))
			(let-mut index (i32 0))
			(while
				(i32.lt (local index) (i32 8))
				(body
					(array.store (local bytes) (local index)
						(int.convert u8 (u64.and (u64.shr (local value) (i32.mul.wrapping (local index) (i32 8))) (u64 255))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call check_framing (borrow-shared (local bytes))))))

	(fn paint
		(params (bytes (mut-slice u8)))
		(returns i32)
		(body
			(let length (slice.len (local bytes)))
			(if (i32.eq (local length) (i32 2)) (then (slice.store (local bytes) (i32 1) (u8 42))))
			(return (local length))))

	(fn length
		(params (bytes (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local bytes)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(if (bool.not (call number (u64 81985529216486895))) (then (return (i32 1))))
			(let-mut bytes (array.new (array u8 2) (u8 17) (u8 0)))
			(if (bool.not (i32.eq (call paint (borrow-mut (local bytes))) (i32 2))) (then (return (i32 2))))
			(if (bool.not (u8.eq (array.load (local bytes) (i32 0)) (u8 17))) (then (return (i32 3))))
			(if (bool.not (u8.eq (array.load (local bytes) (i32 1)) (u8 42))) (then (return (i32 4))))
			(let-mut empty (array.new (array u8 0)))
			(if (bool.not (i32.eq (call length (borrow-shared (local empty))) (i32 0))) (then (return (i32 5))))
			(if (bool.not (i32.eq (call paint (borrow-mut (local empty))) (i32 0))) (then (return (i32 6))))
			(return (i32 42)))))
