(module fixed_byte_loan_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local bytes) (i32 0))))))

	(fn write_first
		(params (bytes (mut-array u8)))
		(returns void)
		(body (array.store (local bytes) (i32 0) (u8 42))))

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut bytes (array.new (array u8 0)))
			(if (i32.eq (i32.dec (array.len (local argv))) (i32 0))
				(then (return (call first (borrow-shared (local bytes))))))
			(call write_first (borrow-mut (local bytes)))
			(return (i32 0)))))
