(module fixed_byte_loan_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn first
		(params (bytes (shared-slice u8)))
		(returns i32)
		(body (return (int.convert i32 (slice.load (local bytes) (i32 0))))))

	(fn write_first
		(params (bytes (mut-slice u8)))
		(returns void)
		(body (slice.store (local bytes) (i32 0) (u8 42))))

	(fn main
		(params (arguments (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(let-mut bytes (array.make (array u8 0)))
			(if (i32.eq (slice.len (local argv)) (i32 0))
				(then (return (call first (borrow-shared (local bytes))))))
			(call write_first (borrow-mut (local bytes)))
			(return (i32 0)))))
