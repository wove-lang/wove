(module slice_kernel
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./slice_words.wove" (only mix_lane read32 write32 length64))

	(fn same_words
		(params (left (shared-array u32)) (right (shared-array u32)))
		(returns bool)
		(body (return (u32.eq (array.load left (i32 0)) (array.load right (i32 0))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let selectors (array.new (array u32 2) (u32 4294967295) (u32 48)))
			(let words (array.new (array u64 4)
				(u64 18446744073709551615) (u64 0) (u64 0) (u64 81985529216486895)))
			(let-mut state (array.new (array u64 4)
				(u64 7640891576956012808) (u64 13503953896175478587)
				(u64 4354685564936845355) (u64 11912009170470909681)))
			(if (bool.not (i32.eq (call mix_lane (borrow-mut state)
					(borrow-shared words) (borrow-shared selectors)) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (bool.and (u64.eq (array.load state (i32 0)) (u64 4652803580490146347))
					(u64.eq (array.load state (i32 1)) (u64 16424964169165427203))))
				(then (return (i32 2))))
			(if (bool.not (bool.and (u64.eq (array.load state (i32 2)) (u64 16718946414135823099))
					(u64.eq (array.load state (i32 3)) (u64 9510589798541684985))))
				(then (return (i32 3))))
			(if (bool.not (call same_words (borrow-shared selectors) (borrow-shared selectors)))
				(then (return (i32 4))))
			(let-mut integers (array.repeat (array u32 2) (u32 0)))
			(call write32 (borrow-mut integers) (i32 1) (u32 4294967295))
			(if (bool.not (u32.eq (array.load integers (i32 1)) (u32 4294967295)))
				(then (return (i32 5))))
			(let-mut empty (array.new (array u64 0)))
			(if (bool.not (i32.eq (call length64 (borrow-mut empty)) (i32 0)))
				(then (return (i32 6))))
			(return (i32 42)))))
