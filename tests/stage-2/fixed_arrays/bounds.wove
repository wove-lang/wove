(module fixed_array_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array.new (array u8 1) (u8 0)))
			(let index (i32.sub (i32.dec (array.len (local argv))) (i32 1)))
			(if (i32.lt (local index) (i32 0))
				(then (return (int.convert i32 (array.load (local data) (local index))))))
			(array.store (local data) (local index) (u8 42))
			(return (int.convert i32 (array.load (local data) (local index)))))))
