(module fixed_array_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array:new (array u8 1) (u8 0)))
			(let index (i32:sub (i32:dec (array:len argv)) (i32 1)))
			(if (i32:lt index (i32 0))
				(then (return (int:convert i32 (array:get data index)))))
			(array:set data index (u8 42))
			(return (int:convert i32 (array:get data index))))))
