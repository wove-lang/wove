(module slice_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./slice_words.wove" (only read32 write64))

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (i32.dec (array.len (local argv))))
			(if (i32.eq (local count) (i32 0))
				(then
					(let words (array.repeat (array u32 2) (u32 1)))
					(return (int.convert i32 (call read32 (borrow-shared (local words)) (i32 -1))))))
			(if (i32.eq (local count) (i32 1))
				(then
					(let-mut words (array.repeat (array u64 2) (u64 0)))
					(call write64 (borrow-mut (local words)) (i32 2) (u64 1))
					(return (i32 0))))
			(let empty (array.new (array u32 0)))
			(return (int.convert i32 (call read32 (borrow-shared (local empty)) (i32 0)))))))
