(module slice_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../u64/mix.wove" (only (type Lane) mix))

	(fn read32
		(params (words (shared-array u32)) (index i32))
		(returns u32)
		(body (return (array.load (local words) (local index)))))

	(fn write32
		(params (words (mut-array u32)) (index i32) (value u32))
		(returns void)
		(body (array.store (local words) (local index) (local value))))

	(fn write64
		(params (words (mut-array u64)) (index i32) (value u64))
		(returns void)
		(body (array.store (local words) (local index) (local value))))

	(fn length64
		(params (words (mut-array u64)))
		(returns i32)
		(body (return (array.len (local words)))))

	(fn read_lane
		(params (state (shared-array u64)))
		(returns Lane)
		(body
			(return (struct.new Lane
				(a (array.load (local state) (i32 0))) (b (array.load (local state) (i32 1)))
				(c (array.load (local state) (i32 2))) (d (array.load (local state) (i32 3)))))))

	(fn pair
		(params (lane Lane) (words (shared-array u64)) (permutation u64))
		(returns Lane)
		(body
			(let x (int.convert i32 (u64.and (local permutation) (u64 15))))
			(let y (int.convert i32 (u64.and (u64.shr (local permutation) (i32 4)) (u64 15))))
			(return (call mix (local lane) (array.load (local words) (local x)) (array.load (local words) (local y))))))

	(fn mix_lane
		(params (state (mut-array u64)) (words (shared-array u64)) (selectors (shared-array u32)))
		(returns i32)
		(body
			(if (bool.not (bool.and (i32.eq (array.len (local state)) (i32 4))
					(bool.and (i32.eq (array.len (local words)) (i32 4))
						(i32.eq (array.len (local selectors)) (i32 2)))))
				(then (return (i32 1))))
			(if (bool.not (u32.eq (call read32 (borrow-shared (local selectors)) (i32 0)) (u32 4294967295)))
				(then (return (i32 2))))
			(let permutation (int.convert u64 (array.load (local selectors) (i32 1))))
			(let lane (call read_lane (borrow-shared (local state))))
			(let mixed (call pair (local lane) (borrow-shared (local words)) (local permutation)))
			(call write64 (borrow-mut (local state)) (i32 0) (struct.get (local mixed) a))
			(call write64 (borrow-mut (local state)) (i32 1) (struct.get (local mixed) b))
			(call write64 (borrow-mut (local state)) (i32 2) (struct.get (local mixed) c))
			(call write64 (borrow-mut (local state)) (i32 3) (struct.get (local mixed) d))
			(return (i32 0)))))
