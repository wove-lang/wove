(module slice_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../u64/mix.wove" (only (type Lane) mix))

	(fn read32
		(params (words (shared-array u32)) (index i32))
		(returns u32)
		(body (return (array.load words index))))

	(fn write32
		(params (words (mut-array u32)) (index i32) (value u32))
		(returns void)
		(body (array.store words index value)))

	(fn write64
		(params (words (mut-array u64)) (index i32) (value u64))
		(returns void)
		(body (array.store words index value)))

	(fn length64
		(params (words (mut-array u64)))
		(returns i32)
		(body (return (array.len words))))

	(fn read_lane
		(params (state (shared-array u64)))
		(returns Lane)
		(body
			(return (struct.new Lane
				(a (array.load state (i32 0))) (b (array.load state (i32 1)))
				(c (array.load state (i32 2))) (d (array.load state (i32 3)))))))

	(fn pair
		(params (lane Lane) (words (shared-array u64)) (permutation u64))
		(returns Lane)
		(body
			(let x (int.convert i32 (u64.and permutation (u64 15))))
			(let y (int.convert i32 (u64.and (u64.shr permutation (i32 4)) (u64 15))))
			(return (call mix lane (array.load words x) (array.load words y)))))

	(fn mix_lane
		(params (state (mut-array u64)) (words (shared-array u64)) (selectors (shared-array u32)))
		(returns i32)
		(body
			(if (bool.not (bool.and (i32.eq (array.len state) (i32 4))
					(bool.and (i32.eq (array.len words) (i32 4))
						(i32.eq (array.len selectors) (i32 2)))))
				(then (return (i32 1))))
			(if (bool.not (u32.eq (call read32 (borrow-shared selectors) (i32 0)) (u32 4294967295)))
				(then (return (i32 2))))
			(let permutation (int.convert u64 (array.load selectors (i32 1))))
			(let lane (call read_lane (borrow-shared state)))
			(let mixed (call pair lane (borrow-shared words) permutation))
			(call write64 (borrow-mut state) (i32 0) (struct.get mixed a))
			(call write64 (borrow-mut state) (i32 1) (struct.get mixed b))
			(call write64 (borrow-mut state) (i32 2) (struct.get mixed c))
			(call write64 (borrow-mut state) (i32 3) (struct.get mixed d))
			(return (i32 0)))))
