(module native_declaration_slots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(enum Outcome (variants (Value i32) (Empty)) (:doc "A declared enum."))
	(struct Box
		(generic (type T (:doc "Element.")))
		(:doc "Metadata between the template parameters and fields.")
		(fields (type T)))
	(type Unary (fn-type (params i32) (returns i32)) (:doc "A transparent alias."))
	(let text "(" (:doc "One input byte."))
	(:doc "Interleaved module metadata.")

	(fn increment (params (value i32)) (returns i32)
		(body (return (i32:inc value))))

	(fn advance
		(generic (const Limit i32 (:doc "An exact integer."))
			(fn Step (:doc "A defining operation.")))
		(params) (returns i32)
		(body (return (call Step Limit))))

	(fn invoke (params (step Unary) (value i32)) (returns i32)
		(body (return (call step value))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut count 0i32 (:doc "Track the view byte."))
			(for (let index item (:doc "Both names precede this metadata.")) (borrow-shared text)
				(body (set count (i32:add index (i32:from-u8 item)))))
			(let box (struct:new (specialize Box i32)
				(type (call (specialize advance 0i32 increment)))))
			(let result (Outcome:Value (i32:add count (struct:get box type))))
			(return (match result
				(case Value (let value (:doc "Bind the payload.")) (call invoke (fn-ref increment) value))
				(case Empty 1i32))))))
