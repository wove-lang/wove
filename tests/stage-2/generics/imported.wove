(module generic_importer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:note (specialize MetadataIsOpaque u8))

	(use wove-file "./model.wove" (only unbox (type (as Box Result)) (type (as Byte Value))))
	(struct Envelope (fields (fields (specialize Result (specialize Result Value)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(disabled (let absent (struct:new (specialize DisabledIsOpaque u8))))
			(let first (struct:new (specialize Result Value) (value (struct:new Value (specialize 42u8)))))
			(let nested (struct:new (specialize Result (specialize Result Value)) (value first)))
			(let wrapper (struct:new Envelope (fields nested)))
			(let list (array:new (array (specialize Result Value) 1)
				(struct:get (struct:get wrapper fields) value)))
			(return (i32:from-u8 (call unbox (array:get list 0i32)))))))
