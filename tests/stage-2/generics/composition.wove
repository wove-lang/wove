(module generic_composition
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Holder (generic (const Tag i32)) (fields (item (specialize Box u8))))
	(struct Box (generic (type T)) (fields (value T)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let box (struct.new (specialize Box u8) (value 42u8)))
			(let one (struct.new (specialize Holder 1i32) (item (local box))))
			(let two (struct.new (specialize Holder 2i32) (item (struct.get (local one) item))))
			(return (i32.from-u8 (struct.get (struct.get (local two) item) value))))))
