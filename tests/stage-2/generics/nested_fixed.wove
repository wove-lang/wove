(module specialized_nested_fixed_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Grid
		(generic (type T) (const N i32))
		(fields (data (array (array (array T N) 2) N))))

	(fn use_grid (params (grid (specialize Grid u32 3i32))) (returns i32)
		(body
			(let page (array.load (struct.get (local grid) data) 2i32))
			(let row (array.load (local page) 1i32))
			(return (i32.from-u32 (array.load (local row) 2i32)))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let row (array.new (array u32 3) 11u32 17u32 42u32))
			(let plane (array.repeat (array (array u32 3) 2) (local row)))
			(let grid (struct.new (specialize Grid u32 3i32)
				(data (array.repeat (array (array (array u32 3) 2) 3) (local plane)))))
			(return (call use_grid (local grid))))))
