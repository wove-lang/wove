(module generic_composition_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Holder (generic (const Tag i32))
		(fields (item (specialize Item
			4i32))))
	(struct Item (generic (type T)) (fields (value T)))

	(fn create (params (value u8)) (returns (specialize Holder 1i32))
		(body (return (struct:new (specialize Holder 1i32) (item value))))))
