(module generic_composition_imported
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./composition_provider.wove" (only create (type Holder)))

	(fn read (params (holder (specialize Holder 1i32))) (returns u8)
		(body (return (struct:get (array:load (struct:get holder items) 0i32) value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32:from-u8 (call read (call create 42u8)))))))
