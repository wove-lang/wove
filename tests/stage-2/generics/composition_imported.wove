(module generic_composition_imported
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./composition_provider.wove" (only create (type Holder)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn read (params (holder (specialize Holder 1i32))) (returns u8)
		(body (return (struct.get (array.load (struct.get (local holder) items) 0i32) value))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (i32.from-u8 (call read (call create 42u8)))))))
