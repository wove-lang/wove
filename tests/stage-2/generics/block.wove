(module block_codec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Block
		(generic (type T) (const N i32))
		(fields (items (array T N))))
	(struct Result
		(generic (type T))
		(fields (valid bool) (value T)))
	(struct Domain
		(generic (const Id i32))
		(fields (salt u32)))

	(fn wrap (params (bytes (array u8 4))) (returns (specialize Block u8 4i32))
		(body
			(return (struct:new (specialize Block u8 0x04i32) (items bytes)))))

	(fn read (params (block (specialize Block u8 004i32))) (returns (specialize Result u8))
		(body
			(return (struct:new (specialize Result u8) (valid (bool true))
				(value (array:load (struct:get block items) 2i32))))))

	(fn read_domain (params (domain (specialize Domain -2147483648i32))) (returns u32)
		(body (return (struct:get domain salt))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let block (call wrap (array:new (array u8 4) 1u8 2u8 42u8 4u8)))
			(let result (call read block))
			(let hash (struct:new (specialize Domain (i32 -0x80000000)) (salt 4294967295u32)))
			(let other (struct:new (specialize Domain 0i32) (salt 7u32)))
			(if (bool:not (bool:and (struct:get result valid)
				(bool:and (i32:eq (array:len (struct:get block items)) 4i32)
					(bool:and (u32:eq (call read_domain hash) 4294967295u32)
						(u32:eq (struct:get other salt) 7u32)))))
				(then (return 1i32)))
			(return (i32:from-u8 (struct:get result value))))))
