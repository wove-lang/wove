(module generic_failure
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Domain (generic (const Tag i32)) (fields (value i32)))
	(fn read (params (domain (specialize Domain 1i32))) (returns i32)
		(body (return (struct.get (local domain) value))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let other (struct.new (specialize Domain 2i32) (value 42i32)))
			(return (call read (local other)))))
)
