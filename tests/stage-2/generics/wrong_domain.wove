(module generic_failure
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Domain (generic (const Tag i32)) (fields (value i32)))
	(fn read (params (domain (specialize Domain 1i32))) (returns i32)
		(body (return (struct.get domain value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let other (struct.new (specialize Domain 2i32) (value 42i32)))
			(return (call read other))))
)
