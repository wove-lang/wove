(module integer_arithmetic_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.eqz (i32.dec (array.len args))) (then (return 42i32)))
			(let bytes (array.load args 1i32))
			(match (array.load bytes 0i32)
				(case 97u8 (let result (i8.add-checked 127i8 1i8)) (return 99i32))
				(case 98u8 (let result (i8.sub-checked -128i8 1i8)) (return 99i32))
				(case 99u8 (let result (i8.mul-checked -128i8 -1i8)) (return 99i32))
				(case 100u8 (let result (u8.add-checked 255u8 1u8)) (return 99i32))
				(case 101u8 (let result (u8.sub-checked 0u8 1u8)) (return 99i32))
				(case 102u8 (let result (u8.mul-checked 255u8 2u8)) (return 99i32))
				(case 103u8 (let result (i16.add-checked 32767i16 1i16)) (return 99i32))
				(case 104u8 (let result (i16.sub-checked -32768i16 1i16)) (return 99i32))
				(case 105u8 (let result (i16.mul-checked -32768i16 -1i16)) (return 99i32))
				(case 106u8 (let result (u16.add-checked 65535u16 1u16)) (return 99i32))
				(case 107u8 (let result (u16.sub-checked 0u16 1u16)) (return 99i32))
				(case 108u8 (let result (u16.mul-checked 65535u16 2u16)) (return 99i32))
				(case 109u8 (let result (i32.add-checked 2147483647i32 1i32)) (return 99i32))
				(case 110u8 (let result (i32.sub-checked -2147483648i32 1i32)) (return 99i32))
				(case 111u8 (let result (i32.mul-checked -2147483648i32 -1i32)) (return 99i32))
				(case 112u8 (let result (u32.add-checked 4294967295u32 1u32)) (return 99i32))
				(case 113u8 (let result (u32.sub-checked 0u32 1u32)) (return 99i32))
				(case 114u8 (let result (u32.mul-checked 4294967295u32 2u32)) (return 99i32))
				(case 115u8 (let result (i64.add-checked 9223372036854775807i64 1i64)) (return 99i32))
				(case 116u8 (let result (i64.sub-checked -9223372036854775808i64 1i64)) (return 99i32))
				(case 117u8 (let result (i64.mul-checked -9223372036854775808i64 -1i64)) (return 99i32))
				(case 118u8 (let result (u64.add-checked 18446744073709551615u64 1u64)) (return 99i32))
				(case 119u8 (let result (u64.sub-checked 0u64 1u64)) (return 99i32))
				(case 120u8 (let result (u64.mul-checked 18446744073709551615u64 2u64)) (return 99i32))
				(case _ (return 98i32)))))
)
