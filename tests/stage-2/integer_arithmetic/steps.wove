(module integer_steps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn inc_i8 (params (value i8)) (returns i8)
		(body (return (i8.inc (local value)))))
	(fn dec_i8 (params (value i8)) (returns i8)
		(body (return (i8.dec (local value)))))
	(fn inc_u8 (params (value u8)) (returns u8)
		(body (return (u8.inc (local value)))))
	(fn dec_u8 (params (value u8)) (returns u8)
		(body (return (u8.dec (local value)))))
	(fn inc_i16 (params (value i16)) (returns i16)
		(body (return (i16.inc (local value)))))
	(fn dec_i16 (params (value i16)) (returns i16)
		(body (return (i16.dec (local value)))))
	(fn inc_u16 (params (value u16)) (returns u16)
		(body (return (u16.inc (local value)))))
	(fn dec_u16 (params (value u16)) (returns u16)
		(body (return (u16.dec (local value)))))
	(fn inc_i32 (params (value i32)) (returns i32)
		(body (return (i32.inc (local value)))))
	(fn dec_i32 (params (value i32)) (returns i32)
		(body (return (i32.dec (local value)))))
	(fn inc_u32 (params (value u32)) (returns u32)
		(body (return (u32.inc (local value)))))
	(fn dec_u32 (params (value u32)) (returns u32)
		(body (return (u32.dec (local value)))))
	(fn inc_i64 (params (value i64)) (returns i64)
		(body (return (i64.inc (local value)))))
	(fn dec_i64 (params (value i64)) (returns i64)
		(body (return (i64.dec (local value)))))
	(fn inc_u64 (params (value u64)) (returns u64)
		(body (return (u64.inc (local value)))))
	(fn dec_u64 (params (value u64)) (returns u64)
		(body (return (u64.dec (local value)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i8.not-eq (call inc_i8 127i8) -128i8) (then (return 1i32)))
			(if (i8.not-eq (call dec_i8 -128i8) 127i8) (then (return 2i32)))
			(if (u8.not-eq (call inc_u8 255u8) 0u8) (then (return 3i32)))
			(if (u8.not-eq (call dec_u8 0u8) 255u8) (then (return 4i32)))
			(if (i16.not-eq (call inc_i16 32767i16) -32768i16) (then (return 5i32)))
			(if (i16.not-eq (call dec_i16 -32768i16) 32767i16) (then (return 6i32)))
			(if (u16.not-eq (call inc_u16 65535u16) 0u16) (then (return 7i32)))
			(if (u16.not-eq (call dec_u16 0u16) 65535u16) (then (return 8i32)))
			(if (i32.not-eq (call inc_i32 2147483647i32) -2147483648i32) (then (return 9i32)))
			(if (i32.not-eq (call dec_i32 -2147483648i32) 2147483647i32) (then (return 10i32)))
			(if (u32.not-eq (call inc_u32 4294967295u32) 0u32) (then (return 11i32)))
			(if (u32.not-eq (call dec_u32 0u32) 4294967295u32) (then (return 12i32)))
			(if (i64.not-eq (call inc_i64 9223372036854775807i64) -9223372036854775808i64) (then (return 13i32)))
			(if (i64.not-eq (call dec_i64 -9223372036854775808i64) 9223372036854775807i64) (then (return 14i32)))
			(if (u64.not-eq (call inc_u64 18446744073709551615u64) 0u64) (then (return 15i32)))
			(if (u64.not-eq (call dec_u64 0u64) 18446744073709551615u64) (then (return 16i32)))
			(return 42i32))))
