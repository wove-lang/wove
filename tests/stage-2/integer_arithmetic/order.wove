(module integer_arithmetic_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn step (params (phase (mut-ref i32)) (expected i32) (value i32)) (returns i32)
		(body
			(if (i32.not-eq phase expected) (then (return 0i32)))
			(set phase (i32.add phase 1i32))
			(return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut phase 0i32)
			(if (i32.not-eq (i32.add
				(call step (borrow-mut phase) 0i32 10i32)
				(call step (borrow-mut phase) 1i32 3i32)) 13i32)
				(then (return 1i32)))
			(if (i32.not-eq (i32.sub
				(call step (borrow-mut phase) 2i32 10i32)
				(call step (borrow-mut phase) 3i32 3i32)) 7i32)
				(then (return 2i32)))
			(if (i32.not-eq (i32.mul
				(call step (borrow-mut phase) 4i32 10i32)
				(call step (borrow-mut phase) 5i32 3i32)) 30i32)
				(then (return 3i32)))
			(if (i32.not-eq (i32.add-checked
				(call step (borrow-mut phase) 6i32 10i32)
				(call step (borrow-mut phase) 7i32 3i32)) 13i32)
				(then (return 4i32)))
			(if (i32.not-eq (i32.sub-checked
				(call step (borrow-mut phase) 8i32 10i32)
				(call step (borrow-mut phase) 9i32 3i32)) 7i32)
				(then (return 5i32)))
			(if (i32.not-eq (i32.mul-checked
				(call step (borrow-mut phase) 10i32 10i32)
				(call step (borrow-mut phase) 11i32 3i32)) 30i32)
				(then (return 6i32)))
			(if (i32.not-eq phase 12i32) (then (return 7i32)))
			(return 42i32)))
)
