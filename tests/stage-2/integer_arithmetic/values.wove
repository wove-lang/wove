(module integer_arithmetic_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check_i8 (params (low i8) (high i8)) (returns bool)
		(body
			(if (i8.not-eq (i8.add (local high) 1i8) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.sub (local low) 1i8) 127i8) (then (return (bool false))))
			(if (i8.not-eq (i8.mul (local low) -1i8) -128i8) (then (return (bool false))))
			(if (i8.not-eq (i8.add-checked (local low) (local high)) -1i8) (then (return (bool false))))
			(if (i8.not-eq (i8.sub-checked (local high) (local high)) 0i8) (then (return (bool false))))
			(if (i8.not-eq (i8.mul-checked (local low) 1i8) -128i8) (then (return (bool false))))
			(return (bool true))))

	(fn check_u8 (params (low u8) (high u8)) (returns bool)
		(body
			(if (u8.not-eq (u8.add (local high) 1u8) 0u8) (then (return (bool false))))
			(if (u8.not-eq (u8.sub (local low) 1u8) 255u8) (then (return (bool false))))
			(if (u8.not-eq (u8.mul (local high) (local high)) 1u8) (then (return (bool false))))
			(if (u8.not-eq (u8.add-checked (local low) (local high)) 255u8) (then (return (bool false))))
			(if (u8.not-eq (u8.sub-checked (local high) (local high)) 0u8) (then (return (bool false))))
			(if (u8.not-eq (u8.mul-checked (local high) 1u8) 255u8) (then (return (bool false))))
			(return (bool true))))

	(fn check_i16 (params (low i16) (high i16)) (returns bool)
		(body
			(if (i16.not-eq (i16.add (local high) 1i16) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.sub (local low) 1i16) 32767i16) (then (return (bool false))))
			(if (i16.not-eq (i16.mul (local low) -1i16) -32768i16) (then (return (bool false))))
			(if (i16.not-eq (i16.add-checked (local low) (local high)) -1i16) (then (return (bool false))))
			(if (i16.not-eq (i16.sub-checked (local high) (local high)) 0i16) (then (return (bool false))))
			(if (i16.not-eq (i16.mul-checked (local low) 1i16) -32768i16) (then (return (bool false))))
			(return (bool true))))

	(fn check_u16 (params (low u16) (high u16)) (returns bool)
		(body
			(if (u16.not-eq (u16.add (local high) 1u16) 0u16) (then (return (bool false))))
			(if (u16.not-eq (u16.sub (local low) 1u16) 65535u16) (then (return (bool false))))
			(if (u16.not-eq (u16.mul (local high) (local high)) 1u16) (then (return (bool false))))
			(if (u16.not-eq (u16.add-checked (local low) (local high)) 65535u16) (then (return (bool false))))
			(if (u16.not-eq (u16.sub-checked (local high) (local high)) 0u16) (then (return (bool false))))
			(if (u16.not-eq (u16.mul-checked (local high) 1u16) 65535u16) (then (return (bool false))))
			(return (bool true))))

	(fn check_i32 (params (low i32) (high i32)) (returns bool)
		(body
			(if (i32.not-eq (i32.add (local high) 1i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.sub (local low) 1i32) 2147483647i32) (then (return (bool false))))
			(if (i32.not-eq (i32.mul (local low) -1i32) -2147483648i32) (then (return (bool false))))
			(if (i32.not-eq (i32.add-checked (local low) (local high)) -1i32) (then (return (bool false))))
			(if (i32.not-eq (i32.sub-checked (local high) (local high)) 0i32) (then (return (bool false))))
			(if (i32.not-eq (i32.mul-checked (local low) 1i32) -2147483648i32) (then (return (bool false))))
			(return (bool true))))

	(fn check_u32 (params (low u32) (high u32)) (returns bool)
		(body
			(if (u32.not-eq (u32.add (local high) 1u32) 0u32) (then (return (bool false))))
			(if (u32.not-eq (u32.sub (local low) 1u32) 4294967295u32) (then (return (bool false))))
			(if (u32.not-eq (u32.mul (local high) (local high)) 1u32) (then (return (bool false))))
			(if (u32.not-eq (u32.add-checked (local low) (local high)) 4294967295u32) (then (return (bool false))))
			(if (u32.not-eq (u32.sub-checked (local high) (local high)) 0u32) (then (return (bool false))))
			(if (u32.not-eq (u32.mul-checked (local high) 1u32) 4294967295u32) (then (return (bool false))))
			(return (bool true))))

	(fn check_i64 (params (low i64) (high i64)) (returns bool)
		(body
			(if (i64.not-eq (i64.add (local high) 1i64) -9223372036854775808i64) (then (return (bool false))))
			(if (i64.not-eq (i64.sub (local low) 1i64) 9223372036854775807i64) (then (return (bool false))))
			(if (i64.not-eq (i64.mul (local low) -1i64) -9223372036854775808i64) (then (return (bool false))))
			(if (i64.not-eq (i64.add-checked (local low) (local high)) -1i64) (then (return (bool false))))
			(if (i64.not-eq (i64.sub-checked (local high) (local high)) 0i64) (then (return (bool false))))
			(if (i64.not-eq (i64.mul-checked (local low) 1i64) -9223372036854775808i64) (then (return (bool false))))
			(return (bool true))))

	(fn check_u64 (params (low u64) (high u64)) (returns bool)
		(body
			(if (u64.not-eq (u64.add (local high) 1u64) 0u64) (then (return (bool false))))
			(if (u64.not-eq (u64.sub (local low) 1u64) 18446744073709551615u64) (then (return (bool false))))
			(if (u64.not-eq (u64.mul (local high) (local high)) 1u64) (then (return (bool false))))
			(if (u64.not-eq (u64.add-checked (local low) (local high)) 18446744073709551615u64) (then (return (bool false))))
			(if (u64.not-eq (u64.sub-checked (local high) (local high)) 0u64) (then (return (bool false))))
			(if (u64.not-eq (u64.mul-checked (local high) 1u64) 18446744073709551615u64) (then (return (bool false))))
			(return (bool true))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:310"))
		(body
			(if (bool.not (call check_i8 -128i8 127i8)) (then (return 1i32)))
			(if (bool.not (call check_u8 0u8 255u8)) (then (return 2i32)))
			(if (bool.not (call check_i16 -32768i16 32767i16)) (then (return 3i32)))
			(if (bool.not (call check_u16 0u16 65535u16)) (then (return 4i32)))
			(if (bool.not (call check_i32 -2147483648i32 2147483647i32)) (then (return 5i32)))
			(if (bool.not (call check_u32 0u32 4294967295u32)) (then (return 6i32)))
			(if (bool.not (call check_i64 -9223372036854775808i64 9223372036854775807i64)) (then (return 7i32)))
			(if (bool.not (call check_u64 0u64 18446744073709551615u64)) (then (return 8i32)))
			(return 42i32)))
)
