(module integer_arithmetic_trap_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn fail (params (value i64)) (returns i64)
		(body
			(return (i64.mul-checked
				(:doc "The diagnostic covers only the operation head.")
				value -1i64))))
)
