(module call_inspection_library
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn alone (params) (returns i32) (body (return (i32 0))))
	(fn main (params (value i32)) (returns i32)
		(body (return (local value))))
	(fn wrapper (params) (returns i32)
		(body (return (call main (i32 42)))))
)
