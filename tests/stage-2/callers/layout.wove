(module renamed_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn target
		(params)
		(returns i32)
		(body (return (i32 42))))
	(fn once
		(params) (returns i32)
		(body
			(return (call
				target))))
	(fn twice (params) (returns i32)
		(body
			(return (call first
				(call target)
				(call target)))))
	(fn first
		(params (left i32) (right i32))
		(returns i32) (body (return left)))
	(fn unused (params) (returns i32) (body (return (i32 0))))
	(fn excluded
		(:pragma (cfg (not bootstrap)))
		(params)
		(returns i32)
		(body (return (call target))))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (call twice)))))
