(module conditional_owned_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn fresh
		(params (count i32)) (returns (owned-array u8))
		(body
			(let data (array.alloc u8 (local count)))
			(return (move (local data)))))

	(fn make
		(params (short bool)) (returns (owned-array u8))
		(body
			(return (if (local short)
				(then (call fresh 2i32))
				(else (call fresh 3i32))))))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let short (i32.eq (i32.dec (array.len (local args))) 0i32))
			(let-mut data (if (local short)
				(then (array.alloc u8 1i32))
				(else (call make (local short)))))
			(array.store (local data) 0i32 42u8)
			(if (local short)
				(then (if (bool.not (i32.eq (array.len (local data)) 1i32)) (then (return 1i32))))
				(else (if (bool.not (i32.eq (array.len (local data)) 3i32)) (then (return 2i32)))))
			(return (i32.from-u8 (array.load (local data) 0i32)))))
)
