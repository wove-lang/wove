(module conditional_arm_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(enum First (variants (Value)))
	(enum Second (variants (Value)))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let status (if (bool true) (then (enum.new First Value)) (else (enum.new Second Value))))
			(return 42i32)))
)
