(module conditional_reads
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (sequence i32) (words (array i32 2))))

	(fn header
		(params (sequence i32) (word i32)) (returns Header)
		(body (return (struct.new Header (sequence sequence)
			(words (array.new (array i32 2) 0i32 word))))))

	(fn read
		(params (first bool)) (returns i32)
		(body
			(let sequence (struct.get
				(if first (then (call header 1i32 0i32)) (else (call header 2i32 0i32))) sequence))
			(let word (array.load
				(if first
					(then (array.new (array i32 2) 3i32 0i32))
					(else (array.new (array i32 2) 4i32 0i32))) 0i32))
			(let nested (array.load (struct.get
				(if first (then (call header 0i32 5i32)) (else (call header 0i32 6i32))) words) 1i32))
			(let length (array.len
				(if first
					(then (array.new (array i32 1) 0i32))
					(else (array.new (array i32 1) 1i32)))))
			(return (i32.add length
				(i32.add sequence (i32.add word nested))))))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (i32.eq (call read (bool true)) 10i32)) (then (return 1i32)))
			(if (bool.not (i32.eq (call read (bool false)) 13i32)) (then (return 2i32)))
			(return 42i32)))
)
