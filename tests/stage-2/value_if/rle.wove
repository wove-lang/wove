(module rle_value_if
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Status (variants (Ok) (IoError)))

	(fn mark
		(params (hits (mut-array u8)) (index i32)) (returns void)
		(body
			(let previous (u32.from-u8 (array.load (local hits) (local index))))
			(array.store (local hits) (local index) (u8.from-u32 (u32.add (local previous) 1u32)))))

	(fn write_header
		(params (decoded i32) (encoded i32) (hits (mut-array u8)) (ok bool)) (returns bool)
		(body
			(call mark (borrow-mut (local hits)) 0i32)
			(return (bool.and (i32.eq (local decoded) 0i32)
				(bool.and (i32.eq (local encoded) 0i32) (local ok))))))

	(fn finish
		(params (hits (mut-array u8)) (ok bool)) (returns Status)
		(body
			(return
				(if (call write_header 0i32 0i32 (borrow-mut (local hits)) (local ok))
					(then (enum.new Status Ok))
					(else (enum.new Status IoError))))))

	(fn status_code
		(params (status Status)) (returns i32)
		(body
			(match (local status)
				(case Ok (return 0i32))
				(case IoError (return 1i32)))))

	(fn result
		(params (hits (mut-array u8)) (index i32) (value i32)) (returns i32)
		(body
			(call mark (borrow-mut (local hits)) (local index))
			(return (local value))))

	(fn choose
		(params (hits (mut-array u8)) (ok bool)) (returns i32)
		(body
			(let selected
				(if (call write_header 0i32 0i32 (borrow-mut (local hits)) (local ok))
					(then (call result (borrow-mut (local hits)) 1i32 39i32))
					(else (call result (borrow-mut (local hits)) 2i32 40i32))))
			(return (i32.add (local selected)
				(if (bool false)
					(then (i32.div 1i32 0i32))
					(else (if (bool true) (then 2i32) (else 99i32))))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:370"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut hits (array.alloc u8 3i32))
			(if (bool.not (i32.eq (call status_code (call finish (borrow-mut (local hits)) (bool true))) 0i32))
				(then (return 1i32)))
			(if (bool.not (i32.eq (call status_code (call finish (borrow-mut (local hits)) (bool false))) 1i32))
				(then (return 2i32)))
			(if (bool.not (i32.eq (call choose (borrow-mut (local hits)) (bool true)) 41i32)) (then (return 3i32)))
			(if (bool.not (u8.eq (array.load (local hits) 1i32) 1u8)) (then (return 4i32)))
			(if (bool.not (u8.eq (array.load (local hits) 2i32) 0u8)) (then (return 5i32)))
			(if (bool.not (i32.eq (call choose (borrow-mut (local hits)) (bool false)) 42i32)) (then (return 6i32)))
			(if (bool.not (u8.eq (array.load (local hits) 0i32) 4u8)) (then (return 7i32)))
			(if (bool.not (u8.eq (array.load (local hits) 1i32) 1u8)) (then (return 8i32)))
			(if (bool.not (u8.eq (array.load (local hits) 2i32) 1u8)) (then (return 9i32)))
			(return 42i32)))
)
