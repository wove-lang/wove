(module conditional_native_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only fopen fclose))
	(let path "tests/stage-2/native_records/data.txt")
	(let read_mode "r")

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared read_mode)))
			(let status (if (i32:eq (i32:dec (array:len args)) 0i32)
				(then (call fclose (move stream)))
				(else (call fclose (move stream)))))
			(if (bool:not (i32:eq status 0i32)) (then (return 1i32)))

			(let live (call fopen (borrow-shared path) (borrow-shared read_mode)))
			(let skipped (if (bool false)
				(then (call fclose (move live)))
				(else 0i32)))
			(return (i32:add 42i32
				(i32:add skipped (call fclose (move live)))))))
)
