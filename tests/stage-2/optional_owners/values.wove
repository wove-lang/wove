(module optional_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn fresh (params (length i32)) (returns (optional (owned-array u8)))
		(body (return (optional.some (array.alloc u8 (local length))))))

	(fn read_bytes (params (present bool)) (returns (optional (owned-array u8)))
		(body
			(if (bool.not (local present)) (then (return (optional.none (owned-array u8)))))
			(let-mut data (array.alloc u8 1i32))
			(array.store (local data) 0i32 42u8)
			(return (optional.some (move (local data))))))

	(fn forward (params (present bool)) (returns (optional (owned-array u8)))
		(body (return (call read_bytes (local present)))))

	(fn relay (params (present bool)) (returns (optional (owned-array u8)))
		(body
			(let result (call forward (local present)))
			(return (move (local result)))))

	(fn checked_bytes (params) (returns (owned-array u8))
		(body
			(let data (call relay (bool true)))
			(if (owner.is-null (local data)) (then (return (array.alloc u8 0i32))))
			(return (move (optional.unwrap (local data))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call relay (bool false)))
			(if (bool.not (owner.is-null (local absent))) (then (return 1i32)))
			(let empty (call fresh 0i32))
			(if (owner.is-null (local empty)) (then (return 2i32)))
			(let unwrapped (move (optional.unwrap (local empty))))
			(if (i32.not-eqz (array.len (local unwrapped))) (then (return 3i32)))
			(let kept (call fresh 42i32))
			(if (owner.is-null (local kept)) (then (return 4i32)))
			(let data (call checked_bytes))
			(return (i32.from-u8 (array.load (local data) 0i32)))))
)
