(module optional_request_log
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./loader.wove" (only (as read_log load)))
	(let missing "input.txt/absent")
	(let present "input.txt")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let absent (call load (borrow-shared (local missing))))
			(if (bool.not (owner.is-null (local absent))) (then (return 1i32)))
			(let loaded (call load (borrow-shared (local present))))
			(if (owner.is-null (local loaded)) (then (return 2i32)))
			(let data (move (optional.unwrap (local loaded))))
			(if (i32.eqz (array.len (local data))) (then (return 3i32)))
			(if (u8.not-eq (array.load (local data) 0i32) 35u8) (then (return 4i32)))
			(return 42i32)))
)
