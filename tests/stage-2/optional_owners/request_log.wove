(module optional_request_log
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./loader.wove" (only (as read_log load)))
	(let missing "input.txt/absent")
	(let present "input.txt")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call load (borrow-shared missing)))
			(if (bool:not (owner:is-null absent)) (then (return 1i32)))
			(let loaded (call load (borrow-shared present)))
			(if (owner:is-null loaded) (then (return 2i32)))
			(let data (move (optional:unwrap loaded)))
			(if (i32:eqz (array:len data)) (then (return 3i32)))
			(if (u8:not-eq (array:load data 0i32) 35u8) (then (return 4i32)))
			(return 42i32)))
)
