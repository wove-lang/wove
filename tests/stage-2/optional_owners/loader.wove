(module optional_loader
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only (type File) (type Size) (type Long)
		fopen fread fseek ftell (value SEEK_SET) (value SEEK_END)))
	(let mode "rb")

	(fn read_log (params (path (shared-array u8))) (returns (optional (owned-array u8)))
		(body
			(let stream (call fopen (borrow-shared (local path)) (borrow-shared (local mode))))
			(if (owner.is-null (local stream)) (then (return (optional.none (owned-array u8)))))
			(let zero (int.convert Long 0i32))
			(if (i32.not-eqz (call fseek (borrow-shared (local stream)) (local zero) (local SEEK_END)))
				(then (return (optional.none (owned-array u8)))))
			(let length (int.convert i64 (call ftell (borrow-shared (local stream)))))
			(if (bool.or (i64.ltz (local length)) (i64.gt (local length) 2147483647i64))
				(then (return (optional.none (owned-array u8)))))
			(if (i32.not-eqz (call fseek (borrow-shared (local stream)) (local zero) (local SEEK_SET)))
				(then (return (optional.none (owned-array u8)))))
			(let size (i32.from-i64 (local length)))
			(let-mut data (array.alloc u8 (local size)))
			(let count (int.convert Size (local size)))
			(let read (call fread (borrow-mut (local data)) (int.convert Size 1i32) (local count) (borrow-shared (local stream))))
			(if (int.not-eq Size (local read) (local count)) (then (return (optional.none (owned-array u8)))))
			(return (optional.some (move (local data))))))
)
