(module native_float_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<math.h>" (only (as fabsf abs32) (as fabs abs64)))

	(fn magnitude
		(params (x f32) (y f64))
		(returns f64)
		(body (return (f64.add (f64.from-f32 (call abs32 (local x))) (call abs64 (local y))))))

	(fn main (params (entry_args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (f64.eq (call magnitude -2.5f32 -39.5f64) 42.0f64) (then (return 42i32)))
			(return 1i32))))
