(module float_conversions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn to_signed (params (value f64)) (returns i32)
		(body (return (i32:from-f64 value))))

	(fn to_byte (params (value f64)) (returns u8)
		(body (return (u8:from-f64 value))))

	(fn to_wide (params (value f64)) (returns u64)
		(body (return (u64:from-f64 value))))

	(fn to_narrow (params (value f64)) (returns f32)
		(body (return (f32:from-f64 value))))

	(fn main
		(params (arguments (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (i32:dec (array:len arguments)))
			(if (i32:eq count 1i32)
				(then (return (call to_signed 2147483648.0f64))))
			(if (i32:eq count 2i32)
				(then (return (call to_signed -2147483649.0f64))))
			(if (i32:eq count 3i32)
				(then (return (i32:from-u8 (call to_byte -1.0f64)))))
			(if (i32:eq count 4i32)
				(then (return (i32:from-u8 (call to_byte 256.0f64)))))
			(if (i32:eq count 5i32)
				(then (return (i32:from-u64 (call to_wide 18446744073709551616.0f64)))))
			(if (i32:eq count 6i32)
				(then (return (i32:from-f32 (call to_narrow 3.5e38f64)))))
			(if (i32:eq count 7i32)
				(then (return (call to_signed (f64:from-bits 9221120237041090626u64)))))
			(if (i32:eq count 8i32)
				(then (return (call to_signed (f64:from-bits 9218868437227405312u64)))))
			(if (bool:not (i32:eq (call to_signed -2147483648.5f64) -2147483648i32)) (then (return 2i32)))
			(if (bool:not (i32:eq (call to_signed 2147483647.99f64) 2147483647i32)) (then (return 3i32)))
			(if (bool:not (u8:eq (call to_byte -0.75f64) 0u8)) (then (return 4i32)))
			(if (bool:not (u8:eq (call to_byte 255.875f64) 255u8)) (then (return 5i32)))
			(if (bool:not (u64:eq (call to_wide 18446744073709549568.0f64) 18446744073709549568u64))
				(then (return 6i32)))
			(if (bool:not (u32:eq (u32:from-f64 4294967295.0f64) 4294967295u32)) (then (return 7i32)))
			(if (bool:not (i32:eq (i32:from-i8 (i8:from-f32 -128.5f32)) -128i32)) (then (return 8i32)))
			(if (bool:not (f32:eq (f32:from-i32 -16777215i32) -16777215.0f32)) (then (return 9i32)))
			(if (bool:not (f64:eq (f64:from-u64 18446744073709551615u64) 18446744073709551616.0f64))
				(then (return 10i32)))
			(if (bool:not (u32:eq (f32:to-bits (call to_narrow (f64:from-bits 9218868437227405312u64))) 2139095040u32))
				(then (return 11i32)))
			(if (bool:not (u32:eq (f32:to-bits (call to_narrow 1.401298464324817e-45f64)) 1u32))
				(then (return 12i32)))
			(return 42i32))))
