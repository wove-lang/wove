(module float_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Point (fields (x f32) (y f64)))
	(let origins (array.new (array Point 1) (struct.new Point (x -0f32) (y (f64 -0)))))
	(let half (f64 0.5))
	(let angles (array.new (array f64 2) 5e-1f64 (f64 1.25E+0)))

	(fn read_coordinate
		(:expect (issues "gh:wove-lang/wove:332"))
		(params (source (shared-array u8)))
		(returns f64)
		(body
			(return (f64.from-f32 (f32.from-bits (u32.from-le-bytes
				(borrow-shared (array.range (local source) 1i32 5i32))))))))

	(fn scale
		(params (point Point) (factor f32))
		(returns Point)
		(body
			(let-mut x (struct.get (local point) x))
			(set (local x) (f32.mul (local x) (local factor)))
			(return (struct.new Point (x (local x))
				(y (f64.mul (struct.get (local point) y) (f64.from-f32 (local factor))))))))

	(fn take_byte
		(params (next (mut-array u8)))
		(returns f64)
		(body
			(let byte (array.load (local next) 0i32))
			(array.store (local next) 0i32 (u8.from-i32 (i32.add (i32.from-u8 (local byte)) 1i32)))
			(return (f64.from-u8 (local byte)))))

	(fn main (params (entry_args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let bytes (array.new (array u8 6) 255u8 0u8 0u8 32u8 192u8 255u8))
			(let coordinate (call read_coordinate (borrow-shared (local bytes))))
			(let origin (array.load (local origins) 0i32))
			(let point (call scale (struct.new Point (x 4.0f32) (y (local coordinate))) 2.0f32))
			(if (f64.not-eq (struct.get (local point) y) -5.0f64) (then (return 2i32)))
			(if (f32.not-eq (struct.get (local point) x) 8.0f32) (then (return 3i32)))
			(if (f64.lt (f64.add (local coordinate) 3.0f64) (local half))
				(then (return 4i32)))
			(if (f64.gt (f64.div (f64.sub (local coordinate) (f64 2.5)) (f64 -4))
				(array.load (local angles) 1i32))
				(then (return 5i32)))
			(if (bool.not (f32.ge (f32.neg -3.0f32) (f32.add (f32 0001) (f32 2))))
				(then (return 6i32)))
			(if (bool.not (f32.le (f32.div 3.0f32 4.0f32) (f32.sub 2.0f32 1.0f32)))
				(then (return 7i32)))
			(if (bool.not (u32.eq (f32.to-bits (struct.get (local origin) x)) 2147483648u32))
				(then (return 8i32)))
			(if (bool.not (u64.eq (f64.to-bits (struct.get (local origin) y)) 9223372036854775808u64))
				(then (return 9i32)))
			(if (bool.not (u32.eq (f32.to-bits (f32 1.00000005960464477539062500001)) 1065353217u32))
				(then (return 10i32)))
			(if (bool.not (u32.eq (f32.to-bits (f32.from-bits 2143289410u32)) 2143289410u32))
				(then (return 11i32)))
			(if (bool.not (u64.eq (f64.to-bits (f64.from-bits 9221120237041090626u64)) 9221120237041090626u64))
				(then (return 12i32)))
			(if (bool.not (u64.eq (f64.to-bits (f64.from-bits 9223372036854775808u64)) 9223372036854775808u64))
				(then (return 13i32)))
			(if (bool.not (u32.eq (f32.to-bits (f32.from-bits 2147483648u32)) 2147483648u32))
				(then (return 14i32)))
			(if (f32.eq (f32.from-bits 2143289410u32) 0.0f32) (then (return 15i32)))
			(let-mut next (array.alloc u8 1i32))
			(let difference (f64.sub (call take_byte (borrow-mut (local next))) (call take_byte (borrow-mut (local next)))))
			(if (f64.not-eq (local difference) -1.0f64) (then (return 16i32)))
			(if (bool.not (u8.eq (array.load (local next) 0i32) 2u8)) (then (return 17i32)))
			(return 42i32))))
