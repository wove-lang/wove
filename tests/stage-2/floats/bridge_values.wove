(module native_float_macro_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<math.h>" (only (value HUGE_VAL) (value (as HUGE_VALF magnitude32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (u64.eq (f64.to-bits HUGE_VAL) 9218868437227405312u64))
				(then (return 1i32)))
			(if (bool.not (u32.eq (f32.to-bits magnitude32) 2139095040u32))
				(then (return 2i32)))
			(return 42i32))))
