(module native_storage_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./storage.h" (only (type Box) fixture_init))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let box (native.alloc Box))
			(return (call fixture_init (borrow-mut (local box)) (bool true))))))
