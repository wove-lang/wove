(module native_storage_preconditions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./storage.h" (only (type Box) fixture_init fixture_read fixture_drop))

	(fn main
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut box (native.alloc Box))
			(let condition (i32.dec (array.len argv)))
			(if (i32.eq condition 1i32)
				(then (return (call fixture_read (borrow-shared box)))))
			(if (i32.eq condition 2i32)
				(then (return (call fixture_drop (move box)))))
			(if (bool.not (i32.eq (call fixture_init (borrow-mut box) (bool true)) 0i32))
				(then (return 1i32)))
			(if (i32.eq condition 3i32)
				(then (return (call fixture_init (borrow-mut box) (bool true)))))
			(return 42i32))))
