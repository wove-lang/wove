(module native_storage_after_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./storage.h" (only (type Box) fixture_init fixture_drop fixture_read))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut box (native.alloc Box))
			(let initialized (call fixture_init (borrow-mut (local box)) (bool true)))
			(let destroyed (call fixture_drop (move (local box))))
			(return (call fixture_read (borrow-shared (local box)))))))
