(module incompatible_native_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type (:pragma (c_owned (tail count data))) Handle (c-type "struct test_handle"))
		(fn wrong (c-name "test_use") (params (handle (shared-ref Handle))) (returns i32)))
	(use c-header "./tail.h" (only wrong))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 0i32))))
