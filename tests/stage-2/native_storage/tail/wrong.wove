(module incompatible_native_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type Handle (:pragma (c_owned (tail count data))) (c-type "struct test_handle"))
		(fn wrong (c-name "test_use") (params (handle (shared-ref Handle))) (returns i32)))
	(use c-header "./tail.h" (only wrong))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 0i32))))
