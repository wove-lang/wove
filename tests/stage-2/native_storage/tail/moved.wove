(module moved_native_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type (:pragma (c_owned (tail count data))) Handle (c-type "struct test_handle")))
	(use c-header "./tail.h" (only (type Handle)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let handle (native.alloc Handle 80i64))
			(let other (move (local handle)))
			(return (i32.from-u32 (native.tail.report (borrow-shared (local handle))))))))
