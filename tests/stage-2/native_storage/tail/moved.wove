(module moved_native_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type Handle (:pragma (c_owned (tail count data))) (c-type "struct test_handle")))
	(use c-header "./tail.h" (only (type Handle)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let handle (native:alloc Handle 80i64))
			(let other (move handle))
			(return (i32:from-u32 (native:tail-report (borrow-shared handle)))))))
