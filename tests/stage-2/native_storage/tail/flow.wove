(module byte_tail_flow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type Handle (:pragma (c_owned (tail count data))) (c-type "struct test_handle"))
		(const EIO i32)
		(const EOVERFLOW i32)
		(fn test_errno (params) (returns i32))
		(fn test_encode (:pragma (c_init handle))
			(params (handle (mut-ref Handle)) (ordinary_error i32)) (returns i32))
		(fn test_use (params (handle (mut-ref Handle))) (returns i32))
		(fn test_report (params (handle (mut-ref Handle)) (reported u32)) (returns i32)))
	(use c-header "./tail.h" (only (type Handle) (value EIO) (value EOVERFLOW)
		test_errno test_encode test_use test_report))

	(fn ordinary_failure (params) (returns bool)
		(body
			(let-mut handle (native.alloc Handle 7i64))
			(if (i32.not-eq (call test_encode (borrow-mut handle) 1i32) -1i32)
				(then (return (bool false))))
			(let count (native.tail.report (borrow-shared handle)))
			(return (bool.and (u32.eq count 7u32) (i32.eq (call test_errno) EIO)))))

	(fn run (params (scenario i32)) (returns i32)
		(body
			(let-mut handle (native.alloc Handle 0i64))
			(if (i32.not-eq (call test_encode (borrow-mut handle) 0i32) -1i32)
				(then (return 1i32)))
			(let required (native.tail.report (borrow-shared handle)))
			(if (bool.not (bool.and (u32.eq required 80u32) (i32.eq (call test_errno) EOVERFLOW)))
				(then (return 2i32)))
			(if (i32.eq scenario 1i32)
				(then (return (i32.from-u8 (native.tail.load (borrow-shared handle) 0i64)))))
			(set handle (native.alloc Handle (i64.from-u32 required)))
			(if (i32.not-eqz (call test_encode (borrow-mut handle) 0i32))
				(then (return 3i32)))
			(if (i32.eq scenario 2i32)
				(then (return (i32.from-u8 (native.tail.load (borrow-shared handle) 80i64)))))
			(if (i32.ge scenario 3i32)
				(then
					(if (i32.not-eqz (call test_report (borrow-mut handle) 81u32))
						(then (return 4i32)))
					(if (i32.eq scenario 3i32)
						(then (return (i32.from-u8 (native.tail.load (borrow-shared handle) 0i64)))))
					(return (call test_use (borrow-mut handle)))))
			(if (u8.not-eq (native.tail.load (borrow-shared handle) 79i64) 42u8)
				(then (return 5i32)))
			(return (call test_use (borrow-mut handle)))))

	(fn main (:expect (issues "gh:wove-lang/wove:551"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let scenario (i32.dec (array.len args)))
			(if (i32.eq scenario 5i32)
				(then
					(let invalid (native.alloc Handle -1i64))
					(return 6i32)))
			(if (i32.eq scenario 6i32)
				(then
					(let invalid (native.alloc Handle 4294967296i64))
					(return 7i32)))
			(if (bool.not (call ordinary_failure)) (then (return 8i32)))
			(return (call run scenario)))))
