(module load_extra_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type Handle (:pragma (c_owned (tail count data))) (c-type "struct test_handle")))
	(use c-header "./tail.h" (only (type Handle)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let handle (native.alloc Handle 4i64))
			(return (i32.from-u8 (native.tail.load (borrow-shared handle 123i32) 0i64))))))
