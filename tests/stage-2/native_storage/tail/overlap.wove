(module overlapping_native_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./tail.h"
		(type Handle (:pragma (c_owned (tail count data))) (c-type "struct test_handle"))
		(fn test_use (params (handle (mut-ref Handle))) (returns i32)))
	(use c-header "./tail.h" (only (type Handle) test_use))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut handle (native:alloc Handle 80i64))
			(return (i32:from-u8 (native:tail-load (borrow-shared handle)
				(i64:from-i32 (call test_use (borrow-mut handle)))))))))
