(module native_storage_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./storage.h"
		(type
			(:pragma (c_owned (drop fixture_drop) storage))
			Box
			(c-type "fixture_storage"))
		(type
			(:pragma (c_owned (drop fixture_drop) storage))
			OtherBox
			(c-type "fixture_storage"))
		(fn fixture_init
			(:pragma (c_init box))
			(params (box (mut-ref Box)) (succeed bool))
			(returns i32))
		(fn fixture_read
			(params (box (shared-ref Box)))
			(returns i32))
		(fn fixture_drop
			(params (box Box))
			(returns i32))
		(fn fixture_drops (params) (returns i32))
		(fn fixture_pair
			(params (left (mut-ref Box)) (right (shared-ref Box)))
			(returns i32))))
