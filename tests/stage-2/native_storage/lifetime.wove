(module native_storage_lifetime
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./storage.h" (only (type (as Box Storage)) fixture_init fixture_read fixture_drop fixture_drops))

	(fn never_initialized
		(params)
		(returns i32)
		(body
			(let box (native.alloc Storage))
			(return 0i32)))

	(fn failed
		(params)
		(returns i32)
		(body
			(let-mut box (native.alloc Storage))
			(return (call fixture_init (borrow-mut box) (bool false)))))

	(fn scoped
		(params)
		(returns i32)
		(body
			(let-mut box (native.alloc Storage))
			(if (bool.not (i32.eq (call fixture_init (borrow-mut box) (bool true)) 0i32))
				(then (return 1i32)))
			(return (call fixture_read (borrow-shared box)))))

	(fn retried_and_consumed
		(params)
		(returns i32)
		(body
			(let-mut box (native.alloc Storage))
			(if (bool.not (i32.eq (call fixture_init (borrow-mut box) (bool false)) 17i32))
				(then (return 1i32)))
			(if (bool.not (i32.eq (call fixture_init (borrow-mut box) (bool true)) 0i32))
				(then (return 2i32)))
			(return (call fixture_drop (move box)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool.not (i32.eq (call never_initialized) 0i32)) (then (return 1i32)))
			(if (bool.not (i32.eq (call failed) 17i32)) (then (return 2i32)))
			(if (bool.not (i32.eq (call fixture_drops) 0i32)) (then (return 3i32)))
			(if (bool.not (i32.eq (call scoped) 73i32)) (then (return 4i32)))
			(if (bool.not (i32.eq (call fixture_drops) 1i32)) (then (return 5i32)))
			(if (bool.not (i32.eq (call retried_and_consumed) 23i32)) (then (return 6i32)))
			(if (bool.not (i32.eq (call fixture_drops) 2i32)) (then (return 7i32)))
			(return 42i32))))
