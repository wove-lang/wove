(module native_spawn_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<spawn.h>"
		(only (type Actions) posix_spawn_file_actions_init posix_spawn_file_actions_addclose
			posix_spawn_file_actions_adddup2 posix_spawn_file_actions_destroy))

	(fn scoped_actions
		(params)
		(returns i32)
		(body
			(let-mut actions (native:alloc Actions))
			(let status (call posix_spawn_file_actions_init (borrow-mut actions)))
			(if (bool:not (i32:eq status 0i32)) (then (return status)))
			(return (call posix_spawn_file_actions_addclose (borrow-mut actions) 8i32))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:not (i32:eq (call scoped_actions) 0i32)) (then (return 1i32)))
			(let-mut actions (native:alloc Actions))
			(if (bool:not (i32:eq (call posix_spawn_file_actions_init (borrow-mut actions)) 0i32))
				(then (return 2i32)))
			(if (bool:not (i32:eq (call posix_spawn_file_actions_adddup2 (borrow-mut actions) 1i32 8i32) 0i32))
				(then (return 3i32)))
			(if (bool:not (i32:eq (call posix_spawn_file_actions_destroy (move actions)) 0i32))
				(then (return 4i32)))
			(return 42i32))))
