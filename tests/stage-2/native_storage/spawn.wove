(module native_spawn_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<spawn.h>"
		(only (type Actions) posix_spawn_file_actions_init posix_spawn_file_actions_addclose
			posix_spawn_file_actions_adddup2 posix_spawn_file_actions_destroy))

	(fn scoped_actions
		(params)
		(returns i32)
		(body
			(let-mut actions (native.alloc Actions))
			(let status (call posix_spawn_file_actions_init (borrow-mut (local actions))))
			(if (bool.not (i32.eq (local status) 0i32)) (then (return (local status))))
			(return (call posix_spawn_file_actions_addclose (borrow-mut (local actions)) 8i32))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(if (bool.not (i32.eq (call scoped_actions) 0i32)) (then (return 1i32)))
			(let-mut actions (native.alloc Actions))
			(if (bool.not (i32.eq (call posix_spawn_file_actions_init (borrow-mut (local actions))) 0i32))
				(then (return 2i32)))
			(if (bool.not (i32.eq (call posix_spawn_file_actions_adddup2 (borrow-mut (local actions)) 1i32 8i32) 0i32))
				(then (return 3i32)))
			(if (bool.not (i32.eq (call posix_spawn_file_actions_destroy (move (local actions))) 0i32))
				(then (return 4i32)))
			(return 42i32))))
