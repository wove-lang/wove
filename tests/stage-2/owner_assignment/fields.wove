(module owner_assignment_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Index (fields (slots (owned-array i32))))
	(struct Table (fields (index Index) (unchanged (owned-array i32))))

	(fn more_slots (params (old (shared-array i32))) (returns (owned-array i32))
		(body
			(let-mut grown (array.alloc i32 (i32.inc (array.len (local old)))))
			(array.store (local grown) 0i32 (i32.inc (array.load (local old) 0i32)))
			(return (move (local grown)))))

	(fn rebuild (params (table (mut-ref Table))) (returns void)
		(body
			(let grown (call more_slots (borrow-shared (struct.get (struct.get (local table) index) slots))))
			(set (struct.get (struct.get (local table) index) slots) (move (local grown)))))

	(fn seed (params (slots (mut-array i32))) (returns void)
		(body (array.store (local slots) 0i32 40i32)))

	(fn first (params (slots (shared-array i32))) (returns i32)
		(body (return (array.load (local slots) 0i32))))

	(fn count (params (slots (shared-array i32))) (returns i32)
		(body (return (array.len (local slots)))))

	(fn value (params (table (shared-ref Table))) (returns i32)
		(body (return (call first (borrow-shared (struct.get (struct.get (local table) index) slots))))))

	(fn run (params) (returns i32)
		(body
			(let-mut table (struct.new Table
				(index (struct.new Index (slots (array.alloc i32 1i32))))
				(unchanged (array.alloc i32 3i32))))
			(call seed (borrow-mut (struct.get (struct.get (local table) index) slots)))
			(call rebuild (borrow-mut (local table)))
			(set (struct.get (struct.get (local table) index) slots)
				(call more_slots (borrow-shared (struct.get (struct.get (local table) index) slots))))
			(let old (move (struct.get (struct.get (local table) index) slots)))
			(set (struct.get (struct.get (local table) index) slots) (move (local old)))
			(if (i32.not-eq (call count (borrow-shared (struct.get (local table) unchanged))) 3i32) (then (return 2i32)))
			(return (call value (borrow-shared (local table))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call run))))
)
