(module owner_assignment_missing_branch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check (params (write bool)) (returns i32)
		(body
			(let-mut data (array.alloc u8 42i32))
			(let old (move data))
			(if write (then (set data (array.alloc u8 42i32))))
			(return (array.len data))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check (bool true)))))
)
