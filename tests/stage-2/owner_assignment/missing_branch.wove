(module owner_assignment_missing_branch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check (params (write bool)) (returns i32)
		(body
			(let-mut data (array.alloc u8 42i32))
			(let old (move (local data)))
			(if (local write) (then (set (local data) (array.alloc u8 42i32))))
			(return (array.len (local data)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call check (bool true)))))
)
