(module owner_assignment_stdlib
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type File) fopen fgetc))
	(use c-header "<stdlib.h>" (only realpath))
	(use c-header "<spawn.h>"
		(only (type Actions) posix_spawn_file_actions_init posix_spawn_file_actions_addclose))
	(let input "input.txt")
	(let mode "rb")
	(let absent "input.txt/absent")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut file (call fopen (borrow-shared (local input)) (borrow-shared (local mode))))
			(set (local file) (move (local file)))
			(if (i32.ltz (call fgetc (borrow-shared (local file)))) (then (return 1i32)))
			(set (local file) (call fopen (borrow-shared (local absent)) (borrow-shared (local mode))))
			(if (bool.not (owner.is-null (local file))) (then (return 2i32)))
			(set (local file) (call fopen (borrow-shared (local input)) (borrow-shared (local mode))))
			(if (i32.ltz (call fgetc (borrow-shared (local file)))) (then (return 3i32)))
			(let-mut path (call realpath (borrow-shared (local input)) null))
			(let-mut unused (call realpath (borrow-shared (local absent)) null))
			(set (local path) (move (local unused)))
			(if (bool.not (owner.is-null (local path))) (then (return 4i32)))
			(set (local unused) (call realpath (borrow-shared (local input)) null))
			(if (owner.is-null (local unused)) (then (return 5i32)))
			(let-mut actions (native.alloc Actions))
			(let initialized (call posix_spawn_file_actions_init (borrow-mut (local actions))))
			(if (i32.not-eqz (local initialized)) (then (return 6i32)))
			(set (local actions) (native.alloc Actions))
			(set (local actions) (move (local actions)))
			(let replaced (call posix_spawn_file_actions_init (borrow-mut (local actions))))
			(if (i32.not-eqz (local replaced)) (then (return 7i32)))
			(if (i32.not-eqz (call posix_spawn_file_actions_addclose (borrow-mut (local actions)) 8i32)) (then (return 8i32)))
			(return 42i32)))
)
