(module owner_assignment_stdlib
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type File) fopen fgetc))
	(use c-header "<stdlib.h>" (only realpath))
	(use c-header "<spawn.h>"
		(only (type Actions) posix_spawn_file_actions_init posix_spawn_file_actions_addclose))
	(let input "input.txt")
	(let mode "rb")
	(let absent "input.txt/absent")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut file (call fopen (borrow-shared input) (borrow-shared mode)))
			(set file (move file))
			(if (i32.ltz (call fgetc (borrow-shared file))) (then (return 1i32)))
			(set file (call fopen (borrow-shared absent) (borrow-shared mode)))
			(if (bool.not (owner.is-null file)) (then (return 2i32)))
			(set file (call fopen (borrow-shared input) (borrow-shared mode)))
			(if (i32.ltz (call fgetc (borrow-shared file))) (then (return 3i32)))
			(let-mut path (call realpath (borrow-shared input) null))
			(let-mut unused (call realpath (borrow-shared absent) null))
			(set path (move unused))
			(if (bool.not (owner.is-null path)) (then (return 4i32)))
			(set unused (call realpath (borrow-shared input) null))
			(if (owner.is-null unused) (then (return 5i32)))
			(let-mut actions (native.alloc Actions))
			(let initialized (call posix_spawn_file_actions_init (borrow-mut actions)))
			(if (i32.not-eqz initialized) (then (return 6i32)))
			(set actions (native.alloc Actions))
			(set actions (move actions))
			(let replaced (call posix_spawn_file_actions_init (borrow-mut actions)))
			(if (i32.not-eqz replaced) (then (return 7i32)))
			(if (i32.not-eqz (call posix_spawn_file_actions_addclose (borrow-mut actions) 8i32)) (then (return 8i32)))
			(return 42i32)))
)
