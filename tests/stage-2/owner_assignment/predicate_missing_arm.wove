(module owner_assignment_predicate_missing_arm
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn consume (params (data (owned-array u8))) (returns bool)
		(body (return (i32.eqz (array.len (local data))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut current (array.alloc u8 17i32))
			(if (call consume (move (local current)))
				(then (set (local current) (array.alloc u8 42i32))))
			(return (array.len (local current)))))
)
