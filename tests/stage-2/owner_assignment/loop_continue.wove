(module owner_assignment_loop_continue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check (params (skip bool)) (returns i32)
		(body
			(let-mut data (array:alloc u8 42i32))
			(while (bool true)
				(body
					(let old (move data))
					(if skip (then (continue)))
					(set data (move old))
					(break)))
			(return (array:len data))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check (bool false)))))
)
