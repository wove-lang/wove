(module owner_assignment_swap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Sample (fields (count i32)))

	(fn pass (params (input (shared-array Sample)) (scratch (mut-array Sample))) (returns void)
		(body
			(let value (struct:get (array:load input 0i32) count))
			(array:store scratch 0i32 (struct:new Sample (count (i32:inc value))))))

	(fn swap (params (rounds i32)) (returns i32)
		(body
			(let-mut input (array:alloc Sample 1i32))
			(let-mut scratch (array:alloc Sample 1i32))
			(let-mut index 0i32)
			(array:store input 0i32 (struct:new Sample (count 38i32)))
			(while (i32:lt index rounds)
				(body
					(call pass (borrow-shared input) (borrow-mut scratch))
					(let spare (move input))
					(set input (move scratch))
					(set scratch (move spare))
					(set index (i32:inc index))))
			(return (struct:get (array:load input 0i32) count))))

	(fn refill (params (branch bool)) (returns i32)
		(body
			(let-mut current (array:alloc u8 17i32))
			(let previous (move current))
			(if branch
				(then (set current (array:alloc u8 25i32)))
				(else (set current (array:alloc u8 25i32))))
			(return (i32:add (array:len previous) (array:len current)))))

	(fn consume (params (data (owned-array u8)) (branch bool)) (returns bool)
		(body
			(if (i32:not-eq (array:len data) 17i32) (then (return (bool false))))
			(return branch)))

	(fn refill_from_predicate (params (branch bool)) (returns i32)
		(body
			(let-mut current (array:alloc u8 17i32))
			(if (call consume (move current) branch)
				(then (set current (array:alloc u8 42i32)))
				(else (set current (array:alloc u8 41i32))))
			(return (array:len current))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call swap 4i32) 42i32) (then (return 1i32)))
			(if (i32:not-eq (call refill (bool true)) 42i32) (then (return 2i32)))
			(if (i32:not-eq (call refill (bool false)) 42i32) (then (return 3i32)))
			(if (i32:not-eq (call refill_from_predicate (bool false)) 41i32) (then (return 4i32)))
			(return (call refill_from_predicate (bool true)))))
)
