(module owner_assignment_swap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Sample (fields (count i32)))

	(fn pass (params (input (shared-array Sample)) (scratch (mut-array Sample))) (returns void)
		(body
			(let value (struct.get (array.load (local input) 0i32) count))
			(array.store (local scratch) 0i32 (struct.new Sample (count (i32.inc (local value)))))))

	(fn swap (params (rounds i32)) (returns i32)
		(body
			(let-mut input (array.alloc Sample 1i32))
			(let-mut scratch (array.alloc Sample 1i32))
			(let-mut index 0i32)
			(array.store (local input) 0i32 (struct.new Sample (count 38i32)))
			(while (i32.lt (local index) (local rounds))
				(body
					(call pass (borrow-shared (local input)) (borrow-mut (local scratch)))
					(let spare (move (local input)))
					(set (local input) (move (local scratch)))
					(set (local scratch) (move (local spare)))
					(set (local index) (i32.inc (local index)))))
			(return (struct.get (array.load (local input) 0i32) count))))

	(fn refill (params (branch bool)) (returns i32)
		(body
			(let-mut current (array.alloc u8 17i32))
			(let previous (move (local current)))
			(if (local branch)
				(then (set (local current) (array.alloc u8 25i32)))
				(else (set (local current) (array.alloc u8 25i32))))
			(return (i32.add (array.len (local previous)) (array.len (local current))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (i32.not-eq (call swap 4i32) 42i32) (then (return 1i32)))
			(if (i32.not-eq (call refill (bool true)) 42i32) (then (return 2i32)))
			(return (call refill (bool false)))))
)
