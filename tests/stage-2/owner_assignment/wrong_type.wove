(module owner_assignment_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Table (fields (slots (owned-array i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut table (struct.new Table (slots (array.alloc i32 17i32))))
			(let replacement (array.alloc u8 42i32))
			(set (struct.get table slots) (move replacement))
			(return 42i32)))
)
