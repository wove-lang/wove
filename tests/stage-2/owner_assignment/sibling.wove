(module owner_assignment_sibling
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Table (fields (held (owned-array u8)) (slots (owned-array u8))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut table (struct.new Table (held (array.alloc u8 17i32)) (slots (array.alloc u8 3i32))))
			(let held (borrow-shared (struct.get (local table) held)))
			(set (struct.get (local table) slots) (array.alloc u8 25i32))
			(let slots (borrow-shared (struct.get (local table) slots)))
			(return (i32.add (array.len (local held)) (array.len (local slots))))))
)
