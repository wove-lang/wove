(module owner_assignment_sibling
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Table (fields (held (owned-array u8)) (slots (owned-array u8))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut table (struct.new Table (held (array.alloc u8 17i32)) (slots (array.alloc u8 3i32))))
			(let held (borrow-shared (struct.get table held)))
			(set (struct.get table slots) (array.alloc u8 25i32))
			(let slots (borrow-shared (struct.get table slots)))
			(return (i32.add (array.len held) (array.len slots)))))
)
