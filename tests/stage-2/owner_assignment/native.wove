(module owner_assignment_native
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type (as Handle Resource)) fixture_open fixture_read
		fixture_opens fixture_drops fixture_live))
	(struct Box (fields (handle Resource)))

	(fn open (params (expected i32) (old_value i32)) (returns Resource)
		(body
			(let-mut result (native:empty Resource))
			(if (i32:not-eq (call fixture_drops) expected) (then (return (move result))))
			(if (i32:not-eq old_value 42i32) (then (return (move result))))
			(let status (call fixture_open (borrow-mut result) 2i32))
			(return (move result))))

	(fn run (params) (returns i32)
		(body
			(let-mut current (call open 0i32 42i32))
			(set current (call open 0i32 (call fixture_read (borrow-shared current))))
			(if (i32:not-eq (call fixture_drops) 1i32) (then (return 1i32)))
			(let-mut box (struct:new Box (handle (call open 1i32 42i32))))
			(set (struct:get box handle)
				(call open 1i32 (call fixture_read (borrow-shared (struct:get box handle)))))
			(if (i32:not-eq (call fixture_drops) 2i32) (then (return 2i32)))
			(set box (struct:new Box
				(handle (call open 2i32 (call fixture_read (borrow-shared (struct:get box handle)))))))
			(let-mut detached (move (struct:get box handle)))
			(set (struct:get box handle) (move current))
			(set current (move detached))
			(if (i32:not-eq (call fixture_drops) 3i32) (then (return 3i32)))
			(return (call fixture_read (borrow-shared current)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let answer (call run))
			(if (i32:not-eq (call fixture_opens) 5i32) (then (return 10i32)))
			(if (i32:not-eq (call fixture_drops) 5i32) (then (return 11i32)))
			(if (i32:not-eqz (call fixture_live)) (then (return 12i32)))
			(return answer)))
)
