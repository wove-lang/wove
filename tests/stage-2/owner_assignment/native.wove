(module owner_assignment_native
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type (as Handle Resource)) fixture_open fixture_read
		fixture_opens fixture_drops fixture_live))
	(struct Box (fields (handle Resource)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn open (params (expected i32) (old_value i32)) (returns Resource)
		(body
			(let-mut result (native.empty Resource))
			(if (i32.not-eq (call fixture_drops) (local expected)) (then (return (move (local result)))))
			(if (i32.not-eq (local old_value) 42i32) (then (return (move (local result)))))
			(let status (call fixture_open (borrow-mut (local result)) 2i32))
			(return (move (local result)))))

	(fn run (params) (returns i32)
		(body
			(let-mut current (call open 0i32 42i32))
			(set (local current) (call open 0i32 (call fixture_read (borrow-shared (local current)))))
			(if (i32.not-eq (call fixture_drops) 1i32) (then (return 1i32)))
			(let-mut box (struct.new Box (handle (call open 1i32 42i32))))
			(set (struct.get (local box) handle)
				(call open 1i32 (call fixture_read (borrow-shared (struct.get (local box) handle)))))
			(if (i32.not-eq (call fixture_drops) 2i32) (then (return 2i32)))
			(set (local box) (struct.new Box
				(handle (call open 2i32 (call fixture_read (borrow-shared (struct.get (local box) handle)))))))
			(let-mut detached (move (struct.get (local box) handle)))
			(set (struct.get (local box) handle) (move (local current)))
			(set (local current) (move (local detached)))
			(if (i32.not-eq (call fixture_drops) 3i32) (then (return 3i32)))
			(return (call fixture_read (borrow-shared (local current))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let answer (call run))
			(if (i32.not-eq (call fixture_opens) 5i32) (then (return 10i32)))
			(if (i32.not-eq (call fixture_drops) 5i32) (then (return 11i32)))
			(if (i32.not-eqz (call fixture_live)) (then (return 12i32)))
			(return (local answer))))
)
