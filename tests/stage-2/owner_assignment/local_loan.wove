(module owner_assignment_local_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc u8 17i32))
			(let held (borrow-shared (local data)))
			(set (local data) (array.alloc u8 42i32))
			(return (array.len (local held)))))
)
