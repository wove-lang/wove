(module owner_assignment_field_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Table (fields (slots (owned-array u8))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut table (struct:new Table (slots (array:alloc u8 17i32))))
			(let held (borrow-shared (struct:get table slots)))
			(set (struct:get table slots) (array:alloc u8 42i32))
			(return (array:len held))))
)
