(module stream_consumed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose fgetc))
	(let path "tests/stage-2/native_records/data.txt")
	(let read_mode "r")
	(fn main (params) (returns i32)
		(body
			(let stream (call fopen (borrow-shared (local path)) (borrow-shared (local read_mode))))
		(if (bool true) (then (let status (call fclose (move (local stream))))))
		(return (call fgetc (borrow-shared (local stream))))
		))
)
