(module owner_size
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./extent.h" (only acquire read_product))
	(let data "sample")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let owner (call acquire))
			(return (call read_product (borrow-shared (local data)) (move (local owner)) (i32 1)))))
)
