	(bridge c-header "./loan.h"
		(type Resource (:pragma (c_owned (drop drop_test_resource))) (c-type "TestResource *"))
		(fn acquire (params) (returns Resource))
		(fn consume_with_loan (params (borrowed (shared-ref Resource)) (owned Resource)) (returns i32)))
)
