(module owner_count
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./extent.h" (only acquire read_count))
	(let data "sample")
	(fn main (params) (returns i32)
		(body
			(let owner (call acquire))
			(return (call read_count (borrow-shared (local data)) (move (local owner))))))
)
