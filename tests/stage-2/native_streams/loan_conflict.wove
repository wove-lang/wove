(module stream_loan_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./loan.h" (only acquire consume_with_loan))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let stream (call acquire))
			(return (call consume_with_loan (borrow-shared (local stream)) (move (local stream))))))
)
