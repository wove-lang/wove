(module stream_loan_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./loan.h" (only acquire consume_with_loan))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call acquire))
			(return (call consume_with_loan (borrow-shared stream) (move stream)))))
)
