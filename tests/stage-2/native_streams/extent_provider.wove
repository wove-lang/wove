(module stream_extent_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./extent.h"
		(type (:pragma (c_owned (drop drop_test_resource))) Resource (c-type "TestResource *"))
		(fn acquire (params) (returns Resource))
		(fn read_count (:pragma (c_bytes bytes count))
			(params (bytes (shared-array u8)) (count Resource))
			(returns i32))
		(fn read_product (:pragma (c_bytes bytes size count))
			(params (bytes (shared-array u8)) (size Resource) (count i32))
			(returns i32)))
)
