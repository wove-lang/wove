(module stream_returning_loop
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose))
	(let path "tests/stage-2/native_records/data.txt")
	(let read_mode "r")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared (local path)) (borrow-shared (local read_mode))))
			(if (owner.is-null (local stream)) (then (return (i32 1))))
			(while (bool true)
				(body
					(let status (call fclose (move (local stream))))
					(if (i32.eq (local status) (i32 0)) (then (return (i32 42))))
					(return (i32 2))))
			(return (i32 3))))
)
