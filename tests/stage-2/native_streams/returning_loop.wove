(module stream_returning_loop
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose))
	(let path "tests/stage-2/native_records/data.txt")
	(let read_mode "r")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared read_mode)))
			(if (owner:is-null stream) (then (return (i32 1))))
			(while (bool true)
				(body
					(let status (call fclose (move stream)))
					(if (i32:eq status (i32 0)) (then (return (i32 42))))
					(return (i32 2)))))))
