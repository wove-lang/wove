(module stream_ownership
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fgetc (as fclose close_stream)))
	(let present_path "tests/stage-2/native_records/data.txt")
	(let absent_path "tests/stage-2/native_records/data.txt/missing")
	(let read_mode "r")

	(fn read_path
		(:expect (tests "stage-2/native_streams/cases.tsv") (issues "gh:wove-lang/wove:225"))
		(params (path (shared-array u8)) (explicit bool)) (returns i32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared read_mode)))
			(if (owner.is-null stream) (then (return (i32 1))))
			(if (bool.not (i32.eq (call fgetc (borrow-shared stream)) (i32 35)))
				(then (return (i32 2))))
			(if explicit
				(then (return (call close_stream (move stream)))))
			(if (i32.eq (call fgetc (borrow-shared stream)) (i32 32))
				(then (return (i32 0))))
			(return (i32 3))))

	(fn conditional_close
		(params (explicit bool)) (returns i32)
		(body
			(let stream (call fopen (borrow-shared present_path) (borrow-shared read_mode)))
			(if (owner.is-null stream) (then (return (i32 4))))
			(let closed (bool.and explicit (i32.eq (call close_stream (move stream)) (i32 -1))))
			(if closed (then (return (i32 1))))
			(return (i32 0))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (i32.eq (call read_path (borrow-shared absent_path) (bool true)) (i32 1)))
				(then (return (i32 1))))
			(if (bool.not (i32.eq (call read_path (borrow-shared present_path) (bool true)) (i32 0)))
				(then (return (i32 2))))
			(if (bool.not (i32.eq (call read_path (borrow-shared present_path) (bool false)) (i32 0)))
				(then (return (i32 3))))
			(if (bool.not (i32.eq (call conditional_close (bool true)) (i32 1)))
				(then (return (i32 4))))
			(if (bool.not (i32.eq (call conditional_close (bool false)) (i32 0)))
				(then (return (i32 5))))
			(return (i32 42))))
)
