(module native_stat
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<sys/stat.h>"
		(only (type (as Stat FileStatus)) (type Device) (type Inode) (type Mode) (type Offset) (type Time) stat fstat S_ISREG))

	(fn timestamp_equal (:pragma (cfg (os "linux")))
		(params (first FileStatus) (second FileStatus)) (returns bool)
		(body
			(let a (struct.get (local first) st_mtim))
			(let b (struct.get (local second) st_mtim))
			(return (int.eq Time (struct.get (local a) tv_sec) (struct.get (local b) tv_sec)))))

	(fn timestamp_equal (:pragma (cfg (os "macos")))
		(params (first FileStatus) (second FileStatus)) (returns bool)
		(body
			(let a (struct.get (local first) st_mtimespec))
			(let b (struct.get (local second) st_mtimespec))
			(return (int.eq Time (struct.get (local a) tv_sec) (struct.get (local b) tv_sec)))))

	(fn metadata_matches
		(params (first FileStatus) (second FileStatus)) (returns bool)
		(body
			(let mode (struct.get (local first) st_mode))
			(let size (struct.get (local first) st_size))
			(return
				(bool.and
					(int.eq Device (struct.get (local first) st_dev) (struct.get (local second) st_dev))
					(bool.and
						(int.eq Inode (struct.get (local first) st_ino) (struct.get (local second) st_ino))
						(bool.and
							(int.eq Mode (local mode) (struct.get (local second) st_mode))
							(bool.and (call S_ISREG (local mode))
								(bool.and
									(int.eq Offset (local size) (struct.get (local second) st_size))
									(bool.and (int.eq Offset (local size) (int.convert Offset (i32 112)))
										(call timestamp_equal (local first) (local second)))))))))))

	(fn check_file
		(:expect (tests "stage-2/native_records/cases.tsv") (issues "gh:wove-lang/wove:223"))
		(params (path (shared-array u8))) (returns i32)
		(body
			(let-mut by_path (struct.new FileStatus))
			(let-mut by_fd (struct.new FileStatus))
			(if (bool.not (i32.eq (call stat (borrow-shared (local path)) (borrow-mut (local by_path))) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (i32.eq (call fstat (i32 0) (borrow-mut (local by_fd))) (i32 0)))
				(then (return (i32 2))))
			(if (call metadata_matches (local by_path) (local by_fd))
				(then (return (i32 42))))
			(return (i32 3))))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32.lt (array.len (local argv)) 2i32) (then (return 4i32)))
			(return (call check_file (borrow-shared (array.load (local argv) 1i32)))))))
