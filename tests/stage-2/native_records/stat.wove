(module native_stat
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<sys/stat.h>"
		(only (type (as Stat FileStatus)) (type Device) (type Inode) (type Mode) (type Offset) (type Time) stat fstat S_ISREG))

	(fn timestamp_equal (:pragma (cfg (os "linux")))
		(params (first FileStatus) (second FileStatus)) (returns bool)
		(body
			(let a (struct:get first st_mtim))
			(let b (struct:get second st_mtim))
			(return (int:eq Time (struct:get a tv_sec) (struct:get b tv_sec)))))

	(fn timestamp_equal (:pragma (cfg (os "macos")))
		(params (first FileStatus) (second FileStatus)) (returns bool)
		(body
			(let a (struct:get first st_mtimespec))
			(let b (struct:get second st_mtimespec))
			(return (int:eq Time (struct:get a tv_sec) (struct:get b tv_sec)))))

	(fn metadata_matches
		(params (first FileStatus) (second FileStatus)) (returns bool)
		(body
			(let mode (struct:get first st_mode))
			(let size (struct:get first st_size))
			(return
				(bool:and
					(int:eq Device (struct:get first st_dev) (struct:get second st_dev))
					(bool:and
						(int:eq Inode (struct:get first st_ino) (struct:get second st_ino))
						(bool:and
							(int:eq Mode mode (struct:get second st_mode))
							(bool:and (call S_ISREG mode)
								(bool:and
									(int:eq Offset size (struct:get second st_size))
									(bool:and (int:eq Offset size (int:convert Offset (i32 112)))
										(call timestamp_equal first second))))))))))

	(fn check_file
		(:expect (tests "stage-2/native_records/cases.tsv") (issues "gh:wove-lang/wove:223"))
		(params (path (shared-array u8))) (returns i32)
		(body
			(let-mut by_path (struct:new FileStatus))
			(let-mut by_fd (struct:new FileStatus))
			(if (bool:not (i32:eq (call stat (borrow-shared path) (borrow-mut by_path)) (i32 0)))
				(then (return (i32 1))))
			(if (bool:not (i32:eq (call fstat (i32 0) (borrow-mut by_fd)) (i32 0)))
				(then (return (i32 2))))
			(if (call metadata_matches by_path by_fd)
				(then (return (i32 42))))
			(return (i32 3))))

	(fn main
		(params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:lt (array:len argv) 2i32) (then (return 4i32)))
			(return (call check_file (borrow-shared (array:load argv 1i32)))))))
