(module wrong_record
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./layout.h" (only (type Other) fill_layout))
	(fn main (params) (returns i32)
		(body
			(let-mut info (record.make Other))
			(return (call fill_layout (borrow-mut (local info)))))))
