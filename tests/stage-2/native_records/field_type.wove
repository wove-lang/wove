(module native_field_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./layout.h" (only (type Layout)))
	(fn main (params) (returns i32)
		(body
			(let info (record.make Layout))
			(return (record.get (local info) value)))))
