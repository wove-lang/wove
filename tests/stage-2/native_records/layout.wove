(module native_layout
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./layout.h" (only (type Layout) (type Wide) fill_layout check_layout max_layout_value))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut info (struct.new Layout))
			(if (bool.not (i32.eq (call fill_layout (borrow-mut (local info))) (i32 0)))
				(then (return (i32 1))))
			(let copy (local info))
			(if (bool.not (int.eq Wide (struct.get (local copy) value) (call max_layout_value)))
				(then (return (i32 2))))
			(if (int.eq Wide (struct.get (local copy) value) (int.convert Wide (u32 4294967295)))
				(then (return (i32 3))))
			(return (call check_layout (borrow-shared (local copy)))))))
