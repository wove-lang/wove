(module native_layout_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./layout.h"
		(type Wide (c-type "uint64_t"))
		(struct Layout (c-type "NativeLayout") (fields (value Wide)))
		(struct Other (c-type "NativeLayout") (fields (value Wide)))
		(struct Broken (c-type "NativeLayout") (fields (value Missing)))
		(fn fill_layout (params (out (mut-ref Layout))) (returns i32))
		(fn check_layout (params (info (shared-ref Layout))) (returns i32))
		(fn copy_layout (params (from (shared-ref Layout)) (to (mut-ref Layout))) (returns i32))
		(fn max_layout_value (params) (returns Wide))))
