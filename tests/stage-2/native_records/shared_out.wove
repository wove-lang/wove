(module shared_out
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./layout.h" (only (type Layout) fill_layout))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut info (struct.new Layout))
			(return (call fill_layout (borrow-shared (local info)))))))
