(module shared_out
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./layout.h" (only (type Layout) fill_layout))
	(fn main (params) (returns i32)
		(body
			(let-mut info (record.make Layout))
			(return (call fill_layout (borrow-shared (local info)))))))
