(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	comparison_width
	(fn main (params) (returns i32)
		(body
			(if (u32.eq
					(u32 255)
					(call byte))
				(then (return (i32 0)))
				(else (return (i32 1))))))
	(fn byte (params) (returns u8)
		(body (return (u8 255)))))
