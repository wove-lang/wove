(module unsigned_comparisons
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(if (call predicate
					(u8.lt (call left_byte (u8 127)) (call right_byte (u8 128))))
				(then
					(if (u32.lt (u32 2147483648) (u32 4294967295))
						(then (return (i32 42)))
						(else (return (i32 1)))))
				(else (return (i32 2))))))
	(fn predicate (params (value bool)) (returns bool)
		(body (return (local value))))
	(fn left_byte (params (value u8)) (returns u8)
		(body (return (local value))))
	(fn right_byte (params (value u8)) (returns u8)
		(body (return (local value))))
	(fn byte_lt (params (left u8) (right u8)) (returns bool)
		(body (return (u8.lt (local left) (local right)))))
	(fn byte_eq (params (left u8) (right u8)) (returns bool)
		(body (return (u8.eq (local left) (local right)))))
	(fn word_lt (params (left u32) (right u32)) (returns bool)
		(body (return (u32.lt (local left) (local right)))))
	(fn word_eq (params (left u32) (right u32)) (returns bool)
		(body (return (u32.eq (local left) (local right))))))
