	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(if (bool.not (bool false) (bool true))
				(then (return (i32 1)))
				(else (return (i32 0)))))))
