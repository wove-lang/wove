(module short_circuit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(if (bool.and (call left_value (bool false))
					(call right_value (bool false) (bool true)))
				(then (return (i32 1))))
			(if (bool.not
					(bool.or (call left_value (bool true))
						(call right_value (bool false) (bool false))))
				(then (return (i32 2))))
			(if (bool.and (call left_value (bool true))
					(call right_value (bool true) (bool false)))
				(then (return (i32 3))))
			(if (bool.not
					(call pass
						(bool.or (call left_value (bool false))
							(call right_value (bool true) (bool true)))))
				(then (return (i32 4))))
			(if (call nested (bool false))
				(then (return (i32 42)))
				(else (return (i32 5))))))
	(fn left_value (params (value bool)) (returns bool)
		(body (return (local value))))
	(fn pass (params (value bool)) (returns bool)
		(body (return (local value))))
	(fn right_value (params (allowed bool) (value bool)) (returns bool)
		(body
			(if (bool.not (local allowed))
				(then (while (bool true) (body))))
			(return (local value))))
	(fn nested (params (bit bool)) (returns bool)
		(body
			(return
				(bool.and (bool.or (local bit) (bool true))
					(bool.not (bool.and (local bit) (bool true))))))))
