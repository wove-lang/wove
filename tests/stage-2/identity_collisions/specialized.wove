(module colliding_specializations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Box (generic (const Tag i32)) (fields (payload i32)))
	(fn value (generic (const N i32)) (params) (returns i32)
		(body
			(if (i32:eq N 1948944294i32) (then (return 19i32)))
			(return 23i32)))
	(fn unbox (params (box (specialize Box 1269605002i32))) (returns i32)
		(body (return (struct:get box payload))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let second (call (specialize value 2063492510i32)))
			(let first (call (specialize value 1948944294i32)))
			(if (i32:not-eq (call (specialize value 2063492510i32)) second)
				(then (return 1i32)))
			(let left (struct:new (specialize Box 1269605002i32) (payload first)))
			(let right (struct:new (specialize Box 1076933014i32) (payload second)))
			(return (i32:add (call unbox left) (struct:get right payload))))))
