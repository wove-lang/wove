(module colliding_specializations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Box (generic (const Tag i32)) (fields (payload i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn value (generic (const N i32)) (params) (returns i32)
		(body
			(if (i32.eq (local N) 1579973165i32) (then (return 19i32)))
			(return 23i32)))
	(fn unbox (params (box (specialize Box 1357922139i32))) (returns i32)
		(body (return (struct.get (local box) payload))))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let second (call (specialize value 2082312659i32)))
			(let first (call (specialize value 1579973165i32)))
			(if (i32.not-eq (call (specialize value 2082312659i32)) (local second))
				(then (return 1i32)))
			(let left (struct.new (specialize Box 1357922139i32) (payload (local first))))
			(let right (struct.new (specialize Box 1121496419i32) (payload (local second))))
			(return (i32.add (call unbox (local left)) (struct.get (local right) payload))))))
