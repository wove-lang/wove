(module collision_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./collision-13/decl_037hvvm0ij9hfk.wove" (only (as parse east) (type (as Row East)) (type (as Item EastItem))))
	(use wove-file "./collision-13/decl_1td9xi41u3v3i2.wove" (only (as parse west) (type (as Row West)) (type (as Item WestItem))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let first (struct.new West (one (call west))))
			(let second (struct.new East (two (u8.from-i32 (call east)))))
			(let one (struct.new (specialize WestItem i32) (inner (struct.get (local first) one))))
			(let two (struct.new (specialize EastItem i32) (payload (i32.from-u8 (struct.get (local second) two))) (reserved 0u8)))
			(return (i32.add (struct.get (local one) inner)
				(struct.get (local two) payload))))))
