(module collision_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./collision-13/decl_451f530efeb641.wove" (only (as parse left) (type (as Row Left)) (type (as Item LeftItem))))
	(use wove-file "./collision-13/decl_208c4735bc46f8.wove" (only (as parse right) (type (as Row Right)) (type (as Item RightItem))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let first (struct:new Left (one (call left))))
			(let second (struct:new Right (two (u8:from-i32 (call right)))))
			(let one (struct:new (specialize LeftItem i32) (inner (struct:get first one))))
			(let two (struct:new (specialize RightItem i32) (payload (i32:from-u8 (struct:get second two))) (reserved 0u8)))
			(return (i32:add (struct:get one inner)
				(struct:get two payload))))))
