	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./identity.h"
		(fn same_file
			(:pragma (c_cstr canonical original))
			(params (canonical (shared-array u8)) (original (shared-array u8)))
			(returns i32)))
)
