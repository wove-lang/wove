(module non_null
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only realpath))
	(let path "tests/stage-2/native_records/data.txt")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut output (array.alloc u8 (i32 16)))
			(let resolved (call realpath (borrow-shared (local path)) (borrow-mut (local output))))
			(return (i32 1))))
)
