(module reused
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./tracked.h" (only acquire_path))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call acquire_path (i32 2)))
			(let path (move (optional.unwrap (local result))))
			(if (owner.is-null (local result)) (then (return (i32 1))))
			(return (i32 42))))
)
