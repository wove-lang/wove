(module repeated_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./borrowed_strings.h" (only empty_text))
	(bridge c-header "./borrowed_strings.h"
		(fn empty_text
			(:pragma (c_snapshot cstr) (c_snapshot cstr (drop free)))
			(params) (returns (optional (owned-array u8)))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return 0i32)))
)
