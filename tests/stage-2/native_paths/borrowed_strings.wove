(module borrowed_strings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<errno.h>" (only errno ERANGE ENOENT))
	(use c-header "./borrowed_strings.h" (only edit_strings empty_text))

	(bridge c-header "./borrowed_strings.h"
		(fn edit_strings
			(returns (optional (owned-array u8)))
			(params (tag (shared-array u8)) (first (mut-array u8)) (missing i32) (second (mut-array u8)))
			(:pragma (c_cstr tag first second) (c_snapshot cstr)))
		(fn empty_text
			(:pragma (c_snapshot cstr))
			(params) (returns (optional (owned-array u8)))))

	(let tag "p")

	(fn initialize (params (first (mut-array u8)) (second (mut-array u8))) (returns void)
		(body
			(array.store (local first) 0i32 97u8)
			(array.store (local first) 1i32 98u8)
			(array.store (local first) 2i32 99u8)
			(array.store (local first) 3i32 100u8)
			(array.store (local second) 0i32 120u8)
			(array.store (local second) 1i32 121u8)))

	(fn copied (params (first (shared-array u8)) (second (shared-array u8))) (returns bool)
		(body
			(if (bool.not (u8.eq (array.load (local first) 0i32) 77u8)) (then (return (bool false))))
			(if (bool.not (u8.eq (array.load (local first) 1i32) 66u8)) (then (return (bool false))))
			(if (bool.not (u8.eq (array.load (local first) 2i32) 0u8)) (then (return (bool false))))
			(if (bool.not (u8.eq (array.load (local first) 3i32) 84u8)) (then (return (bool false))))
			(if (bool.not (u8.eq (array.load (local second) 0i32) 78u8)) (then (return (bool false))))
			(return (u8.eq (array.load (local second) 1i32) 89u8))))

	(fn check_text (params (bytes (shared-array u8))) (returns bool)
		(body (return (bool.and (i32.eq (array.len (local bytes)) 1i32)
			(u8.eq (array.load (local bytes) 0i32) 66u8)))))

	(fn empty (params (bytes (shared-array u8))) (returns bool)
		(body (return (i32.eq (array.len (local bytes)) 0i32))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut first (array.alloc u8 4i32))
			(let-mut second (array.alloc u8 2i32))
			(call initialize (borrow-mut (local first)) (borrow-mut (local second)))
			(let result (call edit_strings (borrow-shared (local tag)) (borrow-mut (local first)) 0i32 (borrow-mut (local second))))
			(if (bool.not (i32.eq (local errno) (local ERANGE))) (then (return 1i32)))
			(if (owner.is-null (local result)) (then (return 2i32)))
			(if (bool.not (call copied (borrow-shared (local first)) (borrow-shared (local second)))) (then (return 3i32)))
			(let text (move (optional.unwrap (local result))))
			(call initialize (borrow-mut (local first)) (borrow-mut (local second)))
			(let absent (call edit_strings (borrow-shared (local tag)) (borrow-mut (local first)) 1i32 (borrow-mut (local second))))
			(if (bool.not (i32.eq (local errno) (local ENOENT))) (then (return 4i32)))
			(if (bool.not (owner.is-null (local absent))) (then (return 5i32)))
			(if (bool.not (call copied (borrow-shared (local first)) (borrow-shared (local second)))) (then (return 6i32)))
			(if (bool.not (call check_text (borrow-shared (local text)))) (then (return 7i32)))
			(let raw_empty (call empty_text))
			(if (owner.is-null (local raw_empty)) (then (return 8i32)))
			(let empty_text_copy (move (optional.unwrap (local raw_empty))))
			(if (bool.not (call empty (borrow-shared (local empty_text_copy)))) (then (return 9i32)))
			(return 42i32)))
)
