(module tracked_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./tracked.h"
		(fn acquire_path (:pragma (c_snapshot cstr (drop release_path)))
			(params (mode i32)) (returns (optional (owned-array u8))))
		(fn releases (params) (returns i32)))
)
