(module tracked
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./tracked.h" (only acquire_path releases))
	(fn length (params (data (shared-array u8))) (returns i32)
		(body (return (array.len (local data)))))
	(fn first (params (data (shared-array u8))) (returns u8)
		(body (return (array.load (local data) (i32 0)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let missing (call acquire_path (i32 0)))
			(if (bool.not (owner.is-null (local missing))) (then (return (i32 1))))
			(if (bool.not (i32.eq (call releases) (i32 0))) (then (return (i32 2))))
			(let empty_result (call acquire_path (i32 1)))
			(if (owner.is-null (local empty_result)) (then (return (i32 3))))
			(let empty (move (optional.unwrap (local empty_result))))
			(if (bool.not (i32.eq (call length (borrow-shared (local empty))) (i32 0))) (then (return (i32 4))))
			(let payload (call acquire_path (i32 2)))
			(let path (move (optional.unwrap (local payload))))
			(if (bool.not (i32.eq (call releases) (i32 2))) (then (return (i32 5))))
			(if (bool.not (i32.eq (call length (borrow-shared (local path))) (i32 2))) (then (return (i32 6))))
			(if (bool.not (u8.eq (call first (borrow-shared (local path))) (u8 195))) (then (return (i32 7))))
			(return (i32 42))))
)
