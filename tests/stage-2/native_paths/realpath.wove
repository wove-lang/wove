(module realpath
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only (as realpath real_path)))
	(use c-header "./identity.h" (only same_file))
	(let existing "tests/stage-2/native_records/data.txt")
	(let missing "tests/stage-2/native_records/data.txt/absent")

	(fn canonical
		(:expect (tests "stage-2/native_paths/cases.tsv") (issues "gh:wove-lang/wove:226"))
		(params (path (shared-array u8))) (returns (owned-array u8))
		(body
			(let result (call real_path (borrow-shared path) null))
			(if (owner:is-null result)
				(then
					(let empty (array:alloc u8 (i32 0)))
					(return (move empty))))
			(return (move (optional:unwrap result)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call real_path (borrow-shared missing) null))
			(if (bool:not (owner:is-null absent)) (then (return (i32 1))))
			(let path (call canonical (borrow-shared existing)))
			(return (call same_file (borrow-shared path) (borrow-shared existing)))))
)
