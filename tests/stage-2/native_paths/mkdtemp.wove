(module mkdtemp_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only mkdtemp rmdir))
	(use (:pragma (cfg (os "linux"))) c-header "<stdlib.h>" (only mkdtemp))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only rmdir))
	(let pattern "./wove-native-XXXXXX")
	(let invalid "tests/stage-2/native_records/data.txt/wove-invalid")

	(fn fill (params (from (shared-array u8)) (to (mut-array u8))) (returns void)
		(body
			(let-mut cursor 0i32)
			(while (i32.lt (local cursor) (array.len (local from)))
				(body
					(array.store (local to) (local cursor) (array.load (local from) (local cursor)))
					(set (local cursor) (i32.add (local cursor) 1i32))))))

	(fn equal (params (a (shared-array u8)) (b (shared-array u8))) (returns bool)
		(body
			(if (bool.not (i32.eq (array.len (local a)) (array.len (local b)))) (then (return (bool false))))
			(let-mut cursor 0i32)
			(while (i32.lt (local cursor) (array.len (local a)))
				(body
					(if (bool.not (u8.eq (array.load (local a) (local cursor)) (array.load (local b) (local cursor))))
						(then (return (bool false))))
					(set (local cursor) (i32.add (local cursor) 1i32))))
			(return (bool true))))

	(fn change_first (params (bytes (mut-array u8))) (returns void)
		(body (array.store (local bytes) 0i32 90u8)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/native_paths/cases.tsv") (issues "gh:wove-lang/wove:291"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut bad (array.alloc u8 (array.len (local invalid))))
			(call fill (borrow-shared (local invalid)) (borrow-mut (local bad)))
			(let absent (call mkdtemp (borrow-mut (local bad))))
			(if (bool.not (owner.is-null (local absent))) (then (return 1i32)))
			(if (bool.not (call equal (borrow-shared (local invalid)) (borrow-shared (local bad)))) (then (return 2i32)))
			(let-mut template (array.alloc u8 (array.len (local pattern))))
			(call fill (borrow-shared (local pattern)) (borrow-mut (local template)))
			(let result (call mkdtemp (borrow-mut (local template))))
			(if (owner.is-null (local result)) (then (return 3i32)))
			(let path (move (optional.unwrap (local result))))
			(if (bool.not (call equal (borrow-shared (local path)) (borrow-shared (local template))))
				(then (return (i32.add 100i32 (call rmdir (borrow-shared (local path)))))))
			(call change_first (borrow-mut (local template)))
			(if (call equal (borrow-shared (local path)) (borrow-shared (local template))) (then (return 5i32)))
			(if (bool.not (i32.eq (call rmdir (borrow-shared (local path))) 0i32)) (then (return 6i32)))
			(return 42i32)))
)
