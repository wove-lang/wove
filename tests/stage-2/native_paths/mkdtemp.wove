(module mkdtemp_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only mkdtemp rmdir))
	(use (:pragma (cfg (os "linux"))) c-header "<stdlib.h>" (only mkdtemp))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only rmdir))
	(let pattern "./wove-native-XXXXXX")
	(let invalid "tests/stage-2/native_records/data.txt/wove-invalid")

	(fn fill (params (from (shared-array u8)) (to (mut-array u8))) (returns void)
		(body
			(let-mut cursor 0i32)
			(while (i32:lt cursor (array:len from))
				(body
					(array:set to cursor (array:get from cursor))
					(set cursor (i32:add cursor 1i32))))))

	(fn equal (params (a (shared-array u8)) (b (shared-array u8))) (returns bool)
		(body
			(if (bool:not (i32:eq (array:len a) (array:len b))) (then (return (bool false))))
			(let-mut cursor 0i32)
			(while (i32:lt cursor (array:len a))
				(body
					(if (bool:not (u8:eq (array:get a cursor) (array:get b cursor)))
						(then (return (bool false))))
					(set cursor (i32:add cursor 1i32))))
			(return (bool true))))

	(fn change_first (params (bytes (mut-array u8))) (returns void)
		(body (array:set bytes 0i32 90u8)))

	(fn main
		(:expect (tests "stage-2/native_paths/cases.tsv") (issues "gh:wove-lang/wove:291"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bad (array:alloc u8 (array:len invalid)))
			(call fill (borrow-shared invalid) (borrow-mut bad))
			(let absent (call mkdtemp (borrow-mut bad)))
			(if (bool:not (owner:is-null absent)) (then (return 1i32)))
			(if (bool:not (call equal (borrow-shared invalid) (borrow-shared bad))) (then (return 2i32)))
			(let-mut template (array:alloc u8 (array:len pattern)))
			(call fill (borrow-shared pattern) (borrow-mut template))
			(let result (call mkdtemp (borrow-mut template)))
			(if (owner:is-null result) (then (return 3i32)))
			(let path (move (optional:unwrap result)))
			(if (bool:not (call equal (borrow-shared path) (borrow-shared template)))
				(then (return (i32:add 100i32 (call rmdir (borrow-shared path))))))
			(call change_first (borrow-mut template))
			(if (call equal (borrow-shared path) (borrow-shared template)) (then (return 5i32)))
			(if (bool:not (i32:eq (call rmdir (borrow-shared path)) 0i32)) (then (return 6i32)))
			(return 42i32)))
)
