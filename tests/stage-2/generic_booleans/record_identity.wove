(module bool_generic_record_identity
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(struct Flag (generic (const Enabled bool)) (fields (value i32)))
	(fn expect_true (params (flag (specialize Flag (bool true)))) (returns i32)
		(body (return (struct.get (local flag) value))))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let flag (struct.new (specialize Flag (bool false)) (value 42i32)))
			(return (call expect_true (local flag))))))
