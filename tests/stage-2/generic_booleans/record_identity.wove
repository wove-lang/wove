(module bool_generic_record_identity
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Flag (generic (const Enabled bool)) (fields (value i32)))
	(fn expect_true (params (flag (specialize Flag (bool true)))) (returns i32)
		(body (return (struct.get flag value))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let flag (struct.new (specialize Flag (bool false)) (value 42i32)))
			(return (call expect_true flag)))))
