(module generic_constant_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<errno.h>" (only (value (as errno Enabled))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn write (generic (const Enabled bool)) (params) (returns i32)
		(body
			(set (local Enabled) 19i32)
			(return 42i32)))

	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call (specialize write (bool true)))))))
