(module bool_generic_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Flag (generic (type T) (const Enabled bool)) (fields (value T)))
	(fn enabled (generic (const Enabled bool)) (params) (returns bool)
		(body (return Enabled)))
	(fn value (generic (type T) (const Enabled bool)) (params (value T)) (returns (specialize Flag T Enabled))
		(body (return (struct:new (specialize Flag T Enabled) (value value)))))
	(fn forward (generic (const Enabled bool)) (params) (returns bool)
		(body (return (call (specialize enabled Enabled)))))
	(fn check_true (params (flag (specialize Flag i32 (bool true)))) (returns i32)
		(body (return (struct:get flag value))))
	(fn check_false (params (flag (specialize Flag i32 (bool false)))) (returns i32)
		(body (return (struct:get flag value))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool:not (call (specialize enabled (bool true)))) (then (return 1i32)))
			(if (call (specialize forward (bool false))) (then (return 2i32)))
			(if (bool:not (call (specialize forward (bool true)))) (then (return 3i32)))
			(let yes (call (specialize value i32 (bool true)) 19i32))
			(let no (call (specialize value i32 (bool false)) 23i32))
			(return (i32:add (call check_true yes) (call check_false no))))))
