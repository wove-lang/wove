(module bool_generic_function_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn enabled (generic (const Enabled bool)) (params) (returns bool)
		(body (return (local Enabled))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (call (specialize enabled 1i32)) (then (return 1i32)))
			(return 0i32))))
