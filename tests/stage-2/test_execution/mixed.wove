(module mixed_test_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (test)) wove-file "./test helpers.wove" (only (as answer imported_answer)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (i32 97))))

	(fn first
		(:pragma (test))
		(params)
		(returns void)
		(body
			(if (bool.not (i32.eq (call imported_answer) (i32 42)))
				(then (let unexpected (array.alloc u8 (i32 -1)))))
			(return)))

	(fn traps
		(:pragma (test))
		(params)
		(returns void)
		(body (let overflow (int.convert u8 (i32 256))))))
