(module execution_helpers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(decls
		(:pragma (cfg test))
		(fn answer
			(params)
			(returns i32)
			(body (return (i32 42))))

		(fn later
			(:pragma (test))
			(params)
			(returns void)
			(body
				(if (bool:not (i32:eq (call answer) (i32 42)))
					(then (let unexpected (array:alloc u8 (i32 -1)))))))))
