(module passing_test_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg test)) wove-file "./test helpers.wove" (only answer))

	(fn later
		(:pragma (test))
		(params)
		(returns void)
		(body
			(if (bool.not (i32.eq (call answer) (i32 42)))
				(then (let unexpected (array.alloc u8 (i32 -1))))))))
