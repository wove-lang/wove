(module passing_test_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg test)) wove-file "./test helpers.wove" (only answer))
	(use (:pragma (cfg test)) wove-file "/stage-2/io/stdio.wove" (only write_stdout))

	(let child_output "child stdout\n")

	(fn later
		(:pragma (test))
		(params)
		(returns void)
		(body
			(let written (call write_stdout (borrow-shared (local child_output))))
			(if (bool.not (i32.eq (call answer) (i32 42)))
				(then (let unexpected (array.alloc u8 (i32 -1))))))))
