(module integer_decode_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn finish
		(params (storage (mut-array u8)) (value i32))
		(returns i32)
		(body (return (local value))))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut storage (array.alloc u8 4i32))
			(return (call finish (borrow-mut (local storage))
				(i32.from.be-bytes (borrow-shared (local storage))))))))
