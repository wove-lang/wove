(module integer_decode_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn finish
		(params (storage (mut-array u8)) (value i32))
		(returns i32)
		(body (return value)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut storage (array:alloc u8 4i32))
			(return (call finish (borrow-mut storage)
				(i32:from-be-bytes (borrow-shared storage)))))))
