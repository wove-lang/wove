(module stl_attribute
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn attribute
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (facet (shared-array u8 50))) (returns u16)
		(body (return (u16.from.le-bytes (borrow-shared (array.range (local facet) 48i32 50i32))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut facet (array.repeat (array u8 50) 0u8))
			(if (bool.not (u16.eq (call attribute (borrow-shared (local facet))) (u16 0))) (then (return 1i32)))
			(array.store (local facet) 48i32 0x5au8)
			(array.store (local facet) 49i32 0xa5u8)
			(if (u16.eq (call attribute (borrow-shared (local facet))) 0u16) (then (return 2i32)))
			(if (bool.not (u16.eq (call attribute (borrow-shared (local facet))) 0xa55au16)) (then (return 3i32)))
			(return 42i32))))
