(module stl_attribute
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn attribute
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (facet (shared-array u8 50))) (returns u16)
		(body (return (u16:from-le-bytes (borrow-shared (array:range facet 48i32 50i32))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut facet (array:repeat (array u8 50) 0u8))
			(if (bool:not (u16:eq (call attribute (borrow-shared facet)) (u16 0))) (then (return 1i32)))
			(array:set facet 48i32 0x5au8)
			(array:set facet 49i32 0xa5u8)
			(if (u16:eq (call attribute (borrow-shared facet)) 0u16) (then (return 2i32)))
			(if (bool:not (u16:eq (call attribute (borrow-shared facet)) 0xa55au16)) (then (return 3i32)))
			(return 42i32))))
