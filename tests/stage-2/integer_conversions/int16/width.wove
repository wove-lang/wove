(module integer16_bad_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let width (i32.dec (array.len args)))
			(let source (array.new (array u8 3) 0u8 42u8 0u8))
			(let data (borrow-shared source))
			(return (i32.from-i16 (i16.from-be-bytes (borrow-shared (array.range data 0i32 width))))))))
