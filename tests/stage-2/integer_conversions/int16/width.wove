(module integer16_bad_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let width (array.len (local args)))
			(let source (array.new (array u8 3) 0u8 42u8 0u8))
			(let data (borrow-shared (local source)))
			(return (i32.from.i16 (i16.from.be-bytes (borrow-shared (array.range (local data) 0i32 (local width)))))))))
