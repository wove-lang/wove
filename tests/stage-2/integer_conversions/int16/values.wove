(module integer16_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./halfwords.wove" (only))
	(use c-header "./halfwords.h" (only keep_u16 keep_i16))
	(use wove-file "../../../../stage-2/text/decimal_write.wove" (only write_decimal_i32 write_decimal_u32))
	(use wove-file "../../../../stage-2/text/equal.wove" (only equal_bytes))
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Limits (fields (low i16) (high u16)))
	(let expected "-32768,65535")

	(fn signed_limits (params (lower i16) (upper i16)) (returns bool)
		(body (return (bool.and (i16.lt (local lower) (local upper))
			(i16.eq (i16.add (local upper) 1i16) (local lower))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let limits (struct.new Limits (low (call keep_i16 -0x8000i16)) (high (call keep_u16 (u16 65535)))))
			(let minimum (struct.get (local limits) low))
			(let maximum (struct.get (local limits) high))
			(if (bool.not (call signed_limits (local minimum) 32767i16)) (then (return 1i32)))
			(if (bool.not (i16.eq (i16.sub (local minimum) 1i16) 0x7fffi16)) (then (return 2i32)))
			(if (bool.not (u16.lt 32767u16 (local maximum))) (then (return 3i32)))
			(if (bool.not (u16.eq (u16.add (local maximum) 1u16) 0u16)) (then (return 4i32)))
			(if (bool.not (u16.eq (u16.sub 0u16 1u16) (local maximum))) (then (return 5i32)))
			(let le (i16.to-le-bytes (local minimum)))
			(let be (i16.to-be-bytes -257i16))
			(if (bool.not (u8.eq (array.load (local le) 1i32) 0x80u8)) (then (return 6i32)))
			(if (bool.not (i16.eq (i16.from-le-bytes (borrow-shared (local le))) (local minimum))) (then (return 7i32)))
			(if (bool.not (u8.eq (array.load (local be) 0i32) 0xfeu8)) (then (return 8i32)))
			(if (bool.not (i16.eq (i16.from-be-bytes (borrow-shared (local be))) -257i16)) (then (return 9i32)))
			(let ule (u16.to-le-bytes 0x1234u16))
			(let ube (u16.to-be-bytes 0x9abcu16))
			(if (bool.not (u8.eq (array.load (local ule) 0i32) 0x34u8)) (then (return 10i32)))
			(if (bool.not (u16.eq (u16.from-le-bytes (borrow-shared (local ule))) 0x1234u16)) (then (return 11i32)))
			(if (bool.not (u8.eq (array.load (local ube) 0i32) 0x9au8)) (then (return 12i32)))
			(if (bool.not (u16.eq (u16.from-be-bytes (borrow-shared (local ube))) 0x9abcu16)) (then (return 13i32)))
			(if (bool.not (i16.eq (i16.from-f64 -32768.75f64) (local minimum))) (then (return 14i32)))
			(if (bool.not (u16.eq (u16.from-f64 65535.75f64) (local maximum))) (then (return 15i32)))
			(let-mut text (array.alloc u8 12i32))
			(let comma (call write_decimal_i32 (borrow-mut (local text)) 0i32 (i32.from-i16 (local minimum))))
			(array.store (local text) (local comma) 44u8)
			(let end (call write_decimal_u32 (borrow-mut (local text)) (i32.add (local comma) 1i32) (u32.from-u16 (local maximum))))
			(if (bool.not (i32.eq (local end) 12i32)) (then (return 16i32)))
			(if (bool.not (call equal_bytes (borrow-shared (local text)) (borrow-shared (local expected)))) (then (return 17i32)))
			(return 42i32))))
