(module integer16_checked
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn to_unsigned (params (value i32)) (returns u16) (body (return (u16.from.i32 (local value)))))
	(fn to_signed (params (value i32)) (returns i16) (body (return (int.convert i16 (local value)))))
	(fn from_unsigned (params (value u16)) (returns i16) (body (return (i16.from.u16 (local value)))))
	(fn from_float (params (value f64)) (returns u16) (body (return (u16.from.f64 (local value)))))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let n (array.len (local args)))
			(if (i32.eq (local n) 1i32) (then (return (i32.from.u16 (call to_unsigned 65536i32)))))
			(if (i32.eq (local n) 2i32) (then (return (i32.from.u16 (call to_unsigned -1i32)))))
			(if (i32.eq (local n) 3i32) (then (return (i32.from.i16 (call to_signed 32768i32)))))
			(if (i32.eq (local n) 4i32) (then (return (i32.from.i16 (call to_signed -32769i32)))))
			(if (i32.eq (local n) 5i32) (then (return (i32.from.i16 (call from_unsigned 65535u16)))))
			(if (i32.eq (local n) 6i32) (then (return (i32.from.u16 (call from_float 65536.0f64)))))
			(if (bool.not (u16.eq (call to_unsigned 65535i32) 65535u16)) (then (return 1i32)))
			(if (bool.not (i16.eq (call to_signed -32768i32) -32768i16)) (then (return 2i32)))
			(if (bool.not (i16.eq (call from_unsigned 32767u16) 32767i16)) (then (return 3i32)))
			(return (i32.from.i16 (i16.from.u32 42u32))))))
