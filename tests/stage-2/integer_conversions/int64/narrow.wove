(module signed_word_narrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn signed
		(params (word u64)) (returns i64)
		(body (return (i64.from-u64 word))))

	(fn unsigned
		(params (word i64)) (returns u64)
		(body (return (u64.from-i64 word))))

	(fn from_float
		(params (value f64)) (returns i64)
		(body (return (i64.from-f64 value))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (i32.dec (array.len args)))
			(if (i32.eq count 1i32) (then (return (i32.from-i64 (call signed 9223372036854775808u64)))))
			(if (i32.eq count 2i32) (then (return (i32.from-u64 (call unsigned -9223372036854775808i64)))))
			(if (i32.eq count 3i32) (then (return (i32.from-i64 2147483648i64))))
			(if (i32.eq count 4i32) (then (return (i32.from-i64 (call from_float (f64 -9223372036854777856.0))))))
			(if (i32.eq count 5i32) (then (return (i32.from-i64 (call from_float (f64 9223372036854775808.0))))))
			(if (i32.eq count 6i32)
				(then
					(let short (array.repeat (array u8 7) 0u8))
					(return (i32.from-i64 (i64.from-be-bytes (borrow-shared short))))))
			(return 42i32))))
