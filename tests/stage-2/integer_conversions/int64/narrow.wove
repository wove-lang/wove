(module signed_word_narrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn signed
		(params (word u64)) (returns i64)
		(body (return (i64.from-u64 (local word)))))

	(fn unsigned
		(params (word i64)) (returns u64)
		(body (return (u64.from-i64 (local word)))))

	(fn from_float
		(params (value f64)) (returns i64)
		(body (return (i64.from-f64 (local value)))))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let count (array.len (local args)))
			(if (i32.eq (local count) 1i32) (then (return (i32.from-i64 (call signed 9223372036854775808u64)))))
			(if (i32.eq (local count) 2i32) (then (return (i32.from-u64 (call unsigned -9223372036854775808i64)))))
			(if (i32.eq (local count) 3i32) (then (return (i32.from-i64 2147483648i64))))
			(if (i32.eq (local count) 4i32) (then (return (i32.from-i64 (call from_float (f64 -9223372036854777856.0))))))
			(if (i32.eq (local count) 5i32) (then (return (i32.from-i64 (call from_float (f64 9223372036854775808.0))))))
			(if (i32.eq (local count) 6i32)
				(then
					(let short (array.repeat (array u8 7) 0u8))
					(return (i32.from-i64 (i64.from-be-bytes (borrow-shared (local short)))))))
			(return 42i32))))
