(module signed_word_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./words.wove" (only))
	(use c-header "./words.h" (only keep_i64))

	(struct Record (fields (value i64)))
	(let min_word (i64 -0x8000000000000000))
	(let max_word 9223372036854775807i64)

	(fn round
		(params (value i64))
		(returns Record)
		(body (return (struct.new Record (value (call keep_i64 (local value)))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let minimum (struct.get (call round (local min_word)) value))
			(let maximum (struct.get (call round (local max_word)) value))
			(if (bool.not (i64.eq (local minimum) -9223372036854775808i64)) (then (return 1i32)))
			(if (bool.not (i64.eq (local maximum) (i64 0X7FFFFFFFFFFFFFFF))) (then (return 2i32)))
			(if (bool.not (i64.lt (local minimum) (local maximum))) (then (return 3i32)))
			(if (bool.not (int.eq i64 (i64.add (local maximum) 1i64) (local minimum))) (then (return 4i32)))
			(if (bool.not (i64.eq (i64.sub (local minimum) 1i64) (local maximum))) (then (return 5i32)))
			(if (bool.not (i64.eq (i64.mul (local minimum) -1i64) (local minimum))) (then (return 6i32)))
			(if (bool.not (u64.eq (u64.from-i64 (local maximum)) 9223372036854775807u64)) (then (return 7i32)))
			(if (bool.not (i64.eq (i64.from-u64 9223372036854775807u64) (local maximum))) (then (return 8i32)))
			(if (bool.not (i64.eq (int.convert i64 -2147483648i32) -2147483648i64)) (then (return 9i32)))
			(if (bool.or (i64.fits 9223372036854775808u64) (bool.not (i64.fits (local minimum)))) (then (return 10i32)))
			(if (bool.not (i64.eq (i64.from-f64 (f64 -9223372036854775808.0)) (local minimum))) (then (return 11i32)))
			(if (bool.not (f64.eq (f64.from-i64 (local minimum)) (f64 -9223372036854775808.0))) (then (return 12i32)))
			(return (i32.from-i64 42i64)))))
