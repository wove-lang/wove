(module word_decimal_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../stage-2/text/decimal_wide.wove" (only write_decimal_i64 write_decimal_u64))
	(use wove-file "../../../../stage-2/text/bytes.wove" (only same_bytes))

	(struct ArgSpan (fields (start i32) (end i32)))
	(let signed_digits "-922337203685477580892233720368547758070")
	(let unsigned_digits "18446744073709551615")
	(let short_prefix "-92")

	(fn main
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut scratch (array.repeat (array u8 48) 120u8))
			(let min_end (call write_decimal_i64 (borrow-mut (local scratch)) 2i32 -9223372036854775808i64))
			(if (bool.not (i32.eq (local min_end) 22i32)) (then (return 1i32)))
			(let max_end (call write_decimal_i64 (borrow-mut (local scratch)) (local min_end) 9223372036854775807i64))
			(if (bool.not (i32.eq (local max_end) 41i32)) (then (return 2i32)))
			(let zero_end (call write_decimal_i64 (borrow-mut (local scratch)) (local max_end) 0i64))
			(if (bool.not (i32.eq (local zero_end) 42i32)) (then (return 3i32)))
			(if (bool.not (call same_bytes (borrow-shared (local scratch)) 2i32 (local zero_end)
				(borrow-shared (local signed_digits)) 0i32 (array.len (local signed_digits)))) (then (return 4i32)))
			(if (bool.not (bool.and (u8.eq (array.load (local scratch) 1i32) 120u8)
				(u8.eq (array.load (local scratch) (local zero_end)) 120u8))) (then (return 5i32)))
			(let unsigned_end (call write_decimal_u64 (borrow-mut (local scratch)) 0i32 18446744073709551615u64))
			(if (bool.not (call same_bytes (borrow-shared (local scratch)) 0i32 (local unsigned_end)
				(borrow-shared (local unsigned_digits)) 0i32 (array.len (local unsigned_digits)))) (then (return 6i32)))
			(let-mut short_output (array.repeat (array u8 3) 120u8))
			(let short (call write_decimal_i64 (borrow-mut (local short_output)) 0i32 -9223372036854775808i64))
			(if (bool.not (i32.eq (local short) -1i32)) (then (return 7i32)))
			(if (bool.not (call same_bytes (borrow-shared (local short_output)) 0i32 3i32
				(borrow-shared (local short_prefix)) 0i32 (array.len (local short_prefix)))) (then (return 8i32)))
			(return 42i32))))
