(module word_decimal_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../../stage-2/text/decimal_wide.wove" (only write_decimal_i64 write_decimal_u64))
	(use wove-file "../../../../stage-2/text/bytes.wove" (only same_bytes))

	(let signed_digits "-922337203685477580892233720368547758070")
	(let unsigned_digits "18446744073709551615")
	(let short_prefix "-92")

	(fn main
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut scratch (array.repeat (array u8 48) 120u8))
			(let min_end (call write_decimal_i64 (borrow-mut scratch) 2i32 -9223372036854775808i64))
			(if (bool.not (i32.eq min_end 22i32)) (then (return 1i32)))
			(let max_end (call write_decimal_i64 (borrow-mut scratch) min_end 9223372036854775807i64))
			(if (bool.not (i32.eq max_end 41i32)) (then (return 2i32)))
			(let zero_end (call write_decimal_i64 (borrow-mut scratch) max_end 0i64))
			(if (bool.not (i32.eq zero_end 42i32)) (then (return 3i32)))
			(if (bool.not (call same_bytes (borrow-shared scratch) 2i32 zero_end
				(borrow-shared signed_digits) 0i32 (array.len signed_digits))) (then (return 4i32)))
			(if (bool.not (bool.and (u8.eq (array.load scratch 1i32) 120u8)
				(u8.eq (array.load scratch zero_end) 120u8))) (then (return 5i32)))
			(let unsigned_end (call write_decimal_u64 (borrow-mut scratch) 0i32 18446744073709551615u64))
			(if (bool.not (call same_bytes (borrow-shared scratch) 0i32 unsigned_end
				(borrow-shared unsigned_digits) 0i32 (array.len unsigned_digits))) (then (return 6i32)))
			(let-mut short_output (array.repeat (array u8 3) 120u8))
			(let short (call write_decimal_i64 (borrow-mut short_output) 0i32 -9223372036854775808i64))
			(if (bool.not (i32.eq short -1i32)) (then (return 7i32)))
			(if (bool.not (call same_bytes (borrow-shared short_output) 0i32 3i32
				(borrow-shared short_prefix) 0i32 (array.len short_prefix))) (then (return 8i32)))
			(return 42i32))))
