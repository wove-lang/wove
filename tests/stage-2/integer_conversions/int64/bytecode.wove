(module bytecode_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn extend
		(params (wire (shared-array u8)))
		(returns i64)
		(body
			(let bits (u32.from-le-bytes (borrow-shared (local wire))))
			(let value (i64.from-u32 (local bits)))
			(if (u32.lt 2147483647u32 (local bits))
				(then (return (i64.sub (local value) 4294967296i64))))
			(return (local value))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let instruction (u32.to-le-bytes 0x80000000u32))
			(let decoded (call extend (borrow-shared (local instruction))))
			(if (bool.not (i64.eq (local decoded) -2147483648i64)) (then (return 1i32)))
			(let-mut stack (array.new (array i64 2) (local decoded) -0x0123456789abcdefi64))
			(let word (array.load (local stack) 1i32))
			(let little (i64.to-le-bytes (local word)))
			(let big (i64.to-be-bytes (local word)))
			(if (bool.not (bool.and (u8.eq (array.load (local little) 0i32) 0x11u8)
				(u8.eq (array.load (local little) 7i32) 0xfeu8))) (then (return 2i32)))
			(if (bool.not (bool.and (u8.eq (array.load (local big) 0i32) 0xfeu8)
				(u8.eq (array.load (local big) 7i32) 0x11u8))) (then (return 3i32)))
			(if (bool.not (i64.eq (i64.from-le-bytes (borrow-shared (local little))) (local word))) (then (return 4i32)))
			(if (bool.not (i64.eq (i64.from-be-bytes (borrow-shared (local big))) (local word))) (then (return 5i32)))
			(let min_wire (i64.to-be-bytes -0x8000000000000000i64))
			(array.store (local stack) 0i32 (i64.from-be-bytes (borrow-shared (local min_wire))))
			(if (bool.not (i64.eq (array.load (local stack) 0i32) -9223372036854775808i64)) (then (return 6i32)))
			(return 42i32))))
