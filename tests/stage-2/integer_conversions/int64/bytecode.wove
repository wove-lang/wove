(module bytecode_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn extend
		(params (wire (shared-array u8)))
		(returns i64)
		(body
			(let bits (u32:from-le-bytes (borrow-shared wire)))
			(let value (i64:from-u32 bits))
			(if (u32:lt 2147483647u32 bits)
				(then (return (i64:sub value 4294967296i64))))
			(return value)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let instruction (u32:to-le-bytes 0x80000000u32))
			(let decoded (call extend (borrow-shared instruction)))
			(if (bool:not (i64:eq decoded -2147483648i64)) (then (return 1i32)))
			(let-mut stack (array:new (array i64 2) decoded -0x0123456789abcdefi64))
			(let word (array:load stack 1i32))
			(let little (i64:to-le-bytes word))
			(let big (i64:to-be-bytes word))
			(if (bool:not (bool:and (u8:eq (array:load little 0i32) 0x11u8)
				(u8:eq (array:load little 7i32) 0xfeu8))) (then (return 2i32)))
			(if (bool:not (bool:and (u8:eq (array:load big 0i32) 0xfeu8)
				(u8:eq (array:load big 7i32) 0x11u8))) (then (return 3i32)))
			(if (bool:not (i64:eq (i64:from-le-bytes (borrow-shared little)) word)) (then (return 4i32)))
			(if (bool:not (i64:eq (i64:from-be-bytes (borrow-shared big)) word)) (then (return 5i32)))
			(let min_wire (i64:to-be-bytes -0x8000000000000000i64))
			(array:store stack 0i32 (i64:from-be-bytes (borrow-shared min_wire)))
			(if (bool:not (i64:eq (array:load stack 0i32) -9223372036854775808i64)) (then (return 6i32)))
			(return 42i32))))
