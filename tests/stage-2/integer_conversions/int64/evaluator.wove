(module evaluator_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Operator (variants (Add) (Sub) (Mul) (Div) (Rem)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn apply
		(params (op Operator) (left i64) (right i64) (output (mut-ref i64)))
		(returns bool)
		(body
			(match (local op)
				(case Add (return (i64.try_add (local left) (local right) (borrow-mut (local output)))))
				(case Sub (return (i64.try_sub (local left) (local right) (borrow-mut (local output)))))
				(case Mul (return (i64.try_mul (local left) (local right) (borrow-mut (local output)))))
				(case Div (return (i64.try_div (local left) (local right) (borrow-mut (local output)))))
				(case Rem (return (i64.try_rem (local left) (local right) (borrow-mut (local output))))))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:234"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let maximum (i64 9223372036854775807))
			(let minimum -9223372036854775808i64)
			(let-mut output 711i64)
			(if (bool.or (call apply (enum.new Operator Add) (local maximum) 1i64 (borrow-mut (local output)))
				(bool.not (i64.eq (local output) 711i64))) (then (return 1i32)))
			(if (bool.or (call apply (enum.new Operator Sub) (local minimum) 1i64 (borrow-mut (local output)))
				(bool.not (i64.eq (local output) 711i64))) (then (return 2i32)))
			(if (bool.or (call apply (enum.new Operator Mul) (local maximum) 2i64 (borrow-mut (local output)))
				(bool.not (i64.eq (local output) 711i64))) (then (return 3i32)))
			(if (bool.or (call apply (enum.new Operator Div) (local minimum) -1i64 (borrow-mut (local output)))
				(bool.not (i64.eq (local output) 711i64))) (then (return 4i32)))
			(if (bool.or (call apply (enum.new Operator Div) 42i64 0i64 (borrow-mut (local output)))
				(bool.not (i64.eq (local output) 711i64))) (then (return 5i32)))
			(if (bool.or (call apply (enum.new Operator Rem) 42i64 0i64 (borrow-mut (local output)))
				(bool.not (i64.eq (local output) 711i64))) (then (return 6i32)))
			(if (bool.not (bool.and (call apply (enum.new Operator Rem) (local minimum) -1i64 (borrow-mut (local output)))
				(i64.eq (local output) 0i64))) (then (return 7i32)))
			(if (bool.not (call apply (enum.new Operator Mul) -7i64 -6i64 (borrow-mut (local output)))) (then (return 8i32)))
			(return (i32.from-i64 (local output))))))
