(module typed_integer_checks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn typed_byte
		(params (value u64))
		(returns u8)
		(body (return (u8.from.u64 (local value)))))

	(fn inferred_byte
		(params (value u64))
		(returns u8)
		(body (return (int.convert u8 (local value)))))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let count (array.len (local args)))
			(if (i32.eq (local count) 1i32)
				(then (return (i32.from.u8 (call typed_byte 18446744073709551615u64)))))
			(if (i32.eq (local count) 2i32)
				(then (return (i32.from.u8 (call inferred_byte 18446744073709551615u64)))))
			(if (i32.eq (local count) 3i32)
				(then (return (i32.from.u32 (u32.from.i8 -1i8)))))
			(if (i32.eq (local count) 4i32)
				(then (return (i32.from.i8 (i8.from.u32 128u32)))))
			(if (bool.not (u8.eq (call typed_byte 255u64) (call inferred_byte 255u64)))
				(then (return 1i32)))
			(if (bool.not (u64.eq (u64.from.u32 4294967295u32) 4294967295u64))
				(then (return 2i32)))
			(if (bool.not (i32.eq (i32.from.i8 (i8.from.i32 -128i32)) -128i32))
				(then (return 3i32)))
			(if (bool.not (u32.eq (u32.from.u32 4294967295u32) 4294967295u32))
				(then (return 4i32)))
			(return 42i32))))
