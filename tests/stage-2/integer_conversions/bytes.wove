(module integer_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn check4
		(params (data (shared-array u8)) (first u8) (second u8) (third u8) (fourth u8))
		(returns bool)
		(body
			(return (bool.and (i32.eq (array.len (local data)) 4i32)
				(bool.and
					(bool.and (u8.eq (array.load (local data) 0i32) (local first))
						(u8.eq (array.load (local data) 1i32) (local second)))
					(bool.and (u8.eq (array.load (local data) 2i32) (local third))
						(u8.eq (array.load (local data) 3i32) (local fourth))))))))

	(fn counted
		(params (count (mut-array u8)))
		(returns u32)
		(body
			(let before (u32.from-u8 (array.load (local count) 0i32)))
			(array.store (local count) 0i32 (u8.from-u32 (u32.add (local before) 1u32)))
			(return 305419896u32)))

	(fn decode_be
		(params (data (shared-array u8)))
		(returns u32)
		(body (return (u32.from-be-bytes (local data)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:331"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut hits (array.alloc u8 1i32))
			(let le (u32.to-le-bytes (call counted (borrow-mut (local hits)))))
			(let be (u32.to-be-bytes 305419896u32))
			(if (bool.not (u8.eq (array.load (local hits) 0i32) 1u8)) (then (return 1i32)))
			(if (bool.not (call check4 (borrow-shared (local le)) 120u8 86u8 52u8 18u8)) (then (return 2i32)))
			(if (bool.not (call check4 (borrow-shared (local be)) 18u8 52u8 86u8 120u8)) (then (return 3i32)))
			(if (bool.not (u32.eq (u32.from-le-bytes (borrow-shared (local le))) 305419896u32)) (then (return 4i32)))
			(if (bool.not (u32.eq (call decode_be (borrow-shared (local be))) 305419896u32)) (then (return 5i32)))
			(let le_signed (i32.to-le-bytes -2147483648i32))
			(let be_signed (i32.to-be-bytes -2147483648i32))
			(if (bool.not (call check4 (borrow-shared (local le_signed)) 0u8 0u8 0u8 128u8)) (then (return 6i32)))
			(if (bool.not (call check4 (borrow-shared (local be_signed)) 128u8 0u8 0u8 0u8)) (then (return 7i32)))
			(if (bool.not (i32.eq (i32.from-le-bytes (borrow-shared (local le_signed))) -2147483648i32)) (then (return 8i32)))
			(if (bool.not (i32.eq (i32.from-be-bytes (borrow-shared (local be_signed))) -2147483648i32)) (then (return 9i32)))
			(let le64 (u64.to-le-bytes 18364758544493064720u64))
			(let be64 (u64.to-be-bytes 18364758544493064720u64))
			(if (bool.not (i32.eq (array.len (local le64)) 8i32)) (then (return 10i32)))
			(if (bool.not (u8.eq (array.load (local le64) 0i32) 16u8)) (then (return 11i32)))
			(if (bool.not (u8.eq (array.load (local be64) 0i32) 254u8)) (then (return 12i32)))
			(if (bool.not (u64.eq (u64.from-le-bytes (borrow-shared (local le64))) 18364758544493064720u64)) (then (return 13i32)))
			(if (bool.not (u64.eq (u64.from-be-bytes (borrow-shared (local be64))) 18364758544493064720u64)) (then (return 14i32)))
			(let signed_byte (i8.to-be-bytes -128i8))
			(let unsigned_byte (u8.to-le-bytes 255u8))
			(if (bool.not (i32.eq (array.len (i8.to-le-bytes -1i8)) 1i32)) (then (return 15i32)))
			(if (bool.not (u8.eq (array.load (local signed_byte) 0i32) 128u8)) (then (return 16i32)))
			(if (bool.not (i32.eq (i32.from-i8 (i8.from-le-bytes (borrow-shared (local signed_byte)))) -128i32)) (then (return 17i32)))
			(if (bool.not (u8.eq (u8.from-be-bytes (borrow-shared (local unsigned_byte))) 255u8)) (then (return 18i32)))
			(if (bool.not (u8.eq (array.load (u8.to-be-bytes 255u8) 0i32) 255u8)) (then (return 19i32)))
			(if (bool.not (u8.eq (u8.from-le-bytes (borrow-shared (local unsigned_byte))) 255u8)) (then (return 20i32)))
			(if (bool.not (i32.eq (i32.from-i8 (i8.from-be-bytes (borrow-shared (local signed_byte)))) -128i32)) (then (return 21i32)))
			(return 42i32))))
