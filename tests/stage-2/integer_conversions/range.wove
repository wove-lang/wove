(module integer_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn finish
		(params (value i32) (storage (mut-array u8)))
		(returns i32)
		(body
			(array:store storage 0i32 17u8)
			(return value)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut storage (array:alloc u8 6i32))
			(array:store storage 0i32 99u8)
			(array:store storage 1i32 42u8)
			(array:store storage 5i32 77u8)
			(let end (i32:add 4i32 (i32:dec (array:len args))))
			(return (call finish
				(i32:from-u32 (u32:from-le-bytes (borrow-shared (array:range storage 1i32 end))))
				(borrow-mut storage))))))
