(module integer_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn finish
		(params (value i32) (storage (mut-array u8)))
		(returns i32)
		(body
			(array.store (local storage) 0i32 17u8)
			(return (local value))))

	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut storage (array.alloc u8 6i32))
			(array.store (local storage) 0i32 99u8)
			(array.store (local storage) 1i32 42u8)
			(array.store (local storage) 5i32 77u8)
			(let end (i32.add 4i32 (array.len (local args))))
			(return (call finish
				(i32.from-u32 (u32.from-le-bytes (borrow-shared (array.range (local storage) 1i32 (local end)))))
				(borrow-mut (local storage)))))))
