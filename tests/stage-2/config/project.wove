(module project_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/config/project.wove"
		(only (type ProjectRead) (type ProjectSetting) read_project_config project_options project_setting))
	(use wove-file "../../../stage-2/config/defaults.wove" (only project_default_scalar project_default_cflags write_default_cflag))
	(use wove-file "../../../stage-2/config/schema.wove"
		(only (type ProjectRule) project_rule_count project_key_bytes write_project_schema project_compiler_rule))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(let bootstrap_optimization "-O1")
	(let bootstrap_inline_flag "-fno-inline-functions")

	(fn check_project
		(params (source (shared-array u8)) (requested (shared-array u8)) (scenario i32)
			(error u32) (start i32) (end i32))
		(returns i32)
		(body
			(let width (array.len (local source)))
			(let-mut nodes (array.alloc JsonNode (local width)))
			(let-mut settings (array.alloc ProjectSetting (local width)))
			(let result (call read_project_config (borrow-shared (local source)) (borrow-shared (local requested))
				(borrow-mut (local nodes)) (borrow-mut (local settings))))
			(if (bool.not (u32.eq (struct.get (local result) error) (local error)))
				(then (return (i32 1))))
			(if (bool.not (bool.and (i32.eq (struct.get (local result) start) (local start))
				(i32.eq (struct.get (local result) end) (local end))))
				(then (return (i32 2))))
			(if (i32.eq (local scenario) (i32 0)) (then (return (i32 0))))
			(if (i32.eq (local scenario) 7i32)
				(then (return (call check_examples (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local settings)) (local result)))))
			(let options (call project_options (borrow-shared (local nodes)) (borrow-shared (local settings)) (local result)))
			(if (bool.and (i32.lt (i32 0) (local scenario)) (i32.lt (local scenario) (i32 4)))
				(then
					(if (bool.not (bool.and (bool.not (struct.get (local options) parallel))
						(bool.and (u32.eq (struct.get (local options) parallel_jobs) (u32 0))
							(u32.eq (struct.get (local options) line_width) (u32 0)))))
						(then (return (i32 3))))
					(if (bool.or (struct.get (local options) human) (bool.or (struct.get (local options) time)
						(bool.not (bool.and (struct.get (local options) color)
							(u32.eq (struct.get (local options) max_errors) 20u32)))))
						(then (return 9i32)))
					(return (call check_checked_in (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local settings)) (local result) (local scenario)))))
			(if (i32.eq (local scenario) (i32 4))
				(then
					(if (bool.not (bool.and (u32.eq (struct.get (local options) parallel_jobs) (u32 6))
						(u32.eq (struct.get (local options) line_width) (u32 88))))
						(then (return (i32 4))))
					(if (bool.or (struct.get (local options) human) (bool.or (struct.get (local options) color)
						(bool.or (struct.get (local options) parallel)
							(bool.not (u32.eq (struct.get (local options) max_errors) (u32 0))))))
						(then (return (i32 5))))))
			(if (i32.eq (local scenario) (i32 5))
				(then
					(if (bool.not (bool.and (u32.eq (struct.get (local options) parallel_jobs) (u32 0))
						(u32.eq (struct.get (local options) line_width) (u32 0))))
						(then (return (i32 6))))
					(if (bool.not (bool.and (bool.not (struct.get (local options) parallel))
						(bool.and (struct.get (local options) human) (bool.and (struct.get (local options) color)
							(u32.eq (struct.get (local options) max_errors) (u32 7))))))
						(then (return (i32 7))))))
			(if (i32.eq (local scenario) (i32 6))
				(then
					(if (bool.not (bool.and (bool.not (struct.get (local options) parallel))
						(bool.and (u32.eq (struct.get (local options) parallel_jobs) (u32 0))
							(u32.eq (struct.get (local options) line_width) (u32 0)))))
						(then (return (i32 8))))
					(if (bool.or (struct.get (local options) human)
						(bool.not (bool.and (struct.get (local options) color)
							(u32.eq (struct.get (local options) max_errors) (u32 20)))))
						(then (return (i32 9))))))
			(return (i32 0))))

	(fn check_checked_in
		(:doc "Check active repository overrides and profile inheritance.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(result ProjectRead) (scenario i32))
		(returns i32)
		(body
			(let parallel (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) -1i32 -1i32 6i32))
			(if (bool.not (i32.eq (local parallel) -1i32)) (then (return 10i32)))
			(let flags (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) 2i32 9i32 13i32))
			(if (i32.eq (local scenario) 2i32)
				(then
					(if (i32.lt (local flags) 0i32) (then (return 12i32)))
					(let first (struct.get (array.load (local nodes) (local flags)) first_child))
					(if (i32.lt (local first) 0i32) (then (return 12i32)))
					(let flag (array.load (local nodes) (local first)))
					(let next (struct.get (local flag) next_sibling))
					(if (bool.or (i32.lt (local next) 0i32) (bool.not (call matches_string
						(borrow-shared (local source)) (local flag) (borrow-shared (local bootstrap_optimization)))))
						(then (return 12i32)))
					(let override (array.load (local nodes) (local next)))
					(if (bool.not (bool.and (i32.eq (struct.get (local override) next_sibling) -1i32)
						(call matches_string (borrow-shared (local source)) (local override) (borrow-shared (local bootstrap_inline_flag)))))
						(then (return 12i32))))
				(else
					(if (bool.not (i32.eq (local flags) -1i32))
						(then (return 13i32)))))
			(return 0i32)))

	(fn matches_string
		(:doc "Compare a decoded JSONC string with its exact expected bytes.")
		(params (source (shared-array u8)) (node JsonNode) (expected (shared-array u8))) (returns bool)
		(body
			(let width (array.len (local expected)))
			(let-mut decoded (array.alloc u8 (local width)))
			(let text (call json_decode_string (borrow-shared (local source)) (struct.get (local node) start)
				(struct.get (local node) end) (borrow-mut (local decoded))))
			(return (bool.and (u32.eq (struct.get (local text) error) 0u32)
				(call same_bytes (borrow-shared (local decoded)) 0i32 (struct.get (local text) written)
					(borrow-shared (local expected)) 0i32 (local width))))))

	(fn matches_default_flags
		(:doc "Compare the copied C flags with the built-in list for this mode.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (first i32) (mode u32))
		(returns bool)
		(body
			(let count (call project_default_cflags (local mode)))
			(let-mut item (local first))
			(let-mut index 0i32)
			(let-mut expected (array.alloc u8 3i32))
			(while (i32.lt (local index) (local count))
				(body
					(if (i32.lt (local item) 0i32) (then (return (bool false))))
					(let node (array.load (local nodes) (local item)))
					(let width (call write_default_cflag (local mode) (local index) (borrow-mut (local expected))))
					(if (bool.not (call matches_string (borrow-shared (local source)) (local node)
						(borrow-shared (array.range (local expected) 0i32 (local width)))))
						(then (return (bool false))))
					(set (local item) (struct.get (local node) next_sibling))
					(set (local index) (i32.add (local index) 1i32))))
			(return (i32.eq (local item) -1i32))))

	(fn matches_example
		(:doc "Check each documented setting against its built-in value and require deferred settings to be absent.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(value i32) (row i32) (kind u32) (mode u32))
		(returns bool)
		(body
			(let documented (bool.or (i32.eq (local row) 6i32)
				(bool.or (i32.eq (local row) (call project_compiler_rule 0i32))
					(bool.or (i32.eq (local row) 20i32)
						(bool.or (i32.eq (local row) 21i32)
							(bool.and (i32.lt 12i32 (local row)) (i32.lt (local row) 19i32)))))))
			(if (bool.not (local documented)) (then (return (i32.eq (local value) -1i32))))
			(if (i32.lt (local value) 0i32) (then (return (bool false))))
			(let node (array.load (local nodes) (local value)))
			(if (u32.eq (local kind) 6u32)
				(then
					(let first (struct.get (local node) first_child))
					(if (i32.eq (local row) 13i32)
						(then (return (call matches_default_flags (borrow-shared (local source))
							(borrow-shared (local nodes)) (local first) (local mode)))))
					(return (i32.eq (local first) -1i32))))
			(let scalar (struct.get (array.load (local settings) (local value)) scalar))
			(return (u32.eq (local scalar) (call project_default_scalar (local row) (local mode))))))

	(fn check_examples
		(:doc "Check the enabled examples in the default profile and each build mode.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(result ProjectRead))
		(returns i32)
		(body
			(let-mut names (array.alloc u8 (call project_key_bytes)))
			(let-mut rules (array.alloc ProjectRule (call project_rule_count)))
			(call write_project_schema (borrow-mut (local names)) (borrow-mut (local rules)))
			(let-mut mode 0i32)
			(while (i32.lt (local mode) 3i32)
				(body
					(let-mut row 6i32)
					(while (i32.lt (local row) (array.len (local rules)))
						(body
							(let rule (array.load (local rules) (local row)))
							(let scope (struct.get (local rule) scope))
							(if (bool.not (u32.eq (local scope) 2u32))
								(then
									(let-mut section -1i32)
									(let-mut subsection -1i32)
									(if (u32.eq (local scope) 3u32)
										(then (set (local section) 2i32)
											(set (local subsection) (i32.add 9i32 (local mode)))))
									(if (u32.eq (local scope) 4u32) (then (set (local section) 3i32)))
									(if (u32.eq (local scope) 6u32) (then (set (local section) 4i32)))
									(if (u32.eq (local scope) 7u32) (then (set (local section) 5i32)))
									(let value (call project_setting (borrow-shared (local nodes))
										(borrow-shared (local settings)) (local result) (local section) (local subsection) (local row)))
									(if (bool.not (call matches_example (borrow-shared (local source)) (borrow-shared (local nodes))
										(borrow-shared (local settings)) (local value) (local row) (struct.get (local rule) kind)
										(int.convert u32 (local mode))))
										(then (return (i32.add 30i32 (local row)))))))
							(set (local row) (i32.add (local row) 1i32))))
					(set (local mode) (i32.add (local mode) 1i32))))
			(return 0i32)))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0))))
)
