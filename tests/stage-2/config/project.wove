(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	project_fixture

	(use wove-file "../../../stage-2/config/project.wove"
		(only (type ProjectRead) (type ProjectSetting) read_project_config project_options project_setting))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))

	(fn check_project
		(params (source (shared-slice u8)) (requested (shared-slice u8)) (scenario i32)
			(error u32) (start i32) (end i32))
		(returns i32)
		(body
			(let width (slice.len (local source)))
			(let-mut nodes (array.alloc JsonNode (local width)))
			(let-mut settings (array.alloc ProjectSetting (local width)))
			(let result (call read_project_config (borrow-shared (local source)) (borrow-shared (local requested))
				(borrow-mut (local nodes)) (borrow-mut (local settings))))
			(if (bool.not (u32.eq (record.get (local result) error) (local error)))
				(then (return (i32 1))))
			(if (bool.not (bool.and (i32.eq (record.get (local result) start) (local start))
				(i32.eq (record.get (local result) end) (local end))))
				(then (return (i32 2))))
			(if (i32.eq (local scenario) (i32 0)) (then (return (i32 0))))
			(let options (call project_options (borrow-shared (local nodes)) (borrow-shared (local settings)) (local result)))
			(if (bool.and (i32.lt (i32 0) (local scenario)) (i32.lt (local scenario) (i32 4)))
				(then
					(if (bool.not (bool.and (record.get (local options) parallel)
						(bool.and (u32.eq (record.get (local options) parallel_jobs) (u32 0))
							(u32.eq (record.get (local options) line_width) (u32 0)))))
						(then (return (i32 3))))
					(return (call check_checked_in (borrow-shared (local nodes)) (borrow-shared (local settings))
						(local result) (local scenario)))))
			(if (i32.eq (local scenario) (i32 4))
				(then
					(if (bool.not (bool.and (u32.eq (record.get (local options) parallel_jobs) (u32 6))
						(u32.eq (record.get (local options) line_width) (u32 88))))
						(then (return (i32 4))))
					(if (bool.or (record.get (local options) human) (bool.or (record.get (local options) color)
						(bool.or (record.get (local options) parallel)
							(bool.not (u32.eq (record.get (local options) max_errors) (u32 0))))))
						(then (return (i32 5))))))
			(if (i32.eq (local scenario) (i32 5))
				(then
					(if (bool.not (bool.and (u32.eq (record.get (local options) parallel_jobs) (u32 0))
						(u32.eq (record.get (local options) line_width) (u32 0))))
						(then (return (i32 6))))
					(if (bool.not (bool.and (record.get (local options) parallel)
						(bool.and (record.get (local options) human) (bool.and (record.get (local options) color)
							(u32.eq (record.get (local options) max_errors) (u32 7))))))
						(then (return (i32 7))))))
			(if (i32.eq (local scenario) (i32 6))
				(then
					(if (bool.not (bool.and (record.get (local options) parallel)
						(bool.and (u32.eq (record.get (local options) parallel_jobs) (u32 0))
							(u32.eq (record.get (local options) line_width) (u32 0)))))
						(then (return (i32 8))))
					(if (bool.or (record.get (local options) human)
						(bool.not (bool.and (record.get (local options) color)
							(u32.eq (record.get (local options) max_errors) (u32 20)))))
						(then (return (i32 9))))))
			(return (i32 0))))

	(fn check_checked_in
		(params (nodes (shared-slice JsonNode)) (settings (shared-slice ProjectSetting))
			(result ProjectRead) (scenario i32))
		(returns i32)
		(body
			(let cache_row (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) (i32 2) (i32 12) (i32 15)))
			(let lto_row (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) (i32 2) (i32 14) (i32 21)))
			(let cstd_row (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) (i32 3) (i32 -1) (i32 24)))
			(let bin_row (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) (i32 4) (i32 -1) (i32 34)))
			(if (bool.or (i32.lt (local cache_row) (i32 0)) (bool.or (i32.lt (local lto_row) (i32 0))
				(bool.or (i32.lt (local cstd_row) (i32 0)) (i32.lt (local bin_row) (i32 0)))))
				(then (return (i32 10))))
			(let cache (slice.load (local settings) (local cache_row)))
			(let lto (slice.load (local settings) (local lto_row)))
			(let cstd (slice.load (local settings) (local cstd_row)))
			(let bin (slice.load (local nodes) (local bin_row)))
			(if (bool.not (bool.and (u32.eq (record.get (local lto) scalar) (u32 1))
				(u32.eq (record.get (local cstd) scalar) (u32 11))))
				(then (return (i32 11))))
			(if (bool.not (call agree (i32.eq (local scenario) (i32 2)) (u32.eq (record.get (local cache) scalar) (u32 0))))
				(then (return (i32 12))))
			(if (bool.not (call agree (i32.eq (local scenario) (i32 3)) (i32.eq (record.get (local bin) first_child) (i32 -1))))
				(then (return (i32 13))))
			(let warn_row (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) (i32 3) (i32 28) (i32 30)))
			(if (i32.lt (local warn_row) (i32 0)) (then (return (i32 14))))
			(let warning (slice.load (local settings) (local warn_row)))
			(if (bool.not (call agree (i32.eq (local scenario) (i32 3)) (u32.eq (record.get (local warning) scalar) (u32 0))))
				(then (return (i32 15))))
			(return (i32 0))))

	(fn agree
		(params (left bool) (right bool))
		(returns bool)
		(body
			(if (local left) (then (return (local right))))
			(return (bool.not (local right)))))

	(fn main (params) (returns i32) (body (return (i32 0))))
)
