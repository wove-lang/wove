{
	"profiles": [
		{
			// An omitted name denotes the default layer.
			"parallelJobs": 3,
			"human": true,
			"max-errors": 7,
			"fmt": { "lineWidth": 72, },
		},
		{
			"name": "w\u0069de",
			"parallel": false,
			"parallelJobs": 6,
			"human": false,
			"max-errors": 0,
			"color": false,
			"fmt": {
				/* Explicit sizing uses positive values. */
				"lineWidth": 88,
			},
		},
		{
			"name": "auto",
			"parallelJobs": 0,
			"fmt": { "lineWidth": 0, },
		},
	],
}
