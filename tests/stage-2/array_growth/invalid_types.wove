	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Row (fields (hits i32)))
	(struct Other (fields (hits i32)))
	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc Row 0i32))
			(array.push rows (struct.new Other (hits 42i32)))
			(return 0i32))))
