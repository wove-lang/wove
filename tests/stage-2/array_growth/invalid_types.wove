(module grow_wrong_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Row (fields (hits i32)))
	(struct Other (fields (hits i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc Row 0i32))
			(array.push (local rows) (struct.new Other (hits 42i32)))
			(return 0i32))))
