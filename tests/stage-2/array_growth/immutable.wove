(module grow_immutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let rows (array.alloc u8 1i32))
			(array.truncate rows 0i32)
			(return (array.len rows)))))
