(module grow_projected_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Summary (fields (bytes (owned-array u8))))
	(fn append
		(params (summary (mut-ref Summary)) (byte u8)) (returns void)
		(body (array:push (struct:get summary bytes) byte)))

	(fn load_first
		(params (bytes (shared-array u8))) (returns i32)
		(body (return (int:convert i32 (array:load bytes 0i32)))))

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut summary (struct:new Summary (bytes (array:alloc u8 0i32))))
			(call append (borrow-mut summary) 17u8)
			(call append (borrow-mut summary) 42u8)
			(let removed (array:remove (struct:get summary bytes) 0i32))
			(if (bool:not (u8:eq removed 17u8)) (then (return 1i32)))
			(return (call load_first (borrow-shared (struct:get summary bytes)))))))
