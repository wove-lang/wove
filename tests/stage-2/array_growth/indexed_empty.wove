(module indexed_empty_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array i32) 1i32))
			(if (i32.eq (array.len (local spans)) 1i32)
				(then (array.reserve (array.load (local rows) 0i32) 8i32))
				(else (for (bind row) (borrow-shared (local rows)) (body (break)))))
			(return 0i32))))
