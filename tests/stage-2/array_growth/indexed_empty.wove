(module indexed_empty_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc (owned-array i32) 1i32))
			(if (i32:eq (i32:dec (array:len spans)) 1i32)
				(then (array:reserve (array:get rows 0i32) 8i32))
				(else (for (let row) (borrow-shared rows) (body (break)))))
			(return 0i32))))
