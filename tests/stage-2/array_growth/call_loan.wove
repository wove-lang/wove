(module grow_during_call_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn accept
		(params (view (shared-array u8)) (reserved bool)) (returns i32)
		(body (return (array.len (local view)))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc u8 1i32))
			(return (call accept (borrow-shared (local rows))
				(array.try-reserve (local rows) 20i32))))))
