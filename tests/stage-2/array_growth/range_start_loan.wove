(module grow_during_range_start
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn read_first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local bytes) 0i32)))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(return (call read_first (borrow-shared (array.range (local data)
				(if (array.try-reserve (local data) 16i32) (then 0i32) (else 0i32)) 1i32)))))))
