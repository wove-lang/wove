(module grow_during_range_start
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int:convert i32 (array:load bytes 0i32)))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array:alloc u8 1i32))
			(return (call read_first (borrow-shared (array:range data
				(if (array:try-reserve data 16i32) (then 0i32) (else 0i32)) 1i32)))))))
