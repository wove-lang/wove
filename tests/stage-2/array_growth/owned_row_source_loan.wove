(module move_lent_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 0i32))
			(let data (array.alloc u8 1i32))
			(let held (borrow-shared (local data)))
			(array.push (local rows) (move (local data)))
			(return (array.len (local held))))))
