(module grow_during_shared_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc u8 1i32))
			(let view (borrow-shared (local rows)))
			(array.push (local rows) 42u8)
			(return (array.len (local view))))))
