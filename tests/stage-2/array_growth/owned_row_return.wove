(module return_removed_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make_row
		(params (value u8))
		(returns (owned-array u8))
		(body
			(let-mut bytes (array.alloc u8 1i32))
			(array.store (local bytes) 0i32 (local value))
			(return (move (local bytes)))))

	(fn first_byte
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local bytes) 0i32)))))

	(fn extract
		(params)
		(returns (owned-array u8))
		(body
			(let-mut rows (array.alloc (owned-array u8) 0i32))
			(let byte (call make_row 42u8))
			(array.push (local rows) (move (local byte)))
			(return (array.remove (local rows) 0i32))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let row (call extract))
			(return (call first_byte (borrow-shared (local row)))))))
