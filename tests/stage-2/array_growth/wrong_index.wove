(module grow_wrong_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc u8 1i32))
			(let removed (array.remove (local rows) 0u32))
			(return (int.convert i32 (local removed))))))
