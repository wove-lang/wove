(module grow_wrong_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc u8 1i32))
			(let removed (array.remove (local rows) 0u32))
			(return (int.convert i32 (local removed))))))
