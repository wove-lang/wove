(module grow_request_table
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Row (fields (key u32) (hits i32)))

	(fn read_total
		(params (rows (shared-array Row))) (returns i32)
		(body
			(let first (array.load rows 0i32))
			(let second (array.load rows 1i32))
			(if (bool.and (u32.eq (struct.get first key) 1u32)
				(u32.eq (struct.get second key) 3u32))
				(then (return (i32.add (struct.get first hits) (struct.get second hits)))))
			(return 1i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:375"))
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc Row 0i32))
			(if (bool.not (i32.eq (array.len rows) 0i32)) (then (return 2i32)))
			(array.push rows (struct.new Row (key 1u32) (hits 20i32)))
			(array.push rows (array.load rows 0i32))
			(array.push rows (struct.new Row (key 3u32) (hits 22i32)))
			(array.push rows (struct.new Row (key 4u32) (hits 9i32)))
			(let capacity (array.capacity rows))
			(if (array.try-reserve rows 64i32) (then (return 3i32)))
			(if (array.try-reserve rows -1i32) (then (return 4i32)))
			(if (bool.not (i32.eq (array.capacity rows) capacity)) (then (return 5i32)))
			(if (bool.not (i32.eq (array.len rows) 4i32)) (then (return 6i32)))
			(let removed (array.remove rows 1i32))
			(if (bool.not (u32.eq (struct.get removed key) 1u32)) (then (return 7i32)))
			(if (bool.not (i32.eq (struct.get removed hits) 20i32)) (then (return 8i32)))
			(let last (array.load rows 2i32))
			(if (bool.not (u32.eq (struct.get last key) 4u32)) (then (return 9i32)))
			(array.truncate rows 2i32)
			(if (bool.not (i32.eq (array.len rows) 2i32)) (then (return 10i32)))
			(if (bool.not (i32.eq (array.capacity rows) capacity)) (then (return 11i32)))
			(array.reserve rows 8i32)
			(if (bool.not (i32.eq (array.capacity rows) 8i32)) (then (return 12i32)))
			(if (bool.not (array.try-reserve rows 4i32)) (then (return 13i32)))
			(if (bool.not (i32.eq (array.capacity rows) 8i32)) (then (return 14i32)))
			(if (bool.not (i32.eq (array.len rows) 2i32)) (then (return 15i32)))
			(return (call read_total (borrow-shared rows))))))
