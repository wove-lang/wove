(module grow_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc u8 1i32))
			(array:reserve rows 16i32)
			(if (i32:eq (i32:dec (array:len spans)) 1i32)
				(then (array:truncate rows 2i32))
				(else
					(if (i32:eq (i32:dec (array:len spans)) 2i32)
						(then (return (int:convert i32 (array:remove rows -1i32)))))))
			(return (int:convert i32 (array:remove rows 1i32))))))
