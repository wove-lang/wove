(module grow_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc u8 1i32))
			(array.reserve (local rows) 16i32)
			(if (i32.eq (array.len (local spans)) 1i32)
				(then (array.truncate (local rows) 2i32))
				(else
					(if (i32.eq (array.len (local spans)) 2i32)
						(then (return (int.convert i32 (array.remove (local rows) -1i32)))))))
			(return (int.convert i32 (array.remove (local rows) 1i32))))))
