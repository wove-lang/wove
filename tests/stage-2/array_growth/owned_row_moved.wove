(module use_pushed_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 0i32))
			(let data (array:alloc u8 1i32))
			(array:push rows (move data))
			(return (array:len data)))))
