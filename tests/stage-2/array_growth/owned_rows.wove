(module grow_owned_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn make_row
		(params (value u8))
		(returns (owned-array u8))
		(body
			(let-mut bytes (array:alloc u8 1i32))
			(array:store bytes 0i32 value)
			(return (move bytes))))

	(fn first_byte
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int:convert i32 (array:load bytes 0i32)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:375"))
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 0i32))
			(let a (call make_row 17u8))
			(array:push rows (move a))
			(let b (call make_row 29u8))
			(array:push rows (move b))
			(let c (call make_row 25u8))
			(array:push rows (move c))
			(let d (call make_row 8u8))
			(array:push rows (move d))
			(let capacity (array:capacity rows))
			(if (array:try-reserve rows 64i32) (then (return 1i32)))
			(if (bool:not (i32:eq (array:capacity rows) capacity)) (then (return 2i32)))
			(if (bool:not (i32:eq (array:len rows) 4i32)) (then (return 3i32)))
			(let removed (array:remove rows 1i32))
			(if (bool:not (i32:eq (call first_byte (borrow-shared (array:load rows 2i32))) 8i32))
				(then (return 4i32)))
			(array:truncate rows 2i32)
			(if (bool:not (i32:eq (array:capacity rows) capacity)) (then (return 5i32)))
			(if (bool:not (i32:eq (array:len rows) 2i32)) (then (return 6i32)))
			(if (bool:not (i32:eq (call first_byte (borrow-shared removed)) 29i32))
				(then (return 7i32)))
			(if (bool:not (i32:eq (call first_byte (borrow-shared (array:load rows 0i32))) 17i32))
				(then (return 8i32)))
			(if (bool:not (i32:eq (call first_byte (borrow-shared (array:load rows 1i32))) 25i32))
				(then (return 9i32)))
			(return (i32:add
				(call first_byte (borrow-shared (array:load rows 0i32)))
				(call first_byte (borrow-shared (array:load rows 1i32))))))))
