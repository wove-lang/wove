(module indexed_row_live_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array i32) 1i32))
			(let view (borrow-shared (array.load (local rows) 0i32)))
			(array.reserve (array.load (local rows) 0i32) 2i32)
			(return (array.len (local view))))))
