(module indexed_row_live_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array i32) 1i32))
			(let view (borrow-shared (array.load rows 0i32)))
			(array.reserve (array.load rows 0i32) 2i32)
			(return (array.len view)))))
