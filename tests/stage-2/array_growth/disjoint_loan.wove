(module grow_during_unrelated_load
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn read_first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local bytes) 0i32)))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let-mut other (array.alloc u8 0i32))
			(array.store (local data) 0i32 42u8)
			(let value (array.load (local data)
				(if (array.try-reserve (local other) 16i32)
					(then (i32.sub.wrapping (array.len (local data)) 1i32))
					(else 1i32))))
			(if (bool.not (u8.eq (local value) 42u8)) (then (return 1i32)))
			(return (call read_first (borrow-shared (array.range (local data)
				(i32.sub.wrapping (array.len (local data)) 1i32) (array.len (local data)))))))))
