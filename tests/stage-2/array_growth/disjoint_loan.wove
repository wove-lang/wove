(module grow_during_unrelated_load
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn read_first
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load bytes 0i32)))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let-mut other (array.alloc u8 0i32))
			(array.store data 0i32 42u8)
			(let value (array.load data
				(if (array.try-reserve other 16i32)
					(then (i32.sub (array.len data) 1i32))
					(else 1i32))))
			(if (bool.not (u8.eq value 42u8)) (then (return 1i32)))
			(return (call read_first (borrow-shared (array.range data
				(i32.sub (array.len data) 1i32) (array.len data))))))))
