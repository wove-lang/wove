(module indexed_row_parent_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn destroy (params (rows (owned-array (owned-array i32)))) (returns i32)
		(body (return 2i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array i32) 1i32))
			(array.reserve (array.load (local rows) 0i32) (call destroy (move (local rows))))
			(return 0i32))))
