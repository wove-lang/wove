(module indexed_row_parent_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn destroy (params (rows (owned-array (owned-array i32)))) (returns i32)
		(body (return 2i32)))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array i32) 1i32))
			(array.reserve (array.load rows 0i32) (call destroy (move rows)))
			(return 0i32))))
