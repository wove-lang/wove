(module heap_fixed_try_push
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Push (variants (Added) (Rejected (array (owned-array u8) 1))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn append (params (other (owned-array (array (owned-array u8) 1)))) (returns void)
		(body
			(let-mut items (move (local other)))
			(let status (array.try-push (local items) Push
				(array.new (array (owned-array u8) 1) (array.alloc u8 1i32))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 42i32))))
