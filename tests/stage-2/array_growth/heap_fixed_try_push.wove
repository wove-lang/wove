(module heap_fixed_try_push
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Push (variants (Added) (Rejected (array (owned-array u8) 1))))

	(fn append (params (other (owned-array (array (owned-array u8) 1)))) (returns void)
		(body
			(let-mut items (move other))
			(let status (array:try-push items Push
				(array:new (array (owned-array u8) 1) (array:alloc u8 1i32))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
