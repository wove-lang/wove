(module indexed_batch_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn path (params (byte i32)) (returns (owned-array i32))
		(body
			(let-mut bytes (array.alloc i32 1i32))
			(array.store (local bytes) 0i32 (local byte))
			(return (move (local bytes)))))

	(fn index (params (count (mut-ref i32))) (returns i32)
		(body
			(set (local count) (i32.add (local count) 1i32))
			(return 0i32)))

	(fn read_path (params (bytes (shared-array i32))) (returns i32)
		(body (return (array.load (local bytes) 0i32))))

	(fn digest (params (paths (shared-array (owned-array i32)))) (returns i32)
		(body
			(let-mut result 0i32)
			(for (bind offset bytes) (borrow-shared (local paths))
				(body
					(let item (call read_path (borrow-shared (local bytes))))
					(set (local result) (i32.add (local result) (i32.add (local offset) (local item))))))
			(return (local result))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut batches (array.alloc (owned-array (owned-array i32)) 2i32))
			(let left (array.alloc (owned-array i32) 0i32))
			(let right (array.alloc (owned-array i32) 0i32))
			(array.store (local batches) 0i32 (move (local left)))
			(array.store (local batches) 1i32 (move (local right)))
			(let alpha (call path 17i32))
			(let beta (call path 24i32))
			(let-mut selections 0i32)
			(array.push (array.load (local batches) (call index (borrow-mut (local selections)))) (move (local alpha)))
			(array.push (array.load (local batches) 1i32) (move (local beta)))
			(array.reserve (array.load (local batches) 0i32) 16i32)
			(let spare (call path 9i32))
			(array.push (array.load (local batches) 0i32) (move (local spare)))
			(if (i32.lt (array.capacity (array.load (local batches) 0i32)) 16i32) (then (return 1i32)))
			(let before (call digest (borrow-shared (array.load (local batches) 0i32))))
			(if (i32.not-eq (local before) 27i32) (then (return 3i32)))
			(if (bool.not (array.try-reserve (array.load (array.load (local batches) 1i32) 0i32) 32i32))
				(then (return 4i32)))
			(let removed (array.remove (array.load (local batches) 0i32) 1i32))
			(if (i32.not-eq (call read_path (borrow-shared (local removed))) 9i32) (then (return 2i32)))
			(let-mut sum (local selections))
			(for (bind paths) (borrow-shared (local batches))
				(body (set (local sum) (i32.add (local sum) (call digest (borrow-shared (local paths)))))))
			(return (local sum)))))
