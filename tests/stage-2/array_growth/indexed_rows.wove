(module indexed_batch_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn path (params (byte i32)) (returns (owned-array i32))
		(body
			(let-mut bytes (array:alloc i32 1i32))
			(array:set bytes 0i32 byte)
			(return (move bytes))))

	(fn index (params (count (mut-ref i32))) (returns i32)
		(body
			(set count (i32:add count 1i32))
			(return 0i32)))

	(fn read_path (params (bytes (shared-array i32))) (returns i32)
		(body (return (array:get bytes 0i32))))

	(fn digest (params (paths (shared-array (owned-array i32)))) (returns i32)
		(body
			(let-mut result 0i32)
			(for (let offset bytes) (borrow-shared paths)
				(body
					(let item (call read_path (borrow-shared bytes)))
					(set result (i32:add result (i32:add offset item)))))
			(return result)))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut batches (array:alloc (owned-array (owned-array i32)) 2i32))
			(let left (array:alloc (owned-array i32) 0i32))
			(let right (array:alloc (owned-array i32) 0i32))
			(array:set batches 0i32 (move left))
			(array:set batches 1i32 (move right))
			(let alpha (call path 17i32))
			(let beta (call path 24i32))
			(let-mut selections 0i32)
			(array:push (array:get batches (call index (borrow-mut selections))) (move alpha))
			(array:push (array:get batches 1i32) (move beta))
			(array:reserve (array:get batches 0i32) 16i32)
			(let spare (call path 9i32))
			(array:push (array:get batches 0i32) (move spare))
			(if (i32:lt (array:capacity (array:get batches 0i32)) 16i32) (then (return 1i32)))
			(let before (call digest (borrow-shared (array:get batches 0i32))))
			(if (i32:not-eq before 27i32) (then (return 3i32)))
			(if (bool:not (array:try-reserve (array:get (array:get batches 1i32) 0i32) 32i32))
				(then (return 4i32)))
			(let removed (array:remove (array:get batches 0i32) 1i32))
			(if (i32:not-eq (call read_path (borrow-shared removed)) 9i32) (then (return 2i32)))
			(let-mut sum selections)
			(for (let paths) (borrow-shared batches)
				(body (set sum (i32:add sum (call digest (borrow-shared paths))))))
			(return sum))))
