(module conditional_removed_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn extract
		(params (take bool))
		(returns (owned-array u8))
		(body
			(let-mut rows (array:alloc (owned-array u8) 0i32))
			(let-mut row (array:alloc u8 1i32))
			(array:store row 0i32 42u8)
			(array:push rows (move row))
			(return (if take
				(then (array:remove rows 0i32))
				(else (array:alloc u8 42i32))))))

	(fn check
		(params (take bool) (length i32) (first u8))
		(returns bool)
		(body
			(let row (call extract take))
			(return (bool:and
				(i32:eq (array:len row) length)
				(u8:eq (array:load row 0i32) first)))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:and (call check (bool true) 1i32 42u8)
				(call check (bool false) 42i32 0u8))
				(then (return 42i32)))
			(return 1i32))))
