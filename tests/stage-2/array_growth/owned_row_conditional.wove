(module conditional_removed_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn extract
		(params (take bool))
		(returns (owned-array u8))
		(body
			(let-mut rows (array.alloc (owned-array u8) 0i32))
			(let-mut row (array.alloc u8 1i32))
			(array.store (local row) 0i32 42u8)
			(array.push (local rows) (move (local row)))
			(return (if (local take)
				(then (array.remove (local rows) 0i32))
				(else (array.alloc u8 42i32))))))

	(fn check
		(params (take bool) (length i32) (first u8))
		(returns bool)
		(body
			(let row (call extract (local take)))
			(return (bool.and
				(i32.eq (array.len (local row)) (local length))
				(u8.eq (array.load (local row) 0i32) (local first))))))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(if (bool.and (call check (bool true) 1i32 42u8)
				(call check (bool false) 42i32 0u8))
				(then (return 42i32)))
			(return 1i32))))
