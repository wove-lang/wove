(module scoped_cursor
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn length
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (array.len (local bytes)))))

	(fn peek
		(params (cursor (shared-ref Cursor)))
		(returns u8)
		(body
			(return (array.load (struct.get (local cursor) bytes) (struct.get (local cursor) at)))))

	(fn next
		(params (cursor (mut-ref Cursor)))
		(returns u8)
		(body
			(let byte (call peek (borrow-shared (local cursor))))
			(set (struct.get (local cursor) at)
				(i32.add (struct.get (local cursor) at) 1i32))
			(return (local byte))))

	(fn from_parameter
		(params (bytes (shared-array u8)))
		(returns i32)
		(body
			(let cursor (struct.new Cursor (bytes (borrow-shared (local bytes))) (at 0i32)))
			(return (array.len (struct.get (local cursor) bytes)))))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut storage (array.alloc u8 3i32))
			(array.store (local storage) 1i32 19u8)
			(array.store (local storage) 2i32 23u8)
			(if (bool true)
				(then
					(let-mut cursor (struct.new Cursor
						(bytes (borrow-shared (array.range (local storage) 1i32 3i32)))
						(at 0i32)))
					(let a (call next (borrow-mut (local cursor))))
					(let b (call next (borrow-mut (local cursor))))
					(if (bool.not (bool.and (u8.eq (local a) 19u8) (u8.eq (local b) 23u8)))
						(then (return 1i32)))
					(let view (borrow-shared (struct.get (local cursor) bytes)))
					(if (bool.not (i32.eq (call length (borrow-shared (local view))) 2i32))
						(then (return 2i32)))
					(if (bool.not (i32.eq (call from_parameter (borrow-shared (struct.get (local cursor) bytes))) 2i32))
						(then (return 3i32)))
					(if (bool.not (u8.eq (array.load (local storage) 1i32) 19u8))
						(then (return 4i32)))))
			(array.store (local storage) 1i32 42u8)
			(let result (move (local storage)))
			(return (int.convert i32 (array.load (local result) 1i32))))))
