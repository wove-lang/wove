(module scoped_cursor
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))

	(fn length
		(params (bytes (shared-array u8)))
		(returns i32)
		(body (return (array.len bytes))))

	(fn peek
		(params (cursor (shared-ref Cursor)))
		(returns u8)
		(body
			(return (array.load (struct.get cursor bytes) (struct.get cursor at)))))

	(fn next
		(params (cursor (mut-ref Cursor)))
		(returns u8)
		(body
			(let byte (call peek (borrow-shared cursor)))
			(set (struct.get cursor at)
				(i32.add (struct.get cursor at) 1i32))
			(return byte)))

	(fn from_parameter
		(params (bytes (shared-array u8)))
		(returns i32)
		(body
			(let cursor (struct.new Cursor (bytes (borrow-shared bytes)) (at 0i32)))
			(return (array.len (struct.get cursor bytes)))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut storage (array.alloc u8 3i32))
			(array.store storage 1i32 19u8)
			(array.store storage 2i32 23u8)
			(if (bool true)
				(then
					(let-mut cursor (struct.new Cursor
						(bytes (borrow-shared (array.range storage 1i32 3i32)))
						(at 0i32)))
					(let a (call next (borrow-mut cursor)))
					(let b (call next (borrow-mut cursor)))
					(if (bool.not (bool.and (u8.eq a 19u8) (u8.eq b 23u8)))
						(then (return 1i32)))
					(let view (borrow-shared (struct.get cursor bytes)))
					(if (bool.not (i32.eq (call length (borrow-shared view)) 2i32))
						(then (return 2i32)))
					(if (bool.not (i32.eq (call from_parameter (borrow-shared (struct.get cursor bytes))) 2i32))
						(then (return 3i32)))
					(if (bool.not (u8.eq (array.load storage 1i32) 19u8))
						(then (return 4i32)))))
			(array.store storage 1i32 42u8)
			(let result (move storage))
			(return (int.convert i32 (array.load result 1i32))))))
