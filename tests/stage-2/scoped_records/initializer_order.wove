(module scoped_record_initializer_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(fn paint
		(params (bytes (mut-array u8))) (returns i32)
		(body
			(array.store bytes 0i32 42u8)
			(return 0i32)))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let cursor (struct.new Cursor
				(bytes (borrow-shared data))
				(at (call paint (borrow-mut data)))))
			(return 0i32))))
