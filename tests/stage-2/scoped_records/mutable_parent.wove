(module scoped_record_mutable_parent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array:alloc u8 1i32))
			(let view (borrow-mut data))
			(let cursor (struct:new Cursor (bytes (borrow-shared view)) (at 0i32)))
			(array:store view 0i32 42u8)
			(return 0i32))))
