(module scoped_record_disjoint_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn read
		(params (scratch (mut-array u8)) (cursor (shared-ref Cursor)))
		(returns i32)
		(body
			(return (int.convert i32
				(array.load (struct.get (local cursor) bytes)
					(call select_index (borrow-mut (local scratch))))))))

	(fn select_index
		(params (scratch (mut-array u8)))
		(returns i32)
		(body
			(array.store (local scratch) 0i32 1u8)
			(return 0i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 3i32))
			(array.store (local data) 0i32 42u8)
			(let cursor (struct.new Cursor (bytes (borrow-shared (local data))) (at 0i32)))
			(let-mut scratch (array.new (array u8 1) 0u8))
			(let result (call read (borrow-mut (local scratch)) (borrow-shared (local cursor))))
			(if (u8.eq (array.load (local scratch) 0i32) 1u8) (then (return (local result))))
			(return 1i32))))
