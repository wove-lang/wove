(module scoped_record_disjoint_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))

	(fn read
		(params (scratch (mut-array u8)) (cursor (shared-ref Cursor)))
		(returns i32)
		(body
			(return (int:convert i32
				(array:get (struct:get cursor bytes)
					(call select_index (borrow-mut scratch)))))))

	(fn select_index
		(params (scratch (mut-array u8)))
		(returns i32)
		(body
			(array:set scratch 0i32 1u8)
			(return 0i32)))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array:alloc u8 3i32))
			(array:set data 0i32 42u8)
			(let cursor (struct:new Cursor (bytes (borrow-shared data)) (at 0i32)))
			(let-mut scratch (array:new (array u8 1) 0u8))
			(let result (call read (borrow-mut scratch) (borrow-shared cursor)))
			(if (u8:eq (array:get scratch 0i32) 1u8) (then (return result)))
			(return 1i32))))
