(module scoped_record_second_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Pair (fields (a (shared-array u8)) (b (shared-array u8))))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let first (array.alloc u8 1i32))
			(let-mut second (array.alloc u8 1i32))
			(let pair (struct.new Pair (a (borrow-shared (local first))) (b (borrow-shared (local second)))))
			(array.store (local second) 0i32 42u8)
			(return 0i32))))
