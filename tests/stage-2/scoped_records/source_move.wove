(module scoped_record_source_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Cursor (fields (bytes (shared-array u8)) (at i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let-mut cursor (struct.new Cursor (bytes (borrow-shared (local data))) (at 0i32)))
			(let moved (move (local data)))
			(return 0i32))))
