(module scoped_blocked_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn lift (params) (returns (owned-array u8))
		(body
			(let base (array:alloc u8 2i32))
			(let view (borrow-shared base))
			(return (move base))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(return (array:len (call lift))))))
