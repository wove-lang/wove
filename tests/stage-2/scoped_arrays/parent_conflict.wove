(module scoped_parent_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut base (array:alloc u8 2i32))
			(let parent (borrow-mut base))
			(let child (borrow-shared parent))
			(array:store parent 0i32 42u8)
			(return 42i32))))
