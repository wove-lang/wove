(module reusable_array_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_one (params (output (mut-array u8)) (index i32) (byte u8)) (returns void)
		(body (array.store (local output) (local index) (local byte))))

	(fn read_pair (params (input (shared-array u8))) (returns i32)
		(body (return (i32.add (i32.from-u8 (array.load (local input) 0i32))
			(i32.from-u8 (array.load (local input) 1i32))))))

	(fn write_window
		(:expect (issues "gh:wove-lang/wove:366"))
		(params (output (mut-array u8)) (end i32)) (returns i32)
		(body
			(let window (borrow-mut (array.range (local output) 1i32 (local end))))
			(call write_one (borrow-mut (local window)) 0i32 19u8)
			(call write_one (borrow-mut (local window)) 1i32 22u8)
			(let readback (borrow-shared (local window)))
			(return (call read_pair (borrow-shared (local readback))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array.alloc u8 4i32))
			(let end (i32.add 3i32 (i32.dec (array.len (local args)))))
			(let sum (call write_window (borrow-mut (local output)) (local end)))
			(if (bool.not (i32.eq (local sum) 41i32)) (then (return 1i32)))
			(if (bool.not (u8.eq (array.load (local output) 0i32) 0u8)) (then (return 2i32)))
			(if (bool.not (u8.eq (array.load (local output) 3i32) 0u8)) (then (return 3i32)))
			(let-mut round 0i32)
			(while (i32.lt (local round) (array.len (local output)))
				(body
					(array.store (local output) 3i32 1u8)
					(let all (borrow-mut (local output)))
					(set (local round) (i32.add (local round) 1i32))
					(if (i32.eq (local round) 1i32) (then (continue)))
					(if (i32.eq (local round) 3i32) (then (break)))
					(array.store (local all) 3i32 2u8)))
			(if (bool.not (i32.eq (local round) 3i32)) (then (return 4i32)))
			(let received (move (local output)))
			(return (i32.add (local sum) (i32.from-u8 (array.load (local received) 3i32)))))))
