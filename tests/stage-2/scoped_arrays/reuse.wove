(module reusable_array_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_one (params (output (mut-array u8)) (index i32) (byte u8)) (returns void)
		(body (array:set output index byte)))

	(fn read_pair (params (input (shared-array u8))) (returns i32)
		(body (return (i32:add (i32:from-u8 (array:get input 0i32))
			(i32:from-u8 (array:get input 1i32))))))

	(fn write_window
		(:expect (issues "gh:wove-lang/wove:366"))
		(params (output (mut-array u8)) (end i32)) (returns i32)
		(body
			(let window (borrow-mut (array:range output 1i32 end)))
			(call write_one (borrow-mut window) 0i32 19u8)
			(call write_one (borrow-mut window) 1i32 22u8)
			(let readback (borrow-shared window))
			(return (call read_pair (borrow-shared readback)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array:alloc u8 4i32))
			(let end (i32:add 3i32 (i32:dec (array:len args))))
			(let sum (call write_window (borrow-mut output) end))
			(if (bool:not (i32:eq sum 41i32)) (then (return 1i32)))
			(if (bool:not (u8:eq (array:get output 0i32) 0u8)) (then (return 2i32)))
			(if (bool:not (u8:eq (array:get output 3i32) 0u8)) (then (return 3i32)))
			(let-mut round 0i32)
			(while (i32:lt round (array:len output))
				(body
					(array:set output 3i32 1u8)
					(let all (borrow-mut output))
					(set round (i32:add round 1i32))
					(if (i32:eq round 1i32) (then (continue)))
					(if (i32:eq round 3i32) (then (break)))
					(array:set all 3i32 2u8)))
			(if (bool:not (i32:eq round 3i32)) (then (return 4i32)))
			(let received (move output))
			(return (i32:add sum (i32:from-u8 (array:get received 3i32)))))))
