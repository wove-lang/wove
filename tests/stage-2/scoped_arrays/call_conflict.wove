(module scoped_call_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn pair (params (a (mut-array u8)) (b (shared-array u8))) (returns void)
		(body))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut base (array.alloc u8 2i32))
			(let view (borrow-mut (local base)))
			(call pair (borrow-mut (local view)) (borrow-shared (local view)))
			(return 42i32))))
