(module typed_array_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (byte u8)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn put (params (slots (mut-array Packet)) (byte u8)) (returns void)
		(body (array.store (local slots) 0i32 (struct.new Packet (byte (local byte))))))

	(fn fetch (params (slots (shared-array Packet))) (returns u8)
		(body (return (struct.get (array.load (local slots) 0i32) byte))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut slots (array.alloc Packet 1i32))
			(let-mut total (array.new (array i32 1) 0i32))
			(if (bool true)
				(then
					(let writable (borrow-mut (local slots)))
					(call put (borrow-mut (local writable)) 39u8)
					(let view (borrow-shared (local writable)))
					(let fixed_view (borrow-mut (local total)))
					(array.store (local fixed_view) 0i32 (i32.from.u8 (call fetch (borrow-shared (local view)))))))
			(let-mut fixed (array.new (array u8 3) 0u8 0u8 0u8))
			(if (bool true)
				(then
					(let middle (borrow-mut (array.range (local fixed) 1i32 2i32)))
					(array.store (local middle) 0i32 3u8)))
			(let shared (borrow-shared (local fixed)))
			(if (bool.not (u8.eq (array.load (local fixed) 0i32) 0u8)) (then (return 1i32)))
			(return (i32.add.wrapping (array.load (local total) 0i32)
				(i32.from.u8 (array.load (local shared) 1i32)))))))
