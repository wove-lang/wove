(module typed_array_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (byte u8)))

	(fn put (params (slots (mut-array Packet)) (byte u8)) (returns void)
		(body (array:set slots 0i32 (struct:new Packet (byte byte)))))

	(fn fetch (params (slots (shared-array Packet))) (returns u8)
		(body (return (struct:get (array:get slots 0i32) byte))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut slots (array:alloc Packet 1i32))
			(let-mut total (array:new (array i32 1) 0i32))
			(if (bool true)
				(then
					(let writable (borrow-mut slots))
					(call put (borrow-mut writable) 39u8)
					(let view (borrow-shared writable))
					(let fixed_view (borrow-mut total))
					(array:set fixed_view 0i32 (i32:from-u8 (call fetch (borrow-shared view))))))
			(let-mut fixed (array:new (array u8 3) 0u8 0u8 0u8))
			(if (bool true)
				(then
					(let full (borrow-mut fixed))
					(let middle (borrow-mut (array:range full 1i32 2i32)))
					(array:set middle 0i32 3u8)))
			(let shared (borrow-shared fixed))
			(if (bool:not (u8:eq (array:get fixed 0i32) 0u8)) (then (return 1i32)))
			(return (i32:add (array:get total 0i32)
				(i32:from-u8 (array:get shared 1i32)))))))
