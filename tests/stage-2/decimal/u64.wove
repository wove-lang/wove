(module suffixed_u64
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let maximum 00018446744073709551615u64)

	(fn main
		(params)
		(returns i32)
		(body
			(let high (u64.shl 1u64 63i32))
			(if
				(bool.not (u64.eq (local high) (u64 9223372036854775808)))
				(then (return 1i32)))
			(if
				(bool.not (u64.eq (local maximum) (u64 18446744073709551615)))
				(then (return 2i32)))
			(if
				(bool.not (u64.eq (u64.add.wrapping (local maximum) 1u64) -0u64))
				(then (return 3i32)))
			(return 42i32))))
