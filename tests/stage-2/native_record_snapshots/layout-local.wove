(module native_group_layout
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct GroupPassword (fields (present bool) (bytes (owned-array u8))))
	(struct GroupSnapshot
		(fields (gid u32) (name (owned-array u8)) (password GroupPassword)
			(members (owned-array (owned-array u8)))))
	(enum GroupResult (variants (Missing) (Found GroupSnapshot)))

	(bridge c-header "<grp.h>"
		(type Gid (c-type "gid_t"))
		(snapshot GroupSnapshot
			(c-type "struct group")
			(fields (gid gr_gid u32) (name gr_name cstr) (password gr_passwd (optional cstr))
				(members gr_mem cstrs)))
		(fn getgrgid (:pragma (c_snapshot record GroupSnapshot (lifetime thread_local)))
			(params (gid Gid)) (returns GroupResult))
		(fn missing_layout (:pragma (c_snapshot record GroupSnapshot (lifetime thread_local))) (c-name "getgrgid")
			(params (gid Gid)) (returns UndefinedLayout)))
)
