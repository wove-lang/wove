(module invalid_record_lifetime
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Value (fields (name (owned-array u8))))
	(enum Result (variants (Missing) (Present Value)))

	(use (:pragma (cfg (os "macos"))) c-header "./fixture.h" (only omitted))
	(use (:pragma (cfg (os "linux"))) c-header "./fixture.h" (only unsupported))
	(bridge c-header "./fixture.h"
		(snapshot Value (c-type "struct fixture_record") (fields (name name cstr)))
		(fn omitted (:pragma (c_snapshot record Value)) (params) (returns Result))
		(fn unsupported (:pragma (c_snapshot record Value (lifetime static))) (params) (returns Result)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
