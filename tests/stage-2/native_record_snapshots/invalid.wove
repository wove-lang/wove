(module invalid_record_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Value (fields (name (owned-array u8))))
	(enum Result (variants (Missing) (Present Value)))
	(use c-header "./fixture.h" (only native_lookup))
	(bridge c-header "./fixture.h"
		(snapshot Value (c-type "struct fixture_record")
			(fields (name name cstrs)))
		(fn native_lookup (:pragma (c_snapshot record Value (lifetime thread_local)))
			(params) (returns Result)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
