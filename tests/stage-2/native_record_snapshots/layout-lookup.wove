(module group_layout_consumer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<grp.h>" (only (type Gid) getgrgid))

	(struct GroupSnapshot (fields (local i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let local_group (struct.new GroupSnapshot (local 42i32)))
			(match (call getgrgid (int.convert Gid 0u32))
				(case Missing (return 1i32))
				(case Found (let group)
					(if (u32.not-eqz (struct.get group gid)) (then (return 2i32)))
					(let name (borrow-shared (struct.get group name)))
					(if (i32.eqz (array.len name)) (then (return 3i32)))))
			(return (struct.get local_group local))))
)
