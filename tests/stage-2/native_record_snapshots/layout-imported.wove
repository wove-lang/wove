(module native_group_import
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./layout-shared.wove" (only (type GroupSnapshot) (type (as GroupResult LookupResult))))

	(bridge c-header "<grp.h>"
		(type Gid (c-type "gid_t"))
		(snapshot GroupSnapshot
			(c-type "struct group")
			(fields (gid gr_gid u32) (name gr_name cstr) (password gr_passwd (optional cstr))
				(members gr_mem cstrs)))
		(fn getgrgid (:pragma (c_snapshot record GroupSnapshot))
			(params (gid Gid)) (returns LookupResult))
		(fn missing_layout (:pragma (c_snapshot record GroupSnapshot)) (c-name "getgrgid")
			(params (gid Gid)) (returns UndefinedLayout)))
)
