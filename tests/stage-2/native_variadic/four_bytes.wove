(module variadic_four_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./promotions.h" (only write_four))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:224"))
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let-mut first (array.alloc u8 (i32 1)))
			(let-mut second (array.alloc u8 (i32 1)))
			(let-mut third (array.alloc u8 (i32 1)))
			(let-mut fourth (array.alloc u8 (i32 1)))
			(return (call write_four
				(borrow-mut (local first)) (borrow-mut (local second))
				(borrow-mut (local third)) (borrow-mut (local fourth))
				(i32 1) (i32 42)))))
)
