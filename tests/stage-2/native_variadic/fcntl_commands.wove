(module fcntl_commands
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only open (type Mode) O_RDONLY O_NONBLOCK FD_CLOEXEC
		fcntl_getfl fcntl_getfd fcntl_setfl fcntl_dupfd_cloexec))
	(use c-header "<unistd.h>" (only close))
	(let path "tests/stage-2/native_records/data.txt")

	(fn check (params (fd i32)) (returns i32)
		(body
			(let initial (call fcntl_getfl (local fd)))
			(if (i32.lt (local initial) 0i32) (then (return 2i32)))
			(let nonblock (int.convert u32 (local O_NONBLOCK)))
			(if (u32.eq (u32.and (int.convert u32 (local initial)) (local nonblock)) 0u32)
				(then (return 3i32)))
			(if (bool.not (i32.eq (call fcntl_setfl (local fd) 0i32) 0i32))
				(then (return 4i32)))
			(let after (call fcntl_getfl (local fd)))
			(if (i32.lt (local after) 0i32) (then (return 5i32)))
			(if (bool.not (u32.eq (u32.and (int.convert u32 (local after)) (local nonblock)) 0u32))
				(then (return 6i32)))
			(let duplicate (call fcntl_dupfd_cloexec (local fd) 64i32))
			(if (i32.lt (local duplicate) 0i32) (then (return 7i32)))
			(let flags (call fcntl_getfd (local duplicate)))
			(let closed (call close (local duplicate)))
			(if (bool.or (i32.lt (local duplicate) 64i32) (i32.lt (local flags) 0i32))
				(then (return 8i32)))
			(if (bool.or (bool.not (i32.eq (local closed) 0i32))
				(u32.eq (u32.and (int.convert u32 (local flags)) (int.convert u32 (local FD_CLOEXEC))) 0u32))
				(then (return 9i32)))
			(return 42i32)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:304"))
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let flags (int.convert i32 (u32.or (int.convert u32 (local O_RDONLY)) (int.convert u32 (local O_NONBLOCK)))))
			(let fd (call open (borrow-shared (local path)) (local flags) (int.convert Mode 0i32)))
			(if (i32.lt (local fd) 0i32) (then (return 1i32)))
			(let status (call check (local fd)))
			(let closed (call close (local fd)))
			(if (bool.not (i32.eq (local closed) 0i32)) (then (return 10i32)))
			(return (local status))))
)
