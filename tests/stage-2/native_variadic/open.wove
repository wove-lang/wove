(module variadic_open
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<fcntl.h>"
		(only (type Mode) (as open create_path) (as openat create_relative) AT_FDCWD O_CREAT O_EXCL O_WRONLY))

	(fn create
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:224"))
		(params (path (shared-array u8)) (relative bool)) (returns i32)
		(body
			(let flags (int:convert i32 (u32:or (int:convert u32 O_CREAT)
				(u32:or (int:convert u32 O_EXCL) (int:convert u32 O_WRONLY)))))
			(if relative
				(then (return (call create_relative AT_FDCWD (borrow-shared path)
					flags (int:convert Mode (i32 416))))))
			(return (call create_path (borrow-shared path)
				flags (int:convert Mode (i32 384))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:lt (array:len args) 2i32) (then (return -1i32)))
			(return (call create (borrow-shared (array:get args 1i32))
				(i32:lt 2i32 (array:len args)))))))
