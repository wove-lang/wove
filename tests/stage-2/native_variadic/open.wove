(module variadic_open
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<fcntl.h>"
		(only (type Mode) (as open create_path) (as openat create_relative) AT_FDCWD O_CREAT O_EXCL O_WRONLY))
	(struct HostSpan (fields (start i32) (end i32)))

	(fn create
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:224"))
		(params (path (shared-slice u8)) (relative bool)) (returns i32)
		(body
			(let flags (int.convert i32 (u32.or (int.convert u32 (local O_CREAT))
				(u32.or (int.convert u32 (local O_EXCL)) (int.convert u32 (local O_WRONLY))))))
			(if (local relative)
				(then (return (call create_relative (local AT_FDCWD) (borrow-shared (local path))
					(local flags) (int.convert Mode (i32 416))))))
			(return (call create_path (borrow-shared (local path))
				(local flags) (int.convert Mode (i32 384))))))

	(fn main (params (bytes (shared-slice u8)) (args (shared-slice HostSpan))) (returns i32)
		(body
			(if (i32.lt (slice.len (local args)) (i32 1)) (then (return (i32 -1))))
			(let path (slice.load (local args) (i32 0)))
			(return (call create (borrow-shared (slice.range (local bytes)
				(struct.get (local path) start) (struct.get (local path) end)))
				(i32.lt (i32 1) (slice.len (local args)))))))
)
