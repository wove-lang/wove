(module fcntl_wrong_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only fcntl_dupfd_cloexec))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (call fcntl_dupfd_cloexec 0i32 64u8))))
)
