(module variadic_promotions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./promotions.h" (only (type (as Short Small)) (as test_promotions check)))
	(let message "*")

	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:224"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call check (i32 -7) (bool true) (u8 255) (int.convert Small (i32 65535))
			(u32 4294967295) (borrow-shared message)))))
)
