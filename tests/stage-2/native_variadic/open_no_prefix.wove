(module open_no_prefix
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./promotions.h"
		(fn missing_prefix (:pragma (c_variadic ...)) (params) (returns i32)))
	(use c-header "./promotions.h" (only missing_prefix))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call missing_prefix))))
)
