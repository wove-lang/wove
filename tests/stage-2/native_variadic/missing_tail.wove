(module variadic_missing_tail
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<fcntl.h>" (only open O_CREAT))
	(let path "unused")
	(fn main (params) (returns i32)
		(body (return (call open (borrow-shared (local path)) (local O_CREAT)))))
)
