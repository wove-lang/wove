(module open_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only (as printf output) (as fprintf report)
		(value stderr) (type Size) (type LongLong)))
	(let output_format "out %d %d %d %u %zu %.2f %.2f\n")
	(let error_format "err %d %.2f %lld %.2f\n")
	(let empty_format "ready %%\n\u0000ignored")

	(fn next (params (cursor (mut-ref i32))) (returns i32)
		(body (set cursor (i32:inc cursor)) (return cursor)))

	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:487"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut cursor 0i32)
			(let output_count (call output
				(borrow-shared (array:range output_format
					(i32:dec (call next (borrow-mut cursor))) (array:len output_format)))
				(u8:from-i32 (call next (borrow-mut cursor))) -7i8 (bool true)
				4294967295u32 (int:convert Size 70000u32) 1.25f32 2.50f64))
			(let error_count (call report (borrow-shared stderr) (borrow-shared error_format)
				(call next (borrow-mut cursor)) (f32:from-i32 (call next (borrow-mut cursor)))
				(int:convert LongLong -4294967297i64) 4.50f64))
			(let empty_count (call output (borrow-shared empty_format)))
			(if (bool:or (i32:ltz output_count) (i32:ltz error_count))
				(then (return 1i32)))
			(if (i32:not-eq empty_count 8i32) (then (return 2i32)))
			(if (i32:not-eq cursor 4i32) (then (return 3i32)))
			(return 42i32)))
)
