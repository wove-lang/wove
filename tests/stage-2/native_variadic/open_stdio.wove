(module open_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only (as printf output) (as fprintf report)
		(value stderr) (type Size) (type LongLong)))
	(let output_format "out %d %d %d %u %zu %.2f %.2f\n")
	(let error_format "err %d %.2f %lld %.2f\n")
	(let empty_format "ready %%\n\u0000ignored")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn next (params (cursor (mut-ref i32))) (returns i32)
		(body (set (local cursor) (i32.inc (local cursor))) (return (local cursor))))

	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:487"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut cursor 0i32)
			(let output_count (call output
				(borrow-shared (array.range (local output_format)
					(i32.dec (call next (borrow-mut (local cursor)))) (array.len (local output_format))))
				(u8.from-i32 (call next (borrow-mut (local cursor)))) -7i8 (bool true)
				4294967295u32 (int.convert Size 70000u32) 1.25f32 2.50f64))
			(let error_count (call report (borrow-shared (local stderr)) (borrow-shared (local error_format))
				(call next (borrow-mut (local cursor))) (f32.from-i32 (call next (borrow-mut (local cursor))))
				(int.convert LongLong -4294967297i64) 4.50f64))
			(let empty_count (call output (borrow-shared (local empty_format))))
			(if (bool.or (i32.ltz (local output_count)) (i32.ltz (local error_count)))
				(then (return 1i32)))
			(if (i32.not-eq (local empty_count) 8i32) (then (return 2i32)))
			(if (i32.not-eq (local cursor) 4i32) (then (return 3i32)))
			(return 42i32)))
)
