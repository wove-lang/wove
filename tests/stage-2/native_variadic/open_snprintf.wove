(module open_snprintf
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdio.h>" (only (as snprintf format_into) (type Size)))
	(let format "%d:%.1f")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut buffer (array.alloc u8 8i32))
			(array.store buffer 0i32 88u8)
			(array.store buffer 6i32 89u8)
			(array.store buffer 7i32 90u8)
			(if (i32.gtz (i32.dec (array.len args)))
				(then
					(return (call format_into (borrow-mut buffer) (int.convert Size 9u32)
						(borrow-shared format) 42i32 1.5f32))))
			(let needed (call format_into (borrow-mut buffer) (int.convert Size 0u32)
				(borrow-shared format) 42i32 1.5f32))
			(if (bool.or (i32.not-eq needed 6i32)
				(u8.not-eq (array.load buffer 0i32) 88u8)) (then (return 1i32)))
			(let written (call format_into (borrow-mut (array.range buffer 1i32 6i32))
				(int.convert Size 5u32) (borrow-shared format) 42i32 1.5f32))
			(if (i32.not-eq written 6i32) (then (return 2i32)))
			(if (bool.or (u8.not-eq (array.load buffer 0i32) 88u8)
				(bool.or (u8.not-eq (array.load buffer 6i32) 89u8)
					(u8.not-eq (array.load buffer 7i32) 90u8))) (then (return 3i32)))
			(if (bool.or (u8.not-eq (array.load buffer 1i32) 52u8)
				(bool.or (u8.not-eq (array.load buffer 2i32) 50u8)
					(bool.or (u8.not-eq (array.load buffer 3i32) 58u8)
						(bool.or (u8.not-eq (array.load buffer 4i32) 49u8)
							(u8.not-eqz (array.load buffer 5i32)))))) (then (return 4i32)))
			(return 42i32)))
)
