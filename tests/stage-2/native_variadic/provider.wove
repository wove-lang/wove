(module variadic_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./promotions.h"
		(type Short (c-type "unsigned short"))
		(fn test_promotions
			(:pragma (c_variadic flag) (c_cstr text))
			(:pragma (c_variadic flag))
			(params (fixed i32) (flag bool) (byte u8) (small Short) (wide u32) (text (shared-slice u8)))
			(returns i32))
		(fn unknown (:pragma (c_variadic missing))
			(params (fixed i32) (tail i32)) (returns i32))
		(fn empty_prefix (:pragma (c_variadic first))
			(params (first i32) (tail i32)) (returns i32))
		(fn extra (:pragma (c_variadic tail extra))
			(params (fixed i32) (tail i32)) (returns i32))
		(fn conflicting (:pragma (c_variadic tail) (c_variadic next))
			(params (fixed i32) (tail i32) (next i32)) (returns i32))
		(fn macro_after_variadic (:pragma (c_variadic tail) (c_macro))
			(params (fixed i32) (tail i32)) (returns i32))
		(fn variadic_after_macro (:pragma (c_macro) (c_variadic tail))
			(params (fixed i32) (tail i32)) (returns i32))
		(fn read_first
			(:pragma (c_bytes data count) (c_variadic expected))
			(params (data (shared-slice u8)) (count i32) (expected i32)) (returns i32))
		(fn copy_first
			(:pragma (c_bytes data count) (c_bytes target count) (c_variadic expected))
			(params (data (shared-slice u8)) (target (mut-slice u8)) (count i32) (expected i32)) (returns i32)))
)
