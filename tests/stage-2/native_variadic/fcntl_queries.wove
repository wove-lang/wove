(module fcntl_queries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only fcntl_getfd fcntl_getfl fcntl_getown fcntl_setfd FD_CLOEXEC O_ACCMODE O_RDONLY))
	(use c-header "<unistd.h>" (only pipe close))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut descriptors (array.new (array i32 2) -1i32 -1i32))
			(if (i32.not-eqz (call pipe (borrow-mut (local descriptors)))) (then (return 1i32)))
			(let reader (array.load (local descriptors) 0i32))
			(let writer (array.load (local descriptors) 1i32))
			(let first_flags (call fcntl_getfd (local reader)))
			(let status (call fcntl_getfl (local reader)))
			(let owner (call fcntl_getown (local reader)))
			(let updated (call fcntl_setfd (local reader) (local FD_CLOEXEC)))
			(let flags (call fcntl_getfd (local reader)))
			(let closed_reader (call close (local reader)))
			(let closed_writer (call close (local writer)))
			(if (bool.or (i32.ltz (local first_flags)) (i32.ltz (local status))) (then (return 2i32)))
			(if (i32.not-eq (i32.and (local status) (local O_ACCMODE)) (local O_RDONLY)) (then (return 3i32)))
			(if (i32.not-eqz (local owner)) (then (return 4i32)))
			(if (bool.or (i32.not-eqz (local updated)) (i32.not-eq (local flags) (local FD_CLOEXEC))) (then (return 5i32)))
			(if (bool.or (i32.not-eqz (local closed_reader)) (i32.not-eqz (local closed_writer))) (then (return 6i32)))
			(return 42i32)))
)
