(module fcntl_queries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<fcntl.h>" (only fcntl_getfd fcntl_getfl fcntl_getown fcntl_setfd FD_CLOEXEC O_ACCMODE O_RDONLY))
	(use c-header "<unistd.h>" (only pipe close))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut descriptors (array:new (array i32 2) -1i32 -1i32))
			(if (i32:not-eqz (call pipe (borrow-mut descriptors))) (then (return 1i32)))
			(let reader (array:get descriptors 0i32))
			(let writer (array:get descriptors 1i32))
			(let first_flags (call fcntl_getfd reader))
			(let status (call fcntl_getfl reader))
			(let owner (call fcntl_getown reader))
			(let updated (call fcntl_setfd reader FD_CLOEXEC))
			(let flags (call fcntl_getfd reader))
			(let closed_reader (call close reader))
			(let closed_writer (call close writer))
			(if (bool:or (i32:ltz first_flags) (i32:ltz status)) (then (return 2i32)))
			(if (i32:not-eq (i32:and status O_ACCMODE) O_RDONLY) (then (return 3i32)))
			(if (i32:not-eqz owner) (then (return 4i32)))
			(if (bool:or (i32:not-eqz updated) (i32:not-eq flags FD_CLOEXEC)) (then (return 5i32)))
			(if (bool:or (i32:not-eqz closed_reader) (i32:not-eqz closed_writer)) (then (return 6i32)))
			(return 42i32)))
)
