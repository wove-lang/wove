(module variadic_fixed_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./promotions.h" (only (as read_first read) copy_first))
	(let input "*")

	(fn first (params (data (shared-array u8))) (returns u8)
		(body (return (array:load data (i32 0)))))

	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:224"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let single (call read (borrow-shared input) (i32 1) (i32 42)))
			(if (bool:not (i32:eq single (i32 42))) (then (return (i32 1))))
			(let-mut target (array:alloc u8 (i32 1)))
			(let mixed (call copy_first (borrow-shared input) (borrow-mut target) (i32 1) (i32 42)))
			(if (bool:not (i32:eq mixed (i32 42))) (then (return (i32 2))))
			(return (int:convert i32 (call first (borrow-shared target))))))
)
