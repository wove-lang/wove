(module variadic_fixed_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./promotions.h" (only (as read_first read) copy_first))
	(let input "*")

	(fn first (params (data (shared-array u8))) (returns u8)
		(body (return (array.load (local data) (i32 0)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/native_variadic/cases.tsv") (issues "gh:wove-lang/wove:224"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let single (call read (borrow-shared (local input)) (i32 1) (i32 42)))
			(if (bool.not (i32.eq (local single) (i32 42))) (then (return (i32 1))))
			(let-mut target (array.alloc u8 (i32 1)))
			(let mixed (call copy_first (borrow-shared (local input)) (borrow-mut (local target)) (i32 1) (i32 42)))
			(if (bool.not (i32.eq (local mixed) (i32 42))) (then (return (i32 2))))
			(return (int.convert i32 (call first (borrow-shared (local target)))))))
)
