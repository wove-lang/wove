(module void_returns
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn empty (params) (returns void) (body))
	(fn release
		(params (early bool)) (returns void)
		(body
			(let scratch (array.alloc u8 (i32 1)))
			(if (local early) (then (return)))
			(let received (move (local scratch)))))
	(fn write_byte
		(params (data (mut-slice u8)) (early bool)) (returns void)
		(body
			(if (local early)
				(then
					(slice.store (local data) (i32 0) (u8 19))
					(return)))
			(slice.store (local data) (i32 0) (u8 42))))
	(fn read_byte
		(params (data (shared-slice u8))) (returns u8)
		(body (return (slice.load (local data) (i32 0)))))
	(fn main
		(params) (returns i32)
		(body
			(call empty)
			(call release (bool true))
			(call release (bool false))
			(let-mut data (array.alloc u8 (i32 1)))
			(call write_byte (borrow-mut (local data)) (bool true))
			(if (bool.not (u8.eq (call read_byte (borrow-shared (local data))) (u8 19)))
				(then (return (i32 1))))
			(call write_byte (borrow-mut (local data)) (bool false))
			(return (int.convert i32 (call read_byte (borrow-shared (local data))))))))
