(module void_returns
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn empty (params) (returns void) (body))
	(fn release
		(params (early bool)) (returns void)
		(body
			(let scratch (array:alloc u8 (i32 1)))
			(if early (then (return)))
			(let received (move scratch))))
	(fn write_byte
		(params (data (mut-array u8)) (early bool)) (returns void)
		(body
			(if early
				(then
					(array:store data (i32 0) (u8 19))
					(return)))
			(array:store data (i32 0) (u8 42))))
	(fn read_byte
		(params (data (shared-array u8))) (returns u8)
		(body (return (array:load data (i32 0)))))
	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(call empty)
			(call release (bool true))
			(call release (bool false))
			(let-mut data (array:alloc u8 (i32 1)))
			(call write_byte (borrow-mut data) (bool true))
			(if (bool:not (u8:eq (call read_byte (borrow-shared data)) (u8 19)))
				(then (return (i32 1))))
			(call write_byte (borrow-mut data) (bool false))
			(return (int:convert i32 (call read_byte (borrow-shared data)))))))
