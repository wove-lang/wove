(module updates
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call update (i32 42)))))
	(fn update (params (input i32)) (returns i32)
		(body
			(let original input)
			(let-mut value (call pass (i32 -4)))
			(set value (call pass (call pass original)))
			(return value)))
	(fn pass (params (value i32)) (returns i32)
		(body (return value))))
