(module updates
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params) (returns i32)
		(body (return (call update (i32 42)))))
	(fn update (params (input i32)) (returns i32)
		(body
			(let original (local input))
			(let-mut value (call pass (i32 -4)))
			(set (local value) (call pass (call pass (local original))))
			(return (local value))))
	(fn pass (params (value i32)) (returns i32)
		(body (return (local value)))))
