(module i32_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./ops.wove" (only quotient remainder))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(let count (slice.len (local argv)))
			(if (i32.eq (local count) (i32 0))
				(then (return (call quotient (i32 7) (i32 0)))))
			(if (i32.eq (local count) (i32 1))
				(then (return (call remainder (i32 7) (i32 0)))))
			(return (call quotient (i32 -2147483648) (i32 -1))))))
