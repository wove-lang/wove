(module i32_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn quotient
		(params (left i32) (right i32))
		(returns i32)
		(body (return (i32.div (local left) (local right)))))

	(fn remainder
		(params (left i32) (right i32))
		(returns i32)
		(body (return (i32.rem (local left) (local right))))))
