(module close_while_native_entry_lives
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir read_entry closedir))
	(let location ".")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared (local location))))
			(let result (call read_entry (borrow-mut (local directory))))
			(let status (call closedir (move (local directory))))
			(let entry (optional.unwrap (local result)))
			(return (int.convert i32 (struct.get (local entry) d_reclen))))))
