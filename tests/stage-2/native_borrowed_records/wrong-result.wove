(module incorrect_native_result_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir wrong_result))
	(let location ".")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared (local location))))
			(let result (call wrong_result (borrow-mut (local directory))))
			(if (optional.is-none (local result)) (then (return 1i32)))
			(return 42i32))))
