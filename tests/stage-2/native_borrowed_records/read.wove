(module read_native_directory_entries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir read_entry read_const_entry entry_reclen rewinddir closedir))
	(let location ".")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:531"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared (local location))))
			(if (owner.is-null (local directory)) (then (return 1i32)))
			(let-mut seen (bool false))
			(while (bool true)
				(body
					(let result (call read_entry (borrow-mut (local directory))))
					(if (optional.is-none (local result))
						(then
							(if (i32.gt (array.len (local args)) 0i32)
								(then
									(let absent (optional.unwrap (local result)))
									(return (int.convert i32 (struct.get (local absent) d_reclen)))))
							(break)))
					(let entry (optional.unwrap (local result)))
					(if (u16.eqz (struct.get (local entry) d_reclen)) (then (return 2i32)))
					(set (local seen) (bool true))))
			(if (bool.not (local seen)) (then (return 3i32)))
			(call rewinddir (borrow-mut (local directory)))
			(if (bool true)
				(then
					(let unrelated (call opendir (borrow-shared (local location))))
					(if (owner.is-null (local unrelated)) (then (return 4i32)))
					(let result (call read_const_entry (borrow-shared (local unrelated)) (borrow-mut (local directory))))
					(if (i32.not-eq (call closedir (move (local unrelated))) 0i32) (then (return 4i32)))
					(if (optional.is-none (local result)) (then (return 4i32)))
					(let entry (optional.unwrap (local result)))
					(let length (call entry_reclen (borrow-shared (local entry))))
					(if (bool.or (u16.eqz (local length)) (u16.not-eq (local length) (struct.get (local entry) d_reclen)))
						(then (return 5i32)))))
			(if (i32.not-eq (call closedir (move (local directory))) 0i32) (then (return 6i32)))
			(return 42i32))))
