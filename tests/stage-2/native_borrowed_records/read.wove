(module read_native_directory_entries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir read_entry read_const_entry entry_reclen rewinddir closedir))
	(let location ".")

	(fn main
		(:expect (issues "gh:wove-lang/wove:531"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(if (owner.is-null directory) (then (return 1i32)))
			(let-mut seen (bool false))
			(while (bool true)
				(body
					(let result (call read_entry (borrow-mut directory)))
					(if (optional.is-none result)
						(then
							(if (i32.gt (i32.dec (array.len args)) 0i32)
								(then
									(let absent (optional.unwrap result))
									(return (int.convert i32 (struct.get absent d_reclen)))))
							(break)))
					(let entry (optional.unwrap result))
					(if (u16.eqz (struct.get entry d_reclen)) (then (return 2i32)))
					(set seen (bool true))))
			(if (bool.not seen) (then (return 3i32)))
			(call rewinddir (borrow-mut directory))
			(if (bool true)
				(then
					(let unrelated (call opendir (borrow-shared location)))
					(if (owner.is-null unrelated) (then (return 4i32)))
					(let result (call read_const_entry (borrow-shared unrelated) (borrow-mut directory)))
					(if (i32.not-eq (call closedir (move unrelated)) 0i32) (then (return 4i32)))
					(if (optional.is-none result) (then (return 4i32)))
					(let entry (optional.unwrap result))
					(let length (call entry_reclen (borrow-shared entry)))
					(if (bool.or (u16.eqz length) (u16.not-eq length (struct.get entry d_reclen)))
						(then (return 5i32)))))
			(if (i32.not-eq (call closedir (move directory)) 0i32) (then (return 6i32)))
			(return 42i32))))
