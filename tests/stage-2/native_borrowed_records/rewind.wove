(module rewind_while_native_entry_lives
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir read_entry rewinddir))
	(let location ".")
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared (local location))))
			(let result (call read_entry (borrow-mut (local directory))))
			(call rewinddir (borrow-mut (local directory)))
			(let entry (optional.unwrap (local result)))
			(return (int.convert i32 (struct.get (local entry) d_reclen))))))
