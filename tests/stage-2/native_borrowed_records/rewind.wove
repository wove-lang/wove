(module rewind_while_native_entry_lives
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir read_entry rewinddir))
	(let location ".")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(let result (call read_entry (borrow-mut directory)))
			(call rewinddir (borrow-mut directory))
			(let entry (optional:unwrap result))
			(return (int:convert i32 (struct:get entry d_reclen))))))
