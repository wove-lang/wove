(module unknown_native_return_origin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<dirent.h>" (only opendir missing_origin))
	(let location ".")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(let result (call missing_origin (borrow-mut directory)))
			(if (optional.is-none result) (then (return 1i32)))
			(return 42i32))))
