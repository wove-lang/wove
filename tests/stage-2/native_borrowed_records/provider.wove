(module native_directory_entries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<dirent.h>"
		(type (:pragma (c_owned (drop closedir))) Directory (c-type "DIR *"))
		(struct Entry (c-type "struct dirent") (fields (d_reclen u16)))
		(fn opendir
			(:pragma (c_cstr path))
			(params (path (shared-array u8))) (returns Directory))
		(fn read_entry
			(c-name "readdir")
			(params (directory (mut-ref Directory)))
			(returns (optional (shared-ref Entry)) (from directory)))
		(fn read_const_entry
			(params (unrelated (shared-ref Directory)) (directory (mut-ref Directory)))
			(returns (optional (shared-ref Entry)) (from directory)))
		(fn missing_origin
			(c-name "readdir")
			(params (directory (mut-ref Directory)))
			(returns (optional (shared-ref Entry)) (from missing)))
		(fn shared_origin
			(c-name "readdir")
			(params (directory (shared-ref Directory)))
			(returns (optional (shared-ref Entry)) (from directory)))
		(fn wrong_result
			(c-name "telldir")
			(params (directory (mut-ref Directory)))
			(returns (optional (shared-ref Entry)) (from directory)))
		(fn rewinddir
			(params (directory (mut-ref Directory))) (returns void))
		(fn closedir
			(params (directory Directory)) (returns i32))))
