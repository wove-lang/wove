(module probe_unrelated_mutable_parameter
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<dirent.h>" (only opendir read_entry))
	(let location ".")
	(fn touch (params (other (mut-array u8))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared location)))
			(if (owner:is-null directory) (then (return 1i32)))
			(let option (call read_entry (borrow-mut directory)))
			(if (optional:is-none option) (then (return 2i32)))
			(array:store other 0i32 42u8)
			(let entry (optional:unwrap option))
			(if (u16:eqz (struct:get entry d_reclen)) (then (return 3i32)))
			(return 0i32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (array:alloc u8 1i32))
			(let checked (call touch (borrow-mut value)))
			(if (i32:not-eq checked 0i32) (then (return checked)))
			(return (int:convert i32 (array:load value 0i32))))))
