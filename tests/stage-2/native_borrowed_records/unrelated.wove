(module probe_unrelated_mutable_parameter
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<dirent.h>" (only opendir read_entry))
	(let location ".")
	(fn touch (params (other (mut-array u8))) (returns i32)
		(body
			(let-mut directory (call opendir (borrow-shared (local location))))
			(if (owner.is-null (local directory)) (then (return 1i32)))
			(let option (call read_entry (borrow-mut (local directory))))
			(if (optional.is-none (local option)) (then (return 2i32)))
			(array.store (local other) 0i32 42u8)
			(let entry (optional.unwrap (local option)))
			(if (u16.eqz (struct.get (local entry) d_reclen)) (then (return 3i32)))
			(return 0i32)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut value (array.alloc u8 1i32))
			(let checked (call touch (borrow-mut (local value))))
			(if (i32.not-eq (local checked) 0i32) (then (return (local checked))))
			(return (int.convert i32 (array.load (local value) 0i32))))))
