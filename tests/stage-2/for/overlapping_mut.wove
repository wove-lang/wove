(module for_overlapping_mut
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn update (params (storage (mut-array u8))) (returns void) (body (array.store (local storage) 0i32 1u8)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut storage (array.alloc u8 1i32))
			(let view (borrow-mut (local storage)))
			(for (bind item) (borrow-shared (local view))
				(body (call update (borrow-mut (local view)))))
			(return 42i32))))
