(module for_overlapping_mut
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn update (params (storage (mut-array u8))) (returns void) (body (array.store storage 0i32 1u8)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut storage (array.alloc u8 1i32))
			(let view (borrow-mut storage))
			(for (let item) (borrow-shared view)
				(body (call update (borrow-mut view))))
			(return 42i32))))
