(module for_overlapping_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take (params) (returns (owned-array u8))
		(body
			(let storage (array:alloc u8 1i32))
			(for (let item) (borrow-shared storage)
				(body (return (move storage))))
			(return (move storage))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32))))
