(module for_overlapping_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn take (params) (returns (owned-array u8))
		(body
			(let storage (array.alloc u8 1i32))
			(for (bind item) (borrow-shared (local storage))
				(body (return (move (local storage)))))
			(return (move (local storage)))))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 42i32))))
