(module for_ranges
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn lower (params (state (mut-array u8))) (returns i32)
		(body
			(if (u8.eq (array.load (local state) 0i32) 0u8)
				(then (array.store (local state) 0i32 1u8))
				(else (array.store (local state) 0i32 99u8)))
			(return -1i32)))

	(fn upper (params (state (mut-array u8))) (returns i32)
		(body
			(if (u8.eq (array.load (local state) 0i32) 1u8)
				(then (array.store (local state) 0i32 2u8))
				(else (array.store (local state) 0i32 99u8)))
			(return 2i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut state (array.alloc u8 1i32))
			(let-mut sum 0i32)
			(for (bind cursor) (range (call lower (borrow-mut (local state))) (call upper (borrow-mut (local state))))
				(body
					(let allocation (array.alloc u8 1i32))
					(if (i32.eq (local cursor) 0i32) (then (continue)))
					(set (local sum) (i32.add (local sum) (i32.add (local cursor) 1i32)))
					(set (local sum) (i32.add (local sum) (array.len (local allocation))))))
			(if (bool.not (u8.eq (array.load (local state) 0i32) 2u8)) (then (return 1i32)))
			(for (bind empty) (range 3i32 3i32) (body (return 2i32)))
			(for (bind reversed) (range 7i32 3i32) (body (return 3i32)))
			(for (bind large) (range 18446744073709551613u64 18446744073709551615u64)
				(body
					(if (u64.eq (local large) 18446744073709551615u64) (then (return 4i32)))
					(set (local sum) (i32.add (local sum) 19i32))))
			(return (local sum)))))
