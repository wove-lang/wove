(module for_overlapping_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut storage (array.alloc u8 1i32))
			(for (bind item) (borrow-shared (local storage))
				(body (array.store (local storage) 0i32 (local item))))
			(return 42i32))))
