(module for_exclusive_source_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array.alloc u8 1i32))
			(for (bind item) (borrow-mut (local output))
				(body (set (local item) (array.load (local output) 0i32))))
			(return 42i32))))
