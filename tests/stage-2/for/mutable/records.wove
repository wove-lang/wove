(module for_mutable_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Packet (fields (tag u8) (value i32)))

	(fn bump (params (packet (mut-ref Packet))) (returns void)
		(body (set (struct.get (local packet) value) (i32.add.wrapping (struct.get (local packet) value) 19i32))))

	(fn update_first (params (packets (mut-array Packet))) (returns i32)
		(body
			(for (bind packet) (borrow-mut (local packets))
				(body
					(let scratch (array.alloc u8 1i32))
					(set (local packet) (struct.new Packet (tag 0u8) (value 23i32)))
					(set (struct.get (local packet) tag) (u8.from.i32 (array.len (local scratch))))
					(call bump (borrow-mut (local packet)))
					(let copy (local packet))
					(return (struct.get (local copy) value))))
			(return -1i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut packets (array.alloc Packet 2i32))
			(let total (call update_first (borrow-mut (local packets))))
			(let updated (array.load (local packets) 0i32))
			(if (bool.not (i32.eq (struct.get (local updated) value) (local total))) (then (return 1i32)))
			(if (bool.not (u8.eq (struct.get (local updated) tag) 1u8)) (then (return 2i32)))
			(if (bool.not (i32.eq (struct.get (array.load (local packets) 1i32) value) 0i32)) (then (return 3i32)))
			(let-mut fixed (array.new (array i32 2) 0i32 0i32))
			(for (bind index word) (borrow-mut (local fixed))
				(body (set (local word) (i32.add.wrapping (local index) (local total)))))
			(if (bool.not (i32.eq (array.load (local fixed) 1i32) 43i32)) (then (return 4i32)))
			(return (array.load (local fixed) 0i32)))))
