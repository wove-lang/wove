(module for_mutable_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (tag u8) (value i32)))

	(fn bump (params (packet (mut-ref Packet))) (returns void)
		(body (set (struct:get packet value) (i32:add (struct:get packet value) 19i32))))

	(fn update_first (params (packets (mut-array Packet))) (returns i32)
		(body
			(for (let packet) (borrow-mut packets)
				(body
					(let scratch (array:alloc u8 1i32))
					(set packet (struct:new Packet (tag 0u8) (value 23i32)))
					(set (struct:get packet tag) (u8:from-i32 (array:len scratch)))
					(call bump (borrow-mut packet))
					(let copy packet)
					(return (struct:get copy value))))
			(return -1i32)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut packets (array:alloc Packet 2i32))
			(let total (call update_first (borrow-mut packets)))
			(let updated (array:load packets 0i32))
			(if (bool:not (i32:eq (struct:get updated value) total)) (then (return 1i32)))
			(if (bool:not (u8:eq (struct:get updated tag) 1u8)) (then (return 2i32)))
			(if (bool:not (i32:eq (struct:get (array:load packets 1i32) value) 0i32)) (then (return 3i32)))
			(let-mut fixed (array:new (array i32 2) 0i32 0i32))
			(for (let index word) (borrow-mut fixed)
				(body (set word (i32:add index total))))
			(if (bool:not (i32:eq (array:load fixed 1i32) 43i32)) (then (return 4i32)))
			(return (array:load fixed 0i32)))))
