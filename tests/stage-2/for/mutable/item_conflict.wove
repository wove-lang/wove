(module for_exclusive_item_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (value i32)))
	(fn update (params (slot (mut-ref Packet)) (copy Packet)) (returns void) (body))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut packets (array.alloc Packet 1i32))
			(for (bind item) (borrow-mut (local packets))
				(body (call update (borrow-mut (local item)) (local item))))
			(return 42i32))))
