(module for_exclusive_parent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn observe (params (data (shared-array u8))) (returns void) (body))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut output (array.alloc u8 2i32))
			(let window (borrow-mut (array.range (local output) 0i32 1i32)))
			(for (bind item) (borrow-mut (local window))
				(body (call observe (borrow-shared (local window)))))
			(return 42i32))))
