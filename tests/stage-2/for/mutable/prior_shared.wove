(module for_prior_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array.alloc u8 1i32))
			(let view (borrow-shared (local output)))
			(for (bind item) (borrow-mut (local output)) (body (set (local item) 42u8)))
			(return 42i32))))
