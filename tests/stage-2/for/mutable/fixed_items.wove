(module for_mutable_fixed_items
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_tail (params (row (mut-array u8))) (returns void)
		(body (array:store row 1i32 23u8)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc (array u8 2) 1i32))
			(for (let row) (borrow-mut rows)
				(body
					(array:store row 0i32 19u8)
					(if (bool:not (u8:eq (array:load row 0i32) 19u8)) (then (return 1i32)))
					(call write_tail (borrow-mut row))))
			(let row (array:load rows 0i32))
			(return (i32:add (i32:from-u8 (array:load row 0i32))
				(i32:from-u8 (array:load row 1i32)))))))
