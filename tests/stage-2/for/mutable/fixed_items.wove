(module for_mutable_fixed_items
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write_tail (params (row (mut-array u8))) (returns void)
		(body (array.store (local row) 1i32 23u8)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc (array u8 2) 1i32))
			(for (bind row) (borrow-mut (local rows))
				(body
					(array.store (local row) 0i32 19u8)
					(if (bool.not (u8.eq (array.load (local row) 0i32) 19u8)) (then (return 1i32)))
					(call write_tail (borrow-mut (local row)))))
			(let row (array.load (local rows) 0i32))
			(return (i32.add (i32.from-u8 (array.load (local row) 0i32))
				(i32.from-u8 (array.load (local row) 1i32)))))))
