(module for_mutable_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn fill_run
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (output (mut-array u8)) (start i32) (end i32) (value u8)) (returns void)
		(body
			(let bytes (borrow-mut (array.range (local output) (local start) (local end))))
			(for (bind byte) (borrow-mut (local bytes))
				(body (set (local byte) (local value))))
			(array.store (local bytes) 0i32 (local value))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array.alloc u8 6i32))
			(array.store (local output) 0i32 3u8)
			(call fill_run (borrow-mut (local output)) 1i32 4i32 42u8)
			(if (bool.not (u8.eq (array.load (local output) 3i32) 42u8)) (then (return 1i32)))
			(let end (i32.add 5i32 (i32.dec (array.len (local args)))))
			(for (bind index byte) (borrow-mut (array.range (local output) 2i32 (local end)))
				(body
					(let temporary (array.alloc u8 1i32))
					(if (i32.eq (local index) 0i32)
						(then
							(set (local byte) 7u8)
							(continue)))
					(if (i32.eq (local index) 2i32) (then (break)))
					(if (bool.not (u8.eq (local byte) 42u8)) (then (return 2i32)))
					(set (local byte) (u8.from-i32 (i32.add 8i32 (array.len (local temporary)))))))
			(array.store (local output) 5i32 11u8)
			(if (bool.not (u8.eq (array.load (local output) 0i32) 3u8)) (then (return 3i32)))
			(if (bool.not (u8.eq (array.load (local output) 2i32) 7u8)) (then (return 4i32)))
			(if (bool.not (u8.eq (array.load (local output) 3i32) 9u8)) (then (return 5i32)))
			(if (bool.not (u8.eq (array.load (local output) 4i32) 0u8)) (then (return 6i32)))
			(if (bool.not (u8.eq (array.load (local output) 5i32) 11u8)) (then (return 7i32)))
			(return (i32.from-u8 (array.load (local output) 1i32))))))
