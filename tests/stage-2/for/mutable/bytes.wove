(module for_mutable_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn fill_run
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (output (mut-array u8)) (start i32) (end i32) (value u8)) (returns void)
		(body
			(let bytes (borrow-mut (array:range output start end)))
			(for (let byte) (borrow-mut bytes)
				(body (set byte value)))
			(array:store bytes 0i32 value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut output (array:alloc u8 6i32))
			(array:store output 0i32 3u8)
			(call fill_run (borrow-mut output) 1i32 4i32 42u8)
			(if (bool:not (u8:eq (array:load output 3i32) 42u8)) (then (return 1i32)))
			(let end (i32:add 5i32 (i32:dec (array:len args))))
			(for (let index byte) (borrow-mut (array:range output 2i32 end))
				(body
					(let temporary (array:alloc u8 1i32))
					(if (i32:eq index 0i32)
						(then
							(set byte 7u8)
							(continue)))
					(if (i32:eq index 2i32) (then (break)))
					(if (bool:not (u8:eq byte 42u8)) (then (return 2i32)))
					(set byte (u8:from-i32 (i32:add 8i32 (array:len temporary))))))
			(array:store output 5i32 11u8)
			(if (bool:not (u8:eq (array:load output 0i32) 3u8)) (then (return 3i32)))
			(if (bool:not (u8:eq (array:load output 2i32) 7u8)) (then (return 4i32)))
			(if (bool:not (u8:eq (array:load output 3i32) 9u8)) (then (return 5i32)))
			(if (bool:not (u8:eq (array:load output 4i32) 0u8)) (then (return 6i32)))
			(if (bool:not (u8:eq (array:load output 5i32) 11u8)) (then (return 7i32)))
			(return (i32:from-u8 (array:load output 1i32))))))
