(module for_static
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let text "a*b")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut count 0i32)
			(for (let byte) (borrow-shared text)
				(body (set count (i32:add count (i32:from-u8 byte)))))
			(if (bool:not (i32:eq count 237i32)) (then (return 1i32)))
			(let-mut result 0i32)
			(for (let index byte) (borrow-shared (array:range text 1i32 2i32))
				(body (set result (i32:add index (i32:from-u8 byte)))))
			(return result))))
