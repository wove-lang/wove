(module for_static
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let text "a*b")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut count 0i32)
			(for (bind byte) (borrow-shared (local text))
				(body (set (local count) (i32.add (local count) (i32.from-u8 (local byte))))))
			(if (bool.not (i32.eq (local count) 237i32)) (then (return 1i32)))
			(let-mut result 0i32)
			(for (bind index byte) (borrow-shared (array.range (local text) 1i32 2i32))
				(body (set (local result) (i32.add (local index) (i32.from-u8 (local byte))))))
			(return (local result)))))
