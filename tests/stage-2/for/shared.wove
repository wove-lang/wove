(module for_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Packet (fields (value i32)))

	(fn find_packet (params (packets (shared-array Packet))) (returns i32)
		(body
			(for (bind packet) (borrow-shared (local packets))
				(body
					(let scratch (array.alloc u8 1i32))
					(if (i32.eq (struct.get (local packet) value) 19i32)
						(then (return (i32.add.wrapping (struct.get (local packet) value) (array.len (local scratch))))))))
			(return -1i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut packets (array.alloc Packet 2i32))
			(array.store (local packets) 1i32 (struct.new Packet (value 19i32)))
			(let found (call find_packet (borrow-shared (local packets))))
			(if (bool.not (i32.eq (local found) 20i32)) (then (return 1i32)))
			(let-mut storage (array.alloc u8 4i32))
			(array.store (local storage) 0i32 99u8)
			(array.store (local storage) 1i32 9u8)
			(array.store (local storage) 2i32 12u8)
			(let-mut seen 0i32)
			(let-mut total (local found))
			(let stop (i32.add.wrapping 4i32 (array.len (local args))))
			(for (bind index byte) (borrow-shared (array.range (local storage) 1i32 (local stop)))
				(body
					(let scratch (array.alloc u8 1i32))
					(if (bool.not (i32.eq (local index) (local seen))) (then (return 2i32)))
					(if (bool.not (u8.eq (array.load (local storage) 0i32) 99u8)) (then (return 3i32)))
					(set (local seen) (i32.add.wrapping (local seen) (array.len (local scratch))))
					(set (local total) (i32.add.wrapping (local total) (i32.from.u8 (local byte))))
					(if (i32.eq (local index) 1i32) (then (break)))))
			(array.store (local storage) 2i32 1u8)
			(for (bind empty) (borrow-shared (array.range (local storage) 4i32 4i32)) (body (return 4i32)))
			(let fixed (array.new (array i32 1) (i32.from.u8 (array.load (local storage) 2i32))))
			(for (bind number) (borrow-shared (local fixed)) (body (set (local total) (i32.add.wrapping (local total) (local number)))))
			(return (local total)))))
