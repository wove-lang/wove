(module for_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (value i32)))

	(fn find_packet (params (packets (shared-array Packet))) (returns i32)
		(body
			(for (let packet) (borrow-shared packets)
				(body
					(let scratch (array:alloc u8 1i32))
					(if (i32:eq (struct:get packet value) 19i32)
						(then (return (i32:add (struct:get packet value) (array:len scratch)))))))
			(return -1i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut packets (array:alloc Packet 2i32))
			(array:store packets 1i32 (struct:new Packet (value 19i32)))
			(let found (call find_packet (borrow-shared packets)))
			(if (bool:not (i32:eq found 20i32)) (then (return 1i32)))
			(let-mut storage (array:alloc u8 4i32))
			(array:store storage 0i32 99u8)
			(array:store storage 1i32 9u8)
			(array:store storage 2i32 12u8)
			(let-mut seen 0i32)
			(let-mut total found)
			(let stop (i32:add 4i32 (i32:dec (array:len args))))
			(for (let index byte) (borrow-shared (array:range storage 1i32 stop))
				(body
					(let scratch (array:alloc u8 1i32))
					(if (bool:not (i32:eq index seen)) (then (return 2i32)))
					(if (bool:not (u8:eq (array:load storage 0i32) 99u8)) (then (return 3i32)))
					(set seen (i32:add seen (array:len scratch)))
					(set total (i32:add total (i32:from-u8 byte)))
					(if (i32:eq index 1i32) (then (break)))))
			(array:store storage 2i32 1u8)
			(for (let empty) (borrow-shared (array:range storage 4i32 4i32)) (body (return 4i32)))
			(let fixed (array:new (array i32 1) (i32:from-u8 (array:load storage 2i32))))
			(for (let number) (borrow-shared fixed) (body (set total (i32:add total number))))
			(return total))))
