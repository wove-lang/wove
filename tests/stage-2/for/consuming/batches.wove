(module consuming_checksum_batch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn byte_row
		(params (value u8))
		(returns (owned-array u8))
		(body
			(let-mut row (array:alloc u8 1i32))
			(array:store row 0i32 value)
			(return (move row))))

	(fn batch
		(params)
		(returns (owned-array (owned-array u8)))
		(body
			(let-mut rows (array:alloc (owned-array u8) 3i32))
			(array:store rows 0i32 (call byte_row 11u8))
			(array:store rows 1i32 (call byte_row 13u8))
			(array:store rows 2i32 (call byte_row 18u8))
			(return (move rows))))

	(fn first
		(params (row (shared-array u8)))
		(returns i32)
		(body (return (int:convert i32 (array:load row 0i32)))))

	(fn checksum
		(params)
		(returns i32)
		(body
			(let rows (call batch))
			(let-mut sum 0i32)
			(let-mut count 0i32)
			(for (let index item) (move rows)
				(body
					(if (bool:not (i32:eq index count)) (then (return 1i32)))
					(let current (move item))
					(set sum (i32:add sum (call first (borrow-shared current))))
					(set count (i32:add count 1i32))))
			(return sum)))

	(fn check_exits
		(params)
		(returns bool)
		(body
			(let-mut saved (array:alloc (owned-array u8) 0i32))
			(let rows (call batch))
			(for (let index item) (move rows)
				(body
					(if (i32:eq index 0i32) (then (continue)))
					(array:push saved (move item))
					(break)))
			(return (bool:and
				(i32:eq (array:len saved) 1i32)
				(i32:eq (call first (borrow-shared (array:load saved 0i32))) 13i32)))))

	(fn early_value
		(params)
		(returns i32)
		(body
			(let rows (call batch))
			(for (let item) (move rows)
				(body (return (call first (borrow-shared item)))))
			(return 0i32)))

	(fn take_first
		(params)
		(returns (owned-array u8))
		(body
			(let rows (call batch))
			(for (let item) (move rows)
				(body (return (move item))))
			(return (array:alloc u8 0i32))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:not (i32:eq (call checksum) 42i32)) (then (return 2i32)))
			(if (bool:not (call check_exits)) (then (return 3i32)))
			(if (bool:not (i32:eq (call early_value) 11i32)) (then (return 4i32)))
			(let row (call take_first))
			(if (bool:not (i32:eq (call first (borrow-shared row)) 11i32)) (then (return 5i32)))
			(return 42i32))))
