(module consuming_checksum_batch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn byte_row
		(params (value u8))
		(returns (owned-array u8))
		(body
			(let-mut row (array.alloc u8 1i32))
			(array.store (local row) 0i32 (local value))
			(return (move (local row)))))

	(fn batch
		(params)
		(returns (owned-array (owned-array u8)))
		(body
			(let-mut rows (array.alloc (owned-array u8) 3i32))
			(array.store (local rows) 0i32 (call byte_row 11u8))
			(array.store (local rows) 1i32 (call byte_row 13u8))
			(array.store (local rows) 2i32 (call byte_row 18u8))
			(return (move (local rows)))))

	(fn first
		(params (row (shared-array u8)))
		(returns i32)
		(body (return (int.convert i32 (array.load (local row) 0i32)))))

	(fn checksum
		(params)
		(returns i32)
		(body
			(let rows (call batch))
			(let-mut sum 0i32)
			(let-mut count 0i32)
			(for (bind index item) (move (local rows))
				(body
					(if (bool.not (i32.eq (local index) (local count))) (then (return 1i32)))
					(let current (move (local item)))
					(set (local sum) (i32.add (local sum) (call first (borrow-shared (local current)))))
					(set (local count) (i32.add (local count) 1i32))))
			(return (local sum))))

	(fn check_exits
		(params)
		(returns bool)
		(body
			(let-mut saved (array.alloc (owned-array u8) 0i32))
			(let rows (call batch))
			(for (bind index item) (move (local rows))
				(body
					(if (i32.eq (local index) 0i32) (then (continue)))
					(array.push (local saved) (move (local item)))
					(break)))
			(return (bool.and
				(i32.eq (array.len (local saved)) 1i32)
				(i32.eq (call first (borrow-shared (array.load (local saved) 0i32))) 13i32)))))

	(fn early_value
		(params)
		(returns i32)
		(body
			(let rows (call batch))
			(for (bind item) (move (local rows))
				(body (return (call first (borrow-shared (local item))))))
			(return 0i32)))

	(fn take_first
		(params)
		(returns (owned-array u8))
		(body
			(let rows (call batch))
			(for (bind item) (move (local rows))
				(body (return (move (local item)))))
			(return (array.alloc u8 0i32))))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(:expect (issues "gh:wove-lang/wove:374"))
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(if (bool.not (i32.eq (call checksum) 42i32)) (then (return 2i32)))
			(if (bool.not (call check_exits)) (then (return 3i32)))
			(if (bool.not (i32.eq (call early_value) 11i32)) (then (return 4i32)))
			(let row (call take_first))
			(if (bool.not (i32.eq (call first (borrow-shared (local row))) 11i32)) (then (return 5i32)))
			(return 42i32))))
