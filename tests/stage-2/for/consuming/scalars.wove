(module consuming_scalars
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let empty (array.alloc i32 0i32))
			(for (let item) (move empty)
				(body (return 1i32)))
			(let-mut values (array.alloc i32 2i32))
			(array.store values 0i32 17i32)
			(array.store values 1i32 25i32)
			(let-mut total 0i32)
			(for (let item) (move values)
				(body (set total (i32.add total item))))
			(return total))))
