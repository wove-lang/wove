(module consuming_scalars
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let empty (array.alloc i32 0i32))
			(for (bind item) (move (local empty))
				(body (return 1i32)))
			(let-mut values (array.alloc i32 2i32))
			(array.store (local values) 0i32 17i32)
			(array.store (local values) 1i32 25i32)
			(let-mut total 0i32)
			(for (bind item) (move (local values))
				(body (set (local total) (i32.add.wrapping (local total) (local item)))))
			(return (local total)))))
