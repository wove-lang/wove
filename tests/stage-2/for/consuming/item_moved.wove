(module consuming_item_moved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 1i32))
			(let row (array:alloc u8 1i32))
			(array:store rows 0i32 (move row))
			(for (let item) (move rows)
				(body
					(let taken (move item))
					(return (array:len item))))
			(return 0i32))))
