(module consuming_item_moved
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 1i32))
			(let row (array.alloc u8 1i32))
			(array.store (local rows) 0i32 (move (local row)))
			(for (bind item) (move (local rows))
				(body
					(let taken (move (local item)))
					(return (array.len (local item)))))
			(return 0i32))))
