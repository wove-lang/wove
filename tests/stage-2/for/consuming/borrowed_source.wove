(module consuming_borrowed_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let bytes (array.alloc u8 0i32))
			(let view (borrow-shared bytes))
			(for (let item) (move bytes)
				(body))
			(return (array.len view)))))
