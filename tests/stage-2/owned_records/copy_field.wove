(module copy_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let cells (array:alloc u8 1i32))
			(let grid (struct:new Grid (cells cells)))
			(return 0i32)))
)
