(module nested_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Outer (fields (middle Middle)))
	(struct Middle (fields (left Leaf) (right Leaf)))
	(struct Leaf (fields (primary (owned-array i32)) (spare (owned-array i32))))

	(fn make_array (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut values (array:alloc i32 1i32))
			(array:store values 0i32 value)
			(return (move values))))

	(fn make_leaf (params (primary i32) (spare i32)) (returns Leaf)
		(body
			(return (struct:new Leaf
				(primary (call make_array primary))
				(spare (call make_array spare))))))

	(fn make_outer (params) (returns Outer)
		(body
			(let left (call make_leaf 3i32 7i32))
			(return (struct:new Outer
				(middle (struct:new Middle (left (move left)) (right (call make_leaf 11i32 19i32))))))))

	(fn write_first (params (values (mut-array i32))) (returns void)
		(body
			(array:store values 0i32 5i32)))

	(fn paint (params (outer (mut-ref Outer))) (returns void)
		(body
			(call write_first
				(borrow-mut (struct:get (struct:get (struct:get outer middle) left) primary)))))

	(fn first (params (values (shared-array i32))) (returns i32)
		(body (return (array:load values 0i32))))

	(fn leaf_total (params (leaf (shared-ref Leaf))) (returns i32)
		(body
			(let primary (call first (borrow-shared (struct:get leaf primary))))
			(let spare (call first (borrow-shared (struct:get leaf spare))))
			(return (i32:add primary spare))))

	(fn exercise (params (whole bool)) (returns i32)
		(body
			(let-mut outer (call make_outer))
			(call paint (borrow-mut outer))
			(if whole
				(then
					(let left (move (struct:get (struct:get outer middle) left)))
					(let kept (call leaf_total (borrow-shared left)))
					(let sibling (call leaf_total
						(borrow-shared (struct:get (struct:get outer middle) right))))
					(return (i32:add kept sibling))))
			(let primary (move (struct:get (struct:get (struct:get outer middle) left) primary)))
			(let kept (call first (borrow-shared primary)))
			(let spare (call first
				(borrow-shared (struct:get (struct:get (struct:get outer middle) left) spare))))
			(let sibling (call leaf_total
				(borrow-shared (struct:get (struct:get outer middle) right))))
			(return (i32:add (i32:add kept spare) sibling))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let whole (call exercise (bool true)))
			(let leaf (call exercise (bool false)))
			(if (i32:not-eq whole 42i32) (then (return 1i32)))
			(return leaf))))
