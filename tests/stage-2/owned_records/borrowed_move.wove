(module borrowed_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(fn take
		(params (ref (mut-ref Grid))) (returns (owned-array u8))
		(body (return (move (struct.get (local ref) cells)))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(let bytes (call take (borrow-mut (local grid))))
			(return (array.len (local bytes)))))
)
