(module field_reuse
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(fn length
		(params (view (shared-array u8))) (returns i32)
		(body (return (array.len view))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(if (i32.lt 0i32 (i32.dec (array.len spans)))
				(then (let cells (move (struct.get grid cells)))))
			(return (call length (borrow-shared (struct.get grid cells))))))
)
