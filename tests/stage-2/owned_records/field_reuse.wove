(module field_reuse
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn length
		(params (view (shared-array u8))) (returns i32)
		(body (return (array.len (local view)))))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(if (i32.lt 0i32 (array.len (local spans)))
				(then (let cells (move (struct.get (local grid) cells)))))
			(return (call length (borrow-shared (struct.get (local grid) cells))))))
)
