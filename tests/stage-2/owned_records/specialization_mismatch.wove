(module owning_specialization_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./specialization_types.wove" (only (type Holder) head))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let pair (struct.new (specialize Holder (owned-array u32))
				(taken (array.alloc u32 1i32)) (kept (array.alloc u32 1i32))))
			(return (call head (borrow-shared (local pair))))))
)
