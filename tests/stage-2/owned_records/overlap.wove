(module overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn combine
		(params (left (mut-array u8)) (right (shared-array u8))) (returns i32)
		(body (return (array.len (local right)))))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let-mut grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(return (call combine (borrow-mut (struct.get (local grid) cells))
				(borrow-shared (struct.get (local grid) cells))))))
)
