(module owning_specialization_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./specialization_types.wove" (only pair))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let owner (call pair))
			(let view (borrow-shared (struct.get owner taken)))
			(let taken (move (struct.get owner taken)))
			(return (array.len view))))
)
