(module owning_specialization_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./specialization_types.wove" (only pair))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let owner (call pair))
			(let view (borrow-shared (struct.get (local owner) taken)))
			(let taken (move (struct.get (local owner) taken)))
			(return (array.len (local view)))))
)
