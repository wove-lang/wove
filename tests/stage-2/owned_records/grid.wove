(module owned_grid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Grid (fields (cells (owned-array u8)) (width i32) (scratch (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn make
		(params (width i32))
		(returns Grid)
		(body
			(let cells (array.alloc u8 (local width)))
			(return (struct.new Grid
				(cells (move (local cells)))
				(width (local width))
				(scratch (array.alloc u8 1i32))))))

	(fn transfer
		(params (width i32))
		(returns Grid)
		(body
			(let first (call make (local width)))
			(let last (move (local first)))
			(return (move (local last)))))

	(fn write_first
		(params (bytes (mut-array u8)) (value u8))
		(returns void)
		(body (array.store (local bytes) 0i32 (local value))))

	(fn read_first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array.load (local bytes) 0i32))))

	(fn paint
		(params (grid (mut-ref Grid)))
		(returns void)
		(body
			(call write_first (borrow-mut (struct.get (local grid) cells)) 37u8)
			(call write_first (borrow-mut (struct.get (local grid) scratch)) 5u8)))

	(fn check_width
		(params (grid (shared-ref Grid)))
		(returns bool)
		(body
			(return (i32.eq (struct.get (local grid) width) 3i32))))

	(fn exercise
		(params (peel bool))
		(returns i32)
		(body
			(let-mut grid (call transfer 3i32))
			(call paint (borrow-mut (local grid)))
			(if (bool.not (call check_width (borrow-shared (local grid))))
				(then (return 1i32)))
			(if (local peel)
				(then
					(let cells (move (struct.get (local grid) cells)))
					(let cell (call read_first (borrow-shared (local cells))))
					(let work (call read_first (borrow-shared (struct.get (local grid) scratch))))
					(let width (struct.get (local grid) width))
					(if (bool.and (i32.eq (local width) 3i32)
						(bool.and (u8.eq (local cell) 37u8) (u8.eq (local work) 5u8)))
						(then (return 42i32)))
					(return 2i32)))
			(let cell (call read_first (borrow-shared (struct.get (local grid) cells))))
			(if (u8.eq (local cell) 37u8) (then (return 42i32)))
			(return 3i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let intact (call exercise (bool false)))
			(let peeled (call exercise (bool true)))
			(if (bool.and (i32.eq (local intact) 42i32) (i32.eq (local peeled) 42i32))
				(then (return 42i32)))
			(return 4i32))))
