(module owned_grid
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Grid (fields (cells (owned-array u8)) (width i32) (scratch (owned-array u8))))

	(fn make
		(params (width i32))
		(returns Grid)
		(body
			(let cells (array:alloc u8 width))
			(return (struct:new Grid
				(cells (move cells))
				(width width)
				(scratch (array:alloc u8 1i32))))))

	(fn transfer
		(params (width i32))
		(returns Grid)
		(body
			(let first (call make width))
			(let last (move first))
			(return (move last))))

	(fn write_first
		(params (bytes (mut-array u8)) (value u8))
		(returns void)
		(body (array:store bytes 0i32 value)))

	(fn read_first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array:load bytes 0i32))))

	(fn paint
		(params (grid (mut-ref Grid)))
		(returns void)
		(body
			(call write_first (borrow-mut (struct:get grid cells)) 37u8)
			(call write_first (borrow-mut (struct:get grid scratch)) 5u8)))

	(fn check_width
		(params (grid (shared-ref Grid)))
		(returns bool)
		(body
			(return (i32:eq (struct:get grid width) 3i32))))

	(fn exercise
		(params (peel bool))
		(returns i32)
		(body
			(let-mut grid (call transfer 3i32))
			(call paint (borrow-mut grid))
			(if (bool:not (call check_width (borrow-shared grid)))
				(then (return 1i32)))
			(if peel
				(then
					(let cells (move (struct:get grid cells)))
					(let cell (call read_first (borrow-shared cells)))
					(let work (call read_first (borrow-shared (struct:get grid scratch))))
					(let width (struct:get grid width))
					(if (bool:and (i32:eq width 3i32)
						(bool:and (u8:eq cell 37u8) (u8:eq work 5u8)))
						(then (return 42i32)))
					(return 2i32)))
			(let cell (call read_first (borrow-shared (struct:get grid cells))))
			(if (u8:eq cell 37u8) (then (return 42i32)))
			(return 3i32)))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let intact (call exercise (bool false)))
			(let peeled (call exercise (bool true)))
			(if (bool:and (i32:eq intact 42i32) (i32:eq peeled 42i32))
				(then (return 42i32)))
			(return 4i32))))
