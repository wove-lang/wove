(module owning_record_formal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type (as Packet Incoming)) make_packet))

	(fn discard (params (packet Incoming) (early bool)) (returns void)
		(body
			(if early (then (return)))))

	(fn forward (params (packet Incoming)) (returns Incoming)
		(body (return (move packet))))

	(fn read_first (params (data (shared-array i32))) (returns i32)
		(body (return (array:get data 0i32))))

	(fn consume (params (packet Incoming)) (returns i32)
		(body
			(let first (call read_first
				(borrow-shared (struct:get (struct:get packet nested) values))))
			(let values (move (struct:get (struct:get packet nested) values)))
			(return (i32:add first (i32:dec (array:len values))))))

	(fn relay (params (packet Incoming)) (returns i32)
		(body (return (call consume (move packet)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let packet (call make_packet 1i32))
			(call discard (move packet) (bool true))
			(call discard (call make_packet 2i32) (bool false))
			(let owned (call make_packet 42i32))
			(let forwarded (call forward (move owned)))
			(return (call relay (move forwarded))))))
