(module specialized_formal_partial
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct Rack (generic (type T)) (fields (rows (array T 2))))

	(fn row (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut data (array.alloc i32 1i32))
			(array.store (local data) 0i32 (local value))
			(return (move (local data)))))

	(fn first (params (data (shared-array i32))) (returns i32)
		(body (return (array.load (local data) 0i32))))

	(fn accept (params (rack (specialize Rack (owned-array i32))) (later i32)) (returns i32)
		(body
			(return (i32.add (local later)
				(call first (borrow-shared (array.load (struct.get (local rack) rows) 0i32)))))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rack (struct.new (specialize Rack (owned-array i32))
				(rows (array.new (array (owned-array i32) 2) (call row 7i32) (call row 0i32)))))
			(let removed (move (array.load (struct.get (local rack) rows) 0i32)))
			(let-mut divisor 0i32)
			(if (i32.gtz (array.len (local args)))
				(then
					(array.store (struct.get (local rack) rows) 0i32 (call row 41i32))
					(set (local divisor) 1i32)))
			(return (call accept (move (local rack)) (i32.div 1i32 (local divisor))))))
)
