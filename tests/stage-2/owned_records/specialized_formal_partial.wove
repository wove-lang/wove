(module specialized_formal_partial
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Rack (generic (type T)) (fields (rows (array T 2))))

	(fn row (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut data (array.alloc i32 1i32))
			(array.store data 0i32 value)
			(return (move data))))

	(fn first (params (data (shared-array i32))) (returns i32)
		(body (return (array.load data 0i32))))

	(fn accept (params (rack (specialize Rack (owned-array i32))) (later i32)) (returns i32)
		(body
			(return (i32.add later
				(call first (borrow-shared (array.load (struct.get rack rows) 0i32)))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rack (struct.new (specialize Rack (owned-array i32))
				(rows (array.new (array (owned-array i32) 2) (call row 7i32) (call row 0i32)))))
			(let removed (move (array.load (struct.get rack rows) 0i32)))
			(let-mut divisor 0i32)
			(if (i32.gtz (i32.dec (array.len args)))
				(then
					(array.store (struct.get rack rows) 0i32 (call row 41i32))
					(set divisor 1i32)))
			(return (call accept (move rack) (i32.div 1i32 divisor)))))
)
