(module formal_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type Packet) make_packet))

	(fn discard (params (packet Packet)) (returns void)
		(body))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let packet (call make_packet 42i32))
			(let view (borrow-shared (struct.get (struct.get packet nested) values)))
			(call discard (move packet))
			(return (array.len view)))))
