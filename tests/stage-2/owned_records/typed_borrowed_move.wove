(module typed_borrowed_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Bundle (fields (values (owned-array i32))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let bundle (struct.new Bundle (values (array.alloc i32 1i32))))
			(let view (borrow-shared (struct.get (local bundle) values)))
			(let values (move (struct.get (local bundle) values)))
			(return (array.len (local view))))))
