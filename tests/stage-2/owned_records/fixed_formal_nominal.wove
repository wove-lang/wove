(module fixed_formal_nominal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (items (owned-array i32))))
	(struct Other (fields (items (owned-array i32))))

	(fn take (params (rows (array Packet 1))) (returns void) (body))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let rows (array.new (array Other 1) (struct.new Other (items (array.alloc i32 1i32)))))
			(call take (move rows))
			(return 42i32)))
)
