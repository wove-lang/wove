(module owning_specialization_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Holder (generic (type T)) (fields (taken T) (kept T)))
	(struct Rack (generic (type T) (const N i32)) (fields (rows (array T N))))
	(struct Payload (fields (values (owned-array i32))))

	(fn row (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut values (array.alloc i32 1i32))
			(array.store (local values) 0i32 (local value))
			(return (move (local values)))))

	(fn payload (params (value i32)) (returns Payload)
		(body (return (struct.new Payload (values (call row (local value)))))))

	(fn pair (params) (returns (specialize Holder (owned-array i32)))
		(body
			(return (struct.new (specialize Holder (owned-array i32))
				(taken (call row 10i32)) (kept (call row 11i32))))))

	(fn first (params (values (shared-array i32))) (returns i32)
		(body (return (array.load (local values) 0i32))))

	(fn head (params (pair (shared-ref (specialize Holder (owned-array i32))))) (returns i32)
		(body (return (call first (borrow-shared (struct.get (local pair) taken))))))

	(fn paint_row (params (values (mut-array i32))) (returns void)
		(body (array.store (local values) 0i32 19i32)))

	(fn paint_payload (params (cell (mut-ref Payload))) (returns void)
		(body (call paint_row (borrow-mut (struct.get (local cell) values)))))

	(fn paint (params (rack (mut-ref (specialize Rack Payload 2i32)))) (returns void)
		(body (call paint_payload (borrow-mut (array.load (struct.get (local rack) rows) 1i32)))))
	(fn length (params (rows (shared-array (owned-array Payload)))) (returns i32)
		(body (return (array.len (local rows)))))

	(fn nested_length (params (pair (shared-ref (specialize Holder (owned-array (owned-array Payload)))))) (returns i32)
		(body (return (call length (borrow-shared (struct.get (local pair) taken))))))
)
