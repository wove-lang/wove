(module formal_argument_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type Packet) make_packet))

	(fn discard (params (view (shared-array i32)) (packet Packet)) (returns void)
		(body))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let packet (call make_packet 42i32))
			(call discard (borrow-shared (struct.get (struct.get (local packet) nested) values)) (move (local packet)))
			(return 0i32))))
