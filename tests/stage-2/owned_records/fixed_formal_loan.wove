(module fixed_formal_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn take (params (rows (array (owned-array i32) 2))) (returns void)
		(body))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let rows (array.new (array (owned-array i32) 2) (array.alloc i32 1i32) (array.alloc i32 1i32)))
			(let loan (borrow-shared (array.load (local rows) 0i32)))
			(call take (move (local rows)))
			(return 42i32)))
)
