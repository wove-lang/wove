(module formal_escape
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type Packet) make_packet))

	(fn escape (params (packet Packet)) (returns (shared-array i32) (from packet))
		(body
			(return (borrow-shared (struct:get (struct:get packet nested) values)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(return 0i32))))
