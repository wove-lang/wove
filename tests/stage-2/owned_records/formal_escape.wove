(module formal_escape
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type Packet) make_packet))

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn escape (params (packet Packet)) (returns (shared-array i32) (from packet))
		(body
			(return (borrow-shared (struct.get (struct.get (local packet) nested) values)))))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(return 0i32))))
