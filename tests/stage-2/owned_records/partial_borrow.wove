(module partial_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(fn use_grid
		(params (grid (shared-ref Grid))) (returns i32)
		(body (return 1i32)))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let grid (struct:new Grid (cells (array:alloc u8 1i32))))
			(let cells (move (struct:get grid cells)))
			(return (call use_grid (borrow-shared grid)))))
)
