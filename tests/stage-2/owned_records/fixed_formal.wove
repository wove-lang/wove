(module owning_fixed_formal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Holder (generic (type T)) (fields (item T)))

	(fn make_row (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut row (array:alloc i32 1i32))
			(array:store row 0i32 value)
			(return (move row))))

	(fn cell (params (value i32)) (returns (specialize Holder (owned-array i32)))
		(body (return (struct:new (specialize Holder (owned-array i32)) (item (call make_row value))))))

	(fn first (params (row (shared-array i32))) (returns i32)
		(body (return (array:load row 0i32))))

	(fn sum (params (rows (array (owned-array i32) 2))) (returns i32)
		(body
			(return (i32:add (call first (borrow-shared (array:load rows 0i32)))
				(call first (borrow-shared (array:load rows 1i32)))))))

	(fn read_cell (params (cell (specialize Holder (owned-array i32)))) (returns i32)
		(body (return (call first (borrow-shared (struct:get cell item))))))

	(fn finish (params (batch (array (array (specialize Holder (owned-array i32)) 2) 1)) (early bool) (check (mut-ref i32))) (returns void)
		(body
			(if early (then (return)))
			(let-mut working (move batch))
			(let removed (move (array:load (array:load working 0i32) 0i32)))
			(set check (call read_cell (move removed)))))

	(fn forward (params (batch (array (array (specialize Holder (owned-array i32)) 2) 1)) (early bool) (check (mut-ref i32))) (returns void)
		(body (call finish (move batch) early (borrow-mut check))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let pair (array:new (array (owned-array i32) 2) (call make_row 19i32) (call make_row 23i32)))
			(let result (call sum (move pair)))
			(let-mut check 0i32)
			(call forward
				(array:new (array (array (specialize Holder (owned-array i32)) 2) 1)
					(array:new (array (specialize Holder (owned-array i32)) 2) (call cell 11i32) (call cell 12i32)))
				(bool true) (borrow-mut check))
			(if (i32:not-eqz check) (then (return 1i32)))
			(let second (array:new (array (array (specialize Holder (owned-array i32)) 2) 1)
				(array:new (array (specialize Holder (owned-array i32)) 2) (call cell 31i32) (call cell 32i32))))
			(call forward (move second) (bool false) (borrow-mut check))
			(if (i32:not-eq check 31i32) (then (return 2i32)))
			(let-mut restored (array:new (array (owned-array i32) 2) (call make_row 5i32) (call make_row 14i32)))
			(let taken (move (array:load restored 0i32)))
			(array:store restored 0i32 (call make_row 28i32))
			(if (i32:not-eq (call sum (move restored)) 42i32) (then (return 3i32)))
			(return result)))
)
