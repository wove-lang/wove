(module owning_fixed_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Bundle (fields (rows (array (owned-array i32) 2))))
	(struct Envelope (fields (bundle Bundle)))

	(fn make_bytes (params (value i32)) (returns (owned-array i32))
		(body
			(let-mut bytes (array:alloc i32 1i32))
			(array:store bytes 0i32 value)
			(return (move bytes))))

	(fn make_bundle (params (first i32) (second i32)) (returns Bundle)
		(body
			(let row (call make_bytes first))
			(return (struct:new Bundle (rows (array:new (array (owned-array i32) 2)
				(move row) (call make_bytes second)))))))

	(fn read_first (params (row (shared-array i32))) (returns i32)
		(body (return (array:load row 0i32))))

	(fn paint (params (row (mut-array i32))) (returns void)
		(body (array:store row 0i32 40i32)))

	(fn paint_bundle (params (bundle (mut-ref Bundle))) (returns void)
		(body
			(call paint (borrow-mut (array:load (struct:get bundle rows) 1i32)))))

	(fn sum_bundle (params (bundle (shared-ref Bundle))) (returns i32)
		(body
			(let first (call read_first (borrow-shared (array:load (struct:get bundle rows) 0i32))))
			(let second (call read_first (borrow-shared (array:load (struct:get bundle rows) 1i32))))
			(return (i32:add first second))))

	(fn selected (params (count (mut-ref i32))) (returns i32)
		(body
			(set count (i32:add count 1i32))
			(return 0i32)))

	(fn direct_rows (params) (returns i32)
		(body
			(let-mut rows (array:new (array (owned-array i32) 1) (call make_bytes 20i32)))
			(let taken (move (array:load rows 0i32)))
			(if (i32:not-eq (array:len rows) 1i32) (then (return 4i32)))
			(let replacement (call make_bytes 22i32))
			(array:store rows 0i32 (move replacement))
			(return (i32:add
				(call read_first (borrow-shared taken))
				(call read_first (borrow-shared (array:load rows 0i32)))))))

	(fn read_envelope (params (envelope (shared-ref Envelope))) (returns i32)
		(body (return (call sum_bundle (borrow-shared (struct:get envelope bundle))))))

	(fn heap_envelopes (params) (returns i32)
		(body
			(let-mut envelopes (array:alloc Envelope 1i32))
			(array:store envelopes 0i32 (struct:new Envelope (bundle (call make_bundle 21i32 21i32))))
			(return (call read_envelope (borrow-shared (array:load envelopes 0i32))))))

	(fn choose_row (params (first bool)) (returns i32)
		(body
			(let rows (if first
				(then (array:new (array (owned-array i32) 1) (call make_bytes 19i32)))
				(else (array:new (array (owned-array i32) 1) (call make_bytes 23i32)))))
			(return (call read_first (borrow-shared (array:load rows 0i32))))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut t (array:new (array (array Bundle 2) 1)
				(array:new (array Bundle 2) (call make_bundle 3i32 5i32) (call make_bundle 2i32 7i32))))
			(if (i32:not-eq (array:len (array:load t 0i32)) 2i32) (then (return 5i32)))
			(call paint_bundle (borrow-mut (array:load (array:load t 0i32) 1i32)))
			(let-mut index_calls 0i32)
			(let taken (move (array:load (array:load t 0i32) (call selected (borrow-mut index_calls)))))
			(if (i32:not-eq index_calls 1i32) (then (return 1i32)))
			(if (i32:not-eq (call sum_bundle (borrow-shared taken)) 8i32) (then (return 2i32)))
			(array:store (array:load t 0i32) 0i32 (call make_bundle 1i32 11i32))
			(array:store (array:load t 0i32) 0i32 (call make_bundle 13i32 17i32))
			(let again (move (array:load (array:load t 0i32) 0i32)))
			(if (i32:not-eq (call sum_bundle (borrow-shared again)) 30i32) (then (return 3i32)))
			(if (i32:not-eq (call direct_rows) 42i32) (then (return 6i32)))
			(if (i32:not-eq (call heap_envelopes) 42i32) (then (return 7i32)))
			(let first (call choose_row (bool true)))
			(let second (call choose_row (bool false)))
			(if (i32:not-eq (i32:add first second) 42i32) (then (return 8i32)))
			(return (call sum_bundle (borrow-shared (array:load (array:load t 0i32) 1i32)))))))
