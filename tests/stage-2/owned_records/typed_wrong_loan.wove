(module typed_wrong_loan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Item (fields (value i32)))
	(struct Other (fields (value i32)))
	(struct Bundle (fields (items (owned-array Item))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn change (params (items (mut-array Other))) (returns void)
		(body (return)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut bundle (struct.new Bundle (items (array.alloc Item 1i32))))
			(call change (borrow-mut (struct.get (local bundle) items)))
			(return 0i32))))
