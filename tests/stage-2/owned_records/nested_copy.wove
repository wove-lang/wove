(module nested_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Outer (fields (inner Inner)))
	(struct Inner (fields (values (owned-array i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let outer (struct.new Outer (inner (struct.new Inner (values (array.alloc i32 1i32))))))
			(let copied (struct.get (local outer) inner))
			(return 0i32))))
