(module owned_match_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (i32:dec (array:len spans)))
			(let grid (match count
				(case 0i32 (struct:new Grid (cells (array:alloc u8 1i32))))
				(case _ (struct:new Grid (cells (array:alloc u8 2i32))))))
			(return 0i32))))
