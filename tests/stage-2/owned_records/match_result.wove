(module owned_match_result
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let count (array.len (local spans)))
			(let grid (match (local count)
				(case 0i32 (struct.new Grid (cells (array.alloc u8 1i32))))
				(case _ (struct.new Grid (cells (array.alloc u8 2i32))))))
			(return 0i32))))
