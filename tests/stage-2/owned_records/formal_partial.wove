(module formal_partial
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type Packet) make_packet))

	(fn discard (params (packet Packet)) (returns void)
		(body))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let packet (call make_packet 42i32))
			(let values (move (struct.get (struct.get (local packet) nested) values)))
			(call discard (move (local packet)))
			(return (array.len (local values))))))
