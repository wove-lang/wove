(module nested_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Outer (fields (middle Middle)))
	(struct Middle (fields (inner Inner)))
	(struct Inner (fields (values (owned-array i32))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn overlap (params (inner (mut-ref Inner)) (values (shared-array i32))) (returns void)
		(body (return)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut outer (struct.new Outer
				(middle (struct.new Middle (inner (struct.new Inner (values (array.alloc i32 1i32))))))))
			(call overlap (borrow-mut (struct.get (struct.get (local outer) middle) inner))
				(borrow-shared (struct.get (struct.get (struct.get (local outer) middle) inner) values)))
			(return 0i32))))
