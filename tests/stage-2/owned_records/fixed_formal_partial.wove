	(struct ArgSpan (fields (start i32) (end i32)))

	(fn take (params (rows (array (array (owned-array i32) 2) 1)) (later i32)) (returns void)
		(body))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.new (array (array (owned-array i32) 2) 1)
				(array.new (array (owned-array i32) 2) (array.alloc i32 1i32) (array.alloc i32 1i32))))
			(let first (move (array.load (array.load (local rows) 0i32) 0i32)))
			(call take (move (local rows)) (i32.div 1i32 0i32))
			(return 42i32)))
)
