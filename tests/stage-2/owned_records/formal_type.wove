(module formal_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./formal_packet.wove" (only (type Packet) (type Payload)))

	(struct ArgSpan (fields (start i32) (end i32)))

	(struct Other (fields (nested Payload)))

	(fn discard (params (packet Packet)) (returns void)
		(body))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let packet (struct.new Other
				(nested (struct.new Payload (values (array.alloc i32 1i32)) (spare (array.alloc u8 1i32))))))
			(call discard (move (local packet)))
			(return 0i32))))
