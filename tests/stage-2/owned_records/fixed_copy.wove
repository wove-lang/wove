(module fixed_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (argv (shared-array u8)) (spans (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut rows (array.new (array (owned-array i32) 1) (array.alloc i32 1i32)))
			(let copied (array.load (local rows) 0i32))
			(return 0i32))))
