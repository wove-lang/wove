(module fixed_index_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn retire (params (row (owned-array i32))) (returns i32)
		(body (return 0i32)))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.new (array (owned-array i32) 1) (array.alloc i32 1i32)))
			(let removed (move (array.load (local rows) (call retire (move (array.load (local rows) 0i32))))))
			(return (array.len (local removed))))))
