(module fixed_formal_reuse
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn take (params (rows (array (owned-array i32) 2))) (returns void)
		(body))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let rows (array.new (array (owned-array i32) 2) (array.alloc i32 1i32) (array.alloc i32 1i32)))
			(call take (move (local rows)))
			(call take (move (local rows)))
			(return 42i32)))
)
