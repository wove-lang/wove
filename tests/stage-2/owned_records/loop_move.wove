(module loop_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (argv (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body
			(let grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(let-mut count (array.len (local spans)))
			(while (i32.lt 0i32 (local count))
				(body
					(let cells (move (struct.get (local grid) cells)))
					(set (local count) (i32.sub (local count) 1i32))))
			(return 0i32)))
)
