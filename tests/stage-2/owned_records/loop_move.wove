(module loop_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Grid (fields (cells (owned-array u8))))
	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let grid (struct.new Grid (cells (array.alloc u8 1i32))))
			(let-mut count (i32.dec (array.len (local spans))))
			(while (i32.lt 0i32 (local count))
				(body
					(let cells (move (struct.get (local grid) cells)))
					(set (local count) (i32.sub (local count) 1i32))))
			(return 0i32)))
)
