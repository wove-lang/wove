(module typed_wrong_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Item (fields (value i32)))
	(struct Other (fields (value i32)))
	(struct Bundle (fields (groups (owned-array (owned-array Item)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let groups (array:alloc (owned-array Other) 1i32))
			(let bundle (struct:new Bundle (groups (move groups))))
			(return 0i32))))
