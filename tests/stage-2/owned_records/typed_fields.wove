(module typed_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Bundle
		(fields
			(samples (owned-array Sample))
			(groups (owned-array (owned-array (owned-array Sample))))
			(counts (owned-array i32))))
	(struct Sample (fields (point Point)))
	(struct Point (fields (value i32)))

	(fn sample (params (value i32)) (returns Sample)
		(body (return (struct:new Sample (point (struct:new Point (value value)))))))

	(fn make_samples (params (value i32)) (returns (owned-array Sample))
		(body
			(let-mut samples (array:alloc Sample 1i32))
			(array:set samples 0i32 (call sample value))
			(return (move samples))))

	(fn make_groups (params) (returns (owned-array (owned-array (owned-array Sample))))
		(body
			(let original (call make_samples 12i32))
			(let-mut sheet (array:alloc (owned-array Sample) 1i32))
			(array:set sheet 0i32 (move original))
			(array:set sheet 0i32 (call make_samples 19i32))
			(let-mut groups (array:alloc (owned-array (owned-array Sample)) 1i32))
			(array:set groups 0i32 (move sheet))
			(return (move groups))))

	(fn make (params) (returns Bundle)
		(body
			(let counts (array:alloc i32 1i32))
			(return (struct:new Bundle
				(counts (move counts))
				(samples (call make_samples 5i32))
				(groups (call make_groups))))))

	(fn set_counts (params (values (mut-array i32))) (returns void)
		(body (array:set values 0i32 3i32)))

	(fn set_samples (params (values (mut-array Sample))) (returns void)
		(body (array:set values 0i32 (call sample 20i32))))

	(fn update (params (bundle (mut-ref Bundle))) (returns void)
		(body
			(call set_counts (borrow-mut (struct:get bundle counts)))
			(call set_samples (borrow-mut (struct:get bundle samples)))))

	(fn read_counts (params (values (shared-array i32))) (returns i32)
		(body (return (array:get values 0i32))))

	(fn read_samples (params (values (shared-array Sample))) (returns i32)
		(body (return (struct:get (struct:get (array:get values 0i32) point) value))))

	(fn read_groups (params (groups (shared-array (owned-array (owned-array Sample))))) (returns i32)
		(body
			(let sheet (borrow-shared (array:get groups 0i32)))
			(let samples (borrow-shared (array:get sheet 0i32)))
			(return (call read_samples (borrow-shared samples)))))

	(fn intact (params (bundle (shared-ref Bundle))) (returns i32)
		(body
			(let counts (call read_counts (borrow-shared (struct:get bundle counts))))
			(let samples (call read_samples (borrow-shared (struct:get bundle samples))))
			(let group (call read_groups (borrow-shared (struct:get bundle groups))))
			(return (i32:add counts (i32:add samples group)))))

	(fn exercise (params (peel bool)) (returns i32)
		(body
			(let first (call make))
			(let-mut bundle (move first))
			(call update (borrow-mut bundle))
			(if peel
				(then
					(let-mut groups (move (struct:get bundle groups)))
					(let-mut sheet (array:remove groups 0i32))
					(let samples (array:remove sheet 0i32))
					(let group (call read_samples (borrow-shared samples)))
					(let counts_view (borrow-shared (struct:get bundle counts)))
					(let counts (call read_counts (borrow-shared counts_view)))
					(let other (call read_samples (borrow-shared (struct:get bundle samples))))
					(return (i32:add counts (i32:add other group)))))
			(return (call intact (borrow-shared bundle)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let intact (call exercise (bool false)))
			(let peeled (call exercise (bool true)))
			(if (i32:not-eq intact 42i32) (then (return 1i32)))
			(return peeled))))
