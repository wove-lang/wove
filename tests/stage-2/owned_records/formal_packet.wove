(module owning_record_formal_packet
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Packet (fields (nested Payload)))
	(struct Payload (fields (values (owned-array i32)) (spare (owned-array u8))))

	(fn make_packet (params (first i32)) (returns Packet)
		(body
			(let-mut values (array.alloc i32 1i32))
			(array.store (local values) 0i32 (local first))
			(return (struct.new Packet
				(nested (struct.new Payload (values (move (local values))) (spare (array.alloc u8 1i32))))))))
)
