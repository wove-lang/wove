(module nested_partial
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Outer (fields (middle Middle)))
	(struct Middle (fields (inner Inner)))
	(struct Inner (fields (values (owned-array i32))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let outer (struct.new Outer
				(middle (struct.new Middle (inner (struct.new Inner (values (array.alloc i32 1i32))))))))
			(let values (move (struct.get (struct.get (struct.get outer middle) inner) values)))
			(let moved (move outer))
			(return 0i32))))
