(module nested_partial
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Outer (fields (middle Middle)))
	(struct Middle (fields (inner Inner)))
	(struct Inner (fields (values (owned-array i32))))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let outer (struct.new Outer
				(middle (struct.new Middle (inner (struct.new Inner (values (array.alloc i32 1i32))))))))
			(let values (move (struct.get (struct.get (struct.get (local outer) middle) inner) values)))
			(let moved (move (local outer)))
			(return 0i32))))
