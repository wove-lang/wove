(module owning_specializations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./specialization_types.wove" (only
		(type (as Holder Pair)) (type (as Rack Bins)) (type (as Payload Cell)) row payload pair head paint nested_length))

	(fn read_pair (params (pair (shared-ref (specialize Pair (owned-array i32))))) (returns i32)
		(body (return (call head (borrow-shared pair)))))

	(fn first (params (values (shared-array i32))) (returns i32)
		(body (return (array.load values 0i32))))

	(fn value (params (cell (shared-ref Cell))) (returns i32)
		(body (return (call first (borrow-shared (struct.get cell values))))))

	(fn main (params (spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let pair (call pair))
			(if (i32.not-eq (call read_pair (borrow-shared pair)) 10i32) (then (return 1i32)))
			(let direct (move (struct.get pair taken)))
			(let kept (borrow-shared (struct.get pair kept)))
			(let-mut rack (struct.new (specialize Bins Cell 2i32)
				(rows (array.new (array Cell 2) (call payload 2i32) (call payload 7i32)))))
			(call paint (borrow-mut rack))
			(let taken (move (array.load (struct.get rack rows) 0i32)))
			(let fixed (struct.new (specialize Bins (owned-array i32) 1i32)
				(rows (array.new (array (owned-array i32) 1) (call row 0i32)))))
			(let nested (struct.new (specialize Pair (owned-array (owned-array Cell)))
				(taken (array.alloc (owned-array Cell) 1i32))
				(kept (array.alloc (owned-array Cell) 1i32))))
			(let moved (move nested))
			(if (i32.not-eq (call nested_length (borrow-shared moved)) 1i32) (then (return 2i32)))
			(return (i32.add (i32.add (call first (borrow-shared direct)) (call first (borrow-shared kept)))
				(i32.add
					(i32.add (call value (borrow-shared taken))
						(call value (borrow-shared (array.load (struct.get rack rows) 1i32))))
					(call first (borrow-shared (array.load (struct.get fixed rows) 0i32))))))))
)
