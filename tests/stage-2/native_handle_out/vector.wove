(module native_handle_out_vector
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./fixture.h"
		(type Handle (:pragma (c_owned (drop fixture_drop))) (c-type "fixture_handle *"))
		(fn fixture_open_rows
			(:pragma (c_cstrs rows) (c_init output) (c_null optional))
			(params (rows (shared-array (owned-array u8))) (output (mut-ref Handle)) (optional (shared-array u8)))
			(returns i32))
		(fn fixture_read (params (handle (shared-ref Handle))) (returns i32)))
	(use c-header "./fixture.h" (only (type Handle) fixture_open_rows fixture_read))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut row (array.alloc u8 1i32))
			(array.store row 0i32 65u8)
			(let-mut rows (array.alloc (owned-array u8) 1i32))
			(array.store rows 0i32 (move row))
			(let-mut owner (native.empty Handle))
			(let status (call fixture_open_rows (borrow-shared rows) (borrow-mut owner) null))
			(if (bool.not (i32.eq status 0i32)) (then (return 1i32)))
			(return (call fixture_read (borrow-shared owner))))))
