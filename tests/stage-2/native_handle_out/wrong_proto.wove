(module native_handle_out_wrong_proto
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./fixture.h"
		(type (:pragma (c_owned (drop fixture_drop))) Handle (c-type "fixture_handle *"))
		(fn fixture_wrong
			(:pragma (c_init output))
			(params (output (mut-ref Handle)))
			(returns i32)))
	(use c-header "./fixture.h" (only (type Handle) fixture_wrong))
	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut owner (native.empty Handle))
			(return (call fixture_wrong (borrow-mut (local owner)))))))
