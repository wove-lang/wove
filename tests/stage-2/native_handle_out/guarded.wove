(module native_handle_out_guarded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_open fixture_later))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut owner (native.empty Handle))
			(let status (call fixture_open (borrow-mut (local owner)) 1i32))
			(if (bool.not (i32.eq (local status) 8i32)) (then (return 2i32)))
			(return (call fixture_open (borrow-mut (local owner)) (call fixture_later))))))
