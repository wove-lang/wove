(module native_handle_out_guarded
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_open fixture_later))
	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut owner (native:empty Handle))
			(let status (call fixture_open (borrow-mut owner) 1i32))
			(if (bool:not (i32:eq status 8i32)) (then (return 2i32)))
			(return (call fixture_open (borrow-mut owner) (call fixture_later))))))
