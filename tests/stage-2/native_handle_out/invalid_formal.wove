	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./fixture.h"
		(type Handle (:pragma (c_owned (drop fixture_drop))) (c-type "fixture_handle *"))
		(fn fixture_read
			(:pragma (c_init output))
			(params (output (shared-ref Handle)))
			(returns i32)))
	(use c-header "./fixture.h" (only fixture_read))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32) (body (return 0i32))))
