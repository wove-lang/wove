(module native_handle_out_invalid_formal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./fixture.h"
		(type (:pragma (c_owned (drop fixture_drop))) Handle (c-type "fixture_handle *"))
		(fn fixture_read
			(:pragma (c_init output))
			(params (output (shared-ref Handle)))
			(returns i32)))
	(use c-header "./fixture.h" (only fixture_read))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32) (body (return 0i32))))
