(module native_handle_out_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle) fixture_dual))
	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut owner (native:empty Handle))
			(return (call fixture_dual (borrow-mut owner) (borrow-shared owner))))))
