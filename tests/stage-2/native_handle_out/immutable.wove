	(use c-header "./fixture.h" (only (type Handle) fixture_open))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let owner (native.empty Handle))
			(return (call fixture_open (borrow-mut (local owner)) 2i32)))))
