(module native_handle_out_sqlite
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "<sqlite3.h>"
		(type (:pragma (c_owned (drop sqlite3_close_v2))) Database (c-type "sqlite3 *"))
		(type (:pragma (c_owned (drop sqlite3_finalize))) Statement (c-type "sqlite3_stmt *"))
		(fn sqlite3_open
			(:pragma (c_cstr filename) (c_init output))
			(params (filename (shared-array u8)) (output (mut-ref Database)))
			(returns i32))
		(fn sqlite3_prepare_v2
			(:pragma (c_cstr sql) (c_init output))
			(params (db (mut-ref Database)) (sql (shared-array u8)) (const length i32 -1)
				(output (mut-ref Statement)) (const tail (c-type "const char **") null))
			(returns i32))
		(fn sqlite3_step (params (statement (mut-ref Statement))) (returns i32))
		(fn sqlite3_column_int (params (statement (shared-ref Statement)) (column i32)) (returns i32))
		(fn sqlite3_finalize (params (statement Statement)) (returns i32)))
	(use c-header "<sqlite3.h>" (only (type Database) (type Statement) sqlite3_open sqlite3_prepare_v2 sqlite3_step sqlite3_column_int sqlite3_finalize))

	(let memory ":memory:")
	(let bad_path "/")
	(let bad_sql "not a valid sql statement")
	(let query "select 42")

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut failed (native.empty Database))
			(let fail_status (call sqlite3_open (borrow-shared (local bad_path)) (borrow-mut (local failed))))
			(if (bool.or (i32.eq (local fail_status) 0i32) (owner.is-null (local failed))) (then (return 1i32)))
			(let-mut db (native.empty Database))
			(let open_status (call sqlite3_open (borrow-shared (local memory)) (borrow-mut (local db))))
			(if (bool.or (bool.not (i32.eq (local open_status) 0i32)) (owner.is-null (local db))) (then (return 2i32)))
			(let-mut stmt (native.empty Statement))
			(let invalid (call sqlite3_prepare_v2 (borrow-mut (local db)) (borrow-shared (local bad_sql)) (borrow-mut (local stmt))))
			(if (bool.or (i32.eq (local invalid) 0i32) (bool.not (owner.is-null (local stmt)))) (then (return 3i32)))
			(let prepared (call sqlite3_prepare_v2 (borrow-mut (local db)) (borrow-shared (local query)) (borrow-mut (local stmt))))
			(if (bool.or (bool.not (i32.eq (local prepared) 0i32)) (owner.is-null (local stmt))) (then (return 4i32)))
			(if (bool.not (i32.eq (call sqlite3_step (borrow-mut (local stmt))) 100i32)) (then (return 5i32)))
			(let value (call sqlite3_column_int (borrow-shared (local stmt)) 0i32))
			(if (bool.not (i32.eq (call sqlite3_finalize (move (local stmt))) 0i32)) (then (return 6i32)))
			(return (local value)))))
