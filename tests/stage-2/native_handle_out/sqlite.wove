(module native_handle_out_sqlite
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "<sqlite3.h>"
		(type Database (:pragma (c_owned (drop sqlite3_close_v2))) (c-type "sqlite3 *"))
		(type Statement (c-type "sqlite3_stmt *") (:pragma (c_owned (drop sqlite3_finalize))))
		(fn sqlite3_open
			(:pragma (c_cstr filename) (c_init output))
			(params (filename (shared-array u8)) (output (mut-ref Database)))
			(returns i32))
		(fn sqlite3_prepare_v2
			(:pragma (c_cstr sql) (c_init output))
			(params (db (mut-ref Database)) (sql (shared-array u8)) (const length i32 -1)
				(output (mut-ref Statement)) (const tail (c-type "const char **") null))
			(returns i32))
		(fn sqlite3_step (params (statement (mut-ref Statement))) (returns i32))
		(fn sqlite3_column_int (params (statement (shared-ref Statement)) (column i32)) (returns i32))
		(fn sqlite3_finalize (params (statement Statement)) (returns i32)))
	(use c-header "<sqlite3.h>" (only (type Database) (type Statement) sqlite3_open sqlite3_prepare_v2 sqlite3_step sqlite3_column_int sqlite3_finalize))

	(let memory ":memory:")
	(let bad_path "/")
	(let bad_sql "not a valid sql statement")
	(let query "select 42")

	(fn prepare (params (sql (shared-array u8))) (returns Statement)
		(body
			(let-mut db (native:empty Database))
			(let-mut statement (native:empty Statement))
			(let opened (call sqlite3_open (borrow-shared memory) (borrow-mut db)))
			(if (i32:eqz opened)
				(then
					(let prepared (call sqlite3_prepare_v2 (borrow-mut db)
						(borrow-shared sql) (borrow-mut statement)))))
			(return (move statement))))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut failed (native:empty Database))
			(let fail_status (call sqlite3_open (borrow-shared bad_path) (borrow-mut failed)))
			(if (bool:or (i32:eq fail_status 0i32) (owner:is-null failed)) (then (return 1i32)))
			(let-mut db (native:empty Database))
			(let open_status (call sqlite3_open (borrow-shared memory) (borrow-mut db)))
			(if (bool:or (bool:not (i32:eq open_status 0i32)) (owner:is-null db)) (then (return 2i32)))
			(let-mut stmt (native:empty Statement))
			(let invalid (call sqlite3_prepare_v2 (borrow-mut db) (borrow-shared bad_sql) (borrow-mut stmt)))
			(if (bool:or (i32:eq invalid 0i32) (bool:not (owner:is-null stmt))) (then (return 3i32)))
			(let prepared (call sqlite3_prepare_v2 (borrow-mut db) (borrow-shared query) (borrow-mut stmt)))
			(if (bool:or (bool:not (i32:eq prepared 0i32)) (owner:is-null stmt)) (then (return 4i32)))
			(if (bool:not (i32:eq (call sqlite3_step (borrow-mut stmt)) 100i32)) (then (return 5i32)))
			(let value (call sqlite3_column_int (borrow-shared stmt) 0i32))
			(if (bool:not (i32:eq (call sqlite3_finalize (move stmt)) 0i32)) (then (return 6i32)))
			(if (i32:not-eq value 42i32) (then (return 7i32)))
			(let missing (call prepare (borrow-shared bad_sql)))
			(if (bool:not (owner:is-null missing)) (then (return 8i32)))
			(let-mut returned (call prepare (borrow-shared query)))
			(if (owner:is-null returned) (then (return 9i32)))
			(if (i32:not-eq (call sqlite3_step (borrow-mut returned)) 100i32) (then (return 10i32)))
			(return (call sqlite3_column_int (borrow-shared returned) 0i32)))))
