(module native_handle_out_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./fixture.h"
		(type Handle (:pragma (c_owned (drop fixture_drop))) (c-type "fixture_handle *"))
		(fn fixture_open
			(:pragma (c_init output))
			(params (output (mut-ref Handle)) (scenario i32))
			(returns i32))
		(fn fixture_read (params (handle (shared-ref Handle))) (returns i32))
		(fn fixture_dual
			(:pragma (c_init output))
			(params (output (mut-ref Handle)) (other (shared-ref Handle)))
			(returns i32))
		(fn fixture_drop (params (handle Handle)) (returns i32))
		(fn fixture_opens (params) (returns i32))
		(fn fixture_drops (params) (returns i32))
		(fn fixture_live (params) (returns i32))
		(fn fixture_later (params) (returns i32))))
