(module native_handle_out_lifetime
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type (as Handle Resource)) fixture_open fixture_read fixture_drop fixture_opens fixture_drops fixture_live))

	(fn retry
		(params) (returns i32)
		(body
			(let-mut owner (native.empty Resource))
			(if (bool.not (owner.is-null (local owner))) (then (return 1i32)))
			(let failed (call fixture_open (borrow-mut (local owner)) 0i32))
			(if (bool.not (i32.eq (local failed) -7i32)) (then (return 2i32)))
			(if (bool.not (owner.is-null (local owner))) (then (return 3i32)))
			(let status (call fixture_open (borrow-mut (local owner)) 2i32))
			(if (bool.not (i32.eq (local status) 0i32)) (then (return 4i32)))
			(let transferred (move (local owner)))
			(if (bool.not (i32.eq (call fixture_read (borrow-shared (local transferred))) 42i32)) (then (return 5i32)))
			(return (call fixture_drop (move (local transferred))))))

	(fn failed_open
		(params) (returns i32)
		(body
			(let-mut owner (native.empty Resource))
			(let status (call fixture_open (borrow-mut (local owner)) 1i32))
			(if (owner.is-null (local owner)) (then (return 6i32)))
			(return (local status))))

	(fn null_open
		(params) (returns i32)
		(body
			(let-mut owner (native.empty Resource))
			(return (call fixture_open (borrow-mut (local owner)) 0i32))))

	(fn main
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (bool.not (i32.eq (call retry) 0i32)) (then (return 10i32)))
			(if (bool.not (i32.eq (call fixture_drops) 1i32)) (then (return 11i32)))
			(if (bool.not (i32.eq (call failed_open) 8i32)) (then (return 12i32)))
			(if (bool.not (i32.eq (call null_open) -7i32)) (then (return 13i32)))
			(if (bool.not (i32.eq (call fixture_opens) 4i32)) (then (return 14i32)))
			(if (bool.not (i32.eq (call fixture_drops) 2i32)) (then (return 15i32)))
			(if (bool.not (i32.eq (call fixture_live) 0i32)) (then (return 16i32)))
			(return 42i32))))
