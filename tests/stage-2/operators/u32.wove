(module u32_wrapping
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn add
		(params (left u32) (right u32))
		(returns u32)
		(body (return (u32.add.wrapping (local left) (local right)))))

	(fn subtract
		(params (left u32) (right u32))
		(returns u32)
		(body (return (u32.sub.wrapping (local left) (local right)))))

	(fn advance
		(params (state (mut-slice u8)) (delta i32))
		(returns u32)
		(body
			(let prior (int.convert i32 (slice.load (local state) (i32 0))))
			(let next (i32.add.wrapping (local prior) (local delta)))
			(slice.store (local state) (i32 0) (int.convert u8 (local next)))
			(return (int.convert u32 (local next)))))

	(fn ordered_add
		(params (state (mut-slice u8)))
		(returns u32)
		(body
			(return (u32.add.wrapping
				(call advance (borrow-mut (local state)) (i32 3))
				(call advance (borrow-mut (local state)) (i32 5))))))

	(fn ordered_subtract
		(params (state (mut-slice u8)))
		(returns u32)
		(body
			(return (u32.sub.wrapping
				(call advance (borrow-mut (local state)) (i32 3))
				(call advance (borrow-mut (local state)) (i32 5))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body (return (int.convert i32 (call add (u32 20) (u32 22)))))))
