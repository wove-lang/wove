(module u32_wrapping
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn add
		(params (left u32) (right u32))
		(returns u32)
		(body (return (u32.add left right))))

	(fn subtract
		(params (left u32) (right u32))
		(returns u32)
		(body (return (u32.sub left right))))

	(fn advance
		(params (state (mut-array u8)) (delta i32))
		(returns u32)
		(body
			(let prior (int.convert i32 (array.load state (i32 0))))
			(let next (i32.add prior delta))
			(array.store state (i32 0) (int.convert u8 next))
			(return (int.convert u32 next))))

	(fn ordered_add
		(params (state (mut-array u8)))
		(returns u32)
		(body
			(return (u32.add
				(call advance (borrow-mut state) (i32 3))
				(call advance (borrow-mut state) (i32 5))))))

	(fn ordered_subtract
		(params (state (mut-array u8)))
		(returns u32)
		(body
			(return (u32.sub
				(call advance (borrow-mut state) (i32 3))
				(call advance (borrow-mut state) (i32 5))))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (int.convert i32 (call add (u32 20) (u32 22)))))))
