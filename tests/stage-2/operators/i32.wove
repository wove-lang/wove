(module i32_operators
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut cursor (i32 8))
			(set cursor
				(i32:add (call identity cursor) (call identity (i32 37))))
			(return (i32:sub cursor (i32 3)))))
	(fn identity (params (value i32)) (returns i32)
		(body (return value)))
	(fn add (params (left i32) (right i32)) (returns i32)
		(body (return (i32:add left right))))
	(fn subtract (params (left i32) (right i32)) (returns i32)
		(body (return (i32:sub left right))))
	(fn less (params (left i32) (right i32)) (returns bool)
		(body (return (i32:lt left right))))
	(fn equal (params (left i32) (right i32)) (returns bool)
		(body (return (i32:eq left right))))
	(fn carry_bool (params (value bool)) (returns bool)
		(body (return value)))
	(fn comparison_argument (params) (returns bool)
		(body
			(return (call carry_bool
				(i32:lt (i32:sub (i32 0) (i32 1)) (i32 0))))))
	(fn truth (params) (returns bool)
		(body (return (call carry_bool (bool true)))))
	(fn falsity (params) (returns bool)
		(body (return (call carry_bool (bool false))))))
