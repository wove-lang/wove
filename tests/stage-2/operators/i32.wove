(module i32_operators
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body
			(let-mut cursor (i32 8))
			(set (local cursor)
				(i32.add.wrapping (call identity (local cursor)) (call identity (i32 37))))
			(return (i32.sub.wrapping (local cursor) (i32 3)))))
	(fn identity (params (value i32)) (returns i32)
		(body (return (local value))))
	(fn add (params (left i32) (right i32)) (returns i32)
		(body (return (i32.add.wrapping (local left) (local right)))))
	(fn subtract (params (left i32) (right i32)) (returns i32)
		(body (return (i32.sub.wrapping (local left) (local right)))))
	(fn less (params (left i32) (right i32)) (returns bool)
		(body (return (i32.lt (local left) (local right)))))
	(fn equal (params (left i32) (right i32)) (returns bool)
		(body (return (i32.eq (local left) (local right)))))
	(fn carry_bool (params (value bool)) (returns bool)
		(body (return (local value))))
	(fn comparison_argument (params) (returns bool)
		(body
			(return (call carry_bool
				(i32.lt (i32.sub.wrapping (i32 0) (i32 1)) (i32 0))))))
	(fn truth (params) (returns bool)
		(body (return (call carry_bool (bool true)))))
	(fn falsity (params) (returns bool)
		(body (return (call carry_bool (bool false))))))
