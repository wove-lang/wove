(module field_loan_whole_first
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Chunk (fields (words (array u64 8))))
	(struct State (fields (chunk Chunk)))

	(fn consume
		(params (before (mut-ref State)) (after (shared-slice u64)))
		(returns void)
		(body (return)))

	(fn check
		(params (state (mut-ref State)))
		(returns void)
		(body (call consume (borrow-mut (local state)) (borrow-shared (record.get (record.get (local state) chunk) words)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 0)))))
