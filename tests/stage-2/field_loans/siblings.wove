(module field_loan_siblings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Chunk (fields (words (array u64 8)) (block (array u8 128)) (counter u64)))
	(struct State (fields (pending Chunk) (other Chunk) (empty (array u8 0))))

	(fn initial
		(params (word u64) (byte u8) (counter u64))
		(returns Chunk)
		(body (return (struct:new Chunk
			(words (array:repeat (array u64 8) word))
			(block (array:repeat (array u8 128) byte))
			(counter counter)))))

	(fn combine
		(params (words (mut-array u64)) (block (shared-array u8)) (counter u64))
		(returns void)
		(body
			(array:store words (i32 7)
				(u64:add (array:load words (i32 7))
					(u64:add (int:convert u64 (array:load block (i32 127))) counter)))))

	(fn reversed
		(params (block (shared-array u8)) (words (mut-array u64)) (counter u64))
		(returns void)
		(body (call combine (borrow-mut words) (borrow-shared block) counter)))

	(fn through_reference
		(params (state (mut-ref State)))
		(returns void)
		(body (call reversed
			(borrow-shared (struct:get (struct:get state pending) block))
			(borrow-mut (struct:get (struct:get state pending) words))
			(struct:get (struct:get state pending) counter))))

	(fn through_subrecord
		(params (pending (mut-ref Chunk)) (block (shared-array u8)))
		(returns void)
		(body (call combine (borrow-mut (struct:get pending words))
			(borrow-shared block) (u64 0))))

	(fn view_sizes
		(params (left (shared-array u8)) (right (shared-array u8)) (empty (shared-array u8)))
		(returns bool)
		(body (return (bool:and (i32:eq (array:len left) (i32 128))
			(bool:and (i32:eq (array:len right) (i32 128))
				(i32:eq (array:len empty) (i32 0)))))))

	(fn through_shared
		(params (state (shared-ref State)))
		(returns bool)
		(body (return (call view_sizes
			(borrow-shared (struct:get (struct:get state pending) block))
			(borrow-shared (struct:get (struct:get state pending) block))
			(borrow-shared (struct:get state empty))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (struct:new State (pending (call initial (u64 12) (u8 5) (u64 3)))
				(other (call initial (u64 17) (u8 7) (u64 2))) (empty (array:new (array u8 0)))))
			(call combine (borrow-mut (struct:get (struct:get state pending) words))
				(borrow-shared (struct:get (struct:get state pending) block))
				(struct:get (struct:get state pending) counter))
			(if (bool:not (u64:eq (array:load (struct:get (struct:get state pending) words) (i32 7)) (u64 20)))
				(then (return (i32 1))))
			(call through_reference (borrow-mut state))
			(if (bool:not (u64:eq (array:load (struct:get (struct:get state pending) words) (i32 7)) (u64 28)))
				(then (return (i32 2))))
			(call through_subrecord (borrow-mut (struct:get state pending))
				(borrow-shared (struct:get (struct:get state other) block)))
			(if (bool:not (u64:eq (array:load (struct:get (struct:get state pending) words) (i32 7)) (u64 35)))
				(then (return (i32 3))))
			(if (bool:not (u64:eq (array:load (struct:get (struct:get state pending) words) (i32 6)) (u64 12)))
				(then (return (i32 4))))
			(if (bool:not (u8:eq (array:load (struct:get (struct:get state pending) block) (i32 127)) (u8 5)))
				(then (return (i32 5))))
			(if (bool:not (u64:eq (array:load (struct:get (struct:get state other) words) (i32 7)) (u64 17)))
				(then (return (i32 6))))
			(if (bool:not (u8:eq (array:load (struct:get (struct:get state other) block) (i32 127)) (u8 7)))
				(then (return (i32 7))))
			(if (bool:not (call through_shared (borrow-shared state))) (then (return (i32 8))))
			(return (i32 42)))))
