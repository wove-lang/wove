(module field_loan_element
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Chunk (fields (words (array u64 8))))
	(struct State (fields (chunk Chunk)))

	(fn consume
		(params (view (shared-slice u32)))
		(returns void)
		(body (return)))

	(fn check
		(params (state (mut-ref State)))
		(returns void)
		(body (call consume (borrow-shared (struct.get (struct.get (local state) chunk) words)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32) (body (return (i32 0)))))
