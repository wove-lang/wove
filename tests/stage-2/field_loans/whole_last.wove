(module field_loan_whole_last
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Chunk (fields (words (array u64 8))))
	(struct State (fields (chunk Chunk)))

	(fn consume
		(params (before (mut-slice u64)) (after (shared-ref State)))
		(returns void)
		(body (return)))

	(fn check
		(params (state (mut-ref State)))
		(returns void)
		(body (call consume (borrow-mut (record.get (record.get (local state) chunk) words)) (borrow-shared (local state)))))

	(fn main (params) (returns i32) (body (return (i32 0)))))
