(module field_loan_prefix
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Chunk (fields (words (array u64 8))))
	(struct State (fields (chunk Chunk)))

	(fn consume
		(params (before (shared-ref Chunk)) (after (mut-array u64)))
		(returns void)
		(body (return)))

	(fn check
		(params (state (mut-ref State)))
		(returns void)
		(body (call consume (borrow-shared (struct.get state chunk)) (borrow-mut (struct.get (struct.get state chunk) words)))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0)))))
