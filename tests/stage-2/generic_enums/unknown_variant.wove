(module unknown_variant
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type Mode)))
	(use wove-file "./provider.wove" (only (type State)))
	(fn check (params (state (specialize State (enum.new Mode Unknown)))) (returns i32)
		(body (return (struct.get state cursor))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32)))
)
