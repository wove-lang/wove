(module unknown_variant
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type Mode)))
	(use wove-file "./provider.wove" (only (type State)))
	(fn check (params (state (specialize State (enum.new Mode Unknown)))) (returns i32)
		(body (return (struct.get (local state) cursor))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 42i32)))
)
