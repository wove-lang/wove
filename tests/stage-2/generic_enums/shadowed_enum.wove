(module shadowed_enum
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Mode (variants (Fast) (Safe)))
	(struct State (generic (const M Mode)) (fields (cursor i32)))
	(struct Container (generic (type Mode))
		(fields (state (specialize State (enum.new Mode Fast)))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let value (struct.new (specialize Container i32)
				(state (struct.new (specialize State (enum.new Mode Fast)) (cursor 42i32)))))
			(return (struct.get (struct.get (local value) state) cursor))))
)
