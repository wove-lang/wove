	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only choose))
	(enum Mode (variants (Fast) (Safe)))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let mode (call (specialize choose (enum.new Mode Fast))))
			(return 42i32)))
)
