(module values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type (as Mode CallerMode)) (type (as Mode SameMode))))
	(use wove-file "./provider.wove" (only (type State) choose (as choose aliased_choose) forward make))

	(enum ProviderMode (variants (Fast) (Safe)))
	(struct ArgSpan (fields (start i32) (end i32)))

	(fn number (params (mode CallerMode)) (returns i32)
		(body
			(match (local mode)
				(case Fast (return 19i32))
				(case Safe (return 23i32)))))
	(fn fast (params (state (specialize State (enum.new SameMode Fast)))) (returns i32)
		(body (return (struct.get (local state) cursor))))
	(fn safe (params (state (specialize State (enum.new CallerMode Safe)))) (returns i32)
		(body (return (struct.get (local state) cursor))))

	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let fast_value (call (specialize choose (enum.new CallerMode Fast))))
			(let same_value (call (specialize aliased_choose (enum.new SameMode Fast))))
			(let safe_value (call (specialize forward (enum.new SameMode Safe))))
			(if (i32.not-eq (call number (local same_value)) 19i32) (then (return 1i32)))
			(let fast_state (call (specialize make (enum.new CallerMode Fast)) (call number (local fast_value))))
			(let safe_state (call (specialize make (enum.new CallerMode Safe)) (call number (local safe_value))))
			(return (i32.add (call fast (local fast_state)) (call safe (local safe_state))))))
)
