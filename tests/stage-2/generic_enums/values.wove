(module values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type (as Mode CallerMode)) (type (as Mode SameMode))))
	(use wove-file "./provider.wove" (only (type State) choose (as choose aliased_choose) forward make))

	(enum ProviderMode (variants (Fast) (Safe)))

	(fn number (params (mode CallerMode)) (returns i32)
		(body
			(match mode
				(case Fast (return 19i32))
				(case Safe (return 23i32)))))
	(fn fast (params (state (specialize State SameMode:Fast))) (returns i32)
		(body (return (struct:get state cursor))))
	(fn safe (params (state (specialize State CallerMode:Safe))) (returns i32)
		(body (return (struct:get state cursor))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let fast_value (call (specialize choose CallerMode:Fast)))
			(let same_value (call (specialize aliased_choose SameMode:Fast)))
			(let safe_value (call (specialize forward SameMode:Safe)))
			(if (i32:not-eq (call number same_value) 19i32) (then (return 1i32)))
			(let fast_state (call (specialize make CallerMode:Fast) (call number fast_value)))
			(let safe_state (call (specialize make CallerMode:Safe) (call number safe_value)))
			(return (i32:add (call fast fast_state) (call safe safe_state)))))
)
