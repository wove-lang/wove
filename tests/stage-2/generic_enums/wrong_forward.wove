(module wrong_forward
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only choose))
	(enum Decoy (variants (Fast) (Safe)))
	(fn forward (generic (const M Decoy)) (params) (returns i32)
		(body
			(let mode (call (specialize choose M)))
			(return 42i32)))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return (call (specialize forward (enum.new Decoy Fast))))))
)
