(module distinct_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type Mode)))
	(use wove-file "./provider.wove" (only (type State) make))
	(fn check (params (state (specialize State (enum:new Mode Fast)))) (returns i32)
		(body (return (struct:get state cursor))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let safe (call (specialize make (enum:new Mode Safe)) 42i32))
			(return (call check safe))))
)
