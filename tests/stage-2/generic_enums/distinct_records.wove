(module distinct_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type Mode)))
	(use wove-file "./provider.wove" (only (type State) make))
	(fn check (params (state (specialize State (enum.new Mode Fast)))) (returns i32)
		(body (return (struct.get (local state) cursor))))
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let safe (call (specialize make (enum.new Mode Safe)) 42i32))
			(return (call check (local safe)))))
)
