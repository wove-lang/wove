(module provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modes.wove" (only (type (as Mode ProviderMode))))

	(struct State (generic (const M ProviderMode)) (fields (cursor i32)))
	(fn choose (generic (const M ProviderMode)) (params) (returns ProviderMode)
		(body (return (local M))))
	(fn forward (generic (const M ProviderMode)) (params) (returns ProviderMode)
		(body (return (call (specialize choose M)))))
	(fn make (generic (const M ProviderMode)) (params (cursor i32)) (returns (specialize State M))
		(body (return (struct.new (specialize State M) (cursor (local cursor))))))
)
