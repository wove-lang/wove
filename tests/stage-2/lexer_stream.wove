	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(:doc `Check parity for signed atoms and raw strings.

	This literal includes "quotes", a backslash \path, the text ;;, and ``a backtick on each side``.
	Keep this indentation in the raw token.`)
	lexer_stream
	(fn
		(:expect lexer.stream_parity
			(issue "https:\/\/github.com\/wove-lang\/wove\/issues\/34"))
		main
		(params)
		(returns i32)
		(body
			(:doc "Keep the original spelling of a signed decimal token.")
			(return (i32 -42)))))
