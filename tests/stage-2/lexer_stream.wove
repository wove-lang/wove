	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(:doc "Check parity for signed atoms, escapes, and the literal text ;;.")
	lexer_stream
	(fn
		(:expect lexer.stream_parity
			(issue "https:\/\/github.com\/wove-lang\/wove\/issues\/34"))
		main
		(params)
		(returns i32)
		(body
			(:doc "Keep the original spelling of a signed decimal token.")
			(return (i32 -42)))))
