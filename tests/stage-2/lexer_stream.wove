;; Lexer parity keeps this leading comment.
(module lexer_stream
	(fn main
		(params)
		(returns i32)
		(expect lexer.stream_parity
			(issue "https:\/\/github.com\/wove-lang\/wove\/issues\/34"))
		;; Keep the original spelling of a signed decimal token.
		(body (return (i32 -42)))))
;; Lexer parity keeps this trailing comment.
