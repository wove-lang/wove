(module native_owner_factory
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type (as Handle Resource)) fixture_open))

	(fn make (params (scenario i32)) (returns Resource)
		(body
			(let-mut result (native.empty Resource))
			(let status (call fixture_open (borrow-mut result) scenario))
			(if (i32.ltz status) (then (return (move result))))
			(let-mut spare (native.empty Resource))
			(let acquired (call fixture_open (borrow-mut spare) 2i32))
			(return (move result))))
)
