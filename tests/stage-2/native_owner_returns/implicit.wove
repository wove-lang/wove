	(use c-header "./fixture.h" (only (type Handle)))

	(fn bad (params) (returns Handle)
		(body
			(let handle (native.empty Handle))
			(return (local handle))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 42i32)))
)
