(module native_owner_implicit_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./fixture.h" (only (type Handle)))

	(fn bad (params) (returns Handle)
		(body
			(let handle (native:empty Handle))
			(return handle)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32)))
)
