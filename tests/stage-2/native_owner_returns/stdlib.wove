(module native_owner_stdlib
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type (as File Stream)) fopen fgetc fclose))
	(use c-header "<dirent.h>" (only (type Directory) opendir dirfd closedir))

	(let mode "rb")
	(let existing_file "input.txt")
	(let existing_dir ".")
	(let missing "input.txt/absent")

	(fn open_stream (params (path (shared-array u8))) (returns Stream)
		(body (return (call fopen (borrow-shared (local path)) (borrow-shared (local mode))))))

	(fn open_dir (params (path (shared-array u8))) (returns Directory)
		(body
			(let directory (call opendir (borrow-shared (local path))))
			(return (move (local directory)))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let no_file (call open_stream (borrow-shared (local missing))))
			(let no_dir (call open_dir (borrow-shared (local missing))))
			(if (bool.or (bool.not (owner.is-null (local no_file))) (bool.not (owner.is-null (local no_dir))))
				(then (return 1i32)))
			(let file (call open_stream (borrow-shared (local existing_file))))
			(let directory (call open_dir (borrow-shared (local existing_dir))))
			(if (bool.or (owner.is-null (local file)) (owner.is-null (local directory))) (then (return 2i32)))
			(let first (call fgetc (borrow-shared (local file))))
			(if (i32.ltz (local first)) (then (return 3i32)))
			(if (i32.ltz (call dirfd (borrow-shared (local directory)))) (then (return 4i32)))
			(if (i32.not-eqz (call fclose (move (local file)))) (then (return 5i32)))
			(if (i32.not-eqz (call closedir (move (local directory)))) (then (return 6i32)))
			(return 42i32)))
)
