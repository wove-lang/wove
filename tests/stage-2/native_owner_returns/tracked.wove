(module native_owner_tracked
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./factory.wove" (only (as make make_handle)))
	(use c-header "./fixture.h" (only (type Handle) fixture_read fixture_drop fixture_opens fixture_drops fixture_live))

	(fn forward (params (scenario i32)) (returns Handle)
		(body (return (call make_handle scenario))))

	(fn read_then_drop (params (scenario i32)) (returns i32)
		(body
			(let handle (call forward scenario))
			(if (owner:is-null handle) (then (return 0i32)))
			(return (call fixture_read (borrow-shared handle)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eqz (call read_then_drop 0i32)) (then (return 1i32)))
			(if (i32:not-eqz (call fixture_drops)) (then (return 2i32)))
			(if (i32:not-eq (call read_then_drop 1i32) 42i32) (then (return 3i32)))
			(if (i32:not-eq (call fixture_drops) 2i32) (then (return 4i32)))
			(let handle (call forward 2i32))
			(if (i32:not-eq (call fixture_drops) 3i32) (then (return 5i32)))
			(if (i32:not-eq (call fixture_read (borrow-shared handle)) 42i32) (then (return 6i32)))
			(if (i32:not-eqz (call fixture_drop (move handle))) (then (return 7i32)))
			(if (i32:not-eq (call fixture_drops) 4i32) (then (return 8i32)))
			(if (i32:not-eq (call fixture_opens) 5i32) (then (return 9i32)))
			(if (i32:not-eqz (call fixture_live)) (then (return 10i32)))
			(return 42i32)))
)
