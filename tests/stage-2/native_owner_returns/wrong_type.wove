(module native_owner_wrong_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type File)))
	(use c-header "<dirent.h>" (only (type Directory)))

	(fn bad (params) (returns File)
		(body
			(let directory (native.empty Directory))
			(return (move (local directory)))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body (return 42i32)))
)
