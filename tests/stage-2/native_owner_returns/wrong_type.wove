(module native_owner_wrong_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only (type File)))
	(use c-header "<dirent.h>" (only (type Directory)))

	(fn bad (params) (returns File)
		(body
			(let directory (native.empty Directory))
			(return (move directory))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return 42i32)))
)
