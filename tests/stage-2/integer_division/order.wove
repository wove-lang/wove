(module integer_division_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn step (params (phase (mut-ref i32)) (expected i32) (value i32)) (returns i32)
		(body
			(if (i32.not-eq phase expected) (then (return 1i32)))
			(set phase (i32.add phase 1i32))
			(return value)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut phase 0i32)
			(if (i8.not-eq (i8.div
				(i8.from-i32 (call step (borrow-mut phase) 0i32 -13i32))
				(i8.from-i32 (call step (borrow-mut phase) 1i32 3i32))) -4i8)
				(then (return 1i32)))
			(if (u64.not-eq (u64.rem
				(u64.from-i32 (call step (borrow-mut phase) 2i32 13i32))
				(u64.from-i32 (call step (borrow-mut phase) 3i32 3i32))) 1u64)
				(then (return 2i32)))
			(if (i32.not-eq phase 4i32) (then (return 3i32)))
			(return 42i32)))
)
