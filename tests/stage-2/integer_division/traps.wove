(module integer_division_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct ArgSpan (fields (start i32) (end i32)))

	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (i32.eqz (array.len (local args))) (then (return 42i32)))
			(match (array.load (local bytes) 0i32)
				(case 97u8 (let result (i8.div 127i8 0i8)) (return 99i32))
				(case 98u8 (let result (i8.rem 127i8 0i8)) (return 99i32))
				(case 99u8 (let result (i8.div -128i8 -1i8)) (return 99i32))
				(case 100u8 (let result (u8.div 255u8 0u8)) (return 99i32))
				(case 101u8 (let result (u8.rem 255u8 0u8)) (return 99i32))
				(case 102u8 (let result (i16.div 32767i16 0i16)) (return 99i32))
				(case 103u8 (let result (i16.rem 32767i16 0i16)) (return 99i32))
				(case 104u8 (let result (i16.div -32768i16 -1i16)) (return 99i32))
				(case 105u8 (let result (u16.div 65535u16 0u16)) (return 99i32))
				(case 106u8 (let result (u16.rem 65535u16 0u16)) (return 99i32))
				(case 107u8 (let result (i32.div 2147483647i32 0i32)) (return 99i32))
				(case 108u8 (let result (i32.rem 2147483647i32 0i32)) (return 99i32))
				(case 109u8 (let result (i32.div -2147483648i32 -1i32)) (return 99i32))
				(case 110u8 (let result (u32.div 4294967295u32 0u32)) (return 99i32))
				(case 111u8 (let result (u32.rem 4294967295u32 0u32)) (return 99i32))
				(case 112u8 (let result (i64.div 9223372036854775807i64 0i64)) (return 99i32))
				(case 113u8 (let result (i64.rem 9223372036854775807i64 0i64)) (return 99i32))
				(case 114u8 (let result (i64.div -9223372036854775808i64 -1i64)) (return 99i32))
				(case 115u8 (let result (u64.div 18446744073709551615u64 0u64)) (return 99i32))
				(case 116u8 (let result (u64.rem 18446744073709551615u64 0u64)) (return 99i32))
				(case _ (return 98i32)))))
)
