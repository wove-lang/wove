(module integer_division_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn check_i8 (params (low i8) (high i8)) (returns bool)
		(body
			(if (i8:not-eq (i8:div low 3i8) -42i8) (then (return (bool false))))
			(if (i8:not-eq (i8:rem low 3i8) -2i8) (then (return (bool false))))
			(if (i8:not-eq (i8:div high -2i8) -63i8) (then (return (bool false))))
			(if (i8:not-eq (i8:rem high -2i8) 1i8) (then (return (bool false))))
			(if (i8:not-eq (i8:div low 1i8) -128i8) (then (return (bool false))))
			(if (i8:not-eq (i8:rem low 1i8) 0i8) (then (return (bool false))))
			(if (i8:not-eqz (i8:rem low -1i8)) (then (return (bool false))))
			(return (bool true))))

	(fn check_u8 (params (low u8) (high u8)) (returns bool)
		(body
			(if (u8:not-eq (u8:div high 2u8) 127u8) (then (return (bool false))))
			(if (u8:not-eq (u8:rem high 2u8) 1u8) (then (return (bool false))))
			(if (u8:not-eq (u8:div high 255u8) 1u8) (then (return (bool false))))
			(if (u8:not-eq (u8:rem high 255u8) 0u8) (then (return (bool false))))
			(if (u8:not-eq (u8:div low 1u8) 0u8) (then (return (bool false))))
			(if (u8:not-eq (u8:rem low 1u8) 0u8) (then (return (bool false))))
			(return (bool true))))

	(fn check_i16 (params (low i16) (high i16)) (returns bool)
		(body
			(if (i16:not-eq (i16:div low 3i16) -10922i16) (then (return (bool false))))
			(if (i16:not-eq (i16:rem low 3i16) -2i16) (then (return (bool false))))
			(if (i16:not-eq (i16:div high -2i16) -16383i16) (then (return (bool false))))
			(if (i16:not-eq (i16:rem high -2i16) 1i16) (then (return (bool false))))
			(if (i16:not-eq (i16:div low 1i16) -32768i16) (then (return (bool false))))
			(if (i16:not-eq (i16:rem low 1i16) 0i16) (then (return (bool false))))
			(if (i16:not-eqz (i16:rem low -1i16)) (then (return (bool false))))
			(return (bool true))))

	(fn check_u16 (params (low u16) (high u16)) (returns bool)
		(body
			(if (u16:not-eq (u16:div high 2u16) 32767u16) (then (return (bool false))))
			(if (u16:not-eq (u16:rem high 2u16) 1u16) (then (return (bool false))))
			(if (u16:not-eq (u16:div high 65535u16) 1u16) (then (return (bool false))))
			(if (u16:not-eq (u16:rem high 65535u16) 0u16) (then (return (bool false))))
			(if (u16:not-eq (u16:div low 1u16) 0u16) (then (return (bool false))))
			(if (u16:not-eq (u16:rem low 1u16) 0u16) (then (return (bool false))))
			(return (bool true))))

	(fn check_i32 (params (low i32) (high i32)) (returns bool)
		(body
			(if (i32:not-eq (i32:div low 3i32) -715827882i32) (then (return (bool false))))
			(if (i32:not-eq (i32:rem low 3i32) -2i32) (then (return (bool false))))
			(if (i32:not-eq (i32:div high -2i32) -1073741823i32) (then (return (bool false))))
			(if (i32:not-eq (i32:rem high -2i32) 1i32) (then (return (bool false))))
			(if (i32:not-eq (i32:div low 1i32) -2147483648i32) (then (return (bool false))))
			(if (i32:not-eq (i32:rem low 1i32) 0i32) (then (return (bool false))))
			(if (i32:not-eqz (i32:rem low -1i32)) (then (return (bool false))))
			(return (bool true))))

	(fn check_u32 (params (low u32) (high u32)) (returns bool)
		(body
			(if (u32:not-eq (u32:div high 2u32) 2147483647u32) (then (return (bool false))))
			(if (u32:not-eq (u32:rem high 2u32) 1u32) (then (return (bool false))))
			(if (u32:not-eq (u32:div high 4294967295u32) 1u32) (then (return (bool false))))
			(if (u32:not-eq (u32:rem high 4294967295u32) 0u32) (then (return (bool false))))
			(if (u32:not-eq (u32:div low 1u32) 0u32) (then (return (bool false))))
			(if (u32:not-eq (u32:rem low 1u32) 0u32) (then (return (bool false))))
			(return (bool true))))

	(fn check_i64 (params (low i64) (high i64)) (returns bool)
		(body
			(if (i64:not-eq (i64:div low 3i64) -3074457345618258602i64) (then (return (bool false))))
			(if (i64:not-eq (i64:rem low 3i64) -2i64) (then (return (bool false))))
			(if (i64:not-eq (i64:div high -2i64) -4611686018427387903i64) (then (return (bool false))))
			(if (i64:not-eq (i64:rem high -2i64) 1i64) (then (return (bool false))))
			(if (i64:not-eq (i64:div low 1i64) -9223372036854775808i64) (then (return (bool false))))
			(if (i64:not-eq (i64:rem low 1i64) 0i64) (then (return (bool false))))
			(if (i64:not-eqz (i64:rem low -1i64)) (then (return (bool false))))
			(return (bool true))))

	(fn check_u64 (params (low u64) (high u64)) (returns bool)
		(body
			(if (u64:not-eq (u64:div high 2u64) 9223372036854775807u64) (then (return (bool false))))
			(if (u64:not-eq (u64:rem high 2u64) 1u64) (then (return (bool false))))
			(if (u64:not-eq (u64:div high 18446744073709551615u64) 1u64) (then (return (bool false))))
			(if (u64:not-eq (u64:rem high 18446744073709551615u64) 0u64) (then (return (bool false))))
			(if (u64:not-eq (u64:div low 1u64) 0u64) (then (return (bool false))))
			(if (u64:not-eq (u64:rem low 1u64) 0u64) (then (return (bool false))))
			(return (bool true))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(:expect (issues "gh:wove-lang/wove:310"))
		(body
			(if (bool:not (call check_i8 -128i8 127i8)) (then (return 1i32)))
			(if (bool:not (call check_u8 0u8 255u8)) (then (return 2i32)))
			(if (bool:not (call check_i16 -32768i16 32767i16)) (then (return 3i32)))
			(if (bool:not (call check_u16 0u16 65535u16)) (then (return 4i32)))
			(if (bool:not (call check_i32 -2147483648i32 2147483647i32)) (then (return 5i32)))
			(if (bool:not (call check_u32 0u32 4294967295u32)) (then (return 6i32)))
			(if (bool:not (call check_i64 -9223372036854775808i64 9223372036854775807i64)) (then (return 7i32)))
			(if (bool:not (call check_u64 0u64 18446744073709551615u64)) (then (return 8i32)))
			(return 42i32)))
)
