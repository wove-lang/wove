(module expectations_root
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./shared.wove" (only (as shared from_shared)))
	(use wove-file "./alias.wove" (only))

	(fn first
		(:expect (issues "gh:owner/repo:7" "https://github.com/owner/repo/issues/7")
			(tests "stage-2/expectations/fast.tsv"))
		(params)
		(:expect (tests "stage-2/expectations/slow.tsv"))
		(returns i32)
		(body (return (:expect (issues "gh:owner/repo:7")) 42i32)))

	(decls
		(fn second
			(:expect (issues "gh:owner/repo:7" "gh:owner/repo:7")
				(tests "stage-2/expectations/\u0066ast.tsv"))
			(params) (returns i32)
			(body (return 0i32))))

	(struct Evidence (:expect (issues "gh:owner/repo:7")) (fields (result i32)))

	(let value (:expect (tests `stage-2/expectations/fast.tsv`)) 42i32)

	(fn plain (params) (returns i32) (body (return 0i32)))

	(fn inactive (:pragma (cfg bootstrap))
		(:expect (issues "gh:owner/repo:7"))
		(params) (returns i32) (body (return 0i32)))

	(disabled example
		(fn hidden (:expect (issues "gh:owner/repo:7"))
			(params) (returns i32) (body (return 0i32)))))
