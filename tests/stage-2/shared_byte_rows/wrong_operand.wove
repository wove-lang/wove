(module shared_byte_rows_wrong_operand
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn count
		(params (rows (shared-array (shared-array u8))))
		(returns i32)
		(body (return (array.len (local rows)))))

	(fn wrong_operand
		(params (rows (shared-array (owned-array u8))))
		(returns i32)
		(body (return (call count (borrow-shared (local rows))))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body (return 0i32))))
