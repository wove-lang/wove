(module shared_byte_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<tests/stage-2/shared_byte_rows/probe.h>"
		(fn probe_shared_byte_rows (params (argc i32)) (returns i32)))

	(use c-header "<tests/stage-2/shared_byte_rows/probe.h>" (only probe_shared_byte_rows))

	(fn size (params (row (shared-array u8))) (returns i32)
		(body (return (array:len row))))

	(fn pick
		(params (rows (shared-array (shared-array u8))) (index i32))
		(returns (shared-array u8) (from rows))
		(body (return (array:get rows index))))

	(fn pick_from_alias
		(params (rows (shared-array (shared-array u8))))
		(returns (shared-array u8) (from rows))
		(body
			(let alias (borrow-shared rows))
			(let row (array:get alias 2i32))
			(return (borrow-shared row))))

	(fn verify_rows
		(params (rows (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (i32:not-eq (array:len rows) 3i32) (then (return 1i32)))
			(let row (array:get rows 0i32))
			(if (i32:not-eq (call size (borrow-shared row)) 3i32) (then (return 2i32)))
			(if (u8:not-eq (array:get row 0i32) 0u8) (then (return 3i32)))
			(if (u8:not-eq (array:get row 1i32) 32u8) (then (return 4i32)))
			(if (u8:not-eq (array:get (array:get rows 0i32) 2i32) 255u8) (then (return 5i32)))
			(if (i32:not-eq (call size (borrow-shared (array:get rows 1i32))) 0i32) (then (return 6i32)))
			(let empty (call pick (borrow-shared rows) 1i32))
			(if (i32:not-eq (array:len empty) 0i32) (then (return 7i32)))
			(let last (call pick_from_alias (borrow-shared rows)))
			(return (i32:from-u8 (array:get last 0i32)))))

	(fn check_rows
		(params (rows (shared-array (shared-array u8))) (argc i32))
		(returns i32)
		(body
			(if (i32:eq argc 0i32)
				(then (return (call verify_rows (borrow-shared rows)))))
			(if (i32:eq argc 1i32)
				(then (return (array:len (array:get rows 3i32)))))
			(if (i32:eq argc 2i32)
				(then (return (array:len (array:get rows -1i32)))))
			(if (i32:eq argc 3i32)
				(then (return (i32:from-u8 (array:get (array:get rows 1i32) 0i32)))))
			(return (array:len rows))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return (call probe_shared_byte_rows (i32:dec (array:len spans)))))))
