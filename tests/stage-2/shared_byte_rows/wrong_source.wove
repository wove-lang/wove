(module shared_byte_rows_wrong_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn wrong_source
		(params (left (shared-array (shared-array u8))) (right (shared-array (shared-array u8))))
		(returns (shared-array u8) (from left))
		(body
			(let row (array.load (local right) 0i32))
			(return (borrow-shared (local row)))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body (return 0i32))))
