(module shared_byte_rows_wrong_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn wrong_source
		(params (left (shared-array (shared-array u8))) (right (shared-array (shared-array u8))))
		(returns (shared-array u8) (from left))
		(body
			(let row (array:load right 0i32))
			(return (borrow-shared row))))

	(fn main
		(params (spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return 0i32))))
