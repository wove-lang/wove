(module shared_byte_rows_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write
		(params (rows (shared-array (shared-array u8))))
		(returns void)
		(body
			(let row (array.load (local rows) 0i32))
			(array.store (local row) 0i32 42u8)))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (bytes (shared-array u8)) (spans (shared-array ArgSpan)))
		(returns i32)
		(body (return 0i32))))
