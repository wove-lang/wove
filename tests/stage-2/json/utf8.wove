(module json_utf8_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/text/utf8.wove" (only utf8_invalid_offset))

	(fn fill_cases
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(slice.store
				(:doc "ASCII limits and the first and last scalars of every multibyte range.")
				(local bytes) (i32 0) (u8 0))
			(slice.store (local bytes) (i32 1) (u8 127))
			(slice.store (local bytes) (i32 2) (u8 194))
			(slice.store (local bytes) (i32 3) (u8 128))
			(slice.store (local bytes) (i32 4) (u8 223))
			(slice.store (local bytes) (i32 5) (u8 191))
			(slice.store (local bytes) (i32 6) (u8 224))
			(slice.store (local bytes) (i32 7) (u8 160))
			(slice.store (local bytes) (i32 8) (u8 128))
			(slice.store (local bytes) (i32 9) (u8 237))
			(slice.store (local bytes) (i32 10) (u8 159))
			(slice.store (local bytes) (i32 11) (u8 191))
			(slice.store (local bytes) (i32 12) (u8 238))
			(slice.store (local bytes) (i32 13) (u8 128))
			(slice.store (local bytes) (i32 14) (u8 128))
			(slice.store (local bytes) (i32 15) (u8 240))
			(slice.store (local bytes) (i32 16) (u8 144))
			(slice.store (local bytes) (i32 17) (u8 128))
			(slice.store (local bytes) (i32 18) (u8 128))
			(slice.store (local bytes) (i32 19) (u8 244))
			(slice.store (local bytes) (i32 20) (u8 143))
			(slice.store (local bytes) (i32 21) (u8 191))
			(slice.store (local bytes) (i32 22) (u8 191))

			(slice.store
				(:doc "A stray continuation after ASCII.")
				(local bytes) (i32 23) (u8 65))
			(slice.store (local bytes) (i32 24) (u8 128))

			(slice.store
				(:doc "A truncated four-byte scalar after a complete two-byte scalar.")
				(local bytes) (i32 25) (u8 194))
			(slice.store (local bytes) (i32 26) (u8 128))
			(slice.store (local bytes) (i32 27) (u8 240))
			(slice.store (local bytes) (i32 28) (u8 144))
			(slice.store (local bytes) (i32 29) (u8 128))

			(slice.store
				(:doc "A two-byte overlong form.")
				(local bytes) (i32 30) (u8 192))
			(slice.store (local bytes) (i32 31) (u8 128))

			(slice.store
				(:doc "The byte before the legal E0 range.")
				(local bytes) (i32 32) (u8 224))
			(slice.store (local bytes) (i32 33) (u8 159))
			(slice.store (local bytes) (i32 34) (u8 191))

			(slice.store
				(:doc "The start of the surrogate range.")
				(local bytes) (i32 35) (u8 237))
			(slice.store (local bytes) (i32 36) (u8 160))
			(slice.store (local bytes) (i32 37) (u8 128))

			(slice.store
				(:doc "The byte before the legal F0 range.")
				(local bytes) (i32 38) (u8 240))
			(slice.store (local bytes) (i32 39) (u8 143))
			(slice.store (local bytes) (i32 40) (u8 191))
			(slice.store (local bytes) (i32 41) (u8 191))

			(slice.store
				(:doc "The first scalar above U+10FFFF.")
				(local bytes) (i32 42) (u8 244))
			(slice.store (local bytes) (i32 43) (u8 144))
			(slice.store (local bytes) (i32 44) (u8 128))
			(slice.store (local bytes) (i32 45) (u8 128))

			(slice.store
				(:doc "A non-continuation in the final slot.")
				(local bytes) (i32 46) (u8 65))
			(slice.store (local bytes) (i32 47) (u8 225))
			(slice.store (local bytes) (i32 48) (u8 128))
			(slice.store (local bytes) (i32 49) (u8 64))
		))

	(fn main
		(:expect
			(tests "stage-2/json/utf8.wove")
			(issues "gh:wove-lang/wove:117"))
		(params)
		(returns i32)
		(body
			(let-mut bytes (array.alloc u8 (i32 50)))
			(call fill_cases (borrow-mut (local bytes)))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 0) (i32 23))))
					(i32 -1)))
				(then (return (i32 1))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 23) (i32 25))))
					(i32 1)))
				(then (return (i32 2))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 25) (i32 30))))
					(i32 2)))
				(then (return (i32 3))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 30) (i32 32))))
					(i32 0)))
				(then (return (i32 4))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 32) (i32 35))))
					(i32 0)))
				(then (return (i32 5))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 35) (i32 38))))
					(i32 0)))
				(then (return (i32 6))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 38) (i32 42))))
					(i32 0)))
				(then (return (i32 7))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 42) (i32 46))))
					(i32 0)))
				(then (return (i32 8))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 46) (i32 50))))
					(i32 1)))
				(then (return (i32 9))))
			(if (bool.not (i32.eq
					(call utf8_invalid_offset (borrow-shared (slice.range (local bytes) (i32 0) (i32 0))))
					(i32 -1)))
				(then (return (i32 10))))
			(return (i32 0)))))
