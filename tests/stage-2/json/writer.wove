(module json_writer_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/json/writer.wove"
		(only (type JsonWriter) json_writer json_begin_object json_end_object json_begin_array json_end_array
			json_key json_string json_i32 json_u32 json_bool json_null json_finish))

	(fn match_byte
		(params (bytes (shared-array u8)) (index i32) (expected u8))
		(returns bool)
		(body (return (u8.eq (array.load bytes index) expected))))

	(fn match_four
		(params (bytes (shared-array u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns bool)
		(body
			(return (bool.and
				(call match_byte (borrow-shared bytes) start a)
				(bool.and
					(call match_byte (borrow-shared bytes) (i32.add start (i32 1)) b)
					(bool.and
						(call match_byte (borrow-shared bytes) (i32.add start (i32 2)) c)
						(call match_byte (borrow-shared bytes) (i32.add start (i32 3)) d)))))))

	(fn matches_document
		(:doc "{\"message\":\"quote \\\" \\\\ \\u0000\\u000a\\u001f é🙂\",\"spans\":[{\"lo\":-2147483648,\"hi\":4294967295},2147483647,0,true,false,null,[],{}],\"\\\"\\\\\":\"\"}")
		(params (bytes (shared-array u8)))
		(returns bool)
		(body
			(if (bool.not (call match_four (borrow-shared bytes) (i32 0) (u8 123) (u8 34) (u8 109) (u8 101))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 4) (u8 115) (u8 115) (u8 97) (u8 103))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 8) (u8 101) (u8 34) (u8 58) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 12) (u8 113) (u8 117) (u8 111) (u8 116))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 16) (u8 101) (u8 32) (u8 92) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 20) (u8 32) (u8 92) (u8 92) (u8 32))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 24) (u8 92) (u8 117) (u8 48) (u8 48))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 28) (u8 48) (u8 48) (u8 92) (u8 117))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 32) (u8 48) (u8 48) (u8 48) (u8 97))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 36) (u8 92) (u8 117) (u8 48) (u8 48))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 40) (u8 49) (u8 102) (u8 32) (u8 195))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 44) (u8 169) (u8 240) (u8 159) (u8 153))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 48) (u8 130) (u8 34) (u8 44) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 52) (u8 115) (u8 112) (u8 97) (u8 110))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 56) (u8 115) (u8 34) (u8 58) (u8 91))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 60) (u8 123) (u8 34) (u8 108) (u8 111))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 64) (u8 34) (u8 58) (u8 45) (u8 50))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 68) (u8 49) (u8 52) (u8 55) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 72) (u8 56) (u8 51) (u8 54) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 76) (u8 56) (u8 44) (u8 34) (u8 104))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 80) (u8 105) (u8 34) (u8 58) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 84) (u8 50) (u8 57) (u8 52) (u8 57))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 88) (u8 54) (u8 55) (u8 50) (u8 57))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 92) (u8 53) (u8 125) (u8 44) (u8 50))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 96) (u8 49) (u8 52) (u8 55) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 100) (u8 56) (u8 51) (u8 54) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 104) (u8 55) (u8 44) (u8 48) (u8 44))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 108) (u8 116) (u8 114) (u8 117) (u8 101))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 112) (u8 44) (u8 102) (u8 97) (u8 108))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 116) (u8 115) (u8 101) (u8 44) (u8 110))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 120) (u8 117) (u8 108) (u8 108) (u8 44))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 124) (u8 91) (u8 93) (u8 44) (u8 123))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 128) (u8 125) (u8 93) (u8 44) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 132) (u8 92) (u8 34) (u8 92) (u8 92))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared bytes) (i32 136) (u8 34) (u8 58) (u8 34) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_byte (borrow-shared bytes) (i32 140) (u8 125))) (then (return (bool false))))
			(return (bool true))))

	(fn fill_text
		(params (text (mut-array u8)))
		(returns void)
		(body
			(let
				(:doc "message")
				start_0 (i32 0))
			(array.store text start_0 (u8 109))
			(array.store text (i32 1) (u8 101))
			(array.store text (i32 2) (u8 115))
			(array.store text (i32 3) (u8 115))
			(array.store text (i32 4) (u8 97))
			(array.store text (i32 5) (u8 103))
			(array.store text (i32 6) (u8 101))
			(let
				(:doc "quote \" \\ \u0000\n\u001f é🙂")
				start_7 (i32 7))
			(array.store text start_7 (u8 113))
			(array.store text (i32 8) (u8 117))
			(array.store text (i32 9) (u8 111))
			(array.store text (i32 10) (u8 116))
			(array.store text (i32 11) (u8 101))
			(array.store text (i32 12) (u8 32))
			(array.store text (i32 13) (u8 34))
			(array.store text (i32 14) (u8 32))
			(array.store text (i32 15) (u8 92))
			(array.store text (i32 16) (u8 32))
			(array.store text (i32 17) (u8 0))
			(array.store text (i32 18) (u8 10))
			(array.store text (i32 19) (u8 31))
			(array.store text (i32 20) (u8 32))
			(array.store text (i32 21) (u8 195))
			(array.store text (i32 22) (u8 169))
			(array.store text (i32 23) (u8 240))
			(array.store text (i32 24) (u8 159))
			(array.store text (i32 25) (u8 153))
			(array.store text (i32 26) (u8 130))
			(let
				(:doc "spans")
				start_27 (i32 27))
			(array.store text start_27 (u8 115))
			(array.store text (i32 28) (u8 112))
			(array.store text (i32 29) (u8 97))
			(array.store text (i32 30) (u8 110))
			(array.store text (i32 31) (u8 115))
			(let
				(:doc "lo")
				start_32 (i32 32))
			(array.store text start_32 (u8 108))
			(array.store text (i32 33) (u8 111))
			(let
				(:doc "hi")
				start_34 (i32 34))
			(array.store text start_34 (u8 104))
			(array.store text (i32 35) (u8 105))
			(let
				(:doc "\"\\")
				start_36 (i32 36))
			(array.store text start_36 (u8 34))
			(array.store text (i32 37) (u8 92))))

	(fn main
		(:expect
			(tests "stage-2/json/writer.wove")
			(issues "gh:wove-lang/wove:117"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut text (array.alloc u8 (i32 38)))
			(call fill_text (borrow-mut text))
			(let-mut output (array.alloc u8 (i32 141)))
			(let-mut stack (array.alloc u8 (i32 3)))
			(let state_0 (call json_writer))
			(let state_1 (call json_begin_object state_0 (borrow-mut output) (borrow-mut stack)))
			(let state_2 (call json_key state_1 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 0) (i32 7)))))
			(let state_3 (call json_string state_2 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 7) (i32 27)))))
			(let state_4 (call json_key state_3 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 27) (i32 32)))))
			(let state_5 (call json_begin_array state_4 (borrow-mut output) (borrow-mut stack)))
			(let state_6 (call json_begin_object state_5 (borrow-mut output) (borrow-mut stack)))
			(let state_7 (call json_key state_6 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 32) (i32 34)))))
			(let state_8 (call json_i32 state_7 (borrow-mut output) (borrow-mut stack)
				(i32 -2147483648)))
			(let state_9 (call json_key state_8 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 34) (i32 36)))))
			(let state_10 (call json_u32 state_9 (borrow-mut output) (borrow-mut stack)
				(u32 4294967295)))
			(let state_11 (call json_end_object state_10 (borrow-mut output) (borrow-shared stack)))
			(let state_12 (call json_i32 state_11 (borrow-mut output) (borrow-mut stack)
				(i32 2147483647)))
			(let state_13 (call json_u32 state_12 (borrow-mut output) (borrow-mut stack)
				(u32 0)))
			(let state_14 (call json_bool state_13 (borrow-mut output) (borrow-mut stack)
				(bool true)))
			(let state_15 (call json_bool state_14 (borrow-mut output) (borrow-mut stack)
				(bool false)))
			(let state_16 (call json_null state_15 (borrow-mut output) (borrow-mut stack)))
			(let state_17 (call json_begin_array state_16 (borrow-mut output) (borrow-mut stack)))
			(let state_18 (call json_end_array state_17 (borrow-mut output) (borrow-shared stack)))
			(let state_19 (call json_begin_object state_18 (borrow-mut output) (borrow-mut stack)))
			(let state_20 (call json_end_object state_19 (borrow-mut output) (borrow-shared stack)))
			(let state_21 (call json_end_array state_20 (borrow-mut output) (borrow-shared stack)))
			(let state_22 (call json_key state_21 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 36) (i32 38)))))
			(let state_23 (call json_string state_22 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array.range text (i32 38) (i32 38)))))
			(let state_24 (call json_end_object state_23 (borrow-mut output) (borrow-shared stack)))
			(let state_25 (call json_finish state_24))
			(if (bool.not (u32.eq (struct.get state_25 error) (u32 0))) (then (return (i32 1))))
			(if (bool.not (i32.eq (struct.get state_25 written) (i32 141))) (then (return (i32 2))))
			(if (bool.not (call matches_document (borrow-shared output))) (then (return (i32 3))))
			(return (i32 0)))))
