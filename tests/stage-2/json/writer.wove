			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 92) (u8 53) (u8 125) (u8 44) (u8 50))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 96) (u8 49) (u8 52) (u8 55) (u8 52))) (then (return (bool false))))
