			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 64) (u8 34) (u8 58) (u8 45) (u8 50))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 68) (u8 49) (u8 52) (u8 55) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 72) (u8 56) (u8 51) (u8 54) (u8 52))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 76) (u8 56) (u8 44) (u8 34) (u8 104))) (then (return (bool false))))
