			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 44) (u8 169) (u8 240) (u8 159) (u8 153))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 48) (u8 130) (u8 34) (u8 44) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 52) (u8 115) (u8 112) (u8 97) (u8 110))) (then (return (bool false))))
