			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 104) (u8 55) (u8 44) (u8 48) (u8 44))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 108) (u8 116) (u8 114) (u8 117) (u8 101))) (then (return (bool false))))
