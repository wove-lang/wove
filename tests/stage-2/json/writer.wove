			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 124) (u8 91) (u8 93) (u8 44) (u8 123))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 128) (u8 125) (u8 93) (u8 44) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 132) (u8 92) (u8 34) (u8 92) (u8 92))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 136) (u8 34) (u8 58) (u8 34) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_byte (borrow-shared (local bytes)) (i32 140) (u8 125))) (then (return (bool false))))
			(return (bool true))))

	(fn fill_text
		(params (text (mut-slice u8)))
		(returns void)
		(body
			(let
				(:doc "message")
				start_0 (i32 0))
			(slice.store (local text) (local start_0) (u8 109))
			(slice.store (local text) (i32 1) (u8 101))
			(slice.store (local text) (i32 2) (u8 115))
			(slice.store (local text) (i32 3) (u8 115))
			(slice.store (local text) (i32 4) (u8 97))
			(slice.store (local text) (i32 5) (u8 103))
			(slice.store (local text) (i32 6) (u8 101))
			(let
				(:doc "quote \" \\ \u0000\n\u001f é🙂")
				start_7 (i32 7))
			(slice.store (local text) (local start_7) (u8 113))
			(slice.store (local text) (i32 8) (u8 117))
			(slice.store (local text) (i32 9) (u8 111))
			(slice.store (local text) (i32 10) (u8 116))
			(slice.store (local text) (i32 11) (u8 101))
			(slice.store (local text) (i32 12) (u8 32))
			(slice.store (local text) (i32 13) (u8 34))
			(slice.store (local text) (i32 14) (u8 32))
			(slice.store (local text) (i32 15) (u8 92))
			(slice.store (local text) (i32 16) (u8 32))
			(slice.store (local text) (i32 17) (u8 0))
			(slice.store (local text) (i32 18) (u8 10))
			(slice.store (local text) (i32 19) (u8 31))
			(slice.store (local text) (i32 20) (u8 32))
			(slice.store (local text) (i32 21) (u8 195))
			(slice.store (local text) (i32 22) (u8 169))
			(slice.store (local text) (i32 23) (u8 240))
			(slice.store (local text) (i32 24) (u8 159))
			(slice.store (local text) (i32 25) (u8 153))
			(slice.store (local text) (i32 26) (u8 130))
			(let
				(:doc "spans")
				start_27 (i32 27))
			(slice.store (local text) (local start_27) (u8 115))
			(slice.store (local text) (i32 28) (u8 112))
			(slice.store (local text) (i32 29) (u8 97))
			(slice.store (local text) (i32 30) (u8 110))
			(slice.store (local text) (i32 31) (u8 115))
			(let
				(:doc "lo")
				start_32 (i32 32))
			(slice.store (local text) (local start_32) (u8 108))
			(slice.store (local text) (i32 33) (u8 111))
			(let
				(:doc "hi")
				start_34 (i32 34))
			(slice.store (local text) (local start_34) (u8 104))
			(slice.store (local text) (i32 35) (u8 105))
			(let
				(:doc "\"\\")
				start_36 (i32 36))
			(slice.store (local text) (local start_36) (u8 34))
			(slice.store (local text) (i32 37) (u8 92))))

	(fn
		(:expect json.writer_document (issue "https://github.com/wove-lang/wove/issues/117"))
		main
		(params)
		(returns i32)
		(body
			(let-mut text (array.alloc u8 (i32 38)))
			(call fill_text (borrow-mut (local text)))
			(let-mut output (array.alloc u8 (i32 141)))
			(let-mut stack (array.alloc u8 (i32 3)))
			(let state_0 (call json_writer))
			(let state_1 (call json_begin_object (local state_0) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let state_2 (call json_key (local state_1) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 0) (i32 7)))))
			(let state_3 (call json_string (local state_2) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 7) (i32 27)))))
			(let state_4 (call json_key (local state_3) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 27) (i32 32)))))
			(let state_5 (call json_begin_array (local state_4) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let state_6 (call json_begin_object (local state_5) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let state_7 (call json_key (local state_6) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 32) (i32 34)))))
			(let state_8 (call json_i32 (local state_7) (borrow-mut (local output)) (borrow-mut (local stack))
				(i32 -2147483648)))
			(let state_9 (call json_key (local state_8) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 34) (i32 36)))))
			(let state_10 (call json_u32 (local state_9) (borrow-mut (local output)) (borrow-mut (local stack))
				(u32 4294967295)))
			(let state_11 (call json_end_object (local state_10) (borrow-mut (local output)) (borrow-shared (local stack))))
			(let state_12 (call json_i32 (local state_11) (borrow-mut (local output)) (borrow-mut (local stack))
				(i32 2147483647)))
			(let state_13 (call json_u32 (local state_12) (borrow-mut (local output)) (borrow-mut (local stack))
				(u32 0)))
			(let state_14 (call json_bool (local state_13) (borrow-mut (local output)) (borrow-mut (local stack))
				(bool true)))
			(let state_15 (call json_bool (local state_14) (borrow-mut (local output)) (borrow-mut (local stack))
				(bool false)))
			(let state_16 (call json_null (local state_15) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let state_17 (call json_begin_array (local state_16) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let state_18 (call json_end_array (local state_17) (borrow-mut (local output)) (borrow-shared (local stack))))
			(let state_19 (call json_begin_object (local state_18) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let state_20 (call json_end_object (local state_19) (borrow-mut (local output)) (borrow-shared (local stack))))
			(let state_21 (call json_end_array (local state_20) (borrow-mut (local output)) (borrow-shared (local stack))))
			(let state_22 (call json_key (local state_21) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 36) (i32 38)))))
			(let state_23 (call json_string (local state_22) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local text) (i32 38) (i32 38)))))
			(let state_24 (call json_end_object (local state_23) (borrow-mut (local output)) (borrow-shared (local stack))))
			(let state_25 (call json_finish (local state_24)))
			(if (bool.not (u32.eq (record.get (local state_25) error) (u32 0))) (then (return (i32 1))))
			(if (bool.not (i32.eq (record.get (local state_25) written) (i32 141))) (then (return (i32 2))))
			(if (bool.not (call matches_document (borrow-shared (local output)))) (then (return (i32 3))))
			(return (i32 0)))))
