	json_writer_fixture

	(use wove-file "../../../stage-2/json/writer.wove"
		(only (type JsonWriter) json_writer json_begin_object json_end_object json_begin_array json_end_array
			json_key json_string json_i32 json_u32 json_bool json_null json_finish))

	(fn match_byte
		(params (bytes (shared-slice u8)) (index i32) (expected u8))
		(returns bool)
		(body (return (u8.eq (slice.load (local bytes) (local index)) (local expected)))))

	(fn match_four
		(params (bytes (shared-slice u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns bool)
		(body
			(return (bool.and
				(call match_byte (borrow-shared (local bytes)) (local start) (local a))
				(bool.and
					(call match_byte (borrow-shared (local bytes)) (i32.add.wrapping (local start) (i32 1)) (local b))
					(bool.and
						(call match_byte (borrow-shared (local bytes)) (i32.add.wrapping (local start) (i32 2)) (local c))
						(call match_byte (borrow-shared (local bytes)) (i32.add.wrapping (local start) (i32 3)) (local d))))))))

	(fn
		(:doc "{\"message\":\"quote \\\" \\\\ \\u0000\\u000a\\u001f é🙂\",\"spans\":[{\"lo\":-2147483648,\"hi\":4294967295},2147483647,0,true,false,null,[],{}],\"\\\"\\\\\":\"\"}")
		matches_document
		(params (bytes (shared-slice u8)))
		(returns bool)
		(body
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 0) (u8 123) (u8 34) (u8 109) (u8 101))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 4) (u8 115) (u8 115) (u8 97) (u8 103))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 8) (u8 101) (u8 34) (u8 58) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 12) (u8 113) (u8 117) (u8 111) (u8 116))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 16) (u8 101) (u8 32) (u8 92) (u8 34))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 20) (u8 32) (u8 92) (u8 92) (u8 32))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 24) (u8 92) (u8 117) (u8 48) (u8 48))) (then (return (bool false))))
			(if (bool.not (call match_four (borrow-shared (local bytes)) (i32 28) (u8 48) (u8 48) (u8 92) (u8 117))) (then (return (bool false))))
