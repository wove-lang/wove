(module jsonc_reader_errors_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/json/reader.wove"
		(only (type JsonNode) json_parse))

	(fn put_four
		(params (source (mut-array u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(array.store (local source) (local start) (local a))
			(array.store (local source) (i32.add.wrapping (local start) (i32 1)) (local b))
			(array.store (local source) (i32.add.wrapping (local start) (i32 2)) (local c))
			(array.store (local source) (i32.add.wrapping (local start) (i32 3)) (local d))))

	(fn fill_inputs
		(params (source (mut-array u8)))
		(returns void)
		(body
			(array.store
				(:doc "/*")
				(local source) (i32 0) (u8 47))
			(array.store (local source) (i32 1) (u8 42))

			(call
				(:doc "[1,]")
				put_four (borrow-mut (local source)) (i32 2) (u8 91) (u8 49) (u8 44) (u8 93))

			(call
				(:doc "{\"a\":0,}")
				put_four (borrow-mut (local source)) (i32 6) (u8 123) (u8 34) (u8 97) (u8 34))
			(call put_four (borrow-mut (local source)) (i32 10) (u8 58) (u8 48) (u8 44) (u8 125))

			(call
				(:doc "{\"a\" 0}")
				put_four (borrow-mut (local source)) (i32 14) (u8 123) (u8 34) (u8 97) (u8 34))
			(array.store (local source) (i32 18) (u8 32))
			(array.store (local source) (i32 19) (u8 48))
			(array.store (local source) (i32 20) (u8 125))

			(call
				(:doc "[1 2]")
				put_four (borrow-mut (local source)) (i32 21) (u8 91) (u8 49) (u8 32) (u8 50))
			(array.store (local source) (i32 25) (u8 93))

			(call
				(:doc "true false")
				put_four (borrow-mut (local source)) (i32 26) (u8 116) (u8 114) (u8 117) (u8 101))
			(call put_four (borrow-mut (local source)) (i32 30) (u8 32) (u8 102) (u8 97) (u8 108))
			(array.store (local source) (i32 34) (u8 115))
			(array.store (local source) (i32 35) (u8 101))

			(call
				(:doc "null/*")
				put_four (borrow-mut (local source)) (i32 36) (u8 110) (u8 117) (u8 108) (u8 108))
			(array.store (local source) (i32 40) (u8 47))
			(array.store (local source) (i32 41) (u8 42))

			(array.store
				(:doc "01")
				(local source) (i32 42) (u8 48))
			(array.store (local source) (i32 43) (u8 49))

			(array.store
				(:doc "1.")
				(local source) (i32 44) (u8 49))
			(array.store (local source) (i32 45) (u8 46))

			(array.store
				(:doc "1e+")
				(local source) (i32 46) (u8 49))
			(array.store (local source) (i32 47) (u8 101))
			(array.store (local source) (i32 48) (u8 43))

			(array.store
				(:doc "tru")
				(local source) (i32 49) (u8 116))
			(array.store (local source) (i32 50) (u8 114))
			(array.store (local source) (i32 51) (u8 117))

			(array.store
				(:doc "[")
				(local source) (i32 52) (u8 91))

			(call
				(:doc "\"\\q\"")
				put_four (borrow-mut (local source)) (i32 53) (u8 34) (u8 92) (u8 113) (u8 34))

			(call
				(:doc "\"\\ud800\"")
				put_four (borrow-mut (local source)) (i32 57) (u8 34) (u8 92) (u8 117) (u8 100))
			(call put_four (borrow-mut (local source)) (i32 61) (u8 56) (u8 48) (u8 48) (u8 34))

			(call
				(:doc "\"\\udc00\"")
				put_four (borrow-mut (local source)) (i32 65) (u8 34) (u8 92) (u8 117) (u8 100))
			(call put_four (borrow-mut (local source)) (i32 69) (u8 99) (u8 48) (u8 48) (u8 34))

			(array.store
				(:doc "\"\u0001\"")
				(local source) (i32 73) (u8 34))
			(array.store (local source) (i32 74) (u8 1))
			(array.store (local source) (i32 75) (u8 34))

			(call
				(:doc "\u000bnull")
				put_four (borrow-mut (local source)) (i32 76) (u8 11) (u8 110) (u8 117) (u8 108))
			(array.store (local source) (i32 80) (u8 108))

			(call
				(:doc "[1,2,3,4]")
				put_four (borrow-mut (local source)) (i32 81) (u8 91) (u8 49) (u8 44) (u8 50))
			(call put_four (borrow-mut (local source)) (i32 85) (u8 44) (u8 51) (u8 44) (u8 52))
			(array.store (local source) (i32 89) (u8 93))

			(array.store
				(:doc "Invalid UTF-8 lead byte.")
				(local source) (i32 90) (u8 255))

			(call
				(:doc "-/*x*/1")
				put_four (borrow-mut (local source)) (i32 91) (u8 45) (u8 47) (u8 42) (u8 120))
			(array.store (local source) (i32 95) (u8 42))
			(array.store (local source) (i32 96) (u8 47))
			(array.store (local source) (i32 97) (u8 49))

			(call
				(:doc "[null")
				put_four (borrow-mut (local source)) (i32 98) (u8 91) (u8 110) (u8 117) (u8 108))
			(array.store (local source) (i32 102) (u8 108))
		))

	(fn expect_error
		(params (source (shared-array u8)) (nodes (mut-array JsonNode)) (kind u32) (start i32) (end i32))
		(returns bool)
		(body
			(let parsed (call json_parse (borrow-shared (local source)) (borrow-mut (local nodes))))
			(return (bool.and (u32.eq (struct.get (local parsed) error) (local kind))
				(bool.and (i32.eq (struct.get (local parsed) rows) (i32 0))
					(bool.and (i32.eq (struct.get (local parsed) start) (local start))
						(i32.eq (struct.get (local parsed) end) (local end))))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect
			(tests "stage-2/json/reader_errors.wove")
			(issues "gh:wove-lang/wove:118"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut source (array.alloc u8 (i32 103)))
			(let-mut nodes (array.alloc JsonNode (i32 4)))
			(call fill_inputs (borrow-mut (local source)))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 0) (i32 0)))
					(borrow-mut (local nodes)) (u32 2) (i32 0) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 0) (i32 2)))
					(borrow-mut (local nodes)) (u32 6) (i32 0) (i32 2)))
				(then (return (i32 2))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 2) (i32 6)))
					(borrow-mut (local nodes)) (u32 2) (i32 3) (i32 4)))
				(then (return (i32 3))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 6) (i32 14)))
					(borrow-mut (local nodes)) (u32 7) (i32 7) (i32 8)))
				(then (return (i32 4))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 14) (i32 21)))
					(borrow-mut (local nodes)) (u32 8) (i32 5) (i32 6)))
				(then (return (i32 5))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 21) (i32 26)))
					(borrow-mut (local nodes)) (u32 9) (i32 3) (i32 4)))
				(then (return (i32 6))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 26) (i32 36)))
					(borrow-mut (local nodes)) (u32 10) (i32 5) (i32 6)))
				(then (return (i32 7))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 36) (i32 42)))
					(borrow-mut (local nodes)) (u32 6) (i32 4) (i32 6)))
				(then (return (i32 8))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 42) (i32 44)))
					(borrow-mut (local nodes)) (u32 4) (i32 1) (i32 2)))
				(then (return (i32 9))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 44) (i32 46)))
					(borrow-mut (local nodes)) (u32 4) (i32 2) (i32 2)))
				(then (return (i32 10))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 46) (i32 49)))
					(borrow-mut (local nodes)) (u32 4) (i32 3) (i32 3)))
				(then (return (i32 11))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 49) (i32 52)))
					(borrow-mut (local nodes)) (u32 5) (i32 3) (i32 3)))
				(then (return (i32 12))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 52) (i32 53)))
					(borrow-mut (local nodes)) (u32 2) (i32 1) (i32 1)))
				(then (return (i32 13))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 53) (i32 57)))
					(borrow-mut (local nodes)) (u32 3) (i32 0) (i32 3)))
				(then (return (i32 14))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 57) (i32 65)))
					(borrow-mut (local nodes)) (u32 3) (i32 1) (i32 7)))
				(then (return (i32 15))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 65) (i32 73)))
					(borrow-mut (local nodes)) (u32 3) (i32 1) (i32 7)))
				(then (return (i32 16))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 73) (i32 76)))
					(borrow-mut (local nodes)) (u32 3) (i32 0) (i32 2)))
				(then (return (i32 17))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 76) (i32 81)))
					(borrow-mut (local nodes)) (u32 2) (i32 0) (i32 1)))
				(then (return (i32 18))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 81) (i32 90)))
					(borrow-mut (local nodes)) (u32 11) (i32 7) (i32 8)))
				(then (return (i32 19))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 90) (i32 91)))
					(borrow-mut (local nodes)) (u32 1) (i32 0) (i32 1)))
				(then (return (i32 20))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 91) (i32 98)))
					(borrow-mut (local nodes)) (u32 4) (i32 1) (i32 2)))
				(then (return (i32 21))))
			(if (bool.not (call expect_error (borrow-shared (array.range (local source) (i32 98) (i32 103)))
					(borrow-mut (local nodes)) (u32 9) (i32 5) (i32 5)))
				(then (return (i32 22))))
			(return (i32 0)))))
