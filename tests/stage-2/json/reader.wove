	jsonc_reader_fixture

	(use wove-file "../../../stage-2/json/reader.wove"
		(only (type JsonNode) json_parse json_decode_string))

	(fn put_four
		(params (source (mut-slice u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(slice.store (local source) (local start) (local a))
			(slice.store (local source) (i32.add.wrapping (local start) (i32 1)) (local b))
			(slice.store (local source) (i32.add.wrapping (local start) (i32 2)) (local c))
			(slice.store (local source) (i32.add.wrapping (local start) (i32 3)) (local d))))

	(fn
		(:doc "/*head*/{\r\n// line\r\n\"path\\u002f\"/*key*/:/*value*/[\"///*\",\"\\u00e9\\uD83D\\uDE42\",-12.30e+04,true,false,null,{\"n\":[1]},[]]}//tail")
		fill_document
		(params (source (mut-slice u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local source)) (i32 0) (u8 47) (u8 42) (u8 104) (u8 101))
			(call put_four (borrow-mut (local source)) (i32 4) (u8 97) (u8 100) (u8 42) (u8 47))
			(call put_four (borrow-mut (local source)) (i32 8) (u8 123) (u8 13) (u8 10) (u8 47))
			(call put_four (borrow-mut (local source)) (i32 12) (u8 47) (u8 32) (u8 108) (u8 105))
			(call put_four (borrow-mut (local source)) (i32 16) (u8 110) (u8 101) (u8 13) (u8 10))
			(call put_four (borrow-mut (local source)) (i32 20) (u8 34) (u8 112) (u8 97) (u8 116))
			(call put_four (borrow-mut (local source)) (i32 24) (u8 104) (u8 92) (u8 117) (u8 48))
			(call put_four (borrow-mut (local source)) (i32 28) (u8 48) (u8 50) (u8 102) (u8 34))
			(call put_four (borrow-mut (local source)) (i32 32) (u8 47) (u8 42) (u8 107) (u8 101))
			(call put_four (borrow-mut (local source)) (i32 36) (u8 121) (u8 42) (u8 47) (u8 58))
			(call put_four (borrow-mut (local source)) (i32 40) (u8 47) (u8 42) (u8 118) (u8 97))
			(call put_four (borrow-mut (local source)) (i32 44) (u8 108) (u8 117) (u8 101) (u8 42))
			(call put_four (borrow-mut (local source)) (i32 48) (u8 47) (u8 91) (u8 34) (u8 47))
			(call put_four (borrow-mut (local source)) (i32 52) (u8 47) (u8 47) (u8 42) (u8 34))
			(call put_four (borrow-mut (local source)) (i32 56) (u8 44) (u8 34) (u8 92) (u8 117))
			(call put_four (borrow-mut (local source)) (i32 60) (u8 48) (u8 48) (u8 101) (u8 57))
			(call put_four (borrow-mut (local source)) (i32 64) (u8 92) (u8 117) (u8 68) (u8 56))
			(call put_four (borrow-mut (local source)) (i32 68) (u8 51) (u8 68) (u8 92) (u8 117))
			(call put_four (borrow-mut (local source)) (i32 72) (u8 68) (u8 69) (u8 52) (u8 50))
			(call put_four (borrow-mut (local source)) (i32 76) (u8 34) (u8 44) (u8 45) (u8 49))
			(call put_four (borrow-mut (local source)) (i32 80) (u8 50) (u8 46) (u8 51) (u8 48))
			(call put_four (borrow-mut (local source)) (i32 84) (u8 101) (u8 43) (u8 48) (u8 52))
			(call put_four (borrow-mut (local source)) (i32 88) (u8 44) (u8 116) (u8 114) (u8 117))
			(call put_four (borrow-mut (local source)) (i32 92) (u8 101) (u8 44) (u8 102) (u8 97))
			(call put_four (borrow-mut (local source)) (i32 96) (u8 108) (u8 115) (u8 101) (u8 44))
			(call put_four (borrow-mut (local source)) (i32 100) (u8 110) (u8 117) (u8 108) (u8 108))
			(call put_four (borrow-mut (local source)) (i32 104) (u8 44) (u8 123) (u8 34) (u8 110))
			(call put_four (borrow-mut (local source)) (i32 108) (u8 34) (u8 58) (u8 91) (u8 49))
			(call put_four (borrow-mut (local source)) (i32 112) (u8 93) (u8 125) (u8 44) (u8 91))
			(call put_four (borrow-mut (local source)) (i32 116) (u8 93) (u8 93) (u8 125) (u8 47))
			(call put_four (borrow-mut (local source)) (i32 120) (u8 47) (u8 116) (u8 97) (u8 105))
			(slice.store (local source) (i32 124) (u8 108))
		))

	(fn
		(:doc "  /* scalar */ -0.0E-1 // eof")
		fill_scalar
		(params (source (mut-slice u8)))
		(returns void)
		(body
			(call put_four (borrow-mut (local source)) (i32 0) (u8 32) (u8 32) (u8 47) (u8 42))
			(call put_four (borrow-mut (local source)) (i32 4) (u8 32) (u8 115) (u8 99) (u8 97))
			(call put_four (borrow-mut (local source)) (i32 8) (u8 108) (u8 97) (u8 114) (u8 32))
			(call put_four (borrow-mut (local source)) (i32 12) (u8 42) (u8 47) (u8 32) (u8 45))
			(call put_four (borrow-mut (local source)) (i32 16) (u8 48) (u8 46) (u8 48) (u8 69))
			(call put_four (borrow-mut (local source)) (i32 20) (u8 45) (u8 49) (u8 32) (u8 47))
			(call put_four (borrow-mut (local source)) (i32 24) (u8 47) (u8 32) (u8 101) (u8 111))
			(slice.store (local source) (i32 28) (u8 102))
		))

	(fn row_matches
		(params (nodes (shared-slice JsonNode)) (row i32) (kind u32) (start i32) (end i32)
			(key_start i32) (key_end i32) (parent i32) (first_child i32) (next_sibling i32))
		(returns bool)
		(body
			(let node (slice.load (local nodes) (local row)))
			(if (bool.not (u32.eq (record.get (local node) kind) (local kind)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) start) (local start)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) end) (local end)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) key_start) (local key_start)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) key_end) (local key_end)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) parent) (local parent)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) first_child) (local first_child)))
				(then (return (bool false))))
			(if (bool.not (i32.eq (record.get (local node) next_sibling) (local next_sibling)))
				(then (return (bool false))))
			(return (bool true))))

	(fn check_text
		(params (output (shared-slice u8)))
		(returns bool)
		(body
			(return (bool.and
				(u8.eq (slice.load (local output) (i32 0)) (u8 195))
				(bool.and (u8.eq (slice.load (local output) (i32 1)) (u8 169))
					(bool.and (u8.eq (slice.load (local output) (i32 2)) (u8 240))
						(bool.and (u8.eq (slice.load (local output) (i32 3)) (u8 159))
							(bool.and (u8.eq (slice.load (local output) (i32 4)) (u8 153))
								(u8.eq (slice.load (local output) (i32 5)) (u8 130))))))))))

	(fn byte_matches
		(params (output (shared-slice u8)) (index i32) (expected u8))
		(returns bool)
		(body (return (u8.eq (slice.load (local output) (local index)) (local expected)))))

	(fn
		(:expect jsonc.reader_values (issue "https://github.com/wove-lang/wove/issues/118"))
		main
		(params)
		(returns i32)
		(body
			(let-mut source (array.alloc u8 (i32 125)))
			(let-mut nodes (array.alloc JsonNode (i32 12)))
			(call fill_document (borrow-mut (local source)))
			(let parsed (call json_parse (borrow-shared (local source)) (borrow-mut (local nodes))))
			(if (bool.not (bool.and (u32.eq (record.get (local parsed) error) (u32 0))
					(i32.eq (record.get (local parsed) rows) (i32 12))))
				(then (return (i32 1))))
			(if (bool.not (bool.and (i32.eq (record.get (local parsed) start) (i32 8))
					(i32.eq (record.get (local parsed) end) (i32 119))))
				(then (return (i32 2))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 0) (u32 1) (i32 8) (i32 119) (i32 -1) (i32 -1) (i32 -1) (i32 1) (i32 -1)))
				(then (return (i32 3))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 1) (u32 2) (i32 49) (i32 118) (i32 20) (i32 32) (i32 0) (i32 2) (i32 -1)))
				(then (return (i32 4))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 2) (u32 3) (i32 50) (i32 56) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 3)))
				(then (return (i32 5))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 3) (u32 3) (i32 57) (i32 77) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 4)))
				(then (return (i32 6))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 4) (u32 4) (i32 78) (i32 88) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 5)))
				(then (return (i32 7))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 5) (u32 5) (i32 89) (i32 93) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 6)))
				(then (return (i32 8))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 6) (u32 6) (i32 94) (i32 99) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 7)))
				(then (return (i32 9))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 7) (u32 7) (i32 100) (i32 104) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 8)))
				(then (return (i32 10))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 8) (u32 1) (i32 105) (i32 114) (i32 -1) (i32 -1) (i32 1) (i32 9) (i32 11)))
				(then (return (i32 11))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 9) (u32 2) (i32 110) (i32 113) (i32 106) (i32 109) (i32 8) (i32 10) (i32 -1)))
				(then (return (i32 12))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 10) (u32 4) (i32 111) (i32 112) (i32 -1) (i32 -1) (i32 9) (i32 -1) (i32 -1)))
				(then (return (i32 13))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 11) (u32 2) (i32 115) (i32 117) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 -1)))
				(then (return (i32 14))))
			(let-mut decoded (array.alloc u8 (i32 6)))
			(let unicode (call json_decode_string (borrow-shared (local source))
				(i32 57) (i32 77) (borrow-mut (local decoded))))
			(if (bool.not (bool.and (u32.eq (record.get (local unicode) error) (u32 0))
					 (i32.eq (record.get (local unicode) written) (i32 6))))
				(then (return (i32 15))))
			(if (bool.not (call check_text (borrow-shared (local decoded))))
				(then (return (i32 16))))
			(let key (call json_decode_string (borrow-shared (local source))
				(i32 20) (i32 32) (borrow-mut (local decoded))))
			(if (bool.not (bool.and (u32.eq (record.get (local key) error) (u32 0))
					(i32.eq (record.get (local key) written) (i32 5))))
				(then (return (i32 17))))
			(if (bool.not (call byte_matches (borrow-shared (local decoded)) (i32 4) (u8 47)))
				(then (return (i32 18))))
			(let-mut short (array.alloc u8 (i32 3)))
			(let clipped (call json_decode_string (borrow-shared (local source))
				(i32 57) (i32 77) (borrow-mut (local short))))
			(if (bool.not (bool.and (u32.eq (record.get (local clipped) error) (u32 12))
					(i32.eq (record.get (local clipped) written) (i32 2))))
				(then (return (i32 19))))
			(if (bool.not (bool.and (i32.eq (record.get (local clipped) start) (i32 64))
					(i32.eq (record.get (local clipped) end) (i32 76))))
				(then (return (i32 20))))

			(let-mut scalar (array.alloc u8 (i32 29)))
			(call fill_scalar (borrow-mut (local scalar)))
			(let result (call json_parse (borrow-shared (local scalar)) (borrow-mut (local nodes))))
			(if (bool.not (bool.and (u32.eq (record.get (local result) error) (u32 0))
					(i32.eq (record.get (local result) rows) (i32 1))))
				(then (return (i32 21))))
			(if (bool.not (call row_matches (borrow-shared (local nodes)) (i32 0) (u32 4)
					(i32 15) (i32 22) (i32 -1) (i32 -1) (i32 -1) (i32 -1) (i32 -1)))
				(then (return (i32 22))))
			(return (i32 0)))))
