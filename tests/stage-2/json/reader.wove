(module jsonc_reader_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/json/reader.wove"
		(only (type JsonNode) json_parse json_decode_string))

	(fn put_four
		(params (source (mut-array u8)) (start i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(array.store source start a)
			(array.store source (i32.add start (i32 1)) b)
			(array.store source (i32.add start (i32 2)) c)
			(array.store source (i32.add start (i32 3)) d)))

	(fn fill_document
		(:doc "/*head*/{\r\n// line\r\n\"path\\u002f\"/*key*/:/*value*/[\"///*\",\"\\u00e9\\uD83D\\uDE42\",-12.30e+04,true,false,null,{\"n\":[1]},[]]}//tail")
		(params (source (mut-array u8)))
		(returns void)
		(body
			(call put_four (borrow-mut source) (i32 0) (u8 47) (u8 42) (u8 104) (u8 101))
			(call put_four (borrow-mut source) (i32 4) (u8 97) (u8 100) (u8 42) (u8 47))
			(call put_four (borrow-mut source) (i32 8) (u8 123) (u8 13) (u8 10) (u8 47))
			(call put_four (borrow-mut source) (i32 12) (u8 47) (u8 32) (u8 108) (u8 105))
			(call put_four (borrow-mut source) (i32 16) (u8 110) (u8 101) (u8 13) (u8 10))
			(call put_four (borrow-mut source) (i32 20) (u8 34) (u8 112) (u8 97) (u8 116))
			(call put_four (borrow-mut source) (i32 24) (u8 104) (u8 92) (u8 117) (u8 48))
			(call put_four (borrow-mut source) (i32 28) (u8 48) (u8 50) (u8 102) (u8 34))
			(call put_four (borrow-mut source) (i32 32) (u8 47) (u8 42) (u8 107) (u8 101))
			(call put_four (borrow-mut source) (i32 36) (u8 121) (u8 42) (u8 47) (u8 58))
			(call put_four (borrow-mut source) (i32 40) (u8 47) (u8 42) (u8 118) (u8 97))
			(call put_four (borrow-mut source) (i32 44) (u8 108) (u8 117) (u8 101) (u8 42))
			(call put_four (borrow-mut source) (i32 48) (u8 47) (u8 91) (u8 34) (u8 47))
			(call put_four (borrow-mut source) (i32 52) (u8 47) (u8 47) (u8 42) (u8 34))
			(call put_four (borrow-mut source) (i32 56) (u8 44) (u8 34) (u8 92) (u8 117))
			(call put_four (borrow-mut source) (i32 60) (u8 48) (u8 48) (u8 101) (u8 57))
			(call put_four (borrow-mut source) (i32 64) (u8 92) (u8 117) (u8 68) (u8 56))
			(call put_four (borrow-mut source) (i32 68) (u8 51) (u8 68) (u8 92) (u8 117))
			(call put_four (borrow-mut source) (i32 72) (u8 68) (u8 69) (u8 52) (u8 50))
			(call put_four (borrow-mut source) (i32 76) (u8 34) (u8 44) (u8 45) (u8 49))
			(call put_four (borrow-mut source) (i32 80) (u8 50) (u8 46) (u8 51) (u8 48))
			(call put_four (borrow-mut source) (i32 84) (u8 101) (u8 43) (u8 48) (u8 52))
			(call put_four (borrow-mut source) (i32 88) (u8 44) (u8 116) (u8 114) (u8 117))
			(call put_four (borrow-mut source) (i32 92) (u8 101) (u8 44) (u8 102) (u8 97))
			(call put_four (borrow-mut source) (i32 96) (u8 108) (u8 115) (u8 101) (u8 44))
			(call put_four (borrow-mut source) (i32 100) (u8 110) (u8 117) (u8 108) (u8 108))
			(call put_four (borrow-mut source) (i32 104) (u8 44) (u8 123) (u8 34) (u8 110))
			(call put_four (borrow-mut source) (i32 108) (u8 34) (u8 58) (u8 91) (u8 49))
			(call put_four (borrow-mut source) (i32 112) (u8 93) (u8 125) (u8 44) (u8 91))
			(call put_four (borrow-mut source) (i32 116) (u8 93) (u8 93) (u8 125) (u8 47))
			(call put_four (borrow-mut source) (i32 120) (u8 47) (u8 116) (u8 97) (u8 105))
			(array.store source (i32 124) (u8 108))
		))

	(fn fill_scalar
		(:doc "  /* scalar */ -0.0E-1 // eof")
		(params (source (mut-array u8)))
		(returns void)
		(body
			(call put_four (borrow-mut source) (i32 0) (u8 32) (u8 32) (u8 47) (u8 42))
			(call put_four (borrow-mut source) (i32 4) (u8 32) (u8 115) (u8 99) (u8 97))
			(call put_four (borrow-mut source) (i32 8) (u8 108) (u8 97) (u8 114) (u8 32))
			(call put_four (borrow-mut source) (i32 12) (u8 42) (u8 47) (u8 32) (u8 45))
			(call put_four (borrow-mut source) (i32 16) (u8 48) (u8 46) (u8 48) (u8 69))
			(call put_four (borrow-mut source) (i32 20) (u8 45) (u8 49) (u8 32) (u8 47))
			(call put_four (borrow-mut source) (i32 24) (u8 47) (u8 32) (u8 101) (u8 111))
			(array.store source (i32 28) (u8 102))
		))

	(fn row_matches
		(params (nodes (shared-array JsonNode)) (row i32) (kind u32) (start i32) (end i32)
			(key_start i32) (key_end i32) (parent i32) (first_child i32) (next_sibling i32))
		(returns bool)
		(body
			(let node (array.load nodes row))
			(if (bool.not (u32.eq (struct.get node kind) kind))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node start) start))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node end) end))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node key_start) key_start))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node key_end) key_end))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node parent) parent))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node first_child) first_child))
				(then (return (bool false))))
			(if (bool.not (i32.eq (struct.get node next_sibling) next_sibling))
				(then (return (bool false))))
			(return (bool true))))

	(fn check_text
		(params (output (shared-array u8)))
		(returns bool)
		(body
			(return (bool.and
				(u8.eq (array.load output (i32 0)) (u8 195))
				(bool.and (u8.eq (array.load output (i32 1)) (u8 169))
					(bool.and (u8.eq (array.load output (i32 2)) (u8 240))
						(bool.and (u8.eq (array.load output (i32 3)) (u8 159))
							(bool.and (u8.eq (array.load output (i32 4)) (u8 153))
								(u8.eq (array.load output (i32 5)) (u8 130))))))))))

	(fn byte_matches
		(params (output (shared-array u8)) (index i32) (expected u8))
		(returns bool)
		(body (return (u8.eq (array.load output index) expected))))

	(fn main
		(:expect
			(tests "stage-2/json/reader.wove")
			(issues "gh:wove-lang/wove:118"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut source (array.alloc u8 (i32 125)))
			(let-mut nodes (array.alloc JsonNode (i32 12)))
			(call fill_document (borrow-mut source))
			(let parsed (call json_parse (borrow-shared source) (borrow-mut nodes)))
			(if (bool.not (bool.and (u32.eq (struct.get parsed error) (u32 0))
					(i32.eq (struct.get parsed rows) (i32 12))))
				(then (return (i32 1))))
			(if (bool.not (bool.and (i32.eq (struct.get parsed start) (i32 8))
					(i32.eq (struct.get parsed end) (i32 119))))
				(then (return (i32 2))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 0) (u32 1) (i32 8) (i32 119) (i32 -1) (i32 -1) (i32 -1) (i32 1) (i32 -1)))
				(then (return (i32 3))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 1) (u32 2) (i32 49) (i32 118) (i32 20) (i32 32) (i32 0) (i32 2) (i32 -1)))
				(then (return (i32 4))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 2) (u32 3) (i32 50) (i32 56) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 3)))
				(then (return (i32 5))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 3) (u32 3) (i32 57) (i32 77) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 4)))
				(then (return (i32 6))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 4) (u32 4) (i32 78) (i32 88) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 5)))
				(then (return (i32 7))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 5) (u32 5) (i32 89) (i32 93) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 6)))
				(then (return (i32 8))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 6) (u32 6) (i32 94) (i32 99) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 7)))
				(then (return (i32 9))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 7) (u32 7) (i32 100) (i32 104) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 8)))
				(then (return (i32 10))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 8) (u32 1) (i32 105) (i32 114) (i32 -1) (i32 -1) (i32 1) (i32 9) (i32 11)))
				(then (return (i32 11))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 9) (u32 2) (i32 110) (i32 113) (i32 106) (i32 109) (i32 8) (i32 10) (i32 -1)))
				(then (return (i32 12))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 10) (u32 4) (i32 111) (i32 112) (i32 -1) (i32 -1) (i32 9) (i32 -1) (i32 -1)))
				(then (return (i32 13))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 11) (u32 2) (i32 115) (i32 117) (i32 -1) (i32 -1) (i32 1) (i32 -1) (i32 -1)))
				(then (return (i32 14))))
			(let-mut decoded (array.alloc u8 (i32 6)))
			(let unicode (call json_decode_string (borrow-shared source)
				(i32 57) (i32 77) (borrow-mut decoded)))
			(if (bool.not (bool.and (u32.eq (struct.get unicode error) (u32 0))
					 (i32.eq (struct.get unicode written) (i32 6))))
				(then (return (i32 15))))
			(if (bool.not (call check_text (borrow-shared decoded)))
				(then (return (i32 16))))
			(let key (call json_decode_string (borrow-shared source)
				(i32 20) (i32 32) (borrow-mut decoded)))
			(if (bool.not (bool.and (u32.eq (struct.get key error) (u32 0))
					(i32.eq (struct.get key written) (i32 5))))
				(then (return (i32 17))))
			(if (bool.not (call byte_matches (borrow-shared decoded) (i32 4) (u8 47)))
				(then (return (i32 18))))
			(let-mut short (array.alloc u8 (i32 3)))
			(let clipped (call json_decode_string (borrow-shared source)
				(i32 57) (i32 77) (borrow-mut short)))
			(if (bool.not (bool.and (u32.eq (struct.get clipped error) (u32 12))
					(i32.eq (struct.get clipped written) (i32 2))))
				(then (return (i32 19))))
			(if (bool.not (bool.and (i32.eq (struct.get clipped start) (i32 64))
					(i32.eq (struct.get clipped end) (i32 76))))
				(then (return (i32 20))))

			(let-mut scalar (array.alloc u8 (i32 29)))
			(call fill_scalar (borrow-mut scalar))
			(let result (call json_parse (borrow-shared scalar) (borrow-mut nodes)))
			(if (bool.not (bool.and (u32.eq (struct.get result error) (u32 0))
					(i32.eq (struct.get result rows) (i32 1))))
				(then (return (i32 21))))
			(if (bool.not (call row_matches (borrow-shared nodes) (i32 0) (u32 4)
					(i32 15) (i32 22) (i32 -1) (i32 -1) (i32 -1) (i32 -1) (i32 -1)))
				(then (return (i32 22))))
			(return (i32 0)))))
