	(use wove-file "../../../stage-2/json/frame.wove" (only json_frame))

	(fn fill_bytes
		(params (bytes (mut-array u8)))
		(returns void)
		(body
			(:doc " \t{\"q\":\"}\\\"[]\",\"a\":[{}]}/* ] } */[]{} true \n[\"\\q\"]")
			(array.store (local bytes) (i32 0) (u8 32))
			(array.store (local bytes) (i32 1) (u8 9))
			(array.store (local bytes) (i32 2) (u8 123))
			(array.store (local bytes) (i32 3) (u8 34))
			(array.store (local bytes) (i32 4) (u8 113))
			(array.store (local bytes) (i32 5) (u8 34))
			(array.store (local bytes) (i32 6) (u8 58))
			(array.store (local bytes) (i32 7) (u8 34))
			(array.store (local bytes) (i32 8) (u8 125))
			(array.store (local bytes) (i32 9) (u8 92))
			(array.store (local bytes) (i32 10) (u8 34))
			(array.store (local bytes) (i32 11) (u8 91))
			(array.store (local bytes) (i32 12) (u8 93))
			(array.store (local bytes) (i32 13) (u8 34))
			(array.store (local bytes) (i32 14) (u8 44))
			(array.store (local bytes) (i32 15) (u8 34))
			(array.store (local bytes) (i32 16) (u8 97))
			(array.store (local bytes) (i32 17) (u8 34))
			(array.store (local bytes) (i32 18) (u8 58))
			(array.store (local bytes) (i32 19) (u8 91))
			(array.store (local bytes) (i32 20) (u8 123))
			(array.store (local bytes) (i32 21) (u8 125))
			(array.store (local bytes) (i32 22) (u8 93))
			(array.store (local bytes) (i32 23) (u8 125))
			(array.store (local bytes) (i32 24) (u8 47))
			(array.store (local bytes) (i32 25) (u8 42))
			(array.store (local bytes) (i32 26) (u8 32))
			(array.store (local bytes) (i32 27) (u8 93))
			(array.store (local bytes) (i32 28) (u8 32))
			(array.store (local bytes) (i32 29) (u8 125))
			(array.store (local bytes) (i32 30) (u8 32))
			(array.store (local bytes) (i32 31) (u8 42))
			(array.store (local bytes) (i32 32) (u8 47))
			(array.store (local bytes) (i32 33) (u8 91))
			(array.store (local bytes) (i32 34) (u8 93))
			(array.store (local bytes) (i32 35) (u8 123))
			(array.store (local bytes) (i32 36) (u8 125))
			(array.store (local bytes) (i32 37) (u8 32))
			(array.store (local bytes) (i32 38) (u8 116))
			(array.store (local bytes) (i32 39) (u8 114))
			(array.store (local bytes) (i32 40) (u8 117))
			(array.store (local bytes) (i32 41) (u8 101))
			(array.store (local bytes) (i32 42) (u8 32))
			(array.store (local bytes) (i32 43) (u8 10))
			(array.store (local bytes) (i32 44) (u8 91))
			(array.store (local bytes) (i32 45) (u8 34))
			(array.store (local bytes) (i32 46) (u8 92))
			(array.store (local bytes) (i32 47) (u8 113))
			(array.store (local bytes) (i32 48) (u8 34))
			(array.store (local bytes) (i32 49) (u8 93))))

	(fn matches_frame
		(params (bytes (shared-array u8)) (at i32) (start i32) (end i32) (kind u32) (error u32))
		(returns bool)
		(body
			(let frame (call json_frame (borrow-shared (local bytes)) (local at)))
			(return (bool.and (i32.eq (struct.get (local frame) start) (local start))
				(bool.and (i32.eq (struct.get (local frame) end) (local end))
					(bool.and (u32.eq (struct.get (local frame) kind) (local kind))
						(u32.eq (struct.get (local frame) error) (local error))))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut bytes (array.alloc u8 (i32 50)))
			(call fill_bytes (borrow-mut (local bytes)))
			(if (bool.not (call matches_frame (borrow-shared (array.range (local bytes) (i32 0) (i32 44)))
				(i32 0) (i32 2) (i32 24) (u32 1) (u32 0)))
				(then (return (i32 1))))
			(if (bool.not (call matches_frame (borrow-shared (array.range (local bytes) (i32 0) (i32 44)))
				(i32 24) (i32 33) (i32 35) (u32 2) (u32 0)))
				(then (return (i32 2))))
			(if (bool.not (call matches_frame (borrow-shared (array.range (local bytes) (i32 0) (i32 44)))
				(i32 35) (i32 35) (i32 37) (u32 1) (u32 0)))
				(then (return (i32 3))))
			(if (bool.not (call matches_frame (borrow-shared (array.range (local bytes) (i32 0) (i32 44)))
				(i32 37) (i32 38) (i32 42) (u32 5) (u32 0)))
				(then (return (i32 4))))
			(if (bool.not (call matches_frame (borrow-shared (array.range (local bytes) (i32 0) (i32 44)))
				(i32 42) (i32 44) (i32 44) (u32 0) (u32 0)))
				(then (return (i32 5))))
			(if (bool.not (call matches_frame (borrow-shared (array.range (local bytes) (i32 0) (i32 44)))
				(i32 -1) (i32 -1) (i32 -1) (u32 0) (u32 13)))
				(then (return (i32 6))))
			(let invalid (call json_frame (borrow-shared (local bytes)) (i32 44)))
			(if (bool.not (u32.eq (struct.get (local invalid) error) (u32 3))) (then (return (i32 7))))
			(return (i32 0)))))
