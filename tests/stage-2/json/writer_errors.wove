(module json_writer_errors_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/json/writer.wove"
		(only json_writer json_begin_object json_end_object json_begin_array json_end_array
			json_key json_string json_i32 json_bool json_null json_finish))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(let short_null "nul")
	(let short_array "[0,fals")

	(fn malformed_text
		(params (text (mut-array u8)))
		(returns void)
		(body (array:set text (i32 0) (u8 255))))

	(fn first_byte
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array:get bytes (i32 0)))))

	(fn main
		(:expect
			(tests "stage-2/json/writer_errors.wove")
			(issues "gh:wove-lang/wove:117"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut output (array:alloc u8 (i32 8)))
			(let-mut short (array:alloc u8 (i32 3)))
			(let-mut stack (array:alloc u8 (i32 1)))
			(let-mut text (array:alloc u8 (i32 1)))
			(call malformed_text (borrow-mut text))

			(let state_0 (call json_writer))
			(let state_1 (call json_null state_0 (borrow-mut short) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get state_1 error) (u32 1))) (then (return (i32 1))))
			(if (bool:not (bool:and (i32:eq (struct:get state_1 written) 0i32)
				(call same_bytes (borrow-shared short) 0i32 3i32 (borrow-shared short_null) 0i32 3i32)))
				(then (return 11i32)))
			(let state_2 (call json_end_object state_1 (borrow-mut output) (borrow-shared stack)))
			(let state_3 (call json_finish state_2))
			(if (bool:not (u32:eq (struct:get state_3 error) (u32 1))) (then (return (i32 2))))
			(if (bool:not (u8:eq (call first_byte (borrow-shared output)) (u8 0))) (then (return (i32 3))))

			(let state_4 (call json_writer))
			(let state_5 (call json_begin_array state_4 (borrow-mut output) (borrow-mut stack)))
			(let state_6 (call json_begin_array state_5 (borrow-mut output) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get state_6 error) (u32 2))) (then (return (i32 4))))

			(let state_7 (call json_writer))
			(let state_8 (call json_begin_object state_7 (borrow-mut output) (borrow-mut stack)))
			(let state_9 (call json_end_array state_8 (borrow-mut output) (borrow-shared stack)))
			(if (bool:not (u32:eq (struct:get state_9 error) (u32 3))) (then (return (i32 5))))

			(let state_10 (call json_writer))
			(let state_11 (call json_begin_object state_10 (borrow-mut output) (borrow-mut stack)))
			(let state_12 (call json_key state_11 (borrow-mut output) (borrow-mut stack)
				(borrow-shared (array:range text (i32 0) (i32 0)))))
			(let state_13 (call json_end_object state_12 (borrow-mut output) (borrow-shared stack)))
			(if (bool:not (u32:eq (struct:get state_13 error) (u32 3))) (then (return (i32 6))))

			(let state_14 (call json_writer))
			(let state_15 (call json_string state_14 (borrow-mut output) (borrow-mut stack) (borrow-shared text)))
			(if (bool:not (u32:eq (struct:get state_15 error) (u32 4))) (then (return (i32 7))))

			(let state_16 (call json_finish (call json_writer)))
			(if (bool:not (u32:eq (struct:get state_16 error) (u32 3))) (then (return (i32 8))))

			(let state_17 (call json_writer))
			(let state_18 (call json_null state_17 (borrow-mut output) (borrow-mut stack)))
			(let state_19 (call json_finish state_18))
			(if (bool:not (u32:eq (struct:get state_19 error) (u32 0))) (then (return (i32 9))))
			(let state_20 (call json_null state_19 (borrow-mut output) (borrow-mut stack)))
			(if (bool:not (u32:eq (struct:get state_20 error) (u32 3))) (then (return (i32 10))))

			(array:set output 7i32 165u8)
			(let opened (call json_begin_array (call json_writer) (borrow-mut output) (borrow-mut stack)))
			(let first (call json_i32 opened (borrow-mut output) (borrow-mut stack) 0i32))
			(let stopped (call json_bool first
				(borrow-mut (array:range output 0i32 7i32)) (borrow-mut stack) (bool false)))
			(if (bool:not (bool:and (u32:eq (struct:get stopped error) 1u32)
				(bool:and (i32:eq (struct:get stopped written) 3i32)
					(i32:eq (struct:get stopped depth) 1i32))))
				(then (return 12i32)))
			(if (bool:not (bool:and (call same_bytes (borrow-shared output) 0i32 7i32
				(borrow-shared short_array) 0i32 7i32) (u8:eq (array:get output 7i32) 165u8)))
				(then (return 13i32)))
			(return (i32 0)))))
