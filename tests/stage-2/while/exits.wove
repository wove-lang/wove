(module loop_exits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Action (variants (More) (Done)))

	(fn advance (params (count (mut-array u8))) (returns bool)
		(body
			(let next (u8:from-i32 (i32:add (i32:from-u8 (array:load count 0i32)) 1i32)))
			(array:store count 0i32 next)
			(return (u8:lt next 4u8))))

	(fn spin (params) (returns i32)
		(body
			(while (bool true)
				(body
					(if (bool false) (then (break)))
					(continue)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:367"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut outer (array:alloc u8 1i32))
			(array:store outer 0i32 42u8)
			(let-mut rounds 0i32)
			(let-mut hits 0i32)
			(while (bool true)
				(body
					(set rounds (i32:add rounds 1i32))
					(let-mut inner (array:alloc u8 1i32))
					(while (call advance (borrow-mut inner))
						(body
							(let step (array:load inner 0i32))
							(if (u8:eq step 1u8) (then (continue)))
							(if (u8:eq step 3u8) (then (break)))
							(set hits (i32:add hits 1i32))))
					(if (bool:not (u8:eq (array:load inner 0i32) 3u8))
						(then (return 1i32)))
					(let-mut action (enum:new Action More))
					(if (i32:eq rounds 2i32) (then (set action (enum:new Action Done))))
					(match action
						(case More (continue))
						(case Done (break)))))
			(if (bool:not (i32:eq hits 2i32)) (then (return 2i32)))
			(return (i32:from-u8 (array:load outer 0i32))))))
