(module loop_exits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(enum Action (variants (More) (Done)))

	(fn advance (params (count (mut-array u8))) (returns bool)
		(body
			(let next (u8.from-i32 (i32.add (i32.from-u8 (array.load (local count) 0i32)) 1i32)))
			(array.store (local count) 0i32 (local next))
			(return (u8.lt (local next) 4u8))))

	(fn spin (params) (returns i32)
		(body
			(while (bool true)
				(body
					(if (bool false) (then (break)))
					(continue)))))

	(fn main
		(:expect (issues "gh:wove-lang/wove:367"))
		(params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut outer (array.alloc u8 1i32))
			(array.store (local outer) 0i32 42u8)
			(let-mut rounds 0i32)
			(let-mut hits 0i32)
			(while (bool true)
				(body
					(set (local rounds) (i32.add (local rounds) 1i32))
					(let-mut inner (array.alloc u8 1i32))
					(while (call advance (borrow-mut (local inner)))
						(body
							(let step (array.load (local inner) 0i32))
							(if (u8.eq (local step) 1u8) (then (continue)))
							(if (u8.eq (local step) 3u8) (then (break)))
							(set (local hits) (i32.add (local hits) 1i32))))
					(if (bool.not (u8.eq (array.load (local inner) 0i32) 3u8))
						(then (return 1i32)))
					(let-mut action (enum.new Action More))
					(if (i32.eq (local rounds) 2i32) (then (set (local action) (enum.new Action Done))))
					(match (local action)
						(case More (continue))
						(case Done (break)))))
			(if (bool.not (i32.eq (local hits) 2i32)) (then (return 2i32)))
			(return (i32.from-u8 (array.load (local outer) 0i32))))))
