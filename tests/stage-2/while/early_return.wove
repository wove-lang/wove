(module loop_early_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut cursor (i32 0))
			(while (i32.lt cursor (i32 50))
				(body
					(let next (i32.add cursor (i32 1)))
					(if (i32.eq next (i32 42))
						(then (return next)))
					(set cursor next)))
			(return (i32 -1)))))
