(module loop_early_return
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut cursor (i32 0))
			(while (i32.lt (local cursor) (i32 50))
				(body
					(let next (i32.add.wrapping (local cursor) (i32 1)))
					(if (i32.eq (local next) (i32 42))
						(then (return (local next))))
					(set (local cursor) (local next))))
			(return (i32 -1)))))
