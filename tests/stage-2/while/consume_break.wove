(module consume_break
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose fgetc))
	(let path "tests/stage-2/native_records/data.txt")
	(let mode "r")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared mode)))
			(while (bool true)
				(body
					(if (bool true)
						(then
							(let status (call fclose (move stream)))
							(break)))))
			(return (call fgetc (borrow-shared stream))))))
