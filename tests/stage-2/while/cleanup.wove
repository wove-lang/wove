(module loop_exit_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut round 0i32)
			(while (bool true)
				(body
					(set (local round) (i32.add (local round) 1i32))
					(let buffer (array.alloc u8 3i32))
					(let current (move (local buffer)))
					(if (i32.eq (local round) 1i32) (then (continue)))
					(if (i32.eq (local round) 3i32) (then (break)))
					(if (bool.not (i32.eq (array.len (local current)) 3i32))
						(then (return 1i32)))))
			(return (i32.add (local round) 39i32)))))
