(module live_on_break
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose fgetc))
	(let path "tests/stage-2/native_records/data.txt")
	(let mode "r")
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared mode)))
			(if (owner.is-null stream) (then (return 1i32)))
			(while (bool true)
				(body
					(if (i32.eq (i32.dec (array.len args)) 0i32)
						(then (break))
						(else
							(let status (call fclose (move stream)))
							(return 7i32)))))
			(while (bool true)
				(body
					(if (bool true) (then (break)))
					(let status (call fclose (move stream)))
					(break)))
			(let read (call fgetc (borrow-shared stream)))
			(if (i32.lt read 0i32) (then (return 2i32)))
			(return 42i32))))
