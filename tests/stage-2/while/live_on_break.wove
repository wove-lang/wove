(module live_on_break
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose fgetc))
	(let path "tests/stage-2/native_records/data.txt")
	(let mode "r")
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared (local path)) (borrow-shared (local mode))))
			(if (owner.is-null (local stream)) (then (return 1i32)))
			(while (bool true)
				(body
					(if (i32.eq (array.len (local args)) 0i32)
						(then (break))
						(else
							(let status (call fclose (move (local stream))))
							(return 7i32)))))
			(while (bool true)
				(body
					(if (bool true) (then (break)))
					(let status (call fclose (move (local stream))))
					(break)))
			(let read (call fgetc (borrow-shared (local stream))))
			(if (i32.lt (local read) 0i32) (then (return 2i32)))
			(return 42i32))))
