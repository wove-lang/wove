(module loop_cursor
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let untouched (call advance (i32 7) (i32 2)))
			(let progressed (call advance (i32 0) (i32 49)))
			(return (i32.sub progressed untouched))))
	(fn advance (params (start i32) (limit i32)) (returns i32)
		(body
			(let-mut cursor start)
			(while (i32.lt (call observed cursor) limit)
				(body
					(let next (i32.add cursor (i32 1)))
					(set cursor next)))
			(return cursor)))
	(fn observed (params (value i32)) (returns i32)
		(body (return value))))
