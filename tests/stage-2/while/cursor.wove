(module loop_cursor
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let untouched (call advance (i32 7) (i32 2)))
			(let progressed (call advance (i32 0) (i32 49)))
			(return (i32.sub.wrapping (local progressed) (local untouched)))))
	(fn advance (params (start i32) (limit i32)) (returns i32)
		(body
			(let-mut cursor (local start))
			(while (i32.lt (call observed (local cursor)) (local limit))
				(body
					(let next (i32.add.wrapping (local cursor) (i32 1)))
					(set (local cursor) (local next))))
			(return (local cursor))))
	(fn observed (params (value i32)) (returns i32)
		(body (return (local value)))))
