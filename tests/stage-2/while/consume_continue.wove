(module consume_continue
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdio.h>" (only fopen fclose fgetc))
	(let path "tests/stage-2/native_records/data.txt")
	(let mode "r")
	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let stream (call fopen (borrow-shared (local path)) (borrow-shared (local mode))))
			(while (bool true)
				(body
					(if (bool true)
						(then
							(let status (call fclose (move (local stream))))
							(continue)))))
			(return 42i32))))
