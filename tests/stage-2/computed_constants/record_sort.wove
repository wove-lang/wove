(module record_sort
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let CHUNK 1024i32)
	(let RECORD_BYTES (i32 8))

	(struct Scratch (fields (data (array u8 (i32.mul (local CHUNK) (local RECORD_BYTES))))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut scratch
				(struct.new Scratch
					(data (array.repeat (array u8 (i32.mul (local CHUNK) (local RECORD_BYTES))) 0u8))))
			(array.store (struct.get (local scratch) data) 8191i32 42u8)
			(if (i32.not-eq (array.len (struct.get (local scratch) data)) 8192i32) (then (return 1i32)))
			(return (i32.from-u8 (array.load (struct.get (local scratch) data) 8191i32)))))

)
