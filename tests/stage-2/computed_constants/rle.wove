(module rle
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./rle_sizes.wove" (only
		(value (as PAYLOAD_SIZE capacity)) payload_length table_value))
	(let BUFFER_SIZE (local capacity))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let payload (array.repeat (array u8 BUFFER_SIZE) 0u8))
			(if (i32.not-eq (call payload_length (borrow-shared (local payload))) 33024i32)
				(then (return 1i32)))
			(if (i32.not-eq (call table_value) (local capacity)) (then (return 2i32)))
			(return 42i32)))

)
