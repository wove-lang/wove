(module rle_sizes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let PAYLOAD_SIZE
		(i32.add (local BLOCK_SIZE) (i32.div (i32.add (local BLOCK_SIZE) 127i32) 128i32)))
	(let BLOCK_SIZE 32768i32)
	(let table (array.repeat (array i32 2) (local PAYLOAD_SIZE)))

	(fn payload_length (params (payload (shared-array u8 PAYLOAD_SIZE))) (returns i32)
		(body (return (array.len (local payload)))))

	(fn table_value (params) (returns i32)
		(body (return (array.load (local table) 1i32))))

)
