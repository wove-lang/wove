(module boundaries
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let wrap_mul (i32.mul -2147483648i32 3i32))
	(let wrap_add (i32.add 2147483647i32 1i32))
	(let wrap_sub (i32.sub -2147483648i32 1i32))
	(let wrapped_step (i32.dec (i32.inc (local wrap_add))))
	(let minimum (i32.mul-checked -1073741824i32 2i32))
	(let maximum (i32.sub-checked 2147483646i32 -1i32))
	(let quotient (i32.div -7i32 3i32))
	(let remainder (i32.rem -7i32 3i32))
	(let min_remainder (i32.rem (local minimum) -1i32))
	(let zero (i32.add-checked (local maximum) -2147483647i32))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (bytes (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(if (i32.not-eq (local wrap_mul) -2147483648i32) (then (return 1i32)))
			(if (i32.not-eq (local wrap_add) (local minimum)) (then (return 2i32)))
			(if (i32.not-eq (local wrap_sub) (local maximum)) (then (return 3i32)))
			(if (i32.not-eq (local wrapped_step) (local minimum)) (then (return 4i32)))
			(if (i32.not-eq (local quotient) -2i32) (then (return 5i32)))
			(if (i32.not-eq (local remainder) -1i32) (then (return 6i32)))
			(if (i32.not-eqz (local min_remainder)) (then (return 7i32)))
			(if (i32.not-eqz (local zero)) (then (return 8i32)))
			(return 42i32)))

)
