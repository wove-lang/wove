(module graph_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./providers/left.wove" (only (as value from_left) (as main provider_main)))
	(use wove-file "./providers/right.wove" (only (as value from_right)))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call from_right (i32 7)
			(call from_left (call provider_main (i32 42)) (i32 9)))))))
