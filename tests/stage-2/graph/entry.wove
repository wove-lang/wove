	graph_entry
	(use wove-file "./providers/left.wove" (only (as value from-left) (as main provider-main)))
	(use wove-file "./providers/right.wove" (only (as value from-right)))
	(fn main (params) (returns i32)
		(body (return (call from-right (i32 7)
			(call from-left (call provider-main (i32 42)) (i32 9)))))))
