(module graph_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./providers/left.wove" (only (as value from-left) (as main provider-main)))
	(use wove-file "./providers/right.wove" (only (as value from-right)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body (return (call from-right (i32 7)
			(call from-left (call provider-main (i32 42)) (i32 9)))))))
