	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (:pragma (cfg bootstrap))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 17))))
	(decls
		(:pragma (cfg (not bootstrap)))
		(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 42))))
		(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 1))))))
