(module mode_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(decls (:pragma (cfg bootstrap))
		(use wove-file "./seed.wove" (only (as seed_value selected))))
	(decls (:pragma (cfg (not bootstrap)))
		(use wove-file "./host.wove" (only (as host_value selected))))
	(fn main
		(:pragma (cfg bootstrap))
		(:expect (tests "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:146"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call selected))))
	(fn main
		(:pragma (cfg (not bootstrap)))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (call selected))))
	(fn main
		(:pragma (test))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body (return (i32 1)))))
