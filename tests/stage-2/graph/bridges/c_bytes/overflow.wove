(module byte_extent_overflow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./byte_extents.h" (only (as wove_test_trap_overflow enter)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 2)))
			(return (call enter (borrow-mut (local data)) (u32 4294967295) (u32 4294967295))))))
