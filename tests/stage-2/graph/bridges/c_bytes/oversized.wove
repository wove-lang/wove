(module byte_extent_oversized
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./byte_extents.h" (only (as wove_test_trap_count enter) (as wove_test_byte_marker marker)))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let data (array.alloc u8 (i32 2)))
			(return (call enter (borrow-shared data) (i32 3) (call marker))))))
