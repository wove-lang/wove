	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./byte_extents.h" (only wove_test_write_bytes))
	(bridge c-header "./byte_extents.h"
		(fn wove_test_write_bytes
			(:pragma (c_bytes data size count))
			(params (data (mut-array (:pragma (cfg bootstrap)) u8)) (count u8) (size i32))
			(returns i32)))
	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0)))))
