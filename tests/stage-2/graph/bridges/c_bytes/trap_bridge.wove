(module byte_extent_traps
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./byte_extents.h"
		(fn wove_test_trap_count
			(:pragma (c_bytes data count))
			(params (data (shared-array u8)) (count i32) (last i32)) (returns i32))
		(fn wove_test_trap_product
			(:pragma (c_bytes data size count))
			(params (data (mut-array u8)) (size i32) (count u32)) (returns i32))
		(fn wove_test_trap_overflow
			(:pragma (c_bytes data size count))
			(params (data (mut-array u8)) (size u32) (count u32)) (returns i32))
		(fn wove_test_byte_marker (params) (returns i32))))
