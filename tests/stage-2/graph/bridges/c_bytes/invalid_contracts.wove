(module invalid_byte_extents
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./byte_extents.h"
		(fn unknown_count (:pragma (c_bytes data absent))
			(params (data (shared-slice u8)) (count i32)) (returns i32))
		(fn invalid_count (:pragma (c_bytes data count))
			(params (data (shared-slice u8)) (count bool)) (returns i32))
		(fn invalid_view (:pragma (c_bytes data count))
			(params (data i32) (count i32)) (returns i32))
		(fn conflicting (:pragma (c_cstr data) (c_bytes data size count) (test_helper))
			(params (data (shared-slice u8)) (size i32) (count u32)) (returns i32))))
