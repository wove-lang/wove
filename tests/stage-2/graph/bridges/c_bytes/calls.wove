(module byte_extents
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./byte_extents.h" (only (as wove_test_byte_step step) (as wove_test_write_bytes write)
		(as wove_test_read_bytes read) (as wove_test_zero_bytes zero)))
	(bridge c-header "./byte_extents.h"
		(fn wove_test_byte_step (params (order i32) (value i32)) (returns i32))
		(fn wove_test_write_bytes
			(:pragma (c_bytes data size count))
			(params (data (mut-array u8)) (count u8) (size i32)) (returns i32))
		(fn wove_test_read_bytes
			(:pragma (c_bytes input count) (c_cstr text))
			(params (count i32) (input (shared-array u8)) (text (shared-array u8))) (returns i32))
		(fn wove_test_zero_bytes
			(:pragma (c_bytes data size count))
			(params (data (shared-array u8)) (size u32) (count u32)) (returns i32)))
	(fn verify
		(params (data (shared-array u8))) (returns i32)
		(body
			(if (bool.not (bool.and (u8.eq (array.load (local data) (i32 0)) (u8 7))
				(u8.eq (array.load (local data) (i32 4)) (u8 0))))
				(then (return (i32 5))))
			(let empty (call read (i32 0)
				(borrow-shared (array.range (local data) (i32 5) (i32 5)))
				(borrow-shared (array.range (local data) (i32 5) (i32 5)))))
			(if (bool.not (i32.eq (local empty) (i32 0))) (then (return (local empty))))
			(return (call read (i32 2)
				(borrow-shared (array.range (local data) (i32 1) (i32 3)))
				(borrow-shared (array.range (local data) (i32 2) (i32 4)))))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:154"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let empty (array.alloc u8 (i32 0)))
			(let empty_result (call zero (borrow-shared (local empty)) (u32 0) (u32 4294967295)))
			(if (bool.not (i32.eq (local empty_result) (i32 0))) (then (return (local empty_result))))
			(let-mut data (array.alloc u8 (i32 5)))
			(let written (call write (borrow-mut (local data))
				(int.convert u8 (call step (i32 0) (i32 2))) (call step (i32 1) (i32 2))))
			(if (bool.not (i32.eq (local written) (i32 0))) (then (return (local written))))
			(return (call verify (borrow-shared (local data)))))))
