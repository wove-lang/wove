(module bridge_name_first
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:pragma (cfg bootstrap))
	(use c-header "<stdlib.h>" (only (as abs absolute)))
	(bridge c-header "<stdlib.h>"
		(fn abs
			(:pragma (test)))
		(fn abs
			(:doc `Return the absolute value through the native symbol.`)
			(:pragma (cfg bootstrap))
			(params (value i32))
			(returns i32)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:184"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (call absolute (i32 -42))))))
