(module c_handle_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./handles.h" (only (as wove_test_open_handle open)
		(as wove_test_observe_handle observe) (as wove_test_finish_handles finish)))
	(fn main
		(:expect (tests "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:156"))
		(params) (returns i32)
		(body
			(if (bool true)
				(then
					(let file (call open (bool true)))
					(if (bool.not (bool.and
						(call observe (borrow-shared (local file)) (i32 0))
						(call observe (borrow-shared (local file)) (i32 1))))
						(then (return (i32 2))))))
			(return (call finish)))))
