(module c_handle_bridge
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./handles.h"
		(type File (:pragma (cfg bootstrap) (c_owned (drop wove_test_drop_handle))) (c-type "const WoveTestBootstrapHandle *"))
		(type File (:pragma (cfg (not bootstrap)) (c_owned (drop wove_test_drop_handle))) (c-type "const WoveTestHandle *"))
		(type Other (:pragma (c_owned (drop wove_test_drop_handle))) (c-type "const WoveTestHandle *"))
		(fn wove_test_open_handle (params (present bool)) (returns File))
		(fn wove_test_open_other (params) (returns Other))
		(fn wove_test_observe_handle (params (file (shared-ref File)) (step i32)) (returns bool))
		(fn wove_test_finish_handles (params) (returns i32))
		(fn unavailable (params (file (shared-ref Missing))) (returns i32))))
