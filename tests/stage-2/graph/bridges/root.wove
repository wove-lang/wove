	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	bridge_consumer
	(use c-header "<stdlib.h>" (only abs (as abs absolute)))
	(use c-header "\u002e/local.h" (only (as value local_value)))
	(use (:pragma (test)) c-header "<inactive.h>" (only unused))
	(bridge c-header "<stdlib.h>"
		(fn abs (params (value i32)) (returns i32)))
	(fn main (params) (returns i32) (body (return (i32 42)))))
