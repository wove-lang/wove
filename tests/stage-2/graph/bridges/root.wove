(module bridge_consumer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only abs (as abs absolute)))
	(use c-header "\u002e/local.h" (only (as value local_value)))
	(use (:pragma (test)) c-header "<inactive.h>" (only unused))
	(bridge c-header "<stdlib.h>"
		(fn abs (params (value i32)) (returns i32)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 42)))))
