	(use c-header "./local.h" (only (as wgf0fth8djhelper native_answer) (as wwgf0fth8djhelper reserved)))
	(fn helper (params) (returns i32) (body (return (i32 20))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan))) (returns i32)
		(body (return (i32.add.wrapping (call helper) (call native_answer))))))
