(module bridge_global_collision
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./local.h" (only (as wgf3unmtnknumber native_answer) (as wwgf3unmtnknumber reserved)))
	(fn number (params) (returns i32) (body (return (i32 20))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (i32.add (call number) (call native_answer))))))
