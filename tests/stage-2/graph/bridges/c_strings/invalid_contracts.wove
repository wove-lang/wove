(module invalid_c_string_contracts
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./c_strings.h"
		(fn unknown_name
			(:pragma (c_cstr missing))
			(params (text (shared-slice u8)))
			(returns i32))
		(fn wrong_type
			(:pragma (c_cstr value))
			(params (value i32))
			(returns i32))
		(fn conflicting
			(:pragma (c_cstr text))
			(:pragma (c_cstr_raw text))
			(params (text (shared-slice u8)))
			(returns i32))
		(fn no_formals
			(:pragma (c_cstr_raw))
			(params (text (shared-slice u8)))
			(returns i32))
		(fn unannotated
			(params (text (shared-slice u8)))
			(returns i32))))
