(module c_string_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./c_strings.h"
		(only (as wove_test_observe_c_strings observe) (as wove_test_c_string_step step)))
	(bridge c-header "./c_strings.h"
		(fn wove_test_observe_c_strings
			(:pragma (c_cstr text empty_checked) (c_cstr_raw raw empty_raw))
			(params (text (shared-slice u8)) (empty_checked (shared-slice u8)) (marker i32)
				(raw (shared-slice u8)) (empty_raw (shared-slice u8)))
			(returns i32))
		(fn wove_test_c_string_step (params (ordinal i32) (value i32)) (returns i32)))
	(fn fill
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(slice.store (local data) (i32 0) (u8 65))
			(slice.store (local data) (i32 1) (u8 255))
			(slice.store (local data) (i32 2) (u8 66))
			(slice.store (local data) (i32 4) (u8 67))
			(return (i32 0))))
	(fn read_back
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(let status (call observe
				(borrow-shared (slice.range (local data) (call step (i32 0) (i32 0)) (i32 2)))
				(borrow-shared (slice.range (local data) (i32 5) (i32 5)))
				(call step (i32 1) (i32 7))
				(borrow-shared (slice.range (local data) (call step (i32 2) (i32 2)) (i32 5)))
				(borrow-shared (slice.range (local data) (i32 0) (i32 0)))))
			(if (u8.eq (slice.load (local data) (i32 4)) (u8 67))
				(then (return (local status))))
			(return (i32 1))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect (tests "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:142"))
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut data (array.alloc u8 (i32 5)))
			(let initialized (call fill (borrow-mut (local data))))
			(return (call read_back (borrow-shared (local data)))))))
