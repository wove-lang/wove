(module c_string_trap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./c_strings.h"
		(only (as wove_test_enter_c_string_trap check) (as wove_test_c_string_later later)))
	(bridge c-header "./c_strings.h"
		(fn wove_test_enter_c_string_trap
			(:pragma (c_cstr_raw raw))
			(:pragma (c_cstr checked))
			(params (raw (shared-array u8)) (checked (shared-array u8)) (marker i32))
			(returns i32))
		(fn wove_test_c_string_later (params) (returns i32)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let data (array.alloc u8 (i32 1)))
			(return (call check
				(borrow-shared (local data))
				(borrow-shared (local data))
				(call later))))))
