(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	project_bridge
	(use wove-file "./unreached.wove" (only dependency))
	(decls
		(bridge c-header `./local.h`
			(fn value (params (sample u32) (enabled bool)) (returns u8))
			(fn invalid (params (bytes (shared-slice u8))) (returns u8))
			(fn (:pragma (test)) hidden (params) (returns i32))
			(fn repeated
				(params
					(value i32)
					(enabled bool)
					(value u32))
				(returns i32))
			(fn bridge_next (params (digit i32)) (returns i32))
			(fn bridge_verify (params (first i32) (second i32)) (returns i32)))))
