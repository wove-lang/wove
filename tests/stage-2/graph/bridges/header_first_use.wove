(module header_first_use
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./local.h" (only bridge_next))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect
			(tests "stage-2/scalar_graphs.tsv" "stage-2/source_renderings.tsv")
			(issues "gh:wove-lang/wove:246"))
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body (return (call bridge_next (i32 42))))))
