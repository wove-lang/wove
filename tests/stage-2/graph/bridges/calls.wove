(module bridge_calls
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "<stdlib.h>" (only (as abs absolute) (as abs unused)))
	(use c-header "./local.h" (only (as bridge_next push_digit) (as bridge_verify verify)))
	(bridge c-header "<stdlib.h>"
		(fn abs (params (value i32)) (returns i32)))
	(fn main (params) (returns i32)
		(body
			(return (call verify
				(call push_digit (call absolute (i32 -4)))
				(call push_digit (i32 2)))))))
