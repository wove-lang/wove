	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./resources.h"
		(type (:pragma (c_owned (drop))) MissingDrop (c-type "WoveTestResource *"))
		(type (:pragma (c_owned (drop wove_test_drop))) ScalarStorage (c-type "int"))
		(type (:pragma (c_owned (drop wove_test_drop))) ExtraDeclarator (c-type "WoveTestResource *value"))
		(fn bad_factory (params) (returns ScalarStorage))))
