	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./resources.h"
		(type MissingDrop (:pragma (c_owned (drop))) (c-type "WoveTestResource *"))
		(type ScalarStorage (:pragma (c_owned (drop wove_test_drop))) (c-type "long int"))
		(type ExtraDeclarator (:pragma (c_owned (drop wove_test_drop))) (c-type "WoveTestResource *value"))
		(fn bad_factory (params) (returns ScalarStorage))))
