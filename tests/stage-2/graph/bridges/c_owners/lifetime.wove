(module resource_lifetime
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use c-header "./resources.h"
		(only (type (as Resource Handle)) (type Resource) (as wove_test_acquire acquire)
			(as wove_test_acquire_text acquire_text) (as wove_test_dropped dropped) (as wove_test_finish finish)))
	(fn exit_scope
		(params (key i32) (early bool))
		(returns bool)
		(body
			(let handle (call acquire key))
			(if early
				(then (return (call dropped key (i32 0)))))
			(return (call dropped key (i32 0)))))
	(fn exit_block
		(params)
		(returns i32)
		(body
			(if (bool true)
				(then
					(let outer (call acquire (i32 3)))
					(let-mut content (array:alloc u8 (i32 0)))
					(let inner (call acquire_text (borrow-shared content)))
					(let received (move inner))))
			(return (call finish))))
	(fn main
		(:expect (tests "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:144"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:not (call exit_scope (i32 1) (bool false)))
				(then (return (i32 2))))
			(if (bool:not (call dropped (i32 1) (i32 1)))
				(then (return (i32 3))))
			(if (bool:not (call exit_scope (i32 2) (bool true)))
				(then (return (i32 4))))
			(if (bool:not (call dropped (i32 2) (i32 1)))
				(then (return (i32 5))))
			(if (bool:not (call exit_scope (i32 0) (bool true)))
				(then (return (i32 6))))
			(return (call exit_block)))))
