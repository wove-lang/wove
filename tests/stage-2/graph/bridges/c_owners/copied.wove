	(use c-header "./resources.h" (only (as wove_test_acquire acquire)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let original (call acquire (i32 1)))
			(let duplicate (local original))
			(return (i32 42)))))
