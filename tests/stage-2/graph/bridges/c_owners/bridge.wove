(module resource_bridge
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./resources.h"
		(type Resource (:pragma (c_owned (drop wwgl000003iouter))) (c-type "\u0077gl000003iouter *"))
		(fn wove_test_acquire (params (key i32)) (returns Resource))
		(fn wove_test_acquire_text
			(:pragma (c_cstr text))
			(params (text (shared-array u8)))
			(returns Resource))
		(fn wove_test_dropped (params (key i32) (count i32)) (returns bool))
		(fn wove_test_finish (params) (returns i32))))
