	(bridge c-header "./platform.h"
		(type (:pragma (cfg (os "linux"))) NativeWord (c-type "int32_t"))
		(type (:pragma (cfg (os "macos"))) NativeWord (c-type "uint32_t"))
		(fn target_offset (params (offset NativeWord)) (returns i32))))
