(module target_bridge
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "./platform.h"
		(type NativeWord (:pragma (cfg (os "linux"))) (c-type "int32_t"))
		(type NativeWord (:pragma (cfg (os "macos"))) (c-type "uint32_t"))
		(fn target_offset (params (offset NativeWord)) (returns i32))))
