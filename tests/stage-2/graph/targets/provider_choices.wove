(module target_provider_choices
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(decls (:pragma (cfg (os "macos")))
		(bridge (:pragma (cfg (os linux))) c-header "<fixture.h>"
			(fn answer (params) (returns i32))))
	(bridge (:pragma (cfg (os "macos"))) c-header "<fixture.h>"
		(fn answer (params) (returns i32)))
	(decls (:pragma (cfg (os "linux")))
		(bridge (:pragma (cfg (arch "x86_64"))) c-header "<fixture.h>"
			(fn answer (params) (returns i32)))))
