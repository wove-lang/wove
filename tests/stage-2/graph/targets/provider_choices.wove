(module target_provider_choices
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(decls (:pragma (cfg (os "macos")))
		(bridge c-header "<fixture.h>" (:pragma (cfg (os linux)))
			(fn answer (params) (returns i32))))
	(bridge c-header "<fixture.h>" (:pragma (cfg (os "macos")))
		(fn answer (params) (returns i32)))
	(decls (:pragma (cfg (os "linux")))
		(bridge c-header "<fixture.h>" (:pragma (cfg (arch "x86_64")))
			(fn answer (params) (returns i32)))))
