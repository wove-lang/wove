(module target_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use (:pragma (cfg (all (os "linux") (arch "x86_64") (not test))))
		wove-file "./linux.wove" (only platform))
	(use (:pragma (cfg (all (os "macos") (not (any (arch "x86_64") (os "linux"))))))
		wove-file "./macos.wove" (only platform))
	(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only fdatasync))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only getpid))
	(use c-header "./platform.h" (only (type NativeWord) target_offset))

	(decls (:pragma (cfg (all (os "linux") (arch "x86_64"))))
		(fn marker (params) (returns i32) (body (return (i32 1)))))
	(fn marker (:pragma (cfg (all (os "macos") (arch "aarch64"))))
		(params) (returns i32) (body (return (i32 2))))
	(fn main (params) (returns i32)
		(body (return (i32.add.wrapping (call platform)
			(call target_offset (int.convert NativeWord (call marker))))))))
