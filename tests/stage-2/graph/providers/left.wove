(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	provider
	(use wove-file "./common/shared.wove" (only (as pick take)))
	(fn main (params (value i32)) (returns i32) (body (return (local value))))
	(fn value (params (first i32) (second i32)) (returns i32)
		(body (return (call take (local first) (local second))))))
