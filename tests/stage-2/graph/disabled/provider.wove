(module disabled_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header "<stdlib.h>"
		(disabled
			(:pragma (cfg unavailable))
			(fn abs
				(:doc "The disabled signature does not conflict with the active declaration.")
				(params (value UnknownType)) (returns UnknownType))
			(fn hidden (params) (returns UnknownType)))
		(fn abs (params (value i32)) (returns i32))
		(disabled (:doc "Additional bridge declarations can remain as notes."))))
