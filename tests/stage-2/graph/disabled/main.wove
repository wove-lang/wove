(module disabled_main
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(disabled
		(:doc `Keep archived declarations here.
These lines retain their original spacing and spelling.`))
	(disabled
		(:doc "Keep these declarations while trying the active replacements.")
		(:pragma (cfg unavailable))
		(use wove-file "./missing.wove" (only absent))
		(struct MissingLayout (fields (value UnknownType)))
		(decls
			(fn helper
				(:doc "The disabled declaration keeps its name before the doc.")
				(:pragma (cfg unavailable))
				(params (step UnknownType)) (returns UnknownType)
				(body (return (call absent step))))))
	(use c-header "<stdlib.h>" (only abs))
	(fn helper (params (step i32)) (returns i32)
		(body (return (i32.add (i32 41) step))))
	(fn empty (params) (returns void)
		(body (disabled (return (call absent)))))
	(fn main
		(:expect (tests "stage-2/scalar_graphs.tsv" "stage-2/source_renderings.tsv") (issues "gh:wove-lang/wove:165"))
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(disabled (:pragma (cfg unavailable)) (let step (call absent)))
			(let-mut step (i32 0))
			(disabled (call helper (i32 5)) (set absent (i32 12)))
			(while (i32.lt step (i32 1))
				(body
					(disabled (call absent))
					(set step (i32.add step (i32 1)))
					(disabled (return (i32 0)))))
			(disabled (call absent))
			(if (bool false)
				(then (disabled (call absent)))
				(else (disabled (return (call absent)))))
			(call empty)
			(return (call abs (call helper step)))
			(disabled (call helper (i32 99)) (return (call absent))))))
