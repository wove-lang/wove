(module header_query_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Assert live query status, diagnostic provenance, and exact declaration matching.")

	(use wove-file "../../../stage-2/clang/query.wove" (only (type QuerySite) query_clang_header))
	(use wove-file "../../../stage-2/clang/index.wove" (only (type ClangDeclaration) clang_declaration))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../stage-2/text/copy.wove" (only append_bytes))
	(use wove-file "../../../stage-2/text/decimal.wove" (only read_decimal_digits))

	(let extra "\nint wove_query_extra(void);\n")

	(fn option_bytes
		(:doc "Pack the original option arguments with one terminator per argument.")
		(params (argv (shared-array (shared-array u8))))
		(returns (owned-array u8))
		(body
			(let count (array:len argv))
			(let-mut width 0i32)
			(let-mut index 11i32)
			(while (i32:lt index count)
				(body
					(set width (i32:add width (i32:inc (array:len (array:get argv index)))))
					(set index (i32:inc index))))
			(let-mut packed (array:alloc u8 width))
			(let-mut written 0i32)
			(set index 11i32)
			(while (i32:lt index count)
				(body
					(let end (call append_bytes (borrow-shared (array:get argv index))
						(borrow-mut packed) written))
					(array:set packed end 0u8)
					(set written (i32:inc end))
					(set index (i32:inc index))))
			(return (move packed))))

	(fn signed_arg
		(:doc "Read the manifest's small signed decimal fields.")
		(params (bytes (shared-array u8)))
		(returns i32)
		(body
			(let negative (u8:eq (array:get bytes 0i32) 45u8))
			(let-mut digits 0i32)
			(if negative (then (set digits 1i32)))
			(let value (call read_decimal_digits (borrow-shared bytes) digits (array:len bytes) 214748364u32 7u32))
			(let result (int:convert i32 (struct:get value magnitude)))
			(if negative (then (return (i32:sub 0i32 result))))
			(return result)))

	(fn flags_equal
		(:doc "Compare expected and returned presence flags.")
		(params (left bool) (right bool))
		(returns bool)
		(body
			(if left (then (return right)))
			(return (bool:not right))))

	(fn main
		(:doc "Run one query and check its result against the selected manifest row.")
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (i32:lt (array:len argv) 11i32) (then (return 10i32)))
			(let program (array:get argv 1i32))
			(let header (array:get argv 2i32))
			(let kind (array:get argv 3i32))
			(let name (array:get argv 4i32))
			(let error (int:convert u32 (call signed_arg (borrow-shared (array:get argv 5i32)))))
			(let present (i32:eq (call signed_arg (borrow-shared (array:get argv 6i32))) 1i32))
			(let found (i32:eq (call signed_arg (borrow-shared (array:get argv 7i32))) 1i32))
			(let capacity (call signed_arg (borrow-shared (array:get argv 8i32))))
			(let rows (call signed_arg (borrow-shared (array:get argv 9i32))))
			(let status (call signed_arg (borrow-shared (array:get argv 10i32))))
			(let options (call option_bytes (borrow-shared argv)))
			(let-mut output (array:alloc u8 capacity))
			(let-mut nodes (array:alloc JsonNode rows))
			(let-mut entries (array:alloc ClangDeclaration 1024i32))
			(let-mut names (array:alloc u8 32768i32))
			(let site (struct:new QuerySite (file 7i32) (start 41i32) (end 59i32)))
			(let query (call query_clang_header
				(borrow-shared program)
				(borrow-shared options)
				(borrow-shared header)
				(borrow-shared extra) site (borrow-mut output) (borrow-mut nodes)
				(borrow-mut entries) (borrow-mut names)))
			(if (bool:not (u32:eq (struct:get query error) error)) (then (return 11i32)))
			(if (bool:not (i32:eq (struct:get (struct:get query run) status) status)) (then (return 12i32)))
			(let origin (struct:get query site))
			(if (bool:not (bool:and (i32:eq (struct:get origin file) 7i32)
				(bool:and (i32:eq (struct:get origin start) 41i32) (i32:eq (struct:get origin end) 59i32))))
				(then (return 13i32)))
			(if (bool:not (call flags_equal (struct:get query present) present)) (then (return 14i32)))
			(if (bool:not present) (then (return 0i32)))
			(let declaration (call clang_declaration (struct:get query index) (borrow-shared entries)
				(borrow-shared names)
				(borrow-shared kind)
				(borrow-shared name)))
			(if (bool:not (call flags_equal (i32:lt -1i32 (struct:get declaration node)) found))
				(then (return 15i32)))
			(return 0i32))))
