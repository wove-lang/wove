(module header_query_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Assert live query status, diagnostic provenance, and exact declaration matching.")

	(use wove-file "../../../stage-2/c/probe.wove" (only (type QuerySite) (type ProbeRun) (type HeaderQuery)))
	(use wove-file "../../../stage-2/clang/query.wove" (only (type (as QuerySite ClangSite)) (type ClangQuery) query_clang_header))
	(use wove-file "../../../stage-2/gcc/query.wove" (only query_gcc_header))
	(use wove-file "../../../stage-2/clang/index.wove" (only (type ClangDeclaration) clang_declaration))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../stage-2/text/copy.wove" (only append_bytes))
	(use wove-file "../../../stage-2/text/decimal.wove" (only read_decimal_digits))

	(struct ArgSpan (fields (start i32) (end i32)))

	(let extra "\nint wove_query_extra(void);\n")

	(fn option_bytes
		(:doc "Pack the original option arguments with one terminator per argument.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns (owned-array u8))
		(body
			(let count (slice.len (local argv)))
			(if (i32.eq (local count) 11i32) (then
					(let empty (array.alloc u8 0i32))
					(return (move (local empty)))))
			(let start (struct.get (slice.load (local argv) 11i32) start))
			(let width (i32.add.wrapping (i32.sub.wrapping (slice.len (local bytes)) (local start))
				(i32.sub.wrapping (local count) 11i32)))
			(let-mut packed (array.alloc u8 (local width)))
			(let-mut index 11i32)
			(let-mut written 0i32)
			(while (i32.lt (local index) (local count))
				(body
					(let span (slice.load (local argv) (local index)))
					(let end (call append_bytes (borrow-shared (slice.range (local bytes)
						(struct.get (local span) start) (struct.get (local span) end)))
						(borrow-mut (local packed)) (local written)))
					(slice.store (local packed) (local end) 0u8)
					(set (local written) (i32.add.wrapping (local end) 1i32))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (move (local packed)))))

	(fn signed_arg
		(:doc "Read the manifest's small signed decimal fields.")
		(params (bytes (shared-slice u8)) (span ArgSpan))
		(returns i32)
		(body
			(let start (struct.get (local span) start))
			(let end (struct.get (local span) end))
			(let negative (u8.eq (slice.load (local bytes) (local start)) 45u8))
			(let-mut digits (local start))
			(if (local negative) (then (set (local digits) (i32.add.wrapping (local start) 1i32))))
			(let value (call read_decimal_digits (borrow-shared (local bytes)) (local digits) (local end) 214748364u32 7u32))
			(let result (int.convert i32 (struct.get (local value) magnitude)))
			(if (local negative) (then (return (i32.sub.wrapping 0i32 (local result)))))
			(return (local result))))

	(fn flags_equal
		(:doc "Compare expected and returned presence flags.")
		(params (left bool) (right bool))
		(returns bool)
		(body
			(if (local left) (then (return (local right))))
			(return (bool.not (local right)))))

	(fn clang_fixture_result
		(:doc "Project the public Clang result into the fixture's common assertion shape.")
		(params (result ClangQuery))
		(returns HeaderQuery)
		(body
			(let site (struct.get (local result) site))
			(let run (struct.get (local result) run))
			(return (struct.new HeaderQuery
				(site (struct.new QuerySite (file (struct.get (local site) file))
					(start (struct.get (local site) start)) (end (struct.get (local site) end))))
				(run (struct.new ProbeRun (error (struct.get (local run) error))
					(status (struct.get (local run) status)) (length (struct.get (local run) length))))
				(index (struct.get (local result) index)) (fact (struct.get (local result) fact))
				(error (struct.get (local result) error)) (present (struct.get (local result) present))))))

	(fn run_query
		(:doc "Exercise both frontends with identical query result assertions.")
		(params (gcc bool) (program (shared-slice u8)) (options (shared-slice u8)) (header (shared-slice u8))
			(site QuerySite) (output (mut-slice u8)) (nodes (mut-slice JsonNode))
			(entries (mut-slice ClangDeclaration)) (names (mut-slice u8)))
		(returns HeaderQuery)
		(body
			(if (local gcc)
				(then (return (call query_gcc_header (borrow-shared (local program)) (borrow-shared (local options))
					(borrow-shared (local header)) (borrow-shared (local extra)) (local site) (borrow-mut (local output))
					(borrow-mut (local nodes)) (borrow-mut (local entries)) (borrow-mut (local names))))))
			(let origin (struct.new ClangSite (file (struct.get (local site) file))
				(start (struct.get (local site) start)) (end (struct.get (local site) end))))
			(let result (call query_clang_header (borrow-shared (local program)) (borrow-shared (local options))
				(borrow-shared (local header)) (borrow-shared (local extra)) (local origin) (borrow-mut (local output))
				(borrow-mut (local nodes)) (borrow-mut (local entries)) (borrow-mut (local names))))
			(return (call clang_fixture_result (local result)))))

	(fn main
		(:doc "Run one query and check its result against the selected manifest row.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(if (i32.lt (slice.len (local argv)) 11i32) (then (return 10i32)))
			(let program (slice.load (local argv) 1i32))
			(let header (slice.load (local argv) 2i32))
			(let kind (slice.load (local argv) 3i32))
			(let name (slice.load (local argv) 4i32))
			(let error (int.convert u32 (call signed_arg (borrow-shared (local bytes)) (slice.load (local argv) 5i32))))
			(let present (i32.eq (call signed_arg (borrow-shared (local bytes)) (slice.load (local argv) 6i32)) 1i32))
			(let found (i32.eq (call signed_arg (borrow-shared (local bytes)) (slice.load (local argv) 7i32)) 1i32))
			(let capacity (call signed_arg (borrow-shared (local bytes)) (slice.load (local argv) 8i32)))
			(let rows (call signed_arg (borrow-shared (local bytes)) (slice.load (local argv) 9i32)))
			(let status (call signed_arg (borrow-shared (local bytes)) (slice.load (local argv) 10i32)))
			(let options (call option_bytes (borrow-shared (local bytes)) (borrow-shared (local argv))))
			(let-mut output (array.alloc u8 (local capacity)))
			(let-mut nodes (array.alloc JsonNode (local rows)))
			(let-mut entries (array.alloc ClangDeclaration 1024i32))
			(let-mut names (array.alloc u8 32768i32))
			(let site (struct.new QuerySite (file 7i32) (start 41i32) (end 59i32)))
			(let frontend (slice.load (local argv) 0i32))
			(let gcc (u8.eq (slice.load (local bytes) (struct.get (local frontend) start)) 103u8))
			(let query (call run_query (local gcc)
				(borrow-shared (slice.range (local bytes) (struct.get (local program) start) (struct.get (local program) end)))
				(borrow-shared (local options))
				(borrow-shared (slice.range (local bytes) (struct.get (local header) start) (struct.get (local header) end)))
				(local site) (borrow-mut (local output)) (borrow-mut (local nodes))
				(borrow-mut (local entries)) (borrow-mut (local names))))
			(if (bool.not (u32.eq (struct.get (local query) error) (local error))) (then (return 11i32)))
			(if (bool.not (i32.eq (struct.get (struct.get (local query) run) status) (local status))) (then (return 12i32)))
			(let origin (struct.get (local query) site))
			(if (bool.not (bool.and (i32.eq (struct.get (local origin) file) 7i32)
				(bool.and (i32.eq (struct.get (local origin) start) 41i32) (i32.eq (struct.get (local origin) end) 59i32))))
				(then (return 13i32)))
			(if (bool.not (call flags_equal (struct.get (local query) present) (local present))) (then (return 14i32)))
			(if (bool.not (local present)) (then (return 0i32)))
			(let declaration (call clang_declaration (struct.get (local query) index) (borrow-shared (local entries))
				(borrow-shared (local names))
				(borrow-shared (slice.range (local bytes) (struct.get (local kind) start) (struct.get (local kind) end)))
				(borrow-shared (slice.range (local bytes) (struct.get (local name) start) (struct.get (local name) end)))))
			(if (bool.not (call flags_equal (i32.lt -1i32 (struct.get (local declaration) node)) (local found)))
				(then (return 15i32)))
			(return 0i32))))
