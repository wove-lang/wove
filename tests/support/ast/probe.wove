(module ast_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/clang/source.wove" (only render_clang_probe))
	(use wove-file "../../../stage-2/clang/index.wove" (only (type ClangDeclaration) clang_index clang_declaration))
	(use wove-file "../../../stage-2/clang/values.wove" (only clang_probe_value clang_probe_u32))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(struct Inspection (fields (error u32) (start i32) (end i32) (count i32)
		(match_start i32) (match_end i32) (probe_error u32) (probe_start i32) (probe_end i32) (probe_value u32)))
	(struct SourceCase (fields (first i32) (second i32) (size i32) (error u32)))

	(fn check_source
		(params (template (shared-array u8)) (header (shared-array u8)) (extra (shared-array u8)) (literal (shared-array u8))
			(expected SourceCase) (output (mut-array u8)))
		(returns i32)
		(body
			(let size (struct:get expected size))
			(let code (struct:get expected error))
			(if (u32:lt (u32 0) code)
				(then
					(call fill_guard (borrow-mut output))
					(let result (call render_clang_probe (borrow-shared template) (borrow-shared header)
						(borrow-shared extra) (borrow-mut output)))
					(if (bool:not (u32:eq (struct:get result error) code)) (then (return (i32 1))))
					(if (bool:not (bool:and (i32:eq (struct:get result written) (i32 0))
						(call still_guarded (borrow-shared output)))) (then (return (i32 2))))
					(return (i32 0))))
			(let-mut empty (array:alloc u8 (i32 0)))
			(let measured (call render_clang_probe (borrow-shared template) (borrow-shared header)
				(borrow-shared extra) (borrow-mut empty)))
			(if (bool:not (bool:and (u32:eq (struct:get measured error) (u32 4))
				(bool:and (i32:eq (struct:get measured written) (i32 0)) (i32:eq (struct:get measured required) size))))
				(then (return (i32 3))))
			(let-mut short (array:alloc u8 (i32:sub size (i32 1))))
			(call fill_guard (borrow-mut short))
			(let capped (call render_clang_probe (borrow-shared template) (borrow-shared header)
				(borrow-shared extra) (borrow-mut short)))
			(if (bool:not (bool:and (u32:eq (struct:get capped error) (u32 4))
				(bool:and (i32:eq (struct:get capped written) (i32 0))
					(bool:and (i32:eq (struct:get capped required) size) (call still_guarded (borrow-shared short))))))
				(then (return (i32 4))))
			(let rendered (call render_clang_probe (borrow-shared template) (borrow-shared header)
				(borrow-shared extra) (borrow-mut output)))
			(if (bool:not (bool:and (u32:eq (struct:get rendered error) (u32 0))
				(bool:and (i32:eq (struct:get rendered written) size) (i32:eq (struct:get rendered required) size))))
				(then (return (i32 5))))
			(return (call check_replacements (borrow-shared template) (borrow-shared literal)
				(borrow-shared extra) (borrow-shared output) expected))))

	(fn check_ast
		(params (source (shared-array u8)) (offset i32) (kind (shared-array u8)) (name (shared-array u8)) (probe (shared-array u8))
			(expected Inspection) (expected_text (shared-array u8)))
		(returns i32)
		(body
			(let width (array:len source))
			(let-mut nodes (array:alloc JsonNode width))
			(let-mut entries (array:alloc ClangDeclaration width))
			(let-mut names (array:alloc u8 width))
			(let index (call clang_index (borrow-shared source) offset (borrow-mut nodes)
				(borrow-mut entries) (borrow-mut names)))
			(if (bool:not (u32:eq (struct:get index error) (struct:get expected error))) (then (return (i32 11))))
			(if (bool:not (bool:and (call expected_coordinate (struct:get index start) (struct:get expected start))
				(call expected_coordinate (struct:get index end) (struct:get expected end)))) (then (return (i32 12))))
			(if (bool:not (call expected_coordinate (struct:get index entries) (struct:get expected count))) (then (return (i32 13))))
			(if (u32:lt (u32 0) (struct:get index error)) (then (return (i32 0))))
			(let declaration (call clang_declaration index (borrow-shared entries) (borrow-shared names)
				(borrow-shared kind) (borrow-shared name)))
			(if (bool:not (bool:and (call expected_coordinate (struct:get declaration start) (struct:get expected match_start))
				(call expected_coordinate (struct:get declaration end) (struct:get expected match_end)))) (then (return (i32 14))))
			(if (i32:eq (array:len probe) (i32 0)) (then (return (i32 0))))
			(let selected (call clang_probe_value (borrow-shared source) index (borrow-shared nodes)
				(borrow-shared entries) (borrow-shared names) (borrow-shared probe)))
			(if (i32:lt (i32 0) (array:len expected_text))
				(then
					(if (bool:or (u32:lt (u32 0) (struct:get selected error))
						(bool:not (call same_bytes (borrow-shared source)
							(i32:add (struct:get selected start) (i32 1))
							(i32:sub (struct:get selected end) (i32 1))
							(borrow-shared expected_text) (i32 0) (array:len expected_text))))
						(then (return (i32 18))))))
			(let value (call clang_probe_u32 (borrow-shared source) selected))
			(if (bool:not (u32:eq (struct:get value error) (struct:get expected probe_error)))
				(then (return (i32 15))))
			(if (bool:not (bool:and (call expected_coordinate (struct:get value start) (struct:get expected probe_start))
				(call expected_coordinate (struct:get value end) (struct:get expected probe_end))))
				(then (return (i32 16))))
			(if (bool:not (u32:eq (struct:get value value) (struct:get expected probe_value)))
				(then (return (i32 17))))
			(return (i32 0))))

	(fn expected_coordinate
		(params (actual i32) (expected i32))
		(returns bool)
		(body
			(:doc "Live compiler offsets and counts vary. A case can require a nonnegative coordinate with -2.")
			(return (bool:or (i32:eq actual expected)
				(bool:and (i32:eq expected (i32 -2)) (bool:not (i32:lt actual (i32 0))))))))

	(fn fill_guard
		(params (bytes (mut-array u8)))
		(returns void)
		(body
			(let-mut at (i32 0))
			(while (i32:lt at (array:len bytes))
				(body
					(array:set bytes at (u8 165))
					(set at (i32:add at (i32 1)))))))

	(fn still_guarded
		(params (bytes (shared-array u8)))
		(returns bool)
		(body
			(let-mut at (i32 0))
			(while (i32:lt at (array:len bytes))
				(body
					(if (bool:not (u8:eq (array:get bytes at) (u8 165))) (then (return (bool false))))
					(set at (i32:add at (i32 1)))))
			(return (bool true))))

	(fn check_replacements
		(params (template (shared-array u8)) (literal (shared-array u8)) (extra (shared-array u8)) (source (shared-array u8))
			(expected SourceCase))
		(returns i32)
		(body
			(let first (struct:get expected first))
			(let second (struct:get expected second))
			(let width (array:len literal))
			(let first_end (i32:add first width))
			(let shifted (i32:add second (i32:sub width (i32 5))))
			(let second_end (i32:add shifted width))
			(let extra_start (i32:sub (array:len source) (array:len extra)))
			(if (bool:not (call same_bytes (borrow-shared template) (i32 0) first
				(borrow-shared source) (i32 0) first)) (then (return (i32 21))))
			(if (bool:not (call same_bytes (borrow-shared literal) (i32 0) width
				(borrow-shared source) first first_end)) (then (return (i32 22))))
			(if (bool:not (call same_bytes (borrow-shared template) (i32:add first (i32 5)) second
				(borrow-shared source) first_end shifted)) (then (return (i32 23))))
			(if (bool:not (call same_bytes (borrow-shared literal) (i32 0) width
				(borrow-shared source) shifted second_end)) (then (return (i32 24))))
			(if (bool:not (call same_bytes (borrow-shared template) (i32:add second (i32 5))
				(array:len template) (borrow-shared source) second_end extra_start))
				(then (return (i32 25))))
			(if (bool:not (call same_bytes (borrow-shared extra) (i32 0) (array:len extra)
				(borrow-shared source) extra_start (array:len source))) (then (return (i32 26))))
			(return (i32 0))))

	(fn main (params (entry_spans (shared-array (shared-array u8)))) (returns i32) (body (return (i32 0)))))
