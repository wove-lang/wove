(module ast_fixture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "../../../stage-2/clang/source.wove" (only render_clang_probe))
	(use wove-file "../../../stage-2/clang/index.wove" (only (type ClangDeclaration) clang_index clang_declaration))
	(use wove-file "../../../stage-2/clang/values.wove" (only clang_probe_value clang_probe_u32))
	(use wove-file "../../../stage-2/json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../../stage-2/text/bytes.wove" (only same_bytes))

	(struct Inspection (fields (error u32) (start i32) (end i32) (count i32)
		(match_start i32) (match_end i32) (probe_error u32) (probe_start i32) (probe_end i32) (probe_value u32)))
	(struct SourceCase (fields (first i32) (second i32) (size i32) (error u32)))

	(fn check_source
		(params (template (shared-slice u8)) (header (shared-slice u8)) (extra (shared-slice u8)) (literal (shared-slice u8))
			(expected SourceCase) (output (mut-slice u8)))
		(returns i32)
		(body
			(let size (record.get (local expected) size))
			(let code (record.get (local expected) error))
			(if (u32.lt (u32 0) (local code))
				(then
					(call fill_guard (borrow-mut (local output)))
					(let result (call render_clang_probe (borrow-shared (local template)) (borrow-shared (local header))
						(borrow-shared (local extra)) (borrow-mut (local output))))
					(if (bool.not (u32.eq (record.get (local result) error) (local code))) (then (return (i32 1))))
					(if (bool.not (bool.and (i32.eq (record.get (local result) written) (i32 0))
						(call still_guarded (borrow-shared (local output))))) (then (return (i32 2))))
					(return (i32 0))))
			(let-mut empty (array.alloc u8 (i32 0)))
			(let measured (call render_clang_probe (borrow-shared (local template)) (borrow-shared (local header))
				(borrow-shared (local extra)) (borrow-mut (local empty))))
			(if (bool.not (bool.and (u32.eq (record.get (local measured) error) (u32 4))
				(bool.and (i32.eq (record.get (local measured) written) (i32 0)) (i32.eq (record.get (local measured) required) (local size)))))
				(then (return (i32 3))))
			(let-mut short (array.alloc u8 (i32.sub.wrapping (local size) (i32 1))))
			(call fill_guard (borrow-mut (local short)))
			(let capped (call render_clang_probe (borrow-shared (local template)) (borrow-shared (local header))
				(borrow-shared (local extra)) (borrow-mut (local short))))
			(if (bool.not (bool.and (u32.eq (record.get (local capped) error) (u32 4))
				(bool.and (i32.eq (record.get (local capped) written) (i32 0))
					(bool.and (i32.eq (record.get (local capped) required) (local size)) (call still_guarded (borrow-shared (local short)))))))
				(then (return (i32 4))))
			(let rendered (call render_clang_probe (borrow-shared (local template)) (borrow-shared (local header))
				(borrow-shared (local extra)) (borrow-mut (local output))))
			(if (bool.not (bool.and (u32.eq (record.get (local rendered) error) (u32 0))
				(bool.and (i32.eq (record.get (local rendered) written) (local size)) (i32.eq (record.get (local rendered) required) (local size)))))
				(then (return (i32 5))))
			(return (call check_replacements (borrow-shared (local template)) (borrow-shared (local literal))
				(borrow-shared (local extra)) (borrow-shared (local output)) (local expected)))))

	(fn check_ast
		(params (source (shared-slice u8)) (offset i32) (kind (shared-slice u8)) (name (shared-slice u8)) (probe (shared-slice u8))
			(expected Inspection) (expected_text (shared-slice u8)))
		(returns i32)
		(body
			(let width (slice.len (local source)))
			(let-mut nodes (array.alloc JsonNode (local width)))
			(let-mut entries (array.alloc ClangDeclaration (local width)))
			(let-mut names (array.alloc u8 (local width)))
			(let index (call clang_index (borrow-shared (local source)) (local offset) (borrow-mut (local nodes))
				(borrow-mut (local entries)) (borrow-mut (local names))))
			(if (bool.not (u32.eq (record.get (local index) error) (record.get (local expected) error))) (then (return (i32 11))))
			(if (bool.not (bool.and (call expected_coordinate (record.get (local index) start) (record.get (local expected) start))
				(call expected_coordinate (record.get (local index) end) (record.get (local expected) end)))) (then (return (i32 12))))
			(if (bool.not (call expected_coordinate (record.get (local index) entries) (record.get (local expected) count))) (then (return (i32 13))))
			(if (u32.lt (u32 0) (record.get (local index) error)) (then (return (i32 0))))
			(let declaration (call clang_declaration (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local kind)) (borrow-shared (local name))))
			(if (bool.not (bool.and (call expected_coordinate (record.get (local declaration) start) (record.get (local expected) match_start))
				(call expected_coordinate (record.get (local declaration) end) (record.get (local expected) match_end)))) (then (return (i32 14))))
			(if (i32.eq (slice.len (local probe)) (i32 0)) (then (return (i32 0))))
			(let selected (call clang_probe_value (borrow-shared (local source)) (local index) (borrow-shared (local nodes))
				(borrow-shared (local entries)) (borrow-shared (local names)) (borrow-shared (local probe))))
			(if (i32.lt (i32 0) (slice.len (local expected_text)))
				(then
					(if (bool.or (u32.lt (u32 0) (record.get (local selected) error))
						(bool.not (call same_bytes (borrow-shared (local source))
							(i32.add.wrapping (record.get (local selected) start) (i32 1))
							(i32.sub.wrapping (record.get (local selected) end) (i32 1))
							(borrow-shared (local expected_text)) (i32 0) (slice.len (local expected_text)))))
						(then (return (i32 18))))))
			(let value (call clang_probe_u32 (borrow-shared (local source)) (local selected)))
			(if (bool.not (u32.eq (record.get (local value) error) (record.get (local expected) probe_error)))
				(then (return (i32 15))))
			(if (bool.not (bool.and (call expected_coordinate (record.get (local value) start) (record.get (local expected) probe_start))
				(call expected_coordinate (record.get (local value) end) (record.get (local expected) probe_end))))
				(then (return (i32 16))))
			(if (bool.not (u32.eq (record.get (local value) value) (record.get (local expected) probe_value)))
				(then (return (i32 17))))
			(return (i32 0))))

	(fn expected_coordinate
		(params (actual i32) (expected i32))
		(returns bool)
		(body
			(:doc "Live compiler offsets and counts vary. A case can require a nonnegative coordinate with -2.")
			(return (bool.or (i32.eq (local actual) (local expected))
				(bool.and (i32.eq (local expected) (i32 -2)) (bool.not (i32.lt (local actual) (i32 0))))))))

	(fn fill_guard
		(params (bytes (mut-slice u8)))
		(returns void)
		(body
			(let-mut at (i32 0))
			(while (i32.lt (local at) (slice.len (local bytes)))
				(body
					(slice.store (local bytes) (local at) (u8 165))
					(set (local at) (i32.add.wrapping (local at) (i32 1)))))))

	(fn still_guarded
		(params (bytes (shared-slice u8)))
		(returns bool)
		(body
			(let-mut at (i32 0))
			(while (i32.lt (local at) (slice.len (local bytes)))
				(body
					(if (bool.not (u8.eq (slice.load (local bytes) (local at)) (u8 165))) (then (return (bool false))))
					(set (local at) (i32.add.wrapping (local at) (i32 1)))))
			(return (bool true))))

	(fn check_replacements
		(params (template (shared-slice u8)) (literal (shared-slice u8)) (extra (shared-slice u8)) (source (shared-slice u8))
			(expected SourceCase))
		(returns i32)
		(body
			(let first (record.get (local expected) first))
			(let second (record.get (local expected) second))
			(let width (slice.len (local literal)))
			(let first_end (i32.add.wrapping (local first) (local width)))
			(let shifted (i32.add.wrapping (local second) (i32.sub.wrapping (local width) (i32 5))))
			(let second_end (i32.add.wrapping (local shifted) (local width)))
			(let extra_start (i32.sub.wrapping (slice.len (local source)) (slice.len (local extra))))
			(if (bool.not (call same_bytes (borrow-shared (local template)) (i32 0) (local first)
				(borrow-shared (local source)) (i32 0) (local first))) (then (return (i32 21))))
			(if (bool.not (call same_bytes (borrow-shared (local literal)) (i32 0) (local width)
				(borrow-shared (local source)) (local first) (local first_end))) (then (return (i32 22))))
			(if (bool.not (call same_bytes (borrow-shared (local template)) (i32.add.wrapping (local first) (i32 5)) (local second)
				(borrow-shared (local source)) (local first_end) (local shifted))) (then (return (i32 23))))
			(if (bool.not (call same_bytes (borrow-shared (local literal)) (i32 0) (local width)
				(borrow-shared (local source)) (local shifted) (local second_end))) (then (return (i32 24))))
			(if (bool.not (call same_bytes (borrow-shared (local template)) (i32.add.wrapping (local second) (i32 5))
				(slice.len (local template)) (borrow-shared (local source)) (local second_end) (local extra_start)))
				(then (return (i32 25))))
			(if (bool.not (call same_bytes (borrow-shared (local extra)) (i32 0) (slice.len (local extra))
				(borrow-shared (local source)) (local extra_start) (slice.len (local source)))) (then (return (i32 26))))
			(return (i32 0))))

	(fn main (params) (returns i32) (body (return (i32 0)))))
