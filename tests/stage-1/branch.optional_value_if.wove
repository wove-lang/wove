(module optional_value_if
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn choose (params (present bool)) (returns (optional (owned-array u8)))
		(body
			(let bytes (array:alloc u8 42i32))
			(return (if present
				(then (optional:some (move bytes)))
				(else (optional:none (owned-array u8)))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let absent (call choose (bool false)))
			(if (bool:not (owner:is-null absent)) (then (return 1i32)))
			(let present (call choose (bool true)))
			(if (owner:is-null present) (then (return 2i32)))
			(let bytes (move (optional:unwrap present)))
			(return (array:len bytes))))
)
