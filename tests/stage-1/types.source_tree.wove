(module imported_source_tree
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "../../stage-2/source/scan.wove"
		(only check_source_form build_source_tree
			(type SourceNode)
			(type (as SourceNode Node))
			(type (as FormCheck CheckedForm))))
	(fn fill_source
		(params (source (mut-array u8)))
		(returns void)
		(body
			(array:store source (i32 0) (u8 40))
			(array:store source (i32 1) (u8 120))
			(array:store source (i32 2) (u8 41))))
	(fn build
		(params (source (shared-array u8)) (checked CheckedForm) (nodes (mut-array Node)))
		(returns CheckedForm)
		(body
			(return (call build_source_tree
				(borrow-shared source) checked (borrow-mut nodes)))))
	(fn tag_kind
		(params (nodes (shared-array Node)))
		(returns u32)
		(body (return (struct:get (array:load nodes (i32 2)) kind))))
	(fn main
		(:expect bootstrap.record_type_imports
			(issue "https://github.com/wove-lang/wove/issues/64"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut source (array:alloc u8 (i32 3)))
			(call fill_source (borrow-mut source))
			(let checked (call check_source_form (borrow-shared source)))
			(if (bool:not (u32:eq (struct:get checked rows) (u32 3)))
				(then (return (i32 1))))
			(let-mut nodes (array:alloc SourceNode (int:convert i32 (struct:get checked rows))))
			(let built (call build (borrow-shared source) checked (borrow-mut nodes)))
			(if (bool:and
					(u32:eq (struct:get built error) (u32 0))
					(u32:eq (call tag_kind (borrow-shared nodes)) (u32 1)))
				(then (return (i32 42))))
			(return (i32 2)))))
