(module imported_source_tree
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "../../stage-2/source/scan.wove"
		(only check_source_form build_source_tree
			(type SourceNode)
			(type (as SourceNode Node))
			(type (as FormCheck CheckedForm))))
	(fn fill_source
		(params (source (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local source) (i32 0) (u8 40))
			(slice.store (local source) (i32 1) (u8 120))
			(slice.store (local source) (i32 2) (u8 41))))
	(fn build
		(params (source (shared-slice u8)) (checked CheckedForm) (nodes (mut-slice Node)))
		(returns CheckedForm)
		(body
			(return (call build_source_tree
				(borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))))
	(fn tag_kind
		(params (nodes (shared-slice Node)))
		(returns u32)
		(body (return (struct.get (slice.load (local nodes) (i32 2)) kind))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:expect bootstrap.record_type_imports
			(issue "https://github.com/wove-lang/wove/issues/64"))
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut source (array.alloc u8 (i32 3)))
			(call fill_source (borrow-mut (local source)))
			(let checked (call check_source_form (borrow-shared (local source))))
			(if (bool.not (u32.eq (struct.get (local checked) rows) (u32 3)))
				(then (return (i32 1))))
			(let-mut nodes (array.alloc SourceNode (int.convert i32 (struct.get (local checked) rows))))
			(let built (call build (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(if (bool.and
					(u32.eq (struct.get (local built) error) (u32 0))
					(u32.eq (call tag_kind (borrow-shared (local nodes))) (u32 1)))
				(then (return (i32 42))))
			(return (i32 2)))))
