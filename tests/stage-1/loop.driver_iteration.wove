(module driver_iteration
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let letters "ABCDE")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut limit 5i32)
			(let-mut sum 32i32)
			(for (let index) (range 0i32 limit)
				(body
					(set limit 0i32)
					(set sum (i32.add sum index))))
			(for (let index item) (borrow-shared letters)
				(body
					(if (i32.eq index 1i32)
						(then
							(let temporary (array.alloc u8 3i32))
							(set sum (i32.sub sum (array.len temporary)))
							(continue)))
					(if (i32.eq index 3i32) (then (break)))
					(set sum (i32.add sum (i32.sub (i32.from-u8 item) 65i32)))))
			(return (i32.inc sum)))))
