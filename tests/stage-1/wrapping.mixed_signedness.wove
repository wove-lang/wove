(module mixed_signedness
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "Equal-width operands must match the operation's signedness.")
		(params)
		(returns i32)
		(body
			(return (i32.add.wrapping
					(i32 1)
					(u32 1))))))
