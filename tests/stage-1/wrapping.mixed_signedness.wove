(module mixed_signedness
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Equal-width operands must match the operation's signedness.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (i32.add.wrapping
					(i32 1)
					(u32 1))))))
