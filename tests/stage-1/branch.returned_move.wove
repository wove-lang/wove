(module branch_returned_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn length
		(:doc "Read the length without taking ownership of the buffer.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array.len (local data)))))

	(fn inspect
		(:doc "Return with the moved owner on one path and use the original on the other.")
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(if (local take)
				(then
					(let received (move (local buffer)))
					(return (call length (borrow-shared (local received))))))
			(return (call length (borrow-shared (local buffer))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Exercise the returning arm and the omitted else path.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (i32.add.wrapping
					(call inspect (bool true))
					(call inspect (bool false)))))))
