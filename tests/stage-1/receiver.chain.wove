(module receiver_chain
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (count i32)))
	(struct Packet (fields (header Header)))

	(fn threshold
		(params (calls (mut-array i32)))
		(returns i32)
		(body
			(calls.set 0i32 (i32:inc (calls.get 0i32)))
			(return 1i32)))

	(fn fail
		(params)
		(returns bool)
		(body (return (i32:eq (i32:div 1i32 0i32) 0i32))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let packet (struct:new Packet (header (struct:new Header (count 41i32)))))
			(let-mut values (array:alloc u8 2i32))
			(let-mut calls (array:alloc i32 1i32))
			(let bare values.len.not-eqz)
			(let grouped (values.len.not-eqz))
			(if (bool:or bare.not grouped.not) (then (return 1i32)))
			(if (values.len.eqz.and (call fail)) (then (return 2i32)))
			(if (bool:not (values.len.gt (:doc "Evaluate the explicit argument once.")
				(call threshold (borrow-mut calls))))
				(then (return 3i32)))
			(if (i32:not-eq (calls.get 0i32) 1i32) (then (return 4i32)))
			(let count packet/header/count.inc.dec.inc)
			(if (i32:not-eq count (i32:inc (i32:dec (i32:inc packet/header/count))))
				(then (return 5i32)))
			(return count))))
