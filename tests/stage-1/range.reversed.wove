(module range_reversed
	;; If called, the helper traps with a different diagnostic.
	(fn trap_if_called
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(let checked (int.convert u8 (i32 256)))
			(return (i32.add.wrapping (slice.len (local data)) (int.convert i32 (local checked))))))

	;; Form the range from dynamic parameters before calling the helper.
	(fn forward
		(params (data (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(return (call trap_if_called
				(borrow-shared (slice.range (local data) (local start) (local end)))))))

	;; Supply bounds that do not form a valid half-open range.
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (call forward (borrow-shared (local buffer)) (i32 2) (i32 1))))))
