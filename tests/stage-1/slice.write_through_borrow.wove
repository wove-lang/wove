(module write_through_borrow
	(with-meta
		(meta
			(:expect ownership.write_through_borrow
				(issue "https://github.com/wove-lang/wove/issues/2")))
		;; Replace the selected byte in the caller's buffer.
		(fn write_byte
			(params (data (mut-slice u8)) (index i32) (value u8))
			(returns void)
			(body
				(slice.store (local data) (local index) (local value)))))

	;; Read the three bytes through a shared loan after the call returns.
	(fn read_buffer
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(let first (i32.from-u8 (slice.load (local data) (i32 0))))
			(let middle (i32.from-u8 (slice.load (local data) (i32 1))))
			(let last (i32.from-u8 (slice.load (local data) (i32 2))))
			;; Adding either nonzero edge byte to the last valid index traps.
			(let end (i32.add.wrapping (i32 2)
				(i32.add.wrapping (local first) (local last))))
			(let zero (i32.from-u8 (slice.load (local data) (local end))))
			(return (i32.add.wrapping (local middle) (local zero)))))

	;; Write one byte without replacing its owner, then observe the result.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call write_byte (borrow-mut (local buffer)) (i32 1) (u8 42))
			(return (call read_buffer (borrow-shared (local buffer)))))))
