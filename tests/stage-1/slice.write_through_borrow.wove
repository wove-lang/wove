(module write_through_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn write_byte
		(:doc "Replace the selected byte in the caller's buffer.") (:expect ownership.write_through_borrow
			(issue "https://github.com/wove-lang/wove/issues/2"))
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array.store data index value)))

	(fn read_buffer
		(:doc "Read the three bytes through a shared loan after the call returns.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let first (i32.from-u8 (array.load data (i32 0))))
			(let middle (i32.from-u8 (array.load data (i32 1))))
			(let last (i32.from-u8 (array.load data (i32 2))))
			(let end
				(:doc "Adding either nonzero edge byte to the last valid index traps.") (i32.add (i32 2)
					(i32.add first last)))
			(let zero (i32.from-u8 (array.load data end)))
			(return (i32.add middle zero))))

	(fn main
		(:doc "Write one byte without replacing its owner, then observe the result.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call write_byte (borrow-mut buffer) (i32 1) (u8 42))
			(return (call read_buffer (borrow-shared buffer))))))
