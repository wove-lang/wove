(module array_range_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn write
		(params (view (mut-array u8))) (returns i32)
		(body
			(array.store (local view) 0i32 42u8)
			(return (array.len (local view)))))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 4i32))
			(return (call write (borrow-mut (array.range (local data) 2i32 5i32)))))))
