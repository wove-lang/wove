(module array_range_bounds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn write
		(params (view (mut-array u8))) (returns i32)
		(body
			(array.store view 0i32 42u8)
			(return (array.len view))))
	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc u8 4i32))
			(return (call write (borrow-mut (array.range data 2i32 5i32)))))))
