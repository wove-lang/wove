(module array_range_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn count
		(params (first (mut-array u8)) (second (shared-array u8))) (returns i32)
		(body (return (i32:add (array:len first) (array:len second)))))
	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 4i32))
			(return (call count
				(borrow-mut (array:range data 1i32 2i32))
				(borrow-shared data))))))
