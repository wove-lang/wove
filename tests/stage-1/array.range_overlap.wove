(module array_range_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn count
		(params (first (mut-array u8)) (second (shared-array u8))) (returns i32)
		(body (return (i32.add.wrapping (array.len (local first)) (array.len (local second))))))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 4i32))
			(return (call count
				(borrow-mut (array.range (local data) 1i32 2i32))
				(borrow-shared (local data)))))))
