(module comparison_mixed_signedness
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "An unsigned comparison requires two unsigned operands.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let result (u32.lt
					(i32 -1)
					(u32 0)))
			(return (i32 0)))))
