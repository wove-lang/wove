(module comparison_mixed_signedness
	;; An unsigned comparison requires two unsigned operands.
	(fn main
		(params)
		(returns i32)
		(body
			(let result (u32.lt
				(i32 -1)
				(u32 0)))
			(return (i32 0)))))
