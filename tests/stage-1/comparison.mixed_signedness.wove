	comparison_mixed_signedness
	(fn
		(:doc "An unsigned comparison requires two unsigned operands.")
		main
		(params)
		(returns i32)
		(body
			(let result (u32.lt
					(i32 -1)
					(u32 0)))
			(return (i32 0)))))
