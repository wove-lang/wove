(module range_endpoint_type
	;; Accept a shared view.
	(fn length
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))

	;; Range endpoints must have the exact i32 type.
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (call length
				(borrow-shared (slice.range (local buffer)
					(u32 1)
					(i32 3))))))))
