(module range_endpoint_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn length
		(:doc "Accept a shared view.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array:len data))))

	(fn main
		(:doc "Range endpoints must have the exact i32 type.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array:alloc u8 (i32 3)))
			(return (call length
					(borrow-shared (array:range buffer
							(u32 1)
							(i32 3))))))))
