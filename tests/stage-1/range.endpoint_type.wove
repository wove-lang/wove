(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	range_endpoint_type
	(fn
		(:doc "Accept a shared view.")
		length
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))

	(fn
		(:doc "Range endpoints must have the exact i32 type.")
		main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (call length
					(borrow-shared (slice.range (local buffer)
							(u32 1)
							(i32 3))))))))
