(module record_unknown_member
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (start i32)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let token (struct:new Token (start (i32 2))))
			(return (struct:get token
					end)))))
