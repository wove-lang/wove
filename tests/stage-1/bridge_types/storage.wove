(module seed_bridge_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./storage.h" (only (type (as Storage Object)) prepare inspect (as fixture_drops drops)
			acquire update close (as fixture_closes closes)))
	(bridge c-header "./storage.h"
		(type Storage (:pragma (c_owned (drop fixture_destroy) storage)) (c-type "struct fixture_storage"))
		(let fixture_drops i32)
		(fn prepare (:pragma (c_init value))
			(params (value (mut-ref Storage)) (status i32)) (returns i32) (c-name "fixture_prepare"))
		(fn inspect (:pragma (c_nullable value))
			(params (value (shared-ref Storage))) (returns i32) (c-name "fixture_inspect"))
		(type Handle (:pragma (c_owned (drop fixture_close))) (c-type "fixture_handle"))
		(let fixture_closes i32)
		(fn acquire (params (marker i32)) (returns Handle) (c-name "fixture_acquire"))
		(fn update (params (handle (mut-ref Handle))) (returns i32) (c-name "fixture_update"))
		(fn close (params (handle Handle)) (returns i32) (c-name "fixture_close")))

	(fn failed (params) (returns i32)
		(body
			(let-mut value (native:alloc Object))
			(return (call prepare (borrow-mut value) 1i32))))

	(fn retried (params) (returns i32)
		(body
			(let-mut value (native:alloc Object))
			(if (i32:not-eq (call prepare (borrow-mut value) 1i32) 1i32) (then (return -2i32)))
			(if (i32:not-eqz (call prepare (borrow-mut value) 0i32)) (then (return -3i32)))
			(let moved (move value))
			(return (call inspect (borrow-shared moved)))))

	(fn handle_exit (params) (returns i32)
		(body
			(let-mut handle (call acquire 41i32))
			(if (owner:is-null handle) (then (return -1i32)))
			(return (call update (borrow-mut handle)))))

	(fn handle_transfer (params) (returns i32)
		(body
			(let handle (call acquire 42i32))
			(if (owner:is-null handle) (then (return -1i32)))
			(return (call close (move handle)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (call failed) 1i32) (then (return 1i32)))
			(if (i32:not-eqz drops) (then (return 2i32)))
			(if (i32:not-eq (call retried) 42i32) (then (return 3i32)))
			(if (i32:not-eq drops 1i32) (then (return 4i32)))
			(if (i32:not-eqz (call inspect null)) (then (return 5i32)))
			(let missing (call acquire 0i32))
			(if (bool:not (owner:is-null missing)) (then (return 6i32)))
			(if (i32:not-eq (call handle_exit) 42i32) (then (return 7i32)))
			(if (i32:not-eq (call handle_transfer) 42i32) (then (return 8i32)))
			(if (i32:not-eq closes 2i32) (then (return 9i32)))
			(return 42i32))))
