(module seed_native_use
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./local.h"
		(only (type (as Device DeviceId)) (type (as Stat Status)) (type (as Width StreamWidth))
			(as write_bytes write) append_byte flush (value (as seed_output output))))
	(use wove-file "./provider.wove" (only))

	(fn zero (params) (returns Status)
		(body (return (struct.new Status))))

	(fn key (params (device DeviceId)) (returns u64)
		(body (return (int.convert u64 device))))

	(fn stat_key (params (info Status)) (returns u64)
		(body (return (call key (struct.get info st_dev)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let empty (call zero))
			(if (u64.not-eqz (call stat_key empty)) (then (return 1i32)))
			(let info (struct.new Status (st_dev (int.convert DeviceId 42u64))))
			(let-mut bytes (array.alloc u8 3i32))
			(array.store bytes 0i32 11u8)
			(array.store bytes 2i32 24u8)
			(let written (call write output (int.convert StreamWidth (array.len bytes))
				(borrow-shared bytes) (int.convert StreamWidth 1i32)))
			(if (u64.not-eq (int.convert u64 written) 3u64) (then (return 2i32)))
			(if (i32.not-eq (call append_byte 7i32 output) 7i32) (then (return 3i32)))
			(if (i32.not-eqz (call flush output)) (then (return 4i32)))
			(return (i32.from-u64 (call stat_key info))))))
