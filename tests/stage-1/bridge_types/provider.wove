(module seed_native_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "./local.h"
		(type Device (c-type "seed_device_t"))
		(struct Stat (c-type "struct seed_stat") (fields (st_dev Device)))
		(const SEED_OK i32)
		(let-mut seed_error i32)
		(fn checked_device (:pragma (c_macro))
			(params (device Device)) (returns bool) (c-name "SEED_DEVICE_OK"))
		(fn read_stat
			(params (device i32) (info (mut-ref Stat))) (returns i32) (c-name "seed_stat"))
		(type Stream (:pragma (c_owned (drop seed_close))) (c-type "seed_stream_t"))
		(type Width (c-type "seed_count_t"))
		(let seed_output (shared-ref Stream))
		(fn write_bytes
			(:pragma (c_bytes bytes width count))
			(params (stream (shared-ref Stream)) (count Width) (bytes (shared-array u8)) (width Width))
			(returns Width) (c-name "seed_write"))
		(fn seed_close (params (stream Stream)) (returns i32))
		(fn append_byte
			(params (byte i32) (stream (shared-ref Stream)))
			(returns i32) (c-name "seed_append"))
		(fn flush
			(:pragma (c_nullable stream))
			(params (stream (shared-ref Stream)))
			(returns i32) (c-name "seed_flush"))))
