(module seed_bridge_vectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./vectors.h" (only (value (as fixture_environment environment)) call_vectors))
	(bridge c-header "./vectors.h"
		(let fixture_environment (:pragma (c_snapshot cstrs)) (owned-array (owned-array u8)))
		(fn call_vectors (:pragma (c_cstrs rows empty))
			(params (rows (shared-array (owned-array u8))) (empty (shared-array (owned-array u8))))
			(returns i32) (c-name "fixture_vectors")))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let before environment)
			(if (i32:not-eq (array:len before) 2i32) (then (return 1i32)))
			(let empty (array:alloc (owned-array u8) 0i32))
			(if (i32:not-eqz (call call_vectors (borrow-shared before) (borrow-shared empty)))
				(then (return 2i32)))
			(let old (borrow-shared (array:get before 0i32)))
			(if (u8:not-eq (array:get old 0i32) 112u8) (then (return 3i32)))
			(let after environment)
			(let new (borrow-shared (array:get after 0i32)))
			(if (u8:not-eq (array:get new 0i32) 98u8) (then (return 4i32)))
			(return 42i32))))
