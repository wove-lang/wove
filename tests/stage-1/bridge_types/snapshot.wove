(module seed_bridge_snapshot
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "./snapshot.h" (only (as snapshot copy) suffix change))
	(bridge c-header "./snapshot.h"
		(fn snapshot
			(:pragma (c_cstr input output) (c_null output) (c_snapshot cstr (drop fixture_release)))
			(params (input (shared-array u8)) (output (mut-array u8)))
			(returns (optional (owned-array u8))) (c-name "fixture_snapshot"))
		(fn suffix
			(:pragma (c_cstr input) (c_snapshot cstr))
			(params (input (shared-array u8)))
			(returns (optional (owned-array u8))) (c-name "fixture_suffix"))
		(fn change
			(:pragma (c_cstr input))
			(params (input (mut-array u8)))
			(returns i32) (c-name "fixture_change")))

	(let existing "Alpha")
	(let missing "missing")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call copy (borrow-shared existing) null))
			(if (owner.is-null result) (then (return 1i32)))
			(let bytes (move (optional.unwrap result)))
			(if (i32.not-eq (array.len bytes) 5i32) (then (return 2i32)))
			(if (u8.not-eq (array.load bytes 0i32) 65u8) (then (return 3i32)))
			(let absent (call copy (borrow-shared missing) null))
			(if (bool.not (owner.is-null absent)) (then (return 4i32)))
			(let aliased (call suffix (borrow-shared existing)))
			(if (owner.is-null aliased) (then (return 5i32)))
			(let independent (move (optional.unwrap aliased)))
			(if (i32.not-eq (array.len independent) 4i32) (then (return 6i32)))
			(if (u8.not-eq (array.load independent 0i32) 108u8) (then (return 7i32)))
			(let-mut mutable (array.alloc u8 1i32))
			(array.store mutable 0i32 65u8)
			(if (i32.not-eqz (call change (borrow-mut mutable))) (then (return 8i32)))
			(if (u8.not-eq (array.load mutable 0i32) 122u8) (then (return 9i32)))
			(return 42i32))))
