(module slice_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./imports/left.wove" (only read_first))
	(struct Item (fields (left i32)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let items (array.alloc Item (i32 1)))
			(return (call read_first
					(borrow-shared (local items)))))))
