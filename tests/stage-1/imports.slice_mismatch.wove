(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	slice_mismatch
	(use wove-file "./imports/left.wove" (only read_first))
	(struct Item (fields (left i32)))
	(fn main
		(params)
		(returns i32)
		(body
			(let items (array.alloc Item (i32 1)))
			(return (call read_first
					(borrow-shared (local items)))))))
