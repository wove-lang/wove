	branch_fallthrough_cleanup
	(fn
		(:doc "Allocate just the selected arm's owner and release it on block exit.")
		main
		(params)
		(returns i32)
		(body
			(if (bool true)
				(then (let buffer (array.alloc u8 (i32 3))))
				(else (let buffer (array.alloc u8 (i32 3)))))
			(let buffer (i32 11))
			(return (local buffer)))))
