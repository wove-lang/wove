(module branch_fallthrough_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "Allocate just the selected arm's owner and release it on block exit.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool true)
				(then (let buffer (array.alloc u8 (i32 3))))
				(else (let buffer (array.alloc u8 (i32 3)))))
			(let buffer (i32 11))
			(return (local buffer)))))
