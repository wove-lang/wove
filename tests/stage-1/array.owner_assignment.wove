(module array_owner_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array:alloc u8 20i32))
			(set bytes (array:alloc u8 (i32:inc (array:len bytes))))
			(let first (move bytes))
			(if (i32:eq (array:len first) 21i32)
				(then (set bytes (array:alloc u8 21i32)))
				(else (return 1i32)))
			(set bytes (move bytes))
			(return (i32:add (array:len first) (array:len bytes)))))
)
