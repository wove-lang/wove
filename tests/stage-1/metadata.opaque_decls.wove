(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:pragma
		(foreign-schema
			(decls (fn))
			(bridge c-header "<unused.h>" (decls (fn)))
			(module schema (decls (fn)))))
	opaque_declarations
	(decls
		(decls
			(fn value
				(:doc "A genuine nested declaration has a name slot.")
				(params)
				(returns i32)
				(body (return (i32 42))))))
	(fn main
		(:extension (decls (fn)))
		(params)
		(returns i32)
		(body (return (call value)))))
