(module loop_assign_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "Keep the initial value in two independent copies while changing the original.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(let saved cursor)
			(let-mut other cursor)
			(let-mut again (bool true))
			(while again
				(body
					(set cursor (i32 42))
					(set again (bool false))))
			(return (i32:sub cursor
					(i32:add saved other))))))
