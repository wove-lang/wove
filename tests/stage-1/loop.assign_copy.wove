(module loop_assign_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "Keep the initial value in two independent copies while changing the original.")
		(params)
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(let saved (local cursor))
			(let-mut other (local cursor))
			(let-mut again (bool true))
			(while (local again)
				(body
					(set (local cursor) (i32 42))
					(set (local again) (bool false))))
			(return (i32.sub.wrapping (local cursor)
					(i32.add.wrapping (local saved) (local other)))))))
