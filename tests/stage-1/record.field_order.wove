(module record_field_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Pair (fields (first u8) (second u8)))

	(fn next
		(params (state (mut-slice u8)))
		(returns u8)
		(body
			(let before (slice.load (local state) (i32 0)))
			(let after (i32.add.wrapping (int.convert i32 (local before)) (i32 1)))
			(slice.store (local state) (i32 0) (int.convert u8 (local after)))
			(return (local before))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let result (struct.new Pair
					(second (call next (borrow-mut (local state))))
					(first (call next (borrow-mut (local state))))))
			(if (bool.and
					(u8.eq (struct.get (local result) second) (u8 0))
					(u8.eq (struct.get (local result) first) (u8 1)))
				(then (return (i32 0))))
			(return (i32 1)))))
