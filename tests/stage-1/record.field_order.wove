(module record_field_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Pair (fields (first u8) (second u8)))

	(fn next
		(params (state (mut-array u8)))
		(returns u8)
		(body
			(let before (array.load state (i32 0)))
			(let after (i32.add (int.convert i32 before) (i32 1)))
			(array.store state (i32 0) (int.convert u8 after))
			(return before)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let result (struct.new Pair
					(second (call next (borrow-mut state)))
					(first (call next (borrow-mut state)))))
			(if (bool.and
					(u8.eq (struct.get result second) (u8 0))
					(u8.eq (struct.get result first) (u8 1)))
				(then (return (i32 0))))
			(return (i32 1)))))
