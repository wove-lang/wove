(module record_field_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Pair (fields (first u8) (second u8)))

	(fn next
		(params (state (mut-array u8)))
		(returns u8)
		(body
			(let before (array.load (local state) (i32 0)))
			(let after (i32.add (int.convert i32 (local before)) (i32 1)))
			(array.store (local state) (i32 0) (int.convert u8 (local after)))
			(return (local before))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let result (struct.new Pair
					(second (call next (borrow-mut (local state))))
					(first (call next (borrow-mut (local state))))))
			(if (bool.and
					(u8.eq (struct.get (local result) second) (u8 0))
					(u8.eq (struct.get (local result) first) (u8 1)))
				(then (return (i32 0))))
			(return (i32 1)))))
