(module load_negative
	;; Use a runtime argument as the index of a shared slice read.
	(fn read_byte
		(params (data (shared-slice u8)) (index i32))
		(returns u8)
		(body
			(return (slice.load (local data) (local index)))))

	;; Pass an out-of-bounds index for a three-byte buffer.
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (i32.from-u8
				(call read_byte (borrow-shared (local buffer)) (i32 -1)))))))
