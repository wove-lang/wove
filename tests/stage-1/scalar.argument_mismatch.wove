(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	argument_mismatch
	(fn
		(:doc "Receive and return exactly a u32 value.")
		echo_u32
		(params (value u32))
		(returns u32)
		(body
			(return (local value))))

	(fn
		(:doc "An i32 argument has a different type even when its value fits.")
		main
		(params)
		(returns i32)
		(body
			(let value (call echo_u32 (i32 1)))
			(return (i32 0)))))
