(module argument_mismatch
	;; Receive and return exactly a u32 value.
	(fn echo_u32
		(params (value u32))
		(returns u32)
		(body
			(return (local value))))

	;; An i32 argument has a different type even when its value fits.
	(fn main
		(params)
		(returns i32)
		(body
			(let value (call echo_u32 (i32 1)))
			(return (i32 0)))))
