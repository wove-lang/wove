(module argument_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn echo_u32
		(:doc "Receive and return exactly a u32 value.")
		(params (value u32))
		(returns u32)
		(body
			(return (local value))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "An i32 argument has a different type even when its value fits.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let value (call echo_u32 (i32 1)))
			(return (i32 0)))))
