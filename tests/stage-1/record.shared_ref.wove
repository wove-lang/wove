(module record_shared_ref
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Job (fields (arguments (owned-array u8)) (count i32)))

	(fn make_job (params (first u8)) (returns Job)
		(body
			(let-mut bytes (array:alloc u8 1i32))
			(array:set bytes 0i32 first)
			(return (struct:new Job (arguments (move bytes)) (count 1i32)))))

	(fn first_byte (params (bytes (shared-array u8))) (returns i32)
		(body (return (i32:from-u8 (array:get bytes 0i32)))))

	(fn inspect (params (job (shared-ref Job))) (returns i32)
		(body
			(return (i32:add (struct:get job count)
				(call first_byte (borrow-shared (struct:get job arguments)))))))

	(fn read_first (params (jobs (shared-array Job))) (returns i32)
		(body (return (call inspect (borrow-shared (array:get jobs 0i32))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let local_job (call make_job 8u8))
			(if (i32:not-eq (call inspect (borrow-shared local_job)) 9i32) (then (return 1i32)))
			(let-mut jobs (array:alloc Job 2i32))
			(array:set jobs 0i32 (call make_job 10u8))
			(array:set jobs 0i32 (call make_job 41u8))
			(return (call read_first (borrow-shared jobs))))))
