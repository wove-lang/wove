(module value_if
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Result (fields (value i32)))
	(struct Payload (fields (bytes (owned-array u8))))

	(fn width (params (payload Payload)) (returns i32)
		(body (return (array:len (struct:get payload bytes)))))

	(fn choose (params (first bool)) (returns Result)
		(body
			(return (if first
				(then (struct:new Result (value 42i32)))
				(else (struct:new Result (value (i32:div 1i32 0i32))))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (if (bool false)
				(then (call choose (bool false)))
				(else (call choose (bool true)))))
			(let payload (struct:new Payload (bytes (array:alloc u8 42i32))))
			(let size (if (bool true)
				(then (call width (move payload)))
				(else (call width (move payload)))))
			(if (i32:not-eq size (struct:get result value)) (then (return 1i32)))
			(return size))))
