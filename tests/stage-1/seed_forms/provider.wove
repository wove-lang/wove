(module seed_embed_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let data (embed "./assets/payload.txt"))

	(fn size (params) (returns i32)
		(body
			(let content (embed "./assets/payload.txt"))
			(return (array:len content))))
)
