(module seed_array_initializers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let max_word 0xffffffffffffffffu64)
	(let weights (array:new (array u32 3) 3u32 7u32 9u32))
	(let signs (array:repeat (array i32 2) -1i32))
	(struct Word (fields (bits u64)))

	(fn bit (params (word Word)) (returns u64)
		(body (return (u64:rotr (struct:get word bits) 63i32))))

	(fn update (params (values (mut-array u64))) (returns void)
		(body (array:set values 1i32 (u64:inc (array:get values 0i32)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let word (struct:new Word (bits (u64:shl 1u64 63i32))))
			(let-mut values (array:repeat (array u64 2) (call bit word)))
			(call update (borrow-mut values))
			(let total (array:new (array u64 2) (array:get values 1i32) (u64:from-i32 30i32)))
			(let empty (array:new (array u64 0)))
			(if (bool:not (u64:eqz (u64:add max_word 1u64))) (then (return 1i32)))
			(if (u64:not-eq (u64:not max_word) 0u64) (then (return 2i32)))
			(if (i32:not-eq (array:len empty) 0i32) (then (return 3i32)))
			(return
				(i32:add (i32:from-u64 (u64:add (array:get total 0i32) (array:get total 1i32)))
					(i32:sub (int:convert i32 (array:get weights 2i32)) (array:get signs 0i32))))))
)
