(module seed_target_cfg
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(decls (:pragma (cfg (all (os "linux") (any (arch "x86_64") (arch "aarch64")))))
		(let selected 42i32))

	(decls (:pragma (cfg (all (os "macos") (not (os_min 270000)))))
		(let selected 42i32))

	(decls (:pragma (cfg (all (os "macos") (os_min 270000))))
		(let selected 43i32))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let offset (call deployment_offset))
			(return (i32.sub selected offset))))

	(fn deployment_offset (:pragma (cfg (all (os "macos") (not (os_max 269999)))))
		(params) (returns i32) (body (return 1i32)))

	(fn deployment_offset (:pragma (cfg (not (all (os "macos") (os_min 270000)))))
		(params) (returns i32) (body (return 0i32)))
)
