(module seed_embeds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./provider.wove" (only data size))
	(use (:pragma (cfg (any))) wove-file "./inactive.wove" (only))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(if (i32:not-eq (array:len data) (call size)) (then (return 1i32)))
			(return (i32:add (i32:from-u8 (array:get data 0i32)) 2i32))))
)
