(module branch_move_at_join
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn length
		(:doc "Read the length without taking ownership of the buffer.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array:len data))))

	(fn inspect
		(:doc "Both arms reach the use, so the possible move makes the original unavailable.")
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array:alloc u8 (i32 3)))
			(if take
				(then (let received (move buffer))))
			(return (call length (borrow-shared buffer)))))

	(fn main
		(:doc "Call the function containing the invalid use.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(return (call inspect (bool true))))))
