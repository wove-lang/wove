(module branch_move_at_join
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn length
		(:doc "Read the length without taking ownership of the buffer.")
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))

	(fn inspect
		(:doc "Both arms reach the use, so the possible move makes the original unavailable.")
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(if (local take)
				(then (let received (move (local buffer)))))
			(return (call length (borrow-shared (local buffer))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Call the function containing the invalid use.")
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(return (call inspect (bool true))))))
