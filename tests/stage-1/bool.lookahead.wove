(module boolean_lookahead
	(with-meta
		(meta
			(:expect bootstrap.short_circuit_lookahead
				(issue "https://github.com/wove-lang/wove/issues/25")))
		(fn next_is_open
			(params (source (shared-slice u8)) (index i32))
			(returns bool)
			(body
				(return (bool.and
					(i32.lt (local index) (slice.len (local source)))
					(u8.eq (slice.load (local source) (local index)) (u8 40)))))))

	(fn at_end_or_open
		(params (source (shared-slice u8)) (index i32))
		(returns bool)
		(body
			(return (bool.or
				(i32.eq (local index) (slice.len (local source)))
				(u8.eq (slice.load (local source) (local index)) (u8 40))))))

	(fn write_open
		(params (source (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local source) (i32 0) (u8 40))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut source (array.alloc u8 (i32 2)))
			(call write_open (borrow-mut (local source)))
			(if (bool.not (call next_is_open (borrow-shared (local source)) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (call at_end_or_open (borrow-shared (local source)) (i32 2)))
				(then (return (i32 2))))
			(if (bool.or
					(call next_is_open (borrow-shared (local source)) (i32 1))
					(call at_end_or_open (borrow-shared (local source)) (i32 1)))
				(then (return (i32 3))))
			(if (bool.not (call next_is_open (borrow-shared (local source)) (i32 2)))
				(then (return (i32 0))))
			(return (i32 4)))))
