(module boolean_lookahead
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn next_is_open
		(:expect bootstrap.short_circuit_lookahead
			(issue "https://github.com/wove-lang/wove/issues/25"))
		(params (source (shared-array u8)) (index i32))
		(returns bool)
		(body
			(return (bool.and
					(i32.lt (local index) (array.len (local source)))
					(u8.eq (array.load (local source) (local index)) (u8 40))))))

	(fn at_end_or_open
		(params (source (shared-array u8)) (index i32))
		(returns bool)
		(body
			(return (bool.or
					(i32.eq (local index) (array.len (local source)))
					(u8.eq (array.load (local source) (local index)) (u8 40))))))

	(fn write_open
		(params (source (mut-array u8)))
		(returns void)
		(body
			(array.store (local source) (i32 0) (u8 40))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut source (array.alloc u8 (i32 2)))
			(call write_open (borrow-mut (local source)))
			(if (bool.not (call next_is_open (borrow-shared (local source)) (i32 0)))
				(then (return (i32 1))))
			(if (bool.not (call at_end_or_open (borrow-shared (local source)) (i32 2)))
				(then (return (i32 2))))
			(if (bool.or
					(call next_is_open (borrow-shared (local source)) (i32 1))
					(call at_end_or_open (borrow-shared (local source)) (i32 1)))
				(then (return (i32 3))))
			(if (bool.not (call next_is_open (borrow-shared (local source)) (i32 2)))
				(then (return (i32 0))))
			(return (i32 4)))))
