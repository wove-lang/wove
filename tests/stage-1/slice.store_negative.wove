(module store_negative
	;; Use a runtime argument as the index of a mutable slice write.
	(fn write_byte
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns void)
		(body
			(slice.store (local data) (local index) (local value))))

	;; Pass an out-of-bounds index for a three-byte buffer.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call write_byte (borrow-mut (local buffer)) (i32 -1) (u8 42))
			(return (i32 0)))))
