(module module_selection
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Use an active module while loading excluded providers with empty selections.")
	(:pragma (cfg bootstrap))
	(use wove-file "./modules/bootstrap.wove" (only exposed))
	(use wove-file "./modules/full.wove" (only))
	(use wove-file "./modules/testing.wove" (only))
	(fn main
		(:expect bootstrap.module_selection
			(issue "https://github.com/wove-lang/wove/issues/51"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return (call exposed)))))
