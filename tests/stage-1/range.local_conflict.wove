(module local_range_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array:alloc u8 1i32))
			(let view (borrow-shared (array:range bytes 0i32 1i32)))
			(array:store bytes 0i32 42u8)
			(return (array:len view)))))
