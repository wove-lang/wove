(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	loop_assignment_type
	(fn
		(:doc "The assigned value must have the exact type of the destination.")
		main
		(params)
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(while (bool true)
				(body
					(set (local cursor)
						(u32 1))))
			(return (local cursor)))))
