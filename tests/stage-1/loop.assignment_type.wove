(module loop_assignment_type
	;; The assigned value must have the exact type of the destination.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(while (bool true)
				(body
					(set (local cursor)
						(u32 1))))
			(return (local cursor)))))
