(module loop_assignment_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "The assigned value must have the exact type of the destination.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(while (bool true)
				(body
					(set cursor
						(u32 1))))
			(return cursor))))
