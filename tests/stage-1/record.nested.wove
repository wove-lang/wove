(module nested_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./imports/left.wove" (only (type (as Item Identity)) make read_item))

	(struct State (fields (destination Destination) (ready bool)))
	(struct Destination (fields (primary Identity) (backup Identity)))

	(fn prepare (params (source Identity)) (returns State)
		(body
			(return (struct.new State
				(ready (bool true))
				(destination (struct.new Destination (backup (call make 1i32)) (primary source)))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let state (call prepare (call make 42i32)))
			(if (bool.not (struct.get state ready)) (then (return 1i32)))
			(return (call read_item (struct.get (struct.get state destination) primary))))))
