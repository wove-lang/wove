(module cfg_selection
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:expect bootstrap.select_declarations
			(issue "https://github.com/wove-lang/wove/issues/14"))
		(params)
		(returns i32)
		(body (return (call build_mode))))

	(decls
		(:pragma (cfg bootstrap) (cfg bootstrap) (cfg (not test)))
		(fn build_mode
			(:doc "Return the marker for the bootstrap build.")
			(:expect bootstrap.metadata_target
				(issue "https://github.com/wove-lang/wove/issues/41"))
			(:editor.hint (cfg (not bootstrap)) (test))
			(:pragma (inline always) (future-pass (cfg (not bootstrap))))
			(params)
			(returns i32)
			(body (return (call bootstrap_mode))))
		(decls
			(fn bootstrap_mode
				(params)
				(returns i32)
				(body (return (i32 1))))))

	(decls
		(:pragma (cfg (not bootstrap)))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (call full_mode))))
		(decls
			(fn full_mode
				(params)
				(returns i32)
				(body (return (i32 2))))))

	(fn build_mode
		(:pragma (cfg bootstrap) (cfg (not bootstrap)))
		(params)
		(returns i32)
		(body (return (i32 3))))

	(fn build_mode
		(:pragma (test))
		(params)
		(returns i32)
		(body (return (test-only.operation))))

	(decls
		(:pragma (cfg bootstrap)) (:pragma (test))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (test-group.operation)))))

	(decls
		(:pragma (cfg test))
		(use wove-file "./missing_test_provider.wove" (only))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (test-group.operation))))))
