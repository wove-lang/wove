(module cfg_selection
	(fn main
		(params)
		(returns i32)
		(expect bootstrap.select_declarations
			(issue "https://github.com/wove-lang/wove/issues/14"))
		(body (return (call build_mode))))

	(with-pragmas
		(pragmas (cfg bootstrap) (cfg bootstrap))
		(decls
			(with-pragmas
				(pragmas (inline always) (test))
				(fn build_mode
					(params)
					(returns i32)
					(body (return (call bootstrap_mode)))))
			(decls
				(fn bootstrap_mode
					(params)
					(returns i32)
					(body (return (i32 1)))))))

	(with-pragmas
		(pragmas (cfg (not bootstrap)))
		(decls
			(fn build_mode
				(params)
				(returns i32)
				(body (return (call full_mode))))
			(decls
				(fn full_mode
					(params)
					(returns i32)
					(body (return (i32 2)))))))

	(with-pragmas
		(pragmas (cfg bootstrap) (cfg (not bootstrap)))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (i32 3))))))
