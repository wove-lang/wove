(module cfg_selection
	(with-meta
		(meta
			(:expect bootstrap.select_declarations
				(issue "https://github.com/wove-lang/wove/issues/14")))
		(fn main
			(params)
			(returns i32)
			(body (return (call build_mode)))))

	(with-meta
		(meta (:pragma (cfg bootstrap) (cfg bootstrap)))
		(decls
			(with-meta
				(meta
					(:doc "Return the marker for the bootstrap build.")
					(:expect bootstrap.metadata_target
						(issue "https://github.com/wove-lang/wove/issues/41"))
					(:editor.hint (cfg (not bootstrap)) (test))
					(:pragma (inline always) (future-pass (cfg (not bootstrap)))))
				(fn build_mode
					(params)
					(returns i32)
					(body (return (call bootstrap_mode)))))
			(decls
				(fn bootstrap_mode
					(params)
					(returns i32)
					(body (return (i32 1)))))))

	(with-meta
		(meta (:pragma (cfg (not bootstrap))))
		(decls
			(fn build_mode
				(params)
				(returns i32)
				(body (return (call full_mode))))
			(decls
				(fn full_mode
					(params)
					(returns i32)
					(body (return (i32 2)))))))

	(with-meta
		(meta (:pragma (cfg bootstrap) (cfg (not bootstrap))))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (i32 3)))))

	(with-meta
		(meta (:pragma (test)))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (test-only.operation)))))

	(with-meta
		(meta (:pragma (cfg bootstrap)) (:pragma (test)))
		(decls
			(fn build_mode
				(params)
				(returns i32)
				(body (return (test-group.operation)))))))
