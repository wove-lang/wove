(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	cfg_selection
	(fn
		(:expect bootstrap.select_declarations
			(issue "https://github.com/wove-lang/wove/issues/14"))
		main
		(params)
		(returns i32)
		(body (return (call build_mode))))

	(decls
		(:pragma (cfg bootstrap) (cfg bootstrap))
		(fn
			(:doc "Return the marker for the bootstrap build.")
			(:expect bootstrap.metadata_target
				(issue "https://github.com/wove-lang/wove/issues/41"))
			(:editor.hint (cfg (not bootstrap)) (test))
			(:pragma (inline always) (future-pass (cfg (not bootstrap))))
			build_mode
			(params)
			(returns i32)
			(body (return (call bootstrap_mode))))
		(decls
			(fn bootstrap_mode
				(params)
				(returns i32)
				(body (return (i32 1))))))

	(decls
		(:pragma (cfg (not bootstrap)))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (call full_mode))))
		(decls
			(fn full_mode
				(params)
				(returns i32)
				(body (return (i32 2))))))

	(fn
		(:pragma (cfg bootstrap) (cfg (not bootstrap)))
		build_mode
		(params)
		(returns i32)
		(body (return (i32 3))))

	(fn
		(:pragma (test))
		build_mode
		(params)
		(returns i32)
		(body (return (test-only.operation))))

	(decls
		(:pragma (cfg bootstrap)) (:pragma (test))
		(fn build_mode
			(params)
			(returns i32)
			(body (return (test-group.operation))))))
