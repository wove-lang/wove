(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	type_provider
	(struct Item (fields (value i32)))
	(fn Item
		(params (value i32))
		(returns Item)
		(body (return (record.make Item (value (local value))))))
	(fn read_item
		(params (item Item))
		(returns i32)
		(body (return (record.get (local item) value)))))
