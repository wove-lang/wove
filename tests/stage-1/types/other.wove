(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	other_type_provider
	(struct Item (fields (value i32)))
	(fn read_item
		(params (item Item))
		(returns i32)
		(body (return (record.get (local item) value))))
	(fn first
		(params (items (shared-slice Item)))
		(returns i32)
		(body (return (call read_item (slice.load (local items) (i32 0)))))))
