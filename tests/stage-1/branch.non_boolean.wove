(module branch_non_boolean
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "The condition must supply a boolean value.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(if (i32 1)
				(then (return (i32 13))))
			(return (i32 0)))))
