(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	host_declarations
	(use
		(:pragma (cfg (target linux)))
		c-header "./imports/absent.h" (only (as foreign get_base)))
	(use rust-crate "./imports/absent-crate" (only (type Foreign)))
	(decls
		(:pragma (cfg bootstrap))
		(use custom-provider (opaque (source missing)) (unsupported selector))
		(use custom-provider)
		(bridge
			(:pragma (cfg (target macos)))
			host_bridge
			(use wove-file "./imports/absent_bridge.wove" (only))
			(fn main (foreign-signature i32))
			(extern (provider-specific detail))))
	(use
		(:pragma (cfg (not bootstrap)))
		wove-file "./imports/absent_inactive.wove" (only))
	(use
		(:pragma (cfg bootstrap))
		wove-file "./imports/nested/shared.wove" (only (as base get_base)))
	(fn
		(:expect bootstrap.skip_host_declarations (issue "https://github.com/wove-lang/wove/issues/81"))
		main
		(params)
		(returns i32)
		(body (return (i32.add.wrapping (call get_base) (i32 32))))))
