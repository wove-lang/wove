(module local_shared_ranges
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Entry (fields (value i32) (marker u32)))

	(fn first (params (data (shared-array u8))) (returns i32)
		(body (return (i32:from-u8 (array:load data 0i32)))))

	(fn first_entry (params (entries (shared-array Entry))) (returns i32)
		(body (return (struct:get (array:load entries 0i32) value))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array:alloc u8 3i32))
			(array:store bytes 1i32 40u8)
			(let-mut observed 0i32)
			(if (bool true)
				(then
					(let middle (borrow-shared (array:range bytes 1i32 (array:len bytes))))
					(let first_in_middle (borrow-shared (array:range middle 0i32 1i32)))
					(set observed (call first (borrow-shared first_in_middle)))
					(let empty (borrow-shared (array:range middle 2i32 2i32)))
					(if (i32:not-eq (array:len empty) 0i32) (then (return 1i32)))))
			(array:store bytes 1i32 0u8)
			(let-mut entries (array:alloc Entry 2i32))
			(array:store entries 1i32 (struct:new Entry (value 2i32) (marker 9u32)))
			(let tail (borrow-shared (array:range entries 1i32 2i32)))
			(return (i32:add observed (call first_entry (borrow-shared tail)))))))
