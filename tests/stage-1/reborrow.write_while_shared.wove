(module reborrow_write_while_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Require an exclusive view for a nested call.")
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(array.store (local data) (i32 0) (u8 42))
			(return (i32 0))))

	(fn read_plus
		(:doc "Read from a shared view after evaluating the scalar argument.")
		(params (data (shared-array u8)) (value i32))
		(returns i32)
		(body
			(return (i32.add (array.len (local data)) (local value)))))

	(fn forward
		(:doc "The outer call's first loan remains active in the nested call.")
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(return (call read_plus
					(borrow-shared (local data))
					(call put (borrow-mut (local data)))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Supply an exclusive parent view.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(return (call forward (borrow-mut (local buffer)))))))
