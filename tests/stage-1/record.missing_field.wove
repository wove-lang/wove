(module record_missing_field
	(struct Token (fields (kind u32) (start i32) (end i32)))

	(fn main
		(params)
		(returns i32)
		(body
			(let token
				(record.make Token
					(kind (u32 40))
					(start (i32 2))))
			(return (record.get (local token) start)))))
