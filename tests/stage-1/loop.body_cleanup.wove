(module loop_body_cleanup
	;; Leave an iteration normally and release its local array.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut again (bool true))
			(while (local again)
				(body
					(let buffer (array.alloc u8 (i32 3)))
					(set (local again) (bool false))))
			(return (i32 11)))))
