(module loop_body_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "Leave an iteration normally and release its local array.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut again (bool true))
			(while (local again)
				(body
					(let buffer (array.alloc u8 (i32 3)))
					(set (local again) (bool false))))
			(return (i32 11)))))
