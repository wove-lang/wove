(module scalar_convert
	;; Convert a u8 parameter to the i32 result type.
	(fn u8_to_i32
		(params (value u8))
		(returns i32)
		(body
			(return (int.convert i32 (local value)))))

	;; Convert a u8 parameter to the u32 result type.
	(fn u8_to_u32
		(params (value u8))
		(returns u32)
		(body
			(return (int.convert u32 (local value)))))

	;; Convert a i32 parameter to the u8 result type.
	(fn i32_to_u8
		(params (value i32))
		(returns u8)
		(body
			(return (int.convert u8 (local value)))))

	;; Convert a u32 parameter to the u8 result type.
	(fn u32_to_u8
		(params (value u32))
		(returns u8)
		(body
			(return (int.convert u8 (local value)))))

	;; Convert a u32 parameter to the i32 result type.
	(fn u32_to_i32
		(params (value u32))
		(returns i32)
		(body
			(return (int.convert i32 (local value)))))

	;; Convert a i32 parameter to the u32 result type.
	(fn i32_to_u32
		(params (value i32))
		(returns u32)
		(body
			(return (int.convert u32 (local value)))))

	;; Widen a typed maximum byte literal through a call.
	(fn main
		(params)
		(returns i32)
		(body
			(return (call u8_to_i32 (u8 255))))))
