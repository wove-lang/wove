(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	scalar_convert
	(fn
		(:doc "Convert a u8 parameter to the i32 result type.")
		u8_to_i32
		(params (value u8))
		(returns i32)
		(body
			(return (int.convert i32 (local value)))))

	(fn
		(:doc "Convert a u8 parameter to the u32 result type.")
		u8_to_u32
		(params (value u8))
		(returns u32)
		(body
			(return (int.convert u32 (local value)))))

	(fn
		(:doc "Convert a i32 parameter to the u8 result type.")
		i32_to_u8
		(params (value i32))
		(returns u8)
		(body
			(return (int.convert u8 (local value)))))

	(fn
		(:doc "Convert a u32 parameter to the u8 result type.")
		u32_to_u8
		(params (value u32))
		(returns u8)
		(body
			(return (int.convert u8 (local value)))))

	(fn
		(:doc "Convert a u32 parameter to the i32 result type.")
		u32_to_i32
		(params (value u32))
		(returns i32)
		(body
			(return (int.convert i32 (local value)))))

	(fn
		(:doc "Convert a i32 parameter to the u32 result type.")
		i32_to_u32
		(params (value i32))
		(returns u32)
		(body
			(return (int.convert u32 (local value)))))

	(fn
		(:doc "Widen a typed maximum byte literal through a call.")
		main
		(params)
		(returns i32)
		(body
			(return (call u8_to_i32 (u8 255))))))
