(module optional_byte_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn explicit_absence (params) (returns (optional (owned-array u8)))
		(body
			(let absent (optional:none (owned-array u8)))
			(return (move absent))))

	(fn try_pack (params (length i32)) (returns (optional (owned-array u8)))
		(body
			(let allocated (array:try-alloc u8 length))
			(if (owner:is-null allocated) (then (return (move allocated))))
			(let-mut bytes (move (optional:unwrap allocated)))
			(array:set bytes 0i32 42u8)
			(return (optional:some (move bytes)))))

	(fn forward (params (length i32)) (returns (optional (owned-array u8)))
		(body (return (call try_pack length))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let missing (call explicit_absence))
			(if (bool:not (owner:is-null missing)) (then (return 1i32)))
			(let failed (call forward -1i32))
			(if (bool:not (owner:is-null failed)) (then (return 2i32)))
			(let packed (call forward 3i32))
			(if (owner:is-null packed) (then (return 3i32)))
			(let bytes (move (optional:unwrap packed)))
			(return (i32:from-u8 (array:get bytes 0i32))))))
