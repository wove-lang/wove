(module branch_local_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "A binding declared inside the arm goes out of scope before the join.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool true)
				(then (let only_inside (i32 1))))
			(return only_inside))))
