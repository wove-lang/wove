(module distinct_imported_slice
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./types/base.wove" (only (type Item)))
	(use wove-file "./types/other.wove" (only first))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let items (array.alloc Item (i32 1)))
			(return (call first
				(borrow-shared (local items)))))))
