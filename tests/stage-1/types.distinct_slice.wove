(module distinct_imported_slice
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./types/base.wove" (only (type Item)))
	(use wove-file "./types/other.wove" (only first))
	(fn main
		(params)
		(returns i32)
		(body
			(let items (array.alloc Item (i32 1)))
			(return (call first
				(borrow-shared (local items)))))))
