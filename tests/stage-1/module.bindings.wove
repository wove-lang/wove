(module bindings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./modules/bindings.wove" (only provider_value))

	(let alphabet (:doc "Treat the decoded bytes as a shared slice.") "0123456789abcdef")
	(decls
		(let signed_byte_min (i8 -128))
		(let signed_byte_max (i8 127)))
	(let byte_min (u8 0))
	(let byte_max (u8 255))
	(let signed_min (i32 -2147483648))
	(let signed_max (i32 2147483647))
	(let unsigned_min (u32 0))
	(let unsigned_max (u32 4294967295))
	(let decoded "é\u0000\n")
	(let empty "")
	(let raw `a``b`)
	(decls
		(:pragma (test))
		(let alphabet (i8 128)))

	(fn digit
		(params (index i32))
		(returns u8)
		(body (return (slice.load (local alphabet) (local index)))))
	(fn byte_at
		(params (bytes (shared-slice u8)) (index i32))
		(returns u8)
		(body (return (slice.load (local bytes) (local index)))))
	(fn length
		(params (bytes (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local bytes)))))

	(fn signed_byte
		(params (signed_byte_min i8))
		(returns i8)
		(body (return (local signed_byte_min))))
	(fn unsigned_byte
		(params (value u8))
		(returns u8)
		(body (return (local value))))
	(fn signed_integer
		(params (value i32))
		(returns i32)
		(body (return (local value))))
	(fn unsigned_integer
		(params (value u32))
		(returns u32)
		(body (return (local value))))

	(fn shadow
		(params)
		(returns i32)
		(body
			(let alphabet (i32 42))
			(return (local alphabet))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(if (bool.not (i32.eq (int.convert i32 (call signed_byte (local signed_byte_min))) (i32 -128)))
				(then (return (i32 1))))
			(if (bool.not (i32.eq (int.convert i32 (call signed_byte (local signed_byte_max))) (i32 127)))
				(then (return (i32 2))))
			(if (bool.not (u8.eq (call unsigned_byte (local byte_min)) (u8 0)))
				(then (return (i32 3))))
			(if (bool.not (u8.eq (call unsigned_byte (local byte_max)) (u8 255)))
				(then (return (i32 4))))
			(if (bool.not (i32.eq (call signed_integer (local signed_min)) (i32 -2147483648)))
				(then (return (i32 5))))
			(if (bool.not (i32.eq (call signed_integer (local signed_max)) (i32 2147483647)))
				(then (return (i32 6))))
			(if (bool.not (u32.eq (call unsigned_integer (local unsigned_min)) (u32 0)))
				(then (return (i32 7))))
			(if (bool.not (u32.eq (call unsigned_integer (local unsigned_max)) (u32 4294967295)))
				(then (return (i32 8))))
			(if (bool.not (i32.eq (slice.len (local alphabet)) (i32 16)))
				(then (return (i32 9))))
			(if (bool.not (u8.eq (call digit (i32 0)) (u8 48)))
				(then (return (i32 10))))
			(if (bool.not (u8.eq (call byte_at (borrow-shared (local alphabet)) (i32 15)) (u8 102)))
				(then (return (i32 11))))
			(if (bool.not (i32.eq (slice.len (local decoded)) (i32 4)))
				(then (return (i32 12))))
			(if (bool.not (u8.eq (slice.load (local decoded) (i32 2)) (u8 0)))
				(then (return (i32 13))))
			(if (bool.not (i32.eq (call length (borrow-shared (slice.range (local empty) (i32 0) (i32 0)))) (i32 0)))
				(then (return (i32 14))))
			(if (bool.not (i32.eq (call shadow) (i32 42)))
				(then (return (i32 15))))
			(if (bool.not (i32.eq (call provider_value) (i32 130)))
				(then (return (i32 16))))
			(if (bool.not (i32.eq (int.convert i32 (call signed_byte (i8 -7))) (i32 -7)))
				(then (return (i32 17))))
			(if (bool.not (u8.eq (slice.load (local raw) (i32 1)) (u8 96)))
				(then (return (i32 21))))
			(return (i32 0)))))
