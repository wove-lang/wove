	(:fixture.v1 "metadata with an ordinary dotted tag")
	(let spelling "u32.not-eq")
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:and (u32:not-eq 41u32 42u32)
					(u8:eq (array:load spelling 3i32) 46u8))
				(then (return (i32:add 40i32 2i32))))
			(return 1i32))))
