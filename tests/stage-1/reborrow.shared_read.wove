(module reborrow_shared_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn seed
		(:doc "Seed the owner's storage with a nonzero byte.")
		(params (data (mut-array u8)))
		(returns void)
		(body
			(array:store data (i32 0) (u8 21))))

	(fn read_plus
		(:doc "Read the forwarded view and add the byte read during argument evaluation.")
		(params (data (shared-array u8)) (prior u8))
		(returns i32)
		(body
			(return (i32:add
					(int:convert i32 (array:load data (i32 0)))
					(int:convert i32 prior)))))

	(fn forward
		(:doc "A shared reborrow permits another read through the shared parent.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (call read_plus
					(borrow-shared data)
					(array:load data (i32 0))))))

	(fn main
		(:doc "Observe the original byte through both views.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array:alloc u8 (i32 1)))
			(call seed (borrow-mut buffer))
			(return (call forward (borrow-shared buffer))))))
