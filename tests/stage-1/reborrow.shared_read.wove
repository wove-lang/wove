(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	reborrow_shared_read
	(fn
		(:doc "Seed the owner's storage with a nonzero byte.")
		seed
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local data) (i32 0) (u8 21))))

	(fn
		(:doc "Read the forwarded view and add the byte read during argument evaluation.")
		read_plus
		(params (data (shared-slice u8)) (prior u8))
		(returns i32)
		(body
			(return (i32.add.wrapping
					(int.convert i32 (slice.load (local data) (i32 0)))
					(int.convert i32 (local prior))))))

	(fn
		(:doc "A shared reborrow permits another read through the shared parent.")
		forward
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (call read_plus
					(borrow-shared (local data))
					(slice.load (local data) (i32 0))))))

	(fn
		(:doc "Observe the original byte through both views.")
		main
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(call seed (borrow-mut (local buffer)))
			(return (call forward (borrow-shared (local buffer)))))))
