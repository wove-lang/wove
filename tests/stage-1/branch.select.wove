(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	branch_select
	(fn
		(:doc "Return a distinct value from each boolean arm.")
		select
		(params (take bool))
		(returns i32)
		(body
			(if (local take)
				(then (return (i32 40)))
				(else (return (i32 2))))))

	(fn
		(:doc "Subtract the false result from the true result to check both calls.")
		main
		(params)
		(returns i32)
		(body
			(return (i32.sub.wrapping
					(call select (bool true))
					(call select (bool false)))))))
