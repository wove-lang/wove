(module branch_select
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn select
		(:doc "Return a distinct value from each boolean arm.")
		(params (take bool))
		(returns i32)
		(body
			(if take
				(then (return (i32 40)))
				(else (return (i32 2))))))

	(fn main
		(:doc "Subtract the false result from the true result to check both calls.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(return (i32.sub
					(call select (bool true))
					(call select (bool false)))))))
