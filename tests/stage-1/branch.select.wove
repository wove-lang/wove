(module branch_select
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn select
		(:doc "Return a distinct value from each boolean arm.")
		(params (take bool))
		(returns i32)
		(body
			(if (local take)
				(then (return (i32 40)))
				(else (return (i32 2))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Subtract the false result from the true result to check both calls.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (i32.sub
					(call select (bool true))
					(call select (bool false)))))))
