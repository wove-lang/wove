(module branch_select
	;; Return a distinct value from each boolean arm.
	(fn select
		(params (take bool))
		(returns i32)
		(body
			(if (local take)
				(then (return (i32 40)))
				(else (return (i32 2))))))

	;; Subtract the false result from the true result to check both calls.
	(fn main
		(params)
		(returns i32)
		(body
			(return (i32.sub.wrapping
				(call select (bool true))
				(call select (bool false)))))))
