(module record_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct State (fields (value i32)))

	(fn make_state (params (value i32)) (returns State)
		(body (return (struct.new State (value value)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut state (call make_state 1i32))
			(let saved state)
			(if (bool true)
				(then (set state (call make_state 41i32))))
			(return (i32.add (struct.get state value) (struct.get saved value))))))
