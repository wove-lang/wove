(module store_past_end
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn write_byte
		(:doc "Use a runtime argument as the index of a mutable slice write.")
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns void)
		(body
			(slice.store (local data) (local index) (local value))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Pass an out-of-bounds index for a three-byte buffer.")
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call write_byte (borrow-mut (local buffer)) (i32 3) (u8 42))
			(return (i32 0)))))
