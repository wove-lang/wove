(module scalar_compare
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn echo_bool
		(:doc "Copy a boolean through a local and return it to the caller.")
		(params (incoming bool))
		(returns bool)
		(body
			(let value (local incoming))
			(return (local value))))

	(fn literal_true
		(:doc "Pass the true literal through a boolean parameter.")
		(params)
		(returns bool)
		(body
			(let value (bool true))
			(return (call echo_bool (local value)))))

	(fn literal_false
		(:doc "Pass the false literal through a boolean parameter.")
		(params)
		(returns bool)
		(body
			(let value (bool false))
			(return (call echo_bool (local value)))))

	(fn u8_eq
		(:doc "Compare u8 operands for equality and pass the boolean result.")
		(params (left u8) (right u8))
		(returns bool)
		(body
			(let result (u8.eq (local left) (local right)))
			(return (call echo_bool (local result)))))

	(fn u8_lt
		(:doc "Compare u8 operands for ordering and pass the boolean result.")
		(params (left u8) (right u8))
		(returns bool)
		(body
			(let result (u8.lt (local left) (local right)))
			(return (call echo_bool (local result)))))

	(fn i32_eq
		(:doc "Compare i32 operands for equality and pass the boolean result.")
		(params (left i32) (right i32))
		(returns bool)
		(body
			(let result (i32.eq (local left) (local right)))
			(return (call echo_bool (local result)))))

	(fn i32_lt
		(:doc "Compare i32 operands for ordering and pass the boolean result.")
		(params (left i32) (right i32))
		(returns bool)
		(body
			(let result (i32.lt (local left) (local right)))
			(return (call echo_bool (local result)))))

	(fn u32_eq
		(:doc "Compare u32 operands for equality and pass the boolean result.")
		(params (left u32) (right u32))
		(returns bool)
		(body
			(let result (u32.eq (local left) (local right)))
			(return (call echo_bool (local result)))))

	(fn u32_lt
		(:doc "Compare u32 operands for ordering and pass the boolean result.")
		(params (left u32) (right u32))
		(returns bool)
		(body
			(let result (u32.lt (local left) (local right)))
			(return (call echo_bool (local result)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Supply the seed entry point for the host probe.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (i32 0)))))
