(module scalar_compare
	;; Copy a boolean through a local and return it to the caller.
	(fn echo_bool
		(params (incoming bool))
		(returns bool)
		(body
			(let value (local incoming))
			(return (local value))))

	;; Pass the true literal through a boolean parameter.
	(fn literal_true
		(params)
		(returns bool)
		(body
			(let value (bool true))
			(return (call echo_bool (local value)))))

	;; Pass the false literal through a boolean parameter.
	(fn literal_false
		(params)
		(returns bool)
		(body
			(let value (bool false))
			(return (call echo_bool (local value)))))

	;; Compare u8 operands for equality and pass the boolean result.
	(fn u8_eq
		(params (left u8) (right u8))
		(returns bool)
		(body
			(let result (u8.eq (local left) (local right)))
			(return (call echo_bool (local result)))))

	;; Compare u8 operands for ordering and pass the boolean result.
	(fn u8_lt
		(params (left u8) (right u8))
		(returns bool)
		(body
			(let result (u8.lt (local left) (local right)))
			(return (call echo_bool (local result)))))

	;; Compare i32 operands for equality and pass the boolean result.
	(fn i32_eq
		(params (left i32) (right i32))
		(returns bool)
		(body
			(let result (i32.eq (local left) (local right)))
			(return (call echo_bool (local result)))))

	;; Compare i32 operands for ordering and pass the boolean result.
	(fn i32_lt
		(params (left i32) (right i32))
		(returns bool)
		(body
			(let result (i32.lt (local left) (local right)))
			(return (call echo_bool (local result)))))

	;; Compare u32 operands for equality and pass the boolean result.
	(fn u32_eq
		(params (left u32) (right u32))
		(returns bool)
		(body
			(let result (u32.eq (local left) (local right)))
			(return (call echo_bool (local result)))))

	;; Compare u32 operands for ordering and pass the boolean result.
	(fn u32_lt
		(params (left u32) (right u32))
		(returns bool)
		(body
			(let result (u32.lt (local left) (local right)))
			(return (call echo_bool (local result)))))

	;; Supply the seed entry point for the host probe.
	(fn main
		(params)
		(returns i32)
		(body
			(return (i32 0)))))
