(module type_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./types/forward.wove" (only relay))
	(use wove-file "./types/base.wove"
		(only Item read_item (type Item) (type (as Item Alias))))
	(fn make
		(params (value i32))
		(returns Item)
		(body (return (record.make Alias (value (local value))))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let original (call relay (call Item (i32 19))))
			(let alias (call make (i32 23)))
			(return (i32.add.wrapping
				(call read_item (local original))
				(call read_item (local alias)))))))
