(module type_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./types/forward.wove" (only relay))
	(use wove-file "./types/base.wove"
		(only Item read_item (type Item) (type (as Item Alias))))
	(fn make
		(params (value i32))
		(returns Item)
		(body (return (struct.new Alias (value value)))))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let original (call relay (call Item (i32 19))))
			(let alias (call make (i32 23)))
			(return (i32.add
				(call read_item original)
				(call read_item alias))))))
