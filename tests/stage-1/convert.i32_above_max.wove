(module convert_i32_above_max
	;; Check the argument's representability at the conversion site.
	(fn checked
		(params (value u32))
		(returns i32)
		(body
			(return (int.convert i32 (local value)))))

	;; Pass a value that fits the source type and exceeds the target range.
	(fn main
		(params)
		(returns i32)
		(body
			(return (call checked (u32 2147483648))))))
