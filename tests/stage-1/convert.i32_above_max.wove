(module convert_i32_above_max
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn checked
		(:doc "Check the argument's representability at the conversion site.")
		(params (value u32))
		(returns i32)
		(body
			(return (int.convert i32 (local value)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Pass a value that fits the source type and exceeds the target range.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (call checked (u32 2147483648))))))
