(module loop_scan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Initialize a byte through an exclusive slice.")
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array.store data index value)))

	(fn scan
		(:doc "Read one byte per iteration and require the cursor to reach the length.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let length (array.len data))
			(let-mut cursor (i32 0))
			(let-mut total (i32 0))
			(while (i32.lt cursor length)
				(body
					(let byte (array.load data cursor))
					(set total (i32.add
							total (int.convert i32 byte)))
					(set cursor (i32.add cursor (i32 1)))))
			(if (i32.eq cursor length)
				(then (return total)))
			(return (i32 99))))

	(fn main
		(:doc "Exercise three loads and the zero-iteration path through the same callee.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut input (array.alloc u8 (i32 3)))
			(call put (borrow-mut input) (i32 0) (u8 7))
			(call put (borrow-mut input) (i32 1) (u8 13))
			(call put (borrow-mut input) (i32 2) (u8 22))
			(let empty (array.alloc u8 (i32 0)))
			(return (i32.sub
					(call scan (borrow-shared input))
					(call scan (borrow-shared empty)))))))
