(module loop_scan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Initialize a byte through an exclusive slice.")
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array.store (local data) (local index) (local value))))

	(fn scan
		(:doc "Read one byte per iteration and require the cursor to reach the length.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let length (array.len (local data)))
			(let-mut cursor (i32 0))
			(let-mut total (i32 0))
			(while (i32.lt (local cursor) (local length))
				(body
					(let byte (array.load (local data) (local cursor)))
					(set (local total) (i32.add
							(local total) (int.convert i32 (local byte))))
					(set (local cursor) (i32.add (local cursor) (i32 1)))))
			(if (i32.eq (local cursor) (local length))
				(then (return (local total))))
			(return (i32 99))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Exercise three loads and the zero-iteration path through the same callee.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut input (array.alloc u8 (i32 3)))
			(call put (borrow-mut (local input)) (i32 0) (u8 7))
			(call put (borrow-mut (local input)) (i32 1) (u8 13))
			(call put (borrow-mut (local input)) (i32 2) (u8 22))
			(let empty (array.alloc u8 (i32 0)))
			(return (i32.sub
					(call scan (borrow-shared (local input)))
					(call scan (borrow-shared (local empty))))))))
