(module loop_scan
	;; Initialize a byte through an exclusive slice.
	(fn put
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns void)
		(body
			(slice.store (local data) (local index) (local value))))

	;; Read one byte per iteration and require the cursor to reach the length.
	(fn scan
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(let length (slice.len (local data)))
			(let-mut cursor (i32 0))
			(let-mut total (i32 0))
			(while (i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local data) (local cursor)))
					(set (local total) (i32.add.wrapping
						(local total) (int.convert i32 (local byte))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(if (i32.eq (local cursor) (local length))
				(then (return (local total))))
			(return (i32 99))))

	;; Exercise three loads and the zero-iteration path through the same callee.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut input (array.alloc u8 (i32 3)))
			(call put (borrow-mut (local input)) (i32 0) (u8 7))
			(call put (borrow-mut (local input)) (i32 1) (u8 13))
			(call put (borrow-mut (local input)) (i32 2) (u8 22))
			(let empty (array.alloc u8 (i32 0)))
			(return (i32.sub.wrapping
				(call scan (borrow-shared (local input)))
				(call scan (borrow-shared (local empty))))))))
