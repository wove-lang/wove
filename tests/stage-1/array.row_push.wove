(module row_push
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 0i32))
			(for (let index) (range 0i32 9i32)
				(body
					(let-mut row (array:alloc u8 1i32))
					(array:store row 0i32 (u8:from-i32 (i32:add 25i32 index)))
					(array:push rows (move row))))
			(let tail (borrow-shared (array:load rows 8i32)))
			(return (i32:add (array:len rows) (i32:from-u8 (array:load tail 0i32))))))
)
