(module negated_comparisons
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn advance (params (data (mut-array u8)) (next u8)) (returns u8)
		(body
			(let previous (array.load data 0i32))
			(array.store data 0i32 next)
			(return previous)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let reversed (u8.not-lt
				(call advance (borrow-mut data) 1u8)
				(call advance (borrow-mut data) 2u8)))
			(if reversed (then (return 1i32)))
			(if (u8.not-eq (array.load data 0i32) 2u8) (then (return 2i32)))
			(if (i32.not-lt -1i32 0i32) (then (return 3i32)))
			(if (i32.not-eq -1i32 -1i32) (then (return 4i32)))
			(if (u32.not-lt 0u32 4294967295u32) (then (return 5i32)))
			(if (u32.not-eq 4294967295u32 0u32) (then (return 42i32)))
			(return 6i32))))
