(module moved_array_length
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let data (array.alloc u8 4i32))
			(let received (move (local data)))
			(return (array.len (local data))))))
