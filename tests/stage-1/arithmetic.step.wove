(module integer_step_seed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn count (params (data (mut-array u8))) (returns i32)
		(body
			(let old (i32:from-u8 (array:load data 0i32)))
			(let next (i32:inc old))
			(array:store data 0i32 (u8:from-i32 next))
			(return old)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 1i32))
			(let-mut maximum 2147483647i32)
			(if (i32:not-eq (i32:inc maximum) -2147483648i32) (then (return 1i32)))
			(if (i32:not-eq maximum 2147483647i32) (then (return 2i32)))
			(if (i32:not-eq (i32:dec -2147483648i32) 2147483647i32) (then (return 3i32)))
			(if (u32:not-eqz (u32:inc 4294967295u32)) (then (return 4i32)))
			(if (u32:not-eq (u32:dec 0u32) 4294967295u32) (then (return 5i32)))
			(if (i32:not-eq (i32:inc (call count (borrow-mut data))) 1i32) (then (return 6i32)))
			(if (u8:not-eq (array:load data 0i32) 1u8) (then (return 7i32)))
			(return 42i32))))
