(module integer_step_seed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn count (params (data (mut-array u8))) (returns i32)
		(body
			(let old (i32.from-u8 (array.load (local data) 0i32)))
			(let next (i32.inc (local old)))
			(array.store (local data) 0i32 (u8.from-i32 (local next)))
			(return (local old))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(let-mut maximum 2147483647i32)
			(if (i32.not-eq (i32.inc (local maximum)) -2147483648i32) (then (return 1i32)))
			(if (i32.not-eq (local maximum) 2147483647i32) (then (return 2i32)))
			(if (i32.not-eq (i32.dec -2147483648i32) 2147483647i32) (then (return 3i32)))
			(if (u32.not-eqz (u32.inc 4294967295u32)) (then (return 4i32)))
			(if (u32.not-eq (u32.dec 0u32) 4294967295u32) (then (return 5i32)))
			(if (i32.not-eq (i32.inc (call count (borrow-mut (local data)))) 1i32) (then (return 6i32)))
			(if (u8.not-eq (array.load (local data) 0i32) 1u8) (then (return 7i32)))
			(return 42i32))))
