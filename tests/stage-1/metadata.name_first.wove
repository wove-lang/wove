(module name_first
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Exercise the name slot without changing parameter or record field names.`)
	(:pragma (cfg bootstrap))
	(struct Sample (fields (fn i32) (module i32)))
	(decls
		(fn choose
			(:pragma (cfg bootstrap))
			(params (fn Sample))
			(returns i32)
			(body (return (record.get (local fn) fn)))))
	(fn choose (:pragma (test)))
	(fn (:pragma (cfg (not bootstrap))) main)
	(fn main
		(:doc `Combine a plain binding and a mutable cursor.`)
		(:expect (tests "stage-1/metadata.name_first.wove") (issues "gh:wove-lang/wove:184"))
		(params)
		(returns i32)
		(body
			(let base (record.make Sample (fn (i32 40)) (module (i32 0))))
			(let-mut cursor (call choose (local base)))
			(set (local cursor) (i32.add.wrapping (local cursor) (i32 2)))
			(return (local cursor)))))
