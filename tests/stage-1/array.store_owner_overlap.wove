(module array_store_owner_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 2i32))
			(array.store (local data) 1i32 42u8)
			(array.store (local data) 0i32
				(array.load (local data) 1i32))
			(return (int.convert i32 (array.load (local data) 0i32))))))
