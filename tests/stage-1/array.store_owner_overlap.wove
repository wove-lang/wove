(module array_store_owner_overlap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 2i32))
			(array:set data 1i32 42u8)
			(array:set data 0i32
				(array:get data 1i32))
			(return (int:convert i32 (array:get data 0i32))))))
