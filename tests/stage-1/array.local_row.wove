(module local_row
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn first (params (row (shared-array u8))) (returns i32)
		(body (return (i32:from-u8 (array:get row 0i32)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 1i32))
			(let-mut original (array:alloc u8 1i32))
			(array:set original 0i32 42u8)
			(array:set rows 0i32 (move original))
			(let-mut result 0i32)
			(if (bool true)
				(then
					(let row (borrow-shared (array:get rows 0i32)))
					(set result (call first (borrow-shared row)))))
			(array:set rows 0i32 (array:alloc u8 2i32))
			(return result))))
