(module scalar_receiver_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let width 3u32)

	(fn compute
		(params (value i32) (off bool))
		(returns i32)
		(body
			(if (off.and (i32:eq (i32:div 1i32 0i32) 0i32)) (then (return 1i32)))
			(let index width)
			(if (u32:not-eq index.dec (index.dec)) (then (return 5i32)))
			(if (u32:not-eq index.dec 2u32) (then (return 6i32)))
			(if (width.gt 1u32)
				(then
					(let width value)
					(if width.ltz (then (return (width.add 45i32))))))
			(return 2i32)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let optional (array:try-alloc u8 1i32))
			(if optional.is-null (then (return 3i32)))
			(let data (move optional.unwrap))
			(if (i32:not-eq data.len 1i32) (then (return 4i32)))
			(return (call compute -3i32 (bool false))))))
