	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	after_return
	(fn
		(:doc "A return terminates the statement sequence.")
		main
		(params)
		(returns i32)
		(body
			(return (i32 0))
			(if (i32 1)
				(then (return (i32 1)))))))
