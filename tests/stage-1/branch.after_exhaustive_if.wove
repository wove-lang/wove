(module after_exhaustive_if
	;; A branch with two returning arms terminates the statement sequence.
	(fn main
		(params)
		(returns i32)
		(body
			(if (bool true)
				(then (return (i32 0)))
				(else (return (i32 1))))
			(unknown-statement))))
