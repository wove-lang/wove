(module after_exhaustive_if
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "A branch with two returning arms terminates the statement sequence.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool true)
				(then (return (i32 0)))
				(else (return (i32 1))))
			(unknown-statement))))
