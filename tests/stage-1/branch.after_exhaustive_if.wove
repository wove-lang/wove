	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	after_exhaustive_if
	(fn
		(:doc "A branch with two returning arms terminates the statement sequence.")
		main
		(params)
		(returns i32)
		(body
			(if (bool true)
				(then (return (i32 0)))
				(else (return (i32 1))))
			(unknown-statement))))
