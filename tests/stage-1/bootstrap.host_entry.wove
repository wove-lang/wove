(module bootstrap_host_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let display_name "wove-583")

	(fn name_matches
		(params (program (shared-array u8))) (returns bool)
		(body
			(if (i32.not-eq (array.len (local program)) (array.len (local display_name))) (then (return (bool false))))
			(let-mut index 0i32)
			(while (i32.lt (local index) (array.len (local program)))
				(body
					(if (u8.not-eq (array.load (local program) (local index)) (array.load (local display_name) (local index)))
						(then (return (bool false))))
					(set (local index) (i32.inc (local index)))))
			(return (bool true))))

	(fn main
		(:expect (tests "stage-1/cases.tsv" "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:583"))
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (array.len (local argv)))
			(let program (array.load (local argv) 0i32))
			(if (i32.eqz (array.len (local program))) (then (return 1i32)))
			(if (i32.eq (local count) 1i32) (then (return 42i32)))
			(let payload (array.load (local argv) 1i32))
			(let length (array.len (local payload)))
			(if (bool.and (i32.eq (local count) 2i32) (i32.eqz (local length))) (then (return 42i32)))
			(if (i32.not-eq (local length) 3i32) (then (return 2i32)))
			(if (bool.not (bool.and (u8.eq (array.load (local payload) 0i32) 97u8)
				(bool.and (u8.eq (array.load (local payload) 1i32) 32u8)
					(u8.eq (array.load (local payload) 2i32) 98u8))))
				(then (return 3i32)))
			(if (i32.eq (local count) 2i32) (then (return 42i32)))
			(let empty (array.load (local argv) 2i32))
			(if (i32.not-eqz (array.len (local empty))) (then (return 4i32)))
			(if (i32.eq (local count) 3i32) (then (return 42i32)))
			(if (bool.and (i32.eq (local count) 5i32) (bool.not (call name_matches (borrow-shared (local program)))))
				(then (return 7i32)))
			(let raw (array.load (local argv) 3i32))
			(if (i32.not-eq (array.len (local raw)) 2i32) (then (return 5i32)))
			(if (bool.and (u8.eq (array.load (local raw) 0i32) 255u8)
				(u8.eq (array.load (local raw) 1i32) 128u8))
				(then (return 42i32)))
			(return 6i32)))
)
