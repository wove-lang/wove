(module bootstrap_host_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct HostSpan (fields (start i32) (end i32)))

	(fn main
		(:expect (tests "stage-1/cases.tsv" "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:325" "gh:wove-lang/wove:338"))
		(params (bytes (shared-slice u8)) (argv (shared-slice HostSpan)))
		(returns i32)
		(body
			(let rows (slice.len (local argv)))
			(let length (slice.len (local bytes)))
			(if (i32.eq (local rows) 0i32)
				(then (return (i32.add.wrapping (local length) 42i32))))
			(if (i32.eq (local rows) 1i32)
				(then
					(let only (slice.load (local argv) 0i32))
					(if (bool.not (bool.and (i32.eq (struct.get (local only) start) 0i32)
						(i32.eq (struct.get (local only) end) (local length))))
						(then (return 2i32)))
					(if (i32.eq (local length) 0i32) (then (return 42i32)))
					(if (bool.and (i32.eq (local length) 3i32)
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 97u8)
							(bool.and (u8.eq (slice.load (local bytes) 1i32) 32u8)
								(u8.eq (slice.load (local bytes) 2i32) 98u8))))
						(then (return 42i32)))
					(return 4i32)))
			(if (bool.not (bool.and (i32.eq (local rows) 2i32) (i32.eq (local length) 3i32)))
				(then (return 1i32)))
			(let full (slice.load (local argv) 0i32))
			(let empty (slice.load (local argv) 1i32))
			(if (bool.not (bool.and (i32.eq (struct.get (local full) start) 0i32)
				(i32.eq (struct.get (local full) end) 3i32)))
				(then (return 2i32)))
			(if (bool.not (bool.and (i32.eq (struct.get (local empty) start) 3i32)
				(i32.eq (struct.get (local empty) end) 3i32)))
				(then (return 3i32)))
			(if (bool.and (u8.eq (slice.load (local bytes) 0i32) 97u8)
				(bool.and (u8.eq (slice.load (local bytes) 1i32) 32u8)
					(u8.eq (slice.load (local bytes) 2i32) 98u8)))
				(then (return 42i32)))
			(return 4i32)))
)
