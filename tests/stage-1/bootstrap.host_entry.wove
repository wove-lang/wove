(module bootstrap_host_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let display_name "wove-583")

	(fn name_matches
		(params (program (shared-array u8))) (returns bool)
		(body
			(if (i32.not-eq (array.len program) (array.len display_name)) (then (return (bool false))))
			(let-mut index 0i32)
			(while (i32.lt index (array.len program))
				(body
					(if (u8.not-eq (array.load program index) (array.load display_name index))
						(then (return (bool false))))
					(set index (i32.inc index))))
			(return (bool true))))

	(fn main
		(:expect (tests "stage-1/cases.tsv" "stage-2/scalar_graphs.tsv") (issues "gh:wove-lang/wove:583"))
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count (array.len argv))
			(let program (array.load argv 0i32))
			(if (i32.eqz (array.len program)) (then (return 1i32)))
			(if (i32.eq count 1i32) (then (return 42i32)))
			(let payload (array.load argv 1i32))
			(let length (array.len payload))
			(if (bool.and (i32.eq count 2i32) (i32.eqz length)) (then (return 42i32)))
			(if (i32.not-eq length 3i32) (then (return 2i32)))
			(if (bool.not (bool.and (u8.eq (array.load payload 0i32) 97u8)
				(bool.and (u8.eq (array.load payload 1i32) 32u8)
					(u8.eq (array.load payload 2i32) 98u8))))
				(then (return 3i32)))
			(if (i32.eq count 2i32) (then (return 42i32)))
			(let empty (array.load argv 2i32))
			(if (i32.not-eqz (array.len empty)) (then (return 4i32)))
			(if (i32.eq count 3i32) (then (return 42i32)))
			(if (bool.and (i32.eq count 5i32) (bool.not (call name_matches (borrow-shared program))))
				(then (return 7i32)))
			(let raw (array.load argv 3i32))
			(if (i32.not-eq (array.len raw) 2i32) (then (return 5i32)))
			(if (bool.and (u8.eq (array.load raw 0i32) 255u8)
				(u8.eq (array.load raw 1i32) 128u8))
				(then (return 42i32)))
			(return 6i32)))
)
