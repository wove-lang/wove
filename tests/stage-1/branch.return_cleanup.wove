(module branch_return_cleanup
	;; Return from the inner arm and release the outer arm's local buffer.
	(fn main
		(params)
		(returns i32)
		(body
			(if (bool true)
				(then
					(let buffer (array.alloc u8 (i32 3)))
					(if (bool true)
						(then (return (i32 13))))))
			(return (i32 0)))))
