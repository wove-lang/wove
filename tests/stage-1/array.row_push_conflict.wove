(module row_push_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array:alloc (owned-array u8) 1i32))
			(array:set rows 0i32 (array:alloc u8 1i32))
			(let row (borrow-shared (array:get rows 0i32)))
			(array:push rows (array:alloc u8 2i32))
			(return (array:len row))))
)
