(module record_unknown_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (start i32) (end i32)))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let token
				(struct.new Token
					(kind (u32 40))
					(start (i32 2))
					(stop (i32 3))))
			(return (struct.get (local token) start)))))
