(module local_row_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut rows (array.alloc (owned-array u8) 1i32))
			(array.store rows 0i32 (array.alloc u8 1i32))
			(let row (borrow-shared (array.load rows 0i32)))
			(let replacement (array.alloc u8 2i32))
			(array.store rows 0i32 (move replacement))
			(return (array.len row)))))
