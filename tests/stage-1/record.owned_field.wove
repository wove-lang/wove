(module owned_record_field
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Payload (fields (bytes (owned-array u8))))
	(struct Envelope (fields (payload Payload)))

	(fn wrap (params (payload Payload)) (returns Envelope)
		(body (return (struct.new Envelope (payload (move payload))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array.alloc u8 3i32))
			(array.store bytes 0i32 42u8)
			(let payload (struct.new Payload (bytes (move bytes))))
			(let envelope (call wrap (move payload)))
			(return (i32.from-u8 (array.load (struct.get (struct.get envelope payload) bytes) 0i32))))))
