(module record_argument_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (start i32)))
	(struct OtherToken (fields (start i32)))

	(fn read_start
		(params (token Token))
		(returns i32)
		(body
			(return (record.get (local token) start))))

	(fn main
		(params)
		(returns i32)
		(body
			(let other (record.make OtherToken (start (i32 2))))
			(return (call read_start
					(local other))))))
