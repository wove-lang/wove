(module record_argument_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (start i32)))
	(struct OtherToken (fields (start i32)))

	(fn read_start
		(params (token Token))
		(returns i32)
		(body
			(return (struct.get (local token) start))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let other (struct.new OtherToken (start (i32 2))))
			(return (call read_start
					(local other))))))
