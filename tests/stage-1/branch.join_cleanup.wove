(module branch_join_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn transfer_if
		(:doc "Leave the original owner live on the omitted else path until function exit.")
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(if (local take)
				(then (let received (move (local buffer)))))
			(return (i32 17))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Track the allocation on the path that skips the move.")
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(return (call transfer_if (bool false))))))
