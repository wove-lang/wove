(module branch_join_cleanup
	;; Leave the original owner live on the omitted else path until function exit.
	(fn transfer_if
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(if (local take)
				(then (let received (move (local buffer)))))
			(return (i32 17))))

	;; Track the allocation on the path that skips the move.
	(fn main
		(params)
		(returns i32)
		(body
			(return (call transfer_if (bool false))))))
