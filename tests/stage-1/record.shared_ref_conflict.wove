(module record_shared_ref_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Job (fields (arguments (owned-array u8))))

	(fn inspect (params (job (shared-ref Job))) (returns i32)
		(body (return (array:len (struct:get job arguments)))))

	(fn index (params (jobs (mut-array Job))) (returns i32)
		(body (return 0i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut jobs (array:alloc Job 1i32))
			(array:store jobs 0i32 (struct:new Job (arguments (array:alloc u8 1i32))))
			(return (call inspect (borrow-shared (array:load jobs (call index (borrow-mut jobs)))))))))
