(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	boolean_evaluation_order
	(fn step
		(params (state (mut-slice u8)) (expected u8))
		(returns bool)
		(body
			(let before (slice.load (local state) (i32 0)))
			(let after (i32.add.wrapping (int.convert i32 (local before)) (i32 1)))
			(slice.store (local state) (i32 0) (int.convert u8 (local after)))
			(return (u8.eq (local before) (local expected)))))

	(fn count
		(params (state (shared-slice u8)))
		(returns i32)
		(body
			(return (int.convert i32 (slice.load (local state) (i32 0))))))

	(fn main
		(params)
		(returns i32)
		(body
			(let-mut state (array.alloc u8 (i32 1)))
			(let and_result (bool.and
					(call step (borrow-mut (local state)) (u8 0))
					(call step (borrow-mut (local state)) (u8 1))))
			(let or_result (bool.or
					(bool.not (call step (borrow-mut (local state)) (u8 2)))
					(call step (borrow-mut (local state)) (u8 3))))
			(if (bool.and (local and_result) (local or_result))
				(then (return (call count (borrow-shared (local state))))))
			(return (i32 0)))))
