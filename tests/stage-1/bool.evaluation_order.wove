(module boolean_evaluation_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn step
		(params (state (mut-array u8)) (expected u8))
		(returns bool)
		(body
			(let before (array:load state (i32 0)))
			(let after (i32:add (int:convert i32 before) (i32 1)))
			(array:store state (i32 0) (int:convert u8 after))
			(return (u8:eq before expected))))

	(fn count
		(params (state (shared-array u8)))
		(returns i32)
		(body
			(return (int:convert i32 (array:load state (i32 0))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut state (array:alloc u8 (i32 1)))
			(let and_result (bool:and
					(call step (borrow-mut state) (u8 0))
					(call step (borrow-mut state) (u8 1))))
			(let or_result (bool:or
					(bool:not (call step (borrow-mut state) (u8 2)))
					(call step (borrow-mut state) (u8 3))))
			(if (bool:and and_result or_result)
				(then (return (call count (borrow-shared state)))))
			(return (i32 0)))))
