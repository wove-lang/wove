(module range_shared_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Initialize the original buffer with distinct byte values.")
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns void)
		(body
			(slice.store (local data) (local index) (local value))))

	(fn window
		(:doc "Check the window's length and both relative byte positions.")
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(let width (slice.len (local data)))
			(let first (slice.load (local data) (i32 0)))
			(let second (slice.load (local data) (i32 1)))
			(if (i32.eq (local width) (i32 2))
				(then
					(if (u8.eq (local first) (u8 13))
						(then
							(if (u8.eq (local second) (u8 22))
								(then (return (i32 37))))))))
			(return (i32 0))))

	(fn through_mutable
		(:doc "Forward a shared range of a mutable slice parameter.")
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(return (call window
					(borrow-shared (slice.range (local data) (i32 1) (i32 3)))))))

	(fn length
		(:doc "Report the length of the view passed to this helper.")
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))

	(fn empty_at_end
		(:doc "Build an empty view at the shared source's one-past endpoint.")
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(let end (slice.len (local data)))
			(return (call length
					(borrow-shared (slice.range (local data) (local end) (local end)))))))

	(fn main
		(:doc "Check ranges of an owner and of both kinds of slice parameters.")
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call put (borrow-mut (local buffer)) (i32 0) (u8 7))
			(call put (borrow-mut (local buffer)) (i32 1) (u8 13))
			(call put (borrow-mut (local buffer)) (i32 2) (u8 22))
			(let direct (call window
					(borrow-shared (slice.range (local buffer) (i32 1) (i32 3)))))
			(let nested (call through_mutable (borrow-mut (local buffer))))
			(let empty (call empty_at_end (borrow-shared (local buffer))))
			(return (i32.add.wrapping
					(i32.add.wrapping (local direct) (local nested))
					(local empty))))))
