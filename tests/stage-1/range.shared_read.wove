(module range_shared_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Initialize the original buffer with distinct byte values.")
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array.store data index value)))

	(fn window
		(:doc "Check the window's length and both relative byte positions.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let width (array.len data))
			(let first (array.load data (i32 0)))
			(let second (array.load data (i32 1)))
			(if (i32.eq width (i32 2))
				(then
					(if (u8.eq first (u8 13))
						(then
							(if (u8.eq second (u8 22))
								(then (return (i32 37))))))))
			(return (i32 0))))

	(fn through_mutable
		(:doc "Forward a shared range of a mutable slice parameter.")
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(return (call window
					(borrow-shared (array.range data (i32 1) (i32 3)))))))

	(fn length
		(:doc "Report the length of the view passed to this helper.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array.len data))))

	(fn empty_at_end
		(:doc "Build an empty view at the shared source's one-past endpoint.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let end (array.len data))
			(return (call length
					(borrow-shared (array.range data end end))))))

	(fn main
		(:doc "Check ranges of an owner and of both kinds of slice parameters.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call put (borrow-mut buffer) (i32 0) (u8 7))
			(call put (borrow-mut buffer) (i32 1) (u8 13))
			(call put (borrow-mut buffer) (i32 2) (u8 22))
			(let direct (call window
					(borrow-shared (array.range buffer (i32 1) (i32 3)))))
			(let nested (call through_mutable (borrow-mut buffer)))
			(let empty (call empty_at_end (borrow-shared buffer)))
			(return (i32.add
					(i32.add direct nested)
					empty)))))
