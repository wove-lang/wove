(module range_shared_read
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Initialize the original buffer with distinct byte values.")
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array.store (local data) (local index) (local value))))

	(fn window
		(:doc "Check the window's length and both relative byte positions.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let width (array.len (local data)))
			(let first (array.load (local data) (i32 0)))
			(let second (array.load (local data) (i32 1)))
			(if (i32.eq (local width) (i32 2))
				(then
					(if (u8.eq (local first) (u8 13))
						(then
							(if (u8.eq (local second) (u8 22))
								(then (return (i32 37))))))))
			(return (i32 0))))

	(fn through_mutable
		(:doc "Forward a shared range of a mutable slice parameter.")
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(return (call window
					(borrow-shared (array.range (local data) (i32 1) (i32 3)))))))

	(fn length
		(:doc "Report the length of the view passed to this helper.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array.len (local data)))))

	(fn empty_at_end
		(:doc "Build an empty view at the shared source's one-past endpoint.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let end (array.len (local data)))
			(return (call length
					(borrow-shared (array.range (local data) (local end) (local end)))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Check ranges of an owner and of both kinds of slice parameters.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(call put (borrow-mut (local buffer)) (i32 0) (u8 7))
			(call put (borrow-mut (local buffer)) (i32 1) (u8 13))
			(call put (borrow-mut (local buffer)) (i32 2) (u8 22))
			(let direct (call window
					(borrow-shared (array.range (local buffer) (i32 1) (i32 3)))))
			(let nested (call through_mutable (borrow-mut (local buffer))))
			(let empty (call empty_at_end (borrow-shared (local buffer))))
			(return (i32.add
					(i32.add (local direct) (local nested))
					(local empty))))))
