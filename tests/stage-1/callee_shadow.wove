(module callee_shadow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn increment (params (value i32)) (returns i32)
		(body (return (i32:add value (i32 1)))))

	(fn shadow (params (increment i32)) (returns i32)
		(body (return (call increment (i32 41)))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body (return (call shadow (i32 41))))))
