(module store_negative
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn write_byte
		(:doc "Use a runtime argument as the index of a mutable slice write.")
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array:set data index value)))

	(fn main
		(:doc "Pass an out-of-bounds index for a three-byte buffer.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array:alloc u8 (i32 3)))
			(call write_byte (borrow-mut buffer) (i32 -1) (u8 42))
			(return (i32 0)))))
