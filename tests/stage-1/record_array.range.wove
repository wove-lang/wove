(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	record_array_range
	(struct Token (fields (kind u32)))

	(fn size
		(params (tokens (shared-slice Token)))
		(returns i32)
		(body (return (slice.len (local tokens)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call size
					(borrow-shared (slice.range (local tokens) (i32 0) (i32 1))))))))
