(module record_array_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))

	(fn size
		(params (tokens (shared-array Token)))
		(returns i32)
		(body (return (array.len (local tokens)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call size
					(borrow-shared (array.range (local tokens) (i32 0) (i32 1))))))))
