(module record_array_range
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))

	(fn size
		(params (tokens (shared-slice Token)))
		(returns i32)
		(body (return (slice.len (local tokens)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call size
					(borrow-shared (slice.range (local tokens) (i32 0) (i32 1))))))))
