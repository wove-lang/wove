(module record_array_load_negative
	(struct Token (fields (start i32)))

	(fn read
		(params (tokens (shared-slice Token)) (index i32))
		(returns i32)
		(body
			(return (record.get (slice.load (local tokens) (local index)) start))))

	(fn main
		(params)
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call read (borrow-shared (local tokens)) (i32 -1))))))
