(module record_array_load_negative
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (start i32)))

	(fn read
		(params (tokens (shared-array Token)) (index i32))
		(returns i32)
		(body
			(return (struct.get (array.load tokens index) start))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call read (borrow-shared tokens) (i32 -1))))))
