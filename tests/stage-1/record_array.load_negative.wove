(module record_array_load_negative
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (start i32)))

	(fn read
		(params (tokens (shared-array Token)) (index i32))
		(returns i32)
		(body
			(return (struct.get (array.load (local tokens) (local index)) start))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call read (borrow-shared (local tokens)) (i32 -1))))))
