(module store_shared
	;; Reject a write through a read-only byte slice.
	(fn write_byte
		(params (data (shared-slice u8)) (index i32) (value u8))
		(returns void)
		(body
			(slice.store (local data) (local index) (local value))))

	;; Call the invalid writer with a shared loan.
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(call write_byte (borrow-shared (local buffer)) (i32 1) (u8 42))
			(return (i32 0)))))
