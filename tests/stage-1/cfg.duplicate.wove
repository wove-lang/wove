(module cfg_duplicate
	(fn main
		(params)
		(returns i32)
		(body (return (i32 0))))

	(with-meta
		(meta (:pragma (cfg bootstrap)))
		(decls
			(fn main
				(params)
				(returns i32)
				(body (return (i32 1)))))))
