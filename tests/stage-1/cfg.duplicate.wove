(module cfg_duplicate
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (i32 0))))

	(decls
		(:pragma (cfg bootstrap))
		(fn main
			(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
			(returns i32)
			(body (return (i32 1))))))
