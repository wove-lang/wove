(module ownership_slice
  ;; Read the length through a shared borrow.
  (fn byte_count
    (params (data (shared-slice u8)))
    (returns i32)
    (body
      (return (slice.len (local data)))))
  ;; Observe the same allocation before and after transferring ownership.
  (fn main
    (params)
    (returns i32)
    (expect ownership.buffer_transfer
      (issue "https://github.com/wove-lang/wove/issues/1")
      (tests ownership.transfer ownership.use_after_move))
    (body
      (let buffer (array.alloc u8 (i32 3)))
      (let before (call byte_count (borrow-shared (local buffer))))
      (let received (move (local buffer)))
      (let after (call byte_count (borrow-shared (local received))))
      (return (i32.add.wrapping (local before) (local after))))))
