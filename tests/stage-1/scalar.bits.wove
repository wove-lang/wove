(module scalar_bits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn digit_matches
		(params (word u32) (count i32) (expected u32))
		(returns bool)
		(body (return (u32.eq (u32.and (u32.shr (local word) (local count)) (u32 31)) (local expected)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let byte (int.convert u32 (u8 226)))
			(let high_nibble (u32.shr (local byte) (i32 4)))
			(let low_nibble (u32.and (local byte) (u32 15)))
			(if (bool.not (bool.and (u32.eq (local high_nibble) (u32 14)) (u32.eq (local low_nibble) (u32 2))))
				(then (return (i32 1))))

			(let id (u32 2058472739))
			(let leading (bool.and (call digit_matches (local id) (i32 30) (u32 1))
				(bool.and (call digit_matches (local id) (i32 25) (u32 29))
					(call digit_matches (local id) (i32 20) (u32 11)))))
			(let trailing (bool.and (call digit_matches (local id) (i32 15) (u32 3))
				(bool.and (call digit_matches (local id) (i32 10) (u32 19))
					(bool.and (call digit_matches (local id) (i32 5) (u32 9))
						(call digit_matches (local id) (i32 0) (u32 3))))))
			(if (bool.not (bool.and (local leading) (local trailing)))
				(then (return (i32 2))))

			(let high (u32.shl (u32 4294967295) (i32 31)))
			(if (bool.not (u32.eq (local high) (u32 2147483648)))
				(then (return (i32 3))))
			(let all_bits (u32.or (local high) (u32 2147483647)))
			(if (bool.not (u32.eq (local all_bits) (u32 4294967295)))
				(then (return (i32 4))))
			(if (bool.not (u32.eq (u32.and (local all_bits) (local high)) (local high)))
				(then (return (i32 5))))
			(if (bool.not (u32.eq (u32.shr (local all_bits) (i32 31)) (u32 1)))
				(then (return (i32 6))))
			(if (bool.not (u32.eq (u32.shl (local all_bits) (i32 0)) (local all_bits)))
				(then (return (i32 7))))
			(if (bool.not (u32.eq (u32.shr (local all_bits) (i32 0)) (local all_bits)))
				(then (return (i32 8))))
			(let complement (u32.not (local high)))
			(if (bool.not (bool.and (u32.eq (local complement) (u32 2147483647))
					(u32.eq (u32.xor (local complement) (local high)) (local all_bits))))
				(then (return (i32 9))))
			(return (i32 42)))))
