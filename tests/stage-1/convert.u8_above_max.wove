(module convert_u8_above_max
	;; Check the argument's representability at the conversion site.
	(fn checked
		(params (value i32))
		(returns u8)
		(body
			(return (int.convert u8 (local value)))))

	;; Pass a value that fits the source type and exceeds the target range.
	(fn main
		(params)
		(returns i32)
		(body
			(return (int.convert i32 (call checked (i32 256)))))))
