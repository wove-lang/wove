(module convert_u8_above_max
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn checked
		(:doc "Check the argument's representability at the conversion site.")
		(params (value i32))
		(returns u8)
		(body
			(return (int.convert u8 (local value)))))

	(fn main
		(:doc "Pass a value that fits the source type and exceeds the target range.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(return (int.convert i32 (call checked (i32 256)))))))
