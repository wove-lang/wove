(module constructor_main
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./point.wove" (only (type (as Point Alias))))
	(struct Empty (fields))

	(fn next
		(params (calls (mut-array i32)))
		(returns i32)
		(body
			(let prior (calls.get 0i32))
			(calls.set 0i32 prior.inc)
			(return prior)))

	(fn first_byte
		(params (data (shared-array u8)))
		(returns u8)
		(body (return (data.get 0i32))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let Alias 41i32)
			(let ungrouped Empty.new)
			(let grouped (Empty.new))
			(let canonical (struct:new Empty))
			(let-mut calls (array:alloc i32 1i32))
			(let-mut data (array:alloc u8 1i32))
			(data.set 0i32 1u8)
			(let point (Alias.new (:doc "Construct the imported type even when a value has the same name.")
				(second (call next (borrow-mut calls)))
				(first (call next (borrow-mut calls)))
				(data (move data))))
			(if (bool:or (i32:not-eq point/first 1i32) (i32:not-eqz point/second))
				(then (return 2i32)))
			(if (i32:not-eq (calls.get 0i32) 2i32) (then (return 3i32)))
			(return (Alias.add (i32:from-u8 (call first_byte (borrow-shared point/data))))))))
