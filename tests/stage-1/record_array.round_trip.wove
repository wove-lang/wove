(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	record_array_round_trip
	(struct Token (fields (kind u32) (marker u8) (start i32) (end i32)))

	(fn write_tokens
		(params (tokens (mut-slice Token)))
		(returns Token)
		(body
			(let previous (slice.load (local tokens) (i32 0)))
			(slice.store (local tokens) (i32 0)
				(record.make Token (kind (u32 40)) (marker (u8 7)) (start (i32 2)) (end (i32 3))))
			(slice.store (local tokens) (i32 1)
				(record.make Token (kind (u32 4294967295)) (marker (u8 255)) (start (i32 -2)) (end (i32 -1))))
			(return (local previous))))

	(fn matches
		(params (token Token) (kind u32) (marker u8) (start i32) (end i32))
		(returns bool)
		(body
			(return (bool.and
					(bool.and
						(u32.eq (record.get (local token) kind) (local kind))
						(u8.eq (record.get (local token) marker) (local marker)))
					(bool.and
						(i32.eq (record.get (local token) start) (local start))
						(i32.eq (record.get (local token) end) (local end)))))))

	(fn check_tokens
		(params (tokens (shared-slice Token)))
		(returns bool)
		(body
			(return (bool.and
					(i32.eq (slice.len (local tokens)) (i32 2))
					(bool.and
						(call matches (slice.load (local tokens) (i32 0)) (u32 40) (u8 7) (i32 2) (i32 3))
						(call matches (slice.load (local tokens) (i32 1)) (u32 4294967295) (u8 255) (i32 -2) (i32 -1)))))))

	(fn
		(:expect bootstrap.record_array
			(issue "https://github.com/wove-lang/wove/issues/44"))
		main
		(params)
		(returns i32)
		(body
			(let-mut tokens (array.alloc Token (i32 2)))
			(let previous (call write_tokens (borrow-mut (local tokens))))
			(if (bool.and
					(call matches (local previous) (u32 0) (u8 0) (i32 0) (i32 0))
					(call check_tokens (borrow-shared (local tokens))))
				(then (return (i32 0))))
			(return (i32 1)))))
