(module record_array_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (marker u8) (start i32) (end i32)))

	(fn write_tokens
		(params (tokens (mut-array Token)))
		(returns Token)
		(body
			(let previous (array.load tokens (i32 0)))
			(array.store tokens (i32 0)
				(struct.new Token (kind (u32 40)) (marker (u8 7)) (start (i32 2)) (end (i32 3))))
			(array.store tokens (i32 1)
				(struct.new Token (kind (u32 4294967295)) (marker (u8 255)) (start (i32 -2)) (end (i32 -1))))
			(return previous)))

	(fn matches
		(params (token Token) (kind u32) (marker u8) (start i32) (end i32))
		(returns bool)
		(body
			(return (bool.and
					(bool.and
						(u32.eq (struct.get token kind) kind)
						(u8.eq (struct.get token marker) marker))
					(bool.and
						(i32.eq (struct.get token start) start)
						(i32.eq (struct.get token end) end))))))

	(fn check_tokens
		(params (tokens (shared-array Token)))
		(returns bool)
		(body
			(return (bool.and
					(i32.eq (array.len tokens) (i32 2))
					(bool.and
						(call matches (array.load tokens (i32 0)) (u32 40) (u8 7) (i32 2) (i32 3))
						(call matches (array.load tokens (i32 1)) (u32 4294967295) (u8 255) (i32 -2) (i32 -1)))))))

	(fn main
		(:expect bootstrap.record_array
			(issue "https://github.com/wove-lang/wove/issues/44"))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut tokens (array.alloc Token (i32 2)))
			(let previous (call write_tokens (borrow-mut tokens)))
			(if (bool.and
					(call matches previous (u32 0) (u8 0) (i32 0) (i32 0))
					(call check_tokens (borrow-shared tokens)))
				(then (return (i32 0))))
			(return (i32 1)))))
