(module value_imports
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modules/import_values.wove" (only alphabet code
		(value code) (value (as code signed_code)) (type (as code Code))))
	(use wove-file "./modules/./import_values.wove" (only (as alphabet digits)))

	(fn first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array.load (local bytes) (i32 0)))))

	(fn shadow
		(params (signed_code i32))
		(returns i32)
		(body
			(let digits (i32 1))
			(return (i32.add (local signed_code) (local digits)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(if (bool.not (i32.eq (array.len (local alphabet)) (i32 16)))
				(then (return (i32 1))))
			(if (bool.not (i32.eq (array.len (local digits)) (i32 16)))
				(then (return (i32 2))))
			(let-mut index (i32 0))
			(while (i32.lt (local index) (i32 16))
				(body
					(if (bool.not (u8.eq (array.load (local alphabet) (local index))
						(array.load (local digits) (local index))))
						(then (return (i32 3))))
					(set (local index) (i32.add (local index) (i32 1)))))
			(if (bool.not (u8.eq (array.load (local digits) (i32 15)) (u8 102)))
				(then (return (i32 4))))
			(if (bool.not (u8.eq (call first (borrow-shared (array.range (local digits) (i32 10) (i32 16)))) (u8 97)))
				(then (return (i32 5))))
			(if (bool.not (u8.eq (call first (borrow-shared (local alphabet))) (u8 48)))
				(then (return (i32 6))))
			(if (bool.not (i32.eq (int.convert i32 (local signed_code)) (i32 -7)))
				(then (return (i32 7))))
			(if (bool.not (i32.eq (int.convert i32 (local code)) (i32 -7)))
				(then (return (i32 8))))
			(let row (struct.new Code (value (call code))))
			(if (bool.not (i32.eq (struct.get (local row) value) (i32 42)))
				(then (return (i32 9))))
			(if (bool.not (i32.eq (call shadow (i32 41)) (i32 42)))
				(then (return (i32 10))))
			(return (i32 0)))))
