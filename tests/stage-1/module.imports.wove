(module value_imports
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modules/import_values.wove" (only alphabet (as code read_code)
		(value code) (value (as code signed_code)) (type (as code Code))))
	(use wove-file "./modules/./import_values.wove" (only (as alphabet digits)))

	(fn first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (array:load bytes (i32 0)))))

	(fn shadow
		(params (signed_code i32))
		(returns i32)
		(body
			(let digits (i32 1))
			(return (i32:add signed_code digits))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool:not (i32:eq (array:len alphabet) (i32 16)))
				(then (return (i32 1))))
			(if (bool:not (i32:eq (array:len digits) (i32 16)))
				(then (return (i32 2))))
			(let-mut index (i32 0))
			(while (i32:lt index (i32 16))
				(body
					(if (bool:not (u8:eq (array:load alphabet index)
						(array:load digits index)))
						(then (return (i32 3))))
					(set index (i32:add index (i32 1)))))
			(if (bool:not (u8:eq (array:load digits (i32 15)) (u8 102)))
				(then (return (i32 4))))
			(if (bool:not (u8:eq (call first (borrow-shared (array:range digits (i32 10) (i32 16)))) (u8 97)))
				(then (return (i32 5))))
			(if (bool:not (u8:eq (call first (borrow-shared alphabet)) (u8 48)))
				(then (return (i32 6))))
			(if (bool:not (i32:eq (int:convert i32 signed_code) (i32 -7)))
				(then (return (i32 7))))
			(if (bool:not (i32:eq (int:convert i32 code) (i32 -7)))
				(then (return (i32 8))))
			(let row (struct:new Code (value (call read_code))))
			(if (bool:not (i32:eq (struct:get row value) (i32 42)))
				(then (return (i32 9))))
			(if (bool:not (i32:eq (call shadow (i32 41)) (i32 42)))
				(then (return (i32 10))))
			(return (i32 0)))))
