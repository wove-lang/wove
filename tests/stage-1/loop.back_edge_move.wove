(module loop_back_edge_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn consume
		(:doc "Reject an outer move on an arm that can continue to the loop condition.")
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(while take
				(body
					(if take
						(then (let received (move buffer)))
						(else (return (i32 0))))))
			(return (i32 0))))

	(fn main
		(:doc "Supply the condition through a value parameter.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(return (call consume (bool true))))))
