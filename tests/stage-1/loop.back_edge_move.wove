(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	loop_back_edge_move
	(fn
		(:doc "Reject an outer move on an arm that can continue to the loop condition.")
		consume
		(params (take bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(while (local take)
				(body
					(if (local take)
						(then (let received (move (local buffer))))
						(else (return (i32 0))))))
			(return (i32 0))))

	(fn
		(:doc "Supply the condition through a value parameter.")
		main
		(params)
		(returns i32)
		(body
			(return (call consume (bool true))))))
