(module reborrow_exclusive_from_shared
	;; A store needs an exclusive view.
	(fn put
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local data) (i32 0) (u8 42))))

	;; A shared parameter cannot grant the helper write permission.
	(fn forward
		(params (data (shared-slice u8)))
		(returns void)
		(body
			(call put (borrow-mut (local data)))))

	;; Supply a shared parent view.
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 1)))
			(call forward (borrow-shared (local buffer)))
			(return (i32 0)))))
