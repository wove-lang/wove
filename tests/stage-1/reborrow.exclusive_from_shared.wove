(module reborrow_exclusive_from_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "A store needs an exclusive view.")
		(params (data (mut-array u8)))
		(returns void)
		(body
			(array:store data (i32 0) (u8 42))))

	(fn forward
		(:doc "A shared parameter cannot grant the helper write permission.")
		(params (data (shared-array u8)))
		(returns void)
		(body
			(call put (borrow-mut data))))

	(fn main
		(:doc "Supply a shared parent view.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array:alloc u8 (i32 1)))
			(call forward (borrow-shared buffer))
			(return (i32 0)))))
