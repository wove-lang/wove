(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	reborrow_exclusive_from_shared
	(fn
		(:doc "A store needs an exclusive view.")
		put
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local data) (i32 0) (u8 42))))

	(fn
		(:doc "A shared parameter cannot grant the helper write permission.")
		forward
		(params (data (shared-slice u8)))
		(returns void)
		(body
			(call put (borrow-mut (local data)))))

	(fn
		(:doc "Supply a shared parent view.")
		main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 1)))
			(call forward (borrow-shared (local buffer)))
			(return (i32 0)))))
