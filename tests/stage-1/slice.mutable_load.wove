(module mutable_load
	;; Read a byte from the same mutable slice that was used to write it.
	(fn write_and_read
		(params (data (mut-slice u8)) (index i32) (value u8))
		(returns u8)
		(body
			(slice.store (local data) (local index) (local value))
			(return (slice.load (local data) (local index)))))

	;; Check that the largest byte survives the call and widens as unsigned.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(return (i32.from-u8
				(call write_and_read (borrow-mut (local buffer)) (i32 0) (u8 255)))))))
