(module mutable_load
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn write_and_read
		(:doc "Read a byte from the same mutable slice that was used to write it.")
		(params (data (mut-array u8)) (index i32) (value u8))
		(returns u8)
		(body
			(array.store (local data) (local index) (local value))
			(return (array.load (local data) (local index)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Check that the largest byte survives the call and widens as unsigned.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(return (i32.from-u8
					(call write_and_read (borrow-mut (local buffer)) (i32 0) (u8 255)))))))
