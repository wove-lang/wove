(module record_mismatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./imports/left.wove" (only read_item))
	(struct Item (fields (left i32)))
	(fn main
		(params)
		(returns i32)
		(body (return (call read_item
					(record.make Item (left (i32 4))))))))
