(module import_set
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modules/import_values.wove" (only (value (as code signed_code))))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(set (local signed_code) (i8 0))
			(return (i32 0)))))
