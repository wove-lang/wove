(module hexadecimal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let max_word 0XfFfFfFfFu32)
	(let min_byte (i8 -0x80))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool.not (u32.eq max_word 4294967295u32))
				(then (return 1i32)))
			(if (bool.not (i32.eq (int.convert i32 min_byte) -128i32))
				(then (return 2i32)))
			(if (bool.not (i32.eq (int.convert i32 0x7Fi8) 127i32))
				(then (return 3i32)))
			(if (bool.not (u8.eq (u8 0x000ff) 255u8))
				(then (return 4i32)))
			(if (bool.not (i32.eq -0x80000000i32 -2147483648i32))
				(then (return 5i32)))
			(if (bool.not (i32.eq (i32 0x7FFFFFFF) 2147483647i32))
				(then (return 6i32)))
			(if (bool.not (i32.eq (i32 -0X000) 0i32))
				(then (return 7i32)))
			(return 42i32))))
