(module ownership_immutable
	;; Read the length through the exclusive slice.
	(fn byte_count
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))
	;; Attempt an exclusive loan from an immutable owner.
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (call byte_count (borrow-mut (local buffer)))))))
