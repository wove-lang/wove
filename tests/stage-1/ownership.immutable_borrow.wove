(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	ownership_immutable
	(fn
		(:doc "Read the length through the exclusive slice.")
		byte_count
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))
	(fn
		(:doc "Attempt an exclusive loan from an immutable owner.")
		main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (call byte_count (borrow-mut (local buffer)))))))
