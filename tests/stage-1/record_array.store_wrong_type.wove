(module record_array_store_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct OtherToken (fields (kind u32)))

	(fn write
		(params (tokens (mut-array Token)))
		(returns void)
		(body
			(array.store tokens (i32 0)
				(struct.new OtherToken (kind (u32 1))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return (i32 0)))))
