(module record_array_store_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct OtherToken (fields (kind u32)))

	(fn write
		(params (tokens (mut-slice Token)))
		(returns void)
		(body
			(slice.store (local tokens) (i32 0)
				(record.make OtherToken (kind (u32 1))))))

	(fn main
		(params)
		(returns i32)
		(body (return (i32 0)))))
