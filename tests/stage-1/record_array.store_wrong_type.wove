(module record_array_store_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct OtherToken (fields (kind u32)))

	(fn write
		(params (tokens (mut-slice Token)))
		(returns void)
		(body
			(slice.store (local tokens) (i32 0)
				(struct.new OtherToken (kind (u32 1))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body (return (i32 0)))))
