(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	wrapping
	(fn
		(:doc "Advance a signed cursor by an offset.")
		advance
		(params (cursor i32) (offset i32))
		(returns i32)
		(body
			(return (i32.add.wrapping (local cursor) (local offset)))))

	(fn
		(:doc "Compute the distance between two signed cursor positions.")
		distance
		(params (end i32) (start i32))
		(returns i32)
		(body
			(return (i32.sub.wrapping (local end) (local start)))))

	(fn
		(:doc "Add two unsigned offsets with 32-bit wraparound.")
		add_unsigned
		(params (left u32) (right u32))
		(returns u32)
		(body
			(return (u32.add.wrapping (local left) (local right)))))

	(fn
		(:doc "Subtract unsigned offsets with 32-bit wraparound.")
		sub_unsigned
		(params (left u32) (right u32))
		(returns u32)
		(body
			(return (u32.sub.wrapping (local left) (local right)))))

	(fn
		(:doc "Advance the cursor in one call and recover the original offset in the next.")
		main
		(params)
		(returns i32)
		(body
			(let start (i32 24))
			(let end (call advance (local start) (i32 18)))
			(return (call distance (local end) (local start))))))
