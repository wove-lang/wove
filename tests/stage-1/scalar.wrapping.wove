(module wrapping
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn advance
		(:doc "Advance a signed cursor by an offset.")
		(params (cursor i32) (offset i32))
		(returns i32)
		(body
			(return (i32.add cursor offset))))

	(fn distance
		(:doc "Compute the distance between two signed cursor positions.")
		(params (end i32) (start i32))
		(returns i32)
		(body
			(return (i32.sub end start))))

	(fn add_unsigned
		(:doc "Add two unsigned offsets with 32-bit wraparound.")
		(params (left u32) (right u32))
		(returns u32)
		(body
			(return (u32.add left right))))

	(fn sub_unsigned
		(:doc "Subtract unsigned offsets with 32-bit wraparound.")
		(params (left u32) (right u32))
		(returns u32)
		(body
			(return (u32.sub left right))))

	(fn main
		(:doc "Advance the cursor in one call and recover the original offset in the next.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let start (i32 24))
			(let end (call advance start (i32 18)))
			(return (call distance end start)))))
