(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Expose the selected bootstrap function and use a helper from this file's import.")
	(:pragma (cfg bootstrap))
	bootstrap_provider
	(use wove-file "../imports/nested/shared.wove" (only base))
	(fn exposed
		(params)
		(returns i32)
		(body (return (i32.add.wrapping (i32 32) (call base)))))
	(fn
		(:pragma (cfg (not bootstrap)))
		exposed
		(params)
		(returns i32)
		(body (return (full.operation)))))
