(module distinct_imported_value
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./types/base.wove" (only (type Item)))
	(use wove-file "./types/other.wove" (only read_item))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body (return (call read_item
			(struct:new Item (value (i32 4))))))))
