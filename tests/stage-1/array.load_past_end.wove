(module load_past_end
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn read_byte
		(:doc "Use a runtime argument as the index of a shared slice read.")
		(params (data (shared-array u8)) (index i32))
		(returns u8)
		(body
			(return (array.load (local data) (local index)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Pass an out-of-bounds index for a three-byte buffer.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (i32.from-u8
					(call read_byte (borrow-shared (local buffer)) (i32 3)))))))
