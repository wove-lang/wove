(module mixed_width
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Unsigned operands must match the operation's width.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (int.convert i32 (u32.sub
						(u8 3)
						(u32 1)))))))
