(module mixed_width
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "Unsigned operands must match the operation's width.")
		(params)
		(returns i32)
		(body
			(return (int.convert i32 (u32.sub.wrapping
						(u8 3)
						(u32 1)))))))
