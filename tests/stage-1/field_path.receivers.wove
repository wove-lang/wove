(module field_path_scalar_receivers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (count i32) (ready bool)))
	(struct Packet (fields (header Header)))

	(fn read_count
		(params (packet (shared-ref Packet)))
		(returns i32)
		(body
			(let count packet/header/count.inc)
			(if (i32:not-eq count (packet/header/count.inc)) (then (return 1i32)))
			(if (i32:not-eq count (i32:inc (struct:get (struct:get packet header) count)))
				(then (return 2i32)))
			(if (packet/header/ready.and (i32:eq (i32:div 1i32 0i32) 0i32))
				(then (return 3i32)))
			(return count)))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let packet (struct:new Packet
				(header (struct:new Header (count 41i32) (ready (bool false))))))
			(if (i32:not-eq (packet/header.get (:doc "Read the original record field.") count) 41i32)
				(then (return 4i32)))
			(return (call read_count (borrow-shared packet))))))
