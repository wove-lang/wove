(module loop_immutable_assignment
	;; A loop cannot update an immutable binding.
	(fn main
		(params)
		(returns i32)
		(body
			(let cursor (i32 0))
			(while (bool true)
				(body
					(set (local cursor) (i32 1))))
			(return (local cursor)))))
