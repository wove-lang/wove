(module loop_immutable_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn main
		(:doc "A loop cannot update an immutable binding.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let cursor (i32 0))
			(while (bool true)
				(body
					(set cursor (i32 1))))
			(return cursor))))
