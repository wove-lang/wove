(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	loop_immutable_assignment
	(fn
		(:doc "A loop cannot update an immutable binding.")
		main
		(params)
		(returns i32)
		(body
			(let cursor (i32 0))
			(while (bool true)
				(body
					(set (local cursor) (i32 1))))
			(return (local cursor)))))
