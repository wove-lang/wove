(module loop_immutable_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "A loop cannot update an immutable binding.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let cursor (i32 0))
			(while (bool true)
				(body
					(set (local cursor) (i32 1))))
			(return (local cursor)))))
