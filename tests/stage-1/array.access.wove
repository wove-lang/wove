(module array_access
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct EntryArgSpan (fields (start i32) (end i32)))

	(fn write
		(params (view (mut-array u8))) (returns i32)
		(body
			(array.store (local view) 0i32 41u8)
			(return (array.len (local view)))))

	(fn narrow
		(params (view (mut-array u8))) (returns i32)
		(body
			(if (i32.lt (array.len (local view)) 2i32)
				(then (return 0i32)))
			(return (call write (borrow-mut (array.range (local view) 1i32 2i32))))))

	(fn inspect
		(params (view (shared-array u8)) (length i32) (first u8)) (returns bool)
		(body
			(if (i32.eq (array.len (local view)) (local length))
				(then (return (u8.eq (array.load (local view) 0i32) (local first)))))
			(return (bool false))))

	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 4i32))
			(array.store (local data) 1i32 17u8)
			(let result (call narrow (borrow-mut (array.range (local data) 1i32 3i32))))
			(if (i32.lt (array.len (local data)) 4i32) (then (return 1i32)))
			(if (u8.eq (array.load (local data) 1i32) 0u8) (then (return 2i32)))
			(if (u8.lt 0u8 (array.load (local data) 3i32)) (then (return 3i32)))
			(if (call inspect (borrow-shared (local data)) 4i32 0u8)
				(then
					(if (call inspect (borrow-shared (array.range (local data) 2i32 4i32)) 2i32 41u8)
						(then (return (i32.add (local result)
							(int.convert i32 (array.load (local data) 2i32))))))))
			(return 4i32))))
