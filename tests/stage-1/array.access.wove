(module array_access
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn write
		(params (view (mut-array u8))) (returns i32)
		(body
			(array.store view 0i32 41u8)
			(return (array.len view))))

	(fn narrow
		(params (view (mut-array u8))) (returns i32)
		(body
			(if (i32.lt (array.len view) 2i32)
				(then (return 0i32)))
			(return (call write (borrow-mut (array.range view 1i32 2i32))))))

	(fn inspect
		(params (view (shared-array u8)) (length i32) (first u8)) (returns bool)
		(body
			(if (i32.eq (array.len view) length)
				(then (return (u8.eq (array.load view 0i32) first))))
			(return (bool false))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array.alloc u8 4i32))
			(array.store data 1i32 17u8)
			(let result (call narrow (borrow-mut (array.range data 1i32 3i32))))
			(if (i32.lt (array.len data) 4i32) (then (return 1i32)))
			(if (u8.eq (array.load data 1i32) 0u8) (then (return 2i32)))
			(if (u8.lt 0u8 (array.load data 3i32)) (then (return 3i32)))
			(if (call inspect (borrow-shared data) 4i32 0u8)
				(then
					(if (call inspect (borrow-shared (array.range data 2i32 4i32)) 2i32 41u8)
						(then (return (i32.add result
							(int.convert i32 (array.load data 2i32))))))))
			(return 4i32))))
