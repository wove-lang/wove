(module local_array_borrow_conflict
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Result (fields (statuses (owned-array i32))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (struct.new Result (statuses (array.alloc i32 1i32))))
			(let statuses (borrow-shared (struct.get result statuses)))
			(let moved (move result))
			(return (array.len statuses))))
)
