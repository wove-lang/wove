(module ignored_locals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn fill (params (bytes (mut-array u8))) (returns i32)
		(body
			(array.store bytes 0i32 42u8)
			(return 0i32)))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut bytes (array.alloc u8 1i32))
			(let ignored (call fill (borrow-mut bytes)))
			(let-mut status (i32.inc ignored))
			(set status 0i32)
			(return (i32.from-u8 (array.load bytes 0i32)))))
)
