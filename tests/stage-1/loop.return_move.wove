(module loop_return_move
	;; Read the current owner's length without transferring it.
	(fn length
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))

	;; Move an outer owner only on a path that returns from the loop body.
	(fn inspect
		(params (enter bool))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(while (local enter)
				(body
					(let received (move (local buffer)))
					(return (call length (borrow-shared (local received))))))
			(return (call length (borrow-shared (local buffer))))))

	;; Verify that the returning path releases the moved allocation exactly once.
	(fn main
		(params)
		(returns i32)
		(body
			(return (call inspect (bool true))))))
