(module loop_return_move
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn length
		(:doc "Read the current owner's length without transferring it.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array:len data))))

	(fn inspect
		(:doc "Move an outer owner only on a path that returns from the loop body.")
		(params (enter bool))
		(returns i32)
		(body
			(let buffer (array:alloc u8 (i32 3)))
			(while enter
				(body
					(let received (move buffer))
					(return (call length (borrow-shared received)))))
			(return (call length (borrow-shared buffer)))))

	(fn main
		(:doc "Verify that the returning path releases the moved allocation exactly once.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(return (call inspect (bool true))))))
