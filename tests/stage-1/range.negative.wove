(module range_negative
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn trap_if_called
		(:doc "If called, the helper traps with a different diagnostic.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(let checked (int:convert u8 (i32 256)))
			(return (i32:add (array:len data) (int:convert i32 checked)))))

	(fn forward
		(:doc "Form the range from dynamic parameters before calling the helper.")
		(params (data (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(return (call trap_if_called
					(borrow-shared (array:range data start end))))))

	(fn main
		(:doc "Supply bounds that do not form a valid half-open range.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array:alloc u8 (i32 3)))
			(return (call forward (borrow-shared buffer) (i32 -1) (i32 2))))))
