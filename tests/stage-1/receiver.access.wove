(module receiver_access
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:extension opaque.len (opaque.get index))

	(let text "W")
	(struct Cell (fields (index i32)))

	(fn byte_at
		(params (array (shared-array u8)) (index i32))
		(returns u8)
		(body (return (array.get (:doc "Read the original parameter view.") index))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut data (array:alloc u8 2i32))
			(data.set 0i32 40u8)
			(let index 0i32)
			(let result (call byte_at (borrow-shared (data.range 0i32 1i32)) index))
			(let-mut rows (array:alloc (owned-array u8) 0i32))
			(let row (array:alloc u8 1i32))
			(rows.push (move row))
			(if (i32:not-eq (rows.len) 1i32) (then (return 5i32)))
			(if (i32:not-eq data.len 2i32) (then (return 1i32)))
			(if (i32:not-eq text.len 1i32) (then (return 2i32)))
			(if (u8:not-eq (text.get 0i32) 87u8) (then (return 3i32)))
			(if (bool true)
				(then
					(let data (struct:new Cell (index 2i32)))
					(return (i32:add (i32:from-u8 result) (data.get index)))))
			(return 4i32))))
