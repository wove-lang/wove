(module record_field_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32) (start i32) (end i32)))

	(fn main
		(params)
		(returns i32)
		(body
			(let token
				(record.make Token
					(kind (u8 40))
					(start (i32 2))
					(end (i32 3))))
			(return (record.get (local token) start)))))
