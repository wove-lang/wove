(module field_path_access
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Header (fields (size i32) (bytes (owned-array u8))))
	(struct Packet (fields (header Header)))

	(fn paint
		(params (bytes (mut-array u8)))
		(returns void)
		(body (bytes.set 0i32 40u8)))

	(fn first
		(params (bytes (shared-array u8)))
		(returns u8)
		(body (return (bytes.get 0i32))))

	(fn main
		(params (args (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut packet (struct:new Packet
				(header (struct:new Header (size 2i32) (bytes (array:alloc u8 1i32))))))
			(call paint (borrow-mut packet/header/bytes))
			(let size packet/header/size)
			(if (i32:not-eq size (struct:get (struct:get packet header) size))
				(then (return 2i32)))
			(return (i32:add size
				(i32:from-u8 (call first (borrow-shared (:extension packet/header/bytes) packet/header/bytes))))))))
