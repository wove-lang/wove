(module import_store
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use wove-file "./modules/import_values.wove" (only (as alphabet digits)))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(array:store digits (i32 0) (u8 0))
			(return (i32 0)))))
