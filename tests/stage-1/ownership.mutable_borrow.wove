(module ownership_mutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn byte_count
		(:doc "Read the length through the exclusive slice.")
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Exercise an exclusive loan from a writable owner.")
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(return (call byte_count (borrow-mut (local buffer)))))))
