(module ownership_mutable
  (fn byte_count
    (params (data (mut-slice u8)))
    (returns i32)
    (body
      (return (slice.len (local data)))))
  (fn main
    (params)
    (returns i32)
    (body
      (let-mut buffer (array.alloc u8 (i32 3)))
      (return (call byte_count (borrow-mut (local buffer)))))))
