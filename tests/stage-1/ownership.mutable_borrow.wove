(module ownership_mutable
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn byte_count
		(:doc "Read the length through the exclusive slice.")
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(return (array.len data))))
	(fn main
		(:doc "Exercise an exclusive loan from a writable owner.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(return (call byte_count (borrow-mut buffer))))))
