	(struct Pair_1 (fields (_value_1 i32)))
	(fn parse_thing (params (_input_1 i32)) (returns i32)
		(body
			(let pair (struct:new Pair_1 (_value_1 _input_1)))
			(return (struct:get pair _value_1))))
	(fn read_a_long_identifier_with_ascii_letters_digits_and_underscores_preserved_42
		(params (input i32)) (returns i32)
		(body (return (call parse_thing input))))
	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut _result 1i32)
			(set _result
				(call read_a_long_identifier_with_ascii_letters_digits_and_underscores_preserved_42 42i32))
			(return _result))))
