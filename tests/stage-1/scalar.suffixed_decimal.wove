(module suffixed_decimal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let max_word 4294967295u32)
	(let min_byte -128i8)

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let min_integer -2147483648i32)
			(let max_byte 000255u8)
			(if
				(bool:not (i32:eq min_integer (i32 -2147483648)))
				(then (return 1i32)))
			(if
				(bool:not (i32:eq 2147483647i32 (i32 2147483647)))
				(then (return 2i32)))
			(if
				(bool:not (i32:eq (int:convert i32 min_byte) -128i32))
				(then (return 3i32)))
			(if
				(bool:not (i32:eq (int:convert i32 127i8) 127i32))
				(then (return 4i32)))
			(if
				(bool:not (u8:eq max_byte (u8 255)))
				(then (return 5i32)))
			(if
				(bool:not (u32:eq max_word (u32 4294967295)))
				(then (return 6i32)))
			(if
				(bool:not (u32:eq -0u32 (u32 0)))
				(then (return 7i32)))
			(return 42i32))))
