(module local_array_borrow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Result (fields (statuses (owned-array i32))))

	(fn first (params (statuses (shared-array i32))) (returns i32)
		(body (return (array.load statuses 0i32))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut stored (array.alloc i32 1i32))
			(array.store stored 0i32 42i32)
			(let result (struct.new Result (statuses (move stored))))
			(let-mut code 0i32)
			(if (bool true)
				(then
					(let statuses (borrow-shared (struct.get result statuses)))
					(set code (call first (borrow-shared statuses)))))
			(let moved (move result))
			(return (i32.add code (i32.dec (array.len (struct.get moved statuses)))))))
)
