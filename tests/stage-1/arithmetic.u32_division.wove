(module seed_u32_division
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn observe (params (trace (mut-array u8)) (expected u8) (next u8) (word u32)) (returns u32)
		(body
			(if (u8:not-eq (array:get trace 0i32) expected) (then (return 1u32)))
			(array:set trace 0i32 next)
			(return word)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut trace (array:alloc u8 1i32))
			(let quotient (u32:div
				(call observe (borrow-mut trace) 0u8 1u8 4294967295u32)
				(call observe (borrow-mut trace) 1u8 2u8 2u32)))
			(let remainder (u32:rem
				(call observe (borrow-mut trace) 2u8 3u8 4294967295u32)
				(call observe (borrow-mut trace) 3u8 4u8 2u32)))
			(if (u32:not-eq quotient 2147483647u32) (then (return 1i32)))
			(if (u32:not-eq remainder 1u32) (then (return 2i32)))
			(if (u8:not-eq (array:get trace 0i32) 4u8) (then (return 3i32)))
			(if (u32:not-eqz (u32:div 1u32 4294967295u32)) (then (return 4i32)))
			(if (u32:not-eq (u32:rem 2147483648u32 4294967295u32) 2147483648u32) (then (return 5i32)))
			(return 42i32))))
