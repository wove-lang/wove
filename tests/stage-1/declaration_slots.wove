(module declaration_slots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Pair (fields (struct (:doc "A field named like a declaration.") i32))
		(:doc "Trailing record metadata."))
	(:doc "A module entry between declarations.")
	(let initial 40i32 (:doc "Trailing binding metadata."))
	(let omitted unknown (:pragma (cfg test)))
	(:opaque (struct (:example) word) (type (:example) word) (let (:example) word))

	(fn increment (params (let (:doc "A parameter named like a binding.") i32))
		(:doc "Function metadata still interleaves with fields.")
		(returns i32)
		(body (return (i32.inc let))))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut cursor initial (:doc "Trailing writable binding metadata."))
			(set cursor (call increment cursor))
			(let value (:doc "Name before its prefix.")
				(struct.new Pair (struct (call increment cursor)))
				(:doc "Trailing metadata belongs to the same binding."))
			(return (struct.get value struct)))))
