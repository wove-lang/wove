(module record_array_store_past_end
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))

	(fn write
		(params (tokens (mut-array Token)) (index i32))
		(returns void)
		(body
			(array.store tokens index (struct.new Token (kind (u32 42))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut tokens (array.alloc Token (i32 2)))
			(call write (borrow-mut tokens) (i32 2))
			(return (i32 0)))))
