(module record_array_store_past_end
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))

	(fn write
		(params (tokens (mut-slice Token)) (index i32))
		(returns void)
		(body
			(slice.store (local tokens) (local index) (record.make Token (kind (u32 42))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut tokens (array.alloc Token (i32 2)))
			(call write (borrow-mut (local tokens)) (i32 2))
			(return (i32 0)))))
