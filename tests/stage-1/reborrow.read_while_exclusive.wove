(module reborrow_read_while_exclusive
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Accept an exclusive view and a separately evaluated byte.")
		(params (data (mut-array u8)) (value u8))
		(returns void)
		(body
			(array.store (local data) (i32 0) (local value))))

	(fn forward
		(:doc "The first argument suspends the parent before evaluating the second.")
		(params (data (mut-array u8)))
		(returns void)
		(body
			(call put
				(borrow-mut (local data))
				(array.load (local data) (i32 0)))))

	(fn main
		(:doc "Supply an exclusive parent view.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(call forward (borrow-mut (local buffer)))
			(return (i32 0)))))
