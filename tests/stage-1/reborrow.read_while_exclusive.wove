(module reborrow_read_while_exclusive
	;; Accept an exclusive view and a separately evaluated byte.
	(fn put
		(params (data (mut-slice u8)) (value u8))
		(returns void)
		(body
			(slice.store (local data) (i32 0) (local value))))

	;; The first argument suspends the parent before evaluating the second.
	(fn forward
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(call put
				(borrow-mut (local data))
				(slice.load (local data) (i32 0)))))

	;; Supply an exclusive parent view.
	(fn main
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(call forward (borrow-mut (local buffer)))
			(return (i32 0)))))
