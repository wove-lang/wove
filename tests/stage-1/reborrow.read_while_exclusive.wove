(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	reborrow_read_while_exclusive
	(fn
		(:doc "Accept an exclusive view and a separately evaluated byte.")
		put
		(params (data (mut-slice u8)) (value u8))
		(returns void)
		(body
			(slice.store (local data) (i32 0) (local value))))

	(fn
		(:doc "The first argument suspends the parent before evaluating the second.")
		forward
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(call put
				(borrow-mut (local data))
				(slice.load (local data) (i32 0)))))

	(fn
		(:doc "Supply an exclusive parent view.")
		main
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(call forward (borrow-mut (local buffer)))
			(return (i32 0)))))
