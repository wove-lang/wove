(module range_exclusive_after_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn inspect
		(:doc "Take two views with different access permissions.")
		(params (first (shared-slice u8)) (second (mut-slice u8)))
		(returns i32)
		(body
			(return (i32.add.wrapping (slice.len (local first)) (slice.len (local second))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "A shared range keeps its loan on the original buffer during later arguments.")
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 3)))
			(return (call inspect
					(borrow-shared (slice.range (local buffer) (i32 1) (i32 2)))
					(borrow-mut (local buffer)))))))
