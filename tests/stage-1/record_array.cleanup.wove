(module record_array_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Slot (fields (byte u8)))

	(fn write
		(params (slots (mut-array Slot)))
		(returns void)
		(body
			(array:store slots (i32 2) (struct:new Slot (byte (u8 17))))))

	(fn read
		(params (slots (shared-array Slot)))
		(returns i32)
		(body
			(return (int:convert i32 (struct:get (array:load slots (i32 2)) byte)))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut original (array:alloc Slot (i32 3)))
			(call write (borrow-mut original))
			(let moved (move original))
			(return (call read (borrow-shared moved))))))
