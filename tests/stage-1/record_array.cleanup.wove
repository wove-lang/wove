(module record_array_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Slot (fields (byte u8)))

	(fn write
		(params (slots (mut-slice Slot)))
		(returns void)
		(body
			(slice.store (local slots) (i32 2) (record.make Slot (byte (u8 17))))))

	(fn read
		(params (slots (shared-slice Slot)))
		(returns i32)
		(body
			(return (int.convert i32 (record.get (slice.load (local slots) (i32 2)) byte)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let-mut original (array.alloc Slot (i32 3)))
			(call write (borrow-mut (local original)))
			(let moved (move (local original)))
			(return (call read (borrow-shared (local moved)))))))
