(module function_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn before
		(:doc "Subtract the second parameter from the first.")
		(params (left i32) (right i32))
		(returns i32)
		(body (return (i32:sub left right))))

	(fn between
		(returns i32)
		(:doc "Subtract the second parameter with the result type written first.")
		(body (return (i32:sub left right)))
		(params (left i32) (right i32)))

	(fn after
		(body (return (i32:sub left right)))
		(returns i32)
		(params (left i32) (right i32))
		(:doc "Subtract the second parameter with the body written first."))

	(fn excluded
		(body (return (call unavailable)))
		(returns i32)
		(params)
		(:pragma (cfg test)))

	(fn main
		(returns i32)
		(params (entry_spans (shared-array (shared-array u8))))
		(body
			(if (bool:not (i32:eq (call before 45i32 3i32) 42i32)) (then (return 1i32)))
			(if (bool:not (i32:eq (call between 45i32 3i32) 42i32)) (then (return 2i32)))
			(return (call after 45i32 3i32)))))
