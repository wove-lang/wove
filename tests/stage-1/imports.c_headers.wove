(module c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use c-header "<stdint.h>" (only unavailable_system_member))
	(use c-header "wove_runtime.h" (only))
	(use wove-file "./imports/c_headers/provider.wove" (only answer))
	(use c-header "<stddef.h>" (only))
	(use c-header "\"./imports/c_headers/project.h\"" (only))
	(use c-header "<stdint.h>" (only))
	(use (:pragma (cfg (not bootstrap))) c-header (opaque bad_header))
	(decls
		(:pragma (cfg (not bootstrap)))
		(use c-header "<inactive.h>" (only)))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body (return (call answer)))))
