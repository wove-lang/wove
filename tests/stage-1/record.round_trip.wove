(module record_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn opening_token
		(:expect bootstrap.copyable_token
			(issue "https://github.com/wove-lang/wove/issues/26"))
		(params (start i32) (end i32))
		(returns Token)
		(body
			(return (struct.new Token
					(end (local end))
					(kind (u32 40))
					(start (local start))))))

	(fn copy_token
		(params (incoming Token))
		(returns Token)
		(body
			(let copy (local incoming))
			(return (local copy))))

	(fn matches_opening
		(params (token Token))
		(returns bool)
		(body
			(return (bool.and
					(u32.eq (struct.get (local token) kind) (u32 40))
					(bool.and
						(i32.eq (struct.get (local token) start) (i32 2))
						(i32.eq (struct.get (local token) end) (i32 3)))))))

	(fn valid_byte
		(params (status ByteStatus))
		(returns bool)
		(body
			(return (bool.and
					(struct.get (local status) valid)
					(u8.eq (struct.get (local status) byte) (u8 255))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let original (call opening_token (i32 2) (i32 3)))
			(let copy (call copy_token (local original)))
			(if (bool.not (call matches_opening (local copy)))
				(then (return (i32 1))))
			(if (bool.not (u32.eq (struct.get (local original) kind) (u32 40)))
				(then (return (i32 2))))
			(let status (struct.new ByteStatus (byte (u8 255)) (valid (bool true))))
			(if (call valid_byte (local status))
				(then (return (i32 0))))
			(return (i32 3))))

	(decls
		(:pragma (cfg bootstrap))
		(struct Token (fields (kind u32) (start i32) (end i32)))
		(struct ByteStatus (fields (valid bool) (byte u8)))))
