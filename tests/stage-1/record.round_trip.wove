(module record_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn opening_token
		(:expect bootstrap.copyable_token
			(issue "https://github.com/wove-lang/wove/issues/26"))
		(params (start i32) (end i32))
		(returns Token)
		(body
			(return (struct.new Token
					(end end)
					(kind (u32 40))
					(start start)))))

	(fn copy_token
		(params (incoming Token))
		(returns Token)
		(body
			(let copy incoming)
			(return copy)))

	(fn matches_opening
		(params (token Token))
		(returns bool)
		(body
			(return (bool.and
					(u32.eq (struct.get token kind) (u32 40))
					(bool.and
						(i32.eq (struct.get token start) (i32 2))
						(i32.eq (struct.get token end) (i32 3)))))))

	(fn valid_byte
		(params (status ByteStatus))
		(returns bool)
		(body
			(return (bool.and
					(struct.get status valid)
					(u8.eq (struct.get status byte) (u8 255))))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let original (call opening_token (i32 2) (i32 3)))
			(let copy (call copy_token original))
			(if (bool.not (call matches_opening copy))
				(then (return (i32 1))))
			(if (bool.not (u32.eq (struct.get original kind) (u32 40)))
				(then (return (i32 2))))
			(let status (struct.new ByteStatus (byte (u8 255)) (valid (bool true))))
			(if (call valid_byte status)
				(then (return (i32 0))))
			(return (i32 3))))

	(decls
		(:pragma (cfg bootstrap))
		(struct Token (fields (kind u32) (start i32) (end i32)))
		(struct ByteStatus (fields (valid bool) (byte u8)))))
