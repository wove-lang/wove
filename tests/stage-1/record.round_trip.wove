(module record_round_trip
	(with-meta
		(meta
			(:expect bootstrap.copyable_token
				(issue "https://github.com/wove-lang/wove/issues/26")))
		(fn opening_token
			(params (start i32) (end i32))
			(returns Token)
			(body
				(return (record.make Token
					(end (local end))
					(kind (u32 40))
					(start (local start)))))))

	(fn copy_token
		(params (incoming Token))
		(returns Token)
		(body
			(let copy (local incoming))
			(return (local copy))))

	(fn matches_opening
		(params (token Token))
		(returns bool)
		(body
			(return (bool.and
				(u32.eq (record.get (local token) kind) (u32 40))
				(bool.and
					(i32.eq (record.get (local token) start) (i32 2))
					(i32.eq (record.get (local token) end) (i32 3)))))))

	(fn valid_byte
		(params (status ByteStatus))
		(returns bool)
		(body
			(return (bool.and
				(record.get (local status) valid)
				(u8.eq (record.get (local status) byte) (u8 255))))))

	(fn main
		(params)
		(returns i32)
		(body
			(let original (call opening_token (i32 2) (i32 3)))
			(let copy (call copy_token (local original)))
			(if (bool.not (call matches_opening (local copy)))
				(then (return (i32 1))))
			(if (bool.not (u32.eq (record.get (local original) kind) (u32 40)))
				(then (return (i32 2))))
			(let status (record.make ByteStatus (byte (u8 255)) (valid (bool true))))
			(if (call valid_byte (local status))
				(then (return (i32 0))))
			(return (i32 3))))

	(with-meta
		(meta (:pragma (cfg bootstrap)))
		(decls
			(struct Token (fields (kind u32) (start i32) (end i32)))
			(struct ByteStatus (fields (valid bool) (byte u8))))))
