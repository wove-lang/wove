	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(bridge c-header `./local.h`
		(:doc `Keep this metadata on the project C bridge.
Preserve this line after rendering.`)
		(:pragma (cfg (os "linux")))
		(fn bridge_next (returns i32) (:doc "Read the next digit.") (params (digit i32)))
		(foreign-schema (placeholder NativeOnly)))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main (params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan))) (returns i32) (body (return (i32 42)))))
