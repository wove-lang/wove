(module driver_integers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(let bytes "ABCD")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let min -9223372036854775808i64)
			(let max 9223372036854775807i64)
			(if (bool.not (i64.eq (i64.add max 1i64) min)) (then (return 1i32)))
			(if (bool.not (i64.eq (i64.sub -1i64 min) max)) (then (return 2i32)))
			(if (bool.not (i64.eq (i64.mul min 2i64) 0i64)) (then (return 3i32)))
			(if (bool.not (u16.eq (u16.from-le-bytes
				(borrow-shared (array.range bytes 0i32 2i32))) 0x4241u16))
				(then (return 4i32)))
			(if (u32.not-eq (u32.from-be-bytes (borrow-shared bytes)) 0x41424344u32)
				(then (return 5i32)))
			(if (bool.or (i32.gt 1i32 1i32) (i32.lez 1i32)) (then (return 6i32)))
			(if (bool.not (bool.and (i32.ge 0i32 0i32) (i32.le 0i32 0i32))) (then (return 7i32)))
			(return (i32.from-i64 (int.convert i64 42u32))))))
