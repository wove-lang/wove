(module import_round_trip
	(with-meta
		(meta (:pragma (cfg bootstrap)))
		(decls
			(use wove-file "./imports/left.wove"
				(only (as choose choose_left) make read_item (as main provider_main)))))
	(use wove-file "./imports/right.wove" (only (as choose choose_right) (as make make_right)))
	(use wove-file "./imports/nested/shared.wove" (only make_shared))
	(use wove-file "./imports/nested/../nested/shared.wove" (only read_shared))
	(with-meta
		(meta (:pragma (cfg (not bootstrap))))
		(use wove-file "./imports/skipped.wove" (only)))
	(with-meta
		(meta (:pragma (cfg bootstrap) (test)))
		(decls (use wove-file "./imports/skipped_test.wove" (only))))
	(struct Item (fields (value i32)))
	(fn adjust (params) (returns i32) (body (return (i32 2))))
	(with-meta
		(meta (:expect bootstrap.file_imports (issue "https://github.com/wove-lang/wove/issues/48")))
		(fn main
			(params)
			(returns i32)
			(body
				(let left (call choose_left (i32 1)))
				(let right (call choose_right (i32 1)))
				(let first (call read_item (call make (i32 3))))
				(let second (record.get (call make_right (i32 4)) right))
				(let shared (call read_shared (call make_shared (i32 5))))
				(let own (record.get (record.make Item (value (call adjust))) value))
				(let selected (i32.add.wrapping (local left) (local right)))
				(let records (i32.add.wrapping (local first) (local second)))
				(let extra (i32.add.wrapping (local own) (call provider_main (i32 5))))
				(return (i32.add.wrapping (local selected)
					(i32.add.wrapping (local records)
						(i32.add.wrapping (local shared) (local extra)))))))))
