(module owned_record_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Job (fields (statuses (owned-array i32)) (environment (owned-array (owned-array u8)))))

	(fn first_byte (params (data (shared-array u8))) (returns i32)
		(body (return (i32:from-u8 (array:get data 0i32)))))

	(fn row_byte (params (rows (shared-array (owned-array u8)))) (returns i32)
		(body (return (call first_byte (borrow-shared (array:get rows 0i32))))))

	(fn job (params) (returns Job)
		(body
			(let-mut statuses (array:alloc i32 1i32))
			(array:set statuses 0i32 39i32)
			(let-mut environment (array:alloc (owned-array u8) 1i32))
			(array:set environment 0i32 (array:alloc u8 1i32))
			(let-mut row (array:alloc u8 1i32))
			(array:set row 0i32 3u8)
			(array:set environment 0i32 (move row))
			(return (struct:new Job (statuses (move statuses)) (environment (move environment))))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let result (call job))
			(return (i32:add (array:get (struct:get result statuses) 0i32)
				(call row_byte (borrow-shared (struct:get result environment))))))))
