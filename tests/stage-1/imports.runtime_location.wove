(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	imported_runtime_location
	(use wove-file "./slice.load_negative.wove" (only read_byte))
	(fn main
		(params)
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (i32.from-u8
					(call read_byte (borrow-shared (local buffer)) (i32 -1)))))))
