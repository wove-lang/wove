(module imported_runtime_location
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./array.load_negative.wove" (only read_byte))
	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(return (i32.from-u8
					(call read_byte (borrow-shared (local buffer)) (i32 -1)))))))
