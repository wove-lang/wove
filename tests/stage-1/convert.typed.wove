(module typed_conversions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn increment (params (data (mut-array u8))) (returns u8)
		(body
			(let next (u8:from-i32 (i32:add (i32:from-u8 (array:get data 0i32)) 1i32)))
			(array:set data 0i32 next)
			(return next)))

	(fn main (params (args (shared-array (shared-array u8)))) (returns i32)
		(body
			(let-mut data (array:alloc u8 1i32))
			(let converted (u32:from-u8 (call increment (borrow-mut data))))
			(if (bool:not (u8:eq (array:get data 0i32) 1u8)) (then (return 1i32)))
			(return (i32:add (i32:from-i8 (i8:from-u32 41u32)) (i32:from-u32 converted))))))
