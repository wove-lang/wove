(module optional_record_owner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct Row (fields (kind u32) (start i32) (end i32)))

	(fn allocate (params (count i32)) (returns (optional (owned-array Row)))
		(body
			(if (i32.eqz count) (then (return (optional.none (owned-array Row)))))
			(return (array.try-alloc Row count))))

	(fn forward (params (count i32)) (returns (optional (owned-array Row)))
		(body
			(let result (call allocate count))
			(if (owner.is-null result) (then (return (move result))))
			(let rows (move (optional.unwrap result)))
			(return (optional.some (move rows)))))

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let empty (call forward 0i32))
			(if (bool.not (owner.is-null empty)) (then (return 1i32)))
			(let failed (call forward -1i32))
			(if (bool.not (owner.is-null failed)) (then (return 2i32)))
			(let present (call forward 2i32))
			(if (owner.is-null present) (then (return 3i32)))
			(let-mut rows (move (optional.unwrap present)))
			(array.store rows 1i32 (struct.new Row (kind 4u32) (start 40i32) (end 42i32)))
			(if (u32.not-eqz (struct.get (array.load rows 0i32) kind)) (then (return 4i32)))
			(return (struct.get (array.load rows 1i32) end)))))
