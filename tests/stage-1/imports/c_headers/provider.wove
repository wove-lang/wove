(module c_header_provider
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(use (:pragma (cfg bootstrap)) c-header `<limits.h>` (only))
	(use c-header "./tree/../project.h" (only))
	(use c-header "project.h" (only unavailable_project_member))
	(use c-header "<stdint.h>" (only))
	(use c-header "./project.h" (opaque (member_selector detail)))
	(use c-header "./tree/leaf/../lookup.h" (only))

	(fn answer
		(params)
		(returns i32)
		(body (return (i32 42)))))
