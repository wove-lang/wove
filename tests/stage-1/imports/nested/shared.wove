(module shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Shared (fields (value i32)))
	(fn base (params) (returns i32) (body (return (i32 10))))
	(fn make_shared
		(params (value i32))
		(returns Shared)
		(body (return (record.make Shared (value (local value))))))
	(fn read_shared
		(params (item Shared))
		(returns i32)
		(body (return (record.get (local item) value)))))
