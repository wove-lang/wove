(module right
	(use wove-file "./nested/../nested/shared.wove" (only base))
	(struct Item (fields (right i32)))
	(fn adjust
		(params (value i32))
		(returns i32)
		(body (return (i32.add.wrapping (local value)
			(i32.add.wrapping (call base) (i32 1))))))
	(fn choose
		(params (value i32))
		(returns i32)
		(body (return (call adjust (local value)))))
	(fn make
		(params (value i32))
		(returns Item)
		(body (return (record.make Item (right (local value)))))))
