(module right
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./nested/../nested/shared.wove" (only base))
	(struct Item (fields (right i32)))
	(fn adjust
		(params (value i32))
		(returns i32)
		(body (return (i32:add value
					(i32:add (call base) (i32 1))))))
	(fn choose
		(params (value i32))
		(returns i32)
		(body (return (call adjust value))))
	(fn make
		(params (value i32))
		(returns Item)
		(body (return (struct:new Item (right value))))))
