(module left
	(use wove-file "./nested/shared.wove" (only base))
	(struct Item (fields (left i32)))
	(fn adjust
		(params (value i32))
		(returns i32)
		(body (return (i32.add.wrapping (local value) (call base)))))
	(fn choose
		(params (value i32))
		(returns i32)
		(body (return (call adjust (local value)))))
	(fn make
		(params (value i32))
		(returns Item)
		(body (return (record.make Item (left (local value))))))
	(fn read_item
		(params (item Item))
		(returns i32)
		(body (return (record.get (local item) left))))
	(fn read_first
		(params (items (shared-slice Item)))
		(returns i32)
		(body (return (call read_item (slice.load (local items) (i32 0))))))
	(fn main
		(params (value i32))
		(returns i32)
		(body (return (local value)))))
