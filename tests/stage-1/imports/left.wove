(module left
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(use wove-file "./nested/shared.wove" (only base))
	(struct Item (fields (left i32)))
	(fn adjust
		(params (value i32))
		(returns i32)
		(body (return (i32.add value (call base)))))
	(fn choose
		(params (value i32))
		(returns i32)
		(body (return (call adjust value))))
	(fn make
		(params (value i32))
		(returns Item)
		(body (return (struct.new Item (left value)))))
	(fn read_item
		(params (item Item))
		(returns i32)
		(body (return (struct.get item left))))
	(fn read_first
		(params (items (shared-array Item)))
		(returns i32)
		(body (return (call read_item (array.load items (i32 0))))))
	(fn main
		(params (value i32))
		(returns i32)
		(body (return value))))
