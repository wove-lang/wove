(module range_endpoint_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn advance
		(:doc "Record the order and count of endpoint evaluations in a separate buffer.")
		(params (state (mut-array u8)) (delta i32))
		(returns i32)
		(body
			(let before (int.convert i32 (array.load state (i32 0))))
			(let after (i32.add before delta))
			(array.store state (i32 0) (int.convert u8 after))
			(return after)))

	(fn length
		(:doc "Read the resulting window length.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array.len data))))

	(fn state_value
		(:doc "Read the final state after both endpoints have been evaluated.")
		(params (state (shared-array u8)))
		(returns i32)
		(body
			(return (int.convert i32 (array.load state (i32 0))))))

	(fn main
		(:doc "The first endpoint must be 1 and the second must be 3.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(let-mut state (array.alloc u8 (i32 1)))
			(let width (call length
					(borrow-shared (array.range buffer
							(call advance (borrow-mut state) (i32 1))
							(call advance (borrow-mut state) (i32 2))))))
			(let final (call state_value (borrow-shared state)))
			(return (i32.add width final)))))
