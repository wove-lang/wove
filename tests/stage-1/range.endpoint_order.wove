(module range_endpoint_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn advance
		(:doc "Record the order and count of endpoint evaluations in a separate buffer.")
		(params (state (mut-array u8)) (delta i32))
		(returns i32)
		(body
			(let before (int.convert i32 (array.load (local state) (i32 0))))
			(let after (i32.add.wrapping (local before) (local delta)))
			(array.store (local state) (i32 0) (int.convert u8 (local after)))
			(return (local after))))

	(fn length
		(:doc "Read the resulting window length.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array.len (local data)))))

	(fn state_value
		(:doc "Read the final state after both endpoints have been evaluated.")
		(params (state (shared-array u8)))
		(returns i32)
		(body
			(return (int.convert i32 (array.load (local state) (i32 0))))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "The first endpoint must be 1 and the second must be 3.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(let-mut state (array.alloc u8 (i32 1)))
			(let width (call length
					(borrow-shared (array.range (local buffer)
							(call advance (borrow-mut (local state)) (i32 1))
							(call advance (borrow-mut (local state)) (i32 2))))))
			(let final (call state_value (borrow-shared (local state))))
			(return (i32.add.wrapping (local width) (local final))))))
