(module metadata_scope
	(fn size
		(params (data (shared-slice u8)))
		(returns i32)
		(body (return (slice.len (local data)))))

	(fn main
		(params)
		(returns i32)
		(body
			(if (bool true)
				(with-meta
					(meta (:doc "The branch opens the scope for the owner."))
					(then
						(with-meta
							(meta (:doc "Keep the owner in the surrounding arm."))
							(let buffer (array.alloc u8 (i32 3))))
						(let length (call size (borrow-shared (local buffer))))
						(with-meta
							(meta (:doc "Return through the arm's cleanup."))
							(return (with-meta (meta (:editor.hint length)) (local length)))))))
			(return (i32 0)))))
