(module metadata_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn size
		(params (data (shared-array u8)))
		(returns i32)
		(body (return (array.len data))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if (bool true)
				(then
					(:doc "The branch opens the scope for the owner.")
					(let
						(:doc "Keep the owner in the surrounding arm.")
						buffer (array.alloc u8 (i32 3)))
					(let length (call size (borrow-shared buffer)))
					(return
						(:doc "Return through the arm's cleanup.")
						(:editor.hint length)
						length)))
			(return (i32 0)))))
