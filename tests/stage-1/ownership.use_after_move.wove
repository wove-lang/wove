(module ownership_slice
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn byte_count
		(:doc "Read the length through a shared borrow.")
		(params (data (shared-slice u8)))
		(returns i32)
		(body
			(return (slice.len (local data)))))
	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Observe the same allocation before and after transferring ownership.") (:expect ownership.buffer_transfer
			(issue "https://github.com/wove-lang/wove/issues/1")
			(tests ownership.transfer ownership.use_after_move))
		(params (entry_bytes (shared-slice u8)) (entry_spans (shared-slice EntryArgSpan)))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(let before (call byte_count (borrow-shared (local buffer))))
			(let received (move (local buffer)))
			(let after (call byte_count (borrow-shared (local buffer))))
			(return (i32.add.wrapping (local before) (local after))))))
