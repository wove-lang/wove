(module ownership_slice
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn byte_count
		(:doc "Read the length through a shared borrow.")
		(params (data (shared-array u8)))
		(returns i32)
		(body
			(return (array.len data))))
	(fn main
		(:doc "Observe the same allocation before and after transferring ownership.") (:expect ownership.buffer_transfer
			(issue "https://github.com/wove-lang/wove/issues/1")
			(tests ownership.transfer ownership.use_after_move))
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array.alloc u8 (i32 3)))
			(let before (call byte_count (borrow-shared buffer)))
			(let received (move buffer))
			(let after (call byte_count (borrow-shared buffer)))
			(return (i32.add before after)))))
