(module store_shared
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn write_byte
		(:doc "Reject a write through a read-only byte slice.")
		(params (data (shared-array u8)) (index i32) (value u8))
		(returns void)
		(body
			(array:store data index value)))

	(fn main
		(:doc "Call the invalid writer with a shared loan.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let buffer (array:alloc u8 (i32 3)))
			(call write_byte (borrow-shared buffer) (i32 1) (u8 42))
			(return (i32 0)))))
