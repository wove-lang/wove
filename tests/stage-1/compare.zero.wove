(module zero_predicates
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn advance (params (data (mut-array u8))) (returns u8)
		(body
			(let previous (i32.from-u8 (array.load (local data) 0i32)))
			(let next (u8.from-i32 (i32.add (local previous) 1i32)))
			(array.store (local data) 0i32 (local next))
			(return (local next))))

	(struct ArgSpan (fields (start i32) (end i32)))
	(fn main (params (argv (shared-array u8)) (args (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut data (array.alloc u8 1i32))
			(if (bool.and
				(u8.ltz (call advance (borrow-mut (local data))))
				(u8.not-ltz (call advance (borrow-mut (local data)))))
				(then (return 1i32)))
			(if (u8.not-eq (array.load (local data) 0i32) 1u8) (then (return 2i32)))
			(if (bool.not (bool.or
				(u8.not-ltz (call advance (borrow-mut (local data))))
				(u8.ltz (call advance (borrow-mut (local data))))))
				(then (return 3i32)))
			(if (u8.not-eq (array.load (local data) 0i32) 2u8) (then (return 4i32)))
			(if (bool.not (bool.and (i32.ltz -1i32) (i32.not-gtz -1i32)))
				(then (return 5i32)))
			(if (bool.not (bool.and (i32.gtz 1i32) (i32.not-ltz 0i32)))
				(then (return 6i32)))
			(if (bool.and (u32.eqz 0u32) (bool.and (u32.not-eqz 4294967295u32) (u32.gtz 4294967295u32)))
				(then (return 42i32)))
			(return 7i32))))
