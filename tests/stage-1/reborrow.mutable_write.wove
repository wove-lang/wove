(module reborrow_mutable_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Write a byte through the forwarded exclusive view.")
		(params (data (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local data) (i32 0) (u8 42))))

	(fn read
		(:doc "Read through a shared view of the same storage.")
		(params (data (shared-slice u8)))
		(returns u8)
		(body
			(return (slice.load (local data) (i32 0)))))

	(fn update
		(:doc "Use the parent after each helper returns, then update the original byte.")
		(params (data (mut-slice u8)))
		(returns i32)
		(body
			(call put (borrow-mut (local data)))
			(let direct (slice.load (local data) (i32 0)))
			(let forwarded (call read (borrow-shared (local data))))
			(slice.store (local data) (i32 0) (u8 43))
			(return (i32.add.wrapping
					(int.convert i32 (local direct))
					(int.convert i32 (local forwarded))))))

	(fn main
		(:doc "Read the change through the owner after the enclosing exclusive loan ends.")
		(params)
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(let total (call update (borrow-mut (local buffer))))
			(let final (call read (borrow-shared (local buffer))))
			(return (i32.add.wrapping (local total) (int.convert i32 (local final)))))))
