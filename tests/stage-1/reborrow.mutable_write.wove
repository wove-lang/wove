(module reborrow_mutable_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn put
		(:doc "Write a byte through the forwarded exclusive view.")
		(params (data (mut-array u8)))
		(returns void)
		(body
			(array.store data (i32 0) (u8 42))))

	(fn read
		(:doc "Read through a shared view of the same storage.")
		(params (data (shared-array u8)))
		(returns u8)
		(body
			(return (array.load data (i32 0)))))

	(fn update
		(:doc "Use the parent after each helper returns, then update the original byte.")
		(params (data (mut-array u8)))
		(returns i32)
		(body
			(call put (borrow-mut data))
			(let direct (array.load data (i32 0)))
			(let forwarded (call read (borrow-shared data)))
			(array.store data (i32 0) (u8 43))
			(return (i32.add
					(int.convert i32 direct)
					(int.convert i32 forwarded)))))

	(fn main
		(:doc "Read the change through the owner after the enclosing exclusive loan ends.")
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let-mut buffer (array.alloc u8 (i32 1)))
			(let total (call update (borrow-mut buffer)))
			(let final (call read (borrow-shared buffer)))
			(return (i32.add total (int.convert i32 final))))))
