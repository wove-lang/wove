(module scalar_round_trip
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(fn echo_u8
		(:doc "Preserve the u8 parameter through a local binding and return.")
		(params (incoming u8))
		(returns u8)
		(body
			(let value (local incoming))
			(return (local value))))

	(fn u8_min
		(:doc "Pass the u8 min boundary through the Wove call.")
		(params)
		(returns u8)
		(body
			(let value (u8 0))
			(let result (call echo_u8 (local value)))
			(return (local result))))

	(fn u8_max
		(:doc "Pass the u8 max boundary through the Wove call.")
		(params)
		(returns u8)
		(body
			(let value (u8 255))
			(let result (call echo_u8 (local value)))
			(return (local result))))

	(fn echo_i32
		(:doc "Preserve the i32 parameter through a local binding and return.")
		(params (incoming i32))
		(returns i32)
		(body
			(let value (local incoming))
			(return (local value))))

	(fn i32_min
		(:doc "Pass the i32 min boundary through the Wove call.")
		(params)
		(returns i32)
		(body
			(let value (i32 -2147483648))
			(let result (call echo_i32 (local value)))
			(return (local result))))

	(fn i32_max
		(:doc "Pass the i32 max boundary through the Wove call.")
		(params)
		(returns i32)
		(body
			(let value (i32 2147483647))
			(let result (call echo_i32 (local value)))
			(return (local result))))

	(fn echo_u32
		(:doc "Preserve the u32 parameter through a local binding and return.")
		(params (incoming u32))
		(returns u32)
		(body
			(let value (local incoming))
			(return (local value))))

	(fn u32_min
		(:doc "Pass the u32 min boundary through the Wove call.")
		(params)
		(returns u32)
		(body
			(let value (u32 0))
			(let result (call echo_u32 (local value)))
			(return (local result))))

	(fn u32_max
		(:doc "Pass the u32 max boundary through the Wove call.")
		(params)
		(returns u32)
		(body
			(let value (u32 4294967295))
			(let result (call echo_u32 (local value)))
			(return (local result))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(:doc "Provide the seed entry point for the host probe to call after the checks.")
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(return (i32 0)))))
