(module scalar_round_trip
	;; Preserve the u8 parameter through a local binding and return.
	(fn echo_u8
		(params (incoming u8))
		(returns u8)
		(body
			(let value (local incoming))
			(return (local value))))

	;; Pass the u8 min boundary through the Wove call.
	(fn u8_min
		(params)
		(returns u8)
		(body
			(let value (u8 0))
			(let result (call echo_u8 (local value)))
			(return (local result))))

	;; Pass the u8 max boundary through the Wove call.
	(fn u8_max
		(params)
		(returns u8)
		(body
			(let value (u8 255))
			(let result (call echo_u8 (local value)))
			(return (local result))))

	;; Preserve the i32 parameter through a local binding and return.
	(fn echo_i32
		(params (incoming i32))
		(returns i32)
		(body
			(let value (local incoming))
			(return (local value))))

	;; Pass the i32 min boundary through the Wove call.
	(fn i32_min
		(params)
		(returns i32)
		(body
			(let value (i32 -2147483648))
			(let result (call echo_i32 (local value)))
			(return (local result))))

	;; Pass the i32 max boundary through the Wove call.
	(fn i32_max
		(params)
		(returns i32)
		(body
			(let value (i32 2147483647))
			(let result (call echo_i32 (local value)))
			(return (local result))))

	;; Preserve the u32 parameter through a local binding and return.
	(fn echo_u32
		(params (incoming u32))
		(returns u32)
		(body
			(let value (local incoming))
			(return (local value))))

	;; Pass the u32 min boundary through the Wove call.
	(fn u32_min
		(params)
		(returns u32)
		(body
			(let value (u32 0))
			(let result (call echo_u32 (local value)))
			(return (local result))))

	;; Pass the u32 max boundary through the Wove call.
	(fn u32_max
		(params)
		(returns u32)
		(body
			(let value (u32 4294967295))
			(let result (call echo_u32 (local value)))
			(return (local result))))

	;; Provide the seed entry point for the host probe to call after the checks.
	(fn main
		(params)
		(returns i32)
		(body
			(return (i32 0)))))
