(module optional_use_after_unwrap
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(fn main (params (argv (shared-array (shared-array u8)))) (returns i32)
		(body
			(let allocated (array:try-alloc u8 3i32))
			(let bytes (move (optional:unwrap allocated)))
			(if (owner:is-null allocated) (then (return 1i32)))
			(return (array:len bytes)))))
