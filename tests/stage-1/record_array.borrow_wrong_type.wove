(module record_array_borrow_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct OtherToken (fields (kind u32)))

	(fn size
		(params (tokens (shared-array OtherToken)))
		(returns i32)
		(body (return (array:len tokens))))

	(fn main
		(params (entry_spans (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let tokens (array:alloc Token (i32 2)))
			(return (call size (borrow-shared tokens))))))
