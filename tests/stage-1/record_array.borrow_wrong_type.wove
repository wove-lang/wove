(module record_array_borrow_wrong_type
	(struct Token (fields (kind u32)))
	(struct OtherToken (fields (kind u32)))

	(fn size
		(params (tokens (shared-slice OtherToken)))
		(returns i32)
		(body (return (slice.len (local tokens)))))

	(fn main
		(params)
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call size (borrow-shared (local tokens)))))))
