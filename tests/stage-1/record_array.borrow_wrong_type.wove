(module record_array_borrow_wrong_type
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(struct Token (fields (kind u32)))
	(struct OtherToken (fields (kind u32)))

	(fn size
		(params (tokens (shared-array OtherToken)))
		(returns i32)
		(body (return (array.len (local tokens)))))

	(struct EntryArgSpan (fields (start i32) (end i32)))
	(fn main
		(params (entry_bytes (shared-array u8)) (entry_spans (shared-array EntryArgSpan)))
		(returns i32)
		(body
			(let tokens (array.alloc Token (i32 2)))
			(return (call size (borrow-shared (local tokens)))))))
