(module cfg_inactive_body
	(fn main
		(params)
		(returns i32)
		(body (return (i32 3))))

	(with-meta
		(meta (:pragma (cfg (not bootstrap))))
		(decls
			(fn full_mode
				(params)
				(returns i32)
				(body (return (full-only.operation)))))))
