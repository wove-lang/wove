(module gcc_plugin_build
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Discover plugin headers from the selected GCC and build a loadable inspector for that host.")

	(use wove-file "../c/probe.wove" (only (type ProbeRun) probe_run_at))
	(use wove-file "../io/process.wove" (only run_process_capture))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use c-header "<sys/stat.h>" (only lstat S_ISREG (type Stat)))

	(let unresolved "plugin")
	(let discovery "-print-file-name=plugin\u0000")
	(let flags "-std=c++11\u0000-O2\u0000-fPIC\u0000-fno-rtti\u0000-fno-exceptions\u0000")
	(let library (:pragma (cfg (os "macos"))) "-bundle\u0000-Wl,-undefined,dynamic_lookup\u0000")
	(let library (:pragma (cfg (not (os "macos")))) "-shared\u0000")
	(let tail "-lstdc++\u0000")
	(let include_flag "-I")
	(let output_flag "-o\u0000")

	(fn append_argument
		(:doc "Copy an argument verbatim and add its packed argv terminator.")
		(params (text (shared-array u8)) (output (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(let end (call append_bytes (borrow-shared (local text)) (borrow-mut (local output)) (local offset)))
			(array.store (local output) (local end) 0u8)
			(return (i32.add (local end) 1i32))))

	(fn line_end
		(:doc "Identify GCC's LF or CRLF path record delimiters.")
		(params (byte u8))
		(returns bool)
		(body (return (bool.or (u8.eq (local byte) 10u8) (u8.eq (local byte) 13u8)))))

	(fn path_length
		(:doc "Accept one resolved directory path from GCC, including a path relative to the working directory.")
		(params (text (shared-array u8)))
		(returns i32)
		(body
			(let-mut end (array.len (local text)))
			(while
				(:doc "Remove trailing LF or CRLF without admitting an empty record.")
				(bool.and (i32.lt 0i32 (local end))
					(call line_end (array.load (local text) (i32.sub (local end) 1i32))))
				(body (set (local end) (i32.sub (local end) 1i32))))
			(if
				(:doc "An unresolved plugin directory is printed as the bare word plugin.")
				(bool.or (i32.eq (local end) 0i32)
					(call same_bytes (borrow-shared (local text)) 0i32 (local end)
						(borrow-shared (local unresolved)) 0i32 (array.len (local unresolved))))
				(then (return -1i32)))
			(let-mut at 0i32)
			(while
				(:doc "Reject multiple stdout records and bytes that would terminate a native argument.")
				(i32.lt (local at) (local end))
				(body
					(let byte (array.load (local text) (local at)))
					(if
						(:doc "Only bytes within the single path record become an include argument.")
						(bool.or (u8.eq (local byte) 0u8) (call line_end (local byte)))
						(then (return -1i32)))
					(set (local at) (i32.add (local at) 1i32))))
			(return (local end))))

	(fn gcc_plugin_directory
		(:doc "Return the occupied prefix of the captured plugin directory path or a discovery failure.")
		(params (program (shared-array u8)) (output (mut-array u8)))
		(returns ProbeRun)
		(body
			(let captured (call run_process_capture (borrow-shared (local program)) (borrow-shared (local discovery))
				(borrow-mut (local output))))
			(let status (struct.get (local captured) status))
			(let length (struct.get (local captured) length))
			(if
				(:doc "A failed tool or incomplete stdout cannot identify installed plugin headers.")
				(bool.or (bool.not (i32.eq (local status) 0i32)) (struct.get (local captured) overflow))
				(then (return (call probe_run_at 8u32 (local status) 0i32))))
			(return (call checked_plugin_directory (borrow-shared (local output)) (local length)))))

	(fn checked_plugin_directory
		(:doc "Check the reported prefix and keep exactly the path length.")
		(params (output (shared-array u8)) (length i32))
		(returns ProbeRun)
		(body
			(let width (call path_length (borrow-shared (array.range (local output) 0i32 (local length)))))
			(if
				(:doc "A successful GCC process can still report an unresolved or malformed path.")
				(i32.lt (local width) 0i32)
				(then (return (call probe_run_at 8u32 0i32 0i32))))
			(return (call probe_run_at 0u32 0i32 (local width)))))

	(fn plugin_file_ready
		(:doc "Only load a nonempty regular object built inside the private query workspace.")
		(params (path (shared-array u8)))
		(returns bool)
		(body
			(let-mut info (struct.new Stat))
			(return (bool.and (i32.eq (call lstat (borrow-shared (local path)) (borrow-mut (local info))) 0i32)
				(bool.and (call S_ISREG (struct.get (local info) st_mode))
					(u64.lt 0u64 (int.convert u64 (struct.get (local info) st_size))))))))

	(fn build_gcc_plugin
		(:doc "Use the selected GCC's C++ frontend and default host flags to build the matching shared object.")
		(params (program (shared-array u8)) (include (shared-array u8))
			(source (shared-array u8)) (output (shared-array u8)))
		(returns ProbeRun)
		(body
			(let fixed (i32.add 3i32 (i32.add (array.len (local flags))
				(i32.add (array.len (local library)) (i32.add (array.len (local tail))
					(i32.add (array.len (local include_flag)) (array.len (local output_flag))))))))
			(let size (u64.add (int.convert u64 (local fixed))
				(u64.add (int.convert u64 (array.len (local include)))
					(u64.add (int.convert u64 (array.len (local source))) (int.convert u64 (array.len (local output)))))))
			(if
				(:doc "The complete argument vector must fit the signed slice length.")
				(u64.lt 2147483647u64 (local size))
				(then (return (call probe_run_at 9u32 -1i32 0i32))))
			(let-mut arguments (array.alloc u8 (int.convert i32 (local size))))
			(let first (call append_bytes (borrow-shared (local flags)) (borrow-mut (local arguments)) 0i32))
			(let link (call append_bytes (borrow-shared (local library)) (borrow-mut (local arguments)) (local first)))
			(let include_start (call append_bytes (borrow-shared (local include_flag)) (borrow-mut (local arguments)) (local link)))
			(let include_end (call append_argument (borrow-shared (local include)) (borrow-mut (local arguments)) (local include_start)))
			(let source_end (call append_argument (borrow-shared (local source)) (borrow-mut (local arguments)) (local include_end)))
			(let output_start (call append_bytes (borrow-shared (local output_flag)) (borrow-mut (local arguments)) (local source_end)))
			(let output_end (call append_argument (borrow-shared (local output)) (borrow-mut (local arguments)) (local output_start)))
			(let end (call append_bytes (borrow-shared (local tail)) (borrow-mut (local arguments)) (local output_end)))
			(let-mut discard (array.alloc u8 0i32))
			(let built (call run_process_capture (borrow-shared (local program)) (borrow-shared (local arguments))
				(borrow-mut (local discard))))
			(let status (struct.get (local built) status))
			(if
				(:doc "A successful exit without a usable output file is also a plugin build failure.")
				(bool.not (bool.and (i32.eq (local status) 0i32) (call plugin_file_ready (borrow-shared (local output)))))
				(then (return (call probe_run_at 9u32 (local status) 0i32))))
			(return (call probe_run_at 0u32 (local status) 0i32)))))
