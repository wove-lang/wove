(module byte_spans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compare spans and append bounded bytes in caller-provided views.`)

	(fn is_byte_at
		(:doc `Compare one byte at a checked offset relative to a span's start.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (start i32) (offset i32) (byte u8))
		(returns bool)
		(body
			(return (u8.eq
					(slice.load (local source) (i32.add.wrapping (local start) (local offset)))
					(local byte)))))

	(fn is_three_bytes
		(:doc `Compare three consecutive bytes inside a checked span.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (start i32) (first u8) (second u8) (third u8))
		(returns bool)
		(body
			(return (bool.and
					(call is_byte_at (borrow-shared (local source)) (local start) (i32 0) (local first))
					(bool.and
						(call is_byte_at (borrow-shared (local source)) (local start) (i32 1) (local second))
						(call is_byte_at (borrow-shared (local source)) (local start) (i32 2) (local third)))))))

	(fn same_bytes
		(:doc `Compare raw byte spans in their original views.`)
		(params (left (shared-slice u8)) (start i32) (end i32) (right (shared-slice u8))
			(other_start i32) (other_end i32))
		(returns bool)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "A length mismatch rules out equality without reading either view.")
				(bool.not (i32.eq (local width) (i32.sub.wrapping (local other_end) (local other_start))))
				(then (return (bool false))))
			(let-mut index (i32 0))
			(while
				(:doc "Read each pair of bytes inside the two known spans.")
				(i32.lt (local index) (local width))
				(body
					(if
						(:doc "The first differing byte rules out a match.")
						(bool.not (u8.eq
							(slice.load (local left) (i32.add.wrapping (local start) (local index)))
							(slice.load (local right) (i32.add.wrapping (local other_start) (local index)))))
						(then (return (bool false))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (bool true))))

	(fn write_byte
		(:doc "Append a byte at the cursor or return -1 when capacity is exhausted.")
		(params (output (mut-slice u8)) (offset i32) (byte u8))
		(returns i32)
		(body
			(if
				(:doc "A failed cursor remains failed and full output stays within bounds.")
				(bool.or (i32.lt (local offset) (i32 0))
					(bool.not (i32.lt (local offset) (slice.len (local output)))))
				(then (return (i32 -1))))
			(slice.store (local output) (local offset) (local byte))
			(return (i32.add.wrapping (local offset) (i32 1))))))
