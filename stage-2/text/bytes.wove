(module byte_spans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compare spans and append bounded bytes in caller-provided views.`)

	(fn same_bytes
		(:doc `Compare raw byte spans in their original views.`)
		(params (left (shared-array u8)) (start i32) (end i32) (right (shared-array u8))
			(other_start i32) (other_end i32))
		(returns bool)
		(body
			(let width (i32.sub (local end) (local start)))
			(if
				(:doc "A length mismatch rules out equality without reading either view.")
				(i32.not-eq (local width) (i32.sub (local other_end) (local other_start)))
				(then (return (bool false))))
			(let-mut index 0i32)
			(while
				(:doc "Read each pair of bytes inside the two known spans.")
				(i32.lt (local index) (local width))
				(body
					(if
						(:doc "The first differing byte rules out a match.")
						(u8.not-eq
							(array.load (local left) (i32.add (local start) (local index)))
							(array.load (local right) (i32.add (local other_start) (local index))))
						(then (return (bool false))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (bool true))))

	(fn write_byte
		(:doc "Append a byte at the cursor or return -1 when capacity is exhausted.")
		(params (output (mut-array u8)) (offset i32) (byte u8))
		(returns i32)
		(body
			(if
				(:doc "A failed cursor remains failed and full output stays within bounds.")
				(bool.or (i32.ltz (local offset))
					(i32.not-lt (local offset) (array.len (local output))))
				(then (return -1i32)))
			(array.store (local output) (local offset) (local byte))
			(return (i32.add (local offset) 1i32)))))
