(module decimal_256
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Append full-width decimal integers on targets with native C23 256-bit values.")

	(use wove-file "./bytes.wove" (only write_byte))

	(fn write_decimal_u256
		(:doc "Append the unsigned value, keeping a fitting prefix and returning -1 when the view ends.")
		(:expect (tests "stage-2/cli/native/int256/supported.tsv") (issues "gh:wove-lang/wove:234" "gh:wove-lang/wove:346"))
		(params (output (mut-array u8)) (offset i32) (value u256)) (returns i32)
		(body
			(if
				(:doc "A cursor outside the writable view cannot publish any digits.")
				(bool.or (i32.ltz offset) (i32.not-lt offset (array.len output)))
				(then (return -1i32)))
			(let-mut reversed (array.repeat (array u8 78) 0u8))
			(let-mut remaining value)
			(let-mut used 0i32)
			(while
				(:doc "Extract at most 78 digits in reverse order, including the single digit for zero.")
				(bool true)
				(body
					(let quotient (u256.div remaining 10u256))
					(let digit (u256.sub remaining (u256.mul quotient 10u256)))
					(array.store reversed used (u8.from-u256 (u256.add digit 48u256)))
					(set remaining quotient)
					(set used (i32.inc used))
					(if (u256.eqz remaining) (then (break)))))
			(let-mut next offset)
			(while
				(:doc "Write the most significant remaining digit until the output is complete or full.")
				(bool.and (i32.gtz used) (i32.not-ltz next))
				(body
					(set used (i32.dec used))
					(set next (call write_byte (borrow-mut output) next
						(array.load reversed used)))))
			(return next)))

	(fn write_decimal_i256
		(:doc "Append the signed value, including the sign in the fitting prefix of a negative value.")
		(params (output (mut-array u8)) (offset i32) (value i256)) (returns i32)
		(body
			(if
				(:doc "Subtracting from -1 fits even at the minimum. Restore the final unit in the unsigned magnitude.")
				(i256.ltz value)
				(then
					(let next (call write_byte (borrow-mut output) offset 45u8))
					(if (i32.ltz next) (then (return -1i32)))
					(let base (u256.from-i256 (i256.sub -1i256 value)))
					(return (call write_decimal_u256 (borrow-mut output) next (u256.inc base)))))
			(return (call write_decimal_u256 (borrow-mut output) offset (u256.from-i256 value)))))
)
