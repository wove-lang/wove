(module decimal_writer
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write decimal integers into caller-provided byte views.

	Format signed and unsigned 32-bit values from the highest decimal
	place to the lowest. Keep each append inside the supplied view.`)

	(use wove-file "./bytes.wove" (only write_byte))

	(struct DecimalPlace (fields (offset i32) (remainder u32) (started bool)))

	(fn write_decimal_place
		(:doc "Extract one decimal digit by at most nine subtractions and suppress leading zeroes.")
		(params (output (mut-array u8)) (state DecimalPlace) (place u32))
		(returns DecimalPlace)
		(body
			(let-mut rest (struct.get (local state) remainder))
			(let-mut digit 0u32)
			(while
				(:doc "After this place, the remainder is smaller than its weight.")
				(u32.not-lt (local rest) (local place))
				(body
					(set (local rest) (u32.sub (local rest) (local place)))
					(set (local digit) (u32.add (local digit) 1u32))))
			(let-mut next (struct.get (local state) offset))
			(let started (bool.or (struct.get (local state) started)
				(bool.or (u32.not-eqz (local digit)) (u32.eq (local place) 1u32))))
			(if
				(:doc "The ones place emits even when the whole number is zero.")
				(local started)
				(then
					(set (local next) (call write_byte (borrow-mut (local output)) (local next)
						(u8.from-u32 (u32.add (local digit) 48u32))))))
			(return (struct.new DecimalPlace (offset (local next)) (remainder (local rest)) (started (local started))))))

	(fn write_decimal_u32
		(:doc `Append an unsigned 32-bit integer in decimal and return the next offset.

		Skip leading zeroes and leave the result unterminated. Return -1
		when space runs out, preserving any prefix already written.`)
		(params (output (mut-array u8)) (offset i32) (value u32))
		(returns i32)
		(body
			(let place_10 (struct.new DecimalPlace (offset (local offset)) (remainder (local value)) (started (bool false))))
			(let place_9 (call write_decimal_place (borrow-mut (local output)) (local place_10) 1000000000u32))
			(let place_8 (call write_decimal_place (borrow-mut (local output)) (local place_9) 100000000u32))
			(let place_7 (call write_decimal_place (borrow-mut (local output)) (local place_8) 10000000u32))
			(let place_6 (call write_decimal_place (borrow-mut (local output)) (local place_7) 1000000u32))
			(let place_5 (call write_decimal_place (borrow-mut (local output)) (local place_6) 100000u32))
			(let place_4 (call write_decimal_place (borrow-mut (local output)) (local place_5) 10000u32))
			(let place_3 (call write_decimal_place (borrow-mut (local output)) (local place_4) 1000u32))
			(let place_2 (call write_decimal_place (borrow-mut (local output)) (local place_3) 100u32))
			(let place_1 (call write_decimal_place (borrow-mut (local output)) (local place_2) 10u32))
			(let place_0 (call write_decimal_place (borrow-mut (local output)) (local place_1) 1u32))
			(return (struct.get (local place_0) offset))))

	(fn write_decimal_i32
		(:doc `Append a signed 32-bit integer, including the minimum value.

		Use the same cursor and capacity rules as write_decimal_u32.`)
		(params (output (mut-array u8)) (offset i32) (value i32))
		(returns i32)
		(body
			(if
				(:doc "Add the last unit in u32 so the minimum signed magnitude fits.")
				(i32.ltz (local value))
				(then
					(let next (call write_byte (borrow-mut (local output)) (local offset) 45u8))
					(let magnitude (u32.add (u32.from-i32 (i32.sub -1i32 (local value))) 1u32))
					(return (call write_decimal_u32 (borrow-mut (local output)) (local next) (local magnitude)))))
			(return (call write_decimal_u32 (borrow-mut (local output)) (local offset) (u32.from-i32 (local value)))))))
