(module boolean_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode exact Boolean spellings from a checked byte span.")

	(fn read_boolean_word
		(:doc "Return 1 for true, 0 for false, and -1 for every other spelling.")
		(params (bytes (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let width (i32.sub end start))
			(if
				(:doc "Only four bytes can spell true.")
				(bool.and (i32.eq width 4i32)
					(bool.and (u8.eq (array.load bytes start) 116u8)
						(bool.and (u8.eq (array.load bytes (i32.inc start)) 114u8)
							(bool.and (u8.eq (array.load bytes (i32.add start 2i32)) 117u8)
								(u8.eq (array.load bytes (i32.add start 3i32)) 101u8)))))
				(then (return 1i32)))
			(if
				(:doc "Only five bytes can spell false.")
				(bool.and (i32.eq width 5i32)
					(bool.and (u8.eq (array.load bytes start) 102u8)
						(bool.and (u8.eq (array.load bytes (i32.inc start)) 97u8)
							(bool.and (u8.eq (array.load bytes (i32.add start 2i32)) 108u8)
								(bool.and (u8.eq (array.load bytes (i32.add start 3i32)) 115u8)
									(u8.eq (array.load bytes (i32.add start 4i32)) 101u8))))))
				(then (return 0i32)))
			(return -1i32))))
