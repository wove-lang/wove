(module double_quoted
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Scan and decode double-quoted strings in an admitted UTF-8 byte view.

	Pass the byte offset of the opening quote to scan_double_quoted. A
	successful result includes both delimiters in its half-open span and
	can be passed to the scalar validator or decoder with the same source.

	Scan errors are 1 unterminated string, 2 malformed escape, and 3 literal
	control byte. Scalar validation and decoding report error 4 at an
	unpaired surrogate. Decoding also reports error 5 at the first scalar
	that exceeds the supplied output. The written prefix ends on a scalar
	boundary. Zero indicates success in all three operations.`)

	(use wove-file "./hex.wove" (only hex_digit_value))
	(use wove-file "./utf8.wove" (only utf8_width copy_utf8_scalar))

	(struct QuotedSpan (fields (start i32) (end i32) (error u32)))
	(struct QuotedUnit (fields (end i32) (scalar i32) (error u32)))
	(struct QuotedDecodeResult (fields (written i32) (start i32) (end i32) (error u32)))

	(fn is_short_escape
		(:doc `Recognize JSON short escapes and the optional Wove NUL escape.`)
		(:pragma (inline always))
		(params (byte u8) (allow_nul bool))
		(returns bool)
		(body
			(if (u8.eq byte 48u8) (then (return allow_nul)))
			(return
				(:doc "Accept escaped punctuation and the five named control characters.")
				(bool.or
					(bool.or
						(u8.eq byte 34u8)
						(bool.or (u8.eq byte 92u8) (u8.eq byte 47u8)))
					(bool.or
						(bool.or (u8.eq byte 98u8) (u8.eq byte 102u8))
						(bool.or
							(u8.eq byte 110u8)
							(bool.or (u8.eq byte 114u8) (u8.eq byte 116u8))))))))

	(fn quoted_span
		(:doc "Keep a quoted string's original span or the extent of a scanning error.")
		(params (error u32) (start i32) (end i32))
		(returns QuotedSpan)
		(body
			(return (struct.new QuotedSpan (start start) (end end) (error error)))))

	(fn scan_double_quoted
		(:doc `Validate quoted bytes and preserve their spelling. Wove enables the NUL escape.`)
		(params (source (shared-array u8)) (start i32) (allow_nul bool))
		(returns QuotedSpan)
		(body
			(let length (array.len source))
			(let-mut cursor (i32.inc start))
			(while
				(:doc "Read only bytes inside the supplied view, including while scanning escapes.")
				(i32.lt cursor length)
				(body
					(let byte (array.load source cursor))
					(set cursor (i32.inc cursor))
					(if
						(:doc "An unescaped quote completes the span just after the closing byte.")
						(u8.eq byte 34u8)
						(then
							(return (call quoted_span 0u32 start cursor))))
					(if
						(:doc "Raw ASCII control bytes end the error span just after the offending byte.")
						(u8.lt byte 32u8)
						(then (return (call quoted_span 3u32 start cursor))))
					(if
						(:doc "A backslash consumes its escape bytes before the next quote check.")
						(u8.eq byte 92u8)
						(then
							(if
								(:doc "A trailing backslash reaches the view end without an escape byte.")
								(i32.eq cursor length)
								(then (return (call quoted_span 2u32 start length))))
							(let escape (array.load source cursor))
							(set cursor (i32.inc cursor))
							(if
								(:doc "A Unicode escape must supply exactly four hex digits.")
								(u8.eq escape 117u8)
								(then
									(let-mut digits 0i32)
									(while
										(:doc "Check each digit before advancing to the next byte.")
										(i32.lt digits 4i32)
										(body
											(if
												(:doc "A clipped escape reports the view end.")
												(i32.eq cursor length)
												(then (return (call quoted_span 2u32 start length))))
											(let digit (array.load source cursor))
											(set cursor (i32.inc cursor))
											(if
												(:doc "Include the first invalid digit in the error span.")
												(i32.ltz (call hex_digit_value digit))
												(then (return (call quoted_span 2u32 start cursor))))
											(set digits (i32.inc digits)))))
								(else
									(if
										(:doc "Every other escape must belong to the short escape set.")
										(bool.not (call is_short_escape escape allow_nul))
										(then (return (call quoted_span 2u32 start cursor))))))))))
			(return (call quoted_span 1u32 start length))))

	(fn shift_left
		(:doc `Shift a small, nonnegative value left using the seed's wrapping addition.`)
		(params (value i32) (bits i32))
		(returns i32)
		(body
			(let-mut result value)
			(let-mut remaining bits)
			(while
				(:doc "The hex and surrogate callers keep the result within i32.")
				(i32.gtz remaining)
				(body
					(set result (i32.add result result))
					(set remaining (i32.dec remaining))))
			(return result)))

	(fn read_unicode_escape
		(:doc `Read the four digits after the escaped Unicode marker.`)
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let end (i32.add start 6i32))
			(let-mut cursor (i32.add start 2i32))
			(let-mut value 0i32)
			(while
				(:doc "The checked token guarantees four hexadecimal bytes at this offset.")
				(i32.lt cursor end)
				(body
					(let digit (call hex_digit_value (array.load source cursor)))
					(set value (i32.add (call shift_left value 4i32) digit))
					(set cursor (i32.inc cursor))))
			(return value)))

	(fn string_unit
		(:doc `Represent one decoded scalar, or use -1 to copy the source bytes unchanged.`)
		(params (end i32) (scalar i32))
		(returns QuotedUnit)
		(body
			(return (struct.new QuotedUnit (end end) (scalar scalar) (error 0u32)))))

	(fn decode_unicode_escape
		(:doc `Decode a Unicode escape or combine a high/low surrogate pair.

		An unmatched surrogate reports the span of its own six-byte escape.`)
		(params (source (shared-array u8)) (start i32) (limit i32))
		(returns QuotedUnit)
		(body
			(let value (call read_unicode_escape (borrow-shared source) start))
			(let end (i32.add start 6i32))
			(if
				(:doc "Values outside the surrogate range are Unicode scalars.")
				(bool.or (i32.lt value 55296i32) (i32.not-lt value 57344i32))
				(then (return (call string_unit end value))))
			(if
				(:doc "Only a high surrogate can start a pair. Bound the following escape before reading it.")
				(bool.and
					(i32.lt value 56320i32)
					(bool.and
						(i32.not-lt (i32.sub limit end) 6i32)
						(bool.and
							(u8.eq (array.load source end) 92u8)
							(u8.eq (array.load source (i32.inc end)) 117u8))))
				(then
					(let low (call read_unicode_escape (borrow-shared source) end))
					(if
						(:doc "A low surrogate supplies the low ten bits above U+FFFF.")
						(bool.and (i32.not-lt low 56320i32) (i32.lt low 57344i32))
						(then
							(let high_bits (call shift_left (i32.sub value 55296i32) 10i32))
							(let scalar (i32.add 65536i32
								(i32.add high_bits (i32.sub low 56320i32))))
							(return (call string_unit (i32.add end 6i32) scalar))))))
			(return (struct.new QuotedUnit (end end) (scalar 0i32) (error 4u32)))))

	(fn short_escape_value
		(:doc `Map checked short escapes to their scalar values.`)
		(params (byte u8))
		(returns i32)
		(body
			(if (u8.eq byte 48u8) (then (return 0i32)))
			(if (u8.eq byte 98u8) (then (return 8i32)))
			(if (u8.eq byte 102u8) (then (return 12i32)))
			(if (u8.eq byte 110u8) (then (return 10i32)))
			(if (u8.eq byte 114u8) (then (return 13i32)))
			(if (u8.eq byte 116u8) (then (return 9i32)))
			(return (i32.from-u8 byte))))

	(fn read_quoted_unit
		(:doc "Read the source extent and decoded value of one unit in a checked double-quoted payload.")
		(params (source (shared-array u8)) (start i32) (limit i32))
		(returns QuotedUnit)
		(body
			(let byte (array.load source start))
			(if
				(:doc "A checked backslash introduces a short escape or four hex digits after u.")
				(u8.eq byte 92u8)
				(then
					(let next (i32.inc start))
					(let escape (array.load source next))
					(if
						(:doc "Unicode escapes may join into a surrogate pair.")
						(u8.eq escape 117u8)
						(then (return (call decode_unicode_escape (borrow-shared source) start limit))))
					(return (call string_unit (i32.add start 2i32)
						(call short_escape_value escape)))))
			(return (call string_unit
				(i32.add start (call utf8_width byte)) -1i32))))

	(fn validate_double_quoted_scalars
		(:doc "Validate the scalars in a scanned double-quoted span without writing output.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns QuotedSpan)
		(body
			(let-mut cursor (i32.inc start))
			(let limit (i32.dec end))
			(while
				(:doc "Visit each unit within the delimiters and retain an unmatched surrogate's span.")
				(i32.lt cursor limit)
				(body
					(let unit (call read_quoted_unit (borrow-shared source) cursor limit))
					(let next (struct.get unit end))
					(if
						(:doc "The first unpaired surrogate anchors the error to its own six-byte escape.")
						(u32.gtz (struct.get unit error))
						(then (return (call quoted_span (struct.get unit error) cursor next))))
					(set cursor next)))
			(return (call quoted_span 0u32 start end))))

	(fn scalar_width
		(:doc `Return the UTF-8 width of a checked Unicode scalar.`)
		(params (scalar i32))
		(returns i32)
		(body
			(if (i32.lt scalar 128i32) (then (return 1i32)))
			(if (i32.lt scalar 2048i32) (then (return 2i32)))
			(if (i32.lt scalar 65536i32) (then (return 3i32)))
			(return 4i32)))

	(fn utf8_prefix
		(:doc `Return the leading UTF-8 byte's prefix for the selected width.`)
		(params (width i32))
		(returns i32)
		(body
			(if (i32.eq width 1i32) (then (return 0i32)))
			(if (i32.eq width 2i32) (then (return 192i32)))
			(if (i32.eq width 3i32) (then (return 224i32)))
			(return 240i32)))

	(fn utf8_place
		(:doc `Return the place value of the next UTF-8 group with two to four bytes remaining.`)
		(params (remaining i32))
		(returns i32)
		(body
			(if (i32.eq remaining 2i32) (then (return 64i32)))
			(if (i32.eq remaining 3i32) (then (return 4096i32)))
			(return 262144i32)))

	(fn write_scalar
		(:doc `Emit a scalar in UTF-8 after the caller has checked its entire output width.`)
		(params (output (mut-array u8)) (start i32) (width i32) (scalar i32))
		(returns void)
		(body
			(let-mut rest scalar)
			(let-mut remaining width)
			(let-mut cursor start)
			(let-mut prefix (call utf8_prefix width))
			(while
				(:doc "Emit high groups first, leaving the low group for the final byte.")
				(i32.lt 1i32 remaining)
				(body
					(let place (call utf8_place remaining))
					(let-mut byte prefix)
					(while
						(:doc "At most one six-bit payload fits in this group.")
						(i32.not-lt rest place)
						(body
							(set rest (i32.sub rest place))
							(set byte (i32.inc byte))))
					(array.store output cursor (u8.from-i32 byte))
					(set cursor (i32.inc cursor))
					(set remaining (i32.dec remaining))
					(set prefix 128i32)))
			(array.store output cursor
				(u8.from-i32 (i32.add prefix rest)))))

	(fn quoted_decode_result
		(:doc `Keep the byte count and the original source span together in every decode result.`)
		(params (written i32) (start i32) (end i32) (error u32))
		(returns QuotedDecodeResult)
		(body
			(return (struct.new QuotedDecodeResult
				(written written) (start start) (end end) (error error)))))

	(fn decode_double_quoted
		(:doc "Decode a scanned double-quoted span and keep a complete UTF-8 prefix if an escape or capacity check fails.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)))
		(returns QuotedDecodeResult)
		(body
			(let limit (i32.dec end))
			(let capacity (array.len output))
			(let-mut cursor (i32.inc start))
			(let-mut written 0i32)
			(while
				(:doc "Decode only the payload, one complete scalar at a time.")
				(i32.lt cursor limit)
				(body
					(let unit (call read_quoted_unit (borrow-shared source) cursor limit))
					(let after (struct.get unit end))
					(let error (struct.get unit error))
					(if
						(:doc "An unpaired surrogate keeps its original escape span.")
						(u32.gtz error)
						(then (return (call quoted_decode_result written cursor after error))))
					(let scalar (struct.get unit scalar))
					(let copy (i32.ltz scalar))
					(let-mut width (i32.sub after cursor))
					(if
						(:doc "Escapes can decode to a scalar with a different byte width.")
						(bool.not copy)
						(then (set width (call scalar_width scalar))))
					(if
						(:doc "A short view leaves the next scalar and its source span unconsumed.")
						(i32.lt (i32.sub capacity written) width)
						(then (return (call quoted_decode_result written cursor after 5u32))))
					(if
						(:doc "Copy original UTF-8 bytes or encode the transformed scalar.")
						copy
						(then (call copy_utf8_scalar (borrow-shared source) (borrow-mut output)
							cursor written width))
						(else (call write_scalar (borrow-mut output) written width scalar)))
					(set written (i32.add written width))
					(set cursor after)))
			(return (call quoted_decode_result written start end 0u32)))))
