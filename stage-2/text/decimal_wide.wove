(module decimal_wide
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Append full-width decimal integers to a caller-provided byte view.

	Retain at most twenty digits in inline storage and publish them most
	significant first. Use the byte writer's cursor and capacity rules.`)

	(use wove-file "./bytes.wove" (only write_byte))

	(fn write_decimal_u64
		(:doc `Append the unsigned value and return the next offset.

		A failed cursor stays failed. Short output retains the prefix that
		fit and returns -1. The digits are not NUL-terminated.`)
		(params (output (mut-array u8)) (offset i32) (value u64))
		(returns i32)
		(body
			(if (i32.lt (local offset) 0i32) (then (return -1i32)))
			(let-mut reversed (array.repeat (array u8 20) 0u8))
			(let-mut remaining (local value))
			(let-mut used 0i32)
			(while
				(:doc "Produce one digit even for zero and consume one decimal place per iteration.")
				(bool true)
				(body
					(let-mut digit 0u64)
					(if
						(:doc "Division and remainder by ten always fit, including at UINT64_MAX.")
						(bool.not (bool.and (u64.try_rem (local remaining) 10u64 (borrow-mut (local digit)))
							(u64.try_div (local remaining) 10u64 (borrow-mut (local remaining)))))
						(then (return -1i32)))
					(array.store (local reversed) (local used) (u8.from-u64 (u64.add (local digit) 48u64)))
					(set (local used) (i32.add (local used) 1i32))
					(if (u64.eq (local remaining) 0u64) (then (break)))))
			(let-mut next (local offset))
			(while
				(:doc "Write the most significant remaining digit while there is capacity.")
				(bool.and (i32.lt 0i32 (local used)) (i32.not-lt (local next) 0i32))
				(body
					(set (local used) (i32.sub (local used) 1i32))
					(set (local next) (call write_byte (borrow-mut (local output)) (local next)
						(array.load (local reversed) (local used))))))
			(return (local next))))

	(fn write_decimal_i64
		(:doc `Append a signed value, computing the magnitude of INT64_MIN safely.`)
		(params (output (mut-array u8)) (offset i32) (value i64))
		(returns i32)
		(body
			(if
				(:doc "The signed subtraction fits even at the minimum. Restore the final unit in u64.")
				(i64.lt (local value) 0i64)
				(then
					(let next (call write_byte (borrow-mut (local output)) (local offset) 45u8))
					(let base (u64.from-i64 (i64.sub -1i64 (local value))))
					(return (call write_decimal_u64 (borrow-mut (local output)) (local next)
						(u64.add (local base) 1u64)))))
			(return (call write_decimal_u64 (borrow-mut (local output)) (local offset) (u64.from-i64 (local value))))))
)
