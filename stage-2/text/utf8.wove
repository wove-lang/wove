(module utf8
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Validate UTF-8 byte slices and measure complete Unicode scalars.")

	(fn utf8_width
		(:doc `Classify an ASCII byte or a legal lead byte by the width of its scalar.`)
		(params (lead u8))
		(returns i32)
		(body
			(if
				(:doc "ASCII scalars occupy a single byte.")
				(lead.lt 0x80u8)
				(then (return 1i32)))
			(if
				(:doc "Continuations and the overlong two-byte prefixes cannot start a scalar.")
				(lead.lt 0xc2u8)
				(then (return 0i32)))
			(if
				(:doc "C2 through DF are the legal two-byte leads.")
				(lead.lt 0xe0u8)
				(then (return 2i32)))
			(if
				(:doc "E0 through EF start three-byte scalars.")
				(lead.lt 0xf0u8)
				(then (return 3i32)))
			(if
				(:doc "F4 is the last lead that can encode a Unicode scalar.")
				(lead.lt 0xf5u8)
				(then (return 4i32)))
			(return 0i32)))

	(fn is_utf8_continuation
		(:doc `A continuation byte has prefix 10 in binary.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool:and (byte.not-lt 0x80u8) (byte.lt 0xc0u8)))))

	(fn valid_utf8_second
		(:doc `Apply the extra restrictions on the first continuation byte.`)
		(params (lead u8) (second u8))
		(returns bool)
		(body
			(if
				(:doc "Every multibyte scalar needs a continuation at this position.")
				(bool:not (call is_utf8_continuation second))
				(then (return (bool false))))
			(if
				(:doc "E0 requires a high second byte to avoid a three-byte overlong form.")
				(lead.eq 0xe0u8)
				(then (return (second.not-lt 0xa0u8))))
			(if
				(:doc "ED must stop below the surrogate range.")
				(lead.eq 0xedu8)
				(then (return (second.lt 0xa0u8))))
			(if
				(:doc "F0 requires a high second byte to avoid a four-byte overlong form.")
				(lead.eq 0xf0u8)
				(then (return (second.not-lt 0x90u8))))
			(if
				(:doc "F4 must stop at U+10FFFF.")
				(lead.eq 0xf4u8)
				(then (return (second.lt 0x90u8))))
			(return (bool true))))

	(fn valid_utf8_width
		(:doc `Return the complete UTF-8 scalar width or zero for a malformed sequence.`)
		(params (source (shared-array u8)) (cursor i32) (lead u8))
		(returns i32)
		(body
			(let width (call utf8_width lead))
			(let remaining (i32:sub source.len cursor))
			(if
				(:doc "Reject truncation before adding the width or reading any suffix bytes.")
				(bool:or width.eqz (remaining.lt width))
				(then (return 0i32)))
			(if
				(:doc "ASCII needs no continuation loads.")
				(width.eq 1i32)
				(then (return 1i32)))
			(let second_index cursor.inc)
			(let second (source.get second_index))
			(if
				(:doc "Apply the lead-specific lower and upper bounds on the second byte.")
				(bool:not (call valid_utf8_second lead second))
				(then (return 0i32)))
			(let end (cursor.add width))
			(let-mut tail second_index.inc)
			(while
				(:doc "Check each remaining continuation within the verified span.")
				(tail.lt end)
				(body
					(let byte (source.get tail))
					(if
						(:doc "Reject the whole scalar if a tail byte is not a continuation.")
						(bool:not (call is_utf8_continuation byte))
						(then (return 0i32)))
					(set tail tail.inc)))
			(return width)))

	(fn utf8_invalid_offset
		(:doc "Return the offset of the first malformed scalar's lead byte, or -1 for valid UTF-8.")
		(params (source (shared-array u8)))
		(returns i32)
		(body
			(let length source.len)
			(let-mut cursor 0i32)
			(while
				(:doc "Keep the cursor at the lead until the whole scalar has been checked.")
				(cursor.lt length)
				(body
					(let lead (source.get cursor))
					(let width (call valid_utf8_width (borrow-shared source) cursor lead))
					(if
						(:doc "Report the lead of the first invalid sequence.")
						width.eqz
						(then (return cursor)))
					(set cursor (cursor.add width))))
			(return -1i32)))

	(fn copy_utf8_scalar
		(:doc `Copy an unescaped scalar's original bytes after checking its output width.`)
		(params (source (shared-array u8)) (output (mut-array u8)) (start i32) (target i32) (width i32))
		(returns void)
		(body
			(let-mut offset 0i32)
			(while
				(:doc "Both views contain the complete scalar when entering this loop.")
				(offset.lt width)
				(body
					(output.set (target.add offset)
						(source.get (start.add offset)))
					(set offset offset.inc))))))
