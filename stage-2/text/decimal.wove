(module bounded_decimal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read significant decimal digits and check bounds, with magnitude accumulation for u32.")

	(struct DecimalDigits (fields (digits i32) (magnitude u32)))

	(fn invalid_digits
		(:doc "Represent a span that could not be read within its decimal bound.")
		(params)
		(returns DecimalDigits)
		(body (return (struct:new DecimalDigits (digits -1i32) (magnitude 0u32)))))

	(fn read_decimal_digits
		(:doc "Read bare ASCII digits. Supply the quotient and remainder of the u32 bound divided by ten. Return the first nonzero digit offset, or the last zero for an all-zero value.")
		(params (bytes (shared-array u8)) (start i32) (end i32) (max_prefix u32) (max_last u32))
		(returns DecimalDigits)
		(body
			(if
				(:doc "The digit span needs at least one byte inside the view.")
				(bool:or (start.not-lt end)
					(start.ltz.or (bytes.len.lt end)))
				(then (return (call invalid_digits))))
			(let-mut cursor start)
			(let-mut magnitude 0u32)
			(let-mut digits end.dec)
			(while
				(:doc "The accumulated magnitude stays within the declared bound.")
				(cursor.lt end)
				(body
					(let byte (bytes.get cursor))
					(if
						(:doc "The caller handles any sign before passing the digits.")
						(bool:or (byte.lt 48u8) (u8:lt 57u8 byte))
						(then (return (call invalid_digits))))
					(let digit (u32:sub (u32:from-u8 byte) 48u32))
					(if
						(:doc "Check both parts of the next base-ten step before it can overflow.")
						(bool:or (max_prefix.lt magnitude)
							(bool:and (magnitude.eq max_prefix) (max_last.lt digit)))
						(then (return (call invalid_digits))))
					(if
						(:doc "The first nonzero digit establishes the significant spelling.")
						(magnitude.eqz.and digit.gtz)
						(then (set digits cursor)))
					(let twice (magnitude.add magnitude))
					(let four (twice.add twice))
					(let eight (four.add four))
					(set magnitude (u32:add (eight.add twice) digit))
					(set cursor cursor.inc)))
			(return (struct:new DecimalDigits (digits digits) (magnitude magnitude)))))

	(fn read_bounded_decimal_spelling
		(:doc `Return the first significant ASCII digit, or -1 for an invalid or out-of-range span.

		The caller supplies a canonical unsigned decimal bound. Keep one
		digit for zero and check the spelling without accumulating its value.`)
		(params (bytes (shared-array u8)) (start i32) (end i32) (maximum (shared-array u8)))
		(returns i32)
		(body
			(if
				(:doc "The digit span must be nonempty and inside the source view.")
				(bool:or (start.not-lt end)
					(start.ltz.or (bytes.len.lt end)))
				(then (return -1i32)))
			(let-mut digits start)
			(let last end.dec)
			(while
				(:doc "Skip leading zeroes, leaving one digit when the magnitude is zero.")
				(bool:and (digits.lt last)
					(u8:eq (bytes.get digits) 48u8))
				(body (set digits digits.inc)))
			(let width (end.sub digits))
			(let limit maximum.len)
			(if
				(:doc "A normalized magnitude with more digits exceeds the bound.")
				(limit.lt width)
				(then (return -1i32)))
			(let-mut below_limit (width.lt limit))
			(let-mut cursor digits)
			(while
				(:doc "Check every digit and compare equal-length magnitudes in lexical order.")
				(cursor.lt end)
				(body
					(let digit (bytes.get cursor))
					(if
						(:doc "A decimal magnitude allows only ASCII digits.")
						(bool:or (digit.lt 48u8) (u8:lt 57u8 digit))
						(then (return -1i32)))
					(if
						(:doc "An equal prefix still needs to fit the maximum at this position.")
						below_limit.not
						(then
							(let bound (maximum.get (cursor.sub digits)))
							(if (bound.lt digit) (then (return -1i32)))
							(set below_limit (digit.lt bound))))
					(set cursor cursor.inc)))
			(return digits))))
