(module bounded_decimal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read significant decimal digits and check bounds, with magnitude accumulation for u32.")

	(struct DecimalDigits (fields (digits i32) (magnitude u32)))

	(fn invalid_digits
		(:doc "Represent a span that could not be read within its decimal bound.")
		(params)
		(returns DecimalDigits)
		(body (return (struct.new DecimalDigits (digits -1i32) (magnitude 0u32)))))

	(fn read_decimal_digits
		(:doc "Read bare ASCII digits. Supply the quotient and remainder of the u32 bound divided by ten. Return the first nonzero digit offset, or the last zero for an all-zero value.")
		(params (bytes (shared-slice u8)) (start i32) (end i32) (max_prefix u32) (max_last u32))
		(returns DecimalDigits)
		(body
			(if
				(:doc "The digit span needs at least one byte inside the view.")
				(bool.or (bool.not (i32.lt (local start) (local end)))
					(bool.or (i32.lt (local start) 0i32) (i32.lt (slice.len (local bytes)) (local end))))
				(then (return (call invalid_digits))))
			(let-mut cursor (local start))
			(let-mut magnitude 0u32)
			(let-mut digits (i32.sub.wrapping (local end) 1i32))
			(while
				(:doc "The accumulated magnitude stays within the declared bound.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local bytes) (local cursor)))
					(if
						(:doc "The caller handles any sign before passing the digits.")
						(bool.or (u8.lt (local byte) 48u8) (u8.lt 57u8 (local byte)))
						(then (return (call invalid_digits))))
					(let digit (u32.sub.wrapping (int.convert u32 (local byte)) 48u32))
					(if
						(:doc "Check both parts of the next base-ten step before it can overflow.")
						(bool.or (u32.lt (local max_prefix) (local magnitude))
							(bool.and (u32.eq (local magnitude) (local max_prefix)) (u32.lt (local max_last) (local digit))))
						(then (return (call invalid_digits))))
					(if
						(:doc "The first nonzero digit establishes the significant spelling.")
						(bool.and (u32.eq (local magnitude) 0u32) (u32.lt 0u32 (local digit)))
						(then (set (local digits) (local cursor))))
					(let twice (u32.add.wrapping (local magnitude) (local magnitude)))
					(let four (u32.add.wrapping (local twice) (local twice)))
					(let eight (u32.add.wrapping (local four) (local four)))
					(set (local magnitude) (u32.add.wrapping (u32.add.wrapping (local eight) (local twice)) (local digit)))
					(set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(return (struct.new DecimalDigits (digits (local digits)) (magnitude (local magnitude))))))

	(fn read_bounded_decimal_spelling
		(:doc `Return the first significant ASCII digit, or -1 for an invalid or out-of-range span.

		The caller supplies a canonical unsigned decimal bound. Keep one
		digit for zero and check the spelling without accumulating its value.`)
		(params (bytes (shared-slice u8)) (start i32) (end i32) (maximum (shared-slice u8)))
		(returns i32)
		(body
			(if
				(:doc "The digit span must be nonempty and inside the source view.")
				(bool.or (bool.not (i32.lt (local start) (local end)))
					(bool.or (i32.lt (local start) 0i32) (i32.lt (slice.len (local bytes)) (local end))))
				(then (return -1i32)))
			(let-mut digits (local start))
			(let last (i32.sub.wrapping (local end) 1i32))
			(while
				(:doc "Skip leading zeroes, leaving one digit when the magnitude is zero.")
				(bool.and (i32.lt (local digits) (local last))
					(u8.eq (slice.load (local bytes) (local digits)) 48u8))
				(body (set (local digits) (i32.add.wrapping (local digits) 1i32))))
			(let width (i32.sub.wrapping (local end) (local digits)))
			(let limit (slice.len (local maximum)))
			(if
				(:doc "A normalized magnitude with more digits exceeds the bound.")
				(i32.lt (local limit) (local width))
				(then (return -1i32)))
			(let-mut below_limit (i32.lt (local width) (local limit)))
			(let-mut cursor (local digits))
			(while
				(:doc "Check every digit and compare equal-length magnitudes in lexical order.")
				(i32.lt (local cursor) (local end))
				(body
					(let digit (slice.load (local bytes) (local cursor)))
					(if
						(:doc "A decimal magnitude allows only ASCII digits.")
						(bool.or (u8.lt (local digit) 48u8) (u8.lt 57u8 (local digit)))
						(then (return -1i32)))
					(if
						(:doc "An equal prefix still needs to fit the maximum at this position.")
						(bool.not (local below_limit))
						(then
							(let bound (slice.load (local maximum) (i32.sub.wrapping (local cursor) (local digits))))
							(if (u8.lt (local bound) (local digit)) (then (return -1i32)))
							(set (local below_limit) (u8.lt (local digit) (local bound)))))
					(set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(return (local digits)))))
