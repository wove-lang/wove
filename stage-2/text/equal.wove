(module byte_equality
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Compare the contents of borrowed byte views.")

	(use wove-file "./bytes.wove" (only same_bytes))

	(fn equal_bytes
		(:doc "Return true if both views have the same length and bytes in order, including two empty views.")
		(params (left (shared-array u8)) (right (shared-array u8)))
		(returns bool)
		(body
			(return (call same_bytes
				(borrow-shared left) 0i32 left.len
				(borrow-shared right) 0i32 right.len))))
)
