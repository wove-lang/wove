(module character_literal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Scan and decode the archive's single-byte character spellings.")

	(use wove-file "./hex.wove" (only hex_digit_value))
	(use wove-file "./match.wove" (only is_byte_at))

	(struct CharacterSpan (fields (end i32) (closed bool)))

	(fn scan_character_span
		(:doc "Find the close on the same line. Return the first line ending or EOF when it is missing.")
		(params (source (shared-array u8)) (start i32)) (returns CharacterSpan)
		(body
			(let-mut cursor start.inc)
			(let-mut escaped (bool false))
			(while
				(:doc "An escaped quote is payload, and an escape cannot continue on the next line.")
				(cursor.lt source.len)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "Treat the archived EOF sentinel and both physical line endings as boundaries.")
						(byte.eqz.or (bool:or (byte.eq 10u8) (byte.eq 13u8)))
						(then (return (CharacterSpan.new (end cursor) (closed (bool false))))))
					(set cursor cursor.inc)
					(if
						(:doc "Return the exclusive end after an unescaped apostrophe.")
						(escaped.not.and (byte.eq 39u8))
						(then (return (CharacterSpan.new (end cursor) (closed (bool true))))))
					(set escaped (escaped.not.and (byte.eq 92u8)))))
			(return (CharacterSpan.new (end cursor) (closed (bool false))))))

	(fn short_character_escape
		(:doc "Decode the archived named control escapes and escaped apostrophe or backslash.")
		(params (byte u8)) (returns i32)
		(body
			(if (byte.eq 48u8) (then (return 0i32)))
			(if (byte.eq 97u8) (then (return 7i32)))
			(if (byte.eq 98u8) (then (return 8i32)))
			(if (byte.eq 116u8) (then (return 9i32)))
			(if (byte.eq 110u8) (then (return 10i32)))
			(if (byte.eq 118u8) (then (return 11i32)))
			(if (byte.eq 102u8) (then (return 12i32)))
			(if (byte.eq 114u8) (then (return 13i32)))
			(if
				(:doc "Escaping a delimiter or backslash preserves its byte value.")
				(bool:or (byte.eq 39u8) (byte.eq 92u8))
				(then (return (i32:from-u8 byte))))
			(return -1i32)))

	(fn decode_character
		(:doc "Read exactly one byte from a delimited span, or return -1 for invalid payloads.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let width (end.sub start))
			(let first start.inc)
			(if
				(:doc "Unescaped character spellings use one printable ASCII byte.")
				(width.eq 3i32)
				(then
					(let byte (source.get first))
					(if
						(:doc "Control and non-ASCII bytes require an explicit escape.")
						(bool:and (byte.not-lt 32u8) (byte.lt 127u8))
						(then (return (i32:from-u8 byte))))
					(return -1i32)))
			(if
				(:doc "Longer payloads can only represent the byte through one escape.")
				(bool:not (call is_byte_at (borrow-shared source) first 0i32 92u8))
				(then (return -1i32)))
			(let escape first.inc)
			(if
				(:doc "A named escape uses exactly one byte after the backslash.")
				(width.eq 4i32)
				(then (return (call short_character_escape (source.get escape)))))
			(if
				(:doc "The hexadecimal escape has exactly two digits before the close.")
				(bool:and (width.eq 6i32) (u8:eq (source.get escape) 120u8))
				(then
					(let high (call hex_digit_value (source.get escape.inc)))
					(let low (call hex_digit_value (source.get (escape.add 2i32))))
					(if
						(:doc "Both nibbles must be recognized hexadecimal digits.")
						(bool:and (i32:lt -1i32 high) (i32:lt -1i32 low))
						(then (return (i32:from-u32 (u32:or (u32:shl (u32:from-i32 high) 4i32)
							(u32:from-i32 low))))))))
			(return -1i32)))
)
