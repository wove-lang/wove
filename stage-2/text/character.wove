(module character_literal
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Scan and decode the archive's single-byte character spellings.")

	(use wove-file "./hex.wove" (only hex_digit_value))
	(use wove-file "./match.wove" (only is_byte_at))

	(struct CharacterSpan (fields (end i32) (closed bool)))

	(fn scan_character_span
		(:doc "Find the close on the same line. Return the first line ending or EOF when it is missing.")
		(params (source (shared-array u8)) (start i32)) (returns CharacterSpan)
		(body
			(let-mut cursor (i32.add (local start) 1i32))
			(let-mut escaped (bool false))
			(while
				(:doc "An escaped quote is payload, and an escape cannot continue on the next line.")
				(i32.lt (local cursor) (array.len (local source)))
				(body
					(let byte (array.load (local source) (local cursor)))
					(if
						(:doc "Treat the archived EOF sentinel and both physical line endings as boundaries.")
						(bool.or (u8.eq (local byte) 0u8) (bool.or (u8.eq (local byte) 10u8) (u8.eq (local byte) 13u8)))
						(then (return (struct.new CharacterSpan (end (local cursor)) (closed (bool false))))))
					(set (local cursor) (i32.add (local cursor) 1i32))
					(if
						(:doc "Return the exclusive end after an unescaped apostrophe.")
						(bool.and (bool.not (local escaped)) (u8.eq (local byte) 39u8))
						(then (return (struct.new CharacterSpan (end (local cursor)) (closed (bool true))))))
					(set (local escaped) (bool.and (bool.not (local escaped)) (u8.eq (local byte) 92u8)))))
			(return (struct.new CharacterSpan (end (local cursor)) (closed (bool false))))))

	(fn short_character_escape
		(:doc "Decode the archived named control escapes and escaped apostrophe or backslash.")
		(params (byte u8)) (returns i32)
		(body
			(if (u8.eq (local byte) 48u8) (then (return 0i32)))
			(if (u8.eq (local byte) 97u8) (then (return 7i32)))
			(if (u8.eq (local byte) 98u8) (then (return 8i32)))
			(if (u8.eq (local byte) 116u8) (then (return 9i32)))
			(if (u8.eq (local byte) 110u8) (then (return 10i32)))
			(if (u8.eq (local byte) 118u8) (then (return 11i32)))
			(if (u8.eq (local byte) 102u8) (then (return 12i32)))
			(if (u8.eq (local byte) 114u8) (then (return 13i32)))
			(if
				(:doc "Escaping a delimiter or backslash preserves its byte value.")
				(bool.or (u8.eq (local byte) 39u8) (u8.eq (local byte) 92u8))
				(then (return (i32.from-u8 (local byte)))))
			(return -1i32)))

	(fn decode_character
		(:doc "Read exactly one byte from a delimited span, or return -1 for invalid payloads.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let width (i32.sub (local end) (local start)))
			(let first (i32.add (local start) 1i32))
			(if
				(:doc "Unescaped character spellings use one printable ASCII byte.")
				(i32.eq (local width) 3i32)
				(then
					(let byte (array.load (local source) (local first)))
					(if
						(:doc "Control and non-ASCII bytes require an explicit escape.")
						(bool.and (bool.not (u8.lt (local byte) 32u8)) (u8.lt (local byte) 127u8))
						(then (return (i32.from-u8 (local byte)))))
					(return -1i32)))
			(if
				(:doc "Longer payloads can only represent the byte through one escape.")
				(bool.not (call is_byte_at (borrow-shared (local source)) (local first) 0i32 92u8))
				(then (return -1i32)))
			(let escape (i32.add (local first) 1i32))
			(if
				(:doc "A named escape uses exactly one byte after the backslash.")
				(i32.eq (local width) 4i32)
				(then (return (call short_character_escape (array.load (local source) (local escape))))))
			(if
				(:doc "The hexadecimal escape has exactly two digits before the close.")
				(bool.and (i32.eq (local width) 6i32) (u8.eq (array.load (local source) (local escape)) 120u8))
				(then
					(let high (call hex_digit_value (array.load (local source) (i32.add (local escape) 1i32))))
					(let low (call hex_digit_value (array.load (local source) (i32.add (local escape) 2i32))))
					(if
						(:doc "Both nibbles must be recognized hexadecimal digits.")
						(bool.and (i32.lt -1i32 (local high)) (i32.lt -1i32 (local low)))
						(then (return (i32.from-u32 (u32.or (u32.shl (u32.from-i32 (local high)) 4i32)
							(u32.from-i32 (local low)))))))))
			(return -1i32)))
)
