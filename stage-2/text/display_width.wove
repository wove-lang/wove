	(fn unicode_cells
		(:doc "Find the width of one scalar in the last transition at or below its code point.")
		(params (transitions (shared-array u32)) (scalar u32)) (returns i32)
		(body
			(let-mut lower 0i32)
			(let-mut upper (array.len (local transitions)))
			(while
				(:doc "The first transition starts at code point zero, so the lower bound always applies.")
				(i32.lt 1i32 (i32.sub.wrapping (local upper) (local lower)))
				(body
					(let mid (i32.add.wrapping (local lower) (i32.div (i32.sub.wrapping (local upper) (local lower)) 2i32)))
					(if
						(:doc "A transition above the target can bound the search but cannot supply the width.")
						(u32.lt (local scalar) (u32.shr (array.load (local transitions) (local mid)) 2i32))
						(then (set (local upper) (local mid)))
						(else (set (local lower) (local mid))))))
			(return (int.convert i32 (u32.and (array.load (local transitions) (local lower)) 3u32)))))

	(fn utf8_cells
		(:doc "Decode one validated multibyte UTF-8 scalar and return its display width.")
		(params (source (shared-array u8)) (start i32) (bytes i32) (transitions (shared-array u32))) (returns i32)
		(body
			(let mask (u32.shr 127u32 (local bytes)))
			(let-mut scalar (u32.and (int.convert u32 (array.load (local source) (local start))) (local mask)))
			(let-mut offset 1i32)
			(while
				(:doc "Append six payload bits from each validated continuation byte.")
				(i32.lt (local offset) (local bytes))
				(body
					(let byte (int.convert u32 (array.load (local source) (i32.add.wrapping (local start) (local offset)))))
					(set (local scalar) (u32.or (u32.shl (local scalar) 6i32) (u32.and (local byte) 63u32)))
					(set (local offset) (i32.add.wrapping (local offset) 1i32))))
			(return (call unicode_cells (borrow-shared (local transitions)) (local scalar)))))
