(module hex_digit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode an ASCII hexadecimal digit without interpreting the enclosing literal.")

	(fn hex_digit_value
		(:doc "Accept both letter cases and return -1 for bytes outside the three digit ranges.")
		(params (byte u8)) (returns i32)
		(body
			(let value (i32.from-u8 (local byte)))
			(if
				(:doc "The decimal digits retain their ordinary values.")
				(bool.and (bool.not (i32.lt (local value) 48i32)) (i32.lt (local value) 58i32))
				(then (return (i32.sub (local value) 48i32))))
			(if
				(:doc "Uppercase hexadecimal letters represent 10 through 15.")
				(bool.and (bool.not (i32.lt (local value) 65i32)) (i32.lt (local value) 71i32))
				(then (return (i32.sub (local value) 55i32))))
			(if
				(:doc "Lowercase hexadecimal letters have the same values.")
				(bool.and (bool.not (i32.lt (local value) 97i32)) (i32.lt (local value) 103i32))
				(then (return (i32.sub (local value) 87i32))))
			(return -1i32)))
)
