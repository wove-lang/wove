(module hex_digit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode an ASCII hexadecimal digit without interpreting the enclosing literal.")

	(fn hex_digit_value
		(:doc "Accept both letter cases and return -1 for bytes outside the three digit ranges.")
		(params (byte u8)) (returns i32)
		(body
			(let value (i32:from-u8 byte))
			(if
				(:doc "The decimal digits retain their ordinary values.")
				(bool:and (value.not-lt 48i32) (value.lt 58i32))
				(then (return (value.sub 48i32))))
			(if
				(:doc "Uppercase hexadecimal letters represent 10 through 15.")
				(bool:and (value.not-lt 65i32) (value.lt 71i32))
				(then (return (value.sub 55i32))))
			(if
				(:doc "Lowercase hexadecimal letters have the same values.")
				(bool:and (value.not-lt 97i32) (value.lt 103i32))
				(then (return (value.sub 87i32))))
			(return -1i32)))
)
