(module text_byte_match
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compare small fixed byte sequences at offsets inside checked views.`)

	(fn is_byte_at
		(:doc `Compare one byte at a checked offset relative to a span's start.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (start i32) (offset i32) (byte u8))
		(returns bool)
		(body
			(return (u8:eq
					(array:get source (i32:add start offset))
					byte))))

	(fn is_three_bytes
		(:doc `Compare three consecutive bytes inside a checked span.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (start i32) (first u8) (second u8) (third u8))
		(returns bool)
		(body
			(return (bool:and
					(call is_byte_at (borrow-shared source) start 0i32 first)
					(bool:and
						(call is_byte_at (borrow-shared source) start 1i32 second)
						(call is_byte_at (borrow-shared source) start 2i32 third)))))))
