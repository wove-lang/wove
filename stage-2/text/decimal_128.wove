(module decimal_128
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Append full-width decimal integers on targets with native 128-bit values.")

	(use wove-file "./bytes.wove" (only write_byte))

	(fn write_decimal_u128
		(:doc "Append the original unsigned value. Keep a fitting prefix and return -1 when the view ends.")
		(params (output (mut-array u8)) (offset i32) (value u128)) (returns i32)
		(body
			(if (i32.ltz (local offset)) (then (return -1i32)))
			(let-mut reversed (array.repeat (array u8 39) 0u8))
			(let-mut remaining (local value))
			(let-mut used 0i32)
			(while
				(:doc "Each iteration stores the next least-significant digit, including a single digit for zero.")
				(bool true)
				(body
					(let digit (u8.from-u128 (u128.add (u128.rem (local remaining) 10u128) 48u128)))
					(array.store (local reversed) (local used) (local digit))
					(set (local remaining) (u128.div (local remaining) 10u128))
					(set (local used) (i32.inc (local used)))
					(if (u128.eqz (local remaining)) (then (break)))))
			(let-mut next (local offset))
			(while
				(:doc "Emit the most significant remaining digit while output still has space.")
				(bool.and (i32.gtz (local used)) (i32.not-ltz (local next)))
				(body
					(set (local used) (i32.dec (local used)))
					(set (local next) (call write_byte (borrow-mut (local output)) (local next)
						(array.load (local reversed) (local used))))))
			(return (local next))))

	(fn write_decimal_i128
		(:doc "Append a signed value and recover the minimum's magnitude without a signed negation overflow.")
		(params (output (mut-array u8)) (offset i32) (value i128)) (returns i32)
		(body
			(if
				(:doc "The subtraction fits even at the signed minimum. Restore the final unit in the unsigned type.")
				(i128.ltz (local value))
				(then
					(let next (call write_byte (borrow-mut (local output)) (local offset) 45u8))
					(let base (u128.from-i128 (i128.sub -1i128 (local value))))
					(return (call write_decimal_u128 (borrow-mut (local output)) (local next) (u128.inc (local base))))))
			(return (call write_decimal_u128 (borrow-mut (local output)) (local offset) (u128.from-i128 (local value))))))
)
