(module decimal_128
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Append full-width decimal integers on targets with native 128-bit values.")

	(use wove-file "./bytes.wove" (only write_byte))

	(fn write_decimal_u128
		(:doc "Append the original unsigned value. Keep a fitting prefix and return -1 when the view ends.")
		(params (output (mut-array u8)) (offset i32) (value u128)) (returns i32)
		(body
			(if (i32.ltz offset) (then (return -1i32)))
			(let-mut reversed (array.repeat (array u8 39) 0u8))
			(let-mut remaining value)
			(let-mut used 0i32)
			(while
				(:doc "Each iteration stores the next least-significant digit, including a single digit for zero.")
				(bool true)
				(body
					(let digit (u8.from-u128 (u128.add (u128.rem remaining 10u128) 48u128)))
					(array.store reversed used digit)
					(set remaining (u128.div remaining 10u128))
					(set used (i32.inc used))
					(if (u128.eqz remaining) (then (break)))))
			(let-mut next offset)
			(while
				(:doc "Emit the most significant remaining digit while output still has space.")
				(bool.and (i32.gtz used) (i32.not-ltz next))
				(body
					(set used (i32.dec used))
					(set next (call write_byte (borrow-mut output) next
						(array.load reversed used)))))
			(return next)))

	(fn write_decimal_i128
		(:doc "Append a signed value and recover the minimum's magnitude without a signed negation overflow.")
		(params (output (mut-array u8)) (offset i32) (value i128)) (returns i32)
		(body
			(if
				(:doc "The subtraction fits even at the signed minimum. Restore the final unit in the unsigned type.")
				(i128.ltz value)
				(then
					(let next (call write_byte (borrow-mut output) offset 45u8))
					(let base (u128.from-i128 (i128.sub -1i128 value)))
					(return (call write_decimal_u128 (borrow-mut output) next (u128.inc base)))))
			(return (call write_decimal_u128 (borrow-mut output) offset (u128.from-i128 value)))))
)
