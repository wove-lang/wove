(module text_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Copy byte views into caller-provided storage.`)

	(fn append_bytes
		(:doc "Copy a byte view into an already reserved destination region.")
		(params (bytes (shared-array u8)) (arena (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let length bytes.len)
			(while
				(:doc "Preserve every source byte in its original order.")
				(i32:lt index length)
				(body
					(arena.set (i32:add offset index)
						(bytes.get index))
					(set index (i32:inc index))))
			(return (i32:add offset length))))
)
