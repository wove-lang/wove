(module text_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Copy byte views into caller-provided storage.`)

	(fn append_bytes
		(:doc "Copy a byte view into an already reserved destination region.")
		(params (bytes (shared-slice u8)) (arena (mut-slice u8)) (offset i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let length (slice.len (local bytes)))
			(while
				(:doc "Preserve every source byte in its original order.")
				(i32.lt (local index) (local length))
				(body
					(slice.store (local arena) (i32.add.wrapping (local offset) (local index))
						(slice.load (local bytes) (local index)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (i32.add.wrapping (local offset) (local length)))))
)
