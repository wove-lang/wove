(module emit_c_record_out
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Lower a C status and typed nullable record out slot to one bounded Wove view.")

	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/c_records.wove" (only c_pointer_field_kind (value cstrs_field_kind)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only record_index place_reference_target (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "../scalar/syntax.wove" (only (value buffered_cstrs_type)))
	(use wove-file "../scalar/loans.wove" (only returned_call_argument returned_call_scratch (type ScalarExpression)))
	(use wove-file "./c_extents.wove" (only map_c_actuals (type CActual)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_span write_temporary_name write_local_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))

	(let record_out_open "__extension__ ({__typeof__(")
	(let record_status_start ") wvrt_record_out=NULL;int32_t wvrt_record_status=")
	(let store_status ");*")
	(let record_out_finish "=wvrt_record_status;wvrt_c_buffered_record_out(")
	(let out_actual ",wvrt_record_out,")
	(let status_actual ",wvrt_record_status")
	(let compound_close ";})")

	(fn open_record_out
		(:doc "Declare the native out slot using the type of the original captured record pointer.")
		(params (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let open (call c_literal_text (borrow-shared record_out_open) (borrow-mut output) offset writing))
			(let record (call write_temporary_name (borrow-shared nodes)
				(call returned_call_argument expression) (borrow-mut output) open name_prefix writing))
			(return (call c_literal_text (borrow-shared record_status_start) (borrow-mut output) record writing))))

	(fn close_record_out
		(:doc "Copy the untouched C status and publish a view restricted to the originally supplied byte count.")
		(params (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let first (callee.get params))
			(let arity (callee.get arity))
			(let-mut actuals (array:alloc CActual arity))
			(call map_c_actuals (borrow-shared nodes) (expression.get first)
				(borrow-shared parameters) first (borrow-mut actuals))
			(let scratch (parameters.get (callee.get return_scratch)))
			(let count (actuals.get (scratch.get c_count)))
			(let status (actuals.get (i32:dec arity)))
			(let start (call c_literal_text (borrow-shared store_status) (borrow-mut output) offset writing))
			(let status_place (call write_temporary_name (borrow-shared nodes)
				(status.get node) (borrow-mut output) start name_prefix writing))
			(let finish (call c_literal_text (borrow-shared record_out_finish) (borrow-mut output) status_place writing))
			(let record (call write_temporary_name (borrow-shared nodes)
				(call returned_call_argument expression) (borrow-mut output) finish name_prefix writing))
			(let out (call c_literal_text (borrow-shared out_actual) (borrow-mut output) record writing))
			(let buffer (call write_temporary_name (borrow-shared nodes)
				(call returned_call_scratch expression) (borrow-mut output) out name_prefix writing))
			(let comma (call c_byte (borrow-mut output) buffer 44u8 writing))
			(let extent (call write_temporary_name (borrow-shared nodes)
				(count.get node) (borrow-mut output) comma name_prefix writing))
			(let args (call c_literal_text (borrow-shared status_actual) (borrow-mut output) extent writing))
			(let site (nodes.get index))
			(let source_base (caller.get source_base))
			(let call_end (call close_runtime_call (borrow-mut output) args (caller.get file)
				(i32:sub (site.get start) source_base) (i32:sub (site.get end) source_base) writing))
			(return (call c_literal_text (borrow-shared compound_close) (borrow-mut output) call_end writing))))

	(let buffered_string_call "wvrt_c_buffered_string(")
	(let buffered_table_call "wvrt_c_buffered_string_table(")
	(let record_byte_argument ".wvrt_bytes,")

	(fn open_buffered_field
		(:doc "Read pointer fields against the captured caller range, including when the vector table is unaligned.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(field ScalarExpression) (receiver ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "A string table has its own checked layout and cannot use a raw native vector descriptor.")
				(u32:eq (field.get type) buffered_cstrs_type)
				(then (set cursor (call c_literal_text (borrow-shared buffered_table_call)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared buffered_string_call)
					(borrow-mut output) cursor writing))))
			(let name (call write_local_name (borrow-shared source) (borrow-shared nodes)
				(receiver.get target) tree_base (borrow-mut output) cursor name_prefix writing))
			(return (call c_literal_text (borrow-shared record_byte_argument) (borrow-mut output) name writing))))

	(let native_record_open "__extension__ ({")
	(let bind_native_record " wvrt_native_record=(")
	(let native_record_address ".wvrt_record;")
	(let verify_string_open "(void)wvrt_c_buffered_string(")
	(let verify_table_open "wvrt_c_buffered_string_table_require_aligned(")
	(let native_record_field "wvrt_native_record->")
	(let native_record_finish "wvrt_native_record;})")

	(fn write_buffered_record_borrow
		(:doc "Check declared pointer members before lending the exact original record to a native reader.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let type (expression.get type))
			(let layout (records.get (call record_index (call place_reference_target (borrow-shared records) type))))
			(let open (call c_literal_text (borrow-shared native_record_open) (borrow-mut output) offset writing))
			(let typed (call write_value_type (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				type (borrow-mut output) open name_prefix writing))
			(let bind (call c_literal_text (borrow-shared bind_native_record) (borrow-mut output) typed writing))
			(let cast_type (call write_value_type (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				type (borrow-mut output) bind name_prefix writing))
			(let cast (call c_byte (borrow-mut output) cast_type 41u8 writing))
			(let name (call write_temporary_name (borrow-shared nodes) (expression.get first) (borrow-mut output) cast name_prefix writing))
			(let-mut cursor (call c_literal_text (borrow-shared native_record_address) (borrow-mut output) name writing))
			(let-mut field (layout.get first))
			(while
				(:doc "Inspect each exposed pointer field using the same original byte range as a Wove field read.")
				(i32:not-ltz field)
				(body
					(let node (nodes.get field))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let mode (call c_pointer_field_kind (borrow-shared source) (nodes.get (parts.get operands))))
					(if
						(:doc "Nonpointer fields require only their existing exact layout check.")
						(u32:gtz mode)
						(then
							(if
								(:doc "A raw C consumer needs an aligned table. Wove reads already handle unaligned slots.")
								(u32:eq mode cstrs_field_kind)
								(then (set cursor (call c_literal_text (borrow-shared verify_table_open)
									(borrow-mut output) cursor writing)))
								(else (set cursor (call c_literal_text (borrow-shared verify_string_open)
									(borrow-mut output) cursor writing))))
							(set cursor (call write_temporary_name (borrow-shared nodes)
								(expression.get first) (borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_literal_text (borrow-shared record_byte_argument) (borrow-mut output) cursor writing))
							(set cursor (call c_literal_text (borrow-shared native_record_field) (borrow-mut output) cursor writing))
							(let member (nodes.get (node.get first_child)))
							(set cursor (call c_span (borrow-shared source) (member.get start) (member.get end)
								(borrow-mut output) cursor writing))
							(set cursor (call close_runtime_call (borrow-mut output) cursor (expression.get target)
								(expression.get start) (expression.get end) writing))
							(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))))
					(set field (node.get next_sibling))))
			(return (call c_literal_text (borrow-shared native_record_finish) (borrow-mut output) cursor writing))))
)
