(module emit_floats
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write native floating literals, bit copies, and checked numerical conversions.`)

	(use wove-file "../source/types.wove" (only is_builtin_float is_128bit_integer is_256bit_integer is_signed_integer_value (value f16_type) (value f32_type) (value f64_type) (value f80_type) (value f128_type)
		(value i16_type) (value u16_type) (value i64_type)))
	(use wove-file "../source/float_ops.wove" (only (value float_from_bits) (value float_to_bits)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./text.wove" (only c_byte c_span c_cast c_literal_text write_temporary_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))

	(let point_zero ".0")
	(let half_suffix "F16")
	(let quad_literal "WVRT_F128_LITERAL(")
	(let from_u16_bits "wvrt_f16_from_bits(")
	(let to_u16_bits "wvrt_f16_to_bits(")
	(let from_u32_bits "wvrt_f32_from_bits(")
	(let to_u32_bits "wvrt_f32_to_bits(")
	(let from_u64_bits "wvrt_f64_from_bits(")
	(let to_u64_bits "wvrt_f64_to_bits(")
	(let narrow_f32 "wvrt_f32_narrow(")
	(let narrow_f16 "wvrt_f16_narrow(")
	(let float_to_integer "wvrt_float_to_integer(")
	(let extended_to_integer "wvrt_f80_to_integer(")
	(let extended_to_half "wvrt_f80_to_f16(")
	(let extended_to_float "wvrt_f80_to_f32(")
	(let extended_to_double "wvrt_f80_to_f64(")
	(let quad_to_integer "wvrt_f128_to_integer(")
	(let quad_to_half "wvrt_f128_to_f16(")
	(let quad_to_float "wvrt_f128_to_f32(")
	(let quad_to_double "wvrt_f128_to_f64(")
	(let quad_to_extended "wvrt_f128_to_f80(")
	(let i8_bounds ",-129.0,0x1p7")
	(let u8_bounds ",-1.0,0x1p8")
	(let i16_bounds ",-32769.0,0x1p15")
	(let u16_bounds ",-1.0,0x1p16")
	(let i32_bounds ",-2147483649.0,0x1p31")
	(let u32_bounds ",-1.0,0x1p32")
	(let i64_bounds ",-0x1.0000000000001p63,0x1p63")
	(let extended_i64_bounds ",-0x1p63L-1.0L,0x1p63L")
	(let quad_i64_bounds ",-WVRT_F128_LITERAL(9223372036854775809.0),0x1p63")
	(let u64_bounds ",-1.0,0x1p64")
	(let check_wide_input "wvrt_check_float_to_wide_int(")
	(let check_wide_output "wvrt_check_wide_int_to_float(")
	(let int256_to_extended "wvrt_int256_to_f80(")
	(let i128_float_bounds ",-0x1p127,0x1p127,1")
	(let u128_float_bounds ",-1.0,0x1p128,0")
	(let i256_float_bounds ",-0x1p255,0x1p255,1")
	(let u256_float_bounds ",-1.0,0x1p256,0")
	(let signed_half_limit ",65504,1")
	(let unsigned_half_limit ",65504,0")
	(let signed_f32_limit ",0x1.fffffep127F,1")
	(let unsigned_f32_limit ",0x1.fffffep127F,0")

	(fn write_floating_literal
		(:doc `Retain the original sign and digits and let Clang round to the final width.`)
		(params (source (shared-array u8)) (row ScalarExpression)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get (local row) type))
			(let-mut cursor (local offset))
			(if
				(:doc "The runtime macro pastes the native binary128 suffix before C rounds the literal.")
				(u32.eq (local type) (local f128_type))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local quad_literal))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_span (borrow-shared (local source)) (struct.get (local row) start)
				(struct.get (local row) end) (borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "An integer-shaped decimal must become a C floating literal, including negative zero.")
				(i32.eq (struct.get (local row) target) 2i32)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local point_zero))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Use Clang's binary16 literal suffix to round directly to half.")
				(u32.eq (struct.get (local row) type) (local f16_type))
				(then (return (call c_literal_text (borrow-shared (local half_suffix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Use the binary32 suffix so a float is never rounded through double.")
				(u32.eq (struct.get (local row) type) (local f32_type))
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 70u8 (local writing)))))
			(if
				(:doc "An L suffix rounds the original decimal directly to native extended precision.")
				(u32.eq (struct.get (local row) type) (local f80_type))
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 76u8 (local writing)))))
			(if
				(:doc "Close the binary128 literal macro after preserving the sign and complete decimal.")
				(u32.eq (local type) (local f128_type))
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(return (local cursor))))

	(fn open_bit_copy
		(:doc `Choose the runtime bit-copy function from the direction and float width.`)
		(params (type u32) (from_bits bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Copy the exact binary16 representation to or from a u16.")
				(u32.eq (local type) (local f16_type))
				(then
					(if
						(:doc "Interpret all sixteen source bits as a native half object.")
						(local from_bits)
						(then (return (call c_literal_text (borrow-shared (local from_u16_bits))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local to_u16_bits))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Select a word-sized bit copy without a numeric conversion.")
				(u32.eq (local type) (local f32_type))
				(then
					(if
						(:doc "Copy a u32 into a C float object.")
						(local from_bits)
						(then (return (call c_literal_text (borrow-shared (local from_u32_bits))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local to_u32_bits))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Copy a u64 into a C double object.")
				(local from_bits)
				(then (return (call c_literal_text (borrow-shared (local from_u64_bits))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local to_u64_bits))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_quad_narrow
		(:doc "Select a checked conversion that rounds straight from binary128 to its destination.")
		(params (target u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Use the independently guarded binary16 helper.")
				(u32.eq (local target) (local f16_type))
				(then (return (call c_literal_text (borrow-shared (local quad_to_half))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Convert to binary32 in one rounding step.")
				(u32.eq (local target) (local f32_type))
				(then (return (call c_literal_text (borrow-shared (local quad_to_float))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The native x87 format has the same exponent range but fewer significand bits.")
				(u32.eq (local target) (local f80_type))
				(then (return (call c_literal_text (borrow-shared (local quad_to_extended))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local quad_to_double))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_float_narrow
		(:doc "Select the runtime check that rounds directly from the operand's precision.")
		(params (source u32) (target u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Select the helper whose argument stays in native binary128.")
				(u32.eq (local source) (local f128_type))
				(then (return (call write_quad_narrow (local target)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Keep the extra precision of an f80 operand through the range check and cast.")
				(u32.eq (local source) (local f80_type))
				(then
					(if
						(:doc "Use the binary16 destination's exact finite limit.")
						(u32.eq (local target) (local f16_type))
						(then (return (call c_literal_text (borrow-shared (local extended_to_half))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(if
						(:doc "Round straight from long double to float.")
						(u32.eq (local target) (local f32_type))
						(then (return (call c_literal_text (borrow-shared (local extended_to_float))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local extended_to_double))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "All smaller inputs use the existing half and binary32 checks.")
				(u32.eq (local target) (local f16_type))
				(then (return (call c_literal_text (borrow-shared (local narrow_f16))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local narrow_f32))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_float_integer_check
		(:doc "Select the integer range check without reducing the precision of the operand.")
		(params (source u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Preserve the original binary128 value through the open-interval check.")
				(u32.eq (local source) (local f128_type))
				(then (return (call c_literal_text (borrow-shared (local quad_to_integer))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Long double can distinguish all values adjacent to the i64 and u64 endpoints.")
				(u32.eq (local source) (local f80_type))
				(then (return (call c_literal_text (borrow-shared (local extended_to_integer))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local float_to_integer))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_integer_bounds
		(:doc `Write the exact open interval whose truncated values fit the destination type.`)
		(params (type u32) (source u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The lower limit is one less than INT8_MIN.")
				(u32.eq (local type) 61u32)
				(then (return (call c_literal_text (borrow-shared (local i8_bounds))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The unsigned byte upper limit is exactly 256.")
				(u32.eq (local type) 10u32)
				(then (return (call c_literal_text (borrow-shared (local u8_bounds))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Both signed word limits are exactly representable in double.")
				(u32.eq (local type) 5u32)
				(then (return (call c_literal_text (borrow-shared (local i32_bounds))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Fractions within one of the signed endpoints truncate toward zero.")
				(u32.eq (local type) (local i16_type))
				(then (return (call c_literal_text (borrow-shared (local i16_bounds))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The unsigned 16-bit conversion has an exclusive upper limit of 2^16.")
				(u32.eq (local type) (local u16_type))
				(then (return (call c_literal_text (borrow-shared (local u16_bounds))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The unsigned word upper limit is exactly 2^32.")
				(u32.eq (local type) 11u32)
				(then (return (call c_literal_text (borrow-shared (local u32_bounds))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Select the first excluded value near INT64_MIN at the operand's precision.")
				(u32.eq (local type) (local i64_type))
				(then
					(if
						(:doc "Use a binary128 literal for the lower endpoint on either native C representation.")
						(u32.eq (local source) (local f128_type))
						(then (return (call c_literal_text (borrow-shared (local quad_i64_bounds))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(if
						(:doc "Extended precision represents INT64_MIN minus one exactly.")
						(u32.eq (local source) (local f80_type))
						(then (return (call c_literal_text (borrow-shared (local extended_i64_bounds))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local i64_bounds))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local u64_bounds))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_wide_float_bounds
		(:doc "Write exact powers of two for wide destinations and exact finite limits for narrow float destinations.")
		(params (input u32) (target u32) (float_target bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The significand of each source format is too short to represent a fraction just below the signed minimum.")
				(bool.not (local float_target))
				(then
					(if
						(:doc "The optional 256-bit width uses its own exact powers of two.")
						(call is_256bit_integer (local target))
						(then
							(if
								(:doc "Select the signed 256-bit interval when the result carries a sign.")
								(call is_signed_integer_value (local target))
								(then (return (call c_literal_text (borrow-shared (local i256_float_bounds))
									(borrow-mut (local output)) (local offset) (local writing)))))
							(return (call c_literal_text (borrow-shared (local u256_float_bounds))
								(borrow-mut (local output)) (local offset) (local writing)))))
					(if
						(:doc "Signed truncation includes the negative power of two and excludes the positive one.")
						(call is_signed_integer_value (local target))
						(then (return (call c_literal_text (borrow-shared (local i128_float_bounds))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local u128_float_bounds))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Binary32 checks its finite limit against the captured integer.")
				(u32.eq (local target) (local f32_type))
				(then
					(if
						(:doc "A signed 256-bit input can exceed the negative binary32 limit.")
						(call is_signed_integer_value (local input))
						(then (return (call c_literal_text (borrow-shared (local signed_f32_limit))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local unsigned_f32_limit))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The binary16 range is symmetric for signed input.")
				(call is_signed_integer_value (local input))
				(then (return (call c_literal_text (borrow-shared (local signed_half_limit))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local unsigned_half_limit))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_wide_floating_conversion
		(:doc "Check captured wide conversions at their original precision and round once in the final format.")
		(params (source (shared-array u8)) (row ScalarExpression) (input u32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let target (struct.get (local row) type))
			(if
				(:doc "Round straight to x87 precision. Clang's direct cast can round through binary128 first.")
				(bool.and (u32.eq (local target) (local f80_type)) (call is_256bit_integer (local input)))
				(then
					(let open (call c_literal_text (borrow-shared (local int256_to_extended))
						(borrow-mut (local output)) (local offset) (local writing)))
					(let end (call write_temporary_name (borrow-shared (local source)) (struct.get (local row) first)
						(local tree_base) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local end) 41u8 (local writing)))))
			(let float_target (call is_builtin_float (local target)))
			(let half (bool.or (u32.eq (local input) (local f16_type)) (u32.eq (local target) (local f16_type))))
			(let check (bool.or (bool.not (local float_target))
				(bool.or (local half) (bool.and (u32.eq (local target) (local f32_type))
					(bool.or (call is_256bit_integer (local input))
						(bool.not (call is_signed_integer_value (local input))))))))
			(let-mut cursor (call c_cast (borrow-mut (local output)) (local offset) (local target) (local writing)))
			(if
				(:doc "Every admitted binary16 integer fits exactly in i32. This avoids unavailable wide half cast helpers.")
				(local half)
				(then (set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) 5u32 (local writing)))))
			(if
				(:doc "Use the original integer range for finite float limits and the original float for truncation checks.")
				(local check)
				(then
					(if
						(:doc "A floating destination compares the wide integer before rounding.")
						(local float_target)
						(then (set (local cursor) (call c_literal_text (borrow-shared (local check_wide_output))
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call c_literal_text (borrow-shared (local check_wide_input))
							(borrow-mut (local output)) (local cursor) (local writing)))))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (struct.get (local row) first)
				(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Only conversions with a range check carry a runtime site.")
				(local check)
				(then
					(set (local cursor) (call write_wide_float_bounds (local input) (local target) (local float_target)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(return (call close_runtime_call (borrow-mut (local output)) (local cursor)
						(struct.get (local row) target) (struct.get (local row) start) (struct.get (local row) end) (local writing)))))
			(return (local cursor))))

	(fn write_floating_conversion
		(:doc `Convert one captured operand and pass the original span to checks that can trap.`)
		(params (source (shared-array u8)) (row ScalarExpression) (input u32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get (local row) kind))
			(let target (struct.get (local row) type))
			(if
				(:doc "The wide mixed cases require exact checks before converting the captured operand.")
				(bool.or (bool.or (call is_128bit_integer (local input)) (call is_128bit_integer (local target)))
					(bool.or (call is_256bit_integer (local input)) (call is_256bit_integer (local target))))
				(then (return (call write_wide_floating_conversion (borrow-shared (local source)) (local row) (local input)
					(local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let from_bits (u32.eq (local kind) (local float_from_bits)))
			(let to_bits (u32.eq (local kind) (local float_to_bits)))
			(let wide (bool.or (u32.eq (local input) (local f80_type)) (u32.eq (local input) (local f128_type))))
			(let float_target (call is_builtin_float (local target)))
			(let checked_integer (bool.and (bool.not (bool.or (local from_bits) (local to_bits)))
				(bool.not (local float_target))))
			(let narrow (bool.and (bool.not (local from_bits))
				(bool.and (u32.not-eq (local input) (local target))
					(bool.or (bool.and (local wide)
						(bool.and (local float_target) (u32.not-eq (local target) (local f128_type))))
						(bool.or (bool.and (u32.eq (local input) (local f64_type)) (u32.eq (local target) (local f32_type)))
							(u32.eq (local target) (local f16_type)))))))
			(let-mut cursor (local offset))
			(if
				(:doc "Bit operations pass the original type to a width-matched copy.")
				(bool.or (local from_bits) (local to_bits))
				(then
					(let-mut type (local input))
					(if (local from_bits) (then (set (local type) (local target))))
					(set (local cursor) (call open_bit_copy (local type) (local from_bits)
						(borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(if
						(:doc "A narrow helper checks finite range before rounding to the selected width.")
						(local narrow)
						(then (set (local cursor) (call write_float_narrow (local input) (local target)
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else
							(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) (local target) (local writing)))
							(if
								(:doc "A float-to-integer cast must check the source before truncating.")
								(local checked_integer)
								(then (set (local cursor) (call write_float_integer_check (local input)
									(borrow-mut (local output)) (local cursor) (local writing)))))))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (struct.get (local row) first)
				(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Only integer destinations use a destination-specific open interval.")
				(local checked_integer)
				(then (set (local cursor) (call write_integer_bounds (local target) (local input)
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Attach the Wove span to either checked numerical conversion.")
				(bool.or (local checked_integer) (local narrow))
				(then (return (call close_runtime_call (borrow-mut (local output)) (local cursor)
					(struct.get (local row) target) (struct.get (local row) start) (struct.get (local row) end) (local writing)))))
			(if
				(:doc "Bit copies close a runtime call. Plain C casts have no call to close.")
				(bool.or (local from_bits) (local to_bits))
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(return (local cursor)))))
