(module emit_library_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write the checked pointer and count ABI for synchronous C export view parameters.")

	(use wove-file "../source/types.wove" (only is_builtin_integer is_128bit_integer void_type (value f32_type) (value f64_type)))
	(use wove-file "../scalar/records.wove" (only is_readable_slice is_writable_slice slice_element_code))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text))
	(use wove-file "./runtime.wove" (only write_c_number))

	(let export_view_runtime `#define WVRT_C_EXPORT_VIEWS
#include "wove_runtime.h"
#undef WVRT_C_EXPORT_VIEWS
`)
	(let export_view_header `#include <stddef.h>
#ifndef WVRT_C_EXPORT_STATUS_DEFINED
#define WVRT_C_EXPORT_STATUS_DEFINED
typedef int32_t WvrtCStatus;
#define WVRT_C_EXPORT_OK ((WvrtCStatus)0)
#define WVRT_C_EXPORT_INVALID_ARGUMENT ((WvrtCStatus)1)
#define WVRT_C_EXPORT_OVERLAP ((WvrtCStatus)2)
#endif
`)
	(let export_status_type "WvrtCStatus")
	(let public_bool "bool")
	(let export_argument_name "wvex_arg")
	(let count_name "wvex_count")
	(let const_prefix "const ")
	(let count_type ", size_t")
	(let separator ", ")
	(let shared_descriptor "(wvrt_slice){")
	(let mutable_descriptor "(wvrt_mut_slice){")
	(let empty_base " == 0 ? &wvex_empty : (")
	(let shared_pointer "const void *")
	(let mutable_pointer "void *")
	(let count_cast ", (int32_t)")
	(let stride_prefix ", sizeof(*")
	(let stride_close ")}")
	(let result_name " wvex_result")
	(let result_value " wvex_value = ")
	(let save_result "*wvex_result = wvex_value;\n")
	(let finish_view_call "return WVRT_C_EXPORT_OK;\n}\n")
	(let views_open "\nwvrt_c_export_view wvex_views[] = {\n")
	(let align_open "), _Alignof(")
	(let slot_close "), ")
	(let shared_check ", false, 0},\n")
	(let mutable_check ", true, 0},\n")
	(let validate_call "};\nWvrtCStatus wvex_status = wvrt_c_export_validate(wvex_views, sizeof(wvex_views) / sizeof(*wvex_views), ")
	(let no_result "NULL, 0, 0")
	(let result_size "wvex_result, sizeof(*wvex_result), _Alignof(")
	(let validate_close ");\nif (wvex_status != WVRT_C_EXPORT_OK) return wvex_status;\nmax_align_t wvex_empty = {0};\n")

	(fn export_scalar
		(:doc "Allow the archive's portable exact-width scalar ABI.")
		(params (type u32)) (returns bool)
		(body
			(return (bool.or (bool.or (u32.eq (local type) (local f32_type)) (u32.eq (local type) (local f64_type)))
				(bool.or (u32.eq (local type) 12u32)
					(bool.and (call is_builtin_integer (local type)) (bool.not (call is_128bit_integer (local type)))))))))

	(fn export_view_element
		(:doc "Recover the supported builtin scalar element, leaving ordinary values and unsupported views at zero.")
		(params (type u32)) (returns u32)
		(body
			(if
				(:doc "Only array borrow descriptors carry the element needed by this ABI.")
				(call is_readable_slice (local type))
				(then
					(let element (call slice_element_code (local type)))
					(if (call export_scalar (local element)) (then (return (local element))))))
			(return 0u32)))

	(fn has_export_views
		(:doc "Select the checked status ABI for a function with at least one admitted view.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Examine only the exact signature's parameter rows.")
				(i32.lt (local index) (struct.get (local function) arity))
				(body
					(let row (array.load (local parameters) (i32.add (struct.get (local function) params) (local index))))
					(if (u32.gtz (call export_view_element (struct.get (local row) type))) (then (return (bool true))))
					(set (local index) (i32.inc (local index)))))
			(return (bool false))))

	(fn write_export_type
		(:doc "Use the portable bool spelling in public C and C++ prototypes.")
		(params (type u32) (public bool) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(if
				(:doc "C's stdbool.h and C++ agree on bool.")
				(bool.and (local public) (u32.eq (local type) 12u32))
				(then (return (call c_literal_text (borrow-shared (local public_bool)) (borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_type_text (borrow-mut (local output)) (local offset) (local type) (local writing)))))

	(fn write_indexed_name
		(:doc "Use the Wove formal position to keep generated pointer and count names stable.")
		(params (prefix (shared-array u8)) (index i32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let start (call c_literal_text (borrow-shared (local prefix)) (borrow-mut (local output)) (local offset) (local writing)))
			(return (call write_c_number (borrow-mut (local output)) (local start) (local index) (local writing)))))

	(fn write_view_formals
		(:doc "Expand a view in a prototype to its qualified data pointer followed by an element count.")
		(params (element u32) (writable bool) (index i32) (public bool)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Shared view parameters expose a const-qualified pointee.")
				(bool.not (local writable))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local const_prefix)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(let type (call write_export_type (local element) (local public) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local type) 42u8 (local writing)))
			(if
				(:doc "Only the internal overlay needs names for its arguments.")
				(bool.not (local public))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
					(set (local cursor) (call write_indexed_name (borrow-shared (local export_argument_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local count_type)) (borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Header counts remain anonymous alongside their pointer.")
				(local public)
				(then (return (local cursor))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(return (call write_indexed_name (borrow-shared (local count_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_view_value
		(:doc "Form a private Wove descriptor only after the C arguments have passed validation.")
		(params (writable bool) (index i32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Choose the descriptor constructor for the declared permission.")
				(local writable)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local mutable_descriptor)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local shared_descriptor)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_indexed_name (borrow-shared (local count_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local empty_base)) (borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Both arms of the conditional use the descriptor's void pointer type.")
				(local writable)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local mutable_pointer)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local shared_pointer)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
			(set (local cursor) (call write_indexed_name (borrow-shared (local export_argument_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local count_cast)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_indexed_name (borrow-shared (local count_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local stride_prefix)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_indexed_name (borrow-shared (local export_argument_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(return (call c_literal_text (borrow-shared (local stride_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_view_check_row
		(:doc "Describe one exact view for checked byte extents and overlap.")
		(params (row ScalarParameter) (element u32) (index i32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut (local output)) (local offset) 123u8 (local writing)))
			(set (local cursor) (call write_indexed_name (borrow-shared (local export_argument_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local separator)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_indexed_name (borrow-shared (local count_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local stride_prefix)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_indexed_name (borrow-shared (local export_argument_name)) (local index) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local align_open)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_export_type (local element) (bool false) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local slot_close)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor) (struct.get (local row) extent) (local writing)))
			(if
				(:doc "The runtime compares a mutable view with every other view's bytes.")
				(call is_writable_slice (struct.get (local row) type))
				(then (return (call c_literal_text (borrow-shared (local mutable_check)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local shared_check)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_result_formal
		(:doc "Append an anonymous or private scalar output pointer after every ordinary formal.")
		(params (type u32) (public bool) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let start (call c_literal_text (borrow-shared (local separator)) (borrow-mut (local output)) (local offset) (local writing)))
			(let pointee (call write_export_type (local type) (local public) (borrow-mut (local output)) (local start) (local writing)))
			(let pointer (call c_byte (borrow-mut (local output)) (local pointee) 42u8 (local writing)))
			(if (local public) (then (return (local pointer))))
			(return (call c_literal_text (borrow-shared (local result_name)) (borrow-mut (local output)) (local pointer) (local writing)))))

	(fn write_view_checks
		(:doc "Validate every required address and view before calling Wove. Capture a result separately from its destination.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local views_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(let-mut index 0i32)
			(while
				(:doc "The runtime only receives rows for borrowed arguments, in source order.")
				(i32.lt (local index) (struct.get (local function) arity))
				(body
					(let row (array.load (local parameters) (i32.add (struct.get (local function) params) (local index))))
					(let element (call export_view_element (struct.get (local row) type)))
					(if
						(:doc "Scalars are passed through the ordinary exact C ABI.")
						(u32.gtz (local element))
						(then (set (local cursor) (call write_view_check_row (local row) (local element) (local index) (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local index) (i32.inc (local index)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local validate_call)) (borrow-mut (local output)) (local cursor) (local writing)))
			(let result (struct.get (local function) result))
			(if
				(:doc "Void wrappers have no result address to validate or write.")
				(u32.eq (local result) (call void_type))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local no_result)) (borrow-mut (local output)) (local cursor) (local writing)))
					(return (call c_literal_text (borrow-shared (local validate_close)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local result_size)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_export_type (local result) (bool false) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local validate_close)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_export_type (local result) (bool false) (borrow-mut (local output)) (local cursor) (local writing)))
			(return (call c_literal_text (borrow-shared (local result_value)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_view_return
		(:doc "End the loan before writing a successful scalar result, including an alias of a view.")
		(params (result u32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let close (call c_byte (borrow-mut (local output)) (local offset) 41u8 (local writing)))
			(let semi (call c_byte (borrow-mut (local output)) (local close) 59u8 (local writing)))
			(let-mut cursor (call c_byte (borrow-mut (local output)) (local semi) 10u8 (local writing)))
			(if
				(:doc "Keep the output pointer store after the Wove call statement.")
				(u32.not-eq (local result) (call void_type))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local save_result)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local finish_view_call)) (borrow-mut (local output)) (local cursor) (local writing)))))
)
