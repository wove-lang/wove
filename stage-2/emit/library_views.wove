(module emit_library_views
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write the checked pointer and count ABI for synchronous C export view parameters.")

	(use wove-file "../source/types.wove" (only is_builtin_integer is_128bit_integer void_type (value f32_type) (value f64_type)))
	(use wove-file "../scalar/records.wove" (only is_readable_slice is_writable_slice slice_element_code))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text))
	(use wove-file "./runtime.wove" (only write_c_number))

	(let export_view_runtime `#define WVRT_C_EXPORT_VIEWS
#include "wove_runtime.h"
#undef WVRT_C_EXPORT_VIEWS
`)
	(let export_view_header `#include <stddef.h>
#ifndef WVRT_C_EXPORT_STATUS_DEFINED
#define WVRT_C_EXPORT_STATUS_DEFINED
typedef int32_t WvrtCStatus;
#define WVRT_C_EXPORT_OK ((WvrtCStatus)0)
#define WVRT_C_EXPORT_INVALID_ARGUMENT ((WvrtCStatus)1)
#define WVRT_C_EXPORT_OVERLAP ((WvrtCStatus)2)
#endif
`)
	(let export_status_type "WvrtCStatus")
	(let public_bool "bool")
	(let export_argument_name "wvex_arg")
	(let count_name "wvex_count")
	(let const_prefix "const ")
	(let count_type ", size_t")
	(let separator ", ")
	(let shared_descriptor "(wvrt_slice){")
	(let mutable_descriptor "(wvrt_mut_slice){")
	(let empty_base " == 0 ? &wvex_empty : (")
	(let shared_pointer "const void *")
	(let mutable_pointer "void *")
	(let count_cast ", (int32_t)")
	(let stride_prefix ", sizeof(*")
	(let stride_close ")}")
	(let result_name " wvex_result")
	(let result_value " wvex_value = ")
	(let save_result "*wvex_result = wvex_value;\n")
	(let finish_view_call "return WVRT_C_EXPORT_OK;\n}\n")
	(let views_open "\nwvrt_c_export_view wvex_views[] = {\n")
	(let align_open "), _Alignof(")
	(let slot_close "), ")
	(let shared_check ", false, 0},\n")
	(let mutable_check ", true, 0},\n")
	(let validate_call "};\nWvrtCStatus wvex_status = wvrt_c_export_validate(wvex_views, sizeof(wvex_views) / sizeof(*wvex_views), ")
	(let no_result "NULL, 0, 0")
	(let result_size "wvex_result, sizeof(*wvex_result), _Alignof(")
	(let validate_close ");\nif (wvex_status != WVRT_C_EXPORT_OK) return wvex_status;\nmax_align_t wvex_empty = {0};\n")

	(fn export_scalar
		(:doc "Allow the archive's portable exact-width scalar ABI.")
		(params (type u32)) (returns bool)
		(body
			(return (bool:or (bool:or (u32:eq type f32_type) (u32:eq type f64_type))
				(bool:or (u32:eq type 12u32)
					(bool:and (call is_builtin_integer type) (bool:not (call is_128bit_integer type))))))))

	(fn export_view_element
		(:doc "Recover the supported builtin scalar element, leaving ordinary values and unsupported views at zero.")
		(params (type u32)) (returns u32)
		(body
			(if
				(:doc "Only array borrow descriptors carry the element needed by this ABI.")
				(call is_readable_slice type)
				(then
					(let element (call slice_element_code type))
					(if (call export_scalar element) (then (return element)))))
			(return 0u32)))

	(fn has_export_views
		(:doc "Select the checked status ABI for a function with at least one admitted view.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Examine only the exact signature's parameter rows.")
				(i32:lt index (struct:get function arity))
				(body
					(let row (array:get parameters (i32:add (struct:get function params) index)))
					(if (u32:gtz (call export_view_element (struct:get row type))) (then (return (bool true))))
					(set index (i32:inc index))))
			(return (bool false))))

	(fn write_export_type
		(:doc "Use the portable bool spelling in public C and C++ prototypes.")
		(params (type u32) (public bool) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(if
				(:doc "C's stdbool.h and C++ agree on bool.")
				(bool:and public (u32:eq type 12u32))
				(then (return (call c_literal_text (borrow-shared public_bool) (borrow-mut output) offset writing))))
			(return (call c_type_text (borrow-mut output) offset type writing))))

	(fn write_indexed_name
		(:doc "Use the Wove formal position to keep generated pointer and count names stable.")
		(params (prefix (shared-array u8)) (index i32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let start (call c_literal_text (borrow-shared prefix) (borrow-mut output) offset writing))
			(return (call write_c_number (borrow-mut output) start index writing))))

	(fn write_view_formals
		(:doc "Expand a view in a prototype to its qualified data pointer followed by an element count.")
		(params (element u32) (writable bool) (index i32) (public bool)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Shared view parameters expose a const-qualified pointee.")
				(bool:not writable)
				(then (set cursor (call c_literal_text (borrow-shared const_prefix) (borrow-mut output) cursor writing))))
			(let type (call write_export_type element public (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) type 42u8 writing))
			(if
				(:doc "Only the internal overlay needs names for its arguments.")
				(bool:not public)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
					(set cursor (call write_indexed_name (borrow-shared export_argument_name) index (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared count_type) (borrow-mut output) cursor writing))
			(if
				(:doc "Header counts remain anonymous alongside their pointer.")
				public
				(then (return cursor)))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(return (call write_indexed_name (borrow-shared count_name) index (borrow-mut output) cursor writing))))

	(fn write_view_value
		(:doc "Form a private Wove descriptor only after the C arguments have passed validation.")
		(params (writable bool) (index i32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Choose the descriptor constructor for the declared permission.")
				writable
				(then (set cursor (call c_literal_text (borrow-shared mutable_descriptor) (borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared shared_descriptor) (borrow-mut output) cursor writing))))
			(set cursor (call write_indexed_name (borrow-shared count_name) index (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared empty_base) (borrow-mut output) cursor writing))
			(if
				(:doc "Both arms of the conditional use the descriptor's void pointer type.")
				writable
				(then (set cursor (call c_literal_text (borrow-shared mutable_pointer) (borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared shared_pointer) (borrow-mut output) cursor writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call write_indexed_name (borrow-shared export_argument_name) index (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared count_cast) (borrow-mut output) cursor writing))
			(set cursor (call write_indexed_name (borrow-shared count_name) index (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared stride_prefix) (borrow-mut output) cursor writing))
			(set cursor (call write_indexed_name (borrow-shared export_argument_name) index (borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared stride_close) (borrow-mut output) cursor writing))))

	(fn write_view_check_row
		(:doc "Describe one exact view for checked byte extents and overlap.")
		(params (row ScalarParameter) (element u32) (index i32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut output) offset 123u8 writing))
			(set cursor (call write_indexed_name (borrow-shared export_argument_name) index (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared separator) (borrow-mut output) cursor writing))
			(set cursor (call write_indexed_name (borrow-shared count_name) index (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared stride_prefix) (borrow-mut output) cursor writing))
			(set cursor (call write_indexed_name (borrow-shared export_argument_name) index (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared align_open) (borrow-mut output) cursor writing))
			(set cursor (call write_export_type element (bool false) (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared slot_close) (borrow-mut output) cursor writing))
			(set cursor (call write_c_number (borrow-mut output) cursor (struct:get row extent) writing))
			(if
				(:doc "The runtime compares a mutable view with every other view's bytes.")
				(call is_writable_slice (struct:get row type))
				(then (return (call c_literal_text (borrow-shared mutable_check) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared shared_check) (borrow-mut output) cursor writing))))

	(fn write_result_formal
		(:doc "Append an anonymous or private scalar output pointer after every ordinary formal.")
		(params (type u32) (public bool) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let start (call c_literal_text (borrow-shared separator) (borrow-mut output) offset writing))
			(let pointee (call write_export_type type public (borrow-mut output) start writing))
			(let pointer (call c_byte (borrow-mut output) pointee 42u8 writing))
			(if public (then (return pointer)))
			(return (call c_literal_text (borrow-shared result_name) (borrow-mut output) pointer writing))))

	(fn write_view_checks
		(:doc "Validate every required address and view before calling Wove. Capture a result separately from its destination.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared views_open) (borrow-mut output) offset writing))
			(let-mut index 0i32)
			(while
				(:doc "The runtime only receives rows for borrowed arguments, in source order.")
				(i32:lt index (struct:get function arity))
				(body
					(let row (array:get parameters (i32:add (struct:get function params) index)))
					(let element (call export_view_element (struct:get row type)))
					(if
						(:doc "Scalars are passed through the ordinary exact C ABI.")
						(u32:gtz element)
						(then (set cursor (call write_view_check_row row element index (borrow-mut output) cursor writing))))
					(set index (i32:inc index))))
			(set cursor (call c_literal_text (borrow-shared validate_call) (borrow-mut output) cursor writing))
			(let result (struct:get function result))
			(if
				(:doc "Void wrappers have no result address to validate or write.")
				(u32:eq result (call void_type))
				(then
					(set cursor (call c_literal_text (borrow-shared no_result) (borrow-mut output) cursor writing))
					(return (call c_literal_text (borrow-shared validate_close) (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared result_size) (borrow-mut output) cursor writing))
			(set cursor (call write_export_type result (bool false) (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call c_literal_text (borrow-shared validate_close) (borrow-mut output) cursor writing))
			(set cursor (call write_export_type result (bool false) (borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared result_value) (borrow-mut output) cursor writing))))

	(fn write_view_return
		(:doc "End the loan before writing a successful scalar result, including an alias of a view.")
		(params (result u32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let close (call c_byte (borrow-mut output) offset 41u8 writing))
			(let semi (call c_byte (borrow-mut output) close 59u8 writing))
			(let-mut cursor (call c_byte (borrow-mut output) semi 10u8 writing))
			(if
				(:doc "Keep the output pointer store after the Wove call statement.")
				(u32:not-eq result (call void_type))
				(then (set cursor (call c_literal_text (borrow-shared save_result) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared finish_view_call) (borrow-mut output) cursor writing))))
)
