(module emit_integer_checks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write nontrapping integer operations from captured operands and the checked output place.")

	(use wove-file "../source/types.wove" (only is_256bit_integer))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/integer_checks.wove" (only (value integer_fits) (value integer_try_add)
		(value integer_try_sub) (value integer_try_mul) (value integer_try_div) (value integer_try_rem)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text write_temporary_name))

	(let fits_open "wvrt_int_fits_type(")
	(let add_open "wvrt_int_try_overflow(__builtin_add_overflow,")
	(let sub_open "wvrt_int_try_overflow(__builtin_sub_overflow,")
	(let mul_open "wvrt_int_try_overflow(__builtin_mul_overflow,")
	(let bitint_mul_open "wvrt_int_try_overflow(wvrt_int256_mul_overflow,")
	(let divide_open "wvrt_int_try_divide(")

	(fn open_integer_try
		(:doc "Select the overflow builtin or the guarded quotient and remainder helper.")
		(params (kind u32) (type u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Addition uses the compiler's result-width check.")
				(u32:eq kind integer_try_add)
				(then (return (call c_literal_text (borrow-shared add_open) (borrow-mut output) offset writing))))
			(if
				(:doc "Subtraction uses the same result-width contract.")
				(u32:eq kind integer_try_sub)
				(then (return (call c_literal_text (borrow-shared sub_open) (borrow-mut output) offset writing))))
			(if
				(:doc "Multiplication uses the destination type even for promoted narrow inputs.")
				(u32:eq kind integer_try_mul)
				(then
					(if
						(:doc "Use the same full-width product check as the trapping form.")
						(call is_256bit_integer type)
						(then (return (call c_literal_text (borrow-shared bitint_mul_open)
							(borrow-mut output) offset writing))))
					(return (call c_literal_text (borrow-shared mul_open)
						(borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared divide_open) (borrow-mut output) offset writing))))

	(fn write_integer_check
		(:doc "Call the selected runtime operation after evaluating all of its children in source order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct:get row kind))
			(let-mut cursor offset)
			(if
				(:doc "The range predicate takes a C type and one captured input.")
				(u32:eq kind integer_fits)
				(then
					(set cursor (call c_literal_text (borrow-shared fits_open)
						(borrow-mut output) cursor writing))
					(set cursor (call c_type_text (borrow-mut output) cursor
						(u32:from-i32 (struct:get row target)) writing))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing)))
				(else
					(set cursor (call open_integer_try kind (u32:from-i32 (struct:get row target))
						(borrow-mut output)
						cursor writing))))
			(let start (struct:get row first))
			(let-mut operand start)
			(while
				(:doc "Use each capture once, with the writeback pointer after both arithmetic inputs.")
				(i32:lt -1i32 operand)
				(body
					(if
						(:doc "Separate each subsequent C argument from its predecessor.")
						(i32:not-eq operand start)
						(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
					(set cursor (call write_temporary_name (borrow-shared nodes) operand (borrow-mut output) cursor name_prefix writing))
					(set operand (struct:get (array:get nodes operand) next_sibling))))
			(if
				(:doc "Tell the guarded divide helper whether to compute the quotient or the remainder.")
				(bool:or (u32:eq kind integer_try_div) (u32:eq kind integer_try_rem))
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(let-mut mode 48u8)
					(if (u32:eq kind integer_try_rem) (then (set mode 49u8)))
					(set cursor (call c_byte (borrow-mut output) cursor mode writing))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))
)
