(module emit_c_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check native byte extents using values already evaluated by the call writer.

	Extent checks read the borrowed descriptors. The native call itself
	uses their original backing pointers.`)

	(use wove-file "../c/arguments.wove" (only is_c_bytes_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarFunction) (type ScalarParameter) (type ScalarExpression)))
	(use wove-file "./runtime.wove" (only open_shared_projection close_runtime_call))
	(use wove-file "./text.wove" (only c_byte write_temporary_name))

	(struct CActual (fields (node i32)))

	(fn open_c_byte_check
		(:doc `Open the runtime's checked byte extent call.`)
		(params (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 119) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 104) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 107) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 98) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 121) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(return (local cursor))))

	(fn map_c_actuals
		(:doc `Index the captured expression rows by their positions in the signature.`)
		(params (nodes (shared-slice SourceNode)) (first i32) (output (mut-slice CActual)))
		(returns void)
		(body
			(let-mut argument (local first))
			(let-mut index (i32 0))
			(while
				(:doc "Arity checking established one actual for each formal.")
				(i32.lt (local index) (slice.len (local output)))
				(body
					(slice.store (local output) (local index) (record.make CActual (node (local argument))))
					(set (local argument) (record.get (slice.load (local nodes) (local argument)) next_sibling))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))))

	(fn write_c_byte_check
		(:doc `Write one byte limit check for the data argument and its captured dimensions.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (actuals (shared-slice CActual))
			(argument i32) (parameter ScalarParameter) (caller ScalarFunction)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (record.get (local caller) tree_base))
			(let mutable (u32.eq (record.get (local parameter) type) (u32 38)))
			(let-mut cursor (call open_c_byte_check (borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "Check a mutable descriptor through the same read-only runtime view.")
				(local mutable)
				(then (set (local cursor) (call open_shared_projection (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local argument) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "The projection ends before the extent operands.")
				(local mutable)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
			(let size (record.get (local parameter) c_size))
			(if
				(:doc "The count-only form uses an implicit byte size of one.")
				(i32.lt (local size) (i32 0))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 49) (local writing))))
				(else
					(set (local cursor) (call write_temporary_name (borrow-shared (local source))
						(record.get (slice.load (local actuals) (local size)) node) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source))
				(record.get (slice.load (local actuals) (record.get (local parameter) c_count)) node) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(let node (slice.load (local nodes) (local argument)))
			(let source_base (record.get (local caller) source_base))
			(set (local cursor) (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(record.get (local caller) file) (i32.sub.wrapping (record.get (local node) start) (local source_base))
				(i32.sub.wrapping (record.get (local node) end) (local source_base)) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))))

	(fn write_mapped_c_byte_checks
		(:doc `Emit the checks using a shared map of temporary rows.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parameters (shared-slice ScalarParameter))
			(actuals (shared-slice CActual)) (caller ScalarFunction) (callee ScalarFunction)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let arity (slice.len (local actuals)))
			(let-mut index (i32 0))
			(let-mut cursor (local offset))
			(while
				(:doc "Check byte extents in formal order from the evaluated descriptors and integers.")
				(i32.lt (local index) (local arity))
				(body
					(let parameter (slice.load (local parameters) (i32.add.wrapping (record.get (local callee) params) (local index))))
					(if
						(:doc "String conversions and ordinary scalars have separate lowering.")
						(call is_c_bytes_mode (record.get (local parameter) c_mode))
						(then
							(set (local cursor) (call write_c_byte_check (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local actuals)) (record.get (slice.load (local actuals) (local index)) node) (local parameter) (local caller)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local cursor))))

	(fn write_c_byte_checks
		(:doc `Check every bounded byte view before converting strings or invoking C.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parameters (shared-slice ScalarParameter))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let arity (record.get (local callee) arity))
			(let-mut actuals (array.alloc CActual (local arity)))
			(call map_c_actuals (borrow-shared (local nodes)) (record.get (local expression) first) (borrow-mut (local actuals)))
			(return (call write_mapped_c_byte_checks (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (borrow-shared (local actuals)) (local caller) (local callee)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing))))))
