(module emit_c_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit live C header expressions and check their declared type and access through the included header.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only is_builtin_integer is_signed_integer_value))
	(use wove-file "../scalar/flow.wove" (only is_c_value_binding (type ScalarStatement)
		(value c_constant_binding) (value c_readonly_binding) (value c_writable_binding) (value c_macro_binding) (value c_lossless_macro_binding)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "../scalar/owners.wove" (only optional_byte_owner_type))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/binding_names.wove" (only binding_name_identity))
	(use wove-file "../scalar/records.wove" (only is_native_integer byte_rows_owner_type (type ScalarRecord)))
	(use wove-file "./c_vectors.wove" (only write_c_vector_declaration))
	(use wove-file "./c_snapshots.wove" (only (value borrowed_snapshot)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./owners.wove" (only write_native_type))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text get_name readonly_type_name_role (type CNameParent) (type CNameSpelling)))

	(let constant_open "_Static_assert((")
	(let constant_equal "|0)==(")
	(let native_constant_equal "|0)==((")
	(let native_constant_integer "|0)")
	(let constant_sign_left "&&((0<")
	(let constant_sign_cast ")==(0<(")
	(let constant_close ")),\"Wove C constant must fit its declared type\");\n")
	(let typedef_open "typedef ")
	(let typedef_close ";\n")
	(let storage_open "_Static_assert(")
	(let generic_open "_Generic(")
	(let expression_open "_Static_assert(_Generic(")
	(let expression_type ",__typeof__((")
	(let expression_match ")0):1")
	(let generic_const "const ")
	(let generic_pointer_match "*:1")
	(let generic_value_match ":1")
	(let generic_close ",default:0)")
	(let storage_alternative "||")
	(let storage_close ",\"Wove C value does not match its declared type\");\n")
	(let string_check_begin "_Static_assert(_Generic(&")
	(let string_check_end ",char**:1,default:0),\"Wove C string lvalue must have type char *\");\n")

	(fn is_c_vector_snapshot
		(:doc "Recognize the checked read that copies a borrowed native string vector.")
		(params (row ScalarStatement)) (returns bool)
		(body (return (bool:and (u32:eq (row.get kind) c_readonly_binding)
			(u32:eq (row.get type) (call byte_rows_owner_type))))))

	(fn is_borrowed_c_value
		(:doc "Recognize a live native pointer whose storage stays owned by C.")
		(params (row ScalarStatement)) (returns bool)
		(body (return (bool:and (u32:eq (row.get kind) c_readonly_binding)
			(bool:or (call is_native_owner (row.get type)) (call is_c_vector_snapshot row))))))

	(fn is_c_integer_constant
		(:doc "Recognize checked native constant declarations that only need an integer expression assertion.")
		(params (row ScalarStatement)) (returns bool)
		(body
			(let type (row.get type))
			(return (bool:and (u32:eq (row.get kind) c_constant_binding)
				(bool:or (call is_builtin_integer type) (call is_native_integer type))))))

	(fn is_writable_c_integer
		(:doc "Recognize writable native integer operands whose lvalue can be certified separately.")
		(params (row ScalarStatement)) (returns bool)
		(body
			(let type (row.get type))
			(return (bool:and (u32:eq (row.get kind) c_writable_binding)
				(bool:or (call is_builtin_integer type) (call is_native_integer type))))))

	(fn has_c_values
		(:doc `A selected native value needs the C types used in its emitted contract.`)
		(params (statements (shared-array ScalarStatement)))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Find any defining row for a selected native value.")
				(i32:lt index statements.len)
				(body
					(if
						(:doc "One native contract is enough to require the fixed-width type names.")
						(call is_c_value_binding (struct:get (statements.get index) kind))
						(then (return (bool true))))
					(set index (i32:inc index))))
			(return (bool false))))

	(fn write_c_value_name
		(:doc `Use the original header spelling and enclose its expansion for expression and lvalue use.`)
		(params (source (shared-array u8)) (name SourceNode) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let end (call c_span (borrow-shared source) (name.get start) (name.get end)
				(borrow-mut output) open writing))
			(return (call c_byte (borrow-mut output) end 41u8 writing))))

	(fn write_c_string_value
		(:doc "Copy the current native pointer's bytes into an optional owner at the use site.")
		(params (source (shared-array u8)) (name SourceNode) (value ScalarExpression)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let open (call c_literal_text (borrow-shared borrowed_snapshot) (borrow-mut output) offset writing))
			(let place (call write_c_value_name (borrow-shared source) name (borrow-mut output) open writing))
			(return (call close_runtime_call (borrow-mut output) place (value.get target)
				(value.get start) (value.get end) writing))))

	(fn write_constant_check
		(:doc `Make C require an integer constant expression whose value and sign survive conversion to the declared type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (native i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared constant_open) (borrow-mut output) offset writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(let spelled (i32:not-ltz native))
			(if
				(:doc "A spelled C type must itself be an integer or enum type.")
				spelled
				(then
					(set cursor (call c_literal_text (borrow-shared native_constant_equal)
						(borrow-mut output) cursor writing))
					(set cursor (call write_native_type (borrow-shared source) (nodes.get native)
						(borrow-mut output) cursor writing)))
				(else
					(set cursor (call c_literal_text (borrow-shared constant_equal)
						(borrow-mut output) cursor writing))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(if
				(:doc "Require the cast result to admit an integer operator.")
				spelled
				(then (set cursor (call c_literal_text (borrow-shared native_constant_integer)
					(borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared constant_sign_left) (borrow-mut output) cursor writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared constant_sign_cast) (borrow-mut output) cursor writing))
			(if
				(:doc "The sign comparison uses the same cast as the value comparison.")
				spelled
				(then (set cursor (call write_native_type (borrow-shared source) (nodes.get native)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared constant_close) (borrow-mut output) cursor writing))))

	(fn write_readonly_type_name
		(:doc "Use the checked bridge declaration's cached key for both the typedef and its qualified use.")
		(params (source (shared-array u8)) (name SourceNode) (key ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call get_name
				(struct:new CNameParent (identity (call binding_name_identity key)) (slot (key.get target)))
				(call readonly_type_name_role)
				(struct:new CNameSpelling (start (name.get start)) (end (name.get end)) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn write_storage_match
		(:doc `Match one compatible pointer type for a scalar lvalue or one native pointer value for a borrowed handle.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name_index i32) (type u32) (handle bool) (qualified bool) (key ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (nodes.get name_index))
			(let-mut cursor (call c_literal_text (borrow-shared generic_open) (borrow-mut output) offset writing))
			(if
				(:doc "A scalar must be addressable. A library-owned reference is already a pointer value.")
				(bool:not handle)
				(then (set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(if
				(:doc "The read-only alternative adds const to the declared scalar type.")
				qualified
				(then (set cursor (call c_literal_text (borrow-shared generic_const) (borrow-mut output) cursor writing))))
			(if
				(:doc "Qualify the typedef so existing const in the original spelling is never repeated.")
				(bool:and qualified (call is_native_integer type))
				(then (set cursor (call write_readonly_type_name (borrow-shared source)
					name key (borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Only the scalar contract checks an address of storage.")
				handle
				(then (set cursor (call c_literal_text (borrow-shared generic_value_match) (borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared generic_pointer_match) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared generic_close) (borrow-mut output) cursor writing))))

	(fn write_storage_check
		(:doc `Check a foreign lvalue or borrowed handle's type without evaluating the expression.

		A read-only scalar can match its declared type or the const-qualified
		type. Qualify native spellings through a typedef so const is idempotent.
		Keep the two matches separate when both pointer types are compatible.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name_index i32) (type u32) (is_writable bool) (key ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let handle (call is_native_owner type))
			(let readonly_scalar (bool:not (bool:or handle is_writable)))
			(let-mut cursor offset)
			(if
				(:doc "Keep the C type spelling intact in the typedef, including explicit or macro-expanded qualifiers.")
				(bool:and readonly_scalar (call is_native_integer type))
				(then
					(set cursor (call c_literal_text (borrow-shared typedef_open) (borrow-mut output) cursor writing))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
					(set cursor (call write_readonly_type_name (borrow-shared source)
						(nodes.get name_index) key
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared typedef_close) (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared storage_open) (borrow-mut output) cursor writing))
			(set cursor (call write_storage_match (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) name_index type handle (bool false) key
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Only read-only scalars accept const-qualified storage as an alternative.")
				readonly_scalar
				(then
					(set cursor (call c_literal_text (borrow-shared storage_alternative) (borrow-mut output) cursor writing))
					(set cursor (call write_storage_match (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) name_index type (bool false) (bool true) key
						(borrow-mut output) cursor name_prefix writing))))
			(return (call c_literal_text (borrow-shared storage_close) (borrow-mut output) cursor writing))))

	(fn write_macro_check
		(:doc `Match the type of a C expression macro without evaluating it.

		A cast of zero supplies the association type with any top-level
		qualifiers removed and without promoting small integer aliases.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared expression_open)
				(borrow-mut output) offset writing))
			(set cursor (call write_c_value_name (borrow-shared source) name
				(borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared expression_type)
				(borrow-mut output) cursor writing))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared expression_match)
				(borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared generic_close)
				(borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared storage_close)
				(borrow-mut output) cursor writing))))

	(let lossless_prelude `#define WVRT_C_MACRO_SIGNED(T,N,S) ((S) && sizeof(T) <= (N))
#define WVRT_C_MACRO_UNSIGNED(T,N,S) (sizeof(T) <= (N) - (S))
#define WVRT_C_MACRO_CHAR(N,S) ((char)-1 < (char)0 ? WVRT_C_MACRO_SIGNED(char,N,S) : WVRT_C_MACRO_UNSIGNED(char,N,S))
#ifdef __SIZEOF_INT128__
#define WVRT_C_MACRO_INT128(N,S) , __int128: WVRT_C_MACRO_SIGNED(__int128,N,S), unsigned __int128: WVRT_C_MACRO_UNSIGNED(unsigned __int128,N,S)
#else
#define WVRT_C_MACRO_INT128(N,S)
#endif
#if defined(__BITINT_MAXWIDTH__) && __BITINT_MAXWIDTH__ >= 256 && __STDC_VERSION__ >= 202311L
#define WVRT_C_MACRO_INT256(N,S) , _BitInt(256): WVRT_C_MACRO_SIGNED(_BitInt(256),N,S), unsigned _BitInt(256): WVRT_C_MACRO_UNSIGNED(unsigned _BitInt(256),N,S)
#else
#define WVRT_C_MACRO_INT256(N,S)
#endif
#define WVRT_C_MACRO_FITS(V,N,S) _Generic((V), \
  _Bool: 1, char: WVRT_C_MACRO_CHAR(N,S), \
  signed char: WVRT_C_MACRO_SIGNED(signed char,N,S), unsigned char: WVRT_C_MACRO_UNSIGNED(unsigned char,N,S), \
  short: WVRT_C_MACRO_SIGNED(short,N,S), unsigned short: WVRT_C_MACRO_UNSIGNED(unsigned short,N,S), \
  int: WVRT_C_MACRO_SIGNED(int,N,S), unsigned int: WVRT_C_MACRO_UNSIGNED(unsigned int,N,S), \
  long: WVRT_C_MACRO_SIGNED(long,N,S), unsigned long: WVRT_C_MACRO_UNSIGNED(unsigned long,N,S), \
  long long: WVRT_C_MACRO_SIGNED(long long,N,S), unsigned long long: WVRT_C_MACRO_UNSIGNED(unsigned long long,N,S) \
  WVRT_C_MACRO_INT128(N,S) WVRT_C_MACRO_INT256(N,S), default: 0)
`)
	(let lossless_guard "#ifdef ")
	(let lossless_assert "\n__extension__ _Static_assert(WVRT_C_MACRO_FITS(")
	(let lossless_size ",sizeof(")
	(let lossless_signed "),1")
	(let lossless_unsigned "),0")
	(let lossless_end "),\"Wove C integer macro range does not fit its declared type\");\n#else\n#error \"Wove requires an object-like C integer macro\"\n#endif\n")

	(fn write_lossless_macro_prelude
		(:doc "Share a C range test across selected macros. On supported Clang ABIs, these integer types have whole-byte widths without padding. An unsigned source needs an extra destination bit if the destination is signed.")
		(params (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body (return (call c_literal_text (borrow-shared lossless_prelude)
			(borrow-mut output) offset writing))))

	(fn write_lossless_macro_check
		(:doc "Check the entire native integer range in an unevaluated C expression.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared lossless_guard)
				(borrow-mut output) offset writing))
			(set cursor (call c_span (borrow-shared source) (name.get start) (name.get end)
				(borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared lossless_assert) (borrow-mut output) cursor writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared lossless_size) (borrow-mut output) cursor writing))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "The destination signedness determines the available magnitude bits.")
				(call is_signed_integer_value type)
				(then (set cursor (call c_literal_text (borrow-shared lossless_signed) (borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared lossless_unsigned) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared lossless_end) (borrow-mut output) cursor writing))))

	(fn write_lossless_macro_value
		(:doc "Convert one evaluation of the original macro to the exact Wove type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let cast (call c_byte (borrow-mut output) open 40u8 writing))
			(let spelled (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cast name_prefix writing))
			(let after_cast (call c_byte (borrow-mut output) spelled 41u8 writing))
			(let value (call write_c_value_name (borrow-shared source) name (borrow-mut output) after_cast writing))
			(return (call c_byte (borrow-mut output) value 41u8 writing))))

	(fn write_c_value_contract
		(:doc `Emit a contract once per defining row. All aliases share the original native object or macro.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(binding ScalarStatement) (key ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (binding.get target))
			(let kind (binding.get kind))
			(let type (binding.get type))
			(if
				(:doc "A writable native string must be an addressable char pointer with writable pointer storage.")
				(u32:eq type (call optional_byte_owner_type))
				(then
					(let open (call c_literal_text (borrow-shared string_check_begin)
						(borrow-mut output) offset writing))
					(let place (call write_c_value_name (borrow-shared source) (nodes.get name)
						(borrow-mut output) open writing))
					(return (call c_literal_text (borrow-shared string_check_end)
						(borrow-mut output) place writing))))
			(if
				(:doc "A vector snapshot reads a char ** global, using the same declaration for every alias.")
				(u32:eq type (call byte_rows_owner_type))
				(then (return (call write_c_vector_declaration (borrow-shared source)
					(nodes.get name) (borrow-mut output) offset writing))))
			(if
				(:doc "Constants must be integral and representable as the selected declared type.")
				(u32:eq kind c_constant_binding)
				(then (return (call write_constant_check (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (nodes.get name) type -1i32
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A lossless macro permits a range-preserving conversion of its native type.")
				(u32:eq kind c_lossless_macro_binding)
				(then (return (call write_lossless_macro_check (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (nodes.get name) type
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A read-only macro needs an expression type check because its expansion may be an rvalue.")
				(u32:eq kind c_macro_binding)
				(then (return (call write_macro_check (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (nodes.get name) type
					(borrow-mut output) offset name_prefix writing))))
			(return (call write_storage_check (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) name type (u32:eq kind c_writable_binding) key
				(borrow-mut output) offset name_prefix writing)))))
