(module emit_c_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit live C header expressions and check their declared type and access through the included header.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only is_c_value_binding (type ScalarStatement)
		(value c_constant_binding) (value c_writable_binding) (value c_macro_binding)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "../scalar/records.wove" (only is_native_integer byte_rows_owner_type (type ScalarRecord)))
	(use wove-file "./c_vectors.wove" (only write_c_vector_declaration))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./owners.wove" (only write_native_type))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text write_c_name readonly_type_name_role))

	(let constant_open "_Static_assert((")
	(let constant_equal "|0)==(")
	(let native_constant_equal "|0)==((")
	(let native_constant_integer "|0)")
	(let constant_sign_left "&&((0<")
	(let constant_sign_cast ")==(0<(")
	(let constant_close ")),\"Wove C constant must fit its declared type\");\n")
	(let typedef_open "typedef ")
	(let typedef_close ";\n")
	(let storage_open "_Static_assert(")
	(let generic_open "_Generic(")
	(let expression_open "_Static_assert(_Generic(")
	(let expression_type ",__typeof__((")
	(let expression_match ")0):1")
	(let generic_const "const ")
	(let generic_pointer_match "*:1")
	(let generic_value_match ":1")
	(let generic_close ",default:0)")
	(let storage_alternative "||")
	(let storage_close ",\"Wove C value does not match its declared type\");\n")

	(fn has_c_values
		(:doc `A selected native value needs the C types used in its emitted contract.`)
		(params (statements (shared-array ScalarStatement)))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Find any defining row for a selected native value.")
				(i32.lt index (array.len statements))
				(body
					(if
						(:doc "One native contract is enough to require the fixed-width type names.")
						(call is_c_value_binding (struct.get (array.load statements index) kind))
						(then (return (bool true))))
					(set index (i32.inc index))))
			(return (bool false))))

	(fn write_c_value_name
		(:doc `Use the original header spelling and enclose its expansion for expression and lvalue use.`)
		(params (source (shared-array u8)) (name SourceNode) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let end (call c_span (borrow-shared source) (struct.get name start) (struct.get name end)
				(borrow-mut output) open writing))
			(return (call c_byte (borrow-mut output) end 41u8 writing))))

	(fn write_constant_check
		(:doc `Make C require an integer constant expression whose value and sign survive conversion to the declared type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (native i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared constant_open) (borrow-mut output) offset writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(let spelled (i32.not-ltz native))
			(if
				(:doc "A spelled C type must itself be an integer or enum type.")
				spelled
				(then
					(set cursor (call c_literal_text (borrow-shared native_constant_equal)
						(borrow-mut output) cursor writing))
					(set cursor (call write_native_type (borrow-shared source) (array.load nodes native)
						(borrow-mut output) cursor writing)))
				(else
					(set cursor (call c_literal_text (borrow-shared constant_equal)
						(borrow-mut output) cursor writing))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(if
				(:doc "Require the cast result to admit an integer operator.")
				spelled
				(then (set cursor (call c_literal_text (borrow-shared native_constant_integer)
					(borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared constant_sign_left) (borrow-mut output) cursor writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared constant_sign_cast) (borrow-mut output) cursor writing))
			(if
				(:doc "The sign comparison uses the same cast as the value comparison.")
				spelled
				(then (set cursor (call write_native_type (borrow-shared source) (array.load nodes native)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared constant_close) (borrow-mut output) cursor writing))))

	(fn write_readonly_type_name
		(:doc `Give the qualified match a private typedef keyed by the original C binding name row.`)
		(params (source (shared-array u8)) (name SourceNode) (name_index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut output) offset writing
				name_prefix (call readonly_type_name_role) (u32.from-i32 name_index)
				(borrow-shared source) (struct.get name start) (struct.get name end)))))

	(fn write_storage_match
		(:doc `Match one compatible pointer type for a scalar lvalue or one native pointer value for a borrowed handle.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name_index i32) (type u32) (handle bool) (qualified bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load nodes name_index))
			(let-mut cursor (call c_literal_text (borrow-shared generic_open) (borrow-mut output) offset writing))
			(if
				(:doc "A scalar must be addressable. A library-owned reference is already a pointer value.")
				(bool.not handle)
				(then (set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(set cursor (call write_c_value_name (borrow-shared source) name (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(if
				(:doc "The read-only alternative adds const to the declared scalar type.")
				qualified
				(then (set cursor (call c_literal_text (borrow-shared generic_const) (borrow-mut output) cursor writing))))
			(if
				(:doc "Qualify the typedef so existing const in the original spelling is never repeated.")
				(bool.and qualified (call is_native_integer type))
				(then (set cursor (call write_readonly_type_name (borrow-shared source)
					name name_index (borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Only the scalar contract checks an address of storage.")
				handle
				(then (set cursor (call c_literal_text (borrow-shared generic_value_match) (borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared generic_pointer_match) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared generic_close) (borrow-mut output) cursor writing))))

	(fn write_storage_check
		(:doc `Check a foreign lvalue or borrowed handle's type without evaluating the expression.

		A read-only scalar can match its declared type or the const-qualified
		type. Qualify native spellings through a typedef so const is idempotent.
		Keep the two matches separate when both pointer types are compatible.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name_index i32) (type u32) (is_writable bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let handle (call is_native_owner type))
			(let readonly_scalar (bool.not (bool.or handle is_writable)))
			(let-mut cursor offset)
			(if
				(:doc "Keep the C type spelling intact in the typedef, including explicit or macro-expanded qualifiers.")
				(bool.and readonly_scalar (call is_native_integer type))
				(then
					(set cursor (call c_literal_text (borrow-shared typedef_open) (borrow-mut output) cursor writing))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
					(set cursor (call write_readonly_type_name (borrow-shared source)
						(array.load nodes name_index) name_index
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared typedef_close) (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared storage_open) (borrow-mut output) cursor writing))
			(set cursor (call write_storage_match (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) name_index type handle (bool false)
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Only read-only scalars accept const-qualified storage as an alternative.")
				readonly_scalar
				(then
					(set cursor (call c_literal_text (borrow-shared storage_alternative) (borrow-mut output) cursor writing))
					(set cursor (call write_storage_match (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) name_index type (bool false) (bool true)
						(borrow-mut output) cursor name_prefix writing))))
			(return (call c_literal_text (borrow-shared storage_close) (borrow-mut output) cursor writing))))

	(fn write_macro_check
		(:doc `Match the type of a C expression macro without evaluating it.

		A cast of zero supplies the association type with any top-level
		qualifiers removed and without promoting small integer aliases.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared expression_open)
				(borrow-mut output) offset writing))
			(set cursor (call write_c_value_name (borrow-shared source) name
				(borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared expression_type)
				(borrow-mut output) cursor writing))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared expression_match)
				(borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared generic_close)
				(borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared storage_close)
				(borrow-mut output) cursor writing))))

	(fn write_c_value_contract
		(:doc `Emit a contract once per defining row. All aliases share the original native object or macro.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(binding ScalarStatement) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (struct.get binding target))
			(let kind (struct.get binding kind))
			(let type (struct.get binding type))
			(if
				(:doc "A vector snapshot reads a char ** global, using the same declaration for every alias.")
				(u32.eq type (call byte_rows_owner_type))
				(then (return (call write_c_vector_declaration (borrow-shared source)
					(array.load nodes name) (borrow-mut output) offset writing))))
			(if
				(:doc "Constants must be integral and representable as the selected declared type.")
				(u32.eq kind c_constant_binding)
				(then (return (call write_constant_check (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (array.load nodes name) type -1i32
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A read-only macro needs an expression type check because its expansion may be an rvalue.")
				(u32.eq kind c_macro_binding)
				(then (return (call write_macro_check (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (array.load nodes name) type
					(borrow-mut output) offset name_prefix writing))))
			(return (call write_storage_check (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) name type (u32.eq kind c_writable_binding)
				(borrow-mut output) offset name_prefix writing)))))
