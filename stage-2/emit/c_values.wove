(module emit_c_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit live C header expressions and check their declared type and access through the included header.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only is_c_value_binding (type ScalarStatement)
		(value c_constant_binding) (value c_writable_binding)))
	(use wove-file "../scalar/owners.wove" (only is_native_owner))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text))

	(let constant_open "_Static_assert((")
	(let constant_equal "|0)==(")
	(let constant_sign_left "&&((0<")
	(let constant_sign_cast ")==(0<(")
	(let constant_close ")),\"Wove C constant must fit its declared type\");\n")
	(let storage_open "_Static_assert(")
	(let generic_open "_Generic(")
	(let generic_const "const ")
	(let generic_pointer_match "*:1")
	(let generic_value_match ":1")
	(let generic_close ",default:0)")
	(let storage_alternative "||")
	(let storage_close ",\"Wove C value does not match its declared type\");\n")

	(fn has_c_values
		(:doc `A selected native value needs the C types used in its emitted contract.`)
		(params (statements (shared-slice ScalarStatement)))
		(returns bool)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "Find any defining row for a selected native value.")
				(i32.lt (local index) (slice.len (local statements)))
				(body
					(if
						(:doc "One native contract is enough to require the fixed-width type names.")
						(call is_c_value_binding (record.get (slice.load (local statements) (local index)) kind))
						(then (return (bool true))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (bool false))))

	(fn write_c_value_name
		(:doc `Use the original header spelling and enclose its expansion for expression and lvalue use.`)
		(params (source (shared-slice u8)) (name SourceNode) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) (u8 40) (local writing)))
			(let end (call c_span (borrow-shared (local source)) (record.get (local name) start) (record.get (local name) end)
				(borrow-mut (local output)) (local open) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local end) (u8 41) (local writing)))))

	(fn write_constant_check
		(:doc `Make C require an integer constant expression whose value and sign survive conversion to the declared type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(name SourceNode) (type u32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local constant_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local constant_equal)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local constant_sign_left)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local constant_sign_cast)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(return (call c_literal_text (borrow-shared (local constant_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_storage_match
		(:doc `Match one compatible pointer type for a scalar lvalue or one native pointer value for a borrowed handle.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(name SourceNode) (type u32) (handle bool) (qualified bool)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local generic_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "A scalar must be addressable. A library-owned reference is already a pointer value.")
				(bool.not (local handle))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 38) (local writing)))))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
			(if
				(:doc "The read-only alternative adds const to the declared scalar type.")
				(local qualified)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local generic_const)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Only the scalar contract checks an address of storage.")
				(local handle)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local generic_value_match)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local generic_pointer_match)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local generic_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_storage_check
		(:doc `Check a foreign lvalue or borrowed handle's type without evaluating the expression.

		A read-only scalar can match its declared type or the const-qualified
		type. Separate generic selections also work when a typedef already
		carries const and both candidate pointer types are compatible.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(name SourceNode) (type u32) (is_writable bool)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let handle (call is_native_owner (local type)))
			(let open (call c_literal_text (borrow-shared (local storage_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(let-mut cursor (call write_storage_match (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local name) (local type) (local handle) (bool false)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(if
				(:doc "Only read-only scalars accept const-qualified storage as an alternative.")
				(bool.not (bool.or (local handle) (local is_writable)))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local storage_alternative)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_storage_match (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local name) (local type) (bool false) (bool true)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (call c_literal_text (borrow-shared (local storage_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_c_value_contract
		(:doc `Emit a contract once per defining row. All aliases share the original native object or macro.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(binding ScalarStatement) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (record.get (local binding) target)))
			(let kind (record.get (local binding) kind))
			(let type (record.get (local binding) type))
			(if
				(:doc "Constants must be integral and representable as the selected declared type.")
				(u32.eq (local kind) (local c_constant_binding))
				(then (return (call write_constant_check (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local name) (local type)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_storage_check (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local name) (local type) (u32.eq (local kind) (local c_writable_binding))
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing))))))
