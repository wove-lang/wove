(module emit_c_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit live C header expressions and check their declared type and access through the included header.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only is_c_value_binding (type ScalarStatement)
		(value c_constant_binding) (value c_writable_binding) (value c_macro_binding)))
	(use wove-file "../scalar/owners.wove" (only is_native_owner))
	(use wove-file "../scalar/records.wove" (only is_native_integer byte_rows_owner_type (type ScalarRecord)))
	(use wove-file "./c_vectors.wove" (only write_c_vector_declaration))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text write_c_name readonly_type_name_role))

	(let constant_open "_Static_assert((")
	(let constant_equal "|0)==(")
	(let constant_sign_left "&&((0<")
	(let constant_sign_cast ")==(0<(")
	(let constant_close ")),\"Wove C constant must fit its declared type\");\n")
	(let typedef_open "typedef ")
	(let typedef_close ";\n")
	(let storage_open "_Static_assert(")
	(let generic_open "_Generic(")
	(let expression_open "_Static_assert(_Generic(")
	(let expression_type ",__typeof__((")
	(let expression_match ")0):1")
	(let generic_const "const ")
	(let generic_pointer_match "*:1")
	(let generic_value_match ":1")
	(let generic_close ",default:0)")
	(let storage_alternative "||")
	(let storage_close ",\"Wove C value does not match its declared type\");\n")

	(fn has_c_values
		(:doc `A selected native value needs the C types used in its emitted contract.`)
		(params (statements (shared-array ScalarStatement)))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Find any defining row for a selected native value.")
				(i32.lt (local index) (array.len (local statements)))
				(body
					(if
						(:doc "One native contract is enough to require the fixed-width type names.")
						(call is_c_value_binding (struct.get (array.load (local statements) (local index)) kind))
						(then (return (bool true))))
					(set (local index) (i32.inc (local index)))))
			(return (bool false))))

	(fn write_c_value_name
		(:doc `Use the original header spelling and enclose its expansion for expression and lvalue use.`)
		(params (source (shared-array u8)) (name SourceNode) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let end (call c_span (borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end)
				(borrow-mut (local output)) (local open) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local end) 41u8 (local writing)))))

	(fn write_constant_check
		(:doc `Make C require an integer constant expression whose value and sign survive conversion to the declared type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local constant_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local constant_equal)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local constant_sign_left)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local constant_sign_cast)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(return (call c_literal_text (borrow-shared (local constant_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_readonly_type_name
		(:doc `Give the qualified match a private typedef keyed by the original C binding name row.`)
		(params (source (shared-array u8)) (name SourceNode) (name_index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (call readonly_type_name_role) (u32.from-i32 (local name_index))
				(borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end)))))

	(fn write_storage_match
		(:doc `Match one compatible pointer type for a scalar lvalue or one native pointer value for a borrowed handle.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name_index i32) (type u32) (handle bool) (qualified bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load (local nodes) (local name_index)))
			(let-mut cursor (call c_literal_text (borrow-shared (local generic_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "A scalar must be addressable. A library-owned reference is already a pointer value.")
				(bool.not (local handle))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(if
				(:doc "The read-only alternative adds const to the declared scalar type.")
				(local qualified)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local generic_const)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Qualify the typedef so existing const in the original spelling is never repeated.")
				(bool.and (local qualified) (call is_native_integer (local type)))
				(then (set (local cursor) (call write_readonly_type_name (borrow-shared (local source))
					(local name) (local name_index) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
				(else (set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(if
				(:doc "Only the scalar contract checks an address of storage.")
				(local handle)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local generic_value_match)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local generic_pointer_match)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local generic_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_storage_check
		(:doc `Check a foreign lvalue or borrowed handle's type without evaluating the expression.

		A read-only scalar can match its declared type or the const-qualified
		type. Qualify native spellings through a typedef so const is idempotent.
		Keep the two matches separate when both pointer types are compatible.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name_index i32) (type u32) (is_writable bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let handle (call is_native_owner (local type)))
			(let readonly_scalar (bool.not (bool.or (local handle) (local is_writable))))
			(let-mut cursor (local offset))
			(if
				(:doc "Keep the C type spelling intact in the typedef, including explicit or macro-expanded qualifiers.")
				(bool.and (local readonly_scalar) (call is_native_integer (local type)))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local typedef_open)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
					(set (local cursor) (call write_readonly_type_name (borrow-shared (local source))
						(array.load (local nodes) (local name_index)) (local name_index)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local typedef_close)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local storage_open)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_storage_match (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local name_index) (local type) (local handle) (bool false)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Only read-only scalars accept const-qualified storage as an alternative.")
				(local readonly_scalar)
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local storage_alternative)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_storage_match (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local name_index) (local type) (bool false) (bool true)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (call c_literal_text (borrow-shared (local storage_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_macro_check
		(:doc `Match the type of a C expression macro without evaluating it.

		A cast of zero supplies the association type with any top-level
		qualifiers removed and without promoting small integer aliases.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name SourceNode) (type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local expression_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call write_c_value_name (borrow-shared (local source)) (local name)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local expression_type))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local expression_match))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local generic_close))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(return (call c_literal_text (borrow-shared (local storage_close))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_c_value_contract
		(:doc `Emit a contract once per defining row. All aliases share the original native object or macro.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(binding ScalarStatement) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (struct.get (local binding) target))
			(let kind (struct.get (local binding) kind))
			(let type (struct.get (local binding) type))
			(if
				(:doc "A vector snapshot reads a char ** global, using the same declaration for every alias.")
				(u32.eq (local type) (call byte_rows_owner_type))
				(then (return (call write_c_vector_declaration (borrow-shared (local source))
					(array.load (local nodes) (local name)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Constants must be integral and representable as the selected declared type.")
				(u32.eq (local kind) (local c_constant_binding))
				(then (return (call write_constant_check (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (array.load (local nodes) (local name)) (local type)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A read-only macro needs an expression type check because its expansion may be an rvalue.")
				(u32.eq (local kind) (local c_macro_binding))
				(then (return (call write_macro_check (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (array.load (local nodes) (local name)) (local type)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_storage_check (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local name) (local type) (u32.eq (local kind) (local c_writable_binding))
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing))))))
