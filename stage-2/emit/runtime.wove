(module emit_runtime
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write the C fragments for the shared runtime ABI.

	Pass already evaluated operands to checked runtime operations along with
	the original file identity and half-open byte span.`)

	(use wove-file "../text/decimal_write.wove" (only write_decimal_i32))
	(use wove-file "./text.wove" (only c_byte c_include_prefix c_decimal_digits c_span c_literal_text))

	(let u32_shift_count_call "wvrt_u32_shift_count_at_span(")
	(let u64_shift_count_call "wvrt_u64_shift_count_at_span(")
	(let i32_division_call "wvrt_i32_divide_at_span(")
	(let i32_shift_call "wvrt_i32_shift_at_span(")

	(fn open_word_shift_count
		(:doc `Open the runtime count check for the operand's declared word width.`)
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A wide word accepts counts up to 63.")
				(u32.eq (local type) 54u32)
				(then (return (call c_literal_text (borrow-shared (local u64_shift_count_call))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local u32_shift_count_call))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn open_i32_checked_binary
		(:doc `Open the runtime call for a signed division or shift.`)
		(params (output (mut-array u8)) (offset u32) (division bool) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The division helper also implements remainder.")
				(local division)
				(then (return (call c_literal_text (borrow-shared (local i32_division_call))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local i32_shift_call))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_runtime_header
		(:doc `Include the shared runtime for translation units that use its types or checks.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_include_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 109u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 46u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 104u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))
			(return (local cursor))))

	(fn open_host_entry
		(:doc `Open the runtime's type-specific C entry wrapper invocation.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 87u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 86u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 82u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 72u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 79u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 83u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 69u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 78u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 82u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 89u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(return (local cursor))))

	(fn open_native_suffix
		(:doc `Finish the name of a native integer runtime operation and open its arguments.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))

	(fn open_conversion
		(:doc `Open the runtime call for the target type already checked by the scalar plan.`)
		(params (output (mut-array u8)) (offset u32) (target u32) (native bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(if
				(:doc "The full-width conversion path takes the exact C target type explicitly.")
				(local native)
				(then (return (call open_native_suffix (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(let-mut letter 117u8)
			(if
				(:doc "The signed runtime target begins with i.")
				(u32.eq (local target) 5u32)
				(then (set (local letter) 105u8)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local letter) (local writing)))
			(if
				(:doc "The byte target uses 8. The other targets use 32.")
				(u32.eq (local target) 10u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 56u8 (local writing))))
				(else
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 51u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 50u8 (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))

	(fn write_slice_prefix
		(:doc `Write the common runtime prefix for checked slice operations.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 108u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(return (local cursor))))

	(fn open_span_suffix
		(:doc `Finish a span-aware runtime operation name and open its argument list.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(return (local cursor))))

	(fn open_slice_access
		(:doc `Open the runtime call for a checked byte load, store, or range projection.`)
		(params (output (mut-array u8)) (offset u32) (kind u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_slice_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "A range produces a shared descriptor.")
				(u32.eq (local kind) 44u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 103u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing))))
				(else
					(if
						(:doc "The remaining checked names select a writable store or a read-only load.")
						(u32.eq (local kind) 40u32)
						(then
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing))))
						(else
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 108u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 100u8 (local writing)))))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 56u8 (local writing)))
			(return (call open_span_suffix (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn open_slice_offset
		(:doc `Open a bounds-checked element index for a typed native load.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_slice_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 102u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 102u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(return (call open_span_suffix (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_slice_items
		(:doc `Read the backing pointer field of an already evaluated slice.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 46u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 109u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(return (local cursor))))

	(fn open_shared_projection
		(:doc `Open the read-only projection of a mutable slice descriptor.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 104u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 109u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 108u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(return (local cursor))))

	(fn write_slice_length
		(:doc `Append the signed element count field of a slice descriptor.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 46u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 108u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 103u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 104u8 (local writing)))
			(return (local cursor))))

	(fn write_array_prefix
		(:doc `Write the common runtime prefix for array operations.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 121u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(return (local cursor))))

	(fn open_array_allocation
		(:doc `Open a checked array allocation with either the byte shortcut or a native layout.`)
		(params (output (mut-array u8)) (offset u32) (byte bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(if
				(:doc "The byte helper supplies its own size and alignment.")
				(local byte)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 56u8 (local writing)))))
			(return (call open_span_suffix (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn open_array_copy
		(:doc `Open the runtime byte-owner copy call before its compiled payload and extent.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 121u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 56u8 (local writing)))
			(return (call open_span_suffix (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn open_array_layout_query
		(:doc `Open a native element size or alignment argument after the evaluated count.`)
		(params (output (mut-array u8)) (offset u32) (alignment bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut (local output)) (local offset) 44u8 (local writing)))
			(if
				(:doc "The layout argument selects either _Alignof or sizeof.")
				(local alignment)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 65u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 108u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 103u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing))))
				(else
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 122u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 102u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(return (local cursor))))

	(fn open_array_drop
		(:doc `Open a release of an owning array.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 100u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(return (local cursor))))

	(fn open_array_borrow
		(:doc `Open the shared or exclusive projection of an owning byte array.`)
		(params (output (mut-array u8)) (offset u32) (exclusive bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 98u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(if
				(:doc "The projection returns a descriptor in the requested access mode.")
				(local exclusive)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 109u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing))))
				(else
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 104u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 100u8 (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))

	(fn write_c_number
		(:doc `Append an exact signed decimal C operand using caller-provided formatting scratch.`)
		(params (output (mut-array u8)) (offset u32) (value i32) (digits (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let count (call write_decimal_i32 (borrow-mut (local digits)) 0i32 (local value)))
			(return (call c_decimal_digits (borrow-mut (local output)) (local offset) (local writing)
				(borrow-shared (local digits)) 0i32 (local count)))))

	(fn write_site_number
		(:doc `Append one comma-separated source site number.`)
		(params (output (mut-array u8)) (offset u32) (value i32) (digits (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let next (call c_byte (borrow-mut (local output)) (local offset) 44u8 (local writing)))
			(return (call write_c_number (borrow-mut (local output)) (local next) (local value)
				(borrow-mut (local digits)) (local writing)))))

	(fn write_runtime_site
		(:doc `Append the original file identity and half-open byte span to a generated runtime operand list.`)
		(params (output (mut-array u8)) (offset u32) (file i32) (start i32) (end i32) (writing bool))
		(returns u32)
		(body
			(let-mut digits (array.alloc u8 11i32))
			(let file_end (call write_site_number (borrow-mut (local output)) (local offset)
				(local file) (borrow-mut (local digits)) (local writing)))
			(let start_end (call write_site_number (borrow-mut (local output)) (local file_end)
				(local start) (borrow-mut (local digits)) (local writing)))
			(return (call write_site_number (borrow-mut (local output)) (local start_end)
				(local end) (borrow-mut (local digits)) (local writing)))))

	(fn close_runtime_call
		(:doc `Attach the original operation site and close the runtime call.`)
		(params (output (mut-array u8)) (offset u32) (file i32) (start i32) (end i32) (writing bool))
		(returns u32)
		(body
			(let end_end (call write_runtime_site (borrow-mut (local output)) (local offset)
				(local file) (local start) (local end) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local end_end) 41u8 (local writing))))))
