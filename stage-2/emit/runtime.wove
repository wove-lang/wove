(module emit_runtime
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write the C fragments for the shared runtime ABI.

	Pass already evaluated operands to checked runtime operations along with
	the original file identity and half-open byte span.`)

	(use wove-file "../source/numeric_ops.wove" (only integer_byte_width))
	(use wove-file "../source/types.wove" (only is_128bit_integer is_256bit_integer is_signed_builtin_integer))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_i32))
	(use wove-file "./text.wove" (only c_byte c_include_prefix c_span c_literal_text c_type_text c_cast (value c_output_limit)))

	(let shift_count_call "wvrt_shift_count_at_span(")
	(let u32_shift_count_call "wvrt_u32_shift_count_at_span(")
	(let u64_shift_count_call "wvrt_u64_shift_count_at_span(")
	(let i32_division_call "wvrt_i32_divide_at_span(")
	(let integer_division_call "wvrt_int_divide_at_span(")
	(let i32_shift_call "wvrt_i32_shift_at_span(")
	(let signed_shift_call "wvrt_signed_shift_at_span(")
	(let direct_rotate_call "wvrt_u64_rotr_at_span(")
	(let unsigned_rotate_call "wvrt_rotate_at_span(")
	(let signed_rotate_call "wvrt_signed_rotate_at_span(")
	(let wide_shift_suffix "_shift_at_span(")
	(let wide_rotate_suffix "_rotate_at_span(")

	(fn open_word_shift_count
		(:doc `Open the runtime count check for the operand's declared word width.`)
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A wide word accepts counts up to 63.")
				(type.eq 54u32)
				(then (return (call c_literal_text (borrow-shared u64_shift_count_call)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A u32 count uses its direct runtime entry.")
				(type.eq 11u32)
				(then (return (call c_literal_text (borrow-shared u32_shift_count_call)
					(borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared shift_count_call)
				(borrow-mut output) offset writing))))

	(fn write_word_width
		(:doc "Append the logical operand width to a generic word operation.")
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let bytes (u32:from-i32 (call integer_byte_width type)))
			(let width (i32:from-u32 (bytes.shl 3i32)))
			(let comma (call c_byte (borrow-mut output) offset 44u8 writing))
			(return (call write_c_number (borrow-mut output) comma width writing))))

	(fn open_word_rotate
		(:doc "Open an exact-type rotation using the runtime's signed or unsigned representation.")
		(params (output (mut-array u8)) (offset u32) (type u32) (direct bool) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The existing u64 right rotation already returns the exact type.")
				direct
				(then (return (call c_literal_text (borrow-shared direct_rotate_call)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Wide helpers are named for their exact C word type and return it.")
				(bool:or (call is_128bit_integer type) (call is_256bit_integer type))
				(then
					(let name (call c_type_text (borrow-mut output) offset type writing))
					(return (call c_literal_text (borrow-shared wide_rotate_suffix)
						(borrow-mut output) name writing))))
			(let cast (call c_cast (borrow-mut output) offset type writing))
			(if
				(:doc "The signed helper reinterprets the rotated bits at their original width.")
				(call is_signed_builtin_integer type)
				(then (return (call c_literal_text (borrow-shared signed_rotate_call)
					(borrow-mut output) cast writing))))
			(return (call c_literal_text (borrow-shared unsigned_rotate_call)
				(borrow-mut output) cast writing))))

	(fn open_checked_word_binary
		(:doc "Open the checked division or shift call. Generic division includes the exact C result type.")
		(params (output (mut-array u8)) (offset u32) (division bool) (type u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Wide shifts use the exact C word type to choose width and sign extension.")
				(division.not.and
					(bool:or (call is_128bit_integer type) (call is_256bit_integer type)))
				(then
					(let name (call c_type_text (borrow-mut output) offset type writing))
					(return (call c_literal_text (borrow-shared wide_shift_suffix)
						(borrow-mut output) name writing))))
			(if
				(:doc "An exact width other than i32 is supplied to the shared signed shift helper.")
				division.not
				(then
					(if
						(:doc "The i32 entry already has the width and result type in its signature.")
						(type.eq 5u32)
						(then (return (call c_literal_text (borrow-shared i32_shift_call)
							(borrow-mut output) offset writing))))
					(let cast (call c_cast (borrow-mut output) offset type writing))
					(return (call c_literal_text (borrow-shared signed_shift_call)
						(borrow-mut output) cast writing))))
			(if
				(:doc "The existing i32 division helper keeps its C call shape.")
				(type.eq 5u32)
				(then (return (call c_literal_text (borrow-shared i32_division_call)
					(borrow-mut output) offset writing))))
			(let open (call c_literal_text (borrow-shared integer_division_call)
				(borrow-mut output) offset writing))
			(let type_end (call c_type_text (borrow-mut output) open type writing))
			(return (call c_byte (borrow-mut output) type_end 44u8 writing))))

	(fn write_runtime_header
		(:doc `Include the shared runtime for translation units that use its types or checks.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_include_prefix (borrow-mut output) offset writing))
			(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 109u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 46u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 104u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))
			(return cursor)))

	(fn open_host_entry
		(:doc `Open the runtime's borrowed argv entry wrapper invocation.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 87u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 86u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 82u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 72u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 79u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 83u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 69u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 78u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 82u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 89u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(return cursor)))

	(fn open_native_suffix
		(:doc `Finish the name of a native integer runtime operation and open its arguments.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(return (call c_byte (borrow-mut output) cursor 40u8 writing))))

	(fn open_conversion
		(:doc `Open the runtime call for the target type already checked by the scalar plan.`)
		(params (output (mut-array u8)) (offset u32) (target u32) (native bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(if
				(:doc "The full-width conversion path takes the exact C target type explicitly.")
				native
				(then (return (call open_native_suffix (borrow-mut output) cursor writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(let-mut letter 117u8)
			(if
				(:doc "The signed runtime target begins with i.")
				(target.eq 5u32)
				(then (set letter 105u8)))
			(set cursor (call c_byte (borrow-mut output) cursor letter writing))
			(if
				(:doc "The byte target uses 8. The other targets use 32.")
				(target.eq 10u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 56u8 writing)))
				(else
					(set cursor (call c_byte (borrow-mut output) cursor 51u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 50u8 writing))))
			(return (call c_byte (borrow-mut output) cursor 40u8 writing))))

	(fn write_slice_prefix
		(:doc `Write the common runtime prefix for checked slice operations.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 108u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(return cursor)))

	(fn open_span_suffix
		(:doc `Finish a span-aware runtime operation name and open its argument list.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 112u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(return cursor)))

	(let typed_shared_range "wvrt_slice_range_at_span(")
	(let typed_mut_range "wvrt_mut_slice_range_at_span(")
	(let byte_mut_range "wvrt_mut_slice_range_u8_at_span(")

	(fn open_slice_range
		(:doc "Select the checked range operation for the descriptor's stride and access mode.")
		(params (output (mut-array u8)) (offset u32) (typed bool) (writable bool) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A typed view uses the element size from its original descriptor.")
				typed
				(then
					(if
						(:doc "Return a mutable descriptor for an exclusive subrange.")
						writable
						(then (return (call c_literal_text (borrow-shared typed_mut_range)
							(borrow-mut output) offset writing))))
					(return (call c_literal_text (borrow-shared typed_shared_range)
						(borrow-mut output) offset writing))))
			(if
				(:doc "Preserve the mutable byte runtime call and descriptor shape.")
				writable
				(then (return (call c_literal_text (borrow-shared byte_mut_range)
					(borrow-mut output) offset writing))))
			(return (call open_slice_access (borrow-mut output) offset 44u32 writing))))

	(fn open_slice_access
		(:doc `Open the runtime call for a checked byte load, store, or range projection.`)
		(params (output (mut-array u8)) (offset u32) (kind u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_slice_prefix (borrow-mut output) offset writing))
			(if
				(:doc "A range produces a shared descriptor.")
				(kind.eq 44u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 103u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing)))
				(else
					(if
						(:doc "The remaining checked names select a writable store or a read-only load.")
						(kind.eq 40u32)
						(then
							(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing)))
						(else
							(set cursor (call c_byte (borrow-mut output) cursor 108u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 100u8 writing))))))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 56u8 writing))
			(return (call open_span_suffix (borrow-mut output) cursor writing))))

	(fn open_slice_offset
		(:doc `Open a bounds-checked element index for a typed native load.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_slice_prefix (borrow-mut output) offset writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 102u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 102u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(return (call open_span_suffix (borrow-mut output) cursor writing))))

	(fn write_slice_items
		(:doc `Read the backing pointer field of an already evaluated slice.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 46u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 109u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(return cursor)))

	(fn open_shared_projection
		(:doc `Open the read-only projection of a mutable slice descriptor.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 104u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 109u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 108u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(return cursor)))

	(fn write_slice_length
		(:doc `Append the signed element count field of a slice descriptor.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 46u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 108u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 103u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 104u8 writing))
			(return cursor)))

	(fn write_array_prefix
		(:doc `Write the common runtime prefix for array operations.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 121u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(return cursor)))

	(fn open_array_allocation
		(:doc `Open a checked array allocation with either the byte shortcut or a native layout.`)
		(params (output (mut-array u8)) (offset u32) (byte bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut output) offset writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(if
				(:doc "The byte helper supplies its own size and alignment.")
				byte
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 56u8 writing))))
			(return (call open_span_suffix (borrow-mut output) cursor writing))))

	(fn open_array_layout_query
		(:doc `Open a native element size or alignment argument after the evaluated count.`)
		(params (output (mut-array u8)) (offset u32) (alignment bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut output) offset 44u8 writing))
			(if
				(:doc "The layout argument selects either _Alignof or sizeof.")
				alignment
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 65u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 108u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 103u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing)))
				(else
					(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 122u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 102u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(return cursor)))

	(fn open_array_drop
		(:doc `Open a release of an owning array.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut output) offset writing))
			(set cursor (call c_byte (borrow-mut output) cursor 100u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 112u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(return cursor)))

	(fn open_array_borrow
		(:doc `Open the shared or exclusive projection of an owning byte array.`)
		(params (output (mut-array u8)) (offset u32) (exclusive bool) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_array_prefix (borrow-mut output) offset writing))
			(set cursor (call c_byte (borrow-mut output) cursor 98u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(if
				(:doc "The projection returns a descriptor in the requested access mode.")
				exclusive
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 109u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing)))
				(else
					(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 104u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 100u8 writing))))
			(return (call c_byte (borrow-mut output) cursor 40u8 writing))))

	(fn c_decimal_width
		(:doc "Measure a signed C decimal spelling without formatting digits or touching the output view.")
		(params (value i32))
		(returns u32)
		(body
			(let-mut magnitude 0u32)
			(let-mut sign 0u32)
			(if
				(:doc "Take the final unit in u32 to make the signed minimum representable.")
				value.ltz
				(then
					(set magnitude (u32:inc (u32:from-i32 (i32:sub -1i32 value))))
					(set sign 1u32))
				(else (set magnitude (u32:from-i32 value))))
			(if (magnitude.lt 10u32) (then (return sign.inc)))
			(if (magnitude.lt 100u32) (then (return (sign.add 2u32))))
			(if (magnitude.lt 1000u32) (then (return (sign.add 3u32))))
			(if (magnitude.lt 10000u32) (then (return (sign.add 4u32))))
			(if (magnitude.lt 100000u32) (then (return (sign.add 5u32))))
			(if (magnitude.lt 1000000u32) (then (return (sign.add 6u32))))
			(if (magnitude.lt 10000000u32) (then (return (sign.add 7u32))))
			(if (magnitude.lt 100000000u32) (then (return (sign.add 8u32))))
			(if (magnitude.lt 1000000000u32) (then (return (sign.add 9u32))))
			(return (sign.add 10u32))))

	(fn write_c_number
		(:doc "Measure a signed C operand or format it directly into the admitted output view.")
		(params (output (mut-array u8)) (offset u32) (value i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The saturated cursor remains saturated in either pass.")
				(offset.eq c_output_limit)
				(then (return offset)))
			(if
				(:doc "The measuring pass admitted enough space for every digit in the writing pass.")
				writing
				(then (return (u32:from-i32 (call write_decimal_i32 (borrow-mut output)
					(i32:from-u32 offset) value)))))
			(let end (offset.add (call c_decimal_width value)))
			(if
				(:doc "Count a whole decimal at once while preserving the C emitter's size limit.")
				(c_output_limit.lt end)
				(then (return c_output_limit)))
			(return end)))

	(fn write_site_number
		(:doc `Append one comma-separated source site number.`)
		(params (output (mut-array u8)) (offset u32) (value i32) (writing bool))
		(returns u32)
		(body
			(let next (call c_byte (borrow-mut output) offset 44u8 writing))
			(return (call write_c_number (borrow-mut output) next value writing))))

	(fn write_runtime_site
		(:doc `Append the original file identity and half-open byte span to a generated runtime operand list.`)
		(params (output (mut-array u8)) (offset u32) (file i32) (start i32) (end i32) (writing bool))
		(returns u32)
		(body
			(let file_end (call write_site_number (borrow-mut output) offset
				file writing))
			(let start_end (call write_site_number (borrow-mut output) file_end
				start writing))
			(return (call write_site_number (borrow-mut output) start_end
				end writing))))

	(fn close_runtime_call
		(:doc `Attach the original operation site and close the runtime call.`)
		(params (output (mut-array u8)) (offset u32) (file i32) (start i32) (end i32) (writing bool))
		(returns u32)
		(body
			(let end_end (call write_runtime_site (borrow-mut output) offset
				file start end writing))
			(return (call c_byte (borrow-mut output) end_end 41u8 writing)))))
