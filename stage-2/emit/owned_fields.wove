(module emit_owned_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit projected owner slots and array loans.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only is_writable_slice (type ScalarRecord)))
	(use wove-file "../scalar/owners.wove" (only (value native_handle_slot_borrow_kind)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "./records.wove" (only write_field_place write_parameter_name))
	(use wove-file "./runtime.wove" (only close_runtime_call open_array_borrow))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))
	(use wove-file "./owners.wove" (only write_bridge_result_type write_native_handle_check (value c_handle_check)))

	(let array_take_open "wvrt_array_take(&")

	(fn write_owner_slot
		(:doc "Write the checked local owner or its original projected field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let place row/projection)
			(if
				(:doc "The field path reaches the original storage without a value copy.")
				place.not-ltz
				(then (return (call write_field_place (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) place tree_base
					(borrow-mut output) offset name_prefix writing))))
			(return (call write_local_name (borrow-shared source) (borrow-shared nodes)
				row/target tree_base (borrow-mut output) offset name_prefix writing))))

	(fn write_array_take
		(:doc "Read the original array pointer and clear its slot in a single evaluation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared array_take_open)
				(borrow-mut output) offset writing))
			(let slot (call write_owner_slot (borrow-shared source) (borrow-shared nodes) row
				(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) tree_base
				(borrow-mut output) open name_prefix writing))
			(return (call c_byte (borrow-mut output) slot 41u8 writing))))

	(let native_take_open "__extension__({__auto_type wvrt_slot=&")
	(let native_take_result ";__auto_type wvrt_handle=*wvrt_slot;*wvrt_slot=0;wvrt_handle;})")

	(fn write_native_slot_take
		(:doc "Transfer a typed C pointer through its actual slot and null that slot without an aliasing cast.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared native_take_open)
				(borrow-mut output) offset writing))
			(let slot (call write_owner_slot (borrow-shared source) (borrow-shared nodes) row
				(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) tree_base
				(borrow-mut output) open name_prefix writing))
			(return (call c_literal_text (borrow-shared native_take_result)
				(borrow-mut output) slot writing))))

	(fn write_owned_field_loan
		(:doc "Borrow the original array pointer stored in a checked field path.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call open_array_borrow (borrow-mut output) offset
				(call is_writable_slice row/type) writing))
			(let field (call write_field_place (borrow-shared source) (borrow-shared nodes)
				(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) row/projection tree_base
				(borrow-mut output) open name_prefix writing))
			(return (call c_byte (borrow-mut output) field 41u8 writing))))

	(fn write_native_handle_slot
		(:doc "Write the original parameter, local, or projected native pointer lvalue.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (place i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let value (expressions.get place))
			(if
				(:doc "A record member supplies its actual typed field address.")
				(value/kind.eq 52u32)
				(then (return (call write_field_place (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) place tree_base
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A pointer presence test can read an incoming optional record loan.")
				(value/kind.eq 2u32)
				(then (return (call write_parameter_name (borrow-shared source) (borrow-shared nodes)
					(parameters.get value/target)
					(borrow-mut output) offset name_prefix writing))))
			(return (call write_local_name (borrow-shared source) (borrow-shared nodes)
				value/target tree_base (borrow-mut output) offset name_prefix writing))))

	(let cleared_handle "=0,")

	(fn write_owner_transfer
		(:doc `Check a captured pointer and clear its original owner when the consuming argument executes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord))
			(tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let checked (call write_native_handle_check (borrow-shared source) (borrow-shared nodes) expression expression/first
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) checked 44u8 writing))
			(let slot (call write_native_handle_slot (borrow-shared source) (borrow-shared nodes)
				(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) expression/first tree_base (borrow-mut output) comma name_prefix writing))
			(let cleared (call c_literal_text (borrow-shared cleared_handle) (borrow-mut output) slot writing))
			(let pointer (call write_temporary_name (borrow-shared nodes) expression/first
				(borrow-mut output) cleared name_prefix writing))
			(return (call c_byte (borrow-mut output) pointer 41u8 writing))))

	(let c_handle_shared_type "const void")
	(let c_handle_out_check "wvrt_check_c_handle_empty(")
	(let out_temporary_name "* ")
	(let out_check_open "=(")
	(let out_address ",&")
	(let out_check_close ");")

	(fn write_native_handle_slot_capture
		(:doc "Check owner state at the borrow span and capture the original native pointer slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression)
			(index i32) (tree_base i32) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let shared (site/kind.eq native_handle_slot_borrow_kind))
			(let-mut type offset)
			(if
				(:doc "Only an initializing loan exposes the writable slot's native pointee type.")
				shared
				(then (set type (call c_literal_text (borrow-shared c_handle_shared_type)
					(borrow-mut output) offset writing)))
				(else (set type (call write_bridge_result_type (borrow-shared source) (borrow-shared nodes)
					site/type (borrow-mut output) offset writing))))
			(let pointer (call c_literal_text (borrow-shared out_temporary_name)
				(borrow-mut output) type writing))
			(let temporary (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) pointer name_prefix writing))
			(let open (call c_literal_text (borrow-shared out_check_open)
				(borrow-mut output) temporary writing))
			(let-mut check open)
			(if
				(:doc "Read-only loans require a present owner while initializing loans require an empty slot.")
				shared
				(then (set check (call c_literal_text (borrow-shared c_handle_check)
					(borrow-mut output) open writing)))
				(else (set check (call c_literal_text (borrow-shared c_handle_out_check)
					(borrow-mut output) open writing))))
			(let owner (call write_native_handle_slot (borrow-shared source) (borrow-shared nodes)
				(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) site/first tree_base (borrow-mut output) check name_prefix writing))
			(let checked (call close_runtime_call (borrow-mut output) owner
				site/target site/start site/end writing))
			(let address (call c_literal_text (borrow-shared out_address)
				(borrow-mut output) checked writing))
			(let slot (call write_native_handle_slot (borrow-shared source) (borrow-shared nodes)
				(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) site/first tree_base (borrow-mut output) address name_prefix writing))
			(return (call c_literal_text (borrow-shared out_check_close)
				(borrow-mut output) slot writing))))

)
