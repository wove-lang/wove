(module emit_owned_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit projected owner slots and array loans.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only is_writable_slice))
	(use wove-file "../scalar/owners.wove" (only (value native_handle_slot_borrow_kind)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "./records.wove" (only write_field_place write_parameter_name))
	(use wove-file "./runtime.wove" (only close_runtime_call open_array_borrow))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))
	(use wove-file "./owners.wove" (only write_bridge_result_type write_native_handle_check (value c_handle_check)))

	(let array_take_open "wvrt_array_take(&")

	(fn write_owner_slot
		(:doc "Write the checked local owner or its original projected field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let place (struct.get (local row) projection))
			(if
				(:doc "The field path reaches the original storage without a value copy.")
				(i32.not-ltz (local place))
				(then (return (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local place) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local row) target) (local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))

	(fn write_array_take
		(:doc "Read the original array pointer and clear its slot in a single evaluation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local array_take_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let slot (call write_owner_slot (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)
				(borrow-shared (local parameters)) (borrow-shared (local expressions)) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local slot) 41u8 (local writing)))))

	(let native_take_open "__extension__({__auto_type wvrt_slot=&")
	(let native_take_result ";__auto_type wvrt_handle=*wvrt_slot;*wvrt_slot=0;wvrt_handle;})")

	(fn write_native_slot_take
		(:doc "Transfer a typed C pointer through its actual slot and null that slot without an aliasing cast.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local native_take_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let slot (call write_owner_slot (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)
				(borrow-shared (local parameters)) (borrow-shared (local expressions)) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local native_take_result))
				(borrow-mut (local output)) (local slot) (local writing)))))

	(fn write_owned_field_loan
		(:doc "Borrow the original array pointer stored in a checked field path.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call open_array_borrow (borrow-mut (local output)) (local offset)
				(call is_writable_slice (struct.get (local row) type)) (local writing)))
			(let field (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local expressions)) (borrow-shared (local parameters)) (struct.get (local row) projection) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local field) 41u8 (local writing)))))

	(fn write_native_handle_slot
		(:doc "Write the original parameter, local, or projected native pointer lvalue.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (place i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let value (array.load (local expressions) (local place)))
			(if
				(:doc "A record member supplies its actual typed field address.")
				(u32.eq (struct.get (local value) kind) 52u32)
				(then (return (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local place) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A pointer presence test can read an incoming optional record loan.")
				(u32.eq (struct.get (local value) kind) 2u32)
				(then (return (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(array.load (local parameters) (struct.get (local value) target))
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local value) target) (local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))

	(let cleared_handle "=0,")

	(fn write_owner_transfer
		(:doc `Check a captured pointer and clear its original owner when the consuming argument executes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let checked (call write_native_handle_check (borrow-shared (local source)) (borrow-shared (local nodes)) (local expression) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local checked) 44u8 (local writing)))
			(let slot (call write_native_handle_slot (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (borrow-shared (local expressions)) (struct.get (local expression) first) (local tree_base) (borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(let cleared (call c_literal_text (borrow-shared (local cleared_handle)) (borrow-mut (local output)) (local slot) (local writing)))
			(let pointer (call write_temporary_name (borrow-shared (local source)) (struct.get (local expression) first) (local tree_base)
				(borrow-mut (local output)) (local cleared) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local pointer) 41u8 (local writing)))))

	(let c_handle_shared_type "const void")
	(let c_handle_out_check "wvrt_check_c_handle_empty(")
	(let out_temporary_name "* ")
	(let out_check_open "=(")
	(let out_address ",&")
	(let out_check_close ");")

	(fn write_native_handle_slot_capture
		(:doc "Check owner state at the borrow span and capture the original native pointer slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression)
			(index i32) (tree_base i32) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let shared (u32.eq (struct.get (local site) kind) (local native_handle_slot_borrow_kind)))
			(let-mut type (local offset))
			(if
				(:doc "Only an initializing loan exposes the writable slot's native pointee type.")
				(local shared)
				(then (set (local type) (call c_literal_text (borrow-shared (local c_handle_shared_type))
					(borrow-mut (local output)) (local offset) (local writing))))
				(else (set (local type) (call write_bridge_result_type (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local site) type) (borrow-mut (local output)) (local offset) (local writing)))))
			(let pointer (call c_literal_text (borrow-shared (local out_temporary_name))
				(borrow-mut (local output)) (local type) (local writing)))
			(let temporary (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local pointer) (local name_prefix) (local writing)))
			(let open (call c_literal_text (borrow-shared (local out_check_open))
				(borrow-mut (local output)) (local temporary) (local writing)))
			(let-mut check (local open))
			(if
				(:doc "Read-only loans require a present owner while initializing loans require an empty slot.")
				(local shared)
				(then (set (local check) (call c_literal_text (borrow-shared (local c_handle_check))
					(borrow-mut (local output)) (local open) (local writing))))
				(else (set (local check) (call c_literal_text (borrow-shared (local c_handle_out_check))
					(borrow-mut (local output)) (local open) (local writing)))))
			(let owner (call write_native_handle_slot (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (borrow-shared (local expressions)) (struct.get (local site) first) (local tree_base) (borrow-mut (local output)) (local check) (local name_prefix) (local writing)))
			(let checked (call close_runtime_call (borrow-mut (local output)) (local owner)
				(struct.get (local site) target) (struct.get (local site) start) (struct.get (local site) end) (local writing)))
			(let address (call c_literal_text (borrow-shared (local out_address))
				(borrow-mut (local output)) (local checked) (local writing)))
			(let slot (call write_native_handle_slot (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (borrow-shared (local expressions)) (struct.get (local site) first) (local tree_base) (borrow-mut (local output)) (local address) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local out_check_close))
				(borrow-mut (local output)) (local slot) (local writing)))))

)
