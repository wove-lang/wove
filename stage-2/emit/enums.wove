(module emit_enums
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write checked enum constructors, case labels, and case-local payload copies.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_member_name write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_text_fragment write_temporary_name write_local_name))
	(use wove-file "./runtime.wove" (only write_c_number))

	(use wove-file "./integers.wove" (only write_integer_literal))

	(let c_switch "switch(")
	(let c_switch_body "){")
	(let c_case "case ")
	(let c_case_body ":{")
	(let c_case_default "default:{")
	(let c_case_break "break;")
	(let c_switch_end "default:__builtin_trap();}")
	(let c_enum_tag ".wvrt_tag")
	(let c_constructor_tag "){.wvrt_tag=")
	(let c_constructor_payload ",.wvrt_payload={.")
	(let c_case_payload ".wvrt_payload.")

	(fn write_enum_ordinal
		(:doc `Use the same checked decimal ordinal for a constructor and its case label.`)
		(params (ordinal i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_number (borrow-mut (local output)) (local offset)
				(local ordinal) (local writing)))))

	(fn write_case_open
		(:doc `Open the label and scope of a literal case, enum variant, or wildcard.`)
		(params (source (shared-array u8)) (expressions (shared-array ScalarExpression))
			(label i32) (integer bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The explicit wildcard provides the switch's default arm.")
				(i32.ltz (local label))
				(then (return (call c_literal_text (borrow-shared (local c_case_default))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_case))
				(borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "Integer labels use the same bounded literals as normal expressions, including signed minima.")
				(local integer)
				(then (set (local cursor) (call write_integer_literal (borrow-shared (local source))
					(array.load (local expressions) (local label)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call write_enum_ordinal (local label) (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_case_body))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn close_match_switch
		(:doc "Only an exhaustive enum match with no wildcard needs a synthesized trap for impossible ordinals.")
		(params (arm ScalarStatement) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A written default already makes the switch exhaustive.")
				(i32.ltz (struct.get (local arm) target))
				(then (return (call c_byte (borrow-mut (local output)) (local offset) 125u8 (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_switch_end))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_payload_constructor
		(:doc `Build a tagged value using the already evaluated payload in its selected union member.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let type (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (struct.get (local row) type)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let tag (call c_literal_text (borrow-shared (local c_constructor_tag))
				(borrow-mut (local output)) (local type) (local writing)))
			(let ordinal (struct.get (local row) target))
			(let-mut cursor (call write_enum_ordinal (local ordinal) (borrow-mut (local output)) (local tag) (local writing)))
			(let value (struct.get (local row) first))
			(if
				(:doc "Only a payload constructor explicitly initializes a union member.")
				(i32.lt -1i32 (local value))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local c_constructor_payload))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_member_name (borrow-shared (local source)) (local ordinal)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local value)
						(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))))

	(fn write_case_entry
		(:doc `Open the selected case and initialize its payload or hidden wildcard owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(arm ScalarStatement) (integer bool) (subject i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let ordinal (struct.get (local arm) target))
			(let-mut cursor (call write_case_open (borrow-shared (local source)) (borrow-shared (local expressions))
				(local ordinal) (local integer) (borrow-mut (local output)) (local offset) (local writing)))
			(let name (struct.get (local arm) value))
			(if (i32.ltz (local name)) (then (return (local cursor))))
			(let type (struct.get (array.load (local statements) (local name)) type))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local name) (local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local subject)
				(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "A wildcard owns the whole captured enum. A known variant names only its active union member.")
				(i32.lt -1i32 (local ordinal))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local c_case_payload))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_member_name (borrow-shared (local source)) (local ordinal)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
			(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) 4u32 (local writing)))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local name) (local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing))))))
