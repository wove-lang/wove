(module emit_enums
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write checked enum ordinals and matched case boundaries in C.`)

	(use wove-file "./text.wove" (only c_literal_text))
	(use wove-file "./runtime.wove" (only write_c_number))

	(let c_switch "switch(")
	(let c_switch_body "){")
	(let c_case "case ")
	(let c_case_body ":{")
	(let c_case_break "break;")
	(let c_switch_end "default:__builtin_trap();}")

	(fn write_enum_ordinal
		(:doc `Use the same checked decimal ordinal for a constructor and its case label.`)
		(params (ordinal i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut digits (array.alloc u8 11i32))
			(return (call write_c_number (borrow-mut (local output)) (local offset)
				(local ordinal) (borrow-mut (local digits)) (local writing)))))

	(fn write_case_open
		(:doc `Begin a single case in braces so its local declarations have their own C scope.`)
		(params (ordinal i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local c_case))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let label (call write_enum_ordinal (local ordinal) (borrow-mut (local output)) (local open) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_case_body))
				(borrow-mut (local output)) (local label) (local writing))))))
