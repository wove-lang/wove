(module emit_enums
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write checked enum constructors, case labels, and case-local payload copies.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only expression_row (type ScalarExpression)))
	(use wove-file "../source/types.wove" (only is_builtin_integer))
	(use wove-file "../scalar/records.wove" (only record_index (type ScalarRecord)))
	(use wove-file "./members.wove" (only named_member variant_at_ordinal write_member))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_text_fragment write_temporary_name write_local_name))
	(use wove-file "./runtime.wove" (only write_c_number))

	(use wove-file "./integers.wove" (only write_integer_literal))

	(let c_switch "switch(")
	(let c_switch_body "){")
	(let c_case "case ")
	(let c_case_body ":{")
	(let c_case_default "default:{")
	(let c_case_break "break;")
	(let c_switch_end "default:__builtin_trap();}")
	(let c_enum_tag ".wvrt_tag")
	(let c_constructor_tag "){.wvrt_tag=")
	(let c_constructor_payload ",.wvrt_payload={.")
	(let c_case_payload ".wvrt_payload.")

	(fn write_enum_ordinal
		(:doc `Use the same checked decimal ordinal for a constructor and its case label.`)
		(params (ordinal i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_number (borrow-mut output) offset
				ordinal writing))))

	(fn write_case_open
		(:doc `Open the label and scope of a literal case, enum variant, or wildcard.`)
		(params (source (shared-array u8)) (expressions (shared-array ScalarExpression))
			(label i32) (integer bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The explicit wildcard provides the switch's default arm.")
				(i32:ltz label)
				(then (return (call c_literal_text (borrow-shared c_case_default)
					(borrow-mut output) offset writing))))
			(let-mut cursor (call c_literal_text (borrow-shared c_case)
				(borrow-mut output) offset writing))
			(if
				(:doc "Integer labels use the same bounded literals as normal expressions, including signed minima.")
				integer
				(then (set cursor (call write_integer_literal (borrow-shared source)
					(expressions.get label) (borrow-mut output) cursor writing)))
				(else (set cursor (call write_enum_ordinal label (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared c_case_body)
				(borrow-mut output) cursor writing))))

	(fn close_match_switch
		(:doc "Only an exhaustive enum match with no wildcard needs a synthesized trap for impossible ordinals.")
		(params (arm ScalarStatement) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A written default already makes the switch exhaustive.")
				(i32:ltz (arm.get target))
				(then (return (call c_byte (borrow-mut output) offset 125u8 writing))))
			(return (call c_literal_text (borrow-shared c_switch_end)
				(borrow-mut output) offset writing))))

	(fn write_payload_constructor
		(:doc `Build a tagged value using the already evaluated payload in its selected union member.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let type (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (row.get type)
				(borrow-mut output) open name_prefix writing))
			(let tag (call c_literal_text (borrow-shared c_constructor_tag)
				(borrow-mut output) type writing))
			(let ordinal (row.get target))
			(let-mut cursor (call write_enum_ordinal ordinal (borrow-mut output) tag writing))
			(let value (row.get first))
			(if
				(:doc "Only a payload constructor explicitly initializes a union member.")
				(i32:lt -1i32 value)
				(then
					(set cursor (call c_literal_text (borrow-shared c_constructor_payload)
						(borrow-mut output) cursor writing))
					(let layout (records.get (call record_index (row.get type))))
					(let variant (call variant_at_ordinal (borrow-shared nodes) layout ordinal))
					(let member (call named_member layout (nodes.get (variant.get first_child))))
					(set cursor (call write_member (borrow-shared source) member
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) value (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))))
			(return (call c_byte (borrow-mut output) cursor 125u8 writing))))

	(fn close_transfer_outcome
		(:doc "Finish a recoverable transfer with unit success or the original captured job or element.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (rejected i32) (value i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let accepted (call expression_row 0u32 type (i32:sub 1i32 rejected) -1i32 0i32 0i32 (bool false)))
			(let returned (call expression_row 0u32 type rejected value 0i32 0i32 (bool false)))
			(let choose (call c_byte (borrow-mut output) offset 63u8 writing))
			(let success (call write_payload_constructor (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) accepted
				(borrow-mut output) choose name_prefix writing))
			(let otherwise (call c_byte (borrow-mut output) success 58u8 writing))
			(let failure (call write_payload_constructor (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) returned
				(borrow-mut output) otherwise name_prefix writing))
			(return (call c_byte (borrow-mut output) failure 41u8 writing))))

	(fn write_case_entry
		(:doc `Open the selected case and initialize its payload or hidden wildcard owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(arm ScalarStatement) (subject_type u32) (subject i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let ordinal (arm.get target))
			(let-mut cursor (call write_case_open (borrow-shared source) (borrow-shared expressions)
				ordinal (call is_builtin_integer subject_type) (borrow-mut output) offset writing))
			(let name (arm.get value))
			(if (i32:ltz name) (then (return cursor)))
			(let type (struct:get (statements.get name) type))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
				name tree_base (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) subject (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "A wildcard owns the whole captured enum. A known variant names only its active union member.")
				(i32:lt -1i32 ordinal)
				(then
					(set cursor (call c_literal_text (borrow-shared c_case_payload)
						(borrow-mut output) cursor writing))
					(let layout (records.get (call record_index subject_type)))
					(let variant (call variant_at_ordinal (borrow-shared nodes) layout ordinal))
					(let member (call named_member layout (nodes.get (variant.get first_child))))
					(set cursor (call write_member (borrow-shared source) member
						(borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
			(set cursor (call c_text_fragment (borrow-mut output) cursor 4u32 writing))
			(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
				name tree_base (borrow-mut output) cursor name_prefix writing))
			(return (call c_byte (borrow-mut output) cursor 59u8 writing)))))
