(module emit_members
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Use the checked layout and source key to spell generated aggregate members.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only record_index record_receiver_type (type ScalarRecord)))
	(use wove-file "./names.wove" (only child_identity (value member_role)))
	(use wove-file "./text.wove" (only get_name member_name_role (type CNameParent) (type CNameSpelling)))

	(struct CMember (fields (identity u32) (start i32) (end i32)))

	(fn ordinal_member
		(:doc "Keep the existing unnamed placeholder spelling.")
		(params (ordinal i32)) (returns CMember)
		(body (return (struct:new CMember (identity (u32:from-i32 ordinal))
			(start 0i32) (end 0i32)))))

	(fn named_member
		(:doc "Hash the exact checked field or variant spelling in its concrete Wove layout.")
		(params (source (shared-array u8)) (layout ScalarRecord) (name SourceNode))
		(returns CMember)
		(body
			(let start (name.get start))
			(let end (name.get end))
			(return (struct:new CMember
				(identity (call child_identity (borrow-shared source) start end (layout.get identity) member_role))
				(start start) (end end)))))

	(fn projected_member
		(:doc "Recover a projection's concrete receiver layout and its checked field spelling.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (projection ScalarExpression)) (returns CMember)
		(body
			(let receiver (projection.get first))
			(let type (call record_receiver_type (struct:get (expressions.get receiver) type)))
			(let name (nodes.get (struct:get (nodes.get receiver) next_sibling)))
			(return (call named_member (borrow-shared source) (records.get (call record_index type)) name))))

	(fn write_member
		(:doc "Use the shared name constructor in the selected aggregate's C member namespace.")
		(params (source (shared-array u8)) (member CMember)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(return (call get_name
				(struct:new CNameParent (identity (member.get identity)) (slot 0i32))
				(call member_name_role)
				(struct:new CNameSpelling (start (member.get start)) (end (member.get end)) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn variant_at_ordinal
		(:doc "Recover the defining variant selected by a checked enum discriminant.")
		(params (nodes (shared-array SourceNode)) (layout ScalarRecord) (ordinal i32)) (returns SourceNode)
		(body
			(let-mut variant (layout.get first))
			(let-mut remaining ordinal)
			(while
				(:doc "Include every declared variant when locating the case, including unit variants.")
				(i32:gtz remaining)
				(body
					(set variant (struct:get (nodes.get variant) next_sibling))
					(set remaining (i32:dec remaining))))
			(return (nodes.get variant))))
)
