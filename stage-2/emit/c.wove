			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(return (call c_byte (borrow-mut output) cursor 123u8 writing))))

	(fn has_c_argument_adapters
		(:doc "Identify native argument and result adapters beyond bounds, storage, and admitted operands.")
		(:pragma (inline always))
		(params (function ScalarFunction) (checked_strings bool) (checked_fixed bool))
		(returns bool)
		(body
			(let strings (bool.and (bool.not checked_strings)
				(bool.or (i32.gtz (struct.get function c_strings))
					(bool.or (i32.gtz (struct.get function c_nulls)) (struct.get function c_snapshot)))))
			(return (bool.or (bool.or strings (struct.get function c_vectors))
				(bool.or (struct.get function c_void_pointer)
