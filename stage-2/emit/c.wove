		open_worker_pack write_worker_drop_argument open_worker_unpack is_record_worker_launch write_worker_record_collection))
	(use wove-file "../scalar/worker.wove" (only worker_collection_record))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_destructor write_native_handle_borrow))
