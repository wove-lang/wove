(module emit_c
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a complete C translation unit for checked local scalar functions.

	Keep main on the C ABI and generate stable internal symbols for other
	selected declarations. Resolve calls and bindings in the source plan
	before measuring or writing any C text.`)

	(use wove-file "../source/float_ops.wove" (only is_float_conversion (value float_literal)))
	(use wove-file "./floats.wove" (only write_floating_literal write_floating_conversion))
	(use wove-file "../source/enum_forms.wove" (only (value enum_constructor) (value enum_payload_constructor) (value match_statement)
		(value match_value) (value match_value_case)))
