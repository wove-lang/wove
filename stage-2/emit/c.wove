			(call has_c_other_arguments function (bool false))))))

	(fn is_c_argument_call
		(:doc `Identify a native call that needs ordered, typed argument captures.`)
		(params (row ScalarExpression) (functions (shared-array ScalarFunction)))
		(returns bool)
		(body
