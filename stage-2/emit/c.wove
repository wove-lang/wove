				(borrow-shared (local declarations)) (borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records))
				(borrow-shared (local bindings)) (local file) (bool true)
				(borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Signature, name, and stable identity failures precede any C emission.")
				(u32.lt 0u32 (record.get (local signatures) error))
				(then (return (call emit_result 0i32 (record.get (local signatures) start)
					(record.get (local signatures) end) (record.get (local signatures) error)))))
			(let-mut sites (array.alloc CallSite (slice.len (local nodes))))
			(let checked (call plan_bodies (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local bindings))
				(borrow-shared (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
				(borrow-mut (local sites)) (local view_start)))
			(if
				(:doc "Preserve the primary span and any related transfer from body checking.")
