(module emit_c
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a complete C translation unit for checked local scalar functions.

	Keep main on the C ABI and generate stable internal symbols for other
	selected declarations. Resolve calls and bindings in the source plan
	before measuring or writing any C text.`)

	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../scalar/records.wove" (only count_declarations record_index is_native_record is_place_reference record_receiver_type place_borrow_kind is_native_integer is_typed_slice slice_element_type is_readable_slice is_writable_slice is_array_owner array_owner_element (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type write_member_name write_member_separator write_parameter_name write_field_place write_place_borrow captures_value_argument write_record_layouts write_record_layout_argument))
	(use wove-file "./arrays.wove" (only write_fixed_list write_fixed_repeat write_fixed_access write_fixed_slice))
	(use wove-file "../scalar/owners.wove" (only is_native_owner native_handle_borrow_kind owner_is_null_kind native_handle_consume_kind
			is_optional_byte_owner_type optional_unwrap_kind))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset)))
	(use wove-file "./embeds.wove" (only close_embed_copy request_module_embeds bind_module_embeds))
	(use wove-file "./c_values.wove" (only has_c_values write_c_value_name))
	(use wove-file "./bindings.wove" (only write_binding_name write_module_bindings))
	(use wove-file "./owners.wove" (only write_native_destructor write_native_handle_borrow write_owner_transfer))
	(use wove-file "../c/arguments.wove" (only c_null_argument_kind))
	(use wove-file "./c_snapshots.wove" (only write_optional_unwrap))
	(use wove-file "./c_arguments.wove" (only write_c_argument_call c_symbol_text))
	(use wove-file "./c_variadic.wove" (only write_c_variadic_check))
	(use wove-file "../scalar/flow.wove" (only after_block (type ScalarStatement) (value c_value_expression) (value c_value_assignment)
			(value fixed_shared_loan) (value fixed_mut_loan) (value field_assignment)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only read_module_declarations plan_bodies (type ScalarFunction) (type ScalarParameter) (type CallSite)))
	(use wove-file "../scalar/syntax.wove" (only scalar_operator is_reborrow_keyword word_shift_type is_i32_division is_fixed_access is_fixed_initializer (type ScalarOperator)))
	(use wove-file "./runtime.wove"
		(only write_runtime_header open_host_entry open_conversion open_word_shift_count open_i32_division open_slice_access open_shared_projection write_slice_length close_runtime_call
			open_slice_offset write_slice_items open_array_allocation open_array_copy open_array_drop open_array_borrow))
	(use wove-file "./text.wove" (only c_byte c_span c_text_fragment c_cast c_i32_bias write_c_name write_decimal_literal
			function_name_role write_temporary_name write_local_name open_static_value write_static_bytes))

	(struct EmitResult
		(fields (written i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(let signed_wide_cast "(int64_t)")

	(fn uses_host_entry
		(:doc `A checked root with two borrowed parameters needs the host argv wrapper.`)
		(:pragma (inline always))
		(params (function ScalarFunction))
		(returns bool)
		(body (return (bool.and (record.get (local function) entry)
			(i32.lt 0i32 (record.get (local function) arity))))))

	(fn write_function_name
		(:doc `Write the ABI entry or a stable name from a defining function row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function ScalarFunction)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A parameterless entry keeps its conventional C name. The host wrapper calls a generated function.")
				(bool.and (record.get (local function) entry) (bool.not (call uses_host_entry (local function))))
				(then (return (call c_text_fragment (borrow-mut (local output)) (local offset) 1u32 (local writing)))))
			(let name (slice.load (local nodes) (record.get (local function) name)))
			(if
				(:doc "A C bridge call uses the spelling declared in its native header.")
				(i32.lt (record.get (local function) body) 0i32)
				(then (return (call c_symbol_text (borrow-shared (local source)) (local name)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call function_name_role)
				(record.get (local function) identity) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn write_scalar
		(:doc `Write one checked leaf as a literal, binding reference, or slice reborrow.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-slice ScalarParameter)) (expressions (shared-slice ScalarExpression))
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (record.get (local row) kind))
			(if
				(:doc "Read the current value of the original C header expression.")
				(u32.eq (local kind) (local c_value_expression))
				(then (return (call write_c_value_name (borrow-shared (local source))
					(slice.load (local nodes) (record.get (local row) target))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "A place loan points to its original local or parameter storage.")
				(u32.eq (local kind) (call place_borrow_kind))
				(then (return (call write_place_borrow (borrow-shared (local source)) (borrow-shared (local nodes))
					(local row) (borrow-shared (local parameters)) (borrow-shared (local expressions)) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A range loan passes the descriptor already evaluated by its child projection.")
				(u32.eq (local kind) 45u32)
				(then (return (call write_temporary_name (borrow-shared (local source))
					(record.get (local row) first) (local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A fixed array provides inline storage and its compile-time length.")
				(bool.or (u32.eq (local kind) (local fixed_shared_loan)) (u32.eq (local kind) (local fixed_mut_loan)))
				(then (return (call write_fixed_slice (borrow-shared (local source)) (borrow-shared (local nodes))
					(local row) (local tree_base) (borrow-shared (local parameters)) (borrow-shared (local expressions))
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "An array loan projects the owner's pointer without allocating.")
				(record.get (local row) borrowed_owner)
				(then
					(let open (call open_array_borrow (borrow-mut (local output)) (local offset)
						(u32.eq (local kind) 39u32) (local writing)))
					(let value (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(record.get (local row) target) (local tree_base) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local value) 41u8 (local writing)))))
			(if
				(:doc "Parameter references and whole-view reborrows read the same formal descriptor.")
				(bool.or (u32.eq (local kind) 2u32) (call is_reborrow_keyword (local kind)))
				(then
					(let parameter (slice.load (local parameters) (record.get (local row) target)))
					(let type (record.get (local row) type))
					(let projection (bool.and (call is_writable_slice (record.get (local parameter) type))
						(bool.and (call is_readable_slice (local type)) (bool.not (call is_writable_slice (local type))))))
					(let-mut cursor (local offset))
					(if
						(:doc "A shared use of a mutable view projects only the descriptor.")
						(local projection)
						(then (set (local cursor) (call open_shared_projection (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local cursor) (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local parameter) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(if
						(:doc "Finish the shared projection when it was opened.")
						(local projection)
						(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
					(return (local cursor))))
			(if
				(:doc "Read the generated name of the checked local declaration.")
				(u32.eq (local kind) 6u32)
				(then (return (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(record.get (local row) target) (local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A module reference uses its defining name even in a rebased file.")
				(u32.eq (local kind) 62u32)
				(then (return (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(record.get (local row) target) (bool false) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "The plan represents false and true as distinct literal kinds.")
				(u32.lt 3u32 (local kind))
				(then
					(let-mut digit 48u8)
					(if
						(:doc "True converts exactly from the integer constant one.")
						(u32.eq (local kind) 5u32)
						(then (set (local digit) 49u8)))
					(return (call c_byte (borrow-mut (local output)) (local offset) (local digit) (local writing)))))
			(return (call write_decimal_literal (borrow-shared (local source))
				(record.get (local row) start) (record.get (local row) end) (record.get (local row) negative)
				(record.get (local row) type)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn is_runtime_operation
		(:doc `Identify the checked operations that use the shared runtime ABI.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or
				(bool.or (bool.or (call is_i32_division (local kind)) (u32.eq (local kind) (call optional_unwrap_kind))) (bool.or (u32.lt 0u32 (call word_shift_type (local kind))) (call is_fixed_access (local kind))))
				(bool.or (bool.or (u32.eq (local kind) (call native_handle_borrow_kind)) (u32.eq (local kind) (call native_handle_consume_kind)))
					(bool.or (u32.eq (local kind) 33u32)
						(bool.or (u32.eq (local kind) 36u32)
							(bool.or (u32.eq (local kind) 37u32)
								(bool.or (u32.eq (local kind) 40u32)
									(bool.or (u32.eq (local kind) 41u32) (bool.or (u32.eq (local kind) 44u32) (u32.eq (local kind) 60u32))))))))))))

	(fn requires_value_temporary
		(:doc `Identify expressions with their own evaluation step when nested in another expression.`)
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (bool.or (u32.eq (local kind) (local c_value_expression))
					(bool.or (u32.eq (local kind) 3u32) (u32.eq (local kind) (call place_borrow_kind))))
				(bool.or (bool.or (call is_runtime_operation (local kind)) (u32.eq (local kind) (call owner_is_null_kind)))
					(bool.or (bool.or (u32.eq (local kind) 50u32) (u32.eq (local kind) 52u32))
						(bool.or (call is_fixed_initializer (local kind))
							(u32.lt 0u32 (record.get (call scalar_operator (local kind)) result)))))))))

	(fn write_operator
		(:doc `Write an operator using already evaluated operands of its exact type.

		Signed arithmetic uses a wide signed bias to reduce the result and
		return it to the i32 range. Binary operations with a u32 result use
		wide unsigned operands and keep the low 32 bits. u64 operations keep
		all 64 result bits.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression)
			(operator ScalarOperator) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let symbol (record.get (local operator) symbol))
			(let result (record.get (local operator) result))
			(let signed_wrap (u32.eq (local result) 5u32))
			(let unsigned_word (u32.eq (local result) 11u32))
			(let first (record.get (local expression) first))
			(if
				(:doc "Emit the single checked operand after its negation or complement operator.")
				(i32.eq (record.get (local operator) arity) 1i32)
				(then
					(let cursor (call c_byte (borrow-mut (local output)) (local offset) (local symbol) (local writing)))
					(return (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(let second (record.get (slice.load (local nodes) (local first)) next_sibling))
			(let-mut cursor (local offset))
			(if
				(:doc "Open both casts and widen the arithmetic with the signed bias.")
				(local signed_wrap)
				(then
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) 5u32 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) 11u32 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
					(set (local cursor) (call c_i32_bias (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 43u8 (local writing)))
					(if
						(:doc "Widen the multiply before applying the signed bias to its product.")
						(u8.eq (local symbol) 42u8)
						(then (set (local cursor) (call c_span (borrow-shared (local signed_wide_cast))
							0i32 (slice.len (local signed_wide_cast))
							(borrow-mut (local output)) (local cursor) (local writing)))))))
			(if
				(:doc "Widen the left operand before C applies integer promotions to the operation.")
				(local unsigned_word)
				(then
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) 11u32 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) 54u32 (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Equality uses two equals bytes. Both operands already have their native scalar type.")
				(u8.eq (local symbol) 61u8)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local second) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Reduce to uint32_t before subtracting the signed bias.")
				(local signed_wrap)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 45u8 (local writing)))
					(set (local cursor) (call c_i32_bias (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(if
				(:doc "The outer uint32_t cast reduces the unsigned result modulo 2^32.")
				(local unsigned_word)
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(return (local cursor))))

	(fn write_i32_division
		(:doc `Pass both evaluated operands and the original span to checked signed division.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression)
			(tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let left (record.get (local expression) first))
			(let right (record.get (slice.load (local nodes) (local left)) next_sibling))
			(let open (call open_i32_division (borrow-mut (local output)) (local offset) (local writing)))
			(let dividend (call write_temporary_name (borrow-shared (local source)) (local left) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local dividend) 44u8 (local writing)))
			(let divisor (call write_temporary_name (borrow-shared (local source)) (local right) (local tree_base)
				(borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(let flag_start (call c_byte (borrow-mut (local output)) (local divisor) 44u8 (local writing)))
			(let-mut flag 48u8)
			(if
				(:doc "The remainder keyword selects the alternate result of the same check.")
				(u32.eq (record.get (local expression) kind) 77u32)
				(then (set (local flag) 49u8)))
			(let flag_end (call c_byte (borrow-mut (local output)) (local flag_start) (local flag) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local flag_end)
				(record.get (local expression) target) (record.get (local expression) start)
				(record.get (local expression) end) (local writing)))))

	(fn write_word_shift
		(:doc `Shift the evaluated unsigned word after checking the count at the original span.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression)
			(tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let word (record.get (local expression) first))
			(let count (record.get (slice.load (local nodes) (local word)) next_sibling))
			(let kind (record.get (local expression) kind))
			(let type (record.get (local expression) type))
			(let-mut symbol 60u8)
			(if
				(:doc "A logical right shift uses the unsigned left operand with C's right shift.")
				(bool.or (u32.eq (local kind) 69u32) (u32.eq (local kind) 90u32))
				(then (set (local symbol) 62u8)))
			(let narrow (call c_cast (borrow-mut (local output)) (local offset) (local type) (local writing)))
			(let open (call c_byte (borrow-mut (local output)) (local narrow) 40u8 (local writing)))
			(let wide (call c_cast (borrow-mut (local output)) (local open) 54u32 (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local word) (local tree_base)
				(borrow-mut (local output)) (local wide) (local name_prefix) (local writing)))
			(let operator (call c_byte (borrow-mut (local output)) (local value) (local symbol) (local writing)))
			(let after_operator (call c_byte (borrow-mut (local output)) (local operator) (local symbol) (local writing)))
			(let check (call open_word_shift_count (borrow-mut (local output)) (local after_operator) (local type) (local writing)))
			(let count_end (call write_temporary_name (borrow-shared (local source)) (local count) (local tree_base)
				(borrow-mut (local output)) (local check) (local name_prefix) (local writing)))
			(let end (call close_runtime_call (borrow-mut (local output)) (local count_end)
				(record.get (local expression) target) (record.get (local expression) start)
				(record.get (local expression) end) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local end) 41u8 (local writing)))))

	(fn write_slice_access
		(:doc `Read the descriptor length or pass the evaluated operands and original access span to the runtime.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(expressions (shared-slice ScalarExpression)) (expression ScalarExpression) (tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let receiver (record.get (local expression) first))
			(let kind (record.get (local expression) kind))
			(if
				(:doc "Length reads the signed field from the evaluated descriptor.")
				(u32.eq (local kind) 36u32)
				(then
					(let cursor (call write_temporary_name (borrow-shared (local source)) (local receiver) (local tree_base)
						(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
					(return (call write_slice_length (borrow-mut (local output)) (local cursor) (local writing)))))
			(let type (record.get (slice.load (local expressions) (local receiver)) type))
			(if
				(:doc "A typed access indexes the original backing array after the span-aware bounds check.")
				(call is_typed_slice (local type))
				(then (return (call write_typed_slice_access (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local expression) (call slice_element_type (borrow-shared (local records)) (local type)) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let index (record.get (slice.load (local nodes) (local receiver)) next_sibling))
			(let open (call open_slice_access (borrow-mut (local output)) (local offset) (local kind) (local writing)))
			(let view (call write_temporary_name (borrow-shared (local source)) (local receiver) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local view) 44u8 (local writing)))
			(let-mut cursor (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(if
				(:doc "Pass the store value or range end after the already evaluated index or start.")
				(bool.or (u32.eq (local kind) 40u32) (u32.eq (local kind) 44u32))
				(then
					(let third (record.get (slice.load (local nodes) (local index)) next_sibling))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local third) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(record.get (local expression) target) (record.get (local expression) start)
				(record.get (local expression) end) (local writing)))))

	(fn write_typed_slice_access
		(:doc `Read or replace one element in the original storage after checking the index.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(expression ScalarExpression) (element u32) (tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let receiver (record.get (local expression) first))
			(let index (record.get (slice.load (local nodes) (local receiver)) next_sibling))
			(let store (u32.eq (record.get (local expression) kind) 40u32))
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(if
				(:doc "Read through a const element pointer. A store uses the checked writable pointer.")
				(bool.not (local store))
				(then
