(module emit_c
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a complete C translation unit for checked local scalar functions.

	Keep main on the C ABI and generate stable internal symbols for other
	selected declarations. Resolve calls and bindings in the source plan
	before measuring or writing any C text.`)

	(use wove-file "../source/float_ops.wove" (only is_float_conversion (value float_literal)))
	(use wove-file "./floats.wove" (only write_floating_literal write_floating_conversion))
	(use wove-file "../source/enum_forms.wove" (only (value enum_constructor) (value enum_payload_constructor) (value match_statement)
		(value match_value) (value match_value_case)))
	(use wove-file "./enums.wove" (only write_enum_ordinal write_case_entry close_match_switch write_payload_constructor
		(value c_enum_tag) (value c_switch) (value c_switch_body) (value c_case_break)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding) collect_standalone_bindings))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../scalar/records.wove" (only count_declarations record_index is_record_type is_native_record is_optional_record_borrow is_buffered_record buffered_record_layout place_reference_type is_payload_enum is_place_reference is_mutable_place_reference record_receiver_type place_borrow_kind is_native_integer is_typed_slice slice_element_type is_readable_slice is_writable_slice is_array_owner is_owning_record is_owning_array_element array_owner_element (type ScalarRecord)))
	(use wove-file "../scalar/type_sites.wove" (only target_numeric_site))
	(use wove-file "./members.wove" (only named_member projected_member write_member))
	(use wove-file "./records.wove" (only write_value_type write_member_separator write_parameter_name write_parameter_place write_field_place write_place_borrow captures_value_argument write_record_layouts write_array_layout_argument))
	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind) (value optional_view_absent) (value buffered_record_absent) (value optional_view_unwrap)))
	(use wove-file "./slice_options.wove" (only write_slice_option))
	(use wove-file "../source/numeric_ops.wove" (only is_integer_byte_conversion is_integer_byte_encoder))
	(use wove-file "./integer_bytes.wove" (only write_integer_bytes_encode write_integer_bytes_decode))
	(use wove-file "../source/array_growth.wove" (only (value array_try_alloc_kind) is_array_growth is_array_growth_statement (value indexed_row_owner)))
	(use wove-file "./array_growth.wove" (only write_array_growth write_indexed_row_owner))
	(use wove-file "./arrays.wove" (only write_slice_copy write_fixed_list write_fixed_repeat write_fixed_access write_fixed_slice write_fixed_length))
	(use wove-file "./loops.wove" (only write_for_body write_for_owned_view))
	(use wove-file "../scalar/loops.wove" (only iterator_owner_boundary))
	(use wove-file "./conditional.wove" (only write_conditional_edge))
	(use wove-file "./matches.wove" (only write_match_edge))
	(use wove-file "../scalar/conditional.wove" (only (value conditional_value) (value conditional_then) (value conditional_else)))
	(use wove-file "../scalar/owners.wove" (only is_owned_parameter is_worker_owner is_nullable_worker_owner native_handle_borrow_kind owner_is_null_kind native_handle_consume_kind (value native_handle_slot_borrow_kind) (value checked_foreign_handle_kind) is_owner_take owned_aggregate_take_kind owned_array_take_kind owned_field_loan_kind is_native_storage_write_loan is_native_owner_write_loan native_handle_init_borrow_kind
			(value worker_receipt_move_kind) (value worker_permit_move_kind)
			is_optional_owner optional_byte_owner_type optional_owner_payload optional_unwrap_kind))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset)))
	(use wove-file "./embeds.wove" (only request_module_embeds bind_module_embeds))
	(use wove-file "./c_vectors.wove" (only write_c_vector_snapshot))
	(use wove-file "./c_values.wove" (only has_c_values write_c_value_name write_c_string_value))
	(use wove-file "./bindings.wove" (only write_binding_name write_module_bindings (value static_module_bindings)))
	(use wove-file "./function_names.wove" (only write_function_name))
	(use wove-file "./workers.wove" (only write_worker_adapters (value static_worker_adapters) open_record_worker_call write_worker_adapter_name
		open_worker_pack write_worker_drop_argument open_worker_unpack is_record_worker_launch write_worker_record_collection write_worker_try_spawn write_pooled_record_worker write_worker_queue_access))
	(use wove-file "../scalar/worker.wove" (only worker_collection_record))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_destructor write_native_handle_borrow write_native_handle_check))
	(use wove-file "./owner_assignment.wove" (only write_owner_assignment))
	(use wove-file "./owned_fields.wove" (only write_array_take write_native_slot_take write_native_handle_slot_capture write_native_handle_slot write_owner_transfer write_owned_field_loan))
	(use wove-file "./owner_checks.wove" (only write_inline_owner_argument_check))
	(use wove-file "./owned_aggregates.wove" (only write_aggregate_take write_aggregate_drop open_owned_slot_call write_owning_layout_helpers))
	(use wove-file "./c_storage.wove" (only write_storage_allocation write_storage_cleanup write_string_vector_view))
	(use wove-file "../c/arguments.wove" (only c_null_argument_kind (value c_static_string_argument) (value c_adapted_callback_argument)))
	(use wove-file "../source/owned.wove" (only (value optional_none) (value optional_some)))
	(use wove-file "./c_snapshots.wove" (only write_optional_unwrap))
	(use wove-file "./c_record_out.wove" (only open_buffered_field write_buffered_record_borrow))
	(use wove-file "./c_arguments.wove" (only write_c_argument_call write_static_c_string))
	(use wove-file "./c_callbacks.wove" (only write_callback_adapters))
	(use wove-file "./c_prototype.wove" (only write_c_prototype_check))
	(use wove-file "./c_formals.wove" (only native_nullable_needs_prototype fixed_c_needs_prototype native_owner_needs_prototype native_long_double_needs_prototype native_static_strings native_sync_callbacks write_fixed_c_checks))
	(use wove-file "../scalar/flow.wove" (only after_block is_loop_exit (value break_statement) (value for_statement) (value for_source_owner) (value for_element_assignment) (type ScalarStatement) (value c_value_expression) (value c_value_snapshot_expression) (value c_value_assignment)
			(value fixed_shared_loan) (value fixed_mut_loan) (value field_assignment) (value parameter_assignment) (value owner_assignment) (value owner_field_assignment)))
	(use wove-file "../scalar/loans.wove" (only is_local_slice_view indexed_growth_receiver is_c_inline_projection is_buffered_field_projection (value indirect_local_place) (value inline_owner_argument_guard) (value local_slice_projection) (value scoped_field_loan) (value indexed_record_loan) (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only read_module_declarations plan_bodies (type CallSite)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count is_record_input (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/syntax.wove" (only is_direct_call (value array_try_copy_kind) (value borrowed_record_unwrap_kind) (value buffered_record_borrow_kind) (value fn_ref_kind) (value indirect_call_kind) is_worker_launch is_worker_collect is_worker_pool_operation is_worker_queue_access
		(value worker_spawn_kind) (value worker_spawn_on_kind) (value worker_try_spawn_kind) (value worker_open_pool_kind)
		(value worker_try_reserve_kind) (value worker_reserve_wait_kind) (value worker_join_kind) (value worker_queue_kind) (value worker_push_kind) scalar_operator is_reborrow_keyword is_fixed_access is_fixed_initializer (value fixed_subarray_place) (value fixed_owner_take) (value fixed_owner_transfer) (value fixed_owner_borrow) (value fixed_owner_store) native_alloc_kind native_empty_kind
		(value native_tail_report_kind) (value native_tail_load_kind) (value native_tail_report_borrow_kind)
		(value native_cstrs_view_kind) (value native_cstrs_len_kind) (value native_cstrs_load_kind) (value buffered_cstrs_type) (type ScalarOperator)))
	(use wove-file "../source/integer_bits.wove" (only word_count_type word_bit_count_type word_rotates word_moves_right word_mask_type))
	(use wove-file "./runtime.wove"
		(only write_runtime_header open_host_entry open_conversion open_word_shift_count open_word_rotate write_word_width open_checked_word_binary open_slice_access open_slice_range open_shared_projection write_slice_length close_runtime_call write_c_number write_site_number
			open_slice_offset write_slice_items open_array_allocation open_array_drop open_array_borrow))
	(use wove-file "../source/integer_ops.wove" (only is_integer_arithmetic is_checked_integer_operator is_integer_step
		is_integer_division is_integer_remainder))
	(use wove-file "./integers.wove" (only write_integer_bit_count write_integer_arithmetic write_integer_literal write_16bit_wrapping write_i64_wrapping))
	(use wove-file "./integer_checks.wove" (only write_integer_check))
	(use wove-file "../source/integer_checks.wove" (only is_integer_check))
	(use wove-file "../source/types.wove" (only is_16bit_integer is_64bit_integer is_128bit_integer is_256bit_integer is_builtin_integer is_signed_builtin_integer is_signed_integer_value (value i64_type) (value i128_type) (value i256_type) (value f128_type) (value worker_receipt_type) (value worker_queue_type) (value worker_pool_type) (value worker_permit_type)))
	(use wove-file "../source/integer_compare.wove" (only comparison_is_zero comparison_is_negated))
	(use wove-file "./text.wove" (only write_callback_adapter_name c_byte c_span c_literal_text c_text_fragment c_cast c_i32_bias
			write_temporary_name write_local_name write_local_place write_loop_label open_static_value write_static_bytes))
	(use wove-file "./collisions.wove" (only assign_c_names))
	(use wove-file "./callback_names.wove" (only assign_callback_names))
	(use wove-file "./local_names.wove" (only assign_local_c_names defines_break_label))
	(use wove-file "../scalar/generics/functions.wove" (only (type FunctionInstance)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))

	(struct EmitResult
		(fields (written i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(let static_byte_view "(wvrt_slice){")
	(let byte_view_end ",1}")

	(let c_goto "goto ")
	(let c_static_mut_string_assignment "=(char*)")
	(let c_continue "continue;")
	(let c_loop_label_end ":;")

	(let signed_wide_cast "(int64_t)")

	(fn write_scalar
		(:doc `Write one checked leaf as a literal, binding reference, or slice reborrow.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get row kind))
			(if
				(:doc "Read the current value of the original C header expression.")
				(bool.or (u32.eq kind c_value_expression) (u32.eq kind checked_foreign_handle_kind))
				(then
					(let-mut name (struct.get row target))
					(if
						(:doc "A checked handle reserves the target field for its original file.")
						(u32.eq kind checked_foreign_handle_kind)
						(then (set name (struct.get row first))))
					(return (call write_c_value_name (borrow-shared source)
						(array.load nodes name) (borrow-mut output) offset writing))))
			(if
				(:doc "A place loan points to its original local or parameter storage.")
				(u32.eq kind (call place_borrow_kind))
				(then (return (call write_place_borrow (borrow-shared source) (borrow-shared nodes)
					row (borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) tree_base
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A range or indexed loan passes the value already evaluated by its child projection.")
				(bool.or (u32.eq kind fixed_owner_transfer)
					(bool.or (u32.eq kind 45u32) (u32.eq kind indexed_record_loan)))
				(then (return (call write_temporary_name (borrow-shared nodes)
					(struct.get row first) (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A fixed array provides inline storage and its compile-time length.")
				(bool.or (u32.eq kind fixed_shared_loan) (u32.eq kind fixed_mut_loan))
				(then (return (call write_fixed_slice (borrow-shared source) (borrow-shared nodes)
					row tree_base (borrow-shared parameters) (borrow-shared expressions) (borrow-shared records)
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "Read a named view's existing descriptor, projecting its backing pointer if needed.")
				(call is_local_slice_view kind)
				(then
					(let projection (u32.eq kind local_slice_projection))
					(let-mut cursor offset)
					(if
						(:doc "A shared use of a mutable descriptor has no new storage.")
						projection
						(then (set cursor (call open_shared_projection (borrow-mut output) cursor writing))))
					(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
						(struct.get row target) tree_base (borrow-mut output) cursor name_prefix writing))
					(if
						(:doc "Close the shared projection if the source was mutable.")
						projection
						(then (return (call c_byte (borrow-mut output) cursor 41u8 writing))))
					(return cursor)))
			(if
				(:doc "A scoped field lends its captured descriptor at the original record place.")
				(u32.eq kind scoped_field_loan)
				(then (return (call write_field_place (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) (struct.get row projection) tree_base
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "An owned record field borrows the original pointer stored in its slot.")
				(u32.eq kind (call owned_field_loan_kind))
				(then (return (call write_owned_field_loan (borrow-shared source) (borrow-shared nodes) row
					(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) tree_base
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "An array loan projects the owner's pointer without allocating.")
				(struct.get row borrowed_owner)
				(then
					(let open (call open_array_borrow (borrow-mut output) offset
						(u32.eq kind 39u32) writing))
					(let value (call write_local_name (borrow-shared source) (borrow-shared nodes)
						(struct.get row target) tree_base (borrow-mut output) open name_prefix writing))
					(return (call c_byte (borrow-mut output) value 41u8 writing))))
			(if
				(:doc "Use the formal directly for values and whole views, and dereference scalar places.")
				(bool.or (u32.eq kind 2u32) (call is_reborrow_keyword kind))
				(then
					(let parameter (array.load parameters (struct.get row target)))
					(let type (struct.get row type))
					(let projection (bool.and (call is_writable_slice (struct.get parameter type))
						(bool.and (call is_readable_slice type) (bool.not (call is_writable_slice type)))))
					(let-mut cursor offset)
					(if
						(:doc "A shared use of a mutable view projects only the descriptor.")
						projection
						(then (set cursor (call open_shared_projection (borrow-mut output) cursor writing))))
					(set cursor (call write_parameter_place (borrow-shared source) (borrow-shared nodes)
						parameter (struct.get row mutable_place)
						(borrow-mut output) cursor name_prefix writing))
					(if
						(:doc "Finish the shared projection when it was opened.")
						projection
						(then (return (call c_byte (borrow-mut output) cursor 41u8 writing))))
					(return cursor)))
			(if
				(:doc "Read the value at the checked local place.")
				(u32.eq kind 6u32)
				(then (return (call write_local_place (borrow-shared source) (borrow-shared nodes)
					(struct.get row target) tree_base (i32.eq (struct.get row projection) indirect_local_place)
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A module reference uses its defining name even in a rebased file.")
				(u32.eq kind 62u32)
				(then
					(let name (struct.get row target))
					(return (call write_binding_name (borrow-shared source) (borrow-shared nodes)
						name (array.load expressions name) (bool false) (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "An enum constructor is the checked ordinal of its defining variant.")
				(u32.eq kind enum_constructor)
				(then (return (call write_enum_ordinal (struct.get row target)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The checked decimal span contains the original float spelling.")
				(u32.eq kind float_literal)
				(then (return (call write_floating_literal (borrow-shared source) row
					(borrow-mut output) offset writing))))
			(if
				(:doc "The plan represents false and true as distinct literal kinds.")
				(u32.lt 3u32 kind)
				(then
					(let-mut digit 48u8)
					(if
						(:doc "True converts exactly from the integer constant one.")
						(u32.eq kind 5u32)
						(then (set digit 49u8)))
					(return (call c_byte (borrow-mut output) offset digit writing))))
			(return (call write_integer_literal (borrow-shared source) row
				(borrow-mut output) offset writing))))

	(fn is_runtime_operation
		(:doc `Identify the checked operations that use the shared runtime ABI.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body
			(if (bool.or (u32.eq kind buffered_record_borrow_kind) (bool.or (u32.eq kind array_try_copy_kind) (u32.eq kind checked_foreign_handle_kind))) (then (return (bool true))))
			(if
				(:doc "Capture each owner and index before inspecting native byte-tail metadata or bytes.")
				(bool.or (u32.eq kind native_tail_report_borrow_kind)
					(bool.or (u32.eq kind native_tail_report_kind) (u32.eq kind native_tail_load_kind)))
				(then (return (bool true))))
			(if
				(:doc "Native vector operations capture the owner, view, and index once.")
				(bool.or (u32.eq kind native_cstrs_view_kind)
					(bool.or (u32.eq kind native_cstrs_len_kind) (u32.eq kind native_cstrs_load_kind)))
				(then (return (bool true))))
			(if
				(:doc "Optional shared windows and their checks use the captured descriptor.")
				(bool.or (u32.eq kind try_slice_kind)
					(bool.or (bool.or (u32.eq kind optional_view_absent) (u32.eq kind buffered_record_absent))
						(u32.eq kind optional_view_unwrap)))
				(then (return (bool true))))
			(if
				(:doc "Optional construction or allocation captures its operand once.")
				(bool.or (u32.eq kind optional_some) (u32.eq kind array_try_alloc_kind))
				(then (return (bool true))))
			(if
				(:doc "Named conversions and recoverable integer operations capture their operands once.")
				(bool.or (bool.or (bool.or (call is_integer_check kind) (call is_array_growth kind))
					(bool.or (call is_integer_byte_conversion kind) (call is_float_conversion kind)))
					(bool.or (bool.or (call is_owner_take kind)
						(bool.or (u32.eq kind (call owned_field_loan_kind)) (u32.eq kind scoped_field_loan)))
						(bool.or (u32.eq kind c_value_snapshot_expression)
							(bool.or (u32.eq kind (call native_alloc_kind)) (call is_native_owner_write_loan kind)))))
				(then (return (bool true))))
			(if (u32.eq kind indexed_row_owner) (then (return (bool true))))
			(if
				(:doc "Pool and queue operations and fallible or pooled jobs must be captured in source order.")
				(bool.or (bool.or (call is_worker_pool_operation kind) (call is_worker_queue_access kind))
					(bool.or (u32.eq kind worker_spawn_on_kind) (u32.eq kind worker_try_spawn_kind)))
				(then (return (bool true))))
			(if
				(:doc "A bit count uses the exact-width runtime helper even in test-only units.")
				(u32.gtz (call word_bit_count_type kind))
				(then (return (bool true))))
			(return (bool.or
				(bool.or (bool.or (call is_integer_division kind)
					(bool.or (u32.eq kind (call optional_unwrap_kind)) (u32.eq kind borrowed_record_unwrap_kind))) (bool.or (u32.gtz (call word_count_type kind)) (call is_fixed_access kind)))
				(bool.or (bool.or (u32.eq kind (call native_handle_borrow_kind)) (u32.eq kind (call native_handle_consume_kind)))
					(bool.or (u32.eq kind 33u32)
						(bool.or (u32.eq kind 36u32)
							(bool.or (u32.eq kind 37u32)
								(bool.or (u32.eq kind 40u32)
									(bool.or (u32.eq kind 41u32) (u32.eq kind 44u32)))))))))))

	(fn requires_value_temporary
		(:doc `Identify expressions with their own evaluation step when nested in another expression.`)
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (bool.or (u32.eq kind c_value_expression)
					(bool.or (bool.or (bool.or (u32.eq kind conditional_value) (u32.eq kind match_value))
						(u32.eq kind enum_payload_constructor))
						(bool.or (bool.or (call is_direct_call kind) (u32.eq kind (call place_borrow_kind)))
							(bool.or (u32.eq kind fn_ref_kind) (u32.eq kind indirect_call_kind)))))
				(bool.or (bool.or (call is_runtime_operation kind) (u32.eq kind (call owner_is_null_kind)))
					(bool.or (bool.or (u32.eq kind 50u32) (u32.eq kind 52u32))
						(bool.or (call is_fixed_initializer kind)
							(u32.gtz (struct.get (call scalar_operator kind) result)))))))))

	(let i32_wrapped_bits_call "wvrt_i32_from_wrapped_bits(")
	(let negated_comparison "!(")
	(let discard_comparison_operand "((void)")

	(fn write_operator
		(:doc `Write an operator using already evaluated operands of its exact type.

		Signed arithmetic uses a wide signed bias to return to the i32 range.
		Signed masks operate on unsigned bits and reinterpret the result.
		Binary operations on unsigned words keep their declared width.
		An integer predicate can supply typed zero or negate the comparison.`)
		(params (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(operator ScalarOperator)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let symbol (struct.get operator symbol))
			(let result (struct.get operator result))
			(let kind (struct.get expression kind))
			(if
				(:doc "A bit count reads the eager operand temporary and produces an i32.")
				(u32.gtz (call word_bit_count_type kind))
				(then (return (call write_integer_bit_count (borrow-shared nodes)
					(struct.get expression first) (struct.get operator operand) symbol (borrow-mut output) offset name_prefix writing))))
			(let trapping (call is_checked_integer_operator kind))
			(let exact_wrapping (bool.or (bool.or (call is_128bit_integer result) (call is_256bit_integer result))
				(bool.or (u32.eq result 10u32) (u32.eq result 61u32))))
			(if
				(:doc "Use exact-result helpers for checked arithmetic, unary steps, and wrapping bytes or wide integers.")
				(bool.or (call is_integer_step kind)
					(bool.or trapping (bool.and exact_wrapping (call is_integer_arithmetic kind))))
				(then (return (call write_integer_arithmetic (borrow-shared nodes)
					expression symbol trapping
					(borrow-mut output) offset name_prefix writing))))
			(let signed (u32.eq result 5u32))
			(let signed_mask (bool.and signed (u32.gtz (call word_mask_type kind))))
			(let signed_wrap (bool.and signed (bool.not signed_mask)))
			(let unsigned_word (u32.eq result 11u32))
			(let first (struct.get expression first))
			(let zero (call comparison_is_zero kind))
			(let negate (call comparison_is_negated kind))
			(if
				(:doc "Emit the single checked operand after its negation or complement operator.")
				(bool.and (bool.not zero) (i32.eq (struct.get operator arity) 1i32))
				(then
					(let cursor (call c_byte (borrow-mut output) offset symbol writing))
					(return (call write_temporary_name (borrow-shared nodes) first
						(borrow-mut output) cursor name_prefix writing))))
			(let operand_type (struct.get operator operand))
			(if
				(:doc "Use the already evaluated value even when unsigned ordering has a constant result.")
				(bool.and zero (bool.and (bool.not (call is_signed_integer_value operand_type))
					(bool.or (u8.eq symbol 60u8) (u8.eq symbol 71u8))))
				(then
					(let-mut truth (u8.eq symbol 71u8))
					(if negate (then (set truth (bool.not truth))))
					(let-mut digit 48u8)
					(if truth (then (set digit 49u8)))
					(let-mut cursor (call c_literal_text (borrow-shared discard_comparison_operand)
						(borrow-mut output) offset writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) first
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor digit writing))
					(return (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(let second (struct.get (array.load nodes first) next_sibling))
			(if
				(:doc "Wrap i64 arithmetic in uint64_t before reinterpreting the result bits.")
				(u32.eq result i64_type)
				(then (return (call write_i64_wrapping (borrow-shared nodes) first second symbol (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "Use unsigned arithmetic before narrowing back to the requested 16-bit type.")
				(bool.and (call is_16bit_integer result) (call is_integer_arithmetic kind))
				(then (return (call write_16bit_wrapping (borrow-shared nodes) first second
					symbol (call is_signed_builtin_integer result)
					(borrow-mut output) offset name_prefix writing))))
			(let-mut cursor offset)
			(if
				(:doc "Negate the result of the ordinary comparison after evaluating its operands.")
				negate
				(then (set cursor (call c_literal_text (borrow-shared negated_comparison)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "Open both casts and widen the arithmetic with the signed bias.")
				signed_wrap
				(then
					(set cursor (call c_cast (borrow-mut output) cursor 5u32 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
					(set cursor (call c_cast (borrow-mut output) cursor 11u32 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
					(set cursor (call c_i32_bias (borrow-mut output) cursor writing))
					(set cursor (call c_byte (borrow-mut output) cursor 43u8 writing))
					(if
						(:doc "Widen the multiply before applying the signed bias to its product.")
						(u8.eq symbol 42u8)
						(then (set cursor (call c_span (borrow-shared signed_wide_cast)
							0i32 (array.len signed_wide_cast)
							(borrow-mut output) cursor writing))))))
			(if
				(:doc "Widen the left operand before C applies integer promotions to the operation.")
				unsigned_word
				(then
					(set cursor (call c_cast (borrow-mut output) cursor 11u32 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
					(set cursor (call c_cast (borrow-mut output) cursor 54u32 writing))))
			(if
				(:doc "Convert both operands to their unsigned representation before masking.")
				signed_mask
				(then
					(set cursor (call c_literal_text (borrow-shared i32_wrapped_bits_call)
						(borrow-mut output) cursor writing))
					(set cursor (call c_cast (borrow-mut output) cursor 11u32 writing))))
			(set cursor (call write_temporary_name (borrow-shared nodes) first
				(borrow-mut output) cursor name_prefix writing))
			(let-mut operator_byte symbol)
			(if (u8.eq symbol 76u8) (then (set operator_byte 60u8)))
			(if (u8.eq symbol 71u8) (then (set operator_byte 62u8)))
			(set cursor (call c_byte (borrow-mut output) cursor operator_byte writing))
			(if
				(:doc "Equality, inequality, and inclusive comparisons all end in an equals byte.")
				(bool.or (u8.not-eq operator_byte symbol)
					(bool.or (u8.eq symbol 61u8) (u8.eq symbol 33u8)))
				(then (set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))))
			(if signed_mask (then (set cursor (call c_cast (borrow-mut output) cursor 11u32 writing))))
			(if
				(:doc "Use a zero of the operand type in place of an explicit second temporary.")
				zero
				(then
					(set cursor (call c_cast (borrow-mut output) cursor operand_type writing))
					(set cursor (call c_byte (borrow-mut output) cursor 48u8 writing)))
				(else
					(set cursor (call write_temporary_name (borrow-shared nodes) second
						(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Reduce to uint32_t before subtracting the signed bias.")
				signed_wrap
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 45u8 writing))
					(set cursor (call c_i32_bias (borrow-mut output) cursor writing))
					(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(if
				(:doc "Close the unsigned reduction, signed bit reinterpretation, or negation.")
				(bool.or negate (bool.or unsigned_word signed_mask))
				(then (return (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(return cursor)))

	(fn write_checked_word_binary
		(:doc `Pass the captured operands and original span to checked division or a signed word shift.`)
		(params (nodes (shared-array SourceNode)) (expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let left (struct.get expression first))
			(let right (struct.get (array.load nodes left) next_sibling))
			(let kind (struct.get expression kind))
			(let type (struct.get expression type))
			(let division (call is_integer_division kind))
			(let open (call open_checked_word_binary (borrow-mut output) offset
				division type writing))
			(let first (call write_temporary_name (borrow-shared nodes) left
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) first 44u8 writing))
			(let second (call write_temporary_name (borrow-shared nodes) right
				(borrow-mut output) comma name_prefix writing))
			(let flag_start (call c_byte (borrow-mut output) second 44u8 writing))
			(let-mut flag 48u8)
			(if
				(:doc "The alternate operation is remainder or arithmetic shift right.")
				(bool.or (call is_integer_remainder kind)
					(bool.and (bool.not division) (call word_moves_right kind)))
				(then (set flag 49u8)))
			(let-mut end (call c_byte (borrow-mut output) flag_start flag writing))
			(if
				(:doc "A generic signed shift also receives the declared word width.")
				(bool.and (bool.not division) (bool.and (u32.not-eq type 5u32)
					(bool.not (bool.or (call is_128bit_integer type) (call is_256bit_integer type)))))
				(then (set end (call write_word_width
					(borrow-mut output) end type writing))))
			(return (call close_runtime_call (borrow-mut output) end
				(struct.get expression target) (struct.get expression start)
				(struct.get expression end) writing))))

	(fn write_word_rotation
		(:doc "Rotate the captured word and report an invalid count at its original operand span.")
		(params (nodes (shared-array SourceNode)) (expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let word (struct.get expression first))
			(let count (struct.get (array.load nodes word) next_sibling))
			(let type (struct.get expression type))
			(let right (call word_moves_right (struct.get expression kind)))
			(let direct (bool.and (u32.eq type 54u32) right))
			(let open (call open_word_rotate (borrow-mut output) offset type direct writing))
			(let value (call write_temporary_name (borrow-shared nodes) word
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) value 44u8 writing))
			(let-mut end (call write_temporary_name (borrow-shared nodes) count
				(borrow-mut output) comma name_prefix writing))
			(if
				(:doc "The generic runtime entries take the direction and the original type width.")
				(bool.not direct)
				(then
					(let direction (call c_byte (borrow-mut output) end 44u8 writing))
					(let-mut flag 48u8)
					(if right (then (set flag 49u8)))
					(set end (call c_byte (borrow-mut output) direction flag writing))
					(if
						(:doc "Only the shared narrow runtime helpers need an explicit width.")
						(bool.not (bool.or (call is_128bit_integer type) (call is_256bit_integer type)))
						(then (set end (call write_word_width
							(borrow-mut output) end type writing))))))
			(return (call close_runtime_call (borrow-mut output) end
				(struct.get expression target) (struct.get expression start)
				(struct.get expression end) writing))))

	(fn write_counted_word
		(:doc "Shift or rotate the evaluated word using the checked count and its source span.")
		(params (nodes (shared-array SourceNode)) (expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get expression kind))
			(if
				(:doc "A rotation uses exact-width bits in either direction.")
				(call word_rotates kind)
				(then (return (call write_word_rotation (borrow-shared nodes)
					expression (borrow-mut output) offset name_prefix writing))))
			(let type (struct.get expression type))
			(if
				(:doc "Signed and full-width shifts use the runtime's checked bit operations.")
				(bool.or (call is_signed_builtin_integer type)
					(bool.or (call is_128bit_integer type) (call is_256bit_integer type)))
				(then (return (call write_checked_word_binary (borrow-shared nodes)
					expression (borrow-mut output) offset name_prefix writing))))
			(let word (struct.get expression first))
			(let count (struct.get (array.load nodes word) next_sibling))
			(let-mut symbol 60u8)
			(if
				(:doc "A logical right shift uses the unsigned left operand with C's right shift.")
				(call word_moves_right kind)
				(then (set symbol 62u8)))
			(let narrow (call c_cast (borrow-mut output) offset type writing))
			(let open (call c_byte (borrow-mut output) narrow 40u8 writing))
			(let wide (call c_cast (borrow-mut output) open 54u32 writing))
			(let value (call write_temporary_name (borrow-shared nodes) word
				(borrow-mut output) wide name_prefix writing))
			(let operator (call c_byte (borrow-mut output) value symbol writing))
			(let after_operator (call c_byte (borrow-mut output) operator symbol writing))
			(let check (call open_word_shift_count (borrow-mut output) after_operator type writing))
			(let-mut count_end (call write_temporary_name (borrow-shared nodes) count
				(borrow-mut output) check name_prefix writing))
			(if
				(:doc "Narrow unsigned counts are checked at the declared width before the widened C shift.")
				(bool.and (u32.not-eq type 11u32) (u32.not-eq type 54u32))
				(then (set count_end (call write_word_width
					(borrow-mut output) count_end type writing))))
			(let end (call close_runtime_call (borrow-mut output) count_end
				(struct.get expression target) (struct.get expression start)
				(struct.get expression end) writing))
			(return (call c_byte (borrow-mut output) end 41u8 writing))))

	(let row_load_open "wvrt_array_borrow_row_at_span(")
	(let row_store_open "wvrt_array_store_row_at_span(")
	(let rows_alloc_open "wvrt_array_new_rows_at_span(")
	(let owned_alloc_open "wvrt_owned_array_new(")
	(let owned_load_open "wvrt_owned_array_borrow(")
	(let owned_mut_open "wvrt_owned_array_borrow_mut(")
	(let owned_store_open "wvrt_owned_array_store(")
	(let owned_take_open "wvrt_owned_array_take(")

	(fn open_owned_access
		(:doc "Choose replacement or the required borrow permission for a wrapped slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (expression ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A replacement supplies a detached owner to the existing slot.")
				(u32.eq (struct.get expression kind) 40u32)
				(then (return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared owned_store_open) (borrow-mut output)
					offset name_prefix writing))))
			(if
				(:doc "A direct heap take transfers the checked slot and clears its occupancy.")
				(u32.eq (struct.get expression kind) fixed_owner_take)
				(then (return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared owned_take_open) (borrow-mut output)
					offset name_prefix writing))))
			(if
				(:doc "Exclusive views lend the checked mutable place directly.")
				(call is_mutable_place_reference (struct.get expression type))
				(then (return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared owned_mut_open) (borrow-mut output)
					offset name_prefix writing))))
			(return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
				layout (borrow-shared owned_load_open) (borrow-mut output)
				offset name_prefix writing))))

	(fn write_slice_access
		(:doc `Read an inline or borrowed extent, or pass the evaluated operands and original access span to the runtime.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let receiver (struct.get expression first))
			(let kind (struct.get expression kind))
			(let array (array.load expressions receiver))
			(let type (struct.get array type))
			(if
				(:doc "Length reads the signed field from the evaluated descriptor.")
				(u32.eq kind 36u32)
				(then
					(if
						(:doc "Fixed arrays use the layout extent, including zero-length layouts.")
						(call is_record_type (call record_receiver_type type))
						(then (return (call write_fixed_length (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
							(borrow-shared expressions) array receiver
							(borrow-mut output) offset name_prefix writing))))
					(let cursor (call write_temporary_name (borrow-shared nodes) receiver
						(borrow-mut output) offset name_prefix writing))
					(return (call write_slice_length (borrow-mut output) cursor writing))))
			(let element (call slice_element_type (borrow-shared records) type))
			(let row (call is_array_owner element))
			(let owning (call is_owning_array_element (borrow-shared records) element))
			(let typed (call is_typed_slice type))
			(let range (u32.eq kind 44u32))
			(if
				(:doc "A typed element access indexes its backing array after the checked subscript.")
				(bool.and typed (bool.not (bool.or owning (bool.or row range))))
				(then (return (call write_typed_slice_access (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) expression element
					(borrow-mut output) offset name_prefix writing))))
			(let index (struct.get (array.load nodes receiver) next_sibling))
			(let-mut open offset)
			(if
				(:doc "A range narrows the descriptor while retaining element size and access.")
				range
				(then (set open (call open_slice_range (borrow-mut output) offset
					typed (call is_writable_slice type) writing)))
				(else
					(if
						(:doc "Owning rows need a checked borrow or replacement with cleanup.")
						row
						(then
							(if
								(:doc "A row store retires the prior allocation. A row load borrows its storage.")
								(u32.eq kind 40u32)
								(then (set open (call c_literal_text (borrow-shared row_store_open)
									(borrow-mut output) offset writing)))
								(else (set open (call c_literal_text (borrow-shared row_load_open)
									(borrow-mut output) offset writing)))))
						(else
							(if
								(:doc "Wrapped aggregates use the occupancy-aware operation for their checked slot.")
								owning
								(then (set open (call open_owned_access (borrow-shared source) (borrow-shared nodes)
									(array.load records (call record_index element)) expression
									(borrow-mut output) offset name_prefix writing)))
								(else (set open (call open_slice_access (borrow-mut output)
									offset kind writing))))))))
			(let view (call write_temporary_name (borrow-shared nodes) receiver
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) view 44u8 writing))
			(let-mut cursor (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) comma name_prefix writing))
			(if
				(:doc "Pass the store value or range end after the already evaluated index or start.")
				(bool.or (u32.eq kind 40u32) range)
				(then
					(let third (struct.get (array.load nodes index) next_sibling))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) third
						(borrow-mut output) cursor name_prefix writing))))
			(return (call close_runtime_call (borrow-mut output) cursor
				(struct.get expression target) (struct.get expression start)
				(struct.get expression end) writing))))

	(fn write_typed_slice_access
		(:doc `Read or replace one element in the original storage after checking the index.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (element u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let receiver (struct.get expression first))
			(let index (struct.get (array.load nodes receiver) next_sibling))
			(let store (u32.eq (struct.get expression kind) 40u32))
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(if
				(:doc "Read through a const element pointer. A store uses the checked writable pointer.")
				(bool.not store)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) element
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) receiver
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_slice_items (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 91u8 writing))
			(set cursor (call open_slice_offset (borrow-mut output) cursor writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) receiver
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_slice_length (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call close_runtime_call (borrow-mut output) cursor
				(struct.get expression target) (struct.get expression start)
				(struct.get expression end) writing))
			(set cursor (call c_byte (borrow-mut output) cursor 93u8 writing))
			(if
				(:doc "Assign the single evaluated value to the checked element.")
				store
				(then
					(let value (struct.get (array.load nodes index) next_sibling))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) value
						(borrow-mut output) cursor name_prefix writing))))
			(return cursor)))

	(fn write_record_make
		(:doc `Construct a record from already evaluated fields and let C zero omitted native members.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (expression ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut output) offset 40u8 writing))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (struct.get expression type)
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(let layout (array.load records (struct.get expression target)))
			(let native (call is_native_record layout))
			(let first (struct.get expression first))
			(let-mut field first)
			(if
				(:doc "Zero-initialize a native out record or the placeholder member of an empty Wove record.")
				(i32.ltz first)
				(then (set cursor (call c_byte (borrow-mut output) cursor 48u8 writing))))
			(while
				(:doc "Use a designator for each field so source order can differ from layout order.")
				(i32.not-ltz field)
				(body
					(if
						(:doc "Commas separate adjacent initializer designators.")
						(i32.not-eq field first)
						(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
					(let row (array.load expressions field))
					(let initializer (array.load nodes field))
					(set cursor (call c_byte (borrow-mut output) cursor 46u8 writing))
					(if
						(:doc "A checked native field name matches the original C member spelling.")
						native
						(then
							(let name (array.load nodes (struct.get initializer first_child)))
							(set cursor (call c_span (borrow-shared source) (struct.get name start)
								(struct.get name end) (borrow-mut output) cursor writing)))
						(else
							(let name (array.load nodes (struct.get initializer first_child)))
							(let member (call named_member (borrow-shared source) layout name))
							(set cursor (call write_member (borrow-shared source) member
								(borrow-mut output) cursor name_prefix writing))))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) (struct.get row first) (borrow-mut output) cursor name_prefix writing))
					(set field (struct.get initializer next_sibling))))
			(return (call c_byte (borrow-mut output) cursor 125u8 writing))))

	(let try_allocation_open "wvrt_array_try_new(")

	(fn write_array_allocation
		(:doc `Allocate one zeroed array with the evaluated count and defining element layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let recoverable (u32.eq (struct.get expression kind) array_try_alloc_kind))
			(let-mut type (struct.get expression type))
			(if
				(:doc "The optional code still identifies the exact allocated element.")
				recoverable
				(then (set type (call optional_owner_payload type))))
