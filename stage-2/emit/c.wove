	(use wove-file "./c_formals.wove" (only fixed_c_needs_prototype cross_header_owner_needs_prototype write_fixed_c_checks))
	(use wove-file "../scalar/flow.wove" (only after_block is_loop is_loop_exit (value break_statement) (value for_statement) (value for_source_owner) (value for_element_assignment) (type ScalarStatement) (value c_value_expression) (value c_vector_snapshot_expression) (value c_value_assignment)
			(value fixed_shared_loan) (value fixed_mut_loan) (value field_assignment) (value parameter_assignment) (value owner_assignment) (value owner_field_assignment)))
	(use wove-file "../scalar/loans.wove" (only is_local_slice_view indexed_growth_receiver (value indirect_local_place) (value local_slice_projection) (value scoped_field_loan) (value indexed_record_loan) (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only read_module_declarations plan_bodies (type CallSite)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/syntax.wove" (only is_direct_call (value array_try_copy_kind) (value borrowed_record_unwrap_kind) (value fn_ref_kind) (value indirect_call_kind) is_worker_launch is_worker_collect is_worker_pool_operation
		(value worker_spawn_kind) (value worker_spawn_on_kind) (value worker_open_pool_kind)
		(value worker_try_reserve_kind) (value worker_reserve_wait_kind) (value worker_join_kind) (value worker_queue_kind) (value worker_push_kind) scalar_operator is_reborrow_keyword is_fixed_access is_fixed_initializer (value fixed_subarray_place) (value fixed_owner_take) (value fixed_owner_transfer) (value fixed_owner_borrow) (value fixed_owner_store) native_alloc_kind native_empty_kind (type ScalarOperator)))
	(use wove-file "../source/integer_bits.wove" (only word_count_type word_bit_count_type word_rotates word_moves_right word_mask_type))
	(use wove-file "./runtime.wove"
		(only write_runtime_header open_host_entry open_conversion open_word_shift_count open_word_rotate write_word_width open_checked_word_binary open_slice_access open_slice_range open_shared_projection write_slice_length close_runtime_call write_c_number write_site_number
			open_slice_offset write_slice_items open_array_allocation open_array_copy open_array_drop open_array_borrow))
	(use wove-file "../source/integer_ops.wove" (only is_integer_arithmetic is_checked_integer_operator is_integer_step
		is_integer_division is_integer_remainder))
	(use wove-file "./integers.wove" (only write_integer_bit_count write_integer_arithmetic write_integer_literal write_16bit_wrapping write_i64_wrapping))
	(use wove-file "./integer_checks.wove" (only write_integer_check))
	(use wove-file "../source/integer_checks.wove" (only is_integer_check))
	(use wove-file "../source/types.wove" (only is_16bit_integer is_64bit_integer is_128bit_integer is_builtin_integer is_signed_builtin_integer (value i64_type) (value i128_type) (value f128_type) (value worker_receipt_type) (value worker_queue_type) (value worker_pool_type) (value worker_permit_type)))
	(use wove-file "../source/integer_compare.wove" (only comparison_is_zero comparison_is_negated))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text c_text_fragment c_cast c_i32_bias
			write_temporary_name write_local_name write_local_place write_loop_label open_static_value write_static_bytes))
	(use wove-file "./collisions.wove" (only assign_c_names))
	(use wove-file "../scalar/generics/functions.wove" (only (type FunctionInstance)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))

	(struct EmitResult
		(fields (written i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(let c_goto "goto ")
	(let c_continue "continue;")
	(let c_loop_label_end ":;")

	(let signed_wide_cast "(int64_t)")

	(fn write_scalar
		(:doc `Write one checked leaf as a literal, binding reference, or slice reborrow.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get (local row) kind))
			(if
				(:doc "Read the current value of the original C header expression.")
				(u32.eq (local kind) (local c_value_expression))
				(then (return (call write_c_value_name (borrow-shared (local source))
					(array.load (local nodes) (struct.get (local row) target))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "A place loan points to its original local or parameter storage.")
				(u32.eq (local kind) (call place_borrow_kind))
				(then (return (call write_place_borrow (borrow-shared (local source)) (borrow-shared (local nodes))
					(local row) (borrow-shared (local parameters)) (borrow-shared (local expressions)) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A range or indexed loan passes the value already evaluated by its child projection.")
				(bool.or (u32.eq (local kind) (local fixed_owner_transfer))
					(bool.or (u32.eq (local kind) 45u32) (u32.eq (local kind) (local indexed_record_loan))))
				(then (return (call write_temporary_name (borrow-shared (local source))
					(struct.get (local row) first) (local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A fixed array provides inline storage and its compile-time length.")
				(bool.or (u32.eq (local kind) (local fixed_shared_loan)) (u32.eq (local kind) (local fixed_mut_loan)))
				(then (return (call write_fixed_slice (borrow-shared (local source)) (borrow-shared (local nodes))
					(local row) (local tree_base) (borrow-shared (local parameters)) (borrow-shared (local expressions))
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "Read a named view's existing descriptor, projecting its backing pointer if needed.")
				(call is_local_slice_view (local kind))
				(then
					(let projection (u32.eq (local kind) (local local_slice_projection)))
					(let-mut cursor (local offset))
					(if
						(:doc "A shared use of a mutable descriptor has no new storage.")
						(local projection)
						(then (set (local cursor) (call open_shared_projection (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local row) target) (local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(if
						(:doc "Close the shared projection if the source was mutable.")
						(local projection)
						(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
					(return (local cursor))))
			(if
				(:doc "A scoped field lends its captured descriptor at the original record place.")
				(u32.eq (local kind) (local scoped_field_loan))
				(then (return (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local expressions)) (borrow-shared (local parameters)) (struct.get (local row) projection) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "An owned record field borrows the original pointer stored in its slot.")
				(u32.eq (local kind) (call owned_field_loan_kind))
				(then (return (call write_owned_field_loan (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)
					(borrow-shared (local parameters)) (borrow-shared (local expressions)) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "An array loan projects the owner's pointer without allocating.")
				(struct.get (local row) borrowed_owner)
				(then
					(let open (call open_array_borrow (borrow-mut (local output)) (local offset)
						(u32.eq (local kind) 39u32) (local writing)))
					(let value (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local row) target) (local tree_base) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local value) 41u8 (local writing)))))
			(if
				(:doc "Use the formal directly for values and whole views, and dereference scalar places.")
				(bool.or (u32.eq (local kind) 2u32) (call is_reborrow_keyword (local kind)))
				(then
					(let parameter (array.load (local parameters) (struct.get (local row) target)))
					(let type (struct.get (local row) type))
					(let projection (bool.and (call is_writable_slice (struct.get (local parameter) type))
						(bool.and (call is_readable_slice (local type)) (bool.not (call is_writable_slice (local type))))))
					(let-mut cursor (local offset))
					(if
						(:doc "A shared use of a mutable view projects only the descriptor.")
						(local projection)
						(then (set (local cursor) (call open_shared_projection (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local cursor) (call write_parameter_place (borrow-shared (local source)) (borrow-shared (local nodes))
						(local parameter) (struct.get (local row) mutable_place)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(if
						(:doc "Finish the shared projection when it was opened.")
						(local projection)
						(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
					(return (local cursor))))
			(if
				(:doc "Read the value at the checked local place.")
				(u32.eq (local kind) 6u32)
				(then (return (call write_local_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local row) target) (local tree_base) (i32.eq (struct.get (local row) projection) (local indirect_local_place))
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A module reference uses its defining name even in a rebased file.")
				(u32.eq (local kind) 62u32)
				(then (return (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local row) target) (bool false) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "An enum constructor is the checked ordinal of its defining variant.")
				(u32.eq (local kind) (local enum_constructor))
				(then (return (call write_enum_ordinal (struct.get (local row) target)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The checked decimal span contains the original float spelling.")
				(u32.eq (local kind) (local float_literal))
				(then (return (call write_floating_literal (borrow-shared (local source)) (local row)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The plan represents false and true as distinct literal kinds.")
				(u32.lt 3u32 (local kind))
				(then
					(let-mut digit 48u8)
					(if
						(:doc "True converts exactly from the integer constant one.")
						(u32.eq (local kind) 5u32)
						(then (set (local digit) 49u8)))
					(return (call c_byte (borrow-mut (local output)) (local offset) (local digit) (local writing)))))
			(return (call write_integer_literal (borrow-shared (local source)) (local row)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn is_runtime_operation
		(:doc `Identify the checked operations that use the shared runtime ABI.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body
			(if (u32.eq (local kind) (local array_try_copy_kind)) (then (return (bool true))))
			(if
				(:doc "Optional shared windows and their checks use the captured descriptor.")
				(bool.or (u32.eq (local kind) (local try_slice_kind))
					(bool.or (u32.eq (local kind) (local optional_view_absent)) (u32.eq (local kind) (local optional_view_unwrap))))
				(then (return (bool true))))
			(if
				(:doc "Optional construction or allocation captures its operand once.")
				(bool.or (u32.eq (local kind) (local optional_some)) (u32.eq (local kind) (local array_try_alloc_kind)))
				(then (return (bool true))))
			(if
				(:doc "Named conversions and recoverable integer operations capture their operands once.")
				(bool.or (bool.or (bool.or (call is_integer_check (local kind)) (call is_array_growth (local kind)))
					(bool.or (call is_integer_byte_conversion (local kind)) (call is_float_conversion (local kind))))
					(bool.or (bool.or (call is_owner_take (local kind))
						(bool.or (u32.eq (local kind) (call owned_field_loan_kind)) (u32.eq (local kind) (local scoped_field_loan))))
						(bool.or (u32.eq (local kind) (local c_vector_snapshot_expression))
							(bool.or (u32.eq (local kind) (call native_alloc_kind)) (call is_native_owner_write_loan (local kind))))))
				(then (return (bool true))))
			(if (u32.eq (local kind) (local indexed_row_owner)) (then (return (bool true))))
			(if
				(:doc "Pool operations and pooled argument transfers must evaluate in source order.")
				(bool.or (call is_worker_pool_operation (local kind)) (u32.eq (local kind) (local worker_spawn_on_kind)))
				(then (return (bool true))))
			(if
				(:doc "A bit count uses the exact-width runtime helper even in test-only units.")
				(u32.gtz (call word_bit_count_type (local kind)))
				(then (return (bool true))))
			(return (bool.or
				(bool.or (bool.or (call is_integer_division (local kind))
					(bool.or (u32.eq (local kind) (call optional_unwrap_kind)) (u32.eq (local kind) (local borrowed_record_unwrap_kind)))) (bool.or (u32.gtz (call word_count_type (local kind))) (call is_fixed_access (local kind))))
				(bool.or (bool.or (u32.eq (local kind) (call native_handle_borrow_kind)) (u32.eq (local kind) (call native_handle_consume_kind)))
					(bool.or (u32.eq (local kind) 33u32)
						(bool.or (u32.eq (local kind) 36u32)
							(bool.or (u32.eq (local kind) 37u32)
								(bool.or (u32.eq (local kind) 40u32)
									(bool.or (u32.eq (local kind) 41u32) (bool.or (u32.eq (local kind) 44u32) (u32.eq (local kind) 60u32))))))))))))

	(fn requires_value_temporary
		(:doc `Identify expressions with their own evaluation step when nested in another expression.`)
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (bool.or (u32.eq (local kind) (local c_value_expression))
					(bool.or (bool.or (bool.or (u32.eq (local kind) (local conditional_value)) (u32.eq (local kind) (local match_value)))
						(u32.eq (local kind) (local enum_payload_constructor)))
						(bool.or (bool.or (call is_direct_call (local kind)) (u32.eq (local kind) (call place_borrow_kind)))
							(bool.or (u32.eq (local kind) (local fn_ref_kind)) (u32.eq (local kind) (local indirect_call_kind))))))
				(bool.or (bool.or (call is_runtime_operation (local kind)) (u32.eq (local kind) (call owner_is_null_kind)))
					(bool.or (bool.or (u32.eq (local kind) 50u32) (u32.eq (local kind) 52u32))
						(bool.or (call is_fixed_initializer (local kind))
							(u32.gtz (struct.get (call scalar_operator (local kind)) result)))))))))

	(let i32_wrapped_bits_call "wvrt_i32_from_wrapped_bits(")
	(let negated_comparison "!(")
	(let discard_comparison_operand "((void)")

	(fn write_operator
		(:doc `Write an operator using already evaluated operands of its exact type.

		Signed arithmetic uses a wide signed bias to return to the i32 range.
		Signed masks operate on unsigned bits and reinterpret the result.
		Binary operations on unsigned words keep their declared width.
		An integer predicate can supply typed zero or negate the comparison.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(operator ScalarOperator) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let symbol (struct.get (local operator) symbol))
			(let result (struct.get (local operator) result))
			(let kind (struct.get (local expression) kind))
			(if
				(:doc "A bit count reads the eager operand temporary and produces an i32.")
				(u32.gtz (call word_bit_count_type (local kind)))
				(then (return (call write_integer_bit_count (borrow-shared (local source))
					(struct.get (local expression) first) (struct.get (local operator) operand) (local symbol)
					(local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let trapping (call is_checked_integer_operator (local kind)))
			(let exact_wrapping (bool.or (call is_128bit_integer (local result))
				(bool.or (u32.eq (local result) 10u32) (u32.eq (local result) 61u32))))
			(if
				(:doc "The exact-result builtin handles checked arithmetic, unary steps, and wrapping for bytes and 128-bit integers.")
				(bool.or (call is_integer_step (local kind))
					(bool.or (local trapping) (bool.and (local exact_wrapping) (call is_integer_arithmetic (local kind)))))
				(then (return (call write_integer_arithmetic (borrow-shared (local source)) (borrow-shared (local nodes))
					(local expression) (local symbol) (local trapping) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let signed (u32.eq (local result) 5u32))
			(let signed_mask (bool.and (local signed) (u32.gtz (call word_mask_type (local kind)))))
			(let signed_wrap (bool.and (local signed) (bool.not (local signed_mask))))
			(let unsigned_word (u32.eq (local result) 11u32))
			(let first (struct.get (local expression) first))
			(let zero (call comparison_is_zero (local kind)))
			(let negate (call comparison_is_negated (local kind)))
			(if
				(:doc "Emit the single checked operand after its negation or complement operator.")
				(bool.and (bool.not (local zero)) (i32.eq (struct.get (local operator) arity) 1i32))
				(then
					(let cursor (call c_byte (borrow-mut (local output)) (local offset) (local symbol) (local writing)))
					(return (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(let operand_type (struct.get (local operator) operand))
			(if
