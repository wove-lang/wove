			(return (bool false))))

	(fn write_translation_unit
		(:doc `Measure or write the same complete translation unit using the resolved plan.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (has_stdint bool) (has_runtime bool) (private_helpers bool) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let count (array.len (local functions)))
			(let has_records (bool.and (i32.lt 0i32 (array.len (local records)))
				(bool.not (i32.eq (struct.get (array.load (local records) 0i32) name) 0i32))))
			(if
				(:doc "The shared runtime header provides the fixed-width types too.")
				(call uses_runtime (borrow-shared (local expressions)) (borrow-shared (local parameters)))
				(then
					(if
						(:doc "A selected bridge include can already provide the runtime header.")
						(bool.not (local has_runtime))
						(then (set (local cursor) (call write_runtime_header (borrow-mut (local output)) (local cursor) (local writing))))))
				(else
					(if
						(:doc "Use a fixed-width header if the selected program needs it and no header already supplies it.")
						(bool.and (bool.not (local has_stdint))
							(bool.or (bool.or (local has_records) (call has_c_values (borrow-shared (local statements))))
								(i32.lt 0i32 (local count))))
						(then (set (local cursor)
							(call c_text_fragment (borrow-mut (local output)) (local cursor) 0u32 (local writing)))))))
			(set (local cursor) (call write_record_layouts (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call write_module_bindings (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local statements)) (borrow-shared (local expressions)) (borrow-shared (local records))
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(let-mut index 0i32)
			(while
				(:doc "Forward-declare local helpers before emitting the bodies in source order.")
				(i32.lt (local index) (local count))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "Local helpers need a prototype. The entry and bridge declarations have their own ABI.")
						(bool.and (bool.not (struct.get (local function) entry))
							(bool.not (i32.lt (struct.get (local function) body) 0i32)))
						(then
							(set (local cursor) (call write_signature (borrow-shared (local source)) (borrow-shared (local nodes))
								(local function) (borrow-shared (local parameters)) (borrow-shared (local records)) (bool true) (local private_helpers)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))))
					(if
						(:doc "Check fixed header constants once for the selected native declaration.")
						(struct.get (local function) c_fixed)
						(then (set (local cursor) (call write_fixed_c_checks (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (struct.get (local function) c_formals)
							(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
					(if
						(:doc "Clang verifies named variadic contracts against the original header declaration.")
						(i32.lt 0i32 (struct.get (local function) c_variadic))
						(then (set (local cursor) (call write_c_variadic_check (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (borrow-shared (local parameters)) (local function)
							(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(set (local index) 0i32)
			(while
				(:doc "Every selected declaration receives one definition with the verified signature.")
				(i32.lt (local index) (local count))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "Only Wove definitions have a body to write in this translation unit.")
						(bool.not (i32.lt (struct.get (local function) body) 0i32))
						(then
							(set (local cursor) (call write_definition (borrow-shared (local source)) (borrow-shared (local nodes))
								(local function) (borrow-shared (local functions))
								(borrow-shared (local parameters)) (borrow-shared (local statements))
								(borrow-shared (local records)) (borrow-shared (local expressions))
								(borrow-mut (local output)) (local cursor) (local private_helpers) (local name_prefix) (local writing)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (local cursor))))

	(fn emit_result
		(:doc `Return a count and originating byte span from C emission.`)
		(params (written i32) (start i32) (end i32) (error u32))
		(returns EmitResult)
		(body
			(return (struct.new EmitResult (written (local written)) (error (local error))
				(start (local start)) (end (local end)) (related_start -1i32) (related_end -1i32)))))

	(fn emit_module
		(:doc `Check, measure, and emit the selected scalar program into the supplied output view.

		Keep source diagnostics intact and check the entire translation unit's
		capacity before writing. Failure leaves the destination untouched.
		In collect mode, return checked embed requests for the caller's loader
		instead of C. Otherwise the source arena includes any bound asset bytes.`)
		(:expect
			(tests "stage-2/source_compilations.tsv")
			(issues
				"gh:wove-lang/wove:67" "gh:wove-lang/wove:69" "gh:wove-lang/wove:72"
				"gh:wove-lang/wove:73" "gh:wove-lang/wove:74" "gh:wove-lang/wove:75"
				"gh:wove-lang/wove:77" "gh:wove-lang/wove:79" "gh:wove-lang/wove:83"
				"gh:wove-lang/wove:85" "gh:wove-lang/wove:90" "gh:wove-lang/wove:104"
				"gh:wove-lang/wove:107" "gh:wove-lang/wove:110" "gh:wove-lang/wove:113"
				"gh:wove-lang/wove:115" "gh:wove-lang/wove:125" "gh:wove-lang/wove:127"
				"gh:wove-lang/wove:130" "gh:wove-lang/wove:133" "gh:wove-lang/wove:134"
				"gh:wove-lang/wove:159"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (file i32) (view_start i32)
			(assets (mut-array EmbedAsset)) (collect bool) (output (mut-array u8)))
		(returns EmitResult)
		(body
			(let start (struct.get (local module) start))
			(let end (struct.get (local module) end))
			(let error (struct.get (local module) error))
			(if
				(:doc "Forward earlier tree or module errors unchanged.")
				(u32.lt 0u32 (local error))
				(then (return (call emit_result 0i32 (local start) (local end) (local error)))))
			(let count (struct.get (local module) count))
			(if
				(:doc "An active module needs an ABI entry.")
				(bool.or (bool.not (struct.get (local module) active)) (i32.eq (local count) 0i32))
				(then (return (call emit_result 0i32 (local start) (local end) 22u32))))
			(let function_count (call count_declarations (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (local count) 1u32))
			(let-mut records (array.alloc ScalarRecord (array.len (local nodes))))
			(let-mut functions (array.alloc ScalarFunction (local function_count)))
			(let-mut parameters (array.alloc ScalarParameter (array.len (local nodes))))
			(let-mut bindings (array.alloc GraphBinding (local count)))
			(let names (call collect_standalone_bindings (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (local count) (local file) (borrow-mut (local bindings))))
			(if
				(:doc "Keep the defining span if a selected local name cannot enter the namespace.")
				(u32.lt 0u32 (struct.get (local names) error))
				(then (return (call emit_result 0i32 (struct.get (local names) start) (struct.get (local names) end) (struct.get (local names) error)))))
			(let-mut statements (array.alloc ScalarStatement (array.len (local nodes))))
			(let-mut expressions (array.alloc ScalarExpression (array.len (local nodes))))
			(let signatures (call read_module_declarations (borrow-shared (local source)) (borrow-shared (local nodes)) (local module)
				(borrow-shared (local declarations)) (borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records))
				(borrow-shared (local bindings)) (local file) (bool true)
				(borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Signature, name, and stable identity failures precede any C emission.")
				(u32.lt 0u32 (struct.get (local signatures) error))
				(then (return (call emit_result 0i32 (struct.get (local signatures) start)
					(struct.get (local signatures) end) (struct.get (local signatures) error)))))
			(let-mut sites (array.alloc CallSite (array.len (local nodes))))
			(let checked (call plan_bodies (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local bindings))
				(borrow-shared (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
				(borrow-mut (local sites)) (local view_start)))
			(if
				(:doc "Preserve the primary span and any related transfer from body checking.")
				(u32.lt 0u32 (struct.get (local checked) error))
				(then (return (struct.new EmitResult (written 0i32)
					(start (struct.get (local checked) start)) (end (struct.get (local checked) end))
					(error (struct.get (local checked) error))
					(related_start (struct.get (local checked) related_start)) (related_end (struct.get (local checked) related_end))))))
			(if
				(:doc "The native host collects paths after body checks and before performing file I/O.")
				(local collect)
				(then
					(if
						(:doc "The request table is indexed by expression row and needs the same extent.")
						(i32.lt (array.len (local assets)) (array.len (local nodes)))
						(then (return (call emit_result 0i32 (local start) (local end) 16u32))))
					(return (call emit_result
						(call request_module_embeds (borrow-shared (local expressions)) (borrow-mut (local assets)))
						(local start) (local end) 0u32))))
			(let embedded (call bind_module_embeds (array.len (local source))
				(borrow-shared (local assets)) (borrow-mut (local expressions))))
			(if
				(:doc "Keep an unavailable asset at its literal operand.")
				(u32.lt 0u32 (struct.get (local embedded) error))
				(then (return (call emit_result 0i32 (struct.get (local embedded) start)
					(struct.get (local embedded) end) (struct.get (local embedded) error)))))
			(let measured (call write_translation_unit (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) 0u32 (bool false) (bool false) (bool false) 0i32 (bool false)))
			(if
				(:doc "A short destination reports the entry span and keeps every output byte intact.")
				(u32.lt (int.convert u32 (array.len (local output))) (local measured))
				(then
					(let entry (array.load (local nodes)
						(struct.get (local signatures) operand)))
					(return (call emit_result 0i32 (struct.get (local entry) start) (struct.get (local entry) end) 16u32))))
			(let written (call write_translation_unit (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) 0u32 (bool false) (bool false) (bool false) 0i32 (bool true)))
			(return (call emit_result (int.convert i32 (local written)) (local start) (local end) 0u32)))))
