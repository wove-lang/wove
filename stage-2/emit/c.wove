(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a complete C translation unit for checked local scalar functions.

	Keep main on the C ABI and generate stable internal symbols for other
	selected declarations. Resolve calls and bindings in the source plan
	before measuring or writing any C text.`)
	emit_c

	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../scalar/flow.wove" (only after_block (type ScalarStatement)))
	(use wove-file "../scalar/plan.wove"
		(only read_functions plan_bodies (type ScalarFunction) (type ScalarParameter) (type ScalarExpression) (type CallSite)))
	(use wove-file "../scalar/syntax.wove" (only binary_operator (type BinaryOperator)))
	(use wove-file "./text.wove" (only c_byte c_text_fragment c_type_text c_cast c_i32_bias write_c_name c_decimal_digits
			function_name_role parameter_name_role local_name_role temporary_name_role))

	(struct EmitResult (fields (written i32) (start i32) (end i32) (error u32)))

	(fn
		(:doc `Write the ABI entry or a stable name from a defining function row.`)
		write_function_name
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function ScalarFunction)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The runtime calls the entry by its conventional C name.")
				(record.get (local function) entry)
				(then (return (call c_text_fragment (borrow-mut (local output)) (local offset) (u32 1) (local writing)))))
			(let name (slice.load (local nodes) (record.get (local function) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call function_name_role)
				(record.get (local function) identity) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn
		(:doc `Write the parameter name in its C function scope.

		Its ordinal is local to the signature and keeps distinct parameters
		separate even when their readable suffixes sanitize identically.`)
		write_parameter_name
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (param ScalarParameter)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (record.get (local param) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call parameter_name_role)
				(int.convert u32 (record.get (local param) position)) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn
		(:doc `Write a local's name from its original source row and spelling.`)
		write_local_name
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (local index)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call local_name_role)
				(int.convert u32 (i32.sub.wrapping (local index) (local tree_base))) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn
		(:doc `Write one checked scalar leaf as a literal or binding reference.`)
		write_scalar
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-slice ScalarParameter)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let kind (record.get (local row) kind))
			(if
				(:doc "Use the same formal parameter name as in the signature.")
				(u32.eq (local kind) (u32 2))
				(then (return (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(slice.load (local parameters) (record.get (local row) target))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Read the generated name of the checked local declaration.")
				(u32.eq (local kind) (u32 6))
				(then (return (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(record.get (local row) target) (local tree_base) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The plan represents false and true as distinct literal kinds.")
				(u32.lt (u32 3) (local kind))
				(then
					(let-mut digit (u8 48))
					(if
						(:doc "True converts exactly from the integer constant one.")
						(u32.eq (local kind) (u32 5))
						(then (set (local digit) (u8 49))))
					(return (call c_byte (borrow-mut (local output)) (local offset) (local digit) (local writing)))))
			(let-mut cursor (local offset))
			(if
				(:doc "Write the sign for a nonzero negative decimal before its digits.")
				(record.get (local row) negative)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 45) (local writing)))))
			(set (local cursor) (call c_decimal_digits (borrow-mut (local output)) (local cursor) (local writing)
				(borrow-shared (local source)) (record.get (local row) start) (record.get (local row) end)))
			(if
				(:doc "Use an unsigned C constant for u32 values, including those above INT32_MAX.")
				(u32.eq (record.get (local row) type) (u32 11))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 117) (local writing)))))
			(return (local cursor))))

	(fn
		(:doc `Use the original expression row as a unique temporary name inside the C function.`)
		write_temporary_name
		(params (source (shared-slice u8)) (index i32) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call temporary_name_role)
				(int.convert u32 (i32.sub.wrapping (local index) (local tree_base)))
				(borrow-shared (local source)) (i32 0) (i32 0)))))

	(fn
		(:doc `Identify expressions with their own evaluation step when nested in another expression.`)
		requires_value_temporary
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local kind) (u32 3))
				(u32.lt (u32 0) (record.get (call binary_operator (local kind)) result))))))

	(fn
		(:doc `Combine two already evaluated operands of the operator's exact type.

		To wrap, first bias the signed long long result by 2^31. A uint32_t
		cast reduces it modulo 2^32. Subtract the bias in the wide signed
		type, leaving an in-range value for the conversion back to i32.`)
		write_binary
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression)
			(operator BinaryOperator) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let symbol (record.get (local operator) symbol))
			(let wrapping (u32.eq (record.get (local operator) result) (u32 5)))
			(let first (record.get (local expression) first))
			(let second (record.get (slice.load (local nodes) (local first)) next_sibling))
			(let-mut cursor (local offset))
			(if
				(:doc "Open both casts and widen the arithmetic with the signed bias.")
				(local wrapping)
				(then
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) (u32 5) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) (u32 11) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(set (local cursor) (call c_i32_bias (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 43) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Equality uses two equals bytes. Both operands already have their native scalar type.")
				(u8.eq (local symbol) (u8 61))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local second) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Reduce to uint32_t before subtracting the signed bias.")
				(local wrapping)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 45) (local writing)))
					(set (local cursor) (call c_i32_bias (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))
			(return (local cursor))))

	(fn
		(:doc `Write a checked value using the temporaries already evaluated for its operands.`)
		write_value
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression) (tree_base i32)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(expressions (shared-slice ScalarExpression)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let kind (record.get (local expression) kind))
			(let operator (call binary_operator (local kind)))
			(if
				(:doc "Binary operations use the left and right temporaries.")
				(u32.lt (u32 0) (record.get (local operator) result))
				(then (return (call write_binary (borrow-shared (local source)) (borrow-shared (local nodes))
					(local expression) (local operator) (local tree_base) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Only calls need a C argument list.")
				(bool.not (u32.eq (local kind) (u32 3)))
				(then (return (call write_scalar (borrow-shared (local source)) (borrow-shared (local nodes))
					(local expression) (local tree_base) (borrow-shared (local parameters)) (borrow-mut (local output))
					(local offset) (local writing)))))
			(let callee (slice.load (local functions) (record.get (local expression) target)))
			(let-mut cursor (call write_function_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local callee) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(let first (record.get (local expression) first))
			(let-mut index (local first))
			(while
				(:doc "Read the checked arguments in order using any previously evaluated temporaries.")
				(bool.not (i32.lt (local index) (i32 0)))
				(body
					(if
						(:doc "A comma separates adjacent actual arguments.")
						(bool.not (i32.eq (local first) (local index)))
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))))
					(let row (slice.load (local expressions) (local index)))
					(if
						(:doc "Literals and bindings can be read directly without a separate evaluation step.")
						(call requires_value_temporary (record.get (local row) kind))
						(then (set (local cursor) (call write_temporary_name
							(borrow-shared (local source)) (local index) (local tree_base)
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call write_scalar
							(borrow-shared (local source)) (borrow-shared (local nodes)) (local row) (local tree_base)
							(borrow-shared (local parameters)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local index) (record.get (slice.load (local nodes) (local index)) next_sibling))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))

	(fn
		(:doc `Evaluate nested values left to right before writing the enclosing statement.

		Traverse the original expression tree in postorder. Calls, binary
		expressions, and operands of binary expressions are evaluated once
		into typed temporaries before their parent uses them.`)
		write_nested_values
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (root i32) (tree_base i32)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(expressions (shared-slice ScalarExpression)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut index (local root))
			(let-mut entering (bool true))
			(let-mut cursor (local offset))
			(while
				(:doc "Descend on entry and finish the current value after all of its operands.")
				(bool.not (i32.lt (local index) (i32 0)))
				(body
					(let expression (slice.load (local expressions) (local index)))
					(let first (record.get (local expression) first))
					(if
						(:doc "Visit the first child of an unvisited call or binary expression.")
						(bool.and (local entering) (bool.not (i32.lt (local first) (i32 0))))
						(then (set (local index) (local first)))
						(else
							(if
								(:doc "The statement writer uses the completed root expression directly.")
								(i32.eq (local index) (local root))
								(then (return (local cursor))))
							(let node (slice.load (local nodes) (local index)))
							(let parent (slice.load (local expressions) (record.get (local node) parent)))
							(if
								(:doc "Save compound values and every binary operand before visiting its sibling.")
								(bool.or (call requires_value_temporary (record.get (local expression) kind))
									(u32.lt (u32 0) (record.get (call binary_operator (record.get (local parent) kind)) result)))
								(then
									(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor)
										(record.get (local expression) type) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
									(set (local cursor) (call write_temporary_name (borrow-shared (local source))
										(local index) (local tree_base) (borrow-mut (local output)) (local cursor) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))
									(set (local cursor) (call write_value (borrow-shared (local source)) (borrow-shared (local nodes))
										(local expression) (local tree_base)
										(borrow-shared (local functions)) (borrow-shared (local parameters))
										(borrow-shared (local expressions)) (borrow-mut (local output)) (local cursor) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))))
							(let sibling (record.get (local node) next_sibling))
							(set (local entering) (bool.not (i32.lt (local sibling) (i32 0))))
							(if
								(:doc "Visit the next operand or finish the enclosing value.")
								(local entering)
								(then (set (local index) (local sibling)))
								(else (set (local index) (record.get (local node) parent))))))))
			(return (local cursor))))

	(fn
		(:doc `Write one checked statement after evaluating its nested values.`)
		write_statement
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (statement ScalarStatement) (tree_base i32)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(expressions (shared-slice ScalarExpression)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let root (record.get (local statement) value))
			(let value (slice.load (local expressions) (local root)))
			(let kind (record.get (local statement) kind))
			(let loop (u32.eq (local kind) (u32 25)))
			(let-mut cursor (local offset))
			(let-mut condition_prefix (u32 6))
			(if
				(:doc "Put condition temporaries inside the loop so every test reads the current locals.")
				(local loop)
				(then
					(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 8) (local writing)))
					(set (local condition_prefix) (u32 9))))
			(set (local cursor) (call write_nested_values (borrow-shared (local source)) (borrow-shared (local nodes))
				(local root) (local tree_base) (borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local expressions)) (borrow-mut (local output)) (local cursor) (local writing)))
			(let target (record.get (local statement) target))
			(let declaring (bool.or (u32.eq (local kind) (u32 15)) (u32.eq (local kind) (u32 16))))
			(let conditional (bool.or (local loop) (u32.eq (local kind) (u32 22))))
			(if
				(:doc "Evaluate the condition value after any temporaries it needs.")
				(local conditional)
				(then
					(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) (local condition_prefix) (local writing))))
				(else
					(if
						(:doc "Returns write their keyword. Other statements write the checked destination.")
						(u32.eq (local kind) (u32 7))
						(then
							(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 3) (local writing))))
						(else
							(if
								(:doc "A declaration uses the exact fixed-width type of its checked initializer.")
								(local declaring)
								(then
									(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor)
										(record.get (local value) type) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))))
							(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
								(local target) (local tree_base) (borrow-mut (local output)) (local cursor) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))))))
			(set (local cursor) (call write_value (borrow-shared (local source)) (borrow-shared (local nodes))
				(local value) (local tree_base) (borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local expressions)) (borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Leave the loop before any body statement when the condition is false.")
				(local loop)
				(then (return (call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 10) (local writing)))))
			(if
				(:doc "Close the condition and open the then scope before emitting its statements.")
				(local conditional)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
			(if
				(:doc "A binding can be unused. A standard C void cast suppresses the warning.")
				(local declaring)
				(then
					(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 4) (local writing)))
					(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local target) (local tree_base) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))))
			(return (local cursor))))

	(fn
		(:doc `Write one C signature, including generated parameter names for a definition.`)
		write_signature
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function ScalarFunction)
			(parameters (shared-slice ScalarParameter)) (prototype bool)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut result (record.get (local function) result))
			(if
				(:doc "The ABI entry has a C int result even though Wove requires i32.")
				(record.get (local function) entry)
				(then (set (local result) (u32 0))))
			(let-mut cursor (call c_type_text (borrow-mut (local output)) (local offset) (local result) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call write_function_name (borrow-shared (local source))
				(borrow-shared (local nodes)) (local function) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(let first (record.get (local function) params))
			(let limit (i32.add.wrapping (local first) (record.get (local function) arity)))
			(if
				(:doc "Use a void parameter list for a zero-argument C function.")
				(i32.eq (local first) (local limit))
				(then (set (local cursor) (call c_text_fragment
					(borrow-mut (local output)) (local cursor) (u32 2) (local writing)))))
			(let-mut index (local first))
			(while
				(:doc "Keep formal types in order for both prototypes and definitions.")
				(i32.lt (local index) (local limit))
				(body
					(if
						(:doc "A comma separates adjacent formal parameters.")
						(i32.lt (local first) (local index))
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))))
					(let item (slice.load (local parameters) (local index)))
					(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor)
						(record.get (local item) type) (local writing)))
					(if
						(:doc "The definition names each parameter for local references.")
						(bool.not (local prototype))
						(then
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
							(set (local cursor) (call write_parameter_name
								(borrow-shared (local source)) (borrow-shared (local nodes)) (local item)
								(borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))

	(fn
		(:doc `Write nested statements and open and close each block at its checked source-tree boundaries.`)
		write_body
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function ScalarFunction)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(statements (shared-slice ScalarStatement)) (expressions (shared-slice ScalarExpression))
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut index (record.get (local function) first_statement))
			(let outer (record.get (slice.load (local nodes) (local index)) parent))
			(let-mut block (local outer))
			(while
				(:doc "Continue through statements and leave nested blocks until the outer body ends.")
				(bool.or (bool.not (i32.lt (local index) (i32 0))) (bool.not (i32.eq (local block) (local outer))))
				(body
					(if
						(:doc "End a block even when it is empty or ends in a return.")
						(i32.lt (local index) (i32 0))
						(then
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))
							(let exit (call after_block (borrow-shared (local nodes)) (local block)))
							(let alternate (record.get (local exit) alternate))
							(if
								(:doc "An explicit else starts a fresh C block. Otherwise resume at the parent statement's sibling.")
								(i32.lt (local alternate) (i32 0))
								(then
									(set (local block) (record.get (local exit) block))
									(set (local index) (record.get (local exit) statement)))
								(else
									(set (local cursor) (call c_text_fragment
										(borrow-mut (local output)) (local cursor) (u32 7) (local writing)))
									(set (local block) (local alternate))
									(set (local index) (record.get (slice.load (local statements) (local block)) first)))))
						(else
							(let statement (slice.load (local statements) (local index)))
							(set (local cursor) (call write_statement (borrow-shared (local source)) (borrow-shared (local nodes))
								(local statement) (record.get (local function) tree_base)
								(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local expressions))
								(borrow-mut (local output)) (local cursor) (local writing)))
							(let first (record.get (local statement) first))
							(if
								(:doc "An if or while has a nested block. Other statements continue with their siblings.")
								(i32.lt (local first) (i32 0))
								(then (set (local index) (record.get (slice.load (local nodes) (local index)) next_sibling)))
								(else
									(set (local block) (local first))
									(set (local index) (record.get (slice.load (local statements) (local block)) first))))))))
			(return (local cursor))))

	(fn
		(:doc `Write a checked function definition and its statements in source order.`)
		write_definition
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function ScalarFunction)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(statements (shared-slice ScalarStatement)) (expressions (shared-slice ScalarExpression)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local function) (borrow-shared (local parameters)) (bool false)
				(borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))
			(let-mut index (record.get (local function) params))
			(let limit (i32.add.wrapping (local index) (record.get (local function) arity)))
			(while
				(:doc "Scalar parameters can be unused. Emit a standard C void cast to suppress that warning.")
				(i32.lt (local index) (local limit))
				(body
					(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 4) (local writing)))
					(set (local cursor) (call write_parameter_name (borrow-shared (local source))
						(borrow-shared (local nodes)) (slice.load (local parameters) (local index))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(set (local cursor) (call write_body (borrow-shared (local source)) (borrow-shared (local nodes))
				(local function) (borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local expressions))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 10) (local writing)))))

	(fn
		(:doc `Measure or write the same complete translation unit using the resolved plan.`)
		write_translation_unit
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(statements (shared-slice ScalarStatement)) (expressions (shared-slice ScalarExpression)) (output (mut-slice u8)) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (u32 0))
			(let count (slice.len (local functions)))
			(let first (slice.load (local functions) (i32 0)))
			(let first_statement (slice.load (local statements) (record.get (local first) first_statement)))
			(let first_value (slice.load (local expressions) (record.get (local first_statement) value)))
			(if
				(:doc "Include fixed-width types for helpers, compound bodies, or a wrapping expression in a lone return.")
				(bool.or (i32.lt (i32 1) (local count))
					(bool.or (bool.not (u32.eq (record.get (local first_statement) kind) (u32 7)))
						(u32.eq (record.get (call binary_operator (record.get (local first_value) kind)) result) (u32 5))))
				(then (set (local cursor)
					(call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 0) (local writing)))))
			(let-mut index (i32 0))
			(while
				(:doc "Forward-declare local helpers before emitting the bodies in source order.")
				(i32.lt (local index) (local count))
				(body
					(let function (slice.load (local functions) (local index)))
					(if
						(:doc "Only the helpers can be direct call targets.")
						(bool.not (record.get (local function) entry))
						(then
							(set (local cursor) (call write_signature (borrow-shared (local source)) (borrow-shared (local nodes))
								(local function) (borrow-shared (local parameters)) (bool true)
								(borrow-mut (local output)) (local cursor) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 10) (local writing)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(set (local index) (i32 0))
			(while
				(:doc "Every selected declaration receives one definition with the verified signature.")
				(i32.lt (local index) (local count))
				(body
					(set (local cursor) (call write_definition (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local functions) (local index)) (borrow-shared (local functions))
						(borrow-shared (local parameters)) (borrow-shared (local statements)) (borrow-shared (local expressions))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local cursor))))

	(fn
		(:doc `Return a count and originating byte span from C emission.`)
		emit_result
		(params (written i32) (start i32) (end i32) (error u32))
		(returns EmitResult)
		(body
			(return (record.make EmitResult (written (local written)) (error (local error))
				(start (local start)) (end (local end))))))

	(fn
		(:doc `Check, measure, and emit the selected scalar program into the supplied output view.

		Keep source diagnostics intact and check the entire translation unit's
		capacity before writing. Failure leaves the destination untouched.`)
		(:expect bootstrap.scalar_c_emission
			(issue "https://github.com/wove-lang/wove/issues/67"))
		(:expect bootstrap.stable_local_calls
			(issue "https://github.com/wove-lang/wove/issues/69"))
		(:expect bootstrap.i32_locals (issue "https://github.com/wove-lang/wove/issues/72"))
		(:expect bootstrap.i32_operators (issue "https://github.com/wove-lang/wove/issues/73"))
		(:expect bootstrap.scalar_if (issue "https://github.com/wove-lang/wove/issues/74"))
		(:expect bootstrap.scalar_while (issue "https://github.com/wove-lang/wove/issues/75"))
		(:expect bootstrap.unsigned_scalars (issue "https://github.com/wove-lang/wove/issues/77"))
		(:expect bootstrap.unsigned_comparisons (issue "https://github.com/wove-lang/wove/issues/79"))
		emit_module
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (module ModuleRead)
			(declarations (shared-slice SelectedDeclaration)) (file i32) (view_start i32) (output (mut-slice u8)))
		(returns EmitResult)
		(body
			(let start (record.get (local module) start))
			(let end (record.get (local module) end))
			(let error (record.get (local module) error))
			(if
				(:doc "Forward earlier tree or module errors unchanged.")
				(u32.lt (u32 0) (local error))
				(then (return (call emit_result (i32 0) (local start) (local end) (local error)))))
			(let count (record.get (local module) count))
			(if
				(:doc "An active module needs an ABI entry.")
				(bool.or (bool.not (record.get (local module) active)) (i32.eq (local count) (i32 0)))
				(then (return (call emit_result (i32 0) (local start) (local end) (u32 22)))))
			(let-mut functions (array.alloc ScalarFunction (local count)))
			(let-mut parameters (array.alloc ScalarParameter (slice.len (local nodes))))
			(let signatures (call read_functions (borrow-shared (local source)) (borrow-shared (local nodes)) (local module)
				(borrow-shared (local declarations)) (borrow-mut (local functions)) (borrow-mut (local parameters)) (local file) (bool true)))
			(if
				(:doc "Signature, name, and stable identity failures precede any C emission.")
				(u32.lt (u32 0) (record.get (local signatures) error))
				(then (return (call emit_result (i32 0) (record.get (local signatures) start)
					(record.get (local signatures) end) (record.get (local signatures) error)))))
			(let-mut statements (array.alloc ScalarStatement (slice.len (local nodes))))
			(let-mut expressions (array.alloc ScalarExpression (slice.len (local nodes))))
			(let-mut sites (array.alloc CallSite (slice.len (local nodes))))
			(let bindings (array.alloc GraphBinding (i32 0)))
			(let checked (call plan_bodies (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local bindings))
				(borrow-mut (local statements)) (borrow-mut (local expressions)) (borrow-mut (local sites)) (local view_start)))
			(if
				(:doc "Keep source spans from call resolution and exact scalar checking.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (call emit_result (i32 0) (record.get (local checked) start)
					(record.get (local checked) end) (record.get (local checked) error)))))
			(let measured (call write_translation_unit (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local expressions)) (borrow-mut (local output)) (bool false)))
			(if
				(:doc "A short destination reports the entry span and keeps every output byte intact.")
				(u32.lt (int.convert u32 (slice.len (local output))) (local measured))
				(then
					(let entry (slice.load (local nodes)
						(record.get (local signatures) operand)))
					(return (call emit_result (i32 0) (record.get (local entry) start) (record.get (local entry) end) (u32 16)))))
			(let written (call write_translation_unit (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local expressions)) (borrow-mut (local output)) (bool true)))
			(return (call emit_result (int.convert i32 (local written)) (local start) (local end) (u32 0))))))
