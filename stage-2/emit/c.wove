	(fn write_nested_values
		(:doc `Evaluate nested values left to right before writing the enclosing statement.

		Traverse the original expression tree in postorder. Materialize
		nested calls and operators, and capture each argument before a
		native call checks its argument contracts. For a
		short-circuit operator, finish the left value before opening a
		guard around the full right subtree. Even at the root, the guard
		leaves a result temporary available to the statement writer.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (root i32) (caller ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get caller name_base))
			(let value (array.load expressions root))
			(if
				(:doc "An embed initializer has no children to evaluate. Declare its compiled bytes once in this scope.")
				(u32.eq (struct.get value kind) 60u32)
				(then
					(if
						(:doc "An empty view has no backing table.")
						(i32.eq (struct.get value asset_start) (struct.get value asset_end))
						(then (return offset)))
					(let open (call open_static_value (borrow-mut output) offset 10u32 writing))
					(let name (call write_temporary_name (borrow-shared nodes) root
						(borrow-mut output) open name_prefix writing))
					(return (call write_static_bytes (borrow-shared source)
						(struct.get value asset_start) (struct.get value asset_end)
						(borrow-mut output) name writing))))
			(let-mut index root)
			(let-mut entering (bool true))
			(let-mut cursor offset)
			(while
				(:doc "Descend on entry and finish the current value after all of its operands.")
				(i32.not-ltz index)
				(body
					(let expression (array.load expressions index))
					(let-mut first (struct.get expression first))
					(let receiver (call indexed_growth_receiver (borrow-shared expressions) expression))
					(if (i32.not-ltz receiver) (then (set first receiver)))
					(let handle_slot (bool.or (u32.eq (struct.get expression kind) (call native_handle_init_borrow_kind))
						(u32.eq (struct.get expression kind) native_handle_slot_borrow_kind)))
					(let direct_place (bool.or
						(bool.or handle_slot (u32.eq (struct.get expression kind) (call owner_is_null_kind)))
						(bool.and (u32.eq (struct.get expression kind) 52u32)
							(i32.not-ltz (struct.get expression projection)))))
					(if
						(:doc "Descend into evaluated operands. A checked place accesses its storage directly.")
						(bool.and entering (bool.and (bool.not direct_place)
							(bool.and (u32.not-eq (struct.get expression kind) checked_foreign_handle_kind)
								(i32.not-ltz first))))
						(then (set index first))
						(else
							(let converted (call is_c_argument_call expression (borrow-shared functions)))
							(let repeated (u32.eq (struct.get expression kind) 72u32))
							(if
								(:doc "An evaluated repeat value fills its array once before the enclosing expression uses it.")
								repeated
								(then (set cursor (call write_fixed_repeat (borrow-shared source) (borrow-shared nodes)
									(borrow-shared records) expression index
									(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "Invoke the native call only after capturing every operand.")
								converted
								(then
									(let callee (array.load functions (struct.get expression target)))
									(set cursor (call write_c_argument_call (borrow-shared source)
										(borrow-shared nodes) (borrow-shared parameters) (borrow-shared records) (borrow-shared bindings)
										(borrow-shared expressions) expression caller callee index
										(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "The root is ready as an expression or a completed temporary.")
								(i32.eq index root)
								(then (return cursor)))
							(let node (array.load nodes index))
							(let parent_index (struct.get node parent))
							(let parent (array.load expressions parent_index))
							(let parent_kind (struct.get parent kind))
							(let parent_operator (call scalar_operator parent_kind))
							(let kind (struct.get expression kind))
							(let operator (call scalar_operator kind))
							(let fixed_owner_access (bool.or (u32.eq parent_kind fixed_owner_store)
								(bool.or (u32.eq parent_kind fixed_owner_take)
									(u32.eq parent_kind fixed_owner_borrow))))
							(let fixed_length (bool.and (u32.eq parent_kind 36u32)
								(call is_record_type (struct.get expression type))))
							(let direct_array (bool.and (i32.eq index (struct.get parent first))
								(bool.or
									(bool.and (bool.or (u32.eq kind 6u32) (u32.eq kind 62u32))
										(bool.or (call is_fixed_access parent_kind) fixed_length))
									(bool.and direct_place
										(bool.or (bool.or (u32.eq parent_kind 74u32)
												(u32.eq parent_kind fixed_subarray_place))
											(bool.or fixed_owner_access
												(bool.and fixed_length
													(call is_owning_record (borrow-shared records) (struct.get expression type)))))))))
							(let arm (bool.or (u32.eq kind match_value_case)
								(bool.or (u32.eq kind conditional_then) (u32.eq kind conditional_else))))
							(let choice (u32.eq parent_kind conditional_value))
							(let match (u32.eq parent_kind match_value))
							(let inside_arm (bool.or (u32.eq parent_kind match_value_case)
								(bool.or (u32.eq parent_kind conditional_then) (u32.eq parent_kind conditional_else))))
							(let already_ready (bool.or (bool.or converted repeated)
								(bool.or (bool.or arm (bool.or (u32.eq kind conditional_value) (u32.eq kind match_value)))
									(bool.or (bool.or direct_array (struct.get operator short_circuit))
										(bool.or (u32.eq kind (call c_null_argument_kind))
											(bool.or (u32.eq kind c_static_string_argument)
												(u32.eq kind c_adapted_callback_argument)))))))
							(if
								(:doc "A retained literal names C static storage instead of a temporary descriptor.")
								(u32.eq kind c_static_string_argument)
								(then (set cursor (call write_static_c_string (borrow-shared source)
									(borrow-shared nodes) index (bool false)
									(borrow-mut output) cursor name_prefix writing))))
							(let guard (struct.get expression extent_check))
							(let extent_guard (i32.not-ltz guard))
							(let owner_guard (i32.eq guard inline_owner_argument_guard))
							(let copy_argument (bool.or (u32.eq parent_kind indirect_call_kind)
								(bool.and (u32.eq parent_kind 3u32)
									(call captures_value_argument expression (struct.get node next_sibling)
										(borrow-shared records)))))
							(if
								(:doc "Save an eager compound value or checked operand before moving to its sibling.")
								(bool.and (bool.not already_ready)
									(bool.or (bool.or (i32.not-eq guard -1i32) (bool.or copy_argument (call requires_value_temporary kind)))
										(bool.or (bool.or (bool.or choice match) inside_arm)
											(bool.or (u32.gtz (struct.get parent_operator result))
												(bool.or (call is_c_argument_call parent (borrow-shared functions))
													(bool.or
														(bool.or (u32.eq parent_kind indexed_record_loan)
															(bool.or (call is_runtime_operation parent_kind) (call is_fixed_initializer parent_kind)))
														(bool.or (u32.eq parent_kind 51u32) (u32.eq parent_kind enum_payload_constructor))))))))
								(then
									(if
										(:doc "An opaque slot loan captures the checked original address.")
										handle_slot
										(then
											(set cursor (call write_native_handle_slot_capture
												(borrow-shared source) (borrow-shared nodes) expression
												index tree_base (borrow-shared parameters) (borrow-shared expressions) (borrow-shared records)
												(borrow-mut output) cursor name_prefix writing)))
										(else
											(set cursor (call write_temporary_declaration (borrow-shared source) (borrow-shared nodes)
												(borrow-shared records) index (struct.get expression type)
												(borrow-mut output) cursor name_prefix writing))
											(set cursor (call write_value (borrow-shared source) (borrow-shared nodes)
												index tree_base (borrow-shared functions) (borrow-shared parameters)
												(borrow-shared records) (borrow-shared expressions) (borrow-mut output) cursor name_prefix writing))
											(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))))))
							(if
								(:doc "Validate the captured foreign pointer before visiting the next argument.")
								(u32.eq kind checked_foreign_handle_kind)
								(then
									(set cursor (call write_native_handle_check (borrow-shared source) (borrow-shared nodes)
										expression index (borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))))
							(if
								(:doc "A checked call argument reuses the same captured descriptor after its guard.")
								extent_guard
								(then (set cursor (call write_extent_check (borrow-shared nodes)
									expression index (struct.get caller file)
									(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "Reject vacant inline owner slots before any later operand evaluates.")
								owner_guard
								(then (set cursor (call write_inline_owner_argument_check (borrow-shared source) (borrow-shared nodes)
									(array.load records (call record_index (struct.get expression type))) expression
									index (struct.get caller file)
									(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "Open the right guard after the left value. Close it after the right value.")
								(struct.get parent_operator short_circuit)
								(then
									(set cursor (call write_short_circuit_edge (borrow-shared source) (borrow-shared nodes)
										(borrow-shared records) index parent_index
										(i32.eq index (struct.get parent first)) (struct.get parent_operator symbol)
										(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "Keep each arm's evaluation and result assignment inside its own branch.")
								choice
								(then (set cursor (call write_conditional_edge (borrow-shared source)
									(borrow-shared nodes) (borrow-shared records) index parent_index
									expression parent
									(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "Switch edges evaluate only the selected result, then join it into the enclosing temporary.")
								match
								(then (set cursor (call write_match_edge (borrow-shared source) (borrow-shared nodes)
									(borrow-shared records) (borrow-shared statements) (borrow-shared expressions)
									index parent_index tree_base
									(borrow-mut output) cursor name_prefix writing))))
							(let-mut sibling (struct.get node next_sibling))
							(if
								(:doc "The field spelling follows its receiver in the source but needs no evaluation.")
								(u32.eq parent_kind 52u32)
								(then (set sibling -1i32)))
							(if
								(:doc "After capturing a growth receiver, visit the checked value and skip any type spelling.")
								(bool.and (call is_array_growth parent_kind)
									(i32.eq index (struct.get parent projection)))
								(then (set sibling (struct.get parent first))))
							(set entering (i32.not-ltz sibling))
							(if
								(:doc "Visit the next operand or finish the enclosing value.")
								entering
								(then (set index sibling))
								(else (set index (struct.get node parent))))))))
			(return cursor)))

	(fn open_owner_drop
		(:doc `Open the drop call for a live local owner, skipping missing C handles.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarStatement) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get row type))
			(if
				(:doc "Leaving a scope waits for any receipt that still owns its worker.")
				(u32.eq type worker_receipt_type)
				(then (return (call c_literal_text (borrow-shared worker_drop_call)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Leaving a queue's scope retires every still-pending receipt.")
				(u32.eq type worker_queue_type)
				(then (return (call c_literal_text (borrow-shared worker_queue_drop_call)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Ending a pool scope closes admission and leaves accepted work live.")
				(u32.eq type worker_pool_type)
				(then (return (call c_literal_text (borrow-shared worker_pool_drop_call)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Ending a permit scope releases an unused reservation.")
				(u32.eq type worker_permit_type)
				(then (return (call c_literal_text (borrow-shared worker_permit_drop_call)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Array allocations are released through the shared runtime.")
				(bool.not (call is_native_owner type))
				(then (return (call open_array_drop (borrow-mut output) offset writing))))
			(let condition (call c_text_fragment (borrow-mut output) offset 6u32 writing))
			(let name (call write_local_name (borrow-shared source) (borrow-shared nodes)
				(struct.get row target) tree_base (borrow-mut output) condition
				name_prefix writing))
			(let close (call c_byte (borrow-mut output) name 41u8 writing))
			(let discard (call c_text_fragment (borrow-mut output) close 4u32 writing))
			(let destructor (call write_native_destructor (borrow-shared source) (borrow-shared nodes)
				type (borrow-mut output) discard writing))
			(return (call c_byte (borrow-mut output) destructor 40u8 writing))))

	(fn write_cleanup
		(:doc `Release live owners in reverse declaration order at a return or block exit.

		A moved return keeps the owner named by transferred. Other exits
		pass -1 so this transfer has no effect on their cleanup.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(records (shared-array ScalarRecord)) (head i32) (stop i32) (exit_row i32) (transferred i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut owner head)
			(let-mut cursor offset)
			(while
				(:doc "A lexical exit drops only the owners in the scopes it leaves.")
				(i32.not-eq owner stop)
				(body
					(let row (array.load statements owner))
					(let move (struct.get row move_site))
					(if
						(:doc "Keep the returned owner and skip earlier transfers on this path.")
						(bool.and (i32.not-eq transferred (struct.get row target))
							(bool.or (i32.ltz move)
								(bool.and (i32.not-ltz exit_row) (i32.lt exit_row move))))
						(then
							(let type (struct.get row type))
							(let target (struct.get row target))
							(if
								(:doc "An owning aggregate drops only its remaining active storage.")
								(call is_owning_record (borrow-shared records) type)
								(then (set cursor (call write_aggregate_drop (borrow-shared source) (borrow-shared nodes)
									(array.load records (call record_index type)) target tree_base
									(borrow-mut output) cursor name_prefix writing)))
								(else
									(if
										(:doc "Caller-owned storage releases the allocation even when initialization failed.")
										(bool.and (call is_native_owner type)
											(struct.get (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type) storage))
										(then (set cursor (call write_storage_cleanup (borrow-shared source) (borrow-shared nodes)
											type target tree_base (borrow-mut output)
											cursor name_prefix writing)))
										(else
											(set cursor (call open_owner_drop (borrow-shared source) (borrow-shared nodes)
												row tree_base (borrow-mut output) cursor name_prefix writing))
											(if
												(:doc "A consuming iterator's hidden array lives in its capture temporary.")
												(u32.eq (struct.get row kind) for_source_owner)
												(then (set cursor (call write_temporary_name (borrow-shared nodes)
													target (borrow-mut output) cursor name_prefix writing)))
												(else (set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
													target tree_base (borrow-mut output) cursor name_prefix writing))))
											(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
											(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))))))))
					(set owner (struct.get row previous_owner))))
			(return cursor)))

	(fn write_value_capture
		(:doc `Evaluate one header value and save it before evaluating any following value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (root i32) (slot i32) (caller ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get caller name_base))
			(let prepared (call write_nested_values (borrow-shared source) (borrow-shared nodes)
				root caller (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions) (borrow-mut output) offset name_prefix writing))
			(let initialized (call write_temporary_declaration (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) slot (struct.get (array.load expressions root) type)
				(borrow-mut output) prepared name_prefix writing))
			(let end (call write_value (borrow-shared source) (borrow-shared nodes)
				root tree_base (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared records) (borrow-shared expressions) (borrow-mut output) initialized name_prefix writing))
			(return (call c_byte (borrow-mut output) end 59u8 writing))))

	(fn write_for_statement
		(:doc `Capture a view, moved array, or both range bounds before opening the loop body.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (caller ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let statement (array.load statements index))
			(let block (struct.get statement first))
			(let root (struct.get statement value))
			(let type (struct.get statement type))
			(let view (call is_readable_slice type))
			(let consuming (call is_array_owner type))
			(let array (bool.or view consuming))
			(let tree_base (struct.get caller name_base))
			(let-mut owner root)
			(let-mut cursor (call c_byte (borrow-mut output) offset 123u8 writing))
			(let-mut last root)
			(if
				(:doc "Finish the range's first evaluation before starting the second.")
				(bool.not array)
				(then
					(set cursor (call write_value_capture (borrow-shared source) (borrow-shared nodes)
						root index caller (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions) (borrow-mut output)
						cursor name_prefix writing))
					(set last (struct.get (array.load nodes root) next_sibling))))
			(let-mut slot block)
			(if
				(:doc "The moved array has its own capture slot beside the view used to count iterations.")
				consuming
				(then
					(set owner (call iterator_owner_boundary (borrow-shared nodes) statement))
					(set slot owner)))
			(set cursor (call write_value_capture (borrow-shared source) (borrow-shared nodes)
				last slot caller (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "The loop owns the captured array while its count and backing address remain stable.")
				consuming
				(then (set cursor (call write_for_owned_view (borrow-shared nodes)
					owner block
					(borrow-mut output) cursor name_prefix writing))))
			(let-mut site owner)
			(if
				(:doc "A borrowed row uses the checked iterator span for an unfilled slot.")
				(bool.and view (call is_array_owner (call slice_element_type (borrow-shared records) type)))
				(then (set site index)))
			(return (call write_for_body (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared statements) index block tree_base array
				owner (array.load expressions site) (borrow-mut output) cursor name_prefix writing))))

	(fn write_statement
		(:doc `Write one checked statement after evaluating its nested values.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (caller ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get caller name_base))
			(let statement (array.load statements index))
			(let root (struct.get statement value))
			(let previous_owner (struct.get statement previous_owner))
			(let kind (struct.get statement kind))
			(if
				(:doc "A loop exit releases just the owners introduced since the target loop was entered.")
				(call is_loop_exit kind)
				(then
					(let loop (struct.get statement target))
					(let entry (array.load statements loop))
					(let breaking (u32.eq kind break_statement))
					(let-mut stop (struct.get entry previous_owner))
					(if
						(:doc "Continue leaves the captured array available for the next item.")
						(bool.not breaking)
						(then (set stop (call iterator_owner_boundary (borrow-shared nodes) entry))))
					(let cleaned (call write_cleanup (borrow-shared source) (borrow-shared nodes)
						(borrow-shared statements) (borrow-shared records) previous_owner stop
						index -1i32 tree_base (borrow-mut output) offset name_prefix writing))
					(if
						(:doc "C continue restarts the nearest loop even inside a switch.")
						(bool.not breaking)
						(then (return (call c_literal_text (borrow-shared c_continue)
							(borrow-mut output) cleaned writing))))
					(let jump (call c_literal_text (borrow-shared c_goto)
						(borrow-mut output) cleaned writing))
					(let label (call write_loop_label (borrow-shared nodes) loop
						(borrow-mut output) jump name_prefix writing))
					(return (call c_byte (borrow-mut output) label 59u8 writing))))
			(if
				(:doc "An iteration statement prepares its header before entering the body.")
				(u32.eq kind for_statement)
				(then (return (call write_for_statement (borrow-shared source) (borrow-shared nodes)
					index caller (borrow-shared functions) (borrow-shared parameters)
					(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A value-less return releases active owners without evaluating an expression.")
				(i32.ltz root)
				(then
					(let cleaned (call write_cleanup (borrow-shared source) (borrow-shared nodes)
						(borrow-shared statements) (borrow-shared records) previous_owner -1i32 index -1i32 tree_base
						(borrow-mut output) offset name_prefix writing))
					(let keyword (call c_text_fragment (borrow-mut output) cleaned 11u32 writing))
					(return (call c_byte (borrow-mut output) keyword 59u8 writing))))
			(if
				(:doc "Capture the replacement completely before the original slot is evaluated or retired.")
				(bool.or (u32.eq kind owner_assignment) (u32.eq kind owner_field_assignment))
				(then
					(let captured (call write_value_capture (borrow-shared source) (borrow-shared nodes)
						root index caller (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
						(borrow-mut output) offset name_prefix writing))
					(return (call write_owner_assignment (borrow-shared source) (borrow-shared nodes) statement
						(borrow-shared parameters) (borrow-shared records) (borrow-shared expressions)
						index tree_base (borrow-mut output) captured name_prefix writing))))
			(let value (array.load expressions root))
			(if
				(:doc "Install this site's writable static bytes directly on the original native lvalue.")
				(bool.and (u32.eq kind c_value_assignment) (u32.eq (struct.get value kind) c_static_string_argument))
				(then
					(let storage (call write_static_c_string (borrow-shared source) (borrow-shared nodes)
						root (bool true) (borrow-mut output) offset name_prefix writing))
					(let name (array.load nodes (struct.get statement target)))
					(let place (call write_c_value_name (borrow-shared source) name (borrow-mut output) storage writing))
					(let cast (call c_literal_text (borrow-shared c_static_mut_string_assignment)
						(borrow-mut output) place writing))
					(let address (call write_temporary_name (borrow-shared nodes) root
						(borrow-mut output) cast name_prefix writing))
					(return (call c_byte (borrow-mut output) address 59u8 writing))))
			(let loop (u32.eq kind 25u32))
			(let-mut cursor offset)
			(let-mut condition_prefix 6u32)
			(if
				(:doc "Put condition temporaries inside the loop so every test reads the current locals.")
				loop
				(then
					(set cursor (call c_text_fragment (borrow-mut output) cursor 8u32 writing))
					(set condition_prefix 9u32)))
			(set cursor (call write_nested_values (borrow-shared source) (borrow-shared nodes)
				root caller (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Evaluate the match subject once and switch on the integer value or variant ordinal.")
				(u32.eq kind match_statement)
				(then
					(let type (struct.get value type))
					(let integer (call is_builtin_integer type))
					(let tagged (bool.and (bool.not integer)
						(call is_payload_enum (array.load records (call record_index type)))))
					(if
						(:doc "Payload cases share a snapshot of the full enum. Unit-only matches switch directly.")
						tagged
						(then (set cursor (call write_temporary_declaration (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) index type
							(borrow-mut output) cursor name_prefix writing)))
						(else (set cursor (call c_literal_text (borrow-shared c_switch)
							(borrow-mut output) cursor writing))))
					(set cursor (call write_value (borrow-shared source) (borrow-shared nodes)
						root tree_base (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared records) (borrow-shared expressions)
						(borrow-mut output) cursor name_prefix writing))
					(if
						(:doc "Read only the captured discriminant to choose the active union member.")
						tagged
						(then
							(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
							(set cursor (call c_literal_text (borrow-shared c_switch)
								(borrow-mut output) cursor writing))
							(set cursor (call write_temporary_name (borrow-shared nodes) index
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_literal_text (borrow-shared c_enum_tag)
								(borrow-mut output) cursor writing))))
					(let cases (call c_literal_text (borrow-shared c_switch_body)
						(borrow-mut output) cursor writing))
					(let arm (array.load statements (struct.get statement first)))
					(return (call write_case_entry (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared statements) (borrow-shared expressions)
						arm type index tree_base
						(borrow-mut output) cases name_prefix writing))))
			(if
				(:doc "Evaluate the right-hand value once before resolving the C macro lvalue for the write.")
				(u32.eq kind c_value_assignment)
				(then
					(set cursor (call write_temporary_declaration (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) index (struct.get value type)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call write_value (borrow-shared source) (borrow-shared nodes)
						root tree_base (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared records) (borrow-shared expressions)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
					(let name (array.load nodes (struct.get statement target)))
					(set cursor (call write_c_value_name (borrow-shared source) name
						(borrow-mut output) cursor writing))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) index
						(borrow-mut output) cursor name_prefix writing))
					(return (call c_byte (borrow-mut output) cursor 59u8 writing))))
			(if
				(:doc "The ordered native call already emitted the invocation and any argument cleanup.")
				(bool.and (u32.eq kind 9u32)
					(call is_c_argument_call value (borrow-shared functions)))
				(then (return cursor)))
			(if
				(:doc "A store or other void call is a complete statement after its operands are ready.")
				(bool.or (u32.eq kind 9u32)
					(bool.or (bool.or (call is_array_growth_statement kind) (u32.eq kind worker_push_kind))
						(bool.or (u32.eq kind fixed_owner_store)
							(bool.or (u32.eq kind 40u32) (u32.eq kind 74u32)))))
				(then
					(let next (call write_value (borrow-shared source) (borrow-shared nodes)
						root tree_base (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared records) (borrow-shared expressions)
						(borrow-mut output) cursor name_prefix writing))
					(return (call c_byte (borrow-mut output) next 59u8 writing))))
			(if
				(:doc "Save the return value before releasing live owners.")
				(bool.and (u32.eq kind 7u32) (i32.not-ltz previous_owner))
				(then
					(set cursor (call write_temporary_declaration (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) index (struct.get value type)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call write_value (borrow-shared source) (borrow-shared nodes)
						root tree_base (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared records) (borrow-shared expressions) (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
					(let-mut transferred -1i32)
					(if
						(:doc "A checked owner reference in a return denotes an explicit move from that local.")
						(bool.and (bool.or (call is_native_owner (struct.get value type))
							(bool.or (call is_array_owner (struct.get value type))
								(call is_owning_record (borrow-shared records) (struct.get value type))))
							(u32.eq (struct.get value kind) 6u32))
						(then (set transferred (struct.get value target))))
					(if
						(:doc "Returning an unwrapped owner also transfers the option's original allocation.")
						(u32.eq (struct.get value kind) (call optional_unwrap_kind))
						(then (set transferred
							(struct.get (array.load expressions (struct.get value first)) target))))
					(set cursor (call write_cleanup (borrow-shared source) (borrow-shared nodes)
						(borrow-shared statements) (borrow-shared records) previous_owner -1i32 index transferred tree_base
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_text_fragment (borrow-mut output) cursor 3u32 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) index
						(borrow-mut output) cursor name_prefix writing))
					(return (call c_byte (borrow-mut output) cursor 59u8 writing))))
			(let target (struct.get statement target))
			(let declaring (bool.or (u32.eq kind 15u32) (u32.eq kind 16u32)))
			(let conditional (bool.or loop (u32.eq kind 22u32)))
			(if
				(:doc "Evaluate the condition value after any temporaries it needs.")
				conditional
				(then
					(set cursor (call c_text_fragment (borrow-mut output) cursor condition_prefix writing)))
				(else
					(if
						(:doc "Returns write their keyword. Other statements write the checked destination.")
						(u32.eq kind 7u32)
						(then
							(set cursor (call c_text_fragment (borrow-mut output) cursor 3u32 writing)))
						(else
							(if
								(:doc "A declaration uses the exact C type of its checked initializer.")
								declaring
								(then
									(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
										(borrow-shared records) (struct.get value type)
										(borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))))
							(if
								(:doc "Use the checked field path for projected destinations.")
								(u32.eq kind field_assignment)
								(then (set cursor (call write_field_place (borrow-shared source) (borrow-shared nodes)
									(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) target tree_base
									(borrow-mut output) cursor name_prefix writing)))
								(else
									(if
										(:doc "A scalar formal writes through its existing address. Other writes use the local place.")
										(u32.eq kind parameter_assignment)
										(then
											(let place (array.load expressions target))
											(set cursor (call write_parameter_place (borrow-shared source) (borrow-shared nodes)
												(array.load parameters (struct.get place target)) (bool true)
												(borrow-mut output) cursor name_prefix writing)))
										(else (set cursor (call write_local_place (borrow-shared source) (borrow-shared nodes)
											target tree_base (u32.eq kind for_element_assignment)
											(borrow-mut output) cursor name_prefix writing))))))
							(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))))))
			(set cursor (call write_value (borrow-shared source) (borrow-shared nodes)
				root tree_base (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared records) (borrow-shared expressions) (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Leave the loop before any body statement when the condition is false.")
				loop
				(then (return (call c_text_fragment (borrow-mut output) cursor 10u32 writing))))
			(if
				(:doc "Close the condition and open the then scope before emitting its statements.")
				conditional
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
					(return (call c_byte (borrow-mut output) cursor 123u8 writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
			(if
				(:doc "A binding can be unused. A standard C void cast suppresses the warning.")
				declaring
				(then
					(set cursor (call c_text_fragment (borrow-mut output) cursor 4u32 writing))
					(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
						target tree_base (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))))
			(return cursor)))

	(let private_function_prefix "static __attribute__((unused)) ")

	(fn write_formal_slot
		(:doc "Give an owned formal its lexical owner name and other formals their ordinary parameter name.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (item ScalarParameter) (records (shared-array ScalarRecord)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Moves and cleanup address the owned argument's original slot.")
				(call is_owned_parameter (borrow-shared records) (struct.get item type))
				(then (return (call write_local_name (borrow-shared source) (borrow-shared nodes)
					(struct.get item name) tree_base (borrow-mut output) offset
					name_prefix writing))))
			(return (call write_parameter_name (borrow-shared source) (borrow-shared nodes) item
				(borrow-mut output) offset name_prefix writing))))

	(fn write_signature
		(:doc `Write one C signature, including generated parameter names for a definition.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (prototype bool) (private_helpers bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let result (struct.get function result))
			(let-mut cursor offset)
			(if
				(:doc "Keep Wove function bodies inside this C unit in private emission mode.")
				private_helpers
				(then (set cursor (call c_literal_text (borrow-shared private_function_prefix)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) result (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call write_function_name (borrow-shared source)
				(borrow-shared nodes) function (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(let first (struct.get function params))
			(let limit (i32.add first (struct.get function arity)))
			(if
				(:doc "Use a void parameter list for a zero-argument C function.")
				(i32.eq first limit)
				(then (set cursor (call c_text_fragment
					(borrow-mut output) cursor 2u32 writing))))
			(let-mut index first)
			(while
				(:doc "Keep formal types in order for both prototypes and definitions.")
				(i32.lt index limit)
				(body
					(if
						(:doc "A comma separates adjacent formal parameters.")
						(i32.lt first index)
						(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
					(let item (array.load parameters index))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (struct.get item type)
						(borrow-mut output) cursor name_prefix writing))
					(if
						(:doc "The definition names each parameter for local references.")
						(bool.not prototype)
						(then
							(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
							(set cursor (call write_formal_slot (borrow-shared source) (borrow-shared nodes)
								item (borrow-shared records) (struct.get function name_base)
								(borrow-mut output) cursor name_prefix writing))))
					(set index (i32.inc index))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))

	(fn write_body
		(:doc `Write nested statements and open and close each block at its checked source-tree boundaries.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index (struct.get function first_statement))
			(let outer (struct.get function body))
			(let-mut block outer)
			(while
				(:doc "Continue through statements and leave nested blocks until the outer body ends.")
				(bool.or (i32.not-ltz index) (i32.not-eq block outer))
				(body
					(if
						(:doc "End every checked block, including terminal or empty ones.")
						(i32.ltz index)
						(then
							(let exit (call after_block (borrow-shared source) (borrow-shared nodes) block))
							(let arm (array.load statements block))
							(let entry (array.load statements (struct.get exit owner)))
							(let boundary (call iterator_owner_boundary (borrow-shared nodes) entry))
							(let matched (u32.eq (struct.get entry kind) match_statement))
							(if
								(:doc "Fallthrough releases the block's owners. Explicit exits clean up their own scopes.")
								(struct.get arm falls_through)
								(then (set cursor (call write_cleanup
									(borrow-shared source) (borrow-shared nodes) (borrow-shared statements) (borrow-shared records)
									(struct.get arm previous_owner) boundary
									-1i32 -1i32 (struct.get function name_base)
									(borrow-mut output) cursor name_prefix writing))))
							(if
								(:doc "A continuing case exits the switch after releasing its locals.")
								(bool.and matched (struct.get arm falls_through))
								(then (set cursor (call c_literal_text (borrow-shared c_case_break)
									(borrow-mut output) cursor writing))))
							(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
							(let alternate (struct.get exit alternate))
							(if
								(:doc "Open the next case or else block, or finish the enclosing control statement.")
								(i32.ltz alternate)
								(then
									(if
										(:doc "Finish the switch using the final case's fallback status.")
										matched
										(then (set cursor (call close_match_switch arm
											(borrow-mut output) cursor writing))))
									(if
										(:doc "Close the scope holding the captured iterator before exposing a break destination.")
										(u32.eq (struct.get entry kind) for_statement)
										(then
											(set cursor (call write_cleanup (borrow-shared source) (borrow-shared nodes)
												(borrow-shared statements) (borrow-shared records)
												boundary (struct.get entry previous_owner) -1i32 -1i32 (struct.get function name_base)
												(borrow-mut output) cursor name_prefix writing))
											(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))))
									(if
										(:doc "Emit a destination after a loop targeted by any written break.")
										(call defines_break_label entry)
										(then
											(set cursor (call write_loop_label (borrow-shared nodes) (struct.get exit owner) (borrow-mut output) cursor name_prefix writing))
											(set cursor (call c_literal_text (borrow-shared c_loop_label_end)
												(borrow-mut output) cursor writing))))
									(set block (struct.get exit block))
									(set index (struct.get exit statement)))
								(else
									(if
										(:doc "A following case has its own label and scope, while an if opens an else.")
										matched
										(then
											(let next (array.load statements alternate))
											(set cursor (call write_case_entry (borrow-shared source) (borrow-shared nodes)
												(borrow-shared records) (borrow-shared statements) (borrow-shared expressions) next
												(struct.get entry type) (struct.get exit owner) (struct.get function name_base)
												(borrow-mut output) cursor name_prefix writing)))
										(else (set cursor (call c_text_fragment
											(borrow-mut output) cursor 7u32 writing))))
									(set block alternate)
									(set index (struct.get (array.load statements block) first)))))
						(else
							(let statement (array.load statements index))
							(set cursor (call write_statement (borrow-shared source) (borrow-shared nodes)
								index function
								(borrow-shared functions) (borrow-shared parameters)
								(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
								(borrow-mut output) cursor name_prefix writing))
							(let first (struct.get statement first))
							(if
								(:doc "An if or while has a nested block. Other statements continue with their siblings.")
								(i32.ltz first)
								(then (set index (call skip_disabled_siblings (borrow-shared source)
									(borrow-shared nodes) (struct.get (array.load nodes index) next_sibling))))
								(else
									(set block first)
									(set index (struct.get (array.load statements block) first))))))))
			(let end (array.load statements outer))
			(if
				(:doc "Completing a void body also releases its outermost scope.")
				(struct.get end falls_through)
				(then (set cursor (call write_cleanup
					(borrow-shared source) (borrow-shared nodes) (borrow-shared statements) (borrow-shared records)
					(struct.get end previous_owner) -1i32 -1i32 -1i32 (struct.get function name_base)
					(borrow-mut output) cursor name_prefix writing))))
			(return cursor)))

	(fn write_host_wrapper
		(:doc "Bind the host C entry to the checked single-vector Wove body.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let cursor (call open_host_entry (borrow-mut output) offset writing))
			(let entry (call write_function_name (borrow-shared source) (borrow-shared nodes)
				function (borrow-mut output) cursor name_prefix writing))
			(let close (call c_byte (borrow-mut output) entry 41u8 writing))
			(return (call c_byte (borrow-mut output) close 10u8 writing))))

	(fn write_definition
		(:doc `Write a checked function definition and its statements in source order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression)) (output (mut-array u8)) (offset u32) (private_helpers bool) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_signature (borrow-shared source) (borrow-shared nodes)
				function (borrow-shared parameters) (borrow-shared records) (bool false) private_helpers
				(borrow-mut output) offset name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(let-mut index (struct.get function params))
			(let limit (i32.add index (struct.get function arity)))
			(while
				(:doc "Scalar parameters can be unused. Emit a standard C void cast to suppress that warning.")
				(i32.lt index limit)
				(body
					(set cursor (call c_text_fragment (borrow-mut output) cursor 4u32 writing))
					(set cursor (call write_formal_slot (borrow-shared source)
						(borrow-shared nodes) (array.load parameters index)
						(borrow-shared records) (struct.get function name_base)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
					(set index (i32.inc index))))
			(set cursor (call write_body (borrow-shared source) (borrow-shared nodes)
				function (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))
			(if
				(:doc "The application entry receives the host ABI wrapper.")
				(struct.get function entry)
				(then (return (call write_host_wrapper (borrow-shared source) (borrow-shared nodes)
					function (borrow-mut output) cursor name_prefix writing))))
			(return cursor)))

	(fn uses_runtime
		(:doc `Detect whether a checked expression or a signature needs the shared C runtime.`)
		(params (expressions (shared-array ScalarExpression)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Runtime expressions can occur in any selected body or nested operand.")
				(i32.lt index (array.len expressions))
				(body
					(let value (array.load expressions index))
					(if
						(:doc "The runtime ABI supplies checked operations and the owned array result type.")
						(bool.or (bool.or (call is_runtime_operation (struct.get value kind))
							(bool.or (call is_checked_integer_operator (struct.get value kind))
								(u32.eq (struct.get value kind) 60u32)))
							(bool.or (bool.or (call is_worker_owner (struct.get value type))
								(bool.or (call is_array_owner (struct.get value type))
									(call is_optional_owner (struct.get value type))))
								(bool.and (u32.eq (struct.get value kind) 62u32)
									(u32.eq (struct.get value type) 34u32))))
						(then (return (bool true))))
					(set index (i32.inc index))))
			(set index 0i32)
			(while
				(:doc "Array formals need their runtime ABI even when the body ignores them.")
				(i32.lt index (array.len parameters))
				(body
					(let type (struct.get (array.load parameters index) type))
					(if
						(:doc "Both borrowed views and transferred owners use runtime descriptors.")
						(bool.or (call is_readable_slice type) (call is_array_owner type))
						(then (return (bool true))))
					(set index (i32.inc index))))
			(set index 0i32)
			(while
				(:doc "Owning and scoped record layouts use runtime array types even when never constructed.")
				(i32.lt index (array.len records))
				(body
					(let layout (array.load records index))
					(if (i32.eqz (struct.get layout name)) (then (return (bool false))))
					(if (bool.or (struct.get layout owns_arrays) (struct.get layout borrows_bytes))
						(then (return (bool true))))
					(set index (i32.inc index))))
			(return (bool false))))

	(let c_bitint_check `#ifndef WVRT_HAS_INT256
#error "Wove generated C requires C23 _BitInt(256)"
#else
_Static_assert(sizeof(wvrt_i256) == 32 && sizeof(wvrt_u256) == 32, "Wove requires 32-byte _BitInt(256)");
#endif
`)

	(struct ProgramRuntime (fields (needed bool) (bit_integer bool)))

	(fn program_runtime
		(:doc "Identify the implicit runtime header and wide integer assertion from the checked program.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression)))
		(returns ProgramRuntime)
		(body
			(let bit_integer (i32.not-ltz (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared records) i256_type)))
			(let needed (bool.or (bool.or bit_integer
					(call uses_runtime (borrow-shared expressions) (borrow-shared parameters) (borrow-shared records)))
				(bool.or (i32.not-ltz (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
					(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared records) i128_type))
					(i32.not-ltz (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
						(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
						(borrow-shared functions) (borrow-shared parameters) (borrow-shared records) f128_type)))))
			(return (struct.new ProgramRuntime (needed needed) (bit_integer bit_integer)))))

	(fn write_program_preamble
		(:doc `Write the shared types, ownership helpers, bindings, and prototypes from the checked plan.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (has_stdint bool) (has_runtime bool) (private_helpers bool)
			(binding_mode u8) (worker_mode u8) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let count (call checked_function_count (borrow-shared functions)))
			(let has_records (bool.and (i32.gtz (array.len records))
				(i32.not-eqz (struct.get (array.load records 0i32) name))))
			(let runtime (call program_runtime (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)))
			(if
				(:doc "Even an unused callable prototype can need a wide runtime typedef.")
				(struct.get runtime needed)
				(then
					(if
						(:doc "A selected bridge include can already provide the runtime header.")
						(bool.not has_runtime)
						(then (set cursor (call write_runtime_header (borrow-mut output) cursor writing)))))
				(else
					(if
						(:doc "Use a fixed-width header if the selected program needs it and no header already supplies it.")
						(bool.and (bool.not has_stdint)
							(bool.or (bool.or has_records (call has_c_values (borrow-shared statements)))
								(i32.gtz count)))
						(then (set cursor
							(call c_text_fragment (borrow-mut output) cursor 0u32 writing))))))
			(if
				(:doc "Retained C verifies the shared 256-bit ABI only when the checked plan needs it.")
				(struct.get runtime bit_integer)
				(then (set cursor (call c_literal_text (borrow-shared c_bitint_check)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_record_layouts (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_owning_layout_helpers (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_module_bindings (borrow-shared source) (borrow-shared nodes)
				(borrow-shared statements) (borrow-shared expressions) (borrow-shared records) binding_mode
				(borrow-mut output) cursor name_prefix writing))
			(let-mut index 0i32)
			(while
				(:doc "Forward-declare local helpers before emitting the bodies in source order.")
				(i32.lt index count)
				(body
					(let function (array.load functions index))
					(if
						(:doc "Local helpers need a prototype. The entry and bridge declarations have their own ABI.")
						(bool.and (bool.not (struct.get function entry))
							(i32.not-ltz (struct.get function body)))
						(then
							(set cursor (call write_signature (borrow-shared source) (borrow-shared nodes)
								function (borrow-shared parameters) (borrow-shared records) (bool true) private_helpers
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
							(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))))
					(if
						(:doc "Check fixed operands that rely on the selected native header.")
						(struct.get function c_fixed)
						(then (set cursor (call write_fixed_c_checks (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (struct.get function c_formals)
							(borrow-mut output) cursor name_prefix writing))))
					(if
						(:doc "Verify complete prototypes for checked C adapters and exact native types.")
						(bool.or (bool.or (bool.or (call is_optional_record_borrow (struct.get function result))
									(bool.or (i32.not-ltz (struct.get function c_snapshot_record))
										(bool.or (i32.not-ltz (struct.get function return_scratch))
											(call is_record_input function))))
								(bool.or (bool.or (struct.get function c_void_pointer)
									(call native_nullable_needs_prototype (borrow-shared parameters) function))
									(bool.or
										(bool.or (struct.get function c_handle_out) (i32.gtz (struct.get function c_variadic)))
										(bool.or (call native_static_strings (borrow-shared parameters) function)
												(call native_sync_callbacks (borrow-shared parameters) function)))))
							(bool.or
								(bool.and (struct.get function c_fixed)
									(call fixed_c_needs_prototype (borrow-shared source) (borrow-shared nodes)
										(struct.get function c_formals)))
								(bool.or (call native_owner_needs_prototype (borrow-shared source) (borrow-shared nodes)
										(borrow-shared parameters) function)
									(call native_long_double_needs_prototype (borrow-shared records)
										(borrow-shared parameters) function))))
						(then (set cursor (call write_c_prototype_check (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (borrow-shared parameters) function
							(borrow-mut output) cursor name_prefix writing))))
					(set index (i32.inc index))))
			(set cursor (call write_callback_adapters (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared expressions)
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_worker_adapters (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared functions) (borrow-shared expressions)
				worker_mode (borrow-mut output) cursor name_prefix writing))
			(return cursor)))

	(fn write_program_bodies
		(:doc "Write a range of definitions in checked row order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(first i32) (stop i32) (output (mut-array u8)) (offset u32)
			(private_helpers bool) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index first)
			(while
				(:doc "Every selected declaration receives one definition with the verified signature.")
				(i32.lt index stop)
				(body
					(let function (array.load functions index))
					(if
						(:doc "Foreign declarations have no definition in Wove.")
						(i32.not-ltz (struct.get function body))
						(then
							(set cursor (call write_definition (borrow-shared source) (borrow-shared nodes)
								function (borrow-shared functions)
								(borrow-shared parameters) (borrow-shared statements)
								(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
								(borrow-mut output) cursor private_helpers name_prefix writing))))
					(set index (i32.inc index))))
			(return cursor)))

	(fn write_translation_unit
		(:doc "Measure or write the complete serial program with the same preamble and body writers.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (has_stdint bool) (has_runtime bool) (private_helpers bool) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let preamble (call write_program_preamble (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) offset has_stdint has_runtime private_helpers static_module_bindings
				static_worker_adapters name_prefix writing))
			(return (call write_program_bodies (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions) 0i32 (call checked_function_count (borrow-shared functions))
				(borrow-mut output) preamble private_helpers name_prefix writing))))

	(fn emit_result
		(:doc `Return a count and originating byte span from C emission.`)
		(params (written i32) (start i32) (end i32) (error u32))
		(returns EmitResult)
		(body
			(return (struct.new EmitResult (written written) (error error)
				(start start) (end end) (related_start -1i32) (related_end -1i32)))))

	(fn emit_module
		(:doc `Check, measure, and emit the selected scalar program into the supplied output view.

		Keep source diagnostics intact and check the entire translation unit's
		capacity before writing. Failure leaves the destination untouched.
		In collect mode, return checked embed requests for the caller's loader
		instead of C. Otherwise the source arena includes any bound asset bytes.`)
		(:expect
			(tests "stage-2/source_compilations.tsv")
			(issues
				"gh:wove-lang/wove:67" "gh:wove-lang/wove:69" "gh:wove-lang/wove:72"
				"gh:wove-lang/wove:73" "gh:wove-lang/wove:74" "gh:wove-lang/wove:75"
				"gh:wove-lang/wove:77" "gh:wove-lang/wove:79" "gh:wove-lang/wove:83"
				"gh:wove-lang/wove:85" "gh:wove-lang/wove:90" "gh:wove-lang/wove:104"
				"gh:wove-lang/wove:107" "gh:wove-lang/wove:110" "gh:wove-lang/wove:113"
				"gh:wove-lang/wove:115" "gh:wove-lang/wove:125" "gh:wove-lang/wove:127"
				"gh:wove-lang/wove:130" "gh:wove-lang/wove:133" "gh:wove-lang/wove:134"
				"gh:wove-lang/wove:159"))
		(params (source (shared-array u8)) (nodes (mut-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (file i32) (view_start i32)
			(assets (mut-array EmbedAsset)) (collect bool) (output (mut-array u8)))
		(returns EmitResult)
		(body
			(let start (struct.get module start))
			(let end (struct.get module end))
			(let error (struct.get module error))
			(if
				(:doc "Forward earlier tree or module errors unchanged.")
				(u32.gtz error)
				(then (return (call emit_result 0i32 start end error))))
			(let count (struct.get module count))
			(if
				(:doc "An active module needs an ABI entry.")
				(bool.or (bool.not (struct.get module active)) (i32.eqz count))
				(then (return (call emit_result 0i32 start end 22u32))))
			(let function_count (call count_declarations (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) count 1u32))
			(let-mut records (array.alloc ScalarRecord (array.len nodes)))
			(let-mut functions (array.alloc ScalarFunction function_count))
			(let-mut parameters (array.alloc ScalarParameter (array.len nodes)))
			(let-mut bindings (array.alloc GraphBinding count))
			(let names (call collect_standalone_bindings (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) count file (borrow-mut bindings)))
			(if
				(:doc "Keep the defining span if a selected local name cannot enter the namespace.")
				(u32.gtz (struct.get names error))
				(then (return (call emit_result 0i32 (struct.get names start) (struct.get names end) (struct.get names error)))))
			(let-mut statements (array.alloc ScalarStatement (array.len nodes)))
			(let-mut expressions (array.alloc ScalarExpression (array.len nodes)))
			(let signatures (call read_module_declarations (borrow-shared source) (borrow-shared nodes) module
				(borrow-shared declarations) (borrow-mut functions) (borrow-mut parameters) (borrow-mut records)
				(borrow-mut bindings) file (bool true)
				(borrow-mut statements) (borrow-mut expressions)))
			(if
				(:doc "Signature and binding failures precede any C emission.")
				(u32.gtz (struct.get signatures error))
				(then (return (call emit_result 0i32 (struct.get signatures start)
					(struct.get signatures end) (struct.get signatures error)))))
			(let-mut sites (array.alloc CallSite (array.len nodes)))
			(let checked (call plan_bodies (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings)
				(borrow-mut records) (borrow-mut statements) (borrow-mut expressions)
				(borrow-mut sites) view_start))
			(if
				(:doc "Preserve the primary span and any related transfer from body checking.")
				(u32.gtz (struct.get checked error))
				(then (return (struct.new EmitResult (written 0i32)
					(start (struct.get checked start)) (end (struct.get checked end))
					(error (struct.get checked error))
					(related_start (struct.get checked related_start)) (related_end (struct.get checked related_end))))))
			(if
				(:doc "The native host collects paths after body checks and before performing file I/O.")
				collect
				(then
					(if
						(:doc "The request table is indexed by expression row and needs the same extent.")
						(i32.lt (array.len assets) (array.len nodes))
						(then (return (call emit_result 0i32 start end 16u32))))
					(return (call emit_result
						(call request_module_embeds (borrow-shared expressions) (borrow-mut assets))
						start end 0u32))))
			(let embedded (call bind_module_embeds (array.len source)
				(borrow-shared assets) (borrow-mut expressions)))
			(if
				(:doc "Keep an unavailable asset at its literal operand.")
				(u32.gtz (struct.get embedded error))
				(then (return (call emit_result 0i32 (struct.get embedded start)
					(struct.get embedded end) (struct.get embedded error)))))
			(let files (array.alloc SuppliedFile 0i32))
			(let instances (array.alloc FunctionInstance 0i32))
			(call assign_c_names (borrow-shared source) (borrow-shared files) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared instances) function_count
				(borrow-mut functions) function_count (borrow-mut records) (borrow-mut expressions))
			(call assign_local_c_names (borrow-shared source) (borrow-mut nodes)
				(borrow-shared functions) (borrow-shared statements))
			(call assign_callback_names (borrow-shared source) (borrow-shared files) (borrow-mut nodes)
				(borrow-shared functions) (borrow-shared expressions))
			(let measured (call write_translation_unit (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) 0u32 (bool false) (bool false) (bool false) 0i32 (bool false)))
			(if
				(:doc "A short destination reports the entry span and keeps every output byte intact.")
				(u32.lt (u32.from-i32 (array.len output)) measured)
				(then
					(let entry (array.load nodes
						(struct.get signatures operand)))
					(return (call emit_result 0i32 (struct.get entry start) (struct.get entry end) 16u32))))
			(let written (call write_translation_unit (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) 0u32 (bool false) (bool false) (bool false) 0i32 (bool true)))
			(return (call emit_result (i32.from-u32 written) start end 0u32)))))
