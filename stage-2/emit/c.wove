(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a complete C translation unit for checked local scalar functions.

	Keep main on the C ABI and generate stable internal symbols for other
	selected declarations. Resolve calls and bindings in the source plan
	before measuring or writing any C text.`)
	emit_c

	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../scalar/flow.wove" (only after_block (type ScalarStatement)))
	(use wove-file "../scalar/plan.wove"
		(only read_functions plan_bodies (type ScalarFunction) (type ScalarParameter) (type ScalarExpression) (type CallSite)))
	(use wove-file "../scalar/syntax.wove" (only scalar_operator is_byte_view_type is_reborrow_keyword (type ScalarOperator)))
	(use wove-file "./runtime.wove"
		(only write_runtime_header open_conversion open_slice_access open_shared_projection write_slice_length close_runtime_call
			open_array_allocation open_array_drop open_array_borrow))
	(use wove-file "./text.wove" (only c_byte c_text_fragment c_type_text c_cast c_u64_cast c_i32_bias write_c_name c_decimal_digits
			function_name_role parameter_name_role local_name_role temporary_name_role))

	(struct EmitResult
		(fields (written i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(fn
		(:doc `Write the ABI entry or a stable name from a defining function row.`)
		write_function_name
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function ScalarFunction)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The runtime calls the entry by its conventional C name.")
				(record.get (local function) entry)
				(then (return (call c_text_fragment (borrow-mut (local output)) (local offset) (u32 1) (local writing)))))
			(let name (slice.load (local nodes) (record.get (local function) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call function_name_role)
				(record.get (local function) identity) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn
		(:doc `Write the parameter name in its C function scope.

		Its ordinal is local to the signature and keeps distinct parameters
		separate even when their readable suffixes sanitize identically.`)
		write_parameter_name
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (param ScalarParameter)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (record.get (local param) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call parameter_name_role)
				(int.convert u32 (record.get (local param) position)) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn
		(:doc `Write a local's name from its original source row and spelling.`)
		write_local_name
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (local index)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call local_name_role)
				(int.convert u32 (i32.sub.wrapping (local index) (local tree_base))) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn
		(:doc `Write one checked leaf as a literal, binding reference, or slice reborrow.`)
		write_scalar
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-slice ScalarParameter)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let kind (record.get (local row) kind))
			(if
				(:doc "A range loan passes the descriptor already evaluated by its child projection.")
				(u32.eq (local kind) (u32 45))
				(then (return (call write_temporary_name (borrow-shared (local source))
					(record.get (local row) first) (local tree_base) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "An explicit array borrow projects the owner's pointer without allocating.")
				(record.get (local row) borrowed_owner)
				(then
					(let open (call open_array_borrow (borrow-mut (local output)) (local offset)
						(u32.eq (local kind) (u32 39)) (local writing)))
					(let value (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(record.get (local row) target) (local tree_base) (borrow-mut (local output)) (local open) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local value) (u8 41) (local writing)))))
			(if
				(:doc "Parameter references and whole-view reborrows read the same formal descriptor.")
				(bool.or (u32.eq (local kind) (u32 2)) (call is_reborrow_keyword (local kind)))
				(then
					(let parameter (slice.load (local parameters) (record.get (local row) target)))
					(let projection (bool.and (u32.eq (record.get (local row) type) (u32 34))
						(u32.eq (record.get (local parameter) type) (u32 38))))
					(let-mut cursor (local offset))
					(if
						(:doc "A shared use of a mutable view projects the descriptor without touching the backing bytes.")
						(local projection)
						(then (set (local cursor) (call open_shared_projection (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local cursor) (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local parameter) (borrow-mut (local output)) (local cursor) (local writing)))
					(if
						(:doc "Finish the shared projection when it was opened.")
						(local projection)
						(then (return (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))
					(return (local cursor))))
			(if
				(:doc "Read the generated name of the checked local declaration.")
				(u32.eq (local kind) (u32 6))
				(then (return (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(record.get (local row) target) (local tree_base) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The plan represents false and true as distinct literal kinds.")
				(u32.lt (u32 3) (local kind))
				(then
					(let-mut digit (u8 48))
					(if
						(:doc "True converts exactly from the integer constant one.")
						(u32.eq (local kind) (u32 5))
						(then (set (local digit) (u8 49))))
					(return (call c_byte (borrow-mut (local output)) (local offset) (local digit) (local writing)))))
			(let-mut cursor (local offset))
			(if
				(:doc "Write the sign for a nonzero negative decimal before its digits.")
				(record.get (local row) negative)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 45) (local writing)))))
			(set (local cursor) (call c_decimal_digits (borrow-mut (local output)) (local cursor) (local writing)
				(borrow-shared (local source)) (record.get (local row) start) (record.get (local row) end)))
			(if
				(:doc "Use an unsigned C constant for u32 values, including those above INT32_MAX.")
				(u32.eq (record.get (local row) type) (u32 11))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 117) (local writing)))))
			(return (local cursor))))

	(fn
		(:doc `Use the original expression row as a unique temporary name inside the C function.`)
		write_temporary_name
		(params (source (shared-slice u8)) (index i32) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (call temporary_name_role)
				(int.convert u32 (i32.sub.wrapping (local index) (local tree_base)))
				(borrow-shared (local source)) (i32 0) (i32 0)))))

	(fn
		(:doc `Identify the checked operations that use the shared runtime ABI.`)
		(:pragma (inline always))
		is_runtime_operation
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local kind) (u32 33))
				(bool.or (u32.eq (local kind) (u32 36))
					(bool.or (u32.eq (local kind) (u32 37))
						(bool.or (u32.eq (local kind) (u32 40))
							(bool.or (u32.eq (local kind) (u32 41)) (u32.eq (local kind) (u32 44))))))))))

	(fn
		(:doc `Identify expressions with their own evaluation step when nested in another expression.`)
		requires_value_temporary
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local kind) (u32 3))
				(bool.or (call is_runtime_operation (local kind))
					(u32.lt (u32 0) (record.get (call scalar_operator (local kind)) result)))))))

	(fn
		(:doc `Write an operator using already evaluated operands of its exact type.

		Signed arithmetic uses a wide signed bias to reduce the result and
		return it to the i32 range. Unsigned arithmetic widens to uint64_t
		before taking the low 32 bits, including on C targets with wider int.`)
		write_operator
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression)
			(operator ScalarOperator) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let symbol (record.get (local operator) symbol))
			(let result (record.get (local operator) result))
			(let signed_wrap (u32.eq (local result) (u32 5)))
			(let unsigned_wrap (u32.eq (local result) (u32 11)))
			(let first (record.get (local expression) first))
			(if
				(:doc "Negate the single checked operand with C's logical not.")
				(i32.eq (record.get (local operator) arity) (i32 1))
				(then
					(let cursor (call c_byte (borrow-mut (local output)) (local offset) (local symbol) (local writing)))
					(return (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local writing)))))
			(let second (record.get (slice.load (local nodes) (local first)) next_sibling))
			(let-mut cursor (local offset))
			(if
				(:doc "Open both casts and widen the arithmetic with the signed bias.")
				(local signed_wrap)
				(then
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) (u32 5) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) (u32 11) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(set (local cursor) (call c_i32_bias (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 43) (local writing)))))
			(if
				(:doc "Widen the left operand before C applies integer promotions to the operation.")
				(local unsigned_wrap)
				(then
					(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor) (u32 11) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(set (local cursor) (call c_u64_cast (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Equality uses two equals bytes. Both operands already have their native scalar type.")
				(u8.eq (local symbol) (u8 61))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local second) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Reduce to uint32_t before subtracting the signed bias.")
				(local signed_wrap)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 45) (local writing)))
					(set (local cursor) (call c_i32_bias (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))
			(if
				(:doc "The outer uint32_t cast reduces the unsigned result modulo 2^32.")
				(local unsigned_wrap)
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))
			(return (local cursor))))

	(fn
		(:doc `Read the descriptor length or pass the evaluated operands and original access span to the runtime.`)
		write_slice_access
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expression ScalarExpression)
			(tree_base i32) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let receiver (record.get (local expression) first))
			(let kind (record.get (local expression) kind))
			(if
				(:doc "Length reads the signed field from the evaluated descriptor.")
				(u32.eq (local kind) (u32 36))
				(then
					(let cursor (call write_temporary_name (borrow-shared (local source)) (local receiver) (local tree_base)
						(borrow-mut (local output)) (local offset) (local writing)))
					(return (call write_slice_length (borrow-mut (local output)) (local cursor) (local writing)))))
			(let index (record.get (slice.load (local nodes) (local receiver)) next_sibling))
			(let open (call open_slice_access (borrow-mut (local output)) (local offset) (local kind) (local writing)))
			(let view (call write_temporary_name (borrow-shared (local source)) (local receiver) (local tree_base)
				(borrow-mut (local output)) (local open) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local view) (u8 44) (local writing)))
			(let-mut cursor (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local comma) (local writing)))
			(if
				(:doc "Pass the store value or range end after the already evaluated index or start.")
				(bool.or (u32.eq (local kind) (u32 40)) (u32.eq (local kind) (u32 44)))
				(then
					(let third (record.get (slice.load (local nodes) (local index)) next_sibling))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local third) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(record.get (local expression) target) (record.get (local expression) start)
				(record.get (local expression) end) (local writing)))))

	(fn
		(:doc `Write a checked value using the temporaries already evaluated for its operands.`)
		write_value
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (value_index i32) (tree_base i32)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(expressions (shared-slice ScalarExpression)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let expression (slice.load (local expressions) (local value_index)))
			(let kind (record.get (local expression) kind))
			(if
				(:doc "The runtime checks the already evaluated operand and returns the exact target type.")
				(u32.eq (local kind) (u32 33))
				(then
					(let open (call open_conversion (borrow-mut (local output)) (local offset)
						(record.get (local expression) type) (local writing)))
					(let value (call write_temporary_name (borrow-shared (local source))
						(record.get (local expression) first) (local tree_base)
						(borrow-mut (local output)) (local open) (local writing)))
					(return (call close_runtime_call (borrow-mut (local output)) (local value)
						(record.get (local expression) target) (record.get (local expression) start)
						(record.get (local expression) end) (local writing)))))
			(if
				(:doc "The runtime allocates one zeroed array of the already evaluated length.")
				(u32.eq (local kind) (u32 41))
				(then
					(let open (call open_array_allocation (borrow-mut (local output)) (local offset) (local writing)))
					(let length (call write_temporary_name (borrow-shared (local source))
						(record.get (local expression) first) (local tree_base)
						(borrow-mut (local output)) (local open) (local writing)))
					(return (call close_runtime_call (borrow-mut (local output)) (local length)
						(record.get (local expression) target) (record.get (local expression) start)
						(record.get (local expression) end) (local writing)))))
			(if
				(:doc "A slice expression uses the already evaluated descriptor and any checked indices.")
				(bool.or (u32.eq (local kind) (u32 36))
					(bool.or (u32.eq (local kind) (u32 37)) (u32.eq (local kind) (u32 44))))
				(then (return (call write_slice_access (borrow-shared (local source)) (borrow-shared (local nodes))
					(local expression) (local tree_base) (borrow-mut (local output)) (local offset) (local writing)))))
			(let operator (call scalar_operator (local kind)))
			(if
				(:doc "Short-circuit evaluation has already stored the result for this value.")
				(record.get (local operator) short_circuit)
				(then (return (call write_temporary_name (borrow-shared (local source)) (local value_index) (local tree_base)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Eager operators use the temporaries for their operands.")
				(u32.lt (u32 0) (record.get (local operator) result))
				(then (return (call write_operator (borrow-shared (local source)) (borrow-shared (local nodes))
					(local expression) (local operator) (local tree_base) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Only calls need a C argument list.")
				(bool.not (u32.eq (local kind) (u32 3)))
				(then (return (call write_scalar (borrow-shared (local source)) (borrow-shared (local nodes))
					(local expression) (local tree_base) (borrow-shared (local parameters)) (borrow-mut (local output))
					(local offset) (local writing)))))
			(let callee (slice.load (local functions) (record.get (local expression) target)))
			(let-mut cursor (call write_function_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local callee) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(let first (record.get (local expression) first))
			(let-mut index (local first))
			(while
				(:doc "Read the checked arguments in order using any previously evaluated temporaries.")
				(bool.not (i32.lt (local index) (i32 0)))
				(body
					(if
						(:doc "A comma separates adjacent actual arguments.")
						(bool.not (i32.eq (local first) (local index)))
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))))
					(let row (slice.load (local expressions) (local index)))
					(if
						(:doc "Literals and bindings can be read directly without a separate evaluation step.")
						(call requires_value_temporary (record.get (local row) kind))
						(then (set (local cursor) (call write_temporary_name
							(borrow-shared (local source)) (local index) (local tree_base)
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call write_scalar
							(borrow-shared (local source)) (borrow-shared (local nodes)) (local row) (local tree_base)
							(borrow-shared (local parameters)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local index) (record.get (slice.load (local nodes) (local index)) next_sibling))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))))

	(fn
		(:doc `Begin a typed temporary declaration and leave its initializer slot open.`)
		write_temporary_declaration
		(params (source (shared-slice u8)) (index i32) (tree_base i32) (type u32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let type_end (call c_type_text (borrow-mut (local output)) (local offset) (local type) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local type_end) (u8 32) (local writing)))
			(let name_end (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local space) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name_end) (u8 61) (local writing)))))

	(fn
		(:doc `Write the branch boundary after either operand of bool.and or bool.or.

		After the left operand, initialize the result and guard evaluation
		of the right. After the right, update the result inside the guard
		and close the block. Both operands already have typed temporaries.`)
		write_short_circuit_edge
		(params (source (shared-slice u8)) (index i32) (parent i32) (tree_base i32)
			(left bool) (symbol u8) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Declare the result at the left edge. The right edge assigns the same slot.")
				(local left)
				(then
					(set (local cursor) (call write_temporary_declaration (borrow-shared (local source))
						(local parent) (local tree_base) (u32 12) (borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(set (local cursor) (call write_temporary_name (borrow-shared (local source))
						(local parent) (local tree_base) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source))
				(local index) (local tree_base) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
			(if
				(:doc "The right value is used before its guard closes.")
				(bool.not (local left))
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))))
			(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) (u32 6) (local writing)))
			(if
				(:doc "Disjunction enters the right block when the left value is false.")
				(u8.eq (local symbol) (u8 124))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 33) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source))
				(local parent) (local tree_base) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))))

	(fn
		(:doc `Evaluate nested values left to right before writing the enclosing statement.

		Traverse the original expression tree in postorder. Materialize
		nested calls and operators and each operator operand. For a
		short-circuit operator, finish the left value before opening a
		guard around the full right subtree. Even at the root, the guard
		leaves a result temporary available to the statement writer.`)
