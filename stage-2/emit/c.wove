				(then
					(let entry (array.load (local nodes)
						(struct.get (local signatures) operand)))
					(return (call emit_result 0i32 (struct.get (local entry) start) (struct.get (local entry) end) 16u32))))
			(let written (call write_translation_unit (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) 0u32 (bool false) (bool false) (bool false) 0i32 (bool true)))
			(return (call emit_result (i32.from-u32 (local written)) (local start) (local end) 0u32)))))
