(module emit_bindings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write C storage and declarations for referenced immutable module bindings.")

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../scalar/flow.wove" (only is_c_value_binding (type ScalarStatement) (value c_constant_binding)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_record_type (type ScalarRecord)))
	(use wove-file "./c_values.wove"
		(only is_borrowed_c_value is_c_integer_constant is_writable_c_integer write_c_value_contract write_c_value_name))
	(use wove-file "./runtime.wove" (only write_site_number))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./static.wove" (only write_static_initializer))
	(use wove-file "./text.wove" (only c_byte c_literal_text get_name storage_name_role c_type_text open_static_storage open_static_value write_static_bytes (type CNameParent) (type CNameSpelling)))

	(let c_extension "__extension__ ")
	(let c_const "const ")
	(let c_extern_const "extern const ")
	(let c_binding_end ";\n")
	(let c_string_backing "static const char __attribute__((unused)) ")
	(let c_string_array "[]=")
	(let c_string_limit "_Static_assert(sizeof(")
	(let c_string_limit_end ")-1<=INT32_MAX,\"Wove C byte string must fit a shared array\");\n")
	(let c_string_length ",(int32_t)__builtin_strlen(")
	(let c_string_view_end "),1};\n")

	(let static_module_bindings 0u8)
	(let declared_module_bindings 1u8)
	(let linked_module_bindings 2u8)

	(fn open_binding_storage
		(:doc "Use matching const qualifiers for the shared declaration and its unique definition.")
		(params (mode u8) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(if
				(:doc "The common header declares the binding without reserving storage.")
				(u8.eq mode declared_module_bindings)
				(then (return (call c_literal_text (borrow-shared c_extern_const)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Only the designated numbered unit defines externally linked storage.")
				(u8.eq mode linked_module_bindings)
				(then (return (call c_literal_text (borrow-shared c_const)
					(borrow-mut output) offset writing))))
			(return (call open_static_storage (borrow-mut output) offset writing))))

	(fn write_binding_name
		(:doc "Generate a private name from the defining node with separate roles for views and bytes.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (backing bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let node (array.load nodes name))
			(return (call get_name
				(struct.new CNameParent (identity (u32.from-i32 name)) (slot 0i32))
				(call storage_name_role backing)
				(struct.new CNameSpelling (start (struct.get node start)) (end (struct.get node end)) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn write_binding_bytes
		(:doc "Write the exact byte table and its shared descriptor without adding a terminator.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (bytes (shared-array u8)) (mode u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let length (array.len bytes))
			(let-mut cursor offset)
			(if
				(:doc "Keep the bytes private to the translation unit that defines their descriptor.")
				(i32.gtz length)
				(then
					(set cursor (call open_static_value (borrow-mut output) cursor 10u32 writing))
					(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
						name (bool true) (borrow-mut output) cursor name_prefix writing))
					(set cursor (call write_static_bytes (borrow-shared bytes) 0i32 length
						(borrow-mut output) cursor writing))
					(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))))
			(set cursor (call open_binding_storage mode (borrow-mut output) cursor writing))
			(set cursor (call c_type_text (borrow-mut output) cursor 34u32 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool false) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(if
				(:doc "An empty descriptor carries a null pointer and has no backing allocation.")
				(i32.eqz length)
				(then (set cursor (call c_byte (borrow-mut output) cursor 48u8 writing)))
				(else (set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
					name (bool true) (borrow-mut output) cursor name_prefix writing))))
			(set cursor (call write_site_number (borrow-mut output) cursor
				length writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 49u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
			(return (call c_byte (borrow-mut output) cursor 10u8 writing))))

	(fn write_c_string_binding
		(:doc "Initialize private static bytes from one expansion of the C string literal. Compute the view length from those same bytes.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (used bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let literal (array.load nodes name))
			(let-mut cursor (call c_literal_text (borrow-shared c_string_backing) (borrow-mut output) offset writing))
			(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool true) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared c_string_array) (borrow-mut output) cursor writing))
			(set cursor (call write_c_value_name (borrow-shared source) literal (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared c_binding_end) (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared c_string_limit) (borrow-mut output) cursor writing))
			(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool true) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared c_string_limit_end) (borrow-mut output) cursor writing))
			(if
				(:doc "Check all selected literals. Only referenced bindings need a Wove slice descriptor.")
				(bool.not used)
				(then (return cursor)))
			(set cursor (call open_static_value (borrow-mut output) cursor 34u32 writing))
			(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool false) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool true) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared c_string_length) (borrow-mut output) cursor writing))
			(set cursor (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool true) (borrow-mut output) cursor name_prefix writing))
			(return (call c_literal_text (borrow-shared c_string_view_end) (borrow-mut output) cursor writing))))

	(fn write_binding_view
		(:doc "Use the original asset bytes or the decoded bytes of a checked string literal.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (value ScalarExpression) (mode u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A bound embed already points to the exact byte range in the source arena.")
				(u32.eq (struct.get value kind) 60u32)
				(then (return (call write_binding_bytes (borrow-shared source) (borrow-shared nodes)
					name (borrow-shared (array.range source (struct.get value asset_start) (struct.get value asset_end))) mode
					(borrow-mut output) offset name_prefix writing))))
			(let start (struct.get value start))
			(let end (struct.get value end))
			(let-mut bytes (array.alloc u8 (i32.sub end start)))
			(let decoded (call decode_string (borrow-shared source)
				(struct.new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut bytes)))
			(return (call write_binding_bytes (borrow-shared source) (borrow-shared nodes)
				name (borrow-shared (array.range bytes 0i32 (struct.get decoded written))) mode
				(borrow-mut output) offset name_prefix writing))))

	(fn write_typed_binding
		(:doc "Declare or define the checked C object type. Byte views have a separate definition path.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (value i32)
			(expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (mode u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get (array.load expressions value) type))
			(let declaring (u8.eq mode declared_module_bindings))
			(let-mut start offset)
			(if
				(:doc "Clang accepts aggregate range initializers under strict flags with this qualifier.")
				(bool.and (bool.not declaring) (call is_record_type type))
				(then (set start (call c_literal_text (borrow-shared c_extension)
					(borrow-mut output) start writing))))
			(let prefix (call open_binding_storage mode (borrow-mut output) start writing))
			(let typed (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) prefix name_prefix writing))
			(let space (call c_byte (borrow-mut output) typed 32u8 writing))
			(let named (call write_binding_name (borrow-shared source) (borrow-shared nodes)
				name (bool false) (borrow-mut output) space name_prefix writing))
			(if
				(:doc "The header needs the exact object type and no initializer or backing bytes.")
				declaring
				(then (return (call c_literal_text (borrow-shared c_binding_end)
					(borrow-mut output) named writing))))
			(let equal (call c_byte (borrow-mut output) named 61u8 writing))
			(let initialized (call write_static_initializer (borrow-shared source) (borrow-shared nodes)
				(borrow-shared expressions) (borrow-shared records) value
				(borrow-mut output) equal name_prefix writing))
			(let end (call c_byte (borrow-mut output) initialized 59u8 writing))
			(return (call c_byte (borrow-mut output) end 10u8 writing))))

	(fn emits_module_storage
		(:doc "Select a checked immutable declaration that has at least one generated use.")
		(params (row ScalarStatement) (use ScalarExpression))
		(returns bool)
		(body
			(return (bool.and (u32.eq (struct.get row kind) 62u32)
				(u32.eq (struct.get use kind) 62u32)))))

	(fn write_module_bindings
		(:doc "Emit referenced module declarations or definitions in their original tree order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(records (shared-array ScalarRecord)) (mode u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index 0i32)
			(while
				(:doc "The checked declaration row and its use mark select the only C definition.")
				(i32.lt index (array.len statements))
				(body
					(let row (array.load statements index))
					(if
						(:doc "The C header supplies native values and objects. Check their types without allocating Wove storage.")
						(bool.or (bool.and (u8.eq mode static_module_bindings)
							(call is_c_value_binding (struct.get row kind)))
							(bool.and (u8.eq mode declared_module_bindings)
								(bool.or (call is_borrowed_c_value row)
									(bool.or (call is_c_integer_constant row) (call is_writable_c_integer row)))))
						(then
							(if
								(:doc "Native byte strings need one immutable view shared by every Wove alias.")
								(bool.and (u32.eq (struct.get row kind) c_constant_binding) (u32.eq (struct.get row type) 34u32))
								(then (set cursor (call write_c_string_binding (borrow-shared source) (borrow-shared nodes)
									(struct.get row target) (u32.eq (struct.get (array.load expressions index) kind) 62u32)
									(borrow-mut output) cursor name_prefix writing)))
								(else (set cursor (call write_c_value_contract (borrow-shared source) (borrow-shared nodes)
									(borrow-shared records) row (borrow-mut output) cursor name_prefix writing))))))
					(if
						(:doc "Unused immutable storage has no generated references or side effects.")
						(call emits_module_storage row (array.load expressions index))
						(then
							(let name (struct.get row target))
							(let value (array.load expressions (struct.get row value)))
							(let type (struct.get value type))
							(if
								(:doc "Only the defining unit decodes and emits the backing payload for byte views.")
								(bool.and (u32.eq type 34u32)
									(u8.not-eq mode declared_module_bindings))
								(then (set cursor (call write_binding_view (borrow-shared source)
									(borrow-shared nodes) name value mode
									(borrow-mut output) cursor name_prefix writing)))
								(else (set cursor (call write_typed_binding (borrow-shared source) (borrow-shared nodes)
									name (struct.get row value) (borrow-shared expressions) (borrow-shared records) mode
									(borrow-mut output) cursor name_prefix writing))))))
					(set index (i32.inc index))))
			(return cursor))))
