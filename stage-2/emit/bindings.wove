(module emit_bindings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write a single static C value and an exact byte table for each referenced module binding.")

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../scalar/flow.wove" (only is_c_value_binding (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "./c_values.wove" (only write_c_value_contract))
	(use wove-file "./runtime.wove" (only write_site_number))
	(use wove-file "./text.wove" (only c_byte write_c_name write_decimal_literal open_static_value write_static_bytes (type CNameRole)))

	(fn write_binding_name
		(:doc "Generate a private name from the defining node with separate roles for views and bytes.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (backing bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let node (array.load (local nodes) (local name)))
			(let-mut tag 98u8)
			(if
				(:doc "Only a byte array uses the backing storage role.")
				(local backing)
				(then (set (local tag) 97u8)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (struct.new CNameRole (tag (local tag))) (int.convert u32 (local name))
				(borrow-shared (local source)) (struct.get (local node) start) (struct.get (local node) end)))))

	(fn write_binding_bytes
		(:doc "Write the decoded table and its shared descriptor without adding a terminator.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (value ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let start (struct.get (local value) start))
			(let end (struct.get (local value) end))
			(let-mut bytes (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let decoded (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local bytes))))
			(let length (struct.get (local decoded) written))
			(let-mut cursor (local offset))
			(if
				(:doc "A nonempty view points to exactly one static table.")
				(i32.lt 0i32 (local length))
				(then
					(set (local cursor) (call open_static_value (borrow-mut (local output)) (local cursor) 10u32 (local writing)))
					(set (local cursor) (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local name) (bool true) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call write_static_bytes (borrow-shared (local bytes)) 0i32 (local length)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))))
			(set (local cursor) (call open_static_value (borrow-mut (local output)) (local cursor) 34u32 (local writing)))
			(set (local cursor) (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local name) (bool false) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 123u8 (local writing)))
			(if
				(:doc "An empty descriptor carries a null pointer and has no backing allocation.")
				(i32.eq (local length) 0i32)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 48u8 (local writing))))
				(else (set (local cursor) (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(local name) (bool true) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(let-mut digits (array.alloc u8 11i32))
			(set (local cursor) (call write_site_number (borrow-mut (local output)) (local cursor)
				(local length) (borrow-mut (local digits)) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 49u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))))

	(fn write_module_bindings
		(:doc "Emit each referenced declaration once in its original tree order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut index 0i32)
			(while
				(:doc "The checked declaration row and its use mark select the only C definition.")
				(i32.lt (local index) (array.len (local statements)))
				(body
					(let row (array.load (local statements) (local index)))
					(if
						(:doc "The C header supplies native values and objects. Check their types without allocating Wove storage.")
						(call is_c_value_binding (struct.get (local row) kind))
						(then (set (local cursor) (call write_c_value_contract (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (local row) (borrow-mut (local output))
							(local cursor) (local name_prefix) (local writing)))))
					(if
						(:doc "Unused immutable storage has no generated references or side effects.")
						(bool.and (u32.eq (struct.get (local row) kind) 62u32)
							(u32.eq (struct.get (array.load (local expressions) (local index)) kind) 62u32))
						(then
							(let name (struct.get (local row) target))
							(let value (array.load (local expressions) (struct.get (local row) value)))
							(let type (struct.get (local value) type))
							(if
								(:doc "Quoted strings use a shared byte view and integers keep their exact C type.")
								(u32.eq (local type) 34u32)
								(then (set (local cursor) (call write_binding_bytes (borrow-shared (local source))
									(borrow-shared (local nodes)) (local name) (local value)
									(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
								(else
									(set (local cursor) (call open_static_value (borrow-mut (local output))
										(local cursor) (local type) (local writing)))
									(set (local cursor) (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
										(local name) (bool false) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
									(set (local cursor) (call write_decimal_literal (borrow-shared (local source))
										(struct.get (local value) start) (struct.get (local value) end) (struct.get (local value) negative)
										(local type) (borrow-mut (local output)) (local cursor) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (local cursor)))))
