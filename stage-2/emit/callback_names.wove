(module c_callback_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve one C adapter spelling per checked native callback actual.")

	(use wove-file "../c/arguments.wove" (only (value c_adapted_callback_argument)))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_byte))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction)))
	(use wove-file "../scalar/generics/key_order.wove" (only order_definitions order_words))
	(use wove-file "../scalar/generics/workspace.wove" (only subtree_limit))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../source/generics.wove" (only hash_generic_word))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./collisions.wove" (only bucket (type Bucket)))
	(use wove-file "./names.wove" (only (value callback_adapter_role)))

	(struct CallbackName (fields (owner i32) (argument i32) (identity u32) (next i32)))

	(fn order_sites
		(:doc "Order exact adapter sites by the original definition, concrete specialization and relative argument row.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (left CallbackName) (right CallbackName)) (returns i32)
		(body
			(let a (array:load functions (struct:get left owner)))
			(let b (array:load functions (struct:get right owner)))
			(if
				(:doc `Order distinct concrete owners deterministically.
				When instances of one template share a fingerprint, their existing
				C name slots order the exact specialization keys.`)
				(i32:not-eq (struct:get left owner) (struct:get right owner))
				(then
					(let definition (call order_definitions (borrow-shared source) (borrow-shared files) (borrow-shared nodes)
						(struct:get a file) (struct:get a origin) (struct:get b file) (struct:get b origin)))
					(if (i32:not-eqz definition) (then (return definition)))
					(let fingerprint (call order_words (struct:get a identity) (struct:get b identity)))
					(if (i32:not-eqz fingerprint) (then (return fingerprint)))
					(return (i32:sub (struct:get a c_name_slot) (struct:get b c_name_slot)))))
			(return (i32:sub (struct:get left argument) (struct:get right argument)))))

	(fn adapter_slot
		(:doc "Rank distinct actuals with the same full C spelling. An adapter's role and empty suffix are fixed.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (names (shared-array CallbackName)) (name CallbackName) (head i32))
		(returns i32)
		(body
			(let-mut cursor head)
			(let-mut count 0i32)
			(let-mut slot 1i32)
			(while
				(:doc "A bucket's fingerprint filters candidates. Each flattened argument belongs to exactly one concrete body.")
				(i32:gtz cursor)
				(body
					(let other (array:load names (i32:dec cursor)))
					(if
						(:doc "A different exact argument with equal fingerprint needs a separate file-scope C name.")
						(bool:and (i32:not-eq (struct:get other argument) (struct:get name argument))
							(u32:eq (struct:get other identity) (struct:get name identity)))
						(then
							(set count (i32:inc count))
							(if
								(:doc "Count only exact keys that precede this one in stable order.")
								(i32:ltz (call order_sites (borrow-shared source) (borrow-shared files)
									(borrow-shared nodes) (borrow-shared functions) other name))
								(then (set slot (i32:inc slot))))))
					(set cursor (struct:get other next))))
			(if (i32:gtz count) (then (return slot)))
			(return 0i32)))

	(fn with_adapter_name
		(:doc "An adapted callback is passed by adapter address, so its row needs no C value temporary.")
		(params (node SourceNode) (identity u32) (slot i32)) (returns SourceNode)
		(body (return (struct:new SourceNode
			(kind (struct:get node kind)) (start (struct:get node start)) (end (struct:get node end))
			(parent (struct:get node parent)) (first_child (struct:get node first_child))
			(next_sibling (struct:get node next_sibling)) (bridge_project (struct:get node bridge_project))
			(bridge_default (struct:get node bridge_default)) (generic_kind (struct:get node generic_kind))
			(generic_value (struct:get node generic_value)) (local_identity (struct:get node local_identity))
			(local_name_slot (struct:get node local_name_slot)) (expression_identity identity) (expression_slot slot)
			(label_identity (struct:get node label_identity)) (label_slot (struct:get node label_slot))))))

	(fn collect_sites
		(:doc "Index adapters by concrete owner and function-relative actual, including separately checked template instances.")
		(params (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(expressions (shared-array ScalarExpression)) (buckets (mut-array Bucket)) (names (mut-array CallbackName)))
		(returns void)
		(body
			(let function_count (call checked_function_count (borrow-shared functions)))
			(let-mut owner 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Every adapted actual appears within a checked Wove body. Native declarations have no body.")
				(i32:lt owner function_count)
				(body
					(let function (array:load functions owner))
					(let first (struct:get function declaration))
					(let-mut argument (struct:get function body))
					(if
						(:doc "Only selected concrete bodies contribute adapters.")
						(i32:not-ltz argument)
						(then
							(let limit (call subtree_limit (borrow-shared nodes) first (struct:get function tree_limit)))
							(let parent (call fnv1a_byte (struct:get function identity) callback_adapter_role))
							(while
								(:doc "Each exact actual retains its checked callback shape and original diagnostic operands.")
								(i32:lt argument limit)
								(body
									(if
										(:doc "Only address-only native callback actuals have a file-scope adapter.")
										(u32:eq (struct:get (array:load expressions argument) kind) c_adapted_callback_argument)
										(then
											(let identity (call hash_generic_word parent (u32:from-i32 (i32:sub argument first))))
											(let chain (call bucket identity (array:len buckets)))
											(array:store names index (struct:new CallbackName (owner owner) (argument argument)
												(identity identity) (next (struct:get (array:load buckets chain) head))))
											(array:store buckets chain (struct:new Bucket (head (i32:inc index))))
											(set index (i32:inc index))))
									(set argument (i32:inc argument))))))
					(set owner (i32:inc owner))))))

	(fn assign_callback_names
		(:doc "Cache resolved native callback names before measuring or writing any C definitions or references.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (mut-array SourceNode))
			(functions (shared-array ScalarFunction)) (expressions (shared-array ScalarExpression))) (returns void)
		(body
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Graphs without native callback actuals require no adapter table.")
				(i32:lt index (array:len expressions))
				(body
					(if
						(:doc "Only adapted actuals require a table entry.")
						(u32:eq (struct:get (array:load expressions index) kind) c_adapted_callback_argument)
						(then (set count (i32:inc count))))
					(set index (i32:inc index))))
			(if (i32:eqz count) (then (return)))
			(let-mut width 1i32)
			(while
				(:doc "Use a power-of-two bucket table without overflowing i32.")
				(bool:and (i32:lt width count) (i32:lt width 536870912i32))
				(body (set width (i32:add width width))))
			(let-mut buckets (array:alloc Bucket width))
			(let-mut names (array:alloc CallbackName count))
			(call collect_sites (borrow-shared nodes) (borrow-shared functions) (borrow-shared expressions)
				(borrow-mut buckets) (borrow-mut names))
			(set index 0i32)
			(while
				(:doc "The definition and every native use load the same resolved spelling from the actual's source node.")
				(i32:lt index count)
				(body
					(let name (array:load names index))
					(let identity (struct:get name identity))
					(let head (struct:get (array:load buckets (call bucket identity width)) head))
					(let slot (call adapter_slot (borrow-shared source) (borrow-shared files) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared names) name head))
					(let argument (struct:get name argument))
					(array:store nodes argument (call with_adapter_name (array:load nodes argument) identity slot))
					(set index (i32:inc index))))))
)
