			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 48u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))))

	(fn write_native_field_checks
		(:doc `Use C11 type selection to verify the header member names and compatible types without evaluating an access.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let repr (array.load (local nodes) (struct.get (local layout) native)))
			(let-mut field (struct.get (local layout) first))
			(let-mut cursor (local offset))
			(while
				(:doc "Each exposed member is checked against the representation chosen by the header.")
				(i32.lt -1i32 (local field))
				(body
					(let node (array.load (local nodes) (local field)))
					(let name (array.load (local nodes) (struct.get (local node) first_child)))
					(let type (call native_field_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local layout) (local field)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_member_check_open)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_native_type (borrow-shared (local source)) (local repr)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_member_check_access)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_span (borrow-shared (local source)) (struct.get (local name) start)
						(struct.get (local name) end) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_member_check_close)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local field) (struct.get (local node) next_sibling))))
			(return (local cursor))))

	(fn write_fixed_array_layout
		(:doc `Write the archive's inline array wrapper or its aligned zero-extent placeholder.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let extent (struct.get (local layout) count))
			(let element (u32.from-i32 (struct.get (local layout) first)))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_array_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "Keep empty arrays aligned without declaring a zero-length C array.")
				(i32.eqz (local extent))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local c_alignas)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local element)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_alignas_end)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_alignas)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local element)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_pointer_alignas_end)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local element)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_pointer_items)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local element)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_array_items)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor) (local extent) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_array_close)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local layout) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_layout_end))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_payload_enum_layout
		(:doc `Emit one discriminant and a union of the variant payloads in nominal order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local c_payload_enum_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let-mut variant (struct.get (local layout) first))
			(let-mut ordinal 0i32)
			(while
				(:doc "Unit variants consume an ordinal without adding a union member.")
				(i32.lt (local ordinal) (struct.get (local layout) count))
				(body
					(let member (array.load (local nodes) (local variant)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
					(if
						(:doc "The payload's defining layout precedes this enum in the emitted unit.")
						(u32.gtz (local type))
						(then (set (local cursor) (call write_member_declaration (borrow-shared (local source))
							(borrow-shared (local nodes)) (borrow-shared (local records)) (local type) (local ordinal)
							(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
					(set (local variant) (struct.get (local member) next_sibling))
					(set (local ordinal) (i32.inc (local ordinal)))))
			(let close (call c_literal_text (borrow-shared (local c_payload_enum_close))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(let name (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local layout) (borrow-mut (local output)) (local close) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_layout_end))
				(borrow-mut (local output)) (local name) (local writing)))))

	(fn write_value_layout
		(:doc `Emit one complete Wove value layout or native ABI assertion.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Only concrete defining layouts have C storage.")
				(bool.or (call is_owned_row_layout (local layout))
					(bool.or (call is_generic_template (local layout)) (call is_specialization_alias (local layout))))
				(then (return (local offset))))
			(if
				(:doc "A fixed array defines its inline element storage before any enclosing record.")
				(call is_fixed_array (local layout))
				(then (return (call write_fixed_array_layout (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local layout) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A payload enum stores the discriminant and the active union member by value.")
				(call is_payload_enum (local layout))
				(then (return (call write_payload_enum_layout (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "Enum layouts store exactly one signed ordinal with a named C typedef.")
				(call is_enum_layout (local layout))
				(then
					(let open (call c_literal_text (borrow-shared (local c_enum_open))
						(borrow-mut (local output)) (local offset) (local writing)))
					(let name (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local layout) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
					(return (call c_literal_text (borrow-shared (local c_layout_end))
						(borrow-mut (local output)) (local name) (local writing)))))
			(if
				(:doc "Named Wove records define their complete layout here.")
				(i32.eqz (struct.get (local layout) native))
				(then (return (call write_record_layout (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A native record verifies its exposed members against the C type.")
				(call is_native_record (local layout))
				(then (return (call write_native_field_checks (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local layout) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_integer_check (borrow-shared (local source))
				(array.load (local nodes) (struct.get (local layout) native))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_record_layouts
		(:doc `Emit the checked record layout order before function code.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut index 0i32)
			(let-mut cursor (local offset))
			(while
				(:doc "The graph uses a zero-initialized tail after the registered layouts.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let record (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local record) name)) (then (return (local cursor))))
					(let layout (array.load (local records) (struct.get (local record) emit_row)))
					(set (local cursor) (call write_value_layout (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(return (local cursor)))))
