(module emit_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render checked scalar record layouts and refer to them by stable C names.

	Definitions and member accesses share the native field ordinal.
	Type names keep the defining declaration identity across source layouts.`)

	(use wove-file "../scalar/syntax.wove" (only (value native_cstrs_type) (value buffered_cstrs_type)))
	(use wove-file "../source/slice_options.wove" (only (value optional_view_type)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/c_records.wove" (only read_c_inline_field c_pointer_field_kind (value cstrs_field_kind) (type CInlineField)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_builtin_scalar (value worker_receipt_type) (value worker_queue_type) (value worker_pool_type) (value worker_permit_type)))
	(use wove-file "../scalar/owners.wove" (only is_optional_owner))
	(use wove-file "../scalar/records.wove" (only is_callable_type callable_index is_callable_layout is_callable_alias record_index member_value_type is_generic_template is_specialization_alias is_owned_row_layout is_record_type is_enum_layout is_payload_enum is_native_integer native_integer_index is_typed_slice is_writable_slice is_array_owner
		is_fixed_array is_optional_buffered_record is_buffered_record is_optional_record_borrow optional_record_borrow_reference is_native_pointer_owner_layout is_native_record native_exact_scalar_layout (value native_long_double_count) native_field_type is_place_reference is_mutable_place_reference place_reference_target (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (value indirect_local_place) (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "./callable_types.wove" (only write_callable_name write_callable_layout))
	(use wove-file "../source/c_owners.wove" (only is_c_long_double))
	(use wove-file "./owners.wove" (only write_bridge_result_type write_native_type write_c_pointer_owner_checks))
	(use wove-file "./members.wove" (only write_member ordinal_member named_member projected_member (type CMember)))
	(use wove-file "./runtime.wove" (only open_array_layout_query write_c_number write_site_number))
	(use wove-file "./names.wove" (only (value fixed_slot_role)))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text c_type_text get_name (type CNameRole) (type CNameSpelling) record_name_role parameter_name_role fixed_array_name_role write_local_place write_local_name))

	(let c_worker_receipt "wvrt_worker_receipt*")
	(let c_worker_pool "WvrtWorkerPool*")
	(let c_worker_permit "WvrtWorkerPermit*")
	(let c_const "const ")
	(let c_member_check_open "_Static_assert(_Generic(((")
	(let c_member_check_access "*)0)->")
	(let c_member_check_close ":1,default:0),\"Wove C field type\");\n")
	(let c_enum_open "typedef int32_t ")
	(let c_payload_enum_open "typedef struct{int32_t wvrt_tag;union{")
	(let c_payload_enum_close "} wvrt_payload;} ")
	(let c_array_open "typedef struct{")
	(let c_array_items " wvrt_items[")
	(let c_array_close "];}")
	(let c_alignas "_Alignas(")
	(let c_alignas_end ") ")
	(let c_pointer_alignas_end "*) ")
	(let c_pointer_items "*wvrt_items;}")
	(let c_layout_end ";\n")

	(fn write_record_name
		(:doc `Write the stable C typedef name of a checked nominal type or fixed array.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (record ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Each structural array has one generated name in the translation unit.")
				(call is_fixed_array record)
				(then (return (call get_name
					(u32:from-i32 record/c_name_ordinal)
					(call fixed_array_name_role) (struct:new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
					(borrow-shared source) (borrow-mut output) offset name_prefix writing))))
			(let name (nodes.get record/name))
			(return (call get_name
				(u32:from-i32 record/c_name_ordinal)
				(call record_name_role)
				(struct:new CNameSpelling (start name/start) (end name/end) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn write_layout_role_name
		(:doc "Use one checked layout ordinal for the type and each private helper role.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(tag u8) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let ordinal (u32:from-i32 layout/c_name_ordinal))
			(let role (struct:new CNameRole (tag tag)))
			(if
				(:doc "A fixed array uses its structural identity and an empty suffix.")
				(call is_fixed_array layout)
				(then (return (call get_name ordinal role
					(struct:new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
					(borrow-shared source) (borrow-mut output) offset name_prefix writing))))
			(let name (nodes.get layout/name))
			(return (call get_name ordinal role
				(struct:new CNameSpelling (start name/start) (end name/end) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(let buffered_record_descriptor "wvrt_c_buffered_record")
	(let buffered_strings_descriptor "wvrt_c_buffered_strings")

	(fn write_value_type
		(:doc `Write the exact C type of a checked value, including a local record.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Function values use their canonical, fully prototyped C pointer type.")
				(call is_callable_type type)
				(then (return (call write_callable_name (borrow-shared source)
					(records.get (call callable_index type))
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "Native integers use the original C type name directly.")
				(call is_native_integer type)
				(then
					(let row (records.get (call native_integer_index type)))
					(return (call write_native_type (borrow-shared source)
						(nodes.get row/native)
						(borrow-mut output) offset writing))))
			(if
				(:doc "A caller-backed record keeps both the native pointer and the restricted scratch range.")
				(bool:or (call is_optional_buffered_record type) (call is_buffered_record type))
				(then (return (call c_literal_text (borrow-shared buffered_record_descriptor)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A buffered string table retains both its checked length and original scratch range.")
				(u32:eq type buffered_cstrs_type)
				(then (return (call c_literal_text (borrow-shared buffered_strings_descriptor)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A nullable native borrow uses the same read-only pointer representation as its present reference.")
				(call is_optional_record_borrow type)
				(then (return (call write_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (call optional_record_borrow_reference type (bool false))
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A place reference is a pointer to the exact C type with the requested access.")
				(call is_place_reference type)
				(then
					(let-mut cursor offset)
					(if
						(:doc "Use const for a shared reference to the original storage.")
						(bool:not (call is_mutable_place_reference type))
						(then (set cursor (call c_literal_text (borrow-shared c_const) (borrow-mut output) cursor writing))))
					(let target (call place_reference_target (borrow-shared records) type))
					(let end (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) target (borrow-mut output)
						cursor name_prefix writing))
					(return (call c_byte (borrow-mut output) end 42u8 writing))))
			(if
				(:doc "Native values use their full C types. Wove-defined records use generated typedefs.")
				(call is_record_type type)
				(then
					(let row (records.get (call record_index type)))
					(if
						(:doc "Use the header declaration for native records and exact scalar representations.")
						(bool:or (call is_native_record row) (i32:ltz (call native_exact_scalar_layout row)))
						(then (return (call write_native_type (borrow-shared source)
							(nodes.get row/native)
							(borrow-mut output) offset writing))))
					(return (call write_record_name (borrow-shared source) (borrow-shared nodes)
						row (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "The optional view and native string vector use the shared descriptor ABI.")
				(bool:or (u32:eq type optional_view_type) (u32:eq type native_cstrs_type))
				(then (return (call c_type_text (borrow-mut output) offset 34u32 writing))))
			(if
				(:doc "Typed slices use the descriptor ABI for their access mode.")
				(call is_typed_slice type)
				(then
					(let-mut descriptor 34u32)
					(if
						(:doc "A mutable descriptor carries a writable backing pointer.")
						(call is_writable_slice type)
						(then (set descriptor 38u32)))
					(return (call c_type_text (borrow-mut output) offset descriptor writing))))
			(if
				(:doc "A receipt owns an opaque runtime frame until it is joined or dropped.")
				(u32:eq type worker_receipt_type)
				(then (return (call c_literal_text (borrow-shared c_worker_receipt)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A pool and its reservations are distinct opaque Wove owners.")
				(u32:eq type worker_pool_type)
				(then (return (call c_literal_text (borrow-shared c_worker_pool)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A permit releases exactly one unused slot at scope exit.")
				(u32:eq type worker_permit_type)
				(then (return (call c_literal_text (borrow-shared c_worker_permit)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Owned arrays, optional array owners, and receipt queues share the array pointer ABI.")
				(bool:or (u32:eq type worker_queue_type)
					(bool:or (call is_array_owner type) (call is_optional_owner type)))
				(then (return (call c_type_text (borrow-mut output) offset 41u32 writing))))
			(return (call write_bridge_result_type (borrow-shared source) (borrow-shared nodes) type
				(borrow-mut output) offset writing))))

	(fn write_array_layout_argument
		(:doc `Append the element's native size or alignment to an allocation call.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (alignment bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let query (call open_array_layout_query (borrow-mut output) offset alignment writing))
			(let name (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) query name_prefix writing))
			(return (call c_byte (borrow-mut output) name 41u8 writing))))

	(fn write_parameter_name
		(:doc `Write the parameter's checked name in the concrete function's C scope.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (param ScalarParameter)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (nodes.get param/name))
			(return (call get_name
				param/identity
				(call parameter_name_role)
				(struct:new CNameSpelling (start name/start) (end name/end) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn write_parameter_place
		(:doc `Write a scalar parameter value, dereferencing it when it denotes a borrowed place.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (param ScalarParameter) (indirect bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "The borrowed scalar's storage resides at the formal's address.")
				indirect
				(then (set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))))
			(return (call write_parameter_name (borrow-shared source) (borrow-shared nodes)
				param (borrow-mut output) cursor name_prefix writing))))

	(fn write_member_separator
		(:doc `Select C member access for a record value or pointer to its original storage.`)
		(params (output (mut-array u8)) (offset u32) (reference bool) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A record reference uses the pointer member operator.")
				reference
				(then
					(let dash (call c_byte (borrow-mut output) offset 45u8 writing))
					(return (call c_byte (borrow-mut output) dash 62u8 writing))))
			(return (call c_byte (borrow-mut output) offset 46u8 writing))))

	(fn captures_value_argument
		(:doc `Capture mutable scalar and record values and fixed arrays before later call arguments.`)
		(params (row ScalarExpression) (next i32) (records (shared-array ScalarRecord)))
		(returns bool)
		(body
			(let type row/type)
			(let kind row/kind)
			(let writable row/mutable_place)
			(if
				(:doc "Later arguments can change a mutable local or the pointee read through a scalar formal.")
				(bool:or (i32:ltz next)
					(bool:not (bool:or (u32:eq kind 6u32) (bool:and (u32:eq kind 2u32) writable))))
				(then (return (bool false))))
			(if
				(:doc "Fixed arrays and mutable record locals retain their existing by-value capture rules.")
				(call is_record_type type)
				(then (return (bool:or writable
					(call is_fixed_array (records.get (call record_index type)))))))
			(return (bool:and writable
				(bool:or (call is_builtin_scalar type) (call is_native_integer type))))))

	(fn write_field_place
		(:doc `Write a checked Wove field path against its original binding.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(place i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut root (struct:get (expressions.get place) projection))
			(let value (expressions.get root))
			(let-mut reference (call is_place_reference value/type))
			(let-mut cursor offset)
			(if
				(:doc "A projected parameter starts at its original formal.")
				(u32:eq value/kind 2u32)
				(then
					(set cursor (call write_parameter_name (borrow-shared source) (borrow-shared nodes)
						(parameters.get value/target) (borrow-mut output)
						cursor name_prefix writing)))
				(else
					(set cursor (call write_local_place (borrow-shared source) (borrow-shared nodes)
						value/target tree_base (i32:eq value/projection indirect_local_place)
						(borrow-mut output)
						cursor name_prefix writing))))
			(while
				(:doc "Append each enclosing field along the checked path from the binding.")
				(i32:not-eq root place)
				(body
					(set root (struct:get (nodes.get root) parent))
					(set cursor (call write_member_separator (borrow-mut output) cursor
						reference writing))
					(set reference (bool false))
					(let member (call projected_member (borrow-shared nodes)
						(borrow-shared records) (borrow-shared expressions) (expressions.get root)))
					(set cursor (call write_member (borrow-shared source) member
						(borrow-mut output) cursor name_prefix writing))))
			(return cursor)))

	(fn write_place_borrow
		(:doc `Write the address of a checked place or forward its existing pointer.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(records (shared-array ScalarRecord))
			(tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let place row/projection)
			(if
				(:doc "Append the field path directly to the original binding.")
				(i32:lt -1i32 place)
				(then
					(let open (call c_byte (borrow-mut output) offset 38u8 writing))
					(return (call write_field_place (borrow-shared source) (borrow-shared nodes)
						(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records)
						place tree_base (borrow-mut output) open name_prefix writing))))
			(if
				(:doc "A local can lend its address or forward the pointer to an iteration element.")
				row/borrowed_owner
				(then
					(let-mut open offset)
					(if
						(:doc "Take the address only for a direct local binding.")
						(i32:not-eq place indirect_local_place)
						(then (set open (call c_byte (borrow-mut output) open 38u8 writing))))
					(return (call write_local_name (borrow-shared source) (borrow-shared nodes)
						row/target tree_base (borrow-mut output)
						open name_prefix writing))))
			(let parameter (parameters.get row/target))
			(let-mut cursor offset)
			(if
				(:doc "A by-value formal lends its storage. A reference formal already holds the address.")
				(bool:not (call is_place_reference parameter/type))
				(then (set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(return (call write_parameter_name (borrow-shared source) (borrow-shared nodes)
				parameter (borrow-mut output) cursor name_prefix writing))))

	(fn write_member_declaration
		(:doc `Write one scalar, fixed-array, or nested record member declaration in a Wove layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (member CMember) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type_end (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) offset name_prefix writing))
			(let space (call c_byte (borrow-mut output) type_end 32u8 writing))
			(let name_end (call write_member (borrow-shared source) member
				(borrow-mut output) space name_prefix writing))
			(return (call c_byte (borrow-mut output) name_end 59u8 writing))))

	(fn write_record_layout
		(:doc `Write a complete record typedef with fields in declaration order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (record ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 121u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 112u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 100u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 102u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(let count record/count)
			(let-mut field record/first)
			(let-mut ordinal 0i32)
			(if
				(:doc "Give an empty Wove record a single byte so its native struct is valid C11.")
				(i32:eqz count)
				(then (set cursor (call write_member_declaration (borrow-shared source)
					(borrow-shared nodes) (borrow-shared records)
					10u32 (call ordinal_member 0i32) (borrow-mut output) cursor name_prefix writing))))
			(while
				(:doc "Emit each field's checked spelling in its original storage order.")
				(i32:lt ordinal count)
				(body
					(let node (nodes.get field))
					(let type (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) record node))
					(set cursor (call write_member_declaration (borrow-shared source)
						(borrow-shared nodes) (borrow-shared records)
						type (call named_member record (nodes.get node/first_child))
						(borrow-mut output) cursor name_prefix writing))
					(set field node/next_sibling)
					(set ordinal (i32:inc ordinal))))
			(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call write_record_name (borrow-shared source) (borrow-shared nodes)
				record (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))
			(return cursor)))

	(fn write_integer_check
		(:doc `Ask C to verify that the selected native type supports integral promotion.`)
		(params (source (shared-array u8)) (literal SourceNode)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 83u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 122u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 102u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 126u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(set cursor (call write_native_type (borrow-shared source) literal
				(borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 48u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 62u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 48u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
			(return (call c_byte (borrow-mut output) cursor 10u8 writing))))

	(let c_inline_check_open "_Static_assert(_Generic(&(((")
	(let c_inline_char_open "),char (*)[")
	(let c_inline_check_message "]:1,default:0)&&_Generic((uint8_t)0,unsigned char:1,default:0),\"Wove C inline field type or extent in file ")
	(let c_inline_span_open " bytes [")
	(let c_inline_check_end ")\");\n")

	(fn write_native_inline_check
		(:doc "Check a native plain-char array's exact element type and extent at the declaring Wove operand.")
		(params (source (shared-array u8)) (repr SourceNode) (name SourceNode) (inline CInlineField)
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared c_inline_check_open) (borrow-mut output)
				offset writing))
			(let type (call write_native_type (borrow-shared source) repr
				(borrow-mut output) open writing))
			(let access (call c_literal_text (borrow-shared c_member_check_access)
				(borrow-mut output) type writing))
			(let member (call c_span (borrow-shared source) name/start
				name/end (borrow-mut output) access writing))
			(let char_array (call c_literal_text (borrow-shared c_inline_char_open)
				(borrow-mut output) member writing))
			(let extent (call write_c_number (borrow-mut output) char_array
				inline/extent writing))
			(let message (call c_literal_text (borrow-shared c_inline_check_message)
				(borrow-mut output) extent writing))
			(let file (call write_c_number (borrow-mut output) message
				layout/file writing))
			(let span (call c_literal_text (borrow-shared c_inline_span_open)
				(borrow-mut output) file writing))
			(let base layout/source_base)
			(let first (call write_c_number (borrow-mut output) span
				(i32:sub inline/start base) writing))
			(let last (call write_site_number (borrow-mut output) first
				(i32:sub inline/end base) writing))
			(return (call c_literal_text (borrow-shared c_inline_check_end)
				(borrow-mut output) last writing))))

	(let native_string_field_check "_Static_assert(WVRT_C_FIELD_IS_CSTR(")
	(let native_table_field_check "_Static_assert(WVRT_C_FIELD_IS_CSTRS(")
	(let close_native_pointer_check "),\"Wove C pointer field does not match its declared native type\");\n")

	(fn write_native_pointer_field_check
		(:doc "Check the full native pointer type without evaluating the field or relying on decay.")
		(params (source (shared-array u8)) (repr SourceNode) (member SourceNode) (kind u32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut open offset)
			(if
				(:doc "Capture char ** for a table and char * or const char * for an individual string.")
				(u32:eq kind cstrs_field_kind)
				(then (set open (call c_literal_text (borrow-shared native_table_field_check)
					(borrow-mut output) open writing)))
				(else (set open (call c_literal_text (borrow-shared native_string_field_check)
					(borrow-mut output) open writing))))
			(let type (call write_native_type (borrow-shared source) repr (borrow-mut output) open writing))
			(let comma (call c_byte (borrow-mut output) type 44u8 writing))
			(let name (call c_span (borrow-shared source) member/start member/end
				(borrow-mut output) comma writing))
			(return (call c_literal_text (borrow-shared close_native_pointer_check) (borrow-mut output) name writing))))

	(fn write_native_field_checks
		(:doc `Use C11 type selection to verify the header member names and compatible types without evaluating an access.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let repr (nodes.get layout/native))
			(let-mut field layout/first)
			(let-mut cursor offset)
			(while
				(:doc "Each exposed member is checked against the representation chosen by the header.")
				(i32:lt -1i32 field)
				(body
					(let node (nodes.get field))
					(let name (nodes.get node/first_child))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let operand (nodes.get parts/operands))
					(let pointer (call c_pointer_field_kind (borrow-shared source) operand))
					(if
						(:doc "C pointer members retain a distinct exact type check.")
						(u32:gtz pointer)
						(then (set cursor (call write_native_pointer_field_check (borrow-shared source)
							repr name pointer (borrow-mut output) cursor writing)))
						(else
							(let inline (call read_c_inline_field (borrow-shared source) (borrow-shared nodes)
								(nodes.get parts/operands)))
							(if
								(:doc "Addressing the whole inline field preserves its C array extent for the ABI assertion.")
								(i32:gtz inline/extent)
								(then (set cursor (call write_native_inline_check (borrow-shared source)
									repr name inline layout (borrow-mut output)
									cursor writing)))
								(else
									(let type (call native_field_type (borrow-shared source) (borrow-shared nodes)
										(borrow-shared records) layout field))
									(set cursor (call c_literal_text (borrow-shared c_member_check_open) (borrow-mut output) cursor writing))
									(set cursor (call write_native_type (borrow-shared source) repr
										(borrow-mut output) cursor writing))
									(set cursor (call c_literal_text (borrow-shared c_member_check_access) (borrow-mut output) cursor writing))
									(set cursor (call c_span (borrow-shared source) name/start
										name/end (borrow-mut output) cursor writing))
									(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
									(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
										(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_literal_text (borrow-shared c_member_check_close) (borrow-mut output) cursor writing))))))
					(set field node/next_sibling)))
			(return cursor)))

	(let fixed_slot_open "typedef struct{bool wvrt_live;")
	(let fixed_slot_value " wvrt_value;} ")

	(fn write_fixed_slot_name
		(:doc "Name the inline slot from its fixed-array layout ordinal.")
		(params (source (shared-array u8)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body

			(return (call get_name
				(u32:from-i32 layout/c_name_ordinal)
				(struct:new CNameRole (tag fixed_slot_role))
				(struct:new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn write_fixed_slot_type
		(:doc "Write a copyable element's type or the owning element's inline occupancy slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "An owning fixed element is always stored with its presence flag.")
				layout/owns_arrays
				(then (return (call write_fixed_slot_name (borrow-shared source)
					layout (borrow-mut output) offset name_prefix writing))))
			(return (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (u32:from-i32 layout/first)
				(borrow-mut output) offset name_prefix writing))))

	(fn write_fixed_array_layout
		(:doc `Write the archive's inline array wrapper or its aligned zero-extent placeholder.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let extent layout/count)
			(let-mut cursor offset)
			(if
				(:doc "Define the occupancy slot before its inline array uses it.")
				layout/owns_arrays
				(then
					(set cursor (call c_literal_text (borrow-shared fixed_slot_open)
						(borrow-mut output) cursor writing))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (u32:from-i32 layout/first)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared fixed_slot_value)
						(borrow-mut output) cursor writing))
					(set cursor (call write_fixed_slot_name (borrow-shared source)
						layout (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared c_layout_end)
						(borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared c_array_open)
				(borrow-mut output) cursor writing))
			(if
				(:doc "Keep empty arrays aligned without declaring a zero-length C array.")
				(i32:eqz extent)
				(then
					(set cursor (call c_literal_text (borrow-shared c_alignas) (borrow-mut output) cursor writing))
					(set cursor (call write_fixed_slot_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) layout
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared c_alignas_end) (borrow-mut output) cursor writing))
					(set cursor (call c_literal_text (borrow-shared c_alignas) (borrow-mut output) cursor writing))
					(set cursor (call write_fixed_slot_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) layout
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared c_pointer_alignas_end) (borrow-mut output) cursor writing))
					(set cursor (call write_fixed_slot_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) layout
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared c_pointer_items) (borrow-mut output) cursor writing)))
				(else
					(set cursor (call write_fixed_slot_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) layout
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared c_array_items) (borrow-mut output) cursor writing))
					(set cursor (call write_c_number (borrow-mut output) cursor extent writing))
					(set cursor (call c_literal_text (borrow-shared c_array_close) (borrow-mut output) cursor writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call write_record_name (borrow-shared source) (borrow-shared nodes)
				layout (borrow-mut output) cursor name_prefix writing))
			(return (call c_literal_text (borrow-shared c_layout_end)
				(borrow-mut output) cursor writing))))

	(fn write_payload_enum_layout
		(:doc `Emit one discriminant and a union of the variant payloads in nominal order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared c_payload_enum_open)
				(borrow-mut output) offset writing))
			(let-mut variant layout/first)
			(let-mut ordinal 0i32)
			(while
				(:doc "Unit variants consume an ordinal without adding a union member.")
				(i32:lt ordinal layout/count)
				(body
					(let member (nodes.get variant))
					(let type (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout member))
					(if
						(:doc "The payload's defining layout precedes this enum in the emitted unit.")
						(u32:gtz type)
						(then (set cursor (call write_member_declaration (borrow-shared source)
							(borrow-shared nodes) (borrow-shared records) type
							(call named_member layout (nodes.get member/first_child))
							(borrow-mut output) cursor name_prefix writing))))
					(set variant member/next_sibling)
					(set ordinal (i32:inc ordinal))))
			(let close (call c_literal_text (borrow-shared c_payload_enum_close)
				(borrow-mut output) cursor writing))
			(let name (call write_record_name (borrow-shared source) (borrow-shared nodes)
				layout (borrow-mut output) close name_prefix writing))
			(return (call c_literal_text (borrow-shared c_layout_end)
				(borrow-mut output) name writing))))

	(let c_exact_scalar_check_open "_Static_assert(_Generic((")
	(let c_long_double_check_close "*)0,long double*:1,default:0),\"Wove C typedef must name unqualified long double\");\n")

	(let c_nullptr_check_close "*)0,__typeof__(nullptr)*:1,default:0),\"Wove C typedef must name unqualified C23 nullptr_t\");\n")

	(fn write_exact_scalar_alias_check
		(:doc "Check the named type and its qualifiers without inspecting or evaluating a value.")
		(params (source (shared-array u8)) (literal SourceNode) (exact i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(if
				(:doc "The intrinsic spelling already denotes the correct C type on the selected target.")
				(bool:and (i32:eq exact native_long_double_count)
					(call is_c_long_double (borrow-shared source) literal/start literal/end))
				(then (return offset)))
			(let open (call c_literal_text (borrow-shared c_exact_scalar_check_open)
				(borrow-mut output) offset writing))
			(let type (call write_native_type (borrow-shared source) literal (borrow-mut output) open writing))
			(if
				(:doc "Use Clang's keyword type for the C23 check independently of the header's typedef spelling.")
				(i32:not-eq exact native_long_double_count)
				(then (return (call c_literal_text (borrow-shared c_nullptr_check_close)
					(borrow-mut output) type writing))))
			(return (call c_literal_text (borrow-shared c_long_double_check_close)
				(borrow-mut output) type writing))))

	(fn write_value_layout
		(:doc `Emit one complete Wove value layout or native ABI assertion.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A checked callable layout emits a function-pointer typedef.")
				(call is_callable_layout layout)
				(then (return (call write_callable_layout (borrow-shared source) (borrow-shared nodes) layout
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "Only concrete layouts emit C types. A callable alias uses its canonical typedef.")
				(bool:or (call is_owned_row_layout layout)
					(bool:or (call is_callable_alias layout)
					(bool:or (call is_generic_template layout) (call is_specialization_alias layout))))
				(then (return offset)))
			(if
				(:doc "A fixed array defines its inline element storage before any enclosing record.")
				(call is_fixed_array layout)
				(then (return (call write_fixed_array_layout (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) layout (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A payload enum stores the discriminant and the active union member by value.")
				(call is_payload_enum layout)
				(then (return (call write_payload_enum_layout (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) layout
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "Enum layouts store exactly one signed ordinal with a named C typedef.")
				(call is_enum_layout layout)
				(then
					(let open (call c_literal_text (borrow-shared c_enum_open)
						(borrow-mut output) offset writing))
					(let name (call write_record_name (borrow-shared source) (borrow-shared nodes)
						layout (borrow-mut output) open name_prefix writing))
					(return (call c_literal_text (borrow-shared c_layout_end)
						(borrow-mut output) name writing))))
			(if
				(:doc "Named Wove records define their complete layout here.")
				(i32:eqz layout/native)
				(then (return (call write_record_layout (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) layout
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A native record verifies its exposed members against the C type.")
				(call is_native_record layout)
				(then (return (call write_native_field_checks (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) layout (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "The header supplies the pointer owner type and proves any typedef contract.")
				(call is_native_pointer_owner_layout layout)
				(then (return (call write_c_pointer_owner_checks (borrow-shared source) (borrow-shared nodes)
					layout/first (borrow-mut output) offset writing))))
			(let exact (call native_exact_scalar_layout layout))
			(if
				(:doc "Clang checks the header's exact named scalar type and supplies its native layout.")
				(i32:ltz exact)
				(then (return (call write_exact_scalar_alias_check (borrow-shared source)
					(nodes.get layout/native) exact (borrow-mut output) offset writing))))
			(return (call write_integer_check (borrow-shared source)
				(nodes.get layout/native)
				(borrow-mut output) offset writing))))

	(fn write_record_layouts
		(:doc `Emit the checked record layout order before function code.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut index 0i32)
			(let-mut cursor offset)
			(while
				(:doc "The graph uses a zero-initialized tail after the registered layouts.")
				(i32:lt index records.len)
				(body
					(let record (records.get index))
					(if (i32:eqz record/name) (then (return cursor)))
					(let layout (records.get record/emit_row))
					(set cursor (call write_value_layout (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout
						(borrow-mut output) cursor name_prefix writing))
					(set index (i32:inc index))))
			(return cursor))))
