(module emit_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render checked scalar record layouts and refer to them by stable C names.

	Definitions and member accesses share the native field ordinal.
	Type names keep the defining declaration identity across source layouts.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../scalar/records.wove" (only record_index member_value_type is_record_type is_native_integer native_integer_index is_typed_slice is_writable_slice is_array_owner
		is_fixed_array is_native_record native_field_type is_record_reference is_mutable_record_reference record_reference_target (type ScalarRecord)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarExpression) (type ScalarParameter)))
	(use wove-file "./owners.wove" (only write_bridge_result_type write_native_type))
	(use wove-file "./runtime.wove" (only open_array_layout_query write_c_number))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text c_type_text write_c_name record_name_role parameter_name_role member_name_role fixed_array_name_role write_local_name))

	(let c_const "const ")
	(let c_member_check_open "_Static_assert(_Generic(((")
	(let c_member_check_access "*)0)->")
	(let c_member_check_close ":1,default:0),\"Wove C field type\");\n")
	(let c_array_open "typedef struct{")
	(let c_array_items " wvrt_items[")
	(let c_array_close "];}")
	(let c_alignas "_Alignas(")
	(let c_alignas_end ") ")
	(let c_pointer_alignas_end "*) ")
	(let c_pointer_items "*wvrt_items;}")
	(let c_layout_end ";\n")

	(fn write_record_name
		(:doc `Write the stable C typedef name of a checked record.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (record ScalarRecord)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Each structural array has one generated name in the translation unit.")
				(call is_fixed_array (local record))
				(then (return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
					(local name_prefix) (call fixed_array_name_role) (record.get (local record) identity)
					(borrow-shared (local source)) (i32 0) (i32 0)))))
			(let name (slice.load (local nodes) (record.get (local record) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (call record_name_role) (record.get (local record) identity) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn write_value_type
		(:doc `Write the exact C type of a checked value, including a local record.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(type u32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Native integers use the original C type name directly.")
				(call is_native_integer (local type))
				(then
					(let row (slice.load (local records) (call native_integer_index (local type))))
					(return (call write_native_type (borrow-shared (local source))
						(slice.load (local nodes) (record.get (local row) native))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Record references are pointers to the exact type with the requested const qualification.")
				(call is_record_reference (local type))
				(then
					(let row (slice.load (local records) (call record_index (call record_reference_target (local type)))))
					(let-mut cursor (local offset))
					(if
						(:doc "Use const for a shared reference to the complete object.")
						(bool.not (call is_mutable_record_reference (local type)))
						(then (set (local cursor) (call c_literal_text (borrow-shared (local c_const)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(if
						(:doc "Use the defining C type for bridge records and the generated typedef for ordinary Wove records.")
						(call is_native_record (local row))
						(then (set (local cursor) (call write_native_type (borrow-shared (local source))
							(slice.load (local nodes) (record.get (local row) native))
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
							(local row) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
					(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 42) (local writing)))))
			(if
				(:doc "Native values use their full C types. Wove-defined records use generated typedefs.")
				(call is_record_type (local type))
				(then
					(let row (slice.load (local records) (call record_index (local type))))
					(if
						(:doc "Using the header type preserves its alignment, padding, and private members.")
						(call is_native_record (local row))
						(then (return (call write_native_type (borrow-shared (local source))
							(slice.load (local nodes) (record.get (local row) native))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local row) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "Typed slices use the descriptor ABI for their access mode.")
				(call is_typed_slice (local type))
				(then
					(let-mut descriptor (u32 34))
					(if
						(:doc "A mutable descriptor carries a writable backing pointer.")
						(call is_writable_slice (local type))
						(then (set (local descriptor) (u32 38))))
					(return (call c_type_text (borrow-mut (local output)) (local offset) (local descriptor) (local writing)))))
			(if
				(:doc "Owners of either element type use the existing runtime array pointer.")
				(call is_array_owner (local type))
				(then (return (call c_type_text (borrow-mut (local output)) (local offset) (u32 41) (local writing)))))
			(return (call write_bridge_result_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_record_layout_argument
		(:doc `Append the defining record's native size or alignment to an allocation call.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(type u32) (alignment bool) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let query (call open_array_layout_query (borrow-mut (local output)) (local offset) (local alignment) (local writing)))
			(let name (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local query) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name) (u8 41) (local writing)))))

	(fn write_member_name
		(:doc `Write a C member name from its zero-based position in the layout.`)
		(params (source (shared-slice u8)) (ordinal i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (call member_name_role) (int.convert u32 (local ordinal)) (borrow-shared (local source)) (i32 0) (i32 0)))))

	(fn write_parameter_name
		(:doc `Write the parameter name in its C function scope.

		Its ordinal is local to the signature and keeps distinct parameters
		separate even when their readable suffixes sanitize identically.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (param ScalarParameter)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (record.get (local param) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call parameter_name_role)
				(int.convert u32 (record.get (local param) position)) (borrow-shared (local source))
				(record.get (local name) start) (record.get (local name) end)))))

	(fn write_member_separator
		(:doc `Select C member access for a record value or pointer to its original storage.`)
		(params (output (mut-slice u8)) (offset u32) (reference bool) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A record reference uses the pointer member operator.")
				(local reference)
				(then
					(let dash (call c_byte (borrow-mut (local output)) (local offset) (u8 45) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local dash) (u8 62) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local offset) (u8 46) (local writing)))))

	(fn captures_record_argument
		(:doc `Capture fixed arrays and mutable record locals before evaluating later call arguments.`)
		(params (row ScalarExpression) (next i32) (records (shared-slice ScalarRecord)))
		(returns bool)
		(body
			(let type (record.get (local row) type))
			(return (bool.and (i32.lt (i32 -1) (local next))
				(bool.and (u32.eq (record.get (local row) kind) (u32 6))
					(bool.and (call is_record_type (local type))
						(bool.or (record.get (local row) mutable_place)
							(call is_fixed_array (slice.load (local records) (call record_index (local type)))))))))))

	(fn write_field_place
		(:doc `Write a record lvalue against its original local or referenced storage.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (expressions (shared-slice ScalarExpression))
			(parameters (shared-slice ScalarParameter))
			(place i32) (tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut root (local place))
			(while
				(:doc "Find the original storage without copying any intermediate aggregate.")
				(u32.eq (record.get (slice.load (local expressions) (local root)) kind) (u32 52))
				(body
					(set (local root) (record.get (slice.load (local expressions) (local root)) first))))
			(let value (slice.load (local expressions) (local root)))
			(let-mut reference (call is_record_reference (record.get (local value) type)))
			(let-mut cursor (local offset))
			(if
				(:doc "A checked reference destination starts at the pointer parameter.")
				(local reference)
				(then
					(set (local cursor) (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local parameters) (record.get (local value) target)) (borrow-mut (local output))
						(local cursor) (local name_prefix) (local writing))))
				(else
					(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(record.get (local value) target) (local tree_base) (borrow-mut (local output))
						(local cursor) (local name_prefix) (local writing)))))
			(while
				(:doc "Append each enclosing field along the checked path from the binding.")
				(bool.not (i32.eq (local root) (local place)))
				(body
					(set (local root) (record.get (slice.load (local nodes) (local root)) parent))
					(set (local cursor) (call write_member_separator (borrow-mut (local output)) (local cursor)
						(local reference) (local writing)))
					(set (local reference) (bool false))
					(set (local cursor) (call write_member_name (borrow-shared (local source))
						(record.get (slice.load (local expressions) (local root)) target)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (local cursor))))

	(fn write_member_declaration
		(:doc `Write one scalar, fixed-array, or nested record member declaration in a Wove layout.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(type u32) (ordinal i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type_end (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local type_end) (u8 32) (local writing)))
			(let name_end (call write_member_name (borrow-shared (local source)) (local ordinal)
				(borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name_end) (u8 59) (local writing)))))

	(fn write_record_layout
		(:doc `Write a complete record typedef with fields in declaration order.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)) (record ScalarRecord)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 121) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 112) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 100) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 102) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 117) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))
			(let count (record.get (local record) count))
			(let-mut field (record.get (local record) first))
			(let-mut ordinal (i32 0))
			(if
				(:doc "Give an empty Wove record a single byte so its native struct is valid C11.")
				(i32.eq (local count) (i32 0))
				(then (set (local cursor) (call write_member_declaration (borrow-shared (local source))
					(borrow-shared (local nodes)) (borrow-shared (local records))
					(u32 10) (i32 0) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(while
				(:doc "Assign each declared member the same ordinal used at its accesses.")
				(i32.lt (local ordinal) (local count))
				(body
					(let node (slice.load (local nodes) (local field)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local record) (local node)))
					(set (local cursor) (call write_member_declaration (borrow-shared (local source))
						(borrow-shared (local nodes)) (borrow-shared (local records))
						(local type) (local ordinal) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local field) (record.get (local node) next_sibling))
					(set (local ordinal) (i32.add.wrapping (local ordinal) (i32 1)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local record) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 10) (local writing)))
			(return (local cursor))))

	(fn write_integer_check
		(:doc `Ask C to verify that the selected native type supports integral promotion.`)
		(params (source (shared-slice u8)) (literal SourceNode)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 83) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 105) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 105) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 122) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 111) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 102) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 126) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(set (local cursor) (call write_native_type (borrow-shared (local source)) (local literal)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 48) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 62) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 48) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 34) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 34) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 10) (local writing)))))

	(fn write_native_field_checks
		(:doc `Use C11 type selection to verify the header member names and compatible types without evaluating an access.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(layout ScalarRecord) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let repr (slice.load (local nodes) (record.get (local layout) native)))
			(let-mut field (record.get (local layout) first))
			(let-mut cursor (local offset))
			(while
				(:doc "Each exposed member is checked against the representation chosen by the header.")
				(i32.lt (i32 -1) (local field))
				(body
					(let node (slice.load (local nodes) (local field)))
					(let name (slice.load (local nodes) (record.get (local node) first_child)))
					(let type (call native_field_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local layout) (local field)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_member_check_open)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_native_type (borrow-shared (local source)) (local repr)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_member_check_access)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_span (borrow-shared (local source)) (record.get (local name) start)
						(record.get (local name) end) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_member_check_close)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local field) (record.get (local node) next_sibling))))
			(return (local cursor))))

	(fn write_fixed_array_layout
		(:doc `Write the archive's inline array wrapper or its aligned zero-extent placeholder.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (layout ScalarRecord)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let extent (record.get (local layout) count))
			(let element (int.convert u32 (record.get (local layout) first)))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_array_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "Keep empty arrays aligned without declaring a zero-length C array.")
				(i32.eq (local extent) (i32 0))
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local c_alignas)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (local element) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_alignas_end)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_alignas)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (local element) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_pointer_alignas_end)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (local element) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_pointer_items)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(let-mut digits (array.alloc u8 (i32 11)))
					(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (local element) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_array_items)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor) (local extent) (borrow-mut (local digits)) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_array_close)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local layout) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_layout_end))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_value_layout
		(:doc `Emit one complete Wove value layout or native ABI assertion.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding))
			(layout ScalarRecord) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A fixed array defines its inline element storage before any enclosing record.")
				(call is_fixed_array (local layout))
				(then (return (call write_fixed_array_layout (borrow-shared (local source)) (borrow-shared (local nodes))
					(local layout) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "Named Wove records define their complete layout here.")
				(i32.eq (record.get (local layout) native) (i32 0))
				(then (return (call write_record_layout (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A native record verifies its exposed members against the C type.")
				(call is_native_record (local layout))
				(then (return (call write_native_field_checks (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local layout) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_integer_check (borrow-shared (local source))
				(slice.load (local nodes) (record.get (local layout) native))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_record_layouts
		(:doc `Emit the checked record layout order before function code.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding))
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut index (i32 0))
			(let-mut cursor (local offset))
			(while
				(:doc "The graph uses a zero-initialized tail after the registered layouts.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let record (slice.load (local records) (local index)))
					(if (i32.eq (record.get (local record) name) (i32 0)) (then (return (local cursor))))
					(let layout (slice.load (local records) (record.get (local record) emit_row)))
					(set (local cursor) (call write_value_layout (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local cursor)))))
