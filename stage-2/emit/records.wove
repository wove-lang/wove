(module emit_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render checked scalar record layouts and refer to them by stable C names.

	Definitions and member accesses share the native field ordinal.
	Type names keep the defining declaration identity across source layouts.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_builtin_scalar (value worker_receipt_type)))
	(use wove-file "../scalar/owners.wove" (only is_optional_byte_owner_type))
	(use wove-file "../scalar/records.wove" (only record_index member_value_type is_generic_template is_specialization_alias is_owned_row_layout is_record_type is_enum_layout is_payload_enum is_native_integer native_integer_index is_typed_slice is_writable_slice is_array_owner
		is_fixed_array is_native_record native_field_type is_place_reference is_mutable_place_reference place_reference_target (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (value indirect_local_place) (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarParameter)))
	(use wove-file "./owners.wove" (only write_bridge_result_type write_native_type))
	(use wove-file "./runtime.wove" (only open_array_layout_query write_c_number))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text c_type_text write_c_name record_name_role parameter_name_role member_name_role fixed_array_name_role write_local_place write_local_name))

	(let c_worker_receipt "wvrt_worker_receipt*")
	(let c_const "const ")
	(let c_member_check_open "_Static_assert(_Generic(((")
	(let c_member_check_access "*)0)->")
	(let c_member_check_close ":1,default:0),\"Wove C field type\");\n")
	(let c_enum_open "typedef int32_t ")
	(let c_payload_enum_open "typedef struct{int32_t wvrt_tag;union{")
	(let c_payload_enum_close "} wvrt_payload;} ")
	(let c_array_open "typedef struct{")
	(let c_array_items " wvrt_items[")
	(let c_array_close "];}")
	(let c_alignas "_Alignas(")
	(let c_alignas_end ") ")
	(let c_pointer_alignas_end "*) ")
	(let c_pointer_items "*wvrt_items;}")
	(let c_layout_end ";\n")

	(fn write_record_name
		(:doc `Write the stable C typedef name of a checked nominal type or fixed array.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (record ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Each structural array has one generated name in the translation unit.")
				(call is_fixed_array (local record))
				(then (return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
					(local name_prefix) (call fixed_array_name_role) (struct.get (local record) identity)
					(borrow-shared (local source)) 0i32 0i32))))
			(let name (array.load (local nodes) (struct.get (local record) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (call record_name_role) (struct.get (local record) identity) (borrow-shared (local source))
				(struct.get (local name) start) (struct.get (local name) end)))))

	(fn write_value_type
		(:doc `Write the exact C type of a checked value, including a local record.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Native integers use the original C type name directly.")
				(call is_native_integer (local type))
				(then
					(let row (array.load (local records) (call native_integer_index (local type))))
					(return (call write_native_type (borrow-shared (local source))
						(array.load (local nodes) (struct.get (local row) native))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "A place reference is a pointer to the exact C type with the requested access.")
				(call is_place_reference (local type))
				(then
					(let-mut cursor (local offset))
					(if
						(:doc "Use const for a shared reference to the original storage.")
						(bool.not (call is_mutable_place_reference (local type)))
						(then (set (local cursor) (call c_literal_text (borrow-shared (local c_const)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(let target (call place_reference_target (borrow-shared (local records)) (local type)))
					(let end (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local target) (borrow-mut (local output))
						(local cursor) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local end) 42u8 (local writing)))))
			(if
				(:doc "Native values use their full C types. Wove-defined records use generated typedefs.")
				(call is_record_type (local type))
				(then
					(let row (array.load (local records) (call record_index (local type))))
					(if
						(:doc "Using the header type preserves its alignment, padding, and private members.")
						(call is_native_record (local row))
						(then (return (call write_native_type (borrow-shared (local source))
							(array.load (local nodes) (struct.get (local row) native))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local row) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "Typed slices use the descriptor ABI for their access mode.")
				(call is_typed_slice (local type))
				(then
					(let-mut descriptor 34u32)
					(if
						(:doc "A mutable descriptor carries a writable backing pointer.")
						(call is_writable_slice (local type))
						(then (set (local descriptor) 38u32)))
					(return (call c_type_text (borrow-mut (local output)) (local offset) (local descriptor) (local writing)))))
			(if
				(:doc "A receipt owns an opaque runtime frame until it is joined or dropped.")
				(u32.eq (local type) (local worker_receipt_type))
				(then (return (call c_literal_text (borrow-shared (local c_worker_receipt))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Array owners and optional byte owners share the same runtime pointer ABI.")
				(bool.or (call is_array_owner (local type)) (call is_optional_byte_owner_type (local type)))
				(then (return (call c_type_text (borrow-mut (local output)) (local offset) 41u32 (local writing)))))
			(return (call write_bridge_result_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_array_layout_argument
		(:doc `Append the element's native size or alignment to an allocation call.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (alignment bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let query (call open_array_layout_query (borrow-mut (local output)) (local offset) (local alignment) (local writing)))
			(let name (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local query) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name) 41u8 (local writing)))))

	(fn write_member_name
		(:doc `Write a C member name from its zero-based position in the layout.`)
		(params (source (shared-array u8)) (ordinal i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (call member_name_role) (u32.from-i32 (local ordinal)) (borrow-shared (local source)) 0i32 0i32))))

	(fn write_parameter_name
		(:doc `Write the parameter name in its C function scope.

		Its ordinal is local to the signature and keeps distinct parameters
		separate even when their readable suffixes sanitize identically.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (param ScalarParameter)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load (local nodes) (struct.get (local param) name)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call parameter_name_role)
				(u32.from-i32 (struct.get (local param) position)) (borrow-shared (local source))
				(struct.get (local name) start) (struct.get (local name) end)))))

	(fn write_parameter_place
		(:doc `Write a scalar parameter value, dereferencing it when it denotes a borrowed place.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (param ScalarParameter) (indirect bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "The borrowed scalar's storage resides at the formal's address.")
				(local indirect)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 42u8 (local writing)))))
			(return (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local param) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))

	(fn write_member_separator
		(:doc `Select C member access for a record value or pointer to its original storage.`)
		(params (output (mut-array u8)) (offset u32) (reference bool) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A record reference uses the pointer member operator.")
				(local reference)
				(then
					(let dash (call c_byte (borrow-mut (local output)) (local offset) 45u8 (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local dash) 62u8 (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local offset) 46u8 (local writing)))))

	(fn captures_value_argument
		(:doc `Capture mutable scalar and record values and fixed arrays before later call arguments.`)
		(params (row ScalarExpression) (next i32) (records (shared-array ScalarRecord)))
		(returns bool)
		(body
			(let type (struct.get (local row) type))
			(let kind (struct.get (local row) kind))
			(let writable (struct.get (local row) mutable_place))
			(if
				(:doc "Later arguments can change a mutable local or the pointee read through a scalar formal.")
				(bool.or (i32.ltz (local next))
					(bool.not (bool.or (u32.eq (local kind) 6u32) (bool.and (u32.eq (local kind) 2u32) (local writable)))))
				(then (return (bool false))))
			(if
				(:doc "Fixed arrays and mutable record locals retain their existing by-value capture rules.")
				(call is_record_type (local type))
				(then (return (bool.or (local writable)
					(call is_fixed_array (array.load (local records) (call record_index (local type))))))))
			(return (bool.and (local writable)
				(bool.or (call is_builtin_scalar (local type)) (call is_native_integer (local type)))))))

	(fn write_field_place
		(:doc `Write a checked Wove field path against its original binding.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(parameters (shared-array ScalarParameter))
			(place i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut root (struct.get (array.load (local expressions) (local place)) projection))
			(let value (array.load (local expressions) (local root)))
			(let-mut reference (call is_place_reference (struct.get (local value) type)))
			(let-mut cursor (local offset))
			(if
				(:doc "A projected parameter starts at its original formal.")
				(u32.eq (struct.get (local value) kind) 2u32)
				(then
					(set (local cursor) (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local parameters) (struct.get (local value) target)) (borrow-mut (local output))
						(local cursor) (local name_prefix) (local writing))))
				(else
					(set (local cursor) (call write_local_place (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local value) target) (local tree_base) (i32.eq (struct.get (local value) projection) (local indirect_local_place))
						(borrow-mut (local output))
						(local cursor) (local name_prefix) (local writing)))))
			(while
				(:doc "Append each enclosing field along the checked path from the binding.")
				(i32.not-eq (local root) (local place))
				(body
					(set (local root) (struct.get (array.load (local nodes) (local root)) parent))
					(set (local cursor) (call write_member_separator (borrow-mut (local output)) (local cursor)
						(local reference) (local writing)))
					(set (local reference) (bool false))
					(set (local cursor) (call write_member_name (borrow-shared (local source))
						(struct.get (array.load (local expressions) (local root)) target)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (local cursor))))

	(fn write_place_borrow
		(:doc `Write the address of a checked place or forward its existing pointer.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let place (struct.get (local row) projection))
			(if
				(:doc "Append the field path directly to the original binding.")
				(i32.lt -1i32 (local place))
				(then
					(let open (call c_byte (borrow-mut (local output)) (local offset) 38u8 (local writing)))
					(return (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local expressions)) (borrow-shared (local parameters))
						(local place) (local tree_base) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))))
			(if
				(:doc "A local can lend its address or forward the pointer to an iteration element.")
				(struct.get (local row) borrowed_owner)
				(then
					(let-mut open (local offset))
					(if
						(:doc "Take the address only for a direct local binding.")
						(i32.not-eq (local place) (local indirect_local_place))
						(then (set (local open) (call c_byte (borrow-mut (local output)) (local open) 38u8 (local writing)))))
					(return (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local row) target) (local tree_base) (borrow-mut (local output))
						(local open) (local name_prefix) (local writing)))))
			(let parameter (array.load (local parameters) (struct.get (local row) target)))
			(let-mut cursor (local offset))
			(if
				(:doc "A by-value formal lends its storage. A reference formal already holds the address.")
				(bool.not (call is_place_reference (struct.get (local parameter) type)))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
			(return (call write_parameter_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local parameter) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))

	(fn write_member_declaration
		(:doc `Write one scalar, fixed-array, or nested record member declaration in a Wove layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (ordinal i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type_end (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local type_end) 32u8 (local writing)))
			(let name_end (call write_member_name (borrow-shared (local source)) (local ordinal)
				(borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name_end) 59u8 (local writing)))))

	(fn write_record_layout
		(:doc `Write a complete record typedef with fields in declaration order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (record ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 121u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 100u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 102u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 123u8 (local writing)))
			(let count (struct.get (local record) count))
			(let-mut field (struct.get (local record) first))
			(let-mut ordinal 0i32)
			(if
				(:doc "Give an empty Wove record a single byte so its native struct is valid C11.")
				(i32.eqz (local count))
				(then (set (local cursor) (call write_member_declaration (borrow-shared (local source))
					(borrow-shared (local nodes)) (borrow-shared (local records))
					10u32 0i32 (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(while
				(:doc "Assign each declared member the same ordinal used at its accesses.")
				(i32.lt (local ordinal) (local count))
				(body
					(let node (array.load (local nodes) (local field)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local record) (local node)))
					(set (local cursor) (call write_member_declaration (borrow-shared (local source))
						(borrow-shared (local nodes)) (borrow-shared (local records))
						(local type) (local ordinal) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local field) (struct.get (local node) next_sibling))
					(set (local ordinal) (i32.inc (local ordinal)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local record) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))
			(return (local cursor))))

