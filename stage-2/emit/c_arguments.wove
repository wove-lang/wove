(module emit_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit one native call from captured scalar, string, and byte view arguments.

	Check bounded byte views before allocating any converted strings. Pass the
	original or converted pointers in formal order. Snapshot the native result
	while the scratch is live, copy back mutable views, then release the scratch.`)

	(use wove-file "../c/arguments.wove" (only is_c_string_mode is_c_checked_string_mode is_c_array_mode is_c_extent_mode is_c_vector_mode c_null_argument_kind is_c_storage_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/c_names.wove" (only native_symbol_start native_symbol_end))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/c_formals.wove" (only is_c_fixed_formal))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./text.wove" (only c_span c_byte c_literal_text c_text_fragment write_c_name write_temporary_name (type CNameRole)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./runtime.wove" (only write_runtime_site write_c_number write_site_number write_slice_items))
	(use wove-file "./c_formals.wove" (only write_fixed_c_argument))
	(use wove-file "./c_snapshots.wove" (only open_c_snapshot close_c_snapshot))
	(use wove-file "./c_extents.wove" (only write_c_extent_checks write_c_array_pointer_type))
	(use wove-file "./c_vectors.wove" (only write_c_vector_name write_c_vector_scratch))
	(use wove-file "./c_storage.wove" (only write_storage_argument write_storage_after_call))

	(fn c_symbol_text
		(:doc "Write only the checked C identifier bytes, including when the Wove target field was quoted.")
		(params (source (shared-array u8)) (name SourceNode) (output (mut-array u8))
			(offset u32) (writing bool)) (returns u32)
		(body (return (call c_span (borrow-shared (local source))
			(call native_symbol_start (local name)) (call native_symbol_end (local name))
			(borrow-mut (local output)) (local offset) (local writing)))))

	(fn c_string_text
		(:doc `Write fixed syntax for C-string descriptor setup, invocation, and cleanup.`)
		(params (output (mut-array u8)) (offset u32) (fragment u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Declare one runtime descriptor array.")
				(u32.eqz (local fragment))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 103u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 109u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Start the descriptor array initializer.")
				(u32.eq (local fragment) 1u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 91u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 93u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 123u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Leave the native pointer empty before preparation.")
				(u32.eq (local fragment) 2u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 48u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Close the descriptor array and declare its backing pointer.")
				(u32.eq (local fragment) 3u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 104u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 42u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Prepare the argument array in one allocation.")
				(u32.eq (local fragment) 4u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Read one prepared native pointer.")
				(u32.eq (local fragment) 5u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 93u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 46u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 108u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Start releasing the backing allocation.")
				(u32.eq (local fragment) 6u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 100u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 114u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 112u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
					(return (local cursor))))
			(if
				(:doc "Close a complete generated call statement.")
				(u32.eq (local fragment) 7u32)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
					(return (local cursor))))
			(return (local cursor))))

	(fn write_c_string_scratch
		(:doc `Name a call's descriptor array or backing pointer from its original expression row.`)
		(params (source (shared-array u8)) (index i32) (tree_base i32) (suffix u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix)
				(struct.new CNameRole (tag 98u8)) (u32.from-i32 (i32.sub (local index) (local tree_base)))
				(borrow-shared (local source)) 0i32 0i32))
			(return (call c_byte (borrow-mut (local output)) (local name) (local suffix) (local writing)))))

	(let share_mut_string "wvrt_share_mut_slice(")
	(let mut_string_pointer "(char*)")
	(let copy_back_c_string "wvrt_cstr_copy_back(")

	(fn write_c_string_reference
		(:doc `Refer to the scratch pointer for a converted argument's position.`)
		(params (source (shared-array u8)) (index i32) (tree_base i32) (converted i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
				97u8 (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let open (call c_byte (borrow-mut (local output)) (local name) 91u8 (local writing)))
			(let position (call write_c_number (borrow-mut (local output)) (local open)
				(local converted) (local writing)))
			(return (call c_string_text (borrow-mut (local output)) (local position) 5u32 (local writing)))))

	(fn write_c_string_descriptors
		(:doc `Write the captured byte views, conversion modes, and argument sites in formal order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get (local caller) name_base))
			(let source_base (struct.get (local caller) source_base))
			(let file (struct.get (local caller) file))
			(let-mut cursor (call c_string_text (borrow-mut (local output)) (local offset) 0u32 (local writing)))
			(set (local cursor) (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
				97u8 (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) 1u32 (local writing)))
			(let-mut argument (struct.get (local expression) first))
			(let-mut formal (struct.get (local callee) params))
			(while
				(:doc "Source siblings and the checked signature walk together.")
				(i32.not-ltz (local argument))
				(body
					(let node (array.load (local nodes) (local argument)))
					(let param (array.load (local parameters) (local formal)))
					(let mode (struct.get (local param) c_mode))
					(if
						(:doc "Only a converted argument contributes a byte view to the preparation array.")
						(call is_c_string_mode (local mode))
						(then
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 123u8 (local writing)))
							(let mutable (u32.eq (struct.get (local param) type) 38u32))
							(if
								(:doc "Preparation reads mutable and shared views through the same read-only descriptor.")
								(local mutable)
								(then (set (local cursor) (call c_literal_text (borrow-shared (local share_mut_string))
									(borrow-mut (local output)) (local cursor) (local writing)))))
							(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local argument) (local tree_base)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(if
								(:doc "Close the read-only projection before emitting the other descriptor fields.")
								(local mutable)
								(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
							(let-mut checked 48u8)
							(if
								(:doc "Checked mode asks the runtime to reject an embedded NUL.")
								(call is_c_checked_string_mode (local mode))
								(then (set (local checked) 49u8)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local checked) (local writing)))
							(set (local cursor) (call write_runtime_site (borrow-mut (local output)) (local cursor) (local file)
								(i32.sub (struct.get (local node) start) (local source_base))
								(i32.sub (struct.get (local node) end) (local source_base)) (local writing)))
							(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) 2u32 (local writing)))))
					(set (local argument) (struct.get (local node) next_sibling))
					(set (local formal) (i32.inc (local formal)))))
			(return (call c_string_text (borrow-mut (local output)) (local cursor) 3u32 (local writing)))))

	(let null_pointer "(void*)0")

	(fn write_c_native_invocation
		(:doc `Invoke the defining C function or macro with previously evaluated operands.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(expression ScalarExpression) (callee ScalarFunction) (caller ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get (local caller) name_base))
			(let snapshot (struct.get (local callee) c_snapshot))
			(let drop (struct.get (local callee) c_snapshot_drop))
			(let field (struct.get (local callee) c_snapshot_field))
			(let macro (struct.get (local callee) c_macro))
			(let checked_prototype (bool.or (struct.get (local callee) c_handle_out)
				(i32.gtz (struct.get (local callee) c_variadic))))
			(let first (struct.get (local expression) first))
			(let-mut cursor (local offset))
			(if
				(:doc "The macro may ignore any operand, but Wove has already evaluated each one.")
				(local macro)
				(then
					(let-mut argument (local first))
					(while
						(:doc "Keep each capture used independently of how the header expands the macro.")
						(i32.not-ltz (local argument))
						(body
							(set (local cursor) (call c_text_fragment (borrow-mut (local output)) (local cursor) 4u32 (local writing)))
							(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local argument) (local tree_base)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
							(set (local argument) (struct.get (array.load (local nodes) (local argument)) next_sibling))))))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (struct.get (local callee) result)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(if
				(:doc "The snapshot wrapper copies the native return into the Wove result temporary.")
				(local snapshot)
				(then (set (local cursor) (call open_c_snapshot (borrow-shared (local source))
					(borrow-shared (local nodes)) (local drop) (local field) (borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Enclose a macro expansion or the checked callee's function name.")
				(bool.or (local macro) (local checked_prototype))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))
			(let symbol (array.load (local nodes) (struct.get (local callee) name)))
			(set (local cursor) (call c_symbol_text (borrow-shared (local source)) (local symbol)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Use the verified C function when a header also defines a function-like macro of that name.")
				(local checked_prototype)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(let-mut argument (local first))
			(let native_first (struct.get (local callee) c_formals))
			(let-mut native_row (local native_first))
			(let-mut formal (struct.get (local callee) params))
			(let-mut converted 0i32)
			(while
				(:doc "Walk native signature order, including slots that consume no Wove argument.")
				(i32.lt -1i32 (local native_row))
				(body
					(if
						(:doc "Separate consecutive native arguments with a comma.")
						(i32.not-eq (local native_row) (local native_first))
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))))
					(let item (array.load (local nodes) (local native_row)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(if
						(:doc "Insert the checked header symbol without advancing the Wove argument cursor.")
						(bool.and (struct.get (local callee) c_fixed)
							(call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts)))
						(then
							(set (local cursor) (call write_fixed_c_argument (borrow-shared (local source))
								(borrow-shared (local nodes)) (local native_row) (borrow-mut (local output)) (local cursor) (local writing))))
						(else
							(let param (array.load (local parameters) (local formal)))
							(let mode (struct.get (local param) c_mode))
							(if
								(:doc "Use the prepared C pointer with the formal's original access mode.")
								(call is_c_string_mode (local mode))
								(then
									(if
										(:doc "Only an exclusive Wove view exposes the writable native scratch.")
										(u32.eq (struct.get (local param) type) 38u32)
										(then (set (local cursor) (call c_literal_text (borrow-shared (local mut_string_pointer))
											(borrow-mut (local output)) (local cursor) (local writing)))))
									(set (local cursor) (call write_c_string_reference (borrow-shared (local source)) (local index) (local tree_base)
										(local converted) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
									(set (local converted) (i32.inc (local converted))))
								(else
									(if
										(:doc "A string vector passes its separately prepared pointer table.")
										(call is_c_vector_mode (local mode))
										(then (set (local cursor) (call write_c_vector_name (borrow-shared (local source))
											(local argument) (local tree_base) (borrow-mut (local output)) (local cursor)
											(local name_prefix) (local writing))))
										(else
											(if
												(:doc "A checked null contributes a pointer constant and has no evaluated temporary.")
												(u32.eq (struct.get (array.load (local expressions) (local argument)) kind) (call c_null_argument_kind))
