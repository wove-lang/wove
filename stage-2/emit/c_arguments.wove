(module emit_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit one native call from captured scalar, string, and byte view arguments.

	Check bounded byte views before allocating any converted strings. Pass the
	original or converted pointers in formal order. Snapshot the native result
	while the scratch is live, copy back mutable views, then release the scratch.`)

	(use wove-file "../c/arguments.wove" (only is_c_string_mode is_c_checked_string_mode is_c_array_mode is_c_extent_mode is_c_vector_mode c_null_argument_kind is_c_storage_mode (value c_open_variadic_tail) (value c_void_pointer_mode) (value c_owner_marker_flag_mode) (value c_static_string_mode) (value c_adapted_callback_argument)
		(value c_string_offset_mode) (value c_terminated_array_mode) (value c_terminated_array_offset_mode) (value c_nullable_native_reference_mode) (value c_nullable_storage_shared_mode) (value c_macro_integer_argument) (value c_macro_type_argument) is_c_macro_designator))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/c_names.wove" (only native_symbol_start native_symbol_end))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/c_markers.wove" (only read_c_macro_discard))
	(use wove-file "../source/c_formals.wove" (only is_c_fixed_formal))
	(use wove-file "../scalar/syntax.wove" (only is_byte_view_type))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only is_record_out_status is_record_input is_record_input_hidden (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./text.wove" (only c_span c_byte c_literal_text c_text_fragment write_callback_adapter_name get_name write_temporary_name write_static_bytes (type CNameRole) (type CNameSpelling)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./c_null.wove" (only call_has_named_null open_null_call finish_null_call write_null_parameter))
	(use wove-file "./integers.wove" (only write_c_macro_integer_token))
	(use wove-file "./runtime.wove" (only write_runtime_site write_c_number write_site_number write_slice_items))
	(use wove-file "./c_formals.wove" (only native_nullable_needs_prototype fixed_c_needs_prototype native_owner_needs_prototype native_exact_scalar_prototype native_record_result_needs_prototype native_static_strings native_sync_callbacks native_c_string_offsets native_terminated_arrays write_fixed_c_argument))
	(use wove-file "./c_record_out.wove" (only open_record_out close_record_out))
	(use wove-file "./c_record_in.wove" (only open_record_input close_record_input))
	(use wove-file "./c_snapshots.wove" (only open_c_snapshot close_c_snapshot))
	(use wove-file "./c_record_snapshots.wove" (only open_record_snapshot close_record_snapshot))
	(use wove-file "./c_extents.wove" (only write_c_extent_checks write_c_array_pointer_type))
	(use wove-file "./c_vectors.wove" (only write_c_vector_name write_c_vector_scratch))
	(use wove-file "./c_terminated.wove" (only write_terminated_name write_terminated_array_phase
		(value prepare_terminated_arrays) (value project_terminated_offsets) (value release_terminated_arrays)))
	(use wove-file "./c_storage.wove" (only write_storage_argument write_storage_after_call write_storage_pointer_type))

	(fn c_symbol_text
		(:doc "Write only the checked C identifier bytes, including when the Wove target field was quoted.")
		(params (source (shared-array u8)) (name SourceNode) (output (mut-array u8))
			(offset u32) (writing bool)) (returns u32)
		(body (return (call c_span (borrow-shared source)
			(call native_symbol_start name) (call native_symbol_end name)
			(borrow-mut output) offset writing))))

	(fn c_string_text
		(:doc `Write fixed syntax for C-string descriptor setup, invocation, and cleanup.`)
		(params (output (mut-array u8)) (offset u32) (fragment u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Declare one runtime descriptor array.")
				fragment.eqz
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 103u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 109u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
					(return cursor)))
			(if
				(:doc "Start the descriptor array initializer.")
				(fragment.eq 1u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 91u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 93u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
					(return cursor)))
			(if
				(:doc "Leave the native pointer empty before preparation.")
				(fragment.eq 2u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 48u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(return cursor)))
			(if
				(:doc "Close the descriptor array and declare its backing pointer.")
				(fragment.eq 3u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 104u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
					(return cursor)))
			(if
				(:doc "Prepare the argument array in one allocation.")
				(fragment.eq 4u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 112u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 112u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
					(return cursor)))
			(if
				(:doc "Read one prepared native pointer.")
				(fragment.eq 5u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 46u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 108u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 117u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
					(return cursor)))
			(if
				(:doc "Start releasing the backing allocation.")
				(fragment.eq 6u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 100u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 114u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 112u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
					(return cursor)))
			(if
				(:doc "Close a complete generated call statement.")
				(fragment.eq 7u32)
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
					(return cursor)))
			(return cursor)))

	(fn write_c_string_scratch
		(:doc `Name a call's descriptor array or backing pointer from its original expression row.`)
		(params (source (shared-array u8)) (index i32) (tree_base i32) (suffix u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call get_name
				(u32:from-i32 (index.sub tree_base))
				(struct:new CNameRole (tag 110u8)) (struct:new CNameSpelling (start 0i32) (end 0i32) (trailing suffix))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(let share_mut_string "wvrt_share_mut_slice(")
	(let mut_string_pointer "(char*)")
	(let copy_back_c_string "wvrt_cstr_copy_back(")

	(fn write_c_string_descriptor
		(:doc "Address one prepared string using its compact descriptor index.")
		(params (source (shared-array u8)) (index i32) (tree_base i32) (converted i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (call write_c_string_scratch (borrow-shared source) index tree_base
				97u8 (borrow-mut output) offset name_prefix writing))
			(let open (call c_byte (borrow-mut output) name 91u8 writing))
			(let position (call write_c_number (borrow-mut output) open converted writing))
			(return (call c_byte (borrow-mut output) position 93u8 writing))))

	(fn write_c_string_reference
		(:doc "Refer to the converted byte address in a prepared string descriptor.")
		(params (source (shared-array u8)) (index i32) (tree_base i32) (converted i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let descriptor (call write_c_string_descriptor (borrow-shared source) index tree_base
				converted (borrow-mut output) offset name_prefix writing))
			(return (call c_string_text (borrow-mut output) descriptor 5u32 writing))))

	(fn write_c_captured_argument
		(:doc "Pass the prepared native pointer or end slot when a terminated input owns the call storage.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (argument i32) (tree_base i32)
			(mode u8) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A checked native array lends its prepared typed pointer.")
				(mode.eq c_terminated_array_mode)
				(then (return (call write_terminated_name (borrow-shared nodes) argument
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A present typed end slot passes its address only to C.")
				(mode.eq c_terminated_array_offset_mode)
				(then
					(let address (call c_byte (borrow-mut output) offset 38u8 writing))
					(return (call write_terminated_name (borrow-shared nodes) argument
						(borrow-mut output) address name_prefix writing))))
			(if
				(:doc "Only C sees the address of the call's end pointer.")
				(mode.eq c_string_offset_mode)
				(then
					(let address (call c_byte (borrow-mut output) offset 38u8 writing))
					(return (call write_c_string_scratch (borrow-shared source) argument tree_base 101u8
						(borrow-mut output) address name_prefix writing))))
			(return (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) offset name_prefix writing))))

	(let static_string_storage "static const unsigned char ")
	(let static_writable_string_storage "static unsigned char ")
	(let static_string_pointer "(const char*)")

	(fn write_static_c_string
		(:doc "Emit one static byte array for a checked literal, with the requested C access mode and a terminating NUL.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32)
			(writable bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let node (nodes.get index))
			(let start node/start)
			(let end node/end)
			(let-mut bytes (array:alloc u8 (end.sub start)))
			(let decoded (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut bytes)))
			(let width decoded/written)
			(bytes.set width 0u8)
			(let-mut prefix offset)
			(if
				(:doc "Native lvalues retain writable bytes. Retained call arguments still point to immutable storage.")
				writable
				(then (set prefix (call c_literal_text (borrow-shared static_writable_string_storage)
					(borrow-mut output) offset writing)))
				(else (set prefix (call c_literal_text (borrow-shared static_string_storage)
					(borrow-mut output) offset writing))))
			(let name (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) prefix name_prefix writing))
			(return (call write_static_bytes (borrow-shared bytes) 0i32 width.inc
				(borrow-mut output) name writing))))

	(fn prepares_c_string
		(:doc "Only a present string view contributes a descriptor and a scratch pointer.")
		(params (parameter ScalarParameter) (argument ScalarExpression))
		(returns bool)
		(body (return (bool:and (call is_c_string_mode parameter/c_mode)
			(argument/kind.not-eq (call c_null_argument_kind))))))

	(fn c_string_actuals
		(:doc "Count the present converted strings in a prefix of the native call.")
		(params (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (first i32) (start i32) (limit i32))
		(returns i32)
		(body
			(let-mut count 0i32)
			(let-mut argument first)
			(let-mut formal start)
			(while
				(:doc "Present fixed arguments determine the compact descriptor order.")
				(formal.lt limit)
				(body
					(if
						(:doc "An explicit null has no string conversion slot.")
						(call prepares_c_string (parameters.get formal)
							(expressions.get argument))
						(then (set count count.inc)))
					(set argument (struct:get (nodes.get argument) next_sibling))
					(set formal formal.inc)))
			(return count)))

	(fn write_c_string_descriptors
		(:doc `Write the captured byte views, conversion modes, and argument sites in formal order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base caller/name_base)
			(let source_base caller/source_base)
			(let file caller/file)
			(let-mut cursor (call c_string_text (borrow-mut output) offset 0u32 writing))
			(set cursor (call write_c_string_scratch (borrow-shared source) index tree_base
				97u8 (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_string_text (borrow-mut output) cursor 1u32 writing))
			(let-mut argument expression/first)
			(let-mut formal callee/params)
			(let fixed_end (formal.add callee/arity))
			(while
				(:doc "Only declared formals have string conversion contracts.")
				(formal.lt fixed_end)
				(body
					(let node (nodes.get argument))
					(let param (parameters.get formal))
					(let mode param/c_mode)
					(if
						(:doc "Only a converted argument contributes a byte view to the preparation array.")
						(call prepares_c_string param (expressions.get argument))
						(then
							(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
							(let mutable (param/type.eq 38u32))
							(if
								(:doc "Preparation reads mutable and shared views through the same read-only descriptor.")
								mutable
								(then (set cursor (call c_literal_text (borrow-shared share_mut_string)
									(borrow-mut output) cursor writing))))
							(set cursor (call write_temporary_name (borrow-shared nodes) argument
								(borrow-mut output) cursor name_prefix writing))
							(if
								(:doc "Close the read-only projection before emitting the other descriptor fields.")
								mutable
								(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
							(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
							(let-mut checked 48u8)
							(if
								(:doc "Checked mode asks the runtime to reject an embedded NUL.")
								(call is_c_checked_string_mode mode)
								(then (set checked 49u8)))
							(set cursor (call c_byte (borrow-mut output) cursor checked writing))
							(set cursor (call write_runtime_site (borrow-mut output) cursor file
								(node/start.sub source_base)
								(node/end.sub source_base) writing))
							(set cursor (call c_string_text (borrow-mut output) cursor 2u32 writing))))
					(set argument node/next_sibling)
					(set formal formal.inc)))
			(return (call c_string_text (borrow-mut output) cursor 3u32 writing))))

	(let null_pointer "(void*)0")
	(let null_string_pointer "(const char*)0")
	(let open_variadic_cast "((__typeof__(&(")
	(let open_variadic_target ")))&(")
	(let close_variadic_target "))")

	(fn write_c_invocation_target
		(:doc "Call the header's exact function type when Wove has already materialized a dynamic format.")
		(params (source (shared-array u8)) (symbol SourceNode) (open bool)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(if
				(:doc "Closed signatures retain the ordinary or macro spelling selected by the caller.")
				open.not
				(then (return (call c_symbol_text (borrow-shared source) symbol
					(borrow-mut output) offset writing))))
			(let type (call c_literal_text (borrow-shared open_variadic_cast)
				(borrow-mut output) offset writing))
			(let signature (call c_symbol_text (borrow-shared source) symbol
				(borrow-mut output) type writing))
			(let address (call c_literal_text (borrow-shared open_variadic_target)
				(borrow-mut output) signature writing))
			(let target (call c_symbol_text (borrow-shared source) symbol
				(borrow-mut output) address writing))
			(return (call c_literal_text (borrow-shared close_variadic_target)
				(borrow-mut output) target writing))))

	(fn write_c_null_argument
		(:doc "Use the declared C pointer for an absent typed loan or C string.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameter ScalarParameter) (native i32) (operand i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Use the wrapper parameter so the original macro expansion is shared.")
				native.not-ltz
				(then (return (call write_null_parameter operand (borrow-mut output) offset writing))))
			(let mode parameter/c_mode)
			(let storage (mode.eq c_nullable_storage_shared_mode))
			(if
				(:doc "A typed loan preserves its exact pointee and const qualification even when absent.")
				(storage.or (mode.eq c_nullable_native_reference_mode))
				(then
					(let open (call c_byte (borrow-mut output) offset 40u8 writing))
					(let-mut type open)
					(if
						(:doc "Use the same const storage pointer type as the present owner loan.")
						storage
						(then (set type (call write_storage_pointer_type (borrow-shared source) (borrow-shared nodes)
							parameter/type (bool true) (borrow-mut output) open writing)))
						(else (set type (call write_value_type (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) parameter/type
							(borrow-mut output) open name_prefix writing))))
					(let close (call c_byte (borrow-mut output) type 41u8 writing))
					(return (call c_byte (borrow-mut output) close 48u8 writing))))
			(if
				(:doc "C-string contracts keep their existing shared char pointer.")
				(call is_c_string_mode mode)
				(then (return (call c_literal_text (borrow-shared null_string_pointer)
					(borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared null_pointer) (borrow-mut output) offset writing))))

	(let record_out_address "&wvrt_record_out")
	(let discarded_macro_operand "(void)(")

	(let inferred_macro_result "__extension__ __auto_type ")
	(let macro_result_check_open "_Static_assert(_Generic((")
	(let macro_result_check_close ":1,default:0),\"Wove C macro result type mismatch\");")

	(fn assert_c_macro_result
		(:doc "Ask Clang to compare the already captured native result with the exact bridge type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(result u32) (index i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared macro_result_check_open)
				(borrow-mut output) offset writing))
			(let name (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) open name_prefix writing))
			(let close (call c_byte (borrow-mut output) name 41u8 writing))
			(let comma (call c_byte (borrow-mut output) close 44u8 writing))
			(let type (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) result (borrow-mut output) comma name_prefix writing))
			(return (call c_literal_text (borrow-shared macro_result_check_close)
				(borrow-mut output) type writing))))

	(fn write_c_native_invocation
		(:doc `Invoke the defining C function or macro with previously evaluated operands.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(expression ScalarExpression) (callee ScalarFunction) (caller ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base caller/name_base)
			(let snapshot callee/c_snapshot)
			(let record_snapshot callee/c_snapshot_record.not-ltz)
			(let drop callee/c_snapshot_drop)
			(let field callee/c_snapshot_field)
			(let extent callee/c_snapshot_extent)
			(let macro callee/c_macro)
			(let result callee/result)
			(let saves_result (result.not-eq (call void_type)))
			(let macro_value (macro.and saves_result))
			(let tail callee/c_variadic)
			(let open (tail.eq c_open_variadic_tail))
			(let record_out callee/return_scratch.not-ltz)
			(let record_input (call is_record_input callee))
			(let typed_nullable (call native_nullable_needs_prototype (borrow-shared parameters) callee))
			(let checked (bool:or (bool:or (bool:or (record_out.or record_input)
						(typed_nullable.or callee/c_void_pointer))
					(bool:or (callee/c_handle_out.or tail.gtz)
						(bool:or (call native_static_strings (borrow-shared parameters) callee)
							(call native_sync_callbacks (borrow-shared parameters) callee))))
				(bool:or (callee/c_fixed.and
					(call fixed_c_needs_prototype (borrow-shared source) (borrow-shared nodes)
						callee/c_formals))
					(bool:or (call native_owner_needs_prototype (borrow-shared source) (borrow-shared nodes)
							(borrow-shared parameters) callee)
						(bool:or (bool:or (call native_c_string_offsets (borrow-shared parameters) callee)
								(call native_terminated_arrays (borrow-shared parameters) callee))
							(i32:ltz (call native_exact_scalar_prototype (borrow-shared records)
								(borrow-shared parameters) callee)))))))
			(let parenthesized (open.not.and
				(bool:or (checked.or record_snapshot)
					(call native_record_result_needs_prototype (borrow-shared records) callee))))
			(let first expression/first)
			(let-mut cursor offset)
			(let-mut token_macro (bool false))
			(if
				(:doc "The macro may ignore an operand even after Wove evaluates it.")
				macro
				(then
					(let-mut argument first)
					(while
						(:doc "Keep ordinary captures used independently of how the header expands the macro.")
						argument.not-ltz
						(body
							(let kind (struct:get (expressions.get argument) kind))
							(let designator (call is_c_macro_designator kind))
							(let literal (kind.eq c_macro_integer_argument))
							(set token_macro (token_macro.or (designator.or literal)))
							(if
								(:doc "Only evaluated macro operands have a Wove capture.")
								(designator.not.and
									(literal.not.or callee/c_extents.gtz))
								(then
									(set cursor (call c_text_fragment (borrow-mut output) cursor 4u32 writing))
									(set cursor (call write_temporary_name (borrow-shared nodes) argument
										(borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))))
							(set argument (struct:get (nodes.get argument) next_sibling))))))
			(let exact_result (bool:and (token_macro.and macro_value)
				(bool:not (snapshot.or record_snapshot))))
			(if
				(:doc "Only an invocation that produces a Wove value initializes a result temporary.")
				saves_result
				(then
					(if
						(:doc "Infer the type of the actual expansion before any assignment conversion.")
						exact_result
						(then (set cursor (call c_literal_text (borrow-shared inferred_macro_result)
							(borrow-mut output) cursor writing)))
						(else
							(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) result
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))))
					(set cursor (call write_temporary_name (borrow-shared nodes) index
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))))
			(if
				(:doc "An adapted record-out call declares its typed nullable slot before entering C.")
				record_out
				(then (set cursor (call open_record_out (borrow-shared nodes) expression
					(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Stage the pointer and count on their original record for this invocation.")
				record_input
				(then (set cursor (call open_record_input (borrow-shared source) (borrow-shared nodes)
					(borrow-shared parameters) (borrow-shared records) expression caller callee
					(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "The snapshot wrapper copies the native return into the Wove result temporary.")
				snapshot
				(then
					(if
						(:doc "Capture a record with its checked mapping, or reuse the existing text wrapper.")
						record_snapshot
						(then (set cursor (call open_record_snapshot (borrow-mut output) cursor writing)))
						(else (set cursor (call open_c_snapshot (borrow-shared source)
							(borrow-shared nodes) drop field extent (borrow-mut output) cursor writing))))))
			(if
				(:doc "A local snapshot takes the evaluated native record pointer instead of calling a C symbol.")
				callee/c_snapshot_source
				(then
					(let site (nodes.get index))
					(let base caller/source_base)
					(let pointer (call write_temporary_name (borrow-shared nodes) first
						(borrow-mut output) cursor name_prefix writing))
					(let end (call close_c_snapshot (borrow-shared source) (borrow-shared nodes) drop field extent
						caller/file (site/start.sub base)
						(site/end.sub base) (borrow-mut output) pointer writing))
					(return (call c_byte (borrow-mut output) end 59u8 writing))))
			(let named_null (call call_has_named_null (borrow-shared nodes) (borrow-shared expressions) first))
			(if
				(:doc "Only calls with a selected null macro need a conversion witness.")
				named_null
				(then (set cursor (call open_null_call (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) first index (borrow-mut output) cursor writing))))
			(if
				(:doc "Enclose a value macro expansion or the checked callee's function name.")
				(macro_value.or parenthesized)
				(then (set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))))
			(let symbol (nodes.get callee/name))
			(set cursor (call write_c_invocation_target (borrow-shared source) symbol open
				(borrow-mut output) cursor writing))
			(if
				(:doc "Use the verified C function when a header also defines a function-like macro of that name.")
				parenthesized
				(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(let-mut argument first)
			(let-mut native_row callee/c_formals)
			(let-mut formal callee/params)
			(let-mut converted 0i32)
			(let-mut wrote_argument (bool false))
			(while
				(:doc "Walk the declaration order and emit only actual native call arguments.")
				(i32:lt -1i32 native_row)
				(body
					(let item (nodes.get native_row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let fixed (callee/c_fixed.and
						(call is_c_fixed_formal (borrow-shared source) (borrow-shared nodes) parts)))
					(let record_out_slot (fixed.not.and (call is_record_out_status callee formal)))
					(if
						(:doc "Omit the Wove-only adapter inputs or replace a status with the native out slot.")
						(fixed.not.and
							(record_out_slot.or
								(bool:or (call is_record_input_hidden callee formal)
									(u8:eq (struct:get (parameters.get formal) c_mode) c_owner_marker_flag_mode))))
						(then
							(if
								(:doc "The typed out pointer replaces the status place in the C argument list.")
								record_out_slot
								(then
									(if wrote_argument (then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
									(set cursor (call c_literal_text (borrow-shared record_out_address)
										(borrow-mut output) cursor writing))
									(set wrote_argument (bool true))))
							(set argument (struct:get (nodes.get argument) next_sibling))
							(set formal formal.inc))
						(else
							(if
								(:doc "Separate consecutive emitted arguments with a comma.")
								wrote_argument
								(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
							(set wrote_argument (bool true))
							(if
								(:doc "Insert the checked fixed value without advancing the Wove argument cursor.")
								fixed
								(then
									(set cursor (call write_fixed_c_argument (borrow-shared source)
										(borrow-shared nodes) native_row (borrow-mut output) cursor writing)))
								(else
									(let param (parameters.get formal))
									(let mode param/c_mode)
									(let actual (expressions.get argument))
									(let kind actual/kind)
									(if
										(:doc "Type and member operands supply C spelling directly.")
										(call is_c_macro_designator kind)
										(then
											(if
												(:doc "Use the record's native representation and the checked field's bare name.")
												(kind.eq c_macro_type_argument)
												(then (set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
													(borrow-shared records) actual/type (borrow-mut output) cursor name_prefix writing)))
												(else (set cursor (call c_span (borrow-shared source)
													actual/start actual/end (borrow-mut output) cursor writing))))
											(set argument (struct:get (nodes.get argument) next_sibling))
											(set formal formal.inc)
											(set native_row item/next_sibling)
											(continue)))
									(let discard (macro.and
										(struct:get (call read_c_macro_discard (borrow-shared source) (borrow-shared nodes)
											parts) present)))
									(if
										(:doc "Mark the captured borrow as intentionally discarded in the native macro expression.")
										discard
										(then (set cursor (call c_literal_text (borrow-shared discarded_macro_operand)
											(borrow-mut output) cursor writing))))
									(if
										(:doc "The static byte array decays to the exact immutable C-string pointer.")
										(mode.eq c_static_string_mode)
										(then (set cursor (call c_literal_text (borrow-shared static_string_pointer)
											(borrow-mut output) cursor writing))))
									(if
										(:doc "Use the prepared C pointer with the formal's original access mode.")
										(call prepares_c_string param actual)
										(then
											(if
												(:doc "Only an exclusive Wove view exposes the writable native scratch.")
												(param/type.eq 38u32)
												(then (set cursor (call c_literal_text (borrow-shared mut_string_pointer)
													(borrow-mut output) cursor writing))))
											(set cursor (call write_c_string_reference (borrow-shared source) index tree_base
												converted (borrow-mut output) cursor name_prefix writing))
											(set converted converted.inc))
										(else
											(if
												(:doc "A string vector passes its separately prepared pointer table.")
												(call is_c_vector_mode mode)
												(then (set cursor (call write_c_vector_name (borrow-shared nodes)
													argument (borrow-mut output) cursor
													name_prefix writing)))
												(else
													(if
														(:doc "A checked null contributes a pointer constant and has no evaluated temporary.")
												(actual/kind.eq (call c_null_argument_kind))
												(then (set cursor (call write_c_null_argument (borrow-shared source) (borrow-shared nodes)
													(borrow-shared records) param actual/target argument (borrow-mut output) cursor name_prefix writing)))
														(else
															(if
																(:doc "Storage owners lend the original native object behind the captured wrapper.")
																(call is_c_storage_mode mode)
																(then (set cursor (call write_storage_argument (borrow-shared source)
																	(borrow-shared nodes) param argument
																	(borrow-mut output) cursor name_prefix writing)))
																(else
																	(if
																		(:doc "Cast an array view's pointer to the exact declared C element type.")
																		(call is_c_array_mode mode)
																		(then
																			(let open (call c_byte (borrow-mut output) cursor 40u8 writing))
																			(let type (call write_c_array_pointer_type (borrow-shared source) (borrow-shared nodes)
																				(borrow-shared records) param/type
																				(borrow-mut output) open name_prefix writing))
																			(set cursor (call c_byte (borrow-mut output) type 41u8 writing))))
																	(if
																		(:doc "The checked receiver already has a C address and needs no evaluated temporary.")
																		(actual/kind.eq c_adapted_callback_argument)
																		(then (set cursor (call write_callback_adapter_name argument
																			(borrow-mut output) cursor name_prefix writing)))
																		(else
																			(if
																				(:doc "A literal formal supplies a single token that C can paste before parsing.")
																				(actual/kind.eq c_macro_integer_argument)
																				(then (set cursor (call write_c_macro_integer_token (borrow-shared source)
																					actual (borrow-mut output) cursor writing)))
																				(else (set cursor (call write_c_captured_argument (borrow-shared source) (borrow-shared nodes)
																					argument tree_base mode (borrow-mut output) cursor name_prefix writing))))))
																	(if
																		(:doc "Pass the checked view's original pointer.")
																		(bool:or (call is_c_extent_mode mode)
																			(bool:and (mode.eq c_void_pointer_mode)
																				(call is_byte_view_type param/type)))
																		(then (set cursor (call write_slice_items (borrow-mut output) cursor writing))))))))))))
									(if
										(:doc "Close the explicit void cast after the prepared native operand.")
										discard
										(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
									(set argument (struct:get (nodes.get argument) next_sibling))
									(set formal formal.inc)))))
					(set native_row item/next_sibling)))
			(while
				(:doc "Only an open call has actuals left after its fixed prefix. Clang promotes the captured scalar types.")
				argument.not-ltz
				(body
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes) argument
						(borrow-mut output) cursor name_prefix writing))
					(set argument (struct:get (nodes.get argument) next_sibling))))
			(if
				(:doc "Close the wrapper definition and expand each original macro at this call site.")
				named_null
				(then (set cursor (call finish_null_call (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) first index (borrow-mut output) cursor writing))))
			(if
				(:doc "Close the extra parentheses around a value macro expansion.")
				macro_value
				(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(if
				(:doc "The finished expression retains the two original loans and the exact C status.")
				record_out
				(then
					(let end (call close_record_out (borrow-shared nodes) (borrow-shared parameters)
						expression caller callee index (borrow-mut output) cursor name_prefix writing))
					(return (call c_byte (borrow-mut output) end 59u8 writing))))
			(if
				(:doc "Finish the native call and restore the two mapped fields before the loan ends.")
				record_input
				(then (return (call close_record_input (borrow-shared source) (borrow-shared nodes)
					callee (borrow-mut output) cursor writing))))
			(if
				(:doc "The native pointer never leaves the full expression that copies it.")
				record_snapshot
				(then (return (call close_record_snapshot (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) callee caller (nodes.get index)
					(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Close the native call before adding the snapshot metadata and original source span.")
				snapshot
				(then
					(let site (nodes.get index))
					(let base caller/source_base)
					(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
					(set cursor (call close_c_snapshot (borrow-shared source) (borrow-shared nodes) drop field extent
						caller/file (site/start.sub base)
						(site/end.sub base)
						(borrow-mut output) cursor writing))
					(return (call c_byte (borrow-mut output) cursor 59u8 writing))))
			(set cursor (call c_string_text (borrow-mut output) cursor 7u32 writing))
			(if
				(:doc "Verify the saved value type without expanding the native macro again.")
				exact_result
				(then (return (call assert_c_macro_result (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) result index (borrow-mut output) cursor name_prefix writing))))
			(return cursor)))

	(fn write_c_string_setup
		(:doc `Prepare one scratch array for all captured C-string arguments.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (expression ScalarExpression) (caller ScalarFunction)
			(callee ScalarFunction) (index i32) (count i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base caller/name_base)
			(let-mut cursor (call write_c_string_descriptors (borrow-shared source) (borrow-shared nodes)
				(borrow-shared parameters) (borrow-shared expressions)
				expression caller callee index
				(borrow-mut output) offset name_prefix writing))
			(set cursor (call write_c_string_scratch (borrow-shared source) index tree_base
				98u8 (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_string_text (borrow-mut output) cursor 4u32 writing))
			(set cursor (call write_c_string_scratch (borrow-shared source) index tree_base
				97u8 (borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_site_number (borrow-mut output) cursor count writing))
			(set cursor (call c_string_text (borrow-mut output) cursor 7u32 writing))
			(return cursor)))

	(fn write_c_string_copy_backs
		(:doc `Copy each mutable string's original byte extent back before releasing the scratch.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (expression ScalarExpression) (tree_base i32)
			(callee ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut argument expression/first)
			(let-mut formal callee/params)
			(let fixed_end (formal.add callee/arity))
			(let-mut converted 0i32)
			(while
				(:doc "Use the same descriptor order as preparation, without entering the open tail.")
				(formal.lt fixed_end)
				(body
					(let param (parameters.get formal))
					(if
						(:doc "Only converted strings occupy descriptor slots.")
						(call prepares_c_string param (expressions.get argument))
						(then
							(if
								(:doc "Restore the captured mutable view after saving the return, including when it is null.")
								(param/type.eq 38u32)
								(then
									(set cursor (call c_literal_text (borrow-shared copy_back_c_string)
										(borrow-mut output) cursor writing))
									(set cursor (call write_temporary_name (borrow-shared nodes) argument
										(borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
									(set cursor (call write_c_string_reference (borrow-shared source) index tree_base
										converted (borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_string_text (borrow-mut output) cursor 7u32 writing))))
							(set converted converted.inc)))
					(set argument (struct:get (nodes.get argument) next_sibling))
					(set formal formal.inc)))
			(return cursor)))

	(let c_end_pointer_type "char *")
	(let c_end_pointer_zero "=0;")
	(let c_offset_call "=wvrt_cstr_offset(&")

	(fn write_c_string_offsets
		(:doc "Create native end slots, then project their results before releasing the converted inputs.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(expressions (shared-array ScalarExpression)) (expression ScalarExpression) (caller ScalarFunction)
			(callee ScalarFunction) (index i32) (setup bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base caller/name_base)
			(let first expression/first)
			(let start callee/params)
			(let end (start.add callee/arity))
			(let-mut cursor offset)
			(let-mut argument first)
			(let-mut formal start)
			(while
				(:doc "Visit only declared formals and keep each end slot distinct.")
				(formal.lt end)
				(body
					(let param (parameters.get formal))
					(if
						(:doc "The native end pointer is initialized to detect a callee that leaves it unwritten.")
						(param/c_mode.eq c_string_offset_mode)
						(then
							(if
								(:doc "The setup precedes the native call. Copyout uses the same named slot.")
								setup
								(then
									(set cursor (call c_literal_text (borrow-shared c_end_pointer_type)
										(borrow-mut output) cursor writing))
									(set cursor (call write_c_string_scratch (borrow-shared source) argument tree_base 101u8
										(borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_literal_text (borrow-shared c_end_pointer_zero)
										(borrow-mut output) cursor writing)))
								(else
									(let input (start.add param/c_count))
									(let converted (call c_string_actuals (borrow-shared nodes)
										(borrow-shared parameters) (borrow-shared expressions) first start input))
									(set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))
									(set cursor (call write_temporary_name (borrow-shared nodes) argument
										(borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_literal_text (borrow-shared c_offset_call)
										(borrow-mut output) cursor writing))
									(set cursor (call write_c_string_descriptor (borrow-shared source) index tree_base
										converted (borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
									(set cursor (call write_c_string_scratch (borrow-shared source) argument tree_base 101u8
										(borrow-mut output) cursor name_prefix writing))
									(set cursor (call c_string_text (borrow-mut output) cursor 7u32 writing))))))
					(set argument (struct:get (nodes.get argument) next_sibling))
					(set formal formal.inc)))
			(return cursor)))

	(fn write_c_argument_call
		(:doc `Check, prepare, invoke, and release in one evaluation step with a saved result.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base caller/name_base)
			(let-mut cursor offset)
			(if
				(:doc "Reject a bad extent before allocating string scratch or entering C.")
				callee/c_extents.gtz
				(then (set cursor (call write_c_extent_checks (borrow-shared source)
					(borrow-shared nodes) (borrow-shared parameters) (borrow-shared records)
					expression caller callee
					(borrow-mut output) cursor name_prefix writing))))
			(let-mut string_count 0i32)
			(if
				(:doc "Calls with only null string actuals need no descriptor array.")
				callee/c_strings.gtz
				(then (set string_count (call c_string_actuals (borrow-shared nodes)
					(borrow-shared parameters) (borrow-shared expressions)
					expression/first callee/params
					(callee/params.add callee/arity)))))
			(let strings string_count.gtz)
			(if
				(:doc "Only a C-string contract materializes backing storage.")
				strings
				(then (set cursor (call write_c_string_setup (borrow-shared source)
					(borrow-shared nodes) (borrow-shared parameters) (borrow-shared expressions)
					expression caller callee index string_count
					(borrow-mut output) cursor name_prefix writing))))
			(let vectors callee/c_vectors)
			(if
				(:doc "Prepare every detached vector before invoking the native function.")
				vectors
				(then (set cursor (call write_c_vector_scratch
					(borrow-shared nodes) (borrow-shared parameters) expression/first
					caller callee (bool false) (borrow-mut output)
					cursor name_prefix writing))))
			(let offsets (call native_c_string_offsets (borrow-shared parameters) callee))
			(if
				(:doc "The native call sees fresh pointer-out slots only when the bridge requests offsets.")
				offsets
				(then (set cursor (call write_c_string_offsets (borrow-shared source)
					(borrow-shared nodes) (borrow-shared parameters) (borrow-shared expressions)
					expression caller callee index (bool true)
					(borrow-mut output) cursor name_prefix writing))))
			(let terminated (call native_terminated_arrays (borrow-shared parameters) callee))
			(if
				(:doc "Construct all typed copies and present end slots before entering native code.")
				terminated
				(then (set cursor (call write_terminated_array_phase (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared parameters) (borrow-shared expressions)
					expression/first caller callee prepare_terminated_arrays
					(borrow-mut output) cursor name_prefix writing))))
			(set cursor (call write_c_native_invocation (borrow-shared source) (borrow-shared nodes)
				(borrow-shared parameters) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				expression callee caller index
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Finish the checked offset projection before any scratch is released.")
				offsets
				(then (set cursor (call write_c_string_offsets (borrow-shared source)
					(borrow-shared nodes) (borrow-shared parameters) (borrow-shared expressions)
					expression caller callee index (bool false)
					(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Project all typed offsets before freeing the prepared copies.")
				terminated
				(then
					(set cursor (call write_terminated_array_phase (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared parameters) (borrow-shared expressions)
						expression/first caller callee project_terminated_offsets
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call write_terminated_array_phase (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared parameters) (borrow-shared expressions)
						expression/first caller callee release_terminated_arrays
						(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Normalize pointer sentinels, activate storage, and release consumed wrappers after C.")
				(callee/c_storage.or callee/c_handle_out)
				(then (set cursor (call write_storage_after_call (borrow-shared source) (borrow-shared nodes)
					(borrow-shared parameters) expression/first callee index
					(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Copy mutable strings back after capturing the result, then release scalar scratch.")
				strings
				(then
					(set cursor (call write_c_string_copy_backs (borrow-shared source) (borrow-shared nodes)
						(borrow-shared parameters) (borrow-shared expressions)
						expression tree_base callee index
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_string_text (borrow-mut output) cursor 6u32 writing))
					(set cursor (call write_c_string_scratch (borrow-shared source) index tree_base
						98u8 (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_string_text (borrow-mut output) cursor 7u32 writing))))
			(if
				(:doc "Release detached vectors once the result and native storage effects have been handled.")
				vectors
				(then (set cursor (call write_c_vector_scratch
					(borrow-shared nodes) (borrow-shared parameters) expression/first
					caller callee (bool true) (borrow-mut output)
					cursor name_prefix writing))))
			(return cursor))))
