(module emit_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit one native call from captured scalar, string, and byte view arguments.

	Check bounded byte views before allocating any converted strings. Pass the
	original or converted pointers in formal order, save the result, and release
	any string backing allocation before the result can be consumed.`)

	(use wove-file "../c/arguments.wove" (only is_c_string_mode is_c_checked_string_mode is_c_bytes_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarFunction) (type ScalarParameter) (type ScalarExpression)))
	(use wove-file "./text.wove" (only c_byte c_span write_c_name write_temporary_name (type CNameRole)))
	(use wove-file "./owners.wove" (only write_bridge_result_type))
	(use wove-file "./runtime.wove" (only write_runtime_site write_c_number write_site_number write_slice_items))
	(use wove-file "./c_bytes.wove" (only write_c_byte_checks))

	(fn c_string_text
		(:doc `Write fixed syntax for C-string descriptor setup, invocation, and cleanup.`)
		(params (output (mut-slice u8)) (offset u32) (fragment u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Declare one runtime descriptor array.")
				(u32.eq (local fragment) (u32 0))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 119) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 103) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 117) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 109) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 110) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Start the descriptor array initializer.")
				(u32.eq (local fragment) (u32 1))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 91) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 93) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Leave the native pointer empty before preparation.")
				(u32.eq (local fragment) (u32 2))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 48) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Close the descriptor array and declare its backing pointer.")
				(u32.eq (local fragment) (u32 3))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 104) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 42) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Prepare the argument array in one allocation.")
				(u32.eq (local fragment) (u32 4))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 119) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 112) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 112) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Read one prepared native pointer.")
				(u32.eq (local fragment) (u32 5))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 93) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 46) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 119) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 108) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 117) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Start releasing the backing allocation.")
				(u32.eq (local fragment) (u32 6))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 119) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 100) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 111) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 112) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
					(return (local cursor))))
			(if
				(:doc "Close a complete generated call statement.")
				(u32.eq (local fragment) (u32 7))
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))
					(return (local cursor))))
			(return (local cursor))))

	(fn write_c_string_scratch
		(:doc `Name a call's descriptor array or backing pointer from its original expression row.`)
		(params (source (shared-slice u8)) (index i32) (tree_base i32) (suffix u8)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix)
				(record.make CNameRole (tag (u8 98))) (int.convert u32 (i32.sub.wrapping (local index) (local tree_base)))
				(borrow-shared (local source)) (i32 0) (i32 0)))
			(return (call c_byte (borrow-mut (local output)) (local name) (local suffix) (local writing)))))

	(fn write_c_string_descriptors
		(:doc `Write the captured byte views, conversion modes, and argument sites in formal order.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parameters (shared-slice ScalarParameter))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (record.get (local caller) tree_base))
			(let source_base (record.get (local caller) source_base))
			(let file (record.get (local caller) file))
			(let-mut cursor (call c_string_text (borrow-mut (local output)) (local offset) (u32 0) (local writing)))
			(set (local cursor) (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
				(u8 97) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) (u32 1) (local writing)))
			(let-mut argument (record.get (local expression) first))
			(let-mut formal (record.get (local callee) params))
			(while
				(:doc "Source siblings and the checked signature walk together.")
				(bool.not (i32.lt (local argument) (i32 0)))
				(body
					(let node (slice.load (local nodes) (local argument)))
					(let param (slice.load (local parameters) (local formal)))
					(let mode (record.get (local param) c_mode))
					(if
						(:doc "Only a converted argument contributes a byte view to the preparation array.")
						(call is_c_string_mode (local mode))
						(then
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))
							(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local argument) (local tree_base)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
							(let-mut checked (u8 48))
							(if
								(:doc "Checked mode asks the runtime to reject an embedded NUL.")
								(call is_c_checked_string_mode (local mode))
								(then (set (local checked) (u8 49))))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local checked) (local writing)))
							(set (local cursor) (call write_runtime_site (borrow-mut (local output)) (local cursor) (local file)
								(i32.sub.wrapping (record.get (local node) start) (local source_base))
								(i32.sub.wrapping (record.get (local node) end) (local source_base)) (local writing)))
							(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) (u32 2) (local writing)))))
					(set (local argument) (record.get (local node) next_sibling))
					(set (local formal) (i32.add.wrapping (local formal) (i32 1)))))
			(return (call c_string_text (borrow-mut (local output)) (local cursor) (u32 3) (local writing)))))

	(fn write_c_native_invocation
		(:doc `Invoke the original C symbol with borrowed byte pointers, converted strings, and scalar operands.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parameters (shared-slice ScalarParameter))
			(expression ScalarExpression) (callee ScalarFunction) (tree_base i32) (index i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_bridge_result_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local callee) result) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))
			(let symbol (slice.load (local nodes) (record.get (local callee) name)))
			(set (local cursor) (call c_span (borrow-shared (local source)) (record.get (local symbol) start)
				(record.get (local symbol) end) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(let first (record.get (local expression) first))
			(let-mut argument (local first))
			(let-mut formal (record.get (local callee) params))
			(let-mut converted (i32 0))
			(let-mut digits (array.alloc u8 (i32 11)))
			(while
				(:doc "Read every native argument from its already prepared storage.")
				(bool.not (i32.lt (local argument) (i32 0)))
				(body
					(if
						(:doc "Separate consecutive native arguments with a comma.")
						(bool.not (i32.eq (local argument) (local first)))
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))))
					(let param (slice.load (local parameters) (local formal)))
					(let mode (record.get (local param) c_mode))
					(if
						(:doc "Read each converted const char pointer from the preparation array.")
						(call is_c_string_mode (local mode))
						(then
							(set (local cursor) (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
								(u8 97) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 91) (local writing)))
							(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor)
								(local converted) (borrow-mut (local digits)) (local writing)))
							(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) (u32 5) (local writing)))
							(set (local converted) (i32.add.wrapping (local converted) (i32 1))))
						(else
							(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local argument) (local tree_base)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(if
								(:doc "Pass the bounded view's original pointer with its const or mutable access.")
								(call is_c_bytes_mode (local mode))
								(then (set (local cursor) (call write_slice_items (borrow-mut (local output)) (local cursor) (local writing)))))))
					(set (local argument) (record.get (slice.load (local nodes) (local argument)) next_sibling))
					(set (local formal) (i32.add.wrapping (local formal) (i32 1)))))
			(return (call c_string_text (borrow-mut (local output)) (local cursor) (u32 7) (local writing)))))

	(fn write_c_string_setup
		(:doc `Prepare one scratch array for all captured C-string arguments.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parameters (shared-slice ScalarParameter))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (record.get (local caller) tree_base))
			(let-mut cursor (call write_c_string_descriptors (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (local expression) (local caller) (local callee) (local index)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(set (local cursor) (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
				(u8 98) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) (u32 4) (local writing)))
			(set (local cursor) (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
				(u8 97) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(let-mut digits (array.alloc u8 (i32 11)))
			(set (local cursor) (call write_site_number (borrow-mut (local output)) (local cursor)
				(record.get (local callee) c_strings) (borrow-mut (local digits)) (local writing)))
			(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) (u32 7) (local writing)))
			(return (local cursor))))

	(fn write_c_argument_call
		(:doc `Check, prepare, invoke, and release in one evaluation step with a saved result.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parameters (shared-slice ScalarParameter))
			(expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction) (index i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (record.get (local caller) tree_base))
			(let-mut cursor (local offset))
			(if
				(:doc "Reject any bad byte extent before allocating string scratch or entering C.")
				(i32.lt (i32 0) (record.get (local callee) c_bytes))
				(then (set (local cursor) (call write_c_byte_checks (borrow-shared (local source))
					(borrow-shared (local nodes)) (borrow-shared (local parameters))
					(local expression) (local caller) (local callee)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(let strings (i32.lt (i32 0) (record.get (local callee) c_strings)))
			(if
				(:doc "Only a C-string contract materializes backing storage.")
				(local strings)
				(then (set (local cursor) (call write_c_string_setup (borrow-shared (local source))
					(borrow-shared (local nodes)) (borrow-shared (local parameters))
					(local expression) (local caller) (local callee) (local index)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(set (local cursor) (call write_c_native_invocation (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (local expression) (local callee) (local tree_base) (local index)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Keep the borrowed byte pointers in their caller's storage.")
				(bool.not (local strings))
				(then (return (local cursor))))
			(set (local cursor) (call c_string_text (borrow-mut (local output)) (local cursor) (u32 6) (local writing)))
			(set (local cursor) (call write_c_string_scratch (borrow-shared (local source)) (local index) (local tree_base)
				(u8 98) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_string_text (borrow-mut (local output)) (local cursor) (u32 7) (local writing))))))
