(module emit_c_record_in
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage the checked record inputs on the original C place for exactly one invocation.")

	(use wove-file "../c/arguments.wove" (only is_c_array_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_writable_slice (type ScalarRecord)))
	(use wove-file "./c_extents.wove" (only map_c_actuals write_c_array_pointer_type (type CActual)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_span write_temporary_name))

	(let input_open "__extension__ ({WVRT_C_RECORD_INPUT_BIND(")
	(let mutable_bytes "void*")
	(let shared_bytes "const void*")
	(let view_items ".wvrt_items,")
	(let after_bind ");")
	(let save_result " wvrt_record_input_result=")
	(let restore ");WVRT_C_RECORD_INPUT_RESTORE(")
	(let yield_result "wvrt_record_input_result;")
	(let input_close "});")

	(fn write_record_input_fields
		(:doc "Use the C field names from the mapping verbatim.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let name (nodes.get (struct:get callee c_input_pointer_name)))
			(let count (nodes.get (struct:get callee c_input_count_name)))
			(let pointer (call c_span (borrow-shared source) (struct:get name start) (struct:get name end)
				(borrow-mut output) offset writing))
			(let comma (call c_byte (borrow-mut output) pointer 44u8 writing))
			(return (call c_span (borrow-shared source) (struct:get count start) (struct:get count end)
				(borrow-mut output) comma writing))))

	(fn open_record_input
		(:doc "Use the captured record address, slice, and count after their normal call checks.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (expression ScalarExpression) (caller ScalarFunction)
			(callee ScalarFunction) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let first (struct:get callee params))
			(let-mut actuals (array:alloc CActual (struct:get callee arity)))
			(call map_c_actuals (borrow-shared nodes) (struct:get expression first)
				(borrow-shared parameters) first (borrow-mut actuals))
			(let record (actuals.get (i32:sub (struct:get callee c_input_record) first)))
			(let data (actuals.get (i32:sub (struct:get callee c_input_data) first)))
			(let count (actuals.get (i32:sub (struct:get callee c_input_count) first)))
			(let begin (call c_literal_text (borrow-shared input_open) (borrow-mut output) offset writing))
			(let address (call write_temporary_name (borrow-shared nodes) (struct:get record node) (borrow-mut output) begin name_prefix writing))
			(let comma (call c_byte (borrow-mut output) address 44u8 writing))
			(let names (call write_record_input_fields (borrow-shared source) (borrow-shared nodes)
				callee (borrow-mut output) comma writing))
			(let-mut cursor (call c_byte (borrow-mut output) names 44u8 writing))
			(let mode (struct:get (parameters.get (struct:get callee c_input_data)) c_mode))
			(let type (struct:get data type))
			(if
				(:doc "Element loans use their exact typed C pointer, while byte loans use the matching void pointer.")
				(call is_c_array_mode mode)
				(then (set cursor (call write_c_array_pointer_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) type (borrow-mut output) cursor name_prefix writing)))
				(else
					(if
						(:doc "Preserve the byte view's read or write capability in the native field check.")
						(call is_writable_slice type)
						(then (set cursor (call c_literal_text (borrow-shared mutable_bytes)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared shared_bytes)
							(borrow-mut output) cursor writing))))))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				(struct:get count type) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) (struct:get data node) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared view_items) (borrow-mut output) cursor writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) (struct:get count node) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared after_bind) (borrow-mut output) cursor writing))
			(let result (struct:get callee result))
			(if
				(:doc "Save any value before restoring the original record members.")
				(u32:not-eq result (call void_type))
				(then
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
						result (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared save_result) (borrow-mut output) cursor writing))))
			(return cursor)))

	(fn close_record_input
		(:doc "Restore the two native fields before making the invocation's result available.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let begin (call c_literal_text (borrow-shared restore) (borrow-mut output) offset writing))
			(let fields (call write_record_input_fields (borrow-shared source) (borrow-shared nodes)
				callee (borrow-mut output) begin writing))
			(let-mut cursor (call c_literal_text (borrow-shared after_bind) (borrow-mut output) fields writing))
			(if
				(:doc "The last expression publishes the saved status after cleanup.")
				(u32:not-eq (struct:get callee result) (call void_type))
				(then (set cursor (call c_literal_text (borrow-shared yield_result) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared input_close) (borrow-mut output) cursor writing))))
)
