(module emit_c_callbacks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit synchronous C callbacks with exact native prototypes and scoped Wove views.")

	(use wove-file "../c/arguments.wove" (only (value c_adapted_callback_argument)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/callback_types.wove" (only callback_formal_shape (type CallbackShape)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./function_names.wove" (only write_function_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text write_callback_adapter_name))

	(let error_pointer "int (*)(const char *,int)")
	(let error_formals "(const char *wvrt_path,int wvrt_error)")
	(let error_argument ",wvrt_error")
	(let callback_pointer "int (*)(const char *,const struct ")
	(let callback_formals "(const char *wvrt_path,const struct ")
	(let pointer_visit " *,int")
	(let named_visit " *wvrt_status,int wvrt_visit")
	(let walk_prefix ",struct ")
	(let walk_pointer " *")
	(let named_walk " *wvrt_walk")
	(let adapter_definition "static __attribute__((unused)) int ")
	(let check_walk "{wvrt_check_c_handle(wvrt_walk")
	(let return_expression "return ")
	(let open_path "(wvrt_borrow_callback_path(wvrt_path")
	(let omit_status ",wvrt_visit==(")
	(let status_and_visit ")?NULL:wvrt_status,wvrt_visit")
	(let pass_walk ",wvrt_walk")
	(let adapter_end ");}\n")

	(fn write_callback_token
		(:doc "Emit a C identifier checked as part of the native callback signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let token (nodes.get index))
			(return (call c_span (borrow-shared source) token/start token/end
				(borrow-mut output) offset writing))))

	(fn write_callback_formals
		(:doc "Share the precise C callback types between the pointer assertion and the adapter definition.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (shape CallbackShape) (named bool)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(if
				(:doc "The error adapter receives the original C path and signed error without a record.")
				(i32:eq shape/arity 2i32)
				(then
					(if
						(:doc "Use the same error prototype with or without parameter names.")
						named
						(then (return (call c_literal_text (borrow-shared error_formals) (borrow-mut output) offset writing))))
					(return (call c_literal_text (borrow-shared error_pointer) (borrow-mut output) offset writing))))
			(let-mut cursor offset)
			(if
				(:doc "A definition names its operands, while the prototype uses an abstract pointer declarator.")
				named
				(then (set cursor (call c_literal_text (borrow-shared callback_formals)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared callback_pointer)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_callback_token (borrow-shared source) (borrow-shared nodes)
				shape/status (borrow-mut output) cursor writing))
			(if
				(:doc "The status record is const and the next operand keeps the C int type.")
				named
				(then (set cursor (call c_literal_text (borrow-shared named_visit)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared pointer_visit)
					(borrow-mut output) cursor writing))))
			(let walk shape/walk)
			(if
				(:doc "An extended walk receives the position record as a mutable C pointer.")
				walk.not-ltz
				(then
					(set cursor (call c_literal_text (borrow-shared walk_prefix) (borrow-mut output) cursor writing))
					(set cursor (call write_callback_token (borrow-shared source) (borrow-shared nodes)
						walk (borrow-mut output) cursor writing))
					(if
						(:doc "Use the same pointer qualification with or without a parameter name.")
						named
						(then (set cursor (call c_literal_text (borrow-shared named_walk)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared walk_pointer)
							(borrow-mut output) cursor writing))))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))

	(fn write_callback_pointer_type
		(:doc "Write the exact adapted parameter type within the containing C prototype.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (param ScalarParameter)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let shape (call callback_formal_shape (borrow-shared source) (borrow-shared nodes) param/name))
			(return (call write_callback_formals (borrow-shared source) (borrow-shared nodes) shape (bool false)
				(borrow-mut output) offset writing))))

	(fn write_callback_adapter
		(:doc "Lend the original path and any native records for one invocation, returning the result unchanged.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (shape CallbackShape) (function ScalarFunction)
			(row ScalarExpression) (index i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared adapter_definition) (borrow-mut output) offset writing))
			(set cursor (call write_callback_adapter_name index (borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_callback_formals (borrow-shared source) (borrow-shared nodes) shape (bool true)
				(borrow-mut output) cursor writing))
			(let file row/asset_start)
			(let start row/start)
			(let end row/end)
			(let extended (i32:not-ltz shape/walk))
			(if
				(:doc "The extended callback contract supplies a present position record.")
				extended
				(then
					(set cursor (call c_literal_text (borrow-shared check_walk) (borrow-mut output) cursor writing))
					(set cursor (call close_runtime_call (borrow-mut output) cursor file start end writing))
					(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing)))
				(else (set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))))
			(set cursor (call c_literal_text (borrow-shared return_expression) (borrow-mut output) cursor writing))
			(set cursor (call write_function_name (borrow-shared source) (borrow-shared nodes) function
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared open_path) (borrow-mut output) cursor writing))
			(set cursor (call close_runtime_call (borrow-mut output) cursor file start end writing))
			(if
				(:doc "Forward the sign and value of the native error directly to Wove.")
				(i32:eq shape/arity 2i32)
				(then
					(set cursor (call c_literal_text (borrow-shared error_argument) (borrow-mut output) cursor writing))
					(return (call c_literal_text (borrow-shared adapter_end) (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared omit_status) (borrow-mut output) cursor writing))
			(set cursor (call write_callback_token (borrow-shared source) (borrow-shared nodes)
				shape/unavailable (borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared status_and_visit) (borrow-mut output) cursor writing))
			(if
				(:doc "C and Wove retain the same original fourth pointer with their respective access modes.")
				extended
				(then (set cursor (call c_literal_text (borrow-shared pass_walk) (borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared adapter_end) (borrow-mut output) cursor writing))))

	(fn write_callback_adapters
		(:doc "Emit a direct private adapter for each planned borrowed callback actual.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index 0i32)
			(while
				(:doc "A source argument row uniquely identifies its adapter, including calls to different native declarations.")
				(index.lt expressions.len)
				(body
					(let row (expressions.get index))
					(if
						(:doc "Only adapted callbacks need a separate C function.")
						(u32:eq row/kind c_adapted_callback_argument)
						(then
							(let param (parameters.get row/asset_end))
							(let shape (call callback_formal_shape (borrow-shared source) (borrow-shared nodes) param/name))
							(set cursor (call write_callback_adapter (borrow-shared source) (borrow-shared nodes) shape
								(functions.get row/target) row index
								(borrow-mut output) cursor name_prefix writing))))
					(set index index.inc)))
			(return cursor)))
)
