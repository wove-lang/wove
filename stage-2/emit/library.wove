(module emit_library
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check and render the same public ABI for Wove wrappers, C prototypes, and the dynamic linker.")

	(use wove-file "../c/export_names.wove" (only reserved_public_c_name))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/c_names.wove" (only native_symbol_start native_symbol_end))
	(use wove-file "../source/exports.wove" (only c_export_directive))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../scalar/records.wove" (only is_writable_slice))
	(use wove-file "./library_views.wove" (only export_scalar export_view_element has_export_views write_export_type write_view_formals write_view_value write_result_formal write_view_checks write_view_return (value export_view_header) (value export_view_runtime) (value export_status_type)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text native_name_prefix_slot))
	(use wove-file "./runtime.wove" (only write_c_number))
	(use wove-file "./function_names.wove" (only write_function_name))

	(let library_header_marker "/* Generated by Wove for a shared library. */\n")
	(let header_open "#pragma once\n#include <stdbool.h>\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n")
	(let header_close "#ifdef __cplusplus\n}\n#endif\n")
	(let wrapper_open "#define WVEX_LABEL_(x) #x\n#define WVEX_LABEL(x) WVEX_LABEL_(x)\n")
	(let visibility "__attribute__((visibility(\"default\"))) ")
	(let wrapper_prefix "wvex_")
	(let linkage " __asm__(WVEX_LABEL(__USER_LABEL_PREFIX__) \"")
	(let linkage_end "\");\n")
	(let prototype_end ";\n")
	(let wrapper_body " { ")
	(let return_word "return ")
	(let wrapper_end "); }\n")
	(let empty_formals "void")
	(let argument_separator ", ")
	(let argument_name " wvex_arg")
	(let elf_begin "{\n")
	(let elf_global "global:\n")
	(let elf_symbol_end "\";\n")
	(let elf_end "local: *;\n};\n")
	(struct ExportCheck (fields (file i32) (start i32) (end i32) (error u32)))

	(fn is_library_export
		(:doc "Only a concrete Wove function can contribute a public wrapper.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction))
		(returns bool)
		(body
			(return (bool.and (i32.not-ltz (struct.get (local function) body))
				(i32.not-ltz (call c_export_directive (borrow-shared (local source)) (borrow-shared (local nodes))
					(array.load (local nodes) (struct.get (local function) declaration))))))))

	(fn reserved_export
		(:doc "Check consumer-facing reserved words and aliases for generated private Wove names.")
		(params (source (shared-array u8)) (name SourceNode))
		(returns bool)
		(body
			(let start (struct.get (local name) start))
			(let end (struct.get (local name) end))
			(return (bool.or (i32.not-ltz (call native_name_prefix_slot (borrow-shared (local source)) (local start) (local end)))
				(call reserved_public_c_name (borrow-shared (local source)) (local start) (local end))))))

	(fn export_error
		(:doc "Attach a rejected name or ABI type to its original declaration span.")
		(params (function ScalarFunction) (site SourceNode) (error u32)) (returns ExportCheck)
		(body
			(let base (struct.get (local function) source_base))
			(return (struct.new ExportCheck (file (struct.get (local function) file))
				(start (i32.sub (struct.get (local site) start) (local base)))
				(end (i32.sub (struct.get (local site) end) (local base))) (error (local error))))))

	(fn check_library_exports
		(:doc "Validate the whole reached public namespace once, before either C emission pass.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter))) (returns ExportCheck)
		(body
			(let count (call checked_function_count (borrow-shared (local functions))))
			(let-mut index 0i32)
			(while
				(:doc "Each exact defining function row contributes at most one C symbol.")
				(i32.lt (local index) (local count))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "Check only declarations that request the public ABI.")
						(call is_library_export (borrow-shared (local source)) (borrow-shared (local nodes)) (local function))
						(then
							(let name (array.load (local nodes) (struct.get (local function) name)))
							(if
								(:doc "Reject reserved identifiers before checking peer declarations.")
								(call reserved_export (borrow-shared (local source)) (local name))
								(then (return (call export_error (local function) (local name) 33u32))))
							(let result (struct.get (local function) result))
							(if
								(:doc "Void is permitted only as a result.")
								(bool.and (u32.not-eq (local result) (call void_type)) (bool.not (call export_scalar (local result))))
								(then (return (call export_error (local function) (local name) 23u32))))
							(let first (struct.get (local function) params))
							(let-mut parameter 0i32)
							(while
								(:doc "Admit only ABI scalars and borrows of ABI scalar elements.")
								(i32.lt (local parameter) (struct.get (local function) arity))
								(body
									(let row (array.load (local parameters) (i32.add (local first) (local parameter))))
									(if
										(:doc "Report the unsupported formal's source name.")
										(bool.not (bool.or (call export_scalar (struct.get (local row) type))
											(u32.gtz (call export_view_element (struct.get (local row) type)))))
										(then (return (call export_error (local function) (array.load (local nodes) (struct.get (local row) name)) 23u32))))
									(set (local parameter) (i32.inc (local parameter)))))
							(let-mut other 0i32)
							(while
								(:doc "Prior exports and all selected C functions can claim the same external symbol.")
								(i32.lt (local other) (local count))
								(body
									(let peer (array.load (local functions) (local other)))
									(if
										(:doc "Imports renamed in Wove still refer to their defining C or Wove name.")
										(bool.or (i32.ltz (struct.get (local peer) body))
											(bool.and (i32.lt (local other) (local index))
												(call is_library_export (borrow-shared (local source)) (borrow-shared (local nodes)) (local peer))))
										(then
											(let spelling (array.load (local nodes) (struct.get (local peer) name)))
											(if
												(:doc "Only exact native spellings conflict.")
												(call same_bytes (borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end)
													(borrow-shared (local source)) (call native_symbol_start (local spelling)) (call native_symbol_end (local spelling)))
												(then (return (call export_error (local function) (local name) 32u32))))))
									(set (local other) (i32.inc (local other)))))))
					(set (local index) (i32.inc (local index)))))
			(return (struct.new ExportCheck (file 0i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn write_export_argument
		(:doc "Write one ABI argument as a type, named formal, or forwarded Wove value.")
		(params (type u32) (index i32) (form u32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let element (call export_view_element (local type)))
			(if
				(:doc "A view expands in the C prototype and becomes one descriptor in the Wove call.")
				(u32.gtz (local element))
				(then
					(let mutability (call is_writable_slice (local type)))
					(if
						(:doc "The call borrows only after validating the pointer and count.")
						(u32.eq (local form) 2u32)
						(then (return (call write_view_value (local mutability) (local index)
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call write_view_formals (local element) (local mutability) (local index)
						(u32.eqz (local form)) (borrow-mut (local output)) (local offset) (local writing)))))
			(let-mut cursor (local offset))
			(if
				(:doc "A call uses the scalar argument without restating its type.")
				(u32.not-eq (local form) 2u32)
				(then (set (local cursor) (call write_export_type (local type) (u32.eqz (local form))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if (u32.eqz (local form)) (then (return (local cursor))))
			(set (local cursor) (call c_literal_text (borrow-shared (local argument_name)) (borrow-mut (local output)) (local cursor) (local writing)))
			(return (call write_c_number (borrow-mut (local output)) (local cursor) (local index) (local writing)))))

	(fn write_export_arguments
		(:doc "Write typed prototype formals, private named formals, or the forwarded argument list.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter)) (form u32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (local offset))
			(let arity (struct.get (local function) arity))
			(if
				(:doc "An empty C declaration has an explicit void prototype.")
				(bool.and (i32.eqz (local arity)) (u32.not-eq (local form) 2u32))
				(then (return (call c_literal_text (borrow-shared (local empty_formals)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(let-mut index 0i32)
			(while
				(:doc "Keep parameter order and exact declared types.")
				(i32.lt (local index) (local arity))
				(body
					(if
						(:doc "Only later arguments need separators.")
						(i32.gtz (local index))
						(then (set (local cursor) (call c_literal_text (borrow-shared (local argument_separator)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(let row (array.load (local parameters) (i32.add (struct.get (local function) params) (local index))))
					(set (local cursor) (call write_export_argument (struct.get (local row) type) (local index) (local form)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(return (local cursor))))

	(fn write_export_signature
		(:doc "Share one signature writer between wrappers and their C header declarations.")
		(params (source (shared-array u8)) (name SourceNode) (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(output (mut-array u8)) (offset u32) (private bool) (writing bool)) (returns u32)
		(body
			(let checked (call has_export_views (local function) (borrow-shared (local parameters))))
			(let result (struct.get (local function) result))
			(let-mut cursor (local offset))
			(if
				(:doc "Checked wrappers return a status. Ordinary scalar or void exports retain their ABI.")
				(local checked)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local export_status_type))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call write_export_type (local result) (bool.not (local private))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(let-mut form 0u32)
			(if
				(:doc "The wrapper's C identifier is independent of the public linker name.")
				(local private)
				(then
					(set (local form) 1u32)
					(set (local cursor) (call c_literal_text (borrow-shared (local wrapper_prefix)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(let symbol (call c_span (borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(let args (call c_byte (borrow-mut (local output)) (local symbol) 40u8 (local writing)))
			(set (local cursor) (call write_export_arguments (local function) (borrow-shared (local parameters)) (local form)
				(borrow-mut (local output)) (local args) (local writing)))
			(if
				(:doc "A scalar result of a checked wrapper has one final output parameter.")
				(bool.and (local checked) (u32.not-eq (local result) (call void_type)))
				(then (set (local cursor) (call write_result_formal (local result) (bool.not (local private))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))

	(fn write_export_wrapper
		(:doc "Write an externally visible trampoline with an exact native label and a private Wove target.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load (local nodes) (struct.get (local function) name)))
			(let visible (call c_literal_text (borrow-shared (local visibility)) (borrow-mut (local output)) (local offset) (local writing)))
			(let declared (call write_export_signature (borrow-shared (local source)) (local name) (local function)
				(borrow-shared (local parameters)) (borrow-mut (local output)) (local visible) (bool true) (local writing)))
			(let label (call c_literal_text (borrow-shared (local linkage)) (borrow-mut (local output)) (local declared) (local writing)))
			(let symbol (call c_span (borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end)
				(borrow-mut (local output)) (local label) (local writing)))
			(let next (call c_literal_text (borrow-shared (local linkage_end)) (borrow-mut (local output)) (local symbol) (local writing)))
			(let defined (call write_export_signature (borrow-shared (local source)) (local name) (local function)
				(borrow-shared (local parameters)) (borrow-mut (local output)) (local next) (bool true) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local wrapper_body)) (borrow-mut (local output)) (local defined) (local writing)))
			(let checked (call has_export_views (local function) (borrow-shared (local parameters))))
			(let result (struct.get (local function) result))
			(if
				(:doc "Prepare validated loans or use the original scalar or void trampoline.")
				(local checked)
				(then (set (local cursor) (call write_view_checks (local function) (borrow-shared (local parameters))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(if
						(:doc "An ordinary scalar result returns directly to C.")
						(u32.not-eq (local result) (call void_type))
						(then (set (local cursor) (call c_literal_text (borrow-shared (local return_word))
							(borrow-mut (local output)) (local cursor) (local writing)))))))
			(let callee (call write_function_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local function)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(let open (call c_byte (borrow-mut (local output)) (local callee) 40u8 (local writing)))
			(let args (call write_export_arguments (local function) (borrow-shared (local parameters)) 2u32
				(borrow-mut (local output)) (local open) (local writing)))
			(if
				(:doc "Store checked results after the Wove call and report success.")
				(local checked)
				(then (return (call write_view_return (local result) (borrow-mut (local output)) (local args) (local writing)))))
			(return (call c_literal_text (borrow-shared (local wrapper_end)) (borrow-mut (local output)) (local args) (local writing)))))

	(fn write_library_abi
		(:doc "Visit each checked export in the same order for C wrappers, the public header, and the linker allowlist.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (output (mut-array u8)) (offset u32)
			(name_prefix i32) (form u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Select the matching file prologue. A Darwin symbol list has none.")
				(u32.eqz (local form))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local wrapper_open)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(if
						(:doc "Start a self-contained public header.")
						(u32.eq (local form) 1u32)
						(then
							(set (local cursor) (call c_literal_text (borrow-shared (local library_header_marker)) (borrow-mut (local output)) (local cursor) (local writing)))
							(set (local cursor) (call c_literal_text (borrow-shared (local header_open)) (borrow-mut (local output)) (local cursor) (local writing))))
						(else
							(if
								(:doc "An ELF allowlist starts an anonymous version block.")
								(u32.eq (local form) 2u32)
								(then (set (local cursor) (call c_literal_text (borrow-shared (local elf_begin)) (borrow-mut (local output)) (local cursor) (local writing)))))))))
			(let count (call checked_function_count (borrow-shared (local functions))))
			(let-mut index 0i32)
			(let-mut first (bool true))
			(let-mut view_support (bool false))
			(while
				(:doc "The output mode changes only representation, never the selected names.")
				(i32.lt (local index) (local count))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "Skip all private and foreign functions.")
						(call is_library_export (borrow-shared (local source)) (borrow-shared (local nodes)) (local function))
						(then
							(let name (array.load (local nodes) (struct.get (local function) name)))
							(if
								(:doc "Declare checked status once in each unit or header, before its first view export.")
								(bool.and (u32.lt (local form) 2u32)
									(bool.and (bool.not (local view_support))
										(call has_export_views (local function) (borrow-shared (local parameters)))))
								(then
									(if
										(:doc "Only the private C unit needs the runtime helper declarations.")
										(u32.eqz (local form))
										(then (set (local cursor) (call c_literal_text (borrow-shared (local export_view_runtime))
											(borrow-mut (local output)) (local cursor) (local writing)))))
									(set (local cursor) (call c_literal_text (borrow-shared (local export_view_header))
										(borrow-mut (local output)) (local cursor) (local writing)))
									(set (local view_support) (bool true))))
							(if
								(:doc "The C unit has one forwarding definition for each public name.")
								(u32.eqz (local form))
								(then (set (local cursor) (call write_export_wrapper (borrow-shared (local source)) (borrow-shared (local nodes)) (local function)
									(borrow-shared (local parameters)) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
								(else
									(if
										(:doc "The header uses the original name and an exact scalar prototype.")
										(u32.eq (local form) 1u32)
										(then
											(set (local cursor) (call write_export_signature (borrow-shared (local source)) (local name) (local function)
												(borrow-shared (local parameters)) (borrow-mut (local output)) (local cursor) (bool false) (local writing)))
											(set (local cursor) (call c_literal_text (borrow-shared (local prototype_end)) (borrow-mut (local output)) (local cursor) (local writing))))
										(else
											(if
												(:doc "ELF quotes exact names, while Mach-O expects its leading linker underscore.")
												(u32.eq (local form) 2u32)
												(then
													(if
														(:doc "The first ELF export starts the global section.")
														(local first)
														(then (set (local cursor) (call c_literal_text (borrow-shared (local elf_global)) (borrow-mut (local output)) (local cursor) (local writing)))))
													(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing))))
												(else (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))))
											(set (local cursor) (call c_span (borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end)
												(borrow-mut (local output)) (local cursor) (local writing)))
											(if
												(:doc "Terminate the symbol in the selected linker's syntax.")
												(u32.eq (local form) 2u32)
												(then (set (local cursor) (call c_literal_text (borrow-shared (local elf_symbol_end)) (borrow-mut (local output)) (local cursor) (local writing))))
												(else (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))))))))
							(set (local first) (bool false))))
					(set (local index) (i32.inc (local index)))))
			(if
				(:doc "Restrict all other ELF definitions to the link unit.")
				(u32.eq (local form) 2u32)
				(then (return (call c_literal_text (borrow-shared (local elf_end)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Close the consumer's optional C++ linkage block.")
				(u32.eq (local form) 1u32)
				(then (return (call c_literal_text (borrow-shared (local header_close)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (local cursor))))
)
