(module emit_library
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check and render the same public ABI for Wove wrappers, C prototypes, and the dynamic linker.")

	(use wove-file "../c/export_names.wove" (only reserved_public_c_name))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_byte))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/c_names.wove" (only native_symbol_start native_symbol_end))
	(use wove-file "../source/exports.wove" (only c_export_directive))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../scalar/records.wove" (only is_writable_slice))
	(use wove-file "./library_views.wove" (only export_scalar export_view_element has_export_views write_export_type write_view_formals write_view_value write_result_formal write_view_checks write_view_return (value export_view_header) (value export_view_runtime) (value export_status_type)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./names.wove" (only (value export_trampoline_role)))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text native_name_prefix_slot get_name
		(type CNameParent) (type CNameRole) (type CNameSpelling)))
	(use wove-file "./runtime.wove" (only write_c_number))
	(use wove-file "./function_names.wove" (only write_function_name))

	(let library_header_marker "/* Generated by Wove for a shared library. */\n")
	(let header_open "#pragma once\n#include <stdbool.h>\n#include <stdint.h>\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n")
	(let header_close "#ifdef __cplusplus\n}\n#endif\n")
	(let wrapper_open "#define WVEX_LABEL_(x) #x\n#define WVEX_LABEL(x) WVEX_LABEL_(x)\n")
	(let visibility "__attribute__((visibility(\"default\"))) ")
	(let linkage " __asm__(WVEX_LABEL(__USER_LABEL_PREFIX__) \"")
	(let linkage_end "\");\n")
	(let prototype_end ";\n")
	(let wrapper_body " { ")
	(let return_word "return ")
	(let wrapper_end "); }\n")
	(let empty_formals "void")
	(let argument_separator ", ")
	(let argument_name " wvex_arg")
	(let elf_begin "{\n")
	(let elf_global "global:\n")
	(let elf_symbol_end "\";\n")
	(let elf_end "local: *;\n};\n")
	(struct ExportCheck (fields (file i32) (start i32) (end i32) (error u32)))

	(fn is_library_export
		(:doc "Only a concrete Wove function can contribute a public wrapper.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction))
		(returns bool)
		(body
			(return (bool.and (i32.not-ltz (struct.get function body))
				(i32.not-ltz (call c_export_directive (borrow-shared source) (borrow-shared nodes)
					(array.load nodes (struct.get function declaration))))))))

	(fn reserved_export
		(:doc "Check consumer-facing reserved words and aliases for generated private Wove names.")
		(params (source (shared-array u8)) (name SourceNode))
		(returns bool)
		(body
			(let start (struct.get name start))
			(let end (struct.get name end))
			(return (bool.or (i32.not-ltz (call native_name_prefix_slot (borrow-shared source) start end))
				(call reserved_public_c_name (borrow-shared source) start end)))))

	(fn export_error
		(:doc "Attach a rejected name or ABI type to its original declaration span.")
		(params (function ScalarFunction) (site SourceNode) (error u32)) (returns ExportCheck)
		(body
			(let base (struct.get function source_base))
			(return (struct.new ExportCheck (file (struct.get function file))
				(start (i32.sub (struct.get site start) base))
				(end (i32.sub (struct.get site end) base)) (error error)))))

	(fn check_library_exports
		(:doc "Validate the whole reached public namespace once, before either C emission pass.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter))) (returns ExportCheck)
		(body
			(let count (call checked_function_count (borrow-shared functions)))
			(let-mut index 0i32)
			(while
				(:doc "Each exact defining function row contributes at most one C symbol.")
				(i32.lt index count)
				(body
					(let function (array.load functions index))
					(if
						(:doc "Check only declarations that request the public ABI.")
						(call is_library_export (borrow-shared source) (borrow-shared nodes) function)
						(then
							(let name (array.load nodes (struct.get function name)))
							(if
								(:doc "Reject reserved identifiers before checking peer declarations.")
								(call reserved_export (borrow-shared source) name)
								(then (return (call export_error function name 33u32))))
							(let result (struct.get function result))
							(if
								(:doc "Void is permitted only as a result.")
								(bool.and (u32.not-eq result (call void_type)) (bool.not (call export_scalar result)))
								(then (return (call export_error function name 23u32))))
							(let first (struct.get function params))
							(let-mut parameter 0i32)
							(while
								(:doc "Admit only ABI scalars and borrows of ABI scalar elements.")
								(i32.lt parameter (struct.get function arity))
								(body
									(let row (array.load parameters (i32.add first parameter)))
									(if
										(:doc "Report the unsupported formal's source name.")
										(bool.not (bool.or (call export_scalar (struct.get row type))
											(u32.gtz (call export_view_element (struct.get row type)))))
										(then (return (call export_error function (array.load nodes (struct.get row name)) 23u32))))
									(set parameter (i32.inc parameter))))
							(let-mut other 0i32)
							(while
								(:doc "Prior exports and all selected C functions can claim the same external symbol.")
								(i32.lt other count)
								(body
									(let peer (array.load functions other))
									(if
										(:doc "Imports renamed in Wove still refer to their defining C or Wove name.")
										(bool.or (i32.ltz (struct.get peer body))
											(bool.and (i32.lt other index)
												(call is_library_export (borrow-shared source) (borrow-shared nodes) peer)))
										(then
											(let spelling (array.load nodes (struct.get peer name)))
											(if
												(:doc "Only exact native spellings conflict.")
												(call same_bytes (borrow-shared source) (struct.get name start) (struct.get name end)
													(borrow-shared source) (call native_symbol_start spelling) (call native_symbol_end spelling))
												(then (return (call export_error function name 32u32))))))
									(set other (i32.inc other))))))
					(set index (i32.inc index))))
			(return (struct.new ExportCheck (file 0i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn write_export_argument
		(:doc "Write one ABI argument as a type, named formal, or forwarded Wove value.")
		(params (type u32) (index i32) (form u32) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let element (call export_view_element type))
			(if
				(:doc "A view expands in the C prototype and becomes one descriptor in the Wove call.")
				(u32.gtz element)
				(then
					(let mutability (call is_writable_slice type))
					(if
						(:doc "The call borrows only after validating the pointer and count.")
						(u32.eq form 2u32)
						(then (return (call write_view_value mutability index
							(borrow-mut output) offset writing))))
					(return (call write_view_formals element mutability index
						(u32.eqz form) (borrow-mut output) offset writing))))
			(let-mut cursor offset)
			(if
				(:doc "A call uses the scalar argument without restating its type.")
				(u32.not-eq form 2u32)
				(then (set cursor (call write_export_type type (u32.eqz form)
					(borrow-mut output) cursor writing))))
			(if (u32.eqz form) (then (return cursor)))
			(set cursor (call c_literal_text (borrow-shared argument_name) (borrow-mut output) cursor writing))
			(return (call write_c_number (borrow-mut output) cursor index writing))))

	(fn write_export_arguments
		(:doc "Write typed prototype formals, private named formals, or the forwarded argument list.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter)) (form u32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(let arity (struct.get function arity))
			(if
				(:doc "An empty C declaration has an explicit void prototype.")
				(bool.and (i32.eqz arity) (u32.not-eq form 2u32))
				(then (return (call c_literal_text (borrow-shared empty_formals) (borrow-mut output) cursor writing))))
			(let-mut index 0i32)
			(while
				(:doc "Keep parameter order and exact declared types.")
				(i32.lt index arity)
				(body
					(if
						(:doc "Only later arguments need separators.")
						(i32.gtz index)
						(then (set cursor (call c_literal_text (borrow-shared argument_separator) (borrow-mut output) cursor writing))))
					(let row (array.load parameters (i32.add (struct.get function params) index)))
					(set cursor (call write_export_argument (struct.get row type) index form
						(borrow-mut output) cursor writing))
					(set index (i32.inc index))))
			(return cursor)))

	(fn write_export_signature
		(:doc "Share one signature writer between wrappers and their C header declarations.")
		(params (source (shared-array u8)) (name SourceNode) (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (private bool) (writing bool)) (returns u32)
		(body
			(let checked (call has_export_views function (borrow-shared parameters)))
			(let result (struct.get function result))
			(let-mut cursor offset)
			(if
				(:doc "Checked wrappers return a status. Ordinary scalar or void exports retain their ABI.")
				checked
				(then (set cursor (call c_literal_text (borrow-shared export_status_type)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call write_export_type result (bool.not private)
					(borrow-mut output) cursor writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(let-mut form 0u32)
			(let start (struct.get name start))
			(let end (struct.get name end))
			(if
				(:doc "The private role extends the defining function fingerprint and retains its exact collision rank.")
				private
				(then
					(set form 1u32)
					(let identity (call fnv1a_byte (struct.get function identity) export_trampoline_role))
					(set cursor (call get_name
						(struct.new CNameParent (identity identity) (slot (struct.get function c_name_slot)))
						(struct.new CNameRole (tag export_trampoline_role))
						(struct.new CNameSpelling (start start) (end end) (trailing 0u8))
						(borrow-shared source) (borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call c_span (borrow-shared source) start end
					(borrow-mut output) cursor writing))))
			(let args (call c_byte (borrow-mut output) cursor 40u8 writing))
			(set cursor (call write_export_arguments function (borrow-shared parameters) form
				(borrow-mut output) args writing))
			(if
				(:doc "A scalar result of a checked wrapper has one final output parameter.")
				(bool.and checked (u32.not-eq result (call void_type)))
				(then (set cursor (call write_result_formal result (bool.not private)
					(borrow-mut output) cursor writing))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))

	(fn write_export_wrapper
		(:doc "Write an externally visible trampoline with an exact native label and a private Wove target.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load nodes (struct.get function name)))
			(let visible (call c_literal_text (borrow-shared visibility) (borrow-mut output) offset writing))
			(let declared (call write_export_signature (borrow-shared source) name function
				(borrow-shared parameters) (borrow-mut output) visible name_prefix (bool true) writing))
			(let label (call c_literal_text (borrow-shared linkage) (borrow-mut output) declared writing))
			(let symbol (call c_span (borrow-shared source) (struct.get name start) (struct.get name end)
				(borrow-mut output) label writing))
			(let next (call c_literal_text (borrow-shared linkage_end) (borrow-mut output) symbol writing))
			(let defined (call write_export_signature (borrow-shared source) name function
				(borrow-shared parameters) (borrow-mut output) next name_prefix (bool true) writing))
			(let-mut cursor (call c_literal_text (borrow-shared wrapper_body) (borrow-mut output) defined writing))
			(let checked (call has_export_views function (borrow-shared parameters)))
			(let result (struct.get function result))
			(if
				(:doc "Prepare validated loans or use the original scalar or void trampoline.")
				checked
				(then (set cursor (call write_view_checks function (borrow-shared parameters)
					(borrow-mut output) cursor writing)))
				(else
					(if
						(:doc "An ordinary scalar result returns directly to C.")
						(u32.not-eq result (call void_type))
						(then (set cursor (call c_literal_text (borrow-shared return_word)
							(borrow-mut output) cursor writing))))))
			(let callee (call write_function_name (borrow-shared source) (borrow-shared nodes) function
				(borrow-mut output) cursor name_prefix writing))
			(let open (call c_byte (borrow-mut output) callee 40u8 writing))
			(let args (call write_export_arguments function (borrow-shared parameters) 2u32
				(borrow-mut output) open writing))
			(if
				(:doc "Store checked results after the Wove call and report success.")
				checked
				(then (return (call write_view_return result (borrow-mut output) args writing))))
			(return (call c_literal_text (borrow-shared wrapper_end) (borrow-mut output) args writing))))

	(fn write_library_abi
		(:doc "Visit each checked export in the same order for C wrappers, the public header, and the linker allowlist.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (output (mut-array u8)) (offset u32)
			(name_prefix i32) (form u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Select the matching file prologue. A Darwin symbol list has none.")
				(u32.eqz form)
				(then (set cursor (call c_literal_text (borrow-shared wrapper_open) (borrow-mut output) cursor writing)))
				(else
					(if
						(:doc "Start a self-contained public header.")
						(u32.eq form 1u32)
						(then
							(set cursor (call c_literal_text (borrow-shared library_header_marker) (borrow-mut output) cursor writing))
							(set cursor (call c_literal_text (borrow-shared header_open) (borrow-mut output) cursor writing)))
						(else
							(if
								(:doc "An ELF allowlist starts an anonymous version block.")
								(u32.eq form 2u32)
								(then (set cursor (call c_literal_text (borrow-shared elf_begin) (borrow-mut output) cursor writing))))))))
			(let count (call checked_function_count (borrow-shared functions)))
			(let-mut index 0i32)
			(let-mut first (bool true))
			(let-mut view_support (bool false))
			(while
				(:doc "The output mode changes only representation, never the selected names.")
				(i32.lt index count)
				(body
					(let function (array.load functions index))
					(if
						(:doc "Skip all private and foreign functions.")
						(call is_library_export (borrow-shared source) (borrow-shared nodes) function)
						(then
							(let name (array.load nodes (struct.get function name)))
							(if
								(:doc "Declare checked status once in each unit or header, before its first view export.")
								(bool.and (u32.lt form 2u32)
									(bool.and (bool.not view_support)
										(call has_export_views function (borrow-shared parameters))))
								(then
									(if
										(:doc "Only the private C unit needs the runtime helper declarations.")
										(u32.eqz form)
										(then (set cursor (call c_literal_text (borrow-shared export_view_runtime)
											(borrow-mut output) cursor writing))))
									(set cursor (call c_literal_text (borrow-shared export_view_header)
										(borrow-mut output) cursor writing))
									(set view_support (bool true))))
							(if
								(:doc "The C unit has one forwarding definition for each public name.")
								(u32.eqz form)
								(then (set cursor (call write_export_wrapper (borrow-shared source) (borrow-shared nodes) function
									(borrow-shared parameters) (borrow-mut output) cursor name_prefix writing)))
								(else
									(if
										(:doc "The header uses the original name and an exact scalar prototype.")
										(u32.eq form 1u32)
										(then
											(set cursor (call write_export_signature (borrow-shared source) name function
												(borrow-shared parameters) (borrow-mut output) cursor name_prefix (bool false) writing))
											(set cursor (call c_literal_text (borrow-shared prototype_end) (borrow-mut output) cursor writing)))
										(else
											(if
												(:doc "ELF quotes exact names, while Mach-O expects its leading linker underscore.")
												(u32.eq form 2u32)
												(then
													(if
														(:doc "The first ELF export starts the global section.")
														first
														(then (set cursor (call c_literal_text (borrow-shared elf_global) (borrow-mut output) cursor writing))))
													(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing)))
												(else (set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))))
											(set cursor (call c_span (borrow-shared source) (struct.get name start) (struct.get name end)
												(borrow-mut output) cursor writing))
											(if
												(:doc "Terminate the symbol in the selected linker's syntax.")
												(u32.eq form 2u32)
												(then (set cursor (call c_literal_text (borrow-shared elf_symbol_end) (borrow-mut output) cursor writing)))
												(else (set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))))))))
							(set first (bool false))))
					(set index (i32.inc index))))
			(if
				(:doc "Restrict all other ELF definitions to the link unit.")
				(u32.eq form 2u32)
				(then (return (call c_literal_text (borrow-shared elf_end) (borrow-mut output) cursor writing))))
			(if
				(:doc "Close the consumer's optional C++ linkage block.")
				(u32.eq form 1u32)
				(then (return (call c_literal_text (borrow-shared header_close) (borrow-mut output) cursor writing))))
			(return cursor)))
)
