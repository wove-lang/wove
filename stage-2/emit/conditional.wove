(module emit_conditional
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write the branch boundaries and shared result of an evaluated conditional value.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/conditional.wove" (only (value conditional_then)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_text_fragment write_temporary_name))

	(let assignment_end ";}")
	(let else_open "else{")

	(fn write_conditional_edge
		(:doc "Open the first arm after the predicate, or assign the completed arm before leaving its scope.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(index i32) (parent i32) (child ScalarExpression) (choice ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Declare one typed result in the enclosing expression scope.")
				(i32.eq index (struct.get choice first))
				(then
					(let type_end (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (struct.get choice type)
						(borrow-mut output) offset name_prefix writing))
					(let space (call c_byte (borrow-mut output) type_end 32u8 writing))
					(let name (call write_temporary_name (borrow-shared source) parent tree_base
						(borrow-mut output) space name_prefix writing))
					(let end (call c_byte (borrow-mut output) name 59u8 writing))
					(let open (call c_text_fragment (borrow-mut output) end 6u32 writing))
					(let predicate (call write_temporary_name (borrow-shared source) index tree_base
						(borrow-mut output) open name_prefix writing))
					(let close (call c_byte (borrow-mut output) predicate 41u8 writing))
					(return (call c_byte (borrow-mut output) close 123u8 writing))))
			(let target (call write_temporary_name (borrow-shared source) parent tree_base
				(borrow-mut output) offset name_prefix writing))
			(let assign (call c_byte (borrow-mut output) target 61u8 writing))
			(let result (call write_temporary_name (borrow-shared source) (struct.get child first) tree_base
				(borrow-mut output) assign name_prefix writing))
			(let closed (call c_literal_text (borrow-shared assignment_end)
				(borrow-mut output) result writing))
			(if
				(:doc "Only the first arm opens an alternate scope.")
				(u32.eq (struct.get child kind) conditional_then)
				(then (return (call c_literal_text (borrow-shared else_open)
					(borrow-mut output) closed writing))))
			(return closed)))
)
