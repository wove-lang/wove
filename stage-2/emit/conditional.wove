(module emit_conditional
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write the branch boundaries and shared result of an evaluated conditional value.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/conditional.wove" (only (value conditional_then)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_text_fragment write_temporary_name))

	(let assignment_end ";}")
	(let else_open "else{")

	(fn write_conditional_edge
		(:doc "Open the first arm after the predicate, or assign the completed arm before leaving its scope.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(index i32) (parent i32) (child ScalarExpression) (choice ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Declare one typed result in the enclosing expression scope.")
				(i32.eq (local index) (struct.get (local choice) first))
				(then
					(let type_end (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (struct.get (local choice) type)
						(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
					(let space (call c_byte (borrow-mut (local output)) (local type_end) 32u8 (local writing)))
					(let name (call write_temporary_name (borrow-shared (local source)) (local parent) (local tree_base)
						(borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
					(let end (call c_byte (borrow-mut (local output)) (local name) 59u8 (local writing)))
					(let open (call c_text_fragment (borrow-mut (local output)) (local end) 6u32 (local writing)))
					(let predicate (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
						(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
					(let close (call c_byte (borrow-mut (local output)) (local predicate) 41u8 (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local close) 123u8 (local writing)))))
			(let target (call write_temporary_name (borrow-shared (local source)) (local parent) (local tree_base)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let assign (call c_byte (borrow-mut (local output)) (local target) 61u8 (local writing)))
			(let result (call write_temporary_name (borrow-shared (local source)) (struct.get (local child) first) (local tree_base)
				(borrow-mut (local output)) (local assign) (local name_prefix) (local writing)))
			(let closed (call c_literal_text (borrow-shared (local assignment_end))
				(borrow-mut (local output)) (local result) (local writing)))
			(if
				(:doc "Only the first arm opens an alternate scope.")
				(u32.eq (struct.get (local child) kind) (local conditional_then))
				(then (return (call c_literal_text (borrow-shared (local else_open))
					(borrow-mut (local output)) (local closed) (local writing)))))
			(return (local closed))))
)
