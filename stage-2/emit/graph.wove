(module emit_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check, emit, and inspect a resolved scalar source graph.

	Build the same scalar plan for both consumers. An emission produces one
	C translation unit across the reached files. An inspection resolves the
	requested spelling in its file and reads the defining declaration's callers.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/graph.wove" (only graph_selection (type GraphModule) (type GraphBinding) (type GraphResult)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_byte))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/callers.wove" (only inspect_graph_name))
	(use wove-file "../scalar/records.wove" (only is_native_record (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/tests.wove" (only discover_graph_tests (type DiscoveredTest)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove"
		(only plan_bodies (type ScalarFunction) (type ScalarParameter)
			(type CallSite)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../scalar/graph.wove" (only layout_trees signature_capacity prepare_graph))
	(use wove-file "./c.wove" (only write_translation_unit))
	(use wove-file "./tests.wove" (only write_test_entry))
	(use wove-file "./embeds.wove" (only bind_graph_embeds bind_module_embeds request_module_embeds))
	(use wove-file "./text.wove" (only native_name_prefix_slot))
	(use wove-file "./c_formals.wove" (only fixed_c_value))
	(use wove-file "../source/c_formals.wove" (only find_c_fixed_formal))
	(use wove-file "./headers.wove" (only include_capacity prepare_includes write_includes (type CInclude)))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset) (type EmbedCheck) embed_check))

	(struct GraphOutput
		(fields (count i32) (declaration i32) (file i32) (start i32) (end i32) (error u32)
			(related_start i32) (related_end i32)))

	(fn graph_output
		(:doc `Package an output count, inspected declaration, or original source diagnostic.`)
		(params (count i32) (declaration i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphOutput)
		(body
			(return (struct.new GraphOutput (count (local count)) (declaration (local declaration))
				(file (local file)) (start (local start)) (end (local end)) (error (local error))
				(related_start -1i32) (related_end -1i32)))))

	(fn reserve_native_prefix
		(:doc `Mark a collision with one explicitly selected native identifier.`)
		(params (arena (shared-slice u8)) (start i32) (end i32) (occupied (mut-slice u8)))
		(returns void)
		(body
			(let slot (call native_name_prefix_slot (borrow-shared (local arena)) (local start) (local end)))
			(if
				(:doc "A higher slot cannot affect the first available choice.")
				(bool.and (bool.not (i32.lt (local slot) 0i32)) (i32.lt (local slot) (slice.len (local occupied))))
				(then (slice.store (local occupied) (local slot) 1u8)))))

	(fn reserve_type_words
		(:doc `Reserve identifiers ending at separators in a checked C type spelling.`)
		(params (text (shared-slice u8)) (occupied (mut-slice u8)))
		(returns void)
		(body
			(let length (slice.len (local text)))
			(let-mut word 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Every type word ends at horizontal space or a pointer star.")
				(i32.lt (local index) (local length))
				(body
					(let next (i32.add.wrapping (local index) 1i32))
					(if
						(:doc "Include complete type words in the prefix check.")
						(bool.not (call is_c_identifier_byte (slice.load (local text) (local index))))
						(then
							(call reserve_native_prefix (borrow-shared (local text)) (local word) (local index)
								(borrow-mut (local occupied)))
							(set (local word) (local next))))
					(set (local index) (local next))))
			(call reserve_native_prefix (borrow-shared (local text)) (local word) (local length)
				(borrow-mut (local occupied)))))

	(fn reserve_type_prefixes
		(:doc `Reserve every identifier in the decoded native type spelling.

		A C typedef shares the identifier namespace with ordinary locals
		and functions. A native type spelling can also be a header macro.`)
		(params (arena (shared-slice u8)) (start i32) (end i32) (occupied (mut-slice u8)))
		(returns void)
		(body
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let value (call decode_string (borrow-shared (local arena))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local decoded))))
			(call reserve_type_words (borrow-shared (slice.range (local decoded) 0i32
				(struct.get (local value) written))) (borrow-mut (local occupied)))))

	(fn native_prefix_capacity
		(:doc `Bound reserved prefixes by selected symbols and the native types and fields they need.

		Every slot also requires a spelling in the arena, so no occupied
		slot can reach signed i32 capacity.`)
		(params (bindings (shared-slice GraphBinding)) (records (shared-slice ScalarRecord)))
		(returns i32)
		(body
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Each selected C declaration contributes at most two symbols plus its type words.")
				(i32.lt (local index) (slice.len (local bindings)))
				(body
					(let binding (slice.load (local bindings) (local index)))
					(if
						(:doc "Ordinary Wove bindings introduce no native symbols.")
						(u32.eq (struct.get (local binding) provider) 8u32)
						(then
							(let type_width (i32.sub.wrapping (struct.get (local binding) type_end) (struct.get (local binding) type_start)))
							(let signature_width (i32.sub.wrapping (struct.get (local binding) signature_end)
								(struct.get (local binding) signature_start)))
							(let width (u32.add.wrapping 2u32
								(u32.add.wrapping (int.convert u32 (local type_width)) (int.convert u32 (local signature_width)))))
							(if
								(:doc "Clamp the upper bound before converting to the slice length.")
								(u32.lt (int.convert u32 (i32.sub.wrapping 2147483647i32 (local count))) (local width))
								(then (return 2147483647i32)))
							(set (local count) (i32.add.wrapping (local count) (int.convert i32 (local width))))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(set (local index) 0i32)
			(while
				(:doc "Include the representation and members of native types used only by a signature or field.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let row (slice.load (local records) (local index)))
					(if (i32.eq (struct.get (local row) name) 0i32) (then (return (local count))))
					(if
						(:doc "A C value type can contribute one user-chosen type word and every exposed field name.")
						(i32.lt 0i32 (struct.get (local row) native))
						(then
							(let-mut width 1i32)
							(if
								(:doc "Record views also reserve the spellings of their exposed fields.")
								(i32.lt 0i32 (struct.get (local row) count))
								(then (set (local width) (i32.add.wrapping (local width) (struct.get (local row) count)))))
							(if
								(:doc "Keep the prefix table length within signed slice bounds.")
								(i32.lt (i32.sub.wrapping 2147483647i32 (local count)) (local width))
								(then (return 2147483647i32)))
							(set (local count) (i32.add.wrapping (local count) (local width)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (local count))))

	(fn reserve_native_types
		(:doc `Protect native type spellings, including dependencies of selected signatures and records.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord)) (occupied (mut-slice u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only the populated type-table prefix can name native type identifiers.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let row (slice.load (local records) (local index)))
					(if (i32.eq (struct.get (local row) name) 0i32) (then (return)))
					(if
						(:doc "Native values keep their original C type literal.")
						(i32.lt 0i32 (struct.get (local row) native))
						(then
							(let literal (slice.load (local nodes) (struct.get (local row) native)))
							(call reserve_type_prefixes (borrow-shared (local arena))
								(struct.get (local literal) start) (struct.get (local literal) end) (borrow-mut (local occupied)))
							(if
								(:doc "A header field spelling can expand as a macro. Keep generated names out of its prefix.")
								(call is_native_record (local row))
								(then
									(let-mut field (struct.get (local row) first))
									(while
										(:doc "Reserve the checked spelling of each member of the view.")
										(i32.lt -1i32 (local field))
										(body
											(let node (slice.load (local nodes) (local field)))
											(let name (slice.load (local nodes) (struct.get (local node) first_child)))
											(call reserve_native_prefix (borrow-shared (local arena)) (struct.get (local name) start)
												(struct.get (local name) end) (borrow-mut (local occupied)))
											(set (local field) (struct.get (local node) next_sibling))))))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))))

	(fn reserve_fixed_formal_names
		(:doc `Keep generated names distinct from header constants supplied implicitly to native calls.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode)) (functions (shared-slice ScalarFunction))
			(occupied (mut-slice u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only native signatures with hidden operands contribute fixed constant spellings.")
				(i32.lt (local index) (slice.len (local functions)))
				(body
					(let function (slice.load (local functions) (local index)))
					(if
						(:doc "Skip the raw formal walk for ordinary declarations.")
						(struct.get (local function) c_fixed)
						(then
							(let-mut row (call find_c_fixed_formal (borrow-shared (local arena)) (borrow-shared (local nodes))
								(struct.get (local function) c_formals)))
							(while
								(:doc "Reserve each checked symbol from the original declaration.")
								(i32.lt -1i32 (local row))
								(body
									(let constant (call fixed_c_value (borrow-shared (local arena)) (borrow-shared (local nodes)) (local row)))
									(call reserve_native_prefix (borrow-shared (local arena)) (struct.get (local constant) start)
										(struct.get (local constant) end) (borrow-mut (local occupied)))
									(set (local row) (call find_c_fixed_formal (borrow-shared (local arena)) (borrow-shared (local nodes))
										(struct.get (slice.load (local nodes) (local row)) next_sibling)))))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))))

	(fn choose_name_prefix
		(:doc `Pick the shortest generated prefix distinct from identifiers in selected C bindings.

		Reserve function symbols, fixed constants, pointer type words, and implicit destructors.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (bindings (shared-slice GraphBinding))
			(nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(functions (shared-slice ScalarFunction)) (occupied (mut-slice u8)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Reserve the possible generated-name prefixes of the original C spellings.")
				(i32.lt (local index) (slice.len (local bindings)))
				(body
					(let binding (slice.load (local bindings) (local index)))
					(if
						(:doc "Only C targets introduce native identifiers.")
						(u32.eq (struct.get (local binding) provider) 8u32)
						(then
							(let base (struct.get (slice.load (local files) (struct.get (local binding) file)) source_start))
							(if
								(:doc "Reserve the ordinary symbol of each selected C function.")
								(bool.not (u32.eq (struct.get (local binding) namespace) 1u32))
								(then (call reserve_native_prefix (borrow-shared (local arena))
									(i32.add.wrapping (local base) (struct.get (local binding) native_start))
									(i32.add.wrapping (local base) (struct.get (local binding) native_end))
									(borrow-mut (local occupied)))))
							(if
								(:doc "Reserve the words in selected native types and the destructor of each owner.")
								(i32.lt 0i32 (struct.get (local binding) native_type))
								(then
									(let type_base (struct.get (slice.load (local files) (struct.get (local binding) native_file)) source_start))
									(if
										(:doc "Only a pointer owner has a native destructor.")
										(i32.lt -1i32 (struct.get (local binding) drop_start))
										(then (call reserve_native_prefix (borrow-shared (local arena))
											(i32.add.wrapping (local type_base) (struct.get (local binding) drop_start))
											(i32.add.wrapping (local type_base) (struct.get (local binding) drop_end))
											(borrow-mut (local occupied)))))
									(call reserve_type_prefixes (borrow-shared (local arena))
										(i32.add.wrapping (local type_base) (struct.get (local binding) type_start))
										(i32.add.wrapping (local type_base) (struct.get (local binding) type_end))
										(borrow-mut (local occupied)))))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(call reserve_native_types (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-mut (local occupied)))
			(call reserve_fixed_formal_names (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-mut (local occupied)))
			(let-mut slot 0i32)
			(while
				(:doc "Use wg unless a selected symbol could overlap its generated names.")
				(bool.and (i32.lt (local slot) (slice.len (local occupied)))
					(u8.eq (slice.load (local occupied) (local slot)) 1u8))
				(body (set (local slot) (i32.add.wrapping (local slot) 1i32))))
			(return (local slot))))

	(fn write_graph_c
		(:doc `Measure and emit the checked graph as a complete C translation unit.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (bindings (shared-slice GraphBinding))
			(trees (shared-slice ScalarTree)) (nodes (shared-slice SourceNode)) (functions (shared-slice ScalarFunction))
			(parameters (shared-slice ScalarParameter)) (statements (shared-slice ScalarStatement))
			(records (shared-slice ScalarRecord)) (expressions (shared-slice ScalarExpression))
			(root i32) (entry i32) (tests (shared-slice DiscoveredTest)) (test_count i32) (private_helpers bool) (output (mut-slice u8)))
		(returns GraphOutput)
		(body
			(let tree (slice.load (local trees) (local root)))
			(let source_base (struct.get (slice.load (local files) (local root)) source_start))
			(let capacity (call include_capacity (borrow-shared (local bindings))))
			(if
				(:doc "The aggregate include storage must fit in the signed slice length.")
				(i32.lt (struct.get (local capacity) bytes) 0i32)
				(then (return (call graph_output 0i32 -1i32 (local root)
					(struct.get (local tree) start) (struct.get (local tree) end) 16u32))))
			(let-mut paths (array.alloc u8 (struct.get (local capacity) bytes)))
			(let-mut includes (array.alloc CInclude (struct.get (local capacity) rows)))
			(let headers (call prepare_includes (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-mut (local paths)) (borrow-mut (local includes))))
			(if
				(:doc "A malformed header operand belongs to the original bridge declaration.")
				(u32.lt 0u32 (struct.get (local headers) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local headers) file)
					(struct.get (local headers) start) (struct.get (local headers) end) (struct.get (local headers) error)))))
			(let-mut occupied (array.alloc u8 (call native_prefix_capacity (borrow-shared (local bindings)) (borrow-shared (local records)))))
			(let name_prefix (call choose_name_prefix (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local nodes)) (borrow-shared (local records))
				(borrow-shared (local functions)) (borrow-mut (local occupied))))
			(let count (struct.get (local headers) count))
			(let prefix (call write_includes (borrow-shared (local paths)) (borrow-shared (local includes))
				(local count) (borrow-mut (local output)) (bool false)))
			(let-mut measured (call write_translation_unit (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) (local prefix)
				(struct.get (local headers) stdint) (struct.get (local headers) runtime) (local private_helpers) (local name_prefix) (bool false)))
			(if
				(:doc "Include the selected-test entry when measuring a test executable.")
				(bool.not (i32.lt (local test_count) 0i32))
				(then (set (local measured) (call write_test_entry (borrow-shared (local arena))
					(borrow-shared (local files)) (borrow-shared (local nodes)) (borrow-shared (local functions))
					(borrow-shared (local tests)) (local test_count) (borrow-mut (local output))
					(local measured) (local name_prefix) (bool false)))))
			(if
				(:doc "Keep the destination untouched when the full unit cannot fit.")
				(u32.lt (int.convert u32 (slice.len (local output))) (local measured))
				(then
					(if
						(:doc "The test executable has a synthetic entry. Use the original module span.")
						(i32.lt (local entry) 0i32)
						(then (return (call graph_output 0i32 -1i32 (local root)
							(struct.get (local tree) start) (struct.get (local tree) end) 16u32))))
					(let node (slice.load (local nodes) (local entry)))
					(return (call graph_output 0i32 -1i32 (local root)
						(i32.sub.wrapping (struct.get (local node) start) (local source_base))
						(i32.sub.wrapping (struct.get (local node) end) (local source_base)) 16u32))))
			(let first (call write_includes (borrow-shared (local paths)) (borrow-shared (local includes))
				(local count) (borrow-mut (local output)) (bool true)))
			(let-mut written (call write_translation_unit (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) (local first)
				(struct.get (local headers) stdint) (struct.get (local headers) runtime) (local private_helpers) (local name_prefix) (bool true)))
			(if
				(:doc "Write exactly the test dispatch measured above, including an empty inventory.")
				(bool.not (i32.lt (local test_count) 0i32))
				(then (set (local written) (call write_test_entry (borrow-shared (local arena))
					(borrow-shared (local files)) (borrow-shared (local nodes)) (borrow-shared (local functions))
					(borrow-shared (local tests)) (local test_count) (borrow-mut (local output))
					(local written) (local name_prefix) (bool true)))))
			(return (call graph_output (int.convert i32 (local written)) -1i32 (local root)
				(struct.get (local tree) start) (struct.get (local tree) end) 0u32))))

	(fn run_scalar_graph
		(:doc `Consume the successful graph resolver's active modules and populated binding prefix.

		Reuse the resolver's target context for signature selection.
		Ordinary builds use the canonical root for ABI main. Test builds
		use a synthetic entry with the discovered inventory. A negative query path
		selects C emission, otherwise inspect the given name through the path
		row's local bindings. Both destinations remain untouched on failure.`)
		(:expect
			(tests "stage-2/scalar_graphs.tsv" "stage-2/test_execution.tsv" "stage-2/native_alias/cases.tsv" "stage-2/native_records/cases.tsv" "stage-2/native_values/cases.tsv")
			(issues "gh:wove-lang/wove:71" "gh:wove-lang/wove:129" "gh:wove-lang/wove:140" "gh:wove-lang/wove:142" "gh:wove-lang/wove:144" "gh:wove-lang/wove:146" "gh:wove-lang/wove:154" "gh:wove-lang/wove:186" "gh:wove-lang/wove:194" "gh:wove-lang/wove:223" "gh:wove-lang/wove:222"))
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(bindings (shared-slice GraphBinding)) (resolved GraphResult) (root i32) (query_path i32) (name (shared-slice u8))
			(assets (shared-slice SuppliedFile)) (private_helpers bool) (output (mut-slice u8)) (callers (mut-slice CallSite)))
		(returns GraphOutput)
		(body
			(let-mut requests (array.alloc EmbedAsset 0i32))
			(return (call run_graph (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local bindings)) (local resolved)
				(local root) (local query_path) (borrow-shared (local name)) (borrow-shared (local assets))
				(borrow-mut (local requests)) 0u32 (local private_helpers) (borrow-mut (local output)) (borrow-mut (local callers))))))

	(fn run_entry_graph
		(:doc `Collect checked graph asset requests or emit the graph with their loaded byte ranges.

		Reserve a request slot for each flattened source-tree row so every
		imported literal keeps its defining file and byte range.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(bindings (shared-slice GraphBinding)) (resolved GraphResult)
			(requests (mut-slice EmbedAsset)) (collect bool) (output (mut-slice u8)))
		(returns GraphOutput)
		(body
			(let-mut assets (array.alloc SuppliedFile 0i32))
			(let-mut callers (array.alloc CallSite 0i32))
			(let-mut asset_mode 2u32)
			(if
				(:doc "Measurement returns the checked paths before any native file I/O.")
				(local collect)
				(then (set (local asset_mode) 1u32)))
			(return (call run_graph (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local bindings)) (local resolved)
				0i32 -1i32 (borrow-shared (slice.range (local arena) 0i32 0i32))
				(borrow-shared (local assets)) (borrow-mut (local requests)) (local asset_mode) (bool false)
				(borrow-mut (local output)) (borrow-mut (local callers))))))

	(fn bind_emission_assets
		(:doc `Bind external asset rows or the byte ranges already loaded for the entry.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(assets (shared-slice SuppliedFile)) (requests (shared-slice EmbedAsset)) (asset_mode u32)
			(expressions (mut-slice ScalarExpression)))
		(returns EmbedCheck)
		(body
			(if
				(:doc "An ordinary supplied graph resolves its raw assets through the path table.")
				(u32.eq (local asset_mode) 0u32)
				(then (return (call bind_graph_embeds (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local modules)) (borrow-shared (local assets)) (borrow-mut (local expressions))))))
			(let bound (call bind_module_embeds (slice.len (local arena)) (borrow-shared (local requests))
				(borrow-mut (local expressions))))
			(if
				(:doc "Entry requests use arena offsets and the source diagnostic uses entry-relative offsets.")
				(u32.lt 0u32 (struct.get (local bound) error))
				(then
					(let file (struct.get (local bound) file))
					(let base (struct.get (slice.load (local files) (local file)) source_start))
					(return (call embed_check 0i32 (local file)
						(i32.sub.wrapping (struct.get (local bound) start) (local base))
						(i32.sub.wrapping (struct.get (local bound) end) (local base)) (struct.get (local bound) error)))))
			(return (local bound))))

	(fn run_graph
		(:doc `Plan the resolved graph once per operation for inspection, asset collection, or C emission.

		Asset mode 0 binds supplied path rows. Mode 1 collects entry requests.
		Mode 2 binds byte ranges loaded for those entry requests.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(bindings (shared-slice GraphBinding)) (resolved GraphResult) (root i32) (query_path i32) (name (shared-slice u8))
			(assets (shared-slice SuppliedFile)) (requests (mut-slice EmbedAsset)) (asset_mode u32) (private_helpers bool)
			(output (mut-slice u8)) (callers (mut-slice CallSite)))
		(returns GraphOutput)
		(body
			(let-mut trees (array.alloc ScalarTree (slice.len (local files))))
			(let layout (call layout_trees (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local bindings)) (borrow-mut (local trees))))
			(if
				(:doc "Any view or table sizing failure belongs to the original file.")
				(u32.lt 0u32 (struct.get (local layout) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local layout) file)
					(struct.get (local layout) start) (struct.get (local layout) end) (struct.get (local layout) error)))))
			(let rows (struct.get (local layout) rows))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let signatures_capacity (call signature_capacity (borrow-shared (local bindings))))
			(let test_executable (bool.and (u32.eq (struct.get (local resolved) mode) 2u32) (i32.lt (local query_path) 0i32)))
			(let-mut test_capacity 0i32)
			(if
				(:doc "Every discovered test is one of the checked Wove signatures.")
				(local test_executable)
				(then (set (local test_capacity) (local signatures_capacity))))
			(let-mut tests (array.alloc DiscoveredTest (local test_capacity)))
			(let-mut test_count -1i32)
			(if
				(:doc "Use the existing inventory's ordering and signature diagnostics before lowering bodies.")
				(local test_executable)
				(then
					(let inventory (call discover_graph_tests (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local modules)) (local resolved) (borrow-mut (local tests))))
					(if
						(:doc "A test declaration error belongs to the defining file.")
						(u32.lt 0u32 (struct.get (local inventory) error))
						(then (return (call graph_output 0i32 -1i32 (struct.get (local inventory) file)
							(struct.get (local inventory) start) (struct.get (local inventory) end)
							(struct.get (local inventory) error)))))
					(set (local test_count) (struct.get (local inventory) count))))
			(let-mut functions (array.alloc ScalarFunction (local signatures_capacity)))
			(let-mut parameters (array.alloc ScalarParameter (local rows)))
			(let-mut records (array.alloc ScalarRecord (local rows)))
			(let-mut statements (array.alloc ScalarStatement (local rows)))
			(let-mut expressions (array.alloc ScalarExpression (local rows)))
			(let signatures (call prepare_graph (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local trees)) (borrow-shared (local bindings)) (local root) (call graph_selection (local resolved))
				(borrow-mut (local nodes)) (borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records))
				(borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Every reached signature must be valid before resolving cross-file calls.")
				(u32.lt 0u32 (struct.get (local signatures) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local signatures) file)
					(struct.get (local signatures) start) (struct.get (local signatures) end)
					(struct.get (local signatures) error)))))
			(let-mut sites (array.alloc CallSite (local rows)))
			(let checked (call plan_bodies (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local bindings))
				(borrow-shared (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
				(borrow-mut (local sites)) 0i32))
			(if
				(:doc "Keep body diagnostics and related transfers in the original file.")
				(u32.lt 0u32 (struct.get (local checked) error))
				(then (return (struct.new GraphOutput (count 0i32) (declaration -1i32)
					(file (struct.get (local checked) file))
					(start (struct.get (local checked) start)) (end (struct.get (local checked) end))
					(error (struct.get (local checked) error))
					(related_start (struct.get (local checked) related_start)) (related_end (struct.get (local checked) related_end))))))
			(if
				(:doc "An inspection queries the shared plan through the requesting file's binding table.")
				(bool.not (i32.lt (local query_path) 0i32))
				(then
					(let result (call inspect_graph_name (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local trees)) (borrow-shared (local nodes)) (borrow-shared (local functions))
						(borrow-shared (local bindings)) (borrow-shared (local sites)) (struct.get (local checked) count)
						(local query_path) (borrow-shared (local name)) (borrow-mut (local callers))))
					(return (call graph_output (struct.get (local result) count) (struct.get (local result) declaration)
						(struct.get (local result) file) (struct.get (local result) start) (struct.get (local result) end)
						(struct.get (local result) error)))))
			(if
				(:doc "Return checked requests before binding assets or writing C.")
				(u32.eq (local asset_mode) 1u32)
				(then
					(let count (call request_module_embeds (borrow-shared (local expressions)) (borrow-mut (local requests))))
					(return (call graph_output (local count) -1i32 (local root) 0i32 0i32 0u32))))
			(let embedded (call bind_emission_assets (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local assets)) (borrow-shared (local requests))
				(local asset_mode) (borrow-mut (local expressions))))
			(if
				(:doc "Asset diagnostics refer to the defining file and its original quoted operand.")
				(u32.lt 0u32 (struct.get (local embedded) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local embedded) file)
					(struct.get (local embedded) start) (struct.get (local embedded) end) (struct.get (local embedded) error)))))
			(return (call write_graph_c (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local trees))
				(borrow-shared (local nodes)) (borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local expressions))
				(local root) (struct.get (local signatures) entry) (borrow-shared (local tests)) (local test_count) (local private_helpers)
				(borrow-mut (local output)))))))
