(module emit_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check, emit, and inspect a resolved scalar source graph.

	Keep the checked scalar tables separate from asset binding and C sizing.
	An emission produces one C translation unit across the reached files.
	An inspection resolves the requested spelling in its file and reads the
	defining declaration's callers.`)

	(use wove-file "../scalar/generics/workspace.wove" (only graph_function_workspace can_grow_function_workspace (value function_workspace_full)))
	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/graph.wove" (only copy_graph_bindings graph_selection (type GraphModule) (type GraphBinding) (type GraphResult)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_byte))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/callers.wove" (only inspect_graph_name))
	(use wove-file "../scalar/records.wove" (only is_native_record (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/tests.wove" (only discover_graph_tests (type DiscoveredTest)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only plan_bodies (type CallSite)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../scalar/graph.wove" (only layout_trees signature_capacity prepare_graph))
	(use wove-file "./c.wove" (only write_translation_unit))
	(use wove-file "./units.wove" (only plan_unit_assignments can_share_program_preamble write_numbered_pass (type UnitIndex)))
	(use wove-file "./library.wove" (only check_library_exports write_library_abi))
	(use wove-file "../c/arguments.wove" (only (value c_static_string_argument)))
	(use wove-file "../source/target.wove" (only (value library_mode)))
	(use wove-file "./tests.wove" (only write_test_entry))
	(use wove-file "./embeds.wove" (only bind_graph_embeds bind_module_embeds))
	(use wove-file "./text.wove" (only native_name_prefix_slot))
	(use wove-file "../source/c_formals.wove" (only find_c_fixed_formal c_fixed_formal_at))
	(use wove-file "./headers.wove" (only include_capacity prepare_includes write_includes matches_verified_includes (type CInclude) (type Includes)))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset) (type EmbedCheck) embed_check))

	(struct GraphOutput
		(fields (count i32) (declaration i32) (file i32) (start i32) (end i32) (error u32)
			(related_start i32) (related_end i32)))

	(struct
		(:doc "Entry and inventory indices or the first error from checking the graph.")
		GraphPlan
		(fields (entry i32) (library_os u8) (retained_strings bool) (test_count i32) (call_count i32) (file i32) (start i32) (end i32) (error u32)
			(related_start i32) (related_end i32)))

	(fn graph_output
		(:doc `Package an output count, inspected declaration, or original source diagnostic.`)
		(params (count i32) (declaration i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphOutput)
		(body
			(return (struct.new GraphOutput (count count) (declaration declaration)
				(file file) (start start) (end end) (error error)
				(related_start -1i32) (related_end -1i32)))))

	(fn reserve_native_prefix
		(:doc `Mark a collision with one explicitly selected native identifier.`)
		(params (arena (shared-array u8)) (start i32) (end i32) (occupied (mut-array u8)))
		(returns void)
		(body
			(let slot (call native_name_prefix_slot (borrow-shared arena) start end))
			(if
				(:doc "A higher slot cannot affect the first available choice.")
				(bool.and (i32.not-ltz slot) (i32.lt slot (array.len occupied)))
				(then (array.store occupied slot 1u8)))))

	(fn reserve_type_words
		(:doc `Reserve identifiers ending at separators in a checked C type spelling.`)
		(params (text (shared-array u8)) (occupied (mut-array u8)))
		(returns void)
		(body
			(let length (array.len text))
			(let-mut word 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Every type word ends at horizontal space or a pointer star.")
				(i32.lt index length)
				(body
					(let next (i32.inc index))
					(if
						(:doc "Include complete type words in the prefix check.")
						(bool.not (call is_c_identifier_byte (array.load text index)))
						(then
							(call reserve_native_prefix (borrow-shared text) word index
								(borrow-mut occupied))
							(set word next)))
					(set index next)))
			(call reserve_native_prefix (borrow-shared text) word length
				(borrow-mut occupied))))

	(fn reserve_type_prefixes
		(:doc `Reserve every identifier in the decoded native type spelling.

		A C typedef shares the identifier namespace with ordinary locals
		and functions. A native type spelling can also be a header macro.`)
		(params (arena (shared-array u8)) (start i32) (end i32) (occupied (mut-array u8)))
		(returns void)
		(body
			(let-mut decoded (array.alloc u8 (i32.sub end start)))
			(let value (call decode_string (borrow-shared arena)
				(struct.new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(call reserve_type_words (borrow-shared (array.range decoded 0i32
				(struct.get value written))) (borrow-mut occupied))))

	(fn native_prefix_capacity
		(:doc `Bound reserved prefixes by selected symbols and the native types and fields they need.

		Every slot also requires a spelling in the arena, so no occupied
		slot can reach signed i32 capacity.`)
		(params (bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)))
		(returns i32)
		(body
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Each selected C declaration contributes at most two symbols plus its type words.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(if
						(:doc "Ordinary Wove bindings introduce no native symbols.")
						(u32.eq (struct.get binding provider) 8u32)
						(then
							(let type_width (i32.sub (struct.get binding type_end) (struct.get binding type_start)))
							(let signature_width (i32.sub (struct.get binding signature_end)
								(struct.get binding signature_start)))
							(let width (u32.add 2u32
								(u32.add (u32.from-i32 type_width) (u32.from-i32 signature_width))))
							(if
								(:doc "Clamp the upper bound before converting to the slice length.")
								(u32.lt (u32.from-i32 (i32.sub 2147483647i32 count)) width)
								(then (return 2147483647i32)))
							(set count (i32.add count (i32.from-u32 width)))))
					(set index (i32.inc index))))
			(set index 0i32)
			(while
				(:doc "Include the representation and members of native types used only by a signature or field.")
				(i32.lt index (array.len records))
				(body
					(let row (array.load records index))
					(if (i32.eqz (struct.get row name)) (then (return count)))
					(if
						(:doc "A C value type can contribute one user-chosen type word and every exposed field name.")
						(i32.gtz (struct.get row native))
						(then
							(let-mut width 1i32)
							(if
								(:doc "Record views also reserve the spellings of their exposed fields.")
								(i32.gtz (struct.get row count))
								(then (set width (i32.add width (struct.get row count)))))
							(if
								(:doc "Keep the prefix table length within signed slice bounds.")
								(i32.lt (i32.sub 2147483647i32 count) width)
								(then (return 2147483647i32)))
							(set count (i32.add count width))))
					(set index (i32.inc index))))
			(return count)))

	(fn reserve_native_types
		(:doc `Protect native type spellings, including dependencies of selected signatures and records.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (occupied (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only the populated type-table prefix can name native type identifiers.")
				(i32.lt index (array.len records))
				(body
					(let row (array.load records index))
					(if (i32.eqz (struct.get row name)) (then (return)))
					(if
						(:doc "Native values keep their original C type literal.")
						(i32.gtz (struct.get row native))
						(then
							(let literal (array.load nodes (struct.get row native)))
							(call reserve_type_prefixes (borrow-shared arena)
								(struct.get literal start) (struct.get literal end) (borrow-mut occupied))
							(if
								(:doc "A header field spelling can expand as a macro. Keep generated names out of its prefix.")
								(call is_native_record row)
								(then
									(let-mut field (struct.get row first))
									(while
										(:doc "Reserve the checked spelling of each member of the view.")
										(i32.lt -1i32 field)
										(body
											(let node (array.load nodes field))
											(let name (array.load nodes (struct.get node first_child)))
											(call reserve_native_prefix (borrow-shared arena) (struct.get name start)
												(struct.get name end) (borrow-mut occupied))
											(set field (struct.get node next_sibling))))))))
					(set index (i32.inc index))))))

	(fn reserve_fixed_formal_names
		(:doc `Keep generated names distinct from header names and pointer types in hidden formals.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(occupied (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only native signatures with hidden operands contribute fixed operand spellings.")
				(i32.lt index (array.len functions))
				(body
					(let function (array.load functions index))
					(if
						(:doc "Skip the raw formal walk for ordinary declarations.")
						(struct.get function c_fixed)
						(then
							(let-mut row (call find_c_fixed_formal (borrow-shared arena) (borrow-shared nodes)
								(struct.get function c_formals)))
							(while
								(:doc "Reserve any names emitted from the checked native-only operand.")
								(i32.lt -1i32 row)
								(body
									(let formal (call c_fixed_formal_at (borrow-shared arena) (borrow-shared nodes) row))
									(let constant (struct.get formal constant))
									(let native (struct.get formal native_type))
									(if
										(:doc "A header constant keeps its name in the emitted call.")
										(i32.not-ltz constant)
										(then
											(let node (array.load nodes constant))
											(call reserve_native_prefix (borrow-shared arena) (struct.get node start)
												(struct.get node end) (borrow-mut occupied))))
									(if
										(:doc "An exact native cast can refer to a typedef or type-like macro.")
										(i32.not-ltz native)
										(then
											(let node (array.load nodes native))
											(call reserve_type_prefixes (borrow-shared arena) (struct.get node start)
												(struct.get node end) (borrow-mut occupied))))
									(set row (call find_c_fixed_formal (borrow-shared arena) (borrow-shared nodes)
										(struct.get (array.load nodes row) next_sibling)))))))
					(set index (i32.inc index))))))

	(fn choose_name_prefix
		(:doc `Pick the shortest generated prefix distinct from identifiers in selected C bindings.

		Reserve function symbols, fixed constants, pointer type words, and implicit destructors.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(functions (shared-array ScalarFunction)) (occupied (mut-array u8)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Reserve the possible generated-name prefixes of the original C spellings.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(if
						(:doc "Only C targets introduce native identifiers.")
						(u32.eq (struct.get binding provider) 8u32)
						(then
							(let base (struct.get (array.load files (struct.get binding file)) source_start))
							(if
								(:doc "Reserve the ordinary symbol of each selected C function.")
								(u32.not-eq (struct.get binding namespace) 1u32)
								(then (call reserve_native_prefix (borrow-shared arena)
									(i32.add base (struct.get binding native_start))
									(i32.add base (struct.get binding native_end))
									(borrow-mut occupied))))
							(if
								(:doc "Reserve the words in selected native types and the destructor of each owner.")
								(i32.gtz (struct.get binding native_type))
								(then
									(let type_base (struct.get (array.load files (struct.get binding native_file)) source_start))
									(if
										(:doc "An owner with a native destructor carries its nonempty name span.")
										(i32.lt (struct.get binding drop_start) (struct.get binding drop_end))
										(then (call reserve_native_prefix (borrow-shared arena)
											(i32.add type_base (struct.get binding drop_start))
											(i32.add type_base (struct.get binding drop_end))
											(borrow-mut occupied))))
									(call reserve_type_prefixes (borrow-shared arena)
										(i32.add type_base (struct.get binding type_start))
										(i32.add type_base (struct.get binding type_end))
										(borrow-mut occupied))))))
					(set index (i32.inc index))))
			(call reserve_native_types (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-mut occupied))
			(call reserve_fixed_formal_names (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared functions) (borrow-mut occupied))
			(let-mut slot 0i32)
			(while
				(:doc "Use wg unless a selected symbol could overlap its generated names.")
				(bool.and (i32.lt slot (array.len occupied))
					(u8.eq (array.load occupied slot) 1u8))
				(body (set slot (i32.inc slot))))
			(return slot)))

	(fn write_graph_c
		(:doc `Measure or emit a complete C unit using the checked graph tables.

		A sizing call returns the byte count. The disk driver requests that count,
		allocates exactly that many bytes, and calls again with the known size.
		A supplied graph passes a negative size to measure against its caller's buffer.
		A check-only call validates the headers and returns before sizing.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (statements (shared-array ScalarStatement))
			(records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(root i32) (plan GraphPlan) (tests (shared-array DiscoveredTest)) (private_helpers bool)
			(check_only bool) (measuring bool) (size i32) (output (mut-array u8)))
		(returns GraphOutput)
		(body
			(let tree (array.load trees root))
			(let source_base (struct.get (array.load files root) source_start))
			(let binding_count (array.len bindings))
			(let capacity (call include_capacity (borrow-shared bindings) 0i32 binding_count))
			(if
				(:doc "The aggregate include storage must fit in the signed slice length.")
				(i32.ltz (struct.get capacity bytes))
				(then (return (call graph_output 0i32 -1i32 root
					(struct.get tree start) (struct.get tree end) 16u32))))
			(let-mut paths (array.alloc u8 (struct.get capacity bytes)))
			(let-mut includes (array.alloc CInclude (struct.get capacity rows)))
			(let headers (call prepare_includes (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) 0i32 binding_count
				(borrow-mut paths) (borrow-mut includes)))
			(if
				(:doc "A malformed header operand belongs to the original bridge declaration.")
				(u32.gtz (struct.get headers error))
				(then (return (call graph_output 0i32 -1i32 (struct.get headers file)
					(struct.get headers start) (struct.get headers end) (struct.get headers error)))))
			(if
				(:doc "Selected headers are the final source checks before C sizing.")
				check_only
				(then (return (call graph_output 0i32 -1i32 root
					(struct.get tree start) (struct.get tree end) 0u32))))
			(let-mut occupied (array.alloc u8 (call native_prefix_capacity (borrow-shared bindings) (borrow-shared records))))
			(let name_prefix (call choose_name_prefix (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared functions) (borrow-mut occupied)))
			(let test_count (struct.get plan test_count))
			(let-mut limit (array.len output))
			(if
				(:doc "Keep the original disk output limit when sizing an exact buffer.")
				measuring
				(then (set limit 1073741824i32)))
			(if
				(:doc "A sizing request or an unknown width measures the translation unit.")
				(bool.or measuring (i32.ltz size))
				(then
					(let measured (call write_c_pass (borrow-shared arena) (borrow-shared files)
						(borrow-shared bindings) (borrow-shared nodes) (borrow-shared functions)
						(borrow-shared parameters) (borrow-shared statements) (borrow-shared records)
						(borrow-shared expressions) (borrow-shared tests) test_count private_helpers (struct.get plan library_os)
						(borrow-shared paths) (borrow-shared includes) headers name_prefix
						(borrow-mut output) (bool false)))
					(if
						(:doc "A short destination keeps its bytes and reports the original entry span.")
						(u32.lt (u32.from-i32 limit) measured)
						(then (return (call short_graph_output (borrow-shared nodes)
							root (struct.get plan entry) source_base
							(struct.get tree start) (struct.get tree end)))))
					(if
						(:doc "The driver uses the measured width to allocate the destination.")
						measuring
						(then (return (call graph_output (i32.from-u32 measured) -1i32 root
							(struct.get tree start) (struct.get tree end) 0u32))))))
			(if
				(:doc "A caller supplying a measured width must provide a buffer covering it.")
				(i32.lt limit size)
				(then (return (call short_graph_output (borrow-shared nodes)
					root (struct.get plan entry) source_base
					(struct.get tree start) (struct.get tree end)))))
			(let written (call write_c_pass (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared nodes) (borrow-shared functions)
				(borrow-shared parameters) (borrow-shared statements) (borrow-shared records)
				(borrow-shared expressions) (borrow-shared tests) test_count private_helpers (struct.get plan library_os)
				(borrow-shared paths) (borrow-shared includes) headers name_prefix
				(borrow-mut output) (bool true)))
			(return (call graph_output (i32.from-u32 written) -1i32 root
				(struct.get tree start) (struct.get tree end) 0u32))))

	(fn short_graph_output
		(:doc "Report capacity at the source entry or the module span for a synthetic test entry.")
		(params (nodes (shared-array SourceNode)) (root i32) (entry i32) (base i32) (start i32) (end i32))
		(returns GraphOutput)
		(body
			(if (i32.ltz entry)
				(then (return (call graph_output 0i32 -1i32 root start end 16u32))))
			(let node (array.load nodes entry))
			(return (call graph_output 0i32 -1i32 root
				(i32.sub (struct.get node start) base)
				(i32.sub (struct.get node end) base) 16u32))))

	(fn write_c_pass
		(:doc "Use the same ordering of includes, declarations, and test dispatch for measurement and writing.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(tests (shared-array DiscoveredTest)) (test_count i32) (private_helpers bool) (library_os u8) (paths (shared-array u8))
			(includes (shared-array CInclude)) (headers Includes) (name_prefix i32) (output (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let first (call write_includes (borrow-shared paths) (borrow-shared includes)
				(struct.get headers count) (borrow-mut output) writing))
			(let width (call write_translation_unit (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) first (struct.get headers stdint)
				(struct.get headers runtime) (bool.or private_helpers (u8.not-eqz library_os)) name_prefix writing))
			(if
				(:doc "Append public wrappers to the same native C unit as the private definitions.")
				(u8.not-eqz library_os)
				(then (return (call write_library_abi (borrow-shared arena) (borrow-shared nodes)
					(borrow-shared functions) (borrow-shared parameters) (borrow-mut output)
					width name_prefix 0u32 writing))))
			(if
				(:doc "An empty test inventory still needs a synthetic entry.")
				(i32.not-ltz test_count)
				(then (return (call write_test_entry (borrow-shared arena) (borrow-shared files)
					(borrow-shared nodes) (borrow-shared functions) (borrow-shared tests) test_count
					(borrow-mut output) width name_prefix writing))))
			(return width)))

	(fn write_partitioned_graph
		(:doc "Check the complete numbered output capacity before publishing bytes or unit boundaries.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (statements (shared-array ScalarStatement))
			(records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(root i32) (plan GraphPlan) (tests (shared-array DiscoveredTest)) (assignments (shared-array UnitIndex)) (count i32) (verified_includes (shared-array u8))
			(output (mut-array u8)) (unit_ends (mut-array UnitIndex))) (returns GraphOutput)
		(body
			(let tree (array.load trees root))
			(if
				(:doc "Nonordinary native bridges still need the serial preamble.")
				(bool.not (call can_share_program_preamble (borrow-shared bindings) (borrow-shared functions)
					(borrow-shared parameters)))
				(then (return (call graph_output 0i32 -2i32 root
					(struct.get tree start) (struct.get tree end) 0u32))))
			(let binding_count (array.len bindings))
			(let capacity (call include_capacity (borrow-shared bindings) 0i32 binding_count))
			(if
				(:doc "An oversized include plan is a capacity error before publishing output.")
				(i32.ltz (struct.get capacity bytes))
				(then (return (call graph_output 0i32 -1i32 root
					(struct.get tree start) (struct.get tree end) 16u32))))
			(let-mut paths (array.alloc u8 (struct.get capacity bytes)))
			(let-mut includes (array.alloc CInclude (struct.get capacity rows)))
			(let headers (call prepare_includes (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) 0i32 binding_count
				(borrow-mut paths) (borrow-mut includes)))
			(if
				(:doc "An invalid include operand points at the original bridge declaration.")
				(u32.gtz (struct.get headers error))
				(then (return (call graph_output 0i32 -1i32 (struct.get headers file)
					(struct.get headers start) (struct.get headers end) (struct.get headers error)))))
			(if
				(:doc "Every split unit replays the complete audited include context, including prerequisites not named by its calls.")
				(bool.not (call matches_verified_includes (borrow-shared paths) (borrow-shared includes)
					(struct.get headers count) (borrow-shared verified_includes)))
				(then (return (call graph_output 0i32 -2i32 root
					(struct.get tree start) (struct.get tree end) 0u32))))
			(let-mut occupied (array.alloc u8 (call native_prefix_capacity (borrow-shared bindings) (borrow-shared records))))
			(let name_prefix (call choose_name_prefix (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared functions) (borrow-mut occupied)))
			(let measured (call write_numbered_pass (borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				(borrow-shared assignments) count name_prefix
				(borrow-shared paths) (borrow-shared includes) headers
				(borrow-shared tests) (struct.get plan test_count) (u8.not-eqz (struct.get plan library_os))
				(borrow-mut output) (borrow-mut unit_ends) (bool false)))
			(if
				(:doc "On a short buffer leave all segments unwritten and retain the serial emitter's source span.")
				(u32.lt (u32.from-i32 (array.len output)) measured)
				(then (return (call short_graph_output (borrow-shared nodes) root
					(struct.get plan entry) (struct.get (array.load files root) source_start)
					(struct.get tree start) (struct.get tree end)))))
			(let written (call write_numbered_pass (borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				(borrow-shared assignments) count name_prefix
				(borrow-shared paths) (borrow-shared includes) headers
				(borrow-shared tests) (struct.get plan test_count) (u8.not-eqz (struct.get plan library_os))
				(borrow-mut output) (borrow-mut unit_ends) (bool true)))
			(return (call graph_output (i32.from-u32 written) -1i32 root
				(struct.get tree start) (struct.get tree end) 0u32))))

	(fn run_scalar_graph
		(:doc `Consume the successful graph resolver's active modules and populated binding prefix.

		Reuse the resolver's target context for signature selection.
		Ordinary builds use the canonical root for ABI main. Test builds
		use a synthetic entry with the discovered inventory. A negative query path
		selects C emission, otherwise inspect the given name through the path
		row's local bindings. Output views remain untouched on failure.

		The graph probe can request a partition using one boundary row per
		requested unit plus one for the common header. A declaration of -2
		indicates a graph outside the supported numbered subset.
		An empty boundary table selects the serial path.

		For a split with selected native headers, the caller certifies the
		exact include prefix under the eventual C compilation context. It
		must have checked external declarations without per-unit native state
		or preprocessing side effects that change partitioned semantics.
		An empty audit accepts only graphs without selected native headers.`)
		(:expect
			(tests "stage-2/scalar_graphs.tsv" "stage-2/test_execution.tsv" "stage-2/native_alias/cases.tsv" "stage-2/native_records/cases.tsv" "stage-2/native_values/cases.tsv")
			(issues "gh:wove-lang/wove:71" "gh:wove-lang/wove:129" "gh:wove-lang/wove:140" "gh:wove-lang/wove:142" "gh:wove-lang/wove:144" "gh:wove-lang/wove:146" "gh:wove-lang/wove:154" "gh:wove-lang/wove:186" "gh:wove-lang/wove:194" "gh:wove-lang/wove:223" "gh:wove-lang/wove:222"))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (shared-array GraphBinding)) (resolved GraphResult) (root i32) (query_path i32) (name (shared-array u8))
			(assets (shared-array SuppliedFile)) (private_helpers bool) (verified_includes (shared-array u8)) (output (mut-array u8)) (callers (mut-array CallSite)) (unit_ends (mut-array UnitIndex)))
		(returns GraphOutput)
		(body
			(let-mut trees (array.alloc ScalarTree (array.len files)))
			(let layout (call layout_trees (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-shared bindings) (borrow-mut trees)))
			(if
				(:doc "Any view or table sizing failure belongs to the original file.")
				(u32.gtz (struct.get layout error))
				(then (return (call graph_output 0i32 -1i32 (struct.get layout file)
					(struct.get layout start) (struct.get layout end) (struct.get layout error)))))
			(let workspace (call graph_function_workspace (borrow-shared arena) (borrow-shared files)
				(borrow-shared trees) (struct.get layout rows) (call signature_capacity (borrow-shared bindings))))
			(if
				(:doc "Bound concrete function storage before allocating the checked graph arrays.")
				(u32.gtz (struct.get workspace error))
				(then (return (call graph_output 0i32 -1i32 root 0i32 0i32 (struct.get workspace error)))))
			(let-mut rows (struct.get workspace rows))
			(let-mut capacity (struct.get workspace functions))
			(while
				(:doc "A transitive request may need more concrete rows than are present in the authored call sites.")
				(i32.lt -1i32 rows)
				(body
					(let result (call run_scalar_graph_workspace (borrow-shared arena) (borrow-shared files)
						(borrow-shared modules) (borrow-shared bindings) resolved root
						query_path (borrow-shared name) (borrow-shared assets) private_helpers (borrow-shared verified_includes)
						(borrow-shared trees) rows capacity (borrow-mut output) (borrow-mut callers)
						(borrow-mut unit_ends)))
					(if
						(:doc "Only the private pre-emission clone shortage can be retried.")
						(u32.not-eq (struct.get result error) function_workspace_full)
						(then (return result)))
					(if
						(:doc "Translate an unrepresentable workspace to the ordinary capacity diagnostic.")
						(bool.not (call can_grow_function_workspace rows capacity))
						(then (return (call graph_output 0i32 -1i32 (struct.get result file)
							(struct.get result start) (struct.get result end) 16u32))))
					(set rows (i32.add rows rows))
					(set capacity (i32.add capacity capacity))))
			(return (call graph_output 0i32 -1i32 root 0i32 0i32 16u32))))

	(fn run_scalar_graph_workspace
		(:doc "Check, inspect, or emit a supplied graph using one private allocation attempt.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(resolved_bindings (shared-array GraphBinding)) (resolved GraphResult) (root i32) (query_path i32) (name (shared-array u8))
			(assets (shared-array SuppliedFile)) (private_helpers bool) (verified_includes (shared-array u8)) (trees (shared-array ScalarTree)) (rows i32)
			(signatures_capacity i32) (output (mut-array u8)) (callers (mut-array CallSite)) (unit_ends (mut-array UnitIndex))) (returns GraphOutput)
		(body
			(let-mut bindings (array.alloc GraphBinding (array.len resolved_bindings)))
			(call copy_graph_bindings (borrow-shared resolved_bindings) (borrow-mut bindings))
			(let-mut nodes (array.alloc SourceNode rows))
			(let test_executable (bool.and (u32.eq (struct.get resolved mode) 2u32) (i32.ltz query_path)))
			(let-mut test_capacity 0i32)
			(if
				(:doc "Every discovered test is one of the checked Wove signatures.")
				test_executable
				(then (set test_capacity signatures_capacity)))
			(let-mut tests (array.alloc DiscoveredTest test_capacity))
			(let-mut functions (array.alloc ScalarFunction signatures_capacity))
			(let-mut parameters (array.alloc ScalarParameter rows))
			(let-mut records (array.alloc ScalarRecord rows))
			(let-mut statements (array.alloc ScalarStatement rows))
			(let-mut expressions (array.alloc ScalarExpression rows))
			(let-mut sites (array.alloc CallSite rows))
			(let plan (call check_graph_plan (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-mut bindings) resolved
				root test_executable (borrow-shared trees) (borrow-mut nodes)
				(borrow-mut functions) (borrow-mut parameters) (borrow-mut records)
				(borrow-mut statements) (borrow-mut expressions) (borrow-mut sites)
				(borrow-mut tests)))
			(if
				(:doc "Keep checked diagnostics and related transfers in the original file.")
				(u32.gtz (struct.get plan error))
				(then (return (struct.new GraphOutput (count 0i32) (declaration -1i32)
					(file (struct.get plan file)) (start (struct.get plan start))
					(end (struct.get plan end)) (error (struct.get plan error))
					(related_start (struct.get plan related_start)) (related_end (struct.get plan related_end))))))
			(if
				(:doc "Inspect the requesting file's bindings against the checked call sites.")
				(i32.not-ltz query_path)
				(then
					(let result (call inspect_graph_name (borrow-shared arena) (borrow-shared files)
						(borrow-shared trees) (borrow-shared nodes) (borrow-shared functions)
						(borrow-shared bindings) (borrow-shared sites) (struct.get plan call_count)
						query_path (borrow-shared name) (borrow-mut callers)))
					(return (call graph_output (struct.get result count) (struct.get result declaration)
						(struct.get result file) (struct.get result start) (struct.get result end)
						(struct.get result error)))))
			(let embedded (call bind_graph_embeds (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-shared assets) (borrow-mut expressions)))
			(if
				(:doc "Report the original quoted operand if a supplied asset is unavailable.")
				(u32.gtz (struct.get embedded error))
				(then (return (call graph_output 0i32 -1i32 (struct.get embedded file)
					(struct.get embedded start) (struct.get embedded end) (struct.get embedded error)))))
			(if
				(:doc "The private probe can group the checked definitions before rendering any C.")
				(i32.lt 2i32 (array.len unit_ends))
				(then
					(let function_count (call checked_function_count (borrow-shared functions)))
					(let-mut assignments (array.alloc UnitIndex function_count))
					(let count (call plan_unit_assignments
						(borrow-shared functions)
						(array.len files) (i32.dec (array.len unit_ends)) (borrow-mut assignments)))
					(if
						(:doc "A graph with one body fits the complete serial emitter.")
						(i32.lt 1i32 count)
						(then (return (call write_partitioned_graph (borrow-shared arena) (borrow-shared files)
							(borrow-shared bindings) (borrow-shared trees) (borrow-shared nodes)
							(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
							(borrow-shared records) (borrow-shared expressions) root plan (borrow-shared tests)
							(borrow-shared assignments) count (borrow-shared verified_includes)
							(borrow-mut output) (borrow-mut unit_ends)))))))
			(let emitted (call write_graph_c (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared trees)
				(borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				root plan (borrow-shared tests) private_helpers
				(bool false) (bool false) -1i32 (borrow-mut output)))
			(if
				(:doc "Expose the serial translation unit as one numbered part on a successful probe request.")
				(bool.and (i32.gtz (array.len unit_ends)) (u32.eqz (struct.get emitted error)))
				(then (array.store unit_ends 0i32 (struct.new UnitIndex (value (struct.get emitted count))))))
			(return emitted)))

	(fn bind_entry_assets
		(:doc "Attach loaded ranges to the already checked expressions and preserve source-relative diagnostics.")
		(params (length i32) (files (shared-array SuppliedFile)) (requests (shared-array EmbedAsset))
			(expressions (mut-array ScalarExpression))) (returns EmbedCheck)
		(body
			(let bound (call bind_module_embeds length (borrow-shared requests) (borrow-mut expressions)))
			(if
				(:doc "Request spans are measured in the whole arena.")
				(u32.gtz (struct.get bound error))
				(then
					(let file (struct.get bound file))
					(let base (struct.get (array.load files file) source_start))
					(return (call embed_check 0i32 file
						(i32.sub (struct.get bound start) base)
						(i32.sub (struct.get bound end) base) (struct.get bound error)))))
			(return bound)))

	(fn graph_plan_error
		(:doc "Keep the first checking error together with its original source coordinates.")
		(params (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32))
		(returns GraphPlan)
		(body
			(return (struct.new GraphPlan (entry -1i32) (library_os 0u8) (retained_strings (bool false)) (test_count -1i32) (call_count 0i32)
				(file file) (start start) (end end) (error error)
				(related_start related_start) (related_end related_end)))))

	(fn first_retained_literal
		(:doc "Find the first checked retained argument in this native image.")
		(params (expressions (shared-array ScalarExpression))) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only checked retained arguments carry the original literal location.")
				(i32.lt index (array.len expressions))
				(body
					(if
						(:doc "This checked expression represents a retained native string.")
						(u32.eq (struct.get (array.load expressions index) kind) c_static_string_argument)
						(then (return index)))
					(set index (i32.inc index))))
			(return -1i32)))

	(fn check_graph_plan
		(:doc "Check the inventory, signatures, and bodies once in their original order.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (mut-array GraphBinding)) (resolved GraphResult) (root i32) (test_executable bool)
			(trees (shared-array ScalarTree)) (nodes (mut-array SourceNode)) (functions (mut-array ScalarFunction))
			(parameters (mut-array ScalarParameter)) (records (mut-array ScalarRecord)) (statements (mut-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (sites (mut-array CallSite)) (tests (mut-array DiscoveredTest)))
		(returns GraphPlan)
		(body
			(let-mut test_count -1i32)
			(if
				(:doc "Use the existing inventory's ordering and signature diagnostics before lowering bodies.")
				test_executable
				(then
					(let inventory (call discover_graph_tests (borrow-shared arena) (borrow-shared files)
						(borrow-shared modules) resolved (borrow-mut tests)))
					(if
						(:doc "A test declaration error belongs to the defining file.")
						(u32.gtz (struct.get inventory error))
						(then (return (call graph_plan_error (struct.get inventory file)
							(struct.get inventory start) (struct.get inventory end)
							(struct.get inventory error) -1i32 -1i32))))
					(set test_count (struct.get inventory count))))
			(let signatures (call prepare_graph (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-shared trees) (borrow-mut bindings) root (call graph_selection resolved)
				(borrow-mut nodes) (borrow-mut functions) (borrow-mut parameters) (borrow-mut records)
				(borrow-mut statements) (borrow-mut expressions)))
			(if
				(:doc "Every reached signature must be valid before resolving cross-file calls.")
				(u32.gtz (struct.get signatures error))
				(then (return (call graph_plan_error (struct.get signatures file)
					(struct.get signatures start) (struct.get signatures end)
					(struct.get signatures error) -1i32 -1i32))))
			(let-mut library_os 0u8)
			(if
				(:doc "Check public C signatures only when this graph supplies a library ABI.")
				(u32.eq (struct.get resolved mode) library_mode)
				(then
					(set library_os (struct.get resolved os))
					(let exports (call check_library_exports (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared parameters)))
					(if
						(:doc "A public ABI conflict remains attached to the defining declaration.")
						(u32.gtz (struct.get exports error))
						(then (return (call graph_plan_error (struct.get exports file)
							(struct.get exports start) (struct.get exports end)
							(struct.get exports error) -1i32 -1i32))))))
			(let checked (call plan_bodies (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings)
				(borrow-mut records) (borrow-mut statements) (borrow-mut expressions)
				(borrow-mut sites) 0i32))
			(if
				(:doc "Keep body diagnostics and related transfers in the original file.")
				(u32.gtz (struct.get checked error))
				(then (return (call graph_plan_error (struct.get checked file)
					(struct.get checked start) (struct.get checked end) (struct.get checked error)
					(struct.get checked related_start) (struct.get checked related_end)))))
			(let retained (call first_retained_literal (borrow-shared expressions)))
			(if
				(:doc "A retained literal needs process-lifetime backing, which a shared-library graph cannot provide.")
				(u32.eq (struct.get resolved mode) library_mode)
				(then
					(if
						(:doc "Report the original literal even when a dependency made the call.")
						(i32.not-ltz retained)
						(then
							(let argument (array.load expressions retained))
							(return (call graph_plan_error (struct.get argument target)
								(struct.get argument start) (struct.get argument end) 24u32 -1i32 -1i32))))))
			(return (struct.new GraphPlan (entry (struct.get signatures entry))
				(library_os library_os) (retained_strings (i32.not-ltz retained)) (test_count test_count)
				(call_count (struct.get checked count)) (file root) (start 0i32) (end 0i32) (error 0u32)
				(related_start -1i32) (related_end -1i32)))))
)
