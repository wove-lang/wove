(module emit_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check, emit, and inspect a resolved scalar source graph.

	Keep the checked scalar tables separate from asset binding and C sizing.
	An emission produces one C translation unit across the reached files.
	An inspection resolves the requested spelling in its file and reads the
	defining declaration's callers.`)

	(use wove-file "../scalar/generics/workspace.wove" (only graph_function_workspace can_grow_function_workspace (value function_workspace_full)))
	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/graph.wove" (only graph_selection (type GraphModule) (type GraphBinding) (type GraphResult)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_byte))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/callers.wove" (only inspect_graph_name))
	(use wove-file "../scalar/records.wove" (only is_native_record (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/tests.wove" (only discover_graph_tests (type DiscoveredTest)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove"
		(only plan_bodies (type ScalarFunction) (type ScalarParameter)
			(type CallSite)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../scalar/graph.wove" (only layout_trees signature_capacity prepare_graph))
	(use wove-file "./c.wove" (only write_translation_unit))
	(use wove-file "./tests.wove" (only write_test_entry))
	(use wove-file "./embeds.wove" (only bind_graph_embeds bind_module_embeds))
	(use wove-file "./text.wove" (only native_name_prefix_slot))
	(use wove-file "./c_formals.wove" (only fixed_c_value))
	(use wove-file "../source/c_formals.wove" (only find_c_fixed_formal))
	(use wove-file "./headers.wove" (only include_capacity prepare_includes write_includes (type CInclude) (type Includes)))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset) (type EmbedCheck) embed_check))

	(struct GraphOutput
		(fields (count i32) (declaration i32) (file i32) (start i32) (end i32) (error u32)
			(related_start i32) (related_end i32)))

	(struct
		(:doc "Entry and inventory indices or the first error from checking the graph.")
		GraphPlan
		(fields (entry i32) (test_count i32) (call_count i32) (file i32) (start i32) (end i32) (error u32)
			(related_start i32) (related_end i32)))

	(fn graph_output
		(:doc `Package an output count, inspected declaration, or original source diagnostic.`)
		(params (count i32) (declaration i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphOutput)
		(body
			(return (struct.new GraphOutput (count (local count)) (declaration (local declaration))
				(file (local file)) (start (local start)) (end (local end)) (error (local error))
				(related_start -1i32) (related_end -1i32)))))

	(fn reserve_native_prefix
		(:doc `Mark a collision with one explicitly selected native identifier.`)
		(params (arena (shared-array u8)) (start i32) (end i32) (occupied (mut-array u8)))
		(returns void)
		(body
			(let slot (call native_name_prefix_slot (borrow-shared (local arena)) (local start) (local end)))
			(if
				(:doc "A higher slot cannot affect the first available choice.")
				(bool.and (i32.not-ltz (local slot)) (i32.lt (local slot) (array.len (local occupied))))
				(then (array.store (local occupied) (local slot) 1u8)))))

	(fn reserve_type_words
		(:doc `Reserve identifiers ending at separators in a checked C type spelling.`)
		(params (text (shared-array u8)) (occupied (mut-array u8)))
		(returns void)
		(body
			(let length (array.len (local text)))
			(let-mut word 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Every type word ends at horizontal space or a pointer star.")
				(i32.lt (local index) (local length))
				(body
					(let next (i32.inc (local index)))
					(if
						(:doc "Include complete type words in the prefix check.")
						(bool.not (call is_c_identifier_byte (array.load (local text) (local index))))
						(then
							(call reserve_native_prefix (borrow-shared (local text)) (local word) (local index)
								(borrow-mut (local occupied)))
							(set (local word) (local next))))
					(set (local index) (local next))))
			(call reserve_native_prefix (borrow-shared (local text)) (local word) (local length)
				(borrow-mut (local occupied)))))

	(fn reserve_type_prefixes
		(:doc `Reserve every identifier in the decoded native type spelling.

		A C typedef shares the identifier namespace with ordinary locals
		and functions. A native type spelling can also be a header macro.`)
		(params (arena (shared-array u8)) (start i32) (end i32) (occupied (mut-array u8)))
		(returns void)
		(body
			(let-mut decoded (array.alloc u8 (i32.sub (local end) (local start))))
			(let value (call decode_string (borrow-shared (local arena))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local decoded))))
			(call reserve_type_words (borrow-shared (array.range (local decoded) 0i32
				(struct.get (local value) written))) (borrow-mut (local occupied)))))

	(fn native_prefix_capacity
		(:doc `Bound reserved prefixes by selected symbols and the native types and fields they need.

		Every slot also requires a spelling in the arena, so no occupied
		slot can reach signed i32 capacity.`)
		(params (bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)))
		(returns i32)
		(body
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Each selected C declaration contributes at most two symbols plus its type words.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let binding (array.load (local bindings) (local index)))
					(if
						(:doc "Ordinary Wove bindings introduce no native symbols.")
						(u32.eq (struct.get (local binding) provider) 8u32)
						(then
							(let type_width (i32.sub (struct.get (local binding) type_end) (struct.get (local binding) type_start)))
							(let signature_width (i32.sub (struct.get (local binding) signature_end)
								(struct.get (local binding) signature_start)))
							(let width (u32.add 2u32
								(u32.add (u32.from-i32 (local type_width)) (u32.from-i32 (local signature_width)))))
							(if
								(:doc "Clamp the upper bound before converting to the slice length.")
								(u32.lt (u32.from-i32 (i32.sub 2147483647i32 (local count))) (local width))
								(then (return 2147483647i32)))
							(set (local count) (i32.add (local count) (i32.from-u32 (local width))))))
					(set (local index) (i32.inc (local index)))))
			(set (local index) 0i32)
			(while
				(:doc "Include the representation and members of native types used only by a signature or field.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let row (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local row) name)) (then (return (local count))))
					(if
						(:doc "A C value type can contribute one user-chosen type word and every exposed field name.")
						(i32.gtz (struct.get (local row) native))
						(then
							(let-mut width 1i32)
							(if
								(:doc "Record views also reserve the spellings of their exposed fields.")
								(i32.gtz (struct.get (local row) count))
								(then (set (local width) (i32.add (local width) (struct.get (local row) count)))))
							(if
								(:doc "Keep the prefix table length within signed slice bounds.")
								(i32.lt (i32.sub 2147483647i32 (local count)) (local width))
								(then (return 2147483647i32)))
							(set (local count) (i32.add (local count) (local width)))))
					(set (local index) (i32.inc (local index)))))
			(return (local count))))

	(fn reserve_native_types
		(:doc `Protect native type spellings, including dependencies of selected signatures and records.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (occupied (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only the populated type-table prefix can name native type identifiers.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let row (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local row) name)) (then (return)))
					(if
						(:doc "Native values keep their original C type literal.")
						(i32.gtz (struct.get (local row) native))
						(then
							(let literal (array.load (local nodes) (struct.get (local row) native)))
							(call reserve_type_prefixes (borrow-shared (local arena))
								(struct.get (local literal) start) (struct.get (local literal) end) (borrow-mut (local occupied)))
							(if
								(:doc "A header field spelling can expand as a macro. Keep generated names out of its prefix.")
								(call is_native_record (local row))
								(then
									(let-mut field (struct.get (local row) first))
									(while
										(:doc "Reserve the checked spelling of each member of the view.")
										(i32.lt -1i32 (local field))
										(body
											(let node (array.load (local nodes) (local field)))
											(let name (array.load (local nodes) (struct.get (local node) first_child)))
											(call reserve_native_prefix (borrow-shared (local arena)) (struct.get (local name) start)
												(struct.get (local name) end) (borrow-mut (local occupied)))
											(set (local field) (struct.get (local node) next_sibling))))))))
					(set (local index) (i32.inc (local index)))))))

	(fn reserve_fixed_formal_names
		(:doc `Keep generated names distinct from header constants supplied implicitly to native calls.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(occupied (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only native signatures with hidden operands contribute fixed constant spellings.")
				(i32.lt (local index) (array.len (local functions)))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "Skip the raw formal walk for ordinary declarations.")
						(struct.get (local function) c_fixed)
						(then
							(let-mut row (call find_c_fixed_formal (borrow-shared (local arena)) (borrow-shared (local nodes))
								(struct.get (local function) c_formals)))
							(while
								(:doc "Reserve each checked symbol from the original declaration.")
								(i32.lt -1i32 (local row))
								(body
									(let constant (call fixed_c_value (borrow-shared (local arena)) (borrow-shared (local nodes)) (local row)))
									(call reserve_native_prefix (borrow-shared (local arena)) (struct.get (local constant) start)
										(struct.get (local constant) end) (borrow-mut (local occupied)))
									(set (local row) (call find_c_fixed_formal (borrow-shared (local arena)) (borrow-shared (local nodes))
										(struct.get (array.load (local nodes) (local row)) next_sibling)))))))
					(set (local index) (i32.inc (local index)))))))

	(fn choose_name_prefix
		(:doc `Pick the shortest generated prefix distinct from identifiers in selected C bindings.

		Reserve function symbols, fixed constants, pointer type words, and implicit destructors.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(functions (shared-array ScalarFunction)) (occupied (mut-array u8)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Reserve the possible generated-name prefixes of the original C spellings.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let binding (array.load (local bindings) (local index)))
					(if
						(:doc "Only C targets introduce native identifiers.")
						(u32.eq (struct.get (local binding) provider) 8u32)
						(then
							(let base (struct.get (array.load (local files) (struct.get (local binding) file)) source_start))
							(if
								(:doc "Reserve the ordinary symbol of each selected C function.")
								(u32.not-eq (struct.get (local binding) namespace) 1u32)
								(then (call reserve_native_prefix (borrow-shared (local arena))
									(i32.add (local base) (struct.get (local binding) native_start))
									(i32.add (local base) (struct.get (local binding) native_end))
									(borrow-mut (local occupied)))))
							(if
								(:doc "Reserve the words in selected native types and the destructor of each owner.")
								(i32.gtz (struct.get (local binding) native_type))
								(then
									(let type_base (struct.get (array.load (local files) (struct.get (local binding) native_file)) source_start))
									(if
										(:doc "Only a pointer owner has a native destructor.")
										(i32.lt -1i32 (struct.get (local binding) drop_start))
										(then (call reserve_native_prefix (borrow-shared (local arena))
											(i32.add (local type_base) (struct.get (local binding) drop_start))
											(i32.add (local type_base) (struct.get (local binding) drop_end))
											(borrow-mut (local occupied)))))
									(call reserve_type_prefixes (borrow-shared (local arena))
										(i32.add (local type_base) (struct.get (local binding) type_start))
										(i32.add (local type_base) (struct.get (local binding) type_end))
										(borrow-mut (local occupied)))))))
					(set (local index) (i32.inc (local index)))))
			(call reserve_native_types (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-mut (local occupied)))
			(call reserve_fixed_formal_names (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-mut (local occupied)))
			(let-mut slot 0i32)
			(while
				(:doc "Use wg unless a selected symbol could overlap its generated names.")
				(bool.and (i32.lt (local slot) (array.len (local occupied)))
					(u8.eq (array.load (local occupied) (local slot)) 1u8))
				(body (set (local slot) (i32.inc (local slot)))))
			(return (local slot))))

	(fn write_graph_c
		(:doc `Measure or emit a complete C unit using the checked graph tables.

		A sizing call returns the byte count. The disk driver requests that count,
		allocates exactly that many bytes, and calls again with the known size.
		A supplied graph passes a negative size to measure against its caller's buffer.
		A check-only call validates the headers and returns before sizing.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (statements (shared-array ScalarStatement))
			(records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(root i32) (plan GraphPlan) (tests (shared-array DiscoveredTest)) (private_helpers bool)
			(check_only bool) (measuring bool) (size i32) (output (mut-array u8)))
		(returns GraphOutput)
		(body
			(let tree (array.load (local trees) (local root)))
			(let source_base (struct.get (array.load (local files) (local root)) source_start))
			(let capacity (call include_capacity (borrow-shared (local bindings))))
			(if
				(:doc "The aggregate include storage must fit in the signed slice length.")
				(i32.ltz (struct.get (local capacity) bytes))
				(then (return (call graph_output 0i32 -1i32 (local root)
					(struct.get (local tree) start) (struct.get (local tree) end) 16u32))))
			(let-mut paths (array.alloc u8 (struct.get (local capacity) bytes)))
			(let-mut includes (array.alloc CInclude (struct.get (local capacity) rows)))
			(let headers (call prepare_includes (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-mut (local paths)) (borrow-mut (local includes))))
			(if
				(:doc "A malformed header operand belongs to the original bridge declaration.")
				(u32.gtz (struct.get (local headers) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local headers) file)
					(struct.get (local headers) start) (struct.get (local headers) end) (struct.get (local headers) error)))))
			(if
				(:doc "Selected headers are the final source checks before C sizing.")
				(local check_only)
				(then (return (call graph_output 0i32 -1i32 (local root)
					(struct.get (local tree) start) (struct.get (local tree) end) 0u32))))
			(let-mut occupied (array.alloc u8 (call native_prefix_capacity (borrow-shared (local bindings)) (borrow-shared (local records)))))
			(let name_prefix (call choose_name_prefix (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local nodes)) (borrow-shared (local records))
				(borrow-shared (local functions)) (borrow-mut (local occupied))))
			(let test_count (struct.get (local plan) test_count))
			(let-mut limit (array.len (local output)))
			(if
				(:doc "Keep the original disk output limit when sizing an exact buffer.")
				(local measuring)
				(then (set (local limit) 1073741824i32)))
			(if
				(:doc "A sizing request or an unknown width measures the translation unit.")
				(bool.or (local measuring) (i32.ltz (local size)))
				(then
					(let measured (call write_c_pass (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local bindings)) (borrow-shared (local nodes)) (borrow-shared (local functions))
						(borrow-shared (local parameters)) (borrow-shared (local statements)) (borrow-shared (local records))
						(borrow-shared (local expressions)) (borrow-shared (local tests)) (local test_count) (local private_helpers)
						(borrow-shared (local paths)) (borrow-shared (local includes)) (local headers) (local name_prefix)
						(borrow-mut (local output)) (bool false)))
					(if
						(:doc "A short destination keeps its bytes and reports the original entry span.")
						(u32.lt (u32.from-i32 (local limit)) (local measured))
						(then (return (call short_graph_output (borrow-shared (local nodes))
							(local root) (struct.get (local plan) entry) (local source_base)
							(struct.get (local tree) start) (struct.get (local tree) end)))))
					(if
						(:doc "The driver uses the measured width to allocate the destination.")
						(local measuring)
						(then (return (call graph_output (i32.from-u32 (local measured)) -1i32 (local root)
							(struct.get (local tree) start) (struct.get (local tree) end) 0u32))))))
			(if
				(:doc "A caller supplying a measured width must provide a buffer covering it.")
				(i32.lt (local limit) (local size))
				(then (return (call short_graph_output (borrow-shared (local nodes))
					(local root) (struct.get (local plan) entry) (local source_base)
					(struct.get (local tree) start) (struct.get (local tree) end)))))
			(let written (call write_c_pass (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local nodes)) (borrow-shared (local functions))
				(borrow-shared (local parameters)) (borrow-shared (local statements)) (borrow-shared (local records))
				(borrow-shared (local expressions)) (borrow-shared (local tests)) (local test_count) (local private_helpers)
				(borrow-shared (local paths)) (borrow-shared (local includes)) (local headers) (local name_prefix)
				(borrow-mut (local output)) (bool true)))
			(return (call graph_output (i32.from-u32 (local written)) -1i32 (local root)
				(struct.get (local tree) start) (struct.get (local tree) end) 0u32))))

	(fn short_graph_output
		(:doc "Report capacity at the source entry or the module span for a synthetic test entry.")
		(params (nodes (shared-array SourceNode)) (root i32) (entry i32) (base i32) (start i32) (end i32))
		(returns GraphOutput)
		(body
			(if (i32.ltz (local entry))
				(then (return (call graph_output 0i32 -1i32 (local root) (local start) (local end) 16u32))))
			(let node (array.load (local nodes) (local entry)))
			(return (call graph_output 0i32 -1i32 (local root)
				(i32.sub (struct.get (local node) start) (local base))
				(i32.sub (struct.get (local node) end) (local base)) 16u32))))

	(fn write_c_pass
		(:doc "Use the same ordering of includes, declarations, and test dispatch for measurement and writing.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(tests (shared-array DiscoveredTest)) (test_count i32) (private_helpers bool) (paths (shared-array u8))
			(includes (shared-array CInclude)) (headers Includes) (name_prefix i32) (output (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let first (call write_includes (borrow-shared (local paths)) (borrow-shared (local includes))
				(struct.get (local headers) count) (borrow-mut (local output)) (local writing)))
			(let width (call write_translation_unit (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local statements))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) (local first) (struct.get (local headers) stdint)
				(struct.get (local headers) runtime) (local private_helpers) (local name_prefix) (local writing)))
			(if
				(:doc "An empty test inventory still needs a synthetic entry.")
				(i32.not-ltz (local test_count))
				(then (return (call write_test_entry (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local nodes)) (borrow-shared (local functions)) (borrow-shared (local tests)) (local test_count)
					(borrow-mut (local output)) (local width) (local name_prefix) (local writing)))))
			(return (local width))))

	(fn run_scalar_graph
		(:doc `Consume the successful graph resolver's active modules and populated binding prefix.

		Reuse the resolver's target context for signature selection.
		Ordinary builds use the canonical root for ABI main. Test builds
		use a synthetic entry with the discovered inventory. A negative query path
		selects C emission, otherwise inspect the given name through the path
		row's local bindings. Both destinations remain untouched on failure.`)
		(:expect
			(tests "stage-2/scalar_graphs.tsv" "stage-2/test_execution.tsv" "stage-2/native_alias/cases.tsv" "stage-2/native_records/cases.tsv" "stage-2/native_values/cases.tsv")
			(issues "gh:wove-lang/wove:71" "gh:wove-lang/wove:129" "gh:wove-lang/wove:140" "gh:wove-lang/wove:142" "gh:wove-lang/wove:144" "gh:wove-lang/wove:146" "gh:wove-lang/wove:154" "gh:wove-lang/wove:186" "gh:wove-lang/wove:194" "gh:wove-lang/wove:223" "gh:wove-lang/wove:222"))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (shared-array GraphBinding)) (resolved GraphResult) (root i32) (query_path i32) (name (shared-array u8))
			(assets (shared-array SuppliedFile)) (private_helpers bool) (output (mut-array u8)) (callers (mut-array CallSite)))
		(returns GraphOutput)
		(body
			(let-mut trees (array.alloc ScalarTree (array.len (local files))))
			(let layout (call layout_trees (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local bindings)) (borrow-mut (local trees))))
			(if
				(:doc "Any view or table sizing failure belongs to the original file.")
				(u32.gtz (struct.get (local layout) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local layout) file)
					(struct.get (local layout) start) (struct.get (local layout) end) (struct.get (local layout) error)))))
			(let workspace (call graph_function_workspace (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local trees)) (struct.get (local layout) rows) (call signature_capacity (borrow-shared (local bindings)))))
			(if
				(:doc "Bound concrete function storage before allocating the checked graph arrays.")
				(u32.gtz (struct.get (local workspace) error))
				(then (return (call graph_output 0i32 -1i32 (local root) 0i32 0i32 (struct.get (local workspace) error)))))
			(let-mut rows (struct.get (local workspace) rows))
			(let-mut capacity (struct.get (local workspace) functions))
			(while
				(:doc "A transitive request may need more concrete rows than are present in the authored call sites.")
				(i32.lt -1i32 (local rows))
				(body
					(let result (call run_scalar_graph_workspace (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local modules)) (borrow-shared (local bindings)) (local resolved) (local root)
						(local query_path) (borrow-shared (local name)) (borrow-shared (local assets)) (local private_helpers)
						(borrow-shared (local trees)) (local rows) (local capacity) (borrow-mut (local output)) (borrow-mut (local callers))))
					(if
						(:doc "Only the private pre-emission clone shortage can be retried.")
						(u32.not-eq (struct.get (local result) error) (local function_workspace_full))
						(then (return (local result))))
					(if
						(:doc "Translate an unrepresentable workspace to the ordinary capacity diagnostic.")
						(bool.not (call can_grow_function_workspace (local rows) (local capacity)))
						(then (return (call graph_output 0i32 -1i32 (struct.get (local result) file)
							(struct.get (local result) start) (struct.get (local result) end) 16u32))))
					(set (local rows) (i32.add (local rows) (local rows)))
					(set (local capacity) (i32.add (local capacity) (local capacity)))))
			(return (call graph_output 0i32 -1i32 (local root) 0i32 0i32 16u32))))

	(fn run_scalar_graph_workspace
		(:doc "Check, inspect, or emit a supplied graph using one private allocation attempt.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (shared-array GraphBinding)) (resolved GraphResult) (root i32) (query_path i32) (name (shared-array u8))
			(assets (shared-array SuppliedFile)) (private_helpers bool) (trees (shared-array ScalarTree)) (rows i32)
			(signatures_capacity i32) (output (mut-array u8)) (callers (mut-array CallSite))) (returns GraphOutput)
		(body
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let test_executable (bool.and (u32.eq (struct.get (local resolved) mode) 2u32) (i32.ltz (local query_path))))
			(let-mut test_capacity 0i32)
			(if
				(:doc "Every discovered test is one of the checked Wove signatures.")
				(local test_executable)
				(then (set (local test_capacity) (local signatures_capacity))))
			(let-mut tests (array.alloc DiscoveredTest (local test_capacity)))
			(let-mut functions (array.alloc ScalarFunction (local signatures_capacity)))
			(let-mut parameters (array.alloc ScalarParameter (local rows)))
			(let-mut records (array.alloc ScalarRecord (local rows)))
			(let-mut statements (array.alloc ScalarStatement (local rows)))
			(let-mut expressions (array.alloc ScalarExpression (local rows)))
			(let-mut sites (array.alloc CallSite (local rows)))
			(let plan (call check_graph_plan (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local bindings)) (local resolved)
				(local root) (local test_executable) (borrow-shared (local trees)) (borrow-mut (local nodes))
				(borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records))
				(borrow-mut (local statements)) (borrow-mut (local expressions)) (borrow-mut (local sites))
				(borrow-mut (local tests))))
			(if
				(:doc "Keep checked diagnostics and related transfers in the original file.")
				(u32.gtz (struct.get (local plan) error))
				(then (return (struct.new GraphOutput (count 0i32) (declaration -1i32)
					(file (struct.get (local plan) file)) (start (struct.get (local plan) start))
					(end (struct.get (local plan) end)) (error (struct.get (local plan) error))
					(related_start (struct.get (local plan) related_start)) (related_end (struct.get (local plan) related_end))))))
			(if
				(:doc "Inspect the requesting file's bindings against the checked call sites.")
				(i32.not-ltz (local query_path))
				(then
					(let result (call inspect_graph_name (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local trees)) (borrow-shared (local nodes)) (borrow-shared (local functions))
						(borrow-shared (local bindings)) (borrow-shared (local sites)) (struct.get (local plan) call_count)
						(local query_path) (borrow-shared (local name)) (borrow-mut (local callers))))
					(return (call graph_output (struct.get (local result) count) (struct.get (local result) declaration)
						(struct.get (local result) file) (struct.get (local result) start) (struct.get (local result) end)
						(struct.get (local result) error)))))
			(let embedded (call bind_graph_embeds (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local assets)) (borrow-mut (local expressions))))
			(if
				(:doc "Report the original quoted operand if a supplied asset is unavailable.")
				(u32.gtz (struct.get (local embedded) error))
				(then (return (call graph_output 0i32 -1i32 (struct.get (local embedded) file)
					(struct.get (local embedded) start) (struct.get (local embedded) end) (struct.get (local embedded) error)))))
			(return (call write_graph_c (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local trees))
				(borrow-shared (local nodes)) (borrow-shared (local functions)) (borrow-shared (local parameters))
				(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local expressions))
				(local root) (local plan) (borrow-shared (local tests)) (local private_helpers)
				(bool false) (bool false) -1i32 (borrow-mut (local output))))))

	(fn bind_entry_assets
		(:doc "Attach loaded ranges to the already checked expressions and preserve source-relative diagnostics.")
		(params (length i32) (files (shared-array SuppliedFile)) (requests (shared-array EmbedAsset))
			(expressions (mut-array ScalarExpression))) (returns EmbedCheck)
		(body
			(let bound (call bind_module_embeds (local length) (borrow-shared (local requests)) (borrow-mut (local expressions))))
			(if
				(:doc "Request spans are measured in the whole arena.")
				(u32.gtz (struct.get (local bound) error))
				(then
					(let file (struct.get (local bound) file))
					(let base (struct.get (array.load (local files) (local file)) source_start))
					(return (call embed_check 0i32 (local file)
						(i32.sub (struct.get (local bound) start) (local base))
						(i32.sub (struct.get (local bound) end) (local base)) (struct.get (local bound) error)))))
			(return (local bound))))

	(fn graph_plan_error
		(:doc "Keep the first checking error together with its original source coordinates.")
		(params (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32))
		(returns GraphPlan)
		(body
			(return (struct.new GraphPlan (entry -1i32) (test_count -1i32) (call_count 0i32)
				(file (local file)) (start (local start)) (end (local end)) (error (local error))
				(related_start (local related_start)) (related_end (local related_end))))))

	(fn check_graph_plan
		(:doc "Check the inventory, signatures, and bodies once in their original order.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (shared-array GraphBinding)) (resolved GraphResult) (root i32) (test_executable bool)
			(trees (shared-array ScalarTree)) (nodes (mut-array SourceNode)) (functions (mut-array ScalarFunction))
			(parameters (mut-array ScalarParameter)) (records (mut-array ScalarRecord)) (statements (mut-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (sites (mut-array CallSite)) (tests (mut-array DiscoveredTest)))
		(returns GraphPlan)
		(body
			(let-mut test_count -1i32)
			(if
				(:doc "Use the existing inventory's ordering and signature diagnostics before lowering bodies.")
				(local test_executable)
				(then
					(let inventory (call discover_graph_tests (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local modules)) (local resolved) (borrow-mut (local tests))))
					(if
						(:doc "A test declaration error belongs to the defining file.")
						(u32.gtz (struct.get (local inventory) error))
						(then (return (call graph_plan_error (struct.get (local inventory) file)
							(struct.get (local inventory) start) (struct.get (local inventory) end)
							(struct.get (local inventory) error) -1i32 -1i32))))
					(set (local test_count) (struct.get (local inventory) count))))
			(let signatures (call prepare_graph (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local trees)) (borrow-shared (local bindings)) (local root) (call graph_selection (local resolved))
				(borrow-mut (local nodes)) (borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records))
				(borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Every reached signature must be valid before resolving cross-file calls.")
				(u32.gtz (struct.get (local signatures) error))
				(then (return (call graph_plan_error (struct.get (local signatures) file)
					(struct.get (local signatures) start) (struct.get (local signatures) end)
					(struct.get (local signatures) error) -1i32 -1i32))))
			(let checked (call plan_bodies (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local bindings))
				(borrow-mut (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
				(borrow-mut (local sites)) 0i32))
			(if
				(:doc "Keep body diagnostics and related transfers in the original file.")
				(u32.gtz (struct.get (local checked) error))
				(then (return (call graph_plan_error (struct.get (local checked) file)
					(struct.get (local checked) start) (struct.get (local checked) end) (struct.get (local checked) error)
					(struct.get (local checked) related_start) (struct.get (local checked) related_end)))))
			(return (struct.new GraphPlan (entry (struct.get (local signatures) entry))
				(test_count (local test_count))
				(call_count (struct.get (local checked) count)) (file (local root)) (start 0i32) (end 0i32) (error 0u32)
				(related_start -1i32) (related_end -1i32)))))
)
