(module emit_static
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render checked constants as C initializer lists without runtime construction.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only record_index (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_member_name))
	(use wove-file "./runtime.wove" (only write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_decimal_literal))

	(let empty_initializer "{0}")
	(let array_open "{{")
	(let array_close "}}")
	(let repeat_open "[0 ... ")
	(let repeat_close "]=")

	(fn write_initializer_start
		(:doc `Write a scalar, a field designator, or the opening of a brace initializer.`)
		(params (source (shared-array u8)) (row ScalarExpression) (child i32) (extent i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get (local row) kind))
			(if
				(:doc "Typed scalar leaves need no temporaries or casts.")
				(u32.eq (local kind) 1u32)
				(then (return (call write_decimal_literal (borrow-shared (local source))
					(struct.get (local row) start) (struct.get (local row) end) (struct.get (local row) negative)
					(struct.get (local row) type) (borrow-mut (local output)) (local offset) (local writing)))))
			(if (u32.eq (local kind) 4u32) (then (return (call c_byte (borrow-mut (local output)) (local offset) 48u8 (local writing)))))
			(if (u32.eq (local kind) 5u32) (then (return (call c_byte (borrow-mut (local output)) (local offset) 49u8 (local writing)))))
			(if
				(:doc "Empty arrays and records initialize a layout placeholder.")
				(i32.lt (local child) 0i32)
				(then (return (call c_literal_text (borrow-shared (local empty_initializer))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Write a record member by native ordinal while preserving source order.")
				(u32.eq (local kind) 51u32)
				(then
					(let dot (call c_byte (borrow-mut (local output)) (local offset) 46u8 (local writing)))
					(let member (call write_member_name (borrow-shared (local source)) (struct.get (local row) target)
						(borrow-mut (local output)) (local dot) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local member) 61u8 (local writing)))))
			(if
				(:doc "A record has one set of braces. An inline array also opens its item list.")
				(u32.eq (local kind) 50u32)
				(then (return (call c_byte (borrow-mut (local output)) (local offset) 123u8 (local writing)))))
			(let open (call c_literal_text (borrow-shared (local array_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "Lists and single-element repeats need no range designator.")
				(bool.not (i32.lt 1i32 (local extent)))
				(then (return (local open))))
			(let begin (call c_literal_text (borrow-shared (local repeat_open))
				(borrow-mut (local output)) (local open) (local writing)))
			(let-mut digits (array.alloc u8 11i32))
			(let last (call write_c_number (borrow-mut (local output)) (local begin)
				(i32.sub.wrapping (local extent) 1i32) (borrow-mut (local digits)) (local writing)))
			(return (call c_literal_text (borrow-shared (local repeat_close))
				(borrow-mut (local output)) (local last) (local writing)))))

	(fn initializer_extent
		(:doc `Read the declared count of a checked repeat.`)
		(params (records (shared-array ScalarRecord)) (row ScalarExpression))
		(returns i32)
		(body
			(return (struct.get (array.load (local records) (call record_index (struct.get (local row) type))) count))))

	(fn write_static_initializer
		(:doc `Walk the checked initializer without using the host stack for source nesting.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(records (shared-array ScalarRecord)) (root i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let value (array.load (local expressions) (local root)))
			(if
				(:doc "The ordinary scalar module path needs no aggregate traversal.")
				(u32.lt (struct.get (local value) kind) 50u32)
				(then (return (call write_initializer_start (borrow-shared (local source)) (local value) -1i32 0i32
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let-mut index (local root))
			(let-mut cursor (local offset))
			(let-mut entering (bool true))
			(while
				(:doc "Open on entry, then close the value after its last initializer operand.")
				(i32.lt -1i32 (local index))
				(body
					(let row (array.load (local expressions) (local index)))
					(let kind (struct.get (local row) kind))
					(let-mut extent 0i32)
					(let-mut child (struct.get (local row) first))
					(if
						(:doc "A repeat emits its one checked element, except when its extent is zero.")
						(u32.eq (local kind) 72u32)
						(then
							(set (local extent) (call initializer_extent (borrow-shared (local records)) (local row)))
							(if (i32.eq (local extent) 0i32) (then (set (local child) -1i32)))))
					(if
						(:doc "Enter the first operand, or prepare to finish a leaf in the next step.")
						(local entering)
						(then
							(set (local cursor) (call write_initializer_start (borrow-shared (local source)) (local row) (local child) (local extent)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local entering) (i32.lt -1i32 (local child)))
							(if
								(:doc "A nonempty aggregate or field continues at its first checked initializer.")
								(local entering)
								(then (set (local index) (local child)))))
						(else
							(if
								(:doc "Close brace-delimited values that opened a child list.")
								(bool.and (i32.lt -1i32 (local child)) (bool.not (u32.eq (local kind) 51u32)))
								(then
									(if
										(:doc "A record closes one brace, while an array closes its wrapper and item list.")
										(u32.eq (local kind) 50u32)
										(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing))))
										(else (set (local cursor) (call c_literal_text (borrow-shared (local array_close))
											(borrow-mut (local output)) (local cursor) (local writing)))))))
							(if (i32.eq (local index) (local root)) (then (return (local cursor))))
							(let node (array.load (local nodes) (local index)))
							(let parent_index (struct.get (local node) parent))
							(let parent_kind (struct.get (array.load (local expressions) (local parent_index)) kind))
							(if
								(:doc "A field wrapper owns the comma after its value. Array elements own their commas directly.")
								(bool.not (u32.eq (local parent_kind) 51u32))
								(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))))
							(let sibling (struct.get (local node) next_sibling))
							(set (local entering) (i32.lt -1i32 (local sibling)))
							(set (local index) (local parent_index))
							(if (local entering) (then (set (local index) (local sibling))))))))
			(return (local cursor)))))
