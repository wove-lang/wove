(module emit_static
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render checked constants as C initializer lists without runtime construction.`)

	(use wove-file "../source/float_ops.wove" (only (value float_literal)))
	(use wove-file "./floats.wove" (only write_floating_literal))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only record_index (type ScalarRecord)))
	(use wove-file "./members.wove" (only named_member write_member))
	(use wove-file "./runtime.wove" (only write_c_number))
	(use wove-file "./integers.wove" (only write_integer_literal))
	(use wove-file "./text.wove" (only c_byte c_literal_text))

	(let empty_initializer "{0}")
	(let array_open "{{")
	(let array_close "}}")
	(let repeat_open "[0 ... ")
	(let repeat_close "]=")

	(fn write_initializer_start
		(:doc `Write a scalar, a field designator, or the opening of a brace initializer.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (index i32) (child i32) (extent i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let row (expressions.get index))
			(let kind row/kind)
			(if
				(:doc "Typed scalar leaves need no temporaries or casts.")
				(kind.eq 1u32)
				(then (return (call write_integer_literal (borrow-shared source) row
					(borrow-mut output) offset writing))))
			(if
				(:doc "The same checked float spelling is valid in static storage.")
				(kind.eq float_literal)
				(then (return (call write_floating_literal (borrow-shared source) row
					(borrow-mut output) offset writing))))
			(if (kind.eq 4u32) (then (return (call c_byte (borrow-mut output) offset 48u8 writing))))
			(if (kind.eq 5u32) (then (return (call c_byte (borrow-mut output) offset 49u8 writing))))
			(if
				(:doc "Empty arrays and records initialize a layout placeholder.")
				child.ltz
				(then (return (call c_literal_text (borrow-shared empty_initializer)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Use the parent constructor’s checked layout without changing source initializer order.")
				(kind.eq 51u32)
				(then
					(let dot (call c_byte (borrow-mut output) offset 46u8 writing))
					(let field (nodes.get index))
					(let parent (expressions.get field/parent))
					(let layout (records.get parent/target))
					(let member (call named_member layout (nodes.get field/first_child)))
					(let name (call write_member (borrow-shared source) member
						(borrow-mut output) dot name_prefix writing))
					(return (call c_byte (borrow-mut output) name 61u8 writing))))
			(if
				(:doc "A record has one set of braces. An inline array also opens its item list.")
				(kind.eq 50u32)
				(then (return (call c_byte (borrow-mut output) offset 123u8 writing))))
			(let open (call c_literal_text (borrow-shared array_open)
				(borrow-mut output) offset writing))
			(if
				(:doc "Lists and single-element repeats need no range designator.")
				(i32:not-lt 1i32 extent)
				(then (return open)))
			(let begin (call c_literal_text (borrow-shared repeat_open)
				(borrow-mut output) open writing))
			(let last (call write_c_number (borrow-mut output) begin
				extent.dec writing))
			(return (call c_literal_text (borrow-shared repeat_close)
				(borrow-mut output) last writing))))

	(fn initializer_extent
		(:doc `Read the declared count of a checked repeat.`)
		(params (records (shared-array ScalarRecord)) (row ScalarExpression))
		(returns i32)
		(body
			(return (struct:get (records.get (call record_index row/type)) count))))

	(fn write_static_initializer
		(:doc `Walk the checked initializer without using the host stack for source nesting.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(records (shared-array ScalarRecord)) (root i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let value (expressions.get root))
			(if
				(:doc "The ordinary scalar module path needs no aggregate traversal.")
				(bool:or (u32:lt value/kind 50u32)
					(u32:eq value/kind float_literal))
				(then (return (call write_initializer_start (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared expressions) root -1i32 0i32
					(borrow-mut output) offset name_prefix writing))))
			(let-mut index root)
			(let-mut cursor offset)
			(let-mut entering (bool true))
			(while
				(:doc "Open on entry, then close the value after its last initializer operand.")
				(i32:lt -1i32 index)
				(body
					(let row (expressions.get index))
					(let kind row/kind)
					(let-mut extent 0i32)
					(let-mut child row/first)
					(if
						(:doc "A repeat emits its one checked element, except when its extent is zero.")
						(kind.eq 72u32)
						(then
							(set extent (call initializer_extent (borrow-shared records) row))
							(if extent.eqz (then (set child -1i32)))))
					(if
						(:doc "Enter the first operand, or prepare to finish a leaf in the next step.")
						entering
						(then
							(set cursor (call write_initializer_start (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared expressions) index child extent
								(borrow-mut output) cursor name_prefix writing))
							(set entering (i32:lt -1i32 child))
							(if
								(:doc "A nonempty aggregate or field continues at its first checked initializer.")
								entering
								(then (set index child))))
						(else
							(if
								(:doc "Close brace-delimited values that opened a child list.")
								(bool:and (i32:lt -1i32 child) (kind.not-eq 51u32))
								(then
									(if
										(:doc "A record closes one brace, while an array closes its wrapper and item list.")
										(kind.eq 50u32)
										(then (set cursor (call c_byte (borrow-mut output) cursor 125u8 writing)))
										(else (set cursor (call c_literal_text (borrow-shared array_close)
											(borrow-mut output) cursor writing))))))
							(if (index.eq root) (then (return cursor)))
							(let node (nodes.get index))
							(let parent_index node/parent)
							(let parent_kind (struct:get (expressions.get parent_index) kind))
							(if
								(:doc "A field wrapper owns the comma after its value. Array elements own their commas directly.")
								(parent_kind.not-eq 51u32)
								(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
							(let sibling node/next_sibling)
							(set entering (i32:lt -1i32 sibling))
							(set index parent_index)
							(if entering (then (set index sibling)))))))
			(return cursor))))
