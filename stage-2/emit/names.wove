(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Build Stage 2 C names from stable declaration identities.

	Compose identity components with the archive's 31-bit FNV-1a hash.
	Hash the declared module name as the defining module key for single-module
	emission. Add the declaration kind and original name, independent of file
	layout, declaration order, and any future import spelling.`)
	c_names

	(use wove-file "../source/scan.wove" (only is_head_start_byte))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_seed fnv1a_byte))

	(fn
		(:doc `Hash a raw source span and a zero delimiter to separate identity components.`)
		hash_spelling
		(params (source (shared-slice u8)) (start i32) (end i32) (identity u32))
		(returns u32)
		(body
			(let-mut hash (local identity))
			(let-mut cursor (local start))
			(while
				(:doc "Use the exact original bytes, including any punctuation in the spelling.")
				(i32.lt (local cursor) (local end))
				(body
					(set (local hash) (call fnv1a_byte (local hash) (slice.load (local source) (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (call fnv1a_byte (local hash) (u8 0)))))

	(fn
		(:doc `Seed a defining module identity from its declared name.`)
		module_identity
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns u32)
		(body
			(return (call hash_spelling (borrow-shared (local source)) (local start) (local end) (call fnv1a_seed)))))

	(fn
		(:doc `Include the archive's four-byte little-endian declaration kind before the spelling.`)
		declaration_identity
		(params (source (shared-slice u8)) (start i32) (end i32) (module u32) (tag u8))
		(returns u32)
		(body
			(let kind (call fnv1a_byte (call fnv1a_byte (call fnv1a_byte (call fnv1a_byte (local module) (local tag)) (u8 0)) (u8 0)) (u8 0)))
			(return (call hash_spelling (borrow-shared (local source)) (local start) (local end) (local kind)))))

	(fn
		(:doc `Compute a defining function's stable identity with declaration kind 2.`)
		function_identity
		(params (source (shared-slice u8)) (start i32) (end i32) (module u32))
		(returns u32)
		(body
			(return (call declaration_identity (borrow-shared (local source))
				(local start) (local end) (local module) (u8 2)))))

	(fn
		(:doc `Compute a defining record's stable identity with the archive's struct kind 1.`)
		record_identity
		(params (source (shared-slice u8)) (start i32) (end i32) (module u32))
		(returns u32)
		(body
			(return (call declaration_identity (borrow-shared (local source))
				(local start) (local end) (local module) (u8 1)))))

	(fn
		(:doc `Map every byte outside the C identifier alphabet to an underscore.`)
		c_suffix_byte
		(params (byte u8))
		(returns u8)
		(body
			(if
				(:doc "The generated prefix already supplies the first identifier byte, so digits are valid here.")
				(bool.or (call is_head_start_byte (local byte))
					(bool.and (bool.not (u8.lt (local byte) (u8 48))) (u8.lt (local byte) (u8 58))))
				(then (return (local byte))))
			(return (u8 95)))))
