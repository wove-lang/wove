(module c_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Build Stage 2 name fingerprints from stable parent keys with 32-bit FNV-1a.`)

	(use wove-file "../hashing/fnv1a.wove" (only (value fnv1a_seed) fnv1a_byte))

	(let module_role 109u8)
	(let function_role 102u8)
	(let export_trampoline_role 121u8)
	(let worker_adapter_role 119u8)
	(let worker_drop_role 122u8)
	(let callback_adapter_role 99u8)
	(let record_role 114u8)
	(let fixed_array_role 118u8)
	(let callable_role 107u8)
	(let readonly_type_role 113u8)
	(let bridge_string_backing_role 97u8)
	(let bridge_string_view_role 98u8)
	(let owner_take_role 120u8)
	(let owner_drop_role 101u8)
	(let owner_check_role 117u8)
	(let heap_slot_role 104u8)
	(let heap_slot_drop_role 111u8)
	(let fixed_slot_role 105u8)
	(let member_role 109u8)
	(let parameter_role 112u8)
	(let local_role 108u8)
	(let temporary_role 116u8)
	(let loop_label_role 106u8)
	(let module_data_role 100u8)
	(let module_bytes_role 115u8)

	(fn module_storage_role
		(:doc "Use d for module values and s for their private byte storage, separate from C string scratch and native literals.")
		(params (backing bool)) (returns u8)
		(body
			(if backing (then (return module_bytes_role)))
			(return module_data_role)))

	(fn hash_spelling
		(:doc `Hash a raw source span and a zero delimiter to separate identity components.`)
		(params (source (shared-array u8)) (start i32) (end i32) (identity u32))
		(returns u32)
		(body
			(let-mut hash identity)
			(let-mut cursor start)
			(while
				(:doc "Use the exact original bytes, including any punctuation in the spelling.")
				(i32:lt cursor end)
				(body
					(set hash (call fnv1a_byte hash (array:load source cursor)))
					(set cursor (i32:inc cursor))))
			(return (call fnv1a_byte hash 0u8))))

	(fn source_identity
		(:doc `Hash a canonical source path from the FNV-1a seed.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(return (call hash_spelling (borrow-shared source) start end fnv1a_seed))))

	(fn child_identity
		(:doc "Resume the parent's FNV-1a state with one fixed-width role byte and a zero-terminated child spelling.")
		(params (source (shared-array u8)) (start i32) (end i32) (parent u32) (role u8)) (returns u32)
		(body (return (call hash_spelling (borrow-shared source) start end (call fnv1a_byte parent role)))))

	(fn module_identity
		(:doc "Add a module name to its path fingerprint. A pathless emitter starts from the FNV-1a seed.")
		(params (source (shared-array u8)) (start i32) (end i32) (path u32)) (returns u32)
		(body (return (call child_identity (borrow-shared source) start end path module_role))))

	(fn function_identity
		(:doc `Extend the defining module key with the original function name.`)
		(params (source (shared-array u8)) (start i32) (end i32) (module u32))
		(returns u32)
		(body (return (call child_identity (borrow-shared source) start end module function_role))))

	(fn parameter_identity
		(:doc "Extend the concrete function key with the exact declared spelling of its parameter.")
		(params (source (shared-array u8)) (start i32) (end i32) (function u32)) (returns u32)
		(body (return (call child_identity (borrow-shared source) start end function parameter_role))))

	(fn record_identity
		(:doc "Use the defining module and original type name for the shared record and enum namespace.")
		(params (source (shared-array u8)) (start i32) (end i32) (module u32))
		(returns u32)
		(body (return (call child_identity (borrow-shared source) start end module record_role)))))
