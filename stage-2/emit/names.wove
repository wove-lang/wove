(module c_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Build Stage 2 C names from stable declaration identities.

	Compose identity components with the archive's 31-bit FNV-1a hash.
	Hash the declared module name as the defining module key for single-module
	emission. Add the declaration kind and original name, independent of file
	layout, declaration order, and any future import spelling.`)

	(use wove-file "../hashing/fnv1a.wove" (only (value fnv1a_seed) fnv1a_byte))

	(fn hash_spelling
		(:doc `Hash a raw source span and a zero delimiter to separate identity components.`)
		(params (source (shared-array u8)) (start i32) (end i32) (identity u32))
		(returns u32)
		(body
			(let-mut hash (local identity))
			(let-mut cursor (local start))
			(while
				(:doc "Use the exact original bytes, including any punctuation in the spelling.")
				(i32.lt (local cursor) (local end))
				(body
					(set (local hash) (call fnv1a_byte (local hash) (array.load (local source) (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(return (call fnv1a_byte (local hash) 0u8))))

	(fn module_identity
		(:doc `Seed a defining module identity from its declared name.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(return (call hash_spelling (borrow-shared (local source)) (local start) (local end) (local fnv1a_seed)))))

	(fn declaration_identity
		(:doc `Include the archive's four-byte little-endian declaration kind before the spelling.`)
		(params (source (shared-array u8)) (start i32) (end i32) (module u32) (tag u8))
		(returns u32)
		(body
			(let kind (call fnv1a_byte (call fnv1a_byte (call fnv1a_byte (call fnv1a_byte (local module) (local tag)) 0u8) 0u8) 0u8))
			(return (call hash_spelling (borrow-shared (local source)) (local start) (local end) (local kind)))))

	(fn function_identity
		(:doc `Compute a defining function's stable identity with declaration kind 2.`)
		(params (source (shared-array u8)) (start i32) (end i32) (module u32))
		(returns u32)
		(body
			(return (call declaration_identity (borrow-shared (local source))
				(local start) (local end) (local module) 2u8))))

	(fn record_identity
		(:doc `Compute a defining record's stable identity with the archive's struct kind 1.`)
		(params (source (shared-array u8)) (start i32) (end i32) (module u32))
		(returns u32)
		(body
			(return (call declaration_identity (borrow-shared (local source))
				(local start) (local end) (local module) 1u8)))))
