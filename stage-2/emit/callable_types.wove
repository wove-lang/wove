(module emit_callable_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit canonical C function-pointer types for checked Wove signatures.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../scalar/callable_types.wove" (only callable_parameter_type))
	(use wove-file "../scalar/records.wove" (only callable_layout_shape (type ScalarRecord)))
	(use wove-file "./text.wove" (only c_byte c_type_text c_literal_text write_c_name callable_name_role))

	(let typedef_prefix "typedef ")
	(let pointer_open " (*")
	(let parameters_open ")(")
	(let typedef_end ");\n")

	(fn write_callable_name
		(:doc "Reuse one C type alias for every structurally equal Wove signature in this translation unit.")
		(params (source (shared-array u8)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing)
				(local name_prefix) (call callable_name_role) (struct.get (local layout) identity)
				(borrow-shared (local source)) 0i32 0i32))))

	(fn write_callable_layout
		(:doc "Emit an exact C prototype, using void for an empty parameter list.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let shape (call callable_layout_shape (local layout)))
			(let-mut cursor (call c_literal_text (borrow-shared (local typedef_prefix)) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (struct.get (local shape) result) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local pointer_open)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_callable_name (borrow-shared (local source)) (local layout)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local parameters_open)) (borrow-mut (local output)) (local cursor) (local writing)))
			(let first (struct.get (local shape) first))
			(if
				(:doc "A zero-parameter signature must still be prototyped.")
				(i32.ltz (local first))
				(then (set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (call void_type) (local writing)))))
			(let-mut index (local first))
			(while
				(:doc "Render each formal with its exact C scalar type.")
				(i32.not-ltz (local index))
				(body
					(if (i32.not-eq (local index) (local first))
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))))
					(let type (call callable_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local index) (struct.get (local shape) named)))
					(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (local type) (local writing)))
					(set (local index) (struct.get (array.load (local nodes) (local index)) next_sibling))))
			(return (call c_literal_text (borrow-shared (local typedef_end)) (borrow-mut (local output)) (local cursor) (local writing)))))
)
