(module emit_callable_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit canonical C function-pointer types for checked Wove signatures.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../scalar/callable_types.wove" (only callable_parameter_type))
	(use wove-file "../scalar/records.wove" (only callable_layout_shape (type ScalarRecord)))
	(use wove-file "./text.wove" (only c_byte c_type_text c_literal_text get_name callable_name_role (type CNameParent) (type CNameSpelling)))

	(let typedef_prefix "typedef ")
	(let pointer_open " (*")
	(let parameters_open ")(")
	(let typedef_end ");\n")

	(fn write_callable_name
		(:doc "Reuse one C type alias for every structurally equal Wove signature in this translation unit.")
		(params (source (shared-array u8)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call get_name
				(struct.new CNameParent (identity (struct.get layout identity)) (slot (struct.get layout c_name_slot)))
				(call callable_name_role) (struct.new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(fn write_callable_layout
		(:doc "Emit an exact C prototype, using void for an empty parameter list.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let shape (call callable_layout_shape layout))
			(let-mut cursor (call c_literal_text (borrow-shared typedef_prefix) (borrow-mut output) offset writing))
			(set cursor (call c_type_text (borrow-mut output) cursor (struct.get shape result) writing))
			(set cursor (call c_literal_text (borrow-shared pointer_open) (borrow-mut output) cursor writing))
			(set cursor (call write_callable_name (borrow-shared source) layout
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared parameters_open) (borrow-mut output) cursor writing))
			(let first (struct.get shape first))
			(if
				(:doc "A zero-parameter signature must still be prototyped.")
				(i32.ltz first)
				(then (set cursor (call c_type_text (borrow-mut output) cursor (call void_type) writing))))
			(let-mut index first)
			(while
				(:doc "Render each formal with its exact C scalar type.")
				(i32.not-ltz index)
				(body
					(if (i32.not-eq index first)
						(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
					(let type (call callable_parameter_type (borrow-shared source) (borrow-shared nodes) index (struct.get shape named)))
					(set cursor (call c_type_text (borrow-mut output) cursor type writing))
					(set index (struct.get (array.load nodes index) next_sibling))))
			(return (call c_literal_text (borrow-shared typedef_end) (borrow-mut output) cursor writing))))
)
