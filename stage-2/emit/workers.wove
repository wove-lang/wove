(module emit_workers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Adapt ordinary Wove record values to the shared worker receipt runtime.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_record_type is_owning_record record_index (type ScalarRecord)))
	(use wove-file "../scalar/syntax.wove" (only is_worker_launch (value worker_spawn_kind) (value worker_spawn_on_kind) (value worker_try_spawn_kind) (value worker_pop_front_kind)))
	(use wove-file "../scalar/worker.wove" (only worker_result_type worker_collection_record))
	(use wove-file "./function_names.wove" (only write_function_name))
	(use wove-file "./owned_aggregates.wove" (only write_owner_helper_name open_owned_slot_call))
	(use wove-file "./records.wove" (only write_record_name write_array_layout_argument))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))
	(use wove-file "./enums.wove" (only close_transfer_outcome))
	(use wove-file "./runtime.wove" (only close_runtime_call))

	(let queue_pop_front_call "wvrt_worker_queue_pop_front_at_span(")
	(let queue_length_member "->wvrt_length")
	(let spawn_on_record_call "wvrt_worker_spawn_on_record_at_span(")
	(let try_spawn_call "(wvrt_worker_try_spawn_at_span(")
	(let no_direct_handler "NULL,")
	(let no_worker_adapter ",NULL,")
	(let array_job_layout ",0,0")
	(let join_records "WVRT_WORKER_JOIN_RECORDS(")
	(let join_owned_records "WVRT_WORKER_JOIN_OWNED_RECORDS(")
	(let worker_declarations "WVRT_DECLARE_RECORD_WORKERS()\n")
	(let spawn_record "wvrt_worker_spawn_record_at_span(")
	(let join_record "wvrt_worker_spawn_join_record_at_span(")
	(let adapter_name "wvrt_worker_adapter_")
	(let adapter_static "static ")
	(let adapter_type "wvrt_array *")
	(let adapter_formals "(wvrt_array *wvrt_job,int32_t wvrt_file,int32_t wvrt_start,int32_t wvrt_end)")
	(let declaration_end ";\n")
	(let ignore_site "(void)wvrt_file;(void)wvrt_start;(void)wvrt_end;")
	(let return_value "return ")
	(let adapter_job "wvrt_job")
	(let adapter_site ",wvrt_file,wvrt_start,wvrt_end)")
	(let adapter_end ";}\n")
	(let pack_record "WVRT_WORKER_PACK(")
	(let unpack_record "WVRT_WORKER_UNPACK(")
	(let define_drop "WVRT_DEFINE_WORKER_DROP(")
	(let declare_drop "WVRT_DECLARE_WORKER_DROP(")
	(let define_linked_drop "WVRT_DEFINE_LINKED_WORKER_DROP(")
	(let drop_prefix "wvrt_worker_drop_")
	(let drop_end ")\n")
	(let null_drop "NULL")
	(let array_job_drop ",NULL")

	(let static_worker_adapters 0u8)
	(let declared_worker_adapters 1u8)
	(let linked_worker_adapters 2u8)

	(fn write_worker_queue_access
		(:doc "Inspect the live queue or remove its oldest receipt at the original Wove site.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let pop (u32.eq (struct.get row kind) worker_pop_front_kind))
			(let-mut cursor offset)
			(if
				(:doc "Only removal can fail and needs a checked runtime call.")
				pop
				(then (set cursor (call c_literal_text (borrow-shared queue_pop_front_call)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
				(struct.get row target) tree_base
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Empty removal carries the entire application form's source span.")
				pop
				(then (return (call close_runtime_call (borrow-mut output) cursor
					(struct.get row asset_start) (struct.get row start) (struct.get row end) writing))))
			(return (call c_literal_text (borrow-shared queue_length_member)
				(borrow-mut output) cursor writing))))

	(fn open_record_worker_call
		(:doc "Choose the dedicated launch entry that accepts a typed record adapter.")
		(params (kind u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A submitted job keeps its receipt for a later join.")
				(u32.eq kind worker_spawn_kind)
				(then (return (call c_literal_text (borrow-shared spawn_record)
					(borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared join_record)
				(borrow-mut output) offset writing))))

	(fn write_worker_adapter_name
		(:doc "Derive the adapter name from the exact defining function symbol.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared adapter_name)
				(borrow-mut output) offset writing))
			(return (call write_function_name (borrow-shared source) (borrow-shared nodes)
				function (borrow-mut output) prefix name_prefix writing))))

	(fn open_worker_transport
		(:doc "Write the exact C value type before the payload expression.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (macro (shared-array u8))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared macro)
				(borrow-mut output) offset writing))
			(let type (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) open name_prefix writing))
			(return (call c_byte (borrow-mut output) type 44u8 writing))))

	(fn open_worker_pack
		(:doc "Begin an evaluating pack of an exact record value.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call open_worker_transport (borrow-shared source) (borrow-shared nodes) layout
				(borrow-shared pack_record) (borrow-mut output) offset name_prefix writing))))

	(fn open_worker_unpack
		(:doc "Begin an evaluating unpack that transfers a boxed record to the receiver.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call open_worker_transport (borrow-shared source) (borrow-shared nodes) layout
				(borrow-shared unpack_record) (borrow-mut output) offset name_prefix writing))))

	(fn write_worker_record_collection
		(:doc "Collect boxed results into the existing exact inline record array layout.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(row ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Owning records need the same live slot and destructor as ordinary array allocation.")
				(struct.get layout owns_arrays)
				(then (set cursor (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared join_owned_records) (borrow-mut output)
					offset name_prefix writing)))
				(else (set cursor (call open_worker_transport (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared join_records) (borrow-mut output)
					offset name_prefix writing))))
			(let address (call c_byte (borrow-mut output) cursor 38u8 writing))
			(let slot (call write_local_name (borrow-shared source) (borrow-shared nodes)
				(struct.get row target) tree_base
				(borrow-mut output) address name_prefix writing))
			(return (call close_runtime_call (borrow-mut output) slot
				(struct.get row asset_start) (struct.get row start) (struct.get row end) writing))))

	(fn write_worker_drop_argument
		(:doc "Use the nominal recursive destructor for owning records and a null callback for copies.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let comma (call c_byte (borrow-mut output) offset 44u8 writing))
			(if
				(:doc "A copyable record has no live fields to destroy.")
				(bool.not (struct.get layout owns_arrays))
				(then (return (call c_literal_text (borrow-shared null_drop)
					(borrow-mut output) comma writing))))
			(let prefix (call c_literal_text (borrow-shared drop_prefix)
				(borrow-mut output) comma writing))
			(return (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) prefix name_prefix writing))))

	(fn write_worker_drop
		(:doc "Emit the erased drop callback for each boxed owning layout used by a worker.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (written (mut-array u8)) (mode u8) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if (bool.not (call is_owning_record (borrow-shared records) type)) (then (return offset)))
			(let index (call record_index type))
			(if (u8.not-eqz (array.load written index)) (then (return offset)))
			(array.store written index 1u8)
			(let layout (array.load records index))
			(if
				(:doc "The shared header exposes the callback with its erased runtime signature.")
				(u8.eq mode declared_worker_adapters)
				(then
					(let prefix (call c_literal_text (borrow-shared declare_drop)
						(borrow-mut output) offset writing))
					(let name (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
						(borrow-mut output) prefix name_prefix writing))
					(return (call c_literal_text (borrow-shared drop_end) (borrow-mut output) name writing))))
			(let-mut prefix offset)
			(if
				(:doc "The same recursive destructor serves both serial and numbered definitions.")
				(u8.eq mode linked_worker_adapters)
				(then (set prefix (call c_literal_text (borrow-shared define_linked_drop)
					(borrow-mut output) offset writing)))
				(else (set prefix (call c_literal_text (borrow-shared define_drop)
					(borrow-mut output) offset writing))))
			(let name (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) prefix name_prefix writing))
			(let open (call c_byte (borrow-mut output) name 44u8 writing))
			(let drop (call write_owner_helper_name (borrow-shared source) (borrow-shared nodes) layout
				(bool false) (borrow-mut output) open name_prefix writing))
			(return (call c_literal_text (borrow-shared drop_end) (borrow-mut output) drop writing))))

	(fn write_worker_adapter
		(:doc "Expose the checked worker signature and marshal record values around the Wove call.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(function ScalarFunction) (job u32) (mode u8) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Only the serial adapter stays private to its translation unit.")
				(u8.eq mode static_worker_adapters)
				(then (set cursor (call c_literal_text (borrow-shared adapter_static)
					(borrow-mut output) cursor writing))))
			(let prefix (call c_literal_text (borrow-shared adapter_type)
				(borrow-mut output) cursor writing))
			(let name (call write_worker_adapter_name (borrow-shared source) (borrow-shared nodes) function
				(borrow-mut output) prefix name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared adapter_formals)
				(borrow-mut output) name writing))
			(if
				(:doc "Use the same signature for the header declaration and the definition.")
				(u8.eq mode declared_worker_adapters)
				(then (return (call c_literal_text (borrow-shared declaration_end)
					(borrow-mut output) cursor writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(let result (struct.get function result))
			(let boxed_result (call is_record_type result))
			(if
				(:doc "An array result reuses its descriptor and needs no allocation site in the adapter.")
				(bool.not boxed_result)
				(then (set cursor (call c_literal_text (borrow-shared ignore_site)
					(borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared return_value)
				(borrow-mut output) cursor writing))
			(if
				(:doc "The worker packs a returned record once, preserving the original launch site for allocation failure.")
				boxed_result
				(then (set cursor (call open_worker_pack (borrow-shared source) (borrow-shared nodes)
					(array.load records (call record_index result))
					(borrow-mut output) cursor name_prefix writing))))
			(set cursor (call write_function_name (borrow-shared source) (borrow-shared nodes) function
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(let boxed_job (call is_record_type job))
			(if
				(:doc "Transfer the exact record and release its transport before the Wove callee takes ownership.")
				boxed_job
				(then (set cursor (call open_worker_unpack (borrow-shared source) (borrow-shared nodes)
					(array.load records (call record_index job))
					(borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_literal_text (borrow-shared adapter_job)
				(borrow-mut output) cursor writing))
			(if
				(:doc "Finish unboxing before closing the ordinary function call.")
				boxed_job
				(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))
			(if
				(:doc "A boxed result uses the same destructor on allocation failure and receipt cleanup.")
				boxed_result
				(then
					(set cursor (call write_worker_drop_argument (borrow-shared source) (borrow-shared nodes)
						(array.load records (call record_index result))
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared adapter_site)
						(borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared adapter_end)
				(borrow-mut output) cursor writing))))

	(fn is_record_worker_launch
		(:doc "A launch with a record endpoint uses a generated adapter.")
		(params (row ScalarExpression))
		(returns bool)
		(body
			(return (bool.and (i32.ltz (struct.get row asset_end))
				(call is_worker_launch (struct.get row kind))))))

	(fn worker_job_index
		(:doc "Only pooled submission captures an admission operand before the job.")
		(params (nodes (shared-array SourceNode)) (row ScalarExpression))
		(returns i32)
		(body
			(let first (struct.get row first))
			(if
				(:doc "The permit is outside the adapter's formal arguments.")
				(u32.eq (struct.get row kind) worker_spawn_on_kind)
				(then (return (struct.get (array.load nodes first) next_sibling))))
			(return first)))

	(fn write_worker_job_argument
		(:doc "Supply the captured job and its transport layout to a runtime submission.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (operand i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let boxed (call is_record_type type))
			(let-mut cursor offset)
			(if
				(:doc "The runtime boxes a record from the address of its captured value.")
				boxed
				(then (set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(set cursor (call write_temporary_name (borrow-shared nodes) operand (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "An array is already an owned descriptor and needs no transport layout.")
				(bool.not boxed)
				(then (return (call c_literal_text (borrow-shared array_job_layout)
					(borrow-mut output) cursor writing))))
			(let size (call write_array_layout_argument (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (bool false)
				(borrow-mut output) cursor name_prefix writing))
			(return (call write_array_layout_argument (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (bool true)
				(borrow-mut output) size name_prefix writing))))

	(fn write_pooled_record_worker
		(:doc "Submit an adapter after the permit and the job have been captured in source order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (row ScalarExpression) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared spawn_on_record_call)
				(borrow-mut output) offset writing))
			(let handler (call write_worker_adapter_name (borrow-shared source) (borrow-shared nodes)
				callee (borrow-mut output) open name_prefix writing))
			(let permit_start (call c_byte (borrow-mut output) handler 44u8 writing))
			(let permit (call write_temporary_name (borrow-shared nodes) (struct.get row first) (borrow-mut output) permit_start name_prefix writing))
			(let job_start (call c_byte (borrow-mut output) permit 44u8 writing))
			(let operand (call worker_job_index (borrow-shared nodes) row))
			(let type (struct.get (array.load expressions operand) type))
			(let-mut cursor (call write_worker_job_argument (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type operand
				(borrow-mut output) job_start name_prefix writing))
			(if
				(:doc "Before admission the runtime can drop an owning record or its box using the recursive destructor.")
				(call is_record_type type)
				(then (set cursor (call write_worker_drop_argument (borrow-shared source) (borrow-shared nodes)
					(array.load records (call record_index type))
					(borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call c_literal_text (borrow-shared array_job_drop)
					(borrow-mut output) cursor writing))))
			(return (call close_runtime_call (borrow-mut output) cursor
				(struct.get row asset_start) (struct.get row start) (struct.get row end) writing))))

	(fn write_worker_try_spawn
		(:doc "Pass a captured job to the fallible path and keep that same value available for rejection.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (callee ScalarFunction) (job_type u32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared try_spawn_call)
				(borrow-mut output) offset writing))
			(let queue (call write_local_name (borrow-shared source) (borrow-shared nodes)
				(struct.get row projection) tree_base
				(borrow-mut output) open name_prefix writing))
			(let-mut cursor (call c_byte (borrow-mut output) queue 44u8 writing))
			(if
				(:doc "Choose one callback with its exact C signature and leave the other empty.")
				(call is_record_worker_launch row)
				(then
					(set cursor (call c_literal_text (borrow-shared no_direct_handler)
						(borrow-mut output) cursor writing))
					(set cursor (call write_worker_adapter_name (borrow-shared source) (borrow-shared nodes)
						callee (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing)))
				(else
					(set cursor (call write_function_name (borrow-shared source) (borrow-shared nodes)
						callee (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared no_worker_adapter)
						(borrow-mut output) cursor writing))))
			(set cursor (call write_worker_job_argument (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) job_type (struct.get row first)
				(borrow-mut output) cursor name_prefix writing))
			(let condition (call close_runtime_call (borrow-mut output) cursor
				(struct.get row asset_start) (struct.get row start) (struct.get row end) writing))
			(let-mut rejected 1i32)
			(if (struct.get row negative) (then (set rejected 0i32)))
			(return (call close_transfer_outcome (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (struct.get row type) rejected
				(struct.get row first) (borrow-mut output) condition name_prefix writing))))

	(fn write_worker_adapters
		(:doc "Emit each referenced adapter once after the normal prototypes and aggregate destructors.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(functions (shared-array ScalarFunction)) (expressions (shared-array ScalarExpression))
			(mode u8) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut index 0i32)
			(let-mut needs_declarations (bool false))
			(while
				(:doc "Find the first adapter and note any standalone record collection or fallible launch.")
				(bool.and (i32.lt index (array.len expressions))
					(bool.not (call is_record_worker_launch (array.load expressions index))))
				(body
					(let row (array.load expressions index))
					(set needs_declarations (bool.or needs_declarations
						(bool.or (u32.eq (struct.get row kind) worker_try_spawn_kind)
							(u32.gtz (call worker_collection_record row)))))
					(set index (i32.inc index))))
			(let adapters (i32.lt index (array.len expressions)))
			(if
				(:doc "Ordinary array workers can use the base runtime declarations.")
				(bool.not (bool.or adapters needs_declarations))
				(then (return offset)))
			(let-mut cursor offset)
			(if
				(:doc "The numbered definition unit already includes these runtime declarations through the common header.")
				(u8.not-eq mode linked_worker_adapters)
				(then (set cursor (call c_literal_text (borrow-shared worker_declarations)
					(borrow-mut output) cursor writing))))
			(if (bool.not adapters) (then (return cursor)))
			(let-mut written_functions (array.alloc u8 (array.len functions)))
			(let-mut written_drops (array.alloc u8 (array.len records)))
			(while
				(:doc "Use the checked callee row across repeated launches and imported aliases.")
				(i32.lt index (array.len expressions))
				(body
					(let row (array.load expressions index))
					(let target (struct.get row target))
					(if
						(:doc "Only the first recorded launch of this function emits its adapter.")
						(bool.and (call is_record_worker_launch row)
							(u8.eqz (array.load written_functions target)))
						(then
							(array.store written_functions target 1u8)
							(let operand (call worker_job_index (borrow-shared nodes) row))
							(let job (struct.get (array.load expressions operand) type))
							(let result (call worker_result_type (struct.get row asset_end)))
							(set cursor (call write_worker_drop (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) job (borrow-mut written_drops) mode
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call write_worker_drop (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) result (borrow-mut written_drops) mode
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call write_worker_adapter (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (array.load functions target) job mode
								(borrow-mut output) cursor name_prefix writing))))
					(set index (i32.inc index))))
			(return cursor))))
