(module emit_embeds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Link checked embed expressions to immutable asset ranges and emit fresh byte-owner initializers.`)

	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only embed_expression))
	(use wove-file "../source/assets.wove" (only decode_asset_path embed_check (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../source/graph.wove" (only (type GraphModule)))
	(use wove-file "../source/paths.wove" (only resolve_path (type SuppliedFile)))
	(use wove-file "./runtime.wove" (only write_site_number close_runtime_call))
	(use wove-file "./text.wove" (only c_byte))

	(fn embed_failure
		(:doc `Translate a path token back from the arena into its defining source view.`)
		(params (expression ScalarExpression) (base i32))
		(returns EmbedCheck)
		(body
			(return (call embed_check 0i32 (struct.get (local expression) target)
				(i32.sub.wrapping (struct.get (local expression) asset_start) (local base))
				(i32.sub.wrapping (struct.get (local expression) asset_end) (local base)) 67u32))))

	(fn embed_with_bytes
		(:doc `Retain the original operation site while replacing the path span with its compiled bytes.`)
		(params (expression ScalarExpression) (start i32) (end i32))
		(returns ScalarExpression)
		(body
			(return (call embed_expression (struct.get (local expression) target) (struct.get (local expression) start)
				(struct.get (local expression) end) (local start) (local end)))))

	(fn graph_embed_asset
		(:doc `Resolve the asset in the defining module's reached directory against raw asset rows.`)
		(params (arena (shared-slice u8)) (assets (shared-slice SuppliedFile))
			(file SuppliedFile) (expression ScalarExpression))
		(returns i32)
		(body
			(let start (struct.get (local expression) asset_start))
			(let end (struct.get (local expression) asset_end))
			(let-mut path (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let length (call decode_asset_path (borrow-shared (local arena)) (local start) (local end) (borrow-mut (local path))))
			(if (i32.lt (local length) 0i32) (then (return -1i32)))
			(return (call resolve_path (borrow-shared (local arena)) (borrow-shared (local assets))
				(local file) (borrow-shared (slice.range (local path) 0i32 (local length)))))))

	(fn bind_graph_embeds
		(:doc `Resolve the selected bodies' asset requests without admitting asset bytes as Wove modules.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(assets (shared-slice SuppliedFile)) (expressions (mut-slice ScalarExpression)))
		(returns EmbedCheck)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only checked embed rows can request assets.")
				(i32.lt (local index) (slice.len (local expressions)))
				(body
					(let expression (slice.load (local expressions) (local index)))
					(if
						(:doc "Use the defining module even if a different module calls its function.")
						(u32.eq (struct.get (local expression) kind) 60u32)
						(then
							(let file (struct.get (local expression) target))
							(let reached (struct.get (slice.load (local modules) (local file)) path))
							(let asset (call graph_embed_asset (borrow-shared (local arena)) (borrow-shared (local assets))
								(slice.load (local files) (local reached)) (local expression)))
							(if
								(:doc "A missing asset is reported in the file containing the path token.")
								(i32.lt (local asset) 0i32)
								(then (return (call embed_failure (local expression)
									(struct.get (slice.load (local files) (local file)) source_start)))))
							(let found (slice.load (local assets) (local asset)))
							(let canonical (slice.load (local assets) (struct.get (local found) identity)))
							(slice.store (local expressions) (local index)
								(call embed_with_bytes (local expression) (struct.get (local canonical) source_start)
									(struct.get (local canonical) source_end)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (call embed_check 0i32 -1i32 0i32 0i32 0u32))))

	(fn request_module_embeds
		(:doc `Copy checked path spans into a table indexed by expression row for the native loader.`)
		(params (expressions (shared-slice ScalarExpression)) (requests (mut-slice EmbedAsset)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "Skipped declarations and statements have no checked embed expression.")
				(i32.lt (local index) (slice.len (local expressions)))
				(body
					(let expression (slice.load (local expressions) (local index)))
					(if
						(:doc "Record only genuine embed operands, independent of any opaque metadata.")
						(u32.eq (struct.get (local expression) kind) 60u32)
						(then
							(slice.store (local requests) (local index)
								(struct.new EmbedAsset (path_start (struct.get (local expression) asset_start))
									(path_end (struct.get (local expression) asset_end)) (bytes_start -1i32) (bytes_end -1i32)))
							(set (local count) (i32.add.wrapping (local count) 1i32))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (local count))))

	(fn bind_module_embeds
		(:doc `Link one module's checked expressions to its preloaded asset ranges.`)
		(params (arena_length i32) (assets (shared-slice EmbedAsset)) (expressions (mut-slice ScalarExpression)))
		(returns EmbedCheck)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The native loader keys its data by the same expression rows.")
				(i32.lt (local index) (slice.len (local expressions)))
				(body
					(let expression (slice.load (local expressions) (local index)))
					(if
						(:doc "A selected embed requires one matching, bounded payload range.")
						(u32.eq (struct.get (local expression) kind) 60u32)
						(then
							(if
								(:doc "Without a supplied row, the requested file has no payload.")
								(bool.not (i32.lt (local index) (slice.len (local assets))))
								(then (return (call embed_failure (local expression) 0i32))))
							(let asset (slice.load (local assets) (local index)))
							(let start (struct.get (local asset) bytes_start))
							(let end (struct.get (local asset) bytes_end))
							(if
								(:doc "Reject a mismatched request or invalid extent before writing the translation unit.")
								(bool.or
									(bool.not (bool.and (i32.eq (struct.get (local asset) path_start) (struct.get (local expression) asset_start))
										(i32.eq (struct.get (local asset) path_end) (struct.get (local expression) asset_end))))
									(bool.or (i32.lt (local start) 0i32)
										(bool.or (i32.lt (local end) (local start)) (i32.lt (local arena_length) (local end)))))
								(then (return (call embed_failure (local expression) 0i32))))
							(slice.store (local expressions) (local index)
								(call embed_with_bytes (local expression) (local start) (local end)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (call embed_check 0i32 -1i32 0i32 0i32 0u32))))

	(fn close_embed_copy
		(:doc `Give the runtime copy the exact count, including zero, and the original operation site.`)
		(params (expression ScalarExpression) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let length (i32.sub.wrapping (struct.get (local expression) asset_end) (struct.get (local expression) asset_start)))
			(let-mut digits (array.alloc u8 11i32))
			(let extent (call write_site_number (borrow-mut (local output)) (local offset) (local length)
				(borrow-mut (local digits)) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local extent)
				(struct.get (local expression) target) (struct.get (local expression) start) (struct.get (local expression) end) (local writing))))))
