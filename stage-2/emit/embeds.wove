(module emit_embeds
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Link checked embed expressions to immutable asset ranges.`)

	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only embed_expression))
	(use wove-file "../source/assets.wove" (only decode_asset_path embed_check (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../source/graph.wove" (only (type GraphModule)))
	(use wove-file "../source/paths.wove" (only resolve_path (type SuppliedFile)))

	(fn embed_failure
		(:doc `Translate a path token back from the arena into its defining source view.`)
		(params (expression ScalarExpression) (base i32))
		(returns EmbedCheck)
		(body
			(return (call embed_check 0i32 (struct:get expression target)
				(i32:sub (struct:get expression asset_start) base)
				(i32:sub (struct:get expression asset_end) base) 67u32))))

	(fn embed_with_bytes
		(:doc `Retain the original operation site while replacing the path span with its compiled bytes.`)
		(params (expression ScalarExpression) (start i32) (end i32))
		(returns ScalarExpression)
		(body
			(return (call embed_expression (struct:get expression target) (struct:get expression start)
				(struct:get expression end) start end))))

	(fn graph_embed_asset
		(:doc `Resolve the asset in the defining module's reached directory against raw asset rows.`)
		(params (arena (shared-array u8)) (assets (shared-array SuppliedFile))
			(file SuppliedFile) (expression ScalarExpression))
		(returns i32)
		(body
			(let start (struct:get expression asset_start))
			(let end (struct:get expression asset_end))
			(let-mut path (array:alloc u8 (i32:sub end start)))
			(let length (call decode_asset_path (borrow-shared arena) start end (borrow-mut path)))
			(if (i32:ltz length) (then (return -1i32)))
			(return (call resolve_path (borrow-shared arena) (borrow-shared assets)
				file (borrow-shared (array:range path 0i32 length))))))

	(fn bind_graph_embeds
		(:doc `Resolve the selected bodies' asset requests without admitting asset bytes as Wove modules.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(assets (shared-array SuppliedFile)) (expressions (mut-array ScalarExpression)))
		(returns EmbedCheck)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only checked embed rows can request assets.")
				(i32:lt index (array:len expressions))
				(body
					(let expression (array:load expressions index))
					(if
						(:doc "Use the defining module even if a different module calls its function.")
						(u32:eq (struct:get expression kind) 60u32)
						(then
							(let file (struct:get expression target))
							(let reached (struct:get (array:load modules file) path))
							(let asset (call graph_embed_asset (borrow-shared arena) (borrow-shared assets)
								(array:load files reached) expression))
							(if
								(:doc "A missing asset is reported in the file containing the path token.")
								(i32:ltz asset)
								(then (return (call embed_failure expression
									(struct:get (array:load files file) source_start)))))
							(let found (array:load assets asset))
							(let canonical (array:load assets (struct:get found identity)))
							(array:store expressions index
								(call embed_with_bytes expression (struct:get canonical source_start)
									(struct:get canonical source_end)))))
					(set index (i32:inc index))))
			(return (call embed_check 0i32 -1i32 0i32 0i32 0u32))))

	(fn request_module_embeds
		(:doc `Copy checked path spans into a table indexed by expression row for the native loader.`)
		(params (expressions (shared-array ScalarExpression)) (requests (mut-array EmbedAsset)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "Skipped declarations and statements have no checked embed expression.")
				(i32:lt index (array:len expressions))
				(body
					(let expression (array:load expressions index))
					(if
						(:doc "Record only genuine embed operands, independent of any opaque metadata.")
						(u32:eq (struct:get expression kind) 60u32)
						(then
							(array:store requests index
								(struct:new EmbedAsset (path_start (struct:get expression asset_start))
									(path_end (struct:get expression asset_end)) (bytes_start -1i32) (bytes_end -1i32)))
							(set count (i32:inc count))))
					(set index (i32:inc index))))
			(return count)))

	(fn bind_module_embeds
		(:doc `Link one module's checked expressions to its preloaded asset ranges.`)
		(params (arena_length i32) (assets (shared-array EmbedAsset)) (expressions (mut-array ScalarExpression)))
		(returns EmbedCheck)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The native loader keys its data by the same expression rows.")
				(i32:lt index (array:len expressions))
				(body
					(let expression (array:load expressions index))
					(if
						(:doc "A selected embed requires one matching, bounded payload range.")
						(u32:eq (struct:get expression kind) 60u32)
						(then
							(if
								(:doc "Without a supplied row, the requested file has no payload.")
								(i32:not-lt index (array:len assets))
								(then (return (call embed_failure expression 0i32))))
							(let asset (array:load assets index))
							(let start (struct:get asset bytes_start))
							(let end (struct:get asset bytes_end))
							(if
								(:doc "Reject a mismatched request or invalid extent before writing the translation unit.")
								(bool:or
									(bool:not (bool:and (i32:eq (struct:get asset path_start) (struct:get expression asset_start))
										(i32:eq (struct:get asset path_end) (struct:get expression asset_end))))
									(bool:or (i32:ltz start)
										(bool:or (i32:lt end start) (i32:lt arena_length end))))
								(then (return (call embed_failure expression 0i32))))
							(array:store expressions index
								(call embed_with_bytes expression start end))))
					(set index (i32:inc index))))
			(return (call embed_check 0i32 -1i32 0i32 0i32 0u32)))))
