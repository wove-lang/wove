(module emit_owner_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Capture an assignment destination after the replacement value is ready, and retire its previous owner.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement) (value owner_field_assignment)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_owning_record record_index (type ScalarRecord)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "./owned_aggregates.wove" (only open_owner_helper))
	(use wove-file "./records.wove" (only write_field_place write_value_type))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_destructor))
	(use wove-file "./c_storage.wove" (only open_storage_address))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))

	(let slot_address "=&(")
	(let end_call ");")
	(let array_drop "wvrt_array_drop(")
	(let pointer_guard "if(")
	(let storage_guard "if(wvrt_c_storage_active(")
	(let drop_call ")(void)")
	(let storage_end ")")
	(let storage_drop "wvrt_c_storage_free(")
	(let close_block ";}")

	(struct ReplacementSlot (fields (row i32) (name_prefix i32)))

	(fn write_replacement_slot
		(:doc "Use the reservation-aware statement temporary with a suffix distinct from the saved value.")
		(params (nodes (shared-array SourceNode)) (slot ReplacementSlot) (dereference bool)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "The slot temporary is a pointer to the owner value.")
				dereference
				(then (set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))))
			(let name (call write_temporary_name (borrow-shared nodes)
				(struct:get slot row)
				(borrow-mut output) cursor (struct:get slot name_prefix) writing))
			(return (call c_byte (borrow-mut output) name 114u8 writing))))

	(fn write_previous_owner_drop
		(:doc "Retire the captured slot using the exact aggregate, array, or native destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (slot ReplacementSlot) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Aggregate cleanup follows the original slot so partially moved fields remain safe.")
				(call is_owning_record (borrow-shared records) type)
				(then
					(let open (call open_owner_helper (borrow-shared source) (borrow-shared nodes)
						(array:get records (call record_index type)) (bool false)
						(borrow-mut output) offset (struct:get slot name_prefix) writing))
					(let address (call write_replacement_slot (borrow-shared nodes) slot (bool false)
						(borrow-mut output) open writing))
					(return (call c_literal_text (borrow-shared end_call)
						(borrow-mut output) address writing))))
			(if
				(:doc "Array and optional array owners share null-safe descriptor cleanup.")
				(bool:not (call is_native_owner type))
				(then
					(let open (call c_literal_text (borrow-shared array_drop) (borrow-mut output)
						offset writing))
					(let value (call write_replacement_slot (borrow-shared nodes) slot (bool true)
						(borrow-mut output) open writing))
					(return (call c_literal_text (borrow-shared end_call)
						(borrow-mut output) value writing))))
			(let contract (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(let storage (struct:get contract storage))
			(if
				(:doc "A runtime-only tail owner releases its allocation without a native destructor.")
				(i32:ltz (struct:get contract drop))
				(then
					(let start (call c_literal_text (borrow-shared storage_drop) (borrow-mut output) offset writing))
					(let previous (call write_replacement_slot (borrow-shared nodes) slot (bool true)
						(borrow-mut output) start writing))
					(return (call c_literal_text (borrow-shared end_call) (borrow-mut output) previous writing))))
			(let-mut cursor offset)
			(if
				(:doc "Caller-owned storage checks activation. A pointer owner checks presence.")
				storage
				(then (set cursor (call c_literal_text (borrow-shared storage_guard)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared pointer_guard)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_replacement_slot (borrow-shared nodes) slot (bool true)
				(borrow-mut output) cursor writing))
			(if
				(:doc "The active-storage guard has an additional call to close.")
				storage
				(then (set cursor (call c_literal_text (borrow-shared storage_end)
					(borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared drop_call)
				(borrow-mut output) cursor writing))
			(set cursor (call write_native_destructor (borrow-shared source) (borrow-shared nodes)
				type (borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
			(if
				(:doc "Pass the native object address inside its Wove storage wrapper.")
				storage
				(then (set cursor (call open_storage_address (borrow-shared source) (borrow-shared nodes)
					type (bool false) (borrow-mut output) cursor writing))))
			(set cursor (call write_replacement_slot (borrow-shared nodes) slot (bool true)
				(borrow-mut output) cursor writing))
			(if
				(:doc "Close the native address and destructor call before releasing storage.")
				storage
				(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(set cursor (call c_literal_text (borrow-shared end_call)
				(borrow-mut output) cursor writing))
			(if
				(:doc "Allocated native storage is released even when no destructor ran.")
				storage
				(then
					(set cursor (call c_literal_text (borrow-shared storage_drop)
						(borrow-mut output) cursor writing))
					(set cursor (call write_replacement_slot (borrow-shared nodes) slot (bool true)
						(borrow-mut output) cursor writing))
					(set cursor (call c_literal_text (borrow-shared end_call)
						(borrow-mut output) cursor writing))))
			(return cursor)))

	(fn write_owner_assignment
		(:doc "Capture the original slot once, drop the old owner, and install the already evaluated value.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statement ScalarStatement)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (temporary i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct:get statement type))
			(let target (struct:get statement target))
			(let open (call c_byte (borrow-mut output) offset 123u8 writing))
			(let typed (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) open name_prefix writing))
			(let slot (struct:new ReplacementSlot (row temporary) (name_prefix name_prefix)))
			(let address (call write_replacement_slot (borrow-shared nodes) slot (bool true)
				(borrow-mut output) typed writing))
			(let-mut cursor (call c_literal_text (borrow-shared slot_address)
				(borrow-mut output) address writing))
			(if
				(:doc "A field destination projects the original local or mutable reference.")
				(u32:eq (struct:get statement kind) owner_field_assignment)
				(then (set cursor (call write_field_place (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) target tree_base
					(borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
					target tree_base (borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_literal_text (borrow-shared end_call)
				(borrow-mut output) cursor writing))
			(set cursor (call write_previous_owner_drop (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type slot (borrow-mut output) cursor writing))
			(set cursor (call write_replacement_slot (borrow-shared nodes) slot (bool true)
				(borrow-mut output) cursor writing))
			(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) temporary
				(borrow-mut output) cursor name_prefix writing))
			(return (call c_literal_text (borrow-shared close_block)
				(borrow-mut output) cursor writing))))
)
