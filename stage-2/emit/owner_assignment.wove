(module emit_owner_assignment
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Capture an assignment destination after the replacement value is ready, and retire its previous owner.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement) (value owner_field_assignment)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_owning_record record_index (type ScalarRecord)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "./owned_aggregates.wove" (only open_owner_helper))
	(use wove-file "./records.wove" (only write_field_place write_value_type))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_destructor))
	(use wove-file "./c_storage.wove" (only open_storage_address))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))

	(let slot_address "=&(")
	(let end_call ");")
	(let array_drop "wvrt_array_drop(")
	(let pointer_guard "if(")
	(let storage_guard "if(wvrt_c_storage_active(")
	(let drop_call ")(void)")
	(let storage_end ")")
	(let storage_drop "wvrt_c_storage_free(")
	(let close_block ";}")

	(struct ReplacementSlot (fields (row i32) (tree_base i32) (name_prefix i32)))

	(fn write_replacement_slot
		(:doc "Use the reservation-aware statement temporary with a suffix distinct from the saved value.")
		(params (source (shared-array u8)) (slot ReplacementSlot) (dereference bool)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "The slot temporary is a pointer to the owner value.")
				(local dereference)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 42u8 (local writing)))))
			(let name (call write_temporary_name (borrow-shared (local source))
				(struct.get (local slot) row) (struct.get (local slot) tree_base)
				(borrow-mut (local output)) (local cursor) (struct.get (local slot) name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name) 114u8 (local writing)))))

	(fn write_previous_owner_drop
		(:doc "Retire the captured slot using the exact aggregate, array, or native destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (slot ReplacementSlot) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Aggregate cleanup follows the original slot so partially moved fields remain safe.")
				(call is_owning_record (borrow-shared (local records)) (local type))
				(then
					(let open (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local records) (call record_index (local type))) (bool false)
						(borrow-mut (local output)) (local offset) (struct.get (local slot) name_prefix) (local writing)))
					(let address (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool false)
						(borrow-mut (local output)) (local open) (local writing)))
					(return (call c_literal_text (borrow-shared (local end_call))
						(borrow-mut (local output)) (local address) (local writing)))))
			(if
				(:doc "Array and optional array owners share null-safe descriptor cleanup.")
				(bool.not (call is_native_owner (local type)))
				(then
					(let open (call c_literal_text (borrow-shared (local array_drop)) (borrow-mut (local output))
						(local offset) (local writing)))
					(let value (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool true)
						(borrow-mut (local output)) (local open) (local writing)))
					(return (call c_literal_text (borrow-shared (local end_call))
						(borrow-mut (local output)) (local value) (local writing)))))
			(let storage (struct.get (call native_owner_contract
				(borrow-shared (local source)) (borrow-shared (local nodes)) (local type)) storage))
			(let-mut cursor (local offset))
			(if
				(:doc "Caller-owned storage checks activation. A pointer owner checks presence.")
				(local storage)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local storage_guard))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local pointer_guard))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool true)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "The active-storage guard has an additional call to close.")
				(local storage)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local storage_end))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local drop_call))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_native_destructor (borrow-shared (local source)) (borrow-shared (local nodes))
				(local type) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
			(if
				(:doc "Pass the native object address inside its Wove storage wrapper.")
				(local storage)
				(then (set (local cursor) (call open_storage_address (borrow-shared (local source)) (borrow-shared (local nodes))
					(local type) (bool false) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool true)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Close the native address and destructor call before releasing storage.")
				(local storage)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local end_call))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Allocated native storage is released even when no destructor ran.")
				(local storage)
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local storage_drop))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool true)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local end_call))
						(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (local cursor))))

	(fn write_owner_assignment
		(:doc "Capture the original slot once, drop the old owner, and install the already evaluated value.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statement ScalarStatement)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (temporary i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get (local statement) type))
			(let target (struct.get (local statement) target))
			(let open (call c_byte (borrow-mut (local output)) (local offset) 123u8 (local writing)))
			(let typed (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let slot (struct.new ReplacementSlot (row (local temporary)) (tree_base (local tree_base)) (name_prefix (local name_prefix))))
			(let address (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool true)
				(borrow-mut (local output)) (local typed) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local slot_address))
				(borrow-mut (local output)) (local address) (local writing)))
			(if
				(:doc "A field destination projects the original local or mutable reference.")
				(u32.eq (struct.get (local statement) kind) (local owner_field_assignment))
				(then (set (local cursor) (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local target) (local tree_base)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
				(else (set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
					(local target) (local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local end_call))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_previous_owner_drop (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (local slot) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_replacement_slot (borrow-shared (local source)) (local slot) (bool true)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local temporary) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local close_block))
				(borrow-mut (local output)) (local cursor) (local writing)))))
)
