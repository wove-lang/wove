(module emit_c_formals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit fixed C argument values and check that header constants fit their declared ABI.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/c_formals.wove" (only read_c_fixed_formal find_c_fixed_formal))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "./text.wove" (only c_literal_text))
	(use wove-file "./c_values.wove" (only write_c_value_name write_constant_check))

	(let command_cast "(int32_t)")

	(fn fixed_c_value
		(:doc `Recover the original C identifier of a checked fixed formal.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (row i32))
		(returns SourceNode)
		(body
			(let item (slice.load (local nodes) (local row)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(let checked (call read_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local row) (local parts)))
			(return (slice.load (local nodes) (struct.get (local checked) constant)))))

	(fn write_fixed_c_argument
		(:doc `Pass a header constant using the checked i32 C argument type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (row i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let value (call fixed_c_value (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)))
			(let cast (call c_literal_text (borrow-shared (local command_cast)) (borrow-mut (local output)) (local offset) (local writing)))
			(return (call write_c_value_name (borrow-shared (local source)) (local value)
				(borrow-mut (local output)) (local cast) (local writing)))))

	(fn write_fixed_c_checks
		(:doc `Check the value and sign before narrowing each integer constant to i32.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord)) (first i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut row (call find_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)))
			(let-mut cursor (local offset))
			(while
				(:doc "Check each macro in an integer constant expression before emitting any call.")
				(i32.lt -1i32 (local row))
				(body
					(let value (call fixed_c_value (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)))
					(set (local cursor) (call write_constant_check (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local value) 5u32
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local row) (call find_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (slice.load (local nodes) (local row)) next_sibling)))))
			(return (local cursor))))
)
