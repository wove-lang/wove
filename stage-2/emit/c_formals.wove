(module emit_c_formals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit fixed C argument values and check that header constants fit their declared ABI.`)

	(use wove-file "../c/arguments.wove" (only (value c_static_string_mode)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/c_formals.wove" (only c_fixed_formal_at find_c_fixed_formal (type CFixedFormal)))
	(use wove-file "../source/c_owners.wove" (only c_type_uses_typedef))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge project_bridge))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner native_owner_declaration))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only is_native_long_double is_place_reference place_reference_target (type ScalarRecord)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text))
	(use wove-file "./runtime.wove" (only write_c_number))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_type write_c_pointer_typedef_check))
	(use wove-file "./c_values.wove" (only write_c_value_name write_constant_check))

	(fn native_static_strings
		(:doc "Check whether the native declaration retains any immutable C-string arguments.")
		(params (parameters (shared-array ScalarParameter)) (function ScalarFunction)) (returns bool)
		(body
			(if
				(:doc "A retained literal is counted among static or converted native string arguments.")
				(i32.eqz (struct.get (local function) c_strings))
				(then (return (bool false))))
			(let-mut index (struct.get (local function) params))
			(let end (i32.add (local index) (struct.get (local function) arity)))
			(while
				(:doc "All retained arguments belong to fixed formals.")
				(i32.lt (local index) (local end))
				(body
					(let parameter (array.load (local parameters) (local index)))
					(if
						(:doc "A retained formal requires a complete native prototype check.")
						(u8.eq (struct.get (local parameter) c_mode) (local c_static_string_mode))
						(then (return (bool true))))
					(set (local index) (i32.inc (local index)))))
			(return (bool false))))

	(fn write_fixed_c_type
		(:doc "Use the same fixed type spelling in the prototype check and argument cast.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal CFixedFormal)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let native (struct.get (local formal) native_type))
			(if
				(:doc "Preserve the words and indirection from the validated native type literal.")
				(i32.not-ltz (local native))
				(then (return (call write_native_type (borrow-shared (local source)) (array.load (local nodes) (local native))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_type_text (borrow-mut (local output)) (local offset) 5u32 (local writing)))))

	(fn write_fixed_c_argument
		(:doc "Cast a fixed header name, checked signed literal, or null before the native call.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let formal (call c_fixed_formal_at (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)))
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let type (call write_fixed_c_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local formal)
				(borrow-mut (local output)) (local open) (local writing)))
			(let cast (call c_byte (borrow-mut (local output)) (local type) 41u8 (local writing)))
			(let constant (struct.get (local formal) constant))
			(if
				(:doc "Only header identifiers are copied verbatim into C.")
				(i32.not-ltz (local constant))
				(then (return (call write_c_value_name (borrow-shared (local source)) (array.load (local nodes) (local constant))
					(borrow-mut (local output)) (local cast) (local writing)))))
			(return (call write_c_number (borrow-mut (local output)) (local cast) (struct.get (local formal) value) (local writing)))))

	(fn fixed_c_needs_prototype
		(:doc "Keep existing header-only calls and require a prototype check for a new fixed operand.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns bool)
		(body
			(let-mut row (call find_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)))
			(while
				(:doc "Look for a checked literal, typed pointer-null, or exact native constant.")
				(i32.not-ltz (local row))
				(body
					(let formal (call c_fixed_formal_at (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)))
					(if
						(:doc "A literal or an exact C type needs the full native prototype check.")
						(bool.or (i32.ltz (struct.get (local formal) constant))
							(i32.not-ltz (struct.get (local formal) native_type)))
						(then (return (bool true))))
					(set (local row) (call find_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (array.load (local nodes) (local row)) next_sibling)))))
			(return (bool false))))

	(fn is_cross_header_owner
		(:doc "Compare the defining header namespaces of a checked native owner and its C consumer.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32) (type u32))
		(returns bool)
		(body
			(if (bool.not (call is_native_owner (local type))) (then (return (bool false))))
			(let declaration (array.load (local nodes) (call native_owner_declaration (local type))))
			(let owner (call declaring_c_bridge (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration)))
			(return (i32.not-eq (call project_bridge (borrow-shared (local nodes)) (local owner)) (local bridge)))))

	(fn native_owner_needs_prototype
		(:doc "Check the full native ABI for byte-tail owners and owners from another header.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(parameters (shared-array ScalarParameter)) (function ScalarFunction))
		(returns bool)
		(body
			(if
				(:doc "Only bodyless C functions have a header prototype to check.")
				(bool.or (i32.not-ltz (struct.get (local function) body)) (struct.get (local function) c_macro))
				(then (return (bool false))))
			(let declaration (array.load (local nodes) (struct.get (local function) declaration)))
			(let declared (call declaring_c_bridge (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration)))
			(if (i32.ltz (local declared)) (then (return (bool false))))
			(let bridge (call project_bridge (borrow-shared (local nodes)) (local declared)))
			(if
				(:doc "The exact nominal owner can also cross headers as the return type.")
				(call is_cross_header_owner (borrow-shared (local source)) (borrow-shared (local nodes))
					(local bridge) (struct.get (local function) result))
				(then (return (bool true))))
			(let-mut index (struct.get (local function) params))
			(let end (i32.add (local index) (struct.get (local function) arity)))
			(while
				(:doc "Any ordinary native owner parameter requires the full exact prototype.")
				(i32.lt (local index) (local end))
				(body
					(let param (array.load (local parameters) (local index)))
					(let type (struct.get (local param) type))
					(if
						(:doc "A shared borrow and a direct owning transfer both retain the canonical type.")
						(call is_cross_header_owner (borrow-shared (local source)) (borrow-shared (local nodes))
							(local bridge) (local type))
						(then (return (bool true))))
					(if
						(:doc "A byte-tail contract always checks the exact pointer ABI from its declaring header.")
						(bool.and (call is_native_owner (local type))
							(i32.not-ltz (struct.get (call native_owner_contract (borrow-shared (local source))
								(borrow-shared (local nodes)) (local type)) tail)))
						(then (return (bool true))))
					(set (local index) (i32.inc (local index)))))
			(return (bool false))))

	(fn is_native_long_double_formal
		(:doc "Identify an exact native long double used by value or through a place loan.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body
			(if
				(:doc "A place loan keeps the exact type of the object to which it points.")
				(call is_place_reference (local type))
				(then (return (call is_native_long_double (borrow-shared (local records))
					(call place_reference_target (borrow-shared (local records)) (local type))))))
			(return (call is_native_long_double (borrow-shared (local records)) (local type)))))

	(fn native_long_double_needs_prototype
		(:doc "Verify the native function type whenever a signature depends on the long double ABI.")
		(params (records (shared-array ScalarRecord)) (parameters (shared-array ScalarParameter)) (function ScalarFunction))
		(returns bool)
		(body
			(if
				(:doc "Wove function bodies and C expression macros have no native function prototype.")
				(bool.or (i32.not-ltz (struct.get (local function) body)) (struct.get (local function) c_macro))
				(then (return (bool false))))
			(if
				(:doc "A long double result alone requires an exact check.")
				(call is_native_long_double_formal (borrow-shared (local records)) (struct.get (local function) result))
				(then (return (bool true))))
			(let-mut index (struct.get (local function) params))
			(let end (i32.add (local index) (struct.get (local function) arity)))
			(while
				(:doc "An exact parameter must agree with the selected C declaration.")
				(i32.lt (local index) (local end))
				(body
					(let parameter (array.load (local parameters) (local index)))
					(if
						(:doc "One long double formal makes precision and calling convention part of the prototype.")
						(call is_native_long_double_formal (borrow-shared (local records)) (struct.get (local parameter) type))
						(then (return (bool true))))
					(set (local index) (i32.inc (local index)))))
			(return (bool false))))

	(let pointer_check_open "_Static_assert(__builtin_classify_type(")
	(let pointer_check_combine ")==5&&_Generic(1?(")
	(let pointer_check_zero ")0:")
	(let pointer_check_close ":1,default:0),\"Wove C fixed pointer operand must match its declared type\");\n")

	(fn write_fixed_pointer_check
		(:doc "Require a native pointer expression that converts to the declared type without discarding qualifiers.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal CFixedFormal)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let constant (array.load (local nodes) (struct.get (local formal) constant)))
			(let open (call c_literal_text (borrow-shared (local pointer_check_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let value (call write_c_value_name (borrow-shared (local source)) (local constant)
				(borrow-mut (local output)) (local open) (local writing)))
			(let combine (call c_literal_text (borrow-shared (local pointer_check_combine))
				(borrow-mut (local output)) (local value) (local writing)))
			(let cast (call write_fixed_c_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local formal)
				(borrow-mut (local output)) (local combine) (local writing)))
			(let zero (call c_literal_text (borrow-shared (local pointer_check_zero))
				(borrow-mut (local output)) (local cast) (local writing)))
			(let candidate (call write_c_value_name (borrow-shared (local source)) (local constant)
				(borrow-mut (local output)) (local zero) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local candidate) 44u8 (local writing)))
			(let expected (call write_fixed_c_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local formal)
				(borrow-mut (local output)) (local comma) (local writing)))
			(return (call c_literal_text (borrow-shared (local pointer_check_close))
				(borrow-mut (local output)) (local expected) (local writing)))))

	(fn write_fixed_c_checks
		(:doc `Check integer constant ranges and verify any hidden pointer typedef against its header.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (first i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut row (call find_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)))
			(let-mut cursor (local offset))
			(while
				(:doc "Check each fixed operand that relies on a native header definition.")
				(i32.lt -1i32 (local row))
				(body
					(let formal (call c_fixed_formal_at (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)))
					(let constant (struct.get (local formal) constant))
					(let native (struct.get (local formal) native_type))
					(if
						(:doc "The fixed value is null. Only the header can confirm a typedef is a pointer.")
						(bool.and (bool.and (i32.ltz (local constant)) (i32.not-ltz (local native)))
							(call c_type_uses_typedef (borrow-shared (local source)) (array.load (local nodes) (local native))))
						(then (set (local cursor) (call write_c_pointer_typedef_check (borrow-shared (local source))
							(array.load (local nodes) (local native)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(if
						(:doc "The native header must supply the checked constant's integer or pointer representation.")
						(i32.not-ltz (local constant))
						(then
							(if
								(:doc "A pointer operand uses compatibility rules instead of integer range checks.")
								(struct.get (local formal) pointer)
								(then (set (local cursor) (call write_fixed_pointer_check
									(borrow-shared (local source)) (borrow-shared (local nodes)) (local formal)
									(borrow-mut (local output)) (local cursor) (local writing))))
								(else (set (local cursor) (call write_constant_check (borrow-shared (local source)) (borrow-shared (local nodes))
									(borrow-shared (local records)) (array.load (local nodes) (local constant)) 5u32 (local native)
									(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))))
					(set (local row) (call find_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (array.load (local nodes) (local row)) next_sibling)))))
			(return (local cursor))))
)
