(module emit_c_formals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit fixed C argument values and check that header constants fit their declared ABI.`)

	(use wove-file "../c/arguments.wove" (only (value c_static_string_mode) (value c_string_offset_mode) (value c_sync_callback_mode)
		(value c_nullable_sync_callback_mode) (value c_nullable_native_reference_mode) (value c_nullable_storage_shared_mode)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/c_formals.wove" (only c_fixed_formal_at find_c_fixed_formal (type CFixedFormal)))
	(use wove-file "../source/c_owners.wove" (only c_type_uses_typedef))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge project_bridge))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner native_owner_declaration))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only is_native_long_double is_native_record is_record_type record_index is_place_reference place_reference_target (type ScalarRecord)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text))
	(use wove-file "./runtime.wove" (only write_c_number))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_type write_c_pointer_typedef_check))
	(use wove-file "./c_values.wove" (only write_c_value_name write_constant_check))

	(fn native_uses_argument_mode
		(:doc "Find a native formal with the requested call contract.")
		(params (parameters (shared-array ScalarParameter)) (function ScalarFunction) (mode u8)) (returns bool)
		(body
			(if
				(:doc "A Wove definition uses its own calling convention.")
				(i32.not-ltz (struct.get function body))
				(then (return (bool false))))
			(let-mut index (struct.get function params))
			(let end (i32.add index (struct.get function arity)))
			(while
				(:doc "Inspect the selected declaration's fixed formals in order.")
				(i32.lt index end)
				(body
					(let parameter (array.load parameters index))
					(if (u8.eq (struct.get parameter c_mode) mode) (then (return (bool true))))
					(set index (i32.inc index))))
			(return (bool false))))

	(fn native_nullable_needs_prototype
		(:doc "Require exact C pointer types for nullable references and shared storage loans.")
		(params (parameters (shared-array ScalarParameter)) (function ScalarFunction)) (returns bool)
		(body
			(return (bool.or (call native_uses_argument_mode (borrow-shared parameters) function c_nullable_native_reference_mode)
				(call native_uses_argument_mode (borrow-shared parameters) function c_nullable_storage_shared_mode)))))

	(fn native_sync_callbacks
		(:doc "Require complete prototype checking for synchronous callbacks, including nullable slots.")
		(params (parameters (shared-array ScalarParameter)) (function ScalarFunction)) (returns bool)
		(body
			(return (bool.or (call native_uses_argument_mode (borrow-shared parameters) function c_sync_callback_mode)
				(call native_uses_argument_mode (borrow-shared parameters) function c_nullable_sync_callback_mode)))))

	(fn native_c_string_offsets
		(:doc "Check whether the native declaration projects a call-scoped string end pointer.")
		(params (parameters (shared-array ScalarParameter)) (function ScalarFunction)) (returns bool)
		(body
			(return (bool.and (i32.gtz (struct.get function c_strings))
				(call native_uses_argument_mode (borrow-shared parameters) function c_string_offset_mode)))))

	(fn native_static_strings
		(:doc "Check whether the native declaration retains any immutable C-string arguments.")
		(params (parameters (shared-array ScalarParameter)) (function ScalarFunction)) (returns bool)
		(body
			(return (bool.and (i32.gtz (struct.get function c_strings))
				(call native_uses_argument_mode (borrow-shared parameters) function c_static_string_mode)))))

	(fn write_fixed_c_type
		(:doc "Use the same fixed type spelling in the prototype check and argument cast.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal CFixedFormal)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let native (struct.get formal native_type))
			(if
				(:doc "Preserve the words and indirection from the validated native type literal.")
				(i32.not-ltz native)
				(then (return (call write_native_type (borrow-shared source) (array.load nodes native)
					(borrow-mut output) offset writing))))
			(return (call c_type_text (borrow-mut output) offset 5u32 writing))))

	(fn write_fixed_c_argument
		(:doc "Cast a fixed header name, checked signed literal, or null before the native call.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let formal (call c_fixed_formal_at (borrow-shared source) (borrow-shared nodes) row))
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let type (call write_fixed_c_type (borrow-shared source) (borrow-shared nodes) formal
				(borrow-mut output) open writing))
			(let cast (call c_byte (borrow-mut output) type 41u8 writing))
			(let constant (struct.get formal constant))
			(if
				(:doc "Only header identifiers are copied verbatim into C.")
				(i32.not-ltz constant)
				(then (return (call write_c_value_name (borrow-shared source) (array.load nodes constant)
					(borrow-mut output) cast writing))))
			(return (call write_c_number (borrow-mut output) cast (struct.get formal value) writing))))

	(fn fixed_c_needs_prototype
		(:doc "Keep existing header-only calls and require a prototype check for a new fixed operand.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns bool)
		(body
			(let-mut row (call find_c_fixed_formal (borrow-shared source) (borrow-shared nodes) first))
			(while
				(:doc "Look for a checked literal, typed pointer-null, or exact native constant.")
				(i32.not-ltz row)
				(body
					(let formal (call c_fixed_formal_at (borrow-shared source) (borrow-shared nodes) row))
					(if
						(:doc "A literal or an exact C type needs the full native prototype check.")
						(bool.or (i32.ltz (struct.get formal constant))
							(i32.not-ltz (struct.get formal native_type)))
						(then (return (bool true))))
					(set row (call find_c_fixed_formal (borrow-shared source) (borrow-shared nodes)
						(struct.get (array.load nodes row) next_sibling)))))
			(return (bool false))))

	(fn is_cross_header_owner
		(:doc "Compare the defining header namespaces of a checked native owner and its C consumer.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32) (type u32))
		(returns bool)
		(body
			(if (bool.not (call is_native_owner type)) (then (return (bool false))))
			(let declaration (array.load nodes (call native_owner_declaration type)))
			(let owner (call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) declaration))
			(return (i32.not-eq (call project_bridge (borrow-shared nodes) owner) bridge))))

	(fn native_owner_needs_prototype
		(:doc "Check the full native ABI for byte-tail owners and owners from another header.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(parameters (shared-array ScalarParameter)) (function ScalarFunction))
		(returns bool)
		(body
			(if
				(:doc "Only bodyless C functions have a header prototype to check.")
				(bool.or (i32.not-ltz (struct.get function body)) (struct.get function c_macro))
				(then (return (bool false))))
			(let declaration (array.load nodes (struct.get function declaration)))
			(let declared (call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) declaration))
			(if (i32.ltz declared) (then (return (bool false))))
			(let bridge (call project_bridge (borrow-shared nodes) declared))
			(if
				(:doc "The exact nominal owner can also cross headers as the return type.")
				(call is_cross_header_owner (borrow-shared source) (borrow-shared nodes)
					bridge (struct.get function result))
				(then (return (bool true))))
			(let-mut index (struct.get function params))
			(let end (i32.add index (struct.get function arity)))
			(while
				(:doc "Any ordinary native owner parameter requires the full exact prototype.")
				(i32.lt index end)
				(body
					(let param (array.load parameters index))
					(let type (struct.get param type))
					(if
						(:doc "A shared borrow and a direct owning transfer both retain the canonical type.")
						(call is_cross_header_owner (borrow-shared source) (borrow-shared nodes)
							bridge type)
						(then (return (bool true))))
					(if
						(:doc "A byte-tail contract always checks the exact pointer ABI from its declaring header.")
						(bool.and (call is_native_owner type)
							(i32.not-ltz (struct.get (call native_owner_contract (borrow-shared source)
								(borrow-shared nodes) type) tail)))
						(then (return (bool true))))
					(set index (i32.inc index))))
			(return (bool false))))

	(fn is_native_long_double_formal
		(:doc "Identify an exact native long double used by value or through a place loan.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body
			(if
				(:doc "A place loan keeps the exact type of the object to which it points.")
				(call is_place_reference type)
				(then (return (call is_native_long_double (borrow-shared records)
					(call place_reference_target (borrow-shared records) type)))))
			(return (call is_native_long_double (borrow-shared records) type))))

	(fn native_record_result_needs_prototype
		(:doc "A by-value native record result requires the header's exact function type.")
		(params (records (shared-array ScalarRecord)) (function ScalarFunction)) (returns bool)
		(body
			(let result (struct.get function result))
			(return (bool.and (i32.ltz (struct.get function body))
				(bool.and (call is_record_type result)
					(call is_native_record (array.load records (call record_index result))))))))

	(fn native_long_double_needs_prototype
		(:doc "Verify the native function type whenever a signature depends on the long double ABI.")
		(params (records (shared-array ScalarRecord)) (parameters (shared-array ScalarParameter)) (function ScalarFunction))
		(returns bool)
		(body
			(if
				(:doc "Wove function bodies and C expression macros have no native function prototype.")
				(bool.or (i32.not-ltz (struct.get function body)) (struct.get function c_macro))
				(then (return (bool false))))
			(if
				(:doc "A long double result alone requires an exact check.")
				(call is_native_long_double_formal (borrow-shared records) (struct.get function result))
				(then (return (bool true))))
			(let-mut index (struct.get function params))
			(let end (i32.add index (struct.get function arity)))
			(while
				(:doc "An exact parameter must agree with the selected C declaration.")
				(i32.lt index end)
				(body
					(let parameter (array.load parameters index))
					(if
						(:doc "One long double formal makes precision and calling convention part of the prototype.")
						(call is_native_long_double_formal (borrow-shared records) (struct.get parameter type))
						(then (return (bool true))))
					(set index (i32.inc index))))
			(return (bool false))))

	(let pointer_check_open "_Static_assert(__builtin_classify_type(")
	(let pointer_check_combine ")==5&&_Generic(1?(")
	(let pointer_check_zero ")0:")
	(let pointer_check_close ":1,default:0),\"Wove C fixed pointer operand must match its declared type\");\n")

	(fn write_fixed_pointer_check
		(:doc "Require a native pointer expression that converts to the declared type without discarding qualifiers.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal CFixedFormal)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let constant (array.load nodes (struct.get formal constant)))
			(let open (call c_literal_text (borrow-shared pointer_check_open)
				(borrow-mut output) offset writing))
			(let value (call write_c_value_name (borrow-shared source) constant
				(borrow-mut output) open writing))
			(let combine (call c_literal_text (borrow-shared pointer_check_combine)
				(borrow-mut output) value writing))
			(let cast (call write_fixed_c_type (borrow-shared source) (borrow-shared nodes) formal
				(borrow-mut output) combine writing))
			(let zero (call c_literal_text (borrow-shared pointer_check_zero)
				(borrow-mut output) cast writing))
			(let candidate (call write_c_value_name (borrow-shared source) constant
				(borrow-mut output) zero writing))
			(let comma (call c_byte (borrow-mut output) candidate 44u8 writing))
			(let expected (call write_fixed_c_type (borrow-shared source) (borrow-shared nodes) formal
				(borrow-mut output) comma writing))
			(return (call c_literal_text (borrow-shared pointer_check_close)
				(borrow-mut output) expected writing))))

	(fn write_fixed_c_checks
		(:doc `Check integer constant ranges and verify any hidden pointer typedef against its header.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (first i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut row (call find_c_fixed_formal (borrow-shared source) (borrow-shared nodes) first))
			(let-mut cursor offset)
			(while
				(:doc "Check each fixed operand that relies on a native header definition.")
				(i32.lt -1i32 row)
				(body
					(let formal (call c_fixed_formal_at (borrow-shared source) (borrow-shared nodes) row))
					(let constant (struct.get formal constant))
					(let native (struct.get formal native_type))
					(if
						(:doc "The fixed value is null. Only the header can confirm a typedef is a pointer.")
						(bool.and (bool.and (i32.ltz constant) (i32.not-ltz native))
							(call c_type_uses_typedef (borrow-shared source) (array.load nodes native)))
						(then (set cursor (call write_c_pointer_typedef_check (borrow-shared source)
							(array.load nodes native) (borrow-mut output) cursor writing))))
					(if
						(:doc "The native header must supply the checked constant's integer or pointer representation.")
						(i32.not-ltz constant)
						(then
							(if
								(:doc "A pointer operand uses compatibility rules instead of integer range checks.")
								(struct.get formal pointer)
								(then (set cursor (call write_fixed_pointer_check
									(borrow-shared source) (borrow-shared nodes) formal
									(borrow-mut output) cursor writing)))
								(else (set cursor (call write_constant_check (borrow-shared source) (borrow-shared nodes)
									(borrow-shared records) (array.load nodes constant) 5u32 native
									(borrow-mut output) cursor name_prefix writing))))))
					(set row (call find_c_fixed_formal (borrow-shared source) (borrow-shared nodes)
						(struct.get (array.load nodes row) next_sibling)))))
			(return cursor)))
)
