(module c_local_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Prepare each checked function’s binding, temporary and loop-label names before C emission.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/generics.wove" (only hash_generic_word))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_byte))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction)))
	(use wove-file "../scalar/generics/workspace.wove" (only subtree_limit))
	(use wove-file "../scalar/flow.wove" (only is_loop (type ScalarStatement) (value for_binding) (value for_mut_binding)
		(value case_payload_binding) (value case_discard_binding)))
	(use wove-file "../scalar/plan.wove" (only (value owned_parameter_binding)))
	(use wove-file "../scalar/syntax.wove" (only (value let_binding)))
	(use wove-file "./names.wove" (only hash_spelling (value local_role) (value temporary_role) (value loop_label_role)))
	(use wove-file "./collisions.wove" (only base_candidate bucket link_candidate same_suffix (type Bucket) (type Candidate)))

	(let temporary_candidate 1u32)
	(let label_candidate 2u32)

	(fn defines_break_label
		(:doc "A checked loop has a C label when at least one written break targets it.")
		(params (statement ScalarStatement)) (returns bool)
		(body (return (bool:and (call is_loop (statement.get kind))
			(i32:not-ltz (statement.get target))))))

	(fn is_let_binding
		(:doc "Identify immutable and mutable local declaration statements.")
		(params (kind u32)) (returns bool)
		(body (return (bool:or (u32:eq kind let_binding) (u32:eq kind 16u32)))))

	(fn defines_local_slot
		(:doc "Include each checked local, pattern, and transferred formal, plus the hidden case discard in the same C namespace.")
		(params (kind u32)) (returns bool)
		(body (return (bool:or (call is_let_binding kind)
			(bool:or (u32:eq kind for_binding) (bool:or (u32:eq kind for_mut_binding)
				(bool:or (u32:eq kind case_payload_binding) (bool:or (u32:eq kind case_discard_binding)
					(u32:eq kind owned_parameter_binding)))))))))

	(fn local_candidate
		(:doc "Retain the defining name row and hash the function-relative lexical scope and declaration before its spelling.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(row i32) (statement ScalarStatement) (parent u32)) (returns Candidate)
		(body
			(let name (statement.get target))
			(let node (nodes.get name))
			(let kind (statement.get kind))
			(if
				(:doc "A synthetic case discard keeps its existing ordinal unless another complete C spelling conflicts.")
				(u32:eq kind case_discard_binding)
				(then (return (call base_candidate node name 0u32
					(u32:from-i32 (i32:sub name (function.get name_base)))))))
			(let-mut scope (statement.get first))
			(if
				(:doc "Let statements get their lexical scope from the containing source block.")
				(call is_let_binding kind)
				(then (set scope (struct:get (nodes.get row) parent))))
			(let declaration (function.get declaration))
			(let scope_key (call hash_generic_word parent (u32:from-i32 (i32:sub scope declaration))))
			(let binding_key (call hash_generic_word scope_key (u32:from-i32 (i32:sub name declaration))))
			(return (call base_candidate node name 0u32 (call hash_spelling (borrow-shared source)
				(node.get start) (node.get end) binding_key)))))

	(fn local_slot
		(:doc "Rank equal complete spellings by their exact defining rows within this function.")
		(params (source (shared-array u8)) (candidates (shared-array Candidate)) (row i32) (head i32)) (returns i32)
		(body
			(let name (candidates.get row))
			(let-mut cursor head)
			(let-mut collides (bool false))
			(let-mut slot 1i32)
			(while
				(:doc "A bucket's fingerprint is only a filter. Keep distinct spelling and binding keys separate.")
				(i32:gtz cursor)
				(body
					(let other (candidates.get (i32:dec cursor)))
					(if
						(:doc "Two different defining rows conflict only when their base C names agree.")
						(bool:and (i32:not-eq (other.get name) (name.get name))
							(bool:and (u32:eq (other.get role) (name.get role))
								(bool:and (u32:eq (other.get fingerprint) (name.get fingerprint))
									(call same_suffix (borrow-shared source) name other))))
						(then
							(set collides (bool true))
							(if (i32:lt (other.get name) (name.get name))
								(then (set slot (i32:inc slot))))))
					(set cursor (other.get next))))
			(if collides (then (return slot)))
			(return 0i32)))

	(fn unnamed_candidate
		(:doc "Retain the exact defining row and hash its function-relative index without a spelling suffix.")
		(params (parent u32) (first i32) (row i32) (role u32)) (returns Candidate)
		(body (return (struct:new Candidate (role role) (name row) (start 0i32) (end 0i32) (next 0i32)
			(fingerprint (call hash_generic_word parent (u32:from-i32 (i32:sub row first))))))))

	(fn with_cached_name
		(:doc "Attach one resolved spelling while preserving the other roles and the checked source row.")
		(params (node SourceNode) (candidate Candidate) (slot i32)) (returns SourceNode)
		(body
			(let identity (candidate.get fingerprint))
			(let role (candidate.get role))
			(let-mut expression_identity (node.get expression_identity))
			(let-mut expression_slot (node.get expression_slot))
			(let-mut label_identity (node.get label_identity))
			(let-mut label_slot (node.get label_slot))
			(let-mut local_identity (node.get local_identity))
			(let-mut local_slot (node.get local_name_slot))
			(if
				(:doc "A named binding uses the same source atom as every reference.")
				(u32:eqz role)
				(then
					(set local_identity identity)
					(set local_slot slot))
				(else
					(if
						(:doc "A capture and a label may share a source row in distinct C namespaces.")
						(u32:eq role temporary_candidate)
						(then
							(set expression_identity identity)
							(set expression_slot slot))
						(else
							(set label_identity identity)
							(set label_slot slot)))))
			(return (struct:new SourceNode
				(kind (node.get kind)) (start (node.get start)) (end (node.get end))
				(parent (node.get parent)) (first_child (node.get first_child))
				(next_sibling (node.get next_sibling)) (bridge_project (node.get bridge_project))
				(bridge_default (node.get bridge_default)) (generic_kind (node.get generic_kind))
				(generic_value (node.get generic_value)) (local_identity local_identity) (local_name_slot local_slot)
				(expression_identity expression_identity) (expression_slot expression_slot)
				(label_identity label_identity) (label_slot label_slot)))))

	(fn assign_function_locals
		(:doc "Index one concrete function's names together and cache them before either C emission pass.")
		(params (source (shared-array u8)) (nodes (mut-array SourceNode)) (statements (shared-array ScalarStatement))
			(function ScalarFunction)) (returns void)
		(body
			(let first (function.get declaration))
			(let body_start (function.get body))
			(let limit (call subtree_limit (borrow-shared nodes) first (function.get tree_limit)))
			(let-mut row first)
			(let-mut count (i32:sub limit body_start))
			(while
				(:doc "Count binding and label keys alongside the body rows reserved for temporaries.")
				(i32:lt row limit)
				(body
					(let statement (statements.get row))
					(if (call defines_local_slot (statement.get kind)) (then (set count (i32:inc count))))
					(if (call defines_break_label statement) (then (set count (i32:inc count))))
					(set row (i32:inc row))))
			(let-mut width 1i32)
			(while
				(:doc "Keep the bucket table a power of two and its size within i32.")
				(bool:and (i32:lt width count) (i32:lt width 536870912i32))
				(body (set width (i32:add width width))))
			(let-mut buckets (array:alloc Bucket width))
			(let-mut candidates (array:alloc Candidate count))
			(let function_key (function.get identity))
			(let local_parent (call fnv1a_byte function_key local_role))
			(let temporary_parent (call fnv1a_byte function_key temporary_role))
			(let label_parent (call fnv1a_byte function_key loop_label_role))
			(let-mut index 0i32)
			(set row first)
			(while
				(:doc "Reuse the binding scan for unnamed rows. Lowering can need a form, block, or atom as a capture anchor.")
				(i32:lt row limit)
				(body
					(let statement (statements.get row))
					(if
						(:doc "Register the checked binding even when several emission paths reference it.")
						(call defines_local_slot (statement.get kind))
						(then
							(let candidate (call local_candidate (borrow-shared source) (borrow-shared nodes)
								function row statement local_parent))
							(call link_candidate (borrow-mut buckets) (borrow-mut candidates) index candidate)
							(set index (i32:inc index))))
					(if
						(:doc "The concrete declaration's relative rows survive cloning and graph packing.")
						(i32:not-lt row body_start)
						(then
							(call link_candidate (borrow-mut buckets) (borrow-mut candidates) index
								(call unnamed_candidate temporary_parent first row temporary_candidate))
							(set index (i32:inc index))))
					(if
						(:doc "Only loops with a break enter the label namespace.")
						(call defines_break_label statement)
						(then
							(call link_candidate (borrow-mut buckets) (borrow-mut candidates) index
								(call unnamed_candidate label_parent first row label_candidate))
							(set index (i32:inc index))))
					(set row (i32:inc row))))
			(set index 0i32)
			(while
				(:doc "Write the resolved spelling back to its defining name, capture anchor, or loop statement.")
				(i32:lt index count)
				(body
					(let candidate (candidates.get index))
					(let row (candidate.get name))
					(let identity (candidate.get fingerprint))
					(let head (struct:get (buckets.get (call bucket identity width)) head))
					(let slot (call local_slot (borrow-shared source) (borrow-shared candidates) index head))
					(nodes.set row (call with_cached_name (nodes.get row) candidate slot))
					(set index (i32:inc index))))))

	(fn assign_local_c_names
		(:doc "Resolve local C spellings once per checked function or specialization for both output passes.")
		(params (source (shared-array u8)) (nodes (mut-array SourceNode)) (functions (shared-array ScalarFunction))
			(statements (shared-array ScalarStatement))) (returns void)
		(body
			(let count (call checked_function_count (borrow-shared functions)))
			(let-mut index 0i32)
			(while
				(:doc "Each selected Wove body forms a separate C namespace.")
				(i32:lt index count)
				(body
					(let function (functions.get index))
					(if
						(:doc "Native signatures have no generated binding declarations.")
						(i32:not-ltz (function.get body))
						(then (call assign_function_locals (borrow-shared source) (borrow-mut nodes)
							(borrow-shared statements) function)))
					(set index (i32:inc index)))))))
