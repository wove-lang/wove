(module emit_integers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write integer values, arithmetic, and bit counts in C.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/generics.wove" (only (value normalized_i32_literal)))
	(use wove-file "../source/literals.wove" (only read_integer_magnitude))
	(use wove-file "../hashing/base16.wove" (only (value base16_alphabet)))
	(use wove-file "../source/types.wove" (only is_128bit_integer is_256bit_integer (value i64_type) (value i128_type) (value u128_type)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./runtime.wove" (only write_word_width close_runtime_call write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text c_cast c_hex_byte write_temporary_name))

	(let hex_prefix "0x")
	(let signed_hex_suffix "ll")
	(let unsigned_wide_suffix "ull")
	(let i16_wrap_open "(int16_t)((int32_t)(uint16_t)(32768u+(uint32_t)")
	(let i16_wrap_close ")-32768)")
	(let u16_wrap_open "(uint16_t)((uint32_t)")
	(let unsigned_operand "(uint32_t)")
	(let i64_wrap_open "wvrt_i64_from_wrapped_bits((uint64_t)")
	(let u64_operand "(uint64_t)")
	(let i64_constant "INT64_C(")
	(let u128_constant "WVRT_U128_C(")
	(let i128_constant "WVRT_I128_C(")
	(let negative_i128_constant "WVRT_I128_NEG_C(")
	(let negative_i64_open "(-INT64_C(1)-(int64_t)(")
	(let negative_i64_close "ull-1ull))")

	(let wrapping_open "wvrt_int_wrapping(")
	(let checked_open "wvrt_int_checked(")
	(let add_builtin "__builtin_add_overflow,")
	(let sub_builtin "__builtin_sub_overflow,")
	(let mul_builtin "__builtin_mul_overflow,")

	(fn write_integer_arithmetic
		(:doc "Call an exact-result overflow builtin using captured operands or an implicit one for a unary step.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(symbol u8) (checked bool) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Only a trapping operation needs its source location.")
				(local checked)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local checked_open))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local wrapping_open))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Select the builtin that corresponds to the checked arithmetic opcode.")
				(u8.eq (local symbol) 43u8)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local add_builtin))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(if
						(:doc "Subtraction and multiplication use their exact-result builtins.")
						(u8.eq (local symbol) 45u8)
						(then (set (local cursor) (call c_literal_text (borrow-shared (local sub_builtin))
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call c_literal_text (borrow-shared (local mul_builtin))
							(borrow-mut (local output)) (local cursor) (local writing)))))))
			(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor)
				(struct.get (local expression) type) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(let left (struct.get (local expression) first))
			(let right (struct.get (array.load (local nodes) (local left)) next_sibling))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local left)
				(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(if
				(:doc "A unary step has no second source operand to capture.")
				(i32.ltz (local right))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 49u8 (local writing))))
				(else (set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local right)
					(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(if
				(:doc "Report overflow at the original file and operation head.")
				(local checked)
				(then (return (call close_runtime_call (borrow-mut (local output)) (local cursor)
					(struct.get (local expression) target) (struct.get (local expression) start)
					(struct.get (local expression) end) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))

	(fn write_i64_wrapping
		(:doc `Perform the operation on unsigned bits and recover the corresponding signed word.`)
		(params (source (shared-array u8)) (first i32) (second i32) (tree_base i32) (symbol u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local i64_wrap_open))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let left (call write_temporary_name (borrow-shared (local source)) (local first)
				(local tree_base) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let operator (call c_byte (borrow-mut (local output)) (local left) (local symbol) (local writing)))
			(let cast (call c_literal_text (borrow-shared (local u64_operand))
				(borrow-mut (local output)) (local operator) (local writing)))
			(let right (call write_temporary_name (borrow-shared (local source)) (local second)
				(local tree_base) (borrow-mut (local output)) (local cast) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local right) 41u8 (local writing)))))

	(fn write_16bit_wrapping
		(:doc `Wrap captured operands modulo 2^16 using unsigned C arithmetic.

		Signed results use a bias before reducing to 16 bits. Subtracting it
		in i32 keeps the final int16_t cast in its representable range.`)
		(params (source (shared-array u8)) (first i32) (second i32) (tree_base i32) (symbol u8) (signed bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Only the signed path needs the bias before reduction.")
				(local signed)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local i16_wrap_open))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local u16_wrap_open))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local symbol) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local unsigned_operand))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local second) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Unbias only after the wrapped value fits in uint16_t.")
				(local signed)
				(then (return (call c_literal_text (borrow-shared (local i16_wrap_close))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))

	(fn write_source_digits
		(:doc "Copy checked integer digits without Wove separators.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut index (local start))
			(let-mut cursor (local offset))
			(while
				(:doc "Keep each significant digit in its original order and case.")
				(i32.lt (local index) (local end))
				(body
					(let byte (array.load (local source) (local index)))
					(if
						(:doc "C integer tokens do not use Wove’s underscore separator.")
						(u8.not-eq (local byte) 95u8)
						(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local byte) (local writing)))))
					(set (local index) (i32.inc (local index)))))
			(return (local cursor))))

	(fn write_hex_word
		(:doc "Write a word as hexadecimal, padding it to eight digits when it follows a higher word.")
		(params (word u32) (padded bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut shift 28i32)
			(let-mut started (local padded))
			(while
				(:doc "Visit nibbles from the most significant to the least significant.")
				(i32.lt -1i32 (local shift))
				(body
					(let digit (i32.from-u32 (u32.and (u32.shr (local word) (local shift)) 15u32)))
					(if
						(:doc "Suppress leading zeroes while retaining one digit for zero.")
						(bool.or (local started) (bool.or (i32.gtz (local digit)) (i32.eqz (local shift))))
						(then
							(set (local started) (bool true))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor)
								(array.load (local base16_alphabet) (local digit)) (local writing)))))
					(set (local shift) (i32.sub (local shift) 4i32))))
			(return (local cursor))))

	(fn write_binary_digits
		(:doc "Use a portable hexadecimal C magnitude for a checked binary value.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared (local source)) (local start) (local end) 2i32 (bool false)))
			(let high (struct.get (local magnitude) high))
			(let-mut cursor (local offset))
			(let wide (u32.gtz (local high)))
			(if
				(:doc "Only the high word may drop leading zeroes when both words are present.")
				(local wide)
				(then (set (local cursor) (call write_hex_word (local high) (bool false)
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call write_hex_word (struct.get (local magnitude) low) (local wide)
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_hex_half
		(:doc "Emit a portable unsigned 64-bit constant for one half of a wide value.")
		(params (high u32) (low u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local hex_prefix))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let padded (u32.gtz (local high)))
			(if
				(:doc "The low word contributes all eight places when a high word precedes it.")
				(local padded)
				(then (set (local cursor) (call write_hex_word (local high) (bool false)
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(let digits (call write_hex_word (local low) (local padded) (borrow-mut (local output)) (local cursor) (local writing)))
			(return (call c_literal_text (borrow-shared (local unsigned_wide_suffix))
				(borrow-mut (local output)) (local digits) (local writing)))))

	(fn write_128bit_literal
		(:doc "Write both checked halves into a C constant expression, including the signed minimum.")
		(params (source (shared-array u8)) (row ScalarExpression) (radix i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared (local source))
				(struct.get (local row) start) (struct.get (local row) end) (local radix) (bool true)))
			(let-mut cursor (local offset))
			(if
				(:doc "Signed negative inputs need the in-range negation formula from the runtime header.")
				(u32.eq (struct.get (local row) type) (local i128_type))
				(then
					(if
						(:doc "A checked zero never carries the negative flag.")
						(struct.get (local row) negative)
						(then (set (local cursor) (call c_literal_text (borrow-shared (local negative_i128_constant))
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call c_literal_text (borrow-shared (local i128_constant))
							(borrow-mut (local output)) (local cursor) (local writing))))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local u128_constant))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(let high (call write_hex_half (struct.get (local magnitude) highest) (struct.get (local magnitude) upper)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local high) 44u8 (local writing)))
			(let low (call write_hex_half (struct.get (local magnitude) high) (struct.get (local magnitude) low)
				(borrow-mut (local output)) (local comma) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local low) 41u8 (local writing)))))

	(let bitint_binary_prefix "0b")
	(let bitint_positive_close "uwb)")
	(let bitint_negative_close "uwb-1uwb)-1)")

	(fn write_256bit_literal
		(:doc "Give the normalized C23 token the checked width, using only representable signed intermediates.")
		(params (source (shared-array u8)) (row ScalarExpression) (radix i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let negative (struct.get (local row) negative))
			(let-mut cursor (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(if
				(:doc "For a negative value, cast magnitude minus one before negating, including at the signed minimum.")
				(local negative)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 45u8 (local writing)))))
			(set (local cursor) (call c_cast (borrow-mut (local output)) (local cursor)
				(struct.get (local row) type) (local writing)))
			(if (local negative) (then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))
			(if
				(:doc "C23 supports the checked radix and its original exact digits.")
				(i32.eq (local radix) 16i32)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local hex_prefix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Binary tokens retain their radix without accumulating through a narrower compiler type.")
				(i32.eq (local radix) 2i32)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local bitint_binary_prefix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(let end (call write_source_digits (borrow-shared (local source))
				(struct.get (local row) start) (struct.get (local row) end)
				(borrow-mut (local output)) (local cursor) (local writing)))
			(if
				(:doc "Finish the exact signed minimum without casting its positive magnitude to a signed type.")
				(local negative)
				(then (return (call c_literal_text (borrow-shared (local bitint_negative_close))
					(borrow-mut (local output)) (local end) (local writing)))))
			(return (call c_literal_text (borrow-shared (local bitint_positive_close))
				(borrow-mut (local output)) (local end) (local writing)))))

	(fn write_integer_literal
		(:doc "Emit the normalized magnitude or decoded character with a C-safe sign and suffix.")
		(params (source (shared-array u8)) (row ScalarExpression) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let format (struct.get (local row) target))
			(if
				(:doc "A concrete generic constant already carries an exact signed numeric value.")
				(i32.eq (local format) (local normalized_i32_literal))
				(then (return (call write_c_number (borrow-mut (local output)) (local offset)
					(struct.get (local row) start) (local writing)))))
			(if
				(:doc "A nonnegative target is the decoded character byte, independent of the C execution encoding.")
				(i32.lt -1i32 (local format))
				(then
					(let prefix (call c_literal_text (borrow-shared (local hex_prefix))
						(borrow-mut (local output)) (local offset) (local writing)))
					(return (call c_hex_byte (u8.from-i32 (local format)) (borrow-mut (local output)) (local prefix) (local writing)))))
			(let radix (i32.sub 0i32 (local format)))
			(let hexadecimal (i32.not-eq (local radix) 10i32))
			(let negative (struct.get (local row) negative))
			(let type (struct.get (local row) type))
			(if
				(:doc "The optional C23 scalar has a dedicated exact native token spelling.")
				(call is_256bit_integer (local type))
				(then (return (call write_256bit_literal (borrow-shared (local source)) (local row) (local radix)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "C integer tokens cannot directly represent the full magnitude on supported C modes.")
				(call is_128bit_integer (local type))
				(then (return (call write_128bit_literal (borrow-shared (local source)) (local row) (local radix)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(let signed_wide (u32.eq (local type) (local i64_type)))
			(let-mut cursor (local offset))
			(if
				(:doc "Wide signed magnitudes use an exact-width constant or an in-range signed calculation.")
				(local signed_wide)
				(then
					(if
						(:doc "Subtract one in unsigned arithmetic before casting a negative magnitude to int64_t.")
						(local negative)
						(then (set (local cursor) (call c_literal_text (borrow-shared (local negative_i64_open))
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call c_literal_text (borrow-shared (local i64_constant))
							(borrow-mut (local output)) (local cursor) (local writing))))))
				(else
					(if (local negative) (then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 45u8 (local writing)))))))
			(if
				(:doc "Hexadecimal and binary both emit a C hexadecimal prefix.")
				(local hexadecimal)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local hex_prefix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(let start (struct.get (local row) start))
			(let end (struct.get (local row) end))
			(if
				(:doc "Binary needs radix conversion. Decimal and hexadecimal can copy their checked digits.")
				(i32.eq (local radix) 2i32)
				(then (set (local cursor) (call write_binary_digits (borrow-shared (local source)) (local start) (local end)
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call write_source_digits (borrow-shared (local source)) (local start) (local end)
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Finish the signed 64-bit expression before any of the narrower suffix rules.")
				(local signed_wide)
				(then
					(if
						(:doc "Finish the unsigned subtraction and the in-range signed negation.")
						(local negative)
						(then (return (call c_literal_text (borrow-shared (local negative_i64_close))
							(borrow-mut (local output)) (local cursor) (local writing)))))
					(return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(if
				(:doc "The magnitude of the signed i32 minimum would otherwise have an unsigned C hexadecimal type.")
				(bool.and (local hexadecimal) (local negative))
				(then (return (call c_literal_text (borrow-shared (local signed_hex_suffix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "The full u64 magnitude needs an unsigned long long C constant.")
				(u32.eq (local type) 54u32)
				(then (return (call c_literal_text (borrow-shared (local unsigned_wide_suffix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "Use an unsigned C constant for the full u32 range.")
				(u32.eq (local type) 11u32)
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 117u8 (local writing)))))
			(return (local cursor))))

	(let leading_count "wvrt_clz")
	(let trailing_count "wvrt_ctz")
	(let population_count "wvrt_popcnt")
	(let wide_suffix "128(")

	(fn write_integer_bit_count
		(:doc "Emit a count of the captured operand in its declared width.")
		(:expect (tests "stage-2/integer_bits/cases.tsv" "stage-2/cli/native/int128/supported.tsv") (issues "gh:wove-lang/wove:310"))
		(params (source (shared-array u8)) (first i32) (type u32) (operation u8) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Select the runtime operation before choosing its operand width.")
				(u8.eqz (local operation))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local leading_count))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(if
						(:doc "The second opcode counts trailing zeros and the third counts all set bits.")
						(u8.eq (local operation) 1u8)
						(then (set (local cursor) (call c_literal_text (borrow-shared (local trailing_count))
							(borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call c_literal_text (borrow-shared (local population_count))
							(borrow-mut (local output)) (local cursor) (local writing)))))))
			(let wide (call is_128bit_integer (local type)))
			(let-mut unsigned_type 54u32)
			(if
				(:doc "Only the wide helper accepts the native 128-bit operand.")
				(local wide)
				(then
					(set (local unsigned_type) (local u128_type))
					(set (local cursor) (call c_literal_text (borrow-shared (local wide_suffix))
						(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))
			(set (local cursor) (call c_cast (borrow-mut (local output))
				(local cursor) (local unsigned_type) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local first) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "The narrow helper masks off any bits outside the logical width.")
				(bool.not (local wide))
				(then (set (local cursor) (call write_word_width (borrow-mut (local output))
					(local cursor) (local type) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))

)
