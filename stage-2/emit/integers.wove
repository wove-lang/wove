(module emit_integers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write integer values, arithmetic, and bit counts in C.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/generics.wove" (only (value normalized_i32_literal)))
	(use wove-file "../source/literals.wove" (only read_integer_magnitude))
	(use wove-file "../hashing/base16.wove" (only (value base16_alphabet)))
	(use wove-file "../source/types.wove" (only is_128bit_integer is_256bit_integer (value i64_type) (value i128_type) (value u128_type) (value u256_type)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./runtime.wove" (only write_word_width close_runtime_call write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text c_cast c_hex_byte write_temporary_name))

	(let hex_prefix "0x")
	(let signed_hex_suffix "ll")
	(let unsigned_wide_suffix "ull")
	(let i16_wrap_open "(int16_t)((int32_t)(uint16_t)(32768u+(uint32_t)")
	(let i16_wrap_close ")-32768)")
	(let u16_wrap_open "(uint16_t)((uint32_t)")
	(let unsigned_operand "(uint32_t)")
	(let i64_wrap_open "wvrt_i64_from_wrapped_bits((uint64_t)")
	(let u64_operand "(uint64_t)")
	(let i64_constant "INT64_C(")
	(let u128_constant "WVRT_U128_C(")
	(let i128_constant "WVRT_I128_C(")
	(let negative_i128_constant "WVRT_I128_NEG_C(")
	(let negative_i64_open "(-INT64_C(1)-(int64_t)(")
	(let negative_i64_close "ull-1ull))")

	(let wrapping_open "wvrt_int_wrapping(")
	(let checked_open "wvrt_int_checked(")
	(let add_builtin "__builtin_add_overflow,")
	(let sub_builtin "__builtin_sub_overflow,")
	(let mul_builtin "__builtin_mul_overflow,")

	(let bitint_mul_overflow "wvrt_int256_mul_overflow,")
	(let bitint_wrapping_mul "wvrt_int256_wrapping_mul(")

	(fn open_integer_arithmetic
		(:doc "Choose the C operation for the exact operand width, including wide multiplication.")
		(params (type u32) (symbol u8) (checked bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let wide_product (bool.and (u8.eq symbol 42u8) (call is_256bit_integer type)))
			(if
				(:doc "The wrapping wide product needs only unsigned arithmetic.")
				(bool.and wide_product (bool.not checked))
				(then (return (call c_literal_text (borrow-shared bitint_wrapping_mul)
					(borrow-mut output) offset writing))))
			(let-mut cursor offset)
			(if
				(:doc "Only a trapping operation needs its source location.")
				checked
				(then (set cursor (call c_literal_text (borrow-shared checked_open)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared wrapping_open)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "Clang's addition builtin checks the exact destination.")
				(u8.eq symbol 43u8)
				(then (return (call c_literal_text (borrow-shared add_builtin)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "Subtraction uses its matching overflow builtin.")
				(u8.eq symbol 45u8)
				(then (return (call c_literal_text (borrow-shared sub_builtin)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "The wide signed product needs the same magnitude check as recoverable multiplication.")
				wide_product
				(then (return (call c_literal_text (borrow-shared bitint_mul_overflow)
					(borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared mul_builtin)
				(borrow-mut output) cursor writing))))

	(fn write_integer_arithmetic
		(:doc "Write exact-result arithmetic from captured operands or an implicit one for a unary step.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(symbol u8) (checked bool) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call open_integer_arithmetic (struct.get expression type)
				symbol checked (borrow-mut output) offset writing))
			(set cursor (call c_type_text (borrow-mut output) cursor
				(struct.get expression type) writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(let left (struct.get expression first))
			(let right (struct.get (array.load nodes left) next_sibling))
			(set cursor (call write_temporary_name (borrow-shared source) left
				tree_base (borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(if
				(:doc "A unary step has no second source operand to capture.")
				(i32.ltz right)
				(then (set cursor (call c_byte (borrow-mut output) cursor 49u8 writing)))
				(else (set cursor (call write_temporary_name (borrow-shared source) right
					tree_base (borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "Report overflow at the original file and operation head.")
				checked
				(then (return (call close_runtime_call (borrow-mut output) cursor
					(struct.get expression target) (struct.get expression start)
					(struct.get expression end) writing))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))

	(fn write_i64_wrapping
		(:doc `Perform the operation on unsigned bits and recover the corresponding signed word.`)
		(params (source (shared-array u8)) (first i32) (second i32) (tree_base i32) (symbol u8)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared i64_wrap_open)
				(borrow-mut output) offset writing))
			(let left (call write_temporary_name (borrow-shared source) first
				tree_base (borrow-mut output) open name_prefix writing))
			(let operator (call c_byte (borrow-mut output) left symbol writing))
			(let cast (call c_literal_text (borrow-shared u64_operand)
				(borrow-mut output) operator writing))
			(let right (call write_temporary_name (borrow-shared source) second
				tree_base (borrow-mut output) cast name_prefix writing))
			(return (call c_byte (borrow-mut output) right 41u8 writing))))

	(fn write_16bit_wrapping
		(:doc `Wrap captured operands modulo 2^16 using unsigned C arithmetic.

		Signed results use a bias before reducing to 16 bits. Subtracting it
		in i32 keeps the final int16_t cast in its representable range.`)
		(params (source (shared-array u8)) (first i32) (second i32) (tree_base i32) (symbol u8) (signed bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Only the signed path needs the bias before reduction.")
				signed
				(then (set cursor (call c_literal_text (borrow-shared i16_wrap_open)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared u16_wrap_open)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_temporary_name (borrow-shared source) first tree_base
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor symbol writing))
			(set cursor (call c_literal_text (borrow-shared unsigned_operand)
				(borrow-mut output) cursor writing))
			(set cursor (call write_temporary_name (borrow-shared source) second tree_base
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Unbias only after the wrapped value fits in uint16_t.")
				signed
				(then (return (call c_literal_text (borrow-shared i16_wrap_close)
					(borrow-mut output) cursor writing))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))

	(fn write_source_digits
		(:doc "Copy checked integer digits without Wove separators.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut index start)
			(let-mut cursor offset)
			(while
				(:doc "Keep each significant digit in its original order and case.")
				(i32.lt index end)
				(body
					(let byte (array.load source index))
					(if
						(:doc "C integer tokens do not use Wove’s underscore separator.")
						(u8.not-eq byte 95u8)
						(then (set cursor (call c_byte (borrow-mut output) cursor byte writing))))
					(set index (i32.inc index))))
			(return cursor)))

	(fn write_hex_word
		(:doc "Write a word as hexadecimal, padding it to eight digits when it follows a higher word.")
		(params (word u32) (padded bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut shift 28i32)
			(let-mut started padded)
			(while
				(:doc "Visit nibbles from the most significant to the least significant.")
				(i32.lt -1i32 shift)
				(body
					(let digit (i32.from-u32 (u32.and (u32.shr word shift) 15u32)))
					(if
						(:doc "Suppress leading zeroes while retaining one digit for zero.")
						(bool.or started (bool.or (i32.gtz digit) (i32.eqz shift)))
						(then
							(set started (bool true))
							(set cursor (call c_byte (borrow-mut output) cursor
								(array.load base16_alphabet digit) writing))))
					(set shift (i32.sub shift 4i32))))
			(return cursor)))

	(fn write_binary_digits
		(:doc "Use a portable hexadecimal C magnitude for a checked binary value.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared source) start end 2i32 (bool false)))
			(let high (struct.get magnitude high))
			(let-mut cursor offset)
			(let wide (u32.gtz high))
			(if
				(:doc "Only the high word may drop leading zeroes when both words are present.")
				wide
				(then (set cursor (call write_hex_word high (bool false)
					(borrow-mut output) cursor writing))))
			(return (call write_hex_word (struct.get magnitude low) wide
				(borrow-mut output) cursor writing))))

	(fn write_hex_half
		(:doc "Emit a portable unsigned 64-bit constant for one half of a wide value.")
		(params (high u32) (low u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared hex_prefix)
				(borrow-mut output) offset writing))
			(let padded (u32.gtz high))
			(if
				(:doc "The low word contributes all eight places when a high word precedes it.")
				padded
				(then (set cursor (call write_hex_word high (bool false)
					(borrow-mut output) cursor writing))))
			(let digits (call write_hex_word low padded (borrow-mut output) cursor writing))
			(return (call c_literal_text (borrow-shared unsigned_wide_suffix)
				(borrow-mut output) digits writing))))

	(fn write_128bit_literal
		(:doc "Write both checked halves into a C constant expression, including the signed minimum.")
		(params (source (shared-array u8)) (row ScalarExpression) (radix i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared source)
				(struct.get row start) (struct.get row end) radix (bool true)))
			(let-mut cursor offset)
			(if
				(:doc "Signed negative inputs need the in-range negation formula from the runtime header.")
				(u32.eq (struct.get row type) i128_type)
				(then
					(if
						(:doc "A checked zero never carries the negative flag.")
						(struct.get row negative)
						(then (set cursor (call c_literal_text (borrow-shared negative_i128_constant)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared i128_constant)
							(borrow-mut output) cursor writing)))))
				(else (set cursor (call c_literal_text (borrow-shared u128_constant)
					(borrow-mut output) cursor writing))))
			(let high (call write_hex_half (struct.get magnitude highest) (struct.get magnitude upper)
				(borrow-mut output) cursor writing))
			(let comma (call c_byte (borrow-mut output) high 44u8 writing))
			(let low (call write_hex_half (struct.get magnitude high) (struct.get magnitude low)
				(borrow-mut output) comma writing))
			(return (call c_byte (borrow-mut output) low 41u8 writing))))

	(let bitint_binary_prefix "0b")
	(let bitint_positive_close "uwb)")
	(let bitint_negative_close "uwb-1uwb)-1)")

	(fn write_256bit_literal
		(:doc "Give the normalized C23 token the checked width, using only representable signed intermediates.")
		(params (source (shared-array u8)) (row ScalarExpression) (radix i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let negative (struct.get row negative))
			(let-mut cursor (call c_byte (borrow-mut output) offset 40u8 writing))
			(if
				(:doc "For a negative value, cast magnitude minus one before negating, including at the signed minimum.")
				negative
				(then (set cursor (call c_byte (borrow-mut output) cursor 45u8 writing))))
			(set cursor (call c_cast (borrow-mut output) cursor
				(struct.get row type) writing))
			(if negative (then (set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))))
			(if
				(:doc "C23 supports the checked radix and its original exact digits.")
				(i32.eq radix 16i32)
				(then (set cursor (call c_literal_text (borrow-shared hex_prefix)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "Binary tokens retain their radix without accumulating through a narrower compiler type.")
				(i32.eq radix 2i32)
				(then (set cursor (call c_literal_text (borrow-shared bitint_binary_prefix)
					(borrow-mut output) cursor writing))))
			(let end (call write_source_digits (borrow-shared source)
				(struct.get row start) (struct.get row end)
				(borrow-mut output) cursor writing))
			(if
				(:doc "Finish the exact signed minimum without casting its positive magnitude to a signed type.")
				negative
				(then (return (call c_literal_text (borrow-shared bitint_negative_close)
					(borrow-mut output) end writing))))
			(return (call c_literal_text (borrow-shared bitint_positive_close)
				(borrow-mut output) end writing))))

	(fn write_integer_literal
		(:doc "Emit the normalized magnitude or decoded character with a C-safe sign and suffix.")
		(params (source (shared-array u8)) (row ScalarExpression) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let format (struct.get row target))
			(if
				(:doc "A concrete generic constant already carries an exact signed numeric value.")
				(i32.eq format normalized_i32_literal)
				(then (return (call write_c_number (borrow-mut output) offset
					(struct.get row start) writing))))
			(if
				(:doc "A nonnegative target is the decoded character byte, independent of the C execution encoding.")
				(i32.lt -1i32 format)
				(then
					(let prefix (call c_literal_text (borrow-shared hex_prefix)
						(borrow-mut output) offset writing))
					(return (call c_hex_byte (u8.from-i32 format) (borrow-mut output) prefix writing))))
			(let radix (i32.sub 0i32 format))
			(let hexadecimal (i32.not-eq radix 10i32))
			(let negative (struct.get row negative))
			(let type (struct.get row type))
			(if
				(:doc "The optional C23 scalar has a dedicated exact native token spelling.")
				(call is_256bit_integer type)
				(then (return (call write_256bit_literal (borrow-shared source) row radix
					(borrow-mut output) offset writing))))
			(if
				(:doc "C integer tokens cannot directly represent the full magnitude on supported C modes.")
				(call is_128bit_integer type)
				(then (return (call write_128bit_literal (borrow-shared source) row radix
					(borrow-mut output) offset writing))))
			(let signed_wide (u32.eq type i64_type))
			(let-mut cursor offset)
			(if
				(:doc "Wide signed magnitudes use an exact-width constant or an in-range signed calculation.")
				signed_wide
				(then
					(if
						(:doc "Subtract one in unsigned arithmetic before casting a negative magnitude to int64_t.")
						negative
						(then (set cursor (call c_literal_text (borrow-shared negative_i64_open)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared i64_constant)
							(borrow-mut output) cursor writing)))))
				(else
					(if negative (then (set cursor (call c_byte (borrow-mut output) cursor 45u8 writing))))))
			(if
				(:doc "Hexadecimal and binary both emit a C hexadecimal prefix.")
				hexadecimal
				(then (set cursor (call c_literal_text (borrow-shared hex_prefix)
					(borrow-mut output) cursor writing))))
			(let start (struct.get row start))
			(let end (struct.get row end))
			(if
				(:doc "Binary needs radix conversion. Decimal and hexadecimal can copy their checked digits.")
				(i32.eq radix 2i32)
				(then (set cursor (call write_binary_digits (borrow-shared source) start end
					(borrow-mut output) cursor writing)))
				(else (set cursor (call write_source_digits (borrow-shared source) start end
					(borrow-mut output) cursor writing))))
			(if
				(:doc "Finish the signed 64-bit expression before any of the narrower suffix rules.")
				signed_wide
				(then
					(if
						(:doc "Finish the unsigned subtraction and the in-range signed negation.")
						negative
						(then (return (call c_literal_text (borrow-shared negative_i64_close)
							(borrow-mut output) cursor writing))))
					(return (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(if
				(:doc "The magnitude of the signed i32 minimum would otherwise have an unsigned C hexadecimal type.")
				(bool.and hexadecimal negative)
				(then (return (call c_literal_text (borrow-shared signed_hex_suffix)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "The full u64 magnitude needs an unsigned long long C constant.")
				(u32.eq type 54u32)
				(then (return (call c_literal_text (borrow-shared unsigned_wide_suffix)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "Use an unsigned C constant for the full u32 range.")
				(u32.eq type 11u32)
				(then (return (call c_byte (borrow-mut output) cursor 117u8 writing))))
			(return cursor)))

	(let leading_count "wvrt_clz")
	(let trailing_count "wvrt_ctz")
	(let population_count "wvrt_popcnt")
	(let int128_count_suffix "128(")
	(let int256_count_suffix "256(")

	(fn write_integer_bit_count
		(:doc "Emit a count of the captured operand in its declared width.")
		(:expect (tests "stage-2/integer_bits/cases.tsv" "stage-2/cli/native/int128/supported.tsv" "stage-2/cli/native/int256/supported.tsv") (issues "gh:wove-lang/wove:310"))
		(params (source (shared-array u8)) (first i32) (type u32) (operation u8) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Select the runtime operation before choosing its operand width.")
				(u8.eqz operation)
				(then (set cursor (call c_literal_text (borrow-shared leading_count)
					(borrow-mut output) cursor writing)))
				(else
					(if
						(:doc "The second opcode counts trailing zeros and the third counts all set bits.")
						(u8.eq operation 1u8)
						(then (set cursor (call c_literal_text (borrow-shared trailing_count)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared population_count)
							(borrow-mut output) cursor writing))))))
			(let-mut unsigned_type 54u32)
			(if
				(:doc "Select a helper that preserves all bits of the captured word.")
				(call is_256bit_integer type)
				(then
					(set unsigned_type u256_type)
					(set cursor (call c_literal_text (borrow-shared int256_count_suffix)
						(borrow-mut output) cursor writing)))
				(else
					(if
						(:doc "The 128-bit helper also takes an unsigned word of the exact width.")
						(call is_128bit_integer type)
						(then
							(set unsigned_type u128_type)
							(set cursor (call c_literal_text (borrow-shared int128_count_suffix)
								(borrow-mut output) cursor writing)))
						(else (set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))))))
			(set cursor (call c_cast (borrow-mut output)
				cursor unsigned_type writing))
			(set cursor (call write_temporary_name (borrow-shared source) first tree_base
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "The narrow helper masks off any bits outside the logical width.")
				(u32.eq unsigned_type 54u32)
				(then (set cursor (call write_word_width (borrow-mut output)
					cursor type writing))))
			(return (call c_byte (borrow-mut output) cursor 41u8 writing))))

)
