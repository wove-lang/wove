(module emit_c_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit allocation, native address conversion, and lifetime changes for caller-owned C storage.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../c/arguments.wove" (only is_c_storage_shared_mode c_storage_consume_mode is_c_storage_init_mode (value c_marked_handle_out_mode) (value c_storage_init_always_mode)))
	(use wove-file "./owners.wove" (only native_owner_contract write_native_type write_native_destructor))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text write_local_name write_temporary_name))

	(let alloc_open "wvrt_c_storage_new(sizeof(")
	(let tail_alloc_open "WVRT_C_TAIL_ALLOC(")
	(let vector_alloc_open "WVRT_CSTR_VECTOR_ALLOC(")
	(let vector_view_open "WVRT_CSTR_VECTOR_VIEW(")
	(let alloc_align "),_Alignof(")
	(let storage_data "wvrt_c_storage_data(")
	(let constant_type "const __typeof__(")
	(let init_finish "wvrt_c_storage_finish_init(")
	(let storage_free "wvrt_c_storage_free(")
	(let drop_if "if(wvrt_c_storage_active(")
	(let drop_call "))(void)")
	(let end_statement ");")

	(fn write_storage_type
		(:doc "Write the exact underlying C object type of a storage owner.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let contract (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(return (call write_native_type (borrow-shared source)
				(array:load nodes (struct:get contract native))
				(borrow-mut output) offset writing))))

	(fn write_storage_member
		(:doc "Emit one checked C member name followed by its argument separator.")
		(params (source (shared-array u8)) (member SourceNode) (output (mut-array u8))
			(offset u32) (writing bool)) (returns u32)
		(body
			(let name (call c_span (borrow-shared source) (struct:get member start) (struct:get member end)
				(borrow-mut output) offset writing))
			(return (call c_byte (borrow-mut output) name 44u8 writing))))

	(fn write_string_vector_allocation
		(:doc "Initialize the native reserved slot count before the first C call.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression)
			(member i32) (output (mut-array u8)) (offset u32)
			(name_prefix i32) (writing bool)) (returns u32)
		(body
			(let open (call c_literal_text (borrow-shared vector_alloc_open) (borrow-mut output) offset writing))
			(let repr (call write_storage_type (borrow-shared source) (borrow-shared nodes) (struct:get site type)
				(borrow-mut output) open writing))
			(let comma (call c_byte (borrow-mut output) repr 44u8 writing))
			(let field (call write_storage_member (borrow-shared source) (array:load nodes member)
				(borrow-mut output) comma writing))
			(let reserved (call write_temporary_name (borrow-shared nodes) (struct:get site first) (borrow-mut output) field name_prefix writing))
			(return (call close_runtime_call (borrow-mut output) reserved (struct:get site target)
				(struct:get site start) (struct:get site end) writing))))

	(fn write_string_vector_view
		(:doc "Build the view from the exact member expressions of an active native owner.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression)
			(owner_type u32) (output (mut-array u8)) (offset u32)
			(name_prefix i32) (writing bool)) (returns u32)
		(body
			(let contract (call native_owner_contract (borrow-shared source) (borrow-shared nodes) owner_type))
			(let open (call c_literal_text (borrow-shared vector_view_open) (borrow-mut output) offset writing))
			(let repr (call write_storage_type (borrow-shared source) (borrow-shared nodes) owner_type
				(borrow-mut output) open writing))
			(let comma (call c_byte (borrow-mut output) repr 44u8 writing))
			(let paths (call write_storage_member (borrow-shared source) (array:load nodes (struct:get contract vector))
				(borrow-mut output) comma writing))
			(let count (call write_storage_member (borrow-shared source) (array:load nodes (struct:get contract vector_count))
				(borrow-mut output) paths writing))
			(let reserved (call write_storage_member (borrow-shared source) (array:load nodes (struct:get contract vector_offset))
				(borrow-mut output) count writing))
			(let owner (call write_temporary_name (borrow-shared nodes) (struct:get site first) (borrow-mut output) reserved name_prefix writing))
			(return (call close_runtime_call (borrow-mut output) owner (struct:get site target)
				(struct:get site start) (struct:get site end) writing))))

	(fn write_storage_allocation
		(:doc "Allocate a zeroed object using the defining C type's own size and alignment.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let type (struct:get site type))
			(let capacity (struct:get site first))
			(if
				(:doc "Let C verify the count and trailing array types and compute their actual offsets.")
				(i32:not-ltz capacity)
				(then
					(let contract (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
					(let vector_offset (struct:get contract vector_offset))
					(if
						(:doc "An explicit string vector prefix initializes the selected size_t member.")
						(i32:not-ltz vector_offset)
						(then (return (call write_string_vector_allocation (borrow-shared source) (borrow-shared nodes)
							site vector_offset (borrow-mut output) offset name_prefix writing))))
					(let count (array:load nodes (struct:get contract count)))
					(let tail (array:load nodes (struct:get contract tail)))
					(let open (call c_literal_text (borrow-shared tail_alloc_open) (borrow-mut output) offset writing))
					(let repr (call write_storage_type (borrow-shared source) (borrow-shared nodes) type
						(borrow-mut output) open writing))
					(let count_open (call c_byte (borrow-mut output) repr 44u8 writing))
					(let count_end (call c_span (borrow-shared source) (struct:get count start) (struct:get count end)
						(borrow-mut output) count_open writing))
					(let tail_open (call c_byte (borrow-mut output) count_end 44u8 writing))
					(let tail_end (call c_span (borrow-shared source) (struct:get tail start) (struct:get tail end)
						(borrow-mut output) tail_open writing))
					(let capacity_open (call c_byte (borrow-mut output) tail_end 44u8 writing))
					(let capacity_end (call write_temporary_name (borrow-shared nodes) capacity
						(borrow-mut output) capacity_open name_prefix writing))
					(return (call close_runtime_call (borrow-mut output) capacity_end (struct:get site target)
						(struct:get site start) (struct:get site end) writing))))
			(let open (call c_literal_text (borrow-shared alloc_open) (borrow-mut output) offset writing))
			(let size (call write_storage_type (borrow-shared source) (borrow-shared nodes) type
				(borrow-mut output) open writing))
			(let align_open (call c_literal_text (borrow-shared alloc_align) (borrow-mut output) size writing))
			(let alignment (call write_storage_type (borrow-shared source) (borrow-shared nodes) type
				(borrow-mut output) align_open writing))
			(let close (call c_byte (borrow-mut output) alignment 41u8 writing))
			(return (call close_runtime_call (borrow-mut output) close (struct:get site target)
				(struct:get site start) (struct:get site end) writing))))

	(fn write_storage_pointer_type
		(:doc "Apply const to the whole object even when its C representation is itself a pointer.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32) (shared bool)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "A shared loan qualifies the original C type as a whole.")
				shared
				(then (set cursor (call c_literal_text (borrow-shared constant_type)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_storage_type (borrow-shared source) (borrow-shared nodes) type
				(borrow-mut output) cursor writing))
			(if
				(:doc "End the type operand before appending its pointer.")
				shared
				(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(return (call c_byte (borrow-mut output) cursor 42u8 writing))))

	(fn open_storage_address
		(:doc "Begin a cast of the stable object address to the native parameter's pointer type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32) (shared bool)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let pointee (call write_storage_pointer_type (borrow-shared source) (borrow-shared nodes)
				type shared (borrow-mut output) open writing))
			(let close (call c_byte (borrow-mut output) pointee 41u8 writing))
			(return (call c_literal_text (borrow-shared storage_data) (borrow-mut output) close writing))))

	(fn write_storage_argument
		(:doc "Project the original native object from an already evaluated and checked owner.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (param ScalarParameter)
			(argument i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let shared (call is_c_storage_shared_mode (struct:get param c_mode)))
			(let open (call open_storage_address (borrow-shared source) (borrow-shared nodes)
				(struct:get param type) shared (borrow-mut output) offset writing))
			(let owner (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) open name_prefix writing))
			(return (call c_byte (borrow-mut output) owner 41u8 writing))))

	(let marker_check "_Static_assert(__builtin_classify_type(")
	(let marker_check_end ")==5,\"Wove C owner sentinel must have pointer type\");\n")
	(let marker_assign "=*")
	(let marker_and "!=0&&*")
	(let marker_compare "==(")
	(let marker_when ");if(*")
	(let marker_clear ")*")
	(let marker_empty "=0;")

	(fn write_owner_marker_result
		(:doc "Publish the sentinel flag and clear the marked slot before any Wove owner operation can see it.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(argument i32) (formal ScalarParameter)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut flag first)
			(let-mut remaining (struct:get formal c_count))
			(while
				(:doc "Find the Wove flag actual in the same formal order used for argument evaluation.")
				(i32:gtz remaining)
				(body
					(set flag (struct:get (array:load nodes flag) next_sibling))
					(set remaining (i32:dec remaining))))
			(let marker (array:load nodes (struct:get formal c_size)))
			(let check (call c_literal_text (borrow-shared marker_check)
				(borrow-mut output) offset writing))
			(let pointer (call c_span (borrow-shared source) (struct:get marker start)
				(struct:get marker end) (borrow-mut output) check writing))
			(let checked (call c_literal_text (borrow-shared marker_check_end)
				(borrow-mut output) pointer writing))
			(let star (call c_byte (borrow-mut output) checked 42u8 writing))
			(let result (call write_temporary_name (borrow-shared nodes) flag
				(borrow-mut output) star name_prefix writing))
			(let assign (call c_literal_text (borrow-shared marker_assign)
				(borrow-mut output) result writing))
			(let slot (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) assign name_prefix writing))
			(let present (call c_literal_text (borrow-shared marker_and)
				(borrow-mut output) slot writing))
			(let compare_slot (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) present name_prefix writing))
			(let compare (call c_literal_text (borrow-shared marker_compare)
				(borrow-mut output) compare_slot writing))
			(let named (call c_span (borrow-shared source) (struct:get marker start)
				(struct:get marker end) (borrow-mut output) compare writing))
			(let when (call c_literal_text (borrow-shared marker_when)
				(borrow-mut output) named writing))
			(let test (call write_temporary_name (borrow-shared nodes) flag
				(borrow-mut output) when name_prefix writing))
			(let clear (call c_literal_text (borrow-shared marker_clear)
				(borrow-mut output) test writing))
			(let clear_slot (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) clear name_prefix writing))
			(return (call c_literal_text (borrow-shared marker_empty)
				(borrow-mut output) clear_slot writing))))

	(fn write_storage_after_call
		(:doc "Normalize returned markers and apply storage effects after the native status is saved.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(first i32) (callee ScalarFunction) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut argument first)
			(let-mut formal (struct:get callee params))
			(let fixed_end (i32:add formal (struct:get callee arity)))
			(let-mut cursor offset)
			(while
				(:doc "Only declared formals can initialize or consume native backing storage.")
				(i32:lt formal fixed_end)
				(body
					(let param (array:load parameters formal))
					(let mode (struct:get param c_mode))
					(if
						(:doc "A sentinel never remains in the ordinary owner slot after this call.")
						(u8:eq mode c_marked_handle_out_mode)
						(then (set cursor (call write_owner_marker_result (borrow-shared source)
							(borrow-shared nodes) first argument param
							(borrow-mut output) cursor name_prefix writing))))
					(if
						(:doc "A storage initializer keeps its exact i32 status while updating the owner state.")
						(call is_c_storage_init_mode mode)
						(then
							(set cursor (call c_literal_text (borrow-shared init_finish)
								(borrow-mut output) cursor writing))
							(set cursor (call write_temporary_name (borrow-shared nodes)
								argument (borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
							(if
								(:doc "Zero activates storage whose cleanup contract is independent of the result.")
								(u8:eq mode c_storage_init_always_mode)
								(then (set cursor (call c_byte (borrow-mut output) cursor 48u8 writing)))
								(else (set cursor (call write_temporary_name (borrow-shared nodes)
									index (borrow-mut output) cursor name_prefix writing))))
							(set cursor (call c_literal_text (borrow-shared end_statement)
								(borrow-mut output) cursor writing))))
					(if
						(:doc "The consuming C call owns destruction. Wove releases only its backing allocation.")
						(u8:eq mode (call c_storage_consume_mode))
						(then
							(set cursor (call c_literal_text (borrow-shared storage_free)
								(borrow-mut output) cursor writing))
							(set cursor (call write_temporary_name (borrow-shared nodes)
								argument (borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_literal_text (borrow-shared end_statement)
								(borrow-mut output) cursor writing))))
					(set argument (struct:get (array:load nodes argument) next_sibling))
					(set formal (i32:inc formal))))
			(return cursor)))

	(fn write_storage_cleanup
		(:doc "Destroy an active scope-owned object once, then release its storage even if it was never initialized.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32) (name i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let contract (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(let-mut cursor offset)
			(if
				(:doc "Only active objects with a native destructor need a call before raw storage is freed.")
				(i32:not-ltz (struct:get contract drop))
				(then
					(let open (call c_literal_text (borrow-shared drop_if) (borrow-mut output) cursor writing))
					(let slot (call write_local_name (borrow-shared source) (borrow-shared nodes)
						name tree_base (borrow-mut output) open name_prefix writing))
					(let call_drop (call c_literal_text (borrow-shared drop_call) (borrow-mut output) slot writing))
					(let destructor (call write_native_destructor (borrow-shared source) (borrow-shared nodes)
						type (borrow-mut output) call_drop writing))
					(let args (call c_byte (borrow-mut output) destructor 40u8 writing))
					(let address (call open_storage_address (borrow-shared source) (borrow-shared nodes)
						type (bool false) (borrow-mut output) args writing))
					(let drop_owner (call write_local_name (borrow-shared source) (borrow-shared nodes)
						name tree_base (borrow-mut output) address name_prefix writing))
					(let data_end (call c_byte (borrow-mut output) drop_owner 41u8 writing))
					(set cursor (call c_literal_text (borrow-shared end_statement)
						(borrow-mut output) data_end writing))))
			(let release (call c_literal_text (borrow-shared storage_free) (borrow-mut output) cursor writing))
			(let free_owner (call write_local_name (borrow-shared source) (borrow-shared nodes)
				name tree_base (borrow-mut output) release name_prefix writing))
			(return (call c_literal_text (borrow-shared end_statement) (borrow-mut output) free_owner writing)))))
