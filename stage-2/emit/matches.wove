(module emit_matches
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write the choice and exact result join of an already checked value match.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only is_builtin_integer))
	(use wove-file "../scalar/records.wove" (only record_index is_payload_enum (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))
	(use wove-file "./enums.wove" (only write_case_entry close_match_switch
		(value c_enum_tag) (value c_switch) (value c_switch_body)))

	(let join_arm_end ";break;}")

	(fn open_match_value
		(:doc "Declare the result outside the switch and select a case from the captured subject.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(subject i32) (type u32) (index i32) (result u32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local result)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local c_switch))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local subject) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "A tagged enum selects by discriminant. Its captured value stays available for copying the payload.")
				(bool.and (bool.not (call is_builtin_integer (local type)))
					(call is_payload_enum (array.load (local records) (call record_index (local type)))))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local c_enum_tag))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_switch_body)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_match_edge
		(:doc "Finish the subject or a case result before opening the next case. Only the selected case assigns the result.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(child i32) (parent i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let choice (array.load (local expressions) (local parent)))
			(let subject (struct.get (local choice) first))
			(let subject_type (struct.get (array.load (local expressions) (local subject)) type))
			(let next (struct.get (array.load (local nodes) (local child)) next_sibling))
			(let-mut cursor (local offset))
			(if
				(:doc "The first edge starts the switch. Each later edge writes the selected arm's result.")
				(i32.eq (local subject) (local child))
				(then (set (local cursor) (call open_match_value (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local subject) (local subject_type) (local parent) (struct.get (local choice) type)
					(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
				(else
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local parent) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source))
						(struct.get (array.load (local expressions) (local child)) first) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local join_arm_end))
						(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "The last edge closes the switch. An explicit fallback has already supplied its default label.")
				(i32.lt (local next) 0i32)
				(then (return (call close_match_switch (array.load (local statements) (local child))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call write_case_entry (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local records))
				(borrow-shared (local statements)) (borrow-shared (local expressions)) (array.load (local statements) (local next))
				(call is_builtin_integer (local subject_type)) (local subject) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
)
