(module emit_matches
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write the choice and exact result join of an already checked value match.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only is_builtin_integer))
	(use wove-file "../scalar/records.wove" (only record_index is_payload_enum (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))
	(use wove-file "./enums.wove" (only write_case_entry close_match_switch
		(value c_enum_tag) (value c_switch) (value c_switch_body)))

	(let join_arm_end ";break;}")

	(fn open_match_value
		(:doc "Declare the result outside the switch and select a case from the captured subject.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(subject i32) (type u32) (index i32) (result u32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) result
				(borrow-mut output) offset name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 59u8 writing))
			(set cursor (call c_literal_text (borrow-shared c_switch)
				(borrow-mut output) cursor writing))
			(set cursor (call write_temporary_name (borrow-shared nodes) subject
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "A tagged enum selects by discriminant. Its captured value stays available for copying the payload.")
				(bool:and (bool:not (call is_builtin_integer type))
					(call is_payload_enum (records.get (call record_index type))))
				(then (set cursor (call c_literal_text (borrow-shared c_enum_tag)
					(borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared c_switch_body) (borrow-mut output) cursor writing))))

	(fn write_match_edge
		(:doc "Finish the subject or a case result before opening the next case. Only the selected case assigns the result.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(child i32) (parent i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let choice (expressions.get parent))
			(let subject (choice.get first))
			(let subject_type (struct:get (expressions.get subject) type))
			(let next (struct:get (nodes.get child) next_sibling))
			(let-mut cursor offset)
			(if
				(:doc "The first edge starts the switch. Each later edge writes the selected arm's result.")
				(i32:eq subject child)
				(then (set cursor (call open_match_value (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) subject subject_type parent (choice.get type) (borrow-mut output) cursor name_prefix writing)))
				(else
					(set cursor (call write_temporary_name (borrow-shared nodes) parent
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
					(set cursor (call write_temporary_name (borrow-shared nodes)
						(struct:get (expressions.get child) first)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared join_arm_end)
						(borrow-mut output) cursor writing))))
			(if
				(:doc "The last edge closes the switch. An explicit fallback has already supplied its default label.")
				(i32:ltz next)
				(then (return (call close_match_switch (statements.get child)
					(borrow-mut output) cursor writing))))
			(return (call write_case_entry (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared statements) (borrow-shared expressions) (statements.get next)
				subject_type subject tree_base
				(borrow-mut output) cursor name_prefix writing))))
)
