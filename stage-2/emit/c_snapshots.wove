(module emit_c_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Lower a borrowed or allocating native text result into a nullable Wove byte owner.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_span write_temporary_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "../scalar/records.wove" (only is_buffered_record))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))

	(let field_snapshot "WVRT_SNAPSHOT_CSTR_FIELD_AT_SPAN(")
	(let extended_field_snapshot "WVRT_SNAPSHOT_EXTENDED_CSTR_FIELD_AT_SPAN(")
	(let borrowed_snapshot "wvrt_snapshot_borrowed_cstr_at_span(")
	(let snapshot_select "_Generic(&")
	(let snapshot_implementations ",void(*)(void*):wvrt_snapshot_cstr_at_span,void(*)(char*):wvrt_snapshot_chars_at_span)(")
	(let require_array "wvrt_require_array_at_span(")
	(let require_borrow "wvrt_require_borrow_at_span(")

	(fn write_snapshot_symbol
		(:doc `Emit the original checked native symbol spelling.`)
		(params (source (shared-array u8)) (release SourceNode) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body (return (call c_span (borrow-shared source) (struct:get release start) (struct:get release end)
			(borrow-mut output) offset writing))))

	(fn open_c_snapshot
		(:doc `Select the field, borrowed-string, or allocating-string snapshot wrapper.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (drop i32) (field i32) (extent i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The extended field wrapper uses the record's own reported byte count.")
				(i32:not-ltz extent)
				(then (return (call c_literal_text (borrow-shared extended_field_snapshot)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The field wrapper captures one native result and handles its null and inline storage.")
				(i32:lt -1i32 field)
				(then (return (call c_literal_text (borrow-shared field_snapshot)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A borrowed C result only needs the copy and its originating call span.")
				(i32:ltz drop)
				(then (return (call c_literal_text (borrow-shared borrowed_snapshot)
					(borrow-mut output) offset writing))))
			(let open (call c_literal_text (borrow-shared snapshot_select) (borrow-mut output) offset writing))
			(let symbol (call write_snapshot_symbol (borrow-shared source) (array:load nodes drop)
				(borrow-mut output) open writing))
			(return (call c_literal_text (borrow-shared snapshot_implementations)
				(borrow-mut output) symbol writing))))

	(fn close_c_snapshot
		(:doc `Supply the field or release symbol followed by the original call span.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (drop i32) (field i32) (extent i32) (file i32) (start i32) (end i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut symbol drop)
			(if (i32:lt -1i32 field) (then (set symbol field)))
			(if
				(:doc "A plain borrowed string's snapshot takes no symbol operand.")
				(i32:lt -1i32 symbol)
				(then
					(let comma (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set cursor (call write_snapshot_symbol (borrow-shared source) (array:load nodes symbol)
						(borrow-mut output) comma writing))))
			(if
				(:doc "The native byte extent follows the original field spelling.")
				(i32:not-ltz extent)
				(then
					(let comma (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set cursor (call write_snapshot_symbol (borrow-shared source) (array:load nodes extent)
						(borrow-mut output) comma writing))))
			(return (call close_runtime_call (borrow-mut output) cursor
				file start end writing))))

	(let require_buffered_record "wvrt_c_buffered_record_require(")

	(fn write_optional_unwrap
		(:doc `Check presence at the unwrap span and yield the original allocation or native pointer.`)
		(params (nodes (shared-array SourceNode)) (site ScalarExpression) (borrowed bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut open offset)
			(if
				(:doc "Choose the checked helper with the matching pointer representation.")
				borrowed
				(then
					(if
						(:doc "Keep the complete caller-backed descriptor when checking its nullable pointer.")
						(call is_buffered_record (struct:get site type))
						(then (set open (call c_literal_text (borrow-shared require_buffered_record)
							(borrow-mut output) offset writing)))
						(else (set open (call c_literal_text (borrow-shared require_borrow)
							(borrow-mut output) offset writing)))))
				(else (set open (call c_literal_text (borrow-shared require_array)
					(borrow-mut output) offset writing))))
			(let pointer (call write_temporary_name (borrow-shared nodes) (struct:get site first)
				(borrow-mut output) open name_prefix writing))
			(return (call close_runtime_call (borrow-mut output) pointer
				(struct:get site target) (struct:get site start) (struct:get site end) writing))))
)
