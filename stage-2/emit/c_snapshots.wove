(module emit_c_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Lower a borrowed or allocating native text result into a nullable Wove byte owner.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_span write_temporary_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))

	(let field_snapshot "WVRT_SNAPSHOT_CSTR_FIELD_AT_SPAN(")
	(let borrowed_snapshot "wvrt_snapshot_borrowed_cstr_at_span(")
	(let snapshot_select "_Generic(&")
	(let snapshot_implementations ",void(*)(void*):wvrt_snapshot_cstr_at_span,void(*)(char*):wvrt_snapshot_chars_at_span)(")
	(let require_array "wvrt_require_array_at_span(")

	(fn write_snapshot_symbol
		(:doc `Emit the original checked native symbol spelling.`)
		(params (source (shared-array u8)) (release SourceNode) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body (return (call c_span (borrow-shared (local source)) (struct.get (local release) start) (struct.get (local release) end)
			(borrow-mut (local output)) (local offset) (local writing)))))

	(fn open_c_snapshot
		(:doc `Select the field, borrowed-string, or allocating-string snapshot wrapper.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (drop i32) (field i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The field wrapper captures one native result and handles its null and inline storage.")
				(i32.lt -1i32 (local field))
				(then (return (call c_literal_text (borrow-shared (local field_snapshot))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "A borrowed C result only needs the copy and its originating call span.")
				(i32.lt (local drop) 0i32)
				(then (return (call c_literal_text (borrow-shared (local borrowed_snapshot))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(let open (call c_literal_text (borrow-shared (local snapshot_select)) (borrow-mut (local output)) (local offset) (local writing)))
			(let symbol (call write_snapshot_symbol (borrow-shared (local source)) (array.load (local nodes) (local drop))
				(borrow-mut (local output)) (local open) (local writing)))
			(return (call c_literal_text (borrow-shared (local snapshot_implementations))
				(borrow-mut (local output)) (local symbol) (local writing)))))

	(fn close_c_snapshot
		(:doc `Supply the field or release symbol followed by the original call span.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (drop i32) (field i32) (file i32) (start i32) (end i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut symbol (local drop))
			(if (i32.lt -1i32 (local field)) (then (set (local symbol) (local field))))
			(if
				(:doc "A plain borrowed string's snapshot takes no symbol operand.")
				(i32.lt -1i32 (local symbol))
				(then
					(let comma (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(set (local cursor) (call write_snapshot_symbol (borrow-shared (local source)) (array.load (local nodes) (local symbol))
						(borrow-mut (local output)) (local comma) (local writing)))))
			(return (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(local file) (local start) (local end) (local writing)))))

	(fn write_optional_unwrap
		(:doc `Check presence at the unwrap span and yield the original Wove allocation.`)
		(params (source (shared-array u8)) (site ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local require_array)) (borrow-mut (local output)) (local offset) (local writing)))
			(let pointer (call write_temporary_name (borrow-shared (local source)) (struct.get (local site) first) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local pointer)
				(struct.get (local site) target) (struct.get (local site) start) (struct.get (local site) end) (local writing)))))
)
