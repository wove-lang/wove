(module emit_c_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Lower an allocating native text result into a nullable Wove byte owner.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_span write_temporary_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))

	(let snapshot_select "_Generic(&")
	(let snapshot_implementations ",void(*)(void*):wvrt_snapshot_cstr_at_span,void(*)(char*):wvrt_snapshot_chars_at_span)(")
	(let require_array "wvrt_require_array_at_span(")

	(fn write_release_symbol
		(:doc `Emit the original checked native release spelling.`)
		(params (source (shared-slice u8)) (release SourceNode) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body (return (call c_span (borrow-shared (local source)) (record.get (local release) start) (record.get (local release) end)
			(borrow-mut (local output)) (local offset) (local writing)))))

	(fn open_c_snapshot
		(:doc `Select a supported destructor ABI without evaluating the native result or casting the release.`)
		(params (source (shared-slice u8)) (release SourceNode) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local snapshot_select)) (borrow-mut (local output)) (local offset) (local writing)))
			(let symbol (call write_release_symbol (borrow-shared (local source)) (local release)
				(borrow-mut (local output)) (local open) (local writing)))
			(return (call c_literal_text (borrow-shared (local snapshot_implementations))
				(borrow-mut (local output)) (local symbol) (local writing)))))

	(fn close_c_snapshot
		(:doc `Supply the release function and the original native call span after the invocation.`)
		(params (source (shared-slice u8)) (release SourceNode) (file i32) (start i32) (end i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let comma (call c_byte (borrow-mut (local output)) (local offset) 44u8 (local writing)))
			(let symbol (call write_release_symbol (borrow-shared (local source)) (local release)
				(borrow-mut (local output)) (local comma) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local symbol)
				(local file) (local start) (local end) (local writing)))))

	(fn write_optional_unwrap
		(:doc `Check presence at the unwrap span and yield the original Wove allocation.`)
		(params (source (shared-slice u8)) (site ScalarExpression) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local require_array)) (borrow-mut (local output)) (local offset) (local writing)))
			(let pointer (call write_temporary_name (borrow-shared (local source)) (record.get (local site) first) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local pointer)
				(record.get (local site) target) (record.get (local site) start) (record.get (local site) end) (local writing)))))
)
