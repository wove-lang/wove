(module c_name_collisions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Assign private C spelling alternatives only where complete generated names coincide.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/generics.wove" (only function_generic_list))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../scalar/function_rows.wove" (only function_with_c_name_slot (type ScalarFunction)))
	(use wove-file "../scalar/binding_names.wove" (only module_binding_key module_binding_identity (value module_binding_key_kind)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_generic_template record_with_c_name_slot scope_at (type ScalarRecord)))
	(use wove-file "../scalar/generics/functions.wove" (only (type FunctionInstance)))
	(use wove-file "../scalar/generics/key_order.wove" (only order_definitions order_record_keys order_application_keys application_site))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./names.wove" (only child_identity (value module_data_role)))

	(struct Bucket (fields (head i32)))
	(struct Candidate (fields (role u32) (fingerprint u32) (name i32) (start i32) (end i32) (next i32)))
	(let function_candidate 1u32)
	(let record_candidate 2u32)
	(let binding_candidate 3u32)

	(fn base_candidate
		(:doc "Retain the fingerprint and source suffix of one generated file-scope name.")
		(params (name SourceNode) (row i32) (role u32) (fingerprint u32)) (returns Candidate)
		(body (return (struct.new Candidate (role role) (fingerprint fingerprint)
			(name row) (start (struct.get name start)) (end (struct.get name end)) (next 0i32)))))

	(fn same_suffix
		(:doc "Compare the validated source bytes emitted as each generated suffix.")
		(params (source (shared-array u8)) (left Candidate) (right Candidate)) (returns bool)
		(body (return (call same_bytes (borrow-shared source)
			(struct.get left start) (struct.get left end)
			(borrow-shared source) (struct.get right start) (struct.get right end)))))

	(fn bucket
		(:doc "Reduce a fingerprint to one entry in a power-of-two table.")
		(params (fingerprint u32) (count i32)) (returns i32)
		(body (return (i32.from-u32 (u32.and fingerprint (u32.from-i32 (i32.dec count)))))))

	(fn link_candidate
		(:doc "Use one-based links so zeroed buckets require no setup pass.")
		(params (buckets (mut-array Bucket)) (candidates (mut-array Candidate)) (row i32) (name Candidate))
		(returns void)
		(body
			(let chain (call bucket (struct.get name fingerprint) (array.len buckets)))
			(array.store candidates row (struct.new Candidate
				(role (struct.get name role)) (fingerprint (struct.get name fingerprint))
				(name (struct.get name name))
				(start (struct.get name start)) (end (struct.get name end))
				(next (struct.get (array.load buckets chain) head))))
			(array.store buckets chain (struct.new Bucket (head (i32.inc row))))))

	(fn order_function_keys
		(:doc "Compare defining function rows and, within one template, complete specialization keys.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(left ScalarFunction) (right ScalarFunction) (instances (shared-array FunctionInstance))
			(left_instance i32) (right_instance i32)) (returns i32)
		(body
			(let file (struct.get left file))
			(let origin (struct.get left origin))
			(let order (call order_definitions (borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
				file origin (struct.get right file) (struct.get right origin)))
			(if (i32.not-eqz order) (then (return order)))
			(let a (array.load instances left_instance))
			(let b (array.load instances right_instance))
			(let list (call function_generic_list (borrow-shared arena) (borrow-shared nodes)
				(array.load nodes origin)))
			(let formal (struct.get (call form_parts (borrow-shared arena) (borrow-shared nodes)
				(array.load nodes list)) operands))
			(return (call order_application_keys (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
				(call application_site (struct.get a site) (struct.get a site_file) (struct.get a site_base))
				(call application_site (struct.get b site) (struct.get b site_file) (struct.get b site_base))
				formal (call scope_at file (struct.get left source_base)) (bool false)))))

	(fn collision_rank
		(:doc "Rank one genuine spelling conflict by its stable exact key. Return zero for an unchanged name.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (functions (shared-array ScalarFunction))
			(instances (shared-array FunctionInstance)) (first_instance i32) (function_count i32)
			(expressions (shared-array ScalarExpression)) (candidates (shared-array Candidate)) (row i32) (head i32)) (returns i32)
		(body
			(let name (array.load candidates row))
			(let-mut cursor head)
			(let-mut collision (bool false))
			(let-mut rank 1i32)
			(while
				(:doc "A bucket can contain several fingerprints and separate generated roles.")
				(i32.gtz cursor)
				(body
					(let other (i32.dec cursor))
					(let candidate (array.load candidates other))
					(if
						(:doc "Only the complete spelling can put two exact definitions in the same C namespace slot.")
						(bool.and (i32.not-eq other row)
							(bool.and (u32.eq (struct.get name role) (struct.get candidate role))
								(bool.and (u32.eq (struct.get name fingerprint) (struct.get candidate fingerprint))
									(call same_suffix (borrow-shared arena) name candidate))))
						(then
							(set collision (bool true))
							(let-mut order 0i32)
							(if
								(:doc "Use the complete nominal function key, including checked specialization arguments.")
								(u32.eq (struct.get name role) function_candidate)
								(then (set order (call order_function_keys (borrow-shared arena)
									(borrow-shared files) (borrow-shared nodes) (borrow-shared records)
									(borrow-shared bindings) (array.load functions other)
									(array.load functions row) (borrow-shared instances)
									(i32.sub other first_instance) (i32.sub row first_instance))))
								(else
									(if
										(:doc "Named layouts keep exact template and argument ordering.")
										(u32.eq (struct.get name role) record_candidate)
										(then (set order (call order_record_keys (borrow-shared arena)
											(borrow-shared files) (borrow-shared nodes) (borrow-shared records)
											(borrow-shared bindings) (array.load records (i32.sub other function_count))
											(array.load records (i32.sub row function_count)))))
										(else
											(let left (struct.get candidate name))
											(let right (struct.get name name))
											(set order (call order_definitions (borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
												(struct.get (array.load expressions left) first) left
												(struct.get (array.load expressions right) first) right))))))
							(if (i32.ltz order) (then (set rank (i32.inc rank))))))
					(set cursor (struct.get candidate next))))
			(if collision (then (return rank)))
			(return 0i32)))

	(fn assign_c_names
		(:doc "Resolve private generated name collisions before either C emission pass.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (instances (shared-array FunctionInstance)) (first_instance i32)
			(functions (mut-array ScalarFunction)) (function_count i32) (records (mut-array ScalarRecord))
			(expressions (mut-array ScalarExpression)))
		(returns void)
		(body
			(let-mut record_count 0i32)
			(while
				(:doc "Only the populated layout prefix needs candidate storage.")
				(bool.and (i32.lt record_count (array.len records))
					(i32.not-eqz (struct.get (array.load records record_count) name)))
				(body (set record_count (i32.inc record_count))))
			(let binding_start (i32.add function_count record_count))
			(let-mut count binding_start)
			(let-mut index 0i32)
			(while
				(:doc "Count each selected Wove binding once, regardless of its uses or aliases.")
				(i32.lt index (array.len expressions))
				(body
					(if (u32.eq (struct.get (array.load expressions index) kind) module_binding_key_kind)
						(then (set count (i32.inc count))))
					(set index (i32.inc index))))
			(let-mut width 1i32)
			(while
				(:doc "Use a power-of-two bucket table with enough space for ordinary small chains.")
				(bool.and (i32.lt width count) (i32.lt width 536870912i32))
				(body (set width (i32.add width width))))
			(let-mut buckets (array.alloc Bucket width))
			(let-mut candidates (array.alloc Candidate count))
			(set index 0i32)
			(while
				(:doc "Place Wove definitions into their generated-role buckets.")
				(i32.lt index function_count)
				(body
					(let function (array.load functions index))
					(call link_candidate (borrow-mut buckets) (borrow-mut candidates) index
						(call base_candidate (array.load nodes (struct.get function name))
							(struct.get function name) function_candidate
							(struct.get function identity)))
					(set index (i32.inc index))))
			(set index 0i32)
			(while
				(:doc "Only concrete Wove nominal layouts use the generated record role.")
				(i32.lt index record_count)
				(body
					(let record (array.load records index))
					(if
						(:doc "Native layouts have a header spelling and anonymous layouts already have unique rows.")
						(bool.and (i32.gtz (struct.get record name))
							(bool.and (i32.not-gtz (struct.get record native)) (bool.not (call is_generic_template record))))
						(then (call link_candidate (borrow-mut buckets) (borrow-mut candidates)
							(i32.add function_count index)
							(call base_candidate (array.load nodes (struct.get record name))
								(struct.get record name) record_candidate
								(struct.get record identity)))))
					(set index (i32.inc index))))
			(let-mut binding binding_start)
			(set index 0i32)
			(while
				(:doc "Index each binding's complete descriptor name. With a fixed suffix, each role's FNV-1a continuation is bijective, so the backing name has the same collision group.")
				(i32.lt index (array.len expressions))
				(body
					(let key (array.load expressions index))
					(if
						(:doc "Only reserved defining-name rows describe generated module storage.")
						(u32.eq (struct.get key kind) module_binding_key_kind)
						(then
							(let name (array.load nodes index))
							(let identity (call child_identity (borrow-shared arena) (struct.get name start)
								(struct.get name end) (call module_binding_identity key) module_data_role))
							(call link_candidate (borrow-mut buckets) (borrow-mut candidates) binding
								(call base_candidate name index binding_candidate identity))
							(set binding (i32.inc binding))))
					(set index (i32.inc index))))
			(set index 0i32)
			(while
				(:doc "Give all references to an affected definition the same assigned rank.")
				(i32.lt index count)
				(body
					(let name (array.load candidates index))
					(if
						(:doc "Skipped rows do not participate in the spelling comparison.")
						(u32.gtz (struct.get name role))
						(then
							(let head (struct.get (array.load buckets (call bucket (struct.get name fingerprint) width)) head))
							(let rank (call collision_rank (borrow-shared arena) (borrow-shared files)
								(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
								(borrow-shared functions) (borrow-shared instances) first_instance
								function_count (borrow-shared expressions) (borrow-shared candidates) index head))
							(if
								(:doc "An unchanged definition keeps the normal generated spelling.")
								(i32.gtz rank)
								(then
									(if
										(:doc "Update only the emission field, leaving all checked rows and fingerprints intact.")
										(i32.lt index function_count)
										(then
											(array.store functions index
												(call function_with_c_name_slot (array.load functions index) rank)))
										(else
											(if
												(:doc "Record type rows precede defining module name rows.")
												(i32.lt index binding_start)
												(then
													(let row (i32.sub index function_count))
													(array.store records row
														(call record_with_c_name_slot (array.load records row) rank)))
												(else
													(let row (struct.get name name))
													(let key (array.load expressions row))
													(array.store expressions row
														(call module_binding_key (call module_binding_identity key) (struct.get key first) rank))))))))))
					(set index (i32.inc index))))))
)
