(module emit_owned_aggregates
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit nominal transfer and destruction helpers for owning Wove aggregates.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/array_growth.wove" (only (value array_push_kind) (value array_remove_kind)))
	(use wove-file "../scalar/records.wove" (only is_fixed_array is_payload_enum is_array_owner is_owning_record is_owning_struct_element array_owner_element slice_element_type record_index
		member_value_type (type ScalarRecord)))
	(use wove-file "./enums.wove" (only write_enum_ordinal))
	(use wove-file "../scalar/worker.wove" (only worker_collection_record))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "./owners.wove" (only write_native_destructor))
	(use wove-file "./owned_fields.wove" (only write_owner_slot))
	(use wove-file "./records.wove" (only write_member_name write_record_name))
	(use wove-file "./runtime.wove" (only open_array_drop write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name))

	(let take_prefix "wvrt_take_")
	(let drop_prefix "wvrt_drop_")
	(let c_static_inline "static inline __attribute__((unused)) ")
	(let c_static_drop "static inline __attribute__((unused)) void ")
	(let c_owner_param "*wvrt_value){")
	(let c_capture " wvrt_taken=*wvrt_value;")
	(let c_clear_enum "wvrt_value->wvrt_tag=-1;")
	(let c_clear_record "*wvrt_value=(")
	(let c_clear_zero "){0};")
	(let c_return_take "return wvrt_taken;}\n")
	(let c_enum_drop_switch "switch(wvrt_value->wvrt_tag){")
	(let c_enum_payload "wvrt_value->wvrt_payload.")
	(let c_owner_field "wvrt_value->")
	(let c_case "case ")
	(let c_break "break;")
	(let c_owner_close "}\n")
	(let c_arg_address "(&")
	(let c_drop_end ");")
	(struct OwnedMember (fields (type u32) (ordinal i32)))

	(fn write_owner_helper_name
		(:doc "Derive a unique helper symbol from the exact nominal type and operation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "The runtime namespace keeps helper names distinct from Wove type names.")
				(local take)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local take_prefix))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local drop_prefix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))

	(fn open_owner_helper
		(:doc "Open a helper call or definition with its operation and exact type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(local take) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local function) 40u8 (local writing)))))

	(fn write_aggregate_take
		(:doc "Move an exact aggregate through its original local or projected slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool true) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let argument (call c_literal_text (borrow-shared (local c_arg_address)) (borrow-mut (local output)) (local function) (local writing)))
			(let place (call write_owner_slot (borrow-shared (local source)) (borrow-shared (local nodes)) (local row)
				(borrow-shared (local parameters)) (borrow-shared (local expressions)) (local tree_base)
				(borrow-mut (local output)) (local argument) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local place) 41u8 (local writing)))))

	(fn write_aggregate_drop
		(:doc "Drop an owning aggregate at the end of its named local's lifetime.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(target i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool false) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let argument (call c_literal_text (borrow-shared (local c_arg_address)) (borrow-mut (local output)) (local function) (local writing)))
			(let place (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local target) (local tree_base) (borrow-mut (local output)) (local argument) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_drop_end))
				(borrow-mut (local output)) (local place) (local writing)))))

	(let c_native_member_if "if(wvrt_value->")
	(let c_native_member_close ")(void)")
	(let c_native_member_arg "(wvrt_value->")

	(fn write_native_member_drop
		(:doc "Destroy a present C handle in place and skip a null or moved member.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32) (ordinal i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local c_native_member_if))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let condition (call write_member_name (borrow-shared (local source)) (local ordinal)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let discard (call c_literal_text (borrow-shared (local c_native_member_close))
				(borrow-mut (local output)) (local condition) (local writing)))
			(let drop (call write_native_destructor (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)
				(borrow-mut (local output)) (local discard) (local writing)))
			(let open_arg (call c_literal_text (borrow-shared (local c_native_member_arg))
				(borrow-mut (local output)) (local drop) (local writing)))
			(let member (call write_member_name (borrow-shared (local source)) (local ordinal)
				(borrow-mut (local output)) (local open_arg) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_drop_end))
				(borrow-mut (local output)) (local member) (local writing)))))

	(fn write_member_drop
		(:doc "Drop a checked owning member through the array runtime or its nominal destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (ordinal i32) (payload bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A native owner uses the destructor of its defining C declaration.")
				(call is_native_owner (local type))
				(then (return (call write_native_member_drop (borrow-shared (local source)) (borrow-shared (local nodes))
					(local type) (local ordinal) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let-mut cursor (local offset))
			(if
				(:doc "An aggregate helper takes the address of the original inline member.")
				(call is_array_owner (local type))
				(then (set (local cursor) (call open_array_drop (borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(set (local cursor) (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local records) (call record_index (local type))) (bool false)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
			(if
				(:doc "An active enum arm's storage is under the payload union.")
				(local payload)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local c_enum_payload))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local c_owner_field))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(let member (call write_member_name (borrow-shared (local source)) (local ordinal)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local c_drop_end))
				(borrow-mut (local output)) (local member) (local writing)))))

	(fn write_record_destructor_body
		(:doc "Drop the remaining array owners and owning structs in reverse field declaration order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut owned (array.alloc OwnedMember (struct.get (local layout) count)))
			(let-mut field (struct.get (local layout) first))
			(let-mut ordinal 0i32)
			(let-mut count 0i32)
			(while
				(:doc "Retain each owning member's exact type and declaration ordinal.")
				(i32.not-ltz (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
					(if
						(:doc "Copyable fields have no cleanup operation.")
						(bool.or (call is_native_owner (local type))
							(bool.or (call is_array_owner (local type)) (call is_owning_record (borrow-shared (local records)) (local type))))
						(then
							(array.store (local owned) (local count) (struct.new OwnedMember (type (local type)) (ordinal (local ordinal))))
							(set (local count) (i32.inc (local count)))))
					(set (local ordinal) (i32.inc (local ordinal)))
					(set (local field) (struct.get (local member) next_sibling))))
			(let-mut cursor (local offset))
			(while
				(:doc "Moved fields are zeroed. The same destructor releases only the owners still present.")
				(i32.gtz (local count))
				(body
					(set (local count) (i32.dec (local count)))
					(let member (array.load (local owned) (local count)))
					(set (local cursor) (call write_member_drop (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (struct.get (local member) type) (struct.get (local member) ordinal) (bool false)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (local cursor))))

	(fn write_enum_destructor_body
		(:doc "Dispatch cleanup on the active owning variant and leave all other union members untouched.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local c_enum_drop_switch))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let-mut member (struct.get (local layout) first))
			(let-mut ordinal 0i32)
			(while
				(:doc "Write one branch for each variant with an owning payload.")
				(i32.lt -1i32 (local member))
				(body
					(let variant (array.load (local nodes) (local member)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local variant)))
					(if
						(:doc "Only an active owner can name a member of the union.")
						(bool.or (call is_array_owner (local type)) (call is_owning_record (borrow-shared (local records)) (local type)))
						(then
							(let label (call c_literal_text (borrow-shared (local c_case))
								(borrow-mut (local output)) (local cursor) (local writing)))
							(let number (call write_enum_ordinal (local ordinal) (borrow-mut (local output)) (local label) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local number) 58u8 (local writing)))
							(let close (call write_member_drop (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (local type) (local ordinal) (bool true)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call c_literal_text (borrow-shared (local c_break))
								(borrow-mut (local output)) (local close) (local writing)))))
					(set (local ordinal) (i32.inc (local ordinal)))
					(set (local member) (struct.get (local variant) next_sibling))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))))

	(fn write_take_helper
		(:doc "Define a transfer that captures a value and clears its original owner state.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared (local c_static_inline)) (borrow-mut (local output)) (local offset) (local writing)))
			(let result (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local prefix) (local name_prefix) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local result) 32u8 (local writing)))
			(let open (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool true) (borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
			(let argument (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let body (call c_literal_text (borrow-shared (local c_owner_param)) (borrow-mut (local output)) (local argument) (local writing)))
			(let type (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local body) (local name_prefix) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_capture)) (borrow-mut (local output)) (local type) (local writing)))
			(if
				(:doc "The moved tag has no active payload. Ordinary records clear their pointer slots with typed zero initialization.")
				(call is_payload_enum (local layout))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local c_clear_enum))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(let cast (call c_literal_text (borrow-shared (local c_clear_record)) (borrow-mut (local output)) (local cursor) (local writing)))
					(let name (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
						(borrow-mut (local output)) (local cast) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_clear_zero))
						(borrow-mut (local output)) (local name) (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_return_take))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(let empty_fixed_drop "(void)wvrt_value;")
	(let fixed_drop_begin "for(int32_t wvrt_i=")
	(let fixed_drop_test ";wvrt_i>0;){--wvrt_i;if(wvrt_value->wvrt_items[wvrt_i].wvrt_live){")
	(let fixed_slot_value "wvrt_value->wvrt_items[wvrt_i].wvrt_value);}}")

	(fn write_fixed_destructor_body
		(:doc "Drop the live elements of a fixed owner in reverse order, skipping taken slots.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let extent (struct.get (local layout) count))
			(if
				(:doc "An empty layout contains no owner to destroy.")
				(i32.eqz (local extent))
				(then (return (call c_literal_text (borrow-shared (local empty_fixed_drop))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(let loop (call c_literal_text (borrow-shared (local fixed_drop_begin))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let count (call write_c_number (borrow-mut (local output)) (local loop) (local extent) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local fixed_drop_test))
				(borrow-mut (local output)) (local count) (local writing)))
			(let element (u32.from-i32 (struct.get (local layout) first)))
			(if
				(:doc "Owned arrays drop their descriptors; inline owners drop through their exact helper.")
				(call is_array_owner (local element))
				(then (set (local cursor) (call open_array_drop (borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(set (local cursor) (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local records) (call record_index (local element))) (bool false)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
			(return (call c_literal_text (borrow-shared (local fixed_slot_value))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_drop_helper
		(:doc "Define the nominal destructor over the actual record fields or tagged union.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let declaration (call c_literal_text (borrow-shared (local c_static_drop))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let open (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool false) (borrow-mut (local output)) (local declaration) (local name_prefix) (local writing)))
			(let type (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_owner_param))
				(borrow-mut (local output)) (local type) (local writing)))
			(if
				(:doc "Fixed owners use a counted destructor over live inline slots.")
				(call is_fixed_array (local layout))
				(then
					(let body (call write_fixed_destructor_body (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local layout) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(return (call c_literal_text (borrow-shared (local c_owner_close))
						(borrow-mut (local output)) (local body) (local writing)))))
			(if
				(:doc "Only a tagged layout needs to branch before accessing owning storage.")
				(call is_payload_enum (local layout))
				(then (set (local cursor) (call write_enum_destructor_body (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
				(else (set (local cursor) (call write_record_destructor_body (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_owner_close))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(let slot_prefix "wvrt_slot_")
	(let slot_definition "WVRT_DEFINE_OWNED_SLOT(")
	(let slot_definition_end ")\n")

	(fn write_slot_name
		(:doc "Name the slot for the exact nominal record it contains.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared (local slot_prefix)) (borrow-mut (local output)) (local offset) (local writing)))
			(return (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local prefix) (local name_prefix) (local writing)))))

	(fn open_owned_slot_call
		(:doc "Supply the matching slot type as the first argument to a runtime macro.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (macro (shared-array u8))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local macro)) (borrow-mut (local output)) (local offset) (local writing)))
			(let slot (call write_slot_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local slot) 44u8 (local writing)))))

	(fn write_slot_definition
		(:doc "Define the inline slot and attach the record's nominal destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local slot_definition)) (borrow-mut (local output)) (local offset) (local writing)))
			(let record (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let before_slot (call c_byte (borrow-mut (local output)) (local record) 44u8 (local writing)))
			(let slot (call write_slot_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local before_slot) (local name_prefix) (local writing)))
			(let before_drop (call c_byte (borrow-mut (local output)) (local slot) 44u8 (local writing)))
			(let drop (call write_owner_helper_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool false) (borrow-mut (local output)) (local before_drop) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local slot_definition_end)) (borrow-mut (local output)) (local drop) (local writing)))))

	(fn slot_operation_element
		(:doc "Select the element type only from operations that lower to a typed slot macro.")
		(params (row ScalarExpression) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)))
		(returns u32)
		(body
			(let kind (struct.get (local row) kind))
			(if
				(:doc "Allocation carries the exact owner whose layout becomes the slot layout.")
				(u32.eq (local kind) 41u32)
				(then (return (call array_owner_element (borrow-shared (local records)) (struct.get (local row) type)))))
			(if
				(:doc "Stores and indexed loans use the receiver descriptor's exact element.")
				(bool.or (u32.eq (local kind) 37u32) (u32.eq (local kind) 40u32))
				(then (return (call slice_element_type (borrow-shared (local records))
					(struct.get (array.load (local expressions) (struct.get (local row) first)) type)))))
			(if
				(:doc "An append's operand and a removal's result have the original element type.")
				(u32.eq (local kind) (local array_push_kind))
				(then (return (struct.get (array.load (local expressions) (struct.get (local row) first)) type))))
			(if (u32.eq (local kind) (local array_remove_kind)) (then (return (struct.get (local row) type))))
			(return (call worker_collection_record (local row)))))

	(fn mark_used_slots
		(:doc "Mark wrapped layouts that have a checked array operation in this C unit.")
		(params (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (used (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Checked expression rows include every selected body and its nested operands.")
				(i32.lt (local index) (array.len (local expressions)))
				(body
					(let element (call slot_operation_element (array.load (local expressions) (local index))
						(borrow-shared (local expressions)) (borrow-shared (local records))))
					(if
						(:doc "Only an owning struct requires a wrapped slot representation.")
						(call is_owning_struct_element (borrow-shared (local records)) (local element))
						(then (array.store (local used) (call record_index (local element)) 1u8)))
					(set (local index) (i32.inc (local index)))))))

	(fn write_owning_layout_helpers
		(:doc "Emit ownership helpers after the layouts in dependency order so nested destructors are defined first.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut used (array.alloc u8 (array.len (local records))))
			(call mark_used_slots (borrow-shared (local expressions)) (borrow-shared (local records)) (borrow-mut (local used)))
			(let-mut cursor (local offset))
			(let-mut position 0i32)
			(while
				(:doc "The zeroed record table tail ends its checked emission order.")
				(i32.lt (local position) (array.len (local records)))
				(body
					(let row (array.load (local records) (local position)))
					(if (i32.eqz (struct.get (local row) name)) (then (return (local cursor))))
					(let layout (array.load (local records) (struct.get (local row) emit_row)))
					(if
						(:doc "Copyable layouts need no ownership helpers.")
						(struct.get (local layout) owns_arrays)
						(then
							(let take (call write_take_helper (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call write_drop_helper (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
								(borrow-mut (local output)) (local take) (local name_prefix) (local writing)))
							(if
								(:doc "Emit a slot wrapper only for a record used by a lowered array operation.")
								(u8.eq (array.load (local used) (struct.get (local row) emit_row)) 1u8)
								(then (set (local cursor) (call write_slot_definition (borrow-shared (local source))
									(borrow-shared (local nodes)) (local layout) (borrow-mut (local output))
									(local cursor) (local name_prefix) (local writing)))))))
					(set (local position) (i32.inc (local position)))))
			(return (local cursor)))))
