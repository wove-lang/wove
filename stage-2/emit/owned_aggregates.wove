(module emit_owned_aggregates
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit nominal transfer and destruction helpers for owning Wove aggregates.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../scalar/records.wove" (only is_payload_enum is_array_owner is_owning_record record_index
		member_value_type (type ScalarRecord)))
	(use wove-file "./enums.wove" (only write_enum_ordinal))
	(use wove-file "./owned_fields.wove" (only write_record_destructor_body))
	(use wove-file "./records.wove" (only write_member_name write_record_name))
	(use wove-file "./runtime.wove" (only open_array_drop))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name))

	(let take_prefix "wvrt_take_")
	(let drop_prefix "wvrt_drop_")
	(let c_static_inline "static inline __attribute__((unused)) ")
	(let c_static_drop "static inline __attribute__((unused)) void ")
	(let c_owner_param "*wvrt_value){")
	(let c_capture " wvrt_taken=*wvrt_value;")
	(let c_clear_enum "wvrt_value->wvrt_tag=-1;")
	(let c_clear_record "*wvrt_value=(")
	(let c_clear_zero "){0};")
	(let c_return_take "return wvrt_taken;}\n")
	(let c_enum_drop_switch "switch(wvrt_value->wvrt_tag){")
	(let c_enum_payload "wvrt_value->wvrt_payload.")
	(let c_case "case ")
	(let c_break "break;")
	(let c_owner_close "}\n")
	(let c_arg_address "(&")
	(let c_drop_end ");")

	(fn write_owner_helper_name
		(:doc "Derive a unique helper symbol from the exact nominal type and operation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "The runtime namespace keeps helper names distinct from Wove type names.")
				(local take)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local take_prefix))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local drop_prefix))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))

	(fn open_owner_helper
		(:doc "Open a helper call or definition with its operation and exact type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(local take) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local function) 40u8 (local writing)))))

	(fn write_aggregate_operation
		(:doc "Take or drop the exact owning value through its original named slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(target i32) (tree_base i32) (take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(local take) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let argument (call c_literal_text (borrow-shared (local c_arg_address)) (borrow-mut (local output)) (local function) (local writing)))
			(let place (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local target) (local tree_base) (borrow-mut (local output)) (local argument) (local name_prefix) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local place) 41u8 (local writing)))
			(if (local take) (then (return (local close))))
			(return (call c_byte (borrow-mut (local output)) (local close) 59u8 (local writing)))))

	(fn write_enum_destructor_body
		(:doc "Dispatch cleanup on the active owning variant and leave all other union members untouched.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local c_enum_drop_switch))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let-mut member (struct.get (local layout) first))
			(let-mut ordinal 0i32)
			(while
				(:doc "Write one branch for each variant with an owning payload.")
				(i32.lt -1i32 (local member))
				(body
					(let variant (array.load (local nodes) (local member)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local variant)))
					(let array (call is_array_owner (local type)))
					(if
						(:doc "Only an active owner can name a member of the union.")
						(bool.or (local array) (call is_owning_record (borrow-shared (local records)) (local type)))
						(then
							(let label (call c_literal_text (borrow-shared (local c_case))
								(borrow-mut (local output)) (local cursor) (local writing)))
							(let number (call write_enum_ordinal (local ordinal) (borrow-mut (local output)) (local label) (local writing)))
							(set (local cursor) (call c_byte (borrow-mut (local output)) (local number) 58u8 (local writing)))
							(if
								(:doc "Arrays use the runtime destructor and aggregates use their defining helper.")
								(local array)
								(then (set (local cursor) (call open_array_drop (borrow-mut (local output)) (local cursor) (local writing))))
								(else
									(set (local cursor) (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes))
										(array.load (local records) (call record_index (local type))) (bool false)
										(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
									(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
							(let place (call c_literal_text (borrow-shared (local c_enum_payload))
								(borrow-mut (local output)) (local cursor) (local writing)))
							(let field (call write_member_name (borrow-shared (local source)) (local ordinal)
								(borrow-mut (local output)) (local place) (local name_prefix) (local writing)))
							(let close (call c_literal_text (borrow-shared (local c_drop_end))
								(borrow-mut (local output)) (local field) (local writing)))
							(set (local cursor) (call c_literal_text (borrow-shared (local c_break))
								(borrow-mut (local output)) (local close) (local writing)))))
					(set (local ordinal) (i32.add.wrapping (local ordinal) 1i32))
					(set (local member) (struct.get (local variant) next_sibling))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))))

	(fn write_take_helper
		(:doc "Define a transfer that captures a value and clears its original owner state.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared (local c_static_inline)) (borrow-mut (local output)) (local offset) (local writing)))
			(let result (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local prefix) (local name_prefix) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local result) 32u8 (local writing)))
			(let open (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool true) (borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
			(let argument (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let body (call c_literal_text (borrow-shared (local c_owner_param)) (borrow-mut (local output)) (local argument) (local writing)))
			(let type (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local body) (local name_prefix) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_capture)) (borrow-mut (local output)) (local type) (local writing)))
			(if
				(:doc "The moved tag has no active payload. Ordinary records clear their pointer slots with typed zero initialization.")
				(call is_payload_enum (local layout))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local c_clear_enum))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else
					(let cast (call c_literal_text (borrow-shared (local c_clear_record)) (borrow-mut (local output)) (local cursor) (local writing)))
					(let name (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
						(borrow-mut (local output)) (local cast) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local c_clear_zero))
						(borrow-mut (local output)) (local name) (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_return_take))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_drop_helper
		(:doc "Define the nominal destructor over the actual record fields or tagged union.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let declaration (call c_literal_text (borrow-shared (local c_static_drop))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let open (call open_owner_helper (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(bool false) (borrow-mut (local output)) (local declaration) (local name_prefix) (local writing)))
			(let type (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local c_owner_param))
				(borrow-mut (local output)) (local type) (local writing)))
			(if
				(:doc "Only a tagged layout needs to branch before accessing owning storage.")
				(call is_payload_enum (local layout))
				(then (set (local cursor) (call write_enum_destructor_body (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
				(else (set (local cursor) (call write_record_destructor_body (borrow-shared (local source)) (borrow-shared (local nodes))
					(local layout) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (call c_literal_text (borrow-shared (local c_owner_close))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_owning_layout_helpers
		(:doc "Emit ownership helpers after the layouts in dependency order so nested destructors are defined first.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut position 0i32)
			(while
				(:doc "The zeroed record table tail ends its checked emission order.")
				(i32.lt (local position) (array.len (local records)))
				(body
					(let row (array.load (local records) (local position)))
					(if (i32.eq (struct.get (local row) name) 0i32) (then (return (local cursor))))
					(let layout (array.load (local records) (struct.get (local row) emit_row)))
					(if
						(:doc "Copyable layouts need no ownership helpers.")
						(struct.get (local layout) owns_arrays)
						(then
							(let take (call write_take_helper (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local cursor) (call write_drop_helper (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout)
								(borrow-mut (local output)) (local take) (local name_prefix) (local writing)))))
					(set (local position) (i32.add.wrapping (local position) 1i32))))
			(return (local cursor)))))
