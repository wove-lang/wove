(module emit_owned_aggregates
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit nominal transfer, validation, and destruction helpers for owning Wove aggregates.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/array_growth.wove" (only (value array_push_kind) (value array_try_push_kind) (value array_remove_kind)))
	(use wove-file "../scalar/records.wove" (only is_fixed_array is_payload_enum is_array_owner is_owning_record is_owning_array_element array_owner_element slice_element_type record_index
		member_value_type (type ScalarRecord)))
	(use wove-file "./enums.wove" (only write_enum_ordinal))
	(use wove-file "../scalar/worker.wove" (only worker_collection_record))
	(use wove-file "../scalar/syntax.wove" (only (value fixed_subarray_place) (value fixed_owner_take)))
	(use wove-file "../scalar/loans.wove" (only (value inline_owner_argument_guard) (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "./owner_checks.wove" (only has_owner_check mark_owner_check write_owner_check))
	(use wove-file "./owners.wove" (only write_native_destructor))
	(use wove-file "./owned_fields.wove" (only write_owner_slot))
	(use wove-file "./members.wove" (only write_member named_member (type CMember)))
	(use wove-file "./records.wove" (only write_layout_role_name write_record_name))
	(use wove-file "./runtime.wove" (only open_array_drop write_c_number))
	(use wove-file "./names.wove" (only (value owner_take_role) (value owner_drop_role)
		(value heap_slot_role) (value heap_slot_drop_role)))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name))

	(let c_static_inline "static inline __attribute__((unused)) ")
	(let c_static_drop "static inline __attribute__((unused)) void ")
	(let c_owner_param "*wvrt_value){")
	(let c_capture " wvrt_taken=*wvrt_value;")
	(let c_clear_enum "wvrt_value->wvrt_tag=-1;")
	(let c_clear_record "*wvrt_value=(")
	(let c_clear_zero "){0};")
	(let c_return_take "return wvrt_taken;}\n")
	(let c_enum_drop_switch "switch(wvrt_value->wvrt_tag){")
	(let c_enum_payload "wvrt_value->wvrt_payload.")
	(let c_owner_field "wvrt_value->")
	(let c_case "case ")
	(let c_break "break;")
	(let c_owner_close "}\n")
	(let c_arg_address "(&")
	(let c_drop_end ");")
	(struct OwnedMember (fields (type u32) (field i32)))

	(fn write_owner_helper_name
		(:doc "Select the take or drop role for a concrete aggregate.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut tag owner_drop_role)
			(if take (then (set tag owner_take_role)))
			(return (call write_layout_role_name (borrow-shared source) (borrow-shared nodes) layout tag
				(borrow-mut output) offset name_prefix writing))))

	(fn open_owner_helper
		(:doc "Open a helper call or definition with its operation and exact type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(take bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared source) (borrow-shared nodes) layout
				take (borrow-mut output) offset name_prefix writing))
			(return (call c_byte (borrow-mut output) function 40u8 writing))))

	(fn write_aggregate_take
		(:doc "Move an exact aggregate through its original local or projected slot.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (row ScalarExpression)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared source) (borrow-shared nodes) layout
				(bool true) (borrow-mut output) offset name_prefix writing))
			(let argument (call c_literal_text (borrow-shared c_arg_address) (borrow-mut output) function writing))
			(let place (call write_owner_slot (borrow-shared source) (borrow-shared nodes) row
				(borrow-shared parameters) (borrow-shared expressions) (borrow-shared records) tree_base
				(borrow-mut output) argument name_prefix writing))
			(return (call c_byte (borrow-mut output) place 41u8 writing))))

	(fn write_aggregate_drop
		(:doc "Drop an owning aggregate at the end of its named local's lifetime.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(target i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let function (call write_owner_helper_name (borrow-shared source) (borrow-shared nodes) layout
				(bool false) (borrow-mut output) offset name_prefix writing))
			(let argument (call c_literal_text (borrow-shared c_arg_address) (borrow-mut output) function writing))
			(let place (call write_local_name (borrow-shared source) (borrow-shared nodes)
				target tree_base (borrow-mut output) argument name_prefix writing))
			(return (call c_literal_text (borrow-shared c_drop_end)
				(borrow-mut output) place writing))))

	(let c_native_member_if "if(wvrt_value->")
	(let c_native_member_close ")(void)")
	(let c_native_member_arg "(wvrt_value->")

	(fn write_native_member_drop
		(:doc "Destroy a present C handle in place and skip a null or moved member.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32) (name CMember)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared c_native_member_if)
				(borrow-mut output) offset writing))
			(let condition (call write_member (borrow-shared source) name
				(borrow-mut output) open name_prefix writing))
			(let discard (call c_literal_text (borrow-shared c_native_member_close)
				(borrow-mut output) condition writing))
			(let drop (call write_native_destructor (borrow-shared source) (borrow-shared nodes) type
				(borrow-mut output) discard writing))
			(let open_arg (call c_literal_text (borrow-shared c_native_member_arg)
				(borrow-mut output) drop writing))
			(let member (call write_member (borrow-shared source) name
				(borrow-mut output) open_arg name_prefix writing))
			(return (call c_literal_text (borrow-shared c_drop_end)
				(borrow-mut output) member writing))))

	(fn write_member_drop
		(:doc "Drop a checked owning member through the array runtime or its nominal destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (name CMember) (payload bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A native owner uses the destructor of its defining C declaration.")
				(call is_native_owner type)
				(then (return (call write_native_member_drop (borrow-shared source) (borrow-shared nodes)
					type name (borrow-mut output) offset name_prefix writing))))
			(let-mut cursor offset)
			(if
				(:doc "An aggregate helper takes the address of the original inline member.")
				(call is_array_owner type)
				(then (set cursor (call open_array_drop (borrow-mut output) cursor writing)))
				(else
					(set cursor (call open_owner_helper (borrow-shared source) (borrow-shared nodes)
						(records.get (call record_index type)) (bool false)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(if
				(:doc "An active enum arm's storage is under the payload union.")
				payload
				(then (set cursor (call c_literal_text (borrow-shared c_enum_payload)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared c_owner_field)
					(borrow-mut output) cursor writing))))
			(let member (call write_member (borrow-shared source) name
				(borrow-mut output) cursor name_prefix writing))
			(return (call c_literal_text (borrow-shared c_drop_end)
				(borrow-mut output) member writing))))

	(fn write_record_destructor_body
		(:doc "Drop the remaining array owners and owning structs in reverse field declaration order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut owned (array:alloc OwnedMember layout/count))
			(let-mut field layout/first)
			(let-mut count 0i32)
			(while
				(:doc "Retain each owning member's exact type and source field row.")
				field.not-ltz
				(body
					(let member (nodes.get field))
					(let type (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout member))
					(if
						(:doc "Copyable fields have no cleanup operation.")
						(bool:or (call is_native_owner type)
							(bool:or (call is_array_owner type) (call is_owning_record (borrow-shared records) type)))
						(then
							(owned.set count (OwnedMember.new (type type) (field field)))
							(set count count.inc)))
					(set field member/next_sibling)))
			(let-mut cursor offset)
			(while
				(:doc "Moved fields are zeroed. The same destructor releases only the owners still present.")
				count.gtz
				(body
					(set count count.dec)
					(let member (owned.get count))
					(let declaration (nodes.get member/field))
					(let name (call named_member layout
						(nodes.get declaration/first_child)))
					(set cursor (call write_member_drop (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) member/type name (bool false)
						(borrow-mut output) cursor name_prefix writing))))
			(return cursor)))

	(fn write_enum_destructor_body
		(:doc "Dispatch cleanup on the active owning variant and leave all other union members untouched.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared c_enum_drop_switch)
				(borrow-mut output) offset writing))
			(let-mut member layout/first)
			(let-mut ordinal 0i32)
			(while
				(:doc "Write one branch for each variant with an owning payload.")
				(i32:lt -1i32 member)
				(body
					(let variant (nodes.get member))
					(let type (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout variant))
					(if
						(:doc "Only an active owner can name a member of the union.")
						(bool:or (call is_array_owner type) (call is_owning_record (borrow-shared records) type))
						(then
							(let label (call c_literal_text (borrow-shared c_case)
								(borrow-mut output) cursor writing))
							(let number (call write_enum_ordinal ordinal (borrow-mut output) label writing))
							(set cursor (call c_byte (borrow-mut output) number 58u8 writing))
							(let close (call write_member_drop (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) type
								(call named_member layout (nodes.get variant/first_child))
								(bool true)
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call c_literal_text (borrow-shared c_break)
								(borrow-mut output) close writing))))
					(set ordinal ordinal.inc)
					(set member variant/next_sibling)))
			(return (call c_byte (borrow-mut output) cursor 125u8 writing))))

	(fn write_take_helper
		(:doc "Define a transfer that captures a value and clears its original owner state.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared c_static_inline) (borrow-mut output) offset writing))
			(let result (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) prefix name_prefix writing))
			(let space (call c_byte (borrow-mut output) result 32u8 writing))
			(let open (call open_owner_helper (borrow-shared source) (borrow-shared nodes) layout
				(bool true) (borrow-mut output) space name_prefix writing))
			(let argument (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) open name_prefix writing))
			(let body (call c_literal_text (borrow-shared c_owner_param) (borrow-mut output) argument writing))
			(let type (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) body name_prefix writing))
			(let-mut cursor (call c_literal_text (borrow-shared c_capture) (borrow-mut output) type writing))
			(if
				(:doc "The moved tag has no active payload. Ordinary records clear their pointer slots with typed zero initialization.")
				(call is_payload_enum layout)
				(then (set cursor (call c_literal_text (borrow-shared c_clear_enum)
					(borrow-mut output) cursor writing)))
				(else
					(let cast (call c_literal_text (borrow-shared c_clear_record) (borrow-mut output) cursor writing))
					(let name (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
						(borrow-mut output) cast name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared c_clear_zero)
						(borrow-mut output) name writing))))
			(return (call c_literal_text (borrow-shared c_return_take)
				(borrow-mut output) cursor writing))))

	(let empty_fixed_drop "(void)wvrt_value;")
	(let fixed_drop_begin "for(int32_t wvrt_i=")
	(let fixed_drop_test ";wvrt_i>0;){--wvrt_i;if(wvrt_value->wvrt_items[wvrt_i].wvrt_live){")
	(let fixed_slot_value "wvrt_value->wvrt_items[wvrt_i].wvrt_value);}}")

	(fn write_fixed_destructor_body
		(:doc "Drop the live elements of a fixed owner in reverse order, skipping taken slots.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let extent layout/count)
			(if
				(:doc "An empty layout contains no owner to destroy.")
				extent.eqz
				(then (return (call c_literal_text (borrow-shared empty_fixed_drop)
					(borrow-mut output) offset writing))))
			(let loop (call c_literal_text (borrow-shared fixed_drop_begin)
				(borrow-mut output) offset writing))
			(let count (call write_c_number (borrow-mut output) loop extent writing))
			(let-mut cursor (call c_literal_text (borrow-shared fixed_drop_test)
				(borrow-mut output) count writing))
			(let element (u32:from-i32 layout/first))
			(if
				(:doc "Owned arrays drop their descriptors; inline owners drop through their exact helper.")
				(call is_array_owner element)
				(then (set cursor (call open_array_drop (borrow-mut output) cursor writing)))
				(else
					(set cursor (call open_owner_helper (borrow-shared source) (borrow-shared nodes)
						(records.get (call record_index element)) (bool false)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(return (call c_literal_text (borrow-shared fixed_slot_value)
				(borrow-mut output) cursor writing))))

	(fn write_drop_helper
		(:doc "Define the nominal destructor over the actual record fields or tagged union.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let declaration (call c_literal_text (borrow-shared c_static_drop)
				(borrow-mut output) offset writing))
			(let open (call open_owner_helper (borrow-shared source) (borrow-shared nodes) layout
				(bool false) (borrow-mut output) declaration name_prefix writing))
			(let type (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) open name_prefix writing))
			(let-mut cursor (call c_literal_text (borrow-shared c_owner_param)
				(borrow-mut output) type writing))
			(if
				(:doc "Fixed owners use a counted destructor over live inline slots.")
				(call is_fixed_array layout)
				(then
					(let body (call write_fixed_destructor_body (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) layout (borrow-mut output) cursor name_prefix writing))
					(return (call c_literal_text (borrow-shared c_owner_close)
						(borrow-mut output) body writing))))
			(if
				(:doc "Only a tagged layout needs to branch before accessing owning storage.")
				(call is_payload_enum layout)
				(then (set cursor (call write_enum_destructor_body (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) layout
					(borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call write_record_destructor_body (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) layout (borrow-mut output) cursor name_prefix writing))))
			(return (call c_literal_text (borrow-shared c_owner_close)
				(borrow-mut output) cursor writing))))

	(let slot_definition "WVRT_DEFINE_OWNED_SLOT(")
	(let slot_definition_end ")\n")

	(fn open_owned_slot_call
		(:doc "Supply the matching slot type as the first argument to a runtime macro.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (macro (shared-array u8))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared macro) (borrow-mut output) offset writing))
			(let slot (call write_layout_role_name (borrow-shared source) (borrow-shared nodes) layout heap_slot_role
				(borrow-mut output) open name_prefix writing))
			(return (call c_byte (borrow-mut output) slot 44u8 writing))))

	(fn open_owned_slot_drop_call
		(:doc "Supply the slot layout and the erased destructor to an allocating or replacing macro.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(macro (shared-array u8)) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let next (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
				layout (borrow-shared macro) (borrow-mut output) offset name_prefix writing))
			(let drop (call write_layout_role_name (borrow-shared source) (borrow-shared nodes) layout heap_slot_drop_role
				(borrow-mut output) next name_prefix writing))
			(return (call c_byte (borrow-mut output) drop 44u8 writing))))

	(fn write_slot_definition
		(:doc "Define the heap slot and its erased destructor using the exact aggregate drop target.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared slot_definition) (borrow-mut output) offset writing))
			(let record (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) open name_prefix writing))
			(let before_slot (call c_byte (borrow-mut output) record 44u8 writing))
			(let slot (call write_layout_role_name (borrow-shared source) (borrow-shared nodes) layout heap_slot_role
				(borrow-mut output) before_slot name_prefix writing))
			(let before_drop (call c_byte (borrow-mut output) slot 44u8 writing))
			(let erased_drop (call write_layout_role_name (borrow-shared source) (borrow-shared nodes) layout heap_slot_drop_role
				(borrow-mut output) before_drop name_prefix writing))
			(let before_destroy (call c_byte (borrow-mut output) erased_drop 44u8 writing))
			(let drop (call write_owner_helper_name (borrow-shared source) (borrow-shared nodes) layout
				(bool false) (borrow-mut output) before_destroy name_prefix writing))
			(return (call c_literal_text (borrow-shared slot_definition_end) (borrow-mut output) drop writing))))

	(fn slot_operation_element
		(:doc "Select the element type only from operations that lower to a typed slot macro.")
		(params (row ScalarExpression) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord)))
		(returns u32)
		(body
			(let kind row/kind)
			(if
				(:doc "Allocation carries the exact owner whose layout becomes the slot layout.")
				(kind.eq 41u32)
				(then (return (call array_owner_element (borrow-shared records) row/type))))
			(if
				(:doc "Stores, indexed loans, and fixed heap projections use the descriptor's exact element.")
				(bool:or (bool:or (kind.eq 37u32) (kind.eq 40u32))
					(bool:or (kind.eq fixed_subarray_place) (kind.eq fixed_owner_take)))
				(then (return (call slice_element_type (borrow-shared records)
					(struct:get (expressions.get row/first) type)))))
			(if
				(:doc "An append's operand and a removal's result have the original element type.")
				(bool:or (kind.eq array_push_kind) (kind.eq array_try_push_kind))
				(then (return (struct:get (expressions.get row/first) type))))
			(if (kind.eq array_remove_kind) (then (return row/type)))
			(return (call worker_collection_record row))))

	(fn mark_layout_operations
		(:doc "Mark exact wrapped slots and validators needed by checked body operations.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression)) (used (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Checked expression rows include every selected body and its nested operands.")
				(index.lt expressions.len)
				(body
					(let row (expressions.get index))
					(let element (call slot_operation_element row
						(borrow-shared expressions) (borrow-shared records)))
					(if
						(:doc "Only owning aggregate elements require a wrapped slot representation.")
						(call is_owning_array_element (borrow-shared records) element)
						(then
							(let layout (call record_index element))
							(let flags (u32:from-u8 (used.get layout)))
							(used.set layout (u8:from-u32 (flags.or 1u32)))))
					(if
						(:doc "A guarded argument needs its validator and those of its inline children.")
						(row/extent_check.eq inline_owner_argument_guard)
						(then (call mark_owner_check (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (borrow-shared bindings)
							row/type (borrow-mut used))))
					(set index index.inc)))))

	(fn write_owning_layout_helpers
		(:doc "Emit ownership helpers after the layouts in dependency order so nested destructors are defined first.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut used (array:alloc u8 records.len))
			(call mark_layout_operations (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared bindings) (borrow-shared expressions) (borrow-mut used))
			(let-mut cursor offset)
			(let-mut position 0i32)
			(while
				(:doc "The zeroed record table tail ends its checked emission order.")
				(position.lt records.len)
				(body
					(let row (records.get position))
					(if row/name.eqz (then (return cursor)))
					(let layout (records.get row/emit_row))
					(let flags (used.get row/emit_row))
					(if
						(:doc "Copyable layouts need no ownership helpers.")
						layout/owns_arrays
						(then
							(let take (call write_take_helper (borrow-shared source) (borrow-shared nodes) layout
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call write_drop_helper (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings) layout
								(borrow-mut output) take name_prefix writing))
							(if
								(:doc "Emit a slot wrapper only for a record used by a lowered array operation.")
								(u32:not-eqz (u32:and (u32:from-u8 flags) 1u32))
								(then (set cursor (call write_slot_definition (borrow-shared source)
									(borrow-shared nodes) layout (borrow-mut output)
									cursor name_prefix writing))))
							(if
								(:doc "Only layouts used by a guarded argument need completeness checks.")
								(call has_owner_check flags)
								(then (set cursor (call write_owner_check (borrow-shared source) (borrow-shared nodes)
									(borrow-shared records) (borrow-shared bindings) layout
									(borrow-mut output) cursor name_prefix writing))))))
					(set position position.inc)))
			(return cursor))))
