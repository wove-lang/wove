(module emit_test_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit the native dispatch table in the resolved inventory order.

	The original file and declaration identify each checked test body. The
	runtime entry can execute one test or launch the complete inventory.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/plan.wove" (only find_defining_function (type ScalarFunction)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "./c.wove" (only write_function_name))
	(use wove-file "./text.wove" (only c_byte c_hex_byte c_include_prefix))

	(fn write_test_label
		(:doc `Quote exact label bytes with fixed hexadecimal escapes in the generated C string.`)
		(params (arena (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut (local output)) (local offset) 34u8 (local writing)))
			(let-mut index (local start))
			(while
				(:doc "Every byte starts a new escape, so adjacent hex digits cannot merge.")
				(i32.lt (local index) (local end))
				(body
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 92u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 120u8 (local writing)))
					(set (local cursor) (call c_hex_byte (array.load (local arena) (local index))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))))

	(fn write_test_row
		(:doc `Bind the defining file and original test name to the checked C function.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(input SuppliedFile) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load (local nodes) (struct.get (local function) name)))
			(let open (call c_byte (borrow-mut (local output)) (local offset) 123u8 (local writing)))
			(let path (call write_test_label (borrow-shared (local arena)) (struct.get (local input) path_start)
				(struct.get (local input) path_end) (borrow-mut (local output)) (local open) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local path) 44u8 (local writing)))
			(let label (call write_test_label (borrow-shared (local arena)) (struct.get (local name) start)
				(struct.get (local name) end) (borrow-mut (local output)) (local comma) (local writing)))
			(let target (call c_byte (borrow-mut (local output)) (local label) 44u8 (local writing)))
			(let symbol (call write_function_name (borrow-shared (local arena)) (borrow-shared (local nodes)) (local function)
				(borrow-mut (local output)) (local target) (local name_prefix) (local writing)))
			(let end (call c_byte (borrow-mut (local output)) (local symbol) 125u8 (local writing)))
			(let separator (call c_byte (borrow-mut (local output)) (local end) 44u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local separator) 10u8 (local writing)))))

	(fn write_test_entry
		(:doc `Append the runtime entry and one row per discovered test to the measured C unit.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (tests (shared-array DiscoveredTest)) (count i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_include_prefix (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 119u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 118u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 101u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 46u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 104u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 34u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 87u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 86u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 82u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 69u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 83u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 66u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 69u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 71u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 73u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 78u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))
			(let-mut index 0i32)
			(while
				(:doc "Discovery and planning share one resolved graph, so each test has a defining function row.")
				(i32.lt (local index) (local count))
				(body
					(let test (array.load (local tests) (local index)))
					(let file (struct.get (local test) file))
					(let target (call find_defining_function (borrow-shared (local functions)) (local file)
						(struct.get (local test) declaration)))
					(set (local cursor) (call write_test_row (borrow-shared (local arena)) (borrow-shared (local nodes))
						(array.load (local functions) (local target)) (array.load (local files) (local file))
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 87u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 86u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 82u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 69u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 83u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 84u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 95u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 69u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 78u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 68u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing))))))
