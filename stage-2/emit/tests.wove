(module emit_test_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit the native dispatch table in the resolved inventory order.

	The original file and declaration identify each checked test body. The
	runtime entry can execute one test or launch the complete inventory.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/function_rows.wove" (only find_defining_function (type ScalarFunction)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "./function_names.wove" (only write_function_name))
	(use wove-file "./text.wove" (only c_byte c_hex_byte c_include_prefix))

	(fn write_test_label
		(:doc `Quote exact label bytes with fixed hexadecimal escapes in the generated C string.`)
		(params (arena (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_byte (borrow-mut output) offset 34u8 writing))
			(let-mut index start)
			(while
				(:doc "Every byte starts a new escape, so adjacent hex digits cannot merge.")
				(i32:lt index end)
				(body
					(set cursor (call c_byte (borrow-mut output) cursor 92u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 120u8 writing))
					(set cursor (call c_hex_byte (arena.get index)
						(borrow-mut output) cursor writing))
					(set index (i32:inc index))))
			(return (call c_byte (borrow-mut output) cursor 34u8 writing))))

	(fn write_test_row
		(:doc `Bind the defining file and original test name to the checked C function.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(input SuppliedFile) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (nodes.get (function.get name)))
			(let open (call c_byte (borrow-mut output) offset 123u8 writing))
			(let path (call write_test_label (borrow-shared arena) (input.get path_start)
				(input.get path_end) (borrow-mut output) open writing))
			(let comma (call c_byte (borrow-mut output) path 44u8 writing))
			(let label (call write_test_label (borrow-shared arena) (name.get start)
				(name.get end) (borrow-mut output) comma writing))
			(let target (call c_byte (borrow-mut output) label 44u8 writing))
			(let symbol (call write_function_name (borrow-shared arena) (borrow-shared nodes) function
				(borrow-mut output) target name_prefix writing))
			(let end (call c_byte (borrow-mut output) symbol 125u8 writing))
			(let separator (call c_byte (borrow-mut output) end 44u8 writing))
			(return (call c_byte (borrow-mut output) separator 10u8 writing))))

	(fn write_test_entry
		(:doc `Append the runtime entry and one row per discovered test to the measured C unit.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (tests (shared-array DiscoveredTest)) (count i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_include_prefix (borrow-mut output) offset writing))
			(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 119u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 118u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 101u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 46u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 104u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 34u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 87u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 86u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 82u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 69u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 83u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 66u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 69u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 71u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 73u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 78u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))
			(let-mut index 0i32)
			(while
				(:doc "Discovery and planning share one resolved graph, so each test has a defining function row.")
				(i32:lt index count)
				(body
					(let test (tests.get index))
					(let file (test.get file))
					(let target (call find_defining_function (borrow-shared functions) file
						(test.get declaration)))
					(set cursor (call write_test_row (borrow-shared arena) (borrow-shared nodes)
						(functions.get target) (files.get file)
						(borrow-mut output) cursor name_prefix writing))
					(set index (i32:inc index))))
			(set cursor (call c_byte (borrow-mut output) cursor 87u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 86u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 82u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 69u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 83u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 84u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 95u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 69u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 78u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 68u8 writing))
			(return (call c_byte (borrow-mut output) cursor 10u8 writing)))))
