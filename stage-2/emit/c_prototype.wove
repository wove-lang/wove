(module emit_c_prototype
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Verify variadic, pointer-out, and fixed-operand declarations against the included C prototypes.

	The check uses the adapted C types of the fixed prefix and admits
	compatible byte pointers for bounded views. Clang's transparent unions
	match each byte pointer independently inside one function type. Calls use
	the header declaration and keep the tail values in typed temporaries for
	the selected target's default argument promotions.`)

	(use wove-file "../scalar/callback_types.wove" (only is_adapted_callback))
	(use wove-file "./c_callbacks.wove" (only write_callback_pointer_type))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./runtime.wove" (only write_c_number write_site_number))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/c_formals.wove" (only is_c_fixed_formal c_fixed_formal_at))
	(use wove-file "./c_formals.wove" (only write_fixed_c_type native_long_double_needs_prototype))
	(use wove-file "../c/arguments.wove" (only (value c_static_string_mode) is_c_string_mode is_c_bytes_mode is_c_null_mode is_c_array_mode is_c_vector_mode
			is_c_storage_mode c_storage_shared_mode is_c_handle_init_mode (value c_void_pointer_mode) (value c_shared_handle_slot_mode)
			(value c_marked_handle_out_mode) (value c_owner_marker_flag_mode)))
	(use wove-file "../scalar/function_rows.wove" (only is_record_out_status is_record_input_hidden (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./c_record_snapshots.wove" (only write_record_snapshot_native_type))
	(use wove-file "../scalar/records.wove" (only is_optional_record_borrow optional_record_borrow_reference is_mutable_place_reference (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./c_extents.wove" (only write_c_array_pointer_type))
	(use wove-file "./c_vectors.wove" (only (value vector_type)))
	(use wove-file "./c_storage.wove" (only write_storage_pointer_type))
	(use wove-file "./c_arguments.wove" (only c_symbol_text))
	(use wove-file "./c_formals.wove" (only native_static_strings native_sync_callbacks))
	(use wove-file "./text.wove" (only c_byte c_literal_text))

	(let check_open "_Static_assert(_Generic(&(")
	(let after_name "),")
	(let before_formals "(*)(")
	(let no_formals "void")
	(let variadic_check_close "...):1,default:0),\"Wove C variadic prototype does not match its declared fixed prefix and result\");\n")
	(let handle_check_open "):1,default:0),\"Wove C pointer-out prototype does not match its declared signature at file ")
	(let fixed_check_open "):1,default:0),\"Wove C fixed-operand prototype does not match its declared signature at file ")
	(let owner_check_open "):1,default:0),\"Wove C cross-header owner prototype does not match its declared signature at file ")
	(let long_double_check_open "):1,default:0),\"Wove C long double prototype does not match its declared signature at file ")
	(let storage_check_open "):1,default:0),\"Wove C native storage prototype does not match its declared signature at file ")
	(let record_scratch_type "char*")
	(let borrow_check_open "):1,default:0),\"Wove C borrowed record prototype does not match its declared signature at file ")
	(let void_pointer_check_open "):1,default:0),\"Wove C void pointer prototype does not match its declared signature at file ")
	(let callback_check_open "):1,default:0),\"Wove C synchronous callback prototype does not match its declared signature at file ")
	(let static_string_check_open "):1,default:0),\"Wove C retained-string prototype does not match its declared signature at file ")
	(let handle_check_bytes " bytes [")
	(let handle_check_close ")\");\n")
	(let string_pointer "const char*")
	(let mut_string_pointer "char*")
	(let shared_void_pointer "const void*")
	(let mutable_void_pointer "void*")
	(let byte_pointer_union "union __attribute__((__transparent_union__)){")
	(let writable_pointer_members
		`void*wvrt_p0;char*wvrt_p1;signed char*wvrt_p2;unsigned char*wvrt_p3;
volatile void*wvrt_p4;volatile char*wvrt_p5;volatile signed char*wvrt_p6;volatile unsigned char*wvrt_p7;`)
	(let readonly_pointer_members
		`const void*wvrt_p8;const char*wvrt_p9;const signed char*wvrt_p10;const unsigned char*wvrt_p11;
const volatile void*wvrt_p12;const volatile char*wvrt_p13;const volatile signed char*wvrt_p14;const volatile unsigned char*wvrt_p15;}`)

	(fn write_byte_pointer_type
		(:doc `Write a transparent union for one fixed byte view.

		The union is used only in the type assertion. Its members preserve the
		view's permitted pointee qualifiers. Generated calls use the declaration
		from the header and pass the original backing pointer.`)
		(params (param ScalarParameter) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared byte_pointer_union)
				(borrow-mut output) offset writing))
			(if
				(:doc "Mutable views and explicit null can satisfy writable byte pointer formals.")
				(bool.or (call is_c_null_mode (struct.get param c_mode)) (u32.eq (struct.get param type) 38u32))
				(then (set cursor (call c_literal_text (borrow-shared writable_pointer_members)
					(borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared readonly_pointer_members)
				(borrow-mut output) cursor writing))))

	(fn write_fixed_parameter_type
		(:doc `Write the C argument type after applying a fixed formal's bridge contract.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(param ScalarParameter) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let mode (struct.get param c_mode))
			(if
				(:doc "The callback adapter uses the checked native signature rather than the Wove receiver types.")
				(call is_adapted_callback mode (struct.get param type))
				(then (return (call write_callback_pointer_type (borrow-shared source) (borrow-shared nodes)
					param (borrow-mut output) offset writing))))
			(if
				(:doc "Use the loan's access mode to qualify the void pointer in the exact native signature.")
				(bool.or (u8.eq mode c_marked_handle_out_mode)
					(bool.or (u8.eq mode c_void_pointer_mode) (u8.eq mode c_shared_handle_slot_mode)))
				(then
					(if
						(:doc "The C callee may write through a mutable loan.")
						(bool.or (u8.eq mode c_marked_handle_out_mode)
							(bool.or (u32.eq (struct.get param type) 38u32)
								(call is_mutable_place_reference (struct.get param type))))
						(then (return (call c_literal_text (borrow-shared mutable_void_pointer)
							(borrow-mut output) offset writing))))
					(return (call c_literal_text (borrow-shared shared_void_pointer)
						(borrow-mut output) offset writing))))
			(if
				(:doc "String preparation passes a pointer to a NUL-terminated byte sequence.")
				(bool.or (call is_c_string_mode mode) (u8.eq mode c_static_string_mode))
				(then
					(if
						(:doc "An exclusive string formal exposes a mutable character pointer.")
						(u32.eq (struct.get param type) 38u32)
						(then (return (call c_literal_text (borrow-shared mut_string_pointer) (borrow-mut output)
							offset writing))))
					(return (call c_literal_text (borrow-shared string_pointer) (borrow-mut output)
						offset writing))))
			(if
				(:doc "String vectors use the same terminated pointer table type as the emitted call.")
				(call is_c_vector_mode mode)
				(then (return (call c_literal_text (borrow-shared vector_type)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The C header can use a compatible byte pointer for a bounded view or explicit null.")
				(bool.or (call is_c_bytes_mode mode) (call is_c_null_mode mode))
				(then (return (call write_byte_pointer_type param
					(borrow-mut output) offset writing))))
			(if
				(:doc "A native array's fixed formal is its exact element pointer.")
				(call is_c_array_mode mode)
				(then (return (call write_c_array_pointer_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (struct.get param type)
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "Storage formals use their native object pointer in the checked C prototype.")
				(call is_c_storage_mode mode)
				(then (return (call write_storage_pointer_type (borrow-shared source) (borrow-shared nodes)
					(struct.get param type) (u8.eq mode (call c_storage_shared_mode))
					(borrow-mut output) offset writing))))
			(let end (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (struct.get param type)
				(borrow-mut output) offset name_prefix writing))
			(if
				(:doc "A pointer-out parameter requires one additional indirection on the original C handle.")
				(call is_c_handle_init_mode mode)
				(then (return (call c_byte (borrow-mut output) end 42u8 writing))))
			(return end)))

	(fn close_c_fixed_prototype
		(:doc "Report a header signature mismatch with the defining Wove declaration's file and byte range.")
		(params (site SourceNode) (function ScalarFunction) (long_double bool) (retained_strings bool) (callback bool)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let base (struct.get function source_base))
			(let-mut open offset)
			(if
				(:doc "The selected header must use the declared callback pointer type.")
				callback
				(then (set open (call c_literal_text (borrow-shared callback_check_open)
					(borrow-mut output) offset writing)))
				(else
					(if
						(:doc "Identify a void pointer qualifier mismatch with its own bridge contract.")
						(struct.get function c_void_pointer)
						(then (set open (call c_literal_text (borrow-shared void_pointer_check_open)
							(borrow-mut output) offset writing)))
						(else
							(if
								(:doc "A nullable record loan has its own native signature diagnostic.")
								(call is_optional_record_borrow (struct.get function result))
								(then (set open (call c_literal_text (borrow-shared borrow_check_open)
									(borrow-mut output) offset writing)))
								(else
									(if
										(:doc "Preserve the established pointer-out diagnostic for those bridges.")
										(struct.get function c_handle_out)
										(then (set open (call c_literal_text (borrow-shared handle_check_open)
											(borrow-mut output) offset writing)))
										(else
											(if
												(:doc "Distinguish a checked cross-header owner from an existing fixed operand.")
												(struct.get function c_fixed)
												(then (set open (call c_literal_text (borrow-shared fixed_check_open)
													(borrow-mut output) offset writing)))
												(else
													(if
														(:doc "A caller-owned native allocation has an exact storage pointer prototype.")
														(struct.get function c_storage)
														(then (set open (call c_literal_text (borrow-shared storage_check_open)
															(borrow-mut output) offset writing)))
														(else
															(if
																(:doc "Identify an exact long double mismatch in the selected native signature.")
																long_double
																(then (set open (call c_literal_text (borrow-shared long_double_check_open)
																	(borrow-mut output) offset writing)))
																(else
																	(if
																		(:doc "Retained native strings require the exact immutable C pointer.")
																		retained_strings
																		(then (set open (call c_literal_text (borrow-shared static_string_check_open)
																			(borrow-mut output) offset writing)))
																		(else (set open (call c_literal_text (borrow-shared owner_check_open)
																			(borrow-mut output) offset writing))))))))))))))))))
			(let file (call write_c_number (borrow-mut output) open
				(struct.get function file) writing))
			(let bytes (call c_literal_text (borrow-shared handle_check_bytes)
				(borrow-mut output) file writing))
			(let start (call write_c_number (borrow-mut output) bytes
				(i32.sub (struct.get site start) base) writing))
			(let end (call write_site_number (borrow-mut output) start
				(i32.sub (struct.get site end) base) writing))
			(return (call c_literal_text (borrow-shared handle_check_close)
				(borrow-mut output) end writing))))

	(let snapshot_result_open "__typeof__((")
	(let snapshot_result_args ")(")
	(let snapshot_result_close "))")

	(fn write_snapshot_prototype_result
		(:doc `Use the native result type in the argument prototype check.

		The snapshot adapter already checks how the C result is read. The
		Wove result is an owner and does not describe the native return type.
		An unevaluated call using zero for each scalar or pointer
		formal recovers the return type from the included header.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode) (first i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared snapshot_result_open)
				(borrow-mut output) offset writing))
			(let symbol (call c_symbol_text (borrow-shared source) name
				(borrow-mut output) open writing))
			(let-mut cursor (call c_literal_text (borrow-shared snapshot_result_args)
				(borrow-mut output) symbol writing))
			(let-mut row first)
			(while
				(:doc "Zero is a valid unevaluated operand for each native scalar and pointer type.")
				(i32.not-ltz row)
				(body
					(set cursor (call c_byte (borrow-mut output) cursor 48u8 writing))
					(set row (struct.get (array.load nodes row) next_sibling))
					(if
						(:doc "Separate native operands before the next formal.")
						(i32.not-ltz row)
						(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))))
			(return (call c_literal_text (borrow-shared snapshot_result_close)
				(borrow-mut output) cursor writing))))

	(let borrowed_alternative "):1,")

	(fn write_c_prototype_formals
		(:doc "Append the exact fixed parameter types to one candidate function pointer prototype.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameters (shared-array ScalarParameter)) (function ScalarFunction) (output (mut-array u8))
			(offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(let-mut parameter (struct.get function params))
			(let-mut native_row (struct.get function c_formals))
			(let tail (struct.get function c_variadic))
			(let-mut wrote_formal (bool false))
			(if
				(:doc "An empty formal list explicitly takes no arguments in every C mode.")
				(bool.and (i32.ltz native_row) (i32.eqz tail))
				(then (set cursor (call c_literal_text (borrow-shared no_formals)
					(borrow-mut output) cursor writing))))
			(while
				(:doc "Each formal in the native prefix contributes one type, including hidden C operands.")
				(bool.and (i32.lt -1i32 native_row)
					(bool.or (i32.not-gtz tail) (i32.lt native_row tail)))
				(body
					(let item (array.load nodes native_row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let fixed (bool.and (struct.get function c_fixed)
						(call is_c_fixed_formal (borrow-shared source) (borrow-shared nodes) parts)))
					(if
						(:doc "Adapter-only Wove formals are absent from the native prototype.")
						(bool.and (bool.not fixed)
							(bool.or (call is_record_input_hidden function parameter)
								(u8.eq (struct.get (array.load parameters parameter) c_mode) c_owner_marker_flag_mode)))
						(then
							(set parameter (i32.inc parameter)))
						(else
							(if
								(:doc "Separate only types present in the actual C prototype.")
								wrote_formal
								(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
							(set wrote_formal (bool true))
							(if
								(:doc "A hidden operand has its own C type and no Wove parameter row.")
								fixed
								(then
									(let formal (call c_fixed_formal_at (borrow-shared source) (borrow-shared nodes) native_row))
									(set cursor (call write_fixed_c_type (borrow-shared source) (borrow-shared nodes)
										formal (borrow-mut output) cursor writing)))
								(else
									(if
										(:doc "The native out parameter adds one pointer level to the exact mutable record type.")
										(call is_record_out_status function parameter)
										(then
											(let backing (array.load parameters (struct.get function return_source)))
											(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
												(borrow-shared records) (struct.get backing type)
												(borrow-mut output) cursor name_prefix writing))
											(set cursor (call c_byte (borrow-mut output) cursor 42u8 writing)))
										(else
											(if
												(:doc "The caller-backed record scratch storage uses the exact C char pointer ABI.")
												(i32.eq parameter (struct.get function return_scratch))
												(then (set cursor (call c_literal_text (borrow-shared record_scratch_type)
													(borrow-mut output) cursor writing)))
												(else
													(set cursor (call write_fixed_parameter_type (borrow-shared source) (borrow-shared nodes)
														(borrow-shared records) (array.load parameters parameter)
														(borrow-mut output) cursor name_prefix writing))))))
									(set parameter (i32.inc parameter))))))
					(set native_row (struct.get item next_sibling))))
			(if
				(:doc "An ellipsis follows the native fixed prefix.")
				(bool.and wrote_formal (i32.not-eqz tail))
				(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
			(return cursor)))

	(fn write_c_prototype_check
		(:doc `Require the header to match the complete fixed signature or the variadic prefix and ellipsis.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameters (shared-array ScalarParameter)) (function ScalarFunction) (output (mut-array u8))
			(offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load nodes (struct.get function name)))
			(let-mut cursor (call c_literal_text (borrow-shared check_open) (borrow-mut output) offset writing))
			(set cursor (call c_symbol_text (borrow-shared source) name
				(borrow-mut output) cursor writing))
			(set cursor (call c_literal_text (borrow-shared after_name) (borrow-mut output) cursor writing))
			(let-mut result (struct.get function result))
			(if
				(:doc "The caller-backed view captures the native i32 return as a separate Wove status.")
				(i32.not-ltz (struct.get function return_scratch))
				(then (set result 5u32)))
			(if
				(:doc "The native pointer can refer to writable storage while Wove exposes only a shared borrow.")
				(call is_optional_record_borrow result)
				(then (set result (call optional_record_borrow_reference result (bool true)))))
			(if
				(:doc "A snapshot's Wove owner type differs from the native return type.")
				(struct.get function c_snapshot)
				(then
					(if
						(:doc "A record projection verifies the native pointer type declared in its mapping.")
						(i32.not-ltz (struct.get function c_snapshot_record))
						(then (set cursor (call write_record_snapshot_native_type (borrow-shared source)
							(borrow-shared nodes) (struct.get function c_snapshot_record)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call write_snapshot_prototype_result (borrow-shared source)
							(borrow-shared nodes) name (struct.get function c_formals)
							(borrow-mut output) cursor writing)))))
				(else (set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) result
					(borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_literal_text (borrow-shared before_formals) (borrow-mut output) cursor writing))
			(set cursor (call write_c_prototype_formals
				(borrow-shared source) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared parameters) function (borrow-mut output)
				cursor name_prefix writing))
			(if
				(:doc "Both native pointee qualifiers are compatible with the same read-only Wove reference.")
				(call is_optional_record_borrow (struct.get function result))
				(then
					(set cursor (call c_literal_text (borrow-shared borrowed_alternative)
						(borrow-mut output) cursor writing))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (struct.get function result)
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared before_formals)
						(borrow-mut output) cursor writing))
					(set cursor (call write_c_prototype_formals
						(borrow-shared source) (borrow-shared nodes) (borrow-shared records)
						(borrow-shared parameters) function (borrow-mut output)
						cursor name_prefix writing))))
			(let tail (struct.get function c_variadic))
			(if
				(:doc "A nonvariadic contract checks the complete prototype without an ellipsis.")
				(i32.eqz tail)
				(then (return (call close_c_fixed_prototype (array.load nodes (struct.get function declaration))
					function (call native_long_double_needs_prototype (borrow-shared records)
						(borrow-shared parameters) function)
					(call native_static_strings (borrow-shared parameters) function)
					(call native_sync_callbacks (borrow-shared parameters) function)
					(borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared variadic_check_close) (borrow-mut output) cursor writing)))))
