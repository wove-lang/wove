(module c_text
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write and measure C text with the same emission path.

	The measuring pass counts bytes without touching the output. Saturate at
	one past the maximum view length. A writing pass follows only after the
	whole checked translation unit fits inside the supplied view.`)

	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_byte))
	(use wove-file "../hashing/base16.wove" (only base16_digit))
	(use wove-file "../hashing/base32hex.wove" (only base32hex31_width encode_base32hex31))

	(fn c_byte
		(:doc `Count one byte and store it only in the capacity-checked writing pass.`)
		(params (output (mut-slice u8)) (offset u32) (byte u8) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A saturated count already exceeds every possible output view.")
				(u32.eq (local offset) (u32 2147483648))
				(then (return (local offset))))
			(if
				(:doc "Only the second pass has a checked output extent.")
				(local writing)
				(then (slice.store (local output) (int.convert i32 (local offset)) (local byte))))
			(return (u32.add.wrapping (local offset) (u32 1)))))

	(fn c_hex_byte
		(:doc `Write exactly two lowercase hexadecimal digits for one byte.`)
		(params (byte u8) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut remainder (int.convert u32 (local byte)))
			(let-mut high (u32 0))
			(while
				(:doc "Split the byte into two nibbles using the Stage 1 arithmetic subset.")
				(bool.not (u32.lt (local remainder) (u32 16)))
				(body
					(set (local remainder) (u32.sub.wrapping (local remainder) (u32 16)))
					(set (local high) (u32.add.wrapping (local high) (u32 1)))))
			(let next (call c_byte (borrow-mut (local output)) (local offset) (call base16_digit (local high)) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local next) (call base16_digit (local remainder)) (local writing)))))

	(fn c_include_prefix
		(:doc `Append the shared preprocessing directive prefix before a checked header operand.`)
		(params (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 35) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 99) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 108) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 117) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 100) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 32) (local writing)))
			(return (local next))))

	(fn c_span
		(:doc `Append the exact bytes in a checked span to the measured C text.`)
		(params (source (shared-slice u8)) (start i32) (end i32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut index (local start))
			(let-mut next (local offset))
			(while
				(:doc "Keep each source byte in order in both the measuring and writing passes.")
				(i32.lt (local index) (local end))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next)
						(slice.load (local source) (local index)) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local next))))

	(fn c_literal_text
		(:doc `Append a complete immutable C fragment.`)
		(params (text (shared-slice u8)) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call c_span (borrow-shared (local text)) (i32 0) (slice.len (local text))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn c_text_fragment
		(:doc `Append a fixed C text fragment selected by its emission role.

		Codes 0 through 5 select the header, main, void, return, the unused
		value cast, and the generated-name prefix. Codes 6 through 10
		select control-flow text for if, else, and a pre-tested loop.
		Code 11 writes return without a following space.`)
		(params (output (mut-slice u8)) (offset u32) (code u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(if
				(:doc "Append the <stdint.h> fragment.")
				(u32.eq (local code) (u32 0))
				(then
					(set (local next) (call c_include_prefix (borrow-mut (local output)) (local next) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 60) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 115) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 100) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 46) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 104) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 62) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 10) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the main fragment.")
				(u32.eq (local code) (u32 1))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 109) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 97) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the void fragment.")
				(u32.eq (local code) (u32 2))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 118) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 111) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 100) (local writing)))
					(return (local next))))
			(if
				(:doc "Both return forms share the same keyword.")
				(bool.or (u32.eq (local code) (u32 3)) (u32.eq (local code) (u32 11)))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 117) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(if
						(:doc "A following expression needs a separator.")
						(u32.eq (local code) (u32 3))
						(then (set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 32) (local writing)))))
					(return (local next))))
			(if
				(:doc "Append the (void) fragment.")
				(u32.eq (local code) (u32 4))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 40) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 118) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 111) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 100) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 41) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the wg fragment.")
				(u32.eq (local code) (u32 5))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 119) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 103) (local writing)))
					(return (local next))))
			(if
				(:doc "Open the if condition.")
				(u32.eq (local code) (u32 6))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 102) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 40) (local writing)))
					(return (local next))))
			(if
				(:doc "Open the else block.")
				(u32.eq (local code) (u32 7))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 108) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 115) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 123) (local writing)))
					(return (local next))))
			(if
				(:doc "Open the loop before evaluating its predicate.")
				(u32.eq (local code) (u32 8))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 119) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 104) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 108) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 40) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 49) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 41) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 123) (local writing)))
					(return (local next))))
			(if
				(:doc "Begin the loop exit test.")
				(u32.eq (local code) (u32 9))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 102) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 40) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 33) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 40) (local writing)))
					(return (local next))))
			(if
				(:doc "Exit before the body when the predicate is false.")
				(u32.eq (local code) (u32 10))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 41) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 41) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 123) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 98) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 97) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 107) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 59) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 125) (local writing)))
					(return (local next))))
			(return (local next))))

	(fn write_decimal_literal
		(:doc "Write normalized decimal digits with the checked sign and unsigned suffix.")
		(params (source (shared-slice u8)) (start i32) (end i32) (negative bool) (unsigned bool)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Only a nonzero negative decimal needs a minus sign.")
				(local negative)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 45) (local writing)))))
			(set (local cursor) (call c_decimal_digits (borrow-mut (local output)) (local cursor) (local writing)
				(borrow-shared (local source)) (local start) (local end)))
			(if
				(:doc "Use an unsigned C constant for the full u32 range.")
				(local unsigned)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 117) (local writing)))))
			(return (local cursor))))

	(fn c_type_text
		(:doc `Append the exact C scalar type for a checked signature or the ABI entry.`)
		(params (output (mut-slice u8)) (offset u32) (code u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(if
				(:doc "A void helper's C signature has no result value.")
				(u32.eq (local code) (call void_type))
				(then (return (call c_text_fragment (borrow-mut (local output)) (local offset) (u32 2) (local writing)))))
			(if
				(:doc "Append the int fragment.")
				(u32.eq (local code) (u32 0))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the signed integer type with the checked width.")
				(bool.or (u32.eq (local code) (u32 5)) (u32.eq (local code) (u32 61)))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(if
						(:doc "A signed byte uses an 8-bit C value.")
						(u32.eq (local code) (u32 61))
						(then (set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 56) (local writing))))
						(else
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 51) (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 50) (local writing)))))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the uint8_t fragment.")
				(u32.eq (local code) (u32 10))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 117) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 56) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the uint32_t fragment.")
				(u32.eq (local code) (u32 11))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 117) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 51) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 50) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(return (local next))))
			(if
				(:doc "The runtime byte view type includes mut_ only for writable access.")
				(bool.or (u32.eq (local code) (u32 34)) (u32.eq (local code) (u32 38)))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 119) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 118) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
					(if
						(:doc "A mutable slice descriptor has a writable backing pointer.")
						(u32.eq (local code) (u32 38))
						(then
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 109) (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 117) (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 115) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 108) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 99) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 101) (local writing)))
					(return (local next))))
			(if
				(:doc "An owning byte array is a runtime array pointer.")
				(u32.eq (local code) (u32 41))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 119) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 118) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 97) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 114) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 97) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 121) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 42) (local writing)))
					(return (local next))))
			(if
				(:doc "Append the _Bool fragment.")
				(u32.eq (local code) (u32 12))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 66) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 111) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 111) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 108) (local writing)))
					(return (local next))))
			(return (local next))))

	(fn c_cast
		(:doc `Write a cast to one of the checked C scalar types.`)
		(params (output (mut-slice u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) (u8 40) (local writing)))
			(let name (call c_type_text (borrow-mut (local output)) (local open) (local type) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name) (u8 41) (local writing)))))

	(fn c_u64_cast
		(:doc `Write the widening cast used for unsigned wrapping arithmetic.`)
		(params (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 40) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 117) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 105) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 110) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 54) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 52) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 95) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 116) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 41) (local writing)))
			(return (local next))))

	(fn c_i32_bias
		(:doc `Append the signed long long constant 2147483648LL used to wrap i32 arithmetic.`)
		(params (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 50) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 49) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 52) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 55) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 52) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 56) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 51) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 54) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 52) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 56) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 76) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 76) (local writing)))
			(return (local next))))

	(struct
		(:doc `The seed's representation of the generated C name role enum. Use the named role constructors.`)
		CNameRole
		(fields (tag u8)))

	(fn open_static_value
		(:doc `Open read-only C storage for a value of the requested type.`)
		(params (output (mut-slice u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 105) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 111) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 110) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 115) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))
			(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor) (local type) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 32) (local writing)))))

	(fn write_asset_byte
		(:doc `Write one exact byte as a hexadecimal C initializer with a trailing comma.`)
		(params (byte u8) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let zero (call c_byte (borrow-mut (local output)) (local offset) (u8 48) (local writing)))
			(let x (call c_byte (borrow-mut (local output)) (local zero) (u8 120) (local writing)))
			(let lower (call c_hex_byte (local byte) (borrow-mut (local output)) (local x) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local lower) (u8 44) (local writing)))))

	(fn write_static_bytes
		(:doc `Finish a static array declaration with its byte values in source order.`)
		(:expect (issues "gh:wove-lang/wove:176"))
		(params (arena (shared-slice u8)) (start i32) (end i32) (output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let length (i32.sub.wrapping (local end) (local start)))
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 91) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 93) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 61) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 123) (local writing)))
			(if
				(:doc "Standard C needs at least one initializer even for the zero-byte copy.")
				(i32.eq (local length) (i32 0))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 48) (local writing)))))
			(let-mut index (local start))
			(while
				(:doc "Keep the payload's raw bytes in their original order.")
				(i32.lt (local index) (local end))
				(body
					(set (local cursor) (call write_asset_byte (slice.load (local arena) (local index))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 125) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 59) (local writing)))))

	(fn function_name_role
		(:doc `Use f for a function with a checked declaration identity.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 102))))))

	(fn record_name_role
		(:doc `Use r for the stable identity of a named record type.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 114))))))

	(fn member_name_role
		(:doc `Use m for a member identified by its position in the record.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 109))))))

	(fn fixed_array_name_role
		(:doc `Use v for an anonymous fixed-array value layout.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 118))))))

	(fn parameter_name_role
		(:doc `Use p for a parameter identified by its position within the signature.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 112))))))

	(fn local_name_role
		(:doc `Use l for a local identified by the original row of its declared name.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 108))))))

	(fn temporary_name_role
		(:doc `Use t for a temporary identified by its original expression row in the defining file.`)
		(params)
		(returns CNameRole)
		(body (return (record.make CNameRole (tag (u8 116))))))

	(fn native_name_prefix_slot
		(:doc `Find the possible generated-name prefix used by a selected native spelling.

		A slot counts the extra lowercase w bytes before wg. A spelling
		outside that prefix and 31-bit Base32hex shape returns -1.`)
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut boundary (local start))
			(while
				(:doc "Find the end of the initial w run before testing for the generated marker.")
				(bool.and (i32.lt (local boundary) (local end))
					(u8.eq (slice.load (local source) (local boundary)) (u8 119)))
				(body (set (local boundary) (i32.add.wrapping (local boundary) (i32 1)))))
			(if
				(:doc "A generated name has a w run, a g, a role byte, and seven ID digits.")
				(bool.or (i32.eq (local boundary) (local start))
					(bool.or (i32.lt (i32.sub.wrapping (local end) (local boundary)) (i32 9))
						(bool.not (u8.eq (slice.load (local source) (local boundary)) (u8 103)))))
				(then (return (i32 -1))))
			(let first (i32.add.wrapping (local boundary) (i32 2)))
			(if
				(:doc "The first digit of a 31-bit Base32hex ID is 0 or 1.")
				(bool.not (bool.or (u8.eq (slice.load (local source) (local first)) (u8 48))
					(u8.eq (slice.load (local source) (local first)) (u8 49))))
				(then (return (i32 -1))))
			(let-mut index (i32.add.wrapping (local first) (i32 1)))
			(let limit (i32.add.wrapping (local first) (i32 7)))
			(while
				(:doc "Only a spelling with the complete lowercase ID shape can occupy this prefix.")
				(i32.lt (local index) (local limit))
				(body
					(let byte (slice.load (local source) (local index)))
					(if
						(:doc "Base32hex permits decimal digits and lowercase a through v.")
						(bool.not (bool.or (bool.and (u8.lt (u8 47) (local byte)) (u8.lt (local byte) (u8 58)))
							(bool.and (u8.lt (u8 96) (local byte)) (u8.lt (local byte) (u8 119)))))
						(then (return (i32 -1))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (i32.sub.wrapping (i32.sub.wrapping (local boundary) (local start)) (i32 1)))))

	(fn c_suffix_byte
		(:doc `Keep C identifier bytes in the generated suffix and map other bytes to underscores.`)
		(params (byte u8))
		(returns u8)
		(body
			(if
				(:doc "The generated prefix already supplies the first identifier byte.")
				(call is_c_identifier_byte (local byte))
				(then (return (local byte))))
			(return (u8 95))))

	(fn write_c_name
		(:doc `Generate the chosen prefix, role letter, seven lowercase Base32hex digits, and source suffix.

		Start with the requested extra w bytes followed by wg. The caller
		supplies the role and its checked 31-bit ID. The source name is a byte
		span in the original view. An empty span gives an empty suffix.`)
		(params (output (mut-slice u8)) (offset u32) (writing bool)
			(name_prefix i32) (role CNameRole) (identity u32) (source (shared-slice u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut next (local offset))
			(let-mut extra (local name_prefix))
			(while
				(:doc "Extend the same prefix in both passes before writing the usual wg marker.")
				(i32.lt (i32 0) (local extra))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) (u8 119) (local writing)))
					(set (local extra) (i32.sub.wrapping (local extra) (i32 1)))))
			(set (local next) (call c_text_fragment (borrow-mut (local output)) (local next) (u32 5) (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (record.get (local role) tag) (local writing)))
			(let digits_end (u32.add.wrapping (local next) (int.convert u32 (call base32hex31_width))))
			(if
				(:doc "Keep the measured length saturated if the fixed-width digits exceed a source view.")
				(u32.lt (u32 2147483648) (local digits_end))
				(then (return (u32 2147483648))))
			(if
				(:doc "The writing pass uses the encoder after measurement has reserved space for all seven digits.")
				(local writing)
				(then
					(let encoded (call encode_base32hex31 (local identity) (borrow-mut (local output))
						(int.convert i32 (local next))))
					(if
						(:doc "Propagate an unencodable ID or destination as a saturated count.")
						(bool.not (local encoded))
						(then (return (u32 2147483648))))))
			(set (local next) (local digits_end))
			(let-mut index (local start))
			(while
				(:doc "Make the source suffix readable while keeping the identity prefix exact.")
				(i32.lt (local index) (local end))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next)
						(call c_suffix_byte (slice.load (local source) (local index))) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local next))))

	(fn write_temporary_name
		(:doc `Use the original expression row as a unique temporary name inside the C function.`)
		(params (source (shared-slice u8)) (index i32) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call temporary_name_role)
				(int.convert u32 (i32.sub.wrapping (local index) (local tree_base)))
				(borrow-shared (local source)) (i32 0) (i32 0)))))

	(fn c_decimal_digits
		(:doc `Append checked decimal digits directly from their original source span.`)
		(params (output (mut-slice u8)) (offset u32) (writing bool)
			(source (shared-slice u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut next (local offset))
			(let-mut index (local start))
			(while
				(:doc "Copy only the significant digits established by the plan.")
				(i32.lt (local index) (local end))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next)
						(slice.load (local source) (local index)) (local writing)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local next)))))
