(module c_text
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write and measure C text with the same emission path.

	The measuring pass counts bytes without touching the output. Saturate at
	one past the maximum view length. A writing pass follows only after the
	whole checked translation unit fits inside the supplied view.`)

	(use wove-file "../source/types.wove" (only void_type (value f16_type) (value f32_type) (value f64_type) (value f80_type)
		(value i16_type) (value u16_type) (value i64_type)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_byte))
	(use wove-file "../hashing/base32hex.wove" (only (value base32hex31_width) encode_base32hex31))
	(use wove-file "../hashing/base16.wove" (only (value base16_alphabet)))

	(let c_half "_Float16")
	(let c_float "float")
	(let c_double "double")
	(let c_extended "long double")
	(let wide_type "uint64_t")
	(let c_output_limit 2147483648u32)

	(fn c_byte
		(:doc `Count one byte and store it only in the capacity-checked writing pass.`)
		(params (output (mut-array u8)) (offset u32) (byte u8) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A saturated count already exceeds every possible output view.")
				(u32.eq (local offset) (local c_output_limit))
				(then (return (local offset))))
			(if
				(:doc "Only the second pass has a checked output extent.")
				(local writing)
				(then (array.store (local output) (i32.from-u32 (local offset)) (local byte))))
			(return (u32.inc (local offset)))))

	(fn c_hex_byte
		(:doc `Write exactly two lowercase hexadecimal digits for one byte.`)
		(:expect
			(tests "stage-2/hashing/base16.wove")
			(issues "gh:wove-lang/wove:171" "gh:wove-lang/wove:239"))
		(params (byte u8) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let value (u32.from-u8 (local byte)))
			(let high (i32.from-u32 (u32.shr (local value) 4i32)))
			(let low (i32.from-u32 (u32.and (local value) 15u32)))
			(let next (call c_byte (borrow-mut (local output)) (local offset)
				(array.load (local base16_alphabet) (local high)) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local next)
				(array.load (local base16_alphabet) (local low)) (local writing)))))

	(fn c_include_prefix
		(:doc `Append the shared preprocessing directive prefix before a checked header operand.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 35u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 99u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 108u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 117u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 100u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 32u8 (local writing)))
			(return (local next))))

	(fn c_span
		(:doc `Append the exact bytes in a checked span to the measured C text.`)
		(params (source (shared-array u8)) (start i32) (end i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut index (local start))
			(let-mut next (local offset))
			(while
				(:doc "Keep each source byte in order in both the measuring and writing passes.")
				(i32.lt (local index) (local end))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next)
						(array.load (local source) (local index)) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(return (local next))))

	(fn c_literal_text
		(:doc `Append a complete immutable C fragment.`)
		(params (text (shared-array u8)) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call c_span (borrow-shared (local text)) 0i32 (array.len (local text))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn c_text_fragment
		(:doc `Append a fixed C text fragment selected by its emission role.

		Code 0 selects the header. Codes 2 through 5 select void, return,
		the unused value cast, and the generated-name prefix. Codes 6 through 10
		select control-flow text for if, else, and a pre-tested loop.
		Code 11 writes return without a following space.`)
		(params (output (mut-array u8)) (offset u32) (code u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(if
				(:doc "Append the <stdint.h> fragment.")
				(u32.eqz (local code))
				(then
					(set (local next) (call c_include_prefix (borrow-mut (local output)) (local next) (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 60u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 115u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 100u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 46u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 104u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 62u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 10u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Append the void fragment.")
				(u32.eq (local code) 2u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 118u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 111u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 100u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Both return forms share the same keyword.")
				(bool.or (u32.eq (local code) 3u32) (u32.eq (local code) 11u32))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 117u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
					(if
						(:doc "A following expression needs a separator.")
						(u32.eq (local code) 3u32)
						(then (set (local next) (call c_byte (borrow-mut (local output)) (local next) 32u8 (local writing)))))
					(return (local next))))
			(if
				(:doc "Append the (void) fragment.")
				(u32.eq (local code) 4u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 40u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 118u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 111u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 100u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 41u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Append the wg fragment.")
				(u32.eq (local code) 5u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 119u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 103u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Open the if condition.")
				(u32.eq (local code) 6u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 102u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 40u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Open the else block.")
				(u32.eq (local code) 7u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 108u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 115u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 123u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Open the loop before evaluating its predicate.")
				(u32.eq (local code) 8u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 119u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 104u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 108u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 40u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 49u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 41u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 123u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Begin the loop exit test.")
				(u32.eq (local code) 9u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 102u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 40u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 33u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 40u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Exit before the body when the predicate is false.")
				(u32.eq (local code) 10u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 41u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 41u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 123u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 98u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 97u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 107u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 59u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 125u8 (local writing)))
					(return (local next))))
			(return (local next))))

	(let c_i16 "int16_t")
	(let c_u16 "uint16_t")
	(let c_i64 "int64_t")

	(fn c_type_text
		(:doc `Append the exact C scalar type for a checked signature or the ABI entry.`)
		(params (output (mut-array u8)) (offset u32) (code u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Native binary16 uses the same type in Wove and C bridge signatures.")
				(u32.eq (local code) (local f16_type))
				(then (return (call c_literal_text (borrow-shared (local c_half))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The target gate verifies the native long double representation for extended precision.")
				(u32.eq (local code) (local f80_type))
				(then (return (call c_literal_text (borrow-shared (local c_extended))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(let-mut next (local offset))
			(if
				(:doc "A void helper's C signature has no result value.")
				(u32.eq (local code) (call void_type))
				(then (return (call c_text_fragment (borrow-mut (local output)) (local offset) 2u32 (local writing)))))
			(if
				(:doc "Binary32 uses C float at every storage and ABI boundary.")
				(u32.eq (local code) (local f32_type))
				(then (return (call c_literal_text (borrow-shared (local c_float))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Binary64 uses C double.")
				(u32.eq (local code) (local f64_type))
				(then (return (call c_literal_text (borrow-shared (local c_double))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Append the int fragment.")
				(u32.eqz (local code))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Signed wide values preserve the native exact-width C type.")
				(u32.eq (local code) (local i64_type))
				(then (return (call c_literal_text (borrow-shared (local c_i64))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Signed 16-bit values keep their exact C type in storage and signatures.")
				(u32.eq (local code) (local i16_type))
				(then (return (call c_literal_text (borrow-shared (local c_i16))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Unsigned 16-bit values keep their distinct C type.")
				(u32.eq (local code) (local u16_type))
				(then (return (call c_literal_text (borrow-shared (local c_u16))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Append the signed integer type with the checked width.")
				(bool.or (u32.eq (local code) 5u32) (u32.eq (local code) 61u32))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(if
						(:doc "A signed byte uses an 8-bit C value.")
						(u32.eq (local code) 61u32)
						(then (set (local next) (call c_byte (borrow-mut (local output)) (local next) 56u8 (local writing))))
						(else
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) 51u8 (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) 50u8 (local writing)))))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Append the uint8_t fragment.")
				(u32.eq (local code) 10u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 117u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 56u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(return (local next))))
			(if
				(:doc "An unsigned wide value uses C's exact 64-bit type.")
				(u32.eq (local code) 54u32)
				(then (return (call c_literal_text (borrow-shared (local wide_type))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Append the uint32_t fragment.")
				(u32.eq (local code) 11u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 117u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 110u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 51u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 50u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(return (local next))))
			(if
				(:doc "The runtime byte view type includes mut_ only for writable access.")
				(bool.or (u32.eq (local code) 34u32) (u32.eq (local code) 38u32))
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 119u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 118u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))
					(if
						(:doc "A mutable slice descriptor has a writable backing pointer.")
						(u32.eq (local code) 38u32)
						(then
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) 109u8 (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) 117u8 (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
							(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 115u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 108u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 105u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 99u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 101u8 (local writing)))
					(return (local next))))
			(if
				(:doc "An owning byte array is a runtime array pointer.")
				(u32.eq (local code) 41u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 119u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 118u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 116u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 97u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 114u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 97u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 121u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 42u8 (local writing)))
					(return (local next))))
			(if
				(:doc "Append the _Bool fragment.")
				(u32.eq (local code) 12u32)
				(then
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 95u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 66u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 111u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 111u8 (local writing)))
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 108u8 (local writing)))
					(return (local next))))
			(return (local next))))

	(fn c_cast
		(:doc `Write a cast to one of the checked C scalar types.`)
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let name (call c_type_text (borrow-mut (local output)) (local open) (local type) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local name) 41u8 (local writing)))))

	(fn c_i32_bias
		(:doc `Append the signed long long constant 2147483648LL used to wrap i32 arithmetic.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next (local offset))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 50u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 49u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 52u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 55u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 52u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 56u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 51u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 54u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 52u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 56u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 76u8 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) 76u8 (local writing)))
			(return (local next))))

	(struct
		(:doc `The seed's representation of the generated C name role enum. Use the named role constructors.`)
		CNameRole
		(fields (tag u8)))

	(fn open_static_storage
		(:doc `Write the shared storage qualifier for a read-only C definition.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 97u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 105u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 99u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 111u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 110u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 115u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 116u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(return (local cursor))))

	(fn open_static_value
		(:doc `Open read-only C storage for a value of the requested type.`)
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let prefix (call open_static_storage (borrow-mut (local output)) (local offset) (local writing)))
			(let type_end (call c_type_text (borrow-mut (local output)) (local prefix) (local type) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local type_end) 32u8 (local writing)))))

	(fn write_asset_byte
		(:doc `Write one exact byte as a hexadecimal C initializer with a trailing comma.`)
		(params (byte u8) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let zero (call c_byte (borrow-mut (local output)) (local offset) 48u8 (local writing)))
			(let x (call c_byte (borrow-mut (local output)) (local zero) 120u8 (local writing)))
			(let lower (call c_hex_byte (local byte) (borrow-mut (local output)) (local x) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local lower) 44u8 (local writing)))))

	(fn write_static_bytes
		(:doc `Finish a static array declaration with its byte values in source order.`)
		(:expect (issues "gh:wove-lang/wove:176"))
		(params (arena (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let length (i32.sub (local end) (local start)))
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 91u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 93u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 123u8 (local writing)))
			(if
				(:doc "Standard C needs at least one initializer even for the zero-byte copy.")
				(i32.eqz (local length))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 48u8 (local writing)))))
			(let-mut index (local start))
			(while
				(:doc "Keep the payload's raw bytes in their original order.")
				(i32.lt (local index) (local end))
				(body
					(set (local cursor) (call write_asset_byte (array.load (local arena) (local index))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))))

	(fn function_name_role
		(:doc `Use f for a function with a checked declaration identity.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 102u8)))))

	(fn record_name_role
		(:doc `Use r for the stable identity of a named record type.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 114u8)))))

	(fn member_name_role
		(:doc `Use m for a member identified by its position in the record.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 109u8)))))

	(fn fixed_array_name_role
		(:doc `Use v for an anonymous fixed-array value layout.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 118u8)))))

	(fn parameter_name_role
		(:doc `Use p for a parameter identified by its position within the signature.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 112u8)))))

	(fn local_name_role
		(:doc `Use l for a local identified by the original row of its declared name.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 108u8)))))

	(fn temporary_name_role
		(:doc `Use t for a temporary identified by its original expression row in the defining file.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 116u8)))))

	(fn loop_label_name_role
		(:doc `Use j for the break destination identified by the loop's original source row.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 106u8)))))

	(fn readonly_type_name_role
		(:doc `Use q for the auxiliary typedef of a read-only native binding's type.`)
		(params)
		(returns CNameRole)
		(body (return (struct.new CNameRole (tag 113u8)))))

	(fn native_name_prefix_slot
		(:doc `Find the possible generated-name prefix used by a selected native spelling.

		A slot counts the extra lowercase w bytes before wg. A spelling
		outside that prefix and 31-bit Base32hex shape returns -1.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut boundary (local start))
			(while
				(:doc "Find the end of the initial w run before testing for the generated marker.")
				(bool.and (i32.lt (local boundary) (local end))
					(u8.eq (array.load (local source) (local boundary)) 119u8))
				(body (set (local boundary) (i32.inc (local boundary)))))
			(if
				(:doc "A generated name has a w run, a g, a role byte, and seven ID digits.")
				(bool.or (i32.eq (local boundary) (local start))
					(bool.or (i32.lt (i32.sub (local end) (local boundary)) 9i32)
						(u8.not-eq (array.load (local source) (local boundary)) 103u8)))
				(then (return -1i32)))
			(let first (i32.add (local boundary) 2i32))
			(if
				(:doc "The first digit of a 31-bit Base32hex ID is 0 or 1.")
				(bool.not (bool.or (u8.eq (array.load (local source) (local first)) 48u8)
					(u8.eq (array.load (local source) (local first)) 49u8)))
				(then (return -1i32)))
			(let-mut index (i32.inc (local first)))
			(let limit (i32.add (local first) 7i32))
			(while
				(:doc "Only a spelling with the complete lowercase ID shape can occupy this prefix.")
				(i32.lt (local index) (local limit))
				(body
					(let byte (array.load (local source) (local index)))
					(if
						(:doc "Base32hex permits decimal digits and lowercase a through v.")
						(bool.not (bool.or (bool.and (u8.lt 47u8 (local byte)) (u8.lt (local byte) 58u8))
							(bool.and (u8.lt 96u8 (local byte)) (u8.lt (local byte) 119u8))))
						(then (return -1i32)))
					(set (local index) (i32.inc (local index)))))
			(return (i32.dec (i32.sub (local boundary) (local start))))))

	(fn c_suffix_byte
		(:doc `Keep C identifier bytes in the generated suffix and map other bytes to underscores.`)
		(params (byte u8))
		(returns u8)
		(body
			(if
				(:doc "The generated prefix already supplies the first identifier byte.")
				(call is_c_identifier_byte (local byte))
				(then (return (local byte))))
			(return 95u8)))

	(fn write_c_name
		(:doc `Generate the chosen prefix, role letter, seven lowercase Base32hex digits, and source suffix.

		Start with the requested extra w bytes followed by wg. The caller
		supplies the role and its checked 31-bit ID. The source name is a byte
		span in the original view. An empty span gives an empty suffix.`)
		(params (output (mut-array u8)) (offset u32) (writing bool)
			(name_prefix i32) (role CNameRole) (identity u32) (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut next (local offset))
			(let-mut extra (local name_prefix))
			(while
				(:doc "Extend the same prefix in both passes before writing the usual wg marker.")
				(i32.gtz (local extra))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next) 119u8 (local writing)))
					(set (local extra) (i32.dec (local extra)))))
			(set (local next) (call c_text_fragment (borrow-mut (local output)) (local next) 5u32 (local writing)))
			(set (local next) (call c_byte (borrow-mut (local output)) (local next) (struct.get (local role) tag) (local writing)))
			(let digits_end (u32.add (local next) (u32.from-i32 (local base32hex31_width))))
			(if
				(:doc "Keep the measured length saturated if the fixed-width digits exceed a source view.")
				(u32.lt (local c_output_limit) (local digits_end))
				(then (return (local c_output_limit))))
			(if
				(:doc "The writing pass uses the encoder after measurement has reserved space for all seven digits.")
				(local writing)
				(then
					(let encoded (call encode_base32hex31 (local identity) (borrow-mut (local output))
						(i32.from-u32 (local next))))
					(if
						(:doc "Propagate an unencodable ID or destination as a saturated count.")
						(bool.not (local encoded))
						(then (return (local c_output_limit))))))
			(set (local next) (local digits_end))
			(let-mut index (local start))
			(while
				(:doc "Make the source suffix readable while keeping the identity prefix exact.")
				(i32.lt (local index) (local end))
				(body
					(set (local next) (call c_byte (borrow-mut (local output)) (local next)
						(call c_suffix_byte (array.load (local source) (local index))) (local writing)))
					(set (local index) (i32.inc (local index)))))
			(return (local next))))

	(fn write_local_place
		(:doc `Write a direct local or the place reached through an iteration item pointer.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (tree_base i32) (indirect bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Parenthesize an indirect place so it can also receive a field projection.")
				(local indirect)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 42u8 (local writing)))))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(local name) (local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Close the compound C lvalue before its caller appends members or an assignment.")
				(local indirect)
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(return (local cursor))))

	(fn write_local_name
		(:doc `Write a local's name from its original source row and spelling.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load (local nodes) (local index)))
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call local_name_role)
				(u32.from-i32 (i32.sub (local index) (local tree_base))) (borrow-shared (local source))
				(struct.get (local name) start) (struct.get (local name) end)))))

	(fn write_temporary_name
		(:doc `Use the original expression row as a unique temporary name inside the C function.`)
		(params (source (shared-array u8)) (index i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call temporary_name_role)
				(u32.from-i32 (i32.sub (local index) (local tree_base)))
				(borrow-shared (local source)) 0i32 0i32))))

	(fn write_loop_label
		(:doc `Write the same file-local label at a loop and at each break that targets it.`)
		(params (source (shared-array u8)) (loop i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(return (call write_c_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call loop_label_name_role)
				(u32.from-i32 (i32.sub (local loop) (local tree_base)))
				(borrow-shared (local source)) 0i32 0i32))))

)
