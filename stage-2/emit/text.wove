(module c_text
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write and measure C text with the same emission path.

	The measuring pass counts bytes without touching the output. Saturate at
	one past the maximum view length. A writing pass follows only after the
	whole checked translation unit fits inside the supplied view.`)

	(use wove-file "../source/types.wove" (only void_type (value f16_type) (value f32_type) (value f64_type) (value f80_type) (value f128_type)
		(value i16_type) (value u16_type) (value i64_type) (value i128_type) (value u128_type) (value i256_type) (value u256_type)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../hashing/base62.wove" (only base62_width write_base62_digits))
	(use wove-file "../hashing/base16.wove" (only (value base16_alphabet)))
	(use wove-file "./names.wove" (only (value function_role) (value record_role) (value member_role) (value parameter_role) (value local_role)
		(value temporary_role) (value loop_label_role) (value callback_adapter_role) (value fixed_array_role) (value callable_role)
		(value readonly_type_role)))

	(let c_half "_Float16")
	(let c_float "float")
	(let c_double "double")
	(let c_extended "long double")
	(let c_quad "wvrt_f128")
	(let wide_type "uint64_t")
	(let c_output_limit 2147483648u32)

	(fn c_byte
		(:doc `Count one byte and store it only in the capacity-checked writing pass.`)
		(params (output (mut-array u8)) (offset u32) (byte u8) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A saturated count already exceeds every possible output view.")
				(u32:eq offset c_output_limit)
				(then (return offset)))
			(if
				(:doc "Only the second pass has a checked output extent.")
				writing
				(then (output.set (i32:from-u32 offset) byte)))
			(return (u32:inc offset))))

	(fn c_hex_byte
		(:doc `Write exactly two lowercase hexadecimal digits for one byte.`)
		(:expect
			(tests "stage-2/hashing/base16.wove")
			(issues "gh:wove-lang/wove:171" "gh:wove-lang/wove:239"))
		(params (byte u8) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let value (u32:from-u8 byte))
			(let high (i32:from-u32 (u32:shr value 4i32)))
			(let low (i32:from-u32 (u32:and value 15u32)))
			(let next (call c_byte (borrow-mut output) offset
				(base16_alphabet.get high) writing))
			(return (call c_byte (borrow-mut output) next
				(base16_alphabet.get low) writing))))

	(fn c_include_prefix
		(:doc `Append the shared preprocessing directive prefix before a checked header operand.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next offset)
			(set next (call c_byte (borrow-mut output) next 35u8 writing))
			(set next (call c_byte (borrow-mut output) next 105u8 writing))
			(set next (call c_byte (borrow-mut output) next 110u8 writing))
			(set next (call c_byte (borrow-mut output) next 99u8 writing))
			(set next (call c_byte (borrow-mut output) next 108u8 writing))
			(set next (call c_byte (borrow-mut output) next 117u8 writing))
			(set next (call c_byte (borrow-mut output) next 100u8 writing))
			(set next (call c_byte (borrow-mut output) next 101u8 writing))
			(set next (call c_byte (borrow-mut output) next 32u8 writing))
			(return next)))

	(fn c_span
		(:doc `Append the exact bytes in a checked span to the measured C text.`)
		(params (source (shared-array u8)) (start i32) (end i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut index start)
			(let-mut next offset)
			(while
				(:doc "Keep each source byte in order in both the measuring and writing passes.")
				(i32:lt index end)
				(body
					(set next (call c_byte (borrow-mut output) next
						(source.get index) writing))
					(set index (i32:inc index))))
			(return next)))

	(fn c_literal_text
		(:doc `Append a complete immutable C fragment.`)
		(params (text (shared-array u8)) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(return (call c_span (borrow-shared text) 0i32 text.len
				(borrow-mut output) offset writing))))

	(fn c_text_fragment
		(:doc `Append a fixed C text fragment selected by its emission role.

		Code 0 selects the header. Codes 2 through 5 select void, return,
		the unused value cast, and the generated-name prefix. Codes 6 through 10
		select control-flow text for if, else, and a pre-tested loop.
		Code 11 writes return without a following space.`)
		(params (output (mut-array u8)) (offset u32) (code u32) (writing bool))
		(returns u32)
		(body
			(let-mut next offset)
			(if
				(:doc "Append the <stdint.h> fragment.")
				(u32:eqz code)
				(then
					(set next (call c_include_prefix (borrow-mut output) next writing))
					(set next (call c_byte (borrow-mut output) next 60u8 writing))
					(set next (call c_byte (borrow-mut output) next 115u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 100u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 110u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 46u8 writing))
					(set next (call c_byte (borrow-mut output) next 104u8 writing))
					(set next (call c_byte (borrow-mut output) next 62u8 writing))
					(set next (call c_byte (borrow-mut output) next 10u8 writing))
					(return next)))
			(if
				(:doc "Append the void fragment.")
				(u32:eq code 2u32)
				(then
					(set next (call c_byte (borrow-mut output) next 118u8 writing))
					(set next (call c_byte (borrow-mut output) next 111u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 100u8 writing))
					(return next)))
			(if
				(:doc "Both return forms share the same keyword.")
				(bool:or (u32:eq code 3u32) (u32:eq code 11u32))
				(then
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 101u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 117u8 writing))
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 110u8 writing))
					(if
						(:doc "A following expression needs a separator.")
						(u32:eq code 3u32)
						(then (set next (call c_byte (borrow-mut output) next 32u8 writing))))
					(return next)))
			(if
				(:doc "Append the (void) fragment.")
				(u32:eq code 4u32)
				(then
					(set next (call c_byte (borrow-mut output) next 40u8 writing))
					(set next (call c_byte (borrow-mut output) next 118u8 writing))
					(set next (call c_byte (borrow-mut output) next 111u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 100u8 writing))
					(set next (call c_byte (borrow-mut output) next 41u8 writing))
					(return next)))
			(if
				(:doc "Append the wg fragment.")
				(u32:eq code 5u32)
				(then
					(set next (call c_byte (borrow-mut output) next 119u8 writing))
					(set next (call c_byte (borrow-mut output) next 103u8 writing))
					(return next)))
			(if
				(:doc "Open the if condition.")
				(u32:eq code 6u32)
				(then
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 102u8 writing))
					(set next (call c_byte (borrow-mut output) next 40u8 writing))
					(return next)))
			(if
				(:doc "Open the else block.")
				(u32:eq code 7u32)
				(then
					(set next (call c_byte (borrow-mut output) next 101u8 writing))
					(set next (call c_byte (borrow-mut output) next 108u8 writing))
					(set next (call c_byte (borrow-mut output) next 115u8 writing))
					(set next (call c_byte (borrow-mut output) next 101u8 writing))
					(set next (call c_byte (borrow-mut output) next 123u8 writing))
					(return next)))
			(if
				(:doc "Open the loop before evaluating its predicate.")
				(u32:eq code 8u32)
				(then
					(set next (call c_byte (borrow-mut output) next 119u8 writing))
					(set next (call c_byte (borrow-mut output) next 104u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 108u8 writing))
					(set next (call c_byte (borrow-mut output) next 101u8 writing))
					(set next (call c_byte (borrow-mut output) next 40u8 writing))
					(set next (call c_byte (borrow-mut output) next 49u8 writing))
					(set next (call c_byte (borrow-mut output) next 41u8 writing))
					(set next (call c_byte (borrow-mut output) next 123u8 writing))
					(return next)))
			(if
				(:doc "Begin the loop exit test.")
				(u32:eq code 9u32)
				(then
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 102u8 writing))
					(set next (call c_byte (borrow-mut output) next 40u8 writing))
					(set next (call c_byte (borrow-mut output) next 33u8 writing))
					(set next (call c_byte (borrow-mut output) next 40u8 writing))
					(return next)))
			(if
				(:doc "Exit before the body when the predicate is false.")
				(u32:eq code 10u32)
				(then
					(set next (call c_byte (borrow-mut output) next 41u8 writing))
					(set next (call c_byte (borrow-mut output) next 41u8 writing))
					(set next (call c_byte (borrow-mut output) next 123u8 writing))
					(set next (call c_byte (borrow-mut output) next 98u8 writing))
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 101u8 writing))
					(set next (call c_byte (borrow-mut output) next 97u8 writing))
					(set next (call c_byte (borrow-mut output) next 107u8 writing))
					(set next (call c_byte (borrow-mut output) next 59u8 writing))
					(set next (call c_byte (borrow-mut output) next 125u8 writing))
					(return next)))
			(return next)))

	(let c_i16 "int16_t")
	(let c_u16 "uint16_t")
	(let c_i64 "int64_t")
	(let c_i128 "wvrt_i128")
	(let c_u128 "wvrt_u128")
	(let c_i256 "wvrt_i256")
	(let c_u256 "wvrt_u256")

	(fn c_type_text
		(:doc `Append the exact C scalar type for a checked signature or the ABI entry.`)
		(params (output (mut-array u8)) (offset u32) (code u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Native binary16 uses the same type in Wove and C bridge signatures.")
				(u32:eq code f16_type)
				(then (return (call c_literal_text (borrow-shared c_half)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The target gate verifies the native long double representation for extended precision.")
				(u32:eq code f80_type)
				(then (return (call c_literal_text (borrow-shared c_extended)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The runtime typedef selects the target's native binary128 spelling.")
				(u32:eq code f128_type)
				(then (return (call c_literal_text (borrow-shared c_quad)
					(borrow-mut output) offset writing))))
			(let-mut next offset)
			(if
				(:doc "A void helper's C signature has no result value.")
				(u32:eq code (call void_type))
				(then (return (call c_text_fragment (borrow-mut output) offset 2u32 writing))))
			(if
				(:doc "Binary32 uses C float at every storage and ABI boundary.")
				(u32:eq code f32_type)
				(then (return (call c_literal_text (borrow-shared c_float)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Binary64 uses C double.")
				(u32:eq code f64_type)
				(then (return (call c_literal_text (borrow-shared c_double)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Append the int fragment.")
				(u32:eqz code)
				(then
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 110u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(return next)))
			(if
				(:doc "Keep signed and unsigned C23 storage and call ABI distinct.")
				(u32:eq code i256_type)
				(then (return (call c_literal_text (borrow-shared c_i256)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Unsigned 256-bit values retain every bit of the original magnitude.")
				(u32:eq code u256_type)
				(then (return (call c_literal_text (borrow-shared c_u256)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The signed 128-bit scalar uses the target-gated runtime typedef.")
				(u32:eq code i128_type)
				(then (return (call c_literal_text (borrow-shared c_i128)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The unsigned 128-bit scalar keeps its full range.")
				(u32:eq code u128_type)
				(then (return (call c_literal_text (borrow-shared c_u128)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Signed wide values preserve the native exact-width C type.")
				(u32:eq code i64_type)
				(then (return (call c_literal_text (borrow-shared c_i64)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Signed 16-bit values keep their exact C type in storage and signatures.")
				(u32:eq code i16_type)
				(then (return (call c_literal_text (borrow-shared c_i16)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Unsigned 16-bit values keep their distinct C type.")
				(u32:eq code u16_type)
				(then (return (call c_literal_text (borrow-shared c_u16)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Append the signed integer type with the checked width.")
				(bool:or (u32:eq code 5u32) (u32:eq code 61u32))
				(then
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 110u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(if
						(:doc "A signed byte uses an 8-bit C value.")
						(u32:eq code 61u32)
						(then (set next (call c_byte (borrow-mut output) next 56u8 writing)))
						(else
							(set next (call c_byte (borrow-mut output) next 51u8 writing))
							(set next (call c_byte (borrow-mut output) next 50u8 writing))))
					(set next (call c_byte (borrow-mut output) next 95u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(return next)))
			(if
				(:doc "Append the uint8_t fragment.")
				(u32:eq code 10u32)
				(then
					(set next (call c_byte (borrow-mut output) next 117u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 110u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 56u8 writing))
					(set next (call c_byte (borrow-mut output) next 95u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(return next)))
			(if
				(:doc "An unsigned wide value uses C's exact 64-bit type.")
				(u32:eq code 54u32)
				(then (return (call c_literal_text (borrow-shared wide_type)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Append the uint32_t fragment.")
				(u32:eq code 11u32)
				(then
					(set next (call c_byte (borrow-mut output) next 117u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 110u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 51u8 writing))
					(set next (call c_byte (borrow-mut output) next 50u8 writing))
					(set next (call c_byte (borrow-mut output) next 95u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(return next)))
			(if
				(:doc "The runtime byte view type includes mut_ only for writable access.")
				(bool:or (u32:eq code 34u32) (u32:eq code 38u32))
				(then
					(set next (call c_byte (borrow-mut output) next 119u8 writing))
					(set next (call c_byte (borrow-mut output) next 118u8 writing))
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 95u8 writing))
					(if
						(:doc "A mutable slice descriptor has a writable backing pointer.")
						(u32:eq code 38u32)
						(then
							(set next (call c_byte (borrow-mut output) next 109u8 writing))
							(set next (call c_byte (borrow-mut output) next 117u8 writing))
							(set next (call c_byte (borrow-mut output) next 116u8 writing))
							(set next (call c_byte (borrow-mut output) next 95u8 writing))))
					(set next (call c_byte (borrow-mut output) next 115u8 writing))
					(set next (call c_byte (borrow-mut output) next 108u8 writing))
					(set next (call c_byte (borrow-mut output) next 105u8 writing))
					(set next (call c_byte (borrow-mut output) next 99u8 writing))
					(set next (call c_byte (borrow-mut output) next 101u8 writing))
					(return next)))
			(if
				(:doc "An owning byte array is a runtime array pointer.")
				(u32:eq code 41u32)
				(then
					(set next (call c_byte (borrow-mut output) next 119u8 writing))
					(set next (call c_byte (borrow-mut output) next 118u8 writing))
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 116u8 writing))
					(set next (call c_byte (borrow-mut output) next 95u8 writing))
					(set next (call c_byte (borrow-mut output) next 97u8 writing))
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 114u8 writing))
					(set next (call c_byte (borrow-mut output) next 97u8 writing))
					(set next (call c_byte (borrow-mut output) next 121u8 writing))
					(set next (call c_byte (borrow-mut output) next 42u8 writing))
					(return next)))
			(if
				(:doc "Append the _Bool fragment.")
				(u32:eq code 12u32)
				(then
					(set next (call c_byte (borrow-mut output) next 95u8 writing))
					(set next (call c_byte (borrow-mut output) next 66u8 writing))
					(set next (call c_byte (borrow-mut output) next 111u8 writing))
					(set next (call c_byte (borrow-mut output) next 111u8 writing))
					(set next (call c_byte (borrow-mut output) next 108u8 writing))
					(return next)))
			(return next)))

	(fn c_cast
		(:doc `Write a cast to one of the checked C scalar types.`)
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let name (call c_type_text (borrow-mut output) open type writing))
			(return (call c_byte (borrow-mut output) name 41u8 writing))))

	(fn c_i32_bias
		(:doc `Append the signed long long constant 2147483648LL used to wrap i32 arithmetic.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut next offset)
			(set next (call c_byte (borrow-mut output) next 50u8 writing))
			(set next (call c_byte (borrow-mut output) next 49u8 writing))
			(set next (call c_byte (borrow-mut output) next 52u8 writing))
			(set next (call c_byte (borrow-mut output) next 55u8 writing))
			(set next (call c_byte (borrow-mut output) next 52u8 writing))
			(set next (call c_byte (borrow-mut output) next 56u8 writing))
			(set next (call c_byte (borrow-mut output) next 51u8 writing))
			(set next (call c_byte (borrow-mut output) next 54u8 writing))
			(set next (call c_byte (borrow-mut output) next 52u8 writing))
			(set next (call c_byte (borrow-mut output) next 56u8 writing))
			(set next (call c_byte (borrow-mut output) next 76u8 writing))
			(set next (call c_byte (borrow-mut output) next 76u8 writing))
			(return next)))

	(struct CNameRole
		(:doc `The seed's representation of the generated C name role enum. Use the named role constructors.`)
		(fields (tag u8)))

	(struct CNameSpelling
		(:doc "Select the original name bytes and an optional single-byte suffix for call scratch names.")
		(fields (start i32) (end i32) (trailing u8)))

	(fn open_static_storage
		(:doc `Write the shared storage qualifier for a read-only C definition.`)
		(params (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 97u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 105u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 99u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 111u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 110u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 115u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 116u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))
			(return cursor)))

	(fn open_static_value
		(:doc `Open read-only C storage for a value of the requested type.`)
		(params (output (mut-array u8)) (offset u32) (type u32) (writing bool))
		(returns u32)
		(body
			(let prefix (call open_static_storage (borrow-mut output) offset writing))
			(let type_end (call c_type_text (borrow-mut output) prefix type writing))
			(return (call c_byte (borrow-mut output) type_end 32u8 writing))))

	(fn write_asset_byte
		(:doc `Write one exact byte as a hexadecimal C initializer with a trailing comma.`)
		(params (byte u8) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let zero (call c_byte (borrow-mut output) offset 48u8 writing))
			(let x (call c_byte (borrow-mut output) zero 120u8 writing))
			(let lower (call c_hex_byte byte (borrow-mut output) x writing))
			(return (call c_byte (borrow-mut output) lower 44u8 writing))))

	(fn write_static_bytes
		(:doc `Finish a nonempty static array declaration with its exact byte values.`)
		(:expect (issues "gh:wove-lang/wove:176"))
		(params (arena (shared-array u8)) (start i32) (end i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(set cursor (call c_byte (borrow-mut output) cursor 91u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 93u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
			(set cursor (call c_byte (borrow-mut output) cursor 123u8 writing))
			(let-mut index start)
			(while
				(:doc "Keep the payload's raw bytes in their original order.")
				(i32:lt index end)
				(body
					(set cursor (call write_asset_byte (arena.get index)
						(borrow-mut output) cursor writing))
					(set index (i32:inc index))))
			(set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))
			(return (call c_byte (borrow-mut output) cursor 59u8 writing))))

	(fn function_name_role
		(:doc `Use f for a function with a checked declaration identity.`)
		(params)
		(returns CNameRole)
		(body (return (struct:new CNameRole (tag function_role)))))

	(fn callable_name_role
		(:doc "Use k for the typedef of an interned function-pointer signature.")
		(params) (returns CNameRole)
		(body (return (struct:new CNameRole (tag callable_role)))))

	(fn record_name_role
		(:doc `Use r for the stable identity of a named record or enum.`)
		(params)
		(returns CNameRole)
		(body (return (struct:new CNameRole (tag record_role)))))

	(fn member_name_role
		(:doc `Use m in the owning aggregate's C member namespace.`)
		(params)
		(returns CNameRole)
		(body (return (struct:new CNameRole (tag member_role)))))

	(fn fixed_array_name_role
		(:doc `Use v for an anonymous fixed-array value layout.`)
		(params)
		(returns CNameRole)
		(body (return (struct:new CNameRole (tag fixed_array_role)))))

	(fn parameter_name_role
		(:doc `Use p for a parameter named within its concrete function key.`)
		(params)
		(returns CNameRole)
		(body (return (struct:new CNameRole (tag parameter_role)))))

	(fn readonly_type_name_role
		(:doc `Use q for the auxiliary typedef of a read-only native binding's type.`)
		(params)
		(returns CNameRole)
		(body (return (struct:new CNameRole (tag readonly_type_role)))))

	(fn native_name_prefix_slot
		(:doc "Reserve any selected native spelling with the generated prefix and room for a role and ordinal.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut boundary start)
			(while
				(:doc "Count the initial w run before looking for the generated marker.")
				(bool:and (i32:lt boundary end) (u8:eq (source.get boundary) 119u8))
				(body (set boundary (i32:inc boundary))))
			(if
				(:doc "Every generated name has a w run followed by g, a role, and at least one digit.")
				(bool:or (i32:eq boundary start)
					(bool:or (i32:lt (i32:sub end boundary) 3i32) (u8:not-eq (source.get boundary) 103u8)))
				(then (return -1i32)))
			(return (i32:dec (i32:sub boundary start)))))

	(fn get_name
		(:doc `Write a private C name as wg, a role letter, and an unpadded Base62 ordinal.

		A source spelling or scratch suffix follows an underscore so its
		first byte cannot be mistaken for part of the ordinal.`)
		(params (ordinal u32) (role CNameRole) (name CNameSpelling) (source (shared-array u8))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut next offset)
			(let-mut extra name_prefix)
			(while
				(:doc "Extend the prefix consistently in measuring and writing passes.")
				(i32:gtz extra)
				(body
					(set next (call c_byte (borrow-mut output) next 119u8 writing))
					(set extra (i32:dec extra))))
			(set next (call c_text_fragment (borrow-mut output) next 5u32 writing))
			(set next (call c_byte (borrow-mut output) next (role.get tag) writing))
			(let end (u32:add next (u32:from-i32 (call base62_width ordinal))))
			(if
				(:doc "Saturate an ordinal that would exceed the maximum admitted output span.")
				(u32:not-lt end c_output_limit)
				(then (return c_output_limit)))
			(if
				(:doc "The measured C unit reserves the full digit span before writing.")
				writing
				(then (call write_base62_digits ordinal (borrow-mut output) (i32:from-u32 next) (i32:from-u32 end))))
			(let trailing (name.get trailing))
			(set next end)
			(if
				(:doc "Only names with a human-readable or scratch suffix need a separator.")
				(bool:or (i32:lt (name.get start) (name.get end)) (u8:not-eqz trailing))
				(then (set next (call c_byte (borrow-mut output) next 95u8 writing))))
			(set next (call c_span (borrow-shared source) (name.get start) (name.get end)
				(borrow-mut output) next writing))
			(if
				(:doc "Distinguish the two scratch declarations belonging to one captured argument.")
				(u8:not-eqz trailing)
				(then (return (call c_byte (borrow-mut output) next trailing writing))))
			(return next)))

	(fn scoped_name_role
		(:doc "Put synthetic rows outside the concrete body in a separate ordinal namespace.")
		(params (tag u8) (ordinal i32)) (returns CNameRole)
		(body
			(if (i32:ltz ordinal)
				(then (return (struct:new CNameRole (tag (u8:from-i32 (i32:sub (i32:from-u8 tag) 32i32)))))))
			(return (struct:new CNameRole (tag tag)))))

	(fn scoped_name_ordinal
		(:doc "Use the checked function-relative ordinal or a unique fallback source row.")
		(params (ordinal i32) (fallback i32)) (returns u32)
		(body
			(if (i32:ltz ordinal) (then (return (u32:from-i32 fallback))))
			(return (u32:from-i32 ordinal))))

	(fn write_local_place
		(:doc `Write a direct local or the place reached through an iteration item pointer.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32) (tree_base i32) (indirect bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Parenthesize an indirect place so it can also receive a field projection.")
				indirect
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 40u8 writing))
					(set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))))
			(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes)
				name tree_base (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Close the compound C lvalue before its caller appends members or an assignment.")
				indirect
				(then (return (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(return cursor)))

	(fn write_local_name
		(:doc "Write the defining binding's ordinal and exact source spelling at each use.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let name (nodes.get index))
			(let ordinal (name.get c_ordinal))
			(return (call get_name (call scoped_name_ordinal ordinal (i32:sub index tree_base))
				(call scoped_name_role local_role ordinal)
				(struct:new CNameSpelling (start (name.get start)) (end (name.get end)) (trailing 0u8))
				(borrow-shared source) (borrow-mut output) offset name_prefix writing))))

	(let empty_name "")

	(fn write_callback_adapter_name
		(:doc "Name the file-scope adapter by its unique packed argument row.")
		(params (nodes (shared-array SourceNode)) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(return (call get_name (u32:from-i32 index)
				(struct:new CNameRole (tag callback_adapter_role))
				(struct:new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
				(borrow-shared empty_name) (borrow-mut output) offset name_prefix writing))))

	(fn write_temporary_name
		(:doc "Use the capture anchor's ordinal within its containing function.")
		(params (nodes (shared-array SourceNode)) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let name (nodes.get index))
			(let ordinal (name.get c_ordinal))
			(return (call get_name (call scoped_name_ordinal ordinal index)
				(call scoped_name_role temporary_role ordinal)
				(struct:new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
				(borrow-shared empty_name) (borrow-mut output) offset name_prefix writing))))

	(fn write_loop_label
		(:doc "Use the destination loop's ordinal at the label and every break targeting it.")
		(params (nodes (shared-array SourceNode)) (loop i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let name (nodes.get loop))
			(let ordinal (name.get c_ordinal))
			(return (call get_name (call scoped_name_ordinal ordinal loop)
				(call scoped_name_role loop_label_role ordinal)
				(struct:new CNameSpelling (start 0i32) (end 0i32) (trailing 0u8))
				(borrow-shared empty_name) (borrow-mut output) offset name_prefix writing))))
)
