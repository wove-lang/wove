(module emit_owner_checks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the inline owner slots in an aggregate before transferring it to a Wove call.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_array_owner is_fixed_array is_owning_array_element
		record_index member_value_type (type ScalarRecord)))
	(use wove-file "./members.wove" (only write_member named_member (type CMember)))
	(use wove-file "./records.wove" (only write_record_name))
	(use wove-file "./runtime.wove" (only close_runtime_call write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))

	(let owner_check_flag 2u32)

	(fn has_owner_check
		(:doc "The validation bit shares the layout usage table with the heap slot bit.")
		(params (flags u8)) (returns bool)
		(body (return (u32.not-eqz (u32.and (u32.from-u8 flags) owner_check_flag)))))

	(fn mark_owner_check
		(:doc "Mark each inline dependency once. Heap descriptors end the walk because their slots may be vacant.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32) (used (mut-array u8))) (returns void)
		(body
			(if (bool.not (call is_owning_array_element (borrow-shared records) type)) (then (return)))
			(let index (call record_index type))
			(let flags (array.load used index))
			(if (call has_owner_check flags) (then (return)))
			(array.store used index (u8.from-u32 (u32.or (u32.from-u8 flags) owner_check_flag)))
			(let layout (array.load records index))
			(if
				(:doc "The exact fixed element has one common validator regardless of extent.")
				(call is_fixed_array layout)
				(then
					(if
						(:doc "A zero-length array has no inline elements to visit.")
						(i32.gtz (struct.get layout count))
						(then (call mark_owner_check (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (borrow-shared bindings)
							(u32.from-i32 (struct.get layout first)) (borrow-mut used))))
					(return)))
			(let-mut field (struct.get layout first))
			(while
				(:doc "Ordinary owned record fields can themselves contain inline owner slots.")
				(i32.not-ltz field)
				(body
					(let member (array.load nodes field))
					(let child (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout member))
					(call mark_owner_check (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) child (borrow-mut used))
					(set field (struct.get member next_sibling))))))

	(let require_prefix "wvrt_require_")
	(let open_address "(&")
	(let close_statement ");")
	(let forwarded_site ",wvrt_file,wvrt_start,wvrt_end);")
	(let require_slot "wvrt_inline_slot_require(")
	(let field_access "wvrt_value->")
	(let check_fixed_begin "for(int32_t i=0;i<")
	(let check_fixed_slot ";++i){wvrt_inline_slot_require(wvrt_value->wvrt_items[i].wvrt_live,wvrt_file,wvrt_start,wvrt_end);")
	(let inline_item "wvrt_value->wvrt_items[i].wvrt_value")
	(let require_definition "static inline __attribute__((unused)) void ")
	(let require_parameter "(const ")
	(let require_body "*wvrt_value,int32_t wvrt_file,int32_t wvrt_start,int32_t wvrt_end){")
	(let ignore_arguments "(void)wvrt_value;(void)wvrt_file;(void)wvrt_start;(void)wvrt_end;")
	(let close_definition "}\n")

	(fn write_check_name
		(:doc "Tie the check symbol to the same exact C name as the layout and its destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared require_prefix) (borrow-mut output) offset writing))
			(return (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) prefix name_prefix writing))))

	(fn write_check_address
		(:doc "Open a check call with the address of its already evaluated storage.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let name (call write_check_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) offset name_prefix writing))
			(return (call c_literal_text (borrow-shared open_address) (borrow-mut output) name writing))))

	(fn write_inline_owner_argument_check
		(:doc "Check the captured argument once at its original span before evaluating the next argument.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (argument ScalarExpression)
			(index i32) (tree_base i32) (file i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let open (call write_check_address (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) offset name_prefix writing))
			(let value (call write_temporary_name (borrow-shared source) index tree_base
				(borrow-mut output) open name_prefix writing))
			(let close (call close_runtime_call (borrow-mut output) value file
				(struct.get argument start) (struct.get argument end) writing))
			(return (call c_byte (borrow-mut output) close 59u8 writing))))

	(fn write_fixed_check_body
		(:doc "Require a live slot before looking at its child, so an empty slot is never inspected.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let extent (struct.get layout count))
			(if (i32.eqz extent) (then (return offset)))
			(let loop (call c_literal_text (borrow-shared check_fixed_begin) (borrow-mut output) offset writing))
			(let limit (call write_c_number (borrow-mut output) loop extent writing))
			(let-mut cursor (call c_literal_text (borrow-shared check_fixed_slot) (borrow-mut output) limit writing))
			(let type (u32.from-i32 (struct.get layout first)))
			(if
				(:doc "Recurse through inline children only. A live descriptor can own a heap array with vacant elements.")
				(call is_owning_array_element (borrow-shared records) type)
				(then
					(let open (call write_check_address (borrow-shared source) (borrow-shared nodes)
						(array.load records (call record_index type))
						(borrow-mut output) cursor name_prefix writing))
					(let child (call c_literal_text (borrow-shared inline_item) (borrow-mut output) open writing))
					(set cursor (call c_literal_text (borrow-shared forwarded_site) (borrow-mut output) child writing))))
			(return (call c_byte (borrow-mut output) cursor 125u8 writing))))

	(fn write_owner_field_check
		(:doc "Check a nested inline owner or a nonnullable owned array member, skipping copyable and native fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (name CMember) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let array (call is_array_owner type))
			(let-mut open offset)
			(if
				(:doc "Named fields hold their descriptor directly. Zero means ownership was taken from the member.")
				array
				(then (set open (call c_literal_text (borrow-shared require_slot)
					(borrow-mut output) offset writing)))
				(else
					(if (bool.not (call is_owning_array_element (borrow-shared records) type))
						(then (return offset)))
					(set open (call write_check_address (borrow-shared source) (borrow-shared nodes)
						(array.load records (call record_index type))
						(borrow-mut output) offset name_prefix writing))))
			(let object (call c_literal_text (borrow-shared field_access) (borrow-mut output) open writing))
			(let field (call write_member (borrow-shared source) name
				(borrow-mut output) object name_prefix writing))
			(return (call c_literal_text (borrow-shared forwarded_site) (borrow-mut output) field writing))))

	(fn write_record_check_body
		(:doc "Check each owning member inside the fixed array's record element.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut cursor offset)
			(let-mut field (struct.get layout first))
			(while
				(:doc "Visit the exact substituted field types in declaration order.")
				(i32.not-ltz field)
				(body
					(let member (array.load nodes field))
					(let type (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout member))
					(set cursor (call write_owner_field_check (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) type
						(call named_member (borrow-shared source) layout (array.load nodes (struct.get member first_child)))
						(borrow-mut output)
						cursor name_prefix writing))
					(set field (struct.get member next_sibling))))
			(return cursor)))

	(fn write_owner_check
		(:doc "Emit one completeness helper after its owning inline dependencies have been defined.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared require_definition) (borrow-mut output) offset writing))
			(let name (call write_check_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) prefix name_prefix writing))
			(let param (call c_literal_text (borrow-shared require_parameter) (borrow-mut output) name writing))
			(let type (call write_record_name (borrow-shared source) (borrow-shared nodes) layout
				(borrow-mut output) param name_prefix writing))
			(let body (call c_literal_text (borrow-shared require_body) (borrow-mut output) type writing))
			(let-mut cursor body)
			(if
				(:doc "Fixed arrays check occupancy and named records visit their inline fields.")
				(call is_fixed_array layout)
				(then (set cursor (call write_fixed_check_body (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) layout (borrow-mut output) body name_prefix writing)))
				(else (set cursor (call write_record_check_body (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) layout (borrow-mut output)
					body name_prefix writing))))
			(if
				(:doc "A zero extent or a record with only nullable native owners has no inline checks.")
				(u32.eq cursor body)
				(then (set cursor (call c_literal_text (borrow-shared ignore_arguments)
					(borrow-mut output) cursor writing))))
			(return (call c_literal_text (borrow-shared close_definition) (borrow-mut output) cursor writing))))
)
