(module emit_owner_checks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the inline storage of fixed owners before transferring them to a Wove call.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only is_array_owner is_fixed_array is_owning_array_element is_owning_fixed_array
		record_index member_value_type (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_member_name write_record_name))
	(use wove-file "./runtime.wove" (only close_runtime_call write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))

	(let owner_check_flag 2u32)

	(fn has_owner_check
		(:doc "The validation bit shares the layout usage table with the heap slot bit.")
		(params (flags u8)) (returns bool)
		(body (return (u32.not-eqz (u32.and (u32.from-u8 (local flags)) (local owner_check_flag))))))

	(fn mark_owner_check
		(:doc "Mark each inline dependency once. Heap descriptors end the walk because their slots may be vacant.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32) (used (mut-array u8))) (returns void)
		(body
			(if (bool.not (call is_owning_array_element (borrow-shared (local records)) (local type))) (then (return)))
			(let index (call record_index (local type)))
			(let flags (array.load (local used) (local index)))
			(if (call has_owner_check (local flags)) (then (return)))
			(array.store (local used) (local index) (u8.from-u32 (u32.or (u32.from-u8 (local flags)) (local owner_check_flag))))
			(let layout (array.load (local records) (local index)))
			(if
				(:doc "The exact fixed element has one common validator regardless of extent.")
				(call is_fixed_array (local layout))
				(then
					(if
						(:doc "A zero-length array has no inline elements to visit.")
						(i32.gtz (struct.get (local layout) count))
						(then (call mark_owner_check (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (borrow-shared (local bindings))
							(u32.from-i32 (struct.get (local layout) first)) (borrow-mut (local used)))))
					(return)))
			(let-mut field (struct.get (local layout) first))
			(while
				(:doc "Ordinary owned record fields can themselves contain inline owner slots.")
				(i32.not-ltz (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(let child (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
					(call mark_owner_check (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local child) (borrow-mut (local used)))
					(set (local field) (struct.get (local member) next_sibling))))))

	(let require_prefix "wvrt_require_")
	(let open_address "(&")
	(let close_statement ");")
	(let forwarded_site ",wvrt_file,wvrt_start,wvrt_end);")
	(let require_slot "wvrt_inline_slot_require(")
	(let field_access "wvrt_value->")
	(let check_fixed_begin "for(int32_t i=0;i<")
	(let check_fixed_slot ";++i){wvrt_inline_slot_require(wvrt_value->wvrt_items[i].wvrt_live,wvrt_file,wvrt_start,wvrt_end);")
	(let inline_item "wvrt_value->wvrt_items[i].wvrt_value")
	(let require_definition "static inline __attribute__((unused)) void ")
	(let require_parameter "(const ")
	(let require_body "*wvrt_value,int32_t wvrt_file,int32_t wvrt_start,int32_t wvrt_end){")
	(let ignore_arguments "(void)wvrt_value;(void)wvrt_file;(void)wvrt_start;(void)wvrt_end;")
	(let close_definition "}\n")

	(fn write_check_name
		(:doc "Tie the check symbol to the same exact C name as the layout and its destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared (local require_prefix)) (borrow-mut (local output)) (local offset) (local writing)))
			(return (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local prefix) (local name_prefix) (local writing)))))

	(fn write_check_address
		(:doc "Open a check call with the address of its already evaluated storage.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let name (call write_check_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local open_address)) (borrow-mut (local output)) (local name) (local writing)))))

	(fn write_fixed_argument_check
		(:doc "Check the captured argument once at its original span before evaluating the next argument.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (argument ScalarExpression)
			(index i32) (tree_base i32) (file i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let open (call write_check_address (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let close (call close_runtime_call (borrow-mut (local output)) (local value) (local file)
				(struct.get (local argument) start) (struct.get (local argument) end) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local close) 59u8 (local writing)))))

	(fn write_fixed_check_body
		(:doc "Require a live slot before looking at its child, so an empty slot is never inspected.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (layout ScalarRecord)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let extent (struct.get (local layout) count))
			(if (i32.eqz (local extent)) (then (return (local offset))))
			(let loop (call c_literal_text (borrow-shared (local check_fixed_begin)) (borrow-mut (local output)) (local offset) (local writing)))
			(let limit (call write_c_number (borrow-mut (local output)) (local loop) (local extent) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local check_fixed_slot)) (borrow-mut (local output)) (local limit) (local writing)))
			(let type (u32.from-i32 (struct.get (local layout) first)))
			(if
				(:doc "Recurse through inline children only. A live descriptor can own a heap array with vacant elements.")
				(call is_owning_array_element (borrow-shared (local records)) (local type))
				(then
					(let open (call write_check_address (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local records) (call record_index (local type)))
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(let child (call c_literal_text (borrow-shared (local inline_item)) (borrow-mut (local output)) (local open) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local forwarded_site)) (borrow-mut (local output)) (local child) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 125u8 (local writing)))))

	(fn write_owner_field_check
		(:doc "Check a nested inline owner or a nonnullable owned array member, skipping copyable and native fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(type u32) (ordinal i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let array (call is_array_owner (local type)))
			(let-mut open (local offset))
			(if
				(:doc "Named fields hold their descriptor directly. Zero means ownership was taken from the member.")
				(local array)
				(then (set (local open) (call c_literal_text (borrow-shared (local require_slot))
					(borrow-mut (local output)) (local offset) (local writing))))
				(else
					(if (bool.not (call is_owning_array_element (borrow-shared (local records)) (local type)))
						(then (return (local offset))))
					(set (local open) (call write_check_address (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local records) (call record_index (local type)))
						(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(let object (call c_literal_text (borrow-shared (local field_access)) (borrow-mut (local output)) (local open) (local writing)))
			(let field (call write_member_name (borrow-shared (local source)) (local ordinal)
				(borrow-mut (local output)) (local object) (local name_prefix) (local writing)))
			(return (call c_literal_text (borrow-shared (local forwarded_site)) (borrow-mut (local output)) (local field) (local writing)))))

	(fn write_record_check_body
		(:doc "Check each owning member inside the fixed array's record element.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut field (struct.get (local layout) first))
			(let-mut ordinal 0i32)
			(while
				(:doc "Visit the exact substituted field types in declaration order.")
				(i32.not-ltz (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
					(set (local cursor) (call write_owner_field_check (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local type) (local ordinal) (borrow-mut (local output))
						(local cursor) (local name_prefix) (local writing)))
					(set (local ordinal) (i32.inc (local ordinal)))
					(set (local field) (struct.get (local member) next_sibling))))
			(return (local cursor))))

	(fn write_owner_check
		(:doc "Emit one completeness helper after its owning inline dependencies have been defined.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool)) (returns u32)
		(body
			(let prefix (call c_literal_text (borrow-shared (local require_definition)) (borrow-mut (local output)) (local offset) (local writing)))
			(let name (call write_check_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local prefix) (local name_prefix) (local writing)))
			(let param (call c_literal_text (borrow-shared (local require_parameter)) (borrow-mut (local output)) (local name) (local writing)))
			(let type (call write_record_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local layout)
				(borrow-mut (local output)) (local param) (local name_prefix) (local writing)))
			(let body (call c_literal_text (borrow-shared (local require_body)) (borrow-mut (local output)) (local type) (local writing)))
			(let-mut cursor (local body))
			(if
				(:doc "Fixed arrays check occupancy and named records visit their inline fields.")
				(call is_fixed_array (local layout))
				(then (set (local cursor) (call write_fixed_check_body (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (local layout) (borrow-mut (local output)) (local body) (local name_prefix) (local writing))))
				(else (set (local cursor) (call write_record_check_body (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (borrow-mut (local output))
					(local body) (local name_prefix) (local writing)))))
			(if
				(:doc "A zero extent or a record with only nullable native owners has no inline checks.")
				(u32.eq (local cursor) (local body))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local ignore_arguments))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_literal_text (borrow-shared (local close_definition)) (borrow-mut (local output)) (local cursor) (local writing)))))
)
