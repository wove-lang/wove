(module emit_array_growth
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit array growth calls on the original allocation descriptor after evaluating the operand.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/array_growth.wove" (only (value indexed_row_owner) (value array_capacity_kind) (value array_push_kind)
		(value array_remove_kind) (value array_truncate_kind) (value array_reserve_kind) (value array_try_reserve_kind) (value array_try_extend_kind) (value array_try_push_kind)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression) (value indirect_local_place)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only is_array_owner is_owning_array_element array_owner_element record_index (type ScalarRecord)))
	(use wove-file "./owned_aggregates.wove" (only open_owned_slot_call))
	(use wove-file "./records.wove" (only write_value_type write_field_place))
	(use wove-file "./enums.wove" (only close_transfer_outcome))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name write_local_place))

	(let capacity_member ")->wvrt_capacity")
	(let push_call "wvrt_array_push_at_span(")
	(let remove_call "wvrt_array_remove_value(")
	(let remove_row_call "wvrt_array_remove_row_at_span(")
	(let owned_push_call "wvrt_owned_array_push(")
	(let owned_remove_call "wvrt_owned_array_remove(")
	(let truncate_call "wvrt_array_truncate_at_span(")
	(let reserve_call "wvrt_array_reserve_at_span(")
	(let try_reserve_call "wvrt_array_try_reserve(")
	(let try_extend_call "wvrt_array_try_extend(")
	(let try_push_call "(wvrt_array_try_push(")
	(let owned_try_push_call "(wvrt_owned_array_try_push(")

	(let indexed_owner_call "wvrt_array_row_owner_at_span(")

	(fn write_indexed_row_owner
		(:doc "Select the checked live row descriptor using its once-evaluated parent and index.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let parent (struct.get (local expression) first))
			(let index (struct.get (array.load (local nodes) (local parent)) next_sibling))
			(let open (call c_literal_text (borrow-shared (local indexed_owner_call))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let owner (call write_temporary_name (borrow-shared (local source)) (local parent) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local owner) 44u8 (local writing)))
			(let subscript (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local subscript)
				(struct.get (local expression) target) (struct.get (local expression) start)
				(struct.get (local expression) end) (local writing)))))

	(fn write_growth_receiver
		(:doc `Read the checked row capture or the original local or field.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(parameters (shared-array ScalarParameter)) (place i32) (tree_base i32) (output (mut-array u8))
			(offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let owner (array.load (local expressions) (local place)))
			(if
				(:doc "The indexed receiver was checked before later operands ran.")
				(u32.eq (struct.get (local owner) kind) (local indexed_row_owner))
				(then (return (call write_temporary_name (borrow-shared (local source)) (local place) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "A projected field can be rooted in either a local record or an existing record reference.")
				(u32.eq (struct.get (local owner) kind) 52u32)
				(then (return (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local place) (local tree_base)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call write_local_place (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local owner) target) (local tree_base)
				(i32.eq (struct.get (local owner) projection) (local indirect_local_place))
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))

	(fn open_growth_call
		(:doc `Select the runtime operation that matches the checked growth tag.`)
		(params (kind u32) (remove_row bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "An append passes the address of its captured value.")
				(u32.eq (local kind) (local array_push_kind))
				(then (return (call c_literal_text (borrow-shared (local push_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Removing a row returns the original byte owner.")
				(local remove_row)
				(then (return (call c_literal_text (borrow-shared (local remove_row_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Removal opens a typed expression backed by the runtime operation.")
				(u32.eq (local kind) (local array_remove_kind))
				(then (return (call c_literal_text (borrow-shared (local remove_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Truncation retains the current allocation.")
				(u32.eq (local kind) (local array_truncate_kind))
				(then (return (call c_literal_text (borrow-shared (local truncate_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The trapping reservation carries the original source location.")
				(u32.eq (local kind) (local array_reserve_kind))
				(then (return (call c_literal_text (borrow-shared (local reserve_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Extend reports failure without transferring any source element.")
				(u32.eq (local kind) (local array_try_extend_kind))
				(then (return (call c_literal_text (borrow-shared (local try_extend_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The append result selects which variant receives the captured value.")
				(u32.eq (local kind) (local array_try_push_kind))
				(then (return (call c_literal_text (borrow-shared (local try_push_call)) (borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local try_reserve_call)) (borrow-mut (local output)) (local offset) (local writing)))))

	(fn open_owned_growth_call
		(:doc "Choose a growth macro that preserves the record slot's initialized flag.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (kind u32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A rejected recoverable append returns its record instead of dropping the slot.")
				(u32.eq (local kind) (local array_try_push_kind))
				(then (return (call open_owned_slot_call (borrow-shared (local source)) (borrow-shared (local nodes))
					(local layout) (borrow-shared (local owned_try_push_call)) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(if
				(:doc "The trapping append runs the slot destructor if growth fails.")
				(u32.eq (local kind) (local array_push_kind))
				(then (return (call open_owned_slot_call (borrow-shared (local source)) (borrow-shared (local nodes))
					(local layout) (borrow-shared (local owned_push_call)) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))
			(return (call open_owned_slot_call (borrow-shared (local source)) (borrow-shared (local nodes))
				(local layout) (borrow-shared (local owned_remove_call)) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))

	(fn write_array_growth
		(:doc `Write the growth call or capacity query. Mutation starts after the operand is captured.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get (local expression) kind))
			(let place (struct.get (local expression) projection))
			(if
				(:doc "Capacity reads the descriptor directly without changing its bounds.")
				(u32.eq (local kind) (local array_capacity_kind))
				(then
					(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
					(let owner (call write_growth_receiver (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local place) (local tree_base)
						(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
					(return (call c_literal_text (borrow-shared (local capacity_member)) (borrow-mut (local output)) (local owner) (local writing)))))
			(let remove (u32.eq (local kind) (local array_remove_kind)))
			(let try_push (u32.eq (local kind) (local array_try_push_kind)))
			(let push (bool.or (u32.eq (local kind) (local array_push_kind)) (local try_push)))
			(let remove_row (bool.and (local remove) (call is_array_owner (struct.get (local expression) type))))
			(let owner (array.load (local expressions) (local place)))
			(let element (call array_owner_element (borrow-shared (local records)) (struct.get (local owner) type)))
			(let wrapped (bool.and (bool.or (local remove) (local push))
				(call is_owning_array_element (borrow-shared (local records)) (local element))))
			(let-mut cursor (local offset))
			(if
				(:doc "An owning slot transfers the record and its initialized state together.")
				(local wrapped)
				(then (set (local cursor) (call open_owned_growth_call (borrow-shared (local source))
					(borrow-shared (local nodes)) (array.load (local records) (call record_index (local element))) (local kind)
					(borrow-mut (local output)) (local offset) (local name_prefix) (local writing))))
				(else (set (local cursor) (call open_growth_call (local kind) (local remove_row)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Copyable removal supplies the exact C type of its result slot.")
				(bool.and (local remove) (bool.not (bool.or (local remove_row) (local wrapped))))
				(then
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (struct.get (local expression) type)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))))
			(set (local cursor) (call write_growth_receiver (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local place) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(if
				(:doc "Pass the captured copy or moved owner from outside the array's backing storage.")
				(bool.and (local push) (bool.not (local wrapped)))
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (struct.get (local expression) first)
				(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "A recoverable reserve or extend returns its success flag directly.")
				(bool.or (u32.eq (local kind) (local array_try_reserve_kind)) (u32.eq (local kind) (local array_try_extend_kind)))
				(then (return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(if
				(:doc "Assemble the outcome only after the runtime decided whether the append took ownership.")
				(local try_push)
				(then
					(let condition (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))
					(return (call close_transfer_outcome (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (struct.get (local expression) type) (struct.get (local expression) asset_start)
						(struct.get (local expression) first) (local tree_base) (borrow-mut (local output))
						(local condition) (local name_prefix) (local writing)))))
			(return (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(struct.get (local expression) target) (struct.get (local expression) start)
				(struct.get (local expression) end) (local writing))))))
