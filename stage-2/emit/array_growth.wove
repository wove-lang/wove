(module emit_array_growth
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit array growth calls on the original allocation descriptor after evaluating the operand.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/array_growth.wove" (only (value indexed_row_owner) (value array_capacity_kind) (value array_push_kind)
		(value array_remove_kind) (value array_truncate_kind) (value array_reserve_kind) (value array_try_reserve_kind) (value array_try_extend_kind) (value array_try_push_kind)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression) (value indirect_local_place)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only is_array_owner is_owning_array_element array_owner_element record_index (type ScalarRecord)))
	(use wove-file "./owned_aggregates.wove" (only open_owned_slot_call))
	(use wove-file "./records.wove" (only write_value_type write_field_place))
	(use wove-file "./enums.wove" (only close_transfer_outcome))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name write_local_place))

	(let capacity_member ")->wvrt_capacity")
	(let push_call "wvrt_array_push_at_span(")
	(let remove_call "wvrt_array_remove_value(")
	(let remove_row_call "wvrt_array_remove_row_at_span(")
	(let owned_push_call "wvrt_owned_array_push(")
	(let owned_remove_call "wvrt_owned_array_remove(")
	(let truncate_call "wvrt_array_truncate_at_span(")
	(let reserve_call "wvrt_array_reserve_at_span(")
	(let try_reserve_call "wvrt_array_try_reserve(")
	(let try_extend_call "wvrt_array_try_extend(")
	(let try_push_call "(wvrt_array_try_push(")
	(let owned_try_push_call "(wvrt_owned_array_try_push(")

	(let indexed_owner_call "wvrt_array_row_owner_at_span(")

	(fn write_indexed_row_owner
		(:doc "Select the checked live row descriptor using its once-evaluated parent and index.")
		(params (nodes (shared-array SourceNode)) (expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let parent expression/first)
			(let index (struct:get (nodes.get parent) next_sibling))
			(let open (call c_literal_text (borrow-shared indexed_owner_call)
				(borrow-mut output) offset writing))
			(let owner (call write_temporary_name (borrow-shared nodes) parent
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) owner 44u8 writing))
			(let subscript (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) comma name_prefix writing))
			(return (call close_runtime_call (borrow-mut output) subscript
				expression/target expression/start
				expression/end writing))))

	(fn write_growth_receiver
		(:doc `Read the checked row capture or the original local or field.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (place i32) (tree_base i32) (output (mut-array u8))
			(offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let owner (expressions.get place))
			(if
				(:doc "The indexed receiver was checked before later operands ran.")
				(owner/kind.eq indexed_row_owner)
				(then (return (call write_temporary_name (borrow-shared nodes) place
					(borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "A projected field can be rooted in either a local record or an existing record reference.")
				(owner/kind.eq 52u32)
				(then (return (call write_field_place (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) place tree_base
					(borrow-mut output) offset name_prefix writing))))
			(return (call write_local_place (borrow-shared source) (borrow-shared nodes)
				owner/target tree_base
				(owner/projection.eq indirect_local_place)
				(borrow-mut output) offset name_prefix writing))))

	(fn open_growth_call
		(:doc `Select the runtime operation that matches the checked growth tag.`)
		(params (kind u32) (remove_row bool) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "An append passes the address of its captured value.")
				(kind.eq array_push_kind)
				(then (return (call c_literal_text (borrow-shared push_call) (borrow-mut output) offset writing))))
			(if
				(:doc "Removing a row returns the original byte owner.")
				remove_row
				(then (return (call c_literal_text (borrow-shared remove_row_call) (borrow-mut output) offset writing))))
			(if
				(:doc "Removal opens a typed expression backed by the runtime operation.")
				(kind.eq array_remove_kind)
				(then (return (call c_literal_text (borrow-shared remove_call) (borrow-mut output) offset writing))))
			(if
				(:doc "Truncation retains the current allocation.")
				(kind.eq array_truncate_kind)
				(then (return (call c_literal_text (borrow-shared truncate_call) (borrow-mut output) offset writing))))
			(if
				(:doc "The trapping reservation carries the original source location.")
				(kind.eq array_reserve_kind)
				(then (return (call c_literal_text (borrow-shared reserve_call) (borrow-mut output) offset writing))))
			(if
				(:doc "Extend reports failure without transferring any source element.")
				(kind.eq array_try_extend_kind)
				(then (return (call c_literal_text (borrow-shared try_extend_call) (borrow-mut output) offset writing))))
			(if
				(:doc "The append result selects which variant receives the captured value.")
				(kind.eq array_try_push_kind)
				(then (return (call c_literal_text (borrow-shared try_push_call) (borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared try_reserve_call) (borrow-mut output) offset writing))))

	(fn open_owned_growth_call
		(:doc "Choose a growth macro that preserves the record slot's initialized flag.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (kind u32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "A rejected recoverable append returns its record instead of dropping the slot.")
				(kind.eq array_try_push_kind)
				(then (return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared owned_try_push_call) (borrow-mut output) offset name_prefix writing))))
			(if
				(:doc "The trapping append runs the slot destructor if growth fails.")
				(kind.eq array_push_kind)
				(then (return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
					layout (borrow-shared owned_push_call) (borrow-mut output) offset name_prefix writing))))
			(return (call open_owned_slot_call (borrow-shared source) (borrow-shared nodes)
				layout (borrow-shared owned_remove_call) (borrow-mut output) offset name_prefix writing))))

	(fn write_array_growth
		(:doc `Write the growth call or capacity query. Mutation starts after the operand is captured.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind expression/kind)
			(let place expression/projection)
			(if
				(:doc "Capacity reads the descriptor directly without changing its bounds.")
				(kind.eq array_capacity_kind)
				(then
					(let open (call c_byte (borrow-mut output) offset 40u8 writing))
					(let owner (call write_growth_receiver (borrow-shared source) (borrow-shared nodes)
						(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) place tree_base
						(borrow-mut output) open name_prefix writing))
					(return (call c_literal_text (borrow-shared capacity_member) (borrow-mut output) owner writing))))
			(let remove (kind.eq array_remove_kind))
			(let try_push (kind.eq array_try_push_kind))
			(let push (bool:or (kind.eq array_push_kind) try_push))
			(let remove_row (remove.and (call is_array_owner expression/type)))
			(let owner (expressions.get place))
			(let element (call array_owner_element (borrow-shared records) owner/type))
			(let wrapped (bool:and (remove.or push)
				(call is_owning_array_element (borrow-shared records) element)))
			(let-mut cursor offset)
			(if
				(:doc "An owning slot transfers the record and its initialized state together.")
				wrapped
				(then (set cursor (call open_owned_growth_call (borrow-shared source)
					(borrow-shared nodes) (records.get (call record_index element)) kind
					(borrow-mut output) offset name_prefix writing)))
				(else (set cursor (call open_growth_call kind remove_row
					(borrow-mut output) offset writing))))
			(if
				(:doc "Copyable removal supplies the exact C type of its result slot.")
				(remove.and (bool:not (remove_row.or wrapped)))
				(then
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) expression/type
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
			(set cursor (call write_growth_receiver (borrow-shared source) (borrow-shared nodes)
				(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) place tree_base
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(if
				(:doc "Pass the captured copy or moved owner from outside the array's backing storage.")
				(push.and wrapped.not)
				(then (set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(set cursor (call write_temporary_name (borrow-shared nodes) expression/first (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "A recoverable reserve or extend returns its success flag directly.")
				(bool:or (kind.eq array_try_reserve_kind) (kind.eq array_try_extend_kind))
				(then (return (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(if
				(:doc "Assemble the outcome only after the runtime decided whether the append took ownership.")
				try_push
				(then
					(let condition (call c_byte (borrow-mut output) cursor 41u8 writing))
					(return (call close_transfer_outcome (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) expression/type expression/asset_start
						expression/first (borrow-mut output)
						condition name_prefix writing))))
			(return (call close_runtime_call (borrow-mut output) cursor
				expression/target expression/start
				expression/end writing)))))
