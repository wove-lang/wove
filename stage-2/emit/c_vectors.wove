(module emit_c_vectors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit detached call vectors and owned snapshots of borrowed C string tables.`)

	(use wove-file "../c/arguments.wove" (only is_c_vector_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_span write_temporary_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))

	(let vector_type "char *const *")
	(let prepare_open "=wvrt_cstrs_prepare(")
	(let drop_open "wvrt_cstrs_drop(")
	(let snapshot_decl "extern char **")
	(let snapshot_decl_end ";\n")
	(let snapshot_open "wvrt_snapshot_cstrs_at_span(")

	(fn write_c_vector_name
		(:doc `Name a table using the captured view's source position and a suffix reserved for vector scratch.`)
		(params (nodes (shared-array SourceNode)) (argument i32) (output (mut-array u8))
			(offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) offset name_prefix writing))
			(let suffix (call c_byte (borrow-mut output) name 95u8 writing))
			(return (call c_byte (borrow-mut output) suffix 118u8 writing))))

	(fn write_vector_scratch
		(:doc `Prepare a captured view before invocation or release its table after result adaptation.`)
		(params (nodes (shared-array SourceNode)) (node SourceNode) (argument i32) (caller ScalarFunction)
			(release bool) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Cleanup only uses the vector temporary and preserves the call's errno.")
				release
				(then
					(let open (call c_literal_text (borrow-shared drop_open) (borrow-mut output) offset writing))
					(let name (call write_c_vector_name (borrow-shared nodes) argument
						(borrow-mut output) open name_prefix writing))
					(let close (call c_byte (borrow-mut output) name 41u8 writing))
					(return (call c_byte (borrow-mut output) close 59u8 writing))))
			(let type (call c_literal_text (borrow-shared vector_type) (borrow-mut output) offset writing))
			(let name (call write_c_vector_name (borrow-shared nodes) argument
				(borrow-mut output) type name_prefix writing))
			(let open (call c_literal_text (borrow-shared prepare_open) (borrow-mut output) name writing))
			(let view (call write_temporary_name (borrow-shared nodes) argument
				(borrow-mut output) open name_prefix writing))
			(let base caller/source_base)
			(let close (call close_runtime_call (borrow-mut output) view caller/file
				(i32:sub node/start base)
				(i32:sub node/end base) writing))
			(return (call c_byte (borrow-mut output) close 59u8 writing))))

	(fn write_c_vector_scratch
		(:doc `Visit the C string vectors in the checked formal order.`)
		(params (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(first i32) (caller ScalarFunction) (callee ScalarFunction) (release bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut argument first)
			(let-mut formal callee/params)
			(let-mut cursor offset)
			(while
				(:doc "Each vector argument owns one temporary table.")
				(i32:lt -1i32 argument)
				(body
					(let node (nodes.get argument))
					(if
						(:doc "Other captured arguments have their own conversion rules.")
						(call is_c_vector_mode (struct:get (parameters.get formal) c_mode))
						(then (set cursor (call write_vector_scratch (borrow-shared nodes) node
							argument caller release (borrow-mut output)
							cursor name_prefix writing))))
					(set formal formal.inc)
					(set argument node/next_sibling)))
			(return cursor)))

	(fn write_c_vector_declaration
		(:doc `Declare the borrowed global's exact C type once, including when the header omits it.`)
		(params (source (shared-array u8)) (name SourceNode) (output (mut-array u8))
			(offset u32) (writing bool))
		(returns u32)
		(body
			(let declare (call c_literal_text (borrow-shared snapshot_decl) (borrow-mut output) offset writing))
			(let symbol (call c_span (borrow-shared source) name/start name/end
				(borrow-mut output) declare writing))
			(return (call c_literal_text (borrow-shared snapshot_decl_end) (borrow-mut output) symbol writing))))

	(fn write_c_vector_snapshot
		(:doc `Copy the borrowed global's current rows into distinct Wove owners at this use.`)
		(params (source (shared-array u8)) (name SourceNode) (site ScalarExpression)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared snapshot_open) (borrow-mut output) offset writing))
			(let value (call c_span (borrow-shared source) name/start name/end
				(borrow-mut output) open writing))
			(return (call close_runtime_call (borrow-mut output) value site/target
				site/start site/end writing)))))
