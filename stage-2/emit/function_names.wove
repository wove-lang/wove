(module emit_function_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write defining function names shared by calls, declarations, and worker adapters.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./c_arguments.wove" (only c_symbol_text))
	(use wove-file "./text.wove" (only write_declaration_name function_name_role))

	(fn write_function_name
		(:doc `Write the native bridge symbol or a stable name for a Wove function.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let name (array.load (local nodes) (struct.get (local function) name)))
			(if
				(:doc "A C bridge call uses the spelling declared in its native header.")
				(i32.ltz (struct.get (local function) body))
				(then (return (call c_symbol_text (borrow-shared (local source)) (local name)
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call write_declaration_name (borrow-mut (local output)) (local offset) (local writing) (local name_prefix) (call function_name_role)
				(struct.get (local function) identity) (struct.get (local function) c_name_slot) (borrow-shared (local source))
				(struct.get (local name) start) (struct.get (local name) end)))))
)
