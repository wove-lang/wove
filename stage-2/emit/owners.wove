(module emit_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit the native pointer type and destructor of a checked C resource.

	Read both from the defining bridge type. The runtime representation
	is the pointer itself, including a null result.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/c_owners.wove" (only read_c_owner (type COwnerRead)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../scalar/owners.wove" (only is_native_owner native_owner_declaration))
	(use wove-file "../scalar/plan.wove" (only (type ScalarExpression)))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_span c_type_text write_temporary_name))

	(fn native_owner_contract
		(:doc `Recover the checked operands from the owner's defining tree row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (type u32))
		(returns COwnerRead)
		(body (return (call read_c_owner (borrow-shared (local source)) (borrow-shared (local nodes))
			(slice.load (local nodes) (call native_owner_declaration (local type)))))))

	(fn write_bridge_result_type
		(:doc `Write a bridge result in its native scalar or checked pointer representation.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (type u32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Use ordinary C type names for scalar results.")
				(bool.not (call is_native_owner (local type)))
				(then (return (call c_type_text (borrow-mut (local output)) (local offset) (local type) (local writing)))))
			(let owner (call native_owner_contract (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(let literal (slice.load (local nodes) (record.get (local owner) native)))
			(let start (record.get (local literal) start))
			(let end (record.get (local literal) end))
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(record.make Token (kind (u32 2)) (start (local start)) (end (local end)) (error (u32 0)))
				(borrow-mut (local decoded))))
			(return (call c_span (borrow-shared (local decoded)) (i32 0) (record.get (local value) written)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_native_destructor
		(:doc `Write the original C destructor symbol for this exact resource type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (type u32)
			(output (mut-slice u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let owner (call native_owner_contract (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(let drop (slice.load (local nodes) (record.get (local owner) drop)))
			(return (call c_span (borrow-shared (local source)) (record.get (local drop) start) (record.get (local drop) end)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_native_handle_borrow
		(:doc `Check the evaluated pointer at the borrow's original span, then pass it unchanged.`)
		(params (source (shared-slice u8)) (site ScalarExpression) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 119) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 118) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 114) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 116) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 104) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 107) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 99) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 95) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 104) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 97) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 110) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 100) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 108) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 101) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 40) (local writing)))
			(let reference (record.get (local site) first))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local reference) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(record.get (local site) target) (record.get (local site) start) (record.get (local site) end) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local reference) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) (u8 41) (local writing))))))
