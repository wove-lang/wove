(module emit_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit the native pointer type and destructor of a checked C resource.

	Read both from the defining bridge type. Pointer handles keep
	the native pointer, and caller-owned storage uses a lifetime wrapper.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/c_owners.wove" (only read_c_owner (type COwnerRead)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../scalar/owners.wove" (only is_native_owner native_owner_declaration native_storage_init_borrow_kind))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text c_type_text write_local_name write_temporary_name))

	(fn native_owner_contract
		(:doc `Recover the checked operands from the owner's defining tree row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32))
		(returns COwnerRead)
		(body (return (call read_c_owner (borrow-shared (local source)) (borrow-shared (local nodes))
			(array.load (local nodes) (call native_owner_declaration (local type)))))))

	(let storage_owner_type "wvrt_c_storage*")

	(fn write_bridge_result_type
		(:doc `Write a bridge result in its native scalar or checked pointer representation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Use ordinary C type names for scalar results.")
				(bool.not (call is_native_owner (local type)))
				(then (return (call c_type_text (borrow-mut (local output)) (local offset) (local type) (local writing)))))
			(let owner (call native_owner_contract (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(if
				(:doc "A storage owner carries its native address and initialization state together.")
				(struct.get (local owner) storage)
				(then (return (call c_literal_text (borrow-shared (local storage_owner_type))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call write_native_type (borrow-shared (local source))
				(array.load (local nodes) (struct.get (local owner) native))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_native_type
		(:doc `Write the decoded C representation checked in the defining bridge.`)
		(params (source (shared-array u8)) (literal SourceNode)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let start (struct.get (local literal) start))
			(let end (struct.get (local literal) end))
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local decoded))))
			(return (call c_span (borrow-shared (local decoded)) 0i32 (struct.get (local value) written)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_native_destructor
		(:doc `Write the original C destructor symbol for this exact resource type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let owner (call native_owner_contract (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(let drop (array.load (local nodes) (struct.get (local owner) drop)))
			(return (call c_span (borrow-shared (local source)) (struct.get (local drop) start) (struct.get (local drop) end)
				(borrow-mut (local output)) (local offset) (local writing)))))

	(let c_handle_check "wvrt_check_c_handle(")
	(let c_storage_access "wvrt_c_storage_access(")

	(fn write_native_handle_check
		(:doc `Validate a captured owner before lending or transferring its native address.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let owner (call native_owner_contract (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local site) type)))
			(let storage (struct.get (local owner) storage))
			(let-mut cursor (local offset))
			(if
				(:doc "Storage checks activation as well as the presence of the wrapper.")
				(local storage)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local c_storage_access))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local c_handle_check))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (struct.get (local site) first)
				(local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Only the c_init path accepts an inactive allocation.")
				(local storage)
				(then
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(let-mut flag 48u8)
					(if
						(:doc "Set the initializing bit only for an initializing loan.")
						(u32.eq (struct.get (local site) kind) (call native_storage_init_borrow_kind))
						(then (set (local flag) 49u8)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local flag) (local writing)))))
			(return (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(struct.get (local site) target) (struct.get (local site) start) (struct.get (local site) end) (local writing)))))

	(let cleared_handle "=0,")

	(fn write_owner_transfer
		(:doc `Check a captured pointer and clear its original owner when the consuming argument executes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (expression ScalarExpression)
			(local_name i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let checked (call write_native_handle_check (borrow-shared (local source)) (borrow-shared (local nodes)) (local expression) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local checked) 44u8 (local writing)))
			(let slot (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local local_name)
				(local tree_base) (borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(let cleared (call c_literal_text (borrow-shared (local cleared_handle)) (borrow-mut (local output)) (local slot) (local writing)))
			(let pointer (call write_temporary_name (borrow-shared (local source)) (struct.get (local expression) first) (local tree_base)
				(borrow-mut (local output)) (local cleared) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local pointer) 41u8 (local writing)))))

	(fn write_native_handle_borrow
		(:doc `Check and capture the owner at the borrow's original span before evaluating later arguments.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let checked (call write_native_handle_check (borrow-shared (local source)) (borrow-shared (local nodes)) (local site) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local checked) 44u8 (local writing)))
			(let pointer (call write_temporary_name (borrow-shared (local source)) (struct.get (local site) first)
				(local tree_base) (borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local pointer) 41u8 (local writing))))))
