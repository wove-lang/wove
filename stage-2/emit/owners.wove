(module emit_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit the native pointer type and destructor of a checked C resource.

	Read both from the defining bridge type. Pointer handles keep
	the native pointer, and caller-owned storage uses a lifetime wrapper.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/c_owners.wove" (only read_c_owner c_owner_uses_typedef (type COwnerRead)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../scalar/owners.wove" (only native_storage_init_borrow_kind))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner native_owner_declaration))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./runtime.wove" (only close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_span c_literal_text c_type_text write_temporary_name))

	(fn native_owner_contract
		(:doc `Recover the checked operands from the owner's defining tree row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32))
		(returns COwnerRead)
		(body (return (call read_c_owner (borrow-shared source) (borrow-shared nodes)
			(nodes.get (call native_owner_declaration type))))))

	(fn is_numbered_storage_owner
		(:doc "Recognize fixed native storage with a named destructor and no variable-sized members.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32))
		(returns bool)
		(body
			(if (bool:not (call is_native_owner type)) (then (return (bool false))))
			(let owner (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(return (bool:and (owner/storage.and owner/drop.not-ltz)
				(bool:and owner/tail.ltz owner/vector.ltz)))))

	(fn is_numbered_pointer_owner
		(:doc "Select an ordinary nullable native pointer with a destructor for its exact pointer type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32))
		(returns bool)
		(body
			(if (bool:not (call is_native_owner type)) (then (return (bool false))))
			(let owner (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(let drop owner/drop)
			(if
				(:doc "Storage owners and owners with extra layout contracts have separate proofs.")
				(bool:or (owner/storage.or drop.ltz)
					(bool:or owner/tail.not-ltz owner/vector.not-ltz))
				(then (return (bool false))))
			(return (i32:ltz (struct:get (nodes.get drop) next_sibling)))))

	(let storage_owner_type "wvrt_c_storage*")

	(fn write_bridge_result_type
		(:doc `Write a bridge result in its native scalar or checked pointer representation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "Use ordinary C type names for scalar results.")
				(bool:not (call is_native_owner type))
				(then (return (call c_type_text (borrow-mut output) offset type writing))))
			(let owner (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(if
				(:doc "A storage owner carries its native address and initialization state together.")
				owner/storage
				(then (return (call c_literal_text (borrow-shared storage_owner_type)
					(borrow-mut output) offset writing))))
			(return (call write_native_type (borrow-shared source)
				(nodes.get owner/native)
				(borrow-mut output) offset writing))))

	(fn write_native_type
		(:doc `Write the decoded C representation checked in the defining bridge.`)
		(params (source (shared-array u8)) (literal SourceNode)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let start literal/start)
			(let end literal/end)
			(let-mut decoded (array:alloc u8 (end.sub start)))
			(let value (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(return (call c_span (borrow-shared decoded) 0i32 value/written
				(borrow-mut output) offset writing))))

	(fn write_native_destructor_name
		(:doc "Write the original C destructor symbol from the resource contract.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (owner COwnerRead)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let drop (nodes.get owner/drop))
			(return (call c_span (borrow-shared source) drop/start drop/end
				(borrow-mut output) offset writing))))

	(fn write_native_destructor
		(:doc "Write the cleanup callee. A checked typedef calls the same function verified by its C assertion.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type u32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let owner (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(if
				(:doc "Legacy explicit pointer and storage contracts retain their original call spelling.")
				(bool:not (call c_owner_uses_typedef (borrow-shared source) (borrow-shared nodes) owner))
				(then (return (call write_native_destructor_name (borrow-shared source) (borrow-shared nodes)
					owner (borrow-mut output) offset writing))))
			(let opening (call c_byte (borrow-mut output) offset 40u8 writing))
			(let symbol (call write_native_destructor_name (borrow-shared source) (borrow-shared nodes)
				owner (borrow-mut output) opening writing))
			(return (call c_byte (borrow-mut output) symbol 41u8 writing))))

	(let pointer_typedef_open "WVRT_CHECK_C_POINTER_TYPEDEF(")
	(let pointer_owner_open "WVRT_CHECK_C_POINTER_OWNER(")
	(let void_owner_open "WVRT_CHECK_C_VOID_POINTER_OWNER(")
	(let pointer_check_close ");\n")

	(fn write_c_pointer_typedef_check
		(:doc "Verify a fixed operand's native pointer typedef after the header has been included.")
		(params (source (shared-array u8)) (literal SourceNode) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared pointer_typedef_open)
				(borrow-mut output) offset writing))
			(let type (call write_native_type (borrow-shared source) literal
				(borrow-mut output) open writing))
			(return (call c_literal_text (borrow-shared pointer_check_close)
				(borrow-mut output) type writing))))

	(fn write_c_pointer_owner_checks
		(:doc "Verify the native pointer typedef and exact destructor after including the header.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let owner (call read_c_owner (borrow-shared source) (borrow-shared nodes)
				(nodes.get declaration)))
			(let name (nodes.get owner/drop))
			(let void_pointer name/next_sibling.not-ltz)
			(if
				(:doc "Explicit pointer spellings without an alternate destructor ABI keep the ordinary emission path.")
				(bool:not (void_pointer.or
					(call c_owner_uses_typedef (borrow-shared source) (borrow-shared nodes) owner)))
				(then (return offset)))
			(let-mut open offset)
			(if
				(:doc "Check the declared void-pointer ABI without changing the owner's exact pointer type.")
				void_pointer
				(then (set open (call c_literal_text (borrow-shared void_owner_open)
					(borrow-mut output) offset writing)))
				(else (set open (call c_literal_text (borrow-shared pointer_owner_open)
					(borrow-mut output) offset writing))))
			(let native (call write_native_type (borrow-shared source)
				(nodes.get owner/native)
				(borrow-mut output) open writing))
			(let separator (call c_byte (borrow-mut output) native 44u8 writing))
			(let drop (call write_native_destructor_name (borrow-shared source) (borrow-shared nodes)
				owner (borrow-mut output) separator writing))
			(return (call c_literal_text (borrow-shared pointer_check_close)
				(borrow-mut output) drop writing))))

	(let c_handle_check "wvrt_check_c_handle(")
	(let c_storage_access "wvrt_c_storage_access(")

	(fn write_native_handle_check
		(:doc `Validate a captured owner before lending or transferring its native address.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression) (capture i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let owner (call native_owner_contract (borrow-shared source) (borrow-shared nodes) site/type))
			(let storage owner/storage)
			(let-mut cursor offset)
			(if
				(:doc "Storage checks activation as well as the presence of the wrapper.")
				storage
				(then (set cursor (call c_literal_text (borrow-shared c_storage_access)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared c_handle_check)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_temporary_name (borrow-shared nodes) capture (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Only the c_init path accepts an inactive allocation.")
				storage
				(then
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(let-mut flag 48u8)
					(if
						(:doc "Set the initializing bit only for an initializing loan.")
						(site/kind.eq (call native_storage_init_borrow_kind))
						(then (set flag 49u8)))
					(set cursor (call c_byte (borrow-mut output) cursor flag writing))))
			(return (call close_runtime_call (borrow-mut output) cursor
				site/target site/start site/end writing))))

	(fn write_native_handle_borrow
		(:doc `Check and capture the owner at the borrow's original span before evaluating later arguments.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site ScalarExpression)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let checked (call write_native_handle_check (borrow-shared source) (borrow-shared nodes) site site/first
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) checked 44u8 writing))
			(let pointer (call write_temporary_name (borrow-shared nodes) site/first (borrow-mut output) comma name_prefix writing))
			(return (call c_byte (borrow-mut output) pointer 41u8 writing)))))
