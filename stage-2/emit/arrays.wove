(module emit_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render fixed-array values and their checked accesses from evaluated operands.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only record_index slice_element_code (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (value indirect_local_place) (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/flow.wove" (only (value fixed_mut_loan)))
	(use wove-file "./records.wove" (only write_value_type write_field_place))
	(use wove-file "./bindings.wove" (only write_binding_name))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text write_temporary_name write_local_place))
	(use wove-file "./runtime.wove" (only write_c_number close_runtime_call write_slice_items))

	(let empty_value "{0}")
	(let list_open "{{")
	(let list_close "}}")
	(let repeat_empty "={0};(void)")
	(let repeat_open ";for(int32_t wvrt_repeat_index=0;wvrt_repeat_index<")
	(let repeat_step ";++wvrt_repeat_index)")
	(let repeat_destination ".wvrt_items[wvrt_repeat_index]=")
	(let access_open ".wvrt_items[wvrt_array_index_at_span(")

	(let fixed_shared_open "(wvrt_slice){")
	(let fixed_mut_open "(wvrt_mut_slice){")
	(let element_size_open ",sizeof(")
	(let fixed_slice_close ")}")

	(fn write_fixed_slice
		(:doc `Lend a fixed array's original inline storage as a slice descriptor.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let length (struct.get (local row) start))
			(let empty (i32.eq (local length) 0i32))
			(let-mut cursor (local offset))
			(if
				(:doc "The borrow mode selects a writable or const descriptor.")
				(u32.eq (struct.get (local row) kind) (local fixed_mut_loan))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local fixed_mut_open))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local fixed_shared_open))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "The aligned empty placeholder supplies an address but the slice has no accessible elements.")
				(local empty)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 38u8 (local writing)))))
			(let place (struct.get (local row) projection))
			(if
				(:doc "Use the complete original field path or the named fixed array itself.")
				(i32.lt -1i32 (local place))
				(then (set (local cursor) (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local place) (local tree_base)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
				(else (set (local cursor) (call write_local_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local row) target) (local tree_base) (i32.eq (local place) (local indirect_local_place))
					(borrow-mut (local output))
					(local cursor) (local name_prefix) (local writing)))))
			(if
				(:doc "A nonempty array lends the original inline elements without an aggregate copy.")
				(bool.not (local empty))
				(then (set (local cursor) (call write_slice_items (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor) (local length) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local element_size_open))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor)
				(call slice_element_code (struct.get (local row) type)) (local writing)))
			(return (call c_literal_text (borrow-shared (local fixed_slice_close))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_fixed_list
		(:doc `Build an inline aggregate from the list's already evaluated elements.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let type (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (struct.get (local expression) type)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local type) 41u8 (local writing)))
			(let-mut child (struct.get (local expression) first))
			(if
				(:doc "A typed empty list initializes the zero-extent placeholder.")
				(i32.lt (local child) 0i32)
				(then (return (call c_literal_text (borrow-shared (local empty_value)) (borrow-mut (local output)) (local close) (local writing)))))
			(let-mut cursor (call c_literal_text (borrow-shared (local list_open)) (borrow-mut (local output)) (local close) (local writing)))
			(while
				(:doc "Append one initializer per inline element in source order.")
				(i32.lt -1i32 (local child))
				(body
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local child) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
					(set (local child) (struct.get (array.load (local nodes) (local child)) next_sibling))))
			(return (call c_literal_text (borrow-shared (local list_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_fixed_repeat
		(:doc `Materialize a repeated array with a C loop over one previously evaluated value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (index i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get (local expression) type))
			(let extent (struct.get (array.load (local records) (call record_index (local type))) count))
			(let child (struct.get (local expression) first))
			(let type_end (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local type_end) 32u8 (local writing)))
			(let name (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
			(if
				(:doc "An empty repeat keeps the initializer's effects but stores no element.")
				(i32.eq (local extent) 0i32)
				(then
					(let ignore (call c_literal_text (borrow-shared (local repeat_empty)) (borrow-mut (local output)) (local name) (local writing)))
					(let used (call write_temporary_name (borrow-shared (local source)) (local child) (local tree_base)
						(borrow-mut (local output)) (local ignore) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local used) 59u8 (local writing)))))
			(let begin (call c_literal_text (borrow-shared (local repeat_open)) (borrow-mut (local output)) (local name) (local writing)))
			(let limit (call write_c_number (borrow-mut (local output)) (local begin) (local extent) (local writing)))
			(let step (call c_literal_text (borrow-shared (local repeat_step)) (borrow-mut (local output)) (local limit) (local writing)))
			(let array (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local step) (local name_prefix) (local writing)))
			(let destination (call c_literal_text (borrow-shared (local repeat_destination)) (borrow-mut (local output)) (local array) (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local child) (local tree_base)
				(borrow-mut (local output)) (local destination) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local value) 59u8 (local writing)))))

	(let evaluated_extent_open "((void)")
	(let evaluated_extent_separator ",")
	(let static_extent_open "((void)&")

	(fn write_fixed_length
		(:doc `Emit the registered extent. A computed receiver has already been evaluated to a C temporary.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(receiver ScalarExpression) (index i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let layout (array.load (local records) (call record_index (struct.get (local receiver) type))))
			(let extent (struct.get (local layout) count))
			(if
				(:doc "Named inline storage can use the extent without loading or copying the value.")
				(u32.eq (struct.get (local receiver) kind) 6u32)
				(then (return (call write_c_number (borrow-mut (local output)) (local offset)
					(local extent) (local writing)))))
			(let-mut value (local offset))
			(if
				(:doc "A static length references the original object without reading or copying it.")
				(u32.eq (struct.get (local receiver) kind) 62u32)
				(then
					(let open (call c_literal_text (borrow-shared (local static_extent_open))
						(borrow-mut (local output)) (local offset) (local writing)))
					(set (local value) (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local receiver) target) (bool false) (borrow-mut (local output)) (local open) (local name_prefix) (local writing))))
				(else
					(let open (call c_literal_text (borrow-shared (local evaluated_extent_open))
						(borrow-mut (local output)) (local offset) (local writing)))
					(set (local value) (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
						(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))))
			(let comma (call c_literal_text (borrow-shared (local evaluated_extent_separator))
				(borrow-mut (local output)) (local value) (local writing)))
			(let count (call write_c_number (borrow-mut (local output)) (local comma)
				(local extent) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local count) 41u8 (local writing)))))

	(fn write_fixed_access
		(:doc `Index the original store place or the evaluated array value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(expression ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let receiver (struct.get (local expression) first))
			(let array (array.load (local expressions) (local receiver)))
			(let layout (array.load (local records) (call record_index (struct.get (local array) type))))
			(if
				(:doc "Index a static table at its defining C object without copying the receiver.")
				(u32.eq (struct.get (local array) kind) 62u32)
				(then
					(let place (call write_binding_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local array) target) (bool false) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
					(return (call write_fixed_subscript (borrow-shared (local source)) (borrow-shared (local nodes))
						(local expression) (struct.get (local layout) count) (local tree_base)
						(borrow-mut (local output)) (local place) (local name_prefix) (local writing)))))
			(let-mut place (local offset))
			(if
				(:doc "Reading or writing a named local can use its inline storage directly.")
				(u32.eq (struct.get (local array) kind) 6u32)
				(then (set (local place) (call write_local_place (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local array) target) (local tree_base) (i32.eq (struct.get (local array) projection) (local indirect_local_place))
					(borrow-mut (local output))
					(local offset) (local name_prefix) (local writing))))
				(else
					(if
						(:doc "A store through a field path must write into the original enclosing record.")
						(u32.eq (struct.get (local expression) kind) 74u32)
						(then (set (local place) (call write_field_place (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local expressions)) (borrow-shared (local parameters)) (local receiver) (local tree_base)
							(borrow-mut (local output)) (local offset) (local name_prefix) (local writing))))
						(else (set (local place) (call write_temporary_name (borrow-shared (local source))
							(local receiver) (local tree_base) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))))))
			(return (call write_fixed_subscript (borrow-shared (local source)) (borrow-shared (local nodes))
				(local expression) (struct.get (local layout) count) (local tree_base)
				(borrow-mut (local output)) (local place) (local name_prefix) (local writing)))))

	(fn write_fixed_subscript
		(:doc `Append a checked index and an optional replacement to the already written array place.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(expression ScalarExpression) (extent i32) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let array (struct.get (local expression) first))
			(let index (struct.get (array.load (local nodes) (local array)) next_sibling))
			(let begin (call c_literal_text (borrow-shared (local access_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(let limit (call write_c_number (borrow-mut (local output)) (local begin) (local extent) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local limit) 44u8 (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(let site (call close_runtime_call (borrow-mut (local output)) (local value)
				(struct.get (local expression) target) (struct.get (local expression) start) (struct.get (local expression) end) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local site) 93u8 (local writing)))
			(if
				(:doc "A store replaces exactly the checked element in the original array.")
				(u32.eq (struct.get (local expression) kind) 74u32)
				(then
					(let equal (call c_byte (borrow-mut (local output)) (local close) 61u8 (local writing)))
					(let stored (struct.get (array.load (local nodes) (local index)) next_sibling))
					(return (call write_temporary_name (borrow-shared (local source)) (local stored) (local tree_base)
						(borrow-mut (local output)) (local equal) (local name_prefix) (local writing)))))
			(return (local close)))))
