(module emit_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render fixed-array values and their checked accesses from evaluated operands.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only record_index typed_slice_element (type ScalarRecord)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/flow.wove" (only (value fixed_mut_loan)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text write_temporary_name write_local_name))
	(use wove-file "./runtime.wove" (only write_c_number close_runtime_call write_slice_items))

	(let empty_value "{0}")
	(let list_open "{{")
	(let list_close "}}")
	(let repeat_empty "={0};(void)")
	(let repeat_open ";for(int32_t wvrt_repeat_index=0;wvrt_repeat_index<")
	(let repeat_step ";++wvrt_repeat_index)")
	(let repeat_destination ".wvrt_items[wvrt_repeat_index]=")
	(let access_open ".wvrt_items[wvrt_array_index_at_span(")

	(let fixed_shared_open "(wvrt_slice){")
	(let fixed_mut_open "(wvrt_mut_slice){")
	(let element_size_open ",sizeof(")
	(let fixed_slice_close ")}")

	(fn write_fixed_slice
		(:doc `Lend the inline storage of a fixed local as a typed slice descriptor.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (row ScalarExpression) (tree_base i32)
			(output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let length (record.get (local row) start))
			(let empty (i32.eq (local length) (i32 0)))
			(let-mut cursor (local offset))
			(if
				(:doc "The borrow mode selects a writable or const descriptor.")
				(u32.eq (record.get (local row) kind) (local fixed_mut_loan))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local fixed_mut_open))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local fixed_shared_open))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(if
				(:doc "The aligned empty placeholder supplies an address but the slice has no accessible elements.")
				(local empty)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 38) (local writing)))))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local row) target) (local tree_base) (borrow-mut (local output))
				(local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "A nonempty array lends the original inline elements without an aggregate copy.")
				(bool.not (local empty))
				(then (set (local cursor) (call write_slice_items (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
			(let-mut digits (array.alloc u8 (i32 11)))
			(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor) (local length)
				(borrow-mut (local digits)) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local element_size_open))
				(borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call c_type_text (borrow-mut (local output)) (local cursor)
				(call typed_slice_element (record.get (local row) type)) (local writing)))
			(return (call c_literal_text (borrow-shared (local fixed_slice_close))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_fixed_list
		(:doc `Build an inline aggregate from the list's already evaluated elements.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(expression ScalarExpression) (tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut (local output)) (local offset) (u8 40) (local writing)))
			(let type (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (record.get (local expression) type)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local type) (u8 41) (local writing)))
			(let-mut child (record.get (local expression) first))
			(if
				(:doc "A typed empty list initializes the zero-extent placeholder.")
				(i32.lt (local child) (i32 0))
				(then (return (call c_literal_text (borrow-shared (local empty_value)) (borrow-mut (local output)) (local close) (local writing)))))
			(let-mut cursor (call c_literal_text (borrow-shared (local list_open)) (borrow-mut (local output)) (local close) (local writing)))
			(while
				(:doc "Append one initializer per inline element in source order.")
				(i32.lt (i32 -1) (local child))
				(body
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local child) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (u8 44) (local writing)))
					(set (local child) (record.get (slice.load (local nodes) (local child)) next_sibling))))
			(return (call c_literal_text (borrow-shared (local list_close)) (borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_fixed_repeat
		(:doc `Materialize a repeated array with a C loop over one previously evaluated value.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(expression ScalarExpression) (index i32) (tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (record.get (local expression) type))
			(let extent (record.get (slice.load (local records) (call record_index (local type))) count))
			(let child (record.get (local expression) first))
			(let type_end (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
			(let space (call c_byte (borrow-mut (local output)) (local type_end) (u8 32) (local writing)))
			(let name (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local space) (local name_prefix) (local writing)))
			(if
				(:doc "An empty repeat keeps the initializer's effects but stores no element.")
				(i32.eq (local extent) (i32 0))
				(then
					(let ignore (call c_literal_text (borrow-shared (local repeat_empty)) (borrow-mut (local output)) (local name) (local writing)))
					(let used (call write_temporary_name (borrow-shared (local source)) (local child) (local tree_base)
						(borrow-mut (local output)) (local ignore) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local used) (u8 59) (local writing)))))
			(let-mut digits (array.alloc u8 (i32 11)))
			(let begin (call c_literal_text (borrow-shared (local repeat_open)) (borrow-mut (local output)) (local name) (local writing)))
			(let limit (call write_c_number (borrow-mut (local output)) (local begin) (local extent) (borrow-mut (local digits)) (local writing)))
			(let step (call c_literal_text (borrow-shared (local repeat_step)) (borrow-mut (local output)) (local limit) (local writing)))
			(let array (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local step) (local name_prefix) (local writing)))
			(let destination (call c_literal_text (borrow-shared (local repeat_destination)) (borrow-mut (local output)) (local array) (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local child) (local tree_base)
				(borrow-mut (local output)) (local destination) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local value) (u8 59) (local writing)))))

	(fn write_fixed_subscript
		(:doc `Append a checked index and an optional replacement to the already written array place.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(expression ScalarExpression) (extent i32) (tree_base i32) (output (mut-slice u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let array (record.get (local expression) first))
			(let index (record.get (slice.load (local nodes) (local array)) next_sibling))
			(let begin (call c_literal_text (borrow-shared (local access_open)) (borrow-mut (local output)) (local offset) (local writing)))
			(let-mut digits (array.alloc u8 (i32 11)))
			(let limit (call write_c_number (borrow-mut (local output)) (local begin) (local extent) (borrow-mut (local digits)) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local limit) (u8 44) (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local index) (local tree_base)
				(borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(let site (call close_runtime_call (borrow-mut (local output)) (local value)
				(record.get (local expression) target) (record.get (local expression) start) (record.get (local expression) end) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local site) (u8 93) (local writing)))
			(if
				(:doc "A store replaces exactly the checked element in the original array.")
				(u32.eq (record.get (local expression) kind) (u32 74))
				(then
					(let equal (call c_byte (borrow-mut (local output)) (local close) (u8 61) (local writing)))
					(let stored (record.get (slice.load (local nodes) (local index)) next_sibling))
					(return (call write_temporary_name (borrow-shared (local source)) (local stored) (local tree_base)
						(borrow-mut (local output)) (local equal) (local name_prefix) (local writing)))))
			(return (local close)))))
