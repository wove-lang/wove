(module emit_arrays
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render fixed-array values and checked array operations from evaluated operands.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/records.wove" (only record_receiver_type record_index is_array_owner is_readable_slice is_writable_slice slice_element_code (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (value indirect_local_place) (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarParameter)))
	(use wove-file "../scalar/flow.wove" (only (value fixed_mut_loan)))
	(use wove-file "./records.wove" (only write_value_type write_field_place))
	(use wove-file "./bindings.wove" (only write_binding_name))
	(use wove-file "./text.wove" (only c_byte c_literal_text c_type_text write_temporary_name write_local_place))
	(use wove-file "./runtime.wove" (only write_c_number close_runtime_call write_slice_items))
	(use wove-file "../scalar/syntax.wove" (only (value fixed_subarray_place) (value fixed_owner_take) (value fixed_owner_store)))
	(use wove-file "./owned_aggregates.wove" (only write_owner_helper_name))

	(let empty_value "{0}")
	(let list_open "{{")
	(let list_close "}}")
	(let live_element_open "{true,")
	(let repeat_empty "={0};(void)")
	(let repeat_open ";for(int32_t wvrt_repeat_index=0;wvrt_repeat_index<")
	(let repeat_step ";++wvrt_repeat_index)")
	(let repeat_destination ".wvrt_items[wvrt_repeat_index]=")
	(let access_open ".wvrt_items[wvrt_array_index_at_span(")
	(let subarray_deref "(*")

	(let fixed_shared_open "(wvrt_slice){")
	(let fixed_mut_open "(wvrt_mut_slice){")
	(let element_size_open ",sizeof(")
	(let fixed_slice_close ")}")

	(let slice_copy_call "wvrt_slice_try_copy(")

	(fn write_slice_copy
		(:doc "Pass the captured destination and source descriptors to the recoverable prefix copy.")
		(params (nodes (shared-array SourceNode)) (destination i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let from (struct:get (nodes.get destination) next_sibling))
			(let open (call c_literal_text (borrow-shared slice_copy_call)
				(borrow-mut output) offset writing))
			(let target (call write_temporary_name (borrow-shared nodes) destination
				(borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) target 44u8 writing))
			(let copied (call write_temporary_name (borrow-shared nodes) from
				(borrow-mut output) comma name_prefix writing))
			(return (call c_byte (borrow-mut output) copied 41u8 writing))))

	(fn write_fixed_slice
		(:doc `Lend a fixed array's original inline storage as a slice descriptor.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let length row/start)
			(let empty length.eqz)
			(let-mut cursor offset)
			(if
				(:doc "The borrow mode selects a writable or const descriptor.")
				(row/kind.eq fixed_mut_loan)
				(then (set cursor (call c_literal_text (borrow-shared fixed_mut_open)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared fixed_shared_open)
					(borrow-mut output) cursor writing))))
			(if
				(:doc "The aligned empty placeholder supplies an address but the slice has no accessible elements.")
				empty
				(then (set cursor (call c_byte (borrow-mut output) cursor 38u8 writing))))
			(let place row/projection)
			(if
				(:doc "Use the complete original field path or the named fixed array itself.")
				(i32:lt -1i32 place)
				(then (set cursor (call write_field_place (borrow-shared source) (borrow-shared nodes)
					(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) place tree_base
					(borrow-mut output) cursor name_prefix writing)))
				(else (set cursor (call write_local_place (borrow-shared source) (borrow-shared nodes)
					row/target tree_base (place.eq indirect_local_place)
					(borrow-mut output)
					cursor name_prefix writing))))
			(if
				(:doc "A nonempty array lends the original inline elements without an aggregate copy.")
				empty.not
				(then (set cursor (call write_slice_items (borrow-mut output) cursor writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call write_c_number (borrow-mut output) cursor length writing))
			(set cursor (call c_literal_text (borrow-shared element_size_open)
				(borrow-mut output) cursor writing))
			(set cursor (call c_type_text (borrow-mut output) cursor
				(call slice_element_code row/type) writing))
			(return (call c_literal_text (borrow-shared fixed_slice_close)
				(borrow-mut output) cursor writing))))

	(fn write_fixed_list
		(:doc `Build an inline aggregate from the list's already evaluated elements.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let type (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) expression/type
				(borrow-mut output) open name_prefix writing))
			(let close (call c_byte (borrow-mut output) type 41u8 writing))
			(let-mut child expression/first)
			(let layout (records.get (call record_index expression/type)))
			(let owning layout/owns_arrays)
			(if
				(:doc "A typed empty list initializes the zero-extent placeholder.")
				child.ltz
				(then (return (call c_literal_text (borrow-shared empty_value) (borrow-mut output) close writing))))
			(let-mut cursor (call c_literal_text (borrow-shared list_open) (borrow-mut output) close writing))
			(while
				(:doc "Append one initializer per inline element in source order.")
				(i32:lt -1i32 child)
				(body
					(if
						(:doc "Each listed owner starts in a populated inline slot.")
						owning
						(then (set cursor (call c_literal_text (borrow-shared live_element_open)
							(borrow-mut output) cursor writing))))
					(set cursor (call write_temporary_name (borrow-shared nodes) child
						(borrow-mut output) cursor name_prefix writing))
					(if owning (then (set cursor (call c_byte (borrow-mut output) cursor 125u8 writing))))
					(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
					(set child (struct:get (nodes.get child) next_sibling))))
			(return (call c_literal_text (borrow-shared list_close) (borrow-mut output) cursor writing))))

	(fn write_fixed_repeat
		(:doc `Materialize a repeated array with a C loop over one previously evaluated value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expression ScalarExpression) (index i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type expression/type)
			(let extent (struct:get (records.get (call record_index type)) count))
			(let child expression/first)
			(let type_end (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) offset name_prefix writing))
			(let space (call c_byte (borrow-mut output) type_end 32u8 writing))
			(let name (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) space name_prefix writing))
			(if
				(:doc "An empty repeat keeps the initializer's effects but stores no element.")
				extent.eqz
				(then
					(let ignore (call c_literal_text (borrow-shared repeat_empty) (borrow-mut output) name writing))
					(let used (call write_temporary_name (borrow-shared nodes) child
						(borrow-mut output) ignore name_prefix writing))
					(return (call c_byte (borrow-mut output) used 59u8 writing))))
			(let begin (call c_literal_text (borrow-shared repeat_open) (borrow-mut output) name writing))
			(let limit (call write_c_number (borrow-mut output) begin extent writing))
			(let step (call c_literal_text (borrow-shared repeat_step) (borrow-mut output) limit writing))
			(let array (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) step name_prefix writing))
			(let destination (call c_literal_text (borrow-shared repeat_destination) (borrow-mut output) array writing))
			(let value (call write_temporary_name (borrow-shared nodes) child
				(borrow-mut output) destination name_prefix writing))
			(return (call c_byte (borrow-mut output) value 59u8 writing))))

	(let evaluated_extent_open "((void)")
	(let evaluated_extent_separator ",")
	(let static_extent_open "((void)&")

	(fn write_fixed_length
		(:doc `Emit the registered extent. A computed receiver has already been evaluated to a C temporary.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(expressions (shared-array ScalarExpression)) (receiver ScalarExpression) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let layout (records.get (call record_index (call record_receiver_type receiver/type))))
			(let extent layout/count)
			(if
				(:doc "Named inline storage and owning fixed fields can use the extent without loading the value.")
				(bool:or (receiver/kind.eq 6u32)
					(bool:and (receiver/kind.eq 52u32) layout/owns_arrays))
				(then (return (call write_c_number (borrow-mut output) offset
					extent writing))))
			(let-mut value offset)
			(if
				(:doc "A static length references the original object without reading or copying it.")
				(receiver/kind.eq 62u32)
				(then
					(let open (call c_literal_text (borrow-shared static_extent_open)
						(borrow-mut output) offset writing))
					(let name receiver/target)
					(set value (call write_binding_name (borrow-shared source) (borrow-shared nodes)
						name (expressions.get name) (bool false) (borrow-mut output) open name_prefix writing)))
				(else
					(let open (call c_literal_text (borrow-shared evaluated_extent_open)
						(borrow-mut output) offset writing))
					(set value (call write_temporary_name (borrow-shared nodes) index
						(borrow-mut output) open name_prefix writing))))
			(let comma (call c_literal_text (borrow-shared evaluated_extent_separator)
				(borrow-mut output) value writing))
			(let count (call write_c_number (borrow-mut output) comma
				extent writing))
			(return (call c_byte (borrow-mut output) count 41u8 writing))))

	(let take_inline "WVRT_INLINE_SLOT_TAKE(&")
	(let replace_inline "WVRT_INLINE_SLOT_REPLACE(&")
	(let address_inline "WVRT_INLINE_SLOT_ADDRESS(&")
	(let shared_inline "wvrt_array_borrow_shared(*")
	(let mut_inline "wvrt_array_borrow_mut(*")
	(let drop_inline_array "wvrt_inline_array_slot_drop")

	(fn open_fixed_owner_access
		(:doc "Select a checked address, move, or replacement for an inline owning slot.")
		(params (expression ScalarExpression) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let kind expression/kind)
			(if
				(:doc "A move checks and clears the slot's presence flag.")
				(kind.eq fixed_owner_take)
				(then (return (call c_literal_text (borrow-shared take_inline)
					(borrow-mut output) offset writing))))
			(if
				(:doc "Replacement accepts either a populated or a previously moved slot.")
				(kind.eq fixed_owner_store)
				(then (return (call c_literal_text (borrow-shared replace_inline)
					(borrow-mut output) offset writing))))
			(let type expression/type)
			(let-mut cursor offset)
			(if
				(:doc "Borrow the heap descriptor stored in the selected inline slot.")
				(call is_readable_slice type)
				(then
					(if
						(:doc "The requested view determines the borrow mode.")
						(call is_writable_slice type)
						(then (set cursor (call c_literal_text (borrow-shared mut_inline)
							(borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared shared_inline)
							(borrow-mut output) cursor writing))))))
			(return (call c_literal_text (borrow-shared address_inline)
				(borrow-mut output) cursor writing))))

	(fn close_fixed_owner_access
		(:doc "Complete a fixed slot operation with its checked span or its exact replacement destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(layout ScalarRecord) (expression ScalarExpression) (index i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "An indexed read or move checks the presence of the selected owner.")
				(expression/kind.not-eq fixed_owner_store)
				(then
					(let close (call close_runtime_call (borrow-mut output) offset
						expression/target expression/start
						expression/end writing))
					(if
						(:doc "An array borrow wraps the checked descriptor pointer.")
						(call is_readable_slice expression/type)
						(then (return (call c_byte (borrow-mut output) close 41u8 writing))))
					(return close)))
			(let comma (call c_byte (borrow-mut output) offset 44u8 writing))
			(let stored (struct:get (nodes.get index) next_sibling))
			(let value (call write_temporary_name (borrow-shared nodes) stored
				(borrow-mut output) comma name_prefix writing))
			(let-mut drop (call c_byte (borrow-mut output) value 44u8 writing))
			(let element (u32:from-i32 layout/first))
			(if
				(:doc "Each replacement retires only the owner in the selected slot.")
				(call is_array_owner element)
				(then (set drop (call c_literal_text (borrow-shared drop_inline_array)
					(borrow-mut output) drop writing)))
				(else (set drop (call write_owner_helper_name (borrow-shared source) (borrow-shared nodes)
					(records.get (call record_index element)) (bool false)
					(borrow-mut output) drop name_prefix writing))))
			(return (call c_byte (borrow-mut output) drop 41u8 writing))))

	(fn write_fixed_access
		(:doc `Index the original store place or the evaluated array value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameters (shared-array ScalarParameter)) (expressions (shared-array ScalarExpression))
			(expression ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let receiver expression/first)
			(let array (expressions.get receiver))
			(let layout (records.get (call record_index (call record_receiver_type array/type))))
			(let-mut begin offset)
			(let owning layout/owns_arrays)
			(if
				(:doc "Open an occupancy-aware operation or an ordinary checked subarray address.")
				owning
				(then (set begin (call open_fixed_owner_access expression
					(borrow-mut output) begin writing)))
				(else
					(if
						(:doc "An ordinary subarray place needs its address.")
						(expression/kind.eq fixed_subarray_place)
						(then (set begin (call c_byte (borrow-mut output) begin 38u8 writing))))))
			(if
				(:doc "Index a static table at its defining C object without copying the receiver.")
				(array/kind.eq 62u32)
				(then
					(let name array/target)
					(let place (call write_binding_name (borrow-shared source) (borrow-shared nodes)
						name (expressions.get name) (bool false) (borrow-mut output) begin name_prefix writing))
					(return (call write_fixed_subscript (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) expression layout
						(borrow-mut output) place name_prefix writing))))
			(let-mut place begin)
			(if
				(:doc "A deeper access dereferences the checked address captured for its inner array.")
				(array/kind.eq fixed_subarray_place)
				(then
					(let open (call c_literal_text (borrow-shared subarray_deref) (borrow-mut output) begin writing))
					(let pointer (call write_temporary_name (borrow-shared nodes) receiver
						(borrow-mut output) open name_prefix writing))
					(let close (call c_byte (borrow-mut output) pointer 41u8 writing))
					(return (call write_fixed_subscript (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) expression layout
						(borrow-mut output) close name_prefix writing))))
			(if
				(:doc "Reading or writing a named local can use its inline storage directly.")
				(array/kind.eq 6u32)
				(then (set place (call write_local_place (borrow-shared source) (borrow-shared nodes)
					array/target tree_base (array/projection.eq indirect_local_place)
					(borrow-mut output)
					begin name_prefix writing)))
				(else
					(if
						(:doc "A store or nested projection through a field path uses the original record.")
						(owning.or (bool:or (expression/kind.eq 74u32)
							(expression/kind.eq fixed_subarray_place)))
						(then (set place (call write_field_place (borrow-shared source) (borrow-shared nodes)
							(borrow-shared expressions) (borrow-shared parameters) (borrow-shared records) receiver tree_base
							(borrow-mut output) begin name_prefix writing)))
						(else (set place (call write_temporary_name (borrow-shared nodes)
							receiver (borrow-mut output) begin name_prefix writing))))))
			(return (call write_fixed_subscript (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) expression layout
				(borrow-mut output) place name_prefix writing))))

	(fn write_fixed_subscript
		(:doc `Append a checked index and an optional replacement to the already written array place.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (expression ScalarExpression) (layout ScalarRecord) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let array expression/first)
			(let index (struct:get (nodes.get array) next_sibling))
			(let begin (call c_literal_text (borrow-shared access_open) (borrow-mut output) offset writing))
			(let limit (call write_c_number (borrow-mut output) begin layout/count writing))
			(let comma (call c_byte (borrow-mut output) limit 44u8 writing))
			(let value (call write_temporary_name (borrow-shared nodes) index
				(borrow-mut output) comma name_prefix writing))
			(let site (call close_runtime_call (borrow-mut output) value
				expression/target expression/start expression/end writing))
			(let close (call c_byte (borrow-mut output) site 93u8 writing))
			(if
				(:doc "Finish the occupancy-aware operation after selecting the exact inline slot.")
				layout/owns_arrays
				(then (return (call close_fixed_owner_access (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) layout expression index
					(borrow-mut output) close name_prefix writing))))
			(if
				(:doc "A store replaces exactly the checked element in the original array.")
				(expression/kind.eq 74u32)
				(then
					(let equal (call c_byte (borrow-mut output) close 61u8 writing))
					(let stored (struct:get (nodes.get index) next_sibling))
					(return (call write_temporary_name (borrow-shared nodes) stored
						(borrow-mut output) equal name_prefix writing))))
			(return close))))
