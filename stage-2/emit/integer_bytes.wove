(module emit_integer_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit fixed-width integer byte conversions independently of the C host's byte order.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/numeric_ops.wove" (only integer_byte_width integer_bytes_big_endian))
	(use wove-file "../source/types.wove" (only is_signed_builtin_integer is_128bit_integer is_256bit_integer (value i256_type)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only record_index (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./runtime.wove" (only write_c_number close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))

	(let byte_array_open "){{")
	(let byte_array_close "}}")
	(let extract_byte "(uint8_t)((uint64_t)")
	(let extract_wide_byte "(uint8_t)((wvrt_u128)")
	(let extract_bitint_byte "(uint8_t)((wvrt_u256)")
	(let shift_right ">>")
	(let extract_end "),")
	(let decode_unsigned "wvrt_int_from_bytes(")
	(let decode_signed "wvrt_signed_from_bytes(")
	(let decode_wide_unsigned "wvrt_u128_from_bytes(")
	(let decode_wide_signed "wvrt_i128_from_bytes(")
	(let decode_bitint_unsigned "wvrt_u256_from_bytes(")
	(let decode_bitint_signed "wvrt_i256_from_bytes(")

	(fn open_integer_decoder
		(:doc "Select the exact unsigned assembly width and whether the result interprets the sign bit.")
		(params (type u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The wide signed decoder interprets the full 256-bit two's complement representation.")
				(u32.eq (local type) (local i256_type))
				(then (return (call c_literal_text (borrow-shared (local decode_bitint_signed))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "The wide unsigned decoder keeps every bit.")
				(call is_256bit_integer (local type))
				(then (return (call c_literal_text (borrow-shared (local decode_bitint_unsigned))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "A sixteen-byte decode uses the native 128-bit result.")
				(call is_128bit_integer (local type))
				(then
					(if
						(:doc "Interpret the 128-bit sign before returning a signed result.")
						(call is_signed_builtin_integer (local type))
						(then (return (call c_literal_text (borrow-shared (local decode_wide_signed))
							(borrow-mut (local output)) (local offset) (local writing)))))
					(return (call c_literal_text (borrow-shared (local decode_wide_unsigned))
						(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "Interpret the sign of a narrow lane before the final cast.")
				(call is_signed_builtin_integer (local type))
				(then (return (call c_literal_text (borrow-shared (local decode_signed))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local decode_unsigned))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn open_byte_extract
		(:doc "Cast the captured word to an unsigned type wide enough for all its bytes.")
		(params (width i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The optional type uses an exact unsigned C23 representation.")
				(i32.eq (local width) 32i32)
				(then (return (call c_literal_text (borrow-shared (local extract_bitint_byte))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(if
				(:doc "A sixteen-byte type keeps the upper and lower words.")
				(i32.eq (local width) 16i32)
				(then (return (call c_literal_text (borrow-shared (local extract_wide_byte))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(return (call c_literal_text (borrow-shared (local extract_byte))
				(borrow-mut (local output)) (local offset) (local writing)))))

	(fn write_integer_bytes_encode
		(:doc `Initialize every inline byte from the already evaluated integer temporary.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get (local row) type))
			(let count (struct.get (array.load (local records) (call record_index (local type))) count))
			(let big (call integer_bytes_big_endian (struct.get (local row) kind)))
			(let open (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let typed (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let-mut cursor (call c_literal_text (borrow-shared (local byte_array_open))
				(borrow-mut (local output)) (local typed) (local writing)))
			(let-mut step 8i32)
			(let-mut shift 0i32)
			(if
				(:doc "Big-endian output starts with the most significant byte of the declared width.")
				(local big)
				(then
					(set (local step) -8i32)
					(set (local shift) (i32.from-u32 (u32.shl (u32.from-i32 (i32.dec (local count))) 3i32)))))
			(let-mut index 0i32)
			(while
				(:doc "Cast to unsigned before shifting, then keep only the selected byte.")
				(i32.lt (local index) (local count))
				(body
					(let cast (call open_byte_extract (local count) (borrow-mut (local output)) (local cursor) (local writing)))
					(let value (call write_temporary_name (borrow-shared (local source)) (struct.get (local row) first)
						(local tree_base) (borrow-mut (local output)) (local cast) (local name_prefix) (local writing)))
					(let op (call c_literal_text (borrow-shared (local shift_right))
						(borrow-mut (local output)) (local value) (local writing)))
					(let bits (call write_c_number (borrow-mut (local output)) (local op)
						(local shift) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local extract_end))
						(borrow-mut (local output)) (local bits) (local writing)))
					(set (local shift) (i32.add (local shift) (local step)))
					(set (local index) (i32.inc (local index)))))
			(return (call c_literal_text (borrow-shared (local byte_array_close))
				(borrow-mut (local output)) (local cursor) (local writing)))))

	(fn write_integer_bytes_decode
		(:doc `Call the runtime decoder on the evaluated view, then give its fitting result the declared C type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (tree_base i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct.get (local row) type))
			(let cast (call c_byte (borrow-mut (local output)) (local offset) 40u8 (local writing)))
			(let typed (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cast) (local name_prefix) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local typed) 41u8 (local writing)))
			(let open (call open_integer_decoder (local type)
				(borrow-mut (local output)) (local close) (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (struct.get (local row) first)
				(local tree_base) (borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local value) 44u8 (local writing)))
			(let width (call write_c_number (borrow-mut (local output)) (local comma)
				(call integer_byte_width (local type)) (local writing)))
			(let flag (call c_byte (borrow-mut (local output)) (local width) 44u8 (local writing)))
			(let-mut order 48u8)
			(if (call integer_bytes_big_endian (struct.get (local row) kind)) (then (set (local order) 49u8)))
			(let arguments (call c_byte (borrow-mut (local output)) (local flag) (local order) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local arguments)
				(struct.get (local row) target) (struct.get (local row) start) (struct.get (local row) end) (local writing))))))
