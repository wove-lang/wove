(module emit_integer_bytes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit fixed-width integer byte conversions independently of the C host's byte order.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/numeric_ops.wove" (only integer_byte_width integer_bytes_big_endian))
	(use wove-file "../source/types.wove" (only is_signed_builtin_integer is_128bit_integer is_256bit_integer (value i256_type)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only record_index (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./runtime.wove" (only write_c_number close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))

	(let byte_array_open "){{")
	(let byte_array_close "}}")
	(let extract_byte "(uint8_t)((uint64_t)")
	(let extract_wide_byte "(uint8_t)((wvrt_u128)")
	(let extract_bitint_byte "(uint8_t)((wvrt_u256)")
	(let shift_right ">>")
	(let extract_end "),")
	(let decode_unsigned "wvrt_int_from_bytes(")
	(let decode_signed "wvrt_signed_from_bytes(")
	(let decode_wide_unsigned "wvrt_u128_from_bytes(")
	(let decode_wide_signed "wvrt_i128_from_bytes(")
	(let decode_bitint_unsigned "wvrt_u256_from_bytes(")
	(let decode_bitint_signed "wvrt_i256_from_bytes(")

	(fn open_integer_decoder
		(:doc "Select the exact unsigned assembly width and whether the result interprets the sign bit.")
		(params (type u32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The wide signed decoder interprets the full 256-bit two's complement representation.")
				(u32:eq type i256_type)
				(then (return (call c_literal_text (borrow-shared decode_bitint_signed)
					(borrow-mut output) offset writing))))
			(if
				(:doc "The wide unsigned decoder keeps every bit.")
				(call is_256bit_integer type)
				(then (return (call c_literal_text (borrow-shared decode_bitint_unsigned)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A sixteen-byte decode uses the native 128-bit result.")
				(call is_128bit_integer type)
				(then
					(if
						(:doc "Interpret the 128-bit sign before returning a signed result.")
						(call is_signed_builtin_integer type)
						(then (return (call c_literal_text (borrow-shared decode_wide_signed)
							(borrow-mut output) offset writing))))
					(return (call c_literal_text (borrow-shared decode_wide_unsigned)
						(borrow-mut output) offset writing))))
			(if
				(:doc "Interpret the sign of a narrow lane before the final cast.")
				(call is_signed_builtin_integer type)
				(then (return (call c_literal_text (borrow-shared decode_signed)
					(borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared decode_unsigned)
				(borrow-mut output) offset writing))))

	(fn open_byte_extract
		(:doc "Cast the captured word to an unsigned type wide enough for all its bytes.")
		(params (width i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(if
				(:doc "The optional type uses an exact unsigned C23 representation.")
				(i32:eq width 32i32)
				(then (return (call c_literal_text (borrow-shared extract_bitint_byte)
					(borrow-mut output) offset writing))))
			(if
				(:doc "A sixteen-byte type keeps the upper and lower words.")
				(i32:eq width 16i32)
				(then (return (call c_literal_text (borrow-shared extract_wide_byte)
					(borrow-mut output) offset writing))))
			(return (call c_literal_text (borrow-shared extract_byte)
				(borrow-mut output) offset writing))))

	(fn write_integer_bytes_encode
		(:doc `Initialize every inline byte from the already evaluated integer temporary.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct:get row type))
			(let count (struct:get (array:load records (call record_index type)) count))
			(let big (call integer_bytes_big_endian (struct:get row kind)))
			(let open (call c_byte (borrow-mut output) offset 40u8 writing))
			(let typed (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) open name_prefix writing))
			(let-mut cursor (call c_literal_text (borrow-shared byte_array_open)
				(borrow-mut output) typed writing))
			(let-mut step 8i32)
			(let-mut shift 0i32)
			(if
				(:doc "Big-endian output starts with the most significant byte of the declared width.")
				big
				(then
					(set step -8i32)
					(set shift (i32:from-u32 (u32:shl (u32:from-i32 (i32:dec count)) 3i32)))))
			(let-mut index 0i32)
			(while
				(:doc "Cast to unsigned before shifting, then keep only the selected byte.")
				(i32:lt index count)
				(body
					(let cast (call open_byte_extract count (borrow-mut output) cursor writing))
					(let value (call write_temporary_name (borrow-shared nodes) (struct:get row first) (borrow-mut output) cast name_prefix writing))
					(let op (call c_literal_text (borrow-shared shift_right)
						(borrow-mut output) value writing))
					(let bits (call write_c_number (borrow-mut output) op
						shift writing))
					(set cursor (call c_literal_text (borrow-shared extract_end)
						(borrow-mut output) bits writing))
					(set shift (i32:add shift step))
					(set index (i32:inc index))))
			(return (call c_literal_text (borrow-shared byte_array_close)
				(borrow-mut output) cursor writing))))

	(fn write_integer_bytes_decode
		(:doc `Call the runtime decoder on the evaluated view, then give its fitting result the declared C type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(row ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let type (struct:get row type))
			(let cast (call c_byte (borrow-mut output) offset 40u8 writing))
			(let typed (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cast name_prefix writing))
			(let close (call c_byte (borrow-mut output) typed 41u8 writing))
			(let open (call open_integer_decoder type
				(borrow-mut output) close writing))
			(let value (call write_temporary_name (borrow-shared nodes) (struct:get row first) (borrow-mut output) open name_prefix writing))
			(let comma (call c_byte (borrow-mut output) value 44u8 writing))
			(let width (call write_c_number (borrow-mut output) comma
				(call integer_byte_width type) writing))
			(let flag (call c_byte (borrow-mut output) width 44u8 writing))
			(let-mut order 48u8)
			(if (call integer_bytes_big_endian (struct:get row kind)) (then (set order 49u8)))
			(let arguments (call c_byte (borrow-mut output) flag order writing))
			(return (call close_runtime_call (borrow-mut output) arguments
				(struct:get row target) (struct:get row start) (struct:get row end) writing)))))
