(module emit_ordinals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Assign emission ordinals from the packed graph before measuring or writing C.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count function_with_c_name_ordinal (type ScalarFunction)))
	(use wove-file "../scalar/records.wove" (only record_with_c_name_ordinal (type ScalarRecord)))
	(use wove-file "../scalar/generics/workspace.wove" (only subtree_limit))

	(use wove-file "../scalar/flow.wove" (only is_loop (type ScalarStatement)))

	(fn defines_break_label
		(:doc "A checked loop has a C label when at least one written break targets it.")
		(params (statement ScalarStatement)) (returns bool)
		(body (return (bool:and (call is_loop statement/kind)
			statement/target.not-ltz))))

	(fn assign_global_ordinals
		(:doc "Use the same declaration and layout indices in serial C, public declarations, and every numbered unit.")
		(params (functions (mut-array ScalarFunction)) (function_count i32) (records (mut-array ScalarRecord)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Functions and their private adapters share the checked function ordinal.")
				(index.lt function_count)
				(body
					(array:set functions index (call function_with_c_name_ordinal (array:get functions index) index))
					(set index index.inc)))
			(set index 0i32)
			(while
				(:doc "Visit every initialized layout, including structural layouts with negative name markers.")
				(bool:and (index.lt (array:len records))
					(i32:not-eqz (struct:get (array:get records index) name)))
				(body
					(array:set records index (call record_with_c_name_ordinal (array:get records index) index))
					(set index index.inc)))))

	(fn with_ordinal
		(:doc "Record a function-relative ordinal alongside the checked source fields.")
		(params (node SourceNode) (ordinal i32)) (returns SourceNode)
		(body (return (SourceNode.new
			(kind node/kind) (start node/start) (end node/end)
			(parent node/parent) (first_child node/first_child) (next_sibling node/next_sibling)
			(bridge_project node/bridge_project) (bridge_default node/bridge_default)
			(generic_kind node/generic_kind) (generic_value node/generic_value) (c_ordinal ordinal)))))

	(fn assign_local_ordinals
		(:doc "Give each concrete function a fresh ordinal space for places, captures, and labels.")
		(params (nodes (mut-array SourceNode)) (functions (shared-array ScalarFunction))) (returns void)
		(body
			(let count (call checked_function_count (borrow-shared functions)))
			(let-mut index 0i32)
			(while
				(:doc "Bridge declarations have no C body or local symbols.")
				(index.lt count)
				(body
					(let function (array:get functions index))
					(if
						(:doc "Each body row can serve as a distinct capture anchor, regardless of its syntax kind.")
						function/body.not-ltz
						(then
							(let first function/declaration)
							(let end (call subtree_limit (borrow-shared nodes) first function/tree_limit))
							(let-mut row first)
							(while
								(:doc "Declaration-relative rows remain unique inside one C function.")
								(row.lt end)
								(body
									(nodes.set row (call with_ordinal (nodes.get row) (row.sub first)))
									(set row row.inc)))))
					(set index index.inc)))))
)
