(module emit_units
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Partition and emit an already checked graph as numbered C units.")

	(use wove-file "../hashing/base62.wove" (only write_base62_filename))
	(use wove-file "../c/arguments.wove" (only (value c_storage_init_always_mode) c_checked_string_mode c_consume_mode c_handle_mut_mode
		(value c_nullable_native_reference_mode) (value c_nullable_storage_shared_mode)
		is_c_array_mode is_c_bytes_mode is_c_null_mode is_c_storage_mode
		is_c_value_mode is_c_vector_mode (value c_open_variadic_tail)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner native_owner_type))
	(use wove-file "../scalar/owners.wove" (only optional_byte_owner_type))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count is_record_input
		(type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only find_native_definition is_native_integer
		is_native_record is_writable_slice slice_element_type is_place_reference is_mutable_place_reference
		place_reference_target is_record_type record_index
		(type ScalarRecord)))
	(use wove-file "../scalar/syntax.wove" (only is_byte_view_type))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../source/graph.wove" (only includes_c_header (type GraphBinding) (value c_dependency_provider)))
	(use wove-file "../source/c_formals.wove" (only c_fixed_formal_at is_c_fixed_formal))
	(use wove-file "../source/c_names.wove" (only native_symbol_start native_symbol_end))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "./bindings.wove" (only write_module_bindings (value declared_module_bindings) (value linked_module_bindings)))
	(use wove-file "./c.wove" (only has_c_argument_adapters has_c_other_arguments write_program_preamble write_program_bodies))
	(use wove-file "./c_values.wove" (only is_c_integer_constant is_c_vector_snapshot is_writable_c_integer))
	(use wove-file "../source/types.wove" (only is_builtin_integer is_builtin_scalar void_type))
	(use wove-file "./headers.wove" (only append_includes (type CInclude) (type Includes)))
	(use wove-file "./library.wove" (only write_library_abi))
	(use wove-file "./owners.wove" (only is_numbered_pointer_owner is_numbered_storage_owner native_owner_contract))
	(use wove-file "./text.wove" (only c_literal_text))
	(use wove-file "./workers.wove" (only write_worker_adapters (value declared_worker_adapters) (value linked_worker_adapters)))
	(use wove-file "./tests.wove" (only write_test_entry))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct UnitIndex (fields (value i32)))

	(let max_unit_name_length 21i32)
	(let unit_prefix "unit-")
	(let unit_extension ".c")
	(let program_include "#include \"program.h\"\n")
	(let numbered_preamble_replay 3u8)

	(fn write_unit_name
		(:doc "Write a numbered C filename using a case-safe seven-digit Base62 ordinal.")
		(params (ordinal i32) (output (mut-array u8))) (returns i32)
		(body
			(if ordinal.ltz (then (return 0i32)))
			(let-mut digits (array:alloc u8 14i32))
			(let count (call write_base62_filename (u32:from-i32 ordinal) (borrow-mut digits) 0i32 7i32))
			(if
				(:doc "Reserve the full spelling before writing the first output byte.")
				(i32:lt output.len (i32:add (i32:add unit_prefix.len count) unit_extension.len))
				(then (return 0i32)))
			(let start (call c_literal_text (borrow-shared unit_prefix) (borrow-mut output) 0u32 (bool true)))
			(let end (call c_literal_text (borrow-shared (digits.range 0i32 count)) (borrow-mut output) start (bool true)))
			(return (i32:from-u32 (call c_literal_text (borrow-shared unit_extension) (borrow-mut output) end (bool true))))))

	(fn balance_groups
		(:doc "Distribute the items over a positive unit count, giving the first groups any extra items.")
		(params (units i32) (groups (mut-array UnitIndex))) (returns void)
		(body
			(let items (u32:from-i32 groups.len))
			(let count (u32:from-i32 units))
			(let share (i32:from-u32 (items.div count)))
			(let extra (i32:from-u32 (items.rem count)))
			(let-mut unit 0i32)
			(let-mut item 0i32)
			(while
				(:doc "Distribute the remainder over the first groups in order.")
				(unit.lt units)
				(body
					(let-mut stop (item.add share))
					(if (unit.lt extra) (then (set stop stop.inc)))
					(while
						(:doc "Give every item in the contiguous range the same unit.")
						(item.lt stop)
						(body
							(groups.set item (struct:new UnitIndex (value unit)))
							(set item item.inc)))
					(set unit unit.inc)))))

	(fn plan_unit_assignments
		(:doc "Balance whole body-owning modules where possible, then fall back to declaration ranges.")
		(:expect (tests "stage-2/numbered_units/cases.jsonc") (issues "gh:wove-lang/wove:206"))
		(params (functions (shared-array ScalarFunction)) (files i32) (requested i32) (assignments (mut-array UnitIndex)))
		(returns i32)
		(body
			(let-mut modules (array:alloc UnitIndex files))
			(let-mut active 0i32)
			(let-mut bodies 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Rank body-owning files by first checked definition, including files with specialized bodies.")
				(index.lt assignments.len)
				(body
					(let function (functions.get index))
					(if
						(:doc "A foreign prototype does not consume a body's share of the work.")
						(i32:not-ltz function/body)
						(then
							(let file function/file)
							(if
								(:doc "A file keeps one rank even when additional specializations are appended later.")
								(i32:eqz (struct:get (modules.get file) value))
								(then
									(set active active.inc)
									(modules.set file (struct:new UnitIndex (value active)))))
							(set bodies bodies.inc)))
					(set index index.inc)))
			(let-mut width requested)
			(if (bodies.lt width) (then (set width bodies)))
			(if (i32:not-lt 1i32 width) (then (return width)))
			(let by_module (active.not-lt width))
			(let-mut items bodies)
			(if by_module (then (set items active)))
			(let-mut groups (array:alloc UnitIndex items))
			(call balance_groups width (borrow-mut groups))
			(set index 0i32)
			(set bodies 0i32)
			(while
				(:doc "Keep assignments as a parallel table so every reference retains its exact checked function row.")
				(index.lt assignments.len)
				(body
					(let function (functions.get index))
					(if
						(:doc "Only Wove body rows receive a unit number.")
						(i32:not-ltz function/body)
						(then
							(let-mut item bodies)
							(if
								(:doc "All definitions from the same file use its original rank when grouping modules.")
								by_module
								(then (set item (i32:dec (struct:get (modules.get function/file) value)))))
							(assignments.set index
								(groups.get item))
							(set bodies bodies.inc)))
					(set index index.inc)))
			(return width)))

	(fn direct_scalar_abi
		(:doc "Built-in scalars and checked native integer aliases use direct C value passing.")
		(params (type u32)) (returns bool)
		(body (return (bool:or (call is_builtin_scalar type) (call is_native_integer type)))))

	(fn numbered_owner_binding
		(:doc "Recover the exact owner declaration from a selected type and its defining file.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(binding GraphBinding) (trees (shared-array ScalarTree))) (returns i32)
		(body
			(if
				(:doc "A native type import must name its own destructor to select an owner witness.")
				(bool:or (u32:not-eq binding/namespace 1u32)
					(bool:or (i32:not-gtz binding/native_type) (i32:ltz binding/drop_start)))
				(then (return -1i32)))
			(let tree (trees.get binding/native_file))
			(let declaration (i32:add tree/base binding/native_type))
			(if
				(:doc "Both native owner forms keep their defining declaration separate from value layout rows.")
				(bool:or (call is_numbered_storage_owner (borrow-shared source) (borrow-shared nodes)
						(call native_owner_type declaration))
					(call is_numbered_pointer_owner (borrow-shared source) (borrow-shared nodes)
						(call native_owner_type declaration)))
				(then (return declaration)))
			(return -1i32)))

	(fn numbered_bridge_binding
		(:doc "Classify the selected declaration before certifying its include context.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(binding GraphBinding) (records (shared-array ScalarRecord))
			(trees (shared-array ScalarTree)) (statements (shared-array ScalarStatement))) (returns u8)
		(body
			(if binding/optional (then (return 0u8)))
			(if
				(:doc "After replaying the include context, Clang checks the null macro in each body that uses it.")
				binding/null_value
				(then (return numbered_preamble_replay)))
			(let namespace binding/namespace)
			(if
				(:doc "Dependencies contribute their ordered includes. The signature pass checks functions and the private types they use.")
				(bool:or namespace.eqz (u32:eq binding/provider c_dependency_provider))
				(then (return 1u8)))
			(if
				(:doc "Checked integer constants and shared pointer values require the complete preamble context.")
				(namespace.eq 2u32)
				(then
					(if binding/value_macro (then (return 0u8)))
					(let base (struct:get (trees.get binding/file) base))
					(let definition (base.add binding/declaration))
					(let row (statements.get definition))
					(if
						(:doc "All selected aliases retain their checked constant or writable integer contract.")
						(bool:or (call is_c_integer_constant row) (call is_writable_c_integer row))
						(then (return numbered_preamble_replay)))
					(if
						(:doc "Replay live native pointer resources and the source of each read-only vector snapshot.")
						(bool:or (call is_c_vector_snapshot row)
							(bool:and (i32:gtz binding/native_type)
								(i32:not-ltz binding/drop_start)))
						(then (return 2u8)))
					(return 0u8)))
			(if (namespace.not-eq 1u32) (then (return 0u8)))
			(if
				(:doc "A native owner uses the same native type and destructor in every unit.")
				(i32:not-ltz (call numbered_owner_binding (borrow-shared source) (borrow-shared nodes)
					binding (borrow-shared trees)))
				(then (return numbered_preamble_replay)))
			(let row (call find_native_definition (borrow-shared records)
				binding/native_file binding/native_type))
			(if row.ltz (then (return 0u8)))
			(let layout (records.get row))
			(if
				(:doc "A native integer typedef needs its original literal in the shared header.")
				(bool:and (i32:gtz layout/native) (i32:eq layout/count -1i32))
				(then (return 1u8)))
			(if
				(:doc "A nonempty native record view checks real C members and uses the header's complete layout.")
				(bool:and (call is_native_record layout) (i32:gtz layout/count))
				(then (return numbered_preamble_replay)))
			(return 0u8)))

	(fn checked_shared_cstr_parameter
		(:doc "Use the existing NUL-checked conversion for an immutable input view.")
		(params (parameter ScalarParameter)) (returns bool)
		(body
			(let type parameter/type)
			(return (bool:and (u8:eq parameter/c_mode (call c_checked_string_mode))
				(bool:and (call is_byte_view_type type) (bool:not (call is_writable_slice type)))))))

	(fn numbered_owned_cstr_call
		(:doc "Admit one checked shared C string and one explicit null into a released nullable text result.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(if
				(:doc "Only a whole-string copy with a named release has this ownership contract.")
				(bool:or (bool:not function/c_snapshot)
					(bool:or (i32:ltz function/c_snapshot_drop)
						(bool:or (i32:not-ltz function/c_snapshot_field)
							(bool:or (i32:not-ltz function/c_snapshot_record)
								(u32:not-eq function/result (call optional_byte_owner_type))))))
				(then (return (bool false))))
			(if
				(:doc "The fixed two-argument form has exactly one checked conversion and one null slot.")
				(bool:or (bool:or (i32:not-eq function/arity 2i32)
						(bool:or (i32:not-eq function/c_strings 1i32)
							(i32:not-eq function/c_nulls 1i32)))
					(bool:or (bool:or (i32:not-eqz function/c_variadic)
							(i32:gtz function/c_extents))
						(bool:or function/c_storage (call has_c_other_arguments function (bool true)))))
				(then (return (bool false))))
			(let first function/params)
			(let input (parameters.get first))
			(let output (parameters.get first.inc))
			(let output_type output/type)
			(return (bool:and
				(call checked_shared_cstr_parameter input)
				(bool:and (call is_c_null_mode output/c_mode)
					(bool:and (call is_byte_view_type output_type) (call is_writable_slice output_type)))))))

	(fn numbered_native_record_reference
		(:doc "Resolve an ordinary shared or mutable loan to its complete checked native record.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body
			(if (bool:not (call is_place_reference type)) (then (return (bool false))))
			(let target (call place_reference_target (borrow-shared records) type))
			(if (bool:not (call is_record_type target)) (then (return (bool false))))
			(let layout (records.get (call record_index target)))
			(return (bool:and (call is_native_record layout) (i32:gtz layout/count)))))

	(fn checked_mutable_cstr_parameter
		(:doc "Use the checked conversion and copyback only for a mutable byte slice.")
		(params (parameter ScalarParameter)) (returns bool)
		(body
			(let type parameter/type)
			(return (bool:and (u8:eq parameter/c_mode (call c_checked_string_mode))
				(bool:and (call is_byte_view_type type) (call is_writable_slice type))))))

	(fn numbered_borrowed_cstr_call
		(:doc "Admit a whole-string snapshot from fixed shared strings or one checked mutable string.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(if
				(:doc "The optional result copies a direct C string without a field, extent, source loan, or release.")
				(bool:or (bool:not function/c_snapshot)
					(bool:or (bool:or (i32:not-ltz function/c_snapshot_drop)
							(i32:not-ltz function/c_snapshot_field))
						(bool:or (bool:or (i32:not-ltz function/c_snapshot_record)
								(i32:not-ltz function/c_snapshot_extent))
							(bool:or function/c_snapshot_source
								(u32:not-eq function/result (call optional_byte_owner_type))))))
				(then (return (bool false))))
			(let arity function/arity)
			(if
				(:doc "Every formal must use the checked string conversion without any other adaptation.")
				(bool:or (bool:or arity.not-gtz (arity.not-eq function/c_strings))
					(bool:or (bool:or (i32:not-eqz function/c_nulls)
							(i32:not-eqz function/c_variadic))
						(bool:or (bool:or function/c_storage (i32:gtz function/c_extents))
							(call has_c_other_arguments function (bool true)))))
				(then (return (bool false))))
			(let-mut index function/params)
			(let end (index.add arity))
			(if
				(:doc "With one mutable string, the existing scratch stays live through the result copy and copyback.")
				(bool:and (arity.eq 1i32) (call checked_mutable_cstr_parameter (parameters.get index)))
				(then (return (bool true))))
			(while
				(:doc "Use the existing checked conversion only for immutable byte views.")
				(index.lt end)
				(body
					(if (bool:not (call checked_shared_cstr_parameter (parameters.get index)))
						(then (return (bool false))))
					(set index index.inc)))
			(return (bool true))))

	(fn numbered_field_snapshot_call
		(:doc "Admit one original writable native pointer loan and a bounded inline-field result copy.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(if
				(:doc "The native call returns the record to copy directly, with a field and reported byte extent.")
				(bool:or (bool:or (bool:not function/c_snapshot) (i32:ltz function/c_snapshot_field))
					(bool:or (bool:or (i32:ltz function/c_snapshot_extent) (i32:not-ltz function/c_snapshot_drop))
						(bool:or (bool:or function/c_snapshot_source (i32:not-ltz function/c_snapshot_record))
							(u32:not-eq function/result (call optional_byte_owner_type)))))
				(then (return (bool false))))
			(if
				(:doc "A single loan is the only argument to this fixed native snapshot.")
				(bool:or (bool:or (i32:not-eq function/arity 1i32) (i32:not-eqz function/c_strings))
					(bool:or (bool:or (i32:not-eqz function/c_nulls) function/c_storage)
						(bool:or (bool:or (i32:not-eqz function/c_variadic) (i32:not-eqz function/c_extents))
							(bool:or (call has_c_other_arguments function (bool true)) (call is_record_input function)))))
				(then (return (bool false))))
			(let owner (parameters.get function/params))
			(return (bool:and (u8:eq owner/c_mode (call c_handle_mut_mode))
				(call is_numbered_pointer_owner (borrow-shared source) (borrow-shared nodes) owner/type)))))

	(fn numbered_adapted_fixed_call
		(:doc "Admit fixed calls with checked immutable strings or complete native record loans and ordinary scalar values.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord))) (returns bool)
		(body
			(let result function/result)
			(if
				(:doc "Other native adaptations and indirect results do not belong to this call contract.")
				(bool:or (bool:or function/c_snapshot
						(bool:or (i32:gtz function/c_nulls) (i32:not-eqz function/c_variadic)))
					(bool:or (bool:or function/c_storage (i32:gtz function/c_extents))
						(bool:or (bool:or (call has_c_other_arguments function (bool true)) (call is_record_input function))
							(bool:and (result.not-eq (call void_type)) (bool:not (call direct_scalar_abi result))))))
				(then (return (bool false))))
			(let-mut index function/params)
			(let limit (index.add function/arity))
			(let-mut record (bool false))
			(let-mut string (bool false))
			(while
				(:doc "Keep the full native type and each formal's original access mode.")
				(index.lt limit)
				(body
					(let parameter (parameters.get index))
					(let type parameter/type)
					(if
						(:doc "A checked string uses its existing scratch conversion. Other parameters must pass directly.")
						(call checked_shared_cstr_parameter parameter)
						(then (set string (bool true)))
						(else
							(if (bool:not (call is_c_value_mode parameter/c_mode)) (then (return (bool false))))
							(if
								(:doc "A native record formal keeps its complete layout and original storage.")
								(call numbered_native_record_reference (borrow-shared records) type)
								(then (set record (bool true)))
								(else (if (bool:not (call direct_scalar_abi type)) (then (return (bool false))))))))
					(set index index.inc)))
			(return (record.or (string.and (call direct_scalar_abi result))))))

	(fn numbered_fixed_pointer_owner_call
		(:doc "Open a nullable native owner with a direct integer or two checked immutable C strings.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(let arity function/arity)
			(let strings function/c_strings)
			(let scalar (bool:and (arity.eq 1i32) strings.eqz))
			(let text (bool:and (arity.eq 2i32) (strings.eq 2i32)))
			(if
				(:doc "Only these fixed constructor shapes can use this result and destructor proof.")
				(bool:or (bool:not (scalar.or text))
					(bool:or (bool:or (i32:not-eqz function/c_nulls) function/c_snapshot)
						(bool:or (bool:or function/c_storage (i32:not-eqz function/c_extents))
							(bool:or (i32:not-eqz function/c_variadic)
								(bool:or (call has_c_other_arguments function (bool true)) (call is_record_input function))))))
				(then (return (bool false))))
			(if
				(:doc "Both constructors return a pointer owner with its original native cleanup contract.")
				(bool:not (call is_numbered_pointer_owner (borrow-shared source) (borrow-shared nodes)
					function/result))
				(then (return (bool false))))
			(let first function/params)
			(let input (parameters.get first))
			(if
				(:doc "A descriptor is a direct integer operand with its original native width and signedness.")
				scalar
				(then
					(let type input/type)
					(return (bool:and (call is_c_value_mode input/c_mode)
						(bool:or (call is_builtin_integer type) (call is_native_integer type))))))
			(return (bool:and (call checked_shared_cstr_parameter input)
				(call checked_shared_cstr_parameter (parameters.get first.inc))))))

	(fn numbered_nullable_storage_parameter
		(:doc "A nullable shared formal still selects a certified complete native owner layout and destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameter ScalarParameter))
		(returns bool)
		(body
			(return (bool:and (u8:eq parameter/c_mode c_nullable_storage_shared_mode)
				(call is_numbered_storage_owner (borrow-shared source) (borrow-shared nodes) parameter/type)))))

	(fn numbered_pointer_owner_consume
		(:doc "Pass one native pointer owner to its declared destructor and preserve the direct scalar result.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(if
				(:doc "The declaration must be fixed and leave both the captured pointer and returned status unchanged.")
				(bool:or (bool:or (i32:not-eq function/arity 1i32)
						(bool:not (call direct_scalar_abi function/result)))
					(bool:or (bool:or function/c_storage (i32:not-eqz function/c_extents))
						(bool:or (i32:not-eqz function/c_variadic)
							(bool:or (call has_c_other_arguments function (bool false)) (call is_record_input function)))))
				(then (return (bool false))))
			(let formal (parameters.get function/params))
			(let type formal/type)
			(if
				(:doc "Only the checked move of an ordinary native pointer owner uses this proof.")
				(bool:not (bool:and (u8:eq formal/c_mode (call c_consume_mode))
					(call is_numbered_pointer_owner (borrow-shared source) (borrow-shared nodes) type)))
				(then (return (bool false))))
			(let owner (call native_owner_contract (borrow-shared source) (borrow-shared nodes) type))
			(let drop (nodes.get owner/drop))
			(let symbol (nodes.get function/name))
			(return (call same_bytes (borrow-shared source) (call native_symbol_start symbol) (call native_symbol_end symbol)
				(borrow-shared source) drop/start drop/end))))

	(fn numbered_nullable_integer_call
		(:doc "Admit a single nullable writable native integer place among direct scalar formals.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord))) (returns bool)
		(body
			(if
				(:doc "Only the nullable integer loan adapts the fixed native signature.")
				(bool:or (bool:or (i32:not-eq function/c_nulls 1i32)
						(bool:not (call direct_scalar_abi function/result)))
					(bool:or (bool:or (i32:not-eqz function/c_strings) function/c_snapshot)
						(bool:or (bool:or function/c_storage (i32:not-eqz function/c_extents))
							(bool:or (i32:not-eqz function/c_variadic)
								(bool:or (call has_c_other_arguments function (bool true)) (call is_record_input function))))))
				(then (return (bool false))))
			(let-mut index function/params)
			(let end (index.add function/arity))
			(let-mut nullable (bool false))
			(while
				(:doc "Preserve each direct value and require the nullable formal to write to an integer place.")
				(index.lt end)
				(body
					(let parameter (parameters.get index))
					(let type parameter/type)
					(let mode parameter/c_mode)
					(if
						(:doc "The one nullable argument uses the same native pointer for either call form.")
						(mode.eq c_nullable_native_reference_mode)
						(then
							(if (nullable.or (bool:not (call is_mutable_place_reference type)))
								(then (return (bool false))))
							(let pointee (call place_reference_target (borrow-shared records) type))
							(if (bool:not (bool:or (call is_builtin_integer pointee) (call is_native_integer pointee)))
								(then (return (bool false))))
							(set nullable (bool true)))
						(else
							(if (bool:not (bool:and (call is_c_value_mode mode) (call direct_scalar_abi type)))
								(then (return (bool false))))))
					(set index index.inc)))
			(return nullable)))

	(fn numbered_vector_pair_call
		(:doc "Admit a native integer output and checked filename with two nullable storage loans and two terminated vectors.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(function ScalarFunction) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord))) (returns bool)
		(body
			(let unsupported (bool:or (bool:or function/c_macro (i32:not-eqz function/c_variadic))
				(bool:or (bool:or function/c_void_pointer function/c_handle_out)
					(bool:or (bool:or function/c_fixed function/c_snapshot)
						(bool:or (i32:not-eqz function/c_extents) (call is_record_input function))))))
			(if
				(:doc "The six original formals must have only the expected adapters and an i32 status result.")
				(unsupported.or (bool:or (i32:not-eq function/arity 6i32)
					(bool:or (u32:not-eq function/result 5u32)
						(bool:or (i32:not-eq function/c_strings 1i32)
							(i32:not-eq function/c_nulls 2i32)))))
				(then (return (bool false))))
			(let first function/params)
			(let output (parameters.get first))
			(let output_type output/type)
			(if
				(:doc "C writes through the caller's original mutable native integer place.")
				(bool:not (bool:and (call is_c_value_mode output/c_mode)
					(bool:and (call is_mutable_place_reference output_type)
						(call is_native_integer (call place_reference_target (borrow-shared records) output_type)))))
				(then (return (bool false))))
			(return (bool:and (call checked_shared_cstr_parameter (parameters.get first.inc))
				(bool:and (call numbered_nullable_storage_parameter (borrow-shared source) (borrow-shared nodes)
						(parameters.get (first.add 2i32)))
					(bool:and (call numbered_nullable_storage_parameter (borrow-shared source) (borrow-shared nodes)
							(parameters.get (first.add 3i32)))
						(bool:and (call is_c_vector_mode (struct:get (parameters.get (first.add 4i32)) c_mode))
							(call is_c_vector_mode (struct:get (parameters.get (first.add 5i32)) c_mode)))))))))

	(fn numbered_literal_array_call
		(:doc "Admit one writable integer view with a literal element bound and direct scalar operands.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord))) (returns bool)
		(body
			(if
				(:doc "The array is the only adapter and the native result is a scalar value.")
				(bool:or (bool:or (i32:not-eq function/c_extents 1i32)
						(i32:not-eqz function/c_variadic))
					(bool:or (bool:or function/c_storage (call is_record_input function))
						(bool:or (call has_c_other_arguments function (bool false))
							(bool:not (call direct_scalar_abi function/result)))))
				(then (return (bool false))))
			(let-mut index function/params)
			(let end (index.add function/arity))
			(let-mut array_formal (bool false))
			(while
				(:doc "Check the array layout and leave the other formals as ordinary C values.")
				(index.lt end)
				(body
					(let parameter (parameters.get index))
					(let mode parameter/c_mode)
					(let type parameter/type)
					(if
						(:doc "Only a fixed literal count can use the numbered native array contract.")
						(call is_c_array_mode mode)
						(then
							(if
								(:doc "The view must lend its writable storage through the existing checked bound.")
								(bool:or (bool:not (call is_writable_slice type))
									(bool:or (i32:not-ltz parameter/c_count)
										(i32:not-gtz parameter/c_size)))
								(then (return (bool false))))
							(let element (call slice_element_type (borrow-shared records) type))
							(if
								(:doc "The C call receives a pointer to the same checked integer element type.")
								(bool:not (bool:or (call is_builtin_integer element) (call is_native_integer element)))
								(then (return (bool false))))
							(set array_formal (bool true)))
						(else
							(if
								(:doc "Scalar flags and other values must already use the direct native ABI.")
								(bool:not (bool:and (call is_c_value_mode mode) (call direct_scalar_abi type)))
								(then (return (bool false))))))
					(set index index.inc)))
			(return array_formal)))

	(fn numbered_macro_call
		(:doc "Check the fixed scalar argument and value result contract for an expression macro.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter))) (returns bool)
		(body
			(if
				(:doc "Statements and signatures with independent native adaptations stay serial.")
				(bool:or (bool:not function/c_macro)
					(bool:or (bool:not (call direct_scalar_abi function/result))
						(bool:or (call has_c_argument_adapters function (bool false) (bool false))
							(bool:or function/c_storage
								(bool:or (i32:not-eqz function/c_variadic)
									(bool:or (i32:gtz function/c_extents) (call is_record_input function)))))))
				(then (return (bool false))))
			(let-mut index function/params)
			(let end (index.add function/arity))
			(while
				(:doc "Each macro argument must be captured as its exact scalar C type.")
				(index.lt end)
				(body
					(let parameter (parameters.get index))
					(if
						(:doc "The probe uses the existing value passing ABI for every formal.")
						(bool:not (bool:and (call is_c_value_mode parameter/c_mode)
							(call direct_scalar_abi parameter/type)))
						(then (return (bool false))))
					(set index index.inc)))
			(return (bool true))))

	(struct NumberedVariadicCall (fields (prefix i32) (command i32) (operand i32)))

	(fn numbered_named_variadic_call
		(:doc "Find the native prefix and any checked header command of a closed named C tail.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter))) (returns NumberedVariadicCall)
		(body
			(let rejected (struct:new NumberedVariadicCall (prefix -1i32) (command -1i32) (operand -1i32)))
			(let tail function/c_variadic)
			(let result function/result)
			(let fixed function/c_fixed)
			(if
				(:doc "Admit direct captures. A fixed command uses scalar operands without string conversion.")
				(bool:or (bool:or tail.not-gtz (tail.eq c_open_variadic_tail))
					(bool:or (bool:or function/c_macro function/c_snapshot)
						(bool:or (bool:or function/c_storage (call is_record_input function))
							(bool:or (bool:or (i32:gtz function/c_extents) (i32:gtz function/c_nulls))
								(bool:or (call has_c_argument_adapters function fixed.not (bool true))
									(bool:and (result.not-eq (call void_type))
										(bool:not (call direct_scalar_abi result))))))))
				(then (return rejected)))
			(let first function/params)
			(let end (first.add function/arity))
			(let-mut position first)
			(let-mut native function/c_formals)
			(let-mut ordinal 0i32)
			(let-mut prefix -1i32)
			(let-mut command -1i32)
			(let-mut operand -1i32)
			(while
				(:doc "Count the native prefix including the command, which consumes no Wove argument.")
				native.not-ltz
				(body
					(if (native.eq tail) (then (set prefix ordinal)))
					(let item (nodes.get native))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(if
						(:doc "Only one plain i32 header constant may appear before the named tail.")
						(fixed.and (call is_c_fixed_formal (borrow-shared source) (borrow-shared nodes) parts))
						(then
							(let value (call c_fixed_formal_at (borrow-shared source) (borrow-shared nodes) native))
							(if
								(:doc "A literal, native type annotation, or second hidden operand is outside this proof.")
								(bool:or (bool:or prefix.not-ltz command.not-ltz)
									(bool:or (i32:ltz value/constant) (i32:not-ltz value/native_type)))
								(then (return rejected)))
							(set command ordinal)
							(set operand native))
						(else
							(if (position.not-lt end) (then (return rejected)))
							(let parameter (parameters.get position))
							(let type parameter/type)
							(let scalar (bool:and (call is_c_value_mode parameter/c_mode)
								(call direct_scalar_abi type)))
							(if
								(:doc "Only the ordinary fixed prefix can contain a converted NUL-checked string.")
								(bool:not (scalar.or (bool:and fixed.not (bool:and prefix.ltz
									(call checked_shared_cstr_parameter parameter)))))
								(then (return rejected)))
							(if
								(:doc "A fixed command's tail passes named integer values through Clang's promotions.")
								(bool:and (fixed.and prefix.not-ltz)
									(bool:not (bool:or (call is_builtin_integer type) (call is_native_integer type))))
								(then (return rejected)))
							(set position position.inc)))
					(set native item/next_sibling)
					(set ordinal ordinal.inc)))
			(if
				(:doc "The witness needs both a native prefix and a declared tail.")
				(bool:or (bool:or (position.not-eq end) prefix.not-gtz)
					(bool:or (prefix.not-lt ordinal) (fixed.and command.ltz)))
				(then (return rejected)))
			(return (struct:new NumberedVariadicCall (prefix prefix) (command command) (operand operand)))))

	(fn ordinary_bridge_signature
		(:doc "Admit direct scalar, pointer loan, fixed storage, and bounded byte contracts.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(function ScalarFunction) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (borrows bool)) (returns bool)
		(body
			(if
				(:doc "Only fixed macros with direct scalar captures can be replayed as expressions.")
				function/c_macro
				(then (return (call numbered_macro_call function (borrow-shared parameters)))))
			(if
				(:doc "Only named, completely declared C tails can use the promotion proof.")
				(i32:not-eqz function/c_variadic)
				(then (return (i32:gtz (struct:get (call numbered_named_variadic_call (borrow-shared source)
					(borrow-shared nodes) function (borrow-shared parameters)) prefix)))))
			(if
				(:doc "Both snapshot contracts use the existing immediate copy and their declared cleanup.")
				(bool:or (call numbered_owned_cstr_call function (borrow-shared parameters))
					(call numbered_borrowed_cstr_call function (borrow-shared parameters)))
				(then (return (bool true))))
			(if
				(:doc "Field snapshots use the original loan and witness the return record's native layout.")
				(call numbered_field_snapshot_call (borrow-shared source) (borrow-shared nodes) function
					(borrow-shared parameters))
				(then (return (bool true))))
			(if
				(:doc "Checked fixed calls reuse the existing string preparation or the original record place.")
				(call numbered_adapted_fixed_call function (borrow-shared parameters) (borrow-shared records))
				(then (return (bool true))))
			(if
				(:doc "A fixed integer array passes its original pointer after the existing extent check.")
				(call numbered_literal_array_call function (borrow-shared parameters) (borrow-shared records))
				(then (return (bool true))))
			(if
				(:doc "The checked vector pair uses the existing file, storage, and vector preparations.")
				(call numbered_vector_pair_call (borrow-shared source) (borrow-shared nodes) function
					(borrow-shared parameters) (borrow-shared records))
				(then (return (bool true))))
			(if
				(:doc "A checked nullable integer loan uses the exact pointer and the original writable address.")
				(call numbered_nullable_integer_call function (borrow-shared parameters) (borrow-shared records))
				(then (return (bool true))))
			(if
				(:doc "Constructing or explicitly closing a pointer owner requires the exact native owner and destructor proofs.")
				(bool:or (call numbered_fixed_pointer_owner_call (borrow-shared source) (borrow-shared nodes) function
						(borrow-shared parameters))
					(call numbered_pointer_owner_consume (borrow-shared source) (borrow-shared nodes) function
						(borrow-shared parameters)))
				(then (return (bool true))))
			(let result function/result)
			(if
				(:doc "Void and direct scalar results need no ownership adapter.")
				(bool:or (call has_c_other_arguments function (bool false))
					(bool:and (result.not-eq (call void_type)) (bool:not (call direct_scalar_abi result))))
				(then (return (bool false))))
			(let-mut index function/params)
			(let end (index.add function/arity))
			(while
				(:doc "Check each scalar value or existing shared pointer loan before replay.")
				(index.lt end)
				(body
					(let parameter (parameters.get index))
					(let type parameter/type)
					(let mode parameter/c_mode)
					(let borrowed (borrows.and (bool:and (call is_native_owner type)
						(call is_c_value_mode mode))))
					(let storage (bool:and (bool:and (call is_c_storage_mode mode)
							(mode.not-eq c_storage_init_always_mode))
						(call is_numbered_storage_owner (borrow-shared source) (borrow-shared nodes) type)))
					(let bytes (bool:and (call is_c_bytes_mode mode) (call is_byte_view_type type)))
					(let scalar (bool:and (call is_c_value_mode mode) (call direct_scalar_abi type)))
					(if
						(:doc "Each argument must have a supported mode and keep its original native representation.")
						(bool:not (bool:or (borrowed.or storage) (bytes.or scalar)))
						(then (return (bool false))))
					(set index index.inc)))
			(return (bool true))))

	(fn numbered_program_preamble
		(:doc "Select serial output or the include proof needed by the checked native declarations.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(trees (shared-array ScalarTree)) (statements (shared-array ScalarStatement))) (returns u8)
		(body
			(let-mut index 0i32)
			(let-mut has_bridge (bool false))
			(let-mut mode 1u8)
			(while
				(:doc "Check the binding contracts before trying to certify the include prefix.")
				(index.lt bindings.len)
				(body
					(let binding (bindings.get index))
					(if
						(:doc "Each selected native binding must share the same audited include context.")
						(call includes_c_header binding)
						(then
							(let admitted (call numbered_bridge_binding (borrow-shared source) (borrow-shared nodes)
								binding (borrow-shared records)
								(borrow-shared trees) (borrow-shared statements)))
							(if admitted.eqz (then (return 0u8)))
							(if
								(:doc "The borrowed pointer proof already covers the implicit header.")
								(bool:and (u8:lt 1u8 admitted) (mode.not-eq 2u8))
								(then (set mode admitted)))
							(set has_bridge (bool true))))
					(set index index.inc)))
			(let count (call checked_function_count (borrow-shared functions)))
			(set index 0i32)
			(while
				(:doc "Check native signatures before any numbered output is published.")
				(has_bridge.and (index.lt count))
				(body
					(let function (functions.get index))
					(if
						(:doc "Only verified native argument and result contracts may use the numbered emitter.")
						(i32:ltz function/body)
						(then
							(if
								(:doc "A signature outside the supported ABI keeps the graph serial.")
								(bool:not (call ordinary_bridge_signature (borrow-shared source) (borrow-shared nodes)
									function (borrow-shared parameters) (borrow-shared records) (mode.eq 2u8)))
								(then (return 0u8)))
							(if
								(:doc "Checked native adapters require the effective preamble even without a selected type.")
								(bool:and (mode.eq 1u8) (bool:or (bool:or function/c_snapshot
										(bool:or function/c_storage (i32:gtz function/c_extents)))
									(bool:or (bool:or function/c_macro (i32:gtz function/c_variadic))
										(bool:or (i32:gtz function/c_nulls)
											(bool:or (call numbered_adapted_fixed_call function (borrow-shared parameters) (borrow-shared records))
												(bool:or (call numbered_fixed_pointer_owner_call (borrow-shared source) (borrow-shared nodes)
														function (borrow-shared parameters))
													(call numbered_pointer_owner_consume (borrow-shared source) (borrow-shared nodes)
														function (borrow-shared parameters))))))))
								(then (set mode numbered_preamble_replay)))))
					(set index index.inc)))
			(return mode)))

	(fn write_unit_bodies
		(:doc "Render each contiguous run of bodies assigned to this unit through the shared emitter.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))
			(assignments (shared-array UnitIndex)) (unit i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index 0i32)
			(while
				(:doc "Retain checked row order even when a specialization follows bodies from other units.")
				(index.lt assignments.len)
				(body
					(if
						(:doc "Emit a run of this unit's definitions, skipping the other units' rows.")
						(i32:eq (struct:get (assignments.get index) value) unit)
						(then
							(let first index)
							(while
								(:doc "Advance to the next partition boundary or the end of the plan.")
								(bool:and (index.lt assignments.len)
									(i32:eq (struct:get (assignments.get index) value) unit))
								(body (set index index.inc)))
							(set cursor (call write_program_bodies (borrow-shared source)
								(borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
								(borrow-shared statements) (borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
								first index (borrow-mut output) cursor (bool false)
								name_prefix writing)))
						(else (set index index.inc)))))
			(return cursor)))

	(fn write_numbered_pass
		(:doc "Measure or write the common header, numbered C bodies, and any test or library entry points.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(assignments (shared-array UnitIndex)) (count i32) (name_prefix i32)
			(paths (shared-array u8)) (includes (shared-array CInclude)) (headers Includes)
			(tests (shared-array DiscoveredTest)) (test_count i32) (library bool)
			(output (mut-array u8)) (ends (mut-array UnitIndex)) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_program_preamble (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) 0u32 headers/stdint headers/runtime (bool false)
				declared_module_bindings declared_worker_adapters name_prefix writing))
			(if writing (then (ends.set 0i32 (struct:new UnitIndex (value (i32:from-u32 cursor))))))
			(let-mut unit 0i32)
			(while
				(:doc "Replay the audited serial include prefix at translation-unit depth before generated declarations.")
				(unit.lt count)
				(body
					(set cursor (call append_includes (borrow-shared paths) (borrow-shared includes)
						headers/count (borrow-mut output) cursor writing))
					(set cursor (call c_literal_text (borrow-shared program_include)
						(borrow-mut output) cursor writing))
					(if
						(:doc "Unit zero owns the shared immutable data, worker adapters, and erased worker drop callbacks.")
						unit.eqz
						(then
							(set cursor (call write_module_bindings
								(borrow-shared source) (borrow-shared nodes) (borrow-shared statements)
								(borrow-shared expressions) (borrow-shared records) linked_module_bindings
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call write_worker_adapters (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared functions) (borrow-shared expressions)
								linked_worker_adapters (borrow-mut output) cursor name_prefix writing))))
					(set cursor (call write_unit_bodies (borrow-shared source) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
						(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions) (borrow-shared assignments)
						unit (borrow-mut output) cursor name_prefix writing))
					(set unit unit.inc)
					(if
						(:doc "Append the serial dispatch to the last body unit with declarations for every test body.")
						(bool:and (unit.eq count) test_count.not-ltz)
						(then (set cursor (call write_test_entry (borrow-shared source)
							(borrow-shared files) (borrow-shared nodes) (borrow-shared functions)
							(borrow-shared tests) test_count (borrow-mut output)
							cursor name_prefix writing))))
					(if
						(:doc "The last unit defines every public wrapper once and calls checked bodies through the common header.")
						(bool:and (unit.eq count) library)
						(then (set cursor (call write_library_abi (borrow-shared source) (borrow-shared nodes)
							(borrow-shared functions) (borrow-shared parameters) (borrow-mut output)
							cursor name_prefix 0u32 writing))))
					(if writing (then (ends.set unit (struct:new UnitIndex (value (i32:from-u32 cursor))))))))
			(return cursor)))
)
