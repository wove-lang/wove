(module emit_units
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Partition and emit an already checked graph as numbered C units.")

	(use wove-file "../hashing/base32hex.wove" (only encode_base32hex32))
	(use wove-file "../c/arguments.wove" (only is_c_value_mode))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/native_owner_types.wove" (only is_native_owner))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only find_native_definition is_native_integer is_native_record (type ScalarRecord)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../source/graph.wove" (only includes_c_header (type GraphBinding)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "./bindings.wove" (only write_module_bindings (value declared_module_bindings) (value linked_module_bindings)))
	(use wove-file "./c.wove" (only has_c_arguments write_program_preamble write_program_bodies))
	(use wove-file "./c_values.wove" (only is_c_integer_constant))
	(use wove-file "../source/types.wove" (only is_builtin_scalar void_type))
	(use wove-file "./headers.wove" (only append_includes (type CInclude) (type Includes)))
	(use wove-file "./library.wove" (only write_library_abi))
	(use wove-file "./text.wove" (only c_literal_text))
	(use wove-file "./workers.wove" (only write_worker_adapters (value declared_worker_adapters) (value linked_worker_adapters)))
	(use wove-file "./tests.wove" (only write_test_entry))

	(struct UnitIndex (fields (value i32)))

	(let unit_name_template "unit-0000000.c")
	(let program_include "#include \"program.h\"\n")
	(let numbered_preamble_replay 3u8)

	(fn write_unit_name
		(:doc "Write a numbered source filename with the archive's seven-digit base32hex ordinal.")
		(params (ordinal i32) (output (mut-array u8))) (returns i32)
		(body
			(let width (array.len unit_name_template))
			(if
				(:doc "The emitter writes the name only after its entire output span fits.")
				(bool.or (i32.ltz ordinal) (i32.lt (array.len output) width))
				(then (return 0i32)))
			(let written (call c_literal_text (borrow-shared unit_name_template) (borrow-mut output) 0u32 (bool true)))
			(if
				(:doc "Replace the seven placeholder digits with the checked ordinal.")
				(call encode_base32hex32 (u32.from-i32 ordinal) (borrow-mut output) 5i32)
				(then (return (i32.from-u32 written))))
			(return 0i32)))

	(fn balance_groups
		(:doc "Distribute the items over a positive unit count, giving the first groups any extra items.")
		(params (units i32) (groups (mut-array UnitIndex))) (returns void)
		(body
			(let items (u32.from-i32 (array.len groups)))
			(let count (u32.from-i32 units))
			(let share (i32.from-u32 (u32.div items count)))
			(let extra (i32.from-u32 (u32.rem items count)))
			(let-mut unit 0i32)
			(let-mut item 0i32)
			(while
				(:doc "Distribute the remainder over the first groups in order.")
				(i32.lt unit units)
				(body
					(let-mut stop (i32.add item share))
					(if (i32.lt unit extra) (then (set stop (i32.inc stop))))
					(while
						(:doc "Give every item in the contiguous range the same unit.")
						(i32.lt item stop)
						(body
							(array.store groups item (struct.new UnitIndex (value unit)))
							(set item (i32.inc item))))
					(set unit (i32.inc unit))))))

	(fn plan_unit_assignments
		(:doc "Balance whole body-owning modules where possible, then fall back to declaration ranges.")
		(:expect (tests "stage-2/numbered_units/cases.jsonc") (issues "gh:wove-lang/wove:206"))
		(params (functions (shared-array ScalarFunction)) (files i32) (requested i32) (assignments (mut-array UnitIndex)))
		(returns i32)
		(body
			(let-mut modules (array.alloc UnitIndex files))
			(let-mut active 0i32)
			(let-mut bodies 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Rank body-owning files by first checked definition, including files with specialized bodies.")
				(i32.lt index (array.len assignments))
				(body
					(let function (array.load functions index))
					(if
						(:doc "A foreign prototype does not consume a body's share of the work.")
						(i32.not-ltz (struct.get function body))
						(then
							(let file (struct.get function file))
							(if
								(:doc "A file keeps one rank even when additional specializations are appended later.")
								(i32.eqz (struct.get (array.load modules file) value))
								(then
									(set active (i32.inc active))
									(array.store modules file (struct.new UnitIndex (value active)))))
							(set bodies (i32.inc bodies))))
					(set index (i32.inc index))))
			(let-mut width requested)
			(if (i32.lt bodies width) (then (set width bodies)))
			(if (i32.not-lt 1i32 width) (then (return width)))
			(let by_module (i32.not-lt active width))
			(let-mut items bodies)
			(if by_module (then (set items active)))
			(let-mut groups (array.alloc UnitIndex items))
			(call balance_groups width (borrow-mut groups))
			(set index 0i32)
			(set bodies 0i32)
			(while
				(:doc "Keep assignments as a parallel table so every reference retains its exact checked function row.")
				(i32.lt index (array.len assignments))
				(body
					(let function (array.load functions index))
					(if
						(:doc "Only Wove body rows receive a unit number.")
						(i32.not-ltz (struct.get function body))
						(then
							(let-mut item bodies)
							(if
								(:doc "All definitions from the same file use its original rank when grouping modules.")
								by_module
								(then (set item (i32.dec (struct.get (array.load modules (struct.get function file)) value)))))
							(array.store assignments index
								(array.load groups item))
							(set bodies (i32.inc bodies))))
					(set index (i32.inc index))))
			(return width)))

	(fn direct_scalar_abi
		(:doc "Built-in scalars and checked native integer aliases use direct C value passing.")
		(params (type u32)) (returns bool)
		(body (return (bool.or (call is_builtin_scalar type) (call is_native_integer type)))))

	(fn numbered_bridge_binding
		(:doc "Classify the selected declaration before certifying its include context.")
		(params (binding GraphBinding) (records (shared-array ScalarRecord))
			(trees (shared-array ScalarTree)) (statements (shared-array ScalarStatement))) (returns u8)
		(body
			(if (struct.get binding optional) (then (return 0u8)))
			(let namespace (struct.get binding namespace))
			(if (u32.eqz namespace) (then (return 1u8)))
			(if
				(:doc "Checked integer constants and shared pointer values require the complete preamble context.")
				(u32.eq namespace 2u32)
				(then
					(if (struct.get binding value_macro) (then (return 0u8)))
					(let base (struct.get (array.load trees (struct.get binding file)) base))
					(let definition (i32.add base (struct.get binding declaration)))
					(if
						(:doc "Use the integer constant contract of the defining row for every selected alias.")
						(call is_c_integer_constant (array.load statements definition))
						(then (return numbered_preamble_replay)))
					(if
						(:doc "Only checked shared references to native pointer resources carry a destructor contract.")
						(bool.and (i32.gtz (struct.get binding native_type))
							(i32.not-ltz (struct.get binding drop_start)))
						(then (return 2u8)))
					(return 0u8)))
			(if (u32.not-eq namespace 1u32) (then (return 0u8)))
			(let row (call find_native_definition (borrow-shared records)
				(struct.get binding native_file) (struct.get binding native_type)))
			(if (i32.ltz row) (then (return 0u8)))
			(let layout (array.load records row))
			(if
				(:doc "A native integer typedef needs its original literal in the shared header.")
				(bool.and (i32.gtz (struct.get layout native)) (i32.eq (struct.get layout count) -1i32))
				(then (return 1u8)))
			(if
				(:doc "A nonempty native record view checks real C members and uses the header's complete layout.")
				(bool.and (call is_native_record layout) (i32.gtz (struct.get layout count)))
				(then (return numbered_preamble_replay)))
			(return 0u8)))

	(fn ordinary_bridge_signature
		(:doc "Admit direct scalar calls and shared pointer parameters when verifying live native values.")
		(params (function ScalarFunction) (parameters (shared-array ScalarParameter)) (borrows bool)) (returns bool)
		(body
			(let result (struct.get function result))
			(if
				(:doc "Void and direct scalar results need no ownership adapter.")
				(bool.or (bool.or (call has_c_arguments function)
					(i32.not-eqz (struct.get function c_variadic)))
					(bool.and (u32.not-eq result (call void_type)) (bool.not (call direct_scalar_abi result))))
				(then (return (bool false))))
			(let-mut index (struct.get function params))
			(let end (i32.add index (struct.get function arity)))
			(while
				(:doc "Check each scalar value or existing shared pointer loan before replay.")
				(i32.lt index end)
				(body
					(let parameter (array.load parameters index))
					(let type (struct.get parameter type))
					(let borrowed (bool.and borrows (bool.and (call is_native_owner type)
						(call is_c_value_mode (struct.get parameter c_mode)))))
					(if
						(:doc "Only scalars and direct shared pointer handles can cross the unadapted native call.")
						(bool.not (bool.or borrowed (call direct_scalar_abi type)))
						(then (return (bool false))))
					(set index (i32.inc index))))
			(return (bool true))))

	(fn numbered_program_preamble
		(:doc "Select serial output or the include proof needed by the checked native declarations.")
		(params (bindings (shared-array GraphBinding)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(trees (shared-array ScalarTree)) (statements (shared-array ScalarStatement))) (returns u8)
		(body
			(let-mut index 0i32)
			(let-mut has_bridge (bool false))
			(let-mut mode 1u8)
			(while
				(:doc "Check the binding contracts before trying to certify the include prefix.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(if
						(:doc "Each selected native binding must share the same audited include context.")
						(call includes_c_header binding)
						(then
							(let admitted (call numbered_bridge_binding binding (borrow-shared records)
								(borrow-shared trees) (borrow-shared statements)))
							(if (u8.eqz admitted) (then (return 0u8)))
							(if
								(:doc "The borrowed pointer proof already covers the implicit header.")
								(bool.and (u8.lt 1u8 admitted) (u8.not-eq mode 2u8))
								(then (set mode admitted)))
							(set has_bridge (bool true))))
					(set index (i32.inc index))))
			(let count (call checked_function_count (borrow-shared functions)))
			(set index 0i32)
			(while
				(:doc "Check native signatures before any numbered output is published.")
				(bool.and has_bridge (i32.lt index count))
				(body
					(let function (array.load functions index))
					(if
						(:doc "The numbered emitter reuses the checked direct call without generating an ABI wrapper.")
						(bool.and (i32.ltz (struct.get function body))
							(bool.not (call ordinary_bridge_signature function (borrow-shared parameters) (u8.eq mode 2u8))))
						(then (return 0u8)))
					(set index (i32.inc index))))
			(return mode)))

	(fn write_unit_bodies
		(:doc "Render each contiguous run of bodies assigned to this unit through the shared emitter.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(assignments (shared-array UnitIndex)) (unit i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index 0i32)
			(while
				(:doc "Retain checked row order even when a specialization follows bodies from other units.")
				(i32.lt index (array.len assignments))
				(body
					(if
						(:doc "Emit a run of this unit's definitions, skipping the other units' rows.")
						(i32.eq (struct.get (array.load assignments index) value) unit)
						(then
							(let first index)
							(while
								(:doc "Advance to the next partition boundary or the end of the plan.")
								(bool.and (i32.lt index (array.len assignments))
									(i32.eq (struct.get (array.load assignments index) value) unit))
								(body (set index (i32.inc index))))
							(set cursor (call write_program_bodies (borrow-shared source)
								(borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
								(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
								first index (borrow-mut output) cursor (bool false)
								name_prefix writing)))
						(else (set index (i32.inc index))))))
			(return cursor)))

	(fn write_numbered_pass
		(:doc "Measure or write the common header, numbered C bodies, and any test or library entry points.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(assignments (shared-array UnitIndex)) (count i32) (name_prefix i32)
			(paths (shared-array u8)) (includes (shared-array CInclude)) (headers Includes)
			(tests (shared-array DiscoveredTest)) (test_count i32) (library bool)
			(output (mut-array u8)) (ends (mut-array UnitIndex)) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_program_preamble (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)
				(borrow-mut output) 0u32 (struct.get headers stdint) (struct.get headers runtime) (bool false)
				declared_module_bindings declared_worker_adapters name_prefix writing))
			(if writing (then (array.store ends 0i32 (struct.new UnitIndex (value (i32.from-u32 cursor))))))
			(let-mut unit 0i32)
			(while
				(:doc "Replay the audited serial include prefix at translation-unit depth before generated declarations.")
				(i32.lt unit count)
				(body
					(set cursor (call append_includes (borrow-shared paths) (borrow-shared includes)
						(struct.get headers count) (borrow-mut output) cursor writing))
					(set cursor (call c_literal_text (borrow-shared program_include)
						(borrow-mut output) cursor writing))
					(if
						(:doc "Unit zero owns the shared immutable data, worker adapters, and erased worker drop callbacks.")
						(i32.eqz unit)
						(then
							(set cursor (call write_module_bindings
								(borrow-shared source) (borrow-shared nodes) (borrow-shared statements)
								(borrow-shared expressions) (borrow-shared records) linked_module_bindings
								(borrow-mut output) cursor name_prefix writing))
							(set cursor (call write_worker_adapters (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared functions) (borrow-shared expressions)
								linked_worker_adapters (borrow-mut output) cursor name_prefix writing))))
					(set cursor (call write_unit_bodies (borrow-shared source) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
						(borrow-shared records) (borrow-shared expressions) (borrow-shared assignments)
						unit (borrow-mut output) cursor name_prefix writing))
					(set unit (i32.inc unit))
					(if
						(:doc "Append the serial dispatch to the last body unit with declarations for every test body.")
						(bool.and (i32.eq unit count) (i32.not-ltz test_count))
						(then (set cursor (call write_test_entry (borrow-shared source)
							(borrow-shared files) (borrow-shared nodes) (borrow-shared functions)
							(borrow-shared tests) test_count (borrow-mut output)
							cursor name_prefix writing))))
					(if
						(:doc "The last unit defines every public wrapper once and calls checked bodies through the common header.")
						(bool.and (i32.eq unit count) library)
						(then (set cursor (call write_library_abi (borrow-shared source) (borrow-shared nodes)
							(borrow-shared functions) (borrow-shared parameters) (borrow-mut output)
							cursor name_prefix 0u32 writing))))
					(if writing (then (array.store ends unit (struct.new UnitIndex (value (i32.from-u32 cursor))))))))
			(return cursor)))
)
