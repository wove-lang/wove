(module emit_units
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Partition and emit an already checked, bridge-free executable graph for the native graph probe.")

	(use wove-file "../hashing/base32hex.wove" (only encode_base32hex32))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../source/graph.wove" (only includes_c_header (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./bindings.wove" (only write_module_bindings (value declared_module_bindings) (value linked_module_bindings)))
	(use wove-file "./c.wove" (only write_program_preamble write_program_bodies))
	(use wove-file "./text.wove" (only c_literal_text))
	(use wove-file "./workers.wove" (only is_record_worker_launch))

	(struct UnitIndex (fields (value i32)))

	(let unit_name_template "unit-0000000.c")
	(let program_include "#include \"program.h\"\n")

	(fn write_unit_name
		(:doc "Write a test unit filename with the archive's seven-digit base32hex ordinal.")
		(params (ordinal i32) (output (mut-array u8))) (returns i32)
		(body
			(let width (array.len (local unit_name_template)))
			(if
				(:doc "The emitter writes the name only after its entire output span fits.")
				(bool.or (i32.ltz (local ordinal)) (i32.lt (array.len (local output)) (local width)))
				(then (return 0i32)))
			(let written (call c_literal_text (borrow-shared (local unit_name_template)) (borrow-mut (local output)) 0u32 (bool true)))
			(if
				(:doc "Replace the seven placeholder digits with the checked ordinal.")
				(call encode_base32hex32 (u32.from-i32 (local ordinal)) (borrow-mut (local output)) 5i32)
				(then (return (i32.from-u32 (local written)))))
			(return 0i32)))

	(fn balance_groups
		(:doc "Assign contiguous groups and give the first groups one extra item when needed.")
		(params (units i32) (groups (mut-array UnitIndex))) (returns void)
		(body
			(let-mut extra (array.len (local groups)))
			(let-mut share 0i32)
			(while
				(:doc "Find the quotient and remainder once using the seed's integer subset.")
				(i32.not-lt (local extra) (local units))
				(body
					(set (local extra) (i32.sub (local extra) (local units)))
					(set (local share) (i32.inc (local share)))))
			(let-mut unit 0i32)
			(let-mut item 0i32)
			(while
				(:doc "Distribute the remainder over the first groups in order.")
				(i32.lt (local unit) (local units))
				(body
					(let-mut stop (i32.add (local item) (local share)))
					(if (i32.lt (local unit) (local extra)) (then (set (local stop) (i32.inc (local stop)))))
					(while
						(:doc "Give every item in the contiguous range the same unit.")
						(i32.lt (local item) (local stop))
						(body
							(array.store (local groups) (local item) (struct.new UnitIndex (value (local unit))))
							(set (local item) (i32.inc (local item)))))
					(set (local unit) (i32.inc (local unit)))))))

	(fn plan_unit_assignments
		(:doc "Balance whole body-owning modules where possible, then fall back to declaration ranges.")
		(:expect (tests "stage-2/numbered_units/cases.jsonc") (issues "gh:wove-lang/wove:206"))
		(params (functions (shared-array ScalarFunction)) (files i32) (requested i32) (assignments (mut-array UnitIndex)))
		(returns i32)
		(body
			(let-mut modules (array.alloc UnitIndex (local files)))
			(let-mut active 0i32)
			(let-mut bodies 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Rank body-owning files by first checked definition, including files with specialized bodies.")
				(i32.lt (local index) (array.len (local assignments)))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "A foreign prototype does not consume a body's share of the work.")
						(i32.not-ltz (struct.get (local function) body))
						(then
							(let file (struct.get (local function) file))
							(if
								(:doc "A file keeps one rank even when additional specializations are appended later.")
								(i32.eqz (struct.get (array.load (local modules) (local file)) value))
								(then
									(set (local active) (i32.inc (local active)))
									(array.store (local modules) (local file) (struct.new UnitIndex (value (local active))))))
							(set (local bodies) (i32.inc (local bodies)))))
					(set (local index) (i32.inc (local index)))))
			(let-mut width (local requested))
			(if (i32.lt (local bodies) (local width)) (then (set (local width) (local bodies))))
			(if (i32.not-lt 1i32 (local width)) (then (return (local width))))
			(let by_module (i32.not-lt (local active) (local width)))
			(let-mut items (local bodies))
			(if (local by_module) (then (set (local items) (local active))))
			(let-mut groups (array.alloc UnitIndex (local items)))
			(call balance_groups (local width) (borrow-mut (local groups)))
			(set (local index) 0i32)
			(set (local bodies) 0i32)
			(while
				(:doc "Keep assignments as a parallel table so every reference retains its exact checked function row.")
				(i32.lt (local index) (array.len (local assignments)))
				(body
					(let function (array.load (local functions) (local index)))
					(if
						(:doc "Only Wove body rows receive a unit number.")
						(i32.not-ltz (struct.get (local function) body))
						(then
							(let-mut item (local bodies))
							(if
								(:doc "All definitions from the same file use its original rank when grouping modules.")
								(local by_module)
								(then (set (local item) (i32.dec (struct.get (array.load (local modules) (struct.get (local function) file)) value)))))
							(array.store (local assignments) (local index)
								(array.load (local groups) (local item)))
							(set (local bodies) (i32.inc (local bodies)))))
					(set (local index) (i32.inc (local index)))))
			(return (local width))))

	(fn can_share_program_preamble
		(:doc "Admit graphs whose preamble is safe to include in every numbered unit.")
		(params (bindings (shared-array GraphBinding)) (expressions (shared-array ScalarExpression))) (returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Selected bridge imports need a policy for native preprocessing across units.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(if (call includes_c_header (array.load (local bindings) (local index))) (then (return (bool false))))
					(set (local index) (i32.inc (local index)))))
			(set (local index) 0i32)
			(while
				(:doc "Record worker adapters still need a definition owner before partitioning.")
				(i32.lt (local index) (array.len (local expressions)))
				(body
					(if (call is_record_worker_launch (array.load (local expressions) (local index))) (then (return (bool false))))
					(set (local index) (i32.inc (local index)))))
			(return (bool true))))

	(fn write_unit_bodies
		(:doc "Render each contiguous run of bodies assigned to this unit through the shared emitter.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(assignments (shared-array UnitIndex)) (unit i32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut index 0i32)
			(while
				(:doc "Retain checked row order even when a specialization follows bodies from other units.")
				(i32.lt (local index) (array.len (local assignments)))
				(body
					(if
						(:doc "Emit a run of this unit's definitions, skipping the other units' rows.")
						(i32.eq (struct.get (array.load (local assignments) (local index)) value) (local unit))
						(then
							(let first (local index))
							(while
								(:doc "Advance to the next partition boundary or the end of the plan.")
								(bool.and (i32.lt (local index) (array.len (local assignments)))
									(i32.eq (struct.get (array.load (local assignments) (local index)) value) (local unit)))
								(body (set (local index) (i32.inc (local index)))))
							(set (local cursor) (call write_program_bodies (borrow-shared (local source))
								(borrow-shared (local nodes)) (borrow-shared (local functions)) (borrow-shared (local parameters))
								(borrow-shared (local statements)) (borrow-shared (local records)) (borrow-shared (local expressions))
								(local first) (local index) (borrow-mut (local output)) (local cursor) (bool false)
								(local name_prefix) (local writing))))
						(else (set (local index) (i32.inc (local index)))))))
			(return (local cursor))))

	(fn write_numbered_pass
		(:doc "Measure or write a common header followed by the independent numbered C bodies.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(statements (shared-array ScalarStatement)) (records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression))
			(assignments (shared-array UnitIndex)) (count i32) (name_prefix i32)
			(output (mut-array u8)) (ends (mut-array UnitIndex)) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call write_program_preamble (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local statements))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (borrow-shared (local expressions))
				(borrow-mut (local output)) 0u32 (bool false) (bool false) (bool false)
				(local declared_module_bindings) (local name_prefix) (local writing)))
			(if (local writing) (then (array.store (local ends) 0i32 (struct.new UnitIndex (value (i32.from-u32 (local cursor)))))))
			(let-mut unit 0i32)
			(while
				(:doc "Give every body unit the common declarations and exactly the definitions assigned to it.")
				(i32.lt (local unit) (local count))
				(body
					(set (local cursor) (call c_literal_text (borrow-shared (local program_include))
						(borrow-mut (local output)) (local cursor) (local writing)))
					(if
						(:doc "Unit zero owns the immutable definitions referenced through the common header.")
						(i32.eqz (local unit))
						(then (set (local cursor) (call write_module_bindings
							(borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local statements))
							(borrow-shared (local expressions)) (borrow-shared (local records)) (local linked_module_bindings)
							(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
					(set (local cursor) (call write_unit_bodies (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local statements))
						(borrow-shared (local records)) (borrow-shared (local expressions)) (borrow-shared (local assignments))
						(local unit) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local unit) (i32.inc (local unit)))
					(if (local writing) (then (array.store (local ends) (local unit) (struct.new UnitIndex (value (i32.from-u32 (local cursor)))))))))
			(return (local cursor))))
)
