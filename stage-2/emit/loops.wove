(module emit_loops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a counted C loop from captured bounds, a borrowed view, or a moved owner.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement) (value for_mut_binding)))
	(use wove-file "../scalar/records.wove" (only is_array_owner is_readable_slice (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./runtime.wove" (only write_slice_items write_slice_length close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))

	(let declare_index "int32_t ")
	(let zero_value "=0;")
	(let open_for "for(;")
	(let next_iteration ";++")
	(let open_body "){")
	(let immutable "const ")
	(let discarding ";(void)")
	(let pointer_cast "((const ")
	(let writable_pointer_cast "&((")
	(let const_item_pointer " *const ")
	(let cast_pointer "*)")
	(let open_element ")[")

	(fn write_iteration_binding
		(:doc `Bind the cursor, a copied array element, or the address of a writable element.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name i32) (type u32) (row i32) (view i32) (tree_base i32) (writable bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Range values and shared items are declared as const values.")
				(bool.not (local writable))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local immutable)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "An exclusive item's pointer stays bound to its element throughout the iteration.")
				(local writable)
				(then (set (local cursor) (call c_literal_text (borrow-shared (local const_item_pointer)) (borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local name) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(let loading (i32.lt -1i32 (local view)))
			(if
				(:doc "The loop test proves the position is inside the typed borrowed descriptor.")
				(local loading)
				(then
					(if
						(:doc "Take the original element address for an exclusive view and load a value for a shared view.")
						(local writable)
						(then (set (local cursor) (call c_literal_text (borrow-shared (local writable_pointer_cast)) (borrow-mut (local output)) (local cursor) (local writing))))
						(else (set (local cursor) (call c_literal_text (borrow-shared (local pointer_cast)) (borrow-mut (local output)) (local cursor) (local writing)))))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local cast_pointer)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local view) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call write_slice_items (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local open_element)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Close the typed element subscript after emitting the cursor.")
				(local loading)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 93u8 (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local discarding)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local name) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))))

	(let declare_slice "wvrt_slice ")
	(let borrow_owner "=wvrt_array_borrow_shared(")
	(let declare_owner "wvrt_array* ")
	(let take_row "=wvrt_array_take_row_at_span(")
	(let borrow_row "=wvrt_array_borrow_row_at_span(")

	(fn write_for_owned_view
		(:doc `Form the iteration descriptor from the loop's captured array owner.`)
		(params (source (shared-array u8)) (owner i32) (view i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared (local declare_slice)) (borrow-mut (local output)) (local offset) (local writing)))
			(let name (call write_temporary_name (borrow-shared (local source)) (local view) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let borrow (call c_literal_text (borrow-shared (local borrow_owner)) (borrow-mut (local output)) (local name) (local writing)))
			(let value (call write_temporary_name (borrow-shared (local source)) (local owner) (local tree_base)
				(borrow-mut (local output)) (local borrow) (local name_prefix) (local writing)))
			(let close (call c_byte (borrow-mut (local output)) (local value) 41u8 (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local close) 59u8 (local writing)))))

	(fn write_row_iteration_binding
		(:doc `Bind the current populated row as a shared view or as a transferred owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32)
			(row i32) (owner i32) (tree_base i32) (site ScalarExpression) (borrowed bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut open (local offset))
			(if
				(:doc "Use a descriptor value for a borrowed row and an owner pointer for a moved row.")
				(local borrowed)
				(then (set (local open) (call c_literal_text (borrow-shared (local declare_slice))
					(borrow-mut (local output)) (local offset) (local writing))))
				(else (set (local open) (call c_literal_text (borrow-shared (local declare_owner))
					(borrow-mut (local output)) (local offset) (local writing)))))
			(let local_name (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local name) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(let-mut take (local local_name))
			(if
				(:doc "Borrowing checks the same slot while leaving its ownership in the parent.")
				(local borrowed)
				(then (set (local take) (call c_literal_text (borrow-shared (local borrow_row))
					(borrow-mut (local output)) (local take) (local writing))))
				(else (set (local take) (call c_literal_text (borrow-shared (local take_row))
					(borrow-mut (local output)) (local take) (local writing)))))
			(let source_name (call write_temporary_name (borrow-shared (local source)) (local owner) (local tree_base)
				(borrow-mut (local output)) (local take) (local name_prefix) (local writing)))
			(let comma (call c_byte (borrow-mut (local output)) (local source_name) 44u8 (local writing)))
			(let index (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local comma) (local name_prefix) (local writing)))
			(let close (call close_runtime_call (borrow-mut (local output)) (local index)
				(struct.get (local site) target) (struct.get (local site) start) (struct.get (local site) end) (local writing)))
			(if
				(:doc "The borrowed descriptor is still checked for presence when the body ignores it.")
				(local borrowed)
				(then
					(let ignore (call c_literal_text (borrow-shared (local discarding)) (borrow-mut (local output)) (local close) (local writing)))
					(let ignored_name (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local name) (local tree_base)
						(borrow-mut (local output)) (local ignore) (local name_prefix) (local writing)))
					(return (call c_byte (borrow-mut (local output)) (local ignored_name) 59u8 (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local close) 59u8 (local writing)))))

	(fn write_for_body
		(:doc `Open a counted loop and bind the current values before its first source statement.

		The update runs on ordinary completion and continue. The cursor
		only advances from a value strictly below the captured end.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (row i32) (block i32) (tree_base i32) (array_view bool)
			(owner i32) (site ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut view -1i32)
			(if
				(:doc "Array offsets start at zero in the captured view. Range cursors are already initialized.")
				(local array_view)
				(then
					(set (local view) (local block))
					(set (local cursor) (call c_literal_text (borrow-shared (local declare_index)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local zero_value)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local open_for)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 60u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local block) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Use the captured view's element count as its exclusive end.")
				(local array_view)
				(then (set (local cursor) (call write_slice_length (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local next_iteration)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local open_body)) (borrow-mut (local output)) (local cursor) (local writing)))
			(let first (struct.get (array.load (local statements) (local block)) target))
			(let second (struct.get (array.load (local nodes) (local first)) next_sibling))
			(let-mut item (local first))
			(if
				(:doc "In the indexed form bind the view-relative index before the item.")
				(i32.lt -1i32 (local second))
				(then
					(set (local cursor) (call write_iteration_binding (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local first) 5u32 (local row) -1i32 (local tree_base) (bool false)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local item) (local second))))
			(let binding (array.load (local statements) (local item)))
			(if
				(:doc "An owning item takes the current slot. Ordinary items keep the existing value or view path.")
				(call is_array_owner (struct.get (local binding) type))
				(then (return (call write_row_iteration_binding (borrow-shared (local source)) (borrow-shared (local nodes))
					(local item) (local row) (local owner) (local tree_base) (local site) (bool false)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(if
				(:doc "A borrowed nested row stays owned by the original backing slot.")
				(call is_readable_slice (struct.get (local binding) type))
				(then (return (call write_row_iteration_binding (borrow-shared (local source)) (borrow-shared (local nodes))
					(local item) (local row) (local view) (local tree_base) (local site) (bool true)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(return (call write_iteration_binding (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local item) (struct.get (local binding) type)
				(local row) (local view) (local tree_base) (u32.eq (struct.get (local binding) kind) (local for_mut_binding)) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))))
