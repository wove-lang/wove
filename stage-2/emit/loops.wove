(module emit_loops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a counted C loop from a previously captured range or shared descriptor.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./runtime.wove" (only write_slice_items write_slice_length))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))

	(let declare_index "int32_t ")
	(let zero_value "=0;")
	(let open_for "for(;")
	(let next_iteration ";++")
	(let open_body "){")
	(let immutable "const ")
	(let discarding ";(void)")
	(let pointer_cast "((const ")
	(let cast_pointer "*)")
	(let open_element ")[")

	(fn write_iteration_binding
		(:doc `Declare one immutable name and initialize it from the cursor or its array element.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name i32) (type u32) (row i32) (view i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (call c_literal_text (borrow-shared (local immutable)) (borrow-mut (local output)) (local offset) (local writing)))
			(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 32u8 (local writing)))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local name) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 61u8 (local writing)))
			(let loading (i32.lt -1i32 (local view)))
			(if
				(:doc "The loop test proves the position is inside the typed borrowed descriptor.")
				(local loading)
				(then
					(set (local cursor) (call c_literal_text (borrow-shared (local pointer_cast)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local type) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local cast_pointer)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local view) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call write_slice_items (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local open_element)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Close the typed element subscript after emitting the cursor.")
				(local loading)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 93u8 (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local discarding)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local name) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))))

	(fn write_for_body
		(:doc `Open a counted loop and bind the current values before its first source statement.

		The update runs on ordinary completion and continue. The cursor
		only advances from a value strictly below the captured end.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (row i32) (block i32) (tree_base i32) (array_view bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(let-mut view -1i32)
			(if
				(:doc "Array offsets start at zero in the captured view. Range cursors are already initialized.")
				(local array_view)
				(then
					(set (local view) (local block))
					(set (local cursor) (call c_literal_text (borrow-shared (local declare_index)) (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local cursor) (call c_literal_text (borrow-shared (local zero_value)) (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local open_for)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 60u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local block) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Use the captured view's element count as its exclusive end.")
				(local array_view)
				(then (set (local cursor) (call write_slice_length (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call c_literal_text (borrow-shared (local next_iteration)) (borrow-mut (local output)) (local cursor) (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local row) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_literal_text (borrow-shared (local open_body)) (borrow-mut (local output)) (local cursor) (local writing)))
			(let first (struct.get (array.load (local statements) (local block)) target))
			(let second (struct.get (array.load (local nodes) (local first)) next_sibling))
			(let-mut item (local first))
			(if
				(:doc "In the indexed form bind the view-relative index before copying the item.")
				(i32.lt -1i32 (local second))
				(then
					(set (local cursor) (call write_iteration_binding (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (local first) 5u32 (local row) -1i32 (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
					(set (local item) (local second))))
			(return (call write_iteration_binding (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (local item) (struct.get (array.load (local statements) (local item)) type)
				(local row) (local view) (local tree_base) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))))
