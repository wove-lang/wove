(module emit_loops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit a counted C loop from captured bounds, a borrowed view, or a moved owner.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement) (value for_mut_binding)))
	(use wove-file "../scalar/records.wove" (only is_array_owner is_readable_slice (type ScalarRecord)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./records.wove" (only write_value_type))
	(use wove-file "./runtime.wove" (only write_slice_items write_slice_length close_runtime_call))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_local_name write_temporary_name))

	(let declare_index "int32_t ")
	(let zero_value "=0;")
	(let open_for "for(;")
	(let next_iteration ";++")
	(let open_body "){")
	(let immutable "const ")
	(let discarding ";(void)")
	(let pointer_cast "((const ")
	(let writable_pointer_cast "&((")
	(let const_item_pointer " *const ")
	(let cast_pointer "*)")
	(let open_element ")[")

	(fn write_iteration_binding
		(:doc `Bind the cursor, a copied array element, or the address of a writable element.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(name i32) (type u32) (row i32) (view i32) (tree_base i32) (writable bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Range values and shared items are declared as const values.")
				(bool.not writable)
				(then (set cursor (call c_literal_text (borrow-shared immutable) (borrow-mut output) cursor writing))))
			(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "An exclusive item's pointer stays bound to its element throughout the iteration.")
				writable
				(then (set cursor (call c_literal_text (borrow-shared const_item_pointer) (borrow-mut output) cursor writing)))
				(else (set cursor (call c_byte (borrow-mut output) cursor 32u8 writing))))
			(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes) name tree_base
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 61u8 writing))
			(let loading (i32.lt -1i32 view))
			(if
				(:doc "The loop test proves the position is inside the typed borrowed descriptor.")
				loading
				(then
					(if
						(:doc "Take the original element address for an exclusive view and load a value for a shared view.")
						writable
						(then (set cursor (call c_literal_text (borrow-shared writable_pointer_cast) (borrow-mut output) cursor writing)))
						(else (set cursor (call c_literal_text (borrow-shared pointer_cast) (borrow-mut output) cursor writing))))
					(set cursor (call write_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) type (borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared cast_pointer) (borrow-mut output) cursor writing))
					(set cursor (call write_temporary_name (borrow-shared source) view tree_base
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call write_slice_items (borrow-mut output) cursor writing))
					(set cursor (call c_literal_text (borrow-shared open_element) (borrow-mut output) cursor writing))))
			(set cursor (call write_temporary_name (borrow-shared source) row tree_base
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Close the typed element subscript after emitting the cursor.")
				loading
				(then (set cursor (call c_byte (borrow-mut output) cursor 93u8 writing))))
			(set cursor (call c_literal_text (borrow-shared discarding) (borrow-mut output) cursor writing))
			(set cursor (call write_local_name (borrow-shared source) (borrow-shared nodes) name tree_base
				(borrow-mut output) cursor name_prefix writing))
			(return (call c_byte (borrow-mut output) cursor 59u8 writing))))

	(let declare_slice "wvrt_slice ")
	(let borrow_owner "=wvrt_array_borrow_shared(")
	(let declare_owner "wvrt_array* ")
	(let take_row "=wvrt_array_take_row_at_span(")
	(let borrow_row "=wvrt_array_borrow_row_at_span(")

	(fn write_for_owned_view
		(:doc `Form the iteration descriptor from the loop's captured array owner.`)
		(params (source (shared-array u8)) (owner i32) (view i32) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let open (call c_literal_text (borrow-shared declare_slice) (borrow-mut output) offset writing))
			(let name (call write_temporary_name (borrow-shared source) view tree_base
				(borrow-mut output) open name_prefix writing))
			(let borrow (call c_literal_text (borrow-shared borrow_owner) (borrow-mut output) name writing))
			(let value (call write_temporary_name (borrow-shared source) owner tree_base
				(borrow-mut output) borrow name_prefix writing))
			(let close (call c_byte (borrow-mut output) value 41u8 writing))
			(return (call c_byte (borrow-mut output) close 59u8 writing))))

	(fn write_row_iteration_binding
		(:doc `Bind the current populated row as a shared view or as a transferred owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32)
			(row i32) (owner i32) (tree_base i32) (site ScalarExpression) (borrowed bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut open offset)
			(if
				(:doc "Use a descriptor value for a borrowed row and an owner pointer for a moved row.")
				borrowed
				(then (set open (call c_literal_text (borrow-shared declare_slice)
					(borrow-mut output) offset writing)))
				(else (set open (call c_literal_text (borrow-shared declare_owner)
					(borrow-mut output) offset writing))))
			(let local_name (call write_local_name (borrow-shared source) (borrow-shared nodes) name tree_base
				(borrow-mut output) open name_prefix writing))
			(let-mut take local_name)
			(if
				(:doc "Borrowing checks the same slot while leaving its ownership in the parent.")
				borrowed
				(then (set take (call c_literal_text (borrow-shared borrow_row)
					(borrow-mut output) take writing)))
				(else (set take (call c_literal_text (borrow-shared take_row)
					(borrow-mut output) take writing))))
			(let source_name (call write_temporary_name (borrow-shared source) owner tree_base
				(borrow-mut output) take name_prefix writing))
			(let comma (call c_byte (borrow-mut output) source_name 44u8 writing))
			(let index (call write_temporary_name (borrow-shared source) row tree_base
				(borrow-mut output) comma name_prefix writing))
			(let close (call close_runtime_call (borrow-mut output) index
				(struct.get site target) (struct.get site start) (struct.get site end) writing))
			(if
				(:doc "The borrowed descriptor is still checked for presence when the body ignores it.")
				borrowed
				(then
					(let ignore (call c_literal_text (borrow-shared discarding) (borrow-mut output) close writing))
					(let ignored_name (call write_local_name (borrow-shared source) (borrow-shared nodes) name tree_base
						(borrow-mut output) ignore name_prefix writing))
					(return (call c_byte (borrow-mut output) ignored_name 59u8 writing))))
			(return (call c_byte (borrow-mut output) close 59u8 writing))))

	(fn write_for_body
		(:doc `Open a counted loop and bind the current values before its first source statement.

		The update runs on ordinary completion and continue. The cursor
		only advances from a value strictly below the captured end.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (row i32) (block i32) (tree_base i32) (array_view bool)
			(owner i32) (site ScalarExpression) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut view -1i32)
			(if
				(:doc "Array offsets start at zero in the captured view. Range cursors are already initialized.")
				array_view
				(then
					(set view block)
					(set cursor (call c_literal_text (borrow-shared declare_index) (borrow-mut output) cursor writing))
					(set cursor (call write_temporary_name (borrow-shared source) row tree_base
						(borrow-mut output) cursor name_prefix writing))
					(set cursor (call c_literal_text (borrow-shared zero_value) (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared open_for) (borrow-mut output) cursor writing))
			(set cursor (call write_temporary_name (borrow-shared source) row tree_base
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 60u8 writing))
			(set cursor (call write_temporary_name (borrow-shared source) block tree_base
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Use the captured view's element count as its exclusive end.")
				array_view
				(then (set cursor (call write_slice_length (borrow-mut output) cursor writing))))
			(set cursor (call c_literal_text (borrow-shared next_iteration) (borrow-mut output) cursor writing))
			(set cursor (call write_temporary_name (borrow-shared source) row tree_base
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_literal_text (borrow-shared open_body) (borrow-mut output) cursor writing))
			(let first (struct.get (array.load statements block) target))
			(let second (struct.get (array.load nodes first) next_sibling))
			(let-mut item first)
			(if
				(:doc "In the indexed form bind the view-relative index before the item.")
				(i32.lt -1i32 second)
				(then
					(set cursor (call write_iteration_binding (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) first 5u32 row -1i32 tree_base (bool false)
						(borrow-mut output) cursor name_prefix writing))
					(set item second)))
			(let binding (array.load statements item))
			(if
				(:doc "An owning item takes the current slot. Ordinary items keep the existing value or view path.")
				(call is_array_owner (struct.get binding type))
				(then (return (call write_row_iteration_binding (borrow-shared source) (borrow-shared nodes)
					item row owner tree_base site (bool false)
					(borrow-mut output) cursor name_prefix writing))))
			(if
				(:doc "A borrowed nested row stays owned by the original backing slot.")
				(call is_readable_slice (struct.get binding type))
				(then (return (call write_row_iteration_binding (borrow-shared source) (borrow-shared nodes)
					item row view tree_base site (bool true)
					(borrow-mut output) cursor name_prefix writing))))
			(return (call write_iteration_binding (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) item (struct.get binding type)
				row view tree_base (u32.eq (struct.get binding kind) for_mut_binding) (borrow-mut output) cursor name_prefix writing)))))
