(module emit_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Prepare the selected C headers for a graph translation unit.

	Decode the declarations once, preserve system and project lookup,
	and keep one row per emitted include operand in selection order.`)

	(use wove-file "../c/headers.wove" (only c_header_form))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./text.wove" (only c_byte c_include_prefix c_span))

	(struct CInclude (fields (start i32) (end i32) (delimiter u8)))
	(struct IncludeCapacity (fields (bytes i32) (rows i32)))
	(struct Includes
		(fields (count i32) (length i32) (file i32) (start i32) (end i32) (error u32) (stdint bool) (runtime bool)))

	(fn first_header_binding
		(:doc `Identify the first binding that selects a particular bridge header literal.`)
		(params (bindings (shared-array GraphBinding)) (index i32) (binding GraphBinding))
		(returns bool)
		(body
			(if
				(:doc "Only C header bindings contribute include operands.")
				(u32.not-eq (struct.get (local binding) provider) 8u32)
				(then (return (bool false))))
			(let-mut previous 0i32)
			(while
				(:doc "Aliases and functions from the same bridge share one header literal.")
				(i32.lt (local previous) (local index))
				(body
					(let earlier (array.load (local bindings) (local previous)))
					(if
						(:doc "Use the defining file and its original literal offset.")
						(bool.and (u32.eq (struct.get (local earlier) provider) 8u32)
							(bool.and (i32.eq (struct.get (local earlier) header_file) (struct.get (local binding) header_file))
								(i32.eq (struct.get (local earlier) header_start) (struct.get (local binding) header_start))))
						(then (return (bool false))))
					(set (local previous) (i32.inc (local previous)))))
			(return (bool true))))

	(fn include_capacity
		(:doc `Size include rows and bound their decoded storage by the original literal widths.`)
		(params (bindings (shared-array GraphBinding)))
		(returns IncludeCapacity)
		(body
			(let-mut length 0i32)
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Count each literal once regardless of the number of selected functions and aliases.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let row (array.load (local bindings) (local index)))
					(if
						(:doc "Decoded path bytes always fit in the literal's original byte width.")
						(call first_header_binding (borrow-shared (local bindings)) (local index) (local row))
						(then
							(let width (i32.sub (struct.get (local row) header_end) (struct.get (local row) header_start)))
							(if
								(:doc "Overlapping supplied views can make the aggregate wider than a signed slice length.")
								(i32.lt (i32.sub 2147483647i32 (local length)) (local width))
								(then (return (struct.new IncludeCapacity (bytes -1i32) (rows 0i32)))))
							(set (local length) (i32.add (local length) (local width)))
							(set (local count) (i32.inc (local count)))))
					(set (local index) (i32.inc (local index)))))
			(return (struct.new IncludeCapacity (bytes (local length)) (rows (local count))))))

	(fn implicit_header_kind
		(:doc `Identify the two headers the C writer can also add automatically.`)
		(params (path (shared-array u8)) (start i32) (end i32) (delimiter u8))
		(returns u32)
		(body
			(let width (i32.sub (local end) (local start)))
			(if
				(:doc "The generated fixed-width types use the system header stdint.h.")
				(bool.and (u8.eq (local delimiter) 60u8) (bool.and (i32.eq (local width) 8i32)
					(bool.and (call is_three_bytes (borrow-shared (local path)) (local start) 115u8 116u8 100u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local path)) (i32.add (local start) 3i32) 105u8 110u8 116u8)
							(bool.and (call is_head_byte (borrow-shared (local path)) (local start) 6i32 46u8)
								(call is_head_byte (borrow-shared (local path)) (local start) 7i32 104u8))))))
				(then (return 1u32)))
			(if
				(:doc "The runtime writer uses the project include wove_runtime.h.")
				(bool.and (u8.eq (local delimiter) 34u8) (bool.and (i32.eq (local width) 14i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local path)) (local start) 119u8 111u8 118u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local path)) (i32.add (local start) 3i32) 101u8 95u8 114u8)
							(bool.and
								(call is_three_bytes (borrow-shared (local path)) (i32.add (local start) 6i32) 117u8 110u8 116u8)
								(bool.and
									(call is_three_bytes (borrow-shared (local path)) (i32.add (local start) 9i32) 105u8 109u8 101u8)
									(bool.and (call is_head_byte (borrow-shared (local path)) (local start) 12i32 46u8)
										(call is_head_byte (borrow-shared (local path)) (local start) 13i32 104u8))))))))
				(then (return 2u32)))
			(return 0u32)))

	(fn add_include
		(:doc `Add a checked include operand, combining equivalent bare and quoted project paths.`)
		(params (path (shared-array u8)) (start i32) (end i32) (delimiter u8) (previous Includes)
			(bytes (mut-array u8)) (headers (mut-array CInclude)))
		(returns Includes)
		(body
			(let count (struct.get (local previous) count))
			(let-mut index 0i32)
			(while
				(:doc "Only exact paths with the same include lookup rules share a row.")
				(i32.lt (local index) (local count))
				(body
					(let prior (array.load (local headers) (local index)))
					(if
						(:doc "A bare project path and its explicitly quoted form emit the same include.")
						(bool.and (u8.eq (struct.get (local prior) delimiter) (local delimiter))
							(call same_bytes (borrow-shared (local bytes))
								(struct.get (local prior) start) (struct.get (local prior) end)
								(borrow-shared (local path)) (local start) (local end)))
						(then (return (local previous))))
					(set (local index) (i32.inc (local index)))))
			(let offset (struct.get (local previous) length))
			(let limit (call c_span (borrow-shared (local path)) (local start) (local end)
				(borrow-mut (local bytes)) (u32.from-i32 (local offset)) (bool true)))
			(let length (i32.from-u32 (local limit)))
			(array.store (local headers) (local count)
				(struct.new CInclude (start (local offset)) (end (local length)) (delimiter (local delimiter))))
			(let implicit (call implicit_header_kind (borrow-shared (local path)) (local start) (local end) (local delimiter)))
			(return (struct.new Includes (count (i32.inc (local count))) (length (local length))
				(file -1i32) (start 0i32) (end 0i32) (error 0u32)
				(stdint (bool.or (struct.get (local previous) stdint) (u32.eq (local implicit) 1u32)))
				(runtime (bool.or (struct.get (local previous) runtime) (u32.eq (local implicit) 2u32)))))))

	(fn add_decoded_include
		(:doc `Check and trim the delimiters off a decoded header before recording its path.`)
		(params (path (shared-array u8)) (binding GraphBinding) (previous Includes)
			(bytes (mut-array u8)) (headers (mut-array CInclude)))
		(returns Includes)
		(body
			(let form (call c_header_form (borrow-shared (local path))))
			(if
				(:doc "A malformed operand points at the original declaring literal.")
				(u32.eqz (local form))
				(then (return (struct.new Includes (count 0i32) (length 0i32)
					(file (struct.get (local binding) header_file)) (start (struct.get (local binding) header_start))
					(end (struct.get (local binding) header_end)) (error 26u32)
					(stdint (bool false)) (runtime (bool false))))))
			(let-mut start 0i32)
			(let-mut end (array.len (local path)))
			(let-mut delimiter 34u8)
			(if
				(:doc "An angle-bracket header keeps its system search mode.")
				(u8.eq (array.load (local path) 0i32) 60u8)
				(then (set (local delimiter) 60u8)))
			(if
				(:doc "The include writer will add the checked form's delimiters.")
				(u32.eq (local form) 2u32)
				(then
					(set (local start) 1i32)
					(set (local end) (i32.dec (local end)))))
			(return (call add_include (borrow-shared (local path)) (local start) (local end) (local delimiter) (local previous)
				(borrow-mut (local bytes)) (borrow-mut (local headers))))))

	(fn include_plan
		(:doc `Package the initialized include prefix and the compiler headers it already contains.`)
		(params (count i32) (length i32) (stdint bool) (runtime bool))
		(returns Includes)
		(body
			(return (struct.new Includes (count (local count)) (length (local length)) (file -1i32)
				(start 0i32) (end 0i32) (error 0u32) (stdint (local stdint)) (runtime (local runtime))))))

	(fn prepare_includes
		(:doc `Prepare and validate one include per selected header before writing any C.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(bytes (mut-array u8)) (headers (mut-array CInclude)))
		(returns Includes)
		(body
			(let-mut count 0i32)
			(let-mut length 0i32)
			(let-mut stdint (bool false))
			(let-mut runtime (bool false))
			(let-mut index 0i32)
			(while
				(:doc "Visit distinct bridge literals in resolved selection order.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let row (array.load (local bindings) (local index)))
					(if
						(:doc "Use the key in the defining file, independent of import and alias spelling.")
						(call first_header_binding (borrow-shared (local bindings)) (local index) (local row))
						(then
							(let base (struct.get (array.load (local files) (struct.get (local row) header_file)) source_start))
							(let start (i32.add (local base) (struct.get (local row) header_start)))
							(let end (i32.add (local base) (struct.get (local row) header_end)))
							(let-mut path (array.alloc u8 (i32.sub (local end) (local start))))
							(let decoded (call decode_string (borrow-shared (local arena))
								(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
								(borrow-mut (local path))))
							(let previous (call include_plan (local count) (local length) (local stdint) (local runtime)))
							(let plan (call add_decoded_include
								(borrow-shared (array.range (local path) 0i32 (struct.get (local decoded) written)))
								(local row) (local previous) (borrow-mut (local bytes)) (borrow-mut (local headers))))
							(if
								(:doc "Propagate an invalid header operand without exposing partial C.")
								(u32.gtz (struct.get (local plan) error))
								(then (return (local plan))))
							(set (local count) (struct.get (local plan) count))
							(set (local length) (struct.get (local plan) length))
							(set (local stdint) (struct.get (local plan) stdint))
							(set (local runtime) (struct.get (local plan) runtime))))
					(set (local index) (i32.inc (local index)))))
			(return (call include_plan (local count) (local length) (local stdint) (local runtime)))))

	(fn include_position
		(:doc "Find the emitted position of a fully delimited header, including equivalent project spellings.")
		(params (bytes (shared-array u8)) (headers (shared-array CInclude)) (count i32) (header (shared-array u8)))
		(returns i32)
		(body
			(let delimiter (array.load (local header) 0i32))
			(let end (i32.dec (array.len (local header))))
			(let-mut index 0i32)
			(while
				(:doc "Match the exact include search mode and normalized path.")
				(i32.lt (local index) (local count))
				(body
					(let row (array.load (local headers) (local index)))
					(if
						(:doc "Duplicate spellings already share their first emitted position.")
						(bool.and (u8.eq (struct.get (local row) delimiter) (local delimiter))
							(call same_bytes (borrow-shared (local bytes)) (struct.get (local row) start)
								(struct.get (local row) end) (borrow-shared (local header)) 1i32 (local end)))
						(then (return (local index))))
					(set (local index) (i32.inc (local index)))))
			(return -1i32)))

	(fn write_includes
		(:doc `Measure and write the same include prefix, retaining system or project lookup.`)
		(params (bytes (shared-array u8)) (headers (shared-array CInclude)) (count i32)
			(output (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let-mut cursor 0u32)
			(let-mut index 0i32)
			(while
				(:doc "Emit one complete preprocessing directive for each planned include.")
				(i32.lt (local index) (local count))
				(body
					(let row (array.load (local headers) (local index)))
					(let open (struct.get (local row) delimiter))
					(let-mut close 34u8)
					(if
						(:doc "Angle brackets select system search while quotes preserve project lookup.")
						(u8.eq (local open) 60u8)
						(then (set (local close) 62u8)))
					(set (local cursor) (call c_include_prefix (borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local open) (local writing)))
					(set (local cursor) (call c_span (borrow-shared (local bytes))
						(struct.get (local row) start) (struct.get (local row) end)
						(borrow-mut (local output)) (local cursor) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) (local close) (local writing)))
					(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 10u8 (local writing)))
					(set (local index) (i32.inc (local index)))))
			(return (local cursor)))))
