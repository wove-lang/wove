(module emit_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Prepare the selected C headers for a graph translation unit.

	Decode the declarations once, preserve system and project lookup,
	and keep one row per emitted include operand in selection order.`)

	(use wove-file "../c/headers.wove" (only c_header_form))
	(use wove-file "../source/graph.wove" (only includes_c_header (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./text.wove" (only c_byte c_include_prefix c_span))

	(struct CInclude (fields (start i32) (end i32) (delimiter u8)))
	(struct IncludeCapacity (fields (bytes i32) (rows i32)))
	(struct Includes
		(fields (count i32) (length i32) (file i32) (start i32) (end i32) (error u32) (stdint bool) (runtime bool)))

	(fn first_header_binding
		(:doc `Identify the first binding in the requested range that selects a bridge header literal.`)
		(params (bindings (shared-array GraphBinding)) (first i32) (index i32) (binding GraphBinding))
		(returns bool)
		(body
			(if
				(:doc "Only C header bindings contribute include operands.")
				(bool:not (call includes_c_header binding))
				(then (return (bool false))))
			(let-mut previous first)
			(while
				(:doc "Aliases and functions from the same bridge share one header literal.")
				(previous.lt index)
				(body
					(let earlier (bindings.get previous))
					(if
						(:doc "Use the defining file and its original literal offset.")
						(bool:and (call includes_c_header earlier)
							(bool:and (earlier/header_file.eq binding/header_file)
								(earlier/header_start.eq binding/header_start)))
						(then (return (bool false))))
					(set previous previous.inc)))
			(return (bool true))))

	(fn include_capacity
		(:doc `Size the includes for a binding range and bound decoded storage by the original literal widths.`)
		(params (bindings (shared-array GraphBinding)) (first i32) (limit i32))
		(returns IncludeCapacity)
		(body
			(let-mut length 0i32)
			(let-mut count 0i32)
			(let-mut index first)
			(while
				(:doc "Count each literal once regardless of the number of selected functions and aliases.")
				(index.lt limit)
				(body
					(let row (bindings.get index))
					(if
						(:doc "Decoded path bytes always fit in the literal's original byte width.")
						(call first_header_binding (borrow-shared bindings) first index row)
						(then
							(let width (row/header_end.sub row/header_start))
							(if
								(:doc "Overlapping supplied views can make the aggregate wider than a signed slice length.")
								(i32:lt (i32:sub 2147483647i32 length) width)
								(then (return (IncludeCapacity.new (bytes -1i32) (rows 0i32)))))
							(set length (length.add width))
							(set count count.inc)))
					(set index index.inc)))
			(return (IncludeCapacity.new (bytes length) (rows count)))))

	(fn implicit_header_kind
		(:doc `Identify the two headers the C writer can also add automatically.`)
		(params (path (shared-array u8)) (start i32) (end i32) (delimiter u8))
		(returns u32)
		(body
			(let width (end.sub start))
			(if
				(:doc "The generated fixed-width types use the system header stdint.h.")
				(bool:and (delimiter.eq 60u8) (bool:and (width.eq 8i32)
					(bool:and (call is_three_bytes (borrow-shared path) start 115u8 116u8 100u8)
						(bool:and
							(call is_three_bytes (borrow-shared path) (start.add 3i32) 105u8 110u8 116u8)
							(bool:and (call is_head_byte (borrow-shared path) start 6i32 46u8)
								(call is_head_byte (borrow-shared path) start 7i32 104u8))))))
				(then (return 1u32)))
			(if
				(:doc "The runtime writer uses the project include wove_runtime.h.")
				(bool:and (delimiter.eq 34u8) (bool:and (width.eq 14i32)
					(bool:and
						(call is_three_bytes (borrow-shared path) start 119u8 111u8 118u8)
						(bool:and
							(call is_three_bytes (borrow-shared path) (start.add 3i32) 101u8 95u8 114u8)
							(bool:and
								(call is_three_bytes (borrow-shared path) (start.add 6i32) 117u8 110u8 116u8)
								(bool:and
									(call is_three_bytes (borrow-shared path) (start.add 9i32) 105u8 109u8 101u8)
									(bool:and (call is_head_byte (borrow-shared path) start 12i32 46u8)
										(call is_head_byte (borrow-shared path) start 13i32 104u8))))))))
				(then (return 2u32)))
			(return 0u32)))

	(fn add_include
		(:doc `Add a checked include operand, combining equivalent bare and quoted project paths.`)
		(params (path (shared-array u8)) (start i32) (end i32) (delimiter u8) (previous Includes)
			(bytes (mut-array u8)) (headers (mut-array CInclude)))
		(returns Includes)
		(body
			(let count previous/count)
			(let-mut index 0i32)
			(while
				(:doc "Only exact paths with the same include lookup rules share a row.")
				(index.lt count)
				(body
					(let prior (headers.get index))
					(if
						(:doc "A bare project path and its explicitly quoted form emit the same include.")
						(bool:and (prior/delimiter.eq delimiter)
							(call same_bytes (borrow-shared bytes)
								prior/start prior/end
								(borrow-shared path) start end))
						(then (return previous)))
					(set index index.inc)))
			(let offset previous/length)
			(let limit (call c_span (borrow-shared path) start end
				(borrow-mut bytes) (u32:from-i32 offset) (bool true)))
			(let length (i32:from-u32 limit))
			(headers.set count
				(CInclude.new (start offset) (end length) (delimiter delimiter)))
			(let implicit (call implicit_header_kind (borrow-shared path) start end delimiter))
			(return (Includes.new (count count.inc) (length length)
				(file -1i32) (start 0i32) (end 0i32) (error 0u32)
				(stdint (previous/stdint.or (implicit.eq 1u32)))
				(runtime (previous/runtime.or (implicit.eq 2u32)))))))

	(fn add_decoded_include
		(:doc `Check and trim the delimiters off a decoded header before recording its path.`)
		(params (path (shared-array u8)) (binding GraphBinding) (previous Includes)
			(bytes (mut-array u8)) (headers (mut-array CInclude)))
		(returns Includes)
		(body
			(let form (call c_header_form (borrow-shared path)))
			(if
				(:doc "A malformed operand points at the original declaring literal.")
				form.eqz
				(then (return (Includes.new (count 0i32) (length 0i32)
					(file binding/header_file) (start binding/header_start)
					(end binding/header_end) (error 26u32)
					(stdint (bool false)) (runtime (bool false))))))
			(let-mut start 0i32)
			(let-mut end path.len)
			(let-mut delimiter 34u8)
			(if
				(:doc "An angle-bracket header keeps its system search mode.")
				(u8:eq (path.get 0i32) 60u8)
				(then (set delimiter 60u8)))
			(if
				(:doc "The include writer will add the checked form's delimiters.")
				(form.eq 2u32)
				(then
					(set start 1i32)
					(set end end.dec)))
			(return (call add_include (borrow-shared path) start end delimiter previous
				(borrow-mut bytes) (borrow-mut headers)))))

	(fn include_plan
		(:doc `Package the initialized include prefix and the compiler headers it already contains.`)
		(params (count i32) (length i32) (stdint bool) (runtime bool))
		(returns Includes)
		(body
			(return (Includes.new (count count) (length length) (file -1i32)
				(start 0i32) (end 0i32) (error 0u32) (stdint stdint) (runtime runtime)))))

	(fn prepare_includes
		(:doc `Prepare and validate one include per selected header in a binding range.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (limit i32) (bytes (mut-array u8)) (headers (mut-array CInclude)))
		(returns Includes)
		(body
			(let-mut count 0i32)
			(let-mut length 0i32)
			(let-mut stdint (bool false))
			(let-mut runtime (bool false))
			(let-mut index first)
			(while
				(:doc "Visit distinct bridge literals in resolved selection order.")
				(index.lt limit)
				(body
					(let row (bindings.get index))
					(if
						(:doc "Use the key in the defining file, independent of import and alias spelling.")
						(call first_header_binding (borrow-shared bindings) first index row)
						(then
							(let base (struct:get (files.get row/header_file) source_start))
							(let start (base.add row/header_start))
							(let end (base.add row/header_end))
							(let-mut path (array:alloc u8 (end.sub start)))
							(let decoded (call decode_string (borrow-shared arena)
								(Token.new (kind 2u32) (start start) (end end) (error 0u32))
								(borrow-mut path)))
							(let previous (call include_plan count length stdint runtime))
							(let plan (call add_decoded_include
								(borrow-shared (path.range 0i32 decoded/written))
								row previous (borrow-mut bytes) (borrow-mut headers)))
							(if
								(:doc "Propagate an invalid header operand without exposing partial C.")
								plan/error.gtz
								(then (return plan)))
							(set count plan/count)
							(set length plan/length)
							(set stdint plan/stdint)
							(set runtime plan/runtime)))
					(set index index.inc)))
			(return (call include_plan count length stdint runtime))))

	(fn include_position
		(:doc "Find the emitted position of a fully delimited header, including equivalent project spellings.")
		(params (bytes (shared-array u8)) (headers (shared-array CInclude)) (count i32) (header (shared-array u8)))
		(returns i32)
		(body
			(let delimiter (header.get 0i32))
			(let end header.len.dec)
			(let-mut index 0i32)
			(while
				(:doc "Match the exact include search mode and normalized path.")
				(index.lt count)
				(body
					(let row (headers.get index))
					(if
						(:doc "Duplicate spellings already share their first emitted position.")
						(bool:and (row/delimiter.eq delimiter)
							(call same_bytes (borrow-shared bytes) row/start
								row/end (borrow-shared header) 1i32 end))
						(then (return index)))
					(set index index.inc)))
			(return -1i32)))

	(fn matches_verified_includes
		(:doc "Tie the caller's header audit to the exact selected include spellings and order.")
		(params (paths (shared-array u8)) (includes (shared-array CInclude)) (count i32) (verified (shared-array u8)))
		(returns bool)
		(body
			(let length verified.len)
			(if
				(:doc "A graph without selected C headers needs an empty include audit.")
				count.eqz
				(then (return length.eqz)))
			(if length.eqz (then (return (bool false))))
			(let-mut prefix (array:alloc u8 length))
			(let width (call write_includes (borrow-shared paths) (borrow-shared includes)
				count (borrow-mut prefix) (bool false)))
			(if
				(:doc "An absent or partial audit cannot authorize a different include context.")
				(width.not-eq (u32:from-i32 length))
				(then (return (bool false))))
			(let written (call write_includes (borrow-shared paths) (borrow-shared includes)
				count (borrow-mut prefix) (bool true)))
			(return (call same_bytes (borrow-shared prefix) 0i32 (i32:from-u32 written)
				(borrow-shared verified) 0i32 length))))

	(fn write_includes
		(:doc "Emit the selected include prefix at the start of a serial output.")
		(params (bytes (shared-array u8)) (headers (shared-array CInclude)) (count i32)
			(output (mut-array u8)) (writing bool)) (returns u32)
		(body (return (call append_includes (borrow-shared bytes) (borrow-shared headers)
			count (borrow-mut output) 0u32 writing))))

	(fn append_includes
		(:doc `Measure and write the same include prefix, retaining system or project lookup.`)
		(params (bytes (shared-array u8)) (headers (shared-array CInclude)) (count i32)
			(output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(let-mut index 0i32)
			(while
				(:doc "Emit one complete preprocessing directive for each planned include.")
				(index.lt count)
				(body
					(let row (headers.get index))
					(let open row/delimiter)
					(let-mut close 34u8)
					(if
						(:doc "Angle brackets select system search while quotes preserve project lookup.")
						(open.eq 60u8)
						(then (set close 62u8)))
					(set cursor (call c_include_prefix (borrow-mut output) cursor writing))
					(set cursor (call c_byte (borrow-mut output) cursor open writing))
					(set cursor (call c_span (borrow-shared bytes)
						row/start row/end
						(borrow-mut output) cursor writing))
					(set cursor (call c_byte (borrow-mut output) cursor close writing))
					(set cursor (call c_byte (borrow-mut output) cursor 10u8 writing))
					(set index index.inc)))
			(return cursor))))
