(module emit_c_extents
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check native byte and array extents using already evaluated call operands.

	Extent checks read the borrowed descriptors. The native call itself
	uses their original backing pointers.`)

	(use wove-file "../c/arguments.wove" (only is_c_array_mode is_c_extent_mode))
	(use wove-file "../source/types.wove" (only is_128bit_integer))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only is_native_integer is_writable_slice is_mutable_place_reference slice_element_type (type ScalarRecord)))
	(use wove-file "./runtime.wove" (only open_native_suffix open_shared_projection close_runtime_call write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))
	(use wove-file "./records.wove" (only write_value_type write_array_layout_argument))

	(struct CActual (fields (node i32) (type u32)))

	(let byte_check "wvrt_check_c_bytes")
	(let literal_array_check "wvrt_check_c_array(")
	(let named_array_check "wvrt_check_c_array_native(")
	(let const_pointer "const ")

	(fn open_c_byte_check
		(:doc `Open the runtime's checked byte extent call.`)
		(params (output (mut-array u8)) (offset u32) (native bool) (writing bool))
		(returns u32)
		(body
			(let cursor (call c_literal_text (borrow-shared byte_check) (borrow-mut output) offset writing))
			(if
				(:doc "A native factor needs a check in its original C width.")
				native
				(then (return (call open_native_suffix (borrow-mut output) cursor writing))))
			(return (call c_byte (borrow-mut output) cursor 40u8 writing))))

	(fn write_c_array_pointer_type
		(:doc `Write the exact C pointee type and qualify the element of a shared view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(view u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "A shared view passes a const-qualified element pointer.")
				(bool.not (call is_writable_slice view))
				(then (set cursor (call c_literal_text (borrow-shared const_pointer)
					(borrow-mut output) cursor writing))))
			(let type (call write_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (call slice_element_type (borrow-shared records) view)
				(borrow-mut output) cursor name_prefix writing))
			(return (call c_byte (borrow-mut output) type 42u8 writing))))

	(fn write_extent_view
		(:doc `Pass the captured descriptor as a shared view for bounds checking.`)
		(params (source (shared-array u8)) (argument i32) (tree_base i32) (mutable bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor offset)
			(if
				(:doc "Use the common read-only check for mutable storage.")
				mutable
				(then (set cursor (call open_shared_projection (borrow-mut output) cursor writing))))
			(set cursor (call write_temporary_name (borrow-shared source) argument tree_base
				(borrow-mut output) cursor name_prefix writing))
			(if
				(:doc "Finish the descriptor conversion before writing bounds.")
				mutable
				(then (set cursor (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(return cursor)))

	(fn map_c_actuals
		(:doc `Index the captured expression rows by their positions in the signature.`)
		(params (nodes (shared-array SourceNode)) (first i32) (parameters (shared-array ScalarParameter))
			(parameter_start i32) (output (mut-array CActual)))
		(returns void)
		(body
			(let-mut argument first)
			(let-mut index 0i32)
			(while
				(:doc "Arity checking established one actual for each formal.")
				(i32.lt index (array.len output))
				(body
					(let formal (array.load parameters (i32.add parameter_start index)))
					(array.store output index (struct.new CActual (node argument)
						(type (struct.get formal type))))
					(set argument (struct.get (array.load nodes argument) next_sibling))
					(set index (i32.inc index))))))

	(fn keeps_native_extent
		(:doc "Route native aliases and 128-bit dimensions through the width-preserving product check.")
		(params (type u32)) (returns bool)
		(body (return (bool.or (call is_native_integer type) (call is_128bit_integer type)))))

	(fn write_c_byte_check
		(:doc `Write one byte limit check for the data argument and its captured dimensions.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (actuals (shared-array CActual))
			(argument i32) (parameter ScalarParameter) (caller ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get caller name_base))
			(let mutable (u32.eq (struct.get parameter type) 38u32))
			(let size (struct.get parameter c_size))
			(let count (array.load actuals (struct.get parameter c_count)))
			(let native (bool.or (call keeps_native_extent (struct.get count type))
				(bool.and (i32.lt -1i32 size)
					(call keeps_native_extent (struct.get (array.load actuals size) type)))))
			(let open (call open_c_byte_check (borrow-mut output) offset native writing))
			(let-mut cursor (call write_extent_view (borrow-shared source) argument tree_base mutable
				(borrow-mut output) open name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(if
				(:doc "The count-only form uses an implicit byte size of one.")
				(i32.ltz size)
				(then (set cursor (call c_byte (borrow-mut output) cursor 49u8 writing)))
				(else
					(set cursor (call write_temporary_name (borrow-shared source)
						(struct.get (array.load actuals size) node) tree_base
						(borrow-mut output) cursor name_prefix writing))))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(set cursor (call write_temporary_name (borrow-shared source)
				(struct.get count node) tree_base
				(borrow-mut output) cursor name_prefix writing))
			(let node (array.load nodes argument))
			(let source_base (struct.get caller source_base))
			(set cursor (call close_runtime_call (borrow-mut output) cursor
				(struct.get caller file) (i32.sub (struct.get node start) source_base)
				(i32.sub (struct.get node end) source_base) writing))
			(return (call c_byte (borrow-mut output) cursor 59u8 writing))))

	(fn write_c_array_check
		(:doc `Check the literal or named element count against the captured native array view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(actuals (shared-array CActual)) (argument i32) (parameter ScalarParameter) (caller ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get caller name_base))
			(let type (struct.get parameter type))
			(let count (struct.get parameter c_count))
			(let-mut cursor offset)
			(if
				(:doc "Named counts retain their original integer width and signedness.")
				(i32.lt -1i32 count)
				(then (set cursor (call c_literal_text (borrow-shared named_array_check)
					(borrow-mut output) cursor writing)))
				(else (set cursor (call c_literal_text (borrow-shared literal_array_check)
					(borrow-mut output) cursor writing))))
			(set cursor (call write_extent_view (borrow-shared source) argument tree_base
				(call is_writable_slice type) (borrow-mut output) cursor name_prefix writing))
			(set cursor (call write_array_layout_argument (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (call slice_element_type (borrow-shared records) type) (bool false)
				(borrow-mut output) cursor name_prefix writing))
			(set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))
			(if
				(:doc "Render a checked literal directly or read the incoming count from its captured operand.")
				(i32.ltz count)
				(then
					(set cursor (call write_c_number (borrow-mut output) cursor
						(struct.get parameter c_size) writing)))
				(else
					(let actual (array.load actuals count))
					(if
						(:doc "Read an in-out count before the call without changing the original pointer passed to C.")
						(call is_mutable_place_reference (struct.get actual type))
						(then (set cursor (call c_byte (borrow-mut output) cursor 42u8 writing))))
					(set cursor (call write_temporary_name (borrow-shared source)
						(struct.get actual node) tree_base (borrow-mut output) cursor name_prefix writing))))
			(let node (array.load nodes argument))
			(let source_base (struct.get caller source_base))
			(set cursor (call close_runtime_call (borrow-mut output) cursor
				(struct.get caller file) (i32.sub (struct.get node start) source_base)
				(i32.sub (struct.get node end) source_base) writing))
			(return (call c_byte (borrow-mut output) cursor 59u8 writing))))

	(fn write_mapped_c_extent_checks
		(:doc `Emit the checks in formal order using the already evaluated arguments.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (actuals (shared-array CActual)) (caller ScalarFunction) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let arity (array.len actuals))
			(let-mut index 0i32)
			(let-mut cursor offset)
			(while
				(:doc "Check each bounded view before entering the native call.")
				(i32.lt index arity)
				(body
					(let parameter (array.load parameters (i32.add (struct.get callee params) index)))
					(let mode (struct.get parameter c_mode))
					(if
						(:doc "String conversions and ordinary scalars have separate lowering.")
						(call is_c_extent_mode mode)
						(then
							(let argument (struct.get (array.load actuals index) node))
							(if
								(:doc "Array extents count elements. Byte extents check their product in bytes.")
								(call is_c_array_mode mode)
								(then (set cursor (call write_c_array_check (borrow-shared source) (borrow-shared nodes)
									(borrow-shared records) (borrow-shared actuals) argument parameter caller
									(borrow-mut output) cursor name_prefix writing)))
								(else (set cursor (call write_c_byte_check (borrow-shared source) (borrow-shared nodes)
									(borrow-shared actuals) argument parameter caller
									(borrow-mut output) cursor name_prefix writing))))))
					(set index (i32.inc index))))
			(return cursor)))

	(fn write_c_extent_checks
		(:doc `Check every bounded C view before converting strings or invoking C.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let arity (struct.get callee arity))
			(let-mut actuals (array.alloc CActual arity))
			(call map_c_actuals (borrow-shared nodes) (struct.get expression first)
				(borrow-shared parameters) (struct.get callee params) (borrow-mut actuals))
			(return (call write_mapped_c_extent_checks (borrow-shared source) (borrow-shared nodes)
				(borrow-shared parameters) (borrow-shared records) (borrow-shared actuals) caller callee
				(borrow-mut output) offset name_prefix writing)))))
