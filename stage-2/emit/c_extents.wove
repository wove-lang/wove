(module emit_c_extents
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check native byte and array extents using already evaluated call operands.

	Extent checks read the borrowed descriptors. The native call itself
	uses their original backing pointers.`)

	(use wove-file "../c/arguments.wove" (only is_c_array_mode is_c_extent_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only is_native_integer is_writable_slice slice_element_type (type ScalarRecord)))
	(use wove-file "./runtime.wove" (only open_native_suffix open_shared_projection close_runtime_call write_c_number))
	(use wove-file "./text.wove" (only c_byte c_literal_text write_temporary_name))
	(use wove-file "./records.wove" (only write_value_type write_array_layout_argument))

	(struct CActual (fields (node i32) (type u32)))

	(let byte_check "wvrt_check_c_bytes")
	(let literal_array_check "wvrt_check_c_array(")
	(let named_array_check "wvrt_check_c_array_native(")
	(let const_pointer "const ")

	(fn open_c_byte_check
		(:doc `Open the runtime's checked byte extent call.`)
		(params (output (mut-array u8)) (offset u32) (native bool) (writing bool))
		(returns u32)
		(body
			(let cursor (call c_literal_text (borrow-shared (local byte_check)) (borrow-mut (local output)) (local offset) (local writing)))
			(if
				(:doc "A native factor needs a check in its original C width.")
				(local native)
				(then (return (call open_native_suffix (borrow-mut (local output)) (local cursor) (local writing)))))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 40u8 (local writing)))))

	(fn write_c_array_pointer_type
		(:doc `Write the exact C pointee type and qualify the element of a shared view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(view u32) (output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "A shared view passes a const-qualified element pointer.")
				(bool.not (call is_writable_slice (local view)))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local const_pointer))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(let type (call write_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (call slice_element_type (borrow-shared (local records)) (local view))
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local type) 42u8 (local writing)))))

	(fn write_extent_view
		(:doc `Pass the captured descriptor as a shared view for bounds checking.`)
		(params (source (shared-array u8)) (argument i32) (tree_base i32) (mutable bool)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let-mut cursor (local offset))
			(if
				(:doc "Use the common read-only check for mutable storage.")
				(local mutable)
				(then (set (local cursor) (call open_shared_projection (borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local argument) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(if
				(:doc "Finish the descriptor conversion before writing bounds.")
				(local mutable)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(return (local cursor))))

	(fn map_c_actuals
		(:doc `Index the captured expression rows by their positions in the signature.`)
		(params (nodes (shared-array SourceNode)) (first i32) (parameters (shared-array ScalarParameter))
			(parameter_start i32) (output (mut-array CActual)))
		(returns void)
		(body
			(let-mut argument (local first))
			(let-mut index 0i32)
			(while
				(:doc "Arity checking established one actual for each formal.")
				(i32.lt (local index) (array.len (local output)))
				(body
					(let formal (array.load (local parameters) (i32.add (local parameter_start) (local index))))
					(array.store (local output) (local index) (struct.new CActual (node (local argument))
						(type (struct.get (local formal) type))))
					(set (local argument) (struct.get (array.load (local nodes) (local argument)) next_sibling))
					(set (local index) (i32.add (local index) 1i32))))))

	(fn write_c_byte_check
		(:doc `Write one byte limit check for the data argument and its captured dimensions.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (actuals (shared-array CActual))
			(argument i32) (parameter ScalarParameter) (caller ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get (local caller) tree_base))
			(let mutable (u32.eq (struct.get (local parameter) type) 38u32))
			(let size (struct.get (local parameter) c_size))
			(let count (array.load (local actuals) (struct.get (local parameter) c_count)))
			(let native (bool.or (call is_native_integer (struct.get (local count) type))
				(bool.and (i32.lt -1i32 (local size))
					(call is_native_integer (struct.get (array.load (local actuals) (local size)) type)))))
			(let open (call open_c_byte_check (borrow-mut (local output)) (local offset) (local native) (local writing)))
			(let-mut cursor (call write_extent_view (borrow-shared (local source)) (local argument) (local tree_base) (local mutable)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(if
				(:doc "The count-only form uses an implicit byte size of one.")
				(i32.lt (local size) 0i32)
				(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 49u8 (local writing))))
				(else
					(set (local cursor) (call write_temporary_name (borrow-shared (local source))
						(struct.get (array.load (local actuals) (local size)) node) (local tree_base)
						(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(set (local cursor) (call write_temporary_name (borrow-shared (local source))
				(struct.get (local count) node) (local tree_base)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(let node (array.load (local nodes) (local argument)))
			(let source_base (struct.get (local caller) source_base))
			(set (local cursor) (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(struct.get (local caller) file) (i32.sub (struct.get (local node) start) (local source_base))
				(i32.sub (struct.get (local node) end) (local source_base)) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))))

	(fn write_c_array_check
		(:doc `Check the literal or named element count against the captured native array view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(actuals (shared-array CActual)) (argument i32) (parameter ScalarParameter) (caller ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let tree_base (struct.get (local caller) tree_base))
			(let type (struct.get (local parameter) type))
			(let count (struct.get (local parameter) c_count))
			(let-mut cursor (local offset))
			(if
				(:doc "Named counts retain their original integer width and signedness.")
				(i32.lt -1i32 (local count))
				(then (set (local cursor) (call c_literal_text (borrow-shared (local named_array_check))
					(borrow-mut (local output)) (local cursor) (local writing))))
				(else (set (local cursor) (call c_literal_text (borrow-shared (local literal_array_check))
					(borrow-mut (local output)) (local cursor) (local writing)))))
			(set (local cursor) (call write_extent_view (borrow-shared (local source)) (local argument) (local tree_base)
				(call is_writable_slice (local type)) (borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call write_array_layout_argument (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (call slice_element_type (borrow-shared (local records)) (local type)) (bool false)
				(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
			(set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))
			(if
				(:doc "Render a checked literal directly or read the captured integer formal.")
				(i32.lt (local count) 0i32)
				(then
					(let-mut digits (array.alloc u8 11i32))
					(set (local cursor) (call write_c_number (borrow-mut (local output)) (local cursor)
						(struct.get (local parameter) c_size) (borrow-mut (local digits)) (local writing))))
				(else (set (local cursor) (call write_temporary_name (borrow-shared (local source))
					(struct.get (array.load (local actuals) (local count)) node) (local tree_base)
					(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))
			(let node (array.load (local nodes) (local argument)))
			(let source_base (struct.get (local caller) source_base))
			(set (local cursor) (call close_runtime_call (borrow-mut (local output)) (local cursor)
				(struct.get (local caller) file) (i32.sub (struct.get (local node) start) (local source_base))
				(i32.sub (struct.get (local node) end) (local source_base)) (local writing)))
			(return (call c_byte (borrow-mut (local output)) (local cursor) 59u8 (local writing)))))

	(fn write_mapped_c_extent_checks
		(:doc `Emit the checks in formal order using the already evaluated arguments.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (actuals (shared-array CActual)) (caller ScalarFunction) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let arity (array.len (local actuals)))
			(let-mut index 0i32)
			(let-mut cursor (local offset))
			(while
				(:doc "Check each bounded view before entering the native call.")
				(i32.lt (local index) (local arity))
				(body
					(let parameter (array.load (local parameters) (i32.add (struct.get (local callee) params) (local index))))
					(let mode (struct.get (local parameter) c_mode))
					(if
						(:doc "String conversions and ordinary scalars have separate lowering.")
						(call is_c_extent_mode (local mode))
						(then
							(let argument (struct.get (array.load (local actuals) (local index)) node))
							(if
								(:doc "Array extents count elements. Byte extents check their product in bytes.")
								(call is_c_array_mode (local mode))
								(then (set (local cursor) (call write_c_array_check (borrow-shared (local source)) (borrow-shared (local nodes))
									(borrow-shared (local records)) (borrow-shared (local actuals)) (local argument) (local parameter) (local caller)
									(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing))))
								(else (set (local cursor) (call write_c_byte_check (borrow-shared (local source)) (borrow-shared (local nodes))
									(borrow-shared (local actuals)) (local argument) (local parameter) (local caller)
									(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (local cursor))))

	(fn write_c_extent_checks
		(:doc `Check every bounded C view before converting strings or invoking C.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (expression ScalarExpression) (caller ScalarFunction) (callee ScalarFunction)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let arity (struct.get (local callee) arity))
			(let-mut actuals (array.alloc CActual (local arity)))
			(call map_c_actuals (borrow-shared (local nodes)) (struct.get (local expression) first)
				(borrow-shared (local parameters)) (struct.get (local callee) params) (borrow-mut (local actuals)))
			(return (call write_mapped_c_extent_checks (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local parameters)) (borrow-shared (local records)) (borrow-shared (local actuals)) (local caller) (local callee)
				(borrow-mut (local output)) (local offset) (local name_prefix) (local writing))))))
