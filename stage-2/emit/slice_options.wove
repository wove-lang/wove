(module emit_slice_options
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit fallible shared windows and their presence operations using the slice descriptor ABI.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind) (value optional_view_absent) (value buffered_record_absent)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./text.wove" (only c_literal_text c_byte write_temporary_name write_local_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))

	(let try_exact_call "wvrt_slice_try_exact(")
	(let require_view_call "wvrt_slice_require_present_at_span(")
	(let absent_test ".wvrt_length<0")
	(let buffered_absent_test ".wvrt_record==NULL")

	(fn write_slice_option
		(:doc "Capture the view and offset before narrowing or check a named option at the unwrap site.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind row/kind)
			(if
				(:doc "The absence predicate inspects the reserved length without touching the backing pointer.")
				(bool:or (u32:eq kind optional_view_absent) (u32:eq kind buffered_record_absent))
				(then
					(let name (call write_local_name (borrow-shared source) (borrow-shared nodes)
						row/target tree_base
						(borrow-mut output) offset name_prefix writing))
					(if
						(:doc "A caller-backed option is absent when C leaves the out pointer null.")
						(u32:eq kind buffered_record_absent)
						(then (return (call c_literal_text (borrow-shared buffered_absent_test)
							(borrow-mut output) name writing))))
					(return (call c_literal_text (borrow-shared absent_test) (borrow-mut output) name writing))))
			(if
				(:doc "Use the three temporaries already evaluated in source order.")
				(u32:eq kind try_slice_kind)
				(then
					(let-mut cursor (call c_literal_text (borrow-shared try_exact_call)
						(borrow-mut output) offset writing))
					(let first row/first)
					(let-mut value first)
					(while
						(:doc "A comma separates the receiver, offset, and normalized extent.")
						(i32:not-ltz value)
						(body
							(if
								(:doc "The initial view has no leading separator.")
								(i32:not-eq first value)
								(then (set cursor (call c_byte (borrow-mut output) cursor 44u8 writing))))
							(set cursor (call write_temporary_name (borrow-shared nodes) value
								(borrow-mut output) cursor name_prefix writing))
							(set value (struct:get (nodes.get value) next_sibling))))
					(return (call c_byte (borrow-mut output) cursor 41u8 writing))))
			(let open (call c_literal_text (borrow-shared require_view_call)
				(borrow-mut output) offset writing))
			(let name (call write_local_name (borrow-shared source) (borrow-shared nodes)
				row/target tree_base
				(borrow-mut output) open name_prefix writing))
			(return (call close_runtime_call (borrow-mut output) name
				row/asset_start row/start row/end writing))))
)
