(module emit_slice_options
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit fallible shared windows and their presence operations using the slice descriptor ABI.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind) (value optional_view_absent)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "./text.wove" (only c_literal_text c_byte write_temporary_name write_local_name))
	(use wove-file "./runtime.wove" (only close_runtime_call))

	(let try_exact_call "wvrt_slice_try_exact(")
	(let require_view_call "wvrt_slice_require_present_at_span(")
	(let absent_test ".wvrt_length<0")

	(fn write_slice_option
		(:doc "Capture the view and offset before narrowing or check a named option at the unwrap site.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarExpression) (tree_base i32)
			(output (mut-array u8)) (offset u32) (name_prefix i32) (writing bool))
		(returns u32)
		(body
			(let kind (struct.get (local row) kind))
			(if
				(:doc "The absence predicate inspects the reserved length without touching the backing pointer.")
				(u32.eq (local kind) (local optional_view_absent))
				(then
					(let name (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local row) target) (local tree_base)
						(borrow-mut (local output)) (local offset) (local name_prefix) (local writing)))
					(return (call c_literal_text (borrow-shared (local absent_test)) (borrow-mut (local output)) (local name) (local writing)))))
			(if
				(:doc "Use the three temporaries already evaluated in source order.")
				(u32.eq (local kind) (local try_slice_kind))
				(then
					(let-mut cursor (call c_literal_text (borrow-shared (local try_exact_call))
						(borrow-mut (local output)) (local offset) (local writing)))
					(let first (struct.get (local row) first))
					(let-mut value (local first))
					(while
						(:doc "A comma separates the receiver, offset, and normalized extent.")
						(i32.not-ltz (local value))
						(body
							(if
								(:doc "The initial view has no leading separator.")
								(i32.not-eq (local first) (local value))
								(then (set (local cursor) (call c_byte (borrow-mut (local output)) (local cursor) 44u8 (local writing)))))
							(set (local cursor) (call write_temporary_name (borrow-shared (local source)) (local value) (local tree_base)
								(borrow-mut (local output)) (local cursor) (local name_prefix) (local writing)))
							(set (local value) (struct.get (array.load (local nodes) (local value)) next_sibling))))
					(return (call c_byte (borrow-mut (local output)) (local cursor) 41u8 (local writing)))))
			(let open (call c_literal_text (borrow-shared (local require_view_call))
				(borrow-mut (local output)) (local offset) (local writing)))
			(let name (call write_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local row) target) (local tree_base)
				(borrow-mut (local output)) (local open) (local name_prefix) (local writing)))
			(return (call close_runtime_call (borrow-mut (local output)) (local name)
				(struct.get (local row) asset_start) (struct.get (local row) start) (struct.get (local row) end) (local writing)))))
)
