(module wovec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Dispatch the compiler from the shared host argument entry.")

	(use wove-file "./cli/argv.wove" (only (type ArgSpan)))
	(use (:pragma (cfg bootstrap)) wove-file "./driver/bootstrap/entry.wove" (only (as run_bootstrap_command run_compiler)))
	(use (:pragma (cfg (not bootstrap))) wove-file "./driver/command.wove" (only (as run_native_command run_compiler)))

	(fn main
		(:doc "Give the selected compiler driver the original host argument byte and span views.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:160" "gh:wove-lang/wove:200" "gh:wove-lang/wove:338"))
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body (return (call run_compiler (borrow-shared (local bytes)) (borrow-shared (local argv)))))))
