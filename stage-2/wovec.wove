(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Provide the compiler root for the seed-built Stage 2 executable.

	The parameterless bootstrap entry calls the shared lexer on an empty view and
	checks for EOF. The scanner fixtures use the same generated translation unit.`)
	wovec

	(use wove-file "./source_scan.wove" (only admit_source scan_token))
	(use
		(:doc "Include the decoder in the seed-built source fixture.")
		wove-file "./source_strings.wove" (only))
	(use
		(:doc "Include the module reader in the seed-built source fixture.")
		wove-file "./source_module.wove" (only))
	(use
		(:doc "Include local scalar C emission in the seed-built source fixture.")
		wove-file "./emit_c.wove" (only))

	(use
		(:doc "Include supplied graph resolution in the seed-built source fixture.")
		wove-file "./source_graph.wove" (only))

	(fn
		(:doc `Exercise the imported lexer without host I/O in the bootstrap entry.`)
		(:pragma (cfg bootstrap))
		(:expect bootstrap.compiler_root
			(issue "https://github.com/wove-lang/wove/issues/49"))
		main
		(params)
		(returns i32)
		(body
			(let source (array.alloc u8 (i32 0)))
			(let invalid (call admit_source (borrow-shared (local source))))
			(if
				(:doc "An empty source has no invalid UTF-8 sequence.")
				(bool.not (i32.eq (local invalid) (i32 -1)))
				(then (return (i32 1))))
			(let token (call scan_token (borrow-shared (local source)) (i32 0)))
			(if
				(:doc "The first scan of the admitted empty source must return EOF without an error.")
				(bool.and
					(u32.eq (record.get (local token) kind) (u32 0))
					(u32.eq (record.get (local token) error) (u32 0)))
				(then (return (i32 0))))
			(return (i32 1)))))
