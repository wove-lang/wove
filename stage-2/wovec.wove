(module wovec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Provide bootstrap and native entry points for the Stage 2 compiler.

	The parameterless bootstrap entry calls the shared lexer on an empty view and
	checks for EOF. The native entry dispatches version and cc using host argv.`)

	(use (:pragma (cfg bootstrap)) wove-file "./source/scan.wove" (only admit_source scan_token))

	(use (:pragma (cfg (not bootstrap))) wove-file "./cli/argv.wove" (only (type ArgSpan)))
	(use (:pragma (cfg (not bootstrap))) wove-file "./driver/command.wove" (only run_native_cc))
	(use (:pragma (cfg (not bootstrap))) wove-file "./driver/version.wove" (only is_version_argument print_version))

	(fn main
		(:doc `Exercise the imported lexer without host I/O in the bootstrap entry.`)
		(:pragma (cfg bootstrap))
		(:expect (issues "gh:wove-lang/wove:49"))
		(params)
		(returns i32)
		(body
			(let source (array.alloc u8 (i32 0)))
			(let invalid (call admit_source (borrow-shared (local source))))
			(if
				(:doc "An empty source has no invalid UTF-8 sequence.")
				(bool.not (i32.eq (local invalid) (i32 -1)))
				(then (return (i32 1))))
			(let token (call scan_token (borrow-shared (local source)) (i32 0)))
			(if
				(:doc "The first scan of the admitted empty source must return EOF without an error.")
				(bool.and
					(u32.eq (record.get (local token) kind) (u32 0))
					(u32.eq (record.get (local token) error) (u32 0)))
				(then (return (i32 0))))
			(return (i32 1))))

	(fn main
		(:doc `Handle version directly and send compilation arguments to the native cc driver.`)
		(:pragma (cfg (not bootstrap)))
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:160"))
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(if
				(:doc "With exactly one user argument the host byte arena is its entire spelling.")
				(bool.and (i32.eq (slice.len (local argv)) (i32 1))
					(call is_version_argument (borrow-shared (local bytes))))
				(then (return (call print_version))))
			(return (call run_native_cc (borrow-shared (local bytes)) (borrow-shared (local argv)))))))
