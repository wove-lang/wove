(module wovec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Provide bootstrap and native entry points for the Stage 2 compiler.

	The seed-built compiler emits C from the real compiler-entry graph.
	The native entry dispatches version, cc, and bin using host argv.`)

	(use (:pragma (cfg bootstrap)) wove-file "./source/scan.wove" (only admit_source scan_token))

	(use wove-file "./cli/argv.wove" (only (type ArgSpan)))
	(use (:pragma (cfg bootstrap)) wove-file "./driver/bootstrap/entry.wove" (only compile_entry))
	(use (:pragma (cfg (not bootstrap))) wove-file "./driver/command.wove" (only run_native_build))
	(use (:pragma (cfg (not bootstrap))) wove-file "./driver/version.wove" (only is_version_argument print_version))

	(fn main
		(:doc `Emit one compiler entry to stdout. A no-argument invocation keeps the existing seed smoke check.`)
		(:pragma (cfg bootstrap))
		(:expect (issues "gh:wove-lang/wove:200"))
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(if (i32.eq (slice.len (local argv)) 0i32) (then (return (call bootstrap_smoke))))
			(if (bool.not (i32.eq (slice.len (local argv)) 1i32)) (then (return 1i32)))
			(let entry (slice.load (local argv) 0i32))
			(return (call compile_entry
				(borrow-shared (slice.range (local bytes) (record.get (local entry) start) (record.get (local entry) end)))))))

	(fn bootstrap_smoke
		(:doc `Exercise the imported lexer without reading a source file.`)
		(:pragma (cfg bootstrap))
		(:expect (issues "gh:wove-lang/wove:49"))
		(params)
		(returns i32)
		(body
			(let source (array.alloc u8 0i32))
			(let invalid (call admit_source (borrow-shared (local source))))
			(if
				(:doc "An empty source has no invalid UTF-8 sequence.")
				(bool.not (i32.eq (local invalid) -1i32))
				(then (return 1i32)))
			(let token (call scan_token (borrow-shared (local source)) 0i32))
			(if
				(:doc "The first scan of the admitted empty source must return EOF without an error.")
				(bool.and
					(u32.eq (record.get (local token) kind) 0u32)
					(u32.eq (record.get (local token) error) 0u32))
				(then (return 0i32)))
			(return 1i32)))

	(fn main
		(:doc `Handle version directly and send compilation arguments to the native build driver.`)
		(:pragma (cfg (not bootstrap)))
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:160"))
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(if
				(:doc "With exactly one user argument the host byte arena is its entire spelling.")
				(bool.and (i32.eq (slice.len (local argv)) 1i32)
					(call is_version_argument (borrow-shared (local bytes))))
				(then (return (call print_version))))
			(return (call run_native_build (borrow-shared (local bytes)) (borrow-shared (local argv)))))))
