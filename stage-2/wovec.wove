(module wovec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Dispatch the compiler from the host argument entry.")

	(use wove-file "./driver/command.wove" (only (as run_native_command run_compiler)))

	(fn main
		(:doc "Give the compiler driver the original host argument vector.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:160" "gh:wove-lang/wove:200" "gh:wove-lang/wove:338"))
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body (return (call run_compiler (borrow-shared argv))))))
