(module wovec
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Provide bootstrap and native entry points for the Stage 2 compiler.

	The parameterless bootstrap entry calls the shared lexer on an empty view and
	checks for EOF. The native entry runs the resolved command using host argv.`)

	(use (:pragma (cfg bootstrap)) wove-file "./source/scan.wove" (only admit_source scan_token))
	(use
		(:doc "Include the decoder in the seed-built source fixture.")
		(:pragma (cfg bootstrap))
		wove-file "./source/strings.wove" (only))
	(use
		(:doc "Include the module reader in the seed-built source fixture.")
		(:pragma (cfg bootstrap))
		wove-file "./source/module.wove" (only))
	(use
		(:doc "Include local scalar C emission in the seed-built source fixture.")
		(:pragma (cfg bootstrap))
		wove-file "./emit/c.wove" (only))

	(use
		(:doc "Include supplied graph resolution in the seed-built source fixture.")
		(:pragma (cfg bootstrap))
		wove-file "./source/graph.wove" (only))

	(use
		(:doc "Include source-level caller inspection in the seed-built source fixture.")
		(:pragma (cfg bootstrap))
		wove-file "./source/callers.wove" (only))

	(use
		(:doc "Include scalar source graph emission in the seed-built fixture.")
		(:pragma (cfg bootstrap))
		wove-file "./emit/graph.wove" (only))

	(use (:pragma (cfg (not bootstrap))) wove-file "./cli/argv.wove" (only (type ArgSpan)))
	(use (:pragma (cfg (not bootstrap))) wove-file "./driver/command.wove" (only run_native_cc))

	(fn main
		(:doc `Exercise the imported lexer without host I/O in the bootstrap entry.`)
		(:pragma (cfg bootstrap))
		(:expect
			(tests "stage-2/source_scan.probe.c")
			(issues "gh:wove-lang/wove:49"))
		(params)
		(returns i32)
		(body
			(let source (array.alloc u8 (i32 0)))
			(let invalid (call admit_source (borrow-shared (local source))))
			(if
				(:doc "An empty source has no invalid UTF-8 sequence.")
				(bool.not (i32.eq (local invalid) (i32 -1)))
				(then (return (i32 1))))
			(let token (call scan_token (borrow-shared (local source)) (i32 0)))
			(if
				(:doc "The first scan of the admitted empty source must return EOF without an error.")
				(bool.and
					(u32.eq (record.get (local token) kind) (u32 0))
					(u32.eq (record.get (local token) error) (u32 0)))
				(then (return (i32 0))))
			(return (i32 1))))

	(fn main
		(:doc `Run the native cc driver with borrowed host argument bytes and spans.`)
		(:pragma (cfg (not bootstrap)))
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:160"))
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body (return (call run_native_cc (borrow-shared (local bytes)) (borrow-shared (local argv)))))))
