(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode exact decimal and boolean values from checked argv byte spans.")
	cli_values

	(struct ArgDecimal (fields (valid bool) (negative bool) (magnitude u32)))

	(fn
		(:doc "Report a decimal spelling or range failure without converting its partial value.")
		invalid_decimal
		(params)
		(returns ArgDecimal)
		(body (return (record.make ArgDecimal (valid (bool false)) (negative (bool false)) (magnitude (u32 0))))))

	(fn
		(:doc "Read decimal digits against the exact i32 or u32 range before accumulating them.")
		argv_decimal
		(params (bytes (shared-slice u8)) (start i32) (end i32) (signed bool))
		(returns ArgDecimal)
		(body
			(if
				(:doc "An empty span has no digit or sign.")
				(i32.eq (local start) (local end))
				(then (return (call invalid_decimal))))
			(let first (slice.load (local bytes) (local start)))
			(let negative (u8.eq (local first) (u8 45)))
			(if
				(:doc "Unsigned decimal values accept a positive sign.")
				(bool.and (local negative) (bool.not (local signed)))
				(then (return (call invalid_decimal))))
			(let-mut cursor (local start))
			(if
				(:doc "Skip a leading sign and require at least one subsequent digit.")
				(bool.or (local negative) (u8.eq (local first) (u8 43)))
				(then
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
					(if
						(:doc "A sign alone cannot supply a value.")
						(i32.eq (local cursor) (local end))
						(then (return (call invalid_decimal))))))
			(let-mut limit (u32 429496729))
			(let-mut last (u32 5))
			(if
				(:doc "The signed magnitude limit ends in 7 for positive and 8 for negative.")
				(local signed)
				(then
					(set (local limit) (u32 214748364))
					(set (local last) (u32 7))
					(if (local negative) (then (set (local last) (u32 8))))))
			(let-mut value (u32 0))
			(while
				(:doc "Check the complete base-ten step before the multiply or addition can wrap.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local bytes) (local cursor)))
					(if
						(:doc "Accept ASCII digits throughout the value.")
						(bool.or (u8.lt (local byte) (u8 48)) (bool.not (u8.lt (local byte) (u8 58))))
						(then (return (call invalid_decimal))))
					(let digit (u32.sub.wrapping (int.convert u32 (local byte)) (u32 48)))
					(if
						(:doc "The final digit matters only when the accumulated value reaches limit divided by ten.")
						(bool.or (u32.lt (local limit) (local value))
							(bool.and (u32.eq (local value) (local limit)) (u32.lt (local last) (local digit))))
						(then (return (call invalid_decimal))))
					(let twice (u32.add.wrapping (local value) (local value)))
					(let four (u32.add.wrapping (local twice) (local twice)))
					(let eight (u32.add.wrapping (local four) (local four)))
					(set (local value) (u32.add.wrapping (u32.add.wrapping (local eight) (local twice)) (local digit)))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (record.make ArgDecimal (valid (bool true)) (negative (local negative)) (magnitude (local value))))))

	(fn
		(:doc "Convert a checked signed magnitude, including the asymmetric minimum.")
		argv_signed
		(params (decimal ArgDecimal))
		(returns i32)
		(body
			(let magnitude (record.get (local decimal) magnitude))
			(if
				(:doc "The minimum signed magnitude fits only in its unsigned spelling.")
				(u32.eq (local magnitude) (u32 2147483648))
				(then (return (i32 -2147483648))))
			(let value (int.convert i32 (local magnitude)))
			(if
				(:doc "Negate the converted magnitude when the spelling carries a minus.")
				(record.get (local decimal) negative)
				(then (return (i32.sub.wrapping (i32 0) (local value)))))
			(return (local value))))

	(fn
		(:doc "Return 1 for true, 0 for false, and -1 for every other spelling.")
		argv_boolean
		(params (bytes (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "Only four bytes can spell true.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 116))
						(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 114))
							(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 117))
								(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 101))))))
				(then (return (i32 1))))
			(if
				(:doc "Only five bytes can spell false.")
				(bool.and (i32.eq (local width) (i32 5))
					(bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 102))
						(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 97))
							(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 108))
								(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 115))
									(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 101)))))))
				(then (return (i32 0))))
			(return (i32 -1)))))
