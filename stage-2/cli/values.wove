(module cli_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode exact decimal and boolean values from checked argv byte spans.")

	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct ArgDecimal (fields (valid bool) (negative bool) (magnitude u32)))

	(fn invalid_decimal
		(:doc "Report a decimal spelling or range failure without converting its partial value.")
		(params)
		(returns ArgDecimal)
		(body (return (record.make ArgDecimal (valid (bool false)) (negative (bool false)) (magnitude 0u32)))))

	(fn argv_decimal
		(:doc "Read decimal digits against the exact i32 or u32 range before accumulating them.")
		(params (bytes (shared-slice u8)) (start i32) (end i32) (signed bool))
		(returns ArgDecimal)
		(body
			(if
				(:doc "An empty span has no digit or sign.")
				(i32.eq (local start) (local end))
				(then (return (call invalid_decimal))))
			(let first (slice.load (local bytes) (local start)))
			(let negative (u8.eq (local first) 45u8))
			(if
				(:doc "Unsigned decimal values accept a positive sign.")
				(bool.and (local negative) (bool.not (local signed)))
				(then (return (call invalid_decimal))))
			(let-mut cursor (local start))
			(if
				(:doc "Strip the sign before the shared digit reader checks the remaining span.")
				(bool.or (local negative) (u8.eq (local first) 43u8))
				(then (set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(let-mut limit 429496729u32)
			(let-mut last 5u32)
			(if
				(:doc "The signed magnitude limit ends in 7 for positive and 8 for negative.")
				(local signed)
				(then
					(set (local limit) 214748364u32)
					(set (local last) 7u32)
					(if (local negative) (then (set (local last) 8u32)))))
			(let decoded (call read_decimal_digits (borrow-shared (local bytes)) (local cursor) (local end)
				(local limit) (local last)))
			(if
				(:doc "An invalid magnitude cannot form a typed argument.")
				(i32.lt (record.get (local decoded) digits) 0i32)
				(then (return (call invalid_decimal))))
			(return (record.make ArgDecimal (valid (bool true))
				(negative (local negative)) (magnitude (record.get (local decoded) magnitude))))))


	(fn argv_signed
		(:doc "Convert a checked signed magnitude, including the asymmetric minimum.")
		(params (decimal ArgDecimal))
		(returns i32)
		(body
			(let magnitude (record.get (local decimal) magnitude))
			(if
				(:doc "The minimum signed magnitude fits only in its unsigned spelling.")
				(u32.eq (local magnitude) 2147483648u32)
				(then (return -2147483648i32)))
			(let value (int.convert i32 (local magnitude)))
			(if
				(:doc "Negate the converted magnitude when the spelling carries a minus.")
				(record.get (local decimal) negative)
				(then (return (i32.sub.wrapping 0i32 (local value)))))
			(return (local value))))

	(fn argv_boolean
		(:doc "Return 1 for true, 0 for false, and -1 for every other spelling.")
		(params (bytes (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "Only four bytes can spell true.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (u8.eq (slice.load (local bytes) (local start)) 116u8)
						(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 1i32)) 114u8)
							(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 2i32)) 117u8)
								(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 3i32)) 101u8)))))
				(then (return 1i32)))
			(if
				(:doc "Only five bytes can spell false.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and (u8.eq (slice.load (local bytes) (local start)) 102u8)
						(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 1i32)) 97u8)
							(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 2i32)) 108u8)
								(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 3i32)) 115u8)
									(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 4i32)) 101u8))))))
				(then (return 0i32)))
			(return -1i32))))
