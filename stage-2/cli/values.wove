(module cli_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode exact decimal and boolean values from checked argv byte spans.")

	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct ArgDecimal (fields (valid bool) (negative bool) (magnitude u32)))

	(fn invalid_decimal
		(:doc "Report a decimal spelling or range failure without converting its partial value.")
		(params)
		(returns ArgDecimal)
		(body (return (struct:new ArgDecimal (valid (bool false)) (negative (bool false)) (magnitude 0u32)))))

	(fn argv_decimal
		(:doc "Read decimal digits against the exact i32 or u32 range before accumulating them.")
		(params (bytes (shared-array u8)) (start i32) (end i32) (signed bool))
		(returns ArgDecimal)
		(body
			(if
				(:doc "An empty span has no digit or sign.")
				(start.eq end)
				(then (return (call invalid_decimal))))
			(let first (bytes.get start))
			(let negative (first.eq 45u8))
			(if
				(:doc "Unsigned decimal values accept a positive sign.")
				(negative.and signed.not)
				(then (return (call invalid_decimal))))
			(let-mut cursor start)
			(if
				(:doc "Strip the sign before the shared digit reader checks the remaining span.")
				(negative.or (first.eq 43u8))
				(then (set cursor cursor.inc)))
			(let-mut limit 429496729u32)
			(let-mut last 5u32)
			(if
				(:doc "The signed magnitude limit ends in 7 for positive and 8 for negative.")
				signed
				(then
					(set limit 214748364u32)
					(set last 7u32)
					(if negative (then (set last 8u32)))))
			(let decoded (call read_decimal_digits (borrow-shared bytes) cursor end
				limit last))
			(if
				(:doc "An invalid magnitude cannot form a typed argument.")
				(i32:ltz decoded/digits)
				(then (return (call invalid_decimal))))
			(return (struct:new ArgDecimal (valid (bool true))
				(negative negative) (magnitude decoded/magnitude)))))


	(fn argv_signed
		(:doc "Convert a checked signed magnitude, including the asymmetric minimum.")
		(params (decimal ArgDecimal))
		(returns i32)
		(body
			(let magnitude decimal/magnitude)
			(if
				(:doc "The minimum signed magnitude fits only in its unsigned spelling.")
				(magnitude.eq 2147483648u32)
				(then (return -2147483648i32)))
			(let value (i32:from-u32 magnitude))
			(if
				(:doc "Negate the converted magnitude when the spelling carries a minus.")
				decimal/negative
				(then (return (i32:sub 0i32 value))))
			(return value)))

	(fn argv_boolean
		(:doc "Return 1 for true, 0 for false, and -1 for every other spelling.")
		(params (bytes (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let width (end.sub start))
			(if
				(:doc "Only four bytes can spell true.")
				(bool:and (width.eq 4i32)
					(bool:and (u8:eq (bytes.get start) 116u8)
						(bool:and (u8:eq (bytes.get start.inc) 114u8)
							(bool:and (u8:eq (bytes.get (start.add 2i32)) 117u8)
								(u8:eq (bytes.get (start.add 3i32)) 101u8)))))
				(then (return 1i32)))
			(if
				(:doc "Only five bytes can spell false.")
				(bool:and (width.eq 5i32)
					(bool:and (u8:eq (bytes.get start) 102u8)
						(bool:and (u8:eq (bytes.get start.inc) 97u8)
							(bool:and (u8:eq (bytes.get (start.add 2i32)) 108u8)
								(bool:and (u8:eq (bytes.get (start.add 3i32)) 115u8)
									(u8:eq (bytes.get (start.add 4i32)) 101u8))))))
				(then (return 0i32)))
			(return -1i32))))
