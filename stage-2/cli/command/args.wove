(module command_args
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Parse cc, bin and fmt arguments in original argv order.

	CommandArgument rows retain typed scalar values and text spans. The
	rule is the project schema row, or -1 for a positional, -2 for the
	profile selector, -3 and -4 for mode switches, or -5 for cc --check.
	Form 4 clears the corresponding list.

	Errors 1, 2, 3, 5, 7 and 8 match the typed argv diagnostics for
	unknown option, missing value, invalid value, duplicate option,
	invalid span and insufficient rows. Code 9 is a missing or unknown
	command and 10 is a conflicting build mode. Discard rows on error.
	An accepted human switch can still select the error renderer.`)

	(use wove-file "../argv.wove"
		(only (type ArgSpan) check_argv option_name_end has_no_prefix has_option_prefix))
	(use wove-file "./schema.wove" (only command_name find_command_option))
	(use wove-file "./values.wove" (only decode_command_operand))
	(use wove-file "../../config/schema.wove" (only (type ProjectRule) project_compiler_rule))

	(struct CommandArgument (fields (rule i32) (form u32) (argv_index i32) (start i32) (end i32) (scalar u32)))
	(struct CommandArgs (fields (error u32) (argv_index i32) (rule i32)
		(command u32) (mode u32) (rows i32) (operands i32) (profile i32) (argv_human bool)))
	(struct SelectedOption (fields (rule i32) (kind u32) (form u32) (scalar u32) (end i32)))
	(struct SelectedValue (fields (error u32) (rule i32) (form u32) (index i32) (start i32) (end i32) (scalar u32)))

	(fn command_args_error
		(:doc "Create a parse failure with the original argument and schema row.")
		(params (code u32) (index i32) (rule i32) (argv_human bool))
		(returns CommandArgs)
		(body (return (struct.new CommandArgs (error code) (argv_index index) (rule rule)
			(command 0u32) (mode 0u32) (rows 0i32) (operands 0i32) (profile -1i32) (argv_human argv_human)))))

	(fn is_short_output
		(:doc "Recognize the archive's exact short spelling for build output.")
		(params (bytes (shared-array u8)) (span ArgSpan))
		(returns bool)
		(body
			(let start (struct.get span start))
			(return (bool.and (i32.eq (i32.sub (struct.get span end) start) 2i32)
				(bool.and (u8.eq (array.load bytes start) 45u8)
					(u8.eq (array.load bytes (i32.inc start)) 111u8))))))

	(fn is_options_end
		(:doc "Recognize the standalone end-of-options marker in a checked argument span.")
		(params (bytes (shared-array u8)) (span ArgSpan))
		(returns bool)
		(body (return (bool.and
			(i32.eq (i32.sub (struct.get span end) (struct.get span start)) 2i32)
			(call has_option_prefix (borrow-shared bytes) span)))))

	(fn select_command_option
		(:doc "Find a long or short option and its implicit boolean, leaving attached text in the argument.")
		(params (command u32) (bytes (shared-array u8)) (span ArgSpan)
			(names (shared-array u8)) (rules (shared-array ProjectRule)))
		(returns SelectedOption)
		(body
			(let end (struct.get span end))
			(if
				(:doc "Both build commands recognize -o as their output option.")
				(call is_short_output (borrow-shared bytes) span)
				(then
					(let output (array.load rules 19i32))
					(return (struct.new SelectedOption (rule 19i32) (kind (struct.get output kind)) (form 2u32)
						(scalar 0u32) (end end)))))
			(if
				(:doc "Any other dash-prefixed spelling must be a long option.")
				(bool.not (call has_option_prefix (borrow-shared bytes) span))
				(then (return (struct.new SelectedOption (rule -1i32) (kind 0u32) (form 0u32)
					(scalar 0u32) (end end)))))
			(let start (i32.add (struct.get span start) 2i32))
			(let stop (call option_name_end (borrow-shared bytes) start end))
			(let direct (call find_command_option command (borrow-shared bytes) start stop
				(borrow-shared names) (borrow-shared rules)))
			(let form (struct.get direct form))
			(if
				(:doc "Match literal names like no-fail before interpreting the no- prefix.")
				(u32.gtz form)
				(then (return (struct.new SelectedOption (rule (struct.get direct rule)) (kind (struct.get direct kind))
					(form form) (scalar 1u32) (end stop)))))
			(if
				(:doc "Boolean config options and cc --check accept an explicit negative spelling.")
				(call has_no_prefix (borrow-shared bytes) start stop)
				(then
					(let inverse (call find_command_option command (borrow-shared bytes)
						(i32.add start 3i32) stop (borrow-shared names) (borrow-shared rules)))
					(if
						(:doc "Build mode selectors have only positive spellings.")
						(bool.and (u32.eq (struct.get inverse form) 1u32)
							(bool.or (i32.eq (struct.get inverse rule) -5i32)
								(i32.not-ltz (struct.get inverse rule))))
						(then (return (struct.new SelectedOption (rule (struct.get inverse rule)) (kind 1u32) (form 1u32)
							(scalar 0u32) (end stop)))))))
			(return (struct.new SelectedOption (rule -1i32) (kind 0u32) (form 0u32)
				(scalar 0u32) (end stop)))))

	(fn selected_value
		(:doc "Build an option event with coordinates at the token that supplied the value or error.")
		(params (error u32) (option SelectedOption) (index i32) (start i32) (end i32) (scalar u32))
		(returns SelectedValue)
		(body (return (struct.new SelectedValue (error error) (rule (struct.get option rule))
			(form (struct.get option form)) (index index) (start start) (end end) (scalar scalar)))))

	(fn select_command_value
		(:doc "Read an attached or separate value, including the archive's dash-prefixed native flags.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (option SelectedOption) (index i32) (span ArgSpan))
		(returns SelectedValue)
		(body
			(let form (struct.get option form))
			(let rule (struct.get option rule))
			(let stop (struct.get option end))
			(let-mut start (struct.get span start))
			(let-mut end (struct.get span end))
			(let attached (i32.lt stop end))
			(if
				(:doc "An unknown named option is an error at its own token.")
				(u32.eqz form)
				(then (return (call selected_value 1u32 option index start end 0u32))))
			(if
				(:doc "Switches and list resets take no operands.")
				(bool.or (u32.eq form 1u32) (u32.eq form 4u32))
				(then
					(if
						(:doc "Boolean switches use the positive or negative spelling without an equals value.")
						attached
						(then (return (call selected_value 3u32 option index start end 0u32))))
					(return (call selected_value 0u32 option index -1i32 -1i32
						(struct.get option scalar)))))
			(let-mut value_index index)
			(if
				(:doc "The equals spelling keeps the operand in the original option row.")
				attached
				(then (set start (i32.inc stop)))
				(else
					(let next (i32.inc index))
					(if
						(:doc "A final option cannot consume a separate operand.")
						(i32.eq next (array.len argv))
						(then (return (call selected_value 2u32 option index start end 0u32))))
					(let separate (array.load argv next))
					(let native_flag (bool.or (i32.eq rule 13i32) (i32.eq rule 15i32)))
					(if
						(:doc "Every option stops at the bare marker; native flags can otherwise consume dash-prefixed operands.")
						(bool.or (call is_options_end (borrow-shared bytes) separate)
							(bool.and (bool.not native_flag) (bool.or
								(call has_option_prefix (borrow-shared bytes) separate)
								(call is_short_output (borrow-shared bytes) separate))))
						(then (return (call selected_value 2u32 option index start end 0u32))))
					(set value_index next)
					(set start (struct.get separate start))
					(set end (struct.get separate end))))
			(let decoded (call decode_command_operand (borrow-shared bytes) start end
				rule (struct.get option kind)))
			(if
				(:doc "An invalid operand is diagnosed at the actual value argument.")
				(bool.not (struct.get decoded valid))
				(then (return (call selected_value 3u32 option value_index start end 0u32))))
			(return (call selected_value 0u32 option value_index start end
				(struct.get decoded value)))))

	(fn first_command_argument
		(:doc "Locate a previously accepted option or positional by its rule.")
		(params (arguments (shared-array CommandArgument)) (start i32) (rows i32) (rule i32))
		(returns i32)
		(body
			(let-mut row start)
			(while
				(:doc "Skip arguments belonging to other rules without changing argument order.")
				(i32.lt row rows)
				(body
					(if
						(:doc "Every explicit occurrence keeps its canonical rule ID.")
						(i32.eq (struct.get (array.load arguments row) rule) rule)
						(then (return row)))
					(set row (i32.inc row))))
			(return -1i32)))

	(fn parse_command_args
		(:doc "Read one command and its explicit options and source operands.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (names (shared-array u8))
			(rules (shared-array ProjectRule)) (arguments (mut-array CommandArgument)))
		(returns CommandArgs)
		(body
			(let size (array.len argv))
			(let bad (call check_argv (borrow-shared argv) (array.len bytes)))
			(if
				(:doc "No command or option lookup may read an unchecked span.")
				(i32.not-ltz bad)
				(then (return (call command_args_error 7u32 bad -1i32 (bool false)))))
			(if
				(:doc "A supplied invocation has one command at user argv index zero.")
				(i32.eqz size)
				(then (return (call command_args_error 9u32 0i32 -1i32 (bool false)))))
			(let first (array.load argv 0i32))
			(let command (call command_name (borrow-shared bytes) (struct.get first start) (struct.get first end)))
			(if
				(:doc "Unknown commands retain the original command argument index.")
				(u32.eqz command)
				(then (return (call command_args_error 9u32 0i32 -1i32 (bool false)))))
			(if
				(:doc "At most one event is written per argument after the command.")
				(i32.lt (array.len arguments) (i32.dec size))
				(then (return (call command_args_error 8u32 -1i32 -1i32 (bool false)))))
			(let-mut index 1i32)
			(let-mut rows 0i32)
			(let-mut operands 0i32)
			(let-mut profile -1i32)
			(let-mut mode 0u32)
			(let-mut named (bool true))
			(let-mut argv_human (bool false))
			(while
				(:doc "Each loop consumes one argument, or a named option and its separate operand.")
				(i32.lt index size)
				(body
					(let span (array.load argv index))
					(let start (struct.get span start))
					(let end (struct.get span end))
					(let width (i32.sub end start))
					(if
						(:doc "The end-of-options marker leaves all following arguments as source operands.")
						(bool.and named (call is_options_end (borrow-shared bytes) span))
						(then (set named (bool false)))
						(else
							(if
								(:doc "After the marker, or for ordinary source operands, preserve the entire span.")
								(bool.and named (bool.and (i32.lt 1i32 width)
									(u8.eq (array.load bytes start) 45u8)))
								(then
									(let option (call select_command_option command (borrow-shared bytes) span
										(borrow-shared names) (borrow-shared rules)))
									(let value (call select_command_value (borrow-shared bytes) (borrow-shared argv)
										option index span))
									(let code (struct.get value error))
									(let rule (struct.get value rule))
									(let form (struct.get value form))
									(let at (struct.get value index))
									(if
										(:doc "Selection failures already identify the offending option or value.")
										(u32.gtz code)
										(then (return (call command_args_error code at rule argv_human))))
									(if
										(:doc "Aliases and boolean polarities share the same single-use rule.")
										(bool.and (u32.lt form 3u32)
											(i32.not-ltz (call first_command_argument (borrow-shared arguments)
												0i32 rows rule)))
										(then (return (call command_args_error 5u32 index rule argv_human))))
									(if
										(:doc "Select the profile only after recording its exact value argument.")
										(i32.eq rule -2i32)
										(then (set profile rows)))
									(if
										(:doc "A build may select exactly one of debug and release.")
										(bool.or (i32.eq rule -3i32) (i32.eq rule -4i32))
										(then
											(if
												(:doc "Point a conflict at the later mode switch.")
												(u32.gtz mode)
												(then (return (call command_args_error 10u32 index rule argv_human))))
											(set mode (u32.from-i32 (i32.sub -2i32 rule)))))
									(if
										(:doc "Retain an accepted diagnostic switch for an error in a later argument or in the project.")
										(i32.eq rule (call project_compiler_rule 0i32))
										(then (set argv_human (u32.eq (struct.get value scalar) 1u32))))
									(array.store arguments rows (struct.new CommandArgument
										(rule rule) (form form) (argv_index at)
										(start (struct.get value start)) (end (struct.get value end))
										(scalar (struct.get value scalar))))
									(set index at))
								(else
									(array.store arguments rows (struct.new CommandArgument
										(rule -1i32) (form 0u32) (argv_index index)
										(start start) (end end) (scalar 0u32)))
									(set operands (i32.inc operands))))
							(set rows (i32.inc rows))))
					(set index (i32.inc index))))
			(return (struct.new CommandArgs (error 0u32) (argv_index -1i32) (rule -1i32)
				(command command) (mode mode) (rows rows) (operands operands) (profile profile) (argv_human argv_human))))))
