(module command_args
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Parse cc, bin and fmt arguments in original argv order.

	CommandArgument rows retain typed scalar values and text spans. The
	rule is the project schema row, or -1 for a positional, -2 for the
	profile selector, -3 and -4 for mode switches, -5 for cc --check, or
	-6 for bin --compiler. Form 4 clears the corresponding list.

	Errors 1, 2, 3, 5, 7 and 8 match the typed argv diagnostics for
	unknown option, missing value, invalid value, duplicate option,
	invalid span and insufficient rows. Code 9 is a missing or unknown
	command and 10 is a conflicting build mode. Discard rows on error.`)

	(use wove-file "../argv.wove"
		(only (type ArgSpan) check_argv option_name_end has_no_prefix has_option_prefix))
	(use wove-file "./schema.wove" (only command_name find_command_option))
	(use wove-file "./values.wove" (only decode_command_operand))
	(use wove-file "../../config/schema.wove" (only (type ProjectRule)))

	(struct CommandArgument (fields (rule i32) (form u32) (argv_index i32) (start i32) (end i32) (scalar u32)))
	(struct CommandArgs (fields (error u32) (argv_index i32) (rule i32)
		(command u32) (mode u32) (rows i32) (operands i32) (profile i32)))
	(struct SelectedOption (fields (rule i32) (kind u32) (form u32) (scalar u32) (end i32)))
	(struct SelectedValue (fields (error u32) (rule i32) (form u32) (index i32) (start i32) (end i32) (scalar u32)))

	(fn command_args_error
		(:doc "Create a parse failure with the original argument and schema row.")
		(params (code u32) (index i32) (rule i32))
		(returns CommandArgs)
		(body (return (struct.new CommandArgs (error (local code)) (argv_index (local index)) (rule (local rule))
			(command 0u32) (mode 0u32) (rows 0i32) (operands 0i32) (profile -1i32)))))

	(fn is_short_output
		(:doc "Recognize the archive's exact short spelling for build output.")
		(params (bytes (shared-slice u8)) (span ArgSpan))
		(returns bool)
		(body
			(let start (struct.get (local span) start))
			(return (bool.and (i32.eq (i32.sub.wrapping (struct.get (local span) end) (local start)) 2i32)
				(bool.and (u8.eq (slice.load (local bytes) (local start)) 45u8)
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 1i32)) 111u8))))))

	(fn is_options_end
		(:doc "Recognize the standalone end-of-options marker in a checked argument span.")
		(params (bytes (shared-slice u8)) (span ArgSpan))
		(returns bool)
		(body (return (bool.and
			(i32.eq (i32.sub.wrapping (struct.get (local span) end) (struct.get (local span) start)) 2i32)
			(call has_option_prefix (borrow-shared (local bytes)) (local span))))))

	(fn select_command_option
		(:doc "Find a long or short option and its implicit boolean, leaving attached text in the argument.")
		(params (command u32) (bytes (shared-slice u8)) (span ArgSpan)
			(names (shared-slice u8)) (rules (shared-slice ProjectRule)))
		(returns SelectedOption)
		(body
			(let end (struct.get (local span) end))
			(if
				(:doc "Only cc and bin recognize -o as their build.output option.")
				(bool.and (bool.not (u32.eq (local command) 3u32)) (call is_short_output (borrow-shared (local bytes)) (local span)))
				(then
					(let output (slice.load (local rules) 19i32))
					(return (struct.new SelectedOption (rule 19i32) (kind (struct.get (local output) kind)) (form 2u32)
						(scalar 0u32) (end (local end))))))
			(if
				(:doc "Any other dash-prefixed spelling must be a long option.")
				(bool.not (call has_option_prefix (borrow-shared (local bytes)) (local span)))
				(then (return (struct.new SelectedOption (rule -1i32) (kind 0u32) (form 0u32)
					(scalar 0u32) (end (local end))))))
			(let start (i32.add.wrapping (struct.get (local span) start) 2i32))
			(let stop (call option_name_end (borrow-shared (local bytes)) (local start) (local end)))
			(let direct (call find_command_option (local command) (borrow-shared (local bytes)) (local start) (local stop)
				(borrow-shared (local names)) (borrow-shared (local rules))))
			(let form (struct.get (local direct) form))
			(if
				(:doc "Match literal names like no-fail before interpreting the no- prefix.")
				(u32.lt 0u32 (local form))
				(then (return (struct.new SelectedOption (rule (struct.get (local direct) rule)) (kind (struct.get (local direct) kind))
					(form (local form)) (scalar 1u32) (end (local stop))))))
			(if
				(:doc "Boolean config options and cc --check accept an explicit negative spelling.")
				(call has_no_prefix (borrow-shared (local bytes)) (local start) (local stop))
				(then
					(let inverse (call find_command_option (local command) (borrow-shared (local bytes))
						(i32.add.wrapping (local start) 3i32) (local stop) (borrow-shared (local names)) (borrow-shared (local rules))))
					(if
						(:doc "Build mode selectors have only positive spellings.")
						(bool.and (u32.eq (struct.get (local inverse) form) 1u32)
							(bool.or (i32.eq (struct.get (local inverse) rule) -5i32)
								(bool.not (i32.lt (struct.get (local inverse) rule) 0i32))))
						(then (return (struct.new SelectedOption (rule (struct.get (local inverse) rule)) (kind 1u32) (form 1u32)
							(scalar 0u32) (end (local stop))))))))
			(return (struct.new SelectedOption (rule -1i32) (kind 0u32) (form 0u32)
				(scalar 0u32) (end (local stop))))))

	(fn selected_value
		(:doc "Build an option event with coordinates at the token that supplied the value or error.")
		(params (error u32) (option SelectedOption) (index i32) (start i32) (end i32) (scalar u32))
		(returns SelectedValue)
		(body (return (struct.new SelectedValue (error (local error)) (rule (struct.get (local option) rule))
			(form (struct.get (local option) form)) (index (local index)) (start (local start)) (end (local end)) (scalar (local scalar))))))

	(fn select_command_value
		(:doc "Read an attached or separate value, including the archive's dash-prefixed native flags.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (option SelectedOption) (index i32) (span ArgSpan))
		(returns SelectedValue)
		(body
			(let form (struct.get (local option) form))
			(let rule (struct.get (local option) rule))
			(let stop (struct.get (local option) end))
			(let-mut start (struct.get (local span) start))
			(let-mut end (struct.get (local span) end))
			(let attached (i32.lt (local stop) (local end)))
			(if
				(:doc "An unknown named option is an error at its own token.")
				(u32.eq (local form) 0u32)
				(then (return (call selected_value 1u32 (local option) (local index) (local start) (local end) 0u32))))
			(if
				(:doc "Switches and list resets take no operands.")
				(bool.or (u32.eq (local form) 1u32) (u32.eq (local form) 4u32))
				(then
					(if
						(:doc "Boolean switches use the positive or negative spelling without an equals value.")
						(local attached)
						(then (return (call selected_value 3u32 (local option) (local index) (local start) (local end) 0u32))))
					(return (call selected_value 0u32 (local option) (local index) -1i32 -1i32
						(struct.get (local option) scalar)))))
			(let-mut value_index (local index))
			(if
				(:doc "The equals spelling keeps the operand in the original option row.")
				(local attached)
				(then (set (local start) (i32.add.wrapping (local stop) 1i32)))
				(else
					(let next (i32.add.wrapping (local index) 1i32))
					(if
						(:doc "A final option cannot consume a separate operand.")
						(i32.eq (local next) (slice.len (local argv)))
						(then (return (call selected_value 2u32 (local option) (local index) (local start) (local end) 0u32))))
					(let separate (slice.load (local argv) (local next)))
					(let native_flag (bool.or (i32.eq (local rule) 13i32) (i32.eq (local rule) 15i32)))
					(if
						(:doc "Every option stops at the bare marker; native flags can otherwise consume dash-prefixed operands.")
						(bool.or (call is_options_end (borrow-shared (local bytes)) (local separate))
							(bool.and (bool.not (local native_flag)) (bool.or
								(call has_option_prefix (borrow-shared (local bytes)) (local separate))
								(call is_short_output (borrow-shared (local bytes)) (local separate)))))
						(then (return (call selected_value 2u32 (local option) (local index) (local start) (local end) 0u32))))
					(set (local value_index) (local next))
					(set (local start) (struct.get (local separate) start))
					(set (local end) (struct.get (local separate) end))))
			(let decoded (call decode_command_operand (borrow-shared (local bytes)) (local start) (local end)
				(local rule) (struct.get (local option) kind)))
			(if
				(:doc "An invalid operand is diagnosed at the actual value argument.")
				(bool.not (struct.get (local decoded) valid))
				(then (return (call selected_value 3u32 (local option) (local value_index) (local start) (local end) 0u32))))
			(return (call selected_value 0u32 (local option) (local value_index) (local start) (local end)
				(struct.get (local decoded) value)))))

	(fn first_command_argument
		(:doc "Locate a previously accepted option or positional by its rule.")
		(params (arguments (shared-slice CommandArgument)) (start i32) (rows i32) (rule i32))
		(returns i32)
		(body
			(let-mut row (local start))
			(while
				(:doc "Skip arguments belonging to other rules without changing argument order.")
				(i32.lt (local row) (local rows))
				(body
					(if
						(:doc "Every explicit occurrence keeps its canonical rule ID.")
						(i32.eq (struct.get (slice.load (local arguments) (local row)) rule) (local rule))
						(then (return (local row))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return -1i32)))

	(fn parse_command_args
		(:doc "Read one command and its explicit options and source operands.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (names (shared-slice u8))
			(rules (shared-slice ProjectRule)) (arguments (mut-slice CommandArgument)))
		(returns CommandArgs)
		(body
			(let size (slice.len (local argv)))
			(let bad (call check_argv (borrow-shared (local argv)) (slice.len (local bytes))))
			(if
				(:doc "No command or option lookup may read an unchecked span.")
				(bool.not (i32.lt (local bad) 0i32))
				(then (return (call command_args_error 7u32 (local bad) -1i32))))
			(if
				(:doc "A supplied invocation has one command at user argv index zero.")
				(i32.eq (local size) 0i32)
				(then (return (call command_args_error 9u32 0i32 -1i32))))
			(let first (slice.load (local argv) 0i32))
			(let command (call command_name (borrow-shared (local bytes)) (struct.get (local first) start) (struct.get (local first) end)))
			(if
				(:doc "Unknown commands retain the original command argument index.")
				(u32.eq (local command) 0u32)
				(then (return (call command_args_error 9u32 0i32 -1i32))))
			(if
				(:doc "At most one event is written per argument after the command.")
				(i32.lt (slice.len (local arguments)) (i32.sub.wrapping (local size) 1i32))
				(then (return (call command_args_error 8u32 -1i32 -1i32))))
			(let-mut index 1i32)
			(let-mut rows 0i32)
			(let-mut operands 0i32)
			(let-mut profile -1i32)
			(let-mut mode 0u32)
			(let-mut named (bool true))
			(while
				(:doc "Each loop consumes one argument, or a named option and its separate operand.")
				(i32.lt (local index) (local size))
				(body
					(let span (slice.load (local argv) (local index)))
					(let start (struct.get (local span) start))
					(let end (struct.get (local span) end))
					(let width (i32.sub.wrapping (local end) (local start)))
					(if
						(:doc "The end-of-options marker leaves all following arguments as source operands.")
						(bool.and (local named) (call is_options_end (borrow-shared (local bytes)) (local span)))
						(then (set (local named) (bool false)))
						(else
							(if
								(:doc "After the marker, or for ordinary source operands, preserve the entire span.")
								(bool.and (local named) (bool.and (i32.lt 1i32 (local width))
									(u8.eq (slice.load (local bytes) (local start)) 45u8)))
								(then
									(let option (call select_command_option (local command) (borrow-shared (local bytes)) (local span)
										(borrow-shared (local names)) (borrow-shared (local rules))))
									(let value (call select_command_value (borrow-shared (local bytes)) (borrow-shared (local argv))
										(local option) (local index) (local span)))
									(let code (struct.get (local value) error))
									(let rule (struct.get (local value) rule))
									(let form (struct.get (local value) form))
									(let at (struct.get (local value) index))
									(if
										(:doc "Selection failures already identify the offending option or value.")
										(u32.lt 0u32 (local code))
										(then (return (call command_args_error (local code) (local at) (local rule)))))
									(if
										(:doc "Aliases and boolean polarities share the same single-use rule.")
										(bool.and (u32.lt (local form) 3u32)
											(bool.not (i32.lt (call first_command_argument (borrow-shared (local arguments))
												0i32 (local rows) (local rule)) 0i32)))
										(then (return (call command_args_error 5u32 (local index) (local rule)))))
									(if
										(:doc "Select the profile only after recording its exact value argument.")
										(i32.eq (local rule) -2i32)
										(then (set (local profile) (local rows))))
									(if
										(:doc "A build may select exactly one of debug and release.")
										(bool.or (i32.eq (local rule) -3i32) (i32.eq (local rule) -4i32))
										(then
											(if
												(:doc "Point a conflict at the later mode switch.")
												(u32.lt 0u32 (local mode))
												(then (return (call command_args_error 10u32 (local index) (local rule)))))
											(set (local mode) (int.convert u32 (i32.sub.wrapping -2i32 (local rule))))))
									(slice.store (local arguments) (local rows) (struct.new CommandArgument
										(rule (local rule)) (form (local form)) (argv_index (local at))
										(start (struct.get (local value) start)) (end (struct.get (local value) end))
										(scalar (struct.get (local value) scalar))))
									(set (local index) (local at)))
								(else
									(slice.store (local arguments) (local rows) (struct.new CommandArgument
										(rule -1i32) (form 0u32) (argv_index (local index))
										(start (local start)) (end (local end)) (scalar 0u32)))
									(set (local operands) (i32.add.wrapping (local operands) 1i32))))
							(set (local rows) (i32.add.wrapping (local rows) 1i32))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (struct.new CommandArgs (error 0u32) (argv_index -1i32) (rule -1i32)
				(command (local command)) (mode (local mode)) (rows (local rows)) (operands (local operands)) (profile (local profile)))))))
