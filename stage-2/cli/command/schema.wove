(module command_schema
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Match command-line spellings to project config fields.

	Config-backed options carry their ProjectRule row and kind. Invocation
	controls use negative rows. Forms 1 through 4 are boolean switch,
	single value, repeatable value, and list reset. Form zero is unmatched.
	Commands 1 through 3 are cc, bin, and fmt.`)

	(use wove-file "../../config/schema.wove" (only (type ProjectRule) project_compiler_rule))

	(struct CommandOption (fields (rule i32) (kind u32) (form u32)))

	(fn command_word
		(:doc "Match a fixed command word, invocation control, or archive prefix.")
		(params (bytes (shared-array u8)) (start i32) (end i32) (spelling i32))
		(returns bool)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "Match the cc command.")
				(bool.and (i32.eq (local spelling) 0i32) (i32.eq (local width) 2i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 99u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 99u8)))))
			(if
				(:doc "Match the bin command.")
				(bool.and (i32.eq (local spelling) 1i32) (i32.eq (local width) 3i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 98u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 105u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 110u8))))))
			(if
				(:doc "Match the fmt command.")
				(bool.and (i32.eq (local spelling) 2i32) (i32.eq (local width) 3i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 102u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 109u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 116u8))))))
			(if
				(:doc "Match the profile selector.")
				(bool.and (i32.eq (local spelling) 3i32) (i32.eq (local width) 7i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 112u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 114u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 111u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 102u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 105u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 5i32)) 108u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 6i32)) 101u8))))))))))
			(if
				(:doc "Match the C compiler selector.")
				(bool.and (i32.eq (local spelling) 4i32) (i32.eq (local width) 8i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 99u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 111u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 109u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 112u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 105u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 5i32)) 108u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 6i32)) 101u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 7i32)) 114u8)))))))))))
			(if
				(:doc "Match the check switch.")
				(bool.and (i32.eq (local spelling) 5i32) (i32.eq (local width) 5i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 99u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 104u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 101u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 99u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 107u8))))))))
			(if
				(:doc "Match the definition list reset.")
				(bool.and (i32.eq (local spelling) 6i32) (i32.eq (local width) 13i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 99u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 108u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 101u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 97u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 114u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 5i32)) 45u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 6i32)) 100u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 7i32)) 101u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 8i32)) 102u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 9i32)) 105u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 10i32)) 110u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 11i32)) 101u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 12i32)) 115u8))))))))))))))))
			(if
				(:doc "Match the skip list reset.")
				(bool.and (i32.eq (local spelling) 7i32) (i32.eq (local width) 10i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 99u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 108u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 101u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 97u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 114u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 5i32)) 45u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 6i32)) 115u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 7i32)) 107u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 8i32)) 105u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 9i32)) 112u8)))))))))))))
			(if
				(:doc "Match the warning prefix.")
				(bool.and (i32.eq (local spelling) 8i32) (i32.eq (local width) 5i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 119u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 97u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 114u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 110u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 45u8))))))))
			(if
				(:doc "Match the build prefix.")
				(bool.and (i32.eq (local spelling) 9i32) (i32.eq (local width) 6i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 98u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 117u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 105u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 108u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 100u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 5i32)) 45u8)))))))))
			(if
				(:doc "Match the clang compiler.")
				(bool.and (i32.eq (local spelling) 10i32) (i32.eq (local width) 5i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 99u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 108u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 97u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 3i32)) 110u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 4i32)) 103u8))))))))
			(if
				(:doc "Match the GCC compiler.")
				(bool.and (i32.eq (local spelling) 11i32) (i32.eq (local width) 3i32))
				(then (return (bool.and (u8.eq (array.load (local bytes) (local start)) 103u8)
					(bool.and (u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 1i32)) 99u8)
					(u8.eq (array.load (local bytes) (i32.add.wrapping (local start) 2i32)) 99u8))))))
			(return (bool false))))

	(fn command_name
		(:doc "Recognize the three public command names; zero denotes an unknown command.")
		(params (bytes (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut name 0i32)
			(while
				(:doc "Try cc, bin and fmt in command ID order.")
				(i32.lt (local name) 3i32)
				(body
					(if
						(:doc "Only an exact spelling selects a command.")
						(call command_word (borrow-shared (local bytes)) (local start) (local end) (local name))
						(then (return (int.convert u32 (i32.add.wrapping (local name) 1i32)))))
					(set (local name) (i32.add.wrapping (local name) 1i32))))
			(return 0u32)))

	(fn same_option_name
		(:doc "Compare a canonical schema key to its kebab-case spelling without copying bytes.")
		(params (names (shared-array u8)) (key i32) (key_end i32)
			(bytes (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(let-mut name (local key))
			(let-mut at (local start))
			(while
				(:doc "Each uppercase byte consumes a hyphen and its lowercase spelling.")
				(bool.and (i32.lt (local name) (local key_end)) (i32.lt (local at) (local end)))
				(body
					(let-mut byte (array.load (local names) (local name)))
					(if
						(:doc "Kebab-case flags introduce a dash at the case transition.")
						(bool.and (u8.lt 64u8 (local byte)) (u8.lt (local byte) 91u8))
						(then
							(if
								(:doc "Both the dash and letter must fit inside the supplied span.")
								(bool.or (bool.not (u8.eq (array.load (local bytes) (local at)) 45u8))
									(bool.not (i32.lt (i32.add.wrapping (local at) 1i32) (local end))))
								(then (return (bool false))))
							(set (local byte) (int.convert u8 (i32.add.wrapping (int.convert i32 (local byte)) 32i32)))
							(set (local at) (i32.add.wrapping (local at) 1i32))))
					(if
						(:doc "Comparison stops at the first differing byte.")
						(bool.not (u8.eq (local byte) (array.load (local bytes) (local at))))
						(then (return (bool false))))
					(set (local name) (i32.add.wrapping (local name) 1i32))
					(set (local at) (i32.add.wrapping (local at) 1i32))))
			(return (bool.and (i32.eq (local name) (local key_end)) (i32.eq (local at) (local end))))))

	(fn command_accepts_rule
		(:doc "Select the config scopes and fields made available by each command.")
		(params (command u32) (row i32) (scope u32))
		(returns bool)
		(body
			(if
				(:doc "All commands share the top-level scheduling, timing, and diagnostic options.")
				(u32.eq (local scope) 1u32)
				(then (return (bool.and (i32.lt 5i32 (local row)) (bool.or (i32.lt (local row) 9i32)
					(bool.or (i32.eq (local row) (call project_compiler_rule 0i32))
						(i32.eq (local row) (call project_compiler_rule 1i32))))))))
			(if
				(:doc "Formatter flags come from fmt and the shared profile settings.")
				(u32.eq (local command) 3u32)
				(then (return (u32.eq (local scope) 7u32))))
			(if
				(:doc "Mode selectors and build output switches are shared by cc and bin.")
				(bool.or (u32.eq (local scope) 2u32) (u32.eq (local scope) 3u32))
				(then (return (bool.or (i32.eq (local row) 10i32)
					(bool.or (i32.eq (local row) 11i32)
						(bool.and (u32.eq (local scope) 3u32) (bool.or (u32.eq (local command) 2u32)
							(bool.or (i32.eq (local row) 12i32) (i32.eq (local row) 19i32)))))))))
			(if
				(:doc "Both build commands can choose cc.cstd and cc.flat.")
				(u32.eq (local command) 2u32)
				(then (return (bool.or (i32.eq (local row) 21i32) (i32.eq (local row) 23i32)))))
			(return (bool.or (u32.eq (local scope) 5u32)
				(bool.and (u32.eq (local scope) 4u32) (bool.not (i32.eq (local row) 25i32)))))))

	(fn command_rule_name
		(:doc "Use the archive's prefixes and singular list option names for config-backed fields.")
		(params (bytes (shared-array u8)) (start i32) (end i32)
			(names (shared-array u8)) (rule ProjectRule) (row i32))
		(returns bool)
		(body
			(let-mut at (local start))
			(let-mut key_end (struct.get (local rule) end))
			(let scope (struct.get (local rule) scope))
			(if
				(:doc "Warnings are prefixed with warn-; build cache and layout use build-.")
				(bool.or (u32.eq (local scope) 5u32)
					(bool.or (i32.eq (local row) 12i32) (i32.eq (local row) 23i32)))
				(then
					(let-mut prefix 8i32)
					(let-mut width 5i32)
					(if
						(:doc "Only cache and flat use the six-byte build- prefix.")
						(bool.not (u32.eq (local scope) 5u32))
						(then (set (local prefix) 9i32) (set (local width) 6i32)))
					(if
						(:doc "The prefix must fit in the candidate span before computing its end.")
						(i32.lt (i32.sub.wrapping (local end) (local at)) (local width))
						(then (return (bool false))))
					(set (local at) (i32.add.wrapping (local at) (local width)))
					(if
						(:doc "Require the complete command-specific prefix before comparing the key.")
						(bool.not (call command_word (borrow-shared (local bytes)) (local start) (local at) (local prefix)))
						(then (return (bool false))))))
			(if
				(:doc "Build arrays and compiler definitions use singular flags; skip already does.")
				(bool.or (bool.and (u32.eq (local scope) 3u32) (u32.eq (struct.get (local rule) kind) 6u32))
					(i32.eq (local row) 22i32))
				(then (set (local key_end) (i32.sub.wrapping (local key_end) 1i32))))
			(return (call same_option_name (borrow-shared (local names)) (struct.get (local rule) start) (local key_end)
				(borrow-shared (local bytes)) (local at) (local end)))))

	(fn command_option
		(:doc "Construct the descriptor for a spelling's config field or invocation-only control.")
		(params (rule i32) (kind u32) (form u32))
		(returns CommandOption)
		(body (return (struct.new CommandOption (rule (local rule)) (kind (local kind)) (form (local form))))))

	(fn find_command_option
		(:doc "Find a long option by its exact spelling, excluding dashes and an attached operand.")
		(params (command u32) (bytes (shared-array u8)) (start i32) (end i32)
			(names (shared-array u8)) (rules (shared-array ProjectRule)))
		(returns CommandOption)
		(body
			(if
				(:doc "Profile selection is a string-valued invocation control.")
				(call command_word (borrow-shared (local bytes)) (local start) (local end) 3i32)
				(then (return (call command_option -2i32 5u32 2u32))))
			(if
				(:doc "Only bin selects a native C compiler.")
				(bool.and (u32.eq (local command) 2u32)
					(call command_word (borrow-shared (local bytes)) (local start) (local end) 4i32))
				(then (return (call command_option -6i32 17u32 2u32))))
			(if
				(:doc "cc --check skips emission. fmt --check sets checkFormatting.")
				(bool.and (bool.not (u32.eq (local command) 2u32))
					(call command_word (borrow-shared (local bytes)) (local start) (local end) 5i32))
				(then
					(if
						(:doc "Formatter checks use the same option row as --check-formatting.")
						(u32.eq (local command) 3u32)
						(then (return (call command_option 36i32 1u32 1u32))))
					(return (call command_option -5i32 1u32 1u32))))
			(if
				(:doc "The clear switches are explicitly empty overrides of their command's repeatable option.")
				(bool.not (u32.eq (local command) 3u32))
				(then
					(if
						(:doc "bin uses build.defines; cc uses cc.defines.")
						(call command_word (borrow-shared (local bytes)) (local start) (local end) 6i32)
						(then
							(if
								(:doc "The bin definitions are part of the selected build mode.")
								(u32.eq (local command) 2u32)
								(then (return (call command_option 14i32 6u32 4u32))))
							(return (call command_option 22i32 6u32 4u32))))))
			(if
				(:doc "Only source commands expose a skip list and its clear switch.")
				(bool.and (bool.not (u32.eq (local command) 2u32))
					(call command_word (borrow-shared (local bytes)) (local start) (local end) 7i32))
				(then
					(if
						(:doc "The formatter uses its own skip list.")
						(u32.eq (local command) 3u32)
						(then (return (call command_option 63i32 6u32 4u32))))
					(return (call command_option 24i32 6u32 4u32))))
			(let-mut row 0i32)
			(while
				(:doc "Only options exposed by the chosen command participate in matching.")
				(i32.lt (local row) (array.len (local rules)))
				(body
					(let rule (array.load (local rules) (local row)))
					(if
						(:doc "Keep the schema's canonical rule and typed discriminator for aliases as well.")
						(bool.and (call command_accepts_rule (local command) (local row) (struct.get (local rule) scope))
							(call command_rule_name (borrow-shared (local bytes)) (local start) (local end)
								(borrow-shared (local names)) (local rule) (local row)))
						(then
							(let kind (struct.get (local rule) kind))
							(if
								(:doc "The debug and release keys select build modes instead of supplying object values.")
								(i32.eq (local row) 10i32)
								(then (return (call command_option -3i32 1u32 1u32))))
							(if
								(:doc "Mode selectors have distinct controls to diagnose conflicts.")
								(i32.eq (local row) 11i32)
								(then (return (call command_option -4i32 1u32 1u32))))
							(if
								(:doc "Boolean fields are exposed as switches.")
								(u32.eq (local kind) 1u32)
								(then (return (call command_option (local row) (local kind) 1u32))))
							(if
								(:doc "A string-array field takes any number of separate option occurrences.")
								(u32.eq (local kind) 6u32)
								(then (return (call command_option (local row) (local kind) 3u32))))
							(return (call command_option (local row) (local kind) 2u32))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return (call command_option -1i32 0u32 0u32)))))
