(module command_schema
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Match command-line spellings to project config fields.

	Config-backed options carry their ProjectRule row and kind. Invocation
	controls use negative rows. Forms 1 through 4 are boolean switch,
	single value, repeatable value, and list reset. Form zero is unmatched.
	Commands 1 through 3 are cc, bin, and fmt.`)

	(use wove-file "../../config/schema.wove" (only (type ProjectRule) project_compiler_rule))

	(struct CommandOption (fields (rule i32) (kind u32) (form u32)))

	(fn command_word
		(:doc "Match a fixed command word, invocation control, or archive prefix.")
		(params (bytes (shared-slice u8)) (start i32) (end i32) (spelling i32))
		(returns bool)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "Match the cc command.")
				(bool.and (i32.eq (local spelling) (i32 0)) (i32.eq (local width) (i32 2)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 99))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 99))))))
			(if
				(:doc "Match the bin command.")
				(bool.and (i32.eq (local spelling) (i32 1)) (i32.eq (local width) (i32 3)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 98))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 105))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 110)))))))
			(if
				(:doc "Match the fmt command.")
				(bool.and (i32.eq (local spelling) (i32 2)) (i32.eq (local width) (i32 3)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 102))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 109))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 116)))))))
			(if
				(:doc "Match the profile selector.")
				(bool.and (i32.eq (local spelling) (i32 3)) (i32.eq (local width) (i32 7)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 112))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 114))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 111))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 102))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 105))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 5))) (u8 108))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 6))) (u8 101)))))))))))
			(if
				(:doc "Match the C compiler selector.")
				(bool.and (i32.eq (local spelling) (i32 4)) (i32.eq (local width) (i32 8)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 99))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 111))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 109))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 112))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 105))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 5))) (u8 108))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 6))) (u8 101))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 7))) (u8 114))))))))))))
			(if
				(:doc "Match the check switch.")
				(bool.and (i32.eq (local spelling) (i32 5)) (i32.eq (local width) (i32 5)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 99))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 104))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 101))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 99))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 107)))))))))
			(if
				(:doc "Match the definition list reset.")
				(bool.and (i32.eq (local spelling) (i32 6)) (i32.eq (local width) (i32 13)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 99))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 108))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 101))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 97))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 114))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 5))) (u8 45))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 6))) (u8 100))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 7))) (u8 101))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 8))) (u8 102))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 9))) (u8 105))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 10))) (u8 110))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 11))) (u8 101))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 12))) (u8 115)))))))))))))))))
			(if
				(:doc "Match the skip list reset.")
				(bool.and (i32.eq (local spelling) (i32 7)) (i32.eq (local width) (i32 10)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 99))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 108))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 101))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 97))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 114))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 5))) (u8 45))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 6))) (u8 115))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 7))) (u8 107))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 8))) (u8 105))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 9))) (u8 112))))))))))))))
			(if
				(:doc "Match the warning prefix.")
				(bool.and (i32.eq (local spelling) (i32 8)) (i32.eq (local width) (i32 5)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 119))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 97))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 114))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 110))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 45)))))))))
			(if
				(:doc "Match the build prefix.")
				(bool.and (i32.eq (local spelling) (i32 9)) (i32.eq (local width) (i32 6)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 98))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 117))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 105))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 108))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 100))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 5))) (u8 45))))))))))
			(if
				(:doc "Match the clang compiler.")
				(bool.and (i32.eq (local spelling) (i32 10)) (i32.eq (local width) (i32 5)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 99))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 108))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 97))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 3))) (u8 110))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 4))) (u8 103)))))))))
			(if
				(:doc "Match the GCC compiler.")
				(bool.and (i32.eq (local spelling) (i32 11)) (i32.eq (local width) (i32 3)))
				(then (return (bool.and (u8.eq (slice.load (local bytes) (local start)) (u8 103))
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 1))) (u8 99))
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) (i32 2))) (u8 99)))))))
			(return (bool false))))

	(fn command_name
		(:doc "Recognize the three public command names; zero denotes an unknown command.")
		(params (bytes (shared-slice u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut name (i32 0))
			(while
				(:doc "Try cc, bin and fmt in command ID order.")
				(i32.lt (local name) (i32 3))
				(body
					(if
						(:doc "Only an exact spelling selects a command.")
						(call command_word (borrow-shared (local bytes)) (local start) (local end) (local name))
						(then (return (int.convert u32 (i32.add.wrapping (local name) (i32 1))))))
					(set (local name) (i32.add.wrapping (local name) (i32 1)))))
			(return (u32 0))))

	(fn same_option_name
		(:doc "Compare a canonical schema key to its kebab-case spelling without copying bytes.")
		(params (names (shared-slice u8)) (key i32) (key_end i32)
			(bytes (shared-slice u8)) (start i32) (end i32))
		(returns bool)
		(body
			(let-mut name (local key))
			(let-mut at (local start))
			(while
				(:doc "Each uppercase byte consumes a hyphen and its lowercase spelling.")
				(bool.and (i32.lt (local name) (local key_end)) (i32.lt (local at) (local end)))
				(body
					(let-mut byte (slice.load (local names) (local name)))
					(if
						(:doc "Kebab-case flags introduce a dash at the case transition.")
						(bool.and (u8.lt (u8 64) (local byte)) (u8.lt (local byte) (u8 91)))
						(then
							(if
								(:doc "Both the dash and letter must fit inside the supplied span.")
								(bool.or (bool.not (u8.eq (slice.load (local bytes) (local at)) (u8 45)))
									(bool.not (i32.lt (i32.add.wrapping (local at) (i32 1)) (local end))))
								(then (return (bool false))))
							(set (local byte) (int.convert u8 (i32.add.wrapping (int.convert i32 (local byte)) (i32 32))))
							(set (local at) (i32.add.wrapping (local at) (i32 1)))))
					(if
						(:doc "Comparison stops at the first differing byte.")
						(bool.not (u8.eq (local byte) (slice.load (local bytes) (local at))))
						(then (return (bool false))))
					(set (local name) (i32.add.wrapping (local name) (i32 1)))
					(set (local at) (i32.add.wrapping (local at) (i32 1)))))
			(return (bool.and (i32.eq (local name) (local key_end)) (i32.eq (local at) (local end))))))

	(fn command_accepts_rule
		(:doc "Select the config scopes and fields made available by each command.")
		(params (command u32) (row i32) (scope u32))
		(returns bool)
		(body
			(if
				(:doc "All commands share the top-level scheduling, timing, and diagnostic options.")
				(u32.eq (local scope) (u32 1))
				(then (return (bool.and (i32.lt (i32 5) (local row)) (bool.or (i32.lt (local row) (i32 9))
					(bool.or (i32.eq (local row) (call project_compiler_rule (i32 0)))
						(i32.eq (local row) (call project_compiler_rule (i32 1)))))))))
			(if
				(:doc "Formatter flags come from fmt and the shared profile settings.")
				(u32.eq (local command) (u32 3))
				(then (return (u32.eq (local scope) (u32 7)))))
			(if
				(:doc "Mode selectors and build output switches are shared by cc and bin.")
				(bool.or (u32.eq (local scope) (u32 2)) (u32.eq (local scope) (u32 3)))
				(then (return (bool.or (i32.eq (local row) (i32 10))
					(bool.or (i32.eq (local row) (i32 11))
						(bool.and (u32.eq (local scope) (u32 3)) (bool.or (u32.eq (local command) (u32 2))
							(bool.or (i32.eq (local row) (i32 12)) (i32.eq (local row) (i32 19))))))))))
			(if
				(:doc "Both build commands can choose cc.cstd and cc.flat.")
				(u32.eq (local command) (u32 2))
				(then (return (bool.or (i32.eq (local row) (i32 21)) (i32.eq (local row) (i32 23))))))
			(return (bool.or (u32.eq (local scope) (u32 5))
				(bool.and (u32.eq (local scope) (u32 4)) (bool.not (i32.eq (local row) (i32 25))))))))

	(fn command_rule_name
		(:doc "Use the archive's prefixes and singular list option names for config-backed fields.")
		(params (bytes (shared-slice u8)) (start i32) (end i32)
			(names (shared-slice u8)) (rule ProjectRule) (row i32))
		(returns bool)
		(body
			(let-mut at (local start))
			(let-mut key_end (record.get (local rule) end))
			(let scope (record.get (local rule) scope))
			(if
				(:doc "Warnings are prefixed with warn-; build cache and layout use build-.")
				(bool.or (u32.eq (local scope) (u32 5))
					(bool.or (i32.eq (local row) (i32 12)) (i32.eq (local row) (i32 23))))
				(then
					(let-mut prefix (i32 8))
					(let-mut width (i32 5))
					(if
						(:doc "Only cache and flat use the six-byte build- prefix.")
						(bool.not (u32.eq (local scope) (u32 5)))
						(then (set (local prefix) (i32 9)) (set (local width) (i32 6))))
					(if
						(:doc "The prefix must fit in the candidate span before computing its end.")
						(i32.lt (i32.sub.wrapping (local end) (local at)) (local width))
						(then (return (bool false))))
					(set (local at) (i32.add.wrapping (local at) (local width)))
					(if
						(:doc "Require the complete command-specific prefix before comparing the key.")
						(bool.not (call command_word (borrow-shared (local bytes)) (local start) (local at) (local prefix)))
						(then (return (bool false))))))
			(if
				(:doc "Build arrays and compiler definitions use singular flags; skip already does.")
				(bool.or (bool.and (u32.eq (local scope) (u32 3)) (u32.eq (record.get (local rule) kind) (u32 6)))
					(i32.eq (local row) (i32 22)))
				(then (set (local key_end) (i32.sub.wrapping (local key_end) (i32 1)))))
			(return (call same_option_name (borrow-shared (local names)) (record.get (local rule) start) (local key_end)
				(borrow-shared (local bytes)) (local at) (local end)))))

	(fn command_option
		(:doc "Construct the descriptor for a spelling's config field or invocation-only control.")
		(params (rule i32) (kind u32) (form u32))
		(returns CommandOption)
		(body (return (record.make CommandOption (rule (local rule)) (kind (local kind)) (form (local form))))))

	(fn find_command_option
		(:doc "Find a long option by its exact spelling, excluding dashes and an attached operand.")
		(params (command u32) (bytes (shared-slice u8)) (start i32) (end i32)
			(names (shared-slice u8)) (rules (shared-slice ProjectRule)))
		(returns CommandOption)
		(body
			(if
				(:doc "Profile selection is a string-valued invocation control.")
				(call command_word (borrow-shared (local bytes)) (local start) (local end) (i32 3))
				(then (return (call command_option (i32 -2) (u32 5) (u32 2)))))
			(if
				(:doc "Only bin selects a native C compiler.")
				(bool.and (u32.eq (local command) (u32 2))
					(call command_word (borrow-shared (local bytes)) (local start) (local end) (i32 4)))
				(then (return (call command_option (i32 -6) (u32 17) (u32 2)))))
			(if
				(:doc "cc --check skips emission. fmt --check sets checkFormatting.")
				(bool.and (bool.not (u32.eq (local command) (u32 2)))
					(call command_word (borrow-shared (local bytes)) (local start) (local end) (i32 5)))
				(then
					(if
						(:doc "Formatter checks use the same option row as --check-formatting.")
						(u32.eq (local command) (u32 3))
						(then (return (call command_option (i32 36) (u32 1) (u32 1)))))
					(return (call command_option (i32 -5) (u32 1) (u32 1)))))
			(if
				(:doc "The clear switches are explicitly empty overrides of their command's repeatable option.")
				(bool.not (u32.eq (local command) (u32 3)))
				(then
					(if
						(:doc "bin uses build.defines; cc uses cc.defines.")
						(call command_word (borrow-shared (local bytes)) (local start) (local end) (i32 6))
						(then
							(if
								(:doc "The bin definitions are part of the selected build mode.")
								(u32.eq (local command) (u32 2))
								(then (return (call command_option (i32 14) (u32 6) (u32 4)))))
							(return (call command_option (i32 22) (u32 6) (u32 4)))))))
			(if
				(:doc "Only source commands expose a skip list and its clear switch.")
				(bool.and (bool.not (u32.eq (local command) (u32 2)))
					(call command_word (borrow-shared (local bytes)) (local start) (local end) (i32 7)))
				(then
					(if
						(:doc "The formatter uses its own skip list.")
						(u32.eq (local command) (u32 3))
						(then (return (call command_option (i32 63) (u32 6) (u32 4)))))
					(return (call command_option (i32 24) (u32 6) (u32 4)))))
			(let-mut row (i32 0))
			(while
				(:doc "Only options exposed by the chosen command participate in matching.")
				(i32.lt (local row) (slice.len (local rules)))
				(body
					(let rule (slice.load (local rules) (local row)))
					(if
						(:doc "Keep the schema's canonical rule and typed discriminator for aliases as well.")
						(bool.and (call command_accepts_rule (local command) (local row) (record.get (local rule) scope))
							(call command_rule_name (borrow-shared (local bytes)) (local start) (local end)
								(borrow-shared (local names)) (local rule) (local row)))
						(then
							(let kind (record.get (local rule) kind))
							(if
								(:doc "The debug and release keys select build modes instead of supplying object values.")
								(i32.eq (local row) (i32 10))
								(then (return (call command_option (i32 -3) (u32 1) (u32 1)))))
							(if
								(:doc "Mode selectors have distinct controls to diagnose conflicts.")
								(i32.eq (local row) (i32 11))
								(then (return (call command_option (i32 -4) (u32 1) (u32 1)))))
							(if
								(:doc "Boolean fields are exposed as switches.")
								(u32.eq (local kind) (u32 1))
								(then (return (call command_option (local row) (local kind) (u32 1)))))
							(if
								(:doc "A string-array field takes any number of separate option occurrences.")
								(u32.eq (local kind) (u32 6))
								(then (return (call command_option (local row) (local kind) (u32 3)))))
							(return (call command_option (local row) (local kind) (u32 2)))))
					(set (local row) (i32.add.wrapping (local row) (i32 1)))))
			(return (call command_option (i32 -1) (u32 0) (u32 0))))))
