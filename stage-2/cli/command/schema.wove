(module command_schema
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Match command-line spellings to project config fields.

	Config-backed options carry their ProjectRule row and kind. Invocation
	controls use negative rows. Forms 1 through 4 are boolean switch,
	single value, repeatable value, and list reset. Form zero is unmatched.
	Commands 1 and 2 are cc and bin.`)

	(use wove-file "../../config/schema.wove" (only (type ProjectRule) project_compiler_rule))

	(struct CommandOption (fields (rule i32) (kind u32) (form u32)))

	(fn command_word
		(:doc "Match a fixed command word or invocation control.")
		(params (bytes (shared-array u8)) (start i32) (end i32) (spelling i32))
		(returns bool)
		(body
			(let width (end.sub start))
			(if
				(:doc "Match the cc command.")
				(bool:and spelling.eqz (width.eq 2i32))
				(then (return (bool:and (u8:eq (bytes.get start) 99u8)
					(u8:eq (bytes.get start.inc) 99u8)))))
			(if
				(:doc "Match the bin command.")
				(bool:and (spelling.eq 1i32) (width.eq 3i32))
				(then (return (bool:and (u8:eq (bytes.get start) 98u8)
					(bool:and (u8:eq (bytes.get start.inc) 105u8)
					(u8:eq (bytes.get (start.add 2i32)) 110u8))))))
			(if
				(:doc "Match the profile selector.")
				(bool:and (spelling.eq 2i32) (width.eq 7i32))
				(then (return (bool:and (u8:eq (bytes.get start) 112u8)
					(bool:and (u8:eq (bytes.get start.inc) 114u8)
					(bool:and (u8:eq (bytes.get (start.add 2i32)) 111u8)
					(bool:and (u8:eq (bytes.get (start.add 3i32)) 102u8)
					(bool:and (u8:eq (bytes.get (start.add 4i32)) 105u8)
					(bool:and (u8:eq (bytes.get (start.add 5i32)) 108u8)
					(u8:eq (bytes.get (start.add 6i32)) 101u8))))))))))
			(if
				(:doc "Match the check switch.")
				(bool:and (spelling.eq 3i32) (width.eq 5i32))
				(then (return (bool:and (u8:eq (bytes.get start) 99u8)
					(bool:and (u8:eq (bytes.get start.inc) 104u8)
					(bool:and (u8:eq (bytes.get (start.add 2i32)) 101u8)
					(bool:and (u8:eq (bytes.get (start.add 3i32)) 99u8)
					(u8:eq (bytes.get (start.add 4i32)) 107u8))))))))
			(if
				(:doc "Match the definition list reset.")
				(bool:and (spelling.eq 4i32) (width.eq 13i32))
				(then (return (bool:and (u8:eq (bytes.get start) 99u8)
					(bool:and (u8:eq (bytes.get start.inc) 108u8)
					(bool:and (u8:eq (bytes.get (start.add 2i32)) 101u8)
					(bool:and (u8:eq (bytes.get (start.add 3i32)) 97u8)
					(bool:and (u8:eq (bytes.get (start.add 4i32)) 114u8)
					(bool:and (u8:eq (bytes.get (start.add 5i32)) 45u8)
					(bool:and (u8:eq (bytes.get (start.add 6i32)) 100u8)
					(bool:and (u8:eq (bytes.get (start.add 7i32)) 101u8)
					(bool:and (u8:eq (bytes.get (start.add 8i32)) 102u8)
					(bool:and (u8:eq (bytes.get (start.add 9i32)) 105u8)
					(bool:and (u8:eq (bytes.get (start.add 10i32)) 110u8)
					(bool:and (u8:eq (bytes.get (start.add 11i32)) 101u8)
					(u8:eq (bytes.get (start.add 12i32)) 115u8))))))))))))))))
			(return (bool false))))

	(fn command_name
		(:doc "Recognize the two build commands. Zero denotes an unknown command.")
		(params (bytes (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut name 0i32)
			(while
				(:doc "Try cc and bin in command ID order.")
				(name.lt 2i32)
				(body
					(if
						(:doc "Only an exact spelling selects a command.")
						(call command_word (borrow-shared bytes) start end name)
						(then (return (u32:from-i32 name.inc))))
					(set name name.inc)))
			(return 0u32)))

	(fn same_option_name
		(:doc "Compare a canonical schema key to its kebab-case spelling without copying bytes.")
		(params (names (shared-array u8)) (key i32) (key_end i32)
			(bytes (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(let-mut name key)
			(let-mut at start)
			(while
				(:doc "Each uppercase byte consumes a hyphen and its lowercase spelling.")
				(bool:and (name.lt key_end) (at.lt end))
				(body
					(let-mut byte (names.get name))
					(if
						(:doc "Kebab-case flags introduce a dash at the case transition.")
						(bool:and (u8:lt 64u8 byte) (byte.lt 91u8))
						(then
							(if
								(:doc "Both the dash and letter must fit inside the supplied span.")
								(bool:or (u8:not-eq (bytes.get at) 45u8)
									(i32:not-lt at.inc end))
								(then (return (bool false))))
							(set byte (u8:from-i32 (i32:add (i32:from-u8 byte) 32i32)))
							(set at at.inc)))
					(if
						(:doc "Comparison stops at the first differing byte.")
						(byte.not-eq (bytes.get at))
						(then (return (bool false))))
					(set name name.inc)
					(set at at.inc)))
			(return (bool:and (name.eq key_end) (at.eq end)))))

	(fn command_accepts_rule
		(:doc "Expose the config fields that have a command-line spelling and a native consumer.")
		(params (command u32) (row i32) (scope u32))
		(returns bool)
		(body
			(let bin (command.eq 2u32))
			(if
				(:doc "Both commands can select human diagnostics. Only bin schedules native builds.")
				(scope.eq 1u32)
				(then (return (bool:or (row.eq (call project_compiler_rule 0i32))
					(bin.and (bool:or (row.eq 6i32) (row.eq 7i32)))))))
			(if
				(:doc "The debug and release keys select built-in build modes.")
				(scope.eq 2u32)
				(then (return (bool:or (row.eq 10i32) (row.eq 11i32)))))
			(if
				(:doc "Output selection is shared. Bin also accepts compile flags, link options, and LTO.")
				(scope.eq 3u32)
				(then (return (bool:or (row.eq 19i32)
					(bin.and (bool:and (i32:lt 12i32 row) (row.lt 19i32)))))))
			(return (bool:and (scope.eq 4u32)
				(bool:or (row.eq 20i32)
					(bool:and bin.not (row.eq 21i32)))))))

	(fn command_rule_name
		(:doc "Use singular option names for config-backed lists.")
		(params (bytes (shared-array u8)) (start i32) (end i32)
			(names (shared-array u8)) (rule ProjectRule) (row i32))
		(returns bool)
		(body
			(let-mut key_end rule/end)
			(let scope rule/scope)
			(if
				(:doc "Build arrays and compiler definitions use singular flags.")
				(bool:or (bool:and (scope.eq 3u32) (u32:eq rule/kind 6u32))
					(row.eq 21i32))
				(then (set key_end key_end.dec)))
			(return (call same_option_name (borrow-shared names) rule/start key_end
				(borrow-shared bytes) start end))))

	(fn command_option
		(:doc "Construct the descriptor for a spelling's config field or invocation-only control.")
		(params (rule i32) (kind u32) (form u32))
		(returns CommandOption)
		(body (return (struct:new CommandOption (rule rule) (kind kind) (form form)))))

	(fn find_command_option
		(:doc "Find a long option by its exact spelling, excluding dashes and an attached operand.")
		(params (command u32) (bytes (shared-array u8)) (start i32) (end i32)
			(names (shared-array u8)) (rules (shared-array ProjectRule)))
		(returns CommandOption)
		(body
			(if
				(:doc "Profile selection is a string-valued invocation control.")
				(call command_word (borrow-shared bytes) start end 2i32)
				(then (return (call command_option -2i32 5u32 2u32))))
			(if
				(:doc "Recognize cc --check for source and semantic checks without emission.")
				(bool:and (command.eq 1u32)
					(call command_word (borrow-shared bytes) start end 3i32))
				(then (return (call command_option -5i32 1u32 1u32))))
			(if
				(:doc "The clear switch supplies an explicitly empty list of definitions.")
				(call command_word (borrow-shared bytes) start end 4i32)
				(then
					(if
						(:doc "The bin definitions are part of the selected build mode.")
						(command.eq 2u32)
						(then (return (call command_option 14i32 6u32 4u32))))
					(return (call command_option 21i32 6u32 4u32))))
			(let-mut row 0i32)
			(while
				(:doc "Only options exposed by the chosen command participate in matching.")
				(row.lt rules.len)
				(body
					(let rule (rules.get row))
					(if
						(:doc "Keep the schema's canonical rule and typed discriminator for aliases as well.")
						(bool:and (call command_accepts_rule command row rule/scope)
							(call command_rule_name (borrow-shared bytes) start end
								(borrow-shared names) rule row))
						(then
							(let kind rule/kind)
							(if
								(:doc "The debug and release keys select build modes instead of supplying object values.")
								(row.eq 10i32)
								(then (return (call command_option -3i32 1u32 1u32))))
							(if
								(:doc "Mode selectors have distinct controls to diagnose conflicts.")
								(row.eq 11i32)
								(then (return (call command_option -4i32 1u32 1u32))))
							(if
								(:doc "Boolean fields are exposed as switches.")
								(kind.eq 1u32)
								(then (return (call command_option row kind 1u32))))
							(if
								(:doc "A string-array field takes any number of separate option occurrences.")
								(kind.eq 6u32)
								(then (return (call command_option row kind 3u32))))
							(return (call command_option row kind 2u32))))
					(set row row.inc)))
			(return (call command_option -1i32 0u32 0u32)))))
