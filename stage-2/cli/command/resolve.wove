(module command_resolution
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve a supplied argv and optional JSONC into one typed command.

	Argv excludes the executable and starts with cc or bin.
	With has_config false, config bytes and JSON scratch are ignored.
	Otherwise, nodes and settings receive the validated project document.
	Allocate at least argv length minus one CommandArgument rows.
	Only the reported rows from a successful invocation are usable.

	Diagnostics use source 1 for project JSONC byte spans and source 2
	for argv, as in the compiler option resolver. An unknown requested
	profile is argv code 11. Unused coordinates are -1. The mode is
	default, debug or release (0 to 2).

	Command settings use origin 1 for the config, 2 for argv, or 3 for
	built-in values. Explicit options take precedence over their profile
	settings. Repeated values are kept in argv order and replace the
	configured list; a clear switch also discards earlier occurrences.
	A setting's row points to the JSON node or first effective argv row.
	For argv lists, count is the number of matching rows to read starting
	at row. Interleaved options and operands retain their original positions.
	An explicit clear with no following item returns count zero and row -1.
	Built-in cflags can be read with write_default_cflag in config/defaults.`)

	(use wove-file "../argv.wove" (only (type ArgSpan)))
	(use wove-file "./args.wove" (only (type CommandArgument) parse_command_args))
	(use wove-file "../../config/schema.wove" (only (type ProjectRule) project_rule_count project_key_bytes write_project_schema))
	(use wove-file "../../config/project.wove" (only (type ProjectRead) (type ProjectSetting) read_project_config_with_schema project_setting))
	(use wove-file "../../config/defaults.wove" (only project_default_scalar project_default_cflags))
	(use wove-file "../../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../text/bytes.wove" (only same_bytes))

	(struct CommandInvocation
		(fields (source u32) (error u32) (argv_index i32) (rule i32) (start i32) (end i32)
			(command u32) (mode u32) (rows i32) (operands i32) (default_profile i32) (selected_profile i32) (argv_human bool)))
	(struct CommandSetting (fields (origin u32) (scalar u32) (row i32) (count i32)))

	(fn command_failure
		(:doc "Report an argv or JSONC failure without publishing a usable invocation.")
		(params (source u32) (error u32) (index i32) (rule i32) (start i32) (end i32) (argv_human bool))
		(returns CommandInvocation)
		(body (return (struct.new CommandInvocation (source source) (error error)
			(argv_index index) (rule rule) (start start) (end end)
			(command 0u32) (mode 0u32) (rows 0i32) (operands 0i32)
			(default_profile -1i32) (selected_profile -1i32) (argv_human argv_human)))))

	(fn command_project
		(:doc "Use the profile named by argv; an absent project has only the built-in default profile.")
		(params (config (shared-array u8)) (has_config bool) (requested (shared-array u8))
			(nodes (mut-array JsonNode)) (settings (mut-array ProjectSetting))
			(names (shared-array u8)) (rules (shared-array ProjectRule)))
		(returns ProjectRead)
		(body
			(if
				(:doc "Validate all profiles and retain original key and value spans when project bytes were supplied.")
				has_config
				(then (return (call read_project_config_with_schema (borrow-shared config) (borrow-shared requested)
					(borrow-mut nodes) (borrow-mut settings) (borrow-shared names) (borrow-shared rules)))))
			(let default_name (array.load rules 9i32))
			(let length (array.len requested))
			(let-mut error 0u32)
			(if
				(:doc "The canonical default spelling also works without a project file.")
				(bool.not (bool.or (i32.eqz length)
					(call same_bytes (borrow-shared names) (struct.get default_name start)
						(struct.get default_name end) (borrow-shared requested) 0i32 length)))
				(then (set error 19u32)))
			(return (struct.new ProjectRead (error error) (start -1i32) (end -1i32)
				(default_profile -1i32) (selected_profile -1i32)))))

	(fn resolve_command
		(:doc "Resolve argv controls and validate the selected settings before returning the invocation.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (config (shared-array u8)) (has_config bool)
			(nodes (mut-array JsonNode)) (settings (mut-array ProjectSetting)) (arguments (mut-array CommandArgument)))
		(returns CommandInvocation)
		(body
			(let-mut names (array.alloc u8 (call project_key_bytes)))
			(let-mut rules (array.alloc ProjectRule (call project_rule_count)))
			(call write_project_schema (borrow-mut names) (borrow-mut rules))
			(let parsed (call parse_command_args (borrow-shared bytes) (borrow-shared argv)
				(borrow-shared names) (borrow-shared rules) (borrow-mut arguments)))
			(let error (struct.get parsed error))
			(let argv_human (struct.get parsed argv_human))
			(if
				(:doc "Unknown commands and invalid options are reported before inspecting the project.")
				(u32.gtz error)
				(then (return (call command_failure 2u32 error (struct.get parsed argv_index)
					(struct.get parsed rule) -1i32 -1i32 argv_human))))
			(let profile (struct.get parsed profile))
			(let-mut start 0i32)
			(let-mut end 0i32)
			(let-mut at -1i32)
			(if
				(:doc "Use the original argv byte span for either selector spelling.")
				(i32.not-ltz profile)
				(then
					(let selector (array.load arguments profile))
					(set start (struct.get selector start))
					(set end (struct.get selector end))
					(set at (struct.get selector argv_index))))
			(let project (call command_project (borrow-shared config) has_config
				(borrow-shared (array.range bytes start end))
				(borrow-mut nodes) (borrow-mut settings) (borrow-shared names) (borrow-shared rules)))
			(let config_error (struct.get project error))
			(if
				(:doc "A missing profile is a selector error at the supplied argv value.")
				(u32.eq config_error 19u32)
				(then (return (call command_failure 2u32 11u32 at -2i32 start end argv_human))))
			(if
				(:doc "Malformed project data keeps the JSONC diagnostic span.")
				(u32.gtz config_error)
				(then (return (call command_failure 1u32 config_error -1i32 -1i32
					(struct.get project start) (struct.get project end) argv_human))))
			(return (struct.new CommandInvocation (source 0u32) (error 0u32)
				(argv_index -1i32) (rule -1i32) (start -1i32) (end -1i32)
				(command (struct.get parsed command)) (mode (struct.get parsed mode))
				(rows (struct.get parsed rows)) (operands (struct.get parsed operands))
				(default_profile (struct.get project default_profile))
				(selected_profile (struct.get project selected_profile)) (argv_human argv_human)))))

	(fn resolved_command_setting
		(:doc "Construct a typed value, its source row, and the count of effective argv occurrences.")
		(params (origin u32) (scalar u32) (row i32) (count i32))
		(returns CommandSetting)
		(body (return (struct.new CommandSetting (origin origin) (scalar scalar)
			(row row) (count count)))))

	(fn command_argv_setting
		(:doc "Collect the explicit values for one rule, stopping inherited and earlier list items at a clear.")
		(params (arguments (shared-array CommandArgument)) (rows i32) (rule i32))
		(returns CommandSetting)
		(body
			(let-mut origin 0u32)
			(let-mut first -1i32)
			(let-mut count 0i32)
			(let-mut value 0u32)
			(let-mut row 0i32)
			(while
				(:doc "Only occurrences matching the rule contribute to an explicit override.")
				(i32.lt row rows)
				(body
					(let argument (array.load arguments row))
					(if
						(:doc "A list reset is explicit even if there are no subsequent values.")
						(i32.eq (struct.get argument rule) rule)
						(then
							(set origin 2u32)
							(if
								(:doc "A clear switch drops every earlier occurrence of the rule.")
								(u32.eq (struct.get argument form) 4u32)
								(then (set first -1i32) (set count 0i32))
								(else
									(if
										(:doc "Remember the first surviving occurrence in the ordered argv rows.")
										(i32.ltz first)
										(then (set first row)))
									(set count (i32.inc count))
									(set value (struct.get argument scalar))))))
					(set row (i32.inc row))))
			(return (call resolved_command_setting origin value first count))))

	(fn command_config_row
		(:doc "Translate a leaf rule's scope into its configured profile path.")
		(params (invocation CommandInvocation) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(scope u32) (rule i32))
		(returns i32)
		(body
			(let selected (struct.new ProjectRead (error 0u32) (start -1i32) (end -1i32)
				(default_profile (struct.get invocation default_profile)) (selected_profile (struct.get invocation selected_profile))))
			(let-mut section -1i32)
			(let-mut subsection -1i32)
			(if
				(:doc "Build fields come from the mode selected by argv.")
				(u32.eq scope 3u32)
				(then
					(set section 2i32)
					(set subsection (i32.add 9i32 (i32.from-u32 (struct.get invocation mode))))))
			(if
				(:doc "Compiler options live under cc.")
				(u32.eq scope 4u32)
				(then (set section 3i32)))
			(if
				(:doc "Entry rules hold the configured executable and library source lists.")
				(u32.eq scope 6u32)
				(then (set section 4i32)))
			(if
				(:doc "Formatter rules live together in fmt.")
				(u32.eq scope 7u32)
				(then (set section 5i32)))
			(return (call project_setting (borrow-shared nodes) (borrow-shared settings)
				selected section subsection rule))))

	(fn command_setting
		(:doc "Query one effective leaf by its project scope and rule, or a negative invocation control by rule.")
		(params (invocation CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (scope u32) (rule i32))
		(returns CommandSetting)
		(body
			(let cli (call command_argv_setting (borrow-shared arguments) (struct.get invocation rows) rule))
			(if
				(:doc "Explicit false, zero, and an empty override list are each present values.")
				(u32.eq (struct.get cli origin) 2u32)
				(then (return cli)))
			(let mode (struct.get invocation mode))
			(if
				(:doc "Only nonnegative project rule IDs participate in JSONC lookup.")
				(i32.not-ltz rule)
				(then
					(let row (call command_config_row invocation (borrow-shared nodes) (borrow-shared settings)
						scope rule))
					(if
						(:doc "A resolved config node still refers to the original source bytes.")
						(i32.not-ltz row)
						(then (return (call resolved_command_setting 1u32
							(struct.get (array.load settings row) scalar) row 0i32))))))
			(let-mut count 0i32)
			(if
				(:doc "Built-in optimization flags are a mode-dependent list.")
				(i32.eq rule 13i32)
				(then (set count (call project_default_cflags mode))))
			(return (call resolved_command_setting 3u32 (call project_default_scalar rule mode)
				-1i32 count)))))
