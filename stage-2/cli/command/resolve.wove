(module command_resolution
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve a supplied argv and optional JSONC into one typed command.

	Argv excludes the executable and starts with cc, bin, or fmt.
	With has_config false, config bytes and JSON scratch are ignored.
	Otherwise, nodes and settings receive the validated project document.
	Allocate at least argv length minus one CommandArgument rows.
	Only the reported rows from a successful invocation are usable.

	Diagnostics use source 1 for project JSONC byte spans and source 2
	for argv, as in the compiler option resolver. An unknown requested
	profile is argv code 11. Unused coordinates are -1. The mode is
	default, debug or release (0 to 2).

	Command settings use origin 1 for the config, 2 for argv, or 3 for
	built-in values. Explicit options take precedence over their profile
	settings. Repeated values are kept in argv order and replace the
	configured list; a clear switch also discards earlier occurrences.
	A setting's row points to the JSON node or first effective argv row.
	For argv lists, count is the number of matching rows to read starting
	at row. Interleaved options and operands retain their original positions.
	An explicit clear with no following item returns count zero and row -1.
	Built-in cflags can be read with write_default_cflag in config/defaults.
	When no explicit source operands are supplied, entry.bin and entry.lib
	can be resolved from project settings with scope 6.`)

	(use wove-file "../argv.wove" (only (type ArgSpan)))
	(use wove-file "./args.wove" (only (type CommandArgument) parse_command_args))
	(use wove-file "../../config/schema.wove" (only (type ProjectRule) project_rule_count project_key_bytes write_project_schema))
	(use wove-file "../../config/project.wove" (only (type ProjectRead) (type ProjectSetting) read_project_config project_setting))
	(use wove-file "../../config/defaults.wove" (only project_default_scalar project_default_cflags))
	(use wove-file "../../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../text/bytes.wove" (only same_bytes))

	(struct CommandInvocation
		(fields (source u32) (error u32) (argv_index i32) (rule i32) (start i32) (end i32)
			(command u32) (mode u32) (rows i32) (operands i32) (default_profile i32) (selected_profile i32)))
	(struct CommandSetting (fields (origin u32) (scalar u32) (row i32) (count i32)))

	(fn command_failure
		(:doc "Report an argv or JSONC failure without publishing a usable invocation.")
		(params (source u32) (error u32) (index i32) (rule i32) (start i32) (end i32))
		(returns CommandInvocation)
		(body (return (record.make CommandInvocation (source (local source)) (error (local error))
			(argv_index (local index)) (rule (local rule)) (start (local start)) (end (local end))
			(command 0u32) (mode 0u32) (rows 0i32) (operands 0i32)
			(default_profile -1i32) (selected_profile -1i32)))))

	(fn command_project
		(:doc "Use the profile named by argv; an absent project has only the built-in default profile.")
		(params (config (shared-slice u8)) (has_config bool) (requested (shared-slice u8))
			(nodes (mut-slice JsonNode)) (settings (mut-slice ProjectSetting))
			(names (shared-slice u8)) (rules (shared-slice ProjectRule)))
		(returns ProjectRead)
		(body
			(if
				(:doc "Validate all profiles and retain original key and value spans when project bytes were supplied.")
				(local has_config)
				(then (return (call read_project_config (borrow-shared (local config)) (borrow-shared (local requested))
					(borrow-mut (local nodes)) (borrow-mut (local settings))))))
			(let default_name (slice.load (local rules) 9i32))
			(let length (slice.len (local requested)))
			(let-mut error 0u32)
			(if
				(:doc "The canonical default spelling also works without a project file.")
				(bool.not (bool.or (i32.eq (local length) 0i32)
					(call same_bytes (borrow-shared (local names)) (record.get (local default_name) start)
						(record.get (local default_name) end) (borrow-shared (local requested)) 0i32 (local length))))
				(then (set (local error) 19u32)))
			(return (record.make ProjectRead (error (local error)) (start -1i32) (end -1i32)
				(default_profile -1i32) (selected_profile -1i32)))))

	(fn resolve_command
		(:doc "Resolve argv controls and validate the selected settings before returning the invocation.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (config (shared-slice u8)) (has_config bool)
			(nodes (mut-slice JsonNode)) (settings (mut-slice ProjectSetting)) (arguments (mut-slice CommandArgument)))
		(returns CommandInvocation)
		(body
			(let-mut names (array.alloc u8 (call project_key_bytes)))
			(let-mut rules (array.alloc ProjectRule (call project_rule_count)))
			(call write_project_schema (borrow-mut (local names)) (borrow-mut (local rules)))
			(let parsed (call parse_command_args (borrow-shared (local bytes)) (borrow-shared (local argv))
				(borrow-shared (local names)) (borrow-shared (local rules)) (borrow-mut (local arguments))))
			(let error (record.get (local parsed) error))
			(if
				(:doc "Unknown commands and invalid options are reported before inspecting the project.")
				(u32.lt 0u32 (local error))
				(then (return (call command_failure 2u32 (local error) (record.get (local parsed) argv_index)
					(record.get (local parsed) rule) -1i32 -1i32))))
			(let profile (record.get (local parsed) profile))
			(let-mut start 0i32)
			(let-mut end 0i32)
			(let-mut at -1i32)
			(if
				(:doc "Use the original argv byte span for either selector spelling.")
				(bool.not (i32.lt (local profile) 0i32))
				(then
					(let selector (slice.load (local arguments) (local profile)))
					(set (local start) (record.get (local selector) start))
					(set (local end) (record.get (local selector) end))
					(set (local at) (record.get (local selector) argv_index))))
			(let project (call command_project (borrow-shared (local config)) (local has_config)
				(borrow-shared (slice.range (local bytes) (local start) (local end)))
				(borrow-mut (local nodes)) (borrow-mut (local settings)) (borrow-shared (local names)) (borrow-shared (local rules))))
			(let config_error (record.get (local project) error))
			(if
				(:doc "A missing profile is a selector error at the supplied argv value.")
				(u32.eq (local config_error) 19u32)
				(then (return (call command_failure 2u32 11u32 (local at) -2i32 (local start) (local end)))))
			(if
				(:doc "Malformed project data keeps the JSONC diagnostic span.")
				(u32.lt 0u32 (local config_error))
				(then (return (call command_failure 1u32 (local config_error) -1i32 -1i32
					(record.get (local project) start) (record.get (local project) end)))))
			(return (record.make CommandInvocation (source 0u32) (error 0u32)
				(argv_index -1i32) (rule -1i32) (start -1i32) (end -1i32)
				(command (record.get (local parsed) command)) (mode (record.get (local parsed) mode))
				(rows (record.get (local parsed) rows)) (operands (record.get (local parsed) operands))
				(default_profile (record.get (local project) default_profile))
				(selected_profile (record.get (local project) selected_profile))))))

	(fn resolved_command_setting
		(:doc "Construct a typed value, its source row, and the count of effective argv occurrences.")
		(params (origin u32) (scalar u32) (row i32) (count i32))
		(returns CommandSetting)
		(body (return (record.make CommandSetting (origin (local origin)) (scalar (local scalar))
			(row (local row)) (count (local count))))))

	(fn command_argv_setting
		(:doc "Collect the explicit values for one rule, stopping inherited and earlier list items at a clear.")
		(params (arguments (shared-slice CommandArgument)) (rows i32) (rule i32))
		(returns CommandSetting)
		(body
			(let-mut origin 0u32)
			(let-mut first -1i32)
			(let-mut count 0i32)
			(let-mut value 0u32)
			(let-mut row 0i32)
			(while
				(:doc "Only occurrences matching the rule contribute to an explicit override.")
				(i32.lt (local row) (local rows))
				(body
					(let argument (slice.load (local arguments) (local row)))
					(if
						(:doc "A list reset is explicit even if there are no subsequent values.")
						(i32.eq (record.get (local argument) rule) (local rule))
						(then
							(set (local origin) 2u32)
							(if
								(:doc "A clear switch drops every earlier occurrence of the rule.")
								(u32.eq (record.get (local argument) form) 4u32)
								(then (set (local first) -1i32) (set (local count) 0i32))
								(else
									(if
										(:doc "Remember the first surviving occurrence in the ordered argv rows.")
										(i32.lt (local first) 0i32)
										(then (set (local first) (local row))))
									(set (local count) (i32.add.wrapping (local count) 1i32))
									(set (local value) (record.get (local argument) scalar))))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return (call resolved_command_setting (local origin) (local value) (local first) (local count)))))

	(fn command_config_row
		(:doc "Translate a leaf rule's scope into its configured profile path.")
		(params (invocation CommandInvocation) (nodes (shared-slice JsonNode)) (settings (shared-slice ProjectSetting))
			(scope u32) (rule i32))
		(returns i32)
		(body
			(let selected (record.make ProjectRead (error 0u32) (start -1i32) (end -1i32)
				(default_profile (record.get (local invocation) default_profile)) (selected_profile (record.get (local invocation) selected_profile))))
			(let-mut section -1i32)
			(let-mut subsection -1i32)
			(if
				(:doc "Build fields come from the mode selected by argv.")
				(u32.eq (local scope) 3u32)
				(then
					(set (local section) 2i32)
					(set (local subsection) (i32.add.wrapping 9i32 (int.convert i32 (record.get (local invocation) mode))))))
			(if
				(:doc "Compiler options and compiler warnings both live under cc.")
				(bool.or (u32.eq (local scope) 4u32) (u32.eq (local scope) 5u32))
				(then (set (local section) 3i32)))
			(if
				(:doc "The warning policy adds a subsection under the compiler options.")
				(u32.eq (local scope) 5u32)
				(then (set (local subsection) 25i32)))
			(if
				(:doc "Entry rules hold the configured executable and library source lists.")
				(u32.eq (local scope) 6u32)
				(then (set (local section) 4i32)))
			(if
				(:doc "Formatter rules live together in fmt.")
				(u32.eq (local scope) 7u32)
				(then (set (local section) 5i32)))
			(return (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local selected) (local section) (local subsection) (local rule)))))

	(fn command_setting
		(:doc "Query one effective leaf by its project scope and rule, or a negative invocation control by rule.")
		(params (invocation CommandInvocation) (arguments (shared-slice CommandArgument))
			(nodes (shared-slice JsonNode)) (settings (shared-slice ProjectSetting)) (scope u32) (rule i32))
		(returns CommandSetting)
		(body
			(let cli (call command_argv_setting (borrow-shared (local arguments)) (record.get (local invocation) rows) (local rule)))
			(if
				(:doc "Explicit false, zero, and an empty override list are each present values.")
				(u32.eq (record.get (local cli) origin) 2u32)
				(then (return (local cli))))
			(let mode (record.get (local invocation) mode))
			(if
				(:doc "Only nonnegative project rule IDs participate in JSONC lookup.")
				(bool.not (i32.lt (local rule) 0i32))
				(then
					(let row (call command_config_row (local invocation) (borrow-shared (local nodes)) (borrow-shared (local settings))
						(local scope) (local rule)))
					(if
						(:doc "A resolved config node still refers to the original source bytes.")
						(bool.not (i32.lt (local row) 0i32))
						(then (return (call resolved_command_setting 1u32
							(record.get (slice.load (local settings) (local row)) scalar) (local row) 0i32))))))
			(let-mut count 0i32)
			(if
				(:doc "Built-in optimization flags are a mode-dependent list.")
				(i32.eq (local rule) 13i32)
				(then (set (local count) (call project_default_cflags (local mode)))))
			(return (call resolved_command_setting 3u32 (call project_default_scalar (local rule) (local mode))
				-1i32 (local count))))))
