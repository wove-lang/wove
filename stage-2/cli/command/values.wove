(module command_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode command operands using the config schema's value kinds and bounds.")

	(use wove-file "../../config/project.wove" (only valid_project_name))
	(use wove-file "../../config/values.wove" (only project_word))
	(use wove-file "../../source/scan.wove" (only is_identifier_head))
	(use wove-file "../values.wove" (only argv_decimal))
	(use wove-file "./schema.wove" (only command_word))

	(struct CommandScalar (fields (valid bool) (value u32)))

	(fn command_scalar
		(:doc "Construct a decoded operand or a failed conversion.")
		(params (valid bool) (value u32))
		(returns CommandScalar)
		(body (return (struct.new CommandScalar (valid (local valid)) (value (local value))))))

	(fn decode_command_operand
		(:doc "Validate one named operand while keeping all text in the original argv byte arena.")
		(params (bytes (shared-array u8)) (start i32) (end i32) (rule i32) (kind u32))
		(returns CommandScalar)
		(body
			(if
				(:doc "Unsigned settings use the ordinary argv integer grammar.")
				(u32.eq (local kind) 3u32)
				(then
					(let number (call argv_decimal (borrow-shared (local bytes)) (local start) (local end) (bool false)))
					(return (call command_scalar (struct.get (local number) valid) (struct.get (local number) magnitude)))))
			(if
				(:doc "A profile selector is a nonempty name accepted by the config reader.")
				(u32.eq (local kind) 5u32)
				(then (return (call command_scalar (call valid_project_name
					(borrow-shared (array.range (local bytes) (local start) (local end)))
					(i32.sub.wrapping (local end) (local start))) 0u32))))
			(if
				(:doc "The compiler control chooses a native tool family.")
				(u32.eq (local kind) 17u32)
				(then
					(if
						(:doc "Clang is compiler zero.")
						(call command_word (borrow-shared (local bytes)) (local start) (local end) 8i32)
						(then (return (call command_scalar (bool true) 0u32))))
					(return (call command_scalar (call command_word (borrow-shared (local bytes))
						(local start) (local end) 9i32) 1u32))))
			(if
				(:doc "The user-facing enum values are shared with the project config reader.")
				(bool.or (u32.eq (local kind) 7u32) (u32.eq (local kind) 9u32))
				(then
					(let member (call project_word (local kind)
						(borrow-shared (array.range (local bytes) (local start) (local end)))
						(i32.sub.wrapping (local end) (local start))))
					(if
						(:doc "An unknown enum spelling has no typed value.")
						(i32.lt (local member) 0i32)
						(then (return (call command_scalar (bool false) 0u32))))
					(return (call command_scalar (bool true) (int.convert u32 (local member))))))
			(if
				(:doc "Both compiler and build definitions require a cfg identifier.")
				(bool.or (i32.eq (local rule) 14i32) (i32.eq (local rule) 21i32))
				(then (return (call command_scalar (call is_identifier_head (borrow-shared (local bytes))
					(local start) (local end)) 0u32))))
			(return (call command_scalar (bool.or (i32.lt (local start) (local end))
				(bool.or (i32.eq (local rule) 13i32) (i32.eq (local rule) 15i32))) 0u32)))))
