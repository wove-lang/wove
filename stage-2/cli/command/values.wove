(module command_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode command operands using the config schema's value kinds and bounds.")

	(use wove-file "../values.wove" (only argv_decimal))
	(use wove-file "../../config/project.wove" (only valid_project_name))
	(use wove-file "../../config/values.wove" (only project_word))
	(use wove-file "../../source/scan.wove" (only is_identifier_head))

	(struct CommandScalar (fields (valid bool) (value u32)))

	(fn command_scalar
		(:doc "Construct a decoded operand or a failed conversion.")
		(params (valid bool) (value u32))
		(returns CommandScalar)
		(body (return (CommandScalar.new (valid valid) (value value)))))

	(fn decode_command_operand
		(:doc "Validate one named operand while keeping all text in the original argv byte arena.")
		(params (bytes (shared-array u8)) (start i32) (end i32) (rule i32) (kind u32))
		(returns CommandScalar)
		(body
			(if
				(:doc "A profile selector is a nonempty name accepted by the config reader.")
				(kind.eq 5u32)
				(then (return (call command_scalar (call valid_project_name
					(borrow-shared (bytes.range start end))
					(end.sub start)) 0u32))))
			(if
				(:doc "A job count has the same unsigned range as the profile setting.")
				(kind.eq 3u32)
				(then
					(let parsed (call argv_decimal (borrow-shared bytes) start end (bool false)))
					(return (call command_scalar parsed/valid parsed/magnitude))))
			(if
				(:doc "The user-facing enum values are shared with the project config reader.")
				(bool:or (kind.eq 7u32) (kind.eq 9u32))
				(then
					(let member (call project_word kind
						(borrow-shared (bytes.range start end))
						(end.sub start)))
					(if
						(:doc "An unknown enum spelling has no typed value.")
						member.ltz
						(then (return (call command_scalar (bool false) 0u32))))
					(return (call command_scalar (bool true) (u32:from-i32 member)))))
			(if
				(:doc "Both compiler and build definitions require a cfg identifier.")
				(bool:or (rule.eq 14i32) (rule.eq 21i32))
				(then (return (call command_scalar (call is_identifier_head (borrow-shared bytes)
					start end (bool false)) 0u32))))
			(return (call command_scalar (bool:or (start.lt end)
				(bool:or (rule.eq 13i32) (rule.eq 15i32))) 0u32)))))
