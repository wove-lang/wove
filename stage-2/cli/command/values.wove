(module command_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode command operands using the config schema's value kinds and bounds.")

	(use wove-file "../../config/project.wove" (only valid_project_name))
	(use wove-file "../../config/values.wove" (only project_word add_import_category pack_import_category project_number_in_range))
	(use wove-file "../../source/scan.wove" (only is_identifier_head))
	(use wove-file "../values.wove" (only argv_decimal))
	(use wove-file "./schema.wove" (only command_word))

	(struct CommandScalar (fields (valid bool) (value u32)))

	(fn command_scalar
		(:doc "Construct a decoded operand or a failed conversion.")
		(params (valid bool) (value u32))
		(returns CommandScalar)
		(body (return (record.make CommandScalar (valid (local valid)) (value (local value))))))

	(fn command_import_order
		(:doc "Decode four distinct comma-separated import categories as four base-four digits.")
		(params (bytes (shared-slice u8)) (start i32) (end i32))
		(returns CommandScalar)
		(body
			(let-mut seen (array.alloc u8 4i32))
			(let-mut first (local start))
			(let-mut at (local start))
			(let-mut count 0i32)
			(let-mut packed 0u32)
			(while
				(:doc "Each iteration ends at a comma or one past the last category byte.")
				(bool true)
				(body
					(if
						(:doc "A comma or the input end finishes one full category.")
						(bool.or (i32.eq (local at) (local end)) (u8.eq (slice.load (local bytes) (local at)) 44u8))
						(then
							(let category (call project_word 12u32
								(borrow-shared (slice.range (local bytes) (local first) (local at)))
								(i32.sub.wrapping (local at) (local first))))
							(if
								(:doc "Unknown and repeated categories cannot define the import order.")
								(bool.not (call add_import_category (borrow-mut (local seen)) (local category)))
								(then (return (call command_scalar (bool false) 0u32))))
							(set (local packed) (call pack_import_category (local packed) (local category)))
							(set (local count) (i32.add.wrapping (local count) 1i32))
							(if
								(:doc "Exactly four categories are required before the operand is complete.")
								(i32.eq (local at) (local end))
								(then (return (call command_scalar (i32.eq (local count) 4i32) (local packed)))))
							(set (local first) (i32.add.wrapping (local at) 1i32))))
					(set (local at) (i32.add.wrapping (local at) 1i32))))
			(return (call command_scalar (bool false) 0u32))))

	(fn decode_command_operand
		(:doc "Validate one named operand while keeping all text in the original argv byte arena.")
		(params (bytes (shared-slice u8)) (start i32) (end i32) (rule i32) (kind u32))
		(returns CommandScalar)
		(body
			(if
				(:doc "Unsigned settings use the ordinary argv integer grammar and the schema bounds.")
				(bool.or (u32.eq (local kind) 3u32)
					(bool.or (u32.eq (local kind) 13u32) (u32.eq (local kind) 14u32)))
				(then
					(let number (call argv_decimal (borrow-shared (local bytes)) (local start) (local end) (bool false)))
					(let value (record.get (local number) magnitude))
					(return (call command_scalar (bool.and (record.get (local number) valid)
						(call project_number_in_range (local kind) (local value))) (local value)))))
			(if
				(:doc "A profile selector is a nonempty name accepted by the config reader.")
				(u32.eq (local kind) 5u32)
				(then (return (call command_scalar (call valid_project_name
					(borrow-shared (slice.range (local bytes) (local start) (local end)))
					(i32.sub.wrapping (local end) (local start))) 0u32))))
			(if
				(:doc "The compiler control chooses a native tool family.")
				(u32.eq (local kind) 17u32)
				(then
					(if
						(:doc "Clang is compiler zero.")
						(call command_word (borrow-shared (local bytes)) (local start) (local end) 10i32)
						(then (return (call command_scalar (bool true) 0u32))))
					(return (call command_scalar (call command_word (borrow-shared (local bytes))
						(local start) (local end) 11i32) 1u32))))
			(if
				(:doc "An explicit import-order operand is the full replacement order.")
				(u32.eq (local kind) 12u32)
				(then (return (call command_import_order (borrow-shared (local bytes)) (local start) (local end)))))
			(if
				(:doc "The user-facing enum values are shared with the project config reader.")
				(bool.or (u32.eq (local kind) 7u32)
					(bool.and (u32.lt 8u32 (local kind)) (u32.lt (local kind) 12u32)))
				(then
					(let member (call project_word (local kind)
						(borrow-shared (slice.range (local bytes) (local start) (local end)))
						(i32.sub.wrapping (local end) (local start))))
					(if
						(:doc "An unknown enum spelling has no typed value.")
						(i32.lt (local member) 0i32)
						(then (return (call command_scalar (bool false) 0u32))))
					(return (call command_scalar (bool true) (int.convert u32 (local member))))))
			(if
				(:doc "Both compiler and build definitions require a cfg identifier.")
				(bool.or (i32.eq (local rule) 14i32) (i32.eq (local rule) 22i32))
				(then (return (call command_scalar (call is_identifier_head (borrow-shared (local bytes))
					(local start) (local end)) 0u32))))
			(return (call command_scalar (bool.or (i32.lt (local start) (local end))
				(bool.or (i32.eq (local rule) 13i32) (i32.eq (local rule) 15i32))) 0u32)))))
