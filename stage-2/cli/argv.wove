(module typed_argv
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Parse a supplied argv against a typed option specification.

	Pass only the arguments to parse, excluding the executable name. ArgSpan
	rows delimit each argument in argv_bytes. Entries are considered in
	row order. Option names refer to a separate byte view without the
	leading dashes. All spans are half-open byte ranges.

	ArgSpec forms are 1 flag, 2 value-taking option, and 3 positional.
	Value kinds are 1 bool, 2 i32, 3 u32, and 4 text. Flags are boolean
	and accept --name or --no-name. Value-taking options accept --name=value
	or --name value. A following token beginning with -- requires the
	attached form if it is meant as text. A standalone -- ends option
	recognition. Positionals fill their specification rows in order. Named
	options are single-use, and each flag reserves both of its spellings.
	Boolean operands use true and false. Integers use decimal digits and
	an optional leading sign. A minus sign is available for i32 values.

	The first spec-length output rows correspond to the specification.
	An omitted row has present false. A supplied row carries its value
	kind and zero-based argv index, including when its value is false or
	zero. An operand's span refers to the original argv bytes. Bare flags have no
	value span, and omitted rows have no argv index or span.

	Error 1 is unknown option, 2 missing value, 3 invalid value, 4
	unexpected positional, 5 duplicate option, 6 invalid specification,
	7 invalid argv span, and 8 insufficient output rows. The result
	retains the relevant argv and spec indices, using -1 where inapplicable.
	Discard output rows after a failed parse.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./values.wove" (only argv_decimal argv_signed argv_boolean))

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct ArgSpec (fields (form u32) (value_kind u32) (name_start i32) (name_end i32)))
	(struct ArgValue
		(fields (present bool) (kind u32) (argv_index i32) (start i32) (end i32)
			(bool_value bool) (i32_value i32) (u32_value u32)))
	(struct ArgParseResult (fields (error u32) (argv_index i32) (spec_index i32)))
	(struct ArgSelection (fields (error u32) (spec_index i32) (argv_index i32) (start i32) (end i32) (flag i32)))

	(fn parse_result
		(:doc "Return a diagnostic with the relevant zero-based argv and specification indices.")
		(params (error u32) (argv_index i32) (spec_index i32))
		(returns ArgParseResult)
		(body (return (record.make ArgParseResult
			(error (local error)) (argv_index (local argv_index)) (spec_index (local spec_index))))))

	(fn valid_range
		(:doc "Recognize a valid half-open range before the parser reads its bytes.")
		(params (start i32) (end i32) (length i32))
		(returns bool)
		(body (return (bool.not (bool.or (i32.lt (local start) 0i32)
			(bool.or (i32.lt (local end) (local start)) (i32.lt (local length) (local end))))))))

	(fn option_name_end
		(:doc "Find the first equals delimiter or return the end of the span.")
		(params (bytes (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "Only bytes within the name or attached value are eligible delimiters.")
				(i32.lt (local cursor) (local end))
				(body
					(if
						(:doc "The first equals byte separates the name from its operand.")
						(u8.eq (slice.load (local bytes) (local cursor)) 61u8)
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(return (local end))))

	(fn has_no_prefix
		(:doc "Test the no- prefix that introduces a negative flag spelling.")
		(params (bytes (shared-slice u8)) (start i32) (end i32))
		(returns bool)
		(body
			(return (bool.and (bool.not (i32.lt (i32.sub.wrapping (local end) (local start)) 3i32))
				(bool.and (u8.eq (slice.load (local bytes) (local start)) 110u8)
					(bool.and (u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 1i32)) 111u8)
						(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 2i32)) 45u8)))))))

	(fn find_named
		(:doc "Match a name against already checked named specifications before limit.")
		(params (names (shared-slice u8)) (specs (shared-slice ArgSpec)) (limit i32)
			(bytes (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Only named specifications participate in exact lookup.")
				(i32.lt (local row) (local limit))
				(body
					(let spec (slice.load (local specs) (local row)))
					(if
						(:doc "Positional rows carry no name span.")
						(bool.and (bool.not (u32.eq (record.get (local spec) form) 3u32))
							(call same_bytes (borrow-shared (local names)) (record.get (local spec) name_start)
								(record.get (local spec) name_end) (borrow-shared (local bytes)) (local start) (local end)))
						(then (return (local row))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return -1i32)))

	(fn has_negative_collision
		(:doc "Reject named spellings that collide with a prior flag's generated no- name, or vice versa.")
		(params (names (shared-slice u8)) (specs (shared-slice ArgSpec)) (row i32) (spec ArgSpec))
		(returns bool)
		(body
			(let start (record.get (local spec) name_start))
			(let end (record.get (local spec) name_end))
			(let flag (u32.eq (record.get (local spec) form) 1u32))
			(let prefixed (call has_no_prefix (borrow-shared (local names)) (local start) (local end)))
			(let-mut prior 0i32)
			(while
				(:doc "Each earlier row has a validated kind and name span.")
				(i32.lt (local prior) (local row))
				(body
					(let previous (slice.load (local specs) (local prior)))
					(let form (record.get (local previous) form))
					(let left (record.get (local previous) name_start))
					(let right (record.get (local previous) name_end))
					(if
						(:doc "Strip the current row's prefix when the earlier row is a flag.")
						(bool.and (bool.and (local prefixed) (u32.eq (local form) 1u32))
							(call same_bytes (borrow-shared (local names)) (local left) (local right)
								(borrow-shared (local names)) (i32.add.wrapping (local start) 3i32) (local end)))
						(then (return (bool true))))
					(if
						(:doc "A newly declared flag can also reserve an earlier row's spelling.")
						(bool.and (bool.and (local flag) (bool.not (u32.eq (local form) 3u32)))
							(bool.and (call has_no_prefix (borrow-shared (local names)) (local left) (local right))
								(call same_bytes (borrow-shared (local names)) (i32.add.wrapping (local left) 3i32) (local right)
									(borrow-shared (local names)) (local start) (local end))))
						(then (return (bool true))))
					(set (local prior) (i32.add.wrapping (local prior) 1i32))))
			(return (bool false))))

	(fn check_specs
		(:doc "Return the first malformed or ambiguous specification row, or -1.")
		(params (names (shared-slice u8)) (specs (shared-slice ArgSpec)))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Validate each row before using its kind or name in a subsequent lookup.")
				(i32.lt (local row) (slice.len (local specs)))
				(body
					(let spec (slice.load (local specs) (local row)))
					(let form (record.get (local spec) form))
					(let kind (record.get (local spec) value_kind))
					(if
						(:doc "All forms and types need valid discriminants, and flags carry booleans.")
						(bool.or
							(bool.or (bool.or (u32.eq (local form) 0u32) (u32.lt 3u32 (local form)))
								(bool.or (u32.eq (local kind) 0u32) (u32.lt 4u32 (local kind))))
							(bool.and (u32.eq (local form) 1u32) (bool.not (u32.eq (local kind) 1u32))))
						(then (return (local row))))
					(if
						(:doc "Named rows need a nonempty, unique spelling free of the attached-value delimiter.")
						(bool.not (u32.eq (local form) 3u32))
						(then
							(let start (record.get (local spec) name_start))
							(let end (record.get (local spec) name_end))
							(if
								(:doc "Check the range before comparing its bytes.")
								(bool.or (i32.eq (local start) (local end))
									(bool.not (call valid_range (local start) (local end) (slice.len (local names)))))
								(then (return (local row))))
							(if
								(:doc "Both direct names and generated negative flag spellings must be unambiguous.")
								(bool.or
									(bool.not (i32.eq (call option_name_end (borrow-shared (local names)) (local start) (local end)) (local end)))
									(bool.or
										(bool.not (i32.lt (call find_named (borrow-shared (local names)) (borrow-shared (local specs))
											(local row) (borrow-shared (local names)) (local start) (local end)) 0i32))
										(call has_negative_collision (borrow-shared (local names)) (borrow-shared (local specs)) (local row) (local spec))))
								(then (return (local row))))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return -1i32)))

	(fn check_argv
		(:doc "Return the first argv row outside the byte arena, or -1.")
		(params (argv (shared-slice ArgSpan)) (length i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Each argument may be empty and has its own checked byte span.")
				(i32.lt (local index) (slice.len (local argv)))
				(body
					(let span (slice.load (local argv) (local index)))
					(if
						(:doc "An invalid row cannot be used for option matching or lookahead.")
						(bool.not (call valid_range (record.get (local span) start) (record.get (local span) end) (local length)))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return -1i32)))

	(fn has_option_prefix
		(:doc "Recognize the prefix used by long options and the end-of-options marker.")
		(params (bytes (shared-slice u8)) (span ArgSpan))
		(returns bool)
		(body
			(let start (record.get (local span) start))
			(let width (i32.sub.wrapping (record.get (local span) end) (local start)))
			(return (bool.and (bool.not (i32.lt (local width) 2i32))
				(bool.and (u8.eq (slice.load (local bytes) (local start)) 45u8)
					(u8.eq (slice.load (local bytes) (i32.add.wrapping (local start) 1i32)) 45u8))))))

	(fn selection
		(:doc "Keep the selected specification, typed value span, or detail of an argv error.")
		(params (error u32) (row i32) (index i32) (start i32) (end i32) (flag i32))
		(returns ArgSelection)
		(body (return (record.make ArgSelection (error (local error)) (spec_index (local row))
			(argv_index (local index)) (start (local start)) (end (local end)) (flag (local flag))))))

	(fn select_named
		(:doc "Find a named option and choose an attached, following, or implicit flag value.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (names (shared-slice u8))
			(specs (shared-slice ArgSpec)) (index i32) (span ArgSpan))
		(returns ArgSelection)
		(body
			(let start (i32.add.wrapping (record.get (local span) start) 2i32))
			(let end (record.get (local span) end))
			(let name_end (call option_name_end (borrow-shared (local bytes)) (local start) (local end)))
			(let-mut row (call find_named (borrow-shared (local names)) (borrow-shared (local specs))
				(slice.len (local specs)) (borrow-shared (local bytes)) (local start) (local name_end)))
			(let-mut flag 1i32)
			(if
				(:doc "An otherwise unmatched no- spelling can select the corresponding flag.")
				(bool.and (i32.lt (local row) 0i32)
					(call has_no_prefix (borrow-shared (local bytes)) (local start) (local name_end)))
				(then
					(let base (call find_named (borrow-shared (local names)) (borrow-shared (local specs))
						(slice.len (local specs)) (borrow-shared (local bytes))
						(i32.add.wrapping (local start) 3i32) (local name_end)))
					(if
						(:doc "Load a spec only when the base spelling exists.")
						(bool.not (i32.lt (local base) 0i32))
						(then
							(let spec (slice.load (local specs) (local base)))
							(if
								(:doc "Only flags define an implicit negative spelling.")
								(u32.eq (record.get (local spec) form) 1u32)
								(then (set (local row) (local base)) (set (local flag) 0i32)))))))
			(if
				(:doc "Report the argv position even when no specification can be identified.")
				(i32.lt (local row) 0i32)
				(then (return (call selection 1u32 -1i32 (local index) -1i32 -1i32 -1i32))))
			(let spec (slice.load (local specs) (local row)))
			(let form (record.get (local spec) form))
			(let attached (i32.lt (local name_end) (local end)))
			(if
				(:doc "Flags use their positive or no- spelling with no value operand.")
				(u32.eq (local form) 1u32)
				(then
					(if
						(:doc "An equals sign gives a flag an invalid explicit operand.")
						(local attached)
						(then (return (call selection 3u32 (local row) (local index) -1i32 -1i32 -1i32))))
					(return (call selection 0u32 (local row) (local index) -1i32 -1i32 (local flag)))))
			(if
				(:doc "An equals delimiter supplies the remainder of the same argument, including an empty value.")
				(local attached)
				(then (return (call selection 0u32 (local row) (local index)
					(i32.add.wrapping (local name_end) 1i32) (local end) -1i32))))
			(let next (i32.add.wrapping (local index) 1i32))
			(if
				(:doc "A named option consumes a separate value only before the next long option or marker.")
				(bool.or (i32.eq (local next) (slice.len (local argv)))
					(call has_option_prefix (borrow-shared (local bytes)) (slice.load (local argv) (local next))))
				(then (return (call selection 2u32 (local row) (local index) -1i32 -1i32 -1i32))))
			(let value (slice.load (local argv) (local next)))
			(return (call selection 0u32 (local row) (local next)
				(record.get (local value) start) (record.get (local value) end) -1i32))))

	(fn select_positional
		(:doc "Select the next positional row in specification order.")
		(params (specs (shared-slice ArgSpec)) (start i32) (index i32) (span ArgSpan))
		(returns ArgSelection)
		(body
			(let-mut row (local start))
			(while
				(:doc "Named rows may be interleaved with positionals in the table.")
				(i32.lt (local row) (slice.len (local specs)))
				(body
					(let spec (slice.load (local specs) (local row)))
					(if
						(:doc "The first remaining positional receives this argument's whole span.")
						(u32.eq (record.get (local spec) form) 3u32)
						(then (return (call selection 0u32 (local row) (local index)
							(record.get (local span) start) (record.get (local span) end) -1i32))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return (call selection 4u32 -1i32 (local index) -1i32 -1i32 -1i32))))

	(fn select_argument
		(:doc "Select a named option when recognition is enabled, or take the next positional.")
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (names (shared-slice u8))
			(specs (shared-slice ArgSpec)) (index i32) (span ArgSpan) (named bool) (positional i32))
		(returns ArgSelection)
		(body
			(if
				(:doc "The parser has already consumed standalone end-of-options markers.")
				(local named)
				(then (return (call select_named (borrow-shared (local bytes)) (borrow-shared (local argv))
					(borrow-shared (local names)) (borrow-shared (local specs)) (local index) (local span)))))
			(return (call select_positional (borrow-shared (local specs)) (local positional) (local index) (local span)))))

	(fn absent_value
		(:doc "Initialize an omitted row while preserving its declared value kind.")
		(params (kind u32))
		(returns ArgValue)
		(body (return (record.make ArgValue (present (bool false)) (kind (local kind))
			(argv_index -1i32) (start -1i32) (end -1i32)
			(bool_value (bool false)) (i32_value 0i32) (u32_value 0u32)))))

	(fn decode_value
		(:doc "Decode a selected value and mark presence independently of its value.")
		(params (bytes (shared-slice u8)) (selected ArgSelection) (kind u32))
		(returns ArgValue)
		(body
			(let start (record.get (local selected) start))
			(let end (record.get (local selected) end))
			(let-mut boolean (bool false))
			(let-mut signed_word 0i32)
			(let-mut unsigned_word 0u32)
			(if
				(:doc "Boolean values come from a flag spelling or an exact true or false operand.")
				(u32.eq (local kind) 1u32)
				(then
					(let-mut value (record.get (local selected) flag))
					(if
						(:doc "A boolean option or positional has a textual operand.")
						(i32.lt (local value) 0i32)
						(then (set (local value) (call argv_boolean (borrow-shared (local bytes)) (local start) (local end)))))
					(if
						(:doc "Invalid conversions yield an absent result for the parser to report.")
						(i32.lt (local value) 0i32)
						(then (return (call absent_value (local kind)))))
					(set (local boolean) (i32.eq (local value) 1i32))))
			(if
				(:doc "Numeric values must fit the declared integer width before conversion.")
				(bool.or (u32.eq (local kind) 2u32) (u32.eq (local kind) 3u32))
				(then
					(let signed (u32.eq (local kind) 2u32))
					(let decimal (call argv_decimal (borrow-shared (local bytes)) (local start) (local end) (local signed)))
					(if
						(:doc "A malformed or overflowing integer has no typed value.")
						(bool.not (record.get (local decimal) valid))
						(then (return (call absent_value (local kind)))))
					(if
						(:doc "Store the converted number in the field selected by the declared value kind.")
						(local signed)
						(then (set (local signed_word) (call argv_signed (local decimal))))
						(else (set (local unsigned_word) (record.get (local decimal) magnitude))))))
			(return (record.make ArgValue (present (bool true)) (kind (local kind))
				(argv_index (record.get (local selected) argv_index)) (start (local start)) (end (local end))
				(bool_value (local boolean)) (i32_value (local signed_word)) (u32_value (local unsigned_word))))))

	(fn parse_argv
		(:doc "Parse the supplied argument rows into one typed presence row per specification.")
		(params (argv_bytes (shared-slice u8)) (argv (shared-slice ArgSpan)) (names (shared-slice u8))
			(specs (shared-slice ArgSpec)) (output (mut-slice ArgValue)))
		(returns ArgParseResult)
		(body
			(let size (slice.len (local specs)))
			(if
				(:doc "Check output capacity before initializing any rows.")
				(i32.lt (slice.len (local output)) (local size))
				(then (return (call parse_result 8u32 -1i32 -1i32))))
			(let bad_spec (call check_specs (borrow-shared (local names)) (borrow-shared (local specs))))
			(if
				(:doc "Specification errors refer to the table row rather than an argv token.")
				(bool.not (i32.lt (local bad_spec) 0i32))
				(then (return (call parse_result 6u32 -1i32 (local bad_spec)))))
			(let bad_argv (call check_argv (borrow-shared (local argv)) (slice.len (local argv_bytes))))
			(if
				(:doc "Validate all supplied spans before reading any argument or changing output.")
				(bool.not (i32.lt (local bad_argv) 0i32))
				(then (return (call parse_result 7u32 (local bad_argv) -1i32))))
			(let-mut row 0i32)
			(while
				(:doc "Initialize every result so omission survives subsequent parses into reused storage.")
				(i32.lt (local row) (local size))
				(body
					(let spec (slice.load (local specs) (local row)))
					(slice.store (local output) (local row) (call absent_value (record.get (local spec) value_kind)))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(let-mut index 0i32)
			(let-mut positional 0i32)
			(let-mut named_enabled (bool true))
			(while
				(:doc "Visit each unconsumed argument once. A separate option value advances the cursor twice.")
				(i32.lt (local index) (slice.len (local argv)))
				(body
					(let span (slice.load (local argv) (local index)))
					(let named (bool.and (local named_enabled) (call has_option_prefix (borrow-shared (local argv_bytes)) (local span))))
					(let width (i32.sub.wrapping (record.get (local span) end) (record.get (local span) start)))
					(if
						(:doc "The bare marker affects following arguments and occupies no output row.")
						(bool.and (local named) (i32.eq (local width) 2i32))
						(then (set (local named_enabled) (bool false)))
						(else
							(let selected (call select_argument (borrow-shared (local argv_bytes)) (borrow-shared (local argv))
								(borrow-shared (local names)) (borrow-shared (local specs)) (local index) (local span)
								(local named) (local positional)))
							(let spec_index (record.get (local selected) spec_index))
							(let value_index (record.get (local selected) argv_index))
							(let error (record.get (local selected) error))
							(if
								(:doc "Selection errors already carry the relevant argv position.")
								(u32.lt 0u32 (local error))
								(then (return (call parse_result (local error) (local value_index) (local spec_index)))))
							(let prior (slice.load (local output) (local spec_index)))
							(if
								(:doc "Positive and negative spellings of a flag both occupy the same output row.")
								(record.get (local prior) present)
								(then (return (call parse_result 5u32 (local index) (local spec_index)))))
							(let spec (slice.load (local specs) (local spec_index)))
							(let value (call decode_value (borrow-shared (local argv_bytes)) (local selected) (record.get (local spec) value_kind)))
							(if
								(:doc "An invalid separate value is diagnosed at its own argv row.")
								(bool.not (record.get (local value) present))
								(then (return (call parse_result 3u32 (local value_index) (local spec_index)))))
							(slice.store (local output) (local spec_index) (local value))
							(if
								(:doc "Only an accepted positional advances the positional specification cursor.")
								(u32.eq (record.get (local spec) form) 3u32)
								(then (set (local positional) (i32.add.wrapping (local spec_index) 1i32))))
							(set (local index) (local value_index))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (call parse_result 0u32 -1i32 -1i32)))))
