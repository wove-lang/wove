(module typed_argv
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Parse a supplied argv against a typed option specification.

	Pass only the arguments to parse, excluding the executable name. ArgSpan
	rows delimit each argument in argv_bytes. Entries are considered in
	row order. Option names refer to a separate byte view without the
	leading dashes. All spans are half-open byte ranges.

	ArgSpec forms are 1 flag, 2 value-taking option, and 3 positional.
	Value kinds are 1 bool, 2 i32, 3 u32, and 4 text. Flags are boolean
	and accept --name or --no-name. Value-taking options accept --name=value
	or --name value. A following token beginning with -- requires the
	attached form if it is meant as text. A standalone -- ends option
	recognition. Positionals fill their specification rows in order. Named
	options are single-use, and each flag reserves both of its spellings.
	Boolean operands use true and false. Integers use decimal digits and
	an optional leading sign. A minus sign is available for i32 values.

	The first spec-length output rows correspond to the specification.
	An omitted row has present false. A supplied row carries its value
	kind and zero-based argv index, including when its value is false or
	zero. An operand's span refers to the original argv bytes. Bare flags have no
	value span, and omitted rows have no argv index or span.

	Error 1 is unknown option, 2 missing value, 3 invalid value, 4
	unexpected positional, 5 duplicate option, 6 invalid specification,
	7 invalid argv span, and 8 insufficient output rows. The result
	retains the relevant argv and spec indices, using -1 where inapplicable.
	Discard output rows after a failed parse.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./values.wove" (only argv_decimal argv_signed argv_boolean))

	(struct ArgSpan (fields (start i32) (end i32)))
	(struct ArgSpec (fields (form u32) (value_kind u32) (name_start i32) (name_end i32)))
	(struct ArgValue
		(fields (present bool) (kind u32) (argv_index i32) (start i32) (end i32)
			(bool_value bool) (i32_value i32) (u32_value u32)))
	(struct ArgParseResult (fields (error u32) (argv_index i32) (spec_index i32)))
	(struct ArgSelection (fields (error u32) (spec_index i32) (argv_index i32) (start i32) (end i32) (flag i32)))

	(fn parse_result
		(:doc "Return a diagnostic with the relevant zero-based argv and specification indices.")
		(params (error u32) (argv_index i32) (spec_index i32))
		(returns ArgParseResult)
		(body (return (struct:new ArgParseResult
			(error error) (argv_index argv_index) (spec_index spec_index)))))

	(fn valid_range
		(:doc "Recognize a valid half-open range before the parser reads its bytes.")
		(params (start i32) (end i32) (length i32))
		(returns bool)
		(body (return (bool:not (bool:or (i32:ltz start)
			(bool:or (i32:lt end start) (i32:lt length end)))))))

	(fn option_name_end
		(:doc "Find the first equals delimiter or return the end of the span.")
		(params (bytes (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "Only bytes within the name or attached value are eligible delimiters.")
				(i32:lt cursor end)
				(body
					(if
						(:doc "The first equals byte separates the name from its operand.")
						(u8:eq (array:load bytes cursor) 61u8)
						(then (return cursor)))
					(set cursor (i32:inc cursor))))
			(return end)))

	(fn has_no_prefix
		(:doc "Test the no- prefix that introduces a negative flag spelling.")
		(params (bytes (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(return (bool:and (i32:not-lt (i32:sub end start) 3i32)
				(bool:and (u8:eq (array:load bytes start) 110u8)
					(bool:and (u8:eq (array:load bytes (i32:inc start)) 111u8)
						(u8:eq (array:load bytes (i32:add start 2i32)) 45u8)))))))

	(fn find_named
		(:doc "Match a name against already checked named specifications before limit.")
		(params (names (shared-array u8)) (specs (shared-array ArgSpec)) (limit i32)
			(bytes (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Only named specifications participate in exact lookup.")
				(i32:lt row limit)
				(body
					(let spec (array:load specs row))
					(if
						(:doc "Positional rows carry no name span.")
						(bool:and (u32:not-eq (struct:get spec form) 3u32)
							(call same_bytes (borrow-shared names) (struct:get spec name_start)
								(struct:get spec name_end) (borrow-shared bytes) start end))
						(then (return row)))
					(set row (i32:inc row))))
			(return -1i32)))

	(fn has_negative_collision
		(:doc "Reject named spellings that collide with a prior flag's generated no- name, or vice versa.")
		(params (names (shared-array u8)) (specs (shared-array ArgSpec)) (row i32) (spec ArgSpec))
		(returns bool)
		(body
			(let start (struct:get spec name_start))
			(let end (struct:get spec name_end))
			(let flag (u32:eq (struct:get spec form) 1u32))
			(let prefixed (call has_no_prefix (borrow-shared names) start end))
			(let-mut prior 0i32)
			(while
				(:doc "Each earlier row has a validated kind and name span.")
				(i32:lt prior row)
				(body
					(let previous (array:load specs prior))
					(let form (struct:get previous form))
					(let left (struct:get previous name_start))
					(let right (struct:get previous name_end))
					(if
						(:doc "Strip the current row's prefix when the earlier row is a flag.")
						(bool:and (bool:and prefixed (u32:eq form 1u32))
							(call same_bytes (borrow-shared names) left right
								(borrow-shared names) (i32:add start 3i32) end))
						(then (return (bool true))))
					(if
						(:doc "A newly declared flag can also reserve an earlier row's spelling.")
						(bool:and (bool:and flag (u32:not-eq form 3u32))
							(bool:and (call has_no_prefix (borrow-shared names) left right)
								(call same_bytes (borrow-shared names) (i32:add left 3i32) right
									(borrow-shared names) start end)))
						(then (return (bool true))))
					(set prior (i32:inc prior))))
			(return (bool false))))

	(fn check_specs
		(:doc "Return the first malformed or ambiguous specification row, or -1.")
		(params (names (shared-array u8)) (specs (shared-array ArgSpec)))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Validate each row before using its kind or name in a subsequent lookup.")
				(i32:lt row (array:len specs))
				(body
					(let spec (array:load specs row))
					(let form (struct:get spec form))
					(let kind (struct:get spec value_kind))
					(if
						(:doc "All forms and types need valid discriminants, and flags carry booleans.")
						(bool:or
							(bool:or (bool:or (u32:eqz form) (u32:lt 3u32 form))
								(bool:or (u32:eqz kind) (u32:lt 4u32 kind)))
							(bool:and (u32:eq form 1u32) (u32:not-eq kind 1u32)))
						(then (return row)))
					(if
						(:doc "Named rows need a nonempty, unique spelling free of the attached-value delimiter.")
						(u32:not-eq form 3u32)
						(then
							(let start (struct:get spec name_start))
							(let end (struct:get spec name_end))
							(if
								(:doc "Check the range before comparing its bytes.")
								(bool:or (i32:eq start end)
									(bool:not (call valid_range start end (array:len names))))
								(then (return row)))
							(if
								(:doc "Both direct names and generated negative flag spellings must be unambiguous.")
								(bool:or
									(i32:not-eq (call option_name_end (borrow-shared names) start end) end)
									(bool:or
										(i32:not-ltz (call find_named (borrow-shared names) (borrow-shared specs)
											row (borrow-shared names) start end))
										(call has_negative_collision (borrow-shared names) (borrow-shared specs) row spec)))
								(then (return row)))))
					(set row (i32:inc row))))
			(return -1i32)))

	(fn check_argv
		(:doc "Return the first argv row outside the byte arena, or -1.")
		(params (argv (shared-array ArgSpan)) (length i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Each argument may be empty and has its own checked byte span.")
				(i32:lt index (array:len argv))
				(body
					(let span (array:load argv index))
					(if
						(:doc "An invalid row cannot be used for option matching or lookahead.")
						(bool:not (call valid_range (struct:get span start) (struct:get span end) length))
						(then (return index)))
					(set index (i32:inc index))))
			(return -1i32)))

	(fn has_option_prefix
		(:doc "Recognize the prefix used by long options and the end-of-options marker.")
		(params (bytes (shared-array u8)) (span ArgSpan))
		(returns bool)
		(body
			(let start (struct:get span start))
			(let width (i32:sub (struct:get span end) start))
			(return (bool:and (i32:not-lt width 2i32)
				(bool:and (u8:eq (array:load bytes start) 45u8)
					(u8:eq (array:load bytes (i32:inc start)) 45u8))))))

	(fn selection
		(:doc "Keep the selected specification, typed value span, or detail of an argv error.")
		(params (error u32) (row i32) (index i32) (start i32) (end i32) (flag i32))
		(returns ArgSelection)
		(body (return (struct:new ArgSelection (error error) (spec_index row)
			(argv_index index) (start start) (end end) (flag flag)))))

	(fn select_named
		(:doc "Find a named option and choose an attached, following, or implicit flag value.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (names (shared-array u8))
			(specs (shared-array ArgSpec)) (index i32) (span ArgSpan))
		(returns ArgSelection)
		(body
			(let start (i32:add (struct:get span start) 2i32))
			(let end (struct:get span end))
			(let name_end (call option_name_end (borrow-shared bytes) start end))
			(let-mut row (call find_named (borrow-shared names) (borrow-shared specs)
				(array:len specs) (borrow-shared bytes) start name_end))
			(let-mut flag 1i32)
			(if
				(:doc "An otherwise unmatched no- spelling can select the corresponding flag.")
				(bool:and (i32:ltz row)
					(call has_no_prefix (borrow-shared bytes) start name_end))
				(then
					(let base (call find_named (borrow-shared names) (borrow-shared specs)
						(array:len specs) (borrow-shared bytes)
						(i32:add start 3i32) name_end))
					(if
						(:doc "Load a spec only when the base spelling exists.")
						(i32:not-ltz base)
						(then
							(let spec (array:load specs base))
							(if
								(:doc "Only flags define an implicit negative spelling.")
								(u32:eq (struct:get spec form) 1u32)
								(then (set row base) (set flag 0i32)))))))
			(if
				(:doc "Report the argv position even when no specification can be identified.")
				(i32:ltz row)
				(then (return (call selection 1u32 -1i32 index -1i32 -1i32 -1i32))))
			(let spec (array:load specs row))
			(let form (struct:get spec form))
			(let attached (i32:lt name_end end))
			(if
				(:doc "Flags use their positive or no- spelling with no value operand.")
				(u32:eq form 1u32)
				(then
					(if
						(:doc "An equals sign gives a flag an invalid explicit operand.")
						attached
						(then (return (call selection 3u32 row index -1i32 -1i32 -1i32))))
					(return (call selection 0u32 row index -1i32 -1i32 flag))))
			(if
				(:doc "An equals delimiter supplies the remainder of the same argument, including an empty value.")
				attached
				(then (return (call selection 0u32 row index
					(i32:inc name_end) end -1i32))))
			(let next (i32:inc index))
			(if
				(:doc "A named option consumes a separate value only before the next long option or marker.")
				(bool:or (i32:eq next (array:len argv))
					(call has_option_prefix (borrow-shared bytes) (array:load argv next)))
				(then (return (call selection 2u32 row index -1i32 -1i32 -1i32))))
			(let value (array:load argv next))
			(return (call selection 0u32 row next
				(struct:get value start) (struct:get value end) -1i32))))

	(fn select_positional
		(:doc "Select the next positional row in specification order.")
		(params (specs (shared-array ArgSpec)) (start i32) (index i32) (span ArgSpan))
		(returns ArgSelection)
		(body
			(let-mut row start)
			(while
				(:doc "Named rows may be interleaved with positionals in the table.")
				(i32:lt row (array:len specs))
				(body
					(let spec (array:load specs row))
					(if
						(:doc "The first remaining positional receives this argument's whole span.")
						(u32:eq (struct:get spec form) 3u32)
						(then (return (call selection 0u32 row index
							(struct:get span start) (struct:get span end) -1i32))))
					(set row (i32:inc row))))
			(return (call selection 4u32 -1i32 index -1i32 -1i32 -1i32))))

	(fn select_argument
		(:doc "Select a named option when recognition is enabled, or take the next positional.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)) (names (shared-array u8))
			(specs (shared-array ArgSpec)) (index i32) (span ArgSpan) (named bool) (positional i32))
		(returns ArgSelection)
		(body
			(if
				(:doc "The parser has already consumed standalone end-of-options markers.")
				named
				(then (return (call select_named (borrow-shared bytes) (borrow-shared argv)
					(borrow-shared names) (borrow-shared specs) index span))))
			(return (call select_positional (borrow-shared specs) positional index span))))

	(fn absent_value
		(:doc "Initialize an omitted row while preserving its declared value kind.")
		(params (kind u32))
		(returns ArgValue)
		(body (return (struct:new ArgValue (present (bool false)) (kind kind)
			(argv_index -1i32) (start -1i32) (end -1i32)
			(bool_value (bool false)) (i32_value 0i32) (u32_value 0u32)))))

	(fn decode_value
		(:doc "Decode a selected value and mark presence independently of its value.")
		(params (bytes (shared-array u8)) (selected ArgSelection) (kind u32))
		(returns ArgValue)
		(body
			(let start (struct:get selected start))
			(let end (struct:get selected end))
			(let-mut boolean (bool false))
			(let-mut signed_word 0i32)
			(let-mut unsigned_word 0u32)
			(if
				(:doc "Boolean values come from a flag spelling or an exact true or false operand.")
				(u32:eq kind 1u32)
				(then
					(let-mut value (struct:get selected flag))
					(if
						(:doc "A boolean option or positional has a textual operand.")
						(i32:ltz value)
						(then (set value (call argv_boolean (borrow-shared bytes) start end))))
					(if
						(:doc "Invalid conversions yield an absent result for the parser to report.")
						(i32:ltz value)
						(then (return (call absent_value kind))))
					(set boolean (i32:eq value 1i32))))
			(if
				(:doc "Numeric values must fit the declared integer width before conversion.")
				(bool:or (u32:eq kind 2u32) (u32:eq kind 3u32))
				(then
					(let signed (u32:eq kind 2u32))
					(let decimal (call argv_decimal (borrow-shared bytes) start end signed))
					(if
						(:doc "A malformed or overflowing integer has no typed value.")
						(bool:not (struct:get decimal valid))
						(then (return (call absent_value kind))))
					(if
						(:doc "Store the converted number in the field selected by the declared value kind.")
						signed
						(then (set signed_word (call argv_signed decimal)))
						(else (set unsigned_word (struct:get decimal magnitude))))))
			(return (struct:new ArgValue (present (bool true)) (kind kind)
				(argv_index (struct:get selected argv_index)) (start start) (end end)
				(bool_value boolean) (i32_value signed_word) (u32_value unsigned_word)))))

	(fn parse_argv
		(:doc "Parse the supplied argument rows into one typed presence row per specification.")
		(params (argv_bytes (shared-array u8)) (argv (shared-array ArgSpan)) (names (shared-array u8))
			(specs (shared-array ArgSpec)) (output (mut-array ArgValue)))
		(returns ArgParseResult)
		(body
			(let size (array:len specs))
			(if
				(:doc "Check output capacity before initializing any rows.")
				(i32:lt (array:len output) size)
				(then (return (call parse_result 8u32 -1i32 -1i32))))
			(let bad_spec (call check_specs (borrow-shared names) (borrow-shared specs)))
			(if
				(:doc "Specification errors refer to the table row rather than an argv token.")
				(i32:not-ltz bad_spec)
				(then (return (call parse_result 6u32 -1i32 bad_spec))))
			(let bad_argv (call check_argv (borrow-shared argv) (array:len argv_bytes)))
			(if
				(:doc "Validate all supplied spans before reading any argument or changing output.")
				(i32:not-ltz bad_argv)
				(then (return (call parse_result 7u32 bad_argv -1i32))))
			(let-mut row 0i32)
			(while
				(:doc "Initialize every result so omission survives subsequent parses into reused storage.")
				(i32:lt row size)
				(body
					(let spec (array:load specs row))
					(array:store output row (call absent_value (struct:get spec value_kind)))
					(set row (i32:inc row))))
			(let-mut index 0i32)
			(let-mut positional 0i32)
			(let-mut named_enabled (bool true))
			(while
				(:doc "Visit each unconsumed argument once. A separate option value advances the cursor twice.")
				(i32:lt index (array:len argv))
				(body
					(let span (array:load argv index))
					(let named (bool:and named_enabled (call has_option_prefix (borrow-shared argv_bytes) span)))
					(let width (i32:sub (struct:get span end) (struct:get span start)))
					(if
						(:doc "The bare marker affects following arguments and occupies no output row.")
						(bool:and named (i32:eq width 2i32))
						(then (set named_enabled (bool false)))
						(else
							(let selected (call select_argument (borrow-shared argv_bytes) (borrow-shared argv)
								(borrow-shared names) (borrow-shared specs) index span
								named positional))
							(let spec_index (struct:get selected spec_index))
							(let value_index (struct:get selected argv_index))
							(let error (struct:get selected error))
							(if
								(:doc "Selection errors already carry the relevant argv position.")
								(u32:gtz error)
								(then (return (call parse_result error value_index spec_index))))
							(let prior (array:load output spec_index))
							(if
								(:doc "Positive and negative spellings of a flag both occupy the same output row.")
								(struct:get prior present)
								(then (return (call parse_result 5u32 index spec_index))))
							(let spec (array:load specs spec_index))
							(let value (call decode_value (borrow-shared argv_bytes) selected (struct:get spec value_kind)))
							(if
								(:doc "An invalid separate value is diagnosed at its own argv row.")
								(bool:not (struct:get value present))
								(then (return (call parse_result 3u32 value_index spec_index))))
							(array:store output spec_index value)
							(if
								(:doc "Only an accepted positional advances the positional specification cursor.")
								(u32:eq (struct:get spec form) 3u32)
								(then (set positional (i32:inc spec_index))))
							(set index value_index)))
					(set index (i32:inc index))))
			(return (call parse_result 0u32 -1i32 -1i32)))))
