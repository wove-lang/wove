(module native_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write bounded byte views through the borrowed native standard streams.")

	(use c-header "<stdio.h>" (only fwrite fflush fputc (type Size) (value stdout) (value stderr)))

	(fn write_stdout
		(:doc "Write every supplied byte, then flush stdout so the caller can report write failures.")
		(params (bytes (shared-array u8))) (returns bool)
		(body
			(let width (u64.from-i32 (array.len bytes)))
			(let written (int.convert u64 (call fwrite (borrow-shared bytes)
				(int.convert Size 1i32) (int.convert Size width) stdout)))
			(return (bool.and (u64.eq written width)
				(i32.eqz (call fflush stdout))))))

	(fn write_stderr_line
		(:doc "Terminate a complete stderr record with a single LF and report a failed write.")
		(params (bytes (shared-array u8))) (returns bool)
		(body
			(let width (u64.from-i32 (array.len bytes)))
			(let written (int.convert u64 (call fwrite (borrow-shared bytes)
				(int.convert Size 1i32) (int.convert Size width) stderr)))
			(return (bool.and (u64.eq written width)
				(i32.eq (call fputc 10i32 stderr) 10i32))))))
