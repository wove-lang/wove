(module process_capture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Run one tool with an explicit argument vector and bounded stdout capture.

	The executable becomes argv[0]. The argument view contains zero or more
	user arguments, each terminated by one NUL byte. Consecutive terminators
	preserve empty arguments. A name without a slash is resolved through PATH.

	The caller owns the output view. Only its populated prefix changes.
	Stderr and stdin are inherited, and the tool is reaped before return.`)

	(use wove-file "./capture/descriptors.wove" (only open_capture_descriptors))
	(use wove-file "./capture/child.wove" (only spawn_capture_child reap_capture_child))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use c-header "<errno.h>" (only errno EINTR))
	(use c-header "<unistd.h>" (only read close (type Size)))

	(struct ProcessCapture
		(:doc `The status is the exit code, 128 plus the terminating signal, or -1 on host failure.`)
		(fields (status i32) (length i32) (overflow bool)))

	(struct CaptureDrain (fields (ok bool) (length i32) (overflow bool)))

	(fn capture_failure
		(:doc `Report a failure before a child or captured prefix exists.`)
		(params) (returns ProcessCapture)
		(body (return (ProcessCapture.new (status -1i32) (length 0i32) (overflow (bool false))))))

	(fn valid_program
		(:doc `Reject empty program names and embedded NUL bytes before calling C.`)
		(params (program (shared-array u8))) (returns bool)
		(body
			(let length program.len)
			(let-mut index 0i32)
			(while
				(:doc "An embedded NUL would change the executable name seen by C.")
				(index.lt length)
				(body
					(if
						(:doc "Reject the invalid program with a host failure status instead of a bridge trap.")
						(u8:eqz (program.get index))
						(then (return (bool false))))
					(set index index.inc)))
			(return length.gtz)))

	(fn count_arguments
		(:doc `Count argv[0] and each terminated user argument, including each empty row.`)
		(params (packed (shared-array u8))) (returns i32)
		(body
			(let length packed.len)
			(if
				(:doc "An empty packed view represents no user arguments.")
				length.eqz
				(then (return 1i32)))
			(if
				(:doc "Every nonempty packed view must end with its final argument's terminator.")
				(u8:not-eqz (packed.get length.dec))
				(then (return -1i32)))
			(let-mut index 0i32)
			(let-mut count 1i32)
			(while
				(:doc "Count separators without changing any embedded UTF-8 or raw argument bytes.")
				(index.lt length)
				(body
					(if
						(:doc "Each NUL ends a row, including when consecutive NUL bytes occur.")
						(u8:eqz (packed.get index))
						(then
							(if
								(:doc "The argument owners must fit in a signed-length Wove array.")
								(count.eq 2147483647i32)
								(then (return -1i32)))
							(set count count.inc)))
					(set index index.inc)))
			(return count)))

	(fn copy_argument
		(:doc `Give each argument a distinct byte owner, including empty arguments.`)
		(params (value (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut owned (array:alloc u8 value.len))
			(let end (call append_bytes (borrow-shared value) (borrow-mut owned) 0i32))
			(return (move owned))))

	(fn argument_vector
		(:doc `Split the validated packed view into the owner rows expected by c_cstrs.`)
		(params (program (shared-array u8)) (packed (shared-array u8)) (count i32))
		(returns (owned-array (owned-array u8)))
		(body
			(let-mut rows (array:alloc (owned-array u8) count))
			(rows.set 0i32 (call copy_argument (borrow-shared program)))
			(let-mut begin 0i32)
			(let-mut index 0i32)
			(let-mut row 1i32)
			(while
				(:doc "Preserve argument boundaries as separate owners without copying the delimiters.")
				(index.lt packed.len)
				(body
					(if
						(:doc "At each terminator the complete row occupies the checked output slot.")
						(u8:eqz (packed.get index))
						(then
							(rows.set row (call copy_argument
								(borrow-shared (packed.range begin index))))
							(set row row.inc)
							(set begin index.inc)))
					(set index index.inc)))
			(return (move rows))))

	(fn drain_capture
		(:doc `Drain stdout to EOF while copying only the prefix that fits the output view.`)
		(params (reader i32) (output (mut-array u8)) (scratch (mut-array u8)))
		(returns CaptureDrain)
		(body
			(let capacity output.len)
			(let width (int:convert Size scratch.len))
			(let-mut written 0i32)
			(let-mut overflow (bool false))
			(while
				(:doc "Keep reading after filling the prefix so the child can always finish writing.")
				(bool true)
				(body
					(let count (int:convert i32 (call read reader (borrow-mut scratch) width)))
					(if
						(:doc "An interrupted read leaves the prefix unchanged and can be retried.")
						count.ltz
						(then
							(if
								(:doc "Keep an already captured prefix when the native read reports a different failure.")
								(errno.not-eq EINTR)
								(then (return (CaptureDrain.new (ok (bool false)) (length written) (overflow overflow))))))
						(else
							(if
								(:doc "EOF completes the capture, including an exactly full prefix without overflow.")
								count.eqz
								(then (return (CaptureDrain.new (ok (bool true)) (length written) (overflow overflow)))))
							(let room (capacity.sub written))
							(let-mut keep count)
							(if
								(:doc "Discard only the part of this read that exceeds the remaining capacity.")
								(room.lt count)
								(then
									(set keep room)
									(set overflow (bool true))))
							(let-mut index 0i32)
							(while
								(:doc "Copy the part of this read that fits, advancing the output cursor once per byte.")
								(index.lt keep)
								(body
									(output.set written (scratch.get index))
									(set written written.inc)
									(set index index.inc)))))))))

	(fn finish_capture
		(:doc `Close the parent reader and reap the child even if an earlier capture operation failed.`)
		(params (child i32) (reader i32) (writer_closed bool) (output (mut-array u8)) (scratch (mut-array u8)))
		(returns ProcessCapture)
		(body
			(if
				(:doc "A failed writer close can leave the parent unable to observe EOF.")
				writer_closed.not
				(then
					(let closed (call close reader))
					(let status (call reap_capture_child child))
					(return (call capture_failure))))
			(let result (call drain_capture reader (borrow-mut output) (borrow-mut scratch)))
			(let closed (call close reader))
			(let-mut status (call reap_capture_child child))
			(if
				(:doc "A host I/O failure takes precedence over the child's status and keeps the captured prefix.")
				(bool:not (result/ok.and closed.eqz))
				(then (set status -1i32)))
			(return (ProcessCapture.new (status status)
				(length result/length) (overflow result/overflow)))))

	(fn capture_process
		(:doc `Capture at most output.len bytes, setting overflow when any further bytes were drained.

		Allocate the drain buffer before launch so every started child reaches the wait.`)
		(params (program (shared-array u8)) (arguments (shared-array u8)) (diagnostics i32) (merge_stderr bool) (output (mut-array u8)))
		(returns ProcessCapture)
		(body
			(if
				(:doc "An invalid program returns before allocating process resources.")
				(bool:not (call valid_program (borrow-shared program)))
				(then (return (call capture_failure))))
			(let count (call count_arguments (borrow-shared arguments)))
			(if
				(:doc "Reject a truncated or oversized packed argument list before opening descriptors.")
				count.ltz
				(then (return (call capture_failure))))
			(let vector (call argument_vector (borrow-shared program) (borrow-shared arguments) count))
			(let-mut scratch (array:alloc u8 4096i32))
			(let ends (call open_capture_descriptors))
			(let reader ends/reader)
			(if
				(:doc "A failed descriptor setup owns neither endpoint and leaves no child.")
				reader.ltz
				(then (return (call capture_failure))))
			(let child (call spawn_capture_child (borrow-shared program) (borrow-shared vector)
				ends diagnostics merge_stderr))
			(let writer_status (call close ends/writer))
			(if
				(:doc "If spawn failed, release the reader without waiting for a child.")
				child.ltz
				(then
					(let closed (call close reader))
					(return (call capture_failure))))
			(return (call finish_capture child reader
				writer_status.eqz (borrow-mut output) (borrow-mut scratch)))))

	(fn run_process_capture_to_stderr
		(:doc "Capture stdout while redirecting stderr to the supplied descriptor when present.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (diagnostics i32) (output (mut-array u8)))
		(returns ProcessCapture)
		(body (return (call capture_process (borrow-shared program) (borrow-shared arguments)
			diagnostics (bool false) (borrow-mut output)))))

	(fn run_process_capture_merged
		(:doc "Capture stdout and stderr together in the same bounded byte view.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (output (mut-array u8)))
		(returns ProcessCapture)
		(body (return (call capture_process (borrow-shared program) (borrow-shared arguments)
			-1i32 (bool true) (borrow-mut output)))))

	(fn run_process_capture
		(:doc "Capture bounded stdout and inherit the caller's standard error stream.")
		(:expect (tests "stage-2/process/cases.tsv") (issues "gh:wove-lang/wove:175" "gh:wove-lang/wove:283"))
		(params (program (shared-array u8)) (arguments (shared-array u8)) (output (mut-array u8))) (returns ProcessCapture)
		(body
			(return (call run_process_capture_to_stderr (borrow-shared program) (borrow-shared arguments)
				-1i32 (borrow-mut output)))))
)
