(module process_capture_child
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Launch and reap the child at the POSIX boundary.

	File actions duplicate the capture writer onto stdout and close both
	original endpoints in the child. Wove owns the spawn objects until
	the call returns. The parent keeps responsibility for its descriptors.`)

	(use wove-file "./descriptors.wove" (only (type CaptureDescriptors)))
	(use c-header "<errno.h>" (only errno EINTR))
	(use c-header "<unistd.h>" (only environ STDOUT_FILENO STDERR_FILENO))
	(use c-header "<spawn.h>" (only (type Pid) (type Actions) (type Attributes)
		posix_spawn_file_actions_init posix_spawn_file_actions_adddup2 posix_spawn_file_actions_addclose
		posix_spawnattr_init posix_spawnp))
	(use c-header "<sys/wait.h>" (only (type (as Pid WaitPid)) waitpid WNOHANG WIFEXITED WEXITSTATUS WIFSIGNALED WTERMSIG))

	(fn spawn_capture_child
		(:doc `Start one executable through PATH and return its process ID, or -1 on host failure.`)
		(params (program (shared-array u8)) (arguments (shared-array (owned-array u8))) (ends CaptureDescriptors)
			(diagnostics i32) (merge_stderr bool))
		(returns i32)
		(body
			(let-mut actions (native:alloc Actions))
			(if
				(:doc "The destructor only becomes active after successful initialization.")
				(i32:not-eqz (call posix_spawn_file_actions_init (borrow-mut actions)))
				(then (return -1i32)))
			(let reader ends/reader)
			(let writer ends/writer)
			(if
				(:doc "Duplicate stdout first. Neither original endpoint occupies a standard descriptor.")
				(bool:not (bool:and
					(i32:eqz (call posix_spawn_file_actions_adddup2 (borrow-mut actions) writer STDOUT_FILENO))
					(bool:and
						(i32:eqz (call posix_spawn_file_actions_addclose (borrow-mut actions) reader))
						(i32:eqz (call posix_spawn_file_actions_addclose (borrow-mut actions) writer)))))
				(then (return -1i32)))
			(if
				(:doc "A merged capture duplicates the already redirected stdout onto stderr.")
				(merge_stderr.and
					(i32:not-eqz (call posix_spawn_file_actions_adddup2 (borrow-mut actions)
						STDOUT_FILENO STDERR_FILENO)))
				(then (return -1i32)))
			(if
				(:doc "Duplicate the parent's already open diagnostic file into the child's stderr.")
				(i32:lt -1i32 diagnostics)
				(then
					(if
						(:doc "Each PATH attempt can reuse the parent descriptor without creating another file.")
						(bool:not (bool:and (STDERR_FILENO.lt diagnostics)
							(bool:and
								(i32:eqz (call posix_spawn_file_actions_adddup2 (borrow-mut actions)
									diagnostics STDERR_FILENO))
								(i32:eqz (call posix_spawn_file_actions_addclose (borrow-mut actions) diagnostics)))))
						(then (return -1i32)))))
			(let-mut attributes (native:alloc Attributes))
			(if
				(:doc "An initialized attribute object with no changes applies the POSIX defaults.")
				(i32:not-eqz (call posix_spawnattr_init (borrow-mut attributes)))
				(then (return -1i32)))
			(let environment environ)
			(let-mut child (int:convert Pid 0i32))
			(let result (call posix_spawnp (borrow-mut child) (borrow-shared program)
				(borrow-shared actions) (borrow-shared attributes)
				(borrow-shared arguments) (borrow-shared environment)))
			(if
				(:doc "Only a successful spawn gives the caller a child to reap.")
				result.not-eqz
				(then (return -1i32)))
			(return (int:convert i32 child))))

	(fn decode_child_status
		(:doc `Use the target header's status macros and the archived capture status convention.`)
		(params (status i32)) (returns i32)
		(body
			(if
				(:doc "A normal exit reports the child's code.")
				(call WIFEXITED status)
				(then (return (call WEXITSTATUS status))))
			(if
				(:doc "A signal occupies the status range above 128.")
				(call WIFSIGNALED status)
				(then (return (i32:add 128i32 (call WTERMSIG status)))))
			(return -1i32)))

	(struct ChildWait (fields (ready bool) (status i32)))

	(fn wait_capture_child
		(:doc "Wait or poll one owned child across interruptions. An empty poll leaves its status pending.")
		(params (pid i32) (options i32)) (returns ChildWait)
		(body
			(if
				(:doc "Only a positive ID identifies one process owned by the caller.")
				pid.not-gtz
				(then (return (struct:new ChildWait (ready (bool true)) (status -1i32)))))
			(let target (int:convert WaitPid pid))
			(let-mut status 0i32)
			(while
				(:doc "A signal can interrupt waitpid before it collects the child.")
				(bool true)
				(body
					(let result (int:convert i32 (call waitpid target (borrow-mut status) options)))
					(if
						(:doc "The selected child has been reaped with its final native status.")
						(result.eq pid)
						(then (return (struct:new ChildWait (ready (bool true)) (status (call decode_child_status status))))))
					(if
						(:doc "A nonblocking wait leaves a running child owned by the caller.")
						result.eqz
						(then (return (struct:new ChildWait (ready (bool false)) (status 0i32)))))
					(if
						(:doc "Only an interrupted system call is retried.")
						(errno.not-eq EINTR)
						(then (return (struct:new ChildWait (ready (bool true)) (status -1i32)))))))))

	(fn poll_capture_child
		(:doc "Reap one selected child if it has finished.")
		(params (pid i32)) (returns ChildWait)
		(body (return (call wait_capture_child pid WNOHANG))))

	(fn reap_capture_child
		(:doc "Reap the selected child and return its decoded status.")
		(params (pid i32)) (returns i32)
		(body (return (struct:get (call wait_capture_child pid 0i32) status))))
)
