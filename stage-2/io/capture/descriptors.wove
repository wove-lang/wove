(module process_capture_descriptors
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Open a private stdout channel for one spawned process.

	Use pipe2 when the selected target provides it. A private FIFO supplies
	the same close-on-exec guarantee on older hosts or kernels. The returned
	endpoints are blocking, unnamed, and above the standard descriptors.
	The caller owns both endpoints on success.`)

	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../temporary.wove" (only create_temporary_directory))
	(use c-header "<unistd.h>" (only close unlink rmdir STDERR_FILENO))
	(use (:pragma (cfg (any (os "linux") (all (os "macos") (os_min 270000)))))
		c-header "<unistd.h>" (only pipe2))
	(use (:pragma (cfg (any (os "linux") (all (os "macos") (os_min 270000)))))
		c-header "<errno.h>" (only errno ENOSYS))
	(use c-header "<fcntl.h>" (only open fcntl_setfl fcntl_dupfd_cloexec
		O_RDONLY O_WRONLY O_NONBLOCK O_CLOEXEC (type (as Mode OpenMode))))
	(use c-header "<sys/stat.h>" (only mkfifo S_IRUSR S_IWUSR (type (as Mode FifoMode))))

	(struct CaptureDescriptors (fields (reader i32) (writer i32)))

	(let directory_suffix "/wove-capture.XXXXXX")
	(let fifo_suffix "/stdout")

	(fn absent_capture
		(:doc `Mark a setup failure with no outstanding descriptor ownership.`)
		(params) (returns CaptureDescriptors)
		(body (return (struct.new CaptureDescriptors (reader -1i32) (writer -1i32)))))

	(fn close_capture_end
		(:doc `Release an existing endpoint without retrying close on an uncertain descriptor.`)
		(params (fd i32)) (returns void)
		(body
			(if
				(:doc "Negative sentinels name no system resource.")
				(i32.lt -1i32 (local fd))
				(then (let closed (call close (local fd)))))))

	(fn close_capture_descriptors
		(:doc `Release both endpoints after a partially completed setup or a failed spawn.`)
		(params (ends CaptureDescriptors)) (returns void)
		(body
			(call close_capture_end (struct.get (local ends) writer))
			(call close_capture_end (struct.get (local ends) reader))))

	(fn join_flags
		(:doc `Combine nonnegative POSIX flag values without changing the native ABI type.`)
		(params (left i32) (right i32)) (returns i32)
		(body (return (int.convert i32 (u32.or (int.convert u32 (local left)) (int.convert u32 (local right)))))))

	(fn open_fifo_path
		(:doc `Open both private FIFO ends atomically close-on-exec, then unlink the name.`)
		(params (path (shared-slice u8))) (returns CaptureDescriptors)
		(body
			(let mode (int.convert FifoMode (call join_flags (local S_IRUSR) (local S_IWUSR))))
			(if
				(:doc "Only a FIFO created by this call can be unlinked here.")
				(bool.not (i32.eq (call mkfifo (borrow-shared (local path)) (local mode)) 0i32))
				(then (return (call absent_capture))))
			(let read_flags (call join_flags (local O_RDONLY) (call join_flags (local O_NONBLOCK) (local O_CLOEXEC))))
			(let reader (call open (borrow-shared (local path)) (local read_flags) (int.convert OpenMode 0i32)))
			(let-mut writer -1i32)
			(if
				(:doc "The nonblocking reader lets the writer attach without waiting for another process.")
				(i32.lt -1i32 (local reader))
				(then
					(let write_flags (call join_flags (local O_WRONLY) (local O_CLOEXEC)))
					(set (local writer) (call open (borrow-shared (local path)) (local write_flags) (int.convert OpenMode 0i32)))))
			(let removed (call unlink (borrow-shared (local path))))
			(let ends (struct.new CaptureDescriptors (reader (local reader)) (writer (local writer))))
			(if
				(:doc "A complete channel keeps its descriptors after the filesystem name is gone.")
				(bool.and (i32.lt -1i32 (local writer)) (i32.eq (local removed) 0i32))
				(then (return (local ends))))
			(call close_capture_descriptors (local ends))
			(return (call absent_capture))))

	(fn open_fifo_directory
		(:doc `Build the FIFO path, remove the private directory, and restore blocking reads.`)
		(params (directory (shared-slice u8))) (returns CaptureDescriptors)
		(body
			(if
				(:doc "A failed directory creation leaves no FIFO to open.")
				(i32.eq (slice.len (local directory)) 0i32)
				(then (return (call absent_capture))))
			(let parent (slice.len (local directory)))
			(let suffix (slice.len (local fifo_suffix)))
			(if
				(:doc "Remove an already-created directory when its child path would overflow.")
				(i32.lt (i32.sub.wrapping 2147483647i32 (local suffix)) (local parent))
				(then
					(let removed (call rmdir (borrow-shared (local directory))))
					(return (call absent_capture))))
			(let-mut path (array.alloc u8 (i32.add.wrapping (local parent) (local suffix))))
			(let next (call append_bytes (borrow-shared (local directory)) (borrow-mut (local path)) 0i32))
			(let written (call append_bytes (borrow-shared (local fifo_suffix)) (borrow-mut (local path)) (local next)))
			(let ends (call open_fifo_path (borrow-shared (local path))))
			(let removed (call rmdir (borrow-shared (local directory))))
			(let reader (struct.get (local ends) reader))
			(if
				(:doc "Finish setup only after removing both paths and clearing O_NONBLOCK on the reader.")
				(bool.and (bool.and (i32.lt -1i32 (local reader)) (i32.eq (local removed) 0i32))
					(i32.eq (call fcntl_setfl (local reader) 0i32) 0i32))
				(then (return (local ends))))
			(call close_capture_descriptors (local ends))
			(return (call absent_capture))))

	(fn open_capture_fifo
		(:doc "Open the private FIFO transport using the process environment's temporary root.")
		(params) (returns CaptureDescriptors)
		(body
			(let directory (call create_temporary_directory (borrow-shared (local directory_suffix))))
			(return (call open_fifo_directory (borrow-shared (local directory))))))

	(fn create_capture_descriptors
		(:doc `Prefer the kernel's atomic close-on-exec pipe, with a FIFO for an older kernel.`)
		(:pragma (cfg (any (os "linux") (all (os "macos") (os_min 270000)))))
		(params) (returns CaptureDescriptors)
		(body
			(let-mut descriptors (array.repeat (array i32 2) -1i32))
			(if
				(:doc "A successful pipe2 call returns two owned close-on-exec descriptors.")
				(i32.eq (call pipe2 (borrow-mut (local descriptors)) (local O_CLOEXEC)) 0i32)
				(then (return (struct.new CaptureDescriptors
					(reader (array.load (local descriptors) 0i32)) (writer (array.load (local descriptors) 1i32))))))
			(if
				(:doc "A kernel without pipe2 can still open a private FIFO with the flag set atomically.")
				(i32.eq (local errno) (local ENOSYS))
				(then (return (call open_capture_fifo))))
			(return (call absent_capture))))

	(fn create_capture_descriptors
		(:doc `Use the private FIFO when the build target has no pipe2 declaration.`)
		(:pragma (cfg (not (any (os "linux") (all (os "macos") (os_min 270000))))))
		(params) (returns CaptureDescriptors)
		(body (return (call open_capture_fifo))))

	(fn move_above_stdio
		(:doc `Consume an endpoint and keep close-on-exec set when changing its descriptor number.`)
		(params (fd i32)) (returns i32)
		(body
			(if
				(:doc "Descriptors above stderr can already be duplicated and closed safely in the child.")
				(i32.lt (local STDERR_FILENO) (local fd))
				(then (return (local fd))))
			(let replacement (call fcntl_dupfd_cloexec (local fd) (i32.add.wrapping (local STDERR_FILENO) 1i32)))
			(let closed (call close (local fd)))
			(if
				(:doc "A failed duplication already consumed its original endpoint here.")
				(i32.lt (local replacement) 0i32)
				(then (return -1i32)))
			(if
				(:doc "If closing the original fails, release the new endpoint before reporting failure.")
				(bool.not (i32.eq (local closed) 0i32))
				(then
					(call close_capture_end (local replacement))
					(return -1i32)))
			(return (local replacement))))

	(fn open_capture_descriptors
		(:doc `Open both endpoints and reserve standard descriptor numbers for the child's stdio actions.`)
		(:expect (tests "stage-2/process/descriptors.tsv") (issues "gh:wove-lang/wove:283"))
		(params) (returns CaptureDescriptors)
		(body
			(let created (call create_capture_descriptors))
			(let original_reader (struct.get (local created) reader))
			(let original_writer (struct.get (local created) writer))
			(if
				(:doc "A setup failure owns neither endpoint.")
				(i32.lt (local original_reader) 0i32)
				(then (return (local created))))
			(let reader (call move_above_stdio (local original_reader)))
			(if
				(:doc "A failed reader relocation leaves only the untouched writer to close.")
				(i32.lt (local reader) 0i32)
				(then
					(call close_capture_end (local original_writer))
					(return (call absent_capture))))
			(let writer (call move_above_stdio (local original_writer)))
			(if
				(:doc "A failed writer relocation consumes that endpoint and leaves only the new reader.")
				(i32.lt (local writer) 0i32)
				(then
					(call close_capture_end (local reader))
					(return (call absent_capture))))
			(return (struct.new CaptureDescriptors (reader (local reader)) (writer (local writer))))))
)
