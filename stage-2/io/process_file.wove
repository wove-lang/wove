(module process_stdout_file
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Launch tools with an explicit environment and private file redirection.")

	(use wove-file "./process.wove" (only valid_program count_arguments argument_vector))
	(use wove-file "./capture/descriptors.wove" (only move_above_stdio))
	(use wove-file "./capture/child.wove" (only reap_capture_child))
	(use c-header "<fcntl.h>" (only open O_CREAT O_EXCL O_WRONLY O_CLOEXEC (type Mode)))
	(use c-header "<spawn.h>" (only (type Pid) (type Actions) (type Attributes)
		posix_spawn_file_actions_init posix_spawn_file_actions_adddup2 posix_spawn_file_actions_addclose
		posix_spawnattr_init posix_spawnp))
	(use c-header "<unistd.h>" (only close STDOUT_FILENO STDERR_FILENO))

	(fn spawn_to_writer
		(:doc `Create the child's standard output from one already open descriptor. PATH retries can reuse it.`)
		(params (program (shared-array u8)) (vector (shared-array (owned-array u8))) (writer i32) (diagnostics i32)
			(environment (shared-array (owned-array u8)))) (returns i32)
		(body
			(let-mut actions (native.alloc Actions))
			(if
				(:doc `The action owner needs successful initialization before it can be passed to spawn.`)
				(i32.not-eqz (call posix_spawn_file_actions_init (borrow-mut actions)))
				(then (return -1i32)))
			(if
				(:doc `Duplicate the writer onto stdout before closing the original descriptor in the child.`)
				(bool.not (bool.and
					(i32.eqz (call posix_spawn_file_actions_adddup2 (borrow-mut actions) writer STDOUT_FILENO))
					(i32.eqz (call posix_spawn_file_actions_addclose (borrow-mut actions) writer))))
				(then (return -1i32)))
			(if
				(:doc "An optional second writer keeps child diagnostics separate from stdout.")
				(bool.and (i32.not-ltz diagnostics)
					(bool.not (bool.and
						(i32.eqz (call posix_spawn_file_actions_adddup2 (borrow-mut actions) diagnostics STDERR_FILENO))
						(i32.eqz (call posix_spawn_file_actions_addclose (borrow-mut actions) diagnostics)))))
				(then (return -1i32)))
			(let-mut attributes (native.alloc Attributes))
			(if
				(:doc `Initialize the spawn attributes with POSIX defaults.`)
				(i32.not-eqz (call posix_spawnattr_init (borrow-mut attributes)))
				(then (return -1i32)))
			(let-mut child (int.convert Pid 0i32))
			(let result (call posix_spawnp (borrow-mut child) (borrow-shared program)
				(borrow-shared actions) (borrow-shared attributes)
				(borrow-shared vector) (borrow-shared environment)))
			(if (i32.not-eqz result) (then (return -1i32)))
			(return (int.convert i32 child))))

	(struct FileChild (fields (pid i32) (ok bool)))

	(fn failed_file_launch
		(:doc "Report launch failure before a process needs to be reaped.")
		(params) (returns FileChild)
		(body (return (struct.new FileChild (pid -1i32) (ok (bool false))))))

	(fn open_private_writer
		(:doc "Create one private file and keep its close-on-exec descriptor above stdio.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let flags (i32.from-u32 (u32.or (u32.or (u32.from-i32 O_CREAT) (u32.from-i32 O_EXCL))
				(u32.or (u32.from-i32 O_WRONLY) (u32.from-i32 O_CLOEXEC)))))
			(let descriptor (call open (borrow-shared path) flags (int.convert Mode 384i32)))
			(if (i32.ltz descriptor) (then (return -1i32)))
			(return (call move_above_stdio descriptor))))

	(fn start_process_files
		(:doc `Launch with complete stdout and optional stderr in separate new private files.

		A positive PID must be reaped even if closing a parent descriptor fails.
		An empty diagnostic path inherits stderr.`)
		(params (program (shared-array u8)) (arguments (shared-array u8))
			(path (shared-array u8)) (error_path (shared-array u8))
			(environment (shared-array (owned-array u8)))) (returns FileChild)
		(body
			(if
				(:doc "Validate all nonempty names before a cstr conversion can reach POSIX.")
				(bool.not (bool.and (bool.and (call valid_program (borrow-shared program))
					(call valid_program (borrow-shared path)))
					(bool.or (i32.eqz (array.len error_path)) (call valid_program (borrow-shared error_path)))))
				(then (return (call failed_file_launch))))
			(let count (call count_arguments (borrow-shared arguments)))
			(if (i32.ltz count) (then (return (call failed_file_launch))))
			(let vector (call argument_vector (borrow-shared program) (borrow-shared arguments) count))
			(let writer (call open_private_writer (borrow-shared path)))
			(if (i32.ltz writer) (then (return (call failed_file_launch))))
			(let-mut diagnostics -1i32)
			(if
				(:doc "Release stdout if the separate diagnostic file cannot be opened.")
				(i32.gtz (array.len error_path))
				(then
					(set diagnostics (call open_private_writer (borrow-shared error_path)))
					(if
						(:doc "A failed diagnostic open leaves no child and only stdout to close.")
						(i32.ltz diagnostics)
						(then
							(let closed (call close writer))
							(return (call failed_file_launch))))))
			(let child (call spawn_to_writer (borrow-shared program) (borrow-shared vector)
				writer diagnostics (borrow-shared environment)))
			(let closed (call close writer))
			(let-mut error_closed 0i32)
			(if
				(:doc "Close the separate writer on both launch success and failure.")
				(i32.not-ltz diagnostics)
				(then (set error_closed (call close diagnostics))))
			(return (struct.new FileChild (pid child)
				(ok (bool.and (i32.gtz child) (bool.and (i32.eqz closed) (i32.eqz error_closed))))))))

	(let inherited_stderr "")

	(fn run_process_stdout_file
		(:doc "Retain complete stdout, inherit stderr and reap the tool before returning.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (path (shared-array u8))
			(environment (shared-array (owned-array u8)))) (returns i32)
		(body
			(let child (call start_process_files (borrow-shared program) (borrow-shared arguments)
				(borrow-shared path) (borrow-shared inherited_stderr) (borrow-shared environment)))
			(let pid (struct.get child pid))
			(if (i32.ltz pid) (then (return -1i32)))
			(let status (call reap_capture_child pid))
			(if (bool.not (struct.get child ok)) (then (return -1i32)))
			(return status)))
)
