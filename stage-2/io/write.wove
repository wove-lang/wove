(module native_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write a complete byte view to an open native file descriptor.")

	(use c-header "<unistd.h>" (only write close unlink (type Size)))
	(use c-header "<fcntl.h>" (only open O_CREAT O_EXCL O_WRONLY O_CLOEXEC (type Mode)))
	(use c-header "<errno.h>" (only errno EINTR))

	(fn write_all
		(:doc "Write each byte once, advancing on short writes and retrying EINTR before any progress.")
		(params (descriptor i32) (bytes (shared-array u8))) (returns bool)
		(body
			(let end (array.len (local bytes)))
			(let-mut offset 0i32)
			(while
				(:doc "Pass only the remaining bytes to the checked native write contract.")
				(i32.lt (local offset) (local end))
				(body
					(let count (int.convert Size (i32.sub (local end) (local offset))))
					(let written (int.convert i32 (call write (local descriptor)
						(borrow-shared (array.range (local bytes) (local offset) (local end))) (local count))))
					(if
						(:doc "A positive result advances the cursor. Zero and permanent errors fail the write.")
						(i32.lt 0i32 (local written))
						(then (set (local offset) (i32.add (local offset) (local written))))
						(else
							(if
								(:doc "An interrupted write made no progress. Retry only that failure.")
								(bool.not (bool.and (i32.lt (local written) 0i32) (i32.eq (local errno) (local EINTR))))
								(then (return (bool false))))))))
			(return (bool true))))

	(fn open_new_output
		(:doc "Open an exclusive private output descriptor with close-on-exec set.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let flags (int.convert i32 (u32.or (u32.or (int.convert u32 (local O_CREAT)) (int.convert u32 (local O_EXCL)))
				(u32.or (int.convert u32 (local O_WRONLY)) (int.convert u32 (local O_CLOEXEC))))))
			(return (call open (borrow-shared (local path)) (local flags) (int.convert Mode 384i32)))))

	(fn write_new_file
		(:doc "Create and close a private file, removing an incomplete file on failure.")
		(params (path (shared-array u8)) (source (shared-array u8)))
		(returns bool)
		(body
			(let descriptor (call open_new_output (borrow-shared (local path))))
			(if
				(:doc "A failed exclusive open leaves the existing pathname alone.")
				(i32.lt (local descriptor) 0i32)
				(then (return (bool false))))
			(let written (call write_all (local descriptor) (borrow-shared (local source))))
			(let closed (call close (local descriptor)))
			(if
				(:doc "Only a complete write and successful close publish the private source.")
				(bool.and (local written) (i32.eq (local closed) 0i32))
				(then (return (bool true))))
			(let removed (call unlink (borrow-shared (local path))))
			(return (bool false)))))
