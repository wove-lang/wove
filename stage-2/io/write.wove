(module native_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write a complete byte view to an open native file descriptor.")

	(use c-header "<unistd.h>" (only write (type Size)))
	(use c-header "<errno.h>" (only errno EINTR))

	(fn write_all
		(:doc "Write each byte once, advancing on short writes and retrying EINTR before any progress.")
		(params (descriptor i32) (bytes (shared-slice u8))) (returns bool)
		(body
			(let end (slice.len (local bytes)))
			(let-mut offset 0i32)
			(while
				(:doc "Pass only the remaining bytes to the checked native write contract.")
				(i32.lt (local offset) (local end))
				(body
					(let count (int.convert Size (i32.sub.wrapping (local end) (local offset))))
					(let written (int.convert i32 (call write (local descriptor)
						(borrow-shared (slice.range (local bytes) (local offset) (local end))) (local count))))
					(if
						(:doc "A positive result advances the cursor. Zero and permanent errors fail the write.")
						(i32.lt 0i32 (local written))
						(then (set (local offset) (i32.add.wrapping (local offset) (local written))))
						(else
							(if
								(:doc "An interrupted write made no progress. Retry only that failure.")
								(bool.not (bool.and (i32.lt (local written) 0i32) (i32.eq (local errno) (local EINTR))))
								(then (return (bool false))))))))
			(return (bool true)))))
