(module native_write
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Write a complete byte view to an open native file descriptor.")

	(use c-header "<unistd.h>" (only write close unlink (type Size)))
	(use c-header "<fcntl.h>" (only open O_CREAT O_EXCL O_WRONLY O_CLOEXEC (type Mode)))
	(use c-header "<errno.h>" (only errno EINTR))

	(fn write_all
		(:doc "Write each byte once, advancing on short writes and retrying EINTR before any progress.")
		(params (descriptor i32) (bytes (shared-array u8))) (returns bool)
		(body
			(let end bytes.len)
			(let-mut offset 0i32)
			(while
				(:doc "Pass only the remaining bytes to the checked native write contract.")
				(offset.lt end)
				(body
					(let count (int:convert Size (end.sub offset)))
					(let written (int:convert i32 (call write descriptor
						(borrow-shared (bytes.range offset end)) count)))
					(if
						(:doc "A positive result advances the cursor. Zero and permanent errors fail the write.")
						written.gtz
						(then (set offset (offset.add written)))
						(else
							(if
								(:doc "An interrupted write made no progress. Retry only that failure.")
								(bool:not (written.ltz.and (errno.eq EINTR)))
								(then (return (bool false))))))))
			(return (bool true))))

	(fn open_new_output
		(:doc "Open an exclusive private output descriptor with close-on-exec set.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let flags (i32:from-u32 (u32:or (u32:or (u32:from-i32 O_CREAT) (u32:from-i32 O_EXCL))
				(u32:or (u32:from-i32 O_WRONLY) (u32:from-i32 O_CLOEXEC)))))
			(return (call open (borrow-shared path) flags (int:convert Mode 384i32)))))

	(fn write_new_file
		(:doc "Create and close a private file, removing an incomplete file on failure.")
		(params (path (shared-array u8)) (source (shared-array u8)))
		(returns bool)
		(body
			(let descriptor (call open_new_output (borrow-shared path)))
			(if
				(:doc "A failed exclusive open leaves the existing pathname alone.")
				descriptor.ltz
				(then (return (bool false))))
			(let written (call write_all descriptor (borrow-shared source)))
			(let closed (call close descriptor))
			(if
				(:doc "Only a complete write and successful close publish the private source.")
				(written.and closed.eqz)
				(then (return (bool true))))
			(let removed (call unlink (borrow-shared path)))
			(return (bool false)))))
