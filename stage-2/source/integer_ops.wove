(module source_integer_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Map the 16-bit integer operation spellings to exact binary signatures.`)

	(use wove-file "./types.wove" (only builtin_type_keyword is_16bit_integer (value i16_type) (value u16_type)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct IntegerOperator (fields (operand u32) (result u32) (symbol u8)))

	(let first_i16_operator 180u32)
	(let first_u16_operator 184u32)
	(let equal_head ".eq")
	(let less_head ".lt")
	(let add_head ".add.wrapping")
	(let subtract_head ".sub.wrapping")

	(fn read_16bit_operator
		(:doc `Accept only complete i16 or u16 prefixes and supported operation suffixes.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "Comparison and wrapping arithmetic each have a fixed tag width.")
				(bool.not (bool.or (i32.eq (local width) 6i32) (i32.eq (local width) 16i32)))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) 3i32))
			(if (bool.not (call is_16bit_integer (local type))) (then (return 0u32)))
			(let suffix (i32.add.wrapping (local start) 3i32))
			(let-mut base (local first_i16_operator))
			(if (u32.eq (local type) (local u16_type)) (then (set (local base) (local first_u16_operator))))
			(if
				(:doc "Equality is the first operation for either width's signedness.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local equal_head)) 0i32 (array.len (local equal_head)))
				(then (return (local base))))
			(if
				(:doc "Less-than uses the signed or unsigned order of the exact operand type.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local less_head)) 0i32 (array.len (local less_head)))
				(then (return (u32.add.wrapping (local base) 1u32))))
			(if
				(:doc "Wrapping addition retains the operand type.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local add_head)) 0i32 (array.len (local add_head)))
				(then (return (u32.add.wrapping (local base) 2u32))))
			(if
				(:doc "Wrapping subtraction is the final operation in the group.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local subtract_head)) 0i32 (array.len (local subtract_head)))
				(then (return (u32.add.wrapping (local base) 3u32))))
			(return 0u32)))

	(fn integer_16bit_operator
		(:doc `Decode a checked opcode as a comparison or wrapping arithmetic signature.`)
		(params (kind u32))
		(returns IntegerOperator)
		(body
			(if
				(:doc "Other opcode groups have no 16-bit signature.")
				(bool.or (u32.lt (local kind) (local first_i16_operator))
					(bool.not (u32.lt (local kind) (u32.add.wrapping (local first_u16_operator) 4u32))))
				(then (return (struct.new IntegerOperator (operand 0u32) (result 0u32) (symbol 0u8)))))
			(let-mut type (local i16_type))
			(let-mut base (local first_i16_operator))
			(if
				(:doc "Both signedness groups have the same ordering of operations.")
				(bool.not (u32.lt (local kind) (local first_u16_operator)))
				(then
					(set (local type) (local u16_type))
					(set (local base) (local first_u16_operator))))
			(let slot (u32.sub.wrapping (local kind) (local base)))
			(if
				(:doc "Comparisons produce a bool with either equality or strict ordering.")
				(u32.lt (local slot) 2u32)
				(then
					(let-mut symbol 61u8)
					(if (u32.eq (local slot) 1u32) (then (set (local symbol) 60u8)))
					(return (struct.new IntegerOperator (operand (local type)) (result 12u32) (symbol (local symbol))))))
			(let-mut symbol 43u8)
			(if (u32.eq (local slot) 3u32) (then (set (local symbol) 45u8)))
			(return (struct.new IntegerOperator (operand (local type)) (result (local type)) (symbol (local symbol)))))))
