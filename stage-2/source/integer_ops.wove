(module source_integer_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read exact-width integer arithmetic and its overflow behavior.

	The opcode range reserves eight slots per six-bit builtin type code.
	Slots zero through two wrap. Slots four through six trap on overflow.
	Division and remainder have a separate pair of slots per type.`)

	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))

	(struct IntegerOperator (fields (operand u32) (symbol u8)))

	(let arithmetic_base 3072u32)
	(let division_base 3584u32)
	(let division_limit 3712u32)
	(let trapping_flag 4u32)
	(let checked_suffix "-checked")
	(let arithmetic_symbols "+-*")

	(fn read_integer_operator
		(:doc "Match an exact integer type and operation. The low bits encode the operation and overflow mode.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (i32.sub (local end) (local start)))
			(let-mut name_width (local width))
			(let-mut flags 0u32)
			(if
				(:doc "A longer name must end in the complete checked suffix.")
				(i32.lt 7i32 (local width))
				(then
					(if (bool.or (i32.lt (local width) 14i32) (i32.lt 15i32 (local width))) (then (return 0u32)))
					(set (local name_width) (i32.sub (local width) (array.len (local checked_suffix))))
					(if
						(:doc "Verify the suffix within the written head before classifying the shorter name.")
						(bool.not (call same_bytes (borrow-shared (local source))
							(i32.add (local start) (local name_width)) (local end)
							(borrow-shared (local checked_suffix)) 0i32 (array.len (local checked_suffix))))
						(then (return 0u32)))
					(set (local flags) (local trapping_flag))))
			(let prefix (i32.sub (local name_width) 4i32))
			(if
				(:doc "Both accepted type widths end in a dot followed by a three-byte operator.")
				(bool.not (bool.and (bool.or (i32.eq (local prefix) 2i32) (i32.eq (local prefix) 3i32))
					(call is_byte_at (borrow-shared (local source)) (local start) (local prefix) 46u8)))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local prefix)))
			(if (bool.not (call is_builtin_integer (local type))) (then (return 0u32)))
			(let mnemonic (i32.add (local start) (i32.add (local prefix) 1i32)))
			(let base (u32.add (local arithmetic_base) (u32.or (u32.shl (local type) 3i32) (local flags))))
			(if
				(:doc "Addition occupies slot zero.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 97u8 100u8 100u8)
				(then (return (local base))))
			(if
				(:doc "Subtraction occupies slot one.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 115u8 117u8 98u8)
				(then (return (u32.add (local base) 1u32))))
			(if
				(:doc "Multiplication occupies slot two.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 109u8 117u8 108u8)
				(then (return (u32.add (local base) 2u32))))
			(if
				(:doc "Division and remainder have no additional checked spelling.")
				(u32.eq (local flags) 0u32)
				(then
					(let division (u32.add (local division_base) (u32.shl (local type) 1i32)))
					(if
						(:doc "Division uses the first slot for the exact integer type.")
						(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 100u8 105u8 118u8)
						(then (return (local division))))
					(if
						(:doc "Remainder uses the paired slot for the same type.")
						(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 114u8 101u8 109u8)
						(then (return (u32.add (local division) 1u32))))))
			(return 0u32)))

	(fn is_integer_arithmetic
		(:doc "Check the opcode range assigned to typed addition, subtraction, and multiplication.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local arithmetic_base))
			(u32.lt (local kind) (local division_base))))))

	(fn is_checked_integer_operator
		(:doc "Identify the arithmetic operations that retain their source head for a runtime trap.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_arithmetic (local kind))
			(u32.eq (u32.and (local kind) (local trapping_flag)) (local trapping_flag))))))

	(fn is_integer_division
		(:doc "Identify an exact-width quotient or remainder in its own opcode range.")
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local division_base))
			(u32.lt (local kind) (local division_limit))))))

	(fn is_integer_remainder
		(:doc "Identify the second slot of a division pair.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_division (local kind))
			(u32.eq (u32.and (local kind) 1u32) 1u32)))))

	(fn integer_operator
		(:doc "Recover the common operand and result type and the arithmetic symbol from an opcode.")
		(params (kind u32))
		(returns IntegerOperator)
		(body
			(if
				(:doc "Quotients and remainders call the runtime with two exact-width operands.")
				(call is_integer_division (local kind))
				(then (return (struct.new IntegerOperator (operand (u32.shr (u32.sub (local kind) (local division_base)) 1i32))
					(symbol 0u8)))))
			(if
				(:doc "Unrelated expression kinds have no arithmetic signature.")
				(bool.not (call is_integer_arithmetic (local kind)))
				(then (return (struct.new IntegerOperator (operand 0u32) (symbol 0u8)))))
			(let type (u32.shr (u32.sub (local kind) (local arithmetic_base)) 3i32))
			(let slot (i32.from-u32 (u32.and (local kind) 3u32)))
			(return (struct.new IntegerOperator (operand (local type))
				(symbol (array.load (local arithmetic_symbols) (local slot)))))))
)
