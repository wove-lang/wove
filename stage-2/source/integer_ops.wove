(module source_integer_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read typed integer conversions and their byte order from a single operation tag.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only is_byte_at))

	(struct IntegerOperation (fields (kind u32) (type u32) (operand u32)))

	(let encode_little 108u32)
	(let encode_big 109u32)
	(let decode_little 110u32)
	(let decode_big 111u32)
	(let typed_integer_conversion 112u32)
	(let exact_byte_view 63u32)
	(let to_le_bytes ".to.le-bytes")
	(let to_be_bytes ".to.be-bytes")
	(let from_le_bytes ".from.le-bytes")
	(let from_be_bytes ".from.be-bytes")
	(let from_integer ".from.")

	(fn integer_byte_width
		(:doc `Return the logical byte width of a verified builtin integer type.`)
		(params (type u32))
		(returns i32)
		(body
			(if (bool.or (u32.eq (local type) 10u32) (u32.eq (local type) 61u32)) (then (return 1i32)))
			(if (u32.eq (local type) 54u32) (then (return 8i32)))
			(return 4i32)))

	(fn is_integer_byte_encoder
		(:doc `Recognize an operation that produces an inline byte array.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local encode_little)) (u32.eq (local kind) (local encode_big))))))

	(fn is_integer_byte_conversion
		(:doc `Recognize the four checked IR operations for integer byte conversions.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (bool.not (u32.lt (local kind) (local encode_little))) (u32.lt (local kind) (local typed_integer_conversion))))))

	(fn integer_bytes_big_endian
		(:doc `Read the byte order from either direction's checked opcode.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local encode_big)) (u32.eq (local kind) (local decode_big))))))

	(fn read_integer_operation
		(:doc `Match an exact integer type prefix and one complete conversion suffix.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns IntegerOperation)
		(body
			(let none (struct.new IntegerOperation (kind 0u32) (type 0u32) (operand 0u32)))
			(let start (struct.get (local head) start))
			(let end (struct.get (local head) end))
			(if
				(:doc "Even the shortest typed conversion is longer than an ordinary integer keyword.")
				(bool.or (bool.not (u32.eq (struct.get (local head) kind) 1u32))
					(i32.lt (i32.sub.wrapping (local end) (local start)) 10i32))
				(then (return (local none))))
			(let-mut width 3i32)
			(if
				(:doc "The dot after a byte type follows a two-byte spelling.")
				(call is_byte_at (borrow-shared (local source)) (local start) 2i32 46u8)
				(then (set (local width) 2i32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Neither booleans, view names, nor native aliases have builtin conversion heads.")
				(bool.not (call is_builtin_integer (local type)))
				(then (return (local none))))
			(let suffix (i32.add.wrapping (local start) (local width)))
			(if
				(:doc "An encoder's source is the integer named at the head.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local to_le_bytes)) 0i32 (array.len (local to_le_bytes)))
				(then (return (struct.new IntegerOperation (kind (local encode_little)) (type (local type)) (operand (local type))))))
			(if
				(:doc "Big-endian encoders reverse the order of the same fixed-width bytes.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local to_be_bytes)) 0i32 (array.len (local to_be_bytes)))
				(then (return (struct.new IntegerOperation (kind (local encode_big)) (type (local type)) (operand (local type))))))
			(if
				(:doc "A decoder accepts an exact shared byte view, or forms one from an explicit loan.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local from_le_bytes)) 0i32 (array.len (local from_le_bytes)))
				(then (return (struct.new IntegerOperation (kind (local decode_little)) (type (local type)) (operand (local exact_byte_view))))))
			(if
				(:doc "Decode big-endian bytes into the same destination type.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local from_be_bytes)) 0i32 (array.len (local from_be_bytes)))
				(then (return (struct.new IntegerOperation (kind (local decode_big)) (type (local type)) (operand (local exact_byte_view))))))
			(let operand (i32.add.wrapping (local suffix) (array.len (local from_integer))))
			(if
				(:doc "A typed numerical conversion requires the complete .from. separator.")
				(bool.or (bool.not (i32.lt (local operand) (local end)))
					(bool.not (call same_bytes (borrow-shared (local source)) (local suffix) (local operand)
						(borrow-shared (local from_integer)) 0i32 (array.len (local from_integer)))))
				(then (return (local none))))
			(let origin (call builtin_type_keyword (borrow-shared (local source)) (local operand)
				(i32.sub.wrapping (local end) (local operand))))
			(if
				(:doc "The source suffix must name one exact builtin integer type.")
				(bool.not (call is_builtin_integer (local origin)))
				(then (return (local none))))
			(return (struct.new IntegerOperation (kind (local typed_integer_conversion)) (type (local type)) (operand (local origin)))))))
