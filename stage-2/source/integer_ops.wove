(module source_integer_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read exact-width integer arithmetic and its overflow behavior.

	The opcode range reserves eight slots per compact six-bit integer type.
	Slots zero through two wrap. Slots four through six trap on overflow.
	Slots three and seven increment and decrement with wrapping.
	Division and remainder have a separate pair of slots per type.`)

	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer_value integer_operator_slot integer_operator_type))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))

	(struct IntegerOperator (fields (operand u32) (symbol u8)))

	(let arithmetic_base 3072u32)
	(let division_base 3584u32)
	(let division_limit 3712u32)
	(let trapping_flag 4u32)
	(let checked_suffix "-checked")
	(let arithmetic_symbols "+-*++-*-")

	(fn read_integer_operator
		(:doc "Match an exact integer type and operation. The low bits encode the operation and overflow mode.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (i32.sub end start))
			(let-mut name_width width)
			(let-mut flags 0u32)
			(if
				(:doc "A longer name must end in the complete checked suffix.")
				(i32.lt 8i32 width)
				(then
					(if (bool.or (i32.lt width 14i32) (i32.lt 16i32 width)) (then (return 0u32)))
					(set name_width (i32.sub width (array.len checked_suffix)))
					(if
						(:doc "Verify the suffix within the written head before classifying the shorter name.")
						(bool.not (call same_bytes (borrow-shared source)
							(i32.add start name_width) end
							(borrow-shared checked_suffix) 0i32 (array.len checked_suffix)))
						(then (return 0u32)))
					(set flags trapping_flag)))
			(let prefix (i32.sub name_width 4i32))
			(if
				(:doc "A two- to four-byte integer type ends in a dot and a three-byte operation.")
				(bool.not (bool.and (bool.and (i32.not-lt prefix 2i32) (i32.not-lt 4i32 prefix))
					(call is_byte_at (borrow-shared source) start prefix 46u8)))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared source) start prefix))
			(if (bool.not (call is_builtin_integer_value type)) (then (return 0u32)))
			(let type_slot (call integer_operator_slot type))
			(let mnemonic (i32.add start (i32.inc prefix)))
			(let base (u32.add arithmetic_base (u32.or (u32.shl type_slot 3i32) flags)))
			(if
				(:doc "Addition occupies slot zero.")
				(call is_three_bytes (borrow-shared source) mnemonic 97u8 100u8 100u8)
				(then (return base)))
			(if
				(:doc "Subtraction occupies slot one.")
				(call is_three_bytes (borrow-shared source) mnemonic 115u8 117u8 98u8)
				(then (return (u32.inc base))))
			(if
				(:doc "Multiplication occupies slot two.")
				(call is_three_bytes (borrow-shared source) mnemonic 109u8 117u8 108u8)
				(then (return (u32.add base 2u32))))
			(if
				(:doc "Steps, division, and remainder have no explicit checked spelling.")
				(u32.eqz flags)
				(then
					(if
						(:doc "Increment uses the first unary slot.")
						(call is_three_bytes (borrow-shared source) mnemonic 105u8 110u8 99u8)
						(then (return (u32.add base 3u32))))
					(if
						(:doc "Decrement uses the second unary slot.")
						(call is_three_bytes (borrow-shared source) mnemonic 100u8 101u8 99u8)
						(then (return (u32.add base 7u32))))
					(let division (u32.add division_base (u32.shl type_slot 1i32)))
					(if
						(:doc "Division uses the first slot for the exact integer type.")
						(call is_three_bytes (borrow-shared source) mnemonic 100u8 105u8 118u8)
						(then (return division)))
					(if
						(:doc "Remainder uses the paired slot for the same type.")
						(call is_three_bytes (borrow-shared source) mnemonic 114u8 101u8 109u8)
						(then (return (u32.inc division))))))
			(return 0u32)))

	(fn is_integer_arithmetic
		(:doc "Check the opcode range assigned to exact-width arithmetic and unary steps.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt kind arithmetic_base)
			(u32.lt kind division_base)))))

	(fn is_integer_step
		(:doc "Identify the two arithmetic slots with one written operand.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_arithmetic kind)
			(u32.eq (u32.and kind 3u32) 3u32)))))

	(fn is_checked_integer_operator
		(:doc "Identify the arithmetic operations that retain their source head for a runtime trap.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_arithmetic kind)
			(bool.and (bool.not (call is_integer_step kind))
				(u32.eq (u32.and kind trapping_flag) trapping_flag))))))

	(fn is_integer_division
		(:doc "Identify an exact-width quotient or remainder in its own opcode range.")
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt kind division_base)
			(u32.lt kind division_limit)))))

	(fn is_integer_remainder
		(:doc "Identify the second slot of a division pair.")
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_division kind)
			(u32.eq (u32.and kind 1u32) 1u32)))))

	(fn integer_operator
		(:doc "Recover the common operand and result type and the arithmetic symbol from an opcode.")
		(params (kind u32))
		(returns IntegerOperator)
		(body
			(if
				(:doc "Quotients and remainders call the runtime with two exact-width operands.")
				(call is_integer_division kind)
				(then (return (struct.new IntegerOperator (operand (call integer_operator_type (u32.shr (u32.sub kind division_base) 1i32)))
					(symbol 0u8)))))
			(if
				(:doc "Unrelated expression kinds have no arithmetic signature.")
				(bool.not (call is_integer_arithmetic kind))
				(then (return (struct.new IntegerOperator (operand 0u32) (symbol 0u8)))))
			(let type (call integer_operator_type (u32.shr (u32.sub kind arithmetic_base) 3i32)))
			(let slot (i32.from-u32 (u32.and kind 7u32)))
			(return (struct.new IntegerOperator (operand type)
				(symbol (array.load arithmetic_symbols slot))))))
)
