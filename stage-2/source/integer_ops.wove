(module source_integer_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Map wide integer wrapping spellings to exact binary signatures.`)

	(use wove-file "./types.wove" (only builtin_type_keyword is_16bit_integer (value i16_type) (value u16_type) (value i64_type)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct IntegerOperator (fields (operand u32) (result u32) (symbol u8)))

	(let first_i16_operator 180u32)
	(let first_u16_operator 184u32)
	(let first_i64_operator 205u32)
	(let add_head ".add")
	(let subtract_head ".sub")
	(let multiply_head ".mul")

	(fn read_integer_operator
		(:doc `Accept a complete integer prefix and an operation suffix supported by that width.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (i32.sub (local end) (local start)))
			(if
				(:doc "The supported wrapping arithmetic tags have a fixed width.")
				(bool.not (i32.eq (local width) 7i32))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) 3i32))
			(let wide (u32.eq (local type) (local i64_type)))
			(if (bool.not (bool.or (local wide) (call is_16bit_integer (local type)))) (then (return 0u32)))
			(let suffix (i32.add (local start) 3i32))
			(let-mut base (local first_i16_operator))
			(if (u32.eq (local type) (local u16_type)) (then (set (local base) (local first_u16_operator))))
			(if (local wide) (then (set (local base) (local first_i64_operator))))
			(if
				(:doc "Wrapping addition retains the operand type.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local add_head)) 0i32 (array.len (local add_head)))
				(then (return (u32.add (local base) 2u32))))
			(if
				(:doc "Wrapping subtraction retains the operand type.")
				(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local subtract_head)) 0i32 (array.len (local subtract_head)))
				(then (return (u32.add (local base) 3u32))))
			(if
				(:doc "The signed 64-bit group also has wrapping multiplication.")
				(bool.and (local wide) (call same_bytes (borrow-shared (local source)) (local suffix) (local end)
					(borrow-shared (local multiply_head)) 0i32 (array.len (local multiply_head))))
				(then (return (u32.add (local base) 4u32))))
			(return 0u32)))

	(fn integer_operator
		(:doc `Decode a checked opcode as an exact wrapping arithmetic signature.`)
		(params (kind u32))
		(returns IntegerOperator)
		(body
			(let wide (bool.and (bool.not (u32.lt (local kind) (local first_i64_operator)))
				(u32.lt (local kind) (u32.add (local first_i64_operator) 5u32))))
			(if
				(:doc "Only the 16-bit groups and the signed 64-bit group have a signature here.")
				(bool.and (bool.not (local wide))
					(bool.or (u32.lt (local kind) (local first_i16_operator))
						(bool.not (u32.lt (local kind) (u32.add (local first_u16_operator) 4u32)))))
				(then (return (struct.new IntegerOperator (operand 0u32) (result 0u32) (symbol 0u8)))))
			(let-mut type (local i16_type))
			(let-mut base (local first_i16_operator))
			(if
				(:doc "Each group uses the same slots for addition and subtraction.")
				(bool.not (u32.lt (local kind) (local first_u16_operator)))
				(then
					(set (local type) (local u16_type))
					(set (local base) (local first_u16_operator))))
			(if
				(:doc "The higher opcode group describes i64 operands.")
				(local wide)
				(then
					(set (local type) (local i64_type))
					(set (local base) (local first_i64_operator))))
			(let slot (u32.sub (local kind) (local base)))
			(if
				(:doc "Skip the old comparison slots while retaining the wrapping opcodes.")
				(u32.lt (local slot) 2u32)
				(then (return (struct.new IntegerOperator (operand 0u32) (result 0u32) (symbol 0u8)))))
			(let-mut symbol 43u8)
			(if (u32.eq (local slot) 3u32) (then (set (local symbol) 45u8)))
			(if (u32.eq (local slot) 4u32) (then (set (local symbol) 42u8)))
			(return (struct.new IntegerOperator (operand (local type)) (result (local type)) (symbol (local symbol)))))))
