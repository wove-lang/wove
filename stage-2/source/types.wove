(module source_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Classify built-in type spellings for source parsing and type namespace checks.

	Keep the scalar compiler's keyword codes for primitive and byte-view types.
	Recognize void for result types and reserve the seed's owned-array spelling.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./scan.wove" (only (type SourceNode)))

	(fn is_shared_ref_head
		(:doc `Match the full shared-ref spelling at a parameter type's head.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (head i32))
		(returns bool)
		(body
			(if
				(:doc "A bare type has no form head.")
				(i32.lt (local head) 0i32)
				(then (return (bool false))))
			(let node (slice.load (local nodes) (local head)))
			(let start (struct.get (local node) start))
			(return (bool.and (i32.eq (i32.sub.wrapping (struct.get (local node) end) (local start)) 10i32)
				(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 115u8 104u8 97u8)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32)
						114u8 101u8 100u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 6i32)
							45u8 114u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 9i32 102u8))))))))


	(fn reference_mode
		(:doc `Classify a reference type head as shared (1), mutable (2), or absent (0).`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (head i32))
		(returns u32)
		(body
			(if (i32.lt (local head) 0i32) (then (return 0u32)))
			(if
				(:doc "Use the shared mode before checking the distinct mutable spelling.")
				(call is_shared_ref_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local head))
				(then (return 1u32)))
			(let node (slice.load (local nodes) (local head)))
			(let start (struct.get (local node) start))
			(if
				(:doc "Match the complete mut-ref tag.")
				(bool.and (i32.eq (i32.sub.wrapping (struct.get (local node) end) (local start)) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 109u8 117u8 116u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32)
							45u8 114u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 102u8))))
				(then (return 2u32)))
			(return 0u32)))

	(fn void_type
		(:doc `Identify the result type of a function that produces no value.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 59u32)))

	(fn is_builtin_integer
		(:doc `Recognize the exact built-in integer value types.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) 5u32)
			(bool.or (u32.eq (local type) 61u32)
				(bool.or (u32.eq (local type) 10u32)
					(bool.or (u32.eq (local type) 11u32) (u32.eq (local type) 54u32))))))))

	(fn builtin_type_keyword
		(:doc `Read a complete built-in type spelling from a checked byte span.

		Return 5 for i32, 10 for u8, 11 for u32, 12 for bool,
		34 for shared-slice, 38 for mut-slice, 59 for void, 61 for i8, and 54 for u64.
		Other spellings return 0.`)
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Match the entire i32 keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source))
						(local start) 105u8 51u8 50u8))
				(then (return 5u32)))
			(if
				(:doc "Match the entire i8 keyword.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 105u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 56u8)))
				(then (return 61u32)))
			(if
				(:doc "Match the entire u8 keyword.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 117u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 56u8)))
				(then (return 10u32)))
			(if
				(:doc "Match the entire u32 keyword.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 117u8 51u8 50u8))
				(then (return 11u32)))
			(if
				(:doc "Match the entire u64 keyword.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 117u8 54u8 52u8))
				(then (return 54u32)))
			(if
				(:doc "Match the entire bool keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 98u8 111u8 111u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)))
				(then (return 12u32)))
			(if
				(:doc "Match the entire void result type.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 118u8 111u8 105u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 100u8)))
				(then (return (call void_type))))
			(if
				(:doc "Match the three groups of the mut-slice spelling.")
				(bool.and (i32.eq (local width) 9i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 109u8 117u8 116u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 3i32) 45u8 115u8 108u8)
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 6i32) 105u8 99u8 101u8))))
				(then (return 38u32)))
			(if
				(:doc "A shared-slice type has the shared- prefix and the slice suffix.")
				(bool.and (i32.eq (local width) 12i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 115u8 104u8 97u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 3i32) 114u8 101u8 100u8)
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) 6i32) 45u8 115u8 108u8)
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) 9i32) 105u8 99u8 101u8)))))
				(then (return 34u32)))
			(return 0u32)))

	(fn source_builtin_type
		(:doc `Identify a complete bare built-in type spelling on a checked source row.`)
		(params (source (shared-slice u8)) (node SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Only atoms can name built-in types.")
				(bool.not (u32.eq (struct.get (local node) kind) 1u32))
				(then (return 0u32)))
			(let start (struct.get (local node) start))
			(return (call builtin_type_keyword (borrow-shared (local source)) (local start)
				(i32.sub.wrapping (struct.get (local node) end) (local start))))))

	(fn is_owned_array_name
		(:doc `Match the exact owned-array spelling in a type head.`)
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns bool)
		(body
			(return (bool.and (i32.eq (local width) 11i32)
				(bool.and
					(call is_three_bytes (borrow-shared (local source)) (local start) 111u8 119u8 110u8)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) 3i32) 101u8 100u8 45u8)
						(bool.and (call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 6i32) 97u8 114u8 114u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 9i32 97u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 10i32 121u8)))))))))

	(fn is_reserved_type_name
		(:doc `Check whether a bare name is reserved for a built-in type.`)
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns bool)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(return (bool.or
				(u32.lt 0u32 (call builtin_type_keyword (borrow-shared (local source)) (local start) (local width)))
				(call is_owned_array_name (borrow-shared (local source)) (local start) (local width)))))))
