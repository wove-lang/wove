(module source_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Classify built-in type spellings for source parsing and type namespace checks.

	Keep the scalar compiler's keyword codes for primitive and byte-view types.
	Recognize void for result types and reserve the seed's owned-array spelling.
	The internal worker receipt and queue types are inferred and have no source spellings.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./scan.wove" (only (type SourceNode)))

	(fn is_shared_ref_head
		(:doc `Match the full shared-ref spelling at a parameter type's head.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (head i32))
		(returns bool)
		(body
			(if
				(:doc "A bare type has no form head.")
				(i32.ltz (local head))
				(then (return (bool false))))
			(let node (array.load (local nodes) (local head)))
			(let start (struct.get (local node) start))
			(return (bool.and (i32.eq (i32.sub (struct.get (local node) end) (local start)) 10i32)
				(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 115u8 104u8 97u8)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32)
						114u8 101u8 100u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 6i32)
							45u8 114u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 9i32 102u8))))))))


	(fn reference_mode
		(:doc `Classify a reference type head as shared (1), mutable (2), or absent (0).`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (head i32))
		(returns u32)
		(body
			(if (i32.ltz (local head)) (then (return 0u32)))
			(if
				(:doc "Use the shared mode before checking the distinct mutable spelling.")
				(call is_shared_ref_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local head))
				(then (return 1u32)))
			(let node (array.load (local nodes) (local head)))
			(let start (struct.get (local node) start))
			(if
				(:doc "Match the complete mut-ref tag.")
				(bool.and (i32.eq (i32.sub (struct.get (local node) end) (local start)) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 109u8 117u8 116u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32)
							45u8 114u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 102u8))))
				(then (return 2u32)))
			(return 0u32)))

	(fn void_type
		(:doc `Identify the result type of a function that produces no value.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 59u32)))

	(let i16_type 46u32)
	(let u16_type 47u32)
	(let i64_type 18u32)
	(let i128_type 19u32)
	(let u128_type 20u32)
	(let worker_receipt_type 21u32)
	(let worker_queue_type 26u32)

	(fn is_16bit_integer
		(:doc `Recognize both signed and unsigned 16-bit integer types.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) (local i16_type)) (u32.eq (local type) (local u16_type))))))

	(fn is_64bit_integer
		(:doc `Recognize integers with a full 64-bit native representation.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) (local i64_type)) (u32.eq (local type) 54u32)))))

	(fn is_128bit_integer
		(:doc "Recognize the two types with a 128-bit native integer representation.")
		(:pragma (inline always))
		(params (type u32)) (returns bool)
		(body (return (bool.or (u32.eq (local type) (local i128_type)) (u32.eq (local type) (local u128_type))))))

	(fn is_signed_builtin_integer
		(:doc `Classify built-in integers with signed ranges and two's complement byte encodings.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) 5u32)
			(bool.or (u32.eq (local type) 61u32)
				(bool.or (u32.eq (local type) (local i16_type))
					(bool.or (u32.eq (local type) (local i64_type)) (u32.eq (local type) (local i128_type)))))))))

	(fn is_builtin_integer
		(:doc `Recognize the exact built-in integer value types.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_signed_builtin_integer (local type))
			(bool.or (u32.eq (local type) (local u16_type))
				(bool.or (u32.eq (local type) (local u128_type))
					(bool.or (u32.eq (local type) 10u32)
						(bool.or (u32.eq (local type) 11u32) (u32.eq (local type) 54u32)))))))))

	(let f16_type 62u32)
	(let f32_type 45u32)
	(let f64_type 51u32)
	(let f80_type 60u32)
	(let f128_type 63u32)

	(fn is_builtin_float
		(:doc `Recognize the built-in floating types.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) (local f16_type))
			(bool.or (u32.eq (local type) (local f32_type))
				(bool.or (u32.eq (local type) (local f64_type))
					(bool.or (u32.eq (local type) (local f80_type)) (u32.eq (local type) (local f128_type)))))))))

	(fn is_builtin_numeric
		(:doc "Recognize the built-in integer and floating element types.")
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_builtin_integer (local type)) (call is_builtin_float (local type))))))

	(fn is_builtin_scalar
		(:doc `Recognize primitive copyable values accepted in signatures and fields.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_builtin_numeric (local type)) (u32.eq (local type) 12u32)))))

	(fn numeric_prefix_width
		(:doc "Return the width before the first supported type separator, or zero if there is no dot.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let width (i32.sub (local end) (local start)))
			(if
				(:doc "Byte types use two bytes before the dot.")
				(bool.and (i32.lt 2i32 (local width))
					(call is_head_byte (borrow-shared (local source)) (local start) 2i32 46u8))
				(then (return 2i32)))
			(if
				(:doc "The 16-, 32-, 64-, and 80-bit names have three bytes.")
				(bool.and (i32.lt 3i32 (local width))
					(call is_head_byte (borrow-shared (local source)) (local start) 3i32 46u8))
				(then (return 3i32)))
			(if
				(:doc "The 128-bit names have four bytes.")
				(bool.and (i32.lt 4i32 (local width))
					(call is_head_byte (borrow-shared (local source)) (local start) 4i32 46u8))
				(then (return 4i32)))
			(return 0i32)))

	(fn builtin_type_keyword
		(:doc `Read a complete built-in type spelling from a checked byte span.

		Return 5 for i32, 10 for u8, 11 for u32, 12 for bool,
		34 for shared-array, 38 for mut-array, 59 for void, 61 for i8, and 54 for u64.
		Return 62 for f16, 45 for f32, 51 for f64, 60 for f80, 63 for f128, 46 for i16, 47 for u16, and 18 for i64.
		Return 19 for i128 and 20 for u128. Other spellings return 0.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "The 128-bit pair shares a complete numeric suffix and differs in signedness.")
				(bool.and (i32.eq (local width) 4i32)
					(call is_three_bytes (borrow-shared (local source)) (i32.inc (local start)) 49u8 50u8 56u8))
				(then
					(if (call is_head_byte (borrow-shared (local source)) (local start) 0i32 105u8) (then (return (local i128_type))))
					(if (call is_head_byte (borrow-shared (local source)) (local start) 0i32 117u8) (then (return (local u128_type))))))
			(if
				(:doc "Match the entire i32 keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source))
						(local start) 105u8 51u8 50u8))
				(then (return 5u32)))
			(if
				(:doc "Match the signed 16-bit keyword at its full width.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 105u8 49u8 54u8))
				(then (return (local i16_type))))
			(if
				(:doc "Match the unsigned 16-bit keyword at its full width.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 117u8 49u8 54u8))
				(then (return (local u16_type))))
			(if
				(:doc "Match the entire i8 keyword.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 105u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 56u8)))
				(then (return 61u32)))
			(if
				(:doc "Match the entire u8 keyword.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 117u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 56u8)))
				(then (return 10u32)))
			(if
				(:doc "Match the entire u32 keyword.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 117u8 51u8 50u8))
				(then (return 11u32)))
			(if
				(:doc "Match the entire i64 keyword.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 105u8 54u8 52u8))
				(then (return (local i64_type))))
			(if
				(:doc "Match the entire u64 keyword.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 117u8 54u8 52u8))
				(then (return 54u32)))
			(if
				(:doc "Float keywords have exactly three bytes.")
				(i32.eq (local width) 3i32)
				(then
					(if
						(:doc "Match the binary16 spelling.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 49u8 54u8)
						(then (return (local f16_type))))
					(if
						(:doc "Match the binary32 spelling.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 51u8 50u8)
						(then (return (local f32_type))))
					(if
						(:doc "Match the binary64 spelling.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 54u8 52u8)
						(then (return (local f64_type))))
					(if
						(:doc "Match the extended-precision spelling.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 56u8 48u8)
						(then (return (local f80_type))))))
			(if
				(:doc "Match the complete binary128 keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 102u8 49u8 50u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 56u8)))
				(then (return (local f128_type))))
			(if
				(:doc "Match the entire bool keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 98u8 111u8 111u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)))
				(then (return 12u32)))
			(if
				(:doc "Match the entire void result type.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 118u8 111u8 105u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 100u8)))
				(then (return (call void_type))))
			(if
				(:doc "Match the three groups of the mut-array spelling.")
				(bool.and (i32.eq (local width) 9i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 109u8 117u8 116u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 3i32) 45u8 97u8 114u8)
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 6i32) 114u8 97u8 121u8))))
				(then (return 38u32)))
			(if
				(:doc "A shared-array type has the shared- prefix and the array suffix.")
				(bool.and (i32.eq (local width) 12i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 115u8 104u8 97u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 3i32) 114u8 101u8 100u8)
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add (local start) 6i32) 45u8 97u8 114u8)
								(call is_three_bytes (borrow-shared (local source))
									(i32.add (local start) 9i32) 114u8 97u8 121u8)))))
				(then (return 34u32)))
			(return 0u32)))

	(fn source_builtin_type
		(:doc `Identify a complete bare built-in type spelling on a checked source row.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Only atoms can name built-in types.")
				(u32.not-eq (struct.get (local node) kind) 1u32)
				(then (return 0u32)))
			(let start (struct.get (local node) start))
			(return (call builtin_type_keyword (borrow-shared (local source)) (local start)
				(i32.sub (struct.get (local node) end) (local start))))))

	(fn is_owned_array_name
		(:doc `Match the exact owned-array spelling in a type head.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns bool)
		(body
			(return (bool.and (i32.eq (local width) 11i32)
				(bool.and
					(call is_three_bytes (borrow-shared (local source)) (local start) 111u8 119u8 110u8)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(i32.add (local start) 3i32) 101u8 100u8 45u8)
						(bool.and (call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 6i32) 97u8 114u8 114u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 9i32 97u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 10i32 121u8)))))))))

	(fn is_reserved_type_name
		(:doc `Check whether a bare name is reserved for a built-in type.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(let width (i32.sub (local end) (local start)))
			(return (bool.or
				(u32.gtz (call builtin_type_keyword (borrow-shared (local source)) (local start) (local width)))
				(call is_owned_array_name (borrow-shared (local source)) (local start) (local width)))))))
