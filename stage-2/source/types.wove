(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Classify built-in type spellings for source parsing and type namespace checks.

	Keep the scalar compiler's keyword codes for primitive and byte-view types.
	Reserve the seed's void and owned-array spellings as type names.`)
	source_types

	(use wove-file "./scan.wove" (only is_head_byte))
	(use wove-file "./module.wove" (only is_three_bytes))

	(fn
		(:doc `Read a complete built-in type spelling from a checked byte span.

		Return 5 for i32, 10 for u8, 11 for u32, 12 for bool,
		34 for shared-slice, and 38 for mut-slice. Other spellings return 0.`)
		builtin_type_keyword
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Match the entire i32 keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 3))
					(call is_three_bytes (borrow-shared (local source))
						(local start) (u8 105) (u8 51) (u8 50)))
				(then (return (u32 5))))
			(if
				(:doc "Match the entire u8 keyword.")
				(bool.and (i32.eq (local width) (i32 2))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 117))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 56))))
				(then (return (u32 10))))
			(if
				(:doc "Match the entire u32 keyword.")
				(bool.and (i32.eq (local width) (i32 3))
					(call is_three_bytes (borrow-shared (local source)) (local start) (u8 117) (u8 51) (u8 50)))
				(then (return (u32 11))))
			(if
				(:doc "Match the entire bool keyword.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) (u8 98) (u8 111) (u8 111))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 108))))
				(then (return (u32 12))))
			(if
				(:doc "Match the three groups of the mut-slice spelling.")
				(bool.and (i32.eq (local width) (i32 9))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 109) (u8 117) (u8 116))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 45) (u8 115) (u8 108))
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 6)) (u8 105) (u8 99) (u8 101)))))
				(then (return (u32 38))))
			(if
				(:doc "A shared-slice type has the shared- prefix and the slice suffix.")
				(bool.and (i32.eq (local width) (i32 12))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 115) (u8 104) (u8 97))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 114) (u8 101) (u8 100))
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 6)) (u8 45) (u8 115) (u8 108))
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 9)) (u8 105) (u8 99) (u8 101))))))
				(then (return (u32 34))))
			(return (u32 0))))

	(fn
		(:doc `Check whether a bare name is reserved for a built-in type in the seed.`)
		is_reserved_type_name
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns bool)
		(body
			(let width (i32.sub.wrapping (local end) (local start)))
			(if
				(:doc "Use the same spelling checks as the scalar compiler.")
				(u32.lt (u32 0) (call builtin_type_keyword (borrow-shared (local source)) (local start) (local width)))
				(then (return (bool true))))
			(if
				(:doc "The seed reserves the full void spelling.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) (u8 118) (u8 111) (u8 105))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 100))))
				(then (return (bool true))))
			(if
				(:doc "Match the exact owned-array spelling at its full width.")
				(i32.eq (local width) (i32 11))
				(then (return (bool.and
					(call is_three_bytes (borrow-shared (local source)) (local start) (u8 111) (u8 119) (u8 110))
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) (i32 3)) (u8 101) (u8 100) (u8 45))
						(bool.and (call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 6)) (u8 97) (u8 114) (u8 114))
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 9) (u8 97))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 10) (u8 121)))))))))
			(return (bool false)))))
