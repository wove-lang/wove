(module source_c_provider_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Map system header keys to stable bundled identities and supported on-disk spellings.")

	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct ProviderRequest
		(:doc "Carry the original source view of the system header literal to the loader.")
		(fields (file i32) (start i32) (end i32)))
	(let provider_prefix "/c-stdlib/")
	(let provider_suffix ".wove")

	(fn has_provider_request
		(:doc "A nonnegative source file identifies the one pending lookup in the disk graph.")
		(params (pending (shared-array ProviderRequest))) (returns bool)
		(body (return (bool.and (i32.gtz (array.len pending))
			(i32.not-ltz (struct.get (array.load pending 0i32) file))))))

	(fn provider_stem_byte
		(:doc "Recognize the portable filename bytes used by the bundled header tree.")
		(params (byte u8)) (returns bool)
		(body (return (bool.or
			(bool.or (bool.and (u8.not-lt byte 65u8) (u8.not-lt 90u8 byte))
				(bool.and (u8.not-lt byte 97u8) (u8.not-lt 122u8 byte)))
			(bool.or (bool.and (u8.not-lt byte 48u8) (u8.not-lt 57u8 byte))
				(bool.or (u8.eq byte 45u8) (u8.eq byte 95u8)))))))

	(fn bundled_key
		(:doc "Only a bracketed .h key with nonempty safe path components can name a bundled provider.")
		(params (key (shared-array u8))) (returns bool)
		(body
			(let length (array.len key))
			(if
				(:doc "Reserve enough space for the stem, delimiters, and virtual-path affixes.")
				(bool.or (bool.or (i32.lt length 5i32) (i32.lt 2147483631i32 length))
					(bool.or (u8.not-eq (array.load key 0i32) 60u8)
						(bool.or (u8.not-eq (array.load key (i32.sub length 3i32)) 46u8)
							(bool.or (u8.not-eq (array.load key (i32.sub length 2i32)) 104u8)
								(u8.not-eq (array.load key (i32.dec length)) 62u8)))))
				(then (return (bool false))))
			(let finish (i32.sub length 3i32))
			(let-mut component (bool false))
			(let-mut cursor 1i32)
			(while
				(:doc "Disallow empty components and any byte that changes how the host resolves the path.")
				(i32.lt cursor finish)
				(body
					(let byte (array.load key cursor))
					(if
						(:doc "A slash terminates a nonempty filename component.")
						(u8.eq byte 47u8)
						(then
							(if (bool.not component) (then (return (bool false))))
							(set component (bool false)))
						(else
							(if (bool.not (call provider_stem_byte byte)) (then (return (bool false))))
							(set component (bool true))))
					(set cursor (i32.inc cursor))))
			(return component)))

	(fn provider_path_width
		(:doc "Size the canonical virtual path for a validated header key.")
		(params (key (shared-array u8))) (returns i32)
		(body (return (i32.add (array.len provider_prefix)
			(i32.add (i32.sub (array.len key) 2i32) (array.len provider_suffix))))))

	(fn write_provider_path
		(:doc "Write the canonical path, its flat equivalent, or the legacy flat path without .h.")
		(params (key (shared-array u8)) (style i32) (output (mut-array u8))) (returns i32)
		(body
			(let-mut cursor 1i32)
			(let-mut finish (i32.dec (array.len key)))
			(if (i32.eq style 2i32) (then (set finish (i32.sub finish 2i32))))
			(let-mut written (call append_bytes (borrow-shared provider_prefix) (borrow-mut output) 0i32))
			(while
				(:doc "Flatten slashes only in the compatibility spellings.")
				(i32.lt cursor finish)
				(body
					(let-mut byte (array.load key cursor))
					(if (bool.and (i32.gtz style) (u8.eq byte 47u8)) (then (set byte 95u8)))
					(array.store output written byte)
					(set written (i32.inc written))
					(set cursor (i32.inc cursor))))
			(return (call append_bytes (borrow-shared provider_suffix) (borrow-mut output) written))))

	(fn find_bundled_path
		(:doc "Reuse a bundled row by its exact virtual spelling, including a recorded absence.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (path (shared-array u8)))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Project files never stand in for a bundled path.")
				(i32.lt row (array.len files))
				(body
					(let file (array.load files row))
					(if
						(:doc "Compare the entire virtual path of each published bundled row.")
						(bool.and (struct.get file bundled)
							(call same_bytes (borrow-shared arena) (struct.get file path_start) (struct.get file path_end)
								(borrow-shared path) 0i32 (array.len path)))
						(then (return row)))
					(set row (i32.inc row))))
			(return -1i32)))
)
