(module source_numeric_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read named numeric conversions and their byte or bit representations from an operation tag.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./receiver_words.wove" (only receiver_separator (value receiver_call_head)))
	(use wove-file "./types.wove" (only builtin_type_keyword numeric_prefix_width is_builtin_integer_value is_builtin_float is_16bit_integer is_64bit_integer is_128bit_integer is_256bit_integer
		(value f16_type) (value f32_type) (value f64_type) (value u16_type)))
	(use wove-file "./float_ops.wove" (only (value float_conversion) (value float_from_bits) (value float_to_bits)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct NamedConversion (fields (kind u32) (type u32) (operand u32)))

	(let encode_little 108u32)
	(let encode_big 109u32)
	(let decode_little 110u32)
	(let decode_big 111u32)
	(let typed_integer_conversion 112u32)
	(let exact_byte_view 52u32)
	(let to_le_bytes "to-le-bytes")
	(let to_be_bytes "to-be-bytes")
	(let from_le_bytes ":from-le-bytes")
	(let from_be_bytes ":from-be-bytes")
	(let from_numeric ":from-")
	(let from_bits ":from-bits")
	(let to_bits "to-bits")

	(fn integer_byte_width
		(:doc `Return the logical byte width of a verified builtin integer type.`)
		(params (type u32))
		(returns i32)
		(body
			(if (bool:or (type.eq 10u32) (type.eq 61u32)) (then (return 1i32)))
			(if (call is_16bit_integer type) (then (return 2i32)))
			(if (call is_128bit_integer type) (then (return 16i32)))
			(if (call is_256bit_integer type) (then (return 32i32)))
			(if (call is_64bit_integer type) (then (return 8i32)))
			(return 4i32)))

	(fn is_integer_byte_encoder
		(:doc `Recognize an operation that produces an inline byte array.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq encode_little) (kind.eq encode_big)))))

	(fn is_integer_byte_conversion
		(:doc `Recognize the four checked IR operations for integer byte conversions.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:and (kind.not-lt encode_little) (kind.lt typed_integer_conversion)))))

	(fn integer_bytes_big_endian
		(:doc `Read the byte order from either direction's checked opcode.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq encode_big) (kind.eq decode_big)))))

	(fn integer_encoding_operation
		(:doc "Look up a complete endian encoder suffix.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Little-endian encoding puts the low byte first.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared to_le_bytes) 0i32 to_le_bytes.len)
				(then (return encode_little)))
			(if
				(:doc "Big-endian encoding reverses the order of the same fixed-width bytes.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared to_be_bytes) 0i32 to_be_bytes.len)
				(then (return encode_big)))
			(return 0u32)))

	(fn receiver_may_encode_bytes
		(:doc "Find a dotted endian encoder before its lexical receiver width is available.")
		(params (source (shared-array u8)) (head SourceNode))
		(returns bool)
		(body
			(if (u32:not-eq head/kind receiver_call_head) (then (return (bool false))))
			(let dot (call receiver_separator (borrow-shared source) head/start head/end))
			(return (bool:and dot.not-ltz
				(u32:gtz (call integer_encoding_operation (borrow-shared source) dot.inc head/end))))))

	(fn float_bit_word
		(:doc "Find the unsigned storage word for a float with an exact bit-copy operation.")
		(params (type u32)) (returns u32)
		(body
			(if (type.eq f16_type) (then (return u16_type)))
			(if (type.eq f32_type) (then (return 11u32)))
			(if (type.eq f64_type) (then (return 54u32)))
			(return 0u32)))

	(fn read_value_encoding
		(:doc "Read an encoding whose source is the receiver's static type.")
		(params (source (shared-array u8)) (start i32) (end i32) (type u32))
		(returns NamedConversion)
		(body
			(if
				(:doc "An integer encoder produces an array at the source word's width.")
				(call is_builtin_integer_value type)
				(then
					(let kind (call integer_encoding_operation (borrow-shared source) start end))
					(if kind.gtz
						(then (return (struct:new NamedConversion (kind kind) (type type) (operand type)))))))
			(let bits (call float_bit_word type))
			(if
				(:doc "A float bit copy preserves its exact storage representation.")
				(bool:and bits.gtz
					(call same_bytes (borrow-shared source) start end (borrow-shared to_bits) 0i32 to_bits.len))
				(then (return (struct:new NamedConversion (kind float_to_bits) (type bits) (operand type)))))
			(return (struct:new NamedConversion (kind 0u32) (type 0u32) (operand 0u32)))))

	(fn read_named_conversion
		(:doc `Match an exact numeric type prefix and one complete conversion suffix.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns NamedConversion)
		(body
			(let none (struct:new NamedConversion (kind 0u32) (type 0u32) (operand 0u32)))
			(let start head/start)
			(let end head/end)
			(if
				(:doc "The shortest conversion head is ten bytes.")
				(bool:or (u32:not-eq head/kind 1u32)
					(i32:lt (end.sub start) 10i32))
				(then (return none)))
			(let width (call numeric_prefix_width (borrow-shared source) start end))
			(if width.eqz (then (return none)))
			(let type (call builtin_type_keyword (borrow-shared source) start width))
			(let floating (call is_builtin_float type))
			(if
				(:doc "Only builtin numeric types have typed conversion heads.")
				(bool:not (floating.or (call is_builtin_integer_value type)))
				(then (return none)))
			(let suffix (start.add width))
			(let encoded (call read_value_encoding (borrow-shared source) suffix.inc end type))
			(if (u32:gtz encoded/kind) (then (return encoded)))
			(if
				(:doc "A decoder accepts an exact shared byte view, or forms one from an explicit loan.")
				(bool:and floating.not
					(call same_bytes (borrow-shared source) suffix end
						(borrow-shared from_le_bytes) 0i32 from_le_bytes.len))
				(then (return (struct:new NamedConversion (kind decode_little) (type type) (operand exact_byte_view)))))
			(if
				(:doc "Decode big-endian bytes into the same destination type.")
				(bool:and floating.not
					(call same_bytes (borrow-shared source) suffix end
						(borrow-shared from_be_bytes) 0i32 from_be_bytes.len))
				(then (return (struct:new NamedConversion (kind decode_big) (type type) (operand exact_byte_view)))))
			(let bits (call float_bit_word type))
			(if
				(:doc "Decoding a float's bits requires the unsigned word of the same storage width.")
				(bool:and bits.gtz
					(call same_bytes (borrow-shared source) suffix end
						(borrow-shared from_bits) 0i32 from_bits.len))
				(then (return (struct:new NamedConversion (kind float_from_bits) (type type) (operand bits)))))
			(let operand (suffix.add from_numeric.len))
			(if
				(:doc "A typed numerical conversion requires the complete :from- prefix.")
				(bool:or (operand.not-lt end)
					(bool:not (call same_bytes (borrow-shared source) suffix operand
						(borrow-shared from_numeric) 0i32 from_numeric.len)))
				(then (return none)))
			(let origin (call builtin_type_keyword (borrow-shared source) operand
				(end.sub operand)))
			(let float_origin (call is_builtin_float origin))
			(if
				(:doc "The source suffix must name one exact builtin numeric type.")
				(bool:not (float_origin.or (call is_builtin_integer_value origin)))
				(then (return none)))
			(let-mut kind typed_integer_conversion)
			(if
				(:doc "Mixed-width float conversions use the floating range rules.")
				(floating.or float_origin)
				(then (set kind float_conversion)))
			(return (struct:new NamedConversion (kind kind) (type type) (operand origin))))))
