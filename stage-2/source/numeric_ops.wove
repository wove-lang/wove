(module source_numeric_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read named numeric conversions and their byte or bit representations from an operation tag.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./types.wove" (only builtin_type_keyword numeric_prefix_width is_builtin_integer_value is_builtin_float is_16bit_integer is_64bit_integer is_128bit_integer is_256bit_integer
		(value f16_type) (value f32_type) (value f64_type) (value u16_type)))
	(use wove-file "./float_ops.wove" (only (value float_conversion) (value float_from_bits) (value float_to_bits)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct NamedConversion (fields (kind u32) (type u32) (operand u32)))

	(let encode_little 108u32)
	(let encode_big 109u32)
	(let decode_little 110u32)
	(let decode_big 111u32)
	(let typed_integer_conversion 112u32)
	(let exact_byte_view 52u32)
	(let to_le_bytes ".to-le-bytes")
	(let to_be_bytes ".to-be-bytes")
	(let from_le_bytes ".from-le-bytes")
	(let from_be_bytes ".from-be-bytes")
	(let from_numeric ".from-")
	(let from_bits ".from-bits")
	(let to_bits ".to-bits")

	(fn integer_byte_width
		(:doc `Return the logical byte width of a verified builtin integer type.`)
		(params (type u32))
		(returns i32)
		(body
			(if (bool.or (u32.eq (local type) 10u32) (u32.eq (local type) 61u32)) (then (return 1i32)))
			(if (call is_16bit_integer (local type)) (then (return 2i32)))
			(if (call is_128bit_integer (local type)) (then (return 16i32)))
			(if (call is_256bit_integer (local type)) (then (return 32i32)))
			(if (call is_64bit_integer (local type)) (then (return 8i32)))
			(return 4i32)))

	(fn is_integer_byte_encoder
		(:doc `Recognize an operation that produces an inline byte array.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local encode_little)) (u32.eq (local kind) (local encode_big))))))

	(fn is_integer_byte_conversion
		(:doc `Recognize the four checked IR operations for integer byte conversions.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local encode_little)) (u32.lt (local kind) (local typed_integer_conversion))))))

	(fn integer_bytes_big_endian
		(:doc `Read the byte order from either direction's checked opcode.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local encode_big)) (u32.eq (local kind) (local decode_big))))))

	(fn read_named_conversion
		(:doc `Match an exact numeric type prefix and one complete conversion suffix.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns NamedConversion)
		(body
			(let none (struct.new NamedConversion (kind 0u32) (type 0u32) (operand 0u32)))
			(let start (struct.get (local head) start))
			(let end (struct.get (local head) end))
			(if
				(:doc "The shortest conversion head is ten bytes.")
				(bool.or (u32.not-eq (struct.get (local head) kind) 1u32)
					(i32.lt (i32.sub (local end) (local start)) 10i32))
				(then (return (local none))))
			(let width (call numeric_prefix_width (borrow-shared (local source)) (local start) (local end)))
			(if (i32.eqz (local width)) (then (return (local none))))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local width)))
			(let floating (call is_builtin_float (local type)))
			(if
				(:doc "Only builtin numeric types have typed conversion heads.")
				(bool.not (bool.or (local floating) (call is_builtin_integer_value (local type))))
				(then (return (local none))))
			(let suffix (i32.add (local start) (local width)))
			(if
				(:doc "An encoder's source is the integer named at the head.")
				(bool.and (bool.not (local floating))
					(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
						(borrow-shared (local to_le_bytes)) 0i32 (array.len (local to_le_bytes))))
				(then (return (struct.new NamedConversion (kind (local encode_little)) (type (local type)) (operand (local type))))))
			(if
				(:doc "Big-endian encoders reverse the order of the same fixed-width bytes.")
				(bool.and (bool.not (local floating))
					(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
						(borrow-shared (local to_be_bytes)) 0i32 (array.len (local to_be_bytes))))
				(then (return (struct.new NamedConversion (kind (local encode_big)) (type (local type)) (operand (local type))))))
			(if
				(:doc "A decoder accepts an exact shared byte view, or forms one from an explicit loan.")
				(bool.and (bool.not (local floating))
					(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
						(borrow-shared (local from_le_bytes)) 0i32 (array.len (local from_le_bytes))))
				(then (return (struct.new NamedConversion (kind (local decode_little)) (type (local type)) (operand (local exact_byte_view))))))
			(if
				(:doc "Decode big-endian bytes into the same destination type.")
				(bool.and (bool.not (local floating))
					(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
						(borrow-shared (local from_be_bytes)) 0i32 (array.len (local from_be_bytes))))
				(then (return (struct.new NamedConversion (kind (local decode_big)) (type (local type)) (operand (local exact_byte_view))))))
			(if
				(:doc "Bit copies require a built-in integer with the exact floating storage width.")
				(bool.or (u32.eq (local type) (local f16_type))
					(bool.or (u32.eq (local type) (local f32_type)) (u32.eq (local type) (local f64_type))))
				(then
					(let-mut bits 54u32)
					(if (u32.eq (local type) (local f16_type)) (then (set (local bits) (local u16_type))))
					(if (u32.eq (local type) (local f32_type)) (then (set (local bits) 11u32)))
					(if
						(:doc "Reinterpret an unsigned word as a float.")
						(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
							(borrow-shared (local from_bits)) 0i32 (array.len (local from_bits)))
						(then (return (struct.new NamedConversion (kind (local float_from_bits)) (type (local type)) (operand (local bits))))))
					(if
						(:doc "Read the float's unchanged representation into an unsigned word.")
						(call same_bytes (borrow-shared (local source)) (local suffix) (local end)
							(borrow-shared (local to_bits)) 0i32 (array.len (local to_bits)))
						(then (return (struct.new NamedConversion (kind (local float_to_bits)) (type (local bits)) (operand (local type))))))))
			(let operand (i32.add (local suffix) (array.len (local from_numeric))))
			(if
				(:doc "A typed numerical conversion requires the complete .from- separator.")
				(bool.or (i32.not-lt (local operand) (local end))
					(bool.not (call same_bytes (borrow-shared (local source)) (local suffix) (local operand)
						(borrow-shared (local from_numeric)) 0i32 (array.len (local from_numeric)))))
				(then (return (local none))))
			(let origin (call builtin_type_keyword (borrow-shared (local source)) (local operand)
				(i32.sub (local end) (local operand))))
			(let float_origin (call is_builtin_float (local origin)))
			(if
				(:doc "The source suffix must name one exact builtin numeric type.")
				(bool.not (bool.or (local float_origin) (call is_builtin_integer_value (local origin))))
				(then (return (local none))))
			(if
				(:doc "The optional C23 integer width needs its own mixed conversion lowering.")
				(bool.or (bool.and (local float_origin) (call is_256bit_integer (local type)))
					(bool.and (local floating) (call is_256bit_integer (local origin))))
				(then (return (local none))))
			(let-mut kind (local typed_integer_conversion))
			(if
				(:doc "Mixed-width float conversions use the floating range rules.")
				(bool.or (local floating) (local float_origin))
				(then (set (local kind) (local float_conversion))))
			(return (struct.new NamedConversion (kind (local kind)) (type (local type)) (operand (local origin)))))))
