(module source_owned_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Validate the shape of owning array type descriptors.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./types.wove" (only is_owned_array_name source_builtin_type))

	(let optional_keyword "optional")
	(let optional_none 606u32)
	(let optional_some 607u32)
	(let pending_optional_some 608u32)

	(fn optional_type_operand
		(:doc "Read the one original payload descriptor inside an optional type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (struct.get parts head))
			(let operand (struct.get parts operands))
			(if
				(:doc "The wrapper has one type operand and no metadata prefix.")
				(bool.or (bool.or (i32.ltz head) (i32.ltz operand))
					(i32.not-ltz (struct.get parts metadata)))
				(then (return -1i32)))
			(let name (array.load nodes head))
			(if
				(:doc "Only the bare optional keyword introduces this wrapper.")
				(bool.not (bool.and (bool.and (u32.eq (struct.get name kind) 1u32)
					(call same_bytes (borrow-shared source) (struct.get name start) (struct.get name end)
						(borrow-shared optional_keyword) 0i32 (array.len optional_keyword)))
					(i32.ltz (struct.get (array.load nodes operand) next_sibling))))
				(then (return -1i32)))
			(return operand)))

	(fn owned_element_node
		(:doc `Read the sole element from a checked owned-array type descriptor.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (struct.get parts head))
			(let element (struct.get parts operands))
			(if
				(:doc "An owner descriptor has a head and exactly one element type.")
				(bool.or (bool.or (i32.ltz head) (i32.ltz element))
					(i32.lt -1i32 (struct.get (array.load nodes element) next_sibling)))
				(then (return -1i32)))
			(let name (array.load nodes head))
			(let start (struct.get name start))
			(if
				(:doc "Require the exact bare type keyword before validating its metadata.")
				(bool.not (bool.and (u32.eq (struct.get name kind) 1u32)
					(call is_owned_array_name (borrow-shared source) start
						(i32.sub (struct.get name end) start))))
				(then (return -1i32)))
			(let metadata (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
				node parts))
			(if
				(:doc "Only well-formed type metadata can participate in type resolution.")
				(u32.gtz (struct.get metadata error))
				(then (return -1i32)))
			(return element)))

	(fn is_byte_owner_descriptor
		(:doc `Recognize the exact (owned-array u8) descriptor.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(let element (call owned_element_node (borrow-shared source) (borrow-shared nodes) node))
			(return (bool.and (i32.lt -1i32 element)
				(u32.eq (call source_builtin_type (borrow-shared source) (array.load nodes element)) 10u32)))))

	(fn is_byte_rows_descriptor
		(:doc `Recognize a vector with one owned byte array per row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(let element (call owned_element_node (borrow-shared source) (borrow-shared nodes) node))
			(return (bool.and (i32.lt -1i32 element)
				(call is_byte_owner_descriptor (borrow-shared source) (borrow-shared nodes)
					(array.load nodes element))))))
)
