(module source_owned_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Validate the shape of owning array type descriptors.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata))
	(use wove-file "./types.wove" (only is_owned_array_name source_builtin_type))

	(fn owned_element_node
		(:doc `Read the sole element from a checked owned-array type descriptor.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (struct.get (local parts) head))
			(let element (struct.get (local parts) operands))
			(if
				(:doc "An owner descriptor has a head and exactly one element type.")
				(bool.or (bool.or (i32.lt (local head) 0i32) (i32.lt (local element) 0i32))
					(i32.lt -1i32 (struct.get (slice.load (local nodes) (local element)) next_sibling)))
				(then (return -1i32)))
			(let name (slice.load (local nodes) (local head)))
			(let start (struct.get (local name) start))
			(if
				(:doc "Require the exact bare type keyword before validating its metadata.")
				(bool.not (bool.and (u32.eq (struct.get (local name) kind) 1u32)
					(call is_owned_array_name (borrow-shared (local source)) (local start)
						(i32.sub.wrapping (struct.get (local name) end) (local start)))))
				(then (return -1i32)))
			(let metadata (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts)))
			(if
				(:doc "Only well-formed type metadata can participate in type resolution.")
				(u32.lt 0u32 (struct.get (local metadata) error))
				(then (return -1i32)))
			(return (local element))))

	(fn is_byte_owner_descriptor
		(:doc `Recognize the exact (owned-array u8) descriptor.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(let element (call owned_element_node (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(return (bool.and (i32.lt -1i32 (local element))
				(u32.eq (call source_builtin_type (borrow-shared (local source)) (slice.load (local nodes) (local element))) 10u32)))))

	(fn is_byte_rows_descriptor
		(:doc `Recognize a vector with one owned byte array per row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(let element (call owned_element_node (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(return (bool.and (i32.lt -1i32 (local element))
				(call is_byte_owner_descriptor (borrow-shared (local source)) (borrow-shared (local nodes))
					(slice.load (local nodes) (local element)))))))
)
