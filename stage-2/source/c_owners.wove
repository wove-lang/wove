(module source_c_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the C representation and ownership contract from selected bridge types.

	Retain each representation literal and optional destructor as original tree
	rows. Check its decoded spelling before accepting the contract.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./scan.wove" (only skip_whitespace (type SourceNode) (type Token)))
	(use wove-file "./module.wove" (only form_parts source_keyword validate_form_metadata (type FormParts)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte is_c_identifier))

	(struct COwnerRead (fields (native i32) (drop i32) (storage bool) (tail i32) (count i32)
		(start i32) (end i32) (error u32)))

	(let storage_flag "storage")
	(let drop_void_pointer "void-pointer")
	(let tail_clause "tail")
	(let long_word "long")
	(let double_word "double")

	(fn is_native_name
		(:doc `Require a bare Wove node with the portable C identifier spelling.`)
		(params (source (shared-array u8)) (name SourceNode))
		(returns bool)
		(body (return (bool.and (u32.eq (struct.get (local name) kind) 1u32)
			(call is_c_identifier (borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end))))))

	(fn is_c_pointer_spelling
		(:doc `Accept C type words followed by one or more pointer stars.

		Restrict the text to type words, horizontal space, and pointer stars.
		The C compiler resolves the type words against the selected header.`)
		(params (source (shared-array u8)))
		(returns bool)
		(body
			(let-mut cursor 0i32)
			(let-mut word (bool false))
			(let-mut in_word (bool false))
			(let-mut pointer (bool false))
			(while
				(:doc "Once the first pointer star appears, only stars and space can follow.")
				(i32.lt (local cursor) (array.len (local source)))
				(body
					(let byte (array.load (local source) (local cursor)))
					(if
						(:doc "Horizontal space separates words and may surround each star.")
						(bool.or (u8.eq (local byte) 32u8) (u8.eq (local byte) 9u8))
						(then (set (local in_word) (bool false)))
						(else
							(if
								(:doc "The pointer suffix follows a native type spelling.")
								(u8.eq (local byte) 42u8)
								(then
									(if (bool.not (local word)) (then (return (bool false))))
									(set (local pointer) (bool true)))
								(else
									(if
										(:doc "Each type word is an ASCII C identifier.")
										(bool.or (local pointer) (bool.not (bool.or (call is_c_identifier_start (local byte))
											(bool.and (local in_word) (call is_c_identifier_byte (local byte))))))
										(then (return (bool false))))
									(set (local word) (bool true))
									(set (local in_word) (bool true))))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (local pointer))))

	(fn is_c_pointer_candidate
		(:doc "Allow explicit pointers and a single identifier that C can verify as a pointer typedef.")
		(params (text (shared-array u8))) (returns bool)
		(body (return (bool.or (call is_c_pointer_spelling (borrow-shared (local text)))
			(call is_c_identifier (borrow-shared (local text)) 0i32 (array.len (local text)))))))

	(fn c_type_uses_typedef
		(:doc "Distinguish a checked pointer typedef candidate from a spelling with explicit stars.")
		(params (source (shared-array u8)) (literal SourceNode)) (returns bool)
		(body
			(let start (struct.get (local literal) start))
			(let end (struct.get (local literal) end))
			(let-mut text (array.alloc u8 (i32.sub (local end) (local start))))
			(let decoded (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local text))))
			(return (bool.and (u32.eqz (struct.get (local decoded) error))
				(call is_c_identifier (borrow-shared (local text)) 0i32 (struct.get (local decoded) written))))))

	(fn owner_read
		(:doc `Package an owner contract or its original failing span.`)
		(params (native i32) (drop i32) (storage bool) (site SourceNode) (error u32))
		(returns COwnerRead)
		(body (return (struct.new COwnerRead (native (local native)) (drop (local drop)) (storage (local storage))
			(tail -1i32) (count -1i32)
			(start (struct.get (local site) start)) (end (struct.get (local site) end)) (error (local error))))))

	(fn owner_keyword
		(:doc `Recognize the tags in native type and ownership contracts.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if (u32.not-eq (struct.get (local node) kind) 1u32) (then (return 0u32)))
			(let start (struct.get (local node) start))
			(let width (i32.sub (struct.get (local node) end) (local start)))
			(if
				(:doc "The marker must use the entire c_owned spelling.")
				(bool.and (i32.eq (local width) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 95u8 111u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32)
							119u8 110u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 100u8))))
				(then (return 1u32)))
			(if
				(:doc "The representation form uses the exact c-type tag.")
				(bool.and (i32.eq (local width) 6i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 45u8 116u8)
						(call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32)
							121u8 112u8 101u8)))
				(then (return 2u32)))
			(if
				(:doc "Only drop introduces a destructor name.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 100u8 114u8 111u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 112u8)))
				(then (return 3u32)))
			(if
				(:doc "A tail clause names the count and byte-array members of caller-owned storage.")
				(call same_bytes (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local tail_clause)) 0i32 (array.len (local tail_clause)))
				(then (return 4u32)))
			(return 0u32)))

	(fn owner_form_keyword
		(:doc `Read the owner keyword at a form head or a bare marker.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let child (struct.get (local node) first_child))
			(if
				(:doc "A compound directive uses its checked form head.")
				(u32.eq (struct.get (local node) kind) 40u32)
				(then (return (call owner_keyword (borrow-shared (local source)) (array.load (local nodes) (local child))))))
			(return (call owner_keyword (borrow-shared (local source)) (local node)))))

	(fn read_owner_drop
		(:doc `Read a native destructor contract or the caller-owned byte-tail members.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (directive SourceNode))
		(returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local directive)))
			(let clause (struct.get (local parts) operands))
			(if (i32.ltz (local clause)) (then (return (call owner_read -1i32 -1i32 (bool false) (local directive) 23u32))))
			(let drop (array.load (local nodes) (local clause)))
			(let tag (call owner_form_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local drop)))
			(if
				(:doc "Runtime-owned byte storage has a count member and a trailing byte member.")
				(u32.eq (local tag) 4u32)
				(then
					(let operands (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local drop)))
					(let count (struct.get (local operands) operands))
					(if
						(:doc "The byte-tail clause is the entire ownership contract.")
						(bool.or (i32.ltz (local count)) (i32.not-ltz (struct.get (local drop) next_sibling)))
						(then (return (call owner_read -1i32 -1i32 (bool false) (local drop) 23u32))))
					(let count_name (array.load (local nodes) (local count)))
					(let tail (struct.get (local count_name) next_sibling))
					(if
						(:doc "The first operand is the exact native count field.")
						(bool.or (i32.ltz (local tail)) (bool.not (call is_native_name (borrow-shared (local source)) (local count_name))))
						(then (return (call owner_read -1i32 -1i32 (bool false) (local count_name) 23u32))))
					(let tail_name (array.load (local nodes) (local tail)))
					(if
						(:doc "The second operand is the exact terminal byte field.")
						(bool.or (i32.not-ltz (struct.get (local tail_name) next_sibling))
							(bool.not (call is_native_name (borrow-shared (local source)) (local tail_name))))
						(then (return (call owner_read -1i32 -1i32 (bool false) (local tail_name) 23u32))))
					(return (struct.new COwnerRead (native -1i32) (drop -1i32) (storage (bool true))
						(tail (local tail)) (count (local count))
						(start (struct.get (local drop) start)) (end (struct.get (local drop) end)) (error 0u32)))))
			(if
				(:doc "The contract starts with a single destructor clause.")
				(u32.not-eq (local tag) 3u32)
				(then (return (call owner_read -1i32 -1i32 (bool false) (local directive) 23u32))))
			(let flag (struct.get (local drop) next_sibling))
			(let storage (i32.lt -1i32 (local flag)))
			(if
				(:doc "Only the bare storage flag may follow the destructor.")
				(local storage)
				(then
					(let word (array.load (local nodes) (local flag)))
					(if
						(:doc "Reject unknown flags and a second trailing operand at the contract.")
						(bool.or (u32.not-eq (struct.get (local word) kind) 1u32)
							(bool.or (i32.lt -1i32 (struct.get (local word) next_sibling))
								(bool.not (call same_bytes (borrow-shared (local source))
									(struct.get (local word) start) (struct.get (local word) end)
									(borrow-shared (local storage_flag)) 0i32 (array.len (local storage_flag))))))
						(then (return (call owner_read -1i32 -1i32 (bool false) (local directive) 23u32))))))
			(let name (struct.get (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local drop)) operands))
			(if (i32.ltz (local name)) (then (return (call owner_read -1i32 -1i32 (bool false) (local drop) 23u32))))
			(let symbol (array.load (local nodes) (local name)))
			(if
				(:doc "Reject a malformed destructor at the exact symbol or clause.")
				(bool.not (call is_native_name (borrow-shared (local source)) (local symbol)))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local symbol) 23u32))))
			(let abi (struct.get (local symbol) next_sibling))
			(if
				(:doc "Only a pointer-backed owner may declare a void-pointer destructor.")
				(i32.not-ltz (local abi))
				(then
					(let word (array.load (local nodes) (local abi)))
					(if
						(:doc "The optional destructor ABI is one exact bare marker.")
						(bool.or (local storage)
							(bool.or (u32.not-eq (struct.get (local word) kind) 1u32)
								(bool.or (i32.not-ltz (struct.get (local word) next_sibling))
									(bool.not (call same_bytes (borrow-shared (local source))
										(struct.get (local word) start) (struct.get (local word) end)
										(borrow-shared (local drop_void_pointer)) 0i32 (array.len (local drop_void_pointer)))))))
						(then (return (call owner_read -1i32 -1i32 (bool false) (local word) 23u32))))))
			(return (call owner_read -1i32 (local name) (local storage) (local directive) 0u32))))

	(fn owner_destructor
		(:doc `Find and validate the single c_owned directive in the type's pragma prefix.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts) (site SourceNode))
		(returns COwnerRead)
		(body
			(let-mut metadata (struct.get (local parts) metadata))
			(let-mut drop -1i32)
			(let-mut storage (bool false))
			(let-mut tail -1i32)
			(let-mut count -1i32)
			(while
				(:doc "Only :pragma metadata can supply the ownership directive.")
				(bool.and (i32.not-ltz (local metadata))
					(i32.not-eq (local metadata) (struct.get (local parts) operands)))
				(body
					(let entry (array.load (local nodes) (local metadata)))
					(let head (array.load (local nodes) (struct.get (local entry) first_child)))
					(if
						(:doc "Other metadata leaves the ownership contract untouched.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let pragma (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local entry)))
							(let-mut index (struct.get (local pragma) operands))
							(while
								(:doc "Unknown pragmas may coexist with the ownership directive.")
								(i32.not-ltz (local index))
								(body
									(let directive (array.load (local nodes) (local index)))
									(if
										(:doc "One ownership contract sets the lifetime of the native allocation.")
										(u32.eq (call owner_form_keyword (borrow-shared (local source))
											(borrow-shared (local nodes)) (local directive)) 1u32)
										(then
											(if
												(:doc "Diagnose a repeated ownership marker at the later directive.")
												(bool.or (local storage) (i32.not-ltz (local drop)))
												(then (return (call owner_read -1i32 -1i32 (bool false) (local directive) 23u32))))
											(let checked (call read_owner_drop (borrow-shared (local source))
												(borrow-shared (local nodes)) (local directive)))
											(if (u32.gtz (struct.get (local checked) error)) (then (return (local checked))))
											(set (local drop) (struct.get (local checked) drop))
											(set (local storage) (struct.get (local checked) storage))
											(set (local tail) (struct.get (local checked) tail))
											(set (local count) (struct.get (local checked) count))))
									(set (local index) (struct.get (local directive) next_sibling))))))
					(set (local metadata) (struct.get (local entry) next_sibling))))
			(return (struct.new COwnerRead (native -1i32) (drop (local drop)) (storage (local storage))
				(tail (local tail)) (count (local count))
				(start (struct.get (local site) start)) (end (struct.get (local site) end)) (error 0u32)))))

	(fn read_c_type_form
		(:doc `Read a c-type form and its single quoted representation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (form SourceNode))
		(returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)))
			(let literal (struct.get (local parts) operands))
			(if
				(:doc "A native type needs one c-type form and a string operand.")
				(bool.or (i32.ltz (local literal))
					(u32.not-eq (call owner_form_keyword (borrow-shared (local source))
						(borrow-shared (local nodes)) (local form)) 2u32))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local form) 23u32))))
			(let choice (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
				(local form) (local parts)))
			(if
				(:doc "Selection belongs to the enclosing declaration. Keep the directive's own span.")
				(u32.gtz (struct.get (local choice) error))
				(then (return (struct.new COwnerRead (native -1i32) (drop -1i32) (storage (bool false))
					(tail -1i32) (count -1i32)
					(start (struct.get (local choice) start)) (end (struct.get (local choice) end))
					(error (struct.get (local choice) error))))))
			(let value (array.load (local nodes) (local literal)))
			(if
				(:doc "Keep a bad native type operand at its originating span.")
				(bool.or (u32.not-eq (struct.get (local value) kind) 2u32)
					(i32.not-ltz (struct.get (local value) next_sibling)))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local value) 23u32))))
			(return (call owner_read (local literal) -1i32 (bool false) (local value) 0u32))))

	(fn read_c_type_literal
		(:doc `Require the c-type form to be the last operand of a native alias.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode))
		(returns COwnerRead)
		(body
			(let index (struct.get (local name) next_sibling))
			(if (i32.ltz (local index)) (then (return (call owner_read -1i32 -1i32 (bool false) (local name) 23u32))))
			(let form (array.load (local nodes) (local index)))
			(if
				(:doc "An alias declaration ends after its representation.")
				(i32.lt -1i32 (struct.get (local form) next_sibling))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local form) 23u32))))
			(return (call read_c_type_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)))))

	(fn read_c_type
		(:doc `Read a native type literal and any explicit destructor using their original tree rows.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let name_index (struct.get (local parts) operands))
			(if
				(:doc "A native type must introduce a name.")
				(i32.ltz (local name_index))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local node) 23u32))))
			(let name (array.load (local nodes) (local name_index)))
			(let drop (call owner_destructor (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts) (local name)))
			(if (u32.gtz (struct.get (local drop) error)) (then (return (local drop))))
			(let native (call read_c_type_literal (borrow-shared (local source)) (borrow-shared (local nodes)) (local name)))
			(if (u32.gtz (struct.get (local native) error)) (then (return (local native))))
			(return (struct.new COwnerRead (native (struct.get (local native) native))
				(drop (struct.get (local drop) drop)) (storage (struct.get (local drop) storage))
				(tail (struct.get (local drop) tail)) (count (struct.get (local drop) count))
				(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))

	(fn is_c_storage_type
		(:doc `Identify an owned storage declaration by its original source row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32))
		(returns bool)
		(body
			(if
				(:doc "Built-in types and unresolved members have no defining storage contract.")
				(i32.ltz (local declaration))
				(then (return (bool false))))
			(let node (array.load (local nodes) (local declaration)))
			(return (struct.get (call read_c_type (borrow-shared (local source))
				(borrow-shared (local nodes)) (local node)) storage))))

	(fn read_c_owner
		(:doc `Read the checked ownership contract selected for emission.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns COwnerRead)
		(body
			(let read (call read_c_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(if
				(:doc "A borrowed pointer requires a destructor. Runtime-owned storage can free itself.")
				(bool.and (u32.eqz (struct.get (local read) error))
					(bool.and (i32.ltz (struct.get (local read) drop)) (bool.not (struct.get (local read) storage))))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local node) 23u32))))
			(return (local read))))

	(fn c_owner_uses_typedef
		(:doc "Identify a pointer owner whose indirection must be verified against the C header.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (owner COwnerRead))
		(returns bool)
		(body
			(return (bool.and (i32.not-ltz (struct.get (local owner) drop))
				(bool.and (bool.not (struct.get (local owner) storage))
					(call c_type_uses_typedef (borrow-shared (local source))
						(array.load (local nodes) (struct.get (local owner) native))))))))

	(fn is_c_type_words
		(:doc `Accept C type words separated by horizontal whitespace.`)
		(params (text (shared-array u8)))
		(returns bool)
		(body
			(let-mut cursor 0i32)
			(let-mut word (bool false))
			(let-mut in_word (bool false))
			(while
				(:doc "Only horizontal space may separate C identifiers in a scalar type spelling.")
				(i32.lt (local cursor) (array.len (local text)))
				(body
					(let byte (array.load (local text) (local cursor)))
					(if
						(:doc "Each word starts with a valid C identifier start byte.")
						(bool.or (u8.eq (local byte) 32u8) (u8.eq (local byte) 9u8))
						(then (set (local in_word) (bool false)))
						(else
							(if
								(:doc "Reject operators, pointer stars, and preprocessor punctuation.")
								(bool.not (bool.or (call is_c_identifier_start (local byte))
									(bool.and (local in_word) (call is_c_identifier_byte (local byte)))))
								(then (return (bool false))))
							(set (local word) (bool true))
							(set (local in_word) (bool true))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (local word))))

	(fn c_type_word_end
		(:doc "Stop a decoded C type word at whitespace or the end of the spelling.")
		(params (text (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "A word ends before the first byte outside the C identifier grammar.")
				(bool.and (i32.lt (local cursor) (array.len (local text)))
					(call is_c_identifier_byte (array.load (local text) (local cursor))))
				(body (set (local cursor) (i32.inc (local cursor)))))
			(return (local cursor))))

	(fn is_long_double_spelling
		(:doc "Match two C specifiers in either order after decoding their literal.")
		(params (text (shared-array u8))) (returns bool)
		(body
			(let length (array.len (local text)))
			(let first (call skip_whitespace (borrow-shared (local text)) 0i32))
			(let first_end (call c_type_word_end (borrow-shared (local text)) (local first)))
			(let second (call skip_whitespace (borrow-shared (local text)) (local first_end)))
			(let second_end (call c_type_word_end (borrow-shared (local text)) (local second)))
			(if
				(:doc "Only two complete words can contribute to the built-in type.")
				(i32.not-eq (call skip_whitespace (borrow-shared (local text)) (local second_end)) (local length))
				(then (return (bool false))))
			(return (bool.or
				(bool.and (call same_bytes (borrow-shared (local text)) (local first) (local first_end) (borrow-shared (local long_word)) 0i32 4i32)
					(call same_bytes (borrow-shared (local text)) (local second) (local second_end) (borrow-shared (local double_word)) 0i32 6i32))
				(bool.and (call same_bytes (borrow-shared (local text)) (local first) (local first_end) (borrow-shared (local double_word)) 0i32 6i32)
					(call same_bytes (borrow-shared (local text)) (local second) (local second_end) (borrow-shared (local long_word)) 0i32 4i32))))))

	(fn is_c_long_double
		(:doc "Recognize the specifiers of an unqualified native long double type.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(let-mut decoded (array.alloc u8 (i32.sub (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local decoded))))
			(return (bool.and (u32.eqz (struct.get (local value) error))
				(call is_long_double_spelling (borrow-shared (array.range (local decoded) 0i32 (struct.get (local value) written))))))))

	(fn check_c_type_spelling
		(:doc `Check the spelling of a value or pointer representation before emitting it.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (read COwnerRead))
		(returns COwnerRead)
		(body
			(if (u32.gtz (struct.get (local read) error)) (then (return (local read))))
			(let literal (array.load (local nodes) (struct.get (local read) native)))
			(let start (struct.get (local literal) start))
			(let end (struct.get (local literal) end))
			(let-mut decoded (array.alloc u8 (i32.sub (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local decoded))))
			(if
				(:doc "Attribute a failed decode to the native type operand.")
				(u32.gtz (struct.get (local value) error))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local literal) 23u32))))
			(let length (struct.get (local value) written))
			(let owned (i32.lt -1i32 (struct.get (local read) drop)))
			(let valid (bool.or
				(bool.and (bool.or (bool.not (local owned)) (struct.get (local read) storage))
					(call is_c_type_words (borrow-shared (array.range (local decoded) 0i32 (local length)))))
				(bool.and (local owned)
					(call is_c_pointer_candidate (borrow-shared (array.range (local decoded) 0i32 (local length)))))))
			(if
				(:doc "Keep a bad representation at the original quoted operand.")
				(bool.not (local valid))
				(then (return (call owner_read -1i32 -1i32 (bool false) (local literal) 23u32))))
			(return (local read))))

	(fn check_c_type
		(:doc `Read a native alias and check its C representation against the ownership contract.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns COwnerRead)
		(body
			(return (call check_c_type_spelling (borrow-shared (local source)) (borrow-shared (local nodes))
				(call read_c_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))))))
