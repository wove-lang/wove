(module source_c_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the C representation and ownership contract from selected bridge types.

	Retain each representation literal and optional destructor as original tree
	rows. Check its decoded spelling before accepting the contract.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./scan.wove" (only skip_whitespace (type SourceNode) (type Token)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata next_form_operand source_keyword validate_form_metadata (type FormParts)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./c_markers.wove" (only read_c_long_double))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte is_c_identifier))

	(struct COwnerRead (fields (native i32) (drop i32) (storage bool) (tail i32) (count i32)
		(vector i32) (vector_count i32) (vector_offset i32) (long_double_typedef bool)
		(start i32) (end i32) (error u32)))

	(let storage_flag "storage")
	(let drop_void_pointer "void-pointer")
	(let tail_clause "tail")
	(let vector_clause "cstr-vector")
	(let long_word "long")
	(let double_word "double")

	(fn is_native_name
		(:doc `Require a bare Wove node with the portable C identifier spelling.`)
		(params (source (shared-array u8)) (name SourceNode))
		(returns bool)
		(body (return (bool:and (u32:eq (name.get kind) 1u32)
			(call is_c_identifier (borrow-shared source) (name.get start) (name.get end))))))

	(fn is_c_pointer_spelling
		(:doc `Accept C type words followed by one or more pointer stars.

		Restrict the text to type words, horizontal space, and pointer stars.
		The C compiler resolves the type words against the selected header.`)
		(params (source (shared-array u8)))
		(returns bool)
		(body
			(let-mut cursor 0i32)
			(let-mut word (bool false))
			(let-mut in_word (bool false))
			(let-mut pointer (bool false))
			(while
				(:doc "Once the first pointer star appears, only stars and space can follow.")
				(i32:lt cursor source.len)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "Horizontal space separates words and may surround each star.")
						(bool:or (u8:eq byte 32u8) (u8:eq byte 9u8))
						(then (set in_word (bool false)))
						(else
							(if
								(:doc "The pointer suffix follows a native type spelling.")
								(u8:eq byte 42u8)
								(then
									(if (bool:not word) (then (return (bool false))))
									(set pointer (bool true)))
								(else
									(if
										(:doc "Each type word is an ASCII C identifier.")
										(bool:or pointer (bool:not (bool:or (call is_c_identifier_start byte)
											(bool:and in_word (call is_c_identifier_byte byte)))))
										(then (return (bool false))))
									(set word (bool true))
									(set in_word (bool true))))))
					(set cursor (i32:inc cursor))))
			(return pointer)))

	(fn is_c_pointer_candidate
		(:doc "Allow explicit pointers and a single identifier that C can verify as a pointer typedef.")
		(params (text (shared-array u8))) (returns bool)
		(body (return (bool:or (call is_c_pointer_spelling (borrow-shared text))
			(call is_c_identifier (borrow-shared text) 0i32 text.len)))))

	(fn c_type_uses_typedef
		(:doc "Distinguish a checked pointer typedef candidate from a spelling with explicit stars.")
		(params (source (shared-array u8)) (literal SourceNode)) (returns bool)
		(body
			(let start (literal.get start))
			(let end (literal.get end))
			(let-mut text (array:alloc u8 (i32:sub end start)))
			(let decoded (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut text)))
			(return (bool:and (u32:eqz (decoded.get error))
				(call is_c_identifier (borrow-shared text) 0i32 (decoded.get written))))))

	(fn owner_read
		(:doc `Package an owner contract or its original failing span.`)
		(params (native i32) (drop i32) (storage bool) (site SourceNode) (error u32))
		(returns COwnerRead)
		(body (return (struct:new COwnerRead (native native) (drop drop) (storage storage)
			(tail -1i32) (count -1i32) (vector -1i32) (vector_count -1i32) (vector_offset -1i32) (long_double_typedef (bool false))
			(start (site.get start)) (end (site.get end)) (error error)))))

	(fn owner_keyword
		(:doc `Recognize the tags in native type and ownership contracts.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if (u32:not-eq (node.get kind) 1u32) (then (return 0u32)))
			(let start (node.get start))
			(let width (i32:sub (node.get end) start))
			(if
				(:doc "The marker must use the entire c_owned spelling.")
				(bool:and (i32:eq width 7i32)
					(bool:and (call is_three_bytes (borrow-shared source) start 99u8 95u8 111u8)
						(bool:and (call is_three_bytes (borrow-shared source) (i32:add start 3i32)
							119u8 110u8 101u8)
							(call is_head_byte (borrow-shared source) start 6i32 100u8))))
				(then (return 1u32)))
			(if
				(:doc "The representation form uses the exact c-type tag.")
				(bool:and (i32:eq width 6i32)
					(bool:and (call is_three_bytes (borrow-shared source) start 99u8 45u8 116u8)
						(call is_three_bytes (borrow-shared source) (i32:add start 3i32)
							121u8 112u8 101u8)))
				(then (return 2u32)))
			(if
				(:doc "Only drop introduces a destructor name.")
				(bool:and (i32:eq width 4i32)
					(bool:and (call is_three_bytes (borrow-shared source) start 100u8 114u8 111u8)
						(call is_head_byte (borrow-shared source) start 3i32 112u8)))
				(then (return 3u32)))
			(if
				(:doc "A tail clause names the count and byte-array members of caller-owned storage.")
				(call same_bytes (borrow-shared source) start (node.get end)
					(borrow-shared tail_clause) 0i32 tail_clause.len)
				(then (return 4u32)))
			(if
				(:doc "A native string vector names its pointer table, count, and reserved offset.")
				(call same_bytes (borrow-shared source) start (node.get end)
					(borrow-shared vector_clause) 0i32 vector_clause.len)
				(then (return 5u32)))
			(return 0u32)))

	(fn owner_form_keyword
		(:doc `Read the owner keyword at a form head or a bare marker.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let child (node.get first_child))
			(if
				(:doc "A compound directive uses its checked form head.")
				(u32:eq (node.get kind) 40u32)
				(then (return (call owner_keyword (borrow-shared source) (nodes.get child)))))
			(return (call owner_keyword (borrow-shared source) node))))

	(fn read_owned_vector
		(:doc "Read the exact three native members and preserve the owner's destructor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (clause SourceNode)
			(destructor i32)) (returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) clause))
			(let data (parts.get operands))
			(if
				(:doc "The vector clause is the final part of a storage owner's contract.")
				(bool:or (i32:ltz data)
					(bool:or (i32:not-ltz (clause.get next_sibling))
						(u32:not-eq (call owner_form_keyword (borrow-shared source)
							(borrow-shared nodes) clause) 5u32)))
				(then (return (call owner_read -1i32 -1i32 (bool false) clause 23u32))))
			(let table (nodes.get data))
			(let count (table.get next_sibling))
			(if
				(:doc "The first token names the native pointer table.")
				(bool:or (i32:ltz count) (bool:not (call is_native_name (borrow-shared source) table)))
				(then (return (call owner_read -1i32 -1i32 (bool false) table 23u32))))
			(let length (nodes.get count))
			(let offset (length.get next_sibling))
			(if
				(:doc "The second token names the number of actual strings.")
				(bool:or (i32:ltz offset) (bool:not (call is_native_name (borrow-shared source) length)))
				(then (return (call owner_read -1i32 -1i32 (bool false) length 23u32))))
			(let skip (nodes.get offset))
			(if
				(:doc "The last token names a distinct field for the reserved prefix.")
				(bool:or (bool:or (i32:not-ltz (skip.get next_sibling))
						(bool:not (call is_native_name (borrow-shared source) skip)))
					(call same_bytes (borrow-shared source) (length.get start) (length.get end)
						(borrow-shared source) (skip.get start) (skip.get end)))
				(then (return (call owner_read -1i32 -1i32 (bool false) skip 23u32))))
			(return (struct:new COwnerRead (native -1i32) (drop destructor) (storage (bool true))
				(tail -1i32) (count -1i32) (vector data) (vector_count count) (vector_offset offset) (long_double_typedef (bool false))
				(start (clause.get start)) (end (clause.get end)) (error 0u32)))))

	(fn read_owner_drop
		(:doc `Read a native destructor contract or the caller-owned byte-tail members.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (directive SourceNode))
		(returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) directive))
			(let clause (parts.get operands))
			(if (i32:ltz clause) (then (return (call owner_read -1i32 -1i32 (bool false) directive 23u32))))
			(let drop (nodes.get clause))
			(let tag (call owner_form_keyword (borrow-shared source) (borrow-shared nodes) drop))
			(if
				(:doc "Runtime-owned byte storage has a count member and a trailing byte member.")
				(u32:eq tag 4u32)
				(then
					(let operands (call form_parts (borrow-shared source) (borrow-shared nodes) drop))
					(let count (operands.get operands))
					(if
						(:doc "The byte-tail clause is the entire ownership contract.")
						(bool:or (i32:ltz count) (i32:not-ltz (drop.get next_sibling)))
						(then (return (call owner_read -1i32 -1i32 (bool false) drop 23u32))))
					(let count_name (nodes.get count))
					(let tail (count_name.get next_sibling))
					(if
						(:doc "The first operand is the exact native count field.")
						(bool:or (i32:ltz tail) (bool:not (call is_native_name (borrow-shared source) count_name)))
						(then (return (call owner_read -1i32 -1i32 (bool false) count_name 23u32))))
					(let tail_name (nodes.get tail))
					(if
						(:doc "The second operand is the exact terminal byte field.")
						(bool:or (i32:not-ltz (tail_name.get next_sibling))
							(bool:not (call is_native_name (borrow-shared source) tail_name)))
						(then (return (call owner_read -1i32 -1i32 (bool false) tail_name 23u32))))
					(return (struct:new COwnerRead (native -1i32) (drop -1i32) (storage (bool true))
						(tail tail) (count count) (vector -1i32) (vector_count -1i32) (vector_offset -1i32) (long_double_typedef (bool false))
						(start (drop.get start)) (end (drop.get end)) (error 0u32)))))
			(if
				(:doc "The contract starts with a single destructor clause.")
				(u32:not-eq tag 3u32)
				(then (return (call owner_read -1i32 -1i32 (bool false) directive 23u32))))
			(let flag (drop.get next_sibling))
			(let storage (i32:lt -1i32 flag))
			(let-mut vector -1i32)
			(if
				(:doc "The storage flag can be followed by one native string vector clause.")
				storage
				(then
					(let word (nodes.get flag))
					(if
						(:doc "A pointer owner cannot declare fields in caller-owned storage.")
						(bool:or (u32:not-eq (word.get kind) 1u32)
							(bool:not (call same_bytes (borrow-shared source)
								(word.get start) (word.get end)
								(borrow-shared storage_flag) 0i32 storage_flag.len)))
						(then (return (call owner_read -1i32 -1i32 (bool false) directive 23u32))))
					(set vector (word.get next_sibling))))
			(let name (struct:get (call form_parts (borrow-shared source) (borrow-shared nodes) drop) operands))
			(if (i32:ltz name) (then (return (call owner_read -1i32 -1i32 (bool false) drop 23u32))))
			(let symbol (nodes.get name))
			(if
				(:doc "Reject a malformed destructor at the exact symbol or clause.")
				(bool:not (call is_native_name (borrow-shared source) symbol))
				(then (return (call owner_read -1i32 -1i32 (bool false) symbol 23u32))))
			(let abi (symbol.get next_sibling))
			(if
				(:doc "Only a pointer-backed owner may declare a void-pointer destructor.")
				(i32:not-ltz abi)
				(then
					(let word (nodes.get abi))
					(if
						(:doc "The optional destructor ABI is one exact bare marker.")
						(bool:or storage
							(bool:or (u32:not-eq (word.get kind) 1u32)
								(bool:or (i32:not-ltz (word.get next_sibling))
									(bool:not (call same_bytes (borrow-shared source)
										(word.get start) (word.get end)
										(borrow-shared drop_void_pointer) 0i32 drop_void_pointer.len)))))
						(then (return (call owner_read -1i32 -1i32 (bool false) word 23u32))))))
			(if
				(:doc "A declared vector shares the storage owner's exact layout and lifetime.")
				(i32:not-ltz vector)
				(then (return (call read_owned_vector (borrow-shared source) (borrow-shared nodes)
					(nodes.get vector) name))))
			(return (call owner_read -1i32 name storage directive 0u32))))

	(fn owner_destructor
		(:doc `Find and validate the single c_owned directive on the native type declaration.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts) (site SourceNode))
		(returns COwnerRead)
		(body
			(let-mut metadata (parts.get metadata))
			(let-mut drop -1i32)
			(let-mut storage (bool false))
			(let-mut tail -1i32)
			(let-mut count -1i32)
			(let-mut vector -1i32)
			(let-mut vector_count -1i32)
			(let-mut vector_offset -1i32)
			(while
				(:doc "Only :pragma metadata can supply the ownership directive.")
				(i32:not-ltz metadata)
				(body
					(let entry (nodes.get metadata))
					(let head (nodes.get (entry.get first_child)))
					(if
						(:doc "Other metadata leaves the ownership contract untouched.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let pragma (call form_parts (borrow-shared source) (borrow-shared nodes) entry))
							(let-mut index (pragma.get operands))
							(while
								(:doc "Unknown pragmas may coexist with the ownership directive.")
								(i32:not-ltz index)
								(body
									(let directive (nodes.get index))
									(if
										(:doc "One ownership contract sets the lifetime of the native allocation.")
										(u32:eq (call owner_form_keyword (borrow-shared source)
											(borrow-shared nodes) directive) 1u32)
										(then
											(if
												(:doc "Diagnose a repeated ownership marker at the later directive.")
												(bool:or storage (i32:not-ltz drop))
												(then (return (call owner_read -1i32 -1i32 (bool false) directive 23u32))))
											(let checked (call read_owner_drop (borrow-shared source)
												(borrow-shared nodes) directive))
											(if (u32:gtz (checked.get error)) (then (return checked)))
											(set drop (checked.get drop))
											(set storage (checked.get storage))
											(set tail (checked.get tail))
											(set count (checked.get count))
											(set vector (checked.get vector))
											(set vector_count (checked.get vector_count))
											(set vector_offset (checked.get vector_offset))))
									(set index (directive.get next_sibling))))))
					(set metadata (call next_form_metadata (borrow-shared source) (borrow-shared nodes) parts entry))))
			(return (struct:new COwnerRead (native -1i32) (drop drop) (storage storage)
				(tail tail) (count count) (vector vector) (vector_count vector_count) (vector_offset vector_offset) (long_double_typedef (bool false))
				(start (site.get start)) (end (site.get end)) (error 0u32)))))

	(fn read_c_type_form
		(:doc `Read a c-type form and its single quoted representation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (form SourceNode))
		(returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) form))
			(let literal (parts.get operands))
			(if
				(:doc "A native type needs one c-type form and a string operand.")
				(bool:or (i32:ltz literal)
					(u32:not-eq (call owner_form_keyword (borrow-shared source)
						(borrow-shared nodes) form) 2u32))
				(then (return (call owner_read -1i32 -1i32 (bool false) form 23u32))))
			(let choice (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
				form parts))
			(if
				(:doc "Selection belongs to the enclosing declaration. Keep the directive's own span.")
				(u32:gtz (choice.get error))
				(then (return (struct:new COwnerRead (native -1i32) (drop -1i32) (storage (bool false))
					(tail -1i32) (count -1i32) (vector -1i32) (vector_count -1i32) (vector_offset -1i32) (long_double_typedef (bool false))
					(start (choice.get start)) (end (choice.get end))
					(error (choice.get error))))))
			(let value (nodes.get literal))
			(if
				(:doc "Keep a bad native type operand at its originating span.")
				(bool:or (u32:not-eq (value.get kind) 2u32)
					(i32:not-ltz (value.get next_sibling)))
				(then (return (call owner_read -1i32 -1i32 (bool false) value 23u32))))
			(return (call owner_read literal -1i32 (bool false) value 0u32))))

	(fn read_c_type_literal
		(:doc `Require the c-type form to be the last operand of a native alias.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode) (index i32))
		(returns COwnerRead)
		(body
			(if (i32:ltz index) (then (return (call owner_read -1i32 -1i32 (bool false) name 23u32))))
			(let form (nodes.get index))
			(if
				(:doc "An alias declaration ends after its representation.")
				(i32:lt -1i32 (call next_form_operand (borrow-shared source) (borrow-shared nodes) form))
				(then (return (call owner_read -1i32 -1i32 (bool false) form 23u32))))
			(return (call read_c_type_form (borrow-shared source) (borrow-shared nodes) form))))

	(fn read_c_type
		(:doc `Read a native type literal and any explicit destructor using their original tree rows.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns COwnerRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let name_index (parts.get name))
			(if
				(:doc "A native type must introduce a name.")
				(i32:ltz name_index)
				(then (return (call owner_read -1i32 -1i32 (bool false) node 23u32))))
			(let name (nodes.get name_index))
			(let floating (call read_c_long_double (borrow-shared source) (borrow-shared nodes) parts))
			(if
				(:doc "Keep an invalid floating typedef directive at its original span.")
				(u32:gtz (floating.get error))
				(then (return (struct:new COwnerRead (native -1i32) (drop -1i32) (storage (bool false))
					(tail -1i32) (count -1i32) (vector -1i32) (vector_count -1i32) (vector_offset -1i32)
					(long_double_typedef (bool false)) (start (floating.get start))
					(end (floating.get end)) (error (floating.get error))))))
			(let drop (call owner_destructor (borrow-shared source) (borrow-shared nodes) parts name))
			(if (u32:gtz (drop.get error)) (then (return drop)))
			(let native (call read_c_type_literal (borrow-shared source) (borrow-shared nodes) name (parts.get operands)))
			(if (u32:gtz (native.get error)) (then (return native)))
			(return (struct:new COwnerRead (native (native.get native))
				(drop (drop.get drop)) (storage (drop.get storage))
				(tail (drop.get tail)) (count (drop.get count))
				(vector (drop.get vector)) (vector_count (drop.get vector_count))
				(vector_offset (drop.get vector_offset)) (long_double_typedef (floating.get present))
				(start (node.get start)) (end (node.get end)) (error 0u32)))))

	(fn is_c_storage_type
		(:doc `Identify an owned storage declaration by its original source row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32))
		(returns bool)
		(body
			(if
				(:doc "Built-in types and unresolved members have no defining storage contract.")
				(i32:ltz declaration)
				(then (return (bool false))))
			(let node (nodes.get declaration))
			(return (struct:get (call read_c_type (borrow-shared source)
				(borrow-shared nodes) node) storage))))

	(fn read_c_owner
		(:doc `Read the checked ownership contract selected for emission.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns COwnerRead)
		(body
			(let read (call read_c_type (borrow-shared source) (borrow-shared nodes) node))
			(if
				(:doc "A borrowed pointer requires a destructor. Runtime-owned storage can free itself.")
				(bool:and (u32:eqz (read.get error))
					(bool:and (i32:ltz (read.get drop)) (bool:not (read.get storage))))
				(then (return (call owner_read -1i32 -1i32 (bool false) node 23u32))))
			(return read)))

	(fn c_owner_uses_typedef
		(:doc "Identify a pointer owner whose indirection must be verified against the C header.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (owner COwnerRead))
		(returns bool)
		(body
			(return (bool:and (i32:not-ltz (owner.get drop))
				(bool:and (bool:not (owner.get storage))
					(call c_type_uses_typedef (borrow-shared source)
						(nodes.get (owner.get native))))))))

	(fn is_c_type_words
		(:doc `Accept C type words separated by horizontal whitespace.`)
		(params (text (shared-array u8)))
		(returns bool)
		(body
			(let-mut cursor 0i32)
			(let-mut word (bool false))
			(let-mut in_word (bool false))
			(while
				(:doc "Only horizontal space may separate C identifiers in a scalar type spelling.")
				(i32:lt cursor text.len)
				(body
					(let byte (text.get cursor))
					(if
						(:doc "Each word starts with a valid C identifier start byte.")
						(bool:or (u8:eq byte 32u8) (u8:eq byte 9u8))
						(then (set in_word (bool false)))
						(else
							(if
								(:doc "Reject operators, pointer stars, and preprocessor punctuation.")
								(bool:not (bool:or (call is_c_identifier_start byte)
									(bool:and in_word (call is_c_identifier_byte byte))))
								(then (return (bool false))))
							(set word (bool true))
							(set in_word (bool true))))
					(set cursor (i32:inc cursor))))
			(return word)))

	(fn c_type_word_end
		(:doc "Stop a decoded C type word at whitespace or the end of the spelling.")
		(params (text (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "A word ends before the first byte outside the C identifier grammar.")
				(bool:and (i32:lt cursor text.len)
					(call is_c_identifier_byte (text.get cursor)))
				(body (set cursor (i32:inc cursor))))
			(return cursor)))

	(fn is_long_double_spelling
		(:doc "Match two C specifiers in either order after decoding their literal.")
		(params (text (shared-array u8))) (returns bool)
		(body
			(let length text.len)
			(let first (call skip_whitespace (borrow-shared text) 0i32))
			(let first_end (call c_type_word_end (borrow-shared text) first))
			(let second (call skip_whitespace (borrow-shared text) first_end))
			(let second_end (call c_type_word_end (borrow-shared text) second))
			(if
				(:doc "Only two complete words can contribute to the built-in type.")
				(i32:not-eq (call skip_whitespace (borrow-shared text) second_end) length)
				(then (return (bool false))))
			(return (bool:or
				(bool:and (call same_bytes (borrow-shared text) first first_end (borrow-shared long_word) 0i32 4i32)
					(call same_bytes (borrow-shared text) second second_end (borrow-shared double_word) 0i32 6i32))
				(bool:and (call same_bytes (borrow-shared text) first first_end (borrow-shared double_word) 0i32 6i32)
					(call same_bytes (borrow-shared text) second second_end (borrow-shared long_word) 0i32 4i32))))))

	(fn is_c_long_double
		(:doc "Recognize the specifiers of an unqualified native long double type.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let value (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(return (bool:and (u32:eqz (value.get error))
				(call is_long_double_spelling (borrow-shared (decoded.range 0i32 (value.get written))))))))

	(fn c_type_is_long_double
		(:doc "Classify both the intrinsic spelling and the checked header-defined alias as floating values.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (read COwnerRead))
		(returns bool)
		(body
			(let literal (nodes.get (read.get native)))
			(return (bool:or (read.get long_double_typedef)
				(call is_c_long_double (borrow-shared source) (literal.get start) (literal.get end))))))

	(fn is_typedef_identifier
		(:doc "Allow one ordinary C identifier with surrounding horizontal whitespace.")
		(params (text (shared-array u8))) (returns bool)
		(body
			(let first (call skip_whitespace (borrow-shared text) 0i32))
			(let end (call c_type_word_end (borrow-shared text) first))
			(return (bool:and (i32:eq (call skip_whitespace (borrow-shared text) end) text.len)
				(call is_c_identifier (borrow-shared text) first end)))))

	(fn check_c_type_spelling
		(:doc `Check the spelling of a value or pointer representation before emitting it.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (read COwnerRead))
		(returns COwnerRead)
		(body
			(if (u32:gtz (read.get error)) (then (return read)))
			(let literal (nodes.get (read.get native)))
			(let start (literal.get start))
			(let end (literal.get end))
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let value (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(if
				(:doc "Attribute a failed decode to the native type operand.")
				(u32:gtz (value.get error))
				(then (return (call owner_read -1i32 -1i32 (bool false) literal 23u32))))
			(let length (value.get written))
			(let owned (i32:lt -1i32 (read.get drop)))
			(if
				(:doc "A floating typedef represents an unowned value named by one C identifier.")
				(bool:and (read.get long_double_typedef)
					(bool:or (bool:or owned (read.get storage))
						(bool:not (call is_typedef_identifier (borrow-shared (decoded.range 0i32 length))))))
				(then (return (call owner_read -1i32 -1i32 (bool false) literal 23u32))))
			(let valid (bool:or
				(bool:and (bool:or (bool:not owned) (read.get storage))
					(call is_c_type_words (borrow-shared (decoded.range 0i32 length))))
				(bool:and owned
					(call is_c_pointer_candidate (borrow-shared (decoded.range 0i32 length))))))
			(if
				(:doc "Keep a bad representation at the original quoted operand.")
				(bool:not valid)
				(then (return (call owner_read -1i32 -1i32 (bool false) literal 23u32))))
			(return read)))

	(fn check_c_type
		(:doc `Read a native alias and check its C representation against the ownership contract.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns COwnerRead)
		(body
			(return (call check_c_type_spelling (borrow-shared source) (borrow-shared nodes)
				(call read_c_type (borrow-shared source) (borrow-shared nodes) node))))))
