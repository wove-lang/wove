(module source_callers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Inspect computed callers in a checked Stage 2 module or supplied source graph.

	Resolve the selected functions and bodies with the same planner used for
	C emission. Match incoming call sites by defining file and declaration
	row. Return each original span in source order, including repeated
	calls from one caller.`)

	(use wove-file "./graph.wove" (only (type GraphBinding) collect_standalone_bindings))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../scalar/records.wove" (only count_declarations (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove"
		(only read_module_declarations plan_bodies find_function find_graph_function (type ScalarFunction) (type ScalarParameter)
			(type CallSite)))

	(struct CallerInspection
		(fields (declaration i32) (count i32) (start i32) (end i32) (error u32) (file i32)
			(related_start i32) (related_end i32)))

	(fn inspection_result
		(:doc `Report the inspected declaration and count, or an original view-relative diagnostic.`)
		(params (declaration i32) (count i32) (start i32) (end i32) (error u32) (file i32))
		(returns CallerInspection)
		(body
			(return (struct.new CallerInspection (declaration (local declaration)) (count (local count))
				(start (local start)) (end (local end)) (error (local error)) (file (local file))
				(related_start -1i32) (related_end -1i32)))))

	(fn matches_callee
		(:doc `Match the call site's defining callee identity.`)
		(params (site CallSite) (file i32) (declaration i32))
		(returns bool)
		(body
			(return (bool.and (i32.eq (struct.get (local site) callee_file) (local file))
				(i32.eq (struct.get (local site) callee) (local declaration))))))

	(fn copy_callers
		(:doc `Copy the callee's incoming call sites after checking the whole result fits.`)
		(params (sites (shared-array CallSite)) (count i32) (file i32) (view_start i32) (declaration i32)
			(start i32) (end i32) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(let-mut written 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Count each matching call site and report the first site beyond output capacity.")
				(i32.lt (local index) (local count))
				(body
					(let site (array.load (local sites) (local index)))
					(if
						(:doc "Only calls resolved to this defining declaration need an output row.")
						(call matches_callee (local site) (local file) (local declaration))
						(then
							(if
								(:doc "Report the short result using the originating call span in the source view.")
								(i32.not-lt (local written) (array.len (local output)))
								(then (return (call inspection_result (local declaration) 0i32
									(i32.sub (struct.get (local site) start) (local view_start))
									(i32.sub (struct.get (local site) end) (local view_start))
									16u32 (struct.get (local site) caller_file)))))
							(set (local written) (i32.add (local written) 1i32))))
					(set (local index) (i32.add (local index) 1i32))))
			(set (local written) 0i32)
			(set (local index) 0i32)
			(while
				(:doc "Copy the checked result in the original source order.")
				(i32.lt (local index) (local count))
				(body
					(let site (array.load (local sites) (local index)))
					(if
						(:doc "Retain every distinct call-site span, even for repeated callers.")
						(call matches_callee (local site) (local file) (local declaration))
						(then
							(array.store (local output) (local written) (local site))
							(set (local written) (i32.add (local written) 1i32))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (call inspection_result (local declaration) (local written)
				(local start) (local end) 0u32 (local file)))))

	(fn inspect_callers
		(:doc `Resolve the active module and expose the requested function's computed callers.

		The name is the original Wove spelling. Success returns the inspected
		declaration row and zero or more file-relative call sites. Diagnostics
		use source-view offsets and leave the destination untouched. The view
		start and its length must fit the original file's signed offset range.
		Set entry_module for a module serving as the executable root.`)
		(:expect
			(tests "stage-2/source_callers.tsv")
			(issues "gh:wove-lang/wove:86"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (file i32) (view_start i32) (entry_module bool)
			(name (shared-array u8)) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(let start (struct.get (local module) start))
			(let end (struct.get (local module) end))
			(let error (struct.get (local module) error))
			(if
				(:doc "Preserve diagnostics from source admission, structure, and selection.")
				(u32.gtz (local error))
				(then (return (call inspection_result -1i32 0i32 (local start) (local end) (local error) (local file)))))
			(let count (struct.get (local module) count))
			(if
				(:doc "An excluded or empty module has no inspectable function.")
				(bool.or (bool.not (struct.get (local module) active)) (i32.eqz (local count)))
				(then (return (call inspection_result -1i32 0i32 (local start) (local end) 36u32 (local file)))))
			(let rows (array.len (local nodes)))
			(let function_count (call count_declarations (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (local count) 1u32))
			(let-mut records (array.alloc ScalarRecord (local rows)))
			(let-mut functions (array.alloc ScalarFunction (local function_count)))
			(let-mut parameters (array.alloc ScalarParameter (local rows)))
			(let-mut bindings (array.alloc GraphBinding (local count)))
			(let names (call collect_standalone_bindings (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (local count) (local file) (borrow-mut (local bindings))))
			(if
				(:doc "Keep the defining span if a selected local name cannot enter the namespace.")
				(u32.gtz (struct.get (local names) error))
				(then (return (call inspection_result -1i32 0i32 (struct.get (local names) start) (struct.get (local names) end) (struct.get (local names) error) (local file)))))
			(let-mut statements (array.alloc ScalarStatement (local rows)))
			(let-mut expressions (array.alloc ScalarExpression (local rows)))
			(let signatures (call read_module_declarations (borrow-shared (local source)) (borrow-shared (local nodes)) (local module)
				(borrow-shared (local declarations)) (borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records))
				(borrow-shared (local bindings)) (local file) (local entry_module)
				(borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Resolve callers only for a module with checked local signatures.")
				(u32.gtz (struct.get (local signatures) error))
				(then (return (call inspection_result -1i32 0i32 (struct.get (local signatures) start)
					(struct.get (local signatures) end) (struct.get (local signatures) error) (local file)))))
			(let-mut sites (array.alloc CallSite (local rows)))
			(let checked (call plan_bodies (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local bindings))
				(borrow-shared (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
				(borrow-mut (local sites)) (local view_start)))
			(if
				(:doc "Body diagnostics retain both source locations before any inspection data is returned.")
				(u32.gtz (struct.get (local checked) error))
				(then (return (struct.new CallerInspection (declaration -1i32) (count 0i32)
					(start (struct.get (local checked) start)) (end (struct.get (local checked) end))
					(error (struct.get (local checked) error)) (file (local file))
					(related_start (struct.get (local checked) related_start)) (related_end (struct.get (local checked) related_end))))))
			(let target (call find_function (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local name)) 0i32 (array.len (local name))))
			(if
				(:doc "An unavailable query name refers to the module's source span.")
				(i32.ltz (local target))
				(then (return (call inspection_result -1i32 0i32 (local start) (local end) 36u32 (local file)))))
			(return (call copy_inspected_callers (borrow-shared (local nodes)) (borrow-shared (local functions))
				(local target) (borrow-shared (local sites)) (struct.get (local checked) count)
				(local view_start) (borrow-mut (local output))))))

	(fn copy_inspected_callers
		(:doc `Resolve the selected function table row back to its original declaration before filtering.`)
		(params (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction)) (target i32)
			(sites (shared-array CallSite)) (count i32) (view_start i32) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(let function (array.load (local functions) (local target)))
			(let declaration (struct.get (local function) declaration))
			(let node (array.load (local nodes) (local declaration)))
			(let base (struct.get (local function) source_base))
			(return (call copy_callers (borrow-shared (local sites)) (local count)
				(struct.get (local function) file) (local view_start)
				(i32.sub (local declaration) (struct.get (local function) tree_base))
				(i32.sub (struct.get (local node) start) (local base))
				(i32.sub (struct.get (local node) end) (local base)) (borrow-mut (local output))))))

	(fn inspect_graph_name
		(:doc `Inspect the defining declaration reached by a name in the requested file's namespace.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction)) (bindings (shared-array GraphBinding))
			(sites (shared-array CallSite)) (count i32) (path i32) (name (shared-array u8)) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(if
				(:doc "An unknown path row has no source to attach to the diagnostic.")
				(bool.or (i32.ltz (local path)) (i32.not-lt (local path) (array.len (local files))))
				(then (return (call inspection_result -1i32 0i32 0i32 0i32 36u32 -1i32))))
			(let file (struct.get (array.load (local files) (local path)) identity))
			(let input (array.load (local files) (local file)))
			(let target (call find_graph_function (borrow-shared (local arena)) (borrow-shared (local functions))
				(borrow-shared (local bindings)) (local file) (struct.get (local input) source_start)
				(borrow-shared (local name)) 0i32 (array.len (local name))))
			(if
				(:doc "An unavailable or inactive name reports the requesting module's span.")
				(i32.ltz (local target))
				(then
					(let tree (array.load (local trees) (local file)))
					(return (call inspection_result -1i32 0i32
						(struct.get (local tree) start) (struct.get (local tree) end) 36u32 (local file)))))
			(return (call copy_inspected_callers (borrow-shared (local nodes)) (borrow-shared (local functions))
				(local target) (borrow-shared (local sites)) (local count) 0i32 (borrow-mut (local output)))))))
