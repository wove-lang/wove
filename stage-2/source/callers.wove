(module source_callers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Inspect computed callers in a checked Stage 2 module or supplied source graph.

	Resolve the selected functions and bodies with the same planner used for
	C emission. Match incoming call sites by defining file and declaration
	row. Return each original span in source order, including repeated
	calls from one caller.`)

	(use wove-file "./graph.wove" (only (type GraphBinding) collect_standalone_bindings))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../scalar/records.wove" (only count_declarations (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/plan.wove" (only read_module_declarations plan_bodies (type CallSite)))
	(use wove-file "../scalar/function_rows.wove" (only find_function find_graph_function (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/function_refs.wove" (only register_callable_references))

	(struct CallerInspection
		(fields (declaration i32) (count i32) (start i32) (end i32) (error u32) (file i32)
			(related_start i32) (related_end i32)))

	(fn inspection_result
		(:doc `Report the inspected declaration and count, or an original view-relative diagnostic.`)
		(params (declaration i32) (count i32) (start i32) (end i32) (error u32) (file i32))
		(returns CallerInspection)
		(body
			(return (struct:new CallerInspection (declaration declaration) (count count)
				(start start) (end end) (error error) (file file)
				(related_start -1i32) (related_end -1i32)))))

	(fn matches_callee
		(:doc `Match the call site's defining callee identity.`)
		(params (site CallSite) (file i32) (declaration i32))
		(returns bool)
		(body
			(return (bool:and (i32:eq (site.get callee_file) file)
				(i32:eq (site.get callee) declaration)))))

	(fn copy_callers
		(:doc `Copy the callee's incoming call sites after checking the whole result fits.`)
		(params (sites (shared-array CallSite)) (count i32) (file i32) (view_start i32) (declaration i32)
			(start i32) (end i32) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(let-mut written 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Count each matching call site and report the first site beyond output capacity.")
				(i32:lt index count)
				(body
					(let site (sites.get index))
					(if
						(:doc "Only calls resolved to this defining declaration need an output row.")
						(call matches_callee site file declaration)
						(then
							(if
								(:doc "Report the short result using the originating call span in the source view.")
								(i32:not-lt written output.len)
								(then (return (call inspection_result declaration 0i32
									(i32:sub (site.get start) view_start)
									(i32:sub (site.get end) view_start)
									16u32 (site.get caller_file)))))
							(set written (i32:inc written))))
					(set index (i32:inc index))))
			(set written 0i32)
			(set index 0i32)
			(while
				(:doc "Copy the checked result in the original source order.")
				(i32:lt index count)
				(body
					(let site (sites.get index))
					(if
						(:doc "Retain every distinct call-site span, even for repeated callers.")
						(call matches_callee site file declaration)
						(then
							(output.set written site)
							(set written (i32:inc written))))
					(set index (i32:inc index))))
			(return (call inspection_result declaration written
				start end 0u32 file))))

	(fn inspect_callers
		(:doc `Resolve the active module and expose the requested function's computed callers.

		The name is the original Wove spelling. Success returns the inspected
		declaration row and zero or more file-relative call sites. Diagnostics
		use source-view offsets and leave the destination untouched. The view
		start and its length must fit the original file's signed offset range.
		Set entry_module for a module serving as the executable root.`)
		(:expect
			(tests "stage-2/source_callers.tsv")
			(issues "gh:wove-lang/wove:86"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (file i32) (view_start i32) (entry_module bool)
			(name (shared-array u8)) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(let start (module.get start))
			(let end (module.get end))
			(let error (module.get error))
			(if
				(:doc "Preserve diagnostics from source admission, structure, and selection.")
				(u32:gtz error)
				(then (return (call inspection_result -1i32 0i32 start end error file))))
			(let count (module.get count))
			(if
				(:doc "An excluded or empty module has no inspectable function.")
				(bool:or (bool:not (module.get active)) (i32:eqz count))
				(then (return (call inspection_result -1i32 0i32 start end 36u32 file))))
			(let rows nodes.len)
			(let function_count (call count_declarations (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) count 1u32))
			(let-mut records (array:alloc ScalarRecord rows))
			(let-mut functions (array:alloc ScalarFunction function_count))
			(let-mut parameters (array:alloc ScalarParameter rows))
			(let-mut bindings (array:alloc GraphBinding count))
			(let names (call collect_standalone_bindings (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) count file (borrow-mut bindings)))
			(if
				(:doc "Keep the defining span if a selected local name cannot enter the namespace.")
				(u32:gtz (names.get error))
				(then (return (call inspection_result -1i32 0i32 (names.get start) (names.get end) (names.get error) file))))
			(let-mut statements (array:alloc ScalarStatement rows))
			(let-mut expressions (array:alloc ScalarExpression rows))
			(let signatures (call read_module_declarations (borrow-shared source) (borrow-shared nodes) module
				(borrow-shared declarations) (borrow-mut functions) (borrow-mut parameters) (borrow-mut records)
				(borrow-mut bindings) file entry_module
				(borrow-mut statements) (borrow-mut expressions)))
			(if
				(:doc "Resolve callers only for a module with checked local signatures.")
				(u32:gtz (signatures.get error))
				(then (return (call inspection_result -1i32 0i32 (signatures.get start)
					(signatures.get end) (signatures.get error) file))))
			(let-mut sites (array:alloc CallSite rows))
			(call register_callable_references (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings) (borrow-mut records))
			(let checked (call plan_bodies (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings)
				(borrow-shared records) (borrow-mut statements) (borrow-mut expressions)
				(borrow-mut sites) view_start))
			(if
				(:doc "Body diagnostics retain both source locations before any inspection data is returned.")
				(u32:gtz (checked.get error))
				(then (return (struct:new CallerInspection (declaration -1i32) (count 0i32)
					(start (checked.get start)) (end (checked.get end))
					(error (checked.get error)) (file file)
					(related_start (checked.get related_start)) (related_end (checked.get related_end))))))
			(let target (call find_function (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared name) 0i32 name.len))
			(if
				(:doc "An unavailable query name refers to the module's source span.")
				(i32:ltz target)
				(then (return (call inspection_result -1i32 0i32 start end 36u32 file))))
			(return (call copy_inspected_callers (borrow-shared nodes) (borrow-shared functions)
				target (borrow-shared sites) (checked.get count)
				view_start (borrow-mut output)))))

	(fn copy_inspected_callers
		(:doc `Resolve the selected function table row back to its original declaration before filtering.`)
		(params (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction)) (target i32)
			(sites (shared-array CallSite)) (count i32) (view_start i32) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(let function (functions.get target))
			(let declaration (function.get declaration))
			(let node (nodes.get declaration))
			(let base (function.get source_base))
			(return (call copy_callers (borrow-shared sites) count
				(function.get file) view_start
				(i32:sub declaration (function.get tree_base))
				(i32:sub (node.get start) base)
				(i32:sub (node.get end) base) (borrow-mut output)))))

	(fn inspect_graph_name
		(:doc `Inspect the defining declaration reached by a name in the requested file's namespace.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction)) (bindings (shared-array GraphBinding))
			(sites (shared-array CallSite)) (count i32) (path i32) (name (shared-array u8)) (output (mut-array CallSite)))
		(returns CallerInspection)
		(body
			(if
				(:doc "An unknown path row has no source to attach to the diagnostic.")
				(bool:or (i32:ltz path) (i32:not-lt path files.len))
				(then (return (call inspection_result -1i32 0i32 0i32 0i32 36u32 -1i32))))
			(let file (struct:get (files.get path) identity))
			(let input (files.get file))
			(let target (call find_graph_function (borrow-shared arena) (borrow-shared functions)
				(borrow-shared bindings) file (input.get source_start)
				(borrow-shared name) 0i32 name.len))
			(if
				(:doc "An unavailable or inactive name reports the requesting module's span.")
				(i32:ltz target)
				(then
					(let tree (trees.get file))
					(return (call inspection_result -1i32 0i32
						(tree.get start) (tree.get end) 36u32 file))))
			(return (call copy_inspected_callers (borrow-shared nodes) (borrow-shared functions)
				target (borrow-shared sites) count 0i32 (borrow-mut output))))))
