(module source_array_growth
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize operations on growable array owners and identify statement-only forms.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let array_capacity_kind 260u32)
	(let capacity_head "array.capacity")
	(let array_push_kind 261u32)
	(let push_head "array.push")
	(let array_remove_kind 262u32)
	(let remove_head "array.remove")
	(let array_truncate_kind 263u32)
	(let truncate_head "array.truncate")
	(let array_reserve_kind 264u32)
	(let reserve_head "array.reserve")
	(let array_try_reserve_kind 265u32)
	(let try_reserve_head "array.try-reserve")

	(fn array_growth_keyword
		(:doc `Match complete operation heads after the common array prefix.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Read the reserved extent of a live owner.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local capacity_head)) 0i32 (array.len (local capacity_head)))
				(then (return (local array_capacity_kind))))
			(if
				(:doc "Append one checked value to a writable owner.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local push_head)) 0i32 (array.len (local push_head)))
				(then (return (local array_push_kind))))
			(if
				(:doc "Remove one live element and preserve the surviving order.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local remove_head)) 0i32 (array.len (local remove_head)))
				(then (return (local array_remove_kind))))
			(if
				(:doc "Keep a requested live prefix.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local truncate_head)) 0i32 (array.len (local truncate_head)))
				(then (return (local array_truncate_kind))))
			(if
				(:doc "Ensure space for the requested extent.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local reserve_head)) 0i32 (array.len (local reserve_head)))
				(then (return (local array_reserve_kind))))
			(if
				(:doc "Report failed reservation without changing the array.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local try_reserve_head)) 0i32 (array.len (local try_reserve_head)))
				(then (return (local array_try_reserve_kind))))
			(return 0u32)))

	(fn is_array_growth
		(:doc `Recognize the contiguous operation tags used by the planner and emitter.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local array_capacity_kind))
			(u32.not-lt (local array_try_reserve_kind) (local kind))))))

	(fn is_array_growth_statement
		(:doc `Identify growth forms whose operations return no value.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local array_push_kind))
			(bool.or (u32.eq (local kind) (local array_truncate_kind))
				(u32.eq (local kind) (local array_reserve_kind))))))))
