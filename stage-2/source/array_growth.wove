(module source_array_growth
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize operations on growable array owners and identify statement-only forms.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let array_try_alloc_kind 609u32)
	(let array_try_extend_kind 610u32)
	(let array_try_push_kind 611u32)
	(let try_extend_head "try-extend")
	(let try_push_head "try-push")

	(let indexed_row_owner 255u32)

	(let array_capacity_kind 260u32)
	(let capacity_head "capacity")
	(let array_push_kind 261u32)
	(let push_head "push")
	(let array_remove_kind 262u32)
	(let remove_head "remove")
	(let array_truncate_kind 263u32)
	(let truncate_head "truncate")
	(let array_reserve_kind 264u32)
	(let reserve_head "reserve")
	(let array_try_reserve_kind 265u32)
	(let try_reserve_head "try-reserve")

	(fn array_growth_operation
		(:doc `Match the suffixes of operations on an existing growable array.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Read the reserved extent of a live owner.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared capacity_head) 0i32 capacity_head.len)
				(then (return array_capacity_kind)))
			(if
				(:doc "Append one checked value to a writable owner.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared push_head) 0i32 push_head.len)
				(then (return array_push_kind)))
			(if
				(:doc "Remove one live element and preserve the surviving order.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared remove_head) 0i32 remove_head.len)
				(then (return array_remove_kind)))
			(if
				(:doc "Keep a requested live prefix.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared truncate_head) 0i32 truncate_head.len)
				(then (return array_truncate_kind)))
			(if
				(:doc "Ensure space for the requested extent.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared reserve_head) 0i32 reserve_head.len)
				(then (return array_reserve_kind)))
			(if
				(:doc "Report failed reservation without changing the array.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared try_reserve_head) 0i32 try_reserve_head.len)
				(then (return array_try_reserve_kind)))
			(if
				(:doc "Append one complete shared view or preserve the array.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared try_extend_head) 0i32 try_extend_head.len)
				(then (return array_try_extend_kind)))
			(if
				(:doc "Return a typed outcome that holds the input on rejection.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared try_push_head) 0i32 try_push_head.len)
				(then (return array_try_push_kind)))
			(return 0u32)))

	(fn is_array_growth
		(:doc `Identify checked operations that act on an original growable owner.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (bool:and (u32:not-lt kind array_capacity_kind)
			(u32:not-lt array_try_reserve_kind kind))
			(bool:or (u32:eq kind array_try_extend_kind) (u32:eq kind array_try_push_kind))))))

	(fn is_array_growth_statement
		(:doc `Identify growth forms whose operations return no value.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (u32:eq kind array_push_kind)
			(bool:or (u32:eq kind array_truncate_kind)
				(u32:eq kind array_reserve_kind)))))))
