(module source_scan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read and render serialized Wove source through borrowed byte views.

	Admission validates UTF-8 before tokenization. The tree retains source-relative byte
	spans and links for forms, atoms, and metadata. Rendering uses those links to copy
	the original token spellings into caller-provided storage.`)

	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte is_c_identifier))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte)))
	(use wove-file "../text/utf8.wove" (only utf8_invalid_offset valid_utf8_width))
	(use wove-file "../text/quoted.wove" (only scan_double_quoted))
	(use wove-file "../text/character.wove" (only scan_character_span decode_character))

	(use wove-file "./receiver_words.wove" (only receiver_separator (value receiver_call_head)))
	(use wove-file "./field_paths.wove" (only field_path_segments preceding_field_separator (value field_path_get_head)))

	(let character_token 4u32)

	(struct Token (fields (kind u32) (start i32) (end i32) (error u32)))
	(struct SourceDiagnostic (fields (error u32) (start i32) (end i32)))
	(struct SourcePosition (fields (line u32) (column u32)))
	(struct FormCheck (fields (rows u32) (start i32) (end i32) (error u32) (receiver_rows u32)))
	(struct SourceNode
		(:doc "A source row with checked annotations and its ordinal within the owning function.")
		(fields (kind u32) (start i32) (end i32) (parent i32) (first_child i32) (next_sibling i32)
			(bridge_project i32) (bridge_default i32) (generic_kind u8) (generic_value u32)
			(c_ordinal i32)))
	(struct RenderResult (fields (written i32) (error u32)))
	(struct BridgeOpening (fields (header i32) (site i32) (error u32)))

	(fn is_ascii_whitespace
		(:doc `Match the seed's ASCII separators, U+0009–U+000D and U+001C–U+0020.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Test the two half-open ranges directly in the raw bytes.")
				(bool:or
					(bool:and (byte.not-lt 9u8) (byte.lt 14u8))
					(bool:and (byte.not-lt 28u8) (byte.lt 33u8))))))

	(fn is_parenthesis
		(:doc `Parentheses are both atom boundaries and one-byte tokens.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool:or (byte.eq 40u8) (byte.eq 41u8)))))

	(fn is_semicolon_or_quote
		(:doc `Stop an atom before a semicolon or any literal delimiter.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool:or (byte.eq 59u8)
					(bool:or (byte.eq 34u8)
						(bool:or (byte.eq 39u8) (byte.eq 96u8)))))))

	(fn skip_whitespace
		(:doc `Resume at the supplied cursor and leave the first non-whitespace byte unconsumed.`)
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let end source.len)
			(let-mut cursor start)
			(while
				(:doc "The end cursor needs no byte load.")
				(cursor.lt end)
				(body
					(let byte (source.get cursor))
					(let width (call whitespace_width (borrow-shared source) cursor byte))
					(if
						(:doc "Preserve the offset of the first byte that can start a token.")
						width.eqz
						(then (return cursor)))
					(set cursor (cursor.add width))))
			(return cursor)))

	(fn source_offset
		(:doc `Find the first significant byte or the end of this view.`)
		(params (source (shared-array u8)))
		(returns i32)
		(body
			(return (call skip_whitespace (borrow-shared source) 0i32))))

	(fn source_kind
		(:doc `Classify the first significant byte for callers that only need its original byte kind.`)
		(:expect
			(tests "stage-2/source_scan.probe.c")
			(issues "gh:wove-lang/wove:13"))
		(params (source (shared-array u8)))
		(returns u32)
		(body
			(let offset (call source_offset (borrow-shared source)))
			(if
				(:doc "Return the EOF kind before another load can reach the end of the view.")
				(offset.eq source.len)
				(then (return 0u32)))
			(let byte (source.get offset))
			(if
				(:doc "Preserve either parenthesis byte code as the kind.")
				(call is_parenthesis byte)
				(then (return (u32:from-u8 byte))))
			(return 1u32)))

	(fn bare_atom_end
		(:doc `Find the exclusive end of an atom whose first byte has already been accepted.`)
		(params (source (shared-array u8)) (next i32))
		(returns i32)
		(body
			(let length source.len)
			(let-mut cursor next)
			(while
				(:doc "The view can end immediately after the last atom byte.")
				(cursor.lt length)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "Stop before the first byte of any separator or token delimiter.")
						(bool:or
							(bool:or
								(call is_parenthesis byte)
								(call is_semicolon_or_quote byte))
							(i32:gtz (call whitespace_width (borrow-shared source) cursor byte)))
						(then (return cursor)))
					(set cursor cursor.inc)))
			(return cursor)))

	(fn is_line_ending
		(:doc `Recognize physical CR and LF bytes when counting source lines.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool:or (byte.eq 13u8) (byte.eq 10u8)))))

	(fn lexical_error
		(:doc `Keep the raw extent of a lexical error for the caller.`)
		(params (code u32) (start i32) (end i32))
		(returns Token)
		(body
			(return (struct:new Token
					(kind 3u32) (error code) (start start) (end end)))))

	(fn scan_quoted
		(:doc "Translate a shared double-quoted span into the Wove token and diagnostic kinds.")
		(params (source (shared-array u8)) (start i32))
		(returns Token)
		(body
			(let span (call scan_double_quoted (borrow-shared source) start (bool true)))
			(let end span/end)
			(let error span/error)
			(if
				(:doc "The three quoted scanning errors follow the unexpected-delimiter code.")
				error.gtz
				(then (return (call lexical_error error.inc start end))))
			(return (struct:new Token (kind 2u32) (error 0u32) (start start) (end end)))))

	(fn scan_character
		(:doc "Validate a single byte value and retain the complete character token spelling.")
		(params (source (shared-array u8)) (start i32)) (returns Token)
		(body
			(let span (call scan_character_span (borrow-shared source) start))
			(let end span/end)
			(if
				(:doc "Missing closing quotes use the existing unterminated-literal diagnostic.")
				(bool:not span/closed)
				(then (return (call lexical_error 2u32 start end))))
			(if
				(:doc "An invalid payload points to its original quoted token.")
				(i32:ltz (call decode_character (borrow-shared source) start end))
				(then
					(if
						(:doc "Keep unsupported and malformed escapes in the existing error category.")
						(call is_head_byte (borrow-shared source) start 1i32 92u8)
						(then (return (call lexical_error 3u32 start end))))
					(return (call lexical_error 25u32 start end))))
			(return (struct:new Token (kind character_token) (error 0u32) (start start) (end end)))))

	(fn scan_raw_string
		(:doc `Find the closing delimiter of a raw string in an admitted byte view.`)
		(:expect
			(tests "stage-2/lexer_stream.wove" "stage-2/lexer_errors.tsv")
			(issues "gh:wove-lang/wove:53"))
		(params (source (shared-array u8)) (start i32))
		(returns Token)
		(body
			(let length source.len)
			(let-mut cursor start.inc)
			(while
				(:doc "Advance from the opening delimiter without stepping outside the view.")
				(cursor.lt length)
				(body
					(let byte (source.get cursor))
					(set cursor cursor.inc)
					(if
						(:doc "Only a backtick can end the string.")
						(byte.eq 96u8)
						(then
							(if
								(:doc "Consume a doubled backtick only when both bytes are in the view.")
								(bool:and (cursor.lt length)
									(u8:eq (source.get cursor) 96u8))
								(then (set cursor cursor.inc))
								(else
									(return (struct:new Token
											(kind 2u32) (error 0u32) (start start) (end cursor)))))))))
			(return (call lexical_error 2u32 start length))))

	(fn scan_token
		(:doc `Scan one token in a view already checked by ``admit_source``.

		Start at a view-relative byte cursor and advance by the resulting exclusive end.
		Both string delimiters produce kind 2. Use the opening byte to tell the two
		spellings apart and keep all literal bytes in the span. Single-quoted character
		tokens have their own kind.`)
		(:expect
			(tests
				"stage-2/lexer_layouts.tsv" "stage-2/lexer_errors.tsv"
				"stage-2/source_decodings.tsv" "stage-2/source_scan.probe.c"
				"stage-2/lexer_stream.wove")
			(issues
				"gh:wove-lang/wove:29" "gh:wove-lang/wove:31" "gh:wove-lang/wove:33"
				"gh:wove-lang/wove:34"))
		(params (source (shared-array u8)) (cursor i32))
		(returns Token)
		(body
			(let start (call skip_whitespace (borrow-shared source) cursor))
			(let length source.len)
			(if
				(:doc "Only the exact end cursor can return EOF without another checked load.")
				(start.eq length)
				(then
					(return (struct:new Token (kind 0u32) (error 0u32) (start start) (end start)))))
			(let byte (source.get start))
			(let next start.inc)
			(if
				(:doc "Parentheses consume one byte and use their byte code as the token kind.")
				(call is_parenthesis byte)
				(then
					(return (struct:new Token
							(kind (u32:from-u8 byte))
							(error 0u32)
							(start start)
							(end next)))))
			(if
				(:doc "The opening quote selects the string scanner before interpreting any content.")
				(byte.eq 34u8)
				(then (return (call scan_quoted (borrow-shared source) start))))
			(if
				(:doc "A character can include delimiters when they are the quoted payload.")
				(byte.eq 39u8)
				(then (return (call scan_character (borrow-shared source) start))))
			(if
				(:doc "The backtick scanner keeps all literal bytes in the token span.")
				(byte.eq 96u8)
				(then (return (call scan_raw_string (borrow-shared source) start))))
			(if
				(:doc "An unquoted semicolon is an unexpected delimiter.")
				(byte.eq 59u8)
				(then (return (call lexical_error 1u32 start next))))
			(let end (call bare_atom_end (borrow-shared source) next))
			(return (struct:new Token (kind 1u32) (error 0u32) (start start) (end end)))))

	(fn admit_source
		(:doc `Admit the entire byte view once before tokenization.

		Return -1 for valid UTF-8 or the view-relative byte offset of the first
		malformed sequence. The caller keeps the original bytes for scanning and diagnostics.`)
		(:expect
			(tests "stage-2/lexer_errors.tsv")
			(issues "gh:wove-lang/wove:32"))
		(params (source (shared-array u8)))
		(returns i32)
		(body (return (call utf8_invalid_offset (borrow-shared source)))))

	(fn whitespace_width
		(:doc `Return the byte width of a seed separator at the cursor, or zero.`)
		(params (source (shared-array u8)) (cursor i32) (lead u8))
		(returns i32)
		(body
			(if
				(:doc "ASCII uses the seed's two contiguous separator ranges.")
				(lead.lt 128u8)
				(then
					(if
						(:doc "Return a single-byte width for either ASCII range.")
						(call is_ascii_whitespace lead)
						(then (return 1i32)))
					(return 0i32)))
			(let remaining (i32:sub source.len cursor))
			(if
				(:doc "U+0085 and U+00A0 are the only two-byte separators.")
				(lead.eq 194u8)
				(then
					(if
						(:doc "Keep the second-byte load inside this view.")
						(remaining.lt 2i32)
						(then (return 0i32)))
					(let second (source.get cursor.inc))
					(if
						(:doc "The C2 prefix has two accepted suffixes.")
						(bool:or (second.eq 133u8) (second.eq 160u8))
						(then (return 2i32)))
					(return 0i32)))
			(if
				(:doc "Three-byte separators start with E1, E2, or E3 and need both suffix bytes.")
				(bool:or
					(remaining.lt 3i32)
					(bool:or (lead.lt 225u8) (u8:lt 227u8 lead)))
				(then (return 0i32)))
			(let second (source.get cursor.inc))
			(let third (source.get (cursor.add 2i32)))
			(if
				(:doc "E1 9A 80 is U+1680.")
				(lead.eq 225u8)
				(then
					(if
						(:doc "U+1680 occupies all three bytes.")
						(bool:and (second.eq 154u8) (third.eq 128u8))
						(then (return 3i32)))
					(return 0i32)))
			(if
				(:doc "E3 80 80 is U+3000.")
				(lead.eq 227u8)
				(then
					(if
						(:doc "The E3 prefix has one accepted suffix.")
						(bool:and (second.eq 128u8) (third.eq 128u8))
						(then (return 3i32)))
					(return 0i32)))
			(if
				(:doc "E2 81 9F is U+205F.")
				(bool:and (second.eq 129u8) (third.eq 159u8))
				(then (return 3i32)))
			(if
				(:doc "E2 80 covers U+2000 through U+200A, U+2028, U+2029, and U+202F.")
				(bool:and
					(second.eq 128u8)
					(bool:or
						(bool:and (third.not-lt 128u8) (third.lt 139u8))
						(bool:or
							(bool:or (third.eq 168u8) (third.eq 169u8))
							(third.eq 175u8))))
				(then (return 3i32)))
			(return 0i32)))

	(fn source_diagnostic
		(:doc `Expose admission failures in the same diagnostic code space as lexical errors.`)
		(params (source (shared-array u8)))
		(returns SourceDiagnostic)
		(body
			(let start (call admit_source (borrow-shared source)))
			(if
				(:doc "Successful admission carries no primary span.")
				start.ltz
				(then
					(return (struct:new SourceDiagnostic (error 0u32) (start 0i32) (end 0i32)))))
			(let end
				(:doc "Anchor malformed UTF-8 at its lead byte, even when the sequence is clipped.") start.inc)
			(return (struct:new SourceDiagnostic (error 5u32) (start start) (end end)))))

	(fn source_position
		(:doc `Map a view-relative span start to its coordinates in the parent source.`)
		(params (parent (shared-array u8)) (view_start i32) (span_start i32))
		(returns SourcePosition)
		(body
			(let target (view_start.add span_start))
			(let-mut cursor 0i32)
			(let-mut line 1u32)
			(let-mut column 1u32)
			(let-mut previous_cr (bool false))
			(while
				(:doc "Only bytes before the requested start can advance its coordinates.")
				(cursor.lt target)
				(body
					(let byte (parent.get cursor))
					(if
						(:doc "Count each physical line break once, including a CRLF pair.")
						(call is_line_ending byte)
						(then
							(if
								(:doc "An LF paired with the previous CR continues the same break.")
								(bool:or (byte.eq 13u8) previous_cr.not)
								(then (set line line.inc)))
							(set column 1u32)
							(set cursor cursor.inc))
						(else
							(let-mut width (call valid_utf8_width (borrow-shared parent) cursor byte))
							(if
								(:doc "Count malformed bytes individually to preserve subsequent line breaks.")
								width.eqz
								(then (set width 1i32)))
							(let remaining (target.sub cursor))
							(if
								(:doc "An offset inside a scalar still belongs to that scalar's column.")
								(remaining.lt width)
								(then (set cursor target))
								(else
									(set column column.inc)
									(set cursor (cursor.add width))))))
					(set previous_cr (byte.eq 13u8))))
			(return (struct:new SourcePosition (line line) (column column)))))

	(fn form_failure
		(:doc `Carry the first failure's original span back through the form check.`)
		(params (error u32) (start i32) (end i32))
		(returns FormCheck)
		(body
			(return (struct:new FormCheck
					(rows 0u32) (start start) (end end) (error error) (receiver_rows 0u32)))))

	(fn unclosed_form_start
		(:doc `Locate the last opener at the final depth of a stream that reached EOF.`)
		(params (source (shared-array u8)) (final_depth i32))
		(returns i32)
		(body
			(let length source.len)
			(let-mut cursor 0i32)
			(let-mut depth 0i32)
			(let-mut opener 0i32)
			(while
				(:doc "Rescan only after the first pass proves the tokens reach EOF.")
				(cursor.lt length)
				(body
					(let token (call scan_token (borrow-shared source) cursor))
					(let kind token/kind)
					(set cursor token/end)
					(if
						(:doc "The innermost unclosed form is the final opener at final_depth.")
						(kind.eq 40u32)
						(then
							(set depth depth.inc)
							(if
								(:doc "Replace a candidate that may already have closed.")
								(depth.eq final_depth)
								(then (set opener token/start)))))
					(if
						(:doc "Close the innermost form before classifying the next token.")
						(kind.eq 41u32)
						(then (set depth depth.dec)))))
			(return opener)))

	(fn check_source_form
		(:doc `Validate one tagged root and count the rows needed to build its tree.

		Admission and lexer failures take precedence when encountered. Count a synthetic
		source root and one row per opener or atom. A closer contributes to its form span.`)
		(:expect
			(tests "stage-2/source_forms.tsv")
			(issues "gh:wove-lang/wove:43"))
		(params (source (shared-array u8)))
		(returns FormCheck)
		(body
			(let admission (call source_diagnostic (borrow-shared source)))
			(let admission_error admission/error)
			(if
				(:doc "Admission failures take precedence over any form structure.")
				admission_error.gtz
				(then
					(return (call form_failure admission_error
							admission/start admission/end))))
			(let length source.len)
			(let-mut cursor 0i32)
			(let-mut rows 1u32)
			(let-mut depth 0i32)
			(let-mut root_start -1i32)
			(let-mut root_end 0i32)
			(let-mut needs_tag (bool false))
			(let-mut receiver_rows 0u32)
			(let-mut metadata_depth -1i32)
			(let-mut body_depth -1i32)
			(while
				(:doc "Advance by raw token ends and keep only the state of the open forms.")
				(cursor.lt length)
				(body
					(let token (call scan_token (borrow-shared source) cursor))
					(let kind token/kind)
					(let start token/start)
					(let end token/end)
					(let error token/error)
					(set cursor end)
					(if
						(:doc "Keep the lexer's original error code and byte span.")
						error.gtz
						(then (return (call form_failure error start end))))
					(if
						(:doc "Each opener, bare atom, and quoted atom occupies a row.")
						(bool:not (bool:or kind.eqz (kind.eq 41u32)))
						(then (set rows rows.inc)))
					(if
						(:doc "The end marker leaves the structural state unchanged.")
						kind.not-eqz
						(then
							(if
								(:doc "The first significant token after an opener must be a bare tag.")
								(needs_tag.and (kind.not-eq 1u32))
								(then (return (call form_failure 7u32 start end))))
							(if
								(:doc "Only unquoted atoms outside metadata can introduce receiver shorthand.")
								(bool:and (kind.eq 1u32) metadata_depth.ltz)
								(then
									(if
										(:doc "Preserve every atom inside a metadata entry as written.")
										(needs_tag.and (u8:eq (source.get start) 58u8))
										(then (set metadata_depth depth))
										(else
											(if
												(:doc "Only executable bodies use receiver syntax. Signature and layout heads keep their raw grammar.")
												body_depth.ltz
												(then
													(if
														(:doc "Remember the outer executable body through its matching closer.")
														(needs_tag.and (call same_bytes (borrow-shared source) start end
															(borrow-shared body_head) 0i32 4i32))
														(then (set body_depth depth))))
												(else
													(let separator (call receiver_separator (borrow-shared source) start end))
													(if
														(:doc "Reserve the complete receiver. A bare operation also adds its surrounding form.")
														separator.not-ltz
														(then
															(let segments (call field_path_segments (borrow-shared source) start separator))
															(set receiver_rows (receiver_rows.add (u32:inc (segments.mul 3u32))))
															(if needs_tag.not (then (set receiver_rows receiver_rows.inc))))
														(else
															(if
																(:doc "Each field adds a projection form, a head, and a field operand.")
																needs_tag.not
																(then
																	(let segments (call field_path_segments (borrow-shared source) start end))
																	(set receiver_rows (receiver_rows.add (segments.mul 3u32)))))))))))))
							(set needs_tag (kind.eq 40u32))
							(if
								(:doc "At depth zero, a significant token must start the only root.")
								depth.eqz
								(then
									(if
										(:doc "A closer at depth zero has no matching opener.")
										(kind.eq 41u32)
										(then (return (call form_failure 8u32 start end))))
									(if
										(:doc "A completed root allows only trailing trivia.")
										root_start.not-ltz
										(then (return (call form_failure 10u32 start end))))
									(if
										(:doc "A bare or quoted atom cannot serve as the root.")
										needs_tag.not
										(then (return (call form_failure 6u32 start end))))
									(set root_start start)))
							(if
								(:doc "A closer completes its form and may finish the root span.")
								(kind.eq 41u32)
								(then
									(set depth depth.dec)
									(if
										(:doc "Resume counting only after the complete metadata entry ends.")
										(depth.lt metadata_depth)
										(then (set metadata_depth -1i32)))
									(if
										(:doc "Declarations after the executable body use the raw word grammar.")
										(depth.lt body_depth)
										(then (set body_depth -1i32)))
									(if
										(:doc "Preserve the exclusive end of the actual root.")
										depth.eqz
										(then (set root_end end)))))
							(if
								(:doc "Only an opener increases depth.")
								needs_tag
								(then (set depth depth.inc)))))))
			(if
				(:doc "Prefer the innermost unmatched opener as the primary EOF span.")
				depth.gtz
				(then
					(let opener (call unclosed_form_start (borrow-shared source) depth))
					(return (call form_failure 9u32 opener opener.inc))))
			(if
				(:doc "Empty or whitespace-only input anchors the missing root at EOF.")
				root_start.ltz
				(then (return (call form_failure 6u32 length length))))
			(return (struct:new FormCheck
					(rows rows) (start root_start) (end root_end) (error 0u32) (receiver_rows receiver_rows)))))

	(fn new_source_node
		(:doc `Initialize a row with its parent and empty child and sibling links.`)
		(params (kind u32) (start i32) (end i32) (parent i32))
		(returns SourceNode)
		(body
			(return (struct:new SourceNode
					(kind kind) (start start) (end end) (parent parent)
					(first_child -1i32) (next_sibling -1i32) (bridge_project -1i32) (bridge_default -1i32)
					(generic_kind 0u8) (generic_value 0u32)
					(c_ordinal -1i32)))))

	(fn revise_source_node
		(:doc `Replace a row's end and outgoing links while keeping its identity and parent.`)
		(params (node SourceNode) (end i32) (first_child i32) (next_sibling i32))
		(returns SourceNode)
		(body
			(return (struct:new SourceNode
					(kind node/kind)
					(start node/start)
					(end end)
					(parent node/parent)
					(first_child first_child)
					(next_sibling next_sibling)
					(bridge_project node/bridge_project) (bridge_default node/bridge_default)
					(generic_kind node/generic_kind) (generic_value node/generic_value)
					(c_ordinal node/c_ordinal)))))

	(fn append_source_child
		(:doc `Append a child in source order using the open parent's end field to track its last child.`)
		(params (nodes (mut-array SourceNode)) (parent i32) (index i32) (child SourceNode))
		(returns void)
		(body
			(let container (nodes.get parent))
			(let tail container/end)
			(let-mut first container/first_child)
			(if
				(:doc "A first child sets the container entry point; later children extend the sibling chain.")
				tail.ltz
				(then (set first index))
				(else
					(let sibling (nodes.get tail))
					(nodes.set tail
						(call revise_source_node sibling
							sibling/end
							sibling/first_child
							index))))
			(nodes.set parent
				(call revise_source_node container index first
					container/next_sibling))
			(nodes.set index child)))

	(fn seal_source_node
		(:doc `Finalize the byte span once an open container has received all of its children.`)
		(params (nodes (mut-array SourceNode)) (index i32) (node SourceNode) (end i32))
		(returns void)
		(body
			(nodes.set index
				(call revise_source_node node end
					node/first_child
					node/next_sibling))))

	(fn build_source_tree
		(:doc "Build the source-ordered tree used by scanners and source rendering.")
		(:expect
			(tests "stage-2/source_trees.tsv")
			(issues "gh:wove-lang/wove:45"))
		(params (source (shared-array u8)) (checked FormCheck) (nodes (mut-array SourceNode)))
		(returns FormCheck)
		(body (return (call build_tree (borrow-shared source) checked (borrow-mut nodes) (bool false)))))

	(fn is_qualified_part_tail
		(:doc "Allow hyphens in addition to identifier bytes within an operation name.")
		(:pragma (inline always))
		(params (byte u8)) (returns bool)
		(body (return (bool:or (call is_c_identifier_byte byte) (byte.eq 45u8)))))

	(fn is_identifier_head
		(:doc "Validate a form word or a qualified operation, after any metadata colon.")
		(:pragma (inline always))
		(params (source (shared-array u8)) (start i32) (end i32) (allow_qualification bool))
		(returns bool)
		(body
			(if
				(:doc "A colon alone has no identifier and must never trigger a byte load.")
				(start.not-lt end)
				(then (return (bool false))))
			(let first (source.get start))
			(if
				(:doc "The leading identifier byte cannot use continuation-only characters.")
				(bool:not (call is_c_identifier_start first))
				(then (return (bool false))))
			(let-mut cursor start.inc)
			(let-mut may_qualify allow_qualification)
			(let-mut qualified (bool false))
			(while
				(:doc "Validate the raw head through its exclusive end.")
				(cursor.lt end)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "One colon may separate a dot-free family from a nonempty operation name.")
						(byte.eq 58u8)
						(then
							(set cursor cursor.inc)
							(if
								(:doc "Check the start of the suffix before advancing to its tail.")
								(bool:or may_qualify.not
									(bool:or (cursor.not-lt end)
										(bool:not (call is_c_identifier_start (source.get cursor)))))
								(then (return (bool false))))
							(set qualified (bool true))
							(set may_qualify (bool false)))
						(else
							(if
								(:doc "Dots belong to unqualified words and metadata tags.")
								(byte.eq 46u8)
								(then
									(if qualified (then (return (bool false))))
									(set may_qualify (bool false)))
								(else
									(if
										(:doc "Reject bytes outside the form word alphabet.")
										(bool:not (call is_qualified_part_tail byte))
										(then (return (bool false))))))))
					(set cursor cursor.inc)))
			(return (bool true))))

	(fn is_meta_head
		(:doc `Match the literal meta head within its raw byte span.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(return
				(:doc "The width comparison protects all four byte reads.")
				(bool:and
					(i32:eq (end.sub start) 4i32)
					(bool:and
						(bool:and
							(call is_head_byte (borrow-shared source) start 0i32 109u8)
							(call is_head_byte (borrow-shared source) start 1i32 101u8))
						(bool:and
							(call is_head_byte (borrow-shared source) start 2i32 116u8)
							(call is_head_byte (borrow-shared source) start 3i32 97u8)))))))

	(fn is_with_meta_head
		(:doc `Match with-meta exactly and reuse the checked meta suffix.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (head SourceNode))
		(returns bool)
		(body
			(let start head/start)
			(let end head/end)
			(return
				(:doc "Read the prefix and suffix only after checking the full head width.")
				(bool:and
					(i32:eq (end.sub start) 9i32)
					(bool:and
						(bool:and
							(call is_head_byte (borrow-shared source) start 0i32 119u8)
							(call is_head_byte (borrow-shared source) start 1i32 105u8))
						(bool:and
							(bool:and
								(call is_head_byte (borrow-shared source) start 2i32 116u8)
								(call is_head_byte (borrow-shared source) start 3i32 104u8))
							(bool:and
								(call is_head_byte (borrow-shared source) start 4i32 45u8)
								(call is_meta_head (borrow-shared source)
									(start.add 5i32) end))))))))

	(fn is_disabled_head
		(:doc `Match the complete disabled tag in the checked source view.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (head SourceNode))
		(returns bool)
		(body
			(let start head/start)
			(let width (i32:sub head/end start))
			(return (bool:and (width.eq 8i32)
				(bool:and
					(bool:and (call is_head_byte (borrow-shared source) start 0i32 100u8)
						(call is_head_byte (borrow-shared source) start 1i32 105u8))
					(bool:and
						(bool:and (call is_head_byte (borrow-shared source) start 2i32 115u8)
							(call is_head_byte (borrow-shared source) start 3i32 97u8))
						(bool:and
							(bool:and (call is_head_byte (borrow-shared source) start 4i32 98u8)
								(call is_head_byte (borrow-shared source) start 5i32 108u8))
							(bool:and (call is_head_byte (borrow-shared source) start 6i32 101u8)
								(call is_head_byte (borrow-shared source) start 7i32 100u8)))))))))

	(fn is_disabled_form
		(:doc `Identify a disabled sibling by its complete form head.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body (return (bool:and (u32:eq node/kind 40u32)
			(call is_disabled_head (borrow-shared source)
				(nodes.get node/first_child))))))

	(let module_head "module")
	(let fn_head "fn")
	(let decls_head "decls")
	(let bridge_head "bridge")
	(let let_head "let")
	(let struct_head "struct")
	(let enum_head "enum")
	(let type_head "type")
	(let const_head "const")
	(let let_mut_head "let-mut")
	(let generic_head "generic")
	(let body_head "body")
	(let then_head "then")
	(let else_head "else")
	(let case_head "case")
	(let for_head "for")
	(let snapshot_head "snapshot")

	(fn head_matches
		(:doc "Compare a checked bare tag with an exact spelling.")
		(:pragma (inline always))
		(params (source (shared-array u8)) (node SourceNode) (word (shared-array u8))) (returns bool)
		(body (return (bool:and (u32:eq node/kind 1u32)
			(call same_bytes (borrow-shared source) node/start node/end
				(borrow-shared word) 0i32 word.len)))))

	(fn declaration_head
		(:doc "Classify declaration heads and the containers that establish their name slots.")
		(params (source (shared-array u8)) (node SourceNode)) (returns u32)
		(body
			(if (call head_matches (borrow-shared source) node (borrow-shared module_head)) (then (return 1u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared fn_head)) (then (return 2u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared decls_head)) (then (return 3u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared bridge_head)) (then (return 4u32)))
			(if (call is_disabled_head (borrow-shared source) node) (then (return 5u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared let_head)) (then (return 6u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared struct_head)) (then (return 7u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared enum_head)) (then (return 8u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared type_head)) (then (return 9u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared const_head)) (then (return 10u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared let_mut_head)) (then (return 11u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared generic_head)) (then (return 12u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared body_head)) (then (return 13u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared then_head)) (then (return 14u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared else_head)) (then (return 15u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared case_head)) (then (return 16u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared for_head)) (then (return 17u32)))
			(if (call head_matches (borrow-shared source) node (borrow-shared snapshot_head)) (then (return 18u32)))
			(return 0u32)))

	(fn is_metadata_form
		(:doc `Recognize a colon-tagged form by its checked head.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(if
				(:doc "Only a form has a head to check.")
				(u32:not-eq node/kind 40u32)
				(then (return (bool false))))
			(let head (nodes.get node/first_child))
			(return (u8:eq (source.get head/start) 58u8))))

	(fn is_wove_name
		(:doc `Check an unquoted user-written name with the shared ASCII identifier grammar.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool:and (u32:eq node/kind 1u32)
				(call is_c_identifier (borrow-shared source)
					node/start node/end)))))

	(fn is_c_header_provider
		(:doc `Match the bare provider keyword shared by C bridge definitions and imports.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(let start node/start)
			(let width (i32:sub node/end start))
			(return (bool:and (u32:eq node/kind 1u32)
				(bool:and (width.eq 8i32)
					(bool:and (call is_head_byte (borrow-shared source) start 0i32 99u8)
						(bool:and (call is_head_byte (borrow-shared source) start 1i32 45u8)
							(bool:and (call is_head_byte (borrow-shared source) start 2i32 104u8)
								(bool:and (call is_head_byte (borrow-shared source) start 3i32 101u8)
									(bool:and (call is_head_byte (borrow-shared source) start 4i32 97u8)
										(bool:and (call is_head_byte (borrow-shared source) start 5i32 100u8)
											(bool:and (call is_head_byte (borrow-shared source) start 6i32 101u8)
												(call is_head_byte (borrow-shared source) start 7i32 114u8)))))))))))))

	(fn first_ordinary_child
		(:doc `Locate an opening slot past any misplaced metadata so its original span remains available.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (previous SourceNode))
		(returns i32)
		(body
			(let-mut index previous/next_sibling)
			(while
				(:doc "Skip only the contiguous metadata that precedes the fixed field.")
				(bool:and index.not-ltz
					(call is_metadata_form (borrow-shared source) (borrow-shared nodes)
						(nodes.get index)))
				(body (set index (struct:get (nodes.get index) next_sibling))))
			(return index)))

	(fn bridge_opening
		(:doc `Keep a C bridge header row and any fixed-slot diagnostic.`)
		(params (header i32) (site i32) (error u32))
		(returns BridgeOpening)
		(body (return (struct:new BridgeOpening (header header) (site site) (error error)))))

	(fn c_bridge_opening
		(:doc `Read the fixed slots that follow a bridge head.

		Recover a quoted header across misplaced metadata so the matching
		header import can report the placement error in this provider.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (head SourceNode))
		(returns BridgeOpening)
		(body
			(let provider_row (call first_ordinary_child (borrow-shared source) (borrow-shared nodes) head))
			(if
				(:doc "Other bridge providers retain their ordinary operand grammar.")
				(bool:or provider_row.ltz
					(bool:not (call is_c_header_provider (borrow-shared source) (nodes.get provider_row))))
				(then (return (call bridge_opening -1i32 -1i32 0u32))))
			(let provider (nodes.get provider_row))
			(let header_slot provider/next_sibling)
			(let header_row (call first_ordinary_child (borrow-shared source) (borrow-shared nodes) provider))
			(let-mut header -1i32)
			(if
				(:doc "Only a checked string token can supply a C header key.")
				(bool:and (i32:lt -1i32 header_row)
					(u32:eq (struct:get (nodes.get header_row) kind) 2u32))
				(then (set header header_row)))
			(let provider_slot head/next_sibling)
			(if
				(:doc "A metadata entry in the provider slot points to its own tag.")
				(provider_slot.not-eq provider_row)
				(then (return (call bridge_opening header
					(struct:get (nodes.get provider_slot) first_child) 13u32))))
			(if
				(:doc "A metadata entry in the header slot is likewise too early.")
				(header_slot.not-eq header_row)
				(then (return (call bridge_opening header
					(struct:get (nodes.get header_slot) first_child) 13u32))))
			(if
				(:doc "A missing or non-string header is a malformed bridge opening.")
				header.ltz
				(then (return (call bridge_opening -1i32 header_row 26u32))))
			(return (call bridge_opening header -1i32 0u32))))

	(fn is_c_bridge_member
		(:doc `Check that a C bridge member follows a complete header-first opening.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (head SourceNode) (start i32))
		(returns bool)
		(body
			(let opening (call c_bridge_opening (borrow-shared source) (borrow-shared nodes) head))
			(let header opening/header)
			(return (bool:and (u32:eqz opening/error)
				(bool:and (i32:lt -1i32 header)
					(start.not-lt (struct:get (nodes.get header) end)))))))

	(fn declaration_context
		(:doc "Return 1 for Wove and 2 for C declarations reached through actual declaration containers.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (declaration u32))
		(returns u32)
		(body
			(let standalone (bool:or (declaration.eq 2u32)
				(bool:or (declaration.eq 4u32)
					(bool:and (declaration.not-lt 7u32) (u32:not-lt 9u32 declaration)))))
			(let-mut index node/parent)
			(let-mut start node/start)
			(let-mut context 1u32)
			(while
				(:doc "Follow only actual declaration containers to the source root.")
				index.not-ltz
				(body
					(let owner (nodes.get index))
					(if
						(:doc "Source inspection also admits standalone declarations and standalone bridges.")
						(u32:eqz owner/kind)
						(then
							(if (standalone.or (context.eq 2u32)) (then (return context)))
							(return 0u32)))
					(let parent owner/parent)
					(let head (nodes.get owner/first_child))
					(let kind (call declaration_head (borrow-shared source) head))
					(if
						(:doc "Only the root module owns declarations after its bare name.")
						(kind.eq 1u32)
						(then
							(let first head/next_sibling)
							(if
								(:doc "A malformed or nested module cannot establish a declaration namespace.")
								(bool:or first.ltz
									(u32:not-eqz (struct:get (nodes.get parent) kind)))
								(then (return 0u32)))
							(let name (nodes.get first))
							(if
								(:doc "The candidate must follow the module's bare name.")
								(bool:and (call is_wove_name (borrow-shared source) name)
									(start.not-lt name/end))
								(then (return context)))
							(return 0u32)))
					(if
						(:doc "A bridge contributes members only after a complete C header opening.")
						(kind.eq 4u32)
						(then
							(if
								(:doc "Opaque providers and nested bridges do not establish member context.")
								(bool:or (context.eq 2u32) (bool:not (call is_c_bridge_member
									(borrow-shared source) (borrow-shared nodes) head start)))
								(then (return 0u32)))
							(set context 2u32))
						(else
							(if
								(:doc "Groups and disabled forms preserve the surrounding declaration context.")
								(bool:not (bool:or (kind.eq 3u32) (kind.eq 5u32)))
								(then (return 0u32)))))
					(set start owner/start)
					(set index parent)))
			(return 0u32)))

	(fn read_c_bridge_opening
		(:doc "Apply the header-first opening only to actual C bridge declarations.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (head SourceNode))
		(returns BridgeOpening)
		(body
			(if
				(:doc "An opaque payload can use bridge as an ordinary form tag.")
				(bool:and (u32:eq (call declaration_head (borrow-shared source) head) 4u32)
					(u32:eq (call declaration_context (borrow-shared source) (borrow-shared nodes) node 4u32) 1u32))
				(then (return (call c_bridge_opening (borrow-shared source) (borrow-shared nodes) head))))
			(return (call bridge_opening -1i32 -1i32 0u32))))

	(fn inside_function_body
		(:doc "Find a body of an actual Wove function without looking through metadata.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32))
		(returns bool)
		(body
			(let-mut cursor index)
			(while
				(:doc "Match arms and nested blocks can occur under expressions within a body.")
				cursor.not-ltz
				(body
					(let owner (nodes.get cursor))
					(let parent owner/parent)
					(if
						(:doc "The root and opaque metadata delimit the body search.")
						(bool:or parent.ltz
							(call is_metadata_form (borrow-shared source) (borrow-shared nodes) owner))
						(then (return (bool false))))
					(let tag (nodes.get owner/first_child))
					(let enclosing (nodes.get parent))
					(if
						(:doc "A real body field is directly inside a Wove function declaration.")
						(bool:and (call head_matches (borrow-shared source) tag (borrow-shared body_head))
							(bool:and (u32:eq enclosing/kind 40u32)
								(call head_matches (borrow-shared source)
									(nodes.get enclosing/first_child) (borrow-shared fn_head))))
						(then (return (u32:eq (call declaration_context (borrow-shared source)
							(borrow-shared nodes) enclosing 2u32) 1u32))))
					(set cursor parent)))
			(return (bool false))))

	(fn generic_name_ordinal
		(:doc "Only the first ordinary field of a Wove function or struct establishes generic parameters.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (owner SourceNode))
		(returns bool)
		(body
			(let declaration (nodes.get owner/parent))
			(if (u32:not-eq declaration/kind 40u32) (then (return (bool false))))
			(let head (nodes.get declaration/first_child))
			(let tag (call declaration_head (borrow-shared source) head))
			(let name head/next_sibling)
			(if
				(:doc "Opaque and foreign lookalikes cannot establish a template.")
				(bool:or name.ltz
					(bool:or (bool:not (bool:or (tag.eq 2u32) (tag.eq 7u32)))
						(u32:not-eq (call declaration_context (borrow-shared source) (borrow-shared nodes) declaration tag) 1u32)))
				(then (return (bool false))))
			(let first (call first_ordinary_child (borrow-shared source) (borrow-shared nodes) (nodes.get name)))
			(return (bool:and first.not-ltz
				(i32:eq (struct:get (nodes.get first) start) owner/start)))))

	(fn local_name_mode
		(:doc "Distinguish local declarations from for patterns, which can bind a second name.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (tag u32))
		(returns u32)
		(body
			(let-mut index node/parent)
			(while
				(:doc "Disabled blocks preserve the syntax of their statements.")
				index.not-ltz
				(body
					(let owner (nodes.get index))
					(if (u32:not-eq owner/kind 40u32) (then (return 0u32)))
					(let head (nodes.get owner/first_child))
					(let kind (call declaration_head (borrow-shared source) head))
					(if
						(:doc "Only a statement block or a for binder owns the local name.")
						(kind.not-eq 5u32)
						(then
							(if
								(:doc "The for binder must be the first ordinary form in the header.")
								(bool:and (kind.eq 17u32) (tag.eq 6u32))
								(then
									(let first (call first_ordinary_child (borrow-shared source) (borrow-shared nodes) head))
									(if
										(:doc "Only headers inside a Wove function body introduce binders.")
										(bool:and first.not-ltz
											(bool:and (i32:eq (struct:get (nodes.get first) start) node/start)
												(call inside_function_body (borrow-shared source) (borrow-shared nodes) index)))
										(then (return 6u32)))
									(return 0u32)))
							(if
								(:doc "A local statement must ultimately belong to a Wove function body.")
								(bool:and (kind.not-lt 13u32)
									(bool:and (u32:not-lt 16u32 kind)
										(call inside_function_body (borrow-shared source) (borrow-shared nodes) index)))
								(then (return 5u32)))
							(return 0u32)))
					(set index owner/parent)))
			(return 0u32)))

	(fn form_name_mode
		(:doc "Distinguish anonymous forms, modules, functions, Wove and C declarations, locals, iteration and generic names.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (head SourceNode))
		(returns u32)
		(body
			(let tag (call declaration_head (borrow-shared source) head))
			(if
				(:doc "Only declaration heads are candidates for a fixed name slot.")
				(bool:not (bool:or (tag.eq 1u32)
					(bool:or (tag.eq 2u32)
						(bool:or (bool:and (tag.not-lt 6u32) (u32:not-lt 11u32 tag)) (tag.eq 18u32)))))
				(then (return 0u32)))
			(let owner (nodes.get node/parent))
			(if
				(:doc "Only the source root can declare a module.")
				(tag.eq 1u32)
				(then
					(if (u32:eqz owner/kind) (then (return 1u32)))
					(return 0u32)))
			(let context (call declaration_context (borrow-shared source) (borrow-shared nodes) node tag))
			(if
				(:doc "Both Wove and C functions allow interleaved metadata after their name.")
				(bool:and (tag.eq 2u32) context.not-eqz)
				(then (return 2u32)))
			(if
				(:doc "C bridges name types, constants, foreign bindings and private snapshot mappings.")
				(context.eq 2u32)
				(then
					(if (tag.not-eq 8u32) (then (return 4u32)))
					(return 0u32)))
			(if
				(:doc "Wove modules name immutable bindings and named types.")
				(bool:and (context.eq 1u32) (tag.lt 10u32))
				(then (return 3u32)))
			(if
				(:doc "Generic parameters use a contiguous prefix, including fn parameters.")
				(bool:and (bool:or (tag.eq 2u32) (bool:or (tag.eq 9u32) (tag.eq 10u32)))
					(bool:and (u32:eq owner/kind 40u32)
						(call head_matches (borrow-shared source)
							(nodes.get owner/first_child) (borrow-shared generic_head))))
				(then
					(if (call generic_name_ordinal (borrow-shared source) (borrow-shared nodes) owner)
						(then (return 7u32)))))
			(if
				(:doc "Local declarations and patterns depend on their enclosing function body.")
				(bool:or (tag.eq 6u32) (tag.eq 11u32))
				(then (return (call local_name_mode (borrow-shared source) (borrow-shared nodes) node tag))))
			(return 0u32)))

	(fn second_form_name
		(:doc "An indexed iteration pattern can declare a second name before its metadata.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (mode u32) (next i32))
		(returns i32)
		(body
			(if
				(:doc "A metadata entry ends the fixed opening slots.")
				(bool:and (mode.eq 6u32)
					(bool:and next.not-ltz
						(bool:not (call is_metadata_form (borrow-shared source) (borrow-shared nodes)
							(nodes.get next)))))
				(then (return next)))
			(return -1i32)))

	(fn missing_form_name_error
		(:doc "Keep the diagnostic family of the declaration that owns a missing slot.")
		(params (mode u32)) (returns u32)
		(body
			(if (mode.eq 1u32) (then (return 19u32)))
			(if (mode.eq 4u32) (then (return 23u32)))
			(if (bool:or (mode.eq 5u32) (mode.eq 6u32)) (then (return 24u32)))
			(return 22u32)))

	(fn invalid_form_name_error
		(:doc "Select the diagnostic for a present but invalid name token.")
		(params (mode u32)) (returns u32)
		(body
			(if (mode.eq 4u32) (then (return 26u32)))
			(if (bool:or (mode.eq 5u32) (mode.eq 6u32)) (then (return 34u32)))
			(return (call missing_form_name_error mode))))

	(fn source_node_failure
		(:doc `Use an existing row as the primary span of a structural diagnostic.`)
		(params (code u32) (node SourceNode))
		(returns FormCheck)
		(body
			(return (call form_failure code
					node/start node/end))))

	(fn check_metadata_children
		(:doc `Validate child heads, fixed opening slots, and the enclosing metadata prefix.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(container SourceNode) (checked FormCheck))
		(returns FormCheck)
		(body
			(let-mut in_prefix (u32:eq container/kind 40u32))
			(let-mut child_index container/first_child)
			(let-mut name_mode 0u32)
			(let-mut interleaved (bool false))
			(if
				(:doc "A tagged form can own metadata. The synthetic root has no prefix.")
				in_prefix
				(then
					(let tag (nodes.get child_index))
					(set name_mode (call form_name_mode (borrow-shared source)
						(borrow-shared nodes) container tag))
					(set interleaved name_mode.gtz)
					(set child_index tag/next_sibling)
					(let opening (call read_c_bridge_opening (borrow-shared source)
						(borrow-shared nodes) container tag))
					(let error opening/error)
					(if
						(:doc "Keep a misplaced entry or invalid header on the original slot. An absent header points to the bridge.")
						error.gtz
						(then
							(let site opening/site)
							(if
								(:doc "The next operand, if present, has the more precise span.")
								(i32:lt -1i32 site)
								(then (return (call source_node_failure error (nodes.get site)))))
							(return (call source_node_failure error container))))
					(let header opening/header)
					(if
						(:doc "The C bridge metadata prefix begins immediately after the header.")
						(i32:lt -1i32 header)
						(then (set child_index (struct:get (nodes.get header) next_sibling))))))
			(if
				(:doc "Actual declarations place their bare names before their metadata.")
				name_mode.gtz
				(then
					(if
						(:doc "A missing name without an operand points to its enclosing form.")
						child_index.ltz
						(then (return (call source_node_failure (call missing_form_name_error name_mode) container))))
					(let name (nodes.get child_index))
					(if
						(:doc "Metadata before the name is misplaced at its own colon-prefixed head.")
						(call is_metadata_form (borrow-shared source) (borrow-shared nodes) name)
						(then (return (call source_node_failure 13u32
							(nodes.get name/first_child)))))
					(if
						(:doc "Other invalid names keep their original operand span.")
						(bool:not (call is_wove_name (borrow-shared source) name))
						(then (return (call source_node_failure (call invalid_form_name_error name_mode) name))))
					(set child_index name/next_sibling)
					(let second (call second_form_name (borrow-shared source) (borrow-shared nodes) name_mode child_index))
					(if
						(:doc "An indexed binder checks both names before its prefix.")
						second.not-ltz
						(then
							(let item (nodes.get second))
							(if
								(:doc "The indexed item name keeps its own source span.")
								(bool:not (call is_wove_name (borrow-shared source) item))
								(then (return (call source_node_failure (call invalid_form_name_error name_mode) item))))
							(set child_index item/next_sibling)))
					(if
						(:doc "A second name after pattern metadata leaves that metadata inside the opening.")
						(bool:and (name_mode.eq 6u32) (bool:and second.ltz child_index.not-ltz))
						(then
							(let first (nodes.get child_index))
							(let payload (call first_ordinary_child (borrow-shared source) (borrow-shared nodes) name))
							(if
								(:doc "Report the first interposed entry rather than the later name.")
								payload.not-ltz
								(then (return (call source_node_failure 13u32
									(nodes.get first/first_child)))))))))
			(while
				(:doc "Check siblings in source order from the start of the metadata prefix.")
				child_index.not-ltz
				(body
					(let child (nodes.get child_index))
					(let-mut entry (bool false))
					(if
						(:doc "Only a child form with a colon head is a metadata candidate.")
						(u32:eq child/kind 40u32)
						(then
							(let head (nodes.get child/first_child))
							(let start head/start)
							(let end head/end)
							(set entry (u8:eq (source.get start) 58u8))
							(let-mut identifier_start start)
							(if
								(:doc "Check the identifier spelling after an optional colon byte.")
								entry
								(then (set identifier_start start.inc)))
							(if
								(:doc "Report malformed heads at the bare tag's byte span.")
								(bool:not (bool:or (call is_identifier_head (borrow-shared source)
										identifier_start end entry.not)
									(bool:and (i32:not-ltz (call receiver_separator (borrow-shared source) start end))
										(call inside_function_body (borrow-shared source) (borrow-shared nodes)
											child_index))))
								(then (return (call source_node_failure 12u32 head))))
							(if
								(:doc "Retired wrappers and lists fail where their exact tags occur.")
								(bool:or
									(call is_meta_head (borrow-shared source) start end)
									(call is_with_meta_head (borrow-shared source) head))
								(then (return (call source_node_failure 14u32 head))))
							(if
								(:doc "Named forms also attach metadata between and after their operands.")
								(entry.and (bool:not (in_prefix.or interleaved)))
								(then (return (call source_node_failure 13u32 head))))))
					(set in_prefix entry)
					(set child_index child/next_sibling)))
			(return checked)))

	(fn check_source_metadata
		(:doc `Validate form heads and metadata attachment without changing the source tree.

		Declarations and binding patterns place their prefix after the bare names.
		Named forms attach metadata anywhere after their opening name slots.
		A C bridge places its prefix after its provider and quoted header.
		Other forms start their prefix after the tag. Preserve source order and
		the original spans of all names, metadata, and fields.`)
		(:expect
			(tests "stage-2/source_metadata.tsv")
			(issues "gh:wove-lang/wove:59" "gh:wove-lang/wove:184" "gh:wove-lang/wove:246"))
		(params (source (shared-array u8)) (checked FormCheck) (nodes (shared-array SourceNode)))
		(returns FormCheck)
		(body
			(if
				(:doc "Failed tree construction keeps its original diagnostic.")
				(u32:gtz checked/error)
				(then (return checked)))
			(let count (i32:from-u32 checked/rows))
			(let-mut index 0i32)
			(while
				(:doc "Each container owns a sibling list and checks its heads once.")
				(index.lt count)
				(body
					(let node (nodes.get index))
					(let kind node/kind)
					(if
						(:doc "The synthetic root and parenthesized forms are the only containers.")
						(bool:or kind.eqz (kind.eq 40u32))
						(then
							(let result (call check_metadata_children
									(borrow-shared source) (borrow-shared nodes)
									node checked))
							(if
								(:doc "Leave the rows intact and return the originating diagnostic.")
								(u32:gtz result/error)
								(then (return result)))))
					(set index index.inc)))
			(return checked)))

	(fn render_source_token
		(:doc `Append a whole raw token and its separator, or return -1 if both cannot fit.`)
		(params (source (shared-array u8)) (output (mut-array u8))
			(start i32) (end i32) (kind u32) (previous u32) (written i32))
		(returns i32)
		(body
			(let separator (bool:and
					(bool:not (bool:or previous.eqz (previous.eq 40u32)))
					(kind.not-eq 41u32)))
			(let width (end.sub start))
			(let room (i32:sub output.len written))
			(if
				(:doc "Compare with the remaining capacity before adding any offsets or writing a partial token.")
				(bool:or (room.lt width)
					(separator.and (room.eq width)))
				(then (return -1i32)))
			(let-mut cursor written)
			(if
				(:doc "A space separates adjacent tokens outside the tight edges of parentheses.")
				separator
				(then
					(output.set cursor 32u8)
					(set cursor cursor.inc)))
			(let-mut offset start)
			(while
				(:doc "Copy the original spelling byte for byte, including any escapes.")
				(offset.lt end)
				(body
					(output.set cursor (source.get offset))
					(set offset offset.inc)
					(set cursor cursor.inc)))
			(return cursor)))

	(fn render_source_tree
		(:doc `Render the validated tree by visiting its links against the original byte view.

		Choose layout between tokens and copy their complete raw spellings. If the output
		view is short, return the written prefix at a token boundary.`)
		(:expect
			(tests "stage-2/source_renderings.tsv")
			(issues "gh:wove-lang/wove:47"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (output (mut-array u8)))
		(returns RenderResult)
		(body
			(let root (nodes.get 0i32))
			(let-mut index root/first_child)
			(let-mut closing (bool false))
			(let-mut previous 0u32)
			(let-mut written 0i32)
			(while
				(:doc "Parent links schedule pending closers without recursion or a separate stack.")
				index.gtz
				(body
					(let node (nodes.get index))
					(let-mut kind node/kind)
					(let-mut start node/start)
					(let-mut end node/end)
					(if
						(:doc "A form contributes its opener before the children and its closer on the way back up.")
						closing
						(then
							(set kind 41u32)
							(set start end.dec))
						(else
							(if
								(:doc "On entry, emit just the opener instead of copying the full form span.")
								(kind.eq 40u32)
								(then (set end start.inc)))))
					(let next (call render_source_token (borrow-shared source) (borrow-mut output)
							start end kind previous written))
					(if
						(:doc "Keep the completed prefix and leave the remaining output bytes alone on capacity failure.")
						next.ltz
						(then (return (struct:new RenderResult (written written) (error 16u32)))))
					(set written next)
					(set previous kind)
					(if
						(:doc "Every validated form has a child. Other tokens proceed to a sibling or close their parent.")
						(kind.eq 40u32)
						(then (set index node/first_child))
						(else
							(let sibling node/next_sibling)
							(set closing sibling.ltz)
							(if
								(:doc "The synthetic source root has no closer, so returning to index zero ends the walk.")
								closing
								(then (set index node/parent))
								(else (set index sibling)))))))
			(return (struct:new RenderResult (written written) (error 0u32)))))
	(fn semantic_tree_rows
		(:doc "Include the compiler-only nodes for receiver operations and field projections.")
		(params (checked FormCheck)) (returns u32)
		(body (return (u32:add checked/rows checked/receiver_rows))))

	(fn build_semantic_tree
		(:doc "Keep original spans and materialize receiver operations and field paths in compiler trees.")
		(params (source (shared-array u8)) (checked FormCheck) (nodes (mut-array SourceNode)))
		(returns FormCheck)
		(body (return (call build_tree (borrow-shared source) checked (borrow-mut nodes)
			(u32:gtz checked/receiver_rows)))))

	(fn place_method_receiver
		(:doc "Insert the reserved receiver after any metadata and before the written operands.")
		(params (source (shared-array u8)) (nodes (mut-array SourceNode)) (form SourceNode))
		(returns void)
		(body
			(let head form/first_child)
			(let tag (struct:get (nodes.get head) kind))
			(if
				(:doc "Only a method head reserved an implicit receiver at the next physical row.")
				(tag.not-eq receiver_call_head)
				(then (return)))
			(let receiver head.inc)
			(let-mut previous head)
			(let-mut operand (struct:get (nodes.get head) next_sibling))
			(while
				(:doc "Give the original metadata prefix the same position relative to the operands.")
				(bool:and operand.not-ltz
					(call is_metadata_form (borrow-shared source) (borrow-shared nodes) (nodes.get operand)))
				(body
					(set previous operand)
					(set operand (struct:get (nodes.get operand) next_sibling))))
			(let link (nodes.get previous))
			(nodes.set previous
				(call revise_source_node link link/end link/first_child receiver))
			(let value (nodes.get receiver))
			(nodes.set receiver (call revise_source_node value value/end value/first_child operand))))

	(fn write_field_path
		(:doc "Write a detached canonical projection or binding and retain each segment's exact span.")
		(params (source (shared-array u8)) (nodes (mut-array SourceNode)) (parent i32)
			(index i32) (start i32) (end i32) (segments u32))
		(returns i32)
		(body
			(let-mut node index)
			(let-mut field (index.add (i32:from-u32 (segments.mul 3u32))))
			(let limit field.inc)
			(let-mut field_end end)
			(let-mut container parent)
			(let-mut sibling -1i32)
			(while
				(:doc "Start with the last field as the outermost form. Heads grow forward while field operands fill from the end.")
				(node.lt field)
				(body
					(let separator (call preceding_field_separator (borrow-shared source) field_end))
					(let field_start separator.inc)
					(let head node.inc)
					(let receiver head.inc)
					(let form (call new_source_node 40u32 start field_end container))
					(let projection (call revise_source_node form field_end head sibling))
					(nodes.set node projection)
					(let tag (call new_source_node field_path_get_head field_start field_end node))
					(nodes.set head (call revise_source_node tag field_end -1i32 receiver))
					(nodes.set field (call new_source_node 1u32 field_start field_end node))
					(set container node)
					(set node receiver)
					(set sibling field)
					(set field field.dec)
					(set field_end separator)))
			(let binding (call new_source_node 1u32 start field_end container))
			(nodes.set node (call revise_source_node binding field_end -1i32 sibling))
			(return limit)))

	(fn append_bare_receiver
		(:doc "Attach a synthetic operation and its complete receiver at the original token.")
		(params (source (shared-array u8)) (nodes (mut-array SourceNode)) (parent i32)
			(index i32) (start i32) (end i32) (separator i32) (segments u32))
		(returns i32)
		(body
			(call append_source_child (borrow-mut nodes) parent index
				(call new_source_node 40u32 start -1i32 parent))
			(call append_source_child (borrow-mut nodes) index index.inc
				(call new_source_node receiver_call_head start end index))
			(let receiver (index.add 2i32))
			(let next (call write_field_path (borrow-shared source) (borrow-mut nodes)
				index receiver start separator segments))
			(let value (nodes.get receiver))
			(call append_source_child (borrow-mut nodes) index receiver value)
			(let form (nodes.get index))
			(call seal_source_node (borrow-mut nodes) index form end)
			(return next)))

	(fn build_tree
		(:doc "Build raw source rows or insert compiler-only receiver operands in the same preorder table.")
		(params (source (shared-array u8)) (checked FormCheck) (nodes (mut-array SourceNode)) (normalize bool))
		(returns FormCheck)
		(body
			(if
				(:doc "Leave storage alone when the same view failed its form check.")
				(u32:gtz checked/error)
				(then (return checked)))
			(let-mut needed checked/rows)
			(if
				(:doc "Only the semantic tree includes the extra receiver rows.")
				normalize
				(then (set needed (call semantic_tree_rows checked))))
			(if
				(:doc "Check the full capacity before publishing any rows.")
				(u32:lt (u32:from-i32 nodes.len) needed)
				(then (return (call form_failure 11u32 checked/start checked/end))))
			(let length source.len)
			(nodes.set 0i32 (call new_source_node 0u32 0i32 -1i32 -1i32))
			(let-mut cursor 0i32)
			(let-mut parent 0i32)
			(let-mut index 1i32)
			(let-mut metadata -1i32)
			(let-mut body -1i32)
			(while
				(:doc "Track the parent and opaque metadata while materializing the admitted token stream.")
				(cursor.lt length)
				(body
					(let token (call scan_token (borrow-shared source) cursor))
					(let kind token/kind)
					(let start token/start)
					(let end token/end)
					(set cursor end)
					(if
						(:doc "A closer splices any method operand and finalizes the original span.")
						(kind.eq 41u32)
						(then
							(let open (nodes.get parent))
							(if
								(:doc "Only the compiler tree can carry an implicit child.")
								normalize
								(then (call place_method_receiver (borrow-shared source) (borrow-mut nodes) open)))
							(if (metadata.eq parent) (then (set metadata -1i32)))
							(if (body.eq parent) (then (set body -1i32)))
							(call seal_source_node (borrow-mut nodes) parent open end)
							(set parent open/parent))
						(else
							(if
								(:doc "An opener or atom contributes its own source node.")
								kind.gtz
								(then
									(let container (nodes.get parent))
									(let head (i32:ltz container/first_child))
									(let-mut separator -1i32)
									(let-mut segments 0u32)
									(if
										(:doc "Keep every atom inside a leading-colon entry in raw form.")
										(normalize.and (bool:and metadata.ltz (kind.eq 1u32)))
										(then
											(if
												(:doc "Record the container until its matching closer.")
												(head.and (u8:eq (source.get start) 58u8))
												(then (set metadata parent))
												(else
													(if
														(:doc "Enter the body at its original head. Only its children can be operations.")
														body.ltz
														(then
															(if
																(:doc "Keep the outer body row until its matching closer.")
																(head.and (call same_bytes (borrow-shared source) start end
																	(borrow-shared body_head) 0i32 4i32))
																(then (set body parent))))
														(else
															(set separator (call receiver_separator (borrow-shared source) start end))
															(if
																(:doc "Count the path up to the dot, or the whole token for a plain field operand.")
													separator.not-ltz
													(then (set segments (call field_path_segments (borrow-shared source) start separator)))
													(else
														(if head.not
															(then (set segments (call field_path_segments (borrow-shared source) start end))))))))))))
								(if
									(:doc "Attach a plain field operand as one canonical subtree.")
									(bool:and separator.ltz segments.gtz)
									(then
										(let next (call write_field_path (borrow-shared source) (borrow-mut nodes)
											parent index start end segments))
										(let projection (nodes.get index))
										(call append_source_child (borrow-mut nodes) parent index projection)
										(set index next)
										(continue)))
								(if
									(:doc "A bare operation supplies a form, head, and receiver at its original location.")
									(bool:and head.not separator.not-ltz)
									(then
										(set index (call append_bare_receiver (borrow-shared source) (borrow-mut nodes)
											parent index start end separator segments)))
									(else
											(let opened (kind.eq 40u32))
											(let-mut node_end end)
											(let-mut node_kind kind)
											(if opened (then (set node_end -1i32)))
											(if
												(:doc "A method head keeps its original span and reserves a detached receiver subtree.")
												separator.not-ltz
												(then (set node_kind receiver_call_head)))
											(call append_source_child (borrow-mut nodes) parent index
												(call new_source_node node_kind start node_end parent))
											(if opened (then (set parent index)))
											(set index index.inc)
											(if
												(:doc "Write the receiver now and splice it into operand order at the closer.")
												(node_kind.eq receiver_call_head)
												(then (set index (call write_field_path (borrow-shared source)
													(borrow-mut nodes) parent index start separator segments))))))))))))
			(let root (nodes.get 0i32))
			(call seal_source_node (borrow-mut nodes) 0i32 root length)
			(if normalize.not (then (return checked)))
			(return (struct:new FormCheck (rows needed) (start checked/start)
				(end checked/end) (error 0u32) (receiver_rows 0u32)))))
)
