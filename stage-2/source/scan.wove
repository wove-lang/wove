(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read and render serialized Wove source through borrowed byte views.

	Admission validates UTF-8 before tokenization. The tree retains source-relative byte
	spans and links for forms, atoms, and metadata. Rendering uses those links to copy
	the original token spellings into caller-provided storage.`)
	source_scan

	(use wove-file "../text/utf8.wove" (only utf8_invalid_offset valid_utf8_width))

	(struct Token (fields (kind u32) (start i32) (end i32) (error u32)))
	(struct SourceDiagnostic (fields (error u32) (start i32) (end i32)))
	(struct SourcePosition (fields (line u32) (column u32)))
	(struct FormCheck (fields (rows u32) (start i32) (end i32) (error u32)))
	(struct SourceNode
		(fields (kind u32) (start i32) (end i32) (parent i32) (first_child i32) (next_sibling i32)))
	(struct RenderResult (fields (written i32) (error u32)))

	(fn
		(:doc `Match the seed's ASCII separators, U+0009–U+000D and U+001C–U+0020.`)
		(:pragma (inline always))
		is_ascii_whitespace
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Test the two half-open ranges directly in the raw bytes.")
				(bool.or
					(bool.and (bool.not (u8.lt (local byte) (u8 9))) (u8.lt (local byte) (u8 14)))
					(bool.and (bool.not (u8.lt (local byte) (u8 28))) (u8.lt (local byte) (u8 33)))))))

	(fn
		(:doc `Parentheses are both atom boundaries and one-byte tokens.`)
		(:pragma (inline always))
		is_parenthesis
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 40)) (u8.eq (local byte) (u8 41))))))

	(fn
		(:doc `Stop an atom before a semicolon, a double quote, or a backtick.`)
		(:pragma (inline always))
		is_semicolon_or_quote
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 59))
					(bool.or (u8.eq (local byte) (u8 34)) (u8.eq (local byte) (u8 96)))))))

	(fn
		(:doc `Resume at the supplied cursor and leave the first non-whitespace byte unconsumed.`)
		skip_whitespace
		(params (source (shared-slice u8)) (start i32))
		(returns i32)
		(body
			(let end (slice.len (local source)))
			(let-mut cursor (local start))
			(while
				(:doc "The end cursor needs no byte load.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(let width (call whitespace_width (borrow-shared (local source)) (local cursor) (local byte)))
					(if
						(:doc "Preserve the offset of the first byte that can start a token.")
						(i32.eq (local width) (i32 0))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (local width)))))
			(return (local cursor))))

	(fn
		(:doc `Find the first significant byte or the end of this view.`)
		source_offset
		(params (source (shared-slice u8)))
		(returns i32)
		(body
			(return (call skip_whitespace (borrow-shared (local source)) (i32 0)))))

	(fn
		(:doc `Classify the first significant byte for callers that only need its original byte kind.`)
		(:expect bootstrap.scan_source_byte
			(issue "https://github.com/wove-lang/wove/issues/13"))
		source_kind
		(params (source (shared-slice u8)))
		(returns u32)
		(body
			(let offset (call source_offset (borrow-shared (local source))))
			(if
				(:doc "Return the EOF kind before another load can reach the end of the view.")
				(i32.eq (local offset) (slice.len (local source)))
				(then (return (u32 0))))
			(let byte (slice.load (local source) (local offset)))
			(if
				(:doc "Preserve either parenthesis byte code as the kind.")
				(call is_parenthesis (local byte))
				(then (return (int.convert u32 (local byte)))))
			(return (u32 1))))

	(fn
		(:doc `Find the exclusive end of an atom whose first byte has already been accepted.`)
		bare_atom_end
		(params (source (shared-slice u8)) (next i32))
		(returns i32)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (local next))
			(while
				(:doc "The view can end immediately after the last atom byte.")
				(i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(if
						(:doc "Stop before the first byte of any separator or token delimiter.")
						(bool.or
							(bool.or
								(call is_parenthesis (local byte))
								(call is_semicolon_or_quote (local byte)))
							(i32.lt (i32 0)
								(call whitespace_width (borrow-shared (local source)) (local cursor) (local byte))))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (local cursor))))

	(fn
		(:doc `Recognize physical CR and LF bytes when counting source lines.`)
		(:pragma (inline always))
		is_line_ending
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 13)) (u8.eq (local byte) (u8 10))))))

	(fn
		(:doc `Recognize the JSON short escapes after their opening backslash.`)
		(:pragma (inline always))
		is_short_escape
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Accept escaped punctuation and the five named control characters.")
				(bool.or
					(bool.or
						(u8.eq (local byte) (u8 34))
						(bool.or (u8.eq (local byte) (u8 92)) (u8.eq (local byte) (u8 47))))
					(bool.or
						(bool.or (u8.eq (local byte) (u8 98)) (u8.eq (local byte) (u8 102)))
						(bool.or
							(u8.eq (local byte) (u8 110))
							(bool.or (u8.eq (local byte) (u8 114)) (u8.eq (local byte) (u8 116)))))))))

	(fn
		(:doc `Accept ASCII digits and both cases of A through F in Unicode escapes.`)
		(:pragma (inline always))
		is_hex_digit
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Use half-open byte ranges for decimal, uppercase, and lowercase digits.")
				(bool.or
					(bool.and (bool.not (u8.lt (local byte) (u8 48))) (u8.lt (local byte) (u8 58)))
					(bool.or
						(bool.and (bool.not (u8.lt (local byte) (u8 65))) (u8.lt (local byte) (u8 71)))
						(bool.and (bool.not (u8.lt (local byte) (u8 97))) (u8.lt (local byte) (u8 103))))))))

	(fn
		(:doc `Keep the raw extent of a lexical error for the caller.`)
		lexical_error
		(params (code u32) (start i32) (end i32))
		(returns Token)
		(body
			(return (record.make Token
					(kind (u32 3)) (error (local code)) (start (local start)) (end (local end))))))

	(fn
		(:doc `Validate quoted bytes while preserving the full spelling for the parser.`)
		scan_quoted
		(params (source (shared-slice u8)) (start i32))
		(returns Token)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (i32.add.wrapping (local start) (i32 1)))
			(while
				(:doc "Read only bytes inside the supplied view, including while scanning escapes.")
				(i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
					(if
						(:doc "An unescaped quote completes the span just after the closing byte.")
						(u8.eq (local byte) (u8 34))
						(then
							(return (record.make Token (kind (u32 2)) (error (u32 0)) (start (local start)) (end (local cursor))))))
					(if
						(:doc "Raw ASCII control bytes end the error span just after the offending byte.")
						(u8.lt (local byte) (u8 32))
						(then (return (call lexical_error (u32 4) (local start) (local cursor)))))
					(if
						(:doc "A backslash consumes its escape bytes before the next quote check.")
						(u8.eq (local byte) (u8 92))
						(then
							(if
								(:doc "A trailing backslash reaches the view end without an escape byte.")
								(i32.eq (local cursor) (local length))
								(then (return (call lexical_error (u32 3) (local start) (local length)))))
							(let escape (slice.load (local source) (local cursor)))
							(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
							(if
								(:doc "A Unicode escape must supply exactly four hex digits.")
								(u8.eq (local escape) (u8 117))
								(then
									(let-mut digits (i32 0))
									(while
										(:doc "Check each digit before advancing to the next byte.")
										(i32.lt (local digits) (i32 4))
										(body
											(if
												(:doc "A clipped escape reports the view end.")
												(i32.eq (local cursor) (local length))
												(then (return (call lexical_error (u32 3) (local start) (local length)))))
											(let digit (slice.load (local source) (local cursor)))
											(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
											(if
												(:doc "Include the first invalid digit in the error span.")
												(bool.not (call is_hex_digit (local digit)))
												(then (return (call lexical_error (u32 3) (local start) (local cursor)))))
											(set (local digits) (i32.add.wrapping (local digits) (i32 1))))))
								(else
									(if
										(:doc "Every other escape must belong to the short escape set.")
										(bool.not (call is_short_escape (local escape)))
										(then (return (call lexical_error (u32 3) (local start) (local cursor)))))))))))
			(return (call lexical_error (u32 2) (local start) (local length)))))

	(fn
		(:doc `Find the closing delimiter of a raw string in an admitted byte view.`)
		(:expect lexer.raw_string
			(issue "https://github.com/wove-lang/wove/issues/53"))
		scan_raw_string
		(params (source (shared-slice u8)) (start i32))
		(returns Token)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (i32.add.wrapping (local start) (i32 1)))
			(while
				(:doc "Advance from the opening delimiter without stepping outside the view.")
				(i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
					(if
						(:doc "Only a backtick can end the string.")
						(u8.eq (local byte) (u8 96))
						(then
							(if
								(:doc "Consume a doubled backtick only when both bytes are in the view.")
								(bool.and (i32.lt (local cursor) (local length))
									(u8.eq (slice.load (local source) (local cursor)) (u8 96)))
								(then (set (local cursor) (i32.add.wrapping (local cursor) (i32 1))))
								(else
									(return (record.make Token
											(kind (u32 2)) (error (u32 0)) (start (local start)) (end (local cursor))))))))))
			(return (call lexical_error (u32 2) (local start) (local length)))))

	(fn
		(:doc `Scan one token in a view already checked by ``admit_source``.

		Start at a view-relative byte cursor and advance by the resulting exclusive end.
		Both string delimiters produce kind 2. Use the opening byte to tell the two
		spellings apart and keep all literal bytes in the span.`)
		(:expect lexer.token_span
			(issue "https://github.com/wove-lang/wove/issues/29"))
		(:expect lexer.quoted_string
			(issue "https://github.com/wove-lang/wove/issues/31"))
		(:expect lexer.unicode_whitespace
			(issue "https://github.com/wove-lang/wove/issues/33"))
		(:expect lexer.stream_parity
			(issue "https://github.com/wove-lang/wove/issues/34"))
		scan_token
		(params (source (shared-slice u8)) (cursor i32))
		(returns Token)
		(body
			(let start (call skip_whitespace (borrow-shared (local source)) (local cursor)))
			(let length (slice.len (local source)))
			(if
				(:doc "Only the exact end cursor can return EOF without another checked load.")
				(i32.eq (local start) (local length))
				(then
					(return (record.make Token (kind (u32 0)) (error (u32 0)) (start (local start)) (end (local start))))))
			(let byte (slice.load (local source) (local start)))
			(let next (i32.add.wrapping (local start) (i32 1)))
			(if
				(:doc "Parentheses consume one byte and use their byte code as the token kind.")
				(call is_parenthesis (local byte))
				(then
					(return (record.make Token
							(kind (int.convert u32 (local byte)))
							(error (u32 0))
							(start (local start))
							(end (local next))))))
			(if
				(:doc "The opening quote selects the string scanner before interpreting any content.")
				(u8.eq (local byte) (u8 34))
				(then (return (call scan_quoted (borrow-shared (local source)) (local start)))))
			(if
				(:doc "The backtick scanner keeps all literal bytes in the token span.")
				(u8.eq (local byte) (u8 96))
				(then (return (call scan_raw_string (borrow-shared (local source)) (local start)))))
			(if
				(:doc "An unquoted semicolon is an unexpected delimiter.")
				(u8.eq (local byte) (u8 59))
				(then (return (call lexical_error (u32 1) (local start) (local next)))))
			(let end (call bare_atom_end (borrow-shared (local source)) (local next)))
			(return (record.make Token (kind (u32 1)) (error (u32 0)) (start (local start)) (end (local end))))))

	(fn
		(:doc `Admit the entire byte view once before tokenization.

		Return -1 for valid UTF-8 or the view-relative byte offset of the first
		malformed sequence. The caller keeps the original bytes for scanning and diagnostics.`)
		(:expect lexer.utf8_admission
			(issue "https://github.com/wove-lang/wove/issues/32"))
		admit_source
		(params (source (shared-slice u8)))
		(returns i32)
		(body (return (call utf8_invalid_offset (borrow-shared (local source))))))

	(fn
		(:doc `Return the byte width of a seed separator at the cursor, or zero.`)
		whitespace_width
		(params (source (shared-slice u8)) (cursor i32) (lead u8))
		(returns i32)
		(body
			(if
				(:doc "ASCII uses the seed's two contiguous separator ranges.")
				(u8.lt (local lead) (u8 128))
				(then
					(if
						(:doc "Return a single-byte width for either ASCII range.")
						(call is_ascii_whitespace (local lead))
						(then (return (i32 1))))
					(return (i32 0))))
			(let remaining (i32.sub.wrapping (slice.len (local source)) (local cursor)))
			(if
				(:doc "U+0085 and U+00A0 are the only two-byte separators.")
				(u8.eq (local lead) (u8 194))
				(then
					(if
						(:doc "Keep the second-byte load inside this view.")
						(i32.lt (local remaining) (i32 2))
						(then (return (i32 0))))
					(let second (slice.load (local source) (i32.add.wrapping (local cursor) (i32 1))))
					(if
						(:doc "The C2 prefix has two accepted suffixes.")
						(bool.or (u8.eq (local second) (u8 133)) (u8.eq (local second) (u8 160)))
						(then (return (i32 2))))
					(return (i32 0))))
			(if
				(:doc "Three-byte separators start with E1, E2, or E3 and need both suffix bytes.")
				(bool.or
					(i32.lt (local remaining) (i32 3))
					(bool.or (u8.lt (local lead) (u8 225)) (u8.lt (u8 227) (local lead))))
				(then (return (i32 0))))
			(let second (slice.load (local source) (i32.add.wrapping (local cursor) (i32 1))))
			(let third (slice.load (local source) (i32.add.wrapping (local cursor) (i32 2))))
			(if
				(:doc "E1 9A 80 is U+1680.")
				(u8.eq (local lead) (u8 225))
				(then
					(if
						(:doc "U+1680 occupies all three bytes.")
						(bool.and (u8.eq (local second) (u8 154)) (u8.eq (local third) (u8 128)))
						(then (return (i32 3))))
					(return (i32 0))))
			(if
				(:doc "E3 80 80 is U+3000.")
				(u8.eq (local lead) (u8 227))
				(then
					(if
						(:doc "The E3 prefix has one accepted suffix.")
						(bool.and (u8.eq (local second) (u8 128)) (u8.eq (local third) (u8 128)))
						(then (return (i32 3))))
					(return (i32 0))))
			(if
				(:doc "E2 81 9F is U+205F.")
				(bool.and (u8.eq (local second) (u8 129)) (u8.eq (local third) (u8 159)))
				(then (return (i32 3))))
			(if
				(:doc "E2 80 covers U+2000 through U+200A, U+2028, U+2029, and U+202F.")
				(bool.and
					(u8.eq (local second) (u8 128))
					(bool.or
						(bool.and (bool.not (u8.lt (local third) (u8 128))) (u8.lt (local third) (u8 139)))
						(bool.or
							(bool.or (u8.eq (local third) (u8 168)) (u8.eq (local third) (u8 169)))
							(u8.eq (local third) (u8 175)))))
				(then (return (i32 3))))
			(return (i32 0))))

	(fn
		(:doc `Expose admission failures in the same diagnostic code space as lexical errors.`)
		source_diagnostic
		(params (source (shared-slice u8)))
		(returns SourceDiagnostic)
		(body
			(let start (call admit_source (borrow-shared (local source))))
			(if
				(:doc "Successful admission carries no primary span.")
				(i32.lt (local start) (i32 0))
				(then
					(return (record.make SourceDiagnostic (error (u32 0)) (start (i32 0)) (end (i32 0))))))
			(let
				(:doc "Anchor malformed UTF-8 at its lead byte, even when the sequence is clipped.")
				end (i32.add.wrapping (local start) (i32 1)))
			(return (record.make SourceDiagnostic (error (u32 5)) (start (local start)) (end (local end))))))

	(fn
		(:doc `Map a view-relative span start to its coordinates in the parent source.`)
		source_position
		(params (parent (shared-slice u8)) (view_start i32) (span_start i32))
		(returns SourcePosition)
		(body
			(let target (i32.add.wrapping (local view_start) (local span_start)))
			(let-mut cursor (i32 0))
			(let-mut line (u32 1))
			(let-mut column (u32 1))
			(let-mut previous_cr (bool false))
			(while
				(:doc "Only bytes before the requested start can advance its coordinates.")
				(i32.lt (local cursor) (local target))
				(body
					(let byte (slice.load (local parent) (local cursor)))
					(if
						(:doc "Count each physical line break once, including a CRLF pair.")
						(call is_line_ending (local byte))
						(then
							(if
								(:doc "An LF paired with the previous CR continues the same break.")
								(bool.or (u8.eq (local byte) (u8 13)) (bool.not (local previous_cr)))
								(then (set (local line) (u32.add.wrapping (local line) (u32 1)))))
							(set (local column) (u32 1))
							(set (local cursor) (i32.add.wrapping (local cursor) (i32 1))))
						(else
							(let-mut width (call valid_utf8_width (borrow-shared (local parent)) (local cursor) (local byte)))
							(if
								(:doc "Count malformed bytes individually to preserve subsequent line breaks.")
								(i32.eq (local width) (i32 0))
								(then (set (local width) (i32 1))))
							(let remaining (i32.sub.wrapping (local target) (local cursor)))
							(if
								(:doc "An offset inside a scalar still belongs to that scalar's column.")
								(i32.lt (local remaining) (local width))
								(then (set (local cursor) (local target)))
								(else
									(set (local column) (u32.add.wrapping (local column) (u32 1)))
									(set (local cursor) (i32.add.wrapping (local cursor) (local width)))))))
					(set (local previous_cr) (u8.eq (local byte) (u8 13)))))
			(return (record.make SourcePosition (line (local line)) (column (local column))))))

	(fn
		(:doc `Carry the first failure's original span back through the form check.`)
		form_failure
		(params (error u32) (start i32) (end i32))
		(returns FormCheck)
		(body
			(return (record.make FormCheck
					(rows (u32 0)) (start (local start)) (end (local end)) (error (local error))))))

	(fn
		(:doc `Locate the last opener at the final depth of a stream that reached EOF.`)
		unclosed_form_start
		(params (source (shared-slice u8)) (final_depth i32))
		(returns i32)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (i32 0))
			(let-mut depth (i32 0))
			(let-mut opener (i32 0))
			(while
				(:doc "Rescan only after the first pass proves the tokens reach EOF.")
				(i32.lt (local cursor) (local length))
				(body
					(let token (call scan_token (borrow-shared (local source)) (local cursor)))
					(let kind (record.get (local token) kind))
					(set (local cursor) (record.get (local token) end))
					(if
						(:doc "The innermost unclosed form is the final opener at final_depth.")
						(u32.eq (local kind) (u32 40))
						(then
							(set (local depth) (i32.add.wrapping (local depth) (i32 1)))
							(if
								(:doc "Replace a candidate that may already have closed.")
								(i32.eq (local depth) (local final_depth))
								(then (set (local opener) (record.get (local token) start))))))
					(if
						(:doc "Close the innermost form before classifying the next token.")
						(u32.eq (local kind) (u32 41))
						(then (set (local depth) (i32.sub.wrapping (local depth) (i32 1)))))))
			(return (local opener))))

	(fn
		(:doc `Validate one tagged root and count the rows needed to build its tree.

		Admission and lexer failures take precedence when encountered. Count a synthetic
		source root and one row per opener or atom. A closer contributes to its form span.`)
		(:expect parser.source_form
			(issue "https://github.com/wove-lang/wove/issues/43"))
		check_source_form
		(params (source (shared-slice u8)))
		(returns FormCheck)
		(body
			(let admission (call source_diagnostic (borrow-shared (local source))))
			(let admission_error (record.get (local admission) error))
			(if
				(:doc "Admission failures take precedence over any form structure.")
				(u32.lt (u32 0) (local admission_error))
				(then
					(return (call form_failure (local admission_error)
							(record.get (local admission) start) (record.get (local admission) end)))))
			(let length (slice.len (local source)))
			(let-mut cursor (i32 0))
			(let-mut rows (u32 1))
			(let-mut depth (i32 0))
			(let-mut root_start (i32 -1))
			(let-mut root_end (i32 0))
			(let-mut needs_tag (bool false))
			(while
				(:doc "Advance by raw token ends and keep only the state of the open forms.")
				(i32.lt (local cursor) (local length))
				(body
					(let token (call scan_token (borrow-shared (local source)) (local cursor)))
					(let kind (record.get (local token) kind))
					(let start (record.get (local token) start))
					(let end (record.get (local token) end))
					(let error (record.get (local token) error))
					(set (local cursor) (local end))
					(if
						(:doc "Keep the lexer's original error code and byte span.")
						(u32.lt (u32 0) (local error))
						(then (return (call form_failure (local error) (local start) (local end)))))
					(if
						(:doc "Each opener, bare atom, and quoted atom occupies a row.")
						(bool.not (bool.or (u32.eq (local kind) (u32 0)) (u32.eq (local kind) (u32 41))))
						(then (set (local rows) (u32.add.wrapping (local rows) (u32 1)))))
					(if
						(:doc "The end marker leaves the structural state unchanged.")
						(bool.not (u32.eq (local kind) (u32 0)))
						(then
							(if
								(:doc "The first significant token after an opener must be a bare tag.")
								(bool.and (local needs_tag) (bool.not (u32.eq (local kind) (u32 1))))
								(then (return (call form_failure (u32 7) (local start) (local end)))))
							(set (local needs_tag) (u32.eq (local kind) (u32 40)))
							(if
								(:doc "At depth zero, a significant token must start the only root.")
								(i32.eq (local depth) (i32 0))
								(then
									(if
										(:doc "A closer at depth zero has no matching opener.")
										(u32.eq (local kind) (u32 41))
										(then (return (call form_failure (u32 8) (local start) (local end)))))
									(if
										(:doc "A completed root allows only trailing trivia.")
										(bool.not (i32.lt (local root_start) (i32 0)))
										(then (return (call form_failure (u32 10) (local start) (local end)))))
									(if
										(:doc "A bare or quoted atom cannot serve as the root.")
										(bool.not (local needs_tag))
										(then (return (call form_failure (u32 6) (local start) (local end)))))
									(set (local root_start) (local start))))
							(if
								(:doc "A closer completes its form and may finish the root span.")
								(u32.eq (local kind) (u32 41))
								(then
									(set (local depth) (i32.sub.wrapping (local depth) (i32 1)))
									(if
										(:doc "Preserve the exclusive end of the actual root.")
										(i32.eq (local depth) (i32 0))
										(then (set (local root_end) (local end))))))
							(if
								(:doc "Only an opener increases depth.")
								(local needs_tag)
								(then (set (local depth) (i32.add.wrapping (local depth) (i32 1)))))))))
			(if
				(:doc "Prefer the innermost unmatched opener as the primary EOF span.")
				(i32.lt (i32 0) (local depth))
				(then
					(let opener (call unclosed_form_start (borrow-shared (local source)) (local depth)))
					(return (call form_failure (u32 9) (local opener) (i32.add.wrapping (local opener) (i32 1))))))
			(if
				(:doc "Empty or whitespace-only input anchors the missing root at EOF.")
				(i32.lt (local root_start) (i32 0))
				(then (return (call form_failure (u32 6) (local length) (local length)))))
			(return (record.make FormCheck
					(rows (local rows)) (start (local root_start)) (end (local root_end)) (error (u32 0))))))

	(fn
		(:doc `Initialize a row with its parent and empty child and sibling links.`)
		new_source_node
		(params (kind u32) (start i32) (end i32) (parent i32))
		(returns SourceNode)
		(body
			(return (record.make SourceNode
					(kind (local kind)) (start (local start)) (end (local end)) (parent (local parent))
					(first_child (i32 -1)) (next_sibling (i32 -1))))))

	(fn
		(:doc `Replace a row's end and outgoing links while keeping its identity and parent.`)
		revise_source_node
		(params (node SourceNode) (end i32) (first_child i32) (next_sibling i32))
		(returns SourceNode)
		(body
			(return (record.make SourceNode
					(kind (record.get (local node) kind))
					(start (record.get (local node) start))
					(end (local end))
					(parent (record.get (local node) parent))
					(first_child (local first_child))
					(next_sibling (local next_sibling))))))

	(fn
		(:doc `Append a child in source order using the open parent's end field to track its last child.`)
		append_source_child
		(params (nodes (mut-slice SourceNode)) (parent i32) (index i32) (child SourceNode))
		(returns void)
		(body
			(let container (slice.load (local nodes) (local parent)))
			(let tail (record.get (local container) end))
			(let-mut first (record.get (local container) first_child))
			(if
				(:doc "A first child sets the container entry point; later children extend the sibling chain.")
				(i32.lt (local tail) (i32 0))
				(then (set (local first) (local index)))
				(else
					(let sibling (slice.load (local nodes) (local tail)))
					(slice.store (local nodes) (local tail)
						(call revise_source_node (local sibling)
							(record.get (local sibling) end)
							(record.get (local sibling) first_child)
							(local index)))))
			(slice.store (local nodes) (local parent)
				(call revise_source_node (local container) (local index) (local first)
					(record.get (local container) next_sibling)))
			(slice.store (local nodes) (local index) (local child))))

	(fn
		(:doc `Finalize the byte span once an open container has received all of its children.`)
		seal_source_node
		(params (nodes (mut-slice SourceNode)) (index i32) (node SourceNode) (end i32))
		(returns void)
		(body
			(slice.store (local nodes) (local index)
				(call revise_source_node (local node) (local end)
					(record.get (local node) first_child)
					(record.get (local node) next_sibling)))))

	(fn
		(:doc `Build the checked view as a source-ordered tree in caller-provided record storage.

		Check the row capacity before writing. Parent links track open forms, so deeply
		nested input needs no recursive walk or separate stack.`)
		(:expect parser.flat_source_tree
			(issue "https://github.com/wove-lang/wove/issues/45"))
		build_source_tree
		(params (source (shared-slice u8)) (checked FormCheck) (nodes (mut-slice SourceNode)))
		(returns FormCheck)
		(body
			(if
				(:doc "Leave storage alone when the same view failed its form check.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (local checked))))
			(let capacity (int.convert u32 (slice.len (local nodes))))
			(if
				(:doc "The row count from admission guarantees room for every write below.")
				(u32.lt (local capacity) (record.get (local checked) rows))
				(then
					(return (call form_failure (u32 11)
							(record.get (local checked) start) (record.get (local checked) end)))))
			(let length (slice.len (local source)))
			(slice.store (local nodes) (i32 0) (call new_source_node (u32 0) (i32 0) (i32 -1) (i32 -1)))
			(let-mut cursor (i32 0))
			(let-mut parent (i32 0))
			(let-mut next_index (i32 1))
			(while
				(:doc "An open form's parent link acts as the stack for the admitted token stream.")
				(i32.lt (local cursor) (local length))
				(body
					(let token (call scan_token (borrow-shared (local source)) (local cursor)))
					(let kind (record.get (local token) kind))
					(let end (record.get (local token) end))
					(set (local cursor) (local end))
					(if
						(:doc "The closer seals its form rather than occupying its own row.")
						(u32.eq (local kind) (u32 41))
						(then
							(let open_node (slice.load (local nodes) (local parent)))
							(call seal_source_node (borrow-mut (local nodes)) (local parent) (local open_node) (local end))
							(set (local parent) (record.get (local open_node) parent))))
					(if
						(:doc "Each opener or atom appends one child row.")
						(bool.not (bool.or (u32.eq (local kind) (u32 0)) (u32.eq (local kind) (u32 41))))
						(then
							(let is_form (u32.eq (local kind) (u32 40)))
							(let-mut node_end (local end))
							(if
								(:doc "An open form starts with no last child until a token is appended.")
								(local is_form)
								(then (set (local node_end) (i32 -1))))
							(let child (call new_source_node (local kind) (record.get (local token) start)
									(local node_end) (local parent)))
							(call append_source_child (borrow-mut (local nodes)) (local parent) (local next_index) (local child))
							(if
								(:doc "Subsequent tokens belong to the new form until its closer.")
								(local is_form)
								(then (set (local parent) (local next_index))))
							(set (local next_index) (i32.add.wrapping (local next_index) (i32 1)))))))
			(let root (slice.load (local nodes) (i32 0)))
			(call seal_source_node (borrow-mut (local nodes)) (i32 0) (local root) (local length))
			(return (local checked))))

	(fn
		(:doc `Recognize the ASCII letter or underscore that begins an identifier head.`)
		(:pragma (inline always))
		is_head_start_byte
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Match the seed's uppercase and lowercase letter ranges.")
				(bool.or
					(u8.eq (local byte) (u8 95))
					(bool.or
						(bool.and (bool.not (u8.lt (local byte) (u8 65))) (u8.lt (local byte) (u8 91)))
						(bool.and (bool.not (u8.lt (local byte) (u8 97))) (u8.lt (local byte) (u8 123))))))))

	(fn
		(:doc `Recognize identifier continuation bytes, including digits, dot, and hyphen.`)
		(:pragma (inline always))
		is_head_tail_byte
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Keep the head's continuation alphabet identical to the seed's.")
				(bool.or
					(call is_head_start_byte (local byte))
					(bool.or
						(bool.or (u8.eq (local byte) (u8 45)) (u8.eq (local byte) (u8 46)))
						(bool.and (bool.not (u8.lt (local byte) (u8 48))) (u8.lt (local byte) (u8 58))))))))

	(fn
		(:doc `Check the identifier bytes after the optional metadata colon.`)
		(:pragma (inline always))
		is_identifier_head
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns bool)
		(body
			(if
				(:doc "A colon alone has no identifier and must never trigger a byte load.")
				(bool.not (i32.lt (local start) (local end)))
				(then (return (bool false))))
			(let first (slice.load (local source) (local start)))
			(if
				(:doc "The leading identifier byte cannot use continuation-only characters.")
				(bool.not (call is_head_start_byte (local first)))
				(then (return (bool false))))
			(let-mut cursor (i32.add.wrapping (local start) (i32 1)))
			(while
				(:doc "Check the rest of the raw spelling up to its exclusive end.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(if
						(:doc "A non-ASCII byte or invalid punctuation makes the whole head invalid.")
						(bool.not (call is_head_tail_byte (local byte)))
						(then (return (bool false))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (bool true))))

	(fn
		(:doc `Compare a byte inside a tag whose width has already been checked.`)
		(:pragma (inline always))
		is_head_byte
		(params (source (shared-slice u8)) (start i32) (offset i32) (byte u8))
		(returns bool)
		(body
			(return (u8.eq
					(slice.load (local source) (i32.add.wrapping (local start) (local offset)))
					(local byte)))))

	(fn
		(:doc `Match the literal meta head within its raw byte span.`)
		(:pragma (inline always))
		is_meta_head
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns bool)
		(body
			(return
				(:doc "The width comparison protects all four byte reads.")
				(bool.and
					(i32.eq (i32.sub.wrapping (local end) (local start)) (i32 4))
					(bool.and
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 109))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 101)))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 116))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 97))))))))

	(fn
		(:doc `Match with-meta exactly and reuse the checked meta suffix.`)
		(:pragma (inline always))
		is_with_meta_head
		(params (source (shared-slice u8)) (head SourceNode))
		(returns bool)
		(body
			(let start (record.get (local head) start))
			(let end (record.get (local head) end))
			(return
				(:doc "Read the prefix and suffix only after checking the full head width.")
				(bool.and
					(i32.eq (i32.sub.wrapping (local end) (local start)) (i32 9))
					(bool.and
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 119))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 105)))
						(bool.and
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 116))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 104)))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 45))
								(call is_meta_head (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 5)) (local end)))))))))

	(fn
		(:doc `Use an existing row as the primary span of a structural diagnostic.`)
		source_node_failure
		(params (code u32) (node SourceNode))
		(returns FormCheck)
		(body
			(return (call form_failure (local code)
					(record.get (local node) start) (record.get (local node) end)))))

	(fn
		(:doc `Check each child head and allow colon entries only in the enclosing form's prefix.`)
		check_metadata_children
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(container SourceNode) (checked FormCheck))
		(returns FormCheck)
		(body
			(let-mut in_prefix (u32.eq (record.get (local container) kind) (u32 40)))
			(let-mut child_index (record.get (local container) first_child))
			(if
				(:doc "A tagged form starts its prefix after its head. The synthetic root has no prefix.")
				(local in_prefix)
				(then
					(let tag (slice.load (local nodes) (local child_index)))
					(set (local child_index) (record.get (local tag) next_sibling))))
			(while
				(:doc "Check siblings in order so the first ordinary operand closes the prefix.")
				(bool.not (i32.lt (local child_index) (i32 0)))
				(body
					(let child (slice.load (local nodes) (local child_index)))
					(if
						(:doc "Only form children have heads. Atoms always count as ordinary operands.")
						(u32.eq (record.get (local child) kind) (u32 40))
						(then
							(let head (slice.load (local nodes) (record.get (local child) first_child)))
							(let start (record.get (local head) start))
							(let end (record.get (local head) end))
							(let entry (u8.eq (slice.load (local source) (local start)) (u8 58)))
							(let-mut identifier_start (local start))
							(if
								(:doc "Check the identifier spelling after an optional colon byte.")
								(local entry)
								(then (set (local identifier_start) (i32.add.wrapping (local start) (i32 1)))))
							(if
								(:doc "Report malformed heads at the bare tag's byte span.")
								(bool.not (call is_identifier_head (borrow-shared (local source))
										(local identifier_start) (local end)))
								(then (return (call source_node_failure (u32 12) (local head)))))
							(if
								(:doc "Retired wrappers and lists fail where their exact tags occur.")
								(bool.or
									(call is_meta_head (borrow-shared (local source)) (local start) (local end))
									(call is_with_meta_head (borrow-shared (local source)) (local head)))
								(then (return (call source_node_failure (u32 14) (local head)))))
							(if
								(:doc "A colon-tagged form needs an enclosing prefix that is still open.")
								(bool.and (local entry) (bool.not (local in_prefix)))
								(then (return (call source_node_failure (u32 13) (local head)))))
							(set (local in_prefix) (local entry)))
						(else (set (local in_prefix) (bool false))))
					(set (local child_index) (record.get (local child) next_sibling))))
			(return (local checked))))

	(fn
		(:doc `Validate form heads and metadata attachment without changing the source tree.

		Each form owns its initial colon-tagged child forms. The first ordinary operand
		ends that prefix. Preserve each entry and operand in its original source order.`)
		(:expect parser.metadata_prefix
			(issue "https://github.com/wove-lang/wove/issues/59"))
		check_source_metadata
		(params (source (shared-slice u8)) (checked FormCheck) (nodes (shared-slice SourceNode)))
		(returns FormCheck)
		(body
			(if
				(:doc "Failed tree construction keeps its original diagnostic.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (local checked))))
			(let count (int.convert i32 (record.get (local checked) rows)))
			(let-mut index (i32 0))
			(while
				(:doc "Each container owns a sibling list and checks its heads once.")
				(i32.lt (local index) (local count))
				(body
					(let node (slice.load (local nodes) (local index)))
					(let kind (record.get (local node) kind))
					(if
						(:doc "The synthetic root and parenthesized forms are the only containers.")
						(bool.or (u32.eq (local kind) (u32 0)) (u32.eq (local kind) (u32 40)))
						(then
							(let result (call check_metadata_children
									(borrow-shared (local source)) (borrow-shared (local nodes))
									(local node) (local checked)))
							(if
								(:doc "Leave the rows intact and return the originating diagnostic.")
								(u32.lt (u32 0) (record.get (local result) error))
								(then (return (local result))))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local checked))))

	(fn
		(:doc `Append a whole raw token and its separator, or return -1 if both cannot fit.`)
		render_source_token
		(params (source (shared-slice u8)) (output (mut-slice u8))
			(start i32) (end i32) (kind u32) (previous u32) (written i32))
		(returns i32)
		(body
			(let separator (bool.and
					(bool.not (bool.or (u32.eq (local previous) (u32 0)) (u32.eq (local previous) (u32 40))))
					(bool.not (u32.eq (local kind) (u32 41)))))
			(let width (i32.sub.wrapping (local end) (local start)))
			(let room (i32.sub.wrapping (slice.len (local output)) (local written)))
			(if
				(:doc "Compare with the remaining capacity before adding any offsets or writing a partial token.")
				(bool.or (i32.lt (local room) (local width))
					(bool.and (local separator) (i32.eq (local room) (local width))))
				(then (return (i32 -1))))
			(let-mut cursor (local written))
			(if
				(:doc "A space separates adjacent tokens outside the tight edges of parentheses.")
				(local separator)
				(then
					(slice.store (local output) (local cursor) (u8 32))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(let-mut offset (local start))
			(while
				(:doc "Copy the original spelling byte for byte, including any escapes.")
				(i32.lt (local offset) (local end))
				(body
					(slice.store (local output) (local cursor) (slice.load (local source) (local offset)))
					(set (local offset) (i32.add.wrapping (local offset) (i32 1)))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (local cursor))))

	(fn
		(:doc `Render the validated tree by visiting its links against the original byte view.

		Choose layout between tokens and copy their complete raw spellings. If the output
		view is short, return the written prefix at a token boundary.`)
		(:expect source.token_roundtrip
			(issue "https://github.com/wove-lang/wove/issues/47"))
		render_source_tree
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (output (mut-slice u8)))
		(returns RenderResult)
		(body
			(let root (slice.load (local nodes) (i32 0)))
			(let-mut index (record.get (local root) first_child))
			(let-mut closing (bool false))
			(let-mut previous (u32 0))
			(let-mut written (i32 0))
			(while
				(:doc "Parent links schedule pending closers without recursion or a separate stack.")
				(i32.lt (i32 0) (local index))
				(body
					(let node (slice.load (local nodes) (local index)))
					(let-mut kind (record.get (local node) kind))
					(let-mut start (record.get (local node) start))
					(let-mut end (record.get (local node) end))
					(if
						(:doc "A form contributes its opener before the children and its closer on the way back up.")
						(local closing)
						(then
							(set (local kind) (u32 41))
							(set (local start) (i32.sub.wrapping (local end) (i32 1))))
						(else
							(if
								(:doc "On entry, emit just the opener instead of copying the full form span.")
								(u32.eq (local kind) (u32 40))
								(then (set (local end) (i32.add.wrapping (local start) (i32 1)))))))
					(let next (call render_source_token (borrow-shared (local source)) (borrow-mut (local output))
							(local start) (local end) (local kind) (local previous) (local written)))
					(if
						(:doc "Keep the completed prefix and leave the remaining output bytes alone on capacity failure.")
						(i32.lt (local next) (i32 0))
						(then (return (record.make RenderResult (written (local written)) (error (u32 16))))))
					(set (local written) (local next))
					(set (local previous) (local kind))
					(if
						(:doc "Every validated form has a child. Other tokens proceed to a sibling or close their parent.")
						(u32.eq (local kind) (u32 40))
						(then (set (local index) (record.get (local node) first_child)))
						(else
							(let sibling (record.get (local node) next_sibling))
							(set (local closing) (i32.lt (local sibling) (i32 0)))
							(if
								(:doc "The synthetic source root has no closer, so returning to index zero ends the walk.")
								(local closing)
								(then (set (local index) (record.get (local node) parent)))
								(else (set (local index) (local sibling))))))))
			(return (record.make RenderResult (written (local written)) (error (u32 0)))))))
