(module source_scan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read and render serialized Wove source through borrowed byte views.

	Admission validates UTF-8 before tokenization. The tree retains source-relative byte
	spans and links for forms, atoms, and metadata. Rendering uses those links to copy
	the original token spellings into caller-provided storage.`)

	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte is_c_identifier))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte)))
	(use wove-file "../text/utf8.wove" (only utf8_invalid_offset valid_utf8_width))
	(use wove-file "../text/quoted.wove" (only scan_double_quoted))
	(use wove-file "../text/character.wove" (only scan_character_span decode_character))

	(let character_token 4u32)

	(struct Token (fields (kind u32) (start i32) (end i32) (error u32)))
	(struct SourceDiagnostic (fields (error u32) (start i32) (end i32)))
	(struct SourcePosition (fields (line u32) (column u32)))
	(struct FormCheck (fields (rows u32) (start i32) (end i32) (error u32)))
	(struct SourceNode
		(fields (kind u32) (start i32) (end i32) (parent i32) (first_child i32) (next_sibling i32)
			(bridge_project i32) (bridge_default i32) (generic_kind u8) (generic_value u32)))
	(struct RenderResult (fields (written i32) (error u32)))
	(struct BridgeOpening (fields (header i32) (site i32) (error u32)))

	(fn is_ascii_whitespace
		(:doc `Match the seed's ASCII separators, U+0009–U+000D and U+001C–U+0020.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return
				(:doc "Test the two half-open ranges directly in the raw bytes.")
				(bool.or
					(bool.and (u8.not-lt (local byte) 9u8) (u8.lt (local byte) 14u8))
					(bool.and (u8.not-lt (local byte) 28u8) (u8.lt (local byte) 33u8))))))

	(fn is_parenthesis
		(:doc `Parentheses are both atom boundaries and one-byte tokens.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) 40u8) (u8.eq (local byte) 41u8)))))

	(fn is_semicolon_or_quote
		(:doc `Stop an atom before a semicolon or any literal delimiter.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) 59u8)
					(bool.or (u8.eq (local byte) 34u8)
						(bool.or (u8.eq (local byte) 39u8) (u8.eq (local byte) 96u8)))))))

	(fn skip_whitespace
		(:doc `Resume at the supplied cursor and leave the first non-whitespace byte unconsumed.`)
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let end (array.len (local source)))
			(let-mut cursor (local start))
			(while
				(:doc "The end cursor needs no byte load.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (array.load (local source) (local cursor)))
					(let width (call whitespace_width (borrow-shared (local source)) (local cursor) (local byte)))
					(if
						(:doc "Preserve the offset of the first byte that can start a token.")
						(i32.eqz (local width))
						(then (return (local cursor))))
					(set (local cursor) (i32.add (local cursor) (local width)))))
			(return (local cursor))))

	(fn source_offset
		(:doc `Find the first significant byte or the end of this view.`)
		(params (source (shared-array u8)))
		(returns i32)
		(body
			(return (call skip_whitespace (borrow-shared (local source)) 0i32))))

	(fn source_kind
		(:doc `Classify the first significant byte for callers that only need its original byte kind.`)
		(:expect
			(tests "stage-2/source_scan.probe.c")
			(issues "gh:wove-lang/wove:13"))
		(params (source (shared-array u8)))
		(returns u32)
		(body
			(let offset (call source_offset (borrow-shared (local source))))
			(if
				(:doc "Return the EOF kind before another load can reach the end of the view.")
				(i32.eq (local offset) (array.len (local source)))
				(then (return 0u32)))
			(let byte (array.load (local source) (local offset)))
			(if
				(:doc "Preserve either parenthesis byte code as the kind.")
				(call is_parenthesis (local byte))
				(then (return (u32.from-u8 (local byte)))))
			(return 1u32)))

	(fn bare_atom_end
		(:doc `Find the exclusive end of an atom whose first byte has already been accepted.`)
		(params (source (shared-array u8)) (next i32))
		(returns i32)
		(body
			(let length (array.len (local source)))
			(let-mut cursor (local next))
			(while
				(:doc "The view can end immediately after the last atom byte.")
				(i32.lt (local cursor) (local length))
				(body
					(let byte (array.load (local source) (local cursor)))
					(if
						(:doc "Stop before the first byte of any separator or token delimiter.")
						(bool.or
							(bool.or
								(call is_parenthesis (local byte))
								(call is_semicolon_or_quote (local byte)))
							(i32.gtz (call whitespace_width (borrow-shared (local source)) (local cursor) (local byte))))
						(then (return (local cursor))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (local cursor))))

	(fn is_line_ending
		(:doc `Recognize physical CR and LF bytes when counting source lines.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) 13u8) (u8.eq (local byte) 10u8)))))

	(fn lexical_error
		(:doc `Keep the raw extent of a lexical error for the caller.`)
		(params (code u32) (start i32) (end i32))
		(returns Token)
		(body
			(return (struct.new Token
					(kind 3u32) (error (local code)) (start (local start)) (end (local end))))))

	(fn scan_quoted
		(:doc "Translate a shared double-quoted span into the Wove token and diagnostic kinds.")
		(params (source (shared-array u8)) (start i32))
		(returns Token)
		(body
			(let span (call scan_double_quoted (borrow-shared (local source)) (local start) (bool true)))
			(let end (struct.get (local span) end))
			(let error (struct.get (local span) error))
			(if
				(:doc "The three quoted scanning errors follow the unexpected-delimiter code.")
				(u32.gtz (local error))
				(then (return (call lexical_error (u32.inc (local error)) (local start) (local end)))))
			(return (struct.new Token (kind 2u32) (error 0u32) (start (local start)) (end (local end))))))

	(fn scan_character
		(:doc "Validate a single byte value and retain the complete character token spelling.")
		(params (source (shared-array u8)) (start i32)) (returns Token)
		(body
			(let span (call scan_character_span (borrow-shared (local source)) (local start)))
			(let end (struct.get (local span) end))
			(if
				(:doc "Missing closing quotes use the existing unterminated-literal diagnostic.")
				(bool.not (struct.get (local span) closed))
				(then (return (call lexical_error 2u32 (local start) (local end)))))
			(if
				(:doc "An invalid payload points to its original quoted token.")
				(i32.ltz (call decode_character (borrow-shared (local source)) (local start) (local end)))
				(then
					(if
						(:doc "Keep unsupported and malformed escapes in the existing error category.")
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 92u8)
						(then (return (call lexical_error 3u32 (local start) (local end)))))
					(return (call lexical_error 25u32 (local start) (local end)))))
			(return (struct.new Token (kind (local character_token)) (error 0u32) (start (local start)) (end (local end))))))

	(fn scan_raw_string
		(:doc `Find the closing delimiter of a raw string in an admitted byte view.`)
		(:expect
			(tests "stage-2/lexer_stream.wove" "stage-2/lexer_errors.tsv")
			(issues "gh:wove-lang/wove:53"))
		(params (source (shared-array u8)) (start i32))
		(returns Token)
		(body
			(let length (array.len (local source)))
			(let-mut cursor (i32.inc (local start)))
			(while
				(:doc "Advance from the opening delimiter without stepping outside the view.")
				(i32.lt (local cursor) (local length))
				(body
					(let byte (array.load (local source) (local cursor)))
					(set (local cursor) (i32.inc (local cursor)))
					(if
						(:doc "Only a backtick can end the string.")
						(u8.eq (local byte) 96u8)
						(then
							(if
								(:doc "Consume a doubled backtick only when both bytes are in the view.")
								(bool.and (i32.lt (local cursor) (local length))
									(u8.eq (array.load (local source) (local cursor)) 96u8))
								(then (set (local cursor) (i32.inc (local cursor))))
								(else
									(return (struct.new Token
											(kind 2u32) (error 0u32) (start (local start)) (end (local cursor))))))))))
			(return (call lexical_error 2u32 (local start) (local length)))))

	(fn scan_token
		(:doc `Scan one token in a view already checked by ``admit_source``.

		Start at a view-relative byte cursor and advance by the resulting exclusive end.
		Both string delimiters produce kind 2. Use the opening byte to tell the two
		spellings apart and keep all literal bytes in the span. Single-quoted character
		tokens have their own kind.`)
		(:expect
			(tests
				"stage-2/lexer_layouts.tsv" "stage-2/lexer_errors.tsv"
				"stage-2/source_decodings.tsv" "stage-2/source_scan.probe.c"
				"stage-2/lexer_stream.wove")
			(issues
				"gh:wove-lang/wove:29" "gh:wove-lang/wove:31" "gh:wove-lang/wove:33"
				"gh:wove-lang/wove:34"))
		(params (source (shared-array u8)) (cursor i32))
		(returns Token)
		(body
			(let start (call skip_whitespace (borrow-shared (local source)) (local cursor)))
			(let length (array.len (local source)))
			(if
				(:doc "Only the exact end cursor can return EOF without another checked load.")
				(i32.eq (local start) (local length))
				(then
					(return (struct.new Token (kind 0u32) (error 0u32) (start (local start)) (end (local start))))))
			(let byte (array.load (local source) (local start)))
			(let next (i32.inc (local start)))
			(if
				(:doc "Parentheses consume one byte and use their byte code as the token kind.")
				(call is_parenthesis (local byte))
				(then
					(return (struct.new Token
							(kind (u32.from-u8 (local byte)))
							(error 0u32)
							(start (local start))
							(end (local next))))))
			(if
				(:doc "The opening quote selects the string scanner before interpreting any content.")
				(u8.eq (local byte) 34u8)
				(then (return (call scan_quoted (borrow-shared (local source)) (local start)))))
			(if
				(:doc "A character can include delimiters when they are the quoted payload.")
				(u8.eq (local byte) 39u8)
				(then (return (call scan_character (borrow-shared (local source)) (local start)))))
			(if
				(:doc "The backtick scanner keeps all literal bytes in the token span.")
				(u8.eq (local byte) 96u8)
				(then (return (call scan_raw_string (borrow-shared (local source)) (local start)))))
			(if
				(:doc "An unquoted semicolon is an unexpected delimiter.")
				(u8.eq (local byte) 59u8)
				(then (return (call lexical_error 1u32 (local start) (local next)))))
			(let end (call bare_atom_end (borrow-shared (local source)) (local next)))
			(return (struct.new Token (kind 1u32) (error 0u32) (start (local start)) (end (local end))))))

	(fn admit_source
		(:doc `Admit the entire byte view once before tokenization.

		Return -1 for valid UTF-8 or the view-relative byte offset of the first
		malformed sequence. The caller keeps the original bytes for scanning and diagnostics.`)
		(:expect
			(tests "stage-2/lexer_errors.tsv")
			(issues "gh:wove-lang/wove:32"))
		(params (source (shared-array u8)))
		(returns i32)
		(body (return (call utf8_invalid_offset (borrow-shared (local source))))))

	(fn whitespace_width
		(:doc `Return the byte width of a seed separator at the cursor, or zero.`)
		(params (source (shared-array u8)) (cursor i32) (lead u8))
		(returns i32)
		(body
			(if
				(:doc "ASCII uses the seed's two contiguous separator ranges.")
				(u8.lt (local lead) 128u8)
				(then
					(if
						(:doc "Return a single-byte width for either ASCII range.")
						(call is_ascii_whitespace (local lead))
						(then (return 1i32)))
					(return 0i32)))
			(let remaining (i32.sub (array.len (local source)) (local cursor)))
			(if
				(:doc "U+0085 and U+00A0 are the only two-byte separators.")
				(u8.eq (local lead) 194u8)
				(then
					(if
						(:doc "Keep the second-byte load inside this view.")
						(i32.lt (local remaining) 2i32)
						(then (return 0i32)))
					(let second (array.load (local source) (i32.inc (local cursor))))
					(if
						(:doc "The C2 prefix has two accepted suffixes.")
						(bool.or (u8.eq (local second) 133u8) (u8.eq (local second) 160u8))
						(then (return 2i32)))
					(return 0i32)))
			(if
				(:doc "Three-byte separators start with E1, E2, or E3 and need both suffix bytes.")
				(bool.or
					(i32.lt (local remaining) 3i32)
					(bool.or (u8.lt (local lead) 225u8) (u8.lt 227u8 (local lead))))
				(then (return 0i32)))
			(let second (array.load (local source) (i32.inc (local cursor))))
			(let third (array.load (local source) (i32.add (local cursor) 2i32)))
			(if
				(:doc "E1 9A 80 is U+1680.")
				(u8.eq (local lead) 225u8)
				(then
					(if
						(:doc "U+1680 occupies all three bytes.")
						(bool.and (u8.eq (local second) 154u8) (u8.eq (local third) 128u8))
						(then (return 3i32)))
					(return 0i32)))
			(if
				(:doc "E3 80 80 is U+3000.")
				(u8.eq (local lead) 227u8)
				(then
					(if
						(:doc "The E3 prefix has one accepted suffix.")
						(bool.and (u8.eq (local second) 128u8) (u8.eq (local third) 128u8))
						(then (return 3i32)))
					(return 0i32)))
			(if
				(:doc "E2 81 9F is U+205F.")
				(bool.and (u8.eq (local second) 129u8) (u8.eq (local third) 159u8))
				(then (return 3i32)))
			(if
				(:doc "E2 80 covers U+2000 through U+200A, U+2028, U+2029, and U+202F.")
				(bool.and
					(u8.eq (local second) 128u8)
					(bool.or
						(bool.and (u8.not-lt (local third) 128u8) (u8.lt (local third) 139u8))
						(bool.or
							(bool.or (u8.eq (local third) 168u8) (u8.eq (local third) 169u8))
							(u8.eq (local third) 175u8))))
				(then (return 3i32)))
			(return 0i32)))

	(fn source_diagnostic
		(:doc `Expose admission failures in the same diagnostic code space as lexical errors.`)
		(params (source (shared-array u8)))
		(returns SourceDiagnostic)
		(body
			(let start (call admit_source (borrow-shared (local source))))
			(if
				(:doc "Successful admission carries no primary span.")
				(i32.ltz (local start))
				(then
					(return (struct.new SourceDiagnostic (error 0u32) (start 0i32) (end 0i32)))))
			(let
				(:doc "Anchor malformed UTF-8 at its lead byte, even when the sequence is clipped.")
				end (i32.inc (local start)))
			(return (struct.new SourceDiagnostic (error 5u32) (start (local start)) (end (local end))))))

	(fn source_position
		(:doc `Map a view-relative span start to its coordinates in the parent source.`)
		(params (parent (shared-array u8)) (view_start i32) (span_start i32))
		(returns SourcePosition)
		(body
			(let target (i32.add (local view_start) (local span_start)))
			(let-mut cursor 0i32)
			(let-mut line 1u32)
			(let-mut column 1u32)
			(let-mut previous_cr (bool false))
			(while
				(:doc "Only bytes before the requested start can advance its coordinates.")
				(i32.lt (local cursor) (local target))
				(body
					(let byte (array.load (local parent) (local cursor)))
					(if
						(:doc "Count each physical line break once, including a CRLF pair.")
						(call is_line_ending (local byte))
						(then
							(if
								(:doc "An LF paired with the previous CR continues the same break.")
								(bool.or (u8.eq (local byte) 13u8) (bool.not (local previous_cr)))
								(then (set (local line) (u32.inc (local line)))))
							(set (local column) 1u32)
							(set (local cursor) (i32.inc (local cursor))))
						(else
							(let-mut width (call valid_utf8_width (borrow-shared (local parent)) (local cursor) (local byte)))
							(if
								(:doc "Count malformed bytes individually to preserve subsequent line breaks.")
								(i32.eqz (local width))
								(then (set (local width) 1i32)))
							(let remaining (i32.sub (local target) (local cursor)))
							(if
								(:doc "An offset inside a scalar still belongs to that scalar's column.")
								(i32.lt (local remaining) (local width))
								(then (set (local cursor) (local target)))
								(else
									(set (local column) (u32.inc (local column)))
									(set (local cursor) (i32.add (local cursor) (local width)))))))
					(set (local previous_cr) (u8.eq (local byte) 13u8))))
			(return (struct.new SourcePosition (line (local line)) (column (local column))))))

	(fn form_failure
		(:doc `Carry the first failure's original span back through the form check.`)
		(params (error u32) (start i32) (end i32))
		(returns FormCheck)
		(body
			(return (struct.new FormCheck
					(rows 0u32) (start (local start)) (end (local end)) (error (local error))))))

	(fn unclosed_form_start
		(:doc `Locate the last opener at the final depth of a stream that reached EOF.`)
		(params (source (shared-array u8)) (final_depth i32))
		(returns i32)
		(body
			(let length (array.len (local source)))
			(let-mut cursor 0i32)
			(let-mut depth 0i32)
			(let-mut opener 0i32)
			(while
				(:doc "Rescan only after the first pass proves the tokens reach EOF.")
				(i32.lt (local cursor) (local length))
				(body
					(let token (call scan_token (borrow-shared (local source)) (local cursor)))
					(let kind (struct.get (local token) kind))
					(set (local cursor) (struct.get (local token) end))
					(if
						(:doc "The innermost unclosed form is the final opener at final_depth.")
						(u32.eq (local kind) 40u32)
						(then
							(set (local depth) (i32.inc (local depth)))
							(if
								(:doc "Replace a candidate that may already have closed.")
								(i32.eq (local depth) (local final_depth))
								(then (set (local opener) (struct.get (local token) start))))))
					(if
						(:doc "Close the innermost form before classifying the next token.")
						(u32.eq (local kind) 41u32)
						(then (set (local depth) (i32.dec (local depth)))))))
			(return (local opener))))

	(fn check_source_form
		(:doc `Validate one tagged root and count the rows needed to build its tree.

		Admission and lexer failures take precedence when encountered. Count a synthetic
		source root and one row per opener or atom. A closer contributes to its form span.`)
		(:expect
			(tests "stage-2/source_forms.tsv")
			(issues "gh:wove-lang/wove:43"))
		(params (source (shared-array u8)))
		(returns FormCheck)
		(body
			(let admission (call source_diagnostic (borrow-shared (local source))))
			(let admission_error (struct.get (local admission) error))
			(if
				(:doc "Admission failures take precedence over any form structure.")
				(u32.gtz (local admission_error))
				(then
					(return (call form_failure (local admission_error)
							(struct.get (local admission) start) (struct.get (local admission) end)))))
			(let length (array.len (local source)))
			(let-mut cursor 0i32)
			(let-mut rows 1u32)
			(let-mut depth 0i32)
			(let-mut root_start -1i32)
			(let-mut root_end 0i32)
			(let-mut needs_tag (bool false))
			(while
				(:doc "Advance by raw token ends and keep only the state of the open forms.")
				(i32.lt (local cursor) (local length))
				(body
					(let token (call scan_token (borrow-shared (local source)) (local cursor)))
					(let kind (struct.get (local token) kind))
					(let start (struct.get (local token) start))
					(let end (struct.get (local token) end))
					(let error (struct.get (local token) error))
					(set (local cursor) (local end))
					(if
						(:doc "Keep the lexer's original error code and byte span.")
						(u32.gtz (local error))
						(then (return (call form_failure (local error) (local start) (local end)))))
					(if
						(:doc "Each opener, bare atom, and quoted atom occupies a row.")
						(bool.not (bool.or (u32.eqz (local kind)) (u32.eq (local kind) 41u32)))
						(then (set (local rows) (u32.inc (local rows)))))
					(if
						(:doc "The end marker leaves the structural state unchanged.")
						(u32.not-eqz (local kind))
						(then
							(if
								(:doc "The first significant token after an opener must be a bare tag.")
								(bool.and (local needs_tag) (u32.not-eq (local kind) 1u32))
								(then (return (call form_failure 7u32 (local start) (local end)))))
							(set (local needs_tag) (u32.eq (local kind) 40u32))
							(if
								(:doc "At depth zero, a significant token must start the only root.")
								(i32.eqz (local depth))
								(then
									(if
										(:doc "A closer at depth zero has no matching opener.")
										(u32.eq (local kind) 41u32)
										(then (return (call form_failure 8u32 (local start) (local end)))))
									(if
										(:doc "A completed root allows only trailing trivia.")
										(i32.not-ltz (local root_start))
										(then (return (call form_failure 10u32 (local start) (local end)))))
									(if
										(:doc "A bare or quoted atom cannot serve as the root.")
										(bool.not (local needs_tag))
										(then (return (call form_failure 6u32 (local start) (local end)))))
									(set (local root_start) (local start))))
							(if
								(:doc "A closer completes its form and may finish the root span.")
								(u32.eq (local kind) 41u32)
								(then
									(set (local depth) (i32.dec (local depth)))
									(if
										(:doc "Preserve the exclusive end of the actual root.")
										(i32.eqz (local depth))
										(then (set (local root_end) (local end))))))
							(if
								(:doc "Only an opener increases depth.")
								(local needs_tag)
								(then (set (local depth) (i32.inc (local depth)))))))))
			(if
				(:doc "Prefer the innermost unmatched opener as the primary EOF span.")
				(i32.gtz (local depth))
				(then
					(let opener (call unclosed_form_start (borrow-shared (local source)) (local depth)))
					(return (call form_failure 9u32 (local opener) (i32.inc (local opener))))))
			(if
				(:doc "Empty or whitespace-only input anchors the missing root at EOF.")
				(i32.ltz (local root_start))
				(then (return (call form_failure 6u32 (local length) (local length)))))
			(return (struct.new FormCheck
					(rows (local rows)) (start (local root_start)) (end (local root_end)) (error 0u32)))))

	(fn new_source_node
		(:doc `Initialize a row with its parent and empty child and sibling links.`)
		(params (kind u32) (start i32) (end i32) (parent i32))
		(returns SourceNode)
		(body
			(return (struct.new SourceNode
					(kind (local kind)) (start (local start)) (end (local end)) (parent (local parent))
					(first_child -1i32) (next_sibling -1i32) (bridge_project -1i32) (bridge_default -1i32)
					(generic_kind 0u8) (generic_value 0u32)))))

	(fn revise_source_node
		(:doc `Replace a row's end and outgoing links while keeping its identity and parent.`)
		(params (node SourceNode) (end i32) (first_child i32) (next_sibling i32))
		(returns SourceNode)
		(body
			(return (struct.new SourceNode
					(kind (struct.get (local node) kind))
					(start (struct.get (local node) start))
					(end (local end))
					(parent (struct.get (local node) parent))
					(first_child (local first_child))
					(next_sibling (local next_sibling))
					(bridge_project (struct.get (local node) bridge_project)) (bridge_default (struct.get (local node) bridge_default))
					(generic_kind (struct.get (local node) generic_kind)) (generic_value (struct.get (local node) generic_value))))))

	(fn append_source_child
		(:doc `Append a child in source order using the open parent's end field to track its last child.`)
		(params (nodes (mut-array SourceNode)) (parent i32) (index i32) (child SourceNode))
		(returns void)
		(body
			(let container (array.load (local nodes) (local parent)))
			(let tail (struct.get (local container) end))
			(let-mut first (struct.get (local container) first_child))
			(if
				(:doc "A first child sets the container entry point; later children extend the sibling chain.")
				(i32.ltz (local tail))
				(then (set (local first) (local index)))
				(else
					(let sibling (array.load (local nodes) (local tail)))
					(array.store (local nodes) (local tail)
						(call revise_source_node (local sibling)
							(struct.get (local sibling) end)
							(struct.get (local sibling) first_child)
							(local index)))))
			(array.store (local nodes) (local parent)
				(call revise_source_node (local container) (local index) (local first)
					(struct.get (local container) next_sibling)))
			(array.store (local nodes) (local index) (local child))))

	(fn seal_source_node
		(:doc `Finalize the byte span once an open container has received all of its children.`)
		(params (nodes (mut-array SourceNode)) (index i32) (node SourceNode) (end i32))
		(returns void)
		(body
			(array.store (local nodes) (local index)
				(call revise_source_node (local node) (local end)
					(struct.get (local node) first_child)
					(struct.get (local node) next_sibling)))))

	(fn build_source_tree
		(:doc `Build the checked view as a source-ordered tree in caller-provided record storage.

		Check the row capacity before writing. Parent links track open forms, so deeply
		nested input needs no recursive walk or separate stack.`)
		(:expect
			(tests "stage-2/source_trees.tsv")
			(issues "gh:wove-lang/wove:45"))
		(params (source (shared-array u8)) (checked FormCheck) (nodes (mut-array SourceNode)))
		(returns FormCheck)
		(body
			(if
				(:doc "Leave storage alone when the same view failed its form check.")
				(u32.gtz (struct.get (local checked) error))
				(then (return (local checked))))
			(let capacity (u32.from-i32 (array.len (local nodes))))
			(if
				(:doc "The row count from admission guarantees room for every write below.")
				(u32.lt (local capacity) (struct.get (local checked) rows))
				(then
					(return (call form_failure 11u32
							(struct.get (local checked) start) (struct.get (local checked) end)))))
			(let length (array.len (local source)))
			(array.store (local nodes) 0i32 (call new_source_node 0u32 0i32 -1i32 -1i32))
			(let-mut cursor 0i32)
			(let-mut parent 0i32)
			(let-mut next_index 1i32)
			(while
				(:doc "An open form's parent link acts as the stack for the admitted token stream.")
				(i32.lt (local cursor) (local length))
				(body
					(let token (call scan_token (borrow-shared (local source)) (local cursor)))
					(let kind (struct.get (local token) kind))
					(let end (struct.get (local token) end))
					(set (local cursor) (local end))
					(if
						(:doc "The closer seals its form rather than occupying its own row.")
						(u32.eq (local kind) 41u32)
						(then
							(let open_node (array.load (local nodes) (local parent)))
							(call seal_source_node (borrow-mut (local nodes)) (local parent) (local open_node) (local end))
							(set (local parent) (struct.get (local open_node) parent))))
					(if
						(:doc "Each opener or atom appends one child row.")
						(bool.not (bool.or (u32.eqz (local kind)) (u32.eq (local kind) 41u32)))
						(then
							(let is_form (u32.eq (local kind) 40u32))
							(let-mut node_end (local end))
							(if
								(:doc "An open form starts with no last child until a token is appended.")
								(local is_form)
								(then (set (local node_end) -1i32)))
							(let child (call new_source_node (local kind) (struct.get (local token) start)
									(local node_end) (local parent)))
							(call append_source_child (borrow-mut (local nodes)) (local parent) (local next_index) (local child))
							(if
								(:doc "Subsequent tokens belong to the new form until its closer.")
								(local is_form)
								(then (set (local parent) (local next_index))))
							(set (local next_index) (i32.inc (local next_index)))))))
			(let root (array.load (local nodes) 0i32))
			(call seal_source_node (borrow-mut (local nodes)) 0i32 (local root) (local length))
			(return (local checked))))

	(fn is_head_tail_byte
		(:doc "Allow dots and hyphens in fixed form words and metadata tags.")
		(:pragma (inline always))
		(params (byte u8)) (returns bool)
		(body (return (bool.or (call is_c_identifier_byte (local byte))
			(bool.or (u8.eq (local byte) 45u8) (u8.eq (local byte) 46u8))))))

	(fn is_identifier_head
		(:doc `Check the form word after any metadata colon.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(if
				(:doc "A colon alone has no identifier and must never trigger a byte load.")
				(i32.not-lt (local start) (local end))
				(then (return (bool false))))
			(let first (array.load (local source) (local start)))
			(if
				(:doc "The leading identifier byte cannot use continuation-only characters.")
				(bool.not (call is_c_identifier_start (local first)))
				(then (return (bool false))))
			(let-mut cursor (i32.inc (local start)))
			(while
				(:doc "Check the rest of the raw spelling up to its exclusive end.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (array.load (local source) (local cursor)))
					(if
						(:doc "A non-ASCII byte or invalid punctuation makes the whole head invalid.")
						(bool.not (call is_head_tail_byte (local byte)))
						(then (return (bool false))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (bool true))))

	(fn is_meta_head
		(:doc `Match the literal meta head within its raw byte span.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(return
				(:doc "The width comparison protects all four byte reads.")
				(bool.and
					(i32.eq (i32.sub (local end) (local start)) 4i32)
					(bool.and
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 0i32 109u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 1i32 101u8))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 2i32 116u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 3i32 97u8)))))))

	(fn is_with_meta_head
		(:doc `Match with-meta exactly and reuse the checked meta suffix.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (head SourceNode))
		(returns bool)
		(body
			(let start (struct.get (local head) start))
			(let end (struct.get (local head) end))
			(return
				(:doc "Read the prefix and suffix only after checking the full head width.")
				(bool.and
					(i32.eq (i32.sub (local end) (local start)) 9i32)
					(bool.and
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 0i32 119u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 1i32 105u8))
						(bool.and
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 2i32 116u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 3i32 104u8))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 4i32 45u8)
								(call is_meta_head (borrow-shared (local source))
									(i32.add (local start) 5i32) (local end)))))))))

	(fn is_disabled_head
		(:doc `Match the complete disabled tag in the checked source view.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (head SourceNode))
		(returns bool)
		(body
			(let start (struct.get (local head) start))
			(let width (i32.sub (struct.get (local head) end) (local start)))
			(return (bool.and (i32.eq (local width) 8i32)
				(bool.and
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 100u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 105u8))
					(bool.and
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 115u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 3i32 97u8))
						(bool.and
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 4i32 98u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 5i32 108u8))
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 6i32 101u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 7i32 100u8)))))))))

	(fn is_disabled_form
		(:doc `Identify a disabled sibling by its complete form head.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body (return (bool.and (u32.eq (struct.get (local node) kind) 40u32)
			(call is_disabled_head (borrow-shared (local source))
				(array.load (local nodes) (struct.get (local node) first_child)))))))

	(fn declaration_head
		(:doc `Classify the exact declaration heads that participate in fixed name slots.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(let start (struct.get (local node) start))
			(let width (i32.sub (struct.get (local node) end) (local start)))
			(if
				(:doc "The function head consists of exactly fn.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 102u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 110u8)))
				(then (return 2u32)))
			(if
				(:doc "The immutable binding head consists of exactly let.")
				(bool.and (i32.eq (local width) 3i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 108u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 2i32 116u8))))
				(then (return 6u32)))
			(if
				(:doc "The declaration group head consists of exactly decls.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 100u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 101u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 99u8)
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 4i32 115u8))))))
				(then (return 3u32)))
			(if
				(:doc "Disabled declarations retain their ordinary source name slots.")
				(call is_disabled_head (borrow-shared (local source)) (local node))
				(then (return 5u32)))
			(if
				(:doc "The remaining declaration heads each have six bytes.")
				(i32.not-eq (local width) 6i32)
				(then (return 0u32)))
			(if
				(:doc "Match the complete module head.")
				(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 109u8)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 111u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 100u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 117u8)
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 4i32 108u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 5i32 101u8))))))
				(then (return 1u32)))
			(if
				(:doc "A bridge owns function declarations with the same name slot.")
				(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 98u8)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 114u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 105u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 100u8)
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 4i32 103u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 5i32 101u8))))))
				(then (return 4u32)))
			(return 0u32)))

	(fn is_metadata_form
		(:doc `Recognize a colon-tagged form by its checked head.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(if
				(:doc "Only a form has a head to check.")
				(u32.not-eq (struct.get (local node) kind) 40u32)
				(then (return (bool false))))
			(let head (array.load (local nodes) (struct.get (local node) first_child)))
			(return (u8.eq (array.load (local source) (struct.get (local head) start)) 58u8))))

	(fn is_wove_name
		(:doc `Check an unquoted user-written name with the shared ASCII identifier grammar.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(call is_c_identifier (borrow-shared (local source))
					(struct.get (local node) start) (struct.get (local node) end))))))

	(fn is_c_header_provider
		(:doc `Match the bare provider keyword shared by C bridge definitions and imports.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(let start (struct.get (local node) start))
			(let width (i32.sub (struct.get (local node) end) (local start)))
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(bool.and (i32.eq (local width) 8i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 99u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 45u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 104u8)
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)
									(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 4i32 97u8)
										(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 5i32 100u8)
											(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 6i32 101u8)
												(call is_head_byte (borrow-shared (local source)) (local start) 7i32 114u8)))))))))))))

	(fn first_ordinary_child
		(:doc `Locate an opening slot past any misplaced metadata so its original span remains available.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (previous SourceNode))
		(returns i32)
		(body
			(let-mut index (struct.get (local previous) next_sibling))
			(while
				(:doc "Skip only the contiguous metadata that precedes the fixed field.")
				(bool.and (i32.not-ltz (local index))
					(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local nodes) (local index))))
				(body (set (local index) (struct.get (array.load (local nodes) (local index)) next_sibling))))
			(return (local index))))

	(fn bridge_opening
		(:doc `Keep a C bridge header row and any fixed-slot diagnostic.`)
		(params (header i32) (site i32) (error u32))
		(returns BridgeOpening)
		(body (return (struct.new BridgeOpening (header (local header)) (site (local site)) (error (local error))))))

	(fn c_bridge_opening
		(:doc `Read the fixed slots that follow a bridge head.

		Recover a quoted header across misplaced metadata so the matching
		header import can report the placement error in this provider.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (head SourceNode))
		(returns BridgeOpening)
		(body
			(let provider_row (call first_ordinary_child (borrow-shared (local source)) (borrow-shared (local nodes)) (local head)))
			(if
				(:doc "Other bridge providers retain their ordinary operand grammar.")
				(bool.or (i32.ltz (local provider_row))
					(bool.not (call is_c_header_provider (borrow-shared (local source)) (array.load (local nodes) (local provider_row)))))
				(then (return (call bridge_opening -1i32 -1i32 0u32))))
			(let provider (array.load (local nodes) (local provider_row)))
			(let header_slot (struct.get (local provider) next_sibling))
			(let header_row (call first_ordinary_child (borrow-shared (local source)) (borrow-shared (local nodes)) (local provider)))
			(let-mut header -1i32)
			(if
				(:doc "Only a checked string token can supply a C header key.")
				(bool.and (i32.lt -1i32 (local header_row))
					(u32.eq (struct.get (array.load (local nodes) (local header_row)) kind) 2u32))
				(then (set (local header) (local header_row))))
			(let provider_slot (struct.get (local head) next_sibling))
			(if
				(:doc "A metadata entry in the provider slot points to its own tag.")
				(i32.not-eq (local provider_slot) (local provider_row))
				(then (return (call bridge_opening (local header)
					(struct.get (array.load (local nodes) (local provider_slot)) first_child) 13u32))))
			(if
				(:doc "A metadata entry in the header slot is likewise too early.")
				(i32.not-eq (local header_slot) (local header_row))
				(then (return (call bridge_opening (local header)
					(struct.get (array.load (local nodes) (local header_slot)) first_child) 13u32))))
			(if
				(:doc "A missing or non-string header is a malformed bridge opening.")
				(i32.ltz (local header))
				(then (return (call bridge_opening -1i32 (local header_row) 26u32))))
			(return (call bridge_opening (local header) -1i32 0u32))))

	(fn is_c_bridge_member
		(:doc `Check that a C bridge member follows a complete header-first opening.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (head SourceNode) (start i32))
		(returns bool)
		(body
			(let opening (call c_bridge_opening (borrow-shared (local source)) (borrow-shared (local nodes)) (local head)))
			(let header (struct.get (local opening) header))
			(return (bool.and (u32.eqz (struct.get (local opening) error))
				(bool.and (i32.lt -1i32 (local header))
					(i32.not-lt (local start) (struct.get (array.load (local nodes) (local header)) end)))))))

	(fn declaration_context
		(:doc `Follow declaration containers to a module or a standalone declaration root.

		Module bindings require an enclosing module. Functions and C bridges
		can also stand alone. C bridges contribute function declarations
		after their header. Other enclosing forms keep their payload opaque.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (declaration u32))
		(returns bool)
		(body
			(let function (u32.eq (local declaration) 2u32))
			(let standalone (bool.or (local function) (u32.eq (local declaration) 4u32)))
			(let-mut index (struct.get (local node) parent))
			(let-mut start (struct.get (local node) start))
			(let-mut in_bridge (bool false))
			(while
				(:doc "Trace the entire ancestry before recognizing a declaration opening.")
				(i32.not-ltz (local index))
				(body
					(let owner (array.load (local nodes) (local index)))
					(if
						(:doc "Standalone functions and C bridges keep their opening slots without a module.")
						(u32.eqz (struct.get (local owner) kind))
						(then (return (local standalone))))
					(let parent (struct.get (local owner) parent))
					(let head (array.load (local nodes) (struct.get (local owner) first_child)))
					(let kind (call declaration_head (borrow-shared (local source)) (local head)))
					(if
						(:doc "Only a source module owns declarations after its name field.")
						(u32.eq (local kind) 1u32)
						(then
							(let first (struct.get (local head) next_sibling))
							(if
								(:doc "A nested module-shaped payload never starts a declaration ancestry.")
								(bool.or (i32.ltz (local first))
									(u32.not-eqz (struct.get (array.load (local nodes) (local parent)) kind)))
								(then (return (bool false))))
							(let name (array.load (local nodes) (local first)))
							(return (bool.and (call is_wove_name (borrow-shared (local source)) (local name))
								(i32.not-lt (local start) (struct.get (local name) end))))))
					(if
						(:doc "Only a C bridge or declaration group can continue the ancestry.")
						(u32.eq (local kind) 4u32)
						(then
							(if
								(:doc "A nested bridge or opaque provider cannot establish function declaration context.")
								(bool.or (bool.or (bool.not (local function)) (local in_bridge)) (bool.not (call is_c_bridge_member
									(borrow-shared (local source)) (borrow-shared (local nodes)) (local head) (local start))))
								(then (return (bool false))))
							(set (local in_bridge) (bool true)))
						(else
							(if
								(:doc "A metadata entry, body, or arbitrary payload stops the declaration walk.")
								(bool.not (bool.or (u32.eq (local kind) 3u32)
									(bool.and (local standalone) (u32.eq (local kind) 5u32))))
								(then (return (bool false))))))
					(set (local start) (struct.get (local owner) start))
					(set (local index) (local parent))))
			(return (bool false))))

	(fn read_c_bridge_opening
		(:doc `Apply the header-first opening only to actual C bridge declarations.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (head SourceNode))
		(returns BridgeOpening)
		(body
			(if
				(:doc "An opaque payload can use bridge as an ordinary form tag.")
				(bool.and (u32.eq (call declaration_head (borrow-shared (local source)) (local head)) 4u32)
					(call declaration_context (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) 4u32))
				(then (return (call c_bridge_opening (borrow-shared (local source)) (borrow-shared (local nodes)) (local head)))))
			(return (call bridge_opening -1i32 -1i32 0u32))))

	(fn named_form_error
		(:doc `Return the name diagnostic code for modules, functions, and module bindings.

		A form that uses the same head as a parameter or field keeps its
		ordinary operand grammar. Standalone functions can also be read as
		source forms.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (head SourceNode))
		(returns u32)
		(body
			(let tag (call declaration_head (borrow-shared (local source)) (local head)))
			(let function (u32.eq (local tag) 2u32))
			(if
				(:doc "Only modules, functions, and module bindings have the fixed name slot.")
				(bool.not (bool.or (local function) (bool.or (u32.eq (local tag) 1u32) (u32.eq (local tag) 6u32))))
				(then (return 0u32)))
			(let owner (array.load (local nodes) (struct.get (local node) parent)))
			(let root (u32.eqz (struct.get (local owner) kind)))
			(if
				(:doc "Only the source root can declare its module name.")
				(u32.eq (local tag) 1u32)
				(then
					(if
						(:doc "A source root stays distinct after rebasing its tree rows.")
						(local root)
						(then (return 19u32)))
					(return 0u32)))
			(if
				(:doc "Function and binding name slots depend on the complete declaration ancestry.")
				(call declaration_context (borrow-shared (local source)) (borrow-shared (local nodes))
					(local node) (local tag))
				(then (return 22u32)))
			(return 0u32)))

	(fn source_node_failure
		(:doc `Use an existing row as the primary span of a structural diagnostic.`)
		(params (code u32) (node SourceNode))
		(returns FormCheck)
		(body
			(return (call form_failure (local code)
					(struct.get (local node) start) (struct.get (local node) end)))))

	(fn check_metadata_children
		(:doc `Validate child heads, fixed opening slots, and the enclosing metadata prefix.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(container SourceNode) (checked FormCheck))
		(returns FormCheck)
		(body
			(let-mut in_prefix (u32.eq (struct.get (local container) kind) 40u32))
			(let-mut child_index (struct.get (local container) first_child))
			(let-mut name_error 0u32)
			(let-mut interleaved (bool false))
			(if
				(:doc "A tagged form can own metadata. The synthetic root has no prefix.")
				(local in_prefix)
				(then
					(let tag (array.load (local nodes) (local child_index)))
					(set (local name_error) (call named_form_error (borrow-shared (local source))
						(borrow-shared (local nodes)) (local container) (local tag)))
					(set (local interleaved) (bool.and (u32.gtz (local name_error))
						(u32.eq (call declaration_head (borrow-shared (local source)) (local tag)) 2u32)))
					(set (local child_index) (struct.get (local tag) next_sibling))
					(let opening (call read_c_bridge_opening (borrow-shared (local source))
						(borrow-shared (local nodes)) (local container) (local tag)))
					(let error (struct.get (local opening) error))
					(if
						(:doc "Keep a misplaced entry or invalid header on the original slot. An absent header points to the bridge.")
						(u32.gtz (local error))
						(then
							(let site (struct.get (local opening) site))
							(if
								(:doc "The next operand, if present, has the more precise span.")
								(i32.lt -1i32 (local site))
								(then (return (call source_node_failure (local error) (array.load (local nodes) (local site))))))
							(return (call source_node_failure (local error) (local container)))))
					(let header (struct.get (local opening) header))
					(if
						(:doc "The C bridge metadata prefix begins immediately after the header.")
						(i32.lt -1i32 (local header))
						(then (set (local child_index) (struct.get (array.load (local nodes) (local header)) next_sibling))))))
			(if
				(:doc "Module and function declarations require a bare name before their metadata.")
				(u32.gtz (local name_error))
				(then
					(if
						(:doc "A missing name without an operand points to its enclosing form.")
						(i32.ltz (local child_index))
						(then (return (call source_node_failure (local name_error) (local container)))))
					(let name (array.load (local nodes) (local child_index)))
					(if
						(:doc "Metadata before the name is misplaced at its own colon-prefixed head.")
						(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local name))
						(then (return (call source_node_failure 13u32
							(array.load (local nodes) (struct.get (local name) first_child))))))
					(if
						(:doc "Other invalid names keep their original operand span.")
						(bool.not (call is_wove_name (borrow-shared (local source)) (local name)))
						(then (return (call source_node_failure (local name_error) (local name)))))
					(set (local child_index) (struct.get (local name) next_sibling))))
			(while
				(:doc "Check siblings in source order from the start of the metadata prefix.")
				(i32.not-ltz (local child_index))
				(body
					(let child (array.load (local nodes) (local child_index)))
					(let-mut entry (bool false))
					(if
						(:doc "Only a child form with a colon head is a metadata candidate.")
						(u32.eq (struct.get (local child) kind) 40u32)
						(then
							(let head (array.load (local nodes) (struct.get (local child) first_child)))
							(let start (struct.get (local head) start))
							(let end (struct.get (local head) end))
							(set (local entry) (u8.eq (array.load (local source) (local start)) 58u8))
							(let-mut identifier_start (local start))
							(if
								(:doc "Check the identifier spelling after an optional colon byte.")
								(local entry)
								(then (set (local identifier_start) (i32.inc (local start)))))
							(if
								(:doc "Report malformed heads at the bare tag's byte span.")
								(bool.not (call is_identifier_head (borrow-shared (local source))
										(local identifier_start) (local end)))
								(then (return (call source_node_failure 12u32 (local head)))))
							(if
								(:doc "Retired wrappers and lists fail where their exact tags occur.")
								(bool.or
									(call is_meta_head (borrow-shared (local source)) (local start) (local end))
									(call is_with_meta_head (borrow-shared (local source)) (local head)))
								(then (return (call source_node_failure 14u32 (local head)))))
							(if
								(:doc "Function declarations also attach metadata between and after their fields.")
								(bool.and (local entry) (bool.not (bool.or (local in_prefix) (local interleaved))))
								(then (return (call source_node_failure 13u32 (local head)))))))
					(set (local in_prefix) (local entry))
					(set (local child_index) (struct.get (local child) next_sibling))))
			(return (local checked))))

	(fn check_source_metadata
		(:doc `Validate form heads and metadata attachment without changing the source tree.

		Modules and module bindings place their prefix after the bare name.
		Function declarations allow metadata anywhere after the bare name.
		A C bridge places its prefix after its provider and quoted header.
		Other forms start their prefix after the tag. Preserve source order and
		the original spans of all names, metadata, and fields.`)
		(:expect
			(tests "stage-2/source_metadata.tsv")
			(issues "gh:wove-lang/wove:59" "gh:wove-lang/wove:184" "gh:wove-lang/wove:246"))
		(params (source (shared-array u8)) (checked FormCheck) (nodes (shared-array SourceNode)))
		(returns FormCheck)
		(body
			(if
				(:doc "Failed tree construction keeps its original diagnostic.")
				(u32.gtz (struct.get (local checked) error))
				(then (return (local checked))))
			(let count (i32.from-u32 (struct.get (local checked) rows)))
			(let-mut index 0i32)
			(while
				(:doc "Each container owns a sibling list and checks its heads once.")
				(i32.lt (local index) (local count))
				(body
					(let node (array.load (local nodes) (local index)))
					(let kind (struct.get (local node) kind))
					(if
						(:doc "The synthetic root and parenthesized forms are the only containers.")
						(bool.or (u32.eqz (local kind)) (u32.eq (local kind) 40u32))
						(then
							(let result (call check_metadata_children
									(borrow-shared (local source)) (borrow-shared (local nodes))
									(local node) (local checked)))
							(if
								(:doc "Leave the rows intact and return the originating diagnostic.")
								(u32.gtz (struct.get (local result) error))
								(then (return (local result))))))
					(set (local index) (i32.inc (local index)))))
			(return (local checked))))

	(fn render_source_token
		(:doc `Append a whole raw token and its separator, or return -1 if both cannot fit.`)
		(params (source (shared-array u8)) (output (mut-array u8))
			(start i32) (end i32) (kind u32) (previous u32) (written i32))
		(returns i32)
		(body
			(let separator (bool.and
					(bool.not (bool.or (u32.eqz (local previous)) (u32.eq (local previous) 40u32)))
					(u32.not-eq (local kind) 41u32)))
			(let width (i32.sub (local end) (local start)))
			(let room (i32.sub (array.len (local output)) (local written)))
			(if
				(:doc "Compare with the remaining capacity before adding any offsets or writing a partial token.")
				(bool.or (i32.lt (local room) (local width))
					(bool.and (local separator) (i32.eq (local room) (local width))))
				(then (return -1i32)))
			(let-mut cursor (local written))
			(if
				(:doc "A space separates adjacent tokens outside the tight edges of parentheses.")
				(local separator)
				(then
					(array.store (local output) (local cursor) 32u8)
					(set (local cursor) (i32.inc (local cursor)))))
			(let-mut offset (local start))
			(while
				(:doc "Copy the original spelling byte for byte, including any escapes.")
				(i32.lt (local offset) (local end))
				(body
					(array.store (local output) (local cursor) (array.load (local source) (local offset)))
					(set (local offset) (i32.inc (local offset)))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (local cursor))))

	(fn render_source_tree
		(:doc `Render the validated tree by visiting its links against the original byte view.

		Choose layout between tokens and copy their complete raw spellings. If the output
		view is short, return the written prefix at a token boundary.`)
		(:expect
			(tests "stage-2/source_renderings.tsv")
			(issues "gh:wove-lang/wove:47"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (output (mut-array u8)))
		(returns RenderResult)
		(body
			(let root (array.load (local nodes) 0i32))
			(let-mut index (struct.get (local root) first_child))
			(let-mut closing (bool false))
			(let-mut previous 0u32)
			(let-mut written 0i32)
			(while
				(:doc "Parent links schedule pending closers without recursion or a separate stack.")
				(i32.gtz (local index))
				(body
					(let node (array.load (local nodes) (local index)))
					(let-mut kind (struct.get (local node) kind))
					(let-mut start (struct.get (local node) start))
					(let-mut end (struct.get (local node) end))
					(if
						(:doc "A form contributes its opener before the children and its closer on the way back up.")
						(local closing)
						(then
							(set (local kind) 41u32)
							(set (local start) (i32.dec (local end))))
						(else
							(if
								(:doc "On entry, emit just the opener instead of copying the full form span.")
								(u32.eq (local kind) 40u32)
								(then (set (local end) (i32.inc (local start)))))))
					(let next (call render_source_token (borrow-shared (local source)) (borrow-mut (local output))
							(local start) (local end) (local kind) (local previous) (local written)))
					(if
						(:doc "Keep the completed prefix and leave the remaining output bytes alone on capacity failure.")
						(i32.ltz (local next))
						(then (return (struct.new RenderResult (written (local written)) (error 16u32)))))
					(set (local written) (local next))
					(set (local previous) (local kind))
					(if
						(:doc "Every validated form has a child. Other tokens proceed to a sibling or close their parent.")
						(u32.eq (local kind) 40u32)
						(then (set (local index) (struct.get (local node) first_child)))
						(else
							(let sibling (struct.get (local node) next_sibling))
							(set (local closing) (i32.ltz (local sibling)))
							(if
								(:doc "The synthetic source root has no closer, so returning to index zero ends the walk.")
								(local closing)
								(then (set (local index) (struct.get (local node) parent)))
								(else (set (local index) (local sibling))))))))
			(return (struct.new RenderResult (written (local written)) (error 0u32))))))
