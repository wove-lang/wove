(module source_c_dependencies
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read lexical C dependencies and retain their original native declaration identities.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts))
	(use wove-file "./imports.wove" (only import_keyword read_import read_selector))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct CDependencyName (fields (declaration i32) (duplicate i32)))

	(fn first_bridge_operand
		(:doc "Start at the bridge's first ordinary member after its metadata prefix.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32))
		(returns i32)
		(body (return (struct:get (call form_parts (borrow-shared source) (borrow-shared nodes)
			(array:load nodes bridge)) operands))))

	(fn next_bridge_use
		(:doc "Find the next bridge-local use among direct children of the bridge.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row first)
			(while
				(:doc "Walk only the direct bridge members. Their declaration groups retain local selection rules.")
				(i32:not-ltz row)
				(body
					(let node (array:load nodes row))
					(let head (struct:get node first_child))
					(if
						(:doc "An explicit use is the only form that can introduce a bridge dependency.")
						(bool:and (i32:not-ltz head)
							(u32:eq (call import_keyword (borrow-shared source) (array:load nodes head)) 2u32))
						(then (return row)))
					(set row (struct:get node next_sibling))))
			(return -1i32)))

	(fn connect_bridge_type
		(:doc "Link a private type selector to the original definition in the current checked tree.")
		(params (nodes (mut-array SourceNode)) (selector i32) (declaration i32))
		(returns void)
		(body
			(let node (array:load nodes selector))
			(array:store nodes selector (struct:new SourceNode
				(kind (struct:get node kind)) (start (struct:get node start)) (end (struct:get node end))
				(parent (struct:get node parent)) (first_child (struct:get node first_child))
				(next_sibling (struct:get node next_sibling))
				(bridge_project declaration) (bridge_default (struct:get node bridge_default))
				(generic_kind (struct:get node generic_kind)) (generic_value (struct:get node generic_value))
				(local_identity (struct:get node local_identity)) (local_name_slot (struct:get node local_name_slot))
				(expression_identity (struct:get node expression_identity)) (expression_slot (struct:get node expression_slot))
				(label_identity (struct:get node label_identity)) (label_slot (struct:get node label_slot))))))

	(fn find_bridge_type_dependency
		(:doc "Resolve a private type spelling using the linked selectors of its own declaring bridge.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32)
			(start i32) (end i32))
		(returns CDependencyName)
		(body
			(let first (call first_bridge_operand (borrow-shared source) (borrow-shared nodes) bridge))
			(let-mut row (call next_bridge_use (borrow-shared source) (borrow-shared nodes) first))
			(let-mut found -1i32)
			(while
				(:doc "A bridge-local use contributes its linked explicit type selectors only.")
				(i32:not-ltz row)
				(body
					(let node (array:load nodes row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let import (call read_import (borrow-shared source) (borrow-shared nodes)
						node (struct:get parts operands)))
					(let-mut selector (struct:get import second))
					(while
						(:doc "Ignore unlinked selectors from inactive imports or forms outside the active graph.")
						(i32:not-ltz selector)
						(body
							(let item (array:load nodes selector))
							(let definition (struct:get item bridge_project))
							(if
								(:doc "A linked selector retains the normal type rename syntax.")
								(i32:not-ltz definition)
								(then
									(let name (call read_selector (borrow-shared source) (borrow-shared nodes) selector))
									(let local_name (array:load nodes (struct:get name second)))
									(if
										(:doc "Compare the local selector name with the signature spelling.")
										(call same_bytes (borrow-shared source) start end
											(borrow-shared source) (struct:get local_name start) (struct:get local_name end))
										(then
											(if
												(:doc "More than one declaration for the same local name is ambiguous.")
												(bool:and (i32:not-ltz found) (i32:not-eq found definition))
												(then (return (struct:new CDependencyName (declaration -1i32) (duplicate selector)))))
											(set found definition)))))
							(set selector (struct:get item next_sibling))))
					(set row (call next_bridge_use (borrow-shared source) (borrow-shared nodes)
						(struct:get node next_sibling)))))
			(return (struct:new CDependencyName (declaration found) (duplicate -1i32)))))
)
