(module source_receiver_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recognize the lexical boundary between a bare receiver and an operation.")

	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte is_c_identifier))
	(use wove-file "../text/match.wove" (only is_three_bytes))

	(let receiver_call_head 121u32)

	(fn receiver_separator
		(:doc "Return the separator in a receiver call or a bare length property.")
		(params (source (shared-array u8)) (start i32) (end i32) (head bool))
		(returns i32)
		(body
			(if
				(:doc "A bare atom only uses the length property spelling.")
				(bool:not head)
				(then
					(let separator (i32:sub end 4i32))
					(if
						(:doc "Check the entire property and its bare identifier prefix.")
						(bool:and (i32:lt start separator)
							(bool:and (u8:eq (array:get source separator) 46u8)
								(bool:and (call is_three_bytes (borrow-shared source) (i32:inc separator) 108u8 101u8 110u8)
									(call is_c_identifier (borrow-shared source) start separator))))
						(then (return separator)))
					(return -1i32)))
			(if
				(:doc "A call head starts with an ASCII identifier.")
				(bool:not (call is_c_identifier_start (array:get source start)))
				(then (return -1i32)))
			(let-mut separator (i32:inc start))
			(while
				(:doc "Find the end of the bare receiver.")
				(bool:and (i32:lt separator end)
					(call is_c_identifier_byte (array:get source separator)))
				(body (set separator (i32:inc separator))))
			(let suffix (i32:inc separator))
			(if
				(:doc "A dot must introduce a nonempty operation name.")
				(bool:not (bool:and (i32:lt suffix end)
					(bool:and (u8:eq (array:get source separator) 46u8)
						(call is_c_identifier_start (array:get source suffix)))))
				(then (return -1i32)))
			(let-mut cursor (i32:inc suffix))
			(while
				(:doc "Use the same operation-name grammar as a qualified head.")
				(i32:lt cursor end)
				(body
					(let byte (array:get source cursor))
					(if
						(:doc "A chain or slash path has no single operation suffix.")
						(bool:not (bool:or (call is_c_identifier_byte byte) (u8:eq byte 45u8)))
						(then (return -1i32)))
					(set cursor (i32:inc cursor))))
			(return separator))))
