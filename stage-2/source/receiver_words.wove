(module source_receiver_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recognize the lexical boundary between a bare receiver and an operation.")

	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte))
	(use wove-file "./field_paths.wove" (only field_path_prefix))

	(let receiver_call_head 121u32)

	(fn receiver_separator
		(:doc "Return the separator in a complete dotted receiver token.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let path (call field_path_prefix (borrow-shared source) start end))
			(let separator path/end)
			(if (separator.not-lt end) (then (return -1i32)))
			(let suffix separator.inc)
			(if
				(:doc "A complete receiver and a dot must precede a nonempty operation name.")
				(bool:not (bool:and (i32:lt start separator)
					(bool:and (suffix.lt end)
						(bool:and (u8:eq (source.get separator) 46u8)
							(call is_c_identifier_start (source.get suffix))))))
				(then (return -1i32)))
			(let-mut cursor suffix.inc)
			(while
				(:doc "Use the same operation-name grammar as a qualified head.")
				(cursor.lt end)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "A chain or slash path has no single operation suffix.")
						(bool:not (bool:or (call is_c_identifier_byte byte) (byte.eq 45u8)))
						(then (return -1i32)))
					(set cursor cursor.inc)))
			(return separator))))
