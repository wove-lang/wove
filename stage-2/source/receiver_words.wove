(module source_receiver_words
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recognize the lexical boundary between a bare receiver and an operation.")

	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte))

	(let receiver_call_head 121u32)

	(fn receiver_separator
		(:doc "Return the separator in a complete dotted receiver token.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(if
				(:doc "A bare receiver starts with an ASCII identifier.")
				(bool:not (call is_c_identifier_start (source.get start)))
				(then (return -1i32)))
			(let-mut separator (i32:inc start))
			(while
				(:doc "Find the end of the bare receiver.")
				(bool:and (i32:lt separator end)
					(call is_c_identifier_byte (source.get separator)))
				(body (set separator (i32:inc separator))))
			(let suffix (i32:inc separator))
			(if
				(:doc "A dot must introduce a nonempty operation name.")
				(bool:not (bool:and (i32:lt suffix end)
					(bool:and (u8:eq (source.get separator) 46u8)
						(call is_c_identifier_start (source.get suffix)))))
				(then (return -1i32)))
			(let-mut cursor (i32:inc suffix))
			(while
				(:doc "Use the same operation-name grammar as a qualified head.")
				(i32:lt cursor end)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "A chain or slash path has no single operation suffix.")
						(bool:not (bool:or (call is_c_identifier_byte byte) (u8:eq byte 45u8)))
						(then (return -1i32)))
					(set cursor (i32:inc cursor))))
			(return separator))))
