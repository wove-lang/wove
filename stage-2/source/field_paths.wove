(module source_field_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recognize field projections written as one atom of slash-separated identifiers.")

	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte))

	(let field_path_get_head 122u32)

	(struct FieldPathPrefix (fields (end i32) (segments u32)))

	(fn field_path_prefix
		(:doc "Read a binding and complete field names up to the first non-path byte.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns FieldPathPrefix)
		(body
			(if
				(:doc "The binding starts with an ASCII identifier byte.")
				(bool:or (start.not-lt end)
					(bool:not (call is_c_identifier_start (source.get start))))
				(then (return (struct:new FieldPathPrefix (end start) (segments 0u32)))))
			(let-mut cursor start.inc)
			(let-mut segments 0u32)
			(while
				(:doc "Advance through identifier tails and one separator at a time.")
				(cursor.lt end)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "A slash extends the prefix only when a field follows it.")
						(byte.eq 47u8)
						(then
							(set cursor cursor.inc)
							(if
								(:doc "An incomplete field leaves the prefix ending at the slash.")
								(bool:or (cursor.not-lt end)
									(bool:not (call is_c_identifier_start (source.get cursor))))
								(then (set cursor cursor.dec) (break)))
							(set segments segments.inc))
						(else
							(if
								(:doc "A dot or other punctuation ends the path prefix.")
								(bool:not (call is_c_identifier_byte byte))
								(then (break)))))
					(set cursor cursor.inc)))
			(return (struct:new FieldPathPrefix (end cursor) (segments segments)))))

	(fn preceding_field_separator
		(:doc "Find the slash before a field in a previously validated path.")
		(params (source (shared-array u8)) (end i32))
		(returns i32)
		(body
			(let-mut cursor end.dec)
			(while
				(:doc "A validated field has a separator before its first identifier byte.")
				(u8:not-eq (source.get cursor) 47u8)
				(body (set cursor cursor.dec)))
			(return cursor))))
