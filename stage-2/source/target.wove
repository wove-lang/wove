(module source_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Represent the caller's explicit target for source selection.

	Zero denotes an unspecified OS or architecture. Deployment uses
	major * 10000 + minor * 100 + patch, with -1 for unavailable metadata.
	No predicate consults the host running the compiler.`)

	(use wove-file "../c/identifiers.wove" (only (as is_c_identifier is_target_identifier)))
	(use wove-file "../text/match.wove" (only (as is_byte_at byte_at) is_three_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "./scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "./strings.wove" (only decode_string))

	(let library_mode 3u32)

	(struct SelectionContext (fields (mode u32) (os u8) (arch u8) (deployment i32)))

	(fn default_selection
		(:doc `Create a mode-only context for callers without a supplied target.`)
		(params (mode u32))
		(returns SelectionContext)
		(body (return (struct:new SelectionContext
			(mode mode) (os 0u8) (arch 0u8) (deployment -1i32)))))

	(fn target_os
		(:doc `Map canonical target names to OS codes. Linux is 1 and macOS is 2.`)
		(params (bytes (shared-array u8)))
		(returns u8)
		(body
			(if
				(:doc "Neither supported OS has a name longer or shorter than five bytes.")
				(i32:not-eq bytes.len 5i32)
				(then (return 0u8)))
			(if
				(:doc "Match linux exactly.")
				(bool:and (call is_three_bytes (borrow-shared bytes) 0i32 108u8 105u8 110u8)
					(bool:and (call byte_at (borrow-shared bytes) 0i32 3i32 117u8)
						(call byte_at (borrow-shared bytes) 0i32 4i32 120u8)))
				(then (return 1u8)))
			(if
				(:doc "The archived cfg spelling for Darwin is macos.")
				(bool:and (call is_three_bytes (borrow-shared bytes) 0i32 109u8 97u8 99u8)
					(bool:and (call byte_at (borrow-shared bytes) 0i32 3i32 111u8)
						(call byte_at (borrow-shared bytes) 0i32 4i32 115u8)))
				(then (return 2u8)))
			(return 0u8)))

	(fn target_arch
		(:doc `Map canonical architecture names to codes. aarch64 is 1 and x86_64 is 2.`)
		(params (bytes (shared-array u8)))
		(returns u8)
		(body
			(let width bytes.len)
			(if
				(:doc "Match aarch64 including its final digit.")
				(bool:and (i32:eq width 7i32)
					(bool:and (call is_three_bytes (borrow-shared bytes) 0i32 97u8 97u8 114u8)
						(bool:and (call is_three_bytes (borrow-shared bytes) 3i32 99u8 104u8 54u8)
							(call byte_at (borrow-shared bytes) 0i32 6i32 52u8))))
				(then (return 1u8)))
			(if
				(:doc "Match the underscore in the canonical x86_64 spelling.")
				(bool:and (i32:eq width 6i32)
					(bool:and (call is_three_bytes (borrow-shared bytes) 0i32 120u8 56u8 54u8)
						(call is_three_bytes (borrow-shared bytes) 3i32 95u8 54u8 52u8)))
				(then (return 2u8)))
			(return 0u8)))

	(fn cfg_target_name
		(:doc `Decode an OS or architecture operand. Return -1 for malformed syntax and zero for other names.`)
		(params (source (shared-array u8)) (node SourceNode) (architecture bool))
		(returns i32)
		(body
			(if
				(:doc "Platform names are string operands.")
				(u32:not-eq (struct:get node kind) 2u32)
				(then (return -1i32)))
			(let start (struct:get node start))
			(let end (struct:get node end))
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let result (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(if
				(:doc "A rejected escape has no decoded name to compare.")
				(u32:gtz (struct:get result error))
				(then (return -1i32)))
			(let written (struct:get result written))
			(if
				(:doc "The archive requires a nonempty ASCII identifier inside the target string.")
				(bool:not (call is_target_identifier (borrow-shared decoded) 0i32 written))
				(then (return -1i32)))
			(if
				(:doc "Architecture codes are independent of operating system codes.")
				architecture
				(then (return (i32:from-u8 (call target_arch
					(borrow-shared (decoded.range 0i32 written)))))))
			(return (i32:from-u8 (call target_os
				(borrow-shared (decoded.range 0i32 written)))))))

	(fn cfg_deployment_limit
		(:doc `Read the archive's nonnegative i32 deployment limit, or return -1 for a malformed operand.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns i32)
		(body
			(if
				(:doc "A deployment limit is an unquoted decimal atom.")
				(u32:not-eq (struct:get node kind) 1u32)
				(then (return -1i32)))
			(let read (call read_decimal_digits (borrow-shared source)
				(struct:get node start) (struct:get node end) 214748364u32 7u32))
			(if
				(:doc "Reject invalid digits and values above INT32_MAX.")
				(i32:ltz (struct:get read digits))
				(then (return -1i32)))
			(return (i32:from-u32 (struct:get read magnitude))))))
