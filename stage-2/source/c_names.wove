(module source_c_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the Wove name and optional native symbol of a bodyless C bridge function.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata (type FormParts)))
	(use wove-file "./imports.wove" (only is_import_name))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier))
	(use wove-file "./functions.wove" (only collect_function_fields (type FunctionFields)))

	(struct CFunctionOpening (fields (symbol i32) (params i32) (result i32) (start i32) (end i32) (error u32)))
	(fn c_opening_at
		(:doc "Keep an original error span or the checked symbol and signature rows.")
		(params (node SourceNode) (symbol i32) (fields FunctionFields) (error u32)) (returns CFunctionOpening)
		(body (return (struct:new CFunctionOpening (symbol symbol)
			(params fields/params) (result fields/result)
			(start node/start) (end node/end) (error error)))))

	(fn native_symbol_start
		(:doc "The native identifier starts inside the quotes when the declaration uses c-name.")
		(params (node SourceNode)) (returns i32)
		(body
			(if (node/kind.eq 2u32)
				(then (return node/start.inc)))
			(return node/start)))

	(fn native_symbol_end
		(:doc "Exclude the closing quote from explicit native identifiers.")
		(params (node SourceNode)) (returns i32)
		(body
			(if (node/kind.eq 2u32)
				(then (return node/end.dec)))
			(return node/end)))

	(fn c_function_opening
		(:doc "Read a bodyless signature and its optional explicit native symbol.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts))
		(returns CFunctionOpening)
		(body
			(let name_index function/name)
			(let name (nodes.get name_index))
			(let fields (call collect_function_fields (borrow-shared source) (borrow-shared nodes)
				function/operands (bool true)))
			(let error fields/error)
			(if
				(:doc "Keep a repeated or unexpected field on its original source row.")
				error.gtz
				(then (return (call c_opening_at (nodes.get fields/site)
					-1i32 fields error))))
			(let target fields/target)
			(if
				(:doc "An explicit target separates the Wove identifier from its native spelling.")
				(i32:lt -1i32 target)
				(then
					(let field (nodes.get target))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) field))
					(return (call checked_c_name (borrow-shared source) (borrow-shared nodes)
						name field parts fields))))
			(if (call is_native_name (borrow-shared source) name)
				(then (return (call c_opening_at name name_index fields 0u32))))
			(return (call c_opening_at name -1i32 fields 26u32))))

	(fn checked_c_name
		(:doc "Accept one quoted, unescaped C identifier and preserve the diagnostic on an invalid field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode)
			(field SourceNode) (parts FormParts) (fields FunctionFields)) (returns CFunctionOpening)
		(body
			(if (bool:not (call is_import_name (borrow-shared source) name))
				(then (return (call c_opening_at name -1i32 fields 26u32))))
			(let selected (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) field parts))
			(if
				(:doc "A native name field is not a declaration and cannot have selection pragmas.")
				selected/error.gtz
				(then (return (struct:new CFunctionOpening (symbol -1i32) (params -1i32) (result -1i32)
					(start selected/start) (end selected/end)
					(error selected/error)))))
			(let target parts/operands)
			(if target.ltz
				(then (return (call c_opening_at field -1i32 fields 23u32))))
			(let symbol (nodes.get target))
			(if
				(:doc "The native lexer and emitter share one exact C identifier range.")
				(bool:not (bool:and (symbol/kind.eq 2u32)
					(call is_c_identifier (borrow-shared source)
						(call native_symbol_start symbol) (call native_symbol_end symbol))))
				(then (return (call c_opening_at symbol -1i32 fields 26u32))))
			(let extra symbol/next_sibling)
			(if (i32:lt -1i32 extra)
				(then (return (call c_opening_at (nodes.get extra) -1i32 fields 23u32))))
			(return (call c_opening_at symbol target fields 0u32)))))
