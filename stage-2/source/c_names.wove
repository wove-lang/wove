(module source_c_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the Wove name and optional native symbol of a bodyless C bridge function.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata (type FormParts)))
	(use wove-file "./imports.wove" (only is_import_name))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier))
	(use wove-file "./functions.wove" (only collect_function_fields (type FunctionFields)))

	(struct CFunctionOpening (fields (symbol i32) (params i32) (result i32) (start i32) (end i32) (error u32)))
	(fn c_opening_at
		(:doc "Keep an original error span or the checked symbol and signature rows.")
		(params (node SourceNode) (symbol i32) (fields FunctionFields) (error u32)) (returns CFunctionOpening)
		(body (return (struct.new CFunctionOpening (symbol (local symbol))
			(params (struct.get (local fields) params)) (result (struct.get (local fields) result))
			(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error (local error))))))

	(fn native_symbol_start
		(:doc "The native identifier starts inside the quotes when the declaration uses c-name.")
		(params (node SourceNode)) (returns i32)
		(body
			(if (u32.eq (struct.get (local node) kind) 2u32)
				(then (return (i32.add (struct.get (local node) start) 1i32))))
			(return (struct.get (local node) start))))

	(fn native_symbol_end
		(:doc "Exclude the closing quote from explicit native identifiers.")
		(params (node SourceNode)) (returns i32)
		(body
			(if (u32.eq (struct.get (local node) kind) 2u32)
				(then (return (i32.sub (struct.get (local node) end) 1i32))))
			(return (struct.get (local node) end))))

	(fn c_function_opening
		(:doc "Read a bodyless signature and its optional explicit native symbol.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts))
		(returns CFunctionOpening)
		(body
			(let name_index (struct.get (local function) name))
			(let name (array.load (local nodes) (local name_index)))
			(let fields (call collect_function_fields (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local function) operands) (bool true)))
			(let error (struct.get (local fields) error))
			(if
				(:doc "Keep a repeated or unexpected field on its original source row.")
				(u32.gtz (local error))
				(then (return (call c_opening_at (array.load (local nodes) (struct.get (local fields) site))
					-1i32 (local fields) (local error)))))
			(let target (struct.get (local fields) target))
			(if
				(:doc "An explicit target separates the Wove identifier from its native spelling.")
				(i32.lt -1i32 (local target))
				(then
					(let field (array.load (local nodes) (local target)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local field)))
					(return (call checked_c_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local name) (local field) (local parts) (local fields)))))
			(if (call is_native_name (borrow-shared (local source)) (local name))
				(then (return (call c_opening_at (local name) (local name_index) (local fields) 0u32))))
			(return (call c_opening_at (local name) -1i32 (local fields) 26u32))))

	(fn checked_c_name
		(:doc "Accept one quoted, unescaped C identifier and preserve the diagnostic on an invalid field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode)
			(field SourceNode) (parts FormParts) (fields FunctionFields)) (returns CFunctionOpening)
		(body
			(if (bool.not (call is_import_name (borrow-shared (local source)) (local name)))
				(then (return (call c_opening_at (local name) -1i32 (local fields) 26u32))))
			(let selected (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local field) (local parts)))
			(if
				(:doc "A native name field is not a declaration and cannot have selection pragmas.")
				(u32.gtz (struct.get (local selected) error))
				(then (return (struct.new CFunctionOpening (symbol -1i32) (params -1i32) (result -1i32)
					(start (struct.get (local selected) start)) (end (struct.get (local selected) end))
					(error (struct.get (local selected) error))))))
			(let target (struct.get (local parts) operands))
			(if (i32.ltz (local target))
				(then (return (call c_opening_at (local field) -1i32 (local fields) 23u32))))
			(let symbol (array.load (local nodes) (local target)))
			(if
				(:doc "The native lexer and emitter share one exact C identifier range.")
				(bool.not (bool.and (u32.eq (struct.get (local symbol) kind) 2u32)
					(call is_c_identifier (borrow-shared (local source))
						(call native_symbol_start (local symbol)) (call native_symbol_end (local symbol)))))
				(then (return (call c_opening_at (local symbol) -1i32 (local fields) 26u32))))
			(let extra (struct.get (local symbol) next_sibling))
			(if (i32.lt -1i32 (local extra))
				(then (return (call c_opening_at (array.load (local nodes) (local extra)) -1i32 (local fields) 23u32))))
			(return (call c_opening_at (local symbol) (local target) (local fields) 0u32)))))
