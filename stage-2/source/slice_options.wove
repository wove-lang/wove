(module source_slice_options
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Identify fallible exact slice operations and their local-only optional descriptor.

	The constructor's checked receiver records the exact element type.
	The option stays in its original immutable binding until scope exit.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let optional_view_type 29u32)
	(let try_slice_kind 612u32)
	(let optional_view_absent 613u32)
	(let optional_view_unwrap 614u32)
	(let try_slice_head "array.try-slice")
	(let optional_absent_head "optional.is-none")

	(fn slice_option_keyword
		(:doc "Match the exact fallible slice constructor and presence-test spellings.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns u32)
		(body
			(if
				(:doc "An exact window checks an offset against a compile-time extent.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared try_slice_head) 0i32 (array.len try_slice_head))
				(then (return try_slice_kind)))
			(if
				(:doc "The presence test recognizes the optional descriptor without extracting it.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared optional_absent_head) 0i32 (array.len optional_absent_head))
				(then (return optional_view_absent)))
			(return 0u32)))
)
