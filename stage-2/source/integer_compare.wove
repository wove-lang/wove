(module source_integer_compare
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize exact integer predicates and recover their comparison shape.`)

	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))

	(let comparison_base 1024u32)
	(let comparison_limit 3072u32)
	(let zero_flag 8u32)
	(let negated_flag 16u32)
	(let comparison_symbols "=<L>G")

	(fn comparison_predicate
		(:doc `Map a checked two-byte predicate spelling to its C operator slot.`)
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let first (array.load (local source) (local start)))
			(let second (array.load (local source) (i32.add (local start) 1i32)))
			(if (bool.and (u8.eq (local first) 101u8) (u8.eq (local second) 113u8)) (then (return 0i32)))
			(if
				(:doc "The t suffix selects strict ordering.")
				(u8.eq (local second) 116u8)
				(then
					(if (u8.eq (local first) 108u8) (then (return 1i32)))
					(if (u8.eq (local first) 103u8) (then (return 3i32)))))
			(if
				(:doc "The e suffix selects inclusive ordering.")
				(u8.eq (local second) 101u8)
				(then
					(if (u8.eq (local first) 108u8) (then (return 2i32)))
					(if (u8.eq (local first) 103u8) (then (return 4i32)))))
			(return -1i32)))

	(fn integer_comparison_keyword
		(:doc `Read T.predicate or T.not-predicate, optionally ending in z.

		The opcode carries the exact built-in type above the five predicate and
		modifier bits. Type zero marks int.eq and int.not-eq, which name the
		integer type in their first argument.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (i32.sub (local end) (local start)))
			(if (bool.or (i32.lt (local width) 5i32) (i32.lt 11i32 (local width))) (then (return 0u32)))
			(let-mut prefix 3i32)
			(if
				(:doc "Byte integers have a two-letter type before the dot.")
				(call is_byte_at (borrow-shared (local source)) (local start) 2i32 46u8)
				(then (set (local prefix) 2i32)))
			(if
				(:doc "Require the exact separator between the type and predicate.")
				(bool.not (call is_byte_at (borrow-shared (local source)) (local start) (local prefix) 46u8))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local prefix)))
			(let explicit_type (bool.and (i32.eq (local prefix) 3i32)
				(call is_three_bytes (borrow-shared (local source)) (local start) 105u8 110u8 116u8)))
			(if (bool.not (bool.or (local explicit_type) (call is_builtin_integer (local type)))) (then (return 0u32)))
			(let-mut suffix (i32.add (local start) (i32.add (local prefix) 1i32)))
			(let-mut flags 0u32)
			(if
				(:doc "Strip the optional not- prefix so both spellings use the same predicate lookup.")
				(bool.and (i32.lt 5i32 (i32.sub (local end) (local suffix)))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local suffix) 110u8 111u8 116u8)
						(call is_byte_at (borrow-shared (local source)) (local suffix) 3i32 45u8)))
				(then
					(set (local suffix) (i32.add (local suffix) 4i32))
					(set (local flags) (local negated_flag))))
			(let length (i32.sub (local end) (local suffix)))
			(if
				(:doc "Only a final z gives a comparison its implicit zero operand.")
				(i32.not-eq (local length) 2i32)
				(then
					(if
						(:doc "Reject a suffix whose remaining bytes cannot spell a predicate.")
						(bool.not (bool.and (i32.eq (local length) 3i32)
							(call is_byte_at (borrow-shared (local source)) (local suffix) 2i32 122u8)))
						(then (return 0u32)))
					(set (local flags) (u32.or (local flags) (local zero_flag)))))
			(let predicate (call comparison_predicate (borrow-shared (local source)) (local suffix)))
			(if
				(:doc "The explicit-type family supplies binary equality, including its negation.")
				(bool.or (i32.lt (local predicate) 0i32)
					(bool.and (local explicit_type) (bool.or (i32.not-eq (local predicate) 0i32)
						(i32.not-eq (local length) 2i32))))
				(then (return 0u32)))
			(return (u32.add (local comparison_base) (u32.or
				(u32.shl (local type) 5i32) (u32.or (local flags) (u32.from-i32 (local predicate))))))))

	(fn is_integer_comparison
		(:doc `Identify opcodes in the reserved integer comparison range.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local comparison_base))
			(u32.lt (local kind) (local comparison_limit))))))

	(fn comparison_operand_type
		(:doc `Recover the exact type from a checked integer comparison opcode.`)
		(params (kind u32))
		(returns u32)
		(body (return (u32.shr (u32.sub (local kind) (local comparison_base)) 5i32))))

	(fn is_explicit_integer_equality
		(:doc `Identify the equality forms that take a written type before their values.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local comparison_base))
			(u32.eq (local kind) (u32.add (local comparison_base) (local negated_flag)))))))

	(fn comparison_is_zero
		(:doc `Check whether the right operand is implicit zero.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_comparison (local kind))
			(u32.eq (u32.and (local kind) (local zero_flag)) (local zero_flag))))))

	(fn comparison_is_negated
		(:doc `Check whether boolean negation follows the comparison.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (call is_integer_comparison (local kind))
			(u32.eq (u32.and (local kind) (local negated_flag)) (local negated_flag))))))

	(fn comparison_symbol
		(:doc `Select the C comparison marker from a checked opcode. L and G denote inclusive comparisons.`)
		(params (kind u32))
		(returns u8)
		(body (return (array.load (local comparison_symbols) (i32.from-u32 (u32.and (local kind) 7u32)))))))
