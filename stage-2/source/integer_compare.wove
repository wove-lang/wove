(module source_integer_compare
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize exact integer predicates and recover their comparison shape.`)

	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer_value numeric_prefix_width integer_operator_slot integer_operator_type))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))

	(let comparison_base 1024u32)
	(let comparison_limit 3072u32)
	(let zero_flag 8u32)
	(let negated_flag 16u32)
	(let comparison_symbols "=<L>G")

	(fn comparison_predicate
		(:doc `Map a checked two-byte predicate spelling to its C operator slot.`)
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let first (source.get start))
			(let second (source.get start.inc))
			(if (bool:and (first.eq 101u8) (second.eq 113u8)) (then (return 0i32)))
			(if
				(:doc "The t suffix selects strict ordering.")
				(second.eq 116u8)
				(then
					(if (first.eq 108u8) (then (return 1i32)))
					(if (first.eq 103u8) (then (return 3i32)))))
			(if
				(:doc "The e suffix selects inclusive ordering.")
				(second.eq 101u8)
				(then
					(if (first.eq 108u8) (then (return 2i32)))
					(if (first.eq 103u8) (then (return 4i32)))))
			(return -1i32)))

	(fn integer_comparison_keyword
		(:doc `Read T.predicate or T.not-predicate, optionally ending in z.

		The opcode carries a compact integer type above the five predicate and
		modifier bits. Type zero marks int:eq and int:not-eq, which name the
		integer type in their first argument.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (end.sub start))
			(if (bool:or (width.lt 5i32) (i32:lt 12i32 width)) (then (return 0u32)))
			(let prefix (call numeric_prefix_width (borrow-shared source) start end))
			(if prefix.eqz (then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared source) start prefix))
			(let explicit_type (bool:and (prefix.eq 3i32)
				(call is_three_bytes (borrow-shared source) start 105u8 110u8 116u8)))
			(if (bool:not (explicit_type.or (call is_builtin_integer_value type))) (then (return 0u32)))
			(return (call integer_comparison_operation (borrow-shared source)
				(start.add prefix.inc) end type explicit_type))))

	(fn integer_comparison_operation
		(:doc "Select the canonical comparison for an exact type and suffix.")
		(params (source (shared-array u8)) (start i32) (end i32) (type u32) (explicit_type bool))
		(returns u32)
		(body
			(let-mut suffix start)
			(let-mut flags 0u32)
			(if
				(:doc "Strip the optional not- prefix so both spellings use the same predicate lookup.")
				(bool:and (i32:lt 5i32 (end.sub suffix))
					(bool:and (call is_three_bytes (borrow-shared source) suffix 110u8 111u8 116u8)
						(call is_byte_at (borrow-shared source) suffix 3i32 45u8)))
				(then
					(set suffix (suffix.add 4i32))
					(set flags negated_flag)))
			(let length (end.sub suffix))
			(if
				(:doc "Only a final z gives a comparison its implicit zero operand.")
				(length.not-eq 2i32)
				(then
					(if
						(:doc "Reject a suffix whose remaining bytes cannot spell a predicate.")
						(bool:not (bool:and (length.eq 3i32)
							(call is_byte_at (borrow-shared source) suffix 2i32 122u8)))
						(then (return 0u32)))
					(set flags (flags.or zero_flag))))
			(let predicate (call comparison_predicate (borrow-shared source) suffix))
			(if
				(:doc "The explicit-type family supplies binary equality, including its negation.")
				(predicate.ltz.or
					(explicit_type.and (predicate.not-eqz.or
						(length.not-eq 2i32))))
				(then (return 0u32)))
			(return (comparison_base.add (u32:or
				(u32:shl (call integer_operator_slot type) 5i32) (flags.or (u32:from-i32 predicate)))))))

	(fn is_integer_comparison
		(:doc `Identify opcodes in the reserved integer comparison range.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:and (kind.not-lt comparison_base)
			(kind.lt comparison_limit)))))

	(fn comparison_operand_type
		(:doc `Recover the exact type from a checked integer comparison opcode.`)
		(params (kind u32))
		(returns u32)
		(body (return (call integer_operator_type (u32:shr (kind.sub comparison_base) 5i32)))))

	(fn is_explicit_integer_equality
		(:doc `Identify the equality forms that take a written type before their values.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq comparison_base)
			(kind.eq (comparison_base.add negated_flag))))))

	(fn comparison_is_zero
		(:doc `Check whether the right operand is implicit zero.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:and (call is_integer_comparison kind)
			(u32:eq (kind.and zero_flag) zero_flag)))))

	(fn comparison_is_negated
		(:doc `Check whether boolean negation follows the comparison.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:and (call is_integer_comparison kind)
			(u32:eq (kind.and negated_flag) negated_flag)))))

	(fn comparison_symbol
		(:doc `Select the C comparison marker from a checked opcode. L and G denote inclusive comparisons.`)
		(params (kind u32))
		(returns u8)
		(body (return (comparison_symbols.get (i32:from-u32 (kind.and 7u32)))))))
