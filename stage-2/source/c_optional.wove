(module source_c_optional
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read the availability marker on a selected C bridge function.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_arguments.wove" (only matches_pragma))

	(struct OptionalFunction (fields (present bool) (start i32) (end i32) (error u32)))
	(let optional_pragma "c_optional")

	(fn read_c_optional
		(:doc "Recognize one zero-argument marker among the function's attached pragma entries.")
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function FormParts))
		(returns OptionalFunction)
		(body
			(let-mut present (bool false))
			(let-mut index (record.get (local function) metadata))
			(while
				(:doc "Function metadata may appear between fields or after the signature.")
				(i32.lt -1i32 (local index))
				(body
					(let entry (slice.load (local nodes) (local index)))
					(let head (slice.load (local nodes) (record.get (local entry) first_child)))
					(if
						(:doc "Only pragma entries can mark native availability.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local entry)))
							(let-mut directive (record.get (local parts) operands))
							(while
								(:doc "Find the exact marker while leaving other contracts to their own readers.")
								(i32.lt -1i32 (local directive))
								(body
									(let item (slice.load (local nodes) (local directive)))
									(let form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
									(let tag (record.get (local form) head))
									(if
										(:doc "The availability marker is a named pragma form.")
										(bool.and (i32.lt -1i32 (local tag))
											(call matches_pragma (borrow-shared (local source))
												(slice.load (local nodes) (local tag)) (borrow-shared (local optional_pragma))))
										(then
											(if
												(:doc "An argument or a repeated marker is diagnosed at its own form.")
												(bool.or (local present) (i32.lt -1i32 (record.get (local form) operands)))
												(then (return (record.make OptionalFunction (present (bool false))
													(start (record.get (local item) start)) (end (record.get (local item) end)) (error 23u32)))))
											(set (local present) (bool true))))
									(set (local directive) (record.get (local item) next_sibling))))))
					(set (local index) (call next_form_metadata (borrow-shared (local source))
						(borrow-shared (local nodes)) (local function) (local entry)))))
			(return (record.make OptionalFunction (present (local present)) (start 0i32) (end 0i32) (error 0u32))))))
