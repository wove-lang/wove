(module source_c_record_out
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read the caller-backed record contract on a C function declaration.")

	(use wove-file "./scan.wove" (only is_wove_name (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_markers.wove" (only matches_pragma))

	(struct CRecordOut (fields (scratch i32) (status i32) (start i32) (end i32) (error u32)))
	(let record_out_word "c_record_out")

	(fn c_record_out_at
		(:doc "Retain the contract operands or the directive span of a malformed declaration.")
		(params (node SourceNode) (scratch i32) (status i32) (error u32)) (returns CRecordOut)
		(body (return (struct:new CRecordOut (scratch scratch) (status status)
			(start node/start) (end node/end) (error error)))))

	(fn read_record_out_directive
		(:doc "A record-out contract names a byte view and a separate native status place.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(first i32)) (returns CRecordOut)
		(body
			(if first.ltz (then (return (call c_record_out_at node -1i32 -1i32 23u32))))
			(let buffer (nodes.get first))
			(let status buffer/next_sibling)
			(if
				(:doc "Both operands must be bare names of ordinary formals.")
				(bool:or (bool:not (call is_wove_name (borrow-shared source) buffer))
					(bool:or status.ltz
						(bool:or (bool:not (call is_wove_name (borrow-shared source) (nodes.get status)))
							(i32:not-ltz (struct:get (nodes.get status) next_sibling)))))
				(then (return (call c_record_out_at node -1i32 -1i32 23u32))))
			(return (call c_record_out_at node first status 0u32))))

	(fn read_c_record_out
		(:doc "Find at most one record-out contract in the attached pragmas.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts))
		(returns CRecordOut)
		(body
			(let-mut entry function/metadata)
			(let-mut scratch -1i32)
			(let-mut status -1i32)
			(let-mut site -1i32)
			(while
				(:doc "Keep interleaved metadata in its original order.")
				entry.not-ltz
				(body
					(let node (nodes.get entry))
					(let head (nodes.get node/first_child))
					(if
						(:doc "Only an attached pragma can contain a caller-backed record contract.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
							(let-mut directive parts/operands)
							(while
								(:doc "Leave the other C call adaptations to their own readers.")
								directive.not-ltz
								(body
									(let item (nodes.get directive))
									(let form (call form_parts (borrow-shared source) (borrow-shared nodes) item))
									(let tag form/head)
									(if
										(:doc "Report a repeated contract at the second directive.")
										(bool:and tag.not-ltz (call matches_pragma (borrow-shared source)
											(nodes.get tag) (borrow-shared record_out_word)))
										(then
											(if
												(:doc "A function declaration can adapt only one native out slot.")
												scratch.not-ltz
												(then (return (call c_record_out_at item -1i32 -1i32 23u32))))
											(let checked (call read_record_out_directive (borrow-shared source)
												(borrow-shared nodes) item form/operands))
											(if checked/error.gtz (then (return checked)))
											(set scratch checked/scratch)
											(set status checked/status)
											(set site directive)))
									(set directive item/next_sibling)))))
					(set entry (call next_form_metadata (borrow-shared source) (borrow-shared nodes) function node))))
			(if
				(:doc "An absent marker has no source directive.")
				site.ltz
				(then (return (struct:new CRecordOut (scratch -1i32) (status -1i32)
					(start 0i32) (end 0i32) (error 0u32)))))
			(return (call c_record_out_at (nodes.get site) scratch status 0u32))))
)
