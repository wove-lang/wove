(module source_c_scope
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Link C bridge overlays in a compilation tree while preserving the original declarations and source spans.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts source_keyword (type FormParts)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct BridgePolicy (fields (replace bool) (site i32)))
	(let replace_name "bridge_replace")

	(fn with_bridge_peer
		(:doc "Keep the original tree links and store the resolved pair on a bridge form.")
		(params (node SourceNode) (project i32) (bundled i32)) (returns SourceNode)
		(body (return (struct:new SourceNode (kind node/kind)
			(start node/start) (end node/end)
			(parent node/parent) (first_child node/first_child)
			(next_sibling node/next_sibling) (bridge_project project) (bridge_default bundled)
			(generic_kind node/generic_kind) (generic_value node/generic_value)
			(c_ordinal node/c_ordinal)))))

	(fn connect_bridge_overlay
		(:doc "Both original bridge forms resolve names through the same project-first pair.")
		(params (nodes (mut-array SourceNode)) (project i32) (bundled i32)) (returns void)
		(body
			(let primary (nodes.get project))
			(let inherited (nodes.get bundled))
			(nodes.set project (call with_bridge_peer primary project bundled))
			(nodes.set bundled (call with_bridge_peer inherited project bundled))))

	(fn project_bridge
		(:doc "Use the original bridge row as the namespace unless it belongs to a connected overlay.")
		(params (nodes (shared-array SourceNode)) (bridge i32)) (returns i32)
		(body
			(let project (struct:get (nodes.get bridge) bridge_project))
			(if (i32:lt -1i32 project) (then (return project)))
			(return bridge)))

	(fn declaring_c_bridge
		(:doc "Find the bridge owning a direct member or a member inside a declaration group.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (member SourceNode)) (returns i32)
		(body
			(let-mut row member/parent)
			(while
				(:doc "Source parents remain in the defining file even when the namespace spans two files.")
				(i32:lt -1i32 row)
				(body
					(let node (nodes.get row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(if (i32:lt -1i32 parts/header) (then (return row)))
					(set row node/parent)))
			(return -1i32)))

	(fn is_bridge_replace
		(:doc "Match the exact operand-form tag for a whole-header replacement.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts)) (returns bool)
		(body
			(let head parts/head)
			(if head.ltz (then (return (bool false))))
			(let name (nodes.get head))
			(return (call same_bytes (borrow-shared source) name/start name/end
				(borrow-shared replace_name) 0i32 replace_name.len))))

	(fn read_bridge_policy
		(:doc "Require a single argument-free bridge_replace on a system header and retain a malformed directive row.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge FormParts) (system bool))
		(returns BridgePolicy)
		(body
			(let-mut seen (bool false))
			(let-mut index bridge/metadata)
			(let end bridge/operands)
			(while
				(:doc "Only the metadata prefix on this active bridge affects its policy.")
				(bool:and (i32:lt -1i32 index) (index.not-eq end))
				(body
					(let entry (nodes.get index))
					(let head (nodes.get entry/first_child))
					(if
						(:doc "Only pragma entries contain bridge directives.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let pragma (call form_parts (borrow-shared source) (borrow-shared nodes) entry))
							(let-mut directive pragma/operands)
							(while
								(:doc "Other directives keep their own selection or ABI behavior.")
								(i32:lt -1i32 directive)
								(body
									(let item (nodes.get directive))
									(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
									(if
										(:doc "A replacement needs only the marker and has no meaning on project-local headers.")
										(call is_bridge_replace (borrow-shared source) (borrow-shared nodes) parts)
										(then
											(if
												(:doc "Point at the malformed or repeated marker.")
												(bool:or (seen.or system.not)
													(i32:lt -1i32 parts/operands))
												(then (return (struct:new BridgePolicy (replace (bool false)) (site directive)))))
											(set seen (bool true))))
									(set directive item/next_sibling)))))
					(set index entry/next_sibling)))
			(return (struct:new BridgePolicy (replace seen) (site -1i32)))))
)
