(module source_c_record_in
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read the explicit native call contract that lends a bounded view through a record.")

	(use wove-file "./scan.wove" (only is_wove_name (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_markers.wove" (only matches_pragma))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "../scalar/syntax.wove" (only entry_at (type EntryRead)))

	(let record_in_word "c_record_in")

	(fn read_record_in_operands
		(:doc "Check the two Wove parameter names followed by the exact C field names.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (site SourceNode)
			(first i32)) (returns EntryRead)
		(body
			(let-mut operand first)
			(let-mut position 0i32)
			(while
				(:doc "Each of the first two names selects an ordinary formal. Each remaining name selects a C member.")
				(i32:lt position 4i32)
				(body
					(if (i32:ltz operand) (then (return (call entry_at site -1i32 23u32))))
					(let node (array:get nodes operand))
					(if
						(:doc "A record mapping cannot use expressions or indirect field paths as names.")
						(bool:not
							(bool:or (bool:and (i32:lt position 2i32) (call is_wove_name (borrow-shared source) node))
								(bool:and (i32:not-lt position 2i32) (call is_native_name (borrow-shared source) node))))
						(then (return (call entry_at node -1i32 23u32))))
					(set operand (struct:get node next_sibling))
					(set position (i32:inc position))))
			(if (i32:not-ltz operand) (then (return (call entry_at site -1i32 23u32))))
			(return (call entry_at site first 0u32))))

	(fn read_c_record_in
		(:doc "Find the one bounded record-input mapping in the function's attached pragmas.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts)
			(declaration SourceNode)) (returns EntryRead)
		(body
			(let-mut entry (struct:get function metadata))
			(let-mut found -1i32)
			(let-mut site -1i32)
			(while
				(:doc "Ignore unrelated metadata while preserving its placement in the signature.")
				(i32:not-ltz entry)
				(body
					(let node (array:get nodes entry))
					(let head (array:get nodes (struct:get node first_child)))
					(if
						(:doc "A record-input mapping is a C adaptation inside a pragma.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
							(let-mut directive (struct:get parts operands))
							(while
								(:doc "Other directives are resolved by the existing C argument reader.")
								(i32:not-ltz directive)
								(body
									(let item (array:get nodes directive))
									(let form (call form_parts (borrow-shared source) (borrow-shared nodes) item))
									(let tag (struct:get form head))
									(if
										(:doc "The second record-input mapping is an error at its own span.")
										(bool:and (i32:not-ltz tag) (call matches_pragma (borrow-shared source)
											(array:get nodes tag) (borrow-shared record_in_word)))
										(then
											(if (i32:not-ltz found) (then (return (call entry_at item -1i32 23u32))))
											(let checked (call read_record_in_operands (borrow-shared source) (borrow-shared nodes)
												item (struct:get form operands)))
											(if (u32:gtz (struct:get checked error)) (then (return checked)))
											(set found (struct:get checked operand))
											(set site directive)))
									(set directive (struct:get item next_sibling))))))
					(set entry (call next_form_metadata (borrow-shared source) (borrow-shared nodes) function node))))
			(if (i32:ltz site) (then (return (call entry_at declaration -1i32 0u32))))
			(return (call entry_at (array:get nodes site) found 0u32))))
)
