(module source_module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read module declarations from the checked source tree.

	Expose metadata and ordinary operands through the original node links.
	Apply the compilation mode and flatten selected declaration groups in
	source order. Mode 0 is native, mode 1 is bootstrap, and mode 2 is test.
	Keep each declaration's original node index and direct test marker.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./scan.wove"
		(only is_wove_name is_metadata_form is_disabled_form form_name_mode second_form_name first_ordinary_child read_c_bridge_opening (type SourceNode) (type FormCheck)))

	(use wove-file "./target.wove" (only default_selection cfg_target_name cfg_deployment_limit (type SelectionContext)))

	(struct FormParts (fields (head i32) (metadata i32) (operands i32) (name i32) (second_name i32) (header i32)))
	(struct SelectedDeclaration (fields (node i32) (test bool)))
	(struct ModuleRead
		(fields (name i32) (count i32) (active bool) (start i32) (end i32) (error u32) (mode u32)))
	(struct Selection (fields (active bool) (start i32) (end i32) (error u32) (test bool)))

	(fn find_metadata
		(:doc "Find the next metadata sibling, skipping ordinary operands of named forms.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (interleaved bool))
		(returns i32)
		(body
			(let-mut index first)
			(while
				(:doc "Follow the original sibling links until the next attached metadata entry.")
				(i32:lt -1i32 index)
				(body
					(let entry (nodes.get index))
					(if
						(:doc "All metadata entries are direct children of the owning form.")
						(call is_metadata_form (borrow-shared source) (borrow-shared nodes) entry)
						(then (return index)))
					(if
						(:doc "For other forms the first ordinary field ends the prefix.")
						interleaved.not
						(then (return -1i32)))
					(set index entry/next_sibling)))
			(return -1i32)))

	(fn next_form_metadata
		(:doc "Advance an attached metadata entry in its original source order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts) (entry SourceNode))
		(returns i32)
		(body
			(let interleaved (i32:not-ltz parts/name))
			(return (call find_metadata (borrow-shared source) (borrow-shared nodes)
				entry/next_sibling interleaved))))

	(fn next_form_operand
		(:doc "Continue through a named form's payload without consuming attached metadata.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (operand SourceNode))
		(returns i32)
		(body (return (call first_ordinary_child (borrow-shared source) (borrow-shared nodes) operand))))

	(fn form_parts
		(:doc `Expose a checked form's name, first metadata entry, and first ordinary operand.

		Each field is an original row index or -1. A named form separates its
		names from its payload. Indexed iteration can introduce a second name.
		C bridges have a header slot. Named forms permit interleaved metadata.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns FormParts)
		(body
			(if
				(:doc "Nodes without a form head have no name, metadata, or operand view.")
				(u32:not-eq node/kind 40u32)
				(then (return (struct:new FormParts (head -1i32) (metadata -1i32)
					(operands -1i32) (name -1i32) (second_name -1i32) (header -1i32)))))
			(let head node/first_child)
			(let tag (nodes.get head))
			(let mode (call form_name_mode (borrow-shared source) (borrow-shared nodes) node tag))
			(let-mut cursor tag/next_sibling)
			(let-mut name -1i32)
			(if
				(:doc "A declared name occupies the first slot before metadata.")
				(bool:and mode.gtz cursor.not-ltz)
				(then
					(set name cursor)
					(set cursor (struct:get (nodes.get name) next_sibling))))
			(let second_name (call second_form_name (borrow-shared source) (borrow-shared nodes) mode cursor))
			(if
				(:doc "The optional indexed name is part of the opening rather than the payload.")
				second_name.not-ltz
				(then (set cursor (struct:get (nodes.get second_name) next_sibling))))
			(let opening (call read_c_bridge_opening (borrow-shared source) (borrow-shared nodes) node tag))
			(let header opening/header)
			(if
				(:doc "Expose bridge metadata and members after both fixed opening slots.")
				(i32:lt -1i32 header)
				(then (set cursor (struct:get (nodes.get header) next_sibling))))
			(let-mut metadata -1i32)
			(let first cursor)
			(while
				(:doc "The contiguous run of colon-tagged siblings is the metadata range.")
				(bool:and cursor.not-ltz
					(call is_metadata_form (borrow-shared source) (borrow-shared nodes)
						(nodes.get cursor)))
				(body
					(set metadata first)
					(set cursor (struct:get (nodes.get cursor) next_sibling))))
			(if
				(:doc "If no metadata precedes the payload, look among the other siblings of a named form.")
				(bool:and metadata.ltz
					mode.gtz)
				(then (set metadata (call find_metadata (borrow-shared source) (borrow-shared nodes)
					cursor (bool true)))))
			(return (struct:new FormParts (head head) (metadata metadata)
				(operands cursor) (name name) (second_name second_name) (header header)))))

	(fn source_keyword
		(:doc `Match the exact atom spellings used by module selection.

		Return 1 for module, 2 for decls, 3 for :pragma, 4 for cfg, 5 for test,
		6 for not, 7 for bootstrap, and 0 for every other node.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Quoted spellings and forms are not keyword atoms.")
				(u32:not-eq node/kind 1u32)
				(then (return 0u32)))
			(let start node/start)
			(let width (i32:sub node/end start))
			(if
				(:doc "Both cfg and not contain exactly three bytes.")
				(width.eq 3i32)
				(then
					(if
						(:doc "Identify a cfg selection directive.")
						(call is_three_bytes (borrow-shared source) start 99u8 102u8 103u8)
						(then (return 4u32)))
					(if
						(:doc "Identify the compound predicate operator not.")
						(call is_three_bytes (borrow-shared source) start 110u8 111u8 116u8)
						(then (return 6u32)))))
			(if
				(:doc "The checked width allows the final byte of test.")
				(bool:and (width.eq 4i32)
					(bool:and
						(call is_three_bytes (borrow-shared source) start 116u8 101u8 115u8)
						(call is_head_byte (borrow-shared source) start 3i32 116u8)))
				(then (return 5u32)))
			(if
				(:doc "The group tag is exactly decls.")
				(bool:and (width.eq 5i32)
					(bool:and
						(call is_three_bytes (borrow-shared source) start 100u8 101u8 99u8)
						(bool:and
							(call is_head_byte (borrow-shared source) start 3i32 108u8)
							(call is_head_byte (borrow-shared source) start 4i32 115u8))))
				(then (return 2u32)))
			(if
				(:doc "The module tag is exactly module.")
				(bool:and (width.eq 6i32)
					(bool:and
						(call is_three_bytes (borrow-shared source) start 109u8 111u8 100u8)
						(call is_three_bytes (borrow-shared source)
							(start.add 3i32) 117u8 108u8 101u8)))
				(then (return 1u32)))
			(if
				(:doc "The pragma metadata head includes its leading colon.")
				(bool:and (width.eq 7i32)
					(bool:and
						(call is_head_byte (borrow-shared source) start 0i32 58u8)
						(bool:and
							(call is_three_bytes (borrow-shared source)
								start.inc 112u8 114u8 97u8)
							(call is_three_bytes (borrow-shared source)
								(start.add 4i32) 103u8 109u8 97u8))))
				(then (return 3u32)))
			(if
				(:doc "Width nine protects all three byte groups of bootstrap.")
				(bool:and (width.eq 9i32)
					(bool:and
						(call is_three_bytes (borrow-shared source) start 98u8 111u8 111u8)
						(bool:and
							(call is_three_bytes (borrow-shared source)
								(start.add 3i32) 116u8 115u8 116u8)
							(call is_three_bytes (borrow-shared source)
								(start.add 6i32) 114u8 97u8 112u8))))
				(then (return 7u32)))
			(return 0u32)))

	(fn selection_at
		(:doc `Record a selection result at the original span of its originating node.`)
		(params (node SourceNode) (active bool) (error u32) (test bool))
		(returns Selection)
		(body
			(return (struct:new Selection (active active) (error error) (test test)
				(start node/start) (end node/end)))))

	(fn cfg_operator
		(:doc `Classify not, all, any, os, arch, os_min, and os_max with codes 6 and 8 through 13.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns u32)
		(body
			(let start head/start)
			(let width (i32:sub head/end start))
			(if
				(:doc "Boolean predicate operators are exactly three bytes.")
				(width.eq 3i32)
				(then
					(if
						(:doc "Match the complete all operator.")
						(call is_three_bytes (borrow-shared source) start 97u8 108u8 108u8)
						(then (return 8u32)))
					(if
						(:doc "Match the complete any operator.")
						(call is_three_bytes (borrow-shared source) start 97u8 110u8 121u8)
						(then (return 9u32)))
					(return (call source_keyword (borrow-shared source) head))))
			(if
				(:doc "Match the operating system selector.")
				(bool:and (width.eq 2i32)
					(bool:and (call is_head_byte (borrow-shared source) start 0i32 111u8)
						(call is_head_byte (borrow-shared source) start 1i32 115u8)))
				(then (return 10u32)))
			(if
				(:doc "Match the complete architecture selector.")
				(bool:and (width.eq 4i32)
					(bool:and (call is_three_bytes (borrow-shared source) start 97u8 114u8 99u8)
						(call is_head_byte (borrow-shared source) start 3i32 104u8)))
				(then (return 11u32)))
			(if
				(:doc "The two deployment selectors share the os_m prefix.")
				(bool:and (width.eq 6i32)
					(call is_three_bytes (borrow-shared source) start 111u8 115u8 95u8))
				(then
					(let suffix (start.add 3i32))
					(if
						(:doc "Select the inclusive lower bound.")
						(call is_three_bytes (borrow-shared source) suffix 109u8 105u8 110u8)
						(then (return 12u32)))
					(if
						(:doc "Select the inclusive upper bound.")
						(call is_three_bytes (borrow-shared source) suffix 109u8 97u8 120u8)
						(then (return 13u32)))))
			(return 0u32)))

	(fn cfg_target_selection
		(:doc `Compare one target predicate operand and retain its span when malformed.`)
		(params (source (shared-array u8)) (value SourceNode) (operator u32) (context SelectionContext))
		(returns Selection)
		(body
			(if
				(:doc "OS and architecture predicates compare the decoded string to the supplied name.")
				(operator.lt 12u32)
				(then
					(let architecture (operator.eq 11u32))
					(let code (call cfg_target_name (borrow-shared source) value architecture))
					(if code.ltz (then (return (call selection_at value (bool false) 21u32 (bool false)))))
					(let-mut target context/os)
					(if architecture (then (set target context/arch)))
					(return (call selection_at value
						(bool:and target.gtz (code.eq (i32:from-u8 target)))
						0u32 (bool false)))))
			(let limit (call cfg_deployment_limit (borrow-shared source) value))
			(if limit.ltz (then (return (call selection_at value (bool false) 21u32 (bool false)))))
			(let version context/deployment)
			(if
				(:doc "Without deployment metadata neither bound can match.")
				version.ltz
				(then (return (call selection_at value (bool false) 0u32 (bool false)))))
			(let below (version.lt limit))
			(let above (limit.lt version))
			(let active (bool:not (bool:or (bool:and (operator.eq 12u32) below)
				(bool:and (operator.eq 13u32) above))))
			(return (call selection_at value active 0u32 (bool false)))))

	(fn cfg_selection
		(:doc `Evaluate one predicate while validating every operand, including inactive alternatives.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(operand i32) (context SelectionContext) (depth i32))
		(returns Selection)
		(body
			(let node (nodes.get operand))
			(if
				(:doc "Limit recursive predicate evaluation before an arbitrarily deep source can exhaust the host stack.")
				(depth.eq 64i32)
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(if
				(:doc "Only bootstrap and test are supported as bare predicates.")
				(u32:not-eq node/kind 40u32)
				(then
					(let keyword (call source_keyword (borrow-shared source) node))
					(if
						(:doc "Unknown features keep the existing unsupported-predicate diagnostic.")
						(bool:not (bool:or (keyword.eq 7u32) (keyword.eq 5u32)))
						(then (return (call selection_at node (bool false) 21u32 (bool false)))))
					(let mode context/mode)
					(let active (bool:or (bool:and (keyword.eq 7u32) (mode.eq 1u32))
						(bool:and (keyword.eq 5u32) (mode.eq 2u32))))
					(return (call selection_at node active 0u32 (bool false)))))
			(let next_depth depth.inc)
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let operator (call cfg_operator (borrow-shared source) (nodes.get parts/head)))
			(let argument parts/operands)
			(let conjunction (operator.eq 8u32))
			(if
				(:doc "An empty all is true and an empty any is false.")
				(conjunction.or (operator.eq 9u32))
				(then
					(let-mut active conjunction)
					(let-mut child argument)
					(while
						(:doc "Validate later operands even after the combined result is known.")
						(i32:lt -1i32 child)
						(body
							(let result (call cfg_selection (borrow-shared source) (borrow-shared nodes)
								child context next_depth))
							(if (u32:gtz result/error) (then (return result)))
							(if
								(:doc "Combine the checked child using the parent's Boolean operator.")
								conjunction
								(then (set active (active.and result/active)))
								(else (set active (active.or result/active))))
							(set child (struct:get (nodes.get child) next_sibling))))
					(return (call selection_at node active 0u32 (bool false)))))
			(let negation (operator.eq 6u32))
			(if
				(:doc "Only negation and the target predicates take a single operand.")
				(bool:or argument.ltz
					(bool:not (negation.or (u32:lt 9u32 operator))))
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(let value (nodes.get argument))
			(if
				(:doc "An extra operand makes the predicate malformed.")
				(i32:lt -1i32 value/next_sibling)
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(if
				(:doc "Negate a checked predicate without changing the context.")
				negation
				(then
					(let result (call cfg_selection (borrow-shared source) (borrow-shared nodes)
						argument context next_depth))
					(if (u32:gtz result/error) (then (return result)))
					(return (call selection_at node (bool:not result/active) 0u32 (bool false)))))
			(return (call cfg_target_selection (borrow-shared source) value operator context))))

	(fn select_directive
		(:doc `Read a checked pragma directive and retain a direct test marker on the selected form.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (selectable bool) (context SelectionContext))
		(returns Selection)
		(body
			(if
				(:doc "Each directive in a pragma entry must be a form.")
				(u32:not-eq node/kind 40u32)
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(let head (nodes.get node/first_child))
			(let keyword (call source_keyword (borrow-shared source) head))
			(if
				(:doc "Unknown directives leave their payloads opaque.")
				(bool:not (bool:or (keyword.eq 4u32) (keyword.eq 5u32)))
				(then (return (call selection_at node (bool true) 0u32 (bool false)))))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let operand parts/operands)
			(if
				(:doc "A test marker selects a declaration only during test compilation.")
				(keyword.eq 5u32)
				(then
					(if
						(:doc "An empty test marker is valid on a selectable form in every mode.")
						(selectable.and operand.ltz)
						(then (return (call selection_at node (u32:eq context/mode 2u32) 0u32 (bool true)))))
					(return (call selection_at node (bool false) 21u32 (bool false)))))
			(if
				(:doc "A cfg with no predicate fails before reading any operand row.")
				operand.ltz
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(let predicate (nodes.get operand))
			(if
				(:doc "A cfg accepts exactly one predicate.")
				(i32:not-ltz predicate/next_sibling)
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(let choice (call cfg_selection (borrow-shared source) (borrow-shared nodes) operand context 0i32))
			(if
				(:doc "A valid cfg is still invalid where declaration selection is unavailable.")
				(bool:and selectable.not (u32:eqz choice/error))
				(then (return (call selection_at node (bool false) 21u32 (bool false)))))
			(return choice)))

	(fn skip_disabled_siblings
		(:doc `Find the first ordinary sibling for semantic traversal, retaining every original tree row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut index first)
			(while
				(:doc "Skip each disabled group as a single sibling without descending into its contents.")
				(bool:and index.not-ltz
					(call is_disabled_form (borrow-shared source) (borrow-shared nodes)
						(nodes.get index)))
				(body (set index (struct:get (nodes.get index) next_sibling))))
			(return index)))

	(fn select_form
		(:doc `Validate pragmas on a checked form and select it when the context permits.

		Every known directive is checked in source order even after one excludes
		the target. Other entries and unknown directive contents remain opaque.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(node SourceNode) (parts FormParts) (selectable bool) (context SelectionContext))
		(returns Selection)
		(body
			(if
				(:doc "A disabled declaration is inert before any of its pragmas are interpreted.")
				(selectable.and
					(call is_disabled_form (borrow-shared source) (borrow-shared nodes) node))
				(then (return (call selection_at node (bool false) 0u32 (bool false)))))
			(let-mut active (bool true))
			(let-mut test (bool false))
			(let-mut index parts/metadata)
			(while
				(:doc "Only attached metadata entries may select this form.")
				(i32:lt -1i32 index)
				(body
					(let entry (nodes.get index))
					(let head (nodes.get entry/first_child))
					(if
						(:doc "Only :pragma entries contain selection directives.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let pragma (call form_parts (borrow-shared source) (borrow-shared nodes) entry))
							(let-mut directive pragma/operands)
							(while
								(:doc "Visit every directive in order, including those after an exclusion.")
								directive.not-ltz
								(body
									(let item (nodes.get directive))
									(let result (call select_directive (borrow-shared source)
										(borrow-shared nodes) item selectable context))
									(if
										(:doc "Return the first malformed directive's original span.")
										(u32:gtz result/error)
										(then (return result)))
									(set active (active.and result/active))
									(set test (test.or result/test))
									(set directive item/next_sibling)))))
					(set index (call next_form_metadata (borrow-shared source) (borrow-shared nodes)
						parts entry))))
			(return (call selection_at node active 0u32 test))))

	(fn validate_form_metadata
		(:doc `Validate metadata where selection directives are forbidden regardless of compilation mode.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (parts FormParts))
		(returns Selection)
		(body (return (call select_form (borrow-shared source) (borrow-shared nodes)
			node parts (bool false) (call default_selection 0u32)))))

	(fn is_declaration_group
		(:doc `Identify the transparent decls form in a checked declaration list.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts))
		(returns bool)
		(body
			(let head parts/head)
			(return (bool:and (i32:lt -1i32 head)
				(u32:eq (call source_keyword (borrow-shared source) (nodes.get head)) 2u32)))))

	(fn next_declaration
		(:doc `Find the next declaration after a leaf or a group that will not be descended.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (module i32))
		(returns i32)
		(body
			(let-mut next (call next_form_operand (borrow-shared source) (borrow-shared nodes) node))
			(let-mut parent node/parent)
			(while
				(:doc "At a group end, climb until a sibling is available or the module is complete.")
				(bool:and next.ltz (parent.not-eq module))
				(body
					(let group (nodes.get parent))
					(set next (call next_form_operand (borrow-shared source) (borrow-shared nodes) group))
					(set parent group/parent)))
			(return next)))

	(fn module_result
		(:doc `Return the original module name index, selected count, and result span.`)
		(params (mode u32) (name i32) (count i32) (active bool) (start i32) (end i32) (error u32))
		(returns ModuleRead)
		(body
			(return (struct:new ModuleRead
				(name name) (count count) (active active)
				(start start) (end end) (error error) (mode mode)))))

	(fn select_module_root
		(:doc `Validate a checked module root and evaluate its selection metadata before walking its declarations.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(parts FormParts) (context SelectionContext))
		(returns ModuleRead)
		(body
			(let mode context/mode)
			(let start node/start)
			(let end node/end)
			(let head (nodes.get parts/head))
			(if
				(:doc "The source root must be a module form.")
				(u32:not-eq (call source_keyword (borrow-shared source) head) 1u32)
				(then (return (call module_result mode -1i32 0i32 (bool false)
					head/start head/end 18u32))))
			(let name parts/name)
			(if
				(:doc "The module's name slot is required even when selection excludes the module.")
				name.ltz
				(then (return (call module_result mode -1i32 0i32 (bool false) start end 19u32))))
			(let name_node (nodes.get name))
			(if
				(:doc "The seed requires an unquoted identifier for a module name.")
				(bool:not (call is_wove_name (borrow-shared source) name_node))
				(then (return (call module_result mode -1i32 0i32 (bool false)
					name_node/start name_node/end 19u32))))
			(let selected (call select_form (borrow-shared source) (borrow-shared nodes)
				node parts (bool true) context))
			(if
				(:doc "A malformed module selector keeps its own coordinates.")
				(u32:gtz selected/error)
				(then (return (call module_result mode name 0i32 (bool false)
					selected/start selected/end selected/error))))
			(return (call module_result mode name 0i32 selected/active
				start end 0u32))))

	(fn read_module
		(:doc `Read a module for a caller that supplies only the compilation mode.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (checked FormCheck) (mode u32)
			(output (mut-array SelectedDeclaration)))
		(returns ModuleRead)
		(body (return (call read_module_for_target (borrow-shared source) (borrow-shared nodes)
			checked (call default_selection mode) (borrow-mut output)))))

	(fn read_module_for_target
		(:doc `Read a checked module and collect selected declarations in source order.

		Meta and operand views refer to the original tree. An excluded module succeeds
		with no declarations. If the destination is short, report the next declaration
		at its source span and keep the previously written indices.`)
		(:expect
			(tests "stage-2/source_modules.tsv")
			(issues "gh:wove-lang/wove:66" "gh:wove-lang/wove:146" "gh:wove-lang/wove:190"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (checked FormCheck) (context SelectionContext)
			(output (mut-array SelectedDeclaration)))
		(returns ModuleRead)
		(body
			(let mode context/mode)
			(let start checked/start)
			(let end checked/end)
			(let error checked/error)
			(if
				(:doc "Preserve earlier lexical or tree failures before reading any rows.")
				error.gtz
				(then (return (call module_result mode -1i32 0i32 (bool false) start end error))))
			(let root (nodes.get 0i32))
			(let module root/first_child)
			(let node (nodes.get module))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let selected (call select_module_root (borrow-shared source) (borrow-shared nodes)
				node parts context))
			(if
				(:doc "An excluded or invalid module contributes no declarations.")
				(bool:not selected/active)
				(then (return selected)))
			(let name selected/name)
			(let-mut count 0i32)
			(let-mut index parts/operands)
			(while
				(:doc "Walk selected group children and their siblings without a separate stack.")
				index.not-ltz
				(body
					(let item (nodes.get index))
					(if
						(:doc "A declaration must be a tagged form.")
						(u32:not-eq item/kind 40u32)
						(then (return (call module_result mode name count (bool true)
							item/start item/end 20u32))))
					(let item_parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let choice (call select_form (borrow-shared source) (borrow-shared nodes)
						item item_parts (bool true) context))
					(if
						(:doc "Selection failures keep the directive span and any earlier indices.")
						(u32:gtz choice/error)
						(then (return (call module_result mode name count (bool true)
							choice/start choice/end choice/error))))
					(let-mut next -1i32)
					(if
						(:doc "Skip excluded declarations and the whole contents of excluded groups.")
						choice/active
						(then
							(if
								(:doc "Expand a selected decls group in place.")
								(call is_declaration_group (borrow-shared source) (borrow-shared nodes) item_parts)
								(then (set next item_parts/operands))
								(else
									(if
										(:doc "A short destination preserves the prefix of written declaration indices.")
										(count.not-lt output.len)
										(then (return (call module_result mode name count (bool true)
											item/start item/end 16u32))))
									(output.set count (struct:new SelectedDeclaration (node index) (test choice/test)))
									(set count count.inc)))))
					(if
						(:doc "Only a nonempty selected group takes the walk directly to its first operand.")
						next.ltz
						(then (set next (call next_declaration (borrow-shared source) (borrow-shared nodes) item module))))
					(set index next)))
			(return (call module_result mode name count (bool true) start end 0u32)))))
