(module source_module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read module declarations from the checked source tree.

	Expose metadata and ordinary operands through the original node links.
	Apply the compilation mode and flatten selected declaration groups in
	source order. Mode 0 is native, mode 1 is bootstrap, and mode 2 is test.
	Keep each declaration's original node index and direct test marker.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./scan.wove"
		(only is_identifier_head is_metadata_form is_disabled_form declaration_head named_form_error read_c_bridge_opening (type SourceNode) (type FormCheck)))

	(use wove-file "./target.wove" (only default_selection cfg_target_name cfg_deployment_limit (type SelectionContext)))

	(struct FormParts (fields (head i32) (metadata i32) (operands i32) (name i32) (header i32)))
	(struct SelectedDeclaration (fields (node i32) (test bool)))
	(struct ModuleRead
		(fields (name i32) (count i32) (active bool) (start i32) (end i32) (error u32) (mode u32)))
	(struct Selection (fields (active bool) (start i32) (end i32) (error u32) (test bool)))

	(fn find_metadata
		(:doc "Find the next metadata sibling, skipping ordinary fields only on a function declaration.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (interleaved bool))
		(returns i32)
		(body
			(let-mut index (local first))
			(while
				(:doc "Follow the original sibling links until the next attached metadata entry.")
				(i32.lt -1i32 (local index))
				(body
					(let entry (array.load (local nodes) (local index)))
					(if
						(:doc "All metadata entries are direct children of the owning form.")
						(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local entry))
						(then (return (local index))))
					(if
						(:doc "For other forms the first ordinary field ends the prefix.")
						(bool.not (local interleaved))
						(then (return -1i32)))
					(set (local index) (struct.get (local entry) next_sibling))))
			(return -1i32)))

	(fn next_form_metadata
		(:doc "Advance an attached metadata entry in its original source order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts) (entry SourceNode))
		(returns i32)
		(body
			(let interleaved (bool.and (i32.lt -1i32 (struct.get (local parts) name))
				(u32.eq (call declaration_head (borrow-shared (local source))
					(array.load (local nodes) (struct.get (local parts) head))) 2u32)))
			(return (call find_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local entry) next_sibling) (local interleaved)))))

	(fn form_parts
		(:doc `Expose a checked form's name, first metadata entry, and first ordinary operand.

		Each field is an original row index or -1. Modules, functions, and
		module bindings have a name slot. C bridges have a header slot.
		Named functions can have metadata after their first ordinary field.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns FormParts)
		(body
			(if
				(:doc "Nodes without a form head have no name, metadata, or operand view.")
				(bool.not (u32.eq (struct.get (local node) kind) 40u32))
				(then (return (struct.new FormParts (head -1i32) (metadata -1i32)
					(operands -1i32) (name -1i32) (header -1i32)))))
			(let head (struct.get (local node) first_child))
			(let tag (array.load (local nodes) (local head)))
			(let named (u32.lt 0u32 (call named_form_error (borrow-shared (local source))
				(borrow-shared (local nodes)) (local node) (local tag))))
			(let-mut cursor (struct.get (local tag) next_sibling))
			(let-mut name -1i32)
			(if
				(:doc "A declared name occupies the first slot before metadata.")
				(bool.and (local named) (bool.not (i32.lt (local cursor) 0i32)))
				(then
					(set (local name) (local cursor))
					(set (local cursor) (struct.get (array.load (local nodes) (local name)) next_sibling))))
			(let opening (call read_c_bridge_opening (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local tag)))
			(let header (struct.get (local opening) header))
			(if
				(:doc "Expose bridge metadata and members after both fixed opening slots.")
				(i32.lt -1i32 (local header))
				(then (set (local cursor) (struct.get (array.load (local nodes) (local header)) next_sibling))))
			(let-mut metadata -1i32)
			(let first (local cursor))
			(while
				(:doc "The contiguous run of colon-tagged siblings is the metadata range.")
				(bool.and (bool.not (i32.lt (local cursor) 0i32))
					(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local nodes) (local cursor))))
				(body
					(set (local metadata) (local first))
					(set (local cursor) (struct.get (array.load (local nodes) (local cursor)) next_sibling))))
			(if
				(:doc "If no metadata precedes a function's fields, look among its remaining siblings.")
				(bool.and (i32.lt (local metadata) 0i32)
					(bool.and (local named) (u32.eq (call declaration_head (borrow-shared (local source)) (local tag)) 2u32)))
				(then (set (local metadata) (call find_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
					(local cursor) (bool true)))))
			(return (struct.new FormParts (head (local head)) (metadata (local metadata))
				(operands (local cursor)) (name (local name)) (header (local header))))))

	(fn source_keyword
		(:doc `Match the exact atom spellings used by module selection.

		Return 1 for module, 2 for decls, 3 for :pragma, 4 for cfg, 5 for test,
		6 for not, 7 for bootstrap, and 0 for every other node.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Quoted spellings and forms are not keyword atoms.")
				(bool.not (u32.eq (struct.get (local node) kind) 1u32))
				(then (return 0u32)))
			(let start (struct.get (local node) start))
			(let width (i32.sub.wrapping (struct.get (local node) end) (local start)))
			(if
				(:doc "Both cfg and not contain exactly three bytes.")
				(i32.eq (local width) 3i32)
				(then
					(if
						(:doc "Identify a cfg selection directive.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 99u8 102u8 103u8)
						(then (return 4u32)))
					(if
						(:doc "Identify the compound predicate operator not.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 110u8 111u8 116u8)
						(then (return 6u32)))))
			(if
				(:doc "The checked width allows the final byte of test.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 116u8 101u8 115u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 116u8)))
				(then (return 5u32)))
			(if
				(:doc "The group tag is exactly decls.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 100u8 101u8 99u8)
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 4i32 115u8))))
				(then (return 2u32)))
			(if
				(:doc "The module tag is exactly module.")
				(bool.and (i32.eq (local width) 6i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 109u8 111u8 100u8)
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) 3i32) 117u8 108u8 101u8)))
				(then (return 1u32)))
			(if
				(:doc "The pragma metadata head includes its leading colon.")
				(bool.and (i32.eq (local width) 7i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 58u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 1i32) 112u8 114u8 97u8)
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 4i32) 103u8 109u8 97u8))))
				(then (return 3u32)))
			(if
				(:doc "Width nine protects all three byte groups of bootstrap.")
				(bool.and (i32.eq (local width) 9i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 98u8 111u8 111u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 3i32) 116u8 115u8 116u8)
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) 6i32) 114u8 97u8 112u8))))
				(then (return 7u32)))
			(return 0u32)))

	(fn selection_at
		(:doc `Record a selection result at the original span of its originating node.`)
		(params (node SourceNode) (active bool) (error u32) (test bool))
		(returns Selection)
		(body
			(return (struct.new Selection (active (local active)) (error (local error)) (test (local test))
				(start (struct.get (local node) start)) (end (struct.get (local node) end))))))

	(fn cfg_operator
		(:doc `Classify not, all, any, os, arch, os_min, and os_max with codes 6 and 8 through 13.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns u32)
		(body
			(let start (struct.get (local head) start))
			(let width (i32.sub.wrapping (struct.get (local head) end) (local start)))
			(if
				(:doc "Boolean predicate operators are exactly three bytes.")
				(i32.eq (local width) 3i32)
				(then
					(if
						(:doc "Match the complete all operator.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 97u8 108u8 108u8)
						(then (return 8u32)))
					(if
						(:doc "Match the complete any operator.")
						(call is_three_bytes (borrow-shared (local source)) (local start) 97u8 110u8 121u8)
						(then (return 9u32)))
					(return (call source_keyword (borrow-shared (local source)) (local head)))))
			(if
				(:doc "Match the operating system selector.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 111u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 115u8)))
				(then (return 10u32)))
			(if
				(:doc "Match the complete architecture selector.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 97u8 114u8 99u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 104u8)))
				(then (return 11u32)))
			(if
				(:doc "The two deployment selectors share the os_m prefix.")
				(bool.and (i32.eq (local width) 6i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 111u8 115u8 95u8))
				(then
					(let suffix (i32.add.wrapping (local start) 3i32))
					(if
						(:doc "Select the inclusive lower bound.")
						(call is_three_bytes (borrow-shared (local source)) (local suffix) 109u8 105u8 110u8)
						(then (return 12u32)))
					(if
						(:doc "Select the inclusive upper bound.")
						(call is_three_bytes (borrow-shared (local source)) (local suffix) 109u8 97u8 120u8)
						(then (return 13u32)))))
			(return 0u32)))

	(fn cfg_target_selection
		(:doc `Compare one target predicate operand and retain its span when malformed.`)
		(params (source (shared-array u8)) (value SourceNode) (operator u32) (context SelectionContext))
		(returns Selection)
		(body
			(if
				(:doc "OS and architecture predicates compare the decoded string to the supplied name.")
				(u32.lt (local operator) 12u32)
				(then
					(let architecture (u32.eq (local operator) 11u32))
					(let code (call cfg_target_name (borrow-shared (local source)) (local value) (local architecture)))
					(if (i32.lt (local code) 0i32) (then (return (call selection_at (local value) (bool false) 21u32 (bool false)))))
					(let-mut target (struct.get (local context) os))
					(if (local architecture) (then (set (local target) (struct.get (local context) arch))))
					(return (call selection_at (local value)
						(bool.and (u8.lt 0u8 (local target)) (i32.eq (local code) (int.convert i32 (local target))))
						0u32 (bool false)))))
			(let limit (call cfg_deployment_limit (borrow-shared (local source)) (local value)))
			(if (i32.lt (local limit) 0i32) (then (return (call selection_at (local value) (bool false) 21u32 (bool false)))))
			(let version (struct.get (local context) deployment))
			(if
				(:doc "Without deployment metadata neither bound can match.")
				(i32.lt (local version) 0i32)
				(then (return (call selection_at (local value) (bool false) 0u32 (bool false)))))
			(let below (i32.lt (local version) (local limit)))
			(let above (i32.lt (local limit) (local version)))
			(let active (bool.not (bool.or (bool.and (u32.eq (local operator) 12u32) (local below))
				(bool.and (u32.eq (local operator) 13u32) (local above)))))
			(return (call selection_at (local value) (local active) 0u32 (bool false)))))

	(fn cfg_selection
		(:doc `Evaluate one predicate while validating every operand, including inactive alternatives.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(operand i32) (context SelectionContext) (depth i32))
		(returns Selection)
		(body
			(let node (array.load (local nodes) (local operand)))
			(if
				(:doc "Limit recursive predicate evaluation before an arbitrarily deep source can exhaust the host stack.")
				(i32.eq (local depth) 64i32)
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(if
				(:doc "Only bootstrap and test are supported as bare predicates.")
				(bool.not (u32.eq (struct.get (local node) kind) 40u32))
				(then
					(let keyword (call source_keyword (borrow-shared (local source)) (local node)))
					(if
						(:doc "Unknown features keep the existing unsupported-predicate diagnostic.")
						(bool.not (bool.or (u32.eq (local keyword) 7u32) (u32.eq (local keyword) 5u32)))
						(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
					(let mode (struct.get (local context) mode))
					(let active (bool.or (bool.and (u32.eq (local keyword) 7u32) (u32.eq (local mode) 1u32))
						(bool.and (u32.eq (local keyword) 5u32) (u32.eq (local mode) 2u32))))
					(return (call selection_at (local node) (local active) 0u32 (bool false)))))
			(let next_depth (i32.add.wrapping (local depth) 1i32))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let operator (call cfg_operator (borrow-shared (local source)) (array.load (local nodes) (struct.get (local parts) head))))
			(let argument (struct.get (local parts) operands))
			(let conjunction (u32.eq (local operator) 8u32))
			(if
				(:doc "An empty all is true and an empty any is false.")
				(bool.or (local conjunction) (u32.eq (local operator) 9u32))
				(then
					(let-mut active (local conjunction))
					(let-mut child (local argument))
					(while
						(:doc "Validate later operands even after the combined result is known.")
						(i32.lt -1i32 (local child))
						(body
							(let result (call cfg_selection (borrow-shared (local source)) (borrow-shared (local nodes))
								(local child) (local context) (local next_depth)))
							(if (u32.lt 0u32 (struct.get (local result) error)) (then (return (local result))))
							(if
								(:doc "Combine the checked child using the parent's Boolean operator.")
								(local conjunction)
								(then (set (local active) (bool.and (local active) (struct.get (local result) active))))
								(else (set (local active) (bool.or (local active) (struct.get (local result) active)))))
							(set (local child) (struct.get (array.load (local nodes) (local child)) next_sibling))))
					(return (call selection_at (local node) (local active) 0u32 (bool false)))))
			(let negation (u32.eq (local operator) 6u32))
			(if
				(:doc "Only negation and the target predicates take a single operand.")
				(bool.or (i32.lt (local argument) 0i32)
					(bool.not (bool.or (local negation) (u32.lt 9u32 (local operator)))))
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(let value (array.load (local nodes) (local argument)))
			(if
				(:doc "An extra operand makes the predicate malformed.")
				(i32.lt -1i32 (struct.get (local value) next_sibling))
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(if
				(:doc "Negate a checked predicate without changing the context.")
				(local negation)
				(then
					(let result (call cfg_selection (borrow-shared (local source)) (borrow-shared (local nodes))
						(local argument) (local context) (local next_depth)))
					(if (u32.lt 0u32 (struct.get (local result) error)) (then (return (local result))))
					(return (call selection_at (local node) (bool.not (struct.get (local result) active)) 0u32 (bool false)))))
			(return (call cfg_target_selection (borrow-shared (local source)) (local value) (local operator) (local context)))))

	(fn select_directive
		(:doc `Read a checked pragma directive and retain a direct test marker on the selected form.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (selectable bool) (context SelectionContext))
		(returns Selection)
		(body
			(if
				(:doc "Each directive in a pragma entry must be a form.")
				(bool.not (u32.eq (struct.get (local node) kind) 40u32))
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(let head (array.load (local nodes) (struct.get (local node) first_child)))
			(let keyword (call source_keyword (borrow-shared (local source)) (local head)))
			(if
				(:doc "Unknown directives leave their payloads opaque.")
				(bool.not (bool.or (u32.eq (local keyword) 4u32) (u32.eq (local keyword) 5u32)))
				(then (return (call selection_at (local node) (bool true) 0u32 (bool false)))))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let operand (struct.get (local parts) operands))
			(if
				(:doc "A test marker selects a declaration only during test compilation.")
				(u32.eq (local keyword) 5u32)
				(then
					(if
						(:doc "An empty test marker is valid on a selectable form in every mode.")
						(bool.and (local selectable) (i32.lt (local operand) 0i32))
						(then (return (call selection_at (local node) (u32.eq (struct.get (local context) mode) 2u32) 0u32 (bool true)))))
					(return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(if
				(:doc "A cfg with no predicate fails before reading any operand row.")
				(i32.lt (local operand) 0i32)
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(let predicate (array.load (local nodes) (local operand)))
			(if
				(:doc "A cfg accepts exactly one predicate.")
				(bool.not (i32.lt (struct.get (local predicate) next_sibling) 0i32))
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(let choice (call cfg_selection (borrow-shared (local source)) (borrow-shared (local nodes)) (local operand) (local context) 0i32))
			(if
				(:doc "A valid cfg is still invalid where declaration selection is unavailable.")
				(bool.and (bool.not (local selectable)) (u32.eq (struct.get (local choice) error) 0u32))
				(then (return (call selection_at (local node) (bool false) 21u32 (bool false)))))
			(return (local choice))))

	(fn skip_disabled_siblings
		(:doc `Find the first ordinary sibling for semantic traversal, retaining every original tree row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut index (local first))
			(while
				(:doc "Skip each disabled group as a single sibling without descending into its contents.")
				(bool.and (bool.not (i32.lt (local index) 0i32))
					(call is_disabled_form (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local nodes) (local index))))
				(body (set (local index) (struct.get (array.load (local nodes) (local index)) next_sibling))))
			(return (local index))))

	(fn select_form
		(:doc `Validate pragmas on a checked form and select it when the context permits.

		Every known directive is checked in source order even after one excludes
		the target. Other entries and unknown directive contents remain opaque.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(node SourceNode) (parts FormParts) (selectable bool) (context SelectionContext))
		(returns Selection)
		(body
			(if
				(:doc "A disabled declaration is inert before any of its pragmas are interpreted.")
				(bool.and (local selectable)
					(call is_disabled_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
				(then (return (call selection_at (local node) (bool false) 0u32 (bool false)))))
			(let-mut active (bool true))
			(let-mut test (bool false))
			(let-mut index (struct.get (local parts) metadata))
			(while
				(:doc "Only attached metadata entries may select this form.")
				(i32.lt -1i32 (local index))
				(body
					(let entry (array.load (local nodes) (local index)))
					(let head (array.load (local nodes) (struct.get (local entry) first_child)))
					(if
						(:doc "Only :pragma entries contain selection directives.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let pragma (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local entry)))
							(let-mut directive (struct.get (local pragma) operands))
							(while
								(:doc "Visit every directive in order, including those after an exclusion.")
								(bool.not (i32.lt (local directive) 0i32))
								(body
									(let item (array.load (local nodes) (local directive)))
									(let result (call select_directive (borrow-shared (local source))
										(borrow-shared (local nodes)) (local item) (local selectable) (local context)))
									(if
										(:doc "Return the first malformed directive's original span.")
										(u32.lt 0u32 (struct.get (local result) error))
										(then (return (local result))))
									(set (local active) (bool.and (local active) (struct.get (local result) active)))
									(set (local test) (bool.or (local test) (struct.get (local result) test)))
									(set (local directive) (struct.get (local item) next_sibling))))))
					(set (local index) (call next_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local parts) (local entry)))))
			(return (call selection_at (local node) (local active) 0u32 (local test)))))

	(fn validate_form_metadata
		(:doc `Validate metadata where selection directives are forbidden regardless of compilation mode.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (parts FormParts))
		(returns Selection)
		(body (return (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
			(local node) (local parts) (bool false) (call default_selection 0u32)))))

	(fn is_declaration_group
		(:doc `Identify the transparent decls form in a checked declaration list.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts))
		(returns bool)
		(body
			(let head (struct.get (local parts) head))
			(return (bool.and (i32.lt -1i32 (local head))
				(u32.eq (call source_keyword (borrow-shared (local source)) (array.load (local nodes) (local head))) 2u32)))))

	(fn next_declaration
		(:doc `Find the next declaration after a leaf or a group that will not be descended.`)
		(params (nodes (shared-array SourceNode)) (node SourceNode) (module i32))
		(returns i32)
		(body
			(let-mut next (struct.get (local node) next_sibling))
			(let-mut parent (struct.get (local node) parent))
			(while
				(:doc "At a group end, climb until a sibling is available or the module is complete.")
				(bool.and (i32.lt (local next) 0i32) (bool.not (i32.eq (local parent) (local module))))
				(body
					(let group (array.load (local nodes) (local parent)))
					(set (local next) (struct.get (local group) next_sibling))
					(set (local parent) (struct.get (local group) parent))))
			(return (local next))))

	(fn module_result
		(:doc `Return the original module name index, selected count, and result span.`)
		(params (mode u32) (name i32) (count i32) (active bool) (start i32) (end i32) (error u32))
		(returns ModuleRead)
		(body
			(return (struct.new ModuleRead
				(name (local name)) (count (local count)) (active (local active))
				(start (local start)) (end (local end)) (error (local error)) (mode (local mode))))))

	(fn select_module_root
		(:doc `Validate a checked module root and evaluate its selection metadata before walking its declarations.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(parts FormParts) (context SelectionContext))
		(returns ModuleRead)
		(body
			(let mode (struct.get (local context) mode))
			(let start (struct.get (local node) start))
			(let end (struct.get (local node) end))
			(let head (array.load (local nodes) (struct.get (local parts) head)))
			(if
				(:doc "The source root must be a module form.")
				(bool.not (u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 1u32))
				(then (return (call module_result (local mode) -1i32 0i32 (bool false)
					(struct.get (local head) start) (struct.get (local head) end) 18u32))))
			(let name (struct.get (local parts) name))
			(if
				(:doc "The module's name slot is required even when selection excludes the module.")
				(i32.lt (local name) 0i32)
				(then (return (call module_result (local mode) -1i32 0i32 (bool false) (local start) (local end) 19u32))))
			(let name_node (array.load (local nodes) (local name)))
			(if
				(:doc "The seed requires an unquoted identifier for a module name.")
				(bool.not (bool.and (u32.eq (struct.get (local name_node) kind) 1u32)
					(call is_identifier_head (borrow-shared (local source))
						(struct.get (local name_node) start) (struct.get (local name_node) end))))
				(then (return (call module_result (local mode) -1i32 0i32 (bool false)
					(struct.get (local name_node) start) (struct.get (local name_node) end) 19u32))))
			(let selected (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts) (bool true) (local context)))
			(if
				(:doc "A malformed module selector keeps its own coordinates.")
				(u32.lt 0u32 (struct.get (local selected) error))
				(then (return (call module_result (local mode) (local name) 0i32 (bool false)
					(struct.get (local selected) start) (struct.get (local selected) end) (struct.get (local selected) error)))))
			(return (call module_result (local mode) (local name) 0i32 (struct.get (local selected) active)
				(local start) (local end) 0u32))))

	(fn read_module
		(:doc `Read a module for a caller that supplies only the compilation mode.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (checked FormCheck) (mode u32)
			(output (mut-array SelectedDeclaration)))
		(returns ModuleRead)
		(body (return (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes))
			(local checked) (call default_selection (local mode)) (borrow-mut (local output))))))

	(fn read_module_for_target
		(:doc `Read a checked module and collect selected declarations in source order.

		Meta and operand views refer to the original tree. An excluded module succeeds
		with no declarations. If the destination is short, report the next declaration
		at its source span and keep the previously written indices.`)
		(:expect
			(tests "stage-2/source_modules.tsv")
			(issues "gh:wove-lang/wove:66" "gh:wove-lang/wove:146" "gh:wove-lang/wove:190"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (checked FormCheck) (context SelectionContext)
			(output (mut-array SelectedDeclaration)))
		(returns ModuleRead)
		(body
			(let mode (struct.get (local context) mode))
			(let start (struct.get (local checked) start))
			(let end (struct.get (local checked) end))
			(let error (struct.get (local checked) error))
			(if
				(:doc "Preserve earlier lexical or tree failures before reading any rows.")
				(u32.lt 0u32 (local error))
				(then (return (call module_result (local mode) -1i32 0i32 (bool false) (local start) (local end) (local error)))))
			(let root (array.load (local nodes) 0i32))
			(let module (struct.get (local root) first_child))
			(let node (array.load (local nodes) (local module)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let selected (call select_module_root (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts) (local context)))
			(if
				(:doc "An excluded or invalid module contributes no declarations.")
				(bool.not (struct.get (local selected) active))
				(then (return (local selected))))
			(let name (struct.get (local selected) name))
			(let-mut count 0i32)
			(let-mut index (struct.get (local parts) operands))
			(while
				(:doc "Walk selected group children and their siblings without a separate stack.")
				(bool.not (i32.lt (local index) 0i32))
				(body
					(let item (array.load (local nodes) (local index)))
					(if
						(:doc "A declaration must be a tagged form.")
						(bool.not (u32.eq (struct.get (local item) kind) 40u32))
						(then (return (call module_result (local mode) (local name) (local count) (bool true)
							(struct.get (local item) start) (struct.get (local item) end) 20u32))))
					(let item_parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let choice (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
						(local item) (local item_parts) (bool true) (local context)))
					(if
						(:doc "Selection failures keep the directive span and any earlier indices.")
						(u32.lt 0u32 (struct.get (local choice) error))
						(then (return (call module_result (local mode) (local name) (local count) (bool true)
							(struct.get (local choice) start) (struct.get (local choice) end) (struct.get (local choice) error)))))
					(let-mut next -1i32)
					(if
						(:doc "Skip excluded declarations and the whole contents of excluded groups.")
						(struct.get (local choice) active)
						(then
							(if
								(:doc "Expand a selected decls group in place.")
								(call is_declaration_group (borrow-shared (local source)) (borrow-shared (local nodes)) (local item_parts))
								(then (set (local next) (struct.get (local item_parts) operands)))
								(else
									(if
										(:doc "A short destination preserves the prefix of written declaration indices.")
										(bool.not (i32.lt (local count) (array.len (local output))))
										(then (return (call module_result (local mode) (local name) (local count) (bool true)
											(struct.get (local item) start) (struct.get (local item) end) 16u32))))
									(array.store (local output) (local count) (struct.new SelectedDeclaration (node (local index)) (test (struct.get (local choice) test))))
									(set (local count) (i32.add.wrapping (local count) 1i32))))))
					(if
						(:doc "Only a nonempty selected group takes the walk directly to its first operand.")
						(i32.lt (local next) 0i32)
						(then (set (local next) (call next_declaration (borrow-shared (local nodes)) (local item) (local module)))))
					(set (local index) (local next))))
			(return (call module_result (local mode) (local name) (local count) (bool true) (local start) (local end) 0u32)))))
