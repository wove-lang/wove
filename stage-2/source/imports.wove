(module source_imports
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read declaration names and selective Wove-file and C-header imports from checked source rows.

	Return child indices into the same tree. A malformed operand retains its
	original byte span for the graph diagnostic.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "./scan.wove" (only is_identifier_head is_c_header_provider (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata))

	(struct ImportRead (fields (first i32) (second i32) (start i32) (end i32) (error u32) (namespace u32) (provider u32)))

	(fn import_keyword
		(:doc `Recognize the graph grammar's bare keywords.

		Return 1 for fn, 2 for use, 3 for wove-file, 4 for only,
		5 for as, 6 for type, 7 for struct, 8 for c-header,
		9 for bridge, 10 for params, 11 for returns, 12 for let, 13 for value, 14 for const, and 15 for let-mut.`)
		(params (source (shared-slice u8)) (node SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Only bare atoms have keyword spellings.")
				(bool.not (u32.eq (struct.get (local node) kind) 1u32))
				(then (return 0u32)))
			(let start (struct.get (local node) start))
			(let width (i32.sub.wrapping (struct.get (local node) end) (local start)))
			(if
				(:doc "Match the entire fn spelling.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 102u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 110u8)))
				(then (return 1u32)))
			(if
				(:doc "Match the entire use spelling.")
				(bool.and (i32.eq (local width) 3i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 117u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 115u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 2i32 101u8))))
				(then (return 2u32)))
			(if
				(:doc "Match the entire wove-file spelling.")
				(bool.and (i32.eq (local width) 9i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 119u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 111u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 118u8)
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)
									(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 4i32 45u8)
										(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 5i32 102u8)
											(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 6i32 105u8)
												(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 7i32 108u8)
													(call is_head_byte (borrow-shared (local source)) (local start) 8i32 101u8))))))))))
				(then (return 3u32)))
			(if
				(:doc "Match the entire only spelling.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 111u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 1i32 110u8)
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 2i32 108u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 3i32 121u8)))))
				(then (return 4u32)))
			(if
				(:doc "Match the entire as spelling.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 0i32 97u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 115u8)))
				(then (return 5u32)))
			(if
				(:doc "A type selector uses the full type spelling.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 116u8 121u8 112u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)))
				(then (return 6u32)))
			(if
				(:doc "Structs contribute definitions in a separate namespace.")
				(bool.and (i32.eq (local width) 6i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 115u8 116u8 114u8)
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) 3i32) 117u8 99u8 116u8)))
				(then (return 7u32)))
			(if
				(:doc "C header imports share their provider spelling with bridge definitions.")
				(call is_c_header_provider (borrow-shared (local source)) (local node))
				(then (return 8u32)))
			(if
				(:doc "Match the complete bridge spelling.")
				(bool.and (i32.eq (local width) 6i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 98u8 114u8 105u8)
						(call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32) 100u8 103u8 101u8)))
				(then (return 9u32)))
			(if
				(:doc "Match the complete params spelling.")
				(bool.and (i32.eq (local width) 6i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 112u8 97u8 114u8)
						(call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32) 97u8 109u8 115u8)))
				(then (return 10u32)))
			(if
				(:doc "Match the complete returns spelling.")
				(bool.and (i32.eq (local width) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 114u8 101u8 116u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32) 117u8 114u8 110u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 6i32 115u8))))
				(then (return 11u32)))
			(if
				(:doc "A module value declaration uses the complete let spelling.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 108u8 101u8 116u8))
				(then (return 12u32)))
			(if
				(:doc "An explicit value selector names the value namespace.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 118u8 97u8 108u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 117u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 4i32 101u8))))
				(then (return 13u32)))
			(if
				(:doc "Match the const tag for a native header value.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 111u8 110u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 115u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 4i32 116u8))))
				(then (return 14u32)))
			(if
				(:doc "Match the let-mut tag for writable native storage.")
				(bool.and (i32.eq (local width) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 108u8 101u8 116u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 45u8)
							(call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 4i32) 109u8 117u8 116u8))))
				(then (return 15u32)))
			(return 0u32)))

	(fn is_import_name
		(:doc `Check a bare identifier with the seed's name spelling rules.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(call is_identifier_head (borrow-shared (local source))
					(struct.get (local node) start) (struct.get (local node) end))))))

	(fn import_at
		(:doc `Point a graph grammar result at its originating source node.`)
		(params (node SourceNode) (first i32) (second i32) (error u32))
		(returns ImportRead)
		(body
			(return (struct.new ImportRead (first (local first)) (second (local second))
				(start (struct.get (local node) start)) (end (struct.get (local node) end))
				(error (local error)) (namespace 0u32) (provider 0u32)))))

	(fn import_form
		(:doc `Require a known operand form and check its ordinary metadata context.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (keyword u32))
		(returns ImportRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (struct.get (local parts) head))
			(if
				(:doc "An absent or wrong head is an error on the operand form.")
				(bool.or (i32.lt (local head) 0i32)
					(bool.not (u32.eq (call import_keyword (borrow-shared (local source))
						(slice.load (local nodes) (local head))) (local keyword))))
				(then (return (call import_at (local node) -1i32 -1i32 26u32))))
			(let selection (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts)))
			(if
				(:doc "An invalid selection pragma keeps its own span.")
				(u32.lt 0u32 (struct.get (local selection) error))
				(then (return (struct.new ImportRead (first -1i32) (second -1i32)
					(start (struct.get (local selection) start)) (end (struct.get (local selection) end))
					(error (struct.get (local selection) error)) (namespace 0u32) (provider 0u32)))))
			(return (call import_at (local node) (struct.get (local parts) operands) -1i32 0u32))))

	(fn read_import
		(:doc `Read the provider, quoted key, and first only selector from an active use.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (operands i32))
		(returns ImportRead)
		(body
			(if
				(:doc "An empty use is missing all three required operands.")
				(i32.lt (local operands) 0i32)
				(then (return (call import_at (local node) -1i32 -1i32 26u32))))
			(let provider (slice.load (local nodes) (local operands)))
			(let kind (call import_keyword (borrow-shared (local source)) (local provider)))
			(if
				(:doc "File paths and C header keys use their own provider names.")
				(bool.not (bool.or (u32.eq (local kind) 3u32) (u32.eq (local kind) 8u32)))
				(then (return (call import_at (local provider) -1i32 -1i32 26u32))))
			(let path (struct.get (local provider) next_sibling))
			(if
				(:doc "The provider is followed by a path token.")
				(i32.lt (local path) 0i32)
				(then (return (call import_at (local node) -1i32 -1i32 26u32))))
			(let literal (slice.load (local nodes) (local path)))
			(if
				(:doc "The path uses a checked quoted or raw string.")
				(bool.not (u32.eq (struct.get (local literal) kind) 2u32))
				(then (return (call import_at (local literal) -1i32 -1i32 26u32))))
			(let list (struct.get (local literal) next_sibling))
			(if
				(:doc "The use must end with an explicit selection list, even when it is empty.")
				(i32.lt (local list) 0i32)
				(then (return (call import_at (local node) -1i32 -1i32 26u32))))
			(let list_node (slice.load (local nodes) (local list)))
			(let extra (struct.get (local list_node) next_sibling))
			(if
				(:doc "An unexpected operand points at its own node.")
				(bool.not (i32.lt (local extra) 0i32))
				(then (return (call import_at (slice.load (local nodes) (local extra)) -1i32 -1i32 26u32))))
			(let only (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local list_node) 4u32))
			(if
				(:doc "Return the original error before interpreting the selection list.")
				(u32.lt 0u32 (struct.get (local only) error))
				(then (return (local only))))
			(return (struct.new ImportRead (first (local path)) (second (struct.get (local only) first))
				(start (struct.get (local node) start)) (end (struct.get (local node) end))
				(error 0u32) (namespace 0u32) (provider (local kind))))))

	(fn read_name_selector
		(:doc `Read a bare or aliased selector. The binder checks the local spelling.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns ImportRead)
		(body
			(let item (slice.load (local nodes) (local index)))
			(if
				(:doc "An unrenamed selection uses the same spelling in both files.")
				(call is_import_name (borrow-shared (local source)) (local item))
				(then (return (call import_at (local item) (local index) (local index) 0u32))))
			(let alias (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local item) 5u32))
			(if
				(:doc "An alias must be a checked as form.")
				(u32.lt 0u32 (struct.get (local alias) error))
				(then (return (local alias))))
			(let original (struct.get (local alias) first))
			(if
				(:doc "An alias requires both the provider name and local name.")
				(i32.lt (local original) 0i32)
				(then (return (call import_at (local item) -1i32 -1i32 26u32))))
			(let original_node (slice.load (local nodes) (local original)))
			(let local_name (struct.get (local original_node) next_sibling))
			(if
				(:doc "An omitted local name leaves the alias form incomplete.")
				(i32.lt (local local_name) 0i32)
				(then (return (call import_at (local item) -1i32 -1i32 26u32))))
			(let local_node (slice.load (local nodes) (local local_name)))
			(let extra (struct.get (local local_node) next_sibling))
			(if
				(:doc "The alias has exactly two operands.")
				(bool.not (i32.lt (local extra) 0i32))
				(then (return (call import_at (slice.load (local nodes) (local extra)) -1i32 -1i32 26u32))))
			(if
				(:doc "Check the provider name at its own spelling.")
				(bool.not (call is_import_name (borrow-shared (local source)) (local original_node)))
				(then (return (call import_at (local original_node) -1i32 -1i32 26u32))))
			(return (call import_at (local item) (local original) (local local_name) 0u32))))

	(fn read_selector
		(:doc `Read an unqualified, type, or value selector with the same name and alias grammar.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns ImportRead)
		(body
			(let item (slice.load (local nodes) (local index)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(let head (struct.get (local parts) head))
			(if
				(:doc "A bare name uses ordinary provider lookup.")
				(i32.lt (local head) 0i32)
				(then (return (call read_name_selector (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))))
			(let tag (call import_keyword (borrow-shared (local source)) (slice.load (local nodes) (local head))))
			(if
				(:doc "An unqualified as form uses the same lookup as a bare name.")
				(bool.not (bool.or (u32.eq (local tag) 6u32) (u32.eq (local tag) 13u32)))
				(then (return (call read_name_selector (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))))
			(let wrapper (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local item) (local tag)))
			(if
				(:doc "A namespace wrapper keeps its own metadata diagnostic.")
				(u32.lt 0u32 (struct.get (local wrapper) error))
				(then (return (local wrapper))))
			(let member (struct.get (local wrapper) first))
			(if
				(:doc "A namespace wrapper accepts exactly one selector.")
				(bool.or (i32.lt (local member) 0i32)
					(bool.not (i32.lt (struct.get (slice.load (local nodes) (local member)) next_sibling) 0i32)))
				(then (return (call import_at (local item) -1i32 -1i32 26u32))))
			(let selected (call read_name_selector (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
			(let-mut namespace 1u32)
			(if
				(:doc "An explicit value selector bypasses the function namespace.")
				(u32.eq (local tag) 13u32)
				(then (set (local namespace) 2u32)))
			(return (struct.new ImportRead (first (struct.get (local selected) first)) (second (struct.get (local selected) second))
				(start (struct.get (local selected) start)) (end (struct.get (local selected) end))
				(error (struct.get (local selected) error)) (namespace (local namespace)) (provider 0u32))))))
