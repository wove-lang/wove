(module source_exports
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read the library export directive from attached declaration metadata.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let export_word "c_export")

	(fn c_export_directive
		(:doc "Return the first attached c_export directive, or -1 when absent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (form SourceNode))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)))
			(let-mut row (struct.get (local parts) metadata))
			(while
				(:doc "Only the owning declaration's pragma metadata can request a C export.")
				(i32.not-ltz (local row))
				(body
					(let metadata (array.load (local nodes) (local row)))
					(let head (array.load (local nodes) (struct.get (local metadata) first_child)))
					(if
						(:doc "Other metadata can mention c_export without enabling it.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let-mut directive (struct.get (local head) next_sibling))
							(while
								(:doc "Inspect directive heads in source order.")
								(i32.not-ltz (local directive))
								(body
									(let item (array.load (local nodes) (local directive)))
									(let member (struct.get (local item) first_child))
									(if
										(:doc "Require the exact bare pragma name.")
										(i32.not-ltz (local member))
										(then
											(let name (array.load (local nodes) (local member)))
											(if
												(:doc "Use the first attached spelling as the diagnostic site.")
												(bool.and (u32.eq (struct.get (local name) kind) 1u32)
													(call same_bytes (borrow-shared (local source)) (struct.get (local name) start)
														(struct.get (local name) end) (borrow-shared (local export_word)) 0i32 8i32))
												(then (return (local directive))))))
									(set (local directive) (struct.get (local item) next_sibling))))))
					(set (local row) (call next_form_metadata (borrow-shared (local source))
						(borrow-shared (local nodes)) (local parts) (local metadata)))))
			(return -1i32)))
)
