(module source_assets
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Decode a checked embed path and keep asset payloads separate from Wove source selection.`)

	(use wove-file "./scan.wove" (only (type Token)))
	(use wove-file "./strings.wove" (only decode_string))

	(struct EmbedAsset
		(fields (path_start i32) (path_end i32) (bytes_start i32) (bytes_end i32)))

	(struct EmbedCheck (fields (count i32) (file i32) (start i32) (end i32) (error u32)))

	(fn embed_check
		(:doc `Return a prepared count or the originating asset-path diagnostic.`)
		(params (count i32) (file i32) (start i32) (end i32) (error u32))
		(returns EmbedCheck)
		(body
			(return (record.make EmbedCheck (count (local count)) (file (local file))
				(start (local start)) (end (local end)) (error (local error))))))

	(fn decode_asset_path
		(:doc `Return the decoded length of a file path, or -1 for an invalid value or directory-only ending.`)
		(params (arena (shared-slice u8)) (start i32) (end i32) (output (mut-slice u8)))
		(returns i32)
		(body
			(let decoded (call decode_string (borrow-shared (local arena))
				(record.make Token (kind (u32 2)) (start (local start)) (end (local end)) (error (u32 0)))
				(borrow-mut (local output))))
			(let length (record.get (local decoded) written))
			(if
				(:doc "A path needs a complete decoded value and at least one byte.")
				(bool.or (u32.lt (u32 0) (record.get (local decoded) error)) (i32.eq (local length) (i32 0)))
				(then (return (i32 -1))))
			(let-mut index (i32 0))
			(let-mut component (i32 0))
			(while
				(:doc "Reject NUL and remember where the final decoded path component starts.")
				(i32.lt (local index) (local length))
				(body
					(let byte (slice.load (local output) (local index)))
					(if (u8.eq (local byte) (u8 0)) (then (return (i32 -1))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))
					(if (u8.eq (local byte) (u8 47)) (then (set (local component) (local index))))))
			(let width (i32.sub.wrapping (local length) (local component)))
			(if
				(:doc "A final slash requires the preceding name to resolve to a directory.")
				(i32.eq (local width) (i32 0))
				(then (return (i32 -1))))
			(if
				(:doc "A final dot or parent component denotes a directory before graph normalization.")
				(bool.and (i32.lt (local width) (i32 3))
					(bool.and (u8.eq (slice.load (local output) (local component)) (u8 46))
						(bool.or (i32.eq (local width) (i32 1))
							(u8.eq (slice.load (local output) (i32.add.wrapping (local component) (i32 1))) (u8 46)))))
				(then (return (i32 -1))))
			(return (local length)))))
