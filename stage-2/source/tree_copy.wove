(module source_tree_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Copy source trees into graph views with links and source spans rebased.")

	(use wove-file "./scan.wove" (only (type SourceNode)))

	(fn rebase_link
		(:doc `Rebase a present tree link while retaining the missing-link sentinel.`)
		(params (index i32) (base i32))
		(returns i32)
		(body
			(if
				(:doc "A missing local link remains missing in the flat table.")
				(i32:ltz index)
				(then (return index)))
			(return (i32:add base index))))

	(fn copy_tree
		(:doc `Copy the checked file's tree into its reserved range with arena-relative spans.`)
		(params (nodes (shared-array SourceNode)) (flat (mut-array SourceNode)) (base i32) (source_base i32))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Translate the file's own links and copy the available source span.")
				(i32:lt index nodes.len)
				(body
					(let node (nodes.get index))
					(flat.set (i32:add base index)
						(struct:new SourceNode (kind (struct:get node kind))
							(start (i32:add source_base (struct:get node start)))
							(end (i32:add source_base (struct:get node end)))
							(parent (call rebase_link (struct:get node parent) base))
							(first_child (call rebase_link (struct:get node first_child) base))
							(next_sibling (call rebase_link (struct:get node next_sibling) base))
							(bridge_project -1i32) (bridge_default -1i32)
							(generic_kind (struct:get node generic_kind)) (generic_value (struct:get node generic_value))
							(local_identity 0u32) (local_name_slot -1i32)
							(expression_identity 0u32) (expression_slot 0i32)
							(label_identity 0u32) (label_slot 0i32)))
					(set index (i32:inc index))))))
)
