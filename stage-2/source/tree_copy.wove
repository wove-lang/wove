(module source_tree_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Copy source trees into graph views with links and source spans rebased.")

	(use wove-file "./scan.wove" (only (type SourceNode)))

	(fn rebase_link
		(:doc `Rebase a present tree link while retaining the missing-link sentinel.`)
		(params (index i32) (base i32))
		(returns i32)
		(body
			(if
				(:doc "A missing local link remains missing in the flat table.")
				index.ltz
				(then (return index)))
			(return (base.add index))))

	(fn copy_tree
		(:doc `Copy the checked file's tree into its reserved range with arena-relative spans.`)
		(params (nodes (shared-array SourceNode)) (flat (mut-array SourceNode)) (base i32) (source_base i32))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Translate the file's own links and copy the available source span.")
				(index.lt nodes.len)
				(body
					(let node (nodes.get index))
					(flat.set (base.add index)
						(struct:new SourceNode (kind node/kind)
							(start (source_base.add node/start))
							(end (source_base.add node/end))
							(parent (call rebase_link node/parent base))
							(first_child (call rebase_link node/first_child base))
							(next_sibling (call rebase_link node/next_sibling base))
							(bridge_project -1i32) (bridge_default -1i32)
							(generic_kind node/generic_kind) (generic_value node/generic_value)
							(c_ordinal -1i32)))
					(set index index.inc)))))
)
