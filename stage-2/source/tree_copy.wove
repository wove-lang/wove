(module source_tree_copy
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Copy source trees into graph views with links and source spans rebased.")

	(use wove-file "./scan.wove" (only (type SourceNode)))

	(fn rebase_link
		(:doc `Rebase a present tree link while retaining the missing-link sentinel.`)
		(params (index i32) (base i32))
		(returns i32)
		(body
			(if
				(:doc "A missing local link remains missing in the flat table.")
				(i32.lt (local index) 0i32)
				(then (return (local index))))
			(return (i32.add.wrapping (local base) (local index)))))

	(fn copy_tree
		(:doc `Copy the checked file's tree into its reserved range with arena-relative spans.`)
		(params (nodes (shared-slice SourceNode)) (flat (mut-slice SourceNode)) (base i32) (source_base i32))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Translate the file's own links and copy the available source span.")
				(i32.lt (local index) (slice.len (local nodes)))
				(body
					(let node (slice.load (local nodes) (local index)))
					(slice.store (local flat) (i32.add.wrapping (local base) (local index))
						(struct.new SourceNode (kind (struct.get (local node) kind))
							(start (i32.add.wrapping (local source_base) (struct.get (local node) start)))
							(end (i32.add.wrapping (local source_base) (struct.get (local node) end)))
							(parent (call rebase_link (struct.get (local node) parent) (local base)))
							(first_child (call rebase_link (struct.get (local node) first_child) (local base)))
							(next_sibling (call rebase_link (struct.get (local node) next_sibling) (local base)))
							(bridge_project -1i32) (bridge_default -1i32)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))))
)
