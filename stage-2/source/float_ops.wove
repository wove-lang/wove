(module source_float_ops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize floating arithmetic, comparisons, and decimal literal spellings.

	The operator ranges use the same order. The planner can recover
	the exact operand width and evaluation shape from the checked opcode.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_float (value f16_type) (value f32_type) (value f64_type) (value f80_type) (value f128_type)))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let first_f32_operator 118u32)
	(let first_f64_operator 129u32)
	(let float_conversion 140u32)
	(let float_from_bits 141u32)
	(let float_to_bits 142u32)
	(let float_literal 143u32)
	(let first_f16_operator 512u32)
	(let first_f80_operator 523u32)
	(let first_f128_operator 534u32)
	(let f128_operator_end 545u32)
	(let operator_symbols "+-*/-=!<>LG")
	(let inequality_suffix "not-eq")

	(fn is_float_operator
		(:doc `Identify the checked floating arithmetic and comparison opcode ranges.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or
			(bool.and (u32.not-lt (local kind) (local first_f32_operator)) (u32.lt (local kind) (local float_conversion)))
			(bool.and (u32.not-lt (local kind) (local first_f16_operator)) (u32.lt (local kind) (local f128_operator_end)))))))

	(fn is_float_conversion
		(:doc `Identify unary checked numeric conversions and bit copies involving a float.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local float_conversion))
			(u32.lt (local kind) (local float_literal))))))

	(fn float_operator_type
		(:doc `Recover the exact operand type from the range that contains the opcode.`)
		(params (kind u32))
		(returns u32)
		(body
			(if (u32.not-lt (local kind) (local first_f128_operator)) (then (return (local f128_type))))
			(if (u32.not-lt (local kind) (local first_f80_operator)) (then (return (local f80_type))))
			(if (u32.not-lt (local kind) (local first_f16_operator)) (then (return (local f16_type))))
			(if (u32.lt (local kind) (local first_f64_operator)) (then (return (local f32_type))))
			(return (local f64_type))))

	(fn float_operator_slot
		(:doc `Return the common operator index within its checked float width.`)
		(params (kind u32))
		(returns i32)
		(body
			(let type (call float_operator_type (local kind)))
			(let base (call float_operator_base (local type)))
			(return (i32.from-u32 (u32.sub (local kind) (local base))))))

	(fn float_operator_base
		(:doc "Select the base shared by parsing and decoding a width's arithmetic and comparisons.")
		(params (type u32)) (returns u32)
		(body
			(if (u32.eq (local type) (local f16_type)) (then (return (local first_f16_operator))))
			(if (u32.eq (local type) (local f64_type)) (then (return (local first_f64_operator))))
			(if (u32.eq (local type) (local f80_type)) (then (return (local first_f80_operator))))
			(if (u32.eq (local type) (local f128_type)) (then (return (local first_f128_operator))))
			(return (local first_f32_operator))))

	(fn float_operator_symbol
		(:doc `Read the C operator marker for a checked slot. L and G denote inclusive comparisons.`)
		(params (slot i32))
		(returns u8)
		(body (return (array.load (local operator_symbols) (local slot)))))

	(fn float_operator_slot_at
		(:doc `Match the full suffix and return its common operator index.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns i32)
		(body
			(if
				(:doc "Arithmetic operations and unary negation use three-letter spellings.")
				(i32.eq (local width) 3i32)
				(then
					(if (call is_three_bytes (borrow-shared (local source)) (local start) 97u8 100u8 100u8) (then (return 0i32)))
					(if (call is_three_bytes (borrow-shared (local source)) (local start) 115u8 117u8 98u8) (then (return 1i32)))
					(if (call is_three_bytes (borrow-shared (local source)) (local start) 109u8 117u8 108u8) (then (return 2i32)))
					(if (call is_three_bytes (borrow-shared (local source)) (local start) 100u8 105u8 118u8) (then (return 3i32)))
					(if (call is_three_bytes (borrow-shared (local source)) (local start) 110u8 101u8 103u8) (then (return 4i32)))
					(return -1i32)))
			(if
				(:doc "Compare the complete inequality suffix before reading the two-byte predicates.")
				(i32.eq (local width) 6i32)
				(then
					(if
						(:doc "Keep the established native inequality spelling for each float width.")
						(call same_bytes (borrow-shared (local source)) (local start)
							(i32.add (local start) (local width)) (borrow-shared (local inequality_suffix)) 0i32 6i32)
						(then (return 6i32)))
					(return -1i32)))
			(let first (array.load (local source) (local start)))
			(let second (array.load (local source) (i32.inc (local start))))
			(if (bool.and (u8.eq (local first) 101u8) (u8.eq (local second) 113u8)) (then (return 5i32)))
			(if
				(:doc "Inclusive ordering predicates end in e.")
				(u8.eq (local second) 101u8)
				(then
					(if (u8.eq (local first) 108u8) (then (return 9i32)))
					(if (u8.eq (local first) 103u8) (then (return 10i32)))))
			(if
				(:doc "Distinguish the strict ordering operators by their first letter.")
				(u8.eq (local second) 116u8)
				(then
					(if (u8.eq (local first) 108u8) (then (return 7i32)))
					(if (u8.eq (local first) 103u8) (then (return 8i32)))))
			(return -1i32)))

	(fn float_operator_keyword
		(:doc `Read a complete floating arithmetic or comparison head.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(let start (struct.get (local node) start))
			(let width (i32.sub (struct.get (local node) end) (local start)))
			(if
				(:doc "The shortest floating operator has a three-byte type, a dot, and a two-byte suffix.")
				(bool.or (i32.lt (local width) 6i32)
					(bool.not (call is_byte_at (borrow-shared (local source)) (local start) 0i32 102u8)))
				(then (return 0u32)))
			(let-mut prefix 3i32)
			(if
				(:doc "The binary128 operator head has its dot after four bytes.")
				(bool.not (call is_byte_at (borrow-shared (local source)) (local start) 3i32 46u8))
				(then
					(if (bool.not (call is_byte_at (borrow-shared (local source)) (local start) 4i32 46u8))
						(then (return 0u32)))
					(set (local prefix) 4i32)))
			(let offset (i32.inc (local prefix)))
			(let suffix (i32.sub (local width) (local offset)))
			(if
				(:doc "The shared operator matcher reads complete arithmetic or comparison suffixes.")
				(bool.not (bool.or (i32.eq (local suffix) 2i32)
					(bool.or (i32.eq (local suffix) 3i32) (i32.eq (local suffix) 6i32))))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local prefix)))
			(if (bool.not (call is_builtin_float (local type))) (then (return 0u32)))
			(let slot (call float_operator_slot_at (borrow-shared (local source))
				(i32.add (local start) (local offset)) (local suffix)))
			(if (i32.ltz (local slot)) (then (return 0u32)))
			(let base (call float_operator_base (local type)))
			(return (u32.add (local base) (u32.from-i32 (local slot))))))

	(fn decimal_run_end
		(:doc `Find the first non-digit in a bounded ASCII run.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "Read only bytes in this literal's span.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (array.load (local source) (local cursor)))
					(if
						(:doc "A decimal run ends at anything outside ASCII zero through nine.")
						(bool.or (u8.lt (local byte) 48u8) (u8.lt 57u8 (local byte)))
						(then (return (local cursor))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (local cursor))))

	(fn float_literal_shape
		(:doc `Validate a signed decimal spelling and tell the C writer when to append .0.

		A fraction and an exponent are optional. Each present part needs a
		digit. Return 0 for malformed input, 1 for a C floating spelling,
		and 2 for an integer-shaped spelling. Keep the exact digits for
		direct rounding at the destination width.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(if (i32.not-lt (local start) (local end)) (then (return 0i32)))
			(let-mut digits (local start))
			(if
				(:doc "Keep the leading minus in the source spelling and scan digits after it.")
				(u8.eq (array.load (local source) (local start)) 45u8)
				(then (set (local digits) (i32.inc (local digits)))))
			(let-mut cursor (call decimal_run_end (borrow-shared (local source)) (local digits) (local end)))
			(if (i32.eq (local cursor) (local digits)) (then (return 0i32)))
			(if (i32.eq (local cursor) (local end)) (then (return 2i32)))
			(if
				(:doc "A written point must be followed by a nonempty fraction.")
				(u8.eq (array.load (local source) (local cursor)) 46u8)
				(then
					(set (local digits) (i32.inc (local cursor)))
					(set (local cursor) (call decimal_run_end (borrow-shared (local source)) (local digits) (local end)))
					(if (i32.eq (local cursor) (local digits)) (then (return 0i32)))
					(if (i32.eq (local cursor) (local end)) (then (return 1i32)))))
			(let exponent (array.load (local source) (local cursor)))
			(if
				(:doc "Only an exponent marker can follow the whole or fractional part.")
				(bool.not (bool.or (u8.eq (local exponent) 101u8) (u8.eq (local exponent) 69u8)))
				(then (return 0i32)))
			(set (local digits) (i32.inc (local cursor)))
			(if (i32.eq (local digits) (local end)) (then (return 0i32)))
			(let sign (array.load (local source) (local digits)))
			(if
				(:doc "The exponent permits either sign before its digits.")
				(bool.or (u8.eq (local sign) 43u8) (u8.eq (local sign) 45u8))
				(then (set (local digits) (i32.inc (local digits)))))
			(if
				(:doc "The exponent must have a digit and consume the rest of the token.")
				(bool.and (i32.lt (local digits) (local end))
					(i32.eq (call decimal_run_end (borrow-shared (local source)) (local digits) (local end)) (local end)))
				(then (return 1i32)))
			(return 0i32))))
