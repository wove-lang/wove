(module source_c_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read borrowed and allocating C text snapshot contracts and their exact Wove result.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./owned.wove" (only is_byte_rows_descriptor))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct CSnapshot (fields (active bool) (drop i32) (start i32) (end i32) (error u32)))

	(let snapshot_keyword "c_snapshot")
	(let vectors_kind "cstrs")
	(let function_result 0u32)
	(let readonly_global 1u32)
	(let other_global 2u32)
	(let text_kind "cstr")
	(let drop_keyword "drop")
	(let optional_keyword "optional")
	(let owner_keyword "owned-array")

	(fn matches_atom
		(:doc `Compare a checked bare atom with the entire contract keyword.`)
		(params (source (shared-slice u8)) (node SourceNode) (spelling (shared-slice u8)))
		(returns bool)
		(body (return (bool.and (u32.eq (record.get (local node) kind) 1u32)
			(call same_bytes (borrow-shared (local source)) (record.get (local node) start) (record.get (local node) end)
				(borrow-shared (local spelling)) 0i32 (slice.len (local spelling)))))))

	(fn has_head
		(:doc `Match the head of a descriptor with no metadata and at least one operand.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (form FormParts) (spelling (shared-slice u8)))
		(returns bool)
		(body (return (bool.and (bool.and (i32.lt -1i32 (record.get (local form) head))
			(i32.lt -1i32 (record.get (local form) operands)))
			(bool.and (i32.lt (record.get (local form) metadata) 0i32)
				(call matches_atom (borrow-shared (local source)) (slice.load (local nodes) (record.get (local form) head))
					(borrow-shared (local spelling))))))))

	(fn is_optional_byte_owner
		(:doc `Recognize the snapshot result descriptor (optional (owned-array u8)).`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (result SourceNode))
		(returns bool)
		(body
			(let outer (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local result)))
			(if
				(:doc "The optional descriptor must enclose one owner type.")
				(bool.not (call has_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local outer)
					(borrow-shared (local optional_keyword))))
				(then (return (bool false))))
			(let owner (slice.load (local nodes) (record.get (local outer) operands)))
			(let inner (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local owner)))
			(if
				(:doc "Only the exact byte owner is available for a C text snapshot.")
				(bool.or (i32.lt -1i32 (record.get (local owner) next_sibling))
					(bool.not (call has_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local inner)
						(borrow-shared (local owner_keyword)))))
				(then (return (bool false))))
			(let element (slice.load (local nodes) (record.get (local inner) operands)))
			(return (bool.and (i32.lt (record.get (local element) next_sibling) 0i32)
				(u32.eq (call source_builtin_type (borrow-shared (local source)) (local element)) 10u32)))))

	(fn snapshot_at
		(:doc `Retain whether text is copied, its optional release symbol, and the source span.`)
		(params (node SourceNode) (active bool) (drop i32) (error u32))
		(returns CSnapshot)
		(body (return (record.make CSnapshot (active (local active)) (drop (local drop)) (start (record.get (local node) start))
			(end (record.get (local node) end)) (error (local error))))))

	(fn read_snapshot_directive
		(:doc `Read the snapshot kind and any release allowed at this declaration.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (directive SourceNode) (start i32) (scope u32))
		(returns CSnapshot)
		(body
			(if (i32.lt (local start) 0i32) (then (return (call snapshot_at (local directive) (bool false) -1i32 23u32))))
			(let kind (slice.load (local nodes) (local start)))
			(let next (record.get (local kind) next_sibling))
			(if
				(:doc "Only a read-only global can snapshot a borrowed vector. It has no release operand.")
				(bool.not (u32.eq (local scope) (local function_result)))
				(then
					(if
						(:doc "A global snapshot requires one bare cstrs operand.")
						(bool.and (bool.and (u32.eq (local scope) (local readonly_global)) (i32.lt (local next) 0i32))
							(call matches_atom (borrow-shared (local source)) (local kind) (borrow-shared (local vectors_kind))))
						(then (return (call snapshot_at (local directive) (bool true) -1i32 0u32))))
					(return (call snapshot_at (local directive) (bool false) -1i32 23u32))))
			(if
				(:doc "Only the C string snapshot kind is implemented here.")
				(bool.not (call matches_atom (borrow-shared (local source)) (local kind) (borrow-shared (local text_kind))))
				(then (return (call snapshot_at (local directive) (bool false) -1i32 23u32))))
			(if
				(:doc "An omitted drop contract means the native string is borrowed.")
				(i32.lt (local next) 0i32)
				(then (return (call snapshot_at (local directive) (bool true) -1i32 0u32))))
			(let drop (slice.load (local nodes) (local next)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local drop)))
			(if
				(:doc "An allocating snapshot must have one complete drop contract.")
				(bool.or (i32.lt -1i32 (record.get (local drop) next_sibling))
					(bool.not (call has_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts)
						(borrow-shared (local drop_keyword)))))
				(then (return (call snapshot_at (local drop) (bool false) -1i32 23u32))))
			(let release (record.get (local parts) operands))
			(let symbol (slice.load (local nodes) (local release)))
			(if
				(:doc "Keep the symbol's defining span when it cannot name a C function.")
				(bool.or (i32.lt -1i32 (record.get (local symbol) next_sibling))
					(bool.not (call is_native_name (borrow-shared (local source)) (local symbol))))
				(then (return (call snapshot_at (local symbol) (bool false) -1i32 23u32))))
			(return (call snapshot_at (local directive) (bool true) (local release) 0u32))))

	(fn read_snapshot_contract
		(:doc `Read at most one snapshot from a selected declaration and check its Wove type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration FormParts)
			(result SourceNode) (scope u32))
		(returns CSnapshot)
		(body
			(let-mut active (bool false))
			(let-mut drop -1i32)
			(let-mut entry (record.get (local declaration) metadata))
			(while
				(:doc "Search the declaration's attached metadata for native snapshot contracts.")
				(i32.lt -1i32 (local entry))
				(body
					(let node (slice.load (local nodes) (local entry)))
					(let head (slice.load (local nodes) (record.get (local node) first_child)))
					(if
						(:doc "A snapshot must appear as a direct pragma directive.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let-mut index (record.get (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)) operands))
							(while
								(:doc "Find the exact contract and reject a second snapshot on the same declaration.")
								(i32.lt -1i32 (local index))
								(body
									(let item (slice.load (local nodes) (local index)))
									(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
									(let tag (record.get (local parts) head))
									(if
										(:doc "Other pragmas remain handled by their own readers.")
										(bool.and (i32.lt -1i32 (local tag))
											(call matches_atom (borrow-shared (local source)) (slice.load (local nodes) (local tag))
												(borrow-shared (local snapshot_keyword))))
										(then
											(if
												(:doc "Reject a second C snapshot at the repeated directive.")
												(local active)
												(then (return (call snapshot_at (local item) (bool false) -1i32 23u32))))
											(let current (call read_snapshot_directive (borrow-shared (local source)) (borrow-shared (local nodes))
												(local item) (record.get (local parts) operands) (local scope)))
											(if (u32.lt 0u32 (record.get (local current) error)) (then (return (local current))))
											(set (local active) (bool true))
											(set (local drop) (record.get (local current) drop))))
									(set (local index) (record.get (local item) next_sibling))))))
					(set (local entry) (call next_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local declaration) (local node)))))
			(if
				(:doc "A global vector snapshot yields an ordinary owned array of byte owners.")
				(bool.not (u32.eq (local scope) (local function_result)))
				(then
					(if
						(:doc "Check the exact result descriptor only on an annotated global.")
						(bool.and (local active)
							(bool.not (call is_byte_rows_descriptor (borrow-shared (local source)) (borrow-shared (local nodes)) (local result))))
						(then (return (call snapshot_at (local result) (bool false) -1i32 23u32))))
					(return (call snapshot_at (local result) (local active) -1i32 0u32))))
			(let optional (call is_optional_byte_owner (borrow-shared (local source)) (borrow-shared (local nodes)) (local result)))
			(if
				(:doc "The snapshot and the optional byte owner result require each other.")
				(bool.or (bool.and (local active) (bool.not (local optional)))
					(bool.and (local optional) (bool.not (local active))))
				(then (return (call snapshot_at (local result) (bool false) -1i32 23u32))))
			(return (call snapshot_at (local result) (local active) (local drop) 0u32))))

	(fn read_c_snapshot
		(:doc `Check a function result's optional borrowed or allocating C string contract.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function FormParts) (result SourceNode))
		(returns CSnapshot)
		(body (return (call read_snapshot_contract (borrow-shared (local source)) (borrow-shared (local nodes))
			(local function) (local result) (local function_result)))))

	(fn read_c_vector_snapshot
		(:doc `Check a native value's optional contract for copying a borrowed C string table.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (binding FormParts)
			(type SourceNode) (readonly bool))
		(returns CSnapshot)
		(body
			(let-mut scope (local other_global))
			(if
				(:doc "Only a read-only native let can declare a vector snapshot.")
				(local readonly)
				(then (set (local scope) (local readonly_global))))
			(return (call read_snapshot_contract (borrow-shared (local source)) (borrow-shared (local nodes))
				(local binding) (local type) (local scope)))))
)
