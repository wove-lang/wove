(module source_c_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read C text and record snapshot contracts and their exact Wove results.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./owned.wove" (only optional_type_operand is_byte_rows_descriptor))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct CSnapshot (fields (active bool) (drop i32) (field i32) (extent i32) (from i32)
			(record i32) (start i32) (end i32) (error u32)))

	(let snapshot_keyword "c_snapshot")
	(let vectors_kind "cstrs")
	(let function_result 0u32)
	(let readonly_global 1u32)
	(let other_global 2u32)
	(let writable_string_global 3u32)
	(let text_kind "cstr")
	(let record_kind "record")
	(let lifetime_keyword "lifetime")
	(let thread_local_lifetime "thread_local")
	(let drop_keyword "drop")
	(let field_keyword "field")
	(let extent_keyword "extent")
	(let from_keyword "from")
	(let owner_keyword "owned-array")

	(fn matches_atom
		(:doc `Compare a checked bare atom with the entire contract keyword.`)
		(params (source (shared-array u8)) (node SourceNode) (spelling (shared-array u8)))
		(returns bool)
		(body (return (bool:and (node/kind.eq 1u32)
			(call same_bytes (borrow-shared source) node/start node/end
				(borrow-shared spelling) 0i32 spelling.len)))))

	(fn has_head
		(:doc `Match the head of a descriptor with no metadata and at least one operand.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (form FormParts) (spelling (shared-array u8)))
		(returns bool)
		(body (return (bool:and (bool:and (i32:lt -1i32 form/head)
			(i32:lt -1i32 form/operands))
			(bool:and form/metadata.ltz
				(call matches_atom (borrow-shared source) (nodes.get form/head)
					(borrow-shared spelling)))))))

	(fn is_optional_byte_owner
		(:doc `Recognize the snapshot result descriptor (optional (owned-array u8)).`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (result SourceNode))
		(returns bool)
		(body
			(let operand (call optional_type_operand (borrow-shared source) (borrow-shared nodes) result))
			(if operand.ltz (then (return (bool false))))
			(let owner (nodes.get operand))
			(let inner (call form_parts (borrow-shared source) (borrow-shared nodes) owner))
			(if
				(:doc "Only the exact byte owner is available for a C text snapshot.")
				(bool:not (call has_head (borrow-shared source) (borrow-shared nodes) inner
					(borrow-shared owner_keyword)))
				(then (return (bool false))))
			(let element (nodes.get inner/operands))
			(return (bool:and element/next_sibling.ltz
				(u32:eq (call source_builtin_type (borrow-shared source) element) 10u32)))))

	(fn snapshot_at
		(:doc `Retain the snapshot shape, its optional release or field, and the source span.`)
		(params (node SourceNode) (active bool) (drop i32) (field i32) (error u32))
		(returns CSnapshot)
		(body (return (struct:new CSnapshot (active active) (drop drop) (field field) (extent -1i32) (from -1i32)
			(record -1i32) (start node/start)
			(end node/end) (error error)))))

	(fn record_snapshot_at
		(:doc "Retain the named mapping on a borrowed record result.")
		(params (node SourceNode) (name i32))
		(returns CSnapshot)
		(body (return (struct:new CSnapshot (active (bool true)) (drop -1i32) (field -1i32) (extent -1i32) (from -1i32)
			(record name) (start node/start) (end node/end) (error 0u32)))))

	(fn field_snapshot_at
		(:doc "Retain the native field and extent and the optional source loan name.")
		(params (node SourceNode) (field i32) (extent i32) (from i32))
		(returns CSnapshot)
		(body (return (struct:new CSnapshot (active (bool true)) (drop -1i32) (field field)
			(extent extent) (from from) (record -1i32) (start node/start)
			(end node/end) (error 0u32)))))

	(fn snapshot_option_name
		(:doc "Read one checked native member or borrow name from an attached clause.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (option SourceNode)
			(keyword (shared-array u8))) (returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) option))
			(if
				(:doc "The clause header fixes the role of its sole operand.")
				(bool:not (call has_head (borrow-shared source) (borrow-shared nodes) parts
					(borrow-shared keyword)))
				(then (return -1i32)))
			(let name parts/operands)
			(let atom (nodes.get name))
			(if
				(:doc "An option takes one identifier suitable for the native field or formal.")
				(bool:or atom/next_sibling.not-ltz
					(bool:not (call is_native_name (borrow-shared source) atom)))
				(then (return -1i32)))
			(return name)))

	(fn read_field_snapshot
		(:doc "Extend a fixed inline field with a native byte extent and an optional source loan.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (directive SourceNode)
			(field i32) (after_field i32)) (returns CSnapshot)
		(body
			(if
				(:doc "The existing field-only form keeps its nominal C array bound.")
				after_field.ltz
				(then (return (call snapshot_at directive (bool true) -1i32 field 0u32))))
			(let bound (nodes.get after_field))
			(let extent (call snapshot_option_name (borrow-shared source) (borrow-shared nodes) bound
				(borrow-shared extent_keyword)))
			(if extent.ltz (then (return (call snapshot_at bound (bool false) -1i32 -1i32 23u32))))
			(let after_extent bound/next_sibling)
			(if after_extent.ltz (then (return (call field_snapshot_at directive field extent -1i32))))
			(let origin (nodes.get after_extent))
			(let from (call snapshot_option_name (borrow-shared source) (borrow-shared nodes) origin
				(borrow-shared from_keyword)))
			(if
				(:doc "The source-loan name is the final clause of the extended field contract.")
				(bool:or from.ltz origin/next_sibling.not-ltz)
				(then (return (call snapshot_at origin (bool false) -1i32 -1i32 23u32))))
			(return (call field_snapshot_at directive field extent from))))

	(fn read_snapshot_directive
		(:doc `Read the snapshot kind and any release allowed at this declaration.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (directive SourceNode) (start i32) (scope u32))
		(returns CSnapshot)
		(body
			(if start.ltz (then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
			(let kind (nodes.get start))
			(let next kind/next_sibling)
			(if
				(:doc "Global storage lends an existing string or vector without a release operand.")
				(scope.not-eq function_result)
				(then
					(if
						(:doc "The explicit writable contract allows a single C string. Read-only globals retain the vector contract.")
						(bool:and next.ltz
							(bool:or (bool:and (scope.eq readonly_global)
									(call matches_atom (borrow-shared source) kind (borrow-shared vectors_kind)))
								(bool:and (scope.eq writable_string_global)
									(call matches_atom (borrow-shared source) kind (borrow-shared text_kind)))))
						(then (return (call snapshot_at directive (bool true) -1i32 -1i32 0u32))))
					(return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
			(if
				(:doc "A borrowed record snapshot requires a private mapping and an explicit copy lifetime.")
				(call matches_atom (borrow-shared source) kind (borrow-shared record_kind))
				(then
					(if next.ltz (then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
					(let name (nodes.get next))
					(if
						(:doc "The mapping reference must name a record in the enclosing bridge.")
						(bool:not (call is_native_name (borrow-shared source) name))
						(then (return (call snapshot_at name (bool false) -1i32 -1i32 23u32))))
					(let option name/next_sibling)
					(if
						(:doc "Report an omitted lifetime on the original snapshot directive.")
						option.ltz
						(then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
					(let lifetime (nodes.get option))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) lifetime))
					(if
						(:doc "Record snapshots take exactly one lifetime clause after the mapping.")
						(bool:or lifetime/next_sibling.not-ltz
							(bool:not (call has_head (borrow-shared source) (borrow-shared nodes) parts
								(borrow-shared lifetime_keyword))))
						(then (return (call snapshot_at lifetime (bool false) -1i32 -1i32 23u32))))
					(let guarantee (nodes.get parts/operands))
					(if
						(:doc "The calling thread's result and nested storage must stay valid through the copy.")
						(bool:or guarantee/next_sibling.not-ltz
							(bool:not (call matches_atom (borrow-shared source) guarantee (borrow-shared thread_local_lifetime))))
						(then (return (call snapshot_at guarantee (bool false) -1i32 -1i32 23u32))))
					(return (call record_snapshot_at directive next))))
			(if
				(:doc "A function snapshot must select a string or record contract.")
				(bool:not (call matches_atom (borrow-shared source) kind (borrow-shared text_kind)))
				(then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
			(if
				(:doc "An omitted drop contract means the native string is borrowed.")
				next.ltz
				(then (return (call snapshot_at directive (bool true) -1i32 -1i32 0u32))))
			(let option (nodes.get next))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) option))
			(let field (call has_head (borrow-shared source) (borrow-shared nodes) parts
				(borrow-shared field_keyword)))
			(if
				(:doc "A C string snapshot starts with an inline field or a single release symbol.")
				(bool:not (field.or
					(bool:and option/next_sibling.ltz
						(call has_head (borrow-shared source) (borrow-shared nodes) parts
							(borrow-shared drop_keyword)))))
				(then (return (call snapshot_at option (bool false) -1i32 -1i32 23u32))))
			(let name parts/operands)
			(let symbol (nodes.get name))
			(if
				(:doc "Both forms need one portable C identifier at its original source span.")
				(bool:or (i32:lt -1i32 symbol/next_sibling)
					(bool:not (call is_native_name (borrow-shared source) symbol)))
				(then (return (call snapshot_at symbol (bool false) -1i32 -1i32 23u32))))
			(if
				(:doc "Only an inline field can have an explicit native extent and source loan.")
				field
				(then (return (call read_field_snapshot (borrow-shared source) (borrow-shared nodes)
					directive name option/next_sibling))))
			(return (call snapshot_at directive (bool true) name -1i32 0u32))))

	(fn read_snapshot_contract
		(:doc `Read at most one snapshot from a selected declaration and check its Wove type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts)
			(result SourceNode) (scope u32))
		(returns CSnapshot)
		(body
			(let-mut active (bool false))
			(let-mut drop -1i32)
			(let-mut field -1i32)
			(let-mut extent -1i32)
			(let-mut from -1i32)
			(let-mut record -1i32)
			(let-mut entry declaration/metadata)
			(while
				(:doc "Search the declaration's attached metadata for native snapshot contracts.")
				(i32:lt -1i32 entry)
				(body
					(let node (nodes.get entry))
					(let head (nodes.get node/first_child))
					(if
						(:doc "A snapshot must appear as a direct pragma directive.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let-mut index (struct:get (call form_parts (borrow-shared source) (borrow-shared nodes) node) operands))
							(while
								(:doc "Find the exact contract and reject a second snapshot on the same declaration.")
								(i32:lt -1i32 index)
								(body
									(let item (nodes.get index))
									(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
									(let tag parts/head)
									(if
										(:doc "Other pragmas remain handled by their own readers.")
										(bool:and (i32:lt -1i32 tag)
											(call matches_atom (borrow-shared source) (nodes.get tag)
												(borrow-shared snapshot_keyword)))
										(then
											(if
												(:doc "Reject a second C snapshot at the repeated directive.")
												active
												(then (return (call snapshot_at item (bool false) -1i32 -1i32 23u32))))
											(let current (call read_snapshot_directive (borrow-shared source) (borrow-shared nodes)
												item parts/operands scope))
											(if current/error.gtz (then (return current)))
											(set active (bool true))
											(set drop current/drop)
											(set field current/field)
											(set extent current/extent)
											(set from current/from)
											(set record current/record)))
									(set index item/next_sibling)))))
					(set entry (call next_form_metadata (borrow-shared source) (borrow-shared nodes)
						declaration node))))
			(if
				(:doc "A global snapshot needs the exact owned result descriptor for its native storage.")
				(scope.not-eq function_result)
				(then
					(if
						(:doc "A writable C string requires the matching snapshot contract and nullable byte owner.")
						(scope.eq writable_string_global)
						(then
							(if
								(:doc "The writable marker alone supplies no read contract.")
								(bool:not (active.and (call is_optional_byte_owner (borrow-shared source)
									(borrow-shared nodes) result)))
								(then (return (call snapshot_at result (bool false) -1i32 -1i32 23u32))))
							(return (call snapshot_at result active -1i32 -1i32 0u32))))
					(if
						(:doc "A borrowed vector yields an ordinary owned array of byte owners.")
						(active.and
							(bool:not (call is_byte_rows_descriptor (borrow-shared source) (borrow-shared nodes) result)))
						(then (return (call snapshot_at result (bool false) -1i32 -1i32 23u32))))
					(return (call snapshot_at result active -1i32 -1i32 0u32))))
			(if
				(:doc "The signature pass checks the named owned result of a record snapshot.")
				record.not-ltz
				(then (return (call record_snapshot_at result record))))
			(let optional (call is_optional_byte_owner (borrow-shared source) (borrow-shared nodes) result))
			(if
				(:doc "The snapshot and the optional byte owner result require each other.")
				(bool:or (active.and optional.not)
					(optional.and active.not))
				(then (return (call snapshot_at result (bool false) -1i32 -1i32 23u32))))
			(if extent.not-ltz (then (return (call field_snapshot_at result field extent from))))
			(return (call snapshot_at result active drop field 0u32))))

	(fn read_c_snapshot
		(:doc `Check the optional C string or borrowed record snapshot on a function result.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts) (result SourceNode))
		(returns CSnapshot)
		(body (return (call read_snapshot_contract (borrow-shared source) (borrow-shared nodes)
			function result function_result))))

	(fn read_c_value_snapshot
		(:doc "Check the appropriate global snapshot contract for the declared native storage.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (binding FormParts)
			(type SourceNode) (readonly bool) (writable_string bool))
		(returns CSnapshot)
		(body
			(let-mut scope other_global)
			(if
				(:doc "Only a read-only native let can declare a vector snapshot.")
				readonly
				(then (set scope readonly_global)))
			(if writable_string (then (set scope writable_string_global)))
			(return (call read_snapshot_contract (borrow-shared source) (borrow-shared nodes)
				binding type scope))))
)
