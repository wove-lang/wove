(module source_c_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read borrowed and allocating C text snapshot contracts and their exact Wove result.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./owned.wove" (only optional_type_operand is_byte_rows_descriptor))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct CSnapshot (fields (active bool) (drop i32) (field i32) (record i32) (start i32) (end i32) (error u32)))

	(let snapshot_keyword "c_snapshot")
	(let vectors_kind "cstrs")
	(let function_result 0u32)
	(let readonly_global 1u32)
	(let other_global 2u32)
	(let text_kind "cstr")
	(let record_kind "record")
	(let drop_keyword "drop")
	(let field_keyword "field")
	(let owner_keyword "owned-array")

	(fn matches_atom
		(:doc `Compare a checked bare atom with the entire contract keyword.`)
		(params (source (shared-array u8)) (node SourceNode) (spelling (shared-array u8)))
		(returns bool)
		(body (return (bool.and (u32.eq (struct.get node kind) 1u32)
			(call same_bytes (borrow-shared source) (struct.get node start) (struct.get node end)
				(borrow-shared spelling) 0i32 (array.len spelling))))))

	(fn has_head
		(:doc `Match the head of a descriptor with no metadata and at least one operand.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (form FormParts) (spelling (shared-array u8)))
		(returns bool)
		(body (return (bool.and (bool.and (i32.lt -1i32 (struct.get form head))
			(i32.lt -1i32 (struct.get form operands)))
			(bool.and (i32.ltz (struct.get form metadata))
				(call matches_atom (borrow-shared source) (array.load nodes (struct.get form head))
					(borrow-shared spelling)))))))

	(fn is_optional_byte_owner
		(:doc `Recognize the snapshot result descriptor (optional (owned-array u8)).`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (result SourceNode))
		(returns bool)
		(body
			(let operand (call optional_type_operand (borrow-shared source) (borrow-shared nodes) result))
			(if (i32.ltz operand) (then (return (bool false))))
			(let owner (array.load nodes operand))
			(let inner (call form_parts (borrow-shared source) (borrow-shared nodes) owner))
			(if
				(:doc "Only the exact byte owner is available for a C text snapshot.")
				(bool.not (call has_head (borrow-shared source) (borrow-shared nodes) inner
					(borrow-shared owner_keyword)))
				(then (return (bool false))))
			(let element (array.load nodes (struct.get inner operands)))
			(return (bool.and (i32.ltz (struct.get element next_sibling))
				(u32.eq (call source_builtin_type (borrow-shared source) element) 10u32)))))

	(fn snapshot_at
		(:doc `Retain the snapshot shape, its optional release or field, and the source span.`)
		(params (node SourceNode) (active bool) (drop i32) (field i32) (error u32))
		(returns CSnapshot)
		(body (return (struct.new CSnapshot (active active) (drop drop) (field field) (record -1i32) (start (struct.get node start))
			(end (struct.get node end)) (error error)))))

	(fn record_snapshot_at
		(:doc "Retain the named mapping on a borrowed record result.")
		(params (node SourceNode) (name i32))
		(returns CSnapshot)
		(body (return (struct.new CSnapshot (active (bool true)) (drop -1i32) (field -1i32)
			(record name) (start (struct.get node start)) (end (struct.get node end)) (error 0u32)))))

	(fn read_snapshot_directive
		(:doc `Read the snapshot kind and any release allowed at this declaration.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (directive SourceNode) (start i32) (scope u32))
		(returns CSnapshot)
		(body
			(if (i32.ltz start) (then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
			(let kind (array.load nodes start))
			(let next (struct.get kind next_sibling))
			(if
				(:doc "Only a read-only global can snapshot a borrowed vector. It has no release operand.")
				(u32.not-eq scope function_result)
				(then
					(if
						(:doc "A global snapshot requires one bare cstrs operand.")
						(bool.and (bool.and (u32.eq scope readonly_global) (i32.ltz next))
							(call matches_atom (borrow-shared source) kind (borrow-shared vectors_kind)))
						(then (return (call snapshot_at directive (bool true) -1i32 -1i32 0u32))))
					(return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
			(if
				(:doc "A borrowed record snapshot names one private mapping from the enclosing bridge.")
				(call matches_atom (borrow-shared source) kind (borrow-shared record_kind))
				(then
					(if (i32.ltz next) (then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
					(let name (array.load nodes next))
					(if
						(:doc "Keep invalid names or extra operands at the mapping reference.")
						(bool.or (bool.not (call is_native_name (borrow-shared source) name))
							(i32.not-ltz (struct.get name next_sibling)))
						(then (return (call snapshot_at name (bool false) -1i32 -1i32 23u32))))
					(return (call record_snapshot_at directive next))))
			(if
				(:doc "A function snapshot must select a string or record contract.")
				(bool.not (call matches_atom (borrow-shared source) kind (borrow-shared text_kind)))
				(then (return (call snapshot_at directive (bool false) -1i32 -1i32 23u32))))
			(if
				(:doc "An omitted drop contract means the native string is borrowed.")
				(i32.ltz next)
				(then (return (call snapshot_at directive (bool true) -1i32 -1i32 0u32))))
			(let option (array.load nodes next))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) option))
			(let field (call has_head (borrow-shared source) (borrow-shared nodes) parts
				(borrow-shared field_keyword)))
			(if
				(:doc "A C string snapshot can specify one field or one release symbol.")
				(bool.or (i32.lt -1i32 (struct.get option next_sibling))
					(bool.not (bool.or field
						(call has_head (borrow-shared source) (borrow-shared nodes) parts
							(borrow-shared drop_keyword)))))
				(then (return (call snapshot_at option (bool false) -1i32 -1i32 23u32))))
			(let name (struct.get parts operands))
			(let symbol (array.load nodes name))
			(if
				(:doc "Both forms need one portable C identifier at its original source span.")
				(bool.or (i32.lt -1i32 (struct.get symbol next_sibling))
					(bool.not (call is_native_name (borrow-shared source) symbol)))
				(then (return (call snapshot_at symbol (bool false) -1i32 -1i32 23u32))))
			(if field (then (return (call snapshot_at directive (bool true) -1i32 name 0u32))))
			(return (call snapshot_at directive (bool true) name -1i32 0u32))))

	(fn read_snapshot_contract
		(:doc `Read at most one snapshot from a selected declaration and check its Wove type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts)
			(result SourceNode) (scope u32))
		(returns CSnapshot)
		(body
			(let-mut active (bool false))
			(let-mut drop -1i32)
			(let-mut field -1i32)
			(let-mut record -1i32)
			(let-mut entry (struct.get declaration metadata))
			(while
				(:doc "Search the declaration's attached metadata for native snapshot contracts.")
				(i32.lt -1i32 entry)
				(body
					(let node (array.load nodes entry))
					(let head (array.load nodes (struct.get node first_child)))
					(if
						(:doc "A snapshot must appear as a direct pragma directive.")
						(u32.eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let-mut index (struct.get (call form_parts (borrow-shared source) (borrow-shared nodes) node) operands))
							(while
								(:doc "Find the exact contract and reject a second snapshot on the same declaration.")
								(i32.lt -1i32 index)
								(body
									(let item (array.load nodes index))
									(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
									(let tag (struct.get parts head))
									(if
										(:doc "Other pragmas remain handled by their own readers.")
										(bool.and (i32.lt -1i32 tag)
											(call matches_atom (borrow-shared source) (array.load nodes tag)
												(borrow-shared snapshot_keyword)))
										(then
											(if
												(:doc "Reject a second C snapshot at the repeated directive.")
												active
												(then (return (call snapshot_at item (bool false) -1i32 -1i32 23u32))))
											(let current (call read_snapshot_directive (borrow-shared source) (borrow-shared nodes)
												item (struct.get parts operands) scope))
											(if (u32.gtz (struct.get current error)) (then (return current)))
											(set active (bool true))
											(set drop (struct.get current drop))
											(set field (struct.get current field))
											(set record (struct.get current record))))
									(set index (struct.get item next_sibling))))))
					(set entry (call next_form_metadata (borrow-shared source) (borrow-shared nodes)
						declaration node))))
			(if
				(:doc "A global vector snapshot yields an ordinary owned array of byte owners.")
				(u32.not-eq scope function_result)
				(then
					(if
						(:doc "Check the exact result descriptor only on an annotated global.")
						(bool.and active
							(bool.not (call is_byte_rows_descriptor (borrow-shared source) (borrow-shared nodes) result)))
						(then (return (call snapshot_at result (bool false) -1i32 -1i32 23u32))))
					(return (call snapshot_at result active -1i32 -1i32 0u32))))
			(if
				(:doc "The signature pass checks the named owned result of a record snapshot.")
				(i32.not-ltz record)
				(then (return (call record_snapshot_at result record))))
			(let optional (call is_optional_byte_owner (borrow-shared source) (borrow-shared nodes) result))
			(if
				(:doc "The snapshot and the optional byte owner result require each other.")
				(bool.or (bool.and active (bool.not optional))
					(bool.and optional (bool.not active)))
				(then (return (call snapshot_at result (bool false) -1i32 -1i32 23u32))))
			(return (call snapshot_at result active drop field 0u32))))

	(fn read_c_snapshot
		(:doc `Check a function result's optional borrowed or allocating C string contract.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts) (result SourceNode))
		(returns CSnapshot)
		(body (return (call read_snapshot_contract (borrow-shared source) (borrow-shared nodes)
			function result function_result))))

	(fn read_c_vector_snapshot
		(:doc `Check a native value's optional contract for copying a borrowed C string table.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (binding FormParts)
			(type SourceNode) (readonly bool))
		(returns CSnapshot)
		(body
			(let-mut scope other_global)
			(if
				(:doc "Only a read-only native let can declare a vector snapshot.")
				readonly
				(then (set scope readonly_global)))
			(return (call read_snapshot_contract (borrow-shared source) (borrow-shared nodes)
				binding type scope))))
)
