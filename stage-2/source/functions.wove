(module source_functions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Collect direct function fields by tag while retaining their original source rows.")

	(use wove-file "./scan.wove" (only is_metadata_form is_wove_name (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct FunctionFields (fields (params i32) (result i32) (body i32) (target i32) (error u32) (site i32)))

	(let params_tag "params")
	(let returns_tag "returns")
	(let body_tag "body")
	(let target_tag "c-name")

	(struct ReturnOrigin (fields (operand i32) (start i32) (end i32) (error u32)))

	(let from_word "from")

	(fn return_origin_at
		(:doc "Keep the source row of a parameter or the originating return diagnostic.")
		(params (node SourceNode) (operand i32) (error u32)) (returns ReturnOrigin)
		(body (return (struct.new ReturnOrigin (operand (local operand))
			(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error (local error))))))

	(fn read_return_origin
		(:doc "Read the one bare parameter name in a return provenance clause.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (returns SourceNode))
		(returns ReturnOrigin)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (struct.get (local parts) head))
			(if
				(:doc "An extra result operand without a from head preserves the returns form's diagnostic.")
				(i32.ltz (local head))
				(then (return (call return_origin_at (local returns) -1i32 23u32))))
			(let tag (array.load (local nodes) (local head)))
			(if
				(:doc "Only the exact from keyword can introduce a provenance clause.")
				(bool.or (u32.not-eq (struct.get (local tag) kind) 1u32)
					(bool.not (call same_bytes (borrow-shared (local source))
						(struct.get (local tag) start) (struct.get (local tag) end)
						(borrow-shared (local from_word)) 0i32 (array.len (local from_word)))))
				(then (return (call return_origin_at (local returns) -1i32 23u32))))
			(let name (struct.get (local parts) operands))
			(if
				(:doc "A recognized provenance clause takes one name and must be the final result operand.")
				(bool.or (bool.or (i32.ltz (local name)) (i32.not-ltz (struct.get (local node) next_sibling)))
					(i32.not-ltz (struct.get (array.load (local nodes) (local name)) next_sibling)))
				(then (return (call return_origin_at (local node) -1i32 23u32))))
			(let metadata (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts)))
			(if
				(:doc "Keep the original misplaced metadata diagnostic.")
				(u32.gtz (struct.get (local metadata) error))
				(then (return (struct.new ReturnOrigin (operand -1i32) (start (struct.get (local metadata) start))
					(end (struct.get (local metadata) end)) (error (struct.get (local metadata) error))))))
			(let spelling (array.load (local nodes) (local name)))
			(if
				(:doc "The source parameter uses the same name spelling as its declaration.")
				(bool.not (call is_wove_name (borrow-shared (local source)) (local spelling)))
				(then (return (call return_origin_at (local spelling) -1i32 23u32))))
			(return (call return_origin_at (local spelling) (local name) 0u32))))

	(fn function_field_tag
		(:doc "Identify the exact tag of an ordinary function field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (field SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Only a tagged form can occupy an ordinary field slot.")
				(u32.not-eq (struct.get (local field) kind) 40u32)
				(then (return 0u32)))
			(let head (array.load (local nodes) (struct.get (local field) first_child)))
			(let start (struct.get (local head) start))
			(let end (struct.get (local head) end))
			(if
				(:doc "Recognize the declared parameter list.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local params_tag)) 0i32 (array.len (local params_tag)))
				(then (return 1u32)))
			(if
				(:doc "Recognize the declared result type.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local returns_tag)) 0i32 (array.len (local returns_tag)))
				(then (return 2u32)))
			(if
				(:doc "Recognize the Wove definition body.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local body_tag)) 0i32 (array.len (local body_tag)))
				(then (return 3u32)))
			(if
				(:doc "Recognize an explicit C symbol name.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local target_tag)) 0i32 (array.len (local target_tag)))
				(then (return 4u32)))
			(return 0u32)))

	(fn collect_function_fields
		(:doc "Record the available slots and the first unexpected or repeated field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (foreign bool))
		(returns FunctionFields)
		(body
			(let-mut params -1i32)
			(let-mut result -1i32)
			(let-mut body -1i32)
			(let-mut target -1i32)
			(let-mut index (local first))
			(while
				(:doc "Visit original siblings, leaving metadata to the declaration's metadata reader.")
				(i32.lt -1i32 (local index))
				(body
					(let field (array.load (local nodes) (local index)))
					(if
						(:doc "Only ordinary fields occupy a slot.")
						(bool.not (call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local field)))
						(then
							(let tag (call function_field_tag (borrow-shared (local source)) (borrow-shared (local nodes)) (local field)))
							(let-mut previous (local index))
							(let-mut error 23u32)
							(if
								(:doc "Keep the body diagnostic for a repeated body or an extra field after a Wove signature.")
								(bool.and (bool.not (local foreign)) (bool.or (u32.eq (local tag) 3u32)
									(bool.and (u32.eqz (local tag))
										(bool.and (i32.lt -1i32 (local params)) (i32.lt -1i32 (local result))))))
								(then (set (local error) 24u32)))
							(if
								(:doc "The parameter slot is common to Wove definitions and C declarations.")
								(u32.eq (local tag) 1u32)
								(then
									(set (local previous) (local params))
									(set (local params) (local index))))
							(if
								(:doc "The result slot can appear before or after the parameters.")
								(u32.eq (local tag) 2u32)
								(then
									(set (local previous) (local result))
									(set (local result) (local index))))
							(if
								(:doc "Only Wove definitions have a body.")
								(bool.and (u32.eq (local tag) 3u32) (bool.not (local foreign)))
								(then
									(set (local previous) (local body))
									(set (local body) (local index))))
							(if
								(:doc "Only C declarations can name a separate native symbol.")
								(bool.and (u32.eq (local tag) 4u32) (local foreign))
								(then
									(set (local previous) (local target))
									(set (local target) (local index))))
							(if
								(:doc "An occupied slot or unknown field reports the current sibling's span.")
								(i32.lt -1i32 (local previous))
								(then (return (struct.new FunctionFields (params -1i32) (result -1i32) (body -1i32)
									(target -1i32) (error (local error)) (site (local index))))))))
					(set (local index) (struct.get (local field) next_sibling))))
			(return (struct.new FunctionFields (params (local params)) (result (local result))
				(body (local body)) (target (local target)) (error 0u32) (site -1i32))))))
