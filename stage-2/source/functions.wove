(module source_functions
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Collect direct function fields by tag while retaining their original source rows.")

	(use wove-file "./scan.wove" (only is_metadata_form is_wove_name (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct FunctionFields (fields (params i32) (result i32) (body i32) (target i32) (error u32) (site i32)))

	(let params_tag "params")
	(let returns_tag "returns")
	(let body_tag "body")
	(let target_tag "c-name")

	(struct ReturnOrigin (fields (operand i32) (start i32) (end i32) (error u32)))

	(let from_word "from")

	(fn return_origin_at
		(:doc "Keep the source row of a parameter or the originating return diagnostic.")
		(params (node SourceNode) (operand i32) (error u32)) (returns ReturnOrigin)
		(body (return (struct:new ReturnOrigin (operand operand)
			(start (node.get start)) (end (node.get end)) (error error)))))

	(fn read_return_origin
		(:doc "Read the one bare parameter name in a return provenance clause.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (returns SourceNode))
		(returns ReturnOrigin)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (parts.get head))
			(if
				(:doc "An extra result operand without a from head preserves the returns form's diagnostic.")
				(i32:ltz head)
				(then (return (call return_origin_at returns -1i32 23u32))))
			(let tag (nodes.get head))
			(if
				(:doc "Only the exact from keyword can introduce a provenance clause.")
				(bool:or (u32:not-eq (tag.get kind) 1u32)
					(bool:not (call same_bytes (borrow-shared source)
						(tag.get start) (tag.get end)
						(borrow-shared from_word) 0i32 from_word.len)))
				(then (return (call return_origin_at returns -1i32 23u32))))
			(let name (parts.get operands))
			(if
				(:doc "A recognized provenance clause takes one name and must be the final result operand.")
				(bool:or (bool:or (i32:ltz name) (i32:not-ltz (node.get next_sibling)))
					(i32:not-ltz (struct:get (nodes.get name) next_sibling)))
				(then (return (call return_origin_at node -1i32 23u32))))
			(let metadata (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
				node parts))
			(if
				(:doc "Keep the original misplaced metadata diagnostic.")
				(u32:gtz (metadata.get error))
				(then (return (struct:new ReturnOrigin (operand -1i32) (start (metadata.get start))
					(end (metadata.get end)) (error (metadata.get error))))))
			(let spelling (nodes.get name))
			(if
				(:doc "The source parameter uses the same name spelling as its declaration.")
				(bool:not (call is_wove_name (borrow-shared source) spelling))
				(then (return (call return_origin_at spelling -1i32 23u32))))
			(return (call return_origin_at spelling name 0u32))))

	(fn function_field_tag
		(:doc "Identify the exact tag of an ordinary function field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (field SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Only a tagged form can occupy an ordinary field slot.")
				(u32:not-eq (field.get kind) 40u32)
				(then (return 0u32)))
			(let head (nodes.get (field.get first_child)))
			(let start (head.get start))
			(let end (head.get end))
			(if
				(:doc "Recognize the declared parameter list.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared params_tag) 0i32 params_tag.len)
				(then (return 1u32)))
			(if
				(:doc "Recognize the declared result type.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared returns_tag) 0i32 returns_tag.len)
				(then (return 2u32)))
			(if
				(:doc "Recognize the Wove definition body.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared body_tag) 0i32 body_tag.len)
				(then (return 3u32)))
			(if
				(:doc "Recognize an explicit C symbol name.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared target_tag) 0i32 target_tag.len)
				(then (return 4u32)))
			(return 0u32)))

	(fn collect_function_fields
		(:doc "Record the available slots and the first unexpected or repeated field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (foreign bool))
		(returns FunctionFields)
		(body
			(let-mut params -1i32)
			(let-mut result -1i32)
			(let-mut body -1i32)
			(let-mut target -1i32)
			(let-mut index first)
			(while
				(:doc "Visit original siblings, leaving metadata to the declaration's metadata reader.")
				(i32:lt -1i32 index)
				(body
					(let field (nodes.get index))
					(if
						(:doc "Only ordinary fields occupy a slot.")
						(bool:not (call is_metadata_form (borrow-shared source) (borrow-shared nodes) field))
						(then
							(let tag (call function_field_tag (borrow-shared source) (borrow-shared nodes) field))
							(let-mut previous index)
							(let-mut error 23u32)
							(if
								(:doc "Keep the body diagnostic for a repeated body or an extra field after a Wove signature.")
								(bool:and (bool:not foreign) (bool:or (u32:eq tag 3u32)
									(bool:and (u32:eqz tag)
										(bool:and (i32:lt -1i32 params) (i32:lt -1i32 result)))))
								(then (set error 24u32)))
							(if
								(:doc "The parameter slot is common to Wove definitions and C declarations.")
								(u32:eq tag 1u32)
								(then
									(set previous params)
									(set params index)))
							(if
								(:doc "The result slot can appear before or after the parameters.")
								(u32:eq tag 2u32)
								(then
									(set previous result)
									(set result index)))
							(if
								(:doc "Only Wove definitions have a body.")
								(bool:and (u32:eq tag 3u32) (bool:not foreign))
								(then
									(set previous body)
									(set body index)))
							(if
								(:doc "Only C declarations can name a separate native symbol.")
								(bool:and (u32:eq tag 4u32) foreign)
								(then
									(set previous target)
									(set target index)))
							(if
								(:doc "An occupied slot or unknown field reports the current sibling's span.")
								(i32:lt -1i32 previous)
								(then (return (struct:new FunctionFields (params -1i32) (result -1i32) (body -1i32)
									(target -1i32) (error error) (site index)))))))
					(set index (field.get next_sibling))))
			(return (struct:new FunctionFields (params params) (result result)
				(body body) (target target) (error 0u32) (site -1i32))))))
