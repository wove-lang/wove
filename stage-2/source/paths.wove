(module source_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve import paths in a supplied source graph.

	Each row maps a normalized absolute path to a defining file identity. An
	identity is the index of its defining row, which carries the original source
	view. Several paths can name that identity. The graph supplies all ranges
	inside one immutable arena and uses slash-separated virtual paths. Normalize
	components lexically before lookup. A component discarded by .. can be
	absent from the virtual graph.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct SuppliedFile
		(fields (identity i32) (path_start i32) (path_end i32) (source_start i32) (source_end i32) (bundled bool)))

	(fn directory_end
		(:doc `Find the end of an absolute path's directory prefix, including its slash.`)
		(params (arena (shared-array u8)) (file SuppliedFile))
		(returns i32)
		(body
			(let-mut cursor file/path_end.dec)
			(while
				(:doc "The leading slash guarantees a directory boundary.")
				(u8:not-eq (arena.get cursor) 47u8)
				(body (set cursor cursor.dec)))
			(return cursor.inc)))

	(fn parent_width
		(:doc `Return the retained path width after removing the last component.`)
		(params (path (shared-array u8)) (width i32))
		(returns i32)
		(body
			(let-mut cursor width)
			(while
				(:doc "Walk back to the leading slash of the last component, if any.")
				cursor.gtz
				(body
					(set cursor cursor.dec)
					(if
						(:doc "The removed component includes its slash.")
						(u8:eq (path.get cursor) 47u8)
						(then (return cursor)))))
			(return 0i32)))

	(fn append_component
		(:doc `Copy a component into the reserved path scratch after a leading slash.`)
		(params (request (shared-array u8)) (start i32) (end i32)
			(output (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(output.set offset 47u8)
			(let-mut written offset.inc)
			(let-mut index start)
			(while
				(:doc "Copy only bytes between the component's checked bounds.")
				(index.lt end)
				(body
					(output.set written (request.get index))
					(set index index.inc)
					(set written written.inc)))
			(return written)))

	(fn normalize_path
		(:doc `Append the request as normalized components after its optional base directory.

		Width zero denotes the virtual root. The reserved capacity covers the
		base prefix and the entire request. A NUL byte makes the request invalid.`)
		(params (request (shared-array u8)) (output (mut-array u8)) (base i32))
		(returns i32)
		(body
			(let-mut written base)
			(let-mut cursor 0i32)
			(let length request.len)
			(while
				(:doc "Read one component at a time, accepting repeated or trailing separators.")
				(cursor.lt length)
				(body
					(let start cursor)
					(while
						(:doc "Find the component boundary without reading beyond the request.")
						(bool:and (cursor.lt length)
							(u8:not-eq (request.get cursor) 47u8))
						(body
							(if
								(:doc "Paths containing NUL cannot name a supplied file.")
								(u8:eqz (request.get cursor))
								(then (return -1i32)))
							(set cursor cursor.inc)))
					(let width (cursor.sub start))
					(if
						(:doc "An empty component is already represented by the surrounding separators.")
						width.gtz
						(then
							(let dot (u8:eq (request.get start) 46u8))
							(if
								(:doc "A parent component removes one directory, stopping at the root.")
								(bool:and (width.eq 2i32)
									(dot.and
										(u8:eq (request.get
											start.inc) 46u8)))
								(then (set written (call parent_width (borrow-shared output) written)))
								(else
									(if
										(:doc "A single dot leaves the directory unchanged.")
										(bool:not (bool:and (width.eq 1i32) dot))
										(then (set written
											(call append_component (borrow-shared request) start
												cursor (borrow-mut output) written))))))))
					(if
						(:doc "Advance past a separator only when it is inside the request.")
						(cursor.lt length)
						(then (set cursor cursor.inc)))))
			(return written)))

	(fn copy_directory
		(:doc `Copy a verified importer directory into the reserved scratch prefix.`)
		(params (arena (shared-array u8)) (start i32) (width i32) (output (mut-array u8)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Leave the final slash for the next appended component.")
				(index.lt width)
				(body
					(output.set index
						(arena.get (start.add index)))
					(set index index.inc)))))

	(fn resolve_path
		(:doc `Return the matching supplied path row or -1 when no file has that path.

		Resolve relative requests from the path that brought the importer into the
		graph. The source identity is resolved separately by the caller.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(importer SuppliedFile) (request (shared-array u8)))
		(returns i32)
		(body
			(let length request.len)
			(if
				(:doc "An empty request cannot name a supplied file.")
				length.eqz
				(then (return -1i32)))
			(let start importer/path_start)
			(let-mut base 0i32)
			(if
				(:doc "A relative request starts from the importer's directory.")
				(u8:not-eq (request.get 0i32) 47u8)
				(then
					(set base
						(i32:sub (call directory_end (borrow-shared arena) importer)
							start.inc))))
			(let capacity (i32:inc (length.add base)))
			(if
				(:doc "No supplied path could match a request whose scratch width is out of range.")
				capacity.not-gtz
				(then (return -2i32)))
			(let-mut output (array:alloc u8 capacity))
			(call copy_directory (borrow-shared arena) start base
				(borrow-mut output))
			(let width (call normalize_path (borrow-shared request) (borrow-mut output) base))
			(if
				(:doc "Invalid requests and the virtual root do not name files.")
				width.not-gtz
				(then (return -1i32)))
			(let-mut index 0i32)
			(while
				(:doc "Compare the normalized path against each supplied path row.")
				(index.lt files.len)
				(body
					(let file (files.get index))
					(if
						(:doc "The matched row identifies the provider and its reached path.")
						(call same_bytes (borrow-shared output) 0i32 width
							(borrow-shared arena) file/path_start file/path_end)
						(then (return index)))
					(set index index.inc)))
			(return -1i32))))
