(module source_c_dependency_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve active bridge-local C uses before building the combined provider tree.")

	(use wove-file "./scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "./module.wove" (only form_parts select_form))
	(use wove-file "./imports.wove" (only read_import))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "./c_headers.wove" (only find_c_header (type HeaderMatch)))
	(use wove-file "./c_dependencies.wove" (only first_bridge_operand next_bridge_use))
	(use wove-file "./target.wove" (only (type SelectionContext)))

	(struct BridgeUse
		(fields (owner i32) (first i32) (start i32) (end i32)
			(file i32) (node i32) (header_start i32) (header_end i32) (default_file i32) (default_node i32)))
	(struct BridgeUses
		(fields (count i32) (file i32) (start i32) (end i32) (error u32)))

	(fn count_bridge_uses
		(:doc "Bound the dependency plan by the direct uses in one original bridge.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32))
		(returns i32)
		(body
			(if (i32:ltz bridge) (then (return 0i32)))
			(let first (call first_bridge_operand (borrow-shared source) (borrow-shared nodes) bridge))
			(let-mut row (call next_bridge_use (borrow-shared source) (borrow-shared nodes) first))
			(let-mut count 0i32)
			(while
				(:doc "Enter each direct use once, skipping other member forms.")
				(i32:not-ltz row)
				(body
					(set count (i32:inc count))
					(set row (call next_bridge_use (borrow-shared source) (borrow-shared nodes)
						(struct:get (nodes.get row) next_sibling)))))
			(return count)))

	(fn required_header
		(:doc "Resolve the provider for selected types or retain the source of an include-only key.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (owner i32)
			(literal SourceNode) (selector i32) (context SelectionContext))
		(returns HeaderMatch)
		(body
			(let start literal/start)
			(let end literal/end)
			(let-mut bytes (array:alloc u8 (i32:sub end start)))
			(let key (call decode_string (borrow-shared arena)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut bytes)))
			(if
				(:doc "A dependency key must decode before matching any provider.")
				(u32:gtz key/error)
				(then
					(let base (struct:get (files.get owner) source_start))
					(return (struct:new HeaderMatch (file owner) (node -1i32)
						(start (i32:sub key/start base))
						(end (i32:sub key/end base)) (error key/error)
						(default_file -1i32) (default_node -1i32) (replace (bool false))))))
			(let found (call find_c_header (borrow-shared arena) (borrow-shared files)
				(borrow-shared (bytes.range 0i32 key/written)) context))
			(if
				(:doc "An include-only use has no required Wove provider, but a present provider supplies its own prerequisites.")
				(bool:and (i32:ltz selector)
					(bool:and (i32:ltz found/file) (u32:eqz found/error)))
				(then (return (struct:new HeaderMatch (file owner) (node -1i32)
					(start 0i32) (end 0i32) (error 0u32) (default_file -1i32) (default_node -1i32) (replace (bool false))))))
			(return found)))

	(fn scoped_uses
		(:doc "Retain declared dependency order and diagnose invalid uses at their written source spans.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(scope HeaderMatch) (fallback i32) (context SelectionContext) (uses (mut-array BridgeUse)))
		(returns BridgeUses)
		(body
			(let-mut count 0i32)
			(let-mut bridge scope/node)
			(let-mut owner scope/file)
			(while
				(:doc "Collect the primary and inherited bridge scopes in graph lookup order.")
				(i32:not-ltz bridge)
				(body
					(let first (call first_bridge_operand (borrow-shared arena) (borrow-shared nodes) bridge))
					(let-mut row (call next_bridge_use (borrow-shared arena) (borrow-shared nodes) first))
					(while
						(:doc "Only active explicit uses contribute a C include or a private type selector.")
						(i32:not-ltz row)
						(body
							(let use (nodes.get row))
							(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) use))
							(let choice (call select_form (borrow-shared arena) (borrow-shared nodes)
								use parts (bool true) context))
							(if
								(:doc "Keep a malformed target guard at the affected use.")
								(u32:gtz choice/error)
								(then (return (struct:new BridgeUses (count count) (file owner)
									(start choice/start) (end choice/end)
									(error choice/error)))))
							(if
								(:doc "Read and resolve the active dependency before reading its selected names.")
								choice/active
								(then
									(let read (call read_import (borrow-shared arena) (borrow-shared nodes)
										use parts/operands))
									(if
										(:doc "Only C header providers have native declarations in a bridge.")
										(bool:or (u32:gtz read/error) (u32:not-eq read/provider 8u32))
										(then (return (struct:new BridgeUses (count count) (file owner)
											(start read/start) (end read/end) (error 26u32)))))
									(let literal (nodes.get read/first))
									(let start literal/start)
									(let end literal/end)
									(let selector read/second)
									(let header (call required_header (borrow-shared arena) (borrow-shared files)
										owner literal selector context))
									(if
										(:doc "A missing dependency provider points to the header key in its declaring bridge.")
										(bool:and (i32:ltz header/file) (u32:eqz header/error))
										(then (return (struct:new BridgeUses (count count) (file owner)
											(start start) (end end) (error 27u32)))))
									(if
										(:doc "A provider lookup error already names its own source file and view-relative span.")
										(u32:gtz header/error)
										(then
											(let file header/file)
											(let base (struct:get (files.get file) source_start))
											(return (struct:new BridgeUses (count count) (file file)
												(start (i32:add base header/start))
												(end (i32:add base header/end))
												(error header/error)))))
									(uses.set count (struct:new BridgeUse (owner owner) (first selector)
										(start start) (end end) (file header/file)
										(node header/node) (header_start header/start)
										(header_end header/end) (default_file header/default_file)
										(default_node header/default_node)))
									(set count (i32:inc count))))
							(set row (call next_bridge_use (borrow-shared arena) (borrow-shared nodes)
								use/next_sibling))))
					(if
						(:doc "Advance once to the bundled half of a project overlay when it exists.")
						(i32:eq bridge scope/node)
						(then
							(set bridge fallback)
							(set owner scope/default_file))
						(else (set bridge -1i32)))))
			(return (struct:new BridgeUses (count count) (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))
)
