(module source_c_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the declarations of an explicit C record view.

	The selected C header supplies the complete object layout. This reader
	retains the native spelling and checked source field links.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_operand validate_form_metadata))
	(use wove-file "./imports.wove" (only import_keyword))
	(use wove-file "./c_owners.wove" (only is_native_name read_c_type_form check_c_type_spelling))
	(use wove-file "../text/match.wove" (only is_three_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct CRecordRead (fields (name i32) (native i32) (first i32) (count i32) (start i32) (end i32) (error u32)))

	(fn c_record_at
		(:doc `Tie a record view check to the original form or failing operand.`)
		(params (node SourceNode) (name i32) (native i32) (first i32) (count i32) (error u32))
		(returns CRecordRead)
		(body
			(return (struct.new CRecordRead (name name) (native native) (first first)
				(count count) (start (struct.get node start)) (end (struct.get node end)) (error error)))))

	(fn is_c_record
		(:doc `Distinguish a native struct member from a native alias when its definition is already known.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (struct.get parts head))
			(return (bool.and (i32.lt -1i32 head)
				(u32.eq (call import_keyword (borrow-shared source) (array.load nodes head)) 7u32)))))

	(fn is_fields_head
		(:doc `Match the fields tag of a record's view list.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(let start (struct.get node start))
			(return (bool.and (i32.eq (i32.sub (struct.get node end) start) 6i32)
				(bool.and (call is_three_bytes (borrow-shared source) start 102u8 105u8 101u8)
					(call is_three_bytes (borrow-shared source) (i32.add start 3i32)
						108u8 100u8 115u8))))))

	(let inline_array_word "array")
	(let inline_char_word "char")

	(struct CInlineField (fields (extent i32) (start i32) (end i32) (error u32)))

	(fn c_inline_field_at
		(:doc "Keep the complete native array operand or its first rejected subform.")
		(params (node SourceNode) (extent i32) (error u32)) (returns CInlineField)
		(body
			(return (struct.new CInlineField (extent extent) (start (struct.get node start))
				(end (struct.get node end)) (error error)))))

	(fn read_c_inline_field
		(:doc "Recognize a native plain-char array type and retain the source span for its exact extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns CInlineField)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (struct.get parts head))
			(if (i32.ltz head) (then (return (call c_inline_field_at node 0i32 0u32))))
			(let tag (array.load nodes head))
			(if
				(:doc "Bare scalar and native alias operands continue through ordinary field resolution.")
				(bool.not (call same_bytes (borrow-shared source) (struct.get tag start) (struct.get tag end)
					(borrow-shared inline_array_word) 0i32 5i32))
				(then (return (call c_inline_field_at node 0i32 0u32))))
			(let element (struct.get parts operands))
			(if
				(:doc "Report an incomplete array type at the whole field operand.")
				(i32.ltz element)
				(then (return (call c_inline_field_at node 0i32 23u32))))
			(let name (array.load nodes element))
			(if
				(:doc "Plain C char has its own native type and exposes an unsigned byte representation in Wove.")
				(bool.not (call same_bytes (borrow-shared source) (struct.get name start) (struct.get name end)
					(borrow-shared inline_char_word) 0i32 4i32))
				(then (return (call c_inline_field_at name 0i32 23u32))))
			(let count (struct.get name next_sibling))
			(if
				(:doc "Only a single positive decimal extent can describe the exact native declaration.")
				(bool.or (i32.ltz count)
					(i32.not-ltz (struct.get (array.load nodes count) next_sibling)))
				(then (return (call c_inline_field_at node 0i32 23u32))))
			(let literal (array.load nodes count))
			(let parsed (call read_decimal_digits (borrow-shared source) (struct.get literal start)
				(struct.get literal end) 214748364u32 7u32))
			(if
				(:doc "C arrays require a positive extent that fits the signed Wove index.")
				(bool.or (i32.not-gtz (struct.get parsed digits)) (u32.eqz (struct.get parsed magnitude)))
				(then (return (call c_inline_field_at literal 0i32 23u32))))
			(return (call c_inline_field_at node (i32.from-u32 (struct.get parsed magnitude)) 0u32))))

	(fn read_c_fields
		(:doc `Check the native member spelling, single type operand, and uniqueness of each field in source order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (list SourceNode) (name i32) (native i32))
		(returns CRecordRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) list))
			(let head (struct.get parts head))
			(if
				(:doc "A view exposes its members in a single fields form.")
				(bool.or (i32.ltz head)
					(bool.not (call is_fields_head (borrow-shared source) (array.load nodes head))))
				(then (return (call c_record_at list -1i32 -1i32 -1i32 0i32 23u32))))
			(let selection (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
				list parts))
			(if
				(:doc "The complete view is selectable. The field list must preserve the directive's error span.")
				(u32.gtz (struct.get selection error))
				(then (return (struct.new CRecordRead (name -1i32) (native -1i32) (first -1i32)
					(count 0i32) (start (struct.get selection start)) (end (struct.get selection end))
					(error (struct.get selection error))))))
			(let first (struct.get parts operands))
			(let-mut field first)
			(let-mut count 0i32)
			(while
				(:doc "Each field maps directly to one named member of the native object.")
				(i32.lt -1i32 field)
				(body
					(let node (array.load nodes field))
					(let member (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let spelling (struct.get member head))
					(let type (struct.get member operands))
					(if
						(:doc "Fields need one type operand, preserving the view's original span on shape errors.")
						(bool.or (bool.or (i32.ltz spelling) (i32.ltz type))
							(i32.lt -1i32 (struct.get (array.load nodes type) next_sibling)))
						(then (return (call c_record_at node -1i32 -1i32 -1i32 0i32 23u32))))
					(let inline (call read_c_inline_field (borrow-shared source) (borrow-shared nodes)
						(array.load nodes type)))
					(if
						(:doc "Keep a malformed native array type on the offending operand.")
						(u32.gtz (struct.get inline error))
						(then (return (struct.new CRecordRead (name -1i32) (native -1i32) (first -1i32) (count 0i32)
							(start (struct.get inline start)) (end (struct.get inline end))
							(error (struct.get inline error))))))
					(let field_name (array.load nodes spelling))
					(if
						(:doc "C member access uses the written name verbatim.")
						(bool.not (call is_native_name (borrow-shared source) field_name))
						(then (return (call c_record_at field_name -1i32 -1i32 -1i32 0i32 23u32))))
					(let choice (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
						node member))
					(if
						(:doc "Selection belongs to the complete record view.")
						(u32.gtz (struct.get choice error))
						(then (return (struct.new CRecordRead (name -1i32) (native -1i32) (first -1i32)
							(count 0i32) (start (struct.get choice start)) (end (struct.get choice end))
							(error (struct.get choice error))))))
					(let-mut earlier first)
					(while
						(:doc "A native view may expose a given field name only once.")
						(i32.not-eq earlier field)
						(body
							(let previous (array.load nodes earlier))
							(let previous_name (array.load nodes (struct.get previous first_child)))
							(if
								(:doc "Report the later spelling when a native field is repeated.")
								(call same_bytes (borrow-shared source)
									(struct.get previous_name start) (struct.get previous_name end)
									(borrow-shared source) (struct.get field_name start) (struct.get field_name end))
								(then (return (call c_record_at field_name -1i32 -1i32 -1i32 0i32 33u32))))
							(set earlier (struct.get previous next_sibling))))
					(set field (struct.get node next_sibling))
					(set count (i32.inc count))))
			(return (call c_record_at list name native first count 0u32))))

	(fn read_c_record
		(:doc `Validate the view's name and C type spelling and retain the original field list.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns CRecordRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let name (struct.get parts name))
			(if
				(:doc "A view needs a name in the bridge type namespace.")
				(i32.ltz name)
				(then (return (call c_record_at node -1i32 -1i32 -1i32 0i32 23u32))))
			(let type (struct.get parts operands))
			(if
				(:doc "Report a missing native representation at the complete declaration.")
				(i32.ltz type)
				(then (return (call c_record_at node -1i32 -1i32 -1i32 0i32 23u32))))
			(let representation (array.load nodes type))
			(let native (call check_c_type_spelling (borrow-shared source) (borrow-shared nodes)
				(call read_c_type_form (borrow-shared source) (borrow-shared nodes) representation)))
			(if
				(:doc "C type diagnostics identify the literal or form that supplied it.")
				(u32.gtz (struct.get native error))
				(then (return (struct.new CRecordRead (name -1i32) (native -1i32) (first -1i32) (count 0i32)
					(start (struct.get native start)) (end (struct.get native end)) (error (struct.get native error))))))
			(let fields (call next_form_operand (borrow-shared source) (borrow-shared nodes) representation))
			(if
				(:doc "A record view requires its fields form after the representation.")
				(bool.or (i32.ltz fields)
					(i32.lt -1i32 (call next_form_operand (borrow-shared source) (borrow-shared nodes) (array.load nodes fields))))
				(then (return (call c_record_at node -1i32 -1i32 -1i32 0i32 23u32))))
			(return (call read_c_fields (borrow-shared source) (borrow-shared nodes)
				(array.load nodes fields) name (struct.get native native))))))
