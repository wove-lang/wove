								(u8.eq mode c_sync_callback_mode)
								(then
									(set mode c_nullable_sync_callback_mode)
									(set nullable_callbacks (i32.inc nullable_callbacks))))
							(if
								(:doc "Keep the original formal and conversion operands.")
								(u8.not-eq mode (struct.get slot mode))
								(then (array.store contracts index
									(struct.new CArgument (mode mode) (size (struct.get slot size)) (count (struct.get slot count))
										(integer (struct.get slot integer)) (scalar_ref (struct.get slot scalar_ref))
										(nullable_reference (struct.get slot nullable_reference))
										(owner_mode (struct.get slot owner_mode)) (nullable (bool true))))))))
					(if
						(:doc "A callback formal needs an explicit synchronous contract and a fixed C prototype.")
						(bool.and (call is_c_callback_type (borrow-shared source) (borrow-shared nodes) type)
							(bool.or (bool.not (call is_c_sync_callback_mode mode))
								(bool.or (struct.get arguments macro) (i32.not-eqz (struct.get arguments variadic)))))
						(then (return (call c_argument_error_at type))))
					(let vector (call is_c_vector_mode mode))
					(let retained (u8.eq mode c_static_string_mode))
					(let typed_nullable (u8.eq mode c_nullable_native_reference_mode))
					(if
						(:doc "Fixed null removal uses a separate bridge and cannot share the retained string formal.")
						(bool.and retained (struct.get slot nullable))
						(then (return (call c_argument_error_at type))))
					(let marked (u8.eq mode c_marked_handle_out_mode))
					(let void_formal (bool.or marked (bool.or (u8.eq mode c_void_pointer_mode)
						(u8.eq mode c_shared_handle_slot_mode))))
					(if
						(:doc "The sentinel flag accompanies the unmodified native i32 status.")
						(bool.and marked (u32.not-eq status 5u32))
						(then (return (call c_argument_error_at type))))
					(set vectors (bool.or vectors vector))
					(set void_pointer (bool.or void_pointer void_formal))
					(if
						(:doc "Checked native pointer contracts require a matching C function prototype.")
						(bool.and (bool.or (bool.or void_formal retained) (bool.or vector
								(bool.or (call accepts_c_null mode) (call is_c_init_mode mode))))
							(bool.or (struct.get arguments macro)
								(bool.or (i32.gtz (struct.get arguments variadic))
									(bool.and (bool.or typed_nullable (bool.or void_formal retained))
										(i32.ltz (struct.get arguments variadic))))))
						(then (return (call c_argument_error_at type))))
					(if
						(:doc "A shared scalar formal needs an explicit typed nullable or void pointer contract.")
						(bool.and (u32.eq (struct.get slot scalar_ref) 1u32)
							(bool.not (bool.or typed_nullable void_formal)))
						(then
							(let reference (call form_parts (borrow-shared source) (borrow-shared nodes) type))
							(return (call c_argument_error_at (array.load nodes (struct.get reference operands))))))
					(if
						(:doc "An unannotated view is unavailable in a native signature.")
						(bool.and (call is_c_value_mode mode)
							(bool.or (u32.gtz (struct.get
								(call read_c_view_type (borrow-shared source) (borrow-shared nodes) type (bool false)) access))
								(u32.gtz (call c_byte_slice_type (borrow-shared source) (borrow-shared nodes)
									type (bool true)))))
						(then (return (call c_argument_error_at type))))
					(if
						(:doc "Count each distinct owner initialization formal.")
						(call is_c_init_mode mode)
						(then (set initializers (i32.inc initializers))))
					(set handle_out (bool.or handle_out (call is_c_handle_init_mode mode)))
					(set parameter (call next_c_value_formal (borrow-shared source) (borrow-shared nodes)
						(struct.get node next_sibling)))
					(set index (i32.inc index))))
			(return (struct.new CArguments (strings (struct.get arguments strings)) (vectors vectors)
				(extents (struct.get arguments extents))
				(nulls (i32.add nullable_callbacks (i32.add (struct.get nulls nulls) (struct.get arguments nulls))))
				(initializers initializers) (handle_out handle_out) (void_pointer void_pointer) (macro (struct.get arguments macro))
				(variadic (struct.get arguments variadic)) (start 0i32) (end 0i32) (error 0u32))))))
