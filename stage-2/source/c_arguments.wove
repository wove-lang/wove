	(fn read_c_directive
		(:doc `Dispatch the recognized argument directives in the checked pragma stream.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(node SourceNode) (null_pass bool) (contracts (mut-array CArgument)))
		(returns CArguments)
