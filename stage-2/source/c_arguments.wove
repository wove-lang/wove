(module source_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read named native argument contracts from a bridge function's pragma prefix.

	Resolve directives against the checked formal parameters. Store one
	native argument contract per formal and retain the original span of a bad contract.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts source_keyword (type FormParts)))
	(use wove-file "./types.wove" (only source_builtin_type reference_mode))
	(use wove-file "./owned.wove" (only is_byte_owner_descriptor))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../c/arguments.wove"
		(only c_value_mode c_checked_string_mode c_raw_string_mode c_bytes_mode is_c_value_mode is_c_bytes_mode
			c_null_mode is_c_null_mode c_nullable_mode is_c_nullable_mode accepts_c_null is_c_string_mode c_vector_mode is_c_vector_mode c_array_mode is_c_array_mode is_c_extent_mode c_storage_init_mode is_c_storage_init_mode))

	(struct CArgument (fields (mode u8) (size i32) (count i32) (integer bool) (mutable_scalar bool) (storage_mut bool) (nullable bool)))
	(struct CArguments (fields (strings i32) (vectors bool) (extents i32) (nulls i32) (initializers i32) (macro bool) (variadic i32) (start i32) (end i32) (error u32)))
	(struct CFormal (fields (position i32) (type_node i32) (start i32) (end i32)))

	(struct CViewType (fields (access u32) (element i32)))

	(let array_directive "c_array")
	(let vector_directive "c_cstrs")
	(let null_directive "c_null")
	(let nullable_directive "c_nullable")
	(let init_directive "c_init")
	(let macro_directive "c_macro")
	(let variadic_directive "c_variadic")
	(let open_tail "...")

	(fn read_c_view_type
		(:doc `Retain the access mode and single element operand of a native view parameter.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns CViewType)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (record.get (local parts) head))
			(let element (record.get (local parts) operands))
			(if
				(:doc "A native view must have one element operand.")
				(bool.or (i32.lt (local head) 0i32) (i32.lt (local element) 0i32))
				(then (return (record.make CViewType (access 0u32) (element -1i32)))))
			(let mode (call source_builtin_type (borrow-shared (local source)) (slice.load (local nodes) (local head))))
			(if
				(:doc "Keep mutability and the original element node for native type resolution.")
				(bool.and (bool.or (u32.eq (local mode) 34u32) (u32.eq (local mode) 38u32))
					(i32.lt (record.get (slice.load (local nodes) (local element)) next_sibling) 0i32))
				(then (return (record.make CViewType (access (local mode)) (element (local element))))))
			(return (record.make CViewType (access 0u32) (element -1i32)))))

	(fn c_byte_slice_type
		(:doc `Return the byte-slice access mode, or zero for another type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let view (call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let element (record.get (local view) element))
			(if
				(:doc "Byte contracts accept only the built-in u8 element.")
				(bool.and (i32.lt -1i32 (local element))
					(u32.eq (call source_builtin_type (borrow-shared (local source)) (slice.load (local nodes) (local element))) 10u32))
				(then (return (record.get (local view) access))))
			(return 0u32)))

	(fn c_row_slice_type
		(:doc `Return the access mode of a view whose elements own bytes.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let view (call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let element (record.get (local view) element))
			(if
				(:doc "Only owned byte rows can be marshalled into a C string table.")
				(bool.and (i32.lt -1i32 (local element))
					(call is_byte_owner_descriptor (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local nodes) (local element))))
				(then (return (record.get (local view) access))))
			(return 0u32)))

	(fn c_argument_directive
		(:doc `Map a recognized pragma to its native argument mode. Other directives leave the ABI unchanged.`)
		(params (source (shared-slice u8)) (head SourceNode))
		(returns u8)
		(body
			(let start (record.get (local head) start))
			(let width (i32.sub.wrapping (record.get (local head) end) (local start)))
			(if
				(:doc "Use detached vector storage for the complete c_cstrs spelling.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local vector_directive)))
				(then (return (call c_vector_mode))))
			(if
				(:doc "An array bound counts native elements.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local array_directive)))
				(then (return (call c_array_mode))))
			(if
				(:doc "Allow explicit null where the nullable contract is implemented.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local nullable_directive)))
				(then (return (call c_nullable_mode))))
			(if
				(:doc "An initialization contract activates caller-owned native storage.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local init_directive)))
				(then (return (call c_storage_init_mode))))
			(if
				(:doc "Match the entire c_bytes directive spelling.")
				(bool.and (i32.eq (local width) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 95u8 98u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32)
							121u8 116u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 115u8))))
				(then (return (call c_bytes_mode))))
			(if
				(:doc "The complete common spelling fits in either supported directive.")
				(bool.not (bool.and (bool.or (i32.eq (local width) 6i32) (i32.eq (local width) 10i32))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 95u8 99u8)
						(call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 3i32)
							115u8 116u8 114u8))))
				(then (return (call c_value_mode))))
			(if
				(:doc "The shorter spelling ends after c_cstr.")
				(i32.eq (local width) 6i32)
				(then (return (call c_checked_string_mode))))
			(if
				(:doc "Raw conversion requires the complete _raw suffix.")
				(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 6i32 95u8)
					(call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) 7i32)
						114u8 97u8 119u8))
				(then (return (call c_raw_string_mode))))
			(return (call c_value_mode))))

	(fn c_argument_error
		(:doc `Point an invalid native argument contract at its original source span.`)
		(params (start i32) (end i32))
		(returns CArguments)
		(body (return (record.make CArguments (strings 0i32) (vectors (bool false)) (extents 0i32) (nulls 0i32) (initializers 0i32) (macro (bool false)) (variadic 0i32)
			(start (local start)) (end (local end)) (error 23u32)))))

	(fn c_argument_error_at
		(:doc `Use the entire offending directive or operand span.`)
		(params (node SourceNode))
		(returns CArguments)
		(body (return (call c_argument_error (record.get (local node) start) (record.get (local node) end)))))

	(fn checked_c_arguments
		(:doc `Retain conversion counts, a macro marker, and the first variadic formal's ordinal.`)
		(params (strings i32) (extents i32) (nulls i32) (macro bool) (variadic i32))
		(returns CArguments)
		(body (return (record.make CArguments (strings (local strings)) (vectors (bool false)) (extents (local extents)) (nulls (local nulls)) (initializers 0i32) (macro (local macro)) (variadic (local variadic))
			(start 0i32) (end 0i32) (error 0u32)))))

	(fn c_formal
		(:doc `Keep an original formal position or the problem's source span.`)
		(params (position i32) (type_node i32) (site SourceNode))
		(returns CFormal)
		(body (return (record.make CFormal (position (local position)) (type_node (local type_node))
			(start (record.get (local site) start)) (end (record.get (local site) end))))))

	(fn mark_c_argument_type
		(:doc `Record resolved argument types before applying the contracts.`)
		(params (contracts (mut-slice CArgument)) (index i32) (integer bool) (mutable_scalar bool) (storage_mut bool))
		(returns void)
		(body
			(slice.store (local contracts) (local index)
				(record.make CArgument (mode (call c_value_mode)) (size 0i32) (count 0i32)
					(integer (local integer)) (mutable_scalar (local mutable_scalar))
					(storage_mut (local storage_mut)) (nullable (bool false))))))

	(fn accepts_c_formal
		(:doc `Check a resolved formal against the requested native argument role.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (type SourceNode) (mode u8) (formal CArgument))
		(returns bool)
		(body
			(if
				(:doc "Both extent operands must have resolved to integer types.")
				(call is_c_value_mode (local mode))
				(then (return (record.get (local formal) integer))))
			(let rows (call c_row_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(if
				(:doc "C string vectors borrow the rows through a shared projection.")
				(call is_c_vector_mode (local mode))
				(then (return (u32.eq (local rows) 34u32))))
			(if
				(:doc "A native array exposes copyable elements through either view access mode.")
				(call is_c_array_mode (local mode))
				(then (return (bool.and (u32.eq (local rows) 0u32)
					(u32.lt 0u32 (record.get
						(call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)) access))))))
			(if
				(:doc "Initialization needs mutable caller-owned storage and excludes nullable formals.")
				(call is_c_storage_init_mode (local mode))
				(then (return (bool.and (record.get (local formal) storage_mut)
					(bool.not (record.get (local formal) nullable))))))
			(if
				(:doc "Nullable annotations name checked pointer shapes. Mutable scalar pointers can use this contract now.")
				(call is_c_nullable_mode (local mode))
				(then
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
					(return (bool.or
						(u32.lt 0u32 (call reference_mode (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
						(u32.lt 0u32 (record.get (call read_c_view_type (borrow-shared (local source))
							(borrow-shared (local nodes)) (local type)) access))))))
			(let view (call c_byte_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(return (bool.or (u32.eq (local view) 34u32)
				(bool.and (bool.or (bool.or (call is_c_bytes_mode (local mode)) (call is_c_string_mode (local mode)))
					(bool.or (call is_c_null_mode (local mode)) (call is_c_null_mode (record.get (local formal) mode))))
					(u32.eq (local view) 38u32))))))

	(fn find_named_c_formal
		(:doc `Resolve a bare formal name to its ordinal and declared type node.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32) (name SourceNode))
		(returns CFormal)
		(body
			(if
				(:doc "Quoted strings and forms cannot name a formal parameter.")
				(bool.not (u32.eq (record.get (local name) kind) 1u32))
				(then (return (call c_formal -1i32 -1i32 (local name)))))
			(let-mut parameter (local first))
			(let-mut index 0i32)
			(while
				(:doc "Search the checked parameter list in its original order.")
				(bool.not (i32.lt (local parameter) 0i32))
				(body
					(let node (slice.load (local nodes) (local parameter)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let spelling (slice.load (local nodes) (record.get (local parts) head)))
					(if
						(:doc "Return the declared formal's ordinal and type at the original name span.")
						(call same_bytes (borrow-shared (local source))
							(record.get (local spelling) start) (record.get (local spelling) end)
							(borrow-shared (local source)) (record.get (local name) start) (record.get (local name) end))
						(then (return (call c_formal (local index) (record.get (local parts) operands) (local name)))))
					(set (local parameter) (record.get (local node) next_sibling))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (call c_formal -1i32 -1i32 (local name)))))

	(fn find_c_formal
		(:doc `Check the named formal's type for the requested argument adaptation.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32) (name SourceNode) (mode u8)
			(contracts (shared-slice CArgument)))
		(returns CFormal)
		(body
			(let formal (call find_named_c_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first) (local name)))
			(let type_node (record.get (local formal) type_node))
			(if
				(:doc "Only a resolved name carries a valid type node.")
				(i32.lt -1i32 (local type_node))
				(then
					(let type (slice.load (local nodes) (local type_node)))
					(if
						(:doc "An incompatible formal points to its declared type.")
						(bool.not (call accepts_c_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local type) (local mode)
							(slice.load (local contracts) (record.get (local formal) position))))
						(then (return (call c_formal -1i32 -1i32 (local type)))))))
			(return (local formal))))

	(fn reserve_c_argument
		(:doc `Record one checked contract. Identical repeated directives keep the original contract.`)
		(params (contracts (mut-slice CArgument)) (formal CFormal) (mode u8) (size i32) (count i32))
		(returns CArguments)
		(body
			(let index (record.get (local formal) position))
			(let prior (slice.load (local contracts) (local index)))
			(let prior_mode (record.get (local prior) mode))
			(if
				(:doc "Null takes the C-string slot without constructing a copy or counting a descriptor.")
				(bool.and (call is_c_null_mode (local prior_mode)) (call is_c_string_mode (local mode)))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "Different modes or extent operands conflict at the later data name.")
				(bool.not (call is_c_value_mode (local prior_mode)))
				(then
					(if
						(:doc "A repeated contract contributes no additional converted formal.")
						(bool.and (u8.eq (local prior_mode) (local mode))
							(bool.and (i32.eq (record.get (local prior) size) (local size))
								(i32.eq (record.get (local prior) count) (local count))))
						(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
					(return (call c_argument_error (record.get (local formal) start) (record.get (local formal) end)))))
			(slice.store (local contracts) (local index)
				(record.make CArgument (mode (local mode)) (size (local size)) (count (local count))
					(integer (record.get (local prior) integer)) (mutable_scalar (record.get (local prior) mutable_scalar))
					(storage_mut (record.get (local prior) storage_mut)) (nullable (record.get (local prior) nullable))))
			(if
				(:doc "Each bounded pointer contributes one extent check.")
				(call is_c_extent_mode (local mode))
				(then (return (call checked_c_arguments 0i32 1i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A null-capable contract uses no string scratch slot.")
				(call accepts_c_null (local mode))
				(then (return (call checked_c_arguments 0i32 0i32 1i32 (bool false) 0i32))))
			(if
				(:doc "Vector and initializer formals are found in the final checked contract table.")
				(bool.or (call is_c_storage_init_mode (local mode)) (call is_c_vector_mode (local mode)))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(return (call checked_c_arguments 1i32 0i32 0i32 (bool false) 0i32))))

	(fn read_c_byte_extent
		(:doc `Resolve c_bytes data count or c_bytes data size count in formal order.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(directive SourceNode) (begin i32) (contracts (mut-slice CArgument)))
		(returns CArguments)
		(body
			(let data (slice.load (local nodes) (local begin)))
			(let second (record.get (local data) next_sibling))
			(if
				(:doc "The byte view requires a count operand.")
				(i32.lt (local second) 0i32)
				(then (return (call c_argument_error_at (local directive)))))
			(let third (record.get (slice.load (local nodes) (local second)) next_sibling))
			(if
				(:doc "Reject an extra operand after data, size, and count.")
				(bool.and (bool.not (i32.lt (local third) 0i32))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local third)) next_sibling) 0i32)))
				(then (return (call c_argument_error_at (local directive)))))
			(let view (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local data) (call c_bytes_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Preserve the byte view's lookup or type diagnostic.")
				(i32.lt (record.get (local view) position) 0i32)
				(then (return (call c_argument_error (record.get (local view) start) (record.get (local view) end)))))
			(let-mut size -1i32)
			(let-mut count_node (local second))
			(if
				(:doc "A product checks its size operand before its count operand.")
				(bool.not (i32.lt (local third) 0i32))
				(then
					(let found (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (slice.load (local nodes) (local second)) (call c_value_mode) (borrow-shared (local contracts))))
					(if
						(:doc "Report an invalid size at its name or formal type.")
						(i32.lt (record.get (local found) position) 0i32)
						(then (return (call c_argument_error (record.get (local found) start) (record.get (local found) end)))))
					(set (local size) (record.get (local found) position))
					(set (local count_node) (local third))))
			(let count (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (slice.load (local nodes) (local count_node)) (call c_value_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Report an invalid count at its name or formal type.")
				(i32.lt (record.get (local count) position) 0i32)
				(then (return (call c_argument_error (record.get (local count) start) (record.get (local count) end)))))
			(return (call reserve_c_argument (borrow-mut (local contracts)) (local view)
				(call c_bytes_mode) (local size) (record.get (local count) position)))))

	(fn read_c_array_extent
		(:doc `Bind a view to a literal element count or an integer formal.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(directive SourceNode) (begin i32) (contracts (mut-slice CArgument)))
		(returns CArguments)
		(body
			(let data (slice.load (local nodes) (local begin)))
			(let count_node (record.get (local data) next_sibling))
			(if
				(:doc "An array contract requires exactly one count.")
				(bool.or (i32.lt (local count_node) 0i32)
					(i32.lt -1i32 (record.get (slice.load (local nodes) (local count_node)) next_sibling)))
				(then (return (call c_argument_error_at (local directive)))))
			(let view (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local data) (call c_array_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Keep the defining span of an invalid array formal.")
				(i32.lt (record.get (local view) position) 0i32)
				(then (return (call c_argument_error (record.get (local view) start) (record.get (local view) end)))))
			(let count (slice.load (local nodes) (local count_node)))
			(let literal (call read_decimal_digits (borrow-shared (local source))
				(record.get (local count) start) (record.get (local count) end) 214748364u32 7u32))
			(if
				(:doc "A literal must fit the signed slice length domain.")
				(i32.lt -1i32 (record.get (local literal) digits))
				(then (return (call reserve_c_argument (borrow-mut (local contracts)) (local view) (call c_array_mode)
					(int.convert i32 (record.get (local literal) magnitude)) -1i32))))
			(let formal (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local count) (call c_value_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Report an invalid named count at the name or its declared type.")
				(i32.lt (record.get (local formal) position) 0i32)
				(then (return (call c_argument_error (record.get (local formal) start) (record.get (local formal) end)))))
			(return (call reserve_c_argument (borrow-mut (local contracts)) (local view) (call c_array_mode)
				-1i32 (record.get (local formal) position)))))

	(fn read_c_pointer_list
		(:doc `Bind string, null, and initialization contracts to named pointer formals.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(begin i32) (mode u8) (contracts (mut-slice CArgument)))
		(returns CArguments)
		(body
			(let-mut index (local begin))
			(let-mut count 0i32)
			(while
				(:doc "Each operand names one pointer formal.")
				(bool.not (i32.lt (local index) 0i32))
				(body
					(let name (slice.load (local nodes) (local index)))
					(let formal (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (local name) (local mode) (borrow-shared (local contracts))))
					(if
						(:doc "Preserve the first invalid named formal at its own span.")
						(i32.lt (record.get (local formal) position) 0i32)
						(then (return (call c_argument_error (record.get (local formal) start) (record.get (local formal) end)))))
					(let position (record.get (local formal) position))
					(let slot (slice.load (local contracts) (local position)))
					(if
						(:doc "Check that nullable and initialization directives cannot name the same storage.")
						(bool.and (call is_c_nullable_mode (local mode)) (record.get (local slot) storage_mut))
						(then
							(if
								(:doc "An initializer always needs caller-provided storage.")
								(call is_c_storage_init_mode (record.get (local slot) mode))
								(then (return (call c_argument_error_at (local name)))))
							(slice.store (local contracts) (local position)
								(record.make CArgument (mode (record.get (local slot) mode))
									(size (record.get (local slot) size)) (count (record.get (local slot) count))
									(integer (record.get (local slot) integer)) (mutable_scalar (record.get (local slot) mutable_scalar))
									(storage_mut (bool true)) (nullable (bool true))))))
					(if
						(:doc "Other nullable pointer shapes keep their existing lowering until their contracts are implemented.")
						(bool.or (bool.not (call is_c_nullable_mode (local mode))) (record.get (local slot) mutable_scalar))
						(then
							(let bound (call reserve_c_argument (borrow-mut (local contracts)) (local formal) (local mode) -1i32 -1i32))
							(if
								(:doc "Stop at a conflicting conversion.")
								(u32.lt 0u32 (record.get (local bound) error))
								(then (return (local bound))))
							(set (local count) (i32.add.wrapping (local count)
								(i32.add.wrapping (record.get (local bound) strings) (record.get (local bound) nulls))))))
					(set (local index) (record.get (local name) next_sibling))))
			(if
				(:doc "Count null-capable slots separately from converted strings.")
				(call accepts_c_null (local mode))
				(then (return (call checked_c_arguments 0i32 0i32 (local count) (bool false) 0i32))))
			(return (call checked_c_arguments (local count) 0i32 0i32 (bool false) 0i32))))

	(fn matches_pragma
		(:doc `Compare the entire spelling of a native pragma head or bare operand.`)
		(params (source (shared-slice u8)) (node SourceNode) (spelling (shared-slice u8)))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared (local source)) (record.get (local node) start) (record.get (local node) end)
				(borrow-shared (local spelling)) 0i32 (slice.len (local spelling))))))

	(fn read_c_variadic
		(:doc `Use a named formal after the fixed prefix as the declared variadic boundary.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32) (operand i32))
		(returns CArguments)
		(body
			(if
				(:doc "An empty marker retains the current signature behavior.")
				(i32.lt (local operand) 0i32)
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(let name (slice.load (local nodes) (local operand)))
			(let extra (record.get (local name) next_sibling))
			(if
				(:doc "The marker has space for one boundary operand.")
				(i32.lt -1i32 (local extra))
				(then (return (call c_argument_error_at (slice.load (local nodes) (local extra))))))
			(if
				(:doc "An open tail retains the current declared argument list.")
				(call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local open_tail)))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(let formal (call find_named_c_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first) (local name)))
			(let position (record.get (local formal) position))
			(if
				(:doc "C requires a known boundary after at least one fixed formal.")
				(i32.lt (local position) 1i32)
				(then (return (call c_argument_error_at (local name)))))
			(return (call checked_c_arguments 0i32 0i32 0i32 (bool false) (local position)))))

	(fn read_c_directive
		(:doc `Dispatch the recognized argument directives in the checked pragma stream.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(node SourceNode) (null_pass bool) (contracts (mut-slice CArgument)))
		(returns CArguments)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (record.get (local parts) head))
			(if
				(:doc "Select only directives with a checked form head.")
				(i32.lt (local head) 0i32)
				(then (return (call c_argument_error_at (local node)))))
			(let name (slice.load (local nodes) (local head)))
			(let begin (record.get (local parts) operands))
			(let null (call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local null_directive))))
			(if
				(:doc "Read null-only slots before the remaining directives, regardless of their source order.")
				(local null_pass)
				(then
					(if (bool.not (local null)) (then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
					(if (i32.lt (local begin) 0i32) (then (return (call c_argument_error_at (local node)))))
					(return (call read_c_pointer_list (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (local begin) (call c_null_mode) (borrow-mut (local contracts))))))
			(if (local null) (then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A function-like macro marker takes no operands.")
				(call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local macro_directive)))
				(then
					(if
						(:doc "Point surplus operands to the malformed directive.")
						(bool.not (i32.lt (local begin) 0i32))
						(then (return (call c_argument_error_at (local node)))))
					(return (call checked_c_arguments 0i32 0i32 0i32 (bool true) 0i32))))
			(if
				(:doc "A named variadic boundary changes the C prototype without adapting the argument values.")
				(call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local variadic_directive)))
				(then (return (call read_c_variadic (borrow-shared (local source)) (borrow-shared (local nodes)) (local first) (local begin)))))
			(let mode (call c_argument_directive (borrow-shared (local source)) (local name)))
			(if
				(:doc "Other directives leave these argument contracts untouched.")
				(call is_c_value_mode (local mode))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A native argument directive must name at least its data formal.")
				(i32.lt (local begin) 0i32)
				(then (return (call c_argument_error_at (local node)))))
			(if
				(:doc "A byte view with an extent uses the storage it already borrows.")
				(call is_c_bytes_mode (local mode))
				(then (return (call read_c_byte_extent (borrow-shared (local source)) (borrow-shared (local nodes))
					(local first) (local node) (local begin) (borrow-mut (local contracts))))))
			(if
				(:doc "A typed native view checks the count in elements.")
				(call is_c_array_mode (local mode))
				(then (return (call read_c_array_extent (borrow-shared (local source)) (borrow-shared (local nodes))
					(local first) (local node) (local begin) (borrow-mut (local contracts))))))
			(return (call read_c_pointer_list (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local begin) (local mode) (borrow-mut (local contracts))))))

	(fn read_c_argument_pragmas
		(:doc `Apply one pass of native pragma contracts to the resolved formals.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function FormParts)
			(first i32) (null_pass bool) (contracts (mut-slice CArgument)))
		(returns CArguments)
		(body
			(let-mut entry (record.get (local function) metadata))
			(let-mut strings 0i32)
			(let-mut extents 0i32)
			(let-mut nulls 0i32)
			(let-mut macro (bool false))
			(let-mut variadic 0i32)
			(while
				(:doc "Only the function's pragma metadata can declare an argument contract.")
				(bool.and (bool.not (i32.lt (local entry) 0i32))
					(bool.not (i32.eq (local entry) (record.get (local function) operands))))
				(body
					(let node (slice.load (local nodes) (local entry)))
					(let head (slice.load (local nodes) (record.get (local node) first_child)))
					(if
						(:doc "Ignore metadata other than pragma entries.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
							(let-mut directive (record.get (local parts) operands))
							(while
								(:doc "Apply directives in source order and retain the first failure.")
								(bool.not (i32.lt (local directive) 0i32))
								(body
									(let item (slice.load (local nodes) (local directive)))
									(let checked (call read_c_directive (borrow-shared (local source)) (borrow-shared (local nodes))
										(local first) (local item) (local null_pass) (borrow-mut (local contracts))))
									(if
										(:doc "Forward the original malformed contract span.")
										(u32.lt 0u32 (record.get (local checked) error))
										(then (return (local checked))))
									(let tail (record.get (local checked) variadic))
									(if
										(:doc "Diagnose a repeated macro marker or a macro after a named variadic boundary.")
										(bool.and (record.get (local checked) macro)
											(bool.or (local macro) (i32.lt 0i32 (local variadic))))
										(then (return (call c_argument_error_at (local item)))))
									(if
										(:doc "Repeated boundaries must agree, and a function-like macro has no C prototype.")
										(i32.lt 0i32 (local tail))
										(then
											(if
												(:doc "Point incompatible choices to the new directive.")
												(bool.or (local macro) (bool.and (i32.lt 0i32 (local variadic))
													(bool.not (i32.eq (local tail) (local variadic)))))
												(then (return (call c_argument_error_at (local item)))))
											(set (local variadic) (local tail))))
									(set (local macro) (bool.or (local macro) (record.get (local checked) macro)))
									(set (local strings) (i32.add.wrapping (local strings) (record.get (local checked) strings)))
									(set (local extents) (i32.add.wrapping (local extents) (record.get (local checked) extents)))
									(set (local nulls) (i32.add.wrapping (local nulls) (record.get (local checked) nulls)))
									(set (local directive) (record.get (local item) next_sibling))))))
					(set (local entry) (record.get (local node) next_sibling))))
			(return (call checked_c_arguments (local strings) (local extents) (local nulls) (local macro) (local variadic)))))

	(fn read_c_arguments
		(:doc `Read bridge metadata into one contract slot per checked formal.

		Mark integer slots before applying pragmas. Null-only slots suppress
		string preparation and every native view needs an explicit contract.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (function FormParts)
			(first i32) (contracts (mut-slice CArgument)))
		(returns CArguments)
		(body
			(let nulls (call read_c_argument_pragmas (borrow-shared (local source)) (borrow-shared (local nodes))
				(local function) (local first) (bool true) (borrow-mut (local contracts))))
			(if (u32.lt 0u32 (record.get (local nulls) error)) (then (return (local nulls))))
			(let arguments (call read_c_argument_pragmas (borrow-shared (local source)) (borrow-shared (local nodes))
				(local function) (local first) (bool false) (borrow-mut (local contracts))))
			(if (u32.lt 0u32 (record.get (local arguments) error)) (then (return (local arguments))))
			(let-mut parameter (local first))
			(let-mut index 0i32)
			(let-mut initializers 0i32)
			(let-mut vectors (bool false))
			(while
				(:doc "Every slice formal must define its native ABI.")
				(bool.not (i32.lt (local parameter) 0i32))
				(body
					(let node (slice.load (local nodes) (local parameter)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let type (slice.load (local nodes) (record.get (local parts) operands)))
					(let mode (record.get (slice.load (local contracts) (local index)) mode))
					(let vector (call is_c_vector_mode (local mode)))
					(set (local vectors) (bool.or (local vectors) (local vector)))
					(if
						(:doc "Converted vectors, nullable pointers, and storage initialization use fixed C signatures.")
						(bool.and (bool.or (local vector) (bool.or (call accepts_c_null (local mode)) (call is_c_storage_init_mode (local mode))))
							(bool.or (record.get (local arguments) macro) (i32.lt 0i32 (record.get (local arguments) variadic))))
						(then (return (call c_argument_error_at (local type)))))
					(if
						(:doc "An unannotated view is unavailable in a native signature.")
						(bool.and (call is_c_value_mode (local mode))
							(u32.lt 0u32 (record.get
								(call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)) access)))
						(then (return (call c_argument_error_at (local type)))))
					(if
						(:doc "Count each distinct storage initialization formal.")
						(call is_c_storage_init_mode (local mode))
						(then (set (local initializers) (i32.add.wrapping (local initializers) 1i32))))
					(set (local parameter) (record.get (local node) next_sibling))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (record.make CArguments (strings (record.get (local arguments) strings)) (vectors (local vectors))
				(extents (record.get (local arguments) extents))
				(nulls (i32.add.wrapping (record.get (local nulls) nulls) (record.get (local arguments) nulls)))
				(initializers (local initializers)) (macro (record.get (local arguments) macro))
				(variadic (record.get (local arguments) variadic)) (start 0i32) (end 0i32) (error 0u32))))))
