						function node))))
			(return (call checked_c_arguments strings extents nulls macro variadic))))

	(fn read_c_arguments
		(:doc `Read bridge metadata into one contract slot per checked formal.

		Mark integer and scalar reference slots before applying pragmas.
		Null-only slots suppress string preparation. Nullable shared strings
		prepare scratch only for present views. Native views and shared scalar
		references need explicit contracts.`)
		(:expect (tests "stage-2/cli/native/nullable-cstr/cases.tsv") (issues "gh:wove-lang/wove:584"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts)
			(first i32) (status u32) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let nulls (call read_c_argument_pragmas (borrow-shared source) (borrow-shared nodes)
				function first (bool true) (borrow-mut contracts)))
			(if (u32.gtz (struct.get nulls error)) (then (return nulls)))
			(let arguments (call read_c_argument_pragmas (borrow-shared source) (borrow-shared nodes)
				function first (bool false) (borrow-mut contracts)))
			(if (u32.gtz (struct.get arguments error)) (then (return arguments)))
			(let-mut parameter (call next_c_value_formal (borrow-shared source) (borrow-shared nodes) first))
			(let-mut index 0i32)
			(let-mut nullable_callbacks 0i32)
			(let-mut initializers 0i32)
			(let-mut handle_out (bool false))
			(let-mut vectors (bool false))
			(let-mut void_pointer (bool false))
			(while
				(:doc "Every slice formal must define its native ABI.")
				(i32.not-ltz parameter)
				(body
					(let node (array.load nodes parameter))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let type (array.load nodes (struct.get parts operands)))
					(let slot (array.load contracts index))
					(let-mut mode (struct.get slot mode))
					(let count (struct.get slot count))
					(if
						(:doc "An in-out array count always passes a concrete typed pointer. Check this after all adaptations have bound.")
						(bool.and (call is_c_array_mode mode) (i32.not-ltz count))
						(then
							(let bound (array.load contracts count))
							(if
								(:doc "Null and void-pointer adaptations cannot replace the checked count loan.")
								(bool.and (u32.eq (struct.get bound scalar_ref) 2u32)
									(bool.not (call is_c_value_mode (struct.get bound mode))))
								(then (return (call c_argument_error_at type))))))
					(if
						(:doc "Give each nullable conversion its exact native argument mode.")
						(struct.get slot nullable)
