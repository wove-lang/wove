										(then (return checked)))
									(let tail (struct.get checked variadic))
									(if
										(:doc "Diagnose a repeated macro marker or a macro after a variadic boundary.")
										(bool.and (struct.get checked macro)
											(bool.or macro (i32.gtz variadic)))
										(then (return (call c_argument_error_at item))))
									(if
										(:doc "Repeated boundaries must agree, and a function-like macro has no C prototype.")
										(i32.gtz tail)
