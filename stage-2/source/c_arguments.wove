(module source_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read named native argument contracts from a bridge function's pragmas.

	Resolve directives against the checked formal parameters. Store one
	native argument contract per formal and retain the original span of a bad contract.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./types.wove" (only source_builtin_type reference_mode))
	(use wove-file "./owned.wove" (only is_byte_owner_descriptor))
	(use wove-file "./c_formals.wove" (only next_c_value_formal))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../c/arguments.wove"
		(only c_value_mode c_checked_string_mode c_raw_string_mode c_bytes_mode is_c_value_mode is_c_bytes_mode
			c_null_mode is_c_null_mode c_nullable_mode is_c_nullable_mode accepts_c_null is_c_string_mode c_vector_mode is_c_vector_mode c_array_mode is_c_array_mode is_c_extent_mode c_storage_init_mode is_c_storage_init_mode c_handle_init_mode is_c_handle_init_mode is_c_init_mode (value c_open_variadic_tail) (value c_void_pointer_mode)))

	(struct CArgument (fields (mode u8) (size i32) (count i32) (integer bool) (scalar_ref u32) (owner_mode u8) (nullable bool)))
	(struct CArguments (fields (strings i32) (vectors bool) (extents i32) (nulls i32) (initializers i32) (handle_out bool) (void_pointer bool) (macro bool) (variadic i32) (start i32) (end i32) (error u32)))
	(struct CFormal (fields (row i32) (position i32) (type_node i32) (start i32) (end i32)))

	(struct CViewType (fields (access u32) (element i32)))

	(let array_directive "c_array")
	(let void_pointer_directive "c_void_ptr")
	(let vector_directive "c_cstrs")
	(let null_directive "c_null")
	(let nullable_directive "c_nullable")
	(let init_directive "c_init")
	(let macro_directive "c_macro")
	(let variadic_directive "c_variadic")
	(let open_tail "...")

	(fn read_c_view_type
		(:doc `Retain the access mode and single element operand of a native view parameter.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns CViewType)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (struct.get (local parts) head))
			(let element (struct.get (local parts) operands))
			(if
				(:doc "A native view must have one element operand.")
				(bool.or (i32.ltz (local head)) (i32.ltz (local element)))
				(then (return (struct.new CViewType (access 0u32) (element -1i32)))))
			(let mode (call source_builtin_type (borrow-shared (local source)) (array.load (local nodes) (local head))))
			(if
				(:doc "Keep mutability and the original element node for native type resolution.")
				(bool.and (bool.or (u32.eq (local mode) 34u32) (u32.eq (local mode) 38u32))
					(i32.ltz (struct.get (array.load (local nodes) (local element)) next_sibling)))
				(then (return (struct.new CViewType (access (local mode)) (element (local element))))))
			(return (struct.new CViewType (access 0u32) (element -1i32)))))

	(fn c_byte_slice_type
		(:doc `Return the byte-slice access mode, or zero for another type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let view (call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let element (struct.get (local view) element))
			(if
				(:doc "Byte contracts accept only the built-in u8 element.")
				(bool.and (i32.lt -1i32 (local element))
					(u32.eq (call source_builtin_type (borrow-shared (local source)) (array.load (local nodes) (local element))) 10u32))
				(then (return (struct.get (local view) access))))
			(return 0u32)))

	(fn c_row_slice_type
		(:doc `Return the access mode of a view whose elements own bytes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let view (call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let element (struct.get (local view) element))
			(if
				(:doc "Only owned byte rows can be marshalled into a C string table.")
				(bool.and (i32.lt -1i32 (local element))
					(call is_byte_owner_descriptor (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local nodes) (local element))))
				(then (return (struct.get (local view) access))))
			(return 0u32)))

	(fn c_argument_directive
		(:doc `Map a recognized pragma to its native argument mode. Other directives leave the ABI unchanged.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns u8)
		(body
			(let start (struct.get (local head) start))
			(let width (i32.sub (struct.get (local head) end) (local start)))
			(if
				(:doc "Use detached vector storage for the complete c_cstrs spelling.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local vector_directive)))
				(then (return (call c_vector_mode))))
			(if
				(:doc "An array bound counts native elements.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local array_directive)))
				(then (return (call c_array_mode))))
			(if
				(:doc "A typed scalar loan can use the native void pointer ABI.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local void_pointer_directive)))
				(then (return (local c_void_pointer_mode))))
			(if
				(:doc "Allow explicit null where the nullable contract is implemented.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local nullable_directive)))
				(then (return (call c_nullable_mode))))
			(if
				(:doc "Resolve initialization against the named owner formal.")
				(call matches_pragma (borrow-shared (local source)) (local head) (borrow-shared (local init_directive)))
				(then (return (call c_storage_init_mode))))
			(if
				(:doc "Match the entire c_bytes directive spelling.")
				(bool.and (i32.eq (local width) 7i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 95u8 98u8)
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32)
							121u8 116u8 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 115u8))))
				(then (return (call c_bytes_mode))))
			(if
				(:doc "The complete common spelling fits in either supported directive.")
				(bool.not (bool.and (bool.or (i32.eq (local width) 6i32) (i32.eq (local width) 10i32))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 99u8 95u8 99u8)
						(call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32)
							115u8 116u8 114u8))))
				(then (return (call c_value_mode))))
			(if
				(:doc "The shorter spelling ends after c_cstr.")
				(i32.eq (local width) 6i32)
				(then (return (call c_checked_string_mode))))
			(if
				(:doc "Raw conversion requires the complete _raw suffix.")
				(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 6i32 95u8)
					(call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 7i32)
						114u8 97u8 119u8))
				(then (return (call c_raw_string_mode))))
			(return (call c_value_mode))))

	(fn c_argument_error
		(:doc `Point an invalid native argument contract at its original source span.`)
		(params (start i32) (end i32))
		(returns CArguments)
		(body (return (struct.new CArguments (strings 0i32) (vectors (bool false)) (extents 0i32) (nulls 0i32) (initializers 0i32) (handle_out (bool false)) (void_pointer (bool false)) (macro (bool false)) (variadic 0i32)
			(start (local start)) (end (local end)) (error 23u32)))))

	(fn c_argument_error_at
		(:doc `Use the entire offending directive or operand span.`)
		(params (node SourceNode))
		(returns CArguments)
		(body (return (call c_argument_error (struct.get (local node) start) (struct.get (local node) end)))))

	(fn checked_c_arguments
		(:doc `Retain conversion counts, a macro marker, and the first variadic formal's source row.`)
		(params (strings i32) (extents i32) (nulls i32) (macro bool) (variadic i32))
		(returns CArguments)
		(body (return (struct.new CArguments (strings (local strings)) (vectors (bool false)) (extents (local extents)) (nulls (local nulls)) (initializers 0i32) (handle_out (bool false)) (void_pointer (bool false)) (macro (local macro)) (variadic (local variadic))
			(start 0i32) (end 0i32) (error 0u32)))))

	(fn c_formal
		(:doc `Keep an original formal position or the problem's source span.`)
		(params (row i32) (position i32) (type_node i32) (site SourceNode))
		(returns CFormal)
		(body (return (struct.new CFormal (row (local row)) (position (local position)) (type_node (local type_node))
			(start (struct.get (local site) start)) (end (struct.get (local site) end))))))

	(fn mark_c_argument_type
		(:doc `Record resolved argument types before applying the contracts.`)
		(params (contracts (mut-array CArgument)) (index i32) (integer bool) (scalar_ref u32) (owner_mode u8))
		(returns void)
		(body
			(array.store (local contracts) (local index)
				(struct.new CArgument (mode (call c_value_mode)) (size 0i32) (count 0i32)
					(integer (local integer)) (scalar_ref (local scalar_ref))
					(owner_mode (local owner_mode)) (nullable (bool false))))))

	(fn accepts_c_formal
		(:doc `Check a resolved formal against the requested native argument role.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type SourceNode) (mode u8) (formal CArgument))
		(returns bool)
		(body
			(if
				(:doc "Both extent operands must have resolved to integer types.")
				(call is_c_value_mode (local mode))
				(then (return (struct.get (local formal) integer))))
			(if
				(:doc "Only a scalar place can use this borrowed void pointer ABI.")
				(u8.eq (local mode) (local c_void_pointer_mode))
				(then (return (u32.gtz (struct.get (local formal) scalar_ref)))))
			(let rows (call c_row_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(if
				(:doc "C string vectors borrow the rows through a shared projection.")
				(call is_c_vector_mode (local mode))
				(then (return (u32.eq (local rows) 34u32))))
			(if
				(:doc "A native array exposes copyable elements through either view access mode.")
				(call is_c_array_mode (local mode))
				(then (return (bool.and (u32.eqz (local rows))
					(u32.gtz (struct.get
						(call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)) access))))))
			(if
				(:doc "Initialization needs a mutable native owner and excludes nullable formals.")
				(call is_c_storage_init_mode (local mode))
				(then (return (bool.and (bool.not (call is_c_value_mode (struct.get (local formal) owner_mode)))
					(bool.not (struct.get (local formal) nullable))))))
			(if
				(:doc "Nullable annotations name checked pointer shapes. Mutable scalar pointers can use this contract now.")
				(call is_c_nullable_mode (local mode))
				(then
					(if
						(:doc "Shared scalar void pointers always borrow a concrete place.")
						(u32.eq (struct.get (local formal) scalar_ref) 1u32)
						(then (return (bool false))))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
					(return (bool.or
						(u32.gtz (call reference_mode (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parts) head)))
						(u32.gtz (struct.get (call read_c_view_type (borrow-shared (local source))
							(borrow-shared (local nodes)) (local type)) access))))))
			(let view (call c_byte_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(return (bool.or (u32.eq (local view) 34u32)
				(bool.and (bool.or (bool.or (call is_c_bytes_mode (local mode)) (call is_c_string_mode (local mode)))
					(bool.or (call is_c_null_mode (local mode)) (call is_c_null_mode (struct.get (local formal) mode))))
					(u32.eq (local view) 38u32))))))

	(fn find_named_c_formal
		(:doc `Resolve a bare formal name to its ordinal and declared type node.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode))
		(returns CFormal)
		(body
			(if
				(:doc "Quoted strings and forms cannot name a formal parameter.")
				(u32.not-eq (struct.get (local name) kind) 1u32)
				(then (return (call c_formal -1i32 -1i32 -1i32 (local name)))))
			(let-mut parameter (call next_c_value_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)))
			(let-mut index 0i32)
			(while
				(:doc "Search the checked parameter list in its original order.")
				(i32.not-ltz (local parameter))
				(body
					(let node (array.load (local nodes) (local parameter)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let spelling (array.load (local nodes) (struct.get (local parts) head)))
					(if
						(:doc "Return the declared formal's ordinal and type at the original name span.")
						(call same_bytes (borrow-shared (local source))
							(struct.get (local spelling) start) (struct.get (local spelling) end)
							(borrow-shared (local source)) (struct.get (local name) start) (struct.get (local name) end))
						(then (return (call c_formal (local parameter) (local index) (struct.get (local parts) operands) (local name)))))
					(set (local parameter) (call next_c_value_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local node) next_sibling)))
					(set (local index) (i32.inc (local index)))))
			(return (call c_formal -1i32 -1i32 -1i32 (local name)))))

	(fn find_c_formal
		(:doc `Check the named formal's type for the requested argument adaptation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode) (mode u8)
			(contracts (shared-array CArgument)))
		(returns CFormal)
		(body
			(let formal (call find_named_c_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first) (local name)))
			(let type_node (struct.get (local formal) type_node))
			(if
				(:doc "Only a resolved name carries a valid type node.")
				(i32.lt -1i32 (local type_node))
				(then
					(let type (array.load (local nodes) (local type_node)))
					(if
						(:doc "An incompatible formal points to its declared type.")
						(bool.not (call accepts_c_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local type) (local mode)
							(array.load (local contracts) (struct.get (local formal) position))))
						(then (return (call c_formal -1i32 -1i32 -1i32 (local type)))))))
			(return (local formal))))

	(fn reserve_c_argument
		(:doc `Record one checked contract. Identical repeated directives keep the original contract.`)
		(params (contracts (mut-array CArgument)) (formal CFormal) (mode u8) (size i32) (count i32))
		(returns CArguments)
		(body
			(let index (struct.get (local formal) position))
			(let prior (array.load (local contracts) (local index)))
			(let prior_mode (struct.get (local prior) mode))
			(if
				(:doc "Null takes the C-string slot without constructing a copy or counting a descriptor.")
				(bool.and (call is_c_null_mode (local prior_mode)) (call is_c_string_mode (local mode)))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "Different modes or extent operands conflict at the later data name.")
				(bool.not (call is_c_value_mode (local prior_mode)))
				(then
					(if
						(:doc "A repeated contract contributes no additional converted formal.")
						(bool.and (u8.eq (local prior_mode) (local mode))
							(bool.and (i32.eq (struct.get (local prior) size) (local size))
								(i32.eq (struct.get (local prior) count) (local count))))
						(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
					(return (call c_argument_error (struct.get (local formal) start) (struct.get (local formal) end)))))
			(array.store (local contracts) (local index)
				(struct.new CArgument (mode (local mode)) (size (local size)) (count (local count))
					(integer (struct.get (local prior) integer)) (scalar_ref (struct.get (local prior) scalar_ref))
					(owner_mode (struct.get (local prior) owner_mode)) (nullable (struct.get (local prior) nullable))))
			(if
				(:doc "Each bounded pointer contributes one extent check.")
				(call is_c_extent_mode (local mode))
				(then (return (call checked_c_arguments 0i32 1i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A null-capable contract uses no string scratch slot.")
				(call accepts_c_null (local mode))
				(then (return (call checked_c_arguments 0i32 0i32 1i32 (bool false) 0i32))))
			(if
				(:doc "The final contract table records vectors, initializers, and scalar void pointers.")
				(bool.or (u8.eq (local mode) (local c_void_pointer_mode))
					(bool.or (call is_c_init_mode (local mode)) (call is_c_vector_mode (local mode))))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(return (call checked_c_arguments 1i32 0i32 0i32 (bool false) 0i32))))

	(fn read_c_byte_extent
		(:doc `Resolve c_bytes data count or c_bytes data size count in formal order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(directive SourceNode) (begin i32) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let data (array.load (local nodes) (local begin)))
			(let second (struct.get (local data) next_sibling))
			(if
				(:doc "The byte view requires a count operand.")
				(i32.ltz (local second))
				(then (return (call c_argument_error_at (local directive)))))
			(let third (struct.get (array.load (local nodes) (local second)) next_sibling))
			(if
				(:doc "Reject an extra operand after data, size, and count.")
				(bool.and (i32.not-ltz (local third))
					(i32.not-ltz (struct.get (array.load (local nodes) (local third)) next_sibling)))
				(then (return (call c_argument_error_at (local directive)))))
			(let view (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local data) (call c_bytes_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Preserve the byte view's lookup or type diagnostic.")
				(i32.ltz (struct.get (local view) position))
				(then (return (call c_argument_error (struct.get (local view) start) (struct.get (local view) end)))))
			(let-mut size -1i32)
			(let-mut count_node (local second))
			(if
				(:doc "A product checks its size operand before its count operand.")
				(i32.not-ltz (local third))
				(then
					(let found (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (array.load (local nodes) (local second)) (call c_value_mode) (borrow-shared (local contracts))))
					(if
						(:doc "Report an invalid size at its name or formal type.")
						(i32.ltz (struct.get (local found) position))
						(then (return (call c_argument_error (struct.get (local found) start) (struct.get (local found) end)))))
					(set (local size) (struct.get (local found) position))
					(set (local count_node) (local third))))
			(let count (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (array.load (local nodes) (local count_node)) (call c_value_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Report an invalid count at its name or formal type.")
				(i32.ltz (struct.get (local count) position))
				(then (return (call c_argument_error (struct.get (local count) start) (struct.get (local count) end)))))
			(return (call reserve_c_argument (borrow-mut (local contracts)) (local view)
				(call c_bytes_mode) (local size) (struct.get (local count) position)))))

	(fn read_c_array_extent
		(:doc `Bind a view to a literal element count or an integer formal.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(directive SourceNode) (begin i32) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let data (array.load (local nodes) (local begin)))
			(let count_node (struct.get (local data) next_sibling))
			(if
				(:doc "An array contract requires exactly one count.")
				(bool.or (i32.ltz (local count_node))
					(i32.lt -1i32 (struct.get (array.load (local nodes) (local count_node)) next_sibling)))
				(then (return (call c_argument_error_at (local directive)))))
			(let view (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local data) (call c_array_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Keep the defining span of an invalid array formal.")
				(i32.ltz (struct.get (local view) position))
				(then (return (call c_argument_error (struct.get (local view) start) (struct.get (local view) end)))))
			(let count (array.load (local nodes) (local count_node)))
			(let literal (call read_decimal_digits (borrow-shared (local source))
				(struct.get (local count) start) (struct.get (local count) end) 214748364u32 7u32))
			(if
				(:doc "A literal must fit the signed slice length domain.")
				(i32.lt -1i32 (struct.get (local literal) digits))
				(then (return (call reserve_c_argument (borrow-mut (local contracts)) (local view) (call c_array_mode)
					(i32.from-u32 (struct.get (local literal) magnitude)) -1i32))))
			(let formal (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local count) (call c_value_mode) (borrow-shared (local contracts))))
			(if
				(:doc "Report an invalid named count at the name or its declared type.")
				(i32.ltz (struct.get (local formal) position))
				(then (return (call c_argument_error (struct.get (local formal) start) (struct.get (local formal) end)))))
			(return (call reserve_c_argument (borrow-mut (local contracts)) (local view) (call c_array_mode)
				-1i32 (struct.get (local formal) position)))))

	(fn read_c_pointer_list
		(:doc `Bind string, null, and initialization contracts to named pointer formals.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(begin i32) (mode u8) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let-mut index (local begin))
			(let-mut count 0i32)
			(while
				(:doc "Each operand names one pointer formal.")
				(i32.not-ltz (local index))
				(body
					(let name (array.load (local nodes) (local index)))
					(let formal (call find_c_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (local name) (local mode) (borrow-shared (local contracts))))
					(if
						(:doc "Preserve the first invalid named formal at its own span.")
						(i32.ltz (struct.get (local formal) position))
						(then (return (call c_argument_error (struct.get (local formal) start) (struct.get (local formal) end)))))
					(let position (struct.get (local formal) position))
					(let slot (array.load (local contracts) (local position)))
					(let owner_mode (struct.get (local slot) owner_mode))
					(let-mut bound_mode (local mode))
					(if
						(:doc "Select pointer-out initialization for a mutable opaque handle.")
						(bool.and (call is_c_storage_init_mode (local mode)) (call is_c_handle_init_mode (local owner_mode)))
						(then (set (local bound_mode) (call c_handle_init_mode))))
					(if
						(:doc "Nullable annotations and initialization cannot name the same native owner.")
						(bool.and (call is_c_nullable_mode (local mode)) (bool.not (call is_c_value_mode (local owner_mode))))
						(then
							(if
								(:doc "An initializing loan always needs a caller-provided slot.")
								(call is_c_init_mode (struct.get (local slot) mode))
								(then (return (call c_argument_error_at (local name)))))
							(array.store (local contracts) (local position)
								(struct.new CArgument (mode (struct.get (local slot) mode))
									(size (struct.get (local slot) size)) (count (struct.get (local slot) count))
									(integer (struct.get (local slot) integer)) (scalar_ref (struct.get (local slot) scalar_ref))
									(owner_mode (local owner_mode)) (nullable (bool true))))))
					(if
						(:doc "Other nullable pointer shapes keep their existing lowering until their contracts are implemented.")
						(bool.or (bool.not (call is_c_nullable_mode (local mode))) (u32.eq (struct.get (local slot) scalar_ref) 2u32))
						(then
							(let bound (call reserve_c_argument (borrow-mut (local contracts)) (local formal) (local bound_mode) -1i32 -1i32))
							(if
								(:doc "Stop at a conflicting conversion.")
								(u32.gtz (struct.get (local bound) error))
								(then (return (local bound))))
							(set (local count) (i32.add (local count)
								(i32.add (struct.get (local bound) strings) (struct.get (local bound) nulls))))))
					(set (local index) (struct.get (local name) next_sibling))))
			(if
				(:doc "Count null-capable slots separately from converted strings.")
				(call accepts_c_null (local mode))
				(then (return (call checked_c_arguments 0i32 0i32 (local count) (bool false) 0i32))))
			(return (call checked_c_arguments (local count) 0i32 0i32 (bool false) 0i32))))

	(fn matches_pragma
		(:doc `Compare the entire spelling of a native pragma head or bare operand.`)
		(params (source (shared-array u8)) (node SourceNode) (spelling (shared-array u8)))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared (local source)) (struct.get (local node) start) (struct.get (local node) end)
				(borrow-shared (local spelling)) 0i32 (array.len (local spelling))))))

	(fn read_c_variadic
		(:doc `Use a named formal as the boundary, or mark the complete native list as fixed.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (operand i32))
		(returns CArguments)
		(body
			(if
				(:doc "A negative boundary records C ellipsis with no Wove tail arguments.")
				(i32.ltz (local operand))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) -1i32))))
			(let name (array.load (local nodes) (local operand)))
			(let extra (struct.get (local name) next_sibling))
			(if
				(:doc "The marker has space for one boundary operand.")
				(i32.lt -1i32 (local extra))
				(then (return (call c_argument_error_at (array.load (local nodes) (local extra))))))
			(if
				(:doc "An ellipsis keeps every declared native formal in the fixed prefix.")
				(call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local open_tail)))
				(then
					(if (i32.ltz (local first)) (then (return (call c_argument_error_at (local name)))))
					(return (call checked_c_arguments 0i32 0i32 0i32 (bool false) (local c_open_variadic_tail)))))
			(let formal (call find_named_c_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first) (local name)))
			(let row (struct.get (local formal) row))
			(if
				(:doc "C requires a known boundary after at least one native formal.")
				(bool.or (i32.ltz (local row)) (i32.eq (local row) (local first)))
				(then (return (call c_argument_error_at (local name)))))
			(return (call checked_c_arguments 0i32 0i32 0i32 (bool false) (local row)))))

	(fn read_c_directive
		(:doc `Dispatch the recognized argument directives in the checked pragma stream.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(node SourceNode) (null_pass bool) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (struct.get (local parts) head))
			(if
				(:doc "Select only directives with a checked form head.")
				(i32.ltz (local head))
				(then (return (call c_argument_error_at (local node)))))
			(let name (array.load (local nodes) (local head)))
			(let begin (struct.get (local parts) operands))
			(let null (call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local null_directive))))
			(if
				(:doc "Read null-only slots before the remaining directives, regardless of their source order.")
				(local null_pass)
				(then
					(if (bool.not (local null)) (then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
					(if (i32.ltz (local begin)) (then (return (call c_argument_error_at (local node)))))
					(return (call read_c_pointer_list (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (local begin) (call c_null_mode) (borrow-mut (local contracts))))))
			(if (local null) (then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A function-like macro marker takes no operands.")
				(call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local macro_directive)))
				(then
					(if
						(:doc "Point surplus operands to the malformed directive.")
						(i32.not-ltz (local begin))
						(then (return (call c_argument_error_at (local node)))))
					(return (call checked_c_arguments 0i32 0i32 0i32 (bool true) 0i32))))
			(if
				(:doc "A variadic boundary changes the C prototype and leaves tail values to C promotions.")
				(call matches_pragma (borrow-shared (local source)) (local name) (borrow-shared (local variadic_directive)))
				(then (return (call read_c_variadic (borrow-shared (local source)) (borrow-shared (local nodes)) (local first) (local begin)))))
			(let mode (call c_argument_directive (borrow-shared (local source)) (local name)))
			(if
				(:doc "Other directives leave these argument contracts untouched.")
				(call is_c_value_mode (local mode))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A native argument directive must name at least its data formal.")
				(i32.ltz (local begin))
				(then (return (call c_argument_error_at (local node)))))
			(if
				(:doc "A byte view with an extent uses the storage it already borrows.")
				(call is_c_bytes_mode (local mode))
				(then (return (call read_c_byte_extent (borrow-shared (local source)) (borrow-shared (local nodes))
					(local first) (local node) (local begin) (borrow-mut (local contracts))))))
			(if
				(:doc "A typed native view checks the count in elements.")
				(call is_c_array_mode (local mode))
				(then (return (call read_c_array_extent (borrow-shared (local source)) (borrow-shared (local nodes))
					(local first) (local node) (local begin) (borrow-mut (local contracts))))))
			(return (call read_c_pointer_list (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first) (local begin) (local mode) (borrow-mut (local contracts))))))

	(fn read_c_argument_pragmas
		(:doc `Apply one pass of native pragma contracts to the resolved formals.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts)
			(first i32) (null_pass bool) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let-mut entry (struct.get (local function) metadata))
			(let-mut strings 0i32)
			(let-mut extents 0i32)
			(let-mut nulls 0i32)
			(let-mut macro (bool false))
			(let-mut variadic 0i32)
			(while
				(:doc "Only the function's pragma metadata can declare an argument contract.")
				(i32.lt -1i32 (local entry))
				(body
					(let node (array.load (local nodes) (local entry)))
					(let head (array.load (local nodes) (struct.get (local node) first_child)))
					(if
						(:doc "Ignore metadata other than pragma entries.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
							(let-mut directive (struct.get (local parts) operands))
							(while
								(:doc "Apply directives in source order and retain the first failure.")
								(i32.not-ltz (local directive))
								(body
									(let item (array.load (local nodes) (local directive)))
									(let checked (call read_c_directive (borrow-shared (local source)) (borrow-shared (local nodes))
										(local first) (local item) (local null_pass) (borrow-mut (local contracts))))
									(if
										(:doc "Forward the original malformed contract span.")
										(u32.gtz (struct.get (local checked) error))
										(then (return (local checked))))
									(let tail (struct.get (local checked) variadic))
									(if
										(:doc "Diagnose a repeated macro marker or a macro after a variadic boundary.")
										(bool.and (struct.get (local checked) macro)
											(bool.or (local macro) (i32.gtz (local variadic))))
										(then (return (call c_argument_error_at (local item)))))
									(if
										(:doc "Repeated boundaries must agree, and a function-like macro has no C prototype.")
										(i32.gtz (local tail))
										(then
											(if
												(:doc "Point incompatible choices to the new directive.")
												(bool.or (local macro) (bool.and (i32.gtz (local variadic))
													(i32.not-eq (local tail) (local variadic))))
												(then (return (call c_argument_error_at (local item)))))
											(set (local variadic) (local tail))))
									(if
										(:doc "Keep a zero-operand marker unless a named or open tail supplies the boundary.")
										(bool.and (i32.ltz (local tail)) (i32.eqz (local variadic)))
										(then (set (local variadic) (local tail))))
									(set (local macro) (bool.or (local macro) (struct.get (local checked) macro)))
									(set (local strings) (i32.add (local strings) (struct.get (local checked) strings)))
									(set (local extents) (i32.add (local extents) (struct.get (local checked) extents)))
									(set (local nulls) (i32.add (local nulls) (struct.get (local checked) nulls)))
									(set (local directive) (struct.get (local item) next_sibling))))))
					(set (local entry) (call next_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local function) (local node)))))
			(return (call checked_c_arguments (local strings) (local extents) (local nulls) (local macro) (local variadic)))))

	(fn read_c_arguments
		(:doc `Read bridge metadata into one contract slot per checked formal.

		Mark integer slots before applying pragmas. Null-only slots suppress
		string preparation and every native view needs an explicit contract.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function FormParts)
			(first i32) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let nulls (call read_c_argument_pragmas (borrow-shared (local source)) (borrow-shared (local nodes))
				(local function) (local first) (bool true) (borrow-mut (local contracts))))
			(if (u32.gtz (struct.get (local nulls) error)) (then (return (local nulls))))
			(let arguments (call read_c_argument_pragmas (borrow-shared (local source)) (borrow-shared (local nodes))
				(local function) (local first) (bool false) (borrow-mut (local contracts))))
			(if (u32.gtz (struct.get (local arguments) error)) (then (return (local arguments))))
			(let-mut parameter (call next_c_value_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)))
			(let-mut index 0i32)
			(let-mut initializers 0i32)
			(let-mut handle_out (bool false))
			(let-mut vectors (bool false))
			(let-mut void_pointer (bool false))
			(while
				(:doc "Every slice formal must define its native ABI.")
				(i32.not-ltz (local parameter))
				(body
					(let node (array.load (local nodes) (local parameter)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let type (array.load (local nodes) (struct.get (local parts) operands)))
					(let slot (array.load (local contracts) (local index)))
					(let mode (struct.get (local slot) mode))
					(let vector (call is_c_vector_mode (local mode)))
					(let alias (u8.eq (local mode) (local c_void_pointer_mode)))
					(set (local vectors) (bool.or (local vectors) (local vector)))
					(set (local void_pointer) (bool.or (local void_pointer) (local alias)))
					(if
						(:doc "Scalar void pointers require an exact nonvariadic C function. Other adapted arguments keep their existing signature rules.")
						(bool.and (bool.or (local alias) (bool.or (local vector)
								(bool.or (call accepts_c_null (local mode)) (call is_c_init_mode (local mode)))))
							(bool.or (struct.get (local arguments) macro)
								(bool.or (i32.gtz (struct.get (local arguments) variadic))
									(bool.and (local alias) (i32.ltz (struct.get (local arguments) variadic))))))
						(then (return (call c_argument_error_at (local type)))))
					(if
						(:doc "A shared scalar formal requires an explicit native void pointer contract.")
						(bool.and (u32.eq (struct.get (local slot) scalar_ref) 1u32) (bool.not (local alias)))
						(then
							(let reference (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
							(return (call c_argument_error_at (array.load (local nodes) (struct.get (local reference) operands))))))
					(if
						(:doc "An unannotated view is unavailable in a native signature.")
						(bool.and (call is_c_value_mode (local mode))
							(u32.gtz (struct.get
								(call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)) access)))
						(then (return (call c_argument_error_at (local type)))))
					(if
						(:doc "Count each distinct owner initialization formal.")
						(call is_c_init_mode (local mode))
						(then (set (local initializers) (i32.inc (local initializers)))))
					(set (local handle_out) (bool.or (local handle_out) (call is_c_handle_init_mode (local mode))))
					(set (local parameter) (call next_c_value_formal (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local node) next_sibling)))
					(set (local index) (i32.inc (local index)))))
			(return (struct.new CArguments (strings (struct.get (local arguments) strings)) (vectors (local vectors))
				(extents (struct.get (local arguments) extents))
				(nulls (i32.add (struct.get (local nulls) nulls) (struct.get (local arguments) nulls)))
				(initializers (local initializers)) (handle_out (local handle_out)) (void_pointer (local void_pointer)) (macro (struct.get (local arguments) macro))
				(variadic (struct.get (local arguments) variadic)) (start 0i32) (end 0i32) (error 0u32))))))
