(module source_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read named native argument contracts from a bridge function's pragmas.

	Resolve directives against the checked formal parameters. Store one
	native argument contract per formal and retain the original span of a bad contract.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./types.wove" (only source_builtin_type reference_mode))
	(use wove-file "./owned.wove" (only is_byte_owner_descriptor))
	(use wove-file "./c_owners.wove" (only is_native_name))
	(use wove-file "./c_formals.wove" (only next_c_value_formal))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../c/arguments.wove"
		(only c_value_mode c_checked_string_mode c_raw_string_mode c_bytes_mode is_c_value_mode is_c_bytes_mode
			c_null_mode is_c_null_mode c_nullable_mode is_c_nullable_mode accepts_c_null is_c_string_mode c_vector_mode is_c_vector_mode c_array_mode is_c_array_mode is_c_extent_mode c_storage_init_mode is_c_storage_init_mode c_handle_init_mode is_c_handle_init_mode is_c_init_mode (value c_open_variadic_tail) (value c_void_pointer_mode) (value c_shared_handle_slot_mode) (value c_storage_init_always_mode) (value c_nullable_native_reference_mode)
			(value c_marked_handle_out_mode) (value c_owner_marker_flag_mode) (value c_nullable_string_mode) (value c_static_string_mode) (value c_sync_callback_mode) (value c_nullable_sync_callback_mode) is_c_sync_callback_mode))

	(struct CArgument (fields (mode u8) (size i32) (count i32) (integer bool) (scalar_ref u32) (nullable_reference bool) (owner_mode u8) (nullable bool)))
	(struct CArguments (fields (strings i32) (vectors bool) (extents i32) (nulls i32) (initializers i32) (handle_out bool) (void_pointer bool) (macro bool) (variadic i32) (start i32) (end i32) (error u32)))
	(struct CFormal (fields (row i32) (position i32) (type_node i32) (start i32) (end i32)))

	(struct CViewType (fields (access u32) (element i32)))

	(let array_directive "c_array")
	(let void_pointer_directive "c_void_ptr")
	(let vector_directive "c_cstrs")
	(let static_string_directive "c_static_cstr")
	(let callback_directive "c_callback_sync")
	(let callback_type_name "fn-type")
	(let null_directive "c_null")
	(let nullable_directive "c_nullable")
	(let init_directive "c_init")
	(let init_always_directive "c_init_always")
	(let owner_out_directive "c_owner_out")
	(let macro_directive "c_macro")
	(let variadic_directive "c_variadic")
	(let open_tail "...")

	(fn read_c_view_type
		(:doc "Retain access and element type for the requested ordinary or exact-length view shape.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (exact bool))
		(returns CViewType)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (struct.get parts head))
			(let element (struct.get parts operands))
			(if
				(:doc "A native view always names its element type.")
				(bool.or (i32.ltz head) (i32.ltz element))
				(then (return (struct.new CViewType (access 0u32) (element -1i32)))))
			(let mode (call source_builtin_type (borrow-shared source) (array.load nodes head)))
			(let size (struct.get (array.load nodes element) next_sibling))
			(let shape (bool.or
				(bool.and (bool.not exact) (i32.ltz size))
				(bool.and exact (bool.and (i32.not-ltz size)
					(i32.ltz (struct.get (array.load nodes size) next_sibling))))))
			(if
				(:doc "Keep mutability and the original element node for native type resolution.")
				(bool.and (bool.or (u32.eq mode 34u32) (u32.eq mode 38u32)) shape)
				(then (return (struct.new CViewType (access mode) (element element)))))
			(return (struct.new CViewType (access 0u32) (element -1i32)))))

	(fn c_byte_slice_type
		(:doc "Return the access mode of a byte view with the requested extent shape.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (exact bool))
		(returns u32)
		(body
			(let view (call read_c_view_type (borrow-shared source) (borrow-shared nodes) node exact))
			(let element (struct.get view element))
			(if
				(:doc "Byte contracts accept only the built-in u8 element.")
				(bool.and (i32.lt -1i32 element)
					(u32.eq (call source_builtin_type (borrow-shared source) (array.load nodes element)) 10u32))
				(then (return (struct.get view access))))
			(return 0u32)))

	(fn c_row_slice_type
		(:doc `Return the access mode of a view whose elements own bytes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns u32)
		(body
			(let view (call read_c_view_type (borrow-shared source) (borrow-shared nodes) node (bool false)))
			(let element (struct.get view element))
			(if
				(:doc "Only owned byte rows can be marshalled into a C string table.")
				(bool.and (i32.lt -1i32 element)
					(call is_byte_owner_descriptor (borrow-shared source) (borrow-shared nodes)
						(array.load nodes element)))
				(then (return (struct.get view access))))
			(return 0u32)))

	(fn is_c_callback_type
		(:doc "Recognize an inline callable shape for the later signature and native contract checks.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns bool)
		(body
			(let head (struct.get (call form_parts (borrow-shared source)
				(borrow-shared nodes) node) head))
			(return (bool.and (i32.not-ltz head)
				(call matches_pragma (borrow-shared source) (array.load nodes head)
					(borrow-shared callback_type_name))))))

	(fn c_argument_directive
		(:doc `Map a recognized pragma to its native argument mode. Other directives leave the ABI unchanged.`)
		(params (source (shared-array u8)) (head SourceNode))
		(returns u8)
		(body
			(let start (struct.get head start))
			(let width (i32.sub (struct.get head end) start))
			(if
				(:doc "Use detached vector storage for the complete c_cstrs spelling.")
				(call matches_pragma (borrow-shared source) head (borrow-shared vector_directive))
				(then (return (call c_vector_mode))))
			(if
				(:doc "A retained native string uses immutable NUL-terminated literal storage.")
				(call matches_pragma (borrow-shared source) head (borrow-shared static_string_directive))
				(then (return c_static_string_mode)))
			(if
				(:doc "A synchronous callback has an explicit call lifetime contract.")
				(call matches_pragma (borrow-shared source) head (borrow-shared callback_directive))
				(then (return c_sync_callback_mode)))
			(if
				(:doc "An array bound counts native elements.")
				(call matches_pragma (borrow-shared source) head (borrow-shared array_directive))
				(then (return (call c_array_mode))))
			(if
				(:doc "A typed scalar loan can use the native void pointer ABI.")
				(call matches_pragma (borrow-shared source) head (borrow-shared void_pointer_directive))
				(then (return c_void_pointer_mode)))
			(if
				(:doc "Allow explicit null where the nullable contract is implemented.")
				(call matches_pragma (borrow-shared source) head (borrow-shared nullable_directive))
				(then (return (call c_nullable_mode))))
			(if
				(:doc "Resolve initialization against the named owner formal.")
				(call matches_pragma (borrow-shared source) head (borrow-shared init_directive))
				(then (return (call c_storage_init_mode))))
			(if
				(:doc "Activate caller-owned storage after every return from this initializer.")
				(call matches_pragma (borrow-shared source) head (borrow-shared init_always_directive))
				(then (return c_storage_init_always_mode)))
			(if
				(:doc "Match the entire c_bytes directive spelling.")
				(bool.and (i32.eq width 7i32)
					(bool.and (call is_three_bytes (borrow-shared source) start 99u8 95u8 98u8)
						(bool.and (call is_three_bytes (borrow-shared source) (i32.add start 3i32)
							121u8 116u8 101u8)
							(call is_head_byte (borrow-shared source) start 6i32 115u8))))
				(then (return (call c_bytes_mode))))
			(if
				(:doc "The complete common spelling fits in either supported directive.")
				(bool.not (bool.and (bool.or (i32.eq width 6i32) (i32.eq width 10i32))
					(bool.and (call is_three_bytes (borrow-shared source) start 99u8 95u8 99u8)
						(call is_three_bytes (borrow-shared source) (i32.add start 3i32)
							115u8 116u8 114u8))))
				(then (return (call c_value_mode))))
			(if
				(:doc "The shorter spelling ends after c_cstr.")
				(i32.eq width 6i32)
				(then (return (call c_checked_string_mode))))
			(if
				(:doc "Raw conversion requires the complete _raw suffix.")
				(bool.and (call is_head_byte (borrow-shared source) start 6i32 95u8)
					(call is_three_bytes (borrow-shared source) (i32.add start 7i32)
						114u8 97u8 119u8))
				(then (return (call c_raw_string_mode))))
			(return (call c_value_mode))))

	(fn c_argument_error
		(:doc `Point an invalid native argument contract at its original source span.`)
		(params (start i32) (end i32))
		(returns CArguments)
		(body (return (struct.new CArguments (strings 0i32) (vectors (bool false)) (extents 0i32) (nulls 0i32) (initializers 0i32) (handle_out (bool false)) (void_pointer (bool false)) (macro (bool false)) (variadic 0i32)
			(start start) (end end) (error 23u32)))))

	(fn c_argument_error_at
		(:doc `Use the entire offending directive or operand span.`)
		(params (node SourceNode))
		(returns CArguments)
		(body (return (call c_argument_error (struct.get node start) (struct.get node end)))))

	(fn checked_c_arguments
		(:doc `Retain conversion counts, a macro marker, and the first variadic formal's source row.`)
		(params (strings i32) (extents i32) (nulls i32) (macro bool) (variadic i32))
		(returns CArguments)
		(body (return (struct.new CArguments (strings strings) (vectors (bool false)) (extents extents) (nulls nulls) (initializers 0i32) (handle_out (bool false)) (void_pointer (bool false)) (macro macro) (variadic variadic)
			(start 0i32) (end 0i32) (error 0u32)))))

	(fn c_formal
		(:doc `Keep an original formal position or the problem's source span.`)
		(params (row i32) (position i32) (type_node i32) (site SourceNode))
		(returns CFormal)
		(body (return (struct.new CFormal (row row) (position position) (type_node type_node)
			(start (struct.get site start)) (end (struct.get site end))))))

	(fn mark_c_argument_type
		(:doc `Record the native formal shape before applying argument contracts.`)
		(params (contracts (mut-array CArgument)) (index i32) (integer bool) (scalar_ref u32) (nullable_reference bool) (owner_mode u8))
		(returns void)
		(body
			(array.store contracts index
				(struct.new CArgument (mode (call c_value_mode)) (size 0i32) (count 0i32)
					(integer integer) (scalar_ref scalar_ref) (nullable_reference nullable_reference)
					(owner_mode owner_mode) (nullable (bool false))))))

	(fn accepts_c_formal
		(:doc `Check a resolved formal against the requested native argument role.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (type SourceNode) (mode u8) (formal CArgument))
		(returns bool)
		(body
			(if
				(:doc "A by-value extent operand must be an integer value.")
				(call is_c_value_mode mode)
				(then (return (bool.and (struct.get formal integer) (u32.eqz (struct.get formal scalar_ref))))))
			(if
				(:doc "A native void pointer borrows a scalar place, exact-length byte view, or shared handle slot.")
				(u8.eq mode c_void_pointer_mode)
				(then (return (bool.or (u32.gtz (struct.get formal scalar_ref))
					(bool.or (u8.eq (struct.get formal owner_mode) c_shared_handle_slot_mode)
						(u32.gtz (call c_byte_slice_type (borrow-shared source) (borrow-shared nodes)
							type (bool true))))))))
			(if
				(:doc "Only a written callback signature can use the synchronous callback contract.")
				(u8.eq mode c_sync_callback_mode)
				(then (return (call is_c_callback_type (borrow-shared source) (borrow-shared nodes) type))))
			(let rows (call c_row_slice_type (borrow-shared source) (borrow-shared nodes) type))
			(if
				(:doc "C string vectors borrow the rows through a shared projection.")
				(call is_c_vector_mode mode)
				(then (return (u32.eq rows 34u32))))
			(if
				(:doc "A native array exposes copyable elements through either view access mode.")
				(call is_c_array_mode mode)
				(then (return (bool.and (u32.eqz rows)
					(u32.gtz (struct.get
						(call read_c_view_type (borrow-shared source) (borrow-shared nodes) type (bool false)) access))))))
			(if
				(:doc "Initialization needs a mutable native owner and excludes nullable formals.")
				(call is_c_storage_init_mode mode)
				(then
					(let owner (struct.get formal owner_mode))
					(let storage_only (u8.eq mode c_storage_init_always_mode))
					(return (bool.and (bool.not (struct.get formal nullable))
						(bool.and (call is_c_init_mode owner)
							(bool.or (bool.not storage_only) (u8.eq owner (call c_storage_init_mode))))))))
			(if
				(:doc "Nullable annotations name a checked native pointer shape.")
				(call is_c_nullable_mode mode)
				(then
					(if
						(:doc "Shared built-in scalar loans do not opt into typed nullable native references.")
						(bool.and (u32.eq (struct.get formal scalar_ref) 1u32)
							(bool.not (struct.get formal nullable_reference)))
						(then (return (bool false))))
					(if
						(:doc "A callback with a separate synchronous pragma can have an absent receiver.")
						(call is_c_callback_type (borrow-shared source) (borrow-shared nodes) type)
						(then (return (bool true))))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) type))
					(return (bool.or
						(u32.gtz (call reference_mode (borrow-shared source) (borrow-shared nodes) (struct.get parts head)))
						(u32.gtz (struct.get (call read_c_view_type (borrow-shared source)
							(borrow-shared nodes) type (bool false)) access))))))
			(let view (call c_byte_slice_type (borrow-shared source) (borrow-shared nodes) type (bool false)))
			(return (bool.or (u32.eq view 34u32)
				(bool.and (bool.or (bool.or (call is_c_bytes_mode mode) (call is_c_string_mode mode))
					(bool.or (call is_c_null_mode mode) (call is_c_null_mode (struct.get formal mode))))
					(u32.eq view 38u32))))))

	(fn find_named_c_formal
		(:doc `Resolve a bare formal name to its ordinal and declared type node.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode))
		(returns CFormal)
		(body
			(if
				(:doc "Quoted strings and forms cannot name a formal parameter.")
				(u32.not-eq (struct.get name kind) 1u32)
				(then (return (call c_formal -1i32 -1i32 -1i32 name))))
			(let-mut parameter (call next_c_value_formal (borrow-shared source) (borrow-shared nodes) first))
			(let-mut index 0i32)
			(while
				(:doc "Search the checked parameter list in its original order.")
				(i32.not-ltz parameter)
				(body
					(let node (array.load nodes parameter))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let spelling (array.load nodes (struct.get parts head)))
					(if
						(:doc "Return the declared formal's ordinal and type at the original name span.")
						(call same_bytes (borrow-shared source)
							(struct.get spelling start) (struct.get spelling end)
							(borrow-shared source) (struct.get name start) (struct.get name end))
						(then (return (call c_formal parameter index (struct.get parts operands) name))))
					(set parameter (call next_c_value_formal (borrow-shared source) (borrow-shared nodes)
						(struct.get node next_sibling)))
					(set index (i32.inc index))))
			(return (call c_formal -1i32 -1i32 -1i32 name))))

	(fn find_c_formal
		(:doc `Check the named formal's type for the requested argument adaptation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode) (mode u8)
			(contracts (shared-array CArgument)))
		(returns CFormal)
		(body
			(let formal (call find_named_c_formal (borrow-shared source) (borrow-shared nodes) first name))
			(let type_node (struct.get formal type_node))
			(if
				(:doc "Only a resolved name carries a valid type node.")
				(i32.lt -1i32 type_node)
				(then
					(let type (array.load nodes type_node))
					(if
						(:doc "An incompatible formal points to its declared type.")
						(bool.not (call accepts_c_formal (borrow-shared source) (borrow-shared nodes) type mode
							(array.load contracts (struct.get formal position))))
						(then (return (call c_formal -1i32 -1i32 -1i32 type))))))
			(return formal)))

	(fn reserve_c_argument
		(:doc `Record one checked contract. Identical repeated directives keep the original contract.`)
		(params (contracts (mut-array CArgument)) (formal CFormal) (mode u8) (size i32) (count i32))
		(returns CArguments)
		(body
			(let index (struct.get formal position))
			(let prior (array.load contracts index))
			(let prior_mode (struct.get prior mode))
			(if
				(:doc "Null takes the C-string slot without constructing a copy or counting a descriptor.")
				(bool.and (call is_c_null_mode prior_mode) (call is_c_string_mode mode))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(if
				(:doc "Different modes or extent operands conflict at the later data name.")
				(bool.not (call is_c_value_mode prior_mode))
				(then
					(if
						(:doc "A repeated contract contributes no additional converted formal.")
						(bool.and (u8.eq prior_mode mode)
							(bool.and (i32.eq (struct.get prior size) size)
								(i32.eq (struct.get prior count) count)))
						(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
					(return (call c_argument_error (struct.get formal start) (struct.get formal end)))))
			(array.store contracts index
				(struct.new CArgument (mode mode) (size size) (count count)
					(integer (struct.get prior integer)) (scalar_ref (struct.get prior scalar_ref))
					(nullable_reference (struct.get prior nullable_reference))
					(owner_mode (struct.get prior owner_mode)) (nullable (struct.get prior nullable))))
			(if
				(:doc "Each bounded pointer contributes one extent check.")
				(call is_c_extent_mode mode)
				(then (return (call checked_c_arguments 0i32 1i32 0i32 (bool false) 0i32))))
			(if
				(:doc "A null-capable contract uses no string scratch slot.")
				(call accepts_c_null mode)
				(then (return (call checked_c_arguments 0i32 0i32 1i32 (bool false) 0i32))))
			(if
				(:doc "The final contract table records vectors, initializers, and void pointers.")
				(bool.or (bool.or (u8.eq mode c_void_pointer_mode) (u8.eq mode c_shared_handle_slot_mode))
					(bool.or (bool.or (call is_c_init_mode mode) (call is_c_vector_mode mode))
						(u8.eq mode c_owner_marker_flag_mode)))
				(then (return (call checked_c_arguments 0i32 0i32 0i32 (bool false) 0i32))))
			(return (call checked_c_arguments 1i32 0i32 0i32 (bool false) 0i32))))

	(fn read_c_byte_extent
		(:doc `Resolve c_bytes data count or c_bytes data size count in formal order.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(directive SourceNode) (begin i32) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let data (array.load nodes begin))
			(let second (struct.get data next_sibling))
			(if
				(:doc "The byte view requires a count operand.")
				(i32.ltz second)
				(then (return (call c_argument_error_at directive))))
			(let third (struct.get (array.load nodes second) next_sibling))
			(if
				(:doc "Reject an extra operand after data, size, and count.")
				(bool.and (i32.not-ltz third)
					(i32.not-ltz (struct.get (array.load nodes third) next_sibling)))
				(then (return (call c_argument_error_at directive))))
			(let view (call find_c_formal (borrow-shared source) (borrow-shared nodes)
				first data (call c_bytes_mode) (borrow-shared contracts)))
			(if
				(:doc "Preserve the byte view's lookup or type diagnostic.")
				(i32.ltz (struct.get view position))
				(then (return (call c_argument_error (struct.get view start) (struct.get view end)))))
			(let-mut size -1i32)
			(let-mut count_node second)
			(if
				(:doc "A product checks its size operand before its count operand.")
				(i32.not-ltz third)
				(then
					(let found (call find_c_formal (borrow-shared source) (borrow-shared nodes)
						first (array.load nodes second) (call c_value_mode) (borrow-shared contracts)))
					(if
						(:doc "Report an invalid size at its name or formal type.")
						(i32.ltz (struct.get found position))
						(then (return (call c_argument_error (struct.get found start) (struct.get found end)))))
					(set size (struct.get found position))
					(set count_node third)))
			(let count (call find_c_formal (borrow-shared source) (borrow-shared nodes)
				first (array.load nodes count_node) (call c_value_mode) (borrow-shared contracts)))
			(if
				(:doc "Report an invalid count at its name or formal type.")
				(i32.ltz (struct.get count position))
				(then (return (call c_argument_error (struct.get count start) (struct.get count end)))))
			(return (call reserve_c_argument (borrow-mut contracts) view
				(call c_bytes_mode) size (struct.get count position)))))

	(fn read_c_array_extent
		(:doc `Bind a view to a literal, a by-value integer formal, or a writable integer loan.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(directive SourceNode) (begin i32) (contracts (mut-array CArgument)))
		(returns CArguments)
		(body
			(let data (array.load nodes begin))
			(let count_node (struct.get data next_sibling))
			(if
				(:doc "An array contract requires exactly one count.")
				(bool.or (i32.ltz count_node)
					(i32.lt -1i32 (struct.get (array.load nodes count_node) next_sibling)))
				(then (return (call c_argument_error_at directive))))
			(let view (call find_c_formal (borrow-shared source) (borrow-shared nodes)
				first data (call c_array_mode) (borrow-shared contracts)))
			(if
				(:doc "Keep the defining span of an invalid array formal.")
				(i32.ltz (struct.get view position))
				(then (return (call c_argument_error (struct.get view start) (struct.get view end)))))
			(let count (array.load nodes count_node))
			(let literal (call read_decimal_digits (borrow-shared source)
				(struct.get count start) (struct.get count end) 214748364u32 7u32))
			(if
				(:doc "A literal must fit the signed slice length domain.")
				(i32.lt -1i32 (struct.get literal digits))
