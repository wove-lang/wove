			(if
				(:doc "Disk targets are keyed by the original use within the importing file.")
				(local disk)
				(then (return (call resolve_disk_edge (local file) (local edge) (borrow-shared (local edges))))))
			(return (call resolve_edge (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local source)) (local path) (local edge)))))

	(fn disk_request
