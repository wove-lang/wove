					(default_file (struct:get target default_file)) (default_node (struct:get target default_node))
					(native_file (struct:get target native_file))
					(optional (struct:get target optional)) (scalar_typedef (struct:get target scalar_typedef))
					(requested_start (struct:get selector original_start))
					(requested_end (struct:get selector original_end)) (value_macro (struct:get target value_macro)) (value_lossless (struct:get target value_lossless))
					(extent (struct:get target extent)) (integer_constant (bool false)) (constant_bits 0u32)
