						(namespace (local namespace)) (provider 8u32)
						(header_start (struct.get (local header) start)) (header_end (struct.get (local header) end))
						(native_start (i32.sub (struct.get (local member) native_start) (local base)))
						(native_end (i32.sub (struct.get (local member) native_end) (local base)))
						(signature_start (i32.sub (struct.get (local member) signature_start) (local base)))
						(signature_end (i32.sub (struct.get (local member) signature_end) (local base)))
						(native_type (local native_row))
