								(u32:eqz (struct:get (array:load modules identity) state))
								(then (return path)))))
					(set index (i32:inc index))))
			(return -1i32)))

	(fn measure_c_tree
		(:doc "Measure the selected provider's checked source view before reserving temporary nodes.")
		(params (arena (shared-array u8)) (input SuppliedFile)) (returns FormCheck)
		(body (return (call check_source_form
			(borrow-shared (array:range arena (struct:get input source_start) (struct:get input source_end)))))))

	(fn copy_c_tree
		(:doc "Build the validated original tree and copy it with graph arena spans.")
