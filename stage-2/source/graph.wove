						(native_start (i32:sub (struct:get member native_start) base))
						(native_end (i32:sub (struct:get member native_end) base))
						(signature_start (i32:sub (struct:get member signature_start) base))
						(signature_end (i32:sub (struct:get member signature_end) base))
						(native_type native_row)
						(drop_start (call c_file_offset (struct:get member drop_start) native_base))
						(drop_end (call c_file_offset (struct:get member drop_end) native_base))
						(type_start (i32:sub (struct:get member type_start) native_base))
						(type_end (i32:sub (struct:get member type_end) native_base))
						(name_node -1i32) (header_file (struct:get header file)) (bridge_node (struct:get header node))
						(default_file (struct:get header default_file)) (default_node (struct:get header default_node))
						(native_file native_file) (optional (struct:get member optional)) (scalar_typedef (struct:get member scalar_typedef))
						(requested_start -1i32) (requested_end -1i32) (value_macro (struct:get member value_macro)) (value_lossless (struct:get member value_lossless)) (extent -1i32) (integer_constant (bool false)) (constant_bits 0u32)
						(prerequisite_start prerequisite_start) (prerequisite_end offset)
						(wove_result_layout (struct:get member wove_result_layout))))
					(let published (call publish_binding (borrow-shared source) selector importer
						target (borrow-mut bindings) count))
					(if
						(:doc "An alias conflict or short destination belongs to the importing file.")
						(u32:gtz (struct:get published error))
						(then (return published)))
					(set count (struct:get published next))
					(set index (i32:inc index))))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn resolve_c_header_operation
		(:doc "Validate a declared project key or resolve a C header use before checking its members.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (source (shared-array u8)) (importer i32)
			(edge GraphUse) (selectors (shared-array GraphSelector)) (bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext))
		(returns GraphRead)
