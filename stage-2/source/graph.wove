			(return (call bind_c_header_scope (borrow-shared arena) (borrow-shared files) (borrow-shared source)
				importer header edge (borrow-shared selectors) (borrow-mut bindings)
				offset context (borrow-mut visiting) 0i32))))

	(fn pending_c_layout_provider
		(:doc "An owning bridge result brings its defining module into the ordinary graph privately.")
