	(fn write_c_dependency
		(:doc "Publish a private type link and an include span when C needs its header.")
		(params (files (shared-array SuppliedFile)) (trees (shared-array CScopeTree)) (use BridgeUse)
			(selector i32) (definition i32) (include bool) (bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(let owner (struct:get use owner))
			(let input (array:load files owner))
			(let source (struct:get input source_start))
