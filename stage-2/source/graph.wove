(module source_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve active Wove and C header imports from a supplied Stage 2 source graph.

	Walk Wove-file edges in depth-first order and visit each reached identity once.
	Keep declarations and local spellings as references into the original views.
	The caller supplies file ranges inside an immutable byte arena and separate
	writable storage for module rows, local bindings, edges, and selectors.`)

	(use wove-file "./scan.wove"
		(only check_source_form build_source_tree check_source_metadata
			(type SourceNode) (type Token) (type FormCheck)))
	(use wove-file "./module.wove" (only form_parts read_module_for_target (type SelectedDeclaration) (type FormParts)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./extent.wove" (only immutable_extent_value))
	(use wove-file "./paths.wove" (only resolve_path (type SuppliedFile)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier))
	(use wove-file "./imports.wove" (only import_keyword is_import_name read_import read_selector))
	(use wove-file "./types.wove" (only is_reserved_type_name))
	(use wove-file "./tree_copy.wove" (only copy_tree))
	(use wove-file "./c_scope.wove" (only connect_bridge_overlay))
	(use wove-file "./c_headers.wove" (only (type HeaderMatch) find_c_header find_header_kind find_c_declaration))
	(use wove-file "./c_dependencies.wove" (only connect_bridge_type))
	(use wove-file "./c_dependency_paths.wove" (only scoped_uses count_bridge_uses (type BridgeUse)))
	(use wove-file "./c_owners.wove" (only is_c_long_double))
	(use wove-file "./c_records.wove" (only is_c_record))

	(use wove-file "./target.wove" (only default_selection (type SelectionContext)))

	(struct GraphModule
		(fields (state u32) (path i32) (order i32) (parent i32) (next_use i32) (end_use i32) (active bool) (failed bool)))
	(struct GraphBinding
		(:doc "A published name with a file-local name node in the owner and a declaration in the defining file. Public C members record the binding range of their declared prerequisites. A private intrinsic type has no C header span.")
		(fields (owner i32) (start i32) (end i32) (file i32) (declaration i32) (namespace u32)
			(provider u32) (header_start i32) (header_end i32) (native_start i32) (native_end i32)
			(signature_start i32) (signature_end i32) (native_type i32) (drop_start i32) (drop_end i32)
			(type_start i32) (type_end i32) (name_node i32)
			(header_file i32) (bridge_node i32) (default_file i32) (default_node i32) (native_file i32)
			(optional bool) (scalar_typedef bool) (requested_start i32) (requested_end i32) (value_macro bool) (value_lossless bool) (extent i32)
			(integer_constant bool) (constant_bits u32) (prerequisite_start i32) (prerequisite_end i32) (wove_result_layout bool)))

	(fn copy_graph_bindings
		(:doc "Copy the initialized prefix into the exact binding view consumed by a checker.")
		(params (source (shared-array GraphBinding)) (bindings (mut-array GraphBinding)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The destination size is the published binding count.")
				(i32:lt index (array:len bindings))
				(body
					(array:store bindings index (array:load source index))
					(set index (i32:inc index))))))

	(fn binding_with_integer_constant
		(:doc "Attach one exact i32 result without changing the defining or imported binding identity.")
		(params (binding GraphBinding) (bits u32) (extent i32)) (returns GraphBinding)
		(body
			(return (struct:new GraphBinding
				(owner (struct:get binding owner)) (start (struct:get binding start)) (end (struct:get binding end))
				(file (struct:get binding file)) (declaration (struct:get binding declaration)) (namespace (struct:get binding namespace))
				(provider (struct:get binding provider)) (header_start (struct:get binding header_start)) (header_end (struct:get binding header_end))
				(native_start (struct:get binding native_start)) (native_end (struct:get binding native_end)) (signature_start (struct:get binding signature_start))
				(signature_end (struct:get binding signature_end)) (native_type (struct:get binding native_type)) (drop_start (struct:get binding drop_start))
				(drop_end (struct:get binding drop_end)) (type_start (struct:get binding type_start)) (type_end (struct:get binding type_end))
				(name_node (struct:get binding name_node)) (header_file (struct:get binding header_file)) (bridge_node (struct:get binding bridge_node))
				(default_file (struct:get binding default_file)) (default_node (struct:get binding default_node)) (native_file (struct:get binding native_file))
				(optional (struct:get binding optional)) (scalar_typedef (struct:get binding scalar_typedef))
				(requested_start (struct:get binding requested_start)) (requested_end (struct:get binding requested_end))
				(value_macro (struct:get binding value_macro)) (value_lossless (struct:get binding value_lossless))
				(extent extent) (integer_constant (bool true)) (constant_bits bits)
				(prerequisite_start (struct:get binding prerequisite_start))
				(prerequisite_end (struct:get binding prerequisite_end))
				(wove_result_layout (struct:get binding wove_result_layout))))))

	(let c_dependency_provider 10u32)

	(fn references_c_header
		(:doc "A public C selection or private dependency can require its provider's Wove declarations.")
		(params (binding GraphBinding)) (returns bool)
		(body (return (bool:or (u32:eq (struct:get binding provider) 8u32)
			(u32:eq (struct:get binding provider) c_dependency_provider)))))

	(fn includes_c_header
		(:doc "A private intrinsic type keeps its provider identity without an include span.")
		(params (binding GraphBinding)) (returns bool)
		(body (return (bool:and (call references_c_header binding)
			(i32:not-ltz (struct:get binding header_start))))))

	(struct CScopeTree (fields (base i32) (rows i32)))
	(struct CScopeVisit (fields (file i32) (node i32)))

	(struct GraphUse
		(fields (start i32) (end i32) (path_start i32) (path_end i32) (first i32) (limit i32) (error u32) (provider u32)))
	(struct GraphSelector
		(fields (original_start i32) (original_end i32) (local_start i32) (local_end i32) (local_bare bool) (error u32) (namespace u32) (local_node i32)))
	(struct GraphResult
		(fields (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32) (mode u32) (os u8) (arch u8) (deployment i32)
			(path_start i32) (path_end i32)))
	(struct DiskEdge
		(:doc "A disk edge caches either its provider identity or an original host read diagnostic.") (fields (file i32) (start i32) (target i32) (path_start i32) (path_end i32) (error_start i32) (error_end i32) (error u32)))
	(struct GraphProgress
		(:doc "A suspended walk over committed table prefixes and its current depth-first frame.")
		(fields (files i32) (binding bool) (current i32) (pending_path i32) (pending_parent i32)
			(modules i32) (bindings i32) (uses i32) (selectors i32)))
	(struct FileRead
		(fields (bindings i32) (uses i32) (selectors i32) (active bool) (start i32) (end i32) (error u32)))
	(struct GraphRead (fields (next i32) (start i32) (end i32) (error u32) (file i32)))

	(fn file_read
		(:doc `Package a file read with its absolute table cursors and view-relative diagnostic.`)
		(params (bindings i32) (uses i32) (selectors i32) (active bool) (start i32) (end i32) (error u32))
		(returns FileRead)
		(body
			(return (struct:new FileRead (bindings bindings) (uses uses)
				(selectors selectors) (active active)
				(start start) (end end) (error error)))))

	(fn graph_read
		(:doc `Return the next cursor or path row with its originating source span on failure.`)
		(params (next i32) (start i32) (end i32) (error u32))
		(returns GraphRead)
		(body
			(return (struct:new GraphRead (next next) (start start)
				(end end) (error error) (file -1i32)))))

	(fn graph_result
		(:doc `Return graph counts and a diagnostic in the named file's original source view.`)
		(params (context SelectionContext) (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphResult)
		(body
			(return (struct:new GraphResult (modules modules) (bindings bindings)
				(file file) (start start) (end end) (error error) (mode (struct:get context mode))
				(os (struct:get context os)) (arch (struct:get context arch))
				(deployment (struct:get context deployment)) (path_start -1i32) (path_end -1i32)))))

	(fn graph_selection
		(:doc `Recover the exact selection context retained by the resolver for its consumers.`)
		(params (graph GraphResult))
		(returns SelectionContext)
		(body (return (struct:new SelectionContext (mode (struct:get graph mode))
			(os (struct:get graph os)) (arch (struct:get graph arch))
			(deployment (struct:get graph deployment))))))

	(fn find_binding
		(:doc `Locate a name within one file's namespace, optionally including its imports.

		The spelling may come from another file. The base is the owner's byte
		offset when names refer to the complete arena. Definition lookup for an import
		skips bindings that point to a different file, so imports do not re-export.`)
		(params (names (shared-array u8)) (spelling (shared-array u8)) (start i32) (end i32)
			(bindings (shared-array GraphBinding)) (count i32) (owner i32) (locals_only bool) (base i32) (namespace u32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Search the published binding prefix for this file and spelling.")
				(i32:lt index count)
				(body
					(let item (array:load bindings index))
					(if
						(:doc "Only compare a candidate from the requested namespace.")
						(bool:and
							(bool:and (i32:eq (struct:get item owner) owner)
								(u32:eq (struct:get item namespace) namespace))
							(bool:and
								(bool:or (bool:not locals_only)
									(bool:and (u32:eq (struct:get item provider) 3u32)
										(i32:eq (struct:get item file) owner)))
								(call same_bytes (borrow-shared names)
									(i32:add base (struct:get item start))
									(i32:add base (struct:get item end)) (borrow-shared spelling) start end)))
						(then (return index)))
					(set index (i32:inc index))))
			(return -1i32)))

	(fn collect_definition
		(:doc `Record a local definition before imports can add aliases to its namespace.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(name i32) (declaration i32) (file i32) (namespace u32) (extent i32)
			(bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(if
				(:doc "Each definition needs a name.")
				(i32:ltz name)
				(then (return (call graph_read count (struct:get node start) (struct:get node end) 26u32))))
			(let name_node (array:load nodes name))
			(let start (struct:get name_node start))
			(let end (struct:get name_node end))
			(if
				(:doc "An invalid name keeps the name node's original span.")
				(bool:not (call is_import_name (borrow-shared source) name_node))
				(then (return (call graph_read count start end 26u32))))
			(let existing (call find_binding (borrow-shared source) (borrow-shared source)
				start end (borrow-shared bindings) count file (bool false) 0i32 namespace))
			(if
				(:doc "Definitions reserve their name regardless of where the use appears.")
				(i32:not-ltz existing)
				(then (return (call graph_read count start end 30u32))))
			(if
				(:doc "Capacity is checked before publishing another row.")
				(i32:not-lt count (array:len bindings))
				(then (return (call graph_read count start end 16u32))))
			(array:store bindings count
				(struct:new GraphBinding (owner file) (start start) (end end)
					(file file) (declaration declaration) (namespace namespace) (provider 3u32)
					(header_start -1i32) (header_end -1i32) (native_start -1i32) (native_end -1i32)
					(signature_start -1i32) (signature_end -1i32)
					(native_type 0i32) (drop_start 0i32) (drop_end 0i32)
					(type_start 0i32) (type_end 0i32) (name_node name)
					(header_file -1i32) (bridge_node -1i32) (default_file -1i32) (default_node -1i32) (native_file -1i32)
					(optional (bool false)) (scalar_typedef (bool false)) (requested_start -1i32) (requested_end -1i32) (value_macro (bool false)) (value_lossless (bool false)) (extent extent) (integer_constant (bool false)) (constant_bits 0u32)
					(prerequisite_start 0i32) (prerequisite_end 0i32) (wove_result_layout (bool false))))
			(return (call graph_read (i32:inc count) 0i32 0i32 0u32))))

	(fn collect_wove_definition
		(:doc "Publish a selected function, type, or value in its module namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(parts FormParts) (tag u32) (declaration i32) (file i32) (bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(let-mut namespace 0u32)
			(let name (struct:get parts name))
			(if
				(:doc "Nominal types and aliases own a separate declaration namespace.")
				(call is_wove_type_definition tag)
				(then (set namespace 1u32)))
			(let-mut extent -1i32)
			(if
				(:doc "Read a module value's initializer from the first ordinary operand after metadata.")
				(u32:eq tag 12u32)
				(then
					(set namespace 2u32)
					(set extent (call immutable_extent_value (borrow-shared source)
						(borrow-shared nodes) (struct:get parts operands)))))
			(return (call collect_definition (borrow-shared source) (borrow-shared nodes)
				node name declaration file namespace extent
				(borrow-mut bindings) count))))

	(fn is_wove_type_definition
		(:doc "Recognize nominal types and aliases when a tag occurs at declaration scope.")
		(params (tag u32)) (returns bool)
		(body (return (bool:or (u32:eq tag 6u32) (u32:eq tag 7u32)))))

	(fn is_wove_definition
		(:doc "Recognize the selected root declarations that reserve names.")
		(params (tag u32)) (returns bool)
		(body (return (bool:or (u32:eq tag 1u32)
			(bool:or (call is_wove_type_definition tag) (u32:eq tag 12u32))))))

	(fn collect_standalone_bindings
		(:doc "Publish the selected definitions for a single-module consumer that has no graph import pass.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (selected (shared-array SelectedDeclaration))
			(length i32) (file i32) (bindings (mut-array GraphBinding))) (returns GraphRead)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "The selected rows exclude disabled and inactive declarations.")
				(i32:lt index length)
				(body
					(let declaration (struct:get (array:load selected index) node))
					(let node (array:load nodes declaration))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let tag (call import_keyword (borrow-shared source) (array:load nodes (struct:get parts head))))
					(if
						(:doc "Single-module compilation resolves the same definition keys as a graph.")
						(call is_wove_definition tag)
						(then
							(let result (call collect_wove_definition (borrow-shared source) (borrow-shared nodes)
								node parts tag declaration file (borrow-mut bindings) count))
							(if (u32:gtz (struct:get result error)) (then (return result)))
							(set count (struct:get result next))))
					(set index (i32:inc index))))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn collect_selectors
		(:doc `Cache selector spans and local name nodes before releasing the importer's source tree.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(first i32) (selectors (mut-array GraphSelector)) (offset i32))
		(returns GraphRead)
		(body
			(let-mut index first)
			(let-mut count offset)
			(while
				(:doc "Each selector occupies one row in the owning edge's contiguous interval.")
				(i32:not-ltz index)
				(body
					(let item (array:load nodes index))
					(if
						(:doc "A short selector table stops before writing beyond the view.")
						(i32:not-lt count (array:len selectors))
						(then (return (call graph_read count
							(struct:get item start) (struct:get item end) 16u32))))
					(let selector (call read_selector (borrow-shared source) (borrow-shared nodes) index))
					(let error (struct:get selector error))
					(if
						(:doc "Replay a malformed selector only after its edge and preceding selections succeed.")
						(u32:gtz error)
						(then
							(array:store selectors count
								(struct:new GraphSelector
									(original_start (struct:get selector start)) (original_end (struct:get selector end))
									(local_start -1i32) (local_end -1i32) (local_bare (bool false)) (error error)
									(namespace (struct:get selector namespace)) (local_node -1i32)))
							(return (call graph_read (i32:inc count) 0i32 0i32 0u32))))
					(let original (array:load nodes (struct:get selector first)))
					(let name (array:load nodes (struct:get selector second)))
					(array:store selectors count
						(struct:new GraphSelector
							(original_start (struct:get original start)) (original_end (struct:get original end))
							(local_start (struct:get name start)) (local_end (struct:get name end))
							(local_bare (u32:eq (struct:get name kind) 1u32)) (error 0u32)
							(namespace (struct:get selector namespace)) (local_node (struct:get selector second))))
					(set count (i32:inc count))
					(set index (struct:get item next_sibling))))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn collect_use
		(:doc `Cache an edge and its selectors without resolving the provider yet.

		Store grammar errors as rows so depth-first traversal reports errors in
		edge order. Capacity failures are reported before writing any short view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (operands i32)
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)) (index i32) (offset i32))
		(returns GraphRead)
		(body
			(if
				(:doc "Reserve the edge row before collecting its selectors.")
				(i32:not-lt index (array:len uses))
				(then (return (call graph_read offset
					(struct:get node start) (struct:get node end) 16u32))))
			(let use (call read_import (borrow-shared source) (borrow-shared nodes) node operands))
			(let start (struct:get use start))
			(let end (struct:get use end))
			(let error (struct:get use error))
			(if
				(:doc "A malformed use takes its place in edge order with its own diagnostic span.")
				(u32:gtz error)
				(then
					(array:store uses index
						(struct:new GraphUse (start start) (end end) (path_start -1i32) (path_end -1i32)
							(first offset) (limit offset) (error error) (provider 0u32)))
					(return (call graph_read offset 0i32 0i32 0u32))))
			(let selected (call collect_selectors (borrow-shared source) (borrow-shared nodes)
				(struct:get use second) (borrow-mut selectors) offset))
			(if
				(:doc "Leave the edge unpublished when the selector table is short.")
				(u32:gtz (struct:get selected error))
				(then (return selected)))
			(let path (array:load nodes (struct:get use first)))
			(array:store uses index
				(struct:new GraphUse (start start) (end end)
					(path_start (struct:get path start)) (path_end (struct:get path end))
					(first offset) (limit (struct:get selected next)) (error 0u32) (provider (struct:get use provider))))
			(return selected)))

	(fn collect_module
		(:doc `Summarize one selected declaration list in the graph tables.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (length i32) (file i32) (check_headers bool)
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(binding_offset i32) (use_offset i32) (selector_offset i32))
		(returns FileRead)
		(body
			(let-mut binding_count binding_offset)
			(let-mut use_count use_offset)
			(let-mut selector_count selector_offset)
			(let-mut index 0i32)
			(while
				(:doc "Collect active edges and local definitions before resolving imported names.")
				(i32:lt index length)
				(body
					(let declaration (struct:get (array:load declarations index) node))
					(let node (array:load nodes declaration))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let tag (call import_keyword (borrow-shared source)
						(array:load nodes (struct:get parts head))))
					(if
						(:doc "The local definition is visible to conflict checks on every edge.")
						(call is_wove_definition tag)
						(then
							(let result (call collect_wove_definition (borrow-shared source) (borrow-shared nodes)
								node parts tag declaration file
								(borrow-mut bindings) binding_count))
							(let error (struct:get result error))
							(if
								(:doc "Retain the original definition diagnostic.")
								(u32:gtz error)
								(then (return (call file_read binding_count use_count selector_count
									(bool true) (struct:get result start) (struct:get result end) error))))
							(set binding_count (struct:get result next))))
					(if
						(:doc "Keep the provider, key span, and selector interval for an active use.")
						(u32:eq tag 2u32)
						(then
							(let use (call collect_use (borrow-shared source) (borrow-shared nodes)
								node (struct:get parts operands)
								(borrow-mut uses) (borrow-mut selectors) use_count selector_count))
							(let error (struct:get use error))
							(if
								(:doc "A short scratch table stops the file read with its original span.")
								(u32:gtz error)
								(then (return (call file_read binding_count use_count selector_count
									(bool true) (struct:get use start) (struct:get use end) error))))
							(set selector_count (struct:get use next))
							(set use_count (i32:inc use_count))))
					(let header (struct:get parts header))
					(if
						(:doc "Queue active project keys for validation even if they have no import.")
						(bool:and check_headers (i32:lt -1i32 header))
						(then
							(let literal (array:load nodes header))
							(let start (struct:get literal start))
							(let end (struct:get literal end))
							(if
								(:doc "Leave the operation table intact if it has no room for this key.")
								(i32:not-lt use_count (array:len uses))
								(then (return (call file_read binding_count use_count selector_count
									(bool true) start end 16u32))))
							(array:store uses use_count
								(struct:new GraphUse (start start) (end end)
									(path_start start) (path_end end) (first 0i32) (limit 0i32)
									(error 0u32) (provider 9u32)))
							(set use_count (i32:inc use_count))))
					(set index (i32:inc index))))
			(return (call file_read binding_count use_count selector_count
				(bool true) 0i32 0i32 0u32))))

	(fn read_graph_file
		(:doc `Read a reached source in the graph mode and release its tree after collecting active references.`)
		(params (source (shared-array u8)) (file i32) (context SelectionContext) (check_headers bool)
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(binding_offset i32) (use_offset i32) (selector_offset i32))
		(returns FileRead)
		(body
			(let checked (call check_source_form (borrow-shared source)))
			(let parse_error (struct:get checked error))
			(if
				(:doc "No allocation is needed when admission or structure fails.")
				(u32:gtz parse_error)
				(then (return (call file_read binding_offset use_offset selector_offset
					(bool false) (struct:get checked start) (struct:get checked end) parse_error))))
			(let rows (i32:from-u32 (struct:get checked rows)))
			(let-mut nodes (array:alloc SourceNode rows))
			(let built (call build_source_tree (borrow-shared source) checked (borrow-mut nodes)))
			(let validated (call check_source_metadata (borrow-shared source) built (borrow-shared nodes)))
			(let-mut declarations (array:alloc SelectedDeclaration rows))
			(let module (call read_module_for_target (borrow-shared source) (borrow-shared nodes)
				validated context (borrow-mut declarations)))
			(let error (struct:get module error))
			(if
				(:doc "A failed or excluded module contributes no active definitions or uses.")
				(bool:or (u32:gtz error) (bool:not (struct:get module active)))
				(then (return (call file_read binding_offset use_offset selector_offset
					(bool false) (struct:get module start) (struct:get module end) error))))
			(return (call collect_module (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) (struct:get module count) file check_headers
				(borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)
				binding_offset use_offset selector_offset))))

	(fn resolve_edge
		(:doc `Decode the checked use path and resolve it from the importer's reached path.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(source (shared-array u8)) (path i32) (edge GraphUse))
		(returns GraphRead)
		(body
			(let edge_error (struct:get edge error))
			(if
				(:doc "Return a cached use error at the edge's turn in traversal.")
				(u32:gtz edge_error)
				(then (return (call graph_read -1i32 (struct:get edge start)
					(struct:get edge end) edge_error))))
			(let start (struct:get edge path_start))
			(let end (struct:get edge path_end))
			(let token (struct:new Token (kind 2u32) (start start) (end end) (error 0u32)))
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
