(module source_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve active Wove and C header imports from a supplied Stage 2 source graph.

	Walk Wove-file edges in depth-first order and visit each reached identity once.
	Keep declarations and local spellings as references into the original views.
	The caller supplies file ranges inside an immutable byte arena and separate
	writable storage for module rows, local bindings, edges, and selectors.`)

	(use wove-file "./scan.wove"
		(only check_source_form build_source_tree check_source_metadata is_identifier_head
			(type SourceNode) (type Token) (type FormCheck)))
	(use wove-file "./module.wove" (only form_parts read_module_for_target (type SelectedDeclaration) (type FormParts)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./extent.wove" (only immutable_extent_value))
	(use wove-file "./paths.wove" (only resolve_path (type SuppliedFile)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./imports.wove" (only import_keyword is_import_name read_import read_selector))
	(use wove-file "./types.wove" (only is_reserved_type_name))
	(use wove-file "./tree_copy.wove" (only copy_tree))
	(use wove-file "./c_scope.wove" (only connect_bridge_overlay))
	(use wove-file "./c_headers.wove" (only (type HeaderMatch) find_c_header find_header_kind find_c_declaration))

	(use wove-file "./target.wove" (only default_selection (type SelectionContext)))

	(struct GraphModule
		(fields (state u32) (path i32) (order i32) (parent i32) (next_use i32) (end_use i32) (active bool) (failed bool)))
	(struct
		(:doc "A published name with a file-local name node in the owner and a declaration in the defining file.")
		GraphBinding
		(fields (owner i32) (start i32) (end i32) (file i32) (declaration i32) (namespace u32)
			(provider u32) (header_start i32) (header_end i32) (native_start i32) (native_end i32)
			(signature_start i32) (signature_end i32) (native_type i32) (drop_start i32) (drop_end i32)
			(type_start i32) (type_end i32) (name_node i32)
			(header_file i32) (bridge_node i32) (default_file i32) (default_node i32) (native_file i32)
			(optional bool) (requested_start i32) (requested_end i32) (value_macro bool) (extent i32)))
	(struct GraphUse
		(fields (start i32) (end i32) (path_start i32) (path_end i32) (first i32) (limit i32) (error u32) (provider u32)))
	(struct GraphSelector
		(fields (original_start i32) (original_end i32) (local_start i32) (local_end i32) (local_bare bool) (error u32) (namespace u32) (local_node i32)))
	(struct GraphResult
		(fields (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32) (mode u32) (os u8) (arch u8) (deployment i32)
			(path_start i32) (path_end i32)))
	(struct
		(:doc "A disk edge caches either its provider identity or an original host read diagnostic.")
		DiskEdge (fields (file i32) (start i32) (target i32) (path_start i32) (path_end i32) (error_start i32) (error_end i32) (error u32)))
	(struct
		(:doc "A suspended walk over committed table prefixes and its current depth-first frame.")
		GraphProgress
		(fields (files i32) (binding bool) (current i32) (pending_path i32) (pending_parent i32)
			(modules i32) (bindings i32) (uses i32) (selectors i32)))
	(struct FileRead
		(fields (bindings i32) (uses i32) (selectors i32) (active bool) (start i32) (end i32) (error u32)))
	(struct GraphRead (fields (next i32) (start i32) (end i32) (error u32) (file i32)))

	(fn file_read
		(:doc `Package a file read with its absolute table cursors and view-relative diagnostic.`)
		(params (bindings i32) (uses i32) (selectors i32) (active bool) (start i32) (end i32) (error u32))
		(returns FileRead)
		(body
			(return (struct.new FileRead (bindings (local bindings)) (uses (local uses))
				(selectors (local selectors)) (active (local active))
				(start (local start)) (end (local end)) (error (local error))))))

	(fn graph_read
		(:doc `Return the next cursor or path row with its originating source span on failure.`)
		(params (next i32) (start i32) (end i32) (error u32))
		(returns GraphRead)
		(body
			(return (struct.new GraphRead (next (local next)) (start (local start))
				(end (local end)) (error (local error)) (file -1i32)))))

	(fn graph_result
		(:doc `Return graph counts and a diagnostic in the named file's original source view.`)
		(params (context SelectionContext) (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphResult)
		(body
			(return (struct.new GraphResult (modules (local modules)) (bindings (local bindings))
				(file (local file)) (start (local start)) (end (local end)) (error (local error)) (mode (struct.get (local context) mode))
				(os (struct.get (local context) os)) (arch (struct.get (local context) arch))
				(deployment (struct.get (local context) deployment)) (path_start -1i32) (path_end -1i32)))))

	(fn graph_selection
		(:doc `Recover the exact selection context retained by the resolver for its consumers.`)
		(params (graph GraphResult))
		(returns SelectionContext)
		(body (return (struct.new SelectionContext (mode (struct.get (local graph) mode))
			(os (struct.get (local graph) os)) (arch (struct.get (local graph) arch))
			(deployment (struct.get (local graph) deployment))))))

	(fn find_binding
		(:doc `Locate a name within one file's namespace, optionally including its imports.

		The spelling may come from another file. The base is the owner's byte
		offset when names refer to the complete arena. Definition lookup for an import
		skips bindings that point to a different file, so imports do not re-export.`)
		(params (names (shared-array u8)) (spelling (shared-array u8)) (start i32) (end i32)
			(bindings (shared-array GraphBinding)) (count i32) (owner i32) (locals_only bool) (base i32) (namespace u32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Search the published binding prefix for this file and spelling.")
				(i32.lt (local index) (local count))
				(body
					(let item (array.load (local bindings) (local index)))
					(if
						(:doc "Only compare a candidate from the requested namespace.")
						(bool.and
							(bool.and (i32.eq (struct.get (local item) owner) (local owner))
								(u32.eq (struct.get (local item) namespace) (local namespace)))
							(bool.and
								(bool.or (bool.not (local locals_only))
									(bool.and (u32.eq (struct.get (local item) provider) 3u32)
										(i32.eq (struct.get (local item) file) (local owner))))
								(call same_bytes (borrow-shared (local names))
									(i32.add (local base) (struct.get (local item) start))
									(i32.add (local base) (struct.get (local item) end)) (borrow-shared (local spelling)) (local start) (local end))))
						(then (return (local index))))
					(set (local index) (i32.inc (local index)))))
			(return -1i32)))

	(fn collect_definition
		(:doc `Record a local definition before imports can add aliases to its namespace.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(name i32) (declaration i32) (file i32) (namespace u32) (extent i32)
			(bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(if
				(:doc "Each definition needs a name.")
				(i32.ltz (local name))
				(then (return (call graph_read (local count) (struct.get (local node) start) (struct.get (local node) end) 26u32))))
			(let name_node (array.load (local nodes) (local name)))
			(let start (struct.get (local name_node) start))
			(let end (struct.get (local name_node) end))
			(if
				(:doc "An invalid name keeps the name node's original span.")
				(bool.not (call is_import_name (borrow-shared (local source)) (local name_node)))
				(then (return (call graph_read (local count) (local start) (local end) 26u32))))
			(let existing (call find_binding (borrow-shared (local source)) (borrow-shared (local source))
				(local start) (local end) (borrow-shared (local bindings)) (local count) (local file) (bool false) 0i32 (local namespace)))
			(if
				(:doc "Definitions reserve their name regardless of where the use appears.")
				(i32.not-ltz (local existing))
				(then (return (call graph_read (local count) (local start) (local end) 30u32))))
			(if
				(:doc "Capacity is checked before publishing another row.")
				(i32.not-lt (local count) (array.len (local bindings)))
				(then (return (call graph_read (local count) (local start) (local end) 16u32))))
			(array.store (local bindings) (local count)
				(struct.new GraphBinding (owner (local file)) (start (local start)) (end (local end))
					(file (local file)) (declaration (local declaration)) (namespace (local namespace)) (provider 3u32)
					(header_start -1i32) (header_end -1i32) (native_start -1i32) (native_end -1i32)
					(signature_start -1i32) (signature_end -1i32)
					(native_type 0i32) (drop_start 0i32) (drop_end 0i32)
					(type_start 0i32) (type_end 0i32) (name_node (local name))
					(header_file -1i32) (bridge_node -1i32) (default_file -1i32) (default_node -1i32) (native_file -1i32)
					(optional (bool false)) (requested_start -1i32) (requested_end -1i32) (value_macro (bool false)) (extent (local extent))))
			(return (call graph_read (i32.inc (local count)) 0i32 0i32 0u32))))

	(fn collect_wove_definition
		(:doc "Publish a selected function, type, or value in its module namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(parts FormParts) (tag u32) (declaration i32) (file i32) (bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(let-mut namespace 0u32)
			(let-mut name (struct.get (local parts) name))
			(if
				(:doc "Types define their spelling in the first operand and own a separate namespace.")
				(u32.eq (local tag) 7u32)
				(then
					(set (local namespace) 1u32)
					(set (local name) (struct.get (local parts) operands))))
			(let-mut extent -1i32)
			(if
				(:doc "Read a module value's initializer from the first ordinary operand after metadata.")
				(u32.eq (local tag) 12u32)
				(then
					(set (local namespace) 2u32)
					(set (local extent) (call immutable_extent_value (borrow-shared (local source))
						(borrow-shared (local nodes)) (struct.get (local parts) operands)))))
			(return (call collect_definition (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local name) (local declaration) (local file) (local namespace) (local extent)
				(borrow-mut (local bindings)) (local count)))))

	(fn is_wove_definition
		(:doc "Recognize the selected root declarations that reserve names.")
		(params (tag u32)) (returns bool)
		(body (return (bool.or (u32.eq (local tag) 1u32)
			(bool.or (u32.eq (local tag) 7u32) (u32.eq (local tag) 12u32))))))

	(fn collect_standalone_bindings
		(:doc "Publish the selected definitions for a single-module consumer that has no graph import pass.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (selected (shared-array SelectedDeclaration))
			(length i32) (file i32) (bindings (mut-array GraphBinding))) (returns GraphRead)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "The selected rows exclude disabled and inactive declarations.")
				(i32.lt (local index) (local length))
				(body
					(let declaration (struct.get (array.load (local selected) (local index)) node))
					(let node (array.load (local nodes) (local declaration)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let tag (call import_keyword (borrow-shared (local source)) (array.load (local nodes) (struct.get (local parts) head))))
					(if
						(:doc "Single-module compilation resolves the same definition keys as a graph.")
						(call is_wove_definition (local tag))
						(then
							(let result (call collect_wove_definition (borrow-shared (local source)) (borrow-shared (local nodes))
								(local node) (local parts) (local tag) (local declaration) (local file) (borrow-mut (local bindings)) (local count)))
							(if (u32.gtz (struct.get (local result) error)) (then (return (local result))))
							(set (local count) (struct.get (local result) next))))
					(set (local index) (i32.inc (local index)))))
			(return (call graph_read (local count) 0i32 0i32 0u32))))

	(fn collect_selectors
		(:doc `Cache selector spans and local name nodes before releasing the importer's source tree.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(first i32) (selectors (mut-array GraphSelector)) (offset i32))
		(returns GraphRead)
		(body
			(let-mut index (local first))
			(let-mut count (local offset))
			(while
				(:doc "Each selector occupies one row in the owning edge's contiguous interval.")
				(i32.not-ltz (local index))
				(body
					(let item (array.load (local nodes) (local index)))
					(if
						(:doc "A short selector table stops before writing beyond the view.")
						(i32.not-lt (local count) (array.len (local selectors)))
						(then (return (call graph_read (local count)
							(struct.get (local item) start) (struct.get (local item) end) 16u32))))
					(let selector (call read_selector (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))
					(let error (struct.get (local selector) error))
					(if
						(:doc "Replay a malformed selector only after its edge and preceding selections succeed.")
						(u32.gtz (local error))
						(then
							(array.store (local selectors) (local count)
								(struct.new GraphSelector
									(original_start (struct.get (local selector) start)) (original_end (struct.get (local selector) end))
									(local_start -1i32) (local_end -1i32) (local_bare (bool false)) (error (local error))
									(namespace (struct.get (local selector) namespace)) (local_node -1i32)))
							(return (call graph_read (i32.inc (local count)) 0i32 0i32 0u32))))
					(let original (array.load (local nodes) (struct.get (local selector) first)))
					(let name (array.load (local nodes) (struct.get (local selector) second)))
					(array.store (local selectors) (local count)
						(struct.new GraphSelector
							(original_start (struct.get (local original) start)) (original_end (struct.get (local original) end))
							(local_start (struct.get (local name) start)) (local_end (struct.get (local name) end))
							(local_bare (u32.eq (struct.get (local name) kind) 1u32)) (error 0u32)
							(namespace (struct.get (local selector) namespace)) (local_node (struct.get (local selector) second))))
					(set (local count) (i32.inc (local count)))
					(set (local index) (struct.get (local item) next_sibling))))
			(return (call graph_read (local count) 0i32 0i32 0u32))))

	(fn collect_use
		(:doc `Cache an edge and its selectors without resolving the provider yet.

		Store grammar errors as rows so depth-first traversal reports errors in
		edge order. Capacity failures are reported before writing any short view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (operands i32)
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)) (index i32) (offset i32))
		(returns GraphRead)
		(body
			(if
				(:doc "Reserve the edge row before collecting its selectors.")
				(i32.not-lt (local index) (array.len (local uses)))
				(then (return (call graph_read (local offset)
					(struct.get (local node) start) (struct.get (local node) end) 16u32))))
			(let use (call read_import (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local operands)))
			(let start (struct.get (local use) start))
			(let end (struct.get (local use) end))
			(let error (struct.get (local use) error))
			(if
				(:doc "A malformed use takes its place in edge order with its own diagnostic span.")
				(u32.gtz (local error))
				(then
					(array.store (local uses) (local index)
						(struct.new GraphUse (start (local start)) (end (local end)) (path_start -1i32) (path_end -1i32)
							(first (local offset)) (limit (local offset)) (error (local error)) (provider 0u32)))
					(return (call graph_read (local offset) 0i32 0i32 0u32))))
			(let selected (call collect_selectors (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local use) second) (borrow-mut (local selectors)) (local offset)))
			(if
				(:doc "Leave the edge unpublished when the selector table is short.")
				(u32.gtz (struct.get (local selected) error))
				(then (return (local selected))))
			(let path (array.load (local nodes) (struct.get (local use) first)))
			(array.store (local uses) (local index)
				(struct.new GraphUse (start (local start)) (end (local end))
					(path_start (struct.get (local path) start)) (path_end (struct.get (local path) end))
					(first (local offset)) (limit (struct.get (local selected) next)) (error 0u32) (provider (struct.get (local use) provider))))
			(return (local selected))))

	(fn collect_module
		(:doc `Summarize one selected declaration list in the graph tables.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (length i32) (file i32) (check_headers bool)
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(binding_offset i32) (use_offset i32) (selector_offset i32))
		(returns FileRead)
		(body
			(let-mut binding_count (local binding_offset))
			(let-mut use_count (local use_offset))
			(let-mut selector_count (local selector_offset))
			(let-mut index 0i32)
			(while
				(:doc "Collect active edges and local definitions before resolving imported names.")
				(i32.lt (local index) (local length))
				(body
					(let declaration (struct.get (array.load (local declarations) (local index)) node))
					(let node (array.load (local nodes) (local declaration)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let tag (call import_keyword (borrow-shared (local source))
						(array.load (local nodes) (struct.get (local parts) head))))
					(if
						(:doc "The local definition is visible to conflict checks on every edge.")
						(call is_wove_definition (local tag))
						(then
							(let result (call collect_wove_definition (borrow-shared (local source)) (borrow-shared (local nodes))
								(local node) (local parts) (local tag) (local declaration) (local file)
								(borrow-mut (local bindings)) (local binding_count)))
							(let error (struct.get (local result) error))
							(if
								(:doc "Retain the original definition diagnostic.")
								(u32.gtz (local error))
								(then (return (call file_read (local binding_count) (local use_count) (local selector_count)
									(bool true) (struct.get (local result) start) (struct.get (local result) end) (local error)))))
							(set (local binding_count) (struct.get (local result) next))))
					(if
						(:doc "Keep the provider, key span, and selector interval for an active use.")
						(u32.eq (local tag) 2u32)
						(then
							(let use (call collect_use (borrow-shared (local source)) (borrow-shared (local nodes))
								(local node) (struct.get (local parts) operands)
								(borrow-mut (local uses)) (borrow-mut (local selectors)) (local use_count) (local selector_count)))
							(let error (struct.get (local use) error))
							(if
								(:doc "A short scratch table stops the file read with its original span.")
								(u32.gtz (local error))
								(then (return (call file_read (local binding_count) (local use_count) (local selector_count)
									(bool true) (struct.get (local use) start) (struct.get (local use) end) (local error)))))
							(set (local selector_count) (struct.get (local use) next))
							(set (local use_count) (i32.inc (local use_count)))))
					(let header (struct.get (local parts) header))
					(if
						(:doc "Queue active project keys for validation even if they have no import.")
						(bool.and (local check_headers) (i32.lt -1i32 (local header)))
						(then
							(let literal (array.load (local nodes) (local header)))
							(let start (struct.get (local literal) start))
							(let end (struct.get (local literal) end))
							(if
								(:doc "Leave the operation table intact if it has no room for this key.")
								(i32.not-lt (local use_count) (array.len (local uses)))
								(then (return (call file_read (local binding_count) (local use_count) (local selector_count)
									(bool true) (local start) (local end) 16u32))))
							(array.store (local uses) (local use_count)
								(struct.new GraphUse (start (local start)) (end (local end))
									(path_start (local start)) (path_end (local end)) (first 0i32) (limit 0i32)
									(error 0u32) (provider 9u32)))
							(set (local use_count) (i32.inc (local use_count)))))
					(set (local index) (i32.inc (local index)))))
			(return (call file_read (local binding_count) (local use_count) (local selector_count)
				(bool true) 0i32 0i32 0u32))))

	(fn read_graph_file
		(:doc `Read a reached source in the graph mode and release its tree after collecting active references.`)
		(params (source (shared-array u8)) (file i32) (context SelectionContext) (check_headers bool)
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(binding_offset i32) (use_offset i32) (selector_offset i32))
		(returns FileRead)
		(body
			(let checked (call check_source_form (borrow-shared (local source))))
			(let parse_error (struct.get (local checked) error))
			(if
				(:doc "No allocation is needed when admission or structure fails.")
				(u32.gtz (local parse_error))
				(then (return (call file_read (local binding_offset) (local use_offset) (local selector_offset)
					(bool false) (struct.get (local checked) start) (struct.get (local checked) end) (local parse_error)))))
			(let rows (i32.from-u32 (struct.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let validated (call check_source_metadata (borrow-shared (local source)) (local built) (borrow-shared (local nodes))))
			(let-mut declarations (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes))
				(local validated) (local context) (borrow-mut (local declarations))))
			(let error (struct.get (local module) error))
			(if
				(:doc "A failed or excluded module contributes no active definitions or uses.")
				(bool.or (u32.gtz (local error)) (bool.not (struct.get (local module) active)))
				(then (return (call file_read (local binding_offset) (local use_offset) (local selector_offset)
					(bool false) (struct.get (local module) start) (struct.get (local module) end) (local error)))))
			(return (call collect_module (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (struct.get (local module) count) (local file) (local check_headers)
				(borrow-mut (local bindings)) (borrow-mut (local uses)) (borrow-mut (local selectors))
				(local binding_offset) (local use_offset) (local selector_offset)))))

	(fn resolve_edge
		(:doc `Decode the checked use path and resolve it from the importer's reached path.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(source (shared-array u8)) (path i32) (edge GraphUse))
		(returns GraphRead)
		(body
			(let edge_error (struct.get (local edge) error))
			(if
				(:doc "Return a cached use error at the edge's turn in traversal.")
				(u32.gtz (local edge_error))
