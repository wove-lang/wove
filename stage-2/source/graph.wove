			(return (call bind_c_header_scope (borrow-shared (local arena)) (borrow-shared (local files)) (borrow-shared (local source))
				(local importer) (local header) (local edge) (borrow-shared (local selectors)) (borrow-mut (local bindings)) (local offset) (local context)))))

	(fn measure_c_tree
		(:doc "Measure the selected provider's checked source view before reserving temporary nodes.")
		(params (arena (shared-slice u8)) (input SuppliedFile)) (returns FormCheck)
		(body (return (call check_source_form
			(borrow-shared (slice.range (local arena) (record.get (local input) source_start) (record.get (local input) source_end)))))))

	(fn copy_c_tree
		(:doc "Build the validated original tree and copy it with graph arena spans.")
		(params (view (shared-slice u8)) (checked FormCheck) (base i32) (source_base i32) (flat (mut-slice SourceNode)))
		(returns FormCheck)
		(body
			(let-mut nodes (array.alloc SourceNode (int.convert i32 (record.get (local checked) rows))))
			(let built (call build_source_tree (borrow-shared (local view)) (local checked) (borrow-mut (local nodes))))
			(if
				(:doc "Copy only complete source trees.")
				(u32.eq (record.get (local built) error) 0u32)
				(then (call copy_tree (borrow-shared (local nodes)) (borrow-mut (local flat)) (local base) (local source_base))))
			(return (local built))))

	(fn bind_c_header_scope
		(:doc "Build a temporary tree for each provider in the namespace and keep their original offsets.")
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (source (shared-slice u8)) (importer i32)
			(header HeaderMatch) (edge GraphUse) (selectors (shared-slice GraphSelector))
			(bindings (mut-slice GraphBinding)) (offset i32) (context SelectionContext))
		(returns GraphRead)
		(body
			(let primary (slice.load (local files) (record.get (local header) file)))
			(let checked (call measure_c_tree (borrow-shared (local arena)) (local primary)))
			(let rows (int.convert i32 (record.get (local checked) rows)))
			(let fallback (record.get (local header) default_file))
			(let-mut extra 0i32)
			(if
				(:doc "Only an extending project header contributes bundled fallback rows.")
				(i32.lt -1i32 (local fallback))
				(then
					(let size (call measure_c_tree (borrow-shared (local arena)) (slice.load (local files) (local fallback))))
					(set (local extra) (int.convert i32 (record.get (local size) rows)))))
			(if
				(:doc "Keep both provider trees within signed row indices.")
				(i32.lt (i32.sub.wrapping 2147483647i32 (local rows)) (local extra))
				(then (return (call graph_read (local offset) (record.get (local edge) start) (record.get (local edge) end) 16u32))))
			(let-mut flat (array.alloc SourceNode (i32.add.wrapping (local rows) (local extra))))
			(let built (call copy_c_tree
				(borrow-shared (slice.range (local arena) (record.get (local primary) source_start) (record.get (local primary) source_end)))
				(local checked) 0i32 (record.get (local primary) source_start) (borrow-mut (local flat))))
			(if
				(:doc "Keep the original source span if building the checked primary tree fails.")
				(u32.lt 0u32 (record.get (local built) error))
				(then (return (record.make GraphRead (next (local offset)) (start (record.get (local built) start))
					(end (record.get (local built) end)) (error (record.get (local built) error)) (file (record.get (local header) file))))))
			(if
				(:doc "Both original scopes get the same lookup order without changing their member links.")
				(i32.lt -1i32 (local fallback))
				(then
					(let bundled (slice.load (local files) (local fallback)))
					(let bundled_checked (call measure_c_tree (borrow-shared (local arena)) (local bundled)))
					(let inherited (call copy_c_tree
						(borrow-shared (slice.range (local arena) (record.get (local bundled) source_start) (record.get (local bundled) source_end)))
						(local bundled_checked) (local rows) (record.get (local bundled) source_start) (borrow-mut (local flat))))
					(if
						(:doc "Bundled tree errors retain the bundled source location.")
						(u32.lt 0u32 (record.get (local inherited) error))
						(then (return (record.make GraphRead (next (local offset)) (start (record.get (local inherited) start))
							(end (record.get (local inherited) end)) (error (record.get (local inherited) error)) (file (local fallback))))))
					(call connect_bridge_overlay (borrow-mut (local flat)) (record.get (local header) node)
						(i32.add.wrapping (local rows) (record.get (local header) default_node)))))
			(return (call bind_c_members (borrow-shared (local source)) (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local flat)) (local importer) (local header) (local rows) (local edge)
				(borrow-shared (local selectors)) (borrow-mut (local bindings)) (local offset) (local context)))))

