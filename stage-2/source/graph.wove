			(return (call bind_c_header_scope (borrow-shared (local arena)) (borrow-shared (local files)) (borrow-shared (local source))
				(local importer) (local header) (local edge) (borrow-shared (local selectors)) (borrow-mut (local bindings)) (local offset) (local context)))))

	(fn measure_c_tree
		(:doc "Measure the selected provider's checked source view before reserving temporary nodes.")
		(params (arena (shared-array u8)) (input SuppliedFile)) (returns FormCheck)
		(body (return (call check_source_form
			(borrow-shared (array.range (local arena) (struct.get (local input) source_start) (struct.get (local input) source_end)))))))

	(fn copy_c_tree
		(:doc "Build the validated original tree and copy it with graph arena spans.")
		(params (view (shared-array u8)) (checked FormCheck) (base i32) (source_base i32) (flat (mut-array SourceNode)))
		(returns FormCheck)
		(body
			(let-mut nodes (array.alloc SourceNode (i32.from-u32 (struct.get (local checked) rows))))
			(let built (call build_source_tree (borrow-shared (local view)) (local checked) (borrow-mut (local nodes))))
			(if
				(:doc "Copy only complete source trees.")
				(u32.eqz (struct.get (local built) error))
				(then (call copy_tree (borrow-shared (local nodes)) (borrow-mut (local flat)) (local base) (local source_base))))
			(return (local built))))

	(fn bind_c_header_scope
		(:doc "Build a temporary tree for each provider in the namespace and keep their original offsets.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (source (shared-array u8)) (importer i32)
			(header HeaderMatch) (edge GraphUse) (selectors (shared-array GraphSelector))
			(bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext))
		(returns GraphRead)
		(body
			(let primary (array.load (local files) (struct.get (local header) file)))
			(let checked (call measure_c_tree (borrow-shared (local arena)) (local primary)))
			(let rows (i32.from-u32 (struct.get (local checked) rows)))
			(let fallback (struct.get (local header) default_file))
			(let-mut extra 0i32)
			(if
				(:doc "Only an extending project header contributes bundled fallback rows.")
				(i32.lt -1i32 (local fallback))
				(then
					(let size (call measure_c_tree (borrow-shared (local arena)) (array.load (local files) (local fallback))))
					(set (local extra) (i32.from-u32 (struct.get (local size) rows)))))
			(if
				(:doc "Keep both provider trees within signed row indices.")
				(i32.lt (i32.sub 2147483647i32 (local rows)) (local extra))
				(then (return (call graph_read (local offset) (struct.get (local edge) start) (struct.get (local edge) end) 16u32))))
			(let-mut flat (array.alloc SourceNode (i32.add (local rows) (local extra))))
			(let built (call copy_c_tree
				(borrow-shared (array.range (local arena) (struct.get (local primary) source_start) (struct.get (local primary) source_end)))
				(local checked) 0i32 (struct.get (local primary) source_start) (borrow-mut (local flat))))
			(if
				(:doc "Keep the original source span if building the checked primary tree fails.")
				(u32.gtz (struct.get (local built) error))
				(then (return (struct.new GraphRead (next (local offset)) (start (struct.get (local built) start))
					(end (struct.get (local built) end)) (error (struct.get (local built) error)) (file (struct.get (local header) file))))))
			(if
				(:doc "Both original scopes get the same lookup order without changing their member links.")
				(i32.lt -1i32 (local fallback))
				(then
					(let bundled (array.load (local files) (local fallback)))
					(let bundled_checked (call measure_c_tree (borrow-shared (local arena)) (local bundled)))
					(let inherited (call copy_c_tree
						(borrow-shared (array.range (local arena) (struct.get (local bundled) source_start) (struct.get (local bundled) source_end)))
						(local bundled_checked) (local rows) (struct.get (local bundled) source_start) (borrow-mut (local flat))))
					(if
