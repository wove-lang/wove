				(mode (record.get (local context) mode)) (os (record.get (local context) os)) (arch (record.get (local context) arch))
				(deployment (record.get (local context) deployment))
				(file (local file)) (start (record.get (local edge) start)) (end (record.get (local edge) end)) (error 27u32)
				(path_start (record.get (local edge) path_start)) (path_end (record.get (local edge) path_end))))))

	(fn publish_binding
		(:doc `Reserve a file-local alias after either provider has resolved its defining declaration.`)
		(params (source (shared-slice u8)) (selector GraphSelector) (importer i32) (target GraphBinding)
			(bindings (mut-slice GraphBinding)) (index i32))
		(returns GraphRead)
		(body
			(let start (record.get (local selector) local_start))
			(let end (record.get (local selector) local_end))
			(let namespace (record.get (local target) namespace))
			(if
				(:doc "Validate the local spelling only after resolving the requested definition.")
				(bool.not (bool.and (record.get (local selector) local_bare)
					(call is_identifier_head (borrow-shared (local source)) (local start) (local end))))
				(then (return (call graph_read (local index) (local start) (local end) 26u32))))
			(let existing (call find_binding
				(borrow-shared (local source)) (borrow-shared (local source)) (local start) (local end)
				(borrow-shared (local bindings)) (local index) (local importer) (bool false) 0i32 (local namespace)))
			(if
				(:doc "A conflict points at the new local spelling.")
				(bool.or (bool.not (i32.lt (local existing) 0i32))
					(bool.and (u32.eq (local namespace) 1u32)
						(call is_reserved_type_name (borrow-shared (local source)) (local start) (local end))))
				(then (return (call graph_read (local index) (local start) (local end) 30u32))))
			(if
				(:doc "Check binding capacity before adding the alias.")
				(bool.not (i32.lt (local index) (slice.len (local bindings))))
				(then (return (call graph_read (local index) (local start) (local end) 16u32))))
			(slice.store (local bindings) (local index)
				(record.make GraphBinding (owner (local importer)) (start (local start)) (end (local end))
					(file (record.get (local target) file)) (declaration (record.get (local target) declaration))
					(namespace (local namespace)) (provider (record.get (local target) provider))
					(header_start (record.get (local target) header_start)) (header_end (record.get (local target) header_end))
					(native_start (record.get (local target) native_start)) (native_end (record.get (local target) native_end))
					(signature_start (record.get (local target) signature_start)) (signature_end (record.get (local target) signature_end))
					(native_type (record.get (local target) native_type))
					(drop_start (record.get (local target) drop_start)) (drop_end (record.get (local target) drop_end))
					(type_start (record.get (local target) type_start)) (type_end (record.get (local target) type_end))
					(name_node (record.get (local selector) local_node))
					(header_file (record.get (local target) header_file)) (bridge_node (record.get (local target) bridge_node))
					(default_file (record.get (local target) default_file)) (default_node (record.get (local target) default_node))
					(native_file (record.get (local target) native_file))))
			(return (call graph_read (i32.add.wrapping (local index) 1i32) 0i32 0i32 0u32))))

	(fn bind_edge
		(:doc `Bind one resolved edge in the importer's namespace using the provider's own declarations.`)
		(params (source (shared-slice u8)) (provider_source (shared-slice u8))
			(importer i32) (provider i32) (edge GraphUse) (selectors (shared-slice GraphSelector))
			(bindings (mut-slice GraphBinding)) (offset i32))
		(returns GraphRead)
		(body
			(let-mut count (local offset))
			(let-mut index (record.get (local edge) first))
			(while
				(:doc "Process selectors left to right so each alias reserves its name for the next.")
				(i32.lt (local index) (record.get (local edge) limit))
				(body
					(let selector (slice.load (local selectors) (local index)))
					(let original_start (record.get (local selector) original_start))
					(let original_end (record.get (local selector) original_end))
					(let namespace (record.get (local selector) namespace))
					(let error (record.get (local selector) error))
					(if
						(:doc "Return a cached selector error after the provider and earlier selections succeed.")
						(u32.lt 0u32 (local error))
						(then (return (call graph_read (local count) (local original_start) (local original_end) (local error)))))
					(let-mut definition (call find_binding
						(borrow-shared (local provider_source)) (borrow-shared (local source))
						(local original_start) (local original_end) (borrow-shared (local bindings))
						(local count) (local provider) (bool true) 0i32 (local namespace)))
					(if
						(:doc "An unqualified selector uses a module value when no defining function matches.")
						(bool.and (u32.eq (local namespace) 0u32) (i32.lt (local definition) 0i32))
						(then (set (local definition) (call find_binding
							(borrow-shared (local provider_source)) (borrow-shared (local source))
							(local original_start) (local original_end) (borrow-shared (local bindings))
							(local count) (local provider) (bool true) 0i32 2u32))))
					(if
						(:doc "An unavailable declaration points at its original requested name.")
						(i32.lt (local definition) 0i32)
						(then (return (call graph_read (local count) (local original_start) (local original_end) 29u32))))
					(let target (slice.load (local bindings) (local definition)))
					(let published (call publish_binding (borrow-shared (local source)) (local selector) (local importer)
						(local target) (borrow-mut (local bindings)) (local count)))
					(if
						(:doc "Keep the failed alias at the importing source span.")
						(u32.lt 0u32 (record.get (local published) error))
						(then (return (local published))))
					(set (local count) (record.get (local published) next))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (call graph_read (local count) 0i32 0i32 0u32))))

	(fn c_file_offset
		(:doc "Translate a source offset and retain a missing destructor's negative sentinel.")
		(params (position i32) (base i32)) (returns i32)
		(body
			(if (i32.lt (local position) 0i32) (then (return (local position))))
			(return (i32.sub.wrapping (local position) (local base)))))

	(fn c_scope_owner
		(:doc "Translate a temporary combined tree row to the physical defining file.")
		(params (header HeaderMatch) (primary_rows i32) (row i32)) (returns i32)
		(body
			(if (i32.lt (local row) (local primary_rows)) (then (return (record.get (local header) file))))
			(return (record.get (local header) default_file))))

	(fn c_scope_row_base
		(:doc "The temporary namespace stores the primary provider first and bundled nodes after it.")
		(params (header HeaderMatch) (primary_rows i32) (file i32)) (returns i32)
		(body
			(if (i32.eq (local file) (record.get (local header) file)) (then (return 0i32)))
			(return (local primary_rows))))

	(fn c_scope_error
		(:doc "Translate an absolute error span to the original source within the selected namespace.")
		(params (files (shared-slice SuppliedFile)) (header HeaderMatch) (count i32) (start i32) (end i32) (error u32))
		(returns GraphRead)
		(body
			(let-mut file (record.get (local header) file))
			(let fallback (record.get (local header) default_file))
			(if
				(:doc "Signature or dependency validation may fail in the bundled provider.")
				(i32.lt -1i32 (local fallback))
				(then
					(let input (slice.load (local files) (local fallback)))
					(if
						(:doc "Use the original backing byte range of that file.")
						(bool.and (bool.not (i32.lt (local start) (record.get (local input) source_start)))
							(i32.lt (local start) (record.get (local input) source_end)))
						(then (set (local file) (local fallback))))))
			(let base (record.get (slice.load (local files) (local file)) source_start))
			(return (record.make GraphRead (next (local count)) (start (i32.sub.wrapping (local start) (local base)))
				(end (i32.sub.wrapping (local end) (local base))) (error (local error)) (file (local file))))))

	(fn bind_c_members
		(:doc `Bind each selected C member to its original declaration and checked native contract.`)
		(params (source (shared-slice u8)) (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (nodes (shared-slice SourceNode))
			(importer i32) (header HeaderMatch) (primary_rows i32) (edge GraphUse) (selectors (shared-slice GraphSelector))
			(bindings (mut-slice GraphBinding)) (offset i32) (context SelectionContext))
		(returns GraphRead)
		(body
			(let-mut count (local offset))
			(let-mut index (record.get (local edge) first))
			(while
				(:doc "Select and publish each local name in source order.")
				(i32.lt (local index) (record.get (local edge) limit))
				(body
					(let selector (slice.load (local selectors) (local index)))
					(let start (record.get (local selector) original_start))
					(let end (record.get (local selector) original_end))
					(let error (record.get (local selector) error))
					(if
						(:doc "A malformed selector keeps its cached importing span.")
						(u32.lt 0u32 (local error))
						(then (return (call graph_read (local count) (local start) (local end) (local error)))))
					(let member (call find_c_declaration (borrow-shared (local arena)) (borrow-shared (local nodes))
						(record.get (local header) node) (borrow-shared (local source)) (local start) (local end)
						(record.get (local selector) namespace) (local context)))
					(let namespace (record.get (local member) namespace))
					(let rejected (record.get (local member) error))
					(if
						(:doc "A rejected C member belongs to the declaring Wove file.")
						(u32.lt 0u32 (local rejected))
						(then (return (call c_scope_error (borrow-shared (local files)) (local header) (local count)
							(record.get (local member) start) (record.get (local member) end) (local rejected)))))
					(let declaration (record.get (local member) declaration))
					(if
						(:doc "A missing C member points at the original requested spelling.")
						(i32.lt (local declaration) 0i32)
						(then (return (call graph_read (local count) (local start) (local end) 29u32))))
					(let file (call c_scope_owner (local header) (local primary_rows) (local declaration)))
					(let base (record.get (slice.load (local files) (local file)) source_start))
					(let row_base (call c_scope_row_base (local header) (local primary_rows) (local file)))
					(let type (record.get (local member) native_type))
					(let-mut native_file -1i32)
					(let-mut native_row 0i32)
					(let-mut native_base 0i32)
					(if
						(:doc "An inherited type retains its own defining file and node.")
						(i32.lt 0i32 (local type))
						(then
							(set (local native_file) (call c_scope_owner (local header) (local primary_rows) (local type)))
							(set (local native_row) (i32.sub.wrapping (local type)
								(call c_scope_row_base (local header) (local primary_rows) (local native_file))))
							(set (local native_base) (record.get (slice.load (local files) (local native_file)) source_start))))
					(let target (record.make GraphBinding (owner (local importer)) (start -1i32) (end -1i32)
						(file (local file)) (declaration (i32.sub.wrapping (local declaration) (local row_base)))
						(namespace (local namespace)) (provider 8u32)
						(header_start (record.get (local header) start)) (header_end (record.get (local header) end))
						(native_start (i32.sub.wrapping (record.get (local member) native_start) (local base)))
						(native_end (i32.sub.wrapping (record.get (local member) native_end) (local base)))
						(signature_start (i32.sub.wrapping (record.get (local member) signature_start) (local base)))
						(signature_end (i32.sub.wrapping (record.get (local member) signature_end) (local base)))
						(native_type (local native_row))
						(drop_start (call c_file_offset (record.get (local member) drop_start) (local native_base)))
						(drop_end (call c_file_offset (record.get (local member) drop_end) (local native_base)))
						(type_start (i32.sub.wrapping (record.get (local member) type_start) (local native_base)))
						(type_end (i32.sub.wrapping (record.get (local member) type_end) (local native_base)))
						(name_node -1i32) (header_file (record.get (local header) file)) (bridge_node (record.get (local header) node))
						(default_file (record.get (local header) default_file)) (default_node (record.get (local header) default_node))
						(native_file (local native_file))))
					(let published (call publish_binding (borrow-shared (local source)) (local selector) (local importer)
						(local target) (borrow-mut (local bindings)) (local count)))
					(if
						(:doc "An alias conflict or short destination belongs to the importing file.")
						(u32.lt 0u32 (record.get (local published) error))
						(then (return (local published))))
					(set (local count) (record.get (local published) next))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (call graph_read (local count) 0i32 0i32 0u32))))

	(fn resolve_c_header_operation
		(:doc "Validate a declared project key or resolve a C header use before checking its members.")
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (source (shared-slice u8)) (importer i32)
			(edge GraphUse) (selectors (shared-slice GraphSelector)) (bindings (mut-slice GraphBinding)) (offset i32) (context SelectionContext))
		(returns GraphRead)
		(body
			(let start (record.get (local edge) path_start))
			(let end (record.get (local edge) path_end))
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let key (call decode_string (borrow-shared (local source))
