						(type_start (i32.sub (struct.get (local member) type_start) (local native_base)))
						(type_end (i32.sub (struct.get (local member) type_end) (local native_base)))
						(name_node -1i32) (header_file (struct.get (local header) file)) (bridge_node (struct.get (local header) node))
						(default_file (struct.get (local header) default_file)) (default_node (struct.get (local header) default_node))
						(native_file (local native_file)) (optional (struct.get (local member) optional))
						(requested_start -1i32) (requested_end -1i32) (value_macro (struct.get (local member) value_macro)) (extent -1i32)))
					(let published (call publish_binding (borrow-shared (local source)) (local selector) (local importer)
						(local target) (borrow-mut (local bindings)) (local count)))
					(if
