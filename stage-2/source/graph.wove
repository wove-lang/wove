				(then (return (call graph_read offset (struct:get edge start) (struct:get edge end) 27u32))))
			(if
				(:doc "A module-level empty selection validates its provider without activating its bridge.")
				(i32:eq (struct:get edge first) (struct:get edge limit))
				(then (return (call graph_read offset 0i32 0i32 0u32))))
