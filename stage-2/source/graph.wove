				(:doc "A malformed use key retains its exact escaped input span.")
				(u32.lt 0u32 (record.get (local key) error))
				(then (return (call graph_read (local offset) (record.get (local key) start)
					(record.get (local key) end) (record.get (local key) error)))))
			(if
				(:doc "Check project declarations with the same target-aware lookup used for imports.")
				(u32.eq (record.get (local edge) provider) 9u32)
				(then
					(let header (call find_header_kind (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (slice.range (local decoded) 0i32 (record.get (local key) written))) (local context) (bool false)))
					(return (record.make GraphRead (next (local offset)) (start (record.get (local header) start))
						(end (record.get (local header) end)) (error (record.get (local header) error))
						(file (record.get (local header) file))))))
			(let header (call find_c_header (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (slice.range (local decoded) 0i32 (record.get (local key) written))) (local context)))
			(let provider (record.get (local header) file))
			(let error (record.get (local header) error))
			(if
				(:doc "Discovery errors retain their defining file and original span.")
				(u32.lt 0u32 (local error))
				(then (return (record.make GraphRead (next (local offset)) (start (record.get (local header) start))
					(end (record.get (local header) end)) (error (local error)) (file (local provider))))))
			(if
				(:doc "A missing bridge is diagnosed at the original importing use.")
				(i32.lt (local provider) 0i32)
