						(then
							(call update_frame (borrow-mut (local modules)) (local current) 2u32 (local next))
							(set (local current) (local importer)))
						(else
							(if
								(:doc "A cached provider was bound without entering another frame.")
								(i32.lt -1i32 (local provider))
								(then (call update_frame (borrow-mut (local modules)) (local current) 1u32
									(i32.inc (local next)))))))))
			(return (call graph_result (local context) (local module_count) (local binding_count) -1i32 0i32 0i32 0u32)))))
