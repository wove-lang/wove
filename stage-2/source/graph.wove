						(borrow-shared (array.range (local decoded) 0i32 (struct.get (local key) written))) (local context) (bool false)))
					(return (struct.new GraphRead (next (local offset)) (start (struct.get (local header) start))
						(end (struct.get (local header) end)) (error (struct.get (local header) error))
						(file (struct.get (local header) file))))))
			(let header (call find_c_header (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (array.range (local decoded) 0i32 (struct.get (local key) written))) (local context)))
