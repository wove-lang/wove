			(local entry) (call default_selection (local mode)) (borrow-mut (local modules)) (borrow-mut (local bindings))
			(borrow-mut (local uses)) (borrow-mut (local selectors))))))

	(fn resolve_graph_for_target
		(:doc `Resolve a virtual graph using the lexical paths supplied by its caller.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (entry i32) (context SelectionContext)
			(modules (mut-slice GraphModule)) (bindings (mut-slice GraphBinding))
			(uses (mut-slice GraphUse)) (selectors (mut-slice GraphSelector)))
		(returns GraphResult)
		(body
			(let edges (array.alloc DiskEdge 0i32))
			(return (call walk_graph (borrow-shared (local arena)) (borrow-shared (local files)) (local entry) (local context)
				(borrow-mut (local modules)) (borrow-mut (local bindings)) (borrow-mut (local uses))
				(borrow-mut (local selectors)) (bool false) (bool false) (borrow-shared (local edges))))))

	(fn resolve_disk_graph
		(:doc `Resolve a disk snapshot or return the first selected use with no cached target.

		Each edge records its canonical importing file, original use start,
		and a supplied target row. A nonnegative path_start marks a request
		and the diagnostic span covers the complete importing use.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (entry i32) (context SelectionContext)
			(modules (mut-slice GraphModule)) (bindings (mut-slice GraphBinding))
			(uses (mut-slice GraphUse)) (selectors (mut-slice GraphSelector)) (edges (shared-slice DiskEdge)))
		(returns GraphResult)
		(body
			(let loaded (call walk_graph (borrow-shared (local arena)) (borrow-shared (local files)) (local entry) (local context)
				(borrow-mut (local modules)) (borrow-mut (local bindings)) (borrow-mut (local uses))
				(borrow-mut (local selectors)) (bool true) (bool true) (borrow-shared (local edges))))
			(if
				(:doc "Return the next active file request or the first source failure during discovery.")
				(u32.lt 0u32 (record.get (local loaded) error))
				(then (return (local loaded))))
			(return (call walk_graph (borrow-shared (local arena)) (borrow-shared (local files)) (local entry) (local context)
				(borrow-mut (local modules)) (borrow-mut (local bindings)) (borrow-mut (local uses))
				(borrow-mut (local selectors)) (bool true) (bool false) (borrow-shared (local edges))))))

	(fn walk_graph
		(:doc `Resolve the reachable graph and publish file-local function bindings.

		Entry is a supplied path row. The module table has room for every supplied
		row and is indexed by canonical identity. States are unseen (0), visiting
		(1), and complete (2). Rows report the first reached path and discovery
		order. Binding names are byte spans in the owner's view. Their targets
		are a defining identity and the declaration's node index in that file's
		checked tree. Provider kind 3 identifies Wove definitions. Kind 8 identifies
		C targets with original member, header, and native type identities. Those
		components can come from different files in an overlaid header.
		Keep the selection context in the result so graph consumers reuse the same selection.
		Error spans are byte offsets in the named diagnostic file.
		On failure, the counts report reached modules and the initialized binding prefix.`)
		(:expect
			(tests "stage-2/source_graphs.tsv" "stage-2/graph/targets/cases.tsv")
			(issues "gh:wove-lang/wove:68" "gh:wove-lang/wove:138" "gh:wove-lang/wove:146" "gh:wove-lang/wove:190" "gh:wove-lang/wove:227"))
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (entry i32) (context SelectionContext)
			(modules (mut-slice GraphModule)) (bindings (mut-slice GraphBinding))
			(uses (mut-slice GraphUse)) (selectors (mut-slice GraphSelector)) (disk bool) (loading bool) (edges (shared-slice DiskEdge)))
		(returns GraphResult)
		(body
			(let length (slice.len (local files)))
			(if
				(:doc "The entry must name a supplied path row.")
				(bool.or (i32.lt (local entry) 0i32) (bool.not (i32.lt (local entry) (local length))))
				(then (return (call graph_result (local context) 0i32 0i32 -1i32 0i32 0i32 27u32))))
			(if
				(:doc "Preflight module storage before clearing any state.")
				(i32.lt (slice.len (local modules)) (local length))
				(then (return (call graph_result (local context) 0i32 0i32 -1i32 0i32 0i32 16u32))))
			(let-mut index 0i32)
			(while
				(:doc "Callers can reuse module storage between graph walks.")
				(i32.lt (local index) (local length))
				(body
					(slice.store (local modules) (local index)
						(record.make GraphModule (state 0u32) (path -1i32) (order -1i32)
							(parent -1i32) (next_use 0i32) (end_use 0i32) (active (bool false))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(let-mut module_count 0i32)
			(let-mut binding_count 0i32)
			(let-mut use_count 0i32)
			(let-mut selector_count 0i32)
			(let root (record.get (slice.load (local files) (local entry)) identity))
			(let-mut current (local root))
			(let-mut pending_path (local entry))
			(let-mut pending_parent -1i32)
			(while
				(:doc "Parent links suspend importers while an unseen provider is being resolved.")
				(bool.not (i32.lt (local current) 0i32))
				(body
					(let file (slice.load (local files) (local current)))
					(let source_start (record.get (local file) source_start))
					(let source_end (record.get (local file) source_end))
					(if
						(:doc "Parse an identity only when the first active edge reaches it.")
						(bool.not (i32.lt (local pending_path) 0i32))
						(then
							(let loaded (call read_graph_file
								(borrow-shared (slice.range (local arena) (local source_start) (local source_end)))
								(local current) (local context)
								(bool.not (bool.or (local loading) (record.get (local file) bundled)))
								(borrow-mut (local bindings)) (borrow-mut (local uses))
								(borrow-mut (local selectors)) (local binding_count) (local use_count) (local selector_count)))
							(set (local binding_count) (record.get (local loaded) bindings))
							(let error (record.get (local loaded) error))
							(if
								(:doc "Admission, syntax, and declaration failures belong to the file being read.")
								(u32.lt 0u32 (local error))
								(then (return (call graph_result (local context) (local module_count) (local binding_count) (local current)
									(record.get (local loaded) start) (record.get (local loaded) end) (local error)))))
							(let active (record.get (local loaded) active))
							(if
								(:doc "An excluded provider exposes zero names, but the entry must be selected.")
								(bool.and (i32.eq (local current) (local root)) (bool.not (local active)))
								(then (return (call graph_result (local context) (local module_count) (local binding_count) (local current)
									(record.get (local loaded) start) (record.get (local loaded) end) 31u32))))
							(let end_use (record.get (local loaded) uses))
							(slice.store (local modules) (local current)
								(record.make GraphModule (state 1u32) (path (local pending_path)) (order (local module_count))
									(parent (local pending_parent)) (next_use (local use_count)) (end_use (local end_use)) (active (local active))))
							(set (local module_count) (i32.add.wrapping (local module_count) 1i32))
							(set (local use_count) (local end_use))
							(set (local selector_count) (record.get (local loaded) selectors))
							(set (local pending_path) -1i32)))
					(let frame (slice.load (local modules) (local current)))
					(let next (record.get (local frame) next_use))
					(let-mut importer (local current))
					(let-mut provider -1i32)
					(let-mut edge_index (local next))
					(if
						(:doc "An exhausted frame completes and resumes the edge that first reached it.")
						(i32.eq (local next) (record.get (local frame) end_use))
						(then
							(call update_frame (borrow-mut (local modules)) (local current) (local frame) 2u32 (local next))
							(set (local importer) (record.get (local frame) parent))
							(set (local provider) (local current))
							(set (local current) (local importer))
							(if
								(:doc "The parent's cursor already advanced past the pending edge.")
								(bool.not (i32.lt (local importer) 0i32))
								(then
									(set (local edge_index) (i32.sub.wrapping
										(record.get (slice.load (local modules) (local importer)) next_use) 1i32)))))
						(else
							(let edge (slice.load (local uses) (local next)))
							(if
								(:doc "C header imports and project declarations resolve a key without traversing a Wove-file edge.")
								(bool.or (u32.eq (record.get (local edge) provider) 8u32)
									(u32.eq (record.get (local edge) provider) 9u32))
								(then
									(if
										(:doc "A header declaration can live in a file reached by a later Wove edge.")
										(bool.not (local loading))
										(then
											(let bound (call resolve_c_header_operation (borrow-shared (local arena)) (borrow-shared (local files))
												(borrow-shared (slice.range (local arena) (local source_start) (local source_end)))
												(local current) (local edge) (borrow-shared (local selectors))
												(borrow-mut (local bindings)) (local binding_count) (local context)))
											(set (local binding_count) (record.get (local bound) next))
											(let error (record.get (local bound) error))
											(if
												(:doc "Use the provider file for a defining error and the importer for a selection error.")
												(u32.lt 0u32 (local error))
												(then
													(let-mut file (record.get (local bound) file))
													(if
														(:doc "A selection error has no separate defining file.")
														(i32.lt (local file) 0i32)
														(then (set (local file) (local current))))
													(return (call graph_result (local context) (local module_count) (local binding_count) (local file)
														(record.get (local bound) start) (record.get (local bound) end) (local error)))))))
									(call update_frame (borrow-mut (local modules)) (local current) (local frame) 1u32
										(i32.add.wrapping (local next) 1i32)))
								(else
									(let resolved (call resolve_graph_edge (borrow-shared (local arena)) (borrow-shared (local files))
										(borrow-shared (slice.range (local arena) (local source_start) (local source_end)))
										(local current) (record.get (local frame) path) (local edge) (local disk) (borrow-shared (local edges))))
									(if
										(:doc "Suspend before opening the next active disk edge. Malformed uses have no request span.")
										(bool.and (bool.and (local disk) (u32.eq (record.get (local resolved) error) 27u32))
											(i32.lt -1i32 (record.get (local edge) path_start)))
										(then (return (call disk_request (local context) (local module_count) (local binding_count)
											(local current) (local edge)))))
									(let error (record.get (local resolved) error))
									(if
										(:doc "Path errors belong to the importing file.")
										(u32.lt 0u32 (local error))
										(then (return (call graph_result (local context) (local module_count) (local binding_count) (local current)
											(record.get (local resolved) start) (record.get (local resolved) end) (local error)))))
									(let path (record.get (local resolved) next))
									(let target (record.get (slice.load (local files) (local path)) identity))
									(let state (record.get (slice.load (local modules) (local target)) state))
									(if
										(:doc "An edge into a visiting identity closes an active cycle.")
										(u32.eq (local state) 1u32)
										(then (return (call graph_result (local context) (local module_count) (local binding_count) (local current)
											(record.get (local edge) start) (record.get (local edge) end) 28u32))))
									(call update_frame (borrow-mut (local modules)) (local current) (local frame) 1u32
										(i32.add.wrapping (local next) 1i32))
									(if
										(:doc "Bind immediately for a completed provider or suspend this importer for a new one.")
										(u32.eq (local state) 2u32)
										(then (set (local provider) (local target)))
										(else
											(set (local pending_parent) (local current))
											(set (local pending_path) (local path))
											(set (local current) (local target))))))))
					(if
						(:doc "Bind exactly once after the provider completes, including for a cached identity.")
						(bool.and (bool.not (i32.lt (local importer) 0i32)) (bool.not (i32.lt (local provider) 0i32)))
						(then
							(let from (slice.load (local files) (local importer)))
							(let target (slice.load (local files) (local provider)))
							(let bound (call bind_edge
								(borrow-shared (slice.range (local arena)
									(record.get (local from) source_start) (record.get (local from) source_end)))
								(borrow-shared (slice.range (local arena)
									(record.get (local target) source_start) (record.get (local target) source_end)))
								(local importer) (local provider) (slice.load (local uses) (local edge_index))
								(borrow-shared (local selectors)) (borrow-mut (local bindings)) (local binding_count)))
							(set (local binding_count) (record.get (local bound) next))
							(let error (record.get (local bound) error))
							(if
								(:doc "An unavailable or conflicting selection belongs to the importing file.")
								(u32.lt 0u32 (local error))
								(then (return (call graph_result (local context) (local module_count) (local binding_count) (local importer)
									(record.get (local bound) start) (record.get (local bound) end) (local error)))))))))
			(return (call graph_result (local context) (local module_count) (local binding_count) -1i32 0i32 0i32 0u32)))))
