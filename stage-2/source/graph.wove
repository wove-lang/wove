(module source_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve active Wove and C header imports from a supplied Stage 2 source graph.

	Walk Wove-file edges in depth-first order and visit each reached identity once.
	Keep declarations and local spellings as references into the original views.
	The caller supplies file ranges inside an immutable byte arena and separate
	writable storage for module rows, local bindings, edges, and selectors.`)

	(use wove-file "./scan.wove"
		(only check_source_form semantic_tree_rows build_semantic_tree check_source_metadata
			(type SourceNode) (type Token) (type FormCheck)))
	(use wove-file "./module.wove" (only form_parts read_module_for_target (type SelectedDeclaration) (type FormParts)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./extent.wove" (only immutable_extent_value))
	(use wove-file "./paths.wove" (only resolve_path (type SuppliedFile)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier))
	(use wove-file "./imports.wove" (only import_keyword is_import_name read_import read_selector))
	(use wove-file "./types.wove" (only is_reserved_type_name))
	(use wove-file "./tree_copy.wove" (only copy_tree))
	(use wove-file "./c_scope.wove" (only connect_bridge_overlay))
	(use wove-file "./c_headers.wove" (only (type HeaderMatch) find_c_header find_header_kind find_c_declaration))
	(use wove-file "./c_dependencies.wove" (only connect_bridge_type))
	(use wove-file "./c_dependency_paths.wove" (only scoped_uses count_bridge_uses (type BridgeUse)))
	(use wove-file "./c_owners.wove" (only is_c_long_double))
	(use wove-file "./c_records.wove" (only is_c_record))

	(use wove-file "./target.wove" (only default_selection (type SelectionContext)))

	(struct GraphModule
		(fields (state u32) (path i32) (order i32) (parent i32) (next_use i32) (end_use i32) (active bool) (failed bool)))
	(struct GraphBinding
		(:doc "A published name with a file-local name node in the owner and a declaration in the defining file. Public C members record the binding range of their declared prerequisites. A private intrinsic type has no C header span.")
		(fields (owner i32) (start i32) (end i32) (file i32) (declaration i32) (namespace u32)
			(provider u32) (header_start i32) (header_end i32) (native_start i32) (native_end i32)
			(signature_start i32) (signature_end i32) (native_type i32) (drop_start i32) (drop_end i32)
			(type_start i32) (type_end i32) (name_node i32)
			(header_file i32) (bridge_node i32) (default_file i32) (default_node i32) (native_file i32)
			(optional bool) (scalar_typedef bool) (requested_start i32) (requested_end i32) (value_macro bool) (value_lossless bool) (null_value bool) (extent i32)
			(integer_constant bool) (constant_bits u32) (prerequisite_start i32) (prerequisite_end i32) (wove_result_layout bool)))

	(fn copy_graph_bindings
		(:doc "Copy the initialized prefix into the exact binding view consumed by a checker.")
		(params (source (shared-array GraphBinding)) (bindings (mut-array GraphBinding)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The destination size is the published binding count.")
				(index.lt bindings.len)
				(body
					(bindings.set index (source.get index))
					(set index index.inc)))))

	(fn binding_with_integer_constant
		(:doc "Attach one exact i32 result without changing the defining or imported binding identity.")
		(params (binding GraphBinding) (bits u32) (extent i32)) (returns GraphBinding)
		(body
			(return (GraphBinding.new
				(owner binding/owner) (start binding/start) (end binding/end)
				(file binding/file) (declaration binding/declaration) (namespace binding/namespace)
				(provider binding/provider) (header_start binding/header_start) (header_end binding/header_end)
				(native_start binding/native_start) (native_end binding/native_end) (signature_start binding/signature_start)
				(signature_end binding/signature_end) (native_type binding/native_type) (drop_start binding/drop_start)
				(drop_end binding/drop_end) (type_start binding/type_start) (type_end binding/type_end)
				(name_node binding/name_node) (header_file binding/header_file) (bridge_node binding/bridge_node)
				(default_file binding/default_file) (default_node binding/default_node) (native_file binding/native_file)
				(optional binding/optional) (scalar_typedef binding/scalar_typedef)
				(requested_start binding/requested_start) (requested_end binding/requested_end)
				(value_macro binding/value_macro) (value_lossless binding/value_lossless)
				(null_value binding/null_value)
				(extent extent) (integer_constant (bool true)) (constant_bits bits)
				(prerequisite_start binding/prerequisite_start)
				(prerequisite_end binding/prerequisite_end)
				(wove_result_layout binding/wove_result_layout)))))

	(let c_dependency_provider 10u32)

	(fn references_c_header
		(:doc "A public C selection or private dependency can require its provider's Wove declarations.")
		(params (binding GraphBinding)) (returns bool)
		(body (return (bool:or (binding/provider.eq 8u32)
			(binding/provider.eq c_dependency_provider)))))

	(fn includes_c_header
		(:doc "A private intrinsic type keeps its provider identity without an include span.")
		(params (binding GraphBinding)) (returns bool)
		(body (return (bool:and (call references_c_header binding)
			binding/header_start.not-ltz))))

	(struct CScopeTree (fields (base i32) (rows i32)))
	(struct CScopeVisit (fields (file i32) (node i32)))

	(struct GraphUse
		(fields (start i32) (end i32) (path_start i32) (path_end i32) (first i32) (limit i32) (error u32) (provider u32)))
	(struct GraphSelector
		(fields (original_start i32) (original_end i32) (local_start i32) (local_end i32) (local_bare bool) (error u32) (namespace u32) (local_node i32)))
	(struct GraphResult
		(fields (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32) (mode u32) (os u8) (arch u8) (deployment i32)
			(path_start i32) (path_end i32)))
	(struct DiskEdge
		(:doc "A disk edge caches either its provider identity or an original host read diagnostic.") (fields (file i32) (start i32) (target i32) (path_start i32) (path_end i32) (error_start i32) (error_end i32) (error u32)))
	(struct GraphProgress
		(:doc "A suspended walk over committed table prefixes and its current depth-first frame.")
		(fields (files i32) (binding bool) (current i32) (pending_path i32) (pending_parent i32)
			(modules i32) (bindings i32) (uses i32) (selectors i32)))
	(struct FileRead
		(fields (bindings i32) (uses i32) (selectors i32) (active bool) (start i32) (end i32) (error u32)))
	(struct GraphRead (fields (next i32) (start i32) (end i32) (error u32) (file i32)))

	(fn file_read
		(:doc `Package a file read with its absolute table cursors and view-relative diagnostic.`)
		(params (bindings i32) (uses i32) (selectors i32) (active bool) (start i32) (end i32) (error u32))
		(returns FileRead)
		(body
			(return (FileRead.new (bindings bindings) (uses uses)
				(selectors selectors) (active active)
				(start start) (end end) (error error)))))

	(fn graph_read
		(:doc `Return the next cursor or path row with its originating source span on failure.`)
		(params (next i32) (start i32) (end i32) (error u32))
		(returns GraphRead)
		(body
			(return (GraphRead.new (next next) (start start)
				(end end) (error error) (file -1i32)))))

	(fn graph_result
		(:doc `Return graph counts and a diagnostic in the named file's original source view.`)
		(params (context SelectionContext) (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphResult)
		(body
			(return (GraphResult.new (modules modules) (bindings bindings)
				(file file) (start start) (end end) (error error) (mode context/mode)
				(os context/os) (arch context/arch)
				(deployment context/deployment) (path_start -1i32) (path_end -1i32)))))

	(fn graph_selection
		(:doc `Recover the exact selection context retained by the resolver for its consumers.`)
		(params (graph GraphResult))
		(returns SelectionContext)
		(body (return (SelectionContext.new (mode graph/mode)
			(os graph/os) (arch graph/arch)
			(deployment graph/deployment)))))

	(fn find_binding
		(:doc `Locate a name within one file's namespace, optionally including its imports.

		The spelling may come from another file. The base is the owner's byte
		offset when names refer to the complete arena. Definition lookup for an import
		skips bindings that point to a different file, so imports do not re-export.`)
		(params (names (shared-array u8)) (spelling (shared-array u8)) (start i32) (end i32)
			(bindings (shared-array GraphBinding)) (count i32) (owner i32) (locals_only bool) (base i32) (namespace u32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Search the published binding prefix for this file and spelling.")
				(index.lt count)
				(body
					(let item (bindings.get index))
					(if
						(:doc "Only compare a candidate from the requested namespace.")
						(bool:and
							(bool:and (item/owner.eq owner)
								(item/namespace.eq namespace))
							(bool:and
								(locals_only.not.or
									(bool:and (item/provider.eq 3u32)
										(item/file.eq owner)))
								(call same_bytes (borrow-shared names)
									(base.add item/start)
									(base.add item/end) (borrow-shared spelling) start end)))
						(then (return index)))
					(set index index.inc)))
			(return -1i32)))

	(fn collect_definition
		(:doc `Record a local definition before imports can add aliases to its namespace.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(name i32) (declaration i32) (file i32) (namespace u32) (extent i32)
			(bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(if
				(:doc "Each definition needs a name.")
				name.ltz
				(then (return (call graph_read count node/start node/end 26u32))))
			(let name_node (nodes.get name))
			(let start name_node/start)
			(let end name_node/end)
			(if
				(:doc "An invalid name keeps the name node's original span.")
				(bool:not (call is_import_name (borrow-shared source) name_node))
				(then (return (call graph_read count start end 26u32))))
			(let existing (call find_binding (borrow-shared source) (borrow-shared source)
				start end (borrow-shared bindings) count file (bool false) 0i32 namespace))
			(if
				(:doc "Definitions reserve their name regardless of where the use appears.")
				existing.not-ltz
				(then (return (call graph_read count start end 30u32))))
			(if
				(:doc "Capacity is checked before publishing another row.")
				(count.not-lt bindings.len)
				(then (return (call graph_read count start end 16u32))))
			(bindings.set count
				(GraphBinding.new (owner file) (start start) (end end)
					(file file) (declaration declaration) (namespace namespace) (provider 3u32)
					(header_start -1i32) (header_end -1i32) (native_start -1i32) (native_end -1i32)
					(signature_start -1i32) (signature_end -1i32)
					(native_type 0i32) (drop_start 0i32) (drop_end 0i32)
					(type_start 0i32) (type_end 0i32) (name_node name)
					(header_file -1i32) (bridge_node -1i32) (default_file -1i32) (default_node -1i32) (native_file -1i32)
					(optional (bool false)) (scalar_typedef (bool false)) (requested_start -1i32) (requested_end -1i32) (value_macro (bool false)) (value_lossless (bool false)) (null_value (bool false)) (extent extent) (integer_constant (bool false)) (constant_bits 0u32)
					(prerequisite_start 0i32) (prerequisite_end 0i32) (wove_result_layout (bool false))))
			(return (call graph_read count.inc 0i32 0i32 0u32))))

	(fn collect_wove_definition
		(:doc "Publish a selected function, type, or value in its module namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(parts FormParts) (tag u32) (declaration i32) (file i32) (bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(let-mut namespace 0u32)
			(let name parts/name)
			(if
				(:doc "Nominal types and aliases own a separate declaration namespace.")
				(call is_wove_type_definition tag)
				(then (set namespace 1u32)))
			(let-mut extent -1i32)
			(if
				(:doc "Read a module value's initializer from the first ordinary operand after metadata.")
				(tag.eq 12u32)
				(then
					(set namespace 2u32)
					(set extent (call immutable_extent_value (borrow-shared source)
						(borrow-shared nodes) parts/operands))))
			(return (call collect_definition (borrow-shared source) (borrow-shared nodes)
				node name declaration file namespace extent
				(borrow-mut bindings) count))))

	(fn is_wove_type_definition
		(:doc "Recognize nominal types and aliases when a tag occurs at declaration scope.")
		(params (tag u32)) (returns bool)
		(body (return (bool:or (tag.eq 6u32) (tag.eq 7u32)))))

	(fn is_wove_definition
		(:doc "Recognize the selected root declarations that reserve names.")
		(params (tag u32)) (returns bool)
		(body (return (bool:or (tag.eq 1u32)
			(bool:or (call is_wove_type_definition tag) (tag.eq 12u32))))))

	(fn collect_standalone_bindings
		(:doc "Publish the selected definitions for a single-module consumer that has no graph import pass.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (selected (shared-array SelectedDeclaration))
			(length i32) (file i32) (bindings (mut-array GraphBinding))) (returns GraphRead)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "The selected rows exclude disabled and inactive declarations.")
				(index.lt length)
				(body
					(let declaration (struct:get (selected.get index) node))
					(let node (nodes.get declaration))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let tag (call import_keyword (borrow-shared source) (nodes.get parts/head)))
					(if
						(:doc "Single-module compilation resolves the same definition keys as a graph.")
						(call is_wove_definition tag)
						(then
							(let result (call collect_wove_definition (borrow-shared source) (borrow-shared nodes)
								node parts tag declaration file (borrow-mut bindings) count))
							(if result/error.gtz (then (return result)))
							(set count result/next)))
					(set index index.inc)))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn collect_selectors
		(:doc `Cache selector spans and local name nodes before releasing the importer's source tree.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(first i32) (selectors (mut-array GraphSelector)) (offset i32))
		(returns GraphRead)
		(body
			(let-mut index first)
			(let-mut count offset)
			(while
				(:doc "Each selector occupies one row in the owning edge's contiguous interval.")
				index.not-ltz
				(body
					(let item (nodes.get index))
					(if
						(:doc "A short selector table stops before writing beyond the view.")
						(count.not-lt selectors.len)
						(then (return (call graph_read count
							item/start item/end 16u32))))
					(let selector (call read_selector (borrow-shared source) (borrow-shared nodes) index))
					(let error selector/error)
					(if
						(:doc "Replay a malformed selector only after its edge and preceding selections succeed.")
						error.gtz
						(then
							(selectors.set count
								(GraphSelector.new
									(original_start selector/start) (original_end selector/end)
									(local_start -1i32) (local_end -1i32) (local_bare (bool false)) (error error)
									(namespace selector/namespace) (local_node -1i32)))
							(return (call graph_read count.inc 0i32 0i32 0u32))))
					(let original (nodes.get selector/first))
					(let name (nodes.get selector/second))
					(selectors.set count
						(GraphSelector.new
							(original_start original/start) (original_end original/end)
							(local_start name/start) (local_end name/end)
							(local_bare (name/kind.eq 1u32)) (error 0u32)
							(namespace selector/namespace) (local_node selector/second)))
					(set count count.inc)
					(set index item/next_sibling)))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn collect_use
		(:doc `Cache an edge and its selectors without resolving the provider yet.

		Store grammar errors as rows so depth-first traversal reports errors in
		edge order. Capacity failures are reported before writing any short view.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (operands i32)
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)) (index i32) (offset i32))
		(returns GraphRead)
		(body
			(if
				(:doc "Reserve the edge row before collecting its selectors.")
				(index.not-lt uses.len)
				(then (return (call graph_read offset
					node/start node/end 16u32))))
			(let use (call read_import (borrow-shared source) (borrow-shared nodes) node operands))
			(let start use/start)
			(let end use/end)
			(let error use/error)
			(if
				(:doc "A malformed use takes its place in edge order with its own diagnostic span.")
				error.gtz
				(then
					(uses.set index
						(GraphUse.new (start start) (end end) (path_start -1i32) (path_end -1i32)
							(first offset) (limit offset) (error error) (provider 0u32)))
					(return (call graph_read offset 0i32 0i32 0u32))))
			(let selected (call collect_selectors (borrow-shared source) (borrow-shared nodes)
				use/second (borrow-mut selectors) offset))
			(if
				(:doc "Leave the edge unpublished when the selector table is short.")
				selected/error.gtz
				(then (return selected)))
			(let path (nodes.get use/first))
			(uses.set index
				(GraphUse.new (start start) (end end)
					(path_start path/start) (path_end path/end)
					(first offset) (limit selected/next) (error 0u32) (provider use/provider)))
			(return selected)))

	(fn collect_module
		(:doc `Summarize one selected declaration list in the graph tables.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (length i32) (file i32) (check_headers bool)
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(binding_offset i32) (use_offset i32) (selector_offset i32))
		(returns FileRead)
		(body
			(let-mut binding_count binding_offset)
			(let-mut use_count use_offset)
			(let-mut selector_count selector_offset)
			(let-mut index 0i32)
			(while
				(:doc "Collect active edges and local definitions before resolving imported names.")
				(index.lt length)
				(body
					(let declaration (struct:get (declarations.get index) node))
					(let node (nodes.get declaration))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let tag (call import_keyword (borrow-shared source)
						(nodes.get parts/head)))
					(if
						(:doc "The local definition is visible to conflict checks on every edge.")
						(call is_wove_definition tag)
						(then
							(let result (call collect_wove_definition (borrow-shared source) (borrow-shared nodes)
								node parts tag declaration file
								(borrow-mut bindings) binding_count))
							(let error result/error)
							(if
								(:doc "Retain the original definition diagnostic.")
								error.gtz
								(then (return (call file_read binding_count use_count selector_count
									(bool true) result/start result/end error))))
							(set binding_count result/next)))
					(if
						(:doc "Keep the provider, key span, and selector interval for an active use.")
						(tag.eq 2u32)
						(then
							(let use (call collect_use (borrow-shared source) (borrow-shared nodes)
								node parts/operands
								(borrow-mut uses) (borrow-mut selectors) use_count selector_count))
							(let error use/error)
							(if
								(:doc "A short scratch table stops the file read with its original span.")
								error.gtz
								(then (return (call file_read binding_count use_count selector_count
									(bool true) use/start use/end error))))
							(set selector_count use/next)
							(set use_count use_count.inc)))
					(let header parts/header)
					(if
						(:doc "Queue active project keys for validation even if they have no import.")
						(check_headers.and (i32:lt -1i32 header))
						(then
							(let literal (nodes.get header))
							(let start literal/start)
							(let end literal/end)
							(if
								(:doc "Leave the operation table intact if it has no room for this key.")
								(use_count.not-lt uses.len)
								(then (return (call file_read binding_count use_count selector_count
									(bool true) start end 16u32))))
							(uses.set use_count
								(GraphUse.new (start start) (end end)
									(path_start start) (path_end end) (first 0i32) (limit 0i32)
									(error 0u32) (provider 9u32)))
							(set use_count use_count.inc)))
					(set index index.inc)))
			(return (call file_read binding_count use_count selector_count
				(bool true) 0i32 0i32 0u32))))

	(fn read_graph_file
		(:doc `Read a reached source in the graph mode and release its tree after collecting active references.`)
		(params (source (shared-array u8)) (file i32) (context SelectionContext) (check_headers bool)
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(binding_offset i32) (use_offset i32) (selector_offset i32))
		(returns FileRead)
		(body
			(let checked (call check_source_form (borrow-shared source)))
			(let parse_error checked/error)
			(if
				(:doc "No allocation is needed when admission or structure fails.")
				parse_error.gtz
				(then (return (call file_read binding_offset use_offset selector_offset
					(bool false) checked/start checked/end parse_error))))
			(let rows (i32:from-u32 (call semantic_tree_rows checked)))
			(let-mut nodes (array:alloc SourceNode rows))
			(let built (call build_semantic_tree (borrow-shared source) checked (borrow-mut nodes)))
			(let validated (call check_source_metadata (borrow-shared source) built (borrow-shared nodes)))
			(let-mut declarations (array:alloc SelectedDeclaration rows))
			(let module (call read_module_for_target (borrow-shared source) (borrow-shared nodes)
				validated context (borrow-mut declarations)))
			(let error module/error)
			(if
				(:doc "A failed or excluded module contributes no active definitions or uses.")
				(error.gtz.or module/active.not)
				(then (return (call file_read binding_offset use_offset selector_offset
					(bool false) module/start module/end error))))
			(return (call collect_module (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) module/count file check_headers
				(borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)
				binding_offset use_offset selector_offset))))

	(fn resolve_edge
		(:doc `Decode the checked use path and resolve it from the importer's reached path.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(source (shared-array u8)) (path i32) (edge GraphUse))
		(returns GraphRead)
		(body
			(let edge_error edge/error)
			(if
				(:doc "Return a cached use error at the edge's turn in traversal.")
				edge_error.gtz
				(then (return (call graph_read -1i32 edge/start
					edge/end edge_error))))
			(let start edge/path_start)
			(let end edge/path_end)
			(let token (Token.new (kind 2u32) (start start) (end end) (error 0u32)))
			(let-mut decoded (array:alloc u8 (end.sub start)))
			(let result (call decode_string (borrow-shared source) token (borrow-mut decoded)))
			(let error result/error)
			(if
				(:doc "Decoder errors keep the precise offending escape span.")
				error.gtz
				(then (return (call graph_read -1i32
					result/start result/end error))))
			(let target (call resolve_path (borrow-shared arena) (borrow-shared files)
				(files.get path)
				(borrow-shared (decoded.range 0i32 result/written))))
			(if
				(:doc "A nonexistent path or a scratch limit points at the importing use.")
				target.ltz
				(then
					(let-mut code 27u32)
					(if
						(:doc "Distinguish an unrepresentable path width from a missing file.")
						(target.eq -2i32)
						(then (set code 16u32)))
					(return (call graph_read -1i32 edge/start
						edge/end code))))
			(return (call graph_read target 0i32 0i32 0u32))))

	(fn resolve_disk_edge
		(:doc `Use the disk loader's target for this exact source use. An absent row requests a load.`)
		(params (file i32) (edge GraphUse) (edges (shared-array DiskEdge)))
		(returns GraphRead)
		(body
			(let error edge/error)
			(if
				(:doc "A malformed use must never request a file.")
				error.gtz
				(then (return (call graph_read -1i32 edge/start
					edge/end error))))
			(let-mut index 0i32)
			(while
				(:doc "Bind by the importing file and use span, independently of lexical path spelling.")
				(index.lt edges.len)
				(body
					(let target (edges.get index))
					(if
						(:doc "A published disk edge supplies the row of a canonical provider.")
						(bool:and (target/file.eq file)
							(target/start.eq edge/start))
						(then
							(if
								(:doc "A failed disk read is already known. Keep its diagnostic distinct from an unresolved edge.")
								target/error.gtz
								(then (return (GraphRead.new (next -1i32) (start target/error_start)
									(end target/error_end) (error target/error) (file file)))))
							(return (call graph_read target/target 0i32 0i32 0u32))))
					(set index index.inc)))
			(return (call graph_read -1i32 edge/start edge/end 27u32))))

	(fn resolve_graph_edge
		(:doc `Resolve one selected edge using its virtual path or a cached host target.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (source (shared-array u8))
			(file i32) (path i32) (edge GraphUse) (disk bool) (edges (shared-array DiskEdge)))
		(returns GraphRead)
		(body
			(if
				(:doc "Disk targets are keyed by the original use within the importing file.")
				disk
				(then (return (call resolve_disk_edge file edge (borrow-shared edges)))))
			(return (call resolve_edge (borrow-shared arena) (borrow-shared files)
				(borrow-shared source) path edge))))

	(fn disk_request
		(:doc `Keep the unresolved use's full span and the literal range to decode before touching disk.`)
		(params (context SelectionContext) (modules i32) (bindings i32) (file i32) (edge GraphUse))
		(returns GraphResult)
		(body
			(return (GraphResult.new (modules modules) (bindings bindings)
				(mode context/mode) (os context/os) (arch context/arch)
				(deployment context/deployment)
				(file file) (start edge/start) (end edge/end) (error 27u32)
				(path_start edge/path_start) (path_end edge/path_end)))))

	(fn publish_binding
		(:doc `Reserve a file-local alias after either provider has resolved its defining declaration.`)
		(params (source (shared-array u8)) (selector GraphSelector) (importer i32) (target GraphBinding)
			(bindings (mut-array GraphBinding)) (index i32))
		(returns GraphRead)
		(body
			(let start selector/local_start)
			(let end selector/local_end)
			(let namespace target/namespace)
			(if
				(:doc "Validate the local spelling only after resolving the requested definition.")
				(bool:not (selector/local_bare.and
					(call is_c_identifier (borrow-shared source) start end)))
				(then (return (call graph_read index start end 26u32))))
			(let existing (call find_binding
				(borrow-shared source) (borrow-shared source) start end
				(borrow-shared bindings) index importer (bool false) 0i32 namespace))
			(if
				(:doc "A conflict points at the new local spelling.")
				(existing.not-ltz.or
					(bool:and (namespace.eq 1u32)
						(call is_reserved_type_name (borrow-shared source) start end)))
				(then (return (call graph_read index start end 30u32))))
			(if
				(:doc "Check binding capacity before adding the alias.")
				(index.not-lt bindings.len)
				(then (return (call graph_read index start end 16u32))))
			(bindings.set index
				(GraphBinding.new (owner importer) (start start) (end end)
					(file target/file) (declaration target/declaration)
					(namespace namespace) (provider target/provider)
					(header_start target/header_start) (header_end target/header_end)
					(native_start target/native_start) (native_end target/native_end)
					(signature_start target/signature_start) (signature_end target/signature_end)
					(native_type target/native_type)
					(drop_start target/drop_start) (drop_end target/drop_end)
					(type_start target/type_start) (type_end target/type_end)
					(name_node selector/local_node)
					(header_file target/header_file) (bridge_node target/bridge_node)
					(default_file target/default_file) (default_node target/default_node)
					(native_file target/native_file)
					(optional target/optional) (scalar_typedef target/scalar_typedef)
					(requested_start selector/original_start)
					(requested_end selector/original_end) (value_macro target/value_macro) (value_lossless target/value_lossless)
					(null_value target/null_value)
					(extent target/extent) (integer_constant (bool false)) (constant_bits 0u32)
					(prerequisite_start target/prerequisite_start)
					(prerequisite_end target/prerequisite_end)
					(wove_result_layout target/wove_result_layout)))
			(return (call graph_read index.inc 0i32 0i32 0u32))))

	(fn bind_edge
		(:doc `Bind one resolved edge in the importer's namespace using the provider's own declarations.`)
		(params (source (shared-array u8)) (provider_source (shared-array u8))
			(importer i32) (provider i32) (edge GraphUse) (selectors (shared-array GraphSelector))
			(bindings (mut-array GraphBinding)) (offset i32))
		(returns GraphRead)
		(body
			(let-mut count offset)
			(let-mut index edge/first)
			(while
				(:doc "Process selectors left to right so each alias reserves its name for the next.")
				(index.lt edge/limit)
				(body
					(let selector (selectors.get index))
					(let original_start selector/original_start)
					(let original_end selector/original_end)
					(let namespace selector/namespace)
					(let error selector/error)
					(if
						(:doc "Return a cached selector error after the provider and earlier selections succeed.")
						error.gtz
						(then (return (call graph_read count original_start original_end error))))
					(let-mut definition (call find_binding
						(borrow-shared provider_source) (borrow-shared source)
						original_start original_end (borrow-shared bindings)
						count provider (bool true) 0i32 namespace))
					(if
						(:doc "An unqualified selector uses a module value when no defining function matches.")
						(namespace.eqz.and definition.ltz)
						(then (set definition (call find_binding
							(borrow-shared provider_source) (borrow-shared source)
							original_start original_end (borrow-shared bindings)
							count provider (bool true) 0i32 2u32))))
					(if
						(:doc "An unavailable declaration points at its original requested name.")
						definition.ltz
						(then (return (call graph_read count original_start original_end 29u32))))
					(let target (bindings.get definition))
					(let published (call publish_binding (borrow-shared source) selector importer
						target (borrow-mut bindings) count))
					(if
						(:doc "Keep the failed alias at the importing source span.")
						published/error.gtz
						(then (return published)))
					(set count published/next)
					(set index index.inc)))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn c_file_offset
		(:doc "Translate a source offset and retain a missing destructor's negative sentinel.")
		(params (position i32) (base i32)) (returns i32)
		(body
			(if position.ltz (then (return position)))
			(return (position.sub base))))

	(fn c_scope_owner
		(:doc "Find the original file for a row in the temporary provider tree.")
		(params (trees (shared-array CScopeTree)) (row i32))
		(returns i32)
		(body
			(let-mut file 0i32)
			(while
				(:doc "Only loaded tree ranges contain a temporary row.")
				(file.lt trees.len)
				(body
					(let tree (trees.get file))
					(let base tree/base)
					(if
						(:doc "Subtract the base after checking the lower bound.")
						(bool:and (row.not-lt base)
							(i32:lt (row.sub base) tree/rows))
						(then (return file)))
					(set file file.inc)))
			(return -1i32)))

	(fn c_scope_error
		(:doc "Restore a validation error to its physical provider source span.")
		(params (files (shared-array SuppliedFile)) (trees (shared-array CScopeTree)) (primary i32)
			(count i32) (start i32) (end i32) (error u32))
		(returns GraphRead)
		(body
			(let-mut file primary)
			(let-mut index 0i32)
			(while
				(:doc "Check source ranges of the loaded trees, including dependency providers.")
				(index.lt trees.len)
				(body
					(if
						(:doc "Unloaded supplied files do not define a selected diagnostic.")
						(i32:gtz (struct:get (trees.get index) rows))
						(then
							(let input (files.get index))
							(if
								(:doc "Use the original backing byte range of that file.")
								(bool:and (start.not-lt input/source_start)
									(start.lt input/source_end))
								(then
									(set file index)
									(set index trees.len)))))
					(set index index.inc)))
			(let base (struct:get (files.get file) source_start))
			(return (GraphRead.new (next count) (start (start.sub base))
				(end (end.sub base)) (error error) (file file)))))

	(fn bind_c_members
		(:doc `Bind each selected C member to its original declaration and checked native contract.`)
		(params (source (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(importer i32) (header HeaderMatch) (trees (shared-array CScopeTree)) (edge GraphUse) (selectors (shared-array GraphSelector))
			(bindings (mut-array GraphBinding)) (prerequisite_start i32) (offset i32) (context SelectionContext))
		(returns GraphRead)
		(body
			(let-mut count offset)
			(let-mut index edge/first)
			(while
				(:doc "Select and publish each local name in source order.")
				(index.lt edge/limit)
				(body
					(let selector (selectors.get index))
					(let start selector/original_start)
					(let end selector/original_end)
					(let error selector/error)
					(if
						(:doc "A malformed selector keeps its cached importing span.")
						error.gtz
						(then (return (call graph_read count start end error))))
					(let member (call find_c_declaration (borrow-shared arena) (borrow-shared nodes)
						header/node (borrow-shared source) start end
						selector/namespace context))
					(let namespace member/namespace)
					(let rejected member/error)
					(if
						(:doc "A rejected C member belongs to the declaring Wove file.")
						rejected.gtz
						(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
								header/file count
							member/start member/end rejected))))
					(let declaration member/declaration)
					(if
						(:doc "A missing C member points at the original requested spelling.")
						declaration.ltz
						(then (return (call graph_read count start end 29u32))))
					(let file (call c_scope_owner (borrow-shared trees) declaration))
					(let base (struct:get (files.get file) source_start))
					(let row_base (struct:get (trees.get file) base))
					(let type member/native_type)
					(let-mut native_file -1i32)
					(let-mut native_row 0i32)
					(let-mut native_base 0i32)
					(if
						(:doc "An inherited type retains its own defining file and node.")
						type.gtz
						(then
							(set native_file (call c_scope_owner (borrow-shared trees) type))
							(set native_row (type.sub
								(struct:get (trees.get native_file) base)))
							(set native_base (struct:get (files.get native_file) source_start))))
					(let target (GraphBinding.new (owner importer) (start -1i32) (end -1i32)
						(file file) (declaration (declaration.sub row_base))
						(namespace namespace) (provider 8u32)
						(header_start header/start) (header_end header/end)
						(native_start (member/native_start.sub base))
						(native_end (member/native_end.sub base))
						(signature_start (member/signature_start.sub base))
						(signature_end (member/signature_end.sub base))
						(native_type native_row)
						(drop_start (call c_file_offset member/drop_start native_base))
						(drop_end (call c_file_offset member/drop_end native_base))
						(type_start (member/type_start.sub native_base))
						(type_end (member/type_end.sub native_base))
						(name_node -1i32) (header_file header/file) (bridge_node header/node)
						(default_file header/default_file) (default_node header/default_node)
						(native_file native_file) (optional member/optional) (scalar_typedef member/scalar_typedef)
						(requested_start -1i32) (requested_end -1i32) (value_macro member/value_macro) (value_lossless member/value_lossless)
						(null_value member/null_value) (extent -1i32) (integer_constant (bool false)) (constant_bits 0u32)
						(prerequisite_start prerequisite_start) (prerequisite_end offset)
						(wove_result_layout member/wove_result_layout)))
					(let published (call publish_binding (borrow-shared source) selector importer
						target (borrow-mut bindings) count))
					(if
						(:doc "An alias conflict or short destination belongs to the importing file.")
						published/error.gtz
						(then (return published)))
					(set count published/next)
					(set index index.inc)))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn resolve_c_header_operation
		(:doc "Validate a declared project key or resolve a C header use before checking its members.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (source (shared-array u8)) (importer i32)
			(edge GraphUse) (selectors (shared-array GraphSelector)) (bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext))
		(returns GraphRead)
		(body
			(let start edge/path_start)
			(let end edge/path_end)
			(let-mut decoded (array:alloc u8 (end.sub start)))
			(let key (call decode_string (borrow-shared source)
				(Token.new (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(if
				(:doc "A malformed use key retains its exact escaped input span.")
				key/error.gtz
				(then (return (call graph_read offset key/start
					key/end key/error))))
			(if
				(:doc "Check project declarations with the same target-aware lookup used for imports.")
				(edge/provider.eq 9u32)
				(then
					(let header (call find_header_kind (borrow-shared arena) (borrow-shared files)
						(borrow-shared (decoded.range 0i32 key/written)) context (bool false)))
					(return (GraphRead.new (next offset) (start header/start)
						(end header/end) (error header/error)
						(file header/file)))))
			(let header (call find_c_header (borrow-shared arena) (borrow-shared files)
				(borrow-shared (decoded.range 0i32 key/written)) context))
			(let provider header/file)
			(let error header/error)
			(if
				(:doc "Discovery errors retain their defining file and original span.")
				error.gtz
				(then (return (GraphRead.new (next offset) (start header/start)
					(end header/end) (error error) (file provider)))))
			(if
				(:doc "A missing bridge is diagnosed at the original importing use.")
				provider.ltz
				(then (return (call graph_read offset edge/start edge/end 27u32))))
			(if
				(:doc "A module-level empty selection validates its provider without activating its bridge.")
				(edge/first.eq edge/limit)
				(then (return (call graph_read offset 0i32 0i32 0u32))))
			(let-mut visiting (array:alloc CScopeVisit bindings.len))
			(return (call bind_c_header_scope (borrow-shared arena) (borrow-shared files) (borrow-shared source)
				importer header edge (borrow-shared selectors) (borrow-mut bindings)
				offset context (borrow-mut visiting) 0i32))))

	(fn pending_c_layout_provider
		(:doc "An owning bridge result brings its defining module into the ordinary graph privately.")
		(params (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (shared-array GraphBinding)) (first i32) (end i32))
		(returns i32)
		(body
			(let-mut index first)
			(while
				(:doc "Consider only the bindings from this C-header operation.")
				(index.lt end)
				(body
					(let binding (bindings.get index))
					(if
						(:doc "Record snapshots have an ordinary Wove result layout in the defining module.")
						binding/wove_result_layout
						(then
							(let path binding/file)
							(let identity (struct:get (files.get path) identity))
							(if
								(:doc "Already reached modules have their own ordinary declarations and imports.")
								(u32:eqz (struct:get (modules.get identity) state))
								(then (return path)))))
					(set index index.inc)))
			(return -1i32)))

	(fn measure_c_tree
		(:doc "Measure the selected provider's checked source view before reserving temporary nodes.")
		(params (arena (shared-array u8)) (input SuppliedFile)) (returns FormCheck)
		(body (return (call check_source_form
			(borrow-shared (arena.range input/source_start input/source_end))))))

	(fn copy_c_tree
		(:doc "Build the validated original tree and copy it with graph arena spans.")
		(params (view (shared-array u8)) (checked FormCheck) (base i32) (source_base i32) (flat (mut-array SourceNode)))
		(returns FormCheck)
		(body
			(let-mut nodes (array:alloc SourceNode (i32:from-u32 (call semantic_tree_rows checked))))
			(let built (call build_semantic_tree (borrow-shared view) checked (borrow-mut nodes)))
			(if
				(:doc "Copy only complete source trees.")
				built/error.eqz
				(then (call copy_tree (borrow-shared nodes) (borrow-mut flat) base source_base)))
			(return built)))

	(fn extend_c_scope_tree
		(:doc "Reserve one checked provider tree the first time a dependency needs that file.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(trees (mut-array CScopeTree)) (file i32) (next i32))
		(returns i32)
		(body
			(if
				(:doc "Missing overlays and already loaded files occupy no additional rows.")
				(file.ltz.or (i32:gtz (struct:get (trees.get file) rows)))
				(then (return next)))
			(let size (call measure_c_tree (borrow-shared arena) (files.get file)))
			(let rows (i32:from-u32 (call semantic_tree_rows size)))
			(if
				(:doc "The flattened tree must fit in the signed row domain.")
				(rows.ltz.or (i32:lt (i32:sub 2147483647i32 next) rows))
				(then (return -1i32)))
			(trees.set file (CScopeTree.new (base next) (rows rows)))
			(return (next.add rows))))

	(fn write_c_dependency
		(:doc "Publish a private type link and an include span when C needs its header.")
		(params (files (shared-array SuppliedFile)) (trees (shared-array CScopeTree)) (use BridgeUse)
			(selector i32) (definition i32) (include bool) (bindings (mut-array GraphBinding)) (count i32))
		(returns GraphRead)
		(body
			(let owner use/owner)
			(let input (files.get owner))
			(let source input/source_start)
			(let start (use/start.sub source))
			(let end (use/end.sub source))
			(if
				(:doc "A private dependency consumes one checked table slot.")
				(count.not-lt bindings.len)
				(then (return (GraphRead.new (next count) (start start)
					(end end) (error 16u32) (file owner)))))
			(let-mut header_start start)
			(let-mut header_end end)
			(let-mut native_file -1i32)
			(let-mut native_type 0i32)
			(let-mut node -1i32)
			(if
				(:doc "A present provider supplies the canonical include literal, even for an empty selection.")
				use/node.not-ltz
				(then
					(set header_start use/header_start)
					(set header_end use/header_end)))
			(if
				(:doc "An intrinsic type is spelled directly in C, without its defining header.")
				include.not
				(then
					(set header_start -1i32)
					(set header_end -1i32)))
			(if
				(:doc "A type selector points to its canonical definition even when the target is an overlay.")
				selector.not-ltz
				(then
					(set native_file (call c_scope_owner (borrow-shared trees) definition))
					(set native_type (definition.sub
						(struct:get (trees.get native_file) base)))
					(set node (selector.sub (struct:get (trees.get owner) base)))))
			(bindings.set count (GraphBinding.new
				(owner owner) (start -1i32) (end -1i32) (file native_file) (declaration node)
				(namespace 3u32) (provider c_dependency_provider)
				(header_start header_start) (header_end header_end)
				(native_start -1i32) (native_end -1i32) (signature_start -1i32) (signature_end -1i32)
				(native_type native_type) (drop_start -1i32) (drop_end -1i32)
				(type_start -1i32) (type_end -1i32) (name_node -1i32)
				(header_file use/file) (bridge_node use/node)
				(default_file use/default_file) (default_node use/default_node)
				(native_file native_file) (optional (bool false)) (scalar_typedef (bool false))
				(requested_start -1i32) (requested_end -1i32) (value_macro (bool false)) (value_lossless (bool false)) (null_value (bool false)) (extent -1i32) (integer_constant (bool false)) (constant_bits 0u32)
				(prerequisite_start 0i32) (prerequisite_end 0i32) (wove_result_layout (bool false))))
			(return (call graph_read count.inc 0i32 0i32 0u32))))

	(fn c_scope_visiting
		(:doc "Detect a cycle by header declaration identity, including several bridges in the same file.")
		(params (visiting (shared-array CScopeVisit)) (depth i32) (file i32) (node i32))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only scopes on the current dependency path can form a cycle.")
				(index.lt depth)
				(body
					(let visit (visiting.get index))
					(if
						(:doc "Both the defining file and original bridge row identify a scope.")
						(bool:and (visit/file.eq file)
							(visit/node.eq node))
						(then (return (bool true))))
					(set index index.inc)))
			(return (bool false))))

	(fn bind_c_provider_prerequisites
		(:doc "Resolve the defining provider's own prerequisites before emitting its include.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (trees (shared-array CScopeTree))
			(use BridgeUse) (bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext)
			(visiting (mut-array CScopeVisit)) (depth i32))
		(returns GraphRead)
		(body
			(let owner use/owner)
			(let file use/file)
			(let node use/node)
			(if
				(:doc "An include-only request can name a header with no Wove provider.")
				node.ltz
				(then (return (call graph_read offset 0i32 0i32 0u32))))
			(if
				(:doc "Header prerequisites cannot require their own active consumer ahead of themselves.")
				(call c_scope_visiting (borrow-shared visiting) depth file node)
				(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
					owner offset use/start use/end 28u32))))
			(let header (HeaderMatch.new (file file) (node node)
				(start use/header_start) (end use/header_end)
				(error 0u32) (default_file use/default_file) (default_node use/default_node)
				(replace (bool false))))
			(let base (struct:get (files.get owner) source_start))
			(let start (use/start.sub base))
			(let end (use/end.sub base))
			(if
				(:doc "Each active include needs a future binding slot, so graph capacity bounds dependency depth.")
				(depth.not-lt visiting.len)
				(then (return (GraphRead.new (next offset) (start start)
					(end end) (error 16u32) (file owner)))))
			(let edge (GraphUse.new (start start) (end end) (path_start start) (path_end end)
				(first 0i32) (limit 0i32) (error 0u32) (provider 8u32)))
			(let selectors (array:alloc GraphSelector 0i32))
			(return (call bind_c_header_scope (borrow-shared arena) (borrow-shared files) (borrow-shared arena)
				owner header edge (borrow-shared selectors) (borrow-mut bindings)
				offset context (borrow-mut visiting) depth))))

	(fn bind_c_dependencies
		(:doc "Resolve bridge-local type selectors and record their ordered includes before public C bindings.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (trees (shared-array CScopeTree))
			(uses (shared-array BridgeUse)) (length i32) (nodes (mut-array SourceNode))
			(bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext)
			(visiting (mut-array CScopeVisit)) (depth i32))
		(returns GraphRead)
		(body
			(let-mut count offset)
			(let-mut index 0i32)
			(while
				(:doc "Retain the original order of includes declared in the selected bridge.")
				(index.lt length)
				(body
					(let use (uses.get index))
					(let owner use/owner)
					(let-mut row use/first)
					(let-mut included (bool false))
					(if
						(:doc "An empty only list requests the header and its prerequisites without importing a name.")
						row.ltz
						(then
							(let required (call bind_c_provider_prerequisites (borrow-shared arena) (borrow-shared files)
								(borrow-shared trees) use (borrow-mut bindings) count context
								(borrow-mut visiting) depth))
							(if required/error.gtz (then (return required)))
							(set count required/next)
							(let saved (call write_c_dependency (borrow-shared files) (borrow-shared trees)
								use -1i32 -1i32 (bool true) (borrow-mut bindings) count))
							(if saved/error.gtz (then (return saved)))
							(set count saved/next)))
					(while
						(:doc "Resolve each explicitly named type in the dependency's target provider.")
						row.not-ltz
						(body
							(let selector (call read_selector (borrow-shared arena) (borrow-shared nodes) row))
							(if
								(:doc "Bridge-local dependencies select only native types.")
								(selector/error.gtz.or (selector/namespace.not-eq 1u32))
								(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
									owner count selector/start selector/end 26u32))))
							(let name (nodes.get selector/first))
							(let start name/start)
							(let end name/end)
							(let base (struct:get (trees.get use/file) base))
							(let found (call find_c_declaration (borrow-shared arena) (borrow-shared nodes)
								(base.add use/node) (borrow-shared arena)
								start end 1u32 context))
							(if
								(:doc "Errors inside the native type contract keep the provider's original location.")
								found/error.gtz
								(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
									owner count found/start found/end
									found/error))))
							(let definition found/declaration)
							(if
								(:doc "A missing requested type is diagnosed in the explicit dependency declaration.")
								definition.ltz
								(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
									owner count start end 29u32))))
							(let local_name (nodes.get selector/second))
							(let local_start local_name/start)
							(let local_end local_name/end)
							(if
								(:doc "The local type spelling must be a bare identifier just as in a module use.")
								(bool:not (call is_import_name (borrow-shared arena) local_name))
								(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
									owner count local_start local_end 26u32))))
							(if
								(:doc "A private type alias cannot shadow an intrinsic type name.")
								(call is_reserved_type_name (borrow-shared arena) local_start local_end)
								(then (return (call c_scope_error (borrow-shared files) (borrow-shared trees)
									owner count local_start local_end 30u32))))
							(call connect_bridge_type (borrow-mut nodes) row definition)
							(let intrinsic (found/drop_start.ltz.and
								(bool:and
									(bool:not (call is_c_record (borrow-shared arena) (borrow-shared nodes)
										(nodes.get definition)))
									(call is_c_long_double (borrow-shared arena)
										found/type_start found/type_end))))
							(if
								(:doc "Resolve the header's prerequisites before the first selector that needs a C include.")
								(intrinsic.not.and included.not)
								(then
									(let required (call bind_c_provider_prerequisites (borrow-shared arena) (borrow-shared files)
										(borrow-shared trees) use (borrow-mut bindings) count context
										(borrow-mut visiting) depth))
									(if required/error.gtz (then (return required)))
									(set count required/next)
									(set included (bool true))))
							(let saved (call write_c_dependency (borrow-shared files) (borrow-shared trees)
								use row definition intrinsic.not
								(borrow-mut bindings) count))
							(if saved/error.gtz (then (return saved)))
							(set count saved/next)
							(set row (struct:get (nodes.get row) next_sibling))))
					(set index index.inc)))
			(return (call graph_read count 0i32 0i32 0u32))))

	(fn bind_c_extended_scope
		(:doc "Load dependency trees, restore overlays, and bind private names before checking public members.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (source (shared-array u8)) (importer i32)
			(header HeaderMatch) (edge GraphUse) (selectors (shared-array GraphSelector))
			(original (shared-array SourceNode)) (uses (shared-array BridgeUse)) (length i32) (trees (mut-array CScopeTree))
			(bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext)
			(visiting (mut-array CScopeVisit)) (depth i32))
		(returns GraphRead)
		(body
			(let-mut next original.len)
			(let-mut index 0i32)
			(while
				(:doc "Reserve each referenced primary and bundled tree once.")
				(index.lt length)
				(body
					(let match (uses.get index))
					(set next (call extend_c_scope_tree (borrow-shared arena) (borrow-shared files)
						(borrow-mut trees) match/file next))
					(if next.not-ltz
						(then (set next (call extend_c_scope_tree (borrow-shared arena) (borrow-shared files)
							(borrow-mut trees) match/default_file next))))
					(if
						(:doc "Report capacity at the original import before allocating the combined tree.")
						next.ltz
						(then (return (call graph_read offset edge/start edge/end 16u32))))
					(set index index.inc)))
			(let-mut nodes (array:alloc SourceNode next))
			(set index 0i32)
			(while
				(:doc "Retain the selected provider's original rows and overlay links.")
				(index.lt original.len)
				(body
					(nodes.set index (original.get index))
					(set index index.inc)))
			(set index 0i32)
			(while
				(:doc "Build the additional providers in the preassigned row ranges.")
				(index.lt trees.len)
				(body
					(let tree (trees.get index))
					(let base tree/base)
					(if
						(:doc "The original providers are already present. Unused files have an empty range.")
						(base.not-lt original.len)
						(then
							(let file (files.get index))
							(let checked (call measure_c_tree (borrow-shared arena) file))
							(let built (call copy_c_tree (borrow-shared (arena.range
									file/source_start file/source_end))
								checked base file/source_start (borrow-mut nodes)))
							(if
								(:doc "A new provider parse error names the provider file.")
								built/error.gtz
								(then (return (GraphRead.new (next offset) (start built/start)
									(end built/end) (error built/error) (file index)))))))
					(set index index.inc)))
			(set index 0i32)
			(while
				(:doc "Connect each dependency's project and bundled scopes before looking up its public types.")
				(index.lt length)
				(body
					(let match (uses.get index))
					(let fallback match/default_file)
					(if
						(:doc "Single-provider dependencies require no scope overlay.")
						fallback.not-ltz
						(then
							(let base (struct:get (trees.get match/file) base))
							(let bundled (struct:get (trees.get fallback) base))
							(call connect_bridge_overlay (borrow-mut nodes)
								(base.add match/node)
								(bundled.add match/default_node))))
					(set index index.inc)))
			(let read (call bind_c_dependencies (borrow-shared arena) (borrow-shared files)
				(borrow-shared trees) (borrow-shared uses) length (borrow-mut nodes)
				(borrow-mut bindings) offset context (borrow-mut visiting) depth))
			(if read/error.gtz (then (return read)))
			(return (call bind_c_members (borrow-shared source) (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) importer header (borrow-shared trees) edge
				(borrow-shared selectors) (borrow-mut bindings) offset
				read/next context))))

	(fn bind_c_header_scope
		(:doc "Build a temporary tree for each provider in the namespace and keep their original offsets.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (source (shared-array u8)) (importer i32)
			(header HeaderMatch) (edge GraphUse) (selectors (shared-array GraphSelector))
			(bindings (mut-array GraphBinding)) (offset i32) (context SelectionContext)
			(visiting (mut-array CScopeVisit)) (depth i32))
		(returns GraphRead)
		(body
			(let primary (files.get header/file))
			(let checked (call measure_c_tree (borrow-shared arena) primary))
			(let rows (i32:from-u32 (call semantic_tree_rows checked)))
			(let fallback header/default_file)
			(let-mut extra 0i32)
			(if
				(:doc "Only an extending project header contributes bundled fallback rows.")
				(i32:lt -1i32 fallback)
				(then
					(let size (call measure_c_tree (borrow-shared arena) (files.get fallback)))
					(set extra (i32:from-u32 (call semantic_tree_rows size)))))
			(if
				(:doc "Keep both provider trees within signed row indices.")
				(i32:lt (i32:sub 2147483647i32 rows) extra)
				(then (return (call graph_read offset edge/start edge/end 16u32))))
			(let-mut flat (array:alloc SourceNode (rows.add extra)))
			(let built (call copy_c_tree
				(borrow-shared (arena.range primary/source_start primary/source_end))
				checked 0i32 primary/source_start (borrow-mut flat)))
			(if
				(:doc "Keep the original source span if building the checked primary tree fails.")
				built/error.gtz
				(then (return (GraphRead.new (next offset) (start built/start)
					(end built/end) (error built/error) (file header/file)))))
			(if
				(:doc "Both original scopes get the same lookup order without changing their member links.")
				(i32:lt -1i32 fallback)
				(then
					(let bundled (files.get fallback))
					(let bundled_checked (call measure_c_tree (borrow-shared arena) bundled))
					(let inherited (call copy_c_tree
						(borrow-shared (arena.range bundled/source_start bundled/source_end))
						bundled_checked rows bundled/source_start (borrow-mut flat)))
					(if
						(:doc "Bundled tree errors retain the bundled source location.")
						inherited/error.gtz
						(then (return (GraphRead.new (next offset) (start inherited/start)
							(end inherited/end) (error inherited/error) (file fallback)))))
					(call connect_bridge_overlay (borrow-mut flat) header/node
						(rows.add header/default_node))))
			(let-mut trees (array:alloc CScopeTree files.len))
			(trees.set header/file (CScopeTree.new (base 0i32) (rows rows)))
			(let-mut fallback_row -1i32)
			(if
				(:doc "The fallback scope follows the primary tree when an overlay is active.")
				fallback.not-ltz
				(then
					(trees.set fallback (CScopeTree.new (base rows) (rows extra)))
					(set fallback_row (rows.add header/default_node))))
			(let capacity (i32:add
				(call count_bridge_uses (borrow-shared arena) (borrow-shared flat) header/node)
				(call count_bridge_uses (borrow-shared arena) (borrow-shared flat) fallback_row)))
			(let-mut uses (array:alloc BridgeUse capacity))
			(let plan (call scoped_uses (borrow-shared arena) (borrow-shared files) (borrow-shared flat)
				header fallback_row context (borrow-mut uses)))
			(if
				(:doc "Preserve dependency lookup errors at their own source locations.")
				plan/error.gtz
				(then
					(let file plan/file)
					(let base (struct:get (files.get file) source_start))
					(return (GraphRead.new (next offset)
						(start (plan/start.sub base))
						(end (plan/end.sub base))
						(error plan/error) (file file)))))
			(if
				(:doc "Most C selections have no bridge-local dependency tree.")
				plan/count.gtz
				(then
					(if
						(:doc "Keep the active path inside the same capacity bound as its eventual bindings.")
						(depth.not-lt visiting.len)
						(then (return (call graph_read offset edge/start edge/end 16u32))))
					(visiting.set depth (CScopeVisit.new
						(file header/file) (node header/node)))
					(return (call bind_c_extended_scope (borrow-shared arena) (borrow-shared files)
						(borrow-shared source) importer header edge (borrow-shared selectors)
						(borrow-shared flat) (borrow-shared uses) plan/count (borrow-mut trees)
						(borrow-mut bindings) offset context
						(borrow-mut visiting) depth.inc))))
			(return (call bind_c_members (borrow-shared source) (borrow-shared arena) (borrow-shared files)
				(borrow-shared flat) importer header (borrow-shared trees) edge
				(borrow-shared selectors) (borrow-mut bindings) offset offset context))))

	(fn store_frame
		(:doc `Store the next traversal operation without changing the file's discovery data.`)
		(params (modules (mut-array GraphModule)) (file i32) (frame GraphModule) (state u32) (next i32) (failed bool))
		(returns void)
		(body
			(modules.set file
				(GraphModule.new (state state)
					(path frame/path) (order frame/order)
					(parent frame/parent) (next_use next)
					(end_use frame/end_use) (active frame/active)
					(failed failed)))))

	(fn update_frame
		(:doc "Advance a suspended frame and retain its failed-dependency state.")
		(params (modules (mut-array GraphModule)) (file i32) (state u32) (next i32))
		(returns void)
		(body
			(let frame (modules.get file))
			(call store_frame (borrow-mut modules) file frame state next
				frame/failed)))

	(fn fail_graph_file
		(:doc "Make this file unavailable to dependents while retaining its remaining independent edges.")
		(params (modules (mut-array GraphModule)) (file i32) (next i32))
		(returns void)
		(body
			(let frame (modules.get file))
			(call store_frame (borrow-mut modules) file frame
				frame/state next (bool true))))

	(fn graph_recoverable
		(:doc "Distinguish a checkpointed diagnostic from a disk request or fatal graph error.")
		(params (result GraphResult)) (returns bool)
		(body (return (result/path_start.eq -2i32))))

	(fn recovered_graph_error
		(:doc "Publish one primary diagnostic after advancing past its failed input.")
		(params (context SelectionContext) (modules i32) (bindings i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphResult)
		(body (return (GraphResult.new (modules modules) (bindings bindings) (file file)
			(start start) (end end) (error error) (mode context/mode)
			(os context/os) (arch context/arch)
			(deployment context/deployment) (path_start -2i32) (path_end -1i32)))))

	(fn resolve_graph
		(:doc `Resolve a source graph for a caller that supplies only the compilation mode.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (entry i32) (mode u32)
			(modules (mut-array GraphModule)) (bindings (mut-array GraphBinding))
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)))
		(returns GraphResult)
		(body (return (call resolve_graph_for_target (borrow-shared arena) (borrow-shared files)
			entry (call default_selection mode) (borrow-mut modules) (borrow-mut bindings)
			(borrow-mut uses) (borrow-mut selectors)))))

	(fn resolve_graph_for_target
		(:doc `Resolve a virtual graph using the lexical paths supplied by its caller.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (entry i32) (context SelectionContext)
			(modules (mut-array GraphModule)) (bindings (mut-array GraphBinding))
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)))
		(returns GraphResult)
		(body
			(let edges (array:alloc DiskEdge 0i32))
			(let-mut progress (array:alloc GraphProgress 1i32))
			(return (call walk_graph (borrow-shared arena) (borrow-shared files) entry context
				(borrow-mut modules) (borrow-mut bindings) (borrow-mut uses)
				(borrow-mut selectors) (bool false) (bool false) (bool false) (borrow-shared edges)
				(borrow-mut progress)))))

	(fn resolve_disk_graph
		(:doc `Continue the depth-first disk walk or request the first active use with no cached target.

		The caller keeps the progress cell and initialized rows across requests and
		workspace growth, appending files and edges without changing older rows.
		Once every Wove edge is known, a header-aware walk publishes the final
		bindings in their original order. A nonnegative path_start marks a request
		and the diagnostic span covers the complete importing use. In recovery
		mode a checkpointed diagnostic resumes after the failed operation.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (entry i32) (context SelectionContext)
			(modules (mut-array GraphModule)) (bindings (mut-array GraphBinding))
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)) (edges (shared-array DiskEdge))
			(progress (mut-array GraphProgress)) (recover bool))
		(returns GraphResult)
		(body
			(if
				(:doc "Resolve Wove imports before validating C header operations against the complete file table.")
				(bool:not (struct:get (progress.get 0i32) binding))
				(then
					(let loaded (call walk_graph (borrow-shared arena) (borrow-shared files) entry context
						(borrow-mut modules) (borrow-mut bindings) (borrow-mut uses)
						(borrow-mut selectors) (bool true) (bool true) recover (borrow-shared edges)
						(borrow-mut progress)))
					(if
						(:doc "The resolver can resume after the driver appends the requested edge or reserves space.")
						loaded/error.gtz
						(then (return loaded)))
					(call save_graph_progress (borrow-mut progress) 0i32 (bool true) 0i32 -1i32 -1i32
						0i32 0i32 0i32 0i32)))
			(return (call walk_graph (borrow-shared arena) (borrow-shared files) entry context
				(borrow-mut modules) (borrow-mut bindings) (borrow-mut uses)
				(borrow-mut selectors) (bool true) (bool false) recover (borrow-shared edges)
				(borrow-mut progress)))))

	(fn save_graph_progress
		(:doc "Checkpoint table prefixes and the current operation so a short attempt can be retried in place.")
		(params (progress (mut-array GraphProgress)) (files i32) (binding bool) (current i32)
			(pending_path i32) (pending_parent i32) (modules i32) (bindings i32) (uses i32) (selectors i32))
		(returns void)
		(body
			(progress.set 0i32 (GraphProgress.new (files files) (binding binding)
				(current current) (pending_path pending_path) (pending_parent pending_parent)
				(modules modules) (bindings bindings) (uses uses) (selectors selectors)))))

	(fn finish_edge_error
		(:doc "Leave a failed selection behind in check mode. Capacity and ordinary builds retain fail-fast behavior.")
		(params (context SelectionContext) (recover bool) (error u32) (file i32) (start i32) (end i32)
			(importer i32) (next i32) (length i32) (binding bool) (reached i32) (prefix i32) (partial i32)
			(uses i32) (selectors i32) (modules (mut-array GraphModule)) (progress (mut-array GraphProgress)))
		(returns GraphResult)
		(body
			(if
				(:doc "Keep only bindings that were complete before the failed edge.")
				(recover.and (error.not-eq 16u32))
				(then
					(call fail_graph_file (borrow-mut modules) importer next)
					(call save_graph_progress (borrow-mut progress) length binding importer
						-1i32 -1i32 reached prefix uses selectors)
					(return (call recovered_graph_error context reached prefix file
						start end error))))
			(return (call graph_result context reached partial file
				start end error))))

	(fn walk_graph
		(:doc `Resolve the reachable graph and publish file-local function bindings.

		Entry is a supplied path row. The module table has room for every supplied
		row and is indexed by canonical identity. States are unseen (0), visiting
		(1), and complete (2). Rows report the first reached path and discovery
		order. A failed frame still keeps its identity and remaining edge cursor.
		Binding names are byte spans in the owner's view. Their targets
		are a defining identity and the declaration's node index in that file's
		checked tree. Provider kind 3 identifies Wove definitions. Kind 8 identifies
		C targets with original member, header, and native type identities. Those
		components can come from different files in an overlaid header.
		Keep the selection context in the result so graph consumers reuse the same selection.
		Error spans are byte offsets in the named diagnostic file.
		On failure, the counts report reached modules and the initialized binding prefix.`)
		(:expect
			(tests "stage-2/source_graphs.tsv" "stage-2/graph/targets/cases.tsv")
			(issues "gh:wove-lang/wove:68" "gh:wove-lang/wove:138" "gh:wove-lang/wove:146" "gh:wove-lang/wove:190" "gh:wove-lang/wove:227"))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (entry i32) (context SelectionContext)
			(modules (mut-array GraphModule)) (bindings (mut-array GraphBinding))
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector)) (disk bool) (loading bool) (recover bool)
			(edges (shared-array DiskEdge)) (progress (mut-array GraphProgress)))
		(returns GraphResult)
		(body
			(let length files.len)
			(if
				(:doc "The entry must name a supplied path row.")
				(entry.ltz.or (entry.not-lt length))
				(then (return (call graph_result context 0i32 0i32 -1i32 0i32 0i32 27u32))))
			(if
				(:doc "Preflight module storage before clearing any state.")
				(modules.len.lt length)
				(then (return (call graph_result context 0i32 0i32 -1i32 0i32 0i32 16u32))))
			(let saved (progress.get 0i32))
			(let initialized saved/files)
			(let-mut index initialized)
			(while
				(:doc "Clear new identities while keeping the previously reached frames and providers.")
				(index.lt length)
				(body
					(modules.set index
						(GraphModule.new (state 0u32) (path -1i32) (order -1i32)
							(parent -1i32) (next_use 0i32) (end_use 0i32) (active (bool false)) (failed (bool false))))
					(set index index.inc)))
			(let-mut module_count saved/modules)
			(let-mut binding_count saved/bindings)
			(let-mut use_count saved/uses)
			(let-mut selector_count saved/selectors)
			(let root (struct:get (files.get entry) identity))
			(let-mut current saved/current)
			(let-mut pending_path saved/pending_path)
			(let-mut pending_parent saved/pending_parent)
			(let binding loading.not)
			(if
				(:doc "A fresh walk starts by reading the entry under its canonical identity.")
				initialized.eqz
				(then
					(set current root)
					(set pending_path entry)
					(set pending_parent -1i32)))
			(while
				(:doc "Parent links suspend importers while an unseen provider is being resolved.")
				current.not-ltz
				(body
					(let file (files.get current))
					(let source_start file/source_start)
					(let source_end file/source_end)
					(if
						(:doc "Parse an identity only when the first active edge reaches it.")
						pending_path.not-ltz
						(then
							(let loaded (call read_graph_file
								(borrow-shared (arena.range source_start source_end))
								current context
								(bool:not (loading.or file/bundled))
								(borrow-mut bindings) (borrow-mut uses)
								(borrow-mut selectors) binding_count use_count selector_count))
							(let error loaded/error)
							(if
								(:doc "Keep the last complete table prefixes when an operation needs more space.")
								(error.eq 16u32)
								(then (call save_graph_progress (borrow-mut progress) length binding current
									pending_path pending_parent module_count binding_count
									use_count selector_count)))
							(if
								(:doc "An invalid provider becomes a completed failed identity, without publishing partial names.")
								error.gtz
								(then
									(if
										(:doc "A check can resume at the failed frame's parent without requesting the same file again.")
										(recover.and (error.not-eq 16u32))
										(then
											(modules.set current
												(GraphModule.new (state 2u32) (path pending_path) (order module_count)
													(parent pending_parent) (next_use use_count) (end_use use_count)
													(active (bool false)) (failed (bool true))))
											(let reached module_count.inc)
											(call save_graph_progress (borrow-mut progress) length binding current
												-1i32 pending_parent reached binding_count use_count selector_count)
											(return (call recovered_graph_error context reached binding_count current
												loaded/start loaded/end error))))
									(return (call graph_result context module_count loaded/bindings
										current loaded/start loaded/end error))))
							(set binding_count loaded/bindings)
							(let active loaded/active)
							(if
								(:doc "An excluded provider exposes zero names, but the entry must be selected.")
								(bool:and (current.eq root) active.not)
								(then (return (call graph_result context module_count binding_count current
									loaded/start loaded/end 31u32))))
							(let end_use loaded/uses)
							(modules.set current
								(GraphModule.new (state 1u32) (path pending_path) (order module_count)
									(parent pending_parent) (next_use use_count) (end_use end_use) (active active) (failed (bool false))))
							(set module_count module_count.inc)
							(set use_count end_use)
							(set selector_count loaded/selectors)
							(set pending_path -1i32)))
					(let frame (modules.get current))
					(let next frame/next_use)
					(let-mut importer current)
					(let-mut provider -1i32)
					(let-mut edge_index next)
					(let exhausted (next.eq frame/end_use))
					(if
						(:doc "An exhausted frame binds the edge that first reached it before resuming its parent.")
						exhausted
						(then
							(set importer frame/parent)
							(set provider current)
							(if
								(:doc "The parent's cursor already advanced past the pending edge.")
								importer.not-ltz
								(then
									(set edge_index (i32:dec
										(struct:get (modules.get importer) next_use))))))
						(else
							(let edge (uses.get next))
							(if
								(:doc "Resolve native declarations and activate any ordinary layout their selected results require.")
								(bool:or (edge/provider.eq 8u32)
									(edge/provider.eq 9u32))
								(then
									(let-mut layout_provider -1i32)
									(if
										(:doc "A header declaration can live in a file reached by a later Wove edge.")
										(loading.not.and frame/failed.not)
										(then
											(let bound (call resolve_c_header_operation (borrow-shared arena) (borrow-shared files)
												(borrow-shared (arena.range source_start source_end))
												current edge (borrow-shared selectors)
												(borrow-mut bindings) binding_count context))
											(let error bound/error)
											(if
												(:doc "Keep the last complete table prefixes when an operation needs more space.")
												(error.eq 16u32)
												(then (call save_graph_progress (borrow-mut progress) length binding current
													pending_path pending_parent module_count binding_count
													use_count selector_count)))
											(if
												(:doc "Use the provider file for a defining error and the importer for a selection error.")
												error.gtz
												(then
													(let-mut file bound/file)
													(if
														(:doc "A selection error has no separate defining file.")
														file.ltz
														(then (set file current)))
													(return (call finish_edge_error context recover error
														file bound/start bound/end
														current next.inc
														length binding module_count binding_count
														bound/next use_count selector_count
														(borrow-mut modules) (borrow-mut progress)))))
											(let end bound/next)
											(set layout_provider (call pending_c_layout_provider (borrow-shared files)
												(borrow-shared modules) (borrow-shared bindings) binding_count end))
											(if
												(:doc "Publish the C selectors only after their layout modules have been reached.")
												layout_provider.ltz
												(then (set binding_count end)))))
									(call update_frame (borrow-mut modules) current 1u32
										next.inc)
									(if
										(:doc "Suspend on this C selection and resolve the layout module's ordinary dependencies.")
										layout_provider.not-ltz
										(then
											(set pending_parent current)
											(set pending_path layout_provider)
											(set current (struct:get (files.get layout_provider) identity)))))
								(else
									(let disk_edge (disk.and file/bundled.not))
									(let resolved (call resolve_graph_edge (borrow-shared arena) (borrow-shared files)
										(borrow-shared (arena.range source_start source_end))
										current frame/path edge disk_edge (borrow-shared edges)))
									(if
										(:doc "Request host files for project imports. Bundled modules resolve within supplied sources.")
										(bool:and (disk_edge.and (resolved/error.eq 27u32))
											(bool:and (i32:lt -1i32 edge/path_start)
												resolved/file.ltz))
										(then
											(call save_graph_progress (borrow-mut progress) length binding current
												pending_path pending_parent module_count binding_count
												use_count selector_count)
											(return (call disk_request context module_count binding_count
												current edge))))
									(let error resolved/error)
									(if
										(:doc "Path errors belong to the importing file.")
										error.gtz
										(then (return (call finish_edge_error context recover error
											current resolved/start resolved/end
											current next.inc
											length binding module_count binding_count
											binding_count use_count selector_count
											(borrow-mut modules) (borrow-mut progress)))))
									(let path resolved/next)
									(let target (struct:get (files.get path) identity))
									(let state (struct:get (modules.get target) state))
									(if
										(:doc "An edge into a visiting identity closes an active cycle.")
										(state.eq 1u32)
										(then (return (call finish_edge_error context recover 28u32
											current edge/start edge/end
											current next.inc
											length binding module_count binding_count
											binding_count use_count selector_count
											(borrow-mut modules) (borrow-mut progress)))))
									(if
										(:doc "Bind immediately for a completed provider or suspend this importer for a new one.")
										(state.eq 2u32)
										(then (set provider target))
										(else
											(call update_frame (borrow-mut modules) current 1u32
												next.inc)
											(set pending_parent current)
											(set pending_path path)
											(set current target)))))))
					(if
						(:doc "Resume the edge that reached this provider or consume its cached declarations.")
						(importer.not-ltz.and provider.not-ltz)
						(then
							(let importer_frame (modules.get importer))
							(let edge (uses.get edge_index))
							(if
								(:doc "A failed provider blocks its importers without a second diagnostic.")
								(struct:get (modules.get provider) failed)
								(then (call fail_graph_file (borrow-mut modules) importer
									importer_frame/next_use))
								(else
									(if
										(:doc "A C edge activates layouts without importing the provider's ordinary names.")
										(edge/provider.eq 8u32)
										(then (call update_frame (borrow-mut modules) importer 1u32 edge_index))
										(else
											(let from (files.get importer))
											(let target (files.get provider))
											(let bound (call bind_edge
												(borrow-shared (arena.range
													from/source_start from/source_end))
												(borrow-shared (arena.range
													target/source_start target/source_end))
												importer provider edge
												(borrow-shared selectors) (borrow-mut bindings) binding_count))
											(let error bound/error)
											(if
												(:doc "A short table retries this edge with the same published prefix.")
												(error.eq 16u32)
												(then (call save_graph_progress (borrow-mut progress) length binding current
													pending_path pending_parent module_count binding_count
													use_count selector_count)))
											(if
												(:doc "An invalid selection poisons the importer without discarding the resolved provider.")
												error.gtz
												(then
													(if
														(:doc "A finished provider stays available to subsequent importers.")
														(exhausted.and (recover.and (error.not-eq 16u32)))
														(then (call update_frame (borrow-mut modules) current 2u32 next)))
													(return (call finish_edge_error context recover error
														importer bound/start bound/end
														importer edge_index.inc
														length binding module_count binding_count
														bound/next use_count selector_count
														(borrow-mut modules) (borrow-mut progress)))))
											(set binding_count bound/next)))))))
					(if
						(:doc "Publish frame changes only after binding succeeds so capacity retries stay on this edge.")
						exhausted
						(then
							(call update_frame (borrow-mut modules) current 2u32 next)
							(set current importer))
						(else
							(if
								(:doc "A cached provider was bound without entering another frame.")
								(i32:lt -1i32 provider)
								(then (call update_frame (borrow-mut modules) current 1u32
									next.inc)))))))
			(return (call graph_result context module_count binding_count -1i32 0i32 0i32 0u32)))))
