(module source_generics
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read explicit generic parameters and classify exact constant and function arguments.`)

	(use wove-file "./scan.wove" (only is_wove_name (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_operand validate_form_metadata))
	(use wove-file "./types.wove" (only builtin_type_keyword is_reserved_type_name))
	(use wove-file "./literals.wove" (only integer_atom integer_scalar read_integer_magnitude))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/boolean.wove" (only read_boolean_word))

	(let generic_head "generic")
	(let specialization_head "specialize")
	(let type_parameter "type")
	(let const_parameter "const")
	(let operation_parameter "fn")

	(struct GenericParameter (fields (name i32) (kind u32) (start i32) (end i32) (error u32)))
	(struct GenericConstant (fields (value u32) (start i32) (end i32) (error u32)))

	(let checked_type_operand 1u8)
	(let checked_i32_operand 2u8)
	(let checked_function_operand 3u8)
	(let checked_bool_operand 4u8)
	(let checked_enum_operand 5u8)
	(let checked_operation_operand 6u8)
	(let checked_operation_identity 7u8)
	(let generic_bool_kind 3u32)
	(let generic_enum_kind 4u32)
	(let generic_operation_kind 5u32)
	(let normalized_i32_literal -3i32)

	(fn generic_i32_value
		(:doc "Recover a signed constant from its checked bits without an out-of-range conversion.")
		(params (bits u32)) (returns i32)
		(body
			(if
				(:doc "Negative values are one less than the complement of their magnitude.")
				(u32:lt 2147483647u32 bits)
				(then (return (i32:sub -1i32 (i32:from-u32 (u32:sub 4294967295u32 bits))))))
			(return (i32:from-u32 bits))))

	(fn with_generic_operand
		(:doc "Attach a checked operand to a compiler-owned node without changing its original span or links.")
		(params (node SourceNode) (kind u8) (value u32)) (returns SourceNode)
		(body
			(return (SourceNode.new (kind node/kind)
				(start node/start) (end node/end)
				(parent node/parent) (first_child node/first_child)
				(next_sibling node/next_sibling)
				(bridge_project node/bridge_project) (bridge_default node/bridge_default)
				(generic_kind kind) (generic_value value)
				(c_ordinal node/c_ordinal)))))

	(fn function_generic_list
		(:doc "Find a function's optional explicit generic list before its ordinary signature fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let operand parts/operands)
			(if
				(:doc "Only a named function whose first ordinary field is generic is a template.")
				(bool:and (i32:lt -1i32 parts/name)
					(bool:and (i32:lt -1i32 operand)
						(call has_generic_head (borrow-shared source) (borrow-shared nodes)
							(nodes.get operand))))
				(then (return operand)))
			(return -1i32)))

	(fn generic_spelling
		(:doc "Compare an ordinary source atom to a generic syntax keyword.")
		(params (source (shared-array u8)) (node SourceNode) (word (shared-array u8))) (returns bool)
		(body
			(return (bool:and (node/kind.eq 1u32)
				(call same_bytes (borrow-shared source) node/start node/end
					(borrow-shared word) 0i32 word.len)))))

	(fn has_generic_head
		(:doc "Recognize a generic list at the position before a record's fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns bool)
		(body
			(return (bool:and (node/kind.eq 40u32)
				(call generic_spelling (borrow-shared source)
					(nodes.get node/first_child) (borrow-shared generic_head))))))

	(fn has_specialization_head
		(:doc "Recognize the explicit type application form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns bool)
		(body
			(return (bool:and (node/kind.eq 40u32)
				(call generic_spelling (borrow-shared source)
					(nodes.get node/first_child) (borrow-shared specialization_head))))))

	(fn generic_parameter_at
		(:doc "Keep the parameter's kind and the source span of its validation result.")
		(params (node SourceNode) (name i32) (kind u32) (error u32)) (returns GenericParameter)
		(body
			(return (GenericParameter.new (name name) (kind kind)
				(start node/start) (end node/end) (error error)))))

	(fn parameter_kind
		(:doc "Distinguish the type, const, and fn parameter declaration tags.")
		(params (source (shared-array u8)) (node SourceNode)) (returns u32)
		(body
			(if (call generic_spelling (borrow-shared source) node (borrow-shared type_parameter)) (then (return 1u32)))
			(if (call generic_spelling (borrow-shared source) node (borrow-shared const_parameter)) (then (return 2u32)))
			(if
				(:doc "A function parameter is a compile-time operation with no runtime slot.")
				(call generic_spelling (borrow-shared source) node (borrow-shared operation_parameter))
				(then (return generic_operation_kind)))
			(return 0u32)))

	(fn is_checked_non_type_operand
		(:doc "Recognize a substituted constant or operation that cannot fall through to a type or module binding.")
		(params (annotation u8)) (returns bool)
		(body (return (bool:or (annotation.eq checked_i32_operand)
			(bool:or (annotation.eq checked_bool_operand)
				(bool:or (annotation.eq checked_enum_operand)
					(annotation.eq checked_operation_operand)))))))

	(fn constant_parameter_kind
		(:doc "Classify a built-in constant type or a name to resolve in the defining module.")
		(params (source (shared-array u8)) (node SourceNode)) (returns u32)
		(body
			(if (node/kind.not-eq 1u32) (then (return 0u32)))
			(let start node/start)
			(let type (call builtin_type_keyword (borrow-shared source)
				start (node/end.sub start)))
			(if (type.eq 5u32) (then (return 2u32)))
			(if (type.eq 12u32) (then (return generic_bool_kind)))
			(let end node/end)
			(if
				(:doc "Only a non-reserved identifier can name a fieldless enum.")
				(bool:and (call is_wove_name (borrow-shared source) node)
					(bool:not (call is_reserved_type_name (borrow-shared source) start end)))
				(then (return generic_enum_kind)))
			(return 0u32)))

	(fn generic_argument_kind
		(:doc "Read a validated parameter's exact application kind for checking and hashing.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameter SourceNode)) (returns u32)
		(body
			(let head (nodes.get parameter/first_child))
			(let kind (call parameter_kind (borrow-shared source) head))
			(if (kind.not-eq 2u32) (then (return kind)))
			(return (call constant_parameter_kind (borrow-shared source)
				(nodes.get (call constant_type_operand (borrow-shared source)
					(borrow-shared nodes) parameter))))))

	(fn constant_type_operand
		(:doc "Locate the declared type of a syntactically checked constant parameter.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parameter SourceNode)) (returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) parameter))
			(return parts/operands)))

	(fn is_i32_spelling
		(:doc "Check the exact builtin type spelling over a byte interval.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns bool)
		(body (return (u32:eq (call builtin_type_keyword (borrow-shared source)
			start (end.sub start)) 5u32))))

	(fn read_generic_parameter
		(:doc "Check a type, exact constant, or function declaration and preserve its original parameter name.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns GenericParameter)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head parts/head)
			(let name parts/name)
			(if
				(:doc "A generic parameter is a tagged form with a bare name operand.")
				(head.ltz.or name.ltz)
				(then (return (call generic_parameter_at node -1i32 0u32 22u32))))
			(let kind (call parameter_kind (borrow-shared source) (nodes.get head)))
			(if
				(:doc "Only the supported parameter kinds have explicit argument syntax.")
				kind.eqz
				(then (return (call generic_parameter_at (nodes.get head) -1i32 0u32 22u32))))
			(let selected (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) node parts))
			(if
				(:doc "Generic parameters cannot change by target selection.")
				selected/error.gtz
				(then (return (GenericParameter.new (name -1i32) (kind 0u32)
					(start selected/start) (end selected/end)
					(error selected/error)))))
			(let spelling (nodes.get name))
			(let start spelling/start)
			(let end spelling/end)
			(if
				(:doc "A parameter name cannot shadow a built-in type spelling.")
				(bool:or (bool:not (call is_wove_name (borrow-shared source) spelling))
					(call is_reserved_type_name (borrow-shared source) start end))
				(then (return (call generic_parameter_at spelling -1i32 0u32 22u32))))
			(let type parts/operands)
			(if
				(:doc "Type and function parameters have no declared value type.")
				(kind.not-eq 2u32)
				(then
					(if (i32:lt -1i32 type) (then (return (call generic_parameter_at (nodes.get type) -1i32 0u32 22u32))))
					(return (call generic_parameter_at node name kind 0u32))))
			(if type.ltz (then (return (call generic_parameter_at node -1i32 0u32 22u32))))
			(let declared (nodes.get type))
			(let constant (call constant_parameter_kind (borrow-shared source) declared))
			(if
				(:doc "A constant annotation must name a supported exact value type.")
				constant.eqz
				(then (return (call generic_parameter_at declared -1i32 0u32 23u32))))
			(let extra (call next_form_operand (borrow-shared source) (borrow-shared nodes) declared))
			(if (i32:lt -1i32 extra) (then (return (call generic_parameter_at (nodes.get extra) -1i32 0u32 22u32))))
			(return (call generic_parameter_at node name constant 0u32))))

	(fn constant_at
		(:doc "Keep the checked constant or its originating argument span.")
		(params (node SourceNode) (bits u32) (error u32)) (returns GenericConstant)
		(body
			(return (GenericConstant.new (value bits) (start node/start)
				(end node/end) (error error)))))

	(fn normalize_generic_i32
		(:doc "Normalize the magnitude and sign to one word after exact i32 bounds validation.")
		(params (source (shared-array u8)) (node SourceNode) (start i32) (end i32)) (returns GenericConstant)
		(body
			(let spelling (call integer_scalar (borrow-shared source) start end 5u32))
			(let digits spelling/digits)
			(if digits.ltz (then (return (call constant_at node 0u32 25u32))))
			(let magnitude (call read_integer_magnitude (borrow-shared source)
				digits end spelling/radix (bool false)))
			(let-mut value magnitude/low)
			(if spelling/negative (then (set value (u32:sub 0u32 value))))
			(return (call constant_at node value 0u32))))

	(fn read_i32_constant
		(:doc "Read a compile-time i32 literal, admitting a bare number when its type is declared at the site.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (contextual_type bool)) (returns GenericConstant)
		(body
			(if
				(:doc "An explicit literal form contains one bare magnitude and keeps the original argument span.")
				(node/kind.eq 40u32)
				(then
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let head (nodes.get parts/head))
					(let operand parts/operands)
					(if
						(:doc "A form with a different type or operation is not an i32 literal.")
						(operand.ltz.or
							(bool:not (call is_i32_spelling (borrow-shared source)
								head/start head/end)))
						(then (return (call constant_at node 0u32 23u32))))
					(let selected (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) node parts))
					(if
						(:doc "Selection pragmas cannot remove a compile-time literal operand.")
						selected/error.gtz
						(then (return (GenericConstant.new (value 0u32)
							(start selected/start) (end selected/end)
							(error selected/error)))))
					(let literal (nodes.get operand))
					(if
						(:doc "The literal form takes exactly one raw numeric operand.")
						(bool:or (literal/kind.not-eq 1u32)
							(i32:lt -1i32 literal/next_sibling))
						(then (return (call constant_at node 0u32 23u32))))
					(return (call normalize_generic_i32 (borrow-shared source) node
						literal/start literal/end))))
			(if (node/kind.not-eq 1u32) (then (return (call constant_at node 0u32 23u32))))
			(let start node/start)
			(let end node/end)
			(let atom (call integer_atom (borrow-shared source) start end))
			(let suffix atom/end)
			(if
				(:doc "An exact i32 declaration supplies the type of an unsuffixed number.")
				(contextual_type.and (suffix.eq end))
				(then (return (call normalize_generic_i32 (borrow-shared source) node start end))))
			(if
				(:doc "Without a contextual type, the atom must carry the exact i32 suffix.")
				(bool:or (atom/digits.not-lt suffix)
					(bool:not (call is_i32_spelling (borrow-shared source) suffix end)))
				(then (return (call constant_at node 0u32 23u32))))
			(return (call normalize_generic_i32 (borrow-shared source) node start suffix))))

	(fn read_generic_i32
		(:doc "Require the exact i32 type in a generic constant argument.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns GenericConstant)
		(body (return (call read_i32_constant (borrow-shared source) (borrow-shared nodes)
			node (bool false)))))

	(fn read_generic_bool
		(:doc "Normalize one explicit bool literal to a checked zero or one without losing its source span.")
		(:expect (tests "stage-2/generic_booleans/cases.tsv") (issues "gh:wove-lang/wove:99"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns GenericConstant)
		(body
			(if
				(:doc "A bare word does not explicitly name a literal type.")
				(node/kind.not-eq 40u32)
				(then (return (call constant_at node 0u32 23u32))))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (nodes.get parts/head))
			(let operand parts/operands)
			(if
				(:doc "Only an explicit bool form can supply a Boolean argument.")
				(operand.ltz.or
					(u32:not-eq (call constant_parameter_kind (borrow-shared source) head) generic_bool_kind))
				(then (return (call constant_at node 0u32 23u32))))
			(let selected (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) node parts))
			(if
				(:doc "Keep the originating metadata diagnostic for a literal operand.")
				selected/error.gtz
				(then (return (GenericConstant.new (value 0u32)
					(start selected/start) (end selected/end)
					(error selected/error)))))
			(let literal (nodes.get operand))
			(if
				(:doc "A Boolean literal has exactly one operand.")
				(i32:lt -1i32 literal/next_sibling)
				(then (return (call constant_at node 0u32 23u32))))
			(if
				(:doc "Only a bare true or false operand has a Boolean value.")
				(literal/kind.not-eq 1u32)
				(then (return (call constant_at literal 0u32 25u32))))
			(let value (call read_boolean_word (borrow-shared source) literal/start literal/end))
			(if value.ltz (then (return (call constant_at literal 0u32 25u32))))
			(return (call constant_at node (u32:from-i32 value) 0u32))))
)
