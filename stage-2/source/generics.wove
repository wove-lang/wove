(module source_generics
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read explicit generic parameters and normalize checked i32 constant arguments.`)

	(use wove-file "./scan.wove" (only is_identifier_head (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts validate_form_metadata))
	(use wove-file "./types.wove" (only builtin_type_keyword is_reserved_type_name))
	(use wove-file "./literals.wove" (only integer_atom integer_scalar read_integer_magnitude))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_byte))

	(let generic_head "generic")
	(let specialization_head "specialize")
	(let type_parameter "type")
	(let const_parameter "const")

	(struct GenericParameter (fields (name i32) (kind u32) (start i32) (end i32) (error u32)))
	(struct GenericConstant (fields (value u32) (start i32) (end i32) (error u32)))

	(let checked_type_operand 1u8)
	(let checked_i32_operand 2u8)
	(let checked_function_operand 3u8)
	(let normalized_i32_literal -3i32)

	(fn generic_i32_value
		(:doc "Recover a signed constant from its checked bits without an out-of-range conversion.")
		(params (bits u32)) (returns i32)
		(body
			(if
				(:doc "Negative values are one less than the complement of their magnitude.")
				(u32.lt 2147483647u32 (local bits))
				(then (return (i32.sub -1i32 (int.convert i32 (u32.sub 4294967295u32 (local bits)))))))
			(return (int.convert i32 (local bits)))))

	(fn with_generic_operand
		(:doc "Attach a checked operand to a compiler-owned node without changing its original span or links.")
		(params (node SourceNode) (kind u8) (value u32)) (returns SourceNode)
		(body
			(return (struct.new SourceNode (kind (struct.get (local node) kind))
				(start (struct.get (local node) start)) (end (struct.get (local node) end))
				(parent (struct.get (local node) parent)) (first_child (struct.get (local node) first_child))
				(next_sibling (struct.get (local node) next_sibling))
				(bridge_project (struct.get (local node) bridge_project)) (bridge_default (struct.get (local node) bridge_default))
				(generic_kind (local kind)) (generic_value (local value))))))

	(fn function_generic_list
		(:doc "Find a function's optional explicit generic list before its ordinary signature fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns i32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let operand (struct.get (local parts) operands))
			(if
				(:doc "Only a named function whose first ordinary field is generic is a template.")
				(bool.and (i32.lt -1i32 (struct.get (local parts) name))
					(bool.and (i32.lt -1i32 (local operand))
						(call has_generic_head (borrow-shared (local source)) (borrow-shared (local nodes))
							(array.load (local nodes) (local operand)))))
				(then (return (local operand))))
			(return -1i32)))

	(fn generic_spelling
		(:doc "Compare an ordinary source atom to a generic syntax keyword.")
		(params (source (shared-array u8)) (node SourceNode) (word (shared-array u8))) (returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(call same_bytes (borrow-shared (local source)) (struct.get (local node) start) (struct.get (local node) end)
					(borrow-shared (local word)) 0i32 (array.len (local word)))))))

	(fn has_generic_head
		(:doc "Recognize a generic list at the position before a record's fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 40u32)
				(call generic_spelling (borrow-shared (local source))
					(array.load (local nodes) (struct.get (local node) first_child)) (borrow-shared (local generic_head)))))))

	(fn has_specialization_head
		(:doc "Recognize the explicit type application form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 40u32)
				(call generic_spelling (borrow-shared (local source))
					(array.load (local nodes) (struct.get (local node) first_child)) (borrow-shared (local specialization_head)))))))

	(fn generic_parameter_at
		(:doc "Keep the parameter's kind and the source span of its validation result.")
		(params (node SourceNode) (name i32) (kind u32) (error u32)) (returns GenericParameter)
		(body
			(return (struct.new GenericParameter (name (local name)) (kind (local kind))
				(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error (local error))))))

	(fn parameter_kind
		(:doc "Recognize both supported generic parameter kinds by their original tags.")
		(params (source (shared-array u8)) (node SourceNode)) (returns u32)
		(body
			(if (call generic_spelling (borrow-shared (local source)) (local node) (borrow-shared (local type_parameter))) (then (return 1u32)))
			(if (call generic_spelling (borrow-shared (local source)) (local node) (borrow-shared (local const_parameter))) (then (return 2u32)))
			(return 0u32)))

	(fn is_i32_spelling
		(:doc "Check the exact builtin type spelling over a byte interval.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns bool)
		(body (return (u32.eq (call builtin_type_keyword (borrow-shared (local source))
			(local start) (i32.sub (local end) (local start))) 5u32))))

	(fn read_generic_parameter
		(:doc "Check a type or i32 constant declaration and preserve the original parameter name.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns GenericParameter)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (struct.get (local parts) head))
			(let name (struct.get (local parts) operands))
			(if
				(:doc "A generic parameter is a tagged form with a bare name operand.")
				(bool.or (i32.lt (local head) 0i32) (i32.lt (local name) 0i32))
				(then (return (call generic_parameter_at (local node) -1i32 0u32 22u32))))
			(let kind (call parameter_kind (borrow-shared (local source)) (array.load (local nodes) (local head))))
			(if
				(:doc "The two declaration kinds have distinct argument syntax.")
				(u32.eq (local kind) 0u32)
				(then (return (call generic_parameter_at (array.load (local nodes) (local head)) -1i32 0u32 22u32))))
			(let selected (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local parts)))
			(if
				(:doc "Generic parameters cannot change by target selection.")
				(u32.lt 0u32 (struct.get (local selected) error))
				(then (return (struct.new GenericParameter (name -1i32) (kind 0u32)
					(start (struct.get (local selected) start)) (end (struct.get (local selected) end))
					(error (struct.get (local selected) error))))))
			(let spelling (array.load (local nodes) (local name)))
			(let start (struct.get (local spelling) start))
			(let end (struct.get (local spelling) end))
			(if
				(:doc "A parameter name cannot shadow a built-in type spelling.")
				(bool.or (bool.not (bool.and (u32.eq (struct.get (local spelling) kind) 1u32)
					(call is_identifier_head (borrow-shared (local source)) (local start) (local end))))
					(call is_reserved_type_name (borrow-shared (local source)) (local start) (local end)))
				(then (return (call generic_parameter_at (local spelling) -1i32 0u32 22u32))))
			(let type (struct.get (local spelling) next_sibling))
			(if
				(:doc "A type parameter has no declared value type.")
				(u32.eq (local kind) 1u32)
				(then
					(if (i32.lt -1i32 (local type)) (then (return (call generic_parameter_at (array.load (local nodes) (local type)) -1i32 0u32 22u32))))
					(return (call generic_parameter_at (local node) (local name) (local kind) 0u32))))
			(if (i32.lt (local type) 0i32) (then (return (call generic_parameter_at (local node) -1i32 0u32 22u32))))
			(let declared (array.load (local nodes) (local type)))
			(if
				(:doc "This constant parameter slice accepts only an exact i32 annotation.")
				(bool.or (bool.not (u32.eq (struct.get (local declared) kind) 1u32))
					(bool.not (call is_i32_spelling (borrow-shared (local source))
						(struct.get (local declared) start) (struct.get (local declared) end))))
				(then (return (call generic_parameter_at (local declared) -1i32 0u32 23u32))))
			(let extra (struct.get (local declared) next_sibling))
			(if (i32.lt -1i32 (local extra)) (then (return (call generic_parameter_at (array.load (local nodes) (local extra)) -1i32 0u32 22u32))))
			(return (call generic_parameter_at (local node) (local name) (local kind) 0u32))))

	(fn constant_at
		(:doc "Keep the checked constant or its originating argument span.")
		(params (node SourceNode) (bits u32) (error u32)) (returns GenericConstant)
		(body
			(return (struct.new GenericConstant (value (local bits)) (start (struct.get (local node) start))
				(end (struct.get (local node) end)) (error (local error))))))

	(fn normalize_generic_i32
		(:doc "Normalize the magnitude and sign to one word after exact i32 bounds validation.")
		(params (source (shared-array u8)) (node SourceNode) (start i32) (end i32)) (returns GenericConstant)
		(body
			(let spelling (call integer_scalar (borrow-shared (local source)) (local start) (local end) 5u32))
			(let digits (struct.get (local spelling) digits))
			(if (i32.lt (local digits) 0i32) (then (return (call constant_at (local node) 0u32 25u32))))
			(let magnitude (call read_integer_magnitude (borrow-shared (local source))
				(local digits) (local end) (struct.get (local spelling) radix)))
			(let-mut value (struct.get (local magnitude) low))
			(if (struct.get (local spelling) negative) (then (set (local value) (u32.sub 0u32 (local value)))))
			(return (call constant_at (local node) (local value) 0u32))))

	(fn read_generic_i32
		(:doc "Read a compile-time i32 from a typed atom or an explicit i32 literal form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns GenericConstant)
		(body
			(if
				(:doc "An explicit literal form contains one bare magnitude and keeps the original argument span.")
				(u32.eq (struct.get (local node) kind) 40u32)
				(then
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let head (array.load (local nodes) (struct.get (local parts) head)))
					(let operand (struct.get (local parts) operands))
					(if
						(:doc "A form with a different type or operation is not an i32 literal.")
						(bool.or (i32.lt (local operand) 0i32)
							(bool.not (call is_i32_spelling (borrow-shared (local source))
								(struct.get (local head) start) (struct.get (local head) end))))
						(then (return (call constant_at (local node) 0u32 23u32))))
					(let selected (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local parts)))
					(if
						(:doc "Selection pragmas cannot remove a compile-time literal operand.")
						(u32.lt 0u32 (struct.get (local selected) error))
						(then (return (struct.new GenericConstant (value 0u32)
							(start (struct.get (local selected) start)) (end (struct.get (local selected) end))
							(error (struct.get (local selected) error))))))
					(let literal (array.load (local nodes) (local operand)))
					(if
						(:doc "The literal form takes exactly one raw numeric operand.")
						(bool.or (bool.not (u32.eq (struct.get (local literal) kind) 1u32))
							(i32.lt -1i32 (struct.get (local literal) next_sibling)))
						(then (return (call constant_at (local node) 0u32 23u32))))
					(return (call normalize_generic_i32 (borrow-shared (local source)) (local node)
						(struct.get (local literal) start) (struct.get (local literal) end)))))
			(if (bool.not (u32.eq (struct.get (local node) kind) 1u32)) (then (return (call constant_at (local node) 0u32 23u32))))
			(let start (struct.get (local node) start))
			(let end (struct.get (local node) end))
			(let atom (call integer_atom (borrow-shared (local source)) (local start) (local end)))
			(let suffix (struct.get (local atom) end))
			(if
				(:doc "An untyped or differently typed constant cannot stand in for an i32 argument.")
				(bool.or (bool.not (i32.lt (struct.get (local atom) digits) (local suffix)))
					(bool.not (call is_i32_spelling (borrow-shared (local source)) (local suffix) (local end))))
				(then (return (call constant_at (local node) 0u32 23u32))))
			(return (call normalize_generic_i32 (borrow-shared (local source)) (local node) (local start) (local suffix)))))

	(fn hash_generic_word
		(:doc "Feed one normalized argument word in little-endian byte order.")
		(params (hash u32) (value u32)) (returns u32)
		(body
			(let-mut result (local hash))
			(let-mut shift 0i32)
			(while
				(:doc "Hash precisely four bytes, including leading zero bytes.")
				(i32.lt (local shift) 32i32)
				(body
					(set (local result) (call fnv1a_byte (local result)
						(int.convert u8 (u32.and (u32.shr (local value) (local shift)) 255u32))))
					(set (local shift) (i32.add (local shift) 8i32))))
			(return (local result))))
)
