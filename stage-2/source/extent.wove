(module source_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read module integer literals for type extents before laying out arrays.")

	(use wove-file "./scan.wove" (only (type SourceNode) (value character_token)))
	(use wove-file "./module.wove" (only form_parts))
	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer))
	(use wove-file "./literals.wove" (only integer_atom integer_scalar read_integer_magnitude))
	(use wove-file "../text/character.wove" (only decode_character))

	(fn normalized_extent
		(:doc "Decode a checked nonnegative magnitude if it lies within the extent range.")
		(params (source (shared-array u8)) (digits i32) (end i32) (radix i32)) (returns i32)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared (local source)) (local digits) (local end) (local radix)))
			(let low (struct.get (local magnitude) low))
			(if
				(:doc "An extent must fit in nonnegative i32 even when its initializer has a wider type.")
				(bool.or (u32.lt 0u32 (struct.get (local magnitude) high)) (u32.lt 2147483647u32 (local low)))
				(then (return -1i32)))
			(return (i32.from-u32 (local low)))))

	(fn typed_extent_magnitude
		(:doc "Apply the declared integer's own bounds before narrowing it to a nonnegative i32 size.")
		(params (source (shared-array u8)) (start i32) (end i32) (type u32)) (returns i32)
		(body
			(if
				(:doc "Empty magnitudes and noninteger types cannot define an extent.")
				(bool.or (bool.not (i32.lt (local start) (local end))) (bool.not (call is_builtin_integer (local type))))
				(then (return -1i32)))
			(let spelling (call integer_scalar (borrow-shared (local source)) (local start) (local end) (local type)))
			(let digits (struct.get (local spelling) digits))
			(if
				(:doc "An invalid or negative initializer is unavailable at an extent use.")
				(bool.or (i32.lt (local digits) 0i32) (struct.get (local spelling) negative))
				(then (return -1i32)))
			(return (call normalized_extent (borrow-shared (local source)) (local digits) (local end)
				(struct.get (local spelling) radix)))))

	(fn suffixed_extent_value
		(:doc "Resolve the integer suffix before interpreting the preceding magnitude.")
		(params (source (shared-array u8)) (node SourceNode)) (returns i32)
		(body
			(let start (struct.get (local node) start))
			(let end (struct.get (local node) end))
			(let atom (call integer_atom (borrow-shared (local source)) (local start) (local end)))
			(let suffix (struct.get (local atom) end))
			(if
				(:doc "A typed atom has both a magnitude and a suffix.")
				(bool.or (i32.eq (local suffix) (struct.get (local atom) digits)) (i32.eq (local suffix) (local end)))
				(then (return -1i32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local suffix) (i32.sub (local end) (local suffix))))
			(return (call typed_extent_magnitude (borrow-shared (local source)) (local start) (local suffix) (local type)))))

	(fn immutable_extent_value
		(:doc "Read an immutable module initializer as a checked nonnegative i32 extent, or return -1.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (initializer i32)) (returns i32)
		(body
			(if (i32.lt (local initializer) 0i32) (then (return -1i32)))
			(let node (array.load (local nodes) (local initializer)))
			(if (i32.lt -1i32 (struct.get (local node) next_sibling)) (then (return -1i32)))
			(let kind (struct.get (local node) kind))
			(if
				(:doc "A suffixed numeral carries its complete type in the atom.")
				(u32.eq (local kind) 1u32)
				(then (return (call suffixed_extent_value (borrow-shared (local source)) (local node)))))
			(if
				(:doc "An unconverted character's inferred type is i32.")
				(u32.eq (local kind) (local character_token))
				(then (return (call decode_character (borrow-shared (local source)) (struct.get (local node) start) (struct.get (local node) end)))))
			(if (bool.not (u32.eq (local kind) 40u32)) (then (return -1i32)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let index (struct.get (local parts) operands))
			(if (i32.lt (local index) 0i32) (then (return -1i32)))
			(let head (array.load (local nodes) (struct.get (local parts) head)))
			(let start (struct.get (local head) start))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (i32.sub (struct.get (local head) end) (local start))))
			(let value (array.load (local nodes) (local index)))
			(if
				(:doc "A typed integer initializer has a single magnitude operand.")
				(i32.lt -1i32 (struct.get (local value) next_sibling))
				(then (return -1i32)))
			(if
				(:doc "Integer constructors accept an unquoted magnitude in any supported radix.")
				(u32.eq (struct.get (local value) kind) 1u32)
				(then (return (call typed_extent_magnitude (borrow-shared (local source))
					(struct.get (local value) start) (struct.get (local value) end) (local type)))))
			(if
				(:doc "The i32 and explicit byte constructors can hold a single character value.")
				(bool.and (u32.eq (struct.get (local value) kind) (local character_token))
					(bool.or (u32.eq (local type) 5u32) (u32.eq (local type) 10u32)))
				(then (return (call decode_character (borrow-shared (local source)) (struct.get (local value) start) (struct.get (local value) end)))))
			(return -1i32)))
)
