(module source_extent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read module integer literals for type extents before laying out arrays.")

	(use wove-file "./scan.wove" (only (type SourceNode) (value character_token)))
	(use wove-file "./module.wove" (only form_parts))
	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer is_128bit_integer))
	(use wove-file "./literals.wove" (only integer_atom integer_scalar read_integer_magnitude))
	(use wove-file "../text/character.wove" (only decode_character))

	(fn normalized_extent
		(:doc "Decode a checked nonnegative magnitude if it lies within the extent range.")
		(params (source (shared-array u8)) (digits i32) (end i32) (radix i32) (wide bool)) (returns i32)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared source) digits end radix wide))
			(let low magnitude/low)
			(if
				(:doc "An extent must fit in nonnegative i32 even when its initializer has a wider type.")
				(bool:or (bool:or magnitude/highest.gtz magnitude/upper.gtz)
					(bool:or magnitude/high.gtz (u32:lt 2147483647u32 low)))
				(then (return -1i32)))
			(return (i32:from-u32 low))))

	(fn typed_extent_magnitude
		(:doc "Apply the declared integer's own bounds before narrowing it to a nonnegative i32 size.")
		(params (source (shared-array u8)) (start i32) (end i32) (type u32)) (returns i32)
		(body
			(if
				(:doc "Empty magnitudes and noninteger types cannot define an extent.")
				(bool:or (start.not-lt end) (bool:not (call is_builtin_integer type)))
				(then (return -1i32)))
			(let spelling (call integer_scalar (borrow-shared source) start end type))
			(let digits spelling/digits)
			(if
				(:doc "An invalid or negative initializer is unavailable at an extent use.")
				(bool:or digits.ltz spelling/negative)
				(then (return -1i32)))
			(return (call normalized_extent (borrow-shared source) digits end
				spelling/radix (call is_128bit_integer type)))))

	(fn suffixed_extent_value
		(:doc "Resolve the integer suffix before interpreting the preceding magnitude.")
		(params (source (shared-array u8)) (node SourceNode)) (returns i32)
		(body
			(let start node/start)
			(let end node/end)
			(let atom (call integer_atom (borrow-shared source) start end))
			(let suffix atom/end)
			(if
				(:doc "A typed atom has both a magnitude and a suffix.")
				(bool:or (suffix.eq atom/digits) (suffix.eq end))
				(then (return -1i32)))
			(let type (call builtin_type_keyword (borrow-shared source) suffix (end.sub suffix)))
			(return (call typed_extent_magnitude (borrow-shared source) start suffix type))))

	(fn immutable_extent_value
		(:doc "Read an immutable module initializer as a checked nonnegative i32 extent, or return -1.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (initializer i32)) (returns i32)
		(body
			(if initializer.ltz (then (return -1i32)))
			(let node (nodes.get initializer))
			(if (i32:lt -1i32 node/next_sibling) (then (return -1i32)))
			(let kind node/kind)
			(if
				(:doc "A suffixed numeral carries its complete type in the atom.")
				(kind.eq 1u32)
				(then (return (call suffixed_extent_value (borrow-shared source) node))))
			(if
				(:doc "An unconverted character's inferred type is i32.")
				(kind.eq character_token)
				(then (return (call decode_character (borrow-shared source) node/start node/end))))
			(if (kind.not-eq 40u32) (then (return -1i32)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let index parts/operands)
			(if index.ltz (then (return -1i32)))
			(let head (nodes.get parts/head))
			(let start head/start)
			(let type (call builtin_type_keyword (borrow-shared source) start (head/end.sub start)))
			(let value (nodes.get index))
			(if
				(:doc "A typed integer initializer has a single magnitude operand.")
				(i32:lt -1i32 value/next_sibling)
				(then (return -1i32)))
			(if
				(:doc "Integer constructors accept an unquoted magnitude in any supported radix.")
				(value/kind.eq 1u32)
				(then (return (call typed_extent_magnitude (borrow-shared source)
					value/start value/end type))))
			(if
				(:doc "The i32 and explicit byte constructors can hold a single character value.")
				(bool:and (value/kind.eq character_token)
					(bool:or (type.eq 5u32) (type.eq 10u32)))
				(then (return (call decode_character (borrow-shared source) value/start value/end))))
			(return -1i32)))
)
