(module source_integer_checks
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve exact integer heads for nontrapping range checks and arithmetic.")

	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer_value is_256bit_integer numeric_prefix_width))
	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct IntegerCheck (fields (kind u32) (type u32)))

	(let integer_fits 188u32)
	(let integer_try_add 189u32)
	(let integer_try_sub 190u32)
	(let integer_try_mul 191u32)
	(let integer_try_div 192u32)
	(let integer_try_rem 193u32)

	(let fits_head ".fits")
	(let add_head ".try_add")
	(let sub_head ".try_sub")
	(let mul_head ".try_mul")
	(let div_head ".try_div")
	(let rem_head ".try_rem")

	(fn is_integer_check
		(:doc "Identify a checked range predicate or an arithmetic expression with a writeback place.")
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local kind) (local integer_fits))
			(u32.not-lt (local integer_try_rem) (local kind))))))

	(fn integer_check_suffix
		(:doc "Recognize one full operation suffix after a known integer prefix.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "The fit predicate tests representability in the named type.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local fits_head)) 0i32 (array.len (local fits_head)))
				(then (return (local integer_fits))))
			(if
				(:doc "Addition stores only a sum representable in the written type.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local add_head)) 0i32 (array.len (local add_head)))
				(then (return (local integer_try_add))))
			(if
				(:doc "Subtraction checks the exact difference, including unsigned underflow.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local sub_head)) 0i32 (array.len (local sub_head)))
				(then (return (local integer_try_sub))))
			(if
				(:doc "Multiplication checks the exact product.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local mul_head)) 0i32 (array.len (local mul_head)))
				(then (return (local integer_try_mul))))
			(if
				(:doc "Division checks the divisor and the signed quotient boundary.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local div_head)) 0i32 (array.len (local div_head)))
				(then (return (local integer_try_div))))
			(if
				(:doc "Remainder has its own opcode for the signed minimum case.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local rem_head)) 0i32 (array.len (local rem_head)))
				(then (return (local integer_try_rem))))
			(return 0u32)))

	(fn read_integer_check
		(:doc "Read the builtin integer prefix and return its operation and exact type.")
		(params (source (shared-array u8)) (head SourceNode))
		(returns IntegerCheck)
		(body
			(let missing (struct.new IntegerCheck (kind 0u32) (type 0u32)))
			(let start (struct.get (local head) start))
			(let end (struct.get (local head) end))
			(let width (i32.sub (local end) (local start)))
			(if
				(:doc "Only bare heads with room for a type and a full checked operation suffix can match.")
				(bool.or (u32.not-eq (struct.get (local head) kind) 1u32)
					(bool.or (i32.lt (local width) 7i32) (i32.lt 12i32 (local width))))
				(then (return (local missing))))
			(let prefix (call numeric_prefix_width (borrow-shared (local source)) (local start) (local end)))
			(if (i32.eqz (local prefix)) (then (return (local missing))))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local prefix)))
			(if (bool.not (call is_builtin_integer_value (local type))) (then (return (local missing))))
			(let kind (call integer_check_suffix (borrow-shared (local source))
				(i32.add (local start) (local prefix)) (local end)))
			(if
				(:doc "The 256-bit conversion slice admits fits before recoverable arithmetic.")
				(bool.and (call is_256bit_integer (local type)) (u32.not-eq (local kind) (local integer_fits)))
				(then (return (local missing))))
			(return (struct.new IntegerCheck (kind (local kind)) (type (local type)))))))
