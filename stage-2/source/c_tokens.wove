(module source_c_tokens
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read explicit, non-evaluated type and member operands for a C macro.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts))
	(use wove-file "../c/arguments.wove" (only (value c_macro_type_mode) (value c_macro_member_mode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let type_formal "c-type-token")
	(let member_formal "c-member-token")
	(let type_head "c-type")
	(let member_head "c-member")

	(fn token_word
		(:doc "Match one complete bare token rather than a quoted name or a form.")
		(params (source (shared-array u8)) (node SourceNode) (word (shared-array u8)))
		(returns bool)
		(body (return (bool:and (node/kind.eq 1u32)
			(call same_bytes (borrow-shared source) node/start node/end
				(borrow-shared word) 0i32 word.len)))))

	(fn c_macro_token_mode
		(:doc "Classify a native macro's declared type and member token formals.")
		(params (source (shared-array u8)) (type SourceNode)) (returns u8)
		(body
			(if
				(:doc "The first formal consumes a direct native record type.")
				(call token_word (borrow-shared source) type (borrow-shared type_formal))
				(then (return c_macro_type_mode)))
			(if
				(:doc "A member formal consumes one field of the preceding type.")
				(call token_word (borrow-shared source) type (borrow-shared member_formal))
				(then (return c_macro_member_mode)))
			(return 0u8)))

	(fn c_macro_token_operand
		(:doc "Read a single bare argument to the declared token form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (mode u8))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head parts/head)
			(let operand parts/operands)
			(if
				(:doc "A token operand must have a head, one name, and no metadata.")
				(bool:or head.ltz
					(bool:or operand.ltz parts/metadata.not-ltz))
				(then (return -1i32)))
			(let child (nodes.get operand))
			(if
				(:doc "Only a single bare name can supply the token.")
				(bool:or (child/kind.not-eq 1u32) child/next_sibling.not-ltz)
				(then (return -1i32)))
			(let keyword (nodes.get head))
			(let matches (bool:or
				(bool:and (mode.eq c_macro_type_mode)
					(call token_word (borrow-shared source) keyword (borrow-shared type_head)))
				(bool:and (mode.eq c_macro_member_mode)
					(call token_word (borrow-shared source) keyword (borrow-shared member_head)))))
			(if matches (then (return operand)))
			(return -1i32))))
