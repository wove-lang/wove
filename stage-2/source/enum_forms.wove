(module source_enum_forms
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize enum and match tags without resolving any variant names.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let enum_declaration 113u32)
	(let variants_list 114u32)
	(let enum_constructor 115u32)
	(let enum_payload_constructor 211u32)
	(let match_statement 116u32)
	(let match_case 117u32)
	(let match_value 212u32)
	(let match_value_case 213u32)
	(let pending_match_value 214u32)
	(let match_case_gate 215u32)
	(let non_exhaustive_match 78u32)

	(let enum_text "enum")
	(let variants_text "variants")
	(let constructor_text "enum.new")
	(let match_text "match")
	(let case_text "case")

	(fn enum_keyword
		(:doc `Match the complete spelling of a bare enum or match keyword.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if (bool.not (u32.eq (struct.get (local node) kind) 1u32)) (then (return 0u32)))
			(let start (struct.get (local node) start))
			(let end (struct.get (local node) end))
			(let width (i32.sub (local end) (local start)))
			(if
				(:doc "Every supported head is between four and eight bytes long.")
				(bool.or (i32.lt (local width) 4i32) (i32.lt 8i32 (local width)))
				(then (return 0u32)))
			(if
				(:doc "A declaration names the type before its variant list.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local enum_text)) 0i32 (array.len (local enum_text)))
				(then (return (local enum_declaration))))
			(if
				(:doc "The list contains named fieldless variants.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local variants_text)) 0i32 (array.len (local variants_text)))
				(then (return (local variants_list))))
			(if
				(:doc "A constructor names the exact type and variant.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local constructor_text)) 0i32 (array.len (local constructor_text)))
				(then (return (local enum_constructor))))
			(if
				(:doc "A match is a statement followed by scoped case forms.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local match_text)) 0i32 (array.len (local match_text)))
				(then (return (local match_statement))))
			(if
				(:doc "An arm names one variant within its match subject's type.")
				(call same_bytes (borrow-shared (local source)) (local start) (local end)
					(borrow-shared (local case_text)) 0i32 (array.len (local case_text)))
				(then (return (local match_case))))
			(return 0u32))))
