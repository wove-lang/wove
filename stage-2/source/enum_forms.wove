(module source_enum_forms
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize enum and match tags without resolving any variant names.`)

	(use wove-file "./scan.wove" (only new_source_node (type SourceNode)))
	(use wove-file "./generics.wove" (only with_generic_operand))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte is_c_identifier))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let enum_declaration 113u32)
	(let variants_list 114u32)
	(let enum_constructor 115u32)
	(let enum_payload_constructor 211u32)
	(let match_statement 116u32)
	(let match_case 117u32)
	(let match_value 212u32)
	(let match_value_case 213u32)
	(let pending_match_value 214u32)
	(let match_case_gate 215u32)
	(let non_exhaustive_match 78u32)

	(let enum_text "enum")
	(let variants_text "variants")
	(let constructor_text "enum:new")
	(let match_text "match")
	(let case_text "case")

	(fn enum_short_separator
		(:doc "Split a complete type and variant name at the colon, keeping other words in their original grammar.")
		(params (source (shared-array u8)) (node SourceNode))
		(returns i32)
		(body
			(if
				(:doc "Both names must be bare identifiers, with at least one byte on each side.")
				(bool:or (node/kind.not-eq 1u32)
					(bool:or (i32:lt (node/end.sub node/start) 3i32)
						(bool:not (call is_c_identifier_start (source.get node/start)))))
				(then (return -1i32)))
			(let-mut cursor node/start.inc)
			(while
				(:doc "Only complete identifier bytes can belong to the qualifier.")
				(cursor.lt node/end)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "The variant uses the same identifier grammar as an explicit constructor operand.")
						(byte.eq 58u8)
						(then
							(if (call is_c_identifier (borrow-shared source) cursor.inc node/end)
								(then (return cursor)))
							(return -1i32)))
					(if (bool:not (call is_c_identifier_byte byte)) (then (break)))
					(set cursor cursor.inc)))
			(return -1i32)))

	(fn enum_inline_qualifier
		(:doc "Keep the type's own span and any checked generic type attached during specialization.")
		(params (word SourceNode) (separator i32))
		(returns SourceNode)
		(body
			(let name (call new_source_node 1u32 word/start separator word/parent))
			(return (call with_generic_operand name word/generic_kind word/generic_value))))

	(fn enum_keyword
		(:doc `Match the complete spelling of a bare enum or match keyword.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns u32)
		(body
			(if (node/kind.not-eq 1u32) (then (return 0u32)))
			(let start node/start)
			(let end node/end)
			(let width (end.sub start))
			(if
				(:doc "Every supported head is between four and eight bytes long.")
				(bool:or (width.lt 4i32) (i32:lt 8i32 width))
				(then (return 0u32)))
			(if
				(:doc "A declaration names the type before its variant list.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared enum_text) 0i32 enum_text.len)
				(then (return enum_declaration)))
			(if
				(:doc "The list contains named fieldless variants.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared variants_text) 0i32 variants_text.len)
				(then (return variants_list)))
			(if
				(:doc "A constructor names the exact type and variant.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared constructor_text) 0i32 constructor_text.len)
				(then (return enum_constructor)))
			(if
				(:doc "A match is a statement followed by scoped case forms.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared match_text) 0i32 match_text.len)
				(then (return match_statement)))
			(if
				(:doc "An arm names one variant within its match subject's type.")
				(call same_bytes (borrow-shared source) start end
					(borrow-shared case_text) 0i32 case_text.len)
				(then (return match_case)))
			(return 0u32))))
