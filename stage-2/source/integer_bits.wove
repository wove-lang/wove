(module source_integer_bits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read exact-width masks, shifts, rotations, and bit counts.")

	(use wove-file "./types.wove" (only builtin_type_keyword is_builtin_integer_value numeric_prefix_width integer_operator_slot integer_operator_type))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))

	(let word_base 3712u32)
	(let bit_count_base 4224u32)
	(let bit_count_limit 4480u32)
	(let complement_slot 3u32)
	(let shift_left_slot 4u32)
	(let shift_right_slot 5u32)
	(let rotate_left_slot 6u32)
	(let rotate_right_slot 7u32)
	(let leading_count_slot 8i32)
	(let trailing_count_slot 9i32)
	(let population_count_slot 10i32)
	(let mask_symbols "&|^~")

	(fn read_word_slot
		(:doc "Identify a complete operation suffix after the checked type and colon.")
		(params (source (shared-array u8)) (suffix i32) (width i32))
		(returns i32)
		(body
			(if
				(:doc "Population count requires the full six-byte suffix.")
				(i32:eq width 6i32)
				(then
					(if
						(:doc "Both halves of popcnt must match.")
						(bool:and (call is_three_bytes (borrow-shared source) suffix 112u8 111u8 112u8)
							(call is_three_bytes (borrow-shared source) (i32:add suffix 3i32) 99u8 110u8 116u8))
						(then (return population_count_slot)))
					(return -1i32)))
			(if
				(:doc "Rotations have the complete rot prefix and a direction byte.")
				(i32:eq width 4i32)
				(then
					(if
						(:doc "Reject any other prefix before testing the final byte.")
						(bool:not (call is_three_bytes (borrow-shared source) suffix 114u8 111u8 116u8))
						(then (return -1i32)))
					(if
						(:doc "The l suffix rotates left.")
						(call is_byte_at (borrow-shared source) suffix 3i32 108u8)
						(then (return (i32:from-u32 rotate_left_slot))))
					(if
						(:doc "The r suffix rotates right.")
						(call is_byte_at (borrow-shared source) suffix 3i32 114u8)
						(then (return (i32:from-u32 rotate_right_slot))))
					(return -1i32)))
			(if
				(:doc "Only or has two bytes.")
				(i32:eq width 2i32)
				(then
					(if
						(:doc "Require both bytes before accepting or.")
						(bool:and (call is_byte_at (borrow-shared source) suffix 0i32 111u8)
							(call is_byte_at (borrow-shared source) suffix 1i32 114u8))
						(then (return 1i32)))
					(return -1i32)))
			(if (i32:not-eq width 3i32) (then (return -1i32)))
			(if
				(:doc "The four eager masks occupy slots zero through three.")
				(call is_three_bytes (borrow-shared source) suffix 97u8 110u8 100u8)
				(then (return 0i32)))
			(if
				(:doc "XOR shares the two-operand mask shape.")
				(call is_three_bytes (borrow-shared source) suffix 120u8 111u8 114u8)
				(then (return 2i32)))
			(if
				(:doc "Complement is the only unary mask.")
				(call is_three_bytes (borrow-shared source) suffix 110u8 111u8 116u8)
				(then (return (i32:from-u32 complement_slot))))
			(if
				(:doc "Both shifts use a separate count operand.")
				(call is_three_bytes (borrow-shared source) suffix 115u8 104u8 108u8)
				(then (return (i32:from-u32 shift_left_slot))))
			(if
				(:doc "The right shift slot selects sign extension or zero fill by type.")
				(call is_three_bytes (borrow-shared source) suffix 115u8 104u8 114u8)
				(then (return (i32:from-u32 shift_right_slot))))
			(if
				(:doc "Match the full leading-zero suffix.")
				(call is_three_bytes (borrow-shared source) suffix 99u8 108u8 122u8)
				(then (return leading_count_slot)))
			(if
				(:doc "Match the full trailing-zero suffix.")
				(call is_three_bytes (borrow-shared source) suffix 99u8 116u8 122u8)
				(then (return trailing_count_slot)))
			(return -1i32)))

	(fn word_bit_keyword
		(:doc "Match the whole tag and encode the builtin type and operator slot in the opcode.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let width (i32:sub end start))
			(if (bool:or (i32:lt width 5i32) (i32:lt 11i32 width)) (then (return 0u32)))
			(let prefix (call numeric_prefix_width (borrow-shared source) start end))
			(if (i32:eqz prefix) (then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared source) start prefix))
			(if (bool:not (call is_builtin_integer_value type)) (then (return 0u32)))
			(let suffix (i32:add start (i32:inc prefix)))
			(let slot (call read_word_slot (borrow-shared source) suffix (i32:sub end suffix)))
			(if (i32:ltz slot) (then (return 0u32)))
			(let type_slot (call integer_operator_slot type))
			(if
				(:doc "Keep the existing word opcodes and use four slots per type for bit counts.")
				(i32:not-lt slot leading_count_slot)
				(then (return (u32:add bit_count_base
					(u32:or (u32:shl type_slot 2i32) (u32:from-i32 (i32:sub slot leading_count_slot)))))))
			(return (u32:add word_base
				(u32:or (u32:shl type_slot 3i32) (u32:from-i32 slot))))))

	(fn word_type
		(:doc "Recover the six-bit type code from the reserved word opcode range.")
		(params (kind u32))
		(returns u32)
		(body
			(if
				(:doc "An unrelated expression has no word type.")
				(bool:or (u32:lt kind word_base) (u32:not-lt kind bit_count_base))
				(then (return 0u32)))
			(return (call integer_operator_type (u32:shr (u32:sub kind word_base) 3i32)))))

	(fn word_bit_count_type
		(:doc "Return the bit count's exact operand type, or zero for another operation.")
		(params (kind u32)) (returns u32)
		(body
			(if
				(:doc "The bit-count opcodes occupy their own interval.")
				(bool:or (u32:lt kind bit_count_base) (u32:not-lt kind bit_count_limit))
				(then (return 0u32)))
			(return (call integer_operator_type (u32:shr (u32:sub kind bit_count_base) 2i32)))))

	(fn word_bit_count_slot
		(:doc "Read a checked bit count's operation as leading, trailing, or population.")
		(params (kind u32)) (returns u8)
		(body (return (u8:from-u32 (u32:and kind 3u32)))))

	(fn word_mask_type
		(:doc "Return the exact integer type of a mask or complement, or zero.")
		(params (kind u32))
		(returns u32)
		(body
			(if
				(:doc "The low four slots have same-type operand rules.")
				(u32:not-lt complement_slot (u32:and kind 7u32))
				(then (return (call word_type kind))))
			(return 0u32)))

	(fn word_mask_symbol
		(:doc "Get the C operator for a checked mask or complement.")
		(params (kind u32))
		(returns u8)
		(body (return (array:load mask_symbols (i32:from-u32 (u32:and kind 3u32))))))

	(fn word_count_type
		(:doc "Return the exact type of a shift or rotate word, or zero.")
		(params (kind u32))
		(returns u32)
		(body
			(if
				(:doc "The two shifts and two rotations take counts.")
				(u32:not-lt (u32:and kind 7u32) shift_left_slot)
				(then (return (call word_type kind))))
			(return 0u32)))

	(fn word_rotates
		(:doc "Check whether a counted word operation is a rotation.")
		(params (kind u32))
		(returns bool)
		(body (return (u32:not-lt (u32:and kind 7u32) rotate_left_slot))))

	(fn word_moves_right
		(:doc "Read the direction of a counted word operation. The odd slots move right.")
		(params (kind u32))
		(returns bool)
		(body (return (u32:not-eqz (u32:and kind 1u32)))))
)
