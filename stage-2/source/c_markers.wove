(module source_c_markers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Validate zero-operand markers on selected C bridge declarations.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_arguments.wove" (only matches_pragma (value macro_directive)))

	(struct CMarker (fields (present bool) (start i32) (end i32) (error u32)))
	(let optional_pragma "c_optional")
	(let lossless_macro_pragma "c_macro_lossless")
	(let macro_discard_pragma "c_macro_discard")
	(let macro_integer_pragma "c_macro_integer_literal")
	(let static_mut_cstr_pragma "c_static_mut_cstr")

	(fn read_c_marker
		(:doc "Check one zero-operand marker in a declaration's attached pragma entries.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts)
			(spelling (shared-array u8)))
		(returns CMarker)
		(body
			(let-mut present (bool false))
			(let-mut index (struct:get declaration metadata))
			(while
				(:doc "Traverse attached metadata in source order, including interleaved function metadata.")
				(i32:lt -1i32 index)
				(body
					(let entry (array:load nodes index))
					(let head (array:load nodes (struct:get entry first_child)))
					(if
						(:doc "Only pragma entries can carry a native marker.")
						(u32:eq (call source_keyword (borrow-shared source) head) 3u32)
						(then
							(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) entry))
							(let-mut directive (struct:get parts operands))
							(while
								(:doc "Find the exact marker while leaving other contracts to their own readers.")
								(i32:lt -1i32 directive)
								(body
									(let item (array:load nodes directive))
									(let form (call form_parts (borrow-shared source) (borrow-shared nodes) item))
									(let tag (struct:get form head))
									(if
										(:doc "Match the complete marker name at the directive head.")
										(bool:and (i32:lt -1i32 tag)
											(call matches_pragma (borrow-shared source)
												(array:load nodes tag) (borrow-shared spelling)))
										(then
											(if
												(:doc "An argument or a repeated marker is diagnosed at its own form.")
												(bool:or present (i32:lt -1i32 (struct:get form operands)))
												(then (return (struct:new CMarker (present (bool false))
													(start (struct:get item start)) (end (struct:get item end)) (error 23u32)))))
											(set present (bool true))))
									(set directive (struct:get item next_sibling))))))
					(set index (call next_form_metadata (borrow-shared source)
						(borrow-shared nodes) declaration entry))))
			(return (struct:new CMarker (present present) (start 0i32) (end 0i32) (error 0u32)))))

	(fn read_c_macro_discard
		(:doc "Recognize a macro formal whose captured borrow is only evaluated for its effects.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared source) (borrow-shared nodes)
			formal (borrow-shared macro_discard_pragma)))))

	(fn read_c_macro_integer_literal
		(:doc "Recognize a macro formal whose value must appear as one native integer token.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared source) (borrow-shared nodes)
			formal (borrow-shared macro_integer_pragma)))))

	(fn read_c_optional
		(:doc "Recognize the availability marker on a checked C bridge declaration.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared source) (borrow-shared nodes)
			declaration (borrow-shared optional_pragma)))))

	(fn read_c_static_mut_cstr
		(:doc "Require an explicit writable C-string storage contract on a native lvalue.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared source) (borrow-shared nodes)
			declaration (borrow-shared static_mut_cstr_pragma)))))

	(fn read_c_lossless_macro
		(:doc "Recognize a read-only integer macro with a lossless declared destination.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared source) (borrow-shared nodes)
			declaration (borrow-shared lossless_macro_pragma)))))

	(fn read_c_value_macro
		(:doc "Recognize the expression marker on a read-only C value.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared source) (borrow-shared nodes)
			declaration (borrow-shared macro_directive))))))
