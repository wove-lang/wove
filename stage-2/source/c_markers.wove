(module source_c_markers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Validate zero-operand markers on selected C bridge declarations.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_metadata source_keyword (type FormParts)))
	(use wove-file "./c_arguments.wove" (only matches_pragma (value macro_directive)))

	(struct CMarker (fields (present bool) (start i32) (end i32) (error u32)))
	(let optional_pragma "c_optional")
	(let macro_discard_pragma "c_macro_discard")

	(fn read_c_marker
		(:doc "Check one zero-operand marker in a declaration's attached pragma entries.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts)
			(spelling (shared-array u8)))
		(returns CMarker)
		(body
			(let-mut present (bool false))
			(let-mut index (struct.get (local declaration) metadata))
			(while
				(:doc "Traverse attached metadata in source order, including interleaved function metadata.")
				(i32.lt -1i32 (local index))
				(body
					(let entry (array.load (local nodes) (local index)))
					(let head (array.load (local nodes) (struct.get (local entry) first_child)))
					(if
						(:doc "Only pragma entries can carry a native marker.")
						(u32.eq (call source_keyword (borrow-shared (local source)) (local head)) 3u32)
						(then
							(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local entry)))
							(let-mut directive (struct.get (local parts) operands))
							(while
								(:doc "Find the exact marker while leaving other contracts to their own readers.")
								(i32.lt -1i32 (local directive))
								(body
									(let item (array.load (local nodes) (local directive)))
									(let form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
									(let tag (struct.get (local form) head))
									(if
										(:doc "Match the complete marker name at the directive head.")
										(bool.and (i32.lt -1i32 (local tag))
											(call matches_pragma (borrow-shared (local source))
												(array.load (local nodes) (local tag)) (borrow-shared (local spelling))))
										(then
											(if
												(:doc "An argument or a repeated marker is diagnosed at its own form.")
												(bool.or (local present) (i32.lt -1i32 (struct.get (local form) operands)))
												(then (return (struct.new CMarker (present (bool false))
													(start (struct.get (local item) start)) (end (struct.get (local item) end)) (error 23u32)))))
											(set (local present) (bool true))))
									(set (local directive) (struct.get (local item) next_sibling))))))
					(set (local index) (call next_form_metadata (borrow-shared (local source))
						(borrow-shared (local nodes)) (local declaration) (local entry)))))
			(return (struct.new CMarker (present (local present)) (start 0i32) (end 0i32) (error 0u32)))))

	(fn read_c_macro_discard
		(:doc "Recognize a macro formal whose captured borrow is only evaluated for its effects.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (formal FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared (local source)) (borrow-shared (local nodes))
			(local formal) (borrow-shared (local macro_discard_pragma))))))

	(fn read_c_optional
		(:doc "Recognize the optional availability marker on a C bridge function.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared (local source)) (borrow-shared (local nodes))
			(local declaration) (borrow-shared (local optional_pragma))))))

	(fn read_c_value_macro
		(:doc "Recognize the expression marker on a read-only C value.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration FormParts))
		(returns CMarker)
		(body (return (call read_c_marker (borrow-shared (local source)) (borrow-shared (local nodes))
			(local declaration) (borrow-shared (local macro_directive)))))))
