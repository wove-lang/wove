			(if
				(:doc "Both initialization contracts preserve the native i32 status.")
				(bool:and (i32:gtz (struct:get contracts initializers))
					(u32:not-eq (call source_builtin_type (borrow-shared source) result_node) 5u32))
				(then (return (call c_member_error (struct:get result_node start) (struct:get result_node end) 23u32))))
