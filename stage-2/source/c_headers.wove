						(then (return (call c_member_error (struct:get literal start)
							(struct:get literal end) (struct:get literal error)))))
					(if
						(:doc "A literal-token formal needs a function-like macro and a Wove integer range.")
						(bool:and (struct:get literal present)
							(bool:not (bool:and (struct:get macro_marker present)
								(bool:and (bool:not fixed) (call is_builtin_integer_value
									(call source_builtin_type (borrow-shared source) (array:get nodes type)))))))
						(then (return (call c_member_error (struct:get item start) (struct:get item end) 23u32))))
					(if
						(:doc "A fixed C command has its own checked shape and consumes no Wove argument slot.")
						fixed
