			(return type)))

	(fn read_c_result
		(:doc `Resolve ordinary and borrowed native results. A copied snapshot needs no native result type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32)
			(context SelectionContext) (snapshot bool) (provenance bool))
