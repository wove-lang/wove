					(let name_start (struct:get named start))
					(let name_end (struct:get named end))
					(if
						(:doc "Foreign formal names are still Wove identifiers.")
						(bool:not (call is_native_name (borrow-shared source) named))
						(then (return (call c_member_error name_start name_end 23u32))))
					(let-mut earlier first_parameter)
					(while
						(:doc "Only parameters already checked in this signature can conflict with the current name.")
						(i32:not-eq earlier parameter)
