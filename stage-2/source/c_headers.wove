										(i32:ltz (struct:get handle drop_start))))
									(let type_form (call form_parts (borrow-shared source) (borrow-shared nodes) type_node))
									(let mode (call reference_mode (borrow-shared source) (borrow-shared nodes)
										(struct:get type_form head)))
