	(fn read_c_function
		(:doc `Check the selected foreign function's parameter and result forms and retain its exact signature.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declaration i32) (form SourceNode) (parts FormParts) (bridge i32) (context SelectionContext))
