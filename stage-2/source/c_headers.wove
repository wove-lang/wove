	(fn read_c_nullable_record
		(:doc "Resolve an optional shared reference to a complete native record.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32)
			(context SelectionContext)) (returns CMemberRead)
