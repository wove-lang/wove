(module source_c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Find active C header declarations in the supplied Wove source table.

	Compare decoded header keys exactly. Keep the declaring file, original
	tree row and raw spellings for later type checking and native emission.`)

	(use wove-file "./scan.wove"
		(only (type SourceNode) (type Token) is_head_byte check_source_form build_source_tree check_source_metadata))
	(use wove-file "./module.wove" (only (type SelectedDeclaration) form_parts is_three_bytes read_module select_form skip_disabled_siblings validate_form_metadata))
	(use wove-file "./imports.wove" (only import_keyword import_form))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./c_owners.wove" (only is_native_name check_c_owner))
	(use wove-file "./c_arguments.wove" (only c_byte_slice_type read_c_arguments (type CArgument)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct HeaderMatch (fields (file i32) (node i32) (start i32) (end i32) (error u32)))
	(struct CMemberRead
		(fields (declaration i32) (native_start i32) (native_end i32) (signature_start i32) (signature_end i32)
			(start i32) (end i32) (error u32) (owner_type i32) (drop_start i32) (drop_end i32)
			(type_start i32) (type_end i32)))
	(struct CMemberLookup (fields (declaration i32) (start i32) (end i32) (error u32)))

	(fn header_match
		(:doc `Record a header's defining file, declaration row, and original literal span.`)
		(params (file i32) (node i32) (start i32) (end i32) (error u32))
		(returns HeaderMatch)
		(body
			(return (record.make HeaderMatch (file (local file)) (node (local node))
				(start (local start)) (end (local end)) (error (local error))))))

	(fn matches_header
		(:doc `Compare a checked quoted header spelling with its decoded import key.`)
		(params (source (shared-slice u8)) (literal SourceNode) (key (shared-slice u8)))
		(returns bool)
		(body
			(let start (record.get (local literal) start))
			(let end (record.get (local literal) end))
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(record.make Token (kind (u32 2)) (start (local start)) (end (local end)) (error (u32 0)))
				(borrow-mut (local decoded))))
			(return (bool.and (u32.eq (record.get (local value) error) (u32 0))
				(call same_bytes (borrow-shared (local decoded)) (i32 0) (record.get (local value) written)
					(borrow-shared (local key)) (i32 0) (slice.len (local key)))))))

	(fn matching_bridge_header
		(:doc `Read the header token of an active c-header bridge when it matches the requested key.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (item SourceNode) (key (shared-slice u8)))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(let head (record.get (local parts) head))
			(let provider (record.get (local parts) operands))
			(if
				(:doc "Only a bridge with a bare c-header provider has a header key here.")
				(bool.or (i32.lt (local provider) (i32 0))
					(bool.not (u32.eq (call import_keyword (borrow-shared (local source))
						(slice.load (local nodes) (local head))) (u32 9))))
				(then (return (i32 -1))))
			(let prefix (slice.load (local nodes) (local provider)))
			(let header (record.get (local prefix) next_sibling))
			(if
				(:doc "The provider is followed by its source string token.")
				(bool.or (i32.lt (local header) (i32 0))
					(bool.not (u32.eq (call import_keyword (borrow-shared (local source)) (local prefix)) (u32 8))))
				(then (return (i32 -1))))
			(let literal (slice.load (local nodes) (local header)))
			(if
				(:doc "Decode only quoted or raw string tokens before comparing the requested key.")
				(bool.and (u32.eq (record.get (local literal) kind) (u32 2))
					(call matches_header (borrow-shared (local source)) (local literal) (borrow-shared (local key))))
				(then (return (local header))))
			(return (i32 -1))))

	(fn find_file_header
		(:doc `Look for one key among the selected declarations in a checked source tree.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (count i32) (file i32) (key (shared-slice u8)))
		(returns HeaderMatch)
		(body
			(let-mut found (i32 -1))
			(let-mut start (i32 0))
			(let-mut end (i32 0))
			(let-mut index (i32 0))
			(while
				(:doc "Only selected declarations in this module can provide a header.")
				(i32.lt (local index) (local count))
				(body
					(let row (record.get (slice.load (local declarations) (local index)) node))
					(let header (call matching_bridge_header (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local nodes) (local row)) (borrow-shared (local key))))
					(if
						(:doc "A second declaration of the same header key is ambiguous.")
						(bool.not (i32.lt (local header) (i32 0)))
						(then
							(let literal (slice.load (local nodes) (local header)))
							(set (local start) (record.get (local literal) start))
							(set (local end) (record.get (local literal) end))
							(if
								(:doc "Report an ambiguous provider at its later header literal.")
								(bool.not (i32.lt (local found) (i32 0)))
								(then (return (call header_match (local file) (i32 -1) (local start) (local end) (u32 30)))))
							(set (local found) (local row))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call header_match (local file) (local found) (local start) (local end) (u32 0)))))

	(fn read_file_header
		(:doc `Find a matching active header before reporting structural errors in its provider.

		The form check supplies a navigable tree for discovery. A supplied
		file with a different key does not participate in this lookup.`)
		(params (source (shared-slice u8)) (file i32) (key (shared-slice u8)) (bootstrap bool))
		(returns HeaderMatch)
		(body
			(let checked (call check_source_form (borrow-shared (local source))))
			(if
				(:doc "Only well-formed supplied sources can contribute a bridge.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (call header_match (local file) (i32 -1) (i32 0) (i32 0) (u32 0)))))
			(let count (int.convert i32 (record.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local count)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let-mut selected (array.alloc SelectedDeclaration (local count)))
			(let module (call read_module (borrow-shared (local source)) (borrow-shared (local nodes)) (local built) (local bootstrap)
				(borrow-mut (local selected))))
			(if
				(:doc "A module must provide a selected declaration before it can match the key.")
				(bool.or (bool.not (record.get (local module) active)) (u32.lt (u32 0) (record.get (local module) error)))
				(then (return (call header_match (local file) (i32 -1) (i32 0) (i32 0) (u32 0)))))
			(let match (call find_file_header (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local selected)) (record.get (local module) count) (local file) (borrow-shared (local key))))
			(if
				(:doc "A file with no matching key supplies no diagnostic to this import.")
				(bool.and (i32.lt (record.get (local match) node) (i32 0)) (u32.eq (record.get (local match) error) (u32 0)))
				(then (return (local match))))
			(let metadata (call check_source_metadata (borrow-shared (local source)) (local built) (borrow-shared (local nodes))))
			(if
				(:doc "The matching provider keeps the original structural error before binding any member.")
				(u32.lt (u32 0) (record.get (local metadata) error))
				(then (return (call header_match (local file) (i32 -1)
					(record.get (local metadata) start) (record.get (local metadata) end) (record.get (local metadata) error)))))
			(return (local match))))

	(fn find_c_header
		(:doc `Resolve a decoded key across canonical supplied sources without following their Wove import edges.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (key (shared-slice u8)) (bootstrap bool))
		(returns HeaderMatch)
		(body
			(let-mut file (i32 0))
			(let-mut defining_file (i32 -1))
			(let-mut node (i32 -1))
			(let-mut start (i32 0))
			(let-mut end (i32 0))
			(while
				(:doc "Alternate virtual paths do not contribute extra bridge declarations.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(let input (slice.load (local files) (local file)))
					(if
						(:doc "Inspect each supplied canonical source at most once per key lookup.")
						(i32.eq (record.get (local input) identity) (local file))
						(then
							(let match (call read_file_header
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start) (record.get (local input) source_end)))
								(local file) (borrow-shared (local key)) (local bootstrap)))
							(if
								(:doc "Keep an error from a matching source at its original span.")
								(u32.lt (u32 0) (record.get (local match) error))
								(then (return (local match))))
							(if
								(:doc "Track the single definition of the requested header key.")
								(bool.not (i32.lt (record.get (local match) node) (i32 0)))
								(then
									(set (local start) (record.get (local match) start))
									(set (local end) (record.get (local match) end))
									(if
										(:doc "Two active declarations of this key cannot select one provider.")
										(bool.not (i32.lt (local defining_file) (i32 0)))
										(then (return (call header_match (local file) (i32 -1) (local start) (local end) (u32 30)))))
									(set (local defining_file) (local file))
									(set (local node) (record.get (local match) node))))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (call header_match (local defining_file) (local node) (local start) (local end) (u32 0)))))

	(fn c_member_error
		(:doc `Package an unavailable or rejected declaration without publishing signature spans.`)
		(params (start i32) (end i32) (error u32))
		(returns CMemberRead)
		(body
			(return (record.make CMemberRead (declaration (i32 -1)) (native_start (i32 -1)) (native_end (i32 -1))
				(signature_start (i32 -1)) (signature_end (i32 -1)) (start (local start)) (end (local end)) (error (local error))
				(owner_type (i32 0)) (drop_start (i32 0)) (drop_end (i32 0)) (type_start (i32 0)) (type_end (i32 0))))))

	(fn is_c_scalar
		(:doc `Accept one of the exact scalar types supported by the Stage 2 value ABI.`)
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(let type (call source_builtin_type (borrow-shared (local source)) (local node)))
			(return (bool.or (u32.eq (local type) (u32 5))
				(bool.and (u32.lt (u32 9) (local type)) (u32.lt (local type) (u32 13)))))))

	(fn read_c_named_resource
		(:doc `Resolve an exact resource name in the defining bridge's type namespace.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (bootstrap bool))
		(returns CMemberRead)
		(body
			(let start (record.get (local node) start))
			(let end (record.get (local node) end))
			(let resource (call find_c_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bridge) (borrow-shared (local source)) (local start) (local end) (local bootstrap)))
			(if
				(:doc "An unavailable resource is diagnosed at the original type name.")
				(bool.and (u32.eq (record.get (local resource) error) (u32 0))
					(i32.lt (record.get (local resource) declaration) (i32 0)))
				(then (return (call c_member_error (local start) (local end) (u32 23)))))
			(return (local resource))))

	(fn read_c_result_resource
		(:doc `Use an empty resource contract for a scalar or resolve the named result type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (bootstrap bool))
		(returns CMemberRead)
		(body
			(if
				(:doc "Scalar results need no resource declaration.")
				(call is_c_scalar (borrow-shared (local source)) (local node))
				(then (return (call c_member_error (i32 0) (i32 0) (u32 0)))))
			(return (call read_c_named_resource (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local bridge) (local bootstrap)))))

	(fn is_shared_ref_head
		(:doc `Match the full shared-ref spelling at a parameter type's head.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (head i32))
		(returns bool)
		(body
			(if
				(:doc "A bare type has no form head.")
				(i32.lt (local head) (i32 0))
				(then (return (bool false))))
			(let node (slice.load (local nodes) (local head)))
			(let start (record.get (local node) start))
			(return (bool.and (i32.eq (i32.sub.wrapping (record.get (local node) end) (local start)) (i32 10))
				(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) (u8 115) (u8 104) (u8 97))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) (i32 3))
						(u8 114) (u8 101) (u8 100))
						(bool.and (call is_three_bytes (borrow-shared (local source)) (i32.add.wrapping (local start) (i32 6))
							(u8 45) (u8 114) (u8 101))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 9) (u8 102)))))))))

	(fn read_c_handle_parameter
		(:doc `Read one shared reference to an active pointer resource in this C bridge.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (bootstrap bool))
		(returns CMemberRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (record.get (local parts) head))
			(let target (record.get (local parts) operands))
			(if
				(:doc "A shared handle parameter needs the shared-ref tag and exactly one type operand.")
				(bool.or (bool.not (call is_shared_ref_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local head)))
					(bool.or (i32.lt (local target) (i32 0))
						(bool.not (i32.lt (record.get (slice.load (local nodes) (local target)) next_sibling) (i32 0)))))
				(then (return (call c_member_error (record.get (local node) start) (record.get (local node) end) (u32 23)))))
			(let choice (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local parts)))
			(if
				(:doc "Selection directives belong on declarations.")
				(u32.lt (u32 0) (record.get (local choice) error))
				(then (return (call c_member_error (record.get (local choice) start) (record.get (local choice) end)
					(record.get (local choice) error)))))
			(let name (slice.load (local nodes) (local target)))
			(if
				(:doc "The referenced resource must be a bare name.")
				(bool.not (u32.eq (record.get (local name) kind) (u32 1)))
				(then (return (call c_member_error (record.get (local name) start) (record.get (local name) end) (u32 23)))))
			(return (call read_c_named_resource (borrow-shared (local source)) (borrow-shared (local nodes))
				(local name) (local bridge) (local bootstrap)))))

	(fn read_c_function
		(:doc `Check the selected foreign function's parameter and result forms and retain its exact signature.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declaration i32) (name SourceNode) (form SourceNode) (params i32) (bridge i32) (bootstrap bool))
		(returns CMemberRead)
		(body
			(let start (record.get (local form) start))
			(let end (record.get (local form) end))
			(if
				(:doc "The defining name must be a portable C symbol.")
				(bool.not (call is_native_name (borrow-shared (local source)) (local name)))
				(then (return (call c_member_error (record.get (local name) start) (record.get (local name) end) (u32 26)))))
			(if
				(:doc "A foreign declaration needs params followed by returns.")
				(i32.lt (local params) (i32 0))
				(then (return (call c_member_error (local start) (local end) (u32 23)))))
			(let params_node (slice.load (local nodes) (local params)))
			(let returns (record.get (local params_node) next_sibling))
			(if
				(:doc "A missing returns form leaves the declaration incomplete.")
				(i32.lt (local returns) (i32 0))
				(then (return (call c_member_error (local start) (local end) (u32 23)))))
			(let returns_node (slice.load (local nodes) (local returns)))
			(let extra (record.get (local returns_node) next_sibling))
			(if
				(:doc "C bridge signatures end at their result type.")
				(bool.not (i32.lt (local extra) (i32 0)))
				(then
					(let item (slice.load (local nodes) (local extra)))
					(return (call c_member_error (record.get (local item) start) (record.get (local item) end) (u32 23)))))
			(let form_params (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local params_node) (u32 10)))
			(let form_returns (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local returns_node) (u32 11)))
			(if
				(:doc "Surface a malformed params form or directive at its original span.")
				(u32.lt (u32 0) (record.get (local form_params) error))
				(then (return (call c_member_error (record.get (local form_params) start) (record.get (local form_params) end)
					(record.get (local form_params) error)))))
			(if
				(:doc "Surface a malformed returns form or directive at its original span.")
				(u32.lt (u32 0) (record.get (local form_returns) error))
				(then (return (call c_member_error (record.get (local form_returns) start) (record.get (local form_returns) end)
					(record.get (local form_returns) error)))))
			(let result (record.get (local form_returns) first))
			(if
				(:doc "The result form supplies one scalar or named resource type.")
				(bool.or (i32.lt (local result) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local result)) next_sibling) (i32 0))))
				(then (return (call c_member_error (record.get (local returns_node) start) (record.get (local returns_node) end) (u32 23)))))
			(let resource (call read_c_result_resource (borrow-shared (local source)) (borrow-shared (local nodes))
				(slice.load (local nodes) (local result)) (local bridge) (local bootstrap)))
			(if (u32.lt (u32 0) (record.get (local resource) error)) (then (return (local resource))))
			(let first_parameter (record.get (local form_params) first))
			(let-mut parameter (local first_parameter))
			(let-mut count (i32 0))
			(while
				(:doc "Each parameter has one supported type and a unique name in this signature.")
				(bool.not (i32.lt (local parameter) (i32 0)))
				(body
					(let item (slice.load (local nodes) (local parameter)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let type (record.get (local parts) operands))
					(if
						(:doc "A missing or extra operand is diagnosed at the parameter form.")
						(bool.or (i32.lt (local type) (i32 0))
							(bool.not (i32.lt (record.get (slice.load (local nodes) (local type)) next_sibling) (i32 0))))
						(then (return (call c_member_error (record.get (local item) start) (record.get (local item) end) (u32 23)))))
					(let choice (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local item) (local parts)))
					(if
						(:doc "A parameter cannot apply declaration selection.")
						(u32.lt (u32 0) (record.get (local choice) error))
						(then (return (call c_member_error (record.get (local choice) start) (record.get (local choice) end)
							(record.get (local choice) error)))))
					(let type_node (slice.load (local nodes) (local type)))
					(if
						(:doc "Other supported formals borrow a named pointer resource from this bridge.")
						(bool.not (bool.or (call is_c_scalar (borrow-shared (local source)) (local type_node))
							(u32.lt (u32 0) (call c_byte_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))))
						(then
							(let handle (call read_c_handle_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
								(local type_node) (local bridge) (local bootstrap)))
							(if
								(:doc "Preserve type lookup and contract errors from the defining source.")
								(u32.lt (u32 0) (record.get (local handle) error))
								(then (return (local handle))))))
					(let name (slice.load (local nodes) (record.get (local parts) head)))
					(let name_start (record.get (local name) start))
					(let name_end (record.get (local name) end))
					(let-mut earlier (local first_parameter))
					(while
						(:doc "Only parameters already checked in this signature can conflict with the current name.")
						(bool.not (i32.eq (local earlier) (local parameter)))
						(body
							(let previous (slice.load (local nodes) (local earlier)))
							(let previous_name (slice.load (local nodes) (record.get (local previous) first_child)))
							(if
								(:doc "Report the second occurrence at its exact name, after checking its type.")
								(call same_bytes (borrow-shared (local source))
									(record.get (local previous_name) start) (record.get (local previous_name) end)
									(borrow-shared (local source)) (local name_start) (local name_end))
								(then (return (call c_member_error (local name_start) (local name_end) (u32 33)))))
							(set (local earlier) (record.get (local previous) next_sibling))))
					(set (local parameter) (record.get (local item) next_sibling))
					(set (local count) (i32.add.wrapping (local count) (i32 1)))))
			(let-mut arguments (array.alloc CArgument (local count)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)))
			(let contracts (call read_c_arguments (borrow-shared (local source)) (borrow-shared (local nodes))
				(local parts) (local first_parameter) (borrow-mut (local arguments))))
			(if
				(:doc "Keep a bad argument contract at its original defining span.")
				(u32.lt (u32 0) (record.get (local contracts) error))
				(then (return (call c_member_error (record.get (local contracts) start) (record.get (local contracts) end)
					(record.get (local contracts) error)))))
			(return (record.make CMemberRead (declaration (local declaration))
				(native_start (record.get (local name) start)) (native_end (record.get (local name) end))
				(signature_start (record.get (local params_node) start)) (signature_end (record.get (local returns_node) end))
				(start (local start)) (end (local end)) (error (u32 0))
				(owner_type (record.get (local resource) owner_type))
				(drop_start (record.get (local resource) drop_start)) (drop_end (record.get (local resource) drop_end))
				(type_start (record.get (local resource) type_start)) (type_end (record.get (local resource) type_end))))))

	(fn find_c_member
		(:doc `Find an active member in the requested namespace under the defining bridge.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (bridge_row i32) (tag u32)
			(spelling (shared-slice u8)) (start i32) (end i32) (bootstrap bool))
		(returns CMemberLookup)
		(body
			(let bridge (slice.load (local nodes) (local bridge_row)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local bridge)))
			(let provider (slice.load (local nodes) (record.get (local parts) operands)))
			(let literal (slice.load (local nodes) (record.get (local provider) next_sibling)))
			(let-mut member (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local literal) next_sibling)))
			(let-mut found (i32 -1))
			(while
				(:doc "An active member with the selected spelling contributes one definition.")
				(bool.not (i32.lt (local member) (i32 0)))
				(body
					(let item (slice.load (local nodes) (local member)))
					(let form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let head (record.get (local form) head))
					(let-mut name (record.get (local form) name))
					(if
						(:doc "A bridge type stores its name as the first ordinary operand.")
						(u32.eq (local tag) (u32 6))
						(then (set (local name) (record.get (local form) operands))))
					(if
						(:doc "Only members with the requested tag participate in the lookup.")
						(bool.and (bool.not (i32.lt (local head) (i32 0)))
							(bool.and (bool.not (i32.lt (local name) (i32 0)))
								(u32.eq (call import_keyword (borrow-shared (local source)) (slice.load (local nodes) (local head))) (local tag))))
						(then
							(let named (slice.load (local nodes) (local name)))
							(let from (record.get (local named) start))
							(let to (record.get (local named) end))
							(if
								(:doc "Match the original bare name before checking this member's signature.")
								(bool.and (u32.eq (record.get (local named) kind) (u32 1))
									(call same_bytes (borrow-shared (local source)) (local from) (local to)
										(borrow-shared (local spelling)) (local start) (local end)))
								(then
									(let choice (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
										(local item) (local form) (bool true) (local bootstrap)))
									(if
										(:doc "Keep malformed selection metadata at its defining span.")
										(u32.lt (u32 0) (record.get (local choice) error))
										(then (return (record.make CMemberLookup (declaration (i32 -1)) (start (record.get (local choice) start))
												(end (record.get (local choice) end)) (error (record.get (local choice) error))))))
									(if
										(:doc "Excluded members never reserve the spelling.")
										(record.get (local choice) active)
										(then
											(if
												(:doc "A duplicate active definition would make this selection ambiguous.")
												(bool.not (i32.lt (local found) (i32 0)))
												(then (return (record.make CMemberLookup (declaration (i32 -1)) (start (local from))
												(end (local to)) (error (u32 30))))))
											(set (local found) (local member))))))))
					(set (local member) (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
						(record.get (local item) next_sibling)))))
			(return (record.make CMemberLookup (declaration (local found)) (start (i32 0)) (end (i32 0)) (error (u32 0))))))

	(fn find_c_type
		(:doc `Resolve a selected pointer-backed type and retain its native annotation and destructor spans.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (bridge i32)
			(spelling (shared-slice u8)) (start i32) (end i32) (bootstrap bool))
		(returns CMemberRead)
		(body
			(let found (call find_c_member (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bridge) (u32 6) (borrow-shared (local spelling)) (local start) (local end) (local bootstrap)))
			(let declaration (record.get (local found) declaration))
			(if
				(:doc "Propagate a failed lookup or leave the requested name unavailable.")
				(i32.lt (local declaration) (i32 0))
				(then (return (call c_member_error (record.get (local found) start) (record.get (local found) end)
					(record.get (local found) error)))))
			(let node (slice.load (local nodes) (local declaration)))
			(let checked (call check_c_owner (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(if
				(:doc "The contract's invalid annotation lives in the defining source.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (call c_member_error (record.get (local checked) start) (record.get (local checked) end)
					(record.get (local checked) error)))))
			(let native (slice.load (local nodes) (record.get (local checked) native)))
			(let drop (slice.load (local nodes) (record.get (local checked) drop)))
			(return (record.make CMemberRead (declaration (local declaration))
				(native_start (record.get (local native) start)) (native_end (record.get (local native) end))
				(signature_start (record.get (local node) start)) (signature_end (record.get (local node) end))
				(start (record.get (local node) start)) (end (record.get (local node) end)) (error (u32 0))
				(owner_type (local declaration)) (drop_start (record.get (local drop) start)) (drop_end (record.get (local drop) end))
				(type_start (record.get (local native) start)) (type_end (record.get (local native) end))))))

	(fn find_c_declaration
		(:doc `Resolve and check a C header's selected function or named pointer type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (header HeaderMatch)
			(spelling (shared-slice u8)) (start i32) (end i32) (namespace u32) (bootstrap bool))
		(returns CMemberRead)
		(body
			(let bridge (record.get (local header) node))
			(if
				(:doc "Each namespace selects only declarations of its own kind.")
				(u32.eq (local namespace) (u32 1))
				(then (return (call find_c_type (borrow-shared (local source)) (borrow-shared (local nodes))
					(local bridge) (borrow-shared (local spelling)) (local start) (local end) (local bootstrap)))))
			(let found (call find_c_member (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bridge) (u32 1) (borrow-shared (local spelling)) (local start) (local end) (local bootstrap)))
			(let index (record.get (local found) declaration))
			(if
				(:doc "An unavailable declaration is diagnosed by the importer at the requested name.")
				(i32.lt (local index) (i32 0))
				(then (return (call c_member_error (record.get (local found) start) (record.get (local found) end)
					(record.get (local found) error)))))
			(let item (slice.load (local nodes) (local index)))
			(let signature (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(return (call read_c_function (borrow-shared (local source)) (borrow-shared (local nodes))
				(local index) (slice.load (local nodes) (record.get (local signature) name)) (local item)
				(record.get (local signature) operands) (local bridge) (local bootstrap))))))
