(module source_c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Find active C header declarations in the supplied Wove source table.

	Compare decoded header keys exactly. Keep the declaring file, original
	tree row and raw spellings for later type checking and native emission.`)

	(use wove-file "./scan.wove"
		(only (type SourceNode) (type Token) check_source_form build_source_tree check_source_metadata))
	(use wove-file "./module.wove"
		(only form_parts select_module_root select_form is_declaration_group next_declaration read_module_for_target
			validate_form_metadata (type FormParts) (type SelectedDeclaration)))
	(use wove-file "./imports.wove" (only import_keyword import_form))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./types.wove" (only source_builtin_type is_builtin_integer reference_mode))
	(use wove-file "./c_owners.wove" (only is_native_name check_c_type))
	(use wove-file "./c_records.wove" (only is_c_record read_c_record))
	(use wove-file "./c_arguments.wove" (only c_byte_slice_type read_c_arguments (type CArgument)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))

	(use wove-file "./target.wove" (only (type SelectionContext)))

	(struct HeaderMatch (fields (file i32) (node i32) (start i32) (end i32) (error u32)))
	(struct CMemberRead
		(fields (declaration i32) (native_start i32) (native_end i32) (signature_start i32) (signature_end i32)
			(start i32) (end i32) (error u32) (native_type i32) (drop_start i32) (drop_end i32)
			(type_start i32) (type_end i32) (namespace u32)))
	(struct CMemberLookup (fields (declaration i32) (start i32) (end i32) (error u32)))

	(fn header_match
		(:doc `Record a header's defining file, declaration row, and original literal span.`)
		(params (file i32) (node i32) (start i32) (end i32) (error u32))
		(returns HeaderMatch)
		(body
			(return (record.make HeaderMatch (file (local file)) (node (local node))
				(start (local start)) (end (local end)) (error (local error))))))

	(fn matches_header
		(:doc `Compare a checked quoted header spelling with its decoded import key.`)
		(params (source (shared-slice u8)) (literal SourceNode) (key (shared-slice u8)))
		(returns bool)
		(body
			(let start (record.get (local literal) start))
			(let end (record.get (local literal) end))
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(record.make Token (kind (u32 2)) (start (local start)) (end (local end)) (error (u32 0)))
				(borrow-mut (local decoded))))
			(return (bool.and (u32.eq (record.get (local value) error) (u32 0))
				(call same_bytes (borrow-shared (local decoded)) (i32 0) (record.get (local value) written)
					(borrow-shared (local key)) (i32 0) (slice.len (local key)))))))

	(fn matching_bridge_header
		(:doc `Compare the decoded key in the declared C header slot, retaining its original row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (parts FormParts) (key (shared-slice u8)))
		(returns i32)
		(body
			(let header (record.get (local parts) header))
			(if
				(:doc "Only a discovered quoted header is a candidate for the requested key.")
				(bool.and (i32.lt (i32 -1) (local header))
					(call matches_header (borrow-shared (local source)) (slice.load (local nodes) (local header)) (borrow-shared (local key))))
				(then (return (local header))))
			(return (i32 -1))))

	(fn has_header_candidate
		(:doc `Identify a file that may provide the requested header before validating its declarations.

		A valid exclusion prunes its subtree. A malformed guard leaves a
		candidate visible so the normal module reader can diagnose it.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (key (shared-slice u8)) (context SelectionContext))
		(returns bool)
		(body
			(let module_row (record.get (slice.load (local nodes) (i32 0)) first_child))
			(let node (slice.load (local nodes) (local module_row)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let module (call select_module_root (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts) (local context)))
			(if
				(:doc "An excluded module or an invalid module header cannot provide this key.")
				(bool.not (bool.or (record.get (local module) active) (u32.eq (record.get (local module) error) (u32 21))))
				(then (return (bool false))))
			(let-mut index (record.get (local parts) operands))
			(while
				(:doc "Visit only declaration lists and stop as soon as the file can be associated with the key.")
				(i32.lt (i32 -1) (local index))
				(body
					(let item (slice.load (local nodes) (local index)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let group (call is_declaration_group (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts)))
					(let-mut next (i32 -1))
					(if
						(:doc "Check guards that can affect the requested key.")
						(bool.or (local group) (i32.lt (i32 -1) (call matching_bridge_header
							(borrow-shared (local source)) (borrow-shared (local nodes)) (local parts) (borrow-shared (local key)))))
						(then
							(let choice (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
								(local item) (local parts) (bool true) (local context)))
							(if
								(:doc "A selected or malformed group can contain the provider. A matching bridge identifies it directly.")
								(bool.or (record.get (local choice) active) (u32.lt (u32 0) (record.get (local choice) error)))
								(then
									(if (bool.not (local group)) (then (return (bool true))))
									(set (local next) (record.get (local parts) operands))))))
					(if
						(:doc "Advance past leaves and excluded or empty groups.")
						(i32.lt (local next) (i32 0))
						(then (set (local next) (call next_declaration (borrow-shared (local nodes)) (local item) (local module_row)))))
					(set (local index) (local next))))
			(return (bool false))))

	(fn find_selected_header
		(:doc `Find a unique provider for the key among the declarations selected by the module reader.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (count i32) (file i32) (key (shared-slice u8)))
		(returns HeaderMatch)
		(body
			(let-mut found (i32 -1))
			(let-mut start (i32 0))
			(let-mut end (i32 0))
			(let-mut index (i32 0))
			(while
				(:doc "Only a selected declaration can supply the header or conflict with an earlier match.")
				(i32.lt (local index) (local count))
				(body
					(let row (record.get (slice.load (local declarations) (local index)) node))
					(let item (slice.load (local nodes) (local row)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let literal (call matching_bridge_header (borrow-shared (local source)) (borrow-shared (local nodes))
						(local parts) (borrow-shared (local key))))
					(if
						(:doc "Keep the original literal span for a unique match or the later duplicate.")
						(i32.lt (i32 -1) (local literal))
						(then
							(let token (slice.load (local nodes) (local literal)))
							(set (local start) (record.get (local token) start))
							(set (local end) (record.get (local token) end))
							(if
								(:doc "Two active bridges in one file cannot supply the same key.")
								(i32.lt (i32 -1) (local found))
								(then (return (call header_match (local file) (i32 -1) (local start) (local end) (u32 30)))))
							(set (local found) (local row))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call header_match (local file) (local found) (local start) (local end) (u32 0)))))

	(fn read_file_header
		(:doc `Locate a candidate provider, validate the whole module, and resolve the selected header.`)
		(params (source (shared-slice u8)) (file i32) (key (shared-slice u8)) (context SelectionContext))
		(returns HeaderMatch)
		(body
			(let checked (call check_source_form (borrow-shared (local source))))
			(if
				(:doc "Only well-formed supplied sources can contribute a bridge.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (call header_match (local file) (i32 -1) (i32 0) (i32 0) (u32 0)))))
			(let count (int.convert i32 (record.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local count)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(if
				(:doc "An unrelated or excluded file contributes no validation diagnostics to this header lookup.")
				(bool.not (call has_header_candidate (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local key)) (local context)))
				(then (return (call header_match (local file) (i32 -1) (i32 0) (i32 0) (u32 0)))))
			(let metadata (call check_source_metadata (borrow-shared (local source)) (local built) (borrow-shared (local nodes))))
			(if
				(:doc "The matching provider keeps the original structural error before binding any member.")
				(u32.lt (u32 0) (record.get (local metadata) error))
				(then (return (call header_match (local file) (i32 -1)
					(record.get (local metadata) start) (record.get (local metadata) end) (record.get (local metadata) error)))))
			(let-mut selected (array.alloc SelectedDeclaration (local count)))
			(let module (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes))
				(local built) (local context) (borrow-mut (local selected))))
			(if
				(:doc "Use normal module validation for every active declaration in the provider, including siblings of the bridge.")
				(u32.lt (u32 0) (record.get (local module) error))
				(then (return (call header_match (local file) (i32 -1)
					(record.get (local module) start) (record.get (local module) end) (record.get (local module) error)))))
			(return (call find_selected_header (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local selected)) (record.get (local module) count) (local file) (borrow-shared (local key))))))

	(fn find_c_header
		(:doc `Resolve a decoded key across canonical supplied sources without following their Wove import edges.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (key (shared-slice u8)) (context SelectionContext))
		(returns HeaderMatch)
		(body
			(let-mut file (i32 0))
			(let-mut defining_file (i32 -1))
			(let-mut node (i32 -1))
			(let-mut start (i32 0))
			(let-mut end (i32 0))
			(while
				(:doc "Alternate virtual paths do not contribute extra bridge declarations.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(let input (slice.load (local files) (local file)))
					(if
						(:doc "Inspect each supplied canonical source at most once per key lookup.")
						(i32.eq (record.get (local input) identity) (local file))
						(then
							(let match (call read_file_header
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start) (record.get (local input) source_end)))
								(local file) (borrow-shared (local key)) (local context)))
							(if
								(:doc "Keep an error from a matching source at its original span.")
								(u32.lt (u32 0) (record.get (local match) error))
								(then (return (local match))))
							(if
								(:doc "Track the single definition of the requested header key.")
								(bool.not (i32.lt (record.get (local match) node) (i32 0)))
								(then
									(set (local start) (record.get (local match) start))
									(set (local end) (record.get (local match) end))
									(if
										(:doc "Two active declarations of this key cannot select one provider.")
										(bool.not (i32.lt (local defining_file) (i32 0)))
										(then (return (call header_match (local file) (i32 -1) (local start) (local end) (u32 30)))))
									(set (local defining_file) (local file))
									(set (local node) (record.get (local match) node))))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (call header_match (local defining_file) (local node) (local start) (local end) (u32 0)))))

	(fn c_member_error
		(:doc `Package an unavailable or rejected declaration without publishing signature spans.`)
		(params (start i32) (end i32) (error u32))
		(returns CMemberRead)
		(body
			(return (record.make CMemberRead (declaration (i32 -1)) (native_start (i32 -1)) (native_end (i32 -1))
				(signature_start (i32 -1)) (signature_end (i32 -1)) (start (local start)) (end (local end)) (error (local error))
				(native_type (i32 0)) (drop_start (i32 0)) (drop_end (i32 0)) (type_start (i32 0)) (type_end (i32 0)) (namespace (u32 0))))))

	(fn is_c_scalar
		(:doc `Accept one of the exact scalar types supported by the Stage 2 value ABI.`)
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(let type (call source_builtin_type (borrow-shared (local source)) (local node)))
			(return (bool.or (u32.eq (local type) (u32 5))
				(bool.and (u32.lt (u32 9) (local type)) (u32.lt (local type) (u32 13)))))))

	(fn read_c_named_type
		(:doc `Resolve an exact native type in the defining bridge's namespace.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let start (record.get (local node) start))
			(let end (record.get (local node) end))
			(let resource (call find_c_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bridge) (borrow-shared (local source)) (local start) (local end) (local context)))
			(if
				(:doc "An unavailable native type is diagnosed at the original type name.")
				(bool.and (u32.eq (record.get (local resource) error) (u32 0))
					(i32.lt (record.get (local resource) declaration) (i32 0)))
				(then (return (call c_member_error (local start) (local end) (u32 23)))))
			(return (local resource))))

	(fn read_c_named_field_type
		(:doc `Resolve a native record field that names another view or a scalar alias in this bridge.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "A field's representation is a bare scalar or record type name.")
				(bool.not (u32.eq (record.get (local node) kind) (u32 1)))
				(then (return (call c_member_error (record.get (local node) start) (record.get (local node) end) (u32 23)))))
			(let type (call read_c_named_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local bridge) (local context)))
			(if
				(:doc "A record value cannot implicitly copy or destroy an embedded pointer owner.")
				(bool.and (u32.eq (record.get (local type) error) (u32 0))
					(i32.lt (i32 -1) (record.get (local type) drop_start)))
				(then (return (call c_member_error (record.get (local node) start) (record.get (local node) end) (u32 23)))))
			(return (local type))))

	(fn read_c_result_type
		(:doc `Use the built-in scalar code or resolve the named native result type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "Scalar results need no resource declaration.")
				(call is_c_scalar (borrow-shared (local source)) (local node))
				(then (return (call c_member_error (i32 0) (i32 0) (u32 0)))))
			(let type (call read_c_named_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local bridge) (local context)))
			(if
				(:doc "Bridge record storage is supplied by reference in this ABI slice.")
				(bool.and (u32.eq (record.get (local type) error) (u32 0))
					(call is_c_record (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local nodes) (record.get (local type) declaration))))
				(then (return (call c_member_error (record.get (local node) start) (record.get (local node) end) (u32 23)))))
			(return (local type))))


	(fn read_c_reference_parameter
		(:doc `Read a record reference or shared handle in its defining C bridge.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let mode (call reference_mode (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
			(let target (record.get (local parts) operands))
			(if
				(:doc "A reference parameter needs a known access mode and exactly one type operand.")
				(bool.or (u32.eq (local mode) (u32 0))
					(bool.or (i32.lt (local target) (i32 0))
						(bool.not (i32.lt (record.get (slice.load (local nodes) (local target)) next_sibling) (i32 0)))))
				(then (return (call c_member_error (record.get (local node) start) (record.get (local node) end) (u32 23)))))
			(let choice (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local parts)))
			(if
				(:doc "Selection directives belong on declarations.")
				(u32.lt (u32 0) (record.get (local choice) error))
				(then (return (call c_member_error (record.get (local choice) start) (record.get (local choice) end)
					(record.get (local choice) error)))))
			(let name (slice.load (local nodes) (local target)))
			(if
				(:doc "The referenced native type must be a bare name.")
				(bool.not (u32.eq (record.get (local name) kind) (u32 1)))
				(then (return (call c_member_error (record.get (local name) start) (record.get (local name) end) (u32 23)))))
			(let checked (call read_c_named_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(local name) (local bridge) (local context)))
			(if (u32.lt (u32 0) (record.get (local checked) error)) (then (return (local checked))))
			(if
				(:doc "Both access modes can reference the complete native record.")
				(call is_c_record (borrow-shared (local source)) (borrow-shared (local nodes))
					(slice.load (local nodes) (record.get (local checked) declaration)))
				(then (return (local checked))))
			(if
				(:doc "Pointer owners support shared loans that pass their existing pointer value.")
				(bool.and (i32.lt (i32 -1) (record.get (local checked) drop_start)) (u32.eq (local mode) (u32 1)))
				(then (return (local checked))))
			(return (call c_member_error (record.get (local name) start) (record.get (local name) end) (u32 23)))))

	(fn read_c_integer_parameter
		(:doc `Resolve a native value parameter in the defining bridge without borrowing it.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let checked (call read_c_named_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local bridge) (local context)))
			(if
				(:doc "Native value parameters in this slice must be integer aliases.")
				(bool.and (u32.eq (record.get (local checked) error) (u32 0))
					(bool.or (i32.lt (i32 -1) (record.get (local checked) drop_start))
						(call is_c_record (borrow-shared (local source)) (borrow-shared (local nodes))
							(slice.load (local nodes) (record.get (local checked) declaration)))))
				(then (return (call c_member_error (record.get (local node) start) (record.get (local node) end) (u32 23)))))
			(return (local checked))))

	(fn read_c_native_parameter
		(:doc `Choose the native value or reference check from the written parameter form.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "Native integer aliases appear as bare names in the defining bridge.")
				(u32.eq (record.get (local node) kind) (u32 1))
				(then (return (call read_c_integer_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
					(local node) (local bridge) (local context)))))
			(return (call read_c_reference_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local bridge) (local context)))))

	(fn read_c_function
		(:doc `Check the selected foreign function's parameter and result forms and retain its exact signature.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declaration i32) (name SourceNode) (form SourceNode) (params i32) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let start (record.get (local form) start))
			(let end (record.get (local form) end))
			(if
				(:doc "The defining name must be a portable C symbol.")
				(bool.not (call is_native_name (borrow-shared (local source)) (local name)))
				(then (return (call c_member_error (record.get (local name) start) (record.get (local name) end) (u32 26)))))
			(if
				(:doc "A foreign declaration needs params followed by returns.")
				(i32.lt (local params) (i32 0))
				(then (return (call c_member_error (local start) (local end) (u32 23)))))
			(let params_node (slice.load (local nodes) (local params)))
			(let returns (record.get (local params_node) next_sibling))
			(if
				(:doc "A missing returns form leaves the declaration incomplete.")
				(i32.lt (local returns) (i32 0))
				(then (return (call c_member_error (local start) (local end) (u32 23)))))
			(let returns_node (slice.load (local nodes) (local returns)))
			(let extra (record.get (local returns_node) next_sibling))
			(if
				(:doc "C bridge signatures end at their result type.")
				(bool.not (i32.lt (local extra) (i32 0)))
				(then
					(let item (slice.load (local nodes) (local extra)))
					(return (call c_member_error (record.get (local item) start) (record.get (local item) end) (u32 23)))))
			(let form_params (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local params_node) (u32 10)))
			(let form_returns (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local returns_node) (u32 11)))
			(if
				(:doc "Surface a malformed params form or directive at its original span.")
				(u32.lt (u32 0) (record.get (local form_params) error))
				(then (return (call c_member_error (record.get (local form_params) start) (record.get (local form_params) end)
					(record.get (local form_params) error)))))
			(if
				(:doc "Surface a malformed returns form or directive at its original span.")
				(u32.lt (u32 0) (record.get (local form_returns) error))
				(then (return (call c_member_error (record.get (local form_returns) start) (record.get (local form_returns) end)
					(record.get (local form_returns) error)))))
			(let result (record.get (local form_returns) first))
			(if
				(:doc "The result form supplies one scalar or named resource type.")
				(bool.or (i32.lt (local result) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local result)) next_sibling) (i32 0))))
				(then (return (call c_member_error (record.get (local returns_node) start) (record.get (local returns_node) end) (u32 23)))))
