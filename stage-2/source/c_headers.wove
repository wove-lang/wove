				(bool:and (i32:not-ltz from)
					(bool:or (struct:get contracts macro) (i32:not-eqz tail)))
				(then (return (call c_member_error (struct:get returns_node start) (struct:get returns_node end) 23u32))))
			(if
				(:doc "Native records returned by value use a fixed function, with its exact prototype.")
				(bool:and (i32:ltz from)
