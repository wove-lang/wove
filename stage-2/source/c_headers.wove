(module source_c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Find active C header declarations in the supplied Wove source table.

	Compare decoded header keys exactly. Keep the declaring file, original
	tree row and raw spellings for later type checking and native emission.`)

	(use wove-file "./scan.wove"
		(only (type SourceNode) (type Token) check_source_form build_source_tree check_source_metadata))
	(use wove-file "./module.wove"
		(only form_parts next_form_operand select_module_root select_form is_declaration_group next_declaration read_module_for_target
			validate_form_metadata (type FormParts) (type SelectedDeclaration)))
	(use wove-file "./imports.wove" (only import_keyword import_form))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./types.wove" (only source_builtin_type void_type is_builtin_integer is_builtin_integer_value is_builtin_float is_builtin_scalar is_16bit_integer is_128bit_integer is_256bit_integer reference_mode (value i64_type)))
	(use wove-file "./owned.wove" (only is_byte_owner_descriptor optional_type_operand))
	(use wove-file "./c_scope.wove" (only read_bridge_policy project_bridge declaring_c_bridge))
	(use wove-file "./c_dependencies.wove" (only find_bridge_type_dependency))
	(use wove-file "./c_markers.wove" (only read_c_optional read_c_value_macro read_c_lossless_macro read_c_macro_discard read_c_macro_integer_literal read_c_static_mut_cstr (type CMarker)))
	(use wove-file "../c/arguments.wove" (only (value c_open_variadic_tail)))
	(use wove-file "./c_formals.wove" (only is_c_fixed_formal read_c_fixed_formal c_formal_name next_c_value_formal find_c_fixed_formal))
	(use wove-file "./functions.wove" (only read_return_origin))
	(use wove-file "./c_names.wove" (only c_function_opening native_symbol_start native_symbol_end))
	(use wove-file "./c_owners.wove" (only is_native_name check_c_type is_c_storage_type is_c_long_double))
	(use wove-file "./c_records.wove" (only is_c_record read_c_record))
	(use wove-file "./c_snapshots.wove" (only read_c_snapshot read_c_value_snapshot))
	(use wove-file "../c/arguments.wove" (only c_value_mode c_storage_init_mode c_handle_init_mode (value c_shared_handle_slot_mode)))
	(use wove-file "./c_arguments.wove" (only c_byte_slice_type read_c_view_type is_c_callback_type read_c_arguments mark_c_argument_type (type CArgument)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(use wove-file "./target.wove" (only (type SelectionContext)))

	(struct HeaderMatch (fields (file i32) (node i32) (start i32) (end i32) (error u32)
		(default_file i32) (default_node i32) (replace bool)))
	(struct CMemberRead
		(fields (declaration i32) (native_start i32) (native_end i32) (signature_start i32) (signature_end i32)
			(start i32) (end i32) (error u32) (native_type i32) (drop_start i32) (drop_end i32)
			(type_start i32) (type_end i32) (namespace u32) (optional bool) (scalar_typedef bool) (value_macro bool) (value_lossless bool) (wove_result_layout bool)))
	(struct CMemberLookup (fields (declaration i32) (start i32) (end i32) (error u32)))

	(fn header_match
		(:doc `Record a header's defining file, declaration row, and original literal span.`)
		(params (file i32) (node i32) (start i32) (end i32) (error u32))
		(returns HeaderMatch)
		(body
			(return (struct:new HeaderMatch (file file) (node node)
				(start start) (end end) (error error)
				(default_file -1i32) (default_node -1i32) (replace (bool false))))))

	(fn matches_header
		(:doc `Compare a checked quoted header spelling with its decoded import key.`)
		(params (source (shared-array u8)) (literal SourceNode) (key (shared-array u8)))
		(returns bool)
		(body
			(let start (struct:get literal start))
			(let end (struct:get literal end))
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let value (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(return (bool:and (u32:eqz (struct:get value error))
				(call same_bytes (borrow-shared decoded) 0i32 (struct:get value written)
					(borrow-shared key) 0i32 (array:len key))))))

	(fn matching_bridge_header
		(:doc `Compare the decoded key in the declared C header slot, retaining its original row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts) (key (shared-array u8)))
		(returns i32)
		(body
			(let header (struct:get parts header))
			(if
				(:doc "Only a discovered quoted header is a candidate for the requested key.")
				(bool:and (i32:lt -1i32 header)
					(call matches_header (borrow-shared source) (array:get nodes header) (borrow-shared key)))
				(then (return header)))
			(return -1i32)))

	(fn has_header_candidate
		(:doc `Identify a file that may provide the requested header before validating its declarations.

		A valid exclusion prunes its subtree. A malformed guard leaves a
		candidate visible so the normal module reader can diagnose it.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (key (shared-array u8)) (context SelectionContext))
		(returns bool)
		(body
			(let module_row (struct:get (array:get nodes 0i32) first_child))
			(let node (array:get nodes module_row))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let module (call select_module_root (borrow-shared source) (borrow-shared nodes)
				node parts context))
			(if
				(:doc "An excluded module or an invalid module header cannot provide this key.")
				(bool:not (bool:or (struct:get module active) (u32:eq (struct:get module error) 21u32)))
				(then (return (bool false))))
			(let-mut index (struct:get parts operands))
			(while
				(:doc "Visit only declaration lists and stop as soon as the file can be associated with the key.")
				(i32:lt -1i32 index)
				(body
					(let item (array:get nodes index))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let group (call is_declaration_group (borrow-shared source) (borrow-shared nodes) parts))
					(let-mut next -1i32)
					(if
						(:doc "Check guards that can affect the requested key.")
						(bool:or group (i32:lt -1i32 (call matching_bridge_header
							(borrow-shared source) (borrow-shared nodes) parts (borrow-shared key))))
						(then
							(let choice (call select_form (borrow-shared source) (borrow-shared nodes)
								item parts (bool true) context))
							(if
								(:doc "A selected or malformed group can contain the provider. A matching bridge identifies it directly.")
								(bool:or (struct:get choice active) (u32:gtz (struct:get choice error)))
								(then
									(if (bool:not group) (then (return (bool true))))
									(set next (struct:get parts operands))))))
					(if
						(:doc "Advance past leaves and excluded or empty groups.")
						(i32:ltz next)
						(then (set next (call next_declaration (borrow-shared source) (borrow-shared nodes) item module_row))))
					(set index next)))
			(return (bool false))))

	(fn find_selected_header
		(:doc `Find a unique provider for the key among the declarations selected by the module reader.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (count i32) (file i32) (key (shared-array u8)))
		(returns HeaderMatch)
		(body
			(let width (array:len key))
			(let system (bool:and (i32:lt 1i32 width)
				(bool:and (u8:eq (array:get key 0i32) 60u8)
					(u8:eq (array:get key (i32:dec width)) 62u8))))
			(let-mut found -1i32)
			(let-mut replace (bool false))
			(let-mut start 0i32)
			(let-mut end 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Only a selected declaration can supply the header or conflict with an earlier match.")
				(i32:lt index count)
				(body
					(let row (struct:get (array:get declarations index) node))
					(let item (array:get nodes row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let literal (call matching_bridge_header (borrow-shared source) (borrow-shared nodes)
						parts (borrow-shared key)))
					(if
						(:doc "Keep the original literal span for a unique match or the later duplicate.")
						(i32:lt -1i32 literal)
						(then
							(let token (array:get nodes literal))
							(set start (struct:get token start))
							(set end (struct:get token end))
							(if
								(:doc "Two active bridges in one file cannot supply the same key.")
								(i32:lt -1i32 found)
								(then (return (call header_match file -1i32 start end 30u32))))
							(let policy (call read_bridge_policy (borrow-shared source) (borrow-shared nodes) parts system))
							(let site (struct:get policy site))
							(if
								(:doc "A malformed replacement marker belongs to its defining bridge.")
								(i32:lt -1i32 site)
								(then
									(let directive (array:get nodes site))
									(return (call header_match file -1i32 (struct:get directive start)
										(struct:get directive end) 23u32))))
							(set replace (struct:get policy replace))
							(set found row)))
					(set index (i32:inc index))))
			(return (struct:new HeaderMatch (file file) (node found) (start start) (end end)
				(error 0u32) (default_file -1i32) (default_node -1i32) (replace replace)))))

	(fn read_file_header
		(:doc `Locate a candidate provider, validate the whole module, and resolve the selected header.`)
		(params (source (shared-array u8)) (file i32) (key (shared-array u8)) (context SelectionContext))
		(returns HeaderMatch)
		(body
			(let checked (call check_source_form (borrow-shared source)))
			(if
				(:doc "Only well-formed supplied sources can contribute a bridge.")
				(u32:gtz (struct:get checked error))
				(then (return (call header_match file -1i32 0i32 0i32 0u32))))
			(let count (i32:from-u32 (struct:get checked rows)))
			(let-mut nodes (array:alloc SourceNode count))
			(let built (call build_source_tree (borrow-shared source) checked (borrow-mut nodes)))
			(if
				(:doc "An unrelated or excluded file contributes no validation diagnostics to this header lookup.")
				(bool:not (call has_header_candidate (borrow-shared source) (borrow-shared nodes)
					(borrow-shared key) context))
				(then (return (call header_match file -1i32 0i32 0i32 0u32))))
			(let metadata (call check_source_metadata (borrow-shared source) built (borrow-shared nodes)))
			(if
				(:doc "The matching provider keeps the original structural error before binding any member.")
				(u32:gtz (struct:get metadata error))
				(then (return (call header_match file -1i32
					(struct:get metadata start) (struct:get metadata end) (struct:get metadata error)))))
			(let-mut selected (array:alloc SelectedDeclaration count))
			(let module (call read_module_for_target (borrow-shared source) (borrow-shared nodes)
				built context (borrow-mut selected)))
			(if
				(:doc "Use normal module validation for every active declaration in the provider, including siblings of the bridge.")
				(u32:gtz (struct:get module error))
				(then (return (call header_match file -1i32
					(struct:get module start) (struct:get module end) (struct:get module error)))))
			(return (call find_selected_header (borrow-shared source) (borrow-shared nodes)
				(borrow-shared selected) (struct:get module count) file (borrow-shared key)))))

	(fn find_header_kind
		(:doc "Find one active provider of the requested provenance and diagnose a later active block.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (key (shared-array u8))
			(context SelectionContext) (bundled bool)) (returns HeaderMatch)
		(body
			(let-mut file 0i32)
			(let-mut found -1i32)
			(let-mut node -1i32)
			(let-mut start 0i32)
			(let-mut end 0i32)
			(let-mut replace (bool false))
			(while
				(:doc "Inspect each canonical supplied source of this provenance once.")
				(i32:lt file (array:len files))
				(body
					(let input (array:get files file))
					(if
						(:doc "The driver explicitly marks bundled sources independently of paths and row order.")
						(bool:and (i32:eq (struct:get input identity) file)
							(bool:or (bool:and bundled (struct:get input bundled))
								(bool:and (bool:not bundled) (bool:not (struct:get input bundled)))))
						(then
							(let match (call read_file_header
								(borrow-shared (array:range arena (struct:get input source_start) (struct:get input source_end)))
								file (borrow-shared key) context))
							(if
								(:doc "Keep provider validation errors in their original file.")
								(u32:gtz (struct:get match error))
								(then (return match)))
							(if
								(:doc "Only active definitions participate in duplicate checks.")
								(i32:lt -1i32 (struct:get match node))
								(then
									(if
										(:doc "Two active blocks of the same provenance are ambiguous.")
										(i32:lt -1i32 node)
										(then (return (call header_match file -1i32
											(struct:get match start) (struct:get match end) 30u32))))
									(set found file)
									(set node (struct:get match node))
									(set start (struct:get match start))
									(set end (struct:get match end))
									(set replace (struct:get match replace))))))
					(set file (i32:inc file))))
			(return (struct:new HeaderMatch (file found) (node node) (start start) (end end)
				(error 0u32) (default_file -1i32) (default_node -1i32) (replace replace)))))

	(fn find_c_header
		(:doc "Resolve the project header first, optionally inheriting one active bundled bridge.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (key (shared-array u8)) (context SelectionContext))
		(returns HeaderMatch)
		(body
			(let project (call find_header_kind (borrow-shared arena) (borrow-shared files)
				(borrow-shared key) context (bool false)))
			(if
				(:doc "A whole replacement has no dependency on the bundled definition.")
				(bool:or (u32:gtz (struct:get project error)) (struct:get project replace))
				(then (return project)))
			(let bundled (call find_header_kind (borrow-shared arena) (borrow-shared files)
				(borrow-shared key) context (bool true)))
			(if
				(:doc "A bundled-only header is the primary scope when no project block is active.")
				(bool:or (i32:ltz (struct:get project node)) (u32:gtz (struct:get bundled error)))
				(then (return bundled)))
			(return (struct:new HeaderMatch (file (struct:get project file)) (node (struct:get project node))
				(start (struct:get project start)) (end (struct:get project end)) (error 0u32)
				(default_file (struct:get bundled file)) (default_node (struct:get bundled node)) (replace (bool false))))))

	(fn c_member_error
		(:doc `Package an unavailable or rejected declaration without publishing signature spans.`)
		(params (start i32) (end i32) (error u32))
		(returns CMemberRead)
		(body
			(return (struct:new CMemberRead (declaration -1i32) (native_start -1i32) (native_end -1i32)
				(signature_start -1i32) (signature_end -1i32) (start start) (end end) (error error)
				(native_type 0i32) (drop_start 0i32) (drop_end 0i32) (type_start 0i32) (type_end 0i32) (namespace 0u32) (optional (bool false)) (scalar_typedef (bool false)) (value_macro (bool false)) (value_lossless (bool false)) (wove_result_layout (bool false))))))

	(fn is_c_scalar
		(:doc `Accept one of the exact scalar types supported by the Stage 2 value ABI.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(let type (call source_builtin_type (borrow-shared source) node))
			(return (bool:or (bool:or (call is_builtin_float type) (call is_16bit_integer type))
				(bool:or (bool:or (bool:or (call is_128bit_integer type) (call is_256bit_integer type))
					(bool:or (u32:eq type 5u32) (u32:eq type i64_type)))
					(bool:and (u32:lt 9u32 type) (u32:lt type 13u32)))))))

	(fn read_c_named_type
		(:doc `Resolve an exact native type in the defining bridge's namespace.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let start (struct:get node start))
			(let end (struct:get node end))
			(let resource (call find_c_type (borrow-shared source) (borrow-shared nodes)
				bridge (borrow-shared source) start end context))
			(if
				(:doc "A native definition or diagnostic from this bridge takes precedence.")
				(bool:or (u32:gtz (struct:get resource error)) (i32:not-ltz (struct:get resource declaration)))
				(then (return resource)))
			(let dependency (call find_bridge_type_dependency (borrow-shared source) (borrow-shared nodes)
				bridge start end))
			(if
				(:doc "Two distinct dependencies with this spelling make the local name ambiguous.")
				(i32:not-ltz (struct:get dependency duplicate))
				(then (return (call c_member_error start end 30u32))))
			(let declaration (struct:get dependency declaration))
			(if
				(:doc "An unavailable native type is diagnosed at the original type name.")
				(i32:ltz declaration)
				(then (return (call c_member_error start end 23u32))))
			(return (call read_c_type_declaration (borrow-shared source) (borrow-shared nodes)
				declaration))))

	(fn read_c_named_field_type
		(:doc `Resolve a native record field that names another view or a scalar alias in this bridge.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "A field's representation is a bare scalar or record type name.")
				(u32:not-eq (struct:get node kind) 1u32)
				(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
			(let type (call read_c_named_type (borrow-shared source) (borrow-shared nodes)
				node bridge context))
			(if
				(:doc "A record value cannot implicitly copy or destroy an embedded pointer owner.")
				(bool:and (u32:eqz (struct:get type error))
					(i32:lt -1i32 (struct:get type drop_start)))
				(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
			(return type)))

	(fn read_c_result_type
		(:doc `Accept a built-in result or resolve the named native result type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "Scalar and void results need no resource declaration.")
				(bool:or (call is_c_scalar (borrow-shared source) node)
					(u32:eq (call source_builtin_type (borrow-shared source) node) (call void_type)))
				(then (return (call c_member_error 0i32 0i32 0u32))))
			(let type (call read_c_named_type (borrow-shared source) (borrow-shared nodes)
				node bridge context))
			(if
				(:doc "Owning native object storage still uses an address-based contract.")
				(bool:and (u32:eqz (struct:get type error))
					(bool:and (i32:lt -1i32 (struct:get type drop_start))
						(call is_c_storage_type (borrow-shared source) (borrow-shared nodes)
							(struct:get type declaration))))
				(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
			(return type)))


	(fn read_c_reference_parameter
		(:doc `Read a reference or borrowed resource in its defining C bridge.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let mode (call reference_mode (borrow-shared source) (borrow-shared nodes) (struct:get parts head)))
			(let target (struct:get parts operands))
			(if
				(:doc "A reference parameter needs a known access mode and exactly one type operand.")
				(bool:or (u32:eqz mode)
					(bool:or (i32:ltz target)
						(i32:not-ltz (struct:get (array:get nodes target) next_sibling))))
				(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
			(let choice (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) node parts))
			(if
				(:doc "Selection directives belong on declarations.")
				(u32:gtz (struct:get choice error))
				(then (return (call c_member_error (struct:get choice start) (struct:get choice end)
					(struct:get choice error)))))
			(let name (array:get nodes target))
			(if
				(:doc "The referenced native type must be a bare name.")
				(u32:not-eq (struct:get name kind) 1u32)
				(then (return (call c_member_error (struct:get name start) (struct:get name end) 23u32))))
			(let scalar (call source_builtin_type (borrow-shared source) name))
			(if
				(:doc "A built-in scalar reference needs no defining bridge type row. Check its argument contract with the other formals.")
				(call is_builtin_scalar scalar)
				(then (return (call c_member_error 0i32 0i32 0u32))))
			(let checked (call read_c_named_type (borrow-shared source) (borrow-shared nodes)
				name bridge context))
			(if (u32:gtz (struct:get checked error)) (then (return checked)))
			(if
				(:doc "Both access modes can reference the complete native record.")
				(call is_c_record (borrow-shared source) (borrow-shared nodes)
					(array:get nodes (struct:get checked declaration)))
				(then (return checked)))
			(if
				(:doc "A native scalar alias lends its original storage through the checked reference mode.")
				(i32:ltz (struct:get checked drop_start))
				(then (return checked)))
			(if
				(:doc "Both reference modes can lend a native owner through its checked representation.")
				(i32:lt -1i32 (struct:get checked drop_start))
				(then (return checked)))
			(return (call c_member_error (struct:get name start) (struct:get name end) 23u32))))

	(fn read_c_bare_value
		(:doc `Resolve a native scalar alias or, where allowed, a by-value pointer owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext) (accept_owner bool))
		(returns CMemberRead)
		(body
			(let checked (call read_c_named_type (borrow-shared source) (borrow-shared nodes)
				node bridge context))
			(let owner (i32:not-ltz (struct:get checked drop_start)))
			(let runtime_cleanup (i32:eq (struct:get checked drop_start) (struct:get checked drop_end)))
			(if
				(:doc "Native record views and runtime-only byte-tail storage use borrowed C formals.")
				(bool:and (u32:eqz (struct:get checked error))
					(bool:or (bool:and owner (bool:or runtime_cleanup (bool:not accept_owner)))
						(call is_c_record (borrow-shared source) (borrow-shared nodes)
							(array:get nodes (struct:get checked declaration)))))
				(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
			(return checked)))

	(fn read_c_array_element
		(:doc "Resolve a native array's exact scalar or complete record layout without accepting a resource owner.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(element i32) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let choice (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) node parts))
			(if
				(:doc "A type operand cannot apply declaration selection.")
				(u32:gtz (struct:get choice error))
				(then (return (call c_member_error (struct:get choice start) (struct:get choice end)
					(struct:get choice error)))))
			(let name (array:get nodes element))
