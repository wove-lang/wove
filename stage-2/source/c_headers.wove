(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Find active scalar C header declarations in the supplied Wove source table.

	Compare decoded header keys exactly. Keep the declaring file, original
	tree row and raw spellings for later type checking and native emission.`)
	source_c_headers

	(use wove-file "./scan.wove"
		(only (type SourceNode) (type Token) check_source_form build_source_tree check_source_metadata is_head_start_byte))
	(use wove-file "./module.wove" (only (type SelectedDeclaration) form_parts read_module select_form))
	(use wove-file "./imports.wove" (only import_keyword import_form))
	(use wove-file "./paths.wove" (only (type SuppliedFile)))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "./types.wove" (only builtin_type_keyword))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct HeaderMatch (fields (file i32) (node i32) (start i32) (end i32) (error u32)))
	(struct CFunctionRead
		(fields (declaration i32) (native_start i32) (native_end i32) (signature_start i32) (signature_end i32)
			(start i32) (end i32) (error u32)))

	(fn
		(:doc `Record a header's defining file, declaration row, and original literal span.`)
		header_match
		(params (file i32) (node i32) (start i32) (end i32) (error u32))
		(returns HeaderMatch)
		(body
			(return (record.make HeaderMatch (file (local file)) (node (local node))
				(start (local start)) (end (local end)) (error (local error))))))

	(fn
		(:doc `Compare a checked quoted header spelling with its decoded import key.`)
		matches_header
		(params (source (shared-slice u8)) (literal SourceNode) (key (shared-slice u8)))
		(returns bool)
		(body
			(let start (record.get (local literal) start))
			(let end (record.get (local literal) end))
			(let-mut decoded (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let value (call decode_string (borrow-shared (local source))
				(record.make Token (kind (u32 2)) (start (local start)) (end (local end)) (error (u32 0)))
				(borrow-mut (local decoded))))
			(return (bool.and (u32.eq (record.get (local value) error) (u32 0))
				(call same_bytes (borrow-shared (local decoded)) (i32 0) (record.get (local value) written)
					(borrow-shared (local key)) (i32 0) (slice.len (local key)))))))

	(fn
		(:doc `Read the header token of an active c-header bridge when it matches the requested key.`)
		matching_bridge_header
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (item SourceNode) (key (shared-slice u8)))
		(returns i32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(let head (record.get (local parts) head))
			(let provider (record.get (local parts) operands))
			(if
				(:doc "Only a bridge with a bare c-header provider has a header key here.")
				(bool.or (i32.lt (local provider) (i32 0))
					(bool.not (u32.eq (call import_keyword (borrow-shared (local source))
						(slice.load (local nodes) (local head))) (u32 9))))
				(then (return (i32 -1))))
			(let prefix (slice.load (local nodes) (local provider)))
			(let header (record.get (local prefix) next_sibling))
			(if
				(:doc "The provider is followed by its source string token.")
				(bool.or (i32.lt (local header) (i32 0))
					(bool.not (u32.eq (call import_keyword (borrow-shared (local source)) (local prefix)) (u32 8))))
				(then (return (i32 -1))))
			(let literal (slice.load (local nodes) (local header)))
			(if
				(:doc "Decode only quoted or raw string tokens before comparing the requested key.")
				(bool.and (u32.eq (record.get (local literal) kind) (u32 2))
					(call matches_header (borrow-shared (local source)) (local literal) (borrow-shared (local key))))
				(then (return (local header))))
			(return (i32 -1))))

	(fn
		(:doc `Look for one key among the selected declarations in a checked source tree.`)
		find_file_header
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (count i32) (file i32) (key (shared-slice u8)))
		(returns HeaderMatch)
		(body
			(let-mut found (i32 -1))
			(let-mut start (i32 0))
			(let-mut end (i32 0))
			(let-mut index (i32 0))
			(while
				(:doc "Only selected declarations in this module can provide a header.")
				(i32.lt (local index) (local count))
				(body
					(let row (record.get (slice.load (local declarations) (local index)) node))
					(let header (call matching_bridge_header (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local nodes) (local row)) (borrow-shared (local key))))
					(if
						(:doc "A second declaration of the same header key is ambiguous.")
						(bool.not (i32.lt (local header) (i32 0)))
						(then
							(let literal (slice.load (local nodes) (local header)))
							(set (local start) (record.get (local literal) start))
							(set (local end) (record.get (local literal) end))
							(if
								(:doc "Report an ambiguous provider at its later header literal.")
								(bool.not (i32.lt (local found) (i32 0)))
								(then (return (call header_match (local file) (i32 -1) (local start) (local end) (u32 30)))))
							(set (local found) (local row))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call header_match (local file) (local found) (local start) (local end) (u32 0)))))

	(fn
		(:doc `Check a supplied module's active declarations for a matching header key.`)
		read_file_header
		(params (source (shared-slice u8)) (file i32) (key (shared-slice u8)))
		(returns HeaderMatch)
		(body
			(let checked (call check_source_form (borrow-shared (local source))))
			(if
				(:doc "Only well-formed supplied sources can contribute a bridge.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (call header_match (local file) (i32 -1) (i32 0) (i32 0) (u32 0)))))
			(let count (int.convert i32 (record.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local count)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let metadata (call check_source_metadata (borrow-shared (local source)) (local built) (borrow-shared (local nodes))))
			(let-mut selected (array.alloc SelectedDeclaration (local count)))
			(let module (call read_module (borrow-shared (local source)) (borrow-shared (local nodes)) (local metadata)
				(borrow-mut (local selected))))
			(if
				(:doc "An inactive or invalid module contributes no header.")
				(bool.or (bool.not (record.get (local module) active)) (u32.lt (u32 0) (record.get (local module) error)))
				(then (return (call header_match (local file) (i32 -1) (i32 0) (i32 0) (u32 0)))))
			(return (call find_file_header (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local selected)) (record.get (local module) count) (local file) (borrow-shared (local key))))))

	(fn
		(:doc `Resolve a decoded key across canonical supplied sources without following their Wove import edges.`)
		find_c_header
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (key (shared-slice u8)))
		(returns HeaderMatch)
		(body
			(let-mut file (i32 0))
			(let-mut defining_file (i32 -1))
			(let-mut node (i32 -1))
			(let-mut start (i32 0))
			(let-mut end (i32 0))
			(while
				(:doc "Alternate virtual paths do not contribute extra bridge declarations.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(let input (slice.load (local files) (local file)))
					(if
						(:doc "Inspect each supplied canonical source at most once per key lookup.")
						(i32.eq (record.get (local input) identity) (local file))
						(then
							(let match (call read_file_header
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start) (record.get (local input) source_end)))
								(local file) (borrow-shared (local key))))
							(if
								(:doc "Keep an ambiguity within one source at its defining header.")
								(u32.lt (u32 0) (record.get (local match) error))
								(then (return (local match))))
							(if
								(:doc "Track the single definition of the requested header key.")
								(bool.not (i32.lt (record.get (local match) node) (i32 0)))
								(then
									(set (local start) (record.get (local match) start))
									(set (local end) (record.get (local match) end))
									(if
										(:doc "Two active declarations of this key cannot select one provider.")
										(bool.not (i32.lt (local defining_file) (i32 0)))
										(then (return (call header_match (local file) (i32 -1) (local start) (local end) (u32 30)))))
									(set (local defining_file) (local file))
									(set (local node) (record.get (local match) node))))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (call header_match (local defining_file) (local node) (local start) (local end) (u32 0)))))

	(fn
		(:doc `Package an unavailable or rejected declaration without publishing signature spans.`)
		c_function_error
		(params (start i32) (end i32) (error u32))
		(returns CFunctionRead)
		(body
			(return (record.make CFunctionRead (declaration (i32 -1)) (native_start (i32 -1)) (native_end (i32 -1))
				(signature_start (i32 -1)) (signature_end (i32 -1)) (start (local start)) (end (local end)) (error (local error))))))

	(fn
		(:doc `Recognize the portable ASCII identifier spelling that can be emitted as a C symbol.`)
		is_native_name
		(params (source (shared-slice u8)) (name SourceNode))
		(returns bool)
		(body
			(let start (record.get (local name) start))
			(let end (record.get (local name) end))
			(if
				(:doc "The native spelling starts with an ASCII letter or underscore.")
				(bool.not (call is_head_start_byte (slice.load (local source) (local start))))
				(then (return (bool false))))
			(let-mut cursor (i32.add.wrapping (local start) (i32 1)))
			(while
				(:doc "The remaining bytes may also include ASCII decimal digits.")
				(i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(if
						(:doc "Any other byte makes this Wove spelling unsuitable as a native symbol.")
						(bool.not (bool.or (call is_head_start_byte (local byte))
							(bool.not (bool.or (u8.lt (local byte) (u8 48)) (u8.lt (u8 57) (local byte))))))
						(then (return (bool false))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (bool true))))

	(fn
		(:doc `Accept one of the exact scalar types supported by the Stage 2 value ABI.`)
		is_c_scalar
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(if
				(:doc "A scalar type uses a bare built-in spelling.")
				(bool.not (u32.eq (record.get (local node) kind) (u32 1)))
				(then (return (bool false))))
			(let start (record.get (local node) start))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start)
				(i32.sub.wrapping (record.get (local node) end) (local start))))
			(return (bool.or (u32.eq (local type) (u32 5))
				(bool.and (u32.lt (u32 9) (local type)) (u32.lt (local type) (u32 13)))))))

	(fn
		(:doc `Check the selected foreign function's parameter and result forms and retain its exact signature.`)
		read_c_function
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declaration i32) (name SourceNode) (form SourceNode))
		(returns CFunctionRead)
		(body
			(let start (record.get (local form) start))
			(let end (record.get (local form) end))
			(if
				(:doc "The defining name must be a portable C symbol.")
				(bool.not (call is_native_name (borrow-shared (local source)) (local name)))
				(then (return (call c_function_error (record.get (local name) start) (record.get (local name) end) (u32 26)))))
			(let params (record.get (local name) next_sibling))
			(if
				(:doc "A foreign declaration needs params followed by returns.")
				(i32.lt (local params) (i32 0))
				(then (return (call c_function_error (local start) (local end) (u32 23)))))
			(let params_node (slice.load (local nodes) (local params)))
			(let returns (record.get (local params_node) next_sibling))
			(if
				(:doc "A missing returns form leaves the declaration incomplete.")
				(i32.lt (local returns) (i32 0))
				(then (return (call c_function_error (local start) (local end) (u32 23)))))
			(let returns_node (slice.load (local nodes) (local returns)))
			(let extra (record.get (local returns_node) next_sibling))
			(if
				(:doc "C bridge signatures end at their result type.")
				(bool.not (i32.lt (local extra) (i32 0)))
				(then
					(let item (slice.load (local nodes) (local extra)))
					(return (call c_function_error (record.get (local item) start) (record.get (local item) end) (u32 23)))))
			(let form_params (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local params_node) (u32 10)))
			(let form_returns (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local returns_node) (u32 11)))
			(if
				(:doc "Surface a malformed params form or directive at its original span.")
				(u32.lt (u32 0) (record.get (local form_params) error))
				(then (return (call c_function_error (record.get (local form_params) start) (record.get (local form_params) end)
					(record.get (local form_params) error)))))
			(if
				(:doc "Surface a malformed returns form or directive at its original span.")
				(u32.lt (u32 0) (record.get (local form_returns) error))
				(then (return (call c_function_error (record.get (local form_returns) start) (record.get (local form_returns) end)
					(record.get (local form_returns) error)))))
			(let result (record.get (local form_returns) first))
			(if
				(:doc "The result form supplies one bare scalar type.")
				(bool.or (i32.lt (local result) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local result)) next_sibling) (i32 0))))
				(then (return (call c_function_error (record.get (local returns_node) start) (record.get (local returns_node) end) (u32 23)))))
			(let result_type (slice.load (local nodes) (local result)))
			(if
				(:doc "Unsupported result types retain their own span.")
				(bool.not (call is_c_scalar (borrow-shared (local source)) (local result_type)))
				(then (return (call c_function_error (record.get (local result_type) start) (record.get (local result_type) end) (u32 23)))))
			(let first_parameter (record.get (local form_params) first))
			(let-mut parameter (local first_parameter))
			(while
				(:doc "Each parameter has one scalar type and a unique name in this signature.")
				(bool.not (i32.lt (local parameter) (i32 0)))
				(body
					(let item (slice.load (local nodes) (local parameter)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let type (record.get (local parts) operands))
					(if
						(:doc "A missing or extra operand is diagnosed at the parameter form.")
						(bool.or (i32.lt (local type) (i32 0))
							(bool.not (i32.lt (record.get (slice.load (local nodes) (local type)) next_sibling) (i32 0))))
						(then (return (call c_function_error (record.get (local item) start) (record.get (local item) end) (u32 23)))))
					(let choice (call select_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local item) (local parts) (bool false)))
					(if
						(:doc "A parameter cannot apply declaration selection.")
						(u32.lt (u32 0) (record.get (local choice) error))
						(then (return (call c_function_error (record.get (local choice) start) (record.get (local choice) end)
							(record.get (local choice) error)))))
					(let type_node (slice.load (local nodes) (local type)))
					(if
						(:doc "An unsupported parameter type is diagnosed at its original operand.")
						(bool.not (call is_c_scalar (borrow-shared (local source)) (local type_node)))
						(then (return (call c_function_error (record.get (local type_node) start)
							(record.get (local type_node) end) (u32 23)))))
					(let name (slice.load (local nodes) (record.get (local parts) head)))
					(let name_start (record.get (local name) start))
					(let name_end (record.get (local name) end))
					(let-mut earlier (local first_parameter))
					(while
						(:doc "Only parameters already checked in this signature can conflict with the current name.")
						(bool.not (i32.eq (local earlier) (local parameter)))
						(body
							(let previous (slice.load (local nodes) (local earlier)))
							(let previous_name (slice.load (local nodes) (record.get (local previous) first_child)))
							(if
								(:doc "Report the second occurrence at its exact name, after checking its type.")
								(call same_bytes (borrow-shared (local source))
									(record.get (local previous_name) start) (record.get (local previous_name) end)
									(borrow-shared (local source)) (local name_start) (local name_end))
								(then (return (call c_function_error (local name_start) (local name_end) (u32 33)))))
							(set (local earlier) (record.get (local previous) next_sibling))))
					(set (local parameter) (record.get (local item) next_sibling))))
			(return (record.make CFunctionRead (declaration (local declaration))
				(native_start (record.get (local name) start)) (native_end (record.get (local name) end))
				(signature_start (record.get (local params_node) start)) (signature_end (record.get (local returns_node) end))
				(start (local start)) (end (local end)) (error (u32 0))))))

	(fn
		(:doc `Resolve the original function name within a matched header's active members.`)
		find_c_function
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (header HeaderMatch)
			(spelling (shared-slice u8)) (start i32) (end i32))
		(returns CFunctionRead)
		(body
			(let bridge (slice.load (local nodes) (record.get (local header) node)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local bridge)))
			(let provider (slice.load (local nodes) (record.get (local parts) operands)))
			(let literal (slice.load (local nodes) (record.get (local provider) next_sibling)))
			(let-mut member (record.get (local literal) next_sibling))
			(let-mut found (i32 -1))
			(while
				(:doc "An active function with the selected spelling contributes one definition.")
				(bool.not (i32.lt (local member) (i32 0)))
				(body
					(let item (slice.load (local nodes) (local member)))
					(let form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(let head (record.get (local form) head))
					(let name (record.get (local form) operands))
					(if
						(:doc "Function selection leaves unrelated and unsupported declarations out of the scalar binding.")
						(bool.and (bool.not (i32.lt (local head) (i32 0)))
							(bool.and (bool.not (i32.lt (local name) (i32 0)))
								(u32.eq (call import_keyword (borrow-shared (local source)) (slice.load (local nodes) (local head))) (u32 1))))
						(then
							(let named (slice.load (local nodes) (local name)))
							(let from (record.get (local named) start))
							(let to (record.get (local named) end))
							(if
								(:doc "Match the original bare name before checking this member's signature.")
								(bool.and (u32.eq (record.get (local named) kind) (u32 1))
									(call same_bytes (borrow-shared (local source)) (local from) (local to)
										(borrow-shared (local spelling)) (local start) (local end)))
								(then
									(let choice (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
										(local item) (local form) (bool true)))
									(if
										(:doc "Keep malformed selection metadata at its defining span.")
										(u32.lt (u32 0) (record.get (local choice) error))
										(then (return (call c_function_error (record.get (local choice) start)
											(record.get (local choice) end) (record.get (local choice) error)))))
									(if
										(:doc "Excluded members never reserve the spelling.")
										(record.get (local choice) active)
										(then
											(if
												(:doc "A duplicate active definition would make this selection ambiguous.")
												(bool.not (i32.lt (local found) (i32 0)))
												(then (return (call c_function_error (local from) (local to) (u32 30)))))
											(set (local found) (local member))))))))
					(set (local member) (record.get (local item) next_sibling))))
			(if
				(:doc "An unavailable declaration is diagnosed by the importer at the requested name.")
				(i32.lt (local found) (i32 0))
				(then (return (call c_function_error (i32 0) (i32 0) (u32 0)))))
			(let item (slice.load (local nodes) (local found)))
			(let name (record.get (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)) operands))
			(return (call read_c_function (borrow-shared (local source)) (borrow-shared (local nodes))
				(local found) (slice.load (local nodes) (local name)) (local item))))))
