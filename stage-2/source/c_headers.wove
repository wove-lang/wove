	(fn read_c_value_type
		(:doc `Check the type of a selected scalar, byte string, resource, or vector snapshot.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(tag u32) (bridge i32) (context SelectionContext) (snapshot bool) (string_macro bool))
		(returns CMemberRead)
		(body
			(if
				(:doc "Vector snapshots and static byte strings have built-in element types.")
				(bool:or snapshot string_macro)
