			(if
				(:doc "The bridge spelling is emitted as a C identifier.")
				(bool:not (call is_native_name (borrow-shared source) name))
				(then (return (call c_member_error name/start name/end 26u32))))
			(let type parts/operands)
			(let null_value (call read_c_null_value (borrow-shared source) (borrow-shared nodes) parts))
			(if
				(:doc "Preserve the directive location for malformed and duplicate null value markers.")
				null_value/error.gtz
				(then (return (call c_member_error null_value/start null_value/end
					null_value/error))))
			(if
				(:doc "A null operand has a native spelling and no declared Wove value type.")
				null_value/present
				(then
					(if
						(:doc "Only a type-free const can bind a native null operand.")
						(bool:or (tag.not-eq 14u32) type.not-ltz)
						(then (return (call c_member_error form/start form/end 23u32))))
					(return (CMemberRead.new (declaration declaration)
						(native_start name/start) (native_end name/end)
						(signature_start form/start) (signature_end form/end)
						(start form/start) (end form/end) (error 0u32)
						(native_type 0i32) (drop_start 0i32) (drop_end 0i32) (type_start 0i32) (type_end 0i32)
						(namespace 2u32) (optional (bool false)) (scalar_typedef (bool false))
						(value_macro (bool false)) (value_lossless (bool false)) (null_value (bool true))
						(wove_result_layout (bool false))))))
			(if
				(:doc "A native value supplies one type. The header provides the expression or storage.")
				(type.ltz.or
					(i32:lt -1i32 (call next_form_operand (borrow-shared source) (borrow-shared nodes) (nodes.get type))))
				(then (return (call c_member_error form/start form/end 23u32))))
			(let type_node (nodes.get type))
			(let readonly (tag.eq 12u32))
			(let lossless_marker (call read_c_lossless_macro (borrow-shared source) (borrow-shared nodes) parts))
			(if
				(:doc "Report malformed conversion markers at the original directive.")
				lossless_marker/error.gtz
				(then (return (call c_member_error lossless_marker/start lossless_marker/end
					lossless_marker/error))))
			(let lossless lossless_marker/present)
			(if
				(:doc "The lossless contract reads a macro as a value without promising storage or constantness.")
				(lossless.and readonly.not)
				(then (return (call c_member_error form/start form/end 23u32))))
			(if
				(:doc "The destination must have a built-in integer range.")
				(lossless.and (bool:not (call is_builtin_integer_value
					(call source_builtin_type (borrow-shared source) type_node))))
				(then (return (call c_member_error type_node/start type_node/end 23u32))))
			(let writable (call read_c_static_mut_cstr (borrow-shared source) (borrow-shared nodes) parts))
			(if
				(:doc "The explicit lifetime marker is a zero-operand declaration contract.")
				writable/error.gtz
				(then (return (call c_member_error writable/start writable/end
					writable/error))))
			(let writable_string writable/present)
			(if
				(:doc "Only a native let-mut can opt in to installing writable retained strings.")
				(writable_string.and (tag.not-eq 15u32))
				(then (return (call c_member_error form/start form/end 23u32))))
			(let string_macro (bool:and (tag.eq 14u32)
				(u32:eq (call c_byte_slice_type (borrow-shared source) (borrow-shared nodes)
					type_node (bool false)) 34u32)))
			(let-mut expression (bool false))
			(if
				(:doc "A read-only scalar macro supplies a C expression in place of addressable storage.")
				readonly
				(then
					(let marker (call read_c_value_macro (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "Malformed and repeated markers report at the directive.")
						marker/error.gtz
						(then (return (call c_member_error marker/start marker/end
							marker/error))))
					(if
						(:doc "A binding chooses either an exact C type match or lossless conversion.")
						(lossless.and marker/present)
						(then (return (call c_member_error form/start form/end 23u32))))
					(set expression (lossless.or marker/present))
					(if
						(:doc "An expression macro must name a scalar type or its native alias.")
						(expression.and (type_node/kind.not-eq 1u32))
						(then (return (call c_member_error type_node/start type_node/end 23u32))))))
			(let-mut optional (bool false))
			(if
				(:doc "Constants and read-only expression macros can request the same availability check.")
				(bool:or (tag.eq 14u32) expression)
				(then
					(let marker (call read_c_optional (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "Keep the original directive span for an invalid availability marker.")
						marker/error.gtz
						(then (return (call c_member_error marker/start marker/end
							marker/error))))
					(set optional marker/present)))
			(let snapshot (call read_c_value_snapshot (borrow-shared source) (borrow-shared nodes)
				parts type_node readonly writable_string))
			(if
				(:doc "A bad snapshot retains the contract's original declaration span.")
				snapshot/error.gtz
				(then (return (call c_member_error snapshot/start snapshot/end
					snapshot/error))))
			(let native (call read_c_value_type (borrow-shared source) (borrow-shared nodes)
				type_node tag bridge context snapshot/active string_macro))
			(if
				(:doc "Preserve the defining span of an invalid foreign storage type.")
				native/error.gtz
				(then (return native)))
			(return (CMemberRead.new (declaration declaration)
				(native_start name/start) (native_end name/end)
				(signature_start form/start) (signature_end form/end)
				(start form/start) (end form/end) (error 0u32)
				(native_type native/native_type)
				(drop_start native/drop_start) (drop_end native/drop_end)
				(type_start native/type_start) (type_end native/type_end) (namespace 2u32) (optional optional) (scalar_typedef (bool false))
				(value_macro (expression.or string_macro)) (value_lossless lossless) (null_value (bool false)) (wove_result_layout (bool false))))))

	(fn matches_c_member_tag
		(:doc `Match a declaration in the function, type, or value namespace.`)
		(params (member u32) (requested u32))
		(returns bool)
		(body
			(if
				(:doc "The value selector includes constants and both kinds of storage bindings.")
				(requested.eq 13u32)
				(then (return (bool:or (member.eq 12u32)
					(bool:or (member.eq 14u32) (member.eq 15u32))))))
			(return (bool:or (member.eq requested)
				(bool:and (member.eq 7u32) (requested.eq 6u32))))))

	(fn find_bridge_member
		(:doc `Find an active member in the requested namespace under the defining bridge.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge_row i32) (tag u32)
			(spelling (shared-array u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberLookup)
		(body
			(let bridge (nodes.get bridge_row))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) bridge))
			(let-mut member parts/operands)
			(let-mut found -1i32)
			(while
				(:doc "An active member with the selected spelling contributes one definition.")
				member.not-ltz
				(body
					(let item (nodes.get member))
					(let form (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let head form/head)
					(let-mut next (call next_declaration (borrow-shared source) (borrow-shared nodes) item bridge_row))
					(if
						(:doc "Active declaration groups contribute members in every C namespace.")
						(call is_declaration_group (borrow-shared source) (borrow-shared nodes) form)
						(then
							(let choice (call select_form (borrow-shared source) (borrow-shared nodes)
								item form (bool true) context))
							(if
								(:doc "A malformed group guard keeps its source span.")
								choice/error.gtz
								(then (return (CMemberLookup.new (declaration -1i32)
									(start choice/start) (end choice/end)
									(error choice/error)))))
							(let first form/operands)
							(if
								(:doc "Only active nonempty groups contribute their children.")
								(choice/active.and (i32:lt -1i32 first))
								(then (set next first)))))
					(let name form/name)
					(if
						(:doc "Native aliases and record views share the C bridge's type namespace.")
						(bool:and (i32:lt -1i32 name)
							(bool:and (i32:lt -1i32 head)
								(call matches_c_member_tag
									(call import_keyword (borrow-shared source) (nodes.get head)) tag)))
						(then
							(let named (nodes.get name))
							(let from named/start)
							(let to named/end)
							(if
								(:doc "Match the original bare name before checking this member's signature.")
								(bool:and (named/kind.eq 1u32)
									(call same_bytes (borrow-shared source) from to
										(borrow-shared spelling) start end))
								(then
									(let choice (call select_form (borrow-shared source) (borrow-shared nodes)
										item form (bool true) context))
									(if
										(:doc "Keep malformed selection metadata at its defining span.")
										choice/error.gtz
										(then (return (CMemberLookup.new (declaration -1i32) (start choice/start)
												(end choice/end) (error choice/error)))))
									(if
										(:doc "Excluded members never reserve the spelling.")
										choice/active
										(then
											(if
												(:doc "A duplicate active definition would make this selection ambiguous.")
												found.not-ltz
												(then (return (CMemberLookup.new (declaration -1i32) (start from)
												(end to) (error 30u32)))))
											(set found member)))))))
					(set member next)))
			(return (CMemberLookup.new (declaration found) (start 0i32) (end 0i32) (error 0u32)))))

	(fn find_c_member
		(:doc "Resolve an active project member first, then look for the same namespace and spelling in the bundle.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge_row i32) (tag u32)
			(spelling (shared-array u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberLookup)
		(body
			(let project (call project_bridge (borrow-shared nodes) bridge_row))
			(let found (call find_bridge_member (borrow-shared source) (borrow-shared nodes)
				project tag (borrow-shared spelling) start end context))
			(let bundled (struct:get (nodes.get project) bridge_default))
			(if
				(:doc "A project declaration or its diagnostic takes precedence over the same bundled spelling.")
				(bundled.ltz.or
					(bool:or (i32:lt -1i32 found/declaration) found/error.gtz))
				(then (return found)))
			(return (call find_bridge_member (borrow-shared source) (borrow-shared nodes)
				bundled tag (borrow-shared spelling) start end context))))

	(fn find_c_type
		(:doc `Resolve a selected native alias, pointer owner, or record with its original representation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32)
			(spelling (shared-array u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let found (call find_c_member (borrow-shared source) (borrow-shared nodes)
				bridge 6u32 (borrow-shared spelling) start end context))
			(let declaration found/declaration)
			(if
				(:doc "Propagate a failed lookup or leave the requested name unavailable.")
				declaration.ltz
				(then (return (call c_member_error found/start found/end
					found/error))))
			(return (call read_c_type_declaration (borrow-shared source) (borrow-shared nodes)
				declaration))))

	(fn read_c_type_declaration
		(:doc "Check the native contract at the canonical definition selected by the graph.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32))
		(returns CMemberRead)
		(body
			(let node (nodes.get declaration))
			(if
				(:doc "Record views contribute a C value type without a destructor.")
				(call is_c_record (borrow-shared source) (borrow-shared nodes) node)
				(then
					(let checked_record (call read_c_record (borrow-shared source) (borrow-shared nodes) node))
					(if
						(:doc "A malformed record is diagnosed in the defining bridge.")
						checked_record/error.gtz
						(then (return (call c_member_error checked_record/start
							checked_record/end checked_record/error))))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let availability (call read_c_optional (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "Keep malformed availability markers at their original directive.")
						availability/error.gtz
						(then (return (call c_member_error availability/start
							availability/end availability/error))))
					(let representation (nodes.get checked_record/native))
					(return (CMemberRead.new (declaration declaration)
						(native_start representation/start) (native_end representation/end)
						(signature_start node/start) (signature_end node/end)
						(start node/start) (end node/end) (error 0u32)
						(native_type declaration) (drop_start -1i32) (drop_end -1i32)
						(type_start representation/start) (type_end representation/end) (namespace 1u32)
						(optional availability/present) (scalar_typedef (bool false)) (value_macro (bool false)) (value_lossless (bool false)) (null_value (bool false)) (wove_result_layout (bool false))))))
			(let checked (call check_c_type (borrow-shared source) (borrow-shared nodes) node))
			(if
				(:doc "The contract's invalid annotation lives in the defining source.")
				checked/error.gtz
				(then (return (call c_member_error checked/start checked/end
					checked/error))))
			(let native (nodes.get checked/native))
			(let storage checked/storage)
			(let scalar (storage.not.and
				(checked/drop.ltz.and checked/tail.ltz)))
			(let-mut optional (bool false))
			(if
				(:doc "Choose between a complete storage record and an exact public scalar typedef.")
				(storage.or scalar)
				(then
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let availability (call read_c_optional (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "An invalid optional type directive reports its own source span.")
						availability/error.gtz
						(then (return (call c_member_error availability/start
							availability/end availability/error))))
					(set optional availability/present)))
			(let-mut drop_start -1i32)
			(let-mut drop_end -1i32)
			(if
				(:doc "A destructor contributes its exact source span. Runtime-only cleanup carries an empty owner span.")
				(i32:lt -1i32 checked/drop)
				(then
					(let drop (nodes.get checked/drop))
					(set drop_start drop/start)
					(set drop_end drop/end))
				(else
					(if
						(:doc "The empty span records ownership without a native destructor name.")
						checked/tail.not-ltz
						(then
							(set drop_start node/start)
							(set drop_end drop_start)))))
			(return (CMemberRead.new (declaration declaration)
				(native_start native/start) (native_end native/end)
				(signature_start node/start) (signature_end node/end)
				(start node/start) (end node/end) (error 0u32)
				(native_type declaration) (drop_start drop_start) (drop_end drop_end)
				(type_start native/start) (type_end native/end) (namespace 1u32) (optional optional)
				(scalar_typedef (optional.and scalar)) (value_macro (bool false)) (value_lossless (bool false)) (null_value (bool false)) (wove_result_layout (bool false))))))

	(fn find_c_declaration
		(:doc `Resolve and check a C header's selected function, type, or value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32)
			(spelling (shared-array u8)) (start i32) (end i32) (namespace u32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "Each namespace selects only declarations of its own kind.")
				(namespace.eq 1u32)
				(then (return (call find_c_type (borrow-shared source) (borrow-shared nodes)
					bridge (borrow-shared spelling) start end context))))
			(let-mut tag 1u32)
			(if
				(:doc "Search the shared value namespace for an explicit or inferred value selector.")
				(namespace.eq 2u32)
				(then (set tag 13u32)))
			(let found (call find_c_member (borrow-shared source) (borrow-shared nodes)
				bridge tag (borrow-shared spelling) start end context))
			(let index found/declaration)
			(if
				(:doc "Only an unqualified, unavailable function allows a fallback to the value namespace.")
				(namespace.eqz.and
					(index.ltz.and found/error.eqz))
				(then (return (call find_c_declaration (borrow-shared source) (borrow-shared nodes)
					bridge (borrow-shared spelling) start end 2u32 context))))
			(if
				(:doc "An unavailable declaration is diagnosed by the importer at the requested name.")
				index.ltz
				(then (return (call c_member_error found/start found/end
					found/error))))
			(let item (nodes.get index))
			(let signature (call form_parts (borrow-shared source) (borrow-shared nodes) item))
			(if
				(:doc "Validate the selected value in the original C bridge scope.")
				(namespace.eq 2u32)
				(then (return (call read_c_value (borrow-shared source) (borrow-shared nodes)
					index (call import_keyword (borrow-shared source)
						(nodes.get signature/head))
					item signature
					(call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) item) context))))
			(return (call read_c_function (borrow-shared source) (borrow-shared nodes)
				index item signature
				(call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) item) context)))))
