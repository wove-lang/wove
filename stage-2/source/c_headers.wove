						(then (return (call c_member_error (struct:get item start) (struct:get item end) 23u32))))
					(let choice (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) item parts))
					(if
						(:doc "A parameter cannot apply declaration selection.")
						(u32:gtz (struct:get choice error))
