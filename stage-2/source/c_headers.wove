														(call is_c_storage_type (borrow-shared source) (borrow-shared nodes) declaration)
														(then (set owner_mode (call c_storage_init_mode))))))
											(if
												(:doc "Built-in scalars and unowned native scalar aliases keep the original access mode.")
												(bool:or (i32:ltz declaration)
													(bool:and (bool:not owned) (bool:not record)))
												(then
													(set scalar_ref mode)
													(let pointee (array:get nodes (struct:get type_form operands)))
													(set integer (bool:or (i32:not-ltz declaration)
														(call is_builtin_integer (call source_builtin_type (borrow-shared source) pointee))))))))))
