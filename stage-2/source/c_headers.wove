							(let first (record.get (local form) operands))
							(if
								(:doc "Only active nonempty groups contribute their children.")
								(bool.and (record.get (local choice) active) (i32.lt -1i32 (local first)))
								(then (set (local next) (local first))))))
					(let-mut name (record.get (local form) name))
					(if
						(:doc "Types and values use their first ordinary operand for the name.")
						(bool.not (u32.eq (local tag) 1u32))
						(then (set (local name) (record.get (local form) operands))))
					(if
						(:doc "Native aliases and record views share the C bridge's type namespace.")
						(bool.and (i32.lt -1i32 (local name))
							(bool.and (i32.lt -1i32 (local head))
								(call matches_c_member_tag
									(call import_keyword (borrow-shared (local source)) (slice.load (local nodes) (local head))) (local tag))))
						(then
							(let named (slice.load (local nodes) (local name)))
							(let from (record.get (local named) start))
							(let to (record.get (local named) end))
							(if
								(:doc "Match the original bare name before checking this member's signature.")
								(bool.and (u32.eq (record.get (local named) kind) 1u32)
									(call same_bytes (borrow-shared (local source)) (local from) (local to)
										(borrow-shared (local spelling)) (local start) (local end)))
								(then
									(let choice (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
										(local item) (local form) (bool true) (local context)))
									(if
										(:doc "Keep malformed selection metadata at its defining span.")
										(u32.lt 0u32 (record.get (local choice) error))
										(then (return (record.make CMemberLookup (declaration -1i32) (start (record.get (local choice) start))
												(end (record.get (local choice) end)) (error (record.get (local choice) error))))))
									(if
										(:doc "Excluded members never reserve the spelling.")
										(record.get (local choice) active)
										(then
											(if
												(:doc "A duplicate active definition would make this selection ambiguous.")
												(bool.not (i32.lt (local found) 0i32))
												(then (return (record.make CMemberLookup (declaration -1i32) (start (local from))
												(end (local to)) (error 30u32)))))
											(set (local found) (local member))))))))
					(set (local member) (local next))))
			(return (record.make CMemberLookup (declaration (local found)) (start 0i32) (end 0i32) (error 0u32)))))

	(fn find_c_member
		(:doc "Resolve an active project member first, then look for the same namespace and spelling in the bundle.")
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (bridge_row i32) (tag u32)
			(spelling (shared-slice u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberLookup)
		(body
			(let project (call project_bridge (borrow-shared (local nodes)) (local bridge_row)))
			(let found (call find_bridge_member (borrow-shared (local source)) (borrow-shared (local nodes))
				(local project) (local tag) (borrow-shared (local spelling)) (local start) (local end) (local context)))
			(let bundled (record.get (slice.load (local nodes) (local project)) bridge_default))
			(if
				(:doc "A project declaration or its diagnostic takes precedence over the same bundled spelling.")
				(bool.or (i32.lt (local bundled) 0i32)
					(bool.or (i32.lt -1i32 (record.get (local found) declaration)) (u32.lt 0u32 (record.get (local found) error))))
				(then (return (local found))))
			(return (call find_bridge_member (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bundled) (local tag) (borrow-shared (local spelling)) (local start) (local end) (local context)))))

	(fn find_c_type
		(:doc `Resolve a selected native alias, pointer owner, or record with its original representation.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (bridge i32)
			(spelling (shared-slice u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let found (call find_c_member (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bridge) 6u32 (borrow-shared (local spelling)) (local start) (local end) (local context)))
			(let declaration (record.get (local found) declaration))
			(if
				(:doc "Propagate a failed lookup or leave the requested name unavailable.")
				(i32.lt (local declaration) 0i32)
				(then (return (call c_member_error (record.get (local found) start) (record.get (local found) end)
					(record.get (local found) error)))))
			(let node (slice.load (local nodes) (local declaration)))
			(if
				(:doc "Record views contribute a C value type without a destructor.")
				(call is_c_record (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))
				(then
					(let checked_record (call read_c_record (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(if
						(:doc "A malformed record is diagnosed in the defining bridge.")
						(u32.lt 0u32 (record.get (local checked_record) error))
						(then (return (call c_member_error (record.get (local checked_record) start)
							(record.get (local checked_record) end) (record.get (local checked_record) error)))))
					(let representation (slice.load (local nodes) (record.get (local checked_record) native)))
					(return (record.make CMemberRead (declaration (local declaration))
						(native_start (record.get (local representation) start)) (native_end (record.get (local representation) end))
						(signature_start (record.get (local node) start)) (signature_end (record.get (local node) end))
						(start (record.get (local node) start)) (end (record.get (local node) end)) (error 0u32)
						(native_type (local declaration)) (drop_start -1i32) (drop_end -1i32)
						(type_start (record.get (local representation) start)) (type_end (record.get (local representation) end)) (namespace 1u32) (optional (bool false))))))
			(let checked (call check_c_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(if
				(:doc "The contract's invalid annotation lives in the defining source.")
				(u32.lt 0u32 (record.get (local checked) error))
				(then (return (call c_member_error (record.get (local checked) start) (record.get (local checked) end)
					(record.get (local checked) error)))))
			(let native (slice.load (local nodes) (record.get (local checked) native)))
			(let-mut drop_start -1i32)
			(let-mut drop_end -1i32)
			(if
				(:doc "Only an owned type carries the destructor's source span.")
				(i32.lt -1i32 (record.get (local checked) drop))
				(then
					(let drop (slice.load (local nodes) (record.get (local checked) drop)))
					(set (local drop_start) (record.get (local drop) start))
					(set (local drop_end) (record.get (local drop) end))))
			(return (record.make CMemberRead (declaration (local declaration))
				(native_start (record.get (local native) start)) (native_end (record.get (local native) end))
				(signature_start (record.get (local node) start)) (signature_end (record.get (local node) end))
				(start (record.get (local node) start)) (end (record.get (local node) end)) (error 0u32)
				(native_type (local declaration)) (drop_start (local drop_start)) (drop_end (local drop_end))
				(type_start (record.get (local native) start)) (type_end (record.get (local native) end)) (namespace 1u32) (optional (bool false))))))

	(fn find_c_declaration
		(:doc `Resolve and check a C header's selected function, type, or value.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (bridge i32)
			(spelling (shared-slice u8)) (start i32) (end i32) (namespace u32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "Each namespace selects only declarations of its own kind.")
				(u32.eq (local namespace) 1u32)
				(then (return (call find_c_type (borrow-shared (local source)) (borrow-shared (local nodes))
					(local bridge) (borrow-shared (local spelling)) (local start) (local end) (local context)))))
			(let-mut tag 1u32)
			(if
				(:doc "Search the shared value namespace for an explicit or inferred value selector.")
				(u32.eq (local namespace) 2u32)
				(then (set (local tag) 13u32)))
			(let found (call find_c_member (borrow-shared (local source)) (borrow-shared (local nodes))
				(local bridge) (local tag) (borrow-shared (local spelling)) (local start) (local end) (local context)))
			(let index (record.get (local found) declaration))
			(if
				(:doc "Only an unqualified, unavailable function allows a fallback to the value namespace.")
				(bool.and (u32.eq (local namespace) 0u32)
					(bool.and (i32.lt (local index) 0i32) (u32.eq (record.get (local found) error) 0u32)))
				(then (return (call find_c_declaration (borrow-shared (local source)) (borrow-shared (local nodes))
					(local bridge) (borrow-shared (local spelling)) (local start) (local end) 2u32 (local context)))))
			(if
				(:doc "An unavailable declaration is diagnosed by the importer at the requested name.")
				(i32.lt (local index) 0i32)
				(then (return (call c_member_error (record.get (local found) start) (record.get (local found) end)
					(record.get (local found) error)))))
			(let item (slice.load (local nodes) (local index)))
			(let signature (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(if
				(:doc "Validate the selected value in the original C bridge scope.")
				(u32.eq (local namespace) 2u32)
				(then (return (call read_c_value (borrow-shared (local source)) (borrow-shared (local nodes))
					(local index) (call import_keyword (borrow-shared (local source))
						(slice.load (local nodes) (record.get (local signature) head)))
					(local item) (record.get (local signature) operands) (local bridge) (local context)))))
			(return (call read_c_function (borrow-shared (local source)) (borrow-shared (local nodes))
				(local index) (local item) (local signature) (local bridge) (local context))))))
