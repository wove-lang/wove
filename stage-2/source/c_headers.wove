			(if
				(:doc "The constant contract needs an integral type for its range assertion.")
				(bool:and (u32:eq tag 14u32)
					(bool:or (call is_builtin_float scalar) (call is_256bit_integer scalar)))
				(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
			(if
				(:doc "Built-in scalar values need no defining type row.")
				(call is_builtin_scalar scalar)
				(then (return (call c_member_error 0i32 0i32 0u32))))
			(if
				(:doc "A plain type name resolves to a native scalar alias in this bridge.")
				(u32:eq (struct:get node kind) 1u32)
				(then
					(let native (call read_c_bare_value (borrow-shared source) (borrow-shared nodes)
						node bridge context (bool false)))
					(if
						(:doc "A long double expression uses the read-only macro contract.")
						(bool:and (u32:eq tag 14u32)
							(bool:and (u32:eqz (struct:get native error))
								(call is_c_long_double (borrow-shared source)
									(struct:get native type_start) (struct:get native type_end))))
						(then (return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))
					(return native)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let mode (call reference_mode (borrow-shared source) (borrow-shared nodes) (struct:get parts head)))
			(if
				(:doc "Only read-only let can expose a shared reference to library-owned storage.")
				(bool:and (u32:eq tag 12u32) (u32:eq mode 1u32))
				(then
					(let reference (call read_c_reference_parameter (borrow-shared source) (borrow-shared nodes)
						node bridge context))
					(if
						(:doc "Foreign reference values expose raw pointer handles, not Wove storage owners.")
						(bool:or (u32:gtz (struct:get reference error))
							(bool:and (i32:lt -1i32 (struct:get reference drop_start))
								(bool:not (call is_c_storage_type (borrow-shared source) (borrow-shared nodes)
									(struct:get reference declaration)))))
						(then (return reference)))))
			(return (call c_member_error (struct:get node start) (struct:get node end) 23u32))))

	(fn read_c_value
		(:doc `Retain the original native spelling and checked type of one constant or foreign binding.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32)
			(tag u32) (form SourceNode) (parts FormParts) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let name (array:get nodes (struct:get parts name)))
			(if
				(:doc "The bridge spelling is emitted as a C identifier.")
				(bool:not (call is_native_name (borrow-shared source) name))
				(then (return (call c_member_error (struct:get name start) (struct:get name end) 26u32))))
			(let type (struct:get parts operands))
			(if
				(:doc "A native value supplies one type. The header provides the expression or storage.")
				(bool:or (i32:ltz type)
					(i32:lt -1i32 (call next_form_operand (borrow-shared source) (borrow-shared nodes) (array:get nodes type))))
				(then (return (call c_member_error (struct:get form start) (struct:get form end) 23u32))))
			(let type_node (array:get nodes type))
			(let readonly (u32:eq tag 12u32))
			(let lossless_marker (call read_c_lossless_macro (borrow-shared source) (borrow-shared nodes) parts))
			(if
				(:doc "Report malformed conversion markers at the original directive.")
				(u32:gtz (struct:get lossless_marker error))
				(then (return (call c_member_error (struct:get lossless_marker start) (struct:get lossless_marker end)
					(struct:get lossless_marker error)))))
			(let lossless (struct:get lossless_marker present))
			(if
				(:doc "The lossless contract reads a macro as a value without promising storage or constantness.")
				(bool:and lossless (bool:not readonly))
				(then (return (call c_member_error (struct:get form start) (struct:get form end) 23u32))))
			(if
				(:doc "The destination must have a built-in integer range.")
				(bool:and lossless (bool:not (call is_builtin_integer_value
					(call source_builtin_type (borrow-shared source) type_node))))
				(then (return (call c_member_error (struct:get type_node start) (struct:get type_node end) 23u32))))
			(let writable (call read_c_static_mut_cstr (borrow-shared source) (borrow-shared nodes) parts))
			(if
				(:doc "The explicit lifetime marker is a zero-operand declaration contract.")
				(u32:gtz (struct:get writable error))
				(then (return (call c_member_error (struct:get writable start) (struct:get writable end)
					(struct:get writable error)))))
			(let writable_string (struct:get writable present))
			(if
				(:doc "Only a native let-mut can opt in to installing writable retained strings.")
				(bool:and writable_string (u32:not-eq tag 15u32))
				(then (return (call c_member_error (struct:get form start) (struct:get form end) 23u32))))
			(let string_macro (bool:and (u32:eq tag 14u32)
				(u32:eq (call c_byte_slice_type (borrow-shared source) (borrow-shared nodes)
					type_node (bool false)) 34u32)))
			(let-mut expression (bool false))
			(if
				(:doc "A read-only scalar macro supplies a C expression in place of addressable storage.")
				readonly
				(then
					(let marker (call read_c_value_macro (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "Malformed and repeated markers report at the directive.")
						(u32:gtz (struct:get marker error))
						(then (return (call c_member_error (struct:get marker start) (struct:get marker end)
							(struct:get marker error)))))
					(if
						(:doc "A binding chooses either an exact C type match or lossless conversion.")
						(bool:and lossless (struct:get marker present))
						(then (return (call c_member_error (struct:get form start) (struct:get form end) 23u32))))
					(set expression (bool:or lossless (struct:get marker present)))
					(if
						(:doc "An expression macro must name a scalar type or its native alias.")
						(bool:and expression (u32:not-eq (struct:get type_node kind) 1u32))
						(then (return (call c_member_error (struct:get type_node start) (struct:get type_node end) 23u32))))))
			(let-mut optional (bool false))
			(if
				(:doc "Constants and read-only expression macros can request the same availability check.")
				(bool:or (u32:eq tag 14u32) expression)
				(then
					(let marker (call read_c_optional (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "Keep the original directive span for an invalid availability marker.")
						(u32:gtz (struct:get marker error))
						(then (return (call c_member_error (struct:get marker start) (struct:get marker end)
							(struct:get marker error)))))
					(set optional (struct:get marker present))))
			(let snapshot (call read_c_value_snapshot (borrow-shared source) (borrow-shared nodes)
				parts type_node readonly writable_string))
			(if
				(:doc "A bad snapshot retains the contract's original declaration span.")
				(u32:gtz (struct:get snapshot error))
				(then (return (call c_member_error (struct:get snapshot start) (struct:get snapshot end)
					(struct:get snapshot error)))))
			(let native (call read_c_value_type (borrow-shared source) (borrow-shared nodes)
				type_node tag bridge context (struct:get snapshot active) string_macro))
			(if
				(:doc "Preserve the defining span of an invalid foreign storage type.")
				(u32:gtz (struct:get native error))
				(then (return native)))
			(return (struct:new CMemberRead (declaration declaration)
				(native_start (struct:get name start)) (native_end (struct:get name end))
				(signature_start (struct:get form start)) (signature_end (struct:get form end))
				(start (struct:get form start)) (end (struct:get form end)) (error 0u32)
				(native_type (struct:get native native_type))
				(drop_start (struct:get native drop_start)) (drop_end (struct:get native drop_end))
				(type_start (struct:get native type_start)) (type_end (struct:get native type_end)) (namespace 2u32) (optional optional) (scalar_typedef (bool false))
				(value_macro (bool:or expression string_macro)) (value_lossless lossless) (wove_result_layout (bool false))))))

	(fn matches_c_member_tag
		(:doc `Match a declaration in the function, type, or value namespace.`)
		(params (member u32) (requested u32))
		(returns bool)
		(body
			(if
				(:doc "The value selector includes constants and both kinds of storage bindings.")
				(u32:eq requested 13u32)
				(then (return (bool:or (u32:eq member 12u32)
					(bool:or (u32:eq member 14u32) (u32:eq member 15u32))))))
			(return (bool:or (u32:eq member requested)
				(bool:and (u32:eq member 7u32) (u32:eq requested 6u32))))))

	(fn find_bridge_member
		(:doc `Find an active member in the requested namespace under the defining bridge.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge_row i32) (tag u32)
			(spelling (shared-array u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberLookup)
		(body
			(let bridge (array:get nodes bridge_row))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) bridge))
			(let-mut member (struct:get parts operands))
			(let-mut found -1i32)
			(while
				(:doc "An active member with the selected spelling contributes one definition.")
				(i32:not-ltz member)
				(body
					(let item (array:get nodes member))
					(let form (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(let head (struct:get form head))
					(let-mut next (call next_declaration (borrow-shared source) (borrow-shared nodes) item bridge_row))
					(if
						(:doc "Active declaration groups contribute members in every C namespace.")
						(call is_declaration_group (borrow-shared source) (borrow-shared nodes) form)
						(then
							(let choice (call select_form (borrow-shared source) (borrow-shared nodes)
								item form (bool true) context))
							(if
								(:doc "A malformed group guard keeps its source span.")
								(u32:gtz (struct:get choice error))
								(then (return (struct:new CMemberLookup (declaration -1i32)
									(start (struct:get choice start)) (end (struct:get choice end))
									(error (struct:get choice error))))))
							(let first (struct:get form operands))
							(if
								(:doc "Only active nonempty groups contribute their children.")
								(bool:and (struct:get choice active) (i32:lt -1i32 first))
								(then (set next first)))))
					(let name (struct:get form name))
					(if
						(:doc "Native aliases and record views share the C bridge's type namespace.")
						(bool:and (i32:lt -1i32 name)
							(bool:and (i32:lt -1i32 head)
								(call matches_c_member_tag
									(call import_keyword (borrow-shared source) (array:get nodes head)) tag)))
						(then
							(let named (array:get nodes name))
							(let from (struct:get named start))
							(let to (struct:get named end))
							(if
								(:doc "Match the original bare name before checking this member's signature.")
								(bool:and (u32:eq (struct:get named kind) 1u32)
									(call same_bytes (borrow-shared source) from to
										(borrow-shared spelling) start end))
								(then
									(let choice (call select_form (borrow-shared source) (borrow-shared nodes)
										item form (bool true) context))
									(if
										(:doc "Keep malformed selection metadata at its defining span.")
										(u32:gtz (struct:get choice error))
										(then (return (struct:new CMemberLookup (declaration -1i32) (start (struct:get choice start))
												(end (struct:get choice end)) (error (struct:get choice error))))))
									(if
										(:doc "Excluded members never reserve the spelling.")
										(struct:get choice active)
										(then
											(if
												(:doc "A duplicate active definition would make this selection ambiguous.")
												(i32:not-ltz found)
												(then (return (struct:new CMemberLookup (declaration -1i32) (start from)
												(end to) (error 30u32)))))
											(set found member)))))))
					(set member next)))
			(return (struct:new CMemberLookup (declaration found) (start 0i32) (end 0i32) (error 0u32)))))

	(fn find_c_member
		(:doc "Resolve an active project member first, then look for the same namespace and spelling in the bundle.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge_row i32) (tag u32)
			(spelling (shared-array u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberLookup)
		(body
			(let project (call project_bridge (borrow-shared nodes) bridge_row))
			(let found (call find_bridge_member (borrow-shared source) (borrow-shared nodes)
				project tag (borrow-shared spelling) start end context))
			(let bundled (struct:get (array:get nodes project) bridge_default))
			(if
				(:doc "A project declaration or its diagnostic takes precedence over the same bundled spelling.")
				(bool:or (i32:ltz bundled)
					(bool:or (i32:lt -1i32 (struct:get found declaration)) (u32:gtz (struct:get found error))))
				(then (return found)))
			(return (call find_bridge_member (borrow-shared source) (borrow-shared nodes)
				bundled tag (borrow-shared spelling) start end context))))

	(fn find_c_type
		(:doc `Resolve a selected native alias, pointer owner, or record with its original representation.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32)
			(spelling (shared-array u8)) (start i32) (end i32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(let found (call find_c_member (borrow-shared source) (borrow-shared nodes)
				bridge 6u32 (borrow-shared spelling) start end context))
			(let declaration (struct:get found declaration))
			(if
				(:doc "Propagate a failed lookup or leave the requested name unavailable.")
				(i32:ltz declaration)
				(then (return (call c_member_error (struct:get found start) (struct:get found end)
					(struct:get found error)))))
			(return (call read_c_type_declaration (borrow-shared source) (borrow-shared nodes)
				declaration))))

	(fn read_c_type_declaration
		(:doc "Check the native contract at the canonical definition selected by the graph.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32))
		(returns CMemberRead)
		(body
			(let node (array:get nodes declaration))
			(if
				(:doc "Record views contribute a C value type without a destructor.")
				(call is_c_record (borrow-shared source) (borrow-shared nodes) node)
				(then
					(let checked_record (call read_c_record (borrow-shared source) (borrow-shared nodes) node))
					(if
						(:doc "A malformed record is diagnosed in the defining bridge.")
						(u32:gtz (struct:get checked_record error))
						(then (return (call c_member_error (struct:get checked_record start)
							(struct:get checked_record end) (struct:get checked_record error)))))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let availability (call read_c_optional (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "Keep malformed availability markers at their original directive.")
						(u32:gtz (struct:get availability error))
						(then (return (call c_member_error (struct:get availability start)
							(struct:get availability end) (struct:get availability error)))))
					(let representation (array:get nodes (struct:get checked_record native)))
					(return (struct:new CMemberRead (declaration declaration)
						(native_start (struct:get representation start)) (native_end (struct:get representation end))
						(signature_start (struct:get node start)) (signature_end (struct:get node end))
						(start (struct:get node start)) (end (struct:get node end)) (error 0u32)
						(native_type declaration) (drop_start -1i32) (drop_end -1i32)
						(type_start (struct:get representation start)) (type_end (struct:get representation end)) (namespace 1u32)
						(optional (struct:get availability present)) (scalar_typedef (bool false)) (value_macro (bool false)) (value_lossless (bool false)) (wove_result_layout (bool false))))))
			(let checked (call check_c_type (borrow-shared source) (borrow-shared nodes) node))
			(if
				(:doc "The contract's invalid annotation lives in the defining source.")
				(u32:gtz (struct:get checked error))
				(then (return (call c_member_error (struct:get checked start) (struct:get checked end)
					(struct:get checked error)))))
			(let native (array:get nodes (struct:get checked native)))
			(let storage (struct:get checked storage))
			(let scalar (bool:and (bool:not storage)
				(bool:and (i32:ltz (struct:get checked drop)) (i32:ltz (struct:get checked tail)))))
			(let-mut optional (bool false))
			(if
				(:doc "Choose between a complete storage record and an exact public scalar typedef.")
				(bool:or storage scalar)
				(then
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let availability (call read_c_optional (borrow-shared source) (borrow-shared nodes) parts))
					(if
						(:doc "An invalid optional type directive reports its own source span.")
						(u32:gtz (struct:get availability error))
						(then (return (call c_member_error (struct:get availability start)
							(struct:get availability end) (struct:get availability error)))))
					(set optional (struct:get availability present))))
			(let-mut drop_start -1i32)
			(let-mut drop_end -1i32)
			(if
				(:doc "A destructor contributes its exact source span. Runtime-only cleanup carries an empty owner span.")
				(i32:lt -1i32 (struct:get checked drop))
				(then
					(let drop (array:get nodes (struct:get checked drop)))
					(set drop_start (struct:get drop start))
					(set drop_end (struct:get drop end)))
				(else
					(if
						(:doc "The empty span records ownership without a native destructor name.")
						(i32:not-ltz (struct:get checked tail))
						(then
							(set drop_start (struct:get node start))
							(set drop_end drop_start)))))
			(return (struct:new CMemberRead (declaration declaration)
				(native_start (struct:get native start)) (native_end (struct:get native end))
				(signature_start (struct:get node start)) (signature_end (struct:get node end))
				(start (struct:get node start)) (end (struct:get node end)) (error 0u32)
				(native_type declaration) (drop_start drop_start) (drop_end drop_end)
				(type_start (struct:get native start)) (type_end (struct:get native end)) (namespace 1u32) (optional optional)
				(scalar_typedef (bool:and optional scalar)) (value_macro (bool false)) (value_lossless (bool false)) (wove_result_layout (bool false))))))

	(fn find_c_declaration
		(:doc `Resolve and check a C header's selected function, type, or value.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bridge i32)
			(spelling (shared-array u8)) (start i32) (end i32) (namespace u32) (context SelectionContext))
		(returns CMemberRead)
		(body
			(if
				(:doc "Each namespace selects only declarations of its own kind.")
				(u32:eq namespace 1u32)
				(then (return (call find_c_type (borrow-shared source) (borrow-shared nodes)
					bridge (borrow-shared spelling) start end context))))
			(let-mut tag 1u32)
			(if
				(:doc "Search the shared value namespace for an explicit or inferred value selector.")
				(u32:eq namespace 2u32)
				(then (set tag 13u32)))
			(let found (call find_c_member (borrow-shared source) (borrow-shared nodes)
				bridge tag (borrow-shared spelling) start end context))
			(let index (struct:get found declaration))
			(if
				(:doc "Only an unqualified, unavailable function allows a fallback to the value namespace.")
				(bool:and (u32:eqz namespace)
					(bool:and (i32:ltz index) (u32:eqz (struct:get found error))))
				(then (return (call find_c_declaration (borrow-shared source) (borrow-shared nodes)
					bridge (borrow-shared spelling) start end 2u32 context))))
			(if
				(:doc "An unavailable declaration is diagnosed by the importer at the requested name.")
				(i32:ltz index)
				(then (return (call c_member_error (struct:get found start) (struct:get found end)
					(struct:get found error)))))
			(let item (array:get nodes index))
			(let signature (call form_parts (borrow-shared source) (borrow-shared nodes) item))
			(if
				(:doc "Validate the selected value in the original C bridge scope.")
				(u32:eq namespace 2u32)
				(then (return (call read_c_value (borrow-shared source) (borrow-shared nodes)
					index (call import_keyword (borrow-shared source)
						(array:get nodes (struct:get signature head)))
					item signature
					(call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) item) context))))
			(return (call read_c_function (borrow-shared source) (borrow-shared nodes)
				index item signature
				(call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) item) context)))))
