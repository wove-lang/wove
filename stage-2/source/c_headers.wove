				(:doc "Snapshot result adaptation currently uses the fixed native call ABI.")
				(bool:and (struct:get snapshot active)
					(i32:gtz tail))
				(then (return (call c_member_error (struct:get snapshot start) (struct:get snapshot end) 23u32))))
