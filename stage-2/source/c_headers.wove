			(let-mut parameter (call next_c_value_formal (borrow-shared source) (borrow-shared nodes) first_parameter))
			(let-mut count 0i32)
			(while
				(:doc "Count the original formals before recording their checked types.")
				(i32:lt -1i32 parameter)
				(body
					(set count (i32:inc count))
