			(if
				(:doc "Keep a bad argument contract at its original defining span.")
				(u32:gtz (struct:get contracts error))
				(then (return (call c_member_error (struct:get contracts start) (struct:get contracts end)
					(struct:get contracts error)))))
			(if
				(:doc "A local snapshot names one source and has no separate native callee contract.")
				(i32:not-ltz (struct:get snapshot from))
				(then
					(let origin (array:get nodes (struct:get snapshot from)))
					(if
						(:doc "Reject native-call-only shape and provenance on a local field projection.")
						(bool:or (i32:not-eq count 1i32)
