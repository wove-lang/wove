	(fn read_c_native_parameter
		(:doc `Choose the native value or reference check from the written parameter form.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (bridge i32) (context SelectionContext))
		(returns CMemberRead)
