(module source_c_record_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read private field mappings for immediate snapshots of native records.")

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts next_form_operand validate_form_metadata))
	(use wove-file "./c_scope.wove" (only declaring_c_bridge))
	(use wove-file "./c_owners.wove" (only is_native_name read_c_type_form check_c_type_spelling))
	(use wove-file "./types.wove" (only source_builtin_type is_builtin_integer is_128bit_integer is_256bit_integer))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct SnapshotSchema (fields (native i32) (first i32) (name i32) (start i32) (end i32) (error u32)))
	(struct SnapshotField (fields (native i32) (type u32) (mode u8)))
	(let snapshot_word "snapshot")
	(let fields_word "fields")
	(let string_word "cstr")
	(let vector_word "cstrs")
	(let optional_word "optional")
	(let snapshot_scalar 1u8)
	(let snapshot_string 2u8)
	(let snapshot_vector 3u8)
	(let snapshot_optional_string 4u8)

	(fn snapshot_atom
		(:doc "Match a complete bare schema keyword or name.")
		(params (source (shared-array u8)) (node SourceNode) (word (shared-array u8))) (returns bool)
		(body (return (bool:and (node/kind.eq 1u32)
			(call same_bytes (borrow-shared source) node/start node/end
				(borrow-shared word) 0i32 word.len)))))

	(fn snapshot_schema_error
		(:doc "Keep a malformed schema at its first rejected form.")
		(params (node SourceNode)) (returns SnapshotSchema)
		(body (return (struct:new SnapshotSchema (native -1i32) (first -1i32) (name -1i32)
			(start node/start) (end node/end) (error 23u32)))))

	(fn read_snapshot_schema
		(:doc "Read the private mapping's native record spelling and ordered field list.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32)) (returns SnapshotSchema)
		(body
			(let schema (nodes.get row))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) schema))
			(let name parts/name)
			(let metadata (call validate_form_metadata (borrow-shared source) (borrow-shared nodes) schema parts))
			(if
				(:doc "Private mappings cannot select themselves independently of their bridge.")
				metadata/error.gtz
				(then (return (struct:new SnapshotSchema (native -1i32) (first -1i32) (name -1i32)
					(start metadata/start) (end metadata/end)
					(error metadata/error)))))
			(let representation parts/operands)
			(if representation.ltz (then (return (call snapshot_schema_error schema))))
			(let form (nodes.get representation))
			(let native (call check_c_type_spelling (borrow-shared source) (borrow-shared nodes)
				(call read_c_type_form (borrow-shared source) (borrow-shared nodes) form)))
			(if
				(:doc "Retain the original operand span for a bad C type.")
				native/error.gtz
				(then (return (struct:new SnapshotSchema (native -1i32) (first -1i32) (name -1i32)
					(start native/start) (end native/end) (error native/error)))))
			(let field_row (call next_form_operand (borrow-shared source) (borrow-shared nodes) form))
			(if field_row.ltz (then (return (call snapshot_schema_error schema))))
			(let list (nodes.get field_row))
			(let fields (call form_parts (borrow-shared source) (borrow-shared nodes) list))
			(let tag fields/head)
			(let extra (call next_form_operand (borrow-shared source) (borrow-shared nodes) list))
			(if
				(:doc "Require a nonempty fields list at the end of the private mapping.")
				(bool:or (tag.ltz.or fields/operands.ltz)
					(extra.not-ltz.or
						(bool:not (call snapshot_atom (borrow-shared source) (nodes.get tag) (borrow-shared fields_word)))))
				(then (return (call snapshot_schema_error list))))
			(return (struct:new SnapshotSchema (native native/native) (first fields/operands)
				(name name) (start schema/start) (end schema/end) (error 0u32)))))

	(fn find_snapshot_schema
		(:doc "Resolve a private mapping only within the function's own C bridge.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration SourceNode) (name SourceNode))
		(returns i32)
		(body
			(let bridge (call declaring_c_bridge (borrow-shared source) (borrow-shared nodes) declaration))
			(if bridge.ltz (then (return -1i32)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) (nodes.get bridge)))
			(let-mut row parts/operands)
			(let-mut found -1i32)
			(while
				(:doc "Match each direct mapping name and reject an ambiguous reference.")
				row.not-ltz
				(body
					(let item (nodes.get row))
					(let head item/first_child)
					(if
						(:doc "Other native members do not supply snapshot mappings.")
						(head.not-ltz.and
							(call snapshot_atom (borrow-shared source) (nodes.get head) (borrow-shared snapshot_word)))
						(then
							(let mapping (call form_parts (borrow-shared source) (borrow-shared nodes) item))
							(let target mapping/name)
							(if
								(:doc "Resolve the mapping by its original exact spelling.")
								(target.not-ltz.and
									(call snapshot_atom (borrow-shared source) (nodes.get target)
										(borrow-shared (source.range name/start name/end))))
								(then
									(if found.not-ltz (then (return -1i32)))
									(set found row)))))
					(set row item/next_sibling)))
			(return found)))

	(fn read_snapshot_field
		(:doc "Read a destination name, original C field name, and exact projection type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (field SourceNode)) (returns SnapshotField)
		(body
			(let bad (struct:new SnapshotField (native -1i32) (type 0u32) (mode 0u8)))
			(let target field/first_child)
			(if target.ltz (then (return bad)))
			(let native (struct:get (nodes.get target) next_sibling))
			(if native.ltz (then (return bad)))
			(let name (nodes.get native))
			(let type_row name/next_sibling)
			(if
				(:doc "Generated C may only use a portable native field identifier.")
				(type_row.ltz.or (bool:not (call is_native_name (borrow-shared source) name)))
				(then (return bad)))
			(let type (nodes.get type_row))
			(if type/next_sibling.not-ltz (then (return bad)))
			(if
				(:doc "The runtime copies the original narrow string and its null-terminated vector into owners.")
				(call snapshot_atom (borrow-shared source) type (borrow-shared string_word))
				(then (return (struct:new SnapshotField (native native) (type 0u32) (mode snapshot_string)))))
			(if
				(:doc "Every terminated vector row receives its own allocation.")
				(call snapshot_atom (borrow-shared source) type (borrow-shared vector_word))
				(then (return (struct:new SnapshotField (native native) (type 0u32) (mode snapshot_vector)))))
			(let optional (call form_parts (borrow-shared source) (borrow-shared nodes) type))
			(let head optional/head)
			(let operand optional/operands)
			(if
				(:doc "An optional pointer preserves field absence separately from an empty string.")
				(bool:and (head.not-ltz.and operand.not-ltz)
					(bool:and
						(call snapshot_atom (borrow-shared source) (nodes.get head) (borrow-shared optional_word))
						(bool:and (call snapshot_atom (borrow-shared source) (nodes.get operand) (borrow-shared string_word))
							(i32:ltz (struct:get (nodes.get operand) next_sibling)))))
				(then (return (struct:new SnapshotField (native native) (type 0u32) (mode snapshot_optional_string)))))
			(let scalar (call source_builtin_type (borrow-shared source) type))
			(if
				(:doc "The first scalar contract checks native integer member types through 64 bits.")
				(bool:and (call is_builtin_integer scalar)
					(bool:not (bool:or (call is_128bit_integer scalar) (call is_256bit_integer scalar))))
				(then (return (struct:new SnapshotField (native native) (type scalar) (mode snapshot_scalar)))))
			(return bad))))
