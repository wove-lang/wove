(module source_strings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode checked Wove string tokens. Raw backticks and physical line endings are handled here.")

	(use wove-file "./scan.wove" (only (type Token)))
	(use wove-file "../text/quoted.wove" (only decode_double_quoted))
	(use wove-file "../text/utf8.wove" (only copy_utf8_scalar utf8_width))

	(struct DecodeResult (fields (written i32) (start i32) (end i32) (error u32)))
	(struct RawUnit (fields (end i32) (replacement i32)))

	(fn raw_unit
		(:doc "Read one raw unit and return -1 to preserve its original UTF-8 bytes.")
		(params (source (shared-array u8)) (start i32) (limit i32))
		(returns RawUnit)
		(body
			(let byte (array:get source start))
			(if
				(:doc "The raw scanner pairs any backtick inside the delimiters.")
				(u8:eq byte 96u8)
				(then (return (struct:new RawUnit
					(end (i32:add start 2i32)) (replacement 96i32)))))
			(if
				(:doc "Emit one LF for a lone CR or a CRLF pair.")
				(u8:eq byte 13u8)
				(then
					(let-mut end (i32:inc start))
					(if
						(:doc "A CR at the end of the payload is already a complete line break.")
						(bool:and (i32:lt end limit)
							(u8:eq (array:get source end) 10u8))
						(then (set end (i32:inc end))))
					(return (struct:new RawUnit (end end) (replacement 10i32)))))
			(return (struct:new RawUnit
				(end (i32:add start (call utf8_width byte)))
				(replacement -1i32)))))

	(fn decode_result
		(:doc "Keep the byte count and the original source span together in every decode result.")
		(params (written i32) (start i32) (end i32) (error u32))
		(returns DecodeResult)
		(body
			(return (struct:new DecodeResult
				(written written) (start start) (end end) (error error)))))

	(fn decode_raw_string
		(:doc "Decode a checked raw span, collapsing doubled backticks and normalizing line endings.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)))
		(returns DecodeResult)
		(body
			(let limit (i32:dec end))
			(let capacity (array:len output))
			(let-mut cursor (i32:inc start))
			(let-mut written 0i32)
			(while
				(:doc "Process a whole raw unit before advancing the written prefix.")
				(i32:lt cursor limit)
				(body
					(let unit (call raw_unit (borrow-shared source) cursor limit))
					(let after (struct:get unit end))
					(let replacement (struct:get unit replacement))
					(let copy (i32:ltz replacement))
					(let-mut width 1i32)
					(if
						(:doc "Only unmodified input retains its original byte width.")
						copy
						(then (set width (i32:sub after cursor))))
					(if
						(:doc "A short view leaves the next unit and its source span unconsumed.")
						(i32:lt (i32:sub capacity written) width)
						(then (return (call decode_result written cursor after 16u32))))
					(if
						(:doc "Preserve intact multibyte scalars and write substitutions as single ASCII bytes.")
						copy
						(then (call copy_utf8_scalar (borrow-shared source) (borrow-mut output)
							cursor written width))
						(else (array:set output written (u8:from-i32 replacement))))
					(set written (i32:add written width))
					(set cursor after)))
			(return (call decode_result written start end 0u32))))

	(fn decode_string
		(:doc "Decode a checked kind-2 token from its original admitted byte view. A failure retains the complete UTF-8 prefix and the source span of the first unit that could not be decoded or written.")
		(:expect
			(tests "stage-2/source_decodings.tsv")
			(issues "gh:wove-lang/wove:65"))
		(params (source (shared-array u8)) (token Token) (output (mut-array u8)))
		(returns DecodeResult)
		(body
			(let start (struct:get token start))
			(let end (struct:get token end))
			(if
				(:doc "A backtick uses Wove's raw decoding rules.")
				(u8:eq (array:get source start) 96u8)
				(then (return (call decode_raw_string (borrow-shared source)
					start end (borrow-mut output)))))
			(let decoded (call decode_double_quoted (borrow-shared source)
				start end (borrow-mut output)))
			(let code (struct:get decoded error))
			(let-mut error 0u32)
			(if
				(:doc "Wove source diagnostics use code 16 for insufficient decoder output.")
				(u32:eq code 5u32)
				(then (set error 16u32)))
			(if
				(:doc "Wove source diagnostics use code 17 for an unpaired surrogate.")
				(u32:eq code 4u32)
				(then (set error 17u32)))
			(return (call decode_result (struct:get decoded written)
				(struct:get decoded start) (struct:get decoded end) error)))))
