(module source_strings
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Decode checked Wove string tokens. Raw backticks and physical line endings are handled here.")

	(use wove-file "./scan.wove" (only (type Token)))
	(use wove-file "../text/quoted.wove" (only decode_double_quoted))
	(use wove-file "../text/utf8.wove" (only copy_utf8_scalar utf8_width))

	(struct DecodeResult (fields (written i32) (start i32) (end i32) (error u32)))
	(struct RawUnit (fields (end i32) (replacement i32)))

	(fn raw_unit
		(:doc "Read one raw unit and return -1 to preserve its original UTF-8 bytes.")
		(params (source (shared-slice u8)) (start i32) (limit i32))
		(returns RawUnit)
		(body
			(let byte (slice.load (local source) (local start)))
			(if
				(:doc "The raw scanner pairs any backtick inside the delimiters.")
				(u8.eq (local byte) (u8 96))
				(then (return (record.make RawUnit
					(end (i32.add.wrapping (local start) (i32 2))) (replacement (i32 96))))))
			(if
				(:doc "Emit one LF for a lone CR or a CRLF pair.")
				(u8.eq (local byte) (u8 13))
				(then
					(let-mut end (i32.add.wrapping (local start) (i32 1)))
					(if
						(:doc "A CR at the end of the payload is already a complete line break.")
						(bool.and (i32.lt (local end) (local limit))
							(u8.eq (slice.load (local source) (local end)) (u8 10)))
						(then (set (local end) (i32.add.wrapping (local end) (i32 1)))))
					(return (record.make RawUnit (end (local end)) (replacement (i32 10))))))
			(return (record.make RawUnit
				(end (i32.add.wrapping (local start) (call utf8_width (local byte))))
				(replacement (i32 -1))))))

	(fn decode_result
		(:doc "Keep the byte count and the original source span together in every decode result.")
		(params (written i32) (start i32) (end i32) (error u32))
		(returns DecodeResult)
		(body
			(return (record.make DecodeResult
				(written (local written)) (start (local start)) (end (local end)) (error (local error))))))

	(fn decode_raw_string
		(:doc "Decode a checked raw span, collapsing doubled backticks and normalizing line endings.")
		(params (source (shared-slice u8)) (start i32) (end i32) (output (mut-slice u8)))
		(returns DecodeResult)
		(body
			(let limit (i32.sub.wrapping (local end) (i32 1)))
			(let capacity (slice.len (local output)))
			(let-mut cursor (i32.add.wrapping (local start) (i32 1)))
			(let-mut written (i32 0))
			(while
				(:doc "Process a whole raw unit before advancing the written prefix.")
				(i32.lt (local cursor) (local limit))
				(body
					(let unit (call raw_unit (borrow-shared (local source)) (local cursor) (local limit)))
					(let after (record.get (local unit) end))
					(let replacement (record.get (local unit) replacement))
					(let copy (i32.lt (local replacement) (i32 0)))
					(let-mut width (i32 1))
					(if
						(:doc "Only unmodified input retains its original byte width.")
						(local copy)
						(then (set (local width) (i32.sub.wrapping (local after) (local cursor)))))
					(if
						(:doc "A short view leaves the next unit and its source span unconsumed.")
						(i32.lt (i32.sub.wrapping (local capacity) (local written)) (local width))
						(then (return (call decode_result (local written) (local cursor) (local after) (u32 16)))))
					(if
						(:doc "Preserve intact multibyte scalars and write substitutions as single ASCII bytes.")
						(local copy)
						(then (call copy_utf8_scalar (borrow-shared (local source)) (borrow-mut (local output))
							(local cursor) (local written) (local width)))
						(else (slice.store (local output) (local written) (int.convert u8 (local replacement)))))
					(set (local written) (i32.add.wrapping (local written) (local width)))
					(set (local cursor) (local after))))
			(return (call decode_result (local written) (local start) (local end) (u32 0)))))

	(fn decode_string
		(:doc "Decode a checked kind-2 token from its original admitted byte view. A failure retains the complete UTF-8 prefix and the source span of the first unit that could not be decoded or written.")
		(:expect
			(tests "stage-2/source_decodings.tsv")
			(issues "gh:wove-lang/wove:65"))
		(params (source (shared-slice u8)) (token Token) (output (mut-slice u8)))
		(returns DecodeResult)
		(body
			(let start (record.get (local token) start))
			(let end (record.get (local token) end))
			(if
				(:doc "A backtick uses Wove's raw decoding rules.")
				(u8.eq (slice.load (local source) (local start)) (u8 96))
				(then (return (call decode_raw_string (borrow-shared (local source))
					(local start) (local end) (borrow-mut (local output))))))
			(let decoded (call decode_double_quoted (borrow-shared (local source))
				(local start) (local end) (borrow-mut (local output))))
			(let code (record.get (local decoded) error))
			(let-mut error (u32 0))
			(if
				(:doc "Wove source diagnostics use code 16 for insufficient decoder output.")
				(u32.eq (local code) (u32 5))
				(then (set (local error) (u32 16))))
			(if
				(:doc "Wove source diagnostics use code 17 for an unpaired surrogate.")
				(u32.eq (local code) (u32 4))
				(then (set (local error) (u32 17))))
			(return (call decode_result (record.get (local decoded) written)
				(record.get (local decoded) start) (record.get (local decoded) end) (local error))))))
