(module source_c_formals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Distinguish Wove parameters from fixed C operands in one native declaration.`)

	(use wove-file "./scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "./module.wove" (only form_parts (type FormParts)))
	(use wove-file "./imports.wove" (only import_keyword is_import_name))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./c_owners.wove" (only is_native_name is_c_pointer_candidate is_c_pointer_spelling read_c_type_form is_c_type_words))
	(use wove-file "./generics.wove" (only read_i32_constant generic_i32_value))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let null_literal "null")

	(struct CFixedFormal
		(fields (name i32) (constant i32) (native_type i32) (value i32) (pointer bool)
			(start i32) (end i32) (error u32)))

	(fn fixed_formal_error
		(:doc "Keep the invalid operand or directive at its original source span.")
		(params (start i32) (end i32) (error u32)) (returns CFixedFormal)
		(body (return (struct:new CFixedFormal (name -1i32) (constant -1i32) (native_type -1i32)
			(value 0i32) (pointer (bool false)) (start start) (end end) (error error)))))

	(fn invalid_fixed_formal
		(:doc "Diagnose a fixed operand with an invalid shape or type.")
		(params (node SourceNode)) (returns CFixedFormal)
		(body (return (call fixed_formal_error (struct:get node start)
			(struct:get node end) 23u32))))

	(fn checked_fixed_formal
		(:doc "Store the checked C operand, including whether a header name supplies a pointer.")
		(params (name i32) (constant i32) (native_type i32) (value i32) (pointer bool)) (returns CFixedFormal)
		(body (return (struct:new CFixedFormal (name name) (constant constant)
			(native_type native_type) (value value) (pointer pointer) (start 0i32) (end 0i32) (error 0u32)))))

	(fn is_fixed_null
		(:doc "Match the exact bare null literal.")
		(params (source (shared-array u8)) (node SourceNode)) (returns bool)
		(body (return (bool:and (u32:eq (struct:get node kind) 1u32)
			(call same_bytes (borrow-shared source) (struct:get node start) (struct:get node end)
				(borrow-shared null_literal) 0i32 4i32)))))

	(fn is_c_fixed_formal
		(:doc `Match const with extra operands while preserving an ordinary formal named const.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts))
		(returns bool)
		(body
			(let head (struct:get parts head))
			(let first (struct:get parts operands))
			(return (bool:and (bool:and (i32:lt -1i32 head) (i32:lt -1i32 first))
				(bool:and (u32:eq (call import_keyword (borrow-shared source) (array:get nodes head)) 14u32)
					(i32:lt -1i32 (struct:get (array:get nodes first) next_sibling)))))))

	(fn read_fixed_native
		(:doc "Validate an exact C scalar constant or a typed native null operand.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(name i32) (type SourceNode) (value SourceNode) (value_index i32))
		(returns CFixedFormal)
		(body
			(let native (call read_c_type_form (borrow-shared source) (borrow-shared nodes) type))
			(if
				(:doc "Keep a malformed c-type at its original operand or metadata span.")
				(u32:gtz (struct:get native error))
				(then (return (call fixed_formal_error (struct:get native start)
					(struct:get native end) (struct:get native error)))))
			(let literal (array:get nodes (struct:get native native)))
			(let start (struct:get literal start))
			(let end (struct:get literal end))
			(let-mut text (array:alloc u8 (i32:sub end start)))
			(let decoded (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut text)))
			(if
				(:doc "Preserve type spelling diagnostics on the original native literal.")
				(u32:gtz (struct:get decoded error))
				(then (return (call invalid_fixed_formal literal))))
			(let width (struct:get decoded written))
			(if
				(:doc "C verifies a null operand's explicit pointer or pointer typedef.")
				(call is_fixed_null (borrow-shared source) value)
				(then
					(if
						(:doc "Only pointer spellings or typedef candidates can accept null.")
						(bool:not (call is_c_pointer_candidate (borrow-shared (array:range text 0i32 width))))
						(then (return (call invalid_fixed_formal literal))))
					(return (call checked_fixed_formal name -1i32 (struct:get native native) 0i32 (bool false)))))
			(if
				(:doc "A fixed typed value names a declaration or macro from the C header.")
				(bool:not (call is_native_name (borrow-shared source) value))
				(then (return (call invalid_fixed_formal value))))
			(let pointer (call is_c_pointer_spelling (borrow-shared (array:range text 0i32 width))))
			(if
				(:doc "Typed integers keep the ordinary C type-word spelling rules.")
				(bool:and (bool:not pointer)
					(bool:not (call is_c_type_words (borrow-shared (array:range text 0i32 width)))))
				(then (return (call invalid_fixed_formal literal))))
			(return (call checked_fixed_formal name value_index
				(struct:get native native) 0i32 pointer))))

	(fn read_c_fixed_formal
		(:doc "Read a hidden i32 literal, a header constant, or a null at its exact C pointer type.")
		(:expect (issues "gh:wove-lang/wove:489"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32) (parts FormParts))
		(returns CFixedFormal)
		(body
			(let name (struct:get parts operands))
			(let named (array:get nodes name))
			(let type (array:get nodes (struct:get named next_sibling)))
			(let constant (struct:get type next_sibling))
			(if
				(:doc "The fixed form needs exactly a name, type, and value.")
				(bool:or (i32:ltz constant)
					(i32:lt -1i32 (struct:get (array:get nodes constant) next_sibling)))
				(then (return (call invalid_fixed_formal (array:get nodes row)))))
			(if
				(:doc "The hidden formal still has a Wove declaration name.")
				(bool:not (call is_import_name (borrow-shared source) named))
				(then (return (call invalid_fixed_formal named))))
			(let value (array:get nodes constant))
			(if
				(:doc "A compound type annotation gives the exact native scalar or pointer spelling.")
				(u32:eq (struct:get type kind) 40u32)
				(then (return (call read_fixed_native (borrow-shared source) (borrow-shared nodes)
					name type value constant))))
			(if
				(:doc "Integer operands use the existing exact i32 contract.")
				(u32:not-eq (call source_builtin_type (borrow-shared source) type) 5u32)
				(then (return (call invalid_fixed_formal type))))
			(if
				(:doc "Null is reserved for pointer operands.")
				(call is_fixed_null (borrow-shared source) value)
				(then (return (call invalid_fixed_formal value))))
			(if
				(:doc "Leave portable header identifiers for the C constant check.")
				(call is_native_name (borrow-shared source) value)
				(then (return (call checked_fixed_formal name constant -1i32 0i32 (bool false)))))
			(let checked (call read_i32_constant (borrow-shared source) (borrow-shared nodes)
				value (bool true)))
			(if
				(:doc "Keep the literal parser's type or range diagnostic.")
				(u32:gtz (struct:get checked error))
				(then (return (call fixed_formal_error (struct:get checked start)
					(struct:get checked end) (struct:get checked error)))))
			(return (call checked_fixed_formal name -1i32 -1i32
				(call generic_i32_value (struct:get checked value)) (bool false)))))

	(fn c_fixed_formal_at
		(:doc "Recover a checked native-only formal from its raw declaration row.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32)) (returns CFixedFormal)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
				(array:get nodes row)))
			(return (call read_c_fixed_formal (borrow-shared source) (borrow-shared nodes)
				row parts))))

	(fn c_formal_name
		(:doc `Use each formal's Wove spelling for duplicate-name checks.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (item SourceNode))
		(returns SourceNode)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
			(if
				(:doc "The fixed operand's name follows the const tag.")
				(call is_c_fixed_formal (borrow-shared source) (borrow-shared nodes) parts)
				(then (return (array:get nodes (struct:get parts operands)))))
			(return (array:get nodes (struct:get parts head)))))

	(fn next_c_value_formal
		(:doc `Skip fixed operands when walking parameter rows consumed by Wove callers.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row first)
			(while
				(:doc "Consecutive hidden operands occupy distinct C positions.")
				(i32:lt -1i32 row)
				(body
					(let item (array:get nodes row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(if
						(:doc "Resume ordinary parameter checking at this value formal.")
						(bool:not (call is_c_fixed_formal (borrow-shared source) (borrow-shared nodes) parts))
						(then (return row)))
					(set row (struct:get item next_sibling))))
			(return -1i32)))

	(fn find_c_fixed_formal
		(:doc `Find the first native-only operand from a raw formal row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row first)
			(while
				(:doc "Walk the original C declaration order independently of Wove arity.")
				(i32:lt -1i32 row)
				(body
					(let item (array:get nodes row))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) item))
					(if
						(:doc "Return the first matching row in native declaration order.")
						(call is_c_fixed_formal (borrow-shared source) (borrow-shared nodes) parts)
						(then (return row)))
					(set row (struct:get item next_sibling))))
			(return -1i32)))
)
