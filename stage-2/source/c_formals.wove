(module source_c_formals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Distinguish Wove parameters from fixed C operands in one native declaration.`)

	(use wove-file "./scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "./module.wove" (only form_parts (type FormParts)))
	(use wove-file "./imports.wove" (only import_keyword is_import_name))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./c_owners.wove" (only is_native_name is_c_pointer_candidate read_c_type_form check_c_type_spelling))
	(use wove-file "./generics.wove" (only read_i32_constant generic_i32_value))
	(use wove-file "./strings.wove" (only decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let null_literal "null")

	(struct CFixedFormal
		(fields (name i32) (constant i32) (native_type i32) (value i32)
			(start i32) (end i32) (error u32)))

	(fn fixed_formal_error
		(:doc "Keep the invalid operand or directive at its original source span.")
		(params (start i32) (end i32) (error u32)) (returns CFixedFormal)
		(body (return (struct.new CFixedFormal (name -1i32) (constant -1i32) (native_type -1i32)
			(value 0i32) (start (local start)) (end (local end)) (error (local error))))))

	(fn invalid_fixed_formal
		(:doc "Diagnose a fixed operand with an invalid shape or type.")
		(params (node SourceNode)) (returns CFixedFormal)
		(body (return (call fixed_formal_error (struct.get (local node) start)
			(struct.get (local node) end) 23u32))))

	(fn checked_fixed_formal
		(:doc "Store the checked header name, exact C type spelling, or signed literal value.")
		(params (name i32) (constant i32) (native_type i32) (value i32)) (returns CFixedFormal)
		(body (return (struct.new CFixedFormal (name (local name)) (constant (local constant))
			(native_type (local native_type)) (value (local value)) (start 0i32) (end 0i32) (error 0u32)))))

	(fn is_fixed_null
		(:doc "Match the exact bare null literal.")
		(params (source (shared-array u8)) (node SourceNode)) (returns bool)
		(body (return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
			(call same_bytes (borrow-shared (local source)) (struct.get (local node) start) (struct.get (local node) end)
				(borrow-shared (local null_literal)) 0i32 4i32)))))

	(fn is_c_fixed_formal
		(:doc `Match const with extra operands while preserving an ordinary formal named const.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts))
		(returns bool)
		(body
			(let head (struct.get (local parts) head))
			(let first (struct.get (local parts) operands))
			(return (bool.and (bool.and (i32.lt -1i32 (local head)) (i32.lt -1i32 (local first)))
				(bool.and (u32.eq (call import_keyword (borrow-shared (local source)) (array.load (local nodes) (local head))) 14u32)
					(i32.lt -1i32 (struct.get (array.load (local nodes) (local first)) next_sibling)))))))

	(fn read_fixed_native
		(:doc "Validate an exact C scalar constant or a typed native null operand.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(name i32) (type SourceNode) (value SourceNode) (value_index i32))
		(returns CFixedFormal)
		(body
			(let native (call read_c_type_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
			(if
				(:doc "Keep a malformed c-type at its original operand or metadata span.")
				(u32.gtz (struct.get (local native) error))
				(then (return (call fixed_formal_error (struct.get (local native) start)
					(struct.get (local native) end) (struct.get (local native) error)))))
			(let literal (array.load (local nodes) (struct.get (local native) native)))
			(if
				(:doc "A fixed native scalar accepts a header constant. The C compiler checks the integer type and range.")
				(bool.not (call is_fixed_null (borrow-shared (local source)) (local value)))
				(then
					(if
						(:doc "An exact scalar argument must name a native header constant.")
						(bool.not (call is_native_name (borrow-shared (local source)) (local value)))
						(then (return (call invalid_fixed_formal (local value)))))
					(let checked (call check_c_type_spelling (borrow-shared (local source)) (borrow-shared (local nodes)) (local native)))
					(if
						(:doc "Keep an invalid C type spelling at the original quoted operand.")
						(u32.gtz (struct.get (local checked) error))
						(then (return (call fixed_formal_error (struct.get (local checked) start)
							(struct.get (local checked) end) (struct.get (local checked) error)))))
					(return (call checked_fixed_formal (local name) (local value_index) (struct.get (local native) native) 0i32))))
			(let start (struct.get (local literal) start))
			(let end (struct.get (local literal) end))
			(let-mut text (array.alloc u8 (i32.sub (local end) (local start))))
			(let decoded (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local text))))
			(if
				(:doc "C verifies the indirection of a bare typedef spelling after selecting the header.")
				(bool.or (u32.gtz (struct.get (local decoded) error))
					(bool.not (call is_c_pointer_candidate
						(borrow-shared (array.range (local text) 0i32 (struct.get (local decoded) written))))))
				(then (return (call invalid_fixed_formal (local literal)))))
			(return (call checked_fixed_formal (local name) -1i32 (struct.get (local native) native) 0i32))))

	(fn read_c_fixed_formal
		(:doc "Read a hidden i32 literal, an integer header constant, or a null at its exact C pointer type.")
		(:expect (issues "gh:wove-lang/wove:489"))
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32) (parts FormParts))
		(returns CFixedFormal)
		(body
			(let name (struct.get (local parts) operands))
			(let named (array.load (local nodes) (local name)))
			(let type (array.load (local nodes) (struct.get (local named) next_sibling)))
			(let constant (struct.get (local type) next_sibling))
			(if
				(:doc "The fixed form needs exactly a name, type, and value.")
				(bool.or (i32.ltz (local constant))
					(i32.lt -1i32 (struct.get (array.load (local nodes) (local constant)) next_sibling)))
				(then (return (call invalid_fixed_formal (array.load (local nodes) (local row))))))
			(if
				(:doc "The hidden formal still has a Wove declaration name.")
				(bool.not (call is_import_name (borrow-shared (local source)) (local named)))
				(then (return (call invalid_fixed_formal (local named)))))
			(let value (array.load (local nodes) (local constant)))
			(if
				(:doc "A compound type annotation gives the exact native scalar or pointer spelling.")
				(u32.eq (struct.get (local type) kind) 40u32)
				(then (return (call read_fixed_native (borrow-shared (local source)) (borrow-shared (local nodes))
					(local name) (local type) (local value) (local constant)))))
			(if
				(:doc "Integer operands use the existing exact i32 contract.")
				(u32.not-eq (call source_builtin_type (borrow-shared (local source)) (local type)) 5u32)
				(then (return (call invalid_fixed_formal (local type)))))
			(if
				(:doc "Null is reserved for pointer operands.")
				(call is_fixed_null (borrow-shared (local source)) (local value))
				(then (return (call invalid_fixed_formal (local value)))))
			(if
				(:doc "Leave portable header identifiers for the C constant check.")
				(call is_native_name (borrow-shared (local source)) (local value))
				(then (return (call checked_fixed_formal (local name) (local constant) -1i32 0i32))))
			(let checked (call read_i32_constant (borrow-shared (local source)) (borrow-shared (local nodes))
				(local value) (bool true)))
			(if
				(:doc "Keep the literal parser's type or range diagnostic.")
				(u32.gtz (struct.get (local checked) error))
				(then (return (call fixed_formal_error (struct.get (local checked) start)
					(struct.get (local checked) end) (struct.get (local checked) error)))))
			(return (call checked_fixed_formal (local name) -1i32 -1i32
				(call generic_i32_value (struct.get (local checked) value))))))

	(fn c_fixed_formal_at
		(:doc "Recover a checked native-only formal from its raw declaration row.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32)) (returns CFixedFormal)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
				(array.load (local nodes) (local row))))
			(return (call read_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local row) (local parts)))))

	(fn c_formal_name
		(:doc `Use each formal's Wove spelling for duplicate-name checks.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (item SourceNode))
		(returns SourceNode)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(if
				(:doc "The fixed operand's name follows the const tag.")
				(call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts))
				(then (return (array.load (local nodes) (struct.get (local parts) operands)))))
			(return (array.load (local nodes) (struct.get (local parts) head)))))

	(fn next_c_value_formal
		(:doc `Skip fixed operands when walking parameter rows consumed by Wove callers.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row (local first))
			(while
				(:doc "Consecutive hidden operands occupy distinct C positions.")
				(i32.lt -1i32 (local row))
				(body
					(let item (array.load (local nodes) (local row)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(if
						(:doc "Resume ordinary parameter checking at this value formal.")
						(bool.not (call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts)))
						(then (return (local row))))
					(set (local row) (struct.get (local item) next_sibling))))
			(return -1i32)))

	(fn find_c_fixed_formal
		(:doc `Find the first native-only operand from a raw formal row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row (local first))
			(while
				(:doc "Walk the original C declaration order independently of Wove arity.")
				(i32.lt -1i32 (local row))
				(body
					(let item (array.load (local nodes) (local row)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(if
						(:doc "Return the first matching row in native declaration order.")
						(call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts))
						(then (return (local row))))
					(set (local row) (struct.get (local item) next_sibling))))
			(return -1i32)))
)
