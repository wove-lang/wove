(module source_c_formals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Distinguish Wove parameters from fixed C operands in one native declaration.`)

	(use wove-file "./scan.wove" (only (type SourceNode)))
	(use wove-file "./module.wove" (only form_parts (type FormParts)))
	(use wove-file "./imports.wove" (only import_keyword is_import_name))
	(use wove-file "./types.wove" (only source_builtin_type))
	(use wove-file "./c_owners.wove" (only is_native_name))

	(struct CFixedFormal (fields (name i32) (constant i32) (site i32)))

	(fn is_c_fixed_formal
		(:doc `Match const with extra operands while preserving an ordinary formal named const.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (parts FormParts))
		(returns bool)
		(body
			(let head (struct.get (local parts) head))
			(let first (struct.get (local parts) operands))
			(return (bool.and (bool.and (i32.lt -1i32 (local head)) (i32.lt -1i32 (local first)))
				(bool.and (u32.eq (call import_keyword (borrow-shared (local source)) (array.load (local nodes) (local head))) 14u32)
					(i32.lt -1i32 (struct.get (array.load (local nodes) (local first)) next_sibling)))))))

	(fn read_c_fixed_formal
		(:doc `Read one fixed i32 operand with a portable C constant name.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (row i32) (parts FormParts))
		(returns CFixedFormal)
		(body
			(let name (struct.get (local parts) operands))
			(let named (array.load (local nodes) (local name)))
			(let type (struct.get (local named) next_sibling))
			(let type_node (array.load (local nodes) (local type)))
			(let constant (struct.get (local type_node) next_sibling))
			(if
				(:doc "The fixed form needs exactly a name, type, and value.")
				(bool.or (i32.lt (local constant) 0i32)
					(i32.lt -1i32 (struct.get (array.load (local nodes) (local constant)) next_sibling)))
				(then (return (struct.new CFixedFormal (name -1i32) (constant -1i32) (site (local row))))))
			(if
				(:doc "The hidden formal still has a Wove declaration name.")
				(bool.not (call is_import_name (borrow-shared (local source)) (local named)))
				(then (return (struct.new CFixedFormal (name -1i32) (constant -1i32) (site (local name))))))
			(if
				(:doc "These fixed commands use an exact built-in i32 C formal.")
				(u32.not-eq (call source_builtin_type (borrow-shared (local source)) (local type_node)) 5u32)
				(then (return (struct.new CFixedFormal (name (local name)) (constant -1i32) (site (local type))))))
			(if
				(:doc "Emit only a portable header identifier in the native argument list.")
				(bool.not (call is_native_name (borrow-shared (local source)) (array.load (local nodes) (local constant))))
				(then (return (struct.new CFixedFormal (name (local name)) (constant -1i32) (site (local constant))))))
			(return (struct.new CFixedFormal (name (local name)) (constant (local constant)) (site -1i32)))))

	(fn c_formal_name
		(:doc `Use each formal's Wove spelling for duplicate-name checks.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (item SourceNode))
		(returns SourceNode)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
			(if
				(:doc "The fixed operand's name follows the const tag.")
				(call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts))
				(then (return (array.load (local nodes) (struct.get (local parts) operands)))))
			(return (array.load (local nodes) (struct.get (local parts) head)))))

	(fn next_c_value_formal
		(:doc `Skip fixed operands when walking parameter rows consumed by Wove callers.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row (local first))
			(while
				(:doc "Consecutive hidden operands occupy distinct C positions.")
				(i32.lt -1i32 (local row))
				(body
					(let item (array.load (local nodes) (local row)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(if
						(:doc "Resume ordinary parameter checking at this value formal.")
						(bool.not (call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts)))
						(then (return (local row))))
					(set (local row) (struct.get (local item) next_sibling))))
			(return -1i32)))

	(fn find_c_fixed_formal
		(:doc `Find the first native-only operand from a raw formal row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut row (local first))
			(while
				(:doc "Walk the original C declaration order independently of Wove arity.")
				(i32.lt -1i32 (local row))
				(body
					(let item (array.load (local nodes) (local row)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))
					(if
						(:doc "Return the first matching row in native declaration order.")
						(call is_c_fixed_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local parts))
						(then (return (local row))))
					(set (local row) (struct.get (local item) next_sibling))))
			(return -1i32)))
)
