(module json_workspace
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Measure array storage for observations that have no fixed JSON row budget.")

	(use wove-file "./lex.wove" (only json_peek json_scan_value json_skip_trivia))
	(use wove-file "./reader.wove" (only (type JsonNode)))

	(fn json_value_count
		(:doc "Count one row per value in a valid document. The reader still checks the complete grammar.")
		(params (source (shared-array u8))) (returns i32)
		(body
			(let length (array.len source))
			(let-mut cursor 0i32)
			(let-mut rows 0i32)
			(while
				(:doc "Each iteration consumes one lexical token or separator, so the count fits the input length.")
				(i32.lt cursor length)
				(body
					(let trivia (call json_skip_trivia (borrow-shared source) cursor))
					(if (u32.gtz (struct.get trivia error)) (then (return -1i32)))
					(set cursor (struct.get trivia end))
					(if (i32.eq cursor length) (then (return rows)))
					(let byte (array.load source cursor))
					(if
						(:doc "Closing delimiters, commas, and colons do not occupy rows.")
						(bool.or (bool.or (u8.eq byte 125u8) (u8.eq byte 93u8))
							(bool.or (u8.eq byte 44u8) (u8.eq byte 58u8)))
						(then
							(set cursor (i32.inc cursor))
							(continue)))
					(let value (call json_scan_value (borrow-shared source) cursor))
					(if (u32.gtz (struct.get value error)) (then (return -1i32)))
					(set cursor (struct.get value end))
					(if
						(:doc "A string followed by a colon is a member key and shares its value's row.")
						(u32.eq (struct.get value kind) 3u32)
						(then
							(let after (call json_skip_trivia (borrow-shared source) cursor))
							(if (u32.gtz (struct.get after error)) (then (return -1i32)))
							(set cursor (struct.get after end))
							(if
								(:doc "Leave the colon for the next separator step without counting the key.")
								(u8.eq (call json_peek (borrow-shared source) cursor) 58u8)
								(then (continue)))))
					(set rows (i32.inc rows))))
			(return rows)))

	(fn allocate_json_workspace
		(:doc "Allocate exactly the measured value rows and let the caller fall back on a sizing or allocation failure.")
		(params (source (shared-array u8))) (returns (optional (owned-array JsonNode)))
		(body
			(let rows (call json_value_count (borrow-shared source)))
			(if (i32.not-gtz rows) (then (return (optional.none (owned-array JsonNode)))))
			(return (array.try-alloc JsonNode rows))))
)
