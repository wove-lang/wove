(module json_framing
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Frame one JSON value at a time in a stream of adjacent values.")

	(use wove-file "./lex.wove"
		(only (type JsonToken) json_token json_lex_error json_skip_trivia json_scan_value json_scan_string))

	(fn json_frame
		(:doc "Locate the next value span, or an empty span at EOF. The reader validates the slice. Error 13 means offset is outside the view.")
		(params (source (shared-slice u8)) (offset i32))
		(returns JsonToken)
		(body
			(let length (slice.len (local source)))
			(if
				(:doc "Reject an offset outside the supplied byte view before attempting any lexical read.")
				(bool.or (i32.lt (local offset) 0i32) (i32.lt (local length) (local offset)))
				(then (return (call json_lex_error 13u32 (local offset) (local offset)))))
			(let trivia (call json_skip_trivia (borrow-shared (local source)) (local offset)))
			(if
				(:doc "An unterminated comment keeps its absolute source span.")
				(u32.lt 0u32 (struct.get (local trivia) error))
				(then (return (local trivia))))
			(let start (struct.get (local trivia) end))
			(if
				(:doc "End of the supplied stream is a successful empty frame.")
				(i32.eq (local start) (local length))
				(then (return (call json_token 0u32 (local start) (local start)))))
			(let root (call json_scan_value (borrow-shared (local source)) (local start)))
			(let kind (struct.get (local root) kind))
			(if
				(:doc "An invalid root or complete scalar needs no container delimiter scan.")
				(bool.or (u32.lt 0u32 (struct.get (local root) error)) (u32.lt 2u32 (local kind)))
				(then (return (local root))))
			(let-mut depth 1i32)
			(let-mut at (struct.get (local root) end))
			(while
				(:doc "Depth counts nested delimiters outside quoted strings and comments.")
				(bool.and (i32.lt 0i32 (local depth)) (i32.lt (local at) (local length)))
				(body
					(let next (call json_skip_trivia (borrow-shared (local source)) (local at)))
					(if
						(:doc "Trivia is shared with the parser and can contain otherwise significant delimiters.")
						(u32.lt 0u32 (struct.get (local next) error))
						(then (return (local next))))
					(set (local at) (struct.get (local next) end))
					(if
						(:doc "An incomplete container is framed through EOF so the reader diagnoses the missing delimiter.")
						(i32.eq (local at) (local length))
						(then (return (call json_token (local kind) (local start) (local at)))))
					(let byte (slice.load (local source) (local at)))
					(if
						(:doc "A checked quoted token may contain escapes and any delimiter without ending the frame.")
						(u8.eq (local byte) 34u8)
						(then
							(let quoted (call json_scan_string (borrow-shared (local source)) (local at)))
							(if
								(:doc "Preserve the quoted token's original invalid-escape or unterminated span.")
								(u32.lt 0u32 (struct.get (local quoted) error))
								(then (return (local quoted))))
							(set (local at) (struct.get (local quoted) end)))
						(else
							(if
								(:doc "A nested array or object adds one delimiter level.")
								(bool.or (u8.eq (local byte) 123u8) (u8.eq (local byte) 91u8))
								(then (set (local depth) (i32.add.wrapping (local depth) 1i32))))
							(if
								(:doc "The parser checks delimiter pairing and member syntax inside the candidate span.")
								(bool.or (u8.eq (local byte) 125u8) (u8.eq (local byte) 93u8))
								(then (set (local depth) (i32.sub.wrapping (local depth) 1i32))))
							(set (local at) (i32.add.wrapping (local at) 1i32))))))
			(return (call json_token (local kind) (local start) (local at))))))
