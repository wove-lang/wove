(module json_framing
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Frame one JSON value at a time in a stream of adjacent values.")

	(use wove-file "./lex.wove"
		(only (type JsonToken) json_token json_lex_error json_skip_trivia json_scan_value json_scan_string))

	(fn json_frame
		(:doc "Locate the next value span, or an empty span at EOF. The reader validates the slice. Error 13 means offset is outside the view.")
		(params (source (shared-array u8)) (offset i32))
		(returns JsonToken)
		(body
			(let length (array:len source))
			(if
				(:doc "Reject an offset outside the supplied byte view before attempting any lexical read.")
				(bool:or (i32:ltz offset) (i32:lt length offset))
				(then (return (call json_lex_error 13u32 offset offset))))
			(let trivia (call json_skip_trivia (borrow-shared source) offset))
			(if
				(:doc "An unterminated comment keeps its absolute source span.")
				(u32:gtz (struct:get trivia error))
				(then (return trivia)))
			(let start (struct:get trivia end))
			(if
				(:doc "End of the supplied stream is a successful empty frame.")
				(i32:eq start length)
				(then (return (call json_token 0u32 start start))))
			(let root (call json_scan_value (borrow-shared source) start))
			(let kind (struct:get root kind))
			(if
				(:doc "An invalid root or complete scalar needs no container delimiter scan.")
				(bool:or (u32:gtz (struct:get root error)) (u32:lt 2u32 kind))
				(then (return root)))
			(let-mut depth 1i32)
			(let-mut at (struct:get root end))
			(while
				(:doc "Depth counts nested delimiters outside quoted strings and comments.")
				(bool:and (i32:gtz depth) (i32:lt at length))
				(body
					(let next (call json_skip_trivia (borrow-shared source) at))
					(if
						(:doc "Trivia is shared with the parser and can contain otherwise significant delimiters.")
						(u32:gtz (struct:get next error))
						(then (return next)))
					(set at (struct:get next end))
					(if
						(:doc "An incomplete container is framed through EOF so the reader diagnoses the missing delimiter.")
						(i32:eq at length)
						(then (return (call json_token kind start at))))
					(let byte (array:load source at))
					(if
						(:doc "A checked quoted token may contain escapes and any delimiter without ending the frame.")
						(u8:eq byte 34u8)
						(then
							(let quoted (call json_scan_string (borrow-shared source) at))
							(if
								(:doc "Preserve the quoted token's original invalid-escape or unterminated span.")
								(u32:gtz (struct:get quoted error))
								(then (return quoted)))
							(set at (struct:get quoted end)))
						(else
							(if
								(:doc "A nested array or object adds one delimiter level.")
								(bool:or (u8:eq byte 123u8) (u8:eq byte 91u8))
								(then (set depth (i32:inc depth))))
							(if
								(:doc "The parser checks delimiter pairing and member syntax inside the candidate span.")
								(bool:or (u8:eq byte 125u8) (u8:eq byte 93u8))
								(then (set depth (i32:dec depth))))
							(set at (i32:inc at))))))
			(return (call json_token kind start at)))))
