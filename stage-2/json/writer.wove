(module json_writer_module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write one compact JSON value into caller-owned bytes.

	Start with json_writer and thread its returned state through each call
	with the same output and nesting slices. The nesting slice uses one byte
	per open container. Call json_finish before reading the output. On
	success written is the byte length without a terminator. Discard the
	output on failure.

	Errors are sticky. Code 1 means output capacity, 2 means nesting
	capacity, 3 means an invalid sequence of calls, and 4 means invalid UTF-8.`)

	(use wove-file "../text/bytes.wove" (only (as write_byte json_byte)))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_i32 write_decimal_u32))
	(use wove-file "./keywords.wove" (only (value true_keyword) (value false_keyword) (value null_keyword)))
	(use wove-file "./text.wove" (only json_keyword json_quoted))

	(struct JsonWriter (fields (written i32) (depth i32) (error u32)))

	(fn json_writer
		(:doc "Start a fresh writer at byte zero with no open containers.")
		(params)
		(returns JsonWriter)
		(body (return (struct.new JsonWriter (written 0i32) (depth 0i32) (error 0u32)))))

	(fn writer_error
		(:doc "Keep the current counters when recording a failure.")
		(params (writer JsonWriter) (error u32))
		(returns JsonWriter)
		(body
			(return (struct.new JsonWriter
				(written (struct.get (local writer) written))
				(depth (struct.get (local writer) depth))
				(error (local error))))))

	(fn writer_offset
		(:doc "Commit an emission cursor or translate its failure to a writer error.")
		(params (writer JsonWriter) (next i32))
		(returns JsonWriter)
		(body
			(if
				(:doc "The string emitter rejects malformed UTF-8 with its own sentinel.")
				(i32.eq (local next) -2i32)
				(then (return (call writer_error (local writer) 4u32))))
			(if
				(:doc "A negative cursor marks the first byte that did not fit.")
				(i32.lt (local next) 0i32)
				(then (return (call writer_error (local writer) 1u32))))
			(return (struct.new JsonWriter (written (local next))
				(depth (struct.get (local writer) depth)) (error 0u32)))))

	(fn start_value
		(:doc "A root value needs no prefix. An array value may follow a comma, and an object value must follow a key.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body
			(if
				(:doc "A failed operation prevents all later output and stack changes.")
				(u32.not-eq (struct.get (local writer) error) 0u32)
				(then (return (local writer))))
			(let depth (struct.get (local writer) depth))
			(let offset (struct.get (local writer) written))
			(if
				(:doc "Only one value is allowed at the root.")
				(i32.eq (local depth) 0i32)
				(then
					(if
						(:doc "A nonempty output at depth zero already contains a root value.")
						(i32.eq (local offset) 0i32)
						(then (return (local writer))))
					(return (call writer_error (local writer) 3u32))))
			(let top (i32.sub (local depth) 1i32))
			(let frame (array.load (local stack) (local top)))
			(if
				(:doc "A value consumes the pending object key, which already emitted its colon.")
				(u8.eq (local frame) 4u8)
				(then
					(array.store (local stack) (local top) 3u8)
					(return (local writer))))
			(if
				(:doc "An empty array has no comma before its first value.")
				(u8.eq (local frame) 0u8)
				(then
					(array.store (local stack) (local top) 1u8)
					(return (local writer))))
			(if
				(:doc "A nonempty array separates its values with a comma.")
				(u8.eq (local frame) 1u8)
				(then
					(return (call writer_offset (local writer)
						(call json_byte (borrow-mut (local output)) (local offset) 44u8)))))
			(return (call writer_error (local writer) 3u32))))

	(fn begin_container
		(:doc "Open an object or array as the next value. Frames 0 and 1 are empty and nonempty arrays, 2 and 3 are empty and nonempty objects, and 4 awaits an object value.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (opener u8) (frame u8))
		(returns JsonWriter)
		(body
			(let state (call start_value (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "A rejected value cannot open another frame.")
				(u32.not-eq (struct.get (local state) error) 0u32)
				(then (return (local state))))
			(let depth (struct.get (local state) depth))
			(if
				(:doc "The caller supplies one frame slot per open container.")
				(i32.not-lt (local depth) (array.len (local stack)))
				(then (return (call writer_error (local state) 2u32))))
			(let next (call json_byte (borrow-mut (local output)) (struct.get (local state) written) (local opener)))
			(if
				(:doc "Only a written delimiter opens a new frame.")
				(i32.lt (local next) 0i32)
				(then (return (call writer_error (local state) 1u32))))
			(array.store (local stack) (local depth) (local frame))
			(return (struct.new JsonWriter (written (local next))
				(depth (i32.add (local depth) 1i32)) (error 0u32)))))

	(fn json_begin_object
		(:doc "Start an object in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body (return (call begin_container (local writer) (borrow-mut (local output)) (borrow-mut (local stack)) 123u8 2u8))))

	(fn json_begin_array
		(:doc "Start an array in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body (return (call begin_container (local writer) (borrow-mut (local output)) (borrow-mut (local stack)) 91u8 0u8))))

	(fn end_container
		(:doc "Close the requested container only when its frame allows a closing delimiter.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (shared-array u8))
			(closer u8) (empty u8) (nonempty u8))
		(returns JsonWriter)
		(body
			(if
				(:doc "Preserve the existing failure before inspecting the nesting stack.")
				(u32.not-eq (struct.get (local writer) error) 0u32)
				(then (return (local writer))))
			(let depth (struct.get (local writer) depth))
			(if
				(:doc "At the root there is no opener to match.")
				(i32.eq (local depth) 0i32)
				(then (return (call writer_error (local writer) 3u32))))
			(let top (i32.sub (local depth) 1i32))
			(let frame (array.load (local stack) (local top)))
			(if
				(:doc "Closing a different container or leaving a key without a value is invalid.")
				(bool.not (bool.or (u8.eq (local frame) (local empty)) (u8.eq (local frame) (local nonempty))))
				(then (return (call writer_error (local writer) 3u32))))
			(let next (call json_byte (borrow-mut (local output)) (struct.get (local writer) written) (local closer)))
			(if
				(:doc "A failed closing delimiter keeps its frame open.")
				(i32.lt (local next) 0i32)
				(then (return (call writer_error (local writer) 1u32))))
			(return (struct.new JsonWriter (written (local next)) (depth (local top)) (error 0u32)))))

	(fn json_end_object
		(:doc "Close the current complete object.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (shared-array u8)))
		(returns JsonWriter)
		(body (return (call end_container (local writer) (borrow-mut (local output)) (borrow-shared (local stack)) 125u8 2u8 3u8))))

	(fn json_end_array
		(:doc "Close the current array.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (shared-array u8)))
		(returns JsonWriter)
		(body (return (call end_container (local writer) (borrow-mut (local output)) (borrow-shared (local stack)) 93u8 0u8 1u8))))

	(fn json_key
		(:doc "Write a string key and colon in the current object and require its next value.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (text (shared-array u8)))
		(returns JsonWriter)
		(body
			(if
				(:doc "Preserve the first error and avoid touching either buffer.")
				(u32.not-eq (struct.get (local writer) error) 0u32)
				(then (return (local writer))))
			(let depth (struct.get (local writer) depth))
			(if
				(:doc "Keys exist only inside an object.")
				(i32.eq (local depth) 0i32)
				(then (return (call writer_error (local writer) 3u32))))
			(let top (i32.sub (local depth) 1i32))
			(let frame (array.load (local stack) (local top)))
			(if
				(:doc "A key opens a member only before the first member or after a complete member.")
				(bool.not (bool.or (u8.eq (local frame) 2u8) (u8.eq (local frame) 3u8)))
				(then (return (call writer_error (local writer) 3u32))))
			(let-mut next (struct.get (local writer) written))
			(if
				(:doc "Only members after the first need a comma.")
				(u8.eq (local frame) 3u8)
				(then (set (local next) (call json_byte (borrow-mut (local output)) (local next) 44u8))))
			(set (local next) (call json_quoted (borrow-mut (local output)) (local next) (borrow-shared (local text))))
			(if
				(:doc "A failed key cannot advance the object into its value state.")
				(i32.lt (local next) 0i32)
				(then (return (call writer_offset (local writer) (local next)))))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) 58u8))
			(if
				(:doc "A complete key includes the colon before its value.")
				(i32.not-lt (local next) 0i32)
				(then (array.store (local stack) (local top) 4u8)))
			(return (call writer_offset (local writer) (local next)))))

	(fn json_string
		(:doc "Write a quoted UTF-8 string in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (text (shared-array u8)))
		(returns JsonWriter)
		(body
			(let state (call start_value (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "Emit the value only after its position is accepted.")
				(u32.not-eq (struct.get (local state) error) 0u32)
				(then (return (local state))))
			(return (call writer_offset (local state)
				(call json_quoted (borrow-mut (local output)) (struct.get (local state) written) (borrow-shared (local text)))))))

	(fn json_i32
		(:doc "Write a signed decimal integer in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (value i32))
		(returns JsonWriter)
		(body
			(let state (call start_value (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "Emit the value only after its position is accepted.")
				(u32.not-eq (struct.get (local state) error) 0u32)
				(then (return (local state))))
			(return (call writer_offset (local state)
				(call write_decimal_i32 (borrow-mut (local output)) (struct.get (local state) written) (local value))))))

	(fn json_u32
		(:doc "Write an unsigned decimal integer in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (value u32))
		(returns JsonWriter)
		(body
			(let state (call start_value (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "Emit the value only after its position is accepted.")
				(u32.not-eq (struct.get (local state) error) 0u32)
				(then (return (local state))))
			(return (call writer_offset (local state)
				(call write_decimal_u32 (borrow-mut (local output)) (struct.get (local state) written) (local value))))))

	(fn write_keyword_value
		(:doc "Emit the keyword after accepting its value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (keyword (shared-array u8)))
		(returns JsonWriter)
		(body
			(let state (call start_value (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "A rejected value position leaves the output untouched.")
				(u32.not-eq (struct.get (local state) error) 0u32)
				(then (return (local state))))
			(return (call writer_offset (local state)
				(call json_keyword (borrow-mut (local output)) (struct.get (local state) written)
					(borrow-shared (local keyword)))))))

	(fn json_bool
		(:doc "Write true or false in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)) (value bool))
		(returns JsonWriter)
		(body
			(if
				(:doc "Select the true keyword when the input is true.")
				(local value)
				(then (return (call write_keyword_value (local writer) (borrow-mut (local output))
					(borrow-mut (local stack)) (borrow-shared (local true_keyword))))))
			(return (call write_keyword_value (local writer) (borrow-mut (local output))
				(borrow-mut (local stack)) (borrow-shared (local false_keyword))))))

	(fn json_null
		(:doc "Write null in the current value position.")
		(params (writer JsonWriter) (output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body
			(return (call write_keyword_value (local writer) (borrow-mut (local output))
				(borrow-mut (local stack)) (borrow-shared (local null_keyword))))))

	(fn json_finish
		(:doc "Require exactly one complete value and return its written length or the first error.")
		(params (writer JsonWriter))
		(returns JsonWriter)
		(body
			(if
				(:doc "A previous failure takes precedence over an incomplete document.")
				(u32.not-eq (struct.get (local writer) error) 0u32)
				(then (return (local writer))))
			(if
				(:doc "Success requires some output and no remaining open containers.")
				(bool.or (i32.eq (struct.get (local writer) written) 0i32)
					(i32.not-eq (struct.get (local writer) depth) 0i32))
				(then (return (call writer_error (local writer) 3u32))))
			(return (local writer)))))
