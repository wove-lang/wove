(module json_text
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit the bounded UTF-8 and ASCII fragments of a JSON document.")

	(use wove-file "../text/utf8.wove" (only utf8_invalid_offset))
	(use wove-file "../text/bytes.wove" (only (as write_byte json_byte)))

	(fn json_quoted
		(:doc "Emit a quoted validated UTF-8 string. Return -1 for capacity or -2 for invalid UTF-8.")
		(params (output (mut-array u8)) (offset i32) (text (shared-array u8)))
		(returns i32)
		(body
			(if
				(:doc "A previous capacity failure takes precedence over inspecting the next fragment.")
				(i32.lt (local offset) 0i32)
				(then (return (local offset))))
			(if
				(:doc "Reject malformed UTF-8 before emitting any of the string.")
				(i32.not-eq (call utf8_invalid_offset (borrow-shared (local text))) -1i32)
				(then (return -2i32)))
			(let-mut next (call json_byte (borrow-mut (local output)) (local offset) 34u8))
			(let-mut cursor 0i32)
			(while
				(:doc "Copy literal UTF-8 bytes and escape only JSON punctuation and control bytes.")
				(bool.and (i32.not-lt (local next) 0i32)
					(i32.lt (local cursor) (array.len (local text))))
				(body
					(let byte (array.load (local text) (local cursor)))
					(if
						(:doc "ASCII controls use six-byte escapes of the form \u005Cu00xx.")
						(u8.lt (local byte) 32u8)
						(then
							(set (local next) (call json_control_escape
								(borrow-mut (local output)) (local next) (i32.from-u8 (local byte)))))
						(else
							(if
								(:doc "Quote and backslash retain their byte after a backslash.")
								(bool.or (u8.eq (local byte) 34u8) (u8.eq (local byte) 92u8))
								(then (set (local next)
									(call json_byte (borrow-mut (local output)) (local next) 92u8))))
							(set (local next) (call json_byte (borrow-mut (local output)) (local next) (local byte)))))
					(set (local cursor) (i32.add (local cursor) 1i32))))
			(return (call json_byte (borrow-mut (local output)) (local next) 34u8))))

	(fn json_control_escape
		(:doc "Emit the Unicode escape for one byte in the range 0 through 31.")
		(params (output (mut-array u8)) (offset i32) (byte i32))
		(returns i32)
		(body
			(let-mut next (call json_byte (borrow-mut (local output)) (local offset) 92u8))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) 117u8))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) 48u8))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) 48u8))
			(let-mut high 48u8)
			(let-mut low (local byte))
			(if
				(:doc "Only bit four can contribute to the high hex digit.")
				(i32.not-lt (local byte) 16i32)
				(then
					(set (local high) 49u8)
					(set (local low) (i32.sub (local byte) 16i32))))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (local high)))
			(let-mut base 48i32)
			(if
				(:doc "Lowercase hex letters start at ASCII 97 for digit ten.")
				(i32.not-lt (local low) 10i32)
				(then (set (local base) 87i32)))
			(return (call json_byte (borrow-mut (local output)) (local next)
				(u8.from-i32 (i32.add (local base) (local low)))))))

	(fn json_keyword
		(:doc "Write the keyword bytes in order, returning -1 if any byte does not fit.")
		(params (output (mut-array u8)) (offset i32) (keyword (shared-array u8)))
		(returns i32)
		(body
			(let width (array.len (local keyword)))
			(let-mut index 0i32)
			(let-mut next (local offset))
			(while
				(:doc "Each bounded write leaves the already emitted prefix in the output.")
				(i32.lt (local index) (local width))
				(body
					(set (local next) (call json_byte (borrow-mut (local output)) (local next)
						(array.load (local keyword) (local index))))
					(if (i32.lt (local next) 0i32) (then (return (local next))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (local next)))))
