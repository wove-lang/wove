(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Emit the bounded UTF-8 and ASCII fragments of a JSON document.")
	json_text

	(use wove-file "../text/utf8.wove" (only utf8_invalid_offset))
	(use wove-file "../text/bytes.wove" (only (as write_byte json_byte)))

	(fn
		(:doc "Emit a quoted validated UTF-8 string. Return -1 for capacity or -2 for invalid UTF-8.")
		json_quoted
		(params (output (mut-slice u8)) (offset i32) (text (shared-slice u8)))
		(returns i32)
		(body
			(if
				(:doc "A previous capacity failure takes precedence over inspecting the next fragment.")
				(i32.lt (local offset) (i32 0))
				(then (return (local offset))))
			(if
				(:doc "Reject malformed UTF-8 before emitting any of the string.")
				(bool.not (i32.eq (call utf8_invalid_offset (borrow-shared (local text))) (i32 -1)))
				(then (return (i32 -2))))
			(let-mut next (call json_byte (borrow-mut (local output)) (local offset) (u8 34)))
			(let-mut cursor (i32 0))
			(while
				(:doc "Copy literal UTF-8 bytes and escape only JSON punctuation and control bytes.")
				(bool.and (bool.not (i32.lt (local next) (i32 0)))
					(i32.lt (local cursor) (slice.len (local text))))
				(body
					(let byte (slice.load (local text) (local cursor)))
					(if
						(:doc "ASCII controls use six-byte escapes of the form \u005Cu00xx.")
						(u8.lt (local byte) (u8 32))
						(then
							(set (local next) (call json_control_escape
								(borrow-mut (local output)) (local next) (int.convert i32 (local byte)))))
						(else
							(if
								(:doc "Quote and backslash retain their byte after a backslash.")
								(bool.or (u8.eq (local byte) (u8 34)) (u8.eq (local byte) (u8 92)))
								(then (set (local next)
									(call json_byte (borrow-mut (local output)) (local next) (u8 92)))))
							(set (local next) (call json_byte (borrow-mut (local output)) (local next) (local byte)))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (call json_byte (borrow-mut (local output)) (local next) (u8 34)))))

	(fn
		(:doc "Emit the Unicode escape for one byte in the range 0 through 31.")
		json_control_escape
		(params (output (mut-slice u8)) (offset i32) (byte i32))
		(returns i32)
		(body
			(let-mut next (call json_byte (borrow-mut (local output)) (local offset) (u8 92)))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 117)))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 48)))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 48)))
			(let-mut high (u8 48))
			(let-mut low (local byte))
			(if
				(:doc "Only bit four can contribute to the high hex digit.")
				(bool.not (i32.lt (local byte) (i32 16)))
				(then
					(set (local high) (u8 49))
					(set (local low) (i32.sub.wrapping (local byte) (i32 16)))))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (local high)))
			(let-mut base (i32 48))
			(if
				(:doc "Lowercase hex letters start at ASCII 97 for digit ten.")
				(bool.not (i32.lt (local low) (i32 10)))
				(then (set (local base) (i32 87))))
			(return (call json_byte (borrow-mut (local output)) (local next)
				(int.convert u8 (i32.add.wrapping (local base) (local low)))))))

	(fn
		(:doc "Emit one of the three JSON keywords selected by its first ASCII byte.")
		json_keyword
		(params (output (mut-slice u8)) (offset i32) (first u8))
		(returns i32)
		(body
			(let-mut next (call json_byte (borrow-mut (local output)) (local offset) (local first)))
			(if
				(:doc "The keyword true has the suffix rue.")
				(u8.eq (local first) (u8 116))
				(then
					(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 114)))
					(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 117)))
					(return (call json_byte (borrow-mut (local output)) (local next) (u8 101)))))
			(if
				(:doc "The keyword false has the suffix alse.")
				(u8.eq (local first) (u8 102))
				(then
					(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 97)))
					(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 108)))
					(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 115)))
					(return (call json_byte (borrow-mut (local output)) (local next) (u8 101)))))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 117)))
			(set (local next) (call json_byte (borrow-mut (local output)) (local next) (u8 108)))
			(return (call json_byte (borrow-mut (local output)) (local next) (u8 108))))))
