(module json_reader
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Parse one JSONC value into caller-owned rows.

	The root occupies row zero. Each value occupies one row, in source
	order. Object values also carry their member key's quoted span.
	Nonmembers have -1 for both key offsets. Containers link their children
	in source order through first_child and next_sibling. Absent links
	are -1. Kinds 1 through 7 are object, array, string, number, true,
	false, and null. All source spans are half-open UTF-8 byte ranges.
	Number spans preserve the complete original lexeme. Call json_parse for
	JSON separator rules or json_parse_with_options to allow a single final
	comma after a member or item.

	A successful parse reports the populated row count and the root span.
	On failure, discard the rows. Error codes are 1 invalid UTF-8,
	2 expected value, 3 malformed string, 4 malformed number,
	5 malformed literal, 6 unterminated comment, 7 expected object key,
	8 expected colon, 9 expected comma or closing delimiter,
	10 trailing content, and 11 insufficient row capacity.
	The string decoder additionally uses 12 for insufficient byte capacity.`)

	(use wove-file "./lex.wove"
		(only (type JsonToken) json_error_at json_lex_error json_peek json_scan_string json_scan_value json_skip_trivia))
	(use wove-file "../text/quoted.wove" (only decode_double_quoted))
	(use wove-file "../text/utf8.wove" (only utf8_invalid_offset))

	(struct JsonNode
		(fields (kind u32) (start i32) (end i32) (key_start i32) (key_end i32)
			(parent i32) (first_child i32) (last_child i32) (next_sibling i32)))
	(struct JsonParseResult (fields (rows i32) (error u32) (start i32) (end i32)))
	(struct JsonStringResult (fields (written i32) (error u32) (start i32) (end i32)))

	(fn parse_failure
		(:doc "Forward a lexical or syntax diagnostic and invalidate the output rows.")
		(params (token JsonToken))
		(returns JsonParseResult)
		(body
			(return (struct:new JsonParseResult (rows 0i32) (error token/error)
				(start token/start) (end token/end)))))

	(fn is_json_container
		(:doc "Return true for the kinds whose rows track children and a closing delimiter.")
		(params (kind u32))
		(returns bool)
		(body
			(return (bool:or (u32:eq kind 1u32) (u32:eq kind 2u32)))))

	(fn store_value
		(:doc "Append a new value row with no children or following sibling.")
		(params (nodes (mut-array JsonNode)) (index i32) (value JsonToken) (parent i32)
			(key_start i32) (key_end i32))
		(returns void)
		(body
			(nodes.set index
				(struct:new JsonNode (kind value/kind)
					(start value/start) (end value/end)
					(key_start key_start) (key_end key_end) (parent parent)
					(first_child -1i32) (last_child -1i32) (next_sibling -1i32)))))

	(fn update_row
		(:doc "Replace the chosen span end and child or sibling links while preserving the row identity.")
		(params (nodes (mut-array JsonNode)) (index i32) (node JsonNode)
			(end i32) (first i32) (last i32) (sibling i32))
		(returns void)
		(body
			(nodes.set index
				(struct:new JsonNode (kind node/kind)
					(start node/start) (end end)
					(key_start node/key_start) (key_end node/key_end)
					(parent node/parent)
					(first_child first) (last_child last) (next_sibling sibling)))))

	(fn link_child
		(:doc "Link a new child to its container and to the preceding sibling when present.")
		(params (nodes (mut-array JsonNode)) (parent i32) (node JsonNode) (child i32))
		(returns void)
		(body
			(let last node/last_child)
			(let-mut first node/first_child)
			(if
				(:doc "The first child has no previous sibling to update.")
				(i32:ltz last)
				(then (set first child))
				(else
					(let previous (nodes.get last))
					(call update_row (borrow-mut nodes) last previous
						previous/end previous/first_child
						previous/last_child child)))
			(call update_row (borrow-mut nodes) parent node
				node/end first child node/next_sibling)))

	(fn json_parse_with_options
		(:doc "Use each open container's parent link as the parse stack, even at deep nesting.")
		(params (source (shared-array u8)) (nodes (mut-array JsonNode)) (trailing_commas bool))
		(returns JsonParseResult)
		(body
			(let invalid (call utf8_invalid_offset (borrow-shared source)))
			(if
				(:doc "Anchor invalid UTF-8 at its first offending lead byte.")
				(i32:not-eq invalid -1i32)
				(then (return (call parse_failure
					(call json_error_at (borrow-shared source) 1u32 invalid)))))
			(let initial (call json_skip_trivia (borrow-shared source) 0i32))
			(if
				(:doc "An open comment can prevent the parser from finding the root.")
				(u32:gtz initial/error)
				(then (return (call parse_failure initial))))
			(let root (call json_scan_value (borrow-shared source) initial/end))
			(if
				(:doc "Reject a malformed or absent root before writing rows.")
				(u32:gtz root/error)
				(then (return (call parse_failure root))))
			(let capacity nodes.len)
			(if
				(:doc "The root requires one row, even when it is scalar or empty.")
				(i32:eqz capacity)
				(then (return (call parse_failure (call json_lex_error 11u32
					root/start root/end)))))
			(call store_value (borrow-mut nodes) 0i32 root -1i32 -1i32 -1i32)
			(let-mut parent -1i32)
			(if
				(:doc "A scalar root is complete after its first token.")
				(call is_json_container root/kind)
				(then (set parent 0i32)))
			(let-mut cursor root/end)
			(let-mut rows 1i32)
			(while
				(:doc "At each iteration, the cursor is just after a container opener or its most recent complete child.")
				(i32:not-ltz parent)
				(body
					(let trivia (call json_skip_trivia (borrow-shared source) cursor))
					(if
						(:doc "Retain a comment error before interpreting any punctuation.")
						(u32:gtz trivia/error)
						(then (return (call parse_failure trivia))))
					(set cursor trivia/end)
					(let node (nodes.get parent))
					(let object (u32:eq node/kind 1u32))
					(let-mut close 93u8)
					(if
						(:doc "Only an object closes with a brace.")
						object
						(then (set close 125u8)))
					(let-mut byte (call json_peek (borrow-shared source) cursor))
					(if
						(:doc "A complete child requires either a closing delimiter or a separating comma.")
						(bool:and (u8:not-eq byte close)
							(i32:not-ltz node/last_child))
						(then
							(if
								(:doc "Diagnose a missing comma at the next significant byte.")
								(u8:not-eq byte 44u8)
								(then (return (call parse_failure
									(call json_error_at (borrow-shared source) 9u32 cursor)))))
							(let after (call json_skip_trivia (borrow-shared source)
								(i32:inc cursor)))
							(if
								(:doc "A malformed comment after the comma keeps its original diagnostic.")
								(u32:gtz after/error)
								(then (return (call parse_failure after))))
							(set cursor after/end)
							(if
								(:doc "With trailing commas enabled the next closer can end this container.")
								trailing_commas
								(then (set byte (call json_peek (borrow-shared source) cursor))))))
					(if
						(:doc "An immediate closer completes an empty container or follows its last child.")
						(u8:eq byte close)
						(then
							(set cursor (i32:inc cursor))
							(call update_row (borrow-mut nodes) parent node cursor
								node/first_child node/last_child
								node/next_sibling)
							(set parent node/parent))
						(else
							(let-mut key_start -1i32)
							(let-mut key_end -1i32)
							(if
								(:doc "A member starts with a string key followed by a colon.")
								object
								(then
									(if
										(:doc "A member that has not closed the object requires a quoted key.")
										(u8:not-eq (call json_peek (borrow-shared source) cursor) 34u8)
										(then (return (call parse_failure
											(call json_error_at (borrow-shared source) 7u32 cursor)))))
									(let key (call json_scan_string (borrow-shared source) cursor))
									(if
										(:doc "A malformed key keeps its string diagnostic span.")
										(u32:gtz key/error)
										(then (return (call parse_failure key))))
									(set key_start key/start)
									(set key_end key/end)
									(let separator (call json_skip_trivia (borrow-shared source) key_end))
									(if
										(:doc "Trivia between a key and colon can itself be malformed.")
										(u32:gtz separator/error)
										(then (return (call parse_failure separator))))
									(let colon separator/end)
									(if
										(:doc "Only a colon separates the key from its value.")
										(u8:not-eq (call json_peek (borrow-shared source) colon) 58u8)
										(then (return (call parse_failure
											(call json_error_at (borrow-shared source) 8u32 colon)))))
									(let after (call json_skip_trivia (borrow-shared source)
										(i32:inc colon)))
									(if
										(:doc "A complete key and colon still require an admitted value.")
										(u32:gtz after/error)
										(then (return (call parse_failure after))))
									(set cursor after/end)))
							(let value (call json_scan_value (borrow-shared source) cursor))
							(if
								(:doc "A malformed or missing child retains the value scanner's diagnostic.")
								(u32:gtz value/error)
								(then (return (call parse_failure value))))
							(if
								(:doc "Check the next row slot before writing it or changing any links.")
								(i32:eq rows capacity)
								(then (return (call parse_failure (call json_lex_error 11u32
									value/start value/end)))))
							(call store_value (borrow-mut nodes) rows value
								parent key_start key_end)
							(call link_child (borrow-mut nodes) parent node rows)
							(if
								(:doc "An opened container becomes the new parent until its closer is consumed.")
								(call is_json_container value/kind)
								(then (set parent rows)))
							(set cursor value/end)
							(set rows (i32:inc rows))))))
			(let trailing (call json_skip_trivia (borrow-shared source) cursor))
			(if
				(:doc "A root followed by an unterminated comment is still invalid input.")
				(u32:gtz trailing/error)
				(then (return (call parse_failure trailing))))
			(let after trailing/end)
			(if
				(:doc "Only trivia may follow the single complete value.")
				(i32:not-eq after source.len)
				(then (return (call parse_failure (call json_error_at (borrow-shared source) 10u32 after)))))
			(return (struct:new JsonParseResult (rows rows) (error 0u32)
				(start root/start) (end cursor)))))

	(fn json_parse
		(:doc "Parse JSONC comments with strict JSON separator rules.")
		(params (source (shared-array u8)) (nodes (mut-array JsonNode)))
		(returns JsonParseResult)
		(body (return (call json_parse_with_options
			(borrow-shared source) (borrow-mut nodes) (bool false)))))

	(fn json_decode_string
		(:doc "Decode a validated key or string span returned by json_parse from the same source. A short output view preserves the written UTF-8 prefix and identifies the first scalar that did not fit.")
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8)))
		(returns JsonStringResult)
		(body
			(let decoded (call decode_double_quoted (borrow-shared source)
				start end (borrow-mut output)))
			(let-mut error 0u32)
			(if
				(:doc "A validated span can only fail decoding when its output is too short.")
				(u32:gtz decoded/error)
				(then (set error 12u32)))
			(return (struct:new JsonStringResult
				(written decoded/written) (error error)
				(start decoded/start) (end decoded/end))))))
