(module json_lex
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Scan JSON values and JSONC trivia while retaining their original byte spans.")

	(use wove-file "./keywords.wove" (only (value true_keyword) (value false_keyword) (value null_keyword)))
	(use wove-file "../text/quoted.wove" (only scan_double_quoted validate_double_quoted_scalars))

	(struct JsonToken (fields (kind u32) (start i32) (end i32) (error u32)))

	(fn json_peek
		(:doc "Read a byte or return zero at the end of the view.")
		(params (source (shared-array u8)) (at i32))
		(returns u8)
		(body
			(if
				(:doc "The virtual end byte is neither trivia nor valid JSON punctuation.")
				(i32:not-lt at (array:len source))
				(then (return 0u8)))
			(return (array:get source at))))

	(fn json_token
		(:doc "Create a successful token with its original byte span.")
		(params (kind u32) (start i32) (end i32))
		(returns JsonToken)
		(body (return (struct:new JsonToken (kind kind) (start start) (end end) (error 0u32)))))

	(fn json_lex_error
		(:doc "Retain the source span that caused a lexical or syntax error.")
		(params (error u32) (start i32) (end i32))
		(returns JsonToken)
		(body (return (struct:new JsonToken (kind 0u32) (start start) (end end) (error error)))))

	(fn json_error_at
		(:doc "Locate an unexpected byte, or use an empty span at end of input.")
		(params (source (shared-array u8)) (error u32) (at i32))
		(returns JsonToken)
		(body
			(if
				(:doc "At EOF the span has no byte to cover.")
				(i32:eq at (array:len source))
				(then (return (call json_lex_error error at at))))
			(return (call json_lex_error error at (i32:inc at)))))

	(fn json_whitespace
		(:doc "Recognize exactly the four ASCII bytes that JSON treats as whitespace.")
		(params (byte u8))
		(returns bool)
		(body
			(return
				(bool:or (bool:or (u8:eq byte 32u8) (u8:eq byte 9u8))
					(bool:or (u8:eq byte 10u8) (u8:eq byte 13u8))))))

	(fn line_comment_end
		(:doc "Skip a line comment up to a physical line ending or EOF.")
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "Only actual CR and LF bytes end a line comment.")
				(i32:lt cursor (array:len source))
				(body
					(let byte (array:get source cursor))
					(if
						(:doc "Leave the line break for the whitespace check.")
						(bool:or (u8:eq byte 10u8) (u8:eq byte 13u8))
						(then (return cursor)))
					(set cursor (i32:inc cursor))))
			(return cursor)))

	(fn block_comment_end
		(:doc "Find the byte after the first block-comment closer, or return -1.")
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "A closer needs room for both bytes.")
				(i32:lt cursor (i32:dec (array:len source)))
				(body
					(if
						(:doc "The first star followed by slash terminates the comment.")
						(bool:and (u8:eq (array:get source cursor) 42u8)
							(u8:eq (array:get source (i32:inc cursor)) 47u8))
						(then (return (i32:add cursor 2i32))))
					(set cursor (i32:inc cursor))))
			(return -1i32)))

	(fn json_skip_trivia
		(:doc "Advance through JSON whitespace and both JSONC comment forms.")
		(params (source (shared-array u8)) (start i32))
		(returns JsonToken)
		(body
			(let-mut cursor start)
			(let length (array:len source))
			(while
				(:doc "Stop at the first significant byte or retain an unterminated comment's span.")
				(i32:lt cursor length)
				(body
					(let byte (array:get source cursor))
					(let next (i32:inc cursor))
					(if
						(:doc "ASCII whitespace advances one byte. Only slash can introduce a comment.")
						(call json_whitespace byte)
						(then (set cursor next))
						(else
							(if
								(:doc "A slash with no comment marker is significant input.")
								(u8:not-eq byte 47u8)
								(then (return (call json_token 0u32 start cursor))))
							(let marker (call json_peek (borrow-shared source) next))
							(if
								(:doc "A second slash begins a line comment.")
								(u8:eq marker 47u8)
								(then
									(set cursor (call line_comment_end (borrow-shared source)
										(i32:inc next))))
								(else
									(if
										(:doc "Any marker other than slash or star leaves the slash unconsumed.")
										(u8:not-eq marker 42u8)
										(then (return (call json_token 0u32 start cursor))))
									(let end (call block_comment_end (borrow-shared source)
										(i32:inc next)))
									(if
										(:doc "An open block comment consumes the remaining view in its diagnostic.")
										(i32:ltz end)
										(then (return (call json_lex_error 6u32 cursor length))))
									(set cursor end)))))))
			(return (call json_token 0u32 start cursor))))

	(fn json_scan_string
		(:doc "Scan a JSON string and validate its decoded Unicode scalar values.")
		(params (source (shared-array u8)) (start i32))
		(returns JsonToken)
		(body
			(let span (call scan_double_quoted (borrow-shared source) start (bool false)))
			(let end (struct:get span end))
			(if
				(:doc "Every quoted spelling error maps to a malformed JSON string.")
				(u32:gtz (struct:get span error))
				(then (return (call json_lex_error 3u32 start end))))
			(let validated (call validate_double_quoted_scalars (borrow-shared source) start end))
			(if
				(:doc "Use the shared validator's exact escape span for an unpaired surrogate.")
				(u32:gtz (struct:get validated error))
				(then (return (call json_lex_error 3u32
					(struct:get validated start) (struct:get validated end)))))
			(return (call json_token 3u32 start end))))

	(fn is_json_digit
		(:doc "Recognize a base-ten digit in the original view.")
		(params (byte u8))
		(returns bool)
		(body (return (bool:and (u8:not-lt byte 48u8) (u8:lt byte 58u8)))))

	(fn digit_end
		(:doc "Advance past a run of decimal digits.")
		(params (source (shared-array u8)) (start i32))
		(returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "The virtual byte returned at EOF cannot extend a number.")
				(call is_json_digit (call json_peek (borrow-shared source) cursor))
				(body (set cursor (i32:inc cursor))))
			(return cursor)))

	(fn json_scan_number
		(:doc "Recognize the JSON number grammar and keep the unconverted lexeme.")
		(params (source (shared-array u8)) (start i32))
		(returns JsonToken)
		(body
			(let-mut cursor start)
			(if
				(:doc "The integer part can have a single leading minus.")
				(u8:eq (call json_peek (borrow-shared source) cursor) 45u8)
				(then (set cursor (i32:inc cursor))))
			(let first (call json_peek (borrow-shared source) cursor))
			(if
				(:doc "A sign alone has no integer part.")
				(bool:not (call is_json_digit first))
				(then (return (call json_error_at (borrow-shared source) 4u32 cursor))))
			(if
				(:doc "Zero is the entire integer part when it starts with zero.")
				(u8:eq first 48u8)
				(then
					(set cursor (i32:inc cursor))
					(if
						(:doc "A second consecutive digit would be a forbidden leading zero.")
						(call is_json_digit (call json_peek (borrow-shared source) cursor))
						(then (return (call json_error_at (borrow-shared source) 4u32 cursor)))))
				(else (set cursor (call digit_end (borrow-shared source) cursor))))
			(if
				(:doc "A decimal point requires at least one fraction digit.")
				(u8:eq (call json_peek (borrow-shared source) cursor) 46u8)
				(then
					(let first_digit (i32:inc cursor))
					(set cursor (call digit_end (borrow-shared source) first_digit))
					(if
						(:doc "Point to the position that should hold a fraction digit.")
						(i32:eq cursor first_digit)
						(then (return (call json_error_at (borrow-shared source) 4u32 cursor))))))
			(let marker (call json_peek (borrow-shared source) cursor))
			(if
				(:doc "An exponent starts with e or E and may include a sign.")
				(bool:or (u8:eq marker 101u8) (u8:eq marker 69u8))
				(then
					(set cursor (i32:inc cursor))
					(let sign (call json_peek (borrow-shared source) cursor))
					(if
						(:doc "Both positive and negative exponent signs are allowed.")
						(bool:or (u8:eq sign 43u8) (u8:eq sign 45u8))
						(then (set cursor (i32:inc cursor))))
					(let exponent_start cursor)
					(set cursor (call digit_end (borrow-shared source) cursor))
					(if
						(:doc "The exponent needs at least one digit after its marker or sign.")
						(i32:eq cursor exponent_start)
						(then (return (call json_error_at (borrow-shared source) 4u32 cursor))))))
			(return (call json_token 4u32 start cursor))))

	(fn json_literal
		(:doc "Check the selected keyword and report its first missing or invalid suffix byte.")
		(params (source (shared-array u8)) (start i32) (kind u32) (keyword (shared-array u8)))
		(returns JsonToken)
		(body
			(let width (array:len keyword))
			(let-mut index 1i32)
			(while
				(:doc "The dispatch matched the first byte. Compare the remaining bytes in source order.")
				(i32:lt index width)
				(body
					(let cursor (i32:add start index))
					(if
						(:doc "Report a one-byte span for a mismatch and an empty span at EOF.")
						(u8:not-eq (call json_peek (borrow-shared source) cursor)
							(array:get keyword index))
						(then (return (call json_error_at (borrow-shared source) 5u32 cursor))))
					(set index (i32:inc index))))
			(return (call json_token kind start (i32:add start width)))))

	(fn json_scan_value
		(:doc "Read the next value token at a significant input byte.")
		(params (source (shared-array u8)) (start i32))
		(returns JsonToken)
		(body
			(let byte (call json_peek (borrow-shared source) start))
			(if
				(:doc "An opening brace starts an object whose extent the reader completes.")
				(u8:eq byte 123u8)
				(then (return (call json_token 1u32 start (i32:inc start)))))
			(if
				(:doc "An opening bracket starts an array whose extent the reader completes.")
				(u8:eq byte 91u8)
				(then (return (call json_token 2u32 start (i32:inc start)))))
			(if
				(:doc "Strings must start with the JSON double-quote delimiter.")
				(u8:eq byte 34u8)
				(then (return (call json_scan_string (borrow-shared source) start))))
			(if
				(:doc "A digit or minus belongs to the number scanner.")
				(bool:or (call is_json_digit byte) (u8:eq byte 45u8))
				(then (return (call json_scan_number (borrow-shared source) start))))
			(if
				(:doc "The t prefix selects true.")
				(u8:eq byte (array:get true_keyword 0i32))
				(then (return (call json_literal (borrow-shared source) start 5u32
					(borrow-shared true_keyword)))))
			(if
				(:doc "The f prefix selects false.")
				(u8:eq byte (array:get false_keyword 0i32))
				(then (return (call json_literal (borrow-shared source) start 6u32
					(borrow-shared false_keyword)))))
			(if
				(:doc "The n prefix selects null.")
				(u8:eq byte (array:get null_keyword 0i32))
				(then (return (call json_literal (borrow-shared source) start 7u32
					(borrow-shared null_keyword)))))
			(return (call json_error_at (borrow-shared source) 2u32 start)))))
