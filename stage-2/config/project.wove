(module project_config
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read and resolve project configuration with the archive's profile layering.

	Callers own the source, JSON nodes, and one setting row per parsed node.
	Only a successful result makes the output usable. A setting lookup
	returns the original value row, preserving the source span and lists
	or strings. Its corresponding setting row contains any typed scalar.
	Rows without a schema key have rule -1. Resolve canonical key IDs
	through project_rule in the schema module.
	Booleans use zero and one. LTO uses off, thin, full (0 to 2), C
	standards use 11, 17, 23, indent uses tabs and spaces (0, 1), and
	line endings use lf and crlf (0, 1). Import order packs its four
	category IDs as base-four digits in the given order.

	Reader errors retain their codes and byte spans. Configuration codes are
	13 expected object, 14 unknown key, 15 duplicate key, 16 invalid value,
	17 invalid profile name, 18 duplicate profile name, 19 unknown selected
	profile, and 20 insufficient setting rows.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse_with_options json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./compiler.wove" (only (type ConfigResult) config_result))
	(use wove-file "./defaults.wove" (only project_default_scalar))
	(use wove-file "./schema.wove"
		(only (type ProjectRule) project_rule_count project_key_bytes project_key_width write_project_schema project_rule
			project_compiler_rule))
	(use wove-file "./values.wove" (only read_project_value))

	(struct ProjectRead (fields (error u32) (start i32) (end i32) (default_profile i32) (selected_profile i32)))
	(struct ProjectSetting (fields (rule i32) (scalar u32)))
	(struct ProjectOptions
		(fields (parallel bool) (parallel_jobs u32) (line_width u32)
			(time bool) (human bool) (max_errors u32) (color bool)))

	(fn project_failure
		(:doc "Report an error with its original byte span and no usable profile rows.")
		(params (error u32) (start i32) (end i32))
		(returns ProjectRead)
		(body (return (struct.new ProjectRead (error (local error)) (start (local start)) (end (local end))
			(default_profile -1i32) (selected_profile -1i32)))))

	(fn project_member
		(:doc "Find a member of an already validated object. An absent object returns -1.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (owner i32) (rule i32))
		(returns i32)
		(body
			(if
				(:doc "Missing profile sections have no values.")
				(i32.lt (local owner) 0i32)
				(then (return -1i32)))
			(let object (array.load (local nodes) (local owner)))
			(let-mut child (struct.get (local object) first_child))
			(while
				(:doc "One field per schema rule can appear in a validated object.")
				(bool.not (i32.lt (local child) 0i32))
				(body
					(let member (array.load (local settings) (local child)))
					(if
						(:doc "The stored rule identifies the decoded key.")
						(i32.eq (struct.get (local member) rule) (local rule))
						(then (return (local child))))
					(let value (array.load (local nodes) (local child)))
					(set (local child) (struct.get (local value) next_sibling))))
			(return -1i32)))

	(fn validate_project_object
		(:doc "Check one object against its scope. Nested validation follows only the schema's fixed levels.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (settings (mut-array ProjectSetting))
			(names (shared-array u8)) (rules (shared-array ProjectRule)) (owner i32) (scope u32))
		(returns ConfigResult)
		(body
			(let object (array.load (local nodes) (local owner)))
			(if
				(:doc "Root and profile entries are required to be objects.")
				(bool.not (u32.eq (struct.get (local object) kind) 1u32))
				(then (return (call config_result 13u32 (struct.get (local object) start) (struct.get (local object) end)))))
			(let-mut key (array.alloc u8 (call project_key_width)))
			(let first (struct.get (local object) first_child))
			(let-mut child (local first))
			(while
				(:doc "Validate each member before putting its rule and scalar in the side table.")
				(bool.not (i32.lt (local child) 0i32))
				(body
					(let value (array.load (local nodes) (local child)))
					(let start (struct.get (local value) key_start))
					(let end (struct.get (local value) key_end))
					(let decoded (call json_decode_string (borrow-shared (local source)) (local start) (local end) (borrow-mut (local key))))
					(if
						(:doc "A decoded spelling longer than any schema key is unknown.")
						(u32.lt 0u32 (struct.get (local decoded) error))
						(then (return (call config_result 14u32 (local start) (local end)))))
					(let id (call project_rule (borrow-shared (local rules)) (borrow-shared (local names))
						(local scope) (borrow-shared (local key)) (struct.get (local decoded) written)))
					(if
						(:doc "Every project key must be declared in its containing scope.")
						(i32.lt (local id) 0i32)
						(then (return (call config_result 14u32 (local start) (local end)))))
					(let-mut previous (local first))
					(while
						(:doc "Only preceding siblings have validated rules to compare.")
						(i32.lt (local previous) (local child))
						(body
							(let setting (array.load (local settings) (local previous)))
							(if
								(:doc "Decoded duplicate keys share a rule ID.")
								(i32.eq (struct.get (local setting) rule) (local id))
								(then (return (call config_result 15u32 (local start) (local end)))))
							(let sibling (array.load (local nodes) (local previous)))
							(set (local previous) (struct.get (local sibling) next_sibling))))
					(let rule (array.load (local rules) (local id)))
					(let kind (struct.get (local rule) kind))
					(let checked (call read_project_value (borrow-shared (local source)) (borrow-shared (local nodes))
						(local child) (local kind)))
					(let invalid (struct.get (local checked) invalid))
					(if
						(:doc "A list element or a whole field can be the precise origin of a type error.")
						(bool.not (i32.lt (local invalid) 0i32))
						(then
							(let bad (array.load (local nodes) (local invalid)))
							(return (call config_result 16u32 (struct.get (local bad) start) (struct.get (local bad) end)))))
					(array.store (local settings) (local child)
						(struct.new ProjectSetting (rule (local id)) (scalar (struct.get (local checked) scalar))))
					(if
						(:doc "Validate a child object in the scope declared by its field.")
						(u32.eq (local kind) 15u32)
						(then
							(let section (call validate_project_object (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-mut (local settings)) (borrow-shared (local names)) (borrow-shared (local rules))
								(local child) (struct.get (local rule) child)))
							(if
								(:doc "Preserve the nested field's original diagnostic.")
								(u32.lt 0u32 (struct.get (local section) error))
								(then (return (local section))))))
					(set (local child) (struct.get (local value) next_sibling))))
			(return (call config_result 0u32 -1i32 -1i32))))

	(fn valid_project_name
		(:doc "A decoded profile name must be nonempty and fit on one diagnostic line.")
		(params (text (shared-array u8)) (width i32))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Check every decoded name byte for NUL or a line break.")
				(i32.lt (local index) (local width))
				(body
					(let byte (array.load (local text) (local index)))
					(if
						(:doc "The name can be passed as an argument and displayed as one line.")
						(bool.or (u8.eq (local byte) 0u8) (bool.or (u8.eq (local byte) 10u8) (u8.eq (local byte) 13u8)))
						(then (return (bool false))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (i32.lt 0i32 (local width)))))

	(fn project_name_width
		(:doc "Decode a previously validated name; the owning profile stands in for an omitted name.")
		(params (source (shared-array u8)) (value JsonNode) (text (mut-array u8)))
		(returns i32)
		(body
			(if
				(:doc "A profile object without a name represents the default profile.")
				(u32.eq (struct.get (local value) kind) 1u32)
				(then
					(array.store (local text) 0i32 100u8)
					(array.store (local text) 1i32 101u8)
					(array.store (local text) 2i32 102u8)
					(array.store (local text) 3i32 97u8)
					(array.store (local text) 4i32 117u8)
					(array.store (local text) 5i32 108u8)
					(array.store (local text) 6i32 116u8)
					(return 7i32)))
			(let decoded (call json_decode_string (borrow-shared (local source)) (struct.get (local value) start)
				(struct.get (local value) end) (borrow-mut (local text))))
			(return (struct.get (local decoded) written))))

	(fn project_name_node
		(:doc "Obtain a name value, preserving where an omitted name was implied.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (profile i32))
		(returns JsonNode)
		(body
			(let name (call project_member (borrow-shared (local nodes)) (borrow-shared (local settings)) (local profile) 1i32))
			(if
				(:doc "Use the name's span when an explicit name was supplied.")
				(bool.not (i32.lt (local name) 0i32))
				(then (return (array.load (local nodes) (local name)))))
			(return (array.load (local nodes) (local profile)))))

	(fn read_profiles
		(:doc "Validate every profile, resolving the requested name and the default layer by their decoded bytes.")
		(params (source (shared-array u8)) (requested (shared-array u8)) (nodes (shared-array JsonNode))
			(settings (mut-array ProjectSetting)) (names (shared-array u8)) (rules (shared-array ProjectRule)) (profiles i32))
		(returns ProjectRead)
		(body
			(let width (array.len (local source)))
			(let-mut name (array.alloc u8 (local width)))
			(let-mut previous_name (array.alloc u8 (local width)))
			(let root (array.load (local nodes) 0i32))
			(let-mut first -1i32)
			(let-mut list_start (struct.get (local root) start))
			(let-mut list_end (struct.get (local root) end))
			(if
				(:doc "A missing profiles member leaves only the built-in defaults.")
				(bool.not (i32.lt (local profiles) 0i32))
				(then
					(let list (array.load (local nodes) (local profiles)))
					(set (local first) (struct.get (local list) first_child))
					(set (local list_start) (struct.get (local list) start))
					(set (local list_end) (struct.get (local list) end))))
			(let default_key (array.load (local rules) 9i32))
			(let default_start (struct.get (local default_key) start))
			(let default_end (struct.get (local default_key) end))
			(let requested_width (array.len (local requested)))
			(let use_default (bool.or (i32.eq (local requested_width) 0i32)
				(call same_bytes (borrow-shared (local names)) (local default_start) (local default_end)
					(borrow-shared (local requested)) 0i32 (local requested_width))))
			(let-mut defaults -1i32)
			(let-mut selected -1i32)
			(let-mut profile (local first))
			(while
				(:doc "Validate each profile even if its settings are outside the resolved layers.")
				(bool.not (i32.lt (local profile) 0i32))
				(body
					(let checked (call validate_project_object (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-mut (local settings)) (borrow-shared (local names)) (borrow-shared (local rules)) (local profile) 1u32))
					(if
						(:doc "Forward the original profile field error.")
						(u32.lt 0u32 (struct.get (local checked) error))
						(then (return (call project_failure (struct.get (local checked) error)
							(struct.get (local checked) start) (struct.get (local checked) end)))))
					(let value (call project_name_node (borrow-shared (local nodes)) (borrow-shared (local settings)) (local profile)))
					(let length (call project_name_width (borrow-shared (local source)) (local value) (borrow-mut (local name))))
					(if
						(:doc "Report explicit empty names or decoded control characters at the name value.")
						(bool.not (call valid_project_name (borrow-shared (local name)) (local length)))
						(then (return (call project_failure 17u32 (struct.get (local value) start) (struct.get (local value) end)))))
					(let-mut previous (local first))
					(while
						(:doc "Reject repeated names across all profiles, including escape-equivalent names.")
						(i32.lt (local previous) (local profile))
						(body
							(let prior (call project_name_node (borrow-shared (local nodes)) (borrow-shared (local settings)) (local previous)))
							(let prior_width (call project_name_width (borrow-shared (local source)) (local prior) (borrow-mut (local previous_name))))
							(if
								(:doc "The latest spelling locates a duplicate diagnostic.")
								(call same_bytes (borrow-shared (local name)) 0i32 (local length)
									(borrow-shared (local previous_name)) 0i32 (local prior_width))
								(then (return (call project_failure 18u32 (struct.get (local value) start) (struct.get (local value) end)))))
							(let object (array.load (local nodes) (local previous)))
							(set (local previous) (struct.get (local object) next_sibling))))
					(if
						(:doc "The canonical default profile supplies the first configuration layer.")
						(call same_bytes (borrow-shared (local names)) (local default_start) (local default_end)
							(borrow-shared (local name)) 0i32 (local length))
						(then (set (local defaults) (local profile))))
					(if
						(:doc "A named selection supplies the overriding configuration layer.")
						(bool.and (bool.not (local use_default))
							(call same_bytes (borrow-shared (local requested)) 0i32 (local requested_width)
								(borrow-shared (local name)) 0i32 (local length)))
						(then (set (local selected) (local profile))))
					(let object (array.load (local nodes) (local profile)))
					(set (local profile) (struct.get (local object) next_sibling))))
			(if
				(:doc "The profiles array is where a requested profile name can be added or corrected.")
				(bool.and (bool.not (local use_default)) (i32.lt (local selected) 0i32))
				(then (return (call project_failure 19u32 (local list_start) (local list_end)))))
			(return (struct.new ProjectRead (error 0u32) (start -1i32) (end -1i32)
				(default_profile (local defaults)) (selected_profile (local selected))))))

	(fn read_project_config
		(:doc "Parse archive-style JSONC and index the validated project profile settings. An empty request selects default.")
		(params (source (shared-array u8)) (requested (shared-array u8))
			(nodes (mut-array JsonNode)) (settings (mut-array ProjectSetting)))
		(returns ProjectRead)
		(body
			(let parsed (call json_parse_with_options (borrow-shared (local source)) (borrow-mut (local nodes)) (bool true)))
			(if
				(:doc "Syntax failures preserve the JSONC reader's original code and byte span.")
				(u32.lt 0u32 (struct.get (local parsed) error))
				(then (return (call project_failure (struct.get (local parsed) error)
					(struct.get (local parsed) start) (struct.get (local parsed) end)))))
			(let rows (struct.get (local parsed) rows))
			(if
				(:doc "Use a side table large enough to index all of the parsed nodes.")
				(i32.lt (array.len (local settings)) (local rows))
				(then (return (call project_failure 20u32 (struct.get (local parsed) start) (struct.get (local parsed) end)))))
			(let-mut row 0i32)
			(while
				(:doc "Clear stale settings and distinguish container and list items that have no declared key.")
				(i32.lt (local row) (local rows))
				(body
					(array.store (local settings) (local row) (struct.new ProjectSetting (rule -1i32) (scalar 0u32)))
					(set (local row) (i32.add (local row) 1i32))))
			(let-mut names (array.alloc u8 (call project_key_bytes)))
			(let-mut rules (array.alloc ProjectRule (call project_rule_count)))
			(call write_project_schema (borrow-mut (local names)) (borrow-mut (local rules)))
			(let root (call validate_project_object (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-mut (local settings)) (borrow-shared (local names)) (borrow-shared (local rules)) 0i32 0u32))
			(if
				(:doc "The root must be a project settings object before selecting a profile.")
				(u32.lt 0u32 (struct.get (local root) error))
				(then (return (call project_failure (struct.get (local root) error)
					(struct.get (local root) start) (struct.get (local root) end)))))
			(let profiles (call project_member (borrow-shared (local nodes)) (borrow-shared (local settings)) 0i32 0i32))
			(return (call read_profiles (borrow-shared (local source)) (borrow-shared (local requested))
				(borrow-shared (local nodes)) (borrow-mut (local settings)) (borrow-shared (local names))
				(borrow-shared (local rules)) (local profiles)))))

	(fn profile_field
		(:doc "Read a rule at a path within one profile. Use -1 for unused path segments.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(profile i32) (section i32) (subsection i32) (field i32))
		(returns i32)
		(body
			(let-mut owner (local profile))
			(if
				(:doc "Options may belong to a top-level profile field or a section.")
				(bool.not (i32.lt (local section) 0i32))
				(then (set (local owner) (call project_member (borrow-shared (local nodes))
					(borrow-shared (local settings)) (local owner) (local section)))))
			(if
				(:doc "Build modes and the warning policy add one more level.")
				(bool.not (i32.lt (local subsection) 0i32))
				(then (set (local owner) (call project_member (borrow-shared (local nodes))
					(borrow-shared (local settings)) (local owner) (local subsection)))))
			(return (call project_member (borrow-shared (local nodes)) (borrow-shared (local settings)) (local owner) (local field)))))

	(fn project_setting
		(:doc "Resolve a field from the selected profile, then default. A missing field returns -1.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (result ProjectRead)
			(section i32) (subsection i32) (field i32))
		(returns i32)
		(body
			(let selected (call profile_field (borrow-shared (local nodes)) (borrow-shared (local settings))
				(struct.get (local result) selected_profile) (local section) (local subsection) (local field)))
			(if
				(:doc "Any explicit value, including zero, false, null and empty lists, overrides the default layer.")
				(bool.not (i32.lt (local selected) 0i32))
				(then (return (local selected))))
			(return (call profile_field (borrow-shared (local nodes)) (borrow-shared (local settings))
				(struct.get (local result) default_profile) (local section) (local subsection) (local field)))))

	(fn resolved_scalar
		(:doc "Use the built-in scalar only when neither resolved profile provides the field.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(result ProjectRead) (section i32) (field i32))
		(returns u32)
		(body
			(let row (call project_setting (borrow-shared (local nodes)) (borrow-shared (local settings))
				(local result) (local section) -1i32 (local field)))
			(if
				(:doc "Missing values have no row in either configuration layer.")
				(i32.lt (local row) 0i32)
				(then (return (call project_default_scalar (local field) 0u32))))
			(let setting (array.load (local settings) (local row)))
			(return (struct.get (local setting) scalar))))

	(fn project_options
		(:doc "Read the shared typed options with built-in defaults and explicit automatic sizing.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (result ProjectRead))
		(returns ProjectOptions)
		(body
			(return (struct.new ProjectOptions
				(parallel (u32.eq 1u32 (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) -1i32 6i32)))
				(parallel_jobs (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) -1i32 7i32))
				(line_width (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) 5i32 25i32))
				(time (u32.eq 1u32 (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) -1i32 8i32)))
				(human (u32.eq 1u32 (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) -1i32 (call project_compiler_rule 0i32))))
				(max_errors (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) -1i32 (call project_compiler_rule 1i32)))
				(color (u32.eq 1u32 (call resolved_scalar (borrow-shared (local nodes)) (borrow-shared (local settings))
					(local result) -1i32 (call project_compiler_rule 2i32)))))))))
