(module project_config
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read and resolve project configuration with the archive's profile layering.

	Callers own the source, JSON nodes, and one setting row per parsed node.
	Only a successful result makes the output usable. A setting lookup
	returns the original value row, preserving the source span and lists
	or strings. Its corresponding setting row contains any typed scalar.
	Rows without a schema key have rule -1. Resolve canonical key IDs
	through project_rule in the schema module.
	Booleans use zero and one. LTO uses off, thin, full (0 to 2), C
	standards use 11, 17, 23, indent uses tabs and spaces (0, 1), and
	line endings use lf and crlf (0, 1). Import order packs its four
	category IDs as base-four digits in the given order.

	Reader errors retain their codes and byte spans. Configuration codes are
	13 expected object, 14 unknown key, 15 duplicate key, 16 invalid value,
	17 invalid profile name, 18 duplicate profile name, 19 unknown selected
	profile, and 20 insufficient setting rows.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse_with_options json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./compiler.wove" (only (type ConfigResult) config_result copy_config_name))
	(use wove-file "./defaults.wove" (only project_default_scalar))
	(use wove-file "./schema.wove"
		(only (type ProjectRule) project_rule_count project_key_bytes project_key_width write_project_schema project_rule
			project_compiler_rule))
	(use wove-file "./values.wove" (only read_project_value))

	(struct ProjectRead (fields (error u32) (start i32) (end i32) (default_profile i32) (selected_profile i32)))
	(struct ProjectSetting (fields (rule i32) (scalar u32)))
	(struct ProjectOptions
		(fields (parallel bool) (parallel_jobs u32) (line_width u32)
			(time bool) (human bool) (max_errors u32) (color bool)))

	(let default_profile_name "default")

	(fn project_failure
		(:doc "Report an error with its original byte span and no usable profile rows.")
		(params (error u32) (start i32) (end i32))
		(returns ProjectRead)
		(body (return (ProjectRead.new (error error) (start start) (end end)
			(default_profile -1i32) (selected_profile -1i32)))))

	(fn project_member
		(:doc "Find a member of an already validated object. An absent object returns -1.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (owner i32) (rule i32))
		(returns i32)
		(body
			(if
				(:doc "Missing profile sections have no values.")
				owner.ltz
				(then (return -1i32)))
			(let object (nodes.get owner))
			(let-mut child object/first_child)
			(while
				(:doc "One field per schema rule can appear in a validated object.")
				child.not-ltz
				(body
					(let member (settings.get child))
					(if
						(:doc "The stored rule identifies the decoded key.")
						(member/rule.eq rule)
						(then (return child)))
					(let value (nodes.get child))
					(set child value/next_sibling)))
			(return -1i32)))

	(fn validate_project_object
		(:doc "Check one object against its scope. Nested validation follows only the schema's fixed levels.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (settings (mut-array ProjectSetting))
			(names (shared-array u8)) (rules (shared-array ProjectRule)) (owner i32) (scope u32))
		(returns ConfigResult)
		(body
			(let object (nodes.get owner))
			(if
				(:doc "Root and profile entries are required to be objects.")
				(object/kind.not-eq 1u32)
				(then (return (call config_result 13u32 object/start object/end))))
			(let-mut key (array:alloc u8 (call project_key_width)))
			(let first object/first_child)
			(let-mut child first)
			(while
				(:doc "Validate each member before putting its rule and scalar in the side table.")
				child.not-ltz
				(body
					(let value (nodes.get child))
					(let start value/key_start)
					(let end value/key_end)
					(let decoded (call json_decode_string (borrow-shared source) start end (borrow-mut key)))
					(if
						(:doc "A decoded spelling longer than any schema key is unknown.")
						decoded/error.gtz
						(then (return (call config_result 14u32 start end))))
					(let id (call project_rule (borrow-shared rules) (borrow-shared names)
						scope (borrow-shared key) decoded/written))
					(if
						(:doc "Every project key must be declared in its containing scope.")
						id.ltz
						(then (return (call config_result 14u32 start end))))
					(let-mut previous first)
					(while
						(:doc "Only preceding siblings have validated rules to compare.")
						(previous.lt child)
						(body
							(let setting (settings.get previous))
							(if
								(:doc "Decoded duplicate keys share a rule ID.")
								(setting/rule.eq id)
								(then (return (call config_result 15u32 start end))))
							(let sibling (nodes.get previous))
							(set previous sibling/next_sibling)))
					(let rule (rules.get id))
					(let kind rule/kind)
					(let checked (call read_project_value (borrow-shared source) (borrow-shared nodes)
						child kind))
					(let invalid checked/invalid)
					(if
						(:doc "A list element or a whole field can be the precise origin of a type error.")
						invalid.not-ltz
						(then
							(let bad (nodes.get invalid))
							(return (call config_result 16u32 bad/start bad/end))))
					(settings.set child
						(ProjectSetting.new (rule id) (scalar checked/scalar)))
					(if
						(:doc "Validate a child object in the scope declared by its field.")
						(kind.eq 15u32)
						(then
							(let section (call validate_project_object (borrow-shared source) (borrow-shared nodes)
								(borrow-mut settings) (borrow-shared names) (borrow-shared rules)
								child rule/child))
							(if
								(:doc "Preserve the nested field's original diagnostic.")
								section/error.gtz
								(then (return section)))))
					(set child value/next_sibling)))
			(return (call config_result 0u32 -1i32 -1i32))))

	(fn valid_project_name
		(:doc "A decoded profile name must be nonempty and fit on one diagnostic line.")
		(params (text (shared-array u8)) (width i32))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Check every decoded name byte for NUL or a line break.")
				(index.lt width)
				(body
					(let byte (text.get index))
					(if
						(:doc "The name can be passed as an argument and displayed as one line.")
						(byte.eqz.or (bool:or (byte.eq 10u8) (byte.eq 13u8)))
						(then (return (bool false))))
					(set index index.inc)))
			(return width.gtz)))

	(fn project_name_width
		(:doc "Decode a previously validated name; the owning profile stands in for an omitted name.")
		(params (source (shared-array u8)) (value JsonNode) (text (mut-array u8)))
		(returns i32)
		(body
			(if
				(:doc "A profile object without a name represents the default profile.")
				(value/kind.eq 1u32)
				(then
					(call copy_config_name (borrow-shared default_profile_name) (borrow-mut text) 0i32)
					(return default_profile_name.len)))
			(let decoded (call json_decode_string (borrow-shared source) value/start
				value/end (borrow-mut text)))
			(return decoded/written)))

	(fn project_name_node
		(:doc "Obtain a name value, preserving where an omitted name was implied.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (profile i32))
		(returns JsonNode)
		(body
			(let name (call project_member (borrow-shared nodes) (borrow-shared settings) profile 1i32))
			(if
				(:doc "Use the name's span when an explicit name was supplied.")
				name.not-ltz
				(then (return (nodes.get name))))
			(return (nodes.get profile))))

	(fn read_profiles
		(:doc "Validate every profile, resolving the requested name and the default layer by their decoded bytes.")
		(params (source (shared-array u8)) (requested (shared-array u8)) (nodes (shared-array JsonNode))
			(settings (mut-array ProjectSetting)) (names (shared-array u8)) (rules (shared-array ProjectRule)) (profiles i32))
		(returns ProjectRead)
		(body
			(let width source.len)
			(let-mut name (array:alloc u8 width))
			(let-mut previous_name (array:alloc u8 width))
			(let root (nodes.get 0i32))
			(let-mut first -1i32)
			(let-mut list_start root/start)
			(let-mut list_end root/end)
			(if
				(:doc "A missing profiles member leaves only the built-in defaults.")
				profiles.not-ltz
				(then
					(let list (nodes.get profiles))
					(set first list/first_child)
					(set list_start list/start)
					(set list_end list/end)))
			(let default_width default_profile_name.len)
			(let requested_width requested.len)
			(let use_default (requested_width.eqz.or
				(call same_bytes (borrow-shared default_profile_name) 0i32 default_width
					(borrow-shared requested) 0i32 requested_width)))
			(let-mut defaults -1i32)
			(let-mut selected -1i32)
			(let-mut profile first)
			(while
				(:doc "Validate each profile even if its settings are outside the resolved layers.")
				profile.not-ltz
				(body
					(let checked (call validate_project_object (borrow-shared source) (borrow-shared nodes)
						(borrow-mut settings) (borrow-shared names) (borrow-shared rules) profile 1u32))
					(if
						(:doc "Forward the original profile field error.")
						checked/error.gtz
						(then (return (call project_failure checked/error
							checked/start checked/end))))
					(let value (call project_name_node (borrow-shared nodes) (borrow-shared settings) profile))
					(let length (call project_name_width (borrow-shared source) value (borrow-mut name)))
					(if
						(:doc "Report explicit empty names or decoded control characters at the name value.")
						(bool:not (call valid_project_name (borrow-shared name) length))
						(then (return (call project_failure 17u32 value/start value/end))))
					(let-mut previous first)
					(while
						(:doc "Reject repeated names across all profiles, including escape-equivalent names.")
						(previous.lt profile)
						(body
							(let prior (call project_name_node (borrow-shared nodes) (borrow-shared settings) previous))
							(let prior_width (call project_name_width (borrow-shared source) prior (borrow-mut previous_name)))
							(if
								(:doc "The latest spelling locates a duplicate diagnostic.")
								(call same_bytes (borrow-shared name) 0i32 length
									(borrow-shared previous_name) 0i32 prior_width)
								(then (return (call project_failure 18u32 value/start value/end))))
							(let object (nodes.get previous))
							(set previous object/next_sibling)))
					(if
						(:doc "The canonical default profile supplies the first configuration layer.")
						(call same_bytes (borrow-shared default_profile_name) 0i32 default_width
							(borrow-shared name) 0i32 length)
						(then (set defaults profile)))
					(if
						(:doc "A named selection supplies the overriding configuration layer.")
						(use_default.not.and
							(call same_bytes (borrow-shared requested) 0i32 requested_width
								(borrow-shared name) 0i32 length))
						(then (set selected profile)))
					(let object (nodes.get profile))
					(set profile object/next_sibling)))
			(if
				(:doc "The profiles array is where a requested profile name can be added or corrected.")
				(use_default.not.and selected.ltz)
				(then (return (call project_failure 19u32 list_start list_end))))
			(return (ProjectRead.new (error 0u32) (start -1i32) (end -1i32)
				(default_profile defaults) (selected_profile selected)))))

	(fn prepare_project_settings
		(:doc "Parse JSONC and initialize the settings rows before applying the project schema.")
		(params (source (shared-array u8)) (nodes (mut-array JsonNode)) (settings (mut-array ProjectSetting)))
		(returns ConfigResult)
		(body
			(let parsed (call json_parse_with_options (borrow-shared source) (borrow-mut nodes) (bool true)))
			(if
				(:doc "Syntax failures preserve the JSONC reader's original code and byte span.")
				parsed/error.gtz
				(then (return (call config_result parsed/error
					parsed/start parsed/end))))
			(let rows parsed/rows)
			(if
				(:doc "Use a side table large enough to index all of the parsed nodes.")
				(settings.len.lt rows)
				(then (return (call config_result 20u32 parsed/start parsed/end))))
			(let-mut row 0i32)
			(while
				(:doc "Clear stale settings and distinguish container and list items that have no declared key.")
				(row.lt rows)
				(body
					(settings.set row (ProjectSetting.new (rule -1i32) (scalar 0u32)))
					(set row row.inc)))
			(return (call config_result 0u32 -1i32 -1i32))))

	(fn read_project_settings
		(:doc "Validate the parsed tree against the initialized schema, then resolve the requested profile.")
		(params (source (shared-array u8)) (requested (shared-array u8))
			(nodes (shared-array JsonNode)) (settings (mut-array ProjectSetting))
			(names (shared-array u8)) (rules (shared-array ProjectRule)))
		(returns ProjectRead)
		(body
			(let root (call validate_project_object (borrow-shared source) (borrow-shared nodes)
				(borrow-mut settings) (borrow-shared names) (borrow-shared rules) 0i32 0u32))
			(if
				(:doc "The root must be a project settings object before selecting a profile.")
				root/error.gtz
				(then (return (call project_failure root/error
					root/start root/end))))
			(let profiles (call project_member (borrow-shared nodes) (borrow-shared settings) 0i32 0i32))
			(return (call read_profiles (borrow-shared source) (borrow-shared requested)
				(borrow-shared nodes) (borrow-mut settings) (borrow-shared names)
				(borrow-shared rules) profiles))))

	(fn read_project_config_with_schema
		(:doc "Parse and validate a project with the schema its caller already initialized.")
		(params (source (shared-array u8)) (requested (shared-array u8))
			(nodes (mut-array JsonNode)) (settings (mut-array ProjectSetting))
			(names (shared-array u8)) (rules (shared-array ProjectRule)))
		(returns ProjectRead)
		(body
			(let prepared (call prepare_project_settings (borrow-shared source)
				(borrow-mut nodes) (borrow-mut settings)))
			(if
				(:doc "Syntax and setting capacity errors precede schema validation.")
				prepared/error.gtz
				(then (return (call project_failure prepared/error
					prepared/start prepared/end))))
			(return (call read_project_settings (borrow-shared source) (borrow-shared requested)
				(borrow-shared nodes) (borrow-mut settings) (borrow-shared names) (borrow-shared rules)))))

	(fn read_project_config
		(:doc "Read a project for a caller without a schema. An empty request selects default.")
		(params (source (shared-array u8)) (requested (shared-array u8))
			(nodes (mut-array JsonNode)) (settings (mut-array ProjectSetting)))
		(returns ProjectRead)
		(body
			(let prepared (call prepare_project_settings (borrow-shared source)
				(borrow-mut nodes) (borrow-mut settings)))
			(if
				(:doc "Only a complete parse and settings table need a standalone schema.")
				prepared/error.gtz
				(then (return (call project_failure prepared/error
					prepared/start prepared/end))))
			(let-mut names (array:alloc u8 (call project_key_bytes)))
			(let-mut rules (array:alloc ProjectRule (call project_rule_count)))
			(call write_project_schema (borrow-mut names) (borrow-mut rules))
			(return (call read_project_settings (borrow-shared source) (borrow-shared requested)
				(borrow-shared nodes) (borrow-mut settings) (borrow-shared names) (borrow-shared rules)))))

	(fn profile_field
		(:doc "Read a rule at a path within one profile. Use -1 for unused path segments.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(profile i32) (section i32) (subsection i32) (field i32))
		(returns i32)
		(body
			(let-mut owner profile)
			(if
				(:doc "Options may belong to a top-level profile field or a section.")
				section.not-ltz
				(then (set owner (call project_member (borrow-shared nodes)
					(borrow-shared settings) owner section))))
			(if
				(:doc "Build modes and the warning policy add one more level.")
				subsection.not-ltz
				(then (set owner (call project_member (borrow-shared nodes)
					(borrow-shared settings) owner subsection))))
			(return (call project_member (borrow-shared nodes) (borrow-shared settings) owner field))))

	(fn project_setting
		(:doc "Resolve a field from the selected profile, then default. A missing field returns -1.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (result ProjectRead)
			(section i32) (subsection i32) (field i32))
		(returns i32)
		(body
			(let selected (call profile_field (borrow-shared nodes) (borrow-shared settings)
				result/selected_profile section subsection field))
			(if
				(:doc "Any explicit value, including zero, false, null and empty lists, overrides the default layer.")
				selected.not-ltz
				(then (return selected)))
			(return (call profile_field (borrow-shared nodes) (borrow-shared settings)
				result/default_profile section subsection field))))

	(fn resolved_scalar
		(:doc "Use the built-in scalar only when neither resolved profile provides the field.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(result ProjectRead) (section i32) (field i32))
		(returns u32)
		(body
			(let row (call project_setting (borrow-shared nodes) (borrow-shared settings)
				result section -1i32 field))
			(if
				(:doc "Missing values have no row in either configuration layer.")
				row.ltz
				(then (return (call project_default_scalar field 0u32))))
			(let setting (settings.get row))
			(return setting/scalar)))

	(fn project_options
		(:doc "Read the shared typed options with built-in defaults and explicit automatic sizing.")
		(params (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (result ProjectRead))
		(returns ProjectOptions)
		(body
			(return (ProjectOptions.new
				(parallel (u32:eq 1u32 (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result -1i32 6i32)))
				(parallel_jobs (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result -1i32 7i32))
				(line_width (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result 5i32 25i32))
				(time (u32:eq 1u32 (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result -1i32 8i32)))
				(human (u32:eq 1u32 (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result -1i32 (call project_compiler_rule 0i32))))
				(max_errors (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result -1i32 (call project_compiler_rule 1i32)))
				(color (u32:eq 1u32 (call resolved_scalar (borrow-shared nodes) (borrow-shared settings)
					result -1i32 (call project_compiler_rule 2i32)))))))))
