(module compiler_config
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the compiler's main JSONC options object.

	The schema accepts human and color as booleans, and max-errors as a u32
	decimal integer. Defaults are false, true, and 20, respectively.
	All keys are optional. Escape-equivalent keys identify the same field.

	Reader errors retain their JSONC byte spans. Schema codes 13 through 16
	mean expected object, unknown key, duplicate key, and invalid value.
	Unknown and duplicate keys point to the original quoted key. An invalid
	value points to its whole original JSONC value.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct CompilerOptions (fields (human bool) (max_errors u32) (color bool)))
	(struct CompilerOptionSpec (fields (start i32) (end i32) (value_kind u32) (cli_form u32)))
	(struct ConfigResult (fields (error u32) (start i32) (end i32)))

	(let key_human "human")
	(let key_max_errors "max-errors")
	(let key_color "color")

	(fn compiler_defaults
		(:doc "Return the default compiler options for an omitted or empty configuration object.")
		(params)
		(returns CompilerOptions)
		(body (return (struct.new CompilerOptions (human (bool false)) (max_errors 20u32) (color (bool true))))))

	(fn compiler_option_count
		(:doc "Return the number of typed compiler option descriptors.")
		(params)
		(returns i32)
		(body (return 3i32)))

	(fn compiler_names_width
		(:doc "Return the capacity for the packed option name bytes.")
		(params)
		(returns i32)
		(body (return 20i32)))

	(fn copy_config_name
		(:doc "Copy a schema key or profile name into its assigned destination span.")
		(params (source (shared-array u8)) (names (mut-array u8)) (offset i32))
		(returns void)
		(body
			(let-mut at 0i32)
			(while
				(:doc "Preserve the literal bytes in their original order.")
				(i32.lt (local at) (array.len (local source)))
				(body
					(array.store (local names) (i32.add (local offset) (local at)) (array.load (local source) (local at)))
					(set (local at) (i32.add (local at) 1i32))))))

	(fn write_compiler_names
		(:doc "Write the shared schema names human, max-errors, and color into their packed spans.")
		(params (names (mut-array u8)))
		(returns void)
		(body
			(call copy_config_name (borrow-shared (local key_human)) (borrow-mut (local names))
				(struct.get (call compiler_option 0i32) start))
			(call copy_config_name (borrow-shared (local key_max_errors)) (borrow-mut (local names))
				(struct.get (call compiler_option 1i32) start))
			(call copy_config_name (borrow-shared (local key_color)) (borrow-mut (local names))
				(struct.get (call compiler_option 2i32) start))))

	(fn compiler_option
		(:doc "Return the name span and types for schema rows 0 through 2. A zero CLI form marks a config-only key.")
		(params (row i32))
		(returns CompilerOptionSpec)
		(body
			(if
				(:doc "Human output is a boolean flag and config field.")
				(i32.eqz (local row))
				(then (return (struct.new CompilerOptionSpec
					(start 0i32) (end 5i32) (value_kind 1u32) (cli_form 1u32)))))
			(if
				(:doc "An error limit takes a word operand.")
				(i32.eq (local row) 1i32)
				(then (return (struct.new CompilerOptionSpec
					(start 5i32) (end 15i32) (value_kind 3u32) (cli_form 2u32)))))
			(return (struct.new CompilerOptionSpec
				(start 15i32) (end (call compiler_names_width)) (value_kind 1u32) (cli_form 0u32)))))

	(fn config_key
		(:doc "Identify a decoded config key by its exact bytes.")
		(params (names (shared-array u8)) (decoded (shared-array u8)) (width i32))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Every schema name participates in the config lookup.")
				(i32.lt (local row) (call compiler_option_count))
				(body
					(let name (call compiler_option (local row)))
					(if
						(:doc "Compare the whole decoded key, including case and length.")
						(call same_bytes (borrow-shared (local names)) (struct.get (local name) start) (struct.get (local name) end)
							(borrow-shared (local decoded)) 0i32 (local width))
						(then (return (local row))))
					(set (local row) (i32.add (local row) 1i32))))
			(return -1i32)))

	(fn config_result
		(:doc "Return the error and its original byte span.")
		(params (error u32) (start i32) (end i32))
		(returns ConfigResult)
		(body (return (struct.new ConfigResult (error (local error)) (start (local start)) (end (local end))))))

	(fn bad_value
		(:doc "Report a schema type or range failure at the complete value.")
		(params (value JsonNode))
		(returns ConfigResult)
		(body (return (call config_result 16u32 (struct.get (local value) start) (struct.get (local value) end)))))

	(fn read_compiler_config
		(:doc "Validate supplied JSONC and write one options row on success. Pass the packed schema names and at least one output row.")
		(params (source (shared-array u8)) (nodes (mut-array JsonNode)) (names (shared-array u8))
			(output (mut-array CompilerOptions)))
		(returns ConfigResult)
		(body
			(let parsed (call json_parse (borrow-shared (local source)) (borrow-mut (local nodes))))
			(let parse_code (struct.get (local parsed) error))
			(if
				(:doc "Keep malformed JSONC and reader capacity diagnostics in their original source spans.")
				(u32.gtz (local parse_code))
				(then (return (call config_result (local parse_code) (struct.get (local parsed) start) (struct.get (local parsed) end)))))
			(let root (array.load (local nodes) 0i32))
			(if
				(:doc "The main configuration document must be an object.")
				(u32.not-eq (struct.get (local root) kind) 1u32)
				(then (return (call config_result 13u32 (struct.get (local root) start) (struct.get (local root) end)))))
			(let defaults (call compiler_defaults))
			(let-mut human (struct.get (local defaults) human))
			(let-mut max_errors (struct.get (local defaults) max_errors))
			(let-mut color (struct.get (local defaults) color))
			(let-mut saw_human (bool false))
			(let-mut saw_max (bool false))
			(let-mut saw_color (bool false))
			(let-mut key (array.alloc u8 10i32))
			(let-mut child (struct.get (local root) first_child))
			(while
				(:doc "Each direct member supplies one typed option at most once.")
				(i32.not-ltz (local child))
				(body
					(let value (array.load (local nodes) (local child)))
					(let key_start (struct.get (local value) key_start))
					(let key_end (struct.get (local value) key_end))
					(let decoded (call json_decode_string (borrow-shared (local source)) (local key_start) (local key_end)
						(borrow-mut (local key))))
					(if
						(:doc "A validated key longer than the largest schema name is unknown.")
						(u32.gtz (struct.get (local decoded) error))
						(then (return (call config_result 14u32 (local key_start) (local key_end)))))
					(let row (call config_key (borrow-shared (local names)) (borrow-shared (local key)) (struct.get (local decoded) written)))
					(if
						(:doc "Every recognized key maps to a schema row.")
						(i32.ltz (local row))
						(then (return (call config_result 14u32 (local key_start) (local key_end)))))
					(if
						(:doc "Reject a second occurrence of a field, including an escape-equivalent spelling.")
						(bool.or (bool.and (i32.eqz (local row)) (local saw_human))
							(bool.or (bool.and (i32.eq (local row) 1i32) (local saw_max))
								(bool.and (i32.eq (local row) 2i32) (local saw_color))))
						(then (return (call config_result 15u32 (local key_start) (local key_end)))))
					(let kind (struct.get (local value) kind))
					(let option (call compiler_option (local row)))
					(if
						(:doc "A u32 field requires a nonnegative integer lexeme within its range.")
						(u32.eq (struct.get (local option) value_kind) 3u32)
						(then
							(if
								(:doc "Only the JSON number kind can supply a decimal option.")
								(u32.not-eq (local kind) 4u32)
								(then (return (call bad_value (local value)))))
							(let decimal (call read_decimal_digits (borrow-shared (local source))
								(struct.get (local value) start) (struct.get (local value) end) 429496729u32 5u32))
							(if
								(:doc "Fractions, exponents, negative spellings, and overflow cannot supply a word.")
								(i32.ltz (struct.get (local decimal) digits))
								(then (return (call bad_value (local value)))))
							(set (local max_errors) (struct.get (local decimal) magnitude))
							(set (local saw_max) (bool true)))
						(else
							(let enabled (u32.eq (local kind) 5u32))
							(if
								(:doc "Both boolean options require the JSON true or false literal.")
								(bool.not (bool.or (local enabled) (u32.eq (local kind) 6u32)))
								(then (return (call bad_value (local value)))))
							(if
								(:doc "Apply an explicitly supplied boolean to its own field, including false.")
								(i32.eqz (local row))
								(then (set (local human) (local enabled)) (set (local saw_human) (bool true)))
								(else (set (local color) (local enabled)) (set (local saw_color) (bool true))))))
					(set (local child) (struct.get (local value) next_sibling))))
			(array.store (local output) 0i32 (struct.new CompilerOptions
				(human (local human)) (max_errors (local max_errors)) (color (local color))))
			(return (call config_result 0u32 -1i32 -1i32)))))
