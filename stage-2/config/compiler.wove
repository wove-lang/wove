(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the compiler's main JSONC options object.

	The schema accepts human and color as booleans, and max-errors as a u32
	decimal integer. Defaults are false, true, and 20, respectively.
	All keys are optional. Escape-equivalent keys identify the same field.

	Reader errors retain their JSONC byte spans. Schema codes 13 through 16
	mean expected object, unknown key, duplicate key, and invalid value.
	Unknown and duplicate keys point to the original quoted key. An invalid
	value points to its whole original JSONC value.`)
	compiler_config

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct CompilerOptions (fields (human bool) (max_errors u32) (color bool)))
	(struct CompilerOptionSpec (fields (start i32) (end i32) (value_kind u32) (cli_form u32)))
	(struct ConfigResult (fields (error u32) (start i32) (end i32)))

	(fn
		(:doc "Return the default compiler options for an omitted or empty configuration object.")
		compiler_defaults
		(params)
		(returns CompilerOptions)
		(body (return (record.make CompilerOptions (human (bool false)) (max_errors (u32 20)) (color (bool true))))))

	(fn
		(:doc "Return the number of typed compiler option descriptors.")
		compiler_option_count
		(params)
		(returns i32)
		(body (return (i32 3))))

	(fn
		(:doc "Return the capacity for the packed option name bytes.")
		compiler_names_width
		(params)
		(returns i32)
		(body (return (i32 20))))

	(fn
		(:doc "Write the shared schema names human, max-errors, and color into their packed spans.")
		write_compiler_names
		(params (names (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local names) (i32 0) (u8 104))
			(slice.store (local names) (i32 1) (u8 117))
			(slice.store (local names) (i32 2) (u8 109))
			(slice.store (local names) (i32 3) (u8 97))
			(slice.store (local names) (i32 4) (u8 110))
			(slice.store (local names) (i32 5) (u8 109))
			(slice.store (local names) (i32 6) (u8 97))
			(slice.store (local names) (i32 7) (u8 120))
			(slice.store (local names) (i32 8) (u8 45))
			(slice.store (local names) (i32 9) (u8 101))
			(slice.store (local names) (i32 10) (u8 114))
			(slice.store (local names) (i32 11) (u8 114))
			(slice.store (local names) (i32 12) (u8 111))
			(slice.store (local names) (i32 13) (u8 114))
			(slice.store (local names) (i32 14) (u8 115))
			(slice.store (local names) (i32 15) (u8 99))
			(slice.store (local names) (i32 16) (u8 111))
			(slice.store (local names) (i32 17) (u8 108))
			(slice.store (local names) (i32 18) (u8 111))
			(slice.store (local names) (i32 19) (u8 114))
		))

	(fn
		(:doc "Return the name span and types for schema rows 0 through 2. A zero CLI form marks a config-only key.")
		compiler_option
		(params (row i32))
		(returns CompilerOptionSpec)
		(body
			(if
				(:doc "Human output is a boolean flag and config field.")
				(i32.eq (local row) (i32 0))
				(then (return (record.make CompilerOptionSpec
					(start (i32 0)) (end (i32 5)) (value_kind (u32 1)) (cli_form (u32 1))))))
			(if
				(:doc "An error limit takes a word operand.")
				(i32.eq (local row) (i32 1))
				(then (return (record.make CompilerOptionSpec
					(start (i32 5)) (end (i32 15)) (value_kind (u32 3)) (cli_form (u32 2))))))
			(return (record.make CompilerOptionSpec
				(start (i32 15)) (end (call compiler_names_width)) (value_kind (u32 1)) (cli_form (u32 0))))))

	(fn
		(:doc "Identify a decoded config key by its exact bytes.")
		config_key
		(params (names (shared-slice u8)) (decoded (shared-slice u8)) (width i32))
		(returns i32)
		(body
			(let-mut row (i32 0))
			(while
				(:doc "Every schema name participates in the config lookup.")
				(i32.lt (local row) (call compiler_option_count))
				(body
					(let name (call compiler_option (local row)))
					(if
						(:doc "Compare the whole decoded key, including case and length.")
						(call same_bytes (borrow-shared (local names)) (record.get (local name) start) (record.get (local name) end)
							(borrow-shared (local decoded)) (i32 0) (local width))
						(then (return (local row))))
					(set (local row) (i32.add.wrapping (local row) (i32 1)))))
			(return (i32 -1))))

	(fn
		(:doc "Return the error and its original byte span.")
		config_result
		(params (error u32) (start i32) (end i32))
		(returns ConfigResult)
		(body (return (record.make ConfigResult (error (local error)) (start (local start)) (end (local end))))))

	(fn
		(:doc "Report a schema type or range failure at the complete value.")
		bad_value
		(params (value JsonNode))
		(returns ConfigResult)
		(body (return (call config_result (u32 16) (record.get (local value) start) (record.get (local value) end)))))

	(fn
		(:doc "Validate supplied JSONC and write one options row on success. Pass the packed schema names and at least one output row.")
		read_compiler_config
		(params (source (shared-slice u8)) (nodes (mut-slice JsonNode)) (names (shared-slice u8))
			(output (mut-slice CompilerOptions)))
		(returns ConfigResult)
		(body
			(let parsed (call json_parse (borrow-shared (local source)) (borrow-mut (local nodes))))
			(let parse_code (record.get (local parsed) error))
			(if
				(:doc "Keep malformed JSONC and reader capacity diagnostics in their original source spans.")
				(u32.lt (u32 0) (local parse_code))
				(then (return (call config_result (local parse_code) (record.get (local parsed) start) (record.get (local parsed) end)))))
			(let root (slice.load (local nodes) (i32 0)))
			(if
				(:doc "The main configuration document must be an object.")
				(bool.not (u32.eq (record.get (local root) kind) (u32 1)))
				(then (return (call config_result (u32 13) (record.get (local root) start) (record.get (local root) end)))))
			(let defaults (call compiler_defaults))
			(let-mut human (record.get (local defaults) human))
			(let-mut max_errors (record.get (local defaults) max_errors))
			(let-mut color (record.get (local defaults) color))
			(let-mut saw_human (bool false))
			(let-mut saw_max (bool false))
			(let-mut saw_color (bool false))
			(let-mut key (array.alloc u8 (i32 10)))
			(let-mut child (record.get (local root) first_child))
			(while
				(:doc "Each direct member supplies one typed option at most once.")
				(bool.not (i32.lt (local child) (i32 0)))
				(body
					(let value (slice.load (local nodes) (local child)))
					(let key_start (record.get (local value) key_start))
					(let key_end (record.get (local value) key_end))
					(let decoded (call json_decode_string (borrow-shared (local source)) (local key_start) (local key_end)
						(borrow-mut (local key))))
					(if
						(:doc "A validated key longer than the largest schema name is unknown.")
						(u32.lt (u32 0) (record.get (local decoded) error))
						(then (return (call config_result (u32 14) (local key_start) (local key_end)))))
					(let row (call config_key (borrow-shared (local names)) (borrow-shared (local key)) (record.get (local decoded) written)))
					(if
						(:doc "Every recognized key maps to a schema row.")
						(i32.lt (local row) (i32 0))
						(then (return (call config_result (u32 14) (local key_start) (local key_end)))))
					(if
						(:doc "Reject a second occurrence of a field, including an escape-equivalent spelling.")
						(bool.or (bool.and (i32.eq (local row) (i32 0)) (local saw_human))
							(bool.or (bool.and (i32.eq (local row) (i32 1)) (local saw_max))
								(bool.and (i32.eq (local row) (i32 2)) (local saw_color))))
						(then (return (call config_result (u32 15) (local key_start) (local key_end)))))
					(let kind (record.get (local value) kind))
					(let option (call compiler_option (local row)))
					(if
						(:doc "A u32 field requires a nonnegative integer lexeme within its range.")
						(u32.eq (record.get (local option) value_kind) (u32 3))
						(then
							(if
								(:doc "Only the JSON number kind can supply a decimal option.")
								(bool.not (u32.eq (local kind) (u32 4)))
								(then (return (call bad_value (local value)))))
							(let decimal (call read_decimal_digits (borrow-shared (local source))
								(record.get (local value) start) (record.get (local value) end) (u32 429496729) (u32 5)))
							(if
								(:doc "Fractions, exponents, negative spellings, and overflow cannot supply a word.")
								(i32.lt (record.get (local decimal) digits) (i32 0))
								(then (return (call bad_value (local value)))))
							(set (local max_errors) (record.get (local decimal) magnitude))
							(set (local saw_max) (bool true)))
						(else
							(let enabled (u32.eq (local kind) (u32 5)))
							(if
								(:doc "Both boolean options require the JSON true or false literal.")
								(bool.not (bool.or (local enabled) (u32.eq (local kind) (u32 6))))
								(then (return (call bad_value (local value)))))
							(if
								(:doc "Apply an explicitly supplied boolean to its own field, including false.")
								(i32.eq (local row) (i32 0))
								(then (set (local human) (local enabled)) (set (local saw_human) (bool true)))
								(else (set (local color) (local enabled)) (set (local saw_color) (bool true))))))
					(set (local child) (record.get (local value) next_sibling))))
			(slice.store (local output) (i32 0) (record.make CompilerOptions
				(human (local human)) (max_errors (local max_errors)) (color (local color))))
			(return (call config_result (u32 0) (i32 -1) (i32 -1))))))
