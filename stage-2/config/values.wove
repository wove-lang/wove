(module project_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Validate and interpret leaf values declared in the project configuration schema.")

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct ProjectValue (fields (invalid i32) (scalar u32)))

	(fn project_word
		(:doc "Return the enum member of a decoded spelling, or -1 when it is unsupported.")
		(params (kind u32) (bytes (shared-slice u8)) (width i32))
		(returns i32)
		(body
			(if
				(:doc "Decode the off choice.")
				(bool.and (u32.eq (local kind) 7u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of off.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 111u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 102u8)
						(u8.eq (slice.load (local bytes) 2i32) 102u8)))
						(then (return 0i32)))))
			(if
				(:doc "Decode the thin choice.")
				(bool.and (u32.eq (local kind) 7u32) (i32.eq (local width) 4i32))
				(then
					(if
						(:doc "Match every decoded byte of thin.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 116u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 104u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 105u8)
						(u8.eq (slice.load (local bytes) 3i32) 110u8))))
						(then (return 1i32)))))
			(if
				(:doc "Decode the full choice.")
				(bool.and (u32.eq (local kind) 7u32) (i32.eq (local width) 4i32))
				(then
					(if
						(:doc "Match every decoded byte of full.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 102u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 117u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 108u8)
						(u8.eq (slice.load (local bytes) 3i32) 108u8))))
						(then (return 2i32)))))
			(if
				(:doc "Decode the c11 choice.")
				(bool.and (u32.eq (local kind) 9u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of c11.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 49u8)
						(u8.eq (slice.load (local bytes) 2i32) 49u8)))
						(then (return 11i32)))))
			(if
				(:doc "Decode the c17 choice.")
				(bool.and (u32.eq (local kind) 9u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of c17.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 49u8)
						(u8.eq (slice.load (local bytes) 2i32) 55u8)))
						(then (return 17i32)))))
			(if
				(:doc "Decode the c23 choice.")
				(bool.and (u32.eq (local kind) 9u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of c23.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 50u8)
						(u8.eq (slice.load (local bytes) 2i32) 51u8)))
						(then (return 23i32)))))
			(if
				(:doc "Decode the tabs choice.")
				(bool.and (u32.eq (local kind) 10u32) (i32.eq (local width) 4i32))
				(then
					(if
						(:doc "Match every decoded byte of tabs.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 116u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 98u8)
						(u8.eq (slice.load (local bytes) 3i32) 115u8))))
						(then (return 0i32)))))
			(if
				(:doc "Decode the spaces choice.")
				(bool.and (u32.eq (local kind) 10u32) (i32.eq (local width) 6i32))
				(then
					(if
						(:doc "Match every decoded byte of spaces.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 115u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 112u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 3i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 4i32) 101u8)
						(u8.eq (slice.load (local bytes) 5i32) 115u8))))))
						(then (return 1i32)))))
			(if
				(:doc "Decode the lf choice.")
				(bool.and (u32.eq (local kind) 11u32) (i32.eq (local width) 2i32))
				(then
					(if
						(:doc "Match every decoded byte of lf.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 108u8)
						(u8.eq (slice.load (local bytes) 1i32) 102u8))
						(then (return 0i32)))))
			(if
				(:doc "Decode the crlf choice.")
				(bool.and (u32.eq (local kind) 11u32) (i32.eq (local width) 4i32))
				(then
					(if
						(:doc "Match every decoded byte of crlf.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 114u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 108u8)
						(u8.eq (slice.load (local bytes) 3i32) 102u8))))
						(then (return 1i32)))))
			(if
				(:doc "Decode the system-headers choice.")
				(bool.and (u32.eq (local kind) 12u32) (i32.eq (local width) 14i32))
				(then
					(if
						(:doc "Match every decoded byte of system-headers.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 115u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 121u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 115u8)
						(bool.and (u8.eq (slice.load (local bytes) 3i32) 116u8)
						(bool.and (u8.eq (slice.load (local bytes) 4i32) 101u8)
						(bool.and (u8.eq (slice.load (local bytes) 5i32) 109u8)
						(bool.and (u8.eq (slice.load (local bytes) 6i32) 45u8)
						(bool.and (u8.eq (slice.load (local bytes) 7i32) 104u8)
						(bool.and (u8.eq (slice.load (local bytes) 8i32) 101u8)
						(bool.and (u8.eq (slice.load (local bytes) 9i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 10i32) 100u8)
						(bool.and (u8.eq (slice.load (local bytes) 11i32) 101u8)
						(bool.and (u8.eq (slice.load (local bytes) 12i32) 114u8)
						(u8.eq (slice.load (local bytes) 13i32) 115u8))))))))))))))
						(then (return 0i32)))))
			(if
				(:doc "Decode the local-headers choice.")
				(bool.and (u32.eq (local kind) 12u32) (i32.eq (local width) 13i32))
				(then
					(if
						(:doc "Match every decoded byte of local-headers.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 108u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 111u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 3i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 4i32) 108u8)
						(bool.and (u8.eq (slice.load (local bytes) 5i32) 45u8)
						(bool.and (u8.eq (slice.load (local bytes) 6i32) 104u8)
						(bool.and (u8.eq (slice.load (local bytes) 7i32) 101u8)
						(bool.and (u8.eq (slice.load (local bytes) 8i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 9i32) 100u8)
						(bool.and (u8.eq (slice.load (local bytes) 10i32) 101u8)
						(bool.and (u8.eq (slice.load (local bytes) 11i32) 114u8)
						(u8.eq (slice.load (local bytes) 12i32) 115u8)))))))))))))
						(then (return 1i32)))))
			(if
				(:doc "Decode the standard-modules choice.")
				(bool.and (u32.eq (local kind) 12u32) (i32.eq (local width) 16i32))
				(then
					(if
						(:doc "Match every decoded byte of standard-modules.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 115u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 116u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 3i32) 110u8)
						(bool.and (u8.eq (slice.load (local bytes) 4i32) 100u8)
						(bool.and (u8.eq (slice.load (local bytes) 5i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 6i32) 114u8)
						(bool.and (u8.eq (slice.load (local bytes) 7i32) 100u8)
						(bool.and (u8.eq (slice.load (local bytes) 8i32) 45u8)
						(bool.and (u8.eq (slice.load (local bytes) 9i32) 109u8)
						(bool.and (u8.eq (slice.load (local bytes) 10i32) 111u8)
						(bool.and (u8.eq (slice.load (local bytes) 11i32) 100u8)
						(bool.and (u8.eq (slice.load (local bytes) 12i32) 117u8)
						(bool.and (u8.eq (slice.load (local bytes) 13i32) 108u8)
						(bool.and (u8.eq (slice.load (local bytes) 14i32) 101u8)
						(u8.eq (slice.load (local bytes) 15i32) 115u8))))))))))))))))
						(then (return 2i32)))))
			(if
				(:doc "Decode the local-modules choice.")
				(bool.and (u32.eq (local kind) 12u32) (i32.eq (local width) 13i32))
				(then
					(if
						(:doc "Match every decoded byte of local-modules.")
						(bool.and (u8.eq (slice.load (local bytes) 0i32) 108u8)
						(bool.and (u8.eq (slice.load (local bytes) 1i32) 111u8)
						(bool.and (u8.eq (slice.load (local bytes) 2i32) 99u8)
						(bool.and (u8.eq (slice.load (local bytes) 3i32) 97u8)
						(bool.and (u8.eq (slice.load (local bytes) 4i32) 108u8)
						(bool.and (u8.eq (slice.load (local bytes) 5i32) 45u8)
						(bool.and (u8.eq (slice.load (local bytes) 6i32) 109u8)
						(bool.and (u8.eq (slice.load (local bytes) 7i32) 111u8)
						(bool.and (u8.eq (slice.load (local bytes) 8i32) 100u8)
						(bool.and (u8.eq (slice.load (local bytes) 9i32) 117u8)
						(bool.and (u8.eq (slice.load (local bytes) 10i32) 108u8)
						(bool.and (u8.eq (slice.load (local bytes) 11i32) 101u8)
						(u8.eq (slice.load (local bytes) 12i32) 115u8)))))))))))))
						(then (return 3i32)))))
			(return -1i32)))

	(fn read_project_word
		(:doc "Require a JSON string and decode its enum member, including escaped spellings.")
		(params (source (shared-slice u8)) (value JsonNode) (kind u32))
		(returns i32)
		(body
			(if
				(:doc "An enum member must be a quoted JSON string.")
				(bool.not (u32.eq (struct.get (local value) kind) 3u32))
				(then (return -1i32)))
			(let-mut text (array.alloc u8 16i32))
			(let decoded (call json_decode_string (borrow-shared (local source))
				(struct.get (local value) start) (struct.get (local value) end) (borrow-mut (local text))))
			(if
				(:doc "A string longer than the longest choice cannot match.")
				(u32.lt 0u32 (struct.get (local decoded) error))
				(then (return -1i32)))
			(return (call project_word (local kind) (borrow-shared (local text)) (struct.get (local decoded) written)))))

	(fn project_number_in_range
		(:doc "Apply the shared range for a validated unsigned option value.")
		(params (kind u32) (number u32))
		(returns bool)
		(body (return (bool.not (bool.or
			(bool.and (u32.eq (local kind) 13u32)
				(bool.or (u32.lt (local number) 1u32) (u32.lt 16u32 (local number))))
			(bool.and (u32.eq (local kind) 14u32) (u32.lt 8u32 (local number))))))))

	(fn project_number
		(:doc "Return -1 for a valid unsigned integer or the failing value row for an invalid one.")
		(params (source (shared-slice u8)) (value JsonNode) (row i32) (kind u32))
		(returns ProjectValue)
		(body
			(let invalid (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))
			(if
				(:doc "Numeric settings require a JSON number lexeme.")
				(bool.not (u32.eq (struct.get (local value) kind) 4u32))
				(then (return (local invalid))))
			(let parsed (call read_decimal_digits (borrow-shared (local source))
				(struct.get (local value) start) (struct.get (local value) end) 429496729u32 5u32))
			(let number (struct.get (local parsed) magnitude))
			(if
				(:doc "Reject fractions, signs, exponents and values outside the setting's range.")
				(bool.or (i32.lt (struct.get (local parsed) digits) 0i32)
					(bool.not (call project_number_in_range (local kind) (local number))))
				(then (return (local invalid))))
			(return (struct.new ProjectValue (invalid -1i32) (scalar (local number))))))

	(fn add_import_category
		(:doc "Mark a category in a fixed-size table and reject a repeated import category.")
		(params (seen (mut-slice u8)) (category i32))
		(returns bool)
		(body
			(if
				(:doc "Invalid or repeated categories cannot supply a permutation.")
				(bool.or (i32.lt (local category) 0i32)
					(u8.eq (slice.load (local seen) (local category)) 1u8))
				(then (return (bool false))))
			(slice.store (local seen) (local category) 1u8)
			(return (bool true))))

	(fn pack_import_category
		(:doc "Append an import category as the last of four base-four digits.")
		(params (packed u32) (category i32))
		(returns u32)
		(body
			(let twice (u32.add.wrapping (local packed) (local packed)))
			(return (u32.add.wrapping (u32.add.wrapping (local twice) (local twice)) (int.convert u32 (local category))))))

	(fn read_project_list
		(:doc "Validate strings in an array, packing all four distinct categories for importOrder.")
		(params (source (shared-slice u8)) (nodes (shared-slice JsonNode)) (row i32) (import_order bool))
		(returns ProjectValue)
		(body
			(let value (slice.load (local nodes) (local row)))
			(if
				(:doc "A list setting requires a JSON array.")
				(bool.not (u32.eq (struct.get (local value) kind) 2u32))
				(then (return (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))))
			(let-mut seen (array.alloc u8 4i32))
			(let-mut count 0i32)
			(let-mut packed 0u32)
			(let-mut child (struct.get (local value) first_child))
			(while
				(:doc "Point at the individual item that fails its list's requirements.")
				(bool.not (i32.lt (local child) 0i32))
				(body
					(let item (slice.load (local nodes) (local child)))
					(if
						(:doc "All supported option lists contain strings.")
						(bool.not (u32.eq (struct.get (local item) kind) 3u32))
						(then (return (struct.new ProjectValue (invalid (local child)) (scalar 0u32)))))
					(if
						(:doc "Import categories must be recognized and unique.")
						(local import_order)
						(then
							(let category (call read_project_word (borrow-shared (local source)) (local item) 12u32))
							(if
								(:doc "Use the original category span for an unsupported or repeated member.")
								(bool.not (call add_import_category (borrow-mut (local seen)) (local category)))
								(then (return (struct.new ProjectValue (invalid (local child)) (scalar 0u32)))))
							(set (local packed) (call pack_import_category (local packed) (local category)))))
					(set (local count) (i32.add.wrapping (local count) 1i32))
					(set (local child) (struct.get (local item) next_sibling))))
			(if
				(:doc "Point at the complete list when an import category is missing.")
				(bool.and (local import_order) (bool.not (i32.eq (local count) 4i32)))
				(then (return (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))))
			(return (struct.new ProjectValue (invalid -1i32) (scalar (local packed))))))

	(fn read_project_value
		(:doc "Validate one schema field. Retain booleans, unsigned numbers and enum choices as scalars.")
		(params (source (shared-slice u8)) (nodes (shared-slice JsonNode)) (row i32) (kind u32))
		(returns ProjectValue)
		(body
			(let value (slice.load (local nodes) (local row)))
			(let json_kind (struct.get (local value) kind))
			(let zero (struct.new ProjectValue (invalid -1i32) (scalar 0u32)))
			(let invalid (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))
			(if
				(:doc "Objects use the schema's child scope, and profiles are listed in an array.")
				(u32.lt 14u32 (local kind))
				(then
					(if
						(:doc "Schema kinds 15 and 16 correspond to JSON object and array, respectively.")
						(u32.eq (u32.sub.wrapping (local kind) 14u32) (local json_kind))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Store explicit false as zero and explicit true as one.")
				(u32.eq (local kind) 1u32)
				(then
					(if
						(:doc "Only the literal true sets the boolean scalar.")
						(u32.eq (local json_kind) 5u32)
						(then (return (struct.new ProjectValue (invalid -1i32) (scalar 1u32)))))
					(if
						(:doc "A literal false supplies a zero scalar.")
						(u32.eq (local json_kind) 6u32)
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "The integer schema distinguishes sizing values from bounded formatter counts.")
				(bool.or (u32.eq (local kind) 3u32) (u32.lt 12u32 (local kind)))
				(then (return (call project_number (borrow-shared (local source)) (local value) (local row) (local kind)))))
			(if
				(:doc "Profile names must be strings. Output paths also accept an explicit null.")
				(bool.or (u32.eq (local kind) 5u32) (u32.eq (local kind) 8u32))
				(then
					(if
						(:doc "Preserve strings and null in the source rather than copying their bytes.")
						(bool.or (u32.eq (local json_kind) 3u32)
							(bool.and (u32.eq (local kind) 8u32) (u32.eq (local json_kind) 7u32)))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Lists retain their validated original items.")
				(bool.or (u32.eq (local kind) 6u32) (u32.eq (local kind) 12u32))
				(then (return (call read_project_list (borrow-shared (local source)) (borrow-shared (local nodes))
					(local row) (u32.eq (local kind) 12u32)))))
			(let member (call read_project_word (borrow-shared (local source)) (local value) (local kind)))
			(if
				(:doc "Report an unsupported spelling at the complete enum value.")
				(i32.lt (local member) 0i32)
				(then (return (local invalid))))
			(return (struct.new ProjectValue (invalid -1i32) (scalar (int.convert u32 (local member))))))))
