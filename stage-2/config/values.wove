(module project_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Validate and interpret leaf values declared in the project configuration schema.")

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct ProjectValue (fields (invalid i32) (scalar u32)))

	(fn project_word
		(:doc "Return the enum member of a decoded spelling, or -1 when it is unsupported.")
		(params (kind u32) (bytes (shared-array u8)) (width i32))
		(returns i32)
		(body
			(if
				(:doc "Decode the off choice.")
				(bool.and (u32.eq (local kind) 7u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of off.")
						(bool.and (u8.eq (array.load (local bytes) 0i32) 111u8)
						(bool.and (u8.eq (array.load (local bytes) 1i32) 102u8)
						(u8.eq (array.load (local bytes) 2i32) 102u8)))
						(then (return 0i32)))))
			(if
				(:doc "Decode the thin choice.")
				(bool.and (u32.eq (local kind) 7u32) (i32.eq (local width) 4i32))
				(then
					(if
						(:doc "Match every decoded byte of thin.")
						(bool.and (u8.eq (array.load (local bytes) 0i32) 116u8)
						(bool.and (u8.eq (array.load (local bytes) 1i32) 104u8)
						(bool.and (u8.eq (array.load (local bytes) 2i32) 105u8)
						(u8.eq (array.load (local bytes) 3i32) 110u8))))
						(then (return 1i32)))))
			(if
				(:doc "Decode the full choice.")
				(bool.and (u32.eq (local kind) 7u32) (i32.eq (local width) 4i32))
				(then
					(if
						(:doc "Match every decoded byte of full.")
						(bool.and (u8.eq (array.load (local bytes) 0i32) 102u8)
						(bool.and (u8.eq (array.load (local bytes) 1i32) 117u8)
						(bool.and (u8.eq (array.load (local bytes) 2i32) 108u8)
						(u8.eq (array.load (local bytes) 3i32) 108u8))))
						(then (return 2i32)))))
			(if
				(:doc "Decode the c11 choice.")
				(bool.and (u32.eq (local kind) 9u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of c11.")
						(bool.and (u8.eq (array.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (array.load (local bytes) 1i32) 49u8)
						(u8.eq (array.load (local bytes) 2i32) 49u8)))
						(then (return 11i32)))))
			(if
				(:doc "Decode the c17 choice.")
				(bool.and (u32.eq (local kind) 9u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of c17.")
						(bool.and (u8.eq (array.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (array.load (local bytes) 1i32) 49u8)
						(u8.eq (array.load (local bytes) 2i32) 55u8)))
						(then (return 17i32)))))
			(if
				(:doc "Decode the c23 choice.")
				(bool.and (u32.eq (local kind) 9u32) (i32.eq (local width) 3i32))
				(then
					(if
						(:doc "Match every decoded byte of c23.")
						(bool.and (u8.eq (array.load (local bytes) 0i32) 99u8)
						(bool.and (u8.eq (array.load (local bytes) 1i32) 50u8)
						(u8.eq (array.load (local bytes) 2i32) 51u8)))
						(then (return 23i32)))))
			(return -1i32)))

	(fn read_project_word
		(:doc "Require a JSON string and decode its enum member, including escaped spellings.")
		(params (source (shared-array u8)) (value JsonNode) (kind u32))
		(returns i32)
		(body
			(if
				(:doc "An enum member must be a quoted JSON string.")
				(u32.not-eq (struct.get (local value) kind) 3u32)
				(then (return -1i32)))
			(let-mut text (array.alloc u8 4i32))
			(let decoded (call json_decode_string (borrow-shared (local source))
				(struct.get (local value) start) (struct.get (local value) end) (borrow-mut (local text))))
			(if
				(:doc "A string longer than the longest choice cannot match.")
				(u32.gtz (struct.get (local decoded) error))
				(then (return -1i32)))
			(return (call project_word (local kind) (borrow-shared (local text)) (struct.get (local decoded) written)))))

	(fn project_number
		(:doc "Return -1 for a valid unsigned integer or the failing value row for an invalid one.")
		(params (source (shared-array u8)) (value JsonNode) (row i32))
		(returns ProjectValue)
		(body
			(let invalid (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))
			(if
				(:doc "Numeric settings require a JSON number lexeme.")
				(u32.not-eq (struct.get (local value) kind) 4u32)
				(then (return (local invalid))))
			(let parsed (call read_decimal_digits (borrow-shared (local source))
				(struct.get (local value) start) (struct.get (local value) end) 429496729u32 5u32))
			(let number (struct.get (local parsed) magnitude))
			(if
				(:doc "Reject fractions, signs, exponents, and values outside u32.")
				(i32.ltz (struct.get (local parsed) digits))
				(then (return (local invalid))))
			(return (struct.new ProjectValue (invalid -1i32) (scalar (local number))))))

	(fn read_project_list
		(:doc "Validate a list of strings and retain the original JSON rows.")
		(params (nodes (shared-array JsonNode)) (row i32)) (returns ProjectValue)
		(body
			(let value (array.load (local nodes) (local row)))
			(if
				(:doc "A list setting requires a JSON array.")
				(u32.not-eq (struct.get (local value) kind) 2u32)
				(then (return (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))))
			(let-mut child (struct.get (local value) first_child))
			(while
				(:doc "Point at the individual item that fails the string requirement.")
				(i32.not-ltz (local child))
				(body
					(let item (array.load (local nodes) (local child)))
					(if (u32.not-eq (struct.get (local item) kind) 3u32)
						(then (return (struct.new ProjectValue (invalid (local child)) (scalar 0u32)))))
					(set (local child) (struct.get (local item) next_sibling))))
			(return (struct.new ProjectValue (invalid -1i32) (scalar 0u32)))))

	(fn read_project_value
		(:doc "Validate one schema field. Retain booleans, unsigned numbers and enum choices as scalars.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (row i32) (kind u32))
		(returns ProjectValue)
		(body
			(let value (array.load (local nodes) (local row)))
			(let json_kind (struct.get (local value) kind))
			(let zero (struct.new ProjectValue (invalid -1i32) (scalar 0u32)))
			(let invalid (struct.new ProjectValue (invalid (local row)) (scalar 0u32)))
			(if
				(:doc "Objects use the schema's child scope, and profiles are listed in an array.")
				(u32.lt 14u32 (local kind))
				(then
					(if
						(:doc "Schema kinds 15 and 16 correspond to JSON object and array, respectively.")
						(u32.eq (u32.sub (local kind) 14u32) (local json_kind))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Store explicit false as zero and explicit true as one.")
				(u32.eq (local kind) 1u32)
				(then
					(if
						(:doc "Only the literal true sets the boolean scalar.")
						(u32.eq (local json_kind) 5u32)
						(then (return (struct.new ProjectValue (invalid -1i32) (scalar 1u32)))))
					(if
						(:doc "A literal false supplies a zero scalar.")
						(u32.eq (local json_kind) 6u32)
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Builds are serial. The parallel setting accepts only JSON false.")
				(u32.eq (local kind) 2u32)
				(then
					(if (u32.eq (local json_kind) 6u32) (then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Numeric options use the same unsigned integer type.")
				(u32.eq (local kind) 3u32)
				(then (return (call project_number (borrow-shared (local source)) (local value) (local row)))))
			(if
				(:doc "Profile names must be strings. Output paths also accept an explicit null.")
				(bool.or (u32.eq (local kind) 5u32) (u32.eq (local kind) 8u32))
				(then
					(if
						(:doc "Preserve strings and null in the source rather than copying their bytes.")
						(bool.or (u32.eq (local json_kind) 3u32)
							(bool.and (u32.eq (local kind) 8u32) (u32.eq (local json_kind) 7u32)))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Lists retain their validated original items.")
				(u32.eq (local kind) 6u32)
				(then (return (call read_project_list (borrow-shared (local nodes)) (local row)))))
			(let member (call read_project_word (borrow-shared (local source)) (local value) (local kind)))
			(if
				(:doc "Report an unsupported spelling at the complete enum value.")
				(i32.ltz (local member))
				(then (return (local invalid))))
			(return (struct.new ProjectValue (invalid -1i32) (scalar (u32.from-i32 (local member))))))))
