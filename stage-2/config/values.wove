(module project_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Validate and interpret leaf values declared in the project configuration schema.")

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(struct ProjectValue (fields (invalid i32) (scalar u32)))

	(fn project_word
		(:doc "Return the enum member of a decoded spelling, or -1 when it is unsupported.")
		(params (kind u32) (bytes (shared-slice u8)) (width i32))
		(returns i32)
		(body
			(if
				(:doc "Decode the off choice.")
				(bool.and (u32.eq (local kind) (u32 7)) (i32.eq (local width) (i32 3)))
				(then
					(if
						(:doc "Match every decoded byte of off.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 111))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 102))
						(u8.eq (slice.load (local bytes) (i32 2)) (u8 102))))
						(then (return (i32 0))))))
			(if
				(:doc "Decode the thin choice.")
				(bool.and (u32.eq (local kind) (u32 7)) (i32.eq (local width) (i32 4)))
				(then
					(if
						(:doc "Match every decoded byte of thin.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 116))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 104))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 105))
						(u8.eq (slice.load (local bytes) (i32 3)) (u8 110)))))
						(then (return (i32 1))))))
			(if
				(:doc "Decode the full choice.")
				(bool.and (u32.eq (local kind) (u32 7)) (i32.eq (local width) (i32 4)))
				(then
					(if
						(:doc "Match every decoded byte of full.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 102))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 117))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 108))
						(u8.eq (slice.load (local bytes) (i32 3)) (u8 108)))))
						(then (return (i32 2))))))
			(if
				(:doc "Decode the c11 choice.")
				(bool.and (u32.eq (local kind) (u32 9)) (i32.eq (local width) (i32 3)))
				(then
					(if
						(:doc "Match every decoded byte of c11.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 49))
						(u8.eq (slice.load (local bytes) (i32 2)) (u8 49))))
						(then (return (i32 11))))))
			(if
				(:doc "Decode the c17 choice.")
				(bool.and (u32.eq (local kind) (u32 9)) (i32.eq (local width) (i32 3)))
				(then
					(if
						(:doc "Match every decoded byte of c17.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 49))
						(u8.eq (slice.load (local bytes) (i32 2)) (u8 55))))
						(then (return (i32 17))))))
			(if
				(:doc "Decode the c23 choice.")
				(bool.and (u32.eq (local kind) (u32 9)) (i32.eq (local width) (i32 3)))
				(then
					(if
						(:doc "Match every decoded byte of c23.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 50))
						(u8.eq (slice.load (local bytes) (i32 2)) (u8 51))))
						(then (return (i32 23))))))
			(if
				(:doc "Decode the tabs choice.")
				(bool.and (u32.eq (local kind) (u32 10)) (i32.eq (local width) (i32 4)))
				(then
					(if
						(:doc "Match every decoded byte of tabs.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 116))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 98))
						(u8.eq (slice.load (local bytes) (i32 3)) (u8 115)))))
						(then (return (i32 0))))))
			(if
				(:doc "Decode the spaces choice.")
				(bool.and (u32.eq (local kind) (u32 10)) (i32.eq (local width) (i32 6)))
				(then
					(if
						(:doc "Match every decoded byte of spaces.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 115))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 112))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 3)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 4)) (u8 101))
						(u8.eq (slice.load (local bytes) (i32 5)) (u8 115)))))))
						(then (return (i32 1))))))
			(if
				(:doc "Decode the lf choice.")
				(bool.and (u32.eq (local kind) (u32 11)) (i32.eq (local width) (i32 2)))
				(then
					(if
						(:doc "Match every decoded byte of lf.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 108))
						(u8.eq (slice.load (local bytes) (i32 1)) (u8 102)))
						(then (return (i32 0))))))
			(if
				(:doc "Decode the crlf choice.")
				(bool.and (u32.eq (local kind) (u32 11)) (i32.eq (local width) (i32 4)))
				(then
					(if
						(:doc "Match every decoded byte of crlf.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 114))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 108))
						(u8.eq (slice.load (local bytes) (i32 3)) (u8 102)))))
						(then (return (i32 1))))))
			(if
				(:doc "Decode the system-headers choice.")
				(bool.and (u32.eq (local kind) (u32 12)) (i32.eq (local width) (i32 14)))
				(then
					(if
						(:doc "Match every decoded byte of system-headers.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 115))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 121))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 115))
						(bool.and (u8.eq (slice.load (local bytes) (i32 3)) (u8 116))
						(bool.and (u8.eq (slice.load (local bytes) (i32 4)) (u8 101))
						(bool.and (u8.eq (slice.load (local bytes) (i32 5)) (u8 109))
						(bool.and (u8.eq (slice.load (local bytes) (i32 6)) (u8 45))
						(bool.and (u8.eq (slice.load (local bytes) (i32 7)) (u8 104))
						(bool.and (u8.eq (slice.load (local bytes) (i32 8)) (u8 101))
						(bool.and (u8.eq (slice.load (local bytes) (i32 9)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 10)) (u8 100))
						(bool.and (u8.eq (slice.load (local bytes) (i32 11)) (u8 101))
						(bool.and (u8.eq (slice.load (local bytes) (i32 12)) (u8 114))
						(u8.eq (slice.load (local bytes) (i32 13)) (u8 115)))))))))))))))
						(then (return (i32 0))))))
			(if
				(:doc "Decode the local-headers choice.")
				(bool.and (u32.eq (local kind) (u32 12)) (i32.eq (local width) (i32 13)))
				(then
					(if
						(:doc "Match every decoded byte of local-headers.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 108))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 111))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 3)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 4)) (u8 108))
						(bool.and (u8.eq (slice.load (local bytes) (i32 5)) (u8 45))
						(bool.and (u8.eq (slice.load (local bytes) (i32 6)) (u8 104))
						(bool.and (u8.eq (slice.load (local bytes) (i32 7)) (u8 101))
						(bool.and (u8.eq (slice.load (local bytes) (i32 8)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 9)) (u8 100))
						(bool.and (u8.eq (slice.load (local bytes) (i32 10)) (u8 101))
						(bool.and (u8.eq (slice.load (local bytes) (i32 11)) (u8 114))
						(u8.eq (slice.load (local bytes) (i32 12)) (u8 115))))))))))))))
						(then (return (i32 1))))))
			(if
				(:doc "Decode the standard-modules choice.")
				(bool.and (u32.eq (local kind) (u32 12)) (i32.eq (local width) (i32 16)))
				(then
					(if
						(:doc "Match every decoded byte of standard-modules.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 115))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 116))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 3)) (u8 110))
						(bool.and (u8.eq (slice.load (local bytes) (i32 4)) (u8 100))
						(bool.and (u8.eq (slice.load (local bytes) (i32 5)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 6)) (u8 114))
						(bool.and (u8.eq (slice.load (local bytes) (i32 7)) (u8 100))
						(bool.and (u8.eq (slice.load (local bytes) (i32 8)) (u8 45))
						(bool.and (u8.eq (slice.load (local bytes) (i32 9)) (u8 109))
						(bool.and (u8.eq (slice.load (local bytes) (i32 10)) (u8 111))
						(bool.and (u8.eq (slice.load (local bytes) (i32 11)) (u8 100))
						(bool.and (u8.eq (slice.load (local bytes) (i32 12)) (u8 117))
						(bool.and (u8.eq (slice.load (local bytes) (i32 13)) (u8 108))
						(bool.and (u8.eq (slice.load (local bytes) (i32 14)) (u8 101))
						(u8.eq (slice.load (local bytes) (i32 15)) (u8 115)))))))))))))))))
						(then (return (i32 2))))))
			(if
				(:doc "Decode the local-modules choice.")
				(bool.and (u32.eq (local kind) (u32 12)) (i32.eq (local width) (i32 13)))
				(then
					(if
						(:doc "Match every decoded byte of local-modules.")
						(bool.and (u8.eq (slice.load (local bytes) (i32 0)) (u8 108))
						(bool.and (u8.eq (slice.load (local bytes) (i32 1)) (u8 111))
						(bool.and (u8.eq (slice.load (local bytes) (i32 2)) (u8 99))
						(bool.and (u8.eq (slice.load (local bytes) (i32 3)) (u8 97))
						(bool.and (u8.eq (slice.load (local bytes) (i32 4)) (u8 108))
						(bool.and (u8.eq (slice.load (local bytes) (i32 5)) (u8 45))
						(bool.and (u8.eq (slice.load (local bytes) (i32 6)) (u8 109))
						(bool.and (u8.eq (slice.load (local bytes) (i32 7)) (u8 111))
						(bool.and (u8.eq (slice.load (local bytes) (i32 8)) (u8 100))
						(bool.and (u8.eq (slice.load (local bytes) (i32 9)) (u8 117))
						(bool.and (u8.eq (slice.load (local bytes) (i32 10)) (u8 108))
						(bool.and (u8.eq (slice.load (local bytes) (i32 11)) (u8 101))
						(u8.eq (slice.load (local bytes) (i32 12)) (u8 115))))))))))))))
						(then (return (i32 3))))))
			(return (i32 -1))))

	(fn read_project_word
		(:doc "Require a JSON string and decode its enum member, including escaped spellings.")
		(params (source (shared-slice u8)) (value JsonNode) (kind u32))
		(returns i32)
		(body
			(if
				(:doc "An enum member must be a quoted JSON string.")
				(bool.not (u32.eq (record.get (local value) kind) (u32 3)))
				(then (return (i32 -1))))
			(let-mut text (array.alloc u8 (i32 16)))
			(let decoded (call json_decode_string (borrow-shared (local source))
				(record.get (local value) start) (record.get (local value) end) (borrow-mut (local text))))
			(if
				(:doc "A string longer than the longest choice cannot match.")
				(u32.lt (u32 0) (record.get (local decoded) error))
				(then (return (i32 -1))))
			(return (call project_word (local kind) (borrow-shared (local text)) (record.get (local decoded) written)))))

	(fn project_number_in_range
		(:doc "Apply the shared range for a validated unsigned option value.")
		(params (kind u32) (number u32))
		(returns bool)
		(body (return (bool.not (bool.or
			(bool.and (u32.eq (local kind) (u32 13))
				(bool.or (u32.lt (local number) (u32 1)) (u32.lt (u32 16) (local number))))
			(bool.and (u32.eq (local kind) (u32 14)) (u32.lt (u32 8) (local number))))))))

	(fn project_number
		(:doc "Return -1 for a valid unsigned integer or the failing value row for an invalid one.")
		(params (source (shared-slice u8)) (value JsonNode) (row i32) (kind u32))
		(returns ProjectValue)
		(body
			(let invalid (record.make ProjectValue (invalid (local row)) (scalar (u32 0))))
			(if
				(:doc "Numeric settings require a JSON number lexeme.")
				(bool.not (u32.eq (record.get (local value) kind) (u32 4)))
				(then (return (local invalid))))
			(let parsed (call read_decimal_digits (borrow-shared (local source))
				(record.get (local value) start) (record.get (local value) end) (u32 429496729) (u32 5)))
			(let number (record.get (local parsed) magnitude))
			(if
				(:doc "Reject fractions, signs, exponents and values outside the setting's range.")
				(bool.or (i32.lt (record.get (local parsed) digits) (i32 0))
					(bool.not (call project_number_in_range (local kind) (local number))))
				(then (return (local invalid))))
			(return (record.make ProjectValue (invalid (i32 -1)) (scalar (local number))))))

	(fn add_import_category
		(:doc "Mark a category in a fixed-size table and reject a repeated import category.")
		(params (seen (mut-slice u8)) (category i32))
		(returns bool)
		(body
			(if
				(:doc "Invalid or repeated categories cannot supply a permutation.")
				(bool.or (i32.lt (local category) (i32 0))
					(u8.eq (slice.load (local seen) (local category)) (u8 1)))
				(then (return (bool false))))
			(slice.store (local seen) (local category) (u8 1))
			(return (bool true))))

	(fn pack_import_category
		(:doc "Append an import category as the last of four base-four digits.")
		(params (packed u32) (category i32))
		(returns u32)
		(body
			(let twice (u32.add.wrapping (local packed) (local packed)))
			(return (u32.add.wrapping (u32.add.wrapping (local twice) (local twice)) (int.convert u32 (local category))))))

	(fn read_project_list
		(:doc "Validate strings in an array, packing all four distinct categories for importOrder.")
		(params (source (shared-slice u8)) (nodes (shared-slice JsonNode)) (row i32) (import_order bool))
		(returns ProjectValue)
		(body
			(let value (slice.load (local nodes) (local row)))
			(if
				(:doc "A list setting requires a JSON array.")
				(bool.not (u32.eq (record.get (local value) kind) (u32 2)))
				(then (return (record.make ProjectValue (invalid (local row)) (scalar (u32 0))))))
			(let-mut seen (array.alloc u8 (i32 4)))
			(let-mut count (i32 0))
			(let-mut packed (u32 0))
			(let-mut child (record.get (local value) first_child))
			(while
				(:doc "Point at the individual item that fails its list's requirements.")
				(bool.not (i32.lt (local child) (i32 0)))
				(body
					(let item (slice.load (local nodes) (local child)))
					(if
						(:doc "All supported option lists contain strings.")
						(bool.not (u32.eq (record.get (local item) kind) (u32 3)))
						(then (return (record.make ProjectValue (invalid (local child)) (scalar (u32 0))))))
					(if
						(:doc "Import categories must be recognized and unique.")
						(local import_order)
						(then
							(let category (call read_project_word (borrow-shared (local source)) (local item) (u32 12)))
							(if
								(:doc "Use the original category span for an unsupported or repeated member.")
								(bool.not (call add_import_category (borrow-mut (local seen)) (local category)))
								(then (return (record.make ProjectValue (invalid (local child)) (scalar (u32 0))))))
							(set (local packed) (call pack_import_category (local packed) (local category)))))
					(set (local count) (i32.add.wrapping (local count) (i32 1)))
					(set (local child) (record.get (local item) next_sibling))))
			(if
				(:doc "Point at the complete list when an import category is missing.")
				(bool.and (local import_order) (bool.not (i32.eq (local count) (i32 4))))
				(then (return (record.make ProjectValue (invalid (local row)) (scalar (u32 0))))))
			(return (record.make ProjectValue (invalid (i32 -1)) (scalar (local packed))))))

	(fn read_project_value
		(:doc "Validate one schema field. Retain booleans, unsigned numbers and enum choices as scalars.")
		(params (source (shared-slice u8)) (nodes (shared-slice JsonNode)) (row i32) (kind u32))
		(returns ProjectValue)
		(body
			(let value (slice.load (local nodes) (local row)))
			(let json_kind (record.get (local value) kind))
			(let zero (record.make ProjectValue (invalid (i32 -1)) (scalar (u32 0))))
			(let invalid (record.make ProjectValue (invalid (local row)) (scalar (u32 0))))
			(if
				(:doc "Objects use the schema's child scope, and profiles are listed in an array.")
				(u32.lt (u32 14) (local kind))
				(then
					(if
						(:doc "Schema kinds 15 and 16 correspond to JSON object and array, respectively.")
						(u32.eq (u32.sub.wrapping (local kind) (u32 14)) (local json_kind))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Store explicit false as zero and explicit true as one.")
				(u32.eq (local kind) (u32 1))
				(then
					(if
						(:doc "Only the literal true sets the boolean scalar.")
						(u32.eq (local json_kind) (u32 5))
						(then (return (record.make ProjectValue (invalid (i32 -1)) (scalar (u32 1))))))
					(if
						(:doc "A literal false supplies a zero scalar.")
						(u32.eq (local json_kind) (u32 6))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "The integer schema distinguishes sizing values from bounded formatter counts.")
				(bool.or (u32.eq (local kind) (u32 3)) (u32.lt (u32 12) (local kind)))
				(then (return (call project_number (borrow-shared (local source)) (local value) (local row) (local kind)))))
			(if
				(:doc "Profile names must be strings. Output paths also accept an explicit null.")
				(bool.or (u32.eq (local kind) (u32 5)) (u32.eq (local kind) (u32 8)))
				(then
					(if
						(:doc "Preserve strings and null in the source rather than copying their bytes.")
						(bool.or (u32.eq (local json_kind) (u32 3))
							(bool.and (u32.eq (local kind) (u32 8)) (u32.eq (local json_kind) (u32 7))))
						(then (return (local zero))))
					(return (local invalid))))
			(if
				(:doc "Lists retain their validated original items.")
				(bool.or (u32.eq (local kind) (u32 6)) (u32.eq (local kind) (u32 12)))
				(then (return (call read_project_list (borrow-shared (local source)) (borrow-shared (local nodes))
					(local row) (u32.eq (local kind) (u32 12))))))
			(let member (call read_project_word (borrow-shared (local source)) (local value) (local kind)))
			(if
				(:doc "Report an unsupported spelling at the complete enum value.")
				(i32.lt (local member) (i32 0))
				(then (return (local invalid))))
			(return (record.make ProjectValue (invalid (i32 -1)) (scalar (int.convert u32 (local member))))))))
