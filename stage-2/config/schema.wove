			(call write_four (borrow-mut (local names)) 360i32 67u8 111u8 109u8 109u8)
			(call write_four (borrow-mut (local names)) 364i32 101u8 110u8 116u8 115u8)

			(call
				(:doc "fmt.guardedImportsGrouping")
				write_rule (borrow-mut (local rules)) 43i32 7u32 1u32 0u32 368i32 390i32)
			(call write_four (borrow-mut (local names)) 368i32 103u8 117u8 97u8 114u8)
			(call write_four (borrow-mut (local names)) 372i32 100u8 101u8 100u8 73u8)
			(call write_four (borrow-mut (local names)) 376i32 109u8 112u8 111u8 114u8)
			(call write_four (borrow-mut (local names)) 380i32 116u8 115u8 71u8 114u8)
			(call write_four (borrow-mut (local names)) 384i32 111u8 117u8 112u8 105u8)
			(slice.store (local names) 388i32 110u8)
			(slice.store (local names) 389i32 103u8)

			(call
				(:doc "fmt.guardedImportsLast")
				write_rule (borrow-mut (local rules)) 44i32 7u32 1u32 0u32 390i32 408i32)
			(call write_four (borrow-mut (local names)) 390i32 103u8 117u8 97u8 114u8)
			(call write_four (borrow-mut (local names)) 394i32 100u8 101u8 100u8 73u8)
			(call write_four (borrow-mut (local names)) 398i32 109u8 112u8 111u8 114u8)
			(call write_four (borrow-mut (local names)) 402i32 116u8 115u8 76u8 97u8)
			(slice.store (local names) 406i32 115u8)
			(slice.store (local names) 407i32 116u8)

			(call
