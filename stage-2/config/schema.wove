				write_rule (borrow-mut (local rules)) (i32 39) (u32 7) (u32 3) (u32 0) (i32 286) (i32 301))
			(call write_four (borrow-mut (local names)) (i32 286) (u8 99) (u8 104) (u8 101) (u8 99))
