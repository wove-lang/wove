(module project_schema
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Define the project configuration keys and their value types.

	Scopes 0 and 1 identify the root and profile. Build and its modes use
	2 and 3. Compiler, entry, and formatter fields use 4, 6, and 7.
	A row's start and end select its key bytes. The child field selects
	an object's scope.

	Kinds 1 and 3 are bool and u32 from the shared compiler descriptors.
	The project adds 2 false-only bool, 5 profile name, 6 string array, 7 LTO mode,
	8 nullable string, 9 C standard, 15 object, and 16 profile array.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./compiler.wove" (only compiler_option_count compiler_names_width compiler_option write_compiler_names copy_config_name))

	(struct ProjectRule (fields (scope u32) (kind u32) (child u32) (start i32) (end i32)))

	(let key_profiles "profiles")
	(let key_name "name")
	(let key_build "build")
	(let key_cc "cc")
	(let key_entry "entry")
	(let key_fmt "fmt")
	(let key_parallel "parallel")
	(let key_parallel_jobs "parallelJobs")
	(let key_time "time")
	(let key_default "default")
	(let key_debug "debug")
	(let key_release "release")
	(let key_cache "cache")
	(let key_cflags "cflags")
	(let key_defines "defines")
	(let key_ldflags "ldflags")
	(let key_ldlibs "ldlibs")
	(let key_links "links")
	(let key_lto "lto")
	(let key_output "output")
	(let key_cstd "cstd")
	(let key_flat "flat")
	(let key_bin "bin")
	(let key_lib "lib")
	(let key_line_width "lineWidth")

	(fn project_rule_count
		(:doc "Return the number of schema rows shared by the config reader and its consumers.")
		(params)
		(returns i32)
		(body (return (call project_compiler_rule (call compiler_option_count)))))

	(fn project_key_bytes
		(:doc "Return the packed byte capacity of the canonical schema keys.")
		(params)
		(returns i32)
		(body (return (i32.add (call project_shared_key_start) (call compiler_names_width)))))

	(fn project_key_width
		(:doc "Return a capacity that can hold any decoded key in the schema.")
		(params)
		(returns i32)
		(body
			(let compiler_width (call compiler_names_width))
			(if
				(:doc "The whole compiler name table bounds each individual compiler key.")
				(i32.lt 28i32 compiler_width)
				(then (return compiler_width)))
			(return 28i32)))

	(fn write_rule
		(:doc "Associate one key span with the required type and its containing scope.")
		(params (rules (mut-array ProjectRule)) (row i32) (scope u32) (kind u32) (child u32) (start i32) (end i32))
		(returns void)
		(body (array.store rules row (struct.new ProjectRule
			(scope scope) (kind kind) (child child) (start start) (end end)))))

	(fn write_project_key
		(:doc "Append one canonical key to its assigned offset and record the resulting span.")
		(params (names (mut-array u8)) (rules (mut-array ProjectRule)) (key (shared-array u8))
			(row i32) (scope u32) (kind u32) (child u32) (start i32))
		(returns void)
		(body
			(call copy_config_name (borrow-shared key) (borrow-mut names) start)
			(call write_rule (borrow-mut rules) row scope kind child
				start (i32.add start (array.len key)))))

	(fn write_project_schema
		(:doc "Write the schema into views sized by project_rule_count and project_key_bytes.")
		(params (names (mut-array u8)) (rules (mut-array ProjectRule)))
		(returns void)
		(body
			(call
				(:doc "root.profiles")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_profiles) 0i32 0u32 16u32 0u32 0i32)

			(call
				(:doc "profile.name")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_name) 1i32 1u32 5u32 0u32 8i32)

			(call
				(:doc "profile.build")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_build) 2i32 1u32 15u32 2u32 12i32)

			(call
				(:doc "profile.cc")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_cc) 3i32 1u32 15u32 4u32 17i32)

			(call
				(:doc "profile.entry")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_entry) 4i32 1u32 15u32 6u32 19i32)

			(call
				(:doc "profile.fmt")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_fmt) 5i32 1u32 15u32 7u32 24i32)

			(call
				(:doc "profile.parallel opts native bin into eligible grouped builds.")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_parallel) 6i32 1u32 1u32 0u32 27i32)

			(call
				(:doc "profile.parallelJobs")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_parallel_jobs) 7i32 1u32 3u32 0u32 35i32)

			(call
				(:doc "profile.time")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_time) 8i32 1u32 1u32 0u32 47i32)

			(call
				(:doc "build.default")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_default) 9i32 2u32 15u32 3u32 51i32)

			(call
				(:doc "build.debug")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_debug) 10i32 2u32 15u32 3u32 58i32)

			(call
				(:doc "build.release")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_release) 11i32 2u32 15u32 3u32 63i32)

			(call
				(:doc "build mode.cache")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_cache) 12i32 3u32 1u32 0u32 70i32)

			(call
				(:doc "build mode.cflags")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_cflags) 13i32 3u32 6u32 0u32 75i32)

			(call
				(:doc "build mode.defines")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_defines) 14i32 3u32 6u32 0u32 81i32)

			(call
				(:doc "build mode.ldflags")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_ldflags) 15i32 3u32 6u32 0u32 88i32)

			(call
				(:doc "build mode.ldlibs")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_ldlibs) 16i32 3u32 6u32 0u32 95i32)

			(call
				(:doc "build mode.links")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_links) 17i32 3u32 6u32 0u32 101i32)

			(call
				(:doc "build mode.lto")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_lto) 18i32 3u32 7u32 0u32 106i32)

			(call
				(:doc "build mode.output")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_output) 19i32 3u32 8u32 0u32 109i32)

			(call
				(:doc "cc.cstd")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_cstd) 20i32 4u32 9u32 0u32 115i32)

			(call
				(:doc "cc.defines")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_defines) 21i32 4u32 6u32 0u32 119i32)

			(call
				(:doc "cc.flat")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_flat) 22i32 4u32 1u32 0u32 126i32)

			(call
				(:doc "entry.bin")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_bin) 23i32 6u32 6u32 0u32 130i32)

			(call
				(:doc "entry.lib")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_lib) 24i32 6u32 6u32 0u32 133i32)

			(call
				(:doc "fmt.lineWidth")
				write_project_key (borrow-mut names) (borrow-mut rules)
				(borrow-shared key_line_width) 25i32 7u32 3u32 0u32 136i32)

			(call write_project_compiler_rules (borrow-mut names) (borrow-mut rules))))

	(fn project_compiler_rule
		(:doc "Map a shared compiler option's row to its project profile rule.")
		(params (row i32))
		(returns i32)
		(body (return (i32.add 26i32 row))))

	(fn project_shared_key_start
		(:doc "Start the shared compiler names immediately after the project-only packed keys.")
		(params)
		(returns i32)
		(body (return 145i32)))

	(fn write_project_compiler_rules
		(:doc "Append compiler option names and types from the descriptors also used by argv.")
		(params (names (mut-array u8)) (rules (mut-array ProjectRule)))
		(returns void)
		(body
			(let width (call compiler_names_width))
			(let offset (call project_shared_key_start))
			(call write_compiler_names (borrow-mut (array.range names offset (i32.add offset width))))
			(let-mut row 0i32)
			(while
				(:doc "The project profile accepts each of the existing typed compiler options.")
				(i32.lt row (call compiler_option_count))
				(body
					(let option (call compiler_option row))
					(call write_rule (borrow-mut rules) (call project_compiler_rule row)
						1u32 (struct.get option value_kind) 0u32
						(i32.add offset (struct.get option start))
						(i32.add offset (struct.get option end)))
					(set row (i32.inc row))))))

	(fn project_rule
		(:doc "Find a decoded key in its owning section, or return -1.")
		(params (rules (shared-array ProjectRule)) (names (shared-array u8))
			(scope u32) (key (shared-array u8)) (width i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "A key can have separate meanings in different sections.")
				(i32.lt index (array.len rules))
				(body
					(let rule (array.load rules index))
					(if
						(:doc "Check both the containing section and every decoded key byte.")
						(bool.and (u32.eq scope (struct.get rule scope))
							(call same_bytes (borrow-shared names) (struct.get rule start)
								(struct.get rule end) (borrow-shared key) 0i32 width))
						(then (return index)))
					(set index (i32.inc index))))
			(return -1i32))))
