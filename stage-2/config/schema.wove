(module project_schema
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Define the project configuration keys and their value types.

	Scopes 0 and 1 identify the root and profile. Build and its modes use
	2 and 3. Compiler, entry, and formatter fields use 4, 6, and 7.
	A row's start and end select its key bytes. The child field selects
	an object's scope.

	Kinds 1 and 3 are bool and u32 from the shared compiler descriptors.
	The project adds 5 profile name, 6 string array, 7 LTO mode,
	8 nullable string, 9 C standard, 15 object, and 16 profile array.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./compiler.wove" (only compiler_option_count compiler_names_width compiler_option write_compiler_names))

	(struct ProjectRule (fields (scope u32) (kind u32) (child u32) (start i32) (end i32)))

	(fn project_rule_count
		(:doc "Return the number of schema rows shared by the config reader and its consumers.")
		(params)
		(returns i32)
		(body (return (call project_compiler_rule (call compiler_option_count)))))

	(fn project_key_bytes
		(:doc "Return the packed byte capacity of the canonical schema keys.")
		(params)
		(returns i32)
		(body (return (i32.add (call project_shared_key_start) (call compiler_names_width)))))

	(fn project_key_width
		(:doc "Return a capacity that can hold any decoded key in the schema.")
		(params)
		(returns i32)
		(body
			(let compiler_width (call compiler_names_width))
			(if
				(:doc "The whole compiler name table bounds each individual compiler key.")
				(i32.lt 28i32 (local compiler_width))
				(then (return (local compiler_width))))
			(return 28i32)))

	(fn write_four
		(:doc "Store four consecutive bytes of a known schema key.")
		(params (names (mut-array u8)) (at i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(array.store (local names) (local at) (local a))
			(array.store (local names) (i32.add (local at) 1i32) (local b))
			(array.store (local names) (i32.add (local at) 2i32) (local c))
			(array.store (local names) (i32.add (local at) 3i32) (local d))))

	(fn write_rule
		(:doc "Associate one key span with the required type and its containing scope.")
		(params (rules (mut-array ProjectRule)) (row i32) (scope u32) (kind u32) (child u32) (start i32) (end i32))
		(returns void)
		(body (array.store (local rules) (local row) (struct.new ProjectRule
			(scope (local scope)) (kind (local kind)) (child (local child)) (start (local start)) (end (local end))))))

	(fn write_project_schema
		(:doc "Write the schema into views sized by project_rule_count and project_key_bytes.")
		(params (names (mut-array u8)) (rules (mut-array ProjectRule)))
		(returns void)
		(body
			(call
				(:doc "root.profiles")
				write_rule (borrow-mut (local rules)) 0i32 0u32 16u32 0u32 0i32 8i32)
			(call write_four (borrow-mut (local names)) 0i32 112u8 114u8 111u8 102u8)
			(call write_four (borrow-mut (local names)) 4i32 105u8 108u8 101u8 115u8)

			(call
				(:doc "profile.name")
				write_rule (borrow-mut (local rules)) 1i32 1u32 5u32 0u32 8i32 12i32)
			(call write_four (borrow-mut (local names)) 8i32 110u8 97u8 109u8 101u8)

			(call
				(:doc "profile.build")
				write_rule (borrow-mut (local rules)) 2i32 1u32 15u32 2u32 12i32 17i32)
			(call write_four (borrow-mut (local names)) 12i32 98u8 117u8 105u8 108u8)
			(array.store (local names) 16i32 100u8)

			(call
				(:doc "profile.cc")
				write_rule (borrow-mut (local rules)) 3i32 1u32 15u32 4u32 17i32 19i32)
			(array.store (local names) 17i32 99u8)
			(array.store (local names) 18i32 99u8)

			(call
				(:doc "profile.entry")
				write_rule (borrow-mut (local rules)) 4i32 1u32 15u32 6u32 19i32 24i32)
			(call write_four (borrow-mut (local names)) 19i32 101u8 110u8 116u8 114u8)
			(array.store (local names) 23i32 121u8)

			(call
				(:doc "profile.fmt")
				write_rule (borrow-mut (local rules)) 5i32 1u32 15u32 7u32 24i32 27i32)
			(array.store (local names) 24i32 102u8)
			(array.store (local names) 25i32 109u8)
			(array.store (local names) 26i32 116u8)

			(call
				(:doc "profile.parallel")
				write_rule (borrow-mut (local rules)) 6i32 1u32 1u32 0u32 27i32 35i32)
			(call write_four (borrow-mut (local names)) 27i32 112u8 97u8 114u8 97u8)
			(call write_four (borrow-mut (local names)) 31i32 108u8 108u8 101u8 108u8)

			(call
				(:doc "profile.parallelJobs")
				write_rule (borrow-mut (local rules)) 7i32 1u32 3u32 0u32 35i32 47i32)
			(call write_four (borrow-mut (local names)) 35i32 112u8 97u8 114u8 97u8)
			(call write_four (borrow-mut (local names)) 39i32 108u8 108u8 101u8 108u8)
			(call write_four (borrow-mut (local names)) 43i32 74u8 111u8 98u8 115u8)

			(call
				(:doc "profile.time")
				write_rule (borrow-mut (local rules)) 8i32 1u32 1u32 0u32 47i32 51i32)
			(call write_four (borrow-mut (local names)) 47i32 116u8 105u8 109u8 101u8)

			(call
				(:doc "build.default")
				write_rule (borrow-mut (local rules)) 9i32 2u32 15u32 3u32 51i32 58i32)
			(call write_four (borrow-mut (local names)) 51i32 100u8 101u8 102u8 97u8)
			(array.store (local names) 55i32 117u8)
			(array.store (local names) 56i32 108u8)
			(array.store (local names) 57i32 116u8)

			(call
				(:doc "build.debug")
				write_rule (borrow-mut (local rules)) 10i32 2u32 15u32 3u32 58i32 63i32)
			(call write_four (borrow-mut (local names)) 58i32 100u8 101u8 98u8 117u8)
			(array.store (local names) 62i32 103u8)

			(call
				(:doc "build.release")
				write_rule (borrow-mut (local rules)) 11i32 2u32 15u32 3u32 63i32 70i32)
			(call write_four (borrow-mut (local names)) 63i32 114u8 101u8 108u8 101u8)
			(array.store (local names) 67i32 97u8)
			(array.store (local names) 68i32 115u8)
			(array.store (local names) 69i32 101u8)

			(call
				(:doc "build mode.cache")
				write_rule (borrow-mut (local rules)) 12i32 3u32 1u32 0u32 70i32 75i32)
			(call write_four (borrow-mut (local names)) 70i32 99u8 97u8 99u8 104u8)
			(array.store (local names) 74i32 101u8)

			(call
				(:doc "build mode.cflags")
				write_rule (borrow-mut (local rules)) 13i32 3u32 6u32 0u32 75i32 81i32)
			(call write_four (borrow-mut (local names)) 75i32 99u8 102u8 108u8 97u8)
			(array.store (local names) 79i32 103u8)
			(array.store (local names) 80i32 115u8)

			(call
				(:doc "build mode.defines")
				write_rule (borrow-mut (local rules)) 14i32 3u32 6u32 0u32 81i32 88i32)
			(call write_four (borrow-mut (local names)) 81i32 100u8 101u8 102u8 105u8)
			(array.store (local names) 85i32 110u8)
			(array.store (local names) 86i32 101u8)
			(array.store (local names) 87i32 115u8)

			(call
				(:doc "build mode.ldflags")
				write_rule (borrow-mut (local rules)) 15i32 3u32 6u32 0u32 88i32 95i32)
			(call write_four (borrow-mut (local names)) 88i32 108u8 100u8 102u8 108u8)
			(array.store (local names) 92i32 97u8)
			(array.store (local names) 93i32 103u8)
			(array.store (local names) 94i32 115u8)

			(call
				(:doc "build mode.ldlibs")
				write_rule (borrow-mut (local rules)) 16i32 3u32 6u32 0u32 95i32 101i32)
			(call write_four (borrow-mut (local names)) 95i32 108u8 100u8 108u8 105u8)
			(array.store (local names) 99i32 98u8)
			(array.store (local names) 100i32 115u8)

			(call
				(:doc "build mode.links")
				write_rule (borrow-mut (local rules)) 17i32 3u32 6u32 0u32 101i32 106i32)
			(call write_four (borrow-mut (local names)) 101i32 108u8 105u8 110u8 107u8)
			(array.store (local names) 105i32 115u8)

			(call
				(:doc "build mode.lto")
				write_rule (borrow-mut (local rules)) 18i32 3u32 7u32 0u32 106i32 109i32)
			(array.store (local names) 106i32 108u8)
			(array.store (local names) 107i32 116u8)
			(array.store (local names) 108i32 111u8)

			(call
				(:doc "build mode.output")
				write_rule (borrow-mut (local rules)) 19i32 3u32 8u32 0u32 109i32 115i32)
			(call write_four (borrow-mut (local names)) 109i32 111u8 117u8 116u8 112u8)
			(array.store (local names) 113i32 117u8)
			(array.store (local names) 114i32 116u8)

			(call
				(:doc "cc.cstd")
				write_rule (borrow-mut (local rules)) 20i32 4u32 9u32 0u32 115i32 119i32)
			(call write_four (borrow-mut (local names)) 115i32 99u8 115u8 116u8 100u8)

			(call
				(:doc "cc.defines")
				write_rule (borrow-mut (local rules)) 21i32 4u32 6u32 0u32 119i32 126i32)
			(call write_four (borrow-mut (local names)) 119i32 100u8 101u8 102u8 105u8)
			(array.store (local names) 123i32 110u8)
			(array.store (local names) 124i32 101u8)
			(array.store (local names) 125i32 115u8)

			(call
				(:doc "cc.flat")
				write_rule (borrow-mut (local rules)) 22i32 4u32 1u32 0u32 126i32 130i32)
			(call write_four (borrow-mut (local names)) 126i32 102u8 108u8 97u8 116u8)

			(call
				(:doc "entry.bin")
				write_rule (borrow-mut (local rules)) 23i32 6u32 6u32 0u32 130i32 133i32)
			(array.store (local names) 130i32 98u8)
			(array.store (local names) 131i32 105u8)
			(array.store (local names) 132i32 110u8)

			(call
				(:doc "entry.lib")
				write_rule (borrow-mut (local rules)) 24i32 6u32 6u32 0u32 133i32 136i32)
			(array.store (local names) 133i32 108u8)
			(array.store (local names) 134i32 105u8)
			(array.store (local names) 135i32 98u8)

			(call
				(:doc "fmt.lineWidth")
				write_rule (borrow-mut (local rules)) 25i32 7u32 3u32 0u32 136i32 145i32)
			(call write_four (borrow-mut (local names)) 136i32 108u8 105u8 110u8 101u8)
			(call write_four (borrow-mut (local names)) 140i32 87u8 105u8 100u8 116u8)
			(array.store (local names) 144i32 104u8)

			(call write_project_compiler_rules (borrow-mut (local names)) (borrow-mut (local rules)))))

	(fn project_compiler_rule
		(:doc "Map a shared compiler option's row to its project profile rule.")
		(params (row i32))
		(returns i32)
		(body (return (i32.add 26i32 (local row)))))

	(fn project_shared_key_start
		(:doc "Start the shared compiler names immediately after the project-only packed keys.")
		(params)
		(returns i32)
		(body (return 145i32)))

	(fn write_project_compiler_rules
		(:doc "Append compiler option names and types from the descriptors also used by argv.")
		(params (names (mut-array u8)) (rules (mut-array ProjectRule)))
		(returns void)
		(body
			(let width (call compiler_names_width))
			(let offset (call project_shared_key_start))
			(let-mut shared_names (array.alloc u8 (local width)))
			(call write_compiler_names (borrow-mut (local shared_names)))
			(call append_compiler_names (borrow-shared (local shared_names)) (borrow-mut (local names)) (local offset))
			(let-mut row 0i32)
			(while
				(:doc "The project profile accepts each of the existing typed compiler options.")
				(i32.lt (local row) (call compiler_option_count))
				(body
					(let option (call compiler_option (local row)))
					(call write_rule (borrow-mut (local rules)) (call project_compiler_rule (local row))
						1u32 (struct.get (local option) value_kind) 0u32
						(i32.add (local offset) (struct.get (local option) start))
						(i32.add (local offset) (struct.get (local option) end)))
					(set (local row) (i32.add (local row) 1i32))))))

	(fn append_compiler_names
		(:doc "Append the packed compiler option names after the project-only keys.")
		(params (source (shared-array u8)) (names (mut-array u8)) (offset i32))
		(returns void)
		(body
			(let-mut at 0i32)
			(while
				(:doc "Keep the canonical option bytes and their original packed offsets together.")
				(i32.lt (local at) (array.len (local source)))
				(body
					(array.store (local names) (i32.add (local offset) (local at)) (array.load (local source) (local at)))
					(set (local at) (i32.add (local at) 1i32))))))

	(fn project_rule
		(:doc "Find a decoded key in its owning section, or return -1.")
		(params (rules (shared-array ProjectRule)) (names (shared-array u8))
			(scope u32) (key (shared-array u8)) (width i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "A key can have separate meanings in different sections.")
				(i32.lt (local index) (array.len (local rules)))
				(body
					(let rule (array.load (local rules) (local index)))
					(if
						(:doc "Check both the containing section and every decoded key byte.")
						(bool.and (u32.eq (local scope) (struct.get (local rule) scope))
							(call same_bytes (borrow-shared (local names)) (struct.get (local rule) start)
								(struct.get (local rule) end) (borrow-shared (local key)) 0i32 (local width)))
						(then (return (local index))))
					(set (local index) (i32.add (local index) 1i32))))
			(return -1i32))))
