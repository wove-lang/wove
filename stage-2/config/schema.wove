	(fn
		(:doc "Find a decoded key in its owning section, or return -1.")
		project_rule
		(params (rules (shared-slice ProjectRule)) (names (shared-slice u8))
			(scope u32) (key (shared-slice u8)) (width i32))
		(returns i32)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "A key can have separate meanings in different sections.")
				(i32.lt (local index) (slice.len (local rules)))
				(body
					(let rule (slice.load (local rules) (local index)))
					(if
						(:doc "Check both the containing section and every decoded key byte.")
						(bool.and (u32.eq (local scope) (record.get (local rule) scope))
							(call same_bytes (borrow-shared (local names)) (record.get (local rule) start)
								(record.get (local rule) end) (borrow-shared (local key)) (i32 0) (local width)))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (i32 -1)))))
