			(call write_four (borrow-mut (local names)) 322i32 101u8 120u8 112u8 97u8)
			(call write_four (borrow-mut (local names)) 326i32 110u8 100u8 73u8 110u8)
			(call write_four (borrow-mut (local names)) 330i32 108u8 105u8 110u8 101u8)
			(call write_four (borrow-mut (local names)) 334i32 66u8 108u8 111u8 99u8)
			(slice.store (local names) 338i32 107u8)
			(slice.store (local names) 339i32 115u8)

			(call
				(:doc "fmt.finalNewline")
				write_rule (borrow-mut (local rules)) 41i32 7u32 1u32 0u32 340i32 352i32)
			(call write_four (borrow-mut (local names)) 340i32 102u8 105u8 110u8 97u8)
			(call write_four (borrow-mut (local names)) 344i32 108u8 78u8 101u8 119u8)
			(call write_four (borrow-mut (local names)) 348i32 108u8 105u8 110u8 101u8)

			(call
