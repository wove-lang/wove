(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Define the archive's project configuration fields.

	Scopes 0 through 7 identify the root, a profile, build, a build mode,
	cc, cc.warn, entry, and fmt. A row's start and end select its canonical
	key bytes. The child field selects the scope of an object.

	Kinds are 1 object, 2 profile array, 3 bool, 4 u32, 5 profile name,
	6 string array, 7 LTO mode, 8 nullable string, 9 C standard,
	10 indent style, 11 line endings, 12 import order, 13 indent width,
	and 14 blank line count. The checked-in default profile provides
	starting values for each command.`)
	project_schema

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct ProjectRule (fields (scope u32) (kind u32) (child u32) (start i32) (end i32)))

	(fn
		(:doc "Return the number of schema rows shared by the config reader and its consumers.")
		project_rule_count
		(params)
		(returns i32)
		(body (return (i32 70))))

	(fn
		(:doc "Return the packed byte capacity of the canonical schema keys.")
		project_key_bytes
		(params)
		(returns i32)
		(body (return (i32 760))))

	(fn
		(:doc "Return the maximum width of one decoded key in the schema.")
		project_key_width
		(params)
		(returns i32)
		(body (return (i32 28))))

	(fn
		(:doc "Store four consecutive bytes of a known schema key.")
		write_four
		(params (names (mut-slice u8)) (at i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(slice.store (local names) (local at) (local a))
			(slice.store (local names) (i32.add.wrapping (local at) (i32 1)) (local b))
			(slice.store (local names) (i32.add.wrapping (local at) (i32 2)) (local c))
			(slice.store (local names) (i32.add.wrapping (local at) (i32 3)) (local d))))

	(fn
		(:doc "Associate one key span with the required type and its containing scope.")
		write_rule
		(params (rules (mut-slice ProjectRule)) (row i32) (scope u32) (kind u32) (child u32) (start i32) (end i32))
		(returns void)
		(body (slice.store (local rules) (local row) (record.make ProjectRule
			(scope (local scope)) (kind (local kind)) (child (local child)) (start (local start)) (end (local end))))))

	(fn
		(:doc "Write the schema into views sized by project_rule_count and project_key_bytes.")
		write_project_schema
		(params (names (mut-slice u8)) (rules (mut-slice ProjectRule)))
		(returns void)
		(body
			(call
				(:doc "root.profiles")
				write_rule (borrow-mut (local rules)) (i32 0) (u32 0) (u32 2) (u32 0) (i32 0) (i32 8))
			(call write_four (borrow-mut (local names)) (i32 0) (u8 112) (u8 114) (u8 111) (u8 102))
			(call write_four (borrow-mut (local names)) (i32 4) (u8 105) (u8 108) (u8 101) (u8 115))

			(call
				(:doc "profile.name")
				write_rule (borrow-mut (local rules)) (i32 1) (u32 1) (u32 5) (u32 0) (i32 8) (i32 12))
			(call write_four (borrow-mut (local names)) (i32 8) (u8 110) (u8 97) (u8 109) (u8 101))

			(call
				(:doc "profile.build")
				write_rule (borrow-mut (local rules)) (i32 2) (u32 1) (u32 1) (u32 2) (i32 12) (i32 17))
			(call write_four (borrow-mut (local names)) (i32 12) (u8 98) (u8 117) (u8 105) (u8 108))
			(slice.store (local names) (i32 16) (u8 100))

			(call
				(:doc "profile.cc")
				write_rule (borrow-mut (local rules)) (i32 3) (u32 1) (u32 1) (u32 4) (i32 17) (i32 19))
			(slice.store (local names) (i32 17) (u8 99))
			(slice.store (local names) (i32 18) (u8 99))

			(call
				(:doc "profile.entry")
				write_rule (borrow-mut (local rules)) (i32 4) (u32 1) (u32 1) (u32 6) (i32 19) (i32 24))
			(call write_four (borrow-mut (local names)) (i32 19) (u8 101) (u8 110) (u8 116) (u8 114))
			(slice.store (local names) (i32 23) (u8 121))

			(call
				(:doc "profile.fmt")
				write_rule (borrow-mut (local rules)) (i32 5) (u32 1) (u32 1) (u32 7) (i32 24) (i32 27))
			(slice.store (local names) (i32 24) (u8 102))
			(slice.store (local names) (i32 25) (u8 109))
			(slice.store (local names) (i32 26) (u8 116))

			(call
				(:doc "profile.parallel")
				write_rule (borrow-mut (local rules)) (i32 6) (u32 1) (u32 3) (u32 0) (i32 27) (i32 35))
			(call write_four (borrow-mut (local names)) (i32 27) (u8 112) (u8 97) (u8 114) (u8 97))
			(call write_four (borrow-mut (local names)) (i32 31) (u8 108) (u8 108) (u8 101) (u8 108))

			(call
				(:doc "profile.parallelJobs")
				write_rule (borrow-mut (local rules)) (i32 7) (u32 1) (u32 4) (u32 0) (i32 35) (i32 47))
			(call write_four (borrow-mut (local names)) (i32 35) (u8 112) (u8 97) (u8 114) (u8 97))
			(call write_four (borrow-mut (local names)) (i32 39) (u8 108) (u8 108) (u8 101) (u8 108))
			(call write_four (borrow-mut (local names)) (i32 43) (u8 74) (u8 111) (u8 98) (u8 115))

			(call
				(:doc "profile.time")
				write_rule (borrow-mut (local rules)) (i32 8) (u32 1) (u32 3) (u32 0) (i32 47) (i32 51))
			(call write_four (borrow-mut (local names)) (i32 47) (u8 116) (u8 105) (u8 109) (u8 101))

			(call
				(:doc "profile.human")
				write_rule (borrow-mut (local rules)) (i32 9) (u32 1) (u32 3) (u32 0) (i32 51) (i32 56))
			(call write_four (borrow-mut (local names)) (i32 51) (u8 104) (u8 117) (u8 109) (u8 97))
			(slice.store (local names) (i32 55) (u8 110))

			(call
				(:doc "profile.max-errors")
				write_rule (borrow-mut (local rules)) (i32 10) (u32 1) (u32 4) (u32 0) (i32 56) (i32 66))
			(call write_four (borrow-mut (local names)) (i32 56) (u8 109) (u8 97) (u8 120) (u8 45))
			(call write_four (borrow-mut (local names)) (i32 60) (u8 101) (u8 114) (u8 114) (u8 111))
			(slice.store (local names) (i32 64) (u8 114))
			(slice.store (local names) (i32 65) (u8 115))

			(call
				(:doc "profile.color")
				write_rule (borrow-mut (local rules)) (i32 11) (u32 1) (u32 3) (u32 0) (i32 66) (i32 71))
			(call write_four (borrow-mut (local names)) (i32 66) (u8 99) (u8 111) (u8 108) (u8 111))
			(slice.store (local names) (i32 70) (u8 114))

			(call
				(:doc "build.default")
				write_rule (borrow-mut (local rules)) (i32 12) (u32 2) (u32 1) (u32 3) (i32 71) (i32 78))
			(call write_four (borrow-mut (local names)) (i32 71) (u8 100) (u8 101) (u8 102) (u8 97))
			(slice.store (local names) (i32 75) (u8 117))
			(slice.store (local names) (i32 76) (u8 108))
			(slice.store (local names) (i32 77) (u8 116))

			(call
				(:doc "build.debug")
				write_rule (borrow-mut (local rules)) (i32 13) (u32 2) (u32 1) (u32 3) (i32 78) (i32 83))
			(call write_four (borrow-mut (local names)) (i32 78) (u8 100) (u8 101) (u8 98) (u8 117))
			(slice.store (local names) (i32 82) (u8 103))

			(call
				(:doc "build.release")
				write_rule (borrow-mut (local rules)) (i32 14) (u32 2) (u32 1) (u32 3) (i32 83) (i32 90))
			(call write_four (borrow-mut (local names)) (i32 83) (u8 114) (u8 101) (u8 108) (u8 101))
			(slice.store (local names) (i32 87) (u8 97))
			(slice.store (local names) (i32 88) (u8 115))
			(slice.store (local names) (i32 89) (u8 101))

			(call
				(:doc "build mode.cache")
				write_rule (borrow-mut (local rules)) (i32 15) (u32 3) (u32 3) (u32 0) (i32 90) (i32 95))
			(call write_four (borrow-mut (local names)) (i32 90) (u8 99) (u8 97) (u8 99) (u8 104))
			(slice.store (local names) (i32 94) (u8 101))

			(call
				(:doc "build mode.cflags")
				write_rule (borrow-mut (local rules)) (i32 16) (u32 3) (u32 6) (u32 0) (i32 95) (i32 101))
			(call write_four (borrow-mut (local names)) (i32 95) (u8 99) (u8 102) (u8 108) (u8 97))
			(slice.store (local names) (i32 99) (u8 103))
			(slice.store (local names) (i32 100) (u8 115))

			(call
				(:doc "build mode.defines")
				write_rule (borrow-mut (local rules)) (i32 17) (u32 3) (u32 6) (u32 0) (i32 101) (i32 108))
			(call write_four (borrow-mut (local names)) (i32 101) (u8 100) (u8 101) (u8 102) (u8 105))
			(slice.store (local names) (i32 105) (u8 110))
			(slice.store (local names) (i32 106) (u8 101))
			(slice.store (local names) (i32 107) (u8 115))

			(call
				(:doc "build mode.ldflags")
				write_rule (borrow-mut (local rules)) (i32 18) (u32 3) (u32 6) (u32 0) (i32 108) (i32 115))
			(call write_four (borrow-mut (local names)) (i32 108) (u8 108) (u8 100) (u8 102) (u8 108))
			(slice.store (local names) (i32 112) (u8 97))
			(slice.store (local names) (i32 113) (u8 103))
			(slice.store (local names) (i32 114) (u8 115))

			(call
				(:doc "build mode.ldlibs")
				write_rule (borrow-mut (local rules)) (i32 19) (u32 3) (u32 6) (u32 0) (i32 115) (i32 121))
			(call write_four (borrow-mut (local names)) (i32 115) (u8 108) (u8 100) (u8 108) (u8 105))
			(slice.store (local names) (i32 119) (u8 98))
			(slice.store (local names) (i32 120) (u8 115))

			(call
				(:doc "build mode.links")
				write_rule (borrow-mut (local rules)) (i32 20) (u32 3) (u32 6) (u32 0) (i32 121) (i32 126))
			(call write_four (borrow-mut (local names)) (i32 121) (u8 108) (u8 105) (u8 110) (u8 107))
			(slice.store (local names) (i32 125) (u8 115))

			(call
				(:doc "build mode.lto")
				write_rule (borrow-mut (local rules)) (i32 21) (u32 3) (u32 7) (u32 0) (i32 126) (i32 129))
			(slice.store (local names) (i32 126) (u8 108))
			(slice.store (local names) (i32 127) (u8 116))
			(slice.store (local names) (i32 128) (u8 111))

			(call
				(:doc "build mode.output")
				write_rule (borrow-mut (local rules)) (i32 22) (u32 3) (u32 8) (u32 0) (i32 129) (i32 135))
			(call write_four (borrow-mut (local names)) (i32 129) (u8 111) (u8 117) (u8 116) (u8 112))
			(slice.store (local names) (i32 133) (u8 117))
			(slice.store (local names) (i32 134) (u8 116))

			(call
				(:doc "cc.checkTests")
				write_rule (borrow-mut (local rules)) (i32 23) (u32 4) (u32 3) (u32 0) (i32 135) (i32 145))
			(call write_four (borrow-mut (local names)) (i32 135) (u8 99) (u8 104) (u8 101) (u8 99))
			(call write_four (borrow-mut (local names)) (i32 139) (u8 107) (u8 84) (u8 101) (u8 115))
			(slice.store (local names) (i32 143) (u8 116))
			(slice.store (local names) (i32 144) (u8 115))

			(call
				(:doc "cc.cstd")
				write_rule (borrow-mut (local rules)) (i32 24) (u32 4) (u32 9) (u32 0) (i32 145) (i32 149))
			(call write_four (borrow-mut (local names)) (i32 145) (u8 99) (u8 115) (u8 116) (u8 100))

			(call
				(:doc "cc.defines")
				write_rule (borrow-mut (local rules)) (i32 25) (u32 4) (u32 6) (u32 0) (i32 149) (i32 156))
			(call write_four (borrow-mut (local names)) (i32 149) (u8 100) (u8 101) (u8 102) (u8 105))
			(slice.store (local names) (i32 153) (u8 110))
			(slice.store (local names) (i32 154) (u8 101))
			(slice.store (local names) (i32 155) (u8 115))

			(call
				(:doc "cc.flat")
				write_rule (borrow-mut (local rules)) (i32 26) (u32 4) (u32 3) (u32 0) (i32 156) (i32 160))
			(call write_four (borrow-mut (local names)) (i32 156) (u8 102) (u8 108) (u8 97) (u8 116))

			(call
				(:doc "cc.skip")
				write_rule (borrow-mut (local rules)) (i32 27) (u32 4) (u32 6) (u32 0) (i32 160) (i32 164))
			(call write_four (borrow-mut (local names)) (i32 160) (u8 115) (u8 107) (u8 105) (u8 112))

			(call
				(:doc "cc.warn")
				write_rule (borrow-mut (local rules)) (i32 28) (u32 4) (u32 1) (u32 5) (i32 164) (i32 168))
			(call write_four (borrow-mut (local names)) (i32 164) (u8 119) (u8 97) (u8 114) (u8 110))

			(call
				(:doc "cc.warningsAsErrors")
				write_rule (borrow-mut (local rules)) (i32 29) (u32 4) (u32 3) (u32 0) (i32 168) (i32 184))
			(call write_four (borrow-mut (local names)) (i32 168) (u8 119) (u8 97) (u8 114) (u8 110))
			(call write_four (borrow-mut (local names)) (i32 172) (u8 105) (u8 110) (u8 103) (u8 115))
			(call write_four (borrow-mut (local names)) (i32 176) (u8 65) (u8 115) (u8 69) (u8 114))
			(call write_four (borrow-mut (local names)) (i32 180) (u8 114) (u8 111) (u8 114) (u8 115))

			(call
				(:doc "cc.warn.blockComments")
				write_rule (borrow-mut (local rules)) (i32 30) (u32 5) (u32 3) (u32 0) (i32 184) (i32 197))
			(call write_four (borrow-mut (local names)) (i32 184) (u8 98) (u8 108) (u8 111) (u8 99))
			(call write_four (borrow-mut (local names)) (i32 188) (u8 107) (u8 67) (u8 111) (u8 109))
			(call write_four (borrow-mut (local names)) (i32 192) (u8 109) (u8 101) (u8 110) (u8 116))
			(slice.store (local names) (i32 196) (u8 115))

			(call
				(:doc "cc.warn.inlineBlockComments")
				write_rule (borrow-mut (local rules)) (i32 31) (u32 5) (u32 3) (u32 0) (i32 197) (i32 216))
			(call write_four (borrow-mut (local names)) (i32 197) (u8 105) (u8 110) (u8 108) (u8 105))
			(call write_four (borrow-mut (local names)) (i32 201) (u8 110) (u8 101) (u8 66) (u8 108))
			(call write_four (borrow-mut (local names)) (i32 205) (u8 111) (u8 99) (u8 107) (u8 67))
			(call write_four (borrow-mut (local names)) (i32 209) (u8 111) (u8 109) (u8 109) (u8 101))
			(slice.store (local names) (i32 213) (u8 110))
			(slice.store (local names) (i32 214) (u8 116))
			(slice.store (local names) (i32 215) (u8 115))

			(call
				(:doc "cc.warn.unusedImports")
				write_rule (borrow-mut (local rules)) (i32 32) (u32 5) (u32 3) (u32 0) (i32 216) (i32 229))
			(call write_four (borrow-mut (local names)) (i32 216) (u8 117) (u8 110) (u8 117) (u8 115))
			(call write_four (borrow-mut (local names)) (i32 220) (u8 101) (u8 100) (u8 73) (u8 109))
			(call write_four (borrow-mut (local names)) (i32 224) (u8 112) (u8 111) (u8 114) (u8 116))
			(slice.store (local names) (i32 228) (u8 115))

			(call
				(:doc "cc.warn.unwrapComments")
				write_rule (borrow-mut (local rules)) (i32 33) (u32 5) (u32 3) (u32 0) (i32 229) (i32 243))
			(call write_four (borrow-mut (local names)) (i32 229) (u8 117) (u8 110) (u8 119) (u8 114))
			(call write_four (borrow-mut (local names)) (i32 233) (u8 97) (u8 112) (u8 67) (u8 111))
			(call write_four (borrow-mut (local names)) (i32 237) (u8 109) (u8 109) (u8 101) (u8 110))
			(slice.store (local names) (i32 241) (u8 116))
			(slice.store (local names) (i32 242) (u8 115))

			(call
				(:doc "entry.bin")
				write_rule (borrow-mut (local rules)) (i32 34) (u32 6) (u32 6) (u32 0) (i32 243) (i32 246))
			(slice.store (local names) (i32 243) (u8 98))
