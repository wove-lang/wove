(module project_schema
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Define the archive's project configuration fields.

	Scopes 0 through 7 identify the root, a profile, build, a build mode,
	cc, cc.warn, entry, and fmt. A row's start and end select its canonical
	key bytes. The child field selects the scope of an object.

	Kinds 1 and 3 are bool and u32 from the shared compiler descriptors.
	The project adds 5 profile name, 6 string array, 7 LTO mode,
	8 nullable string, 9 C standard,
	10 indent style, 11 line endings, 12 import order, 13 indent width,
	14 blank line count, 15 object, and 16 profile array.
	The checked-in default profile provides starting values for each command.`)

	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./compiler.wove" (only compiler_option_count compiler_names_width compiler_option write_compiler_names))

	(struct ProjectRule (fields (scope u32) (kind u32) (child u32) (start i32) (end i32)))

	(fn project_rule_count
		(:doc "Return the number of schema rows shared by the config reader and its consumers.")
		(params)
		(returns i32)
		(body (return (call project_compiler_rule (call compiler_option_count)))))

	(fn project_key_bytes
		(:doc "Return the packed byte capacity of the canonical schema keys.")
		(params)
		(returns i32)
		(body (return (i32.add.wrapping (call project_shared_key_start) (call compiler_names_width)))))

	(fn project_key_width
		(:doc "Return a capacity that can hold any decoded key in the schema.")
		(params)
		(returns i32)
		(body
			(let compiler_width (call compiler_names_width))
			(if
				(:doc "The whole compiler name table bounds each individual compiler key.")
				(i32.lt 28i32 (local compiler_width))
				(then (return (local compiler_width))))
			(return 28i32)))

	(fn write_four
		(:doc "Store four consecutive bytes of a known schema key.")
		(params (names (mut-slice u8)) (at i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(slice.store (local names) (local at) (local a))
			(slice.store (local names) (i32.add.wrapping (local at) 1i32) (local b))
			(slice.store (local names) (i32.add.wrapping (local at) 2i32) (local c))
			(slice.store (local names) (i32.add.wrapping (local at) 3i32) (local d))))

	(fn write_rule
		(:doc "Associate one key span with the required type and its containing scope.")
		(params (rules (mut-slice ProjectRule)) (row i32) (scope u32) (kind u32) (child u32) (start i32) (end i32))
		(returns void)
		(body (slice.store (local rules) (local row) (record.make ProjectRule
			(scope (local scope)) (kind (local kind)) (child (local child)) (start (local start)) (end (local end))))))

	(fn write_project_schema
		(:doc "Write the schema into views sized by project_rule_count and project_key_bytes.")
		(params (names (mut-slice u8)) (rules (mut-slice ProjectRule)))
		(returns void)
		(body
			(call
				(:doc "root.profiles")
				write_rule (borrow-mut (local rules)) 0i32 0u32 16u32 0u32 0i32 8i32)
			(call write_four (borrow-mut (local names)) 0i32 112u8 114u8 111u8 102u8)
			(call write_four (borrow-mut (local names)) 4i32 105u8 108u8 101u8 115u8)

			(call
				(:doc "profile.name")
				write_rule (borrow-mut (local rules)) 1i32 1u32 5u32 0u32 8i32 12i32)
			(call write_four (borrow-mut (local names)) 8i32 110u8 97u8 109u8 101u8)

			(call
				(:doc "profile.build")
				write_rule (borrow-mut (local rules)) 2i32 1u32 15u32 2u32 12i32 17i32)
			(call write_four (borrow-mut (local names)) 12i32 98u8 117u8 105u8 108u8)
			(slice.store (local names) 16i32 100u8)

			(call
				(:doc "profile.cc")
				write_rule (borrow-mut (local rules)) 3i32 1u32 15u32 4u32 17i32 19i32)
			(slice.store (local names) 17i32 99u8)
			(slice.store (local names) 18i32 99u8)

			(call
				(:doc "profile.entry")
				write_rule (borrow-mut (local rules)) 4i32 1u32 15u32 6u32 19i32 24i32)
			(call write_four (borrow-mut (local names)) 19i32 101u8 110u8 116u8 114u8)
			(slice.store (local names) 23i32 121u8)

			(call
				(:doc "profile.fmt")
				write_rule (borrow-mut (local rules)) 5i32 1u32 15u32 7u32 24i32 27i32)
			(slice.store (local names) 24i32 102u8)
			(slice.store (local names) 25i32 109u8)
			(slice.store (local names) 26i32 116u8)

			(call
				(:doc "profile.parallel")
				write_rule (borrow-mut (local rules)) 6i32 1u32 1u32 0u32 27i32 35i32)
			(call write_four (borrow-mut (local names)) 27i32 112u8 97u8 114u8 97u8)
			(call write_four (borrow-mut (local names)) 31i32 108u8 108u8 101u8 108u8)

			(call
				(:doc "profile.parallelJobs")
				write_rule (borrow-mut (local rules)) 7i32 1u32 3u32 0u32 35i32 47i32)
			(call write_four (borrow-mut (local names)) 35i32 112u8 97u8 114u8 97u8)
			(call write_four (borrow-mut (local names)) 39i32 108u8 108u8 101u8 108u8)
			(call write_four (borrow-mut (local names)) 43i32 74u8 111u8 98u8 115u8)

			(call
				(:doc "profile.time")
				write_rule (borrow-mut (local rules)) 8i32 1u32 1u32 0u32 47i32 51i32)
			(call write_four (borrow-mut (local names)) 47i32 116u8 105u8 109u8 101u8)

			(call
				(:doc "build.default")
				write_rule (borrow-mut (local rules)) 9i32 2u32 15u32 3u32 51i32 58i32)
			(call write_four (borrow-mut (local names)) 51i32 100u8 101u8 102u8 97u8)
			(slice.store (local names) 55i32 117u8)
			(slice.store (local names) 56i32 108u8)
			(slice.store (local names) 57i32 116u8)

			(call
				(:doc "build.debug")
				write_rule (borrow-mut (local rules)) 10i32 2u32 15u32 3u32 58i32 63i32)
			(call write_four (borrow-mut (local names)) 58i32 100u8 101u8 98u8 117u8)
			(slice.store (local names) 62i32 103u8)

			(call
				(:doc "build.release")
				write_rule (borrow-mut (local rules)) 11i32 2u32 15u32 3u32 63i32 70i32)
			(call write_four (borrow-mut (local names)) 63i32 114u8 101u8 108u8 101u8)
			(slice.store (local names) 67i32 97u8)
			(slice.store (local names) 68i32 115u8)
			(slice.store (local names) 69i32 101u8)

			(call
				(:doc "build mode.cache")
				write_rule (borrow-mut (local rules)) 12i32 3u32 1u32 0u32 70i32 75i32)
			(call write_four (borrow-mut (local names)) 70i32 99u8 97u8 99u8 104u8)
			(slice.store (local names) 74i32 101u8)

			(call
				(:doc "build mode.cflags")
				write_rule (borrow-mut (local rules)) 13i32 3u32 6u32 0u32 75i32 81i32)
			(call write_four (borrow-mut (local names)) 75i32 99u8 102u8 108u8 97u8)
			(slice.store (local names) 79i32 103u8)
			(slice.store (local names) 80i32 115u8)

			(call
				(:doc "build mode.defines")
				write_rule (borrow-mut (local rules)) 14i32 3u32 6u32 0u32 81i32 88i32)
			(call write_four (borrow-mut (local names)) 81i32 100u8 101u8 102u8 105u8)
			(slice.store (local names) 85i32 110u8)
			(slice.store (local names) 86i32 101u8)
			(slice.store (local names) 87i32 115u8)

			(call
				(:doc "build mode.ldflags")
				write_rule (borrow-mut (local rules)) 15i32 3u32 6u32 0u32 88i32 95i32)
			(call write_four (borrow-mut (local names)) 88i32 108u8 100u8 102u8 108u8)
			(slice.store (local names) 92i32 97u8)
			(slice.store (local names) 93i32 103u8)
			(slice.store (local names) 94i32 115u8)

			(call
				(:doc "build mode.ldlibs")
				write_rule (borrow-mut (local rules)) 16i32 3u32 6u32 0u32 95i32 101i32)
			(call write_four (borrow-mut (local names)) 95i32 108u8 100u8 108u8 105u8)
			(slice.store (local names) 99i32 98u8)
			(slice.store (local names) 100i32 115u8)

			(call
				(:doc "build mode.links")
				write_rule (borrow-mut (local rules)) 17i32 3u32 6u32 0u32 101i32 106i32)
			(call write_four (borrow-mut (local names)) 101i32 108u8 105u8 110u8 107u8)
			(slice.store (local names) 105i32 115u8)

			(call
				(:doc "build mode.lto")
				write_rule (borrow-mut (local rules)) 18i32 3u32 7u32 0u32 106i32 109i32)
			(slice.store (local names) 106i32 108u8)
			(slice.store (local names) 107i32 116u8)
			(slice.store (local names) 108i32 111u8)

			(call
				(:doc "build mode.output")
				write_rule (borrow-mut (local rules)) 19i32 3u32 8u32 0u32 109i32 115i32)
			(call write_four (borrow-mut (local names)) 109i32 111u8 117u8 116u8 112u8)
			(slice.store (local names) 113i32 117u8)
			(slice.store (local names) 114i32 116u8)

			(call
				(:doc "cc.checkTests")
				write_rule (borrow-mut (local rules)) 20i32 4u32 1u32 0u32 115i32 125i32)
			(call write_four (borrow-mut (local names)) 115i32 99u8 104u8 101u8 99u8)
			(call write_four (borrow-mut (local names)) 119i32 107u8 84u8 101u8 115u8)
			(slice.store (local names) 123i32 116u8)
			(slice.store (local names) 124i32 115u8)

			(call
				(:doc "cc.cstd")
				write_rule (borrow-mut (local rules)) 21i32 4u32 9u32 0u32 125i32 129i32)
			(call write_four (borrow-mut (local names)) 125i32 99u8 115u8 116u8 100u8)

			(call
				(:doc "cc.defines")
				write_rule (borrow-mut (local rules)) 22i32 4u32 6u32 0u32 129i32 136i32)
			(call write_four (borrow-mut (local names)) 129i32 100u8 101u8 102u8 105u8)
			(slice.store (local names) 133i32 110u8)
			(slice.store (local names) 134i32 101u8)
			(slice.store (local names) 135i32 115u8)

			(call
				(:doc "cc.flat")
				write_rule (borrow-mut (local rules)) 23i32 4u32 1u32 0u32 136i32 140i32)
			(call write_four (borrow-mut (local names)) 136i32 102u8 108u8 97u8 116u8)

			(call
				(:doc "cc.skip")
				write_rule (borrow-mut (local rules)) 24i32 4u32 6u32 0u32 140i32 144i32)
			(call write_four (borrow-mut (local names)) 140i32 115u8 107u8 105u8 112u8)

			(call
				(:doc "cc.warn")
				write_rule (borrow-mut (local rules)) 25i32 4u32 15u32 5u32 144i32 148i32)
			(call write_four (borrow-mut (local names)) 144i32 119u8 97u8 114u8 110u8)

			(call
				(:doc "cc.warningsAsErrors")
				write_rule (borrow-mut (local rules)) 26i32 4u32 1u32 0u32 148i32 164i32)
			(call write_four (borrow-mut (local names)) 148i32 119u8 97u8 114u8 110u8)
			(call write_four (borrow-mut (local names)) 152i32 105u8 110u8 103u8 115u8)
			(call write_four (borrow-mut (local names)) 156i32 65u8 115u8 69u8 114u8)
			(call write_four (borrow-mut (local names)) 160i32 114u8 111u8 114u8 115u8)

			(call
				(:doc "cc.warn.blockComments")
				write_rule (borrow-mut (local rules)) 27i32 5u32 1u32 0u32 164i32 177i32)
			(call write_four (borrow-mut (local names)) 164i32 98u8 108u8 111u8 99u8)
			(call write_four (borrow-mut (local names)) 168i32 107u8 67u8 111u8 109u8)
			(call write_four (borrow-mut (local names)) 172i32 109u8 101u8 110u8 116u8)
			(slice.store (local names) 176i32 115u8)

			(call
				(:doc "cc.warn.inlineBlockComments")
				write_rule (borrow-mut (local rules)) 28i32 5u32 1u32 0u32 177i32 196i32)
			(call write_four (borrow-mut (local names)) 177i32 105u8 110u8 108u8 105u8)
			(call write_four (borrow-mut (local names)) 181i32 110u8 101u8 66u8 108u8)
			(call write_four (borrow-mut (local names)) 185i32 111u8 99u8 107u8 67u8)
			(call write_four (borrow-mut (local names)) 189i32 111u8 109u8 109u8 101u8)
			(slice.store (local names) 193i32 110u8)
			(slice.store (local names) 194i32 116u8)
			(slice.store (local names) 195i32 115u8)

			(call
				(:doc "cc.warn.unusedImports")
				write_rule (borrow-mut (local rules)) 29i32 5u32 1u32 0u32 196i32 209i32)
			(call write_four (borrow-mut (local names)) 196i32 117u8 110u8 117u8 115u8)
			(call write_four (borrow-mut (local names)) 200i32 101u8 100u8 73u8 109u8)
			(call write_four (borrow-mut (local names)) 204i32 112u8 111u8 114u8 116u8)
			(slice.store (local names) 208i32 115u8)

			(call
				(:doc "cc.warn.unwrapComments")
				write_rule (borrow-mut (local rules)) 30i32 5u32 1u32 0u32 209i32 223i32)
			(call write_four (borrow-mut (local names)) 209i32 117u8 110u8 119u8 114u8)
			(call write_four (borrow-mut (local names)) 213i32 97u8 112u8 67u8 111u8)
			(call write_four (borrow-mut (local names)) 217i32 109u8 109u8 101u8 110u8)
			(slice.store (local names) 221i32 116u8)
			(slice.store (local names) 222i32 115u8)

			(call
				(:doc "entry.bin")
				write_rule (borrow-mut (local rules)) 31i32 6u32 6u32 0u32 223i32 226i32)
			(slice.store (local names) 223i32 98u8)
			(slice.store (local names) 224i32 105u8)
			(slice.store (local names) 225i32 110u8)

			(call
				(:doc "entry.lib")
				write_rule (borrow-mut (local rules)) 32i32 6u32 6u32 0u32 226i32 229i32)
			(slice.store (local names) 226i32 108u8)
			(slice.store (local names) 227i32 105u8)
			(slice.store (local names) 228i32 98u8)

			(call
				(:doc "fmt.blankLines")
				write_rule (borrow-mut (local rules)) 33i32 7u32 14u32 0u32 229i32 239i32)
			(call write_four (borrow-mut (local names)) 229i32 98u8 108u8 97u8 110u8)
			(call write_four (borrow-mut (local names)) 233i32 107u8 76u8 105u8 110u8)
			(slice.store (local names) 237i32 101u8)
			(slice.store (local names) 238i32 115u8)

			(call
				(:doc "fmt.bridgeComments")
				write_rule (borrow-mut (local rules)) 34i32 7u32 1u32 0u32 239i32 253i32)
			(call write_four (borrow-mut (local names)) 239i32 98u8 114u8 105u8 100u8)
			(call write_four (borrow-mut (local names)) 243i32 103u8 101u8 67u8 111u8)
			(call write_four (borrow-mut (local names)) 247i32 109u8 109u8 101u8 110u8)
			(slice.store (local names) 251i32 116u8)
			(slice.store (local names) 252i32 115u8)

			(call
				(:doc "fmt.caseSensitive")
				write_rule (borrow-mut (local rules)) 35i32 7u32 1u32 0u32 253i32 266i32)
			(call write_four (borrow-mut (local names)) 253i32 99u8 97u8 115u8 101u8)
			(call write_four (borrow-mut (local names)) 257i32 83u8 101u8 110u8 115u8)
			(call write_four (borrow-mut (local names)) 261i32 105u8 116u8 105u8 118u8)
			(slice.store (local names) 265i32 101u8)

			(call
				(:doc "fmt.checkFormatting")
				write_rule (borrow-mut (local rules)) 36i32 7u32 1u32 0u32 266i32 281i32)
			(call write_four (borrow-mut (local names)) 266i32 99u8 104u8 101u8 99u8)
			(call write_four (borrow-mut (local names)) 270i32 107u8 70u8 111u8 114u8)
			(call write_four (borrow-mut (local names)) 274i32 109u8 97u8 116u8 116u8)
			(slice.store (local names) 278i32 105u8)
			(slice.store (local names) 279i32 110u8)
			(slice.store (local names) 280i32 103u8)

			(call
				(:doc "fmt.checkWidth")
				write_rule (borrow-mut (local rules)) 37i32 7u32 1u32 0u32 281i32 291i32)
			(call write_four (borrow-mut (local names)) 281i32 99u8 104u8 101u8 99u8)
			(call write_four (borrow-mut (local names)) 285i32 107u8 87u8 105u8 100u8)
			(slice.store (local names) 289i32 116u8)
			(slice.store (local names) 290i32 104u8)

			(call
				(:doc "fmt.delimiterLayout")
				write_rule (borrow-mut (local rules)) 38i32 7u32 1u32 0u32 291i32 306i32)
			(call write_four (borrow-mut (local names)) 291i32 100u8 101u8 108u8 105u8)
			(call write_four (borrow-mut (local names)) 295i32 109u8 105u8 116u8 101u8)
			(call write_four (borrow-mut (local names)) 299i32 114u8 76u8 97u8 121u8)
			(slice.store (local names) 303i32 111u8)
			(slice.store (local names) 304i32 117u8)
			(slice.store (local names) 305i32 116u8)

			(call
				(:doc "fmt.duplicateImports")
				write_rule (borrow-mut (local rules)) 39i32 7u32 1u32 0u32 306i32 322i32)
			(call write_four (borrow-mut (local names)) 306i32 100u8 117u8 112u8 108u8)
			(call write_four (borrow-mut (local names)) 310i32 105u8 99u8 97u8 116u8)
			(call write_four (borrow-mut (local names)) 314i32 101u8 73u8 109u8 112u8)
			(call write_four (borrow-mut (local names)) 318i32 111u8 114u8 116u8 115u8)

			(call
				(:doc "fmt.expandInlineBlocks")
