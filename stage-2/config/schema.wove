(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Define the archive's project configuration fields.

	Scopes 0 through 7 identify the root, a profile, build, a build mode,
	cc, cc.warn, entry, and fmt. A row's start and end select its canonical
	key bytes. The child field selects the scope of an object.

	Kinds 1 and 3 are bool and u32 from the shared compiler descriptors.
	The project adds 5 profile name, 6 string array, 7 LTO mode,
	8 nullable string, 9 C standard,
	10 indent style, 11 line endings, 12 import order, 13 indent width,
	14 blank line count, 15 object, and 16 profile array.
	The checked-in default profile provides starting values for each command.`)
	project_schema

	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./compiler.wove" (only compiler_option_count compiler_names_width compiler_option write_compiler_names))

	(struct ProjectRule (fields (scope u32) (kind u32) (child u32) (start i32) (end i32)))

	(fn
		(:doc "Return the number of schema rows shared by the config reader and its consumers.")
		project_rule_count
		(params)
		(returns i32)
		(body (return (call project_compiler_rule (call compiler_option_count)))))

	(fn
		(:doc "Return the packed byte capacity of the canonical schema keys.")
		project_key_bytes
		(params)
		(returns i32)
		(body (return (i32.add.wrapping (call project_shared_key_start) (call compiler_names_width)))))

	(fn
		(:doc "Return a capacity that can hold any decoded key in the schema.")
		project_key_width
		(params)
		(returns i32)
		(body
			(let compiler_width (call compiler_names_width))
			(if
				(:doc "The whole compiler name table bounds each individual compiler key.")
				(i32.lt (i32 28) (local compiler_width))
				(then (return (local compiler_width))))
			(return (i32 28))))

	(fn
		(:doc "Store four consecutive bytes of a known schema key.")
		write_four
		(params (names (mut-slice u8)) (at i32) (a u8) (b u8) (c u8) (d u8))
		(returns void)
		(body
			(slice.store (local names) (local at) (local a))
			(slice.store (local names) (i32.add.wrapping (local at) (i32 1)) (local b))
			(slice.store (local names) (i32.add.wrapping (local at) (i32 2)) (local c))
			(slice.store (local names) (i32.add.wrapping (local at) (i32 3)) (local d))))

	(fn
		(:doc "Associate one key span with the required type and its containing scope.")
		write_rule
		(params (rules (mut-slice ProjectRule)) (row i32) (scope u32) (kind u32) (child u32) (start i32) (end i32))
		(returns void)
		(body (slice.store (local rules) (local row) (record.make ProjectRule
			(scope (local scope)) (kind (local kind)) (child (local child)) (start (local start)) (end (local end))))))

	(fn
		(:doc "Write the schema into views sized by project_rule_count and project_key_bytes.")
		write_project_schema
		(params (names (mut-slice u8)) (rules (mut-slice ProjectRule)))
		(returns void)
		(body
			(call
				(:doc "root.profiles")
				write_rule (borrow-mut (local rules)) (i32 0) (u32 0) (u32 16) (u32 0) (i32 0) (i32 8))
			(call write_four (borrow-mut (local names)) (i32 0) (u8 112) (u8 114) (u8 111) (u8 102))
			(call write_four (borrow-mut (local names)) (i32 4) (u8 105) (u8 108) (u8 101) (u8 115))

			(call
				(:doc "profile.name")
				write_rule (borrow-mut (local rules)) (i32 1) (u32 1) (u32 5) (u32 0) (i32 8) (i32 12))
			(call write_four (borrow-mut (local names)) (i32 8) (u8 110) (u8 97) (u8 109) (u8 101))

			(call
				(:doc "profile.build")
				write_rule (borrow-mut (local rules)) (i32 2) (u32 1) (u32 15) (u32 2) (i32 12) (i32 17))
			(call write_four (borrow-mut (local names)) (i32 12) (u8 98) (u8 117) (u8 105) (u8 108))
			(slice.store (local names) (i32 16) (u8 100))

			(call
				(:doc "profile.cc")
				write_rule (borrow-mut (local rules)) (i32 3) (u32 1) (u32 15) (u32 4) (i32 17) (i32 19))
			(slice.store (local names) (i32 17) (u8 99))
			(slice.store (local names) (i32 18) (u8 99))

			(call
				(:doc "profile.entry")
				write_rule (borrow-mut (local rules)) (i32 4) (u32 1) (u32 15) (u32 6) (i32 19) (i32 24))
			(call write_four (borrow-mut (local names)) (i32 19) (u8 101) (u8 110) (u8 116) (u8 114))
			(slice.store (local names) (i32 23) (u8 121))

			(call
				(:doc "profile.fmt")
				write_rule (borrow-mut (local rules)) (i32 5) (u32 1) (u32 15) (u32 7) (i32 24) (i32 27))
			(slice.store (local names) (i32 24) (u8 102))
			(slice.store (local names) (i32 25) (u8 109))
			(slice.store (local names) (i32 26) (u8 116))

			(call
				(:doc "profile.parallel")
				write_rule (borrow-mut (local rules)) (i32 6) (u32 1) (u32 1) (u32 0) (i32 27) (i32 35))
			(call write_four (borrow-mut (local names)) (i32 27) (u8 112) (u8 97) (u8 114) (u8 97))
			(call write_four (borrow-mut (local names)) (i32 31) (u8 108) (u8 108) (u8 101) (u8 108))

			(call
				(:doc "profile.parallelJobs")
				write_rule (borrow-mut (local rules)) (i32 7) (u32 1) (u32 3) (u32 0) (i32 35) (i32 47))
			(call write_four (borrow-mut (local names)) (i32 35) (u8 112) (u8 97) (u8 114) (u8 97))
			(call write_four (borrow-mut (local names)) (i32 39) (u8 108) (u8 108) (u8 101) (u8 108))
			(call write_four (borrow-mut (local names)) (i32 43) (u8 74) (u8 111) (u8 98) (u8 115))

			(call
				(:doc "profile.time")
				write_rule (borrow-mut (local rules)) (i32 8) (u32 1) (u32 1) (u32 0) (i32 47) (i32 51))
			(call write_four (borrow-mut (local names)) (i32 47) (u8 116) (u8 105) (u8 109) (u8 101))

			(call
				(:doc "build.default")
				write_rule (borrow-mut (local rules)) (i32 9) (u32 2) (u32 15) (u32 3) (i32 51) (i32 58))
			(call write_four (borrow-mut (local names)) (i32 51) (u8 100) (u8 101) (u8 102) (u8 97))
			(slice.store (local names) (i32 55) (u8 117))
			(slice.store (local names) (i32 56) (u8 108))
			(slice.store (local names) (i32 57) (u8 116))

			(call
				(:doc "build.debug")
				write_rule (borrow-mut (local rules)) (i32 10) (u32 2) (u32 15) (u32 3) (i32 58) (i32 63))
			(call write_four (borrow-mut (local names)) (i32 58) (u8 100) (u8 101) (u8 98) (u8 117))
			(slice.store (local names) (i32 62) (u8 103))

			(call
				(:doc "build.release")
				write_rule (borrow-mut (local rules)) (i32 11) (u32 2) (u32 15) (u32 3) (i32 63) (i32 70))
			(call write_four (borrow-mut (local names)) (i32 63) (u8 114) (u8 101) (u8 108) (u8 101))
			(slice.store (local names) (i32 67) (u8 97))
			(slice.store (local names) (i32 68) (u8 115))
			(slice.store (local names) (i32 69) (u8 101))

			(call
				(:doc "build mode.cache")
				write_rule (borrow-mut (local rules)) (i32 12) (u32 3) (u32 1) (u32 0) (i32 70) (i32 75))
			(call write_four (borrow-mut (local names)) (i32 70) (u8 99) (u8 97) (u8 99) (u8 104))
			(slice.store (local names) (i32 74) (u8 101))

			(call
				(:doc "build mode.cflags")
				write_rule (borrow-mut (local rules)) (i32 13) (u32 3) (u32 6) (u32 0) (i32 75) (i32 81))
			(call write_four (borrow-mut (local names)) (i32 75) (u8 99) (u8 102) (u8 108) (u8 97))
			(slice.store (local names) (i32 79) (u8 103))
			(slice.store (local names) (i32 80) (u8 115))

			(call
				(:doc "build mode.defines")
				write_rule (borrow-mut (local rules)) (i32 14) (u32 3) (u32 6) (u32 0) (i32 81) (i32 88))
			(call write_four (borrow-mut (local names)) (i32 81) (u8 100) (u8 101) (u8 102) (u8 105))
			(slice.store (local names) (i32 85) (u8 110))
			(slice.store (local names) (i32 86) (u8 101))
			(slice.store (local names) (i32 87) (u8 115))

			(call
				(:doc "build mode.ldflags")
				write_rule (borrow-mut (local rules)) (i32 15) (u32 3) (u32 6) (u32 0) (i32 88) (i32 95))
			(call write_four (borrow-mut (local names)) (i32 88) (u8 108) (u8 100) (u8 102) (u8 108))
			(slice.store (local names) (i32 92) (u8 97))
			(slice.store (local names) (i32 93) (u8 103))
			(slice.store (local names) (i32 94) (u8 115))

			(call
				(:doc "build mode.ldlibs")
				write_rule (borrow-mut (local rules)) (i32 16) (u32 3) (u32 6) (u32 0) (i32 95) (i32 101))
			(call write_four (borrow-mut (local names)) (i32 95) (u8 108) (u8 100) (u8 108) (u8 105))
			(slice.store (local names) (i32 99) (u8 98))
			(slice.store (local names) (i32 100) (u8 115))

			(call
				(:doc "build mode.links")
				write_rule (borrow-mut (local rules)) (i32 17) (u32 3) (u32 6) (u32 0) (i32 101) (i32 106))
			(call write_four (borrow-mut (local names)) (i32 101) (u8 108) (u8 105) (u8 110) (u8 107))
			(slice.store (local names) (i32 105) (u8 115))

			(call
				(:doc "build mode.lto")
				write_rule (borrow-mut (local rules)) (i32 18) (u32 3) (u32 7) (u32 0) (i32 106) (i32 109))
			(slice.store (local names) (i32 106) (u8 108))
			(slice.store (local names) (i32 107) (u8 116))
			(slice.store (local names) (i32 108) (u8 111))

			(call
				(:doc "build mode.output")
				write_rule (borrow-mut (local rules)) (i32 19) (u32 3) (u32 8) (u32 0) (i32 109) (i32 115))
			(call write_four (borrow-mut (local names)) (i32 109) (u8 111) (u8 117) (u8 116) (u8 112))
			(slice.store (local names) (i32 113) (u8 117))
			(slice.store (local names) (i32 114) (u8 116))

			(call
				(:doc "cc.checkTests")
				write_rule (borrow-mut (local rules)) (i32 20) (u32 4) (u32 1) (u32 0) (i32 115) (i32 125))
			(call write_four (borrow-mut (local names)) (i32 115) (u8 99) (u8 104) (u8 101) (u8 99))
			(call write_four (borrow-mut (local names)) (i32 119) (u8 107) (u8 84) (u8 101) (u8 115))
			(slice.store (local names) (i32 123) (u8 116))
			(slice.store (local names) (i32 124) (u8 115))

			(call
				(:doc "cc.cstd")
				write_rule (borrow-mut (local rules)) (i32 21) (u32 4) (u32 9) (u32 0) (i32 125) (i32 129))
			(call write_four (borrow-mut (local names)) (i32 125) (u8 99) (u8 115) (u8 116) (u8 100))

			(call
				(:doc "cc.defines")
				write_rule (borrow-mut (local rules)) (i32 22) (u32 4) (u32 6) (u32 0) (i32 129) (i32 136))
			(call write_four (borrow-mut (local names)) (i32 129) (u8 100) (u8 101) (u8 102) (u8 105))
			(slice.store (local names) (i32 133) (u8 110))
			(slice.store (local names) (i32 134) (u8 101))
			(slice.store (local names) (i32 135) (u8 115))

			(call
				(:doc "cc.flat")
				write_rule (borrow-mut (local rules)) (i32 23) (u32 4) (u32 1) (u32 0) (i32 136) (i32 140))
			(call write_four (borrow-mut (local names)) (i32 136) (u8 102) (u8 108) (u8 97) (u8 116))

			(call
				(:doc "cc.skip")
				write_rule (borrow-mut (local rules)) (i32 24) (u32 4) (u32 6) (u32 0) (i32 140) (i32 144))
			(call write_four (borrow-mut (local names)) (i32 140) (u8 115) (u8 107) (u8 105) (u8 112))

			(call
				(:doc "cc.warn")
				write_rule (borrow-mut (local rules)) (i32 25) (u32 4) (u32 15) (u32 5) (i32 144) (i32 148))
			(call write_four (borrow-mut (local names)) (i32 144) (u8 119) (u8 97) (u8 114) (u8 110))

			(call
				(:doc "cc.warningsAsErrors")
				write_rule (borrow-mut (local rules)) (i32 26) (u32 4) (u32 1) (u32 0) (i32 148) (i32 164))
			(call write_four (borrow-mut (local names)) (i32 148) (u8 119) (u8 97) (u8 114) (u8 110))
			(call write_four (borrow-mut (local names)) (i32 152) (u8 105) (u8 110) (u8 103) (u8 115))
			(call write_four (borrow-mut (local names)) (i32 156) (u8 65) (u8 115) (u8 69) (u8 114))
			(call write_four (borrow-mut (local names)) (i32 160) (u8 114) (u8 111) (u8 114) (u8 115))

			(call
				(:doc "cc.warn.blockComments")
				write_rule (borrow-mut (local rules)) (i32 27) (u32 5) (u32 1) (u32 0) (i32 164) (i32 177))
			(call write_four (borrow-mut (local names)) (i32 164) (u8 98) (u8 108) (u8 111) (u8 99))
			(call write_four (borrow-mut (local names)) (i32 168) (u8 107) (u8 67) (u8 111) (u8 109))
			(call write_four (borrow-mut (local names)) (i32 172) (u8 109) (u8 101) (u8 110) (u8 116))
			(slice.store (local names) (i32 176) (u8 115))

			(call
				(:doc "cc.warn.inlineBlockComments")
				write_rule (borrow-mut (local rules)) (i32 28) (u32 5) (u32 1) (u32 0) (i32 177) (i32 196))
			(call write_four (borrow-mut (local names)) (i32 177) (u8 105) (u8 110) (u8 108) (u8 105))
			(call write_four (borrow-mut (local names)) (i32 181) (u8 110) (u8 101) (u8 66) (u8 108))
			(call write_four (borrow-mut (local names)) (i32 185) (u8 111) (u8 99) (u8 107) (u8 67))
			(call write_four (borrow-mut (local names)) (i32 189) (u8 111) (u8 109) (u8 109) (u8 101))
			(slice.store (local names) (i32 193) (u8 110))
			(slice.store (local names) (i32 194) (u8 116))
			(slice.store (local names) (i32 195) (u8 115))

			(call
				(:doc "cc.warn.unusedImports")
				write_rule (borrow-mut (local rules)) (i32 29) (u32 5) (u32 1) (u32 0) (i32 196) (i32 209))
			(call write_four (borrow-mut (local names)) (i32 196) (u8 117) (u8 110) (u8 117) (u8 115))
			(call write_four (borrow-mut (local names)) (i32 200) (u8 101) (u8 100) (u8 73) (u8 109))
			(call write_four (borrow-mut (local names)) (i32 204) (u8 112) (u8 111) (u8 114) (u8 116))
			(slice.store (local names) (i32 208) (u8 115))

			(call
				(:doc "cc.warn.unwrapComments")
				write_rule (borrow-mut (local rules)) (i32 30) (u32 5) (u32 1) (u32 0) (i32 209) (i32 223))
			(call write_four (borrow-mut (local names)) (i32 209) (u8 117) (u8 110) (u8 119) (u8 114))
			(call write_four (borrow-mut (local names)) (i32 213) (u8 97) (u8 112) (u8 67) (u8 111))
			(call write_four (borrow-mut (local names)) (i32 217) (u8 109) (u8 109) (u8 101) (u8 110))
			(slice.store (local names) (i32 221) (u8 116))
			(slice.store (local names) (i32 222) (u8 115))

			(call
				(:doc "entry.bin")
				write_rule (borrow-mut (local rules)) (i32 31) (u32 6) (u32 6) (u32 0) (i32 223) (i32 226))
			(slice.store (local names) (i32 223) (u8 98))
			(slice.store (local names) (i32 224) (u8 105))
			(slice.store (local names) (i32 225) (u8 110))

			(call
				(:doc "entry.lib")
				write_rule (borrow-mut (local rules)) (i32 32) (u32 6) (u32 6) (u32 0) (i32 226) (i32 229))
			(slice.store (local names) (i32 226) (u8 108))
			(slice.store (local names) (i32 227) (u8 105))
			(slice.store (local names) (i32 228) (u8 98))

			(call
				(:doc "fmt.blankLines")
				write_rule (borrow-mut (local rules)) (i32 33) (u32 7) (u32 14) (u32 0) (i32 229) (i32 239))
			(call write_four (borrow-mut (local names)) (i32 229) (u8 98) (u8 108) (u8 97) (u8 110))
			(call write_four (borrow-mut (local names)) (i32 233) (u8 107) (u8 76) (u8 105) (u8 110))
			(slice.store (local names) (i32 237) (u8 101))
			(slice.store (local names) (i32 238) (u8 115))

			(call
				(:doc "fmt.bridgeComments")
				write_rule (borrow-mut (local rules)) (i32 34) (u32 7) (u32 1) (u32 0) (i32 239) (i32 253))
			(call write_four (borrow-mut (local names)) (i32 239) (u8 98) (u8 114) (u8 105) (u8 100))
			(call write_four (borrow-mut (local names)) (i32 243) (u8 103) (u8 101) (u8 67) (u8 111))
			(call write_four (borrow-mut (local names)) (i32 247) (u8 109) (u8 109) (u8 101) (u8 110))
			(slice.store (local names) (i32 251) (u8 116))
			(slice.store (local names) (i32 252) (u8 115))

			(call
				(:doc "fmt.caseSensitive")
				write_rule (borrow-mut (local rules)) (i32 35) (u32 7) (u32 1) (u32 0) (i32 253) (i32 266))
			(call write_four (borrow-mut (local names)) (i32 253) (u8 99) (u8 97) (u8 115) (u8 101))
			(call write_four (borrow-mut (local names)) (i32 257) (u8 83) (u8 101) (u8 110) (u8 115))
			(call write_four (borrow-mut (local names)) (i32 261) (u8 105) (u8 116) (u8 105) (u8 118))
			(slice.store (local names) (i32 265) (u8 101))

			(call
				(:doc "fmt.checkFormatting")
				write_rule (borrow-mut (local rules)) (i32 36) (u32 7) (u32 1) (u32 0) (i32 266) (i32 281))
			(call write_four (borrow-mut (local names)) (i32 266) (u8 99) (u8 104) (u8 101) (u8 99))
			(call write_four (borrow-mut (local names)) (i32 270) (u8 107) (u8 70) (u8 111) (u8 114))
			(call write_four (borrow-mut (local names)) (i32 274) (u8 109) (u8 97) (u8 116) (u8 116))
			(slice.store (local names) (i32 278) (u8 105))
			(slice.store (local names) (i32 279) (u8 110))
			(slice.store (local names) (i32 280) (u8 103))

			(call
				(:doc "fmt.checkWidth")
				write_rule (borrow-mut (local rules)) (i32 37) (u32 7) (u32 1) (u32 0) (i32 281) (i32 291))
			(call write_four (borrow-mut (local names)) (i32 281) (u8 99) (u8 104) (u8 101) (u8 99))
			(call write_four (borrow-mut (local names)) (i32 285) (u8 107) (u8 87) (u8 105) (u8 100))
			(slice.store (local names) (i32 289) (u8 116))
			(slice.store (local names) (i32 290) (u8 104))

			(call
				(:doc "fmt.delimiterLayout")
				write_rule (borrow-mut (local rules)) (i32 38) (u32 7) (u32 1) (u32 0) (i32 291) (i32 306))
			(call write_four (borrow-mut (local names)) (i32 291) (u8 100) (u8 101) (u8 108) (u8 105))
			(call write_four (borrow-mut (local names)) (i32 295) (u8 109) (u8 105) (u8 116) (u8 101))
			(call write_four (borrow-mut (local names)) (i32 299) (u8 114) (u8 76) (u8 97) (u8 121))
			(slice.store (local names) (i32 303) (u8 111))
			(slice.store (local names) (i32 304) (u8 117))
			(slice.store (local names) (i32 305) (u8 116))

			(call
				(:doc "fmt.duplicateImports")
				write_rule (borrow-mut (local rules)) (i32 39) (u32 7) (u32 1) (u32 0) (i32 306) (i32 322))
			(call write_four (borrow-mut (local names)) (i32 306) (u8 100) (u8 117) (u8 112) (u8 108))
			(call write_four (borrow-mut (local names)) (i32 310) (u8 105) (u8 99) (u8 97) (u8 116))
			(call write_four (borrow-mut (local names)) (i32 314) (u8 101) (u8 73) (u8 109) (u8 112))
			(call write_four (borrow-mut (local names)) (i32 318) (u8 111) (u8 114) (u8 116) (u8 115))

			(call
				(:doc "fmt.expandInlineBlocks")
				write_rule (borrow-mut (local rules)) (i32 40) (u32 7) (u32 1) (u32 0) (i32 322) (i32 340))
			(call write_four (borrow-mut (local names)) (i32 322) (u8 101) (u8 120) (u8 112) (u8 97))
			(call write_four (borrow-mut (local names)) (i32 326) (u8 110) (u8 100) (u8 73) (u8 110))
			(call write_four (borrow-mut (local names)) (i32 330) (u8 108) (u8 105) (u8 110) (u8 101))
			(call write_four (borrow-mut (local names)) (i32 334) (u8 66) (u8 108) (u8 111) (u8 99))
			(slice.store (local names) (i32 338) (u8 107))
			(slice.store (local names) (i32 339) (u8 115))

			(call
				(:doc "fmt.finalNewline")
