				write_rule (borrow-mut (local rules)) 46i32 7u32 10u32 0u32 419i32 425i32)
			(call write_four (borrow-mut (local names)) 419i32 105u8 110u8 100u8 101u8)
			(slice.store (local names) 423i32 110u8)
			(slice.store (local names) 424i32 116u8)

			(call
				(:doc "fmt.indentWidth")
				write_rule (borrow-mut (local rules)) 47i32 7u32 13u32 0u32 425i32 436i32)
			(call write_four (borrow-mut (local names)) 425i32 105u8 110u8 100u8 101u8)
			(call write_four (borrow-mut (local names)) 429i32 110u8 116u8 87u8 105u8)
			(slice.store (local names) 433i32 100u8)
