(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Supply built-in option values when neither argv nor the project profiles has a setting.")
	project_defaults

	(use wove-file "./compiler.wove" (only compiler_defaults))
	(use wove-file "./schema.wove" (only project_compiler_rule))

	(fn
		(:doc "Represent a boolean as the scalar stored by project and command settings.")
		option_bool_scalar
		(params (value bool))
		(returns u32)
		(body
			(if
				(:doc "An enabled option has scalar one.")
				(local value)
				(then (return (u32 1))))
			(return (u32 0))))

	(fn
		(:doc "Return the built-in scalar for a project rule and the selected build mode.")
		project_default_scalar
		(params (rule i32) (mode u32))
		(returns u32)
		(body
			(let compiler (call compiler_defaults))
			(if
				(:doc "The compiler's shared options retain their existing defaults.")
				(i32.eq (local rule) (call project_compiler_rule (i32 0)))
				(then (return (call option_bool_scalar (record.get (local compiler) human)))))
			(if
				(:doc "The limit and color defaults are the same in each options reader.")
				(i32.eq (local rule) (call project_compiler_rule (i32 1)))
				(then (return (record.get (local compiler) max_errors))))
			(if
				(:doc "Color is a config-only option shared by all commands.")
				(i32.eq (local rule) (call project_compiler_rule (i32 2)))
				(then (return (call option_bool_scalar (record.get (local compiler) color)))))
			(if
				(:doc "The default C standard is c11.")
				(i32.eq (local rule) (i32 21))
				(then (return (u32 11))))
			(if
				(:doc "One blank line and four-column indentation are the built-in formatting counts.")
				(i32.eq (local rule) (i32 47))
				(then (return (u32 4))))
			(if
				(:doc "The default import categories are 0, 1, 2 and 3, packed as base-four digits.")
				(i32.eq (local rule) (i32 45))
				(then (return (u32 27))))
			(if
				(:doc "Release mode uses ThinLTO unless the profile or argv supplies an LTO mode.")
				(i32.eq (local rule) (i32 18))
				(then (return (call option_bool_scalar (u32.eq (local mode) (u32 2))))))
			(return (call option_bool_scalar
				(bool.or (i32.eq (local rule) (i32 6))
					(bool.or (i32.eq (local rule) (i32 12))
						(bool.or (i32.eq (local rule) (i32 23))
							(bool.or (i32.eq (local rule) (i32 33))
								(bool.or (i32.eq (local rule) (i32 41)) (i32.eq (local rule) (i32 66)))))))))))

	(fn
		(:doc "The default, debug, and release modes supply one, two, and one built-in C flags.")
		project_default_cflags
		(params (mode u32))
		(returns i32)
		(body
			(if
				(:doc "Debug mode adds a separate debugging information flag.")
				(u32.eq (local mode) (u32 1))
				(then (return (i32 2))))
			(return (i32 1))))

	(fn
		(:doc "Write one built-in C flag. Return its byte count, or zero for an unavailable item or short output.")
		write_default_cflag
		(params (mode u32) (index i32) (output (mut-slice u8)))
		(returns i32)
		(body
			(if
				(:doc "Validate the item index before writing any bytes.")
				(bool.or (i32.lt (local index) (i32 0))
					(bool.not (i32.lt (local index) (call project_default_cflags (local mode)))))
				(then (return (i32 0))))
			(if
				(:doc "Debug mode's second flag is -g.")
				(i32.eq (local index) (i32 1))
				(then
					(if
						(:doc "A short buffer cannot hold -g.")
						(i32.lt (slice.len (local output)) (i32 2))
						(then (return (i32 0))))
					(slice.store (local output) (i32 0) (u8 45))
					(slice.store (local output) (i32 1) (u8 103))
					(return (i32 2))))
			(if
				(:doc "All optimization flags have three bytes.")
				(i32.lt (slice.len (local output)) (i32 3))
				(then (return (i32 0))))
			(let-mut digit (u8 49))
			(if
				(:doc "Debug defaults to -O0.")
				(u32.eq (local mode) (u32 1))
				(then (set (local digit) (u8 48))))
			(if
				(:doc "Release defaults to -O3.")
				(u32.eq (local mode) (u32 2))
				(then (set (local digit) (u8 51))))
			(slice.store (local output) (i32 0) (u8 45))
			(slice.store (local output) (i32 1) (u8 79))
			(slice.store (local output) (i32 2) (local digit))
			(return (i32 3))))
)
