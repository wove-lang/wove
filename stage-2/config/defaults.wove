(module project_defaults
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Supply built-in option values when neither argv nor the project profiles has a setting.")

	(use wove-file "../c/standard.wove" (only (value default_c_standard)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "./compiler.wove" (only compiler_defaults))
	(use wove-file "./schema.wove" (only project_compiler_rule))

	(let default_optimization "-O1")
	(let debug_optimization "-O0")
	(let release_optimization "-O3")
	(let debug_info "-g")
	(let no_flag "")

	(fn option_bool_scalar
		(:doc "Represent a boolean as the scalar stored by project and command settings.")
		(params (value bool))
		(returns u32)
		(body
			(if
				(:doc "An enabled option has scalar one.")
				(local value)
				(then (return 1u32)))
			(return 0u32)))

	(fn project_default_scalar
		(:doc "Return the built-in scalar for a project rule and the selected build mode.")
		(params (rule i32) (mode u32))
		(returns u32)
		(body
			(let compiler (call compiler_defaults))
			(if
				(:doc "The compiler's shared options retain their existing defaults.")
				(i32.eq (local rule) (call project_compiler_rule 0i32))
				(then (return (call option_bool_scalar (struct.get (local compiler) human)))))
			(if
				(:doc "The limit and color defaults are the same in each options reader.")
				(i32.eq (local rule) (call project_compiler_rule 1i32))
				(then (return (struct.get (local compiler) max_errors))))
			(if
				(:doc "Color is a config-only option shared by all commands.")
				(i32.eq (local rule) (call project_compiler_rule 2i32))
				(then (return (call option_bool_scalar (struct.get (local compiler) color)))))
			(if
				(:doc "The default C standard is c11.")
				(i32.eq (local rule) 20i32)
				(then (return (local default_c_standard))))
			(if
				(:doc "Release mode uses ThinLTO unless the profile or argv supplies an LTO mode.")
				(i32.eq (local rule) 18i32)
				(then (return (call option_bool_scalar (u32.eq (local mode) 2u32)))))
			(return (call option_bool_scalar
				(bool.or (i32.eq (local rule) 12i32) (i32.eq (local rule) 22i32))))))

	(fn project_default_cflags
		(:doc "The default, debug, and release modes supply one, two, and one built-in C flags.")
		(params (mode u32))
		(returns i32)
		(body
			(if
				(:doc "Debug mode adds a separate debugging information flag.")
				(u32.eq (local mode) 1u32)
				(then (return 2i32)))
			(return 1i32)))

	(fn append_cflag_bytes
		(:doc "Append a static flag after reserving room for all its bytes and the optional terminator.")
		(params (flag (shared-array u8)) (output (mut-array u8)) (cursor i32) (terminated bool))
		(returns i32)
		(body
			(let-mut width (array.len (local flag)))
			(if (local terminated) (then (set (local width) (i32.inc (local width)))))
			(if
				(:doc "A short buffer or a failed cursor leaves the output untouched.")
				(bool.or (i32.ltz (local cursor))
					(i32.lt (i32.sub (array.len (local output)) (local cursor)) (local width)))
				(then (return -1i32)))
			(let end (call append_bytes (borrow-shared (local flag)) (borrow-mut (local output)) (local cursor)))
			(if
				(:doc "The process launcher consumes NUL-terminated argument rows.")
				(local terminated)
				(then
					(array.store (local output) (local end) 0u8)
					(return (i32.inc (local end)))))
			(return (local end))))

	(fn append_default_cflag
		(:doc "Append the selected built-in spelling and return the next cursor, or -1 on a short output.")
		(params (mode u32) (index i32) (output (mut-array u8)) (cursor i32) (terminated bool))
		(returns i32)
		(body
			(if
				(:doc "An unavailable item supplies the empty spelling.")
				(bool.or (i32.ltz (local index))
					(i32.not-lt (local index) (call project_default_cflags (local mode))))
				(then (return (call append_cflag_bytes (borrow-shared (local no_flag))
					(borrow-mut (local output)) (local cursor) (local terminated)))))
			(if
				(:doc "Debug mode appends its separate -g flag after optimization.")
				(i32.eq (local index) 1i32)
				(then (return (call append_cflag_bytes (borrow-shared (local debug_info))
					(borrow-mut (local output)) (local cursor) (local terminated)))))
			(if
				(:doc "Debug mode defaults to -O0.")
				(u32.eq (local mode) 1u32)
				(then (return (call append_cflag_bytes (borrow-shared (local debug_optimization))
					(borrow-mut (local output)) (local cursor) (local terminated)))))
			(if
				(:doc "Release mode defaults to -O3.")
				(u32.eq (local mode) 2u32)
				(then (return (call append_cflag_bytes (borrow-shared (local release_optimization))
					(borrow-mut (local output)) (local cursor) (local terminated)))))
			(return (call append_cflag_bytes (borrow-shared (local default_optimization))
				(borrow-mut (local output)) (local cursor) (local terminated)))))

	(fn write_default_cflag
		(:doc "Write one built-in C flag. Return its byte count, or zero for an unavailable item or short output.")
		(params (mode u32) (index i32) (output (mut-array u8)))
		(returns i32)
		(body
			(let end (call append_default_cflag (local mode) (local index) (borrow-mut (local output)) 0i32 (bool false)))
			(if (i32.ltz (local end)) (then (return 0i32)))
			(return (local end))))
)
