(module project_defaults
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Supply built-in option values when neither argv nor the project profiles has a setting.")

	(use wove-file "../c/standard.wove" (only (value default_c_standard)))
	(use wove-file "./compiler.wove" (only compiler_defaults))
	(use wove-file "./schema.wove" (only project_compiler_rule))

	(fn option_bool_scalar
		(:doc "Represent a boolean as the scalar stored by project and command settings.")
		(params (value bool))
		(returns u32)
		(body
			(if
				(:doc "An enabled option has scalar one.")
				(local value)
				(then (return 1u32)))
			(return 0u32)))

	(fn project_default_scalar
		(:doc "Return the built-in scalar for a project rule and the selected build mode.")
		(params (rule i32) (mode u32))
		(returns u32)
		(body
			(let compiler (call compiler_defaults))
			(if
				(:doc "The compiler's shared options retain their existing defaults.")
				(i32.eq (local rule) (call project_compiler_rule 0i32))
				(then (return (call option_bool_scalar (struct.get (local compiler) human)))))
			(if
				(:doc "The limit and color defaults are the same in each options reader.")
				(i32.eq (local rule) (call project_compiler_rule 1i32))
				(then (return (struct.get (local compiler) max_errors))))
			(if
				(:doc "Color is a config-only option shared by all commands.")
				(i32.eq (local rule) (call project_compiler_rule 2i32))
				(then (return (call option_bool_scalar (struct.get (local compiler) color)))))
			(if
				(:doc "The default C standard is c11.")
				(i32.eq (local rule) 20i32)
				(then (return (local default_c_standard))))
			(if
				(:doc "Release mode uses ThinLTO unless the profile or argv supplies an LTO mode.")
				(i32.eq (local rule) 18i32)
				(then (return (call option_bool_scalar (u32.eq (local mode) 2u32)))))
			(return (call option_bool_scalar
				(bool.or (i32.eq (local rule) 12i32) (i32.eq (local rule) 22i32))))))

	(fn project_default_cflags
		(:doc "The default, debug, and release modes supply one, two, and one built-in C flags.")
		(params (mode u32))
		(returns i32)
		(body
			(if
				(:doc "Debug mode adds a separate debugging information flag.")
				(u32.eq (local mode) 1u32)
				(then (return 2i32)))
			(return 1i32)))

	(fn write_default_cflag
		(:doc "Write one built-in C flag. Return its byte count, or zero for an unavailable item or short output.")
		(params (mode u32) (index i32) (output (mut-array u8)))
		(returns i32)
		(body
			(if
				(:doc "Validate the item index before writing any bytes.")
				(bool.or (i32.lt (local index) 0i32)
					(bool.not (i32.lt (local index) (call project_default_cflags (local mode)))))
				(then (return 0i32)))
			(if
				(:doc "Debug mode's second flag is -g.")
				(i32.eq (local index) 1i32)
				(then
					(if
						(:doc "A short buffer cannot hold -g.")
						(i32.lt (array.len (local output)) 2i32)
						(then (return 0i32)))
					(array.store (local output) 0i32 45u8)
					(array.store (local output) 1i32 103u8)
					(return 2i32)))
			(if
				(:doc "All optimization flags have three bytes.")
				(i32.lt (array.len (local output)) 3i32)
				(then (return 0i32)))
			(let-mut digit 49u8)
			(if
				(:doc "Debug defaults to -O0.")
				(u32.eq (local mode) 1u32)
				(then (set (local digit) 48u8)))
			(if
				(:doc "Release defaults to -O3.")
				(u32.eq (local mode) 2u32)
				(then (set (local digit) 51u8)))
			(array.store (local output) 0i32 45u8)
			(array.store (local output) 1i32 79u8)
			(array.store (local output) 2i32 (local digit))
			(return 3i32)))
)
