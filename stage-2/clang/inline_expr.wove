(module clang_inline_expression
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Bound the expression forms eligible for GNU extern-inline replay.")

	(use wove-file "./fields.wove" (only clang_field clang_inner field_equals (value clang_kind_key)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))

	(let conditional_kind "\"ConditionalOperator\"")
	(let paren_kind "\"ParenExpr\"")
	(let call_kind "\"CallExpr\"")
	(let reference_kind "\"DeclRefExpr\"")
	(let member_kind "\"MemberExpr\"")
	(let integer_kind "\"IntegerLiteral\"")
	(let character_kind "\"CharacterLiteral\"")
	(let binary_kind "\"BinaryOperator\"")
	(let unary_kind "\"UnaryOperator\"")
	(let implicit_cast_kind "\"ImplicitCastExpr\"")
	(let c_cast_kind "\"CStyleCastExpr\"")
	(let cast_key "castKind")
	(let opcode_key "opcode")
	(let literal_key "value")
	(let value_category_key "valueCategory")
	(let lvalue_kind "\"lvalue\"")
	(let zero_literal "\"0\"")
	(let read_cast "\"LValueToRValue\"")
	(let integer_cast "\"IntegralCast\"")
	(let pointer_cast "\"BitCast\"")
	(let null_cast "\"NullToPointer\"")
	(let array_cast "\"ArrayToPointerDecay\"")
	(let builtin_cast "\"BuiltinFnToFnPtr\"")
	(let function_cast "\"FunctionToPointerDecay\"")
	(let lt_op "\"<\"")
	(let gt_op "\">\"")
	(let le_op "\"<=\"")
	(let ge_op "\">=\"")
	(let eq_op "\"==\"")
	(let ne_op "\"!=\"")
	(let mask_op "\"&\"")
	(let assignment_op "\"=\"")
	(let deref_op "\"*\"")
	(let inc_op "\"++\"")
	(let variable_arity -2i32)
	(let inline_depth 64i32)

	(fn comparison
		(:doc "Recognize the six binary comparisons.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (opcode i32))
		(returns bool)
		(body
			(return (bool:or
				(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared lt_op))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared gt_op)))
				(bool:or
					(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared le_op))
						(call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared ge_op)))
					(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared eq_op))
						(call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared ne_op))))))))

	(fn pointer_store
		(:doc "Admit simple assignment to a dereferenced pointer in the checked expression tree.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let target (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
			(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) target
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(let opcode (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) target
				(borrow-shared opcode_key) (borrow-mut scratch)))
			(let category (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) target
				(borrow-shared value_category_key) (borrow-mut scratch)))
			(return (bool:and
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared unary_kind))
				(bool:and (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared deref_op))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) category (borrow-shared lvalue_kind)))))))

	(fn integer_literal
		(:doc "Clang resolves C integer and character literals to exact typed values.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (kind i32))
		(returns bool)
		(body
			(return (bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared integer_kind))
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared character_kind))))))

	(fn expression_arity
		(:doc "Classify one AST expression without interpreting its C operation.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared conditional_kind)) (then (return 3i32)))
			(if (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared call_kind)) (then (return variable_arity)))
			(if
				(:doc "An operand leaf is a direct reference or an integer or character literal.")
				(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared reference_kind))
					(call integer_literal (borrow-shared ast) (borrow-shared nodes) kind))
				(then (return 0i32)))
			(if
				(:doc "Parentheses and direct record member selection each have one base expression.")
				(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared paren_kind))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared member_kind)))
				(then (return 1i32)))
			(if
				(:doc "The binary subset allows comparisons, integer masks, and simple pointer stores.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared binary_kind))
				(then
					(let opcode (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
						(borrow-shared opcode_key) (borrow-mut scratch)))
					(if
						(:doc "The tree proof compares both ordered operands of each admitted operation.")
						(bool:or (call comparison (borrow-shared ast) (borrow-shared nodes) opcode)
							(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared mask_op))
								(bool:and (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared assignment_op))
									(call pointer_store (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))))
						(then (return 2i32)))
					(return -1i32)))
			(if
				(:doc "Dereference and increment operate on the already checked operand.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared unary_kind))
				(then
					(let opcode (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
						(borrow-shared opcode_key) (borrow-mut scratch)))
					(if
						(:doc "These are the unary operations needed to consume a buffered value.")
						(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared deref_op))
							(call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared inc_op)))
						(then (return 1i32)))
					(return -1i32)))
			(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared cast_key) (borrow-mut scratch)))
			(if
				(:doc "An explicit C cast can reinterpret a pointer, convert an integer, or form a null pointer.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared c_cast_kind))
				(then
					(if
						(:doc "Each cast retains the checked operand and result type.")
						(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared pointer_cast))
							(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared integer_cast))
								(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared null_cast))))
						(then (return 1i32)))
					(return -1i32)))
			(if
				(:doc "Implicit casts may read, convert values, or decay a reference for an ordinary call.")
				(bool:and (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared implicit_cast_kind))
					(bool:or
						(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared read_cast))
							(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared integer_cast)))
						(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared null_cast))
							(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared array_cast))
								(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared builtin_cast))
									(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared function_cast)))))))
				(then (return 1i32)))
			(return -1i32)))

	(fn expression_shape
		(:doc "Require a bounded tree of eligible expressions with each node's expected arity.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32) (depth i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(if depth.eqz (then (return (bool false))))
			(let arity (call expression_arity (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(if (arity.eq -1i32) (then (return (bool false))))
			(let-mut child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
			(let-mut count 0i32)
			(while
				(:doc "Each subtree must be an expression without local declarations or hidden storage.")
				child.not-ltz
				(body
					(if
						(:doc "Reject an unsupported subtree before visiting its siblings.")
						(bool:not (call expression_shape (borrow-shared ast) (borrow-shared nodes) child
							depth.dec (borrow-mut scratch)))
						(then (return (bool false))))
					(set count count.inc)
					(set child (struct:get (nodes.get child) next_sibling))))
			(return (if
				(:doc "A call always starts with a callee and can have any number of arguments.")
				(arity.eq variable_arity)
				(then count.gtz)
				(else (arity.eq count))))))

	(fn expression_root
		(:doc "Unwrap the parentheses of an already validated expression subtree.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let-mut current row)
			(while
				(:doc "The checked expression shape gives every parenthesis exactly one operand.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes)
					(call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) current
						(borrow-shared clang_kind_key) (borrow-mut scratch)) (borrow-shared paren_kind))
				(body (set current (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) current (borrow-mut scratch)))))
			(return current)))

	(fn expression_field_matches
		(:doc "Match a stable expression field in the validated tree.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(key (shared-array u8)) (value (shared-array u8)) (scratch (mut-array u8)))
		(returns bool)
		(body
			(let field (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared key) (borrow-mut scratch)))
			(return (call field_equals (borrow-shared ast) (borrow-shared nodes) field (borrow-shared value)))))

	(fn forwarded_null
		(:doc "Follow checked pointer casts to a null conversion of the integer literal zero.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let-mut current row)
			(while
				(:doc "The validated tree bounds the number of pointer casts and parentheses.")
				(call expression_field_matches (borrow-shared ast) (borrow-shared nodes) current
					(borrow-shared cast_key) (borrow-shared pointer_cast) (borrow-mut scratch))
				(body
					(let child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) current (borrow-mut scratch)))
					(set current (call expression_root (borrow-shared ast) (borrow-shared nodes) child (borrow-mut scratch)))))
			(if
				(:doc "A pointer reinterpretation alone does not establish a null pointer.")
				(bool:not (call expression_field_matches (borrow-shared ast) (borrow-shared nodes) current
					(borrow-shared cast_key) (borrow-shared null_cast) (borrow-mut scratch)))
				(then (return (bool false))))
			(let child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) current (borrow-mut scratch)))
			(let zero (call expression_root (borrow-shared ast) (borrow-shared nodes) child (borrow-mut scratch)))
			(return (bool:and (call expression_field_matches (borrow-shared ast) (borrow-shared nodes) zero
					(borrow-shared clang_kind_key) (borrow-shared integer_kind) (borrow-mut scratch))
				(call expression_field_matches (borrow-shared ast) (borrow-shared nodes) zero
					(borrow-shared literal_key) (borrow-shared zero_literal) (borrow-mut scratch))))))

	(fn forwarded_argument
		(:doc "Admit direct declared reads, integer or character literals, and typed null arguments.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let root (call expression_root (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) root
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if
				(:doc "The serializer records the exact type and value of the literal.")
				(call integer_literal (borrow-shared ast) (borrow-shared nodes) kind)
				(then (return (bool true))))
			(if
				(:doc "Keep the existing direct read and array-decay rules for named operands.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared implicit_cast_kind))
				(then
					(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) root
						(borrow-shared cast_key) (borrow-mut scratch)))
					(let child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) root (borrow-mut scratch)))
					(if
						(:doc "Only a direct declaration may supply a value read or an array address.")
						(bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared read_cast))
							(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared array_cast)))
						(then (return (call expression_field_matches (borrow-shared ast) (borrow-shared nodes) child
							(borrow-shared clang_kind_key) (borrow-shared reference_kind) (borrow-mut scratch)))))))
			(return (call forwarded_null (borrow-shared ast) (borrow-shared nodes) root (borrow-mut scratch)))))

	(fn forwarding_return
		(:doc "Require a direct call, optionally wrapped in one explicit integral return cast.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let-mut invocation row)
			(if
				(:doc "Clang supplies the source and destination types of an integral return cast.")
				(call expression_field_matches (borrow-shared ast) (borrow-shared nodes) row
					(borrow-shared clang_kind_key) (borrow-shared c_cast_kind) (borrow-mut scratch))
				(then
					(if
						(:doc "Other casts cannot wrap a direct forwarding return.")
						(bool:not (call expression_field_matches (borrow-shared ast) (borrow-shared nodes) row
							(borrow-shared cast_key) (borrow-shared integer_cast) (borrow-mut scratch)))
						(then (return (bool false))))
					(let child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
					(set invocation (call expression_root (borrow-shared ast) (borrow-shared nodes) child (borrow-mut scratch)))))
			(if
				(:doc "Only the call form supplies a callee and ordered arguments.")
				(bool:not (call expression_field_matches (borrow-shared ast) (borrow-shared nodes) invocation
					(borrow-shared clang_kind_key) (borrow-shared call_kind) (borrow-mut scratch)))
				(then (return (bool false))))
			(let callee (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) invocation (borrow-mut scratch)))
			(if
				(:doc "An ordinary forwarder cannot use an intrinsic or an indirect call.")
				(bool:not (call expression_field_matches (borrow-shared ast) (borrow-shared nodes) callee
					(borrow-shared cast_key) (borrow-shared function_cast) (borrow-mut scratch)))
				(then (return (bool false))))
			(let-mut argument (struct:get (nodes.get callee) next_sibling))
			(while
				(:doc "Check every operand before the identity pass records the full call.")
				argument.not-ltz
				(body
					(if
						(:doc "A forwarding call cannot evaluate an arbitrary argument expression.")
						(bool:not (call forwarded_argument (borrow-shared ast) (borrow-shared nodes) argument (borrow-mut scratch)))
						(then (return (bool false))))
					(set argument (struct:get (nodes.get argument) next_sibling))))
			(return (bool true))))

	(fn mask_comparison
		(:doc "Recognize a returned equality test of an integer mask against a literal.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let opcode (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared opcode_key) (borrow-mut scratch)))
			(if
				(:doc "The root is already a binary node in a validated expression tree.")
				(bool:not (bool:or
					(call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared eq_op))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) opcode (borrow-shared ne_op))))
				(then (return (bool false))))
			(let left (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
			(let right (call expression_root (borrow-shared ast) (borrow-shared nodes)
				(struct:get (nodes.get left) next_sibling) (borrow-mut scratch)))
			(let masked (call expression_root (borrow-shared ast) (borrow-shared nodes) left (borrow-mut scratch)))
			(let masked_kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) masked
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(let mask_opcode (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) masked
				(borrow-shared opcode_key) (borrow-mut scratch)))
			(let target_kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) right
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if
				(:doc "Require the built-in bitwise AND and an integer literal comparison operand.")
				(bool:not (bool:and
					(call field_equals (borrow-shared ast) (borrow-shared nodes) masked_kind (borrow-shared binary_kind))
					(bool:and (call field_equals (borrow-shared ast) (borrow-shared nodes) mask_opcode (borrow-shared mask_op))
						(call field_equals (borrow-shared ast) (borrow-shared nodes) target_kind (borrow-shared integer_kind)))))
				(then (return (bool false))))
			(let value (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) masked (borrow-mut scratch)))
			(let mask (call expression_root (borrow-shared ast) (borrow-shared nodes)
				(struct:get (nodes.get value) next_sibling) (borrow-mut scratch)))
			(let mask_kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) mask
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(return (call field_equals (borrow-shared ast) (borrow-shared nodes) mask_kind (borrow-shared integer_kind)))))

	(fn checked_return_expression
		(:doc "Admit a bounded forwarding call, conditional, or literal mask comparison.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(if
				(:doc "The complete return expression must fit the replay grammar and depth limit.")
				(bool:not (call expression_shape (borrow-shared ast) (borrow-shared nodes) row
					inline_depth (borrow-mut scratch)))
				(then (return (bool false))))
			(let root (call expression_root (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) root
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(return (bool:or
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared conditional_kind))
				(bool:or
					(bool:and (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared binary_kind))
						(call mask_comparison (borrow-shared ast) (borrow-shared nodes) root (borrow-mut scratch)))
					(call forwarding_return (borrow-shared ast) (borrow-shared nodes) root (borrow-mut scratch)))))))
)
