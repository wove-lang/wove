(module clang_include_trace
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read Clang's private include tree and preserve separate frontend diagnostics.")

	(use wove-file "../io/stdio.wove" (only write_stderr_line))
	(use c-header "<stdio.h>" (only fopen fread fgetc ferror (type Size)))

	(let read_mode "rb")

	(struct IncludeLine (fields (depth i32) (start i32) (end i32) (next i32)))

	(fn read_trace
		(:doc "Copy the complete diagnostic stream into the trace buffer and add a zero terminator.")
		(params (path (shared-array u8)) (trace (mut-array u8))) (returns u32)
		(body
			(let stream (call fopen (borrow-shared path) (borrow-shared read_mode)))
			(if
				(:doc "An unavailable private capture is a probe I/O failure.")
				(owner:is-null stream)
				(then (return 3u32)))
			(let capacity (i32:dec (array:len trace)))
			(let read (int:convert i32 (call fread (borrow-mut trace) (int:convert Size 1i32)
				(int:convert Size capacity) (borrow-shared stream))))
			(let next (call fgetc (borrow-shared stream)))
			(if
				(:doc "Propagate a stream failure independently of buffer exhaustion.")
				(i32:not-eqz (call ferror (borrow-shared stream)))
				(then (return 3u32)))
			(if
				(:doc "Read one extra byte to distinguish an exactly full buffer from truncation.")
				(i32:lt -1i32 next)
				(then (return 5u32)))
			(array:store trace read 0u8)
			(return 0u32)))

	(fn include_line
		(:doc "Read one line of Clang's -H trace. Ordinary diagnostics have depth zero.")
		(params (trace (shared-array u8)) (start i32) (length i32)) (returns IncludeLine)
		(body
			(let-mut end start)
			(while
				(:doc "The final diagnostic line may end at the capture boundary without a newline.")
				(bool:and (i32:lt end length)
					(u8:not-eq (array:load trace end) 10u8))
				(body (set end (i32:inc end))))
			(let-mut next end)
			(if
				(:doc "Advance past the line break only when it exists.")
				(i32:lt end length)
				(then (set next (i32:inc end))))
			(let-mut dots start)
			(while
				(:doc "Every leading dot contributes one include level.")
				(bool:and (i32:lt dots end) (u8:eq (array:load trace dots) 46u8))
				(body (set dots (i32:inc dots))))
			(if
				(:doc "A real include entry has a space after one or more dots.")
				(bool:and (bool:and (i32:lt start dots) (i32:lt dots end))
					(u8:eq (array:load trace dots) 32u8))
				(then (return (struct:new IncludeLine (depth (i32:sub dots start))
					(start (i32:inc dots)) (end end) (next next)))))
			(return (struct:new IncludeLine (depth 0i32) (start start) (end end) (next next)))))

	(fn trace_length
		(:doc "Count the captured bytes before the private terminator.")
		(params (trace (shared-array u8))) (returns i32)
		(body
			(let-mut length 0i32)
			(while
				(:doc "A bounded scan also handles an exhausted trace buffer.")
				(bool:and (i32:lt length (array:len trace))
					(u8:not-eqz (array:load trace length)))
				(body (set length (i32:inc length))))
			(return length)))

	(fn relay_trace_diagnostics
		(:doc "Send Clang's error lines to the caller while keeping the include tree private.")
		(params (trace (shared-array u8))) (returns void)
		(body
			(let length (call trace_length (borrow-shared trace)))
			(let-mut cursor 0i32)
			(while
				(:doc "Advance once per captured line in the original diagnostic order.")
				(i32:lt cursor length)
				(body
					(let line (call include_line (borrow-shared trace) cursor length))
					(if
						(:doc "Depth-zero lines are emitted by the tool outside the include tree.")
						(i32:eqz (struct:get line depth))
						(then
							(let written (call write_stderr_line (borrow-shared (array:range trace
								(struct:get line start) (struct:get line end)))))))
					(set cursor (struct:get line next))))
			(return)))
)
