(module clang_replay_capture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read one complete frontend observation from a separate private directory.")

	(use wove-file "./run.wove" (only replay_arguments deployment_arguments))
	(use wove-file "./trace.wove" (only read_trace))
	(use wove-file "../driver/files.wove" (only file_stamp read_source_file))
	(use wove-file "../io/capture/child.wove" (only reap_capture_child))
	(use wove-file "../io/process_file.wove" (only start_process_files))
	(use wove-file "../io/temporary.wove" (only create_temporary_directory))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use c-header "<unistd.h>" (only environ unlink rmdir))

	(let directory_suffix "/wove-clang.XXXXXX")
	(let stdout_suffix "/stdout")
	(let trace_suffix "/trace")

	(fn capture_path
		(:doc "Reserve the complete child pathname before opening a capture file.")
		(params (directory (shared-array u8)) (suffix (shared-array u8)))
		(returns (optional (owned-array u8)))
		(body
			(let width directory.len)
			(if
				(:doc "Reject a pathname whose complete byte length cannot fit in the output owner.")
				(i32:lt (i32:sub 2147483647i32 suffix.len) width)
				(then (return (optional:none (owned-array u8)))))
			(let allocated (array:try-alloc u8 (i32:add width suffix.len)))
			(if (owner:is-null allocated) (then (return (move allocated))))
			(let-mut path (move (optional:unwrap allocated)))
			(let start (call append_bytes (borrow-shared directory) (borrow-mut path) 0i32))
			(let end (call append_bytes (borrow-shared suffix) (borrow-mut path) start))
			(return (optional:some (move path)))))

	(fn read_capture
		(:doc "Measure completed regular stdout, then read its full extent and check EOF.")
		(params (path (shared-array u8)))
		(returns (optional (owned-array u8)))
		(body
			(let stamp (call file_stamp (borrow-shared path)))
			(let length (stamp.get length))
			(if (i32:ltz length) (then (return (optional:none (owned-array u8)))))
			(let allocated (array:try-alloc u8 length))
			(if (owner:is-null allocated) (then (return (move allocated))))
			(let-mut bytes (move (optional:unwrap allocated)))
			(if
				(:doc "The measured file identity, byte count, and EOF must all match.")
				(bool:not (call read_source_file (borrow-shared path) stamp (borrow-mut bytes)))
				(then (return (optional:none (owned-array u8)))))
			(return (optional:some (move bytes)))))

	(fn capture_frontend
		(:doc "Reap the frontend, verify both captures, and remove both privately owned files on every result.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (directory (shared-array u8))
			(trace (mut-array u8))) (returns (optional (owned-array u8)))
		(body
			(let output_path (call capture_path (borrow-shared directory) (borrow-shared stdout_suffix)))
			(let trace_path (call capture_path (borrow-shared directory) (borrow-shared trace_suffix)))
			(if
				(:doc "Neither file is created until both private names are ready.")
				(bool:or (owner:is-null output_path) (owner:is-null trace_path))
				(then (return (optional:none (owned-array u8)))))
			(let output (move (optional:unwrap output_path)))
			(let diagnostics (move (optional:unwrap trace_path)))
			(let environment environ)
			(let child (call start_process_files (borrow-shared program) (borrow-shared arguments)
				(borrow-shared output) (borrow-shared diagnostics) (borrow-shared environment)))
			(let status (call reap_capture_child (child.get pid)))
			(let result (if
				(:doc "Trust stdout only when the child exits successfully and its complete include trace fits.")
				(bool:and (child.get ok) (bool:and (i32:eqz status)
					(u32:eqz (call read_trace (borrow-shared diagnostics) (borrow-mut trace)))))
				(then (call read_capture (borrow-shared output)))
				(else (optional:none (owned-array u8)))))
			(let removed_output (call unlink (borrow-shared output)))
			(let removed_trace (call unlink (borrow-shared diagnostics)))
			(if
				(:doc "Do not certify a capture if either private file could not be removed.")
				(bool:or (i32:not-eqz removed_output) (i32:not-eqz removed_trace))
				(then (return (optional:none (owned-array u8)))))
			(return (move result))))

	(fn capture_replay_arguments
		(:doc "Capture one staged frontend invocation and discard its private temporary directory.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (trace (mut-array u8)))
		(returns (optional (owned-array u8)))
		(body
			(let directory (call create_temporary_directory (borrow-shared directory_suffix)))
			(if (i32:eqz directory.len) (then (return (optional:none (owned-array u8)))))
			(let result (call capture_frontend (borrow-shared program) (borrow-shared arguments)
				(borrow-shared directory) (borrow-mut trace)))
			(if
				(:doc "A retained private directory makes the audit unsuccessful.")
				(i32:not-eqz (call rmdir (borrow-shared directory)))
				(then (return (optional:none (owned-array u8)))))
			(return (move result))))

	(fn run_clang_replay_capture
		(:doc "Capture preprocessing or the declaration AST once, with both output files outside include lookup.")
		(params (program (shared-array u8)) (options (shared-array u8)) (source (shared-array u8))
			(preprocess bool) (trace (mut-array u8))) (returns (optional (owned-array u8)))
		(body
			(if (i32:eqz trace.len) (then (return (optional:none (owned-array u8)))))
			(let packed (call replay_arguments (borrow-shared options) (borrow-shared source) preprocess))
			(if (owner:is-null packed) (then (return (optional:none (owned-array u8)))))
			(let arguments (move (optional:unwrap packed)))
			(return (call capture_replay_arguments (borrow-shared program) (borrow-shared arguments)
				(borrow-mut trace)))))

	(fn check_replay_deployment
		(:doc "Require successful syntax checking of a complete unit with unguarded availability treated as an error.")
		(params (program (shared-array u8)) (options (shared-array u8)) (source (shared-array u8))
			(trace (mut-array u8))) (returns bool)
		(body
			(let packed (call deployment_arguments (borrow-shared options) (borrow-shared source)))
			(if (owner:is-null packed) (then (return (bool false))))
			(let arguments (move (optional:unwrap packed)))
			(let output (call capture_replay_arguments (borrow-shared program) (borrow-shared arguments) (borrow-mut trace)))
			(return (bool:not (owner:is-null output)))))
)
