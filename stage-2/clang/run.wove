(module clang_probe_run
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage one C translation unit and capture bounded Clang frontend output.")

	(use wove-file "../c/probe.wove" (only capture_probe_to_stderr probe_options_complete))
	(use wove-file "../io/capture/descriptors.wove" (only move_above_stdio))
	(use wove-file "../io/temporary.wove" (only create_temporary_directory))
	(use wove-file "../io/write.wove" (only write_new_file open_new_output))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "./trace.wove" (only read_trace relay_trace_diagnostics))
	(use c-header "<unistd.h>" (only close unlink rmdir))

	(struct ClangRun (fields (error u32) (status i32) (length i32)))

	(let directory_suffix "/wove-clang.XXXXXX")
	(let source_suffix "/probe.c")
	(let ast_flags "-Wno-everything\u0000-Xclang\u0000-ast-dump=json\u0000-fsyntax-only\u0000-x\u0000c\u0000--\u0000")
	(let macro_flags "-Wno-everything\u0000-dM\u0000-E\u0000-x\u0000c\u0000--\u0000")
	(let replay_flags "-Wno-everything\u0000-E\u0000-P\u0000-dD\u0000--\u0000")
	(let replay_ast_flags "-Wno-everything\u0000-Xclang\u0000-ast-dump=json\u0000-fsyntax-only\u0000--\u0000")

	(let trace_suffix ".stderr")
	(let detached_trace "/trace")
	(let native_flags "-Xclang\u0000-dependency-file\u0000-Xclang\u0000/dev/null\u0000-Xclang\u0000-MT\u0000-Xclang\u0000wove-probe\u0000-MJ\u0000/dev/null\u0000-Xclang\u0000-dependency-dot\u0000-Xclang\u0000/dev/null\u0000-Xclang\u0000-header-include-file\u0000-Xclang\u0000/dev/null\u0000-H\u0000-fshow-skipped-includes\u0000")

	(fn clang_run_at
		(:doc "Present the shared capture status in the Clang launcher result.")
		(params (error u32) (status i32) (length i32))
		(returns ClangRun)
		(body (return (struct.new ClangRun (error error) (status status) (length length)))))

	(fn invoke_clang
		(:doc "Forward complete frontend arguments before the required probe flags.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8)) (path (shared-array u8))
			(diagnostics i32) (output (mut-array u8)))
		(returns ClangRun)
		(body
			(let traced (i32.lt -1i32 diagnostics))
			(let-mut flag_width (array.len flags))
			(if
				(:doc "Native probes send expanded dependency outputs to sinks and report includes.")
				traced
				(then (set flag_width (i32.add flag_width (array.len native_flags)))))
			(let path_length (array.len path))
			(let option_length (array.len options))
			(let limit (i32.sub 2147483646i32 flag_width))
			(if
				(:doc "Check the packed argv length before adding any component or its final terminator.")
				(bool.or (i32.lt limit path_length)
					(i32.lt (i32.sub limit path_length) option_length))
				(then (return (call clang_run_at 2u32 -1i32 0i32))))
			(let end (i32.add (i32.add flag_width path_length) option_length))
			(let-mut arguments (array.alloc u8 (i32.inc end)))
			(let-mut options_end (call append_bytes (borrow-shared options) (borrow-mut arguments) 0i32))
			(if
				(:doc "Append the output restrictions after the caller's options and response-file references.")
				traced
				(then (set options_end (call append_bytes (borrow-shared native_flags)
					(borrow-mut arguments) options_end))))
			(let flag_end (call append_bytes (borrow-shared flags) (borrow-mut arguments) options_end))
			(let path_end (call append_bytes (borrow-shared path) (borrow-mut arguments) flag_end))
			(array.store arguments path_end 0u8)
			(let capture (call capture_probe_to_stderr (borrow-shared program) (borrow-shared arguments)
				diagnostics (borrow-mut output)))
			(return (call clang_run_at (struct.get capture error)
				(struct.get capture status) (struct.get capture length)))))

	(fn invoke_with_trace
		(:doc "Capture the native include tree separately from the probe's stdout.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8)) (path (shared-array u8))
			(output (mut-array u8)) (trace (mut-array u8)))
		(returns ClangRun)
		(body
			(if
				(:doc "Standalone queries inherit diagnostics and keep their original probe arguments.")
				(i32.eqz (array.len trace))
				(then (return (call invoke_clang (borrow-shared program) (borrow-shared options)
					(borrow-shared flags) (borrow-shared path) -1i32 (borrow-mut output)))))
			(let size (array.len path))
			(let suffix (array.len trace_suffix))
			(if
				(:doc "Reserve a representable sibling path in the caller's private stage.")
				(i32.lt (i32.sub 2147483647i32 size) suffix)
				(then (return (call clang_run_at 3u32 -1i32 0i32))))
			(let-mut diagnostics (array.alloc u8 (i32.add size suffix)))
			(let next (call append_bytes (borrow-shared path) (borrow-mut diagnostics) 0i32))
			(let end (call append_bytes (borrow-shared trace_suffix) (borrow-mut diagnostics) next))
			(return (call invoke_traced (borrow-shared program) (borrow-shared options)
				(borrow-shared flags) (borrow-shared path) (borrow-shared diagnostics)
				(borrow-mut output) (borrow-mut trace) (bool false)))))

	(fn invoke_traced
		(:doc "Keep the caller's selected stderr path private and retain the complete include trace.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8)) (path (shared-array u8))
			(diagnostics (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8)) (quiet bool))
		(returns ClangRun)
		(body
			(let created (call open_new_output (borrow-shared diagnostics)))
			(if
				(:doc "A failed exclusive open leaves the existing path alone.")
				(i32.ltz created)
				(then (return (call clang_run_at 3u32 -1i32 0i32))))
			(let descriptor (call move_above_stdio created))
			(if
				(:doc "The private descriptor may occupy a closed standard stream in the parent.")
				(i32.ltz descriptor)
				(then
					(let removed (call unlink (borrow-shared diagnostics)))
					(return (call clang_run_at 3u32 -1i32 0i32))))
			(let run (call invoke_clang (borrow-shared program) (borrow-shared options)
				(borrow-shared flags) (borrow-shared path) descriptor (borrow-mut output)))
			(let closed (call close descriptor))
			(let-mut error (struct.get run error))
			(if
				(:doc "The parent finishes writing before reopening the trace for reading.")
				(bool.and (u32.eqz error) (i32.not-eqz closed))
				(then (set error 3u32)))
			(if
				(:doc "Successful and failed frontends both produce private trace data that can be read.")
				(bool.or (u32.eqz error) (u32.eq error 4u32))
				(then
					(let traced (call read_trace (borrow-shared diagnostics) (borrow-mut trace)))
					(if
						(:doc "A successful native probe keeps the complete include trace.")
						(u32.eqz error)
						(then (set error traced))
						(else
							(if
								(:doc "Preserve Clang's actual diagnostics when its invocation failed.")
								(bool.and (u32.eqz traced) (bool.not quiet))
								(then (call relay_trace_diagnostics (borrow-shared trace))))))))
			(let removed (call unlink (borrow-shared diagnostics)))
			(if
				(:doc "Report removal failures when no earlier error explains the probe.")
				(bool.and (u32.eqz error) (i32.not-eqz removed))
				(then (set error 3u32)))
			(return (call clang_run_at error (struct.get run status) (struct.get run length)))))

	(fn write_probe
		(:doc "Write and close the private source before launching, then remove it on every return.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8)) (path (shared-array u8))
			(source (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8)))
		(returns ClangRun)
		(body
			(if
				(:doc "Only start the frontend after the exclusive source file is complete and closed.")
				(bool.not (call write_new_file (borrow-shared path) (borrow-shared source)))
				(then (return (call clang_run_at 3u32 -1i32 0i32))))
			(let result (call invoke_with_trace (borrow-shared program) (borrow-shared options)
				(borrow-shared flags) (borrow-shared path) (borrow-mut output) (borrow-mut trace)))
			(let removed (call unlink (borrow-shared path)))
			(if
				(:doc "A failed cleanup is reported when no earlier error explains the failure.")
				(bool.and (i32.not-eqz removed) (u32.eqz (struct.get result error)))
				(then (return (call clang_run_at 3u32 (struct.get result status) (struct.get result length)))))
			(return result)))

	(fn run_in_directory
		(:doc "Write the probe beside the caller's C unit in the supplied private directory.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8)) (directory (shared-array u8))
			(source (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8)))
		(returns ClangRun)
		(body
			(let parent (array.len directory))
			(let suffix (array.len source_suffix))
			(if
				(:doc "Check the directory and reserve space for the source basename.")
				(bool.or (i32.eqz parent)
					(i32.lt (i32.sub 2147483647i32 suffix) parent))
				(then (return (call clang_run_at 3u32 -1i32 0i32))))
			(let-mut path (array.alloc u8 (i32.add parent suffix)))
			(let next (call append_bytes (borrow-shared directory) (borrow-mut path) 0i32))
			(let end (call append_bytes (borrow-shared source_suffix) (borrow-mut path) next))
			(return (call write_probe (borrow-shared program) (borrow-shared options)
				(borrow-shared flags) (borrow-shared path) (borrow-shared source)
				(borrow-mut output) (borrow-mut trace)))))

	(fn run_in_temporary_directory
		(:doc "Remove the temporary directory owned by a standalone or retained-C query.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8))
			(source (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8)))
		(returns ClangRun)
		(body
			(let directory (call create_temporary_directory (borrow-shared directory_suffix)))
			(let result (call run_in_directory (borrow-shared program) (borrow-shared options)
				(borrow-shared flags) (borrow-shared directory) (borrow-shared source)
				(borrow-mut output) (borrow-mut trace)))
			(let removed (call rmdir (borrow-shared directory)))
			(if
				(:doc "Report removal failure once the completed capture has no earlier error.")
				(bool.and (i32.not-eqz removed) (u32.eqz (struct.get result error)))
				(then (return (call clang_run_at 3u32 (struct.get result status) (struct.get result length)))))
			(return result)))

	(fn capture_clang_source
		(:doc "Capture the selected frontend output using the caller's options and private directory.")
		(params (program (shared-array u8)) (options (shared-array u8)) (flags (shared-array u8)) (directory (shared-array u8))
			(source (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8)))
		(returns ClangRun)
		(body
			(if
				(:doc "Reject a missing separator before mandatory flags can join the caller's argument.")
				(bool.not (call probe_options_complete (borrow-shared options)))
				(then (return (call clang_run_at 2u32 -1i32 0i32))))
			(if
				(:doc "A binary build shares its source directory and quote-include search with the probe.")
				(i32.gtz (array.len directory))
				(then (return (call run_in_directory (borrow-shared program) (borrow-shared options)
					(borrow-shared flags) (borrow-shared directory) (borrow-shared source)
					(borrow-mut output) (borrow-mut trace)))))
			(return (call run_in_temporary_directory (borrow-shared program) (borrow-shared options)
				(borrow-shared flags) (borrow-shared source) (borrow-mut output) (borrow-mut trace)))))

	(fn run_clang_probe
		(:doc "Capture the translation unit's JSON AST using the existing probe contract.")
		(params (program (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8))
			(source (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8))) (returns ClangRun)
		(body (return (call capture_clang_source (borrow-shared program) (borrow-shared options)
			(borrow-shared ast_flags) (borrow-shared directory) (borrow-shared source)
			(borrow-mut output) (borrow-mut trace)))))

	(fn run_clang_macros
		(:doc "Capture the final preprocessor definitions after the requested header is included.")
		(params (program (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8))
			(source (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8))) (returns ClangRun)
		(body (return (call capture_clang_source (borrow-shared program) (borrow-shared options)
			(borrow-shared macro_flags) (borrow-shared directory) (borrow-shared source)
			(borrow-mut output) (borrow-mut trace)))))

	(fn run_clang_replay
		(:doc "Inspect an already staged C path without reporting a failed speculative eligibility check.")
		(params (program (shared-array u8)) (options (shared-array u8)) (path (shared-array u8))
			(preprocess bool) (output (mut-array u8)) (trace (mut-array u8))) (returns ClangRun)
		(body
			(if
				(:doc "Replay uses complete compiler options and always captures diagnostics privately.")
				(bool.or (i32.eqz (array.len trace))
					(bool.not (call probe_options_complete (borrow-shared options))))
				(then (return (call clang_run_at 2u32 -1i32 0i32))))
			(let directory (call create_temporary_directory (borrow-shared directory_suffix)))
			(let width (array.len directory))
			(let suffix (array.len detached_trace))
			(if
				(:doc "The trace must stay outside the build directory so include lookup never sees it.")
				(bool.or (i32.eqz width) (i32.lt (i32.sub 2147483647i32 suffix) width))
				(then (return (call clang_run_at 3u32 -1i32 0i32))))
			(let-mut diagnostics (array.alloc u8 (i32.add width suffix)))
			(let next (call append_bytes (borrow-shared directory) (borrow-mut diagnostics) 0i32))
			(let end (call append_bytes (borrow-shared detached_trace) (borrow-mut diagnostics) next))
			(let result (if
				(:doc "Capture emitted preprocessing lines or the same AST queried for ordinary native headers.")
				preprocess
				(then (call invoke_traced (borrow-shared program) (borrow-shared options)
					(borrow-shared replay_flags) (borrow-shared path) (borrow-shared diagnostics)
					(borrow-mut output) (borrow-mut trace) (bool true)))
				(else (call invoke_traced (borrow-shared program) (borrow-shared options)
					(borrow-shared replay_ast_flags) (borrow-shared path) (borrow-shared diagnostics)
					(borrow-mut output) (borrow-mut trace) (bool true)))))
			(let removed (call rmdir (borrow-shared directory)))
			(if
				(:doc "An unsuccessful cleanup is a failed certification even after a complete capture.")
				(bool.and (i32.not-eqz removed) (u32.eqz (struct.get result error)))
				(then (return (call clang_run_at 3u32 -1i32 0i32))))
			(return result))))
