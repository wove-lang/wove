(module clang_header_query
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Inspect a C header with the selected Clang and retain its exact declaration index.

	The caller supplies the selected tool, NUL-terminated target and include
	arguments, a header spelling, optional extra probe source, and the
	originating import span. The caller owns the capture, JSON rows,
	declaration rows, and decoded keys. Use clang_declaration with the
	returned index and those rows and keys after a successful present result.

	See c/probe.wove for the shared result and failure codes.`)

	(use wove-file "../c/probe.wove"
		(only (type (as QuerySite ProbeSite)) (type HeaderQuery) render_header_source render_frontend_header_source index_capture query_failed probe_run_at
			probe_defaults_width write_probe_defaults))
	(use wove-file "./run.wove" (only (type ClangRun) clang_run_at run_clang_probe))
	(use wove-file "./index.wove" (only (type ClangIndex) (type ClangDeclaration)))
	(use wove-file "./values.wove" (only (type ProbeWord)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct QuerySite (fields (file i32) (start i32) (end i32)))
	(struct ClangQuery
		(fields (site QuerySite) (run ClangRun) (index ClangIndex) (fact ProbeWord) (error u32) (present bool)))

	(fn query_rendered
		(:doc "Invoke Clang only with a complete rendered source and index the successful capture.")
		(params (program (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8))
			(source (shared-array u8))
			(site ProbeSite) (output (mut-array u8)) (nodes (mut-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)) (trace (mut-array u8)))
		(returns HeaderQuery)
		(body
			(if
				(:doc "An empty source marks a failed render before any child is started.")
				(i32.eq (array.len (local source)) 0i32)
				(then (return (call query_failed (local site) (call probe_run_at 1u32 -1i32 0i32)))))
			(let capture (call run_clang_probe (borrow-shared (local program)) (borrow-shared (local options))
				(borrow-shared (local directory)) (borrow-shared (local source)) (borrow-mut (local output)) (borrow-mut (local trace))))
			(let run (call probe_run_at (struct.get (local capture) error)
				(struct.get (local capture) status) (struct.get (local capture) length)))
			(if
				(:doc "Do not interpret partial output or treat a failed invocation as header absence.")
				(u32.lt 0u32 (struct.get (local run) error))
				(then (return (call query_failed (local site) (local run)))))
			(return (call index_capture (borrow-shared (local output)) (local site) (local run)
				(borrow-mut (local nodes)) (borrow-mut (local entries)) (borrow-mut (local names))))))

	(fn query_header_source
		(:doc "Translate the shared probe transport and index into the Clang query result.")
		(params (program (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8))
			(source (shared-array u8)) (site QuerySite) (output (mut-array u8)) (nodes (mut-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)) (trace (mut-array u8)))
		(returns ClangQuery)
		(body
			(let origin (struct.new ProbeSite (file (struct.get (local site) file))
				(start (struct.get (local site) start)) (end (struct.get (local site) end))))
			(let result (call query_rendered (borrow-shared (local program)) (borrow-shared (local options))
				(borrow-shared (local directory)) (borrow-shared (local source)) (local origin) (borrow-mut (local output)) (borrow-mut (local nodes))
				(borrow-mut (local entries)) (borrow-mut (local names)) (borrow-mut (local trace))))
			(return (call clang_query_result (local site) (local result)))))

	(fn clang_query_result
		(:doc "Present the shared result and native child status through the Clang API.")
		(params (site QuerySite) (result HeaderQuery)) (returns ClangQuery)
		(body
			(let run (struct.get (local result) run))
			(return (struct.new ClangQuery (site (local site))
				(run (call clang_run_at (struct.get (local run) error) (struct.get (local run) status) (struct.get (local run) length)))
				(index (struct.get (local result) index)) (fact (struct.get (local result) fact))
				(error (struct.get (local result) error)) (present (struct.get (local result) present))))))

	(fn query_clang_header
		(:doc "Render and index the standalone header probe with its established defaults.")
		(:expect (tests "stage-2/clang/live.tsv") (issues "gh:wove-lang/wove:196"))
		(params (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8)) (extra (shared-array u8))
			(site QuerySite) (output (mut-array u8)) (nodes (mut-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)))
		(returns ClangQuery)
		(body
			(let width (call probe_defaults_width))
			(let size (array.len (local options)))
			(if
				(:doc "Check the size before joining caller options with the standalone defaults.")
				(i32.lt (i32.sub 2147483647i32 (local width)) (local size))
				(then
					(let origin (struct.new ProbeSite (file (struct.get (local site) file))
						(start (struct.get (local site) start)) (end (struct.get (local site) end))))
					(return (call clang_query_result (local site) (call query_failed (local origin) (call probe_run_at 2u32 -1i32 0i32))))))
			(let-mut packed (array.alloc u8 (i32.add (local width) (local size))))
			(let next (call write_probe_defaults (borrow-mut (local packed))))
			(let end (call append_bytes (borrow-shared (local options)) (borrow-mut (local packed)) (local next)))
			(let source (call render_header_source (borrow-shared (local header)) (borrow-shared (local extra))))
			(let empty (array.alloc u8 0i32))
			(let-mut trace (array.alloc u8 0i32))
			(return (call query_header_source (borrow-shared (local program)) (borrow-shared (array.range (local packed) 0i32 (local end)))
				(borrow-shared (local empty)) (borrow-shared (local source)) (local site)
				(borrow-mut (local output)) (borrow-mut (local nodes)) (borrow-mut (local entries)) (borrow-mut (local names)) (borrow-mut (local trace))))))

	(fn query_clang_frontend
		(:doc "Query a header with the build's frontend arguments, macros, and quote-include directory.")
		(params (program (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8))
			(prefix (shared-array u8)) (header (shared-array u8)) (site QuerySite) (output (mut-array u8)) (nodes (mut-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)) (trace (mut-array u8)))
		(returns ClangQuery)
		(body
			(let source (call render_frontend_header_source (borrow-shared (local prefix)) (borrow-shared (local header))))
			(return (call query_header_source (borrow-shared (local program)) (borrow-shared (local options))
				(borrow-shared (local directory)) (borrow-shared (local source)) (local site)
				(borrow-mut (local output)) (borrow-mut (local nodes)) (borrow-mut (local entries)) (borrow-mut (local names)) (borrow-mut (local trace)))))))
