(module clang_ast_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Index the direct members of the first inner array in one Clang AST document.

	Pass offset zero initially and the successful end offset to the next
	call to read adjacent documents. A successful empty frame marks EOF.
	Source and declaration spans are absolute within the supplied bytes.
	JSON node rows and their spans are relative to the indexed document.
	The caller owns the nodes, declaration rows and decoded key bytes.
	Keep them available through any lookup on the returned index.

	Error codes 1 through 12 are JSON diagnostics. Code 13 is an invalid
	document offset, 14 is insufficient index rows, and 15 is insufficient
	decoded key storage. Discard all scratch and index rows on failure.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../json/frame.wove" (only json_frame))
	(use wove-file "./fields.wove" (only clang_field clang_inner (value clang_kind_key) (value clang_name_key)))

	(struct ClangDeclaration
		(fields (node i32) (start i32) (end i32) (kind_start i32) (kind_end i32) (name_start i32) (name_end i32)))
	(struct ClangIndex
		(fields (error u32) (start i32) (end i32) (nodes i32) (entries i32) (names i32)))

	(fn clang_index_result
		(:doc "Keep the original error location and avoid publishing partial index counts.")
		(params (error u32) (start i32) (end i32) (nodes i32) (entries i32) (names i32))
		(returns ClangIndex)
		(body (return (struct.new ClangIndex (error error) (start start) (end end)
			(nodes nodes) (entries entries) (names names)))))

	(fn append_clang_key
		(:doc "Decode one string field and append it to the key arena, or return -1 if capacity is short.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (row i32)
			(decoded (mut-array u8)) (names (mut-array u8)) (at i32))
		(returns i32)
		(body
			(if
				(:doc "Absent fields have an empty key span.")
				(i32.ltz row)
				(then (return at)))
			(let field (array.load nodes row))
			(if
				(:doc "The archive's string lookup treats a nonstring field as an empty key.")
				(u32.not-eq (struct.get field kind) 3u32)
				(then (return at)))
			(let value (call json_decode_string (borrow-shared source)
				(i32.add base (struct.get field start))
				(i32.add base (struct.get field end)) (borrow-mut decoded)))
			(let width (struct.get value written))
			(if
				(:doc "Check remaining arena capacity before adding any offsets or copying bytes.")
				(bool.or (u32.gtz (struct.get value error))
					(i32.lt (i32.sub (array.len names) at) width))
				(then (return -1i32)))
			(let-mut byte 0i32)
			(while
				(:doc "Each decoded key is stored exactly once without its JSON quotes.")
				(i32.lt byte width)
				(body
					(array.store names (i32.add at byte) (array.load decoded byte))
					(set byte (i32.inc byte))))
			(return (i32.add at width))))

	(fn index_clang_rows
		(:doc "Index one validated document's declaration array without walking nested bodies.")
		(params (source (shared-array u8)) (start i32) (end i32) (rows i32) (nodes (shared-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)))
		(returns ClangIndex)
		(body
			(let-mut decoded (array.alloc u8 (i32.sub end start)))
			(let-mut node (call clang_inner (borrow-shared source) start (borrow-shared nodes)
				0i32 (borrow-mut decoded)))
			(let-mut count 0i32)
			(let-mut cursor 0i32)
			(while
				(:doc "Only direct items of the selected array enter this index, in source order.")
				(i32.not-ltz node)
				(body
					(let value (array.load nodes node))
					(let at (i32.add start (struct.get value start)))
					(let stop (i32.add start (struct.get value end)))
					(if
						(:doc "Report the declaration that could not be added to the row view.")
						(i32.eq count (array.len entries))
						(then (return (call clang_index_result 14u32 at stop 0i32 0i32 0i32))))
					(let kind (call clang_field (borrow-shared source) start
						(borrow-shared nodes) node (borrow-shared clang_kind_key)
						(borrow-mut decoded)))
					(let name (call clang_field (borrow-shared source) start
						(borrow-shared nodes) node (borrow-shared clang_name_key)
						(borrow-mut decoded)))
					(let kind_end (call append_clang_key (borrow-shared source) start (borrow-shared nodes)
						kind (borrow-mut decoded) (borrow-mut names) cursor))
					(if
						(:doc "A declaration needs both of its decoded keys to be usable.")
						(i32.ltz kind_end)
						(then (return (call clang_index_result 15u32 at stop 0i32 0i32 0i32))))
					(let name_end (call append_clang_key (borrow-shared source) start (borrow-shared nodes)
						name (borrow-mut decoded) (borrow-mut names) kind_end))
					(if
						(:doc "Use the original declaration span for either exhausted key.")
						(i32.ltz name_end)
						(then (return (call clang_index_result 15u32 at stop 0i32 0i32 0i32))))
					(array.store entries count (struct.new ClangDeclaration
						(node node) (start at) (end stop)
						(kind_start cursor) (kind_end kind_end) (name_start kind_end) (name_end name_end)))
					(set cursor name_end)
					(set count (i32.inc count))
					(set node (struct.get value next_sibling))))
			(return (call clang_index_result 0u32 start end rows count cursor))))

	(fn clang_index
		(:doc "Frame, validate, and index the next supplied Clang document at or after offset.")
		(params (source (shared-array u8)) (offset i32) (nodes (mut-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)))
		(returns ClangIndex)
		(body
			(let frame (call json_frame (borrow-shared source) offset))
			(let error (struct.get frame error))
			(let start (struct.get frame start))
			(let end (struct.get frame end))
			(if
				(:doc "An empty frame is EOF, while a framing error already has absolute coordinates.")
				(bool.or (u32.gtz error) (i32.eq start end))
				(then (return (call clang_index_result error start end 0i32 0i32 0i32))))
			(let parsed (call json_parse (borrow-shared (array.range source start end)) (borrow-mut nodes)))
			(if
				(:doc "Translate diagnostics from the bounded JSON view back to the original stream.")
				(u32.gtz (struct.get parsed error))
				(then (return (call clang_index_result (struct.get parsed error)
					(i32.add start (struct.get parsed start))
					(i32.add start (struct.get parsed end)) 0i32 0i32 0i32))))
			(return (call index_clang_rows (borrow-shared source) start end
				(struct.get parsed rows) (borrow-shared nodes) (borrow-mut entries) (borrow-mut names)))))

	(fn clang_matches_declaration
		(:doc "Compare the declared kind and name with the two complete decoded keys.")
		(params (entry ClangDeclaration) (names (shared-array u8)) (kind (shared-array u8)) (name (shared-array u8)))
		(returns bool)
		(body (return (bool.and
			(call same_bytes (borrow-shared names) (struct.get entry kind_start)
				(struct.get entry kind_end) (borrow-shared kind) 0i32 (array.len kind))
			(call same_bytes (borrow-shared names) (struct.get entry name_start)
				(struct.get entry name_end) (borrow-shared name) 0i32 (array.len name))))))

	(fn clang_declaration
		(:doc "Return the last exact kind and name match, with node -1 when absent.")
		(params (index ClangIndex) (entries (shared-array ClangDeclaration)) (names (shared-array u8))
			(kind (shared-array u8)) (name (shared-array u8)))
		(returns ClangDeclaration)
		(body
			(let-mut row (struct.get index entries))
			(while
				(:doc "Later redeclarations of the exact kind and name take precedence.")
				(i32.gtz row)
				(body
					(set row (i32.dec row))
					(let entry (array.load entries row))
					(if
						(:doc "Compare full decoded keys without descending into the original JSON body.")
						(call clang_matches_declaration entry (borrow-shared names)
							(borrow-shared kind) (borrow-shared name))
						(then (return entry)))))
			(return (struct.new ClangDeclaration (node -1i32) (start -1i32) (end -1i32)
				(kind_start -1i32) (kind_end -1i32) (name_start -1i32) (name_end -1i32))))))
