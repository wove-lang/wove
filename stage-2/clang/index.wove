(module clang_ast_index
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Index the direct members of the first inner array in one Clang AST document.

	Pass offset zero initially and the successful end offset to the next
	call to read adjacent documents. A successful empty frame marks EOF.
	Source and declaration spans are absolute within the supplied bytes.
	JSON node rows and their spans are relative to the indexed document.
	The caller owns the nodes, declaration rows and decoded key bytes.
	Keep them available through any lookup on the returned index.

	Error codes 1 through 12 are JSON diagnostics. Code 13 is an invalid
	document offset, 14 is insufficient index rows, and 15 is insufficient
	decoded key storage. Discard all scratch and index rows on failure.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../json/frame.wove" (only json_frame))
	(use wove-file "./fields.wove" (only clang_field clang_inner (value clang_kind_key) (value clang_name_key)))

	(struct ClangDeclaration
		(fields (node i32) (start i32) (end i32) (kind_start i32) (kind_end i32) (name_start i32) (name_end i32)))
	(struct ClangIndex
		(fields (error u32) (start i32) (end i32) (nodes i32) (entries i32) (names i32)))

	(fn clang_index_result
		(:doc "Keep the original error location and avoid publishing partial index counts.")
		(params (error u32) (start i32) (end i32) (nodes i32) (entries i32) (names i32))
		(returns ClangIndex)
		(body (return (struct.new ClangIndex (error (local error)) (start (local start)) (end (local end))
			(nodes (local nodes)) (entries (local entries)) (names (local names))))))

	(fn append_clang_key
		(:doc "Decode one string field and append it to the key arena, or return -1 if capacity is short.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (row i32)
			(decoded (mut-array u8)) (names (mut-array u8)) (at i32))
		(returns i32)
		(body
			(if
				(:doc "Absent fields have an empty key span.")
				(i32.lt (local row) 0i32)
				(then (return (local at))))
			(let field (array.load (local nodes) (local row)))
			(if
				(:doc "The archive's string lookup treats a nonstring field as an empty key.")
				(u32.not-eq (struct.get (local field) kind) 3u32)
				(then (return (local at))))
			(let value (call json_decode_string (borrow-shared (local source))
				(i32.add (local base) (struct.get (local field) start))
				(i32.add (local base) (struct.get (local field) end)) (borrow-mut (local decoded))))
			(let width (struct.get (local value) written))
			(if
				(:doc "Check remaining arena capacity before adding any offsets or copying bytes.")
				(bool.or (u32.lt 0u32 (struct.get (local value) error))
					(i32.lt (i32.sub (array.len (local names)) (local at)) (local width)))
				(then (return -1i32)))
			(let-mut byte 0i32)
			(while
				(:doc "Each decoded key is stored exactly once without its JSON quotes.")
				(i32.lt (local byte) (local width))
				(body
					(array.store (local names) (i32.add (local at) (local byte)) (array.load (local decoded) (local byte)))
					(set (local byte) (i32.add (local byte) 1i32))))
			(return (i32.add (local at) (local width)))))

	(fn index_clang_rows
		(:doc "Index one validated document's declaration array without walking nested bodies.")
		(params (source (shared-array u8)) (start i32) (end i32) (rows i32) (nodes (shared-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)))
		(returns ClangIndex)
		(body
			(let-mut decoded (array.alloc u8 (i32.sub (local end) (local start))))
			(let-mut node (call clang_inner (borrow-shared (local source)) (local start) (borrow-shared (local nodes))
				0i32 (borrow-mut (local decoded))))
			(let-mut count 0i32)
			(let-mut cursor 0i32)
			(while
				(:doc "Only direct items of the selected array enter this index, in source order.")
				(i32.not-lt (local node) 0i32)
				(body
					(let value (array.load (local nodes) (local node)))
					(let at (i32.add (local start) (struct.get (local value) start)))
					(let stop (i32.add (local start) (struct.get (local value) end)))
					(if
						(:doc "Report the declaration that could not be added to the row view.")
						(i32.eq (local count) (array.len (local entries)))
						(then (return (call clang_index_result 14u32 (local at) (local stop) 0i32 0i32 0i32))))
					(let kind (call clang_field (borrow-shared (local source)) (local start)
						(borrow-shared (local nodes)) (local node) (borrow-shared (local clang_kind_key))
						(borrow-mut (local decoded))))
					(let name (call clang_field (borrow-shared (local source)) (local start)
						(borrow-shared (local nodes)) (local node) (borrow-shared (local clang_name_key))
						(borrow-mut (local decoded))))
					(let kind_end (call append_clang_key (borrow-shared (local source)) (local start) (borrow-shared (local nodes))
						(local kind) (borrow-mut (local decoded)) (borrow-mut (local names)) (local cursor)))
					(if
						(:doc "A declaration needs both of its decoded keys to be usable.")
						(i32.lt (local kind_end) 0i32)
						(then (return (call clang_index_result 15u32 (local at) (local stop) 0i32 0i32 0i32))))
					(let name_end (call append_clang_key (borrow-shared (local source)) (local start) (borrow-shared (local nodes))
						(local name) (borrow-mut (local decoded)) (borrow-mut (local names)) (local kind_end)))
					(if
						(:doc "Use the original declaration span for either exhausted key.")
						(i32.lt (local name_end) 0i32)
						(then (return (call clang_index_result 15u32 (local at) (local stop) 0i32 0i32 0i32))))
					(array.store (local entries) (local count) (struct.new ClangDeclaration
						(node (local node)) (start (local at)) (end (local stop))
						(kind_start (local cursor)) (kind_end (local kind_end)) (name_start (local kind_end)) (name_end (local name_end))))
					(set (local cursor) (local name_end))
					(set (local count) (i32.add (local count) 1i32))
					(set (local node) (struct.get (local value) next_sibling))))
			(return (call clang_index_result 0u32 (local start) (local end) (local rows) (local count) (local cursor)))))

	(fn clang_index
		(:doc "Frame, validate, and index the next supplied Clang document at or after offset.")
		(params (source (shared-array u8)) (offset i32) (nodes (mut-array JsonNode))
			(entries (mut-array ClangDeclaration)) (names (mut-array u8)))
		(returns ClangIndex)
		(body
			(let frame (call json_frame (borrow-shared (local source)) (local offset)))
			(let error (struct.get (local frame) error))
			(let start (struct.get (local frame) start))
			(let end (struct.get (local frame) end))
			(if
				(:doc "An empty frame is EOF, while a framing error already has absolute coordinates.")
				(bool.or (u32.lt 0u32 (local error)) (i32.eq (local start) (local end)))
				(then (return (call clang_index_result (local error) (local start) (local end) 0i32 0i32 0i32))))
			(let parsed (call json_parse (borrow-shared (array.range (local source) (local start) (local end))) (borrow-mut (local nodes))))
			(if
				(:doc "Translate diagnostics from the bounded JSON view back to the original stream.")
				(u32.lt 0u32 (struct.get (local parsed) error))
				(then (return (call clang_index_result (struct.get (local parsed) error)
					(i32.add (local start) (struct.get (local parsed) start))
					(i32.add (local start) (struct.get (local parsed) end)) 0i32 0i32 0i32))))
			(return (call index_clang_rows (borrow-shared (local source)) (local start) (local end)
				(struct.get (local parsed) rows) (borrow-shared (local nodes)) (borrow-mut (local entries)) (borrow-mut (local names))))))

	(fn clang_matches_declaration
		(:doc "Compare the declared kind and name with the two complete decoded keys.")
		(params (entry ClangDeclaration) (names (shared-array u8)) (kind (shared-array u8)) (name (shared-array u8)))
		(returns bool)
		(body (return (bool.and
			(call same_bytes (borrow-shared (local names)) (struct.get (local entry) kind_start)
				(struct.get (local entry) kind_end) (borrow-shared (local kind)) 0i32 (array.len (local kind)))
			(call same_bytes (borrow-shared (local names)) (struct.get (local entry) name_start)
				(struct.get (local entry) name_end) (borrow-shared (local name)) 0i32 (array.len (local name)))))))

	(fn clang_declaration
		(:doc "Return the last exact kind and name match, with node -1 when absent.")
		(params (index ClangIndex) (entries (shared-array ClangDeclaration)) (names (shared-array u8))
			(kind (shared-array u8)) (name (shared-array u8)))
		(returns ClangDeclaration)
		(body
			(let-mut row (struct.get (local index) entries))
			(while
				(:doc "Later redeclarations of the exact kind and name take precedence.")
				(i32.lt 0i32 (local row))
				(body
					(set (local row) (i32.sub (local row) 1i32))
					(let entry (array.load (local entries) (local row)))
					(if
						(:doc "Compare full decoded keys without descending into the original JSON body.")
						(call clang_matches_declaration (local entry) (borrow-shared (local names))
							(borrow-shared (local kind)) (borrow-shared (local name)))
						(then (return (local entry))))))
			(return (struct.new ClangDeclaration (node -1i32) (start -1i32) (end -1i32)
				(kind_start -1i32) (kind_end -1i32) (name_start -1i32) (name_end -1i32))))))
