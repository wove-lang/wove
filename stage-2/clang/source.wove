(module clang_probe_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Fill the archived C probe template without opening files or invoking a tool.

	Pass the bytes of templates/probe_header.tmpl.h. Its two literal <@.h>
	tokens are replaced by the supplied header name. Bare names become
	angle-bracket names. A supplied angle-bracket or quoted header stays in
	that form. Append optional C declarations after the probe.

	The result gives the written or required byte count. Error codes are
	1 invalid header, 2 invalid template marker count, 3 unrepresentable
	output size, and 4 insufficient output. Failures leave output intact.`)

	(use wove-file "../c/headers.wove" (only c_header_form))

	(struct ProbeSource (fields (error u32) (written i32) (required i32)))

	(fn probe_marker
		(:doc "Match the template's complete <@.h> token at a checked byte offset.")
		(params (template (shared-array u8)) (at i32))
		(returns bool)
		(body (return (bool.and
			(i32.not-lt (i32.sub (array.len template) at) 5i32)
			(bool.and (u8.eq (array.load template at) 60u8)
				(bool.and (u8.eq (array.load template (i32.inc at)) 64u8)
					(bool.and (u8.eq (array.load template (i32.add at 2i32)) 46u8)
						(bool.and (u8.eq (array.load template (i32.add at 3i32)) 104u8)
							(u8.eq (array.load template (i32.add at 4i32)) 62u8)))))))))

	(fn probe_marker_count
		(:doc "Require one availability test site and one include site in the supplied template.")
		(params (template (shared-array u8)))
		(returns i32)
		(body
			(let-mut at 0i32)
			(let-mut count 0i32)
			(while
				(:doc "Both complete markers will be replaced and all other template bytes copied.")
				(i32.lt at (array.len template))
				(body
					(if
						(:doc "A third marker is already enough to reject this template.")
						(call probe_marker (borrow-shared template) at)
						(then
							(set count (i32.inc count))
							(if
								(:doc "Bound the count independently of the supplied template length.")
								(i32.lt 2i32 count)
								(then (return count)))))
					(set at (i32.inc at))))
			(return count)))

	(fn probe_size
		(:doc "Measure the output without overflowing the i32 slice index range.")
		(params (template i32) (header i32) (extra i32))
		(returns i32)
		(body
			(let-mut available (i32.sub 2147483647i32 (i32.sub template 10i32)))
			(let-mut copy 0i32)
			(while
				(:doc "Reserve room for both complete header spellings.")
				(i32.lt copy 2i32)
				(body
					(if
						(:doc "The remaining size cannot represent this operand.")
						(i32.lt available header)
						(then (return -1i32)))
					(set available (i32.sub available header))
					(set copy (i32.inc copy))))
			(if
				(:doc "The caller's extra declarations must also fit in a single output view.")
				(i32.lt available extra)
				(then (return -1i32)))
			(return (i32.sub 2147483647i32 (i32.sub available extra)))))

	(fn copy_probe_bytes
		(:doc "Copy a complete fragment after the caller has checked the total output size.")
		(params (fragment (shared-array u8)) (output (mut-array u8)) (start i32))
		(returns i32)
		(body
			(let-mut at 0i32)
			(while
				(:doc "The fragment's bytes remain in their original order.")
				(i32.lt at (array.len fragment))
				(body
					(array.store output (i32.add start at) (array.load fragment at))
					(set at (i32.inc at))))
			(return (i32.add start at))))

	(fn write_probe_header
		(:doc "Write the intended literal header operand without involving C macro expansion.")
		(params (header (shared-array u8)) (form u32) (output (mut-array u8)) (start i32))
		(returns i32)
		(body
			(if
				(:doc "A literal name already carries the requested delimiters.")
				(u32.eq form 2u32)
				(then (return (call copy_probe_bytes (borrow-shared header) (borrow-mut output) start))))
			(array.store output start 60u8)
			(let end (call copy_probe_bytes (borrow-shared header) (borrow-mut output)
				(i32.inc start)))
			(array.store output end 62u8)
			(return (i32.inc end))))

	(fn render_clang_probe
		(:doc "Fill both include operands and append extra C source after successful size checks.")
		(params (template (shared-array u8)) (header (shared-array u8)) (extra (shared-array u8)) (output (mut-array u8)))
		(returns ProbeSource)
		(body
			(let form (call c_header_form (borrow-shared header)))
			(if
				(:doc "Reject an ill-formed literal before writing a preprocessing directive.")
				(u32.eqz form)
				(then (return (struct.new ProbeSource (error 1u32) (written 0i32) (required 0i32)))))
			(if
				(:doc "Check the template's marker contract before measuring replacements.")
				(i32.not-eq (call probe_marker_count (borrow-shared template)) 2i32)
				(then (return (struct.new ProbeSource (error 2u32) (written 0i32) (required 0i32)))))
			(let-mut width (array.len header))
			(if
				(:doc "A bare header needs two additional delimiter bytes.")
				(u32.eq form 1u32)
				(then
					(if
						(:doc "Check the extra delimiter bytes before adding them.")
						(i32.lt 2147483645i32 width)
						(then (return (struct.new ProbeSource (error 3u32) (written 0i32) (required 0i32)))))
					(set width (i32.add width 2i32))))
			(let size (call probe_size (array.len template) width (array.len extra)))
			(if
				(:doc "A source larger than the slice index range cannot be rendered.")
				(i32.ltz size)
				(then (return (struct.new ProbeSource (error 3u32) (written 0i32) (required 0i32)))))
			(if
				(:doc "Report exact capacity without modifying the caller's buffer.")
				(i32.lt (array.len output) size)
				(then (return (struct.new ProbeSource (error 4u32) (written 0i32) (required size)))))
			(let-mut at 0i32)
			(let-mut written 0i32)
			(while
				(:doc "Replace only the complete marker token and keep the rest of the C text verbatim.")
				(i32.lt at (array.len template))
				(body
					(if
						(:doc "A marker writes the full delimited name and consumes five template bytes.")
						(call probe_marker (borrow-shared template) at)
						(then
							(set written (call write_probe_header (borrow-shared header) form
								(borrow-mut output) written))
							(set at (i32.add at 5i32)))
						(else
							(array.store output written (array.load template at))
							(set written (i32.inc written))
							(set at (i32.inc at))))))
			(let end (call copy_probe_bytes (borrow-shared extra) (borrow-mut output) written))
			(return (struct.new ProbeSource (error 0u32) (written end) (required size))))))
