(module clang_ast_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Find direct Clang AST fields without revisiting nested declaration bodies.")

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let clang_inner_key "inner")
	(let clang_kind_key "kind")
	(let clang_name_key "name")
	(let clang_value_key "value")
	(let clang_field_key_capacity 5i32)

	(fn field_equals
		(:doc "Compare Clang's simple ASCII JSON fields including their delimiters.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (row i32) (value (shared-array u8)))
		(returns bool)
		(body
			(if (i32:ltz row) (then (return (bool false))))
			(let item (nodes.get row))
			(return (call same_bytes (borrow-shared source) (item.get start) (item.get end)
				(borrow-shared value) 0i32 value.len))))

	(fn clang_field
		(:doc "Find the first matching field in an object, using scratch only for the current decoded key.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (object i32)
			(key (shared-array u8)) (scratch (mut-array u8)))
		(returns i32)
		(body
			(let width key.len)
			(if
				(:doc "An absent object or a scratch view too short for the decoded key cannot supply a match.")
				(bool:or (i32:ltz object) (i32:lt scratch.len width))
				(then (return -1i32)))
			(let owner (nodes.get object))
			(if
				(:doc "Only object members have key spans.")
				(u32:not-eq (owner.get kind) 1u32)
				(then (return -1i32)))
			(let-mut row (owner.get first_child))
			(while
				(:doc "Visit direct siblings in original order, accepting the first exact decoded key.")
				(i32:not-ltz row)
				(body
					(let value (nodes.get row))
					(let text (call json_decode_string (borrow-shared source)
						(i32:add base (value.get key_start))
						(i32:add base (value.get key_end))
						(borrow-mut (scratch.range 0i32 width))))
					(if
						(:doc "A complete decoded key must equal the requested spelling and length.")
						(bool:and (u32:eqz (text.get error))
							(call same_bytes (borrow-shared scratch) 0i32 (text.get written)
								(borrow-shared key) 0i32 width))
						(then (return row)))
					(set row (value.get next_sibling))))
			(return -1i32)))

	(fn clang_inner
		(:doc "Return the first child row of the first inner array, or -1 for an absent or empty array.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (object i32)
			(scratch (mut-array u8)))
		(returns i32)
		(body
			(let row (call clang_field (borrow-shared source) base
				(borrow-shared nodes) object (borrow-shared clang_inner_key)
				(borrow-mut scratch)))
			(if
				(:doc "An absent field has no children.")
				(i32:ltz row)
				(then (return -1i32)))
			(let member (nodes.get row))
			(if
				(:doc "A non-array first inner field still takes precedence over later duplicate fields.")
				(u32:not-eq (member.get kind) 2u32)
				(then (return -1i32)))
			(return (member.get first_child)))))
