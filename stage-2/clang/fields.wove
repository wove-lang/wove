(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Find direct Clang AST fields without revisiting nested declaration bodies.")
	clang_ast_fields

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))

	(fn
		(:doc "Identify one of inner, kind, name, or value in that order.")
		is_clang_key
		(params (text (shared-slice u8)) (width i32) (key u32))
		(returns bool)
		(body
			(if
				(:doc "Match all bytes of the decoded inner key.")
				(bool.and (u32.eq (local key) (u32 0)) (i32.eq (local width) (i32 5)))
				(then (return (bool.and (u8.eq (slice.load (local text) (i32 0)) (u8 105))
					(bool.and (u8.eq (slice.load (local text) (i32 1)) (u8 110))
					(bool.and (u8.eq (slice.load (local text) (i32 2)) (u8 110))
					(bool.and (u8.eq (slice.load (local text) (i32 3)) (u8 101))
					(u8.eq (slice.load (local text) (i32 4)) (u8 114)))))))))
			(if
				(:doc "Match all bytes of the decoded kind key.")
				(bool.and (u32.eq (local key) (u32 1)) (i32.eq (local width) (i32 4)))
				(then (return (bool.and (u8.eq (slice.load (local text) (i32 0)) (u8 107))
					(bool.and (u8.eq (slice.load (local text) (i32 1)) (u8 105))
					(bool.and (u8.eq (slice.load (local text) (i32 2)) (u8 110))
					(u8.eq (slice.load (local text) (i32 3)) (u8 100))))))))
			(if
				(:doc "Match all bytes of the decoded name key.")
				(bool.and (u32.eq (local key) (u32 2)) (i32.eq (local width) (i32 4)))
				(then (return (bool.and (u8.eq (slice.load (local text) (i32 0)) (u8 110))
					(bool.and (u8.eq (slice.load (local text) (i32 1)) (u8 97))
					(bool.and (u8.eq (slice.load (local text) (i32 2)) (u8 109))
					(u8.eq (slice.load (local text) (i32 3)) (u8 101))))))))
			(if
				(:doc "Match all bytes of the decoded value key.")
				(bool.and (u32.eq (local key) (u32 3)) (i32.eq (local width) (i32 5)))
				(then (return (bool.and (u8.eq (slice.load (local text) (i32 0)) (u8 118))
					(bool.and (u8.eq (slice.load (local text) (i32 1)) (u8 97))
					(bool.and (u8.eq (slice.load (local text) (i32 2)) (u8 108))
					(bool.and (u8.eq (slice.load (local text) (i32 3)) (u8 117))
					(u8.eq (slice.load (local text) (i32 4)) (u8 101)))))))))
			(return (bool false))))

	(fn
		(:doc "Find the first matching field in an object and preserve its JSON node row.")
		clang_field
		(params (source (shared-slice u8)) (base i32) (nodes (shared-slice JsonNode)) (object i32) (key u32))
		(returns i32)
		(body
			(if
				(:doc "An absent object cannot supply fields.")
				(i32.lt (local object) (i32 0))
				(then (return (i32 -1))))
			(let owner (slice.load (local nodes) (local object)))
			(if
				(:doc "Only object members have key spans.")
				(bool.not (u32.eq (record.get (local owner) kind) (u32 1)))
				(then (return (i32 -1))))
			(let-mut decoded (array.alloc u8 (i32 5)))
			(let-mut row (record.get (local owner) first_child))
			(while
				(:doc "Visit direct siblings in original order, accepting the first exact decoded key.")
				(bool.not (i32.lt (local row) (i32 0)))
				(body
					(let value (slice.load (local nodes) (local row)))
					(let text (call json_decode_string (borrow-shared (local source))
						(i32.add.wrapping (local base) (record.get (local value) key_start))
						(i32.add.wrapping (local base) (record.get (local value) key_end))
						(borrow-mut (local decoded))))
					(if
						(:doc "A short scratch view indicates a key too long to match any requested field.")
						(bool.and (u32.eq (record.get (local text) error) (u32 0))
							(call is_clang_key (borrow-shared (local decoded)) (record.get (local text) written) (local key)))
						(then (return (local row))))
					(set (local row) (record.get (local value) next_sibling))))
			(return (i32 -1))))

	(fn
		(:doc "Return the first child row of the first inner array, or -1 for an absent or empty array.")
		clang_inner
		(params (source (shared-slice u8)) (base i32) (nodes (shared-slice JsonNode)) (object i32))
		(returns i32)
		(body
			(let row (call clang_field (borrow-shared (local source)) (local base)
				(borrow-shared (local nodes)) (local object) (u32 0)))
			(if
				(:doc "An absent field has no children.")
				(i32.lt (local row) (i32 0))
				(then (return (i32 -1))))
			(let member (slice.load (local nodes) (local row)))
			(if
				(:doc "A non-array first inner field still takes precedence over later duplicate fields.")
				(bool.not (u32.eq (record.get (local member) kind) (u32 2)))
				(then (return (i32 -1))))
			(return (record.get (local member) first_child)))))
