(module clang_ast_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Find direct Clang AST fields without revisiting nested declaration bodies.")

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let clang_inner_key "inner")
	(let clang_kind_key "kind")
	(let clang_name_key "name")
	(let clang_value_key "value")
	(let clang_field_key_capacity 5i32)

	(fn clang_field
		(:doc "Find the first matching field in an object, using scratch only for the current decoded key.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (object i32)
			(key (shared-array u8)) (scratch (mut-array u8)))
		(returns i32)
		(body
			(let width (array.len (local key)))
			(if
				(:doc "An absent object or a scratch view too short for the decoded key cannot supply a match.")
				(bool.or (i32.ltz (local object)) (i32.lt (array.len (local scratch)) (local width)))
				(then (return -1i32)))
			(let owner (array.load (local nodes) (local object)))
			(if
				(:doc "Only object members have key spans.")
				(u32.not-eq (struct.get (local owner) kind) 1u32)
				(then (return -1i32)))
			(let-mut row (struct.get (local owner) first_child))
			(while
				(:doc "Visit direct siblings in original order, accepting the first exact decoded key.")
				(i32.not-ltz (local row))
				(body
					(let value (array.load (local nodes) (local row)))
					(let text (call json_decode_string (borrow-shared (local source))
						(i32.add (local base) (struct.get (local value) key_start))
						(i32.add (local base) (struct.get (local value) key_end))
						(borrow-mut (array.range (local scratch) 0i32 (local width)))))
					(if
						(:doc "A complete decoded key must equal the requested spelling and length.")
						(bool.and (u32.eqz (struct.get (local text) error))
							(call same_bytes (borrow-shared (local scratch)) 0i32 (struct.get (local text) written)
								(borrow-shared (local key)) 0i32 (local width)))
						(then (return (local row))))
					(set (local row) (struct.get (local value) next_sibling))))
			(return -1i32)))

	(fn clang_inner
		(:doc "Return the first child row of the first inner array, or -1 for an absent or empty array.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (object i32)
			(scratch (mut-array u8)))
		(returns i32)
		(body
			(let row (call clang_field (borrow-shared (local source)) (local base)
				(borrow-shared (local nodes)) (local object) (borrow-shared (local clang_inner_key))
				(borrow-mut (local scratch))))
			(if
				(:doc "An absent field has no children.")
				(i32.ltz (local row))
				(then (return -1i32)))
			(let member (array.load (local nodes) (local row)))
			(if
				(:doc "A non-array first inner field still takes precedence over later duplicate fields.")
				(u32.not-eq (struct.get (local member) kind) 2u32)
				(then (return -1i32)))
			(return (struct.get (local member) first_child)))))
