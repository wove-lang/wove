			(return (call append_identity_span (borrow-shared ast) cell/start cell/end
				(borrow-mut output) first))))

	(fn append_member_identity
		(:doc "Resolve a selected field to its named translation-unit record and declared field type.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (member i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let reference (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) member
				(borrow-shared member_reference_key) (borrow-mut scratch)))
			(if (i32:ltz reference) (then (return -1i32)))
			(let-mut record (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Compare stable field identities rather than Clang's process-local IDs.")
				(i32:not-ltz record)
				(body
					(if
						(:doc "Only a direct field of a named record is in the supported member subset.")
						(call has_kind (borrow-shared ast) (borrow-shared nodes) record (borrow-shared record_kind) (borrow-mut scratch))
						(then
							(let field (call declaration_with_id (borrow-shared ast) (borrow-shared nodes)
								record reference (borrow-mut scratch)))
							(if
								(:doc "Qualify the field with both its enclosing tag kind and tag name.")
								(call has_kind (borrow-shared ast) (borrow-shared nodes) field
									(borrow-shared field_kind) (borrow-mut scratch))
								(then
									(let name (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) record
										(borrow-shared name_key) (borrow-mut scratch)))
									(let tag (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) record
										(borrow-shared record_tag_key) (borrow-mut scratch)))
									(let first (call append_field (borrow-shared ast) (borrow-shared nodes) tag (borrow-mut output) offset))
									(let next (call append_field (borrow-shared ast) (borrow-shared nodes) name (borrow-mut output) first))
									(return (call append_declaration (borrow-shared ast) (borrow-shared nodes) field (bool false)
										(borrow-mut output) next (borrow-mut scratch)))))))
					(set record (struct:get (nodes.get record) next_sibling))))
			(return -1i32)))

	(fn append_expression_identity
		(:doc "Record an admitted expression's effective shape, types, and linked operands in order.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (function i32) (row i32) (depth i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(if (bool:or (i32:eqz depth) (i32:ltz offset)) (then (return -1i32)))
			(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
			(let first (call append_field (borrow-shared ast) (borrow-shared nodes) kind (borrow-mut output) offset))
			(let-mut length (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) first))
			(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) row
				(borrow-shared value_category_key) (borrow-mut output) length (borrow-mut scratch)))
			(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) row
				(borrow-shared opcode_key) (borrow-mut output) length (borrow-mut scratch)))
			(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) row
				(borrow-shared cast_key) (borrow-mut output) length (borrow-mut scratch)))
			(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) row
				(borrow-shared postfix_key) (borrow-mut output) length (borrow-mut scratch)))
			(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) row
				(borrow-shared arrow_key) (borrow-mut output) length (borrow-mut scratch)))
			(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) row
				(borrow-shared literal_value_key) (borrow-mut output) length (borrow-mut scratch)))
			(if
				(:doc "Only a parameter or an already linked object can supply a direct value reference.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared reference_kind))
				(then
					(let reference (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
						(borrow-shared reference_key) (borrow-mut scratch)))
					(set length (call append_inline_reference (borrow-shared ast) (borrow-shared nodes) function reference
						(borrow-mut output) length (borrow-mut scratch)))))
			(if
				(:doc "A member keeps its exact record and field binding in each context.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared member_kind))
				(then (set length (call append_member_identity (borrow-shared ast) (borrow-shared nodes) row
					(borrow-mut output) length (borrow-mut scratch)))))
			(let-mut child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
			(if
				(:doc "A call records its resolved callee separately from its argument expressions.")
				(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared call_kind))
				(then
					(let callee (call inline_call_target (borrow-shared ast) (borrow-shared nodes) child
						(bool true) (borrow-mut scratch)))
					(if (i32:ltz callee) (then (return -1i32)))
					(set length (call append_expression_field (borrow-shared ast) (borrow-shared nodes) child
						(borrow-shared cast_key) (borrow-mut output) length (borrow-mut scratch)))
					(set length (call append_declaration (borrow-shared ast) (borrow-shared nodes) callee
						(bool true) (borrow-mut output) length (borrow-mut scratch)))
					(set length (call append_call_attributes (borrow-shared ast) (borrow-shared nodes) callee
						(borrow-mut output) length (borrow-mut scratch)))
					(set child (struct:get (nodes.get child) next_sibling))))
			(while
				(:doc "The tree preserves child order, including the order of the conditional arms.")
				(bool:and (i32:not-ltz child) (i32:not-ltz length))
				(body
					(set length (call append_expression_identity (borrow-shared ast) (borrow-shared nodes) function child
						(i32:dec depth) (borrow-mut output) length (borrow-mut scratch)))
					(set child (struct:get (nodes.get child) next_sibling))))
			(return (call append_identity_span (borrow-shared expression_end) 0i32 expression_end.len (borrow-mut output) length))))

	(fn append_attributed_declaration
		(:doc "Compare attributed declarations, their linked symbols, and the admitted inline return expression.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(if
				(:doc "A declaration that passed the ordinary audit must preserve its complete identity.")
				(bool:not (bool:and
					(call has_kind (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared function_kind) (borrow-mut scratch))
					(u8:lt plain_declaration (call ordinary_function_mode (borrow-shared ast) (borrow-shared nodes)
						row (borrow-mut scratch)))))
				(then (return offset)))
			(let declaration (call append_declaration (borrow-shared ast) (borrow-shared nodes) row (bool true)
				(borrow-mut output) offset (borrow-mut scratch)))
			(let attributes (call append_call_attributes (borrow-shared ast) (borrow-shared nodes) row
				(borrow-mut output) declaration (borrow-mut scratch)))
			(let returned (call gnu_return_expression (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(if
				(:doc "Use the existing forwarder proof or compare the complete bounded expression tree.")
				(i32:not-ltz returned)
				(then
					(if
						(:doc "A plain call uses the existing, narrower forwarding rule.")
						(call has_kind (borrow-shared ast) (borrow-shared nodes) returned (borrow-shared call_kind) (borrow-mut scratch))
						(then (return (call append_forwarding_body (borrow-shared ast) (borrow-shared nodes) row returned
							(borrow-mut output) attributes (borrow-mut scratch)))))
					(return (call append_expression_identity (borrow-shared ast) (borrow-shared nodes) row returned
						inline_depth (borrow-mut output) attributes (borrow-mut scratch)))))
			(return attributes)))

	(fn write_native_identities
		(:doc "Write stable declaration attributes and resolved witness names, link symbols, and types.")
		(params (ast (shared-array u8)) (nodes (mut-array JsonNode)) (output (mut-array u8)))
		(returns i32)
		(body
			(let parsed (call json_parse (borrow-shared ast) (borrow-mut nodes)))
			(if (u32:not-eqz parsed/error) (then (return -1i32)))
			(let-mut scratch (array:alloc u8 24i32))
			(let-mut length 0i32)
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Compare declaration identities and witnesses in direct declaration order.")
				(i32:not-ltz row)
				(body
					(set length (call append_attributed_declaration (borrow-shared ast) (borrow-shared nodes)
						row (borrow-mut output) length (borrow-mut scratch)))
					(let owner_type (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared owner_type_witness_prefix) (borrow-mut scratch)))
					(let type_name (if
						(:doc "Snapshot layout typedefs carry the folded sizes and offsets in their Clang types.")
						(i32:not-ltz owner_type)
						(then owner_type)
						(else (call witness_name (borrow-shared ast) (borrow-shared nodes) row
							(borrow-shared field_layout_witness_prefix) (borrow-mut scratch)))))
					(if
						(:doc "Compare native owner and layout types independently of the selected function declaration.")
						(i32:not-ltz type_name)
						(then
							(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) type_name (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) length))))
					(let getter_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared lvalue_witness_prefix) (borrow-mut scratch)))
					(let drop_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared release_witness_prefix) (borrow-mut scratch)))
					(let call_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared call_witness_prefix) (borrow-mut scratch)))
					(let fixed_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared fixed_call_witness_prefix) (borrow-mut scratch)))
					(let borrowed_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared borrowed_cstr_witness_prefix) (borrow-mut scratch)))
					(let mutable_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared mutable_cstr_witness_prefix) (borrow-mut scratch)))
					(let typed_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared typed_call_witness_prefix) (borrow-mut scratch)))
					(let owner_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared owner_call_witness_prefix) (borrow-mut scratch)))
					(let variadic_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared variadic_call_witness_prefix) (borrow-mut scratch)))
					(let getter (i32:not-ltz getter_name))
					(let drop (i32:not-ltz drop_name))
					(let-mut name call_name)
					(let-mut mode plain_function_witness)
					(if getter (then (set name getter_name)))
					(if drop (then (set name drop_name)))
					(if
						(:doc "The name of each special witness selects its declaration and prototype rules.")
						(i32:not-ltz fixed_name)
						(then (set name fixed_name) (set mode fixed_function_witness)))
					(if
						(:doc "A borrowed snapshot has a fixed prototype and a checked C string result.")
						(i32:not-ltz borrowed_name)
						(then (set name borrowed_name) (set mode borrowed_cstr_function_witness)))
					(if
						(:doc "A copyback snapshot also checks the writable parameter of the fixed C prototype.")
						(i32:not-ltz mutable_name)
						(then (set name mutable_name) (set mode mutable_cstr_function_witness)))
					(if
						(:doc "The typed fixed call also checks the target's availability declaration.")
						(i32:not-ltz typed_name)
						(then (set name typed_name) (set mode typed_function_witness)))
					(if
						(:doc "An owner constructor or release preserves its native allocation and link metadata.")
						(i32:not-ltz owner_name)
						(then (set name owner_name) (set mode owner_function_witness)))
					(if
						(:doc "A named C tail has its own variadic address witness.")
						(i32:not-ltz variadic_name)
						(then (set name variadic_name) (set mode variadic_function_witness)))
					(if
						(:doc "A private witness contributes the actual resolved object-code symbol.")
						(i32:not-ltz name)
						(then
							(let-mut function -1i32)
							(if
								(:doc "Resolve the witness under its exact native call contract.")
								getter
								(then (set function (call witness_getter (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))))
								(else
									(if
										(:doc "Native calls and their releases require direct external prototypes.")
										drop
										(then (set function (call witness_release_function (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))))
										(else (set function (call witness_direct_function (borrow-shared ast) (borrow-shared nodes)
										row mode (borrow-mut scratch)))))))
							(if (i32:ltz function) (then (return -1i32)))
							(let symbol (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) function
								(borrow-shared mangled_key) (borrow-mut scratch)))
							(let prototype (call type_spelling (borrow-shared ast) (borrow-shared nodes) function (bool false) (borrow-mut scratch)))
							(let pointer (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) name (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) symbol (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) prototype (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) pointer (borrow-mut output) length))
							(if
								(:doc "Every adapted call depends on the same resolved declaration metadata.")
								(u8:not-eq mode plain_function_witness)
								(then (set length (call append_call_attributes (borrow-shared ast) (borrow-shared nodes)
									function (borrow-mut output) length (borrow-mut scratch)))))))
					(if (i32:ltz length) (then (return -1i32)))
					(set row (struct:get (nodes.get row) next_sibling))))
			(return length)))
)
