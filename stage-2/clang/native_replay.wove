(module clang_native_replay
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Compare the types and linked C functions resolved by native replay witnesses.")

	(use wove-file "./fields.wove" (only clang_field clang_inner field_equals (value clang_kind_key)))
	(use wove-file "../json/reader.wove" (only (type JsonNode) json_parse))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(let lvalue_witness_prefix "wove_native_lvalue_probe_")
	(let owner_type_witness_prefix "wove_native_owner_type_probe_")
	(let release_witness_prefix "wove_native_release_probe_")
	(let call_witness_prefix "wove_native_call_probe_")
	(let fixed_call_witness_prefix "wove_native_fixed_call_probe_")
	(let borrowed_cstr_witness_prefix "wove_native_borrowed_cstr_probe_")
	(let mutable_cstr_witness_prefix "wove_native_mutable_cstr_probe_")
	(let typed_call_witness_prefix "wove_native_typed_call_probe_")
	(let owner_call_witness_prefix "wove_native_owner_call_probe_")
	(let variadic_call_witness_prefix "wove_native_variadic_call_probe_")
	(let plain_function_witness 0u8)
	(let fixed_function_witness 1u8)
	(let variadic_function_witness 2u8)
	(let borrowed_cstr_function_witness 3u8)
	(let mutable_cstr_function_witness 4u8)
	(let typed_function_witness 5u8)
	(let owner_function_witness 6u8)
	(let id_key "id")
	(let name_key "name")
	(let type_key "type")
	(let qualified_key "qualType")
	(let desugared_key "desugaredQualType")
	(let mangled_key "mangledName")
	(let storage_key "storageClass")
	(let inline_key "inline")
	(let previous_key "previousDecl")
	(let implicit_key "isImplicit")
	(let true_value "true")
	(let variadic_key "variadic")
	(let opcode_key "opcode")
	(let cast_key "castKind")
	(let reference_key "referencedDecl")
	(let typedef_kind "\"TypedefDecl\"")
	(let typeof_kind "\"TypeOfExprType\"")
	(let pointer_kind "\"PointerType\"")
	(let elaborated_kind "\"ElaboratedType\"")
	(let typedef_type_kind "\"TypedefType\"")
	(let plain_char "\"char\"")
	(let const_char "\"const char\"")
	(let paren_kind "\"ParenExpr\"")
	(let unary_kind "\"UnaryOperator\"")
	(let call_kind "\"CallExpr\"")
	(let cast_kind "\"ImplicitCastExpr\"")
	(let reference_kind "\"DeclRefExpr\"")
	(let function_kind "\"FunctionDecl\"")
	(let function_prototype_kind "\"FunctionProtoType\"")
	(let parameter_kind "\"ParmVarDecl\"")
	(let nothrow_kind "\"NoThrowAttr\"")
	(let nonnull_kind "\"NonNullAttr\"")
	(let asm_label_kind "\"AsmLabelAttr\"")
	(let availability_kind "\"AvailabilityAttr\"")
	(let builtin_kind "\"BuiltinAttr\"")
	(let restrict_kind "\"RestrictAttr\"")
	(let const_kind "\"ConstAttr\"")
	(let extern_storage "\"extern\"")
	(let decay_cast "\"FunctionToPointerDecay\"")
	(let address_opcode "\"&\"")
	(let dereference_opcode "\"*\"")
	(let void_prototype "(void)\"")

	(fn has_kind
		(:doc "Match the direct kind of a Clang AST declaration or expression.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(kind (shared-array u8)) (scratch (mut-array u8))) (returns bool)
		(body
			(let value (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(return (call field_equals (borrow-shared ast) (borrow-shared nodes) value (borrow-shared kind)))))

	(fn single_inner
		(:doc "Read a wrapper's only operand, or reject a missing operand or a sibling.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let inner (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
			(if
				(:doc "A wrapper with other operands does not certify a direct native reference.")
				(bool.and (i32.not-ltz inner) (i32.not-ltz (struct.get (array.load nodes inner) next_sibling)))
				(then (return -1i32)))
			(return inner)))

	(fn peel_parens
		(:doc "Skip only single-operand parentheses. Casts and other operations stay visible.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let-mut current row)
			(while
				(:doc "Drop syntax that cannot change the expression's type or operand.")
				(call has_kind (borrow-shared ast) (borrow-shared nodes) current (borrow-shared paren_kind) (borrow-mut scratch))
				(body (set current (call single_inner (borrow-shared ast) (borrow-shared nodes) current (borrow-mut scratch)))))
			(return current)))

	(fn type_spelling
		(:doc "Read a C type string and prefer its desugared spelling when comparing pointer types.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(desugar bool) (scratch (mut-array u8))) (returns i32)
		(body
			(let type (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared type_key) (borrow-mut scratch)))
			(if
				(:doc "A typedef or expression can carry both the canonical and written spelling.")
				desugar
				(then
					(let resolved (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) type
						(borrow-shared desugared_key) (borrow-mut scratch)))
					(if (i32.not-ltz resolved) (then (return resolved)))))
			(return (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) type
				(borrow-shared qualified_key) (borrow-mut scratch)))))

	(fn same_field
		(:doc "Compare raw JSON spans from two AST fields in the same compiler output.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (left i32) (right i32))
		(returns bool)
		(body
			(if (bool.or (i32.ltz left) (i32.ltz right)) (then (return (bool false))))
			(let a (array.load nodes left))
			(let b (array.load nodes right))
			(return (call same_bytes (borrow-shared ast) (struct.get a start) (struct.get a end)
				(borrow-shared ast) (struct.get b start) (struct.get b end)))))

	(fn witness_name
		(:doc "Recognize one class of private witness typedef by its prefix.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(prefix (shared-array u8)) (scratch (mut-array u8))) (returns i32)
		(body
			(if
				(:doc "Only generated typedefs record the unevaluated witness type.")
				(bool.not (call has_kind (borrow-shared ast) (borrow-shared nodes) row
					(borrow-shared typedef_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let name (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-shared name_key) (borrow-mut scratch)))
			(if (i32.ltz name) (then (return -1i32)))
			(let token (array.load nodes name))
			(let start (i32.inc (struct.get token start)))
			(let end (i32.add start (array.len prefix)))
			(if
				(:doc "The prefix must be followed by the witness's identifying suffix.")
				(bool.and (i32.lt end (i32.dec (struct.get token end)))
					(call same_bytes (borrow-shared ast) start end (borrow-shared prefix)
						0i32 (array.len prefix)))
				(then (return name)))
			(return -1i32)))

	(fn witness_address
		(:doc "Locate the unary address expression in a typename witness.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let type (call single_inner (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(if
				(:doc "The generated typedef must describe the actual operand's address.")
				(bool.not (call has_kind (borrow-shared ast) (borrow-shared nodes) type (borrow-shared typeof_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let expression (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) type (borrow-mut scratch)))
			(if (i32.ltz expression) (then (return -1i32)))
			(let pointer (struct.get (array.load nodes expression) next_sibling))
			(if
				(:doc "Taking the address must produce an ordinary pointer.")
				(bool.not (call has_kind (borrow-shared ast) (borrow-shared nodes) pointer
					(borrow-shared pointer_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let address (call peel_parens (borrow-shared ast) (borrow-shared nodes) expression (borrow-mut scratch)))
			(let ampersand (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) address
				(borrow-shared opcode_key) (borrow-mut scratch)))
			(if
				(:doc "An expression other than unary address-of cannot certify a native operand.")
				(bool.not (bool.and (call has_kind (borrow-shared ast) (borrow-shared nodes) address
					(borrow-shared unary_kind) (borrow-mut scratch))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) ampersand
						(borrow-shared address_opcode))))
				(then (return -1i32)))
			(return address)))

	(fn getter_reference
		(:doc "Accept only the address of a dereferenced zero-argument direct call.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let address (call witness_address (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(let operand (call single_inner (borrow-shared ast) (borrow-shared nodes) address (borrow-mut scratch)))
			(let dereference (call peel_parens (borrow-shared ast) (borrow-shared nodes) operand (borrow-mut scratch)))
			(let star (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) dereference
				(borrow-shared opcode_key) (borrow-mut scratch)))
			(if
				(:doc "The raw lvalue must be an ordinary unary dereference, without a cast, subscript, or comma expression.")
				(bool.not (bool.and
					(call has_kind (borrow-shared ast) (borrow-shared nodes) dereference (borrow-shared unary_kind) (borrow-mut scratch))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) star (borrow-shared dereference_opcode))))
				(then (return -1i32)))
			(let call_row (call peel_parens (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) dereference (borrow-mut scratch)) (borrow-mut scratch)))
			(let callee (call single_inner (borrow-shared ast) (borrow-shared nodes) call_row (borrow-mut scratch)))
			(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) callee (borrow-shared cast_key) (borrow-mut scratch)))
			(if
				(:doc "A call with any arguments or an indirect callee cannot use this replay proof.")
				(bool.not (bool.and (call has_kind (borrow-shared ast) (borrow-shared nodes) call_row (borrow-shared call_kind) (borrow-mut scratch))
					(bool.and (call has_kind (borrow-shared ast) (borrow-shared nodes) callee (borrow-shared cast_kind) (borrow-mut scratch))
						(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared decay_cast)))))
				(then (return -1i32)))
			(let reference (call peel_parens (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) callee (borrow-mut scratch)) (borrow-mut scratch)))
			(if
				(:doc "The resolved function must be referenced directly.")
				(bool.not (call has_kind (borrow-shared ast) (borrow-shared nodes) reference
					(borrow-shared reference_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let returned (call type_spelling (borrow-shared ast) (borrow-shared nodes) call_row (bool true) (borrow-mut scratch)))
			(let expected (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
			(if (bool.not (call same_field (borrow-shared ast) (borrow-shared nodes) returned expected)) (then (return -1i32)))
			(return (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) reference
				(borrow-shared reference_key) (borrow-mut scratch)))))

	(fn is_linked_function
		(:doc "Require a direct function declaration with external linkage and an object-code symbol.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let storage (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-shared storage_key) (borrow-mut scratch)))
			(let inline (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-shared inline_key) (borrow-mut scratch)))
			(let symbol (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-shared mangled_key) (borrow-mut scratch)))
			(return (bool.and (call has_kind (borrow-shared ast) (borrow-shared nodes) row
					(borrow-shared function_kind) (borrow-mut scratch))
				(bool.and (bool.and (i32.ltz inline) (i32.not-ltz symbol))
					(bool.or (i32.ltz storage) (call field_equals (borrow-shared ast) (borrow-shared nodes)
						storage (borrow-shared extern_storage))))))))

	(fn accepts_getter
		(:doc "Require a body-free external void-parameter prototype with recognized non-linkage attributes.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let prototype (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool false) (borrow-mut scratch)))
			(if (i32.ltz prototype) (then (return (bool false))))
			(let spelling (array.load nodes prototype))
			(let end (struct.get spelling end))
			(let suffix (i32.sub end (array.len void_prototype)))
			(if
				(:doc "A void parameter list must be explicit in the native prototype.")
				(bool.or (i32.not-lt (struct.get spelling start) suffix)
					(bool.not (call same_bytes (borrow-shared ast) suffix end (borrow-shared void_prototype) 0i32 (array.len void_prototype))))
				(then (return (bool false))))
			(let-mut child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-mut scratch)))
			(while
				(:doc "Reject a function body or attributes that can change linkage or code generation.")
				(i32.not-ltz child)
				(body
					(if
						(:doc "The approved attributes only describe side effects and throwing.")
						(bool.not (bool.or
							(call has_kind (borrow-shared ast) (borrow-shared nodes) child (borrow-shared nothrow_kind) (borrow-mut scratch))
							(call has_kind (borrow-shared ast) (borrow-shared nodes) child (borrow-shared const_kind) (borrow-mut scratch))))
						(then (return (bool false))))
					(set child (struct.get (array.load nodes child) next_sibling))))
			(return (bool true))))

	(fn referenced_function
		(:doc "Resolve the reference against the direct linked C declaration it names.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (reference i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let identity (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) reference (borrow-shared id_key) (borrow-mut scratch)))
			(if (i32.ltz identity) (then (return -1i32)))
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Compare pointer IDs only within this single Clang AST.")
				(i32.not-ltz row)
				(body
					(let candidate (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row (borrow-shared id_key) (borrow-mut scratch)))
					(if
						(:doc "The matching declaration must be the checked external function.")
						(call same_field (borrow-shared ast) (borrow-shared nodes) identity candidate)
						(then
							(if
								(:doc "A matching local or indirect reference does not provide an external symbol.")
								(call is_linked_function (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))
								(then (return row)))
							(return -1i32)))
					(set row (struct.get (array.load nodes row) next_sibling))))
			(return -1i32)))

	(fn witness_getter
		(:doc "Resolve a writable lvalue's direct getter and verify its exact calling form.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (witness i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let reference (call getter_reference (borrow-shared ast) (borrow-shared nodes) witness (borrow-mut scratch)))
			(let getter (call referenced_function (borrow-shared ast) (borrow-shared nodes) reference (borrow-mut scratch)))
			(if
				(:doc "The getter must have its zero-argument prototype and only the supported attributes.")
				(bool.and (i32.not-ltz getter)
					(call accepts_getter (borrow-shared ast) (borrow-shared nodes) getter (borrow-mut scratch)))
				(then (return getter)))
			(return -1i32)))

	(fn function_declaration_children
		(:doc "Check a body-free declaration and only the SDK attributes admitted for this witness.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (function i32)
			(mode u8) (scratch (mut-array u8))) (returns bool)
		(body
			(let-mut child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) function (borrow-mut scratch)))
			(while
				(:doc "A declaration can carry parameters and only explicitly checked metadata.")
				(i32.not-ltz child)
				(body
					(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) child
						(borrow-shared clang_kind_key) (borrow-mut scratch)))
					(let owner (u8.eq mode owner_function_witness))
					(let availability (bool.and (bool.or owner (bool.or (u8.eq mode variadic_function_witness)
							(u8.eq mode typed_function_witness)))
						(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared availability_kind))))
					(let owner_attribute (bool.and owner (bool.or
						(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared builtin_kind))
						(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared restrict_kind)))))
					(let attribute (bool.and (u8.not-eq mode plain_function_witness) (bool.or
						(bool.or availability owner_attribute)
						(bool.or (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared asm_label_kind))
							(bool.or (call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared nothrow_kind))
								(call field_equals (borrow-shared ast) (borrow-shared nodes) kind (borrow-shared nonnull_kind)))))))
					(if
						(:doc "Reject bodies and attributes outside the audited declaration contract.")
						(bool.not (bool.or attribute (call field_equals (borrow-shared ast)
							(borrow-shared nodes) kind (borrow-shared parameter_kind))))
						(then (return (bool false))))
					(set child (struct.get (array.load nodes child) next_sibling))))
			(return (bool true))))

	(fn snapshot_function_witness
		(:doc "Both snapshot witnesses require an actual native character pointer result.")
		(params (mode u8)) (returns bool)
		(body (return (bool.or (u8.eq mode borrowed_cstr_function_witness) (u8.eq mode mutable_cstr_function_witness)))))

	(fn peel_type_aliases
		(:doc "Skip Clang's typedef wrappers while retaining any qualifiers on the underlying type.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (type i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let-mut row type)
			(while
				(:doc "Each wrapper must describe a single underlying type.")
				(bool.or (call has_kind (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared elaborated_kind) (borrow-mut scratch))
					(call has_kind (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared typedef_type_kind) (borrow-mut scratch)))
				(body (set row (call single_inner (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))))
			(return row)))

	(fn cstr_pointer_matches
		(:doc "Resolve a native character pointer and require a writable pointee for the scratch parameter.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (type i32) (writable bool)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let pointer (call peel_type_aliases (borrow-shared ast) (borrow-shared nodes) type (borrow-mut scratch)))
			(if
				(:doc "The argument or result must have an actual native pointer type.")
				(bool.not (call has_kind (borrow-shared ast) (borrow-shared nodes) pointer
					(borrow-shared pointer_kind) (borrow-mut scratch)))
				(then (return (bool false))))
			(let pointee (call peel_type_aliases (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) pointer (borrow-mut scratch))
				(borrow-mut scratch)))
			(let spelling (call type_spelling (borrow-shared ast) (borrow-shared nodes) pointee (bool true)
				(borrow-mut scratch)))
			(return (bool.or
				(call field_equals (borrow-shared ast) (borrow-shared nodes) spelling (borrow-shared plain_char))
				(bool.and (bool.not writable)
					(call field_equals (borrow-shared ast) (borrow-shared nodes) spelling (borrow-shared const_char)))))))

	(fn snapshot_prototype_matches
		(:doc "Check the text result and, for copyback, the single mutable C string parameter.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (prototype i32) (mode u8)
			(scratch (mut-array u8))) (returns bool)
		(body
			(let result (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) prototype (borrow-mut scratch)))
			(if
				(:doc "Clang lists the return type before the parameter types.")
				(bool.not (call cstr_pointer_matches (borrow-shared ast) (borrow-shared nodes) result (bool false)
					(borrow-mut scratch)))
				(then (return (bool false))))
			(if (u8.not-eq mode mutable_cstr_function_witness) (then (return (bool true))))
			(let parameter (struct.get (array.load nodes result) next_sibling))
			(return (bool.and (i32.not-ltz parameter)
				(bool.and (i32.ltz (struct.get (array.load nodes parameter) next_sibling))
					(call cstr_pointer_matches (borrow-shared ast) (borrow-shared nodes) parameter (bool true)
						(borrow-mut scratch)))))))

	(fn witness_direct_function
		(:doc "Resolve a body-free external function with the witness's fixed or variadic C prototype.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (witness i32)
			(mode u8) (scratch (mut-array u8))) (returns i32)
		(body
			(let address (call witness_address (borrow-shared ast) (borrow-shared nodes) witness (borrow-mut scratch)))
			(let operand (call peel_parens (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) address (borrow-mut scratch)) (borrow-mut scratch)))
			(if
				(:doc "An indirect pointer does not name a fixed native call target.")
				(bool.not (call has_kind (borrow-shared ast) (borrow-shared nodes) operand
					(borrow-shared reference_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let reference (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) operand
				(borrow-shared reference_key) (borrow-mut scratch)))
			(let function (call referenced_function (borrow-shared ast) (borrow-shared nodes) reference (borrow-mut scratch)))
			(if
				(:doc "Each effective context must retain the approved body-free declaration shape.")
				(bool.or (i32.ltz function)
					(bool.not (call function_declaration_children (borrow-shared ast) (borrow-shared nodes)
						function mode (borrow-mut scratch))))
				(then (return -1i32)))
			(let type (call single_inner (borrow-shared ast) (borrow-shared nodes) witness (borrow-mut scratch)))
			(let expression (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) type (borrow-mut scratch)))
			(let pointer (struct.get (array.load nodes expression) next_sibling))
			(let prototype (call single_inner (borrow-shared ast) (borrow-shared nodes) pointer (borrow-mut scratch)))
			(let variadic (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) prototype
				(borrow-shared variadic_key) (borrow-mut scratch)))
			(if
				(:doc "Reject unprototyped C functions and a disagreement about the presence of ellipsis.")
				(bool.not (bool.and (call has_kind (borrow-shared ast) (borrow-shared nodes) prototype
						(borrow-shared function_prototype_kind) (borrow-mut scratch))
					(if
						(:doc "Clang records a real ellipsis with a true variadic marker.")
						(u8.eq mode variadic_function_witness)
						(then (bool.and (i32.not-ltz variadic) (u32.eq (struct.get (array.load nodes variadic) kind) 5u32)))
						(else (i32.ltz variadic)))))
				(then (return -1i32)))
			(if
				(:doc "A borrowed snapshot checks its result pointer and any mutable scratch parameter.")
				(bool.and (call snapshot_function_witness mode)
					(bool.not (call snapshot_prototype_matches (borrow-shared ast) (borrow-shared nodes)
						prototype mode (borrow-mut scratch))))
				(then (return -1i32)))
			(return function)))

	(fn witness_release_function
		(:doc "The release function must be body-free and have one parameter.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (witness i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let drop (call witness_direct_function (borrow-shared ast) (borrow-shared nodes)
				witness plain_function_witness (borrow-mut scratch)))
			(let parameter (call single_inner (borrow-shared ast) (borrow-shared nodes) drop (borrow-mut scratch)))
			(if
				(:doc "A release function with a body or attributes cannot use this proof.")
				(call has_kind (borrow-shared ast) (borrow-shared nodes) parameter
					(borrow-shared parameter_kind) (borrow-mut scratch))
				(then (return drop)))
			(return -1i32)))

	(fn mark_owner_builtin
		(:doc "Accept only the implicit builtin redeclaration of a witnessed owner function.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (function i32)
			(approved (mut-array u8)) (scratch (mut-array u8)))
		(returns void)
		(body
			(let previous (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) function
				(borrow-shared previous_key) (borrow-mut scratch)))
			(if (i32.ltz previous) (then (return)))
			(let name (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) function
				(borrow-shared name_key) (borrow-mut scratch)))
			(let prototype (call type_spelling (borrow-shared ast) (borrow-shared nodes) function
				(bool false) (borrow-mut scratch)))
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Clang links a declaration such as fopen64 to its original implicit builtin by AST ID.")
				(i32.not-ltz row)
				(body
					(let id (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
						(borrow-shared id_key) (borrow-mut scratch)))
					(if
						(:doc "Only the original linked builtin can share the witnessed declaration's approval.")
						(call same_field (borrow-shared ast) (borrow-shared nodes) previous id)
						(then
							(let implicit (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
								(borrow-shared implicit_key) (borrow-mut scratch)))
							(let original (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
								(borrow-shared name_key) (borrow-mut scratch)))
							(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row
								(bool false) (borrow-mut scratch)))
							(if
								(:doc "Check its exact original name and prototype and exclude definitions or local linkage.")
								(bool.and (call field_equals (borrow-shared ast) (borrow-shared nodes) implicit (borrow-shared true_value))
									(bool.and (call same_field (borrow-shared ast) (borrow-shared nodes) name original)
										(bool.and (call same_field (borrow-shared ast) (borrow-shared nodes) prototype type)
											(bool.and (call is_linked_function (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))
												(call function_declaration_children (borrow-shared ast) (borrow-shared nodes)
													row owner_function_witness (borrow-mut scratch))))))
								(then (array.store approved row 1u8)))
							(return)))
					(set row (struct.get (array.load nodes row) next_sibling))))))

	(fn mark_witnessed_declarations
		(:doc "Admit extra declaration metadata only on functions resolved by selected witnesses.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (approved (mut-array u8))
			(writable bool) (fixed_calls bool) (variadic_calls bool) (scratch (mut-array u8))) (returns bool)
		(body
			(let-mut getters (bool false))
			(let-mut fixed (bool false))
			(let-mut variadics (bool false))
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Each generated witness must certify its own resolved declaration.")
				(i32.not-ltz row)
				(body
					(let getter (bool.and writable (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared lvalue_witness_prefix) (borrow-mut scratch)))))
					(let adapted (bool.and fixed_calls (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared fixed_call_witness_prefix) (borrow-mut scratch)))))
					(let borrowed (bool.and fixed_calls (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared borrowed_cstr_witness_prefix) (borrow-mut scratch)))))
					(let mutable (bool.and fixed_calls (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared mutable_cstr_witness_prefix) (borrow-mut scratch)))))
					(let typed_call (bool.and fixed_calls (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared typed_call_witness_prefix) (borrow-mut scratch)))))
					(let owner (bool.and fixed_calls (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared owner_call_witness_prefix) (borrow-mut scratch)))))
					(let checked_fixed (bool.or adapted (bool.or owner (bool.or typed_call (bool.or borrowed mutable)))))
					(let variadic (bool.and variadic_calls (i32.not-ltz (call witness_name (borrow-shared ast)
						(borrow-shared nodes) row (borrow-shared variadic_call_witness_prefix) (borrow-mut scratch)))))
					(if
						(:doc "Only a proven witness may exempt its exact function declaration.")
						(bool.or getter (bool.or checked_fixed variadic))
						(then
							(let-mut mode fixed_function_witness)
							(if borrowed (then (set mode borrowed_cstr_function_witness)))
							(if mutable (then (set mode mutable_cstr_function_witness)))
							(if typed_call (then (set mode typed_function_witness)))
							(if owner (then (set mode owner_function_witness)))
							(if variadic (then (set mode variadic_function_witness)))
							(let function (if
								(:doc "Getter and function-call witnesses enforce distinct native expression shapes.")
								getter
								(then (call witness_getter (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
								(else (call witness_direct_function (borrow-shared ast) (borrow-shared nodes) row
									mode (borrow-mut scratch)))))
							(if (i32.ltz function) (then (return (bool false))))
							(array.store approved function 1u8)
							(if
								(:doc "A selected owner builtin can also have an implicit compiler declaration.")
								owner
								(then (call mark_owner_builtin (borrow-shared ast) (borrow-shared nodes) function
									(borrow-mut approved) (borrow-mut scratch))))
							(set getters (bool.or getters getter))
							(set fixed (bool.or fixed checked_fixed))
							(set variadics (bool.or variadics variadic))))
					(set row (struct.get (array.load nodes row) next_sibling))))
			(return (bool.and (bool.or (bool.not writable) getters)
				(bool.and (bool.or (bool.not fixed_calls) fixed) (bool.or (bool.not variadic_calls) variadics))))))

	(fn proved_lvalue_macro
		(:doc "Allow an object-like macro only if it names an operand already checked by a lvalue witness.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (name (shared-array u8)))
		(returns bool)
		(body
			(if (i32.eqz (array.len nodes)) (then (return (bool false))))
			(let-mut scratch (array.alloc u8 24i32))
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "The suffix of a valid synthetic typedef is the selected native spelling.")
				(i32.not-ltz row)
				(body
					(let witness (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared lvalue_witness_prefix) (borrow-mut scratch)))
					(if
						(:doc "Match the original macro name before resolving its checked getter.")
						(i32.not-ltz witness)
						(then
							(let spelling (array.load nodes witness))
							(let start (i32.add (i32.inc (struct.get spelling start)) (array.len lvalue_witness_prefix)))
							(if
								(:doc "Only the exact name with a proved getter can permit an expression macro.")
								(bool.and (call same_bytes (borrow-shared ast) start (i32.dec (struct.get spelling end))
									(borrow-shared name) 0i32 (array.len name))
									(i32.not-ltz (call witness_getter (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))))
								(then (return (bool true))))))
					(set row (struct.get (array.load nodes row) next_sibling))))
			(return (bool false))))

	(fn append_field
		(:doc "Append one delimited AST spelling to the comparable native identity.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (field i32)
			(output (mut-array u8)) (offset i32)) (returns i32)
		(body
			(if (bool.or (i32.ltz offset) (i32.ltz field)) (then (return -1i32)))
			(let value (array.load nodes field))
			(let start (struct.get value start))
			(let end (struct.get value end))
			(if
				(:doc "Every identity field must be a complete JSON string and fit the bounded capture.")
				(bool.or (u32.not-eq (struct.get value kind) 3u32)
					(i32.not-lt (i32.sub end start) (i32.sub (array.len output) offset)))
				(then (return -1i32)))
			(let at (call append_bytes (borrow-shared (array.range ast start end)) (borrow-mut output) offset))
			(array.store output at 0u8)
			(return (i32.inc at))))

	(fn append_call_attributes
		(:doc "Compare Clang's effective call attributes in addition to the replayed header text.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (function i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let-mut length offset)
			(let-mut child (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes)
				function (borrow-mut scratch)))
			(while
				(:doc "The resolved declaration has already admitted only parameters and known native attributes.")
				(bool.and (i32.not-ltz child) (i32.not-ltz length))
				(body
					(let kind (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes)
						child (borrow-shared clang_kind_key) (borrow-mut scratch)))
					(if
						(:doc "The prototype covers parameters and the exact preprocessed declaration covers attribute operands.")
						(bool.not (call field_equals (borrow-shared ast) (borrow-shared nodes) kind
							(borrow-shared parameter_kind)))
						(then (set length (call append_field (borrow-shared ast) (borrow-shared nodes)
							kind (borrow-mut output) length))))
					(set child (struct.get (array.load nodes child) next_sibling))))
			(return length)))

	(fn write_native_identities
		(:doc "Write only stable witness names, native link symbols, prototypes, and actual pointer types.")
		(params (ast (shared-array u8)) (nodes (mut-array JsonNode)) (output (mut-array u8)))
		(returns i32)
		(body
			(let parsed (call json_parse (borrow-shared ast) (borrow-mut nodes)))
			(if (u32.not-eqz (struct.get parsed error)) (then (return -1i32)))
			(let-mut scratch (array.alloc u8 24i32))
			(let-mut length 0i32)
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Compare all witnesses in their direct declaration order.")
				(i32.not-ltz row)
				(body
					(let type_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared owner_type_witness_prefix) (borrow-mut scratch)))
					(if
						(:doc "Record the native owner type independently of the selected destruction function.")
						(i32.not-ltz type_name)
						(then
							(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) type_name (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) length))))
					(let getter_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared lvalue_witness_prefix) (borrow-mut scratch)))
					(let drop_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared release_witness_prefix) (borrow-mut scratch)))
					(let call_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared call_witness_prefix) (borrow-mut scratch)))
					(let fixed_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared fixed_call_witness_prefix) (borrow-mut scratch)))
					(let borrowed_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared borrowed_cstr_witness_prefix) (borrow-mut scratch)))
					(let mutable_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared mutable_cstr_witness_prefix) (borrow-mut scratch)))
					(let typed_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared typed_call_witness_prefix) (borrow-mut scratch)))
					(let owner_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared owner_call_witness_prefix) (borrow-mut scratch)))
					(let variadic_name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared variadic_call_witness_prefix) (borrow-mut scratch)))
					(let getter (i32.not-ltz getter_name))
					(let drop (i32.not-ltz drop_name))
					(let-mut name call_name)
					(let-mut mode plain_function_witness)
					(if getter (then (set name getter_name)))
					(if drop (then (set name drop_name)))
					(if
						(:doc "The name of each special witness selects its declaration and prototype rules.")
						(i32.not-ltz fixed_name)
						(then (set name fixed_name) (set mode fixed_function_witness)))
					(if
						(:doc "A borrowed snapshot has a fixed prototype and a checked C string result.")
						(i32.not-ltz borrowed_name)
						(then (set name borrowed_name) (set mode borrowed_cstr_function_witness)))
					(if
						(:doc "A copyback snapshot also checks the writable parameter of the fixed C prototype.")
						(i32.not-ltz mutable_name)
						(then (set name mutable_name) (set mode mutable_cstr_function_witness)))
					(if
						(:doc "The typed fixed call also checks the target's availability declaration.")
						(i32.not-ltz typed_name)
						(then (set name typed_name) (set mode typed_function_witness)))
					(if
						(:doc "An owner constructor or release preserves its native allocation and link metadata.")
						(i32.not-ltz owner_name)
						(then (set name owner_name) (set mode owner_function_witness)))
					(if
						(:doc "A named C tail has its own variadic address witness.")
						(i32.not-ltz variadic_name)
						(then (set name variadic_name) (set mode variadic_function_witness)))
					(if
						(:doc "A private witness contributes the actual resolved object-code symbol.")
						(i32.not-ltz name)
						(then
							(let-mut function -1i32)
							(if
								(:doc "Resolve the witness under its exact native call contract.")
								getter
								(then (set function (call witness_getter (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))))
								(else
									(if
										(:doc "Native calls and their releases require direct external prototypes.")
										drop
										(then (set function (call witness_release_function (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))))
										(else (set function (call witness_direct_function (borrow-shared ast) (borrow-shared nodes)
										row mode (borrow-mut scratch)))))))
							(if (i32.ltz function) (then (return -1i32)))
							(let symbol (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) function
								(borrow-shared mangled_key) (borrow-mut scratch)))
							(let prototype (call type_spelling (borrow-shared ast) (borrow-shared nodes) function (bool false) (borrow-mut scratch)))
							(let pointer (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) name (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) symbol (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) prototype (borrow-mut output) length))
							(set length (call append_field (borrow-shared ast) (borrow-shared nodes) pointer (borrow-mut output) length))
							(if
								(:doc "Every adapted call depends on the same resolved declaration metadata.")
								(u8.not-eq mode plain_function_witness)
								(then (set length (call append_call_attributes (borrow-shared ast) (borrow-shared nodes)
									function (borrow-mut output) length (borrow-mut scratch)))))))
					(if (i32.ltz length) (then (return -1i32)))
					(set row (struct.get (array.load nodes row) next_sibling))))
			(return length)))
)
