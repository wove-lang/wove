				(:doc "A direct forwarder keeps its argument grammar limited to existing reads.")
				(bool:not (bool:or (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared read_cast))
					(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared array_decay_cast))))
				(then (return -1i32)))
			(let reference (call cast_reference (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))
			(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool false) (borrow-mut scratch)))
			(let first (call append_field (borrow-shared ast) (borrow-shared nodes) cast (borrow-mut output) offset))
			(let next (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) first))
			(return (call append_inline_reference (borrow-shared ast) (borrow-shared nodes) function reference
				(borrow-mut output) next (borrow-mut scratch)))))

	(fn inline_call_target
		(:doc "Resolve a body-free native callee or the checked Clang branch-prediction intrinsic.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (callee i32) (allow_hint bool)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let reference (call cast_reference (borrow-shared ast) (borrow-shared nodes) callee (borrow-mut scratch)))
			(let target (call referenced_function (borrow-shared ast) (borrow-shared nodes) reference (borrow-mut scratch)))
			(if (i32:ltz target) (then (return -1i32)))
			(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) callee
				(borrow-shared cast_key) (borrow-mut scratch)))
			(let implicit (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) target
				(borrow-shared implicit_key) (borrow-mut scratch)))
			(if
				(:doc "An intrinsic must be Clang's implicit builtin with its own checked signature.")
				(bool:and allow_hint (call field_equals (borrow-shared ast) (borrow-shared nodes) cast
					(borrow-shared builtin_call_cast)))
				(then
					(if
						(:doc "Use the intrinsic's own declaration as its identity.")
						(call expect_intrinsic (borrow-shared ast) (borrow-shared nodes) target (borrow-mut scratch))
						(then (return target)))
					(return -1i32)))
			(if
				(:doc "An ordinary call must decay a declared, body-free external function.")
				(bool:and (i32:ltz implicit) (bool:and
					(call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared decay_cast))
					(u8:not-eqz (call function_declaration_mode (borrow-shared ast) (borrow-shared nodes)
						target plain_function_witness (borrow-mut scratch)))))
				(then (return target)))
			(return -1i32)))

	(fn append_forwarding_body
		(:doc "Compare the sole call's linked target and the exact ordered operand reads in each context.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (function i32) (call_row i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let callee (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) call_row (borrow-mut scratch)))
			(let target (call inline_call_target (borrow-shared ast) (borrow-shared nodes) callee
				(bool false) (borrow-mut scratch)))
			(if (i32:ltz target) (then (return -1i32)))
			(let start (call append_identity_span (borrow-shared call_kind) 0i32 call_kind.len (borrow-mut output) offset))
			(let-mut length (call append_declaration (borrow-shared ast) (borrow-shared nodes) target (bool true)
				(borrow-mut output) start (borrow-mut scratch)))
			(set length (call append_call_attributes (borrow-shared ast) (borrow-shared nodes) target
				(borrow-mut output) length (borrow-mut scratch)))
