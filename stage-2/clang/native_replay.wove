					(set length (call append_forwarded_argument (borrow-shared ast) (borrow-shared nodes) function argument
						(borrow-mut output) length (borrow-mut scratch)))
					(set argument (struct:get (nodes.get argument) next_sibling))))
			(return length)))

	(fn append_expression_field
		(:doc "Record a stable scalar field when Clang supplies it, including the field name.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32) (key (shared-array u8))
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
