(module clang_macro_directives
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Verify that selected macro definitions can substitute scalar argument tokens without rewriting them.")

	(use wove-file "./macro_replay.wove" (only (value macro_guard_prefix)))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let define_prefix "#define ")
	(let scalar_punctuation "()+-*/%<>=!&|^~?:")
	(struct MacroLine (fields (first i32) (last i32) (end i32) (next i32)))

	(fn read_macro_line
		(:doc "Read one compiler output line and its exact directive name, when present.")
		(params (source (shared-array u8)) (start i32) (prefix (shared-array u8))) (returns MacroLine)
		(body
			(let-mut end start)
			(while
				(:doc "Clang emits one normalized macro definition per physical output line.")
				(bool:and (end.lt source.len) (u8:not-eq (source.get end) 10u8))
				(body (set end end.inc)))
			(let first (start.add prefix.len))
			(let-mut last first)
			(if
				(:doc "Require the exact directive followed immediately by a C identifier.")
				(bool:and (first.lt end)
					(bool:and (call is_c_identifier_start (source.get first))
						(call same_bytes (borrow-shared source) start first (borrow-shared prefix) 0i32 prefix.len)))
				(then
					(while
						(:doc "Keep the function-like parameter parenthesis outside the directive name.")
						(bool:and (last.lt end) (call is_c_identifier_byte (source.get last)))
						(body (set last last.inc)))))
			(return (MacroLine.new (first first) (last last) (end end)
				(next (if (end.lt source.len) (then end.inc) (else end)))))))

	(fn declares_macro_probe
		(:doc "Only exact native spellings emitted as private probe guards can enter the special audit.")
		(params (probe (shared-array u8)) (name (shared-array u8))) (returns bool)
		(body
			(let-mut start 0i32)
			(while
				(:doc "A guard is independent of the Wove name or an import alias.")
				(start.lt probe.len)
				(body
					(let guard (call read_macro_line (borrow-shared probe) start (borrow-shared macro_guard_prefix)))
					(if
						(:doc "Do not match a substring of a selected macro spelling.")
						(bool:and (guard/last.eq guard/end)
							(call same_bytes (borrow-shared probe) guard/first guard/last
								(borrow-shared name) 0i32 name.len))
						(then (return (bool true))))
					(set start guard/next)))
			(return (bool false))))

	(fn macro_space
		(:doc "Skip only horizontal whitespace inside a single normalized definition.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "Never consume a token beyond the supplied line.")
				(bool:and (cursor.lt end)
					(bool:or (u8:eq (source.get cursor) 32u8) (u8:eq (source.get cursor) 9u8)))
				(body (set cursor cursor.inc)))
			(return cursor)))

	(fn macro_digit
		(:doc "Recognize the opening byte of an ordinary numeric preprocessing token.")
		(params (byte u8)) (returns bool)
		(body (return (bool:and (byte.not-lt 48u8) (byte.lt 58u8)))))

	(fn macro_identifier_end
		(:doc "Advance over one counted C identifier or numeric token suffix.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "The first nonidentifier byte terminates the token.")
				(bool:and (cursor.lt end) (call is_c_identifier_byte (source.get cursor)))
				(body (set cursor cursor.inc)))
			(return cursor)))

	(fn fixed_macro_formals_end
		(:doc "Read the closing parenthesis of a fixed list of C identifiers.")
		(params (source (shared-array u8)) (first i32) (end i32)) (returns i32)
		(body
			(let-mut start (call macro_space (borrow-shared source) first end))
			(if
				(:doc "An empty parameter list is still a fixed function-like macro.")
				(bool:and (start.lt end) (u8:eq (source.get start) 41u8))
				(then (return start)))
			(while
				(:doc "A parameter list may contain names separated by commas, with no ellipsis.")
				(bool:and (start.lt end) (call is_c_identifier_start (source.get start)))
				(body
					(let last (call macro_identifier_end (borrow-shared source) start end))
					(let after (call macro_space (borrow-shared source) last end))
					(if (after.eq end) (then (return -1i32)))
					(let next (source.get after))
					(if (next.eq 41u8) (then (return after)))
					(if (next.not-eq 44u8) (then (return -1i32)))
					(set start (call macro_space (borrow-shared source) after.inc end))))
			(return -1i32)))

	(fn names_macro_formal
		(:doc "A replacement token may read an exact member of the already checked list.")
		(params (source (shared-array u8)) (formals i32) (limit i32) (first i32) (last i32)) (returns bool)
		(body
			(let-mut cursor (call macro_space (borrow-shared source) formals limit))
			(while
				(:doc "The parser has certified the separating commas and every identifier.")
				(cursor.lt limit)
				(body
					(let end (call macro_identifier_end (borrow-shared source) cursor limit))
					(if (call same_bytes (borrow-shared source) cursor end (borrow-shared source) first last)
						(then (return (bool true))))
					(let comma (call macro_space (borrow-shared source) end limit))
					(if (comma.eq limit) (then (return (bool false))))
					(set cursor (call macro_space (borrow-shared source) comma.inc limit))))
			(return (bool false))))

	(fn known_numeric_macro
		(:doc "Accept an independent token only if all its visible definitions are single numeric tokens.")
		(params (source (shared-array u8)) (first i32) (last i32)) (returns bool)
		(body
			(let-mut found (bool false))
			(let-mut cursor 0i32)
			(while
				(:doc "Include Clang predefines, user options, and definitions from the real header context.")
				(cursor.lt source.len)
				(body
					(let row (call read_macro_line (borrow-shared source) cursor (borrow-shared define_prefix)))
					(let last_byte row/last)
					(if
						(:doc "An exact match contributes only an object-like replacement with a single numeric token.")
						(bool:and (row/first.lt last_byte)
							(call same_bytes (borrow-shared source) row/first last_byte
								(borrow-shared source) first last))
						(then
							(let line_end row/end)
							(let value (call macro_space (borrow-shared source) last_byte line_end))
							(if
								(:doc "A replacement starting with punctuation or another name can change token substitution.")
								(bool:or (value.eq last_byte)
									(bool:or (value.eq line_end) (bool:not (call macro_digit (source.get value)))))
								(then (return (bool false))))
							(let token_end (call macro_identifier_end (borrow-shared source) value line_end))
							(if (i32:not-eq (call macro_space (borrow-shared source) token_end line_end) line_end)
								(then (return (bool false))))
							(set found (bool true))))
					(set cursor row/next)))
			(return found)))

	(fn is_scalar_punctuation
		(:doc "Allow the punctuation that can compose scalar expressions. Clang checks the parsed operators.")
		(params (byte u8)) (returns bool)
		(body
			(for
				(:doc "The listed bytes exclude statement, call-separator, and preprocessor operators.")
				(let token) (borrow-shared scalar_punctuation)
				(body (if (token.eq byte) (then (return (bool true))))))
			(return (bool false))))

	(fn substitutable_definition
		(:doc "Require a fixed replacement using formal reads, scalar punctuation, and numeric operands.")
		(params (source (shared-array u8)) (formals_open i32) (end i32)) (returns bool)
		(body
			(if
				(:doc "A function-like definition has no space before the opening parenthesis.")
				(bool:or (formals_open.ge end) (u8:not-eq (source.get formals_open) 40u8))
				(then (return (bool false))))
			(let formals formals_open.inc)
			(let close (call fixed_macro_formals_end (borrow-shared source) formals end))
			(if close.ltz (then (return (bool false))))
			(let first (call macro_space (borrow-shared source) close.inc end))
			(let-mut cursor first)
			(while
				(:doc "Token pasting, stringification, variadic helpers, and context-sensitive names cannot enter this grammar.")
				(cursor.lt end)
				(body
					(let byte (source.get cursor))
					(if
						(:doc "A numeric token may have a suffix, interpreted by the subsequent Clang probe.")
						(call macro_digit byte)
						(then (set cursor (call macro_identifier_end (borrow-shared source) cursor end)))
						(else
							(if
								(:doc "Each identifier is a formal or a proved object-like numeric definition.")
								(call is_c_identifier_start byte)
								(then
									(let last (call macro_identifier_end (borrow-shared source) cursor end))
									(if
										(:doc "Reject hidden invocations and preprocessor-dependent operands.")
										(bool:not (bool:or (call names_macro_formal (borrow-shared source) formals close cursor last)
											(call known_numeric_macro (borrow-shared source) cursor last)))
										(then (return (bool false))))
									(set cursor last))
								(else
									(if
										(:doc "The digraph for a preprocessor hash is outside scalar punctuation.")
										(bool:or (bool:not (call is_scalar_punctuation byte))
											(bool:and (byte.eq 37u8)
												(bool:and (cursor.inc.lt end)
													(u8:eq (source.get cursor.inc) 58u8))))
										(then (return (bool false))))
									(set cursor cursor.inc)))))
					(set cursor (call macro_space (borrow-shared source) cursor end))))
			(return (first.lt end))))

	(fn safe_macro_definitions
		(:doc "Require every requested macro spelling to have a safe definition in this complete preprocessor capture.")
		(params (source (shared-array u8)) (probe (shared-array u8))) (returns i32)
		(body
			(let-mut requested 0i32)
			(let-mut start 0i32)
			(while
				(:doc "The generator emits one guard for each typed observation.")
				(start.lt probe.len)
				(body
					(let guard (call read_macro_line (borrow-shared probe) start (borrow-shared macro_guard_prefix)))
					(set start guard/next)
					(if
						(:doc "Only the complete selected names enter the definition audit.")
						(guard/first.lt guard/last)
						(then
							(let-mut found (bool false))
							(let-mut cursor 0i32)
							(while
								(:doc "A redefinition from a subsequent implicit include must also be safe.")
								(cursor.lt source.len)
								(body
									(let row (call read_macro_line (borrow-shared source) cursor (borrow-shared define_prefix)))
									(set cursor row/next)
									(if
										(:doc "Only definitions with this exact name can affect the typed invocation.")
										(bool:and (row/first.lt row/last)
											(call same_bytes (borrow-shared source) row/first row/last
												(borrow-shared probe) guard/first guard/last))
										(then
											(if
												(:doc "Do not certify this native spelling through a different macro grammar.")
												(bool:not (call substitutable_definition (borrow-shared source)
													row/last row/end))
												(then (return -1i32)))
											(set found (bool true))))))
							(if found.not (then (return -1i32)))
							(set requested requested.inc)))))
			(return requested)))
)
