(module clang_variadic_replay
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Record the called variadic declaration and the C types after Clang converts its complete argument list.")

	(use wove-file "./fields.wove" (only clang_field clang_inner field_equals field_in (value clang_name_key)))
	(use wove-file "./macro_replay.wove" (only prototype_probe_expression))
	(use wove-file "./native_replay.wove" (only append_field function_declaration_mode has_kind peel_parens
		referenced_function same_field single_inner type_spelling witness_name
		(value call_kind) (value cast_kind) (value cast_key) (value decay_cast) (value id_key) (value mangled_key)
		(value parameter_kind) (value reference_key) (value reference_kind) (value variadic_key)
		(value variadic_function_witness)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))

	(let promoted_call_prefix "wove_native_promoted_call_")
	(let promoted_argument_prefix "wove_native_variadic_arg_")
	(let promoted_command_prefix "wove_native_variadic_command_")
	(let conversions "\"LValueToRValue\"\u0000\"NoOp\"\u0000\"IntegralCast\"\u0000\"FloatingCast\"\u0000")
	(let explicit_cast_kind "\"CStyleCastExpr\"")
	(let enumeration_kind "\"EnumDecl\"")
	(let enumerator_kind "\"EnumConstantDecl\"")
	(let constant_expression_kind "\"ConstantExpr\"")
	(let integer_literal_kind "\"IntegerLiteral\"")
	(let constant_value_key "value")
	(struct PromotedCallShape (fields (prefix i32) (index i32) (command i32)))

	(fn decimal_field_end
		(:doc "Find the underscore or end that terminates one field of a witness name.")
		(params (ast (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "The next field begins after this separator.")
				(bool:and (cursor.lt end) (u8:not-eq (ast.get cursor) 95u8))
				(body (set cursor cursor.inc)))
			(return cursor)))

	(fn read_index
		(:doc "Decode one complete nonnegative i32 index from a witness name.")
		(params (ast (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let decoded (call read_decimal_digits (borrow-shared ast) start end 214748364u32 7u32))
			(if decoded/digits.ltz (then (return -1i32)))
			(return (i32:from-u32 decoded/magnitude))))

	(fn observed_call_shape
		(:doc "Recover the native prefix, graph index, and any hidden command's native position.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (name i32)) (returns PromotedCallShape)
		(body
			(let rejected (struct:new PromotedCallShape (prefix -1i32) (index -1i32) (command -1i32)))
			(let token (nodes.get name))
			(let start (token/start.inc.add promoted_call_prefix.len))
			(let end token/end.dec)
			(let prefix_end (call decimal_field_end (borrow-shared ast) start end))
			(if (prefix_end.inc.ge end) (then (return rejected)))
			(let prefix (call read_index (borrow-shared ast) start prefix_end))
			(let index_start prefix_end.inc)
			(let index_end (call decimal_field_end (borrow-shared ast) index_start end))
			(let index (call read_index (borrow-shared ast) index_start index_end))
			(if (prefix.not-gtz.or index.ltz) (then (return rejected)))
			(let-mut command -1i32)
			(if
				(:doc "A third field must designate a command within the fixed prefix.")
				(index_end.lt end)
				(then
					(set command (call read_index (borrow-shared ast) index_end.inc end))
					(if (command.ltz.or (command.ge prefix)) (then (return rejected)))))
			(return (struct:new PromotedCallShape (prefix prefix) (index index) (command command)))))

	(fn observed_operand_index
		(:doc "Read the numeric suffix of a captured formal or a folded command witness.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (name i32) (prefix (shared-array u8)))
		(returns i32)
		(body
			(if name.ltz (then (return -1i32)))
			(let token (nodes.get name))
			(let start token/start.inc)
			(let digits (start.add prefix.len))
			(let end token/end.dec)
			(if
				(:doc "Require the generated prefix and a nonempty numeric suffix.")
				(bool:or (digits.ge end) (bool:not (call same_bytes (borrow-shared ast) start digits
					(borrow-shared prefix) 0i32 prefix.len)))
				(then (return -1i32)))
			(return (call read_index (borrow-shared ast) digits end))))

	(fn variadic_target
		(:doc "Resolve the call's direct variadic function and verify its fixed prototype boundary.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (callee i32) (fixed i32)
			(scratch (mut-array u8))) (returns i32)
		(body
			(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes)
				callee (borrow-shared cast_key) (borrow-mut scratch)))
			(if
				(:doc "A direct invocation decays precisely the named function to its prototype pointer.")
				(bool:not (call field_equals (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared decay_cast)))
				(then (return -1i32)))
			(let operand (call peel_parens (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) callee (borrow-mut scratch)) (borrow-mut scratch)))
			(if
				(:doc "Indirect calls and expressions wrapping a different callee cannot prove this contract.")
				(bool:not (call has_kind (borrow-shared ast) (borrow-shared nodes) operand
					(borrow-shared reference_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let declaration (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) operand
				(borrow-shared reference_key) (borrow-mut scratch)))
			(let function (call referenced_function (borrow-shared ast) (borrow-shared nodes) declaration (borrow-mut scratch)))
			(let variadic (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) function
				(borrow-shared variadic_key) (borrow-mut scratch)))
			(if
				(:doc "Only an external variadic declaration with the approved attributes can supply the call target.")
				(bool:or (function.ltz.or variadic.ltz)
					(bool:or (u32:not-eq (struct:get (nodes.get variadic) kind) 5u32)
						(u8:eqz (call function_declaration_mode (borrow-shared ast) (borrow-shared nodes)
							function variadic_function_witness (borrow-mut scratch)))))
				(then (return -1i32)))
			(let-mut formal (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) function (borrow-mut scratch)))
			(let-mut count 0i32)
			(while
				(:doc "Only the declaration's original parameters precede the ellipsis.")
				formal.not-ltz
				(body
					(if
						(:doc "Declaration metadata does not consume a fixed argument position.")
						(call has_kind (borrow-shared ast) (borrow-shared nodes) formal
							(borrow-shared parameter_kind) (borrow-mut scratch))
						(then (set count count.inc)))
					(set formal (struct:get (nodes.get formal) next_sibling))))
			(if (count.not-eq fixed) (then (return -1i32)))
			(return function)))

	(fn append_promoted_argument
		(:doc "Compare Clang's conversion chain from the typed lvalue through the actual terminal argument type.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (argument i32) (ordinal i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let-mut row argument)
			(let-mut length offset)
			(while
				(:doc "Record every implicit scalar conversion, including the default promotion at the C ellipsis.")
				(length.not-ltz.and (call has_kind (borrow-shared ast) (borrow-shared nodes) row
					(borrow-shared cast_kind) (borrow-mut scratch)))
				(body
					(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
						(borrow-shared cast_key) (borrow-mut scratch)))
					(if
						(:doc "Only scalar promotions and direct lvalue reads are expected for eligible arguments.")
						(bool:not (call field_in (borrow-shared ast) (borrow-shared nodes) cast (borrow-shared conversions)))
						(then (return -1i32)))
					(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
					(set length (call append_field (borrow-shared ast) (borrow-shared nodes) cast (borrow-mut output) length))
					(set length (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) length))
					(set row (call single_inner (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch)))))
			(let reference (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) row
				(borrow-shared reference_key) (borrow-mut scratch)))
			(let name (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) reference
				(borrow-shared clang_name_key) (borrow-mut scratch)))
			(if
				(:doc "The terminal operand must be the corresponding captured formal.")
				(name.ltz.or
					(bool:not (call has_kind (borrow-shared ast) (borrow-shared nodes) reference
						(borrow-shared parameter_kind) (borrow-mut scratch))))
				(then (return -1i32)))
			(if
				(:doc "Detect reordered or substituted operands in the typed call.")
				(i32:not-eq (call observed_operand_index (borrow-shared ast) (borrow-shared nodes) name
					(borrow-shared promoted_argument_prefix)) ordinal)
				(then (return -1i32)))
			(set length (call append_field (borrow-shared ast) (borrow-shared nodes) name (borrow-mut output) length))
			(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) row (bool true) (borrow-mut scratch)))
			(return (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) length))))

	(fn command_operand
		(:doc "Identify the integer token or enum constant actually used by a command cast.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (cast i32) (scratch (mut-array u8))) (returns i32)
		(body
			(if (bool:not (call has_kind (borrow-shared ast) (borrow-shared nodes) cast
				(borrow-shared explicit_cast_kind) (borrow-mut scratch))) (then (return -1i32)))
			(let operand (call peel_parens (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) cast (borrow-mut scratch))
				(borrow-mut scratch)))
			(if
				(:doc "Check the actual expansion so a context-sensitive macro cannot supply another value when folded.")
				(call has_kind (borrow-shared ast) (borrow-shared nodes) operand
					(borrow-shared integer_literal_kind) (borrow-mut scratch))
				(then (return (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) operand
					(borrow-shared constant_value_key) (borrow-mut scratch)))))
			(if (bool:not (call has_kind (borrow-shared ast) (borrow-shared nodes) operand
				(borrow-shared reference_kind) (borrow-mut scratch))) (then (return -1i32)))
			(let reference (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) operand
				(borrow-shared reference_key) (borrow-mut scratch)))
			(if
				(:doc "A C enum constant has one value and one declaration within the replayed context.")
				(call has_kind (borrow-shared ast) (borrow-shared nodes) reference
					(borrow-shared enumerator_kind) (borrow-mut scratch))
				(then (return (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) reference
					(borrow-shared id_key) (borrow-mut scratch)))))
			(return -1i32)))

	(fn append_command_argument
		(:doc "Compare the native argument's explicit type and the folded value of the same header expression.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (argument i32) (enumeration i32)
			(index i32) (output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(if
				(:doc "The native fixed parameter must accept the explicit command type without another conversion.")
				(bool:not (bool:and (call has_kind (borrow-shared ast) (borrow-shared nodes) argument
						(borrow-shared explicit_cast_kind) (borrow-mut scratch))
					(call has_kind (borrow-shared ast) (borrow-shared nodes) enumeration
						(borrow-shared enumeration_kind) (borrow-mut scratch))))
				(then (return -1i32)))
			(let constant (call single_inner (borrow-shared ast) (borrow-shared nodes) enumeration (borrow-mut scratch)))
			(let name (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) constant
				(borrow-shared clang_name_key) (borrow-mut scratch)))
			(let expression (call single_inner (borrow-shared ast) (borrow-shared nodes) constant (borrow-mut scratch)))
			(if
				(:doc "The following declaration must fold the command from this exact invocation witness.")
				(bool:not (bool:and (i32:eq (call observed_operand_index (borrow-shared ast) (borrow-shared nodes) name
						(borrow-shared promoted_command_prefix)) index)
					(bool:and (call has_kind (borrow-shared ast) (borrow-shared nodes) constant
							(borrow-shared enumerator_kind) (borrow-mut scratch))
						(call has_kind (borrow-shared ast) (borrow-shared nodes) expression
							(borrow-shared constant_expression_kind) (borrow-mut scratch)))))
				(then (return -1i32)))
			(let type (call type_spelling (borrow-shared ast) (borrow-shared nodes) argument (bool true) (borrow-mut scratch)))
			(let folded_type (call type_spelling (borrow-shared ast) (borrow-shared nodes) expression (bool true) (borrow-mut scratch)))
			(let actual (call command_operand (borrow-shared ast) (borrow-shared nodes) argument (borrow-mut scratch)))
			(let folded (call command_operand (borrow-shared ast) (borrow-shared nodes)
				(call single_inner (borrow-shared ast) (borrow-shared nodes) expression (borrow-mut scratch))
				(borrow-mut scratch)))
			(if
				(:doc "Tie the folded value to the actual cast in the invocation before comparing contexts.")
				(bool:not (bool:and (call same_field (borrow-shared ast) (borrow-shared nodes) type folded_type)
					(call same_field (borrow-shared ast) (borrow-shared nodes) actual folded)))
				(then (return -1i32)))
			(let cast (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) argument
				(borrow-shared cast_key) (borrow-mut scratch)))
			(let value (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) expression
				(borrow-shared constant_value_key) (borrow-mut scratch)))
			(let typed (call append_field (borrow-shared ast) (borrow-shared nodes) type (borrow-mut output) offset))
			(let converted (call append_field (borrow-shared ast) (borrow-shared nodes) cast (borrow-mut output) typed))
			(return (call append_field (borrow-shared ast) (borrow-shared nodes) value (borrow-mut output) converted))))

	(fn append_promoted_call
		(:doc "Compare the actual native target, its prototype, and the typed argument list in source order.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (row i32) (name i32)
			(output (mut-array u8)) (offset i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let expression (call peel_parens (borrow-shared ast) (borrow-shared nodes)
				(call prototype_probe_expression (borrow-shared ast) (borrow-shared nodes) row (borrow-mut scratch))
				(borrow-mut scratch)))
			(if
				(:doc "An invocation witness contains one ordinary call expression.")
				(bool:not (call has_kind (borrow-shared ast) (borrow-shared nodes) expression
					(borrow-shared call_kind) (borrow-mut scratch)))
				(then (return -1i32)))
			(let shape (call observed_call_shape (borrow-shared ast) (borrow-shared nodes) name))
			(let fixed shape/prefix)
			(let command shape/command)
			(let callee (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) expression (borrow-mut scratch)))
			(let target (call variadic_target (borrow-shared ast) (borrow-shared nodes) callee fixed (borrow-mut scratch)))
			(if (target.ltz.or fixed.not-gtz) (then (return -1i32)))
			(let symbol (call clang_field (borrow-shared ast) 0i32 (borrow-shared nodes) target
				(borrow-shared mangled_key) (borrow-mut scratch)))
			(let prototype (call type_spelling (borrow-shared ast) (borrow-shared nodes) target (bool false) (borrow-mut scratch)))
			(let actual (call type_spelling (borrow-shared ast) (borrow-shared nodes) callee (bool true) (borrow-mut scratch)))
			(let-mut length (call append_field (borrow-shared ast) (borrow-shared nodes) name (borrow-mut output) offset))
			(set length (call append_field (borrow-shared ast) (borrow-shared nodes) symbol (borrow-mut output) length))
			(set length (call append_field (borrow-shared ast) (borrow-shared nodes) prototype (borrow-mut output) length))
			(set length (call append_field (borrow-shared ast) (borrow-shared nodes) actual (borrow-mut output) length))
			(let-mut position 0i32)
			(let-mut argument (struct:get (nodes.get callee) next_sibling))
			(while
				(:doc "Serialize all fixed arguments and the promoted values at the named tail.")
				(argument.not-ltz.and length.not-ltz)
				(body
					(if
						(:doc "The implicit command is a folded constant. All other operands are captures.")
						(position.eq command)
						(then (set length (call append_command_argument (borrow-shared ast) (borrow-shared nodes)
							argument (struct:get (nodes.get row) next_sibling) shape/index
							(borrow-mut output) length (borrow-mut scratch))))
						(else (set length (call append_promoted_argument (borrow-shared ast) (borrow-shared nodes)
							argument position (borrow-mut output) length (borrow-mut scratch)))))
					(set argument (struct:get (nodes.get argument) next_sibling))
					(set position position.inc)))
			(if (fixed.not-lt position) (then (return -1i32)))
			(return length)))

	(fn append_variadic_identities
		(:doc "Compare each checked named-tail invocation in the actual serial and numbered AST contexts.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (output (mut-array u8))
			(offset i32) (expected i32)) (returns i32)
		(body
			(if expected.eqz (then (return offset)))
			(let-mut scratch (array:alloc u8 24i32))
			(let-mut length offset)
			(let-mut count 0i32)
			(let-mut row (call clang_inner (borrow-shared ast) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Validate every selected synthetic invocation exactly once.")
				(row.not-ltz.and length.not-ltz)
				(body
					(let name (call witness_name (borrow-shared ast) (borrow-shared nodes) row
						(borrow-shared promoted_call_prefix) (borrow-mut scratch)))
					(if
						(:doc "Only the generated invocation typedef can establish tail promotions.")
						name.not-ltz
						(then
							(set length (call append_promoted_call (borrow-shared ast) (borrow-shared nodes)
								row name (borrow-mut output) length (borrow-mut scratch)))
							(set count count.inc)))
					(set row (struct:get (nodes.get row) next_sibling))))
			(if (count.not-eq expected) (then (return -1i32)))
			(return length)))
)
