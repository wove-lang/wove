(module clang_include_replay
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Admit only declaration and macro forms that are safe to replay across C units.")

	(use wove-file "./fields.wove" (only clang_field clang_inner field_equals (value clang_kind_key)))
	(use wove-file "./macro_directives.wove" (only declares_macro_probe))
	(use wove-file "./native_replay.wove" (only external_object ordinary_function_mode
		mark_witnessed_declarations proved_lvalue_macro (value plain_declaration)))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier_start is_c_identifier_byte))
	(use wove-file "../json/reader.wove" (only json_parse (type JsonNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let define_word "define ")
	(let unit_kind "\"TranslationUnitDecl\"")
	(let typedef_kind "\"TypedefDecl\"")
	(let record_kind "\"RecordDecl\"")
	(let object_kind "\"VarDecl\"")
	(let object_name_key "name")
	(let enum_kind "\"EnumDecl\"")
	(let function_kind "\"FunctionDecl\"")

	(fn horizontal_space
		(:doc "Recognize whitespace that cannot end a preprocessor line.")
		(params (byte u8)) (returns bool)
		(body (return (bool:or (u8:eq byte 32u8) (u8:eq byte 9u8)))))

	(fn digit
		(:doc "Recognize a decimal digit in an inert macro replacement.")
		(params (byte u8)) (returns bool)
		(body (return (bool:and (u8:not-lt byte 48u8) (u8:lt byte 58u8)))))

	(fn hex_digit
		(:doc "Recognize one ASCII hexadecimal digit without crossing the current token.")
		(params (byte u8)) (returns bool)
		(body (return (bool:or (call digit byte)
			(bool:or (bool:and (u8:not-lt byte 65u8) (u8:lt byte 71u8))
				(bool:and (u8:not-lt byte 97u8) (u8:lt byte 103u8)))))))

	(fn integer_token_end
		(:doc "Find the end of one decimal, octal, or hexadecimal toolchain flag literal.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut index start)
			(if
				(:doc "A hexadecimal token requires a leading zero, an x, and at least one digit.")
				(bool:and (i32:lt 1i32 (i32:sub end start))
					(bool:and (u8:eq (source.get start) 48u8)
						(bool:or (u8:eq (source.get (i32:inc start)) 120u8)
							(u8:eq (source.get (i32:inc start)) 88u8))))
				(then
					(let first (i32:add start 2i32))
					(set index first)
					(while
						(:doc "Stop at the first byte outside the hexadecimal integer.")
						(bool:and (i32:lt index end) (call hex_digit (source.get index)))
						(body (set index (i32:inc index))))
					(if (i32:eq index first) (then (return start)))
					(return index)))
			(while
				(:doc "Decimal and octal tokens contain only digits.")
				(bool:and (i32:lt index end) (call digit (source.get index)))
				(body (set index (i32:inc index))))
			(return index)))

	(fn skip_horizontal
		(:doc "Advance to the next nonspace byte inside one line.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut index start)
			(while
				(:doc "Leave the end exclusive even on whitespace-only lines.")
				(bool:and (i32:lt index end) (call horizontal_space (source.get index)))
				(body (set index (i32:inc index))))
			(return index)))

	(fn names_external_object
		(:doc "Resolve one bare macro replacement to a definition-free external C object in the audited AST.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (name (shared-array u8)))
		(returns bool)
		(body
			(if (i32:eqz nodes.len) (then (return (bool false))))
			(let-mut scratch (array:alloc u8 12i32))
			(let-mut row (call clang_inner (borrow-shared source) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(while
				(:doc "Only top-level external declarations can give each translation unit the same live slot.")
				(i32:not-ltz row)
				(body
					(let kind (call clang_field (borrow-shared source) 0i32 (borrow-shared nodes) row
						(borrow-shared clang_kind_key) (borrow-mut scratch)))
					(if
						(:doc "Types and functions cannot satisfy a borrowed object alias.")
						(call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared object_kind))
						(then
							(let field (call clang_field (borrow-shared source) 0i32 (borrow-shared nodes) row
								(borrow-shared object_name_key) (borrow-mut scratch)))
							(if
								(:doc "Clang quotes the direct identifier in the JSON name field.")
								(i32:not-ltz field)
								(then
									(let span (nodes.get field))
									(if
										(:doc "Match the original native identifier and its external linkage.")
										(bool:and
										(call same_bytes (borrow-shared source) (i32:inc (span.get start)) (i32:dec (span.get end))
											(borrow-shared name) 0i32 name.len)
										(call external_object (borrow-shared source) (borrow-shared nodes) row (borrow-mut scratch)))
										(then (return (bool true))))))))
					(set row (struct:get (nodes.get row) next_sibling))))
			(return (bool false))))

	(fn harmless_define
		(:doc "Permit inert definitions and the selected native operands verified by Clang.")
		(params (source (shared-array u8)) (start i32) (end i32)
			(ast (shared-array u8)) (nodes (shared-array JsonNode)) (borrowed bool) (writable bool)
			(macros (shared-array u8))) (returns bool)
		(body
			(let word (call skip_horizontal (borrow-shared source) (i32:inc start) end))
			(let width define_word.len)
			(if (i32:lt (i32:sub end word) width) (then (return (bool false))))
			(let name (i32:add word width))
			(if
				(:doc "Require a real object-like definition instead of accepting an unrelated directive.")
				(bool:not (call same_bytes (borrow-shared source) word name (borrow-shared define_word) 0i32 width))
				(then (return (bool false))))
			(let first (call skip_horizontal (borrow-shared source) name end))
			(if
				(:doc "A macro needs at least one valid identifier byte.")
				(bool:or (i32:eq first end) (bool:not (call is_c_identifier_start (source.get first))))
				(then (return (bool false))))
			(let-mut index (i32:inc first))
			(while
				(:doc "Scan the name without accepting a function-like parameter list.")
				(bool:and (i32:lt index end) (call is_c_identifier_byte (source.get index)))
				(body (set index (i32:inc index))))
			(let macro_end index)
			(let value (call skip_horizontal (borrow-shared source) macro_end end))
			(if (i32:eq value end) (then (return (bool true))))
			(if
				(:doc "The separately checked expression-macro probe alone can admit a function-like definition.")
				(i32:eq value index)
				(then (return (bool:and (u8:eq (source.get index) 40u8)
					(call declares_macro_probe (borrow-shared macros) (borrow-shared (source.range first macro_end)))))))
			(set index value)
			(if
				(:doc "A single integer token cannot refer to file, line, or library state.")
				(call digit (source.get value))
				(then
					(let token_end (call integer_token_end (borrow-shared source) value end))
					(return (i32:eq (call skip_horizontal (borrow-shared source) token_end end) end))))
			(if
				(:doc "A selected object-like lvalue may expand to a proved external getter.")
				(bool:and writable (call proved_lvalue_macro (borrow-shared ast) (borrow-shared nodes)
					(borrow-shared (source.range first macro_end))))
				(then (return (bool true))))
			(if
				(:doc "Only borrowed-object replay can admit an identifier replacement.")
				(bool:or (bool:not borrowed) (bool:not (call is_c_identifier_start (source.get value))))
				(then (return (bool false))))
			(while
				(:doc "A direct alias names one C object without invoking or composing another expression.")
				(bool:and (i32:lt index end) (call is_c_identifier_byte (source.get index)))
				(body (set index (i32:inc index))))
			(return (bool:and (i32:eq (call skip_horizontal (borrow-shared source) index end) end)
				(call names_external_object (borrow-shared ast) (borrow-shared nodes)
					(borrow-shared (source.range value index)))))))

	(fn replay_directives_safe
		(:doc "Check added directives, with external alias resolution only when the caller supplies a checked AST.")
		(params (source (shared-array u8)) (start i32)
			(ast (shared-array u8)) (nodes (shared-array JsonNode)) (borrowed bool) (writable bool)
			(macros (shared-array u8))) (returns bool)
		(body
			(let length source.len)
			(let-mut index start)
			(while
				(:doc "Check each complete directive even when it follows ordinary declarations.")
				(i32:lt index length)
				(body
					(let-mut end index)
					(while
						(:doc "Clang emits physical output lines with LF separators.")
						(bool:and (i32:lt end length) (u8:not-eq (source.get end) 10u8))
						(body (set end (i32:inc end))))
					(let first (call skip_horizontal (borrow-shared source) index end))
					(if
						(:doc "Preprocessing directives left visible by Clang can change later generated C.")
						(bool:and (i32:lt first end) (u8:eq (source.get first) 35u8))
						(then
							(if
								(:doc "A directive that can change the generated context requires serial emission.")
								(bool:not (call harmless_define (borrow-shared source) first end
								(borrow-shared ast) (borrow-shared nodes) borrowed writable (borrow-shared macros)))
								(then (return (bool false))))))
					(set index end)
					(if (i32:lt index length) (then (set index (i32:inc index))))))
			(return (bool true))))

	(fn declaration_mode
		(:doc "Admit replayable types and prototypes and mark declarations that require identity checks.")
		(params (source (shared-array u8)) (nodes (shared-array JsonNode)) (row i32) (scratch (mut-array u8)) (borrowed bool))
		(returns u8)
		(body
			(let kind (call clang_field (borrow-shared source) 0i32 (borrow-shared nodes) row
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if
				(:doc "Type declarations allocate no storage or body in a translation unit.")
				(bool:or (call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared typedef_kind))
					(bool:or (call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared record_kind))
						(call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared enum_kind))))
				(then (return plain_declaration)))
			(if
				(:doc "An ordinary extern declaration does not instantiate a separate object per numbered unit.")
				(bool:and borrowed (call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared object_kind)))
				(then
					(return (if
						(:doc "An admitted object needs no additional prototype comparison.")
						(call external_object (borrow-shared source) (borrow-shared nodes) row (borrow-mut scratch))
						(then plain_declaration)
						(else 0u8)))))
			(if
				(:doc "Any remaining declaration must be an externally linked function.")
				(bool:not (call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared function_kind)))
				(then (return 0u8)))
			(return (call ordinary_function_mode (borrow-shared source) (borrow-shared nodes) row (borrow-mut scratch)))))

	(fn replay_declaration_mode
		(:doc "Validate the complete AST and return the strongest required ordinary declaration proof.")
		(params (source (shared-array u8)) (nodes (mut-array JsonNode))
			(borrowed bool) (writable bool) (fixed_calls bool) (variadic_calls bool)) (returns u8)
		(body
			(let result (call json_parse (borrow-shared source) (borrow-mut nodes)))
			(if (u32:not-eqz (result.get error)) (then (return 0u8)))
			(let-mut scratch (array:alloc u8 24i32))
			(let kind (call clang_field (borrow-shared source) 0i32 (borrow-shared nodes) 0i32
				(borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if
				(:doc "Only a translation-unit root establishes the complete declaration context.")
				(bool:not (call field_equals (borrow-shared source) (borrow-shared nodes) kind (borrow-shared unit_kind)))
				(then (return 0u8)))
			(let permits_attributes (bool:or writable (bool:or fixed_calls variadic_calls)))
			(let approval_buffer (array:try-alloc u8 (if permits_attributes (then (result.get rows)) (else 0i32))))
			(if (owner:is-null approval_buffer) (then (return 0u8)))
			(let-mut approved (move (optional:unwrap approval_buffer)))
			(if
				(:doc "Resolve declarations whose special call or storage semantics need an explicit witness.")
				(bool:and permits_attributes (bool:not (call mark_witnessed_declarations
					(borrow-shared source) (borrow-shared nodes) (borrow-mut approved)
					writable fixed_calls variadic_calls (borrow-mut scratch))))
				(then (return 0u8)))
			(let-mut row (call clang_inner (borrow-shared source) 0i32 (borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(let-mut result_mode plain_declaration)
			(while
				(:doc "Reject declarations outside the supported prototype and forwarding rules.")
				(i32:not-ltz row)
				(body
					(let mode (if
						(:doc "Approved witnesses already arrange an identity comparison for their declarations.")
						(bool:and permits_attributes (u8:gtz (approved.get row)))
						(then plain_declaration)
						(else (call declaration_mode (borrow-shared source) (borrow-shared nodes) row
							(borrow-mut scratch) borrowed))))
					(if (u8:eqz mode) (then (return 0u8)))
					(if (u8:lt result_mode mode) (then (set result_mode mode)))
					(set row (struct:get (nodes.get row) next_sibling))))
			(return result_mode)))
)
