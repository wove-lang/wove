(module clang_macro_capture
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Match original object-like macro names in Clang's final preprocessor definitions.")

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct MacroValue (fields (start i32) (end i32)))
	(let define_prefix "#define ")
	(let header_present "WVPR_HEADER_PRESENT")

	(fn macro_line_end
		(:doc "Find the end of a definition line inside the complete capture.")
		(params (capture (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "An unterminated final line still ends at the capture boundary.")
				(bool:and (i32:lt cursor capture.len)
					(u8:not-eq (capture.get cursor) 10u8))
				(body (set cursor (i32:inc cursor))))
			(return cursor)))

	(fn object_macro_value
		(:doc "Find the nonempty replacement span for an exact object-like macro name.")
		(params (capture (shared-array u8)) (name (shared-array u8))) (returns MacroValue)
		(body
			(let prefix_width define_prefix.len)
			(let name_width name.len)
			(let-mut line 0i32)
			(while
				(:doc "Compare the definition prefix, exact name, and its separating space within one line.")
				(i32:lt line capture.len)
				(body
					(let end (call macro_line_end (borrow-shared capture) line))
					(let name_start (i32:add line prefix_width))
					(if
						(:doc "A complete object-like definition has room for a name, a space, and a replacement.")
						(i32:lt name_width (i32:dec (i32:sub end name_start)))
						(then
							(let name_end (i32:add name_start name_width))
							(if
								(:doc "The space after the name excludes function-like macros and longer names.")
								(bool:and (u8:eq (capture.get name_end) 32u8)
									(bool:and (call same_bytes (borrow-shared capture) line name_start
										(borrow-shared define_prefix) 0i32 prefix_width)
										(call same_bytes (borrow-shared capture) name_start name_end
											(borrow-shared name) 0i32 name_width)))
								(then (return (struct:new MacroValue (start (i32:inc name_end)) (end end)))))))
					(set line (i32:inc end))))
			(return (struct:new MacroValue (start -1i32) (end -1i32)))))

	(fn macro_header_presence
		(:doc "Read the probe's exact presence marker. A missing or malformed marker means invalid output.")
		(params (capture (shared-array u8))) (returns i32)
		(body
			(let width capture.len)
			(let prefix_width define_prefix.len)
			(let-mut line 0i32)
			(while
				(:doc "A complete Clang dump consists of newline-terminated macro definitions.")
				(i32:lt line width)
				(body
					(let end (call macro_line_end (borrow-shared capture) line))
					(let name (i32:add line prefix_width))
					(if
						(:doc "A bare prefix, truncated line, or unrelated output invalidates the capture.")
						(bool:or (i32:eq end width)
							(bool:or (i32:le end name)
								(bool:not (call same_bytes (borrow-shared capture) line name
									(borrow-shared define_prefix) 0i32 prefix_width))))
						(then (return -1i32)))
					(set line (i32:inc end))))
			(let marker (call object_macro_value (borrow-shared capture) (borrow-shared header_present)))
			(let start (marker.get start))
			(if
				(:doc "A complete marker has one digit after its name.")
				(bool:or (i32:ltz start) (i32:not-eq (i32:inc start) (marker.get end)))
				(then (return -1i32)))
			(let value (capture.get start))
			(if (u8:eq value 48u8) (then (return 0i32)))
			(if (u8:eq value 49u8) (then (return 1i32)))
			(return -1i32)))
)
