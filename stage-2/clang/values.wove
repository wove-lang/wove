(module clang_probe_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read an enum probe value from a successful Clang index.

	A named EnumDecl takes precedence over wvpr_c_probe. Use the exact
	member name. The returned value span includes the JSON string quotes and
	can be decoded with json_decode_string for arbitrary-width text.
	clang_probe_u32 decodes a bounded decimal ABI fact.

	Code 16 means no matching enum, 17 means no matching constant, 18
	means no folded string value, and 19 means an invalid u32 value.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "./fields.wove"
		(only clang_field clang_inner (value clang_field_key_capacity) (value clang_name_key) (value clang_value_key)))
	(use wove-file "./index.wove" (only (type ClangIndex) (type ClangDeclaration) clang_declaration))

	(struct ProbeValue (fields (error u32) (start i32) (end i32)))
	(struct ProbeWord (fields (error u32) (start i32) (end i32) (value u32)))

	(let enum_kind "EnumDecl")
	(let fallback_enum "wvpr_c_probe")

	(fn clang_probe_enum
		(:doc "Return the top-level enum named by the probe, or fall back to the shared ABI enum.")
		(params (index ClangIndex) (entries (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8)))
		(returns ClangDeclaration)
		(body
			(let selected (call clang_declaration index (borrow-shared entries) (borrow-shared names)
				(borrow-shared enum_kind) (borrow-shared name)))
			(if
				(:doc "An explicit named enum remains authoritative even if the member is absent.")
				(i32:not-ltz (struct:get selected node))
				(then (return selected)))
			(return (call clang_declaration index (borrow-shared entries) (borrow-shared names)
				(borrow-shared enum_kind) (borrow-shared fallback_enum)))))

	(fn probe_name_matches
		(:doc "Match a direct field's complete decoded string against the requested spelling.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (field i32)
			(name (shared-array u8)) (scratch (mut-array u8)))
		(returns bool)
		(body
			(if
				(:doc "Missing field rows cannot name a probe constant.")
				(i32:ltz field)
				(then (return (bool false))))
			(let value (nodes.get field))
			(if
				(:doc "Clang supplies names as JSON strings.")
				(u32:not-eq (struct:get value kind) 3u32)
				(then (return (bool false))))
			(let decoded (call json_decode_string (borrow-shared source)
				(i32:add base (struct:get value start))
				(i32:add base (struct:get value end))
				(borrow-mut (scratch.range 0i32 name.len))))
			(return (bool:and (u32:eqz (struct:get decoded error))
				(call same_bytes (borrow-shared scratch) 0i32 (struct:get decoded written)
					(borrow-shared name) 0i32 name.len)))))

	(fn probe_span
		(:doc "Retain the absolute span of a selected JSON value or diagnostic.")
		(params (error u32) (start i32) (end i32))
		(returns ProbeValue)
		(body (return (struct:new ProbeValue (error error) (start start) (end end)))))

	(fn folded_probe_value
		(:doc "Follow at most sixteen expression wrappers to the member's folded string value.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (member i32)
			(scratch (mut-array u8)))
		(returns ProbeValue)
		(body
			(let constant (nodes.get member))
			(let-mut expression (call clang_inner (borrow-shared source) base (borrow-shared nodes)
				member (borrow-mut scratch)))
			(let-mut depth 0i32)
			(while
				(:doc "As in the archive, only the first expression child can supply the selected constant.")
				(bool:and (i32:not-ltz expression) (i32:lt depth 17i32))
				(body
					(let selected (call clang_field (borrow-shared source) base
						(borrow-shared nodes) expression (borrow-shared clang_value_key)
						(borrow-mut scratch)))
					(if
						(:doc "A reported value must be a nonempty JSON string.")
						(i32:not-ltz selected)
						(then
							(let value (nodes.get selected))
							(let start (i32:add base (struct:get value start)))
							(let end (i32:add base (struct:get value end)))
							(if
								(:doc "Retain the original string span for exact text and bounded numeric consumers.")
								(bool:and (u32:eq (struct:get value kind) 3u32)
									(i32:lt 2i32 (i32:sub end start)))
								(then (return (call probe_span 0u32 start end))))
							(return (call probe_span 18u32 start end))))
					(set expression (call clang_inner (borrow-shared source) base
						(borrow-shared nodes) expression (borrow-mut scratch)))
					(set depth (i32:inc depth))))
			(return (call probe_span 18u32
				(i32:add base (struct:get constant start))
				(i32:add base (struct:get constant end))))))

	(fn clang_enum_value
		(:doc "Read the exact member's folded value from a previously selected enum.")
		(params (source (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(selected ClangDeclaration) (name (shared-array u8)))
		(returns ProbeValue)
		(body
			(let base (struct:get index start))
			(let enum (struct:get selected node))
			(if
				(:doc "An absent enum is reported at the indexed document span.")
				(i32:ltz enum)
				(then (return (call probe_span 16u32 base (struct:get index end)))))
			(let-mut capacity name.len)
			(if
				(:doc "One buffer must fit both the requested member name and the fixed AST field keys.")
				(i32:lt capacity clang_field_key_capacity)
				(then (set capacity clang_field_key_capacity)))
			(let-mut scratch (array:alloc u8 capacity))
			(let-mut row (call clang_inner (borrow-shared source) base (borrow-shared nodes)
				enum (borrow-mut scratch)))
			(while
				(:doc "Select only a direct, exact member name without decoding unrelated values.")
				(i32:not-ltz row)
				(body
					(let label (call clang_field (borrow-shared source) base
						(borrow-shared nodes) row (borrow-shared clang_name_key)
						(borrow-mut scratch)))
					(if
						(:doc "Use the first matching member of the selected enum.")
						(call probe_name_matches (borrow-shared source) base (borrow-shared nodes) label
							(borrow-shared name) (borrow-mut scratch))
						(then (return (call folded_probe_value (borrow-shared source) base
							(borrow-shared nodes) row (borrow-mut scratch)))))
					(let child (nodes.get row))
					(set row (struct:get child next_sibling))))
			(return (call probe_span 17u32 (struct:get selected start) (struct:get selected end)))))

	(fn clang_probe_value
		(:doc "Find the probe enum using the archive's name preference and read its exact member.")
		(params (source (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(entries (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8)))
		(returns ProbeValue)
		(body
			(let selected (call clang_probe_enum index (borrow-shared entries) (borrow-shared names)
				(borrow-shared name)))
			(return (call clang_enum_value (borrow-shared source) index (borrow-shared nodes)
				selected (borrow-shared name)))))

	(fn clang_probe_u32
		(:doc "Decode a valid probe string as a decimal u32 with the same absolute source span.")
		(params (source (shared-array u8)) (probe ProbeValue))
		(returns ProbeWord)
		(body
			(let start (struct:get probe start))
			(let end (struct:get probe end))
			(let code (struct:get probe error))
			(if
				(:doc "Carry a missing enum or value error without reading its diagnostic span as data.")
				(u32:gtz code)
				(then (return (struct:new ProbeWord (error code) (start start) (end end) (value 0u32)))))
			(let-mut text (array:alloc u8 10i32))
			(let decoded (call json_decode_string (borrow-shared source) start end (borrow-mut text)))
			(let value (call read_decimal_digits (borrow-shared text) 0i32 (struct:get decoded written)
				429496729u32 5u32))
			(if
				(:doc "Reject malformed, oversized, signed, and overflowing decimal values.")
				(bool:or (u32:gtz (struct:get decoded error)) (i32:ltz (struct:get value digits)))
				(then (return (struct:new ProbeWord (error 19u32) (start start) (end end) (value 0u32)))))
			(return (struct:new ProbeWord (error 0u32) (start start) (end end)
				(value (struct:get value magnitude)))))))
