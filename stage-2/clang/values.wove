(module clang_probe_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read an enum probe value from a successful Clang index.

	A named EnumDecl takes precedence over wvpr_c_probe. Use the exact
	member name. The returned value span includes the JSON string quotes and
	can be decoded with json_decode_string for arbitrary-width text.
	clang_probe_u32 decodes a bounded decimal ABI fact.

	Code 16 means no matching enum, 17 means no matching constant, 18
	means no folded string value, and 19 means an invalid u32 value.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "./fields.wove" (only clang_field clang_inner))
	(use wove-file "./index.wove" (only (type ClangIndex) (type ClangDeclaration) clang_declaration))

	(struct ProbeValue (fields (error u32) (start i32) (end i32)))
	(struct ProbeWord (fields (error u32) (start i32) (end i32) (value u32)))

	(fn write_enum_keys
		(:doc "Write the native AST kind and shared probe enum name used for lookup.")
		(params (kind (mut-slice u8)) (fallback (mut-slice u8)))
		(returns void)
		(body
			(slice.store (local kind) 0i32 69u8)
			(slice.store (local kind) 1i32 110u8)
			(slice.store (local kind) 2i32 117u8)
			(slice.store (local kind) 3i32 109u8)
			(slice.store (local kind) 4i32 68u8)
			(slice.store (local kind) 5i32 101u8)
			(slice.store (local kind) 6i32 99u8)
			(slice.store (local kind) 7i32 108u8)
			(slice.store (local fallback) 0i32 119u8)
			(slice.store (local fallback) 1i32 118u8)
			(slice.store (local fallback) 2i32 112u8)
			(slice.store (local fallback) 3i32 114u8)
			(slice.store (local fallback) 4i32 95u8)
			(slice.store (local fallback) 5i32 99u8)
			(slice.store (local fallback) 6i32 95u8)
			(slice.store (local fallback) 7i32 112u8)
			(slice.store (local fallback) 8i32 114u8)
			(slice.store (local fallback) 9i32 111u8)
			(slice.store (local fallback) 10i32 98u8)
			(slice.store (local fallback) 11i32 101u8)
		))

	(fn clang_probe_enum
		(:doc "Return the top-level enum named by the probe, or fall back to the shared ABI enum.")
		(params (index ClangIndex) (entries (shared-slice ClangDeclaration)) (names (shared-slice u8)) (name (shared-slice u8)))
		(returns ClangDeclaration)
		(body
			(let-mut kind (array.alloc u8 8i32))
			(let-mut fallback (array.alloc u8 12i32))
			(call write_enum_keys (borrow-mut (local kind)) (borrow-mut (local fallback)))
			(let selected (call clang_declaration (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local kind)) (borrow-shared (local name))))
			(if
				(:doc "An explicit named enum remains authoritative even if the member is absent.")
				(bool.not (i32.lt (record.get (local selected) node) 0i32))
				(then (return (local selected))))
			(return (call clang_declaration (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local kind)) (borrow-shared (local fallback))))))

	(fn probe_name_matches
		(:doc "Match a direct field's complete decoded string against the requested spelling.")
		(params (source (shared-slice u8)) (base i32) (nodes (shared-slice JsonNode)) (field i32)
			(name (shared-slice u8)) (scratch (mut-slice u8)))
		(returns bool)
		(body
			(if
				(:doc "Missing field rows cannot name a probe constant.")
				(i32.lt (local field) 0i32)
				(then (return (bool false))))
			(let value (slice.load (local nodes) (local field)))
			(if
				(:doc "Clang supplies names as JSON strings.")
				(bool.not (u32.eq (record.get (local value) kind) 3u32))
				(then (return (bool false))))
			(let decoded (call json_decode_string (borrow-shared (local source))
				(i32.add.wrapping (local base) (record.get (local value) start))
				(i32.add.wrapping (local base) (record.get (local value) end)) (borrow-mut (local scratch))))
			(return (bool.and (u32.eq (record.get (local decoded) error) 0u32)
				(call same_bytes (borrow-shared (local scratch)) 0i32 (record.get (local decoded) written)
					(borrow-shared (local name)) 0i32 (slice.len (local name)))))))

	(fn probe_span
		(:doc "Retain the absolute span of a selected JSON value or diagnostic.")
		(params (error u32) (start i32) (end i32))
		(returns ProbeValue)
		(body (return (record.make ProbeValue (error (local error)) (start (local start)) (end (local end))))))

	(fn folded_probe_value
		(:doc "Follow at most sixteen expression wrappers to the member's folded string value.")
		(params (source (shared-slice u8)) (base i32) (nodes (shared-slice JsonNode)) (member i32))
		(returns ProbeValue)
		(body
			(let constant (slice.load (local nodes) (local member)))
			(let-mut expression (call clang_inner (borrow-shared (local source)) (local base) (borrow-shared (local nodes)) (local member)))
			(let-mut depth 0i32)
			(while
				(:doc "As in the archive, only the first expression child can supply the selected constant.")
				(bool.and (bool.not (i32.lt (local expression) 0i32)) (i32.lt (local depth) 17i32))
				(body
					(let selected (call clang_field (borrow-shared (local source)) (local base)
						(borrow-shared (local nodes)) (local expression) 3u32))
					(if
						(:doc "A reported value must be a nonempty JSON string.")
						(bool.not (i32.lt (local selected) 0i32))
						(then
							(let value (slice.load (local nodes) (local selected)))
							(let start (i32.add.wrapping (local base) (record.get (local value) start)))
							(let end (i32.add.wrapping (local base) (record.get (local value) end)))
							(if
								(:doc "Retain the original string span for exact text and bounded numeric consumers.")
								(bool.and (u32.eq (record.get (local value) kind) 3u32)
									(i32.lt 2i32 (i32.sub.wrapping (local end) (local start))))
								(then (return (call probe_span 0u32 (local start) (local end)))))
							(return (call probe_span 18u32 (local start) (local end)))))
					(set (local expression) (call clang_inner (borrow-shared (local source)) (local base)
						(borrow-shared (local nodes)) (local expression)))
					(set (local depth) (i32.add.wrapping (local depth) 1i32))))
			(return (call probe_span 18u32
				(i32.add.wrapping (local base) (record.get (local constant) start))
				(i32.add.wrapping (local base) (record.get (local constant) end))))))

	(fn clang_probe_value
		(:doc "Return the original folded value of a named constant from the selected probe enum.")
		(params (source (shared-slice u8)) (index ClangIndex) (nodes (shared-slice JsonNode))
			(entries (shared-slice ClangDeclaration)) (names (shared-slice u8)) (name (shared-slice u8)))
		(returns ProbeValue)
		(body
			(let selected (call clang_probe_enum (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local name))))
			(let base (record.get (local index) start))
			(let enum (record.get (local selected) node))
			(if
				(:doc "An absent enum is reported at the indexed document span.")
				(i32.lt (local enum) 0i32)
				(then (return (call probe_span 16u32 (local base) (record.get (local index) end)))))
			(let-mut row (call clang_inner (borrow-shared (local source)) (local base) (borrow-shared (local nodes)) (local enum)))
			(let-mut scratch (array.alloc u8 (slice.len (local name))))
			(while
				(:doc "Select only a direct, exact member name without decoding unrelated values.")
				(bool.not (i32.lt (local row) 0i32))
				(body
					(let label (call clang_field (borrow-shared (local source)) (local base)
						(borrow-shared (local nodes)) (local row) 2u32))
					(if
						(:doc "Use the first matching member of the selected enum.")
						(call probe_name_matches (borrow-shared (local source)) (local base) (borrow-shared (local nodes)) (local label)
							(borrow-shared (local name)) (borrow-mut (local scratch)))
						(then (return (call folded_probe_value (borrow-shared (local source)) (local base)
							(borrow-shared (local nodes)) (local row)))))
					(let child (slice.load (local nodes) (local row)))
					(set (local row) (record.get (local child) next_sibling))))
			(return (call probe_span 17u32 (record.get (local selected) start) (record.get (local selected) end)))))

	(fn clang_probe_u32
		(:doc "Decode a valid probe string as a decimal u32 with the same absolute source span.")
		(params (source (shared-slice u8)) (probe ProbeValue))
		(returns ProbeWord)
		(body
			(let start (record.get (local probe) start))
			(let end (record.get (local probe) end))
			(let code (record.get (local probe) error))
			(if
				(:doc "Carry a missing enum or value error without reading its diagnostic span as data.")
				(u32.lt 0u32 (local code))
				(then (return (record.make ProbeWord (error (local code)) (start (local start)) (end (local end)) (value 0u32)))))
			(let-mut text (array.alloc u8 10i32))
			(let decoded (call json_decode_string (borrow-shared (local source)) (local start) (local end) (borrow-mut (local text))))
			(let value (call read_decimal_digits (borrow-shared (local text)) 0i32 (record.get (local decoded) written)
				429496729u32 5u32))
			(if
				(:doc "Reject malformed, oversized, signed, and overflowing decimal values.")
				(bool.or (u32.lt 0u32 (record.get (local decoded) error)) (i32.lt (record.get (local value) digits) 0i32))
				(then (return (record.make ProbeWord (error 19u32) (start (local start)) (end (local end)) (value 0u32)))))
			(return (record.make ProbeWord (error 0u32) (start (local start)) (end (local end))
				(value (record.get (local value) magnitude)))))))
