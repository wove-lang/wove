(module clang_probe_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read an enum probe value from a successful Clang index.

	A named EnumDecl takes precedence over wvpr_c_probe. Use the exact
	member name. The returned value span includes the JSON string quotes and
	can be decoded with json_decode_string for arbitrary-width text.
	clang_probe_u32 decodes a bounded decimal ABI fact.

	Code 16 means no matching enum, 17 means no matching constant, 18
	means no folded string value, and 19 means an invalid u32 value.`)

	(use wove-file "../json/reader.wove" (only (type JsonNode) json_decode_string))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "./fields.wove"
		(only clang_field clang_inner (value clang_field_key_capacity) (value clang_name_key) (value clang_value_key)))
	(use wove-file "./index.wove" (only (type ClangIndex) (type ClangDeclaration) clang_declaration))

	(struct ProbeValue (fields (error u32) (start i32) (end i32)))
	(struct ProbeWord (fields (error u32) (start i32) (end i32) (value u32)))

	(let enum_kind "EnumDecl")
	(let fallback_enum "wvpr_c_probe")

	(fn clang_probe_enum
		(:doc "Return the top-level enum named by the probe, or fall back to the shared ABI enum.")
		(params (index ClangIndex) (entries (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8)))
		(returns ClangDeclaration)
		(body
			(let selected (call clang_declaration (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local enum_kind)) (borrow-shared (local name))))
			(if
				(:doc "An explicit named enum remains authoritative even if the member is absent.")
				(i32.not-lt (struct.get (local selected) node) 0i32)
				(then (return (local selected))))
			(return (call clang_declaration (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local enum_kind)) (borrow-shared (local fallback_enum))))))

	(fn probe_name_matches
		(:doc "Match a direct field's complete decoded string against the requested spelling.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (field i32)
			(name (shared-array u8)) (scratch (mut-array u8)))
		(returns bool)
		(body
			(if
				(:doc "Missing field rows cannot name a probe constant.")
				(i32.lt (local field) 0i32)
				(then (return (bool false))))
			(let value (array.load (local nodes) (local field)))
			(if
				(:doc "Clang supplies names as JSON strings.")
				(u32.not-eq (struct.get (local value) kind) 3u32)
				(then (return (bool false))))
			(let decoded (call json_decode_string (borrow-shared (local source))
				(i32.add (local base) (struct.get (local value) start))
				(i32.add (local base) (struct.get (local value) end))
				(borrow-mut (array.range (local scratch) 0i32 (array.len (local name))))))
			(return (bool.and (u32.eq (struct.get (local decoded) error) 0u32)
				(call same_bytes (borrow-shared (local scratch)) 0i32 (struct.get (local decoded) written)
					(borrow-shared (local name)) 0i32 (array.len (local name)))))))

	(fn probe_span
		(:doc "Retain the absolute span of a selected JSON value or diagnostic.")
		(params (error u32) (start i32) (end i32))
		(returns ProbeValue)
		(body (return (struct.new ProbeValue (error (local error)) (start (local start)) (end (local end))))))

	(fn folded_probe_value
		(:doc "Follow at most sixteen expression wrappers to the member's folded string value.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (member i32)
			(scratch (mut-array u8)))
		(returns ProbeValue)
		(body
			(let constant (array.load (local nodes) (local member)))
			(let-mut expression (call clang_inner (borrow-shared (local source)) (local base) (borrow-shared (local nodes))
				(local member) (borrow-mut (local scratch))))
			(let-mut depth 0i32)
			(while
				(:doc "As in the archive, only the first expression child can supply the selected constant.")
				(bool.and (i32.not-lt (local expression) 0i32) (i32.lt (local depth) 17i32))
				(body
					(let selected (call clang_field (borrow-shared (local source)) (local base)
						(borrow-shared (local nodes)) (local expression) (borrow-shared (local clang_value_key))
						(borrow-mut (local scratch))))
					(if
						(:doc "A reported value must be a nonempty JSON string.")
						(i32.not-lt (local selected) 0i32)
						(then
							(let value (array.load (local nodes) (local selected)))
							(let start (i32.add (local base) (struct.get (local value) start)))
							(let end (i32.add (local base) (struct.get (local value) end)))
							(if
								(:doc "Retain the original string span for exact text and bounded numeric consumers.")
								(bool.and (u32.eq (struct.get (local value) kind) 3u32)
									(i32.lt 2i32 (i32.sub (local end) (local start))))
								(then (return (call probe_span 0u32 (local start) (local end)))))
							(return (call probe_span 18u32 (local start) (local end)))))
					(set (local expression) (call clang_inner (borrow-shared (local source)) (local base)
						(borrow-shared (local nodes)) (local expression) (borrow-mut (local scratch))))
					(set (local depth) (i32.add (local depth) 1i32))))
			(return (call probe_span 18u32
				(i32.add (local base) (struct.get (local constant) start))
				(i32.add (local base) (struct.get (local constant) end))))))

	(fn clang_enum_value
		(:doc "Read the exact member's folded value from a previously selected enum.")
		(params (source (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(selected ClangDeclaration) (name (shared-array u8)))
		(returns ProbeValue)
		(body
			(let base (struct.get (local index) start))
			(let enum (struct.get (local selected) node))
			(if
				(:doc "An absent enum is reported at the indexed document span.")
				(i32.lt (local enum) 0i32)
				(then (return (call probe_span 16u32 (local base) (struct.get (local index) end)))))
			(let-mut capacity (array.len (local name)))
			(if
				(:doc "One buffer must fit both the requested member name and the fixed AST field keys.")
				(i32.lt (local capacity) (local clang_field_key_capacity))
				(then (set (local capacity) (local clang_field_key_capacity))))
			(let-mut scratch (array.alloc u8 (local capacity)))
			(let-mut row (call clang_inner (borrow-shared (local source)) (local base) (borrow-shared (local nodes))
				(local enum) (borrow-mut (local scratch))))
			(while
				(:doc "Select only a direct, exact member name without decoding unrelated values.")
				(i32.not-lt (local row) 0i32)
				(body
					(let label (call clang_field (borrow-shared (local source)) (local base)
						(borrow-shared (local nodes)) (local row) (borrow-shared (local clang_name_key))
						(borrow-mut (local scratch))))
					(if
						(:doc "Use the first matching member of the selected enum.")
						(call probe_name_matches (borrow-shared (local source)) (local base) (borrow-shared (local nodes)) (local label)
							(borrow-shared (local name)) (borrow-mut (local scratch)))
						(then (return (call folded_probe_value (borrow-shared (local source)) (local base)
							(borrow-shared (local nodes)) (local row) (borrow-mut (local scratch))))))
					(let child (array.load (local nodes) (local row)))
					(set (local row) (struct.get (local child) next_sibling))))
			(return (call probe_span 17u32 (struct.get (local selected) start) (struct.get (local selected) end)))))

	(fn clang_probe_value
		(:doc "Find the probe enum using the archive's name preference and read its exact member.")
		(params (source (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(entries (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8)))
		(returns ProbeValue)
		(body
			(let selected (call clang_probe_enum (local index) (borrow-shared (local entries)) (borrow-shared (local names))
				(borrow-shared (local name))))
			(return (call clang_enum_value (borrow-shared (local source)) (local index) (borrow-shared (local nodes))
				(local selected) (borrow-shared (local name))))))

	(fn clang_probe_u32
		(:doc "Decode a valid probe string as a decimal u32 with the same absolute source span.")
		(params (source (shared-array u8)) (probe ProbeValue))
		(returns ProbeWord)
		(body
			(let start (struct.get (local probe) start))
			(let end (struct.get (local probe) end))
			(let code (struct.get (local probe) error))
			(if
				(:doc "Carry a missing enum or value error without reading its diagnostic span as data.")
				(u32.lt 0u32 (local code))
				(then (return (struct.new ProbeWord (error (local code)) (start (local start)) (end (local end)) (value 0u32)))))
			(let-mut text (array.alloc u8 10i32))
			(let decoded (call json_decode_string (borrow-shared (local source)) (local start) (local end) (borrow-mut (local text))))
			(let value (call read_decimal_digits (borrow-shared (local text)) 0i32 (struct.get (local decoded) written)
				429496729u32 5u32))
			(if
				(:doc "Reject malformed, oversized, signed, and overflowing decimal values.")
				(bool.or (u32.lt 0u32 (struct.get (local decoded) error)) (i32.lt (struct.get (local value) digits) 0i32))
				(then (return (struct.new ProbeWord (error 19u32) (start (local start)) (end (local end)) (value 0u32)))))
			(return (struct.new ProbeWord (error 0u32) (start (local start)) (end (local end))
				(value (struct.get (local value) magnitude)))))))
