(module c_identifiers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Classify portable ASCII C identifier spellings for bridge validation and emission.`)

	(fn is_c_identifier_start
		(:doc `Recognize an ASCII letter or underscore at the start of a C identifier.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body (return (bool.or (u8.eq (local byte) 95u8)
			(bool.or (bool.and (u8.lt 64u8 (local byte)) (u8.lt (local byte) 91u8))
				(bool.and (u8.lt 96u8 (local byte)) (u8.lt (local byte) 123u8)))))))

	(fn is_c_identifier_byte
		(:doc `Recognize a byte that can continue a portable C identifier.`)
		(:pragma (inline always))
		(params (byte u8))
		(returns bool)
		(body (return (bool.or (call is_c_identifier_start (local byte))
			(bool.and (u8.lt 47u8 (local byte)) (u8.lt (local byte) 58u8))))))

	(fn is_c_identifier
		(:doc `Check that a source span spells a complete, nonempty portable C identifier.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns bool)
		(body
			(if
				(:doc "An identifier needs a leading ASCII letter or underscore.")
				(bool.not (bool.and (i32.lt (local start) (local end))
					(call is_c_identifier_start (array.load (local source) (local start)))))
				(then (return (bool false))))
			(let-mut cursor (i32.inc (local start)))
			(while
				(:doc "The remaining bytes may also be decimal digits.")
				(i32.lt (local cursor) (local end))
				(body
					(if (bool.not (call is_c_identifier_byte (array.load (local source) (local cursor)))) (then (return (bool false))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (bool true)))))
