(module c_standard
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Pack the selected C language standard for compiler and header-probe argv.")

	(use wove-file "../text/copy.wove" (only append_bytes))

	(let default_c_standard 11u32)
	(let c_standard_width 9i32)
	(let c11_argument "-std=c11\u0000")
	(let c17_argument "-std=c17\u0000")
	(let c23_argument "-std=c23\u0000")

	(fn write_c_standard
		(:doc "Write the resolved standard and its argument terminator within the caller's buffer.")
		(:expect (tests "stage-2/cli/native/standard.tsv") (issues "gh:wove-lang/wove:345"))
		(params (standard u32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc "Preserve a previous packing failure and require room for one full argument.")
				(bool:or cursor.ltz
					(i32:lt (i32:sub output.len c_standard_width) cursor))
				(then (return -1i32)))
			(if
				(:doc "Use the C17 driver dialect when selected.")
				(standard.eq 17u32)
				(then (return (call append_bytes (borrow-shared c17_argument) (borrow-mut output) cursor))))
			(if
				(:doc "Use the C23 driver dialect when selected.")
				(standard.eq 23u32)
				(then (return (call append_bytes (borrow-shared c23_argument) (borrow-mut output) cursor))))
			(return (call append_bytes (borrow-shared c11_argument) (borrow-mut output) cursor))))
)
