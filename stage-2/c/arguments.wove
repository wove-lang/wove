(module c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Define native argument modes and classify the work each mode needs before a C call.`)

	(let c_open_variadic_tail
		(:doc "A boundary past every valid source row leaves all declared native formals fixed.")
		2147483647i32)

	(let c_void_pointer_mode
		(:doc "Use a qualified C void pointer for a typed scalar or exact byte-view loan.")
		17u8)

	(let c_shared_handle_slot_mode
		(:doc "Lend an opaque owner's original pointer slot to a const void pointer formal.")
		18u8)

	(let c_marked_handle_out_mode
		(:doc "Lend an empty handle slot through void and classify its native pointer marker.")
		19u8)

	(let c_owner_marker_flag_mode
		(:doc "Fill a Wove-only mutable bool slot with the result of the sentinel comparison.")
		20u8)

	(let c_nullable_string_mode
		(:doc "Accept a checked shared C string or an explicit null pointer.")
		21u8)

	(let c_static_string_mode
		(:doc "Pass immutable NUL-terminated literal storage that the C callee may retain.")
		22u8)

	(let c_sync_callback_mode
		(:doc "Lend a checked callback to a C function for the duration of its call.")
		23u8)

	(let executable_string_marker
		(:doc "Identify emitted C that requires its static string storage to live in the main image.")
		"/* Wove retained C strings require an executable image. */\n")

	(let c_static_string_argument
		(:doc "Mark a retained byte literal that needs static C backing instead of a value temporary.")
		402u32)

	(fn c_value_mode
		(:doc `Pass an ordinary value. Zero is also the default in a freshly allocated contract table.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 0u8)))

	(fn c_checked_string_mode
		(:doc `Prepare a NUL-terminated copy after rejecting any embedded NUL.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 1u8)))

	(fn c_raw_string_mode
		(:doc `Prepare a NUL-terminated copy while preserving every input byte.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 2u8)))

	(fn c_bytes_mode
		(:doc `Check a byte extent and pass the view's original pointer.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 3u8)))

	(fn c_consume_mode
		(:doc `A by-value native owner parameter takes a checked pointer transfer.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 4u8)))

	(fn c_null_mode
		(:doc `Pass an explicit null pointer without preparing argument storage.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 5u8)))

	(fn c_array_mode
		(:doc `Check an element extent and pass a pointer to the exact native element type.`)
		(:pragma (inline always))
		(params)
		(returns u8)
		(body (return 6u8)))

	(fn is_c_array_mode
		(:doc `Select native array arguments that carry an element bound.`)
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_array_mode)))))

	(fn is_c_null_mode
		(:doc `Select a formal that permits only the null literal.`)
		(:pragma (inline always))
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_null_mode)))))

	(fn c_nullable_mode
		(:doc `Permit a mutable scalar loan or the explicit null literal.`)
		(params)
		(returns u8)
		(body (return 7u8)))

	(fn is_c_nullable_mode
		(:doc `Identify a pointer formal that also accepts explicit null.`)
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_nullable_mode)))))

	(fn accepts_c_null
		(:doc `Check whether this formal can be called with the null literal.`)
		(params (mode u8))
		(returns bool)
		(body (return (bool.or (call is_c_null_mode (local mode))
			(bool.or (call is_c_nullable_mode (local mode)) (u8.eq (local mode) (local c_nullable_string_mode)))))))

	(fn c_storage_shared_mode
		(:doc `Borrow an active storage owner as a const pointer to its native object.`)
		(params)
		(returns u8)
		(body (return 8u8)))

	(fn c_storage_mut_mode
		(:doc `Borrow an active storage owner as a writable pointer to its native object.`)
		(params)
		(returns u8)
		(body (return 9u8)))

	(fn c_storage_init_mode
		(:doc `Lend inactive storage and activate it when the native call returns zero.`)
		(params)
		(returns u8)
		(body (return 10u8)))

	(fn c_storage_consume_mode
		(:doc `Retire a storage owner, handing the native address to the consuming call.`)
		(params)
		(returns u8)
		(body (return 11u8)))

	(fn c_vector_mode
		(:doc `Copy borrowed byte owners into a terminated C string vector.`)
		(params)
		(returns u8)
		(body (return 14u8)))

	(fn is_c_vector_mode
		(:doc `Select arguments that use detached vector scratch.`)
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_vector_mode)))))

	(fn c_handle_mut_mode
		(:doc "Lend a present opaque pointer handle exclusively, with its original pointer ABI.")
		(:pragma (inline always))
		(params) (returns u8)
		(body (return 15u8)))

	(fn c_handle_init_mode
		(:doc "Lend an empty opaque owner slot as a pointer to its native handle.")
		(:pragma (inline always))
		(params) (returns u8)
		(body (return 16u8)))

	(fn is_c_handle_init_mode
		(:doc "Recognize a pointer-out loan that publishes a native handle.")
		(:pragma (inline always))
		(params (mode u8)) (returns bool)
		(body (return (bool.or (u8.eq (local mode) (call c_handle_init_mode))
			(u8.eq (local mode) (local c_marked_handle_out_mode))))))

	(fn is_c_init_mode
		(:doc "Recognize both caller-allocated initialization and pointer-out initialization.")
		(:pragma (inline always))
		(params (mode u8)) (returns bool)
		(body (return (bool.or (call is_c_storage_init_mode (local mode)) (call is_c_handle_init_mode (local mode))))))

	(fn is_c_exclusive_owner_mode
		(:doc "Identify the native owner modes that require an explicit mutable loan.")
		(:pragma (inline always))
		(params (mode u8)) (returns bool)
		(body (return (bool.or (u8.eq (local mode) (call c_handle_mut_mode))
			(bool.or (u8.eq (local mode) (call c_storage_mut_mode)) (call is_c_init_mode (local mode)))))))

	(fn is_c_storage_mode
		(:doc `Identify arguments whose C ABI takes a pointer to the native object inside a storage owner.`)
		(params (mode u8))
		(returns bool)
		(body (return (bool.and (u8.lt 7u8 (local mode)) (u8.lt (local mode) 12u8)))))

	(fn is_c_storage_init_mode
		(:doc `Identify the contract for an inactive storage initialization loan.`)
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_storage_init_mode)))))

	(fn is_c_consuming_mode
		(:doc `Identify a native formal that consumes its owner argument.`)
		(params (mode u8))
		(returns bool)
		(body (return (bool.or (u8.eq (local mode) (call c_consume_mode))
			(u8.eq (local mode) (call c_storage_consume_mode))))))

	(fn c_null_argument_kind
		(:doc `Mark a null actual that supplies no value temporary to the native call.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 102u32)))

	(fn is_c_value_mode
		(:doc `Recognize an ordinary argument passed without a native conversion.`)
		(:pragma (inline always))
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_value_mode)))))

	(fn is_c_checked_string_mode
		(:doc `Select string preparation that rejects embedded NUL bytes.`)
		(:pragma (inline always))
		(params (mode u8))
		(returns bool)
		(body (return (bool.or (u8.eq (local mode) (call c_checked_string_mode))
			(u8.eq (local mode) (local c_nullable_string_mode))))))

	(fn is_c_string_mode
		(:doc `Select modes that construct a call-scoped NUL-terminated copy.`)
		(:pragma (inline always))
		(params (mode u8))
		(returns bool)
		(body (return (bool.or (call is_c_checked_string_mode (local mode))
			(u8.eq (local mode) (call c_raw_string_mode))))))

	(fn is_c_bytes_mode
		(:doc `Select the mode that checks a byte extent and passes the original pointer.`)
		(:pragma (inline always))
		(params (mode u8))
		(returns bool)
		(body (return (u8.eq (local mode) (call c_bytes_mode)))))

	(fn is_c_extent_mode
		(:doc `Identify any bounded view that passes its original backing storage.`)
		(params (mode u8))
		(returns bool)
		(body (return (bool.or (call is_c_bytes_mode (local mode)) (call is_c_array_mode (local mode))))))
)
