(module c_header_probe
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Render, capture, and index the shared C header probe.

	The frontend supplies the original import span. A complete probe
	with presence zero is a successful absence. Code 1 is bad probe input,
	2 invalid packed options, 3 temporary source I/O, 4 a tool or capture
	failure, 5 truncated stdout, 6 malformed probe output, and 7 insufficient
	AST workspace. The index
	and presence fact retain diagnostic details from the captured document.`)

	(use wove-file "./standard.wove" (only (value c_standard_width) (value default_c_standard) write_c_standard))
	(use wove-file "../clang/source.wove" (only render_clang_probe))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../clang/index.wove"
		(only (type ClangIndex) (type ClangDeclaration) clang_index clang_index_result clang_declaration))
	(use wove-file "../clang/values.wove" (only (type ProbeWord) clang_enum_value clang_probe_u32))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../json/frame.wove" (only json_frame))
	(use wove-file "../io/process.wove" (only run_process_capture run_process_capture_to_stderr (type ProcessCapture)))

	(struct ProbeRun (fields (error u32) (status i32) (length i32)))

	(struct QuerySite (fields (file i32) (start i32) (end i32)))
	(struct HeaderQuery
		(fields (site QuerySite) (run ProbeRun) (index ClangIndex) (fact ProbeWord) (error u32) (present bool)))

	(let enum_kind "EnumDecl")
	(let probe_enum "wvpr_c_probe")
	(let header_present "wvpr_header_present")
	(let header_directive "#if __has_include(<@.h>)")
	(let header_begin "wvpr_header_begin")
	(let selection_marker "enum wvpr_header_begin { wvpr_header_begin_marker = 0 };\n")
	(let probe_thread_option "-pthread\u0000")

	(fn probe_defaults_width
		(:doc "Measure the standalone probe's thread option and default C standard.")
		(params) (returns i32)
		(body (return (i32:add (array:len probe_thread_option) c_standard_width))))

	(fn write_probe_defaults
		(:doc "Prepend standalone defaults before the caller's target and frontend flags.")
		(params (output (mut-array u8))) (returns i32)
		(body
			(if
				(:doc "Require room for both complete arguments before writing either.")
				(i32:lt (array:len output) (call probe_defaults_width))
				(then (return -1i32)))
			(let next (call append_bytes (borrow-shared probe_thread_option) (borrow-mut output) 0i32))
			(return (call write_c_standard default_c_standard (borrow-mut output) next))))


	(fn probe_run_at
		(:doc "Keep the child status and the number of bytes that fit in the capture.")
		(params (error u32) (status i32) (length i32))
		(returns ProbeRun)
		(body (return (struct:new ProbeRun (error error) (status status) (length length)))))

	(fn probe_options_complete
		(:doc "Accept empty options or a packed list whose final argument has its terminator.")
		(params (options (shared-array u8)))
		(returns bool)
		(body
			(let length (array:len options))
			(return (bool:or (i32:eqz length)
				(u8:eqz (array:get options (i32:dec length)))))))

	(fn capture_probe
		(:doc "Classify bounded frontend stdout in the same way for either C probe driver.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (output (mut-array u8)))
		(returns ProbeRun)
		(body
			(let captured (call run_process_capture (borrow-shared program) (borrow-shared arguments)
				(borrow-mut output)))
			(return (call probe_capture_result captured))))

	(fn capture_probe_to_stderr
		(:doc "Capture the AST and send the frontend's trace and diagnostics to a caller-owned descriptor.")
		(params (program (shared-array u8)) (arguments (shared-array u8)) (diagnostics i32) (output (mut-array u8)))
		(returns ProbeRun)
		(body
			(let captured (call run_process_capture_to_stderr (borrow-shared program) (borrow-shared arguments)
				diagnostics (borrow-mut output)))
			(return (call probe_capture_result captured))))

	(fn probe_capture_result
		(:doc "Interpret the shared native capture independently of stderr routing.")
		(params (captured ProcessCapture)) (returns ProbeRun)
		(body
			(let status (struct:get captured status))
			(let length (struct:get captured length))
			(if
				(:doc "A launch, capture, or child failure takes precedence over parsing the child's bytes.")
				(i32:not-eqz status)
				(then (return (call probe_run_at 4u32 status length))))
			(if
				(:doc "Distinguish a bounded capture from a malformed complete document.")
				(struct:get captured overflow)
				(then (return (call probe_run_at 5u32 status length))))
			(return (call probe_run_at 0u32 status length))))

	(fn query_result
		(:doc "Only a complete valid probe can publish the header presence bit.")
		(params (site QuerySite) (run ProbeRun) (index ClangIndex) (fact ProbeWord) (error u32))
		(returns HeaderQuery)
		(body (return (struct:new HeaderQuery (site site) (run run) (index index)
			(fact fact) (error error)
			(present (bool:and (u32:eqz error) (u32:eq (struct:get fact value) 1u32)))))))

	(fn query_failed
		(:doc "Preserve transport information while marking the AST slots unavailable.")
		(params (site QuerySite) (run ProbeRun)) (returns HeaderQuery)
		(body (return (call query_result site run
			(call clang_index_result 0u32 0i32 0i32 0i32 0i32 0i32) (struct:new ProbeWord (error 0u32) (start 0i32) (end 0i32) (value 0u32))
			(struct:get run error)))))

	(fn query_indexed
		(:doc "Validate one translation unit and read the exact enum member that establishes presence.")
		(params (source (shared-array u8)) (site QuerySite) (run ProbeRun) (index ClangIndex)
			(nodes (shared-array JsonNode)) (entries (shared-array ClangDeclaration)) (names (shared-array u8)))
		(returns HeaderQuery)
		(body
			(let code (struct:get index error))
			(if
				(:doc "Scratch exhaustion is separate from malformed JSON and retains the reader's detail.")
				(u32:gtz code)
				(then
					(let-mut error 6u32)
					(if
						(:doc "JSON rows, declaration rows, and decoded names are caller-provided capacities.")
						(bool:or (u32:eq code 11u32)
							(bool:or (u32:eq code 14u32) (u32:eq code 15u32)))
						(then (set error 7u32)))
					(return (call query_result site run index (struct:new ProbeWord (error 0u32) (start 0i32) (end 0i32) (value 0u32)) error))))
			(let tail (call json_frame (borrow-shared source) (struct:get index end)))
			(if
				(:doc "A single staged source must produce a single AST document and optional trailing layout.")
				(bool:or (u32:gtz (struct:get tail error))
					(i32:lt (struct:get tail start) (struct:get tail end)))
				(then
					(let detail (struct:new ProbeWord (error 10u32)
						(start (struct:get tail start)) (end (struct:get tail end)) (value 0u32)))
					(return (call query_result site run index detail 6u32))))
			(let enumeration (call clang_declaration index (borrow-shared entries) (borrow-shared names)
				(borrow-shared enum_kind) (borrow-shared probe_enum)))
			(let fact (call clang_probe_u32 (borrow-shared source)
				(call clang_enum_value (borrow-shared source) index (borrow-shared nodes)
					enumeration (borrow-shared header_present))))
			(if
				(:doc "Missing, malformed, and out-of-domain presence values are invalid probe output.")
				(bool:or (u32:gtz (struct:get fact error)) (u32:lt 1u32 (struct:get fact value)))
				(then (return (call query_result site run index fact 6u32))))
			(return (call query_result site run index fact 0u32))))

	(fn index_capture
		(:doc "Index only the populated prefix of the caller's immutable capture view.")
		(params (capture (shared-array u8)) (site QuerySite) (run ProbeRun)
			(nodes (mut-array JsonNode)) (entries (mut-array ClangDeclaration)) (names (mut-array u8)))
		(returns HeaderQuery)
		(body
			(let length (struct:get run length))
			(let index (call clang_index (borrow-shared (array:range capture 0i32 length)) 0i32
				(borrow-mut nodes) (borrow-mut entries) (borrow-mut names)))
			(return (call query_indexed (borrow-shared (array:range capture 0i32 length)) site run
				index (borrow-shared nodes) (borrow-shared entries) (borrow-shared names)))))

	(fn render_probe_template
		(:doc "Allocate and fill the selected portion of the C probe template.")
		(params (template (shared-array u8)) (header (shared-array u8)) (extra (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let-mut measure (array:alloc u8 0i32))
			(let size (call render_clang_probe (borrow-shared template) (borrow-shared header)
				(borrow-shared extra) (borrow-mut measure)))
			(if
				(:doc "Only a capacity result has a valid positive size to allocate.")
				(u32:not-eq (struct:get size error) 4u32)
				(then
					(let empty (array:alloc u8 0i32))
					(return (move empty))))
			(let-mut source (array:alloc u8 (struct:get size required)))
			(let rendered (call render_clang_probe (borrow-shared template) (borrow-shared header)
				(borrow-shared extra) (borrow-mut source)))
			(if
				(:doc "Never launch a query with an incomplete translation unit.")
				(u32:gtz (struct:get rendered error))
				(then
					(let empty (array:alloc u8 0i32))
					(return (move empty))))
			(return (move source))))

	(fn render_header_source
		(:doc "Render the standalone probe with its compatibility feature defaults.")
		(params (header (shared-array u8)) (extra (shared-array u8))) (returns (owned-array u8))
		(body
			(let template (embed "../clang/templates/probe_header.tmpl.h"))
			(return (call render_probe_template (borrow-shared template)
				(borrow-shared header) (borrow-shared extra)))))

	(fn render_probe_body
		(:doc "Start at the header test so only the supplied frontend defines feature macros.")
		(params (template (shared-array u8)) (header (shared-array u8))) (returns (owned-array u8))
		(body
			(let length (array:len template))
			(let width (array:len header_directive))
			(let limit (i32:sub length width))
			(let empty (array:alloc u8 0i32))
			(let-mut at 0i32)
			(while
				(:doc "Find the first complete include-test directive after the standalone prelude.")
				(i32:not-lt limit at)
				(body
					(if
						(:doc "The include-test directive starts the common template body.")
						(call same_bytes (borrow-shared template) at (i32:add at width)
							(borrow-shared header_directive) 0i32 width)
						(then (return (call render_probe_template (borrow-shared (array:range template at length))
							(borrow-shared header) (borrow-shared empty)))))
					(set at (i32:inc at))))
			(return (move empty))))

	(fn prepend_probe_context
		(:doc "Put preceding C includes before the selected header's availability check.")
		(params (prefix (shared-array u8)) (source (shared-array u8))) (returns (owned-array u8))
		(body
			(let length (array:len source))
			(let width (u64:add (u64:from-i32 length)
				(u64:add (u64:from-i32 (array:len prefix))
					(u64:from-i32 (array:len selection_marker)))))
			(if
				(:doc "An invalid template or unrepresentable context cannot produce a partial probe.")
				(bool:or (i32:eqz length) (u64:lt 2147483647u64 width))
				(then
					(let empty (array:alloc u8 0i32))
					(return (move empty))))
			(let-mut output (array:alloc u8 (i32:from-u64 width)))
			(let next (call append_bytes (borrow-shared prefix) (borrow-mut output) 0i32))
			(let boundary (call append_bytes (borrow-shared selection_marker) (borrow-mut output) next))
			(let end (call append_bytes (borrow-shared source) (borrow-mut output) boundary))
			(return (move output))))

	(fn render_frontend_header_source
		(:doc "Render the probe with the caller's frontend settings and earlier includes.")
		(params (prefix (shared-array u8)) (header (shared-array u8))) (returns (owned-array u8))
		(body
			(let template (embed "../clang/templates/probe_header.tmpl.h"))
			(let source (call render_probe_body (borrow-shared template) (borrow-shared header)))
			(return (call prepend_probe_context (borrow-shared prefix) (borrow-shared source))))))
