(module c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check a C header operand before it enters a preprocessing directive.

	Recognize a bare path, a quoted project header, or an angle-bracket
	system header. Check the complete path inside any delimiters.`)

	(fn header_path_byte
		(:doc `Keep header spelling to path bytes that cannot escape an include operand.`)
		(params (byte u8))
		(returns bool)
		(body
			(return (bool:or (byte.eq 95u8)
				(bool:or (bool:and (u8:lt 64u8 byte) (byte.lt 91u8))
					(bool:or (bool:and (u8:lt 96u8 byte) (byte.lt 123u8))
						(bool:and (u8:lt 44u8 byte) (byte.lt 58u8))))))))

	(fn c_header_form
		(:doc `Return zero for an invalid header, one for a bare path, or two for a literal.`)
		(params (header (shared-array u8)))
		(returns u32)
		(body
			(let-mut end header.len)
			(if
				(:doc "An include operand needs a nonempty name.")
				end.eqz
				(then (return 0u32)))
			(let first (header.get 0i32))
			(let-mut at 0i32)
			(let-mut form 1u32)
			(if
				(:doc "Preserve the semantics of angle-bracket and quoted includes.")
				(bool:or (first.eq 60u8) (first.eq 34u8))
				(then
					(let-mut close 62u8)
					(if
						(:doc "A quoted name closes with the same quote.")
						(first.eq 34u8)
						(then (set close 34u8)))
					(set end end.dec)
					(if
						(:doc "Require a closing delimiter around a nonempty path.")
						(bool:or (end.lt 2i32)
							(u8:not-eq (header.get end) close))
						(then (return 0u32)))
					(set at 1i32)
					(set form 2u32)))
			(while
				(:doc "Check the complete path before it can be placed in a preprocessing directive.")
				(at.lt end)
				(body
					(if
						(:doc "Header delimiters, control bytes and layout are outside the path alphabet.")
						(bool:not (call header_path_byte (header.get at)))
						(then (return 0u32)))
					(set at at.inc)))
			(return form))))
