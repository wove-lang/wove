(module c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check a C header operand before it enters a preprocessing directive.

	Recognize a bare path, a quoted project header, or an angle-bracket
	system header. Check the complete path inside any delimiters.`)

	(fn header_path_byte
		(:doc `Keep header spelling to path bytes that cannot escape an include operand.`)
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 95))
				(bool.or (bool.and (u8.lt (u8 64) (local byte)) (u8.lt (local byte) (u8 91)))
					(bool.or (bool.and (u8.lt (u8 96) (local byte)) (u8.lt (local byte) (u8 123)))
						(bool.and (u8.lt (u8 44) (local byte)) (u8.lt (local byte) (u8 58)))))))))

	(fn c_header_form
		(:doc `Return zero for an invalid header, one for a bare path, or two for a literal.`)
		(params (header (shared-slice u8)))
		(returns u32)
		(body
			(let-mut end (slice.len (local header)))
			(if
				(:doc "An include operand needs a nonempty name.")
				(i32.eq (local end) (i32 0))
				(then (return (u32 0))))
			(let first (slice.load (local header) (i32 0)))
			(let-mut at (i32 0))
			(let-mut form (u32 1))
			(if
				(:doc "Preserve the semantics of angle-bracket and quoted includes.")
				(bool.or (u8.eq (local first) (u8 60)) (u8.eq (local first) (u8 34)))
				(then
					(let-mut close (u8 62))
					(if
						(:doc "A quoted name closes with the same quote.")
						(u8.eq (local first) (u8 34))
						(then (set (local close) (u8 34))))
					(set (local end) (i32.sub.wrapping (local end) (i32 1)))
					(if
						(:doc "Require a closing delimiter around a nonempty path.")
						(bool.or (i32.lt (local end) (i32 2))
							(bool.not (u8.eq (slice.load (local header) (local end)) (local close))))
						(then (return (u32 0))))
					(set (local at) (i32 1))
					(set (local form) (u32 2))))
			(while
				(:doc "Check the complete path before it can be placed in a preprocessing directive.")
				(i32.lt (local at) (local end))
				(body
					(if
						(:doc "Header delimiters, control bytes and layout are outside the path alphabet.")
						(bool.not (call header_path_byte (slice.load (local header) (local at))))
						(then (return (u32 0))))
					(set (local at) (i32.add.wrapping (local at) (i32 1)))))
			(return (local form)))))
