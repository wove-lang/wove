(module c_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check a C header operand before it enters a preprocessing directive.

	Recognize a bare path, a quoted project header, or an angle-bracket
	system header. Check the complete path inside any delimiters.`)

	(fn header_path_byte
		(:doc `Keep header spelling to path bytes that cannot escape an include operand.`)
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) 95u8)
				(bool.or (bool.and (u8.lt 64u8 (local byte)) (u8.lt (local byte) 91u8))
					(bool.or (bool.and (u8.lt 96u8 (local byte)) (u8.lt (local byte) 123u8))
						(bool.and (u8.lt 44u8 (local byte)) (u8.lt (local byte) 58u8))))))))

	(fn c_header_form
		(:doc `Return zero for an invalid header, one for a bare path, or two for a literal.`)
		(params (header (shared-array u8)))
		(returns u32)
		(body
			(let-mut end (array.len (local header)))
			(if
				(:doc "An include operand needs a nonempty name.")
				(i32.eqz (local end))
				(then (return 0u32)))
			(let first (array.load (local header) 0i32))
			(let-mut at 0i32)
			(let-mut form 1u32)
			(if
				(:doc "Preserve the semantics of angle-bracket and quoted includes.")
				(bool.or (u8.eq (local first) 60u8) (u8.eq (local first) 34u8))
				(then
					(let-mut close 62u8)
					(if
						(:doc "A quoted name closes with the same quote.")
						(u8.eq (local first) 34u8)
						(then (set (local close) 34u8)))
					(set (local end) (i32.dec (local end)))
					(if
						(:doc "Require a closing delimiter around a nonempty path.")
						(bool.or (i32.lt (local end) 2i32)
							(u8.not-eq (array.load (local header) (local end)) (local close)))
						(then (return 0u32)))
					(set (local at) 1i32)
					(set (local form) 2u32)))
			(while
				(:doc "Check the complete path before it can be placed in a preprocessing directive.")
				(i32.lt (local at) (local end))
				(body
					(if
						(:doc "Header delimiters, control bytes and layout are outside the path alphabet.")
						(bool.not (call header_path_byte (array.load (local header) (local at))))
						(then (return 0u32)))
					(set (local at) (i32.inc (local at)))))
			(return (local form)))))
