(module c_export_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Reserve the language and C library names used by public C and C++ consumers.")

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let language_words `
		alignas alignof and and_eq asm auto bitand bitor bool break case catch char char8_t char16_t char32_t
		class co_await co_return co_yield compl concept const const_cast consteval constexpr constinit continue
		contract_assert decltype default delete do double dynamic_cast else enum explicit export extern false
		float for friend goto if inline int long mutable namespace new noexcept not not_eq nullptr operator or or_eq
		private protected public register reinterpret_cast requires restrict return short signed sizeof static
		static_assert static_cast struct switch template this thread_local throw true try typedef typeid typename
		typeof typeof_unqual union unsigned using virtual void volatile wchar_t while xor xor_eq
	`)

	(let integer_words `
		NULL size_t ptrdiff_t max_align_t intmax_t uintmax_t intptr_t uintptr_t rsize_t RSIZE_MAX
		int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t
		int_least8_t int_least16_t int_least32_t int_least64_t uint_least8_t uint_least16_t uint_least32_t uint_least64_t
		int_fast8_t int_fast16_t int_fast32_t int_fast64_t uint_fast8_t uint_fast16_t uint_fast32_t uint_fast64_t
	`)

	(let stdio_words `
		BUFSIZ EOF FILE FILENAME_MAX FOPEN_MAX L_tmpnam SEEK_CUR SEEK_END SEEK_SET TMP_MAX fpos_t stdin stdout stderr
		clearerr fclose fdopen feof ferror fflush fgetc fgetpos fgets fileno fopen fprintf fputc fputs fread
		freopen fscanf fseek fsetpos ftell fwrite getc getchar getdelim getline gets perror printf putc putchar
		puts remove rename rewind scanf setbuf setvbuf snprintf sprintf sscanf tmpfile tmpnam ungetc vfprintf
		vfscanf vprintf vscanf vsnprintf vsprintf vsscanf
	`)

	(let libc_words `
		EXIT_FAILURE EXIT_SUCCESS MB_CUR_MAX RAND_MAX abort abs aligned_alloc atexit atof atoi atol atoll bsearch
		calloc div div_t exit free getenv labs ldiv ldiv_t llabs lldiv lldiv_t malloc mblen mbstowcs mbtowc
		qsort quick_exit rand realloc reallocarray srand strfromd strfromf strfroml strtod strtof strtol strtold
		strtoll strtoul strtoull system wcstombs wctomb at_quick_exit
		memccpy memchr memcmp memcpy memmove memset memset_explicit strcat strchr strcmp strcoll strcpy strcspn
		strdup strerror strlen strncat strncmp strncpy strndup strnlen strpbrk strrchr strspn strstr strtok strxfrm
	`)

	(let math_words `
		acos acosh asin asinh atan atan2 atanh cbrt ceil copysign cos cosh erf erfc exp exp2 expm1 fabs fdim
		floor fma fmax fmin fmod frexp hypot ilogb ldexp lgamma llrint llround log log10 log1p log2 logb lrint
		lround modf nearbyint nextafter nexttoward pow remainder remquo rint round scalbln scalbn sin sinh sqrt
		tan tanh tgamma trunc nan
		cabs cacos cacosh carg casin casinh catan catanh ccos ccosh cexp cimag clog conj cpow cproj creal csin
		csinh csqrt ctan ctanh
	`)

	(let other_words `
		assert errno offsetof va_arg va_copy va_end va_start va_list
		complex imaginary feclearexcept fegetenv fegetexceptflag fegetround feholdexcept feraiseexcept fesetenv
		fesetexceptflag fesetround fetestexcept feupdateenv fenv_t fexcept_t
		c16rtomb c32rtomb c8rtomb mbrtoc16 mbrtoc32 mbrtoc8 once_flag call_once
		isalnum isalpha isblank iscntrl isdigit isgraph islower isprint ispunct isspace isupper isxdigit tolower toupper
		float_t double_t fpclassify isfinite isgreater isgreaterequal isinf isless islessequal islessgreater
		isnan isnormal issubnormal isunordered iszero signbit
		imaxabs imaxdiv imaxdiv_t strtoimax strtoumax wcstoimax wcstoumax
		lconv localeconv setlocale jmp_buf longjmp setjmp raise signal sig_atomic_t
		asctime clock clock_t ctime difftime gmtime localtime mktime strftime time time_t timespec_get timespec_getres
		wint_t mbstate_t btowc fgetwc fgetws fputwc fputws fwide fwprintf fwscanf getwc getwchar mbrlen mbrtowc
		mbsinit mbsrtowcs putwc putwchar swprintf swscanf ungetwc vfwprintf vfwscanf vswprintf vswscanf vwprintf
		vwscanf wcrtomb wcscat wcschr wcscmp wcscoll wcscpy wcscspn wcsftime wcslen wcsncat wcsncmp wcsncpy
		wcspbrk wcsrchr wcsrtombs wcsspn wcsstr wcstod wcstof wcstok wcstol wcstold wcstoll wcstoul wcstoull
		wcsxfrm wctob wmemchr wmemcmp wmemcpy wmemmove wmemset wprintf wscanf
		iswalnum iswalpha iswblank iswcntrl iswctype iswdigit iswgraph iswlower iswprint iswpunct iswspace
		iswupper iswxdigit towctrans towlower towupper wctrans wctrans_t wctype wctype_t
		main sched_yield
	`)

	(let reserved_prefixes `
		wvrt_ wvex_ wvfx_ wvl_ wvg_ wvio_ wvpr_ wvrs_ pthread_ atomic_ thrd_ mtx_ cnd_ tss_
		INT8_ INT16_ INT32_ INT64_ UINT8_ UINT16_ UINT32_ UINT64_ INT_FAST INT_LEAST UINT_FAST UINT_LEAST
		INTMAX_ UINTMAX_ INTPTR_ UINTPTR_ PTRDIFF_ SIZE_ SIG_ATOMIC_ WCHAR_ WINT_ ATOMIC_ FE_ FP_ MATH_
	`)

	(fn name_in_words
		(:doc "Match a full identifier, or a complete reserved prefix, from a whitespace-delimited vocabulary.")
		(params (source (shared-array u8)) (start i32) (end i32) (words (shared-array u8)) (prefix bool))
		(returns bool)
		(body
			(let name_width (i32.sub (local end) (local start)))
			(let-mut word 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Formatting whitespace also terminates the last word in each literal.")
				(i32.lt (local index) (array.len (local words)))
				(body
					(if
						(:doc "A separator closes a nonempty candidate or advances past repeated whitespace.")
						(u8.lt (array.load (local words) (local index)) 33u8)
						(then
							(let width (i32.sub (local index) (local word)))
							(if
								(:doc "Only prefixes allow a shorter candidate than the complete name.")
								(bool.and (i32.gtz (local width))
									(bool.and (i32.not-lt (local name_width) (local width))
										(bool.or (local prefix) (i32.eq (local width) (local name_width)))))
								(then
									(if
										(:doc "Compare the exact source bytes without C name rewriting.")
										(call same_bytes (borrow-shared (local source)) (local start)
											(i32.add (local start) (local width)) (borrow-shared (local words)) (local word) (local index))
										(then (return (bool true))))))
							(set (local word) (i32.inc (local index)))))
					(set (local index) (i32.inc (local index)))))
			(return (bool false))))

	(fn reserved_math_name
		(:doc "Match the standard math names and their float and long-double suffixes.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(let last (i32.dec (local end)))
			(let suffix (array.load (local source) (local last)))
			(return (bool.or
				(call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local math_words)) (bool false))
				(bool.and (bool.or (u8.eq (local suffix) 102u8) (u8.eq (local suffix) 108u8))
					(call name_in_words (borrow-shared (local source)) (local start) (local last) (borrow-shared (local math_words)) (bool false)))))))

	(fn reserved_public_c_name
		(:doc "Reserve leading underscores, C and C++ keywords, and C library and Wove namespaces.")
		(params (source (shared-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(return (bool.or (u8.eq (array.load (local source) (local start)) 95u8)
				(bool.or (call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local language_words)) (bool false))
					(bool.or (call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local integer_words)) (bool false))
						(bool.or (call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local stdio_words)) (bool false))
							(bool.or (call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local libc_words)) (bool false))
								(bool.or (call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local other_words)) (bool false))
									(bool.or (call reserved_math_name (borrow-shared (local source)) (local start) (local end))
										(call name_in_words (borrow-shared (local source)) (local start) (local end) (borrow-shared (local reserved_prefixes)) (bool true))))))))))))
)
