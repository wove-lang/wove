(module scalar_specializations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Instantiate explicitly applied records in the checked layout table.

	Walk selected source applications from the inside out, then visit the
	fields of each requested instance. Keep the original source nodes
	available for diagnostics and inspection.`)

	(use wove-file "../source/generics.wove" (only has_specialization_head function_generic_list))
	(use wove-file "../source/owned.wove" (only owned_element_node))
	(use wove-file "../source/scan.wove" (only is_metadata_form (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts (type SelectedDeclaration)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/enum_forms.wove" (only (value variants_list) (value enum_declaration)))
	(use wove-file "./generics/workspace.wove" (only is_function_request))
	(use wove-file "./syntax.wove" (only entry_at entry_keyword (type EntryRead)))
	(use wove-file "./records.wove" (only declaration_kind declaration_generic_list read_specialization_key find_specialization
		specialization_alias specialization_layout specialization_type is_specialization_alias register_specialized_arrays
		is_member_array register_fixed_arrays register_owned_rows owned_array_leaf_node specialization_first scope_at use_scope
		is_disabled_statement is_generic_template validate_template_constants (type TypeScope) (type ScalarRecord)))

	(struct SpecializationRead (fields (next i32) (file i32) (start i32) (end i32) (error u32)))

	(fn specialization_progress
		(:doc "Return the next available layout row after a successful walk.")
		(params (next i32)) (returns SpecializationRead)
		(body (return (struct:new SpecializationRead (next next) (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn specialization_failure
		(:doc "Relate a failed application to its own file and file-relative span.")
		(params (scope TypeScope) (checked EntryRead)) (returns SpecializationRead)
		(body
			(let base (scope.get source_base))
			(return (struct:new SpecializationRead (next -1i32) (file (scope.get file))
				(start (i32:sub (checked.get start) base))
				(end (i32:sub (checked.get end) base)) (error (checked.get error))))))

	(fn is_application
		(:doc "Recognize a specialization without treating a spelled field or parameter name as an operator.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (index i32)) (returns bool)
		(body
			(if
				(:doc "Only the explicit application spelling needs a context check.")
				(bool:not (call has_specialization_head (borrow-shared source) (borrow-shared nodes) node))
				(then (return (bool false))))
			(let parent (nodes.get (node.get parent)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) parent))
			(let kind (call entry_keyword (borrow-shared source) (borrow-shared nodes) (parts.get head)))
			(if
				(:doc "A declaration's parameter, field, or variant list contains user-defined labels.")
				(bool:or (bool:or (u32:eq kind 3u32) (u32:eq kind 49u32))
					(u32:eq kind variants_list))
				(then
					(let owner (call declaration_kind (borrow-shared source) (borrow-shared nodes)
						(parent.get parent)))
					(if
						(:doc "An individual field named fields or parameter named params is still a valid type context.")
						(bool:or (bool:and (u32:eq kind 3u32) (u32:eq owner 1u32))
							(bool:or (bool:and (u32:eq kind 49u32) (u32:eq owner 48u32))
								(bool:and (u32:eq kind variants_list) (u32:eq owner enum_declaration))))
						(then (return (bool false))))))
			(if
				(:doc "A call target names a function application. Its nested type arguments still belong to record discovery.")
				(call is_function_request (borrow-shared source) (borrow-shared nodes) node index)
				(then (return (bool false))))
			(if
				(:doc "Only the first constructor operand denotes its type. The rest are initializer names.")
				(u32:eq kind 50u32)
				(then (return (i32:eq index (parts.get operands)))))
			(return (bool true))))

	(fn register_argument_owner
		(:doc "Intern just the owner layers of one compound type argument from its element out.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (argument i32) (start i32)) (returns EntryRead)
		(body
			(let leaf (call owned_array_leaf_node (borrow-shared source) (borrow-shared nodes) argument))
			(let-mut count start)
			(let-mut row (struct:get (nodes.get leaf) parent))
			(while
				(:doc "Each inner descriptor is available by the time its enclosing type needs a row code.")
				(i32:lt argument row)
				(body
					(let owners (call register_owned_rows (borrow-shared source) (borrow-shared nodes)
						row (i32:inc row) (borrow-shared bindings) scope (borrow-mut records) count))
					(if (u32:gtz (owners.get error)) (then (return owners)))
					(set count (owners.get operand))
					(set row (struct:get (nodes.get row) parent))))
			(return (call entry_at (nodes.get argument) count 0u32))))

	(fn register_argument_owners
		(:doc "Intern nested ownership layers of explicit type arguments before resolving the specialization key.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (site i32) (start i32)) (returns EntryRead)
		(body
			(let-mut argument (call specialization_first (borrow-shared source) (borrow-shared nodes) site))
			(let-mut next start)
			(while
				(:doc "Only an explicit heap descriptor can require structural row identities here.")
				(i32:not-ltz argument)
				(body
					(let node (nodes.get argument))
					(let child (call owned_element_node (borrow-shared source) (borrow-shared nodes) node))
					(if
						(:doc "A descriptor's encoded type can depend on a registered inner owner.")
						(i32:not-ltz child)
						(then
							(let owners (call register_argument_owner (borrow-shared source) (borrow-shared nodes)
								(borrow-mut records) (borrow-shared bindings) scope argument next))
							(if (u32:gtz (owners.get error)) (then (return owners)))
							(set next (owners.get operand))))
					(set argument (node.get next_sibling))))
			(return (call entry_at (nodes.get site) next 0u32))))

	(fn register_specialization
		(:doc "Register a checked source application and publish its canonical row for field discovery.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (site i32) (enclosing i32) (start i32)) (returns EntryRead)
		(body
			(let node (nodes.get site))
			(if
				(:doc "A closed field application has one source mapping across all instances of its template.")
				(u32:gtz (call specialization_type (borrow-shared records) site))
				(then (return (call entry_at node start 0u32))))
			(let owners (call register_argument_owners (borrow-shared source) (borrow-shared nodes)
				(borrow-mut records) (borrow-shared bindings) scope site start))
			(if (u32:gtz (owners.get error)) (then (return owners)))
			(let next (owners.get operand))
			(let key (call read_specialization_key (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) scope site enclosing))
			(if
				(:doc "Return the exact argument or application span before any layout is added.")
				(u32:gtz (key.get error))
				(then (return (struct:new EntryRead (operand -1i32) (start (key.get start))
					(end (key.get end)) (error (key.get error)) (related -1i32)))))
			(let known (call find_specialization (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) scope site key))
			(if (i32:eq next records.len) (then (return (call entry_at node -1i32 16u32))))
			(if
				(:doc "A repeated spelling links to the canonical record without emitting a second definition.")
				(i32:lt -1i32 known)
				(then
					(records.set next (call specialization_alias site known))
					(return (call entry_at node (i32:inc next) 0u32))))
			(let layout (call specialization_layout (records.get (key.get template))
				key site scope))
			(records.set next layout)
			(return (call entry_at node (i32:inc next) 0u32))))

	(fn instantiate_type_applications
		(:doc "Check type applications in one subtree from its leaves to its root, skipping metadata and disabled groups.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (root i32) (enclosing i32) (start i32)) (returns EntryRead)
		(body
			(let-mut index root)
			(let-mut next start)
			(while
				(:doc "Visit the original tree in postorder and stop after processing this subtree root.")
				(i32:lt -1i32 index)
				(body
					(let node (nodes.get index))
					(let descend (bool:not (bool:or
						(call is_metadata_form (borrow-shared source) (borrow-shared nodes) node)
						(call is_disabled_statement (borrow-shared source) (borrow-shared nodes) node))))
					(let child (node.get first_child))
					(if
						(:doc "The first child may contain an argument application that must be interned first.")
						(bool:and descend (i32:lt -1i32 child))
						(then (set index child))
						(else
							(let-mut closing index)
							(while
								(:doc "Follow completed parents until a next sibling or the subtree root.")
								(i32:lt -1i32 closing)
								(body
									(let closed (nodes.get closing))
									(if
										(:doc "An inner application has now registered all its own arguments.")
										(call is_application (borrow-shared source) (borrow-shared nodes) closed closing)
										(then
											(let checked (call register_specialization (borrow-shared source) (borrow-shared nodes)
												(borrow-mut records) (borrow-shared bindings) scope
												closing enclosing next))
											(if (u32:gtz (checked.get error)) (then (return checked)))
											(set next (checked.get operand))))
									(let-mut sibling -1i32)
									(let finished (i32:eq closing root))
									(if
										(:doc "The root's siblings belong to other subtrees.")
										(bool:not finished)
										(then (set sibling (closed.get next_sibling))))
									(if
										(:doc "Return to the forward walk at the next sibling or finish.")
										(bool:or finished (i32:lt -1i32 sibling))
										(then
											(set index sibling)
											(set closing -1i32))
										(else (set closing (closed.get parent))))))))))
			(return (call entry_at (nodes.get root) next 0u32))))

	(fn register_specialization_members
		(:doc "Discover each requested record's closed field applications in the template's own namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (instance i32) (start i32)) (returns SpecializationRead)
		(body
			(let layout (records.get instance))
			(let scope (call scope_at (layout.get file) (layout.get source_base)))
			(let site (nodes.get (layout.get specialization)))
			(let-mut field (layout.get first))
			(let-mut next start)
			(while
				(:doc "Register nested record types before interning an inline array that may use them.")
				(i32:lt -1i32 field)
				(body
					(let member (nodes.get field))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) member))
					(let operand (parts.get operands))
					(let checked (call instantiate_type_applications (borrow-shared source) (borrow-shared nodes)
						(borrow-mut records) (borrow-shared bindings) scope operand instance next))
					(if
						(:doc "A closed field application is spelled in the defining file.")
						(u32:gtz (checked.get error))
						(then (return (call specialization_failure scope checked))))
					(set next (checked.get operand))
					(let type (nodes.get operand))
					(if
						(:doc "Direct fields only need the nominal layout; inline arrays also need an exact structural type.")
						(call is_member_array (borrow-shared source) (borrow-shared nodes) type)
						(then
							(let arrays (call register_specialized_arrays (borrow-shared source) (borrow-shared nodes)
								(borrow-mut records) (borrow-shared bindings) layout type next))
							(if
								(:doc "An invalid specialization shape points at its instantiating application.")
								(u32:gtz (arrays.get error))
								(then (return (call specialization_failure (call use_scope layout)
									(call entry_at site -1i32 (arrays.get error))))))
							(set next (arrays.get operand))))
					(set field (member.get next_sibling))))
			(return (call specialization_progress next))))

	(fn register_requested_members
		(:doc "Use the populated layout prefix to visit each newly requested record once, including transitive field requests.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (start i32) (end i32)) (returns SpecializationRead)
		(body
			(let-mut row start)
			(let-mut next end)
			(while
				(:doc "Fields may add layouts to the tail; cycles reuse an already published record.")
				(i32:lt row next)
				(body
					(let layout (records.get row))
					(if
						(:doc "Only a canonical specialization owns template fields.")
						(bool:and (i32:lt -1i32 (layout.get specialization))
							(bool:not (call is_specialization_alias layout)))
						(then
							(let checked (call register_specialization_members (borrow-shared source) (borrow-shared nodes)
								(borrow-mut records) (borrow-shared bindings) row next))
							(if (u32:gtz (checked.get error)) (then (return checked)))
							(set next (checked.get next))))
					(set row (i32:inc row))))
			(return (call specialization_progress next))))

	(fn register_clone_type_layouts
		(:doc "Check concrete record and array types in a cloned function before reading its signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (declaration i32) (start i32)) (returns SpecializationRead)
		(body
			(let scalar (call register_fixed_arrays (borrow-shared source) (borrow-shared nodes)
				declaration (borrow-mut records) start (borrow-shared bindings)
				(scope.get file) (scope.get source_base) (bool false)))
			(if (u32:gtz (scalar.get error)) (then (return (call specialization_failure scope scalar))))
			(let initial (scalar.get operand))
			(let checked (call instantiate_type_applications (borrow-shared source) (borrow-shared nodes)
				(borrow-mut records) (borrow-shared bindings) scope declaration -1i32 initial))
			(if (u32:gtz (checked.get error)) (then (return (call specialization_failure scope checked))))
			(let closed (call register_requested_members (borrow-shared source) (borrow-shared nodes)
				(borrow-mut records) (borrow-shared bindings) initial (checked.get operand)))
			(if (u32:gtz (closed.get error)) (then (return closed)))
			(let arrays (call register_fixed_arrays (borrow-shared source) (borrow-shared nodes)
				declaration (borrow-mut records) (closed.get next) (borrow-shared bindings)
				(scope.get file) (scope.get source_base) (bool true)))
			(if (u32:gtz (arrays.get error)) (then (return (call specialization_failure scope arrays))))
			(return (call specialization_progress (arrays.get operand)))))

	(fn validate_record_template_constants
		(:doc "Check record templates in their defining files before any application can use them.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (count i32)) (returns SpecializationRead)
		(body
			(let-mut row 0i32)
			(while
				(:doc "The published prefix includes imported nominal layouts as well as local definitions.")
				(i32:lt row count)
				(body
					(let layout (records.get row))
					(if
						(:doc "Only an unapplied record template has parameters to resolve.")
						(call is_generic_template layout)
						(then
							(let scope (call scope_at (layout.get file) (layout.get source_base)))
							(let result (call validate_template_constants (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings) scope (layout.get generic)))
							(if (u32:gtz (result.get error))
								(then (return (call specialization_failure scope result))))))
					(set row (i32:inc row))))
			(return (call specialization_progress count))))

	(fn register_module_specializations
		(:doc "Register applications from active declarations and the fields of requested templates.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declarations (shared-array SelectedDeclaration))
			(count i32) (base i32) (scope TypeScope) (bindings (shared-array GraphBinding))
			(records (mut-array ScalarRecord)) (start i32)) (returns SpecializationRead)
		(body
			(let-mut index 0i32)
			(let-mut next start)
			(while
				(:doc "Template field layouts are checked with their arguments at an explicit use.")
				(i32:lt index count)
				(body
					(let declaration (struct:get (declarations.get (i32:add base index)) node))
					(let kind (call declaration_kind (borrow-shared source) (borrow-shared nodes) declaration))
					(if
						(:doc "Exclude foreign declarations and defer the members of generic structs.")
						(bool:or (bool:or (bool:and (u32:eq kind 1u32)
								(i32:ltz (call function_generic_list (borrow-shared source) (borrow-shared nodes)
									(nodes.get declaration)))) (u32:eq kind 15u32))
							(bool:or (u32:eq kind enum_declaration)
								(bool:and (u32:eq kind 48u32)
									(i32:ltz (call declaration_generic_list (borrow-shared source) (borrow-shared nodes) declaration)))))
						(then
							(let checked (call instantiate_type_applications (borrow-shared source) (borrow-shared nodes)
								(borrow-mut records) (borrow-shared bindings) scope declaration -1i32 next))
							(if
								(:doc "An explicit use retains its own source location.")
								(u32:gtz (checked.get error))
								(then (return (call specialization_failure scope checked))))
							(set next (checked.get operand))))
					(set index (i32:inc index))))
			(return (call register_requested_members (borrow-shared source) (borrow-shared nodes)
				(borrow-mut records) (borrow-shared bindings) start next))))
)
