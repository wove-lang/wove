(module scalar_specializations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Instantiate explicitly applied records in the checked layout table.

	Walk selected source applications from the inside out, then visit the
	fields of each requested instance. Keep the original source nodes
	available for diagnostics and inspection.`)

	(use wove-file "../source/generics.wove" (only has_specialization_head function_generic_list))
	(use wove-file "../source/scan.wove" (only is_metadata_form (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts (type SelectedDeclaration)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/enum_forms.wove" (only (value variants_list) (value enum_declaration)))
	(use wove-file "./generics/workspace.wove" (only is_function_request))
	(use wove-file "./syntax.wove" (only entry_at entry_keyword (type EntryRead)))
	(use wove-file "./records.wove" (only declaration_kind declaration_generic_list read_specialization_key find_specialization
		specialization_alias specialization_layout specialization_type is_specialization_alias specialized_field_array
		is_member_array intern_fixed_array register_fixed_arrays scope_at use_scope
		is_disabled_statement is_generic_template validate_template_constants (type TypeScope) (type ScalarRecord)))

	(struct SpecializationRead (fields (next i32) (file i32) (start i32) (end i32) (error u32)))

	(fn specialization_progress
		(:doc "Return the next available layout row after a successful walk.")
		(params (next i32)) (returns SpecializationRead)
		(body (return (struct.new SpecializationRead (next (local next)) (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn specialization_failure
		(:doc "Relate a failed application to its own file and file-relative span.")
		(params (scope TypeScope) (checked EntryRead)) (returns SpecializationRead)
		(body
			(let base (struct.get (local scope) source_base))
			(return (struct.new SpecializationRead (next -1i32) (file (struct.get (local scope) file))
				(start (i32.sub (struct.get (local checked) start) (local base)))
				(end (i32.sub (struct.get (local checked) end) (local base))) (error (struct.get (local checked) error))))))

	(fn is_application
		(:doc "Recognize a specialization without treating a spelled field or parameter name as an operator.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (index i32)) (returns bool)
		(body
			(if
				(:doc "Only the explicit application spelling needs a context check.")
				(bool.not (call has_specialization_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
				(then (return (bool false))))
			(let parent (array.load (local nodes) (struct.get (local node) parent)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local parent)))
			(let kind (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parts) head)))
			(if
				(:doc "A declaration's parameter, field, or variant list contains user-defined labels.")
				(bool.or (bool.or (u32.eq (local kind) 3u32) (u32.eq (local kind) 49u32))
					(u32.eq (local kind) (local variants_list)))
				(then
					(let owner (call declaration_kind (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local parent) parent)))
					(if
						(:doc "An individual field named fields or parameter named params is still a valid type context.")
						(bool.or (bool.and (u32.eq (local kind) 3u32) (u32.eq (local owner) 1u32))
							(bool.or (bool.and (u32.eq (local kind) 49u32) (u32.eq (local owner) 48u32))
								(bool.and (u32.eq (local kind) (local variants_list)) (u32.eq (local owner) (local enum_declaration)))))
						(then (return (bool false))))))
			(if
				(:doc "A call target names a function application. Its nested type arguments still belong to record discovery.")
				(call is_function_request (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local index))
				(then (return (bool false))))
			(if
				(:doc "Only the first constructor operand denotes its type. The rest are initializer names.")
				(u32.eq (local kind) 50u32)
				(then (return (i32.eq (local index) (struct.get (local parts) operands)))))
			(return (bool true))))

	(fn register_specialization
		(:doc "Register a checked source application and publish its canonical row for field discovery.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (site i32) (enclosing i32) (next i32)) (returns EntryRead)
		(body
			(let node (array.load (local nodes) (local site)))
			(if
				(:doc "A closed field application has one source mapping across all instances of its template.")
				(u32.gtz (call specialization_type (borrow-shared (local records)) (local site)))
				(then (return (call entry_at (local node) (local next) 0u32))))
			(let key (call read_specialization_key (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (local site) (local enclosing)))
			(if
				(:doc "Return the exact argument or application span before any layout is added.")
				(u32.gtz (struct.get (local key) error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get (local key) start))
					(end (struct.get (local key) end)) (error (struct.get (local key) error)) (related -1i32)))))
			(let known (call find_specialization (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (local site) (local key)))
			(if (i32.eq (local known) -2i32) (then (return (call entry_at (local node) -1i32 32u32))))
			(if (i32.eq (local next) (array.len (local records))) (then (return (call entry_at (local node) -1i32 16u32))))
			(if
				(:doc "A repeated spelling links to the canonical record without emitting a second definition.")
				(i32.lt -1i32 (local known))
				(then
					(array.store (local records) (local next) (call specialization_alias (local site) (local known)))
					(return (call entry_at (local node) (i32.inc (local next)) 0u32))))
			(let layout (call specialization_layout (array.load (local records) (struct.get (local key) template))
				(local key) (local site) (local scope)))
			(array.store (local records) (local next) (local layout))
			(return (call entry_at (local node) (i32.inc (local next)) 0u32))))

	(fn instantiate_type_applications
		(:doc "Check type applications in one subtree from its leaves to its root, skipping metadata and disabled groups.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (root i32) (enclosing i32) (start i32)) (returns EntryRead)
		(body
			(let-mut index (local root))
			(let-mut next (local start))
			(while
				(:doc "Visit the original tree in postorder and stop after processing this subtree root.")
				(i32.lt -1i32 (local index))
				(body
					(let node (array.load (local nodes) (local index)))
					(let descend (bool.not (bool.or
						(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))
						(call is_disabled_statement (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))))
					(let child (struct.get (local node) first_child))
					(if
						(:doc "The first child may contain an argument application that must be interned first.")
						(bool.and (local descend) (i32.lt -1i32 (local child)))
						(then (set (local index) (local child)))
						(else
							(let-mut closing (local index))
							(while
								(:doc "Follow completed parents until a next sibling or the subtree root.")
								(i32.lt -1i32 (local closing))
								(body
									(let closed (array.load (local nodes) (local closing)))
									(if
										(:doc "An inner application has now registered all its own arguments.")
										(call is_application (borrow-shared (local source)) (borrow-shared (local nodes)) (local closed) (local closing))
										(then
											(let checked (call register_specialization (borrow-shared (local source)) (borrow-shared (local nodes))
												(borrow-mut (local records)) (borrow-shared (local bindings)) (local scope)
												(local closing) (local enclosing) (local next)))
											(if (u32.gtz (struct.get (local checked) error)) (then (return (local checked))))
											(set (local next) (struct.get (local checked) operand))))
									(let-mut sibling -1i32)
									(let finished (i32.eq (local closing) (local root)))
									(if
										(:doc "The root's siblings belong to other subtrees.")
										(bool.not (local finished))
										(then (set (local sibling) (struct.get (local closed) next_sibling))))
									(if
										(:doc "Return to the forward walk at the next sibling or finish.")
										(bool.or (local finished) (i32.lt -1i32 (local sibling)))
										(then
											(set (local index) (local sibling))
											(set (local closing) -1i32))
										(else (set (local closing) (struct.get (local closed) parent))))))))))
			(return (call entry_at (array.load (local nodes) (local root)) (local next) 0u32))))

	(fn register_specialization_members
		(:doc "Discover each requested record's closed field applications in the template's own namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (instance i32) (start i32)) (returns SpecializationRead)
		(body
			(let layout (array.load (local records) (local instance)))
			(let scope (call scope_at (struct.get (local layout) file) (struct.get (local layout) source_base)))
			(let site (array.load (local nodes) (struct.get (local layout) specialization)))
			(let-mut field (struct.get (local layout) first))
			(let-mut next (local start))
			(while
				(:doc "Register nested record types before interning an inline array that may use them.")
				(i32.lt -1i32 (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
					(let operand (struct.get (local parts) operands))
					(let checked (call instantiate_type_applications (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-mut (local records)) (borrow-shared (local bindings)) (local scope) (local operand) (local instance) (local next)))
					(if
						(:doc "A closed field application is spelled in the defining file.")
						(u32.gtz (struct.get (local checked) error))
						(then (return (call specialization_failure (local scope) (local checked)))))
					(set (local next) (struct.get (local checked) operand))
					(let type (array.load (local nodes) (local operand)))
					(if
						(:doc "Direct fields only need the nominal layout; inline arrays also need an exact structural type.")
						(call is_member_array (borrow-shared (local source)) (borrow-shared (local nodes)) (local type))
						(then
							(let shape (call specialized_field_array (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local type)))
							(if
								(:doc "An invalid substituted array shape belongs to the instantiating application.")
								(bool.or (u32.eqz (struct.get (local shape) element)) (i32.ltz (struct.get (local shape) extent)))
								(then (return (call specialization_failure (call use_scope (local layout)) (call entry_at (local site) -1i32 23u32)))))
							(set (local next) (call intern_fixed_array (local shape) (borrow-mut (local records)) (local next)))
							(if
								(:doc "Report exhausted layout storage before attempting another registration.")
								(i32.ltz (local next))
								(then (return (call specialization_failure (call use_scope (local layout)) (call entry_at (local site) -1i32 16u32)))))))
					(set (local field) (struct.get (local member) next_sibling))))
			(return (call specialization_progress (local next)))))

	(fn register_requested_members
		(:doc "Use the populated layout prefix to visit each newly requested record once, including transitive field requests.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (start i32) (end i32)) (returns SpecializationRead)
		(body
			(let-mut row (local start))
			(let-mut next (local end))
			(while
				(:doc "Fields may add layouts to the tail; cycles reuse an already published record.")
				(i32.lt (local row) (local next))
				(body
					(let layout (array.load (local records) (local row)))
					(if
						(:doc "Only a canonical specialization owns template fields.")
						(bool.and (i32.lt -1i32 (struct.get (local layout) specialization))
							(bool.not (call is_specialization_alias (local layout))))
						(then
							(let checked (call register_specialization_members (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-mut (local records)) (borrow-shared (local bindings)) (local row) (local next)))
							(if (u32.gtz (struct.get (local checked) error)) (then (return (local checked))))
							(set (local next) (struct.get (local checked) next))))
					(set (local row) (i32.inc (local row)))))
			(return (call specialization_progress (local next)))))

	(fn register_clone_type_layouts
		(:doc "Check concrete record and array types in a cloned function before reading its signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (declaration i32) (start i32)) (returns SpecializationRead)
		(body
			(let scalar (call register_fixed_arrays (borrow-shared (local source)) (borrow-shared (local nodes))
				(local declaration) (borrow-mut (local records)) (local start) (borrow-shared (local bindings))
				(struct.get (local scope) file) (struct.get (local scope) source_base) (bool false)))
			(if (u32.gtz (struct.get (local scalar) error)) (then (return (call specialization_failure (local scope) (local scalar)))))
			(let initial (struct.get (local scalar) operand))
			(let checked (call instantiate_type_applications (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-mut (local records)) (borrow-shared (local bindings)) (local scope) (local declaration) -1i32 (local initial)))
			(if (u32.gtz (struct.get (local checked) error)) (then (return (call specialization_failure (local scope) (local checked)))))
			(let closed (call register_requested_members (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-mut (local records)) (borrow-shared (local bindings)) (local initial) (struct.get (local checked) operand)))
			(if (u32.gtz (struct.get (local closed) error)) (then (return (local closed))))
			(let arrays (call register_fixed_arrays (borrow-shared (local source)) (borrow-shared (local nodes))
				(local declaration) (borrow-mut (local records)) (struct.get (local closed) next) (borrow-shared (local bindings))
				(struct.get (local scope) file) (struct.get (local scope) source_base) (bool true)))
			(if (u32.gtz (struct.get (local arrays) error)) (then (return (call specialization_failure (local scope) (local arrays)))))
			(return (call specialization_progress (struct.get (local arrays) operand)))))

	(fn validate_record_template_constants
		(:doc "Check record templates in their defining files before any application can use them.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (count i32)) (returns SpecializationRead)
		(body
			(let-mut row 0i32)
			(while
				(:doc "The published prefix includes imported nominal layouts as well as local definitions.")
				(i32.lt (local row) (local count))
				(body
					(let layout (array.load (local records) (local row)))
					(if
						(:doc "Only an unapplied record template has parameters to resolve.")
						(call is_generic_template (local layout))
						(then
							(let scope (call scope_at (struct.get (local layout) file) (struct.get (local layout) source_base)))
							(let result (call validate_template_constants (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (struct.get (local layout) generic)))
							(if (u32.gtz (struct.get (local result) error))
								(then (return (call specialization_failure (local scope) (local result)))))))
					(set (local row) (i32.inc (local row)))))
			(return (call specialization_progress (local count)))))

	(fn register_module_specializations
		(:doc "Register applications from active declarations and the fields of requested templates.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declarations (shared-array SelectedDeclaration))
			(count i32) (base i32) (scope TypeScope) (bindings (shared-array GraphBinding))
			(records (mut-array ScalarRecord)) (start i32)) (returns SpecializationRead)
		(body
			(let-mut index 0i32)
			(let-mut next (local start))
			(while
				(:doc "Template field layouts are checked with their arguments at an explicit use.")
				(i32.lt (local index) (local count))
				(body
					(let declaration (struct.get (array.load (local declarations) (i32.add (local base) (local index))) node))
					(let kind (call declaration_kind (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration)))
					(if
						(:doc "Exclude foreign declarations and defer the members of generic structs.")
						(bool.or (bool.or (bool.and (u32.eq (local kind) 1u32)
								(i32.ltz (call function_generic_list (borrow-shared (local source)) (borrow-shared (local nodes))
									(array.load (local nodes) (local declaration))))) (u32.eq (local kind) 15u32))
							(bool.or (u32.eq (local kind) (local enum_declaration))
								(bool.and (u32.eq (local kind) 48u32)
									(i32.ltz (call declaration_generic_list (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration))))))
						(then
							(let checked (call instantiate_type_applications (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-mut (local records)) (borrow-shared (local bindings)) (local scope) (local declaration) -1i32 (local next)))
							(if
								(:doc "An explicit use retains its own source location.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (call specialization_failure (local scope) (local checked)))))
							(set (local next) (struct.get (local checked) operand))))
					(set (local index) (i32.inc (local index)))))
			(return (call register_requested_members (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-mut (local records)) (borrow-shared (local bindings)) (local start) (local next)))))
)
