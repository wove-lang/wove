(module scalar_c_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register the native value types needed to check a C bridge.

	Keep one row per defining declaration. Parameter and field types
	can require rows even when the importer selects only a function.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/types.wove" (only reference_mode))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge))
	(use wove-file "./trees.wove" (only tree_owner (type ScalarTree)))
	(use wove-file "../source/c_names.wove" (only c_function_opening))
	(use wove-file "../source/c_formals.wove" (only next_c_value_formal))
	(use wove-file "../source/c_arguments.wove" (only read_c_view_type))
	(use wove-file "../source/c_headers.wove" (only read_c_native_parameter read_c_named_field_type))
	(use wove-file "../source/c_records.wove" (only is_c_record read_c_record))
	(use wove-file "../source/c_owners.wove" (only read_c_type_literal))
	(use wove-file "./records.wove" (only find_native_definition (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only scalar_type entry_at (type EntryRead)))

	(fn remember_native_type
		(:doc `Register one checked native value type by its original defining row.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode)) (file i32) (base i32)
			(declaration i32) (records (mut-slice ScalarRecord)) (next i32))
		(returns i32)
		(body
			(let relative (i32.sub.wrapping (local declaration) (local base)))
			(if
				(:doc "All local spellings share the same canonical type row.")
				(i32.lt -1i32 (call find_native_definition (borrow-shared (local records)) (local file) (local relative)))
				(then (return (local next))))
			(let node (slice.load (local nodes) (local declaration)))
			(let name (struct.get (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)) operands))
			(let-mut literal 0i32)
			(let-mut first -1i32)
			(let-mut count -1i32)
			(if
				(:doc "A native view retains the C type and all declared member rows.")
				(call is_c_record (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node))
				(then
					(let record (call read_c_record (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
					(set (local literal) (struct.get (local record) native))
					(set (local first) (struct.get (local record) first))
					(set (local count) (struct.get (local record) count)))
				(else
					(let alias (call read_c_type_literal (borrow-shared (local arena)) (borrow-shared (local nodes))
						(slice.load (local nodes) (local name))))
					(set (local literal) (struct.get (local alias) native))))
			(slice.store (local records) (local next)
				(struct.new ScalarRecord (name (local name)) (file (local file)) (identity 0u32)
					(first (local first)) (count (local count)) (declaration (local relative)) (native (local literal))
					(source_base 0i32) (emit_row 0i32)))
			(return (i32.add.wrapping (local next) 1i32))))

	(fn register_parameter_native_types
		(:doc `Register unowned native types required by a C signature, including unselected record names.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32)
			(trees (shared-slice ScalarTree)) (context SelectionContext) (records (mut-slice ScalarRecord)) (start i32))
		(returns i32)
		(body
			(let node (slice.load (local nodes) (local declaration)))
			(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
			(let native (call c_function_opening (borrow-shared (local arena)) (borrow-shared (local nodes)) (local parts)))
			(let bridge (call declaring_c_bridge (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
			(let params (slice.load (local nodes) (struct.get (local native) params)))
			(let first (struct.get (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local params)) operands))
			(let-mut cursor (call next_c_value_formal (borrow-shared (local arena)) (borrow-shared (local nodes)) (local first)))
			(let-mut next (local start))
			(while
				(:doc "Each parameter can introduce an integer alias or native record view.")
				(i32.lt -1i32 (local cursor))
				(body
					(let item (slice.load (local nodes) (local cursor)))
					(let type (struct.get (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local item)) operands))
					(let spelling (slice.load (local nodes) (local type)))
					(let type_form (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local spelling)))
					(let mode (call reference_mode (borrow-shared (local arena)) (borrow-shared (local nodes)) (struct.get (local type_form) head)))
					(let view (call read_c_view_type (borrow-shared (local arena)) (borrow-shared (local nodes)) (local spelling)))
					(if
						(:doc "References, array elements, and bare names can introduce native value type rows.")
						(bool.or (bool.or (u32.lt 0u32 (local mode)) (u32.lt 0u32 (struct.get (local view) access)))
							(bool.and (u32.eq (struct.get (local spelling) kind) 1u32)
								(u32.eq (call scalar_type (borrow-shared (local arena)) (borrow-shared (local nodes)) (local type)) 0u32)))
						(then
							(let found (call read_c_native_parameter (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local spelling) (local bridge) (local context)))
							(if
								(:doc "The graph already checked this formal. Owned pointers have their own encoding.")
								(bool.and (u32.eq (struct.get (local found) error) 0u32)
									(bool.and (i32.lt -1i32 (struct.get (local found) declaration))
										(i32.lt (struct.get (local found) drop_start) 0i32)))
								(then
									(let type_row (struct.get (local found) declaration))
									(let file (call tree_owner (borrow-shared (local trees)) (local type_row)))
									(let base (struct.get (slice.load (local trees) (local file)) base))
									(set (local next) (call remember_native_type (borrow-shared (local arena)) (borrow-shared (local nodes))
										(local file) (local base) (local type_row) (borrow-mut (local records)) (local next)))))))
					(set (local cursor) (call next_c_value_formal (borrow-shared (local arena)) (borrow-shared (local nodes))
						(struct.get (local item) next_sibling)))))
			(return (local next))))

	(fn register_record_dependencies
		(:doc `Resolve a native record's field types in its defining bridge and register each required representation.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode)) (row ScalarRecord) (base i32)
			(trees (shared-slice ScalarTree)) (context SelectionContext) (records (mut-slice ScalarRecord)) (start i32))
		(returns EntryRead)
		(body
			(let declaration (i32.add.wrapping (local base) (struct.get (local row) declaration)))
			(let bridge (call declaring_c_bridge (borrow-shared (local arena)) (borrow-shared (local nodes))
				(slice.load (local nodes) (local declaration))))
			(let-mut field (struct.get (local row) first))
			(let-mut next (local start))
			(while
				(:doc "Walk the view's original fields without making their names visible in the importing file.")
				(i32.lt -1i32 (local field))
				(body
					(let node (slice.load (local nodes) (local field)))
					(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
					(let operand (struct.get (local parts) operands))
					(let builtin (call scalar_type (borrow-shared (local arena)) (borrow-shared (local nodes)) (local operand)))
					(if
						(:doc "Resolve other type spellings among this header's active declarations.")
						(u32.eq (local builtin) 0u32)
						(then
							(let type (call read_c_named_field_type (borrow-shared (local arena)) (borrow-shared (local nodes))
								(slice.load (local nodes) (local operand)) (local bridge) (local context)))
							(if
								(:doc "Keep the defining provider span when a native field type cannot be resolved.")
								(u32.lt 0u32 (struct.get (local type) error))
								(then (return (struct.new EntryRead (operand -1i32) (start (struct.get (local type) start))
									(end (struct.get (local type) end)) (error (struct.get (local type) error)) (related -1i32)))))
							(let type_row (struct.get (local type) declaration))
							(let file (call tree_owner (borrow-shared (local trees)) (local type_row)))
							(let owner_base (struct.get (slice.load (local trees) (local file)) base))
							(set (local next) (call remember_native_type (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local file) (local owner_base) (local type_row) (borrow-mut (local records)) (local next)))))
					(set (local field) (struct.get (local node) next_sibling))))
			(return (call entry_at (slice.load (local nodes) (local declaration)) (local next) 0u32)))))
