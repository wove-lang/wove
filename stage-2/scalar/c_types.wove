(module scalar_c_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register the native value types needed to check a C bridge.

	Keep one row per defining declaration. Parameter and field types
	can require rows even when the importer selects only a function.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/types.wove" (only reference_mode))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge))
	(use wove-file "./trees.wove" (only tree_owner (type ScalarTree)))
	(use wove-file "../source/c_names.wove" (only c_function_opening))
	(use wove-file "../source/c_formals.wove" (only next_c_value_formal))
	(use wove-file "../source/c_arguments.wove" (only read_c_view_type is_c_callback_type))
	(use wove-file "../source/c_headers.wove" (only read_c_native_parameter read_c_named_field_type))
	(use wove-file "../source/c_records.wove" (only is_c_record read_c_record read_c_inline_field c_pointer_field_kind))
	(use wove-file "../source/c_owners.wove" (only read_c_type c_owner_uses_typedef is_c_long_double))
	(use wove-file "../emit/names.wove" (only source_identity hash_spelling record_identity))
	(use wove-file "./callable_types.wove" (only read_callable_type))
	(use wove-file "./records.wove" (only intern_callable_layout find_native_definition (value native_pointer_owner_tag) (value native_long_double_count) (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only scalar_type entry_at (type EntryRead)))

	(fn native_alias_identity
		(:doc "Hash the defining file, bridge header and declared alias name for structural layouts containing this type.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (file SuppliedFile)
			(declaration SourceNode) (name SourceNode)) (returns u32)
		(body
			(let path (call source_identity (borrow-shared arena) (struct.get file path_start) (struct.get file path_end)))
			(let bridge (call declaring_c_bridge (borrow-shared arena) (borrow-shared nodes) declaration))
			(let header (array.load nodes (struct.get (call form_parts (borrow-shared arena)
				(borrow-shared nodes) (array.load nodes bridge)) header)))
			(let owner (call hash_spelling (borrow-shared arena) (struct.get header start) (struct.get header end) path))
			(return (call record_identity (borrow-shared arena) (struct.get name start) (struct.get name end) owner))))

	(fn remember_native_type
		(:doc `Register one checked native value type by its original defining row.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (file i32) (base i32)
			(input SuppliedFile) (declaration i32) (records (mut-array ScalarRecord)) (next i32))
		(returns i32)
		(body
			(let relative (i32.sub declaration base))
			(if
				(:doc "All local spellings share the same canonical type row.")
				(i32.lt -1i32 (call find_native_definition (borrow-shared records) file relative))
				(then (return next)))
			(let node (array.load nodes declaration))
			(let name (struct.get (call form_parts (borrow-shared arena) (borrow-shared nodes) node) name))
			(let-mut literal 0i32)
			(let-mut first -1i32)
			(let-mut count -1i32)
			(if
				(:doc "A native view retains the C type and all declared member rows.")
				(call is_c_record (borrow-shared arena) (borrow-shared nodes) node)
				(then
					(let record (call read_c_record (borrow-shared arena) (borrow-shared nodes) node))
					(set literal (struct.get record native))
					(set first (struct.get record first))
					(set count (struct.get record count)))
				(else
					(let alias (call read_c_type (borrow-shared arena) (borrow-shared nodes) node))
					(if
						(:doc "Caller-owned C storage keeps its existing local-only ownership contract.")
						(struct.get alias storage)
						(then (return next)))
					(set literal (struct.get alias native))
					(if
						(:doc "Pointer owners retain their exact flattened declaration for ordinary Wove type lookup.")
						(i32.not-ltz (struct.get alias drop))
						(then
							(set first declaration)
							(set literal native_pointer_owner_tag))
						(else
							(let spelling (array.load nodes literal))
							(if
								(:doc "A checked long double alias keeps its floating category and original C spelling.")
								(call is_c_long_double (borrow-shared arena)
									(struct.get spelling start) (struct.get spelling end))
								(then (set count native_long_double_count)))))))
			(let-mut identity 0u32)
			(if
				(:doc "An integer alias can be the leaf of an owning element in a fixed array.")
				(bool.and (i32.eq count -1i32) (i32.gtz literal))
				(then (set identity (call native_alias_identity (borrow-shared arena) (borrow-shared nodes)
					input node (array.load nodes name)))))
			(array.store records next
				(struct.new ScalarRecord (c_name_slot 0i32) (name name) (file file) (identity identity)
					(first first) (count count) (declaration relative) (native literal)
					(source_base (struct.get input source_start)) (emit_row 0i32) (owns_arrays (bool false)) (borrows_bytes (bool false))
					(generic -1i32) (specialization -1i32) (argument_file -1i32) (argument_base 0i32) (alias_of -1i32)))
			(return (i32.inc next))))

	(fn register_parameter_native_types
		(:doc `Register unowned native types required by a C signature, including unselected record names.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32)
			(files (shared-array SuppliedFile)) (trees (shared-array ScalarTree)) (context SelectionContext) (records (mut-array ScalarRecord)) (start i32))
		(returns i32)
		(body
			(let node (array.load nodes declaration))
			(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) node))
			(let native (call c_function_opening (borrow-shared arena) (borrow-shared nodes) parts))
			(let bridge (call declaring_c_bridge (borrow-shared arena) (borrow-shared nodes) node))
			(let params (array.load nodes (struct.get native params)))
			(let first (struct.get (call form_parts (borrow-shared arena) (borrow-shared nodes) params) operands))
			(let-mut cursor (call next_c_value_formal (borrow-shared arena) (borrow-shared nodes) first))
			(let-mut next start)
			(while
				(:doc "Each parameter can introduce a native scalar alias or record view.")
				(i32.lt -1i32 cursor)
				(body
					(let item (array.load nodes cursor))
					(let type (struct.get (call form_parts (borrow-shared arena) (borrow-shared nodes) item) operands))
					(let spelling (array.load nodes type))
					(if
						(:doc "A selected C function can add its callback signature to the canonical callable layouts.")
						(call is_c_callback_type (borrow-shared arena) (borrow-shared nodes) spelling)
						(then
							(let shape (call read_callable_type (borrow-shared arena) (borrow-shared nodes) spelling))
							(let layout (call intern_callable_layout (borrow-shared arena) (borrow-shared nodes)
								(borrow-mut records) shape next))
							(if
								(:doc "The signature checker diagnoses an unavailable layout at the original formal.")
								(i32.ltz layout)
								(then (return next)))
							(set next layout)))
					(let type_form (call form_parts (borrow-shared arena) (borrow-shared nodes) spelling))
					(let mode (call reference_mode (borrow-shared arena) (borrow-shared nodes) (struct.get type_form head)))
					(let view (call read_c_view_type (borrow-shared arena) (borrow-shared nodes) spelling (bool false)))
					(if
						(:doc "References, array elements, and bare names can introduce native value type rows.")
						(bool.or (bool.or (u32.gtz mode) (u32.gtz (struct.get view access)))
							(bool.and (u32.eq (struct.get spelling kind) 1u32)
								(u32.eqz (call scalar_type (borrow-shared arena) (borrow-shared nodes) type))))
						(then
							(let found (call read_c_native_parameter (borrow-shared arena) (borrow-shared nodes)
								spelling bridge context))
							(if
								(:doc "The graph has already checked the formal and identified any native type.")
								(bool.and (u32.eqz (struct.get found error))
									(i32.lt -1i32 (struct.get found declaration)))
								(then
									(let type_row (struct.get found declaration))
									(if
										(:doc "Record copyable types and pointer typedef owners that need a C check.")
										(bool.or (i32.ltz (struct.get found drop_start))
											(call c_owner_uses_typedef (borrow-shared arena) (borrow-shared nodes)
												(call read_c_type (borrow-shared arena) (borrow-shared nodes)
													(array.load nodes type_row))))
										(then
											(let file (call tree_owner (borrow-shared trees) type_row))
											(let base (struct.get (array.load trees file) base))
											(set next (call remember_native_type (borrow-shared arena) (borrow-shared nodes)
												file base (array.load files file)
												type_row (borrow-mut records) next))))))))
					(set cursor (call next_c_value_formal (borrow-shared arena) (borrow-shared nodes)
						(struct.get item next_sibling)))))
			(return next)))

	(fn register_record_dependencies
		(:doc `Resolve a native record's field types in its defining bridge and register each required representation.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (row ScalarRecord) (base i32)
			(files (shared-array SuppliedFile)) (trees (shared-array ScalarTree)) (context SelectionContext) (records (mut-array ScalarRecord)) (start i32))
		(returns EntryRead)
		(body
			(let declaration (i32.add base (struct.get row declaration)))
			(let bridge (call declaring_c_bridge (borrow-shared arena) (borrow-shared nodes)
				(array.load nodes declaration)))
			(let-mut field (struct.get row first))
			(let-mut next start)
			(while
				(:doc "Walk the view's original fields without making their names visible in the importing file.")
				(i32.lt -1i32 field)
				(body
					(let node (array.load nodes field))
					(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) node))
					(let operand (struct.get parts operands))
					(let builtin (call scalar_type (borrow-shared arena) (borrow-shared nodes) operand))
					(let inline (call read_c_inline_field (borrow-shared arena) (borrow-shared nodes)
						(array.load nodes operand)))
					(if
						(:doc "Resolve named types in this header. Builtins and inline byte arrays add no type dependencies.")
						(bool.and (bool.and (u32.eqz builtin) (i32.eqz (struct.get inline extent)))
							(u32.eqz (call c_pointer_field_kind (borrow-shared arena) (array.load nodes operand))))
						(then
							(let type (call read_c_named_field_type (borrow-shared arena) (borrow-shared nodes)
								(array.load nodes operand) bridge context))
							(if
								(:doc "Keep the defining provider span when a native field type cannot be resolved.")
								(u32.gtz (struct.get type error))
								(then (return (struct.new EntryRead (operand -1i32) (start (struct.get type start))
									(end (struct.get type end)) (error (struct.get type error)) (related -1i32)))))
							(let type_row (struct.get type declaration))
							(let file (call tree_owner (borrow-shared trees) type_row))
							(let owner_base (struct.get (array.load trees file) base))
							(set next (call remember_native_type (borrow-shared arena) (borrow-shared nodes)
								file owner_base (array.load files file)
								type_row (borrow-mut records) next))))
					(set field (struct.get node next_sibling))))
			(return (call entry_at (array.load nodes declaration) next 0u32)))))
