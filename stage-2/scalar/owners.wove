(module scalar_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Classify lexical owners and the expression rows for their loans and transfers.")

	(use wove-file "./records.wove" (only array_owner_type array_slot_code is_array_owner is_owning_record is_owning_array_element is_scoped_record (type ScalarRecord)))
	(use wove-file "./native_owner_types.wove" (only is_native_owner (value optional_array_base)))
	(use wove-file "./syntax.wove" (only is_worker_collect))
	(use wove-file "../source/types.wove" (only (value worker_receipt_type) (value worker_queue_type) (value worker_pool_type) (value worker_permit_type)))

	(let worker_receipt_move_kind 574u32)
	(let worker_permit_move_kind 583u32)

	(let checked_foreign_handle_kind
		(:doc "Identify a directly passed foreign handle that needs a presence check.")
		642u32)

	(let native_handle_slot_borrow_kind
		(:doc "Identify a shared loan of the original native pointer slot.")
		200u32)

	(fn native_handle_borrow_kind
		(:doc `Identify a checked shared handle argument in the expression plan.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 58u32)))

	(fn native_storage_init_borrow_kind
		(:doc `Identify an exclusive loan that needs inactive native storage.`)
		(params)
		(returns u32)
		(body (return 104u32)))

	(fn native_storage_mut_borrow_kind
		(:doc `Identify an exclusive loan of active native storage or a present handle.`)
		(params)
		(returns u32)
		(body (return 105u32)))

	(fn native_handle_init_borrow_kind
		(:doc "Identify an exclusive loan of an empty opaque handle slot.")
		(:pragma (inline always))
		(params) (returns u32)
		(body (return 199u32)))

	(fn is_native_storage_write_loan
		(:doc `Check whether a native owner argument holds an exclusive loan.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (u32:eq kind (call native_storage_init_borrow_kind))
			(u32:eq kind (call native_storage_mut_borrow_kind))))))

	(fn is_native_owner_write_loan
		(:doc "Check whether a native loan grants exclusive access to its owner.")
		(:pragma (inline always))
		(params (kind u32)) (returns bool)
		(body (return (bool:or (call is_native_storage_write_loan kind)
			(u32:eq kind (call native_handle_init_borrow_kind))))))

	(fn owner_is_null_kind
		(:doc `Identify a null test on an owner without acquiring a loan.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 98u32)))

	(fn native_handle_consume_kind
		(:doc `Identify a checked pointer transfer into a consuming bridge argument.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 99u32)))

	(fn optional_byte_owner_type
		(:doc `Represent an optional byte array under its own type code and the nullable array ABI.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 13u32)))

	(fn is_optional_owner
		(:doc "Identify nullable array owners independently of their exact payload slot and producer.")
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool:or (u32:eq type (call optional_byte_owner_type))
			(u32:not-lt type optional_array_base)))))

	(fn optional_owner_type
		(:doc "Map an exact array owner to its optional type using the canonical element slot.")
		(params (owner u32))
		(returns u32)
		(body
			(if
				(:doc "The existing byte option preserves its compact code and C snapshot representation.")
				(u32:eq owner (call array_owner_type 10u32))
				(then (return (call optional_byte_owner_type))))
			(if (bool:not (call is_array_owner owner)) (then (return 0u32)))
			(return (u32:add optional_array_base (call array_slot_code owner)))))

	(fn optional_owner_payload
		(:doc "Recover the exact array owner type of a checked optional value.")
		(params (type u32))
		(returns u32)
		(body
			(if (u32:eq type (call optional_byte_owner_type)) (then (return (call array_owner_type 10u32))))
			(if (bool:not (call is_optional_owner type)) (then (return 0u32)))
			(return (call array_owner_type (u32:sub type optional_array_base)))))

	(fn optional_unwrap_kind
		(:doc `Identify a checked move from a present optional array owner.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 101u32)))

	(fn owned_array_take_kind
		(:doc "Identify an owning array transfer that clears its original slot.")
		(params) (returns u32)
		(body (return 246u32)))

	(fn owned_field_loan_kind
		(:doc "Identify an array descriptor lent by a checked owned field.")
		(params) (returns u32)
		(body (return 247u32)))

	(fn owned_aggregate_take_kind
		(:doc "Identify an evaluating move that empties a named aggregate slot.")
		(params)
		(returns u32)
		(body (return 249u32)))

	(fn is_owner_take
		(:doc "Recognize a move that empties the source slot at runtime.")
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (bool:or (u32:eq kind (call owned_array_take_kind))
			(u32:eq kind (call owned_aggregate_take_kind)))
			(bool:or (bool:or (u32:eq kind worker_receipt_move_kind)
				(u32:eq kind worker_permit_move_kind)) (call is_worker_collect kind))))))

	(fn is_lexical_owner
		(:doc "Identify locals that require scope cleanup for their arrays, records, handles, or worker receipts.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body (return (bool:or (call is_local_owner type)
			(call is_owning_record (borrow-shared records) type)))))

	(fn is_owned_parameter
		(:doc "Identify ordinary Wove formals that receive a lexical owner by value.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool:or (call is_array_owner type)
				(call is_owning_array_element (borrow-shared records) type)))))

	(fn is_replaceable_owner
		(:doc "Identify exact owner types with an independently droppable slot and no retained borrow.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool:and (call is_lexical_owner (borrow-shared records) type)
				(bool:not (bool:or (call is_worker_owner type)
					(call is_scoped_record (borrow-shared records) type)))))))

	(fn is_nullable_worker_owner
		(:doc "Pools and reservations can be missing after an unsuccessful attempt.")
		(params (type u32)) (returns bool)
		(body (return (bool:or (u32:eq type worker_pool_type)
			(u32:eq type worker_permit_type)))))

	(fn is_worker_owner
		(:doc "Identify opaque worker values that must retire at lexical scope exit.")
		(params (type u32)) (returns bool)
		(body (return (bool:or (call is_nullable_worker_owner type)
			(bool:or (u32:eq type worker_receipt_type) (u32:eq type worker_queue_type))))))

	(fn is_local_owner
		(:doc `Identify a local value that must participate in lexical cleanup.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool:or (bool:or (call is_worker_owner type) (call is_optional_owner type))
			(bool:or (call is_array_owner type) (call is_native_owner type)))))))
