(module scalar_owners
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Represent local owner types and recover a native owner's defining declaration.

	The high bit distinguishes a C pointer owner from the existing scalar,
	record, array, and slice encodings. The graph bounds flat tree indices
	to signed i32, so the remaining bits hold one original declaration link.`)

	(use wove-file "./records.wove" (only is_array_owner))

	(fn native_owner_type
		(:doc `Encode a C resource type by the defining declaration in the flattened tree.`)
		(:pragma (inline always))
		(params (declaration i32))
		(returns u32)
		(body (return (u32.add.wrapping (u32 2147483648) (int.convert u32 (local declaration))))))

	(fn is_native_owner
		(:doc `Test the high bit reserved for native pointer owners.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (u32.lt (u32 2147483647) (local type)))))

	(fn native_owner_declaration
		(:doc `Recover the checked declaration row of a native pointer owner.`)
		(:pragma (inline always))
		(params (type u32))
		(returns i32)
		(body (return (int.convert i32 (u32.sub.wrapping (local type) (u32 2147483648))))))

	(fn native_handle_borrow_kind
		(:doc `Identify a checked shared handle argument in the expression plan.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return (u32 58))))

	(fn native_handle_is_null_kind
		(:doc `Identify a null test on a native owner without acquiring a loan.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return (u32 98))))

	(fn native_handle_consume_kind
		(:doc `Identify a checked pointer transfer into a consuming bridge argument.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return (u32 99))))

	(fn is_local_owner
		(:doc `Identify a local value that must participate in lexical cleanup.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_array_owner (local type)) (call is_native_owner (local type)))))))
