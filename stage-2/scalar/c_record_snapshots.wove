(module scalar_c_record_snapshots
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check that a private snapshot mapping fills exactly one nominal owned result.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/c_record_snapshots.wove" (only find_snapshot_schema read_snapshot_schema read_snapshot_field
		(value snapshot_string) (value snapshot_vector) (value snapshot_optional_string)))
	(use wove-file "./syntax.wove" (only same_name))
	(use wove-file "./records.wove" (only value_type is_record_type record_index is_payload_enum is_owning_record
		member_value_type array_owner_type byte_rows_owner_type (type ScalarRecord)))

	(struct RecordSnapshot (fields (schema i32) (type u32) (present i32) (start i32) (end i32) (error u32)))

	(fn snapshot_error
		(:doc "Locate the unsupported source mapping or result exactly.")
		(params (node SourceNode)) (returns RecordSnapshot)
		(body (return (struct:new RecordSnapshot (schema -1i32) (type 0u32) (present -1i32)
			(start (node.get start)) (end (node.get end)) (error 23u32)))))

	(fn optional_string_layout
		(:doc "Check the reusable two-field representation of a nullable owned C string.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32)) (returns bool)
		(body
			(if (bool:not (call is_owning_record (borrow-shared records) type)) (then (return (bool false))))
			(let layout (records.get (call record_index type)))
			(if
				(:doc "The first field is a presence bit and the second owns the detached bytes.")
				(bool:or (i32:not-eq (layout.get count) 2i32) (i32:not-eqz (layout.get native)))
				(then (return (bool false))))
			(let present (nodes.get (layout.get first)))
			(let bytes (nodes.get (present.get next_sibling)))
			(return (bool:and
				(u32:eq 12u32 (call member_value_type (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) layout present))
				(u32:eq (call array_owner_type 10u32)
					(call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout bytes))))))

	(fn match_snapshot_fields
		(:doc "Match each projection with the corresponding owned destination field in declaration order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (layout ScalarRecord) (first i32)) (returns i32)
		(body
			(let-mut map first)
			(let-mut member (layout.get first))
			(while
				(:doc "The mapping fills each field exactly once and admits no extra members.")
				(i32:not-ltz map)
				(body
					(if (i32:ltz member) (then (return map)))
					(let row (nodes.get map))
					(let checked (call read_snapshot_field (borrow-shared source) (borrow-shared nodes) row))
					(let mode (checked.get mode))
					(if (u8:eqz mode) (then (return map)))
					(let expected (nodes.get member))
					(let actual (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout expected))
					(let-mut type (checked.get type))
					(if (u8:eq mode snapshot_string) (then (set type (call array_owner_type 10u32))))
					(if (u8:eq mode snapshot_vector) (then (set type (call byte_rows_owner_type))))
					(let-mut valid (u32:eq actual type))
					(if
						(:doc "Nullable strings own a two-field presence and byte record.")
						(u8:eq mode snapshot_optional_string)
						(then (set valid (call optional_string_layout (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (borrow-shared bindings) actual))))
					(if
						(:doc "Match the exact destination name and its checked field type.")
						(bool:or (bool:not valid)
							(bool:not (call same_name (borrow-shared source)
								(nodes.get (row.get first_child)) (nodes.get (expected.get first_child)))))
						(then (return map)))
					(set map (row.get next_sibling))
					(set member (expected.get next_sibling))))
			(if (i32:not-ltz member) (then (return first)))
			(return -1i32)))

	(fn check_record_snapshot
		(:doc "Resolve a closed absence/presence enum and validate its exact snapshot payload.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (declaration SourceNode) (mapping i32) (result i32)
			(file i32) (base i32)) (returns RecordSnapshot)
		(body
			(let name (nodes.get mapping))
			(let schema (call find_snapshot_schema (borrow-shared source) (borrow-shared nodes) declaration name))
			(if (i32:ltz schema) (then (return (call snapshot_error name))))
			(let checked (call read_snapshot_schema (borrow-shared source) (borrow-shared nodes) schema))
			(if
				(:doc "The mapping carries its own native type and shape diagnostic.")
				(u32:gtz (checked.get error))
				(then (return (struct:new RecordSnapshot (schema -1i32) (type 0u32) (present -1i32)
					(start (checked.get start)) (end (checked.get end)) (error (checked.get error))))))
			(let site (nodes.get result))
			(let type (call value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) file base result))
			(if (bool:not (call is_record_type type)) (then (return (call snapshot_error site))))
			(let outcome (records.get (call record_index type)))
			(if
				(:doc "The result is a named enum with exactly one absence and one presence variant.")
				(bool:or (bool:not (call is_payload_enum outcome)) (i32:not-eq (outcome.get count) 2i32))
				(then (return (call snapshot_error site))))
			(let first (nodes.get (outcome.get first)))
			(let second (nodes.get (first.get next_sibling)))
			(let first_type (call member_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) outcome first))
			(let second_type (call member_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) outcome second))
			(let-mut payload first_type)
			(let-mut ordinal 0i32)
			(if
				(:doc "Either declaration order may give the payload its discriminant.")
				(u32:eqz first_type)
				(then
					(set payload second_type)
					(set ordinal 1i32)))
			(if
				(:doc "The opposite variant must be unit, and the payload must own its detached fields.")
				(bool:or (bool:and (u32:gtz first_type) (u32:gtz second_type))
					(bool:not (call is_owning_record (borrow-shared records) payload)))
				(then (return (call snapshot_error site))))
			(let target (call value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) file base (checked.get name)))
			(if (u32:not-eq target payload) (then (return (call snapshot_error site))))
			(let layout (records.get (call record_index payload)))
			(if
				(:doc "Only an ordinary record has one direct C storage member per mapped field.")
				(i32:not-eqz (layout.get native))
				(then (return (call snapshot_error site))))
			(let invalid (call match_snapshot_fields (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) layout (checked.get first)))
			(if (i32:not-ltz invalid) (then (return (call snapshot_error (nodes.get invalid)))))
			(return (struct:new RecordSnapshot (schema schema) (type type) (present ordinal)
				(start (site.get start)) (end (site.get end)) (error 0u32))))))
