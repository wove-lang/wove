					(let tag (call entry_keyword (borrow-shared source) (borrow-shared nodes) operand))
					(if
						(:doc "Only the bare true and false spellings are bool values.")
						(bool.and (u32.not-eq tag 13u32) (u32.not-eq tag 14u32))
						(then (return (call entry_at value -1i32 25u32))))
