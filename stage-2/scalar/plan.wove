						(:doc "A type-only module has no first function to identify.")
						(i32.eqz next_function)
						(then (return (call entry_at module_name -1i32 22u32))))
					(return (call entry_at
						(array.load nodes (struct.get (array.load functions 0i32) name)) -1i32 22u32))))
			(return (struct.new EntryRead (operand main) (start 0i32) (end 0i32) (error 0u32) (related -1i32)))))

	(fn plan_floating_value
		(:doc `Validate the decimal spelling and record the bytes used by C for direct rounding.`)
		(params (source (shared-array u8)) (node SourceNode) (end i32) (type u32)
			(index i32) (expressions (mut-array ScalarExpression)))
