	(fn read_module_declarations
		(:doc `Register selected functions and record layouts in their separate namespaces.

		Classify main as the ABI entry in an executable root. Library functions
		follow ordinary scalar signature and call rules, including main.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (functions (mut-array ScalarFunction))
			(parameters (mut-array ScalarParameter)) (records (mut-array ScalarRecord))
			(bindings (mut-array GraphBinding)) (file i32) (entry_module bool)
			(statements (mut-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let constants (call register_standalone_constants (borrow-shared source) (borrow-shared nodes)
				(borrow-mut bindings)))
			(if
				(:doc "Report a failed constant before using it in a local layout.")
				(u32.gtz (struct.get constants error))
				(then (return constants)))
			(let module_name (array.load nodes (struct.get module name)))
			(let module_id (call module_identity (borrow-shared source)
				(struct.get module_name start) (struct.get module_name end)))
			(let scope (struct.new FunctionScope (file file) (tree_base 0i32)
				(tree_limit (array.len nodes)) (source_base 0i32) (module_id module_id)
				(entry_module entry_module) (mode (struct.get module mode))))
			(let types (call register_module_records (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) (struct.get module count) 0i32 0i32
				file module_id (borrow-mut records) 0i32 (borrow-shared bindings)))
			(if
				(:doc "Register the full type namespace before reading forward signature references.")
				(u32.gtz (struct.get types error))
				(then (return types)))
			(let templates (call validate_record_template_constants (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) (struct.get types operand)))
			(if
				(:doc "Check named constant types before any template application.")
				(u32.gtz (struct.get templates error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get templates start))
					(end (struct.get templates end)) (error (struct.get templates error)) (related -1i32)))))
			(let instances (call register_module_specializations (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) (struct.get module count) 0i32 (call scope_at file 0i32)
				(borrow-shared bindings) (borrow-mut records) (struct.get types operand)))
			(if
				(:doc "Check explicit record applications before resolving signatures or field dependencies.")
				(u32.gtz (struct.get instances error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get instances start))
					(end (struct.get instances end)) (error (struct.get instances error)) (related -1i32)))))
			(let arrays (call register_module_record_arrays (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) (struct.get module count) 0i32 file 0i32
				(borrow-shared bindings) (borrow-mut records) (struct.get instances next)))
			(if
				(:doc "Record array sizes and elements resolve before field dependency checking.")
				(u32.gtz (struct.get arrays error))
				(then (return arrays)))
			(let layouts (call order_record_layouts (borrow-shared source) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-mut records) (struct.get arrays operand)))
			(if
				(:doc "Validate all field types and reject cycles before checking bodies.")
				(u32.gtz (struct.get layouts error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get layouts start))
					(end (struct.get layouts end)) (error (struct.get layouts error)) (related -1i32)))))
			(let owners (call register_owned_rows (borrow-shared source) (borrow-shared nodes) 0i32
				(array.len nodes) (borrow-shared bindings) (call scope_at file 0i32)
				(borrow-mut records) (struct.get arrays operand)))
			(if
				(:doc "Finish nested array identities before reading function signatures.")
				(u32.gtz (struct.get owners error))
				(then (return owners)))
			(let fields (call validate_record_array_fields (borrow-shared source) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared records) (struct.get arrays operand)))
			(if
				(:doc "An owning field needs a valid element and all of its array layers.")
				(u32.gtz (struct.get fields error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get fields start))
					(end (struct.get fields end)) (error (struct.get fields error)) (related -1i32)))))
			(let values (call register_module_bindings (borrow-shared source) (borrow-shared nodes)
				(borrow-shared declarations) (struct.get module count) 0i32 file 0i32
				(borrow-shared bindings) (borrow-mut records) (struct.get owners operand)
				(borrow-mut statements) (borrow-mut expressions)))
			(if
				(:doc "Validate even unused module initializers before planning function bodies.")
				(u32.gtz (struct.get values error))
				(then (return values)))
