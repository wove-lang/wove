				type index (borrow-mut expressions)))))

	(fn plan_suffixed_number
		(:doc `Check a suffixed integer or floating atom.`)
		(params (source (shared-array u8)) (node SourceNode) (index i32) (expected u32)
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let end (struct.get node end))
			(let start (struct.get node start))
			(let atom (call integer_atom (borrow-shared source) start end))
			(let suffix (struct.get atom end))
			(let digits (struct.get atom digits))
			(if
				(:doc "A radix prefix takes priority over bytes that resemble a floating suffix.")
				(i32.not-eq (struct.get atom radix) 10i32)
				(then
					(if (i32.eq suffix digits) (then (return (call entry_at node -1i32 25u32))))
					(return (call plan_suffixed_integer (borrow-shared source) node suffix
						index expected (borrow-mut expressions)))))
			(if
				(:doc "Check a float suffix separately so fractions and exponents remain in the decimal spelling.")
				(i32.lt 3i32 (i32.sub end start))
				(then
					(let-mut tail 3i32)
					(if
						(:doc "The binary128 suffix is four bytes and needs a preceding decimal digit.")
						(bool.and (i32.lt 4i32 (i32.sub end start))
							(u32.eq (call builtin_type_keyword (borrow-shared source) (i32.sub end 4i32) 4i32)
								f128_type))
						(then (set tail 4i32)))
					(let suffix (i32.sub end tail))
					(let type (call builtin_type_keyword (borrow-shared source) suffix tail))
					(if
						(:doc "Preserve the exact type and original span of the checked float atom.")
						(call is_builtin_float type)
