	(fn check_call_arguments
		(:doc "Validate inferred C tails and record the runtime checks for exact Wove arguments.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (limit i32)
			(caller ScalarFunction) (view_start i32) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(expressions (mut-array ScalarExpression))) (returns BodyPlan)
