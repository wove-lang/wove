	(fn plan_view
		(:doc `Check a call loan and select its named or projected storage.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (caller ScalarFunction) (statement i32) (expected u32) (mode u8) (view_start i32)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "A library-owned pointer handle can be supplied directly to its shared native formal.")
				(bool.and (call is_native_owner expected) (u8.eq mode (call c_value_mode)))
