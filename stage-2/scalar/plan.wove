									(record.get (local node) end) (u32 24)))))
							(let checked (call plan_statement (borrow-shared (local source)) (borrow-shared (local nodes))
								(local caller) (local index) (borrow-shared (local functions)) (borrow-shared (local parameters))
								(borrow-shared (local bindings)) (borrow-shared (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
								(borrow-mut (local sites)) (local site_count) (local view_start) (local previous_owner)))
							(if
								(:doc "Stop before planning any statements past the originating error.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (local checked))))
							(set (local site_count) (record.get (local checked) count))
							(let statement (slice.load (local statements) (local index)))
							(let kind (record.get (local statement) kind))
							(if
								(:doc "Only an owning declaration adds an active owner to this scope.")
								(bool.and (bool.or (u32.eq (local kind) (u32 15)) (u32.eq (local kind) (u32 16)))
									(call is_local_owner (record.get (local statement) type)))
								(then (set (local previous_owner) (local index))))
							(set (local falls_through) (record.get (local statement) falls_through))
							(let first (record.get (local statement) first))
							(if
								(:doc "Control flow enters its first block. Other statements continue at their sibling.")
								(i32.lt (local first) (i32 0))
								(then (set (local index) (call skip_disabled_siblings (borrow-shared (local source))
									(borrow-shared (local nodes)) (record.get (local node) next_sibling))))
								(else
									(set (local block) (local first))
									(set (local index) (record.get (slice.load (local statements) (local block)) first))))))))
			(if
				(:doc "Every path through a value-returning body must return.")
				(bool.and (local falls_through) (bool.not (u32.eq (record.get (local caller) result) (call void_type))))
				(then
					(let node (slice.load (local nodes) (local outer)))
					(return (call body_error (local caller) (record.get (local node) start)
						(record.get (local node) end) (u32 24)))))
			(slice.store (local statements) (local outer)
				(call block_statement (record.get (local caller) first_statement) (local previous_owner) (local falls_through)))
			(return (call body_success (local site_count)))))

	(fn plan_bodies
		(:doc `Check each selected function and retain the resolved calls in source order.

		Start with zeroed plan storage. Read the returned call-site count
		only on success. Use zero view start for an arena of whole source files.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(bindings (shared-slice GraphBinding)) (records (shared-slice ScalarRecord)) (statements (mut-slice ScalarStatement))
			(expressions (mut-slice ScalarExpression)) (sites (mut-slice CallSite)) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count (i32 0))
			(let-mut function (i32 0))
			(while
				(:doc "Each Wove function has its own block scopes and checked exits.")
				(i32.lt (local function) (slice.len (local functions)))
				(body
					(let definition (slice.load (local functions) (local function)))
					(if
						(:doc "Foreign signatures contribute call targets while their bodies come from C.")
						(bool.not (i32.lt (record.get (local definition) body) (i32 0)))
						(then
							(let checked (call plan_function_body (borrow-shared (local source)) (borrow-shared (local nodes))
								(local definition) (borrow-shared (local functions))
								(borrow-shared (local parameters)) (borrow-shared (local bindings)) (borrow-shared (local records))
								(borrow-mut (local statements)) (borrow-mut (local expressions)) (borrow-mut (local sites))
								(local site_count) (local view_start)))
							(if
								(:doc "Report the earliest rejected body with the original file and span.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (local checked))))
							(set (local site_count) (record.get (local checked) count))))
					(set (local function) (i32.add.wrapping (local function) (i32 1)))))
			(return (call body_success (local site_count))))))
