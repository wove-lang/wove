(module scalar_plan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve selected scalar functions and calls before C emission.

	Collect signatures first, then check each body in source order against
	the function signatures and bindings visible at each statement. Track
	whether statements can reach their next sibling across scoped control flow.
	Function rows retain their original declaration and name nodes. Checked
	call rows keep the callee row independently of
	the name that will be used in C, and are indexed by original call node.
	Retain source-level call sites before either inspection or lowering.
	Array borrow inference uses expectation codes below defining record types.`)

	(use wove-file "../source/enum_forms.wove" (only (value enum_declaration) (value enum_constructor) (value enum_payload_constructor) (value match_statement)
		(value pending_match_value) (value match_case_gate)))
	(use wove-file "./slice_options.wove" (only plan_try_slice plan_view_option))
	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind) (value optional_view_type) (value optional_view_absent) (value optional_view_unwrap)))
	(use wove-file "./locals.wove" (only find_local check_binding_name))
	(use wove-file "./integer_literals.wove" (only plan_integer_value))
	(use wove-file "./matches.wove" (only plan_match_cases enter_case_owner match_continues seed_match_value seed_match_results finish_match_value find_match_binding))
	(use wove-file "./loops.wove" (only read_for_names read_iteration_source register_iteration_bindings is_iteration_statement enter_consuming_iteration))
	(use wove-file "../source/integer_compare.wove" (only is_explicit_integer_equality))
	(use wove-file "../source/integer_ops.wove" (only is_checked_integer_operator is_integer_division))
	(use wove-file "../source/integer_checks.wove" (only read_integer_check is_integer_check (value integer_fits) (type IntegerCheck)))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion integer_byte_width is_integer_byte_conversion
		is_integer_byte_encoder (value typed_integer_conversion) (value exact_byte_view)))
	(use wove-file "../text/character.wove" (only decode_character))
	(use wove-file "../source/extent.wove" (only normalized_extent))
	(use wove-file "../source/literals.wove" (only integer_atom))
	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token) (value character_token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/c_headers.wove" (only read_c_native_parameter))
	(use wove-file "../source/c_formals.wove" (only next_c_value_formal))
	(use wove-file "../source/c_owners.wove" (only is_c_storage_type read_c_owner))
	(use wove-file "../source/c_arguments.wove" (only read_c_view_type c_row_slice_type))
	(use wove-file "../emit/names.wove" (only module_identity function_identity))
	(use wove-file "../c/arguments.wove" (only c_value_mode c_consume_mode is_c_null_mode accepts_c_null c_null_argument_kind
		c_storage_shared_mode c_storage_mut_mode c_storage_init_mode c_storage_consume_mode c_handle_mut_mode is_c_exclusive_owner_mode
		is_c_storage_mode is_c_storage_init_mode is_c_handle_init_mode is_c_consuming_mode (value c_open_variadic_tail) (value c_shared_handle_slot_mode)
		(value c_static_string_mode) (value c_static_string_argument)))
	(use wove-file "../source/target.wove" (only default_selection (type SelectionContext)))
	(use wove-file "../source/types.wove" (only void_type is_builtin_integer_value is_builtin_float is_builtin_numeric is_builtin_scalar builtin_type_keyword reference_mode (value f128_type) (value worker_receipt_type) (value worker_queue_type) (value worker_pool_type) (value worker_permit_type)))
	(use wove-file "../source/float_ops.wove" (only float_literal_shape is_float_conversion (value float_literal)))
	(use wove-file "./specializations.wove" (only register_module_specializations validate_record_template_constants))
	(use wove-file "../source/generics.wove" (only has_specialization_head generic_i32_value is_checked_non_type_operand
		(value normalized_i32_literal) (value checked_i32_operand) (value checked_function_operand) (value checked_operation_operand) (value checked_bool_operand) (value checked_enum_operand)))
	(use wove-file "./records.wove"
		(only scope_at checked_enum_value is_generic_template is_callable_type callable_index callable_layout_shape (value callable_alias_kind) declaration_kind register_module_records register_module_record_arrays register_owned_rows order_record_layouts validate_record_array_fields value_type copyable_type owned_array_leaf_type is_owning_array_element has_inline_owner_slots is_owning_record is_scoped_record read_parameter_type read_optional_native_parameter optional_record_borrow_type read_view_parameter_extent find_record pointer_owner_definition record_type record_index is_record_type
			find_member member_value_type native_field_type read_member_operand register_static_array find_fixed_array_type is_fixed_array is_enum_layout is_payload_enum is_typed_slice is_fixed_scalar_slice typed_slice_type typed_slice_element_code encode_place_type slice_element_code slice_element_type is_readable_slice is_writable_slice shared_byte_rows_type
			is_array_owner array_owner_type owning_array_type array_owner_element array_slot_code owner_view_type read_owned_array_type byte_rows_owner_type is_native_integer native_row_type find_native_node (type ScalarRecord)
			is_native_record is_native_long_double is_optional_record_borrow is_place_reference is_mutable_place_reference place_reference_type place_reference_target mutable_scalar_target record_receiver_type place_borrow_kind))
	(use wove-file "./callable_types.wove" (only callable_parameter_type))
	(use wove-file "./function_rows.wove" (only checked_function_count resolve_call_target find_function_instance find_parameter find_function_parameter
		(type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./function_refs.wove" (only register_function_references plan_function_reference plan_adapted_callback))
	(use wove-file "./callback_types.wove" (only read_callback_shape is_adapted_callback))
	(use wove-file "./value_types.wove" (only value_matches_type (value static_number)))
	(use wove-file "./borrowed_results.wove" (only borrowed_result_view is_provenance_return invalid_return_origin binding_initializer))
	(use wove-file "./signatures.wove" (only read_signature_head complete_signature (type ScalarSignature)))
	(use wove-file "../source/owned.wove" (only (value optional_none) (value optional_some) (value pending_optional_some)))
	(use wove-file "./recoverable_growth.wove" (only read_push_outcome))
	(use wove-file "./optional.wove" (only read_optional_result plan_optional_constructor finish_optional_some))
	(use wove-file "./owners.wove" (only is_local_owner is_lexical_owner is_owned_parameter is_replaceable_owner is_worker_owner is_nullable_worker_owner owned_array_take_kind owned_field_loan_kind owned_aggregate_take_kind native_handle_borrow_kind owner_is_null_kind native_handle_consume_kind (value native_handle_slot_borrow_kind) (value checked_foreign_handle_kind)
			native_storage_init_borrow_kind native_storage_mut_borrow_kind native_handle_init_borrow_kind
			is_optional_owner optional_owner_type optional_owner_payload optional_unwrap_kind (value worker_receipt_move_kind) (value worker_permit_move_kind)))
	(use wove-file "./native_owner_types.wove" (only is_native_owner native_owner_type native_owner_declaration))
	(use wove-file "./fields.wove" (only read_field_projection plan_field_read check_owned_record_path))
	(use wove-file "./loans.wove" (only (value inline_owner_argument_guard) is_c_inline_projection has_conflicting_loan has_scoped_array_loan indexed_owner_base expression_row borrowed_call_row
		runtime_expression writable_place check_writable_field mutable_parameter_place call_loan_keyword inferred_array_loan
		store_place_loan plan_owned_field_loan plan_scoped_field_loan read_borrow_source finish_indexed_array_loan
		is_local_slice_view (value scoped_array_initializer) (value infer_shared_array) (value infer_mut_array) (value indirect_local_place) (value local_slice_view)
		(value local_slice_projection) (value scoped_field_loan) (value indexed_record_loan) (type ScalarExpression)))
	(use wove-file "./constants.wove" (only constant_operation register_standalone_constants fold_i32 constant_check))
	(use wove-file "./fixed.wove" (only plan_fixed_slice_loan plan_fixed_initializer seed_fixed_initializer finish_heap_fixed_access finish_owned_fixed_access finish_fixed_access))
	(use wove-file "./flow.wove" (only block_statement pending_statement statement_exit_state moved_owner after_block is_loop is_loop_exit is_c_value_binding is_iteration_binding is_writable_local (type ScalarStatement)
			(value c_writable_binding) (value c_value_expression) (value c_vector_snapshot_expression) (value c_value_assignment) (value c_handle_reference)
			(value fixed_shared_loan) (value fixed_mut_loan) (value field_assignment) (value parameter_assignment) (value owner_assignment) (value owner_field_assignment) (value case_payload_binding)
			(value next_path) (value break_path) (value continue_path) (value break_statement) (value for_statement) (value for_source_owner) (value for_mut_binding) (value for_element_assignment)))
	(use wove-file "./conditional.wove" (only plan_conditional finish_conditional_value conditional_transfer_reaches is_pending_value
		(value conditional_value) (value pending_conditional) (value pending_field_read) (value pending_array_read)))
	(use wove-file "./control.wove" (only plan_control_blocks enclosing_loop sequence_paths predicate_literal control_paths prior_owner_take has_path repeats_loop consumption_on_back_edge))
	(use wove-file "../source/array_growth.wove" (only is_array_growth is_array_growth_statement (value indexed_row_owner)
		(value array_capacity_kind) (value array_push_kind) (value array_remove_kind) (value array_try_reserve_kind) (value array_try_alloc_kind) (value array_try_extend_kind) (value array_try_push_kind)))
	(use wove-file "../source/integer_bits.wove" (only word_count_type word_rotates))
	(use wove-file "./worker.wove" (only worker_signature worker_receipt_result worker_result_type worker_queue_loan))
	(use wove-file "./syntax.wove"
		(only entry_keyword place_keyword (value binding_reference) entry_at entry_form (value array_try_copy_kind) (value fn_ref_kind) (value indirect_call_kind) is_direct_call is_worker_launch is_worker_submission is_worker_pool_operation (value worker_spawn_join_kind)
			(value worker_spawn_on_kind) (value worker_try_spawn_kind) (value worker_open_pool_kind) (value worker_try_close_kind) (value worker_join_kind) (value worker_queue_kind) (value worker_push_kind) (value worker_pop_front_kind) is_worker_queue_access is_worker_collect read_statement scalar_type scalar_operator is_fixed_initializer (value fixed_owner_take) (value fixed_owner_transfer) (value fixed_list_kind) (value pending_exact_move) (value fixed_take_request)
			is_byte_view_type is_reborrow_keyword is_scalar_name same_name native_alloc_kind is_native_owner_constructor
			(value native_tail_report_kind) (value native_tail_load_kind) (value native_tail_report_borrow_kind)
			(value native_cstrs_view_kind) (value native_cstrs_len_kind) (value native_cstrs_load_kind) (value native_cstrs_type)
			(type ScalarOperator) (type FixedArrayShape) (type EntryRead) (type StatementRead)))

	(struct
		(:doc `A direct call links the two defining files and declaration rows.

		The span is half-open in the caller's original file. The file values
		come from the compilation's file table or the single-file caller.`)
		CallSite
		(fields (caller_file i32) (caller i32) (callee_file i32) (callee i32) (start i32) (end i32)))

	(struct FunctionScope
		(fields (file i32) (tree_base i32) (tree_limit i32) (source_base i32) (module_id u32) (entry_module bool) (mode u32)))
	(struct BodyPlan
		(fields (count i32) (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(let owned_parameter_binding 571u32)
	(let pending_row_move 106u32)
	(let pending_member_move 248u32)

	(fn owned_result_type
		(:doc "Resolve an owned parameter or result in the function's type namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope FunctionScope))
		(returns u32)
		(body
			(return (call read_owned_array_type (borrow-shared source) (borrow-shared nodes) node
				(borrow-shared records) (borrow-shared bindings)
				(call scope_at (struct.get scope file) (struct.get scope source_base))))))

	(fn read_signature
		(:doc `Resolve a named function's result before completing its signature and body shape.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (first_field i32)
			(entry bool) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope FunctionScope))
		(returns ScalarSignature)
		(body
			(let head (call read_signature_head (borrow-shared source) (borrow-shared nodes)
				node first_field (bool false) (bool true)))
			(let-mut result 0u32)
			(if
				(:doc "Only a checked head contains a result type operand to resolve.")
				(u32.eqz (struct.get head error))
				(then
					(let type_node (struct.get head type_node))
					(set result (call entry_keyword (borrow-shared source) (borrow-shared nodes)
						type_node))
					(if
						(:doc "Resolve a void result, scalar, or named value layout.")
						(u32.not-eq result (call void_type))
						(then (set result (call value_type (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (borrow-shared bindings)
							(struct.get scope file) (struct.get scope source_base) type_node))))
					(if
						(:doc "An owned descriptor identifies the result by its element type.")
						(u32.eqz result)
						(then (set result (call owned_result_type (borrow-shared source) (borrow-shared nodes)
							(array.load nodes type_node) (borrow-shared records)
							(borrow-shared bindings) scope))))
					(if
						(:doc "An optional result keeps the exact ownership type of its payload.")
						(u32.eqz result)
						(then (set result (call read_optional_result (borrow-shared source) (borrow-shared nodes)
							(array.load nodes type_node) (borrow-shared records) (borrow-shared bindings)
							(call scope_at (struct.get scope file) (struct.get scope source_base))))))
					(if
						(:doc "An ordinary result can own the exact pointer handle selected in this module.")
						(u32.eqz result)
						(then
							(let owner (call pointer_owner_definition (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings) (struct.get scope file)
								(struct.get scope source_base) (array.load nodes type_node)))
							(if
								(:doc "Encode the defining handle independently of local aliases.")
								(i32.not-ltz owner)
								(then (set result (call native_owner_type owner))))))
					(let borrowed (i32.not-ltz (struct.get head from)))
					(if
						(:doc "An explicit provenance clause can resolve a Wove array view result.")
						(bool.and borrowed (u32.eqz result))
						(then (set result (call borrowed_result_view (borrow-shared source)
							(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
							(struct.get scope file) (struct.get scope source_base) type_node))))
					(if
						(:doc "A scoped record requires an explicit source parameter before it can leave the function.")
						(bool.and (bool.not borrowed)
							(call is_scoped_record (borrow-shared records) result))
						(then (set result 0u32)))
					(if
						(:doc "A source contract applies to a view or a scoped record without owned storage.")
						(bool.and borrowed
							(bool.not (bool.or (call is_readable_slice result)
								(bool.and (call is_scoped_record (borrow-shared records) result)
									(bool.not (call is_owning_record (borrow-shared records) result))))))
						(then (set result 0u32)))
					(if
						(:doc "The C entry requires i32 in every compilation mode.")
						(bool.and entry (u32.not-eq result 5u32))
						(then (set result 0u32)))))
			(return (call complete_signature (borrow-shared source) (borrow-shared nodes)
				node head result))))

	(fn storage_argument_mode
		(:doc `Classify a validated native storage formal by its written access mode.`)
		(params (reference u32))
		(returns u8)
		(body
			(if
				(:doc "A shared formal lends the initialized object's read-only address.")
				(u32.eq reference 1u32)
				(then (return (call c_storage_shared_mode))))
			(if
				(:doc "An ordinary mutable storage formal requires an active object.")
				(u32.eq reference 2u32)
				(then (return (call c_storage_mut_mode))))
			(return (call c_storage_consume_mode))))

	(fn read_parameters
		(:doc `Check each parameter's unique spelling, metadata, and exact type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(parameters (mut-array ScalarParameter)) (start i32) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope FunctionScope) (bridge i32) (context SelectionContext))
		(returns EntryRead)
		(body
			(let native (i32.lt -1i32 bridge))
			(let-mut index first)
			(if
				(:doc "A checked native signature omits fixed C operands from its Wove parameter table.")
				native
				(then (set index (call next_c_value_formal (borrow-shared source) (borrow-shared nodes) index))))
			(let-mut written start)
			(while
				(:doc "Keep formal parameter order and use one row for each checked parameter.")
				(i32.not-ltz index)
				(body
					(let node (array.load nodes index))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
					(let name (struct.get parts head))
					(let operand (struct.get parts operands))
					(if
						(:doc "A named parameter is a form with exactly one ordinary type operand.")
						(bool.or (bool.or (i32.ltz name) (i32.ltz operand))
							(i32.not-ltz (struct.get (array.load nodes operand) next_sibling)))
						(then (return (call entry_at node -1i32 23u32))))
					(let spelling (array.load nodes name))
					(if
						(:doc "Parameter names use the ordinary ASCII identifier grammar.")
						(bool.not (call is_scalar_name (borrow-shared source) spelling))
						(then (return (call entry_at spelling -1i32 23u32))))
					(let selection (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
						node parts))
					(if
						(:doc "Known selection directives belong at declaration scope.")
						(u32.gtz (struct.get selection error))
						(then (return (struct.new EntryRead (operand -1i32)
							(start (struct.get selection start)) (end (struct.get selection end))
							(error (struct.get selection error)) (related -1i32)))))
					(let checked (call read_parameter_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings)
						(struct.get scope file) (struct.get scope source_base) operand (i32.ltz bridge)))
					(let type_node (array.load nodes operand))
					(let-mut declared_type 0u32)
					(if
						(:doc "The adapted signature is a direct native-only argument and has no Wove function value.")
						(bool.and native (u32.gtz (struct.get checked error)))
						(then
							(let callback (call read_callback_shape (borrow-shared source) (borrow-shared nodes) type_node))
							(if
								(:doc "Report the malformed native operand at its declaration.")
								(u32.gtz (struct.get callback error))
								(then (return (struct.new EntryRead (operand -1i32) (start (struct.get callback start))
									(end (struct.get callback end)) (error (struct.get callback error)) (related -1i32)))))
							(if
								(:doc "The source bridge already requires the synchronous lifetime contract.")
								(i32.gtz (struct.get callback arity))
								(then (set declared_type (call void_type))))))
					(if
						(:doc "Keep an incoming record loan in the full-width parameter type field.")
						(bool.not native)
						(then
							(let record (call read_optional_native_parameter (borrow-shared source)
								(borrow-shared nodes) type_node (borrow-shared records)
								(borrow-shared bindings) (struct.get scope file) (struct.get scope source_base)))
							(if (u32.gtz (struct.get record error)) (then (return record)))
							(if
								(:doc "Only a checked native record receives the nullable reference code.")
								(i32.not-ltz (struct.get record operand))
								(then (set declared_type (call optional_record_borrow_type
									(u32.from-i32 (struct.get record operand))))))))
					(if
						(:doc "Wove formals can take the same exact owned array types as Wove results.")
						(bool.and (bool.not native) (bool.and (u32.eqz declared_type)
							(u32.gtz (struct.get checked error))))
						(then (set declared_type (call owned_result_type (borrow-shared source) (borrow-shared nodes)
							type_node (borrow-shared records) (borrow-shared bindings) scope))))
					(if
						(:doc "An owning Wove struct or fixed array transfers through its exact checked layout.")
						(bool.and (bool.not native)
							(bool.and (u32.eqz declared_type) (u32.gtz (struct.get checked error))))
						(then
							(let aggregate (call value_type (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings)
								(struct.get scope file) (struct.get scope source_base) operand))
							(if
								(:doc "Use the same ownership classification for the signature, call, and callee cleanup.")
								(call is_owned_parameter (borrow-shared records) aggregate)
								(then (set declared_type aggregate)))))
					(let view (call read_c_view_type (borrow-shared source) (borrow-shared nodes) type_node (bool false)))
					(let view_element (struct.get view element))
					(let native_view (bool.and (i32.lt -1i32 bridge)
						(bool.and (i32.lt -1i32 view_element)
							(bool.and (u32.eqz (call scalar_type (borrow-shared source) (borrow-shared nodes) view_element))
								(u32.eqz (call c_row_slice_type (borrow-shared source) (borrow-shared nodes) type_node))))))
					(let native_alias (bool.and (i32.lt -1i32 bridge)
						(bool.and (u32.eq (struct.get type_node kind) 1u32)
							(u32.eqz (call scalar_type (borrow-shared source) (borrow-shared nodes) operand)))))
					(let-mut type declared_type)
					(let-mut mode (call c_value_mode))
					(if
						(:doc "Native aliases in scalar and slice positions resolve in the defining bridge.")
						(bool.and (bool.or (u32.gtz declared_type) (u32.eqz (struct.get checked error)))
							(bool.not (bool.or native_alias native_view)))
						(then
							(if
								(:doc "Only ordinary parameters take their type from the view or scalar reader.")
								(u32.eqz declared_type)
								(then (set type (u32.from-i32 (struct.get checked operand))))))
						(else
							(if
								(:doc "Only native signatures can access unimported types in the defining bridge.")
								(i32.ltz bridge)
								(then (return checked)))
							(let type_form (call form_parts (borrow-shared source) (borrow-shared nodes) type_node))
							(let reference (call reference_mode (borrow-shared source) (borrow-shared nodes) (struct.get type_form head)))
							(if
								(:doc "Keep ordinary parameter diagnostics unless the form names a native value, view, or reference.")
								(bool.not (bool.or native_view (bool.or (u32.eq (struct.get type_node kind) 1u32)
									(u32.gtz reference))))
								(then (return checked)))
							(let handle (call read_c_native_parameter (borrow-shared source) (borrow-shared nodes)
								type_node bridge context))
							(if
								(:doc "A rejected native type keeps the original signature span.")
								(u32.gtz (struct.get handle error))
								(then (return (struct.new EntryRead (operand -1i32)
									(start (struct.get handle start)) (end (struct.get handle end))
									(error (struct.get handle error)) (related -1i32)))))
							(let declaration (struct.get handle declaration))
							(let-mut target 0u32)
							(if
								(:doc "A built-in scalar reference needs no defining type row.")
								(i32.ltz declaration)
								(then (set target (call scalar_type (borrow-shared source)
									(borrow-shared nodes) (struct.get type_form operands))))
								(else
