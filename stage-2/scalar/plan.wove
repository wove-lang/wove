					(return (call entry_at node index 0u32))))
			(let-mut kind (call native_handle_borrow_kind))
			(if
				(:doc "A qualified slot loan captures the pointer's original address.")
				(u8.eq mode c_shared_handle_slot_mode)
				(then (set kind native_handle_slot_borrow_kind)))
			(if
				(:doc "An exclusive native loan records whether it needs an active or inactive owner.")
				exclusive
				(then
					(set kind (call native_storage_mut_borrow_kind))
					(if
						(:doc "Only an initializing borrow can use an inactive allocation.")
						(call is_c_storage_init_mode mode)
						(then (set kind (call native_storage_init_borrow_kind))))
					(if
						(:doc "An opaque pointer output lends the empty owner slot itself.")
						(call is_c_handle_init_mode mode)
						(then (set kind (call native_handle_init_borrow_kind))))))
			(array.store expressions index
