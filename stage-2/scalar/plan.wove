				node keyword))
			(if (u32.gtz (struct.get loan error)) (then (return loan)))
			(let reference_index (struct.get loan operand))
			(let reference (array.load nodes reference_index))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) reference))
			(let tag (call entry_keyword (borrow-shared source) (borrow-shared nodes) (struct.get parts head)))
			(if
				(:doc "An optional descriptor must be checked before its shared contents can be borrowed.")
				(u32.eq tag (call optional_unwrap_kind))
				(then (return (call plan_view_option (borrow-shared source) (borrow-shared nodes)
					reference index expected tag caller statement view_start
					(borrow-shared parameters) (borrow-shared statements) (borrow-mut expressions)))))
			(if
				(:doc "A resource formal can lend a projected owner slot or a named handle.")
				(call is_native_owner expected)
				(then
					(if
						(:doc "A loan of an owning field checks the complete original place.")
						(u32.eq tag 52u32)
						(then (return (call plan_projected_handle_loan (borrow-shared source) (borrow-shared nodes)
							node index reference_index caller statement expected mode view_start
							(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings)
							(borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))
					(return (call plan_handle_borrow (borrow-shared source) (borrow-shared nodes)
						node index reference_index caller statement expected mode view_start
						(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))
			(if
				(:doc "A projected loan retains its checked field path.")
				(u32.eq tag 52u32)
				(then (return (call plan_projected_loan (borrow-shared source) (borrow-shared nodes)
					node index reference_index caller statement expected view_start
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings)
					(borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))
			(if
				(:doc "An indexed loan borrows its exact row or record slot without copying the owner.")
				(bool.and (u32.eq tag 37u32)
					(call is_reborrow_keyword keyword))
				(then (return (call plan_indexed_array_loan (borrow-shared source) (borrow-shared nodes)
					node index reference_index caller statement expected view_start
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared bindings)
					(borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))
			(if
				(:doc "A place loan preserves the address of its original storage.")
				(call is_place_reference expected)
				(then (return (call plan_place_borrow (borrow-shared source) (borrow-shared nodes)
					node index reference_index caller statement expected
					(borrow-shared records) (borrow-shared parameters) (borrow-shared statements) (borrow-mut expressions)))))
			(if
				(:doc "Check both endpoints before handing the typed subrange to the callee.")
				(bool.and (bool.or (call is_reborrow_keyword expected) (call is_typed_slice expected))
					(u32.eq tag 44u32))
				(then (return (call plan_range_borrow (borrow-shared source) (borrow-shared nodes)
					node index reference_index caller statement expected view_start
					(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))
			(return (call plan_named_view (borrow-shared source) (borrow-shared nodes)
				node reference index caller statement expected (bool false)
				(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))

	(fn plan_scoped_array_loan
		(:doc `Check an immutable binding's explicit whole-array or numeric range loan.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (caller ScalarFunction) (statement i32) (view_start i32)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let keyword (call entry_keyword (borrow-shared source) (borrow-shared nodes) (struct.get parts head)))
