(module scalar_plan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve selected scalar functions and calls before C emission.

	Collect signatures first, then check each body in source order against
	the function signatures and bindings visible at each statement. Track
	whether statements can reach their next sibling across scoped control flow.
	Function rows retain their original declaration and name nodes. Checked
	call rows keep the callee row independently of
	the name that will be used in C, and are indexed by original call node.
	Retain source-level call sites before either inspection or lowering.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/c_headers.wove" (only is_shared_ref_head read_c_handle_parameter))
	(use wove-file "../emit/names.wove" (only module_identity function_identity))
	(use wove-file "../c/arguments.wove" (only c_value_mode))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "./records.wove"
		(only declaration_kind register_module_records copyable_type read_parameter_type find_record record_type record_index is_record_type
			find_member read_member_operand is_record_slice record_slice_type record_slice_element is_readable_slice is_writable_slice
			is_array_owner array_owner_type array_owner_element (type ScalarRecord)))
	(use wove-file "./host_entry.wove" (only is_arg_span_slice))
	(use wove-file "./owners.wove" (only is_local_owner is_native_owner native_owner_type native_handle_borrow_kind))
	(use wove-file "./flow.wove" (only block_statement moved_owner after_block (type ScalarStatement)))
	(use wove-file "./syntax.wove"
		(only entry_keyword entry_at entry_form read_statement scalar_type decimal_scalar scalar_operator
			is_byte_view_type is_reborrow_keyword is_scalar_name same_name (type ScalarOperator) (type EntryRead) (type StatementRead)))

	(struct
		(:doc `A checked signature and its defining source identity.

		A negative body denotes a foreign declaration whose native name
		and declaration still refer to the source tree. A Wove body can be empty.`)
		ScalarFunction
		(fields (declaration i32) (name i32) (params i32) (arity i32) (result u32)
			(first_statement i32) (identity u32) (entry bool) (c_strings i32) (c_bytes i32)
			(file i32) (tree_base i32) (tree_limit i32) (source_base i32) (body i32)))
	(struct ScalarParameter
		(fields (name i32) (type u32) (position i32) (c_mode u8) (c_size i32) (c_count i32)))
	(struct
		(:doc `A checked expression at its source row.

		Literals carry significant digit offsets in the arena. Conversions
		and checked runtime operations carry the original file identity
		in target and the half-open byte span in start and end. First
		points at the initial operand to evaluate. A reborrow's target
		is its defining parameter row or, for an owner, its name row.
		A range reborrow links to the checked projection in its child.`)
		ScalarExpression
		(fields (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool) (borrowed_owner bool)))
	(struct ScalarSignature (fields (params i32) (result u32) (first_statement i32) (start i32) (end i32) (error u32) (body i32)))

	(struct
		(:doc `A direct call links the two defining files and declaration rows.

		The span is half-open in the caller's original file. The file values
		come from the compilation's file table or the single-file caller.`)
		CallSite
		(fields (caller_file i32) (caller i32) (callee_file i32) (callee i32) (start i32) (end i32)))

	(struct FunctionScope
		(fields (file i32) (tree_base i32) (tree_limit i32) (source_base i32) (module_id u32) (entry_module bool) (bootstrap bool)))
	(struct BodyPlan
		(fields (count i32) (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(fn signature_error
		(:doc `Carry an original source diagnostic through the signature reader.`)
		(params (error EntryRead))
		(returns ScalarSignature)
		(body
			(return (record.make ScalarSignature (params (i32 -1)) (result (u32 0)) (first_statement (i32 -1)) (body (i32 -1))
				(start (record.get (local error) start)) (end (record.get (local error) end))
				(error (record.get (local error) error))))))

	(fn read_signature
		(:doc `Check the signature and body shape of one named function.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode)
			(params i32) (entry bool) (records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)) (scope FunctionScope))
		(returns ScalarSignature)
		(body
			(if
				(:doc "The first form after the name declares the parameter list.")
				(i32.lt (local params) (i32 0))
				(then (return (call signature_error (call entry_at (local node) (i32 -1) (u32 23))))))
			(let params_node (slice.load (local nodes) (local params)))
			(let parameters (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local params_node) (u32 3) (u32 23)))
			(if
				(:doc "Preserve the original params diagnostic.")
				(u32.lt (u32 0) (record.get (local parameters) error))
				(then (return (call signature_error (local parameters)))))
			(let first (record.get (local parameters) operand))
			(if
				(:doc "A bootstrap C entry takes no Wove parameters.")
				(bool.and (bool.and (local entry) (record.get (local scope) bootstrap))
					(bool.not (i32.lt (local first) (i32 0))))
				(then (return (call signature_error (call entry_at (local params_node) (i32 -1) (u32 23))))))
			(let result_node (record.get (local params_node) next_sibling))
			(if
				(:doc "Every function declares its exact result type.")
				(i32.lt (local result_node) (i32 0))
				(then (return (call signature_error (call entry_at (local node) (i32 -1) (u32 23))))))
			(let returns (slice.load (local nodes) (local result_node)))
			(let signature (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local returns) (u32 4) (u32 23)))
			(if
				(:doc "Keep the return form's diagnostic before inspecting its operands.")
				(u32.lt (u32 0) (record.get (local signature) error))
				(then (return (call signature_error (local signature)))))
			(let type_node (record.get (local signature) operand))
			(if
				(:doc "The returns form takes exactly one type.")
				(bool.or (i32.lt (local type_node) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local type_node)) next_sibling) (i32 0))))
				(then (return (call signature_error (call entry_at (local returns) (i32 -1) (u32 23))))))
			(let void (call void_type))
			(let-mut result (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
			(if
				(:doc "Other results must have a copyable value type.")
				(bool.not (u32.eq (local result) (local void)))
				(then (set (local result) (call copyable_type (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings))
					(record.get (local scope) file) (record.get (local scope) source_base) (local type_node)))))
			(if
				(:doc "Helpers can return a copyable value or void. Main returns i32.")
				(bool.or (u32.eq (local result) (u32 0))
					(bool.and (local entry) (bool.not (u32.eq (local result) (u32 5)))))
				(then (return (call signature_error
					(call entry_at (slice.load (local nodes) (local type_node)) (i32 -1) (u32 23))))))
			(let body (record.get (local returns) next_sibling))
			(if
				(:doc "One body follows the signature.")
				(i32.lt (local body) (i32 0))
				(then (return (call signature_error (call entry_at (local node) (i32 -1) (u32 24))))))
			(let body_node (slice.load (local nodes) (local body)))
			(let extra (record.get (local body_node) next_sibling))
			(if
				(:doc "Keep the first extra operand's span.")
				(bool.not (i32.lt (local extra) (i32 0)))
				(then (return (call signature_error
					(call entry_at (slice.load (local nodes) (local extra)) (i32 -1) (u32 24))))))
			(let statements (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local body_node) (u32 6) (u32 24)))
			(if
				(:doc "Forward an unsupported body form unchanged.")
				(u32.lt (u32 0) (record.get (local statements) error))
				(then (return (call signature_error (local statements)))))
			(let first_statement (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local statements) operand)))
			(if
				(:doc "An empty body can only complete a void helper.")
				(bool.and (i32.lt (local first_statement) (i32 0)) (bool.not (u32.eq (local result) (local void))))
				(then (return (call signature_error (call entry_at (local body_node) (i32 -1) (u32 24))))))
			(return (record.make ScalarSignature (params (local first)) (result (local result))
				(first_statement (local first_statement)) (body (local body))
				(start (record.get (local node) start)) (end (record.get (local node) end)) (error (u32 0))))))

	(fn find_parameter
		(:doc `Look up a parameter within the owning function's contiguous parameter interval.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (name SourceNode)
			(parameters (shared-slice ScalarParameter)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "Only parameters of this function participate in its local namespace.")
				(i32.lt (local cursor) (local end))
				(body
					(let item (slice.load (local parameters) (local cursor)))
					(let node (slice.load (local nodes) (record.get (local item) name)))
					(if
						(:doc "Match the raw spelling before any C suffix transformation.")
						(call same_name (borrow-shared (local source)) (local node) (local name))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (i32 -1))))

	(fn read_parameters
		(:doc `Check each parameter's unique spelling, metadata, and exact type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(parameters (mut-slice ScalarParameter)) (start i32) (records (shared-slice ScalarRecord))
			(bindings (shared-slice GraphBinding)) (scope FunctionScope) (bridge i32))
		(returns EntryRead)
		(body
			(let-mut index (local first))
			(let-mut written (local start))
			(while
				(:doc "Keep formal parameter order and use one row for each checked parameter.")
				(bool.not (i32.lt (local index) (i32 0)))
				(body
					(let node (slice.load (local nodes) (local index)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let name (record.get (local parts) head))
					(let operand (record.get (local parts) operands))
					(if
						(:doc "A named parameter is a form with exactly one ordinary type operand.")
						(bool.or (bool.or (i32.lt (local name) (i32 0)) (i32.lt (local operand) (i32 0)))
							(bool.not (i32.lt (record.get (slice.load (local nodes) (local operand)) next_sibling) (i32 0))))
						(then (return (call entry_at (local node) (i32 -1) (u32 23)))))
					(let selection (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local node) (local parts)))
					(if
						(:doc "Known selection directives belong at declaration scope.")
						(u32.lt (u32 0) (record.get (local selection) error))
						(then (return (record.make EntryRead (operand (i32 -1))
							(start (record.get (local selection) start)) (end (record.get (local selection) end))
							(error (record.get (local selection) error)) (related (i32 -1))))))
					(let checked (call read_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings))
						(record.get (local scope) file) (record.get (local scope) source_base) (local operand)))
					(let-mut type (u32 0))
					(if
						(:doc "Ordinary parameters use the exact scalar, record, or slice type.")
						(u32.eq (u32 0) (record.get (local checked) error))
						(then (set (local type) (int.convert u32 (record.get (local checked) operand))))
						(else
							(if
								(:doc "Only native signatures can declare borrowed pointer resources.")
								(i32.lt (local bridge) (i32 0))
								(then (return (local checked))))
							(let type_node (slice.load (local nodes) (local operand)))
							(let type_form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
							(if
								(:doc "Keep the ordinary type reader's original diagnostic outside shared-ref forms.")
								(bool.not (call is_shared_ref_head (borrow-shared (local source)) (borrow-shared (local nodes))
									(record.get (local type_form) head)))
								(then (return (local checked))))
							(let handle (call read_c_handle_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
								(local type_node) (local bridge) (record.get (local scope) bootstrap)))
							(if
								(:doc "A rejected handle type keeps the declaring span.")
								(u32.lt (u32 0) (record.get (local handle) error))
								(then (return (record.make EntryRead (operand (i32 -1))
									(start (record.get (local handle) start)) (end (record.get (local handle) end))
									(error (record.get (local handle) error)) (related (i32 -1))))))
							(set (local type) (call native_owner_type (record.get (local handle) declaration)))))
					(let name_node (slice.load (local nodes) (local name)))
					(let existing (call find_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
						(local name_node) (borrow-shared (local parameters)) (local start) (local written)))
					(if
						(:doc "The second occurrence of a name conflicts with its earlier parameter.")
						(bool.not (i32.lt (local existing) (i32 0)))
						(then (return (call entry_at (local name_node) (i32 -1) (u32 33)))))
					(slice.store (local parameters) (local written)
						(record.make ScalarParameter (name (local name)) (type (local type))
							(position (i32.sub.wrapping (local written) (local start))) (c_mode (call c_value_mode)) (c_size (i32 -1)) (c_count (i32 -1))))
					(set (local written) (i32.add.wrapping (local written) (i32 1)))
					(set (local index) (record.get (local node) next_sibling))))
			(return (record.make EntryRead (operand (local written)) (start (i32 0)) (end (i32 0)) (error (u32 0)) (related (i32 -1))))))

	(fn find_function
		(:doc `Look up a checked function by a byte span from either the source or an inspection query.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (functions (shared-slice ScalarFunction))
			(spelling (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(while
				(:doc "The selected namespace is the populated function prefix.")
				(i32.lt (local cursor) (slice.len (local functions)))
				(body
					(let target (slice.load (local functions) (local cursor)))
					(let declared (slice.load (local nodes) (record.get (local target) name)))
					(if
						(:doc "C suffix sanitization has no role in source name resolution.")
						(call same_bytes (borrow-shared (local source)) (record.get (local declared) start)
							(record.get (local declared) end) (borrow-shared (local spelling)) (local start) (local end))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (i32 -1))))

	(fn register_function
		(:doc `Register one defining function and its parameters in the checked program tables.

		Names and source spans address the supplied source view. Across files,
		the canonical file and tree base recover the original declaration row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32) (scope FunctionScope)
			(functions (mut-slice ScalarFunction)) (index i32) (parameters (mut-slice ScalarParameter)) (next_param i32)
			(records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local declaration)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let name (record.get (local parts) name))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
			(if
				(:doc "This translation unit accepts local functions as its selected declarations.")
				(bool.or (bool.not (u32.eq (local tag) (u32 1))) (i32.lt (local name) (i32 0)))
				(then (return (call entry_at (local node) (i32 -1) (u32 22)))))
			(let spelling (slice.load (local nodes) (local name)))
			(if
				(:doc "Function names use the checked Wove identifier alphabet.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local spelling)))
				(then (return (call entry_at (local spelling) (i32 -1) (u32 22)))))
			(let identity (call function_identity (borrow-shared (local source))
				(record.get (local spelling) start) (record.get (local spelling) end) (record.get (local scope) module_id)))
			(let-mut previous (i32 0))
			(while
				(:doc "Reject a stable hash collision even if readable suffixes differ.")
				(i32.lt (local previous) (local index))
				(body
					(let earlier (slice.load (local functions) (local previous)))
					(if
						(:doc "Equal IDs can come from a duplicate spelling or a collision between distinct names.")
						(u32.eq (local identity) (record.get (local earlier) identity))
						(then
							(let prior (slice.load (local nodes) (record.get (local earlier) name)))
							(if
								(:doc "A repeated name is a source-level binding conflict.")
								(bool.and (i32.eq (record.get (local scope) file) (record.get (local earlier) file))
								(call same_name (borrow-shared (local source)) (local spelling) (local prior)))
								(then (return (call entry_at (local spelling) (i32 -1) (u32 33)))))
							(return (call entry_at (local spelling) (i32 -1) (u32 32)))))
					(set (local previous) (i32.add.wrapping (local previous) (i32 1)))))
			(let entry (bool.and (record.get (local scope) entry_module)
				(u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local name)) (u32 2))))
			(let signature (call read_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (record.get (local parts) operands) (local entry)
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope)))
			(if
				(:doc "A malformed signature keeps its originating span.")
				(u32.lt (u32 0) (record.get (local signature) error))
				(then (return (record.make EntryRead (operand (i32 -1))
					(start (record.get (local signature) start)) (end (record.get (local signature) end))
					(error (record.get (local signature) error)) (related (i32 -1))))))
			(let checked (call read_parameters (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local signature) params) (borrow-mut (local parameters)) (local next_param)
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (i32 -1)))
			(if
				(:doc "Pass through the parameter list's first failure.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (local checked))))
			(let limit (record.get (local checked) operand))
			(let arity (i32.sub.wrapping (local limit) (local next_param)))
			(if
				(:doc "A native entry with parameters receives a shared byte arena and a shared span table.")
				(bool.and (bool.and (local entry) (i32.lt (i32 0) (local arity)))
					(bool.or (bool.not (i32.eq (local arity) (i32 2)))
						(bool.or (bool.not (u32.eq (record.get (slice.load (local parameters) (local next_param)) type) (u32 34)))
							(bool.not (call is_arg_span_slice (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records))
								(record.get (slice.load (local parameters) (i32.add.wrapping (local next_param) (i32 1))) type))))))
				(then (return (call entry_at (slice.load (local nodes) (record.get (local parts) operands)) (i32 -1) (u32 23)))))
			(slice.store (local functions) (local index)
				(record.make ScalarFunction (declaration (local declaration)) (name (local name))
					(params (local next_param)) (arity (local arity))
					(result (record.get (local signature) result)) (first_statement (record.get (local signature) first_statement))
					(body (record.get (local signature) body))
					(identity (local identity)) (entry (local entry)) (c_strings (i32 0)) (c_bytes (i32 0))
					(file (record.get (local scope) file)) (tree_base (record.get (local scope) tree_base))
					(tree_limit (record.get (local scope) tree_limit)) (source_base (record.get (local scope) source_base))))
			(return (call entry_at (local node) (local limit) (u32 0)))))

	(fn read_module_declarations
		(:doc `Register selected functions and record layouts in their separate namespaces.

		Classify main as the ABI entry in an executable root. Library functions
		follow ordinary scalar signature and call rules, including main.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (module ModuleRead)
			(declarations (shared-slice SelectedDeclaration)) (functions (mut-slice ScalarFunction))
			(parameters (mut-slice ScalarParameter)) (records (mut-slice ScalarRecord))
			(bindings (shared-slice GraphBinding)) (file i32) (entry_module bool))
		(returns EntryRead)
		(body
			(let module_name (slice.load (local nodes) (record.get (local module) name)))
			(let module_id (call module_identity (borrow-shared (local source))
				(record.get (local module_name) start) (record.get (local module_name) end)))
			(let scope (record.make FunctionScope (file (local file)) (tree_base (i32 0))
				(tree_limit (slice.len (local nodes))) (source_base (i32 0)) (module_id (local module_id))
				(entry_module (local entry_module)) (bootstrap (record.get (local module) bootstrap))))
			(let types (call register_module_records (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (record.get (local module) count) (i32 0)
				(local file) (local module_id) (borrow-mut (local records)) (i32 0)))
			(if
				(:doc "Register the full type namespace before reading forward signature references.")
				(u32.lt (u32 0) (record.get (local types) error))
				(then (return (local types))))
			(let-mut index (i32 0))
			(let-mut next_function (i32 0))
			(let-mut next_param (i32 0))
			(let-mut main (i32 -1))
			(while
				(:doc "Read every selected definition before resolving bodies and forward references.")
				(i32.lt (local index) (record.get (local module) count))
				(body
					(let declaration (record.get (slice.load (local declarations) (local index)) node))
					(if
						(:doc "Only functions need signatures after the types have been registered.")
						(bool.not (u32.eq (call declaration_kind (borrow-shared (local source))
							(borrow-shared (local nodes)) (local declaration)) (u32 48)))
						(then
							(let registered (call register_function (borrow-shared (local source)) (borrow-shared (local nodes))
								(local declaration) (local scope) (borrow-mut (local functions)) (local next_function)
								(borrow-mut (local parameters)) (local next_param) (borrow-shared (local records))
								(borrow-shared (local bindings))))
							(if
								(:doc "Keep the rejected signature or declaration's original span.")
								(u32.lt (u32 0) (record.get (local registered) error))
								(then (return (local registered))))
							(let function (slice.load (local functions) (local next_function)))
							(if
								(:doc "Remember the selected C entry independently of declaration order.")
								(record.get (local function) entry)
								(then (set (local main) (local declaration))))
							(set (local next_param) (record.get (local registered) operand))
							(set (local next_function) (i32.add.wrapping (local next_function) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(if
				(:doc "The executable root must define the ABI entry even if it only declares types.")
				(bool.and (local entry_module) (i32.lt (local main) (i32 0)))
				(then
					(if
						(:doc "A type-only module has no first function to identify.")
						(i32.eq (local next_function) (i32 0))
						(then (return (call entry_at (local module_name) (i32 -1) (u32 22)))))
					(return (call entry_at
						(slice.load (local nodes) (record.get (slice.load (local functions) (i32 0)) name)) (i32 -1) (u32 22)))))
			(return (record.make EntryRead (operand (local main)) (start (i32 0)) (end (i32 0)) (error (u32 0)) (related (i32 -1))))))

	(fn value_matches_type
		(:doc `Match a checked value to its exact expected type.

		Expectation 1 infers an integer. A local initializer (42) can
		also copy a record, allocate, or move an owner. A field receiver
		(53) can be any registered record. A length or load receiver (55)
		can use any readable slice. A store receiver (56) must be writable.
		An owner operand (57) can supply a transfer or a handle borrow. Zero marks unvisited rows.`)
		(params (expected u32) (actual u32))
		(returns bool)
		(body
			(if
				(:doc "A field receiver must be a registered named record.")
				(u32.eq (local expected) (u32 53))
				(then (return (call is_record_type (local actual)))))
			(if
				(:doc "A local initializer can also keep a bool, record value, or native owner.")
				(bool.and (u32.eq (local expected) (u32 42))
					(bool.or (u32.eq (local actual) (u32 12))
						(bool.or (call is_record_type (local actual)) (call is_native_owner (local actual)))))
				(then (return (bool true))))
			(if
				(:doc "An integer initializer or conversion operand can infer its width.")
				(bool.or (u32.eq (local expected) (u32 1)) (u32.eq (local expected) (u32 42)))
				(then (return (bool.or (u32.eq (local actual) (u32 5))
					(bool.or (u32.eq (local actual) (u32 10)) (u32.eq (local actual) (u32 11)))))))
			(if
				(:doc "A mutable byte view can also be read through a shared projection.")
				(u32.eq (local expected) (u32 34))
				(then (return (call is_byte_view_type (local actual)))))
			(if
				(:doc "An access can infer the element type from any readable view.")
				(u32.eq (local expected) (u32 55))
				(then (return (call is_readable_slice (local actual)))))
			(if
				(:doc "A store can infer the element type only from an exclusive view.")
				(u32.eq (local expected) (u32 56))
				(then (return (call is_writable_slice (local actual)))))
			(if
				(:doc "A mutable record slice can satisfy a shared formal for the same defining element.")
				(bool.and (bool.and (call is_record_slice (local expected)) (call is_record_slice (local actual)))
					(bool.and (bool.not (call is_writable_slice (local expected))) (call is_writable_slice (local actual))))
				(then (return (u32.eq (call record_slice_element (local expected)) (call record_slice_element (local actual))))))
			(if
				(:doc "A move carries the source owner's exact type into the receiving local.")
				(u32.eq (local expected) (u32 57))
				(then (return (call is_local_owner (local actual)))))
			(return (u32.eq (local expected) (local actual)))))

	(fn expression_row
		(:doc `Build a checked expression row, or an unvisited row with an expected scalar type.`)
		(params (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool))
		(returns ScalarExpression)
		(body
			(return (record.make ScalarExpression (kind (local kind)) (type (local type)) (target (local target))
				(first (local first)) (start (local start)) (end (local end)) (negative (local negative))
				(borrowed_owner (bool false))))))

	(fn plan_literal
		(:doc `Check one literal operand and record its normalized C spelling.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode)
			(operand i32) (type u32) (index i32) (expressions (mut-slice ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "A literal with missing or extra operands keeps the form's span.")
				(bool.or (i32.lt (local operand) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local operand)) next_sibling) (i32 0))))
				(then (return (call entry_at (local node) (i32 -1) (u32 25)))))
			(let value (slice.load (local nodes) (local operand)))
			(if
				(:doc "Normalize bool to a C integer constant that converts exactly to _Bool.")
				(u32.eq (local type) (u32 12))
				(then
					(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local operand)))
					(if
						(:doc "Only the bare true and false spellings are bool values.")
						(bool.and (bool.not (u32.eq (local tag) (u32 13))) (bool.not (u32.eq (local tag) (u32 14))))
						(then (return (call entry_at (local value) (i32 -1) (u32 25)))))
					(let-mut kind (u32 4))
					(if
						(:doc "Store false and true as distinct verified literal kinds.")
						(u32.eq (local tag) (u32 13))
						(then (set (local kind) (u32 5))))
					(slice.store (local expressions) (local index)
						(call expression_row (local kind) (local type) (i32 -1) (i32 -1) (i32 0) (i32 0) (bool false)))
					(return (call entry_at (local node) (local index) (u32 0)))))
			(let spelling (call decimal_scalar (borrow-shared (local source)) (local value) (local type)))
			(let digits (record.get (local spelling) digits))
			(if
				(:doc "An invalid spelling or magnitude points at the original value atom.")
				(i32.lt (local digits) (i32 0))
				(then (return (call entry_at (local value) (i32 -1) (u32 25)))))
			(slice.store (local expressions) (local index)
				(call expression_row (u32 1) (local type) (i32 -1) (i32 -1)
					(local digits) (record.get (local value) end) (record.get (local spelling) negative)))
			(return (call entry_at (local node) (local index) (u32 0)))))

	(fn find_function_parameter
		(:doc `Find a parameter in the current function's signature.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction)
			(parameters (shared-slice ScalarParameter)) (name SourceNode))
		(returns i32)
		(body
			(let start (record.get (local caller) params))
			(return (call find_parameter (borrow-shared (local source)) (borrow-shared (local nodes)) (local name)
				(borrow-shared (local parameters)) (local start) (i32.add.wrapping (local start) (record.get (local caller) arity))))))

	(fn find_local
		(:doc `Find the nearest declaration visible before a statement.

		Search earlier siblings in the current block. At a block boundary,
		resume before the enclosing if or while in its parent block. Every source
		statement appears after its previous siblings in the node table.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (statements (shared-slice ScalarStatement))
			(first i32) (statement i32) (name SourceNode))
		(returns i32)
		(body
			(let outer (record.get (slice.load (local nodes) (local first)) parent))
			(let-mut limit (local statement))
			(while
				(:doc "One search interval covers the visible declarations of one scope.")
				(bool.not (i32.lt (local limit) (i32 0)))
				(body
					(let block (record.get (slice.load (local nodes) (local limit)) parent))
					(let top (i32.eq (local block) (local outer)))
					(let-mut index (local first))
					(if
						(:doc "A nested block starts after its head and metadata.")
						(bool.not (local top))
						(then (set (local index) (record.get (slice.load (local statements) (local block)) first))))
					(while
						(:doc "Stop before the current statement or the if that enters the inner scope.")
						(i32.lt (local index) (local limit))
						(body
							(let checked (slice.load (local statements) (local index)))
							(let kind (record.get (local checked) kind))
							(if
								(:doc "Only let and let-mut introduce names.")
								(bool.or (u32.eq (local kind) (u32 15)) (u32.eq (local kind) (u32 16)))
								(then
									(let declaration (slice.load (local nodes) (record.get (local checked) target)))
									(if
										(:doc "Compare the original identifier bytes in this scope.")
										(call same_name (borrow-shared (local source)) (local declaration) (local name))
										(then (return (local index))))))
							(set (local index) (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
								(record.get (slice.load (local nodes) (local index)) next_sibling)))))
					(if
						(:doc "Parameters are resolved separately once all statement scopes have been searched.")
						(local top)
						(then (return (i32 -1))))
					(set (local limit) (record.get (slice.load (local nodes) (local block)) parent))))
			(return (i32 -1))))

	(fn read_local_name
		(:doc `Check the single name operand shared by reads and assignment targets.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (operand i32))
		(returns EntryRead)
		(body
			(if
				(:doc "A local reference takes exactly one name.")
				(bool.or (i32.lt (local operand) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local operand)) next_sibling) (i32 0))))
				(then (return (call entry_at (local node) (i32 -1) (u32 24)))))
			(let name (slice.load (local nodes) (local operand)))
			(if
				(:doc "A malformed local name keeps the operand span.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(return (call entry_at (local name) (local operand) (u32 0)))))

	(fn plan_local
		(:doc `Resolve a read to a checked binding and retain its defining name or parameter row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode)
			(operand i32) (expected u32) (index i32) (caller ScalarFunction) (statement i32)
			(parameters (shared-slice ScalarParameter)) (statements (shared-slice ScalarStatement))
			(expressions (mut-slice ScalarExpression)))
		(returns EntryRead)
		(body
			(let named (call read_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local operand)))
			(if
				(:doc "Preserve shape and name diagnostics before lookup.")
				(u32.lt (u32 0) (record.get (local named) error))
				(then (return (local named))))
			(let name (slice.load (local nodes) (local operand)))
			(let reborrow (call is_reborrow_keyword (local expected)))
			(let-mut type (local expected))
			(if
				(:doc "An explicit reborrow expects the view type for its access mode.")
				(local reborrow)
				(then (set (local type) (u32.sub.wrapping (local expected) (u32 1)))))
			(let binding (call find_local (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local statements))
				(record.get (local caller) first_statement) (local statement) (local name)))
			(if
				(:doc "An earlier local declaration carries its defining name and checked initializer type.")
				(bool.not (i32.lt (local binding) (i32 0)))
				(then
					(let declaration (slice.load (local statements) (local binding)))
					(let actual (record.get (local declaration) type))
					(let transfer (record.get (local declaration) move_site))
					(if
						(:doc "The original name remains resolvable so its transfer can be reported.")
						(bool.not (i32.lt (local transfer) (i32 0)))
						(then (return (record.make EntryRead (operand (i32 -1))
							(start (record.get (local node) start)) (end (record.get (local node) end))
							(error (u32 39)) (related (local transfer))))))
					(if
						(:doc "Native pointer owners need a checked borrow or transfer before they can be read.")
						(bool.and (call is_native_owner (local actual)) (bool.not (u32.eq (local expected) (u32 57))))
						(then (return (call entry_at (local node) (i32 -1) (u32 24)))))
					(if
						(:doc "Only an explicit matching call loan can borrow an owner's backing storage.")
						(bool.and (call is_array_owner (local actual))
							(bool.or (local reborrow) (call is_record_slice (local expected))))
						(then
							(let-mut element (u32 10))
							(if
								(:doc "A record formal carries its exact defining element type.")
								(call is_record_slice (local type))
								(then (set (local element) (call record_slice_element (local type)))))
							(if
								(:doc "Both types must agree, and exclusive access requires a writable binding.")
								(bool.or (bool.not (u32.eq (call array_owner_element (local actual)) (local element)))
									(bool.and (call is_writable_slice (local type))
										(bool.not (u32.eq (record.get (local declaration) kind) (u32 16)))))
								(then (return (call entry_at (local node) (i32 -1) (u32 24))))))
						(else
							(if
								(:doc "All other uses must satisfy the expected value type.")
								(bool.not (call value_matches_type (local type) (local actual)))
								(then (return (call entry_at (local node) (i32 -1) (u32 24)))))))
					(let target (record.get (local declaration) target))
					(slice.store (local expressions) (local index)
						(call expression_row (u32 6) (local actual) (local target) (i32 -1) (i32 0) (i32 0) (bool false)))
					(return (call entry_at (local node) (local binding) (u32 0)))))
			(let target (call find_function_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
				(local caller) (borrow-shared (local parameters)) (local name)))
			(if
				(:doc "The name must already be bound in the current function.")
				(i32.lt (local target) (i32 0))
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(let actual (record.get (slice.load (local parameters) (local target)) type))
			(if
				(:doc "Apply the parameter's declared type at this use.")
				(bool.not (call value_matches_type (local type) (local actual)))
				(then (return (call entry_at (local node) (i32 -1) (u32 24)))))
			(slice.store (local expressions) (local index)
				(call expression_row (u32 2) (local actual) (local target) (i32 -1) (i32 0) (i32 0) (bool false)))
			(return (call entry_at (local node) (local index) (u32 0)))))

	(fn check_statement_binding
		(:doc `Check a declaration name or identify the binding written by an assignment.

		Return the declaration's name node for let or let-mut and the checked
		statement row for set. Other statements have no binding.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction)
			(parameters (shared-slice ScalarParameter)) (statements (shared-slice ScalarStatement))
			(index i32) (statement StatementRead))
		(returns EntryRead)
		(body
			(let kind (record.get (local statement) kind))
			(let operand (record.get (local statement) binding))
			(if
				(:doc "Only declarations and assignments have a binding operand.")
				(i32.lt (local operand) (i32 0))
				(then (return (call entry_at (slice.load (local nodes) (local index)) (i32 -1) (u32 0)))))
			(let assigning (u32.eq (local kind) (u32 17)))
			(let-mut name_index (local operand))
			(if
				(:doc "An assignment takes a local reference rather than a bare name.")
				(local assigning)
				(then
					(let target (slice.load (local nodes) (local operand)))
					(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local target) (u32 8) (u32 24)))
					(if
						(:doc "Preserve the original assignment target form diagnostic.")
						(u32.lt (u32 0) (record.get (local form) error))
						(then (return (local form))))
					(let named (call read_local_name (borrow-shared (local source)) (borrow-shared (local nodes))
						(local target) (record.get (local form) operand)))
					(if
						(:doc "Preserve errors at the target operand.")
						(u32.lt (u32 0) (record.get (local named) error))
						(then (return (local named))))
					(set (local name_index) (record.get (local named) operand))))
			(let name (slice.load (local nodes) (local name_index)))
			(if
				(:doc "Declarations introduce bare local identifiers.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(let binding (call find_local (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local statements))
				(record.get (local caller) first_statement) (local index) (local name)))
			(if
				(:doc "A known local is either a duplicate declaration or a possible assignment target.")
				(bool.not (i32.lt (local binding) (i32 0)))
				(then
					(if
						(:doc "A declaration can shadow an outer binding. Two declarations in the same block conflict.")
						(bool.not (local assigning))
						(then
							(let prior (slice.load (local nodes) (local binding)))
							(let here (slice.load (local nodes) (local index)))
							(if
								(:doc "Preserve the later declaration's name span when their scopes coincide.")
								(i32.eq (record.get (local prior) parent) (record.get (local here) parent))
								(then (return (call entry_at (local name) (i32 -1) (u32 33)))))
							(return (call entry_at (local name) (local name_index) (u32 0)))))
					(let target (slice.load (local statements) (local binding)))
					(if
						(:doc "Only a let-mut binding accepts a write.")
						(bool.not (u32.eq (record.get (local target) kind) (u32 16)))
						(then (return (call entry_at (local name) (i32 -1) (u32 37)))))
					(if
						(:doc "An owner stays bound to its allocation for the life of its scope.")
						(call is_local_owner (record.get (local target) type))
						(then (return (call entry_at (slice.load (local nodes) (local operand)) (i32 -1) (u32 24)))))
					(return (call entry_at (local name) (local binding) (u32 0)))))
			(let parameter (call find_function_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
				(local caller) (borrow-shared (local parameters)) (local name)))
			(if
				(:doc "A parameter is immutable and shares the outermost scope with the function body.")
				(bool.not (i32.lt (local parameter) (i32 0)))
				(then
					(if
						(:doc "Report an attempted parameter write at the reference name.")
						(local assigning)
						(then (return (call entry_at (local name) (i32 -1) (u32 37)))))
					(let first (slice.load (local nodes) (record.get (local caller) first_statement)))
					(let here (slice.load (local nodes) (local index)))
					(if
						(:doc "Only a declaration directly in the function body conflicts with its parameter.")
						(i32.eq (record.get (local first) parent) (record.get (local here) parent))
						(then (return (call entry_at (local name) (i32 -1) (u32 33)))))))
			(if
				(:doc "A write cannot introduce a binding.")
				(local assigning)
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(return (call entry_at (local name) (local name_index) (u32 0)))))

	(fn find_graph_function
		(:doc `Resolve a file-local spelling to its defining scalar function.

		The graph binding records the defining file and an original tree row.
		The scalar table keeps exactly one registered signature for that pair.`)
		(params (arena (shared-slice u8)) (functions (shared-slice ScalarFunction))
			(bindings (shared-slice GraphBinding)) (owner i32) (base i32)
			(spelling (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let chosen (call find_binding (borrow-shared (local arena)) (borrow-shared (local spelling))
				(local start) (local end) (borrow-shared (local bindings)) (slice.len (local bindings))
				(local owner) (bool false) (local base) (u32 0)))
			(if
				(:doc "An unavailable name reports back to the referencing file.")
				(i32.lt (local chosen) (i32 0))
				(then (return (i32 -1))))
			(let binding (slice.load (local bindings) (local chosen)))
			(let-mut index (i32 0))
			(while
				(:doc "Find the canonical declaration rather than an alias's binding row.")
				(i32.lt (local index) (slice.len (local functions)))
				(body
					(let function (slice.load (local functions) (local index)))
					(if
						(:doc "Compare the defining file and the declaration row within that file.")
						(bool.and
							(i32.eq (record.get (local binding) file) (record.get (local function) file))
							(i32.eq (record.get (local binding) declaration)
								(i32.sub.wrapping (record.get (local function) declaration) (record.get (local function) tree_base))))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (i32 -1))))

	(fn resolve_call_target
		(:doc `Look up a direct call in its caller's namespace or the single-file function table.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (functions (shared-slice ScalarFunction))
			(bindings (shared-slice GraphBinding)) (caller ScalarFunction) (name SourceNode))
		(returns i32)
		(body
			(let start (record.get (local name) start))
			(let end (record.get (local name) end))
			(if
				(:doc "A supplied graph already provides the file's selected name bindings.")
				(i32.lt (i32 0) (slice.len (local bindings)))
				(then (return (call find_graph_function (borrow-shared (local source))
					(borrow-shared (local functions)) (borrow-shared (local bindings))
					(record.get (local caller) file) (record.get (local caller) source_base)
					(borrow-shared (local source)) (local start) (local end)))))
			(return (call find_function (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local source)) (local start) (local end)))))

	(fn plan_call
		(:doc `Resolve a direct call and seed each argument from its formal type.

		The verified call row is keyed by the original call node and refers to
		the defining function row. Its operands retain their original links.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode)
			(operand i32) (expected u32) (index i32) (caller ScalarFunction)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(bindings (shared-slice GraphBinding)) (expressions (mut-slice ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "An empty call has no target to resolve.")
				(i32.lt (local operand) (i32 0))
				(then (return (call entry_at (local node) (i32 -1) (u32 34)))))
			(let name (slice.load (local nodes) (local operand)))
			(if
				(:doc "A direct call names a function binding with a bare identifier.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(let target (call resolve_call_target (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local bindings)) (local caller) (local name)))
			(if
				(:doc "The ABI entry is a host entry point and is unavailable to direct Wove calls.")
				(bool.or (i32.lt (local target) (i32 0))
					(record.get (slice.load (local functions) (local target)) entry))
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(let callee (slice.load (local functions) (local target)))
			(let actual (record.get (local callee) result))
			(if
				(:doc "Use the target's declared result to check the call in its original context.")
				(bool.not (call value_matches_type (local expected) (local actual)))
