					caller view_start))
			(return (call entry_at node index 0u32))))

	(fn check_projected_handle
		(:doc "Resolve the exact native field and check its original path against moves and earlier loans.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
