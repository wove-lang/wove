				index (borrow-mut expressions)))))

	(fn boolean_literal_row
		(:doc "Use the ordinary checked false or true expression kind for any Boolean literal value.")
		(params (value bool)) (returns ScalarExpression)
		(body
			(let-mut kind 4u32)
			(if value (then (set kind 5u32)))
			(return (call expression_row kind 12u32 -1i32 -1i32 0i32 0i32 (bool false)))))

	(fn plan_literal
		(:doc `Check one literal operand and record its normalized C spelling.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(operand i32) (type u32) (index i32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "A literal with missing or extra operands keeps the form's span.")
				(bool.or (i32.ltz operand)
					(i32.not-ltz (struct.get (array.load nodes operand) next_sibling)))
				(then (return (call entry_at node -1i32 25u32))))
			(let value (array.load nodes operand))
