	(fn plan_projected_loan
		(:doc `Check a static field path and lend its original storage.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (place i32) (caller ScalarFunction) (statement i32) (expected u32) (view_start i32)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let infer_mut (u32.eq expected infer_mut_array))
			(let inferred (bool.or infer_mut (u32.eq expected infer_shared_array)))
			(let-mut request expected)
			(if inferred (then (set request 35u32)))
			(if infer_mut (then (set request 39u32)))
