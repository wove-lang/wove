				(:doc "An invalid float spelling points at the original atom including its suffix.")
				(i32.eqz shape)
				(then (return (call entry_at node -1i32 25u32))))
			(array.store expressions index
				(call expression_row float_literal type shape -1i32 start end (bool false)))
			(return (call entry_at node index 0u32))))

	(fn plan_suffixed_integer
		(:doc "Resolve the suffix against the exact builtin integer types before checking the magnitude.")
		(params (source (shared-array u8)) (node SourceNode) (suffix i32) (index i32) (expected u32)
			(expressions (mut-array ScalarExpression))) (returns EntryRead)
