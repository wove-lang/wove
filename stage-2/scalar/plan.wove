						(u32.gtz (struct.get arms error))
						(then (return (call body_error caller (struct.get arms start)
							(struct.get arms end) (struct.get arms error)))))
					(set first (struct.get arms operand))))
			(let falls (u32.not-eq kind 7u32))
			(let-mut paths 0u32)
			(if falls (then (set paths next_path)))
			(array.store statements index
				(struct.new ScalarStatement (kind emitted_kind) (target target) (value value)
					(type type)
					(first first) (previous_owner previous_owner)
					(falls_through falls) (move_site -1i32) (paths paths) (previous_loan previous_loan)))
			(return checked)))

	(fn seed_owned_parameters
		(:doc "Put transferred formals in the outer owner chain before planning the first statement.")
		(params (caller ScalarFunction) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(statements (mut-array ScalarStatement)))
		(returns i32)
		(body
			(let-mut parameter (struct.get caller params))
			(let limit (i32.add parameter (struct.get caller arity)))
			(let-mut owner -1i32)
			(while
				(:doc "Use the original formal name row as the lexical binding identity and cleanup slot.")
				(i32.lt parameter limit)
				(body
					(let param (array.load parameters parameter))
					(let type (struct.get param type))
					(if
						(:doc "Each transferred formal joins the same reverse-order cleanup chain as a local owner.")
						(call is_owned_parameter (borrow-shared records) type)
						(then
							(let name (struct.get param name))
							(array.store statements name
								(struct.new ScalarStatement (kind owned_parameter_binding) (target name) (value -1i32)
									(type type) (first (struct.get caller body)) (previous_owner owner)
									(falls_through (bool true)) (move_site -1i32) (paths next_path) (previous_loan -1i32)))
							(set owner name)))
					(set parameter (i32.inc parameter))))
			(return owner)))

	(fn plan_function_body
		(:doc `Check one function in source order and merge return paths at block boundaries.

		The source links identify which block owns each declaration.
		Remember the then result while checking an explicit else.
		Keep written arms available for diagnostics and compute the
		reachable edges before closing each control statement.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (caller ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)) (statements (mut-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (sites (mut-array CallSite)) (site_start i32) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count site_start)
			(let-mut index (struct.get caller first_statement))
			(let outer (struct.get caller body))
			(let-mut block outer)
			(let-mut falls_through (bool true))
			(let-mut previous_owner (call seed_owned_parameters caller (borrow-shared parameters)
				(borrow-shared records) (borrow-mut statements)))
			(let-mut previous_loan -1i32)
			(while
				(:doc "Visit remaining statements or leave nested blocks until the function body is complete.")
				(bool.or (i32.not-ltz index) (i32.not-eq block outer))
				(body
					(if
						(:doc "At the end of a block, enter an explicit else or resume in the parent.")
						(i32.ltz index)
						(then
							(let exit (call after_block (borrow-shared source) (borrow-shared nodes) block))
							(let owner_index (struct.get exit owner))
							(let owner (array.load statements owner_index))
							(let arm (array.load statements block))
							(let paths (call sequence_paths (borrow-shared nodes) (borrow-shared statements)
								next_path (struct.get arm first) -1i32))
							(array.store statements block (call statement_exit_state arm
								(struct.get arm target) previous_owner falls_through paths))
							(let loop (call is_loop (struct.get owner kind)))
							(if
								(:doc "Fallthrough and continue must preserve the owners live at loop entry.")
								(bool.and (bool.and loop (call repeats_loop paths))
									(bool.and (i32.lt -1i32 (struct.get owner previous_owner))
										(u32.not-eq (call predicate_literal owner (borrow-shared expressions)) 4u32)))
								(then
									(let transfer (call consumption_on_back_edge (borrow-shared nodes)
										(borrow-shared statements) (borrow-shared expressions)
										(struct.get exit owner) block (struct.get caller tree_limit)))
									(if
										(:doc "A repeated consumption points to the actual move argument.")
										(i32.lt -1i32 transfer)
										(then
											(let move (array.load nodes transfer))
											(return (call body_error caller (struct.get move start)
												(struct.get move end) 24u32))))))
							(set previous_owner (struct.get owner previous_owner))
							(set previous_loan (struct.get owner previous_loan))
							(let next_arm (struct.get exit alternate))
							(if
								(:doc "Begin an alternate with only the enclosing scope's owners.")
								(i32.not-ltz next_arm)
								(then
									(set block next_arm)
									(if
										(:doc "A new case owns only the payload selected by its tag.")
										(u32.eq (struct.get owner kind) match_statement)
										(then (set previous_owner (call enter_case_owner (borrow-shared records)
											(borrow-mut statements) block previous_owner))))
									(set index (struct.get (array.load statements block) first))
									(set falls_through (bool true)))
								(else
									(let first (struct.get owner first))
									(let paths (call control_paths (borrow-shared nodes) (borrow-shared statements)
										(borrow-shared expressions) owner))
									(if
										(:doc "Apply the completed loop's reachable successor state.")
										loop
										(then (set falls_through (call has_path paths next_path)))
										(else
											(if
												(:doc "An exhaustive match can continue only through one of its checked arms.")
												(u32.eq (struct.get owner kind) match_statement)
												(then (set falls_through (call match_continues (borrow-shared nodes)
													(borrow-shared statements) first)))
												(else
													(set falls_through
														(bool.or falls_through
															(bool.or (i32.eq block first)
																(struct.get (array.load statements first) falls_through))))))))
									(array.store statements owner_index (call statement_exit_state owner
										(struct.get owner target) previous_owner falls_through paths))
									(set block (struct.get exit block))
									(set index (struct.get exit statement)))))
						(else
							(let node (array.load nodes index))
							(if
								(:doc "A terminal statement leaves the following statement unreachable.")
								(bool.not falls_through)
								(then (return (call body_error caller (struct.get node start)
									(struct.get node end) 24u32))))
							(let checked (call plan_statement (borrow-shared source) (borrow-shared nodes)
								caller index (borrow-shared functions) (borrow-shared parameters)
								(borrow-shared bindings) (borrow-shared records) (borrow-mut statements) (borrow-mut expressions)
								(borrow-mut sites) site_count view_start previous_owner previous_loan))
							(if
								(:doc "Stop before planning any statements past the originating error.")
								(u32.gtz (struct.get checked error))
								(then (return checked)))
							(set site_count (struct.get checked count))
							(let statement (array.load statements index))
							(let kind (struct.get statement kind))
							(if
								(:doc "Only an owning declaration adds an active owner to this scope.")
								(bool.and (bool.or (u32.eq kind 15u32) (u32.eq kind 16u32))
									(call is_lexical_owner (borrow-shared records) (struct.get statement type)))
								(then (set previous_owner index)))
							(if
								(:doc "A view or scoped record holds its loans after checking the complete initializer.")
								(bool.or (bool.and (u32.eq kind 15u32)
									(bool.or (bool.or (call is_readable_slice (struct.get statement type))
											(u32.eq (struct.get statement type) native_cstrs_type))
										(bool.or (u32.eq (struct.get statement type) optional_view_type)
											(call is_optional_record_borrow (struct.get statement type)))))
									(bool.and (bool.or (u32.eq kind 15u32) (u32.eq kind 16u32))
										(call is_scoped_record (borrow-shared records) (struct.get statement type))))
								(then (set previous_loan index)))
							(set falls_through (struct.get statement falls_through))
							(let first (struct.get statement first))
							(if
								(:doc "Control flow enters its first block. Other statements continue at their sibling.")
								(i32.ltz first)
								(then (set index (call skip_disabled_siblings (borrow-shared source)
									(borrow-shared nodes) (struct.get node next_sibling))))
								(else
									(if
										(:doc "The array iterator keeps its shared loan until control leaves the loop.")
										(bool.and (u32.eq kind for_statement) (call is_readable_slice (struct.get statement type)))
										(then
											(let loan (array.load expressions (struct.get statement value)))
											(if
												(:doc "A static descriptor or its range has no local or parameter identity to reserve.")
												(bool.and (u32.not-eq (struct.get loan kind) 62u32)
													(i32.lt -1i32 (struct.get loan target)))
												(then (set previous_loan index)))))
									(set block first)
									(if
										(:doc "A consuming body starts with its captured array and any owned item.")
										(bool.and (u32.eq kind for_statement)
											(call is_array_owner (struct.get statement type)))
										(then (set previous_owner (call enter_consuming_iteration
											(borrow-shared nodes) (borrow-mut statements) statement))))
									(if
										(:doc "The first case starts with its captured payload owner when present.")
										(u32.eq kind match_statement)
										(then (set previous_owner (call enter_case_owner (borrow-shared records)
											(borrow-mut statements) block previous_owner))))
									(set index (struct.get (array.load statements block) first))))))))
			(if
				(:doc "Every path through a value-returning body must return.")
				(bool.and falls_through (u32.not-eq (struct.get caller result) (call void_type)))
				(then
					(let node (array.load nodes outer))
					(return (call body_error caller (struct.get node start)
						(struct.get node end) 24u32))))
			(array.store statements outer
				(call block_statement (struct.get caller first_statement) -1i32 previous_owner falls_through))
			(return (call body_success site_count))))

	(fn plan_bodies
		(:doc `Check each selected function and retain the resolved calls in source order.

		Start with zeroed plan storage. Read the returned call-site count
		only on success. Use zero view start for an arena of whole source files.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (statements (mut-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (sites (mut-array CallSite)) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count 0i32)
			(let-mut function 0i32)
			(let count (call checked_function_count (borrow-shared functions)))
			(while
				(:doc "Each Wove function has its own block scopes and checked exits.")
				(i32.lt function count)
				(body
					(let definition (array.load functions function))
					(if
						(:doc "Foreign signatures contribute call targets while their bodies come from C.")
						(i32.not-ltz (struct.get definition body))
						(then
							(call register_function_references (borrow-shared source) (borrow-shared nodes)
								definition (borrow-shared functions) (borrow-shared parameters)
								(borrow-shared bindings) (borrow-mut records))
							(let checked (call plan_function_body (borrow-shared source) (borrow-shared nodes)
								definition (borrow-shared functions)
								(borrow-shared parameters) (borrow-shared bindings) (borrow-shared records)
								(borrow-mut statements) (borrow-mut expressions) (borrow-mut sites)
								site_count view_start))
							(if
								(:doc "Report the earliest rejected body with the original file and span.")
								(u32.gtz (struct.get checked error))
								(then (return checked)))
							(set site_count (struct.get checked count))))
					(set function (i32.inc function))))
			(return (call body_success site_count)))))
