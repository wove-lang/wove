					(local operand) (local index) (local tag) (local operator) (borrow-mut (local expressions))))))
			(return (call plan_literal (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local operand) (local actual) (local index) (borrow-mut (local expressions))))))

	(fn
		(:doc `Report a body diagnostic in the caller's view, independently of arena packing.`)
		body_error
		(params (caller ScalarFunction) (start i32) (end i32) (error u32))
		(returns BodyPlan)
		(body
			(let base (record.get (local caller) source_base))
			(return (record.make BodyPlan (count (i32 0)) (file (record.get (local caller) file))
				(start (i32.sub.wrapping (local start) (local base))) (end (i32.sub.wrapping (local end) (local base)))
				(error (local error))))))

	(fn
		(:doc `Capture each endpoint's original tree row and the half-open span in the calling file.`)
		resolved_call_site
		(params (caller ScalarFunction) (callee ScalarFunction) (node SourceNode) (view_start i32))
		(returns CallSite)
		(body
			(let base (record.get (local caller) source_base))
			(return (record.make CallSite
				(caller_file (record.get (local caller) file))
				(caller (i32.sub.wrapping (record.get (local caller) declaration) (record.get (local caller) tree_base)))
				(callee_file (record.get (local callee) file))
				(callee (i32.sub.wrapping (record.get (local callee) declaration) (record.get (local callee) tree_base)))
				(start (i32.add.wrapping (local view_start) (i32.sub.wrapping (record.get (local node) start) (local base))))
				(end (i32.add.wrapping (local view_start) (i32.sub.wrapping (record.get (local node) end) (local base))))))))

	(fn
		(:doc `Check a statement's value tree in source order.

		Calls, operators, and conversions seed their operand rows before
		they are reached. A seeded value either has an exact expectation
		or infers its integer type. Append calls to the caller's checked prefix.`)
		plan_value
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction)
			(root i32) (expected u32) (statement i32) (functions (shared-slice ScalarFunction))
			(parameters (shared-slice ScalarParameter)) (bindings (shared-slice GraphBinding))
			(statements (shared-slice ScalarStatement)) (expressions (mut-slice ScalarExpression))
			(sites (mut-slice CallSite)) (site_start i32) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count (local site_start))
			(let end (record.get (slice.load (local nodes) (local root)) end))
			(slice.store (local expressions) (local root)
				(call expression_row (u32 0) (local expected)
					(i32 -1) (i32 -1) (i32 0) (i32 0) (bool false)))
			(let-mut index (local root))
			(while
				(:doc "Every source row inside the value expression follows its parent in the tree table.")
				(bool.and (i32.lt (local index) (record.get (local caller) tree_limit))
					(i32.lt (record.get (slice.load (local nodes) (local index)) start) (local end)))
				(body
					(let type (record.get (slice.load (local expressions) (local index)) type))
					(if
						(:doc "Unseeded rows have no expectation and sit outside the value tree.")
						(u32.lt (u32 0) (local type))
						(then
							(let checked (call plan_expression (borrow-shared (local source)) (borrow-shared (local nodes))
								(local caller) (local index) (local type) (local statement) (borrow-shared (local functions))
								(borrow-shared (local parameters)) (borrow-shared (local bindings))
								(borrow-shared (local statements)) (borrow-mut (local expressions)) (local view_start)))
							(if
								(:doc "Preserve source spans from the first failing signature or expression.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (call body_error (local caller) (record.get (local checked) start)
										(record.get (local checked) end) (record.get (local checked) error)))))
							(let expression (slice.load (local expressions) (local index)))
							(if
								(:doc "Record every resolved call before lowering, using its defining declaration row.")
								(u32.eq (record.get (local expression) kind) (u32 3))
								(then
									(let node (slice.load (local nodes) (local index)))
									(if
										(:doc "A short call-site table reports the first unwritable call.")
										(bool.not (i32.lt (local site_count) (slice.len (local sites))))
										(then (return (call body_error (local caller) (record.get (local node) start)
											(record.get (local node) end) (u32 16)))))
									(let callee (slice.load (local functions) (record.get (local expression) target)))
									(slice.store (local sites) (local site_count)
										(call resolved_call_site (local caller) (local callee) (local node) (local view_start)))
									(set (local site_count) (i32.add.wrapping (local site_count) (i32 1)))))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (record.make BodyPlan (count (local site_count)) (file (i32 -1)) (start (i32 0)) (end (i32 0)) (error (u32 0))))))

	(fn
		(:doc `Check one required block and the optional else of an if before typing the condition.`)
		plan_control_blocks
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (statements (mut-slice ScalarStatement))
			(node SourceNode) (condition i32) (loop bool))
		(returns EntryRead)
		(body
			(let first (record.get (slice.load (local nodes) (local condition)) next_sibling))
			(if
				(:doc "The condition must be followed by the first block.")
				(i32.lt (local first) (i32 0))
				(then (return (call entry_at (local node) (i32 -1) (u32 24)))))
			(let-mut expected (u32 23))
			(if
				(:doc "A while has a body. An if starts with then.")
				(local loop)
				(then (set (local expected) (u32 6))))
			(let first_node (slice.load (local nodes) (local first)))
			(let first_block (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local first_node) (local expected) (u32 24)))
			(if
				(:doc "Keep the original first-block form or metadata diagnostic.")
				(u32.lt (u32 0) (record.get (local first_block) error))
				(then (return (local first_block))))
			(slice.store (local statements) (local first)
				(call block_statement (record.get (local first_block) operand) (bool true)))
			(let alternate (record.get (local first_node) next_sibling))
			(if
				(:doc "An explicit else must be the final arm and supplies its own first statement.")
				(bool.not (i32.lt (local alternate) (i32 0)))
				(then
					(let else_node (slice.load (local nodes) (local alternate)))
					(if
						(:doc "A loop accepts a single body block.")
						(local loop)
						(then (return (call entry_at (local else_node) (i32 -1) (u32 24)))))
					(let else_arm (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
						(local else_node) (u32 24) (u32 24)))
					(if
						(:doc "Keep the original else-arm form or metadata diagnostic.")
						(u32.lt (u32 0) (record.get (local else_arm) error))
						(then (return (local else_arm))))
					(let extra (record.get (local else_node) next_sibling))
					(if
						(:doc "Point at the first operand beyond the optional else.")
						(bool.not (i32.lt (local extra) (i32 0)))
						(then (return (call entry_at (slice.load (local nodes) (local extra)) (i32 -1) (u32 24)))))
					(slice.store (local statements) (local alternate)
						(call block_statement (record.get (local else_arm) operand) (bool true)))))
			(return (call entry_at (local node) (local first) (u32 0)))))

	(fn
		(:doc `Check a statement and its value, then publish its row and append any calls.`)
		plan_statement
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction) (index i32)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(bindings (shared-slice GraphBinding)) (statements (mut-slice ScalarStatement))
			(expressions (mut-slice ScalarExpression)) (sites (mut-slice CallSite)) (site_count i32) (view_start i32))
		(returns BodyPlan)
		(body
			(let node (slice.load (local nodes) (local index)))
			(let statement (call read_statement (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(if
				(:doc "Keep the originating form or operand span for malformed statements.")
				(u32.lt (u32 0) (record.get (local statement) error))
				(then (return (call body_error (local caller) (record.get (local statement) start)
					(record.get (local statement) end) (record.get (local statement) error)))))
			(let binding (call check_statement_binding (borrow-shared (local source)) (borrow-shared (local nodes))
				(local caller) (borrow-shared (local parameters)) (borrow-shared (local statements))
				(local index) (local statement)))
			(if
				(:doc "Preserve the original declaration or assignment target diagnostic.")
				(u32.lt (u32 0) (record.get (local binding) error))
				(then (return (call body_error (local caller) (record.get (local binding) start)
					(record.get (local binding) end) (record.get (local binding) error)))))
			(let kind (record.get (local statement) kind))
			(let value (record.get (local statement) value))
			(let-mut first (i32 -1))
			(let-mut target (record.get (local binding) operand))
			(let-mut expected (u32 1))
			(if
				(:doc "An assignment uses the exact type and name of the binding checked earlier.")
				(u32.eq (local kind) (u32 17))
				(then
					(let declaration (slice.load (local statements) (local target)))
					(set (local expected) (record.get (local declaration) type))
					(set (local target) (record.get (local declaration) target))))
			(if
				(:doc "A return uses the function's exact declared type.")
				(u32.eq (local kind) (u32 7))
				(then (set (local expected) (record.get (local caller) result))))
			(let loop (u32.eq (local kind) (u32 25)))
			(if
				(:doc "Validate nested blocks and type-check their condition as bool.")
				(bool.or (u32.eq (local kind) (u32 22)) (local loop))
				(then
					(let blocks (call plan_control_blocks (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-mut (local statements)) (local node) (local value) (local loop)))
					(if
						(:doc "Keep the block syntax diagnostic at its originating form.")
						(u32.lt (u32 0) (record.get (local blocks) error))
						(then (return (call body_error (local caller) (record.get (local blocks) start)
							(record.get (local blocks) end) (record.get (local blocks) error)))))
					(set (local first) (record.get (local blocks) operand))
					(set (local expected) (u32 12))))
			(let checked (call plan_value (borrow-shared (local source)) (borrow-shared (local nodes))
				(local caller) (local value) (local expected) (local index) (borrow-shared (local functions))
				(borrow-shared (local parameters)) (borrow-shared (local bindings)) (borrow-shared (local statements))
				(borrow-mut (local expressions)) (borrow-mut (local sites)) (local site_count) (local view_start)))
			(if
				(:doc "Abort before publishing a binding whose value fails checking.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (local checked))))
			(slice.store (local statements) (local index)
				(record.make ScalarStatement (kind (local kind)) (target (local target)) (value (local value))
					(type (record.get (slice.load (local expressions) (local value)) type))
					(first (local first)) (falls_through (bool.not (u32.eq (local kind) (u32 7))))))
			(return (local checked))))

	(fn
		(:doc `Check one function in source order and merge return paths at block boundaries.

		The source links identify which block owns each declaration.
		Remember the then result while checking an explicit else. A loop
		or a branch with no else can continue past the statement without
		entering its block.`)
		plan_function_body
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction)
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(bindings (shared-slice GraphBinding)) (statements (mut-slice ScalarStatement))
			(expressions (mut-slice ScalarExpression)) (sites (mut-slice CallSite)) (site_start i32) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count (local site_start))
			(let-mut index (record.get (local caller) first_statement))
			(let outer (record.get (slice.load (local nodes) (local index)) parent))
			(let-mut block (local outer))
			(let-mut falls_through (bool true))
			(while
				(:doc "Visit remaining statements or leave nested blocks until the function body is complete.")
				(bool.or (bool.not (i32.lt (local index) (i32 0))) (bool.not (i32.eq (local block) (local outer))))
				(body
					(if
						(:doc "At the end of a block, enter an explicit else or resume in the parent.")
						(i32.lt (local index) (i32 0))
						(then
							(let exit (call after_block (borrow-shared (local nodes)) (local block)))
							(let next_arm (record.get (local exit) alternate))
							(if
								(:doc "Retain the then result while checking the else in its own scope.")
								(bool.not (i32.lt (local next_arm) (i32 0)))
								(then
									(let arm (slice.load (local statements) (local block)))
									(slice.store (local statements) (local block)
										(call block_statement (record.get (local arm) first) (local falls_through)))
									(set (local block) (local next_arm))
									(set (local index) (record.get (slice.load (local statements) (local block)) first))
									(set (local falls_through) (bool true)))
								(else
									(let owner (slice.load (local statements) (record.get (local exit) owner)))
									(let first (record.get (local owner) first))
									(set (local falls_through)
										(bool.or (local falls_through)
											(bool.or (i32.eq (local block) (local first))
												(record.get (slice.load (local statements) (local first)) falls_through))))
									(set (local block) (record.get (local exit) block))
									(set (local index) (record.get (local exit) statement)))))
						(else
							(let node (slice.load (local nodes) (local index)))
							(if
								(:doc "An exhaustive return leaves the following statement unreachable.")
								(bool.not (local falls_through))
								(then (return (call body_error (local caller) (record.get (local node) start)
									(record.get (local node) end) (u32 24)))))
							(let checked (call plan_statement (borrow-shared (local source)) (borrow-shared (local nodes))
								(local caller) (local index) (borrow-shared (local functions)) (borrow-shared (local parameters))
								(borrow-shared (local bindings)) (borrow-mut (local statements)) (borrow-mut (local expressions))
								(borrow-mut (local sites)) (local site_count) (local view_start)))
							(if
								(:doc "Stop before planning any statements past the originating error.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (local checked))))
							(set (local site_count) (record.get (local checked) count))
							(let statement (slice.load (local statements) (local index)))
							(set (local falls_through) (record.get (local statement) falls_through))
							(let first (record.get (local statement) first))
							(if
								(:doc "Control flow enters its first block. Other statements continue at their sibling.")
								(i32.lt (local first) (i32 0))
								(then (set (local index) (record.get (local node) next_sibling)))
								(else
									(set (local block) (local first))
									(set (local index) (record.get (slice.load (local statements) (local block)) first))))))))
			(if
				(:doc "Every path through a value-returning body must return.")
				(local falls_through)
				(then
					(let node (slice.load (local nodes) (local outer)))
					(return (call body_error (local caller) (record.get (local node) start)
						(record.get (local node) end) (u32 24)))))
			(return (record.make BodyPlan (count (local site_count)) (file (i32 -1)) (start (i32 0)) (end (i32 0)) (error (u32 0))))))

	(fn
		(:doc `Check each selected function and retain the resolved calls in source order.

		Start with zeroed plan storage. Read the returned call-site count
		only on success. Use zero view start for an arena of whole source files.`)
		plan_bodies
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(functions (shared-slice ScalarFunction)) (parameters (shared-slice ScalarParameter))
			(bindings (shared-slice GraphBinding)) (statements (mut-slice ScalarStatement))
			(expressions (mut-slice ScalarExpression)) (sites (mut-slice CallSite)) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count (i32 0))
			(let-mut function (i32 0))
			(while
				(:doc "Each function has its own block scopes and a checked path to return.")
				(i32.lt (local function) (slice.len (local functions)))
				(body
					(let checked (call plan_function_body (borrow-shared (local source)) (borrow-shared (local nodes))
						(slice.load (local functions) (local function)) (borrow-shared (local functions))
						(borrow-shared (local parameters)) (borrow-shared (local bindings)) (borrow-mut (local statements))
						(borrow-mut (local expressions)) (borrow-mut (local sites)) (local site_count) (local view_start)))
					(if
						(:doc "Report the earliest rejected body with the original file and span.")
						(u32.lt (u32 0) (record.get (local checked) error))
						(then (return (local checked))))
					(set (local site_count) (record.get (local checked) count))
					(set (local function) (i32.add.wrapping (local function) (i32 1)))))
			(return (record.make BodyPlan (count (local site_count)) (file (i32 -1)) (start (i32 0)) (end (i32 0)) (error (u32 0)))))))
