					(if
						(:doc "Types and module bindings have already been registered.")
						(bool.not (bool.or (bool.or (u32.eq kind enum_declaration) (u32.eq kind callable_alias_kind))
							(bool.or (u32.eq kind 48u32) (u32.eq kind 15u32))))
