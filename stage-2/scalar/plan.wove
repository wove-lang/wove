					(let fresh (bool.or (bool.or (u32.eq tag 9u32)
						(bool.or (u32.eq tag array_try_push_kind) (u32.eq tag worker_try_spawn_kind)))
						(bool.or (bool.or (u32.eq tag worker_spawn_join_kind) (call is_worker_collect tag))
							(u32.eq tag conditional_value))))
					(let construct (bool.or (u32.eq tag array_remove_kind)
						(bool.or (bool.and returning_record
								(bool.or (u32.eq tag fixed_list_kind)
									(bool.or (u32.eq tag 50u32) (u32.eq tag enum_constructor))))
							(bool.or (bool.and (call is_array_owner expected) (u32.eq tag 41u32))
								(bool.or (bool.and (call is_native_owner expected) (call is_native_owner_constructor tag))
									(bool.and (call is_optional_owner expected)
