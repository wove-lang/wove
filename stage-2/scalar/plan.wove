	(fn
		(:doc `Resolve a file-local spelling to its defining scalar function.

		The graph binding records the defining file and an original tree row.
		The scalar table keeps exactly one registered signature for that pair.`)
		find_graph_function
		(params (arena (shared-slice u8)) (functions (shared-slice ScalarFunction))
