				(:doc "All fixed arguments are required. Only an open C tail admits additional operands.")
				(bool.or (i32.lt formal limit)
					(bool.and (bool.not open_tail) (i32.not-ltz argument)))
				(then (return (call entry_at node -1i32 35u32))))
			(while
				(:doc "Infer each tail value's own type before checking whether it can cross the C ABI.")
				(i32.not-ltz argument)
				(body
					(array.store expressions argument
						(call expression_row 0u32 42u32 -1i32 -1i32 0i32 0i32 (bool false)))
					(set argument (struct.get (array.load nodes argument) next_sibling))))
			(if
				(:doc "Keep the caller's file and original worker expression span for thread failures.")
				worker
				(then
					(let job (array.load parameters (struct.get callee params)))
					(array.store expressions index
						(call worker_expression kind actual target first
							(call worker_receipt_result (struct.get job type) result)
							node caller view_start))
					(return (call entry_at node index 0u32))))
			(array.store expressions index
				(call borrowed_call_row actual target first returned_argument))
			(return (call entry_at node index 0u32))))

	(fn plan_operator
		(:doc `Seed every operand with the exact operator type, including short-circuited operands.`)
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32)
			(operator ScalarOperator) (expression ScalarExpression) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let expected (call expression_row 0u32 (struct.get operator operand) -1i32 -1i32 0i32 0i32 (bool false)))
			(let-mut argument (struct.get expression first))
			(let-mut remaining (struct.get operator arity))
			(while
				(:doc "Give each existing operand its expected type before descending into it.")
				(bool.and (i32.gtz remaining) (i32.not-ltz argument))
				(body
					(array.store expressions argument expected)
					(set argument (struct.get (array.load nodes argument) next_sibling))
					(set remaining (i32.dec remaining))))
			(if
				(:doc "Missing or extra operands point at the full operator form.")
				(bool.or (i32.gtz remaining) (i32.not-ltz argument))
				(then (return (call entry_at node -1i32 24u32))))
			(array.store expressions index expression)
			(return (call entry_at node index 0u32))))

	(fn plan_integer_equality
		(:doc `Compare two exact integers in their original type, including native aliases wider than u32.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (operand i32) (index i32) (kind u32)
			(caller ScalarFunction) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if (i32.ltz operand) (then (return (call entry_at node -1i32 24u32))))
			(let spelling (array.load nodes operand))
			(let type (call copyable_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings)
				(struct.get caller file) (struct.get caller source_base) operand))
			(if
				(:doc "Resolve and require a supported equality type before checking either value.")
				(bool.not (call value_matches_type 1u32 type))
				(then (return (call entry_at spelling -1i32 24u32))))
			(let operator (struct.new ScalarOperator (operand type) (result 12u32)
				(symbol 61u8) (arity 2i32) (short_circuit (bool false))))
			(let expression (call expression_row kind 12u32 -1i32
				(struct.get spelling next_sibling) 0i32 0i32 (bool false)))
			(return (call plan_operator (borrow-shared nodes) node index
				operator expression (borrow-mut expressions)))))

	(fn plan_word_count
		(:doc `Type a word and signed count and keep the original span of its bounds check.`)
		(params (nodes (shared-array SourceNode)) (node SourceNode) (word i32) (index i32) (kind u32) (type u32)
			(caller ScalarFunction) (view_start i32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "The word is the first required operand.")
				(i32.ltz word)
				(then (return (call entry_at node -1i32 24u32))))
			(let count (struct.get (array.load nodes word) next_sibling))
			(if
				(:doc "A shift or rotate requires exactly one count after the word.")
				(bool.or (i32.ltz count)
					(i32.not-ltz (struct.get (array.load nodes count) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(array.store expressions word
				(call expression_row 0u32 type -1i32 -1i32 0i32 0i32 (bool false)))
			(array.store expressions count
				(call expression_row 0u32 5u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(let-mut site index)
			(if
				(:doc "A rotate reports an invalid count at the count operand's source span.")
				(call word_rotates kind)
				(then (set site count)))
			(array.store expressions index
				(call runtime_expression kind type (array.load nodes site)
					word caller view_start))
			(return (call entry_at node index 0u32))))

	(fn plan_integer_check
		(:doc "Type a fit check or seed two arithmetic values followed by an exclusive writeback place.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(operation IntegerCheck) (index i32) (expected u32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let kind (struct.get operation kind))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node kind 24u32))
			(if (u32.gtz (struct.get form error)) (then (return form)))
			(let left (struct.get form operand))
			(if
				(:doc "All checks produce a bool and require at least one input value.")
				(bool.or (i32.ltz left) (bool.not (call value_matches_type expected 12u32)))
				(then (return (call entry_at node -1i32 24u32))))
			(let type (struct.get operation type))
			(let right (struct.get (array.load nodes left) next_sibling))
			(let-mut input type)
			(if
				(:doc "A fits expression accepts an integer of any width and signedness.")
				(u32.eq kind integer_fits)
				(then
					(if (i32.lt -1i32 right) (then (return (call entry_at node -1i32 24u32))))
					(set input 1u32))
				(else
					(if (i32.ltz right) (then (return (call entry_at node -1i32 24u32))))
					(let output (struct.get (array.load nodes right) next_sibling))
					(if
						(:doc "Arithmetic requires exactly two inputs and one explicit output loan.")
						(bool.or (i32.ltz output)
							(i32.lt -1i32 (struct.get (array.load nodes output) next_sibling)))
						(then (return (call entry_at node -1i32 24u32))))
					(array.store expressions right
						(call expression_row 0u32 type -1i32 -1i32 0i32 0i32 (bool false)))
					(array.store expressions output
						(call expression_row 0u32 (call place_reference_type type (bool true)) -1i32 -1i32 0i32 0i32 (bool false)))))
			(array.store expressions left
				(call expression_row 0u32 input -1i32 -1i32 0i32 0i32 (bool false)))
			(array.store expressions index
				(call expression_row kind 12u32 (i32.from-u32 type) left 0i32 0i32 (bool false)))
			(return (call entry_at node index 0u32))))

	(fn plan_conversion_operand
		(:doc `Seed one evaluated operand and retain the exact result and runtime site.`)
		(params (node SourceNode) (index i32) (value i32) (kind u32) (result u32) (operand_type u32)
			(expected u32) (caller ScalarFunction) (view_start i32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "The enclosing expression must accept the conversion's result type.")
				(bool.not (call value_matches_type expected result))
				(then (return (call entry_at node -1i32 24u32))))
			(array.store expressions value
				(call expression_row 0u32 operand_type -1i32 -1i32 0i32 0i32 (bool false)))
			(array.store expressions index
				(call runtime_expression kind result node value caller view_start))
			(return (call entry_at node index 0u32))))

	(fn plan_named_conversion
		(:doc `Check a named conversion against its exact source and destination types.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(head i32) (index i32) (tag u32) (expected u32) (caller ScalarFunction) (view_start i32)
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node tag 24u32))
			(if (u32.gtz (struct.get form error)) (then (return form)))
			(let value (struct.get form operand))
			(if
				(:doc "Each named operation consumes just one value.")
				(bool.or (i32.ltz value)
					(i32.lt -1i32 (struct.get (array.load nodes value) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(let operation (call read_named_conversion (borrow-shared source) (array.load nodes head)))
			(let-mut result (struct.get operation type))
			(let-mut input (struct.get operation operand))
			(let-mut kind tag)
			(if
				(:doc "Typed numerical conversions lower through the same checked operation as int.convert.")
				(u32.eq tag typed_integer_conversion)
				(then (set kind 33u32)))
			(if
				(:doc "An encoder produces the fixed byte layout already interned for the integer's width.")
				(call is_integer_byte_encoder tag)
				(then
					(let shape (struct.new FixedArrayShape (element 10u32)
						(extent (call integer_byte_width result))))
					(set result (call find_fixed_array_type (borrow-shared records) shape))
					(if (u32.eqz result) (then (return (call entry_at node -1i32 24u32))))))
			(if
				(:doc "A decode can read a shared descriptor directly or check an explicit shared loan.")
				(u32.eq input exact_byte_view)
				(then
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
						(array.load nodes value)))
					(if
						(:doc "Use the ordinary borrow planner for a named view or a byte range.")
						(u32.eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
							(struct.get parts head)) 35u32)
						(then (set input 35u32)))))
			(return (call plan_conversion_operand node index value kind
				result input expected caller view_start (borrow-mut expressions)))))

	(fn plan_conversion
		(:doc `Check a conversion target, seed its integer operand, and retain the original trap site.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(first i32) (index i32) (expected u32) (caller ScalarFunction) (view_start i32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "A conversion needs a target type followed by one value.")
				(i32.ltz first)
				(then (return (call entry_at node -1i32 24u32))))
			(let target_node (array.load nodes first))
			(let value (struct.get target_node next_sibling))
			(if
				(:doc "Missing or extra operands report at the conversion form.")
				(bool.or (i32.ltz value)
					(i32.not-ltz (struct.get (array.load nodes value) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(let target_type (call copyable_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings)
				(struct.get caller file) (struct.get caller source_base) first))
			(if
				(:doc "Point at the target spelling when it names an unsupported type.")
				(bool.not (call value_matches_type 1u32 target_type))
				(then (return (call entry_at target_node -1i32 24u32))))
			(return (call plan_conversion_operand node index value 33u32
				target_type 1u32 expected caller view_start (borrow-mut expressions)))))

	(fn at_owner_use
		(:doc `Use the full borrow or move span when a diagnostic carries an earlier transfer.`)
		(params (problem EntryRead) (use SourceNode))
		(returns EntryRead)
		(body
			(if
				(:doc "Other errors keep their original operand spans.")
				(i32.ltz (struct.get problem related))
				(then (return problem)))
			(return (struct.new EntryRead (operand -1i32)
				(start (struct.get use start)) (end (struct.get use end))
				(error (struct.get problem error)) (related (struct.get problem related))))))

	(fn plan_named_view
		(:doc `Resolve an access or call loan from a named slice, owner, or fixed array.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (use SourceNode) (reference SourceNode)
			(index i32) (caller ScalarFunction) (statement i32) (expectation u32) (range_source bool)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call check_binding_name (borrow-shared source) reference))
			(if
				(:doc "A named view resolves a binding before checking its storage.")
				(u32.gtz (struct.get form error))
				(then (return form)))
			(let infer_mut (u32.eq expectation infer_mut_array))
			(let inferring (bool.or infer_mut (u32.eq expectation infer_shared_array)))
			(let-mut lookup expectation)
			(if
				(:doc "Resolve the source first when no formal parameter fixes the element type.")
				inferring
				(then
					(set lookup 55u32)
					(if infer_mut (then (set lookup 56u32)))))
			(let checked (call plan_local (bool false) (borrow-shared source) (borrow-shared nodes)
				reference lookup index caller statement
				(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))
			(if
				(:doc "A use-after-move diagnostic identifies the attempted operation.")
				(u32.gtz (struct.get checked error))
				(then (return (call at_owner_use checked use))))
			(let resolved (array.load expressions index))
			(if
				(:doc "A static shared descriptor needs no local or parameter loan.")
				(u32.eq (struct.get resolved kind) 62u32)
				(then
					(if
						(:doc "Iteration and a fallible shared slice can refer to static storage without a local loan.")
						(bool.and inferring
							(bool.not (bool.or
								(u32.eq (struct.get (array.load expressions (struct.get use parent)) kind) try_slice_kind)
								(call is_iteration_statement (borrow-shared source) (borrow-shared nodes) statement))))
						(then (return (call entry_at reference -1i32 24u32))))
					(return checked)))
			(let-mut expected expectation)
			(if
				(:doc "Match the source's defining element and the initializer's written access mode.")
				inferring
				(then
					(set expected (call inferred_array_loan (borrow-shared records) resolved infer_mut))
					(if (u32.eqz expected) (then (return (call entry_at reference -1i32 24u32))))))
			(let target (struct.get resolved target))
			(let actual (struct.get resolved type))
			(if
				(:doc "Ordinary ranges require runtime storage. Bulk copy can also capture a fixed loan before slicing it.")
				(bool.and range_source
					(bool.not (bool.or (call is_array_owner actual) (call is_readable_slice actual))))
				(then
					(let parent (array.load expressions (struct.get use parent)))
					(if
						(:doc "The copy's own range operands may project an inline layout.")
						(bool.not (bool.and (u32.eq (struct.get parent kind) array_try_copy_kind)
							(call is_record_type actual)))
						(then (return (call entry_at reference -1i32 24u32))))))
			(if
				(:doc "An inline array access uses the original checked value or place.")
				(bool.and (call is_record_type actual)
					(bool.or (u32.eq expected 55u32) (u32.eq expected 56u32)))
				(then (return checked)))
			(let reborrow (call is_reborrow_keyword expected))
			(if
				(:doc "An explicit scalar slice borrow lends a fixed local with the exact element type.")
				(bool.and (bool.or reborrow (call is_fixed_scalar_slice expected))
					(bool.and (u32.eq (struct.get resolved kind) 6u32) (call is_record_type actual)))
				(then (return (call plan_fixed_slice_loan (borrow-shared nodes) reference index statement
					expected actual resolved (struct.get resolved projection)
					(borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))
			(let owner (call is_array_owner actual))
			(let scoped (bool.and (u32.eq (struct.get resolved kind) 6u32) (call is_readable_slice actual)))
			(let-mut kind 2u32)
			(let-mut type expected)
			(if
				(:doc "A byte reborrow uses its adjacent descriptor type code.")
				reborrow
				(then
					(set kind expected)
					(set type (u32.dec expected))))
			(if
				(:doc "Use the exact formal descriptor for a whole typed slice loan.")
				(call is_typed_slice expected)
				(then (set kind (call call_loan_keyword expected))))
			(if
				(:doc "A read projects the receiver to shared access and retains its element type.")
				(u32.eq expected 55u32)
				(then
					(set type 34u32)
					(if
						(:doc "Keep the exact element type when projecting from either access mode.")
						(call is_typed_slice actual)
						(then (set type (call typed_slice_type (call slice_element_code actual) (bool false)))))))
			(if
				(:doc "A store through an existing view keeps its writable descriptor.")
				(u32.eq expected 56u32)
				(then (set type actual)))
			(if
				(:doc "Direct owner accesses preserve the exact element type and descriptor permission.")
				(bool.and owner
					(bool.or (u32.eq expected 55u32) (u32.eq expected 56u32)))
				(then
					(set type (call owner_view_type actual (u32.eq expected 56u32)))
					(set kind 35u32)
					(if (call is_writable_slice type) (then (set kind 39u32)))))
			(let local_source (bool.or owner scoped))
			(let-mut extent -1i32)
			(if
				(:doc "A named view already contains a descriptor. A shared reborrow can project it.")
				scoped
				(then
					(set kind local_slice_view)
					(if
						(:doc "Only a shared use of a mutable view needs a descriptor conversion.")
						(bool.and (call is_writable_slice actual) (bool.not (call is_writable_slice type)))
						(then (set kind local_slice_projection)))
					(let initializer (call binding_initializer (borrow-shared nodes) (borrow-shared statements)
						target index))
					(if
						(:doc "An unwrap or a reborrow of an exact local view keeps the established extent.")
						(i32.not-ltz initializer)
						(then
							(let value (array.load expressions initializer))
							(let origin_kind (struct.get value kind))
							(if
								(:doc "Only these checked view rows store a known length in asset_end.")
								(bool.or (u32.eq origin_kind optional_view_unwrap) (call is_local_slice_view origin_kind))
								(then (set extent (struct.get value asset_end))))))))
			(if
				(:doc "Earlier operands and scoped declarations can retain a loan of the source.")
				(bool.and (bool.or local_source (call is_writable_slice actual))
					(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions) (borrow-shared statements)
						index statement target local_source -1i32 (call is_writable_slice type)))
				(then (return (call entry_at reference -1i32 24u32))))
			(array.store expressions index
				(struct.new ScalarExpression (kind kind) (type type) (target target)
					(first -1i32) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner local_source)
					(mutable_place (bool false)) (projection -1i32) (asset_start 0i32) (asset_end extent) (extent_check -1i32)))
			(return checked)))

	(fn plan_range_borrow
		(:doc `Plan a numeric range loan with an evaluated view and two exact i32 endpoints.

		The wrapper keeps the original loan identity for later arguments.
		The child projection checks bounds after its operands have run.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (loan SourceNode)
			(index i32) (projection i32) (caller ScalarFunction) (statement i32) (expectation u32) (view_start i32)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let node (array.load nodes projection))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node 44u32 24u32))
			(if
				(:doc "Keep the range's own metadata and form diagnostic.")
				(u32.gtz (struct.get form error))
				(then (return form)))
			(let receiver (struct.get form operand))
			(if
				(:doc "Every range has a named source followed by its bounds.")
				(i32.ltz receiver)
				(then (return (call entry_at node -1i32 24u32))))
			(let reference (array.load nodes receiver))
			(let start (struct.get reference next_sibling))
			(if
				(:doc "A range requires its start before an end can follow.")
				(i32.ltz start)
				(then (return (call entry_at node -1i32 24u32))))
			(let end (struct.get (array.load nodes start) next_sibling))
			(if
				(:doc "The range takes exactly two endpoints.")
				(bool.or (i32.ltz end)
					(i32.not-ltz (struct.get (array.load nodes end) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(let checked (call plan_named_view (borrow-shared source) (borrow-shared nodes)
				loan reference receiver caller statement expectation (bool true)
				(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))
			(if
				(:doc "Resolve and check the source before its endpoint expressions.")
				(u32.gtz (struct.get checked error))
				(then (return checked)))
			(let origin (array.load expressions receiver))
			(let type (struct.get origin type))
			(let element (call slice_element_type (borrow-shared records) type))
			(if
				(:doc "The projected descriptor must lend numeric elements with their exact stride.")
				(bool.not (bool.or (call is_builtin_numeric element) (call is_native_integer element)))
				(then (return (call entry_at reference -1i32 24u32))))
			(let-mut target (struct.get origin target))
			(if
				(:doc "A static source cannot conflict with a loan of a local or formal parameter.")
				(u32.eq (struct.get origin kind) 62u32)
				(then (set target -1i32)))
			(array.store expressions index
				(struct.new ScalarExpression (kind 45u32) (type type) (target target)
					(first projection) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (struct.get origin borrowed_owner)) (mutable_place (bool false)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(array.store expressions projection
				(call runtime_expression 44u32 type node receiver caller view_start))
			(let expected (call expression_row 0u32 5u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(array.store expressions start expected)
			(array.store expressions end expected)
			(return (call entry_at loan index 0u32))))

	(fn plan_owner_operation
		(:doc `Check a null test or an explicit consuming call transfer of a native owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (caller ScalarFunction) (statement i32) (expected u32) (view_start i32)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let consume (call is_native_owner expected))
			(let-mut tag (call owner_is_null_kind))
			(if consume (then (set tag 43u32)))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node tag 24u32))
			(if (u32.gtz (struct.get form error)) (then (return form)))
			(let reference_index (struct.get form operand))
			(if
				(:doc "Both operations take one named owner or field projection.")
				(bool.or (i32.ltz reference_index)
					(i32.lt -1i32 (struct.get (array.load nodes reference_index) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
