				(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))
			(if
				(:doc "A transfer remains related context for a borrow of a moved owner.")
				(u32.gtz (struct.get checked error))
				(then (return (call at_owner_use checked node))))
			(let resolved (array.load expressions reference_index))
			(let implicit (i32.eq index reference_index))
			(if
				(:doc "Only an existing foreign reference may be passed directly. Its defining resource must match.")
				(bool.or (u32.not-eq expected (struct.get resolved type))
					(bool.and implicit (u32.not-eq (struct.get resolved kind) c_value_expression)))
				(then (return (call entry_at node -1i32 24u32))))
			(let exclusive (call is_c_exclusive_owner_mode mode))
			(let local_owner (u32.eq (struct.get resolved kind) 6u32))
			(if
				(:doc "A read-only slot loan requires an explicit original owner place.")
				(bool.and (u8.eq mode c_shared_handle_slot_mode)
					(bool.or implicit (bool.not local_owner)))
				(then (return (call entry_at node -1i32 24u32))))
			(if
				(:doc "Initialized and ordinary mutable loans both require original writable ownership.")
				(bool.and exclusive (bool.not (bool.and local_owner (struct.get resolved mutable_place))))
				(then (return (call entry_at node -1i32 24u32))))
			(if
				(:doc "Do not borrow an owner whose storage overlaps an earlier exclusive access.")
				(bool.and local_owner
					(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions) (borrow-shared statements)
						index statement (struct.get resolved target) (bool true) -1i32 exclusive))
				(then (return (call entry_at node -1i32 24u32))))
			(if
