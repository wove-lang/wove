	(fn
		(:doc `Check the scalar expression at a source row and keep its actual type.`)
		plan_expression
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction)
			(index i32) (expected u32) (statement i32) (functions (shared-slice ScalarFunction))
			(parameters (shared-slice ScalarParameter)) (bindings (shared-slice GraphBinding))
			(statements (shared-slice ScalarStatement)) (expressions (mut-slice ScalarExpression)) (view_start i32))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local index)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
			(let operator (call scalar_operator (local tag)))
