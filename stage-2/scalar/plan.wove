		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (caller ScalarFunction)
			(root i32) (expected u32) (statement i32) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord))
