	(fn
		(:doc `Resolve a read to a checked binding and retain its defining name or parameter row.`)
		plan_local
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode)
			(operand i32) (expected u32) (index i32) (caller ScalarFunction) (statement i32)
			(parameters (shared-slice ScalarParameter)) (statements (shared-slice ScalarStatement))
			(expressions (mut-slice ScalarExpression)))
