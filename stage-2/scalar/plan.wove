								(:doc "A slice applies the declared access mode to its exact native element.")
								native_view
								(then (set type (call typed_slice_type target
									(u32.eq (struct.get view access) 38u32)))))))

					(let name_node (array.load nodes name))
					(let existing (call find_parameter (borrow-shared source) (borrow-shared nodes)
						name_node (borrow-shared parameters) start written))
