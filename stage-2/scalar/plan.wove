	(fn plan_handle_borrow
		(:doc `Borrow the exact resource and record whether the original place is held exclusively.

		Keep the evaluated owner or foreign pointer as the loan operand. The loan
		span identifies missing or incorrectly initialized native storage.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (reference_index i32) (caller ScalarFunction) (statement i32) (expected u32) (mode u8) (view_start i32)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
