				(:doc "A mutable byte view can also be read through a shared projection.")
				(u32.eq (local expected) 34u32)
				(then (return (call is_byte_view_type (local actual)))))
			(if
				(:doc "An access can infer the element type from any readable view.")
				(u32.eq (local expected) 55u32)
				(then (return (call is_readable_slice (local actual)))))
			(if
				(:doc "A store can infer the element type only from an exclusive view.")
				(u32.eq (local expected) 56u32)
				(then (return (call is_writable_slice (local actual)))))
			(if
				(:doc "A mutable typed slice can satisfy a shared formal of the same element type.")
				(bool.and (bool.and (call is_typed_slice (local expected)) (call is_typed_slice (local actual)))
					(bool.and (bool.not (call is_writable_slice (local expected))) (call is_writable_slice (local actual))))
