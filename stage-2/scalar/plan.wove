										(:doc "Pointer owners keep their defining declaration. Aliases and records keep a type-table row.")
										(i32.lt -1i32 (struct.get handle drop_start))
										(then (set target (call native_owner_type declaration)))
										(else
											(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
												(array.load nodes declaration)))
											(let row (call find_native_node (borrow-shared records) (struct.get parts operands)))
											(if
												(:doc "Each checked unowned declaration must have a registered type row.")
												(i32.ltz row)
												(then (return (call entry_at type_node -1i32 23u32))))
											(set target (call native_row_type (borrow-shared records) row))))))
							(set type target)
							(if
								(:doc "A by-value pointer owner consumes. A shared pointer owner keeps its existing ABI.")
								(call is_native_owner target)
								(then
									(if
										(:doc "Storage owners pass the address of their object with the selected access.")
										(call is_c_storage_type (borrow-shared source) (borrow-shared nodes) declaration)
										(then (set mode (call storage_argument_mode reference)))
										(else
											(if
												(:doc "A bare pointer handle transfers ownership and a mutable reference lends it exclusively.")
												(u32.eqz reference)
												(then (set mode (call c_consume_mode)))
												(else
