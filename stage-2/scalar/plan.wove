						(local target) (record.get (local form) operand)))
					(if
						(:doc "Preserve errors at the target operand.")
						(u32.lt (u32 0) (record.get (local named) error))
						(then (return (local named))))
					(set (local name_index) (record.get (local named) operand))))
			(let name (slice.load (local nodes) (local name_index)))
			(if
				(:doc "Declarations introduce bare local identifiers.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (call entry_at (local name) (i32 -1) (u32 34)))))
			(let binding (call find_local (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local statements))
				(record.get (local caller) first_statement) (local index) (local name)))
			(if
				(:doc "A known local is either a duplicate declaration or a possible assignment target.")
				(bool.not (i32.lt (local binding) (i32 0)))
				(then
