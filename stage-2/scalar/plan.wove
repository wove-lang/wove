(module scalar_plan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve selected scalar functions and calls before C emission.

	Collect signatures first, then check each body in source order against
	the function signatures and bindings visible at each statement. Track
	whether statements can reach their next sibling across scoped control flow.
	Function rows retain their original declaration and name nodes. Checked
	call rows keep the callee row independently of
	the name that will be used in C, and are indexed by original call node.
	Retain source-level call sites before either inspection or lowering.
	Array borrow inference uses expectation codes below defining record types.`)

	(use wove-file "../source/enum_forms.wove" (only (value enum_declaration) (value enum_constructor) (value enum_payload_constructor) (value match_statement)
		(value pending_match_value) (value match_case_gate)))
	(use wove-file "./locals.wove" (only find_local read_local_name))
	(use wove-file "./integer_literals.wove" (only plan_integer_value))
	(use wove-file "./matches.wove" (only plan_match_cases enter_case_owner match_continues seed_match_value seed_match_results finish_match_value find_match_binding))
	(use wove-file "./loops.wove" (only read_for_names read_iteration_source register_iteration_bindings is_iteration_statement enter_consuming_iteration))
	(use wove-file "../source/integer_compare.wove" (only is_explicit_integer_equality))
	(use wove-file "../source/integer_ops.wove" (only is_checked_integer_operator is_integer_division))
	(use wove-file "../source/integer_checks.wove" (only read_integer_check is_integer_check (value integer_fits) (type IntegerCheck)))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion integer_byte_width is_integer_byte_conversion
		is_integer_byte_encoder (value typed_integer_conversion) (value exact_byte_view)))
	(use wove-file "../text/character.wove" (only decode_character))
	(use wove-file "../source/extent.wove" (only normalized_extent))
	(use wove-file "../source/literals.wove" (only integer_atom))
	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token) (value character_token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/c_headers.wove" (only read_c_native_parameter))
	(use wove-file "../source/c_formals.wove" (only next_c_value_formal))
	(use wove-file "../source/c_owners.wove" (only is_c_storage_type))
	(use wove-file "../source/c_arguments.wove" (only read_c_view_type c_row_slice_type))
	(use wove-file "../emit/names.wove" (only module_identity function_identity))
	(use wove-file "../c/arguments.wove" (only c_value_mode c_consume_mode is_c_null_mode accepts_c_null c_null_argument_kind
		c_storage_shared_mode c_storage_mut_mode c_storage_init_mode c_storage_consume_mode c_handle_mut_mode is_c_exclusive_owner_mode
		is_c_storage_mode is_c_storage_init_mode is_c_handle_init_mode is_c_consuming_mode))
	(use wove-file "../source/target.wove" (only default_selection (type SelectionContext)))
	(use wove-file "../source/types.wove" (only void_type is_builtin_integer is_builtin_float is_builtin_numeric is_builtin_scalar builtin_type_keyword reference_mode (value f128_type) (value worker_receipt_type) (value worker_queue_type)))
	(use wove-file "../source/float_ops.wove" (only float_literal_shape is_float_conversion (value float_literal)))
	(use wove-file "./specializations.wove" (only register_module_specializations))
	(use wove-file "../source/generics.wove" (only has_specialization_head generic_i32_value is_checked_constant_operand
		(value normalized_i32_literal) (value checked_i32_operand) (value checked_function_operand) (value checked_bool_operand)))
	(use wove-file "./records.wove"
		(only scope_at is_generic_template is_callable_type callable_index callable_layout_shape declaration_kind register_module_records register_module_record_arrays register_owned_rows order_record_layouts value_type copyable_type is_owning_record is_scoped_record read_parameter_type read_view_parameter_extent find_record record_type record_index is_record_type
			find_member member_value_type read_member_operand register_static_array find_fixed_array_type fixed_array_type named_extent_site is_fixed_array is_enum_layout is_payload_enum is_typed_slice is_fixed_scalar_slice typed_slice_type typed_slice_element_code encode_place_type slice_element_code slice_element_type is_readable_slice is_writable_slice
			is_array_owner array_owner_type owning_array_type array_owner_element array_slot_code read_owned_array_type byte_rows_owner_type is_native_integer native_integer_type find_native_node (type ScalarRecord)
			is_native_record native_field_type is_place_reference is_mutable_place_reference place_reference_type place_reference_code place_reference_target mutable_scalar_target record_receiver_type place_borrow_kind))
	(use wove-file "./host_entry.wove" (only is_arg_span_slice))
	(use wove-file "./callable_types.wove" (only callable_parameter_type))
	(use wove-file "./function_rows.wove" (only checked_function_count resolve_call_target find_function_instance
		(type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./function_refs.wove" (only register_function_references plan_function_reference))
	(use wove-file "./value_types.wove" (only value_matches_type (value static_number)))
	(use wove-file "./signatures.wove" (only read_signature_head complete_signature (type ScalarSignature)))
	(use wove-file "./owners.wove" (only is_local_owner is_lexical_owner is_worker_owner owned_array_take_kind owned_field_loan_kind owned_aggregate_take_kind is_native_owner native_owner_type native_handle_borrow_kind owner_is_null_kind native_handle_consume_kind
			native_storage_init_borrow_kind native_storage_mut_borrow_kind native_handle_init_borrow_kind native_owner_declaration
			is_optional_byte_owner_type optional_unwrap_kind (value worker_receipt_move_kind)))
	(use wove-file "./loans.wove" (only has_conflicting_loan has_scoped_array_loan field_place_root expression_row mutable_parameter_place (value indirect_local_place) (value local_slice_view) (value local_slice_projection) (value scoped_field_loan) (type ScalarExpression)))
	(use wove-file "./flow.wove" (only block_statement pending_statement statement_exit_state moved_owner after_block is_loop is_loop_exit is_c_value_binding is_iteration_binding is_writable_local (type ScalarStatement)
			(value c_writable_binding) (value c_value_expression) (value c_vector_snapshot_expression) (value c_value_assignment) (value c_handle_reference)
			(value fixed_shared_loan) (value fixed_mut_loan) (value field_assignment) (value parameter_assignment) (value case_payload_binding)
			(value next_path) (value break_path) (value continue_path) (value break_statement) (value for_statement) (value for_source_owner) (value for_mut_binding) (value for_element_assignment)))
	(use wove-file "./conditional.wove" (only plan_conditional finish_conditional_value conditional_transfer_reaches is_pending_value
		(value conditional_value) (value pending_conditional) (value pending_field_read) (value pending_array_read)))
	(use wove-file "./control.wove" (only plan_control_blocks enclosing_loop sequence_paths predicate_literal control_paths native_transfer_paths prior_owner_take has_path repeats_loop consumption_on_back_edge))
	(use wove-file "../source/array_growth.wove" (only is_array_growth is_array_growth_statement
		(value array_capacity_kind) (value array_push_kind) (value array_remove_kind) (value array_try_reserve_kind)))
	(use wove-file "../source/integer_bits.wove" (only word_count_type word_rotates))
	(use wove-file "./worker.wove" (only worker_arrays))
	(use wove-file "./syntax.wove"
		(only entry_keyword entry_at entry_form (value fn_ref_kind) (value indirect_call_kind) is_direct_call is_worker_launch (value worker_spawn_join_kind)
			(value worker_spawn_kind) (value worker_join_kind) (value worker_queue_kind) (value worker_push_kind) is_worker_collect read_statement scalar_type scalar_operator is_fixed_initializer
			is_byte_view_type is_reborrow_keyword is_scalar_name same_name native_alloc_kind is_native_owner_constructor (type ScalarOperator) (type FixedArrayShape) (type EntryRead) (type StatementRead)))

	(struct
		(:doc `A direct call links the two defining files and declaration rows.

		The span is half-open in the caller's original file. The file values
		come from the compilation's file table or the single-file caller.`)
		CallSite
		(fields (caller_file i32) (caller i32) (callee_file i32) (callee i32) (start i32) (end i32)))

	(struct FunctionScope
		(fields (file i32) (tree_base i32) (tree_limit i32) (source_base i32) (module_id u32) (entry_module bool) (mode u32)))
	(struct BodyPlan
		(fields (count i32) (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(let owned_parameter_binding 571u32)
	(let pending_row_move 106u32)
	(let pending_member_move 248u32)
	(let pending_exact_move 250u32)
	(let scoped_array_initializer 48u32)
	(let infer_shared_array 49u32)
	(let infer_mut_array 50u32)

	(fn owned_result_type
		(:doc "Resolve an owned parameter or result in the function's type namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope FunctionScope))
		(returns u32)
		(body
			(return (call read_owned_array_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)
				(borrow-shared (local records)) (borrow-shared (local bindings))
				(call scope_at (struct.get (local scope) file) (struct.get (local scope) source_base))))))

	(fn read_signature
		(:doc `Resolve a named function's result before completing its signature and body shape.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (first_field i32)
			(entry bool) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope FunctionScope))
		(returns ScalarSignature)
		(body
			(let head (call read_signature_head (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local first_field) (bool false)))
			(let-mut result 0u32)
			(if
				(:doc "Only a checked head contains a result type operand to resolve.")
				(u32.eqz (struct.get (local head) error))
				(then
					(let type_node (struct.get (local head) type_node))
					(set (local result) (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
						(local type_node)))
					(if
						(:doc "Resolve a void result, scalar, or named value layout.")
						(u32.not-eq (local result) (call void_type))
						(then (set (local result) (call value_type (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (borrow-shared (local bindings))
							(struct.get (local scope) file) (struct.get (local scope) source_base) (local type_node)))))
					(if
						(:doc "An owned descriptor identifies the result by its element type.")
						(u32.eqz (local result))
						(then (set (local result) (call owned_result_type (borrow-shared (local source)) (borrow-shared (local nodes))
							(array.load (local nodes) (local type_node)) (borrow-shared (local records))
							(borrow-shared (local bindings)) (local scope)))))
					(if
						(:doc "A scoped record needs a local binding whose lifetime contains its loans.")
						(call is_scoped_record (borrow-shared (local records)) (local result))
						(then (set (local result) 0u32)))
					(if
						(:doc "The C entry requires i32 in every compilation mode.")
						(bool.and (local entry) (u32.not-eq (local result) 5u32))
						(then (set (local result) 0u32)))))
			(return (call complete_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local head) (local result)))))

	(fn find_parameter
		(:doc `Look up a parameter within the owning function's contiguous parameter interval.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode)
			(parameters (shared-array ScalarParameter)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "Only parameters of this function participate in its local namespace.")
				(i32.lt (local cursor) (local end))
				(body
					(let item (array.load (local parameters) (local cursor)))
					(let node (array.load (local nodes) (struct.get (local item) name)))
					(if
						(:doc "Match the raw spelling before any C suffix transformation.")
						(call same_name (borrow-shared (local source)) (local node) (local name))
						(then (return (local cursor))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return -1i32)))

	(fn storage_argument_mode
		(:doc `Classify a validated native storage formal by its written access mode.`)
		(params (reference u32))
		(returns u8)
		(body
			(if
				(:doc "A shared formal lends the initialized object's read-only address.")
				(u32.eq (local reference) 1u32)
				(then (return (call c_storage_shared_mode))))
			(if
				(:doc "An ordinary mutable storage formal requires an active object.")
				(u32.eq (local reference) 2u32)
				(then (return (call c_storage_mut_mode))))
			(return (call c_storage_consume_mode))))

	(fn read_parameters
		(:doc `Check each parameter's unique spelling, metadata, and exact type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32)
			(parameters (mut-array ScalarParameter)) (start i32) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope FunctionScope) (bridge i32) (context SelectionContext))
		(returns EntryRead)
		(body
			(let native (i32.lt -1i32 (local bridge)))
			(let-mut index (local first))
			(if
				(:doc "A checked native signature omits fixed C operands from its Wove parameter table.")
				(local native)
				(then (set (local index) (call next_c_value_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))))
			(let-mut written (local start))
			(while
				(:doc "Keep formal parameter order and use one row for each checked parameter.")
				(i32.not-ltz (local index))
				(body
					(let node (array.load (local nodes) (local index)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let name (struct.get (local parts) head))
					(let operand (struct.get (local parts) operands))
					(if
						(:doc "A named parameter is a form with exactly one ordinary type operand.")
						(bool.or (bool.or (i32.ltz (local name)) (i32.ltz (local operand)))
							(i32.not-ltz (struct.get (array.load (local nodes) (local operand)) next_sibling)))
						(then (return (call entry_at (local node) -1i32 23u32))))
					(let selection (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local node) (local parts)))
					(if
						(:doc "Known selection directives belong at declaration scope.")
						(u32.gtz (struct.get (local selection) error))
						(then (return (struct.new EntryRead (operand -1i32)
							(start (struct.get (local selection) start)) (end (struct.get (local selection) end))
							(error (struct.get (local selection) error)) (related -1i32)))))
					(let checked (call read_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings))
						(struct.get (local scope) file) (struct.get (local scope) source_base) (local operand) (i32.ltz (local bridge))))
					(let type_node (array.load (local nodes) (local operand)))
					(let-mut owned 0u32)
					(if
						(:doc "Wove formals can take the same exact owned array types as Wove results.")
						(bool.and (bool.not (local native)) (u32.gtz (struct.get (local checked) error)))
						(then (set (local owned) (call owned_result_type (borrow-shared (local source)) (borrow-shared (local nodes))
							(local type_node) (borrow-shared (local records)) (borrow-shared (local bindings)) (local scope)))))
					(let view (call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
					(let view_element (struct.get (local view) element))
					(let native_view (bool.and (i32.lt -1i32 (local bridge))
						(bool.and (i32.lt -1i32 (local view_element))
							(bool.and (u32.eqz (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local view_element)))
								(u32.eqz (call c_row_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))))))
					(let native_alias (bool.and (i32.lt -1i32 (local bridge))
						(bool.and (u32.eq (struct.get (local type_node) kind) 1u32)
							(u32.eqz (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local operand))))))
					(let-mut type (local owned))
					(let-mut mode (call c_value_mode))
					(if
						(:doc "Native aliases in scalar and slice positions resolve in the defining bridge.")
						(bool.and (bool.or (u32.gtz (local owned)) (u32.eqz (struct.get (local checked) error)))
							(bool.not (bool.or (local native_alias) (local native_view))))
						(then
							(if
								(:doc "Only ordinary parameters take their type from the view or scalar reader.")
								(u32.eqz (local owned))
								(then (set (local type) (u32.from-i32 (struct.get (local checked) operand))))))
						(else
							(if
								(:doc "Only native signatures can access unimported types in the defining bridge.")
								(i32.ltz (local bridge))
								(then (return (local checked))))
							(let type_form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
							(let reference (call reference_mode (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local type_form) head)))
							(if
								(:doc "Keep ordinary parameter diagnostics unless the form names a native value, view, or reference.")
								(bool.not (bool.or (local native_view) (bool.or (u32.eq (struct.get (local type_node) kind) 1u32)
									(u32.gtz (local reference)))))
								(then (return (local checked))))
							(let handle (call read_c_native_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
								(local type_node) (local bridge) (local context)))
							(if
								(:doc "A rejected native type keeps the original signature span.")
								(u32.gtz (struct.get (local handle) error))
								(then (return (struct.new EntryRead (operand -1i32)
									(start (struct.get (local handle) start)) (end (struct.get (local handle) end))
									(error (struct.get (local handle) error)) (related -1i32)))))
							(let declaration (struct.get (local handle) declaration))
							(let-mut target 0u32)
							(if
								(:doc "A built-in mutable reference needs no defining type row.")
								(i32.ltz (local declaration))
								(then (set (local target) (call scalar_type (borrow-shared (local source))
									(borrow-shared (local nodes)) (struct.get (local type_form) operands))))
								(else
									(if
										(:doc "Pointer owners keep their defining declaration. Aliases and records keep a type-table row.")
										(i32.lt -1i32 (struct.get (local handle) drop_start))
										(then (set (local target) (call native_owner_type (local declaration))))
										(else
											(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
												(array.load (local nodes) (local declaration))))
											(let row (call find_native_node (borrow-shared (local records)) (struct.get (local parts) operands)))
											(if
												(:doc "Each checked unowned declaration must have a registered type row.")
												(i32.ltz (local row))
												(then (return (call entry_at (local type_node) -1i32 23u32))))
											(set (local target) (call native_integer_type (local row)))
											(if
												(:doc "A complete native record keeps its layout identity.")
												(call is_native_record (array.load (local records) (local row)))
												(then (set (local target) (call record_type (local row)))))))))
							(set (local type) (local target))
							(if
								(:doc "A by-value pointer owner consumes. A shared pointer owner keeps its existing ABI.")
								(call is_native_owner (local target))
								(then
									(if
										(:doc "Storage owners pass the address of their object with the selected access.")
										(call is_c_storage_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration))
										(then (set (local mode) (call storage_argument_mode (local reference))))
										(else
											(if
												(:doc "A bare pointer handle transfers ownership and a mutable reference lends it exclusively.")
												(u32.eqz (local reference))
												(then (set (local mode) (call c_consume_mode)))
												(else
													(if
														(:doc "A mutable reference retains the pointer ABI and requires an exclusive loan.")
														(u32.eq (local reference) 2u32)
														(then (set (local mode) (call c_handle_mut_mode)))))))))
								(else
									(if
										(:doc "A place reference retains its exact pointee and mutability.")
										(u32.gtz (local reference))
										(then (set (local type) (call place_reference_type (local target)
											(u32.eq (local reference) 2u32)))))))
							(if
								(:doc "A slice applies the declared access mode to its exact native element.")
								(local native_view)
								(then (set (local type) (call typed_slice_type (local target)
									(u32.eq (struct.get (local view) access) 38u32)))))))

					(let name_node (array.load (local nodes) (local name)))
					(let existing (call find_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
						(local name_node) (borrow-shared (local parameters)) (local start) (local written)))
					(if
						(:doc "The second occurrence of a name conflicts with its earlier parameter.")
						(i32.not-ltz (local existing))
						(then (return (call entry_at (local name_node) -1i32 33u32))))
					(let-mut extent -1i32)
					(if
						(:doc "Read the optional bound after the ordinary Wove slice type and element have checked.")
						(bool.and (bool.not (local native)) (call is_readable_slice (local type)))
						(then
							(let size (call read_view_parameter_extent (borrow-shared (local source)) (borrow-shared (local nodes))
								(local type_node) (borrow-shared (local bindings)) (struct.get (local scope) file) (struct.get (local scope) source_base)))
							(if (u32.gtz (struct.get (local size) error)) (then (return (local size))))
							(set (local extent) (struct.get (local size) operand))))
					(array.store (local parameters) (local written)
						(struct.new ScalarParameter (name (local name)) (type (local type))
							(position (i32.sub (local written) (local start))) (c_mode (local mode)) (c_size -1i32) (c_count -1i32) (extent (local extent))))
					(set (local written) (i32.inc (local written)))
					(set (local index) (struct.get (local node) next_sibling))
					(if
						(:doc "Advance across any consecutive native-only operands.")
						(local native)
						(then (set (local index) (call next_c_value_formal (borrow-shared (local source))
							(borrow-shared (local nodes)) (local index)))))))
			(return (struct.new EntryRead (operand (local written)) (start 0i32) (end 0i32) (error 0u32) (related -1i32)))))

	(fn register_function
		(:doc "Register an ordinary declaration with its own source row and emitted identity.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32) (scope FunctionScope)
			(functions (mut-array ScalarFunction)) (index i32) (parameters (mut-array ScalarParameter)) (next_param i32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))) (returns EntryRead)
		(body
			(return (call register_concrete_function (borrow-shared (local source)) (borrow-shared (local nodes))
				(local declaration) (local declaration) 0u32 (local scope)
				(borrow-mut (local functions)) (local index) (borrow-mut (local parameters)) (local next_param)
				(borrow-shared (local records)) (borrow-shared (local bindings))))))

	(fn register_concrete_function
		(:doc `Register one defining function and its parameters in the checked program tables.

