						(then (return (call body_error caller (struct.get node start)
							(struct.get node end) 24u32))))))
			(let-mut site_count site_start)
			(let-mut first_pending -1i32)
			(let-mut last_pending -1i32)
			(let end (struct.get (array.load nodes root) end))
			(array.store expressions root
				(call expression_row initial_kind expected
