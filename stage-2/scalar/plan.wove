(module scalar_plan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve selected scalar functions and calls before C emission.

	Collect signatures first, then check each body in source order against
	the function signatures and bindings visible at each statement. Track
	whether statements can reach their next sibling across scoped control flow.
	Function rows retain their original declaration and name nodes. Checked
	call rows keep the callee row independently of
	the name that will be used in C, and are indexed by original call node.
	Retain source-level call sites before either inspection or lowering.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/c_headers.wove" (only read_c_native_parameter))
	(use wove-file "../source/c_formals.wove" (only next_c_value_formal))
	(use wove-file "../source/c_owners.wove" (only is_c_storage_type))
	(use wove-file "../source/c_arguments.wove" (only read_c_view_type c_row_slice_type))
	(use wove-file "../emit/names.wove" (only module_identity function_identity))
	(use wove-file "../c/arguments.wove" (only c_value_mode c_consume_mode is_c_null_mode accepts_c_null c_null_argument_kind
		c_storage_shared_mode c_storage_mut_mode c_storage_init_mode c_storage_consume_mode
		is_c_storage_mode is_c_storage_init_mode is_c_consuming_mode))
	(use wove-file "../source/target.wove" (only default_selection (type SelectionContext)))
	(use wove-file "../source/types.wove" (only void_type is_builtin_integer builtin_type_keyword reference_mode))
	(use wove-file "../source/owned.wove" (only owned_element_node is_byte_owner_descriptor))
	(use wove-file "./records.wove"
		(only declaration_kind register_module_records order_record_layouts copyable_type read_parameter_type find_record record_type record_index is_record_type
			find_member member_value_type read_member_operand fixed_array_type is_fixed_array is_typed_slice is_fixed_scalar_slice typed_slice_type typed_slice_element_code encode_place_type slice_element_code slice_element_type is_readable_slice is_writable_slice
			is_array_owner array_owner_type array_owner_element byte_rows_owner_type is_native_integer native_integer_type find_native_node (type ScalarRecord)
			is_native_record native_field_type is_place_reference is_mutable_place_reference place_reference_type place_reference_code place_reference_target record_receiver_type place_borrow_kind))
	(use wove-file "./host_entry.wove" (only is_arg_span_slice))
	(use wove-file "./signatures.wove" (only read_signature_head complete_signature (type ScalarSignature)))
	(use wove-file "./owners.wove" (only is_local_owner is_native_owner native_owner_type native_handle_borrow_kind owner_is_null_kind native_handle_consume_kind
			native_storage_init_borrow_kind native_storage_mut_borrow_kind
			is_optional_byte_owner_type optional_unwrap_kind))
	(use wove-file "./loans.wove" (only has_conflicting_loan field_place_root (type ScalarExpression)))
	(use wove-file "./flow.wove" (only block_statement moved_owner after_block c_transfer_reaches is_c_value_binding (type ScalarStatement)
			(value c_writable_binding) (value c_value_expression) (value c_vector_snapshot_expression) (value c_value_assignment) (value c_handle_reference)
			(value fixed_shared_loan) (value fixed_mut_loan) (value field_assignment)))
	(use wove-file "./syntax.wove"
		(only entry_keyword entry_at entry_form read_statement scalar_type decimal_scalar decimal_suffix_start scalar_operator word_shift_type is_i32_division is_fixed_initializer is_fixed_access
			is_byte_view_type is_reborrow_keyword is_scalar_name same_name native_alloc_kind (type ScalarOperator) (type EntryRead) (type StatementRead)))

	(struct
		(:doc `A checked signature and its defining source identity.

		A negative body denotes a foreign declaration whose native name
		and declaration still refer to the source tree. A Wove body can be empty.
		The original C formals include native-only constants. A positive
		c_variadic names the first source row in the checked C tail.
		A C text snapshot releases the native string only when c_snapshot_drop is present.`)
		ScalarFunction
		(fields (declaration i32) (name i32) (params i32) (arity i32) (result u32)
			(first_statement i32) (identity u32) (entry bool) (c_strings i32) (c_vectors bool) (c_extents i32) (c_macro bool) (c_variadic i32) (c_nulls i32) (c_storage bool)
			(c_snapshot bool) (c_snapshot_drop i32) (c_formals i32) (c_fixed bool)
			(file i32) (tree_base i32) (tree_limit i32) (source_base i32) (body i32)))
	(struct ScalarParameter
		(fields (name i32) (type u32) (position i32) (c_mode u8) (c_size i32) (c_count i32)))
	(struct
		(:doc `A direct call links the two defining files and declaration rows.

		The span is half-open in the caller's original file. The file values
		come from the compilation's file table or the single-file caller.`)
		CallSite
		(fields (caller_file i32) (caller i32) (callee_file i32) (callee i32) (start i32) (end i32)))

	(struct FunctionScope
		(fields (file i32) (tree_base i32) (tree_limit i32) (source_base i32) (module_id u32) (entry_module bool) (mode u32)))
	(struct BodyPlan
		(fields (count i32) (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(let pending_row_move 106u32)

	(fn read_signature
		(:doc `Resolve a named function's result before completing its signature and body shape.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (first_field i32)
			(entry bool) (records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)) (scope FunctionScope))
		(returns ScalarSignature)
		(body
			(let bootstrap_entry (bool.and (local entry) (u32.eq (record.get (local scope) mode) 1u32)))
			(let head (call read_signature_head (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local first_field) (local bootstrap_entry)))
			(let-mut result 0u32)
			(if
				(:doc "Only a checked head contains a result type operand to resolve.")
				(u32.eq (record.get (local head) error) 0u32)
				(then
					(let type_node (record.get (local head) type_node))
					(set (local result) (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
						(local type_node)))
					(if
						(:doc "Helper results can be void or any in-scope copyable type.")
						(bool.not (u32.eq (local result) (call void_type)))
						(then (set (local result) (call copyable_type (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (borrow-shared (local bindings))
							(record.get (local scope) file) (record.get (local scope) source_base) (local type_node)))))
					(if
						(:doc "A Wove helper can return an owned byte array or an owned array of byte rows.")
						(u32.eq (local result) 0u32)
						(then
							(let type (slice.load (local nodes) (local type_node)))
							(let element (call owned_element_node (borrow-shared (local source)) (borrow-shared (local nodes)) (local type)))
							(if
								(:doc "An owner result retains the exact type of its single element.")
								(i32.lt -1i32 (local element))
								(then
									(let element_type (slice.load (local nodes) (local element)))
									(if
										(:doc "An exact byte owner can transfer through a Wove helper.")
										(u32.eq (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local element)) 10u32)
										(then (set (local result) (call array_owner_type 10u32)))
										(else
											(if
												(:doc "An owned row vector can transfer with all its rows.")
												(call is_byte_owner_descriptor (borrow-shared (local source)) (borrow-shared (local nodes)) (local element_type))
												(then (set (local result) (call byte_rows_owner_type))))))))))
					(if
						(:doc "The C entry requires i32 in every compilation mode.")
						(bool.and (local entry) (bool.not (u32.eq (local result) 5u32)))
						(then (set (local result) 0u32)))))
			(return (call complete_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local head) (local result)))))

	(fn find_parameter
		(:doc `Look up a parameter within the owning function's contiguous parameter interval.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (name SourceNode)
			(parameters (shared-slice ScalarParameter)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "Only parameters of this function participate in its local namespace.")
				(i32.lt (local cursor) (local end))
				(body
					(let item (slice.load (local parameters) (local cursor)))
					(let node (slice.load (local nodes) (record.get (local item) name)))
					(if
						(:doc "Match the raw spelling before any C suffix transformation.")
						(call same_name (borrow-shared (local source)) (local node) (local name))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(return -1i32)))

	(fn storage_argument_mode
		(:doc `Classify a validated native storage formal by its written access mode.`)
		(params (reference u32))
		(returns u8)
		(body
			(if
				(:doc "A shared formal lends the initialized object's read-only address.")
				(u32.eq (local reference) 1u32)
				(then (return (call c_storage_shared_mode))))
			(if
				(:doc "An ordinary mutable storage formal requires an active object.")
				(u32.eq (local reference) 2u32)
				(then (return (call c_storage_mut_mode))))
			(return (call c_storage_consume_mode))))

	(fn read_parameters
		(:doc `Check each parameter's unique spelling, metadata, and exact type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(parameters (mut-slice ScalarParameter)) (start i32) (records (shared-slice ScalarRecord))
			(bindings (shared-slice GraphBinding)) (scope FunctionScope) (bridge i32) (context SelectionContext))
		(returns EntryRead)
		(body
			(let native (i32.lt -1i32 (local bridge)))
			(let-mut index (local first))
			(if
				(:doc "A checked native signature omits fixed C operands from its Wove parameter table.")
				(local native)
				(then (set (local index) (call next_c_value_formal (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))))
			(let-mut written (local start))
			(while
				(:doc "Keep formal parameter order and use one row for each checked parameter.")
				(bool.not (i32.lt (local index) 0i32))
				(body
					(let node (slice.load (local nodes) (local index)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let name (record.get (local parts) head))
					(let operand (record.get (local parts) operands))
					(if
						(:doc "A named parameter is a form with exactly one ordinary type operand.")
						(bool.or (bool.or (i32.lt (local name) 0i32) (i32.lt (local operand) 0i32))
							(bool.not (i32.lt (record.get (slice.load (local nodes) (local operand)) next_sibling) 0i32)))
						(then (return (call entry_at (local node) -1i32 23u32))))
					(let selection (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local node) (local parts)))
					(if
						(:doc "Known selection directives belong at declaration scope.")
						(u32.lt 0u32 (record.get (local selection) error))
						(then (return (record.make EntryRead (operand -1i32)
							(start (record.get (local selection) start)) (end (record.get (local selection) end))
							(error (record.get (local selection) error)) (related -1i32)))))
					(let checked (call read_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings))
						(record.get (local scope) file) (record.get (local scope) source_base) (local operand) (i32.lt (local bridge) 0i32)))
					(let type_node (slice.load (local nodes) (local operand)))
					(let view (call read_c_view_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
					(let view_element (record.get (local view) element))
					(let native_view (bool.and (i32.lt -1i32 (local bridge))
						(bool.and (i32.lt -1i32 (local view_element))
							(bool.and (u32.eq (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local view_element)) 0u32)
								(u32.eq (call c_row_slice_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)) 0u32)))))
					(let native_alias (bool.and (i32.lt -1i32 (local bridge))
						(bool.and (u32.eq (record.get (local type_node) kind) 1u32)
							(u32.eq (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local operand)) 0u32))))
					(let-mut type 0u32)
					(let-mut mode (call c_value_mode))
					(if
						(:doc "Native aliases in scalar and slice positions resolve in the defining bridge.")
						(bool.and (u32.eq 0u32 (record.get (local checked) error))
							(bool.not (bool.or (local native_alias) (local native_view))))
						(then (set (local type) (int.convert u32 (record.get (local checked) operand))))
						(else
							(if
								(:doc "Only native signatures can access unimported types in the defining bridge.")
								(i32.lt (local bridge) 0i32)
								(then (return (local checked))))
							(let type_form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
							(let reference (call reference_mode (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local type_form) head)))
							(if
								(:doc "Keep ordinary parameter diagnostics unless the form names a native value, view, or reference.")
								(bool.not (bool.or (local native_view) (bool.or (u32.eq (record.get (local type_node) kind) 1u32)
									(u32.lt 0u32 (local reference)))))
								(then (return (local checked))))
							(let handle (call read_c_native_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
								(local type_node) (local bridge) (local context)))
							(if
								(:doc "A rejected native type keeps the original signature span.")
								(u32.lt 0u32 (record.get (local handle) error))
								(then (return (record.make EntryRead (operand -1i32)
									(start (record.get (local handle) start)) (end (record.get (local handle) end))
									(error (record.get (local handle) error)) (related -1i32)))))
							(let declaration (record.get (local handle) declaration))
							(let-mut target 0u32)
							(if
								(:doc "A built-in mutable reference needs no defining type row.")
								(i32.lt (local declaration) 0i32)
								(then (set (local target) (call scalar_type (borrow-shared (local source))
									(borrow-shared (local nodes)) (record.get (local type_form) operands))))
								(else
									(if
										(:doc "Pointer owners keep their defining declaration. Aliases and records keep a type-table row.")
										(i32.lt -1i32 (record.get (local handle) drop_start))
										(then (set (local target) (call native_owner_type (local declaration))))
										(else
											(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
												(slice.load (local nodes) (local declaration))))
											(let row (call find_native_node (borrow-shared (local records)) (record.get (local parts) operands)))
											(if
												(:doc "Each checked unowned declaration must have a registered type row.")
												(i32.lt (local row) 0i32)
												(then (return (call entry_at (local type_node) -1i32 23u32))))
											(set (local target) (call native_integer_type (local row)))
											(if
												(:doc "A complete native record keeps its layout identity.")
												(call is_native_record (slice.load (local records) (local row)))
												(then (set (local target) (call record_type (local row)))))))))
							(set (local type) (local target))
							(if
								(:doc "A by-value pointer owner consumes. A shared pointer owner keeps its existing ABI.")
								(call is_native_owner (local target))
								(then
									(if
										(:doc "Storage owners pass the address of their object with the selected access.")
										(call is_c_storage_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration))
										(then (set (local mode) (call storage_argument_mode (local reference))))
										(else
											(if
												(:doc "Only the bare pointer handle form transfers ownership.")
												(u32.eq (local reference) 0u32)
												(then (set (local mode) (call c_consume_mode)))))))
								(else
									(if
										(:doc "A place reference retains its exact pointee and mutability.")
										(u32.lt 0u32 (local reference))
										(then (set (local type) (call place_reference_type (local target)
											(u32.eq (local reference) 2u32)))))))
							(if
								(:doc "A slice applies the declared access mode to its exact native element.")
								(local native_view)
								(then (set (local type) (call typed_slice_type (local target)
									(u32.eq (record.get (local view) access) 38u32)))))))

					(let name_node (slice.load (local nodes) (local name)))
					(let existing (call find_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
						(local name_node) (borrow-shared (local parameters)) (local start) (local written)))
					(if
						(:doc "The second occurrence of a name conflicts with its earlier parameter.")
						(bool.not (i32.lt (local existing) 0i32))
						(then (return (call entry_at (local name_node) -1i32 33u32))))
					(slice.store (local parameters) (local written)
						(record.make ScalarParameter (name (local name)) (type (local type))
							(position (i32.sub.wrapping (local written) (local start))) (c_mode (local mode)) (c_size -1i32) (c_count -1i32)))
					(set (local written) (i32.add.wrapping (local written) 1i32))
					(set (local index) (record.get (local node) next_sibling))
					(if
						(:doc "Advance across any consecutive native-only operands.")
						(local native)
						(then (set (local index) (call next_c_value_formal (borrow-shared (local source))
							(borrow-shared (local nodes)) (local index)))))))
			(return (record.make EntryRead (operand (local written)) (start 0i32) (end 0i32) (error 0u32) (related -1i32)))))

	(fn find_function
		(:doc `Look up a checked function by a byte span from either the source or an inspection query.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (functions (shared-slice ScalarFunction))
			(spelling (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor 0i32)
			(while
				(:doc "The selected namespace is the populated function prefix.")
				(i32.lt (local cursor) (slice.len (local functions)))
				(body
					(let target (slice.load (local functions) (local cursor)))
					(let declared (slice.load (local nodes) (record.get (local target) name)))
					(if
						(:doc "C suffix sanitization has no role in source name resolution.")
						(call same_bytes (borrow-shared (local source)) (record.get (local declared) start)
							(record.get (local declared) end) (borrow-shared (local spelling)) (local start) (local end))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) 1i32))))
			(return -1i32)))

	(fn register_function
		(:doc `Register one defining function and its parameters in the checked program tables.

		Names and source spans address the supplied source view. Across files,
		the canonical file and tree base recover the original declaration row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32) (scope FunctionScope)
			(functions (mut-slice ScalarFunction)) (index i32) (parameters (mut-slice ScalarParameter)) (next_param i32)
			(records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local declaration)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let name (record.get (local parts) name))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
			(if
				(:doc "This translation unit accepts local functions as its selected declarations.")
				(bool.or (bool.not (u32.eq (local tag) 1u32)) (i32.lt (local name) 0i32))
				(then (return (call entry_at (local node) -1i32 22u32))))
			(let spelling (slice.load (local nodes) (local name)))
			(if
				(:doc "Function names use the checked Wove identifier alphabet.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local spelling)))
				(then (return (call entry_at (local spelling) -1i32 22u32))))
			(let identity (call function_identity (borrow-shared (local source))
				(record.get (local spelling) start) (record.get (local spelling) end) (record.get (local scope) module_id)))
			(let-mut previous 0i32)
			(while
				(:doc "Reject a stable hash collision even if readable suffixes differ.")
				(i32.lt (local previous) (local index))
				(body
					(let earlier (slice.load (local functions) (local previous)))
					(if
						(:doc "Equal IDs can come from a duplicate spelling or a collision between distinct names.")
						(u32.eq (local identity) (record.get (local earlier) identity))
						(then
							(let prior (slice.load (local nodes) (record.get (local earlier) name)))
							(if
								(:doc "A repeated name is a source-level binding conflict.")
								(bool.and (i32.eq (record.get (local scope) file) (record.get (local earlier) file))
								(call same_name (borrow-shared (local source)) (local spelling) (local prior)))
								(then (return (call entry_at (local spelling) -1i32 33u32))))
							(return (call entry_at (local spelling) -1i32 32u32))))
					(set (local previous) (i32.add.wrapping (local previous) 1i32))))
			(let entry (bool.and (record.get (local scope) entry_module)
				(u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local name)) 2u32)))
			(let signature (call read_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (record.get (local parts) operands) (local entry)
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope)))
			(if
				(:doc "A malformed signature keeps its originating span.")
				(u32.lt 0u32 (record.get (local signature) error))
				(then (return (record.make EntryRead (operand -1i32)
					(start (record.get (local signature) start)) (end (record.get (local signature) end))
					(error (record.get (local signature) error)) (related -1i32)))))
			(let checked (call read_parameters (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local signature) params) (borrow-mut (local parameters)) (local next_param)
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) -1i32
				(call default_selection (record.get (local scope) mode))))
			(if
				(:doc "Pass through the parameter list's first failure.")
				(u32.lt 0u32 (record.get (local checked) error))
				(then (return (local checked))))
			(let limit (record.get (local checked) operand))
			(let arity (i32.sub.wrapping (local limit) (local next_param)))
			(if
				(:doc "A native entry with parameters receives a shared byte arena and a shared span table.")
				(bool.and (bool.and (local entry) (i32.lt 0i32 (local arity)))
					(bool.or (bool.not (i32.eq (local arity) 2i32))
						(bool.or (bool.not (u32.eq (record.get (slice.load (local parameters) (local next_param)) type) 34u32))
							(bool.not (call is_arg_span_slice (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records))
