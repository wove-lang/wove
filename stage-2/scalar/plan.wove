(module scalar_plan
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve selected scalar functions and calls before C emission.

	Collect signatures first, then check each body in source order against
	the function signatures and bindings visible at each statement. Track
	whether statements can reach their next sibling across scoped control flow.
	Function rows retain their original declaration and name nodes. Checked
	call rows keep the callee row independently of
	the name that will be used in C, and are indexed by original call node.
	Retain source-level call sites before either inspection or lowering.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode) (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/c_headers.wove" (only c_reference_mode read_c_native_parameter))
	(use wove-file "../emit/names.wove" (only module_identity function_identity))
	(use wove-file "../c/arguments.wove" (only c_value_mode))
	(use wove-file "../source/target.wove" (only default_selection (type SelectionContext)))
	(use wove-file "../source/types.wove" (only void_type is_builtin_integer))
	(use wove-file "./records.wove"
		(only declaration_kind register_module_records copyable_type read_parameter_type find_record record_type record_index is_record_type
			find_member read_member_operand fixed_array_type is_fixed_array is_record_slice record_slice_type record_slice_element is_readable_slice is_writable_slice
			is_array_owner array_owner_type array_owner_element is_native_integer native_integer_type find_native_definition (type ScalarRecord)
			is_native_record native_field_type is_record_reference is_mutable_record_reference record_reference_type record_reference_target native_record_borrow_kind))
	(use wove-file "./host_entry.wove" (only is_arg_span_slice))
	(use wove-file "./signatures.wove" (only read_signature_head is_owned_byte_result complete_signature (type ScalarSignature)))
	(use wove-file "./owners.wove" (only is_local_owner is_native_owner native_owner_type native_handle_borrow_kind))
	(use wove-file "./flow.wove" (only block_statement moved_owner after_block (type ScalarStatement)))
	(use wove-file "./syntax.wove"
		(only entry_keyword entry_at entry_form read_statement scalar_type decimal_scalar scalar_operator is_u32_shift is_fixed_initializer is_fixed_access
			is_byte_view_type is_reborrow_keyword is_scalar_name same_name (type ScalarOperator) (type EntryRead) (type StatementRead)))

	(struct
		(:doc `A checked signature and its defining source identity.

		A negative body denotes a foreign declaration whose native name
		and declaration still refer to the source tree. A Wove body can be empty.`)
		ScalarFunction
		(fields (declaration i32) (name i32) (params i32) (arity i32) (result u32)
			(first_statement i32) (identity u32) (entry bool) (c_strings i32) (c_bytes i32)
			(file i32) (tree_base i32) (tree_limit i32) (source_base i32) (body i32)))
	(struct ScalarParameter
		(fields (name i32) (type u32) (position i32) (c_mode u8) (c_size i32) (c_count i32)))
	(struct
		(:doc `A checked expression at its source row.

		Literals carry significant digit offsets in the arena. Conversions
		and checked runtime operations carry the original file identity
		in target and the half-open byte span in start and end. First
		points at the initial operand to evaluate. A reborrow's target
		is its defining parameter row or its source local's name row.
		A range reborrow links to the checked projection in its child.
		An embed carries its path token span until asset resolution replaces it
		with the byte range to emit. A module binding reference (62) names its
		defining name node. The same row at a declaration marks its storage used.`)
		ScalarExpression
		(fields (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool) (borrowed_owner bool)
			(asset_start i32) (asset_end i32)))

	(struct
		(:doc `A direct call links the two defining files and declaration rows.

		The span is half-open in the caller's original file. The file values
		come from the compilation's file table or the single-file caller.`)
		CallSite
		(fields (caller_file i32) (caller i32) (callee_file i32) (callee i32) (start i32) (end i32)))

	(struct FunctionScope
		(fields (file i32) (tree_base i32) (tree_limit i32) (source_base i32) (module_id u32) (entry_module bool) (mode u32)))
	(struct BodyPlan
		(fields (count i32) (file i32) (start i32) (end i32) (error u32) (related_start i32) (related_end i32)))

	(fn read_signature
		(:doc `Resolve a named function's result before completing its signature and body shape.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (params i32)
			(entry bool) (records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)) (scope FunctionScope))
		(returns ScalarSignature)
		(body
			(let bootstrap_entry (bool.and (local entry) (u32.eq (record.get (local scope) mode) (u32 1))))
			(let head (call read_signature_head (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local params) (local bootstrap_entry)))
			(let-mut result (u32 0))
			(if
				(:doc "Only a checked head contains a result type operand to resolve.")
				(u32.eq (record.get (local head) error) (u32 0))
				(then
					(let type_node (record.get (local head) type_node))
					(set (local result) (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
						(local type_node)))
					(if
						(:doc "Helper results can be void or any in-scope copyable type.")
						(bool.not (u32.eq (local result) (call void_type)))
						(then (set (local result) (call copyable_type (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (borrow-shared (local bindings))
							(record.get (local scope) file) (record.get (local scope) source_base) (local type_node)))))
					(if
						(:doc "A Wove helper can return ownership of a byte array.")
						(bool.and (u32.eq (local result) (u32 0))
							(call is_owned_byte_result (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
						(then (set (local result) (call array_owner_type (u32 10)))))
					(if
						(:doc "The C entry requires i32 in every compilation mode.")
						(bool.and (local entry) (bool.not (u32.eq (local result) (u32 5))))
						(then (set (local result) (u32 0))))))
			(return (call complete_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local head) (local result)))))

	(fn find_parameter
		(:doc `Look up a parameter within the owning function's contiguous parameter interval.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (name SourceNode)
			(parameters (shared-slice ScalarParameter)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (local start))
			(while
				(:doc "Only parameters of this function participate in its local namespace.")
				(i32.lt (local cursor) (local end))
				(body
					(let item (slice.load (local parameters) (local cursor)))
					(let node (slice.load (local nodes) (record.get (local item) name)))
					(if
						(:doc "Match the raw spelling before any C suffix transformation.")
						(call same_name (borrow-shared (local source)) (local node) (local name))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (i32 -1))))

	(fn read_parameters
		(:doc `Check each parameter's unique spelling, metadata, and exact type.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32)
			(parameters (mut-slice ScalarParameter)) (start i32) (records (shared-slice ScalarRecord))
			(bindings (shared-slice GraphBinding)) (scope FunctionScope) (bridge i32) (context SelectionContext))
		(returns EntryRead)
		(body
			(let-mut index (local first))
			(let-mut written (local start))
			(while
				(:doc "Keep formal parameter order and use one row for each checked parameter.")
				(bool.not (i32.lt (local index) (i32 0)))
				(body
					(let node (slice.load (local nodes) (local index)))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
					(let name (record.get (local parts) head))
					(let operand (record.get (local parts) operands))
					(if
						(:doc "A named parameter is a form with exactly one ordinary type operand.")
						(bool.or (bool.or (i32.lt (local name) (i32 0)) (i32.lt (local operand) (i32 0)))
							(bool.not (i32.lt (record.get (slice.load (local nodes) (local operand)) next_sibling) (i32 0))))
						(then (return (call entry_at (local node) (i32 -1) (u32 23)))))
					(let selection (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
						(local node) (local parts)))
					(if
						(:doc "Known selection directives belong at declaration scope.")
						(u32.lt (u32 0) (record.get (local selection) error))
						(then (return (record.make EntryRead (operand (i32 -1))
							(start (record.get (local selection) start)) (end (record.get (local selection) end))
							(error (record.get (local selection) error)) (related (i32 -1))))))
					(let checked (call read_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings))
						(record.get (local scope) file) (record.get (local scope) source_base) (local operand)))
					(let type_node (slice.load (local nodes) (local operand)))
					(let native_alias (bool.and (i32.lt (i32 -1) (local bridge))
						(bool.and (u32.eq (record.get (local type_node) kind) (u32 1))
							(u32.eq (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local operand)) (u32 0)))))
					(let-mut type (u32 0))
					(if
						(:doc "A bare name in a native signature belongs to its defining bridge.")
						(bool.and (u32.eq (u32 0) (record.get (local checked) error)) (bool.not (local native_alias)))
						(then (set (local type) (int.convert u32 (record.get (local checked) operand))))
						(else
							(if
								(:doc "Only native signatures can access unimported types in the defining bridge.")
								(i32.lt (local bridge) (i32 0))
								(then (return (local checked))))
							(let type_form (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
							(let reference (call c_reference_mode (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local type_form) head)))
							(if
								(:doc "Keep ordinary parameter diagnostics unless the form names a native alias or reference.")
								(bool.not (bool.or (u32.eq (record.get (local type_node) kind) (u32 1))
									(u32.lt (u32 0) (local reference))))
								(then (return (local checked))))
							(let handle (call read_c_native_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
								(local type_node) (local bridge) (local context)))
							(if
								(:doc "A rejected native type keeps the original signature span.")
								(u32.lt (u32 0) (record.get (local handle) error))
								(then (return (record.make EntryRead (operand (i32 -1))
									(start (record.get (local handle) start)) (end (record.get (local handle) end))
									(error (record.get (local handle) error)) (related (i32 -1))))))
							(let declaration (record.get (local handle) declaration))
							(if
								(:doc "A value alias uses the type-table identity of its defining member.")
								(i32.lt (record.get (local handle) drop_start) (i32 0))
								(then
									(let row (call find_native_definition (borrow-shared (local records)) (record.get (local scope) file)
										(i32.sub.wrapping (local declaration) (record.get (local scope) tree_base))))
									(if (i32.lt (local row) (i32 0))
										(then (return (call entry_at (local type_node) (i32 -1) (u32 23)))))
									(if
										(:doc "Record formals are pointers to the exact native layout, qualified by access mode.")
										(u32.lt (u32 0) (local reference))
										(then (set (local type) (call record_reference_type (call record_type (local row))
											(u32.eq (local reference) (u32 2)))))
										(else (set (local type) (call native_integer_type (local row))))))
								(else (set (local type) (call native_owner_type (local declaration)))))))

					(let name_node (slice.load (local nodes) (local name)))
					(let existing (call find_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
						(local name_node) (borrow-shared (local parameters)) (local start) (local written)))
					(if
						(:doc "The second occurrence of a name conflicts with its earlier parameter.")
						(bool.not (i32.lt (local existing) (i32 0)))
						(then (return (call entry_at (local name_node) (i32 -1) (u32 33)))))
					(slice.store (local parameters) (local written)
						(record.make ScalarParameter (name (local name)) (type (local type))
							(position (i32.sub.wrapping (local written) (local start))) (c_mode (call c_value_mode)) (c_size (i32 -1)) (c_count (i32 -1))))
					(set (local written) (i32.add.wrapping (local written) (i32 1)))
					(set (local index) (record.get (local node) next_sibling))))
			(return (record.make EntryRead (operand (local written)) (start (i32 0)) (end (i32 0)) (error (u32 0)) (related (i32 -1))))))

	(fn find_function
		(:doc `Look up a checked function by a byte span from either the source or an inspection query.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (functions (shared-slice ScalarFunction))
			(spelling (shared-slice u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor (i32 0))
			(while
				(:doc "The selected namespace is the populated function prefix.")
				(i32.lt (local cursor) (slice.len (local functions)))
				(body
					(let target (slice.load (local functions) (local cursor)))
					(let declared (slice.load (local nodes) (record.get (local target) name)))
					(if
						(:doc "C suffix sanitization has no role in source name resolution.")
						(call same_bytes (borrow-shared (local source)) (record.get (local declared) start)
							(record.get (local declared) end) (borrow-shared (local spelling)) (local start) (local end))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (i32 -1))))

	(fn register_function
		(:doc `Register one defining function and its parameters in the checked program tables.

		Names and source spans address the supplied source view. Across files,
		the canonical file and tree base recover the original declaration row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32) (scope FunctionScope)
			(functions (mut-slice ScalarFunction)) (index i32) (parameters (mut-slice ScalarParameter)) (next_param i32)
			(records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local declaration)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let name (record.get (local parts) name))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
			(if
				(:doc "This translation unit accepts local functions as its selected declarations.")
				(bool.or (bool.not (u32.eq (local tag) (u32 1))) (i32.lt (local name) (i32 0)))
				(then (return (call entry_at (local node) (i32 -1) (u32 22)))))
			(let spelling (slice.load (local nodes) (local name)))
			(if
				(:doc "Function names use the checked Wove identifier alphabet.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local spelling)))
				(then (return (call entry_at (local spelling) (i32 -1) (u32 22)))))
			(let identity (call function_identity (borrow-shared (local source))
				(record.get (local spelling) start) (record.get (local spelling) end) (record.get (local scope) module_id)))
			(let-mut previous (i32 0))
			(while
				(:doc "Reject a stable hash collision even if readable suffixes differ.")
				(i32.lt (local previous) (local index))
				(body
					(let earlier (slice.load (local functions) (local previous)))
					(if
						(:doc "Equal IDs can come from a duplicate spelling or a collision between distinct names.")
						(u32.eq (local identity) (record.get (local earlier) identity))
						(then
							(let prior (slice.load (local nodes) (record.get (local earlier) name)))
							(if
								(:doc "A repeated name is a source-level binding conflict.")
								(bool.and (i32.eq (record.get (local scope) file) (record.get (local earlier) file))
								(call same_name (borrow-shared (local source)) (local spelling) (local prior)))
								(then (return (call entry_at (local spelling) (i32 -1) (u32 33)))))
							(return (call entry_at (local spelling) (i32 -1) (u32 32)))))
					(set (local previous) (i32.add.wrapping (local previous) (i32 1)))))
			(let entry (bool.and (record.get (local scope) entry_module)
				(u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local name)) (u32 2))))
			(let signature (call read_signature (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (record.get (local parts) operands) (local entry)
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope)))
			(if
				(:doc "A malformed signature keeps its originating span.")
				(u32.lt (u32 0) (record.get (local signature) error))
				(then (return (record.make EntryRead (operand (i32 -1))
					(start (record.get (local signature) start)) (end (record.get (local signature) end))
					(error (record.get (local signature) error)) (related (i32 -1))))))
			(let checked (call read_parameters (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local signature) params) (borrow-mut (local parameters)) (local next_param)
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (i32 -1)
				(call default_selection (record.get (local scope) mode))))
			(if
				(:doc "Pass through the parameter list's first failure.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (local checked))))
			(let limit (record.get (local checked) operand))
			(let arity (i32.sub.wrapping (local limit) (local next_param)))
			(if
				(:doc "A native entry with parameters receives a shared byte arena and a shared span table.")
				(bool.and (bool.and (local entry) (i32.lt (i32 0) (local arity)))
					(bool.or (bool.not (i32.eq (local arity) (i32 2)))
						(bool.or (bool.not (u32.eq (record.get (slice.load (local parameters) (local next_param)) type) (u32 34)))
							(bool.not (call is_arg_span_slice (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records))
								(record.get (slice.load (local parameters) (i32.add.wrapping (local next_param) (i32 1))) type))))))
				(then (return (call entry_at (slice.load (local nodes) (record.get (local parts) operands)) (i32 -1) (u32 23)))))
			(slice.store (local functions) (local index)
				(record.make ScalarFunction (declaration (local declaration)) (name (local name))
					(params (local next_param)) (arity (local arity))
					(result (record.get (local signature) result)) (first_statement (record.get (local signature) first_statement))
					(body (record.get (local signature) body))
					(identity (local identity)) (entry (local entry)) (c_strings (i32 0)) (c_bytes (i32 0))
					(file (record.get (local scope) file)) (tree_base (record.get (local scope) tree_base))
					(tree_limit (record.get (local scope) tree_limit)) (source_base (record.get (local scope) source_base))))
			(return (call entry_at (local node) (local limit) (u32 0)))))

	(fn read_module_declarations
		(:doc `Register selected functions and record layouts in their separate namespaces.

		Classify main as the ABI entry in an executable root. Library functions
		follow ordinary scalar signature and call rules, including main.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (module ModuleRead)
			(declarations (shared-slice SelectedDeclaration)) (functions (mut-slice ScalarFunction))
			(parameters (mut-slice ScalarParameter)) (records (mut-slice ScalarRecord))
			(bindings (shared-slice GraphBinding)) (file i32) (entry_module bool)
			(statements (mut-slice ScalarStatement)) (expressions (mut-slice ScalarExpression)))
		(returns EntryRead)
		(body
			(let module_name (slice.load (local nodes) (record.get (local module) name)))
			(let module_id (call module_identity (borrow-shared (local source))
				(record.get (local module_name) start) (record.get (local module_name) end)))
			(let scope (record.make FunctionScope (file (local file)) (tree_base (i32 0))
				(tree_limit (slice.len (local nodes))) (source_base (i32 0)) (module_id (local module_id))
				(entry_module (local entry_module)) (mode (record.get (local module) mode))))
			(let types (call register_module_records (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (record.get (local module) count) (i32 0)
				(local file) (local module_id) (borrow-mut (local records)) (i32 0)))
			(if
				(:doc "Register the full type namespace before reading forward signature references.")
				(u32.lt (u32 0) (record.get (local types) error))
				(then (return (local types))))
			(let values (call register_module_bindings (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local declarations)) (record.get (local module) count) (i32 0)
				(borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Validate even unused module initializers before planning function bodies.")
				(u32.lt (u32 0) (record.get (local values) error))
				(then (return (local values))))
			(let-mut index (i32 0))
			(let-mut next_function (i32 0))
			(let-mut next_param (i32 0))
			(let-mut main (i32 -1))
			(while
				(:doc "Read every selected definition before resolving bodies and forward references.")
				(i32.lt (local index) (record.get (local module) count))
				(body
					(let declaration (record.get (slice.load (local declarations) (local index)) node))
					(let kind (call declaration_kind (borrow-shared (local source)) (borrow-shared (local nodes)) (local declaration)))
					(if
						(:doc "Types and module bindings have already been registered.")
						(bool.not (bool.or (u32.eq (local kind) (u32 48)) (u32.eq (local kind) (u32 15))))
						(then
							(let registered (call register_function (borrow-shared (local source)) (borrow-shared (local nodes))
								(local declaration) (local scope) (borrow-mut (local functions)) (local next_function)
								(borrow-mut (local parameters)) (local next_param) (borrow-shared (local records))
								(borrow-shared (local bindings))))
							(if
								(:doc "Keep the rejected signature or declaration's original span.")
								(u32.lt (u32 0) (record.get (local registered) error))
								(then (return (local registered))))
							(let function (slice.load (local functions) (local next_function)))
							(if
								(:doc "Remember the selected C entry independently of declaration order.")
								(record.get (local function) entry)
								(then (set (local main) (local declaration))))
							(set (local next_param) (record.get (local registered) operand))
							(set (local next_function) (i32.add.wrapping (local next_function) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(if
				(:doc "The executable root must define the ABI entry even if it only declares types.")
				(bool.and (local entry_module) (i32.lt (local main) (i32 0)))
				(then
					(if
						(:doc "A type-only module has no first function to identify.")
						(i32.eq (local next_function) (i32 0))
						(then (return (call entry_at (local module_name) (i32 -1) (u32 22)))))
					(return (call entry_at
