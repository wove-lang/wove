							(borrow-shared nodes) index))))))
			(return (struct.new EntryRead (operand written) (start 0i32) (end 0i32) (error 0u32) (related -1i32)))))

	(fn register_function
		(:doc "Register an ordinary declaration with its own source row and emitted identity.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32) (scope FunctionScope)
			(functions (mut-array ScalarFunction)) (index i32) (parameters (mut-array ScalarParameter)) (next_param i32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))) (returns EntryRead)
		(body
			(return (call register_concrete_function (borrow-shared source) (borrow-shared nodes)
				declaration declaration 0u32 scope
				(borrow-mut functions) index (borrow-mut parameters) next_param
				(borrow-shared records) (borrow-shared bindings)))))

	(fn register_concrete_function
		(:doc `Register one defining function and its parameters in the checked program tables.

		Names and source spans address the supplied source view. Across files,
		the canonical file and tree base recover the original declaration row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32) (origin i32) (specialized_identity u32) (scope FunctionScope)
			(functions (mut-array ScalarFunction)) (index i32) (parameters (mut-array ScalarParameter)) (next_param i32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)))
		(returns EntryRead)
		(body
			(let node (array.load nodes declaration))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let name (struct.get parts name))
			(let tag (call entry_keyword (borrow-shared source) (borrow-shared nodes) (struct.get parts head)))
			(if
				(:doc "This translation unit accepts local functions as its selected declarations.")
				(bool.or (u32.not-eq tag 1u32) (i32.ltz name))
				(then (return (call entry_at node -1i32 22u32))))
			(let spelling (array.load nodes name))
			(if
				(:doc "Function names use the checked Wove identifier alphabet.")
				(bool.not (call is_scalar_name (borrow-shared source) spelling))
				(then (return (call entry_at spelling -1i32 22u32))))
			(let specialized (i32.not-eq declaration origin))
			(let-mut identity specialized_identity)
			(if
				(:doc "Ordinary functions use the defining name hash. Specializations already have a checked argument key.")
				(bool.not specialized)
				(then (set identity (call function_identity (borrow-shared source)
					(struct.get spelling start) (struct.get spelling end) (struct.get scope module_id)))))
			(let-mut previous 0i32)
			(while
				(:doc "Only ordinary declarations can introduce duplicate names in this file.")
				(bool.and (bool.not specialized) (i32.lt previous index))
				(body
					(let earlier (array.load functions previous))
					(if
						(:doc "Compare original spellings when the file and fingerprint match.")
						(bool.and (u32.eq identity (struct.get earlier identity))
							(i32.eq (struct.get scope file) (struct.get earlier file)))
						(then
							(let prior (array.load nodes (struct.get earlier name)))
							(if (call same_name (borrow-shared source) spelling prior)
								(then (return (call entry_at spelling -1i32 33u32))))))
					(set previous (i32.inc previous))))
			(let entry (bool.and (struct.get scope entry_module)
				(u32.eq (call entry_keyword (borrow-shared source) (borrow-shared nodes) name) 2u32)))
			(let signature (call read_signature (borrow-shared source) (borrow-shared nodes)
				node (struct.get parts operands) entry
				(borrow-shared records) (borrow-shared bindings) scope))
			(if
				(:doc "A malformed signature keeps its originating span.")
				(u32.gtz (struct.get signature error))
				(then (return (struct.new EntryRead (operand -1i32)
					(start (struct.get signature start)) (end (struct.get signature end))
					(error (struct.get signature error)) (related -1i32)))))
			(let checked (call read_parameters (borrow-shared source) (borrow-shared nodes)
				(struct.get signature params) (borrow-mut parameters) next_param
				(borrow-shared records) (borrow-shared bindings) scope -1i32
				(call default_selection (struct.get scope mode))))
			(if
				(:doc "Pass through the parameter list's first failure.")
				(u32.gtz (struct.get checked error))
				(then (return checked)))
			(let limit (struct.get checked operand))
			(let arity (i32.sub limit next_param))
			(let provenance (struct.get signature from))
			(let-mut return_source -1i32)
			(if
				(:doc "Resolve the loan contract to an exact parameter in this Wove signature.")
				(i32.not-ltz provenance)
				(then
					(let name (array.load nodes provenance))
					(set return_source (call find_parameter (borrow-shared source) (borrow-shared nodes)
						name (borrow-shared parameters) next_param limit))
					(if (i32.ltz return_source) (then (return (call entry_at name -1i32 23u32))))
					(let type (struct.get (array.load parameters return_source) type))
					(if
						(:doc "The source must supply a view and an exclusive result requires exclusive access.")
						(bool.or (bool.not (call is_readable_slice type))
							(bool.and (call is_writable_slice (struct.get signature result))
								(bool.not (call is_writable_slice type))))
						(then (return (call entry_at name -1i32 23u32))))))
			(if
				(:doc "Diagnose a parameterless application entry at the declaration.")
				(bool.and entry (i32.eqz arity))
				(then (return (call entry_at node -1i32 23u32))))
			(if
				(:doc "An application entry receives exactly one shared array of byte views.")
				(bool.and entry
					(bool.or (i32.not-eq arity 1i32)
						(u32.not-eq (struct.get (array.load parameters next_param) type)
							(call shared_byte_rows_type))))
				(then (return (call entry_at (array.load nodes (struct.get parts operands)) -1i32 23u32))))
			(array.store functions index
				(struct.new ScalarFunction (c_name_slot 0i32) (declaration declaration) (origin origin) (name name)
					(params next_param) (arity arity)
					(result (struct.get signature result)) (return_source return_source) (first_statement (struct.get signature first_statement))
					(body (struct.get signature body))
					(identity identity) (entry entry) (c_strings 0i32) (c_vectors (bool false)) (c_extents 0i32) (c_macro (bool false)) (c_variadic 0i32) (c_nulls 0i32) (c_storage (bool false)) (c_handle_out (bool false))
					(c_void_pointer (bool false)) (c_snapshot (bool false)) (c_snapshot_drop -1i32) (c_snapshot_field -1i32) (c_formals -1i32) (c_fixed (bool false))
					(file (struct.get scope file)) (tree_base (struct.get scope tree_base))
					(name_base (i32.add (struct.get scope tree_base) (i32.sub declaration origin)))
					(tree_limit (struct.get scope tree_limit)) (source_base (struct.get scope source_base))))
