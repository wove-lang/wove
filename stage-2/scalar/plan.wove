	(fn
		(:doc `Check a declaration name or identify the binding written by an assignment.

		Return the declaration's name node for let or let-mut and the checked
		statement row for set. Return, if, and while have no binding.`)
		check_statement_binding
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (caller ScalarFunction)
			(parameters (shared-slice ScalarParameter)) (statements (shared-slice ScalarStatement))
			(index i32) (statement StatementRead))
		(returns EntryRead)
