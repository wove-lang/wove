							node index index caller statement expected mode view_start
							(borrow-shared parameters) (borrow-shared records) (borrow-shared statements) (borrow-mut expressions)))))))
			(let-mut keyword (call call_loan_keyword expected))
			(if
				(:doc "Native initialization and mutation require the exclusive borrow spelling.")
				(call is_c_exclusive_owner_mode mode)
				(then (set keyword 39u32)))
