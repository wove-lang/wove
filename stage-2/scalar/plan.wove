				(then (return (call entry_at (local node) (i32 -1) (u32 24)))))
			(slice.store (local expressions) (local index)
				(call expression_row (local kind) (record.get (local operator) result) (i32 -1) (local first) (i32 0) (i32 0) (bool false)))
			(return (call entry_at (local node) (local index) (u32 0)))))

	(fn
		(:doc `Check a conversion target, seed its integer operand, and retain the original trap site.`)
		plan_conversion
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode)
