									(let first (struct.get (local owner) first))
									(let paths (call control_paths (borrow-shared (local nodes)) (borrow-shared (local statements))
										(borrow-shared (local expressions)) (local owner)))
									(if
										(:doc "Apply the completed loop's reachable successor state.")
										(local loop)
										(then (set (local falls_through) (call has_path (local paths) (local next_path))))
										(else
											(if
												(:doc "An exhaustive match can continue only through one of its checked arms.")
												(u32.eq (struct.get (local owner) kind) (local match_statement))
												(then (set (local falls_through) (call match_continues (borrow-shared (local nodes))
													(borrow-shared (local statements)) (local first))))
												(else
													(set (local falls_through)
														(bool.or (local falls_through)
															(bool.or (i32.eq (local block) (local first))
																(struct.get (array.load (local statements) (local first)) falls_through))))))))
									(array.store (local statements) (local owner_index) (call statement_exit_state (local owner)
										(struct.get (local owner) target) (local previous_owner) (local falls_through) (local paths)))
									(set (local block) (struct.get (local exit) block))
									(set (local index) (struct.get (local exit) statement)))))
						(else
							(let node (array.load (local nodes) (local index)))
							(if
								(:doc "A terminal statement leaves the following statement unreachable.")
								(bool.not (local falls_through))
								(then (return (call body_error (local caller) (struct.get (local node) start)
									(struct.get (local node) end) 24u32))))
							(let checked (call plan_statement (borrow-shared (local source)) (borrow-shared (local nodes))
								(local caller) (local index) (borrow-shared (local functions)) (borrow-shared (local parameters))
								(borrow-shared (local bindings)) (borrow-shared (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
								(borrow-mut (local sites)) (local site_count) (local view_start) (local previous_owner) (local previous_loan)))
							(if
								(:doc "Stop before planning any statements past the originating error.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (local checked))))
							(set (local site_count) (struct.get (local checked) count))
							(let statement (array.load (local statements) (local index)))
							(let kind (struct.get (local statement) kind))
							(if
								(:doc "Only an owning declaration adds an active owner to this scope.")
								(bool.and (bool.or (u32.eq (local kind) 15u32) (u32.eq (local kind) 16u32))
									(call is_lexical_owner (borrow-shared (local records)) (struct.get (local statement) type)))
								(then (set (local previous_owner) (local index))))
							(if
								(:doc "A view or scoped record holds its loans after checking the complete initializer.")
								(bool.or (bool.and (u32.eq (local kind) 15u32) (call is_readable_slice (struct.get (local statement) type)))
									(bool.and (bool.or (u32.eq (local kind) 15u32) (u32.eq (local kind) 16u32))
										(call is_scoped_record (borrow-shared (local records)) (struct.get (local statement) type))))
								(then (set (local previous_loan) (local index))))
							(set (local falls_through) (struct.get (local statement) falls_through))
							(let first (struct.get (local statement) first))
							(if
								(:doc "Control flow enters its first block. Other statements continue at their sibling.")
								(i32.ltz (local first))
								(then (set (local index) (call skip_disabled_siblings (borrow-shared (local source))
									(borrow-shared (local nodes)) (struct.get (local node) next_sibling))))
								(else
									(if
										(:doc "The array iterator keeps its shared loan until control leaves the loop.")
										(bool.and (u32.eq (local kind) (local for_statement)) (call is_readable_slice (struct.get (local statement) type)))
										(then
											(let loan (array.load (local expressions) (struct.get (local statement) value)))
											(if
												(:doc "A static descriptor or its range has no local or parameter identity to reserve.")
												(bool.and (u32.not-eq (struct.get (local loan) kind) 62u32)
													(i32.lt -1i32 (struct.get (local loan) target)))
												(then (set (local previous_loan) (local index))))))
									(set (local block) (local first))
									(if
										(:doc "A consuming body starts with its captured array and any owned item.")
										(bool.and (u32.eq (local kind) (local for_statement))
											(call is_array_owner (struct.get (local statement) type)))
										(then (set (local previous_owner) (call enter_consuming_iteration
											(borrow-shared (local nodes)) (borrow-mut (local statements)) (local statement)))))
									(if
										(:doc "The first case starts with its captured payload owner when present.")
										(u32.eq (local kind) (local match_statement))
										(then (set (local previous_owner) (call enter_case_owner (borrow-shared (local records))
											(borrow-mut (local statements)) (local block) (local previous_owner)))))
									(set (local index) (struct.get (array.load (local statements) (local block)) first))))))))
			(if
				(:doc "Every path through a value-returning body must return.")
				(bool.and (local falls_through) (u32.not-eq (struct.get (local caller) result) (call void_type)))
				(then
					(let node (array.load (local nodes) (local outer)))
					(return (call body_error (local caller) (struct.get (local node) start)
						(struct.get (local node) end) 24u32))))
			(array.store (local statements) (local outer)
				(call block_statement (struct.get (local caller) first_statement) -1i32 (local previous_owner) (local falls_through)))
			(return (call body_success (local site_count)))))

	(fn plan_bodies
		(:doc `Check each selected function and retain the resolved calls in source order.

		Start with zeroed plan storage. Read the returned call-site count
		only on success. Use zero view start for an arena of whole source files.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (statements (mut-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (sites (mut-array CallSite)) (view_start i32))
		(returns BodyPlan)
		(body
			(let-mut site_count 0i32)
			(let-mut function 0i32)
			(let count (call checked_function_count (borrow-shared (local functions))))
			(while
				(:doc "Each Wove function has its own block scopes and checked exits.")
				(i32.lt (local function) (local count))
				(body
					(let definition (array.load (local functions) (local function)))
					(if
						(:doc "Foreign signatures contribute call targets while their bodies come from C.")
						(i32.not-ltz (struct.get (local definition) body))
						(then
							(call register_function_references (borrow-shared (local source)) (borrow-shared (local nodes))
								(local definition) (borrow-shared (local functions)) (borrow-shared (local parameters))
								(borrow-shared (local bindings)) (borrow-mut (local records)))
							(let checked (call plan_function_body (borrow-shared (local source)) (borrow-shared (local nodes))
								(local definition) (borrow-shared (local functions))
								(borrow-shared (local parameters)) (borrow-shared (local bindings)) (borrow-shared (local records))
								(borrow-mut (local statements)) (borrow-mut (local expressions)) (borrow-mut (local sites))
								(local site_count) (local view_start)))
							(if
								(:doc "Report the earliest rejected body with the original file and span.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (local checked))))
							(set (local site_count) (struct.get (local checked) count))))
					(set (local function) (i32.inc (local function)))))
			(return (call body_success (local site_count))))))
