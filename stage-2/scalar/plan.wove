				(then (return (call entry_at node -1i32 24u32))))
			(return (call plan_suffixed_integer (borrow-shared source) node suffix
				index expected (borrow-mut expressions)))))

	(fn plan_character_value
		(:doc "Lower the checked character to an i32 value or its explicit u8 conversion.")
