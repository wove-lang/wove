(module scalar_matches
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check exhaustive matches and retain their scoped case and payload bindings.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings))
	(use wove-file "../source/enum_forms.wove" (only (value match_statement) (value match_case) (value non_exhaustive_match)
		(value pending_match_value) (value match_value) (value match_value_case) (value match_case_gate)))
	(use wove-file "../source/types.wove" (only is_builtin_integer))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "./syntax.wove" (only entry_at entry_form is_scalar_name same_name (value let_binding) (type EntryRead)))
	(use wove-file "./locals.wove" (only read_single_pattern_name))
	(use wove-file "./records.wove" (only find_member member_value_type is_record_type record_index is_enum_layout is_owning_record is_array_owner (type ScalarRecord)))
	(use wove-file "./flow.wove" (only block_statement statement_exit_state (value case_payload_binding) (value case_discard_binding) (type ScalarStatement)))

	(use wove-file "./match_patterns.wove" (only is_match_fallback read_integer_pattern match_key has_match_key (type MatchKey)))
	(use wove-file "./conditional.wove" (only copyable_choice_type))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))

	(fn payload_binding
		(:doc "Record a case-local name or hidden discard slot with its exact payload type.")
		(params (arm i32) (name i32) (type u32) (discard bool))
		(returns ScalarStatement)
		(body
			(let-mut kind case_payload_binding)
			(if discard (then (set kind case_discard_binding)))
			(return (struct:new ScalarStatement (kind kind) (target name) (value -1i32)
				(type type) (first arm) (previous_owner -1i32) (falls_through (bool true))
				(move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn payload_block
		(:doc "Associate one captured payload or wildcard owner with the case body.")
		(params (ordinal i32) (name i32) (first i32))
		(returns ScalarStatement)
		(body
			(return (struct:new ScalarStatement (kind 0u32) (target ordinal) (value name) (type 0u32)
				(first first) (previous_owner -1i32) (falls_through (bool true))
				(move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn enter_case_owner
		(:doc "Link the active case payload or its hidden discard to the arm's owner chain.")
		(params (records (shared-array ScalarRecord)) (statements (mut-array ScalarStatement)) (arm i32) (previous i32))
		(returns i32)
		(body
			(let name (struct:get (statements.get arm) value))
			(if name.ltz (then (return previous)))
			(let binding (statements.get name))
			(let type binding/type)
			(if
				(:doc "Only a transferred owner needs destruction when the arm exits.")
				(bool:not (bool:or (call is_array_owner type)
					(call is_owning_record (borrow-shared records) type)))
				(then (return previous)))
			(statements.set name
				(call statement_exit_state binding name previous (bool true) 0u32))
			(return name)))

	(fn plan_case_body
		(:doc `Record the arm body and bind its active payload as an immutable local or hidden owner.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (block SourceNode)
			(arm i32) (ordinal i32) (operand i32) (type u32)
			(records (shared-array ScalarRecord)) (statements (mut-array ScalarStatement)))
		(returns EntryRead)
		(body
			(let first (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes) operand))
			(if
				(:doc "A unit variant or wildcard starts directly with its arm body.")
				type.eqz
				(then
					(statements.set arm (call block_statement first ordinal -1i32 (bool true)))
					(return (call entry_at block arm 0u32))))
			(if
				(:doc "A payload arm must specify a binding or an explicit discard.")
				first.ltz
				(then (return (call entry_at block -1i32 24u32))))
			(let binder (nodes.get first))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) binder let_binding 24u32))
			(if (u32:gtz form/error) (then (return form)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) binder))
			(let named (call read_single_pattern_name (borrow-shared source) (borrow-shared nodes) binder
				parts/name parts/operands))
			(if (u32:gtz named/error) (then (return named)))
			(let name named/operand)
			(let spelling (nodes.get name))
			(let discard (call is_match_fallback (borrow-shared source) spelling))
			(let body_start (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
				binder/next_sibling))
			(let-mut bound -1i32)
			(if
				(:doc "An owning discard still retains its payload until the arm exits.")
				(bool:or discard.not (bool:or (call is_array_owner type)
					(call is_owning_record (borrow-shared records) type)))
				(then
					(set bound name)
					(statements.set name
						(call payload_binding arm name type discard))))
			(statements.set arm (call payload_block ordinal bound body_start))
			(return (call entry_at block arm 0u32))))

	(fn integer_case_count
		(:doc "Size the duplicate-check scratch from the number of case forms.")
		(params (nodes (shared-array SourceNode)) (first i32))
		(returns i32)
		(body
			(let-mut arm first)
			(let-mut count 0i32)
			(while
				(:doc "Each sibling contributes room for one constant key.")
				(i32:lt -1i32 arm)
				(body
					(set count count.inc)
					(set arm (struct:get (nodes.get arm) next_sibling))))
			(return count)))

	(fn plan_match_cases
		(:doc `Check exact patterns and coverage before planning any of the independent arm scopes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(subject i32) (type u32) (records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(statements (mut-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let subject_node (nodes.get subject))
			(let first subject_node/next_sibling)
			(let integer (call is_builtin_integer type))
			(let-mut count 0i32)
			(let-mut keys_count 0i32)
			(if
				(:doc "Integer cases require an explicit fallback. Enum cases can exhaust the nominal variants.")
				integer
				(then (set keys_count (call integer_case_count (borrow-shared nodes) first)))
				(else
					(if
						(:doc "Only a built-in integer or a declared enum can supply a subject.")
						(bool:not (bool:and (call is_record_type type)
							(call is_enum_layout (records.get (call record_index type)))))
						(then (return (call entry_at subject_node -1i32 24u32))))
					(set count (struct:get (records.get (call record_index type)) count))))
			(let-mut keys (array:alloc MatchKey keys_count))
			(let-mut seen (array:alloc u8 count))
			(let-mut covered 0i32)
			(let-mut arm first)
			(while
				(:doc "A case label is a checked literal, a variant from the subject's own enum, or the final wildcard.")
				(i32:lt -1i32 arm)
				(body
					(let block (nodes.get arm))
					(let form (call entry_form (borrow-shared source) (borrow-shared nodes)
						block match_case 24u32))
					(if (u32:gtz form/error) (then (return form)))
					(let index form/operand)
					(if index.ltz (then (return (call entry_at block -1i32 24u32))))
					(let pattern (nodes.get index))
					(let operand pattern/next_sibling)
					(let-mut fallback (call is_match_fallback (borrow-shared source) pattern))
					(if
						(:doc "Preserve an exact case for an enum that already declares a variant named underscore.")
						(fallback.and integer.not)
						(then
							(let layout (records.get (call record_index type)))
							(let variant (call find_member (borrow-shared source) (borrow-shared nodes)
								layout/first count pattern))
							(set fallback (i32:ltz variant/ordinal))))
					(if
						(:doc "The wildcard ends the match. Retain an owning subject for cleanup in its arm.")
						fallback
						(then
							(let next block/next_sibling)
							(if
								(:doc "An arm after the wildcard has no reachable subject.")
								(i32:lt -1i32 next)
								(then (return (call entry_at (nodes.get next) -1i32 24u32))))
							(if
								(:doc "An enum wildcard also needs at least one uncovered variant.")
								(bool:and integer.not (covered.eq count))
								(then (return (call entry_at pattern -1i32 24u32))))
							(let body_start (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes) operand))
							(let-mut hidden -1i32)
							(if
								(:doc "A hidden wildcard slot owns the captured enum and drops only its active variant.")
								(call is_owning_record (borrow-shared records) type)
								(then
									(set hidden index)
									(statements.set index
										(call payload_binding arm index type (bool true)))))
							(statements.set arm (call payload_block -1i32 hidden body_start))
							(return (call entry_at node first 0u32))))
					(if
						(:doc "Integer keys are compared by value, including across radices and leading-zero spellings.")
						integer
						(then
							(let checked (call read_integer_pattern (borrow-shared source) (borrow-shared nodes)
								index type (borrow-mut expressions)))
							(if (u32:gtz checked/error) (then (return checked)))
							(let key (call match_key (borrow-shared source) (expressions.get index)))
							(if
								(:doc "A repeated constant reports the later pattern.")
								(call has_match_key (borrow-shared keys) covered key)
								(then (return (call entry_at pattern -1i32 33u32))))
							(keys.set covered key)
							(statements.set arm (call block_statement
								(call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes) operand)
								index -1i32 (bool true))))
						(else
							(if
								(:doc "A variant pattern uses the declaration's bare spelling.")
								(bool:not (call is_scalar_name (borrow-shared source) pattern))
								(then (return (call entry_at pattern -1i32 24u32))))
							(let layout (records.get (call record_index type)))
							(let variant (call find_member (borrow-shared source) (borrow-shared nodes)
								layout/first count pattern))
							(let ordinal variant/ordinal)
							(if ordinal.ltz (then (return (call entry_at pattern -1i32 34u32))))
							(if
								(:doc "A second case for the same variant overlaps the earlier case.")
								(u8:eq (seen.get ordinal) 1u8)
								(then (return (call entry_at pattern -1i32 33u32))))
							(seen.set ordinal 1u8)
							(let payload (call member_value_type (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings) layout
								(nodes.get variant/row)))
							(let checked (call plan_case_body (borrow-shared source) (borrow-shared nodes)
								block arm ordinal operand payload
								(borrow-shared records) (borrow-mut statements)))
							(if (u32:gtz checked/error) (then (return checked)))))
					(set covered covered.inc)
					(set arm block/next_sibling)))
			(if
				(:doc "A missing integer fallback or an uncovered enum variant points at the match.")
				(integer.or (covered.not-eq count))
				(then (return (call entry_at node -1i32 non_exhaustive_match))))
			(return (call entry_at node first 0u32))))

	(fn seed_match_value
		(:doc "Schedule case checking after the subject's expression has been checked.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (expected u32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node match_statement 24u32))
			(if (u32:gtz form/error) (then (return form)))
			(let subject form/operand)
			(if subject.ltz (then (return (call entry_at node -1i32 24u32))))
			(let first (struct:get (nodes.get subject) next_sibling))
			(if first.ltz (then (return (call entry_at node -1i32 non_exhaustive_match))))
			(expressions.set index (call expression_row
				pending_match_value expected -1i32 subject 0i32 0i32 (bool false)))
			(expressions.set subject (call expression_row
				0u32 42u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(expressions.set first (call expression_row
				match_case_gate 0u32 index -1i32 0i32 0i32 (bool false)))
			(return (call entry_at node index 0u32))))

	(fn seed_match_results
		(:doc "A value case supplies one expression after its pattern and any checked payload binder.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (first i32) (expected u32)
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let-mut arm first)
			(while
				(:doc "Publish value-case boundaries before visiting the result expressions.")
				(i32:lt -1i32 arm)
				(body
					(let block (nodes.get arm))
					(let case (statements.get arm))
					(let result case/first)
					(if
						(:doc "A case must supply exactly one value in an expression match.")
						(bool:or result.ltz
							(i32:lt -1i32 (struct:get (nodes.get result) next_sibling)))
						(then (return (call entry_at block -1i32 24u32))))
					(expressions.set arm
						(call expression_row match_value_case 0u32 -1i32 result 0i32 0i32 (bool false)))
					(expressions.set result
						(call expression_row 0u32 expected -1i32 -1i32 0i32 0i32 (bool false)))
					(set arm block/next_sibling)))
			(return (call entry_at (nodes.get first) first 0u32))))

	(fn finish_match_value
		(:doc "Publish the common exact copyable type after each arm value has been checked.")
		(params (nodes (shared-array SourceNode)) (index i32) (row ScalarExpression)
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let subject row/first)
			(let-mut arm (struct:get (nodes.get subject) next_sibling))
			(let first_result (struct:get (expressions.get arm) first))
			(let type (struct:get (expressions.get first_result) type))
			(while
				(:doc "Every result must inhabit the same join slot without an implicit copy of an owner.")
				(i32:lt -1i32 arm)
				(body
					(let result (struct:get (expressions.get arm) first))
					(let actual (struct:get (expressions.get result) type))
					(if
						(:doc "Point to the result that cannot join.")
						(bool:not (bool:and (type.eq actual) (call copyable_choice_type (borrow-shared records) actual)))
						(then (return (call entry_at (nodes.get result) -1i32 24u32))))
					(set arm (struct:get (nodes.get arm) next_sibling))))
			(expressions.set index
				(call expression_row match_value type -1i32 subject 0i32 0i32 (bool false)))
			(return (call entry_at (nodes.get index) index 0u32))))

	(fn find_match_binding
		(:doc "Resolve a payload name in the closest value arm before looking in enclosing statement scopes.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (use i32) (statement i32) (name SourceNode))
		(returns i32)
		(body
			(let-mut arm (struct:get (nodes.get use) parent))
			(while
				(:doc "Parent links stay inside the current statement until all its expression scopes have been searched.")
				(statement.lt arm)
				(body
					(if
						(:doc "Only value case rows introduce a payload copy during an expression.")
						(u32:eq (struct:get (expressions.get arm) kind) match_value_case)
						(then
							(let binding (struct:get (statements.get arm) value))
							(if
								(:doc "A payload name shadows an outer name in this arm only.")
								(bool:and (i32:lt -1i32 binding)
									(call same_name (borrow-shared source) (nodes.get binding) name))
								(then (return binding)))))
					(set arm (struct:get (nodes.get arm) parent))))
			(return -1i32)))

	(fn match_continues
		(:doc `An exhaustive match reaches its successor exactly when at least one arm does.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (first i32))
		(returns bool)
		(body
			(let-mut arm first)
			(while
				(:doc "All arm rows have been completed when the final case exits.")
				(i32:lt -1i32 arm)
				(body
					(if
						(:doc "One continuing arm suffices, irrespective of the other return paths.")
						(struct:get (statements.get arm) falls_through)
						(then (return (bool true))))
					(set arm (struct:get (nodes.get arm) next_sibling))))
			(return (bool false)))))
