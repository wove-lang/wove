(module scalar_optional
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check optional array constructors and keep the exact payload type through ownership transfer.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/owned.wove" (only optional_type_operand
		(value optional_none) (value optional_some) (value pending_optional_some)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "./records.wove" (only read_owned_array_type (type ScalarRecord) (type TypeScope)))
	(use wove-file "./owners.wove" (only optional_owner_type is_owner_take optional_unwrap_kind))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))
	(use wove-file "./conditional.wove" (only conditional_arm_is_value))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword (value pending_exact_move)
		(value fixed_owner_transfer) (type EntryRead)))

	(fn read_optional_result
		(:doc "Resolve the original owned array descriptor before mapping it to its optional result.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope TypeScope))
		(returns u32)
		(body
			(let operand (call optional_type_operand (borrow-shared source) (borrow-shared nodes) node))
			(if operand.ltz (then (return 0u32)))
			(return (call optional_owner_type (call read_owned_array_type (borrow-shared source)
				(borrow-shared nodes) (nodes.get operand)
				(borrow-shared records) (borrow-shared bindings) scope)))))

	(fn plan_optional_constructor
		(:doc "Check an absent payload type or seed the one expression transferred into a present optional.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (kind u32) (expected u32) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node kind 24u32))
			(if (u32:gtz form/error) (then (return form)))
			(let operand form/operand)
			(if
				(:doc "Each constructor requires one operand and reports malformed arity at the form.")
				(bool:or operand.ltz
					(i32:not-ltz (struct:get (nodes.get operand) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(let child (nodes.get operand))
			(if
				(:doc "An absent value specifies its exact payload type without evaluating an expression.")
				(kind.eq optional_none)
				(then
					(let result (call optional_owner_type (call read_owned_array_type (borrow-shared source)
						(borrow-shared nodes) child (borrow-shared records)
						(borrow-shared bindings) scope)))
					(if
						(:doc "Reject an unsupported payload type at its written descriptor.")
						result.eqz
						(then (return (call entry_at child -1i32 24u32))))
					(if
						(:doc "An absent optional still has an exact result type.")
						(bool:not (bool:or (expected.eq 42u32) (expected.eq result)))
						(then (return (call entry_at node -1i32 24u32))))
					(expressions.set index
						(call expression_row optional_none result -1i32 -1i32 0i32 0i32 (bool false)))
					(return (call entry_at node index 0u32))))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) child))
			(let keyword (call entry_keyword (borrow-shared source) (borrow-shared nodes) parts/head))
			(let-mut seed 0u32)
			(if
				(:doc "An explicit move uses the normal evaluating transfer and loan check.")
				(keyword.eq 43u32)
				(then (set seed pending_exact_move)))
			(expressions.set operand
				(call expression_row seed 42u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(expressions.set index
				(call expression_row pending_optional_some expected -1i32 operand 0i32 0i32 (bool false)))
			(return (call entry_at node index 0u32))))

	(fn finish_optional_some
		(:doc "Wrap just a fresh or moved array owner and match the resulting optional type exactly.")
		(params (nodes (shared-array SourceNode)) (index i32) (row ScalarExpression)
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let operand row/first)
			(let payload (expressions.get operand))
			(let kind payload/kind)
			(let result (call optional_owner_type payload/type))
			(if
				(:doc "A named owner can enter a present optional only through a checked transfer.")
				(bool:not (bool:and result.gtz
					(bool:or (call conditional_arm_is_value (borrow-shared records) payload)
						(bool:or (call is_owner_take kind)
							(bool:or (kind.eq (call optional_unwrap_kind)) (kind.eq fixed_owner_transfer))))))
				(then (return (call entry_at (nodes.get operand) -1i32 24u32))))
			(if
				(:doc "Check an explicit expected result after deriving the optional type from its payload.")
				(bool:not (bool:or (u32:eq row/type 42u32) (u32:eq row/type result)))
				(then (return (call entry_at (nodes.get index) -1i32 24u32))))
			(expressions.set index
				(call expression_row optional_some result -1i32 operand 0i32 0i32 (bool false)))
			(return (call entry_at (nodes.get index) index 0u32))))
)
