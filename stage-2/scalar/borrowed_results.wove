(module scalar_borrowed_results
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check that a returned array view or scoped record borrows its promised parameter.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "./flow.wove" (only (type ScalarStatement)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./loans.wove" (only returned_call_argument is_local_slice_view (value scoped_field_loan) (type ScalarExpression)))
	(use wove-file "./owners.wove" (only owned_field_loan_kind))
	(use wove-file "./records.wove" (only is_readable_slice read_parameter_type (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only entry_keyword is_reborrow_keyword))

	(fn borrowed_result_view
		(:doc "Resolve a result descriptor with the existing array parameter types and no extent annotation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
				(array.load (local nodes) (local index))))
			(let element (struct.get (local parts) operands))
			(if
				(:doc "A view result declares its element type without a parameter's optional extent.")
				(bool.or (i32.ltz (local element))
					(i32.not-ltz (struct.get (array.load (local nodes) (local element)) next_sibling)))
				(then (return 0u32)))
			(let view (call read_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base)
				(local index) (bool true)))
			(if (u32.gtz (struct.get (local view) error)) (then (return 0u32)))
			(let type (u32.from-i32 (struct.get (local view) operand)))
			(if (bool.not (call is_readable_slice (local type))) (then (return 0u32)))
			(return (local type))))

	(fn is_provenance_return
		(:doc "Recognize the root of an explicit return to which the source contract applies.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(caller ScalarFunction) (statement i32))
		(returns bool)
		(body
			(if
				(:doc "A nested expression cannot transfer the return's loan.")
				(bool.or (i32.ltz (struct.get (local caller) return_source))
					(i32.not-eq (struct.get (local node) parent) (local statement)))
				(then (return (bool false))))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
				(array.load (local nodes) (local statement))))
			(return (u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local parts) head)) 7u32))))

	(fn binding_initializer
		(:doc "Follow a binding identity only to an earlier checked local declaration.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (name i32) (before i32))
		(returns i32)
		(body
			(if (bool.or (i32.ltz (local name)) (i32.not-lt (local name) (local before))) (then (return -1i32)))
			(let parent (struct.get (array.load (local nodes) (local name)) parent))
			(if (i32.ltz (local parent)) (then (return -1i32)))
			(let row (array.load (local statements) (local parent)))
			(let kind (struct.get (local row) kind))
			(if
				(:doc "Loop items and other temporary places do not share a lexical initializer.")
				(bool.or (i32.not-eq (struct.get (local row) target) (local name))
					(bool.not (bool.or (u32.eq (local kind) 15u32) (u32.eq (local kind) 16u32))))
				(then (return -1i32)))
			(return (struct.get (local row) value))))

	(fn projected_view_origin
		(:doc "Recover a borrowed record field from its exact constructor member or the record call's source.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (initializer i32) (ordinal i32))
		(returns i32)
		(body
			(let record (array.load (local expressions) (local initializer)))
			(let argument (call returned_call_argument (local record)))
			(if (i32.not-ltz (local argument)) (then (return (local argument))))
			(if (u32.not-eq (struct.get (local record) kind) 50u32) (then (return -1i32)))
			(let-mut field (struct.get (local record) first))
			(while
				(:doc "Constructor fields preserve source order and the checked layout ordinal.")
				(i32.not-ltz (local field))
				(body
					(let member (array.load (local expressions) (local field)))
					(if
						(:doc "Use the checked initializer for this exact field.")
						(i32.eq (struct.get (local member) target) (local ordinal))
						(then (return (struct.get (local member) first))))
					(set (local field) (struct.get (array.load (local nodes) (local field)) next_sibling))))
			(return -1i32)))

	(fn view_from_parameter
		(:doc "Trace a descriptor to a formal through explicit loans, scoped bindings, and checked Wove calls.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (value i32) (parameter i32))
		(returns bool)
		(body
			(let-mut index (local value))
			(while
				(:doc "A call follows its selected operand; a lexical reference follows an earlier declaration.")
				(i32.not-ltz (local index))
				(body
					(let view (array.load (local expressions) (local index)))
					(let argument (call returned_call_argument (local view)))
					(if
						(:doc "A callee's checked contract names the only argument carried into its result.")
						(i32.not-ltz (local argument))
						(then (set (local index) (local argument)))
						(else
							(let kind (struct.get (local view) kind))
							(let type (struct.get (local view) type))
							(if
								(:doc "Only checked array loans preserve source identity; static and computed values are excluded.")
								(bool.not (bool.and (call is_readable_slice (local type))
									(bool.or (call is_reborrow_keyword (local kind))
										(bool.or (u32.eq (local kind) 45u32)
											(bool.or (call is_local_slice_view (local kind))
												(bool.or (u32.eq (local kind) (local scoped_field_loan))
													(u32.eq (local kind) (call owned_field_loan_kind))))))))
								(then (return (bool false))))
							(let target (struct.get (local view) target))
							(if
								(:doc "A formal's checked index is independent of local and module names.")
								(bool.not (struct.get (local view) borrowed_owner))
								(then (return (i32.eq (local target) (local parameter)))))
							(let initializer (call binding_initializer (borrow-shared (local nodes))
								(borrow-shared (local statements)) (local target) (local index)))
							(if (i32.ltz (local initializer)) (then (return (bool false))))
							(if
								(:doc "A projected scoped field follows its original initializer instead of the whole record.")
								(u32.eq (local kind) (local scoped_field_loan))
								(then
									(let field (array.load (local expressions) (struct.get (local view) projection)))
									(set (local index) (call projected_view_origin (borrow-shared (local nodes))
										(borrow-shared (local expressions)) (local initializer) (struct.get (local field) target))))
								(else
									(if
										(:doc "Borrowing storage owned by this function cannot make it escape.")
										(bool.not (call is_readable_slice (struct.get (array.load (local expressions) (local initializer)) type)))
										(then (return (bool false))))
									(set (local index) (local initializer))))))))
			(return (bool false))))

	(fn invalid_return_origin
		(:doc "Return the first original operand that cannot be traced to the declared source, or -1.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (value i32) (parameter i32))
		(returns i32)
		(body
			(let root (array.load (local expressions) (local value)))
			(let-mut origin (local value))
			(if
				(:doc "A scoped record can be returned directly from its original local binding.")
				(u32.eq (struct.get (local root) kind) 6u32)
				(then (set (local origin) (call binding_initializer (borrow-shared (local nodes))
					(borrow-shared (local statements)) (struct.get (local root) target) (local value)))))
			(if (i32.ltz (local origin)) (then (return (local value))))
			(let result (array.load (local expressions) (local origin)))
			(if
				(:doc "A returned record constructor must prove the origin of every borrowed field.")
				(u32.eq (struct.get (local result) kind) 50u32)
				(then
					(let-mut field (struct.get (local result) first))
					(while
						(:doc "Check borrowed fields in the order the source initializes them.")
						(i32.not-ltz (local field))
						(body
							(let member (array.load (local expressions) (local field)))
							(let view (struct.get (local member) first))
							(if
								(:doc "Scalar fields carry no lifetime requirement.")
								(bool.and (call is_readable_slice (struct.get (array.load (local expressions) (local view)) type))
									(bool.not (call view_from_parameter (borrow-shared (local nodes))
										(borrow-shared (local statements)) (borrow-shared (local expressions)) (local view) (local parameter))))
								(then (return (local view))))
							(set (local field) (struct.get (array.load (local nodes) (local field)) next_sibling))))
					(return -1i32)))
			(if
				(:doc "A view or forwarded call result must resolve to the selected parameter.")
				(call view_from_parameter (borrow-shared (local nodes)) (borrow-shared (local statements))
					(borrow-shared (local expressions)) (local origin) (local parameter))
				(then (return -1i32)))
			(return (local value)))))
