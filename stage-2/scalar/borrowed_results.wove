(module scalar_borrowed_results
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check that a returned array view or scoped record borrows its promised parameter.")

	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind) (value optional_view_unwrap)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "./flow.wove" (only (type ScalarStatement)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./loans.wove" (only returned_call_argument is_local_slice_view shared_byte_row_source (value scoped_field_loan) (type ScalarExpression)))
	(use wove-file "./owners.wove" (only owned_field_loan_kind))
	(use wove-file "./records.wove" (only is_readable_slice read_parameter_type shared_byte_rows_type (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only entry_keyword is_reborrow_keyword))

	(fn borrowed_result_view
		(:doc "Resolve a result descriptor with the existing array parameter types and no extent annotation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
				(nodes.get index)))
			(let element parts/operands)
			(if
				(:doc "A view result declares its element type without a parameter's optional extent.")
				(bool:or element.ltz
					(i32:not-ltz (struct:get (nodes.get element) next_sibling)))
				(then (return 0u32)))
			(let view (call read_parameter_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) file source_base
				index (bool true)))
			(if view/error.gtz (then (return 0u32)))
			(let type (u32:from-i32 view/operand))
			(if (bool:not (call is_readable_slice type)) (then (return 0u32)))
			(return type)))

	(fn is_provenance_return
		(:doc "Recognize the root of an explicit return to which the source contract applies.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(caller ScalarFunction) (statement i32))
		(returns bool)
		(body
			(if
				(:doc "A nested expression cannot transfer the return's loan.")
				(bool:or caller/return_source.ltz
					(node/parent.not-eq statement))
				(then (return (bool false))))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
				(nodes.get statement)))
			(return (u32:eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
				parts/head) 7u32))))

	(fn binding_initializer
		(:doc "Follow a binding identity only to an earlier checked local declaration.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (name i32) (before i32))
		(returns i32)
		(body
			(if (bool:or name.ltz (name.not-lt before)) (then (return -1i32)))
			(let parent (struct:get (nodes.get name) parent))
			(if parent.ltz (then (return -1i32)))
			(let row (statements.get parent))
			(let kind row/kind)
			(if
				(:doc "Loop items and other temporary places do not share a lexical initializer.")
				(bool:or (row/target.not-eq name)
					(bool:not (bool:or (kind.eq 15u32) (kind.eq 16u32))))
				(then (return -1i32)))
			(return row/value)))

	(fn projected_view_origin
		(:doc "Recover a borrowed record field from its exact constructor member or the record call's source.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (initializer i32) (ordinal i32))
		(returns i32)
		(body
			(let record (expressions.get initializer))
			(let argument (call returned_call_argument record))
			(if argument.not-ltz (then (return argument)))
			(if (record/kind.not-eq 50u32) (then (return -1i32)))
			(let-mut field record/first)
			(while
				(:doc "Constructor fields preserve source order and the checked layout ordinal.")
				field.not-ltz
				(body
					(let member (expressions.get field))
					(if
						(:doc "Use the checked initializer for this exact field.")
						(member/target.eq ordinal)
						(then (return member/first)))
					(set field (struct:get (nodes.get field) next_sibling))))
			(return -1i32)))

	(fn view_from_parameter
		(:doc "Trace a descriptor to a formal through explicit loans, scoped bindings, and checked Wove calls.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (value i32) (parameter i32))
		(returns bool)
		(body
			(let-mut index value)
			(while
				(:doc "A call follows its selected operand; a lexical reference follows an earlier declaration.")
				index.not-ltz
				(body
					(let view (expressions.get index))
					(let kind view/kind)
					(let-mut argument (call returned_call_argument view))
					(let rows (call shared_byte_row_source (borrow-shared expressions) view))
					(if
						(:doc "A selected descriptor inherits the provenance of its outer view.")
						rows.not-ltz
						(then (set argument rows)))
					(if
						(:doc "An exact window draws from its original shared borrow.")
						(kind.eq try_slice_kind)
						(then (set argument view/first)))
					(if
						(:doc "An unwrap keeps the source of its earlier immutable option.")
						(kind.eq optional_view_unwrap)
						(then (set argument (call binding_initializer (borrow-shared nodes) (borrow-shared statements)
							view/target index))))
					(if
						(:doc "Follow the checked operand or lexical initializer before validating the ultimate source.")
						argument.not-ltz
						(then (set index argument))
						(else
							(let type view/type)
							(if
								(:doc "Only checked array loans preserve source identity; static and computed values are excluded.")
								(bool:not (bool:and (call is_readable_slice type)
									(bool:or (call is_reborrow_keyword kind)
										(bool:or (bool:or (kind.eq 45u32)
												(bool:and (kind.eq 2u32) (type.eq (call shared_byte_rows_type))))
											(bool:or (call is_local_slice_view kind)
												(bool:or (kind.eq scoped_field_loan)
													(kind.eq (call owned_field_loan_kind))))))))
								(then (return (bool false))))
							(let target view/target)
							(if
								(:doc "A formal's checked index is independent of local and module names.")
								view/borrowed_owner.not
								(then (return (target.eq parameter))))
							(let initializer (call binding_initializer (borrow-shared nodes)
								(borrow-shared statements) target index))
							(if initializer.ltz (then (return (bool false))))
							(if
								(:doc "A projected scoped field follows its original initializer instead of the whole record.")
								(kind.eq scoped_field_loan)
								(then
									(let field (expressions.get view/projection))
									(set index (call projected_view_origin (borrow-shared nodes)
										(borrow-shared expressions) initializer field/target)))
								(else
									(if
										(:doc "Borrowing storage owned by this function cannot make it escape.")
										(bool:not (call is_readable_slice (struct:get (expressions.get initializer) type)))
										(then (return (bool false))))
									(set index initializer)))))))
			(return (bool false))))

	(fn invalid_return_origin
		(:doc "Return the first original operand that cannot be traced to the declared source, or -1.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (value i32) (parameter i32))
		(returns i32)
		(body
			(let root (expressions.get value))
			(let-mut origin value)
			(if
				(:doc "A scoped record can be returned directly from its original local binding.")
				(root/kind.eq 6u32)
				(then (set origin (call binding_initializer (borrow-shared nodes)
					(borrow-shared statements) root/target value))))
			(if origin.ltz (then (return value)))
			(let result (expressions.get origin))
			(if
				(:doc "A returned record constructor must prove the origin of every borrowed field.")
				(result/kind.eq 50u32)
				(then
					(let-mut field result/first)
					(while
						(:doc "Check borrowed fields in the order the source initializes them.")
						field.not-ltz
						(body
							(let member (expressions.get field))
							(let view member/first)
							(if
								(:doc "Scalar fields carry no lifetime requirement.")
								(bool:and (call is_readable_slice (struct:get (expressions.get view) type))
									(bool:not (call view_from_parameter (borrow-shared nodes)
										(borrow-shared statements) (borrow-shared expressions) view parameter)))
								(then (return view)))
							(set field (struct:get (nodes.get field) next_sibling))))
					(return -1i32)))
			(if
				(:doc "A view or forwarded call result must resolve to the selected parameter.")
				(call view_from_parameter (borrow-shared nodes) (borrow-shared statements)
					(borrow-shared expressions) origin parameter)
				(then (return -1i32)))
			(return value))))
