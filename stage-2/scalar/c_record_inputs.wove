(module scalar_c_record_inputs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve a call-scoped native record mapping against its original Wove loans.")

	(use wove-file "../c/arguments.wove" (only is_c_array_mode is_c_bytes_mode is_c_value_mode))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./function_rows.wove" (only find_parameter (type ScalarParameter)))
	(use wove-file "./records.wove" (only is_mutable_place_reference is_native_record
		is_record_type place_reference_target record_index (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only same_name))

	(struct RecordInputRead
		(fields (record i32) (data i32) (count i32) (pointer_name i32) (count_name i32)
			(start i32) (end i32) (error u32)))

	(fn record_input_error
		(:doc "Keep a rejected part of the contract at its original source span.")
		(params (site SourceNode)) (returns RecordInputRead)
		(body
			(return (struct.new RecordInputRead
				(record -1i32) (data -1i32) (count -1i32) (pointer_name -1i32) (count_name -1i32)
				(start (struct.get site start)) (end (struct.get site end)) (error 23u32)))))

	(fn check_record_input
		(:doc "Bind one mutable native record, one borrowed extent, and an ordinary count value.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameters (shared-array ScalarParameter)) (first i32) (limit i32)
			(operands i32)) (returns RecordInputRead)
		(body
			(if
				(:doc "Ordinary native signatures need no temporary member setup.")
				(i32.ltz operands)
				(then (return (struct.new RecordInputRead
					(record -1i32) (data -1i32) (count -1i32) (pointer_name -1i32) (count_name -1i32)
					(start 0i32) (end 0i32) (error 0u32)))))
			(let name (array.load nodes operands))
			(let record (call find_parameter (borrow-shared source) (borrow-shared nodes)
				name (borrow-shared parameters) first limit))
			(if (i32.ltz record) (then (return (call record_input_error name))))
			(let place (array.load parameters record))
			(let type (struct.get place type))
			(if
				(:doc "Preparing both fields requires exclusive access to the original native record.")
				(bool.not (bool.and (call is_c_value_mode (struct.get place c_mode))
					(call is_mutable_place_reference type)))
				(then (return (call record_input_error name))))
			(let layout (call place_reference_target (borrow-shared records) type))
			(if
				(:doc "The two named fields belong to one complete native layout.")
				(bool.not (bool.and (call is_record_type layout)
					(call is_native_record (array.load records (call record_index layout)))))
				(then (return (call record_input_error name))))
			(let data_name (array.load nodes (struct.get name next_sibling)))
			(let data (call find_parameter (borrow-shared source) (borrow-shared nodes)
				data_name (borrow-shared parameters) first limit))
			(if (i32.ltz data) (then (return (call record_input_error data_name))))
			(let view (array.load parameters data))
			(let mode (struct.get view c_mode))
			(let ordinal (struct.get view c_count))
			(if
				(:doc "Reuse one existing byte or element check with a named by-value extent.")
				(bool.or (i32.ltz ordinal)
					(bool.not (bool.or (call is_c_array_mode mode)
						(bool.and (call is_c_bytes_mode mode) (i32.ltz (struct.get view c_size))))))
				(then (return (call record_input_error data_name))))
			(let count (i32.add first ordinal))
			(let extent (array.load parameters count))
			(if
				(:doc "Temporary count fields accept scalar values without capturing a writable count pointer.")
				(bool.or (bool.not (call is_c_value_mode (struct.get extent c_mode)))
					(call is_mutable_place_reference (struct.get extent type)))
				(then (return (call record_input_error (array.load nodes (struct.get extent name))))))
			(let pointer_name (struct.get data_name next_sibling))
			(let pointer (array.load nodes pointer_name))
			(let count_name (struct.get pointer next_sibling))
			(let length (array.load nodes count_name))
			(if
				(:doc "Each field has a separate native representation and is restored independently.")
				(call same_name (borrow-shared source) pointer length)
				(then (return (call record_input_error length))))
			(return (struct.new RecordInputRead (record record) (data data) (count count)
				(pointer_name pointer_name) (count_name count_name)
				(start 0i32) (end 0i32) (error 0u32)))))
)
