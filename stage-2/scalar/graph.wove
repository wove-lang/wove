(module scalar_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Prepare scalar signatures from the active files in a resolved source graph.

	Flatten the checked trees into one table so the scalar planner and C
	writer can use direct node indices. Keep each function's original file
	and tree base for binding, call-site identity, and diagnostics. Use the
	canonical virtual path and declared module name to namespace C identities.`)

	(use wove-file "../source/scan.wove" (only check_source_form build_source_tree (type FormCheck) (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts read_module_for_target (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../source/types.wove" (only is_builtin_integer source_builtin_type void_type))
	(use wove-file "../source/owned.wove" (only is_byte_rows_descriptor))
	(use wove-file "../source/target.wove" (only (value library_mode) (type SelectionContext)))
	(use wove-file "../source/exports.wove" (only c_export_directive))
	(use wove-file "../source/imports.wove" (only import_keyword))
	(use wove-file "../source/c_record_out.wove" (only read_c_record_out (type CRecordOut)))
	(use wove-file "../source/c_record_in.wove" (only read_c_record_in))
	(use wove-file "../source/c_snapshots.wove" (only read_c_snapshot is_optional_byte_owner))
	(use wove-file "./c_record_snapshots.wove" (only check_record_snapshot))
	(use wove-file "./c_record_inputs.wove" (only check_record_input))
	(use wove-file "../source/tree_copy.wove" (only copy_tree))
	(use wove-file "../source/c_owners.wove" (only read_c_type c_owner_uses_typedef))
	(use wove-file "../source/c_dependencies.wove" (only connect_bridge_type))
	(use wove-file "../emit/collisions.wove" (only assign_c_names))
	(use wove-file "../source/c_scope.wove" (only connect_bridge_overlay declaring_c_bridge))
	(use wove-file "./constants.wove" (only register_integer_constants))
	(use wove-file "./trees.wove" (only source_span_owner named_module_tree (type ScalarTree)))
	(use wove-file "../source/functions.wove" (only read_return_origin))
	(use wove-file "../source/c_names.wove" (only c_function_opening))
	(use wove-file "../source/c_formals.wove" (only find_c_fixed_formal))
	(use wove-file "../source/c_arguments.wove" (only read_c_arguments mark_c_argument_type (type CArgument)))
	(use wove-file "../c/arguments.wove" (only is_c_value_mode is_c_bytes_mode is_c_storage_mode c_value_mode c_storage_mut_mode c_handle_mut_mode c_storage_init_mode c_handle_init_mode (value c_shared_handle_slot_mode) (value c_open_variadic_tail)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only is_wove_type_definition references_c_header (value c_dependency_provider) (type GraphModule) (type GraphBinding)))
	(use wove-file "../source/generics.wove" (only function_generic_list))
	(use wove-file "./generics/functions.wove" (only expand_graph_functions (type FunctionInstance)))
	(use wove-file "./specializations.wove" (only register_module_specializations validate_record_template_constants))
	(use wove-file "./records.wove" (only scope_at read_checked_template_parameters register_module_records register_module_record_arrays register_owned_rows order_record_layouts validate_record_array_fields declaration_kind find_native_node native_row_type is_native_integer is_native_record is_record_type record_type record_index buffered_record_type optional_record_borrow_type is_place_reference is_mutable_place_reference place_reference_target byte_rows_owner_type (type ScalarRecord)))
	(use wove-file "./owners.wove" (only optional_byte_owner_type))
	(use wove-file "./native_owner_types.wove" (only native_owner_type native_owner_row_limit is_native_owner))
	(use wove-file "./c_types.wove" (only remember_native_type register_parameter_native_types register_record_dependencies))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))
	(use wove-file "./plan.wove" (only register_function register_concrete_function read_parameters register_module_bindings (type FunctionScope)))
	(use wove-file "./function_rows.wove" (only find_parameter (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./flow.wove" (only block_statement (type ScalarStatement)
			(value c_constant_binding) (value c_readonly_binding) (value c_writable_binding) (value c_macro_binding)))
	(use wove-file "./syntax.wove" (only scalar_type entry_at (type EntryRead)))

	(struct TreeLayout (fields (rows i32) (file i32) (start i32) (end i32) (error u32)))
	(struct GraphSignatures
		(fields (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32)))

	(fn layout_trees
		(:doc `Keep reached module spans and reserve trees for active Wove files and selected C providers.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (bindings (shared-array GraphBinding)) (trees (mut-array ScalarTree)))
		(returns TreeLayout)
		(body
			(let-mut binding 0i32)
			(while
				(:doc "Mark bridge providers in the zeroed tree table until their row counts are measured.")
				(i32.lt binding (array.len bindings))
				(body
					(let selected (array.load bindings binding))
					(if
						(:doc "A C provider can participate in signature checking through a bridge alone.")
						(bool.and (call references_c_header selected) (i32.not-ltz (struct.get selected bridge_node)))
						(then
							(let primary (struct.get selected header_file))
							(let bundled (struct.get selected default_file))
							(let pending (struct.new ScalarTree (base 0i32) (rows -1i32) (start 0i32) (end 0i32) (module_id 0u32)))
							(array.store trees primary pending)
							(if
								(:doc "An inherited parameter or field can need the bundled tree even without an explicit selection.")
								(i32.lt -1i32 bundled)
								(then (array.store trees bundled pending)))))
					(set binding (i32.inc binding))))
			(let-mut file 0i32)
			(let-mut total 0i32)
			(while
				(:doc "Keep reached module spans even when selection excludes a file.")
				(i32.lt file (array.len files))
				(body
					(let module (array.load modules file))
					(let foreign (i32.ltz (struct.get (array.load trees file) rows)))
					(if
						(:doc "Visit completed Wove files and files with a selected bridge definition.")
						(bool.or (u32.eq (struct.get module state) 2u32) foreign)
						(then
							(let input (array.load files file))
							(let checked (call check_source_form
								(borrow-shared (array.range arena (struct.get input source_start)
									(struct.get input source_end)))))
							(let error (struct.get checked error))
							(let start (struct.get checked start))
							(let end (struct.get checked end))
							(if
								(:doc "Keep the original source span if the supplied view fails its form check.")
								(u32.gtz error)
								(then (return (struct.new TreeLayout (rows 0i32) (file file)
									(start start) (end end) (error error)))))
							(let-mut count 0i32)
							(if
								(:doc "Reserve space once for each active Wove file or C provider.")
								(bool.or (struct.get module active) foreign)
								(then
									(let rows (struct.get checked rows))
									(if
										(:doc "Original type declarations must fit below the reserved optional owner type band.")
										(u32.lt (u32.from-i32 (i32.sub (call native_owner_row_limit) total)) rows)
										(then (return (struct.new TreeLayout (rows 0i32) (file file)
											(start start) (end end) (error 16u32)))))
									(set count (i32.from-u32 rows))))
							(array.store trees file (struct.new ScalarTree (base total)
								(rows count) (start start) (end end) (module_id 0u32)))
							(set total (i32.add total count))))
					(set file (i32.inc file))))
			(return (struct.new TreeLayout (rows total) (file -1i32)
				(start 0i32) (end 0i32) (error 0u32)))))

	(fn first_bridge_binding
		(:doc `Identify the first alias that selects this native declaration in the graph.`)
		(params (bindings (shared-array GraphBinding)) (index i32) (binding GraphBinding))
		(returns bool)
		(body
			(if
				(:doc "Only function bindings from a C provider need a native signature row.")
				(bool.not (bool.and (u32.eq (struct.get binding provider) 8u32)
					(u32.eqz (struct.get binding namespace))))
				(then (return (bool false))))
			(let-mut cursor 0i32)
			(while
				(:doc "An earlier C binding with the same file and declaration is another alias.")
				(i32.lt cursor index)
				(body
					(let earlier (array.load bindings cursor))
					(if
						(:doc "Use the original declaration identity across importing files.")
						(bool.and (u32.eq (struct.get earlier provider) 8u32)
							(bool.and (i32.eq (struct.get earlier file) (struct.get binding file))
								(i32.eq (struct.get earlier declaration) (struct.get binding declaration))))
						(then (return (bool false))))
					(set cursor (i32.inc cursor))))
			(return (bool true))))

	(fn signature_capacity
		(:doc `Count one signature row per Wove or selected C definition.`)
		(params (bindings (shared-array GraphBinding)))
		(returns i32)
		(body
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Every alias shares the signature row of its defining declaration.")
				(i32.lt index (array.len bindings))
				(body
					(let row (array.load bindings index))
					(if
						(:doc "Match the ordinary Wove registration and the selected C signature pass.")
						(bool.or (call first_bridge_binding (borrow-shared bindings) index row)
							(bool.and (u32.eq (struct.get row provider) 3u32)
								(bool.and (u32.eqz (struct.get row namespace))
									(i32.eq (struct.get row owner) (struct.get row file)))))
						(then (set count (i32.inc count))))
					(set index (i32.inc index))))
			(return count)))

	(fn signatures_result
		(:doc `Keep checked table cursors, the selected entry row, and an original source diagnostic.`)
		(params (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphSignatures)
		(body
			(return (struct.new GraphSignatures (functions functions) (params params) (records records)
				(entry entry) (file file) (start start) (end end) (error error)))))

	(fn register_file_signatures
		(:doc `Check this file's active signatures with the complete graph type table.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (module ModuleRead)
			(input SuppliedFile) (tree ScalarTree) (file i32) (root i32)
			(functions (mut-array ScalarFunction)) (parameters (mut-array ScalarParameter)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding))
			(previous GraphSignatures))
		(returns GraphSignatures)
		(body
			(let base (struct.get tree base))
			(let source_base (struct.get input source_start))
			(let mode (struct.get module mode))
			(let entry_module (bool.and (i32.eq file root) (u32.lt mode 2u32)))
			(let scope (struct.new FunctionScope (file file) (tree_base base)
				(tree_limit (i32.add base (struct.get tree rows)))
				(source_base source_base) (module_id (struct.get tree module_id)) (entry_module entry_module) (mode mode)))
			(let-mut next_function (struct.get previous functions))
			(let-mut next_param (struct.get previous params))
			(let-mut entry (struct.get previous entry))
			(let next_record (struct.get previous records))
			(let-mut index 0i32)
			(while
				(:doc "Walk active declarations only and send definitions through the shared signature checker.")
				(i32.lt index (struct.get module count))
				(body
					(let declaration (struct.get
						(array.load declarations (i32.add base index)) node))
					(let node (array.load nodes declaration))
					(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) node))
					(let tag (call import_keyword (borrow-shared arena)
						(array.load nodes (struct.get parts head))))
					(if
						(:doc "A library export must be a concrete Wove function with an operand-free pragma.")
						(u32.eq mode library_mode)
						(then
							(let export (call c_export_directive (borrow-shared arena) (borrow-shared nodes) node))
							(if
								(:doc "Ignore declarations without a public ABI request.")
								(i32.not-ltz export)
								(then
									(let directive (array.load nodes export))
									(let head (array.load nodes (struct.get directive first_child)))
									(if
										(:doc "Generic definitions have no concrete C entry and the pragma takes no operands.")
										(bool.or (u32.not-eq tag 1u32)
											(bool.or (i32.not-ltz (struct.get head next_sibling))
												(i32.not-ltz (call function_generic_list (borrow-shared arena) (borrow-shared nodes) node))))
										(then (return (call signatures_result next_function next_param next_record
											entry file (i32.sub (struct.get directive start) source_base)
											(i32.sub (struct.get directive end) source_base) 21u32))))))))
					(if
						(:doc "Imports, type definitions, bridges, and module values have no function signature.")
						(bool.not (bool.or (bool.or (u32.eq tag 9u32)
							(bool.or (call is_wove_type_definition tag) (u32.eq tag 2u32)))
							(u32.eq (call declaration_kind (borrow-shared arena) (borrow-shared nodes)
								declaration) 15u32)))
						(then
							(let generic (call function_generic_list (borrow-shared arena) (borrow-shared nodes) node))
							(if
								(:doc "An unapplied template has no runtime signature or ABI entry.")
								(i32.lt -1i32 generic)
								(then
									(let parameters_form (array.load nodes generic))
									(let checked (call read_checked_template_parameters (borrow-shared arena) (borrow-shared nodes)
										(borrow-shared records) (borrow-shared bindings)
										(call scope_at file source_base) parameters_form))
									(if
										(:doc "Malformed parameter declarations retain their defining file and span.")
										(u32.gtz (struct.get checked error))
										(then (return (call signatures_result next_function next_param next_record entry file
											(i32.sub (struct.get checked start) source_base)
											(i32.sub (struct.get checked end) source_base) (struct.get checked error))))))
								(else
									(let registered (call register_function (borrow-shared arena) (borrow-shared nodes)
										declaration scope (borrow-mut functions) next_function
										(borrow-mut parameters) next_param (borrow-shared records)
										(borrow-shared bindings)))
									(let error (struct.get registered error))
									(if
										(:doc "Translate a rejected signature's span back to its defining file.")
										(u32.gtz error)
										(then (return (call signatures_result next_function next_param next_record entry file
											(i32.sub (struct.get registered start) source_base)
											(i32.sub (struct.get registered end) source_base)
											error))))
									(let function (array.load functions next_function))
									(if
										(:doc "An ordinary executable uses main from the root file.")
										(struct.get function entry)
										(then (set entry declaration)))
									(set next_param (struct.get registered operand))
									(set next_function (i32.inc next_function))))))
					(set index (i32.inc index))))
			(if
				(:doc "Only the ordinary executable root requires a source main.")
				(bool.and entry_module (i32.ltz entry))
				(then (return (call signatures_result next_function next_param next_record entry file
					(struct.get module start) (struct.get module end) 22u32))))
			(return (call signatures_result next_function next_param next_record entry -1i32
				0i32 0i32 0u32))))

	(fn copy_selections
		(:doc `Keep a file's selected declaration indices in its reserved range of the flat table.`)
		(params (declarations (shared-array SelectedDeclaration)) (count i32) (base i32)
			(selected (mut-array SelectedDeclaration)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Keep selected declaration rows in source order with their rebased node indices.")
				(i32.lt index count)
				(body
					(let declaration (array.load declarations index))
					(let node (struct.get declaration node))
					(array.store selected (i32.add base index)
						(struct.new SelectedDeclaration (node (i32.add base node)) (test (struct.get declaration test))))
					(set index (i32.inc index))))))

	(fn prepare_graph_file
		(:doc "Build one measured source tree and retain its active declarations for later graph-wide checking.")
		(params (source (shared-array u8)) (source_base i32) (tree ScalarTree)
			(file i32) (active bool) (context SelectionContext) (flat (mut-array SourceNode))
			(selected (mut-array SelectedDeclaration)) (views (mut-array ModuleRead)))
		(returns GraphSignatures)
		(body
			(let rows (struct.get tree rows))
			(let checked (struct.new FormCheck (rows (u32.from-i32 rows))
				(start (struct.get tree start)) (end (struct.get tree end)) (error 0u32)))
			(let-mut nodes (array.alloc SourceNode rows))
			(let built (call build_source_tree (borrow-shared source) checked (borrow-mut nodes)))
			(if
				(:doc "A provider contributes a tree only after it has been built successfully.")
				(u32.gtz (struct.get built error))
				(then (return (call signatures_result 0i32 0i32 0i32 -1i32 file
					(struct.get built start) (struct.get built end) (struct.get built error)))))
			(let base (struct.get tree base))
			(call copy_tree (borrow-shared nodes) (borrow-mut flat) base source_base)
			(if
				(:doc "A bridge-only provider supplies its checked tree and contributes no local Wove declarations.")
				(bool.not active)
				(then (return (call signatures_result 0i32 0i32 0i32 -1i32 -1i32
					0i32 0i32 0u32))))
			(let-mut declarations (array.alloc SelectedDeclaration rows))
			(let module (call read_module_for_target (borrow-shared source) (borrow-shared nodes)
				built context (borrow-mut declarations)))
			(if
				(:doc "The source graph already checked admission, metadata, and selection for the same immutable bytes.")
				(u32.gtz (struct.get module error))
				(then (return (call signatures_result 0i32 0i32 0i32 -1i32 file
					(struct.get module start) (struct.get module end) (struct.get module error)))))
			(array.store views file module)
			(call copy_selections (borrow-shared declarations) (struct.get module count)
				base (borrow-mut selected))
			(return (call signatures_result 0i32 0i32 0i32 -1i32 -1i32
				0i32 0i32 0u32))))

	(fn register_graph_module_records
		(:doc "Register nominal and scalar fixed layouts in file order after resolving module constants.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(views (shared-array ModuleRead)) (selected (shared-array SelectedDeclaration)) (records (mut-array ScalarRecord)))
		(returns GraphSignatures)
		(body
			(let-mut next 0i32)
			(let-mut file 0i32)
			(while
				(:doc "Each file uses its own checked selections and definition namespace.")
				(i32.lt file (array.len files))
				(body
					(if
						(:doc "Only an active Wove module contributes nominal declarations.")
						(struct.get (array.load modules file) active)
						(then
							(let tree (array.load trees file))
							(let base (struct.get tree base))
							(let source_base (struct.get (array.load files file) source_start))
							(let count (struct.get (array.load views file) count))
							(let checked (call register_module_records (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared selected)
								count base source_base file (struct.get tree module_id)
								(borrow-mut records) next (borrow-shared bindings)))
							(if
								(:doc "Translate the layout diagnostic back to its original file coordinates.")
								(u32.gtz (struct.get checked error))
								(then (return (call signatures_result 0i32 0i32 next -1i32 file
									(i32.sub (struct.get checked start) source_base)
									(i32.sub (struct.get checked end) source_base) (struct.get checked error)))))
							(set next (struct.get checked operand))))
					(set file (i32.inc file))))
			(return (call signatures_result 0i32 0i32 next -1i32 -1i32 0i32 0i32 0u32))))

	(fn install_bridge_overlays
		(:doc "Restore each resolved bridge pair in the shared graph tree before checking type dependencies.")
		(params (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding)) (nodes (mut-array SourceNode)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "All aliases for one header repeat the same resolved pair.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(let defaults (struct.get binding default_file))
					(if
						(:doc "Restore an explicit type selection at the bridge-local use without publishing a module alias.")
						(bool.and (u32.eq (struct.get binding provider) c_dependency_provider)
							(i32.not-ltz (struct.get binding native_file)))
						(then
							(let owner (struct.get (array.load trees (struct.get binding owner)) base))
							(let target (struct.get (array.load trees (struct.get binding native_file)) base))
							(call connect_bridge_type (borrow-mut nodes)
								(i32.add owner (struct.get binding declaration))
								(i32.add target (struct.get binding native_type)))))
					(if
						(:doc "Standalone and complete replacement scopes have no peer.")
						(bool.and (call references_c_header binding) (i32.lt -1i32 defaults))
						(then
							(let primary_base (struct.get (array.load trees (struct.get binding header_file)) base))
							(let default_base (struct.get (array.load trees defaults) base))
							(call connect_bridge_overlay (borrow-mut nodes)
								(i32.add primary_base (struct.get binding bridge_node))
								(i32.add default_base (struct.get binding default_node)))))
					(set index (i32.inc index))))))

	(fn native_type_needs_layout
		(:doc "Record direct types, copyable results, and pointer typedef results requiring C checks.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (binding GraphBinding) (declaration i32))
		(returns bool)
		(body
			(if
				(:doc "Direct type selections and unowned types already have layout rows.")
				(bool.or (i32.ltz (struct.get binding drop_start))
					(u32.eq (struct.get binding namespace) 1u32))
				(then (return (bool true))))
			(let alias (call read_c_type (borrow-shared arena) (borrow-shared nodes)
				(array.load nodes declaration)))
			(return (call c_owner_uses_typedef (borrow-shared arena) (borrow-shared nodes) alias))))

	(fn register_graph_native_types
		(:doc `Collect the native value types required by direct selections and C signatures.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (start i32) (context SelectionContext))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let-mut next start)
			(while
				(:doc "A C binding can refer to a directly selected native type or a function signature.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(if
						(:doc "Ordinary Wove records already occupy their registered layout rows.")
						(u32.eq (struct.get binding provider) 8u32)
						(then
							(let file (struct.get binding file))
							(let base (struct.get (array.load trees file) base))
							(let alias (struct.get binding native_type))
							(if
								(:doc "Preserve native types selected directly or needed by a function's result.")
								(i32.gtz alias)
								(then
									(let owner (struct.get binding native_file))
									(let type_base (struct.get (array.load trees owner) base))
									(let type_row (i32.add type_base alias))
									(if
										(:doc "An implicit pointer typedef also needs its C contract checked.")
										(call native_type_needs_layout (borrow-shared arena) (borrow-shared nodes)
											binding type_row)
										(then (set next (call remember_native_type (borrow-shared arena)
											(borrow-shared nodes) owner type_base
											(struct.get (array.load files owner) source_start) type_row (borrow-mut records) next))))))
							(if
								(:doc "Inspect each C function's parameter types just once per defining declaration.")
								(call first_bridge_binding (borrow-shared bindings) index binding)
								(then (set next (call register_parameter_native_types (borrow-shared arena)
									(borrow-shared nodes) (i32.add base (struct.get binding declaration))
									(borrow-shared files) (borrow-shared trees) context (borrow-mut records) next))))))
					(set index (i32.inc index))))
			(return next)))

	(fn complete_native_records
		(:doc `Walk the native type table to closure, adding each nested view and alias once.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(trees (shared-array ScalarTree)) (records (mut-array ScalarRecord)) (first i32) (count i32) (context SelectionContext))
		(returns GraphSignatures)
		(body
			(let-mut index first)
			(let-mut next count)
			(while
				(:doc "Newly found record dependencies are appended for later visiting.")
				(i32.lt index next)
				(body
					(let row (array.load records index))
					(if
						(:doc "Only record views have fields to resolve.")
						(call is_native_record row)
						(then
							(let file (struct.get row file))
							(let base (struct.get (array.load trees file) base))
							(let checked (call register_record_dependencies (borrow-shared arena) (borrow-shared nodes)
								row base (borrow-shared files) (borrow-shared trees) context (borrow-mut records) next))
							(if
								(:doc "Report offsets relative to the provider that defines the field.")
								(u32.gtz (struct.get checked error))
								(then
									(let origin (call source_span_owner (borrow-shared files) (struct.get checked start) file))
									(let source_base (struct.get (array.load files origin) source_start))
									(return (call signatures_result 0i32 0i32 next -1i32 origin
										(i32.sub (struct.get checked start) source_base)
										(i32.sub (struct.get checked end) source_base)
										(struct.get checked error)))))
							(set next (struct.get checked operand))))
					(set index (i32.inc index))))
			(return (call signatures_result 0i32 0i32 next -1i32 -1i32 0i32 0i32 0u32))))

	(fn register_graph_signatures
		(:doc `Check the reached signatures in their original declaration order.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding)) (root i32) (nodes (shared-array SourceNode))
			(selected (shared-array SelectedDeclaration)) (views (shared-array ModuleRead))
			(functions (mut-array ScalarFunction)) (parameters (mut-array ScalarParameter))
			(records (shared-array ScalarRecord)) (next_record i32))
		(returns GraphSignatures)
		(body
			(let-mut next_function 0i32)
			(let-mut next_param 0i32)
			(let-mut entry -1i32)
			(let-mut file 0i32)
			(while
				(:doc "Register signatures in canonical file order after their imported layouts are available.")
				(i32.lt file (array.len files))
				(body
					(if
						(:doc "Only reached active files have a recorded declaration view.")
						(struct.get (array.load modules file) active)
						(then
							(let signatures (call register_file_signatures (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared selected) (array.load views file)
								(array.load files file) (array.load trees file) file
								root (borrow-mut functions) (borrow-mut parameters)
								(borrow-shared records) (borrow-shared bindings)
								(call signatures_result next_function next_param next_record entry
									-1i32 0i32 0i32 0u32)))
							(if
								(:doc "A failed signature retains the original file and source span.")
								(u32.gtz (struct.get signatures error))
								(then (return signatures)))
							(set next_function (struct.get signatures functions))
							(set next_param (struct.get signatures params))
							(set entry (struct.get signatures entry))))
					(set file (i32.inc file))))
			(return (call signatures_result next_function next_param next_record entry -1i32
				0i32 0i32 0u32))))

	(fn attach_c_arguments
		(:doc `Store each checked argument contract alongside its exact Wove parameter type.`)
		(params (arguments (shared-array CArgument)) (parameters (mut-array ScalarParameter)) (start i32))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The contract table follows the signature's formal parameter order.")
				(i32.lt index (array.len arguments))
				(body
					(let argument (array.load arguments index))
					(if
						(:doc "Scalar formals keep their ordinary native value ABI.")
						(bool.not (call is_c_value_mode (struct.get argument mode)))
						(then
							(let row (i32.add start index))
							(let previous (array.load parameters row))
							(array.store parameters row
								(struct.new ScalarParameter (name (struct.get previous name))
									(type (struct.get previous type)) (identity (struct.get previous identity))
									(c_mode (struct.get argument mode))
									(c_size (struct.get argument size)) (c_count (struct.get argument count))
									(extent (struct.get previous extent))))))
					(set index (i32.inc index))))))

	(fn checked_record_out_scratch
		(:doc "Match the record result to an exclusive native record place and a bounded mutable byte view.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(parameters (shared-array ScalarParameter)) (out CRecordOut) (record i32)
			(layout u32) (first i32) (limit i32)) (returns EntryRead)
		(body
			(let record_type (struct.get (array.load parameters record) type))
			(if
				(:doc "The record out slot points at the exact mutable caller record, including its native identity.")
				(bool.or (bool.not (call is_mutable_place_reference record_type))
					(u32.not-eq (call place_reference_target (borrow-shared records) record_type) layout))
				(then (return (call entry_at (array.load nodes (struct.get (array.load parameters record) name)) -1i32 23u32))))
			(let name (array.load nodes (struct.get out scratch)))
			(let scratch (call find_parameter (borrow-shared source) (borrow-shared nodes)
				name (borrow-shared parameters) first limit))
			(if (i32.ltz scratch) (then (return (call entry_at name -1i32 23u32))))
			(let buffer (array.load parameters scratch))
			(if
				(:doc "Use the checked c_bytes extent. A caller-backed record accepts one byte count by value.")
				(bool.or (u32.not-eq (struct.get buffer type) 38u32)
					(bool.or (bool.not (call is_c_bytes_mode (struct.get buffer c_mode)))
						(bool.or (i32.not-ltz (struct.get buffer c_size)) (i32.ltz (struct.get buffer c_count)))))
				(then (return (call entry_at name -1i32 23u32))))
			(let count (array.load parameters (i32.add first (struct.get buffer c_count))))
			(if
				(:doc "The bounded length is captured by value before the native call can mutate either store.")
				(call is_place_reference (struct.get count type))
				(then (return (call entry_at name -1i32 23u32))))
			(let status_name (array.load nodes (struct.get out status)))
			(let status (call find_parameter (borrow-shared source) (borrow-shared nodes)
				status_name (borrow-shared parameters) first limit))
			(if
				(:doc "The last Wove formal receives the original i32 status from C.")
				(i32.not-eq status (i32.dec limit))
				(then (return (call entry_at status_name -1i32 23u32))))
			(let param (array.load parameters status))
			(let type (struct.get param type))
			(if
				(:doc "The status place must be an ordinary non-null exclusive scalar argument.")
				(bool.or (bool.not (call is_mutable_place_reference type))
					(bool.or (u32.not-eq (call place_reference_target (borrow-shared records) type) 5u32)
						(bool.not (call is_c_value_mode (struct.get param c_mode)))))
				(then (return (call entry_at status_name -1i32 23u32))))
			(return (call entry_at name scratch 0u32))))

	(fn register_bridge_signature
		(:doc `Register a checked C bridge signature using the same parameter rows as Wove functions.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32) (resource i32) (copy_result bool) (scope FunctionScope) (context SelectionContext)
			(functions (mut-array ScalarFunction)) (index i32) (parameters (mut-array ScalarParameter)) (next_param i32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)))
		(returns EntryRead)
		(body
			(let node (array.load nodes declaration))
			(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) node))
			(let native (call c_function_opening (borrow-shared arena) (borrow-shared nodes) parts))
			(let name (struct.get native symbol))
			(let list (array.load nodes (struct.get native params)))
			(let result_form (array.load nodes (struct.get native result)))
			(let result (struct.get (call form_parts (borrow-shared arena) (borrow-shared nodes) result_form) operands))
			(let first (struct.get (call form_parts (borrow-shared arena) (borrow-shared nodes) list) operands))
			(let checked (call read_parameters (borrow-shared arena) (borrow-shared nodes) first
				(borrow-mut parameters) next_param (borrow-shared records)
				(borrow-shared bindings) scope 0u32 (call declaring_c_bridge (borrow-shared arena) (borrow-shared nodes) node) context))
			(if
				(:doc "Retain the original span if shared parameter validation fails.")
				(u32.gtz (struct.get checked error))
				(then (return checked)))
			(let limit (struct.get checked operand))
			(let arity (i32.sub limit next_param))
			(let-mut arguments (array.alloc CArgument arity))
			(let-mut parameter next_param)
			(let-mut storage (bool false))
			(while
				(:doc "Classify extent counts, scalar places, and native initialization loans.")
				(i32.lt parameter limit)
				(body
					(let param (array.load parameters parameter))
					(let type (struct.get param type))
					(let mode (struct.get param c_mode))
					(set storage (bool.or storage (call is_c_storage_mode mode)))
					(let-mut extent_type type)
					(let-mut scalar_ref 0u32)
					(if
						(:doc "Keep the access mode for built-in and native scalar places.")
						(call is_place_reference type)
						(then
							(let pointee (call place_reference_target (borrow-shared records) type))
							(if
								(:doc "Classify an extent loan using its exact pointee type.")
								(bool.not (call is_record_type pointee))
								(then
									(set extent_type pointee)
									(set scalar_ref 1u32)
									(if (call is_mutable_place_reference type) (then (set scalar_ref 2u32)))))))
					(let integer (bool.or (call is_builtin_integer extent_type) (call is_native_integer extent_type)))
					(let-mut owner_mode (call c_value_mode))
					(if
						(:doc "A shared opaque owner can lend the original handle slot through const void.")
						(bool.and (call is_native_owner type) (call is_c_value_mode mode))
						(then (set owner_mode c_shared_handle_slot_mode)))
					(if
						(:doc "A pointer handle initialization lends the pointer slot.")
						(u8.eq mode (call c_handle_mut_mode))
						(then (set owner_mode (call c_handle_init_mode))))
					(if
						(:doc "A storage initialization lends the address of the backing C object.")
						(u8.eq mode (call c_storage_mut_mode))
						(then (set owner_mode (call c_storage_init_mode))))
					(call mark_c_argument_type (borrow-mut arguments)
						(i32.sub parameter next_param) integer scalar_ref
						owner_mode)
					(set parameter (i32.inc parameter))))
			(let contracts (call read_c_arguments (borrow-shared arena) (borrow-shared nodes)
				parts first
				(call source_builtin_type (borrow-shared arena) (array.load nodes result))
				(borrow-mut arguments)))
			(if
				(:doc "Keep contract diagnostics tied to the original defining signature.")
				(u32.gtz (struct.get contracts error))
				(then (return (struct.new EntryRead (operand -1i32)
					(start (struct.get contracts start)) (end (struct.get contracts end))
					(error (struct.get contracts error)) (related -1i32)))))
			(let strings (struct.get contracts strings))
			(let extents (struct.get contracts extents))
			(let nulls (struct.get contracts nulls))
			(let void_pointer (struct.get contracts void_pointer))
			(let snapshot (call read_c_snapshot (borrow-shared arena) (borrow-shared nodes) parts
				(array.load nodes result)))
			(let projection (i32.not-ltz (struct.get snapshot from)))
			(if
				(:doc "A snapshot from an existing loan uses the one named shared native record formal.")
				projection
				(then
					(let origin (array.load nodes (struct.get snapshot from)))
					(let row (call find_parameter (borrow-shared arena) (borrow-shared nodes)
						origin (borrow-shared parameters) next_param limit))
					(if
						(:doc "Keep an unknown or ambiguous source at the from operand.")
						(bool.or (i32.not-eq arity 1i32) (i32.ltz row))
						(then (return (call entry_at origin -1i32 23u32))))
					(let type (struct.get (array.load parameters row) type))
					(if
						(:doc "The source uses the shared reference representation throughout the copy.")
						(bool.or (bool.not (call is_place_reference type)) (call is_mutable_place_reference type))
						(then (return (call entry_at origin -1i32 23u32))))
					(let layout (call place_reference_target (borrow-shared records) type))
					(if
						(:doc "Only an actual native record supplies the extent field and its C layout.")
						(bool.not (bool.and (call is_record_type layout)
							(call is_native_record (array.load records (call record_index layout)))))
						(then (return (call entry_at origin -1i32 23u32))))))
			(let drop (struct.get snapshot drop))
			(if
				(:doc "Only formals with native contracts need extra lowering information.")
				(bool.or void_pointer
					(bool.or (bool.or (i32.gtz (struct.get contracts initializers)) (struct.get contracts vectors))
						(bool.or (i32.gtz nulls) (bool.or (i32.gtz strings) (i32.gtz extents)))))
				(then (call attach_c_arguments (borrow-shared arguments) (borrow-mut parameters) next_param)))
			(let result_node (array.load nodes result))
			(let-mut result_type (call source_builtin_type (borrow-shared arena) result_node))
			(let from (struct.get result_node next_sibling))
			(let-mut return_source -1i32)
			(let-mut snapshot_schema -1i32)
			(let-mut snapshot_field (struct.get snapshot field))
			(let-mut return_scratch -1i32)
			(let out (call read_c_record_out (borrow-shared arena) (borrow-shared nodes) parts))
			(if
				(:doc "A malformed record-out marker keeps its original directive span.")
				(u32.gtz (struct.get out error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get out start))
					(end (struct.get out end)) (error (struct.get out error)) (related -1i32)))))
			(let caller_backed (i32.not-ltz (struct.get out scratch)))
			(if
				(:doc "A caller-backed result requires an explicit source and a fixed native function.")
				(bool.and caller_backed
					(bool.or (i32.ltz from) (bool.or (struct.get snapshot active)
						(bool.or (struct.get contracts macro) (bool.or (struct.get contracts handle_out)
							(i32.not-eqz (struct.get contracts variadic)))))))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get out start))
					(end (struct.get out end)) (error 23u32) (related -1i32)))))
			(if
				(:doc "A record snapshot produces the declared owned outcome before the native borrow expires.")
				(i32.not-ltz (struct.get snapshot record))
				(then
					(let mapping (call check_record_snapshot (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) node (struct.get snapshot record) result
						(struct.get scope file) (struct.get scope source_base)))
					(if
						(:doc "Keep a rejected projection or result type at its defining source span.")
						(u32.gtz (struct.get mapping error))
						(then (return (struct.new EntryRead (operand -1i32) (start (struct.get mapping start))
							(end (struct.get mapping end)) (error (struct.get mapping error)) (related -1i32)))))
					(set snapshot_schema (struct.get mapping schema))
					(set snapshot_field (struct.get mapping present))
					(set result_type (struct.get mapping type)))
				(else (if (struct.get snapshot active) (then (set result_type (call optional_byte_owner_type))))))
			(if
				(:doc "A checked native record borrow keeps the exact layout and lending parameter rows.")
				(i32.not-ltz from)
				(then
					(let provenance (call read_return_origin (borrow-shared arena) (borrow-shared nodes)
						(array.load nodes from) result_form))
					(let name (array.load nodes (struct.get provenance operand)))
					(set return_source (call find_parameter (borrow-shared arena) (borrow-shared nodes)
						name (borrow-shared parameters) next_param limit))
					(if (i32.ltz return_source) (then (return (call entry_at name -1i32 23u32))))
					(let target (call form_parts (borrow-shared arena) (borrow-shared nodes)
						(array.load nodes resource)))
					(let row (call find_native_node (borrow-shared records) (struct.get target name)))
					(if (i32.ltz row) (then (return (call entry_at result_node -1i32 23u32))))
					(let layout (call record_type row))
					(if
						(:doc "Both caller places remain exclusively lent until the optional result leaves scope.")
						caller_backed
						(then
							(let buffer (call checked_record_out_scratch (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared parameters) out return_source layout next_param limit))
							(if (u32.gtz (struct.get buffer error)) (then (return buffer)))
							(set return_scratch (struct.get buffer operand))
							(set result_type (call buffered_record_type layout (bool true))))
						(else
							(let param (array.load parameters return_source))
							(if
								(:doc "A direct native pointer result borrows its original handle exclusively.")
								(bool.not (bool.and (call is_native_owner (struct.get param type))
									(u8.eq (struct.get param c_mode) (call c_handle_mut_mode))))
								(then (return (call entry_at name -1i32 23u32))))
							(set result_type (call optional_record_borrow_type layout))))))
			(if
				(:doc "Use the defining native type for each selected result.")
				(bool.and (i32.gtz resource) (i32.ltz from))
				(then
					(if
						(:doc "Copyable aliases use their type-table row instead of an owner encoding.")
						copy_result
						(then
							(let target (call form_parts (borrow-shared arena) (borrow-shared nodes)
								(array.load nodes resource)))
							(let row (call find_native_node (borrow-shared records) (struct.get target name)))
							(if (i32.ltz row)
								(then (return (call entry_at (array.load nodes result) -1i32 23u32))))
							(set result_type (call native_row_type (borrow-shared records) row)))
						(else (set result_type (call native_owner_type resource))))))
			(let mapping (call read_c_record_in (borrow-shared arena) (borrow-shared nodes) parts node))
			(if (u32.gtz (struct.get mapping error)) (then (return mapping)))
			(if
				(:doc "The temporary native fields may be exposed only during an explicit scalar or void call.")
				(bool.and (i32.not-ltz (struct.get mapping operand))
						(bool.or (bool.not (bool.or (u32.eq result_type (call void_type))
							(bool.or (call is_builtin_integer result_type) (call is_native_integer result_type))))
							(bool.or (struct.get contracts macro)
								(bool.or (struct.get snapshot active) (i32.eq (struct.get contracts variadic) c_open_variadic_tail)))))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get mapping start))
					(end (struct.get mapping end)) (error 23u32) (related -1i32)))))
			(let input (call check_record_input (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared parameters) next_param limit (struct.get mapping operand)))
			(if
				(:doc "Report a mismatched formal or member at its original span.")
				(u32.gtz (struct.get input error))
				(then (return (struct.new EntryRead (operand -1i32) (start (struct.get input start))
					(end (struct.get input end)) (error (struct.get input error)) (related -1i32)))))
			(array.store functions index
				(struct.new ScalarFunction (c_name_slot 0i32) (declaration declaration) (origin declaration) (name name)
					(params next_param) (arity arity)
					(result result_type) (return_source return_source) (return_scratch return_scratch)
					(body -1i32) (first_statement -1i32) (identity 0u32) (entry (bool false))
					(c_strings strings) (c_vectors (struct.get contracts vectors)) (c_extents extents) (c_macro (struct.get contracts macro))
					(c_variadic (struct.get contracts variadic)) (c_nulls nulls) (c_storage storage) (c_handle_out (struct.get contracts handle_out))
					(c_void_pointer void_pointer)
					(c_snapshot (struct.get snapshot active)) (c_snapshot_drop drop)
					(c_snapshot_field snapshot_field) (c_snapshot_extent (struct.get snapshot extent))
					(c_snapshot_source projection) (c_snapshot_record snapshot_schema) (c_formals first)
					(c_input_record (struct.get input record)) (c_input_data (struct.get input data))
					(c_input_count (struct.get input count)) (c_input_pointer_name (struct.get input pointer_name))
					(c_input_count_name (struct.get input count_name))
					(c_fixed (i32.lt -1i32 (call find_c_fixed_formal (borrow-shared arena) (borrow-shared nodes) first)))
					(file (struct.get scope file)) (tree_base (struct.get scope tree_base))
					(name_base (struct.get scope tree_base))
					(tree_limit (struct.get scope tree_limit)) (source_base (struct.get scope source_base))))
			(return checked)))

	(fn register_graph_bridges
		(:doc `Append one native signature per selected defining declaration after the Wove signatures.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(functions (mut-array ScalarFunction)) (parameters (mut-array ScalarParameter))
			(records (shared-array ScalarRecord)) (wove GraphSignatures) (context SelectionContext))
		(returns GraphSignatures)
		(body
			(let-mut next_function (struct.get wove functions))
			(let-mut next_param (struct.get wove params))
			(let records_count (struct.get wove records))
			(let entry (struct.get wove entry))
			(let-mut index 0i32)
			(while
				(:doc "Multiple local bindings can refer to the same signature, including across importers.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(if
						(:doc "Only the first selection of a C definition registers its signature.")
						(call first_bridge_binding (borrow-shared bindings) index binding)
						(then
							(let file (struct.get binding file))
							(let tree (array.load trees file))
							(let base (struct.get tree base))
							(let source_base (struct.get (array.load files file) source_start))
							(let scope (struct.new FunctionScope (file file) (tree_base base)
								(tree_limit (i32.add base (struct.get tree rows)))
								(source_base source_base) (module_id 0u32) (entry_module (bool false))
								(mode (struct.get context mode))))
							(let-mut native -1i32)
							(if
								(:doc "A native result type may come from the other provider.")
								(i32.gtz (struct.get binding native_type))
								(then
									(let type_base (struct.get (array.load trees (struct.get binding native_file)) base))
									(set native (i32.add type_base (struct.get binding native_type)))))
							(let checked (call register_bridge_signature (borrow-shared arena) (borrow-shared nodes)
								(i32.add base (struct.get binding declaration))
								native (i32.ltz (struct.get binding drop_start)) scope context
								(borrow-mut functions) next_function
								(borrow-mut parameters) next_param
								(borrow-shared records) (borrow-shared bindings)))
							(if
								(:doc "Bridge signature spans belong to the provider, even if it has no Wove-file imports.")
								(u32.gtz (struct.get checked error))
								(then (return (call signatures_result next_function next_param
									records_count entry file
									(i32.sub (struct.get checked start) source_base)
									(i32.sub (struct.get checked end) source_base)
									(struct.get checked error)))))
							(set next_function (i32.inc next_function))
							(set next_param (struct.get checked operand))))
					(set index (i32.inc index))))
			(return (call signatures_result next_function next_param records_count
				entry -1i32 0i32 0i32 0u32))))

	(fn native_value_binding
		(:doc `Build the shared checked definition of a selected constant or foreign binding.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(binding GraphBinding) (trees (shared-array ScalarTree)) (definition i32))
		(returns ScalarStatement)
		(body
			(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes)
				(array.load nodes definition)))
			(let tag (call import_keyword (borrow-shared arena) (array.load nodes (struct.get parts head))))
			(let name (struct.get parts name))
			(let type_node (struct.get parts operands))
			(let-mut type (call scalar_type (borrow-shared arena) (borrow-shared nodes) type_node))
			(if
				(:doc "Reading an explicitly writable C string produces an independent optional byte owner.")
				(call is_optional_byte_owner (borrow-shared arena) (borrow-shared nodes)
					(array.load nodes type_node))
				(then (set type (call optional_byte_owner_type))))
			(if
				(:doc "A checked vector value produces a fresh owner when its C storage is read.")
				(call is_byte_rows_descriptor (borrow-shared arena) (borrow-shared nodes)
					(array.load nodes type_node))
				(then (set type (call byte_rows_owner_type))))
			(let native (struct.get binding native_type))
			(if
				(:doc "Keep native scalars and shared resources tied to their defining declarations.")
				(i32.gtz native)
				(then
					(let type_base (struct.get (array.load trees (struct.get binding native_file)) base))
					(let declaration (i32.add type_base native))
					(if
						(:doc "Only borrowed pointer resources refer to a type with a destructor.")
						(i32.lt -1i32 (struct.get binding drop_start))
						(then (set type (call native_owner_type declaration)))
						(else
							(let target (call form_parts (borrow-shared arena) (borrow-shared nodes) (array.load nodes declaration)))
							(let row (call find_native_node (borrow-shared records) (struct.get target name)))
							(set type (call native_row_type (borrow-shared records) row))))))
			(if
				(:doc "An expression macro declared as a constant lends the header's static bytes.")
				(bool.and (u32.eq tag 14u32) (struct.get binding value_macro))
				(then (set type 34u32)))
			(let-mut kind c_readonly_binding)
			(if (struct.get binding value_macro) (then (set kind c_macro_binding)))
			(if (u32.eq tag 14u32) (then (set kind c_constant_binding)))
			(if (u32.eq tag 15u32) (then (set kind c_writable_binding)))
			(return (struct.new ScalarStatement (kind kind) (target name) (value -1i32)
				(type type) (first -1i32) (previous_owner -1i32)
				(falls_through (bool false)) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn register_graph_value_aliases
		(:doc `Link imported Wove values and C header names to their checked defining rows.

		Store each alias at its original name node in the importer. Only the
		defining declaration can carry an initializer and emit storage.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(statements (mut-array ScalarStatement)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The resolved value namespace identifies each alias and its provider.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(let owner (struct.get binding owner))
					(let file (struct.get binding file))
					(let native (u32.eq (struct.get binding provider) 8u32))
					(if
						(:doc "A selected C value can be declared in the same source file as its import.")
						(bool.and (u32.eq (struct.get binding namespace) 2u32)
							(bool.or native (i32.not-eq owner file)))
						(then
							(let base (struct.get (array.load trees owner) base))
							(let definition_base (struct.get (array.load trees file) base))
							(let name (i32.add base (struct.get binding name_node)))
							(let definition (i32.add definition_base (struct.get binding declaration)))
							(if
								(:doc "Each alias shares the original native spelling, type, and mutability.")
								native
								(then (array.store statements definition
									(call native_value_binding (borrow-shared arena) (borrow-shared nodes)
										(borrow-shared records) binding (borrow-shared trees) definition))))
							(let first (struct.get (array.load statements base) first))
							(array.store statements name
								(struct.new ScalarStatement (kind 63u32) (target name) (value definition)
									(type 0u32) (first first) (previous_owner -1i32)
									(falls_through (bool false)) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))
							(array.store statements base (call block_statement name -1i32 -1i32 (bool false)))))
					(set index (i32.inc index))))))

	(fn register_native_owner_aliases
		(:doc `Link selected native owner type names to their defining declarations for construction.`)
		(params (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding)) (expressions (mut-array ScalarExpression)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only a checked C type import can introduce a native owner.")
				(i32.lt index (array.len bindings))
				(body
					(let binding (array.load bindings index))
					(if
						(:doc "The existence of a destructor distinguishes owners from ordinary native types.")
						(bool.and (u32.eq (struct.get binding namespace) 1u32)
							(bool.and (u32.eq (struct.get binding provider) 8u32)
								(i32.lt -1i32 (struct.get binding drop_start))))
						(then
							(let file (array.load trees (struct.get binding file)))
							(let declaration (i32.add (struct.get file base) (struct.get binding declaration)))
							(let owner (array.load trees (struct.get binding owner)))
							(let name (i32.add (struct.get owner base) (struct.get binding name_node)))
							(array.store expressions name
								(call expression_row 0u32 (call native_owner_type declaration) -1i32 -1i32 0i32 0i32 (bool false)))))
					(set index (i32.inc index))))))

	(fn register_graph_specializations
		(:doc "Instantiate each active file’s applications after registering the graph’s defining templates.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(views (shared-array ModuleRead)) (selected (shared-array SelectedDeclaration))
			(records (mut-array ScalarRecord)) (start_record i32))
		(returns GraphSignatures)
		(body
			(let-mut next start_record)
			(let-mut file 0i32)
			(while
				(:doc "Each file resolves explicit arguments in its own import namespace.")
				(i32.lt file (array.len files))
				(body
					(if
						(:doc "Inactive files have no explicit type applications to check.")
						(struct.get (array.load modules file) active)
						(then
							(let base (struct.get (array.load trees file) base))
							(let source_base (struct.get (array.load files file) source_start))
							(let count (struct.get (array.load views file) count))
							(let checked (call register_module_specializations (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared selected) count base (call scope_at file source_base)
								(borrow-shared bindings) (borrow-mut records) next))
							(if
								(:doc "Preserve a rejected specialization at its original use site.")
								(u32.gtz (struct.get checked error))
								(then (return (call signatures_result 0i32 0i32 next -1i32 (struct.get checked file)
									(struct.get checked start) (struct.get checked end) (struct.get checked error)))))
							(set next (struct.get checked next))))
					(set file (i32.inc file))))
			(return (call signatures_result 0i32 0i32 next -1i32 -1i32 0i32 0i32 0u32))))

	(fn register_graph_record_arrays
		(:doc "Resolve fixed array elements after all active modules have registered their nominal types.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(views (shared-array ModuleRead)) (selected (shared-array SelectedDeclaration))
			(records (mut-array ScalarRecord)) (start_record i32))
		(returns GraphSignatures)
		(body
			(let-mut next start_record)
			(let-mut file 0i32)
			(while
				(:doc "Each active file contributes layouts in its own type and value namespaces.")
				(i32.lt file (array.len files))
				(body
					(if
						(:doc "Inactive files have no selected Wove array forms.")
						(struct.get (array.load modules file) active)
						(then
							(let base (struct.get (array.load trees file) base))
							(let source_base (struct.get (array.load files file) source_start))
							(let count (struct.get (array.load views file) count))
							(let checked (call register_module_record_arrays (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared selected) count base file source_base
								(borrow-shared bindings) (borrow-mut records) next))
							(if
								(:doc "Report an invalid extent in its original defining file.")
								(u32.gtz (struct.get checked error))
								(then (return (call signatures_result 0i32 0i32 next -1i32 file
									(i32.sub (struct.get checked start) source_base)
									(i32.sub (struct.get checked end) source_base) (struct.get checked error)))))
							(set next (struct.get checked operand))))
					(set file (i32.inc file))))
			(return (call signatures_result 0i32 0i32 next -1i32 -1i32 0i32 0i32 0u32))))

	(fn prepare_graph_values
		(:doc `Resolve immutable module initializers after all named layouts are complete.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(views (shared-array ModuleRead)) (selected (shared-array SelectedDeclaration))
			(records (mut-array ScalarRecord)) (start_record i32)
			(statements (mut-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns GraphSignatures)
		(body
			(let-mut next start_record)
			(let-mut file 0i32)
			(while
				(:doc "Check each reached active file against its own selected type names.")
				(i32.lt file (array.len files))
				(body
					(if
						(:doc "Bridge-only and excluded files have no Wove bindings to plan.")
						(struct.get (array.load modules file) active)
						(then
							(let tree (array.load trees file))
							(let base (struct.get tree base))
							(let source_base (struct.get (array.load files file) source_start))
							(let count (struct.get (array.load views file) count))
							(let checked (call register_module_bindings (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared selected)
								count base file source_base (struct.get tree module_id) (borrow-shared bindings)
								(borrow-mut records) next (borrow-mut statements) (borrow-mut expressions)))
							(if
								(:doc "Report errors at offsets from the initializer's defining file.")
								(u32.gtz (struct.get checked error))
								(then (return (call signatures_result 0i32 0i32 next -1i32 file
									(i32.sub (struct.get checked start) source_base)
									(i32.sub (struct.get checked end) source_base) (struct.get checked error)))))
							(set next (struct.get checked operand))))
					(set file (i32.inc file))))
			(return (call signatures_result 0i32 0i32 next -1i32 -1i32 0i32 0i32 0u32))))

	(fn register_function_instances
		(:doc "Read each requested runtime signature in the original template's lexical file.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(trees (shared-array ScalarTree)) (views (shared-array ModuleRead)) (instances (shared-array FunctionInstance)) (instance_count i32)
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)) (functions (mut-array ScalarFunction))
			(parameters (mut-array ScalarParameter)) (initial GraphSignatures)) (returns GraphSignatures)
		(body
			(let-mut count (struct.get initial functions))
			(let-mut params (struct.get initial params))
			(let records_used (struct.get initial records))
			(let entry (struct.get initial entry))
			(let-mut row 0i32)
			(while
				(:doc "Each new signature occupies one slot after the ordinary Wove definitions.")
				(i32.lt row instance_count)
				(body
					(let instance (array.load instances row))
					(let file (struct.get instance file))
					(let base (struct.get (array.load trees file) base))
					(let source_base (struct.get (array.load files file) source_start))
					(let scope (struct.new FunctionScope (file file) (tree_base base)
						(tree_limit (struct.get instance end)) (source_base source_base) (module_id 0u32)
						(entry_module (bool false)) (mode (struct.get (array.load views file) mode))))
					(let checked (call register_concrete_function (borrow-shared arena) (borrow-shared nodes)
						(struct.get instance declaration) (struct.get instance original) (struct.get instance identity) scope
						(borrow-mut functions) count (borrow-mut parameters) params
						(borrow-shared records) (borrow-shared bindings)))
					(if
						(:doc "A specialized signature points to the original definition.")
						(u32.gtz (struct.get checked error))
						(then (return (call signatures_result count params records_used entry file
							(i32.sub (struct.get checked start) source_base)
							(i32.sub (struct.get checked end) source_base) (struct.get checked error)))))
					(set params (struct.get checked operand))
					(set count (i32.inc count))
					(set row (i32.inc row))))
			(return (call signatures_result count params records_used entry -1i32 0i32 0i32 0u32))))

	(fn register_graph_owned_rows
		(:doc "Resolve nested owner types in the file or instantiated function that contains their descriptors.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(instances (shared-array FunctionInstance)) (instance_count i32) (records (mut-array ScalarRecord)) (start i32))
		(returns GraphSignatures)
		(body
			(let-mut next start)
			(let-mut file 0i32)
			(while
				(:doc "Bridge-only and inactive modules cannot declare Wove array owners.")
				(i32.lt file (array.len files))
				(body
					(if
						(:doc "The original file's tree indices are already rebased.")
						(struct.get (array.load modules file) active)
						(then
							(let tree (array.load trees file))
							(let base (struct.get tree base))
							(let source_base (struct.get (array.load files file) source_start))
							(let checked (call register_owned_rows (borrow-shared arena) (borrow-shared nodes)
								base (i32.add base (struct.get tree rows)) (borrow-shared bindings)
								(call scope_at file source_base) (borrow-mut records) next))
							(if
								(:doc "A full layout table reports the original descriptor's span.")
								(u32.gtz (struct.get checked error))
								(then (return (call signatures_result 0i32 0i32 next -1i32 file
									(i32.sub (struct.get checked start) source_base)
									(i32.sub (struct.get checked end) source_base) (struct.get checked error)))))
							(set next (struct.get checked operand))))
					(set file (i32.inc file))))
			(let-mut row 0i32)
			(while
				(:doc "Concrete function clones can introduce owners of substituted types.")
				(i32.lt row instance_count)
				(body
					(let instance (array.load instances row))
					(let owner (struct.get instance file))
					(let source_base (struct.get (array.load files owner) source_start))
					(let checked (call register_owned_rows (borrow-shared arena) (borrow-shared nodes)
						(struct.get instance declaration) (struct.get instance end) (borrow-shared bindings)
						(call scope_at owner source_base) (borrow-mut records) next))
					(if
						(:doc "Keep clone diagnostics in the original defining file.")
						(u32.gtz (struct.get checked error))
						(then (return (call signatures_result 0i32 0i32 next -1i32 owner
							(i32.sub (struct.get checked start) source_base)
							(i32.sub (struct.get checked end) source_base) (struct.get checked error)))))
					(set next (struct.get checked operand))
					(set row (i32.inc row))))
			(return (call signatures_result 0i32 0i32 next -1i32 -1i32 0i32 0i32 0u32))))

	(fn prepare_graph
		(:doc `Collect every defining layout before any reached function signature uses it.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(trees (mut-array ScalarTree)) (bindings (mut-array GraphBinding)) (root i32) (context SelectionContext) (nodes (mut-array SourceNode))
			(functions (mut-array ScalarFunction)) (parameters (mut-array ScalarParameter)) (records (mut-array ScalarRecord))
			(statements (mut-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns GraphSignatures)
		(body
			(let-mut selected (array.alloc SelectedDeclaration (array.len nodes)))
			(let-mut views (array.alloc ModuleRead (array.len files)))
			(let-mut file 0i32)
			(while
				(:doc "Use one layout per definition in the canonical file table.")
				(i32.lt file (array.len files))
				(body
					(let tree (array.load trees file))
					(if
						(:doc "Build every reserved tree and collect Wove declarations only in active modules.")
						(i32.gtz (struct.get tree rows))
						(then
							(let input (array.load files file))
							(let active (struct.get (array.load modules file) active))
							(let checked (call prepare_graph_file
								(borrow-shared (array.range arena (struct.get input source_start)
									(struct.get input source_end)))
								(struct.get input source_start) tree file
								active context
								(borrow-mut nodes) (borrow-mut selected) (borrow-mut views)))
							(if
								(:doc "Stop at the originating file if its tree or selection fails.")
								(u32.gtz (struct.get checked error))
								(then (return checked)))
							(if
								(:doc "Cache one key for definitions and specializations in the module.")
								active
								(then (array.store trees file (call named_module_tree (borrow-shared arena)
									(borrow-shared nodes) (array.load views file) input tree))))))
					(set file (i32.inc file))))
			(let constants (call register_integer_constants (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared files) (borrow-shared trees) (borrow-mut bindings)))
			(if
				(:doc "Report the constant's defining file and its original source-relative span.")
				(u32.gtz (struct.get constants error))
				(then
					(let origin (struct.get constants file))
					(let base (struct.get (array.load files origin) source_start))
					(return (call signatures_result 0i32 0i32 0i32 -1i32 origin
						(i32.sub (struct.get constants start) base)
						(i32.sub (struct.get constants end) base) (struct.get constants error)))))
			(let module_records (call register_graph_module_records
				(borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
				(borrow-shared modules) (borrow-shared trees) (borrow-shared bindings)
				(borrow-shared views) (borrow-shared selected) (borrow-mut records)))
			(if
				(:doc "Fixed layouts may use any already evaluated constant in the file's namespace.")
				(u32.gtz (struct.get module_records error))
				(then (return module_records)))
			(let-mut next_record (struct.get module_records records))
			(call install_bridge_overlays (borrow-shared trees) (borrow-shared bindings) (borrow-mut nodes))
			(let native_count (call register_graph_native_types (borrow-shared arena)
				(borrow-shared nodes) (borrow-shared files) (borrow-shared trees) (borrow-shared bindings)
				(borrow-mut records) next_record context))
			(let views_checked (call complete_native_records (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared files) (borrow-shared trees) (borrow-mut records)
				next_record native_count context))
			(if
				(:doc "Resolve all native field types before planning functions that read them.")
				(u32.gtz (struct.get views_checked error))
				(then (return views_checked)))
			(let templates (call validate_record_template_constants (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) (struct.get views_checked records)))
			(if
				(:doc "Resolve enum formal types before applying an imported record template.")
				(u32.gtz (struct.get templates error))
				(then (return (call signatures_result 0i32 0i32 next_record -1i32 (struct.get templates file)
					(struct.get templates start) (struct.get templates end) (struct.get templates error)))))
			(let instances (call register_graph_specializations (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) (borrow-shared modules) (borrow-shared trees)
				(borrow-shared bindings) (borrow-shared views) (borrow-shared selected)
				(borrow-mut records) (struct.get views_checked records)))
			(if
				(:doc "A malformed application stops before any signature or field dependency can use it.")
				(u32.gtz (struct.get instances error))
				(then (return instances)))
			(let arrays (call register_graph_record_arrays (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) (borrow-shared modules) (borrow-shared trees)
				(borrow-shared bindings) (borrow-shared views) (borrow-shared selected)
				(borrow-mut records) (struct.get instances records)))
			(if
				(:doc "Resolve every record element and extent before scheduling layout dependencies.")
				(u32.gtz (struct.get arrays error))
				(then (return arrays)))
			(set next_record (struct.get arrays records))
			(let instance_capacity (i32.sub (array.len functions) (call signature_capacity (borrow-shared bindings))))
			(let-mut function_instances (array.alloc FunctionInstance instance_capacity))
			(let-mut function_count 0i32)
			(if
				(:doc "Only source containing function applications needs the instance discovery pass.")
				(i32.gtz instance_capacity)
				(then
					(let expanded (call expand_graph_functions (borrow-shared arena) (borrow-mut nodes) (borrow-mut records)
						(borrow-shared bindings) (borrow-shared files) (borrow-shared trees)
						(borrow-shared modules) (borrow-shared views) (borrow-shared selected) root
						(borrow-mut function_instances) next_record))
					(if
						(:doc "An invalid or unavailable application retains its original file and span.")
						(u32.gtz (struct.get expanded error))
						(then (return (call signatures_result 0i32 0i32 next_record -1i32
							(struct.get expanded file) (struct.get expanded start) (struct.get expanded end)
							(struct.get expanded error)))))
					(set next_record (struct.get expanded records))
					(set function_count (struct.get expanded count))))
			(let layouts (call order_record_layouts (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-mut records) next_record))
			(if
				(:doc "Keep field type and cycle errors in their defining file.")
				(u32.gtz (struct.get layouts error))
				(then (return (call signatures_result 0i32 0i32 next_record -1i32
					(struct.get layouts file) (struct.get layouts start) (struct.get layouts end)
					(struct.get layouts error)))))
			(let owners (call register_graph_owned_rows (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared files) (borrow-shared modules) (borrow-shared trees) (borrow-shared bindings)
				(borrow-shared function_instances) function_count (borrow-mut records) next_record))
			(if
				(:doc "Finish row identities before checking any type that refers to them.")
				(u32.gtz (struct.get owners error))
				(then (return owners)))
			(let fields (call validate_record_array_fields (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared records) next_record))
			(if
				(:doc "After row interning, every array field must resolve in its defining module.")
				(u32.gtz (struct.get fields error))
				(then (return (call signatures_result 0i32 0i32 next_record -1i32
					(struct.get fields file) (struct.get fields start) (struct.get fields end)
					(struct.get fields error)))))
			(set next_record (struct.get owners records))
			(let values (call prepare_graph_values (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) (borrow-shared modules) (borrow-shared trees)
				(borrow-shared bindings) (borrow-shared views) (borrow-shared selected)
				(borrow-mut records) next_record (borrow-mut statements) (borrow-mut expressions)))
			(if
				(:doc "Complete immutable value definitions before binding aliases to them.")
				(u32.gtz (struct.get values error))
				(then (return values)))
			(set next_record (struct.get values records))
			(call register_graph_value_aliases (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared trees) (borrow-shared bindings)
				(borrow-mut statements))
			(call register_native_owner_aliases
				(borrow-shared trees) (borrow-shared bindings) (borrow-mut expressions))
			(let wove (call register_graph_signatures (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-shared trees) (borrow-shared bindings) root
				(borrow-shared nodes) (borrow-shared selected) (borrow-shared views)
				(borrow-mut functions) (borrow-mut parameters) (borrow-shared records) next_record))
			(if
				(:doc "Keep the first Wove signature error before registering native targets.")
				(u32.gtz (struct.get wove error))
				(then (return wove)))
			(let specialized (call register_function_instances (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared files) (borrow-shared trees) (borrow-shared views)
				(borrow-shared function_instances) function_count
				(borrow-shared bindings) (borrow-shared records) (borrow-mut functions)
				(borrow-mut parameters) wove))
			(if
				(:doc "Finish all instantiated Wove signatures before registering native calls.")
				(u32.gtz (struct.get specialized error))
				(then (return specialized)))
			(call assign_c_names (borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared function_instances) (struct.get wove functions)
				(borrow-mut functions) (struct.get specialized functions) (borrow-mut records) (borrow-mut expressions))
			(return (call register_graph_bridges (borrow-shared arena) (borrow-shared files)
				(borrow-shared trees) (borrow-shared nodes) (borrow-shared bindings)
				(borrow-mut functions) (borrow-mut parameters) (borrow-shared records) specialized context)))))
