							(let checked (call register_module_record_arrays (borrow-shared (local arena)) (borrow-shared (local nodes))
								(borrow-shared (local selected)) (local count) (local base) (local file) (local source_base)
								(borrow-shared (local bindings)) (borrow-mut (local records)) (local next)))
							(if
								(:doc "Report an invalid extent in its original defining file.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (call signatures_result 0i32 0i32 (local next) -1i32 (local file)
									(i32.sub (struct.get (local checked) start) (local source_base))
									(i32.sub (struct.get (local checked) end) (local source_base)) (struct.get (local checked) error)))))
							(set (local next) (struct.get (local checked) operand))))
					(set (local file) (i32.inc (local file)))))
			(return (call signatures_result 0i32 0i32 (local next) -1i32 -1i32 0i32 0i32 0u32))))

	(fn prepare_graph_values
		(:doc `Resolve immutable module initializers after all named layouts are complete.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(views (shared-array ModuleRead)) (selected (shared-array SelectedDeclaration))
			(records (mut-array ScalarRecord)) (start_record i32)
			(statements (mut-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns GraphSignatures)
		(body
			(let-mut next (local start_record))
			(let-mut file 0i32)
			(while
				(:doc "Check each reached active file against its own selected type names.")
				(i32.lt (local file) (array.len (local files)))
				(body
					(if
						(:doc "Bridge-only and excluded files have no Wove bindings to plan.")
						(struct.get (array.load (local modules) (local file)) active)
						(then
							(let base (struct.get (array.load (local trees) (local file)) base))
							(let source_base (struct.get (array.load (local files) (local file)) source_start))
							(let count (struct.get (array.load (local views) (local file)) count))
							(let checked (call register_module_bindings (borrow-shared (local arena)) (borrow-shared (local nodes))
								(borrow-shared (local selected))
								(local count) (local base) (local file) (local source_base) (borrow-shared (local bindings))
								(borrow-mut (local records)) (local next) (borrow-mut (local statements)) (borrow-mut (local expressions))))
							(if
								(:doc "Report errors at offsets from the initializer's defining file.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (call signatures_result 0i32 0i32 (local next) -1i32 (local file)
									(i32.sub (struct.get (local checked) start) (local source_base))
									(i32.sub (struct.get (local checked) end) (local source_base)) (struct.get (local checked) error)))))
							(set (local next) (struct.get (local checked) operand))))
					(set (local file) (i32.inc (local file)))))
			(return (call signatures_result 0i32 0i32 (local next) -1i32 -1i32 0i32 0i32 0u32))))

	(fn register_function_instances
		(:doc "Read each requested runtime signature in the original template's lexical file.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(trees (shared-array ScalarTree)) (views (shared-array ModuleRead)) (instances (shared-array FunctionInstance)) (instance_count i32)
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)) (functions (mut-array ScalarFunction))
			(parameters (mut-array ScalarParameter)) (initial GraphSignatures)) (returns GraphSignatures)
		(body
			(let-mut count (struct.get (local initial) functions))
			(let-mut params (struct.get (local initial) params))
			(let records_used (struct.get (local initial) records))
			(let entry (struct.get (local initial) entry))
			(let-mut row 0i32)
			(while
				(:doc "Each new signature occupies one slot after the ordinary Wove definitions.")
				(i32.lt (local row) (local instance_count))
				(body
					(let instance (array.load (local instances) (local row)))
					(let file (struct.get (local instance) file))
					(let base (struct.get (array.load (local trees) (local file)) base))
					(let source_base (struct.get (array.load (local files) (local file)) source_start))
					(let scope (struct.new FunctionScope (file (local file)) (tree_base (local base))
						(tree_limit (struct.get (local instance) end)) (source_base (local source_base)) (module_id 0u32)
						(entry_module (bool false)) (mode (struct.get (array.load (local views) (local file)) mode))))
					(let checked (call register_concrete_function (borrow-shared (local arena)) (borrow-shared (local nodes))
						(struct.get (local instance) declaration) (struct.get (local instance) original) (struct.get (local instance) identity) (local scope)
						(borrow-mut (local functions)) (local count) (borrow-mut (local parameters)) (local params)
						(borrow-shared (local records)) (borrow-shared (local bindings))))
					(if
						(:doc "A specialized signature points to the original definition.")
						(u32.gtz (struct.get (local checked) error))
						(then (return (call signatures_result (local count) (local params) (local records_used) (local entry) (local file)
							(i32.sub (struct.get (local checked) start) (local source_base))
							(i32.sub (struct.get (local checked) end) (local source_base)) (struct.get (local checked) error)))))
					(set (local params) (struct.get (local checked) operand))
					(set (local count) (i32.inc (local count)))
					(set (local row) (i32.inc (local row)))))
			(return (call signatures_result (local count) (local params) (local records_used) (local entry) -1i32 0i32 0i32 0u32))))

	(fn register_graph_owned_rows
		(:doc "Resolve nested owner types in the file or instantiated function that contains their descriptors.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(instances (shared-array FunctionInstance)) (instance_count i32) (records (mut-array ScalarRecord)) (start i32))
		(returns GraphSignatures)
		(body
			(let-mut next (local start))
			(let-mut file 0i32)
			(while
				(:doc "Bridge-only and inactive modules cannot declare Wove array owners.")
				(i32.lt (local file) (array.len (local files)))
				(body
					(if
						(:doc "The original file's tree indices are already rebased.")
						(struct.get (array.load (local modules) (local file)) active)
						(then
							(let tree (array.load (local trees) (local file)))
							(let base (struct.get (local tree) base))
							(let source_base (struct.get (array.load (local files) (local file)) source_start))
							(let checked (call register_owned_rows (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local base) (i32.add (local base) (struct.get (local tree) rows)) (borrow-shared (local bindings))
								(call scope_at (local file) (local source_base)) (borrow-mut (local records)) (local next)))
							(if
								(:doc "A full layout table reports the original descriptor's span.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (call signatures_result 0i32 0i32 (local next) -1i32 (local file)
									(i32.sub (struct.get (local checked) start) (local source_base))
									(i32.sub (struct.get (local checked) end) (local source_base)) (struct.get (local checked) error)))))
							(set (local next) (struct.get (local checked) operand))))
					(set (local file) (i32.inc (local file)))))
			(let-mut row 0i32)
			(while
				(:doc "Concrete function clones can introduce owners of substituted types.")
				(i32.lt (local row) (local instance_count))
				(body
					(let instance (array.load (local instances) (local row)))
					(let owner (struct.get (local instance) file))
					(let source_base (struct.get (array.load (local files) (local owner)) source_start))
					(let checked (call register_owned_rows (borrow-shared (local arena)) (borrow-shared (local nodes))
						(struct.get (local instance) declaration) (struct.get (local instance) end) (borrow-shared (local bindings))
						(call scope_at (local owner) (local source_base)) (borrow-mut (local records)) (local next)))
					(if
						(:doc "Keep clone diagnostics in the original defining file.")
						(u32.gtz (struct.get (local checked) error))
						(then (return (call signatures_result 0i32 0i32 (local next) -1i32 (local owner)
							(i32.sub (struct.get (local checked) start) (local source_base))
							(i32.sub (struct.get (local checked) end) (local source_base)) (struct.get (local checked) error)))))
					(set (local next) (struct.get (local checked) operand))
					(set (local row) (i32.inc (local row)))))
			(return (call signatures_result 0i32 0i32 (local next) -1i32 -1i32 0i32 0i32 0u32))))

	(fn prepare_graph
		(:doc `Collect every defining layout before any reached function signature uses it.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding)) (root i32) (context SelectionContext) (nodes (mut-array SourceNode))
			(functions (mut-array ScalarFunction)) (parameters (mut-array ScalarParameter)) (records (mut-array ScalarRecord))
			(statements (mut-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns GraphSignatures)
		(body
			(let-mut selected (array.alloc SelectedDeclaration (array.len (local nodes))))
			(let-mut views (array.alloc ModuleRead (array.len (local files))))
			(let-mut next_record 0i32)
			(let-mut file 0i32)
			(while
				(:doc "Use one layout per definition in the canonical file table.")
				(i32.lt (local file) (array.len (local files)))
				(body
					(let tree (array.load (local trees) (local file)))
					(if
						(:doc "Build every reserved tree and collect Wove declarations only in active modules.")
						(i32.gtz (struct.get (local tree) rows))
						(then
							(let input (array.load (local files) (local file)))
							(let checked (call prepare_graph_file (borrow-shared (local arena))
								(borrow-shared (array.range (local arena) (struct.get (local input) source_start)
									(struct.get (local input) source_end)))
								(local input) (local tree) (local file) (struct.get (array.load (local modules) (local file)) active) (local context)
								(borrow-mut (local nodes)) (borrow-mut (local selected)) (borrow-mut (local views))
								(borrow-mut (local records)) (local next_record) (borrow-shared (local bindings))))
							(if
								(:doc "Stop at the originating file if a reached record layout is invalid.")
								(u32.gtz (struct.get (local checked) error))
								(then (return (local checked))))
							(set (local next_record) (struct.get (local checked) records))))
					(set (local file) (i32.inc (local file)))))
			(call install_bridge_overlays (borrow-shared (local trees)) (borrow-shared (local bindings)) (borrow-mut (local nodes)))
			(let native_count (call register_graph_native_types (borrow-shared (local arena))
				(borrow-shared (local nodes)) (borrow-shared (local trees)) (borrow-shared (local bindings))
				(borrow-mut (local records)) (local next_record) (local context)))
			(let views_checked (call complete_native_records (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local files)) (borrow-shared (local trees)) (borrow-mut (local records))
				(local next_record) (local native_count) (local context)))
			(if
				(:doc "Resolve all native field types before planning functions that read them.")
				(u32.gtz (struct.get (local views_checked) error))
				(then (return (local views_checked))))
			(let templates (call validate_record_template_constants (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (struct.get (local views_checked) records)))
			(if
				(:doc "Resolve enum formal types before applying an imported record template.")
				(u32.gtz (struct.get (local templates) error))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32 (struct.get (local templates) file)
					(struct.get (local templates) start) (struct.get (local templates) end) (struct.get (local templates) error)))))
			(let instances (call register_graph_specializations (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local nodes)) (borrow-shared (local modules)) (borrow-shared (local trees))
				(borrow-shared (local bindings)) (borrow-shared (local views)) (borrow-shared (local selected))
				(borrow-mut (local records)) (struct.get (local views_checked) records)))
			(if
				(:doc "A malformed application stops before any signature or field dependency can use it.")
				(u32.gtz (struct.get (local instances) error))
				(then (return (local instances))))
			(let arrays (call register_graph_record_arrays (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local nodes)) (borrow-shared (local modules)) (borrow-shared (local trees))
				(borrow-shared (local bindings)) (borrow-shared (local views)) (borrow-shared (local selected))
				(borrow-mut (local records)) (struct.get (local instances) records)))
			(if
				(:doc "Resolve every record element and extent before scheduling layout dependencies.")
				(u32.gtz (struct.get (local arrays) error))
				(then (return (local arrays))))
			(set (local next_record) (struct.get (local arrays) records))
			(let instance_capacity (i32.sub (array.len (local functions)) (call signature_capacity (borrow-shared (local bindings)))))
			(let-mut function_instances (array.alloc FunctionInstance (local instance_capacity)))
			(let-mut function_count 0i32)
			(if
				(:doc "Only source containing function applications needs the instance discovery pass.")
				(i32.gtz (local instance_capacity))
				(then
					(let expanded (call expand_graph_functions (borrow-shared (local arena)) (borrow-mut (local nodes)) (borrow-mut (local records))
						(borrow-shared (local bindings)) (borrow-shared (local files)) (borrow-shared (local trees))
						(borrow-shared (local modules)) (borrow-shared (local views)) (borrow-shared (local selected))
						(borrow-mut (local function_instances)) (local next_record)))
					(if
						(:doc "An invalid or unavailable application retains its original file and span.")
						(u32.gtz (struct.get (local expanded) error))
						(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32
							(struct.get (local expanded) file) (struct.get (local expanded) start) (struct.get (local expanded) end)
							(struct.get (local expanded) error)))))
					(set (local next_record) (struct.get (local expanded) records))
					(set (local function_count) (struct.get (local expanded) count))))
			(let layouts (call order_record_layouts (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local bindings)) (borrow-mut (local records)) (local next_record)))
			(if
				(:doc "Keep field type and cycle errors in their defining file.")
				(u32.gtz (struct.get (local layouts) error))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32
					(struct.get (local layouts) file) (struct.get (local layouts) start) (struct.get (local layouts) end)
					(struct.get (local layouts) error)))))
			(let owners (call register_graph_owned_rows (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local files)) (borrow-shared (local modules)) (borrow-shared (local trees)) (borrow-shared (local bindings))
				(borrow-shared (local function_instances)) (local function_count) (borrow-mut (local records)) (local next_record)))
			(if
				(:doc "Finish row identities before checking any type that refers to them.")
				(u32.gtz (struct.get (local owners) error))
				(then (return (local owners))))
			(let fields (call validate_record_array_fields (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local bindings)) (borrow-shared (local records)) (local next_record)))
			(if
				(:doc "After row interning, every array field must resolve in its defining module.")
				(u32.gtz (struct.get (local fields) error))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32
					(struct.get (local fields) file) (struct.get (local fields) start) (struct.get (local fields) end)
					(struct.get (local fields) error)))))
			(set (local next_record) (struct.get (local owners) records))
			(let values (call prepare_graph_values (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local nodes)) (borrow-shared (local modules)) (borrow-shared (local trees))
				(borrow-shared (local bindings)) (borrow-shared (local views)) (borrow-shared (local selected))
				(borrow-mut (local records)) (local next_record) (borrow-mut (local statements)) (borrow-mut (local expressions))))
			(if
				(:doc "Complete immutable value definitions before binding aliases to them.")
				(u32.gtz (struct.get (local values) error))
				(then (return (local values))))
			(set (local next_record) (struct.get (local values) records))
			(call register_graph_value_aliases (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local trees)) (borrow-shared (local bindings))
				(borrow-mut (local statements)))
			(call register_native_owner_aliases
				(borrow-shared (local trees)) (borrow-shared (local bindings)) (borrow-mut (local expressions)))
			(let wove (call register_graph_signatures (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local trees)) (borrow-shared (local bindings)) (local root)
				(borrow-shared (local nodes)) (borrow-shared (local selected)) (borrow-shared (local views))
				(borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-shared (local records)) (local next_record)))
			(if
				(:doc "Keep the first Wove signature error before registering native targets.")
				(u32.gtz (struct.get (local wove) error))
				(then (return (local wove))))
			(let specialized (call register_function_instances (borrow-shared (local arena)) (borrow-shared (local nodes))
				(borrow-shared (local files)) (borrow-shared (local trees)) (borrow-shared (local views))
				(borrow-shared (local function_instances)) (local function_count)
				(borrow-shared (local bindings)) (borrow-shared (local records)) (borrow-mut (local functions))
				(borrow-mut (local parameters)) (local wove)))
			(if
				(:doc "Finish all instantiated Wove signatures before registering native calls.")
				(u32.gtz (struct.get (local specialized) error))
				(then (return (local specialized))))
			(return (call register_graph_bridges (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local trees)) (borrow-shared (local nodes)) (borrow-shared (local bindings))
				(borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-shared (local records)) (local specialized) (local context))))))
