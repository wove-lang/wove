(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Prepare scalar signatures from the active files in a resolved source graph.

	Flatten the checked trees into one table so the scalar planner and C
	writer can use direct node indices. Keep each function's original file
	and tree base for binding, call-site identity, and diagnostics. Use the
	canonical virtual path and declared module name to namespace C identities.`)
	scalar_graph

	(use wove-file "../source/scan.wove" (only check_source_form build_source_tree (type FormCheck) (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts read_module (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../source/imports.wove" (only import_keyword))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only (type GraphModule) (type GraphBinding)))
	(use wove-file "../emit/names.wove" (only module_identity hash_spelling))
	(use wove-file "./records.wove" (only declaration_kind register_record (type ScalarRecord)))
	(use wove-file "./plan.wove" (only register_function (type ScalarFunction) (type ScalarParameter) (type FunctionScope)))

	(struct ScalarTree (fields (base i32) (rows i32) (start i32) (end i32)))
	(struct TreeLayout (fields (rows i32) (file i32) (start i32) (end i32) (error u32)))
	(struct GraphSignatures
		(fields (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32)))

	(fn
		(:doc `Keep the span of every reached module and reserve tree rows for active files.`)
		layout_trees
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile))
			(modules (shared-slice GraphModule)) (trees (mut-slice ScalarTree)))
		(returns TreeLayout)
		(body
			(let-mut file (i32 0))
			(let-mut total (i32 0))
			(while
				(:doc "Keep reached module spans even when selection excludes a file.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(let module (slice.load (local modules) (local file)))
					(if
						(:doc "A successful walk marks each reached canonical file complete.")
						(u32.eq (record.get (local module) state) (u32 2))
						(then
							(let input (slice.load (local files) (local file)))
							(let checked (call check_source_form
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start)
									(record.get (local input) source_end)))))
							(let error (record.get (local checked) error))
							(let start (record.get (local checked) start))
							(let end (record.get (local checked) end))
							(if
								(:doc "Keep the original source span if the supplied view fails its form check.")
								(u32.lt (u32 0) (local error))
								(then (return (record.make TreeLayout (rows (i32 0)) (file (local file))
									(start (local start)) (end (local end)) (error (local error))))))
							(let-mut count (i32 0))
							(if
								(:doc "Only active modules reserve space in the scalar tree.")
								(record.get (local module) active)
								(then
									(let rows (record.get (local checked) rows))
									(if
										(:doc "All tree indices must fit in a signed slice index.")
										(u32.lt (int.convert u32 (i32.sub.wrapping (i32 2147483647) (local total))) (local rows))
										(then (return (record.make TreeLayout (rows (i32 0)) (file (local file))
											(start (local start)) (end (local end)) (error (u32 16))))))
									(set (local count) (int.convert i32 (local rows)))))
							(slice.store (local trees) (local file) (record.make ScalarTree (base (local total))
								(rows (local count)) (start (local start)) (end (local end))))
							(set (local total) (i32.add.wrapping (local total) (local count)))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (record.make TreeLayout (rows (local total)) (file (i32 -1))
				(start (i32 0)) (end (i32 0)) (error (u32 0))))))

	(fn
		(:doc `Count one signature row per definition, independent of the number of its imported aliases.`)
		count_definitions
		(params (bindings (shared-slice GraphBinding)))
		(returns i32)
		(body
			(let-mut count (i32 0))
			(let-mut index (i32 0))
			(while
				(:doc "A local definition's owning namespace is its defining file.")
				(i32.lt (local index) (slice.len (local bindings)))
				(body
					(let row (slice.load (local bindings) (local index)))
					(if
						(:doc "Cyclic and self imports have already been rejected by graph resolution.")
						(i32.eq (record.get (local row) owner) (record.get (local row) file))
						(then (set (local count) (i32.add.wrapping (local count) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local count))))

	(fn
		(:doc `Rebase a present tree link while retaining the missing-link sentinel.`)
		rebase_link
		(params (index i32) (base i32))
		(returns i32)
		(body
			(if
				(:doc "A missing local link remains missing in the flat table.")
				(i32.lt (local index) (i32 0))
				(then (return (local index))))
			(return (i32.add.wrapping (local base) (local index)))))

	(fn
		(:doc `Copy the checked file's tree into its reserved range with arena-relative spans.`)
		copy_tree
		(params (nodes (shared-slice SourceNode)) (flat (mut-slice SourceNode)) (base i32) (source_base i32))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "Translate the file's own links and copy the available source span.")
				(i32.lt (local index) (slice.len (local nodes)))
				(body
					(let node (slice.load (local nodes) (local index)))
					(slice.store (local flat) (i32.add.wrapping (local base) (local index))
						(record.make SourceNode (kind (record.get (local node) kind))
							(start (i32.add.wrapping (local source_base) (record.get (local node) start)))
							(end (i32.add.wrapping (local source_base) (record.get (local node) end)))
							(parent (call rebase_link (record.get (local node) parent) (local base)))
							(first_child (call rebase_link (record.get (local node) first_child) (local base)))
							(next_sibling (call rebase_link (record.get (local node) next_sibling) (local base)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))))

	(fn
		(:doc `Keep checked table cursors, the selected entry row, and an original source diagnostic.`)
		signatures_result
		(params (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphSignatures)
		(body
			(return (record.make GraphSignatures (functions (local functions)) (params (local params)) (records (local records))
				(entry (local entry)) (file (local file)) (start (local start)) (end (local end)) (error (local error))))))

	(fn
		(:doc `Register this file's signatures in source order using its canonical module key.`)
		register_file
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (module ModuleRead)
			(input SuppliedFile) (tree ScalarTree) (file i32) (root i32)
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter)) (records (mut-slice ScalarRecord))
			(previous GraphSignatures))
		(returns GraphSignatures)
		(body
			(let base (record.get (local tree) base))
			(let source_base (record.get (local input) source_start))
			(let name (slice.load (local nodes) (i32.add.wrapping (local base) (record.get (local module) name))))
			(let path_key (call module_identity (borrow-shared (local arena))
				(record.get (local input) path_start) (record.get (local input) path_end)))
			(let module_id (call hash_spelling (borrow-shared (local arena)) (record.get (local name) start)
				(record.get (local name) end) (local path_key)))
			(let entry_module (i32.eq (local file) (local root)))
			(let scope (record.make FunctionScope (file (local file)) (tree_base (local base))
				(tree_limit (i32.add.wrapping (local base) (record.get (local tree) rows)))
				(source_base (local source_base)) (module_id (local module_id)) (entry_module (local entry_module))))
			(let-mut next_function (record.get (local previous) functions))
			(let-mut next_param (record.get (local previous) params))
			(let-mut next_record (record.get (local previous) records))
			(let-mut entry (record.get (local previous) entry))
			(let-mut index (i32 0))
			(while
				(:doc "Walk active declarations only and send definitions through the shared signature checker.")
				(i32.lt (local index) (record.get (local module) count))
				(body
					(let declaration (i32.add.wrapping (local base)
						(record.get (slice.load (local declarations) (local index)) node)))
					(let node (slice.load (local nodes) (local declaration)))
					(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
					(let tag (call import_keyword (borrow-shared (local arena))
						(slice.load (local nodes) (record.get (local parts) head))))
					(let is_record (u32.eq
						(call declaration_kind (borrow-shared (local arena)) (borrow-shared (local nodes)) (local declaration)) (u32 48)))
					(if
						(:doc "Record types are local to their defining file and do not add function bindings.")
						(local is_record)
						(then
							(let registered (call register_record (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local declaration) (local file) (local module_id) (borrow-mut (local records)) (local next_record)))
							(let error (record.get (local registered) error))
							(if
								(:doc "Report an invalid record in the defining file's original source coordinates.")
								(u32.lt (u32 0) (local error))
								(then (return (call signatures_result (local next_function) (local next_param) (local next_record)
									(local entry) (local file)
									(i32.sub.wrapping (record.get (local registered) start) (local source_base))
									(i32.sub.wrapping (record.get (local registered) end) (local source_base)) (local error)))))
							(set (local next_record) (record.get (local registered) operand))))
					(if
						(:doc "Import edges and record types do not require a function signature.")
						(bool.not (bool.or (local is_record) (u32.eq (local tag) (u32 2))))
						(then
							(let registered (call register_function (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local declaration) (local scope) (borrow-mut (local functions)) (local next_function)
								(borrow-mut (local parameters)) (local next_param)))
							(let error (record.get (local registered) error))
							(if
								(:doc "Translate a rejected signature's span back to its defining file.")
								(u32.lt (u32 0) (local error))
								(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
									(i32.sub.wrapping (record.get (local registered) start) (local source_base))
									(i32.sub.wrapping (record.get (local registered) end) (local source_base))
									(local error)))))
							(let function (slice.load (local functions) (local next_function)))
							(if
								(:doc "Only main in the root file becomes the ABI entry.")
								(record.get (local function) entry)
								(then (set (local entry) (local declaration))))
							(set (local next_param) (record.get (local registered) operand))
							(set (local next_function) (i32.add.wrapping (local next_function) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(if
				(:doc "A reached library may have zero functions, but the executable root requires main.")
				(bool.and (local entry_module) (i32.lt (local entry) (i32 0)))
				(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
					(record.get (local module) start) (record.get (local module) end) (u32 22)))))
			(return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (i32 -1)
				(i32 0) (i32 0) (u32 0)))))

	(fn
		(:doc `Build one measured source tree, preserve its rows, and register its active definitions.`)
		prepare_graph_file
		(params (arena (shared-slice u8)) (source (shared-slice u8)) (input SuppliedFile) (tree ScalarTree)
			(file i32) (root i32) (flat (mut-slice SourceNode))
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter)) (records (mut-slice ScalarRecord))
			(previous GraphSignatures))
		(returns GraphSignatures)
		(body
			(let rows (record.get (local tree) rows))
			(let checked (record.make FormCheck (rows (int.convert u32 (local rows)))
				(start (record.get (local tree) start)) (end (record.get (local tree) end)) (error (u32 0))))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let-mut declarations (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module (borrow-shared (local source)) (borrow-shared (local nodes))
				(local built) (borrow-mut (local declarations))))
			(if
				(:doc "The source graph already checked admission, metadata, and selection for the same immutable bytes.")
				(u32.lt (u32 0) (record.get (local module) error))
				(then (return (call signatures_result (record.get (local previous) functions)
					(record.get (local previous) params) (record.get (local previous) records) (record.get (local previous) entry) (local file)
					(record.get (local module) start) (record.get (local module) end) (record.get (local module) error)))))
			(call copy_tree (borrow-shared (local nodes)) (borrow-mut (local flat))
				(record.get (local tree) base) (record.get (local input) source_start))
			(return (call register_file (borrow-shared (local arena)) (borrow-shared (local flat))
				(borrow-shared (local declarations)) (local module) (local input) (local tree) (local file)
				(local root) (borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-mut (local records)) (local previous)))))

	(fn
		(:doc `Collect signatures and source rows for every reached active file before checking any bodies.`)
		prepare_graph
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(trees (shared-slice ScalarTree)) (root i32) (nodes (mut-slice SourceNode))
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter)) (records (mut-slice ScalarRecord)))
		(returns GraphSignatures)
		(body
			(let-mut next_function (i32 0))
			(let-mut next_param (i32 0))
			(let-mut next_record (i32 0))
			(let-mut entry (i32 -1))
			(let-mut file (i32 0))
			(while
				(:doc "Use the canonical file table so diamonds and independent path aliases share a definition.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(if
						(:doc "An inactive or unreachable file contributes no emitted declarations.")
						(record.get (slice.load (local modules) (local file)) active)
						(then
							(let input (slice.load (local files) (local file)))
							(let checked (call prepare_graph_file (borrow-shared (local arena))
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start)
									(record.get (local input) source_end)))
								(local input) (slice.load (local trees) (local file)) (local file) (local root)
								(borrow-mut (local nodes)) (borrow-mut (local functions)) (borrow-mut (local parameters))
								(borrow-mut (local records))
								(call signatures_result (local next_function) (local next_param) (local next_record) (local entry)
									(i32 -1) (i32 0) (i32 0) (u32 0))))
							(if
								(:doc "Stop before checking any bodies if a reached signature is invalid.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (local checked))))
							(set (local next_function) (record.get (local checked) functions))
							(set (local next_param) (record.get (local checked) params))
							(set (local next_record) (record.get (local checked) records))
							(set (local entry) (record.get (local checked) entry))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (i32 -1)
				(i32 0) (i32 0) (u32 0))))))
