(module scalar_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Prepare scalar signatures from the active files in a resolved source graph.

	Flatten the checked trees into one table so the scalar planner and C
	writer can use direct node indices. Keep each function's original file
	and tree base for binding, call-site identity, and diagnostics. Use the
	canonical virtual path and declared module name to namespace C identities.`)

	(use wove-file "../source/scan.wove" (only check_source_form build_source_tree (type FormCheck) (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts read_module (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../source/imports.wove" (only import_keyword))
	(use wove-file "../source/c_arguments.wove" (only read_c_arguments (type CArgument)))
	(use wove-file "../c/arguments.wove" (only is_c_value_mode))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only (type GraphModule) (type GraphBinding)))
	(use wove-file "../emit/names.wove" (only module_identity hash_spelling))
	(use wove-file "./records.wove" (only register_module_records (type ScalarRecord)))
	(use wove-file "./owners.wove" (only native_owner_type))
	(use wove-file "./plan.wove"
		(only register_function read_parameters (type ScalarFunction) (type ScalarParameter) (type FunctionScope)))
	(use wove-file "./syntax.wove" (only scalar_type (type EntryRead)))

	(struct ScalarTree (fields (base i32) (rows i32) (start i32) (end i32)))
	(struct TreeLayout (fields (rows i32) (file i32) (start i32) (end i32) (error u32)))
	(struct GraphSignatures
		(fields (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32)))

	(fn layout_trees
		(:doc `Keep reached module spans and reserve trees for active Wove files and selected C providers.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile))
			(modules (shared-slice GraphModule)) (bindings (shared-slice GraphBinding)) (trees (mut-slice ScalarTree)))
		(returns TreeLayout)
		(body
			(let-mut binding (i32 0))
			(while
				(:doc "Mark bridge providers in the zeroed tree table until their row counts are measured.")
				(i32.lt (local binding) (slice.len (local bindings)))
				(body
					(let selected (slice.load (local bindings) (local binding)))
					(if
						(:doc "A C provider can participate in signature checking through a bridge alone.")
						(u32.eq (record.get (local selected) provider) (u32 8))
						(then (slice.store (local trees) (record.get (local selected) file)
							(record.make ScalarTree (base (i32 0)) (rows (i32 -1)) (start (i32 0)) (end (i32 0))))))
					(set (local binding) (i32.add.wrapping (local binding) (i32 1)))))
			(let-mut file (i32 0))
			(let-mut total (i32 0))
			(while
				(:doc "Keep reached module spans even when selection excludes a file.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(let module (slice.load (local modules) (local file)))
					(let foreign (i32.lt (record.get (slice.load (local trees) (local file)) rows) (i32 0)))
					(if
						(:doc "Visit completed Wove files and files with a selected bridge definition.")
						(bool.or (u32.eq (record.get (local module) state) (u32 2)) (local foreign))
						(then
							(let input (slice.load (local files) (local file)))
							(let checked (call check_source_form
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start)
									(record.get (local input) source_end)))))
							(let error (record.get (local checked) error))
							(let start (record.get (local checked) start))
							(let end (record.get (local checked) end))
							(if
								(:doc "Keep the original source span if the supplied view fails its form check.")
								(u32.lt (u32 0) (local error))
								(then (return (record.make TreeLayout (rows (i32 0)) (file (local file))
									(start (local start)) (end (local end)) (error (local error))))))
							(let-mut count (i32 0))
							(if
								(:doc "Reserve space once for each active Wove file or C provider.")
								(bool.or (record.get (local module) active) (local foreign))
								(then
									(let rows (record.get (local checked) rows))
									(if
										(:doc "All tree indices must fit in a signed slice index.")
										(u32.lt (int.convert u32 (i32.sub.wrapping (i32 2147483647) (local total))) (local rows))
										(then (return (record.make TreeLayout (rows (i32 0)) (file (local file))
											(start (local start)) (end (local end)) (error (u32 16))))))
									(set (local count) (int.convert i32 (local rows)))))
							(slice.store (local trees) (local file) (record.make ScalarTree (base (local total))
								(rows (local count)) (start (local start)) (end (local end))))
							(set (local total) (i32.add.wrapping (local total) (local count)))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (record.make TreeLayout (rows (local total)) (file (i32 -1))
				(start (i32 0)) (end (i32 0)) (error (u32 0))))))

	(fn first_bridge_binding
		(:doc `Identify the first alias that selects this native declaration in the graph.`)
		(params (bindings (shared-slice GraphBinding)) (index i32) (binding GraphBinding))
		(returns bool)
		(body
			(if
				(:doc "Only function bindings from a C provider need a native signature row.")
				(bool.not (bool.and (u32.eq (record.get (local binding) provider) (u32 8))
					(u32.eq (record.get (local binding) namespace) (u32 0))))
				(then (return (bool false))))
			(let-mut cursor (i32 0))
			(while
				(:doc "An earlier C binding with the same file and declaration is another alias.")
				(i32.lt (local cursor) (local index))
				(body
					(let earlier (slice.load (local bindings) (local cursor)))
					(if
						(:doc "Use the original declaration identity across importing files.")
						(bool.and (u32.eq (record.get (local earlier) provider) (u32 8))
							(bool.and (i32.eq (record.get (local earlier) file) (record.get (local binding) file))
								(i32.eq (record.get (local earlier) declaration) (record.get (local binding) declaration))))
						(then (return (bool false))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (bool true))))

	(fn signature_capacity
		(:doc `Count one signature row per Wove or selected C definition.`)
		(params (bindings (shared-slice GraphBinding)))
		(returns i32)
		(body
			(let-mut count (i32 0))
			(let-mut index (i32 0))
			(while
				(:doc "Every alias shares the signature row of its defining declaration.")
				(i32.lt (local index) (slice.len (local bindings)))
				(body
					(let row (slice.load (local bindings) (local index)))
					(if
						(:doc "Match the ordinary Wove registration and the selected C signature pass.")
						(bool.or (call first_bridge_binding (borrow-shared (local bindings)) (local index) (local row))
							(bool.and (u32.eq (record.get (local row) provider) (u32 3))
								(bool.and (u32.eq (record.get (local row) namespace) (u32 0))
									(i32.eq (record.get (local row) owner) (record.get (local row) file)))))
						(then (set (local count) (i32.add.wrapping (local count) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local count))))

	(fn rebase_link
		(:doc `Rebase a present tree link while retaining the missing-link sentinel.`)
		(params (index i32) (base i32))
		(returns i32)
		(body
			(if
				(:doc "A missing local link remains missing in the flat table.")
				(i32.lt (local index) (i32 0))
				(then (return (local index))))
			(return (i32.add.wrapping (local base) (local index)))))

	(fn copy_tree
		(:doc `Copy the checked file's tree into its reserved range with arena-relative spans.`)
		(params (nodes (shared-slice SourceNode)) (flat (mut-slice SourceNode)) (base i32) (source_base i32))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "Translate the file's own links and copy the available source span.")
				(i32.lt (local index) (slice.len (local nodes)))
				(body
					(let node (slice.load (local nodes) (local index)))
					(slice.store (local flat) (i32.add.wrapping (local base) (local index))
						(record.make SourceNode (kind (record.get (local node) kind))
							(start (i32.add.wrapping (local source_base) (record.get (local node) start)))
							(end (i32.add.wrapping (local source_base) (record.get (local node) end)))
							(parent (call rebase_link (record.get (local node) parent) (local base)))
							(first_child (call rebase_link (record.get (local node) first_child) (local base)))
							(next_sibling (call rebase_link (record.get (local node) next_sibling) (local base)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))))

	(fn signatures_result
		(:doc `Keep checked table cursors, the selected entry row, and an original source diagnostic.`)
		(params (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphSignatures)
		(body
			(return (record.make GraphSignatures (functions (local functions)) (params (local params)) (records (local records))
				(entry (local entry)) (file (local file)) (start (local start)) (end (local end)) (error (local error))))))

	(fn graph_module_key
		(:doc `Hash both the canonical path and the module name for emitted identities.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode))
			(module ModuleRead) (input SuppliedFile) (base i32))
		(returns u32)
		(body
			(let name (slice.load (local nodes) (i32.add.wrapping (local base) (record.get (local module) name))))
			(let path_key (call module_identity (borrow-shared (local arena))
				(record.get (local input) path_start) (record.get (local input) path_end)))
			(return (call hash_spelling (borrow-shared (local arena)) (record.get (local name) start)
				(record.get (local name) end) (local path_key)))))

	(fn register_file_signatures
		(:doc `Check this file's active signatures with the complete graph type table.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (module ModuleRead)
			(input SuppliedFile) (tree ScalarTree) (file i32) (root i32)
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter)) (records (shared-slice ScalarRecord))
			(bindings (shared-slice GraphBinding))
			(previous GraphSignatures))
		(returns GraphSignatures)
		(body
			(let base (record.get (local tree) base))
			(let source_base (record.get (local input) source_start))
			(let module_id (call graph_module_key (borrow-shared (local arena)) (borrow-shared (local nodes))
				(local module) (local input) (local base)))
			(let mode (record.get (local module) mode))
			(let entry_module (bool.and (i32.eq (local file) (local root)) (bool.not (u32.eq (local mode) (u32 2)))))
			(let scope (record.make FunctionScope (file (local file)) (tree_base (local base))
				(tree_limit (i32.add.wrapping (local base) (record.get (local tree) rows)))
				(source_base (local source_base)) (module_id (local module_id)) (entry_module (local entry_module))
				(mode (local mode))))
			(let-mut next_function (record.get (local previous) functions))
			(let-mut next_param (record.get (local previous) params))
			(let-mut entry (record.get (local previous) entry))
			(let next_record (record.get (local previous) records))
			(let-mut index (i32 0))
			(while
				(:doc "Walk active declarations only and send definitions through the shared signature checker.")
				(i32.lt (local index) (record.get (local module) count))
				(body
					(let declaration (record.get
						(slice.load (local declarations) (i32.add.wrapping (local base) (local index))) node))
					(let node (slice.load (local nodes) (local declaration)))
					(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
					(let tag (call import_keyword (borrow-shared (local arena))
						(slice.load (local nodes) (record.get (local parts) head))))
					(if
						(:doc "Imports, record types, and bridge declarations do not register Wove function signatures.")
						(bool.not (bool.or (u32.eq (local tag) (u32 9))
							(bool.or (u32.eq (local tag) (u32 7)) (u32.eq (local tag) (u32 2)))))
						(then
							(let registered (call register_function (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local declaration) (local scope) (borrow-mut (local functions)) (local next_function)
								(borrow-mut (local parameters)) (local next_param) (borrow-shared (local records))
								(borrow-shared (local bindings))))
							(let error (record.get (local registered) error))
							(if
								(:doc "Translate a rejected signature's span back to its defining file.")
								(u32.lt (u32 0) (local error))
								(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
									(i32.sub.wrapping (record.get (local registered) start) (local source_base))
									(i32.sub.wrapping (record.get (local registered) end) (local source_base))
									(local error)))))
							(let function (slice.load (local functions) (local next_function)))
							(if
								(:doc "An ordinary executable uses main from the root file.")
								(record.get (local function) entry)
								(then (set (local entry) (local declaration))))
							(set (local next_param) (record.get (local registered) operand))
							(set (local next_function) (i32.add.wrapping (local next_function) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(if
				(:doc "Only the ordinary executable root requires a source main.")
				(bool.and (local entry_module) (i32.lt (local entry) (i32 0)))
				(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
					(record.get (local module) start) (record.get (local module) end) (u32 22)))))
			(return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (i32 -1)
				(i32 0) (i32 0) (u32 0)))))

	(fn copy_selections
		(:doc `Keep a file's selected declaration indices in its reserved range of the flat table.`)
		(params (declarations (shared-slice SelectedDeclaration)) (count i32) (base i32)
			(selected (mut-slice SelectedDeclaration)))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "Keep selected declaration rows in source order with their rebased node indices.")
				(i32.lt (local index) (local count))
				(body
					(let declaration (slice.load (local declarations) (local index)))
					(let node (record.get (local declaration) node))
					(slice.store (local selected) (i32.add.wrapping (local base) (local index))
						(record.make SelectedDeclaration (node (i32.add.wrapping (local base) (local node))) (test (record.get (local declaration) test))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))))

	(fn prepare_graph_file
		(:doc `Build one measured source tree and register this file's defining record layouts.

		Retain active declaration indices in the file's reserved tree range
		so signature checking can follow selection order after all layouts exist.`)
		(params (arena (shared-slice u8)) (source (shared-slice u8)) (input SuppliedFile) (tree ScalarTree)
			(file i32) (active bool) (mode u32) (flat (mut-slice SourceNode)) (selected (mut-slice SelectedDeclaration)) (views (mut-slice ModuleRead))
			(records (mut-slice ScalarRecord)) (next_record i32))
		(returns GraphSignatures)
		(body
			(let rows (record.get (local tree) rows))
			(let checked (record.make FormCheck (rows (int.convert u32 (local rows)))
				(start (record.get (local tree) start)) (end (record.get (local tree) end)) (error (u32 0))))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(if
				(:doc "A provider contributes a tree only after it has been built successfully.")
				(u32.lt (u32 0) (record.get (local built) error))
				(then (return (call signatures_result (i32 0) (i32 0) (local next_record) (i32 -1) (local file)
					(record.get (local built) start) (record.get (local built) end) (record.get (local built) error)))))
			(let base (record.get (local tree) base))
			(let source_base (record.get (local input) source_start))
			(call copy_tree (borrow-shared (local nodes)) (borrow-mut (local flat)) (local base) (local source_base))
			(if
				(:doc "A bridge-only provider supplies its checked tree and contributes no local Wove declarations.")
				(bool.not (local active))
				(then (return (call signatures_result (i32 0) (i32 0) (local next_record) (i32 -1) (i32 -1)
					(i32 0) (i32 0) (u32 0)))))
			(let-mut declarations (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module (borrow-shared (local source)) (borrow-shared (local nodes))
				(local built) (local mode) (borrow-mut (local declarations))))
			(if
				(:doc "The source graph already checked admission, metadata, and selection for the same immutable bytes.")
				(u32.lt (u32 0) (record.get (local module) error))
				(then (return (call signatures_result (i32 0) (i32 0) (local next_record) (i32 -1) (local file)
					(record.get (local module) start) (record.get (local module) end) (record.get (local module) error)))))
			(let module_id (call graph_module_key (borrow-shared (local arena)) (borrow-shared (local flat))
				(local module) (local input) (local base)))
			(let layouts (call register_module_records (borrow-shared (local arena)) (borrow-shared (local flat))
				(borrow-shared (local declarations)) (record.get (local module) count) (local base)
				(local file) (local module_id) (borrow-mut (local records)) (local next_record)))
			(if
				(:doc "Translate any defining layout error back to the original file view.")
				(u32.lt (u32 0) (record.get (local layouts) error))
				(then (return (call signatures_result (i32 0) (i32 0) (local next_record) (i32 -1) (local file)
					(i32.sub.wrapping (record.get (local layouts) start) (local source_base))
					(i32.sub.wrapping (record.get (local layouts) end) (local source_base)) (record.get (local layouts) error)))))
			(slice.store (local views) (local file) (local module))
			(call copy_selections (borrow-shared (local declarations)) (record.get (local module) count)
				(local base) (borrow-mut (local selected)))
			(return (call signatures_result (i32 0) (i32 0) (record.get (local layouts) operand) (i32 -1) (i32 -1)
				(i32 0) (i32 0) (u32 0)))))

	(fn register_graph_signatures
		(:doc `Check the reached signatures in their original declaration order.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(trees (shared-slice ScalarTree)) (bindings (shared-slice GraphBinding)) (root i32) (nodes (shared-slice SourceNode))
			(selected (shared-slice SelectedDeclaration)) (views (shared-slice ModuleRead))
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter))
			(records (shared-slice ScalarRecord)) (next_record i32))
		(returns GraphSignatures)
		(body
			(let-mut next_function (i32 0))
			(let-mut next_param (i32 0))
			(let-mut entry (i32 -1))
			(let-mut file (i32 0))
			(while
				(:doc "Register signatures in canonical file order after their imported layouts are available.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(if
						(:doc "Only reached active files have a recorded declaration view.")
						(record.get (slice.load (local modules) (local file)) active)
						(then
							(let signatures (call register_file_signatures (borrow-shared (local arena)) (borrow-shared (local nodes))
								(borrow-shared (local selected)) (slice.load (local views) (local file))
								(slice.load (local files) (local file)) (slice.load (local trees) (local file)) (local file)
								(local root) (borrow-mut (local functions)) (borrow-mut (local parameters))
								(borrow-shared (local records)) (borrow-shared (local bindings))
								(call signatures_result (local next_function) (local next_param) (local next_record) (local entry)
									(i32 -1) (i32 0) (i32 0) (u32 0))))
							(if
								(:doc "A failed signature retains the original file and source span.")
								(u32.lt (u32 0) (record.get (local signatures) error))
								(then (return (local signatures))))
							(set (local next_function) (record.get (local signatures) functions))
							(set (local next_param) (record.get (local signatures) params))
							(set (local entry) (record.get (local signatures) entry))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (i32 -1)
				(i32 0) (i32 0) (u32 0)))))

	(fn attach_c_arguments
		(:doc `Store each checked argument contract alongside its exact Wove parameter type.`)
		(params (arguments (shared-slice CArgument)) (parameters (mut-slice ScalarParameter)) (start i32))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "The contract table follows the signature's formal parameter order.")
				(i32.lt (local index) (slice.len (local arguments)))
				(body
					(let argument (slice.load (local arguments) (local index)))
					(if
						(:doc "Scalar formals keep their ordinary native value ABI.")
						(bool.not (call is_c_value_mode (record.get (local argument) mode)))
						(then
							(let row (i32.add.wrapping (local start) (local index)))
							(let previous (slice.load (local parameters) (local row)))
							(slice.store (local parameters) (local row)
								(record.make ScalarParameter (name (record.get (local previous) name))
									(type (record.get (local previous) type)) (position (record.get (local previous) position))
									(c_mode (record.get (local argument) mode))
									(c_size (record.get (local argument) size)) (c_count (record.get (local argument) count))))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))))

	(fn register_bridge_signature
		(:doc `Register a checked C bridge signature using the same parameter rows as Wove functions.`)
		(params (arena (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32) (resource i32) (scope FunctionScope)
			(functions (mut-slice ScalarFunction)) (index i32) (parameters (mut-slice ScalarParameter)) (next_param i32)
			(records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local declaration)))
			(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
			(let name (record.get (local parts) name))
			(let list (slice.load (local nodes) (record.get (local parts) operands)))
			(let result_form (slice.load (local nodes) (record.get (local list) next_sibling)))
			(let result (record.get (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local result_form)) operands))
			(let first (record.get (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local list)) operands))
			(let checked (call read_parameters (borrow-shared (local arena)) (borrow-shared (local nodes)) (local first)
				(borrow-mut (local parameters)) (local next_param) (borrow-shared (local records))
				(borrow-shared (local bindings)) (local scope) (record.get (local node) parent)))
			(if
				(:doc "Retain the original span if shared parameter validation fails.")
				(u32.lt (u32 0) (record.get (local checked) error))
				(then (return (local checked))))
			(let limit (record.get (local checked) operand))
			(let arity (i32.sub.wrapping (local limit) (local next_param)))
			(let-mut arguments (array.alloc CArgument (local arity)))
			(let contracts (call read_c_arguments (borrow-shared (local arena)) (borrow-shared (local nodes))
				(local parts) (local first) (borrow-mut (local arguments))))
			(if
				(:doc "Keep contract diagnostics tied to the original defining signature.")
				(u32.lt (u32 0) (record.get (local contracts) error))
				(then (return (record.make EntryRead (operand (i32 -1))
					(start (record.get (local contracts) start)) (end (record.get (local contracts) end))
					(error (record.get (local contracts) error)) (related (i32 -1))))))
			(let strings (record.get (local contracts) strings))
			(let bytes (record.get (local contracts) bytes))
			(if
				(:doc "Only formals with native contracts need extra lowering information.")
				(bool.or (i32.lt (i32 0) (local strings)) (i32.lt (i32 0) (local bytes)))
				(then (call attach_c_arguments (borrow-shared (local arguments)) (borrow-mut (local parameters)) (local next_param))))
			(let-mut result_type (call scalar_type (borrow-shared (local arena)) (borrow-shared (local nodes)) (local result)))
			(if
				(:doc "Use the resource's defining tree row for the native owner's exact type.")
				(i32.lt (i32 0) (local resource))
				(then (set (local result_type) (call native_owner_type
					(i32.add.wrapping (record.get (local scope) tree_base) (local resource))))))
			(slice.store (local functions) (local index)
				(record.make ScalarFunction (declaration (local declaration)) (name (local name))
					(params (local next_param)) (arity (local arity))
					(result (local result_type))
					(body (i32 -1)) (first_statement (i32 -1)) (identity (u32 0)) (entry (bool false)) (c_strings (local strings)) (c_bytes (local bytes))
					(file (record.get (local scope) file)) (tree_base (record.get (local scope) tree_base))
					(tree_limit (record.get (local scope) tree_limit)) (source_base (record.get (local scope) source_base))))
			(return (local checked))))

	(fn register_graph_bridges
		(:doc `Append one native signature per selected defining declaration after the Wove signatures.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (trees (shared-slice ScalarTree))
			(nodes (shared-slice SourceNode)) (bindings (shared-slice GraphBinding))
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter))
			(records (shared-slice ScalarRecord)) (wove GraphSignatures) (mode u32))
		(returns GraphSignatures)
		(body
			(let-mut next_function (record.get (local wove) functions))
			(let-mut next_param (record.get (local wove) params))
			(let records_count (record.get (local wove) records))
			(let entry (record.get (local wove) entry))
			(let-mut index (i32 0))
			(while
				(:doc "Multiple local bindings can refer to the same signature, including across importers.")
				(i32.lt (local index) (slice.len (local bindings)))
				(body
					(let binding (slice.load (local bindings) (local index)))
					(if
						(:doc "Only the first selection of a C definition registers its signature.")
						(call first_bridge_binding (borrow-shared (local bindings)) (local index) (local binding))
						(then
							(let file (record.get (local binding) file))
							(let tree (slice.load (local trees) (local file)))
							(let base (record.get (local tree) base))
							(let source_base (record.get (slice.load (local files) (local file)) source_start))
							(let scope (record.make FunctionScope (file (local file)) (tree_base (local base))
								(tree_limit (i32.add.wrapping (local base) (record.get (local tree) rows)))
								(source_base (local source_base)) (module_id (u32 0)) (entry_module (bool false)) (mode (local mode))))
							(let checked (call register_bridge_signature (borrow-shared (local arena)) (borrow-shared (local nodes))
								(i32.add.wrapping (local base) (record.get (local binding) declaration))
								(record.get (local binding) owner_type) (local scope)
								(borrow-mut (local functions)) (local next_function)
								(borrow-mut (local parameters)) (local next_param)
								(borrow-shared (local records)) (borrow-shared (local bindings))))
							(if
								(:doc "Bridge signature spans belong to the provider, even if it has no Wove-file imports.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (call signatures_result (local next_function) (local next_param)
									(local records_count) (local entry) (local file)
									(i32.sub.wrapping (record.get (local checked) start) (local source_base))
									(i32.sub.wrapping (record.get (local checked) end) (local source_base))
									(record.get (local checked) error)))))
							(set (local next_function) (i32.add.wrapping (local next_function) (i32 1)))
							(set (local next_param) (record.get (local checked) operand))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call signatures_result (local next_function) (local next_param) (local records_count)
				(local entry) (i32 -1) (i32 0) (i32 0) (u32 0)))))

	(fn prepare_graph
		(:doc `Collect every defining layout before any reached function signature uses it.`)
		(params (arena (shared-slice u8)) (files (shared-slice SuppliedFile)) (modules (shared-slice GraphModule))
			(trees (shared-slice ScalarTree)) (bindings (shared-slice GraphBinding)) (root i32) (mode u32) (nodes (mut-slice SourceNode))
			(functions (mut-slice ScalarFunction)) (parameters (mut-slice ScalarParameter)) (records (mut-slice ScalarRecord)))
		(returns GraphSignatures)
		(body
			(let-mut selected (array.alloc SelectedDeclaration (slice.len (local nodes))))
			(let-mut views (array.alloc ModuleRead (slice.len (local files))))
			(let-mut next_record (i32 0))
			(let-mut file (i32 0))
			(while
				(:doc "Use one layout per definition in the canonical file table.")
				(i32.lt (local file) (slice.len (local files)))
				(body
					(let tree (slice.load (local trees) (local file)))
					(if
						(:doc "Build every reserved tree and collect Wove declarations only in active modules.")
						(i32.lt (i32 0) (record.get (local tree) rows))
						(then
							(let input (slice.load (local files) (local file)))
							(let checked (call prepare_graph_file (borrow-shared (local arena))
								(borrow-shared (slice.range (local arena) (record.get (local input) source_start)
									(record.get (local input) source_end)))
								(local input) (local tree) (local file) (record.get (slice.load (local modules) (local file)) active) (local mode)
								(borrow-mut (local nodes)) (borrow-mut (local selected)) (borrow-mut (local views))
								(borrow-mut (local records)) (local next_record)))
							(if
								(:doc "Stop at the originating file if a reached record layout is invalid.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (local checked))))
							(set (local next_record) (record.get (local checked) records))))
					(set (local file) (i32.add.wrapping (local file) (i32 1)))))
			(let wove (call register_graph_signatures (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local trees)) (borrow-shared (local bindings)) (local root)
				(borrow-shared (local nodes)) (borrow-shared (local selected)) (borrow-shared (local views))
				(borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-shared (local records)) (local next_record)))
			(if
				(:doc "Keep the first Wove signature error before registering native targets.")
				(u32.lt (u32 0) (record.get (local wove) error))
				(then (return (local wove))))
			(return (call register_graph_bridges (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local trees)) (borrow-shared (local nodes)) (borrow-shared (local bindings))
				(borrow-mut (local functions)) (borrow-mut (local parameters)) (borrow-shared (local records)) (local wove) (local mode))))))
