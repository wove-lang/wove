(module scalar_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Prepare scalar signatures from the active files in a resolved source graph.

	Flatten the checked trees into one table so the scalar planner and C
	writer can use direct node indices. Keep each function's original file
	and tree base for binding, call-site identity, and diagnostics. Use the
	canonical virtual path and declared module name to namespace C identities.`)

	(use wove-file "../source/scan.wove" (only check_source_form build_source_tree (type FormCheck) (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts read_module_for_target (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../source/types.wove" (only is_builtin_integer))
	(use wove-file "../source/owned.wove" (only is_byte_rows_descriptor))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/imports.wove" (only import_keyword))
	(use wove-file "../source/c_snapshots.wove" (only read_c_snapshot))
	(use wove-file "../source/tree_copy.wove" (only copy_tree))
	(use wove-file "../source/c_scope.wove" (only connect_bridge_overlay declaring_c_bridge))
	(use wove-file "./trees.wove" (only source_span_owner graph_module_key (type ScalarTree)))
	(use wove-file "../source/c_names.wove" (only c_function_opening))
	(use wove-file "../source/c_formals.wove" (only find_c_fixed_formal))
	(use wove-file "../source/c_arguments.wove" (only read_c_arguments mark_c_argument_type (type CArgument)))
	(use wove-file "../c/arguments.wove" (only is_c_value_mode is_c_storage_mode c_value_mode c_storage_mut_mode c_handle_mut_mode c_storage_init_mode c_handle_init_mode))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only is_wove_type_definition (type GraphModule) (type GraphBinding)))
	(use wove-file "../source/generics.wove" (only function_generic_list))
	(use wove-file "./generics/functions.wove" (only expand_graph_functions (type FunctionInstance)))
	(use wove-file "./specializations.wove" (only register_module_specializations validate_record_template_constants))
	(use wove-file "./records.wove" (only scope_at read_checked_template_parameters register_module_records register_module_record_arrays register_owned_rows order_record_layouts validate_record_array_fields declaration_kind find_native_node native_integer_type is_native_integer is_native_record is_record_type is_mutable_place_reference place_reference_target byte_rows_owner_type (type ScalarRecord)))
	(use wove-file "./owners.wove" (only native_owner_type optional_byte_owner_type))
	(use wove-file "./c_types.wove" (only remember_native_type register_parameter_native_types register_record_dependencies))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))
	(use wove-file "./plan.wove" (only register_function register_concrete_function read_parameters register_module_bindings (type FunctionScope)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./flow.wove" (only block_statement (type ScalarStatement)
			(value c_constant_binding) (value c_readonly_binding) (value c_writable_binding) (value c_macro_binding)))
	(use wove-file "./syntax.wove" (only scalar_type entry_at (type EntryRead)))

	(struct TreeLayout (fields (rows i32) (file i32) (start i32) (end i32) (error u32)))
	(struct GraphSignatures
		(fields (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32)))

	(fn layout_trees
		(:doc `Keep reached module spans and reserve trees for active Wove files and selected C providers.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (bindings (shared-array GraphBinding)) (trees (mut-array ScalarTree)))
		(returns TreeLayout)
		(body
			(let-mut binding 0i32)
			(while
				(:doc "Mark bridge providers in the zeroed tree table until their row counts are measured.")
				(i32.lt (local binding) (array.len (local bindings)))
				(body
					(let selected (array.load (local bindings) (local binding)))
					(if
						(:doc "A C provider can participate in signature checking through a bridge alone.")
						(u32.eq (struct.get (local selected) provider) 8u32)
						(then
							(let primary (struct.get (local selected) header_file))
							(let bundled (struct.get (local selected) default_file))
							(let pending (struct.new ScalarTree (base 0i32) (rows -1i32) (start 0i32) (end 0i32)))
							(array.store (local trees) (local primary) (local pending))
							(if
								(:doc "An inherited parameter or field can need the bundled tree even without an explicit selection.")
								(i32.lt -1i32 (local bundled))
								(then (array.store (local trees) (local bundled) (local pending))))))
					(set (local binding) (i32.inc (local binding)))))
			(let-mut file 0i32)
			(let-mut total 0i32)
			(while
				(:doc "Keep reached module spans even when selection excludes a file.")
				(i32.lt (local file) (array.len (local files)))
				(body
					(let module (array.load (local modules) (local file)))
					(let foreign (i32.ltz (struct.get (array.load (local trees) (local file)) rows)))
					(if
						(:doc "Visit completed Wove files and files with a selected bridge definition.")
						(bool.or (u32.eq (struct.get (local module) state) 2u32) (local foreign))
						(then
							(let input (array.load (local files) (local file)))
							(let checked (call check_source_form
								(borrow-shared (array.range (local arena) (struct.get (local input) source_start)
									(struct.get (local input) source_end)))))
							(let error (struct.get (local checked) error))
							(let start (struct.get (local checked) start))
							(let end (struct.get (local checked) end))
							(if
								(:doc "Keep the original source span if the supplied view fails its form check.")
								(u32.gtz (local error))
								(then (return (struct.new TreeLayout (rows 0i32) (file (local file))
									(start (local start)) (end (local end)) (error (local error))))))
							(let-mut count 0i32)
							(if
								(:doc "Reserve space once for each active Wove file or C provider.")
								(bool.or (struct.get (local module) active) (local foreign))
								(then
									(let rows (struct.get (local checked) rows))
									(if
										(:doc "All tree indices must fit in a signed slice index.")
										(u32.lt (u32.from-i32 (i32.sub 2147483647i32 (local total))) (local rows))
										(then (return (struct.new TreeLayout (rows 0i32) (file (local file))
											(start (local start)) (end (local end)) (error 16u32)))))
									(set (local count) (i32.from-u32 (local rows)))))
							(array.store (local trees) (local file) (struct.new ScalarTree (base (local total))
								(rows (local count)) (start (local start)) (end (local end))))
							(set (local total) (i32.add (local total) (local count)))))
					(set (local file) (i32.inc (local file)))))
			(return (struct.new TreeLayout (rows (local total)) (file -1i32)
				(start 0i32) (end 0i32) (error 0u32)))))

	(fn first_bridge_binding
		(:doc `Identify the first alias that selects this native declaration in the graph.`)
		(params (bindings (shared-array GraphBinding)) (index i32) (binding GraphBinding))
		(returns bool)
		(body
			(if
				(:doc "Only function bindings from a C provider need a native signature row.")
				(bool.not (bool.and (u32.eq (struct.get (local binding) provider) 8u32)
					(u32.eqz (struct.get (local binding) namespace))))
				(then (return (bool false))))
			(let-mut cursor 0i32)
			(while
				(:doc "An earlier C binding with the same file and declaration is another alias.")
				(i32.lt (local cursor) (local index))
				(body
					(let earlier (array.load (local bindings) (local cursor)))
					(if
						(:doc "Use the original declaration identity across importing files.")
						(bool.and (u32.eq (struct.get (local earlier) provider) 8u32)
							(bool.and (i32.eq (struct.get (local earlier) file) (struct.get (local binding) file))
								(i32.eq (struct.get (local earlier) declaration) (struct.get (local binding) declaration))))
						(then (return (bool false))))
					(set (local cursor) (i32.inc (local cursor)))))
			(return (bool true))))

	(fn signature_capacity
		(:doc `Count one signature row per Wove or selected C definition.`)
		(params (bindings (shared-array GraphBinding)))
		(returns i32)
		(body
			(let-mut count 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Every alias shares the signature row of its defining declaration.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let row (array.load (local bindings) (local index)))
					(if
						(:doc "Match the ordinary Wove registration and the selected C signature pass.")
						(bool.or (call first_bridge_binding (borrow-shared (local bindings)) (local index) (local row))
							(bool.and (u32.eq (struct.get (local row) provider) 3u32)
								(bool.and (u32.eqz (struct.get (local row) namespace))
									(i32.eq (struct.get (local row) owner) (struct.get (local row) file)))))
						(then (set (local count) (i32.inc (local count)))))
					(set (local index) (i32.inc (local index)))))
			(return (local count))))

	(fn signatures_result
		(:doc `Keep checked table cursors, the selected entry row, and an original source diagnostic.`)
		(params (functions i32) (params i32) (records i32) (entry i32) (file i32) (start i32) (end i32) (error u32))
		(returns GraphSignatures)
		(body
			(return (struct.new GraphSignatures (functions (local functions)) (params (local params)) (records (local records))
				(entry (local entry)) (file (local file)) (start (local start)) (end (local end)) (error (local error))))))

	(fn register_file_signatures
		(:doc `Check this file's active signatures with the complete graph type table.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (module ModuleRead)
			(input SuppliedFile) (tree ScalarTree) (file i32) (root i32)
			(functions (mut-array ScalarFunction)) (parameters (mut-array ScalarParameter)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding))
			(previous GraphSignatures))
		(returns GraphSignatures)
		(body
			(let base (struct.get (local tree) base))
			(let source_base (struct.get (local input) source_start))
			(let module_id (call graph_module_key (borrow-shared (local arena)) (borrow-shared (local nodes))
				(local module) (local input) (local base)))
			(let mode (struct.get (local module) mode))
			(let entry_module (bool.and (i32.eq (local file) (local root)) (u32.not-eq (local mode) 2u32)))
			(let scope (struct.new FunctionScope (file (local file)) (tree_base (local base))
				(tree_limit (i32.add (local base) (struct.get (local tree) rows)))
				(source_base (local source_base)) (module_id (local module_id)) (entry_module (local entry_module)) (mode (local mode))))
			(let-mut next_function (struct.get (local previous) functions))
			(let-mut next_param (struct.get (local previous) params))
			(let-mut entry (struct.get (local previous) entry))
			(let next_record (struct.get (local previous) records))
			(let-mut index 0i32)
			(while
				(:doc "Walk active declarations only and send definitions through the shared signature checker.")
				(i32.lt (local index) (struct.get (local module) count))
				(body
					(let declaration (struct.get
						(array.load (local declarations) (i32.add (local base) (local index))) node))
					(let node (array.load (local nodes) (local declaration)))
					(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
					(let tag (call import_keyword (borrow-shared (local arena))
						(array.load (local nodes) (struct.get (local parts) head))))
					(if
						(:doc "Imports, type definitions, bridges, and module values have no function signature.")
						(bool.not (bool.or (bool.or (u32.eq (local tag) 9u32)
							(bool.or (call is_wove_type_definition (local tag)) (u32.eq (local tag) 2u32)))
							(u32.eq (call declaration_kind (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local declaration)) 15u32)))
						(then
							(let generic (call function_generic_list (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
							(if
								(:doc "An unapplied template has no runtime signature or ABI entry.")
								(i32.lt -1i32 (local generic))
								(then
									(let parameters_form (array.load (local nodes) (local generic)))
									(let checked (call read_checked_template_parameters (borrow-shared (local arena)) (borrow-shared (local nodes))
										(borrow-shared (local records)) (borrow-shared (local bindings))
										(call scope_at (local file) (local source_base)) (local parameters_form)))
									(if
										(:doc "Malformed parameter declarations retain their defining file and span.")
										(u32.gtz (struct.get (local checked) error))
										(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
											(i32.sub (struct.get (local checked) start) (local source_base))
											(i32.sub (struct.get (local checked) end) (local source_base)) (struct.get (local checked) error))))))
								(else
									(let registered (call register_function (borrow-shared (local arena)) (borrow-shared (local nodes))
										(local declaration) (local scope) (borrow-mut (local functions)) (local next_function)
										(borrow-mut (local parameters)) (local next_param) (borrow-shared (local records))
										(borrow-shared (local bindings))))
									(let error (struct.get (local registered) error))
									(if
										(:doc "Translate a rejected signature's span back to its defining file.")
										(u32.gtz (local error))
										(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
											(i32.sub (struct.get (local registered) start) (local source_base))
											(i32.sub (struct.get (local registered) end) (local source_base))
											(local error)))))
									(let function (array.load (local functions) (local next_function)))
									(if
										(:doc "An ordinary executable uses main from the root file.")
										(struct.get (local function) entry)
										(then (set (local entry) (local declaration))))
									(set (local next_param) (struct.get (local registered) operand))
									(set (local next_function) (i32.inc (local next_function)))))))
					(set (local index) (i32.inc (local index)))))
			(if
				(:doc "Only the ordinary executable root requires a source main.")
				(bool.and (local entry_module) (i32.ltz (local entry)))
				(then (return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) (local file)
					(struct.get (local module) start) (struct.get (local module) end) 22u32))))
			(return (call signatures_result (local next_function) (local next_param) (local next_record) (local entry) -1i32
				0i32 0i32 0u32))))

	(fn copy_selections
		(:doc `Keep a file's selected declaration indices in its reserved range of the flat table.`)
		(params (declarations (shared-array SelectedDeclaration)) (count i32) (base i32)
			(selected (mut-array SelectedDeclaration)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Keep selected declaration rows in source order with their rebased node indices.")
				(i32.lt (local index) (local count))
				(body
					(let declaration (array.load (local declarations) (local index)))
					(let node (struct.get (local declaration) node))
					(array.store (local selected) (i32.add (local base) (local index))
						(struct.new SelectedDeclaration (node (i32.add (local base) (local node))) (test (struct.get (local declaration) test))))
					(set (local index) (i32.inc (local index)))))))

	(fn prepare_graph_file
		(:doc `Build one measured source tree and register its defining type layouts.

		Retain active declaration indices in the file's reserved tree range
		so signature checking can follow selection order after all layouts exist.`)
		(params (arena (shared-array u8)) (source (shared-array u8)) (input SuppliedFile) (tree ScalarTree)
			(file i32) (active bool) (context SelectionContext) (flat (mut-array SourceNode)) (selected (mut-array SelectedDeclaration)) (views (mut-array ModuleRead))
			(records (mut-array ScalarRecord)) (next_record i32) (bindings (shared-array GraphBinding)))
		(returns GraphSignatures)
		(body
			(let rows (struct.get (local tree) rows))
			(let checked (struct.new FormCheck (rows (u32.from-i32 (local rows)))
				(start (struct.get (local tree) start)) (end (struct.get (local tree) end)) (error 0u32)))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(if
				(:doc "A provider contributes a tree only after it has been built successfully.")
				(u32.gtz (struct.get (local built) error))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32 (local file)
					(struct.get (local built) start) (struct.get (local built) end) (struct.get (local built) error)))))
			(let base (struct.get (local tree) base))
			(let source_base (struct.get (local input) source_start))
			(call copy_tree (borrow-shared (local nodes)) (borrow-mut (local flat)) (local base) (local source_base))
			(if
				(:doc "A bridge-only provider supplies its checked tree and contributes no local Wove declarations.")
				(bool.not (local active))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32 -1i32
					0i32 0i32 0u32))))
			(let-mut declarations (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes))
				(local built) (local context) (borrow-mut (local declarations))))
			(if
				(:doc "The source graph already checked admission, metadata, and selection for the same immutable bytes.")
				(u32.gtz (struct.get (local module) error))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32 (local file)
					(struct.get (local module) start) (struct.get (local module) end) (struct.get (local module) error)))))
			(let module_id (call graph_module_key (borrow-shared (local arena)) (borrow-shared (local flat))
				(local module) (local input) (local base)))
			(let layouts (call register_module_records (borrow-shared (local arena)) (borrow-shared (local flat))
				(borrow-shared (local declarations)) (struct.get (local module) count) (local base) (local source_base)
				(local file) (local module_id) (borrow-mut (local records)) (local next_record) (borrow-shared (local bindings))))
			(if
				(:doc "Translate any defining layout error back to the original file view.")
				(u32.gtz (struct.get (local layouts) error))
				(then (return (call signatures_result 0i32 0i32 (local next_record) -1i32 (local file)
					(i32.sub (struct.get (local layouts) start) (local source_base))
					(i32.sub (struct.get (local layouts) end) (local source_base)) (struct.get (local layouts) error)))))
			(array.store (local views) (local file) (local module))
			(call copy_selections (borrow-shared (local declarations)) (struct.get (local module) count)
				(local base) (borrow-mut (local selected)))
			(return (call signatures_result 0i32 0i32 (struct.get (local layouts) operand) -1i32 -1i32
				0i32 0i32 0u32))))

	(fn install_bridge_overlays
		(:doc "Restore each resolved bridge pair in the shared graph tree before checking type dependencies.")
		(params (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding)) (nodes (mut-array SourceNode)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "All aliases for one header repeat the same resolved pair.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let binding (array.load (local bindings) (local index)))
					(let defaults (struct.get (local binding) default_file))
					(if
						(:doc "Standalone and complete replacement scopes have no peer.")
						(bool.and (u32.eq (struct.get (local binding) provider) 8u32) (i32.lt -1i32 (local defaults)))
						(then
							(let primary_base (struct.get (array.load (local trees) (struct.get (local binding) header_file)) base))
							(let default_base (struct.get (array.load (local trees) (local defaults)) base))
							(call connect_bridge_overlay (borrow-mut (local nodes))
								(i32.add (local primary_base) (struct.get (local binding) bridge_node))
								(i32.add (local default_base) (struct.get (local binding) default_node)))))
					(set (local index) (i32.inc (local index)))))))

	(fn register_graph_native_types
		(:doc `Collect the native value types required by direct selections and C signatures.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (trees (shared-array ScalarTree))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (start i32) (context SelectionContext))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let-mut next (local start))
			(while
				(:doc "A C binding can refer to a directly selected native type or a function signature.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(let binding (array.load (local bindings) (local index)))
					(if
						(:doc "Ordinary Wove records already occupy their registered layout rows.")
						(u32.eq (struct.get (local binding) provider) 8u32)
						(then
							(let file (struct.get (local binding) file))
							(let base (struct.get (array.load (local trees) (local file)) base))
							(let alias (struct.get (local binding) native_type))
							(if
								(:doc "Direct type imports preserve pointer owner identity alongside copyable native layouts.")
								(bool.and (i32.gtz (local alias))
									(bool.or (i32.ltz (struct.get (local binding) drop_start))
										(u32.eq (struct.get (local binding) namespace) 1u32)))
								(then
									(let owner (struct.get (local binding) native_file))
									(let type_base (struct.get (array.load (local trees) (local owner)) base))
									(set (local next) (call remember_native_type (borrow-shared (local arena))
										(borrow-shared (local nodes)) (local owner) (local type_base)
										(i32.add (local type_base) (local alias)) (borrow-mut (local records)) (local next)))))
							(if
								(:doc "Inspect each C function's parameter types just once per defining declaration.")
								(call first_bridge_binding (borrow-shared (local bindings)) (local index) (local binding))
								(then (set (local next) (call register_parameter_native_types (borrow-shared (local arena))
									(borrow-shared (local nodes)) (i32.add (local base) (struct.get (local binding) declaration))
									(borrow-shared (local trees)) (local context) (borrow-mut (local records)) (local next)))))))
					(set (local index) (i32.inc (local index)))))
			(return (local next))))

	(fn complete_native_records
		(:doc `Walk the native type table to closure, adding each nested view and alias once.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(trees (shared-array ScalarTree)) (records (mut-array ScalarRecord)) (first i32) (count i32) (context SelectionContext))
		(returns GraphSignatures)
		(body
			(let-mut index (local first))
			(let-mut next (local count))
			(while
				(:doc "Newly found record dependencies are appended for later visiting.")
				(i32.lt (local index) (local next))
				(body
					(let row (array.load (local records) (local index)))
					(if
						(:doc "Only record views have fields to resolve.")
						(call is_native_record (local row))
						(then
							(let file (struct.get (local row) file))
							(let base (struct.get (array.load (local trees) (local file)) base))
							(let checked (call register_record_dependencies (borrow-shared (local arena)) (borrow-shared (local nodes))
								(local row) (local base) (borrow-shared (local trees)) (local context) (borrow-mut (local records)) (local next)))
							(if
								(:doc "Report offsets relative to the provider that defines the field.")
								(u32.gtz (struct.get (local checked) error))
								(then
									(let origin (call source_span_owner (borrow-shared (local files)) (struct.get (local checked) start) (local file)))
