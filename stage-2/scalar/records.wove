						(:doc "Checked function, struct, and enum declarations can mention anonymous fixed layouts.")
						(bool.or (u32.eq (local kind) (local enum_declaration)) (bool.or (bool.and (u32.eq (local kind) 1u32)
								(i32.ltz (call function_generic_list (borrow-shared (local source)) (borrow-shared (local nodes))
									(array.load (local nodes) (local form)))))
