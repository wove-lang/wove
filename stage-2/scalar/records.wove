			(return (call specialization_at (local node) (local template) (local identity) 0u32))))

	(fn read_specialization_key
		(:doc `Check all explicit arguments against the named template and construct its stable C identity.

		The normalized types and constant bits remain independently comparable
		when another instance has the same hash.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (use i32) (enclosing i32)) (returns SpecializationKey)
		(body
			(let node (array.load (local nodes) (local use)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let selected (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local parts)))
			(if
				(:doc "Type applications belong to the selected enclosing declaration.")
				(u32.gtz (struct.get (local selected) error))
				(then (return (struct.new SpecializationKey (template -1i32) (identity 0u32)
					(start (struct.get (local selected) start)) (end (struct.get (local selected) end))
					(error (struct.get (local selected) error))))))
			(let name (struct.get (local parts) operands))
			(if (i32.ltz (local name)) (then (return (call specialization_at (local node) -1i32 0u32 23u32))))
			(let spelling (array.load (local nodes) (local name)))
			(if
				(:doc "A type application head names a template directly, with no fallback from an enclosing or substituted parameter.")
				(bool.or (u8.not-eqz (struct.get (local spelling) generic_kind))
					(bool.or (bool.not (call is_scalar_name (borrow-shared (local source)) (local spelling)))
						(call names_enclosing_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (local enclosing) (local name))))
				(then (return (call specialization_at (local spelling) -1i32 0u32 23u32))))
			(let template (call find_record (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings))
				(struct.get (local scope) file) (struct.get (local scope) source_base) (local spelling)))
			(if (i32.ltz (local template)) (then (return (call specialization_at (local spelling) -1i32 0u32 34u32))))
			(let layout (array.load (local records) (local template)))
			(if (bool.not (call is_generic_template (local layout))) (then (return (call specialization_at (local spelling) -1i32 0u32 23u32))))
			(return (call read_specialization_arguments (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (local use) (local enclosing)
				(local template) (struct.get (local layout) generic)
				(call scope_at (struct.get (local layout) file) (struct.get (local layout) source_base))
				(struct.get (local layout) identity) (bool true)))))

	(fn same_specialization_arguments
		(:doc "Compare checked types, constant bits, variant rows, and operation declarations across application namespaces.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (use i32)
			(previous_scope TypeScope) (previous i32) (parameters i32) (definition_scope TypeScope) (record_arguments bool)) (returns bool)
		(body
			(if (i32.eq (local use) (local previous)) (then (return (bool true))))
			(let-mut left (call specialization_first (borrow-shared (local source)) (borrow-shared (local nodes)) (local use)))
			(let-mut right (call specialization_first (borrow-shared (local source)) (borrow-shared (local nodes)) (local previous)))
			(let-mut formal (local parameters))
			(while
				(:doc "Both applications have already been checked against this parameter list.")
				(i32.lt -1i32 (local formal))
				(body
					(let parameter (array.load (local nodes) (local formal)))
					(let kind (call resolved_generic_kind (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local definition_scope) (local parameter)))
					(let a (call check_generic_argument (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (local left) (local kind) (local record_arguments)))
					(let b (call check_generic_argument (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local previous_scope) (local right) (local kind) (local record_arguments)))
					(if
						(:doc "A hash match must never silently coalesce two different argument values.")
