													(if
														(:doc "Missing operands were allowed only for unit variants.")
														(i32.lt -1i32 (struct.get (local parts) operands))
														(then (return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
															(local layout) (local member) 23u32))))))
											(set (local next) (struct.get (local member) next_sibling))))
									(array.store (local stack) (local depth)
										(struct.new LayoutVisit (row (local row)) (field (local next)) (element (bool false))))
									(if
										(:doc "Only a by-value aggregate field needs a separate layout.")
										(call is_record_type (local type))
