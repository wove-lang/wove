						(then
							(if
								(:doc "A concrete instance shares the template's defining file and file-local row.")
								(bool.and
									(bool.and (i32.not-ltz (struct.get (local layout) specialization))
										(bool.and (i32.eq (struct.get (local layout) file) (struct.get (local template) file))
											(i32.eq (struct.get (local layout) declaration) (struct.get (local template) declaration))))
									(call same_specialization_arguments (borrow-shared (local source)) (borrow-shared (local nodes))
										(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (local use)
										(call use_scope (local layout)) (struct.get (local layout) specialization) (struct.get (local layout) generic)
										(call scope_at (struct.get (local template) file) (struct.get (local template) source_base)) (bool true)))
								(then (return (local row))))))
					(set (local row) (i32.inc (local row)))))
			(return -1i32)))

	(fn is_specialization_alias
		(:doc "Identify a checked application site that reuses a preceding concrete layout.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (i32.eq (struct.get (local layout) name) -2i32))))

	(fn specialization_alias
		(:doc "Keep a second checked source occurrence mapped to the original concrete record.")
		(params (site i32) (definition i32)) (returns ScalarRecord)
		(body
			(return (struct.new ScalarRecord (c_name_slot 0i32) (name -2i32) (file -1i32) (identity 0u32)
				(first -1i32) (count 0i32) (declaration -1i32) (native 0i32)
				(source_base 0i32) (emit_row 0i32) (owns_arrays (bool false)) (borrows_bytes (bool false))
				(generic -1i32) (specialization (local site)) (argument_file -1i32) (argument_base 0i32)
				(alias_of (local definition))))))

	(fn specialization_type
		(:doc "Resolve a checked application by its original source row without rechecking nested arguments.")
		(params (records (shared-array ScalarRecord)) (site i32)) (returns u32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Each validated spelling points to exactly one concrete nominal row.")
				(i32.lt (local index) (array.len (local records)))
