		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (count i32) (base i32) (source_base i32)
			(file i32) (module u32) (records (mut-array ScalarRecord)) (start i32) (bindings (shared-array GraphBinding)))
