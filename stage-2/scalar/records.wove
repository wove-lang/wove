	(fn read_wove_reference
		(:doc `Read a call-scoped reference to a record or writable built-in scalar.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(file i32) (source_base i32) (node SourceNode) (element i32) (mode u32))
