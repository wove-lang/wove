						(then (return (struct.new GenericConstant (value (struct.get (local node) generic_value))
							(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))
					(return (call read_generic_bool (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))))
