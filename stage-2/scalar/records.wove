		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32)
			(records (mut-array ScalarRecord)) (next i32))
		(returns EntryRead)
		(body
			(let layout (call register_fixed_spelling (borrow-shared source) (borrow-shared nodes) node
				(borrow-mut records) next (borrow-shared bindings)
				file source_base (bool true) (bool true)))
			(if layout/error.gtz (then (return layout)))
			(let type (call fixed_array_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) node (borrow-shared bindings) file source_base))
			(if
				(:doc "Preserve the original type span for an invalid scalar, nominal element, or extent.")
				type.eqz
				(then (return (call invalid_array_type (borrow-shared source) (borrow-shared nodes)
					node (borrow-shared bindings) file source_base))))
			(if
				(:doc "Immutable module tables cannot be the defining storage of an owner.")
				(call fixed_array_owns (borrow-shared records) type)
				(then (return (call entry_at node -1i32 23u32))))
			(let-mut row next)
			(while
				(:doc "A new wrapper refers only to layouts that already have their emission positions.")
				(row.lt layout/operand)
				(body
					(call publish_layout (borrow-mut records) row row)
					(set row row.inc)))
			(return (call entry_at node (i32:from-u32 type) 0u32))))

	(fn layout_error
		(:doc `Point a layout error at the exact field's type in its original file.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(layout ScalarRecord) (member SourceNode) (error u32))
		(returns LayoutCheck)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) member))
			(let spelling (nodes.get parts/operands))
			(let base layout/source_base)
			(return (LayoutCheck.new (file layout/file)
				(start (spelling/start.sub base))
				(end (spelling/end.sub base)) (error error)))))

	(fn enter_layout
		(:doc "Mark a layout active and start with its first member or its array element dependency.")
		(params (row i32) (layout ScalarRecord) (depth i32) (origin i32)
			(marks (mut-array u8)) (stack (mut-array LayoutVisit)))
		(returns void)
		(body
			(let array (call is_fixed_array layout))
			(let element (array.and
				(call is_record_type (u32:from-i32 layout/first))))
			(let-mut field -1i32)
			(if
				(:doc "An array carries the source field that led to its element dependency.")
				element
				(then (set field origin)))
			(if
				(:doc "Named Wove records and payload enums traverse their declaration members.")
				(bool:and (bool:not (array.or
						(bool:or (call is_owned_row_layout layout)
							(bool:or (call is_generic_template layout) (call is_specialization_alias layout)))))
					(layout/native.eqz.or (call is_payload_enum layout)))
				(then (set field layout/first)))
			(marks.set row 1u8)
			(stack.set depth
				(LayoutVisit.new (row row) (field field) (element element)))))

	(fn layout_state
		(:doc "Replace layout emission and ownership state without changing its defining identity.")
		(params (entry ScalarRecord) (emitted i32) (owns bool))
		(returns ScalarRecord)
		(body
			(return (ScalarRecord.new (c_name_ordinal entry/c_name_ordinal) (name entry/name) (file entry/file)
				(identity entry/identity) (first entry/first)
				(count entry/count) (declaration entry/declaration)
				(native entry/native) (source_base entry/source_base)
				(emit_row emitted) (owns_arrays owns) (borrows_bytes entry/borrows_bytes)
				(generic entry/generic) (specialization entry/specialization)
				(argument_file entry/argument_file) (argument_base entry/argument_base) (alias_of entry/alias_of)))))

	(fn publish_layout
		(:doc "Record which defining layout is emitted at this position while retaining all type identities.")
		(params (records (mut-array ScalarRecord)) (position i32) (row i32))
		(returns void)
		(body
			(let entry (records.get position))
			(records.set position
				(call layout_state entry row entry/owns_arrays))))

	(fn is_record_array_field
		(:doc "Identify a struct field stored as a heap array descriptor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (member SourceNode))
		(returns bool)
		(body (return (bool:and
			(layout/native.eqz.and layout/owns_arrays)
			(call is_owned_array_field (borrow-shared source) (borrow-shared nodes) member)))))

	(fn validate_record_array_fields
		(:doc "Check each array field after leaf layouts and exact nested owner identities are available.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (count i32))
		(returns LayoutCheck)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Array field validation applies to every defining owning struct, even an unused one.")
				(row.lt count)
				(body
					(let layout (records.get row))
					(if
						(:doc "Only ordinary Wove structs have named owning fields to validate.")
						(layout/name.gtz.and
							(layout/native.eqz.and layout/owns_arrays))
						(then
							(let-mut field layout/first)
							(while
								(:doc "An invalid field type reports the field in its defining file.")
								field.not-ltz
								(body
									(let member (nodes.get field))
									(if
										(:doc "Require the exact owner type, including every nested row.")
										(bool:and (call is_owned_array_field (borrow-shared source) (borrow-shared nodes) member)
											(bool:not (call is_array_owner (call member_value_type (borrow-shared source) (borrow-shared nodes)
												(borrow-shared records) (borrow-shared bindings) layout member))))
										(then (return (call layout_error (borrow-shared source) (borrow-shared nodes)
											layout member 23u32))))
									(set field member/next_sibling)))))
					(set row row.inc)))
			(return (LayoutCheck.new (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn finish_layout_ownership
		(:doc "Classify owning members after their layout dependencies are complete.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(records (mut-array ScalarRecord)) (row i32))
		(returns LayoutCheck)
		(body
			(let layout (records.get row))
			(let ok (LayoutCheck.new (file -1i32) (start 0i32) (end 0i32) (error 0u32)))
			(if
				(:doc "An inline array owns its element exactly when the complete element type owns storage.")
				(call is_fixed_array layout)
				(then
					(let element (u32:from-i32 layout/first))
					(let owns (bool:or (call is_array_owner element)
						(call is_owning_record (borrow-shared records) element)))
					(records.set row (call layout_state layout layout/emit_row owns))
					(return ok)))
			(if
				(:doc "Only ordinary Wove records and payload enums have typed value members.")
				(bool:or (bool:or (call is_owned_row_layout layout)
						(bool:or (call is_generic_template layout) (call is_specialization_alias layout)))
					(bool:not (layout/native.eqz.or (call is_payload_enum layout))))
				(then (return ok)))
			(let-mut owns layout/owns_arrays)
			(let-mut field layout/first)
			(while
				(:doc "Ownership of an inline dependency is known when the parent finishes.")
				(i32:lt -1i32 field)
				(body
					(let member (nodes.get field))
					(if
						(:doc "Struct array descriptors are already marked owning and validated after row interning.")
						(bool:not (call is_record_array_field (borrow-shared source) (borrow-shared nodes)
							layout member))
						(then
							(let type (call member_value_type (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings) layout member))
							(if
								(:doc "An owning enum cannot be copied into a record or inline array member.")
								type.eqz
								(then
									(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) member))
									(if (i32:lt -1i32 parts/operands)
										(then (return (call layout_error (borrow-shared source) (borrow-shared nodes)
											layout member 23u32))))))
							(if
								(:doc "Any owning member gives the enclosing aggregate lexical cleanup.")
								(bool:or (call is_native_owner type)
									(bool:or (call is_array_owner type)
										(call is_owning_record (borrow-shared records) type)))
								(then (set owns (bool true))))))
					(set field member/next_sibling)))
			(records.set row
				(call layout_state layout layout/emit_row owns))
			(return ok)))

	(fn walk_record_layouts
		(:doc `Validate fields and order each complete value layout after its dependencies.

		Traverse roots in table order. An explicit stack keeps source depth
		out of the host stack. Fields and array elements both participate in by-value cycles.
		The field that introduces the recursive dependency supplies its span.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (count i32)
			(marks (mut-array u8)) (stack (mut-array LayoutVisit)))
		(returns LayoutCheck)
		(body
			(let ok (LayoutCheck.new (file -1i32) (start 0i32) (end 0i32) (error 0u32)))
			(let-mut root 0i32)
			(let-mut written 0i32)
			(while
				(:doc "Visit each root once, preserving source order among independent layouts.")
				(root.lt count)
				(body
					(let-mut depth -1i32)
					(if
						(:doc "A completed dependency already has an emission position.")
						(u8:eqz (marks.get root))
						(then
							(set depth 0i32)
							(call enter_layout root (records.get root) depth -1i32
								(borrow-mut marks) (borrow-mut stack))))
					(while
						(:doc "Finish a layout once every field's defining layout has been emitted.")
						(i32:lt -1i32 depth)
						(body
							(let visit (stack.get depth))
							(let row visit/row)
							(let field visit/field)
							(let element visit/element)
							(if
								(:doc "Postorder publishes the original row after its dependencies.")
								(element.not.and field.ltz)
								(then
									(let ownership (call finish_layout_ownership (borrow-shared source) (borrow-shared nodes)
										(borrow-shared bindings) (borrow-mut records) row))
									(if ownership/error.gtz (then (return ownership)))
									(call publish_layout (borrow-mut records) written row)
									(marks.set row 2u8)
									(set written written.inc)
									(set depth depth.dec))
								(else
									(let layout (records.get row))
									(let-mut type 0u32)
									(let-mut next -1i32)
									(if
										(:doc "A fixed wrapper has one dependency even when its extent is zero.")
										element
										(then (set type (u32:from-i32 layout/first)))
										(else
											(let member (nodes.get field))
											(if
												(:doc "A heap array descriptor has no by-value layout dependency.")
												(bool:not (call is_record_array_field (borrow-shared source) (borrow-shared nodes)
													layout member))
												(then
													(set type (call member_value_type (borrow-shared source) (borrow-shared nodes)
														(borrow-shared records) (borrow-shared bindings) layout member))
													(if
														(:doc "A unit variant can omit its type. Other members require a supported value type.")
														type.eqz
														(then
															(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) member))
															(if
																(:doc "Missing operands were allowed only for unit variants.")
																(i32:lt -1i32 parts/operands)
																(then (return (call layout_error (borrow-shared source) (borrow-shared nodes)
																	layout member 23u32))))))))
											(set next member/next_sibling)))
									(stack.set depth
										(LayoutVisit.new (row row) (field next) (element (bool false))))
									(if
										(:doc "Only a by-value aggregate field needs a separate layout.")
										(call is_record_type type)
										(then
											(let child (call record_index type))
											(let mark (marks.get child))
											(if
												(:doc "A visiting child closes a cycle through inline storage.")
												(mark.eq 1u8)
												(then
													(let member (nodes.get field))
													(if
														(:doc "A recursive array element reports the containing field that led to the wrapper.")
														element
														(then
															(let-mut parent_depth depth.dec)
															(let-mut parent (struct:get (stack.get parent_depth) row))
															(while
																(:doc "Synthetic wrappers carry the same field from the nearest named parent.")
																(parent_depth.gtz.and (call is_fixed_array (records.get parent)))
																(body
																	(set parent_depth parent_depth.dec)
																	(set parent (struct:get (stack.get parent_depth) row))))
															(return (call layout_error (borrow-shared source) (borrow-shared nodes)
																(records.get parent) member 23u32))))
													(return (call layout_error (borrow-shared source) (borrow-shared nodes)
														layout member 23u32))))
											(if
												(:doc "Revisit this layout after ordering the unvisited child.")
												mark.eqz
												(then
													(set depth depth.inc)
													(call enter_layout child (records.get child) depth field
														(borrow-mut marks) (borrow-mut stack))))))))))
					(set root root.inc)))
			(return ok)))

	(fn order_record_layouts
		(:doc `Allocate one traversal slot and mark per complete registered layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (count i32))
		(returns LayoutCheck)
		(body
			(if
				(:doc "Scalar-only modules have no layout work or scratch allocation.")
				count.eqz
				(then (return (LayoutCheck.new (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))
			(let-mut marks (array:alloc u8 count))
			(let-mut stack (array:alloc LayoutVisit count))
			(return (call walk_record_layouts (borrow-shared source) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-mut records) count
				(borrow-mut marks) (borrow-mut stack))))))
