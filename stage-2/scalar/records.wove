	(fn order_record_layouts
		(:doc `Allocate one traversal slot and mark per complete registered layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (count i32))
		(returns LayoutCheck)
		(body
			(if
				(:doc "Scalar-only modules have no layout work or scratch allocation.")
				(i32.eqz (local count))
				(then (return (struct.new LayoutCheck (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))
			(let-mut marks (array.alloc u8 (local count)))
			(let-mut stack (array.alloc LayoutVisit (local count)))
			(return (call walk_record_layouts (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local bindings)) (borrow-mut (local records)) (local count)
				(borrow-mut (local marks)) (borrow-mut (local stack)))))))
