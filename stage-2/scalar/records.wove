	(fn read_specialization_arguments
		(:doc "Validate each exact argument kind and derive a deterministic identity from the defining declaration.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (use i32) (enclosing i32)
			(template i32) (parameters i32) (definition_scope TypeScope) (definition u32) (record_arguments bool)) (returns SpecializationKey)
		(body
			(let node (array.load (local nodes) (local use)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let selected (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local parts)))
			(if
				(:doc "The application inherits the selection of its enclosing declaration.")
				(u32.gtz (struct.get (local selected) error))
				(then (return (struct.new SpecializationKey (template -1i32) (identity 0u32)
					(start (struct.get (local selected) start)) (end (struct.get (local selected) end))
					(error (struct.get (local selected) error))))))
			(let-mut formal (local parameters))
			(let-mut actual (call specialization_first (borrow-shared (local source)) (borrow-shared (local nodes)) (local use)))
			(let-mut identity (call hash_generic_word (local definition) (local specialization_domain)))
			(while
				(:doc "Read each declared kind against exactly one argument, in order.")
				(i32.lt -1i32 (local formal))
				(body
					(if (i32.ltz (local actual)) (then (return (call specialization_at (local node) -1i32 0u32 23u32))))
					(let parameter (array.load (local nodes) (local formal)))
					(let argument (array.load (local nodes) (local actual)))
					(if
						(:doc "Only closed field applications can share a mapping keyed by their source row.")
						(call names_enclosing_parameter (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (local enclosing) (local actual))
						(then (return (call specialization_at (local argument) -1i32 0u32 23u32))))
					(let kind (call resolved_generic_kind (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local definition_scope) (local parameter)))
					(let checked (call check_generic_argument (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local scope) (local actual) (local kind) (local record_arguments)))
					(if
						(:doc "A bad argument points to its original operand, with its own type or literal error.")
