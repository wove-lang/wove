							(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))
					(return (call read_generic_i32 (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))))
			(if
				(:doc "A forwarded Boolean or exact bool literal normalizes to the same typed argument word.")
