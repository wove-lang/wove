													(if
														(:doc "A recursive array element reports the containing field that led to the wrapper.")
														(local element)
														(then
															(let parent (array.load (local stack) (i32.dec (local depth))))
															(return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
																(array.load (local records) (struct.get (local parent) row)) (local member) 23u32))))
													(return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
														(local layout) (local member) 23u32))))
