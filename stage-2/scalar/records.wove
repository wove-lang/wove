								(local form) (borrow-mut (local records)) (local next) (borrow-shared (local bindings))
								(local file) (local source_base) (bool false)))
							(if (u32.gtz (struct.get (local arrays) error)) (then (return (local arrays))))
							(set (local next) (struct.get (local arrays) operand))))
					(if
						(:doc "Structs and enums populate the shared nominal type namespace.")
						(bool.or (u32.eq (local kind) 48u32) (u32.eq (local kind) (local enum_declaration)))
						(then
							(let checked (call register_nominal_type (borrow-shared (local source)) (borrow-shared (local nodes))
								(local form) (u32.eq (local kind) (local enum_declaration)) (local file) (local base)
