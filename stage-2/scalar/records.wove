	(fn check_generic_argument
		(:doc "Normalize a constant or resolve a concrete type in the application's namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (argument i32) (kind u32) (record_arguments bool)) (returns GenericConstant)
		(body
			(let node (array.load (local nodes) (local argument)))
