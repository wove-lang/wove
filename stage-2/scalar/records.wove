(module scalar_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register checked module-local scalar record layouts.

	Retain the defining file, name, and first field in the source tree.
	Resolve fields by original spelling and use declaration order for
	their native ordinals. The record table is a zero-initialized prefix.`)

	(use wove-file "../source/generics.wove"
		(only has_generic_head has_specialization_head function_generic_list read_generic_parameter generic_argument_kind
			read_generic_i32 read_generic_bool constant_at constant_type_operand hash_generic_word is_checked_non_type_operand
			(value checked_type_operand) (value checked_i32_operand) (value checked_bool_operand) (value checked_enum_operand) (value generic_bool_kind) (value generic_enum_kind) (value generic_operation_kind)
			(value checked_operation_operand)
			(type GenericConstant)))
	(use wove-file "../source/enum_forms.wove" (only (value enum_declaration) (value enum_constructor) (value variants_list) (value match_case)))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion integer_byte_width is_integer_byte_encoder))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge project_bridge))
	(use wove-file "../source/c_dependencies.wove" (only find_bridge_type_dependency))
	(use wove-file "../source/scan.wove" (only is_disabled_form is_metadata_form (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts validate_form_metadata (type SelectedDeclaration)))
	(use wove-file "../source/imports.wove" (only import_keyword))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_reserved_type_name reference_mode is_builtin_integer is_builtin_float is_builtin_numeric is_builtin_scalar is_256bit_integer (value i256_type)))
	(use wove-file "./native_owner_types.wove" (only (value optional_reference_base) (value optional_array_base) native_owner_type is_native_owner))
	(use wove-file "../source/owned.wove" (only owned_element_node is_byte_owner_descriptor optional_type_operand))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../emit/names.wove" (only record_identity))
	(use wove-file "./callable_types.wove" (only read_callable_type same_callable_parameters (type CallableShape)))
	(use wove-file "./constants.wove" (only fold_i32 constant_check))
	(use wove-file "./syntax.wove"
		(only entry_at entry_form entry_keyword is_scalar_name same_name scalar_type is_byte_view_type is_fixed_array_type_head
			callable_keyword (value fn_type_kind)
			(type EntryRead) (type FixedArrayShape)))

	(struct
		(:doc `One registered value layout or native type.

		A native pointer owner stores its flattened defining row in first.
		A native long double alias carries its C literal and uses count -2.
		A fixed array has name -1, element type in first, and
		extent in count. Unit and payload enums have native -1 and -2.
		They keep their first variant and count in the same positions
		as a record's fields. A specialization records its original argument
		site and namespace. A repeated site has a non-emitting alias row with name -2.
		An owning array element has a non-emitting row with name -3 and its exact type in first.
		A callable layout stores the first formal in first, its scalar or
		void result in argument_file, and its formal shape in argument_base.
		A callable alias has name -5, the defining type form in first, and
		the canonical type code in alias_of.`)
		ScalarRecord
		(fields (name i32) (file i32) (identity u32) (c_name_slot i32) (first i32) (count i32)
			(declaration i32) (native i32) (source_base i32) (emit_row i32) (owns_arrays bool) (borrows_bytes bool)
			(generic i32) (specialization i32) (argument_file i32) (argument_base i32) (alias_of i32)))

	(fn record_with_c_name_slot
		(:doc "Assign a private C spelling slot while preserving the exact checked record row.")
		(params (entry ScalarRecord) (slot i32)) (returns ScalarRecord)
		(body
			(return (struct.new ScalarRecord (name (struct.get (local entry) name)) (file (struct.get (local entry) file))
				(identity (struct.get (local entry) identity)) (c_name_slot (local slot))
				(first (struct.get (local entry) first)) (count (struct.get (local entry) count))
				(declaration (struct.get (local entry) declaration)) (native (struct.get (local entry) native))
				(source_base (struct.get (local entry) source_base)) (emit_row (struct.get (local entry) emit_row))
				(owns_arrays (struct.get (local entry) owns_arrays)) (borrows_bytes (struct.get (local entry) borrows_bytes))
				(generic (struct.get (local entry) generic)) (specialization (struct.get (local entry) specialization))
				(argument_file (struct.get (local entry) argument_file)) (argument_base (struct.get (local entry) argument_base))
				(alias_of (struct.get (local entry) alias_of))))))

	(struct TypeScope (fields (file i32) (source_base i32)))
	(struct SpecializationKey (fields (template i32) (identity u32) (start i32) (end i32) (error u32)))
	(let specialization_domain 1667592307u32)

	(struct ScalarMember (fields (ordinal i32) (row i32)))
	(struct LayoutVisit (fields (row i32) (field i32) (element bool)))
	(struct LayoutCheck (fields (file i32) (start i32) (end i32) (error u32)))

	(fn is_record_type
		(:doc `Recognize value types represented by registered layouts.

		Even an empty record definition uses five tree rows.
		A definition also uses more than eight source bytes. The signed
		graph arena bounds the layout and native alias rows well below 2^28.
		The last two codes in that interval represent the C23 integer values.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local type) 64u32)
			(u32.lt (local type) (local i256_type))))))

	(let callable_layout_name -4i32)
	(let callable_alias_name -5i32)
	(let callable_alias_kind 593u32)
	(let callable_type_base 805306368u32)
	(let callable_type_limit 1073741824u32)

	(fn is_callable_type
		(:doc "Recognize the structural signature interval above the supported array element codes.")
		(params (type u32)) (returns bool)
		(body
			(return (bool.and (u32.not-lt (local type) (local callable_type_base))
				(u32.lt (local type) (local callable_type_limit))))))

	(fn is_callable_layout
		(:doc "Distinguish a function-pointer signature from data layouts in the shared table.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (i32.eq (struct.get (local layout) name) (local callable_layout_name)))))

	(fn is_callable_alias
		(:doc "Identify a defining type name that refers to an interned signature.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (i32.eq (struct.get (local layout) name) (local callable_alias_name)))))

	(fn callable_index
		(:doc "Get the interned signature row for a checked function value.")
		(params (type u32)) (returns i32)
		(body (return (i32.from-u32 (u32.sub (local type) (local callable_type_base))))))

	(fn callable_layout_shape
		(:doc "Recover the signature's first formal, exact result, and parameter spelling form.")
		(params (layout ScalarRecord)) (returns CallableShape)
		(body
			(return (struct.new CallableShape (first (struct.get (local layout) first))
				(result (u32.from-i32 (struct.get (local layout) argument_file)))
				(named (i32.gtz (struct.get (local layout) argument_base))) (start 0i32) (end 0i32) (error 0u32)))))

	(fn find_callable_type
		(:doc "Reuse the same type code for every structurally identical checked signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(shape CallableShape))
		(returns u32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only populated callable rows can match this signature.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let layout (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local layout) name)) (then (return 0u32)))
					(if
						(:doc "Check the exact result and ordered scalar parameters.")
						(bool.and (call is_callable_layout (local layout))
							(i32.eq (struct.get (local layout) argument_file) (i32.from-u32 (struct.get (local shape) result))))
						(then
							(let candidate (call callable_layout_shape (local layout)))
							(if
								(:doc "A named declaration and an inline signature can denote the same type.")
								(call same_callable_parameters (borrow-shared (local source)) (borrow-shared (local nodes)) (local candidate) (local shape))
								(then (return (u32.add (local callable_type_base) (u32.from-i32 (local index))))))))
					(set (local index) (i32.inc (local index)))))
			(return 0u32)))

	(fn intern_callable_layout
		(:doc "Append one canonical signature when no existing layout matches it.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(shape CallableShape) (next i32))
		(returns i32)
		(body
			(if
				(:doc "Leave invalid signatures for the originating formal or reference to diagnose.")
				(bool.or (u32.gtz (struct.get (local shape) error))
					(u32.gtz (call find_callable_type (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local records)) (local shape))))
				(then (return (local next))))
			(if
				(:doc "Check both the supplied table and the type-code interval before appending.")
				(bool.or (i32.not-lt (local next) (array.len (local records))) (i32.not-lt (local next) 268435456i32))
				(then (return -1i32)))
			(let-mut named 0i32)
			(if (struct.get (local shape) named) (then (set (local named) 1i32)))
			(array.store (local records) (local next)
				(struct.new ScalarRecord (c_name_slot 0i32) (name (local callable_layout_name)) (file -1i32)
					(identity (u32.from-i32 (local next))) (first (struct.get (local shape) first)) (count 0i32)
					(declaration -1i32) (native -3i32) (source_base 0i32) (emit_row (local next))
					(owns_arrays (bool false)) (borrows_bytes (bool false)) (generic -1i32) (specialization -1i32)
					(argument_file (i32.from-u32 (struct.get (local shape) result))) (argument_base (local named)) (alias_of -1i32)))
			(return (i32.inc (local next)))))

	(fn find_callable_alias
		(:doc "Resolve a checked type name through its defining file and original declaration.")
		(params (source (shared-array u8)) (name SourceNode) (scope TypeScope)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)))
		(returns u32)
		(body
			(let index (call find_binding (borrow-shared (local source)) (borrow-shared (local source))
				(struct.get (local name) start) (struct.get (local name) end) (borrow-shared (local bindings)) (array.len (local bindings))
				(struct.get (local scope) file) (bool false) (struct.get (local scope) source_base) 1u32))
			(if (i32.ltz (local index)) (then (return 0u32)))
			(let binding (array.load (local bindings) (local index)))
			(let-mut row 0i32)
			(while
				(:doc "Match only registered callable aliases in the populated layout prefix.")
				(i32.lt (local row) (array.len (local records)))
				(body
					(let alias (array.load (local records) (local row)))
					(if (i32.eqz (struct.get (local alias) name)) (then (return 0u32)))
					(if
						(:doc "An import rename shares the defining alias's canonical type.")
						(bool.and (call is_callable_alias (local alias))
							(bool.and (i32.eq (struct.get (local alias) file) (struct.get (local binding) file))
								(i32.eq (struct.get (local alias) declaration) (struct.get (local binding) declaration))))
						(then (return (u32.from-i32 (struct.get (local alias) alias_of)))))
					(set (local row) (i32.inc (local row)))))
			(return 0u32)))

	(fn layout_count
		(:doc "Find the populated prefix of the zero-initialized layout table.")
		(params (records (shared-array ScalarRecord))) (returns i32)
		(body
			(let-mut low 0i32)
			(let-mut high (array.len (local records)))
			(while
				(:doc "Narrow to the first unused layout slot.")
				(i32.lt (local low) (local high))
				(body
					(let middle (i32.add (local low) (i32.from-u32 (u32.shr (u32.from-i32 (i32.sub (local high) (local low))) 1i32))))
					(if
						(:doc "Every populated entry precedes the zeroed tail.")
						(i32.eqz (struct.get (array.load (local records) (local middle)) name))
						(then (set (local high) (local middle)))
						(else (set (local low) (i32.inc (local middle)))))))
			(return (local low))))

	(fn is_owning_record
		(:doc "Identify Wove value layouts that own array storage.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool.and (call is_record_type (local type))
				(struct.get (array.load (local records) (call record_index (local type))) owns_arrays)))))

	(fn is_scoped_record
		(:doc "Identify record layouts that carry a shared byte-array loan.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool.and (call is_record_type (local type))
				(struct.get (array.load (local records) (call record_index (local type))) borrows_bytes)))))

	(fn is_owning_struct_element
		(:doc "Identify a named owning Wove struct with no borrowed storage.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(if (bool.not (call is_record_type (local type))) (then (return (bool false))))
			(let layout (array.load (local records) (call record_index (local type))))
			(return (bool.and (struct.get (local layout) owns_arrays)
				(bool.and (i32.eqz (struct.get (local layout) native))
					(bool.and (i32.gtz (struct.get (local layout) name))
						(bool.not (struct.get (local layout) borrows_bytes))))))))

	(fn is_owning_fixed_array
		(:doc "Identify an inline array with individually occupied owner slots.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body
			(return (bool.and (call is_owning_record (borrow-shared (local records)) (local type))
				(call is_fixed_array (array.load (local records) (call record_index (local type))))))))

	(fn has_inline_owner_slots
		(:doc "Find a fixed owner through the acyclic inline layout. Heap descriptors end the walk.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32)) (returns bool)
		(body
			(if (call is_owning_fixed_array (borrow-shared (local records)) (local type)) (then (return (bool true))))
			(if (bool.not (call is_owning_struct_element (borrow-shared (local records)) (local type))) (then (return (bool false))))
			(let layout (array.load (local records) (call record_index (local type))))
			(let-mut field (struct.get (local layout) first))
			(while
				(:doc "Exact field types include substitutions from the concrete record instance.")
				(i32.not-ltz (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(let member_type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
					(if
						(:doc "One embedded owning fixed layout requires the runtime check.")
						(call has_inline_owner_slots (borrow-shared (local source)) (borrow-shared (local nodes))
							(borrow-shared (local records)) (borrow-shared (local bindings)) (local member_type))
						(then (return (bool true))))
					(set (local field) (struct.get (local member) next_sibling))))
			(return (bool false))))

	(fn is_owning_array_element
		(:doc "Use an initialized heap slot for an owning named struct or an owning fixed layout.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body (return (bool.or (call is_owning_struct_element (borrow-shared (local records)) (local type))
			(call is_owning_fixed_array (borrow-shared (local records)) (local type))))))

	(fn owned_array_leaf_type
		(:doc "Resolve an array element without allowing scoped records or owning enum payloads.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let type (call value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (local index)))
			(if
				(:doc "An owning struct can move between slots only when its lifetime is independent.")
				(bool.or (call is_scoped_record (borrow-shared (local records)) (local type))
					(bool.and (call is_owning_record (borrow-shared (local records)) (local type))
						(bool.not (call is_owning_array_element (borrow-shared (local records)) (local type)))))
				(then (return 0u32)))
			(return (local type))))

	(fn record_type
		(:doc `Encode a checked record row as a type distinct from the built-ins.`)
		(params (row i32))
		(returns u32)
		(body (return (u32.add (u32.from-i32 (local row)) 64u32))))

	(fn is_fixed_array
		(:doc `Distinguish an anonymous fixed array from a named record in the layout table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (i32.eq (struct.get (local layout) name) -1i32))))

	(fn is_enum_layout
		(:doc `Recognize either nominal enum layout in the shared type table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (bool.or (i32.eq (struct.get (local layout) native) -1i32)
			(i32.eq (struct.get (local layout) native) -2i32)))))

	(fn is_fieldless_enum
		(:doc "Identify an enum whose variants all use unit storage.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (i32.eq (struct.get (local layout) native) -1i32))))

	(fn is_payload_enum
		(:doc `Identify an enum containing at least one payload variant.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (i32.eq (struct.get (local layout) native) -2i32))))

	(fn find_fixed_array_type
		(:doc `Find the one structural type for the exact element and extent.`)
		(params (records (shared-array ScalarRecord)) (shape FixedArrayShape))
		(returns u32)
		(body
			(let element (struct.get (local shape) element))
			(if (bool.or (u32.eqz (local element)) (i32.ltz (struct.get (local shape) extent))) (then (return 0u32)))
			(let-mut index 0i32)
			(while
				(:doc "Only populated fixed layouts can match a structural type.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let layout (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local layout) name)) (then (return 0u32)))
					(if
						(:doc "Both shape components must agree, including a zero extent.")
						(bool.and (call is_fixed_array (local layout))
							(bool.and (i32.eq (struct.get (local layout) first) (i32.from-u32 (local element)))
								(i32.eq (struct.get (local layout) count) (struct.get (local shape) extent))))
						(then (return (call record_type (local index)))))
					(set (local index) (i32.inc (local index)))))
			(return 0u32)))

	(fn array_extent_operand
		(:doc "Keep the final extent operand after a checked element row.")
		(params (nodes (shared-array SourceNode)) (element i32)) (returns i32)
		(body
			(let index (struct.get (array.load (local nodes) (local element)) next_sibling))
			(if (i32.ltz (local index)) (then (return -1i32)))
			(let extent (array.load (local nodes) (local index)))
			(if
				(:doc "The full array shape ends with one size token or constant expression.")
				(bool.or (bool.and (u32.not-eq (struct.get (local extent) kind) 1u32)
					(u32.not-eq (struct.get (local extent) kind) 40u32))
					(i32.lt -1i32 (struct.get (local extent) next_sibling)))
				(then (return -1i32)))
			(return (local index))))

	(fn read_array_extent
		(:doc "Read a decimal size or resolve an immutable integer in the current file's value namespace.")
		(params (source (shared-array u8)) (node SourceNode) (bindings (shared-array GraphBinding))
			(file i32) (source_base i32)) (returns i32)
		(body
			(if
				(:doc "A substituted constant carries exact signed i32 bits. Array extents require a clear sign bit.")
				(u8.eq (struct.get (local node) generic_kind) (local checked_i32_operand))
				(then
					(let bits (struct.get (local node) generic_value))
					(if (u32.lt 2147483647u32 (local bits)) (then (return -1i32)))
					(return (i32.from-u32 (local bits)))))
			(if
				(:doc "A non-i32 parameter cannot fall through to an identically spelled module integer.")
				(bool.or (u8.eq (struct.get (local node) generic_kind) (local checked_type_operand))
					(call is_checked_non_type_operand (struct.get (local node) generic_kind)))
				(then (return -1i32)))
			(let start (struct.get (local node) start))
			(let end (struct.get (local node) end))
			(if
				(:doc "An identifier may be a local value or a selective import of its defining module.")
				(call is_scalar_name (borrow-shared (local source)) (local node))
				(then
					(let binding (call find_binding (borrow-shared (local source)) (borrow-shared (local source))
						(local start) (local end) (borrow-shared (local bindings)) (array.len (local bindings))
						(local file) (bool false) (local source_base) 2u32))
					(if (i32.ltz (local binding)) (then (return -1i32)))
					(return (struct.get (array.load (local bindings) (local binding)) extent))))
			(let parsed (call read_decimal_digits (borrow-shared (local source)) (local start) (local end) 214748364u32 7u32))
			(if (i32.ltz (struct.get (local parsed) digits)) (then (return -1i32)))
			(return (i32.from-u32 (struct.get (local parsed) magnitude)))))

	(fn check_array_extent
		(:doc "Check a literal, a visible immutable size, or an exact i32 computation as an extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(index i32) (file i32) (source_base i32)) (returns EntryRead)
		(body
			(let site (array.load (local nodes) (local index)))
			(let-mut count -1i32)
			(if
				(:doc "Preserve the expression diagnostic from inside an inline extent.")
				(u32.eq (struct.get (local site) kind) 40u32)
				(then
					(let folded (call fold_i32 (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local bindings))
						(local index) (local file) (local source_base)))
					(if (u32.gtz (struct.get (local folded) error)) (then (return (call constant_check (local folded)))))
					(let bits (struct.get (local folded) bits))
					(if (u32.not-lt 2147483647u32 (local bits)) (then (set (local count) (i32.from-u32 (local bits))))))
				(else
					(set (local count) (call read_array_extent (borrow-shared (local source)) (local site)
						(borrow-shared (local bindings)) (local file) (local source_base)))))
			(if (i32.ltz (local count)) (then (return (call entry_at (local site) -1i32 23u32))))
			(return (call entry_at (local site) (local count) 0u32))))

	(fn invalid_array_type
		(:doc "Keep the original extent error when a valid array shape fails at its size operand.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32)) (returns EntryRead)
		(body
			(let invalid (call entry_at (local node) -1i32 23u32))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) 70u32 23u32))
