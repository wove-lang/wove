				(end (struct.get (local node) end)) (error (local error))))))

	(fn check_generic_owner_argument
		(:doc "Resolve an owning descriptor whose leaf has a stable built-in or named Wove identity.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
