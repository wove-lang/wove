(module scalar_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register checked module-local scalar record layouts.

	Retain the defining file, name, and first field in the source tree.
	Resolve fields by original spelling and use declaration order for
	their native ordinals. The record table is a zero-initialized prefix.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts select_form (type SelectedDeclaration)))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_reserved_type_name))
	(use wove-file "../emit/names.wove" (only record_identity))
	(use wove-file "./syntax.wove"
		(only entry_at entry_form entry_keyword is_scalar_name same_name scalar_type is_byte_view_type (type EntryRead)))

	(struct ScalarRecord (fields (name i32) (file i32) (identity u32) (first i32) (count i32) (declaration i32)))
	(struct ScalarMember (fields (ordinal i32) (type u32)))

	(fn is_record_type
		(:doc `Recognize value types for registered records.

		Even an empty record definition uses five tree rows.
		INT32_MAX / 5 + 64 is below 2^29, so the value code fits below
		the owning array interval and between the slice mode bases.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (bool.not (u32.lt (local type) (u32 64)))
			(u32.lt (local type) (u32 536870912))))))

	(fn record_type
		(:doc `Encode a checked record row as a type distinct from the built-ins.`)
		(params (row i32))
		(returns u32)
		(body (return (u32.add.wrapping (int.convert u32 (local row)) (u32 64)))))

	(fn record_index
		(:doc `Recover the checked defining row from a named record type.`)
		(params (type u32))
		(returns i32)
		(body (return (int.convert i32 (u32.sub.wrapping (local type) (u32 64))))))

	(fn is_array_owner
		(:doc `Identify one local owner of a byte or record allocation.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local type) (u32 41))
				(bool.and (bool.not (u32.lt (local type) (u32 536870912))) (u32.lt (local type) (u32 1073741824)))))))

	(fn array_owner_type
		(:doc `Encode an owning array with the checked allocation's exact element type.`)
		(params (element u32))
		(returns u32)
		(body
			(if
				(:doc "Keep the existing byte owner type code.")
				(u32.eq (local element) (u32 10))
				(then (return (u32 41))))
			(return (u32.add.wrapping (local element) (u32 536870912)))))

	(fn array_owner_element
		(:doc `Recover the element type of a checked byte or record owner.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "The original owner code identifies a byte array.")
				(u32.eq (local type) (u32 41))
				(then (return (u32 10))))
			(return (u32.sub.wrapping (local type) (u32 536870912)))))

	(fn is_record_slice
		(:doc `Identify either access mode of a view with a defining record element.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (bool.not (u32.lt (local type) (u32 1073741824)))
			(u32.lt (local type) (u32 2147483648))))))

	(fn is_writable_slice
		(:doc `Identify any slice descriptor with writable access.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) (u32 38))
			(bool.and (bool.not (u32.lt (local type) (u32 1610612736))) (u32.lt (local type) (u32 2147483648)))))))

	(fn record_slice_type
		(:doc `Encode a record slice from its defining element and access mode.`)
		(params (element u32) (writable bool))
		(returns u32)
		(body
			(if
				(:doc "Mutable record slices occupy the upper half of the slice type interval.")
				(local writable)
				(then (return (u32.add.wrapping (local element) (u32 1610612736)))))
			(return (u32.add.wrapping (local element) (u32 1073741824)))))

	(fn record_slice_element
		(:doc `Recover a record slice's defining value type from its access-mode interval.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "Remove the mutable slice interval's base.")
				(call is_writable_slice (local type))
				(then (return (u32.sub.wrapping (local type) (u32 1610612736)))))
			(return (u32.sub.wrapping (local type) (u32 1073741824)))))

	(fn is_readable_slice
		(:doc `Recognize every slice descriptor that supports length and load.`)
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_byte_view_type (local type)) (call is_record_slice (local type))))))

	(fn declaration_kind
		(:doc `Classify a selected declaration by its original head.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32))
		(returns u32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
				(slice.load (local nodes) (local declaration))))
			(return (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local parts) head)))))

	(fn count_records
		(:doc `Count selected records so single-file function and record tables have exact capacities.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (count i32))
		(returns i32)
		(body
			(let-mut index (i32 0))
			(let-mut records (i32 0))
			(while
				(:doc "Inactive and grouped declarations have already been filtered by the module reader.")
				(i32.lt (local index) (local count))
				(body
					(let form (record.get (slice.load (local declarations) (local index)) node))
					(if
						(:doc "Structs occupy the type table and all other declarations follow signature checking.")
						(u32.eq (call declaration_kind (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)) (u32 48))
						(then (set (local records) (i32.add.wrapping (local records) (i32 1)))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local records))))

	(fn find_record
		(:doc `Resolve a local or imported record spelling to its defining layout.

		A graph maps the spelling to a canonical file and file-local
		declaration row. A single-file caller uses its local type table.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(bindings (shared-slice GraphBinding)) (file i32) (source_base i32) (name SourceNode))
		(returns i32)
		(body
			(let-mut owner (local file))
			(let-mut declaration (i32 -1))
			(if
				(:doc "Read aliases and local type names from the graph's type namespace.")
				(i32.lt (i32 0) (slice.len (local bindings)))
				(then
					(let index (call find_binding (borrow-shared (local source)) (borrow-shared (local source))
						(record.get (local name) start) (record.get (local name) end)
						(borrow-shared (local bindings)) (slice.len (local bindings))
						(local file) (bool false) (local source_base) (u32 1)))
					(if
						(:doc "A type name is available only after a successful local binding.")
						(i32.lt (local index) (i32 0))
						(then (return (i32 -1))))
					(let binding (slice.load (local bindings) (local index)))
					(set (local owner) (record.get (local binding) file))
					(set (local declaration) (record.get (local binding) declaration))))
			(let has_declaration (bool.not (i32.lt (local declaration) (i32 0))))
			(let-mut index (i32 0))
			(while
				(:doc "Each defining record occupies one row, independent of how many aliases refer to it.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let record (slice.load (local records) (local index)))
					(let declared (record.get (local record) name))
					(if (i32.eq (local declared) (i32 0)) (then (return (i32 -1))))
					(if
						(:doc "Match the defining row in a graph or the original spelling in a single file.")
						(bool.and (i32.eq (local owner) (record.get (local record) file))
							(bool.or
								(bool.and (local has_declaration)
									(i32.eq (local declaration) (record.get (local record) declaration)))
								(bool.and (bool.not (local has_declaration))
									(call same_name (borrow-shared (local source)) (local name)
										(slice.load (local nodes) (local declared))))))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (i32 -1))))

	(fn copyable_type
		(:doc `Resolve a scalar or visible record by the signature's original type spelling.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let scalar (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))
			(if
				(:doc "The primitive types keep their original codes.")
				(u32.lt (u32 0) (local scalar))
				(then (return (local scalar))))
			(let name (slice.load (local nodes) (local index)))
			(if
				(:doc "A compound type or a quoted name cannot name a local record.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (u32 0))))
			(let found (call find_record (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (local name)))
			(if
				(:doc "A signature needs a type bound in the current file.")
				(i32.lt (local found) (i32 0))
				(then (return (u32 0))))
			(return (call record_type (local found)))))

	(fn read_parameter_type
		(:doc `Read a copyable value or slice parameter type, retaining any type operand diagnostic.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(records (shared-slice ScalarRecord)) (bindings (shared-slice GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local index)))
			(let value (call copyable_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (local index)))
			(if
				(:doc "A value parameter keeps its exact scalar or record type.")
				(u32.lt (u32 0) (local value))
				(then (return (call entry_at (local node) (int.convert i32 (local value)) (u32 0)))))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let type (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local parts) head)))
			(if
				(:doc "Both access modes have distinct parameter type codes.")
				(bool.not (call is_byte_view_type (local type)))
				(then (return (call entry_at (local node) (i32 -1) (u32 23)))))
			(let view (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local type) (u32 23)))
			(if
				(:doc "Forward a malformed view or invalid metadata at its original span.")
				(u32.lt (u32 0) (record.get (local view) error))
				(then (return (local view))))
			(let element (record.get (local view) operand))
			(if
				(:doc "This slice type needs exactly one element type.")
				(bool.or (i32.lt (local element) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local element)) next_sibling) (i32 0))))
				(then (return (call entry_at (local node) (i32 -1) (u32 23)))))
			(let element_type (call copyable_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (local element)))
			(if
				(:doc "Both access modes accept the original byte descriptor codes.")
				(u32.eq (local element_type) (u32 10))
				(then (return (call entry_at (local node) (int.convert i32 (local type)) (u32 0)))))
			(if
				(:doc "Both record slice access modes retain their exact defining element type.")
				(call is_record_type (local element_type))
				(then (return (call entry_at (local node)
					(int.convert i32 (call record_slice_type (local element_type) (u32.eq (local type) (u32 38)))) (u32 0)))))
			(return (call entry_at (slice.load (local nodes) (local element)) (i32 -1) (u32 23)))))


	(fn read_member_operand
		(:doc `Validate a named member form and return its single ordinary operand.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (member SourceNode))
		(returns EntryRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
			(let head (record.get (local parts) head))
			(let value (record.get (local parts) operands))
			(if
				(:doc "A member requires an identifier head and exactly one value.")
				(bool.or (i32.lt (local head) (i32 0))
					(bool.or (bool.not (call is_scalar_name (borrow-shared (local source)) (slice.load (local nodes) (local head))))
						(bool.or (i32.lt (local value) (i32 0))
							(bool.not (i32.lt (record.get (slice.load (local nodes) (local value)) next_sibling) (i32 0))))))
				(then (return (call entry_at (local member) (i32 -1) (u32 24)))))
			(let selection (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local member) (local parts) (bool false)))
			(if
				(:doc "Selection directives belong to declarations and cannot remove individual fields.")
				(u32.lt (u32 0) (record.get (local selection) error))
				(then (return (record.make EntryRead (operand (i32 -1))
					(start (record.get (local selection) start)) (end (record.get (local selection) end))
					(error (record.get (local selection) error)) (related (i32 -1))))))
			(return (call entry_at (local member) (local value) (u32 0)))))

	(fn member_type
		(:doc `Read a field type from an already validated declaration row.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (member SourceNode))
		(returns u32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
			(return (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) operands)))))

	(fn find_member
		(:doc `Resolve a member in the checked prefix of a record's field list.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (first i32) (count i32) (name SourceNode))
		(returns ScalarMember)
		(body
			(let-mut field (local first))
			(let-mut ordinal (i32 0))
			(while
				(:doc "Use the original member order for native ordinals.")
				(i32.lt (local ordinal) (local count))
				(body
					(let item (slice.load (local nodes) (local field)))
					(let head (slice.load (local nodes) (record.get (local item) first_child)))
					(if
						(:doc "Native naming does not affect member lookup.")
						(call same_name (borrow-shared (local source)) (local head) (local name))
						(then (return (record.make ScalarMember (ordinal (local ordinal))
							(type (call member_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local item)))))))
					(set (local field) (record.get (local item) next_sibling))
					(set (local ordinal) (i32.add.wrapping (local ordinal) (i32 1)))))
			(return (record.make ScalarMember (ordinal (i32 -1)) (type (u32 0))))))

	(fn register_record
		(:doc `Register one selected type after checking its scalar fields and stable identity.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32)
			(file i32) (base i32) (module u32) (records (mut-slice ScalarRecord)) (index i32))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local declaration)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let name (record.get (local parts) operands))
			(if
				(:doc "A struct requires a name before its field list.")
				(i32.lt (local name) (i32 0))
				(then (return (call entry_at (local node) (i32 -1) (u32 22)))))
			(let spelling (slice.load (local nodes) (local name)))
			(let fields (record.get (local spelling) next_sibling))
			(if
				(:doc "There is exactly one fields operand after the record name.")
				(bool.or (i32.lt (local fields) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local fields)) next_sibling) (i32 0))))
				(then (return (call entry_at (local node) (i32 -1) (u32 22)))))
			(if
				(:doc "Reserve the supported native type spellings.")
				(bool.or (bool.not (call is_scalar_name (borrow-shared (local source)) (local spelling)))
					(call is_reserved_type_name (borrow-shared (local source))
						(record.get (local spelling) start) (record.get (local spelling) end)))
				(then (return (call entry_at (local spelling) (i32 -1) (u32 22)))))
			(let identity (call record_identity (borrow-shared (local source)) (record.get (local spelling) start)
				(record.get (local spelling) end) (local module)))
			(let-mut previous (i32 0))
			(while
				(:doc "All record identities in the translation unit must be distinct.")
				(i32.lt (local previous) (local index))
				(body
					(let prior (slice.load (local records) (local previous)))
					(if
						(:doc "Distinguish a repeated name in this file from a stable identity collision.")
						(u32.eq (local identity) (record.get (local prior) identity))
						(then
							(let earlier (slice.load (local nodes) (record.get (local prior) name)))
							(if
								(:doc "A duplicate type name cannot introduce another layout.")
								(bool.and (i32.eq (local file) (record.get (local prior) file))
									(call same_name (borrow-shared (local source)) (local spelling) (local earlier)))
								(then (return (call entry_at (local spelling) (i32 -1) (u32 33)))))
							(return (call entry_at (local spelling) (i32 -1) (u32 32)))))
					(set (local previous) (i32.add.wrapping (local previous) (i32 1)))))
			(let list (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(slice.load (local nodes) (local fields)) (u32 49) (u32 22)))
			(if
				(:doc "Keep an invalid field list's own span.")
				(u32.lt (u32 0) (record.get (local list) error))
				(then (return (local list))))
			(let first (record.get (local list) operand))
			(let-mut field (local first))
			(let-mut count (i32 0))
			(while
				(:doc "Check field declarations in order before publishing the layout.")
				(bool.not (i32.lt (local field) (i32 0)))
				(body
					(let member (slice.load (local nodes) (local field)))
					(let checked (call read_member_operand (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
					(if
						(:doc "Malformed member forms retain the offending span.")
						(u32.lt (u32 0) (record.get (local checked) error))
						(then (return (local checked))))
					(let field_type (record.get (local checked) operand))
					(if
						(:doc "Copyable fields use one of the four exact scalar types.")
						(u32.eq (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local field_type)) (u32 0))
						(then (return (call entry_at (slice.load (local nodes) (local field_type)) (i32 -1) (u32 23)))))
					(let field_name (slice.load (local nodes) (record.get (local member) first_child)))
					(let prior (call find_member (borrow-shared (local source)) (borrow-shared (local nodes))
						(local first) (local count) (local field_name)))
					(if
						(:doc "Each spelling occupies one native member position.")
						(bool.not (i32.lt (record.get (local prior) ordinal) (i32 0)))
						(then (return (call entry_at (local field_name) (i32 -1) (u32 33)))))
					(set (local count) (i32.add.wrapping (local count) (i32 1)))
					(set (local field) (record.get (local member) next_sibling))))
			(slice.store (local records) (local index)
				(record.make ScalarRecord (name (local name)) (file (local file)) (identity (local identity))
					(first (local first)) (count (local count)) (declaration (i32.sub.wrapping (local declaration) (local base)))))
			(return (call entry_at (local node) (i32.add.wrapping (local index) (i32 1)) (u32 0)))))

	(fn register_module_records
		(:doc `Register every active type in a file before any of its signatures are read.

		A graph supplies the file's tree base and the next available record
		row. Single-file checking starts both positions at zero.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (count i32) (base i32)
			(file i32) (module u32) (records (mut-slice ScalarRecord)) (start i32))
		(returns EntryRead)
		(body
			(let-mut index (i32 0))
			(let-mut next (local start))
			(while
				(:doc "Use the selected declarations in source order to preserve layout diagnostics.")
				(i32.lt (local index) (local count))
				(body
					(let form (i32.add.wrapping (local base) (record.get (slice.load (local declarations) (local index)) node)))
					(if
						(:doc "Only struct declarations populate the type namespace.")
						(u32.eq (call declaration_kind (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)) (u32 48))
						(then
							(let checked (call register_record (borrow-shared (local source)) (borrow-shared (local nodes))
								(local form) (local file) (local base) (local module) (borrow-mut (local records)) (local next)))
							(if
								(:doc "Preserve the original invalid type or field span.")
								(u32.lt (u32 0) (record.get (local checked) error))
								(then (return (local checked))))
							(set (local next) (record.get (local checked) operand))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (record.make EntryRead (operand (local next)) (start (i32 0)) (end (i32 0))
				(error (u32 0)) (related (i32 -1)))))))
