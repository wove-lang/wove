(module scalar_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register checked module-local scalar record layouts.

	Retain the defining file, name, and first field in the source tree.
	Resolve fields by original spelling and use declaration order for
	their native ordinals. The record table is a zero-initialized prefix.`)

	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge project_bridge))
	(use wove-file "../source/scan.wove" (only is_disabled_form is_metadata_form (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts validate_form_metadata (type SelectedDeclaration)))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_reserved_type_name reference_mode is_builtin_integer))
	(use wove-file "../source/owned.wove" (only is_byte_owner_descriptor))
	(use wove-file "../emit/names.wove" (only record_identity))
	(use wove-file "./syntax.wove"
		(only entry_at entry_form entry_keyword is_scalar_name same_name scalar_type is_byte_view_type read_fixed_array_shape is_fixed_array_type_head
			(type EntryRead) (type FixedArrayShape)))

	(struct
		(:doc "A fixed-array row has a negative name, with element type in first and extent in count.")
		ScalarRecord
		(fields (name i32) (file i32) (identity u32) (first i32) (count i32)
			(declaration i32) (native i32) (source_base i32) (emit_row i32)))
	(struct ScalarMember (fields (ordinal i32) (row i32)))
	(struct LayoutVisit (fields (row i32) (field i32)))
	(struct LayoutCheck (fields (file i32) (start i32) (end i32) (error u32)))

	(fn is_record_type
		(:doc `Recognize value types for registered aggregate layouts.

		Even an empty record definition uses five tree rows.
		A definition also uses more than eight source bytes. The signed
		graph arena therefore bounds the layout and native alias table below 2^28.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (bool.not (u32.lt (local type) 64u32))
			(u32.lt (local type) 268435456u32)))))

	(fn record_type
		(:doc `Encode a checked record row as a type distinct from the built-ins.`)
		(params (row i32))
		(returns u32)
		(body (return (u32.add.wrapping (int.convert u32 (local row)) 64u32))))

	(fn is_fixed_array
		(:doc `Distinguish an anonymous fixed array from a named record in the layout table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (i32.lt (struct.get (local layout) name) 0i32))))

	(fn find_fixed_array_type
		(:doc `Find the one structural type for the exact scalar element and extent.`)
		(params (records (shared-slice ScalarRecord)) (shape FixedArrayShape))
		(returns u32)
		(body
			(let element (struct.get (local shape) element))
			(if (u32.eq (local element) 0u32) (then (return 0u32)))
			(let-mut index 0i32)
			(while
				(:doc "Only populated fixed layouts can match a structural type.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let layout (slice.load (local records) (local index)))
					(if (i32.eq (struct.get (local layout) name) 0i32) (then (return 0u32)))
					(if
						(:doc "Both shape components must agree, including a zero extent.")
						(bool.and (call is_fixed_array (local layout))
							(bool.and (i32.eq (struct.get (local layout) first) (int.convert i32 (local element)))
								(i32.eq (struct.get (local layout) count) (struct.get (local shape) extent))))
						(then (return (call record_type (local index)))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return 0u32)))

	(fn fixed_array_type
		(:doc `Resolve a fixed array spelling against the structural layout table.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(records (shared-slice ScalarRecord)) (node SourceNode))
		(returns u32)
		(body
			(return (call find_fixed_array_type (borrow-shared (local records))
				(call read_fixed_array_shape (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))))))

	(fn next_layout_node
		(:doc `Advance through one declaration without following its outer siblings.`)
		(params (nodes (shared-slice SourceNode)) (index i32) (declaration i32) (descend bool))
		(returns i32)
		(body
			(let first (struct.get (slice.load (local nodes) (local index)) first_child))
			(if
				(:doc "An ordinary nonempty form exposes its first child.")
				(bool.and (local descend) (i32.lt -1i32 (local first)))
				(then (return (local first))))
			(let-mut cursor (local index))
			(while
				(:doc "Find the next sibling or finish when the walk returns to its declaration.")
				(bool.not (i32.eq (local cursor) (local declaration)))
				(body
					(let node (slice.load (local nodes) (local cursor)))
					(let next (struct.get (local node) next_sibling))
					(if (i32.lt -1i32 (local next)) (then (return (local next))))
					(set (local cursor) (struct.get (local node) parent))))
			(return -1i32)))

	(fn intern_fixed_array
		(:doc `Append one new valid shape and return the next free layout row.`)
		(params (shape FixedArrayShape) (records (mut-slice ScalarRecord)) (next i32))
		(returns i32)
		(body
			(let element (struct.get (local shape) element))
			(if
				(:doc "An invalid shape or an existing type needs no layout row.")
				(bool.or (u32.eq (local element) 0u32)
					(u32.lt 0u32 (call find_fixed_array_type (borrow-shared (local records)) (local shape))))
				(then (return (local next))))
			(slice.store (local records) (local next)
				(struct.new ScalarRecord (name -1i32) (file -1i32)
					(identity (int.convert u32 (local next))) (first (int.convert i32 (local element)))
					(count (struct.get (local shape) extent)) (declaration -1i32) (native 0i32)
					(source_base 0i32) (emit_row 0i32)))
			(return (i32.add.wrapping (local next) 1i32))))

	(fn is_disabled_statement
		(:doc `Distinguish a disabled statement group from a field or parameter with that name.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(if
				(:doc "Only the disabled form head needs a statement context check.")
				(bool.not (call is_disabled_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
				(then (return (bool false))))
			(let parent (slice.load (local nodes) (struct.get (local node) parent)))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parent) first_child)))
			(return (bool.or (u32.eq (local tag) 6u32)
				(bool.or (u32.eq (local tag) 23u32) (u32.eq (local tag) 24u32))))))

	(fn register_fixed_arrays
		(:doc `Intern array shapes in one selected declaration before its types are checked.

		Layout discovery skips disabled statements and metadata. Malformed
		types remain for the signature, field, or expression checker to report.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32)
			(records (mut-slice ScalarRecord)) (start i32))
		(returns i32)
		(body
			(let-mut index (struct.get (slice.load (local nodes) (local declaration)) first_child))
			(let-mut next (local start))
			(while
				(:doc "Visit only descendants of the selected declaration.")
				(i32.lt -1i32 (local index))
				(body
					(let node (slice.load (local nodes) (local index)))
					(let head (struct.get (local node) first_child))
					(let ordinary (bool.and
						(bool.and (u32.eq (struct.get (local node) kind) 40u32) (i32.lt -1i32 (local head)))
						(bool.not (bool.or
							(call is_disabled_statement (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))
							(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))))))
					(if
						(:doc "Only the fixed-array type head supplies an element and extent.")
						(bool.and (local ordinary)
							(call is_fixed_array_type_head (borrow-shared (local source)) (slice.load (local nodes) (local head))))
						(then
							(let shape (call read_fixed_array_shape (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
							(set (local next) (call intern_fixed_array (local shape) (borrow-mut (local records)) (local next)))))
					(set (local index) (call next_layout_node (borrow-shared (local nodes)) (local index) (local declaration) (local ordinary)))))
			(return (local next))))

	(fn record_index
		(:doc `Recover the checked defining row from a named record type.`)
		(params (type u32))
		(returns i32)
		(body (return (int.convert i32 (u32.sub.wrapping (local type) 64u32)))))

	(fn native_integer_type
		(:doc `Encode a copyable native integer by its defining type-table row.`)
		(params (row i32))
		(returns u32)
		(body (return (u32.add.wrapping 268435456u32 (int.convert u32 (local row))))))

	(fn is_native_integer
		(:doc `Recognize native integer aliases separately from scalar records and pointer owners.`)
		(params (type u32))
		(returns bool)
		(body (return (bool.and (bool.not (u32.lt (local type) 268435456u32))
			(u32.lt (local type) 536870912u32)))))

	(fn native_integer_index
		(:doc `Recover the defining row from a checked native integer type.`)
		(params (type u32))
		(returns i32)
		(body (return (int.convert i32 (u32.sub.wrapping (local type) 268435456u32)))))

	(fn find_native_definition
		(:doc `Find one exact defining native declaration in the populated type table.`)
		(params (records (shared-slice ScalarRecord)) (file i32) (declaration i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Both native aliases and record views carry their defining C literal.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let row (slice.load (local records) (local index)))
					(if (i32.eq (struct.get (local row) name) 0i32) (then (return -1i32)))
					(if
						(:doc "Names and ABI spelling can coincide without sharing Wove identity.")
						(bool.and (i32.lt 0i32 (struct.get (local row) native))
							(bool.and (i32.eq (struct.get (local row) file) (local file))
								(i32.eq (struct.get (local row) declaration) (local declaration))))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return -1i32)))

	(fn find_native_node
		(:doc "Resolve a defining native name by its unique node in the flattened graph.")
		(params (records (shared-slice ScalarRecord)) (name i32)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The defining name node is independent of its provider's local import aliases.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let row (slice.load (local records) (local index)))
					(let candidate (struct.get (local row) name))
					(if (i32.eq (local candidate) 0i32) (then (return -1i32)))
					(if
						(:doc "Only canonical C alias and record rows may satisfy a native type use.")
						(bool.and (i32.eq (local name) (local candidate)) (i32.lt 0i32 (struct.get (local row) native)))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return -1i32)))

	(fn is_native_record
		(:doc `Distinguish native record views from Wove-defined records and native integer aliases.`)
		(params (record ScalarRecord))
		(returns bool)
		(body
			(return (bool.and (i32.lt 0i32 (struct.get (local record) native))
				(i32.lt -1i32 (struct.get (local record) count))))))

	(fn native_field_type
		(:doc `Resolve a checked field type in its defining bridge, independent of importer aliases.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord))
			(layout ScalarRecord) (field i32))
		(returns u32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (slice.load (local nodes) (local field))))
			(let operand (struct.get (local parts) operands))
			(let builtin (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local operand)))
			(if (u32.lt 0u32 (local builtin)) (then (return (local builtin))))
			(let name (slice.load (local nodes) (local operand)))
			(let declaration (struct.get (slice.load (local nodes) (struct.get (local layout) name)) parent))
			(let bridge (call declaring_c_bridge (borrow-shared (local source)) (borrow-shared (local nodes))
				(slice.load (local nodes) (local declaration))))
			(let project (call project_bridge (borrow-shared (local nodes)) (local bridge)))
			(let-mut index 0i32)
			(while
				(:doc "Only canonical types in the same active C bridge can describe the field.")
				(i32.lt (local index) (slice.len (local records)))
				(body
					(let row (slice.load (local records) (local index)))
					(let candidate (struct.get (local row) name))
					(if (i32.eq (local candidate) 0i32) (then (return 0u32)))
					(if
						(:doc "Fixed-array rows have no source name. Inspect only defining C layouts and aliases.")
						(i32.lt 0i32 (struct.get (local row) native))
						(then
							(let spelling (slice.load (local nodes) (local candidate)))
							(if
								(:doc "Use the bridge's defining type identity and exact native kind.")
								(call same_name (borrow-shared (local source)) (local spelling) (local name))
								(then
									(let owner (call declaring_c_bridge (borrow-shared (local source)) (borrow-shared (local nodes))
										(slice.load (local nodes) (struct.get (local spelling) parent))))
									(if
										(:doc "Both providers contribute types to the same resolved bridge namespace.")
										(i32.eq (local project) (call project_bridge (borrow-shared (local nodes)) (local owner)))
										(then
											(if (call is_native_record (local row)) (then (return (call record_type (local index)))))
											(return (call native_integer_type (local index)))))))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return 0u32)))

	(fn is_array_owner
		(:doc `Identify one local owner of a byte or record allocation.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local type) 41u32)
				(bool.and (bool.not (u32.lt (local type) 536870912u32)) (u32.lt (local type) 1073741824u32))))))

	(fn array_owner_type
		(:doc `Encode an owning array with the checked allocation's exact element type.`)
		(params (element u32))
		(returns u32)
		(body
			(if
				(:doc "Keep the existing byte owner type code.")
				(u32.eq (local element) 10u32)
				(then (return 41u32)))
			(return (u32.add.wrapping (local element) 536870912u32))))

	(fn array_owner_element
		(:doc `Recover the element type of a checked byte or record owner.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "The original owner code identifies a byte array.")
				(u32.eq (local type) 41u32)
				(then (return 10u32)))
			(return (u32.sub.wrapping (local type) 536870912u32))))

	(fn byte_rows_owner_type
		(:doc `Represent an array whose elements each own their byte storage.`)
		(params)
		(returns u32)
		(body (return (call array_owner_type (call array_owner_type 10u32)))))

	(fn is_typed_slice
		(:doc `Identify the shared and mutable typed slice intervals, excluding byte views and native references.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or
			(bool.and (bool.not (u32.lt (local type) 1073741824u32)) (u32.lt (local type) 1342177280u32))
			(bool.and (bool.not (u32.lt (local type) 1610612736u32)) (u32.lt (local type) 1879048192u32))))))

	(fn is_writable_slice
		(:doc `Identify any slice descriptor with writable access.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local type) 38u32)
			(bool.and (bool.not (u32.lt (local type) 1610612736u32)) (u32.lt (local type) 1879048192u32))))))

	(fn is_mutable_place_reference
		(:doc `Identify the encoding for an exclusive reference to a scalar or record place.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (bool.not (u32.lt (local type) 1879048192u32)) (u32.lt (local type) 2147483648u32)))))

	(fn is_place_reference
		(:doc `Distinguish call-scoped place references from values and slice descriptors.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_mutable_place_reference (local type))
			(bool.and (bool.not (u32.lt (local type) 1342177280u32)) (u32.lt (local type) 1610612736u32))))))

	(fn place_borrow_kind
		(:doc `Identify a checked argument that borrows the original storage of a place.`)
		(:pragma (inline always))
		(params)
		(returns u32)
		(body (return 63u32)))

	(fn place_reference_type
		(:doc `Encode a call-scoped reference to its exact scalar or record type.`)
		(params (type u32) (mutable bool))
		(returns u32)
		(body
			(let code (call encode_place_type (local type)))
			(if
				(:doc "An exclusive reference has its own type interval.")
				(local mutable)
				(then (return (u32.add.wrapping (local code) 1879048192u32))))
			(return (u32.add.wrapping (local code) 1342177280u32))))

	(fn place_reference_code
		(:doc `Recover the encoded pointee from either reference mode.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "Remove the offset reserved for mutable references.")
				(call is_mutable_place_reference (local type))
				(then (return (u32.sub.wrapping (local type) 1879048192u32))))
			(return (u32.sub.wrapping (local type) 1342177280u32))))

	(fn place_reference_target
		(:doc `Recover the original type identity of a borrowed place.`)
		(params (records (shared-slice ScalarRecord)) (type u32))
		(returns u32)
		(body (return (call decode_place_type (borrow-shared (local records)) (call place_reference_code (local type))))))

	(fn record_receiver_type
		(:doc `Resolve the layout of a field receiver whether read by value or through a reference.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "A reference keeps access mode separate from the defining layout.")
				(call is_place_reference (local type))
				(then (return (call place_reference_code (local type)))))
			(return (local type))))

	(fn encode_place_type
		(:doc `Encode native integers and records with their disjoint layout table rows. Built-ins keep their codes.`)
		(params (element u32))
		(returns u32)
		(body
			(if
				(:doc "Native aliases use the same table as record layouts, with a disjoint defining row.")
				(call is_native_integer (local element))
				(then (return (call record_type (call native_integer_index (local element))))))
			(return (local element))))

	(fn typed_slice_type
		(:doc `Encode a typed slice from its exact element and access mode.`)
		(params (element u32) (writable bool))
		(returns u32)
		(body
			(let encoded (call encode_place_type (local element)))
			(if
				(:doc "Mutable slices use the writable type interval.")
				(local writable)
				(then (return (u32.add.wrapping (local encoded) 1610612736u32))))
			(return (u32.add.wrapping (local encoded) 1073741824u32))))

	(fn typed_slice_element_code
		(:doc `Recover the element code for comparing view types or switching access modes.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "Remove the mutable slice interval's base.")
				(call is_writable_slice (local type))
				(then (return (u32.sub.wrapping (local type) 1610612736u32))))
			(return (u32.sub.wrapping (local type) 1073741824u32))))

	(fn slice_element_code
		(:doc `Recover a byte or typed view's encoded element for matching or a fixed-array descriptor.`)
		(params (type u32))
		(returns u32)
		(body
			(if
				(:doc "Typed descriptors carry the element in their own interval.")
				(call is_typed_slice (local type))
				(then (return (call typed_slice_element_code (local type)))))
			(return 10u32)))

	(fn decode_place_type
		(:doc `Recover a scalar or record type stored in a reference or slice interval.`)
		(params (records (shared-slice ScalarRecord)) (code u32))
		(returns u32)
		(body
			(if
				(:doc "A table-backed code names either a record layout or a native alias.")
				(call is_record_type (local code))
				(then
					(let row (call record_index (local code)))
					(if
						(:doc "Only native integer aliases have a negative field count.")
						(i32.lt (struct.get (slice.load (local records) (local row)) count) 0i32)
						(then (return (call native_integer_type (local row)))))))
			(return (local code))))

	(fn slice_element_type
		(:doc `Recover the exact scalar, record, or native integer type of a slice's element.`)
		(params (records (shared-slice ScalarRecord)) (type u32))
		(returns u32)
		(body (return (call decode_place_type (borrow-shared (local records)) (call slice_element_code (local type))))))

	(fn is_fixed_scalar_slice
		(:doc `Identify a typed slice that can borrow an inline built-in integer array.`)
		(params (type u32))
		(returns bool)
		(body
			(return (bool.and (call is_typed_slice (local type))
				(call is_builtin_integer (call typed_slice_element_code (local type)))))))

	(fn is_readable_slice
		(:doc `Recognize every slice descriptor that supports length and load.`)
		(params (type u32))
		(returns bool)
		(body (return (bool.or (call is_byte_view_type (local type)) (call is_typed_slice (local type))))))

	(fn declaration_kind
		(:doc `Classify a selected declaration by its original head.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (declaration i32))
		(returns u32)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
				(slice.load (local nodes) (local declaration))))
			(return (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local parts) head)))))

	(fn count_declarations
		(:doc `Count selected declarations of one kind before allocating its checked table.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(declarations (shared-slice SelectedDeclaration)) (count i32) (kind u32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let-mut selected 0i32)
			(while
				(:doc "Inactive and grouped declarations have already been filtered by the module reader.")
				(i32.lt (local index) (local count))
				(body
					(let form (struct.get (slice.load (local declarations) (local index)) node))
					(if
						(:doc "Ignore declarations belonging to other kinds.")
						(u32.eq (call declaration_kind (borrow-shared (local source)) (borrow-shared (local nodes)) (local form)) (local kind))
						(then (set (local selected) (i32.add.wrapping (local selected) 1i32))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (local selected))))

	(fn find_record
		(:doc `Resolve a local or imported record spelling to its defining layout.

		A graph maps the spelling to a canonical file and file-local
		declaration row. A single-file caller uses its local type table.`)
