			(let-mut type 0u32)
			(if
				(:doc "Type arguments are named Wove types or explicit record applications.")
				(bool.or (call is_scalar_name (borrow-shared (local source)) (local node))
					(call has_specialization_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
				(then (set (local type) (call value_type (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings))
					(struct.get (local scope) file) (struct.get (local scope) source_base) (local argument)))))
