(module scalar_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register checked module-local scalar record layouts.

	Retain the defining file, name, and first field in the source tree.
	Resolve fields by original spelling and use declaration order for
	their native ordinals. The record table is a zero-initialized prefix.`)

	(use wove-file "../source/generics.wove"
		(only has_generic_head has_specialization_head function_generic_list read_generic_parameter generic_argument_kind
			read_generic_i32 read_generic_bool constant_at constant_type_operand is_checked_non_type_operand
			(value checked_type_operand) (value checked_i32_operand) (value checked_bool_operand) (value checked_enum_operand) (value generic_bool_kind) (value generic_enum_kind) (value generic_operation_kind)
			(value checked_operation_operand)
			(type GenericConstant)))
	(use wove-file "../source/enum_forms.wove" (only (value enum_declaration) (value variants_list) (value match_case)))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion integer_byte_width is_integer_byte_encoder receiver_may_encode_bytes))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge project_bridge))
	(use wove-file "../source/c_dependencies.wove" (only find_bridge_type_dependency))
	(use wove-file "../source/scan.wove" (only is_disabled_form is_metadata_form (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts next_form_operand validate_form_metadata (type SelectedDeclaration)))
	(use wove-file "../source/imports.wove" (only import_keyword))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_reserved_type_name reference_mode is_builtin_integer is_builtin_float is_builtin_numeric is_builtin_scalar is_256bit_integer (value i256_type)))
	(use wove-file "./native_owner_types.wove" (only (value buffered_record_base) (value optional_buffered_record_base) (value optional_reference_base) (value optional_array_base) native_owner_type is_native_owner))
	(use wove-file "../source/owned.wove" (only owned_element_node is_byte_owner_descriptor optional_type_operand))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../emit/names.wove" (only record_identity (value fixed_array_role)))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_byte fnv1a_u32_le (value fnv1a_seed)))
	(use wove-file "./callable_types.wove" (only read_callable_type callable_identity order_callable_signatures (type CallableShape)))
	(use wove-file "./constants.wove" (only fold_i32 constant_check))
	(use wove-file "./syntax.wove"
		(only entry_at entry_form entry_keyword enum_operands is_scalar_name same_name scalar_type is_byte_view_type is_fixed_array_type_head
			callable_keyword (value fn_type_kind)
			(type EntryRead) (type EnumOperands) (type FixedArrayShape)))

	(struct ScalarRecord
		(:doc `One registered value layout or native type.

		A native pointer owner stores its flattened defining row in first.
		A native long double alias carries its C literal and uses count -2.
		A native C23 null alias carries its C literal and uses count -3.
		A fixed array has name -1, element type in first, and
		extent in count. Its identity is a C fingerprint of the shape.
		Unit and payload enums have native -1 and -2.
		They keep their first variant and count in the same positions
		as a record's fields. A specialization records its original argument
		site and namespace. A repeated site has a non-emitting alias row with name -2.
		An owning array element has a non-emitting row with name -3 and its exact type in first.
		A callable layout stores the first formal in first, its scalar or
		void result in argument_file, and its formal shape in argument_base.
		Its C fingerprint uses only the result and ordered parameter types.
		A callable alias has name -5, the defining type form in first, and
		the canonical type code in alias_of.`)
		(fields (name i32) (file i32) (identity u32) (c_name_ordinal i32) (first i32) (count i32)
			(declaration i32) (native i32) (source_base i32) (emit_row i32) (owns_arrays bool) (borrows_bytes bool)
			(generic i32) (specialization i32) (argument_file i32) (argument_base i32) (alias_of i32)))

	(fn record_with_c_name_ordinal
		(:doc "Assign a private C spelling slot while preserving the exact checked record row.")
		(params (entry ScalarRecord) (slot i32)) (returns ScalarRecord)
		(body
			(return (ScalarRecord.new (name entry/name) (file entry/file)
				(identity entry/identity) (c_name_ordinal slot)
				(first entry/first) (count entry/count)
				(declaration entry/declaration) (native entry/native)
				(source_base entry/source_base) (emit_row entry/emit_row)
				(owns_arrays entry/owns_arrays) (borrows_bytes entry/borrows_bytes)
				(generic entry/generic) (specialization entry/specialization)
				(argument_file entry/argument_file) (argument_base entry/argument_base)
				(alias_of entry/alias_of)))))

	(struct TypeScope (fields (file i32) (source_base i32)))
	(struct SpecializationKey (fields (template i32) (identity u32) (start i32) (end i32) (error u32)))
	(let specialization_domain 1667592307u32)

	(struct ScalarMember (fields (ordinal i32) (row i32)))
	(struct LayoutVisit (fields (row i32) (field i32) (element bool)))
	(struct LayoutCheck (fields (file i32) (start i32) (end i32) (error u32)))

	(fn is_record_type
		(:doc `Recognize value types represented by registered layouts.

		Even an empty record definition uses five tree rows.
		A definition also uses more than eight source bytes. The signed
		graph arena bounds the layout and native alias rows well below 2^28.
		The last two codes in that interval represent the C23 integer values.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool:and (type.not-lt 64u32)
			(type.lt i256_type)))))

	(let callable_layout_name -4i32)
	(let callable_alias_name -5i32)
	(let callable_alias_kind 593u32)
	(let callable_type_base 805306368u32)
	(let callable_type_limit 1073741824u32)

	(fn is_callable_type
		(:doc "Recognize the structural signature interval above the supported array element codes.")
		(params (type u32)) (returns bool)
		(body
			(return (bool:and (type.not-lt callable_type_base)
				(type.lt callable_type_limit)))))

	(fn is_callable_layout
		(:doc "Distinguish a function-pointer signature from data layouts in the shared table.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (layout/name.eq callable_layout_name))))

	(fn is_callable_alias
		(:doc "Identify a defining type name that refers to an interned signature.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (layout/name.eq callable_alias_name))))

	(fn callable_index
		(:doc "Get the interned signature row for a checked function value.")
		(params (type u32)) (returns i32)
		(body (return (i32:from-u32 (type.sub callable_type_base)))))

	(fn callable_layout_shape
		(:doc "Recover the signature's first formal, exact result, and parameter spelling form.")
		(params (layout ScalarRecord)) (returns CallableShape)
		(body
			(return (CallableShape.new (first layout/first)
				(result (u32:from-i32 layout/argument_file))
				(named layout/argument_base.gtz) (start 0i32) (end 0i32) (error 0u32)))))

	(fn find_callable_type
		(:doc "Reuse the same type code for every structurally identical checked signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(shape CallableShape))
		(returns u32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only populated callable rows can match this signature.")
				(index.lt records.len)
				(body
					(let layout (records.get index))
					(if layout/name.eqz (then (return 0u32)))
					(if
						(:doc "Check the exact result and ordered scalar parameters.")
						(bool:and (call is_callable_layout layout)
							(layout/argument_file.eq (i32:from-u32 shape/result)))
						(then
							(let candidate (call callable_layout_shape layout))
							(if
								(:doc "A named declaration and an inline signature can denote the same type.")
								(i32:eqz (call order_callable_signatures (borrow-shared source) (borrow-shared nodes) candidate shape))
								(then (return (callable_type_base.add (u32:from-i32 index)))))))
					(set index index.inc)))
			(return 0u32)))

	(fn intern_callable_layout
		(:doc "Append one canonical signature when no existing layout matches it.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (mut-array ScalarRecord))
			(shape CallableShape) (next i32))
		(returns i32)
		(body
			(if
				(:doc "Leave invalid signatures for the originating formal or reference to diagnose.")
				(shape/error.gtz.or
					(u32:gtz (call find_callable_type (borrow-shared source) (borrow-shared nodes) (borrow-shared records) shape)))
				(then (return next)))
			(if
				(:doc "Check both the supplied table and the type-code interval before appending.")
				(bool:or (next.not-lt records.len) (next.not-lt 268435456i32))
				(then (return -1i32)))
			(let-mut named 0i32)
			(if shape/named (then (set named 1i32)))
			(records.set next
				(ScalarRecord.new (c_name_ordinal 0i32) (name callable_layout_name) (file -1i32)
					(identity (call callable_identity (borrow-shared source) (borrow-shared nodes) shape))
					(first shape/first) (count 0i32)
					(declaration -1i32) (native -3i32) (source_base 0i32) (emit_row next)
					(owns_arrays (bool false)) (borrows_bytes (bool false)) (generic -1i32) (specialization -1i32)
					(argument_file (i32:from-u32 shape/result)) (argument_base named) (alias_of -1i32)))
			(return next.inc)))

	(fn find_callable_alias
		(:doc "Resolve a checked type name through its defining file and original declaration.")
		(params (source (shared-array u8)) (name SourceNode) (scope TypeScope)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)))
		(returns u32)
		(body
			(let index (call find_binding (borrow-shared source) (borrow-shared source)
				name/start name/end (borrow-shared bindings) bindings.len
				scope/file (bool false) scope/source_base 1u32))
			(if index.ltz (then (return 0u32)))
			(let binding (bindings.get index))
			(let-mut row 0i32)
			(while
				(:doc "Match only registered callable aliases in the populated layout prefix.")
				(row.lt records.len)
				(body
					(let alias (records.get row))
					(if alias/name.eqz (then (return 0u32)))
					(if
						(:doc "An import rename shares the defining alias's canonical type.")
						(bool:and (call is_callable_alias alias)
							(bool:and (alias/file.eq binding/file)
								(alias/declaration.eq binding/declaration)))
						(then (return (u32:from-i32 alias/alias_of))))
					(set row row.inc)))
			(return 0u32)))

	(fn layout_count
		(:doc "Find the populated prefix of the zero-initialized layout table.")
		(params (records (shared-array ScalarRecord))) (returns i32)
		(body
			(let-mut low 0i32)
			(let-mut high records.len)
			(while
				(:doc "Narrow to the first unused layout slot.")
				(low.lt high)
				(body
					(let middle (low.add (i32:from-u32 (u32:shr (u32:from-i32 (high.sub low)) 1i32))))
					(if
						(:doc "Every populated entry precedes the zeroed tail.")
						(i32:eqz (struct:get (records.get middle) name))
						(then (set high middle))
						(else (set low middle.inc)))))
			(return low)))

	(fn is_owning_record
		(:doc "Identify Wove value layouts that own array storage.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool:and (call is_record_type type)
				(struct:get (records.get (call record_index type)) owns_arrays)))))

	(fn is_scoped_record
		(:doc "Identify record layouts that carry a shared byte-array loan.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool:and (call is_record_type type)
				(struct:get (records.get (call record_index type)) borrows_bytes)))))

	(fn is_owning_struct_element
		(:doc "Identify a named owning Wove struct with no borrowed storage.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(if (bool:not (call is_record_type type)) (then (return (bool false))))
			(let layout (records.get (call record_index type)))
			(return (layout/owns_arrays.and
				(layout/native.eqz.and
					(layout/name.gtz.and
						layout/borrows_bytes.not))))))

	(fn is_owning_fixed_array
		(:doc "Identify an inline array with individually occupied owner slots.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body
			(return (bool:and (call is_owning_record (borrow-shared records) type)
				(call is_fixed_array (records.get (call record_index type)))))))

	(fn has_inline_owner_slots
		(:doc "Find a fixed owner through the acyclic inline layout. Heap descriptors end the walk.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32)) (returns bool)
		(body
			(if (call is_owning_fixed_array (borrow-shared records) type) (then (return (bool true))))
			(if (bool:not (call is_owning_struct_element (borrow-shared records) type)) (then (return (bool false))))
			(let layout (records.get (call record_index type)))
			(let-mut field layout/first)
			(while
				(:doc "Exact field types include substitutions from the concrete record instance.")
				field.not-ltz
				(body
					(let member (nodes.get field))
					(let member_type (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout member))
					(if
						(:doc "One embedded owning fixed layout requires the runtime check.")
						(call has_inline_owner_slots (borrow-shared source) (borrow-shared nodes)
							(borrow-shared records) (borrow-shared bindings) member_type)
						(then (return (bool true))))
					(set field member/next_sibling)))
			(return (bool false))))

	(fn is_owning_array_element
		(:doc "Use an initialized heap slot for an owning named struct or an owning fixed layout.")
		(params (records (shared-array ScalarRecord)) (type u32)) (returns bool)
		(body (return (bool:or (call is_owning_struct_element (borrow-shared records) type)
			(call is_owning_fixed_array (borrow-shared records) type)))))

	(fn owned_array_leaf_type
		(:doc "Resolve an array element without allowing scoped records or owning enum payloads.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let type (call value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) file source_base index))
			(if
				(:doc "An owning struct can move between slots only when its lifetime is independent.")
				(bool:or (call is_scoped_record (borrow-shared records) type)
					(bool:and (call is_owning_record (borrow-shared records) type)
						(bool:not (call is_owning_array_element (borrow-shared records) type))))
				(then (return 0u32)))
			(return type)))

	(fn record_type
		(:doc `Encode a checked record row as a type distinct from the built-ins.`)
		(params (row i32))
		(returns u32)
		(body (return (u32:add (u32:from-i32 row) 64u32))))

	(fn is_fixed_array
		(:doc `Distinguish an anonymous fixed array from a named record in the layout table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (layout/name.eq -1i32))))

	(fn is_enum_layout
		(:doc `Recognize either nominal enum layout in the shared type table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (bool:or (layout/native.eq -1i32)
			(layout/native.eq -2i32)))))

	(fn is_fieldless_enum
		(:doc "Identify an enum whose variants all use unit storage.")
		(params (layout ScalarRecord)) (returns bool)
		(body (return (layout/native.eq -1i32))))

	(fn is_payload_enum
		(:doc `Identify an enum containing at least one payload variant.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (layout/native.eq -2i32))))

	(fn find_fixed_array_type
		(:doc `Find the one structural type for the exact element and extent.`)
		(params (records (shared-array ScalarRecord)) (shape FixedArrayShape))
		(returns u32)
		(body
			(let element shape/element)
			(if (element.eqz.or shape/extent.ltz) (then (return 0u32)))
			(let-mut index 0i32)
			(while
				(:doc "Only populated fixed layouts can match a structural type.")
				(index.lt records.len)
				(body
					(let layout (records.get index))
					(if layout/name.eqz (then (return 0u32)))
					(if
						(:doc "Both shape components must agree, including a zero extent.")
						(bool:and (call is_fixed_array layout)
							(bool:and (layout/first.eq (i32:from-u32 element))
								(layout/count.eq shape/extent)))
						(then (return (call record_type index))))
					(set index index.inc)))
			(return 0u32)))

	(fn array_extent_operand
		(:doc "Keep the final extent operand after a checked element row.")
		(params (nodes (shared-array SourceNode)) (element i32)) (returns i32)
		(body
			(let index (struct:get (nodes.get element) next_sibling))
			(if index.ltz (then (return -1i32)))
			(let extent (nodes.get index))
			(if
				(:doc "The full array shape ends with one size token or constant expression.")
				(bool:or (bool:and (extent/kind.not-eq 1u32)
					(extent/kind.not-eq 40u32))
					(i32:lt -1i32 extent/next_sibling))
				(then (return -1i32)))
			(return index)))

	(fn read_array_extent
		(:doc "Read a decimal size or resolve an immutable integer in the current file's value namespace.")
		(params (source (shared-array u8)) (node SourceNode) (bindings (shared-array GraphBinding))
			(file i32) (source_base i32)) (returns i32)
		(body
			(if
				(:doc "A substituted constant carries exact signed i32 bits. Array extents require a clear sign bit.")
				(node/generic_kind.eq checked_i32_operand)
				(then
					(let bits node/generic_value)
					(if (u32:lt 2147483647u32 bits) (then (return -1i32)))
					(return (i32:from-u32 bits))))
			(if
				(:doc "A non-i32 parameter cannot fall through to an identically spelled module integer.")
				(bool:or (node/generic_kind.eq checked_type_operand)
					(call is_checked_non_type_operand node/generic_kind))
				(then (return -1i32)))
			(let start node/start)
			(let end node/end)
			(if
				(:doc "An identifier may be a local value or a selective import of its defining module.")
				(call is_scalar_name (borrow-shared source) node)
				(then
					(let binding (call find_binding (borrow-shared source) (borrow-shared source)
						start end (borrow-shared bindings) bindings.len
						file (bool false) source_base 2u32))
					(if binding.ltz (then (return -1i32)))
					(return (struct:get (bindings.get binding) extent))))
			(let parsed (call read_decimal_digits (borrow-shared source) start end 214748364u32 7u32))
			(if parsed/digits.ltz (then (return -1i32)))
			(return (i32:from-u32 parsed/magnitude))))

	(fn check_array_extent
		(:doc "Check a literal, a visible immutable size, or an exact i32 computation as an extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(index i32) (file i32) (source_base i32)) (returns EntryRead)
		(body
			(let site (nodes.get index))
			(let-mut count -1i32)
			(if
				(:doc "Preserve the expression diagnostic from inside an inline extent.")
				(site/kind.eq 40u32)
				(then
					(let folded (call fold_i32 (borrow-shared source) (borrow-shared nodes) (borrow-shared bindings)
						index file source_base))
					(if folded/error.gtz (then (return (call constant_check folded))))
					(let bits folded/bits)
					(if (u32:not-lt 2147483647u32 bits) (then (set count (i32:from-u32 bits)))))
				(else
					(set count (call read_array_extent (borrow-shared source) site
						(borrow-shared bindings) file source_base))))
			(if count.ltz (then (return (call entry_at site -1i32 23u32))))
			(return (call entry_at site count 0u32))))

	(fn invalid_array_type
		(:doc "Keep the original extent error when a valid array shape fails at its size operand.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32)) (returns EntryRead)
		(body
			(let invalid (call entry_at node -1i32 23u32))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node 70u32 23u32))
			(let element form/operand)
			(if element.ltz (then (return invalid)))
			(let index (call array_extent_operand (borrow-shared nodes) element))
			(if index.ltz (then (return invalid)))
			(let size (nodes.get index))
			(if
				(:doc "Unnamed numeric sizes retain the existing whole-type diagnostic.")
				(bool:or (call is_scalar_name (borrow-shared source) size)
					(size/kind.eq 40u32))
				(then
					(let checked (call check_array_extent (borrow-shared source) (borrow-shared nodes)
						(borrow-shared bindings) index file source_base))
					(if checked/error.gtz (then (return checked)))))
			(return invalid)))

	(fn record_array_element
		(:doc "Resolve a named Wove record or explicit specialization in the array spelling's type namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let name (nodes.get index))
			(if
				(:doc "A nested structural type or quoted spelling cannot name an element record.")
				(bool:not (bool:or (call is_scalar_name (borrow-shared source) name)
					(call has_specialization_head (borrow-shared source) (borrow-shared nodes) name)))
				(then (return 0u32)))
			(let type (call value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) file source_base index))
			(if (bool:not (call is_record_type type)) (then (return 0u32)))
			(let record (records.get (call record_index type)))
			(if
				(:doc "A Wove struct can own storage inside an array, but cannot carry a scoped loan there.")
				(record/borrows_bytes.or record/native.not-eqz)
				(then (return 0u32)))
			(return type)))

	(fn is_member_array
		(:doc "Recognize an explicit inline array type form before looking up its operands.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns bool)
		(body
			(let head node/first_child)
			(return (bool:and (bool:and (node/kind.eq 40u32) head.not-ltz)
				(call is_fixed_array_type_head (borrow-shared source) (nodes.get head))))))

	(fn fixed_element_operand
		(:doc "Read the element operand of a validated fixed array type form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns i32)
		(body
			(if (node/kind.not-eq 40u32) (then (return -1i32)))
