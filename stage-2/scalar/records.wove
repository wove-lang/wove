							(set (local depth) 0i32)
							(call enter_layout (local root) (slice.load (local records) (local root)) (local depth)
								(borrow-mut (local marks)) (borrow-mut (local stack)))))
					(while
						(:doc "Finish a layout once every field's defining layout has been emitted.")
						(i32.lt -1i32 (local depth))
						(body
							(let visit (slice.load (local stack) (local depth)))
							(let row (struct.get (local visit) row))
							(let field (struct.get (local visit) field))
							(if
								(:doc "Postorder publishes the original row after its children.")
								(i32.lt (local field) 0i32)
								(then
									(call publish_layout (borrow-mut (local records)) (local written) (local row))
									(slice.store (local marks) (local row) 2u8)
									(set (local written) (i32.add.wrapping (local written) 1i32))
									(set (local depth) (i32.sub.wrapping (local depth) 1i32)))
								(else
									(let member (slice.load (local nodes) (local field)))
									(let layout (slice.load (local records) (local row)))
									(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
										(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
									(if
										(:doc "Reject a field that has no visible Wove value type.")
										(u32.eq (local type) 0u32)
										(then (return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
											(local layout) (local member) 23u32))))
									(slice.store (local stack) (local depth)
										(struct.new LayoutVisit (row (local row)) (field (struct.get (local member) next_sibling))))
									(if
										(:doc "Only a by-value aggregate field needs a separate layout.")
										(call is_record_type (local type))
										(then
											(let child (call record_index (local type)))
											(let mark (slice.load (local marks) (local child)))
											(if
												(:doc "A visiting child closes a cycle through inline storage.")
												(u8.eq (local mark) 1u8)
												(then (return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
													(local layout) (local member) 23u32))))
											(if
												(:doc "Revisit this layout after ordering the unvisited child.")
												(u8.eq (local mark) 0u8)
												(then
													(set (local depth) (i32.add.wrapping (local depth) 1i32))
													(call enter_layout (local child) (slice.load (local records) (local child)) (local depth)
														(borrow-mut (local marks)) (borrow-mut (local stack)))))))))))
					(set (local root) (i32.add.wrapping (local root) 1i32))))
			(return (local ok))))

	(fn order_record_layouts
		(:doc `Allocate one traversal slot and mark per complete registered layout.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode))
			(bindings (shared-slice GraphBinding)) (records (mut-slice ScalarRecord)) (count i32))
		(returns LayoutCheck)
		(body
			(if
				(:doc "Scalar-only modules have no layout work or scratch allocation.")
				(i32.eq (local count) 0i32)
				(then (return (struct.new LayoutCheck (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))
			(let-mut marks (array.alloc u8 (local count)))
			(let-mut stack (array.alloc LayoutVisit (local count)))
			(return (call walk_record_layouts (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local bindings)) (borrow-mut (local records)) (local count)
				(borrow-mut (local marks)) (borrow-mut (local stack)))))))
