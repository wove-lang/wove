						(borrow-shared records) (borrow-shared bindings) definition_scope parameter))
					(let checked (call check_generic_argument (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) scope actual kind record_arguments))
					(if
						(:doc "A bad argument points to its original operand, with its own type or literal error.")
						checked/error.gtz
