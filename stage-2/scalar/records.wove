(module scalar_records
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Register checked module-local scalar record layouts.

	Retain the defining file, name, and first field in the source tree.
	Resolve fields by original spelling and use declaration order for
	their native ordinals. The record table is a zero-initialized prefix.`)

	(use wove-file "../source/generics.wove"
		(only has_generic_head has_specialization_head function_generic_list read_generic_parameter generic_argument_kind
			read_generic_i32 read_generic_bool hash_generic_word is_checked_constant_operand
			(value checked_type_operand) (value checked_i32_operand) (value checked_bool_operand) (value generic_bool_kind)
			(type GenericConstant)))
	(use wove-file "../source/enum_forms.wove" (only (value enum_declaration) (value variants_list) (value match_case)))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion integer_byte_width is_integer_byte_encoder))
	(use wove-file "../source/c_scope.wove" (only declaring_c_bridge project_bridge))
	(use wove-file "../source/scan.wove" (only is_disabled_form is_metadata_form (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts validate_form_metadata (type SelectedDeclaration)))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_reserved_type_name reference_mode is_builtin_integer is_builtin_float is_builtin_numeric is_builtin_scalar))
	(use wove-file "../source/owned.wove" (only owned_element_node is_byte_owner_descriptor))
	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../emit/names.wove" (only record_identity))
	(use wove-file "./syntax.wove"
		(only entry_at entry_form entry_keyword is_scalar_name same_name scalar_type is_byte_view_type is_fixed_array_type_head
			(type EntryRead) (type FixedArrayShape)))

	(struct
		(:doc `One registered value layout or native type.

		A fixed array has name -1, element type in first, and
		extent in count. Unit and payload enums have native -1 and -2.
		They keep their first variant and count in the same positions
		as a record's fields. A specialization records its original argument
		site and namespace. A repeated site has a non-emitting alias row with name -2.
		An owning array element has a non-emitting row with name -3 and its exact type in first.`)
		ScalarRecord
		(fields (name i32) (file i32) (identity u32) (first i32) (count i32)
			(declaration i32) (native i32) (source_base i32) (emit_row i32) (owns_arrays bool) (borrows_bytes bool)
			(generic i32) (specialization i32) (argument_file i32) (argument_base i32) (alias_of i32)))
	(struct TypeScope (fields (file i32) (source_base i32)))
	(struct SpecializationKey (fields (template i32) (identity u32) (start i32) (end i32) (error u32)))
	(let specialization_domain 1667592307u32)

	(struct ScalarMember (fields (ordinal i32) (row i32)))
	(struct LayoutVisit (fields (row i32) (field i32) (element bool)))
	(struct LayoutCheck (fields (file i32) (start i32) (end i32) (error u32)))

	(fn is_record_type
		(:doc `Recognize value types represented by registered layouts.

		Even an empty record definition uses five tree rows.
		A definition also uses more than eight source bytes. The signed
		graph arena therefore bounds the layout and native alias table below 2^28.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local type) 64u32)
			(u32.lt (local type) 268435456u32)))))

	(fn is_owning_record
		(:doc "Identify named Wove aggregates that own array storage.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool.and (call is_record_type (local type))
				(struct.get (array.load (local records) (call record_index (local type))) owns_arrays)))))

	(fn is_scoped_record
		(:doc "Identify record layouts that carry a shared byte-array loan.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool.and (call is_record_type (local type))
				(struct.get (array.load (local records) (call record_index (local type))) borrows_bytes)))))

	(fn record_type
		(:doc `Encode a checked record row as a type distinct from the built-ins.`)
		(params (row i32))
		(returns u32)
		(body (return (u32.add (u32.from-i32 (local row)) 64u32))))

	(fn is_fixed_array
		(:doc `Distinguish an anonymous fixed array from a named record in the layout table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (i32.eq (struct.get (local layout) name) -1i32))))

	(fn is_enum_layout
		(:doc `Recognize either nominal enum layout in the shared type table.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (bool.or (i32.eq (struct.get (local layout) native) -1i32)
			(i32.eq (struct.get (local layout) native) -2i32)))))

	(fn is_payload_enum
		(:doc `Identify an enum containing at least one payload variant.`)
		(params (layout ScalarRecord))
		(returns bool)
		(body (return (i32.eq (struct.get (local layout) native) -2i32))))

	(fn find_fixed_array_type
		(:doc `Find the one structural type for the exact element and extent.`)
		(params (records (shared-array ScalarRecord)) (shape FixedArrayShape))
		(returns u32)
		(body
			(let element (struct.get (local shape) element))
			(if (bool.or (u32.eqz (local element)) (i32.ltz (struct.get (local shape) extent))) (then (return 0u32)))
			(let-mut index 0i32)
			(while
				(:doc "Only populated fixed layouts can match a structural type.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let layout (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local layout) name)) (then (return 0u32)))
					(if
						(:doc "Both shape components must agree, including a zero extent.")
						(bool.and (call is_fixed_array (local layout))
							(bool.and (i32.eq (struct.get (local layout) first) (i32.from-u32 (local element)))
								(i32.eq (struct.get (local layout) count) (struct.get (local shape) extent))))
						(then (return (call record_type (local index)))))
					(set (local index) (i32.inc (local index)))))
			(return 0u32)))

	(fn array_extent_operand
		(:doc "Keep the final bare extent operand after a checked element row.")
		(params (nodes (shared-array SourceNode)) (element i32)) (returns i32)
		(body
			(let index (struct.get (array.load (local nodes) (local element)) next_sibling))
			(if (i32.ltz (local index)) (then (return -1i32)))
			(let extent (array.load (local nodes) (local index)))
			(if
				(:doc "The full array shape ends with one bare size token.")
				(bool.or (u32.not-eq (struct.get (local extent) kind) 1u32)
					(i32.lt -1i32 (struct.get (local extent) next_sibling)))
				(then (return -1i32)))
			(return (local index))))

	(fn read_array_extent
		(:doc "Read a decimal size or resolve an immutable integer in the current file's value namespace.")
		(params (source (shared-array u8)) (node SourceNode) (bindings (shared-array GraphBinding))
			(file i32) (source_base i32)) (returns i32)
		(body
			(if
				(:doc "A substituted constant carries exact signed i32 bits. Array extents require a clear sign bit.")
				(u8.eq (struct.get (local node) generic_kind) (local checked_i32_operand))
				(then
					(let bits (struct.get (local node) generic_value))
					(if (u32.lt 2147483647u32 (local bits)) (then (return -1i32)))
					(return (i32.from-u32 (local bits)))))
			(if
				(:doc "A type or Boolean parameter cannot fall through to an identically spelled module integer.")
				(bool.or (u8.eq (struct.get (local node) generic_kind) (local checked_type_operand))
					(u8.eq (struct.get (local node) generic_kind) (local checked_bool_operand)))
				(then (return -1i32)))
			(let start (struct.get (local node) start))
			(let end (struct.get (local node) end))
			(if
				(:doc "An identifier may be a local value or a selective import of its defining module.")
				(call is_scalar_name (borrow-shared (local source)) (local node))
				(then
					(let binding (call find_binding (borrow-shared (local source)) (borrow-shared (local source))
						(local start) (local end) (borrow-shared (local bindings)) (array.len (local bindings))
						(local file) (bool false) (local source_base) 2u32))
					(if (i32.ltz (local binding)) (then (return -1i32)))
					(return (struct.get (array.load (local bindings) (local binding)) extent))))
			(let parsed (call read_decimal_digits (borrow-shared (local source)) (local start) (local end) 214748364u32 7u32))
			(if (i32.ltz (struct.get (local parsed) digits)) (then (return -1i32)))
			(return (i32.from-u32 (struct.get (local parsed) magnitude)))))

	(fn named_extent_site
		(:doc "Use the size identifier when an otherwise well-shaped array has an invalid named extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32)) (returns SourceNode)
		(body
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) 70u32 23u32))
			(let element (struct.get (local form) operand))
			(if (i32.ltz (local element)) (then (return (local node))))
			(let index (call array_extent_operand (borrow-shared (local nodes)) (local element)))
			(if (i32.ltz (local index)) (then (return (local node))))
			(let size (array.load (local nodes) (local index)))
			(if
				(:doc "Preserve the whole-type span if the name resolves and another part of the layout is invalid.")
				(bool.and (call is_scalar_name (borrow-shared (local source)) (local size))
					(i32.ltz (call read_array_extent (borrow-shared (local source)) (local size)
						(borrow-shared (local bindings)) (local file) (local source_base))))
				(then (return (local size))))
			(return (local node))))

	(fn record_array_element
		(:doc "Resolve a named Wove record or explicit specialization in the array spelling's type namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (file i32) (source_base i32) (index i32))
		(returns u32)
		(body
			(let name (array.load (local nodes) (local index)))
			(if
				(:doc "A nested structural type or quoted spelling cannot name an element record.")
				(bool.not (bool.or (call is_scalar_name (borrow-shared (local source)) (local name))
					(call has_specialization_head (borrow-shared (local source)) (borrow-shared (local nodes)) (local name))))
				(then (return 0u32)))
			(let type (call value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (local index)))
			(if (bool.not (call is_record_type (local type))) (then (return 0u32)))
			(let record (array.load (local records) (call record_index (local type))))
			(if
				(:doc "Only a copyable Wove struct can supply the nominal element layout.")
				(bool.or (bool.or (struct.get (local record) owns_arrays) (struct.get (local record) borrows_bytes))
					(i32.not-eqz (struct.get (local record) native)))
				(then (return 0u32)))
			(return (local type))))

	(fn read_fixed_array_shape
		(:doc "Read a fixed layout with an exact scalar or named Wove record element and a checked extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(file i32) (source_base i32) (resolve_records bool))
		(returns FixedArrayShape)
		(body
			(let invalid (struct.new FixedArrayShape (element 0u32) (extent -1i32)))
			(if (u32.not-eq (struct.get (local node) kind) 40u32) (then (return (local invalid))))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) 70u32 23u32))
			(let element_node (struct.get (local form) operand))
			(if
				(:doc "Only a complete array type contributes an element and extent.")
				(bool.or (u32.gtz (struct.get (local form) error)) (i32.ltz (local element_node)))
				(then (return (local invalid))))
			(let-mut element (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local element_node)))
			(if
				(:doc "Resolve a named element after the defining record namespace is populated.")
				(bool.and (local resolve_records) (u32.eqz (local element)))
				(then (set (local element) (call record_array_element (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base)
					(local element_node)))))
			(let extent_node (call array_extent_operand (borrow-shared (local nodes)) (local element_node)))
			(if (i32.ltz (local extent_node)) (then (return (local invalid))))
			(let extent (call read_array_extent (borrow-shared (local source)) (array.load (local nodes) (local extent_node))
				(borrow-shared (local bindings)) (local file) (local source_base)))
			(return (struct.new FixedArrayShape (element (local element)) (extent (local extent))))))

	(fn fixed_array_type
		(:doc `Resolve a fixed array spelling against the structural layout table.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (node SourceNode) (bindings (shared-array GraphBinding))
			(file i32) (source_base i32))
		(returns u32)
		(body
			(return (call find_fixed_array_type (borrow-shared (local records))
				(call read_fixed_array_shape (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (bool true))))))

	(fn next_layout_node
		(:doc `Advance through one declaration without following its outer siblings.`)
		(params (nodes (shared-array SourceNode)) (index i32) (declaration i32) (descend bool))
		(returns i32)
		(body
			(let first (struct.get (array.load (local nodes) (local index)) first_child))
			(if
				(:doc "An ordinary nonempty form exposes its first child.")
				(bool.and (local descend) (i32.lt -1i32 (local first)))
				(then (return (local first))))
			(let-mut cursor (local index))
			(while
				(:doc "Find the next sibling or finish when the walk returns to its declaration.")
				(i32.not-eq (local cursor) (local declaration))
				(body
					(let node (array.load (local nodes) (local cursor)))
					(let next (struct.get (local node) next_sibling))
					(if (i32.lt -1i32 (local next)) (then (return (local next))))
					(set (local cursor) (struct.get (local node) parent))))
			(return -1i32)))

	(fn intern_fixed_array
		(:doc `Append a new shape and return the next row, or -1 if the layout table is full.`)
		(params (shape FixedArrayShape) (records (mut-array ScalarRecord)) (next i32))
		(returns i32)
		(body
			(let element (struct.get (local shape) element))
			(if
				(:doc "An invalid shape or an existing type needs no layout row.")
				(bool.or (bool.or (u32.eqz (local element)) (i32.ltz (struct.get (local shape) extent)))
					(u32.gtz (call find_fixed_array_type (borrow-shared (local records)) (local shape))))
				(then (return (local next))))
			(if (i32.eq (local next) (array.len (local records))) (then (return -1i32)))
			(array.store (local records) (local next)
				(struct.new ScalarRecord (name -1i32) (file -1i32)
					(identity (u32.from-i32 (local next))) (first (i32.from-u32 (local element)))
					(count (struct.get (local shape) extent)) (declaration -1i32) (native 0i32)
					(source_base 0i32) (emit_row 0i32) (owns_arrays (bool false)) (borrows_bytes (bool false))
					(generic -1i32) (specialization -1i32) (argument_file -1i32) (argument_base 0i32) (alias_of -1i32)))
			(return (i32.inc (local next)))))

	(fn is_disabled_statement
		(:doc `Distinguish a disabled statement group from a field or parameter with that name.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns bool)
		(body
			(if
				(:doc "Only the disabled form head needs a statement context check.")
				(bool.not (call is_disabled_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
				(then (return (bool false))))
			(let parent (array.load (local nodes) (struct.get (local node) parent)))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parent) first_child)))
			(return (bool.or (u32.eq (local tag) 6u32)
				(bool.or (u32.eq (local tag) (local match_case))
					(bool.or (u32.eq (local tag) 23u32) (u32.eq (local tag) 24u32)))))))

	(fn register_fixed_arrays
		(:doc `Intern array shapes in one selected declaration before its types are checked.

		The body of a function can also infer a layout from an endian encoder.
		Layout discovery skips disabled statements and metadata. Malformed
		types remain for the signature, field, or expression checker to report.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32)
			(records (mut-array ScalarRecord)) (start i32) (bindings (shared-array GraphBinding)) (file i32) (source_base i32)
			(record_elements bool))
		(returns EntryRead)
		(body
			(let-mut index (struct.get (array.load (local nodes) (local declaration)) first_child))
			(let-mut next (local start))
			(let-mut in_body (bool false))
			(while
				(:doc "Visit only descendants of the selected declaration.")
				(i32.lt -1i32 (local index))
				(body
					(let node (array.load (local nodes) (local index)))
					(let head (struct.get (local node) first_child))
					(let ordinary (bool.and
						(bool.and (u32.eq (struct.get (local node) kind) 40u32) (i32.lt -1i32 (local head)))
						(bool.not (bool.or
							(call is_disabled_statement (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))
							(call is_metadata_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node))))))
					(if
						(:doc "Only function bodies can introduce an inferred encoder layout.")
						(i32.eq (struct.get (local node) parent) (local declaration))
						(then (set (local in_body)
							(bool.and (local ordinary) (u32.eq (call entry_keyword (borrow-shared (local source))
								(borrow-shared (local nodes)) (local head)) 6u32)))))
					(if
						(:doc "An ordinary type spelling or encoder can supply a fixed layout.")
						(local ordinary)
						(then
							(let spelling (array.load (local nodes) (local head)))
							(if
								(:doc "An explicit array type supplies its element and extent.")
								(call is_fixed_array_type_head (borrow-shared (local source)) (local spelling))
								(then
									(let shape (call read_fixed_array_shape (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)
										(borrow-shared (local records)) (borrow-shared (local bindings)) (local file) (local source_base) (local record_elements)))
									(let element (struct.get (local shape) element))
									(if
										(:doc "The first pass keeps scalar layout order. The second adds only resolved record elements.")
										(bool.and (u32.gtz (local element))
											(bool.or (bool.not (local record_elements)) (call is_record_type (local element))))
										(then
											(if
												(:doc "A named size that cannot supply a nonnegative integer points at the identifier.")
												(i32.ltz (struct.get (local shape) extent))
												(then
													(let site (call named_extent_site (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)
														(borrow-shared (local bindings)) (local file) (local source_base)))
													(if
														(:doc "Invalid decimal extents keep the whole-type diagnostic.")
														(i32.lt (struct.get (local node) start) (struct.get (local site) start))
														(then (return (call entry_at (local site) -1i32 23u32))))))
											(set (local next) (call intern_fixed_array (local shape) (borrow-mut (local records)) (local next))))))
								(else
									(if
										(:doc "Register inferred encoder layouts with the other scalar arrays.")
										(bool.and (local in_body) (bool.not (local record_elements)))
										(then
											(let op (call read_named_conversion (borrow-shared (local source)) (local spelling)))
											(if
												(:doc "Decode and numerical conversions have scalar results.")
												(call is_integer_byte_encoder (struct.get (local op) kind))
												(then
													(let shape (struct.new FixedArrayShape (element 10u32)
														(extent (call integer_byte_width (struct.get (local op) type)))))
													(set (local next) (call intern_fixed_array (local shape) (borrow-mut (local records)) (local next)))))))))))
					(if
						(:doc "Specializations may have consumed the remaining layout slots before this type was checked.")
						(i32.ltz (local next))
						(then (return (call entry_at (local node) -1i32 16u32))))
					(set (local index) (call next_layout_node (borrow-shared (local nodes)) (local index) (local declaration) (local ordinary)))))
			(return (call entry_at (array.load (local nodes) (local declaration)) (local next) 0u32))))

	(fn record_index
		(:doc `Recover the checked defining row from a named record type.`)
		(params (type u32))
		(returns i32)
		(body (return (i32.from-u32 (u32.sub (local type) 64u32)))))

	(fn native_integer_type
		(:doc `Encode a copyable native integer by its defining type-table row.`)
		(params (row i32))
		(returns u32)
		(body (return (u32.add 268435456u32 (u32.from-i32 (local row))))))

	(fn is_native_integer
		(:doc `Recognize native integer aliases separately from scalar records and pointer owners.`)
		(params (type u32))
		(returns bool)
		(body (return (bool.and (u32.not-lt (local type) 268435456u32)
			(u32.lt (local type) 536870912u32)))))

	(fn native_integer_index
		(:doc `Recover the defining row from a checked native integer type.`)
		(params (type u32))
		(returns i32)
		(body (return (i32.from-u32 (u32.sub (local type) 268435456u32)))))

	(fn find_native_definition
		(:doc `Find one exact defining native declaration in the populated type table.`)
		(params (records (shared-array ScalarRecord)) (file i32) (declaration i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Both native aliases and record views carry their defining C literal.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let row (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local row) name)) (then (return -1i32)))
					(if
						(:doc "Names and ABI spelling can coincide without sharing Wove identity.")
						(bool.and (i32.gtz (struct.get (local row) native))
							(bool.and (i32.eq (struct.get (local row) file) (local file))
								(i32.eq (struct.get (local row) declaration) (local declaration))))
						(then (return (local index))))
					(set (local index) (i32.inc (local index)))))
			(return -1i32)))

	(fn find_native_node
		(:doc "Resolve a defining native name by its unique node in the flattened graph.")
		(params (records (shared-array ScalarRecord)) (name i32)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The defining name node is independent of its provider's local import aliases.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let row (array.load (local records) (local index)))
					(let candidate (struct.get (local row) name))
					(if (i32.eqz (local candidate)) (then (return -1i32)))
					(if
