				layout/identity (bool true)))))

	(fn same_specialization_arguments
		(:doc "Compare checked types, constant bits, variant rows, and operation declarations across application namespaces.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
