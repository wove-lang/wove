	(fn read_specialization_arguments
		(:doc "Validate each exact argument kind and derive a deterministic identity from the defining declaration.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (use i32) (enclosing i32)
			(template i32) (parameters i32) (definition_scope TypeScope) (definition u32) (record_arguments bool)) (returns SpecializationKey)
		(body
