						(then (return (bool false))))
					(set (local left) (struct.get (array.load (local nodes) (local left)) next_sibling))
					(set (local right) (struct.get (array.load (local nodes) (local right)) next_sibling))
					(set (local formal) (struct.get (local parameter) next_sibling))))
			(return (bool true))))

	(fn find_specialization
		(:doc "Find a checked concrete record with the same defining template and normalized arguments.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (use i32) (key SpecializationKey)) (returns i32)
		(body
			(let template (array.load (local records) (struct.get (local key) template)))
			(let-mut row 0i32)
			(while
				(:doc "Only the populated prefix can contain a competing nominal identity.")
				(i32.lt (local row) (array.len (local records)))
