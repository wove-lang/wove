		(returns ScalarRecord)
		(body
			(return (struct.new ScalarRecord (c_name_slot (struct.get (local entry) c_name_slot)) (name (struct.get (local entry) name)) (file (struct.get (local entry) file))
				(identity (struct.get (local entry) identity)) (first (struct.get (local entry) first))
				(count (struct.get (local entry) count)) (declaration (struct.get (local entry) declaration))
				(native (struct.get (local entry) native)) (source_base (struct.get (local entry) source_base))
				(emit_row (local emitted)) (owns_arrays (local owns)) (borrows_bytes (struct.get (local entry) borrows_bytes))
				(generic (struct.get (local entry) generic)) (specialization (struct.get (local entry) specialization))
				(argument_file (struct.get (local entry) argument_file)) (argument_base (struct.get (local entry) argument_base)) (alias_of (struct.get (local entry) alias_of))))))

	(fn publish_layout
		(:doc "Record which defining layout is emitted at this position while retaining all type identities.")
		(params (records (mut-array ScalarRecord)) (position i32) (row i32))
		(returns void)
		(body
			(let entry (array.load (local records) (local position)))
			(array.store (local records) (local position)
				(call layout_state (local entry) (local row) (struct.get (local entry) owns_arrays)))))

	(fn is_record_array_field
		(:doc "Identify a struct field stored as a heap array descriptor.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (layout ScalarRecord) (member SourceNode))
		(returns bool)
		(body (return (bool.and
			(bool.and (i32.eqz (struct.get (local layout) native)) (struct.get (local layout) owns_arrays))
			(call is_owned_array_field (borrow-shared (local source)) (borrow-shared (local nodes)) (local member))))))

	(fn validate_record_array_fields
		(:doc "Check each array field after leaf layouts and exact nested owner identities are available.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (count i32))
		(returns LayoutCheck)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Array field validation applies to every defining owning struct, even an unused one.")
				(i32.lt (local row) (local count))
				(body
					(let layout (array.load (local records) (local row)))
					(if
						(:doc "Only ordinary Wove structs have named owning fields to validate.")
						(bool.and (i32.gtz (struct.get (local layout) name))
							(bool.and (i32.eqz (struct.get (local layout) native)) (struct.get (local layout) owns_arrays)))
						(then
							(let-mut field (struct.get (local layout) first))
							(while
								(:doc "An invalid field type reports the field in its defining file.")
								(i32.not-ltz (local field))
								(body
									(let member (array.load (local nodes) (local field)))
									(if
										(:doc "Require the exact owner type, including every nested row.")
										(bool.and (call is_owned_array_field (borrow-shared (local source)) (borrow-shared (local nodes)) (local member))
											(bool.not (call is_array_owner (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
												(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))))
										(then (return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
											(local layout) (local member) 23u32))))
									(set (local field) (struct.get (local member) next_sibling))))))
					(set (local row) (i32.inc (local row)))))
			(return (struct.new LayoutCheck (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn finish_layout_ownership
		(:doc "Classify owning members after their layout dependencies are complete.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(records (mut-array ScalarRecord)) (row i32))
		(returns LayoutCheck)
		(body
			(let layout (array.load (local records) (local row)))
			(let ok (struct.new LayoutCheck (file -1i32) (start 0i32) (end 0i32) (error 0u32)))
			(if
				(:doc "An inline array owns its element exactly when the complete element type owns storage.")
				(call is_fixed_array (local layout))
				(then
					(let element (u32.from-i32 (struct.get (local layout) first)))
					(let owns (bool.or (call is_array_owner (local element))
						(call is_owning_record (borrow-shared (local records)) (local element))))
					(array.store (local records) (local row) (call layout_state (local layout) (struct.get (local layout) emit_row) (local owns)))
					(return (local ok))))
			(if
				(:doc "Only ordinary Wove records and payload enums have typed value members.")
				(bool.or (bool.or (call is_owned_row_layout (local layout))
						(bool.or (call is_generic_template (local layout)) (call is_specialization_alias (local layout))))
					(bool.not (bool.or (i32.eqz (struct.get (local layout) native)) (call is_payload_enum (local layout)))))
				(then (return (local ok))))
			(let-mut owns (struct.get (local layout) owns_arrays))
			(let-mut field (struct.get (local layout) first))
			(while
				(:doc "Ownership of an inline dependency is known when the parent finishes.")
				(i32.lt -1i32 (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(if
						(:doc "Struct array descriptors are already marked owning and validated after row interning.")
						(bool.not (call is_record_array_field (borrow-shared (local source)) (borrow-shared (local nodes))
							(local layout) (local member)))
						(then
							(let type (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
							(if
								(:doc "An owning enum cannot be copied into a record or inline array member.")
								(u32.eqz (local type))
								(then
									(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
									(if (i32.lt -1i32 (struct.get (local parts) operands))
										(then (return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
											(local layout) (local member) 23u32))))))
							(if
								(:doc "Any owning member gives the enclosing aggregate lexical cleanup.")
								(bool.or (call is_native_owner (local type))
									(bool.or (call is_array_owner (local type))
										(call is_owning_record (borrow-shared (local records)) (local type))))
								(then (set (local owns) (bool true))))))
					(set (local field) (struct.get (local member) next_sibling))))
			(array.store (local records) (local row)
				(call layout_state (local layout) (struct.get (local layout) emit_row) (local owns)))
			(return (local ok))))

	(fn walk_record_layouts
		(:doc `Validate fields and order each complete value layout after its dependencies.

		Traverse roots in table order. An explicit stack keeps source depth
		out of the host stack. Fields and array elements both participate in by-value cycles.
		The field that introduces the recursive dependency supplies its span.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (count i32)
			(marks (mut-array u8)) (stack (mut-array LayoutVisit)))
		(returns LayoutCheck)
		(body
			(let ok (struct.new LayoutCheck (file -1i32) (start 0i32) (end 0i32) (error 0u32)))
			(let-mut root 0i32)
			(let-mut written 0i32)
			(while
				(:doc "Visit each root once, preserving source order among independent layouts.")
				(i32.lt (local root) (local count))
				(body
					(let-mut depth -1i32)
					(if
						(:doc "A completed dependency already has an emission position.")
						(u8.eqz (array.load (local marks) (local root)))
						(then
							(set (local depth) 0i32)
							(call enter_layout (local root) (array.load (local records) (local root)) (local depth) -1i32
								(borrow-mut (local marks)) (borrow-mut (local stack)))))
					(while
						(:doc "Finish a layout once every field's defining layout has been emitted.")
						(i32.lt -1i32 (local depth))
						(body
							(let visit (array.load (local stack) (local depth)))
							(let row (struct.get (local visit) row))
							(let field (struct.get (local visit) field))
							(let element (struct.get (local visit) element))
							(if
								(:doc "Postorder publishes the original row after its dependencies.")
								(bool.and (bool.not (local element)) (i32.ltz (local field)))
								(then
									(let ownership (call finish_layout_ownership (borrow-shared (local source)) (borrow-shared (local nodes))
										(borrow-shared (local bindings)) (borrow-mut (local records)) (local row)))
									(if (u32.gtz (struct.get (local ownership) error)) (then (return (local ownership))))
									(call publish_layout (borrow-mut (local records)) (local written) (local row))
									(array.store (local marks) (local row) 2u8)
									(set (local written) (i32.inc (local written)))
									(set (local depth) (i32.dec (local depth))))
								(else
									(let layout (array.load (local records) (local row)))
									(let-mut type 0u32)
									(let-mut next -1i32)
									(if
										(:doc "A fixed wrapper has one dependency even when its extent is zero.")
										(local element)
										(then (set (local type) (u32.from-i32 (struct.get (local layout) first))))
										(else
											(let member (array.load (local nodes) (local field)))
											(if
												(:doc "A heap array descriptor has no by-value layout dependency.")
												(bool.not (call is_record_array_field (borrow-shared (local source)) (borrow-shared (local nodes))
													(local layout) (local member)))
												(then
													(set (local type) (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
														(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
													(if
														(:doc "A unit variant can omit its type. Other members require a supported value type.")
														(u32.eqz (local type))
														(then
															(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local member)))
															(if
																(:doc "Missing operands were allowed only for unit variants.")
																(i32.lt -1i32 (struct.get (local parts) operands))
																(then (return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
																	(local layout) (local member) 23u32))))))))
											(set (local next) (struct.get (local member) next_sibling))))
									(array.store (local stack) (local depth)
										(struct.new LayoutVisit (row (local row)) (field (local next)) (element (bool false))))
									(if
										(:doc "Only a by-value aggregate field needs a separate layout.")
										(call is_record_type (local type))
										(then
											(let child (call record_index (local type)))
											(let mark (array.load (local marks) (local child)))
											(if
												(:doc "A visiting child closes a cycle through inline storage.")
												(u8.eq (local mark) 1u8)
												(then
													(let member (array.load (local nodes) (local field)))
													(if
														(:doc "A recursive array element reports the containing field that led to the wrapper.")
														(local element)
														(then
															(let-mut parent_depth (i32.dec (local depth)))
															(let-mut parent (struct.get (array.load (local stack) (local parent_depth)) row))
															(while
																(:doc "Synthetic wrappers carry the same field from the nearest named parent.")
																(bool.and (i32.gtz (local parent_depth)) (call is_fixed_array (array.load (local records) (local parent))))
																(body
																	(set (local parent_depth) (i32.dec (local parent_depth)))
																	(set (local parent) (struct.get (array.load (local stack) (local parent_depth)) row))))
															(return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
																(array.load (local records) (local parent)) (local member) 23u32))))
													(return (call layout_error (borrow-shared (local source)) (borrow-shared (local nodes))
														(local layout) (local member) 23u32))))
											(if
												(:doc "Revisit this layout after ordering the unvisited child.")
												(u8.eqz (local mark))
												(then
													(set (local depth) (i32.inc (local depth)))
													(call enter_layout (local child) (array.load (local records) (local child)) (local depth) (local field)
														(borrow-mut (local marks)) (borrow-mut (local stack)))))))))))
					(set (local root) (i32.inc (local root)))))
			(return (local ok))))

	(fn order_record_layouts
		(:doc `Allocate one traversal slot and mark per complete registered layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)) (count i32))
		(returns LayoutCheck)
		(body
			(if
				(:doc "Scalar-only modules have no layout work or scratch allocation.")
				(i32.eqz (local count))
				(then (return (struct.new LayoutCheck (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))
			(let-mut marks (array.alloc u8 (local count)))
			(let-mut stack (array.alloc LayoutVisit (local count)))
			(return (call walk_record_layouts (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local bindings)) (borrow-mut (local records)) (local count)
				(borrow-mut (local marks)) (borrow-mut (local stack)))))))
