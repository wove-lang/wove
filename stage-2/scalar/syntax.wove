(module scalar_syntax
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the source syntax for scalar C emission.

	Use the original tree links and source spans for signature and expression
	checks. Normalize literal spellings before lowering them to C.`)

	(use wove-file "./flow.wove" (only is_loop_exit (value break_statement) (value continue_statement) (value for_statement)))
	(use wove-file "../source/array_growth.wove" (only array_growth_keyword is_array_growth_statement))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion))
	(use wove-file "../source/integer_checks.wove" (only read_integer_check))
	(use wove-file "../source/integer_compare.wove" (only integer_comparison_keyword is_integer_comparison
		comparison_operand_type comparison_is_zero comparison_symbol))
	(use wove-file "../source/integer_ops.wove" (only read_integer_operator integer_operator))
	(use wove-file "../source/float_ops.wove" (only float_operator_keyword is_float_operator float_operator_type
		float_operator_slot float_operator_symbol))
	(use wove-file "../source/enum_forms.wove" (only enum_keyword (value match_statement)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../source/scan.wove" (only is_identifier_head (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata))
	(use wove-file "../source/types.wove" (only builtin_type_keyword is_builtin_scalar))

	(struct EntryRead (fields (operand i32) (start i32) (end i32) (error u32) (related i32)))
	(struct StatementRead (fields (kind u32) (binding i32) (value i32) (start i32) (end i32) (error u32)))
	(struct ScalarOperator (fields (operand u32) (result u32) (symbol u8) (arity i32) (short_circuit bool)))
	(struct FixedArrayShape (fields (element u32) (extent i32)))

	(let for_head "for")
	(let bind_head "bind")
	(let range_head "range")
	(let for_bind 150u32)
	(let for_range 151u32)
	(let break_head "break")
	(let continue_head "continue")
	(let array_type_head "array")
	(let array_new_head "array.new")
	(let array_repeat_head "array.repeat")
	(let array_len_head "array.len")
	(let array_range_head "array.range")
	(let array_load_head "array.load")
	(let array_store_head "array.store")
	(let i32_div_head "i32.div")
	(let i32_rem_head "i32.rem")
	(let wide_add_head "u64.add")
	(let u32_add_wrapping 174u32)
	(let u32_sub_wrapping 175u32)

	(fn keyword_matches
		(:doc `Compare a checked atom to an immutable keyword spelling.`)
		(params (source (shared-array u8)) (start i32) (end i32) (keyword (shared-array u8)))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared (local source)) (local start) (local end)
				(borrow-shared (local keyword)) 0i32 (array.len (local keyword))))))

	(fn array_keyword
		(:doc `Recognize the array type and operation heads at their full widths.`)
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Check the keyword width before advancing to the prefix end.")
				(i32.lt (i32.sub (local end) (local start)) 5i32)
				(then (return 0u32)))
			(let prefix_end (i32.add (local start) 5i32))
			(if
				(:doc "Other keywords need no comparison against the array forms.")
				(bool.not (call keyword_matches (borrow-shared (local source)) (local start) (local prefix_end)
					(borrow-shared (local array_type_head))))
				(then (return 0u32)))
			(if (i32.eq (local end) (local prefix_end)) (then (return 70u32)))
			(if
				(:doc "A typed list initializes one element per operand.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_new_head)))
				(then (return 71u32)))
			(if
				(:doc "A repeat initializer supplies one value for the declared extent.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_repeat_head)))
				(then (return 72u32)))
			(if
				(:doc "A load reads a checked element by value.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_load_head)))
				(then (return 37u32)))
			(if
				(:doc "A store writes an element in a writable local.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_store_head)))
				(then (return 40u32)))
			(if
				(:doc "Length reads the element count from a checked array receiver.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_len_head)))
				(then (return 36u32)))
			(if
				(:doc "A range lends part of the original storage within a borrow.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_range_head)))
				(then (return 44u32)))
			(return (call array_growth_keyword (borrow-shared (local source)) (local start) (local end)))))

	(fn is_fixed_array_type_head
		(:doc `Check whether a source atom introduces a structural array layout.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(call keyword_matches (borrow-shared (local source)) (struct.get (local node) start)
					(struct.get (local node) end) (borrow-shared (local array_type_head)))))))

	(fn is_fixed_initializer
		(:doc `Identify either typed fixed-array initializer.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) 71u32) (u32.eq (local kind) 72u32)))))

	(fn is_fixed_access
		(:doc `Identify a checked fixed-array index operation.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) 73u32) (u32.eq (local kind) 74u32)))))

	(fn is_scalar_name
		(:doc `Check that the source operand names an unquoted Wove identifier.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(call is_identifier_head (borrow-shared (local source))
					(struct.get (local node) start) (struct.get (local node) end))))))

	(fn same_name
		(:doc `Compare the original spellings of two checked identifier nodes.`)
		(params (source (shared-array u8)) (left SourceNode) (right SourceNode))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared (local source)) (struct.get (local left) start)
				(struct.get (local left) end) (borrow-shared (local source)) (struct.get (local right) start)
				(struct.get (local right) end)))))

	(fn wrapping_keyword
		(:doc `Read the operation code from a complete signed or unsigned wrapping keyword.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "The wide word supports wrapping addition.")
				(call keyword_matches (borrow-shared (local source)) (local start)
					(i32.add (local start) (local width)) (borrow-shared (local wide_add_head)))
				(then (return 86u32)))
			(if
				(:doc "Match the complete seven-byte word arithmetic head and its fixed type separator.")
				(bool.or (bool.not (i32.eq (local width) 7i32))
					(bool.not (call is_three_bytes (borrow-shared (local source))
						(i32.add (local start) 1i32) 51u8 50u8 46u8)))
				(then (return 0u32)))
			(let prefix (array.load (local source) (local start)))
			(let unsigned (u8.eq (local prefix) 117u8))
			(if
				(:doc "The leading letter selects signed or unsigned arithmetic.")
				(bool.not (bool.or (local unsigned) (u8.eq (local prefix) 105u8)))
				(then (return 0u32)))
			(let-mut addition 20u32)
			(if
				(:doc "The unsigned addition and subtraction codes form their own consecutive pair.")
				(local unsigned)
				(then (set (local addition) (local u32_add_wrapping))))
			(let mnemonic (i32.add (local start) 4i32))
			(if
				(:doc "Recognize add at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 97u8 100u8 100u8)
				(then (return (local addition))))
			(if
				(:doc "The subtraction code follows the matching addition code.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 115u8 117u8 98u8)
				(then (return (u32.add (local addition) 1u32))))
			(if
				(:doc "This slice adds wrapping multiplication for signed words.")
				(bool.and (bool.not (local unsigned))
					(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 109u8 117u8 108u8))
				(then (return 75u32)))
			(return 0u32)))

	(fn is_i32_division
		(:doc `Identify the two checked signed division operations.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) 76u32) (u32.eq (local kind) 77u32)))))

	(fn logical_keyword
		(:doc `Recognize the three exact bool operator spellings.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Only a full bool prefix and supported suffix width can make an operator.")
				(bool.or
					(bool.not (bool.or (i32.eq (local width) 7i32) (i32.eq (local width) 8i32)))
					(bool.not
						(bool.and
							(call is_three_bytes (borrow-shared (local source)) (local start) 98u8 111u8 111u8)
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 4i32 46u8)))))
				(then (return 0u32)))
			(let mnemonic (i32.add (local start) 5i32))
			(if
				(:doc "The two-byte suffix is or.")
				(i32.eq (local width) 7i32)
				(then
					(if
						(:doc "Match both bytes of the or suffix.")
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local mnemonic) 0i32 111u8)
							(call is_head_byte (borrow-shared (local source)) (local mnemonic) 1i32 114u8))
						(then (return 31u32)))
					(return 0u32)))
			(if
				(:doc "Match and at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 97u8 110u8 100u8)
				(then (return 30u32)))
			(if
				(:doc "Match not at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) 110u8 111u8 116u8)
				(then (return 32u32)))
			(return 0u32)))

	(let i32_and_kind 152u32)
	(let i32_or_kind 153u32)
	(let i32_shl_kind 154u32)
	(let i32_shr_kind 155u32)
	(let u64_rotr_kind 253u32)
	(let u64_rotr_head "u64.rotr")

	(fn word_bit_keyword
		(:doc `Recognize exact bitwise, shift, and rotate operators for the supported word types.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Match the complete u64 rotate-right spelling.")
				(bool.and (i32.eq (local width) 8i32)
					(call keyword_matches (borrow-shared (local source)) (local start)
						(i32.add (local start) (local width)) (borrow-shared (local u64_rotr_head))))
				(then (return (local u64_rotr_kind))))
			(if
				(:doc "Check the exact operator width and separating dot.")
				(bool.not (bool.and (bool.or (i32.eq (local width) 6i32) (i32.eq (local width) 7i32))
					(call is_head_byte (borrow-shared (local source)) (local start) 3i32 46u8)))
				(then (return 0u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) 3i32))
			(let wide (u32.eq (local type) 54u32))
			(let signed (u32.eq (local type) 5u32))
			(if
				(:doc "Only the supported word types use these suffixes.")
				(bool.not (bool.or (local signed) (bool.or (u32.eq (local type) 11u32) (local wide))))
				(then (return 0u32)))
			(let-mut base 66u32)
			(let-mut xor_kind 91u32)
			(if
				(:doc "The wide word uses its own operation codes for the same suffixes.")
				(local wide)
				(then
					(set (local base) 87u32)
					(set (local xor_kind) 93u32)))
			(if (local signed) (then (set (local base) (local i32_and_kind))))
			(let suffix (i32.add (local start) 4i32))
			(if
				(:doc "Only or has a two-byte suffix.")
				(i32.eq (local width) 6i32)
				(then
					(if
						(:doc "Read both bytes of the or suffix.")
						(bool.and (call is_head_byte (borrow-shared (local source)) (local suffix) 0i32 111u8)
							(call is_head_byte (borrow-shared (local source)) (local suffix) 1i32 114u8))
						(then (return (u32.add (local base) 1u32))))
					(return 0u32)))
			(if
				(:doc "Match and at its full width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 97u8 110u8 100u8)
				(then (return (local base))))
			(if
				(:doc "Match shl at its full width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 115u8 104u8 108u8)
				(then (return (u32.add (local base) 2u32))))
			(if
				(:doc "Match shr at its full width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 115u8 104u8 114u8)
				(then (return (u32.add (local base) 3u32))))
			(if
				(:doc "XOR and complement are currently available for unsigned words.")
				(local signed)
				(then (return 0u32)))
			(if
				(:doc "Match xor at its complete width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 120u8 111u8 114u8)
				(then (return (local xor_kind))))
			(if
				(:doc "Match the word complement suffix.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 110u8 111u8 116u8)
				(then (return (u32.add (local xor_kind) 1u32))))
			(return 0u32)))

	(fn word_count_type
		(:doc `Return the word type of a checked shift or rotate.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns u32)
		(body
			(if
				(:doc "These shifts keep the original u32 width.")
				(bool.or (u32.eq (local kind) 68u32) (u32.eq (local kind) 69u32))
				(then (return 11u32)))
			(if
				(:doc "Unsigned wide shifts and rotate preserve the full u64 word.")
				(bool.or (u32.eq (local kind) (local u64_rotr_kind))
					(bool.or (u32.eq (local kind) 89u32) (u32.eq (local kind) 90u32)))
				(then (return 54u32)))
			(if
				(:doc "Both signed shifts produce an exact i32 word.")
				(bool.or (u32.eq (local kind) (local i32_shl_kind)) (u32.eq (local kind) (local i32_shr_kind)))
				(then (return 5u32)))
			(return 0u32)))

	(fn mask_operator
		(:doc `Describe the C spelling and exact type of a bitwise mask or complement.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(let-mut symbol 0u8)
			(let-mut arity 2i32)
			(if
				(:doc "AND retains bits set in both words.")
				(bool.or (u32.eq (local kind) (local i32_and_kind))
					(bool.or (u32.eq (local kind) 66u32) (u32.eq (local kind) 87u32)))
				(then (set (local symbol) 38u8)))
			(if
				(:doc "OR retains bits set in either word.")
				(bool.or (u32.eq (local kind) (local i32_or_kind))
					(bool.or (u32.eq (local kind) 67u32) (u32.eq (local kind) 88u32)))
				(then (set (local symbol) 124u8)))
			(if
				(:doc "XOR retains bits that differ between the words.")
				(bool.or (u32.eq (local kind) 91u32) (u32.eq (local kind) 93u32))
				(then (set (local symbol) 94u8)))
			(if
				(:doc "Complement takes just one word.")
				(bool.or (u32.eq (local kind) 92u32) (u32.eq (local kind) 94u32))
				(then
					(set (local symbol) 126u8)
					(set (local arity) 1i32)))
			(let-mut type 0u32)
			(if
				(:doc "Only recognized masks and complements contribute a result.")
				(u8.lt 0u8 (local symbol))
				(then
					(set (local type) 11u32)
					(if
						(:doc "Signed masks take and return an exact i32.")
						(bool.or (u32.eq (local kind) (local i32_and_kind)) (u32.eq (local kind) (local i32_or_kind)))
						(then (set (local type) 5u32)))
					(if
						(:doc "These four masks have exact u64 operands.")
						(bool.or (bool.or (u32.eq (local kind) 87u32) (u32.eq (local kind) 88u32))
							(bool.or (u32.eq (local kind) 93u32) (u32.eq (local kind) 94u32)))
						(then (set (local type) 54u32)))))
			(return (struct.new ScalarOperator (operand (local type)) (result (local type))
				(symbol (local symbol)) (arity (local arity)) (short_circuit (bool false))))))

	(fn floating_operator
		(:doc `Describe the arity and result of a checked floating operator.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(let type (call float_operator_type (local kind)))
			(let slot (call float_operator_slot (local kind)))
			(let-mut result (local type))
			(let-mut arity 2i32)
			(if (i32.eq (local slot) 4i32) (then (set (local arity) 1i32)))
			(if (i32.lt 4i32 (local slot)) (then (set (local result) 12u32)))
			(return (struct.new ScalarOperator (operand (local type)) (result (local result))
				(symbol (call float_operator_symbol (local slot))) (arity (local arity))
				(short_circuit (bool false))))))

	(fn scalar_operator
		(:doc `Describe an operator's arity, operand and result types, and meaning in C.

		The operand field applies to every operand. A zero result marks a
		non-operator. The C writer expands the multi-byte comparison markers. Short-circuit operators
		use an explicit branch around the right operand's evaluation.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(if
				(:doc "Float operators use the same eager operand planning as integer operators.")
				(call is_float_operator (local kind))
				(then (return (call floating_operator (local kind)))))
			(if
				(:doc "Integer comparisons share eager checking for their one or two written operands.")
				(call is_integer_comparison (local kind))
				(then
					(let-mut arity 2i32)
					(if (call comparison_is_zero (local kind)) (then (set (local arity) 1i32)))
					(return (struct.new ScalarOperator (operand (call comparison_operand_type (local kind))) (result 12u32)
						(symbol (call comparison_symbol (local kind))) (arity (local arity)) (short_circuit (bool false))))))
			(let multiply (u32.eq (local kind) 75u32))
			(let signed (bool.or (local multiply) (bool.or (u32.eq (local kind) 20u32) (u32.eq (local kind) 21u32))))
			(let unsigned (bool.or (u32.eq (local kind) (local u32_add_wrapping)) (u32.eq (local kind) (local u32_sub_wrapping))))
			(if
				(:doc "Wrapping arithmetic uses the same exact type for both operands and the result.")
				(bool.or (local signed) (local unsigned))
				(then
					(let-mut type 5u32)
					(if
						(:doc "Unsigned operations keep the u32 type.")
						(local unsigned)
						(then (set (local type) 11u32)))
					(let-mut symbol 43u8)
					(if
						(:doc "Both subtraction kinds use the minus operator.")
						(bool.or (u32.eq (local kind) 21u32) (u32.eq (local kind) (local u32_sub_wrapping)))
						(then (set (local symbol) 45u8)))
					(if
						(:doc "Wrapping multiplication uses the product of the widened operands.")
						(local multiply)
						(then (set (local symbol) 42u8)))
					(return (struct.new ScalarOperator (operand (local type)) (result (local type))
						(symbol (local symbol)) (arity 2i32) (short_circuit (bool false))))))
			(if
				(:doc "Unsigned wide addition wraps in its exact result type.")
				(u32.eq (local kind) 86u32)
				(then (return (struct.new ScalarOperator (operand 54u32) (result 54u32)
					(symbol 43u8) (arity 2i32) (short_circuit (bool false))))))
			(if
				(:doc "Both division operations take two exact signed operands and use a checked runtime call.")
				(call is_i32_division (local kind))
				(then (return (struct.new ScalarOperator (operand 5u32) (result 5u32)
					(symbol 0u8) (arity 2i32) (short_circuit (bool false))))))
			(let mask (call mask_operator (local kind)))
			(if
				(:doc "Bitwise operations preserve their exact operand type.")
				(u32.lt 0u32 (struct.get (local mask) result))
				(then (return (local mask))))
			(if
				(:doc "A conjunction guards the right operand with the left value.")
				(u32.eq (local kind) 30u32)
				(then (return (struct.new ScalarOperator (operand 12u32) (result 12u32) (symbol 38u8)
					(arity 2i32) (short_circuit (bool true))))))
			(if
				(:doc "A disjunction guards the right operand with the negated left value.")
				(u32.eq (local kind) 31u32)
				(then (return (struct.new ScalarOperator (operand 12u32) (result 12u32) (symbol 124u8)
					(arity 2i32) (short_circuit (bool true))))))
			(if
				(:doc "Negation uses one boolean operand.")
				(u32.eq (local kind) 32u32)
				(then (return (struct.new ScalarOperator (operand 12u32) (result 12u32) (symbol 33u8)
					(arity 1i32) (short_circuit (bool false))))))
			(let integer (call integer_operator (local kind)))
			(if
				(:doc "Each width-specific form accepts two operands of the same exact integer type.")
				(u32.lt 0u32 (struct.get (local integer) result))
				(then (return (struct.new ScalarOperator (operand (struct.get (local integer) operand))
					(result (struct.get (local integer) result)) (symbol (struct.get (local integer) symbol))
					(arity 2i32) (short_circuit (bool false))))))
			(return (struct.new ScalarOperator (operand 0u32) (result 0u32) (symbol 0u8) (arity 0i32) (short_circuit (bool false))))))

	(fn borrow_keyword
		(:doc `Read the explicit borrow keywords at their full widths.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Check both explicit reborrows after their common borrow- prefix.")
				(bool.and (bool.or (i32.eq (local width) 10i32) (i32.eq (local width) 13i32))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 98u8 111u8 114u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 3i32) 114u8 111u8 119u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 45u8))))
				(then
					(let suffix (i32.add (local start) 7i32))
					(if
						(:doc "The exclusive loan ends in mut.")
						(bool.and (i32.eq (local width) 10i32)
							(call is_three_bytes (borrow-shared (local source)) (local suffix) 109u8 117u8 116u8))
						(then (return 39u32)))
					(if
						(:doc "The shared loan ends in shared.")
						(bool.and (i32.eq (local width) 13i32)
							(bool.and
								(call is_three_bytes (borrow-shared (local source)) (local suffix) 115u8 104u8 97u8)
								(call is_three_bytes (borrow-shared (local source))
									(i32.add (local suffix) 3i32) 114u8 101u8 100u8)))
						(then (return 35u32)))))
			(return 0u32)))

	(fn is_byte_view_type
		(:doc `Check the two parameter type codes that carry a byte view.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local type) 34u32) (u32.eq (local type) 38u32)))))

	(fn is_reborrow_keyword
		(:doc `Check the two explicit whole-view call loan codes.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local kind) 35u32) (u32.eq (local kind) 39u32)))))

	(fn record_keyword
		(:doc `Recognize record declarations, field lists, construction, and lookup.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Declaration and field-list keywords each have two groups of three bytes.")
				(i32.eq (local width) 6i32)
				(then
					(let suffix (i32.add (local start) 3i32))
					(if
						(:doc "Match the struct keyword.")
						(bool.and
							(call is_three_bytes (borrow-shared (local source)) (local start) 115u8 116u8 114u8)
							(call is_three_bytes (borrow-shared (local source)) (local suffix) 117u8 99u8 116u8))
						(then (return 48u32)))
					(if
						(:doc "Match the fields keyword.")
						(bool.and
							(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 105u8 101u8)
							(call is_three_bytes (borrow-shared (local source)) (local suffix) 108u8 100u8 115u8))
						(then (return 49u32)))
					(return 0u32)))
			(if
				(:doc "Both field operations require the seven-byte struct. prefix and a three-byte suffix.")
				(bool.or
					(bool.not (i32.eq (local width) 10i32))
					(bool.not (bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 115u8 116u8 114u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source)) (i32.add (local start) 3i32) 117u8 99u8 116u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 46u8)))))
				(then (return 0u32)))
			(let suffix (i32.add (local start) 7i32))
			(if
				(:doc "Match new for construction in source field order.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 110u8 101u8 119u8)
				(then (return 50u32)))
			(if
				(:doc "Match get for a field value or place.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) 103u8 101u8 116u8)
				(then (return 52u32)))
			(return 0u32)))

	(let owner_is_null_keyword "owner.is-null")
	(let optional_unwrap_keyword "optional.unwrap")
	(let native_alloc_keyword "native.alloc")
	(let native_empty_keyword "native.empty")

	(fn native_alloc_kind
		(:doc `Identify a checked allocation of an inactive native storage owner.`)
		(params)
		(returns u32)
		(body (return 103u32)))

	(fn native_empty_kind
		(:doc "Identify a fresh opaque handle owner with a null pointer.")
		(params) (returns u32)
		(body (return 198u32)))

	(fn is_native_owner_constructor
		(:doc "Check for either constructor that introduces a fresh native owner.")
		(params (kind u32)) (returns bool)
		(body (return (bool.or (u32.eq (local kind) (call native_alloc_kind))
			(u32.eq (local kind) (call native_empty_kind))))))

	(fn entry_keyword
		(:doc `Recognize the exact keywords of the scalar entry grammar.

		Return 1 through 9 for fn, main, params, returns, i32, body, return,
		local, and call. Return 10 through 14 for u8, u32, bool, true, and
		false. Return 15 through 17 for let, let-mut, and set. The i64 type uses 18.
		Return 20 and 21 for i32.add and i32.sub.
		Return 22 through 25 for if, then, else, and while. Return 30 through 32 for
		bool.and, bool.or, and bool.not, and 33 for int.convert. Return
		34 through 37 for shared-array, borrow-shared, array.len, and
		array.load. Return 38 through 40 for mut-array, borrow-mut, and
		array.store, and 41 for array.alloc. The move and array.range
		keywords use 43 and 44. The i16 and u16 types use 46 and 47.
		The u32 wrapping operations use 174 and 175. Struct, fields, struct.new, and struct.get use
		48, 49, 50, and 52. Void uses 59, embed uses 60, and i8 uses 61.
		Return 66 through 69 for u32.and,
		u32.or, u32.shl, and u32.shr.
		Fixed-array types, lists, and repeats use 70 through 72. The planner
		uses 73 and 74 for loads and stores resolved to fixed storage.
		i32.mul, i32.div, and i32.rem use 75 through 77. The u64 type uses 54.
		Code 86 selects u64 wrapping addition.
		87 through 90 select u64 masks and shifts, and 91 through 94 select u32 and u64 XOR and complement.
		An owner null predicate uses 98, optional unwrap uses 101, native.alloc uses 103, and native.empty uses 198.
		Integer byte conversions use 108 through 111, and typed checked conversions use 112.
		Enum and match forms use 113 through 117. Break and continue use 144 and 145.
		Signed i32 masks and shifts use 152 through 155.
		The 16-bit wrapping operators use 182, 183, 186, and 187.
		Recoverable integer checks use 188 through 193.
		i64 wrapping arithmetic uses 207 through 209. Integer comparisons
		use the encoded range from integer_compare.
		Other nodes and absent indices return 0.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32))
		(returns u32)
		(body
			(if
				(:doc "An absent node has no keyword spelling.")
				(i32.lt (local index) 0i32)
				(then (return 0u32)))
			(let node (array.load (local nodes) (local index)))
			(if
				(:doc "Only a bare atom can be a keyword.")
				(bool.not (u32.eq (struct.get (local node) kind) 1u32))
				(then (return 0u32)))
			(let start (struct.get (local node) start))
			(let width (i32.sub (struct.get (local node) end) (local start)))
			(if
				(:doc "Only the exact allocation keyword creates a native storage owner.")
				(call same_bytes (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local native_alloc_keyword)) 0i32 (array.len (local native_alloc_keyword)))
				(then (return (call native_alloc_kind))))
			(if
				(:doc "An empty pointer owner starts with a typed null handle.")
				(call same_bytes (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local native_empty_keyword)) 0i32 (array.len (local native_empty_keyword)))
				(then (return (call native_empty_kind))))
			(if
				(:doc "Match the complete embed keyword.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 101u8 109u8 98u8)
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 4i32 100u8))))
				(then (return 60u32)))
			(if
				(:doc "Match the exact nullable owner predicate.")
				(call same_bytes (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local owner_is_null_keyword)) 0i32 (array.len (local owner_is_null_keyword)))
				(then (return 98u32)))
			(if
				(:doc "An exact optional unwrap can supply the operand of a local move.")
				(call same_bytes (borrow-shared (local source)) (local start) (i32.add (local start) (local width))
					(borrow-shared (local optional_unwrap_keyword)) 0i32 (array.len (local optional_unwrap_keyword)))
				(then (return 101u32)))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Primitive literals and array view types keep their shared keyword codes.")
				(u32.lt 0u32 (local type))
				(then (return (local type))))
			(if
				(:doc "Match the entire fn keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 2i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 102u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 110u8)))
				(then (return 1u32)))
			(if
				(:doc "Match the entire main keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 4i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) 109u8 97u8 105u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 110u8)))
				(then (return 2u32)))
			(if
				(:doc "Match the entire params keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 6i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) 112u8 97u8 114u8)
						(call is_three_bytes (borrow-shared (local source))
							(i32.add (local start) 3i32) 97u8 109u8 115u8)))
				(then (return 3u32)))
			(if
				(:doc "Match the entire returns keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 7i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) 114u8 101u8 116u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 3i32) 117u8 114u8 110u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 6i32 115u8))))
				(then (return 4u32)))
			(if
				(:doc "Match the entire body keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 4i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) 98u8 111u8 100u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 121u8)))
				(then (return 6u32)))
			(if
				(:doc "Match the entire return keyword before returning its code.")
				(bool.and
					(i32.eq (local width) 6i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) 114u8 101u8 116u8)
						(call is_three_bytes (borrow-shared (local source))
							(i32.add (local start) 3i32) 117u8 114u8 110u8)))
				(then (return 7u32)))
			(if
				(:doc "Match the entire local keyword.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 108u8)
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 1i32 111u8)
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 2i32 99u8)
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) 3i32 97u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 4i32 108u8))))))
				(then (return 8u32)))
			(if
				(:doc "Match the entire call keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 99u8)
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 1i32 97u8)
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 2i32 108u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)))))
				(then (return 9u32)))
			(if
				(:doc "Match the entire true keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 116u8)
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 1i32 114u8)
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 2i32 117u8)
								(call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)))))
				(then (return 13u32)))
			(if
				(:doc "Match the entire false keyword.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 102u8)
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 1i32 97u8)
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) 2i32 108u8)
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) 3i32 115u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 4i32 101u8))))))
				(then (return 14u32)))
			(if
				(:doc "Let and let-mut share a prefix but require their full spelling.")
				(bool.and (bool.or (i32.eq (local width) 3i32) (i32.eq (local width) 7i32))
					(call is_three_bytes (borrow-shared (local source)) (local start) 108u8 101u8 116u8))
				(then
					(if
						(:doc "The short spelling declares an immutable local.")
						(i32.eq (local width) 3i32)
						(then (return 15u32)))
					(if
						(:doc "The -mut suffix declares a writable local.")
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 45u8)
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 4i32) 109u8 117u8 116u8))
						(then (return 16u32)))))
			(if
				(:doc "Match the entire set keyword.")
				(bool.and (i32.eq (local width) 3i32)
					(call is_three_bytes (borrow-shared (local source)) (local start) 115u8 101u8 116u8))
				(then (return 17u32)))
			(if
				(:doc "Match the complete if keyword.")
				(bool.and (i32.eq (local width) 2i32)
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) 0i32 105u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 1i32 102u8)))
				(then (return 22u32)))
			(if
				(:doc "Match the complete then keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 116u8 104u8 101u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 110u8)))
				(then (return 23u32)))
			(if
				(:doc "Match the complete else keyword.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 101u8 108u8 115u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)))
				(then (return 24u32)))
			(if
				(:doc "Match the complete while keyword.")
				(bool.and (i32.eq (local width) 5i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 119u8 104u8 105u8)
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) 3i32 108u8)
							(call is_head_byte (borrow-shared (local source)) (local start) 4i32 101u8))))
				(then (return 25u32)))
			(if
				(:doc "Match all eleven bytes of int.convert before reading its target.")
				(bool.and (i32.eq (local width) 11i32)
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 105u8 110u8 116u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 3i32) 46u8 99u8 111u8)
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add (local start) 6i32) 110u8 118u8 101u8)
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) 9i32 114u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 10i32 116u8))))))
				(then (return 33u32)))
			(if
				(:doc "Match the complete move keyword before checking other compound spellings.")
				(bool.and (i32.eq (local width) 4i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 109u8 111u8 118u8)
						(call is_head_byte (borrow-shared (local source)) (local start) 3i32 101u8)))
				(then (return 43u32)))
			(let comparison (call integer_comparison_keyword (borrow-shared (local source)) (local start) (struct.get (local node) end)))
			(if
				(:doc "Return a complete comparison keyword before checking wrapping arithmetic.")
				(u32.lt 0u32 (local comparison))
				(then (return (local comparison))))
			(let bit (call word_bit_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Return an exact word mask or shift keyword.")
				(u32.lt 0u32 (local bit))
				(then (return (local bit))))
			(let logical (call logical_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "A complete bool connective selects its logical evaluation.")
				(u32.lt 0u32 (local logical))
				(then (return (local logical))))
			(if
				(:doc "Check the complete byte allocation keyword before the other array operations.")
				(bool.and (i32.eq (local width) 11i32)
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) 97u8 114u8 114u8)
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add (local start) 3i32) 97u8 121u8 46u8)
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add (local start) 6i32) 97u8 108u8 108u8)
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) 9i32 111u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 10i32 99u8))))))
				(then (return 41u32)))
			(let borrow (call borrow_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Recognize exact explicit borrow spellings before wrapping arithmetic.")
				(u32.lt 0u32 (local borrow))
				(then (return (local borrow))))
			(let record (call record_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Recognize complete record keywords before testing wrapping arithmetic.")
				(u32.lt 0u32 (local record))
				(then (return (local record))))
			(let array (call array_keyword (borrow-shared (local source)) (local start) (struct.get (local node) end)))
			(if
				(:doc "Distinguish fixed arrays from heap-backed allocation.")
				(u32.lt 0u32 (local array))
				(then (return (local array))))
			(if
				(:doc "Read a complete signed quotient keyword.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local i32_div_head)))
				(then (return 76u32)))
			(if
				(:doc "Read a complete signed remainder keyword.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local i32_rem_head)))
				(then (return 77u32)))
			(let wrapping (call wrapping_keyword (borrow-shared (local source)) (local start) (local width)))
			(if (u32.lt 0u32 (local wrapping)) (then (return (local wrapping))))
			(let enumeration (call enum_keyword (borrow-shared (local source)) (local node)))
			(if (u32.lt 0u32 (local enumeration)) (then (return (local enumeration))))
			(if
				(:doc "Match the exact iteration statement and header forms.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local for_head)))
				(then (return (local for_statement))))
			(if
				(:doc "A loop binder has its own tagged form.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local bind_head)))
				(then (return (local for_bind))))
			(if
				(:doc "A bare range tag identifies an integer iterator source.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local range_head)))
				(then (return (local for_range))))
			(if
				(:doc "Only the complete break spelling names a loop exit.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local break_head)))
				(then (return (local break_statement))))
			(if
				(:doc "Only the complete continue spelling names a loop restart.")
				(call keyword_matches (borrow-shared (local source)) (local start) (struct.get (local node) end)
					(borrow-shared (local continue_head)))
				(then (return (local continue_statement))))
			(let floating (call float_operator_keyword (borrow-shared (local source)) (local node)))
			(if (u32.lt 0u32 (local floating)) (then (return (local floating))))
			(let integer (call read_integer_operator (borrow-shared (local source)) (local start) (struct.get (local node) end)))
			(if (u32.lt 0u32 (local integer)) (then (return (local integer))))
			(let integer_check (struct.get (call read_integer_check (borrow-shared (local source)) (local node)) kind))
			(if (u32.lt 0u32 (local integer_check)) (then (return (local integer_check))))
			(return (struct.get (call read_named_conversion (borrow-shared (local source)) (local node)) kind))))

	(fn entry_at
		(:doc `Associate an entry-reader result with its original source node.`)
		(params (node SourceNode) (operand i32) (error u32))
		(returns EntryRead)
		(body
			(return (struct.new EntryRead (operand (local operand)) (error (local error))
				(start (struct.get (local node) start)) (end (struct.get (local node) end)) (related -1i32)))))

	(fn entry_form
		(:doc `Check the expected tag and ordinary metadata at a signature or expression form.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (tag u32) (error u32))
		(returns EntryRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(if
				(:doc "An atom or a different form tag keeps the caller's contextual diagnostic.")
				(bool.not (u32.eq
					(call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parts) head))
					(local tag)))
				(then (return (call entry_at (local node) -1i32 (local error)))))
			(let metadata (call validate_form_metadata (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts)))
			(if
				(:doc "Known selection pragmas cannot guard operands or body forms.")
				(u32.lt 0u32 (struct.get (local metadata) error))
				(then (return (struct.new EntryRead (operand -1i32)
					(start (struct.get (local metadata) start)) (end (struct.get (local metadata) end))
					(error (struct.get (local metadata) error)) (related -1i32)))))
			(return (call entry_at (local node) (struct.get (local parts) operands) 0u32))))

	(fn statement_error
		(:doc `Keep the original syntax diagnostic when no statement can be read.`)
		(params (problem EntryRead))
		(returns StatementRead)
		(body
			(return (struct.new StatementRead (kind 0u32) (binding -1i32) (value -1i32)
				(start (struct.get (local problem) start)) (end (struct.get (local problem) end))
				(error (struct.get (local problem) error))))))

	(fn read_statement
		(:doc `Locate the statement value or condition. Calls and stores can be their own operation roots.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32))
		(returns StatementRead)
		(body
			(let node (array.load (local nodes) (local index)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parts) head)))
			(if
				(:doc "The expression planner checks the operands of a standalone call or store.")
				(bool.or (u32.eq (local tag) 9u32)
					(bool.or (u32.eq (local tag) 40u32) (call is_array_growth_statement (local tag))))
				(then (return (struct.new StatementRead (kind (local tag)) (binding -1i32) (value (local index))
					(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))
			(let returning (u32.eq (local tag) 7u32))
			(let iterating (u32.eq (local tag) (local for_statement)))
			(let loop_exit (call is_loop_exit (local tag)))
			(let control (bool.or (u32.eq (local tag) (local match_statement))
				(bool.or (u32.eq (local tag) 22u32) (u32.eq (local tag) 25u32))))
			(if
				(:doc "Reject unsupported statements at their complete originating span.")
				(bool.and (bool.not (bool.or (local iterating) (bool.or (local loop_exit) (bool.or (local returning) (local control)))))
					(bool.or (u32.lt (local tag) 15u32) (u32.lt 17u32 (local tag))))
				(then (return (call statement_error (call entry_at (local node) -1i32 24u32)))))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local tag) 24u32))
			(if
				(:doc "Known selection pragmas cannot alter a statement.")
				(u32.lt 0u32 (struct.get (local form) error))
				(then (return (call statement_error (local form)))))
			(if
				(:doc "A return ends the sequence of active statements in its block.")
				(local returning)
				(then
					(let next (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local node) next_sibling)))
					(if
						(:doc "Point at the first active statement after the terminal return.")
						(bool.not (i32.lt (local next) 0i32))
						(then (return (call statement_error
							(call entry_at (array.load (local nodes) (local next)) -1i32 24u32)))))))
			(if
				(:doc "Loop exits take no operands.")
				(local loop_exit)
				(then
					(if
						(:doc "Report an operand on the complete loop exit statement.")
						(i32.lt -1i32 (struct.get (local form) operand))
						(then (return (call statement_error (call entry_at (local node) -1i32 24u32)))))
					(return (struct.new StatementRead (kind (local tag)) (binding -1i32) (value -1i32)
						(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))
			(let-mut value (struct.get (local form) operand))
			(if
				(:doc "Keep the iteration binder and source separate from the body.")
				(local iterating)
				(then
					(if (i32.lt (local value) 0i32) (then (return (call statement_error (call entry_at (local node) -1i32 24u32)))))
					(let iterator (struct.get (array.load (local nodes) (local value)) next_sibling))
					(if (i32.lt (local iterator) 0i32) (then (return (call statement_error (call entry_at (local node) -1i32 24u32)))))
					(return (struct.new StatementRead (kind (local tag)) (binding (local value)) (value (local iterator))
						(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))
			(if
				(:doc "The control-flow reader locates the condition or subject before checking its arms.")
				(local control)
				(then
					(if
						(:doc "An if or while requires a condition before its blocks.")
						(i32.lt (local value) 0i32)
						(then (return (call statement_error (call entry_at (local node) -1i32 24u32)))))
					(return (struct.new StatementRead (kind (local tag)) (binding -1i32) (value (local value))
						(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))
			(let-mut binding -1i32)
			(if
				(:doc "A declaration or assignment supplies a name or target before its value.")
				(bool.and (bool.not (local returning)) (bool.not (i32.lt (local value) 0i32)))
				(then
					(set (local binding) (local value))
					(set (local value) (struct.get (array.load (local nodes) (local binding)) next_sibling))))
			(if
				(:doc "A return can omit its value. A present value must be the final operand.")
				(bool.or (bool.and (bool.not (local returning)) (i32.lt (local value) 0i32))
					(bool.and (bool.not (i32.lt (local value) 0i32))
						(bool.not (i32.lt (struct.get (array.load (local nodes) (local value)) next_sibling) 0i32))))
				(then (return (call statement_error (call entry_at (local node) -1i32 24u32)))))
			(return (struct.new StatementRead (kind (local tag)) (binding (local binding)) (value (local value))
				(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))

	(fn scalar_type
		(:doc `Return an exact scalar type keyword or zero when the atom names another construct.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32))
		(returns u32)
		(body
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))
			(if
				(:doc "Only the primitive copyable types are scalar keywords.")
				(call is_builtin_scalar (local tag))
				(then (return (local tag))))
			(return 0u32)))

)
