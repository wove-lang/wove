(module scalar_syntax
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the source syntax for scalar C emission.

	Use the original tree links and source spans for signature and expression
	checks. Normalize literal spellings before lowering them to C.`)

	(use wove-file "../text/decimal.wove" (only read_decimal_digits read_bounded_decimal_spelling))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../source/scan.wove" (only is_identifier_head (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata))
	(use wove-file "../source/types.wove" (only builtin_type_keyword is_builtin_integer))

	(struct EntryRead (fields (operand i32) (start i32) (end i32) (error u32) (related i32)))
	(struct StatementRead (fields (kind u32) (binding i32) (value i32) (start i32) (end i32) (error u32)))
	(struct ScalarOperator (fields (operand u32) (result u32) (symbol u8) (arity i32) (short_circuit bool)))
	(struct DecimalSpelling (fields (digits i32) (negative bool)))
	(struct FixedArrayShape (fields (element u32) (extent i32)))

	(let array_type_head "array")
	(let array_make_head "array.make")
	(let array_repeat_head "array.repeat")
	(let array_load_head "array.load")
	(let array_store_head "array.store")
	(let i32_div_head "i32.div")
	(let i32_rem_head "i32.rem")
	(let wide_add_head "u64.add.wrapping")
	(let u64_maximum "18446744073709551615")

	(fn keyword_matches
		(:doc `Compare a checked atom to an immutable keyword spelling.`)
		(params (source (shared-slice u8)) (start i32) (end i32) (keyword (shared-slice u8)))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared (local source)) (local start) (local end)
				(borrow-shared (local keyword)) (i32 0) (slice.len (local keyword))))))

	(fn fixed_array_keyword
		(:doc `Recognize the fixed-array type and operation heads at their full widths.`)
		(params (source (shared-slice u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Check the keyword width before advancing to the prefix end.")
				(i32.lt (i32.sub.wrapping (local end) (local start)) (i32 5))
				(then (return (u32 0))))
			(let prefix_end (i32.add.wrapping (local start) (i32 5)))
			(if
				(:doc "Other keywords need no comparison against the array forms.")
				(bool.not (call keyword_matches (borrow-shared (local source)) (local start) (local prefix_end)
					(borrow-shared (local array_type_head))))
				(then (return (u32 0))))
			(if (i32.eq (local end) (local prefix_end)) (then (return (u32 70))))
			(if
				(:doc "A typed list initializes one element per operand.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_make_head)))
				(then (return (u32 71))))
			(if
				(:doc "A repeat initializer supplies one value for the declared extent.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_repeat_head)))
				(then (return (u32 72))))
			(if
				(:doc "A load reads a checked element by value.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_load_head)))
				(then (return (u32 73))))
			(if
				(:doc "A store writes an element in a writable local.")
				(call keyword_matches (borrow-shared (local source)) (local start) (local end) (borrow-shared (local array_store_head)))
				(then (return (u32 74))))
			(return (u32 0))))

	(fn is_fixed_array_type_head
		(:doc `Check whether a source atom introduces a structural array layout.`)
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (record.get (local node) kind) (u32 1))
				(call keyword_matches (borrow-shared (local source)) (record.get (local node) start)
					(record.get (local node) end) (borrow-shared (local array_type_head)))))))

	(fn is_fixed_initializer
		(:doc `Identify either typed fixed-array initializer.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (u32 71)) (u32.eq (local kind) (u32 72))))))

	(fn is_fixed_access
		(:doc `Identify a checked fixed-array index operation.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (u32 73)) (u32.eq (local kind) (u32 74))))))

	(fn is_scalar_name
		(:doc `Check that the source operand names an unquoted Wove identifier.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (record.get (local node) kind) (u32 1))
				(call is_identifier_head (borrow-shared (local source))
					(record.get (local node) start) (record.get (local node) end))))))

	(fn same_name
		(:doc `Compare the original spellings of two checked identifier nodes.`)
		(params (source (shared-slice u8)) (left SourceNode) (right SourceNode))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared (local source)) (record.get (local left) start)
				(record.get (local left) end) (borrow-shared (local source)) (record.get (local right) start)
				(record.get (local right) end)))))

	(fn is_wrapping_suffix
		(:doc `Check the full nine-byte .wrapping suffix after an arithmetic mnemonic.`)
		(:pragma (inline always))
		(params (source (shared-slice u8)) (start i32))
		(returns bool)
		(body
			(return (bool.and
				(call is_three_bytes (borrow-shared (local source)) (local start) (u8 46) (u8 119) (u8 114))
				(bool.and
					(call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 3)) (u8 97) (u8 112) (u8 112))
					(call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 6)) (u8 105) (u8 110) (u8 103)))))))

	(fn comparison_suffix
		(:doc `Read an exact two-byte comparison mnemonic after its scalar prefix.`)
		(params (source (shared-slice u8)) (start i32) (equal u32))
		(returns u32)
		(body
			(let first (slice.load (local source) (local start)))
			(let second (slice.load (local source) (i32.add.wrapping (local start) (i32 1))))
			(if
				(:doc "Recognize the equality suffix.")
				(bool.and (u8.eq (local first) (u8 101)) (u8.eq (local second) (u8 113)))
				(then (return (local equal))))
			(if
				(:doc "The less-than kind follows the equality kind for each scalar type.")
				(bool.and (u8.eq (local first) (u8 108)) (u8.eq (local second) (u8 116)))
				(then (return (u32.add.wrapping (local equal) (u32 1)))))
			(return (u32 0))))

	(fn comparison_keyword
		(:doc `Read a comparison keyword for an exact built-in integer type.`)
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Byte comparisons are the only comparisons with a three-byte prefix.")
				(bool.and (i32.eq (local width) (i32 5))
					(call is_three_bytes (borrow-shared (local source)) (local start) (u8 117) (u8 56) (u8 46)))
				(then (return (call comparison_suffix (borrow-shared (local source))
					(i32.add.wrapping (local start) (i32 3)) (u32 26)))))
			(if
				(:doc "Wide unsigned comparisons use their own consecutive codes.")
				(bool.and (i32.eq (local width) (i32 6))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) (u8 117) (u8 54) (u8 52))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 46))))
				(then (return (call comparison_suffix (borrow-shared (local source))
					(i32.add.wrapping (local start) (i32 4)) (u32 84)))))
			(if
				(:doc "Both word comparisons have six bytes and share the 32. spelling.")
				(bool.or (bool.not (i32.eq (local width) (i32 6)))
					(bool.not (call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 1)) (u8 51) (u8 50) (u8 46))))
				(then (return (u32 0))))
			(let prefix (slice.load (local source) (local start)))
			(let mnemonic (i32.add.wrapping (local start) (i32 4)))
			(if
				(:doc "The i32 prefix selects signed comparisons.")
				(u8.eq (local prefix) (u8 105))
				(then (return (call comparison_suffix (borrow-shared (local source)) (local mnemonic) (u32 18)))))
			(if
				(:doc "The u32 prefix selects unsigned comparisons.")
				(u8.eq (local prefix) (u8 117))
				(then (return (call comparison_suffix (borrow-shared (local source)) (local mnemonic) (u32 28)))))
			(return (u32 0))))

	(fn wrapping_keyword
		(:doc `Read the operation code from a complete signed or unsigned wrapping keyword.`)
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "The wide word supports wrapping addition.")
				(call keyword_matches (borrow-shared (local source)) (local start)
					(i32.add.wrapping (local start) (local width)) (borrow-shared (local wide_add_head)))
				(then (return (u32 86))))
			(if
				(:doc "The wrapping forms have a fixed width and a common 32. suffix after their first letter.")
				(bool.or (bool.not (i32.eq (local width) (i32 16)))
					(bool.not (call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 1)) (u8 51) (u8 50) (u8 46))))
				(then (return (u32 0))))
			(let prefix (slice.load (local source) (local start)))
			(let unsigned (u8.eq (local prefix) (u8 117)))
			(if
				(:doc "The leading letter selects signed or unsigned arithmetic.")
				(bool.not (bool.or (local unsigned) (u8.eq (local prefix) (u8 105))))
				(then (return (u32 0))))
			(if
				(:doc "Only the explicit wrapping arithmetic spelling is supported.")
				(bool.not (call is_wrapping_suffix (borrow-shared (local source)) (i32.add.wrapping (local start) (i32 7))))
				(then (return (u32 0))))
			(let-mut addition (u32 20))
			(if
				(:doc "The unsigned addition and subtraction codes form their own consecutive pair.")
				(local unsigned)
				(then (set (local addition) (u32 46))))
			(let mnemonic (i32.add.wrapping (local start) (i32 4)))
			(if
				(:doc "Recognize add at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 97) (u8 100) (u8 100))
				(then (return (local addition))))
			(if
				(:doc "The subtraction code follows the matching addition code.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 115) (u8 117) (u8 98))
				(then (return (u32.add.wrapping (local addition) (u32 1)))))
			(if
				(:doc "This slice adds wrapping multiplication for signed words.")
				(bool.and (bool.not (local unsigned))
					(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 109) (u8 117) (u8 108)))
				(then (return (u32 75))))
			(return (u32 0))))

	(fn is_i32_division
		(:doc `Identify the two checked signed division operations.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (u32 76)) (u32.eq (local kind) (u32 77))))))

	(fn logical_keyword
		(:doc `Recognize the three exact bool operator spellings.`)
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Only a full bool prefix and supported suffix width can make an operator.")
				(bool.or
					(bool.not (bool.or (i32.eq (local width) (i32 7)) (i32.eq (local width) (i32 8))))
					(bool.not
						(bool.and
							(call is_three_bytes (borrow-shared (local source)) (local start) (u8 98) (u8 111) (u8 111))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 108))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 46))))))
				(then (return (u32 0))))
			(let mnemonic (i32.add.wrapping (local start) (i32 5)))
			(if
				(:doc "The two-byte suffix is or.")
				(i32.eq (local width) (i32 7))
				(then
					(if
						(:doc "Match both bytes of the or suffix.")
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local mnemonic) (i32 0) (u8 111))
							(call is_head_byte (borrow-shared (local source)) (local mnemonic) (i32 1) (u8 114)))
						(then (return (u32 31))))
					(return (u32 0))))
			(if
				(:doc "Match and at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 97) (u8 110) (u8 100))
				(then (return (u32 30))))
			(if
				(:doc "Match not at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 110) (u8 111) (u8 116))
				(then (return (u32 32))))
			(return (u32 0))))

	(fn word_bit_keyword
		(:doc `Recognize exact u32 and u64 masks, complements, and shifts.`)
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Check the exact operator width and separating dot.")
				(bool.not (bool.and (bool.or (i32.eq (local width) (i32 6)) (i32.eq (local width) (i32 7)))
					(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 46))))
				(then (return (u32 0))))
			(let type (call builtin_type_keyword (borrow-shared (local source)) (local start) (i32 3)))
			(let wide (u32.eq (local type) (u32 54)))
			(if
				(:doc "Only the two unsigned word types use these suffixes.")
				(bool.not (bool.or (u32.eq (local type) (u32 11)) (local wide)))
				(then (return (u32 0))))
			(let-mut base (u32 66))
			(let-mut xor_kind (u32 91))
			(if
				(:doc "The wide word uses its own operation codes for the same suffixes.")
				(local wide)
				(then
					(set (local base) (u32 87))
					(set (local xor_kind) (u32 93))))
			(let suffix (i32.add.wrapping (local start) (i32 4)))
			(if
				(:doc "Only or has a two-byte suffix.")
				(i32.eq (local width) (i32 6))
				(then
					(if
						(:doc "Read both bytes of the or suffix.")
						(bool.and (call is_head_byte (borrow-shared (local source)) (local suffix) (i32 0) (u8 111))
							(call is_head_byte (borrow-shared (local source)) (local suffix) (i32 1) (u8 114)))
						(then (return (u32.add.wrapping (local base) (u32 1)))))
					(return (u32 0))))
			(if
				(:doc "Match and at its full width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 97) (u8 110) (u8 100))
				(then (return (local base))))
			(if
				(:doc "Match shl at its full width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 115) (u8 104) (u8 108))
				(then (return (u32.add.wrapping (local base) (u32 2)))))
			(if
				(:doc "Match shr at its full width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 115) (u8 104) (u8 114))
				(then (return (u32.add.wrapping (local base) (u32 3)))))
			(if
				(:doc "Match xor at its complete width.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 120) (u8 111) (u8 114))
				(then (return (local xor_kind))))
			(if
				(:doc "Match the word complement suffix.")
				(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 110) (u8 111) (u8 116))
				(then (return (u32.add.wrapping (local xor_kind) (u32 1)))))
			(return (u32 0))))

	(fn word_shift_type
		(:doc `Return the checked shift's word type, or zero for other operations.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns u32)
		(body
			(if
				(:doc "These shifts keep the original u32 width.")
				(bool.or (u32.eq (local kind) (u32 68)) (u32.eq (local kind) (u32 69)))
				(then (return (u32 11))))
			(if
				(:doc "These shifts preserve the full u64 word.")
				(bool.or (u32.eq (local kind) (u32 89)) (u32.eq (local kind) (u32 90)))
				(then (return (u32 54))))
			(return (u32 0))))

	(fn mask_operator
		(:doc `Describe the C spelling and exact type of an unsigned bitwise mask or complement.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(let-mut symbol (u8 0))
			(let-mut arity (i32 2))
			(if
				(:doc "AND retains bits set in both words.")
				(bool.or (u32.eq (local kind) (u32 66)) (u32.eq (local kind) (u32 87)))
				(then (set (local symbol) (u8 38))))
			(if
				(:doc "OR retains bits set in either word.")
				(bool.or (u32.eq (local kind) (u32 67)) (u32.eq (local kind) (u32 88)))
				(then (set (local symbol) (u8 124))))
			(if
				(:doc "XOR retains bits that differ between the words.")
				(bool.or (u32.eq (local kind) (u32 91)) (u32.eq (local kind) (u32 93)))
				(then (set (local symbol) (u8 94))))
			(if
				(:doc "Complement takes just one word.")
				(bool.or (u32.eq (local kind) (u32 92)) (u32.eq (local kind) (u32 94)))
				(then
					(set (local symbol) (u8 126))
					(set (local arity) (i32 1))))
			(let-mut type (u32 0))
			(if
				(:doc "Only recognized masks and complements contribute a result.")
				(u8.lt (u8 0) (local symbol))
				(then
					(set (local type) (u32 11))
					(if
						(:doc "These four masks have exact u64 operands.")
						(bool.or (bool.or (u32.eq (local kind) (u32 87)) (u32.eq (local kind) (u32 88)))
							(bool.or (u32.eq (local kind) (u32 93)) (u32.eq (local kind) (u32 94))))
						(then (set (local type) (u32 54))))))
			(return (record.make ScalarOperator (operand (local type)) (result (local type))
				(symbol (local symbol)) (arity (local arity)) (short_circuit (bool false))))))

	(fn scalar_operator
		(:doc `Describe an operator's arity, operand and result types, and meaning in C.

		The operand field applies to every operand. A zero result marks a
		non-operator. Equality emits two equals bytes. Short-circuit operators
		use an explicit branch around the right operand's evaluation.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(let multiply (u32.eq (local kind) (u32 75)))
			(let signed (bool.or (local multiply) (bool.or (u32.eq (local kind) (u32 20)) (u32.eq (local kind) (u32 21)))))
			(let unsigned (bool.or (u32.eq (local kind) (u32 46)) (u32.eq (local kind) (u32 47))))
			(if
				(:doc "int.eq learns its exact operand type from the written type argument.")
				(u32.eq (local kind) (u32 65))
				(then (return (record.make ScalarOperator (operand (u32 0)) (result (u32 12))
					(symbol (u8 61)) (arity (i32 2)) (short_circuit (bool false))))))
			(if
				(:doc "Wrapping arithmetic uses the same exact type for both operands and the result.")
				(bool.or (local signed) (local unsigned))
				(then
					(let-mut type (u32 5))
					(if
						(:doc "Unsigned operations keep the u32 type.")
						(local unsigned)
						(then (set (local type) (u32 11))))
					(let-mut symbol (u8 43))
					(if
						(:doc "Both subtraction kinds use the minus operator.")
						(bool.or (u32.eq (local kind) (u32 21)) (u32.eq (local kind) (u32 47)))
						(then (set (local symbol) (u8 45))))
					(if
						(:doc "Wrapping multiplication uses the product of the widened operands.")
						(local multiply)
						(then (set (local symbol) (u8 42))))
					(return (record.make ScalarOperator (operand (local type)) (result (local type))
						(symbol (local symbol)) (arity (i32 2)) (short_circuit (bool false))))))
			(if
				(:doc "Unsigned wide addition wraps in its exact result type.")
				(u32.eq (local kind) (u32 86))
				(then (return (record.make ScalarOperator (operand (u32 54)) (result (u32 54))
					(symbol (u8 43)) (arity (i32 2)) (short_circuit (bool false))))))
			(if
				(:doc "Both division operations take two exact signed operands and use a checked runtime call.")
				(call is_i32_division (local kind))
				(then (return (record.make ScalarOperator (operand (u32 5)) (result (u32 5))
					(symbol (u8 0)) (arity (i32 2)) (short_circuit (bool false))))))
			(let mask (call mask_operator (local kind)))
			(if
				(:doc "Bitwise operations preserve their exact operand type.")
				(u32.lt (u32 0) (record.get (local mask) result))
				(then (return (local mask))))
			(if
				(:doc "A conjunction guards the right operand with the left value.")
				(u32.eq (local kind) (u32 30))
				(then (return (record.make ScalarOperator (operand (u32 12)) (result (u32 12)) (symbol (u8 38))
					(arity (i32 2)) (short_circuit (bool true))))))
			(if
				(:doc "A disjunction guards the right operand with the negated left value.")
				(u32.eq (local kind) (u32 31))
				(then (return (record.make ScalarOperator (operand (u32 12)) (result (u32 12)) (symbol (u8 124))
					(arity (i32 2)) (short_circuit (bool true))))))
			(if
				(:doc "Negation uses one boolean operand.")
				(u32.eq (local kind) (u32 32))
				(then (return (record.make ScalarOperator (operand (u32 12)) (result (u32 12)) (symbol (u8 33))
					(arity (i32 1)) (short_circuit (bool false))))))
			(let-mut operand (u32 0))
			(if
				(:doc "The ordered pairs of comparison kinds share their operand type.")
				(bool.or (u32.eq (local kind) (u32 18)) (u32.eq (local kind) (u32 19)))
				(then (set (local operand) (u32 5))))
			(if
				(:doc "Both byte comparisons require exact u8 operands.")
				(bool.or (u32.eq (local kind) (u32 26)) (u32.eq (local kind) (u32 27)))
				(then (set (local operand) (u32 10))))
			(if
				(:doc "Both unsigned word comparisons require exact u32 operands.")
				(bool.or (u32.eq (local kind) (u32 28)) (u32.eq (local kind) (u32 29)))
				(then (set (local operand) (u32 11))))
			(if
				(:doc "Wide comparisons require exact u64 operands.")
				(bool.or (u32.eq (local kind) (u32 84)) (u32.eq (local kind) (u32 85)))
				(then (set (local operand) (u32 54))))
