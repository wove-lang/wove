(module scalar_syntax
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the source syntax for scalar C emission.

	Use the original tree links and source spans for signature and expression
	checks. Normalize literal spellings before lowering them to C.`)

	(use wove-file "./flow.wove" (only is_loop_exit (value break_statement) (value continue_statement) (value for_statement)))
	(use wove-file "../source/owned.wove" (only (value optional_none) (value optional_some)))
	(use wove-file "../source/slice_options.wove" (only slice_option_keyword optional_presence_operation))
	(use wove-file "../source/array_growth.wove" (only array_growth_operation is_array_growth_statement (value array_try_alloc_kind)))
	(use wove-file "../source/numeric_ops.wove" (only read_named_conversion read_value_encoding))
	(use wove-file "../source/integer_bits.wove" (only word_bit_keyword word_bit_operation word_bit_count_type word_bit_count_slot word_mask_type word_mask_symbol))
	(use wove-file "../source/integer_checks.wove" (only read_integer_check integer_check_suffix))
	(use wove-file "../source/integer_compare.wove" (only integer_comparison_keyword integer_comparison_operation is_integer_comparison
		comparison_operand_type comparison_is_zero comparison_symbol))
	(use wove-file "../source/integer_ops.wove" (only read_integer_operator integer_arithmetic_operation integer_operator is_integer_step))
	(use wove-file "../source/float_ops.wove" (only float_operator_keyword float_operation is_float_operator float_operator_type
		float_operator_slot float_operator_symbol))
	(use wove-file "../source/enum_forms.wove" (only enum_keyword (value match_statement)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/boolean.wove" (only read_boolean_word))
	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../source/generics.wove" (only (value checked_type_operand)))
	(use wove-file "../source/receiver_words.wove" (only is_receiver_head (value type_new_head)))
	(use wove-file "../source/field_paths.wove" (only (value field_path_get_head)))
	(use wove-file "../source/scan.wove" (only is_wove_name (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts next_form_operand skip_disabled_siblings validate_form_metadata (type FormParts)))
	(use wove-file "../source/types.wove" (only builtin_type_keyword is_builtin_scalar is_builtin_integer_value is_builtin_float))

	(struct EntryRead (fields (operand i32) (start i32) (end i32) (error u32) (related i32)))
	(struct StatementRead (fields (kind u32) (binding i32) (value i32) (start i32) (end i32) (error u32)))
	(struct ScalarOperator (fields (operand u32) (result u32) (symbol u8) (arity i32) (short_circuit bool)))
	(struct FixedArrayShape (fields (element u32) (extent i32)))

	(let for_head "for")
	(let range_head "range")
	(let binding_reference 8u32)
	(let let_binding 15u32)
	(let for_range 151u32)
	(let break_head "break")
	(let continue_head "continue")
	(let array_type_head "array")
	(let array_alloc_head "alloc")
	(let array_try_alloc_head "try-alloc")
	(let array_new_head "new")
	(let array_repeat_head "repeat")
	(let array_len_head "len")
	(let array_range_head "range")
	(let array_try_copy_head "try-copy-from")
	(let array_try_copy_kind 615u32)
	(let array_get_head "get")
	(let receiver_operation_kind 640u32)
	(let array_set_head "set")
	(let worker_spawn_join_head "worker:spawn-join")
	(let worker_spawn_head "worker:spawn")
	(let worker_try_spawn_head "worker:try-spawn")
	(let worker_join_head "join")
	(let worker_queue_head "worker:receipt-queue")
	(let worker_push_head "push")
	(let worker_len_head "len")
	(let worker_pop_front_head "pop-front")
	(let worker_join_all_head "join-all")
	(let fn_type_head "fn-type")
	(let fn_ref_head "fn-ref")
	(let fn_type_kind 590u32)
	(let fn_ref_kind 591u32)
	(let indirect_call_kind 592u32)
	(let worker_open_pool_head "worker:open-pool")
	(let worker_try_reserve_head "try-reserve")
	(let worker_reserve_wait_head "reserve-wait")
	(let worker_try_close_head "try-close")
	(let worker_spawn_on_head "worker:spawn-on")
	(let worker_spawn_join_kind 570u32)
	(let worker_spawn_kind 572u32)
	(let worker_join_kind 573u32)
	(let worker_queue_kind 575u32)
	(let worker_push_kind 576u32)
	(let worker_join_all_kind 577u32)

	(let worker_open_pool_kind 578u32)
	(let worker_try_reserve_kind 579u32)
	(let worker_reserve_wait_kind 580u32)
	(let worker_try_close_kind 581u32)
	(let worker_spawn_on_kind 582u32)
	(let worker_try_spawn_kind 584u32)
	(let worker_len_kind 585u32)
	(let worker_pop_front_kind 586u32)

	(fn is_worker_pool_operation
		(:doc "Recognize the four operations that open, reserve, or close a pool.")
		(params (kind u32)) (returns bool)
		(body (return (bool:and (kind.not-lt worker_open_pool_kind)
			(worker_try_close_kind.not-lt kind)))))

	(fn is_worker_submission
		(:doc "Independent launches produce a receipt for both dedicated and pooled jobs.")
		(params (kind u32)) (returns bool)
		(body (return (bool:or (kind.eq worker_spawn_kind)
			(kind.eq worker_spawn_on_kind)))))

	(fn is_worker_launch
		(:doc "Recognize worker operations that name a handler and transfer one owned job.")
		(params (kind u32)) (returns bool)
		(body (return (bool:or (call is_worker_submission kind)
			(bool:or (kind.eq worker_spawn_join_kind)
				(kind.eq worker_try_spawn_kind))))))

	(fn is_worker_queue_access
		(:doc "Recognize operations that inspect or remove a receipt while keeping the queue live.")
		(params (kind u32)) (returns bool)
		(body (return (bool:or (kind.eq worker_len_kind)
			(kind.eq worker_pop_front_kind)))))

	(fn is_worker_collect
		(:doc "Distinguish receipt and queue joins, which consume an owner and deliver a fresh array.")
		(params (kind u32)) (returns bool)
		(body (return (bool:or (kind.eq worker_join_kind)
			(kind.eq worker_join_all_kind)))))

	(fn is_direct_call
		(:doc "Identify checked calls with a resolved named callee and a normal ownership argument walk.")
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq 3u32) (call is_worker_launch kind)))))


	(fn keyword_matches
		(:doc `Compare a checked atom to an immutable keyword spelling.`)
		(params (source (shared-array u8)) (start i32) (end i32) (keyword (shared-array u8)))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared source) start end
				(borrow-shared keyword) 0i32 keyword.len))))

	(fn callable_keyword
		(:doc "Match the full inline callable type or function reference spelling.")
		(params (source (shared-array u8)) (node SourceNode)) (returns u32)
		(body
			(let start node/start)
			(let end node/end)
			(let width (end.sub start))
			(if
				(:doc "The type spelling is distinct from the value form.")
				(bool:and (width.eq 7i32)
					(call keyword_matches (borrow-shared source) start end (borrow-shared fn_type_head)))
				(then (return fn_type_kind)))
			(if
				(:doc "Only the exact fn-ref head takes a named function's address.")
				(bool:and (width.eq 6i32)
					(call keyword_matches (borrow-shared source) start end (borrow-shared fn_ref_head)))
				(then (return fn_ref_kind)))
			(return 0u32)))

	(fn array_operation
		(:doc "Look up an operation on an existing array by its unqualified suffix.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Get identifies a checked array element for reading or use as a place.")
				(call keyword_matches (borrow-shared source) start end (borrow-shared array_get_head))
				(then (return 37u32)))
			(if
				(:doc "Set writes an exact element value into writable array storage.")
				(call keyword_matches (borrow-shared source) start end (borrow-shared array_set_head))
				(then (return 40u32)))
			(if
				(:doc "Length reads the element count from a checked array receiver.")
				(call keyword_matches (borrow-shared source) start end (borrow-shared array_len_head))
				(then (return 36u32)))
			(if
				(:doc "A range lends part of the original storage within a borrow.")
				(call keyword_matches (borrow-shared source) start end (borrow-shared array_range_head))
				(then (return 44u32)))
			(if
				(:doc "A bounded copy writes a prefix of an existing array view.")
				(call keyword_matches (borrow-shared source) start end (borrow-shared array_try_copy_head))
				(then (return array_try_copy_kind)))
			(return (call array_growth_operation (borrow-shared source) start end))))

	(fn array_keyword
		(:doc "Recognize array declarations, constructors, and qualified receiver operations.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let prefix_end (start.add 5i32))
			(if
				(:doc "Other keywords do not enter the array namespace.")
				(bool:or (end.lt prefix_end)
					(bool:not (call keyword_matches (borrow-shared source) start prefix_end
						(borrow-shared array_type_head))))
				(then (return 0u32)))
			(if (end.eq prefix_end) (then (return 70u32)))
			(if
				(:doc "Operations must follow the exact namespace separator.")
				(u8:not-eq (source.get prefix_end) 58u8)
				(then (return 0u32)))
			(let suffix prefix_end.inc)
			(if
				(:doc "A typed list initializes one element per operand.")
				(call keyword_matches (borrow-shared source) suffix end (borrow-shared array_new_head))
				(then (return 71u32)))
			(if
				(:doc "A repeat initializer supplies one value for the declared extent.")
				(call keyword_matches (borrow-shared source) suffix end (borrow-shared array_repeat_head))
				(then (return 72u32)))
			(if
				(:doc "Infallible allocation takes an element type followed by a size.")
				(call keyword_matches (borrow-shared source) suffix end (borrow-shared array_alloc_head))
				(then (return 41u32)))
			(if
				(:doc "Fallible allocation takes an element type as well.")
				(call keyword_matches (borrow-shared source) suffix end (borrow-shared array_try_alloc_head))
				(then (return array_try_alloc_kind)))
			(return (call array_operation (borrow-shared source) suffix end))))

	(fn is_fixed_array_type_head
		(:doc `Check whether a source atom introduces a structural array layout.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool:and (node/kind.eq 1u32)
				(call keyword_matches (borrow-shared source) node/start
					node/end (borrow-shared array_type_head))))))

	(let fixed_list_kind 71u32)

	(fn is_fixed_initializer
		(:doc `Identify either typed fixed-array initializer.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq fixed_list_kind) (kind.eq 72u32)))))

	(let pending_exact_move 250u32)
	(let fixed_take_request 43u32)
	(let fixed_subarray_place 254u32)
	(let fixed_owner_take 267u32)
	(let fixed_owner_transfer 268u32)
	(let fixed_owner_borrow 269u32)
	(let fixed_owner_store 270u32)

	(fn is_fixed_access
		(:doc `Identify a checked fixed-array index operation.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (bool:or (kind.eq fixed_owner_take) (kind.eq fixed_owner_borrow))
			(bool:or (kind.eq fixed_subarray_place)
				(bool:or (kind.eq fixed_owner_store)
					(bool:or (kind.eq 73u32) (kind.eq 74u32))))))))

	(fn is_scalar_name
		(:doc `Check that the source operand names an unquoted Wove identifier.`)
		(:pragma (inline always))
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(return (call is_wove_name (borrow-shared source) node))))

	(fn same_name
		(:doc `Compare the original spellings of two checked identifier nodes.`)
		(params (source (shared-array u8)) (left SourceNode) (right SourceNode))
		(returns bool)
		(body
			(return (call same_bytes (borrow-shared source) left/start
				left/end (borrow-shared source) right/start
				right/end))))

	(fn logical_keyword
		(:doc `Recognize the three exact bool operator spellings.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Only a full bool prefix and supported suffix width can make an operator.")
				(bool:or
					(bool:not (bool:or (width.eq 7i32) (width.eq 8i32)))
					(bool:not
						(bool:and
							(call is_three_bytes (borrow-shared source) start 98u8 111u8 111u8)
							(bool:and
								(call is_head_byte (borrow-shared source) start 3i32 108u8)
								(call is_head_byte (borrow-shared source) start 4i32 58u8)))))
				(then (return 0u32)))
			(return (call logical_operation (borrow-shared source)
				(start.add 5i32) (width.sub 5i32)))))

	(fn logical_operation
		(:doc "Look up the complete suffix of a boolean operation.")
		(params (source (shared-array u8)) (mnemonic i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "The two-byte suffix is or.")
				(width.eq 2i32)
				(then
					(if
						(:doc "Match both bytes of the or suffix.")
						(bool:and
							(call is_head_byte (borrow-shared source) mnemonic 0i32 111u8)
							(call is_head_byte (borrow-shared source) mnemonic 1i32 114u8))
						(then (return 31u32)))
					(return 0u32)))
			(if (width.not-eq 3i32) (then (return 0u32)))
			(if
				(:doc "Match and at its full three-byte width.")
				(call is_three_bytes (borrow-shared source) mnemonic 97u8 110u8 100u8)
				(then (return 30u32)))
			(if
				(:doc "Match not at its full three-byte width.")
				(call is_three_bytes (borrow-shared source) mnemonic 110u8 111u8 116u8)
				(then (return 32u32)))
			(return 0u32)))

	(fn scalar_receiver_operation
		(:doc "Resolve the suffix in the canonical namespace of an exact scalar type.")
		(params (source (shared-array u8)) (start i32) (end i32) (type u32))
		(returns u32)
		(body
			(if
				(:doc "Integer operations use their exact width and signedness.")
				(call is_builtin_integer_value type)
				(then
					(let comparison (call integer_comparison_operation (borrow-shared source) start end type (bool false)))
					(if comparison.gtz (then (return comparison)))
					(let bit (call word_bit_operation (borrow-shared source) start end type))
					(if bit.gtz (then (return bit)))
					(let arithmetic (call integer_arithmetic_operation (borrow-shared source) start end type))
					(if arithmetic.gtz (then (return arithmetic)))
					(let checked (call integer_check_suffix (borrow-shared source) start end))
					(if checked.gtz (then (return checked)))))
			(if
				(:doc "Floating operators retain the exact receiver width.")
				(call is_builtin_float type)
				(then
					(let floating (call float_operation (borrow-shared source) start end type))
					(if floating.gtz (then (return floating)))))
			(if
				(:doc "A boolean receiver uses the same short-circuit operators as bool-qualified forms.")
				(type.eq 12u32)
				(then (return (call logical_operation (borrow-shared source) start (end.sub start)))))
			(return (struct:get (call read_value_encoding (borrow-shared source) start end type) kind))))

	(fn floating_operator
		(:doc `Describe the arity and result of a checked floating operator.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(let type (call float_operator_type kind))
			(let slot (call float_operator_slot kind))
			(let-mut result type)
			(let-mut arity 2i32)
			(if (slot.eq 4i32) (then (set arity 1i32)))
			(if (i32:lt 4i32 slot) (then (set result 12u32)))
			(return (struct:new ScalarOperator (operand type) (result result)
				(symbol (call float_operator_symbol slot)) (arity arity)
				(short_circuit (bool false))))))

	(fn scalar_operator
		(:doc `Describe an operator's arity, operand and result types, and meaning in C.

		The operand field applies to every operand. A zero result marks a
		non-operator. The C writer expands the multi-byte comparison markers. Short-circuit operators
		use an explicit branch around the right operand's evaluation.`)
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(if
				(:doc "Float operators use the same eager operand planning as integer operators.")
				(call is_float_operator kind)
				(then (return (call floating_operator kind))))
			(if
				(:doc "Integer comparisons share eager checking for their one or two written operands.")
				(call is_integer_comparison kind)
				(then
					(let-mut arity 2i32)
					(if (call comparison_is_zero kind) (then (set arity 1i32)))
					(return (struct:new ScalarOperator (operand (call comparison_operand_type kind)) (result 12u32)
						(symbol (call comparison_symbol kind)) (arity arity) (short_circuit (bool false))))))
			(let integer (call integer_operator kind))
			(if
				(:doc "Width-specific arithmetic has one exact type for its operands and result.")
				integer/operand.gtz
				(then
					(let-mut arity 2i32)
					(if (call is_integer_step kind) (then (set arity 1i32)))
					(return (struct:new ScalarOperator (operand integer/operand)
						(result integer/operand) (symbol integer/symbol)
						(arity arity) (short_circuit (bool false))))))
			(let bit_count_type (call word_bit_count_type kind))
			(if
				(:doc "Bit counts consume one exact word and produce an i32 count.")
				bit_count_type.gtz
				(then (return (struct:new ScalarOperator (operand bit_count_type) (result 5u32)
					(symbol (call word_bit_count_slot kind)) (arity 1i32) (short_circuit (bool false))))))
			(let mask_type (call word_mask_type kind))
			(if
				(:doc "Bitwise operations preserve their exact operand type, and complement has one operand.")
				mask_type.gtz
				(then
					(let symbol (call word_mask_symbol kind))
					(let-mut arity 2i32)
					(if (symbol.eq 126u8) (then (set arity 1i32)))
					(return (struct:new ScalarOperator (operand mask_type) (result mask_type)
						(symbol symbol) (arity arity) (short_circuit (bool false))))))
			(if
				(:doc "A conjunction guards the right operand with the left value.")
				(kind.eq 30u32)
				(then (return (struct:new ScalarOperator (operand 12u32) (result 12u32) (symbol 38u8)
					(arity 2i32) (short_circuit (bool true))))))
			(if
				(:doc "A disjunction guards the right operand with the negated left value.")
				(kind.eq 31u32)
				(then (return (struct:new ScalarOperator (operand 12u32) (result 12u32) (symbol 124u8)
					(arity 2i32) (short_circuit (bool true))))))
			(if
				(:doc "Negation uses one boolean operand.")
				(kind.eq 32u32)
				(then (return (struct:new ScalarOperator (operand 12u32) (result 12u32) (symbol 33u8)
					(arity 1i32) (short_circuit (bool false))))))
			(return (struct:new ScalarOperator (operand 0u32) (result 0u32) (symbol 0u8) (arity 0i32) (short_circuit (bool false))))))

	(fn borrow_keyword
		(:doc `Read the explicit borrow keywords at their full widths.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Check both explicit reborrows after their common borrow- prefix.")
				(bool:and (bool:or (width.eq 10i32) (width.eq 13i32))
					(bool:and
						(call is_three_bytes (borrow-shared source) start 98u8 111u8 114u8)
						(bool:and
							(call is_three_bytes (borrow-shared source)
								(start.add 3i32) 114u8 111u8 119u8)
							(call is_head_byte (borrow-shared source) start 6i32 45u8))))
				(then
					(let suffix (start.add 7i32))
					(if
						(:doc "The exclusive loan ends in mut.")
						(bool:and (width.eq 10i32)
							(call is_three_bytes (borrow-shared source) suffix 109u8 117u8 116u8))
						(then (return 39u32)))
					(if
						(:doc "The shared loan ends in shared.")
						(bool:and (width.eq 13i32)
							(bool:and
								(call is_three_bytes (borrow-shared source) suffix 115u8 104u8 97u8)
								(call is_three_bytes (borrow-shared source)
									(suffix.add 3i32) 114u8 101u8 100u8)))
						(then (return 35u32)))))
			(return 0u32)))

	(fn is_byte_view_type
		(:doc `Check the two parameter type codes that carry a byte view.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body
			(return (bool:or (type.eq 34u32) (type.eq 38u32)))))

	(fn is_reborrow_keyword
		(:doc `Check the two explicit whole-view call loan codes.`)
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body
			(return (bool:or (kind.eq 35u32) (kind.eq 39u32)))))

	(fn record_operation
		(:doc "Look up an operation on an existing record by its unqualified suffix.")
		(params (source (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(if
				(:doc "Match get for a field value or place.")
				(bool:and (i32:eq (end.sub start) 3i32)
					(call is_three_bytes (borrow-shared source) start 103u8 101u8 116u8))
				(then (return 52u32)))
			(return 0u32)))

	(fn record_keyword
		(:doc `Recognize record declarations, field lists, construction, and lookup.`)
		(params (source (shared-array u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Declaration and field-list keywords each have two groups of three bytes.")
				(width.eq 6i32)
				(then
					(let suffix (start.add 3i32))
					(if
						(:doc "Match the struct keyword.")
						(bool:and
							(call is_three_bytes (borrow-shared source) start 115u8 116u8 114u8)
							(call is_three_bytes (borrow-shared source) suffix 117u8 99u8 116u8))
						(then (return 48u32)))
					(if
						(:doc "Match the fields keyword.")
						(bool:and
							(call is_three_bytes (borrow-shared source) start 102u8 105u8 101u8)
							(call is_three_bytes (borrow-shared source) suffix 108u8 100u8 115u8))
						(then (return 49u32)))
					(return 0u32)))
			(if
				(:doc "A qualified operation starts with the complete struct namespace.")
				(bool:or
					(width.lt 8i32)
					(bool:not (bool:and
						(call is_three_bytes (borrow-shared source) start 115u8 116u8 114u8)
						(bool:and
							(call is_three_bytes (borrow-shared source) (start.add 3i32) 117u8 99u8 116u8)
							(call is_head_byte (borrow-shared source) start 6i32 58u8)))))
				(then (return 0u32)))
			(let suffix (start.add 7i32))
			(if
				(:doc "Match new for construction in source field order.")
				(bool:and (width.eq 10i32)
