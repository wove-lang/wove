		(body
			(return (struct:new EntryRead (operand operand) (error error)
				(start node/start) (end node/end) (related -1i32)))))

	(fn entry_form
		(:doc `Check the expected tag and ordinary metadata at a signature or expression form.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (tag u32) (error u32))
		(returns EntryRead)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let actual (call entry_keyword (borrow-shared source) (borrow-shared nodes) parts/head))
			(let-mut matching (actual.eq tag))
			(if
				(:doc "The operation planner selects the namespace before using its canonical form reader.")
				(actual.eq receiver_operation_kind)
				(then
					(let receiver (nodes.get parts/operands))
					(let start receiver/end.inc)
					(let end (struct:get (nodes.get parts/head) end))
					(set matching (tag.gtz.and
						(bool:or (tag.eq (call array_operation (borrow-shared source) start end))
							(bool:or (tag.eq (call record_operation (borrow-shared source) start end))
								(bool:or (tag.eq (call worker_operation (borrow-shared source) start end))
									(bool:or (tag.eq (call owner_operation (borrow-shared source) start end))
										(bool:or (tag.eq (call optional_operation (borrow-shared source) start end))
											(tag.eq (call native_vector_operation (borrow-shared source) start end)))))))))))
			(if
				(:doc "An unmatched operation keeps the original form's span.")
				matching.not
				(then (return (call entry_at node -1i32 error))))
			(return (call entry_operands (borrow-shared source) (borrow-shared nodes) node parts))))

	(fn entry_operands
		(:doc "Read operands and check metadata after resolving the canonical operation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (parts FormParts))
		(returns EntryRead)
		(body
			(let metadata (call validate_form_metadata (borrow-shared source) (borrow-shared nodes)
				node parts))
			(if
				(:doc "Known selection pragmas cannot guard operands or body forms.")
				metadata/error.gtz
				(then (return (struct:new EntryRead (operand -1i32)
					(start metadata/start) (end metadata/end)
					(error metadata/error) (related -1i32)))))
			(return (call entry_at node parts/operands 0u32))))

	(fn statement_error
		(:doc `Keep the original syntax diagnostic when no statement can be read.`)
		(params (problem EntryRead))
		(returns StatementRead)
		(body
			(return (struct:new StatementRead (kind 0u32) (binding -1i32) (value -1i32)
				(start problem/start) (end problem/end)
				(error problem/error)))))

	(fn read_statement
		(:doc `Locate the statement value or condition. Calls and stores can be their own operation roots.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (index i32) (tag u32))
		(returns StatementRead)
		(body
			(if
				(:doc "The expression planner checks the operands of a standalone call or store.")
				(bool:or (tag.eq 9u32)
					(bool:or (tag.eq worker_push_kind)
						(bool:or (tag.eq 40u32) (call is_array_growth_statement tag))))
				(then (return (struct:new StatementRead (kind tag) (binding -1i32) (value index)
					(start node/start) (end node/end) (error 0u32)))))
			(let returning (tag.eq 7u32))
			(let iterating (tag.eq for_statement))
			(let loop_exit (call is_loop_exit tag))
			(let control (bool:or (tag.eq match_statement)
				(bool:or (tag.eq 22u32) (tag.eq 25u32))))
			(if
				(:doc "Reject unsupported statements at their complete originating span.")
				(bool:and (bool:not (iterating.or (loop_exit.or (returning.or control))))
					(bool:or (tag.lt 15u32) (u32:lt 17u32 tag)))
				(then (return (call statement_error (call entry_at node -1i32 24u32)))))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node tag 24u32))
			(if
				(:doc "Known selection pragmas cannot alter a statement.")
				form/error.gtz
				(then (return (call statement_error form))))
			(if
				(:doc "A return ends the sequence of active statements in its block.")
				returning
				(then
					(let next (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
						node/next_sibling))
					(if
						(:doc "Point at the first active statement after the terminal return.")
						next.not-ltz
						(then (return (call statement_error
							(call entry_at (nodes.get next) -1i32 24u32)))))))
			(if
				(:doc "Loop exits take no operands.")
				loop_exit
				(then
					(if
						(:doc "Report an operand on the complete loop exit statement.")
						(i32:lt -1i32 form/operand)
						(then (return (call statement_error (call entry_at node -1i32 24u32)))))
					(return (struct:new StatementRead (kind tag) (binding -1i32) (value -1i32)
						(start node/start) (end node/end) (error 0u32)))))
			(let-mut value form/operand)
			(if
				(:doc "Keep the iteration binder and source separate from the body.")
				iterating
				(then
					(if value.ltz (then (return (call statement_error (call entry_at node -1i32 24u32)))))
					(let iterator (struct:get (nodes.get value) next_sibling))
					(if iterator.ltz (then (return (call statement_error (call entry_at node -1i32 24u32)))))
					(return (struct:new StatementRead (kind tag) (binding value) (value iterator)
						(start node/start) (end node/end) (error 0u32)))))
			(if
				(:doc "The control-flow reader locates the condition or subject before checking its arms.")
				control
				(then
					(if
						(:doc "An if or while requires a condition before its blocks.")
						value.ltz
						(then (return (call statement_error (call entry_at node -1i32 24u32)))))
					(return (struct:new StatementRead (kind tag) (binding -1i32) (value value)
						(start node/start) (end node/end) (error 0u32)))))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let-mut binding parts/name)
			(if
				(:doc "Assignments keep their target in the ordinary operand list.")
				(bool:and (tag.eq 17u32) value.not-ltz)
				(then
					(set binding value)
					(set value (struct:get (nodes.get binding) next_sibling))))
			(if
				(:doc "A return can omit its value. A present value must be the final operand.")
				(bool:or (returning.not.and value.ltz)
					(value.not-ltz.and
						(i32:not-ltz (call next_form_operand (borrow-shared source) (borrow-shared nodes) (nodes.get value)))))
				(then (return (call statement_error (call entry_at node -1i32 24u32)))))
			(return (struct:new StatementRead (kind tag) (binding binding) (value value)
				(start node/start) (end node/end) (error 0u32)))))

	(fn scalar_type
		(:doc `Return an exact scalar type keyword or zero when the atom names another construct.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32))
		(returns u32)
		(body
			(if
				(:doc "A substituted builtin remains scalar in fixed arrays and exact signatures.")
				(i32:lt -1i32 index)
				(then
					(let node (nodes.get index))
					(let type node/generic_value)
					(if
						(:doc "A nominal argument still resolves through the full value-type checker.")
						(bool:and (node/generic_kind.eq checked_type_operand) (call is_builtin_scalar type))
						(then (return type)))))
			(let tag (call entry_keyword (borrow-shared source) (borrow-shared nodes) index))
			(if
				(:doc "Only the primitive copyable types are scalar keywords.")
				(call is_builtin_scalar tag)
				(then (return tag)))
			(return 0u32)))

)
