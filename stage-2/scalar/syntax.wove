(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the source syntax for scalar C emission.

	Use the original tree links and source spans for signature and expression
	checks. Normalize literal spellings before lowering them to C.`)
	scalar_syntax

	(use wove-file "../text/decimal.wove" (only read_decimal_digits))
	(use wove-file "../source/scan.wove" (only is_head_byte (type SourceNode)))
	(use wove-file "../source/module.wove" (only is_three_bytes form_parts select_form))

	(struct EntryRead (fields (operand i32) (start i32) (end i32) (error u32) (related i32)))
	(struct StatementRead (fields (kind u32) (binding i32) (value i32) (start i32) (end i32) (error u32)))
	(struct ScalarOperator (fields (operand u32) (result u32) (symbol u8) (arity i32) (short_circuit bool)))
	(struct DecimalSpelling (fields (digits i32) (negative bool)))

	(fn
		(:doc `Check the full nine-byte .wrapping suffix after an arithmetic mnemonic.`)
		(:pragma (inline always))
		is_wrapping_suffix
		(params (source (shared-slice u8)) (start i32))
		(returns bool)
		(body
			(return (bool.and
				(call is_three_bytes (borrow-shared (local source)) (local start) (u8 46) (u8 119) (u8 114))
				(bool.and
					(call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 3)) (u8 97) (u8 112) (u8 112))
					(call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 6)) (u8 105) (u8 110) (u8 103)))))))

	(fn
		(:doc `Read an exact two-byte comparison mnemonic after its scalar prefix.`)
		comparison_suffix
		(params (source (shared-slice u8)) (start i32) (equal u32))
		(returns u32)
		(body
			(let first (slice.load (local source) (local start)))
			(let second (slice.load (local source) (i32.add.wrapping (local start) (i32 1))))
			(if
				(:doc "Recognize the equality suffix.")
				(bool.and (u8.eq (local first) (u8 101)) (u8.eq (local second) (u8 113)))
				(then (return (local equal))))
			(if
				(:doc "The less-than kind follows the equality kind for each scalar type.")
				(bool.and (u8.eq (local first) (u8 108)) (u8.eq (local second) (u8 116)))
				(then (return (u32.add.wrapping (local equal) (u32 1)))))
			(return (u32 0))))

	(fn
		(:doc `Read a comparison keyword for i32, u8, or u32.`)
		comparison_keyword
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Byte comparisons are the only comparisons with a three-byte prefix.")
				(bool.and (i32.eq (local width) (i32 5))
					(call is_three_bytes (borrow-shared (local source)) (local start) (u8 117) (u8 56) (u8 46)))
				(then (return (call comparison_suffix (borrow-shared (local source))
					(i32.add.wrapping (local start) (i32 3)) (u32 26)))))
			(if
				(:doc "Both word comparisons have six bytes and share the 32. spelling.")
				(bool.or (bool.not (i32.eq (local width) (i32 6)))
					(bool.not (call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 1)) (u8 51) (u8 50) (u8 46))))
				(then (return (u32 0))))
			(let prefix (slice.load (local source) (local start)))
			(let mnemonic (i32.add.wrapping (local start) (i32 4)))
			(if
				(:doc "The i32 prefix selects signed comparisons.")
				(u8.eq (local prefix) (u8 105))
				(then (return (call comparison_suffix (borrow-shared (local source)) (local mnemonic) (u32 18)))))
			(if
				(:doc "The u32 prefix selects unsigned comparisons.")
				(u8.eq (local prefix) (u8 117))
				(then (return (call comparison_suffix (borrow-shared (local source)) (local mnemonic) (u32 28)))))
			(return (u32 0))))

	(fn
		(:doc `Read the operation code from a complete signed or unsigned 32-bit wrapping keyword.`)
		wrapping_keyword
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "The wrapping forms have a fixed width and a common 32. suffix after their first letter.")
				(bool.or (bool.not (i32.eq (local width) (i32 16)))
					(bool.not (call is_three_bytes (borrow-shared (local source))
						(i32.add.wrapping (local start) (i32 1)) (u8 51) (u8 50) (u8 46))))
				(then (return (u32 0))))
			(let prefix (slice.load (local source) (local start)))
			(let unsigned (u8.eq (local prefix) (u8 117)))
			(if
				(:doc "The leading letter selects signed or unsigned arithmetic.")
				(bool.not (bool.or (local unsigned) (u8.eq (local prefix) (u8 105))))
				(then (return (u32 0))))
			(if
				(:doc "Only the explicit wrapping arithmetic spelling is supported.")
				(bool.not (call is_wrapping_suffix (borrow-shared (local source)) (i32.add.wrapping (local start) (i32 7))))
				(then (return (u32 0))))
			(let-mut addition (u32 20))
			(if
				(:doc "The unsigned addition and subtraction codes form their own consecutive pair.")
				(local unsigned)
				(then (set (local addition) (u32 46))))
			(let mnemonic (i32.add.wrapping (local start) (i32 4)))
			(if
				(:doc "Recognize add at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 97) (u8 100) (u8 100))
				(then (return (local addition))))
			(if
				(:doc "The subtraction code follows the matching addition code.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 115) (u8 117) (u8 98))
				(then (return (u32.add.wrapping (local addition) (u32 1)))))
			(return (u32 0))))

	(fn
		(:doc `Recognize the three exact bool operator spellings.`)
		logical_keyword
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Only a full bool prefix and supported suffix width can make an operator.")
				(bool.or
					(bool.not (bool.or (i32.eq (local width) (i32 7)) (i32.eq (local width) (i32 8))))
					(bool.not
						(bool.and
							(call is_three_bytes (borrow-shared (local source)) (local start) (u8 98) (u8 111) (u8 111))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 108))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 46))))))
				(then (return (u32 0))))
			(let mnemonic (i32.add.wrapping (local start) (i32 5)))
			(if
				(:doc "The two-byte suffix is or.")
				(i32.eq (local width) (i32 7))
				(then
					(if
						(:doc "Match both bytes of the or suffix.")
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local mnemonic) (i32 0) (u8 111))
							(call is_head_byte (borrow-shared (local source)) (local mnemonic) (i32 1) (u8 114)))
						(then (return (u32 31))))
					(return (u32 0))))
			(if
				(:doc "Match and at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 97) (u8 110) (u8 100))
				(then (return (u32 30))))
			(if
				(:doc "Match not at its full three-byte width.")
				(call is_three_bytes (borrow-shared (local source)) (local mnemonic) (u8 110) (u8 111) (u8 116))
				(then (return (u32 32))))
			(return (u32 0))))

	(fn
		(:doc `Describe an operator's arity, operand and result types, and meaning in C.

		The operand field applies to every operand. A zero result marks a
		non-operator. Equality emits two equals bytes. Short-circuit operators
		use an explicit branch around the right operand's evaluation.`)
		scalar_operator
		(params (kind u32))
		(returns ScalarOperator)
		(body
			(let signed (bool.or (u32.eq (local kind) (u32 20)) (u32.eq (local kind) (u32 21))))
			(let unsigned (bool.or (u32.eq (local kind) (u32 46)) (u32.eq (local kind) (u32 47))))
			(if
				(:doc "Wrapping arithmetic uses the same exact type for both operands and the result.")
				(bool.or (local signed) (local unsigned))
				(then
					(let-mut type (u32 5))
					(if
						(:doc "Unsigned operations keep the u32 type.")
						(local unsigned)
						(then (set (local type) (u32 11))))
					(let-mut symbol (u8 43))
					(if
						(:doc "Both subtraction kinds use the minus operator.")
						(bool.or (u32.eq (local kind) (u32 21)) (u32.eq (local kind) (u32 47)))
						(then (set (local symbol) (u8 45))))
					(return (record.make ScalarOperator (operand (local type)) (result (local type))
						(symbol (local symbol)) (arity (i32 2)) (short_circuit (bool false))))))
			(if
				(:doc "A conjunction guards the right operand with the left value.")
				(u32.eq (local kind) (u32 30))
				(then (return (record.make ScalarOperator (operand (u32 12)) (result (u32 12)) (symbol (u8 38))
					(arity (i32 2)) (short_circuit (bool true))))))
			(if
				(:doc "A disjunction guards the right operand with the negated left value.")
				(u32.eq (local kind) (u32 31))
				(then (return (record.make ScalarOperator (operand (u32 12)) (result (u32 12)) (symbol (u8 124))
					(arity (i32 2)) (short_circuit (bool true))))))
			(if
				(:doc "Negation uses one boolean operand.")
				(u32.eq (local kind) (u32 32))
				(then (return (record.make ScalarOperator (operand (u32 12)) (result (u32 12)) (symbol (u8 33))
					(arity (i32 1)) (short_circuit (bool false))))))
			(let-mut operand (u32 0))
			(if
				(:doc "The ordered pairs of comparison kinds share their operand type.")
				(bool.or (u32.eq (local kind) (u32 18)) (u32.eq (local kind) (u32 19)))
				(then (set (local operand) (u32 5))))
			(if
				(:doc "Both byte comparisons require exact u8 operands.")
				(bool.or (u32.eq (local kind) (u32 26)) (u32.eq (local kind) (u32 27)))
				(then (set (local operand) (u32 10))))
			(if
				(:doc "Both unsigned word comparisons require exact u32 operands.")
				(bool.or (u32.eq (local kind) (u32 28)) (u32.eq (local kind) (u32 29)))
				(then (set (local operand) (u32 11))))
			(if
				(:doc "Other expression kinds have no binary operator.")
				(u32.eq (local operand) (u32 0))
				(then (return (record.make ScalarOperator (operand (u32 0)) (result (u32 0)) (symbol (u8 0)) (arity (i32 0)) (short_circuit (bool false))))))
			(let-mut symbol (u8 60))
			(if
				(:doc "The equality kind in each pair selects the equals symbol.")
				(bool.or (u32.eq (local kind) (u32 18))
					(bool.or (u32.eq (local kind) (u32 26)) (u32.eq (local kind) (u32 28))))
				(then (set (local symbol) (u8 61))))
			(return (record.make ScalarOperator (operand (local operand)) (result (u32 12)) (symbol (local symbol))
				(arity (i32 2)) (short_circuit (bool false))))))

	(fn
		(:doc `Read the shared byte-slice type, reborrow, and access keywords at their full widths.`)
		slice_keyword
		(params (source (shared-slice u8)) (start i32) (width i32))
		(returns u32)
		(body
			(if
				(:doc "Match the three groups of the mut-slice spelling.")
				(bool.and (i32.eq (local width) (i32 9))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 109) (u8 117) (u8 116))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 45) (u8 115) (u8 108))
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 6)) (u8 105) (u8 99) (u8 101)))))
				(then (return (u32 38))))
			(if
				(:doc "A shared-slice type has the shared- prefix and the slice suffix.")
				(bool.and (i32.eq (local width) (i32 12))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 115) (u8 104) (u8 97))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 114) (u8 101) (u8 100))
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 6)) (u8 45) (u8 115) (u8 108))
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 9)) (u8 105) (u8 99) (u8 101))))))
				(then (return (u32 34))))
			(if
				(:doc "Check both explicit reborrows after their common borrow- prefix.")
				(bool.and (bool.or (i32.eq (local width) (i32 10)) (i32.eq (local width) (i32 13)))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 98) (u8 111) (u8 114))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 114) (u8 111) (u8 119))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 6) (u8 45)))))
				(then
					(let suffix (i32.add.wrapping (local start) (i32 7)))
					(if
						(:doc "The exclusive loan ends in mut.")
						(bool.and (i32.eq (local width) (i32 10))
							(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 109) (u8 117) (u8 116)))
						(then (return (u32 39))))
					(if
						(:doc "The shared loan ends in shared.")
						(bool.and (i32.eq (local width) (i32 13))
							(bool.and
								(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 115) (u8 104) (u8 97))
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local suffix) (i32 3)) (u8 114) (u8 101) (u8 100))))
						(then (return (u32 35))))))
			(if
				(:doc "Access forms have a common slice. prefix and a bounded suffix.")
				(bool.or (bool.or (i32.lt (local width) (i32 9)) (i32.lt (i32 11) (local width)))
					(bool.not (bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 115) (u8 108) (u8 105))
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) (i32 3)) (u8 99) (u8 101) (u8 46)))))
				(then (return (u32 0))))
			(let suffix (i32.add.wrapping (local start) (i32 6)))
			(if
				(:doc "Match the three-byte len suffix.")
				(bool.and (i32.eq (local width) (i32 9))
					(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 108) (u8 101) (u8 110)))
				(then (return (u32 36))))
			(if
				(:doc "Match the four-byte load suffix.")
				(bool.and (i32.eq (local width) (i32 10))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 108) (u8 111) (u8 97))
						(call is_head_byte (borrow-shared (local source)) (local suffix) (i32 3) (u8 100))))
				(then (return (u32 37))))
			(if
				(:doc "Match the five-byte store suffix.")
				(bool.and (i32.eq (local width) (i32 11))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 115) (u8 116) (u8 111))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local suffix) (i32 3) (u8 114))
							(call is_head_byte (borrow-shared (local source)) (local suffix) (i32 4) (u8 101)))))
				(then (return (u32 40))))
			(if
				(:doc "Match the five-byte range suffix after slice.")
				(bool.and (i32.eq (local width) (i32 11))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local suffix) (u8 114) (u8 97) (u8 110))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local suffix) (i32 3) (u8 103))
							(call is_head_byte (borrow-shared (local source)) (local suffix) (i32 4) (u8 101)))))
				(then (return (u32 44))))
			(return (u32 0))))

	(fn
		(:doc `Check the two parameter type codes that carry a byte view.`)
		(:pragma (inline always))
		is_byte_view_type
		(params (type u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local type) (u32 34)) (u32.eq (local type) (u32 38))))))

	(fn
		(:doc `Check the two explicit whole-view call loan codes.`)
		(:pragma (inline always))
		is_reborrow_keyword
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local kind) (u32 35)) (u32.eq (local kind) (u32 39))))))

	(fn
		(:doc `Recognize the exact keywords of the scalar entry grammar.

		Return 1 through 9 for fn, main, params, returns, i32, body, return,
		local, and call. Return 10 through 14 for u8, u32, bool, true, and
		false. Return 15 through 17 for let, let-mut, and set, and 18 through
		21 for i32.eq, i32.lt, i32.add.wrapping, and i32.sub.wrapping.
		Return 22 through 25 for if, then, else, and while, and 26 through
		29 for u8.eq, u8.lt, u32.eq, and u32.lt. Return 30 through 32 for
		bool.and, bool.or, and bool.not, and 33 for int.convert. Return
		34 through 37 for shared-slice, borrow-shared, slice.len, and
		slice.load. Return 38 through 40 for mut-slice, borrow-mut, and
		slice.store, and 41 for array.alloc. The move and slice.range
		keywords use 43 and 44. Return 46 or 47 for u32.add.wrapping or
		u32.sub.wrapping. Other nodes and absent indices return 0.`)
		entry_keyword
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns u32)
		(body
			(if
				(:doc "An absent node has no keyword spelling.")
				(i32.lt (local index) (i32 0))
				(then (return (u32 0))))
			(let node (slice.load (local nodes) (local index)))
			(if
				(:doc "Only a bare atom can be a keyword.")
				(bool.not (u32.eq (record.get (local node) kind) (u32 1)))
				(then (return (u32 0))))
			(let start (record.get (local node) start))
			(let width (i32.sub.wrapping (record.get (local node) end) (local start)))
			(if
				(:doc "Match the entire fn keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 2))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 102))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 110))))
				(then (return (u32 1))))
			(if
				(:doc "Match the entire main keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 4))
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) (u8 109) (u8 97) (u8 105))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 110))))
				(then (return (u32 2))))
			(if
				(:doc "Match the entire params keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 6))
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) (u8 112) (u8 97) (u8 114))
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) (i32 3)) (u8 97) (u8 109) (u8 115))))
				(then (return (u32 3))))
			(if
				(:doc "Match the entire returns keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 7))
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) (u8 114) (u8 101) (u8 116))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 117) (u8 114) (u8 110))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 6) (u8 115)))))
				(then (return (u32 4))))
			(if
				(:doc "Match the entire i32 keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 3))
					(call is_three_bytes (borrow-shared (local source))
						(local start) (u8 105) (u8 51) (u8 50)))
				(then (return (u32 5))))
			(if
				(:doc "Match the entire body keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 4))
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) (u8 98) (u8 111) (u8 100))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 121))))
				(then (return (u32 6))))
			(if
				(:doc "Match the entire return keyword before returning its code.")
				(bool.and
					(i32.eq (local width) (i32 6))
					(bool.and
						(call is_three_bytes (borrow-shared (local source))
							(local start) (u8 114) (u8 101) (u8 116))
						(call is_three_bytes (borrow-shared (local source))
							(i32.add.wrapping (local start) (i32 3)) (u8 117) (u8 114) (u8 110))))
				(then (return (u32 7))))
			(if
				(:doc "Match the entire local keyword.")
				(bool.and (i32.eq (local width) (i32 5))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 108))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 111))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 99))
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 97))
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 108)))))))
				(then (return (u32 8))))
			(if
				(:doc "Match the entire call keyword.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 99))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 97))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 108))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 108))))))
				(then (return (u32 9))))
			(if
				(:doc "Match the entire u8 keyword.")
				(bool.and (i32.eq (local width) (i32 2))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 117))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 56))))
				(then (return (u32 10))))
			(if
				(:doc "Match the entire u32 keyword.")
				(bool.and (i32.eq (local width) (i32 3))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 117))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 51))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 50)))))
				(then (return (u32 11))))
			(if
				(:doc "Match the entire bool keyword.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 98))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 111))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 111))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 108))))))
				(then (return (u32 12))))
			(if
				(:doc "Match the entire true keyword.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 116))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 114))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 117))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 101))))))
				(then (return (u32 13))))
			(if
				(:doc "Match the entire false keyword.")
				(bool.and (i32.eq (local width) (i32 5))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 102))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 97))
							(bool.and
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 108))
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 115))
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 101)))))))
				(then (return (u32 14))))
			(if
				(:doc "Let and let-mut share a prefix but require their full spelling.")
				(bool.and (bool.or (i32.eq (local width) (i32 3)) (i32.eq (local width) (i32 7)))
					(call is_three_bytes (borrow-shared (local source)) (local start) (u8 108) (u8 101) (u8 116)))
				(then
					(if
						(:doc "The short spelling declares an immutable local.")
						(i32.eq (local width) (i32 3))
						(then (return (u32 15))))
					(if
						(:doc "The -mut suffix declares a writable local.")
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 45))
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 4)) (u8 109) (u8 117) (u8 116)))
						(then (return (u32 16))))))
			(if
				(:doc "Match the entire set keyword.")
				(bool.and (i32.eq (local width) (i32 3))
					(call is_three_bytes (borrow-shared (local source)) (local start) (u8 115) (u8 101) (u8 116)))
				(then (return (u32 17))))
			(if
				(:doc "Match the complete if keyword.")
				(bool.and (i32.eq (local width) (i32 2))
					(bool.and
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 105))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 102))))
				(then (return (u32 22))))
			(if
				(:doc "Match the complete then keyword.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 116) (u8 104) (u8 101))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 110))))
				(then (return (u32 23))))
			(if
				(:doc "Match the complete else keyword.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 101) (u8 108) (u8 115))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 101))))
				(then (return (u32 24))))
			(if
				(:doc "Match the complete while keyword.")
				(bool.and (i32.eq (local width) (i32 5))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 119) (u8 104) (u8 105))
						(bool.and
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 108))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 101)))))
				(then (return (u32 25))))
			(if
				(:doc "Match all eleven bytes of int.convert before reading its target.")
				(bool.and (i32.eq (local width) (i32 11))
					(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) (u8 105) (u8 110) (u8 116))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 46) (u8 99) (u8 111))
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 6)) (u8 110) (u8 118) (u8 101))
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 9) (u8 114))
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 10) (u8 116)))))))
				(then (return (u32 33))))
			(if
				(:doc "Match the complete move keyword before checking other compound spellings.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 109) (u8 111) (u8 118))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 101))))
				(then (return (u32 43))))
			(let comparison (call comparison_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Return a complete comparison keyword before checking wrapping arithmetic.")
				(u32.lt (u32 0) (local comparison))
				(then (return (local comparison))))
			(let logical (call logical_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "A complete bool connective selects its logical evaluation.")
				(u32.lt (u32 0) (local logical))
				(then (return (local logical))))
			(if
				(:doc "Check the complete byte allocation keyword before slice operations.")
				(bool.and (i32.eq (local width) (i32 11))
					(bool.and
						(call is_three_bytes (borrow-shared (local source)) (local start) (u8 97) (u8 114) (u8 114))
						(bool.and
							(call is_three_bytes (borrow-shared (local source))
								(i32.add.wrapping (local start) (i32 3)) (u8 97) (u8 121) (u8 46))
							(bool.and
								(call is_three_bytes (borrow-shared (local source))
									(i32.add.wrapping (local start) (i32 6)) (u8 97) (u8 108) (u8 108))
								(bool.and
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 9) (u8 111))
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 10) (u8 99)))))))
				(then (return (u32 41))))
			(let slice (call slice_keyword (borrow-shared (local source)) (local start) (local width)))
			(if
				(:doc "Recognize exact slice and shared-reborrow spellings before wrapping arithmetic.")
				(u32.lt (u32 0) (local slice))
				(then (return (local slice))))
			(return (call wrapping_keyword (borrow-shared (local source)) (local start) (local width)))))

	(fn
		(:doc `Associate an entry-reader result with its original source node.`)
		entry_at
		(params (node SourceNode) (operand i32) (error u32))
		(returns EntryRead)
		(body
			(return (record.make EntryRead (operand (local operand)) (error (local error))
				(start (record.get (local node) start)) (end (record.get (local node) end)) (related (i32 -1))))))

	(fn
		(:doc `Check the expected tag and ordinary metadata at a signature or expression form.`)
		entry_form
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (tag u32) (error u32))
		(returns EntryRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(if
				(:doc "An atom or a different form tag keeps the caller's contextual diagnostic.")
				(bool.not (u32.eq
					(call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head))
					(local tag)))
				(then (return (call entry_at (local node) (i32 -1) (local error)))))
			(let metadata (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts) (bool false)))
			(if
				(:doc "Known selection pragmas cannot guard operands or body forms.")
				(u32.lt (u32 0) (record.get (local metadata) error))
				(then (return (record.make EntryRead (operand (i32 -1))
					(start (record.get (local metadata) start)) (end (record.get (local metadata) end))
					(error (record.get (local metadata) error)) (related (i32 -1))))))
			(return (call entry_at (local node) (record.get (local parts) operands) (u32 0)))))

	(fn
		(:doc `Keep the original syntax diagnostic when no statement can be read.`)
		statement_error
		(params (problem EntryRead))
		(returns StatementRead)
		(body
			(return (record.make StatementRead (kind (u32 0)) (binding (i32 -1)) (value (i32 -1))
				(start (record.get (local problem) start)) (end (record.get (local problem) end))
				(error (record.get (local problem) error))))))

	(fn
		(:doc `Locate the statement value or condition. A slice store is its own operation root.`)
		read_statement
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns StatementRead)
		(body
			(let node (slice.load (local nodes) (local index)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (record.get (local parts) head)))
			(if
				(:doc "The slice operation planner checks the store form and all three operands.")
				(u32.eq (local tag) (u32 40))
				(then (return (record.make StatementRead (kind (local tag)) (binding (i32 -1)) (value (local index))
					(start (record.get (local node) start)) (end (record.get (local node) end)) (error (u32 0))))))
			(let returning (u32.eq (local tag) (u32 7)))
			(let conditional (bool.or (u32.eq (local tag) (u32 22)) (u32.eq (local tag) (u32 25))))
			(if
				(:doc "Reject unsupported statements at their complete originating span.")
				(bool.and (bool.not (bool.or (local returning) (local conditional)))
					(bool.or (u32.lt (local tag) (u32 15)) (u32.lt (u32 17) (local tag))))
				(then (return (call statement_error (call entry_at (local node) (i32 -1) (u32 24))))))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local tag) (u32 24)))
			(if
				(:doc "Known selection pragmas cannot alter a statement.")
				(u32.lt (u32 0) (record.get (local form) error))
				(then (return (call statement_error (local form)))))
			(let next (record.get (local node) next_sibling))
			(if
				(:doc "Point at the first statement after the terminal return.")
				(bool.and (local returning) (bool.not (i32.lt (local next) (i32 0))))
				(then (return (call statement_error
					(call entry_at (slice.load (local nodes) (local next)) (i32 -1) (u32 24))))))
			(let-mut value (record.get (local form) operand))
			(if
				(:doc "The control-flow reader checks the nested blocks separately after locating the condition.")
				(local conditional)
				(then
					(if
						(:doc "An if or while requires a condition before its blocks.")
						(i32.lt (local value) (i32 0))
						(then (return (call statement_error (call entry_at (local node) (i32 -1) (u32 24))))))
					(return (record.make StatementRead (kind (local tag)) (binding (i32 -1)) (value (local value))
						(start (record.get (local node) start)) (end (record.get (local node) end)) (error (u32 0))))))
			(let-mut binding (i32 -1))
			(if
				(:doc "A declaration or assignment supplies a name or target before its value.")
				(bool.and (bool.not (local returning)) (bool.not (i32.lt (local value) (i32 0))))
				(then
					(set (local binding) (local value))
					(set (local value) (record.get (slice.load (local nodes) (local binding)) next_sibling))))
			(if
				(:doc "Every statement requires exactly one value in its final operand.")
				(bool.or (i32.lt (local value) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local value)) next_sibling) (i32 0))))
				(then (return (call statement_error (call entry_at (local node) (i32 -1) (u32 24))))))
			(return (record.make StatementRead (kind (local tag)) (binding (local binding)) (value (local value))
				(start (record.get (local node) start)) (end (record.get (local node) end)) (error (u32 0))))))

	(fn
		(:doc `Return an exact scalar type keyword or zero when the atom names another construct.`)
		scalar_type
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns u32)
		(body
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))
			(if
				(:doc "The scalar syntax supports i32, u8, u32, and bool.")
				(bool.or (u32.eq (local tag) (u32 5))
					(bool.and (u32.lt (u32 9) (local tag)) (u32.lt (local tag) (u32 13))))
				(then (return (local tag))))
			(return (u32 0))))

	(fn
		(:doc `Read a scalar parameter or byte slice, retaining any type operand diagnostic.`)
		read_parameter_type
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns EntryRead)
		(body
			(let node (slice.load (local nodes) (local index)))
			(let scalar (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))
			(if
				(:doc "Keep scalar signatures on their existing exact type codes.")
				(u32.lt (u32 0) (local scalar))
				(then (return (call entry_at (local node) (int.convert i32 (local scalar)) (u32 0)))))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let type (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
				(record.get (local parts) head)))
			(if
				(:doc "Both access modes have distinct parameter type codes.")
				(bool.not (call is_byte_view_type (local type)))
				(then (return (call entry_at (local node) (i32 -1) (u32 23)))))
			(let view (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local type) (u32 23)))
			(if
				(:doc "Forward a malformed view or invalid metadata at its original span.")
				(u32.lt (u32 0) (record.get (local view) error))
				(then (return (local view))))
			(let element (record.get (local view) operand))
			(if
				(:doc "This slice type needs exactly one element type.")
				(bool.or (i32.lt (local element) (i32 0))
					(bool.not (i32.lt (record.get (slice.load (local nodes) (local element)) next_sibling) (i32 0))))
				(then (return (call entry_at (local node) (i32 -1) (u32 23)))))
			(if
				(:doc "Both byte-slice access modes require u8 elements.")
				(bool.not (u32.eq (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local element)) (u32 10)))
				(then (return (call entry_at (slice.load (local nodes) (local element)) (i32 -1) (u32 23)))))
			(return (call entry_at (local node) (int.convert i32 (local type)) (u32 0)))))

	(fn
		(:doc `Validate a decimal scalar and locate its C-safe significant digits.

		Reject any nondecimal bytes or magnitudes above its exact type limit. Retain one
		digit for zero and emit a minus only for a nonzero negative value.`)
		decimal_scalar
		(params (source (shared-slice u8)) (node SourceNode) (type u32))
		(returns DecimalSpelling)
		(body
			(let invalid (record.make DecimalSpelling (digits (i32 -1)) (negative (bool false))))
			(if
				(:doc "A decimal literal must be a bare atom.")
				(bool.not (u32.eq (record.get (local node) kind) (u32 1)))
				(then (return (local invalid))))
			(let start (record.get (local node) start))
			(let end (record.get (local node) end))
			(let negative (u8.eq (slice.load (local source) (local start)) (u8 45)))
			(let-mut cursor (local start))
			(let-mut limit (u32 214748364))
			(let-mut last_digit (u32 7))
			(if
				(:doc "Unsigned literals are nonnegative and use their own upper bound.")
				(bool.not (u32.eq (local type) (u32 5)))
				(then
					(set (local last_digit) (u32 5))
					(set (local limit) (u32 429496729))
					(if
						(:doc "A byte is bounded by 255.")
						(u32.eq (local type) (u32 10))
						(then (set (local limit) (u32 25))))))
			(if
				(:doc "The seed accepts a signed decimal spelling, including zero for unsigned types.")
				(local negative)
				(then
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
					(if
						(:doc "The negative i32 bound permits 2147483648. An unsigned negative spelling must be zero.")
						(u32.eq (local type) (u32 5))
						(then (set (local last_digit) (u32 8)))
						(else
							(set (local limit) (u32 0))
							(set (local last_digit) (u32 0))))))
			(let decoded (call read_decimal_digits (borrow-shared (local source)) (local cursor) (local end)
				(local limit) (local last_digit)))
			(let digits (record.get (local decoded) digits))
			(if
				(:doc "Keep the original literal diagnostic when the digit span is invalid.")
				(i32.lt (local digits) (i32 0))
				(then (return (local invalid))))
			(return (record.make DecimalSpelling (digits (local digits))
				(negative (bool.and (local negative) (u32.lt (u32 0) (record.get (local decoded) magnitude)))))))))
