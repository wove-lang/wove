(module scalar_host_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the record layout the host argv adapter constructs for a native entry.`)

	(use wove-file "../source/scan.wove" (only is_head_byte (type SourceNode)))
	(use wove-file "../source/module.wove" (only is_three_bytes))
	(use wove-file "./records.wove"
		(only is_record_slice is_writable_slice record_slice_element record_index member_type (type ScalarRecord)))

	(fn is_arg_span_slice
		(:doc `Require a shared record slice with start and end i32 fields in that order.

		The runtime writes the defining record's native type by value.
		Normal source lookup preserves its exact type through aliases.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (records (shared-slice ScalarRecord)) (type u32))
		(returns bool)
		(body
			(if
				(:doc "The host lends a read-only view of the span table.")
				(bool.or (bool.not (call is_record_slice (local type))) (call is_writable_slice (local type)))
				(then (return (bool false))))
			(let layout (slice.load (local records) (call record_index (call record_slice_element (local type)))))
			(if
				(:doc "Each span has exactly two fields.")
				(bool.not (i32.eq (record.get (local layout) count) (i32 2)))
				(then (return (bool false))))
			(let first (slice.load (local nodes) (record.get (local layout) first)))
			(let second (slice.load (local nodes) (record.get (local first) next_sibling)))
			(let start_name (slice.load (local nodes) (record.get (local first) first_child)))
			(let end_name (slice.load (local nodes) (record.get (local second) first_child)))
			(let start (record.get (local start_name) start))
			(let end (record.get (local end_name) start))
			(return
				(:doc "Confirm both exact signed field types and the names expected by the argv parser.")
				(bool.and
					(bool.and (u32.eq (call member_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)) (u32 5))
						(u32.eq (call member_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local second)) (u32 5)))
					(bool.and
						(bool.and (i32.eq (i32.sub.wrapping (record.get (local start_name) end) (local start)) (i32 5))
							(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) (u8 115) (u8 116) (u8 97))
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 114))
									(call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 116)))))
						(bool.and (i32.eq (i32.sub.wrapping (record.get (local end_name) end) (local end)) (i32 3))
							(call is_three_bytes (borrow-shared (local source)) (local end) (u8 101) (u8 110) (u8 100)))))))))
