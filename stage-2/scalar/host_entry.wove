(module scalar_host_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the record layout the host argv adapter constructs for a native entry.`)

	(use wove-file "../text/match.wove" (only (as is_byte_at is_head_byte) is_three_bytes))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./records.wove"
		(only is_typed_slice is_writable_slice slice_element_type is_record_type record_index member_type (type ScalarRecord)))

	(fn is_arg_span_slice
		(:doc `Require a shared record slice with start and end i32 fields in that order.

		The runtime writes the defining record's native type by value.
		Normal source lookup preserves its exact type through aliases.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(if
				(:doc "The host lends a read-only view of the span table.")
				(bool.or (bool.not (call is_typed_slice (local type))) (call is_writable_slice (local type)))
				(then (return (bool false))))
			(let element (call slice_element_type (borrow-shared (local records)) (local type)))
			(if
				(:doc "The host span table requires a record element with the established layout.")
				(bool.not (call is_record_type (local element)))
				(then (return (bool false))))
			(let layout (array.load (local records) (call record_index (local element))))
			(if
				(:doc "Each span has exactly two fields.")
				(bool.not (i32.eq (struct.get (local layout) count) 2i32))
				(then (return (bool false))))
			(let first (array.load (local nodes) (struct.get (local layout) first)))
			(let second (array.load (local nodes) (struct.get (local first) next_sibling)))
			(let start_name (array.load (local nodes) (struct.get (local first) first_child)))
			(let end_name (array.load (local nodes) (struct.get (local second) first_child)))
			(let start (struct.get (local start_name) start))
			(let end (struct.get (local end_name) start))
			(return
				(:doc "Confirm both exact signed field types and the names expected by the argv parser.")
				(bool.and
					(bool.and (u32.eq (call member_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local first)) 5u32)
						(u32.eq (call member_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local second)) 5u32))
					(bool.and
						(bool.and (i32.eq (i32.sub (struct.get (local start_name) end) (local start)) 5i32)
							(bool.and (call is_three_bytes (borrow-shared (local source)) (local start) 115u8 116u8 97u8)
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) 3i32 114u8)
									(call is_head_byte (borrow-shared (local source)) (local start) 4i32 116u8))))
						(bool.and (i32.eq (i32.sub (struct.get (local end_name) end) (local end)) 3i32)
							(call is_three_bytes (borrow-shared (local source)) (local end) 101u8 110u8 100u8))))))))
