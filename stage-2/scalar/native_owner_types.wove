(module scalar_native_owner_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Encode each native owner using the high bit and its exact defining tree row.

	The remaining bits hold one original declaration link. This encoding
	is shared by checked layouts, expression planning, and C emission.`)

	(fn native_owner_type
		(:doc `Encode a C resource type by the defining declaration in the flattened tree.`)
		(:pragma (inline always))
		(params (declaration i32))
		(returns u32)
		(body (return (u32.add 2147483648u32 (u32.from-i32 (local declaration))))))

	(fn is_native_owner
		(:doc `Test the high bit reserved for native pointer owners.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (u32.lt 2147483647u32 (local type)))))

	(fn native_owner_declaration
		(:doc `Recover the checked declaration row of a native pointer owner.`)
		(:pragma (inline always))
		(params (type u32))
		(returns i32)
		(body (return (i32.from-u32 (u32.sub (local type) 2147483648u32)))))
)
