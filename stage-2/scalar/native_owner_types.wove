(module scalar_native_owner_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Encode native owners and reserve disjoint high intervals for optional values.

	A native owner carries its original flattened declaration row.
	The two highest intervals encode nullable record loans and optional array slots.`)

	(let optional_reference_base 3758096384u32)
	(let optional_array_base 4026531840u32)

	(fn native_owner_row_limit
		(:doc "Bound source rows before a native owner code could enter an optional interval.")
		(params) (returns i32)
		(body (return (i32.from-u32 (u32.sub optional_reference_base 2147483648u32)))))

	(fn native_owner_type
		(:doc `Encode a C resource type by the defining declaration in the flattened tree.`)
		(:pragma (inline always))
		(params (declaration i32))
		(returns u32)
		(body (return (u32.add 2147483648u32 (u32.from-i32 declaration)))))

	(fn is_native_owner
		(:doc `Check the high interval below both optional type ranges.`)
		(:pragma (inline always))
		(params (type u32))
		(returns bool)
		(body (return (bool.and (u32.lt 2147483647u32 type) (u32.lt type optional_reference_base)))))

	(fn native_owner_declaration
		(:doc `Recover the checked declaration row of a native pointer owner.`)
		(:pragma (inline always))
		(params (type u32))
		(returns i32)
		(body (return (i32.from-u32 (u32.sub type 2147483648u32)))))
)
