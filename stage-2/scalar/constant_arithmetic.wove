(module scalar_constant_arithmetic
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Evaluate exact signed i32 arithmetic with the integer primitives available to the seed.")

	(use wove-file "../source/integer_ops.wove" (only integer_operator is_checked_integer_operator is_integer_division is_integer_remainder))

	(struct FoldedWord (fields (bits u32) (valid bool)))
	(struct UnsignedDivision (fields (quotient u32) (remainder u32)))
	(let sign_bit 2147483648u32)
	(let max_positive 2147483647u32)

	(fn signed_magnitude
		(:doc "Take the unsigned magnitude, including a representable magnitude for INT32_MIN.")
		(params (bits u32)) (returns u32)
		(body
			(if (u32.lt bits sign_bit) (then (return bits)))
			(return (u32.sub 0u32 bits))))

	(fn divide_magnitudes
		(:doc "Divide two i32 magnitudes by shifting the divisor only when it fits the remainder.")
		(params (numerator u32) (denominator u32)) (returns UnsignedDivision)
		(body
			(let-mut quotient 0u32)
			(let-mut remainder numerator)
			(let-mut shift 31i32)
			(while
				(:doc "Each quotient bit removes a multiple that is representable as a word.")
				(i32.not-ltz shift)
				(body
					(if
						(:doc "Test the shifted comparison before shifting the divisor itself.")
						(u32.not-lt (u32.shr remainder shift) denominator)
						(then
							(set remainder (u32.sub remainder (u32.shl denominator shift)))
							(set quotient (u32.or quotient (u32.shl 1u32 shift)))))
					(set shift (i32.dec shift))))
			(return (struct.new UnsignedDivision (quotient quotient) (remainder remainder)))))

	(fn multiply_words
		(:doc "Multiply exact 32-bit bit patterns with modular doubling and addition.")
		(params (left u32) (right u32)) (returns u32)
		(body
			(let-mut result 0u32)
			(let-mut factor left)
			(let-mut multiplier right)
			(while
				(:doc "An exhausted multiplier contributes no further bits.")
				(u32.gtz multiplier)
				(body
					(if
						(:doc "This set multiplier bit adds its factor modulo 2^32.")
						(u32.not-eqz (u32.and multiplier 1u32))
						(then (set result (u32.add result factor))))
					(set factor (u32.shl factor 1i32))
					(set multiplier (u32.shr multiplier 1i32))))
			(return result)))

	(fn apply_i32_constant_operation
		(:doc "Match runtime wrapping, checked overflow, and signed division semantics for one decoded opcode.")
		(params (kind u32) (left u32) (right u32)) (returns FoldedWord)
		(body
			(let negative_left (u32.not-lt left sign_bit))
			(let different_sign (u32.not-eqz (u32.and (u32.xor left right) sign_bit)))
			(let invalid (struct.new FoldedWord (bits 0u32) (valid (bool false))))
			(if
				(:doc "Only division overflows on INT32_MIN with a divisor of -1. The remainder is zero.")
				(call is_integer_division kind)
				(then
					(let remainder (call is_integer_remainder kind))
					(if
						(:doc "Reject the two invalid division inputs before computing any quotient.")
						(bool.or (u32.eqz right)
							(bool.and (bool.not remainder)
								(bool.and (u32.eq left sign_bit) (u32.eq right 4294967295u32))))
						(then (return invalid)))
					(let result (call divide_magnitudes (call signed_magnitude left) (call signed_magnitude right)))
					(let-mut bits (struct.get result quotient))
					(let-mut negative different_sign)
					(if
						(:doc "The quotient truncates toward zero, and the remainder takes the dividend's sign.")
						remainder
						(then
							(set bits (struct.get result remainder))
							(set negative negative_left)))
					(if negative (then (set bits (u32.sub 0u32 bits))))
					(return (struct.new FoldedWord (bits bits) (valid (bool true))))))
			(let symbol (struct.get (call integer_operator kind) symbol))
			(let checked (call is_checked_integer_operator kind))
			(if
				(:doc "Check a product by dividing the signed result limit by the second magnitude.")
				(u8.eq symbol 42u8)
				(then
					(if
						(:doc "Only a nonzero checked operand requires a quotient limit.")
						(bool.and checked (u32.not-eqz right))
						(then
							(let-mut limit max_positive)
							(if different_sign (then (set limit sign_bit)))
							(let bound (call divide_magnitudes limit (call signed_magnitude right)))
							(if
								(:doc "Unsigned magnitudes compare before the product is formed.")
								(u32.lt (struct.get bound quotient) (call signed_magnitude left))
								(then (return invalid)))))
					(return (struct.new FoldedWord (bits (call multiply_words left right)) (valid (bool true))))))
			(let addition (u8.eq symbol 43u8))
			(let-mut bits (u32.sub left right))
			(if addition (then (set bits (u32.add left right))))
			(let flipped (u32.not-eqz (u32.and (u32.xor left bits) sign_bit)))
			(if
				(:doc "A flipped result sign detects overflow for equal-sign sums and opposite-sign differences.")
				(bool.and (bool.and checked flipped)
					(bool.or (bool.and addition (bool.not different_sign))
						(bool.and (bool.not addition) different_sign)))
				(then (return invalid)))
			(return (struct.new FoldedWord (bits bits) (valid (bool true))))))
)
