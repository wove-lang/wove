(module scalar_test_discovery
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Discover parameterless void tests in reached Wove modules.

	Use the resolved graph's mode and canonical identities. List modules
	in first-discovery order and tests in declaration order within each
	module. Keep file-local declaration rows and original byte spans for
	the native runner.`)

	(use wove-file "../source/scan.wove" (only check_source_form build_source_tree (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts read_module_for_target (type SelectedDeclaration)))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/graph.wove" (only graph_selection (type GraphModule) (type GraphResult)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "./syntax.wove" (only entry_keyword))
	(use wove-file "./signatures.wove" (only read_test_signature))

	(struct DiscoveredTest (fields (file i32) (declaration i32) (name_start i32) (name_end i32) (start i32) (end i32)))
	(struct TestDiscovery (fields (count i32) (file i32) (start i32) (end i32) (error u32)))
	(struct TestFileOrder (fields (file i32)))

	(fn discovery_result
		(:doc `Return the initialized inventory prefix and an optional originating source diagnostic.`)
		(params (count i32) (file i32) (start i32) (end i32) (error u32))
		(returns TestDiscovery)
		(body
			(return (struct.new TestDiscovery (count (local count)) (file (local file))
				(start (local start)) (end (local end)) (error (local error))))))

	(fn ordered_test_files
		(:doc `Invert the reached modules' discovery order to visit each canonical file once.`)
		(params (modules (shared-array GraphModule)) (file_count i32) (order (mut-array TestFileOrder)))
		(returns void)
		(body
			(let-mut file 0i32)
			(while
				(:doc "Resolution initializes one module slot per supplied file.")
				(i32.lt (local file) (local file_count))
				(body
					(let module (array.load (local modules) (local file)))
					(let index (struct.get (local module) order))
					(if
						(:doc "An unseen file has no position in the resolved order.")
						(i32.lt -1i32 (local index))
						(then (array.store (local order) (local index) (struct.new TestFileOrder (file (local file))))))
					(set (local file) (i32.add (local file) 1i32))))))

	(fn collect_file_tests
		(:doc `Validate direct test declarations in one reached source view and append their original spans.`)
		(params (source (shared-array u8)) (file i32) (context SelectionContext) (first i32) (output (mut-array DiscoveredTest)))
		(returns TestDiscovery)
		(body
			(let checked (call check_source_form (borrow-shared (local source))))
			(let rows (i32.from-u32 (struct.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let-mut selected (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes)) (local built)
				(local context) (borrow-mut (local selected))))
			(if
				(:doc "A source check failure keeps its defining file and original span.")
				(u32.gtz (struct.get (local module) error))
				(then (return (call discovery_result (local first) (local file) (struct.get (local module) start)
					(struct.get (local module) end) (struct.get (local module) error)))))
			(return (call collect_selected_tests (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local selected)) (struct.get (local module) count) (local file)
				(local first) (borrow-mut (local output))))))

	(fn collect_selected_tests
		(:doc `Read exact test signatures from the same selected declaration rows used by other compiler passes.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (selected (shared-array SelectedDeclaration))
			(count i32) (file i32) (first i32) (output (mut-array DiscoveredTest)))
		(returns TestDiscovery)
		(body
			(let-mut next (local first))
			(let-mut index 0i32)
			(while
				(:doc "The selected rows already flatten active declaration groups in source order.")
				(i32.lt (local index) (local count))
				(body
					(let row (array.load (local selected) (local index)))
					(if
						(:doc "Only a form carrying its own test pragma can contribute a test.")
						(struct.get (local row) test)
						(then
							(let declaration (struct.get (local row) node))
							(let node (array.load (local nodes) (local declaration)))
							(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
							(if
								(:doc "Test-only imports, groups, and types affect selection without becoming test functions.")
								(u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
									(struct.get (local parts) head)) 1u32)
								(then
									(let signature (call read_test_signature (borrow-shared (local source)) (borrow-shared (local nodes))
										(local node) (struct.get (local parts) operands)))
									(if
										(:doc "Point at the exact parameter list or result type from the signature reader.")
										(u32.gtz (struct.get (local signature) error))
										(then (return (call discovery_result (local next) (local file) (struct.get (local signature) start)
											(struct.get (local signature) end) (struct.get (local signature) error)))))
									(if
										(:doc "Insufficient output leaves the already discovered prefix intact.")
										(i32.not-lt (local next) (array.len (local output)))
										(then (return (call discovery_result (local next) (local file)
											(struct.get (local node) start) (struct.get (local node) end) 16u32))))
									(let name (array.load (local nodes) (struct.get (local parts) name)))
									(array.store (local output) (local next)
										(struct.new DiscoveredTest (file (local file)) (declaration (local declaration))
											(name_start (struct.get (local name) start)) (name_end (struct.get (local name) end))
											(start (struct.get (local node) start)) (end (struct.get (local node) end))))
									(set (local next) (i32.add (local next) 1i32))))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (call discovery_result (local next) -1i32 0i32 0i32 0u32))))

	(fn discover_graph_tests
		(:doc `Collect tests from a successfully resolved graph without requiring a program entry or checking bodies.

		Only the module slots corresponding to supplied files participate in the inventory.`)
		(:expect (tests "stage-2/test_discovery.tsv") (issues "gh:wove-lang/wove:181"))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(graph GraphResult) (output (mut-array DiscoveredTest)))
		(returns TestDiscovery)
		(body
			(let mode (struct.get (local graph) mode))
			(if
				(:doc "Ordinary selection excluded test declarations before the graph was resolved.")
				(u32.not-eq (local mode) 2u32)
				(then (return (call discovery_result 0i32 -1i32 0i32 0i32 0u32))))
			(let count (struct.get (local graph) modules))
			(let-mut order (array.alloc TestFileOrder (local count)))
			(call ordered_test_files (borrow-shared (local modules)) (array.len (local files)) (borrow-mut (local order)))
			(return (call discover_ordered_tests (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local order)) (call graph_selection (local graph))
				(borrow-mut (local output))))))

	(fn discover_ordered_tests
		(:doc `Visit canonical files in graph discovery order, skipping modules excluded by selection.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(order (shared-array TestFileOrder)) (context SelectionContext) (output (mut-array DiscoveredTest)))
		(returns TestDiscovery)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "A diamond or import alias only contributes one visited defining file.")
				(i32.lt (local index) (array.len (local order)))
				(body
					(let file (struct.get (array.load (local order) (local index)) file))
					(if
						(:doc "Inactive files contribute no tests, even if an empty selection reached them.")
						(struct.get (array.load (local modules) (local file)) active)
						(then
							(let input (array.load (local files) (local file)))
							(let result (call collect_file_tests
								(borrow-shared (array.range (local arena) (struct.get (local input) source_start)
									(struct.get (local input) source_end))) (local file) (local context) (local count)
								(borrow-mut (local output))))
							(if (u32.gtz (struct.get (local result) error)) (then (return (local result))))
							(set (local count) (struct.get (local result) count))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (call discovery_result (local count) -1i32 0i32 0i32 0u32)))))
