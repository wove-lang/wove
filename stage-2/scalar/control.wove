(module scalar_control
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Summarize reachable edges in checked statement sequences and follow native owner transfers.

	Each block reports fallthrough, break, and continue relative to its
	enclosing loop. A completed loop consumes its own break and continue
	edges. Literal conditions can exclude an edge even though the branch is
	still checked and emitted.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings))
	(use wove-file "./syntax.wove" (only entry_form entry_at (type EntryRead)))
	(use wove-file "../source/enum_forms.wove" (only (value match_statement)))
	(use wove-file "./flow.wove" (only within_scope is_loop block_statement (type ScalarStatement) (value for_statement)
		(value next_path) (value break_path) (value continue_path) (value owner_assignment) (value owner_field_assignment)))
	(use wove-file "./conditional.wove" (only conditional_transfer_reaches))
	(use wove-file "./loans.wove" (only paths_overlap path_covers (type ScalarExpression)))
	(use wove-file "./owners.wove" (only native_handle_consume_kind is_owner_take optional_unwrap_kind))

	(fn plan_control_blocks
		(:doc `Check one required control block and the optional else of an if.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statements (mut-array ScalarStatement))
			(node SourceNode) (condition i32) (loop bool))
		(returns EntryRead)
		(body
			(let first (struct:get (nodes.get condition) next_sibling))
			(if
				(:doc "The control header must be followed by the first block.")
				first.ltz
				(then (return (call entry_at node -1i32 24u32))))
			(let-mut expected 23u32)
			(if
				(:doc "A loop has a body. An if starts with then.")
				loop
				(then (set expected 6u32)))
			(let first_node (nodes.get first))
			(let first_block (call entry_form (borrow-shared source) (borrow-shared nodes)
				first_node expected 24u32))
			(if
				(:doc "Keep the original first-block form or metadata diagnostic.")
				first_block/error.gtz
				(then (return first_block)))
			(let then_start (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
				first_block/operand))
			(statements.set first
				(call block_statement then_start -1i32 -1i32 (bool true)))
			(let alternate first_node/next_sibling)
			(if
				(:doc "An explicit else must be the final arm and supplies its own first statement.")
				alternate.not-ltz
				(then
					(let else_node (nodes.get alternate))
					(if
						(:doc "A loop accepts a single body block.")
						loop
						(then (return (call entry_at else_node -1i32 24u32))))
					(let else_arm (call entry_form (borrow-shared source) (borrow-shared nodes)
						else_node 24u32 24u32))
					(if
						(:doc "Keep the original else-arm form or metadata diagnostic.")
						else_arm/error.gtz
						(then (return else_arm)))
					(let extra else_node/next_sibling)
					(if
						(:doc "Point at the first operand beyond the optional else.")
						extra.not-ltz
						(then (return (call entry_at (nodes.get extra) -1i32 24u32))))
					(let else_start (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
						else_arm/operand))
					(statements.set alternate
						(call block_statement else_start -1i32 -1i32 (bool true)))))
			(return (call entry_at node first 0u32))))

	(fn has_path
		(:doc `Test whether any of the requested edges are possible.`)
		(params (paths u32) (mask u32))
		(returns bool)
		(body (return (u32:gtz (paths.and mask)))))

	(fn repeats_loop
		(:doc `Both ordinary body completion and continue reach the next condition check.`)
		(params (paths u32))
		(returns bool)
		(body (return (call has_path paths (next_path.or continue_path)))))

	(fn enclosing_loop
		(:doc `Find the nearest checked loop in the source ancestry of a statement.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (index i32) (outer i32))
		(returns i32)
		(body
			(let-mut row (struct:get (nodes.get index) parent))
			(while
				(:doc "Stop at the function body before inspecting declarations outside it.")
				(row.not-eq outer)
				(body
					(if
						(:doc "The first enclosing loop is the target.")
						(call is_loop (struct:get (statements.get row) kind))
						(then (return row)))
					(set row (struct:get (nodes.get row) parent))))
			(return -1i32)))

	(fn sequence_paths
		(:doc `Follow sibling statements while the incoming path can continue.

		An optional stop row limits the walk to statements completed before
		the use, which may be inside one of the remaining siblings.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(initial u32) (first i32) (stop i32))
		(returns u32)
		(body
			(let-mut paths initial)
			(let-mut index first)
			(while
				(:doc "A terminal sequence contributes its accumulated loop exits.")
				(bool:and (i32:lt -1i32 index) (call has_path paths next_path))
				(body
					(let node (nodes.get index))
					(if
						(:doc "Leave the destination statement and any statement containing it unprocessed.")
						(bool:and (i32:lt -1i32 stop)
							(bool:or (index.not-lt stop)
								(call within_scope node (nodes.get stop))))
						(then (return paths)))
					(let row (statements.get index))
					(if
						(:doc "Disabled siblings have no checked statement and leave the path intact.")
						row/kind.gtz
						(then (set paths (u32:or (paths.and next_path.not)
							row/paths))))
					(set index node/next_sibling)))
			(return paths)))

	(fn predicate_literal
		(:doc `Read the checked literal kind of an if or while predicate. Return zero for other control forms.`)
		(params (control ScalarStatement) (expressions (shared-array ScalarExpression)))
		(returns u32)
		(body
			(let kind control/kind)
			(if
				(:doc "Only conditionals and loops have boolean predicates.")
				(bool:or (kind.eq 22u32) (kind.eq 25u32))
				(then (return (struct:get (expressions.get control/value) kind))))
			(return 0u32)))

	(fn control_paths
		(:doc `Join a completed control statement's arms and keep only exits that reach past it.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (control ScalarStatement))
		(returns u32)
		(body
			(if
				(:doc "A finite iterator may be empty, so it can always reach its successor.")
				(control/kind.eq for_statement)
				(then (return next_path)))
			(let first control/first)
			(let paths (struct:get (statements.get first) paths))
			(let literal (call predicate_literal control (borrow-shared expressions)))
			(if
				(:doc "A loop can end on a false condition or a reachable break from its own body.")
				(control/kind.eq 25u32)
				(then
					(if
						(:doc "An always-true loop reaches its successor only through break.")
						(bool:or (literal.not-eq 5u32) (call has_path paths break_path))
						(then (return next_path)))
					(return 0u32)))
			(if
				(:doc "An exhaustive match joins the reachable edges of all its cases.")
				(control/kind.eq match_statement)
				(then
					(let-mut result 0u32)
					(let-mut arm first)
					(while
						(:doc "Each case can be selected at runtime.")
						(i32:lt -1i32 arm)
						(body
							(set result (result.or (struct:get (statements.get arm) paths)))
							(set arm (struct:get (nodes.get arm) next_sibling))))
					(return result)))
			(if (literal.eq 5u32) (then (return paths)))
			(let alternate (struct:get (nodes.get first) next_sibling))
			(let-mut other next_path)
			(if
				(:doc "An omitted else can continue without executing a statement.")
				(i32:lt -1i32 alternate)
				(then (set other (struct:get (statements.get alternate) paths))))
			(if (literal.eq 4u32) (then (return other)))
			(return (paths.or other))))

	(fn block_can_run
		(:doc `Exclude an arm or loop body that its literal predicate cannot enter.`)
		(params (control ScalarStatement) (block i32) (literal u32))
		(returns bool)
		(body
			(let first (block.eq control/first))
			(return (bool:not (bool:or (first.and (literal.eq 4u32))
				(first.not.and (literal.eq 5u32)))))))

	(fn statement_can_run
		(:doc `Check that the prefix of a statement's own block can reach it.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (index i32) (block i32))
		(returns bool)
		(body
			(let first (struct:get (nodes.get block) first_child))
			(return (call has_path (call sequence_paths (borrow-shared nodes) (borrow-shared statements)
				next_path first index) next_path))))

	(fn restores_owner
		(:doc "An assignment reinitializes the recorded slot when it writes that slot or an enclosing owner.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(row ScalarStatement) (moved TransferPlace))
		(returns bool)
		(body
			(let target row/target)
			(let kind row/kind)
			(if
				(:doc "Replacing a whole local restores every field within it.")
				(kind.eq owner_assignment)
				(then (return (target.eq moved/target))))
			(if
				(:doc "Only a checked owning-field write can fill a projected vacancy.")
				(kind.not-eq owner_field_assignment)
				(then (return (bool false))))
			(let root (struct:get (expressions.get target) projection))
			(let binding (expressions.get root))
			(return (bool:and
				(bool:and (binding/kind.eq 6u32)
					(binding/target.eq moved/target))
				(call path_covers (borrow-shared nodes) (borrow-shared expressions)
					target moved/path (bool false))))))

	(fn retained_arm_prefix
		(:doc "Follow the arm containing a use and test whether any entering path still lacks the owner.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (control ScalarStatement) (use i32) (moved TransferPlace))
		(returns u32)
		(body
			(let site (nodes.get use))
			(let-mut arm control/first)
			(while
				(:doc "Only a single sibling block can enclose the use.")
				arm.not-ltz
				(body
					(let block (nodes.get arm))
					(if
						(:doc "Scan the checked statement prefix of the matching block.")
						(call within_scope block site)
						(then (return (call retained_owner_paths (borrow-shared nodes)
							(borrow-shared statements) (borrow-shared expressions) moved
							next_path (struct:get (statements.get arm) first) use))))
					(set arm block/next_sibling)))
			(return next_path)))

	(fn retained_control_paths
		(:doc "Join control exits that can continue with the tracked slot still moved.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (row ScalarStatement) (moved TransferPlace))
		(returns u32)
		(body
			(let kind row/kind)
			(let literal (call predicate_literal row (borrow-shared expressions)))
			(let loop (call is_loop kind))
			(if
				(:doc "A loop with a possible zero-iteration path preserves the incoming vacancy.")
				(loop.and (literal.not-eq 5u32))
				(then (return next_path)))
			(let-mut arm row/first)
			(let-mut retained 0u32)
			(if
				(:doc "A possible missing else leaves the incoming owner state in place.")
				(bool:and (kind.eq 22u32) (literal.not-eq 5u32))
				(then
					(if (i32:ltz (struct:get (nodes.get arm) next_sibling))
						(then (set retained next_path)))))
			(while
				(:doc "Process only arms that can be selected by the checked predicate.")
				arm.not-ltz
				(body
					(if
						(:doc "An arm may restore the slot on some exits and leave it moved on others.")
						(call block_can_run row arm literal)
						(then
							(let paths (call retained_owner_paths (borrow-shared nodes)
								(borrow-shared statements) (borrow-shared expressions) moved
								next_path (struct:get (statements.get arm) first) -1i32))
							(set retained (retained.or paths))))
					(set arm (struct:get (nodes.get arm) next_sibling))))
			(if
				(:doc "An always-true loop reaches its successor through its own break only.")
				loop
				(then
					(if (call has_path retained break_path) (then (return next_path)))
					(return 0u32)))
			(return retained)))

	(fn retained_statement_paths
		(:doc "Carry an existing vacancy through a completed statement, including the control whose header moved it.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (row ScalarStatement) (moved TransferPlace))
		(returns u32)
		(body
			(if
				(:doc "A matching assignment restores the owner once its right-hand side finishes.")
				(call restores_owner (borrow-shared nodes) (borrow-shared expressions)
					row moved)
				(then (return 0u32)))
			(let kind row/kind)
			(if
				(:doc "Control statements can restore the owner on individual continuing arms.")
				(bool:or (call is_loop kind)
					(bool:or (kind.eq 22u32) (kind.eq match_statement)))
				(then (return (call retained_control_paths (borrow-shared nodes)
					(borrow-shared statements) (borrow-shared expressions) row moved))))
			(return row/paths)))

	(fn retained_owner_paths
		(:doc "Track the exits where a move survives the checked sequence without a matching reinitialization.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (moved TransferPlace) (initial u32) (first i32) (stop i32))
		(returns u32)
		(body
			(let-mut paths initial)
			(let-mut index first)
			(while
				(:doc "Keep terminal edges while advancing the surviving fallthrough path.")
				(index.not-ltz.and (call has_path paths next_path))
				(body
					(if
						(:doc "The use itself happens before any assignment performed by that statement.")
						(stop.not-ltz.and (index.not-lt stop))
						(then (return paths)))
					(let node (nodes.get index))
					(let row (statements.get index))
					(let kind row/kind)
					(if
						(:doc "A nested use observes assignments already executed in its own arm.")
						(stop.not-ltz.and
							(call within_scope node (nodes.get stop)))
						(then (return (call retained_arm_prefix (borrow-shared nodes)
							(borrow-shared statements) (borrow-shared expressions)
							row stop moved))))
					(if
						(:doc "Disabled statements leave the incoming state intact.")
						kind.not-eqz
						(then
							(let exits (call retained_statement_paths (borrow-shared nodes)
								(borrow-shared statements) (borrow-shared expressions) row moved))
							(set paths (u32:or (paths.and next_path.not) exits))))
					(set index node/next_sibling)))
			(return paths)))

	(fn native_transfer_paths
		(:doc `Find the edges that carry a move to a later use or loop back edge.

		Follow the rest of the origin's block and then climb through the
		controls it actually exits. A break joins after the loop it targets.
		A continue contributes to that loop's next condition, never to
		later statements in the same iteration.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (moved TransferPlace) (transfer i32) (use i32) (back_edge bool))
		(returns u32)
		(body
			(let-mut prior (struct:get (nodes.get transfer) parent))
			(while
				(:doc "Climb from the argument to its checked statement or the statement still being checked.")
				(bool:and (prior.not-eq use)
					(u32:eqz (struct:get (statements.get prior) kind)))
				(body (set prior (struct:get (nodes.get prior) parent))))
			(if (prior.eq use) (then (return next_path)))
			(let site (nodes.get use))
			(let origin (nodes.get prior))
			(let-mut block origin/parent)
			(if
				(:doc "A preceding terminal path can exclude an otherwise checked transfer.")
				(bool:not (call statement_can_run (borrow-shared nodes) (borrow-shared statements)
					prior block))
				(then (return 0u32)))
			(let initial (statements.get prior))
			(if
				(:doc "A transfer in the loop predicate precedes every body path.")
				(back_edge.and (prior.eq site/parent))
				(then (return (call retained_owner_paths (borrow-shared nodes) (borrow-shared statements)
					(borrow-shared expressions) moved next_path
					(struct:get (statements.get use) first) -1i32))))
			(if
				(:doc "A control predicate's transfer precedes a use in any of its arms.")
				(call within_scope origin site)
				(then (return (call retained_arm_prefix (borrow-shared nodes) (borrow-shared statements)
					(borrow-shared expressions) initial use moved))))
			(let-mut paths (call retained_statement_paths (borrow-shared nodes)
				(borrow-shared statements) (borrow-shared expressions) initial moved))
			(while
				(:doc "Climb only across blocks outside the use's scope.")
				(bool:not (call within_scope (nodes.get block) site))
				(body
					(let control (struct:get (nodes.get block) parent))
					(let row (statements.get control))
					(let here (nodes.get control))
					(let literal (call predicate_literal row (borrow-shared expressions)))
					(if
						(:doc "Neither a sibling arm nor a statically excluded path can carry the transfer to this use.")
						(bool:or (call within_scope here site)
							(bool:not (call block_can_run row block literal)))
						(then (return 0u32)))
					(set paths (call retained_owner_paths (borrow-shared nodes) (borrow-shared statements)
						(borrow-shared expressions) moved paths
						(struct:get (nodes.get prior) next_sibling) -1i32))
					(if
						(:doc "Only a break or a later false condition can carry the transfer out of the loop.")
						(call is_loop row/kind)
						(then
							(if
								(:doc "Consume this loop's exits before continuing toward the enclosing use.")
								(bool:or (call has_path paths break_path)
									(bool:and (literal.not-eq 5u32) (call repeats_loop paths)))
								(then (set paths next_path))
								(else (set paths 0u32)))))
					(if paths.eqz (then (return 0u32)))
					(set prior control)
					(set block here/parent)
					(if
						(:doc "A terminal prefix in the enclosing block can exclude the whole control.")
						(bool:not (call statement_can_run (borrow-shared nodes) (borrow-shared statements)
							prior block))
						(then (return 0u32)))))
			(let-mut stop use)
			(if back_edge (then (set stop -1i32)))
			(return (call retained_owner_paths (borrow-shared nodes) (borrow-shared statements)
				(borrow-shared expressions) moved paths
				(struct:get (nodes.get prior) next_sibling) stop))))

	(fn owner_transfer_site
		(:doc "Use the entire move as related context, even when an unwrap captured its source slot separately.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (index i32))
		(returns i32)
		(body
			(let parent (struct:get (nodes.get index) parent))
			(if
				(:doc "Only a capture nested under an unwrap is smaller than the original move.")
				(u32:eq (struct:get (expressions.get parent) kind) (call optional_unwrap_kind))
				(then (return parent)))
			(return index)))

	(struct TransferPlace (fields (target i32) (path i32)))

	(fn owner_transfer_place
		(:doc "Recover the original binding and field path from a move or consuming native argument.")
		(params (expressions (shared-array ScalarExpression)) (row ScalarExpression))
		(returns TransferPlace)
		(body
			(if
				(:doc "Evaluating moves already carry the original slot identity.")
				(row/kind.not-eq (call native_handle_consume_kind))
				(then (return (struct:new TransferPlace
					(target row/target) (path row/projection)))))
			(let place row/first)
			(let pointer (expressions.get place))
			(if
				(:doc "A consumed field belongs to the local at the start of its projection.")
				(pointer/kind.eq 52u32)
				(then
					(let root (expressions.get pointer/projection))
					(return (struct:new TransferPlace (target root/target) (path place)))))
			(return (struct:new TransferPlace (target pointer/target) (path -1i32)))))

	(fn transfer_overlaps
		(:doc "Compare an owner transfer only with paths rooted at the same binding.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(moved TransferPlace) (target i32) (place i32) (whole_only bool) (ancestor_only bool))
		(returns bool)
		(body
			(let path moved/path)
			(if
				(:doc "A whole-only read tolerates vacancies in individual fields.")
				(bool:or (moved/target.not-eq target)
					(whole_only.and path.not-ltz))
				(then (return (bool false))))
			(if
				(:doc "A field replacement needs its enclosing storage even when the field itself is vacant.")
				ancestor_only
				(then (return (call path_covers (borrow-shared nodes)
					(borrow-shared expressions) path place (bool true)))))
			(return (call paths_overlap (borrow-shared nodes) (borrow-shared expressions)
				place path))))

	(fn prior_owner_take
		(:doc "Find an earlier evaluating owner transfer that overlaps this place on a continuing path.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (target i32) (place i32) (whole_only bool) (ancestor_only bool) (site i32) (statement i32))
		(returns i32)
		(body
			(let-mut cursor target.inc)
			(while
				(:doc "Check evaluating moves in their original source order.")
				(cursor.lt site)
				(body
					(let row (expressions.get cursor))
					(let kind row/kind)
					(if
						(:doc "Only evaluating moves and consuming bridge arguments can empty the original slot.")
						(bool:or (call is_owner_take kind) (kind.eq (call native_handle_consume_kind)))
						(then
							(let moved (call owner_transfer_place (borrow-shared expressions) row))
							(if
								(:doc "A sibling field has a different path and is still available.")
								(call transfer_overlaps (borrow-shared nodes) (borrow-shared expressions)
									moved target place whole_only ancestor_only)
								(then
									(if
										(:doc "Only a move that can run and reach this use affects its ownership.")
										(bool:and (call conditional_transfer_reaches (borrow-shared nodes)
											(borrow-shared expressions) cursor site)
											(call has_path (call native_transfer_paths (borrow-shared nodes)
												(borrow-shared statements) (borrow-shared expressions)
												moved cursor statement (bool false)) next_path))
										(then (return (call owner_transfer_site (borrow-shared nodes) (borrow-shared expressions) cursor))))))))
					(set cursor cursor.inc)))
			(return -1i32)))

	(fn consumption_on_back_edge
		(:doc `Find a consuming argument that can reach the next iteration with an outer owner missing.

		A local introduced inside the loop is recreated before its next use.
		Transfers in return paths never reach the back edge.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (loop i32) (block i32) (limit i32))
		(returns i32)
		(body
			(let-mut cursor loop)
			(if
				(:doc "A for prepares its source once, so only transfers in its body can repeat.")
				(u32:eq (struct:get (statements.get loop) kind) for_statement)
				(then (set cursor block)))
			(let end (struct:get (nodes.get block) end))
			(while
				(:doc "Inspect the repeating part of the loop.")
				(bool:and (cursor.lt limit)
					(i32:lt (struct:get (nodes.get cursor) start) end))
				(body
					(let row (expressions.get cursor))
					(if
						(:doc "Only a transfer of an enclosing local can deplete the next iteration's owners.")
						(bool:or (row/kind.eq (call native_handle_consume_kind))
							(call is_owner_take row/kind))
						(then
							(let moved (call owner_transfer_place (borrow-shared expressions) row))
							(let name moved/target)
							(if
								(:doc "Use the loop body as the scope reached by a continuing back edge.")
								(bool:and (name.lt loop)
									(bool:and (call conditional_transfer_reaches (borrow-shared nodes)
										(borrow-shared expressions) cursor block)
										(call repeats_loop (call native_transfer_paths (borrow-shared nodes) (borrow-shared statements)
											(borrow-shared expressions) moved cursor block (bool true)))))
								(then (return (call owner_transfer_site (borrow-shared nodes) (borrow-shared expressions) cursor))))))
					(set cursor cursor.inc)))
			(return -1i32))))
