(module module_binding_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Mark defining rows that supply private C storage or a native typedef.")

	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))

	(let module_binding_key_kind 733u32)
	(let readonly_binding_key_kind 734u32)
	(let bridge_string_key_kind 735u32)

	(fn binding_name_key
		(:doc "Keep the owning file in a reserved row whose index names the declaration.")
		(params (kind u32) (file i32)) (returns ScalarExpression)
		(body (return (call expression_row kind 0u32 0i32 file 0i32 0i32 (bool false)))))

	(fn module_binding_key
		(:doc "Mark a Wove module value and its private backing storage.")
		(params (file i32)) (returns ScalarExpression)
		(body (return (call binding_name_key module_binding_key_kind file))))
)
