(module module_binding_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Keep a Wove module binding's exact owner and cached parent key at its original name node.")

	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))

	(let module_binding_key_kind 733u32)

	(fn module_binding_key
		(:doc "Store the module fingerprint, defining file, and collision slot in a reserved non-expression row.")
		(params (module_id u32) (file i32) (slot i32)) (returns ScalarExpression)
		(body
			(return (call expression_row module_binding_key_kind 0u32 slot file
				(i32.from-u32 (u32.and module_id 2147483647u32))
				(i32.from-u32 (u32.shr module_id 31i32)) (bool false)))))

	(fn module_binding_identity
		(:doc "Recover the full unsigned key from the reserved row without giving it a language type.")
		(params (key ScalarExpression)) (returns u32)
		(body
			(return (u32.or (u32.from-i32 (struct.get key start))
				(u32.shl (u32.from-i32 (struct.get key end)) 31i32)))))
)
