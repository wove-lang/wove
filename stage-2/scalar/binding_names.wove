(module module_binding_names
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Keep a binding's exact defining owner and cached C name key at its original name node.")

	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))

	(let module_binding_key_kind 733u32)
	(let readonly_binding_key_kind 734u32)
	(let bridge_string_key_kind 735u32)

	(fn binding_name_key
		(:doc "Store the fingerprint, defining file, and collision slot in a reserved non-expression row.")
		(params (kind u32) (identity u32) (file i32) (slot i32)) (returns ScalarExpression)
		(body
			(return (call expression_row kind 0u32 slot file
				(i32.from-u32 (u32.and identity 2147483647u32))
				(i32.from-u32 (u32.shr identity 31i32)) (bool false)))))

	(fn module_binding_key
		(:doc "Retain the defining module fingerprint for a Wove value and its backing storage.")
		(params (module_id u32) (file i32) (slot i32)) (returns ScalarExpression)
		(body (return (call binding_name_key module_binding_key_kind module_id file slot))))

	(fn binding_name_identity
		(:doc "Recover the full unsigned key from the reserved row without giving it a language type.")
		(params (key ScalarExpression)) (returns u32)
		(body
			(return (u32.or (u32.from-i32 (struct.get key start))
				(u32.shl (u32.from-i32 (struct.get key end)) 31i32)))))
)
