(module scalar_locals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve local names against checked declarations and the enclosing body scopes.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings))
	(use wove-file "../source/enum_forms.wove" (only (value match_statement)))
	(use wove-file "./flow.wove" (only (type ScalarStatement) (value for_statement) (value case_payload_binding)))
	(use wove-file "./loops.wove" (only find_iteration_binding))
	(use wove-file "./syntax.wove" (only entry_at is_scalar_name same_name (type EntryRead)))

	(fn find_local
		(:doc `Find the nearest declaration visible before a statement.

		Search earlier siblings in the current block. At a block boundary,
		check iteration and case bindings before resuming in the enclosing block.
		Statements follow their previous siblings in the node table.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(first i32) (statement i32) (name SourceNode))
		(returns i32)
		(body
			(let outer (struct:get (nodes.get first) parent))
			(let-mut limit statement)
			(while
				(:doc "One search interval covers the visible declarations of one scope.")
				(i32:not-ltz limit)
				(body
					(let block (struct:get (nodes.get limit) parent))
					(let top (i32:eq block outer))
					(let-mut index first)
					(if
						(:doc "A nested block starts after its head and metadata.")
						(bool:not top)
						(then (set index (struct:get (statements.get block) first))))
					(while
						(:doc "Stop before the current statement or the control that enters the inner scope.")
						(i32:lt index limit)
						(body
							(let checked (statements.get index))
							(let kind checked/kind)
							(if
								(:doc "Only let and let-mut introduce names.")
								(bool:or (u32:eq kind 15u32) (u32:eq kind 16u32))
								(then
									(let declaration (nodes.get checked/target))
									(if
										(:doc "Compare the original identifier bytes in this scope.")
										(call same_name (borrow-shared source) declaration name)
										(then (return index)))))
							(set index (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
								(struct:get (nodes.get index) next_sibling)))))
					(if
						(:doc "Parameters are resolved separately once all statement scopes have been searched.")
						top
						(then (return -1i32)))
					(let parent (struct:get (nodes.get block) parent))
					(let kind (struct:get (statements.get parent) kind))
					(if
						(:doc "Header names are visible only after entering the loop body.")
						(u32:eq kind for_statement)
						(then
							(let binding (call find_iteration_binding (borrow-shared source) (borrow-shared nodes)
								(struct:get (statements.get block) target) name))
							(if (i32:lt -1i32 binding) (then (return binding)))))
					(if
						(:doc "A case name is visible only inside its own arm.")
						(u32:eq kind match_statement)
						(then
							(let binding (struct:get (statements.get block) value))
							(if
								(:doc "Unit and discard arms have no name to compare.")
								(bool:and (i32:lt -1i32 binding)
									(bool:and (u32:eq (struct:get (statements.get binding) kind) case_payload_binding)
										(call same_name (borrow-shared source) (nodes.get binding) name)))
								(then (return binding)))))
					(set limit parent)))
			(return -1i32)))

	(fn check_binding_name
		(:doc "Validate the written place without consulting its lexical or module binding.")
		(params (source (shared-array u8)) (name SourceNode))
		(returns EntryRead)
		(body
			(if
				(:doc "Only an unquoted name can stand for a whole binding.")
				(u32:not-eq name/kind 1u32)
				(then (return (call entry_at name -1i32 24u32))))
			(if
				(:doc "An invalid identifier keeps the byte span of the written operand.")
				(bool:not (call is_scalar_name (borrow-shared source) name))
				(then (return (call entry_at name -1i32 34u32))))
			(return (call entry_at name -1i32 0u32))))

	(fn read_single_pattern_name
		(:doc `Check the single name in a payload binding pattern.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (name_row i32) (operand i32))
		(returns EntryRead)
		(body
			(if
				(:doc "A case payload pattern takes exactly one name.")
				(bool:or (i32:ltz name_row) (i32:not-ltz operand))
				(then (return (call entry_at node -1i32 24u32))))
			(let name (nodes.get name_row))
			(if
				(:doc "A malformed pattern name keeps the operand span.")
				(bool:not (call is_scalar_name (borrow-shared source) name))
				(then (return (call entry_at name -1i32 34u32))))
			(return (call entry_at name name_row 0u32)))))
