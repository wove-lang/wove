(module scalar_callable_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read the checked scalar signature of a Wove function value.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword scalar_type (value fn_type_kind) (type EntryRead)))
	(use wove-file "./signatures.wove" (only read_signature_head))

	(struct CallableShape (fields (first i32) (result u32) (named bool) (start i32) (end i32) (error u32)))

	(fn callable_type_error
		(:doc "Retain the exact operand that made the signature invalid.")
		(params (error EntryRead)) (returns CallableShape)
		(body
			(return (struct.new CallableShape (first -1i32) (result 0u32) (named (bool false))
				(start (struct.get (local error) start)) (end (struct.get (local error) end)) (error (struct.get (local error) error))))))

	(fn callable_parameter_type
		(:doc "Read the scalar type of either an unnamed callable parameter or a named Wove formal.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (named bool))
		(returns u32)
		(body
			(let-mut type_node (local index))
			(if
				(:doc "A defining function spells each type after its parameter name.")
				(local named)
				(then
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local nodes) (local index))))
					(set (local type_node) (struct.get (local parts) operands))))
			(return (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))))

	(fn read_callable_type
		(:doc "Require a parameter list of scalar types and exactly one scalar or void result.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns CallableShape)
		(body
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local fn_type_kind) 23u32))
			(if (u32.gtz (struct.get (local form) error)) (then (return (call callable_type_error (local form)))))
			(let head (call read_signature_head (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (struct.get (local form) operand) (bool false) (bool false)))
			(if
				(:doc "Keep the shared reader's diagnostic at the original signature field.")
				(u32.gtz (struct.get (local head) error))
				(then (return (struct.new CallableShape (first -1i32) (result 0u32) (named (bool false))
					(start (struct.get (local head) start)) (end (struct.get (local head) end)) (error (struct.get (local head) error))))))
			(if
				(:doc "A signature type has no body.")
				(i32.not-ltz (struct.get (local head) body))
				(then (return (call callable_type_error
					(call entry_at (array.load (local nodes) (struct.get (local head) body)) -1i32 23u32)))))
			(let type_node (struct.get (local head) type_node))
			(let-mut result (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node)))
			(if
				(:doc "Void is valid only as the result type.")
				(u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (local type_node))
					(call void_type))
				(then (set (local result) (call void_type))))
			(if (u32.eqz (local result)) (then (return (call callable_type_error (call entry_at (array.load (local nodes) (local type_node)) -1i32 23u32)))))
			(let first (struct.get (local head) params))
			(let-mut index (local first))
			(while
				(:doc "Check the unnamed parameter types in written order.")
				(i32.not-ltz (local index))
				(body
					(let item (array.load (local nodes) (local index)))
					(if (u32.eqz (call scalar_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local index)))
						(then (return (call callable_type_error (call entry_at (local item) -1i32 23u32)))))
					(set (local index) (struct.get (local item) next_sibling))))
			(return (struct.new CallableShape (first (local first)) (result (local result)) (named (bool false))
				(start (struct.get (local node) start)) (end (struct.get (local node) end)) (error 0u32)))))

	(fn same_callable_parameters
		(:doc "Compare two parameter lists by exact type and arity, ignoring defining names.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (left CallableShape) (right CallableShape))
		(returns bool)
		(body
			(let-mut a (struct.get (local left) first))
			(let-mut b (struct.get (local right) first))
			(while
				(:doc "Each position must carry the same exact scalar type.")
				(bool.and (i32.not-ltz (local a)) (i32.not-ltz (local b)))
				(body
					(if
						(:doc "A mismatch in one position makes the whole signature distinct.")
						(u32.not-eq
							(call callable_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local a) (struct.get (local left) named))
							(call callable_parameter_type (borrow-shared (local source)) (borrow-shared (local nodes)) (local b) (struct.get (local right) named)))
						(then (return (bool false))))
					(set (local a) (struct.get (array.load (local nodes) (local a)) next_sibling))
					(set (local b) (struct.get (array.load (local nodes) (local b)) next_sibling))))
			(return (i32.eq (local a) (local b)))))
)
