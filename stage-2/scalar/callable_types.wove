(module scalar_callable_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read the checked scalar signature of a Wove function value.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../hashing/fnv1a.wove" (only fnv1a_byte fnv1a_u32_le (value fnv1a_seed)))
	(use wove-file "../emit/names.wove" (only (value callable_role)))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword scalar_type (value fn_type_kind) (type EntryRead)))
	(use wove-file "./signatures.wove" (only read_signature_head))

	(struct CallableShape (fields (first i32) (result u32) (named bool) (start i32) (end i32) (error u32)))

	(fn callable_type_error
		(:doc "Retain the exact operand that made the signature invalid.")
		(params (error EntryRead)) (returns CallableShape)
		(body
			(return (CallableShape.new (first -1i32) (result 0u32) (named (bool false))
				(start error/start) (end error/end) (error error/error)))))

	(fn callable_parameter_type
		(:doc "Read the scalar type of either an unnamed callable parameter or a named Wove formal.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (named bool))
		(returns u32)
		(body
			(let-mut type_node index)
			(if
				(:doc "A defining function spells each type after its parameter name.")
				named
				(then
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
						(nodes.get index)))
					(set type_node parts/operands)))
			(return (call scalar_type (borrow-shared source) (borrow-shared nodes) type_node))))

	(fn read_callable_type
		(:doc "Require a parameter list of scalar types and exactly one scalar or void result.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns CallableShape)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node fn_type_kind 23u32))
			(if form/error.gtz (then (return (call callable_type_error form))))
			(let head (call read_signature_head (borrow-shared source) (borrow-shared nodes)
				node form/operand (bool false) (bool false)))
			(if
				(:doc "Keep the shared reader's diagnostic at the original signature field.")
				head/error.gtz
				(then (return (CallableShape.new (first -1i32) (result 0u32) (named (bool false))
					(start head/start) (end head/end) (error head/error)))))
			(if
				(:doc "A signature type has no body.")
				head/body.not-ltz
				(then (return (call callable_type_error
					(call entry_at (nodes.get head/body) -1i32 23u32)))))
			(let type_node head/type_node)
			(let-mut result (call scalar_type (borrow-shared source) (borrow-shared nodes) type_node))
			(if
				(:doc "Void is valid only as the result type.")
				(u32:eq (call entry_keyword (borrow-shared source) (borrow-shared nodes) type_node)
					(call void_type))
				(then (set result (call void_type))))
			(if result.eqz (then (return (call callable_type_error (call entry_at (nodes.get type_node) -1i32 23u32)))))
			(let first head/params)
			(let-mut index first)
			(while
				(:doc "Check the unnamed parameter types in written order.")
				index.not-ltz
				(body
					(let item (nodes.get index))
					(if (u32:eqz (call scalar_type (borrow-shared source) (borrow-shared nodes) index))
						(then (return (call callable_type_error (call entry_at item -1i32 23u32)))))
					(set index item/next_sibling)))
			(return (CallableShape.new (first first) (result result) (named (bool false))
				(start node/start) (end node/end) (error 0u32)))))

	(fn callable_identity
		(:doc "Hash the result and ordered parameter types as fixed-width words terminated by zero, which is not a valid type.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (shape CallableShape))
		(returns u32)
		(body
			(let-mut identity (call fnv1a_u32_le (call fnv1a_byte fnv1a_seed callable_role)
				shape/result))
			(let-mut index shape/first)
			(while
				(:doc "Use the checked type code regardless of how a parameter was written.")
				index.not-ltz
				(body
					(let type (call callable_parameter_type (borrow-shared source) (borrow-shared nodes)
						index shape/named))
					(set identity (call fnv1a_u32_le identity type))
					(set index (struct:get (nodes.get index) next_sibling))))
			(return (call fnv1a_u32_le identity 0u32))))

	(fn order_callable_signatures
		(:doc "Compare exact result types, then ordered parameter types with shorter equal prefixes first.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (left CallableShape) (right CallableShape))
		(returns i32)
		(body
			(let result (i32:sub (i32:from-u32 left/result) (i32:from-u32 right/result)))
			(if result.not-eqz (then (return result)))
			(let-mut a left/first)
			(let-mut b right/first)
			(while
				(:doc "Each position must carry the same exact scalar type.")
				(a.not-ltz.and b.not-ltz)
				(body
					(let first (call callable_parameter_type (borrow-shared source) (borrow-shared nodes) a left/named))
					(let second (call callable_parameter_type (borrow-shared source) (borrow-shared nodes) b right/named))
					(let order (i32:sub (i32:from-u32 first) (i32:from-u32 second)))
					(if order.not-eqz (then (return order)))
					(set a (struct:get (nodes.get a) next_sibling))
					(set b (struct:get (nodes.get b) next_sibling))))
			(if (a.eq b) (then (return 0i32)))
			(if a.ltz (then (return -1i32)))
			(return 1i32)))
)
