(module scalar_worker
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the exact Wove values transferred to and from named workers.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_builtin_scalar))
	(use wove-file "./loans.wove" (only (type ScalarExpression)))
	(use wove-file "./syntax.wove" (only (value worker_join_all_kind) (value worker_try_spawn_kind)))
	(use wove-file "./records.wove" (only array_owner_element is_array_owner is_enum_layout is_fixed_array
		is_generic_template is_native_record is_payload_enum is_record_type is_specialization_alias member_value_type record_index record_type
		(type ScalarRecord)))

	(fn worker_payload
		(:doc "Visit the checked layout graph and reject borrowed or native values reachable from a worker endpoint.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32) (visited (mut-array u8)))
		(returns bool)
		(body
			(if (call is_builtin_scalar (local type)) (then (return (bool true))))
			(if
				(:doc "Owning descriptor edges also carry their exact element type.")
				(call is_array_owner (local type))
				(then (return (call worker_payload (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (call array_owner_element (borrow-shared (local records)) (local type))
					(borrow-mut (local visited))))))
			(if (bool.not (call is_record_type (local type))) (then (return (bool false))))
			(let index (call record_index (local type)))
			(let layout (array.load (local records) (local index)))
			(if
				(:doc "Opaque native records and scoped records with a byte loan cannot cross the boundary.")
				(bool.or (call is_native_record (local layout))
					(bool.or (struct.get (local layout) borrows_bytes) (call is_generic_template (local layout))))
				(then (return (bool false))))
			(if
				(:doc "Visit each layout once, even when an owned member leads back to an active layout.")
				(bool.not (u8.eq (array.load (local visited) (local index)) 0u8))
				(then (return (bool true))))
			(array.store (local visited) (local index) 1u8)
			(if
				(:doc "A repeated specialization can share the defining layout.")
				(call is_specialization_alias (local layout))
				(then (return (call worker_payload (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings))
					(call record_type (struct.get (local layout) alias_of)) (borrow-mut (local visited))))))
			(if
				(:doc "Fixed arrays carry their element in the checked layout rather than a named field.")
				(call is_fixed_array (local layout))
				(then (return (call worker_payload (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings))
					(u32.from-i32 (struct.get (local layout) first)) (borrow-mut (local visited))))))
			(if
				(:doc "A unit enum has an ordinary Wove tag and no payload storage.")
				(bool.and (call is_enum_layout (local layout)) (bool.not (call is_payload_enum (local layout))))
				(then (return (bool true))))
			(let-mut field (struct.get (local layout) first))
			(while
				(:doc "Inspect every checked record field and every populated enum variant.")
				(i32.not-ltz (local field))
				(body
					(let member (array.load (local nodes) (local field)))
					(let child (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (local member)))
					(if
						(:doc "Only empty enum variants lack a checked member type.")
						(bool.not (bool.or (bool.and (u32.eqz (local child)) (call is_payload_enum (local layout)))
							(call worker_payload (borrow-shared (local source)) (borrow-shared (local nodes))
								(borrow-shared (local records)) (borrow-shared (local bindings)) (local child) (borrow-mut (local visited)))))
						(then (return (bool false))))
					(set (local field) (struct.get (local member) next_sibling))))
			(return (bool true))))

	(fn is_worker_record
		(:doc "An ordinary record endpoint uses a named Wove struct with its real by-value ABI.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(if (bool.not (call is_record_type (local type))) (then (return (bool false))))
			(let layout (array.load (local records) (call record_index (local type))))
			(return (bool.and (i32.gtz (struct.get (local layout) name))
				(i32.eqz (struct.get (local layout) native))))))

	(fn worker_endpoint
		(:doc "Worker endpoints have either the direct array ABI or a named Wove struct layout.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool.or (call is_array_owner (local type))
				(call is_worker_record (borrow-shared (local records)) (local type))))))

	(fn worker_signature
		(:doc "Check both exact endpoints and reject every reachable foreign value or borrow.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (job u32) (result u32))
		(returns bool)
		(body
			(if
				(:doc "Dedicated and pooled handlers use the same exact endpoint types.")
				(bool.not (bool.and
					(call worker_endpoint (borrow-shared (local records)) (local job))
					(call worker_endpoint (borrow-shared (local records)) (local result))))
				(then (return (bool false))))
			(let-mut visited (array.alloc u8 (array.len (local records))))
			(return (bool.and (call worker_payload (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local job) (borrow-mut (local visited)))
				(call worker_payload (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local records)) (borrow-shared (local bindings)) (local result) (borrow-mut (local visited)))))))

	(fn worker_receipt_result
		(:doc "Mark the launch transport in the sign of the exact result code.")
		(params (job u32) (result u32))
		(returns i32)
		(body
			(let code (i32.from-u32 (local result)))
			(if
				(:doc "Array-to-array workers use their direct ABI. Other workers need an adapter.")
				(bool.and (call is_array_owner (local job)) (call is_array_owner (local result)))
				(then (return (local code))))
			(return (i32.sub 0i32 (local code)))))

	(fn worker_result_type
		(:doc "Recover the exact value type independently of the handler transport.")
		(params (code i32))
		(returns u32)
		(body
			(if (i32.ltz (local code)) (then (return (u32.from-i32 (i32.sub 0i32 (local code))))))
			(return (u32.from-i32 (local code)))))

	(fn worker_collection_record
		(:doc "Resolve the exact record element only for a checked batch collection.")
		(params (row ScalarExpression))
		(returns u32)
		(body
			(if
				(:doc "Other expression rows use their auxiliary operands for unrelated values.")
				(u32.eq (struct.get (local row) kind) (local worker_join_all_kind))
				(then
					(let element (u32.from-i32 (struct.get (local row) asset_end)))
					(if (call is_record_type (local element)) (then (return (local element))))))
			(return 0u32)))

	(fn worker_queue_loan
		(:doc "A launch holds its queue exclusively until its job operand has finished evaluating.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(index i32) (statement i32) (binding i32))
		(returns bool)
		(body
			(let-mut child (local index))
			(while
				(:doc "Compare the defining queue binding at each enclosing fallible launch.")
				(i32.not-eq (local child) (local statement))
				(body
					(let parent (struct.get (array.load (local nodes) (local child)) parent))
					(let operation (array.load (local expressions) (local parent)))
					(if
						(:doc "Only the evaluated job lies inside the launch's exclusive loan.")
						(bool.and (u32.eq (struct.get (local operation) kind) (local worker_try_spawn_kind))
							(bool.and (i32.eq (struct.get (local operation) first) (local child))
								(i32.eq (struct.get (local operation) projection) (local binding))))
						(then (return (bool true))))
					(set (local child) (local parent))))
			(return (bool false))))
)
