(module scalar_worker
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the exact Wove values transferred to and from named workers.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_builtin_scalar))
	(use wove-file "./loans.wove" (only (type ScalarExpression)))
	(use wove-file "./syntax.wove" (only (value worker_join_all_kind) (value worker_try_spawn_kind)))
	(use wove-file "./records.wove" (only array_owner_element is_array_owner is_enum_layout is_fixed_array
		is_generic_template is_native_record is_payload_enum is_record_type is_specialization_alias member_value_type record_index record_type
		(type ScalarRecord)))

	(fn worker_payload
		(:doc "Visit the checked layout graph and reject borrowed or native values reachable from a worker endpoint.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (type u32) (visited (mut-array u8)))
		(returns bool)
		(body
			(if (call is_builtin_scalar type) (then (return (bool true))))
			(if
				(:doc "Owning descriptor edges also carry their exact element type.")
				(call is_array_owner type)
				(then (return (call worker_payload (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) (call array_owner_element (borrow-shared records) type)
					(borrow-mut visited)))))
			(if (bool:not (call is_record_type type)) (then (return (bool false))))
			(let index (call record_index type))
			(let layout (records.get index))
			(if
				(:doc "Opaque native records and scoped records with a byte loan cannot cross the boundary.")
				(bool:or (call is_native_record layout)
					(layout/borrows_bytes.or (call is_generic_template layout)))
				(then (return (bool false))))
			(if
				(:doc "Visit each layout once, even when an owned member leads back to an active layout.")
				(bool:not (u8:eq (visited.get index) 0u8))
				(then (return (bool true))))
			(visited.set index 1u8)
			(if
				(:doc "A repeated specialization can share the defining layout.")
				(call is_specialization_alias layout)
				(then (return (call worker_payload (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings)
					(call record_type layout/alias_of) (borrow-mut visited)))))
			(if
				(:doc "Fixed arrays carry their element in the checked layout rather than a named field.")
				(call is_fixed_array layout)
				(then (return (call worker_payload (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings)
					(u32:from-i32 layout/first) (borrow-mut visited)))))
			(if
				(:doc "A unit enum has an ordinary Wove tag and no payload storage.")
				(bool:and (call is_enum_layout layout) (bool:not (call is_payload_enum layout)))
				(then (return (bool true))))
			(let-mut field layout/first)
			(while
				(:doc "Inspect every checked record field and every populated enum variant.")
				field.not-ltz
				(body
					(let member (nodes.get field))
					(let child (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout member))
					(if
						(:doc "Only empty enum variants lack a checked member type.")
						(bool:not (bool:or (bool:and child.eqz (call is_payload_enum layout))
							(call worker_payload (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (borrow-shared bindings) child (borrow-mut visited))))
						(then (return (bool false))))
					(set field member/next_sibling)))
			(return (bool true))))

	(fn is_worker_record
		(:doc "An ordinary record endpoint uses a named Wove struct with its real by-value ABI.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(if (bool:not (call is_record_type type)) (then (return (bool false))))
			(let layout (records.get (call record_index type)))
			(return (bool:and layout/name.gtz
				layout/native.eqz))))

	(fn worker_endpoint
		(:doc "Worker endpoints have either the direct array ABI or a named Wove struct layout.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool:or (call is_array_owner type)
				(call is_worker_record (borrow-shared records) type)))))

	(fn worker_signature
		(:doc "Check both exact endpoints and reject every reachable foreign value or borrow.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (job u32) (result u32))
		(returns bool)
		(body
			(if
				(:doc "Dedicated and pooled handlers use the same exact endpoint types.")
				(bool:not (bool:and
					(call worker_endpoint (borrow-shared records) job)
					(call worker_endpoint (borrow-shared records) result)))
				(then (return (bool false))))
			(let-mut visited (array:alloc u8 records.len))
			(return (bool:and (call worker_payload (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) job (borrow-mut visited))
				(call worker_payload (borrow-shared source) (borrow-shared nodes)
					(borrow-shared records) (borrow-shared bindings) result (borrow-mut visited))))))

	(fn worker_receipt_result
		(:doc "Mark the launch transport in the sign of the exact result code.")
		(params (job u32) (result u32))
		(returns i32)
		(body
			(let code (i32:from-u32 result))
			(if
				(:doc "Array-to-array workers use their direct ABI. Other workers need an adapter.")
				(bool:and (call is_array_owner job) (call is_array_owner result))
				(then (return code)))
			(return (i32:sub 0i32 code))))

	(fn worker_result_type
		(:doc "Recover the exact value type independently of the handler transport.")
		(params (code i32))
		(returns u32)
		(body
			(if code.ltz (then (return (u32:from-i32 (i32:sub 0i32 code)))))
			(return (u32:from-i32 code))))

	(fn worker_collection_record
		(:doc "Resolve the exact record element only for a checked batch collection.")
		(params (row ScalarExpression))
		(returns u32)
		(body
			(if
				(:doc "Other expression rows use their auxiliary operands for unrelated values.")
				(row/kind.eq worker_join_all_kind)
				(then
					(let element (u32:from-i32 row/asset_end))
					(if (call is_record_type element) (then (return element)))))
			(return 0u32)))

	(fn worker_queue_loan
		(:doc "A launch holds its queue exclusively until its job operand has finished evaluating.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(index i32) (statement i32) (binding i32))
		(returns bool)
		(body
			(let-mut child index)
			(while
				(:doc "Compare the defining queue binding at each enclosing fallible launch.")
				(child.not-eq statement)
				(body
					(let parent (struct:get (nodes.get child) parent))
					(let operation (expressions.get parent))
					(if
						(:doc "Only the evaluated job lies inside the launch's exclusive loan.")
						(bool:and (operation/kind.eq worker_try_spawn_kind)
							(bool:and (operation/first.eq child)
								(operation/projection.eq binding)))
						(then (return (bool true))))
					(set child parent)))
			(return (bool false))))
)
