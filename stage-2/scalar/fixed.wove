(module scalar_fixed
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check fixed-array initializers, loans, and indexed access to inline storage.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "./flow.wove" (only (type ScalarStatement) (value fixed_shared_loan) (value fixed_mut_loan)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./loans.wove" (only (type ScalarExpression) expression_row runtime_expression writable_place
		check_writable_field fixed_access_base has_conflicting_loan))
	(use wove-file "./records.wove" (only (type ScalarRecord) fixed_array_type invalid_array_type
		record_index is_fixed_array is_record_type record_receiver_type is_array_owner is_place_reference
		place_reference_type place_reference_target is_readable_slice is_writable_slice slice_element_code owner_view_type))
	(use wove-file "./syntax.wove" (only (type EntryRead) entry_at entry_keyword is_reborrow_keyword
		(value fixed_subarray_place) (value fixed_owner_take) (value fixed_owner_borrow)
		(value fixed_owner_store) (value pending_exact_move) (value fixed_take_request)))
	(use wove-file "./value_types.wove" (only value_matches_type))

	(fn plan_fixed_slice_loan
		(:doc `Lend a fixed array in its original local or projected storage.`)
		(params (nodes (shared-array SourceNode)) (reference SourceNode) (index i32) (statement i32)
			(expected u32) (array_type u32) (binding ScalarExpression) (place i32)
			(records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "Only registered fixed layouts provide an inline array view.")
				(bool:not (call is_record_type array_type))
				(then (return (call entry_at reference -1i32 24u32))))
			(let-mut type expected)
			(if
				(:doc "Byte borrow keywords are adjacent to their corresponding descriptor type codes.")
				(call is_reborrow_keyword expected)
				(then (set type expected.dec)))
			(let layout (records.get (call record_index array_type)))
			(let writable (call is_writable_slice type))
			(if
				(:doc "A whole inline view needs copyable elements laid out like the requested slice.")
				(bool:or (bool:or (bool:not (call is_fixed_array layout)) layout/owns_arrays)
					(bool:or (i32:not-eq layout/first (i32:from-u32 (call slice_element_code type)))
						(writable.and (bool:not (call writable_place binding)))))
				(then (return (call entry_at reference -1i32 24u32))))
			(let target binding/target)
			(let local_binding (u32:eq binding/kind 6u32))
			(if
				(:doc "Earlier arguments retain their overlapping loans until the call returns.")
				(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions) (borrow-shared statements)
					index statement target local_binding place writable)
				(then (return (call entry_at reference -1i32 24u32))))
			(let-mut kind fixed_shared_loan)
			(if writable (then (set kind fixed_mut_loan)))
			(expressions.set index
				(struct:new ScalarExpression (kind kind) (type type) (target target)
					(first -1i32) (start layout/count) (end 0i32) (negative (bool false))
					(borrowed_owner local_binding) (mutable_place (bool false)) (projection place)
					(asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at reference index 0u32))))

	(fn plan_fixed_initializer
		(:doc `Seed the typed list or the one repeated value from an exact array layout.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (kind u32) (first i32) (expected u32) (records (shared-array ScalarRecord))
			(expressions (mut-array ScalarExpression)) (bindings (shared-array GraphBinding)) (file i32) (source_base i32))
		(returns EntryRead)
		(body
			(if first.ltz (then (return (call entry_at node -1i32 24u32))))
			(let spelling (nodes.get first))
			(let type (call fixed_array_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) spelling (borrow-shared bindings) file source_base))
			(if
				(:doc "The initializer spells its exact element and extent even when its type is inferred.")
				type.eqz
				(then (return (call invalid_array_type (borrow-shared source) (borrow-shared nodes)
					spelling (borrow-shared bindings) file source_base))))
			(return (call seed_fixed_initializer (borrow-shared source) (borrow-shared nodes) node index
				kind spelling type expected
				(borrow-shared records) (borrow-mut expressions)))))

	(fn seed_fixed_initializer
		(:doc `Apply a resolved fixed layout to the children of a list or repeat.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (index i32) (kind u32)
			(spelling SourceNode) (type u32) (expected u32) (records (shared-array ScalarRecord))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "The enclosing use must accept the complete structural type.")
				(bool:not (call value_matches_type expected type))
				(then (return (call entry_at node -1i32 24u32))))
			(let layout (records.get (call record_index type)))
			(let element (u32:from-i32 layout/first))
			(let owning layout/owns_arrays)
			(if
				(:doc "Repeating any owning element would duplicate its storage.")
				(owning.and (kind.eq 72u32))
				(then (return (call entry_at node -1i32 24u32))))
			(let values spelling/next_sibling)
			(let-mut operand values)
			(let-mut remaining layout/count)
			(if (kind.eq 72u32) (then (set remaining 1i32)))
			(while
				(:doc "Seed elements left to right and require the exact operand count.")
				(bool:and remaining.gtz (i32:lt -1i32 operand))
				(body
					(let-mut operand_kind 0u32)
					(if
						(:doc "A fixed owning initializer takes the exact source owner once.")
						owning
						(then
							(let child (nodes.get operand))
							(let form (call form_parts (borrow-shared source) (borrow-shared nodes) child))
							(if
								(:doc "Explicit moves use the ordinary evaluating transfer checks.")
								(u32:eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
									form/head) 43u32)
								(then (set operand_kind pending_exact_move)))))
					(expressions.set operand
						(call expression_row operand_kind element -1i32 -1i32 0i32 0i32 (bool false)))
					(set operand (struct:get (nodes.get operand) next_sibling))
					(set remaining remaining.dec)))
			(if
				(:doc "Report a list length mismatch or extra repeat operand at the initializer.")
				(bool:or remaining.gtz (i32:lt -1i32 operand))
				(then (return (call entry_at node -1i32 24u32))))
			(expressions.set index
				(call expression_row kind type -1i32 values 0i32 0i32 (bool false)))
			(return (call entry_at node index 0u32))))

	(fn store_fixed_access
		(:doc "Record the checked slot operation and the original source span used by its bounds check.")
		(params (node SourceNode) (caller ScalarFunction) (receiver i32) (index i32) (kind u32) (type u32)
			(view_start i32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(expressions.set index
				(call runtime_expression kind type node receiver caller view_start))
			(return (call entry_at node index 0u32))))

	(fn finish_heap_fixed_access
		(:doc "Keep an owning fixed element in its heap slot or transfer it from the original owner.")
		(params (node SourceNode) (reference SourceNode) (caller ScalarFunction) (receiver i32) (index i32)
			(element u32) (moving bool) (writable bool) (view_start i32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(if
				(:doc "A mutable view can lend a place. A take must come directly from a mutable owner.")
				moving
				(then
					(if
						(:doc "The direct owner produces a mutable owner loan in the checked receiver row.")
						(u32:not-eq (struct:get (expressions.get receiver) kind) 39u32)
						(then (return (call entry_at reference -1i32 24u32))))
					(return (call store_fixed_access node caller receiver index
						fixed_owner_take element view_start (borrow-mut expressions)))))
			(return (call store_fixed_access node caller receiver index
				fixed_subarray_place (call place_reference_type element writable)
				view_start (borrow-mut expressions)))))

	(fn finish_owned_fixed_access
		(:doc "Check the original inline owner and plan a loan, transfer, or replacement of its exact element.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (reference SourceNode)
			(caller ScalarFunction) (receiver i32) (value i32) (index i32) (kind u32) (expected u32) (writable bool)
			(statement i32) (view_start i32) (layout ScalarRecord) (records (shared-array ScalarRecord))
			(statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let base (call fixed_access_base (borrow-shared expressions) receiver))
			(let place (expressions.get base))
			(let-mut home base)
			(let-mut path -1i32)
			(if
				(:doc "A projected fixed field keeps its path under the original record place.")
				(u32:eq place/kind 52u32)
				(then
					(set home place/projection)
					(set path base)))
			(if home.ltz (then (return (call entry_at reference -1i32 24u32))))
			(let binding (expressions.get home))
			(let type binding/type)
			(let heap (call is_readable_slice type))
			(let kind_of_binding binding/kind)
			(let local_binding (bool:or (kind_of_binding.eq 6u32)
				(heap.and binding/borrowed_owner)))
			(let moving (expected.eq fixed_take_request))
			(let-mut can_move local_binding)
			(let-mut can_write (call writable_place binding))
			(if
				(:doc "A heap projection inherits descriptor permissions and only a direct owner permits a nested take.")
				heap
				(then
					(set can_move (kind_of_binding.eq 39u32))
					(set can_write (call is_writable_slice type))))
			(if
				(:doc "Access stays tied to its original place, including an owning heap element's captured view.")
				(bool:or
					(bool:or (bool:not (heap.or (local_binding.or (call is_place_reference type))))
						(moving.and can_move.not))
					(bool:or (writable.and can_write.not)
						(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions)
							(borrow-shared statements) receiver statement
							binding/target local_binding path writable)))
				(then (return (call entry_at reference -1i32 24u32))))
			(if
				(:doc "Fixed length counts all slots even after an individual element has moved.")
				(kind.eq 36u32)
				(then (return (call store_fixed_access node caller receiver index
					36u32 5u32 view_start (borrow-mut expressions)))))
			(let element (u32:from-i32 layout/first))
			(if
				(:doc "Replacement installs one exact fresh or explicitly moved owner.")
				(kind.eq 40u32)
				(then
					(let child (nodes.get value))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) child))
					(let tag (call entry_keyword (borrow-shared source) (borrow-shared nodes) parts/head))
					(let-mut seed 0u32)
					(if (tag.eq 43u32) (then (set seed pending_exact_move)))
					(expressions.set value
						(call expression_row seed element -1i32 -1i32 0i32 0i32 (bool false)))
					(return (call store_fixed_access node caller receiver index
						fixed_owner_store 0u32 view_start (borrow-mut expressions)))))
			(if
				(:doc "Transfer the selected owner and clear its presence.")
				moving
				(then (return (call store_fixed_access node caller receiver index
					fixed_owner_take element view_start (borrow-mut expressions)))))
			(if
				(:doc "Another fixed subscript uses the stored inner array as an original place.")
				(bool:and (bool:or (expected.eq 55u32) (expected.eq 56u32))
					(bool:and (call is_record_type element)
						(call is_fixed_array (records.get (call record_index element)))))
				(then (return (call store_fixed_access node caller receiver index
					fixed_subarray_place (call place_reference_type element writable)
					view_start (borrow-mut expressions)))))
			(if
				(:doc "A heap element lends its exact descriptor through an explicit shared or mutable loan.")
				(bool:and (call is_array_owner element) (call is_reborrow_keyword expected))
				(then (return (call store_fixed_access node caller receiver index
					fixed_owner_borrow (call owner_view_type element writable)
					view_start (borrow-mut expressions)))))
			(if
				(:doc "A named record lends a reference only at its exact nominal type.")
				(bool:and (call is_place_reference expected)
					(element.eq (call place_reference_target (borrow-shared records) expected)))
				(then (return (call store_fixed_access node caller receiver index
					fixed_owner_borrow expected view_start (borrow-mut expressions)))))
			(return (call entry_at node -1i32 24u32))))

	(fn finish_fixed_access
		(:doc `Complete an access to checked inline storage, retaining writable places for stores.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (reference SourceNode) (caller ScalarFunction)
			(receiver i32) (value i32) (index i32) (kind u32) (expected u32) (projected bool) (view_start i32)
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let store (kind.eq 40u32))
			(let array (expressions.get receiver))
			(let type (call record_receiver_type array/type))
			(let projecting (bool:and (kind.eq 37u32) (expected.eq 56u32)))
			(if
				(:doc "Only a fixed value has a statically checked extent.")
				(bool:not (bool:and (call is_record_type type)
					(call is_fixed_array (records.get (call record_index type)))))
				(then (return (call entry_at reference -1i32 24u32))))
			(let layout (records.get (call record_index type)))
			(if
				(:doc "An owning fixed temporary must be bound before any projected access.")
				layout/owns_arrays
				(then (return (call entry_at reference -1i32 24u32))))
			(if
				(:doc "A length reads the registered extent after any receiver evaluation.")
				(kind.eq 36u32)
				(then
					(expressions.set index
						(call runtime_expression 36u32 5u32 node receiver caller view_start))
					(return (call entry_at node index 0u32))))
			(let-mut lowered 73u32)
			(if store (then (set lowered 74u32)))
			(let element (u32:from-i32 layout/first))
			(let-mut result element)
			(if
				(:doc "An update or subarray projection must retain the original writable place.")
				(store.or projecting)
				(then
					(if
						(:doc "A projected destination follows the same writable-place rules as field assignment.")
						projected
						(then
							(let place (call check_writable_field (borrow-shared nodes)
								receiver (borrow-shared records) (borrow-shared expressions)))
							(if
								(:doc "Preserve the source of an invalid or immutable field place.")
								(u32:gtz place/error)
								(then (return place))))
						(else
							(if
								(:doc "A destination has writable local storage or a checked subarray address.")
								(bool:not (bool:or array/mutable_place
									(u32:eq array/kind fixed_subarray_place)))
								(then (return (call entry_at reference -1i32 24u32))))))
					(if
						(:doc "Capture an inner array's address when an enclosing store needs the original row.")
						projecting
						(then
							(if
								(:doc "The enclosing access needs another complete fixed layout.")
								(bool:not (bool:and (call is_record_type element)
									(call is_fixed_array (records.get (call record_index element)))))
								(then (return (call entry_at node -1i32 24u32))))
							(set lowered fixed_subarray_place)
							(set result (call place_reference_type element (bool true))))
						(else
							(expressions.set value
								(call expression_row 0u32 element -1i32 -1i32 0i32 0i32 (bool false)))
							(set result 0u32))))
				(else
					(if
						(:doc "A load must provide the element type required by its enclosing expression.")
						(bool:not (call value_matches_type expected element))
						(then (return (call entry_at node -1i32 24u32))))))
			(expressions.set index
				(call runtime_expression lowered result node receiver caller view_start))
			(return (call entry_at node index 0u32)))))
