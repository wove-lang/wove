(module specialization_key_order
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Order exact declaration and specialization keys independently of the packed graph rows.")

	(use wove-file "../../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../../source/generics.wove" (only (value generic_operation_kind)))
	(use wove-file "../trees.wove" (only source_span_owner))
	(use wove-file "../records.wove" (only check_generic_argument is_record_type record_index is_fixed_array is_native_integer native_integer_index resolved_generic_kind is_array_owner array_owner_element
		specialization_first scope_at (type ScalarRecord) (type TypeScope)))

	(struct ApplicationSite (fields (row i32) (file i32) (base i32)))

	(fn application_site
		(:doc "Keep the application row and the lexical namespace where its arguments resolve.")
		(params (row i32) (file i32) (base i32)) (returns ApplicationSite)
		(body (return (struct:new ApplicationSite (row row) (file file) (base base)))))

	(fn order_words
		(:doc "Order exact unsigned keys without an overflowing subtraction.")
		(params (left u32) (right u32)) (returns i32)
		(body
			(if (u32:lt left right) (then (return -1i32)))
			(if (u32:eq left right) (then (return 0i32)))
			(return 1i32)))

	(fn order_paths
		(:doc "Compare the canonical paths byte for byte, keeping a prefix before a longer path.")
		(params (arena (shared-array u8)) (left SuppliedFile) (right SuppliedFile)) (returns i32)
		(body
			(let-mut a (struct:get left path_start))
			(let-mut b (struct:get right path_start))
			(let end_a (struct:get left path_end))
			(let end_b (struct:get right path_end))
			(while
				(:doc "Only read bytes in both canonical path spans.")
				(bool:and (i32:lt a end_a) (i32:lt b end_b))
				(body
					(let difference (i32:sub (i32:from-u8 (arena.get a))
						(i32:from-u8 (arena.get b))))
					(if (i32:not-eqz difference) (then (return difference)))
					(set a (i32:inc a))
					(set b (i32:inc b))))
			(return (i32:sub (i32:sub end_a a) (i32:sub end_b b)))))

	(fn order_definitions
		(:doc "Compare the canonical defining file and original declaration position.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(left_file i32) (left i32) (right_file i32) (right i32)) (returns i32)
		(body
			(if
				(:doc "Only graph compilation can compare definitions from different files.")
				(i32:not-eq left_file right_file)
				(then (return (call order_paths (borrow-shared arena)
					(files.get left_file) (files.get right_file)))))
			(return (i32:sub (struct:get (nodes.get left) start)
				(struct:get (nodes.get right) start)))))

	(fn order_record_keys
		(:doc "Order nominal record keys by their template definition and, for instances, their exact arguments.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(left ScalarRecord) (right ScalarRecord)) (returns i32)
		(body
			(let file (struct:get left file))
			(let definition (call order_definitions (borrow-shared arena) (borrow-shared files) (borrow-shared nodes)
				file (struct:get left name) (struct:get right file) (struct:get right name)))
			(if (i32:not-eqz definition) (then (return definition)))
			(let a (struct:get left specialization))
			(let b (struct:get right specialization))
			(if
				(:doc "The defining template precedes any instantiation of that same declaration.")
				(bool:or (i32:ltz a) (i32:ltz b))
				(then (return (i32:sub a b))))
			(return (call order_application_keys (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
				(call application_site a (struct:get left argument_file) (struct:get left argument_base))
				(call application_site b (struct:get right argument_file) (struct:get right argument_base))
				(struct:get left generic) (call scope_at file (struct:get left source_base)) (bool true)))))

	(fn order_arguments
		(:doc "Compare two normalized arguments of a single formal parameter.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(kind u32) (left u32) (right u32)) (returns i32)
		(body
			(if (u32:eq left right) (then (return 0i32)))
			(if
				(:doc "A compile-time operation carries a canonical defining node in the original source tree.")
				(u32:eq kind generic_operation_kind)
				(then
					(let a (i32:from-u32 left))
					(let b (i32:from-u32 right))
					(let a_file (call source_span_owner (borrow-shared files) (struct:get (nodes.get a) start) -1i32))
					(let b_file (call source_span_owner (borrow-shared files) (struct:get (nodes.get b) start) -1i32))
					(return (call order_definitions (borrow-shared arena) (borrow-shared files)
						(borrow-shared nodes) a_file a b_file b))))
			(if
				(:doc "Type arguments order by exact structure before comparing any terminal nominal keys.")
				(u32:eq kind 1u32)
				(then (return (call order_generic_types (borrow-shared arena) (borrow-shared files)
					(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
					left right))))
			(return (call order_words left right))))

	(fn order_layout_keys
		(:doc "Order fixed layouts by extent and exact element type, and named layouts by their defining keys.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(left ScalarRecord) (right ScalarRecord)) (returns i32)
		(body
			(if
				(:doc "Fixed layouts have no declaration span, so only their shape can order them.")
				(call is_fixed_array left)
				(then
					(if (bool:not (call is_fixed_array right)) (then (return -1i32)))
					(let extent (i32:sub (struct:get left count) (struct:get right count)))
					(if (i32:not-eqz extent) (then (return extent)))
					(return (call order_generic_types (borrow-shared arena) (borrow-shared files)
						(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
						(u32:from-i32 (struct:get left first)) (u32:from-i32 (struct:get right first))))))
			(if (call is_fixed_array right) (then (return 1i32)))
			(return (call order_record_keys (borrow-shared arena) (borrow-shared files)
				(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings) left right))))

	(fn order_generic_types
		(:doc "Compare owner depth and then exact element keys without using temporary layout indices to break ties.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (left u32) (right u32)) (returns i32)
		(body
			(let-mut a left)
			(let-mut b right)
			(while
				(:doc "Shared descriptor layers leave the order to their elements.")
				(bool:and (call is_array_owner a) (call is_array_owner b))
				(body
					(set a (call array_owner_element (borrow-shared records) a))
					(set b (call array_owner_element (borrow-shared records) b))))
			(if (call is_array_owner a) (then (return 1i32)))
			(if (call is_array_owner b) (then (return -1i32)))
			(if (u32:eq a b) (then (return 0i32)))
			(if
				(:doc "Registered layouts may contain further fixed or owner layers.")
				(bool:and (call is_record_type a) (call is_record_type b))
				(then (return (call order_layout_keys (borrow-shared arena) (borrow-shared files)
					(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
					(records.get (call record_index a))
					(records.get (call record_index b))))))
			(if
				(:doc "Two native aliases use their original defining declarations even if they spell the same C type.")
				(bool:and (call is_native_integer a) (call is_native_integer b))
				(then (return (call order_record_keys (borrow-shared arena) (borrow-shared files)
					(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
					(records.get (call native_integer_index a))
					(records.get (call native_integer_index b))))))
			(return (call order_words a b))))

	(fn order_application_keys
		(:doc "Compare two valid applications of the same template in their own lookup contexts.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding))
			(left ApplicationSite) (right ApplicationSite) (parameters i32) (definition_scope TypeScope) (record_arguments bool)) (returns i32)
		(body
			(let-mut a (call specialization_first (borrow-shared arena) (borrow-shared nodes) (struct:get left row)))
			(let-mut b (call specialization_first (borrow-shared arena) (borrow-shared nodes) (struct:get right row)))
			(let-mut formal parameters)
			(while
				(:doc "An earlier differing normalized argument determines the order.")
				(i32:not-ltz formal)
				(body
					(let parameter (nodes.get formal))
					(let kind (call resolved_generic_kind (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) definition_scope parameter))
					(let first (call check_generic_argument (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) (call scope_at (struct:get left file) (struct:get left base)) a kind record_arguments))
					(let second (call check_generic_argument (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) (call scope_at (struct:get right file) (struct:get right base)) b kind record_arguments))
					(let order (call order_arguments (borrow-shared arena) (borrow-shared files)
						(borrow-shared nodes) (borrow-shared records) (borrow-shared bindings)
						kind (struct:get first value) (struct:get second value)))
					(if (i32:not-eqz order) (then (return order)))
					(set a (struct:get (nodes.get a) next_sibling))
					(set b (struct:get (nodes.get b) next_sibling))
					(set formal (struct:get parameter next_sibling))))
			(return 0i32)))
)
