(module function_specialization_clone
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Copy a checked function template to private plan rows and attach its concrete operands.")

	(use wove-file "../../source/generics.wove" (only with_generic_operand
		(value checked_type_operand) (value checked_i32_operand) (value checked_bool_operand) (value checked_enum_operand) (value checked_operation_operand) (value generic_bool_kind) (value generic_operation_kind)))
	(use wove-file "../../source/module.wove" (only form_parts))
	(use wove-file "../../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../records.wove"
		(only check_generic_argument resolved_generic_kind is_record_type specialization_first (type ScalarRecord) (type TypeScope)))
	(use wove-file "../syntax.wove" (only same_name))

	(struct ConcreteOperand (fields (name i32) (kind u8) (value u32)))

	(fn generic_parameter_count
		(:doc "Measure the checked formal list before allocating its substitution bindings.")
		(params (nodes (shared-array SourceNode)) (first i32)) (returns i32)
		(body
			(let-mut count 0i32)
			(let-mut row first)
			(while
				(:doc "Each selected formal has exactly one checked argument.")
				(i32:lt -1i32 row)
				(body
					(set count (i32:inc count))
					(set row (struct:get (array:get nodes row) next_sibling))))
			(return count)))

	(fn collect_concrete_operands
		(:doc "Record each normalized application value once before walking the defining syntax.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (application i32) (parameters i32) (definition_scope TypeScope)
			(operands (mut-array ConcreteOperand))) (returns void)
		(body
			(let-mut formal parameters)
			(let-mut actual (call specialization_first (borrow-shared source) (borrow-shared nodes) application))
			(let-mut index 0i32)
			(while
				(:doc "The application key has already checked operand counts and types.")
				(i32:lt -1i32 formal)
				(body
					(let parameter (array:get nodes formal))
					(let kind (call resolved_generic_kind (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) definition_scope parameter))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) parameter))
					(let checked (call check_generic_argument (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) scope actual kind (bool false)))
					(let-mut annotation checked_type_operand)
					(if (u32:eq kind 2u32) (then (set annotation checked_i32_operand)))
					(if (u32:eq kind generic_bool_kind) (then (set annotation checked_bool_operand)))
					(if (call is_record_type kind) (then (set annotation checked_enum_operand)))
					(if
						(:doc "A substituted compile-time operation retains its original declaration row.")
						(u32:eq kind generic_operation_kind)
						(then (set annotation checked_operation_operand)))
					(array:set operands index (struct:new ConcreteOperand
						(name (struct:get parts name)) (kind annotation) (value (struct:get checked value))))
					(set formal (struct:get parameter next_sibling))
					(set actual (struct:get (array:get nodes actual) next_sibling))
					(set index (i32:inc index))))))

	(fn annotate_concrete_operand
		(:doc "Attach a checked value to a matching bare operand while preserving its original spelling and span.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (operands (shared-array ConcreteOperand)))
		(returns SourceNode)
		(body
			(let node (array:get nodes index))
			(if
				(:doc "Form heads, strings, and other nodes cannot name a substituted operand.")
				(bool:or (u32:not-eq (struct:get node kind) 1u32)
					(i32:eq (struct:get (array:get nodes (struct:get node parent)) first_child) index))
				(then (return node)))
			(let-mut row 0i32)
			(while
				(:doc "Check the declared names from the same defining function.")
				(i32:lt row (array:len operands))
				(body
					(let operand (array:get operands row))
					(if
						(:doc "The same spelling may be used in a value or type position. Consumers check the operand kind.")
						(call same_name (borrow-shared source) node
							(array:get nodes (struct:get operand name)))
						(then (return (call with_generic_operand node (struct:get operand kind)
							(struct:get operand value)))))
					(set row (i32:inc row))))
			(return node)))

	(fn clone_link
		(:doc "Rebase a present internal link while keeping absent links and the original declaration parent.")
		(params (link i32) (first i32) (delta i32)) (returns i32)
		(body
			(if (i32:lt link first) (then (return link)))
			(return (i32:add link delta))))

	(fn clone_function_nodes
		(:doc "Copy one isolated declaration whose runtime signature skips the compile-time parameter list.")
		(params (source (shared-array u8)) (nodes (mut-array SourceNode))
			(first i32) (end i32) (generic i32) (target i32) (operands (shared-array ConcreteOperand))) (returns void)
		(body
			(let delta (i32:sub target first))
			(let following (struct:get (array:get nodes generic) next_sibling))
			(let-mut index first)
			(while
				(:doc "The clone's detached declaration root retains its original lexical ancestry.")
				(i32:lt index end)
				(body
					(let node (call annotate_concrete_operand (borrow-shared source) (borrow-shared nodes)
						index (borrow-shared operands)))
					(let-mut sibling (struct:get node next_sibling))
					(if
						(:doc "Skip the generic list when exposing ordinary fields to the signature checker.")
						(i32:eq sibling generic)
						(then (set sibling following)))
					(if (i32:eq index first) (then (set sibling -1i32)))
					(array:set nodes (i32:add index delta)
						(struct:new SourceNode (kind (struct:get node kind))
							(start (struct:get node start)) (end (struct:get node end))
							(parent (call clone_link (struct:get node parent) first delta))
							(first_child (call clone_link (struct:get node first_child) first delta))
							(next_sibling (call clone_link sibling first delta))
							(bridge_project -1i32) (bridge_default -1i32)
							(generic_kind (struct:get node generic_kind)) (generic_value (struct:get node generic_value))
							(local_identity 0u32) (local_name_slot -1i32)
							(expression_identity 0u32) (expression_slot 0i32)
							(label_identity 0u32) (label_slot 0i32)))
					(set index (i32:inc index))))))
)
