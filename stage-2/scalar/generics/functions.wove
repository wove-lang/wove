(module function_specializations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve, deduplicate, and expand requested generic functions before signature and body checking.")

	(use wove-file "../../source/generics.wove" (only function_generic_list with_generic_operand (value checked_function_operand)))
	(use wove-file "../../source/module.wove" (only form_parts (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../../source/scan.wove" (only is_metadata_form (type SourceNode)))
	(use wove-file "../../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../../source/graph.wove" (only find_binding (type GraphBinding) (type GraphModule)))
	(use wove-file "../../emit/names.wove" (only function_identity))
	(use wove-file "../trees.wove" (only (type ScalarTree)))
	(use wove-file "../syntax.wove" (only is_scalar_name))
	(use wove-file "../records.wove"
		(only scope_at declaration_kind read_checked_template_parameters next_layout_node is_disabled_statement
			read_specialization_arguments same_specialization_arguments (type ScalarRecord) (type TypeScope)))
	(use wove-file "../specializations.wove" (only register_clone_type_layouts))
	(use wove-file "./workspace.wove" (only subtree_limit is_function_request original_tree_rows (value function_workspace_full)))
	(use wove-file "./clone.wove" (only generic_parameter_count collect_concrete_operands clone_function_nodes (type ConcreteOperand)))
	(use wove-file "./operations.wove" (only resolve_function_operations))

	(struct FunctionInstance
		(fields (original i32) (declaration i32) (end i32) (file i32)
			(site i32) (site_file i32) (site_base i32) (identity u32)))
	(struct FunctionExpansion
		(fields (rows i32) (count i32) (records i32) (file i32) (start i32) (end i32) (error u32)))

	(fn expansion_progress
		(:doc "Return the populated prefix of cloned nodes, concrete functions, and value layouts.")
		(params (rows i32) (count i32) (records i32)) (returns FunctionExpansion)
		(body (return (struct:new FunctionExpansion (rows rows) (count count)
			(records records) (file -1i32) (start 0i32) (end 0i32) (error 0u32)))))

	(fn expansion_failure
		(:doc "Save a diagnostic in the original file even when the checked node belongs to a clone.")
		(params (scope TypeScope) (start i32) (end i32) (error u32)) (returns FunctionExpansion)
		(body
			(let base (scope.get source_base))
			(return (struct:new FunctionExpansion (rows 0i32) (count 0i32) (records 0i32)
				(file (scope.get file)) (start (i32:sub start base))
				(end (i32:sub end base)) (error error)))))

	(fn application_failure
		(:doc "Diagnose an invalid or unavailable explicit function target at its authored operand.")
		(params (scope TypeScope) (node SourceNode) (error u32)) (returns FunctionExpansion)
		(body (return (call expansion_failure scope (node.get start) (node.get end) error))))

	(fn find_function_specialization
		(:doc "Resolve an equal function identity to its concrete row after checking the original and all normalized arguments.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (scope TypeScope) (site i32) (definition i32) (formal i32) (definition_scope TypeScope)
			(identity u32) (instances (shared-array FunctionInstance)) (count i32)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only already requested layouts can share or collide with the deterministic identity.")
				(i32:lt index count)
				(body
					(let prior (instances.get index))
					(if
						(:doc "A base32 hash match still requires exact argument identity.")
						(u32:eq (prior.get identity) identity)
						(then
							(if
								(:doc "Each instance belongs to one defining template.")
								(bool:and (i32:eq (prior.get original) definition)
									(call same_specialization_arguments (borrow-shared arena) (borrow-shared nodes)
										(borrow-shared records) (borrow-shared bindings) scope site
										(call scope_at (prior.get site_file) (prior.get site_base))
										(prior.get site) formal definition_scope (bool false)))
								(then (return (prior.get declaration))))))
					(set index (i32:inc index))))
			(return -1i32)))

	(fn mark_application_target
		(:doc "Give a checked call target its private concrete declaration row.")
		(params (nodes (mut-array SourceNode)) (site i32) (declaration i32)) (returns void)
		(body
			(let node (nodes.get site))
			(nodes.set site
				(call with_generic_operand node checked_function_operand (u32:from-i32 declaration)))))

	(fn request_function
		(:doc "Resolve one call application, then clone and register its concrete types on the first request.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(views (shared-array ModuleRead)) (entry_file i32) (scope TypeScope) (site i32) (instances (mut-array FunctionInstance))
			(previous FunctionExpansion)) (returns FunctionExpansion)
		(body
			(let node (nodes.get site))
			(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) node))
			(let name (parts.get operands))
			(if (i32:ltz name) (then (return (call application_failure scope node 23u32))))
			(let spelling (nodes.get name))
			(if
				(:doc "A template head needs an ordinary selected function name. Substituted operands cannot fall through to that namespace.")
				(bool:or (u8:not-eqz (spelling.get generic_kind))
					(bool:not (call is_scalar_name (borrow-shared arena) spelling)))
				(then (return (call application_failure scope spelling 23u32))))
			(let bound (call find_binding (borrow-shared arena) (borrow-shared arena)
				(spelling.get start) (spelling.get end)
				(borrow-shared bindings) bindings.len
				(scope.get file) (bool false) (scope.get source_base) 0u32))
			(if (i32:ltz bound) (then (return (call application_failure scope spelling 34u32))))
			(let binding (bindings.get bound))
			(if
				(:doc "Foreign and ordinary functions cannot be named by an explicit generic application.")
				(u32:not-eq (binding.get provider) 3u32)
				(then (return (call application_failure scope spelling 23u32))))
			(let file (binding.get file))
			(let tree (trees.get file))
			(let input (files.get file))
			(let decl (i32:add (tree.get base) (binding.get declaration)))
			(let template (nodes.get decl))
			(let generic (call function_generic_list (borrow-shared arena) (borrow-shared nodes) template))
			(if (i32:ltz generic) (then (return (call application_failure scope spelling 23u32))))
			(let definition_scope (call scope_at file (input.get source_start)))
			(let declared (call read_checked_template_parameters (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) definition_scope
				(nodes.get generic)))
			(if
				(:doc "A malformed parameter declaration is reported in the defining file.")
				(u32:gtz (declared.get error))
				(then (return (call expansion_failure definition_scope (declared.get start)
					(declared.get end) (declared.get error)))))
			(let formal (declared.get operand))
			(call resolve_function_operations (borrow-shared arena) (borrow-mut nodes) (borrow-shared bindings)
				(borrow-shared trees) (borrow-shared views)
				scope entry_file site formal)
			(let original_parts (call form_parts (borrow-shared arena) (borrow-shared nodes) template))
			(let original_name (nodes.get (original_parts.get name)))
			(let identity (call function_identity (borrow-shared arena) (original_name.get start)
				(original_name.get end) (tree.get module_id)))
			(let key (call read_specialization_arguments (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) scope site -1i32
				decl formal definition_scope identity (bool false)))
			(if
				(:doc "Check kind, arity, and the exact value type before requesting a clone.")
				(u32:gtz (key.get error))
				(then (return (call expansion_failure scope (key.get start)
					(key.get end) (key.get error)))))
			(let id (key.get identity))
			(let count (previous.get count))
			(let known (call find_function_specialization (borrow-shared arena) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared bindings) scope site decl formal definition_scope id
				(borrow-shared instances) count))
			(if
				(:doc "Repeated requests and recursion with the same arguments reuse the original clone.")
				(i32:lt -1i32 known)
				(then
					(call mark_application_target (borrow-mut nodes) site known)
					(return previous)))
			(let end (call subtree_limit (borrow-shared nodes) decl
				(i32:add (tree.get base) (tree.get rows))))
			(let size (i32:sub end decl))
			(let cursor (previous.get rows))
			(if
				(:doc "A clone is published only when the workspace can hold its entire subtree and signature.")
				(bool:or (i32:eq count instances.len)
					(i32:lt (i32:sub nodes.len cursor) size))
				(then (return (call application_failure scope node function_workspace_full))))
			(let-mut arguments (array:alloc ConcreteOperand (call generic_parameter_count (borrow-shared nodes) formal)))
			(call collect_concrete_operands (borrow-shared arena) (borrow-shared nodes) (borrow-shared records)
				(borrow-shared bindings) scope site formal definition_scope (borrow-mut arguments))
			(call clone_function_nodes (borrow-shared arena) (borrow-mut nodes) decl end
				generic cursor (borrow-shared arguments))
			(let limit (i32:add cursor size))
			(instances.set count (struct:new FunctionInstance (original decl)
				(declaration cursor) (end limit) (file file)
				(site site) (site_file (scope.get file)) (site_base (scope.get source_base)) (identity id)))
			(call mark_application_target (borrow-mut nodes) site cursor)
			(let layouts (call register_clone_type_layouts (borrow-shared arena) (borrow-shared nodes)
				(borrow-mut records) (borrow-shared bindings) definition_scope cursor (previous.get records)))
			(if
				(:doc "Instantiated record and array types keep their original definition or operand span.")
				(u32:gtz (layouts.get error))
				(then (return (struct:new FunctionExpansion (rows 0i32) (count 0i32) (records 0i32)
					(file (layouts.get file)) (start (layouts.get start))
					(end (layouts.get end)) (error (layouts.get error))))))
			(return (call expansion_progress limit (i32:inc count) (layouts.get next)))))

	(fn request_function_subtree
		(:doc "Visit call targets in a selected function or clone without treating opaque syntax as executable.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(views (shared-array ModuleRead)) (entry_file i32) (scope TypeScope) (root i32) (instances (mut-array FunctionInstance))
			(initial FunctionExpansion)) (returns FunctionExpansion)
		(body
			(let-mut next_row (initial.get rows))
			(let-mut next_function (initial.get count))
			(let-mut next_record (initial.get records))
			(let-mut index (struct:get (nodes.get root) first_child))
			(while
				(:doc "Only selected syntax can request a concrete body.")
				(i32:lt -1i32 index)
				(body
					(let node (nodes.get index))
					(if
						(:doc "Instantiated type operands already have their checked values.")
						(call is_function_request (borrow-shared arena) (borrow-shared nodes) node index)
						(then
							(let checked (call request_function (borrow-shared arena) (borrow-mut nodes) (borrow-mut records)
								(borrow-shared bindings) (borrow-shared files) (borrow-shared trees) (borrow-shared views)
								entry_file scope index (borrow-mut instances)
								(call expansion_progress next_row next_function next_record)))
							(if (u32:gtz (checked.get error)) (then (return checked)))
							(set next_row (checked.get rows))
							(set next_function (checked.get count))
							(set next_record (checked.get records))))
					(let descend (bool:not (bool:or
						(call is_metadata_form (borrow-shared arena) (borrow-shared nodes) node)
						(call is_disabled_statement (borrow-shared arena) (borrow-shared nodes) node))))
					(set index (call next_layout_node (borrow-shared nodes) index root descend))))
			(return (call expansion_progress next_row next_function next_record))))

	(fn expand_graph_functions
		(:doc "Request instances from active concrete functions and visit each generated body at most once.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (records (mut-array ScalarRecord))
			(bindings (shared-array GraphBinding)) (files (shared-array SuppliedFile)) (trees (shared-array ScalarTree))
			(modules (shared-array GraphModule)) (views (shared-array ModuleRead)) (selected (shared-array SelectedDeclaration)) (entry_file i32)
			(instances (mut-array FunctionInstance)) (start_record i32)) (returns FunctionExpansion)
		(body
			(let-mut next_row (call original_tree_rows (borrow-shared trees)))
			(let-mut next_function 0i32)
			(let-mut next_record start_record)
			(let-mut file 0i32)
			(while
				(:doc "Read uses from the selected declarations, with each request rooted in its own file.")
				(i32:lt file files.len)
				(body
					(if
						(:doc "Inactive source does not create function instances.")
						(struct:get (modules.get file) active)
						(then
							(let base (struct:get (trees.get file) base))
							(let scope (call scope_at file (struct:get (files.get file) source_start)))
							(let count (struct:get (views.get file) count))
							(let-mut index 0i32)
							(while
								(:doc "An unapplied template has no executable body to visit.")
								(i32:lt index count)
								(body
									(let decl (struct:get (selected.get (i32:add base index)) node))
									(if
										(:doc "Ordinary functions can request concrete calls regardless of their source order.")
										(bool:and (u32:eq (call declaration_kind (borrow-shared arena) (borrow-shared nodes) decl) 1u32)
											(i32:ltz (call function_generic_list (borrow-shared arena) (borrow-shared nodes)
												(nodes.get decl))))
										(then
											(let checked (call request_function_subtree (borrow-shared arena) (borrow-mut nodes) (borrow-mut records)
												(borrow-shared bindings) (borrow-shared files) (borrow-shared trees) (borrow-shared views)
												entry_file scope decl (borrow-mut instances)
												(call expansion_progress next_row next_function next_record)))
											(if (u32:gtz (checked.get error)) (then (return checked)))
											(set next_row (checked.get rows))
											(set next_function (checked.get count))
											(set next_record (checked.get records))))
									(set index (i32:inc index))))))
					(set file (i32:inc file))))
			(let-mut cursor 0i32)
			(while
				(:doc "A concrete body can request more applications. Same-key recursion already points to a published clone.")
				(i32:lt cursor next_function)
				(body
					(let instance (instances.get cursor))
					(let owner (instance.get file))
					(let scope (call scope_at owner (struct:get (files.get owner) source_start)))
					(let checked (call request_function_subtree (borrow-shared arena) (borrow-mut nodes) (borrow-mut records)
						(borrow-shared bindings) (borrow-shared files) (borrow-shared trees) (borrow-shared views)
						entry_file scope (instance.get declaration) (borrow-mut instances)
						(call expansion_progress next_row next_function next_record)))
					(if (u32:gtz (checked.get error)) (then (return checked)))
					(set next_row (checked.get rows))
					(set next_function (checked.get count))
					(set next_record (checked.get records))
					(set cursor (i32:inc cursor))))
			(return (call expansion_progress next_row next_function next_record))))
)
