(module function_specialization_operations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve explicit generic operation names to concrete Wove declarations before checking the specialization key.")

	(use wove-file "../../source/generics.wove" (only function_generic_list generic_argument_kind with_generic_operand
		(value generic_operation_kind) (value checked_operation_operand) (value checked_operation_identity)))
	(use wove-file "../../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../../source/module.wove" (only form_parts (type ModuleRead)))
	(use wove-file "../../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../../emit/names.wove" (only function_identity))
	(use wove-file "../records.wove" (only specialization_first (type TypeScope)))
	(use wove-file "../syntax.wove" (only entry_keyword is_scalar_name))
	(use wove-file "../trees.wove" (only graph_module_key (type ScalarTree)))

	(fn resolve_operation_operand
		(:doc "Bind a bare argument in the caller's function namespace and retain its defining declaration and stable identity.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (bindings (shared-array GraphBinding))
			(files (shared-array SuppliedFile)) (trees (shared-array ScalarTree)) (views (shared-array ModuleRead))
			(scope TypeScope) (entry_file i32) (index i32))
		(returns void)
		(body
			(let operand (array.load (local nodes) (local index)))
			(if
				(:doc "Forwarded operations are already resolved. A value or type substitution cannot name a function.")
				(bool.or (u8.not-eqz (struct.get (local operand) generic_kind))
					(bool.not (call is_scalar_name (borrow-shared (local arena)) (local operand))))
				(then (return)))
			(let bound (call find_binding (borrow-shared (local arena)) (borrow-shared (local arena))
				(struct.get (local operand) start) (struct.get (local operand) end)
				(borrow-shared (local bindings)) (array.len (local bindings))
				(struct.get (local scope) file) (bool false) (struct.get (local scope) source_base) 0u32))
			(if (i32.ltz (local bound)) (then (return)))
			(let binding (array.load (local bindings) (local bound)))
			(if
				(:doc "Only selected Wove functions are candidates for a compile-time operation.")
				(u32.not-eq (struct.get (local binding) provider) 3u32)
				(then (return)))
			(let file (struct.get (local binding) file))
			(let tree (array.load (local trees) (local file)))
			(let base (struct.get (local tree) base))
			(let declaration (i32.add (local base) (struct.get (local binding) declaration)))
			(let node (array.load (local nodes) (local declaration)))
			(if
				(:doc "The named operation already needs a concrete signature.")
				(i32.not-ltz (call function_generic_list (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
				(then (return)))
			(let parts (call form_parts (borrow-shared (local arena)) (borrow-shared (local nodes)) (local node)))
			(let name (struct.get (local parts) name))
			(if (i32.ltz (local name)) (then (return)))
			(let spelling (array.load (local nodes) (local name)))
			(let view (array.load (local views) (local file)))
			(if
				(:doc "The executable root's host entry cannot be selected as an ordinary function.")
				(bool.and
					(bool.and (i32.eq (local file) (local entry_file)) (u32.not-eq (struct.get (local view) mode) 2u32))
					(u32.eq (call entry_keyword (borrow-shared (local arena)) (borrow-shared (local nodes)) (local name)) 2u32))
				(then (return)))
			(if
				(:doc "Cache the stable C identity once per defining declaration in the private checked tree.")
				(u8.not-eq (struct.get (local node) generic_kind) (local checked_operation_identity))
				(then
					(let file_key (call graph_module_key (borrow-shared (local arena)) (borrow-shared (local nodes))
						(local view) (array.load (local files) (local file)) (local base)))
					(let identity (call function_identity (borrow-shared (local arena))
						(struct.get (local spelling) start) (struct.get (local spelling) end) (local file_key)))
					(array.store (local nodes) (local declaration)
						(call with_generic_operand (local node) (local checked_operation_identity) (local identity)))))
			(array.store (local nodes) (local index)
				(call with_generic_operand (local operand) (local checked_operation_operand) (u32.from-i32 (local declaration))))))

	(fn resolve_function_operations
		(:doc "Resolve operation arguments in place and leave kind or arity failures to the common argument checker.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (bindings (shared-array GraphBinding))
			(files (shared-array SuppliedFile)) (trees (shared-array ScalarTree)) (views (shared-array ModuleRead))
			(scope TypeScope) (entry_file i32) (site i32) (parameters i32))
		(returns void)
		(body
			(let-mut formal (local parameters))
			(let-mut actual (call specialization_first (borrow-shared (local arena)) (borrow-shared (local nodes)) (local site)))
			(while
				(:doc "A formal and actual advance together. Missing or extra arguments retain the existing span.")
				(bool.and (i32.not-ltz (local formal)) (i32.not-ltz (local actual)))
				(body
					(let parameter (array.load (local nodes) (local formal)))
					(if
						(:doc "Only a declared fn parameter uses the caller's function namespace.")
						(u32.eq (call generic_argument_kind (borrow-shared (local arena)) (borrow-shared (local nodes)) (local parameter))
							(local generic_operation_kind))
						(then (call resolve_operation_operand (borrow-shared (local arena)) (borrow-mut (local nodes))
							(borrow-shared (local bindings)) (borrow-shared (local files)) (borrow-shared (local trees))
							(borrow-shared (local views)) (local scope) (local entry_file) (local actual))))
					(set (local actual) (struct.get (array.load (local nodes) (local actual)) next_sibling))
					(set (local formal) (struct.get (local parameter) next_sibling))))))
)
