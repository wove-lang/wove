(module function_specialization_operations
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve explicit generic operation names to concrete Wove declarations before checking the specialization key.")

	(use wove-file "../../source/generics.wove" (only function_generic_list generic_argument_kind with_generic_operand
		(value generic_operation_kind) (value checked_operation_operand) (value checked_operation_identity)))
	(use wove-file "../../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../../source/module.wove" (only form_parts (type ModuleRead)))
	(use wove-file "../../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../../emit/names.wove" (only function_identity))
	(use wove-file "../records.wove" (only specialization_first (type TypeScope)))
	(use wove-file "../syntax.wove" (only entry_keyword is_scalar_name))
	(use wove-file "../trees.wove" (only (type ScalarTree)))

	(fn resolve_operation_operand
		(:doc "Bind a bare argument in the caller's function namespace and retain its defining declaration and stable identity.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (views (shared-array ModuleRead))
			(scope TypeScope) (entry_file i32) (index i32))
		(returns void)
		(body
			(let operand (array:load nodes index))
			(if
				(:doc "Forwarded operations are already resolved. A value or type substitution cannot name a function.")
				(bool:or (u8:not-eqz (struct:get operand generic_kind))
					(bool:not (call is_scalar_name (borrow-shared arena) operand)))
				(then (return)))
			(let bound (call find_binding (borrow-shared arena) (borrow-shared arena)
				(struct:get operand start) (struct:get operand end)
				(borrow-shared bindings) (array:len bindings)
				(struct:get scope file) (bool false) (struct:get scope source_base) 0u32))
			(if (i32:ltz bound) (then (return)))
			(let binding (array:load bindings bound))
			(if
				(:doc "Only selected Wove functions are candidates for a compile-time operation.")
				(u32:not-eq (struct:get binding provider) 3u32)
				(then (return)))
			(let file (struct:get binding file))
			(let tree (array:load trees file))
			(let base (struct:get tree base))
			(let declaration (i32:add base (struct:get binding declaration)))
			(let node (array:load nodes declaration))
			(if
				(:doc "The named operation already needs a concrete signature.")
				(i32:not-ltz (call function_generic_list (borrow-shared arena) (borrow-shared nodes) node))
				(then (return)))
			(let parts (call form_parts (borrow-shared arena) (borrow-shared nodes) node))
			(let name (struct:get parts name))
			(if (i32:ltz name) (then (return)))
			(let spelling (array:load nodes name))
			(let view (array:load views file))
			(if
				(:doc "The executable root's host entry cannot be selected as an ordinary function.")
				(bool:and
					(bool:and (i32:eq file entry_file) (u32:lt (struct:get view mode) 2u32))
					(u32:eq (call entry_keyword (borrow-shared arena) (borrow-shared nodes) name) 2u32))
				(then (return)))
			(if
				(:doc "Cache the stable C identity once per defining declaration in the private checked tree.")
				(u8:not-eq (struct:get node generic_kind) checked_operation_identity)
				(then
					(let identity (call function_identity (borrow-shared arena)
						(struct:get spelling start) (struct:get spelling end) (struct:get tree module_id)))
					(array:store nodes declaration
						(call with_generic_operand node checked_operation_identity identity))))
			(array:store nodes index
				(call with_generic_operand operand checked_operation_operand (u32:from-i32 declaration)))))

	(fn resolve_function_operations
		(:doc "Resolve operation arguments in place and leave kind or arity failures to the common argument checker.")
		(params (arena (shared-array u8)) (nodes (mut-array SourceNode)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (views (shared-array ModuleRead))
			(scope TypeScope) (entry_file i32) (site i32) (parameters i32))
		(returns void)
		(body
			(let-mut formal parameters)
			(let-mut actual (call specialization_first (borrow-shared arena) (borrow-shared nodes) site))
			(while
				(:doc "A formal and actual advance together. Missing or extra arguments retain the existing span.")
				(bool:and (i32:not-ltz formal) (i32:not-ltz actual))
				(body
					(let parameter (array:load nodes formal))
					(if
						(:doc "Only a declared fn parameter uses the caller's function namespace.")
						(u32:eq (call generic_argument_kind (borrow-shared arena) (borrow-shared nodes) parameter)
							generic_operation_kind)
						(then (call resolve_operation_operand (borrow-shared arena) (borrow-mut nodes)
							(borrow-shared bindings) (borrow-shared trees)
							(borrow-shared views) scope entry_file actual)))
					(set actual (struct:get (array:load nodes actual) next_sibling))
					(set formal (struct:get parameter next_sibling))))))
)
