(module scalar_flow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Represent checked scalar statements and navigate their control flow.

	Rows use original source-tree indices. Walk blocks through their parent
	and sibling links so nested control flow can be checked and emitted
	without recursive walks of the input.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings))

	(let break_statement 144u32)
	(let continue_statement 145u32)
	(let next_path 1u32)
	(let break_path 2u32)
	(let continue_path 4u32)

	(fn is_loop_exit
		(:doc `Recognize statements that transfer control to their enclosing loop.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local break_statement))
			(u32.eq (local kind) (local continue_statement))))))

	(let c_constant_binding 80u32)
	(let c_readonly_binding 81u32)
	(let c_writable_binding 82u32)
	(let c_macro_binding 84u32)
	(let c_value_expression 80u32)
	(let c_vector_snapshot_expression 107u32)
	(let c_value_assignment 83u32)
	(let c_handle_reference 58u32)
	(let fixed_shared_loan 95u32)
	(let fixed_mut_loan 96u32)
	(let field_assignment 97u32)

	(fn is_c_value_binding
		(:doc `Recognize defining rows for imported native constants, storage, and expression macros.`)
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.or (u32.eq (local kind) (local c_macro_binding))
				(bool.and (bool.not (u32.lt (local kind) (local c_constant_binding)))
					(bool.not (u32.lt (local c_writable_binding) (local kind))))))))

	(struct
		(:doc `A statement or nested block stored at its source-tree row.

		A declaration or assignment carries its typed value and defining
		name node. Standalone calls and slice stores use their own rows
		as operation roots. A void return has no value row. An if or while
		carries a boolean value and its first block. A match carries its
		subject and first case. A case block also retains the variant ordinal
		in target. Each block carries its first statement and whether it can
		fall through. A statement links to the
		latest active owner before it. A block links to the latest owner at
		its end. An owning declaration records its move form, if any.
		Module binding declarations use kind 62. Imported value aliases
		use kind 63 and point from their name row to the defining declaration
		in value. Native value definitions carry the original C name and type,
		and an alias links them to the importing scope the same way.
		A loop exit names its target loop. A while with any written break
		keeps the first break row in target for label emission. Paths summarize
		reachable fallthrough, break, and continue edges. The loan link is the
		last scoped view declaration active before this statement. Missing links use -1.`)
		ScalarStatement
		(fields (kind u32) (target i32) (value i32) (type u32) (first i32) (previous_owner i32) (falls_through bool) (move_site i32) (paths u32) (previous_loan i32)))

	(struct BlockExit (fields (owner i32) (alternate i32) (block i32) (statement i32)))

	(fn block_statement
		(:doc `Record a block entry and the owner and fallthrough state at its end.`)
		(params (first i32) (target i32) (previous_owner i32) (falls_through bool))
		(returns ScalarStatement)
		(body
			(return (struct.new ScalarStatement (kind 0u32) (target (local target))
				(value -1i32) (type 0u32) (first (local first))
				(previous_owner (local previous_owner)) (falls_through (local falls_through)) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn pending_statement
		(:doc `Supply the current lexical loan chain before checking a statement's operands.`)
		(params (previous_loan i32))
		(returns ScalarStatement)
		(body
			(return (struct.new ScalarStatement (kind 0u32) (target -1i32)
				(value -1i32) (type 0u32) (first -1i32) (previous_owner -1i32)
				(falls_through (bool false)) (move_site -1i32) (paths 0u32) (previous_loan (local previous_loan))))))

	(fn statement_exit_state
		(:doc `Keep a checked statement's operands while recording its target, cleanup, and outgoing paths.`)
		(params (row ScalarStatement) (target i32) (previous_owner i32) (falls_through bool) (paths u32))
		(returns ScalarStatement)
		(body
			(return (struct.new ScalarStatement (kind (struct.get (local row) kind)) (target (local target))
				(value (struct.get (local row) value)) (type (struct.get (local row) type))
				(first (struct.get (local row) first)) (previous_owner (local previous_owner))
				(falls_through (local falls_through)) (move_site (struct.get (local row) move_site)) (paths (local paths))
				(previous_loan (struct.get (local row) previous_loan))))))

	(fn moved_owner
		(:doc `Record a transfer while preserving the source declaration's scope links.`)
		(params (owner ScalarStatement) (move_site i32))
		(returns ScalarStatement)
		(body
			(return (struct.new ScalarStatement
				(kind (struct.get (local owner) kind)) (target (struct.get (local owner) target))
				(value (struct.get (local owner) value)) (type (struct.get (local owner) type))
				(first (struct.get (local owner) first)) (previous_owner (struct.get (local owner) previous_owner))
				(falls_through (struct.get (local owner) falls_through)) (move_site (local move_site)) (paths (struct.get (local owner) paths))
				(previous_loan (struct.get (local owner) previous_loan))))))

	(fn within_scope
		(:doc `Determine whether one node's complete span is inside another node in the same source tree.`)
		(params (outer SourceNode) (inner SourceNode))
		(returns bool)
		(body (return (bool.not (bool.or (i32.lt (struct.get (local inner) start) (struct.get (local outer) start))
			(i32.lt (struct.get (local outer) end) (struct.get (local inner) end)))))))

	(fn after_block
		(:doc `After a nested block, find its alternate or the next active statement in the enclosing block.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (block i32))
		(returns BlockExit)
		(body
			(let node (array.load (local nodes) (local block)))
			(let parent (struct.get (local node) parent))
			(let owner (array.load (local nodes) (local parent)))
			(return (struct.new BlockExit (owner (local parent)) (alternate (struct.get (local node) next_sibling))
				(block (struct.get (local owner) parent))
				(statement (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local owner) next_sibling))))))))
