(module scalar_flow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Represent checked scalar statements and navigate their control flow.

	Rows use original source-tree indices. Walk blocks through their parent
	and sibling links so nested control flow can be checked and emitted
	without recursive walks of the input.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings))

	(let c_constant_binding (u32 80))
	(let c_readonly_binding (u32 81))
	(let c_writable_binding (u32 82))
	(let c_value_expression (u32 80))
	(let c_value_assignment (u32 83))
	(let c_handle_reference (u32 58))
	(let fixed_shared_loan (u32 95))
	(let fixed_mut_loan (u32 96))

	(fn is_c_value_binding
		(:doc `Recognize defining rows for imported native constants and foreign storage.`)
		(params (kind u32))
		(returns bool)
		(body
			(return (bool.and (bool.not (u32.lt (local kind) (local c_constant_binding)))
				(bool.not (u32.lt (local c_writable_binding) (local kind)))))))

	(struct
		(:doc `A statement or nested block stored at its source-tree row.

		A declaration or assignment carries its typed value and defining
		name node. Standalone calls and slice stores use their own rows
		as operation roots. A void return has no value row. An if or while
		carries a boolean value and its first block. Each block, including
		the function body, carries its first statement and whether it can
		fall through. A statement links to the
		latest active owner before it. A block links to the latest owner at
		its end. An owning declaration records its move form, if any.
		Module binding declarations use kind 62. Imported value aliases
		use kind 63 and point from their name row to the defining declaration
		in value. Native value definitions carry the original C name and type,
		and an alias links them to the importing scope the same way.
		Missing links use -1.`)
		ScalarStatement
		(fields (kind u32) (target i32) (value i32) (type u32) (first i32) (previous_owner i32) (falls_through bool) (move_site i32)))

	(struct BlockExit (fields (owner i32) (alternate i32) (block i32) (statement i32)))

	(fn block_statement
		(:doc `Record a block entry and the owner and fallthrough state at its end.`)
		(params (first i32) (previous_owner i32) (falls_through bool))
		(returns ScalarStatement)
		(body
			(return (record.make ScalarStatement (kind (u32 0)) (target (i32 -1))
				(value (i32 -1)) (type (u32 0)) (first (local first))
				(previous_owner (local previous_owner)) (falls_through (local falls_through)) (move_site (i32 -1))))))

	(fn moved_owner
		(:doc `Record a transfer while preserving the source declaration's scope links.`)
		(params (owner ScalarStatement) (move_site i32))
		(returns ScalarStatement)
		(body
			(return (record.make ScalarStatement
				(kind (record.get (local owner) kind)) (target (record.get (local owner) target))
				(value (record.get (local owner) value)) (type (record.get (local owner) type))
				(first (record.get (local owner) first)) (previous_owner (record.get (local owner) previous_owner))
				(falls_through (record.get (local owner) falls_through)) (move_site (local move_site))))))

	(fn after_block
		(:doc `After a nested block, find its alternate or the next active statement in the enclosing block.`)
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (block i32))
		(returns BlockExit)
		(body
			(let node (slice.load (local nodes) (local block)))
			(let parent (record.get (local node) parent))
			(let owner (slice.load (local nodes) (local parent)))
			(return (record.make BlockExit (owner (local parent)) (alternate (record.get (local node) next_sibling))
				(block (record.get (local owner) parent))
				(statement (call skip_disabled_siblings (borrow-shared (local source)) (borrow-shared (local nodes))
					(record.get (local owner) next_sibling))))))))
