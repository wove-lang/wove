(module scalar_flow
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Represent checked scalar statements and navigate their control flow.

	Rows use original source-tree indices. Walk blocks through their parent
	and sibling links so nested control flow can be checked and emitted
	without recursive walks of the input.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only skip_disabled_siblings))

	(let break_statement 144u32)
	(let continue_statement 145u32)
	(let for_statement 148u32)
	(let for_binding 149u32)
	(let for_mut_binding 168u32)
	(let for_element_assignment 169u32)
	(let for_source_owner 266u32)

	(fn is_iteration_binding
		(:doc `Recognize the two binding kinds scoped to the body of a for.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq for_binding)
			(kind.eq for_mut_binding)))))

	(fn is_writable_local
		(:doc `Allow writes to mutable locals and exclusive iteration elements.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq 16u32)
			(kind.eq for_mut_binding)))))

	(fn is_loop
		(:doc `Recognize checked loops that accept break and continue.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq 25u32)
			(kind.eq for_statement)))))
	(let next_path 1u32)
	(let break_path 2u32)
	(let continue_path 4u32)

	(fn is_loop_exit
		(:doc `Recognize statements that transfer control to their enclosing loop.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq break_statement)
			(kind.eq continue_statement)))))

	(let c_constant_binding 80u32)
	(let c_readonly_binding 81u32)
	(let c_writable_binding 82u32)
	(let c_macro_binding 84u32)
	(let c_lossless_macro_binding 85u32)
	(let c_null_value_binding 86u32)
	(let c_value_expression 80u32)
	(let c_lossless_value_expression 926u32)
	(let c_value_snapshot_expression 107u32)
	(let c_value_assignment 83u32)
	(let c_handle_reference 58u32)
	(let fixed_shared_loan 95u32)
	(let fixed_mut_loan 96u32)
	(let field_assignment 97u32)
	(let parameter_assignment 170u32)
	(let owner_assignment 604u32)
	(let owner_field_assignment 605u32)
	(let case_payload_binding 210u32)
	(let case_discard_binding 251u32)

	(fn is_c_value_binding
		(:doc `Recognize defining rows for imported native constants, storage, and expression macros.`)
		(params (kind u32))
		(returns bool)
		(body
			(return (bool:or (bool:or (kind.eq c_macro_binding) (kind.eq c_lossless_macro_binding))
				(bool:and (kind.not-lt c_constant_binding)
					(c_writable_binding.not-lt kind))))))

	(fn is_c_value_expression
		(:doc "Recognize live native reads that need their own evaluation step.")
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq c_value_expression) (kind.eq c_lossless_value_expression)))))

	(struct ScalarStatement
		(:doc `A statement or nested block stored at its source-tree row.

		A declaration or assignment carries its typed value and defining
		name node. A scalar parameter assignment names its checked place expression.
		Standalone calls and slice stores use their own rows
		as operation roots. A void return has no value row. An if or while
		carries a boolean value and its first block. A match carries its
		subject and first case. A case block also retains the variant ordinal
		in target. A payload case carries its binding name row in value.
		Each block carries its first statement and whether it can
		fall through. A statement links to the
		latest active owner before it. A block links to the latest owner at
		its end. An owning declaration records its move form, if any.
		Module binding declarations use kind 62. Imported value aliases
		use kind 63 and point from their name row to the defining declaration
		in value. Native value definitions carry the original C name and type,
		and an alias links them to the importing scope the same way.
		A for carries its first bound, borrowed view, or moved owner in value.
		Its type identifies the iterator. For a consuming loop, the move
		head also holds a synthetic owner row for the captured array. The body block's target
		lists the binding names, whose rows carry the type and body scope. An
		exclusive item names the current element in the retained array storage.
		A loop exit names its target loop. A loop with any written break
		keeps the first break row in target for label emission. Paths summarize
		reachable fallthrough, break, and continue edges. The loan link is the
		last scoped view declaration active before this statement. Missing links use -1.`)
		(fields (kind u32) (target i32) (value i32) (type u32) (first i32) (previous_owner i32) (falls_through bool) (move_site i32) (paths u32) (previous_loan i32)))

	(struct BlockExit (fields (owner i32) (alternate i32) (block i32) (statement i32)))

	(fn block_statement
		(:doc `Record a block entry and the owner and fallthrough state at its end.`)
		(params (first i32) (target i32) (previous_owner i32) (falls_through bool))
		(returns ScalarStatement)
		(body
			(return (struct:new ScalarStatement (kind 0u32) (target target)
				(value -1i32) (type 0u32) (first first)
				(previous_owner previous_owner) (falls_through falls_through) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn pending_statement
		(:doc `Supply the current lexical loan chain before checking a statement's operands.`)
		(params (previous_loan i32))
		(returns ScalarStatement)
		(body
			(return (struct:new ScalarStatement (kind 0u32) (target -1i32)
				(value -1i32) (type 0u32) (first -1i32) (previous_owner -1i32)
				(falls_through (bool false)) (move_site -1i32) (paths 0u32) (previous_loan previous_loan)))))

	(fn statement_exit_state
		(:doc `Keep a checked statement's operands while recording its target, cleanup, and outgoing paths.`)
		(params (row ScalarStatement) (target i32) (previous_owner i32) (falls_through bool) (paths u32))
		(returns ScalarStatement)
		(body
			(return (struct:new ScalarStatement (kind row/kind) (target target)
				(value row/value) (type row/type)
				(first row/first) (previous_owner previous_owner)
				(falls_through falls_through) (move_site row/move_site) (paths paths)
				(previous_loan row/previous_loan)))))

	(fn moved_owner
		(:doc `Record a transfer while preserving the source declaration's scope links.`)
		(params (owner ScalarStatement) (move_site i32))
		(returns ScalarStatement)
		(body
			(return (struct:new ScalarStatement
				(kind owner/kind) (target owner/target)
				(value owner/value) (type owner/type)
				(first owner/first) (previous_owner owner/previous_owner)
				(falls_through owner/falls_through) (move_site move_site) (paths owner/paths)
				(previous_loan owner/previous_loan)))))

	(fn within_scope
		(:doc `Determine whether one node's complete span is inside another node in the same source tree.`)
		(params (outer SourceNode) (inner SourceNode))
		(returns bool)
		(body (return (bool:not (bool:or (inner/start.lt outer/start)
			(outer/end.lt inner/end))))))

	(fn after_block
		(:doc `After a nested block, find its alternate or the next active statement in the enclosing block.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (block i32))
		(returns BlockExit)
		(body
			(let node (nodes.get block))
			(let parent node/parent)
			(let owner (nodes.get parent))
			(return (struct:new BlockExit (owner parent) (alternate node/next_sibling)
				(block owner/parent)
				(statement (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
					owner/next_sibling)))))))
