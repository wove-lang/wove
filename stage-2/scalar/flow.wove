(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Represent checked scalar statements and navigate their control flow.

	Rows use original source-tree indices. Walk blocks through their parent
	and sibling links so nested control flow can be checked and emitted
	without recursive walks of the input.`)
	scalar_flow

	(use wove-file "../source/scan.wove" (only (type SourceNode)))

	(struct
		(:doc `A statement or arm stored at its source-tree row.

		A scalar statement carries a typed value and, for declarations
		and assignments, its defining name node. An if carries a boolean
		value and its first arm. An arm carries its first statement. Save
		the then arm's fallthrough flag when an else remains to be checked.
		Missing links use -1.`)
		ScalarStatement
		(fields (kind u32) (target i32) (value i32) (type u32) (first i32) (falls_through bool)))

	(struct ArmExit (fields (branch i32) (next_arm i32) (block i32) (statement i32)))

	(fn
		(:doc `Record a checked arm's first statement and whether it reaches the join.`)
		arm_statement
		(params (first i32) (falls_through bool))
		(returns ScalarStatement)
		(body
			(return (record.make ScalarStatement (kind (u32 0)) (target (i32 -1))
				(value (i32 -1)) (type (u32 0)) (first (local first)) (falls_through (local falls_through))))))

	(fn
		(:doc `Find the next arm, or the enclosing block and following statement, after a checked arm.`)
		after_arm
		(params (nodes (shared-slice SourceNode)) (arm i32))
		(returns ArmExit)
		(body
			(let node (slice.load (local nodes) (local arm)))
			(let parent (record.get (local node) parent))
			(let branch (slice.load (local nodes) (local parent)))
			(return (record.make ArmExit (branch (local parent)) (next_arm (record.get (local node) next_sibling))
				(block (record.get (local branch) parent)) (statement (record.get (local branch) next_sibling)))))))
