(module scalar_constants
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Fold exact integer expressions before checking layouts and static initializers.")

	(use wove-file "../source/scan.wove" (only (type SourceNode) (value character_token)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/generics.wove" (only read_i32_constant))
	(use wove-file "../source/integer_ops.wove" (only read_integer_operator integer_operator is_integer_step))
	(use wove-file "../source/graph.wove" (only find_binding binding_with_integer_constant (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/character.wove" (only decode_character))
	(use wove-file "./syntax.wove" (only entry_at (value binding_reference) entry_form is_scalar_name (type EntryRead)))
	(use wove-file "./trees.wove" (only (type ScalarTree)))
	(use wove-file "./generics/workspace.wove" (only subtree_limit))
	(use wove-file "./constant_arithmetic.wove" (only apply_i32_constant_operation))

	(let constant_cycle 87u32)
	(let constant_arithmetic_failed 88u32)

	(struct ConstantResult (fields (bits u32) (file i32) (start i32) (end i32) (error u32)))
	(struct ConstantSlot (fields (state u32) (bits u32)))
	(struct ConstantFrame (fields (node i32) (file i32) (definition bool)
		(phase u32) (operation u32) (site i32) (right i32) (left u32)))

	(fn constant_result
		(:doc "Retain the exact result or its original arena span.")
		(params (bits u32) (file i32) (start i32) (end i32) (error u32)) (returns ConstantResult)
		(body
			(return (struct:new ConstantResult (bits bits) (file file)
				(start start) (end end) (error error)))))

	(fn constant_at_node
		(:doc "Associate a result with one token or expression.")
		(params (bits u32) (file i32) (node SourceNode) (error u32)) (returns ConstantResult)
		(body (return (call constant_result bits file
			(node.get start) (node.get end) error))))

	(fn constant_check
		(:doc "Forward a constant diagnostic to the single-source checker.")
		(params (result ConstantResult)) (returns EntryRead)
		(body (return (struct:new EntryRead (operand -1i32) (start (result.get start))
			(end (result.get end)) (error (result.get error)) (related -1i32)))))

	(fn constant_operation
		(:doc "Recognize module value references and the supported exact i32 operation heads.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns u32)
		(body
			(if
				(:doc "A bare name in a constant expression resolves in the module value namespace.")
				(call is_scalar_name (borrow-shared source) node)
				(then (return binding_reference)))
			(let index (node.get first_child))
			(if (i32:ltz index) (then (return 0u32)))
			(let head (nodes.get index))
			(let operation (call read_integer_operator (borrow-shared source)
				(head.get start) (head.get end)))
			(if
				(:doc "Only exact i32 arithmetic is accepted by this evaluator.")
				(u32:gtz operation)
				(then
					(if
						(:doc "Decoder types distinguish exact i32 operators from the other integer widths.")
						(u32:eq (struct:get (call integer_operator operation) operand) 5u32)
						(then (return operation)))
					(return 0u32)))
			(return 0u32)))

	(fn constant_operands
		(:doc "Keep a bare reference on its source row and read the operand list only for arithmetic.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(node SourceNode) (row i32) (operation u32)) (returns EntryRead)
		(body
			(if (u32:eq operation binding_reference) (then (return (call entry_at node row 0u32))))
			(return (call entry_form (borrow-shared source) (borrow-shared nodes) node operation 24u32))))

	(fn constant_character
		(:doc "Read an unconverted character with its inferred i32 type.")
		(params (source (shared-array u8)) (node SourceNode) (file i32)) (returns ConstantResult)
		(body
			(let value (call decode_character (borrow-shared source)
				(node.get start) (node.get end)))
			(if (i32:ltz value) (then (return (call constant_at_node 0u32 file node 23u32))))
			(return (call constant_at_node (u32:from-i32 value) file node 0u32))))

	(fn literal_i32_constant
		(:doc "Read a literal with the same exact i32 spelling rules as constant generic arguments.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (file i32))
		(returns ConstantResult)
		(body
			(if
				(:doc "An unconverted character has type i32.")
				(u32:eq (node.get kind) character_token)
				(then (return (call constant_character (borrow-shared source) node file))))
			(if
				(:doc "The ordinary i32 constructor can also contain a character token.")
				(u32:eq (node.get kind) 40u32)
				(then
					(if
						(:doc "An empty form has no literal head.")
						(i32:ltz (node.get first_child))
						(then (return (call constant_at_node 0u32 file node 23u32))))
					(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node 5u32 23u32))
					(let operand (form.get operand))
					(if
						(:doc "Recognize only a complete one-operand i32 constructor.")
						(i32:not-ltz operand)
						(then
							(let child (nodes.get operand))
							(if
								(:doc "Use the child character only within the exact literal form.")
								(bool:and (i32:ltz (child.get next_sibling))
									(u32:eq (child.get kind) character_token))
								(then (return (call constant_character (borrow-shared source) child file))))))))
			(let literal (call read_i32_constant (borrow-shared source) (borrow-shared nodes) node (bool false)))
			(return (call constant_result (literal.get value) file
				(literal.get start) (literal.get end) (literal.get error)))))

	(fn constant_initializer
		(:doc "Find the original initializer shared by the local spelling and every imported alias.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (trees (shared-array ScalarTree))
			(binding GraphBinding)) (returns i32)
		(body
			(let-mut row (binding.get declaration))
			(if
				(:doc "Graph declarations use rows relative to their defining file.")
				(i32:gtz trees.len)
				(then (set row (i32:add row (struct:get (trees.get (binding.get file)) base)))))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) (nodes.get row)))
			(return (parts.get operands))))

	(fn constant_frame
		(:doc "Store the pending work for one expression or referenced definition.")
		(params (node i32) (file i32) (definition bool) (phase u32) (operation u32) (site i32) (right i32) (left u32))
		(returns ConstantFrame)
		(body (return (struct:new ConstantFrame (node node) (file file) (definition definition)
			(phase phase) (operation operation) (site site) (right right) (left left)))))

	(fn module_integer_source
		(:doc "Only an immutable Wove value has an initializer available for constant evaluation.")
		(params (binding GraphBinding)) (returns bool)
		(body (return (bool:and (u32:eq (binding.get namespace) 2u32)
			(u32:eq (binding.get provider) 3u32)))))

	(fn evaluate_i32
		(:doc `Evaluate operands left to right with a bounded frame stack.

		During definition discovery each original initializer has one cache
		slot. A pending slot records the active dependency path for cycle
		detection. Later layout and static-value checks read the published
		results through their existing value bindings.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(files (shared-array SuppliedFile)) (trees (shared-array ScalarTree)) (bindings (shared-array GraphBinding))
			(root i32) (file i32) (source_base i32) (slots (mut-array ConstantSlot)) (stack (mut-array ConstantFrame)))
		(returns ConstantResult)
		(body
			(let resolving (i32:gtz slots.len))
			(if
				(:doc "The first definition participates in cycle detection just like any dependency.")
				resolving
				(then (slots.set root (struct:new ConstantSlot (state 1u32) (bits 0u32)))))
			(stack.set 0i32 (call constant_frame root file resolving 0u32 0u32 -1i32 -1i32 0u32))
			(let-mut top 0i32)
			(let-mut result 0u32)
			(while
				(:doc "A completed child returns its value to the suspended parent in result.")
				(i32:not-ltz top)
				(body
					(let frame (stack.get top))
					(let row (frame.get node))
					(let owner (frame.get file))
					(let definition (frame.get definition))
					(let phase (frame.get phase))
					(let site (frame.get site))
					(let right (frame.get right))
					(let-mut operation (frame.get operation))
					(let-mut child -1i32)
					(let-mut child_file owner)
					(let-mut child_definition (bool false))
					(let-mut next_phase 0u32)
					(let-mut next_site site)
					(let-mut next_right right)
					(let-mut left (frame.get left))
					(let node (nodes.get row))
					(if
						(:doc "An unvisited operand is a literal, a reference, or one exact arithmetic form.")
						(u32:eqz phase)
						(then
							(set operation (call constant_operation (borrow-shared source) (borrow-shared nodes) node))
							(if
								(:doc "Literal admission keeps the operand's own type and source span.")
								(u32:eqz operation)
								(then
									(let literal (call literal_i32_constant (borrow-shared source) (borrow-shared nodes) node owner))
									(if (u32:gtz (literal.get error)) (then (return literal)))
									(set result (literal.get bits)))
								(else
									(let reference (u32:eq operation binding_reference))
									(let form (call constant_operands (borrow-shared source) (borrow-shared nodes) node row operation))
									(if
										(:doc "Preserve metadata errors on the expression that contains them.")
										(u32:gtz (form.get error))
										(then (return (call constant_result 0u32 owner (form.get start)
											(form.get end) (form.get error)))))
									(let first (form.get operand))
									(if (i32:ltz first) (then (return (call constant_at_node 0u32 owner node 24u32))))
									(let operand (nodes.get first))
									(let-mut second -1i32)
									(if
										(:doc "Only a form has an operand list. Siblings of a bare reference belong to the enclosing expression.")
										(bool:not reference)
										(then (set second (operand.get next_sibling))))
									(let unary (bool:or reference (call is_integer_step operation)))
									(if
										(:doc "Check operand arity before attempting any lookup or evaluation.")
										(bool:or (bool:and unary (i32:not-ltz second))
											(bool:and (bool:not unary)
												(bool:or (i32:ltz second) (i32:not-ltz (struct:get (nodes.get second) next_sibling)))))
										(then (return (call constant_at_node 0u32 owner node 24u32))))
									(if
										(:doc "A module lookup uses the source namespace of this operand's defining file.")
										reference
										(then
											(let-mut base source_base)
											(if
												(:doc "Graph lookups rebase names into their defining file's byte range.")
												(i32:gtz files.len)
												(then (set base (struct:get (files.get owner) source_start))))
											(let target (call find_binding (borrow-shared source) (borrow-shared source)
												(operand.get start) (operand.get end)
												(borrow-shared bindings) bindings.len owner (bool false) base 2u32))
											(if (i32:ltz target) (then (return (call constant_at_node 0u32 owner operand 24u32))))
											(let binding (bindings.get target))
											(if
												(:doc "C values and noninteger Wove values are unavailable in an i32 constant.")
												(bool:not (call module_integer_source binding))
												(then (return (call constant_at_node 0u32 owner node 23u32))))
											(if
												(:doc "During discovery follow the canonical row, including forward and imported references.")
												resolving
												(then
													(let init (call constant_initializer (borrow-shared source) (borrow-shared nodes)
														(borrow-shared trees) binding))
													(if (i32:ltz init) (then (return (call constant_at_node 0u32 owner node 24u32))))
													(let slot (slots.get init))
													(let state (slot.get state))
													(if
														(:doc "Reaching a pending initializer closes a dependency cycle at this reference.")
														(u32:eq state 1u32)
														(then (return (call constant_at_node 0u32 owner operand constant_cycle))))
													(if
														(:doc "An already evaluated initializer supplies its exact bits.")
														(u32:eq state 2u32)
														(then (set result (slot.get bits)))
														(else
															(set child init)
															(set child_file (binding.get file))
															(set child_definition (bool true))
															(set next_phase 3u32)
															(slots.set init (struct:new ConstantSlot (state 1u32) (bits 0u32))))))
												(else
													(if
														(:doc "A later check can read only previously published i32 definitions.")
														(bool:not (binding.get integer_constant))
														(then (return (call constant_at_node 0u32 owner node 23u32))))
													(set result (binding.get constant_bits)))))
										(else
											(set child first)
											(set next_phase 1u32)
											(set next_site (node.get first_child))
											(set next_right second))))))
						(else
							(if
								(:doc "After the first operand either visit the second or apply a unary step.")
								(u32:eq phase 1u32)
								(then
									(if
										(:doc "A unary step uses the same wrapping addition or subtraction with one.")
										(i32:ltz right)
										(then
											(set result (struct:get (call apply_i32_constant_operation operation result 1u32) bits)))
										(else
											(set left result)
											(set child right)
											(set next_phase 2u32))))
								(else
									(if
										(:doc "Binary failures select the operation head. A completed reference just forwards the result.")
										(u32:eq phase 2u32)
										(then
											(let folded (call apply_i32_constant_operation operation left result))
											(if
												(:doc "The original operation token explains a rejected arithmetic result.")
												(bool:not (folded.get valid))
												(then (return (call constant_at_node 0u32 owner (nodes.get site) constant_arithmetic_failed))))
											(set result (folded.get bits))))))))
					(if
						(:doc "Suspend the parent while visiting a child, or publish the completed definition before popping.")
						(i32:not-ltz child)
						(then
							(stack.set top (call constant_frame row owner definition
								next_phase operation next_site next_right left))
							(set top (i32:inc top))
							(stack.set top (call constant_frame child child_file child_definition 0u32 0u32 -1i32 -1i32 0u32)))
						(else
							(if
								(:doc "Remember each definition once for all of its importing names.")
								definition
								(then (slots.set row (struct:new ConstantSlot (state 2u32) (bits result)))))
							(set top (i32:dec top))))))
			(return (call constant_result result file 0i32 0i32 0u32))))

	(fn fold_i32
		(:doc "Fold one static value using already checked module bindings.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(root i32) (file i32) (source_base i32)) (returns ConstantResult)
		(body
			(let empty_files (array:alloc SuppliedFile 0i32))
			(let empty_trees (array:alloc ScalarTree 0i32))
			(let-mut slots (array:alloc ConstantSlot 0i32))
			(let limit (call subtree_limit (borrow-shared nodes) root nodes.len))
			(let-mut stack (array:alloc ConstantFrame (i32:sub limit root)))
			(return (call evaluate_i32 (borrow-shared source) (borrow-shared nodes)
				(borrow-shared empty_files) (borrow-shared empty_trees) (borrow-shared bindings)
				root file source_base (borrow-mut slots) (borrow-mut stack)))))

	(fn register_integer_constants
		(:doc `Resolve immutable values before array layouts and publish a result for every local spelling.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (files (shared-array SuppliedFile))
			(trees (shared-array ScalarTree)) (bindings (mut-array GraphBinding))) (returns ConstantResult)
		(body
			(let-mut slots (array:alloc ConstantSlot nodes.len))
			(let-mut stack (array:alloc ConstantFrame nodes.len))
			(let-mut index 0i32)
			(while
				(:doc "Evaluate each computed definition once, allowing dependencies in either file or declaration order.")
				(i32:lt index bindings.len)
				(body
					(let binding (bindings.get index))
					(if
						(:doc "An alias may precede its definition, but both use the defining initializer slot.")
						(call module_integer_source binding)
						(then
							(let init (call constant_initializer (borrow-shared source) (borrow-shared nodes) (borrow-shared trees) binding))
							(if
								(:doc "Leave incomplete declarations and unrelated values to ordinary static validation.")
								(bool:and (i32:not-ltz init) (u32:eqz (struct:get (slots.get init) state)))
								(then
									(let node (nodes.get init))
									(let file (binding.get file))
									(if
										(:doc "Computed expressions require a successful exact i32 evaluation.")
										(u32:gtz (call constant_operation (borrow-shared source) (borrow-shared nodes) node))
										(then
											(let checked (call evaluate_i32 (borrow-shared source) (borrow-shared nodes)
												(borrow-shared files) (borrow-shared trees) (borrow-shared bindings)
												init file 0i32 (borrow-mut slots) (borrow-mut stack)))
											(if (u32:gtz (checked.get error)) (then (return checked))))
										(else
											(let literal (call literal_i32_constant (borrow-shared source) (borrow-shared nodes) node file))
											(if
												(:doc "Only a successful i32 literal can supply a later i32 operand.")
												(u32:eqz (literal.get error))
												(then (slots.set init
													(struct:new ConstantSlot (state 2u32) (bits (literal.get bits))))))))))))
					(set index (i32:inc index))))
			(set index 0i32)
			(while
				(:doc "Every alias receives the same bits and nonnegative extent as the original declaration.")
				(i32:lt index bindings.len)
				(body
					(let binding (bindings.get index))
					(if
						(:doc "Only exact Wove i32 definitions have a completed slot.")
						(call module_integer_source binding)
						(then
							(let init (call constant_initializer (borrow-shared source) (borrow-shared nodes) (borrow-shared trees) binding))
							(if
								(:doc "Other static values keep their previous type and extent handling.")
								(bool:and (i32:not-ltz init) (u32:eq (struct:get (slots.get init) state) 2u32))
								(then
									(let bits (struct:get (slots.get init) bits))
									(let-mut extent -1i32)
									(if (u32:not-lt 2147483647u32 bits) (then (set extent (i32:from-u32 bits))))
									(bindings.set index (call binding_with_integer_constant binding bits extent))))))
					(set index (i32:inc index))))
			(return (call constant_result 0u32 0i32 0i32 0i32 0u32))))

	(fn register_standalone_constants
		(:doc "Use the same defining-row evaluation for the single-source emitter and caller inspection.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (mut-array GraphBinding))) (returns EntryRead)
		(body
			(let files (array:alloc SuppliedFile 0i32))
			(let trees (array:alloc ScalarTree 0i32))
			(return (call constant_check (call register_integer_constants (borrow-shared source) (borrow-shared nodes)
				(borrow-shared files) (borrow-shared trees) (borrow-mut bindings))))))
)
