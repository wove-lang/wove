(module scalar_function_refs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check named Wove function references and intern the signatures they introduce.")

	(use wove-file "../c/arguments.wove" (only (value c_adapted_callback_argument)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./callback_types.wove" (only callback_formal_shape))
	(use wove-file "../source/c_owners.wove" (only c_type_word_end))
	(use wove-file "../source/scan.wove" (only is_metadata_form skip_whitespace (type SourceNode) (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/generics.wove" (only (value checked_operation_operand)))
	(use wove-file "../source/types.wove" (only is_builtin_scalar void_type))
	(use wove-file "./callable_types.wove" (only callable_type_error (type CallableShape)))
	(use wove-file "./function_rows.wove" (only checked_function_count resolve_call_target (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))
	(use wove-file "./records.wove" (only find_callable_type intern_callable_layout layout_count next_layout_node
		is_disabled_statement is_record_type record_index is_native_record is_optional_record_borrow optional_record_borrow_reference
		is_place_reference is_mutable_place_reference place_reference_target (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only callable_keyword entry_at entry_form is_scalar_name (value fn_ref_kind) (type EntryRead)))
	(use wove-file "./value_types.wove" (only value_matches_type))

	(fn read_function_reference
		(:doc "Resolve a bare fn-ref operand in the current module's function namespace.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(caller ScalarFunction) (functions (shared-array ScalarFunction)) (bindings (shared-array GraphBinding)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node fn_ref_kind 24u32))
			(if (u32:gtz form/error) (then (return form)))
			(let operand form/operand)
			(if (i32:ltz operand) (then (return (call entry_at node -1i32 24u32))))
			(let name (nodes.get operand))
			(if
				(:doc "An extra operand or a non-bare name cannot identify a concrete function.")
				(bool:or (i32:not-ltz name/next_sibling)
					(bool:not (call is_scalar_name (borrow-shared source) name)))
				(then (return (call entry_at name -1i32 24u32))))
			(if
				(:doc "A compile-time operation does not denote a runtime callable value.")
				(u8:eq name/generic_kind checked_operation_operand)
				(then (return (call entry_at name -1i32 24u32))))
			(let target (call resolve_call_target (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared bindings) caller name))
			(if (i32:ltz target) (then (return (call entry_at name -1i32 34u32))))
			(let callee (functions.get target))
			(if
				(:doc "Only a Wove body with the ordinary Wove ABI has a callable address.")
				(bool:or callee/entry (i32:ltz callee/body))
				(then (return (call entry_at name -1i32 24u32))))
			(return (call entry_at name target 0u32))))

	(let native_struct_word "struct")

	(fn callback_tag_matches
		(:doc "Compare exactly two decoded C type tokens while allowing their surrounding whitespace.")
		(params (spelling (shared-array u8)) (source (shared-array u8)) (tag SourceNode))
		(returns bool)
		(body
			(let first (call skip_whitespace (borrow-shared spelling) 0i32))
			(let first_end (call c_type_word_end (borrow-shared spelling) first))
			(let second (call skip_whitespace (borrow-shared spelling) first_end))
			(let second_end (call c_type_word_end (borrow-shared spelling) second))
			(return (bool:and
				(i32:eq (call skip_whitespace (borrow-shared spelling) second_end) spelling.len)
				(bool:and (call same_bytes (borrow-shared spelling) first first_end
					(borrow-shared native_struct_word) 0i32 native_struct_word.len)
					(call same_bytes (borrow-shared spelling) second second_end
						(borrow-shared source) tag/start tag/end))))))

	(fn callback_record_matches
		(:doc "Check that a scoped Wove reference names the exact C struct in the foreign prototype.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord))
			(reference u32) (tag_row i32)) (returns bool)
		(body
			(if
				(:doc "The Wove receiver only reads the callback's original record storage.")
				(bool:or (bool:not (call is_place_reference reference)) (call is_mutable_place_reference reference))
				(then (return (bool false))))
			(let type (call place_reference_target (borrow-shared records) reference))
			(if (bool:not (call is_record_type type)) (then (return (bool false))))
			(let layout (records.get (call record_index type)))
			(if (bool:not (call is_native_record layout)) (then (return (bool false))))
			(let literal (nodes.get layout/native))
			(let tag (nodes.get tag_row))
			(let start literal/start)
			(let end literal/end)
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let read (call decode_string (borrow-shared source)
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut decoded)))
			(if
				(:doc "Compare the same decoded type bytes that will be emitted into C.")
				(u32:gtz read/error)
				(then (return (bool false))))
			(return (call callback_tag_matches
				(borrow-shared (decoded.range 0i32 read/written))
				(borrow-shared source) tag))))

	(fn plan_adapted_callback
		(:doc "Resolve a direct fn-ref against the checked borrowed receiver signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (operand SourceNode)
			(caller ScalarFunction) (index i32) (formal i32) (view_start i32)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let receiver (call read_function_reference (borrow-shared source) (borrow-shared nodes)
				operand caller (borrow-shared functions) (borrow-shared bindings)))
			(if (u32:gtz receiver/error) (then (return receiver)))
			(let target receiver/operand)
			(let function (functions.get target))
			(let shape (call callback_formal_shape (borrow-shared source) (borrow-shared nodes)
				(struct:get (parameters.get formal) name)))
			(let invalid (call entry_at operand -1i32 24u32))
			(let arity shape/arity)
			(if
				(:doc "The receiver's result and arity match the C call exactly.")
				(bool:or (i32:not-eq function/arity arity)
					(u32:not-eq function/result 5u32))
				(then (return invalid)))
			(let first function/params)
			(let path (parameters.get first))
			(if
				(:doc "The callback lends a dynamically sized immutable byte view.")
				(bool:or (u32:not-eq path/type 34u32) (i32:not-ltz path/extent))
				(then (return invalid)))
			(let second (struct:get (parameters.get (i32:inc first)) type))
			(if
				(:doc "The two-argument receiver takes the original signed error number.")
				(i32:eq arity 2i32)
				(then (if (u32:not-eq second 5u32) (then (return invalid))))
				(else
					(let status second)
					(let visit (struct:get (parameters.get (i32:add first 2i32)) type))
					(if
						(:doc "A walk receiver also takes the optional status and exact signed visit code.")
						(bool:or (bool:not (call is_optional_record_borrow status)) (u32:not-eq visit 5u32))
						(then (return invalid)))
					(if
						(:doc "The optional status preserves the declared platform tag, including large-file variants.")
						(bool:not (call callback_record_matches (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
							(call optional_record_borrow_reference status (bool false)) shape/status))
						(then (return invalid)))
					(if
						(:doc "An extended walk receiver sees the exact fourth record through a shared loan.")
						(i32:eq arity 4i32)
						(then
							(let walk (struct:get (parameters.get (i32:add first 3i32)) type))
							(if
								(:doc "A mutable C parameter grants no write access to the Wove receiver.")
								(bool:not (call callback_record_matches (borrow-shared source) (borrow-shared nodes) (borrow-shared records)
									walk shape/walk))
								(then (return invalid)))))))
			(let source_base caller/source_base)
			(let start (i32:add view_start (i32:sub operand/start source_base)))
			(let end (i32:add view_start (i32:sub operand/end source_base)))
			(expressions.set index
				(struct:new ScalarExpression (kind c_adapted_callback_argument) (type 0u32) (target target)
					(first -1i32) (start start) (end end) (negative (bool false))
					(borrowed_owner (bool false)) (mutable_place (bool false)) (projection -1i32)
					(asset_start caller/file) (asset_end formal) (extent_check -1i32)))
			(return (call entry_at operand index 0u32))))

	(fn function_reference_shape
		(:doc "Read the scalar callable signature of a previously checked Wove definition.")
		(params (nodes (shared-array SourceNode)) (callee ScalarFunction) (parameters (shared-array ScalarParameter)))
		(returns CallableShape)
		(body
			(let result callee/result)
			(let invalid (call callable_type_error (call entry_at (nodes.get callee/name) -1i32 24u32)))
			(if
				(:doc "The initial function-value ABI has a scalar or void result.")
				(bool:not (bool:or (call is_builtin_scalar result) (u32:eq result (call void_type))))
				(then (return invalid)))
			(let base callee/params)
			(let end (i32:add base callee/arity))
			(let-mut index base)
			(let-mut first -1i32)
			(if
				(:doc "The original parameter form supplies the first named formal.")
				(i32:lt base end)
				(then
					(let parameter (parameters.get base))
					(set first (struct:get (nodes.get parameter/name) parent))))
			(while
				(:doc "Only scalar formals can be passed through the initial function-value ABI.")
				(i32:lt index end)
				(body
					(let parameter (parameters.get index))
					(if (bool:not (call is_builtin_scalar parameter/type)) (then (return invalid)))
					(set index (i32:inc index))))
			(return (struct:new CallableShape (first first) (result result)
				(named (bool true)) (start 0i32) (end 0i32) (error 0u32)))))

	(fn register_function_references
		(:doc "Intern inferred signatures before checking a definition's body. Defer diagnostics to the value planner.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (caller ScalarFunction)
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)))
		(returns void)
		(body
			(let root caller/body)
			(let-mut index (struct:get (nodes.get root) first_child))
			(while
				(:doc "Discover references only in ordinary, enabled syntax within the body.")
				(i32:not-ltz index)
				(body
					(let node (nodes.get index))
					(let head node/first_child)
					(let descend (bool:and (i32:not-ltz head)
						(bool:not (bool:or (call is_metadata_form (borrow-shared source) (borrow-shared nodes) node)
							(call is_disabled_statement (borrow-shared source) (borrow-shared nodes) node)))))
					(if
						(:doc "Only actual fn-ref forms can introduce inferred signatures.")
						(bool:and descend
							(u32:eq (call callable_keyword (borrow-shared source) (nodes.get head)) fn_ref_kind))
						(then
							(let reference (call read_function_reference (borrow-shared source) (borrow-shared nodes)
								node caller (borrow-shared functions) (borrow-shared bindings)))
							(if
								(:doc "Malformed or unresolved targets are still checked in source order by the planner.")
								(u32:eqz reference/error)
								(then
									(let callee (functions.get reference/operand))
									(let shape (call function_reference_shape (borrow-shared nodes) callee (borrow-shared parameters)))
									(let next (call layout_count (borrow-shared records)))
									(let registered (call intern_callable_layout (borrow-shared source) (borrow-shared nodes)
										(borrow-mut records) shape next))
									(if
										(:doc "Further distinct signatures cannot fit; the planner reports their own spans.")
										(i32:ltz registered)
										(then (return)))))))
					(set index (call next_layout_node (borrow-shared nodes) index root descend))))))

	(fn register_callable_references
		(:doc "Complete inferred callable layouts in checked function order before assigning C names or planning bodies.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(bindings (shared-array GraphBinding)) (records (mut-array ScalarRecord)))
		(returns void)
		(body
			(let count (call checked_function_count (borrow-shared functions)))
			(let-mut index 0i32)
			(while
				(:doc "Only Wove bodies contain references that can introduce new callable types.")
				(i32:lt index count)
				(body
					(let caller (functions.get index))
					(if
						(:doc "Native declarations have no Wove body to visit.")
						(i32:not-ltz caller/body)
						(then (call register_function_references (borrow-shared source) (borrow-shared nodes)
							caller (borrow-shared functions) (borrow-shared parameters)
							(borrow-shared bindings) (borrow-mut records))))
					(set index (i32:inc index))))))

	(fn plan_function_reference
		(:doc "Produce a copyable value with the defining Wove function's exact signature.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(caller ScalarFunction) (index i32) (expected u32) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let reference (call read_function_reference (borrow-shared source) (borrow-shared nodes)
				node caller (borrow-shared functions) (borrow-shared bindings)))
			(if (u32:gtz reference/error) (then (return reference)))
			(let target reference/operand)
			(let shape (call function_reference_shape (borrow-shared nodes) (functions.get target)
				(borrow-shared parameters)))
			(if
				(:doc "Unsupported signatures report at the referenced name in the caller.")
				(u32:gtz shape/error)
				(then (return (struct:new EntryRead (operand -1i32) (start reference/start)
					(end reference/end) (error 24u32) (related -1i32)))))
			(let type (call find_callable_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) shape))
			(if (u32:eqz type) (then (return (call entry_at node -1i32 16u32))))
			(if
				(:doc "Passing or replacing a function value requires exact parameters and result.")
				(bool:not (call value_matches_type expected type))
				(then (return (call entry_at node -1i32 24u32))))
			(expressions.set index
				(call expression_row fn_ref_kind type target -1i32 0i32 0i32 (bool false)))
			(return (call entry_at node index 0u32))))
)
