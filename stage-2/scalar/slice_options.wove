(module scalar_slice_options
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve lexical optional slice and native record views without transferring their borrowed storage.")

	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/generics.wove" (only (value normalized_i32_literal)))
	(use wove-file "./records.wove" (only read_array_extent is_optional_record_borrow optional_record_borrow_reference is_optional_buffered_record buffered_record_layout buffered_record_type))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/slice_options.wove" (only (value optional_view_type) (value optional_view_absent) (value buffered_record_absent) (value optional_view_unwrap) (value try_slice_kind)))
	(use wove-file "../source/numeric_ops.wove" (only (value exact_byte_view)))
	(use wove-file "./flow.wove" (only (type ScalarStatement)))
	(use wove-file "./function_rows.wove" (only find_function_parameter (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./locals.wove" (only find_local check_binding_name))
	(use wove-file "./owners.wove" (only owner_is_null_kind))
	(use wove-file "./loans.wove" (only expression_row runtime_expression (value infer_shared_array) (value scoped_array_initializer) (type ScalarExpression)))
	(use wove-file "./syntax.wove" (only entry_form entry_at entry_keyword (value borrowed_record_unwrap_kind) (type EntryRead)))

	(fn plan_try_slice
		(:doc "Check the immutable result slot, seed its shared receiver and i32 offset, and normalize the exact extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (expected u32) (statement i32) (caller ScalarFunction)
			(bindings (shared-array GraphBinding)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let binding (call form_parts (borrow-shared source) (borrow-shared nodes)
				(nodes.get statement)))
			(if
				(:doc "Only a direct immutable local initializer can retain the receiver's loan.")
				(bool:or (bool:or (expected.not-eq 42u32) (node/parent.not-eq statement))
					(u32:not-eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
						binding/head) 15u32))
				(then (return (call entry_at node -1i32 24u32))))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node
				try_slice_kind 24u32))
			(if form/error.gtz (then (return form)))
			(let receiver form/operand)
			(if receiver.ltz (then (return (call entry_at node -1i32 24u32))))
			(let loan (nodes.get receiver))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) loan))
			(if
				(:doc "The source lends shared access to original storage.")
				(u32:not-eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
					parts/head) 35u32)
				(then (return (call entry_at loan -1i32 24u32))))
			(let offset loan/next_sibling)
			(if offset.ltz (then (return (call entry_at node -1i32 24u32))))
			(let size (struct:get (nodes.get offset) next_sibling))
			(if
				(:doc "Every window takes exactly one receiver, offset, and extent.")
				(size.ltz.or (i32:not-ltz (struct:get (nodes.get size) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(let length (nodes.get size))
			(if
				(:doc "The size uses the same bare extent spelling as an exact array parameter.")
				(length/kind.not-eq 1u32)
				(then (return (call entry_at length -1i32 23u32))))
			(let extent (call read_array_extent (borrow-shared source) length
				(borrow-shared bindings) caller/file caller/source_base))
			(if extent.ltz (then (return (call entry_at length -1i32 23u32))))
			(expressions.set receiver
				(call expression_row 0u32 scoped_array_initializer -1i32 -1i32 0i32 0i32 (bool false)))
			(expressions.set offset
				(call expression_row 0u32 5u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(expressions.set size
				(call expression_row 1u32 5u32 normalized_i32_literal -1i32 extent 0i32 (bool false)))
			(expressions.set index
				(struct:new ScalarExpression (kind try_slice_kind) (type optional_view_type) (target -1i32)
					(first receiver) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (bool false)) (mutable_place (bool false)) (projection -1i32)
					(asset_start 0i32) (asset_end extent) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))

	(fn plan_view_option
		(:doc "Read an immutable option and recover its exact borrowed type when present.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (expected u32) (tag u32) (caller ScalarFunction) (statement i32) (view_start i32)
			(parameters (shared-array ScalarParameter)) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node tag 24u32))
			(if form/error.gtz (then (return form)))
			(let operand form/operand)
			(if
				(:doc "Only a named option has a lexical loan and checked descriptor.")
				(operand.ltz.or (i32:not-ltz (struct:get (nodes.get operand) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(let reference (nodes.get operand))
			(let checked (call check_binding_name (borrow-shared source) reference))
			(if checked/error.gtz (then (return checked)))
			(let binding (call find_local (borrow-shared source) (borrow-shared nodes) (borrow-shared statements)
				caller/first_statement statement reference))
			(let-mut option_type 0u32)
			(let-mut target -1i32)
			(let-mut reference_kind 6u32)
			(if
				(:doc "A lexical binding takes precedence over a formal with the same name.")
				binding.not-ltz
				(then
					(let slot (statements.get binding))
					(set option_type slot/type)
					(set target slot/target))
				(else
					(let parameter (call find_function_parameter (borrow-shared source) (borrow-shared nodes)
						caller (borrow-shared parameters) reference))
					(if
						(:doc "An incoming optional native reference already has the scope of the call.")
						parameter.not-ltz
						(then
							(let type (struct:get (parameters.get parameter) type))
							(if
								(:doc "Keep slice options tied to their original local initializer.")
								(call is_optional_record_borrow type)
								(then
									(set option_type type)
									(set target parameter)
									(set reference_kind 2u32)))))))
			(let buffered (call is_optional_buffered_record option_type))
			(let native (buffered.or (call is_optional_record_borrow option_type)))
			(if
				(:doc "Ordinary owned optionals still use the checked move form for extraction.")
				(bool:not (native.or (option_type.eq optional_view_type)))
				(then (return (call entry_at reference -1i32 24u32))))
			(if
				(:doc "A presence test is a Boolean read of the original slot.")
				(tag.eq optional_view_absent)
				(then
					(if
						(:doc "Presence can initialize a Boolean local or supply an exact Boolean operand.")
						(bool:not (bool:or (expected.eq 12u32) (expected.eq 42u32)))
						(then (return (call entry_at node -1i32 24u32))))
					(let-mut kind optional_view_absent)
					(let-mut place -1i32)
					(if
						(:doc "A caller-backed result tests only its native record slot.")
						buffered
						(then
							(expressions.set index
								(call expression_row buffered_record_absent 12u32 target -1i32 0i32 0i32 (bool false)))
							(return (call entry_at node index 0u32))))
					(if
						(:doc "A nullable native reference uses a pointer presence check.")
						native
						(then
							(set kind (call owner_is_null_kind))
							(if
								(:doc "Read an incoming pointer from its parameter row.")
								(reference_kind.eq 2u32)
								(then
									(expressions.set operand
										(call expression_row reference_kind option_type target -1i32 0i32 0i32 (bool false)))
									(set place operand)))))
					(expressions.set index
						(call expression_row kind 12u32 target place 0i32 0i32 (bool false)))
					(return (call entry_at node index 0u32))))
			(if
				(:doc "A present native pointer initializes an immutable reference inside the option's existing lexical loan.")
				native
				(then
					(let enclosing (call form_parts (borrow-shared source) (borrow-shared nodes)
						(nodes.get statement)))
					(if
						(:doc "Keep the native reference in a direct immutable binding in this scope.")
						(bool:or (bool:or (expected.not-eq 42u32) (node/parent.not-eq statement))
							(u32:not-eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
								enclosing/head) 15u32))
						(then (return (call entry_at node -1i32 24u32))))
					(expressions.set operand
						(call expression_row reference_kind option_type target -1i32 0i32 0i32 (bool false)))
					(let-mut type 0u32)
					(if
						(:doc "A caller-backed unwrap retains the scratch range along with the native pointer.")
						buffered
						(then (set type (call buffered_record_type (call buffered_record_layout option_type) (bool false))))
						(else (set type (call optional_record_borrow_reference option_type (bool false)))))
					(expressions.set index
						(call runtime_expression borrowed_record_unwrap_kind type node operand caller view_start))
					(return (call entry_at node index 0u32))))
			(let initializer (expressions.get (struct:get (statements.get binding) value)))
			(let type (struct:get (expressions.get initializer/first) type))
			(let byte (bool:and (type.eq 34u32)
				(bool:or (expected.eq 35u32) (expected.eq exact_byte_view))))
			(if
				(:doc "Unwrapping lends the original shared element type and cannot grant mutable access.")
				(bool:not (byte.or
					(bool:or (expected.eq type) (expected.eq infer_shared_array))))
				(then (return (call entry_at node -1i32 24u32))))
			(let base caller/source_base)
			(expressions.set index
				(struct:new ScalarExpression (kind optional_view_unwrap) (type type) (target target)
					(first -1i32)
					(start (view_start.add (node/start.sub base)))
					(end (view_start.add (node/end.sub base)))
					(negative (bool false)) (borrowed_owner (bool true)) (mutable_place (bool false)) (projection -1i32)
					(asset_start caller/file) (asset_end initializer/asset_end) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))
)
