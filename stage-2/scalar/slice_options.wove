(module scalar_slice_options
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve lexical optional shared views and keep their exact extent through extraction.")

	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/generics.wove" (only (value normalized_i32_literal)))
	(use wove-file "./records.wove" (only read_array_extent))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/slice_options.wove" (only (value optional_view_type) (value optional_view_absent) (value optional_view_unwrap) (value try_slice_kind)))
	(use wove-file "../source/numeric_ops.wove" (only (value exact_byte_view)))
	(use wove-file "./flow.wove" (only (type ScalarStatement)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./locals.wove" (only find_local read_local_name))
	(use wove-file "./loans.wove" (only expression_row (value infer_shared_array) (value scoped_array_initializer) (type ScalarExpression)))
	(use wove-file "./syntax.wove" (only entry_form entry_at entry_keyword (type EntryRead)))

	(fn plan_try_slice
		(:doc "Check the immutable result slot, seed its shared receiver and i32 offset, and normalize the exact extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (expected u32) (statement i32) (caller ScalarFunction)
			(bindings (shared-array GraphBinding)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let binding (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
				(array.load (local nodes) (local statement))))
			(if
				(:doc "Only a direct immutable local initializer can retain the receiver's loan.")
				(bool.or (bool.or (u32.not-eq (local expected) 42u32) (i32.not-eq (struct.get (local node) parent) (local statement)))
					(u32.not-eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
						(struct.get (local binding) head)) 15u32))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)
				(local try_slice_kind) 24u32))
			(if (u32.gtz (struct.get (local form) error)) (then (return (local form))))
			(let receiver (struct.get (local form) operand))
			(if (i32.ltz (local receiver)) (then (return (call entry_at (local node) -1i32 24u32))))
			(let loan (array.load (local nodes) (local receiver)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local loan)))
			(if
				(:doc "The source lends shared access to original storage.")
				(u32.not-eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
					(struct.get (local parts) head)) 35u32)
				(then (return (call entry_at (local loan) -1i32 24u32))))
			(let offset (struct.get (local loan) next_sibling))
			(if (i32.ltz (local offset)) (then (return (call entry_at (local node) -1i32 24u32))))
			(let size (struct.get (array.load (local nodes) (local offset)) next_sibling))
			(if
				(:doc "Every window takes exactly one receiver, offset, and extent.")
				(bool.or (i32.ltz (local size)) (i32.not-ltz (struct.get (array.load (local nodes) (local size)) next_sibling)))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let length (array.load (local nodes) (local size)))
			(if
				(:doc "The size uses the same bare extent spelling as an exact array parameter.")
				(u32.not-eq (struct.get (local length) kind) 1u32)
				(then (return (call entry_at (local length) -1i32 23u32))))
			(let extent (call read_array_extent (borrow-shared (local source)) (local length)
				(borrow-shared (local bindings)) (struct.get (local caller) file) (struct.get (local caller) source_base)))
			(if (i32.ltz (local extent)) (then (return (call entry_at (local length) -1i32 23u32))))
			(array.store (local expressions) (local receiver)
				(call expression_row 0u32 (local scoped_array_initializer) -1i32 -1i32 0i32 0i32 (bool false)))
			(array.store (local expressions) (local offset)
				(call expression_row 0u32 5u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(array.store (local expressions) (local size)
				(call expression_row 1u32 5u32 (local normalized_i32_literal) -1i32 (local extent) 0i32 (bool false)))
			(array.store (local expressions) (local index)
				(struct.new ScalarExpression (kind (local try_slice_kind)) (type (local optional_view_type)) (target -1i32)
					(first (local receiver)) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (bool false)) (mutable_place (bool false)) (projection -1i32)
					(asset_start 0i32) (asset_end (local extent)) (extent_check -1i32)))
			(return (call entry_at (local node) (local index) 0u32))))

	(fn plan_view_option
		(:doc "Read one immutable option and give each extraction its original element type and extent.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (expected u32) (tag u32) (caller ScalarFunction) (statement i32) (view_start i32)
			(statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local tag) 24u32))
			(if (u32.gtz (struct.get (local form) error)) (then (return (local form))))
			(let operand (struct.get (local form) operand))
			(if
				(:doc "Only a named option has a lexical loan and checked descriptor.")
				(bool.or (i32.ltz (local operand)) (i32.not-ltz (struct.get (array.load (local nodes) (local operand)) next_sibling)))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let reference (array.load (local nodes) (local operand)))
			(let local_form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local reference) 8u32 24u32))
			(if (u32.gtz (struct.get (local local_form) error)) (then (return (local local_form))))
			(let name_form (call read_local_name (borrow-shared (local source)) (borrow-shared (local nodes)) (local reference)
				(struct.get (local local_form) operand)))
			(if (u32.gtz (struct.get (local name_form) error)) (then (return (local name_form))))
			(let binding (call find_local (borrow-shared (local source)) (borrow-shared (local nodes)) (borrow-shared (local statements))
				(struct.get (local caller) first_statement) (local statement)
				(array.load (local nodes) (struct.get (local name_form) operand))))
			(if
				(:doc "Ordinary owned optionals still use the checked move form for extraction.")
				(bool.or (i32.ltz (local binding))
					(u32.not-eq (struct.get (array.load (local statements) (local binding)) type) (local optional_view_type)))
				(then (return (call entry_at (local reference) -1i32 24u32))))
			(let slot (array.load (local statements) (local binding)))
			(let name (struct.get (local slot) target))
			(if
				(:doc "A presence test is a Boolean read of the original slot.")
				(u32.eq (local tag) (local optional_view_absent))
				(then
					(if
						(:doc "Presence can initialize a Boolean local or supply an exact Boolean operand.")
						(bool.not (bool.or (u32.eq (local expected) 12u32) (u32.eq (local expected) 42u32)))
						(then (return (call entry_at (local node) -1i32 24u32))))
					(array.store (local expressions) (local index)
						(call expression_row (local optional_view_absent) 12u32 (local name) -1i32 0i32 0i32 (bool false)))
					(return (call entry_at (local node) (local index) 0u32))))
			(let initializer (array.load (local expressions) (struct.get (local slot) value)))
			(let type (struct.get (array.load (local expressions) (struct.get (local initializer) first)) type))
			(let byte (bool.and (u32.eq (local type) 34u32)
				(bool.or (u32.eq (local expected) 35u32) (u32.eq (local expected) (local exact_byte_view)))))
			(if
				(:doc "Unwrapping lends the original shared element type and cannot grant mutable access.")
				(bool.not (bool.or (local byte)
					(bool.or (u32.eq (local expected) (local type)) (u32.eq (local expected) (local infer_shared_array)))))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let base (struct.get (local caller) source_base))
			(array.store (local expressions) (local index)
				(struct.new ScalarExpression (kind (local optional_view_unwrap)) (type (local type)) (target (local name))
					(first -1i32)
					(start (i32.add (local view_start) (i32.sub (struct.get (local node) start) (local base))))
					(end (i32.add (local view_start) (i32.sub (struct.get (local node) end) (local base))))
					(negative (bool false)) (borrowed_owner (bool true)) (mutable_place (bool false)) (projection -1i32)
					(asset_start (struct.get (local caller) file)) (asset_end (struct.get (local initializer) asset_end)) (extent_check -1i32)))
			(return (call entry_at (local node) (local index) 0u32))))
)
