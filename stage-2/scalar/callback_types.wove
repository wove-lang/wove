(module scalar_callback_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Read native signatures for synchronous error and file-walk callbacks.")

	(use wove-file "../c/arguments.wove" (only is_c_sync_callback_mode))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "../c/identifiers.wove" (only is_c_identifier))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./signatures.wove" (only read_signature_head))
	(use wove-file "./syntax.wove" (only entry_form scalar_type (value fn_type_kind)))

	(struct CallbackShape
		(fields (arity i32) (status i32) (unavailable i32) (walk i32) (start i32) (end i32) (error u32)))

	(let c_string "c-cstr")
	(let optional_record "c-optional-record")
	(let mutable_record "c-mut-record")

	(fn callback_shape_at
		(:doc "Initialize a shape without any registered C operands.")
		(params (node SourceNode) (error u32)) (returns CallbackShape)
		(body
			(return (struct:new CallbackShape (arity 0i32) (status -1i32) (unavailable -1i32) (walk -1i32)
				(start (node.get start)) (end (node.get end)) (error error)))))

	(fn callback_word
		(:doc "Match a bare native callback word by its original bytes.")
		(params (source (shared-array u8)) (node SourceNode) (word (shared-array u8))) (returns bool)
		(body
			(return (bool:and (u32:eq (node.get kind) 1u32)
				(call same_bytes (borrow-shared source) (node.get start) (node.get end)
					(borrow-shared word) 0i32 word.len)))))

	(fn callback_identifier
		(:doc "Require an identifier token that can be emitted unchanged into C.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32)) (returns bool)
		(body
			(if (i32:ltz index) (then (return (bool false))))
			(let node (nodes.get index))
			(return (bool:and (u32:eq (node.get kind) 1u32)
				(call is_c_identifier (borrow-shared source) (node.get start) (node.get end))))))

	(fn callback_record_tag
		(:doc "Read the first operand of the requested native struct parameter form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(word (shared-array u8))) (returns i32)
		(body
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let head (parts.get head))
			(let tag (parts.get operands))
			(if
				(:doc "Require the correct pointer shape and a portable C struct tag.")
				(bool:and (i32:not-ltz head)
					(bool:and (call callback_word (borrow-shared source) (nodes.get head) (borrow-shared word))
						(call callback_identifier (borrow-shared source) (borrow-shared nodes) tag)))
				(then (return tag)))
			(return -1i32)))

	(fn read_callback_shape
		(:doc "Read an adapted C string callback and its optional file-walk records.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)) (returns CallbackShape)
		(body
			(let type (call entry_form (borrow-shared source) (borrow-shared nodes)
				node fn_type_kind 23u32))
			(if (u32:gtz (type.get error)) (then (return (call callback_shape_at node 0u32))))
			(let signature (call read_signature_head (borrow-shared source) (borrow-shared nodes)
				node (type.get operand) (bool false) (bool false)))
			(let first (signature.get params))
			(if
				(:doc "A c-cstr formal distinguishes the adapted native shape from an ordinary scalar signature.")
				(bool:or (i32:ltz first) (bool:not (call callback_word (borrow-shared source)
					(nodes.get first) (borrow-shared c_string))))
				(then (return (call callback_shape_at node 0u32))))
			(let result (call scalar_type (borrow-shared source) (borrow-shared nodes) (signature.get type_node)))
			(let second (struct:get (nodes.get first) next_sibling))
			(if
				(:doc "This synchronous native signature returns int and has no Wove body.")
				(bool:or (u32:not-eq result 5u32)
					(bool:or (i32:not-ltz (signature.get body)) (i32:ltz second)))
				(then (return (call callback_shape_at node 23u32))))
			(if
				(:doc "A path followed by one int is the synchronous error callback shape.")
				(bool:and (u32:eq (call scalar_type (borrow-shared source) (borrow-shared nodes) second) 5u32)
					(i32:ltz (struct:get (nodes.get second) next_sibling)))
				(then (return (struct:new CallbackShape (arity 2i32) (status -1i32) (unavailable -1i32) (walk -1i32)
					(start (node.get start)) (end (node.get end)) (error 0u32)))))
			(let optional (nodes.get second))
			(let status (call callback_record_tag (borrow-shared source) (borrow-shared nodes)
				optional (borrow-shared optional_record)))
			(if (i32:ltz status) (then (return (call callback_shape_at optional 23u32))))
			(let unavailable (struct:get (nodes.get status) next_sibling))
			(if
				(:doc "The third native argument is compared with this header constant before exposing status storage.")
				(bool:or (bool:not (call callback_identifier (borrow-shared source) (borrow-shared nodes) unavailable))
					(i32:not-ltz (struct:get (nodes.get unavailable) next_sibling)))
				(then (return (call callback_shape_at optional 23u32))))
			(let visit (optional.get next_sibling))
			(if
				(:doc "Keep the visit discriminator in its original signed C int domain.")
				(u32:not-eq (call scalar_type (borrow-shared source) (borrow-shared nodes) visit) 5u32)
				(then (return (call callback_shape_at node 23u32))))
			(let fourth (struct:get (nodes.get visit) next_sibling))
			(let-mut walk -1i32)
			(let-mut arity 3i32)
			(if
				(:doc "The extended form has one additional non-const struct pointer in the C ABI.")
				(i32:not-ltz fourth)
				(then
					(set arity 4i32)
					(let field (nodes.get fourth))
					(set walk (call callback_record_tag (borrow-shared source) (borrow-shared nodes)
						field (borrow-shared mutable_record)))
					(if
						(:doc "The walk record has an exact tag and ends the fixed signature.")
						(bool:or (i32:ltz walk) (bool:or (i32:not-ltz (field.get next_sibling))
							(i32:not-ltz (struct:get (nodes.get walk) next_sibling))))
						(then (return (call callback_shape_at field 23u32))))))
			(return (struct:new CallbackShape (arity arity) (status status) (unavailable unavailable) (walk walk)
				(start (node.get start)) (end (node.get end)) (error 0u32)))))

	(fn is_adapted_callback
		(:doc "Distinguish a foreign-only callback slot from a first-class scalar function value.")
		(params (mode u8) (type u32)) (returns bool)
		(body
			(return (bool:and (call is_c_sync_callback_mode mode) (u32:eq type (call void_type))))))

	(fn callback_formal_shape
		(:doc "Recover the validated native callback signature from its containing parameter form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name i32)) (returns CallbackShape)
		(body
			(let parameter (nodes.get (struct:get (nodes.get name) parent)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) parameter))
			(return (call read_callback_shape (borrow-shared source) (borrow-shared nodes)
				(nodes.get (parts.get operands))))))
)
