(module scalar_function_rows
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Keep checked Wove and C signatures and recover the defining declaration of a function binding.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only find_binding (type GraphBinding)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./syntax.wove" (only same_name))

	(struct ScalarFunction
		(:doc `A checked signature and its defining source identity.

		A negative body denotes a foreign declaration whose native name
		and declaration still refer to the source tree. A Wove body can be empty.
		A borrowed result names an exact checked parameter row in return_source.
		A caller-backed record also retains the byte view in return_scratch.
		The original C formals include native-only operands.
		c_variadic is zero for a nonvariadic function and negative for
		an empty Wove tail. A positive value marks the first row of a
		named C tail or the shared boundary marker for an open tail.
		A C text snapshot can retain a release symbol or an inline field and its native extent.
		A local field snapshot reads the sole checked record input without invoking C.
		A C record snapshot keeps its private mapping row and uses the field slot for the present variant ordinal.
		A record input stores its three formal positions and the two native field spellings.
		Source rows refer to the packed defining tree.`)
		(fields (declaration i32) (origin i32) (name i32) (params i32) (arity i32) (result u32)
			(return_source i32) (return_scratch i32) (first_statement i32) (identity u32) (c_name_slot i32) (entry bool) (c_strings i32) (c_vectors bool) (c_extents i32) (c_macro bool) (c_variadic i32) (c_nulls i32) (c_storage bool) (c_handle_out bool)
			(c_void_pointer bool) (c_snapshot bool) (c_snapshot_drop i32) (c_snapshot_field i32) (c_snapshot_extent i32)
			(c_snapshot_source bool) (c_snapshot_record i32) (c_formals i32) (c_fixed bool)
			(c_input_record i32) (c_input_data i32) (c_input_count i32) (c_input_pointer_name i32) (c_input_count_name i32)
			(file i32) (tree_base i32) (name_base i32) (tree_limit i32) (source_base i32) (body i32)))

	(fn function_with_c_name_slot
		(:doc "Assign a private C spelling slot while preserving the exact checked function row.")
		(params (entry ScalarFunction) (slot i32)) (returns ScalarFunction)
		(body
			(return (struct:new ScalarFunction (declaration (struct:get entry declaration)) (origin (struct:get entry origin))
				(name (struct:get entry name)) (params (struct:get entry params))
				(arity (struct:get entry arity)) (result (struct:get entry result))
				(return_source (struct:get entry return_source)) (return_scratch (struct:get entry return_scratch))
				(first_statement (struct:get entry first_statement)) (identity (struct:get entry identity))
				(c_name_slot slot) (entry (struct:get entry entry))
				(c_strings (struct:get entry c_strings)) (c_vectors (struct:get entry c_vectors))
				(c_extents (struct:get entry c_extents)) (c_macro (struct:get entry c_macro))
				(c_variadic (struct:get entry c_variadic)) (c_nulls (struct:get entry c_nulls))
				(c_storage (struct:get entry c_storage)) (c_handle_out (struct:get entry c_handle_out))
				(c_void_pointer (struct:get entry c_void_pointer))
				(c_snapshot (struct:get entry c_snapshot)) (c_snapshot_drop (struct:get entry c_snapshot_drop))
				(c_snapshot_field (struct:get entry c_snapshot_field)) (c_snapshot_extent (struct:get entry c_snapshot_extent))
				(c_snapshot_source (struct:get entry c_snapshot_source)) (c_snapshot_record (struct:get entry c_snapshot_record)) (c_formals (struct:get entry c_formals))
				(c_fixed (struct:get entry c_fixed)) (file (struct:get entry file))
				(c_input_record (struct:get entry c_input_record)) (c_input_data (struct:get entry c_input_data))
				(c_input_count (struct:get entry c_input_count)) (c_input_pointer_name (struct:get entry c_input_pointer_name))
				(c_input_count_name (struct:get entry c_input_count_name))
				(tree_base (struct:get entry tree_base)) (name_base (struct:get entry name_base))
				(tree_limit (struct:get entry tree_limit)) (source_base (struct:get entry source_base))
				(body (struct:get entry body))))))

	(fn is_record_out_status
		(:doc "The final Wove status place becomes the original typed C out pointer.")
		(params (function ScalarFunction) (formal i32)) (returns bool)
		(body (return (bool:and (i32:not-ltz (struct:get function return_scratch))
			(i32:eq formal (i32:dec (i32:add (struct:get function params) (struct:get function arity))))))))

	(fn is_record_input
		(:doc "The record-input contract is present when it has a checked native field name.")
		(params (function ScalarFunction)) (returns bool)
		(body (return (i32:gtz (struct:get function c_input_pointer_name)))))

	(fn is_record_input_hidden
		(:doc "The bounded data and count initialize C fields and never enter the native argument list.")
		(params (function ScalarFunction) (formal i32)) (returns bool)
		(body
			(return (bool:and (call is_record_input function)
				(bool:or (i32:eq formal (struct:get function c_input_data))
					(i32:eq formal (struct:get function c_input_count)))))))

	(struct ScalarParameter
		(:doc "Keep the checked formal row and its private C name fingerprint with the type and contracts.")
		(fields (name i32) (type u32) (identity u32) (c_mode u8) (c_size i32) (c_count i32) (extent i32)))

	(fn find_parameter
		(:doc `Look up a parameter within the owning function's contiguous parameter interval.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (name SourceNode)
			(parameters (shared-array ScalarParameter)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor start)
			(while
				(:doc "Only parameters of this function participate in its local namespace.")
				(i32:lt cursor end)
				(body
					(let item (array:load parameters cursor))
					(let node (array:load nodes (struct:get item name)))
					(if
						(:doc "Match the raw spelling before any C suffix transformation.")
						(call same_name (borrow-shared source) node name)
						(then (return cursor)))
					(set cursor (i32:inc cursor))))
			(return -1i32)))

	(fn find_function_parameter
		(:doc `Find a parameter in the current function's signature.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (caller ScalarFunction)
			(parameters (shared-array ScalarParameter)) (name SourceNode))
		(returns i32)
		(body
			(let start (struct:get caller params))
			(return (call find_parameter (borrow-shared source) (borrow-shared nodes) name
				(borrow-shared parameters) start (i32:add start (struct:get caller arity))))))

	(fn checked_function_count
		(:doc "Count the initialized signature prefix before visiting an overallocated graph table.")
		(params (functions (shared-array ScalarFunction))) (returns i32)
		(body
			(let-mut count 0i32)
			(while
				(:doc "Only positive source name rows are complete function signatures.")
				(bool:and (i32:lt count (array:len functions))
					(i32:gtz (struct:get (array:load functions count) name)))
				(body (set count (i32:inc count))))
			(return count)))

	(fn find_function
		(:doc `Look up a checked function by a byte span from either the source or an inspection query.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(spelling (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let-mut cursor 0i32)
			(while
				(:doc "The selected namespace is the populated function prefix.")
				(i32:lt cursor (array:len functions))
				(body
					(let target (array:load functions cursor))
					(if (i32:eqz (struct:get target name)) (then (return -1i32)))
					(let declared (array:load nodes (struct:get target name)))
					(if
						(:doc "C suffix sanitization has no role in source name resolution.")
						(call same_bytes (borrow-shared source) (struct:get declared start)
							(struct:get declared end) (borrow-shared spelling) start end)
						(then (return cursor)))
					(set cursor (i32:inc cursor))))
			(return -1i32)))

	(fn find_defining_function
		(:doc `Find the checked function for a canonical file and file-local declaration row.`)
		(params (functions (shared-array ScalarFunction)) (file i32) (declaration i32))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Find the canonical declaration rather than an alias's binding row.")
				(i32:lt index (array:len functions))
				(body
					(let function (array:load functions index))
					(if (i32:eqz (struct:get function name)) (then (return -1i32)))
					(if
						(:doc "Compare the defining file and the declaration row within that file.")
						(bool:and
							(i32:eq file (struct:get function file))
							(i32:eq declaration
								(i32:sub (struct:get function declaration) (struct:get function tree_base))))
						(then (return index)))
					(set index (i32:inc index))))
			(return -1i32)))

	(fn find_graph_function
		(:doc `Resolve a file-local spelling to its defining scalar function.

		The graph binding records the defining file and an original tree row.
		The scalar table keeps exactly one registered signature for that pair.`)
		(params (arena (shared-array u8)) (functions (shared-array ScalarFunction))
			(bindings (shared-array GraphBinding)) (owner i32) (base i32)
			(spelling (shared-array u8)) (start i32) (end i32))
		(returns i32)
		(body
			(let chosen (call find_binding (borrow-shared arena) (borrow-shared spelling)
				start end (borrow-shared bindings) (array:len bindings)
				owner (bool false) base 0u32))
			(if
				(:doc "An unavailable name reports back to the referencing file.")
				(i32:ltz chosen)
				(then (return -1i32)))
			(let binding (array:load bindings chosen))
			(return (call find_defining_function (borrow-shared functions)
				(struct:get binding file) (struct:get binding declaration)))))

	(fn resolve_call_target
		(:doc `Look up a named target in its caller's namespace or the single-file function table.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(bindings (shared-array GraphBinding)) (caller ScalarFunction) (name SourceNode))
		(returns i32)
		(body
			(let start (struct:get name start))
			(let end (struct:get name end))
			(if
				(:doc "A supplied graph already provides the file's selected name bindings.")
				(i32:gtz (array:len bindings))
				(then (return (call find_graph_function (borrow-shared source)
					(borrow-shared functions) (borrow-shared bindings)
					(struct:get caller file) (struct:get caller source_base)
					(borrow-shared source) start end))))
			(return (call find_function (borrow-shared source) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared source) start end))))

	(fn find_function_instance
		(:doc "Locate a concrete Wove signature by its original or cloned declaration row.")
		(params (functions (shared-array ScalarFunction)) (declaration i32)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only populated signatures can be reached by a checked declaration row.")
				(i32:lt index (array:len functions))
				(body
					(let instance (array:load functions index))
					(if (i32:eqz (struct:get instance name)) (then (return -1i32)))
					(if
						(:doc "Aliases and repeated applications keep the same defining declaration row.")
						(i32:eq (struct:get instance declaration) declaration)
						(then (return index)))
					(set index (i32:inc index))))
			(return -1i32)))
)
