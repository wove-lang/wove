	(fn has_scoped_place_loan
		(:doc `Check active lexical loans of a local array, parameter, or parent view.

		A shared loan permits reads of its source. A mutable loan excludes
		every access through the source for the lifetime of the binding.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(statement i32) (target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(let-mut index (struct.get (array.load (local statements) (local statement)) previous_loan))
			(while
				(:doc "Only declarations on the current lexical chain can impose a loan.")
				(i32.lt -1i32 (local index))
