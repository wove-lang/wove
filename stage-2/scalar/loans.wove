(module scalar_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check scoped and call loans by binding identity and statically checked field path.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/types.wove" (only is_builtin_numeric))
	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind)))
	(use wove-file "../source/array_growth.wove" (only (value array_try_extend_kind) (value array_try_push_kind) is_array_growth (value indexed_row_owner)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./records.wove" (only (type ScalarRecord) place_borrow_kind is_mutable_place_reference
		is_writable_slice is_native_record record_index record_receiver_type is_typed_slice is_place_reference
		is_readable_slice is_record_type is_fixed_array is_array_owner encode_place_type place_reference_code
		array_slot_code slice_element_code typed_slice_type owner_view_type))
	(use wove-file "./flow.wove" (only (type ScalarStatement) (value fixed_shared_loan) (value fixed_mut_loan)))
	(use wove-file "./syntax.wove" (only (type EntryRead) entry_at entry_form is_direct_call is_reborrow_keyword (value fixed_subarray_place) (value fixed_owner_take) (value fixed_owner_borrow) (value fixed_owner_store) (value array_try_copy_kind)))
	(use wove-file "./native_owner_types.wove" (only is_native_owner))
	(use wove-file "./owners.wove" (only native_handle_borrow_kind is_native_owner_write_loan owned_field_loan_kind))

	(struct
		(:doc `A checked expression at its source row.

		Literals carry significant digit offsets in the arena. Conversions
		and checked runtime operations carry the original file identity
		in target and the half-open byte span in start and end. First
		points at the initial operand to evaluate. A reborrow's target
		is its defining parameter row or its source local's name row.
		A range reborrow links to the evaluated slice in its child.
		The borrowed_owner flag uses the local namespace for a loan's target,
		including when the source is a named view.
		A place read links to its root binding expression in projection.
		A projected loan links to the borrowed field expression there. A direct
		Wove call with a borrowed result links to its selected actual argument.
		An array growth operation links to its checked owner place there.
		The indirect-local marker distinguishes a for item's backing pointer
		from an ordinary local. Other negative projections have no field path. An integer literal
		uses target for its radix marker or its decoded character byte.
		An embed carries its path token span until asset resolution replaces it
		with the byte range to emit. A module binding reference (62) names its
		defining name node. The same row at a declaration marks its storage used.
		A checked local or scalar reference read records whether its place permits writes. An
		exact call loan with unknown length carries extent_check and the
		call argument's original runtime span. Worker operations record the caller file in
		asset_start and their operation span in start and end. Worker owner
		initializers and reads carry the exact owned result type in asset_end.
		An exact slice constructor and its unwrap carry the extent there.
		Named view reborrows preserve that extent, or -1 when it is unknown.`)
		ScalarExpression
		(fields (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool) (borrowed_owner bool)
			(mutable_place bool) (projection i32) (asset_start i32) (asset_end i32) (extent_check i32)))

	(let indirect_local_place -2i32)
	(let local_slice_view 146u32)
	(let local_slice_projection 147u32)
	(let scoped_field_loan 252u32)
	(let indexed_record_loan 253u32)
	(let scoped_array_initializer 48u32)
	(let infer_shared_array 49u32)
	(let infer_mut_array 50u32)

	(fn expression_row
		(:doc `Build a checked expression row, or an unvisited row with an expected scalar type.`)
		(params (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool))
		(returns ScalarExpression)
		(body
			(return (struct.new ScalarExpression (kind (local kind)) (type (local type)) (target (local target))
				(first (local first)) (start (local start)) (end (local end)) (negative (local negative))
				(borrowed_owner (bool false)) (mutable_place (bool false)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn borrowed_call_row
		(:doc "Retain the evaluated argument that lends storage to a call's result.")
		(params (type u32) (callee i32) (first i32) (source i32))
		(returns ScalarExpression)
		(body
			(return (struct.new ScalarExpression (kind 3u32) (type (local type)) (target (local callee))
				(first (local first)) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner (bool false))
				(mutable_place (bool false)) (projection (local source)) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn returned_call_argument
		(:doc "Read provenance only from checked direct calls that carry an argument row.")
		(params (value ScalarExpression)) (returns i32)
		(body
			(if (u32.eq (struct.get (local value) kind) 3u32) (then (return (struct.get (local value) projection))))
			(return -1i32)))

	(fn runtime_expression
		(:doc `Keep the operation's span in its original file, before graph packing or subrange selection.`)
		(params (kind u32) (type u32) (node SourceNode) (first i32) (caller ScalarFunction) (view_start i32))
		(returns ScalarExpression)
		(body
			(let source_base (struct.get (local caller) source_base))
			(let start (i32.add (local view_start)
				(i32.sub (struct.get (local node) start) (local source_base))))
			(let end (i32.add (local view_start)
				(i32.sub (struct.get (local node) end) (local source_base))))
			(return (call expression_row (local kind) (local type) (struct.get (local caller) file)
				(local first) (local start) (local end) (bool false)))))

	(fn writable_place
		(:doc `Identify a writable local or existing exclusive reference at the root of a place.`)
		(params (binding ScalarExpression))
		(returns bool)
		(body (return (bool.or (struct.get (local binding) mutable_place)
			(call is_mutable_place_reference (struct.get (local binding) type))))))

	(fn check_writable_field
		(:doc `Require a checked field projection to name writable Wove storage.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (place i32)
			(records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let root (call field_place_root (borrow-shared (local expressions)) (local place)))
			(let value (array.load (local expressions) (local root)))
			(let original (array.load (local nodes) (local root)))
			(let kind (struct.get (local value) kind))
			(if
				(:doc "A field of a temporary or non-local expression has no writable place.")
				(bool.not (bool.or (u32.eq (local kind) 6u32) (u32.eq (local kind) 2u32)))
				(then (return (call entry_at (local original) -1i32 24u32))))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local original)))
			(let name (array.load (local nodes) (struct.get (local parts) operands)))
			(if
				(:doc "A mutable local or exclusive record reference supplies the original writable storage.")
				(bool.not (call writable_place (local value)))
				(then (return (call entry_at (local name) -1i32 37u32))))
			(let type (call record_receiver_type (struct.get (local value) type)))
			(let layout (array.load (local records) (call record_index (local type))))
			(if
				(:doc "Ordinary Wove field places use Wove-defined layouts.")
				(call is_native_record (local layout))
				(then (return (call entry_at (local original) -1i32 24u32))))
			(return (call entry_at (array.load (local nodes) (local place)) (local place) 0u32))))

	(fn call_loan_keyword
		(:doc `Get the explicit reborrow keyword for an argument's expected type.`)
		(params (expected u32))
		(returns u32)
		(body
			(if
				(:doc "Typed slice formals retain their exact type instead of a keyword code.")
				(call is_typed_slice (local expected))
				(then
					(if
						(:doc "A writable formal requires an exclusive reborrow.")
						(call is_writable_slice (local expected))
						(then (return 39u32)))
					(return 35u32)))
			(if
				(:doc "An exclusive place requires the mutable borrow spelling.")
				(call is_mutable_place_reference (local expected))
				(then (return 39u32)))
			(if
				(:doc "A shared place or resource formal requires the shared borrow spelling.")
				(bool.or (call is_native_owner (local expected)) (call is_place_reference (local expected)))
				(then (return 35u32)))
			(return (local expected))))

	(fn inferred_array_loan
		(:doc `Infer a borrow expectation from the checked source's exact element type.`)
		(params (records (shared-array ScalarRecord)) (origin ScalarExpression) (writable bool))
		(returns u32)
		(body
			(let type (struct.get (local origin) type))
			(let-mut element 0u32)
			(if
				(:doc "An owner and an existing view expose the element type through their descriptor.")
				(call is_array_owner (local type))
				(then (set (local element) (call array_slot_code (local type))))
				(else
					(if
						(:doc "Reborrowing a view preserves the original element identity.")
						(call is_readable_slice (local type))
						(then (set (local element) (call slice_element_code (local type))))
						(else
							(if
								(:doc "A fixed local or checked field can lend its inline numeric storage.")
								(bool.and (bool.or (u32.eq (struct.get (local origin) kind) 6u32)
									(u32.eq (struct.get (local origin) kind) 52u32)) (call is_record_type (local type)))
								(then
									(let layout (array.load (local records) (call record_index (local type))))
									(if
										(:doc "An inferred inline loan uses the fixed layout's exact numeric element.")
										(call is_fixed_array (local layout))
										(then
											(let code (u32.from-i32 (struct.get (local layout) first)))
											(if (call is_builtin_numeric (local code)) (then (set (local element) (local code))))))))))))
			(if (u32.eqz (local element)) (then (return 0u32)))
			(if
				(:doc "Byte views use the existing dedicated borrow keywords.")
				(u32.eq (local element) 10u32)
				(then
					(if (local writable) (then (return 39u32)))
					(return 35u32)))
			(return (call typed_slice_type (local element) (local writable)))))

	(fn store_place_loan
		(:doc `Check the identity and access mode of a whole or projected place loan.`)
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32)
			(statement i32) (expected u32) (actual u32) (binding ScalarExpression) (place i32)
			(statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let mutable (call is_mutable_place_reference (local expected)))
			(if
				(:doc "The exact storage type and original access mode must agree with the requested reference.")
				(bool.or (u32.not-eq (call encode_place_type (local actual)) (call place_reference_code (local expected)))
					(bool.and (local mutable) (bool.not (call writable_place (local binding)))))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let target (struct.get (local binding) target))
			(let local_binding (u32.eq (struct.get (local binding) kind) 6u32))
			(if
				(:doc "An earlier shared loan also conflicts when the new overlapping loan is exclusive.")
				(call has_conflicting_loan (borrow-shared (local nodes)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(local index) (local statement) (local target) (local local_binding) (local place) (local mutable))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let-mut projection (local place))
			(if
				(:doc "A whole reference local already holds the address of the checked place.")
				(bool.and (local local_binding) (bool.and (i32.ltz (local place))
					(call is_place_reference (struct.get (local binding) type))))
				(then (set (local projection) (local indirect_local_place))))
			(array.store (local expressions) (local index)
				(struct.new ScalarExpression (kind (call place_borrow_kind)) (type (local expected))
					(target (local target)) (first -1i32) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (local local_binding)) (mutable_place (bool false)) (projection (local projection))
					(asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at (local node) (local index) 0u32))))

	(fn plan_owned_field_loan
		(:doc "Lend the original array descriptor through a checked field path.")
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32) (place i32) (statement i32)
			(expected u32) (owner u32) (binding ScalarExpression) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let-mut type (local expected))
			(if
				(:doc "Byte borrow keywords carry the corresponding view code one below them.")
				(call is_reborrow_keyword (local expected))
				(then (set (local type) (u32.dec (local expected)))))
			(let mutable (call is_writable_slice (local type)))
			(let target (struct.get (local binding) target))
			(let local_binding (u32.eq (struct.get (local binding) kind) 6u32))
			(if
				(:doc "The loan must match the field's exact element type. An exclusive loan needs writable storage.")
				(bool.or (u32.not-eq (local type) (call owner_view_type (local owner) (local mutable)))
					(bool.or (bool.and (local mutable) (bool.not (call writable_place (local binding))))
						(call has_conflicting_loan (borrow-shared (local nodes)) (borrow-shared (local expressions))
							(borrow-shared (local statements)) (local index) (local statement) (local target) (local local_binding) (local place) (local mutable))))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(array.store (local expressions) (local index)
				(struct.new ScalarExpression (kind (call owned_field_loan_kind)) (type (local type)) (target (local target))
					(first -1i32) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner (local local_binding))
					(mutable_place (bool false)) (projection (local place)) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at (local node) (local index) 0u32))))

	(fn plan_scoped_field_loan
		(:doc "Lend an existing shared byte descriptor from its original record place.")
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32) (place i32) (statement i32)
			(expected u32) (binding ScalarExpression) (statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let target (struct.get (local binding) target))
			(let local_binding (u32.eq (struct.get (local binding) kind) 6u32))
			(if
				(:doc "The descriptor only grants shared access, and a live exclusive borrow of the place excludes it.")
				(bool.or (bool.not (bool.or (u32.eq (local expected) 35u32) (u32.eq (local expected) 34u32)))
					(call has_conflicting_loan (borrow-shared (local nodes)) (borrow-shared (local expressions))
						(borrow-shared (local statements)) (local index) (local statement) (local target) (local local_binding) (local place) (bool false)))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(array.store (local expressions) (local index)
				(struct.new ScalarExpression (kind (local scoped_field_loan)) (type 34u32) (target (local target))
					(first -1i32) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (local local_binding)) (mutable_place (bool false))
					(projection (local place)) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at (local node) (local index) 0u32))))

	(fn read_borrow_source
		(:doc `Read one explicit borrow form with exactly one storage operand.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (keyword u32))
		(returns EntryRead)
		(body
			(let loan (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local keyword) 24u32))
			(if (u32.gtz (struct.get (local loan) error)) (then (return (local loan))))
			(let source_index (struct.get (local loan) operand))
			(if
				(:doc "A borrow must name one source.")
				(bool.or (i32.ltz (local source_index))
					(i32.lt -1i32 (struct.get (array.load (local nodes) (local source_index)) next_sibling)))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(return (local loan))))

	(fn finish_indexed_array_loan
		(:doc "Match the indexed element to the requested view and retain its original place.")
		(params (node SourceNode) (index i32) (reference_index i32) (receiver i32)
			(expected u32) (record bool) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let element (array.load (local expressions) (local reference_index)))
			(let type (struct.get (local element) type))
			(let-mut view (local expected))
			(if
				(:doc "The shared byte reborrow keyword corresponds to the original byte descriptor.")
				(call is_reborrow_keyword (local expected))
				(then (set (local view) (u32.dec (local expected)))))
			(if
				(:doc "An explicit formal accepts only its own shared row view.")
				(bool.not (bool.or (bool.or (u32.eq (local view) (local infer_shared_array)) (u32.eq (local view) (local infer_mut_array)))
					(u32.eq (local view) (local type))))
				(then (return (call entry_at (local node) -1i32 24u32))))
			(let origin (array.load (local expressions) (local receiver)))
			(let-mut target (struct.get (local origin) target))
			(let-mut local_binding (struct.get (local origin) borrowed_owner))
			(let-mut path -1i32)
			(if
				(:doc "An inline slot loan is tied to the local or record field holding the fixed buffer.")
				(u32.eq (struct.get (local element) kind) (local fixed_owner_borrow))
				(then
					(let base (call fixed_access_base (borrow-shared (local expressions)) (local receiver)))
					(let array (array.load (local expressions) (local base)))
					(let-mut home (local base))
					(if
						(:doc "A field retains the path under its original record binding.")
						(u32.eq (struct.get (local array) kind) 52u32)
						(then
							(set (local home) (struct.get (local array) projection))
							(set (local path) (local base))))
					(let binding (array.load (local expressions) (local home)))
					(set (local target) (struct.get (local binding) target))
					(set (local local_binding) (u32.eq (struct.get (local binding) kind) 6u32))))

			(let-mut kind 45u32)
			(if (local record) (then (set (local kind) (local indexed_record_loan))))
			(array.store (local expressions) (local index)
				(struct.new ScalarExpression (kind (local kind)) (type (local type)) (target (local target))
					(first (local reference_index)) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (local local_binding)) (mutable_place (bool false))
					(projection (local path)) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at (local node) (local index) 0u32))))

	(fn mutable_parameter_place
		(:doc `Represent the scalar pointee while retaining its parameter's identity and write permission.`)
		(params (type u32) (parameter i32))
		(returns ScalarExpression)
		(body
			(return (struct.new ScalarExpression (kind 2u32) (type (local type)) (target (local parameter))
				(first -1i32) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner (bool false))
				(mutable_place (bool true)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn is_local_slice_view
		(:doc `Recognize a descriptor read or reborrow from a named view local.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local local_slice_view))
			(u32.eq (local kind) (local local_slice_projection))))))

	(fn field_place_root
		(:doc `Follow checked field projections toward the original binding or value expression.`)
		(params (expressions (shared-array ScalarExpression)) (place i32))
		(returns i32)
		(body
			(let-mut root (local place))
			(while
				(:doc "Each checked field points at its immediate receiver.")
				(u32.eq (struct.get (array.load (local expressions) (local root)) kind) 52u32)
				(body (set (local root) (struct.get (array.load (local expressions) (local root)) first))))
			(return (local root))))

	(fn field_path_relation
		(:doc `Compare paths from one binding. Return disjoint, equal, left ancestor, or right ancestor.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32))
		(returns u32)
		(body
			(if
				(:doc "A whole binding covers every field below it.")
				(i32.ltz (local left))
				(then
					(if (i32.ltz (local right)) (then (return 1u32)))
					(return 2u32)))
			(if (i32.ltz (local right)) (then (return 3u32)))
			(let-mut a (struct.get (array.load (local expressions) (local left)) projection))
			(let-mut b (struct.get (array.load (local expressions) (local right)) projection))
			(while
				(:doc "Walk out from each root through the matched field ordinals.")
				(bool.not (bool.or (i32.eq (local a) (local left)) (i32.eq (local b) (local right))))
				(body
					(set (local a) (struct.get (array.load (local nodes) (local a)) parent))
					(set (local b) (struct.get (array.load (local nodes) (local b)) parent))
					(if
						(:doc "Different fields of the same enclosing record have independent storage.")
						(i32.not-eq (struct.get (array.load (local expressions) (local a)) target)
							(struct.get (array.load (local expressions) (local b)) target))
						(then (return 0u32)))))
			(if
				(:doc "The left path ended at or before the right path.")
				(i32.eq (local a) (local left))
				(then
					(if (i32.eq (local b) (local right)) (then (return 1u32)))
					(return 2u32)))
			(return 3u32)))

	(fn paths_overlap
		(:doc "A path overlaps itself and any enclosing or enclosed place.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32))
		(returns bool)
		(body
			(return (u32.not-eqz (call field_path_relation (borrow-shared (local nodes))
				(borrow-shared (local expressions)) (local left) (local right))))))

	(fn path_covers
		(:doc "Test whether the left place contains the right one, optionally requiring a proper ancestor.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32) (strict bool))
		(returns bool)
		(body
			(let relation (call field_path_relation (borrow-shared (local nodes))
				(borrow-shared (local expressions)) (local left) (local right)))
			(return (bool.or (u32.eq (local relation) 2u32)
				(bool.and (bool.not (local strict)) (u32.eq (local relation) 1u32))))))

	(fn same_binding
		(:doc `Compare binding rows within their local or parameter namespace.`)
		(params (target i32) (local_binding bool) (other i32) (other_local bool))
		(returns bool)
		(body
			(return (bool.and (i32.eq (local target) (local other))
				(bool.or (bool.and (local local_binding) (local other_local))
					(bool.not (bool.or (local local_binding) (local other_local))))))))

	(fn indexed_owner_base
		(:doc "Recover the original local or field under a checked indexed row place.")
		(params (expressions (shared-array ScalarExpression)) (receiver i32)) (returns i32)
		(body
			(let-mut base (local receiver))
			(while
				(:doc "Each checked row place points to its containing owner.")
				(u32.eq (struct.get (array.load (local expressions) (local base)) kind) (local indexed_row_owner))
