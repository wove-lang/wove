						(:doc "Even an absent exact slice holds the constructor receiver's shared loan.")
						(u32.eq (struct.get (local initializer) kind) (local try_slice_kind))
						(then (set (local argument) (struct.get (local initializer) first))))
					(if
						(:doc "Read the inherited loan with its original storage and access mode.")
						(i32.not-ltz (local argument))
