								(bool.and (bool.and (bool.not (local native)) (u32.not-eq (local kind) 62u32))
									(bool.and (call same_binding (local target) (local local_binding)
										(struct.get (local origin) target) (struct.get (local origin) borrowed_owner))
										(bool.and (bool.or (local exclusive) (call is_writable_slice (struct.get (local origin) type)))
											(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
												(local place) (local projection)))))
								(then (return (bool true))))))
					(set (local index) (struct.get (local declaration) previous_loan))))
			(return (bool false))))

	(fn has_scoped_array_loan
		(:doc "Check loans before accessing an entire local array, parameter, or parent view.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
