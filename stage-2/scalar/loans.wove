						(:doc "A scoped record holds the shared loans of its constructor fields.")
						(u32.eq (struct.get (local origin) kind) 50u32)
						(then
							(if
								(:doc "Shared field loans allow reads but prevent exclusive access to their sources.")
								(bool.and (local exclusive)
									(call scoped_record_source (borrow-shared (local nodes)) (borrow-shared (local expressions))
										(struct.get (local origin) first) -1i32 (local target) (local local_binding)))
								(then (return (bool true)))))
						(else
							(let kind (struct.get (local origin) kind))
							(let-mut projection -1i32)
							(if
								(:doc "A view of a named field only holds the corresponding path.")
								(bool.or (bool.or (u32.eq (local kind) (local scoped_field_loan))
									(u32.eq (local kind) (call owned_field_loan_kind)))
									(bool.and (i32.not-ltz (local argument))
										(bool.or (u32.eq (local kind) 45u32)
											(bool.or (u32.eq (local kind) (local fixed_shared_loan))
