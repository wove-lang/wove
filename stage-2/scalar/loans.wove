(module scalar_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check scoped and call loans by binding identity and statically checked field path.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only is_builtin_numeric))
	(use wove-file "../source/slice_options.wove" (only (value try_slice_kind)))
	(use wove-file "../source/array_growth.wove" (only (value array_try_extend_kind) (value array_try_push_kind) is_array_growth (value indexed_row_owner)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction)))
	(use wove-file "./records.wove" (only (type ScalarRecord) place_borrow_kind is_mutable_place_reference
		is_writable_slice is_native_record record_index record_receiver_type is_typed_slice is_place_reference
		is_readable_slice is_record_type is_fixed_array is_array_owner encode_place_type place_reference_code
		array_slot_code slice_element_code typed_slice_type owner_view_type shared_byte_rows_type))
	(use wove-file "./flow.wove" (only (type ScalarStatement) (value fixed_shared_loan) (value fixed_mut_loan)))
	(use wove-file "./syntax.wove" (only (type EntryRead) entry_at entry_form is_direct_call is_reborrow_keyword (value fixed_subarray_place) (value fixed_owner_take) (value fixed_owner_borrow) (value fixed_owner_store) (value array_try_copy_kind) (value native_tail_load_kind) (value native_cstrs_view_kind)))
	(use wove-file "./native_owner_types.wove" (only is_native_owner))
	(use wove-file "./owners.wove" (only native_handle_borrow_kind is_native_owner_write_loan owned_field_loan_kind (value native_handle_slot_borrow_kind)))

	(struct ScalarExpression
		(:doc `A checked expression at its source row.

		Literals carry significant digit offsets in the arena. Conversions
		and checked runtime operations carry the original file identity
		in target and the half-open byte span in start and end. First
		points at the initial operand to evaluate. A reborrow's target
		is its defining parameter row or its source local's name row.
		A range reborrow links to the evaluated slice in its child.
		The borrowed_owner flag uses the local namespace for a loan's target,
		including when the source is a named view.
		A place read links to its root binding expression in projection.
		A projected loan links to the borrowed field expression there. A direct
		Wove call with a borrowed result links to its selected actual argument.
		A caller-backed C record also links to its scratch loan in extent_check.
		An array growth operation links to its checked owner place there.
		The indirect-local marker distinguishes a for item's backing pointer
		from an ordinary local. Other negative projections have no field path. An integer literal
		uses target for its radix marker or its decoded character byte.
		An embed carries its path token span until asset resolution replaces it
		with the byte range to emit. A module binding reference (62) names its
		defining name node. The same row at a declaration marks its storage used.
		A native inline field projection carries its exact byte extent in asset_end.
		A caller-backed pointer field marks that slot negative and keeps its diagnostic file in asset_start.
		A checked local or scalar reference read records whether its place permits writes. An
		exact call loan with unknown length carries extent_check and the
		call argument's original runtime span. An inline owner argument uses a
		negative guard code in the same slot. Worker operations record the caller file in
		asset_start and their operation span in start and end. Worker owner
		initializers and reads carry the exact owned result type in asset_end.
		A fallible launch records its queue's defining binding in projection
		and uses negative for a rejection variant declared before success.
		An exact slice constructor and its unwrap carry the extent there.
		Named view reborrows preserve that extent, or -1 when it is unknown.`)
		(fields (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool) (borrowed_owner bool)
			(mutable_place bool) (projection i32) (asset_start i32) (asset_end i32) (extent_check i32)))

	(let inline_owner_argument_guard -2i32)
	(let indirect_local_place -2i32)
	(let local_slice_view 146u32)
	(let local_slice_projection 147u32)
	(let scoped_field_loan 252u32)
	(let indexed_record_loan 253u32)
	(let scoped_array_initializer 48u32)
	(let infer_shared_array 49u32)
	(let infer_mut_array 50u32)

	(fn expression_row
		(:doc `Build a checked expression row, or an unvisited row with an expected scalar type.`)
		(params (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool))
		(returns ScalarExpression)
		(body
			(return (struct:new ScalarExpression (kind kind) (type type) (target target)
				(first first) (start start) (end end) (negative negative)
				(borrowed_owner (bool false)) (mutable_place (bool false)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn borrowed_call_row
		(:doc "Retain the evaluated argument that lends storage to a call's result.")
		(params (type u32) (callee i32) (first i32) (source i32) (scratch i32))
		(returns ScalarExpression)
		(body
			(return (struct:new ScalarExpression (kind 3u32) (type type) (target callee)
				(first first) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner (bool false))
				(mutable_place (bool false)) (projection source) (asset_start 0i32) (asset_end 0i32) (extent_check scratch)))))

	(fn returned_call_argument
		(:doc "Read provenance only from checked direct calls that carry an argument row.")
		(params (value ScalarExpression)) (returns i32)
		(body
			(if (value/kind.eq 3u32) (then (return value/projection)))
			(return -1i32)))

	(fn returned_call_scratch
		(:doc "Read the second backing place only from a checked direct caller-backed record call.")
		(params (value ScalarExpression)) (returns i32)
		(body
			(if (value/kind.eq 3u32) (then (return value/extent_check)))
			(return -1i32)))

	(fn runtime_expression
		(:doc `Keep the operation's span in its original file, before graph packing or subrange selection.`)
		(params (kind u32) (type u32) (node SourceNode) (first i32) (caller ScalarFunction) (view_start i32))
		(returns ScalarExpression)
		(body
			(let source_base caller/source_base)
			(let start (view_start.add
				(node/start.sub source_base)))
			(let end (view_start.add
				(node/end.sub source_base)))
			(return (call expression_row kind type caller/file
				first start end (bool false)))))

	(fn is_c_inline_projection
		(:doc "Distinguish an indexed native inline member from an ordinary record field read.")
		(params (value ScalarExpression)) (returns bool)
		(body (return (bool:and (value/kind.eq 52u32)
			value/asset_end.gtz))))

	(fn is_buffered_field_projection
		(:doc "A native pointer field needs the byte range of its caller-backed receiver.")
		(params (value ScalarExpression)) (returns bool)
		(body (return (bool:and (value/kind.eq 52u32)
			(value/asset_end.eq -1i32)))))

	(fn buffered_field_projection
		(:doc "Retain the original native field and source span for its bounded runtime read.")
		(params (type u32) (target i32) (receiver i32) (file i32) (start i32) (end i32))
		(returns ScalarExpression)
		(body
			(return (struct:new ScalarExpression (kind 52u32) (type type) (target target)
				(first receiver) (start start) (end end) (negative (bool false)) (borrowed_owner (bool false))
				(mutable_place (bool false)) (projection -1i32) (asset_start file) (asset_end -1i32)
				(extent_check -1i32)))))

	(fn writable_place
		(:doc `Identify a writable local or existing exclusive reference at the root of a place.`)
		(params (binding ScalarExpression))
		(returns bool)
		(body (return (binding/mutable_place.or
			(call is_mutable_place_reference binding/type)))))

	(fn check_writable_field
		(:doc `Require a checked field projection to name writable Wove storage.`)
		(params (nodes (shared-array SourceNode)) (place i32)
			(records (shared-array ScalarRecord)) (expressions (shared-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let root (call field_place_root (borrow-shared expressions) place))
			(let value (expressions.get root))
			(let original (nodes.get root))
			(let kind value/kind)
			(if
				(:doc "A field of a temporary or non-local expression has no writable place.")
				(bool:not (bool:or (kind.eq 6u32) (kind.eq 2u32)))
				(then (return (call entry_at original -1i32 24u32))))
			(if
				(:doc "A mutable local or exclusive record reference supplies the original writable storage.")
				(bool:not (call writable_place value))
				(then (return (call entry_at original -1i32 37u32))))
			(let type (call record_receiver_type value/type))
			(let layout (records.get (call record_index type)))
			(if
				(:doc "Ordinary Wove field places use Wove-defined layouts.")
				(call is_native_record layout)
				(then (return (call entry_at original -1i32 24u32))))
			(return (call entry_at (nodes.get place) place 0u32))))

	(fn call_loan_keyword
		(:doc `Get the explicit reborrow keyword for an argument's expected type.`)
		(params (expected u32))
		(returns u32)
		(body
			(if
				(:doc "Typed slice formals retain their exact type instead of a keyword code.")
				(call is_typed_slice expected)
				(then
					(if
						(:doc "A writable formal requires an exclusive reborrow.")
						(call is_writable_slice expected)
						(then (return 39u32)))
					(return 35u32)))
			(if
				(:doc "An exclusive place requires the mutable borrow spelling.")
				(call is_mutable_place_reference expected)
				(then (return 39u32)))
			(if
				(:doc "A shared place or resource formal requires the shared borrow spelling.")
				(bool:or (call is_native_owner expected) (call is_place_reference expected))
				(then (return 35u32)))
			(return expected)))

	(fn inferred_array_loan
		(:doc `Infer a borrow expectation from the checked source's exact element type.`)
		(params (records (shared-array ScalarRecord)) (origin ScalarExpression) (writable bool))
		(returns u32)
		(body
			(let type origin/type)
			(let-mut element 0u32)
			(if
				(:doc "An owner and an existing view expose the element type through their descriptor.")
				(call is_array_owner type)
				(then (set element (call array_slot_code type)))
				(else
					(if
						(:doc "Reborrowing a view preserves the original element identity.")
						(call is_readable_slice type)
						(then (set element (call slice_element_code type)))
						(else
							(if
								(:doc "A fixed local or checked field can lend its inline numeric storage.")
								(bool:and (bool:or (origin/kind.eq 6u32)
									(origin/kind.eq 52u32)) (call is_record_type type))
								(then
									(let layout (records.get (call record_index type)))
									(if
										(:doc "An inferred inline loan uses the fixed layout's exact numeric element.")
										(call is_fixed_array layout)
										(then
											(let code (u32:from-i32 layout/first))
											(if (call is_builtin_numeric code) (then (set element code)))))))))))
			(if element.eqz (then (return 0u32)))
			(if
				(:doc "Byte views use the existing dedicated borrow keywords.")
				(element.eq 10u32)
				(then
					(if writable (then (return 39u32)))
					(return 35u32)))
			(return (call typed_slice_type element writable))))

	(fn store_place_loan
		(:doc `Check the identity and access mode of a whole or projected place loan.`)
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32)
			(statement i32) (expected u32) (actual u32) (binding ScalarExpression) (place i32)
			(statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let mutable (call is_mutable_place_reference expected))
			(if
				(:doc "The exact storage type and original access mode must agree with the requested reference.")
				(bool:or (u32:not-eq (call encode_place_type actual) (call place_reference_code expected))
					(mutable.and (bool:not (call writable_place binding))))
				(then (return (call entry_at node -1i32 24u32))))
			(let target binding/target)
			(let local_binding (binding/kind.eq 6u32))
			(if
				(:doc "An earlier shared loan also conflicts when the new overlapping loan is exclusive.")
				(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions) (borrow-shared statements)
					index statement target local_binding place mutable)
				(then (return (call entry_at node -1i32 24u32))))
			(let-mut projection place)
			(if
				(:doc "A whole reference local already holds the address of the checked place.")
				(local_binding.and (place.ltz.and
					(call is_place_reference binding/type)))
				(then (set projection indirect_local_place)))
			(expressions.set index
				(struct:new ScalarExpression (kind (call place_borrow_kind)) (type expected)
					(target target) (first -1i32) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner local_binding) (mutable_place (bool false)) (projection projection)
					(asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))

	(fn plan_owned_field_loan
		(:doc "Lend the original array descriptor through a checked field path.")
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32) (place i32) (statement i32)
			(expected u32) (owner u32) (binding ScalarExpression) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let-mut type expected)
			(if
				(:doc "Byte borrow keywords carry the corresponding view code one below them.")
				(call is_reborrow_keyword expected)
				(then (set type expected.dec)))
			(let mutable (call is_writable_slice type))
			(let target binding/target)
			(let local_binding (binding/kind.eq 6u32))
			(if
				(:doc "The loan must match the field's exact element type. An exclusive loan needs writable storage.")
				(bool:or (type.not-eq (call owner_view_type owner mutable))
					(bool:or (mutable.and (bool:not (call writable_place binding)))
						(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions)
							(borrow-shared statements) index statement target local_binding place mutable)))
				(then (return (call entry_at node -1i32 24u32))))
			(expressions.set index
				(struct:new ScalarExpression (kind (call owned_field_loan_kind)) (type type) (target target)
					(first -1i32) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner local_binding)
					(mutable_place (bool false)) (projection place) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))

	(fn plan_scoped_field_loan
		(:doc "Lend an existing shared byte descriptor from its original record place.")
		(params (nodes (shared-array SourceNode)) (node SourceNode) (index i32) (place i32) (statement i32)
			(expected u32) (binding ScalarExpression) (statements (shared-array ScalarStatement)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let target binding/target)
			(let local_binding (binding/kind.eq 6u32))
			(if
				(:doc "The descriptor only grants shared access, and a live exclusive borrow of the place excludes it.")
				(bool:or (bool:not (bool:or (expected.eq 35u32) (expected.eq 34u32)))
					(call has_conflicting_loan (borrow-shared nodes) (borrow-shared expressions)
						(borrow-shared statements) index statement target local_binding place (bool false)))
				(then (return (call entry_at node -1i32 24u32))))
			(expressions.set index
				(struct:new ScalarExpression (kind scoped_field_loan) (type 34u32) (target target)
					(first -1i32) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner local_binding) (mutable_place (bool false))
					(projection place) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))

	(fn read_borrow_source
		(:doc `Read one explicit borrow form with exactly one storage operand.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (keyword u32))
		(returns EntryRead)
		(body
			(let loan (call entry_form (borrow-shared source) (borrow-shared nodes)
				node keyword 24u32))
			(if loan/error.gtz (then (return loan)))
			(let source_index loan/operand)
			(if
				(:doc "A borrow must name one source.")
				(source_index.ltz.or
					(i32:lt -1i32 (struct:get (nodes.get source_index) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(return loan)))

	(fn finish_indexed_array_loan
		(:doc "Match the indexed element to the requested view and retain its original place.")
		(params (node SourceNode) (index i32) (reference_index i32) (receiver i32)
			(expected u32) (record bool) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let element (expressions.get reference_index))
			(let type element/type)
			(let-mut view expected)
			(if
				(:doc "The shared byte reborrow keyword corresponds to the original byte descriptor.")
				(call is_reborrow_keyword expected)
				(then (set view expected.dec)))
			(if
				(:doc "An explicit formal accepts only its own shared row view.")
				(bool:not (bool:or (bool:or (view.eq infer_shared_array) (view.eq infer_mut_array))
					(view.eq type)))
				(then (return (call entry_at node -1i32 24u32))))
			(let origin (expressions.get receiver))
			(let-mut target origin/target)
			(let-mut local_binding origin/borrowed_owner)
			(let-mut path -1i32)
			(if
				(:doc "An inline slot loan is tied to the local or record field holding the fixed buffer.")
				(element/kind.eq fixed_owner_borrow)
				(then
					(let base (call fixed_access_base (borrow-shared expressions) receiver))
					(let array (expressions.get base))
					(let-mut home base)
					(if
						(:doc "A field retains the path under its original record binding.")
						(array/kind.eq 52u32)
						(then
							(set home array/projection)
							(set path base)))
					(let binding (expressions.get home))
					(set target binding/target)
					(set local_binding (bool:or (binding/kind.eq 6u32)
						(bool:and (call is_readable_slice binding/type) binding/borrowed_owner)))))

			(let-mut kind 45u32)
			(if record (then (set kind indexed_record_loan)))
			(expressions.set index
				(struct:new ScalarExpression (kind kind) (type type) (target target)
					(first reference_index) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner local_binding) (mutable_place (bool false))
					(projection path) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))

	(fn mutable_parameter_place
		(:doc `Represent the scalar pointee while retaining its parameter's identity and write permission.`)
		(params (type u32) (parameter i32))
		(returns ScalarExpression)
		(body
			(return (struct:new ScalarExpression (kind 2u32) (type type) (target parameter)
				(first -1i32) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner (bool false))
				(mutable_place (bool true)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn is_local_slice_view
		(:doc `Recognize a descriptor read or reborrow from a named view local.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (kind.eq local_slice_view)
			(kind.eq local_slice_projection)))))

	(fn field_place_root
		(:doc `Follow checked field projections toward the original binding or value expression.`)
		(params (expressions (shared-array ScalarExpression)) (place i32))
		(returns i32)
		(body
			(let-mut root place)
			(while
				(:doc "Each checked field points at its immediate receiver.")
				(u32:eq (struct:get (expressions.get root) kind) 52u32)
				(body (set root (struct:get (expressions.get root) first))))
			(return root)))

	(fn field_path_relation
		(:doc `Compare paths from one binding. Return disjoint, equal, left ancestor, or right ancestor.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32))
		(returns u32)
		(body
			(if
				(:doc "A whole binding covers every field below it.")
				left.ltz
				(then
					(if right.ltz (then (return 1u32)))
					(return 2u32)))
			(if right.ltz (then (return 3u32)))
			(let-mut a (struct:get (expressions.get left) projection))
			(let-mut b (struct:get (expressions.get right) projection))
			(while
				(:doc "Walk out from each root through the matched field ordinals.")
				(bool:not (bool:or (a.eq left) (b.eq right)))
				(body
					(set a (struct:get (nodes.get a) parent))
					(set b (struct:get (nodes.get b) parent))
					(if
						(:doc "Different fields of the same enclosing record have independent storage.")
						(i32:not-eq (struct:get (expressions.get a) target)
							(struct:get (expressions.get b) target))
						(then (return 0u32)))))
			(if
				(:doc "The left path ended at or before the right path.")
				(a.eq left)
				(then
					(if (b.eq right) (then (return 1u32)))
					(return 2u32)))
			(return 3u32)))

	(fn paths_overlap
		(:doc "A path overlaps itself and any enclosing or enclosed place.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32))
		(returns bool)
		(body
			(return (u32:not-eqz (call field_path_relation (borrow-shared nodes)
				(borrow-shared expressions) left right)))))

	(fn path_covers
		(:doc "Test whether the left place contains the right one, optionally requiring a proper ancestor.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32) (strict bool))
		(returns bool)
		(body
			(let relation (call field_path_relation (borrow-shared nodes)
				(borrow-shared expressions) left right))
			(return (bool:or (relation.eq 2u32)
				(strict.not.and (relation.eq 1u32))))))

	(fn same_binding
		(:doc `Compare binding rows within their local or parameter namespace.`)
		(params (target i32) (local_binding bool) (other i32) (other_local bool))
		(returns bool)
		(body
			(return (bool:and (target.eq other)
				(bool:or (local_binding.and other_local)
					(bool:not (local_binding.or other_local)))))))

	(fn indexed_owner_base
		(:doc "Recover the original local or field under a checked indexed row place.")
		(params (expressions (shared-array ScalarExpression)) (receiver i32)) (returns i32)
		(body
			(let-mut base receiver)
			(while
				(:doc "Each checked row place points to its containing owner.")
				(u32:eq (struct:get (expressions.get base) kind) indexed_row_owner)
				(body (set base (struct:get (expressions.get base) first))))
			(return base)))

	(fn indexed_growth_receiver
		(:doc "Locate an indexed growth receiver before the ordinary operation operand.")
		(params (expressions (shared-array ScalarExpression)) (operation ScalarExpression)) (returns i32)
		(body
			(if
				(:doc "Other operations do not use projection for a growth receiver.")
				(bool:not (call is_array_growth operation/kind))
				(then (return -1i32)))
			(let place operation/projection)
			(if
				(:doc "Only a checked indexed receiver needs a runtime capture.")
				(place.not-ltz.and
					(u32:eq (struct:get (expressions.get place) kind) indexed_row_owner))
				(then (return place)))
			(return -1i32)))

	(fn fixed_access_base
		(:doc "Follow checked subarray addresses to the original inline array place.")
		(params (expressions (shared-array ScalarExpression)) (receiver i32)) (returns i32)
		(body
			(let-mut base receiver)
			(while
				(:doc "Every subarray address links its immediate containing place.")
				(u32:eq (struct:get (expressions.get base) kind) fixed_subarray_place)
				(body (set base (struct:get (expressions.get base) first))))
			(return base)))

	(fn projected_store_conflicts
		(:doc `A projected indexed store holds its field through the index and value expressions.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(receiver i32) (target i32) (local_binding bool) (place i32) (owning_slot bool) (exclusive bool))
		(returns bool)
		(body
			(let base (call fixed_access_base (borrow-shared expressions)
				(call indexed_owner_base (borrow-shared expressions) receiver)))
			(let source (expressions.get base))
			(if
				(:doc "A nested fixed projection keeps the containing heap descriptor stable through its later operands.")
				(call is_readable_slice source/type)
				(then (return (call descriptor_receiver_conflicts (borrow-shared nodes) (borrow-shared expressions)
					base target local_binding place exclusive))))
			(if
				(:doc "Dynamic subscript paths into one local conservatively overlap the entire local.")
				(bool:and (owning_slot.or (base.not-eq receiver))
					(source/kind.eq 6u32))
				(then (return (call same_binding target local_binding source/target (bool true)))))
			(let root source/projection)
			(if
				(:doc "A whole fixed local uses the existing direct fixed-array store rules.")
				root.ltz
				(then (return (bool false))))
			(let binding (expressions.get root))
			(return (bool:and
				(call same_binding target local_binding binding/target
					(binding/kind.eq 6u32))
				(call paths_overlap (borrow-shared nodes) (borrow-shared expressions)
					place base)))))

	(fn shared_byte_row_source
		(:doc "Find the borrowed row's outer descriptor without confusing a runtime span with a loan identity.")
		(params (expressions (shared-array ScalarExpression)) (load ScalarExpression))
		(returns i32)
		(body
			(if
				(:doc "Other loads either copy an element or require an explicit owning-row borrow.")
				(bool:and (load/kind.eq 37u32) (load/type.eq 34u32))
				(then
					(let source load/first)
					(if
						(:doc "Only this outer element type stores the shared descriptor itself.")
						(u32:eq (struct:get (expressions.get source) type) (call shared_byte_rows_type))
						(then (return source)))))
			(return -1i32)))

	(fn descriptor_receiver_conflicts
		(:doc `A captured array descriptor keeps its backing storage lent until access completes.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(receiver i32) (target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(let-mut source receiver)
			(let rows (call shared_byte_row_source (borrow-shared expressions)
				(expressions.get receiver)))
			(if
				(:doc "Reading a selected row keeps the outer descriptor live through the access.")
				rows.not-ltz
				(then (set source rows)))
			(let view (expressions.get source))
			(let-mut origin view/target)
			(let-mut origin_local view/borrowed_owner)
			(let-mut projection view/projection)
			(if
				(:doc "A descriptor field's target is its ordinal. Use its record binding and full field path.")
				(view/kind.eq 52u32)
				(then
					(if projection.ltz (then (return (bool false))))
					(let binding (expressions.get projection))
					(set origin binding/target)
					(set origin_local (binding/kind.eq 6u32))
					(if
						(:doc "A temporary native member view conservatively borrows the complete C record.")
						(call is_c_inline_projection view)
						(then (set projection -1i32))
						(else (set projection source)))))
			(return (bool:and
				(bool:and (view/kind.not-eq 62u32)
					(call same_binding target local_binding origin origin_local))
				(bool:and (exclusive.or (call is_writable_slice view/type))
					(call paths_overlap (borrow-shared nodes) (borrow-shared expressions)
						place projection))))))

	(fn loan_conflicts
		(:doc `Check whether an earlier loan and the requested access can coexist at an overlapping place.`)
		(params (loan ScalarExpression) (exclusive bool))
		(returns bool)
		(body
			(let kind loan/kind)
			(if
				(:doc "Place loans retain their access mode in the checked reference type.")
				(bool:or (kind.eq (call place_borrow_kind)) (kind.eq indexed_record_loan))
				(then (return (exclusive.or (call is_mutable_place_reference loan/type)))))
			(if
				(:doc "Ranges and local reborrows retain the requested access mode.")
				(bool:or (kind.eq (call owned_field_loan_kind))
					(bool:or (bool:or (kind.eq 45u32) (kind.eq scoped_field_loan))
						(call is_local_slice_view kind)))
				(then (return (exclusive.or (call is_writable_slice loan/type)))))
			(return (bool:or
				(bool:or (kind.eq 39u32) (kind.eq fixed_mut_loan))
				(exclusive.and
					(bool:or (kind.eq fixed_shared_loan)
						(kind.eq 35u32)))))))

	(fn native_loan_conflicts
		(:doc "Compare earlier native loans against the same local or the overlapping path of a projected handle.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (loan ScalarExpression)
			(target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(let kind loan/kind)
			(let writable (call is_native_owner_write_loan kind))
			(if
				(:doc "Shared native loans coexist. An exclusive native loan excludes overlapping access.")
				(bool:not (writable.or
					(exclusive.and
						(bool:or (kind.eq (call native_handle_borrow_kind))
							(kind.eq native_handle_slot_borrow_kind)))))
				(then (return (bool false))))
			(let earlier loan/first)
			(let pointer (expressions.get earlier))
			(if
				(:doc "Native loans of two distinct fields can coexist.")
				(bool:and (pointer/kind.eq 52u32)
					pointer/projection.not-ltz)
				(then
					(let root (expressions.get pointer/projection))
					(return (bool:and (call same_binding target local_binding
						root/target (root/kind.eq 6u32))
						(call paths_overlap (borrow-shared nodes) (borrow-shared expressions)
							place earlier)))))
			(return (local_binding.and (bool:and (pointer/kind.eq 6u32)
				(pointer/target.eq target))))))

	(fn scoped_record_source
		(:doc "Check the original array or parent view of each initialized borrowed field.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(first i32) (stop i32) (target i32) (local_binding bool))
		(returns bool)
		(body
			(let-mut field first)
			(while
				(:doc "Only earlier or fully initialized fields hold a descriptor.")
				(bool:and (i32:lt -1i32 field) (field.not-eq stop))
				(body
					(let member (expressions.get field))
					(let view (expressions.get member/first))
					(if
						(:doc "A shared descriptor freezes its defining source; static data needs no loan.")
						(bool:and (view/type.eq 34u32)
							(bool:and (view/kind.not-eq 62u32)
								(call same_binding target local_binding
									view/target view/borrowed_owner)))
						(then (return (bool true))))
					(set field (struct:get (nodes.get field) next_sibling))))
			(return (bool false))))

	(fn exclusive_backing_conflicts
		(:doc "An output record keeps each captured exclusive argument's original place locked.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (index i32)
			(target i32) (local_binding bool) (place i32)) (returns bool)
		(body
			(let origin (expressions.get index))
			(return (bool:and
				(call same_binding target local_binding origin/target origin/borrowed_owner)
				(call paths_overlap (borrow-shared nodes) (borrow-shared expressions) place
					origin/projection)))))
	(fn has_scoped_place_loan
		(:doc `Check active lexical loans of a local array, parameter, or parent view.

		A shared loan permits reads of its source. A mutable loan excludes
		every access through the source for the lifetime of the binding.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(statement i32) (target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(let-mut index (struct:get (statements.get statement) previous_loan))
			(while
				(:doc "Only declarations on the current lexical chain can impose a loan.")
				(i32:lt -1i32 index)
				(body
					(let declaration (statements.get index))
					(let-mut value declaration/value)
					(let initializer (expressions.get value))
					(let-mut argument (call returned_call_argument initializer))
					(let scratch (call returned_call_scratch initializer))
					(let pair scratch.not-ltz)
					(if
						(:doc "Either backing store can invalidate a live caller-backed record.")
						(pair.and
							(bool:or (call exclusive_backing_conflicts (borrow-shared nodes) (borrow-shared expressions)
									argument target local_binding place)
								(call exclusive_backing_conflicts (borrow-shared nodes) (borrow-shared expressions)
									scratch target local_binding place)))
						(then (return (bool true))))
					(let vector (initializer/kind.eq native_cstrs_view_kind))
					(if
						(:doc "A native vector borrows its original storage owner for the binding's scope.")
						vector
						(then (set argument initializer/first)))
					(if
						(:doc "Even an absent exact slice holds the constructor receiver's shared loan.")
						(initializer/kind.eq try_slice_kind)
						(then (set argument initializer/first)))
					(if
						(:doc "Read the inherited loan with its original storage and access mode.")
						argument.not-ltz
						(then (set value argument)))
					(let rows (call shared_byte_row_source (borrow-shared expressions)
						(expressions.get value)))
					(if
						(:doc "A locally bound row borrows its source descriptor for the scope.")
						rows.not-ltz
						(then (set value rows)))
					(let origin (expressions.get value))
					(let native (pair.or (argument.not-ltz.and
						(vector.or (call is_native_owner_write_loan origin/kind)))))
					(if
						(:doc "A native record or vector holds its original owner loan until the binding leaves scope.")
						(native.and
							(call native_loan_conflicts (borrow-shared nodes) (borrow-shared expressions)
								origin target local_binding place exclusive))
						(then (return (bool true))))
					(if
						(:doc "A scoped record holds the shared loans of its constructor fields.")
						(origin/kind.eq 50u32)
						(then
							(if
								(:doc "Shared field loans allow reads but prevent exclusive access to their sources.")
								(exclusive.and
									(call scoped_record_source (borrow-shared nodes) (borrow-shared expressions)
										origin/first -1i32 target local_binding))
								(then (return (bool true)))))
						(else
							(let kind origin/kind)
							(let-mut projection -1i32)
							(if
								(:doc "An inline or owned field loan keeps its checked path even when bound directly.")
								(bool:or (bool:or (kind.eq scoped_field_loan)
									(kind.eq (call owned_field_loan_kind)))
									(bool:or (bool:or (kind.eq fixed_shared_loan)
										(kind.eq fixed_mut_loan))
										(argument.not-ltz.and (kind.eq 45u32))))
								(then (set projection origin/projection)))
							(if
								(:doc "Only a lexical view can freeze this place. Native loans match their handle operand above.")
								(bool:and (native.not.and (kind.not-eq 62u32))
									(bool:and (call same_binding target local_binding
										origin/target origin/borrowed_owner)
										(bool:and (exclusive.or (call is_writable_slice origin/type))
											(call paths_overlap (borrow-shared nodes) (borrow-shared expressions)
												place projection))))
								(then (return (bool true))))))
					(set index declaration/previous_loan)))
			(return (bool false))))

	(fn has_scoped_array_loan
		(:doc "Check loans before accessing an entire local array, parameter, or parent view.")
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(statement i32) (target i32) (local_binding bool) (exclusive bool))
		(returns bool)
		(body (return (call has_scoped_place_loan (borrow-shared nodes) (borrow-shared statements)
			(borrow-shared expressions) statement target local_binding -1i32 exclusive))))

	(fn has_conflicting_loan
		(:doc `Find a conflicting loan in earlier operands of an enclosing operation.

		Call arguments hold their loans until the call returns. A load or
		range holds its captured descriptor through the index or endpoints.
		An owner or projected store holds its receiver through the index
		and value. Loans made by nested calls in completed operands have ended.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(statements (shared-array ScalarStatement)) (index i32) (statement i32)
			(target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(if
				(:doc "A named view holds its loan independently of other operands.")
				(call has_scoped_place_loan (borrow-shared nodes) (borrow-shared statements) (borrow-shared expressions)
					statement target local_binding place exclusive)
				(then (return (bool true))))
			(let-mut child index)
			(while
				(:doc "Walk from the current operand up to its statement.")
				(child.not-eq statement)
				(body
					(let parent (struct:get (nodes.get child) parent))
					(let operation (expressions.get parent))
					(let operation_kind operation/kind)
					(let first operation/first)
					(if
						(:doc "A recoverable append cannot invalidate the receiver or copy from its own live storage.")
						(bool:and
							(bool:or (operation_kind.eq array_try_extend_kind)
								(exclusive.and (operation_kind.eq array_try_push_kind)))
							(bool:and (child.eq first)
								(call projected_store_conflicts (borrow-shared nodes) (borrow-shared expressions)
									operation/projection target local_binding place (bool true) exclusive)))
						(then (return (bool true))))
					(let growth (call indexed_growth_receiver (borrow-shared expressions) operation))
					(if
						(:doc "Later expressions can read a captured row's owner but cannot invalidate the indexed place.")
						(exclusive.and
							(bool:or
								(growth.not-ltz.and
									(bool:and (child.not-eq growth)
										(call projected_store_conflicts (borrow-shared nodes) (borrow-shared expressions)
											growth target local_binding place (bool false) exclusive)))
								(bool:and (operation_kind.eq indexed_row_owner)
									(bool:and (child.not-eq first)
										(call projected_store_conflicts (borrow-shared nodes) (borrow-shared expressions)
											parent target local_binding place (bool false) exclusive)))))
						(then (return (bool true))))
					(let owning_slot (bool:or (operation_kind.eq fixed_owner_store)
						(bool:or (operation_kind.eq fixed_owner_take)
							(operation_kind.eq fixed_owner_borrow))))
					(if
						(:doc "An indexed field store excludes overlapping access while its later operands run.")
						(bool:and (bool:and (bool:or
									(bool:or (operation_kind.eq 74u32) (operation_kind.eq fixed_subarray_place))
									owning_slot)
								(child.not-eq first))
							(call projected_store_conflicts (borrow-shared nodes) (borrow-shared expressions)
								first target local_binding place owning_slot exclusive))
						(then (return (bool true))))
					(if
						(:doc "A load or range captures its receiver before evaluating later operands.")
						(bool:and (child.not-eq first)
							(bool:and (bool:or (operation_kind.eq try_slice_kind)
									(bool:or (operation_kind.eq 37u32) (operation_kind.eq 44u32)))
								(call descriptor_receiver_conflicts (borrow-shared nodes) (borrow-shared expressions)
									first target local_binding place exclusive)))
						(then (return (bool true))))
					(if
						(:doc "A native byte store keeps its record exclusively lent through the index and value.")
						(bool:and (operation_kind.eq 40u32)
							(bool:and (child.not-eq first)
								(bool:and (call is_c_inline_projection (expressions.get first))
									(call descriptor_receiver_conflicts (borrow-shared nodes)
										(borrow-shared expressions) first target local_binding
										place exclusive))))
						(then (return (bool true))))
					(if
						(:doc "An initialized record field keeps its shared loan through later constructor operands.")
						(bool:and (exclusive.and (operation_kind.eq 50u32))
							(call scoped_record_source (borrow-shared nodes) (borrow-shared expressions)
								first child target local_binding))
						(then (return (bool true))))
					(if
						(:doc "Calls and eager memory operations keep their earlier loans through later operands.")
						(bool:or (call is_direct_call operation_kind)
							(bool:or (operation_kind.eq 40u32)
								(bool:or (operation_kind.eq array_try_copy_kind)
									(operation_kind.eq native_tail_load_kind))))
						(then
							(let-mut earlier first)
							(while
								(:doc "Earlier operands are already checked in source evaluation order.")
								(earlier.not-eq child)
								(body
									(let loan (expressions.get earlier))
									(if
										(:doc "Native storage loans retain their original local or projected place.")
										(call native_loan_conflicts (borrow-shared nodes) (borrow-shared expressions)
											loan target local_binding place exclusive)
										(then (return (bool true))))
									(if
										(:doc "Compare defining bindings in the same namespace before comparing paths.")
										(bool:and (call same_binding target local_binding
											loan/target loan/borrowed_owner)
											(bool:and (call loan_conflicts loan exclusive)
												(call paths_overlap (borrow-shared nodes) (borrow-shared expressions)
													place loan/projection)))
										(then (return (bool true))))
									(set earlier (struct:get (nodes.get earlier) next_sibling))))))
					(set child parent)))
			(return (bool false)))))
