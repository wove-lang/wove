							(bool.or (u32.eq (local operation_kind) (local array_try_extend_kind))
								(bool.and (local exclusive) (u32.eq (local operation_kind) (local array_try_push_kind))))
							(bool.and (i32.eq (local child) (local first))
								(call projected_store_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
									(struct.get (local operation) projection) (local target) (local local_binding) (local place) (bool true))))
						(then (return (bool true))))
					(let growth (call indexed_growth_receiver (borrow-shared (local expressions)) (local operation)))
					(if
						(:doc "Later expressions can read a captured row's owner but cannot invalidate the indexed place.")
						(bool.and (local exclusive)
							(bool.or
								(bool.and (i32.not-ltz (local growth))
									(bool.and (i32.not-eq (local child) (local growth))
										(call projected_store_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
											(local growth) (local target) (local local_binding) (local place) (bool false))))
								(bool.and (u32.eq (local operation_kind) (local indexed_row_owner))
									(bool.and (i32.not-eq (local child) (local first))
										(call projected_store_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
											(local parent) (local target) (local local_binding) (local place) (bool false))))))
						(then (return (bool true))))
					(let owning_slot (bool.or (u32.eq (local operation_kind) (local fixed_owner_store))
						(bool.or (u32.eq (local operation_kind) (local fixed_owner_take))
							(u32.eq (local operation_kind) (local fixed_owner_borrow)))))
					(if
						(:doc "An indexed field store excludes overlapping access while its later operands run.")
						(bool.and (bool.and (bool.or
									(bool.or (u32.eq (local operation_kind) 74u32) (u32.eq (local operation_kind) (local fixed_subarray_place)))
									(local owning_slot))
								(i32.not-eq (local child) (local first)))
							(call projected_store_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
								(local first) (local target) (local local_binding) (local place) (local owning_slot)))
						(then (return (bool true))))
					(if
						(:doc "A load or range captures its receiver before evaluating later operands.")
						(bool.and (i32.not-eq (local child) (local first))
							(bool.and (bool.or (u32.eq (local operation_kind) (local try_slice_kind))
									(bool.or (u32.eq (local operation_kind) 37u32) (u32.eq (local operation_kind) 44u32)))
								(call descriptor_receiver_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
									(local first) (local target) (local local_binding) (local place) (local exclusive))))
						(then (return (bool true))))
					(if
						(:doc "An initialized record field keeps its shared loan through later constructor operands.")
						(bool.and (bool.and (local exclusive) (u32.eq (local operation_kind) 50u32))
							(call scoped_record_source (borrow-shared (local nodes)) (borrow-shared (local expressions))
								(local first) (local child) (local target) (local local_binding)))
						(then (return (bool true))))
					(if
						(:doc "A call, direct store, or bulk copy keeps its earlier loans through later operands.")
						(bool.or (call is_direct_call (local operation_kind))
							(bool.or (u32.eq (local operation_kind) 40u32)
								(u32.eq (local operation_kind) (local array_try_copy_kind))))
						(then
							(let-mut earlier (local first))
							(while
								(:doc "Earlier operands are already checked in source evaluation order.")
								(i32.not-eq (local earlier) (local child))
								(body
									(let loan (array.load (local expressions) (local earlier)))
									(if
										(:doc "Native storage loans retain their original local or projected place.")
										(call native_loan_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
											(local loan) (local target) (local local_binding) (local place) (local exclusive))
										(then (return (bool true))))
									(if
										(:doc "Compare defining bindings in the same namespace before comparing paths.")
										(bool.and (call same_binding (local target) (local local_binding)
											(struct.get (local loan) target) (struct.get (local loan) borrowed_owner))
											(bool.and (call loan_conflicts (local loan) (local exclusive))
												(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
													(local place) (struct.get (local loan) projection))))
										(then (return (bool true))))
