(module scalar_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check scoped and call loans by binding identity and statically checked field path.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./records.wove" (only place_borrow_kind is_mutable_place_reference is_writable_slice))
	(use wove-file "./flow.wove" (only (type ScalarStatement) (value fixed_shared_loan) (value fixed_mut_loan)))
	(use wove-file "./syntax.wove" (only is_direct_call))
	(use wove-file "./owners.wove" (only native_handle_borrow_kind is_native_owner_write_loan owned_field_loan_kind))

	(struct
		(:doc `A checked expression at its source row.

		Literals carry significant digit offsets in the arena. Conversions
		and checked runtime operations carry the original file identity
		in target and the half-open byte span in start and end. First
		points at the initial operand to evaluate. A reborrow's target
		is its defining parameter row or its source local's name row.
		A range reborrow links to the evaluated slice in its child.
		The borrowed_owner flag uses the local namespace for a loan's target,
		including when the source is a named view.
		A place read links to its root binding expression in projection.
		A projected loan links to the borrowed field expression there.
		An array growth operation links to its checked owner place there.
		The indirect-local marker distinguishes a for item's backing pointer
		from an ordinary local. Other negative projections have no field path. An integer literal
		uses target for its radix marker or its decoded character byte.
		An embed carries its path token span until asset resolution replaces it
		with the byte range to emit. A module binding reference (62) names its
		defining name node. The same row at a declaration marks its storage used.
		A checked local or scalar reference read records whether its place permits writes. An
		exact call loan with unknown length carries extent_check and the
		call argument's original runtime span. Worker operations record the caller file in
		asset_start and their operation span in start and end. Worker owner
		initializers and reads carry the exact owned result type in asset_end.`)
		ScalarExpression
		(fields (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool) (borrowed_owner bool)
			(mutable_place bool) (projection i32) (asset_start i32) (asset_end i32) (extent_check i32)))

	(let indirect_local_place -2i32)
	(let local_slice_view 146u32)
	(let local_slice_projection 147u32)
	(let scoped_field_loan 252u32)
	(let indexed_record_loan 253u32)

	(fn expression_row
		(:doc `Build a checked expression row, or an unvisited row with an expected scalar type.`)
		(params (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool))
		(returns ScalarExpression)
		(body
			(return (struct.new ScalarExpression (kind (local kind)) (type (local type)) (target (local target))
				(first (local first)) (start (local start)) (end (local end)) (negative (local negative))
				(borrowed_owner (bool false)) (mutable_place (bool false)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn mutable_parameter_place
		(:doc `Represent the scalar pointee while retaining its parameter's identity and write permission.`)
		(params (type u32) (parameter i32))
		(returns ScalarExpression)
		(body
			(return (struct.new ScalarExpression (kind 2u32) (type (local type)) (target (local parameter))
				(first -1i32) (start 0i32) (end 0i32) (negative (bool false)) (borrowed_owner (bool false))
				(mutable_place (bool true)) (projection -1i32) (asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))))

	(fn is_local_slice_view
		(:doc `Recognize a descriptor read or reborrow from a named view local.`)
		(params (kind u32))
		(returns bool)
		(body (return (bool.or (u32.eq (local kind) (local local_slice_view))
			(u32.eq (local kind) (local local_slice_projection))))))

	(fn field_place_root
		(:doc `Follow checked field projections toward the original binding or value expression.`)
		(params (expressions (shared-array ScalarExpression)) (place i32))
		(returns i32)
		(body
			(let-mut root (local place))
			(while
				(:doc "Each checked field points at its immediate receiver.")
				(u32.eq (struct.get (array.load (local expressions) (local root)) kind) 52u32)
				(body (set (local root) (struct.get (array.load (local expressions) (local root)) first))))
			(return (local root))))

	(fn paths_overlap
		(:doc `Compare paths from the same binding. A path overlaps itself and all enclosing places.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(left i32) (right i32))
		(returns bool)
		(body
			(if
				(:doc "A whole binding covers every field below it.")
				(bool.or (i32.ltz (local left)) (i32.ltz (local right)))
				(then (return (bool true))))
			(let-mut a (struct.get (array.load (local expressions) (local left)) projection))
			(let-mut b (struct.get (array.load (local expressions) (local right)) projection))
			(while
				(:doc "Walk out from each root through the matched field ordinals.")
				(bool.not (bool.or (i32.eq (local a) (local left)) (i32.eq (local b) (local right))))
				(body
					(set (local a) (struct.get (array.load (local nodes) (local a)) parent))
					(set (local b) (struct.get (array.load (local nodes) (local b)) parent))
					(if
						(:doc "Different fields of the same enclosing record have independent storage.")
						(i32.not-eq (struct.get (array.load (local expressions) (local a)) target)
							(struct.get (array.load (local expressions) (local b)) target))
						(then (return (bool false))))))
			(return (bool true))))

	(fn same_binding
		(:doc `Compare binding rows within their local or parameter namespace.`)
		(params (target i32) (local_binding bool) (other i32) (other_local bool))
		(returns bool)
		(body
			(return (bool.and (i32.eq (local target) (local other))
				(bool.or (bool.and (local local_binding) (local other_local))
					(bool.not (bool.or (local local_binding) (local other_local))))))))

	(fn projected_store_conflicts
		(:doc `A projected indexed store holds its field through the index and value expressions.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(receiver i32) (target i32) (local_binding bool) (place i32))
		(returns bool)
		(body
			(let root (struct.get (array.load (local expressions) (local receiver)) projection))
			(if
				(:doc "A whole fixed local uses the existing direct fixed-array store rules.")
				(i32.ltz (local root))
				(then (return (bool false))))
			(let binding (array.load (local expressions) (local root)))
			(return (bool.and
				(call same_binding (local target) (local local_binding) (struct.get (local binding) target)
					(u32.eq (struct.get (local binding) kind) 6u32))
				(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
					(local place) (local receiver))))))

	(fn descriptor_receiver_conflicts
		(:doc `A captured array descriptor keeps its backing storage lent until access completes.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(receiver i32) (target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(let view (array.load (local expressions) (local receiver)))
			(let-mut origin (struct.get (local view) target))
			(let-mut origin_local (struct.get (local view) borrowed_owner))
			(let-mut projection (struct.get (local view) projection))
			(if
				(:doc "A descriptor field's target is its ordinal. Use its record binding and full field path.")
				(u32.eq (struct.get (local view) kind) 52u32)
				(then
					(if (i32.ltz (local projection)) (then (return (bool false))))
					(let binding (array.load (local expressions) (local projection)))
					(set (local origin) (struct.get (local binding) target))
					(set (local origin_local) (u32.eq (struct.get (local binding) kind) 6u32))
					(set (local projection) (local receiver))))
			(return (bool.and
				(bool.and (u32.not-eq (struct.get (local view) kind) 62u32)
					(call same_binding (local target) (local local_binding) (local origin) (local origin_local)))
				(bool.and (bool.or (local exclusive) (call is_writable_slice (struct.get (local view) type)))
					(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
						(local place) (local projection)))))))

	(fn loan_conflicts
		(:doc `Check whether an earlier loan and the requested access can coexist at an overlapping place.`)
		(params (loan ScalarExpression) (exclusive bool))
		(returns bool)
		(body
			(let kind (struct.get (local loan) kind))
			(if
				(:doc "Place loans retain their access mode in the checked reference type.")
				(bool.or (u32.eq (local kind) (call place_borrow_kind)) (u32.eq (local kind) (local indexed_record_loan)))
				(then (return (bool.or (local exclusive) (call is_mutable_place_reference (struct.get (local loan) type))))))
			(if
				(:doc "Ranges and local reborrows retain the requested access mode.")
				(bool.or (u32.eq (local kind) (call owned_field_loan_kind))
					(bool.or (bool.or (u32.eq (local kind) 45u32) (u32.eq (local kind) (local scoped_field_loan)))
						(call is_local_slice_view (local kind))))
				(then (return (bool.or (local exclusive) (call is_writable_slice (struct.get (local loan) type))))))
			(return (bool.or
				(bool.or (u32.eq (local kind) 39u32) (u32.eq (local kind) (local fixed_mut_loan)))
				(bool.and (local exclusive)
					(bool.or (u32.eq (local kind) (local fixed_shared_loan))
						(u32.eq (local kind) 35u32)))))))

	(fn native_loan_conflicts
		(:doc `Check when another native loan or transfer can use the same local resource.`)
		(params (expressions (shared-array ScalarExpression)) (loan ScalarExpression) (target i32) (exclusive bool))
		(returns bool)
		(body
			(let kind (struct.get (local loan) kind))
			(let writable (call is_native_owner_write_loan (local kind)))
			(if
				(:doc "Shared native loans coexist. An exclusive native loan excludes overlapping access.")
				(bool.not (bool.or (local writable)
					(bool.and (local exclusive) (u32.eq (local kind) (call native_handle_borrow_kind)))))
				(then (return (bool false))))
			(let pointer (array.load (local expressions) (struct.get (local loan) first)))
			(return (bool.and (u32.eq (struct.get (local pointer) kind) 6u32)
				(i32.eq (struct.get (local pointer) target) (local target))))))

	(fn scoped_record_source
		(:doc "Check the original array or parent view of each initialized borrowed field.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(first i32) (stop i32) (target i32) (local_binding bool))
		(returns bool)
		(body
			(let-mut field (local first))
			(while
				(:doc "Only earlier or fully initialized fields hold a descriptor.")
				(bool.and (i32.lt -1i32 (local field)) (i32.not-eq (local field) (local stop)))
				(body
					(let member (array.load (local expressions) (local field)))
					(let view (array.load (local expressions) (struct.get (local member) first)))
					(if
						(:doc "A shared descriptor freezes its defining source; static data needs no loan.")
						(bool.and (u32.eq (struct.get (local view) type) 34u32)
							(bool.and (u32.not-eq (struct.get (local view) kind) 62u32)
								(call same_binding (local target) (local local_binding)
									(struct.get (local view) target) (struct.get (local view) borrowed_owner))))
						(then (return (bool true))))
					(set (local field) (struct.get (array.load (local nodes) (local field)) next_sibling))))
			(return (bool false))))

	(fn has_scoped_array_loan
		(:doc `Check active lexical loans of a local array, parameter, or parent view.

		A shared loan permits reads of its source. A mutable loan excludes
		every access through the source for the lifetime of the binding.`)
		(params (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement)) (expressions (shared-array ScalarExpression))
			(statement i32) (target i32) (local_binding bool) (exclusive bool))
		(returns bool)
		(body
			(let-mut index (struct.get (array.load (local statements) (local statement)) previous_loan))
			(while
				(:doc "Only declarations on the current lexical chain can impose a loan.")
				(i32.lt -1i32 (local index))
				(body
					(let declaration (array.load (local statements) (local index)))
					(let origin (array.load (local expressions) (struct.get (local declaration) value)))
					(if
						(:doc "A scoped record holds the shared loans of its constructor fields.")
						(u32.eq (struct.get (local origin) kind) 50u32)
						(then
							(if
								(:doc "Shared field loans allow reads but prevent exclusive access to their sources.")
								(bool.and (local exclusive)
									(call scoped_record_source (borrow-shared (local nodes)) (borrow-shared (local expressions))
										(struct.get (local origin) first) -1i32 (local target) (local local_binding)))
								(then (return (bool true)))))
						(else
							(if
								(:doc "A named view keeps its immediate parent subject to the access check.")
								(bool.and (call same_binding (local target) (local local_binding)
									(struct.get (local origin) target) (struct.get (local origin) borrowed_owner))
									(bool.or (local exclusive) (call is_writable_slice (struct.get (local declaration) type))))
								(then (return (bool true))))))
					(set (local index) (struct.get (local declaration) previous_loan))))
			(return (bool false))))

	(fn has_conflicting_loan
		(:doc `Find a conflicting loan in earlier operands of an enclosing operation.

		Call arguments hold their loans until the call returns. A load or
		range holds its captured descriptor through the index or endpoints.
		An owner or projected store holds its receiver through the index
		and value. Loans made by nested calls in completed operands have ended.`)
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression))
			(statements (shared-array ScalarStatement)) (index i32) (statement i32)
			(target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(if
				(:doc "A named view holds its loan independently of other operands.")
				(call has_scoped_array_loan (borrow-shared (local nodes)) (borrow-shared (local statements)) (borrow-shared (local expressions))
					(local statement) (local target) (local local_binding) (local exclusive))
				(then (return (bool true))))
			(let-mut child (local index))
			(while
				(:doc "Walk from the current operand up to its statement.")
				(i32.not-eq (local child) (local statement))
				(body
					(let parent (struct.get (array.load (local nodes) (local child)) parent))
					(let operation (array.load (local expressions) (local parent)))
					(let operation_kind (struct.get (local operation) kind))
					(let first (struct.get (local operation) first))
					(if
						(:doc "An indexed field store excludes overlapping access while its later operands run.")
						(bool.and (bool.and (u32.eq (local operation_kind) 74u32)
							(i32.not-eq (local child) (local first)))
							(call projected_store_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
								(local first) (local target) (local local_binding) (local place)))
						(then (return (bool true))))
					(if
						(:doc "A load or range captures its receiver before evaluating later operands.")
						(bool.and (i32.not-eq (local child) (local first))
							(bool.and (bool.or (u32.eq (local operation_kind) 37u32) (u32.eq (local operation_kind) 44u32))
								(call descriptor_receiver_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
									(local first) (local target) (local local_binding) (local place) (local exclusive))))
						(then (return (bool true))))
					(if
						(:doc "An initialized record field keeps its shared loan through later constructor operands.")
						(bool.and (bool.and (local exclusive) (u32.eq (local operation_kind) 50u32))
							(call scoped_record_source (borrow-shared (local nodes)) (borrow-shared (local expressions))
								(local first) (local child) (local target) (local local_binding)))
						(then (return (bool true))))
					(if
						(:doc "A call argument or direct store receiver can still hold a loan of its source.")
						(bool.or (call is_direct_call (local operation_kind)) (u32.eq (local operation_kind) 40u32))
						(then
							(let-mut earlier (local first))
							(while
								(:doc "Earlier operands are already checked in source evaluation order.")
								(i32.not-eq (local earlier) (local child))
								(body
									(let loan (array.load (local expressions) (local earlier)))
									(if
										(:doc "Native storage loans are tied to their original local owner.")
										(bool.and (local local_binding)
											(call native_loan_conflicts (borrow-shared (local expressions)) (local loan) (local target) (local exclusive)))
										(then (return (bool true))))
									(if
										(:doc "Compare defining bindings in the same namespace before comparing paths.")
										(bool.and (call same_binding (local target) (local local_binding)
											(struct.get (local loan) target) (struct.get (local loan) borrowed_owner))
											(bool.and (call loan_conflicts (local loan) (local exclusive))
												(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
													(local place) (struct.get (local loan) projection))))
										(then (return (bool true))))
									(set (local earlier) (struct.get (array.load (local nodes) (local earlier)) next_sibling))))))
					(set (local child) (local parent))))
			(return (bool false)))))
