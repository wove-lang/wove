						(:doc "A returned native record holds the exact argument's handle loan until its binding leaves scope.")
						(bool.and (local native)
							(call native_loan_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
								(local origin) (local target) (local local_binding) (local place) (local exclusive)))
						(then (return (bool true))))
