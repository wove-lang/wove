(module scalar_loans
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check call loans by binding identity and statically checked field path.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./records.wove" (only place_borrow_kind is_mutable_place_reference))
	(use wove-file "./flow.wove" (only (value fixed_shared_loan) (value fixed_mut_loan)))
	(use wove-file "./owners.wove" (only native_handle_borrow_kind is_native_storage_write_loan))

	(struct
		(:doc `A checked expression at its source row.

		Literals carry significant digit offsets in the arena. Conversions
		and checked runtime operations carry the original file identity
		in target and the half-open byte span in start and end. First
		points at the initial operand to evaluate. A reborrow's target
		is its defining parameter row or its source local's name row.
		A range reborrow links to the evaluated slice in its child.
		A place read links to its root binding expression in projection.
		A projected loan links to the borrowed field expression there.
		A negative projection means no projected storage.
		An embed carries its path token span until asset resolution replaces it
		with the byte range to emit. A module binding reference (62) names its
		defining name node. The same row at a declaration marks its storage used.
		A checked local records whether its binding permits writes.`)
		ScalarExpression
		(fields (kind u32) (type u32) (target i32) (first i32) (start i32) (end i32) (negative bool) (borrowed_owner bool)
			(mutable_place bool) (projection i32) (asset_start i32) (asset_end i32)))

	(fn field_place_root
		(:doc `Follow checked field projections toward the original binding or value expression.`)
		(params (expressions (shared-slice ScalarExpression)) (place i32))
		(returns i32)
		(body
			(let-mut root (local place))
			(while
				(:doc "Each checked field points at its immediate receiver.")
				(u32.eq (struct.get (slice.load (local expressions) (local root)) kind) 52u32)
				(body (set (local root) (struct.get (slice.load (local expressions) (local root)) first))))
			(return (local root))))

	(fn paths_overlap
		(:doc `Compare paths from the same binding. A path overlaps itself and all enclosing places.`)
		(params (nodes (shared-slice SourceNode)) (expressions (shared-slice ScalarExpression))
			(left i32) (right i32))
		(returns bool)
		(body
			(if
				(:doc "A whole binding covers every field below it.")
				(bool.or (i32.lt (local left) 0i32) (i32.lt (local right) 0i32))
				(then (return (bool true))))
			(let-mut a (struct.get (slice.load (local expressions) (local left)) projection))
			(let-mut b (struct.get (slice.load (local expressions) (local right)) projection))
			(while
				(:doc "Walk out from each root through the matched field ordinals.")
				(bool.not (bool.or (i32.eq (local a) (local left)) (i32.eq (local b) (local right))))
				(body
					(set (local a) (struct.get (slice.load (local nodes) (local a)) parent))
					(set (local b) (struct.get (slice.load (local nodes) (local b)) parent))
					(if
						(:doc "Different fields of the same enclosing record have independent storage.")
						(bool.not (i32.eq (struct.get (slice.load (local expressions) (local a)) target)
							(struct.get (slice.load (local expressions) (local b)) target)))
						(then (return (bool false))))))
			(return (bool true))))

	(fn same_binding
		(:doc `Compare binding rows within their local or parameter namespace.`)
		(params (target i32) (local_binding bool) (other i32) (other_local bool))
		(returns bool)
		(body
			(return (bool.and (i32.eq (local target) (local other))
				(bool.or (bool.and (local local_binding) (local other_local))
					(bool.not (bool.or (local local_binding) (local other_local))))))))

	(fn projected_store_conflicts
		(:doc `A projected indexed store holds its field through the index and value expressions.`)
		(params (nodes (shared-slice SourceNode)) (expressions (shared-slice ScalarExpression))
			(receiver i32) (target i32) (local_binding bool) (place i32))
		(returns bool)
		(body
			(let root (struct.get (slice.load (local expressions) (local receiver)) projection))
			(if
				(:doc "A whole fixed local uses the existing direct fixed-array store rules.")
				(i32.lt (local root) 0i32)
				(then (return (bool false))))
			(let binding (slice.load (local expressions) (local root)))
			(return (bool.and
				(call same_binding (local target) (local local_binding) (struct.get (local binding) target)
					(u32.eq (struct.get (local binding) kind) 6u32))
				(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
					(local place) (local receiver))))))

	(fn loan_conflicts
		(:doc `Check whether an earlier loan and the requested access can coexist at an overlapping place.`)
		(params (loan ScalarExpression) (exclusive bool))
		(returns bool)
		(body
			(let kind (struct.get (local loan) kind))
			(if
				(:doc "Place loans retain their access mode in the checked reference type.")
				(u32.eq (local kind) (call place_borrow_kind))
				(then (return (bool.or (local exclusive) (call is_mutable_place_reference (struct.get (local loan) type))))))
			(return (bool.or
				(bool.or (u32.eq (local kind) 39u32) (u32.eq (local kind) (local fixed_mut_loan)))
				(bool.and (local exclusive)
					(bool.or (u32.eq (local kind) (local fixed_shared_loan))
						(bool.or (u32.eq (local kind) 35u32) (u32.eq (local kind) 45u32))))))))

	(fn native_loan_conflicts
		(:doc `Check when another native loan or transfer can use the same local resource.`)
		(params (expressions (shared-slice ScalarExpression)) (loan ScalarExpression) (target i32) (exclusive bool))
		(returns bool)
		(body
			(let kind (struct.get (local loan) kind))
			(let writable (call is_native_storage_write_loan (local kind)))
			(if
				(:doc "Shared native loans coexist. A mutable storage loan excludes every overlapping access.")
				(bool.not (bool.or (local writable)
					(bool.and (local exclusive) (u32.eq (local kind) (call native_handle_borrow_kind)))))
				(then (return (bool false))))
			(let pointer (slice.load (local expressions) (struct.get (local loan) first)))
			(return (bool.and (u32.eq (struct.get (local pointer) kind) 6u32)
				(i32.eq (struct.get (local pointer) target) (local target))))))

	(fn has_conflicting_loan
		(:doc `Find a conflicting loan in earlier operands of an enclosing operation.

		Call arguments hold their loans until the call returns. An owner
		or projected array store holds its receiver through the index and value.
		Loans made by nested calls in completed operands have already ended.`)
		(params (nodes (shared-slice SourceNode)) (expressions (shared-slice ScalarExpression))
			(index i32) (statement i32) (target i32) (local_binding bool) (place i32) (exclusive bool))
		(returns bool)
		(body
			(let-mut child (local index))
			(while
				(:doc "Walk from the current operand up to its statement.")
				(bool.not (i32.eq (local child) (local statement)))
				(body
					(let parent (struct.get (slice.load (local nodes) (local child)) parent))
					(let operation (slice.load (local expressions) (local parent)))
					(let operation_kind (struct.get (local operation) kind))
					(let first (struct.get (local operation) first))
					(if
						(:doc "An indexed field store excludes overlapping access while its later operands run.")
						(bool.and (bool.and (u32.eq (local operation_kind) 74u32)
							(bool.not (i32.eq (local child) (local first))))
							(call projected_store_conflicts (borrow-shared (local nodes)) (borrow-shared (local expressions))
								(local first) (local target) (local local_binding) (local place)))
						(then (return (bool true))))
					(if
						(:doc "A call argument or direct store receiver can still hold a loan of its source.")
						(bool.or (u32.eq (local operation_kind) 3u32) (u32.eq (local operation_kind) 40u32))
						(then
							(let-mut earlier (local first))
							(while
								(:doc "Earlier operands are already checked in source evaluation order.")
								(bool.not (i32.eq (local earlier) (local child)))
								(body
									(let loan (slice.load (local expressions) (local earlier)))
									(if
										(:doc "Native storage loans are tied to their original local owner.")
										(bool.and (local local_binding)
											(call native_loan_conflicts (borrow-shared (local expressions)) (local loan) (local target) (local exclusive)))
										(then (return (bool true))))
									(if
										(:doc "Compare defining bindings in the same namespace before comparing paths.")
										(bool.and (call same_binding (local target) (local local_binding)
											(struct.get (local loan) target) (struct.get (local loan) borrowed_owner))
											(bool.and (call loan_conflicts (local loan) (local exclusive))
												(call paths_overlap (borrow-shared (local nodes)) (borrow-shared (local expressions))
													(local place) (struct.get (local loan) projection))))
										(then (return (bool true))))
									(set (local earlier) (struct.get (slice.load (local nodes) (local earlier)) next_sibling))))))
					(set (local child) (local parent))))
			(return (bool false)))))
