(module scalar_value_types
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Match checked values at expression boundaries while preserving nominal and structural types.")

	(use wove-file "../source/types.wove" (only is_builtin_float is_builtin_numeric is_builtin_integer_value))
	(use wove-file "../source/numeric_ops.wove" (only (value exact_byte_view)))
	(use wove-file "./flow.wove" (only (value c_handle_reference)))
	(use wove-file "./owners.wove" (only is_local_owner))
	(use wove-file "./native_owner_types.wove" (only is_native_owner))
	(use wove-file "./records.wove" (only is_callable_type is_record_type record_receiver_type is_array_owner
		is_writable_slice is_readable_slice is_native_integer is_typed_slice typed_slice_element_code))
	(use wove-file "./syntax.wove" (only is_byte_view_type))

	(let static_number 3u32)

	(fn value_matches_type
		(:doc `Match a checked value to its exact expected type.

		Expectation 1 infers an integer. A static number can also infer a float.
		A local initializer (42) can
		also copy a record, allocate, or move an owner. A field receiver
		(53) resolves a record or reference for projection. Its eventual
		access checks the loan against the completed path. A length or load receiver (55)
		can use any readable array. A store receiver (56) needs writable
		storage. The array planner validates the element type and inline layout.
		An owner operand (57) transfers ownership. A C handle operand (58) can supply a call loan.
		An exact byte view (63) is a shared descriptor. These expectations sit below the named record type range. Zero marks unvisited rows.`)
		(params (expected u32) (actual u32))
		(returns bool)
		(body
			(if
				(:doc "A record receiver can read the original value through a declared reference.")
				(u32.eq (local expected) 53u32)
				(then (return (call is_record_type (call record_receiver_type (local actual))))))
			(if
				(:doc "A local initializer can infer any supported copyable value or native owner.")
				(bool.and (u32.eq (local expected) 42u32)
					(bool.or (bool.or (u32.eq (local actual) 12u32) (call is_builtin_float (local actual)))
						(bool.or (call is_callable_type (local actual))
							(bool.or (call is_record_type (local actual)) (call is_native_owner (local actual))))))
				(then (return (bool true))))
			(if
				(:doc "A direct module literal can infer any supported numeric width.")
				(u32.eq (local expected) (local static_number))
				(then (return (call is_builtin_numeric (local actual)))))
			(if
				(:doc "An integer initializer or conversion operand can infer its width.")
				(bool.or (u32.eq (local expected) 1u32) (u32.eq (local expected) 42u32))
				(then (return (bool.or (call is_builtin_integer_value (local actual)) (call is_native_integer (local actual))))))
			(if
				(:doc "A mutable byte view can also be read through a shared projection.")
				(u32.eq (local expected) 34u32)
				(then (return (call is_byte_view_type (local actual)))))
			(if
				(:doc "A read accepts a view or an inline layout checked by the array planner.")
				(u32.eq (local expected) 55u32)
				(then (return (bool.or (call is_readable_slice (local actual))
					(bool.or (call is_record_type (local actual)) (call is_array_owner (local actual)))))))
			(if
				(:doc "A store needs an exclusive view or a checked inline array place.")
				(u32.eq (local expected) 56u32)
				(then (return (bool.or (call is_writable_slice (local actual)) (call is_record_type (local actual))))))
			(if
				(:doc "A mutable typed slice can satisfy a shared formal of the same element type.")
				(bool.and (bool.and (call is_typed_slice (local expected)) (call is_typed_slice (local actual)))
					(bool.and (bool.not (call is_writable_slice (local expected))) (call is_writable_slice (local actual))))
				(then (return (u32.eq (call typed_slice_element_code (local expected)) (call typed_slice_element_code (local actual))))))
			(if
				(:doc "A local move can resolve a record before the move checker verifies that it owns storage.")
				(u32.eq (local expected) 57u32)
				(then (return (bool.or (call is_local_owner (local actual)) (call is_record_type (local actual))))))
			(if
				(:doc "A native borrow checks its underlying owner identity.")
				(u32.eq (local expected) (local c_handle_reference))
				(then (return (call is_local_owner (local actual)))))
			(if
				(:doc "A direct decode operand must be shared. A mutable view can lend bytes explicitly.")
				(u32.eq (local expected) (local exact_byte_view))
				(then (return (u32.eq (local actual) 34u32))))
			(return (u32.eq (local expected) (local actual)))))
)
