(module scalar_integer_literals
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Share integer literal validation and normalized digit rows between values and match patterns.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/literals.wove" (only integer_scalar))
	(use wove-file "./syntax.wove" (only entry_at (type EntryRead)))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))

	(fn plan_integer_value
		(:doc `Record the negative radix as the format, reserving nonnegative targets for character bytes.`)
		(params (source (shared-array u8)) (node SourceNode) (start i32) (end i32) (type u32)
			(index i32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let spelling (call integer_scalar (borrow-shared source)
				start end type))
			(let digits (struct:get spelling digits))
			(if
				(:doc "An invalid spelling or magnitude points at the whole original atom.")
				(i32:ltz digits)
				(then (return (call entry_at node -1i32 25u32))))
			(let format (i32:sub 0i32 (struct:get spelling radix)))
			(array:store expressions index
				(call expression_row 1u32 type format -1i32
					digits end (struct:get spelling negative)))
			(return (call entry_at node index 0u32))))

)
