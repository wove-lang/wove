(module scalar_loops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check iteration headers and expose their names and access modes to the body.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "./flow.wove" (only block_statement (type ScalarStatement) (value for_binding) (value for_mut_binding) (value for_statement)))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword is_reborrow_keyword is_scalar_name same_name (type EntryRead) (value for_bind) (value for_range)))

	(fn read_for_names
		(:doc `Read the first of one or two immutable names and check the optional index binding.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (binding i32) (indexed bool))
		(returns EntryRead)
		(body
			(let node (array.load (local nodes) (local binding)))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local for_bind) 24u32))
			(if (u32.lt 0u32 (struct.get (local form) error)) (then (return (local form))))
			(let first (struct.get (local form) operand))
			(if (i32.lt (local first) 0i32) (then (return (call entry_at (local node) -1i32 24u32))))
			(let name (array.load (local nodes) (local first)))
			(if
				(:doc "A binder is an ordinary bare local name.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (call entry_at (local name) -1i32 34u32))))
			(let second (struct.get (local name) next_sibling))
			(if
				(:doc "Only array iteration permits the indexed pair.")
				(i32.lt -1i32 (local second))
				(then
					(let item (array.load (local nodes) (local second)))
					(if (bool.not (local indexed)) (then (return (call entry_at (local item) -1i32 24u32))))
					(if
						(:doc "The item is a bare name distinct from the index.")
						(bool.not (call is_scalar_name (borrow-shared (local source)) (local item)))
						(then (return (call entry_at (local item) -1i32 34u32))))
					(if
						(:doc "Report a repeated name at the second binding.")
						(call same_name (borrow-shared (local source)) (local name) (local item))
						(then (return (call entry_at (local item) -1i32 33u32))))
					(let extra (struct.get (local item) next_sibling))
					(if
						(:doc "A third name has no iteration role.")
						(i32.lt -1i32 (local extra))
						(then (return (call entry_at (array.load (local nodes) (local extra)) -1i32 24u32))))))
			(return (local form))))

	(fn read_for_bounds
		(:doc `Read exactly two bounds and return the first bound's source row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local for_range) 24u32))
			(if (u32.lt 0u32 (struct.get (local form) error)) (then (return (local form))))
			(let lower (struct.get (local form) operand))
			(if (i32.lt (local lower) 0i32) (then (return (call entry_at (local node) -1i32 24u32))))
			(let upper (struct.get (array.load (local nodes) (local lower)) next_sibling))
			(if (i32.lt (local upper) 0i32) (then (return (call entry_at (local node) -1i32 24u32))))
			(let extra (struct.get (array.load (local nodes) (local upper)) next_sibling))
			(if
				(:doc "A half-open range ends after the upper bound.")
				(i32.lt -1i32 (local extra))
				(then (return (call entry_at (array.load (local nodes) (local extra)) -1i32 24u32))))
			(return (local form))))

	(fn is_iteration_statement
		(:doc `Identify whether a borrow is being checked for a for header.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statement i32))
		(returns bool)
		(body
			(let node (array.load (local nodes) (local statement)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(return (u32.eq (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes))
				(struct.get (local parts) head)) (local for_statement)))))

	(fn read_iteration_source
		(:doc `Return the borrow expression or the lower bound of an integer range.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (iterator i32))
		(returns EntryRead)
		(body
			(let node (array.load (local nodes) (local iterator)))
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let tag (call entry_keyword (borrow-shared (local source)) (borrow-shared (local nodes)) (struct.get (local parts) head)))
			(if
				(:doc "Integer range evaluation starts at the lower bound's row.")
				(u32.eq (local tag) (local for_range))
				(then (return (call read_for_bounds (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))))
			(if
				(:doc "The whole array view is checked as a single borrow expression.")
				(call is_reborrow_keyword (local tag))
				(then (return (call entry_at (local node) (local iterator) 0u32))))
			(return (call entry_at (local node) -1i32 24u32))))

	(fn iteration_binding
		(:doc `Describe a copied value or writable element scoped to the loop body.`)
		(params (name i32) (type u32) (block i32) (writable bool))
		(returns ScalarStatement)
		(body
			(let-mut kind (local for_binding))
			(if (local writable) (then (set (local kind) (local for_mut_binding))))
			(return (struct.new ScalarStatement (kind (local kind)) (target (local name))
				(value -1i32) (type (local type)) (first (local block)) (previous_owner -1i32)
				(falls_through (bool true)) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn register_iteration_bindings
		(:doc `Publish the index or item names and the body that controls their visibility.`)
		(params (nodes (shared-array SourceNode)) (first i32) (element u32) (block i32) (writable bool)
			(statements (mut-array ScalarStatement)))
		(returns void)
		(body
			(let second (struct.get (array.load (local nodes) (local first)) next_sibling))
			(let-mut first_type (local element))
			(let-mut first_writable (local writable))
			(if
				(:doc "The first name of an indexed pair receives an i32 position relative to the view.")
				(i32.lt -1i32 (local second))
				(then
					(set (local first_type) 5u32)
					(set (local first_writable) (bool false))
					(array.store (local statements) (local second) (call iteration_binding (local second) (local element) (local block) (local writable)))))
			(array.store (local statements) (local first) (call iteration_binding (local first) (local first_type) (local block) (local first_writable)))
			(let arm (array.load (local statements) (local block)))
			(array.store (local statements) (local block) (call block_statement (struct.get (local arm) first) (local first) -1i32 (bool true)))))

	(fn find_iteration_binding
		(:doc `Find a header name by comparing the one or two original identifier rows.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode))
		(returns i32)
		(body
			(let-mut index (local first))
			(while
				(:doc "The checked binder contains only names in this body's scope.")
				(i32.lt -1i32 (local index))
				(body
					(let candidate (array.load (local nodes) (local index)))
					(if (call same_name (borrow-shared (local source)) (local candidate) (local name)) (then (return (local index))))
					(set (local index) (struct.get (local candidate) next_sibling))))
			(return -1i32))))
