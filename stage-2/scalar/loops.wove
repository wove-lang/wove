(module scalar_loops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check iteration headers and expose their immutable names to the loop body.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "./flow.wove" (only (type ScalarStatement) (value for_binding)))
	(use wove-file "./syntax.wove" (only entry_at entry_form is_scalar_name same_name (type EntryRead) (value for_bind) (value for_range)))

	(fn read_for_names
		(:doc `Read the first of one or two immutable names and check the optional index binding.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (binding i32) (indexed bool))
		(returns EntryRead)
		(body
			(let node (array.load (local nodes) (local binding)))
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local for_bind) 24u32))
			(if (u32.lt 0u32 (struct.get (local form) error)) (then (return (local form))))
			(let first (struct.get (local form) operand))
			(if (i32.lt (local first) 0i32) (then (return (call entry_at (local node) -1i32 24u32))))
			(let name (array.load (local nodes) (local first)))
			(if
				(:doc "A binder is an ordinary bare local name.")
				(bool.not (call is_scalar_name (borrow-shared (local source)) (local name)))
				(then (return (call entry_at (local name) -1i32 34u32))))
			(let second (struct.get (local name) next_sibling))
			(if
				(:doc "Only array iteration permits the indexed pair.")
				(i32.lt -1i32 (local second))
				(then
					(let item (array.load (local nodes) (local second)))
					(if (bool.not (local indexed)) (then (return (call entry_at (local item) -1i32 24u32))))
					(if
						(:doc "The item is a bare name distinct from the index.")
						(bool.not (call is_scalar_name (borrow-shared (local source)) (local item)))
						(then (return (call entry_at (local item) -1i32 34u32))))
					(if
						(:doc "Report a repeated name at the second binding.")
						(call same_name (borrow-shared (local source)) (local name) (local item))
						(then (return (call entry_at (local item) -1i32 33u32))))
					(let extra (struct.get (local item) next_sibling))
					(if
						(:doc "A third name has no iteration role.")
						(i32.lt -1i32 (local extra))
						(then (return (call entry_at (array.load (local nodes) (local extra)) -1i32 24u32))))))
			(return (local form))))

	(fn read_for_bounds
		(:doc `Read exactly two bounds and return the first bound's source row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local node) (local for_range) 24u32))
			(if (u32.lt 0u32 (struct.get (local form) error)) (then (return (local form))))
			(let lower (struct.get (local form) operand))
			(if (i32.lt (local lower) 0i32) (then (return (call entry_at (local node) -1i32 24u32))))
			(let upper (struct.get (array.load (local nodes) (local lower)) next_sibling))
			(if (i32.lt (local upper) 0i32) (then (return (call entry_at (local node) -1i32 24u32))))
			(let extra (struct.get (array.load (local nodes) (local upper)) next_sibling))
			(if
				(:doc "A half-open range ends after the upper bound.")
				(i32.lt -1i32 (local extra))
				(then (return (call entry_at (array.load (local nodes) (local extra)) -1i32 24u32))))
			(return (local form))))

	(fn iteration_binding
		(:doc `Describe an immutable local whose scope starts at the loop body's entry.`)
		(params (name i32) (type u32) (block i32))
		(returns ScalarStatement)
		(body (return (struct.new ScalarStatement (kind (local for_binding)) (target (local name))
			(value -1i32) (type (local type)) (first (local block)) (previous_owner -1i32)
			(falls_through (bool true)) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn find_iteration_binding
		(:doc `Find a header name by comparing the one or two original identifier rows.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode))
		(returns i32)
		(body
			(let-mut index (local first))
			(while
				(:doc "The checked binder contains only names in this body's scope.")
				(i32.lt -1i32 (local index))
				(body
					(let candidate (array.load (local nodes) (local index)))
					(if (call same_name (borrow-shared (local source)) (local candidate) (local name)) (then (return (local index))))
					(set (local index) (struct.get (local candidate) next_sibling))))
			(return -1i32))))
