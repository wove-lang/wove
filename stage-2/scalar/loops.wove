(module scalar_loops
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check iteration headers and expose their names and access modes to the body.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "./flow.wove" (only block_statement statement_exit_state (type ScalarStatement) (value for_binding) (value for_mut_binding) (value for_statement)))
	(use wove-file "./records.wove" (only is_array_owner))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword is_reborrow_keyword is_scalar_name same_name (type EntryRead) (value let_binding) (value for_range)))

	(fn read_for_names
		(:doc `Read the item name and its optional immutable index.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (binding i32) (indexed bool))
		(returns EntryRead)
		(body
			(let node (nodes.get binding))
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node let_binding 24u32))
			(if (u32:gtz (form.get error)) (then (return form)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let first (parts.get name))
			(if (i32:ltz first) (then (return (call entry_at node -1i32 24u32))))
			(let name (nodes.get first))
			(if
				(:doc "A binder is an ordinary bare local name.")
				(bool:not (call is_scalar_name (borrow-shared source) name))
				(then (return (call entry_at name -1i32 34u32))))
			(let second (parts.get second_name))
			(if
				(:doc "Only array iteration permits the indexed pair.")
				(i32:lt -1i32 second)
				(then
					(let item (nodes.get second))
					(if (bool:not indexed) (then (return (call entry_at item -1i32 24u32))))
					(if
						(:doc "The item is a bare name distinct from the index.")
						(bool:not (call is_scalar_name (borrow-shared source) item))
						(then (return (call entry_at item -1i32 34u32))))
					(if
						(:doc "Report a repeated name at the second binding.")
						(call same_name (borrow-shared source) name item)
						(then (return (call entry_at item -1i32 33u32))))
					(let extra (parts.get operands))
					(if
						(:doc "A third name has no iteration role.")
						(i32:lt -1i32 extra)
						(then (return (call entry_at (nodes.get extra) -1i32 24u32))))))
			(return (struct:new EntryRead (operand first) (related second)
				(start (form.get start)) (end (form.get end)) (error 0u32)))))

	(fn read_for_bounds
		(:doc `Read exactly two bounds and return the first bound's source row.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node for_range 24u32))
			(if (u32:gtz (form.get error)) (then (return form)))
			(let lower (form.get operand))
			(if (i32:ltz lower) (then (return (call entry_at node -1i32 24u32))))
			(let upper (struct:get (nodes.get lower) next_sibling))
			(if (i32:ltz upper) (then (return (call entry_at node -1i32 24u32))))
			(let extra (struct:get (nodes.get upper) next_sibling))
			(if
				(:doc "A half-open range ends after the upper bound.")
				(i32:lt -1i32 extra)
				(then (return (call entry_at (nodes.get extra) -1i32 24u32))))
			(return form)))

	(fn is_iteration_statement
		(:doc `Identify whether a borrow is being checked for a for header.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (statement i32))
		(returns bool)
		(body
			(let node (nodes.get statement))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(return (u32:eq (call entry_keyword (borrow-shared source) (borrow-shared nodes)
				(parts.get head)) for_statement))))

	(fn read_iteration_source
		(:doc `Return the array operand or the lower bound of an integer range.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (iterator i32))
		(returns EntryRead)
		(body
			(let node (nodes.get iterator))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) node))
			(let tag (call entry_keyword (borrow-shared source) (borrow-shared nodes) (parts.get head)))
			(if
				(:doc "Integer range evaluation starts at the lower bound's row.")
				(u32:eq tag for_range)
				(then (return (call read_for_bounds (borrow-shared source) (borrow-shared nodes) node))))
			(if
				(:doc "A borrow or explicit move evaluates its array source once.")
				(bool:or (call is_reborrow_keyword tag) (u32:eq tag 43u32))
				(then (return (call entry_at node iterator 0u32))))
			(return (call entry_at node -1i32 24u32))))

	(fn iteration_binding
		(:doc `Describe a copied value or writable element scoped to the loop body.`)
		(params (name i32) (type u32) (block i32) (writable bool))
		(returns ScalarStatement)
		(body
			(let-mut kind for_binding)
			(if writable (then (set kind for_mut_binding)))
			(return (struct:new ScalarStatement (kind kind) (target name)
				(value -1i32) (type type) (first block) (previous_owner -1i32)
				(falls_through (bool true)) (move_site -1i32) (paths 0u32) (previous_loan -1i32)))))

	(fn register_iteration_bindings
		(:doc `Publish the index or item names and the body that controls their visibility.`)
		(params (first i32) (second i32) (element u32) (block i32) (writable bool)
			(statements (mut-array ScalarStatement)))
		(returns void)
		(body
			(let-mut first_type element)
			(let-mut first_writable writable)
			(if
				(:doc "The first name of an indexed pair receives an i32 position relative to the view.")
				(i32:lt -1i32 second)
				(then
					(set first_type 5u32)
					(set first_writable (bool false))
					(statements.set second (call iteration_binding second element block writable))))
			(statements.set first (call iteration_binding first first_type block first_writable))
			(let arm (statements.get block))
			(statements.set block (call block_statement (arm.get first) first -1i32 (bool true)))))

	(fn iterator_owner_boundary
		(:doc `Find the owner preserved at the end of one iteration.

		The move head identifies the C capture for a consuming loop.
		Other statements use the enclosing chain unchanged.`)
		(params (nodes (shared-array SourceNode)) (loop ScalarStatement))
		(returns i32)
		(body
			(if
				(:doc "Only a consuming for has a hidden owner beneath its iteration locals.")
				(bool:and (u32:eq (loop.get kind) for_statement)
					(call is_array_owner (loop.get type)))
				(then (return (struct:get (nodes.get (loop.get value)) first_child))))
			(return (loop.get previous_owner))))

	(fn enter_consuming_iteration
		(:doc `Link the current owned item above the captured array before checking the body.`)
		(params (nodes (shared-array SourceNode)) (statements (mut-array ScalarStatement)) (loop ScalarStatement))
		(returns i32)
		(body
			(let boundary (call iterator_owner_boundary (borrow-shared nodes) loop))
			(let block (statements.get (loop.get first)))
			(let-mut item (block.get target))
			(let indexed (struct:get (nodes.get item) next_sibling))
			(if (i32:lt -1i32 indexed) (then (set item indexed)))
			(let binding (statements.get item))
			(if
				(:doc "A copyable item adds no destructor to the iteration owner's chain.")
				(bool:not (call is_array_owner (binding.get type)))
				(then (return boundary)))
			(statements.set item
				(call statement_exit_state binding item boundary (bool true) 0u32))
			(return item)))

	(fn find_iteration_binding
		(:doc `Find a header name by comparing the one or two original identifier rows.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (first i32) (name SourceNode))
		(returns i32)
		(body
			(let-mut index first)
			(while
				(:doc "The checked binder contains only names in this body's scope.")
				(i32:lt -1i32 index)
				(body
					(let candidate (nodes.get index))
					(if (call same_name (borrow-shared source) candidate name) (then (return index)))
					(set index (candidate.get next_sibling))))
			(return -1i32))))
