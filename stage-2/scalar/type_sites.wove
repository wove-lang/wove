(module scalar_type_sites
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Locate checked uses of a native numeric type in emitted expressions, signatures, and layouts.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/functions.wove" (only function_field_tag))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only is_128bit_integer is_256bit_integer (value i128_type) (value i256_type)))
	(use wove-file "../source/integer_checks.wove" (only (value integer_fits)))
	(use wove-file "./loans.wove" (only (type ScalarExpression)))
	(use wove-file "./flow.wove" (only (type ScalarStatement)))
	(use wove-file "./function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "./callable_types.wove" (only callable_parameter_type))
	(use wove-file "./records.wove" (only is_callable_type callable_index callable_layout_shape is_callable_alias array_owner_element is_array_owner is_fixed_array
		is_enum_layout is_payload_enum is_native_record is_place_reference is_record_type is_typed_slice
		member_value_type native_field_type place_reference_target record_index slice_element_type (type ScalarRecord)))

	(fn target_numeric_type
		(:doc "Recognize a required numeric capability directly or through a checked array, slice, or reference.")
		(params (records (shared-array ScalarRecord)) (type u32) (wanted u32)) (returns bool)
		(body
			(if (type.eq wanted) (then (return (bool true))))
			(if
				(:doc "Both signednesses of the wide integer require the same target capability.")
				(bool:or (bool:and (wanted.eq i128_type) (call is_128bit_integer type))
					(bool:and (wanted.eq i256_type) (call is_256bit_integer type)))
				(then (return (bool true))))
			(if
				(:doc "An owning array carries the type of each aligned element.")
				(call is_array_owner type)
				(then (return (call target_numeric_type (borrow-shared records) (call array_owner_element (borrow-shared records) type) wanted))))
			(if
				(:doc "Typed slices carry their checked element type.")
				(call is_typed_slice type)
				(then (return (call target_numeric_type (borrow-shared records)
					(call slice_element_type (borrow-shared records) type) wanted))))
			(if
				(:doc "A native reference retains the exact type of its pointee.")
				(call is_place_reference type)
				(then (return (call target_numeric_type (borrow-shared records)
					(call place_reference_target (borrow-shared records) type) wanted))))
			(if
				(:doc "Inspect inline array elements here. Named layout fields have their own original sites.")
				(call is_record_type type)
				(then
					(let layout (records.get (call record_index type)))
					(if
						(:doc "Only inline arrays encode element types directly in the layout.")
						(call is_fixed_array layout)
						(then (return (call target_numeric_type (borrow-shared records)
							(u32:from-i32 layout/first) wanted))))))
			(return (bool false))))

	(fn callable_uses_numeric_type
		(:doc "Check a callable formal's full prototype even when the parameter is unused.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(records (shared-array ScalarRecord)) (type u32) (wanted u32))
		(returns bool)
		(body
			(if (bool:not (call is_callable_type type)) (then (return (bool false))))
			(let shape (call callable_layout_shape (records.get (call callable_index type))))
			(if (call target_numeric_type (borrow-shared records) shape/result wanted)
				(then (return (bool true))))
			(let-mut index shape/first)
			(while
				(:doc "An exact scalar input can require its own target capability.")
				index.not-ltz
				(body
					(let type (call callable_parameter_type (borrow-shared source) (borrow-shared nodes)
						index shape/named))
					(if (call target_numeric_type (borrow-shared records) type wanted)
						(then (return (bool true))))
					(set index (struct:get (nodes.get index) next_sibling))))
			(return (bool false))))

	(fn target_numeric_field
		(:doc "Find the first emitted member whose checked type requires the selected numeric ABI.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (wanted u32)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Visit checked layouts up to their zero-initialized tail.")
				(index.lt records.len)
				(body
					(let record (records.get index))
					(if record/name.eqz (then (return -1i32)))
					(if
						(:doc "The written type of a standalone callable alias can require the native ABI.")
						(bool:and (call is_callable_alias record)
							(call callable_uses_numeric_type (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) (u32:from-i32 record/alias_of) wanted))
						(then (return record/first)))
					(let template (bool:and (i32:lt -1i32 record/generic)
						record/specialization.ltz))
					(let simple_enum (bool:and (call is_enum_layout record) (bool:not (call is_payload_enum record))))
					(if
						(:doc "Only concrete named layouts have source member rows to inspect.")
						(bool:not (template.or (simple_enum.or (call is_fixed_array record))))
						(then
							(let-mut field record/first)
							(let-mut ordinal 0i32)
							(while
								(:doc "Use the same checked member types as the C record emitter.")
								(bool:and (ordinal.lt record/count) (i32:lt -1i32 field))
								(body
									(let node (nodes.get field))
									(let-mut type 0u32)
									(if
										(:doc "Bridge fields use the resolved C layout instead of the Wove member namespace.")
										(call is_native_record record)
										(then (set type (call native_field_type (borrow-shared source) (borrow-shared nodes)
											(borrow-shared records) record field)))
										(else (set type (call member_value_type (borrow-shared source) (borrow-shared nodes)
											(borrow-shared records) (borrow-shared bindings) record node))))
									(if
										(:doc "A type operand preserves the source location even in a specialized layout.")
										(call target_numeric_type (borrow-shared records) type wanted)
										(then
											(let part (call form_parts (borrow-shared source) (borrow-shared nodes) node))
											(let type_node part/operands)
											(if (i32:lt -1i32 type_node) (then (return type_node)))
											(return field)))
									(set field node/next_sibling)
									(set ordinal ordinal.inc)))))
					(set index index.inc)))
			(return -1i32)))

	(fn target_result_site
		(:doc "Recover the written result type even when the checked declaration has generic fields.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction))
		(returns i32)
		(body
			(let-mut index (struct:get (nodes.get function/name) next_sibling))
			(while
				(:doc "A returns field can follow metadata or precede parameters.")
				index.not-ltz
				(body
					(let field (nodes.get index))
					(if
						(:doc "Use the original type operand as the location of the target requirement.")
						(u32:eq (call function_field_tag (borrow-shared source) (borrow-shared nodes) field) 2u32)
						(then (return (struct:get (call form_parts (borrow-shared source)
							(borrow-shared nodes) field) operands))))
					(set index field/next_sibling)))
			(return function/declaration)))

	(fn target_numeric_site
		(:doc "Locate the required format in a checked expression, storage declaration, signature, or field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (wanted u32)) (returns i32)
		(body
			(let-mut index 0i32)
			(let-mut storage -1i32)
			(let-mut derived -1i32)
			(let bit_integer (wanted.eq i256_type))
			(while
				(:doc "Expression and statement rows share their original source node index.")
				(index.lt expressions.len)
				(body
					(let expr (expressions.get index))
					(let statement (statements.get index))
					(if
						(:doc "A fits expression can require a type even when its argument and Boolean result have other types.")
						(bool:or (call target_numeric_type (borrow-shared records) expr/type wanted)
							(bool:and (bool:or (wanted.eq i128_type) bit_integer)
								(bool:and (expr/kind.eq integer_fits)
									(call target_numeric_type (borrow-shared records)
										(u32:from-i32 expr/target) wanted))))
						(then
							(if
								(:doc "Prefer an explicit 256-bit literal or range predicate over a call or read that inherits the type.")
								(bool:or bit_integer.not (bool:or (expr/kind.eq 1u32)
									(expr/kind.eq integer_fits)))
								(then (return index)))
							(if derived.ltz (then (set derived index)))))
					(if
						(:doc "A storage declaration can require the format even with no initializer expression.")
						(bool:and storage.ltz
							(call target_numeric_type (borrow-shared records) statement/type wanted))
						(then (set storage index)))
					(set index index.inc)))
			(if
				(:doc "For 256-bit types, prefer the defining signature or layout over downstream uses.")
				(bool:and bit_integer.not storage.not-ltz)
				(then (return storage)))
			(set index 0i32)
			(while
				(:doc "An unused function parameter can still require the target ABI.")
				(index.lt parameters.len)
				(body
					(let param (parameters.get index))
					(if
						(:doc "The type follows the formal's original name.")
						(bool:or (call target_numeric_type (borrow-shared records) param/type wanted)
							(call callable_uses_numeric_type (borrow-shared source) (borrow-shared nodes)
								(borrow-shared records) param/type wanted))
						(then
							(let name param/name)
							(let type (struct:get (nodes.get name) next_sibling))
							(if (i32:lt -1i32 type) (then (return type)))
							(return name)))
					(set index index.inc)))
			(set index 0i32)
			(while
				(:doc "Bridge results and unused Wove functions keep their native signatures.")
				(index.lt functions.len)
				(body
					(let fn_row (functions.get index))
					(if
						(:doc "Report the original declaration if its result requires the target ABI.")
						(call target_numeric_type (borrow-shared records) fn_row/result wanted)
						(then
							(if
								(:doc "Keep the result type's own span for the optional C23 ABI.")
								bit_integer
								(then (return (call target_result_site (borrow-shared source)
									(borrow-shared nodes) fn_row))))
							(return fn_row/declaration)))
					(set index index.inc)))
			(let field (call target_numeric_field (borrow-shared source) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared records) wanted))
			(if field.not-ltz (then (return field)))
			(if storage.not-ltz (then (return storage)))
			(return derived)))
)
