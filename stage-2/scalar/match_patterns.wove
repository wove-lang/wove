(module scalar_match_patterns
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read constant integer match patterns and compare their exact values across source spellings.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only builtin_type_keyword))
	(use wove-file "../source/literals.wove" (only integer_magnitude_start hex_digits_start
		integer_digits_end (value hex_literal_format)))
	(use wove-file "../text/hex.wove" (only hex_digit_value))
	(use wove-file "./syntax.wove" (only entry_at entry_form (type EntryRead)))
	(use wove-file "./loans.wove" (only (type ScalarExpression)))

	(use wove-file "./integer_literals.wove" (only plan_integer_value))

	(struct MatchKey (fields (high u32) (low u32) (negative bool)))

	(fn is_match_fallback
		(:doc `A bare underscore is the single wildcard pattern.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(let start (struct.get (local node) start))
			(return (bool.and (u32.eq (struct.get (local node) kind) 1u32)
				(bool.and (i32.eq (struct.get (local node) end) (i32.add.wrapping (local start) 1i32))
					(u8.eq (array.load (local source) (local start)) 95u8))))))

	(fn read_integer_pattern
		(:doc `An unsuffixed pattern takes the subject type. An explicit suffix or literal form must match it exactly.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (type u32)
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let pattern (array.load (local nodes) (local index)))
			(let-mut start (struct.get (local pattern) start))
			(let-mut end (struct.get (local pattern) end))
			(if
				(:doc "A bare pattern may specify a width immediately after its decimal or hexadecimal digits.")
				(u32.eq (struct.get (local pattern) kind) 1u32)
				(then
					(let hex (call hex_digits_start (borrow-shared (local source)) (local start) (local end)))
					(let-mut digits (call integer_magnitude_start (borrow-shared (local source)) (local start)))
					(let-mut radix 10i32)
					(if
						(:doc "A hexadecimal prefix makes the following letters part of the magnitude where valid.")
						(i32.lt -1i32 (local hex))
						(then (set (local digits) (local hex)) (set (local radix) 16i32)))
					(let suffix (call integer_digits_end (borrow-shared (local source)) (local digits) (local end) (local radix)))
					(if
						(:doc "A typed pattern cannot use a conversion or mix integer widths.")
						(i32.lt (local suffix) (local end))
						(then
							(let actual (call builtin_type_keyword (borrow-shared (local source)) (local suffix)
								(i32.sub.wrapping (local end) (local suffix))))
							(if (bool.not (u32.eq (local actual) (local type))) (then (return (call entry_at (local pattern) -1i32 24u32))))
							(set (local end) (local suffix)))))
				(else
					(let form (call entry_form (borrow-shared (local source)) (borrow-shared (local nodes))
						(local pattern) (local type) 24u32))
					(if (u32.lt 0u32 (struct.get (local form) error)) (then (return (local form))))
					(let operand (struct.get (local form) operand))
					(if (i32.lt (local operand) 0i32) (then (return (call entry_at (local pattern) -1i32 24u32))))
					(let literal (array.load (local nodes) (local operand)))
					(if
						(:doc "A literal form has one bare magnitude operand.")
						(bool.or (bool.not (u32.eq (struct.get (local literal) kind) 1u32))
							(i32.lt -1i32 (struct.get (local literal) next_sibling)))
						(then (return (call entry_at (local pattern) -1i32 24u32))))
					(set (local start) (struct.get (local literal) start))
					(set (local end) (struct.get (local literal) end))))
			(return (call plan_integer_value (borrow-shared (local source)) (local pattern)
				(local start) (local end) (local type) (local index) (borrow-mut (local expressions))))))

	(fn scale_digit
		(:doc `Multiply one 16-bit limb by the radix. The result and its incoming carry fit in u32.`)
		(params (limb u32) (hex bool) (carry u32))
		(returns u32)
		(body
			(if (local hex) (then (return (u32.add.wrapping (u32.shl (local limb) 4i32) (local carry)))))
			(return (u32.add.wrapping (u32.add.wrapping (u32.shl (local limb) 3i32) (u32.shl (local limb) 1i32)) (local carry)))))

	(fn match_key
		(:doc `Accumulate a checked magnitude in two u32 words so the seed needs no wide integer arithmetic.`)
		(params (source (shared-array u8)) (row ScalarExpression))
		(returns MatchKey)
		(body
			(let hex (i32.eq (struct.get (local row) target) (local hex_literal_format)))
			(let-mut low 0u32)
			(let-mut high 0u32)
			(let-mut index (struct.get (local row) start))
			(while
				(:doc "Carry into the next 16-bit limb before masking the current limb.")
				(i32.lt (local index) (struct.get (local row) end))
				(body
					(let digit (int.convert u32 (call hex_digit_value (array.load (local source) (local index)))))
					(let a (call scale_digit (u32.and (local low) 65535u32) (local hex) (local digit)))
					(let b (call scale_digit (u32.shr (local low) 16i32) (local hex) (u32.shr (local a) 16i32)))
					(let c (call scale_digit (u32.and (local high) 65535u32) (local hex) (u32.shr (local b) 16i32)))
					(let d (call scale_digit (u32.shr (local high) 16i32) (local hex) (u32.shr (local c) 16i32)))
					(set (local low) (u32.or (u32.shl (local b) 16i32) (u32.and (local a) 65535u32)))
					(set (local high) (u32.or (u32.shl (local d) 16i32) (u32.and (local c) 65535u32)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (struct.new MatchKey (high (local high)) (low (local low)) (negative (struct.get (local row) negative))))))

	(fn has_match_key
		(:doc `Sign and magnitude uniquely identify every checked pattern. The literal reader already normalizes negative zero.`)
		(params (keys (shared-array MatchKey)) (count i32) (key MatchKey))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only earlier literal cases contribute keys.")
				(i32.lt (local index) (local count))
				(body
					(let prior (array.load (local keys) (local index)))
					(if
						(:doc "Equal sign and both equal words mean the cases overlap.")
						(bool.and (u32.eq (struct.get (local key) high) (struct.get (local prior) high))
							(bool.and (u32.eq (struct.get (local key) low) (struct.get (local prior) low))
								(bool.or (bool.and (struct.get (local key) negative) (struct.get (local prior) negative))
									(bool.and (bool.not (struct.get (local key) negative)) (bool.not (struct.get (local prior) negative))))))
						(then (return (bool true))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (bool false))))
)
