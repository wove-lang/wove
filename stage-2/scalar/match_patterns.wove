(module scalar_match_patterns
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read constant integer match patterns and compare their exact values across source spellings.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/types.wove" (only builtin_type_keyword is_128bit_integer))
	(use wove-file "../source/literals.wove" (only integer_atom read_integer_magnitude))
	(use wove-file "./syntax.wove" (only entry_at entry_form (type EntryRead)))
	(use wove-file "./loans.wove" (only (type ScalarExpression)))

	(use wove-file "./integer_literals.wove" (only plan_integer_value))

	(struct MatchKey (fields (highest u32) (upper u32) (high u32) (low u32) (negative bool)))

	(fn is_match_fallback
		(:doc `A bare underscore is the single wildcard pattern.`)
		(params (source (shared-array u8)) (node SourceNode))
		(returns bool)
		(body
			(let start (node.get start))
			(return (bool:and (u32:eq (node.get kind) 1u32)
				(bool:and (i32:eq (node.get end) (i32:inc start))
					(u8:eq (source.get start) 95u8))))))

	(fn read_integer_pattern
		(:doc `An unsuffixed pattern takes the subject type. An explicit suffix or literal form must match it exactly.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (type u32)
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let pattern (nodes.get index))
			(let-mut start (pattern.get start))
			(let-mut end (pattern.get end))
			(if
				(:doc "A bare pattern may specify a width immediately after its magnitude.")
				(u32:eq (pattern.get kind) 1u32)
				(then
					(let atom (call integer_atom (borrow-shared source) start end))
					(let suffix (atom.get end))
					(if
						(:doc "A typed pattern cannot use a conversion or mix integer widths.")
						(i32:lt suffix end)
						(then
							(let actual (call builtin_type_keyword (borrow-shared source) suffix
								(i32:sub end suffix)))
							(if (u32:not-eq actual type) (then (return (call entry_at pattern -1i32 24u32))))
							(set end suffix))))
				(else
					(let form (call entry_form (borrow-shared source) (borrow-shared nodes)
						pattern type 24u32))
					(if (u32:gtz (form.get error)) (then (return form)))
					(let operand (form.get operand))
					(if (i32:ltz operand) (then (return (call entry_at pattern -1i32 24u32))))
					(let literal (nodes.get operand))
					(if
						(:doc "A literal form has one bare magnitude operand.")
						(bool:or (u32:not-eq (literal.get kind) 1u32)
							(i32:lt -1i32 (literal.get next_sibling)))
						(then (return (call entry_at pattern -1i32 24u32))))
					(set start (literal.get start))
					(set end (literal.get end))))
			(return (call plan_integer_value (borrow-shared source) pattern
				start end type index (borrow-mut expressions)))))

	(fn match_key
		(:doc "Use the validated magnitude and sign as the key regardless of its source spelling.")
		(params (source (shared-array u8)) (row ScalarExpression)) (returns MatchKey)
		(body
			(let magnitude (call read_integer_magnitude (borrow-shared source)
				(row.get start) (row.get end) (i32:sub 0i32 (row.get target))
				(call is_128bit_integer (row.get type))))
			(return (struct:new MatchKey (highest (magnitude.get highest))
				(upper (magnitude.get upper)) (high (magnitude.get high))
				(low (magnitude.get low)) (negative (row.get negative))))))

	(fn has_match_key
		(:doc `Sign and magnitude uniquely identify every checked pattern. The literal reader already normalizes negative zero.`)
		(params (keys (shared-array MatchKey)) (count i32) (key MatchKey))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Only earlier literal cases contribute keys.")
				(i32:lt index count)
				(body
					(let prior (keys.get index))
					(if
						(:doc "Equal sign and matching words mean the cases overlap at any width.")
						(bool:and (bool:and (u32:eq (key.get highest) (prior.get highest))
							(u32:eq (key.get upper) (prior.get upper)))
							(bool:and (u32:eq (key.get high) (prior.get high))
							(bool:and (u32:eq (key.get low) (prior.get low))
								(bool:or (bool:and (key.get negative) (prior.get negative))
									(bool:and (bool:not (key.get negative)) (bool:not (prior.get negative)))))))
						(then (return (bool true))))
					(set index (i32:inc index))))
			(return (bool false))))
)
