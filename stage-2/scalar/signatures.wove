(module scalar_signatures
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the shared shape of scalar function and inline test signatures.

	Keep the parameter, result type, and body rows in the original tree.
	The scalar planner resolves the result type before completing the body
	check. Test discovery only needs the literal void spelling.`)

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts skip_disabled_siblings validate_form_metadata))
	(use wove-file "../source/functions.wove" (only collect_function_fields read_return_origin))
	(use wove-file "../source/types.wove" (only void_type))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword (type EntryRead)))

	(struct SignatureHead (fields (params i32) (type_node i32) (from i32) (body i32) (start i32) (end i32) (error u32)))
	(struct ScalarSignature (fields (params i32) (result u32) (from i32) (first_statement i32) (start i32) (end i32) (error u32) (body i32)))

	(fn signature_error
		(:doc `Carry an original source diagnostic through the signature reader.`)
		(params (error EntryRead))
		(returns ScalarSignature)
		(body
			(return (struct:new ScalarSignature (params -1i32) (result 0u32) (from -1i32) (first_statement -1i32) (body -1i32)
				(start error/start) (end error/end)
				(error error/error)))))

	(fn signature_head_error
		(:doc `Carry the first invalid signature form or operand's original span.`)
		(params (error EntryRead))
		(returns SignatureHead)
		(body
			(return (struct:new SignatureHead (params -1i32) (type_node -1i32) (from -1i32) (body -1i32)
				(start error/start) (end error/end)
				(error error/error)))))

	(fn read_signature_head
		(:doc `Read the parameter and result forms, leaving result type resolution to the caller.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(first_field i32) (empty_params bool) (allow_from bool))
		(returns SignatureHead)
		(body
			(let fields (call collect_function_fields (borrow-shared source) (borrow-shared nodes)
				first_field (bool false)))
			(let error fields/error)
			(if
				(:doc "Report an unexpected or repeated field at its original row.")
				error.gtz
				(then (return (call signature_head_error
					(call entry_at (nodes.get fields/site) -1i32 error)))))
			(let params fields/params)
			(let result_node fields/result)
			(if
				(:doc "Even a zero-argument function declares params and an exact result type.")
				(bool:or params.ltz result_node.ltz)
				(then (return (call signature_head_error (call entry_at node -1i32 23u32)))))
			(let params_node (nodes.get params))
			(let parameters (call entry_form (borrow-shared source) (borrow-shared nodes)
				params_node 3u32 23u32))
			(if
				(:doc "Preserve the original params diagnostic.")
				parameters/error.gtz
				(then (return (call signature_head_error parameters))))
			(let first parameters/operand)
			(if
				(:doc "Discovered tests require an empty parameter list.")
				(empty_params.and first.not-ltz)
				(then (return (call signature_head_error (call entry_at params_node -1i32 23u32)))))
			(let returns (nodes.get result_node))
			(let signature (call entry_form (borrow-shared source) (borrow-shared nodes)
				returns 4u32 23u32))
			(if
				(:doc "Keep the return form's diagnostic before inspecting its operands.")
				signature/error.gtz
				(then (return (call signature_head_error signature))))
			(let type_node signature/operand)
			(if
				(:doc "The returns form begins with exactly one type operand.")
				type_node.ltz
				(then (return (call signature_head_error (call entry_at returns -1i32 23u32)))))
			(let provenance (struct:get (nodes.get type_node) next_sibling))
			(let-mut from -1i32)
			(if
				(:doc "Only ordinary Wove function results may name a source parameter.")
				provenance.not-ltz
				(then
					(if
						(:doc "Tests and callable signatures retain exactly one result operand.")
						allow_from.not
						(then (return (call signature_head_error (call entry_at returns -1i32 23u32)))))
					(let checked (call read_return_origin (borrow-shared source) (borrow-shared nodes)
						(nodes.get provenance) returns))
					(if
						(:doc "Forward the malformed clause or name diagnostic.")
						checked/error.gtz
						(then (return (call signature_head_error
						(struct:new EntryRead (operand -1i32) (start checked/start)
							(end checked/end) (error checked/error) (related -1i32))))))
					(set from checked/operand)))
			(return (struct:new SignatureHead (params first) (type_node type_node) (from from)
				(body fields/body)
				(start node/start) (end node/end) (error 0u32)))))

	(fn complete_signature
		(:doc `Report signature errors first, then read the one body form for the resolved result type.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(head SignatureHead) (result u32))
		(returns ScalarSignature)
		(body
			(if
				(:doc "A malformed head keeps the first diagnostic from the shared form reader.")
				head/error.gtz
				(then (return (struct:new ScalarSignature (params -1i32) (result 0u32) (from -1i32)
					(first_statement -1i32) (body -1i32)
					(start head/start) (end head/end)
					(error head/error)))))
			(if
				(:doc "An unsupported result type points at the type operand.")
				result.eqz
				(then (return (call signature_error
					(call entry_at (nodes.get head/type_node) -1i32 23u32)))))
			(let body head/body)
			(if
				(:doc "A Wove definition requires a body.")
				body.ltz
				(then (return (call signature_error (call entry_at node -1i32 24u32)))))
			(let body_node (nodes.get body))
			(let statements (call entry_form (borrow-shared source) (borrow-shared nodes)
				body_node 6u32 24u32))
			(if
				(:doc "Forward an unsupported body form unchanged.")
				statements/error.gtz
				(then (return (call signature_error statements))))
			(let first_statement (call skip_disabled_siblings (borrow-shared source) (borrow-shared nodes)
				statements/operand))
			(if
				(:doc "An empty body can only complete a void helper.")
				(bool:and first_statement.ltz (result.not-eq (call void_type)))
				(then (return (call signature_error (call entry_at body_node -1i32 24u32)))))
			(return (struct:new ScalarSignature (params head/params) (result result) (from head/from)
				(first_statement first_statement) (body body)
				(start node/start) (end node/end) (error 0u32)))))

	(fn read_test_signature
		(:doc `Check that a discovered test takes no arguments, returns literal void, and has a body.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode) (first_field i32))
		(returns ScalarSignature)
		(body
			(let head (call read_signature_head (borrow-shared source) (borrow-shared nodes)
				node first_field (bool true) (bool false)))
			(let type (call entry_keyword (borrow-shared source) (borrow-shared nodes)
				head/type_node))
			(let-mut result 0u32)
			(if
				(:doc "Tests have a fixed result type and need no type namespace.")
				(type.eq (call void_type))
				(then (set result type)))
			(return (call complete_signature (borrow-shared source) (borrow-shared nodes)
				node head result)))))
