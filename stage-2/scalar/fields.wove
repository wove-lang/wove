(module scalar_fields
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve record field projections and track whether the original owner path is still live.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/c_records.wove" (only read_c_inline_field c_pointer_field_kind (value cstrs_field_kind)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "./syntax.wove" (only entry_at entry_form entry_keyword is_scalar_name (value buffered_cstrs_type) (type EntryRead)))
	(use wove-file "./loans.wove" (only expression_row writable_place buffered_field_projection (type ScalarExpression)))
	(use wove-file "./flow.wove" (only (type ScalarStatement)))
	(use wove-file "./control.wove" (only prior_owner_take))
	(use wove-file "./conditional.wove" (only is_pending_value (value pending_field_read)))
	(use wove-file "./value_types.wove" (only value_matches_type))
	(use wove-file "./records.wove" (only record_receiver_type is_record_type is_owning_record record_index
		is_fixed_array is_enum_layout find_member is_buffered_record is_native_record native_field_type member_value_type (type ScalarRecord)))

	(fn read_field_projection
		(:doc `Validate one projection before using its receiver or the field's name.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node 52u32 24u32))
			(if (u32:gtz (struct:get form error)) (then (return form)))
			(let receiver (struct:get form operand))
			(if
				(:doc "A projection needs a receiver before its field name.")
				(i32:ltz receiver)
				(then (return (call entry_at node -1i32 24u32))))
			(let member (struct:get (array:load nodes receiver) next_sibling))
			(if
				(:doc "Require exactly one field name after the receiver.")
				(bool:or (i32:ltz member)
					(i32:not-ltz (struct:get (array:load nodes member) next_sibling)))
				(then (return (call entry_at node -1i32 24u32))))
			(return form)))

	(fn check_owned_record_path
		(:doc "Diagnose the first move that made this record or projected member unavailable.")
		(params (nodes (shared-array SourceNode)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (node SourceNode) (binding ScalarExpression)
			(place i32) (index i32) (statement i32) (ancestor_only bool))
		(returns EntryRead)
		(body
			(if
				(:doc "Only a local owning record can have fields transferred out of it.")
				(bool:and (u32:eq (struct:get binding kind) 6u32)
					(call is_owning_record (borrow-shared records) (struct:get binding type)))
				(then
					(let moved (call prior_owner_take (borrow-shared nodes) (borrow-shared statements)
						(borrow-shared expressions) (struct:get binding target) place (bool false) ancestor_only index statement))
					(if
						(:doc "The attempted use and original move both retain their source spans.")
						(i32:lt -1i32 moved)
						(then (return (struct:new EntryRead (operand -1i32) (start (struct:get node start))
							(end (struct:get node end)) (error 39u32) (related moved)))))))
			(return (call entry_at node index 0u32))))

	(fn plan_c_inline_field
		(:doc "Lend caller-stored native bytes only to the immediately enclosing checked array access.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (receiver i32) (binding ScalarExpression) (field i32) (extent i32) (expected u32)
			(expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let parent (array:load nodes (struct:get node parent)))
			(let parts (call form_parts (borrow-shared source) (borrow-shared nodes) parent))
			(let kind (call entry_keyword (borrow-shared source) (borrow-shared nodes)
				(struct:get parts head)))
			(let write (u32:eq kind 40u32))
			(let access (bool:or write (bool:or (u32:eq kind 36u32) (u32:eq kind 37u32))))
			(if
				(:doc "The descriptor never escapes as a standalone value or an implicit loan.")
				(bool:not (bool:and access (i32:eq (struct:get parts operands) index)))
				(then (return (call entry_at node -1i32 24u32))))
			(let origin (struct:get binding kind))
			(let declared (bool:or (u32:eq origin 6u32) (u32:eq origin 2u32)))
			(if
				(:doc "A native member must remain in the caller's named record or its existing reference.")
				(bool:not declared)
				(then (return (call entry_at (array:load nodes receiver) -1i32 24u32))))
			(if
				(:doc "Updating an inline member needs mutable record storage or an exclusive record reference.")
				(bool:and write (bool:not (call writable_place binding)))
				(then (return (call entry_at (array:load nodes receiver) -1i32 37u32))))
			(let-mut type 34u32)
			(if write (then (set type 38u32)))
			(if
				(:doc "Require the access planner's readable or writable descriptor expectation.")
				(bool:not (call value_matches_type expected type))
				(then (return (call entry_at node -1i32 24u32))))
			(array:store expressions index
				(struct:new ScalarExpression (kind 52u32) (type type) (target field)
					(first receiver) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (bool false)) (mutable_place (bool false)) (projection receiver)
					(asset_start 0i32) (asset_end extent) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))

	(fn plan_field_read
		(:doc `Resolve one field of an already checked receiver and retain its exact type and ordinal.`)
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(index i32) (receiver i32) (expected u32) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let node (array:load nodes index))
			(let reference (array:load nodes receiver))
			(let member (struct:get reference next_sibling))
			(let name (array:load nodes member))
			(if
				(:doc "Field selection uses a bare identifier.")
				(bool:not (call is_scalar_name (borrow-shared source) name))
				(then (return (call entry_at name -1i32 34u32))))
			(let value (array:load expressions receiver))
			(if
				(:doc "Wait for the receiver's exact result type before selecting its field.")
				(call is_pending_value (struct:get value kind))
				(then
					(array:store expressions index
						(call expression_row pending_field_read expected -1i32 receiver 0i32 0i32 (bool false)))
					(return (call entry_at node index 0u32))))
			(let type (call record_receiver_type (struct:get value type)))
			(if
				(:doc "A resolved field receiver must name a record layout.")
				(bool:not (call is_record_type type))
				(then (return (call entry_at reference -1i32 24u32))))
			(let kind (struct:get value kind))
			(let named (bool:or (u32:eq kind 6u32) (u32:eq kind 2u32)))
			(if
				(:doc "An owning receiver needs a named place or a checked projection of one.")
				(bool:and (call is_owning_record (borrow-shared records) type)
					(bool:not (bool:or named
						(bool:and (u32:eq kind 52u32) (i32:not-ltz (struct:get value projection))))))
				(then (return (call entry_at reference -1i32 24u32))))
			(let layout (array:load records (call record_index type)))
			(if
				(:doc "Fixed arrays and enums do not expose named record fields.")
				(bool:or (call is_fixed_array layout) (call is_enum_layout layout))
				(then (return (call entry_at reference -1i32 24u32))))
			(let field (call find_member (borrow-shared source) (borrow-shared nodes)
				(struct:get layout first) (struct:get layout count) name))
			(let ordinal (struct:get field ordinal))
			(if
				(:doc "An unknown field points at the requested name.")
				(i32:ltz ordinal)
				(then (return (call entry_at name -1i32 34u32))))
			(let-mut target ordinal)
			(let-mut result 0u32)
			(let row (struct:get field row))
			(if
				(:doc "Native fields use the real C name and the defining bridge's checked type.")
				(call is_native_record layout)
				(then
					(let field_node (array:load nodes row))
					(set target (struct:get field_node first_child))
					(let field_parts (call form_parts (borrow-shared source) (borrow-shared nodes) field_node))
					(let operand (array:load nodes (struct:get field_parts operands)))
					(let pointer (call c_pointer_field_kind (borrow-shared source) operand))
					(if
						(:doc "Only a present caller-backed record can lend a native pointer field.")
						(u32:gtz pointer)
						(then
							(if
								(:doc "A named unwrapped view supplies the original scratch bounds for pointer fields.")
								(bool:not (bool:and named (call is_buffered_record (struct:get value type))))
								(then (return (call entry_at name -1i32 24u32))))
							(let-mut projection_type 34u32)
							(if (u32:eq pointer cstrs_field_kind) (then (set projection_type buffered_cstrs_type)))
							(if
								(:doc "A pointer field yields only a shared byte view or an immutable table binding.")
								(bool:not (bool:or (u32:eq expected 42u32)
									(call value_matches_type expected projection_type)))
								(then (return (call entry_at node -1i32 24u32))))
							(array:store expressions index
								(call buffered_field_projection projection_type target receiver 0i32 0i32 0i32))
							(return (call entry_at node index 0u32))))
					(let inline (call read_c_inline_field (borrow-shared source) (borrow-shared nodes)
						(array:load nodes (struct:get field_parts operands))))
					(let extent (struct:get inline extent))
					(if
						(:doc "Keep an inline byte array in its native record and supply a checked access to its original storage.")
						(i32:gtz extent)
						(then (return (call plan_c_inline_field (borrow-shared source) (borrow-shared nodes)
							node index receiver value target extent expected
							(borrow-mut expressions)))))
					(set result (call native_field_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) layout row)))
				(else
					(set result (call member_value_type (borrow-shared source) (borrow-shared nodes)
						(borrow-shared records) (borrow-shared bindings) layout (array:load nodes row)))))
			(if
				(:doc "A destination discovers the exact field type. A read must match its expected type.")
				(bool:and (u32:not-eqz expected)
					(bool:not (call value_matches_type expected result)))
				(then (return (call entry_at node -1i32 24u32))))
			(let-mut root -1i32)
			(if
				(:doc "Wove fields of a named place retain its root for loan checking and direct emission.")
				(bool:not (call is_native_record layout))
				(then
					(if
						(:doc "A parameter or local starts a field path in its own binding namespace.")
						named
						(then (set root receiver))
						(else (set root (struct:get value projection))))))
			(array:store expressions index
				(struct:new ScalarExpression (kind 52u32) (type result) (target target)
					(first receiver) (start 0i32) (end 0i32) (negative (bool false))
					(borrowed_owner (bool false)) (mutable_place (bool false)) (projection root)
					(asset_start 0i32) (asset_end 0i32) (extent_check -1i32)))
			(return (call entry_at node index 0u32))))
)
