(module scalar_conditional
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the shape and execution paths of a conditional value.")

	(use wove-file "../source/array_growth.wove" (only (value array_remove_kind) (value array_try_alloc_kind) (value array_try_push_kind)))
	(use wove-file "../source/enum_forms.wove" (only (value pending_match_value) (value match_value_case) (value enum_payload_constructor)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/owned.wove" (only (value optional_none) (value optional_some) (value pending_optional_some)))
	(use wove-file "../source/types.wove" (only is_builtin_scalar))
	(use wove-file "./owners.wove" (only is_lexical_owner))
	(use wove-file "./records.wove" (only is_callable_type is_native_integer is_record_type is_owning_record is_scoped_record (type ScalarRecord)))
	(use wove-file "./syntax.wove" (only is_direct_call entry_at entry_form is_native_owner_constructor is_worker_collect (value fixed_list_kind) (type EntryRead)))
	(use wove-file "./flow.wove" (only within_scope))
	(use wove-file "./loans.wove" (only expression_row (type ScalarExpression)))

	(let conditional_value 22u32)
	(let conditional_then 23u32)
	(let conditional_else 24u32)

	(let pending_field_read 201u32)
	(let pending_array_read 202u32)
	(let pending_conditional 203u32)

	(fn is_pending_value
		(:doc "Identify a value that needs checked child types before its own final type is available.")
		(:pragma (inline always))
		(params (kind u32))
		(returns bool)
		(body (return (bool:or (bool:or (u32:eq kind pending_conditional)
			(u32:eq kind pending_optional_some))
			(bool:or (u32:eq kind pending_match_value)
				(bool:or (u32:eq kind pending_field_read) (u32:eq kind pending_array_read)))))))

	(fn read_conditional_arm
		(:doc "Read the single evaluated operand of a then or else form.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (arm SourceNode) (tag u32))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) arm tag 24u32))
			(if (u32:gtz (struct:get form error)) (then (return form)))
			(let value (struct:get form operand))
			(if
				(:doc "A value arm cannot be empty or contain a statement sequence.")
				(bool:or (i32:ltz value)
					(i32:lt -1i32 (struct:get (nodes.get value) next_sibling)))
				(then (return (call entry_at arm -1i32 24u32))))
			(return form)))

	(fn plan_conditional
		(:doc "Check a value if and seed its predicate and both arm operands in source order.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (node SourceNode)
			(index i32) (expected u32) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let form (call entry_form (borrow-shared source) (borrow-shared nodes) node conditional_value 24u32))
			(if (u32:gtz (struct:get form error)) (then (return form)))
			(let condition (struct:get form operand))
			(if (i32:ltz condition) (then (return (call entry_at node -1i32 24u32))))
			(let first (struct:get (nodes.get condition) next_sibling))
			(if (i32:ltz first) (then (return (call entry_at node -1i32 24u32))))
			(let then_node (nodes.get first))
			(let then_form (call read_conditional_arm (borrow-shared source) (borrow-shared nodes)
				then_node conditional_then))
			(if (u32:gtz (struct:get then_form error)) (then (return then_form)))
			(let last (struct:get then_node next_sibling))
			(if (i32:ltz last) (then (return (call entry_at node -1i32 24u32))))
			(let else_node (nodes.get last))
			(let else_form (call read_conditional_arm (borrow-shared source) (borrow-shared nodes)
				else_node conditional_else))
			(if (u32:gtz (struct:get else_form error)) (then (return else_form)))
			(let extra (struct:get else_node next_sibling))
			(if
				(:doc "The else arm ends the value form.")
				(i32:lt -1i32 extra)
				(then (return (call entry_at (nodes.get extra) -1i32 24u32))))
			(let left (struct:get then_form operand))
			(let right (struct:get else_form operand))
			(let arm (call expression_row 0u32 expected -1i32 -1i32 0i32 0i32 (bool false)))
			(expressions.set condition (call expression_row 0u32 12u32 -1i32 -1i32 0i32 0i32 (bool false)))
			(expressions.set first (call expression_row conditional_then 0u32 -1i32 left 0i32 0i32 (bool false)))
			(expressions.set last (call expression_row conditional_else 0u32 -1i32 right 0i32 0i32 (bool false)))
			(expressions.set left arm)
			(expressions.set right arm)
			(expressions.set index (call expression_row pending_conditional
				0u32 -1i32 condition 0i32 0i32 (bool false)))
			(return (call entry_at node index 0u32))))

	(fn conditional_arm_is_value
		(:doc "Accept copyable values and expressions that supply a new owner to the selected arm.")
		(params (records (shared-array ScalarRecord)) (row ScalarExpression))
		(returns bool)
		(body
			(let type (struct:get row type))
			(if
				(:doc "The selected arm must produce its own value. Removal transfers ownership from the vector.")
				(call is_lexical_owner (borrow-shared records) type)
				(then
					(let kind (struct:get row kind))
					(if
						(:doc "An owning fixed list or optional constructor supplies its own value to the selected arm.")
						(bool:or (u32:eq kind fixed_list_kind)
							(bool:or (bool:or (u32:eq kind array_try_alloc_kind) (u32:eq kind array_try_push_kind))
								(bool:or (u32:eq kind optional_none) (u32:eq kind optional_some))))
						(then (return (bool true))))
					(return (bool:or (u32:eq kind array_remove_kind)
						(bool:or (bool:or (call is_direct_call kind)
							(bool:or (u32:eq kind 41u32) (call is_worker_collect kind)))
							(bool:or (bool:or (call is_native_owner_constructor kind)
								(bool:or (u32:eq kind 50u32) (u32:eq kind enum_payload_constructor)))
								(u32:eq kind conditional_value)))))))
			(return (call copyable_choice_type (borrow-shared records) type))))

	(fn copyable_choice_type
		(:doc "Copyable scalar and nominal value types fit in a shared result slot.")
		(params (records (shared-array ScalarRecord)) (type u32))
		(returns bool)
		(body
			(return (bool:or (bool:or (call is_callable_type type)
				(bool:or (call is_builtin_scalar type) (call is_native_integer type)))
				(bool:and (call is_record_type type)
					(bool:not (bool:or (call is_owning_record (borrow-shared records) type)
						(call is_scoped_record (borrow-shared records) type))))))))

	(fn finish_conditional_value
		(:doc "Compare exact arm types and publish the result after both values have been checked.")
		(params (nodes (shared-array SourceNode)) (index i32) (row ScalarExpression)
			(records (shared-array ScalarRecord)) (expressions (mut-array ScalarExpression)))
		(returns EntryRead)
		(body
			(let condition (struct:get row first))
			(let then_arm (struct:get (nodes.get condition) next_sibling))
			(let else_arm (struct:get (nodes.get then_arm) next_sibling))
			(let left (struct:get (expressions.get then_arm) first))
			(let right (struct:get (expressions.get else_arm) first))
			(let then_value (expressions.get left))
			(let else_value (expressions.get right))
			(if
				(:doc "A conditional cannot implicitly copy an owner or yield a borrowed place.")
				(bool:not (call conditional_arm_is_value (borrow-shared records) then_value))
				(then (return (call entry_at (nodes.get left) -1i32 24u32))))
			(let type (struct:get then_value type))
			(if
				(:doc "The else value must have the same exact type and be valid in a value slot.")
				(bool:not (bool:and (u32:eq type (struct:get else_value type))
					(call conditional_arm_is_value (borrow-shared records) else_value)))
				(then (return (call entry_at (nodes.get right) -1i32 24u32))))
			(expressions.set index (call expression_row conditional_value
				type -1i32 condition 0i32 0i32 (bool false)))
			(return (call entry_at (nodes.get index) index 0u32))))

	(fn conditional_transfer_reaches
		(:doc "Exclude transfers in a mutually exclusive or statically unselected arm from later uses.")
		(params (nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (transfer i32) (use i32))
		(returns bool)
		(body
			(let site (nodes.get use))
			(let-mut index (struct:get (nodes.get transfer) parent))
			(while
				(:doc "Any enclosing conditional arm can exclude execution of this transfer.")
				(i32:lt -1i32 index)
				(body
					(let arm (nodes.get index))
					(let parent (struct:get arm parent))
					(let kind (struct:get (expressions.get index) kind))
					(let then_arm (u32:eq kind conditional_then))
					(if
						(:doc "Another arm of the same value match cannot observe this transfer.")
						(bool:and (u32:eq kind match_value_case)
							(bool:and (call within_scope (nodes.get parent) site)
								(bool:not (call within_scope arm site))))
						(then (return (bool false))))
					(if
						(:doc "Within the same arm, the normal order of evaluation still applies.")
						(bool:and (bool:or then_arm (u32:eq kind conditional_else))
							(bool:not (call within_scope arm site)))
						(then
							(let choice (expressions.get parent))
							(let condition (expressions.get (struct:get choice first)))
							(let literal (struct:get condition kind))
							(if
								(:doc "An alternate arm is exclusive. A literal predicate can exclude an arm at the join.")
								(bool:or (call within_scope (nodes.get parent) site)
									(bool:or (bool:and then_arm (u32:eq literal 4u32))
										(bool:and (bool:not then_arm) (u32:eq literal 5u32))))
								(then (return (bool false))))))
					(set index parent)))
			(return (bool true))))
)
