(module scalar_trees
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Translate flattened compiler graph rows to their original source file views.")

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only (type ModuleRead)))
	(use wove-file "../emit/names.wove" (only module_identity source_identity))

	(struct ScalarTree
		(:doc "Keep a canonical file's packed tree range and its cached module name fingerprint.")
		(fields (base i32) (rows i32) (start i32) (end i32) (module_id u32)))

	(fn named_module_tree
		(:doc "Cache the path-to-module key on the canonical tree for functions, layouts, and static storage.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(module ModuleRead) (input SuppliedFile) (tree ScalarTree)) (returns ScalarTree)
		(body
			(let base (struct:get tree base))
			(let name (array:get nodes (i32:add base (struct:get module name))))
			(let path_key (call source_identity (borrow-shared arena)
				(struct:get input path_start) (struct:get input path_end)))
			(let key (call module_identity (borrow-shared arena) (struct:get name start) (struct:get name end) path_key))
			(return (struct:new ScalarTree (base base) (rows (struct:get tree rows))
				(start (struct:get tree start)) (end (struct:get tree end)) (module_id key)))))

	(fn tree_owner
		(:doc "Find the defining file of a rebased node, including a type in the other header provider.")
		(params (trees (shared-array ScalarTree)) (node i32)) (returns i32)
		(body
			(let-mut file 0i32)
			(while
				(:doc "Only active trees occupy ranges in the shared node table.")
				(i32:lt file (array:len trees))
				(body
					(let tree (array:get trees file))
					(let base (struct:get tree base))
					(if
						(:doc "Return the original owner before converting its row back to file-local form.")
						(bool:and (i32:not-lt node base)
							(i32:lt (i32:sub node base) (struct:get tree rows)))
						(then (return file)))
					(set file (i32:inc file))))
			(return -1i32)))

	(fn source_span_owner
		(:doc "Find the file containing an arena span, falling back to the diagnostic's known declaring file.")
		(params (files (shared-array SuppliedFile)) (start i32) (fallback i32)) (returns i32)
		(body
			(let-mut file 0i32)
			(while
				(:doc "Canonical files have disjoint byte ranges in the arena.")
				(i32:lt file (array:len files))
				(body
					(let row (array:get files file))
					(if
						(:doc "An alias row does not change the original source identity.")
						(bool:and (i32:eq (struct:get row identity) file)
							(bool:and (i32:not-lt start (struct:get row source_start))
								(i32:lt start (struct:get row source_end))))
						(then (return file)))
					(set file (i32:inc file))))
			(return fallback)))
)
