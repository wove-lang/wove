(module scalar_trees
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Translate flattened compiler graph rows to their original source file views.")

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only (type ModuleRead)))
	(use wove-file "../emit/names.wove" (only module_identity hash_spelling))

	(struct ScalarTree (fields (base i32) (rows i32) (start i32) (end i32)))

	(fn graph_module_key
		(:doc `Hash both the canonical path and the module name for emitted identities.`)
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(module ModuleRead) (input SuppliedFile) (base i32))
		(returns u32)
		(body
			(let name (array.load (local nodes) (i32.add (local base) (struct.get (local module) name))))
			(let path_key (call module_identity (borrow-shared (local arena))
				(struct.get (local input) path_start) (struct.get (local input) path_end)))
			(return (call hash_spelling (borrow-shared (local arena)) (struct.get (local name) start)
				(struct.get (local name) end) (local path_key)))))

	(fn tree_owner
		(:doc "Find the defining file of a rebased node, including a type in the other header provider.")
		(params (trees (shared-array ScalarTree)) (node i32)) (returns i32)
		(body
			(let-mut file 0i32)
			(while
				(:doc "Only active trees occupy ranges in the shared node table.")
				(i32.lt (local file) (array.len (local trees)))
				(body
					(let tree (array.load (local trees) (local file)))
					(let base (struct.get (local tree) base))
					(if
						(:doc "Return the original owner before converting its row back to file-local form.")
						(bool.and (bool.not (i32.lt (local node) (local base)))
							(i32.lt (i32.sub (local node) (local base)) (struct.get (local tree) rows)))
						(then (return (local file))))
					(set (local file) (i32.add (local file) 1i32))))
			(return -1i32)))

	(fn source_span_owner
		(:doc "Find the file containing an arena span, falling back to the diagnostic's known declaring file.")
		(params (files (shared-array SuppliedFile)) (start i32) (fallback i32)) (returns i32)
		(body
			(let-mut file 0i32)
			(while
				(:doc "Canonical files have disjoint byte ranges in the arena.")
				(i32.lt (local file) (array.len (local files)))
				(body
					(let row (array.load (local files) (local file)))
					(if
						(:doc "An alias row does not change the original source identity.")
						(bool.and (i32.eq (struct.get (local row) identity) (local file))
							(bool.and (bool.not (i32.lt (local start) (struct.get (local row) source_start)))
								(i32.lt (local start) (struct.get (local row) source_end))))
						(then (return (local file))))
					(set (local file) (i32.add (local file) 1i32))))
			(return (local fallback))))
)
