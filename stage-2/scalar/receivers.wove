(module scalar_receivers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Select canonical operation families from the static type of a receiver.")

	(use wove-file "./syntax.wove" (only array_operation record_operation scalar_receiver_operation
		owner_operation optional_operation native_vector_operation worker_operation
		(value native_cstrs_type) (value buffered_cstrs_type)))
	(use wove-file "./records.wove" (only is_array_owner is_readable_slice is_record_type
		is_fixed_array record_index record_receiver_type is_optional_record_borrow
		is_optional_buffered_record (type ScalarRecord)))
	(use wove-file "./owners.wove" (only is_optional_owner is_worker_owner is_nullable_worker_owner))
	(use wove-file "./native_owner_types.wove" (only is_native_owner))
	(use wove-file "../source/slice_options.wove" (only (value optional_view_type)))

	(fn receiver_value_operation
		(:doc "Resolve the complete suffix in the namespace selected by an exact receiver type.")
		(params (source (shared-array u8)) (start i32) (end i32) (type u32)
			(records (shared-array ScalarRecord)))
		(returns u32)
		(body
			(if
				(:doc "Array storage and views share the canonical array family.")
				(bool:or (call is_array_owner type)
					(bool:or (call is_readable_slice type)
						(bool:and (call is_record_type type)
							(call is_fixed_array (records.get (call record_index type))))))
				(then (return (call array_operation (borrow-shared source) start end))))
			(if
				(:doc "Native, optional, and worker owners can expose their nullable handle.")
				(bool:or (call is_native_owner type)
					(bool:or (call is_optional_owner type) (call is_nullable_worker_owner type)))
				(then
					(let owner (call owner_operation (borrow-shared source) start end))
					(if (u32:gtz owner) (then (return owner)))))
			(if
				(:doc "Owning and borrowed optionals can inspect or extract their payload in the canonical context.")
				(bool:or (call is_optional_owner type)
					(bool:or (u32:eq type optional_view_type)
						(bool:or (call is_optional_record_borrow type) (call is_optional_buffered_record type))))
				(then (return (call optional_operation (borrow-shared source) start end))))
			(if
				(:doc "Worker handles share the worker namespace and retain their exact canonical owner checks.")
				(call is_worker_owner type)
				(then (return (call worker_operation (borrow-shared source) start end))))
			(if
				(:doc "Native string vectors retain their own bounded descriptor operations.")
				(bool:or (u32:eq type native_cstrs_type) (u32:eq type buffered_cstrs_type))
				(then (return (call native_vector_operation (borrow-shared source) start end))))
			(if
				(:doc "A record value or reference selects the record namespace.")
				(call is_record_type (call record_receiver_type type))
				(then (return (call record_operation (borrow-shared source) start end))))
			(return (call scalar_receiver_operation (borrow-shared source) start end type)))))
