(module scalar_recoverable_growth
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the result contract for a recoverable push.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "./records.wove" (only is_record_type is_payload_enum value_type record_index member_value_type
		(type ScalarRecord) (type TypeScope)))

	(struct PushOutcome (fields (type u32) (rejected i32)))

	(fn read_push_outcome
		(:doc "Resolve an exact two-variant enum and encode which ordinal returns the rejected element.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (element u32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope TypeScope))
		(returns PushOutcome)
		(body
			(let invalid (struct.new PushOutcome (type 0u32) (rejected -1i32)))
			(let type (call value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings))
				(struct.get (local scope) file) (struct.get (local scope) source_base) (local index)))
			(if (bool.not (call is_record_type (local type))) (then (return (local invalid))))
			(let layout (array.load (local records) (call record_index (local type))))
			(if
				(:doc "The result has just one success and one rejection variant.")
				(bool.not (bool.and (call is_payload_enum (local layout)) (i32.eq (struct.get (local layout) count) 2i32)))
				(then (return (local invalid))))
			(let first (struct.get (local layout) first))
			(let second (struct.get (array.load (local nodes) (local first)) next_sibling))
			(let first_parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (array.load (local nodes) (local first))))
			(let second_parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (array.load (local nodes) (local second))))
			(let first_payload (i32.not-ltz (struct.get (local first_parts) operands)))
			(let second_payload (i32.not-ltz (struct.get (local second_parts) operands)))
			(if
				(:doc "Only one variant may carry the returned input.")
				(bool.or (bool.and (local first_payload) (local second_payload))
					(bool.not (bool.or (local first_payload) (local second_payload))))
				(then (return (local invalid))))
			(let-mut payload (local second))
			(let-mut rejected 1i32)
			(if
				(:doc "The payload variant may be declared first or second.")
				(local first_payload)
				(then
					(set (local payload) (local first))
					(set (local rejected) 0i32)))
			(let shape (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local records)) (borrow-shared (local bindings)) (local layout) (array.load (local nodes) (local payload))))
			(if (u32.not-eq (local shape) (local element)) (then (return (local invalid))))
			(return (struct.new PushOutcome (type (local type)) (rejected (local rejected))))))
)
