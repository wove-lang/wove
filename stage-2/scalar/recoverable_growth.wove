(module scalar_recoverable_growth
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the result contract for a recoverable push.")

	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "./records.wove" (only is_record_type is_payload_enum value_type record_index member_value_type
		(type ScalarRecord) (type TypeScope)))

	(struct PushOutcome (fields (type u32) (rejected i32)))

	(fn read_push_outcome
		(:doc "Resolve an exact two-variant enum and encode which ordinal returns the rejected element.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (index i32) (element u32)
			(records (shared-array ScalarRecord)) (bindings (shared-array GraphBinding)) (scope TypeScope))
		(returns PushOutcome)
		(body
			(let invalid (struct:new PushOutcome (type 0u32) (rejected -1i32)))
			(let type (call value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings)
				(struct:get scope file) (struct:get scope source_base) index))
			(if (bool:not (call is_record_type type)) (then (return invalid)))
			(let layout (array:get records (call record_index type)))
			(if
				(:doc "The result has just one success and one rejection variant.")
				(bool:not (bool:and (call is_payload_enum layout) (i32:eq (struct:get layout count) 2i32)))
				(then (return invalid)))
			(let first (struct:get layout first))
			(let second (struct:get (array:get nodes first) next_sibling))
			(let first_parts (call form_parts (borrow-shared source) (borrow-shared nodes) (array:get nodes first)))
			(let second_parts (call form_parts (borrow-shared source) (borrow-shared nodes) (array:get nodes second)))
			(let first_payload (i32:not-ltz (struct:get first_parts operands)))
			(let second_payload (i32:not-ltz (struct:get second_parts operands)))
			(if
				(:doc "Only one variant may carry the returned input.")
				(bool:or (bool:and first_payload second_payload)
					(bool:not (bool:or first_payload second_payload)))
				(then (return invalid)))
			(let-mut payload second)
			(let-mut rejected 1i32)
			(if
				(:doc "The payload variant may be declared first or second.")
				first_payload
				(then
					(set payload first)
					(set rejected 0i32)))
			(let shape (call member_value_type (borrow-shared source) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared bindings) layout (array:get nodes payload)))
			(if (u32:not-eq shape element) (then (return invalid)))
			(return (struct:new PushOutcome (type type) (rejected rejected)))))
)
