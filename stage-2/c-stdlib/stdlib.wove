(module c_stdlib
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge
		(:doc "Scalar calls, borrowed-text snapshots, and bounded in-place text mutation.")
		c "<stdlib.h>"
		(fn abs
			(:doc "Return the integer absolute value under C's range contract.")
			(params (value i32))
			(returns i32))
		(fn exit
			(:doc "Terminate the process using the C exit status.")
			(params (status i32))
			(returns void))
		(fn atexit
			(:doc "Run a process-lifetime callback during ordinary C exit.")
			(:pragma (c_callback callback))
			(params (callback (fn-type (params) (returns void))))
			(returns i32))

		(const EXIT_SUCCESS i32)
		(const EXIT_FAILURE i32)
		(const RAND_MAX i32)

		(disabled
			(:doc `	// Missing: a nullable pointer constant with an explicit native pointer contract.
	// const NULL: ...`))

		(disabled
			(:doc `	// Missing: C-native size_t and read-only runtime value declarations.
	// MB_CUR_MAX depends on the active locale; it is not a compile-time constant.
	// MB_CUR_MAX: size_t (evaluated at runtime)`))

		(fn getenv
			(:doc "C owns the returned environment storage; the result is copied immediately.")
			(:pragma (c_cstr name) (c_snapshot cstr))
			(params (name (shared-slice u8)))
			(returns (optional (owned-array u8))))

		(fn setenv
			(:doc "Set one environment variable using borrowed C text.")
			(:pragma (c_cstr name value))
			(params (name (shared-slice u8)) (value (shared-slice u8)) (overwrite i32))
			(returns i32))
		(fn unsetenv
			(:doc "Remove one environment variable using borrowed C text.")
			(:pragma (c_cstr name))
			(params (name (shared-slice u8)))
			(returns i32))

		(fn mkdtemp
			(:doc "Darwin declares this POSIX operation in unistd.h instead.")
			(:pragma (cfg (os "linux")) (c_cstr template) (c_snapshot cstr))
			(params (template (mut-slice u8)))
			(returns (optional (owned-array u8))))

		(fn realpath
			(:doc "Allocation mode only: copy the canonical path, free C storage, and preserve failure as null.")
			(:doc "Caller-provided output needs a capacity and conditional ownership contract before it is safe.")
			(:pragma (c_cstr path resolved) (c_null resolved) (c_snapshot cstr (drop free)))
			(params (path (shared-slice u8)) (resolved (mut-slice u8)))
			(returns (optional (owned-array u8))))

		(disabled
			(:doc `	// Missing: an optional end-pointer output that aliases the input text.
	// A native long double alias must retain the target format and C type identity.
	// fn strtold(text: const char *, end: char **) -> long double`))))
