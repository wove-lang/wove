(module c_sys_file
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/file.h>"
		(:doc "Advisory locks tied to the open file description.")
		(const LOCK_EX i32)
		(fn flock
			(:doc "Acquire the requested advisory lock on the supplied open description.")
			(params (descriptor i32) (operation i32))
			(returns i32))))
