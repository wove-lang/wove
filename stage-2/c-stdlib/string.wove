(module c_string
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<string.h>"
		(:doc "Copy the borrowed C error message into owned bytes.")
		(fn strerror
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(:pragma (c_snapshot cstr))
			(params (error i32))
			(returns (optional (owned-array u8))))))
