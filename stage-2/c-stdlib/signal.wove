(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	c_signal

	(bridge
		(:doc "C11 signals and POSIX scalar/set operations. Handler and retained-stack contracts wait below.")
		c "<signal.h>"
		(type Pid (c-type "pid_t"))
		(type Atomic (c-type "sig_atomic_t"))
		(type SignalSet (c-type "sigset_t"))

		(const SIGABRT i32)
		(const SIGFPE i32)
		(const SIGILL i32)
		(const SIGINT i32)
		(const SIGSEGV i32)
		(const SIGTERM i32)
		(fn
			(:doc "Raise the given signal in the calling process.")
			raise
			(params (signal i32))
			(returns i32))

		(const SIGHUP i32)
		(const SIGQUIT i32)
		(const SIGTRAP i32)
		(const SIGBUS i32)
		(const SIGKILL i32)
		(const SIGUSR1 i32)
		(const SIGUSR2 i32)
		(const SIGPIPE i32)
		(const SIGALRM i32)
		(const SIGCHLD i32)
		(const SIGCONT i32)
		(const SIGSTOP i32)
		(const SIGTSTP i32)
		(const SIGTTIN i32)
		(const SIGTTOU i32)
		(const SIGURG i32)
		(const SIGXCPU i32)
		(const SIGXFSZ i32)
		(const SIGVTALRM i32)
		(const SIGPROF i32)
		(const (:pragma (cfg (os "linux"))) SIGPOLL i32)
		(decls
			(:doc "Darwin's full header namespace exposes SIGEMT and SIGINFO.")
			(:pragma (cfg (os "macos")))
			(const SIGEMT i32)
			(const SIGINFO i32))
		(const SIGWINCH i32)
		(const SIG_BLOCK i32)
		(const SIG_UNBLOCK i32)
		(const SIG_SETMASK i32)
		(const CLD_EXITED i32)
		(const CLD_KILLED i32)
		(const CLD_DUMPED i32)
		(const CLD_TRAPPED i32)
		(const CLD_STOPPED i32)
		(const CLD_CONTINUED i32)

		(fn
			(:doc "Send the signal to the process identified by pid.")
			kill
			(params (pid Pid) (signal i32))
			(returns i32))
		(fn
			(:doc "Send the signal to the specified process group.")
			killpg
			(params (group Pid) (signal i32))
			(returns i32))
		(fn
			(:doc "Clear the caller's signal set.")
			sigemptyset
			(params (set (mut-ref SignalSet)))
			(returns i32))
		(fn
			(:doc "Fill the caller's signal set.")
			sigfillset
			(params (set (mut-ref SignalSet)))
			(returns i32))
		(fn
			(:doc "Add one signal to caller-owned set storage.")
			sigaddset
			(params (set (mut-ref SignalSet)) (signal i32))
			(returns i32))
		(fn
			(:doc "Remove one signal from caller-owned set storage.")
			sigdelset
			(params (set (mut-ref SignalSet)) (signal i32))
			(returns i32))
		(fn
			(:doc "Test membership in a borrowed signal set.")
			sigismember
			(params (set (shared-ref SignalSet)) (signal i32))
			(returns i32))
		(fn
			(:doc "Write pending signals to caller-owned set storage.")
			sigpending
			(params (set (mut-ref SignalSet)))
			(returns i32))
		(fn
			(:doc "Read or update the signal mask through nullable pointers.")
			(:pragma (c_nullable set previous))
			sigprocmask
			(params (how i32) (set (shared-ref SignalSet)) (previous (mut-ref SignalSet)))
			(returns i32))
		(fn
			(:doc "Read or update the calling thread's signal mask.")
			(:pragma (c_nullable set previous))
			pthread_sigmask
			(params (how i32) (set (shared-ref SignalSet)) (previous (mut-ref SignalSet)))
			(returns i32))
		(fn
			(:doc "Suspend with a temporary signal mask.")
			sigsuspend
			(params (set (shared-ref SignalSet)))
			(returns i32))
		(fn
			(:doc "Wait for the set and write the selected signal.")
			sigwait
			(params (set (shared-ref SignalSet)) (signal (mut-ref i32)))
			(returns i32))
		(fn
			(:doc "Print the signal description with an optional message.")
			(:pragma (c_cstr message) (c_nullable message))
			psignal
			(params (signal i32) (message (shared-slice u8)))
			(returns void))

		(disabled
			(:doc `	// Missing: function values/callbacks and function-pointer sentinel constants.
	// const SIG_DFL: Handler
	// const SIG_IGN: Handler
	// const SIG_ERR: Handler
	// fn signal(signal: i32, handler: Handler) -> Handler
	// fn bsd_signal(signal: i32, handler: Handler) -> Handler
	// fn sigset(signal: i32, handler: Handler) -> Handler`))

		(disabled
			(:doc `	// Missing: callback-bearing union fields and signal-action configuration contracts.
	// SA_NOCLDSTOP, SA_NOCLDWAIT, SA_NODEFER, SA_ONSTACK, SA_RESETHAND,
	// SA_RESTART and SA_SIGINFO accompany this record; some flag types differ by OS.
	// struct Action = struct sigaction { ... }
	// fn sigaction(signal: i32, action: &Action, previous: &mut Action) -> i32`))

		(disabled
			(:doc `	// Missing: memory retained until an alternate stack is disabled or the thread exits.
	// MINSIGSTKSZ/SIGSTKSZ may also be runtime expressions in the selected libc configuration.
	// const SS_ONSTACK: i32
	// const SS_DISABLE: i32
	// struct Stack = stack_t { ... }
	// fn sigaltstack(stack: &Stack, previous: &mut Stack) -> i32`))

		(disabled
			(:doc `	// Missing: union payloads, complete siginfo views, and queued/callback notification contracts.
	// The current child-status siginfo_t view belongs to the sys/wait bridge.
	// union Value = union sigval { ... }
	// struct Event = struct sigevent { ... }
	// fn sigqueue(pid: Pid, signal: i32, value: Value) -> i32
	// fn sigwaitinfo(set: &SignalSet, info: &mut SignalInfo) -> i32
	// fn sigtimedwait(set: &SignalSet, info: &mut SignalInfo, timeout: &Timespec) -> i32
	// SIGEV_NONE/SIGEV_SIGNAL/SIGEV_THREAD accompany Event; SIGRTMIN/SIGRTMAX may be runtime values.`))

		(disabled
			(:doc `	// Missing: explicit pthread handle contracts. No raw thread pointer is inferred.
	// fn pthread_kill(thread: Thread, signal: i32) -> i32`))

		(disabled
			(:doc `	// Deprecated XSI/BSD interfaces are not enabled in the default bridge.
	// fn sighold(signal: i32) -> i32
	// fn sigignore(signal: i32) -> i32
	// fn siginterrupt(signal: i32, interrupt: i32) -> i32
	// fn sigpause(signal: i32) -> i32
	// fn sigrelse(signal: i32) -> i32
	// fn sigblock(mask: i32) -> i32
	// fn sigsetmask(mask: i32) -> i32
	// fn sigvec(signal: i32, action: &Vector, previous: &mut Vector) -> i32`))))
