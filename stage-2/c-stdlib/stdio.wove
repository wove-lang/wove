(module c_stdio
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<stdio.h>"
		(:doc "C11 stdio contracts. Stream state/mode requirements remain those of the C interface.")
		(type (:pragma (c_owned (drop fclose))) File (c-type "FILE *"))
		(type Long (c-type "long"))
		(type Size (c-type "size_t"))
		(type Position (c-type "fpos_t"))
		(type Char (c-type "char"))

		(let
			(:doc "These streams belong to the C library and are borrowed, never closed by Wove.")
			stdin
			(shared-ref File))
		(let stdout (shared-ref File))
		(let stderr (shared-ref File))

		(const EOF i32)
		(const SEEK_SET i32)
		(const SEEK_CUR i32)
		(const SEEK_END i32)
		(const BUFSIZ i32)
		(const FOPEN_MAX i32)
		(const FILENAME_MAX i32)
		(const L_tmpnam i32)
		(const TMP_MAX i32)
		(const _IOFBF i32)
		(const _IOLBF i32)
		(const _IONBF i32)
		(disabled
			(:doc `	// Missing: a pointer constant contract. Wove uses null when comparing nullable owners.
	// const NULL: ...`))

		(fn remove
			(:doc "Remove the name identified by path.")
			(:pragma (c_cstr path))
			(params (path (shared-slice u8)))
			(returns i32))
		(fn rename
			(:doc "Rename a path with two call-scoped C strings.")
			(:pragma (c_cstr old_path new_path))
			(params (old_path (shared-slice u8)) (new_path (shared-slice u8)))
			(returns i32))
		(fn tmpfile (:doc "Open an owned temporary stream.") (params) (returns File))
		(disabled
			(:doc `	// Missing: a header-derived L_tmpnam extent for caller-provided storage.
	// Array contracts currently take decimal extents or count parameters.
	// fn tmpnam(buffer: char *) -> char *`))

		(fn fopen
			(:doc "Open an owned stream using the supplied path and mode.")
			(:pragma (c_cstr path mode))
			(params (path (shared-slice u8)) (mode (shared-slice u8)))
			(returns File))
		(fn freopen
			(:doc "Replace the supplied stream using the given mode.")
			(:pragma (c_cstr path mode) (c_nullable path))
			(params (path (shared-slice u8)) (mode (shared-slice u8)) (stream File))
			(returns File))
		(fn fclose (:doc "Consume and close the owned C stream.") (params (stream File)) (returns i32))
		(fn fflush
			(:doc "A null stream flushes all output streams, as specified by C.")
			(:pragma (c_nullable stream))
			(params (stream (shared-ref File)))
			(returns i32))

		(disabled
			(:doc `	// Missing: backing-buffer ownership retained until the stream is closed.
	// fn setbuf(stream: FILE *, buffer: char *)
	// fn setvbuf(stream: FILE *, buffer: char *, mode: i32, size: size_t) -> i32`))

		(fn fgetc
			(:doc "Read the next character or EOF from the borrowed stream.")
			(params (stream (shared-ref File)))
			(returns i32))
		(fn getc
			(:doc "Read the next character or EOF using the header entry.")
			(params (stream (shared-ref File)))
			(returns i32))
		(fn getchar (:doc "Read a character or EOF from standard input.") (params) (returns i32))
		(fn fputc
			(:doc "Write a character to the borrowed stream.")
			(params (ch i32) (stream (shared-ref File)))
			(returns i32))
		(fn putc
			(:doc "Write a character using the header entry.")
			(params (ch i32) (stream (shared-ref File)))
			(returns i32))
		(fn putchar (:doc "Write a character to standard output.") (params (ch i32)) (returns i32))
		(fn ungetc
			(:doc "Push one character back onto the input stream.")
			(params (ch i32) (stream (shared-ref File)))
			(returns i32))
		(fn fputs
			(:doc "Write NUL-terminated text to the borrowed stream.")
			(:pragma (c_cstr text))
			(params (text (shared-slice u8)) (stream (shared-ref File)))
			(returns i32))
		(fn puts
			(:doc "Write text and a newline to standard output.")
			(:pragma (c_cstr text))
			(params (text (shared-slice u8)))
			(returns i32))
		(fn fgets
			(:doc "C writes at most capacity Char elements, including the terminating NUL on success.")
			(:doc "Copy the aliased result immediately; the returned byte owner survives reuse of buffer.")
			(:pragma (c_array buffer capacity) (c_snapshot cstr))
			(params (buffer (mut-slice Char)) (capacity i32) (stream (shared-ref File)))
			(returns (optional (owned-array u8))))

		(fn fread
			(:doc "Read size times count bytes at most into a checked output view.")
			(:pragma (c_bytes output size count))
			(params
				(output (mut-slice u8))
				(size Size)
				(count Size)
				(stream (shared-ref File)))
			(returns Size))
		(fn fwrite
			(:doc "Write up to count elements from the checked input byte view.")
			(:pragma (c_bytes input size count))
			(params
				(input (shared-slice u8))
				(size Size)
				(count Size)
				(stream (shared-ref File)))
			(returns Size))

		(fn fgetpos
			(:doc "Write the C stream position into caller-owned storage.")
			(params (stream (shared-ref File)) (position (mut-ref Position)))
			(returns i32))
		(fn fsetpos
			(:doc "Restore a position supplied in the native fpos_t representation.")
			(params (stream (shared-ref File)) (position (shared-ref Position)))
			(returns i32))
		(fn fseek
			(:doc "Move the borrowed stream by a native long offset.")
			(params (stream (shared-ref File)) (offset Long) (origin i32))
			(returns i32))
		(fn ftell
			(:doc "Read the stream position as a native C long.")
			(params (stream (shared-ref File)))
			(returns Long))
		(fn rewind
			(:doc "Reposition the stream at its beginning.")
			(params (stream (shared-ref File)))
			(returns void))
		(fn clearerr
			(:doc "Clear the stream's end-of-file and error indicators.")
			(params (stream (shared-ref File)))
			(returns void))
		(fn feof
			(:doc "Read the stream's end-of-file indicator.")
			(params (stream (shared-ref File)))
			(returns i32))
		(fn ferror
			(:doc "Read the stream's error indicator.")
			(params (stream (shared-ref File)))
			(returns i32))
		(fn perror
			(:doc "Print an errno description with an optional message.")
			(:pragma (c_cstr message) (c_nullable message))
			(params (message (shared-slice u8)))
			(returns void))

		(fn fprintf
			(:doc "libc interprets the format and the caller supplies its native variadic values.")
			(:pragma (c_cstr_raw format) (c_variadic ...))
			(params (stream (shared-ref File)) (format (shared-slice u8)))
			(returns i32))
		(fn printf
			(:doc "Format native variadic values to standard output.")
			(:pragma (c_cstr_raw format) (c_variadic ...))
			(params (format (shared-slice u8)))
			(returns i32))
		(type LongLong (c-type "long long"))
		(type ULongLong (c-type "unsigned long long"))

		(disabled
			(:doc `	// Missing: formatting into a caller buffer and format-driven writable arguments.
	// fn sprintf(output: char *, format: const char *, ...) -> i32
	// fn snprintf(output: char *, capacity: size_t, format: const char *, ...) -> i32
	// fn fscanf(stream: FILE *, format: const char *, ...) -> i32
	// fn scanf(format: const char *, ...) -> i32
	// fn sscanf(input: const char *, format: const char *, ...) -> i32`))

		(disabled
			(:doc `	// Missing: va_list storage, va_copy/va_end lifetime rules, and format contracts.
	// fn vfprintf(stream: FILE *, format: const char *, args: va_list) -> i32
	// fn vprintf(format: const char *, args: va_list) -> i32
	// fn vsprintf(output: char *, format: const char *, args: va_list) -> i32
	// fn vsnprintf(output: char *, capacity: size_t, format: const char *, args: va_list) -> i32
	// fn vfscanf(stream: FILE *, format: const char *, args: va_list) -> i32
	// fn vscanf(format: const char *, args: va_list) -> i32
	// fn vsscanf(input: const char *, format: const char *, args: va_list) -> i32`))))
