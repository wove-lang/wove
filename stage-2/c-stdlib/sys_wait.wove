(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	c_sys_wait

	(bridge
		(:doc "POSIX wait interfaces. Status storage is borrowed for the call and stays with Wove.")
		c "<sys/wait.h>"
		(type Pid (c-type "pid_t"))
		(fn
			(:doc "Wait for a child with optional caller-owned status storage.")
			(:pragma (c_nullable status))
			wait
			(params (status (mut-ref i32)))
			(returns Pid))
		(fn
			(:doc "Wait for the selected child and optionally store its status.")
			(:pragma (c_nullable status))
			waitpid
			(params (pid Pid) (status (mut-ref i32)) (options i32))
			(returns Pid))

		(const WCONTINUED i32)
		(const WEXITED i32)
		(const WNOHANG i32)
		(const WNOWAIT i32)
		(const WSTOPPED i32)
		(const WUNTRACED i32)

		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WEXITSTATUS
			(params (status i32))
			(returns i32))
		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WIFCONTINUED
			(params (status i32))
			(returns bool))
		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WIFEXITED
			(params (status i32))
			(returns bool))
		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WIFSIGNALED
			(params (status i32))
			(returns bool))
		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WIFSTOPPED
			(params (status i32))
			(returns bool))
		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WSTOPSIG
			(params (status i32))
			(returns i32))
		(fn
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			WTERMSIG
			(params (status i32))
			(returns i32))

		(type Id (c-type "id_t"))
		(type Uid (c-type "uid_t"))
		(enum IdType (c-type "idtype_t") (members P_ALL P_PID P_PGID))
		(struct
			(:doc "Only the child-status view is exposed; other union views would overlap these fields.")
			SignalInfo
			(c-type "siginfo_t")
			(fields (si_signo i32) (si_errno i32) (si_code i32) (si_pid Pid) (si_uid Uid) (si_status i32)))
		(fn
			(:doc "Write the selected child's status to native siginfo_t storage.")
			waitid
			(params (kind IdType) (id Id) (info (mut-ref SignalInfo)) (options i32))
			(returns i32))

		(disabled
			(:doc `	// Missing: header feature selection for these optional/newer host interfaces.
	// #[c_macro] fn WCOREDUMP(status: i32) -> bool
	// #[c_macro] fn WCORE_DUMPED(status: i32) -> bool
	// type Usage = struct rusage
	// fn wait3(status: &mut i32, options: i32, usage: &mut Usage) -> Pid
	// fn wait4(pid: Pid, status: &mut i32, options: i32, usage: &mut Usage) -> Pid`))))
