	c_math

	(bridge
		(:doc "Declare real-math functions and macros with the selected C header's native ABI.")
		c "<math.h>"
		(type FloatEval (c-type "float_t"))
		(type DoubleEval (c-type "double_t"))
		(type LongDouble (c-type "long double"))
		(type Long (c-type "long"))
		(type LongLong (c-type "long long"))

		(const
			(:doc "Keep the header's classification and error values, which vary by implementation.")
			FP_INFINITE
			i32)
		(const FP_NAN i32)
		(const FP_NORMAL i32)
		(const FP_SUBNORMAL i32)
		(const FP_ZERO i32)
		(const FP_ILOGB0 i32)
		(const FP_ILOGBNAN i32)
		(const MATH_ERRNO i32)
		(const MATH_ERREXCEPT i32)

		(let
			(:doc "Preserve the native floating type and evaluate the error policy as a C expression.")
			(:pragma (c_macro))
			HUGE_VAL
			f64)
		(let (:pragma (c_macro)) HUGE_VALF f32)
		(let (:pragma (c_macro)) HUGE_VALL LongDouble)
		(let (:pragma (c_macro)) INFINITY f32)
		(let (:pragma (c_macro)) NAN f32)
		(let (:pragma (c_macro)) math_errhandling i32)

