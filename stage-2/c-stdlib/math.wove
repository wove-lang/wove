	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge
		(:doc "Declare real-math functions and macros with the selected C header's native ABI.")
		c-header "<math.h>"
		(type FloatEval (c-type "float_t"))
		(type DoubleEval (c-type "double_t"))
		(type LongDouble (c-type "long double"))
		(type Long (c-type "long"))
		(type LongLong (c-type "long long"))

		(const
			(:doc "Keep the header's classification and error values, which vary by implementation.")
			FP_INFINITE
			i32)
		(const FP_NAN i32)
		(const FP_NORMAL i32)
		(const FP_SUBNORMAL i32)
		(const FP_ZERO i32)
		(const FP_ILOGB0 i32)
		(const FP_ILOGBNAN i32)
		(const MATH_ERRNO i32)
		(const MATH_ERREXCEPT i32)

		(let
			(:doc "Preserve the native floating type and evaluate the error policy as a C expression.")
			(:pragma (c_macro))
			HUGE_VAL
			f64)
		(let (:pragma (c_macro)) HUGE_VALF f32)
		(let (:pragma (c_macro)) HUGE_VALL LongDouble)
		(let (:pragma (c_macro)) INFINITY f32)
		(let (:pragma (c_macro)) NAN f32)
		(let (:pragma (c_macro)) math_errhandling i32)

		(fn fpclassify
			(:doc "Each typed alias expands the same C macro with its declared operand width.")
			(:pragma (c_macro))
			(params (x f64))
			(returns i32))
		(fn fpclassifyf
			(:doc "Classify the value using the header's floating-point categories.")
			(:pragma (c_macro))
			(c-name "fpclassify")
			(params (x f32))
			(returns i32))
		(fn fpclassifyl
			(:doc "Classify the value using the header's floating-point categories.")
			(:pragma (c_macro))
			(c-name "fpclassify")
			(params (x LongDouble))
			(returns i32))
		(fn isfinite
			(:doc "Test whether the value is finite.")
			(:pragma (c_macro))
			(params (x f64))
			(returns bool))
		(fn isfinitef
			(:doc "Test whether the value is finite.")
			(:pragma (c_macro))
			(c-name "isfinite")
			(params (x f32))
			(returns bool))
		(fn isfinitel
			(:doc "Test whether the value is finite.")
			(:pragma (c_macro))
			(c-name "isfinite")
			(params (x LongDouble))
			(returns bool))
		(fn isinf
			(:doc "Test whether the value is infinite.")
			(:pragma (c_macro))
			(params (x f64))
			(returns bool))
		(fn isinff
			(:doc "Test whether the value is infinite.")
			(:pragma (c_macro))
			(c-name "isinf")
			(params (x f32))
			(returns bool))
		(fn isinfl
			(:doc "Test whether the value is infinite.")
			(:pragma (c_macro))
			(c-name "isinf")
			(params (x LongDouble))
			(returns bool))
		(fn isnan
			(:doc "Test whether the value is a NaN.")
			(:pragma (c_macro))
			(params (x f64))
			(returns bool))
		(fn isnanf
			(:doc "Test whether the value is a NaN.")
			(:pragma (c_macro))
			(c-name "isnan")
			(params (x f32))
			(returns bool))
		(fn isnanl
			(:doc "Test whether the value is a NaN.")
			(:pragma (c_macro))
			(c-name "isnan")
			(params (x LongDouble))
			(returns bool))
		(fn isnormal
			(:doc "Test whether the value is normal.")
			(:pragma (c_macro))
			(params (x f64))
			(returns bool))
		(fn isnormalf
			(:doc "Test whether the value is normal.")
			(:pragma (c_macro))
			(c-name "isnormal")
			(params (x f32))
			(returns bool))
		(fn isnormall
			(:doc "Test whether the value is normal.")
			(:pragma (c_macro))
			(c-name "isnormal")
			(params (x LongDouble))
			(returns bool))
		(fn signbit
			(:doc "Test the sign bit of the floating-point value.")
			(:pragma (c_macro))
			(params (x f64))
			(returns bool))
		(fn signbitf
			(:doc "Test the sign bit of the floating-point value.")
			(:pragma (c_macro))
			(c-name "signbit")
			(params (x f32))
			(returns bool))
		(fn signbitl
			(:doc "Test the sign bit of the floating-point value.")
			(:pragma (c_macro))
			(c-name "signbit")
			(params (x LongDouble))
			(returns bool))
