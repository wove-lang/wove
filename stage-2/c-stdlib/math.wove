		(fn exp2 (:doc "Raise two to the given power.") (params (x f64)) (returns f64))
		(fn exp2f (:doc "Raise two to the given power.") (params (x f32)) (returns f32))
		(fn exp2l (:doc "Raise two to the given power.") (params (x LongDouble)) (returns LongDouble))
		(fn expm1 (:doc "Compute the exponential minus one directly.") (params (x f64)) (returns f64))
		(fn expm1f (:doc "Compute the exponential minus one directly.") (params (x f32)) (returns f32))
		(fn expm1l
			(:doc "Compute the exponential minus one directly.")
			(params (x LongDouble))
			(returns LongDouble))
		(fn log (:doc "Compute the natural logarithm.") (params (x f64)) (returns f64))
