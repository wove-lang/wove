		(fn islessgreater
			(:doc "Test whether the operands are ordered and unequal.")
			(:pragma (c_macro))
			(params (x f64) (y f64))
			(returns bool))
		(fn islessgreaterf
			(:doc "Test whether the operands are ordered and unequal.")
			(:pragma (c_macro))
			(c-name "islessgreater")
			(params (x f32) (y f32))
			(returns bool))
		(fn islessgreaterl
			(:doc "Test whether the operands are ordered and unequal.")
			(:pragma (c_macro))
			(c-name "islessgreater")
			(params (x LongDouble) (y LongDouble))
			(returns bool))
		(fn isunordered
			(:doc "Test whether the operands are unordered.")
			(:pragma (c_macro))
			(params (x f64) (y f64))
			(returns bool))
		(fn isunorderedf
			(:doc "Test whether the operands are unordered.")
			(:pragma (c_macro))
			(c-name "isunordered")
			(params (x f32) (y f32))
			(returns bool))
		(fn isunorderedl
			(:doc "Test whether the operands are unordered.")
			(:pragma (c_macro))
			(c-name "isunordered")
			(params (x LongDouble) (y LongDouble))
			(returns bool))

		(fn acos (:doc "Circular trigonometry.") (params (x f64)) (returns f64))
		(fn acosf (:doc "Compute the inverse cosine.") (params (x f32)) (returns f32))
