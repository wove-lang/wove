			(:pragma (c_macro))
			(params (x f64) (y f64))
			(returns bool))
		(fn islessf
			(:doc "Test the ordered less-than relation.")
			(:pragma (c_macro))
			(c-name "isless")
			(params (x f32) (y f32))
