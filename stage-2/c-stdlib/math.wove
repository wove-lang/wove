		(fn islessl
			(:doc "Test the ordered less-than relation.")
			(:pragma (c_macro))
			(c-name "isless")
			(params (x LongDouble) (y LongDouble))
			(returns bool))
		(fn islessequal
			(:doc "Test the ordered less-than-or-equal relation.")
			(:pragma (c_macro))
			(params (x f64) (y f64))
			(returns bool))
		(fn islessequalf
			(:doc "Test the ordered less-than-or-equal relation.")
			(:pragma (c_macro))
			(c-name "islessequal")
			(params (x f32) (y f32))
			(returns bool))
		(fn islessequall
			(:doc "Test the ordered less-than-or-equal relation.")
			(:pragma (c_macro))
			(c-name "islessequal")
			(params (x LongDouble) (y LongDouble))
