			(:doc "Test the ordered greater-than relation.")
			(:pragma (c_macro))
			(c-name "isgreater")
			(params (x LongDouble) (y LongDouble))
			(returns bool))
		(fn isgreaterequal
			(:doc "Test the ordered greater-than-or-equal relation.")
			(:pragma (c_macro))
			(params (x f64) (y f64))
			(returns bool))
		(fn isgreaterequalf
			(:doc "Test the ordered greater-than-or-equal relation.")
			(:pragma (c_macro))
			(c-name "isgreaterequal")
			(params (x f32) (y f32))
			(returns bool))
		(fn isgreaterequall
			(:doc "Test the ordered greater-than-or-equal relation.")
			(:pragma (c_macro))
			(c-name "isgreaterequal")
			(params (x LongDouble) (y LongDouble))
			(returns bool))
