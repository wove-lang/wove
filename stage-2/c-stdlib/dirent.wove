(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	c_dirent

	(bridge
		(:doc "POSIX directory streams with target-specific native extensions.")
		c "<dirent.h>"
		(type (:pragma (c_owned (drop closedir))) Directory (c-type "DIR *"))
		(type DirectoryPosition (c-type "long"))

		(fn
			(:doc "Open a directory stream from a call-scoped path.")
			(:pragma (c_cstr path))
			opendir
			(params (path (shared-slice u8)))
			(returns Directory))
		(fn
			(:doc "A successful open transfers the descriptor to the directory stream.")
			fdopendir
			(params (fd i32))
			(returns Directory))
		(fn
			(:doc "Close the owned directory stream.")
			closedir
			(params (directory Directory))
			(returns i32))
		(fn
			(:doc "The descriptor belongs to the stream and remains valid until the stream closes.")
			dirfd
			(params (directory (shared-ref Directory)))
			(returns i32))
		(fn
			(:doc "Reset the directory stream to the beginning.")
			rewinddir
			(params (directory (mut-ref Directory)))
			(returns void))
		(fn
			(:doc "Restore a directory stream position.")
			seekdir
			(params (directory (mut-ref Directory)) (position DirectoryPosition))
			(returns void))
		(fn
			(:doc "Read the directory stream's native position.")
			telldir
			(params (directory (shared-ref Directory)))
			(returns DirectoryPosition))

		(fn
			(:doc "Copy the name before the stream can reuse its native entry storage.")
			(:pragma (c_snapshot cstr (field d_name)))
			readdir
			(params (directory (mut-ref Directory)))
			(returns (optional (owned-array u8))))

		(fn
			(:doc "Requires a glibc header with _LARGEFILE64_SOURCE or _GNU_SOURCE.")
			(:pragma (cfg (all (os "linux") (any dirent_largefile64 dirent_gnu))) (c_snapshot cstr (field d_name)))
			readdir64
			(params (directory (mut-ref Directory)))
			(returns (optional (owned-array u8))))

		(decls
			(:doc "Raw reads use the glibc size types on the supported 64-bit Linux targets.")
			(:pragma (cfg (all (os "linux") (any (arch "aarch64") (arch "x86_64")) (any dirent_gnu dirent_getdents64))))
			(type Size (c-type "size_t"))
			(type SignedSize (c-type "long")))
		(decls
			(:doc "The signature guards require off_t and off64_t to match C long.")
			(:pragma (cfg (all (os "linux") (any (arch "aarch64") (arch "x86_64")) dirent_gnu)))
			(type Char (c-type "char"))
			(type Offset (c-type "long"))
			(type Offset64 (c-type "long"))
			(fn
				(:doc "Pass the caller's mutable storage using the native pointee type.")
				(:pragma (c_array buffer count))
				getdirentries
				(params
					(fd i32)
					(buffer (mut-slice Char))
					(count Size)
					(base (mut-ref Offset)))
				(returns SignedSize))
			(fn
				(:doc "Pass the caller's mutable storage using the native pointee type.")
				(:pragma (c_array buffer count))
				getdirentries64
				(params
					(fd i32)
					(buffer (mut-slice Char))
					(count Size)
					(base (mut-ref Offset64)))
				(returns SignedSize)))
		(fn
			(:doc "glibc 2.30 added the public getdents64 symbol.")
			(:pragma (cfg (all (os "linux") (any (arch "aarch64") (arch "x86_64")) dirent_getdents64)) (c_bytes buffer count))
			getdents64
			(params (fd i32) (buffer (mut-slice u8)) (count Size))
			(returns SignedSize))

		(fn
			(:doc "macOS 26.4 and later can close the stream while transferring its descriptor back.")
			(:pragma (cfg (all (os "macos") dirent_fdclosedir (os_min 260400))))
			fdclosedir
			(params (directory Directory))
			(returns i32))

		(disabled
			(:doc `	// readdir_r and readdir64_r are deprecated. They require a native entry allocation
	// sized for the stream's name limit and a nullable result aliasing that allocation.
	// scandir, scandirat, fdscandir, scandir64, and scandirat64 need an owned vector
	// output and borrowed native-record filter and comparator parameters.
	// alphasort, alphasort64, versionsort, and versionsort64 take indirect entry borrows.
	// Darwin's scandir_b, scandirat_b, and fdscandir_b also require C Blocks callbacks.
	// Darwin's getdirentries cannot link with the current 64-bit inode ABI.`))))
