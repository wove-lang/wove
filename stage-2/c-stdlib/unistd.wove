(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	c_unistd

	(bridge
		(:doc "POSIX descriptors, process identity, and call-scoped byte/array operations.")
		c "<unistd.h>"
		(type Pid (c-type "pid_t"))
		(type Uid (c-type "uid_t"))
		(type Gid (c-type "gid_t"))
		(type Offset (c-type "off_t"))
		(type Size (c-type "size_t"))
		(type SignedSize (c-type "ssize_t"))
		(type Long (c-type "long"))

		(const STDIN_FILENO i32)
		(const STDOUT_FILENO i32)
		(const STDERR_FILENO i32)
		(const F_OK i32)
		(const R_OK i32)
		(const W_OK i32)
		(const X_OK i32)
		(const SEEK_SET i32)
		(const SEEK_CUR i32)
		(const SEEK_END i32)
		(const F_ULOCK i32)
		(const F_LOCK i32)
		(const F_TLOCK i32)
		(const F_TEST i32)

		(fn (:doc "Terminate without ordinary C exit handlers.") _exit (params (status i32)) (returns void))
		(fn (:doc "Create a process and retain the native pid_t result.") fork (params) (returns Pid))
		(fn (:doc "Read the current value using the native return type.") getpid (params) (returns Pid))
		(fn (:doc "Read the current value using the native return type.") getppid (params) (returns Pid))
		(fn (:doc "Read the current value using the native return type.") getpgrp (params) (returns Pid))
		(fn
			(:doc "Read the current value using the native return type.")
			getpgid
			(params (pid Pid))
			(returns Pid))
		(fn
			(:doc "Read the current value using the native return type.")
			getsid
			(params (pid Pid))
			(returns Pid))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setpgid
			(params (pid Pid) (group Pid))
			(returns i32))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setsid
			(params)
			(returns Pid))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			tcgetpgrp
			(params (fd i32))
			(returns Pid))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			tcsetpgrp
			(params (fd i32) (group Pid))
			(returns i32))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			pause
			(params)
			(returns i32))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			alarm
			(params (seconds u32))
			(returns u32))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			sleep
			(params (seconds u32))
			(returns u32))
		(fn (:doc "Read the current value using the native return type.") getuid (params) (returns Uid))
		(fn (:doc "Read the current value using the native return type.") geteuid (params) (returns Uid))
		(fn (:doc "Read the current value using the native return type.") getgid (params) (returns Gid))
		(fn (:doc "Read the current value using the native return type.") getegid (params) (returns Gid))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setuid
			(params (uid Uid))
			(returns i32))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			seteuid
			(params (uid Uid))
			(returns i32))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setreuid
			(params (real Uid) (effective Uid))
			(returns i32))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setgid
			(params (gid Gid))
			(returns i32))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setegid
			(params (gid Gid))
			(returns i32))
		(fn
			(:doc "Apply the requested setting and preserve the native result.")
			setregid
			(params (real Gid) (effective Gid))
			(returns i32))
		(fn
			(:doc "Pass the caller's mutable storage using the native pointee type.")
			(:pragma (c_array groups capacity))
			getgroups
			(params (capacity i32) (groups (mut-slice Gid)))
			(returns i32))

		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			close
			(params (fd i32))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			dup
			(params (fd i32))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			dup2
			(params (fd i32) (target i32))
			(returns i32))
		(fn
			(:doc "Write both descriptors to a checked two-element output view.")
			(:pragma (c_array descriptors 2))
			pipe
			(params (descriptors (mut-slice i32)))
			(returns i32))
		(fn
			(:doc "Read into the bounded output byte view.")
			(:pragma (c_bytes output count))
			read
			(params (fd i32) (output (mut-slice u8)) (count Size))
			(returns SignedSize))
		(fn
			(:doc "Write from the bounded input byte view.")
			(:pragma (c_bytes input count))
			write
			(params (fd i32) (input (shared-slice u8)) (count Size))
			(returns SignedSize))
		(fn
			(:doc "Read into bounded storage at a native file offset.")
			(:pragma (c_bytes output count))
			pread
			(params (fd i32) (output (mut-slice u8)) (count Size) (offset Offset))
			(returns SignedSize))
		(fn
			(:doc "Write bounded input at a native file offset.")
			(:pragma (c_bytes input count))
			pwrite
			(params (fd i32) (input (shared-slice u8)) (count Size) (offset Offset))
			(returns SignedSize))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			lseek
			(params (fd i32) (offset Offset) (origin i32))
			(returns Offset))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			fsync
			(params (fd i32))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			ftruncate
			(params (fd i32) (length Offset))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			lockf
			(params (fd i32) (command i32) (length Offset))
			(returns i32))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			sync
			(params)
			(returns void))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			isatty
			(params (fd i32))
			(returns i32))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			nice
			(params (increment i32))
			(returns i32))
		(fn (:doc "Read the current value using the native return type.") gethostid (params) (returns Long))

		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			access
			(params (path (shared-slice u8)) (mode i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			faccessat
			(params (fd i32) (path (shared-slice u8)) (mode i32) (flags i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			chdir
			(params (path (shared-slice u8)))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			fchdir
			(params (fd i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			chown
			(params (path (shared-slice u8)) (uid Uid) (gid Gid))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			lchown
			(params (path (shared-slice u8)) (uid Uid) (gid Gid))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			fchown
			(params (fd i32) (uid Uid) (gid Gid))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			fchownat
			(params (fd i32) (path (shared-slice u8)) (uid Uid) (gid Gid) (flags i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			truncate
			(params (path (shared-slice u8)) (length Offset))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr existing path))
			link
			(params (existing (shared-slice u8)) (path (shared-slice u8)))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr existing path))
			linkat
			(params
				(existing_fd i32)
				(existing (shared-slice u8))
				(fd i32)
				(path (shared-slice u8))
				(flags i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr target path))
			symlink
			(params (target (shared-slice u8)) (path (shared-slice u8)))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr target path))
			symlinkat
			(params (target (shared-slice u8)) (fd i32) (path (shared-slice u8)))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			unlink
			(params (path (shared-slice u8)))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			unlinkat
			(params (fd i32) (path (shared-slice u8)) (flags i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			rmdir
			(params (path (shared-slice u8)))
			(returns i32))

		(fn
			(:doc "Darwin's SDK places mkdtemp here; Linux follows stdlib.h.")
			(:pragma (cfg (os "macos")) (c_cstr template) (c_snapshot cstr))
			mkdtemp
			(params (template (mut-slice u8)))
			(returns (optional (owned-array u8))))

		(let-mut (:doc "These are live mutable C globals, not snapshots or builtins.") optind i32)
		(let-mut opterr i32)
		(let-mut optopt i32)

		(let
			(:doc "Explicit, read-only snapshots copy C-owned text into ordinary Wove owners.")
			(:pragma (c_snapshot cstrs))
			environ
			(owned-array (owned-array u8)))

		(fn
			(:doc "Configuration queries retain C long. Selectors are checked header values.")
			sysconf
			(params (name i32))
			(returns Long))
		(fn
			(:doc "Query a descriptor selector and preserve C long.")
			fpathconf
			(params (fd i32) (name i32))
			(returns Long))
		(fn
			(:doc "Query a path selector and preserve C long.")
			(:pragma (c_cstr path))
			pathconf
			(params (path (shared-slice u8)) (name i32))
			(returns Long))
		(const _SC_ARG_MAX i32)
		(const _SC_CHILD_MAX i32)
		(const _SC_CLK_TCK i32)
		(const _SC_NGROUPS_MAX i32)
		(const _SC_OPEN_MAX i32)
		(const _SC_NPROCESSORS_ONLN i32)
		(const _SC_PAGESIZE i32)
		(const _SC_VERSION i32)
		(const _PC_LINK_MAX i32)
		(const _PC_MAX_CANON i32)
		(const _PC_MAX_INPUT i32)
		(const _PC_NAME_MAX i32)
		(const _PC_PATH_MAX i32)
		(const _PC_PIPE_BUF i32)
		(const _PC_CHOWN_RESTRICTED i32)
		(const _PC_NO_TRUNC i32)
		(const _PC_VDISABLE i32)

		(fn
			(:doc "Darwin does not declare fdatasync. GNU extensions need header feature selection too.")
			(:pragma (cfg (os "linux")))
			fdatasync
			(params (fd i32))
			(returns i32))

		(fn
			(:doc "Copied, terminated vectors survive until failure returns or exec replaces this process.")
			(:pragma (c_cstr path) (c_cstrs arguments))
			execv
			(params (path (shared-slice u8)) (arguments (shared-slice (owned-array u8))))
			(returns i32))
		(fn
			(:doc "Keep native argument vectors alive until replacement or failure.")
			(:pragma (c_cstr path) (c_cstrs arguments environment))
			execve
			(params
				(path (shared-slice u8))
				(arguments (shared-slice (owned-array u8)))
				(environment (shared-slice (owned-array u8))))
			(returns i32))
		(fn
			(:doc "Keep native argument vectors alive until replacement or failure.")
			(:pragma (c_cstr file) (c_cstrs arguments))
			execvp
			(params (file (shared-slice u8)) (arguments (shared-slice (owned-array u8))))
			(returns i32))
		(fn
			(:doc "Keep native argument vectors alive until replacement or failure.")
			(:pragma (cfg (os "linux")) (c_cstrs arguments environment))
			fexecve
			(params
				(fd i32)
				(arguments (shared-slice (owned-array u8)))
				(environment (shared-slice (owned-array u8))))
			(returns i32))
		(disabled (:doc "\t// execl/execle/execlp need variable-length typed text tails and a terminating null contract."))

		(disabled
			(:doc `	// Missing: char storage views, returned aliases, termination, and text ownership.
	// getcwd, getlogin/getlogin_r, ttyname/ttyname_r, gethostname, readlink/readlinkat,
	// confstr, ctermid, crypt, encrypt, and swab need contracts beyond void byte storage.
	// getopt may retain/reorder the argument vector; optarg aliases its text.
	// static optarg: char *
	// fn getopt(argc: i32, argv: char *const *, options: const char *) -> i32`))

		(disabled
			(:doc `	// Missing: feature/header availability selection for the complete _POSIX_*, _XOPEN_*,
	// _SC_*, _PC_* and _CS_* catalogs. The portable selectors used above are explicit.
	// vfork needs shared-address-space control-flow rules; it cannot use fork's contract.
	// Removed/deprecated setpgrp, ualarm/usleep, getwd, getpagesize/getdtablesize,
	// getpass, brk/sbrk, and host extensions stay outside this default POSIX surface.`))))
