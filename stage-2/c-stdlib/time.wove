(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	c_time

	(bridge
		(:doc "Read the POSIX monotonic clock using the header's native types.")
		c "<time.h>"
		(enum Clock (c-type "clockid_t") (members CLOCK_MONOTONIC))
		(type Time (c-type "time_t"))
		(type Long (c-type "long"))
		(struct
			Stamp
			(c-type "struct timespec")
			(fields (tv_sec Time) (tv_nsec Long)))
		(fn
			(:doc "Store the reading in a caller-owned timespec.")
			clock_gettime
			(params (clock Clock) (stamp (mut-ref Stamp)))
			(returns i32))))
