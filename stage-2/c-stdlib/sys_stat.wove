(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	c_sys_stat

	(bridge
		(:doc "POSIX metadata and permissions retain the header's native scalar identities.")
		c "<sys/stat.h>"
		(type Device (c-type "dev_t"))
		(type Inode (c-type "ino_t"))
		(type Mode (c-type "mode_t"))
		(type Links (c-type "nlink_t"))
		(type Uid (c-type "uid_t"))
		(type Gid (c-type "gid_t"))
		(type Offset (c-type "off_t"))
		(type Blocks (c-type "blkcnt_t"))
		(type BlockSize (c-type "blksize_t"))
		(type Time (c-type "time_t"))
		(type Long (c-type "long"))
		(struct
			Timespec
			(c-type "struct timespec")
			(fields (tv_sec Time) (tv_nsec Long)))

		(struct
			(:doc "Both views preserve the entire C object, including padding and private members.")
			(:doc "Timestamp member names differ between the supported platform headers.")
			(:pragma (cfg (os "linux")))
			Stat
			(c-type "struct stat")
			(fields
				(st_dev Device)
				(st_ino Inode)
				(st_mode Mode)
				(st_nlink Links)
				(st_uid Uid)
				(st_gid Gid)
				(st_rdev Device)
				(st_size Offset)
				(st_blksize BlockSize)
				(st_blocks Blocks)
				(st_atim Timespec)
				(st_mtim Timespec)
				(st_ctim Timespec)))
		(struct
			(:doc "st_lspare and st_qspare are reserved by the header, not application state.")
			(:pragma (cfg (os "macos")))
			Stat
			(c-type "struct stat")
			(fields
				(st_dev Device)
				(st_ino Inode)
				(st_mode Mode)
				(st_nlink Links)
				(st_uid Uid)
				(st_gid Gid)
				(st_rdev Device)
				(st_size Offset)
				(st_blksize BlockSize)
				(st_blocks Blocks)
				(st_atimespec Timespec)
				(st_mtimespec Timespec)
				(st_ctimespec Timespec)
				(st_birthtimespec Timespec)
				(st_flags u32)
				(st_gen u32)))
		(disabled (:doc "\t// st_atime/st_mtime/st_ctime are C aliases overlapping the timestamp views above."))

		(fn
			(:doc "Read path metadata into the target's native stat object.")
			(:pragma (c_cstr path))
			stat
			(params (path (shared-slice u8)) (info (mut-ref Stat)))
			(returns i32))
		(fn
			(:doc "Read descriptor metadata into the target's native stat object.")
			fstat
			(params (fd i32) (info (mut-ref Stat)))
			(returns i32))
		(fn
			(:doc "Read metadata without following the final symbolic link.")
			(:pragma (c_cstr path))
			lstat
			(params (path (shared-slice u8)) (info (mut-ref Stat)))
			(returns i32))
		(fn
			(:doc "Read metadata relative to the directory descriptor.")
			(:pragma (c_cstr path))
			fstatat
			(params (fd i32) (path (shared-slice u8)) (info (mut-ref Stat)) (flags i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			chmod
			(params (path (shared-slice u8)) (mode Mode))
			(returns i32))
		(fn
			(:doc "Use the supplied descriptor and preserve the C result.")
			fchmod
			(params (fd i32) (mode Mode))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			fchmodat
			(params (fd i32) (path (shared-slice u8)) (mode Mode) (flags i32))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			mkdir
			(params (path (shared-slice u8)) (mode Mode))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			mkdirat
			(params (fd i32) (path (shared-slice u8)) (mode Mode))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			mkfifo
			(params (path (shared-slice u8)) (mode Mode))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			mkfifoat
			(params (fd i32) (path (shared-slice u8)) (mode Mode))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			mknod
			(params (path (shared-slice u8)) (mode Mode) (device Device))
			(returns i32))
		(fn
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			mknodat
			(params (fd i32) (path (shared-slice u8)) (mode Mode) (device Device))
			(returns i32))
		(fn
			(:doc "Preserve the result and side effects of the header's native declaration.")
			umask
			(params (mode Mode))
			(returns Mode))

		(const S_IFMT i32)
		(const S_IFBLK i32)
		(const S_IFCHR i32)
		(const S_IFDIR i32)
		(const S_IFIFO i32)
		(const S_IFLNK i32)
		(const S_IFREG i32)
		(const S_IFSOCK i32)
		(const S_ISUID i32)
		(const S_ISGID i32)
		(const S_ISVTX i32)
		(const S_IRWXU i32)
		(const S_IRUSR i32)
		(const S_IWUSR i32)
		(const S_IXUSR i32)
		(const S_IRWXG i32)
		(const S_IRGRP i32)
		(const S_IWGRP i32)
		(const S_IXGRP i32)
		(const S_IRWXO i32)
		(const S_IROTH i32)
		(const S_IWOTH i32)
		(const S_IXOTH i32)
		(decls
			(:doc "Linux exposes these timestamp controls as 64-bit values.")
			(:pragma (cfg (os "linux")))
			(const UTIME_NOW i64)
			(const UTIME_OMIT i64))
		(decls
			(:doc "Darwin exposes these timestamp controls as 32-bit values.")
			(:pragma (cfg (os "macos")))
			(const UTIME_NOW i32)
			(const UTIME_OMIT i32))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISBLK
			(params (mode Mode))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISCHR
			(params (mode Mode))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISDIR
			(params (mode Mode))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISFIFO
			(params (mode Mode))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISLNK
			(params (mode Mode))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISREG
			(params (mode Mode))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_ISSOCK
			(params (mode Mode))
			(returns bool))

		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_TYPEISMQ
			(params (info (shared-ref Stat)))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_TYPEISSEM
			(params (info (shared-ref Stat)))
			(returns bool))
		(fn
			(:doc "Use the target header's file-kind predicate.")
			(:pragma (c_macro))
			S_TYPEISSHM
			(params (info (shared-ref Stat)))
			(returns bool))
		(fn
			(:doc "Update descriptor timestamps from an optional pair of native timespec values.")
			(:pragma (c_array times 2) (c_nullable times))
			futimens
			(params (fd i32) (times (shared-slice Timespec)))
			(returns i32))
		(fn
			(:doc "Update path timestamps from an optional pair of native timespec values.")
			(:pragma (c_cstr path) (c_array times 2) (c_nullable times))
			utimensat
			(params
				(fd i32)
				(path (shared-slice u8))
				(times (shared-slice Timespec))
				(flags i32))
			(returns i32))
		(disabled (:doc "\t// Host extensions such as statx, filesec_t, and chflags need separate platform contracts."))))
