(module c_errno
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge
		(:doc "C11's full errno interface. The error indicator is a writable lvalue, often a macro.")
		c-header "<errno.h>"
		(let-mut errno i32)
		(const EDOM i32)
		(const EILSEQ i32)
		(const ERANGE i32)

		(decls
			(:doc "POSIX errors used by the compiler and its tests on the supported host platforms.")
			(:pragma (cfg (any (os "linux") (os "macos"))))
			(const EBADF i32)
			(const EINTR i32)
			(const ENOENT i32)
			(const ENOTDIR i32)
			(const ECHILD i32)
			(const EALREADY i32)
			(const EINVAL i32)
			(const ENOMEM i32))))
