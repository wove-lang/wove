(module c_spawn
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<spawn.h>"
		(:doc "POSIX spawn owns its action/attribute objects and copies retained action paths.")
		(type Pid (c-type "pid_t"))
		(type Mode (c-type "mode_t"))
		(type Short (c-type "short"))
		(type SignalSet (c-type "sigset_t"))
		(type
			(:pragma (c_owned (drop posix_spawn_file_actions_destroy) storage))
			Actions
			(c-type "posix_spawn_file_actions_t"))
		(type
			(:pragma (c_owned (drop posix_spawnattr_destroy) storage))
			Attributes
			(c-type "posix_spawnattr_t"))

		(fn posix_spawn_file_actions_init
			(:doc "Initialize the owned native storage on success.")
			(:pragma (c_init actions))
			(params (actions (mut-ref Actions)))
			(returns i32))
		(fn posix_spawn_file_actions_destroy
			(:doc "Transfer the owned native object to its C destructor.")
			(params (actions Actions))
			(returns i32))
		(fn posix_spawn_file_actions_addclose
			(:doc "Append this action to the caller's owned spawn action list.")
			(params (actions (mut-ref Actions)) (fd i32))
			(returns i32))
		(fn posix_spawn_file_actions_adddup2
			(:doc "Append this action to the caller's owned spawn action list.")
			(params (actions (mut-ref Actions)) (fd i32) (target i32))
			(returns i32))
		(fn posix_spawn_file_actions_addopen
			(:doc "Append this action to the caller's owned spawn action list.")
			(:pragma (c_cstr path))
			(params
				(actions (mut-ref Actions))
				(fd i32)
				(path (shared-array u8))
				(flags i32)
				(mode Mode))
			(returns i32))

		(fn posix_spawnattr_init
			(:doc "Initialize the owned native storage on success.")
			(:pragma (c_init attributes))
			(params (attributes (mut-ref Attributes)))
			(returns i32))
		(fn posix_spawnattr_destroy
			(:doc "Transfer the owned native object to its C destructor.")
			(params (attributes Attributes))
			(returns i32))
		(fn posix_spawnattr_getflags
			(:doc "Read the requested spawn attribute into caller-owned native storage.")
			(params (attributes (shared-ref Attributes)) (flags (mut-ref Short)))
			(returns i32))
		(fn posix_spawnattr_setflags
			(:doc "Update the owned spawn attributes through the native representation.")
			(params (attributes (mut-ref Attributes)) (flags Short))
			(returns i32))
		(fn posix_spawnattr_getpgroup
			(:doc "Read the requested spawn attribute into caller-owned native storage.")
			(params (attributes (shared-ref Attributes)) (group (mut-ref Pid)))
			(returns i32))
		(fn posix_spawnattr_setpgroup
			(:doc "Update the owned spawn attributes through the native representation.")
			(params (attributes (mut-ref Attributes)) (group Pid))
			(returns i32))
		(fn posix_spawnattr_getsigdefault
			(:doc "Read the requested spawn attribute into caller-owned native storage.")
			(params (attributes (shared-ref Attributes)) (signals (mut-ref SignalSet)))
			(returns i32))
		(fn posix_spawnattr_setsigdefault
			(:doc "Update the owned spawn attributes through the native representation.")
			(params (attributes (mut-ref Attributes)) (signals (shared-ref SignalSet)))
			(returns i32))
		(fn posix_spawnattr_getsigmask
			(:doc "Read the requested spawn attribute into caller-owned native storage.")
			(params (attributes (shared-ref Attributes)) (signals (mut-ref SignalSet)))
			(returns i32))
		(fn posix_spawnattr_setsigmask
			(:doc "Update the owned spawn attributes through the native representation.")
			(params (attributes (mut-ref Attributes)) (signals (shared-ref SignalSet)))
			(returns i32))
		(const POSIX_SPAWN_RESETIDS i32)
		(const POSIX_SPAWN_SETPGROUP i32)
		(const POSIX_SPAWN_SETSIGDEF i32)
		(const POSIX_SPAWN_SETSIGMASK i32)

		(fn posix_spawn
			(:doc "Spawn a process using call-scoped, terminated argument and environment vectors.")
			(:pragma (c_cstr path) (c_cstrs arguments environment) (c_nullable actions attributes))
			(params
				(pid (mut-ref Pid))
				(path (shared-array u8))
				(actions (shared-ref Actions))
				(attributes (shared-ref Attributes))
				(arguments (shared-array (owned-array u8)))
				(environment (shared-array (owned-array u8))))
			(returns i32))
		(fn posix_spawnp
			(:doc "Spawn a process using call-scoped, terminated argument and environment vectors.")
			(:pragma (c_cstr file) (c_cstrs arguments environment) (c_nullable actions attributes))
			(params
				(pid (mut-ref Pid))
				(file (shared-array u8))
				(actions (shared-ref Actions))
				(attributes (shared-ref Attributes))
				(arguments (shared-array (owned-array u8)))
				(environment (shared-array (owned-array u8))))
			(returns i32))

		(decls
			(:doc "Darwin explicitly disables POSIX priority-scheduling spawn attributes.")
			(:pragma (cfg (os "linux")))
			(struct
				Scheduling
				(c-type "struct sched_param")
				(fields (sched_priority i32)))
			(const POSIX_SPAWN_SETSCHEDPARAM i32)
			(const POSIX_SPAWN_SETSCHEDULER i32)
			(fn posix_spawnattr_getschedparam
				(:doc "Read the requested spawn attribute into caller-owned native storage.")
				(params
					(attributes (shared-ref Attributes))
					(scheduling (mut-ref Scheduling)))
				(returns i32))
			(fn posix_spawnattr_setschedparam
				(:doc "Update the owned spawn attributes through the native representation.")
				(params
					(attributes (mut-ref Attributes))
					(scheduling (shared-ref Scheduling)))
				(returns i32))
			(fn posix_spawnattr_getschedpolicy
				(:doc "Read the requested spawn attribute into caller-owned native storage.")
				(params (attributes (shared-ref Attributes)) (policy (mut-ref i32)))
				(returns i32))
			(fn posix_spawnattr_setschedpolicy
				(:doc "Update the owned spawn attributes through the native representation.")
				(params (attributes (mut-ref Attributes)) (policy i32))
				(returns i32)))

		(disabled
			(:doc `	// Missing: header/libc availability selection for newer POSIX and host extensions.
	// posix_spawn_file_actions_addchdir/addfchdir require newer Darwin SDKs/libc releases.
	// addchdir_np/addfchdir_np/addclosefrom_np/addinherit_np and POSIX_SPAWN_SETSID/USEVFORK
	// depend on the selected platform's feature namespace and availability.
	// Darwin architecture/Mach-port preferences additionally need native architecture/port
	// types, typed output arrays, and contracts for retained exception-port configurations.`))))
