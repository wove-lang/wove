(module driver_int256_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Compile and link the archived C23 capability probe with the selected toolchain.")

	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "../c/probe.wove" (only probe_options_complete))
	(use wove-file "../io/process.wove" (only run_process_capture_merged))
	(use wove-file "../io/temporary.wove" (only create_temporary_directory))
	(use wove-file "../io/write.wove" (only write_new_file))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use c-header "<unistd.h>" (only access X_OK unlink rmdir))
	(use c-header "<sys/stat.h>" (only lstat S_ISREG (type Stat)))

	(let int256_unavailable 89u32)
	(let int256_probe_failed 90u32)
	(let dialect_prefix "-std=")
	(let c23_option "-std=c23")
	(let directory_suffix "/wove-int256.XXXXXX")
	(let source_suffix "/wide_integer.c")
	(let control_suffix "/control.c")
	(let image_suffix "/linked")
	(let control_source "int main(void) { return 0; }\n")
	(let output_flag "-o\u0000")
	(let probe_sinks "-MJ\u0000/dev/null\u0000-Xclang\u0000-dependency-file\u0000-Xclang\u0000/dev/null\u0000-Xclang\u0000-MT\u0000-Xclang\u0000wove-int256\u0000-Xclang\u0000-dependency-dot\u0000-Xclang\u0000/dev/null\u0000-Xclang\u0000-header-include-file\u0000-Xclang\u0000/dev/null\u0000")

	(fn selected_c23
		(:doc "Read the last standard argument from the packed options shared with the real compiler.")
		(params (options (shared-array u8))) (returns bool)
		(body
			(let-mut end (i32.dec (array.len options)))
			(let width (array.len dialect_prefix))
			(while
				(:doc "Both the resolved driver and frontend standard follow caller overrides.")
				(i32.not-ltz end)
				(body
					(let-mut start end)
					(while
						(:doc "Stop at the terminator of the preceding option.")
						(bool.and (i32.gtz start) (u8.not-eqz (array.load options (i32.dec start))))
						(body (set start (i32.dec start))))
					(if
						(:doc "An exact standard argument determines whether the build can use C23 syntax.")
						(bool.and (i32.not-lt (i32.sub end start) width)
							(call same_bytes (borrow-shared options) start (i32.add start width)
								(borrow-shared dialect_prefix) 0i32 width))
						(then (return (call same_bytes (borrow-shared options) start end
							(borrow-shared c23_option) 0i32 (array.len c23_option)))))
					(set end (i32.dec start))))
			(return (bool false))))

	(fn probe_path
		(:doc "Give each compiler operand an exact filename inside the reserved directory.")
		(params (directory (shared-array u8)) (suffix (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut path (array.alloc u8 (i32.add (array.len directory) (array.len suffix))))
			(let start (call append_bytes (borrow-shared directory) (borrow-mut path) 0i32))
			(let end (call append_bytes (borrow-shared suffix) (borrow-mut path) start))
			(return (move path))))

	(fn link_probe
		(:doc "Use the effective Clang options and require a real executable output before accepting the link.")
		(params (program (shared-array u8)) (options (shared-array u8))
			(libraries (shared-array u8)) (path (shared-array u8)) (image (shared-array u8)))
		(returns i32)
		(body
			(let files (u64.add (u64.from-i32 (array.len path)) (u64.from-i32 (array.len image))))
			(let flags (i32.add (array.len output_flag) (array.len probe_sinks)))
			(let option_size (u64.add (u64.from-i32 (array.len options)) (u64.from-i32 (array.len libraries))))
			(let width (u64.add (u64.add files option_size)
				(u64.from-i32 (i32.add flags 2i32))))
			(if (u64.lt 2147483647u64 width) (then (return -1i32)))
			(let-mut arguments (array.alloc u8 (i32.from-u64 width)))
			(let input (call append_bytes (borrow-shared path) (borrow-mut arguments) 0i32))
			(let settings (call append_bytes (borrow-shared options) (borrow-mut arguments) (i32.inc input)))
			(let libraries_end (call append_bytes (borrow-shared libraries) (borrow-mut arguments) settings))
			(let sinks (call append_bytes (borrow-shared probe_sinks) (borrow-mut arguments) libraries_end))
			(let output (call append_bytes (borrow-shared output_flag) (borrow-mut arguments) sinks))
			(let end (call append_bytes (borrow-shared image) (borrow-mut arguments) output))
			(let-mut capture (array.alloc u8 16384i32))
			(let result (call run_process_capture_merged (borrow-shared program)
				(borrow-shared arguments) (borrow-mut capture)))
			(let status (struct.get result status))
			(if
				(:doc "A child failure returns its exit status for the control link.")
				(i32.not-eqz status)
				(then (return status)))
			(let-mut info (struct.new Stat))
			(if
				(:doc "A frontend-only invocation or missing image cannot establish link capability.")
				(bool.and (i32.eqz (call lstat (borrow-shared image) (borrow-mut info)))
					(bool.and (call S_ISREG (struct.get info st_mode))
						(i32.eqz (call access (borrow-shared image) X_OK))))
				(then (return 0i32)))
			(return -1i32)))

	(fn classify_link
		(:doc "Separate unsupported wide operations from an unusable compiler or linker invocation.")
		(params (options (shared-array u8)) (libraries (shared-array u8)) (source (shared-array u8)) (control (shared-array u8))
			(image (shared-array u8))) (returns u32)
		(body
			(let program (call clang_program))
			(let status (call link_probe (borrow-shared program) (borrow-shared options) (borrow-shared libraries)
				(borrow-shared source) (borrow-shared image)))
			(if (i32.eqz status) (then (return 0u32)))
			(if
				(:doc "A normal Clang rejection can indicate a missing capability only if the same tool can link ordinary C.")
				(bool.and (i32.eq status 1i32)
					(call write_new_file (borrow-shared control) (borrow-shared control_source)))
				(then
					(let removed (call unlink (borrow-shared image)))
					(let fallback (call link_probe (borrow-shared program) (borrow-shared options) (borrow-shared libraries)
						(borrow-shared control) (borrow-shared image)))
					(if (i32.eqz fallback) (then (return int256_unavailable)))))
			(return int256_probe_failed)))

	(fn probe_int256
		(:doc "Probe only C23 and keep the control, probe source and linked image in a private directory.")
		(params (options (shared-array u8)) (libraries (shared-array u8))) (returns u32)
		(body
			(if (bool.not (call probe_options_complete (borrow-shared options)))
				(then (return int256_probe_failed)))
			(if (bool.not (call selected_c23 (borrow-shared options)))
				(then (return int256_unavailable)))
			(if (bool.not (call probe_options_complete (borrow-shared libraries)))
				(then (return int256_probe_failed)))
			(let directory (call create_temporary_directory (borrow-shared directory_suffix)))
			(if (i32.eqz (array.len directory)) (then (return int256_probe_failed)))
			(let source (call probe_path (borrow-shared directory) (borrow-shared source_suffix)))
			(let control (call probe_path (borrow-shared directory) (borrow-shared control_suffix)))
			(let image (call probe_path (borrow-shared directory) (borrow-shared image_suffix)))
			(let archive_probe (embed "../../runtime/probes/wide_integer.c"))
			(let-mut result int256_probe_failed)
			(if
				(:doc "Only invoke Clang after the complete archived source has been staged.")
				(call write_new_file (borrow-shared source) (borrow-shared archive_probe))
				(then (set result (call classify_link (borrow-shared options) (borrow-shared libraries) (borrow-shared source)
					(borrow-shared control) (borrow-shared image)))))
			(let removed_image (call unlink (borrow-shared image)))
			(let removed_control (call unlink (borrow-shared control)))
			(let removed_source (call unlink (borrow-shared source)))
			(let removed_directory (call rmdir (borrow-shared directory)))
			(return result)))
)
