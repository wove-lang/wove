(module native_cli_diagnostics
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Write native command failures using one structured diagnostic record and the selected renderer.`)

	(use wove-file "../source/enum_forms.wove" (only (value non_exhaustive_match)))
	(use wove-file "../diagnostics/record.wove" (only diagnostic_argv diagnostic_source (type Diagnostic)))
	(use wove-file "../diagnostics/json.wove" (only write_diagnostic_json))
	(use wove-file "../diagnostics/human.wove" (only render_diagnostic_human))
	(use wove-file "../io/stdio.wove" (only write_stderr_line))

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let project_file "wovec.jsonc")
	(let invalid_arguments "invalid command arguments")
	(let invalid_config "invalid project configuration")
	(let invalid_source "invalid Wove source")
	(let incomplete_match "non-exhaustive enum match")
	(let unreadable_file "could not read file")
	(let publish_failure "could not publish retained C")
	(let explicit_target_required "cc requires one explicit source and an explicit output target")
	(let non_utf8_source "source operand must be UTF-8")
	(let invalid_target "invalid output target")
	(let unreadable_asset "could not read embedded asset")

	(fn write_report
		(:doc "Keep the diagnostic failure status and distinguish a failed stderr write.")
		(params (bytes (shared-array u8))) (returns i32)
		(body
			(if
				(:doc "The renderer returns an empty result when its capacity cannot be represented.")
				(i32.eq (array.len (local bytes)) 0i32)
				(then (return 1i32)))
			(if
				(:doc "A stream error has its own command exit status.")
				(bool.not (call write_stderr_line (borrow-shared (local bytes))))
				(then (return 2i32)))
			(return 1i32)))

	(fn report_diagnostic
		(:doc "Render the same structured record in the selected format and write a complete stderr message.")
		(params (diagnostic Diagnostic) (message (shared-array u8)) (file (shared-array u8))
			(source (shared-array u8)) (available bool) (human bool)) (returns i32)
		(body
			(if
				(:doc "The human renderer interprets the original source span in the existing bytes.")
				(local human)
				(then
					(let output (call render_diagnostic_human (local diagnostic) (borrow-shared (local message))
						(borrow-shared (local file)) (borrow-shared (local source)) (local available)))
					(return (call write_report (borrow-shared (local output))))))
			(let width (u64.add (u64.from-i32 (array.len (local file)))
				(u64.from-i32 (array.len (local message)))))
			(let twice (u64.add (local width) (local width)))
			(let capacity (u64.add 128u64
				(u64.add (u64.add (local twice) (local twice)) (local twice))))
			(if
				(:doc "The escaped path and message plus JSON structure must fit the output slice.")
				(u64.lt 2147483647u64 (local capacity))
				(then (return 1i32)))
			(let-mut output (array.alloc u8 (i32.from-u64 (local capacity))))
			(let-mut stack (array.alloc u8 2i32))
			(let result (call write_diagnostic_json (local diagnostic)
				(borrow-shared (local message)) (borrow-shared (local file))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "Write a diagnostic only after the JSON writer completes it.")
				(u32.eq (struct.get (local result) error) 0u32)
				(then (return (call write_report (borrow-shared (array.range (local output) 0i32 (struct.get (local result) written)))))))
			(return 1i32)))

	(fn report_argv
		(:doc `Report an argv failure at the resolver's zero-based position.`)
		(params (code u32) (index i32) (message (shared-array u8)) (human bool))
		(returns i32)
		(body
			(let no_file (array.alloc u8 0i32))
			(return (call report_diagnostic (call diagnostic_argv (local code) (local index))
				(borrow-shared (local message)) (borrow-shared (local no_file))
				(borrow-shared (local no_file)) (bool false) (local human)))))

	(fn report_located
		(:doc "Report the original half-open byte span and use available source bytes in the human view.")
		(params (file (shared-array u8)) (code u32) (start i32) (end i32) (message (shared-array u8))
			(source (shared-array u8)) (available bool) (human bool)) (returns i32)
		(body
			(let diagnostic (call diagnostic_source (local code) (local start) (local end)))
			(if
				(:doc "Every source path uses the same message for incomplete enum coverage.")
				(u32.eq (local code) (local non_exhaustive_match))
				(then (return (call report_diagnostic (local diagnostic)
					(borrow-shared (local incomplete_match)) (borrow-shared (local file))
					(borrow-shared (local source)) (local available) (local human)))))
			(return (call report_diagnostic (local diagnostic) (borrow-shared (local message)) (borrow-shared (local file))
				(borrow-shared (local source)) (local available) (local human)))))

	(fn report_source
		(:doc "Report a source failure against the exact bytes already checked by the driver.")
		(params (file (shared-array u8)) (code u32) (start i32) (end i32) (message (shared-array u8))
			(source (shared-array u8)) (human bool)) (returns i32)
		(body (return (call report_located (borrow-shared (local file)) (local code) (local start) (local end)
			(borrow-shared (local message)) (borrow-shared (local source)) (bool true) (local human)))))

	(fn report_file
		(:doc "Keep the file location when source bytes are unavailable or the message refers to the whole path.")
		(params (file (shared-array u8)) (code u32) (start i32) (end i32) (message (shared-array u8)) (human bool)) (returns i32)
		(body
			(let absent (array.alloc u8 0i32))
			(return (call report_located (borrow-shared (local file)) (local code) (local start) (local end)
				(borrow-shared (local message)) (borrow-shared (local absent)) (bool false) (local human)))))

	(fn report_path_location
		(:doc `Display paths under the current directory relative to it when the entry was relative.`)
		(params (provider (shared-array u8)) (cwd (shared-array u8)) (error u32) (start i32) (end i32) (message (shared-array u8))
			(source (shared-array u8)) (available bool) (human bool))
		(returns i32)
		(body
			(let width (array.len (local cwd)))
			(if
				(:doc "Trim only a complete directory prefix and keep unrelated or bundled paths unchanged.")
				(bool.and (bool.and (i32.lt 0i32 (local width)) (i32.lt (local width) (array.len (local provider))))
					(bool.and (call same_bytes (borrow-shared (local provider)) 0i32 (local width)
						(borrow-shared (local cwd)) 0i32 (local width))
						(bool.or (i32.eq (local width) 1i32) (u8.eq (array.load (local provider) (local width)) 47u8))))
				(then
					(let-mut relative (local width))
					(if
						(:doc "Skip the separating slash unless the directory is already the filesystem root.")
						(i32.lt 1i32 (local width))
						(then (set (local relative) (i32.add (local width) 1i32))))
					(return (call report_located (borrow-shared (array.range (local provider) (local relative) (array.len (local provider))))
						(local error) (local start) (local end) (borrow-shared (local message))
						(borrow-shared (local source)) (local available) (local human)))))
			(return (call report_located (borrow-shared (local provider)) (local error) (local start) (local end) (borrow-shared (local message))
				(borrow-shared (local source)) (local available) (local human)))))
)
