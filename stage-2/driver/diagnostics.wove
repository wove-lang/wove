(module native_cli_diagnostics
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Map native command failures to the shared JSON diagnostic format and write one stderr record.`)

	(use wove-file "../diagnostics/record.wove" (only diagnostic_argv diagnostic_source (type Diagnostic)))
	(use wove-file "../diagnostics/json.wove" (only write_diagnostic_json))
	(use wove-file "../io/stdio.wove" (only write_stderr_line))

	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let project_file "wovec.jsonc")
	(let invalid_arguments "invalid command arguments")
	(let invalid_config "invalid project configuration")
	(let invalid_source "invalid Wove source")
	(let unreadable_file "could not read file")
	(let publish_failure "could not publish retained C")
	(let explicit_target_required "cc requires one explicit source and an explicit output target")
	(let non_utf8_source "source operand must be UTF-8")
	(let invalid_target "invalid output target")
	(let unreadable_asset "could not read embedded asset")

	(fn report_diagnostic
		(:doc `Size the output for worst-case JSON escaping and print only the serialized prefix.`)
		(params (diagnostic Diagnostic) (message (shared-slice u8)) (file (shared-slice u8)))
		(returns i32)
		(body
			(let width (u64.add.wrapping (int.convert u64 (slice.len (local file)))
				(int.convert u64 (slice.len (local message)))))
			(let twice (u64.add.wrapping (local width) (local width)))
			(let capacity (u64.add.wrapping 128u64
				(u64.add.wrapping (u64.add.wrapping (local twice) (local twice)) (local twice))))
			(if
				(:doc "The escaped path and message plus JSON structure must fit the output slice.")
				(u64.lt 2147483647u64 (local capacity))
				(then (return 1i32)))
			(let-mut output (array.alloc u8 (int.convert i32 (local capacity))))
			(let-mut stack (array.alloc u8 2i32))
			(let result (call write_diagnostic_json (local diagnostic)
				(borrow-shared (local message)) (borrow-shared (local file))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(if
				(:doc "Write a diagnostic only after the JSON writer completes it.")
				(u32.eq (struct.get (local result) error) 0u32)
				(then
					(let written (struct.get (local result) written))
					(if
						(:doc "A stream error has its own command exit status.")
						(bool.not (call write_stderr_line (borrow-shared (slice.range (local output) 0i32 (local written)))))
						(then (return 2i32)))))
			(return 1i32)))

	(fn report_argv
		(:doc `Report an argv failure at the resolver's zero-based position.`)
		(params (code u32) (index i32) (message (shared-slice u8)))
		(returns i32)
		(body
			(let no_file (array.alloc u8 0i32))
			(return (call report_diagnostic (call diagnostic_argv (local code) (local index))
				(borrow-shared (local message)) (borrow-shared (local no_file))))))

	(fn report_source
		(:doc `Report a source failure with its path and original byte span.`)
		(params (file (shared-slice u8)) (code u32) (start i32) (end i32) (message (shared-slice u8)))
		(returns i32)
		(body (return (call report_diagnostic (call diagnostic_source (local code) (local start) (local end))
			(borrow-shared (local message)) (borrow-shared (local file))))))

	(fn report_path_location
		(:doc `Display paths under the current directory relative to it when the entry was relative.`)
		(params (provider (shared-slice u8)) (cwd (shared-slice u8)) (error u32) (start i32) (end i32) (message (shared-slice u8)))
		(returns i32)
		(body
			(let width (slice.len (local cwd)))
			(if
				(:doc "Trim only a complete directory prefix and keep unrelated or bundled paths unchanged.")
				(bool.and (bool.and (i32.lt 0i32 (local width)) (i32.lt (local width) (slice.len (local provider))))
					(bool.and (call same_bytes (borrow-shared (local provider)) 0i32 (local width)
						(borrow-shared (local cwd)) 0i32 (local width))
						(bool.or (i32.eq (local width) 1i32) (u8.eq (slice.load (local provider) (local width)) 47u8))))
				(then
					(let-mut relative (local width))
					(if
						(:doc "Skip the separating slash unless the directory is already the filesystem root.")
						(i32.lt 1i32 (local width))
						(then (set (local relative) (i32.add.wrapping (local width) 1i32))))
					(return (call report_source (borrow-shared (slice.range (local provider) (local relative) (slice.len (local provider))))
						(local error) (local start) (local end) (borrow-shared (local message))))))
			(return (call report_source (borrow-shared (local provider)) (local error) (local start) (local end) (borrow-shared (local message))))))

	(fn report_project
		(:doc `Report a JSONC or file error against the current project configuration name.`)
		(params (code u32) (start i32) (end i32) (message (shared-slice u8)))
		(returns i32)
		(body (return (call report_source (borrow-shared (local project_file))
			(local code) (local start) (local end) (borrow-shared (local message)))))))
