(module native_cli_assets
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Load selected embeds into the native compiler's source arena.

	Measure asset extents before allocation. Keep the source at the start
	of the arena so existing source-tree offsets and diagnostics stay valid.`)

	(use wove-file "../source/assets.wove" (only decode_asset_path embed_check (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./files.wove" (only file_stamp read_file_range))

	(fn copy_source_prefix
		(:doc `Preserve the complete original source at byte zero before appending asset bytes.`)
		(params (source (shared-slice u8)) (arena (mut-slice u8)))
		(returns void)
		(body
			(let copied (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (i32 0)))))

	(fn asset_unavailable
		(:doc `Point file errors at the original quoted path, in the defining source.`)
		(params (asset EmbedAsset) (file i32))
		(returns EmbedCheck)
		(body
			(return (call embed_check (i32 0) (local file)
				(record.get (local asset) path_start) (record.get (local asset) path_end) (u32 67)))))

	(fn asset_owner
		(:doc `Locate an original quoted asset path in the graph's immutable file ranges.`)
		(params (files (shared-slice SuppliedFile)) (asset EmbedAsset)) (returns i32)
		(body
			(let-mut index (i32 1))
			(while
				(:doc "The caller provides the canonical entry path for requests in row zero.")
				(i32.lt (local index) (slice.len (local files)))
				(body
					(let file (slice.load (local files) (local index)))
					(if
						(:doc "A complete token belongs to exactly one supplied source view.")
						(bool.and (bool.not (i32.lt (record.get (local asset) path_start) (record.get (local file) source_start)))
							(bool.not (i32.lt (record.get (local file) source_end) (record.get (local asset) path_end))))
						(then (return (local index))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (i32 0))))

	(fn asset_io
		(:doc `Measure or fill a checked asset view relative to its particular module.`)
		(params (module (shared-slice u8)) (path (shared-slice u8)) (asset EmbedAsset)
			(arena (mut-slice u8)) (writing bool)) (returns i32)
		(body
			(let joined (call join_file_path (borrow-shared (local module)) (borrow-shared (local path))))
			(let stamp (call file_stamp (borrow-shared (local joined))))
			(let length (record.get (local stamp) length))
			(if
				(:doc "Only a regular file with a measured extent can supply asset bytes.")
				(i32.lt (local length) (i32 0))
				(then (return (i32 -1))))
			(if
				(:doc "The writing pass fills only the range reserved by measurement.")
				(local writing)
				(then
					(if
						(:doc "A changed or unreadable file fails at the original asset request.")
						(bool.not (call read_file_range (borrow-shared (local joined)) (local stamp) (borrow-mut (local arena))
							(record.get (local asset) bytes_start) (record.get (local asset) bytes_end)))
						(then (return (i32 -1))))
					(return (i32 0))))
			(return (local length))))

	(fn load_input_assets
		(:doc `Apply selected assets in a single source without other provider paths.`)
		(params (module (shared-slice u8)) (source (shared-slice u8)) (assets (mut-slice EmbedAsset))
			(arena (mut-slice u8)) (writing bool)) (returns EmbedCheck)
		(body
			(let files (array.alloc SuppliedFile (i32 0)))
			(return (call load_graph_assets (borrow-shared (local module)) (borrow-shared (local source))
				(borrow-shared (local files)) (borrow-mut (local assets)) (borrow-mut (local arena)) (local writing)))))

	(fn load_graph_assets
		(:doc `Record asset ranges during measurement or load them into the reserved arena during writing.`)
		(params (module (shared-slice u8)) (source (shared-slice u8)) (files (shared-slice SuppliedFile)) (assets (mut-slice EmbedAsset))
			(arena (mut-slice u8)) (writing bool))
		(returns EmbedCheck)
		(body
			(let-mut total (slice.len (local source)))
			(let-mut index (i32 0))
			(while
				(:doc "Only initialized request rows have a literal path span.")
				(i32.lt (local index) (slice.len (local assets)))
				(body
					(let asset (slice.load (local assets) (local index)))
					(let end (record.get (local asset) path_end))
					(if
						(:doc "Read a checked request relative to the source that defined it.")
						(i32.lt (i32 0) (local end))
						(then
							(let origin (call asset_owner (borrow-shared (local files)) (local asset)))
							(let start (record.get (local asset) path_start))
							(let-mut path (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
							(let length (call decode_asset_path (borrow-shared (local source)) (local start) (local end)
								(borrow-mut (local path))))
							(if
								(:doc "Reject malformed path values before the host string conversion.")
								(i32.lt (local length) (i32 0))
								(then (return (call asset_unavailable (local asset) (local origin)))))
							(let-mut result (i32 -1))
							(if
								(:doc "Source spans identify an imported module's own canonical base directory.")
								(i32.lt (i32 0) (local origin))
								(then
									(let file (slice.load (local files) (local origin)))
									(set (local result) (call asset_io
										(borrow-shared (slice.range (local source) (record.get (local file) path_start) (record.get (local file) path_end)))
										(borrow-shared (slice.range (local path) (i32 0) (local length)))
										(local asset) (borrow-mut (local arena)) (local writing))))
								(else
									(set (local result) (call asset_io (borrow-shared (local module))
										(borrow-shared (slice.range (local path) (i32 0) (local length)))
										(local asset) (borrow-mut (local arena)) (local writing)))))
							(if
								(:doc "A missing, changed, or oversized asset cannot extend the arena.")
								(bool.or (i32.lt (local result) (i32 0))
									(i32.lt (i32.sub.wrapping (i32 2147483647) (local total)) (local result)))
								(then (return (call asset_unavailable (local asset) (local origin)))))
							(if
								(:doc "Only measurement publishes the byte ranges the writing pass will fill.")
								(bool.not (local writing))
								(then
									(let finish (i32.add.wrapping (local total) (local result)))
									(slice.store (local assets) (local index)
										(record.make EmbedAsset (path_start (local start)) (path_end (local end))
											(bytes_start (local total)) (bytes_end (local finish))))
									(set (local total) (local finish))))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (call embed_check (local total) (i32 0) (i32 0) (i32 0) (u32 0))))))
