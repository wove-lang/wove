(module native_cli_assets
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Load selected embeds into the native compiler's source arena.

	Measure asset extents before allocation. Keep the source at the start
	of the arena so existing source-tree offsets and diagnostics stay valid.`)

	(use wove-file "../source/assets.wove" (only decode_asset_path embed_check (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use (:pragma (cfg (not bootstrap))) wove-file "./paths.wove" (only join_file_path))
	(use (:pragma (cfg (not bootstrap))) wove-file "./files.wove" (only file_stamp read_file_range))
	(use (:pragma (cfg bootstrap)) wove-file "./paths.wove" (only write_file_path))
	(use (:pragma (cfg bootstrap)) wove-file "./bootstrap/files.wove" (only measure_file read_file_range))

	(fn copy_source_prefix
		(:doc `Preserve the complete original source at byte zero before appending asset bytes.`)
		(:pragma (cfg (not bootstrap)))
		(params (source (shared-array u8)) (arena (mut-array u8)))
		(returns void)
		(body
			(let copied (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) 0i32))))

	(fn asset_unavailable
		(:doc `Point file errors at the original quoted path, in the defining source.`)
		(params (asset EmbedAsset) (file i32))
		(returns EmbedCheck)
		(body
			(return (call embed_check 0i32 (local file)
				(struct.get (local asset) path_start) (struct.get (local asset) path_end) 67u32))))

	(fn asset_owner
		(:doc `Locate an original quoted asset path in the graph's immutable file ranges.`)
		(params (files (shared-array SuppliedFile)) (asset EmbedAsset)) (returns i32)
		(body
			(let-mut index 1i32)
			(while
				(:doc "The caller provides the canonical entry path for requests in row zero.")
				(i32.lt (local index) (array.len (local files)))
				(body
					(let file (array.load (local files) (local index)))
					(if
						(:doc "A complete token belongs to exactly one supplied source view.")
						(bool.and (i32.not-lt (struct.get (local asset) path_start) (struct.get (local file) source_start))
							(i32.not-lt (struct.get (local file) source_end) (struct.get (local asset) path_end)))
						(then (return (local index))))
					(set (local index) (i32.add (local index) 1i32))))
			(return 0i32)))

	(fn asset_io
		(:doc `Measure or fill a checked asset view relative to its particular module.`)
		(:pragma (cfg (not bootstrap)))
		(params (module (shared-array u8)) (path (shared-array u8)) (asset EmbedAsset)
			(arena (mut-array u8)) (writing bool)) (returns i32)
		(body
			(let joined (call join_file_path (borrow-shared (local module)) (borrow-shared (local path))))
			(let stamp (call file_stamp (borrow-shared (local joined))))
			(let length (struct.get (local stamp) length))
			(if
				(:doc "Only a regular file with a measured extent can supply asset bytes.")
				(i32.lt (local length) 0i32)
				(then (return -1i32)))
			(if
				(:doc "The writing pass fills only the range reserved by measurement.")
				(local writing)
				(then
					(if
						(:doc "A changed or unreadable file fails at the original asset request.")
						(bool.not (call read_file_range (borrow-shared (local joined)) (local stamp) (borrow-mut (local arena))
							(struct.get (local asset) bytes_start) (struct.get (local asset) bytes_end)))
						(then (return -1i32)))
					(return 0i32)))
			(return (local length))))

	(fn asset_io
		(:doc `Use the Bootstrap runtime to measure or fill the same checked asset request.`)
		(:pragma (cfg bootstrap))
		(params (module (shared-array u8)) (path (shared-array u8)) (asset EmbedAsset)
			(arena (mut-array u8)) (writing bool)) (returns i32)
		(body
			(let-mut empty (array.alloc u8 0i32))
			(let width (call write_file_path (borrow-shared (local module)) (borrow-shared (local path))
				(borrow-mut (local empty))))
			(if (i32.lt (local width) 0i32) (then (return -1i32)))
			(let-mut joined (array.alloc u8 (local width)))
			(let end (call write_file_path (borrow-shared (local module)) (borrow-shared (local path))
				(borrow-mut (local joined))))
			(if
				(:doc `Read only inside the arena range reserved by the measurement pass.`)
				(local writing)
				(then
					(if
						(:doc `Publish the measured asset range only after the complete read succeeds.`)
						(call read_file_range (borrow-shared (array.range (local joined) 0i32 (local end)))
							(struct.get (local asset) bytes_start) (struct.get (local asset) bytes_end)
							(borrow-mut (local arena)))
						(then (return 0i32)))
					(return -1i32)))
			(return (call measure_file (borrow-shared (array.range (local joined) 0i32 (local end)))))))

	(fn load_input_assets
		(:doc `Apply selected assets in a single source without other provider paths.`)
		(params (module (shared-array u8)) (source (shared-array u8)) (assets (mut-array EmbedAsset))
			(arena (mut-array u8)) (writing bool)) (returns EmbedCheck)
		(body
			(let files (array.alloc SuppliedFile 0i32))
			(return (call load_graph_assets (borrow-shared (local module)) (borrow-shared (local source))
				(borrow-shared (local files)) (borrow-mut (local assets)) (borrow-mut (local arena)) (local writing)))))

	(fn load_graph_assets
		(:doc `Record asset ranges during measurement or load them into the reserved arena during writing.`)
		(params (module (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile)) (assets (mut-array EmbedAsset))
			(arena (mut-array u8)) (writing bool))
		(returns EmbedCheck)
		(body
			(let-mut total (array.len (local source)))
			(let-mut index 0i32)
			(while
				(:doc "Only initialized request rows have a literal path span.")
				(i32.lt (local index) (array.len (local assets)))
				(body
					(let asset (array.load (local assets) (local index)))
					(let end (struct.get (local asset) path_end))
					(if
						(:doc "Read a checked request relative to the source that defined it.")
						(i32.lt 0i32 (local end))
						(then
							(let origin (call asset_owner (borrow-shared (local files)) (local asset)))
							(let start (struct.get (local asset) path_start))
							(let-mut path (array.alloc u8 (i32.sub (local end) (local start))))
							(let length (call decode_asset_path (borrow-shared (local source)) (local start) (local end)
								(borrow-mut (local path))))
							(if
								(:doc "Reject malformed path values before the host string conversion.")
								(i32.lt (local length) 0i32)
								(then (return (call asset_unavailable (local asset) (local origin)))))
							(let-mut result -1i32)
							(if
								(:doc "Source spans identify an imported module's own canonical base directory.")
								(i32.lt 0i32 (local origin))
								(then
									(let file (array.load (local files) (local origin)))
									(set (local result) (call asset_io
										(borrow-shared (array.range (local source) (struct.get (local file) path_start) (struct.get (local file) path_end)))
										(borrow-shared (array.range (local path) 0i32 (local length)))
										(local asset) (borrow-mut (local arena)) (local writing))))
								(else
									(set (local result) (call asset_io (borrow-shared (local module))
										(borrow-shared (array.range (local path) 0i32 (local length)))
										(local asset) (borrow-mut (local arena)) (local writing)))))
							(if
								(:doc "A missing, changed, or oversized asset cannot extend the arena.")
								(bool.or (i32.lt (local result) 0i32)
									(i32.lt (i32.sub 2147483647i32 (local total)) (local result)))
								(then (return (call asset_unavailable (local asset) (local origin)))))
							(if
								(:doc "Only measurement publishes the byte ranges the writing pass will fill.")
								(bool.not (local writing))
								(then
									(let finish (i32.add (local total) (local result)))
									(array.store (local assets) (local index)
										(struct.new EmbedAsset (path_start (local start)) (path_end (local end))
											(bytes_start (local total)) (bytes_end (local finish))))
									(set (local total) (local finish))))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (call embed_check (local total) 0i32 0i32 0i32 0u32)))))
