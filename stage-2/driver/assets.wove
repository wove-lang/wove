(module native_cli_assets
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Load selected embeds into the native compiler's source arena.

	Measure asset extents before allocation. Keep the source at the start
	of the arena so existing source-tree offsets and diagnostics stay valid.`)

	(use wove-file "../source/assets.wove" (only decode_asset_path embed_check (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./files.wove" (only file_stamp read_file_range))
	(use wove-file "./paths.wove" (only write_file_path))

	(fn asset_unavailable
		(:doc `Point file errors at the original quoted path, in the defining source.`)
		(params (asset EmbedAsset) (file i32))
		(returns EmbedCheck)
		(body
			(return (call embed_check 0i32 file
				asset/path_start asset/path_end 67u32))))

	(fn asset_owner
		(:doc `Locate an original quoted asset path in the graph's immutable file ranges.`)
		(params (files (shared-array SuppliedFile)) (asset EmbedAsset)) (returns i32)
		(body
			(let-mut index 1i32)
			(while
				(:doc "The caller provides the canonical entry path for requests in row zero.")
				(index.lt files.len)
				(body
					(let file (files.get index))
					(if
						(:doc "A complete token belongs to exactly one supplied source view.")
						(bool:and (asset/path_start.not-lt file/source_start)
							(file/source_end.not-lt asset/path_end))
						(then (return index)))
					(set index index.inc)))
			(return 0i32)))

	(fn asset_io
		(:doc `Measure or fill a checked asset view relative to its particular module.`)
		(params (module (shared-array u8)) (path (shared-array u8)) (asset EmbedAsset)
			(arena (mut-array u8)) (writing bool)) (returns i32)
		(body
			(let joined (call join_file_path (borrow-shared module) (borrow-shared path)))
			(let stamp (call file_stamp (borrow-shared joined)))
			(let length stamp/length)
			(if
				(:doc "Only a regular file with a measured extent can supply asset bytes.")
				length.ltz
				(then (return -1i32)))
			(if
				(:doc "The writing pass fills only the range reserved by measurement.")
				writing
				(then
					(if
						(:doc "A changed or unreadable file fails at the original asset request.")
						(bool:not (call read_file_range (borrow-shared joined) stamp (borrow-mut arena)
							asset/bytes_start asset/bytes_end))
						(then (return -1i32)))
					(return 0i32)))
			(return length)))

	(fn load_input_assets
		(:doc `Apply selected assets in a single source without other provider paths.`)
		(params (module (shared-array u8)) (source (shared-array u8)) (assets (mut-array EmbedAsset))
			(arena (mut-array u8)) (writing bool)) (returns EmbedCheck)
		(body
			(let files (array:alloc SuppliedFile 0i32))
			(return (call load_graph_assets (borrow-shared module) (borrow-shared source)
				(borrow-shared files) (borrow-mut assets) (borrow-mut arena) writing))))

	(fn load_graph_assets
		(:doc `Record asset ranges during measurement or load them into the reserved arena during writing.`)
		(params (module (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile)) (assets (mut-array EmbedAsset))
			(arena (mut-array u8)) (writing bool))
		(returns EmbedCheck)
		(body
			(let-mut total source.len)
			(let-mut index 0i32)
			(while
				(:doc "Only initialized request rows have a literal path span.")
				(index.lt assets.len)
				(body
					(let asset (assets.get index))
					(let end asset/path_end)
					(if
						(:doc "Read a checked request relative to the source that defined it.")
						end.gtz
						(then
							(let origin (call asset_owner (borrow-shared files) asset))
							(let start asset/path_start)
							(let-mut path (array:alloc u8 (end.sub start)))
							(let length (call decode_asset_path (borrow-shared source) start end
								(borrow-mut path)))
							(if
								(:doc "Reject malformed path values before the host string conversion.")
								length.ltz
								(then (return (call asset_unavailable asset origin))))
							(let-mut result -1i32)
							(if
								(:doc "Source spans identify an imported module's own canonical base directory.")
								origin.gtz
								(then
									(let file (files.get origin))
									(set result (call asset_io
										(borrow-shared (source.range file/path_start file/path_end))
										(borrow-shared (path.range 0i32 length))
										asset (borrow-mut arena) writing)))
								(else
									(set result (call asset_io (borrow-shared module)
										(borrow-shared (path.range 0i32 length))
										asset (borrow-mut arena) writing))))
							(if
								(:doc "A missing, changed, or oversized asset cannot extend the arena.")
								(result.ltz.or
									(i32:lt (i32:sub 2147483647i32 total) result))
								(then (return (call asset_unavailable asset origin))))
							(if
								(:doc "Only measurement publishes the byte ranges the writing pass will fill.")
								writing.not
								(then
									(let finish (total.add result))
									(assets.set index
										(struct:new EmbedAsset (path_start start) (path_end end)
											(bytes_start total) (bytes_end finish)))
									(set total finish)))))
					(set index index.inc)))
			(return (call embed_check total 0i32 0i32 0i32 0u32)))))
