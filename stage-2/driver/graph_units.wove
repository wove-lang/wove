(module native_graph_units
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage a checked graph as a common header and ordered numbered C bodies.")

	(use wove-file "./bin/units.wove" (only staged_unit_path remove_staged_units (value program_header)))
	(use wove-file "./diagnostics.wove" (only report_argv (value publish_failure)))
	(use wove-file "./output.wove" (only stage_native_unit))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./publication.wove" (only stage_file))
	(use wove-file "../emit/graph.wove" (only write_partitioned_graph (type GraphPlan)))
	(use wove-file "../emit/units.wove" (only plan_unit_assignments (type UnitIndex)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))

	(let no_verified_includes "")

	(fn stage_unit_segments
		(:doc "Stage the measured ranges in order, with runtime definitions in exactly one object.")
		(params (stage (shared-array u8)) (output (shared-array u8)) (ends (shared-array UnitIndex)) (count i32))
		(returns bool)
		(body
			(let header (call join_file_path (borrow-shared stage) (borrow-shared program_header)))
			(let-mut start (struct.get (array.load ends 0i32) value))
			(if
				(:doc "All numbered bodies depend on this exact declarations file.")
				(bool.not (call stage_file (borrow-shared header) (borrow-shared (array.range output 0i32 start))))
				(then (return (bool false))))
			(for
				(:doc "Stage only complete units. The caller removes the whole private directory on failure.")
				(let index) (range 0i32 count)
				(body
					(let end (struct.get (array.load ends (i32.inc index)) value))
					(let unit (call staged_unit_path (borrow-shared stage) index))
					(let bytes (borrow-shared (array.range output start end)))
					(let saved (if (i32.eqz index)
						(then (call stage_native_unit (borrow-shared unit) (borrow-shared bytes)))
						(else (call stage_file (borrow-shared unit) (borrow-shared bytes)))))
					(if (bool.not saved) (then (return (bool false))))
					(set start end)))
			(return (bool true))))

	(fn stage_checked_units
		(:doc "Return the negative unit count on success or use the canonical stage when splitting is unavailable.")
		(params (staged (shared-array u8)) (partition i32) (target_index i32) (human bool)
			(arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (tests (shared-array DiscoveredTest)) (plan GraphPlan))
		(returns i32)
		(body
			(let-mut assignments (array.alloc UnitIndex (call checked_function_count (borrow-shared functions))))
			(let count (call plan_unit_assignments (borrow-shared functions) (array.len files)
				partition (borrow-mut assignments)))
			(if
				(:doc "One body needs no distinct object plan, and every multiunit plan needs one extra header boundary.")
				(bool.or (i32.le count 1i32) (i32.eq count 2147483647i32))
				(then (return 0i32)))
			(let-mut ends (array.alloc UnitIndex (i32.inc count)))
			(let-mut empty (array.alloc u8 0i32))
			(let measured (call write_partitioned_graph (borrow-shared arena) (borrow-shared files) (borrow-shared bindings)
				(borrow-shared trees) (borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				0i32 plan (borrow-shared tests) (borrow-shared assignments) count (borrow-shared no_verified_includes)
				(borrow-mut empty) (borrow-mut ends) (bool true)))
			(if
				(:doc "Unverified C headers and an unrepresentable split leave the complete serial stage available.")
				(bool.or (i32.eq (struct.get measured declaration) -2i32) (u32.gtz (struct.get measured error)))
				(then (return 0i32)))
			(let-mut output (array.alloc u8 (struct.get measured count)))
			(let written (call write_partitioned_graph (borrow-shared arena) (borrow-shared files) (borrow-shared bindings)
				(borrow-shared trees) (borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				0i32 plan (borrow-shared tests) (borrow-shared assignments) count (borrow-shared no_verified_includes)
				(borrow-mut output) (borrow-mut ends) (bool false)))
			(if
				(:doc "A partial numbered stage never reaches a native compile or public destination.")
				(bool.or (u32.gtz (struct.get written error))
					(bool.not (call stage_unit_segments (borrow-shared staged) (borrow-shared output)
						(borrow-shared ends) count)))
				(then
					(call remove_staged_units (borrow-shared staged) count)
					(return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
			(return (i32.sub 0i32 count))))
)
