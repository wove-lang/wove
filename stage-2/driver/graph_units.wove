(module native_graph_units
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage a checked graph as a common header and ordered numbered C bodies.")

	(use wove-file "../c/arguments.wove" (only is_c_storage_mode))
	(use wove-file "./prototype_probes.wove" (only checked_replay_prototype write_prototype_probes write_pointer_owner_probes (value pointer_owner_witness)))
	(use wove-file "./bin/staged.wove" (only numbered_probe_arguments))
	(use wove-file "./bin/units.wove" (only staged_unit_path (value program_header)))
	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "../clang/native_replay.wove" (only (value lvalue_witness_prefix)
		(value owner_type_witness_prefix) (value release_witness_prefix) (value call_witness_prefix)
		(value fixed_call_witness_prefix) (value borrowed_cstr_witness_prefix) (value mutable_cstr_witness_prefix)
		(value typed_call_witness_prefix) (value owner_call_witness_prefix) (value variadic_call_witness_prefix)
		(value availability_declaration)))
	(use wove-file "./diagnostics.wove" (only report_argv (value publish_failure)))
	(use wove-file "./macro_probes.wove" (only write_macro_probes))
	(use wove-file "./variadic_probes.wove" (only write_variadic_probes))
	(use wove-file "./numbered_headers.wove" (only certify_numbered_includes check_numbered_deployment discard_numbered_sources
		(value names_begin) (value names_end)
		(value implicit_runtime) (value implicit_stdint)))
	(use wove-file "./output.wove" (only stage_native_unit))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./publication.wove" (only stage_file))
	(use wove-file "../emit/c.wove" (only uses_runtime program_runtime))
	(use wove-file "../emit/c_arguments.wove" (only c_symbol_text))
	(use wove-file "../emit/c_values.wove" (only is_borrowed_c_value is_c_integer_constant is_c_vector_snapshot
		is_writable_c_integer))
	(use wove-file "../emit/c_vectors.wove" (only write_c_vector_declaration))
	(use wove-file "../emit/owners.wove" (only is_numbered_pointer_owner is_numbered_storage_owner native_owner_contract write_native_type))
	(use wove-file "../emit/runtime.wove" (only write_c_number))
	(use wove-file "../emit/text.wove" (only c_literal_text c_span))
	(use wove-file "../emit/graph.wove" (only write_partitioned_graph (type GraphPlan)))
	(use wove-file "../emit/headers.wove" (only include_capacity prepare_includes write_includes (type CInclude)))
	(use wove-file "../emit/units.wove" (only plan_unit_assignments numbered_program_preamble
		checked_mutable_cstr_parameter numbered_adapted_fixed_call numbered_field_snapshot_call numbered_fixed_pointer_owner_call
		numbered_named_variadic_call numbered_owner_binding numbered_pointer_owner_consume
		(value numbered_preamble_replay) (type UnitIndex)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/native_owner_types.wove" (only native_owner_declaration native_owner_type))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))

	(fn stage_unit_segments
		(:doc "Stage the measured ranges in order, with runtime definitions in exactly one object.")
		(params (stage (shared-array u8)) (output (shared-array u8)) (ends (shared-array UnitIndex)) (count i32))
		(returns bool)
		(body
			(let header (call join_file_path (borrow-shared stage) (borrow-shared program_header)))
			(let-mut start (struct:get (ends.get 0i32) value))
			(if
				(:doc "All numbered bodies depend on this exact declarations file.")
				(bool:not (call stage_file (borrow-shared header) (borrow-shared (output.range 0i32 start))))
				(then (return (bool false))))
			(for
				(:doc "Stage only complete units. The caller removes the whole private directory on failure.")
				(let index) (range 0i32 count)
				(body
					(let end (struct:get (ends.get (i32:inc index)) value))
					(let unit (call staged_unit_path (borrow-shared stage) index))
					(let bytes (borrow-shared (output.range start end)))
					(let saved (if (i32:eqz index)
						(then (call stage_native_unit (borrow-shared unit) (borrow-shared bytes)))
						(else (call stage_file (borrow-shared unit) (borrow-shared bytes)))))
					(if (bool:not saved) (then (return (bool false))))
					(set start end)))
			(return (bool true))))

	(let guard_open "#ifdef ")
	(let guard_close "\n#error native name is already a macro before the audited includes\n#endif\n")

	(fn has_writable_values
		(:doc "Request link-identity checks only if the checked plan selects a writable integer.")
		(params (statements (shared-array ScalarStatement))) (returns bool)
		(body
			(for
				(:doc "The checked table holds each exact defining C operand.")
				(let row) (borrow-shared statements)
				(body
					(if (call is_writable_c_integer row) (then (return (bool true))))))
			(return (bool false))))

	(fn write_native_value_guards
		(:doc "Keep preexisting macros from bypassing the proof of the selected header values.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(output (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let-mut width 0u32)
			(for
				(:doc "Checked defining rows already canonicalize aliases of the same native object.")
				(let row) (borrow-shared statements)
				(body
					(if
						(:doc "Reject a preexisting macro before a selected header can establish its constant or object.")
						(bool:or (call is_borrowed_c_value row)
							(bool:or (call is_c_integer_constant row) (call is_writable_c_integer row)))
						(then
							(let name (nodes.get (struct:get row target)))
							(set width (call c_literal_text (borrow-shared guard_open) (borrow-mut output) width writing))
							(set width (call c_span (borrow-shared arena) (struct:get name start) (struct:get name end)
								(borrow-mut output) width writing))
							(set width (call c_literal_text (borrow-shared guard_close) (borrow-mut output) width writing))))))
			(return width)))

	(let witness_type "extern __typeof__(")
	(let witness_name ") (")
	(let witness_end ");\n")
	(let constant_witness "typedef char wove_native_constant_probe[1+0*(")
	(let constant_witness_end ")];\n")
	(let address_witness "typedef __typeof__(&(")
	(let address_name ")) ")
	(let witness_end_line ";\n")
	(let storage_witness "typedef __typeof__((")
	(let storage_pointer "*)0) ")
	(let function_guard "\n#error native replay requires a direct C function\n#endif\n")
	(struct NativeCallWitnesses (fields (width u32) (fixed bool) (variadics i32) (prototypes bool)))

	(fn write_function_witness
		(:doc "Observe the direct function that the generated C call will use, including its native prototype.")
		(params (arena (shared-array u8)) (symbol SourceNode) (prefix (shared-array u8)) (declaration i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width (call c_literal_text (borrow-shared guard_open) (borrow-mut output) offset writing))
			(set width (call c_symbol_text (borrow-shared arena) symbol (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared function_guard) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared address_witness) (borrow-mut output) width writing))
			(set width (call c_symbol_text (borrow-shared arena) symbol (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared address_name) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared prefix) (borrow-mut output) width writing))
			(set width (call write_c_number (borrow-mut output) width declaration writing))
			(return (call c_literal_text (borrow-shared witness_end_line) (borrow-mut output) width writing))))

	(fn write_native_call_witnesses
		(:doc "Certify each supported native call and any release against Clang's actual C declaration.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns NativeCallWitnesses)
		(body
			(let-mut width offset)
			(let-mut fixed_calls (bool false))
			(let-mut variadic_calls 0i32)
			(let-mut typed_calls (bool false))
			(for
				(:doc "The eligibility pass has already checked the exact argument and snapshot contracts.")
				(let index) (range 0i32 (call checked_function_count (borrow-shared functions)))
				(body
					(let function (functions.get index))
					(if (i32:not-ltz (struct:get function body)) (then (continue)))
					(let snapshot (struct:get function c_snapshot))
					(let drop (struct:get function c_snapshot_drop))
					(if
						(:doc "Whole-string snapshots without a release check the native character pointer.")
						(bool:and snapshot (bool:and (i32:ltz drop) (i32:ltz (struct:get function c_snapshot_field))))
						(then
							(let symbol (nodes.get (struct:get function name)))
							(let declaration (struct:get function declaration))
							(let parameter (parameters.get (struct:get function params)))
							(if
								(:doc "The mutable call also needs a witnessed writable native parameter.")
								(call checked_mutable_cstr_parameter parameter)
								(then (set width (call write_function_witness (borrow-shared arena) symbol
									(borrow-shared mutable_cstr_witness_prefix) declaration (borrow-mut output) width writing)))
								(else (set width (call write_function_witness (borrow-shared arena) symbol
									(borrow-shared borrowed_cstr_witness_prefix) declaration (borrow-mut output) width writing))))
							(set fixed_calls (bool true))
							(continue)))
					(if
						(:doc "The exact prototype and the resolved declaration are checked independently.")
						(call checked_replay_prototype (borrow-shared arena) (borrow-shared nodes) function
							(borrow-shared parameters) (borrow-shared records))
						(then
							(let symbol (nodes.get (struct:get function name)))
							(let declaration (struct:get function declaration))
							(set width (if
								(:doc "Only owner constructors can depend on the SDK builtin and allocation attributes.")
								(call numbered_fixed_pointer_owner_call (borrow-shared arena) (borrow-shared nodes)
									function (borrow-shared parameters))
								(then (call write_function_witness (borrow-shared arena) symbol
									(borrow-shared owner_call_witness_prefix) declaration (borrow-mut output) width writing))
								(else (call write_function_witness (borrow-shared arena) symbol
									(borrow-shared typed_call_witness_prefix) declaration (borrow-mut output) width writing))))
							(set fixed_calls (bool true))
							(set typed_calls (bool true))
							(continue)))
					(let fixed (call numbered_adapted_fixed_call function (borrow-shared parameters) (borrow-shared records)))
					(let variadic (i32:gtz (struct:get (call numbered_named_variadic_call (borrow-shared arena)
						(borrow-shared nodes) function (borrow-shared parameters)) prefix)))
					(set fixed_calls (bool:or fixed_calls fixed))
					(if variadic (then (set variadic_calls (i32:inc variadic_calls))))
					(if
						(:doc "Use the actual native spelling, including an explicit c-name.")
						(bool:or (bool:or fixed variadic) (bool:or snapshot (i32:gtz (struct:get function c_extents))))
						(then
							(let declaration (struct:get function declaration))
							(let symbol (nodes.get (struct:get function name)))
							(if
								(:doc "Each checked call family authorizes its own native prototype shape.")
								variadic
								(then (set width (call write_function_witness (borrow-shared arena) symbol
									(borrow-shared variadic_call_witness_prefix) declaration (borrow-mut output) width writing)))
								(else
									(if
										(:doc "Only a checked fixed call or named tail can authorize SDK symbol redirects.")
										fixed
										(then (set width (call write_function_witness (borrow-shared arena) symbol
											(borrow-shared fixed_call_witness_prefix) declaration (borrow-mut output) width writing)))
										(else (set width (call write_function_witness (borrow-shared arena) symbol
											(borrow-shared call_witness_prefix) declaration (borrow-mut output) width writing))))))
							(if
								(:doc "The snapshot's named release is checked independently of the allocating callee.")
								snapshot
								(then (set width (call write_function_witness (borrow-shared arena)
									(nodes.get drop) (borrow-shared release_witness_prefix)
									declaration (borrow-mut output) width writing))))))))
			(return (struct:new NativeCallWitnesses (width width) (fixed fixed_calls) (variadics variadic_calls)
				(prototypes typed_calls)))))

	(fn write_typed_call_witnesses
		(:doc "Build the call probes that use checked C types after the implicit header.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(variadics i32) (prototypes bool) (owners (shared-array u8)) (output (mut-array u8)) (writing bool)) (returns u32)
		(body
			(let-mut width (call write_macro_probes (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
				(borrow-mut output) writing))
			(if
				(:doc "Preserve default argument promotion witnesses for each named C tail.")
				(i32:gtz variadics)
				(then
					(let next (call write_variadic_probes (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
						(borrow-mut output) width writing))
					(if (u32:lt next width) (then (return 4294967295u32)))
					(set width next)))
			(if
				(:doc "Compare complete native prototypes after the implicit compiler types are declared.")
				prototypes
				(then
					(let next (call write_prototype_probes (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
						(borrow-mut output) width writing))
					(if (u32:lt next width) (then (return 4294967295u32)))
					(set width next)))
			(return (call write_pointer_owner_probes (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared owners) (borrow-mut output) width writing))))

	(struct OwnerWitnesses (fields (any bool) (pointer bool)))
	(let storage_owner_witness 1u8)

	(fn mark_owner_witnesses
		(:doc "Select canonical owner declarations from native type bindings, storage formals, and pointer results.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (marked (mut-array u8))) (returns OwnerWitnesses)
		(body
			(let-mut storage (bool false))
			(let-mut pointer (bool false))
			(for
				(:doc "Each imported alias marks the same defining owner declaration.")
				(let binding) (borrow-shared bindings)
				(body
					(let declaration (call numbered_owner_binding (borrow-shared arena) (borrow-shared nodes)
						binding (borrow-shared trees)))
					(if (i32:ltz declaration) (then (continue)))
					(if
						(:doc "Pointer owners need an exact typed release proof in addition to their native type.")
						(call is_numbered_pointer_owner (borrow-shared arena) (borrow-shared nodes)
							(call native_owner_type declaration))
						(then
							(marked.set declaration pointer_owner_witness)
							(set pointer (bool true)))
						(else
							(marked.set declaration storage_owner_witness)
							(set storage (bool true))))))
			(for
				(:doc "A selected C signature can require a storage type without importing the type name.")
				(let parameter) (borrow-shared parameters)
				(body
					(let type (struct:get parameter type))
					(if
						(:doc "Uninitialized rows and nonstorage contracts make no storage claim.")
						(bool:and (call is_c_storage_mode (struct:get parameter c_mode))
							(call is_numbered_storage_owner (borrow-shared arena) (borrow-shared nodes) type))
						(then
							(marked.set (call native_owner_declaration type) storage_owner_witness)
							(set storage (bool true))))))
			(for
				(:doc "A checked native call selects its owner even without a separate type import.")
				(let index) (range 0i32 (call checked_function_count (borrow-shared functions)))
				(body
					(let function (functions.get index))
					(if (i32:not-ltz (struct:get function body)) (then (continue)))
					(let type (if
						(:doc "A field snapshot or explicit destructor witnesses its original native pointer operand.")
						(bool:or (call numbered_field_snapshot_call (borrow-shared arena) (borrow-shared nodes) function
								(borrow-shared parameters))
							(call numbered_pointer_owner_consume (borrow-shared arena) (borrow-shared nodes) function
								(borrow-shared parameters)))
						(then (struct:get (parameters.get (struct:get function params)) type))
						(else (struct:get function result))))
					(if
						(:doc "Each selected pointer owner retains the same native type and connected release.")
						(call is_numbered_pointer_owner (borrow-shared arena) (borrow-shared nodes) type)
						(then
							(marked.set (call native_owner_declaration type) pointer_owner_witness)
							(set pointer (bool true))))))
			(return (struct:new OwnerWitnesses (any (bool:or storage pointer)) (pointer pointer)))))

	(fn write_owner_witnesses
		(:doc "Witness the original native representation and cleanup symbol for each checked owner.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (marked (shared-array u8))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width offset)
			(for
				(:doc "Use the original declaration order to compare the same witnesses in every context.")
				(let declaration) (range 0i32 marked.len)
				(body
					(let kind (marked.get declaration))
					(if (u8:eqz kind) (then (continue)))
					(let owner (call native_owner_contract (borrow-shared arena) (borrow-shared nodes)
						(call native_owner_type declaration)))
					(set width (call c_literal_text (borrow-shared storage_witness) (borrow-mut output) width writing))
					(set width (call write_native_type (borrow-shared arena) (nodes.get (struct:get owner native))
						(borrow-mut output) width writing))
					(set width (call c_literal_text (borrow-shared storage_pointer) (borrow-mut output) width writing))
					(set width (call c_literal_text (borrow-shared owner_type_witness_prefix) (borrow-mut output) width writing))
					(set width (call write_c_number (borrow-mut output) width declaration writing))
					(set width (call c_literal_text (borrow-shared witness_end_line) (borrow-mut output) width writing))
					(let drop (nodes.get (struct:get owner drop)))
					(set width (if
						(:doc "Pointer destruction depends on the same effective declaration metadata as its constructor.")
						(u8:eq kind pointer_owner_witness)
						(then (call write_function_witness (borrow-shared arena) drop (borrow-shared owner_call_witness_prefix)
							declaration (borrow-mut output) width writing))
						(else (call write_function_witness (borrow-shared arena) drop (borrow-shared release_witness_prefix)
							declaration (borrow-mut output) width writing))))))
			(return width)))

	(fn write_native_value_witnesses
		(:doc "Observe the exact expansions of the checked native operands in each include context.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (statements (shared-array ScalarStatement))
			(owners (shared-array u8)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (native_calls bool)
			(output (mut-array u8)) (writing bool))
		(returns u32)
		(body
			(let-mut width 0u32)
			(for
				(:doc "Use defining rows so each selected alias observes its original C spelling.")
				(let row) (borrow-shared statements)
				(body
					(let borrowed (call is_borrowed_c_value row))
					(let writable (call is_writable_c_integer row))
					(if
						(:doc "Only replayed native operands need a witness in the Clang input.")
						(bool:or (bool:or borrowed writable) (call is_c_integer_constant row))
						(then
							(if
								(:doc "Omit the witness section entirely when the plan has only native types.")
								(u32:eqz width)
								(then (set width (call c_literal_text (borrow-shared names_begin) (borrow-mut output) width writing))))
							(let name (nodes.get (struct:get row target)))
							(if
								(:doc "Use the actual vector declaration even when the selected header omits it.")
								(call is_c_vector_snapshot row)
								(then
									(set width (call write_c_vector_declaration (borrow-shared arena)
										name (borrow-mut output) width writing))
									(continue)))
							(let start (struct:get name start))
							(let end (struct:get name end))
							(if
								(:doc "Redeclare the original external object or emit a type-only witness.")
								borrowed
								(then
									(set width (call c_literal_text (borrow-shared witness_type) (borrow-mut output) width writing))
									(set width (call c_span (borrow-shared arena) start end (borrow-mut output) width writing))
									(set width (call c_literal_text (borrow-shared witness_name) (borrow-mut output) width writing))
									(set width (call c_span (borrow-shared arena) start end (borrow-mut output) width writing))
									(set width (call c_literal_text (borrow-shared witness_end) (borrow-mut output) width writing)))
								(else
									(if
										(:doc "Taking the operand's type exposes the resolved getter without evaluating the lvalue.")
										writable
										(then
											(set width (call c_literal_text (borrow-shared address_witness) (borrow-mut output) width writing))
											(set width (call c_span (borrow-shared arena) start end (borrow-mut output) width writing))
											(set width (call c_literal_text (borrow-shared address_name) (borrow-mut output) width writing))
											(set width (call c_literal_text (borrow-shared lvalue_witness_prefix) (borrow-mut output) width writing))
											(set width (call c_span (borrow-shared arena) start end (borrow-mut output) width writing))
											(set width (call c_literal_text (borrow-shared witness_end_line) (borrow-mut output) width writing)))
										(else
											(set width (call c_literal_text (borrow-shared constant_witness) (borrow-mut output) width writing))
											(set width (call c_span (borrow-shared arena) start end (borrow-mut output) width writing))
											(set width (call c_literal_text (borrow-shared constant_witness_end) (borrow-mut output) width writing))))))))))
			(if
				(:doc "Native calls and owners need their own witnesses even without checked module values.")
				(bool:or native_calls (i32:gtz owners.len))
				(then
					(if (u32:eqz width)
						(then (set width (call c_literal_text (borrow-shared names_begin) (borrow-mut output) width writing))))
					(set width (call write_owner_witnesses (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared owners) (borrow-mut output) width writing))))
			(if
				(:doc "Checked calls and their releases depend on consistent C declarations in both preambles.")
				native_calls
				(then (set width (struct:get (call write_native_call_witnesses (borrow-shared arena)
					(borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
					(borrow-mut output) width writing) width))))
			(if (u32:eqz width) (then (return width)))
			(return (call c_literal_text (borrow-shared names_end) (borrow-mut output) width writing))))

	(fn stage_checked_units
		(:doc "Return the negative unit count on success or use the canonical stage when splitting is unavailable.")
		(params (staged (shared-array u8)) (probe_options (shared-array u8)) (partition i32) (target_index i32) (human bool)
			(arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (shared-array ScalarExpression)) (tests (shared-array DiscoveredTest)) (plan GraphPlan))
		(returns i32)
		(body
			(let-mut assignments (array:alloc UnitIndex (call checked_function_count (borrow-shared functions))))
			(let count (call plan_unit_assignments (borrow-shared functions) files.len
				partition (borrow-mut assignments)))
			(if
				(:doc "One body needs no distinct object plan, and every multiunit plan needs one extra header boundary.")
				(bool:or (i32:le count 1i32) (i32:eq count 2147483647i32))
				(then (return 0i32)))
			(let mode (call numbered_program_preamble (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared bindings) (borrow-shared functions)
				(borrow-shared parameters) (borrow-shared records) (borrow-shared trees) (borrow-shared statements)))
			(if
				(:doc "Broader native ABIs keep using serial C without starting an include audit.")
				(u8:eqz mode)
				(then (return 0i32)))
			(let limit bindings.len)
			(let capacity (call include_capacity (borrow-shared bindings) 0i32 limit))
			(if (i32:ltz (struct:get capacity bytes)) (then (return 0i32)))
			(let-mut paths (array:alloc u8 (struct:get capacity bytes)))
			(let-mut includes (array:alloc CInclude (struct:get capacity rows)))
			(let header_plan (call prepare_includes (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) 0i32 limit (borrow-mut paths) (borrow-mut includes)))
			(if (u32:gtz (struct:get header_plan error)) (then (return 0i32)))
			(let-mut empty (array:alloc u8 0i32))
			(let width (call write_includes (borrow-shared paths) (borrow-shared includes)
				(struct:get header_plan count) (borrow-mut empty) (bool false)))
			(if (u32:gt width 2147483647u32) (then (return 0i32)))
			(let-mut prefix (array:alloc u8 (i32:from-u32 width)))
			(let-mut declaration (array:alloc u8 1i32))
			(if
				(:doc "Certify the exact ordered prefix only when the checked graph selected C headers.")
				(u32:gtz width)
				(then
					(let written (call write_includes (borrow-shared paths) (borrow-shared includes)
						(struct:get header_plan count) (borrow-mut prefix) (bool true)))
					(if (u32:not-eq width written) (then (return 0i32)))
					(let-mut guard_width 0u32)
					(let-mut names_width 0u32)
					(let-mut implicit 0u8)
					(let borrowed (u8:eq mode 2u8))
					(let writable (bool:and (u8:lt 1u8 mode) (call has_writable_values (borrow-shared statements))))
					(let-mut marked (array:alloc u8 (if (u8:lt 1u8 mode) (then nodes.len) (else 0i32))))
					(let owners (if
						(:doc "Mark owner contracts only for plans with a full native replay.")
						(u8:lt 1u8 mode)
						(then (call mark_owner_witnesses (borrow-shared arena) (borrow-shared nodes)
							(borrow-shared bindings) (borrow-shared trees) (borrow-shared functions)
							(borrow-shared parameters) (borrow-mut marked)))
						(else (struct:new OwnerWitnesses (any (bool false)) (pointer (bool false))))))
					(let owner_length (if (struct:get owners any) (then marked.len) (else 0i32)))
					(let pointer_length (if (struct:get owners pointer) (then owner_length) (else 0i32)))
					(let call_witnesses (if
						(:doc "Only replayed C signatures add observations to the private probe.")
						(u8:lt 1u8 mode)
						(then (call write_native_call_witnesses (borrow-shared arena) (borrow-shared nodes)
							(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
							(borrow-mut empty) 0u32 (bool false)))
						(else (struct:new NativeCallWitnesses (width 0u32) (fixed (bool false)) (variadics 0i32)
							(prototypes (bool false))))))
					(let native_calls (u32:gtz (struct:get call_witnesses width)))
					(if
						(:doc "Measure any checked operands whose original expansions must match between units.")
						(u8:lt 1u8 mode)
						(then
							(set guard_width (call write_native_value_guards (borrow-shared arena)
								(borrow-shared nodes) (borrow-shared statements) (borrow-mut empty) (bool false)))
							(set names_width (call write_native_value_witnesses (borrow-shared arena)
								(borrow-shared nodes) (borrow-shared statements)
								(borrow-shared (marked.range 0i32 owner_length)) (borrow-shared functions)
								(borrow-shared parameters) (borrow-shared records)
								native_calls (borrow-mut empty) (bool false)))
							(if
								(:doc "Both measured fragments must fit, and a borrowed value must have a witness.")
								(bool:or (u32:gt names_width 2147483647u32)
									(bool:or (u32:gt guard_width 2147483647u32) (bool:and borrowed (u32:eqz names_width))))
								(then (return 0i32)))))
					(if
						(:doc "A borrowed proof places the compiler's implicit runtime header at both actual depths.")
						borrowed
						(then
							(if
								(:doc "The borrowed proof requires an implicit runtime header.")
								(bool:or (struct:get header_plan runtime)
									(bool:not (call uses_runtime (borrow-shared expressions)
										(borrow-shared parameters) (borrow-shared records))))
								(then (return 0i32)))
							(set implicit implicit_runtime)))
					(if
						(:doc "Check the preamble header that supplies the native views and Wove signatures.")
						(u8:eq mode numbered_preamble_replay)
						(then
							(let runtime (call program_runtime (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
								(borrow-shared records) (borrow-shared bindings) (borrow-shared expressions)))
							(if
								(:doc "An explicitly selected header has already been assigned to the ordered include prefix.")
								(struct:get runtime needed)
								(then (if (bool:not (struct:get header_plan runtime)) (then (set implicit implicit_runtime))))
								(else (if (bool:not (struct:get header_plan stdint)) (then (set implicit implicit_stdint)))))))
					(let-mut names (array:alloc u8 (i32:from-u32 names_width)))
					(let-mut guards (array:alloc u8 (i32:from-u32 guard_width)))
					(let variadic_count (struct:get call_witnesses variadics))
					(let typed_calls (struct:get call_witnesses prototypes))
					(let typed_width (call write_typed_call_witnesses (borrow-shared arena) (borrow-shared nodes)
						(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
						variadic_count typed_calls (borrow-shared (marked.range 0i32 pointer_length)) (borrow-mut empty) (bool false)))
					(if
						(:doc "The combined typed witness fragment must fit its measured buffer.")
						(u32:gt typed_width 2147483647u32)
						(then (return 0i32)))
					(let-mut typed (array:alloc u8 (i32:from-u32 typed_width)))
					(if
						(:doc "These observations use the actual capture types in scope after the implicit header.")
						(u32:gtz typed_width)
						(then
							(let written (call write_typed_call_witnesses (borrow-shared arena) (borrow-shared nodes)
								(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
								variadic_count typed_calls (borrow-shared (marked.range 0i32 pointer_length)) (borrow-mut typed) (bool true)))
							(if (u32:not-eq written typed_width) (then (return 0i32)))))
					(if
						(:doc "Materialize the measured prelude without changing the emitted include prefix.")
						(bool:or (u32:gtz guard_width) (u32:gtz names_width))
						(then
							(let size (call write_native_value_guards (borrow-shared arena)
								(borrow-shared nodes) (borrow-shared statements) (borrow-mut guards) (bool true)))
							(let witnesses (call write_native_value_witnesses (borrow-shared arena)
								(borrow-shared nodes) (borrow-shared statements)
								(borrow-shared (marked.range 0i32 owner_length)) (borrow-shared functions)
								(borrow-shared parameters) (borrow-shared records)
								native_calls (borrow-mut names) (bool true)))
							(if
								(:doc "Both private probe fragments must match their measured sizes.")
								(bool:or (u32:not-eq size guard_width) (u32:not-eq witnesses names_width))
								(then (return 0i32)))))
					(let program (call clang_program))
					(let options (call numbered_probe_arguments (borrow-shared probe_options) (borrow-shared staged)
						(u8:gtz (struct:get plan library_os))))
					(if
						(:doc "Keep the ordinary build and its diagnostics when the native context cannot be certified.")
						(bool:or (i32:eqz options.len)
							(bool:not (call certify_numbered_includes (borrow-shared program) (borrow-shared options)
								(borrow-shared staged) count (borrow-shared prefix) (borrow-shared guards) (borrow-shared names)
								(borrow-shared typed) (borrow-mut declaration)
								implicit borrowed writable (bool:or writable (bool:or (struct:get owners any) native_calls))
								(bool:or (struct:get owners pointer) (struct:get call_witnesses fixed)) variadic_count)))
						(then (return 0i32)))))
			(let-mut ends (array:alloc UnitIndex (i32:inc count)))
			(let measured (call write_partitioned_graph (borrow-shared arena) (borrow-shared files) (borrow-shared bindings)
				(borrow-shared trees) (borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				0i32 plan (borrow-shared tests) (borrow-shared assignments) count (borrow-shared prefix)
				(borrow-mut empty) (borrow-mut ends) (bool true)))
			(if
				(:doc "Unverified C headers and an unrepresentable split leave the complete serial stage available.")
				(bool:or (i32:eq (struct:get measured declaration) -2i32) (u32:gtz (struct:get measured error)))
				(then (return 0i32)))
			(let-mut output (array:alloc u8 (struct:get measured count)))
			(let written (call write_partitioned_graph (borrow-shared arena) (borrow-shared files) (borrow-shared bindings)
				(borrow-shared trees) (borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
				(borrow-shared statements) (borrow-shared records) (borrow-shared expressions)
				0i32 plan (borrow-shared tests) (borrow-shared assignments) count (borrow-shared prefix)
				(borrow-mut output) (borrow-mut ends) (bool false)))
			(if
				(:doc "A partial numbered stage never reaches a native compile or public destination.")
				(bool:or (u32:gtz (struct:get written error))
					(bool:not (call stage_unit_segments (borrow-shared staged) (borrow-shared output)
						(borrow-shared ends) count)))
				(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
			(if
				(:doc "Only ordinary availability declarations require an audit of the actual emitted call sites.")
				(u8:eq (declaration.get 0i32) availability_declaration)
				(then
					(let program (call clang_program))
					(let options (call numbered_probe_arguments (borrow-shared probe_options) (borrow-shared staged)
						(u8:gtz (struct:get plan library_os))))
					(if
						(:doc "Discard only the numbered files before falling back to the unchanged serial build.")
						(bool:or (i32:eqz options.len)
							(bool:not (call check_numbered_deployment (borrow-shared program) (borrow-shared options)
								(borrow-shared staged) count)))
						(then
							(if
								(:doc "An incomplete private cleanup is an ordinary staging failure.")
								(bool:not (call discard_numbered_sources (borrow-shared staged) count))
								(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
							(return 0i32)))))

			(return (i32:sub 0i32 count))))
)
