(module native_parallel_tool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Run staged objects and collect diagnostics and input checks in unit order.")

	(use wove-file "./staged.wove" (only build_staged_units indexed_object_path
		(value stdout_suffix) (value stderr_suffix) (value jobs_suffix) (value linker_stdout) (value linker_stderr)))
	(use wove-file "./units.wove" (only staged_unit_paths))
	(use wove-file "./dependencies.wove" (only check_resolved_headers))
	(use wove-file "./jobs.wove" (only read_job_sysroot))
	(use wove-file "../protection.wove" (only (type BuildProtection)))
	(use wove-file "../files.wove" (only file_stamp read_source_file))
	(use wove-file "../paths.wove" (only join_file_path))
	(use wove-file "../../cli/command/resolve.wove" (only (type CommandInvocation)))
	(use wove-file "../../cli/command/args.wove" (only (type CommandArgument)))
	(use wove-file "../../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../io/write.wove" (only write_all))

	(struct NativeTool (fields (status i32) (checked i32) (failed_unit i32)))

	(fn replay_log
		(:doc "Forward the available child output directly to the original stream.")
		(params (path (shared-array u8)) (descriptor i32)) (returns void)
		(body
			(let stamp (call file_stamp (borrow-shared path)))
			(let length stamp/length)
			(if
				(:doc "A launch failure can precede creation of the log.")
				(length.le 0i32)
				(then (return)))
			(let-mut width length)
			(if
				(:doc "The public stdout relay has the same limit as the serial tool relay.")
				(bool:and (descriptor.eq 1i32) (width.gt 65536i32))
				(then (set width 65536i32)))
			(let-mut bytes (array:alloc u8 length))
			(if
				(:doc "A private file can be replayed only after the child has completed.")
				(call read_source_file (borrow-shared path) stamp (borrow-mut bytes))
				(then (let written (call write_all descriptor (borrow-shared (bytes.range 0i32 width))))))))

	(fn check_object_traces
		(:doc "Replay deterministic child diagnostics and protect every selected C input before publication.")
		(params (binary (shared-array u8)) (statuses (shared-array i32)) (attempted i32) (protection BuildProtection)
			(target_index i32) (human bool)) (returns i32)
		(body
			(let-mut checked 0i32)
			(for
				(:doc "Only attempted jobs own streams. Each compile has its own selected sysroot.")
				(let index) (range 0i32 attempted)
				(body
					(let stderr (call indexed_object_path (borrow-shared binary) index (borrow-shared stderr_suffix)))
					(call replay_log (borrow-shared stderr) 2i32)
					(if
						(:doc "Report the first dependency failure in unit order, while still replaying later stderr.")
						checked.eqz
						(then
							(let trace (call indexed_object_path (borrow-shared binary) index (borrow-shared stdout_suffix)))
							(let jobs (call indexed_object_path (borrow-shared binary) index (borrow-shared jobs_suffix)))
							(let root (call read_job_sysroot (borrow-shared jobs)))
							(set checked (call check_resolved_headers (borrow-shared trace) (borrow-shared root)
								protection (statuses.get index) target_index human))))))
			(return checked)))

	(fn run_parallel_clang
		(:doc "Build numbered objects once, verify their dependencies, and relay their separate diagnostic streams.")
		(params (program (shared-array u8)) (unit (shared-array u8)) (binary (shared-array u8))
			(count i32) (budget i32) (os u8) (library bool) (exports (shared-array u8)) (name (shared-array u8))
			(bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(protection BuildProtection) (target_index i32) (human bool)) (returns NativeTool)
		(body
			(let units (call staged_unit_paths (borrow-shared unit) count))
			(let-mut statuses (array:alloc i32 count))
			(let built (call build_staged_units (borrow-shared program) (borrow-shared units) (borrow-shared binary)
				(u32:from-i32 budget) os library (borrow-shared exports) (borrow-shared name)
				(borrow-shared bytes) (borrow-shared config) invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (borrow-mut statuses)))
			(let checked (call check_object_traces (borrow-shared binary) (borrow-shared statuses)
				built/attempted protection target_index human))
			(if
				(:doc "This link consumes objects only, so its streams contain no frontend graphs.")
				built/link_attempted
				(then
					(let errors (call join_file_path (borrow-shared binary) (borrow-shared linker_stderr)))
					(let output (call join_file_path (borrow-shared binary) (borrow-shared linker_stdout)))
					(call replay_log (borrow-shared errors) 2i32)
					(call replay_log (borrow-shared output) 1i32)))
			(let failed built/failed_unit)
			(let-mut status built/status)
			(if
				(:doc "If Clang succeeded without an image, use the same publication diagnostic as a serial build.")
				(failed.ltz.and (status.eq -3i32))
				(then (set status 0i32)))
			(return (NativeTool.new (status status) (checked checked) (failed_unit failed)))))
)
