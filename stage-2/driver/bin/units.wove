(module staged_unit_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Use the numbered emitter's stable filenames for the staged compiler inputs.")

	(use wove-file "../../emit/units.wove" (only write_unit_name (value unit_name_template)))
	(use wove-file "../paths.wove" (only join_file_path))

	(let program_header "program.h")

	(fn staged_unit_path
		(:doc "Find a numbered body beside the stage's canonical serial source.")
		(params (anchor (shared-array u8)) (index i32)) (returns (owned-array u8))
		(body
			(let-mut name (array.alloc u8 (array.len unit_name_template)))
			(let width (call write_unit_name index (borrow-mut name)))
			(return (call join_file_path (borrow-shared anchor) (borrow-shared (array.range name 0i32 width))))))

	(fn staged_unit_paths
		(:doc "Return the exact ordered input paths for a completely staged numbered graph.")
		(params (anchor (shared-array u8)) (count i32)) (returns (owned-array (owned-array u8)))
		(body
			(let-mut units (array.alloc (owned-array u8) count))
			(for
				(:doc "Link order follows the original numbered ordinals.")
				(let index) (range 0i32 count)
				(body (array.store units index (call staged_unit_path (borrow-shared anchor) index))))
			(return (move units))))
)
