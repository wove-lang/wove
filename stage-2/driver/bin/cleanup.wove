(module private_build_cleanup
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Remove failed private build trees through descriptor-relative POSIX operations.")

	(use wove-file "../paths.wove" (only directory_width))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../../text/equal.wove" (only equal_bytes))
	(use c-header "<dirent.h>" (only fdopendir dirfd readdir closedir))
	(use c-header "<errno.h>" (only errno ENOENT))
	(use c-header "<fcntl.h>" (only openat AT_FDCWD AT_REMOVEDIR O_RDONLY O_DIRECTORY O_CLOEXEC O_NOFOLLOW (type Mode)))
	(use c-header "<unistd.h>" (only close unlinkat))

	(let temporary_name ".wovec-bin.XXXXXX")
	(let current ".")
	(let parent "..")

	(fn open_directory
		(:doc "Open only the directory itself. All child activity stays relative to the resulting descriptor.")
		(params (fd i32) (name (shared-array u8))) (returns i32)
		(body
			(let flags (u32.or (u32.from-i32 O_RDONLY) (u32.or (u32.from-i32 O_DIRECTORY)
				(u32.or (u32.from-i32 O_NOFOLLOW) (u32.from-i32 O_CLOEXEC)))))
			(return (call openat fd (borrow-shared name) (i32.from-u32 flags) (int.convert Mode 0i32)))))

	(fn discard_directory_at
		(:doc "Remove a reserved directory tree without resolving any symlink in the tree.")
		(params (fd i32) (name (shared-array u8))) (returns void)
		(body
			(let descriptor (call open_directory fd (borrow-shared name)))
			(if (i32.ltz descriptor) (then (return)))
			(let-mut directory (call fdopendir descriptor))
			(if
				(:doc "A failed fdopendir leaves the descriptor with the caller.")
				(owner.is-null directory)
				(then
					(let closed (call close descriptor))
					(return)))
			(let inside (call dirfd (borrow-shared directory)))
			(if
				(:doc "A directory stream owns its descriptor until closed.")
				(i32.ltz inside)
				(then (return)))
			(let-mut entries (array.alloc (owned-array u8) 0i32))
			(while
				(:doc "Finish enumerating before deleting entries so the reads do not depend on directory mutation.")
				(bool true)
				(body
					(let entry (call readdir (borrow-mut directory)))
					(if (owner.is-null entry) (then (break)))
					(let child (move (optional.unwrap entry)))
					(if
						(:doc "Neither dot entry names a child of this private directory.")
						(bool.or (call equal_bytes (borrow-shared child) (borrow-shared current))
							(call equal_bytes (borrow-shared child) (borrow-shared parent)))
						(then (continue)))
					(array.push entries (move child))))
			(for
				(:doc "Unlink ordinary entries and symlinks directly. Recurse only through no-follow directory opens.")
				(let child) (borrow-shared entries)
				(body
					(if
						(:doc "A vanished entry requires no further lookup.")
						(bool.and (i32.not-eqz (call unlinkat inside (borrow-shared child) 0i32))
							(i32.not-eq errno ENOENT))
						(then (call discard_directory_at inside (borrow-shared child))))))
			(let closed (call closedir (move directory)))
			(let removed (call unlinkat fd (borrow-shared name) AT_REMOVEDIR))))

	(fn discard_private_stage
		(:doc "Remove only an absolute directory bearing the reserved mkdtemp basename.")
		(params (path (shared-array u8))) (returns void)
		(body
			(let start (call directory_width (borrow-shared path)))
			(let width (array.len temporary_name))
			(if
				(:doc "The entry must retain the template prefix and one complete mkdtemp suffix.")
				(bool.or (i32.lez start)
					(bool.or (i32.not-eq (i32.sub (array.len path) start) width)
						(bool.or (u8.not-eq (array.load path 0i32) 47u8)
							(bool.not (call same_bytes (borrow-shared path) start
								(i32.sub (array.len path) 6i32) (borrow-shared temporary_name) 0i32 (i32.sub width 6i32))))))
				(then (return)))
			(let owner (call open_directory AT_FDCWD (borrow-shared (array.range path 0i32 start))))
			(if (i32.ltz owner) (then (return)))
			(call discard_directory_at owner (borrow-shared (array.range path start (array.len path))))
			(let closed (call close owner))))
)
