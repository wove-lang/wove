(module driver_bin_library
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Select explicit project library entries and publish their native C interface after a successful link.")

	(use c-header "<sys/stat.h>" (only lstat S_ISREG (type Stat)))
	(use c-header "<stdio.h>" (only fopen fgetc rename))
	(use c-header "<unistd.h>" (only linkat unlink close))
	(use c-header "<fcntl.h>" (only open O_RDONLY O_CLOEXEC O_DIRECTORY AT_FDCWD (type Mode)))
	(use c-header "<sys/file.h>" (only flock LOCK_EX))
	(use c-header "<errno.h>" (only errno ENOENT EINTR))
	(use wove-file "../paths.wove" (only directory_width join_file_path))
	(use wove-file "../files.wove" (only path_identity same_path_identity))
	(use wove-file "../output.wove" (only retain_checked_unit))
	(use wove-file "../publication.wove" (only stage_file))
	(use wove-file "../../json/reader.wove" (only json_decode_string (type JsonNode)))
	(use wove-file "../../cli/command/resolve.wove" (only command_setting (type CommandInvocation)))
	(use wove-file "../../cli/command/args.wove" (only (type CommandArgument)))
	(use wove-file "../../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../../emit/library.wove" (only write_library_abi (value library_header_marker)))
	(use wove-file "../../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../../text/copy.wove" (only append_bytes))

	(let library_stage_header "library.h")
	(let library_stage_exports "library.exports")
	(let library_header_backup "library.previous.h")
	(let library_image_backup "library.previous")
	(let linux_library_suffix ".so")
	(let macos_library_suffix ".dylib")
	(let wove_suffix ".wove")
	(let c_header_suffix ".h")
	(let library_prefix "lib")
	(let read_binary "rb")
	(let current_directory ".")

	(fn valid_configured_path
		(:doc "Screen decoded paths before exposing them to a C string parameter.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "An escaped JSON terminator cannot name a filesystem path.")
				(i32.lt index (array.len path))
				(body
					(if (u8.eqz (array.load path index)) (then (return (bool false))))
					(set index (i32.inc index))))
			(return (i32.gtz index))))

	(fn configured_library_entry
		(:doc "Test the effective entry.lib list against the explicit source, including existing filesystem aliases.")
		(params (path (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)))
		(returns bool)
		(body
			(let setting (call command_setting invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) 6u32 24i32))
			(let entry (struct.get setting row))
			(if
				(:doc "An absent list leaves bin in executable mode.")
				(i32.ltz entry)
				(then (return (bool false))))
			(let identity (call path_identity (borrow-shared path)))
			(let-mut row (struct.get (array.load nodes entry) first_child))
			(while
				(:doc "Compare each decoded entry relative to the project working directory.")
				(i32.not-ltz row)
				(body
					(let node (array.load nodes row))
					(let start (struct.get node start))
					(let end (struct.get node end))
					(let-mut bytes (array.alloc u8 (i32.sub end start)))
					(let decoded (call json_decode_string (borrow-shared config)
						start end (borrow-mut bytes)))
					(let candidate (borrow-shared (array.range bytes 0i32 (struct.get decoded written))))
					(if
						(:doc "Exact text can select a missing entry. Existing aliases must name the same file.")
						(bool.and (u32.eqz (struct.get decoded error))
							(bool.or (call same_bytes (borrow-shared path) 0i32 (array.len path)
								(borrow-shared candidate) 0i32 (array.len candidate))
								(bool.and (call valid_configured_path (borrow-shared candidate))
									(call same_path_identity identity (call path_identity (borrow-shared candidate))))))
						(then (return (bool true))))
					(set row (struct.get node next_sibling))))
			(return (bool false))))

	(fn suffix_start
		(:doc "Strip the exact suffix only when it leaves a nonempty final path component.")
		(params (path (shared-array u8)) (suffix (shared-array u8))) (returns i32)
		(body
			(let width (array.len path))
			(let start (i32.sub width (array.len suffix)))
			(if
				(:doc "A suffix may not consume the entire basename.")
				(bool.and (i32.lt (call directory_width (borrow-shared path)) start)
					(call same_bytes (borrow-shared path) start width
						(borrow-shared suffix) 0i32 (array.len suffix)))
				(then (return start)))
			(return width)))

	(fn library_path
		(:doc "Derive the target's libNAME sibling from the explicit Wove input spelling.")
		(params (path (shared-array u8)) (suffix (shared-array u8))) (returns (owned-array u8))
		(body
			(let directory (call directory_width (borrow-shared path)))
			(let stem (call suffix_start (borrow-shared path) (borrow-shared wove_suffix)))
			(let extra (i32.add (array.len library_prefix) (array.len suffix)))
			(if
				(:doc "The prefix and extension must fit the path's signed length.")
				(i32.lt (i32.sub 2147483647i32 extra) stem)
				(then (return (array.alloc u8 0i32))))
			(let-mut result (array.alloc u8 (i32.add stem extra)))
			(let dir (call append_bytes (borrow-shared (array.range path 0i32 directory)) (borrow-mut result) 0i32))
			(let prefix (call append_bytes (borrow-shared library_prefix) (borrow-mut result) dir))
			(let name (call append_bytes (borrow-shared (array.range path directory stem)) (borrow-mut result) prefix))
			(let end (call append_bytes (borrow-shared suffix) (borrow-mut result) name))
			(return (move result))))

	(fn default_library_path
		(:doc "Default to the explicitly selected target's shared library extension.")
		(params (path (shared-array u8)) (os u8)) (returns (owned-array u8))
		(body
			(if
				(:doc "Darwin and Linux use different shared-library extensions.")
				(u8.eq os 2u8)
				(then (return (call library_path (borrow-shared path) (borrow-shared macos_library_suffix)))))
			(return (call library_path (borrow-shared path) (borrow-shared linux_library_suffix)))))

	(fn public_header_path
		(:doc "Replace the selected platform suffix, or append .h to a custom library basename.")
		(params (target (shared-array u8)) (os u8)) (returns (owned-array u8))
		(body
			(let-mut stem (call suffix_start (borrow-shared target) (borrow-shared linux_library_suffix)))
			(if
				(:doc "Darwin uses the complete .dylib extension.")
				(u8.eq os 2u8)
				(then (set stem (call suffix_start (borrow-shared target) (borrow-shared macos_library_suffix)))))
			(if
				(:doc "The sibling name must leave room for its C header suffix.")
				(i32.lt 2147483645i32 stem)
				(then (return (array.alloc u8 0i32))))
			(let-mut header (array.alloc u8 (i32.add stem 2i32)))
			(let start (call append_bytes (borrow-shared (array.range target 0i32 stem)) (borrow-mut header) 0i32))
			(let end (call append_bytes (borrow-shared c_header_suffix) (borrow-mut header) start))
			(return (move header))))

	(fn generated_header
		(:doc "Check the generator marker with a bounded read of a proven regular header.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let file (call fopen (borrow-shared path) (borrow-shared read_binary)))
			(if (owner.is-null file) (then (return (bool false))))
			(let-mut offset 0i32)
			(while
				(:doc "Read only the fixed marker and let the stream owner close at scope exit.")
				(i32.lt offset (array.len library_header_marker))
				(body
					(if
						(:doc "Short or user-written content cannot be replaced.")
						(i32.not-eq (call fgetc (borrow-shared file)) (i32.from-u8 (array.load library_header_marker offset)))
						(then (return (bool false))))
					(set offset (i32.inc offset))))
			(return (bool true))))

	(fn public_header_state
		(:doc "Classify an absent header, an owned generated header, or an entry the compiler cannot replace.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let-mut info (struct.new Stat))
			(let status (call lstat (borrow-shared path) (borrow-mut info)))
			(if
				(:doc "A genuinely absent basename is available. Dangling symlinks are inspected as entries.")
				(i32.not-eqz status)
				(then
					(if (i32.eq errno ENOENT) (then (return 0i32)))
					(return -1i32)))
			(if
				(:doc "Read the marker only on the original regular directory entry.")
				(bool.and (call S_ISREG (struct.get info st_mode)) (call generated_header (borrow-shared path)))
				(then (return 1i32)))
			(return -1i32)))

	(fn stage_abi_file
		(:doc "Measure the exact interface file before staging it beside the private C unit.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (form u32))
		(returns bool)
		(body
			(let-mut empty (array.alloc u8 0i32))
			(let width (call write_library_abi (borrow-shared arena) (borrow-shared nodes) (borrow-shared functions)
				(borrow-shared parameters) (borrow-mut empty) 0u32 0i32 form (bool false)))
			(if
				(:doc "A saturated writer cannot create a complete interface file.")
				(u32.lt 1073741824u32 width)
				(then (return (bool false))))
			(let-mut bytes (array.alloc u8 (i32.from-u32 width)))
			(let written (call write_library_abi (borrow-shared arena) (borrow-shared nodes) (borrow-shared functions)
				(borrow-shared parameters) (borrow-mut bytes) 0u32 0i32 form (bool true)))
			(return (bool.and (u32.eq width written)
				(call stage_file (borrow-shared path) (borrow-shared bytes))))))

	(fn stage_library_abi
		(:doc "Stage the header and native linker allowlist from the checked graph.")
		(params (unit (shared-array u8)) (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (os u8))
		(returns bool)
		(body
			(let header (call join_file_path (borrow-shared unit) (borrow-shared library_stage_header)))
			(let exports (call join_file_path (borrow-shared unit) (borrow-shared library_stage_exports)))
			(let-mut form 2u32)
			(if (u8.eq os 2u8) (then (set form 3u32)))
			(return (bool.and (call stage_abi_file (borrow-shared header) (borrow-shared arena) (borrow-shared nodes)
					(borrow-shared functions) (borrow-shared parameters) 1u32)
				(call stage_abi_file (borrow-shared exports) (borrow-shared arena) (borrow-shared nodes)
					(borrow-shared functions) (borrow-shared parameters) form)))))

	(fn open_library_directory
		(:doc "Open the publication directory itself so locking needs no extra file in the project.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let flags (i32.from-u32 (u32.or (u32.from-i32 O_RDONLY)
				(u32.or (u32.from-i32 O_CLOEXEC) (u32.from-i32 O_DIRECTORY)))))
			(return (call open (borrow-shared path) flags (int.convert Mode 0i32)))))

	(fn lock_library_directory
		(:doc "Serialize publication of adjacent headers and libraries even through directory aliases.")
		(params (target (shared-array u8))) (returns i32)
		(body
			(let width (call directory_width (borrow-shared target)))
			(let-mut descriptor -1i32)
			(if
				(:doc "A bare output name and its header live in the current directory.")
				(i32.eqz width)
				(then (set descriptor (call open_library_directory (borrow-shared current_directory))))
				(else (set descriptor (call open_library_directory (borrow-shared (array.range target 0i32 width))))))
			(if (i32.ltz descriptor) (then (return -1i32)))
			(while
				(:doc "The open description owns the lock until the caller closes it. Retry only interrupted acquisition.")
				(bool true)
				(body
					(if (i32.eqz (call flock descriptor LOCK_EX)) (then (return descriptor)))
					(if
						(:doc "A permanent lock failure cannot publish either artifact.")
						(i32.not-eq errno EINTR)
						(then
							(let closed (call close descriptor))
							(return -1i32)))))))

	(fn link_entry
		(:doc "Create a hard link to the entry itself, preserving a symlink's identity if it is the old binary.")
		(params (source (shared-array u8)) (target (shared-array u8))) (returns bool)
		(body (return (i32.eqz (call linkat AT_FDCWD (borrow-shared source)
			AT_FDCWD (borrow-shared target) 0i32)))))

	(fn save_library_entry
		(:doc "Keep an extant entry under a private name. Only a genuinely absent destination needs no backup.")
		(params (path (shared-array u8)) (backup (shared-array u8))) (returns i32)
		(body
			(if (call link_entry (borrow-shared path) (borrow-shared backup)) (then (return 1i32)))
			(if (i32.eq errno ENOENT) (then (return 0i32)))
			(return -1i32)))

	(fn place_library_entry
		(:doc "Replace a backed-up entry or publish without overwriting an unexpectedly occupied new name.")
		(params (staged (shared-array u8)) (path (shared-array u8)) (saved i32)) (returns bool)
		(body
			(if
				(:doc "Existing files are ready for an atomic replacement after the backup succeeds.")
				(i32.gtz saved)
				(then (return (i32.eqz (call rename (borrow-shared staged) (borrow-shared path))))))
			(return (call link_entry (borrow-shared staged) (borrow-shared path)))))

	(fn restore_library_entry
		(:doc "Restore the previous inode or remove an entry created by the current publication.")
		(params (backup (shared-array u8)) (path (shared-array u8)) (saved i32)) (returns void)
		(body
			(if
				(:doc "A previous entry has a hard link under the private staging directory.")
				(i32.gtz saved)
				(then (let restored (call rename (borrow-shared backup) (borrow-shared path))))
				(else (let removed (call unlink (borrow-shared path)))))))

	(fn publish_library_entries
		(:doc "Install the public pair before retaining C. Roll back changed entries if any operation fails.")
		(params (path (shared-array u8)) (retained (shared-array u8)) (unit (shared-array u8))
			(binary (shared-array u8)) (target (shared-array u8)) (saved_image (shared-array u8)) (image_state i32)
			(staged_header (shared-array u8)) (header (shared-array u8)) (saved_header (shared-array u8)) (header_state i32)
			(target_index i32) (human bool)) (returns i32)
		(body
			(if
				(:doc "A failed header install leaves the image and retained C untouched.")
				(bool.not (call place_library_entry (borrow-shared staged_header) (borrow-shared header) header_state))
				(then (return -1i32)))
			(if
				(:doc "An image install failure restores the header before opening the retained destination.")
				(bool.not (call place_library_entry (borrow-shared binary) (borrow-shared target) image_state))
				(then
					(call restore_library_entry (borrow-shared saved_header) (borrow-shared header) header_state)
					(return -1i32)))
			(let status (call retain_checked_unit (borrow-shared path) (borrow-shared retained)
				(borrow-shared unit) target_index human))
			(if
				(:doc "Retained C replacement is atomic. Restore both public entries when it fails.")
				(i32.not-eqz status)
				(then
					(call restore_library_entry (borrow-shared saved_image) (borrow-shared target) image_state)
					(call restore_library_entry (borrow-shared saved_header) (borrow-shared header) header_state)))
			(return status)))

	(fn install_library
		(:doc "Hold rollback links in the private stage and commit all three artifacts under the caller's directory lock.")
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8))
			(unit (shared-array u8)) (binary (shared-array u8)) (header (shared-array u8)) (target_index i32) (human bool))
		(returns i32)
		(body
			(let header_state (call public_header_state (borrow-shared header)))
			(if (i32.ltz header_state) (then (return -1i32)))
			(let staged_header (call join_file_path (borrow-shared unit) (borrow-shared library_stage_header)))
			(let saved_header (call join_file_path (borrow-shared unit) (borrow-shared library_header_backup)))
			(let saved_image (call join_file_path (borrow-shared unit) (borrow-shared library_image_backup)))
			(let image_state (call save_library_entry (borrow-shared target) (borrow-shared saved_image)))
			(if
				(:doc "A directory or an inaccessible image destination must fail before modifying any artifacts.")
				(i32.ltz image_state)
				(then (return -1i32)))
			(let actual_header (call save_library_entry (borrow-shared header) (borrow-shared saved_header)))
			(let-mut status -1i32)
			(if
				(:doc "Continue only when the header still has the observed presence and both rollback links are ready.")
				(i32.eq actual_header header_state)
				(then
					(set status (call publish_library_entries (borrow-shared path) (borrow-shared retained)
						(borrow-shared unit) (borrow-shared binary) (borrow-shared target)
						(borrow-shared saved_image) image_state (borrow-shared staged_header)
						(borrow-shared header) (borrow-shared saved_header) header_state
						target_index human))))
			(let removed_image (call unlink (borrow-shared saved_image)))
			(let removed_header (call unlink (borrow-shared saved_header)))
			(return status)))
)
