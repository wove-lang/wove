(module native_debug_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Give the private C unit its future source location before Clang compiles it.`)

	(use wove-file "../files.wove" (only file_stamp read_source_file))
	(use wove-file "../paths.wove" (only directory_width join_file_path))
	(use wove-file "../publication.wove" (only stage_file))
	(use wove-file "../../emit/text.wove" (only c_hex_byte))
	(use wove-file "../../text/copy.wove" (only append_bytes))

	(let line_prefix "#line 2 \"")
	(let line_suffix "\"\n")

	(fn debug_directory
		(:doc `Place this build's sources and symbols together under the retained bin directory.`)
		(params (target (shared-array u8)) (retained (shared-array u8)) (stage (shared-array u8)) (mode u32))
		(returns (owned-array u8))
		(body
			(let target_parent (call directory_width (borrow-shared target)))
			(let-mut cache 2i32)
			(if
				(:doc `A bare target uses a retained path starting with ./.`)
				(i32.gtz target_parent)
				(then (set cache target_parent)))
			(if
				(:doc `Only a debug build with a valid retained path needs a per-build destination.`)
				(bool.or (u32.not-eq mode 1u32)
					(i32.not-lt cache (array.len retained)))
				(then
					(let empty (array.alloc u8 0i32))
					(return (move empty))))
			(let absolute (call join_file_path (borrow-shared stage)
				(borrow-shared (array.range retained cache (array.len retained)))))
			(let suffix (call directory_width (borrow-shared stage)))
			(return (call join_file_path (borrow-shared absolute)
				(borrow-shared (array.range stage suffix (array.len stage)))))))

	(fn stage_debug_source
		(:doc `Record a retained filename while keeping each physical source line number unchanged.`)
		(:expect (tests "stage-2/cli/native/debug/cases.tsv") (issues "gh:wove-lang/wove:324"))
		(params (path (shared-array u8)) (retained (shared-array u8)) (source (shared-array u8))) (returns bool)
		(body
			(let path_width (array.len retained))
			(let fixed (i32.add (array.len line_prefix) (array.len line_suffix)))
			(let directive (u64.add (u64.from-i32 fixed)
				(u64.shl (u64.from-i32 path_width) 2i32)))
			(let width (u64.add directive (u64.from-i32 (array.len source))))
			(if
				(:doc `The file writer needs a nonempty filename and a representable extent.`)
				(bool.or (i32.eqz path_width) (u64.lt 2147483647u64 width))
				(then (return (bool false))))
			(let-mut bytes (array.alloc u8 (i32.from-u64 width)))
			(let-mut at (call append_bytes (borrow-shared line_prefix) (borrow-mut bytes) 0i32))
			(let-mut index 0i32)
			(while
				(:doc `Escape each filename byte independently, including quotes and newlines.`)
				(i32.lt index path_width)
				(body
					(array.store bytes at 92u8)
					(array.store bytes (i32.inc at) 120u8)
					(set at (i32.from-u32 (call c_hex_byte (array.load retained index)
						(borrow-mut bytes) (u32.from-i32 (i32.add at 2i32)) (bool true))))
					(set index (i32.inc index))))
			(let start (call append_bytes (borrow-shared line_suffix) (borrow-mut bytes) at))
			(let end (call append_bytes (borrow-shared source) (borrow-mut bytes) start))
			(return (call stage_file (borrow-shared path) (borrow-shared bytes)))))

	(fn name_debug_unit
		(:doc `Add a source location to the generated translation unit before Clang reads it.`)
		(params (unit (shared-array u8)) (retained (shared-array u8))) (returns bool)
		(body
			(let stamp (call file_stamp (borrow-shared unit)))
			(let size (struct.get stamp length))
			(if
				(:doc `A missing private unit cannot be named for debugging.`)
				(i32.ltz size)
				(then (return (bool false))))
			(let-mut emitted (array.alloc u8 size))
			(return (bool.and
				(call read_source_file (borrow-shared unit) stamp (borrow-mut emitted))
				(call stage_debug_source (borrow-shared unit) (borrow-shared retained)
					(borrow-shared emitted))))))
)
