(module driver_bin_image
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check the native image kind before publishing staged libraries or retained-string executables.")

	(use c-header "<fcntl.h>" (only open O_RDONLY O_CLOEXEC O_NOFOLLOW O_NONBLOCK (type Mode)))
	(use c-header "<unistd.h>" (only close read (type Size)))
	(use c-header "<sys/stat.h>" (only fstat S_ISREG (type Stat)))

	(use wove-file "../../c/arguments.wove" (only (value executable_string_marker)))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../files.wove" (only file_stamp read_source_file))

	(fn elf_shared_image
		(:doc "Check ELF identification and ET_DYN at e_type in the encoded byte order.")
		(params (header (shared-array u8))) (returns bool)
		(body
			(let magic (u32:from-be-bytes (borrow-shared (header.range 0i32 4i32))))
			(if (magic.not-eq 0x7f454c46u32) (then (return (bool false))))
			(let data (header.get 5i32))
			(let kind (borrow-shared (header.range 16i32 18i32)))
			(if
				(:doc "ELFDATA2LSB stores the type least-significant byte first.")
				(data.eq 1u8)
				(then (return (u16:eq (u16:from-le-bytes (borrow-shared kind)) 3u16))))
			(return (bool:and (data.eq 2u8)
				(u16:eq (u16:from-be-bytes (borrow-shared kind)) 3u16)))))

	(fn mach_dylib_header
		(:doc "Check the Mach-O magic and MH_DYLIB filetype in the encoded byte order.")
		(params (header (shared-array u8))) (returns bool)
		(body
			(let magic (u32:from-be-bytes (borrow-shared (header.range 0i32 4i32))))
			(let kind (borrow-shared (header.range 12i32 16i32)))
			(if
				(:doc "The swapped Mach magic marks a little-endian header.")
				(bool:or (magic.eq 0xcefaedfeu32) (magic.eq 0xcffaedfeu32))
				(then (return (u32:eq (u32:from-le-bytes (borrow-shared kind)) 6u32))))
			(return (bool:and (bool:or (magic.eq 0xfeedfaceu32) (magic.eq 0xfeedfacfu32))
				(u32:eq (u32:from-be-bytes (borrow-shared kind)) 6u32)))))

	(fn read_image_prefix
		(:doc "Read an exact prefix from a regular staged file and close its descriptor.")
		(params (path (shared-array u8)) (header (mut-array u8))) (returns bool)
		(body
			(let flags (i32:from-u32 (u32:or (u32:from-i32 O_RDONLY)
				(u32:or (u32:from-i32 O_CLOEXEC)
					(u32:or (u32:from-i32 O_NOFOLLOW) (u32:from-i32 O_NONBLOCK))))))
			(let descriptor (call open (borrow-shared path) flags (int:convert Mode 0i32)))
			(if
				(:doc "An unopened path has no readable prefix.")
				descriptor.ltz
				(then (return (bool false))))
			(let-mut info (struct:new Stat))
			(let width (int:convert Size header.len))
			(let valid (bool:and
				(bool:and (i32:eqz (call fstat descriptor (borrow-mut info)))
					(call S_ISREG info/st_mode))
				(i64:eq (int:convert i64 (call read descriptor (borrow-mut header) width))
					(int:convert i64 width))))
			(let closed (call close descriptor))
			(return (valid.and closed.eqz))))

	(fn linked_image
		(:doc "Reject nonregular and nonlibrary output even if the Clang driver reported success.")
		(params (path (shared-array u8)) (os u8)) (returns bool)
		(body
			(let-mut header (array:alloc u8 32i32))
			(if
				(:doc "A regular staged file must contain its complete native header.")
				(bool:not (call read_image_prefix (borrow-shared path) (borrow-mut header)))
				(then (return (bool false))))
			(if
				(:doc "Use the explicit Clang target's executable format.")
				(os.eq 2u8)
				(then (return (call mach_dylib_header (borrow-shared header)))))
			(return (call elf_shared_image (borrow-shared header)))))

	(fn requires_executable_image
		(:doc "Read the process-lifetime requirement from the checked C unit before invoking the linker.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let width executable_string_marker.len)
			(let-mut prefix (array:alloc u8 width))
			(return (bool:and (call read_image_prefix (borrow-shared path) (borrow-mut prefix))
				(call same_bytes (borrow-shared prefix) 0i32 width
					(borrow-shared executable_string_marker) 0i32 width)))))

	(fn image_word
		(:doc "Read one checked binary field of two, four, or eight bytes.")
		(params (bytes (shared-array u8)) (offset i32) (width i32) (little bool)) (returns u64)
		(body
			(let-mut value 0u64)
			(let-mut index 0i32)
			(while
				(:doc "Accumulate bytes in network order regardless of their order in the image.")
				(index.lt width)
				(body
					(let-mut byte_index index)
					(if
						(:doc "A little-endian field starts with the least-significant byte.")
						little
						(then (set byte_index (width.dec.sub index))))
					(let byte (bytes.get (offset.add byte_index)))
					(set value (u64:or (value.shl 8i32) (u64:from-u8 byte)))
					(set index index.inc)))
			(return value)))

	(fn elf_dynamic_pie
		(:doc "Check that PT_DYNAMIC declares DF_1_PIE, which the ELF loader rejects as a shared library.")
		(params (bytes (shared-array u8)) (start u64) (size u64) (width i32) (little bool)) (returns bool)
		(body
			(let length (u64:from-i32 bytes.len))
			(if
				(:doc "Ignore incomplete dynamic tables before converting offsets to slice positions.")
				(bool:or (length.lt start)
					(u64:lt (length.sub start) size))
				(then (return (bool false))))
			(let-mut cursor (i32:from-u64 start))
			(let end (i32:from-u64 (start.add size)))
			(let stride (width.add width))
			(let-mut saw_flags (bool false))
			(let-mut pie (bool false))
			(while
				(:doc "Visit whole dynamic entries only, stopping at the first DT_NULL.")
				(i32:not-lt (end.sub cursor) stride)
				(body
					(let tag (call image_word (borrow-shared bytes) cursor width little))
					(if
						(:doc "DT_NULL terminates the loader's view of this table.")
						tag.eqz
						(then (return pie)))
					(if
						(:doc "DT_FLAGS_1 carries DF_1_PIE in both ELF classes.")
						(tag.eq 0x6ffffffbu64)
						(then
							(if
								(:doc "Duplicate flags make the loader interpretation ambiguous.")
								saw_flags
								(then (return (bool false))))
							(set saw_flags (bool true))
							(let flags (call image_word (borrow-shared bytes)
								(cursor.add width) width little))
							(set pie (u64:not-eqz (flags.and 0x08000000u64)))))
					(set cursor (cursor.add stride))))
			(return (bool false))))

	(fn elf_pie
		(:doc "Find PT_DYNAMIC in a bounded ELF32 or ELF64 program-header table.")
		(params (bytes (shared-array u8)) (wide bool) (little bool)) (returns bool)
		(body
			(let size bytes.len)
			(let-mut header 52i32)
			(let-mut width 4i32)
			(let-mut entries 32i32)
			(let-mut program_offset 28i32)
			(let-mut entry_width 42i32)
			(let-mut dynamic_size 16i32)
			(if
				(:doc "ELF64 widens addresses, file offsets, and the program-header entry layout.")
				wide
				(then
					(set header 64i32)
					(set width 8i32)
					(set entries 56i32)
					(set program_offset 32i32)
					(set entry_width 54i32)
					(set dynamic_size 32i32)))
			(if
				(:doc "The file must contain the complete ELF header before reading table coordinates.")
				(size.lt header)
				(then (return (bool false))))
			(let start (call image_word (borrow-shared bytes) program_offset width little))
			(let stride (call image_word (borrow-shared bytes) entry_width 2i32 little))
			(let count (call image_word (borrow-shared bytes) (entry_width.add 2i32) 2i32 little))
			(let length (u64:from-i32 size))
			(let extent (stride.mul count))
			(if
				(:doc "Only complete entries within the file can describe a loadable segment.")
				(bool:or (stride.not-eq (u64:from-i32 entries))
					(bool:or (length.lt start)
						(u64:lt (length.sub start) extent)))
				(then (return (bool false))))
			(let-mut cursor (i32:from-u64 start))
			(let end (i32:from-u64 (start.add extent)))
			(let-mut found (bool false))
			(let-mut position 0u64)
			(let-mut filesize 0u64)
			(while
				(:doc "The dynamic segment carries loader flags even if the section table was stripped.")
				(cursor.lt end)
				(body
					(let kind (call image_word (borrow-shared bytes) cursor 4i32 little))
					(if
						(:doc "PT_DYNAMIC selects the table consumed by the loader.")
						(kind.eq 2u64)
						(then
							(if
								(:doc "Exactly one dynamic segment can supply loader flags.")
								found
								(then (return (bool false))))
							(set found (bool true))
							(set position (call image_word (borrow-shared bytes)
								(cursor.add width) width little))
							(set filesize (call image_word (borrow-shared bytes)
								(cursor.add dynamic_size) width little))))
					(set cursor (cursor.add entries))))
			(return (found.and (call elf_dynamic_pie (borrow-shared bytes)
				position filesize width little)))))

	(fn linked_executable_image
		(:doc "Accept Mach-O executables and ELF executables, including PIEs that cannot be dlopened.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let-mut header (array:alloc u8 32i32))
			(if
				(:doc "A failed tool artifact cannot provide process-lifetime storage.")
				(bool:not (call read_image_prefix (borrow-shared path) (borrow-mut header)))
				(then (return (bool false))))
			(let magic (call image_word (borrow-shared header) 0i32 4i32 (bool false)))
			(let mach_little (bool:or (magic.eq 0xcefaedfeu64) (magic.eq 0xcffaedfeu64)))
			(if
				(:doc "MH_EXECUTE is the only supported Mach-O type for retained storage.")
				(mach_little.or
					(bool:or (magic.eq 0xfeedfaceu64) (magic.eq 0xfeedfacfu64)))
				(then (return (u64:eq (call image_word (borrow-shared header) 12i32 4i32 mach_little) 2u64))))
			(let class (header.get 4i32))
			(let data (header.get 5i32))
			(if
				(:doc "Both supported ELF classes and byte orders carry the same object-kind field.")
				(bool:not (bool:and (magic.eq 0x7f454c46u64)
					(bool:and (bool:or (class.eq 1u8) (class.eq 2u8))
						(bool:or (data.eq 1u8) (data.eq 2u8)))))
				(then (return (bool false))))
			(let little (data.eq 1u8))
			(let kind (call image_word (borrow-shared header) 16i32 2i32 little))
			(if
				(:doc "ET_EXEC cannot be loaded as an ELF shared object.")
				(kind.eq 2u64)
				(then (return (bool true))))
			(if
				(:doc "An ET_DYN image needs the loader's PIE flag before publication.")
				(kind.not-eq 3u64)
				(then (return (bool false))))
			(let stamp (call file_stamp (borrow-shared path)))
			(let length stamp/length)
			(if
				(:doc "Reject an unsuitable staged file before allocating its snapshot.")
				(length.lt 32i32)
				(then (return (bool false))))
			(let-mut bytes (array:alloc u8 length))
			(return (bool:and (call read_source_file (borrow-shared path) stamp (borrow-mut bytes))
				(call elf_pie (borrow-shared bytes) (class.eq 2u8) little)))))
)
