(module staged_native_build
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Compile ordered staged C units with the bounded runner and link their private objects once.")

	(use wove-file "../arguments.wove" (only frontend_capacity write_probe_options write_plain_argument
		write_library_compile_options write_library_link_options write_link_inputs write_clang_standard write_native_output write_include_trace
		write_frontend_search (value quiet_unused_probe_inputs)))
	(use wove-file "../paths.wove" (only directory_width join_file_path))
	(use wove-file "./jobs.wove" (only clang_trace_environment))
	(use wove-file "./object_jobs.wove" (only run_object_jobs (type ObjectJob)))
	(use wove-file "../../io/process.wove" (only copy_argument valid_program))
	(use wove-file "../../io/process_file.wove" (only start_process_files))
	(use wove-file "../../io/capture/child.wove" (only reap_capture_child))
	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../../text/equal.wove" (only equal_bytes))
	(use wove-file "../../text/decimal_write.wove" (only write_decimal_i32))
	(use wove-file "../../cli/command/args.wove" (only (type CommandArgument)))
	(use wove-file "../../cli/command/resolve.wove" (only (type CommandInvocation)))
	(use wove-file "../../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../../json/reader.wove" (only (type JsonNode)))
	(use c-header "<errno.h>" (only errno ENOENT))
	(use c-header "<sys/stat.h>" (only lstat S_ISREG (type Stat)))
	(use c-header "<unistd.h>" (only environ))

	(struct StagedBuild (fields (status i32) (failed_unit i32) (attempted i32) (link_attempted bool)))

	(let object_prefix "object-")
	(let object_suffix ".o")
	(let stdout_suffix ".stdout")
	(let stderr_suffix ".stderr")
	(let jobs_suffix ".jobs")
	(let linker_stdout "link.stdout")
	(let linker_jobs "link.jobs")
	(let linker_stderr "link.stderr")
	(let compile_only "-c")
	(let language_flag "-x")
	(let c_language "c")
	(let detect_language "none")
	(let quiet_unused "-Qunused-arguments")

	(fn staged_result
		(:doc "Keep the attempted unit prefix and the original child status for diagnostic replay.")
		(params (status i32) (failed_unit i32) (attempted i32) (link_attempted bool)) (returns StagedBuild)
		(body (return (struct:new StagedBuild (status status) (failed_unit failed_unit)
			(attempted attempted) (link_attempted link_attempted)))))

	(fn indexed_object_path
		(:doc "Use the original ordinal for a sibling object or log, independent of completion order.")
		(params (binary (shared-array u8)) (index i32) (suffix (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut name (array:alloc u8 24i32))
			(let start (call append_bytes (borrow-shared object_prefix) (borrow-mut name) 0i32))
			(let digits (call write_decimal_i32 (borrow-mut name) start index))
			(let end (call append_bytes (borrow-shared suffix) (borrow-mut name) digits))
			(return (call join_file_path (borrow-shared binary) (borrow-shared (name.range 0i32 end))))))

	(fn vacant_output
		(:doc "Detect a conflicting private entry before starting Clang, including dangling symlinks.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let-mut info (struct:new Stat))
			(return (bool:and (i32:ltz (call lstat (borrow-shared path) (borrow-mut info))) (i32:eq errno ENOENT)))))

	(fn vacant_image
		(:doc "Reserve the link output separately from the files which capture the process streams.")
		(params (binary (shared-array u8)) (directory i32)) (returns bool)
		(body
			(if
				(:doc "A staged image must have an absolute path with a nonempty basename.")
				(bool:or (i32:not-lt directory binary.len)
					(bool:or (bool:not (call valid_program (borrow-shared binary)))
						(u8:not-eq (binary.get 0i32) 47u8)))
				(then (return (bool false))))
			(let name (borrow-shared (binary.range directory binary.len)))
			(return (bool:and
				(bool:not (bool:or (call equal_bytes (borrow-shared name) (borrow-shared linker_stdout))
					(call equal_bytes (borrow-shared name) (borrow-shared linker_stderr))))
				(call vacant_output (borrow-shared binary))))))

	(fn regular_output
		(:doc "A successful tool must leave a regular staged file rather than a symlink or absent entry.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let-mut info (struct:new Stat))
			(return (bool:and (i32:eqz (call lstat (borrow-shared path) (borrow-mut info)))
				(call S_ISREG info/st_mode)))))

	(fn write_object_frontend
		(:doc "Apply the same library visibility, relocation, and C language flags to objects and their audit.")
		(params (library bool) (output (mut-array u8)) (offset i32)) (returns i32)
		(body
			(let-mut start offset)
			(if
				(:doc "Only library objects need the library compilation defaults.")
				library
				(then (set start (call write_library_compile_options (borrow-mut output) start))))
			(let quiet (call write_plain_argument (borrow-shared quiet_unused) (borrow-mut output) start))
			(let phase (call write_plain_argument (borrow-shared compile_only) (borrow-mut output) quiet))
			(let language (call write_plain_argument (borrow-shared language_flag) (borrow-mut output) phase))
			(return (call write_plain_argument (borrow-shared c_language) (borrow-mut output) language))))

	(fn numbered_probe_arguments
		(:doc "Recover the exact frontend arguments for numbered objects from the checked serial probe arguments.")
		(params (prefix (shared-array u8)) (serial (shared-array u8)) (library bool))
		(returns (owned-array u8))
		(body
			(let size prefix.len)
			(let directory (call directory_width (borrow-shared serial)))
			(if
				(:doc "Only a complete packed prefix and private stage can authorize header replay.")
				(bool:or (i32:eqz directory) (i32:lt 2147483519i32 size))
				(then (return (array:alloc u8 0i32))))
			(let-mut packed (array:alloc u8 (i32:add size 128i32)))
			(let original (call write_frontend_search (borrow-shared (serial.range 0i32 (i32:dec directory)))
				(borrow-mut packed)))
			(let-mut end size)
			(if
				(:doc "The serial library probe already has a final quiet flag. Object compilation adds it after its PIC flags.")
				library
				(then
					(let width quiet_unused_probe_inputs.len)
					(set end (i32:sub end (i32:inc width)))
					(if
						(:doc "A prefix without the expected final argument cannot be repacked for object compilation.")
						(bool:or (i32:ltz end)
							(bool:or (u8:not-eqz (prefix.get (i32:dec size)))
								(bool:not (call same_bytes (borrow-shared prefix) end (i32:dec size)
									(borrow-shared quiet_unused_probe_inputs) 0i32 width))))
						(then (return (array:alloc u8 0i32))))))
			(if
				(:doc "Check that only the driver-owned search prefix is replaced. Keep every user argument in order.")
				(bool:or (bool:or (i32:ltz original) (i32:lt end original))
					(bool:not (call same_bytes (borrow-shared prefix) 0i32 original (borrow-shared packed) 0i32 original)))
				(then (return (array:alloc u8 0i32))))
			(let stage (call write_frontend_search (borrow-shared (serial.range 0i32 directory)) (borrow-mut packed)))
			(if (i32:ltz stage) (then (return (array:alloc u8 0i32))))
			(let forwarded (call append_bytes (borrow-shared (prefix.range original end)) (borrow-mut packed) stage))
			(let written (call write_object_frontend library (borrow-mut packed) forwarded))
			(if (i32:ltz written) (then (return (array:alloc u8 0i32))))
			(return (call copy_argument (borrow-shared (packed.range 0i32 written))))))

	(fn pack_object_arguments
		(:doc "Carry effective driver options to the C compile, including target and SDK options supplied in ldflags.")
		(params (prefix (shared-array u8)) (unit (shared-array u8)) (object (shared-array u8)) (library bool) (traced bool))
		(returns (owned-array u8))
		(body
			(let width (u64:add 128u64 (u64:add (u64:from-i32 prefix.len)
				(u64:add (u64:from-i32 unit.len) (u64:from-i32 object.len)))))
			(if
				(:doc "All per-unit options and paths must fit one packed argv buffer.")
				(u64:gt width 2147483647u64)
				(then (return (array:alloc u8 0i32))))
			(let-mut packed (array:alloc u8 (i32:from-u64 width)))
			(let start (call append_bytes (borrow-shared prefix) (borrow-mut packed) 0i32))
			(let dialect (call write_object_frontend library (borrow-mut packed) start))
			(let input (call write_plain_argument (borrow-shared unit) (borrow-mut packed) dialect))
			(let-mut end (call write_native_output (borrow-shared object) (borrow-mut packed) input))
			(if
				(:doc "Each frontend writes its private include graph alongside that unit's stdout.")
				traced
				(then (set end (call write_include_trace (borrow-mut packed) end))))
			(if (i32:ltz end) (then (return (array:alloc u8 0i32))))
			(return (call copy_argument (borrow-shared (packed.range 0i32 end))))))

	(fn write_objects
		(:doc "Preserve staged unit order when assembling the object inputs. Reset any forwarded language override.")
		(params (objects (shared-array (owned-array u8))) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let quiet (call write_plain_argument (borrow-shared quiet_unused) (borrow-mut output) cursor))
			(let lang (call write_plain_argument (borrow-shared language_flag) (borrow-mut output) quiet))
			(let-mut end (call write_plain_argument (borrow-shared detect_language) (borrow-mut output) lang))
			(for
				(:doc "The object list uses the input ordinal even when compiler jobs finish out of order.")
				(let object) (borrow-shared objects)
				(body (set end (call write_plain_argument (borrow-shared object) (borrow-mut output) end))))
			(return end)))

	(fn link_staged_objects
		(:doc "Run one link with private output and logs, waiting even if closing a parent descriptor failed.")
		(params (program (shared-array u8)) (packed (shared-array u8)) (binary (shared-array u8)) (attempted i32) (traced bool))
		(returns StagedBuild)
		(body
			(let trace (call join_file_path (borrow-shared binary) (borrow-shared linker_stdout)))
			(let errors (call join_file_path (borrow-shared binary) (borrow-shared linker_stderr)))
			(let-mut environment environ)
			(if
				(:doc "Override inherited option logging just as for the serial Clang command.")
				traced
				(then
					(let log (call join_file_path (borrow-shared binary) (borrow-shared linker_jobs)))
					(set environment (call clang_trace_environment (borrow-shared log)))))
			(let child (call start_process_files (borrow-shared program) (borrow-shared packed)
				(borrow-shared trace) (borrow-shared errors) (borrow-shared environment)))
			(let pid child/pid)
			(let-mut status -1i32)
			(if
				(:doc "Every positive PID belongs to this link invocation and must be collected.")
				(i32:gtz pid)
				(then
					(let reaped (call reap_capture_child pid))
					(if child/ok (then (set status reaped)))))
			(if
				(:doc "Treat success without a new regular image as a failed staged output.")
				(bool:and (i32:eqz status) (bool:not (call regular_output (borrow-shared binary))))
				(then (set status -3i32)))
			(return (call staged_result status -1i32 attempted (bool true)))))

	(fn build_staged_units
		(:doc `Give each staged C unit a private object and run a single link after all compiles succeed.

		The caller supplies ordered C paths and an unused image path in an
		absolute private directory, plus the effective target OS and resolved
		bin options. For shared images it supplies the staged export list and
		the final basename. Forwarded compiler options must support separate
		compile and link phases. The caller owns stage cleanup, image validation
		and publication. Supply one trace status slot per unit to record
		dependencies and child statuses, or an empty view to omit tracing. The object-N.stdout, object-N.stderr and link.* logs
		remain in the stage for replay. Status -3 means missing or nonregular
		tool output. failed_unit is -1 outside an identified compile.`)
		(:expect (tests "stage-2/cli/native/staged_build/cases.jsonc") (issues "gh:wove-lang/wove:218"))
		(params (program (shared-array u8)) (units (shared-array (owned-array u8))) (binary (shared-array u8))
			(budget u32) (os u8) (library bool) (exports (shared-array u8)) (name (shared-array u8))
			(bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(trace_statuses (mut-array i32)))
		(returns StagedBuild)
		(body
			(let count units.len)
			(let traced (i32:gtz trace_statuses.len))
			(let directory (call directory_width (borrow-shared binary)))
			(if
				(:doc "Require a nonempty build, a resolved bin invocation and an unused private image path.")
				(bool:or (bool:or (bool:or (i32:eqz count) (u32:eqz budget))
						(bool:and traced (i32:not-eq trace_statuses.len count)))
					(bool:or (u32:not-eq invocation/command 2u32)
						(bool:not (call vacant_image (borrow-shared binary) directory))))
				(then (return (call staged_result -1i32 -1i32 0i32 (bool false)))))
			(if
				(:doc "A shared image requires the resolved platform, export list, and final basename.")
				(bool:and library
					(bool:or (bool:not (bool:or (u8:eq os 1u8) (u8:eq os 2u8)))
						(bool:or (i32:eqz exports.len) (i32:eqz name.len))))
				(then (return (call staged_result -1i32 -1i32 0i32 (bool false)))))
			(let object_paths (u64:mul (u64:from-i32 count) (u64:add 20u64 (u64:from-i32 directory))))
			(let paths (u64:add (u64:add object_paths (u64:from-i32 directory))
				(u64:add (u64:from-i32 binary.len)
					(u64:add (u64:from-i32 exports.len) (u64:from-i32 name.len)))))
			(let capacity (call frontend_capacity bytes.len config.len
				invocation/rows paths))
			(let-mut options (array:alloc u8 capacity))
			(let frontend (call write_probe_options (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)
				(borrow-shared (binary.range 0i32 directory)) (bool false) (borrow-mut options)))
			(let common frontend/common_end)
			(if (i32:ltz common) (then (return (call staged_result -1i32 -1i32 0i32 (bool false)))))
			(let-mut jobs (array:alloc ObjectJob count))
			(let-mut objects (array:alloc (owned-array u8) count))
			(for
				(:doc "Prepare all jobs and validate argument packing before starting any child.")
				(let index) (range 0i32 count)
				(body
					(let unit (borrow-shared (units.get index)))
					(let object (call indexed_object_path (borrow-shared binary) index (borrow-shared object_suffix)))
					(if
						(:doc "An input or reserved private object path cannot be silently interpreted as another option or overwritten.")
						(bool:or (bool:not (call valid_program (borrow-shared unit)))
							(bool:or (u8:not-eq (unit.get 0i32) 47u8)
								(bool:not (call vacant_output (borrow-shared object)))))
						(then (return (call staged_result -1i32 index 0i32 (bool false)))))
					(let packed (call pack_object_arguments
						(borrow-shared (options.range 0i32 frontend/probe_end))
						(borrow-shared unit) (borrow-shared object) library traced))
					(if (i32:eqz packed.len) (then (return (call staged_result -1i32 index 0i32 (bool false)))))
					(let-mut environment environ)
					(if
						(:doc "Only the compile jobs have frontend sysroots to capture.")
						traced
						(then
							(let log (call indexed_object_path (borrow-shared binary) index (borrow-shared jobs_suffix)))
							(set environment (call clang_trace_environment (borrow-shared log)))))
					(jobs.set index (struct:new ObjectJob (arguments (move packed))
						(stdout_path (call indexed_object_path (borrow-shared binary) index (borrow-shared stdout_suffix)))
						(stderr_path (call indexed_object_path (borrow-shared binary) index (borrow-shared stderr_suffix)))
						(environment (move environment))))
					(objects.set index (move object))))
			(let inputs (call write_objects (borrow-shared objects) (borrow-mut options) common))
			(let-mut links (call write_link_inputs (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) os (borrow-mut options) inputs))
			(if
				(:doc "A shared image uses only the platform's link options in this phase.")
				library
				(then (set links (call write_library_link_options os (borrow-shared exports) (borrow-shared name)
					(borrow-mut options) links))))
			(let standard (call write_clang_standard frontend/standard (borrow-mut options) links))
			(let end (call write_native_output (borrow-shared binary) (borrow-mut options) standard))
			(if (i32:ltz end) (then (return (call staged_result -1i32 -1i32 0i32 (bool false)))))
			(let compiled (call run_object_jobs (borrow-shared program) (borrow-shared jobs) budget))
			(let attempted compiled/attempted)
			(if
				(:doc "Record exact status for each attempted trace, including launches without a capture file.")
				traced
				(then
					(let statuses (borrow-shared compiled/statuses))
					(for
						(:doc "Unattempted rows have no include graph to validate.")
						(let index) (range 0i32 attempted)
						(body (trace_statuses.set index (statuses.get index))))))
			(if
				(:doc "The runner returns after reaping every started compiler. A failed compile prevents linking.")
				(i32:not-eqz compiled/status)
				(then (return (call staged_result compiled/status
					compiled/failed_job attempted (bool false)))))
			(for
				(:doc "A wrapper can report success without compiling. Check every required object before the link.")
				(let index) (range 0i32 count)
				(body
					(if (bool:not (call regular_output (borrow-shared (objects.get index))))
						(then (return (call staged_result -3i32 index attempted (bool false)))))))
			(if
				(:doc "The linker must receive its own absent destination even after compiler side outputs are created.")
				(bool:not (call vacant_output (borrow-shared binary)))
				(then (return (call staged_result -1i32 -1i32 attempted (bool false)))))
			(return (call link_staged_objects (borrow-shared program)
				(borrow-shared (options.range 0i32 end)) (borrow-shared binary) attempted traced))))
)
