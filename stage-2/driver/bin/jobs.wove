(module native_clang_jobs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read the frontend sysroot from Clang's job log. Clang removes this prefix from DOT paths.

	The log uses two per-child environment settings. Caller dependency and
	compilation database flags pass through to Clang with their original meaning.`)

	(use c-header "<unistd.h>" (only environ))
	(use wove-file "../files.wove" (only empty_path file_stamp read_source_file))
	(use wove-file "../../io/process.wove" (only copy_argument))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../../text/copy.wove" (only append_bytes))

	(let log_key "CC_PRINT_OPTIONS=")
	(let path_key "CC_PRINT_OPTIONS_FILE=")
	(let enable_log "CC_PRINT_OPTIONS=1")
	(let sysroot_flag "\"-isysroot\"")
	(let root_separator "/")

	(fn has_key
		(:doc `Match a complete environment key including its equals separator.`)
		(params (entry (shared-array u8)) (key (shared-array u8))) (returns bool)
		(body
			(let width (array:len key))
			(return (bool:and (i32:not-lt (array:len entry) width)
				(call same_bytes (borrow-shared entry) 0i32 width
					(borrow-shared key) 0i32 width)))))

	(fn trace_setting
		(:doc `Identify the two entries managed in the child environment.`)
		(params (entry (shared-array u8))) (returns bool)
		(body (return (bool:or (call has_key (borrow-shared entry) (borrow-shared log_key))
			(call has_key (borrow-shared entry) (borrow-shared path_key))))))

	(fn clang_trace_environment
		(:doc `Build a child-owned environment without changing the running driver's environment.`)
		(params (path (shared-array u8))) (returns (owned-array (owned-array u8)))
		(body
			(let inherited environ)
			(let-mut count 2i32)
			(let-mut index 0i32)
			(while
				(:doc `Allocate exactly enough rows to keep all non-trace settings.`)
				(i32:lt index (array:len inherited))
				(body
					(if
						(:doc `The private settings take the place of any previous trace values in this child.`)
						(bool:not (call trace_setting (borrow-shared (array:get inherited index))))
						(then (set count (i32:inc count))))
					(set index (i32:inc index))))
			(let-mut rows (array:alloc (owned-array u8) count))
			(array:set rows 0i32 (call copy_argument (borrow-shared enable_log)))
			(let-mut assignment (array:alloc u8 (i32:add (array:len path_key) (array:len path))))
			(let start (call append_bytes (borrow-shared path_key) (borrow-mut assignment) 0i32))
			(let end (call append_bytes (borrow-shared path) (borrow-mut assignment) start))
			(array:set rows 1i32 (move assignment))
			(set index 0i32)
			(let-mut next 2i32)
			(while
				(:doc `Copy surviving environment entries with their exact byte values and original ordering.`)
				(i32:lt index (array:len inherited))
				(body
					(if
						(:doc `Each retained row owns its own copy for the native call.`)
						(bool:not (call trace_setting (borrow-shared (array:get inherited index))))
						(then
							(array:set rows next
								(call copy_argument (borrow-shared (array:get inherited index))))
							(set next (i32:inc next))))
					(set index (i32:inc index))))
			(return (move rows))))

	(fn command_start
		(:doc `Find the first logged command, skipping log markers and the integrated frontend notice.`)
		(params (source (shared-array u8))) (returns i32)
		(body
			(let-mut cursor 0i32)
			(while
				(:doc `Clang prefixes each argument line with space and a quoted executable.`)
				(i32:lt (i32:inc cursor) (array:len source))
				(body
					(if
						(:doc `A quoted executable at the start of a line begins the command.`)
						(bool:and (u8:eq (array:get source cursor) 32u8)
							(u8:eq (array:get source (i32:inc cursor)) 34u8))
						(then (return (i32:inc cursor))))
					(while
						(:doc `Advance past a marker line without examining its contents as options.`)
						(bool:and (i32:lt cursor (array:len source))
							(u8:not-eq (array:get source cursor) 10u8))
						(body (set cursor (i32:inc cursor))))
					(if (i32:eq cursor (array:len source)) (then (return -1i32)))
					(set cursor (i32:inc cursor))))
			(return -1i32)))

	(fn quoted_end
		(:doc `Find the end of a command argument, skipping the escaped byte after each backslash.`)
		(params (source (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut cursor (i32:inc start))
			(while
				(:doc `A trailing incomplete escape or an unclosed argument makes the log unusable.`)
				(i32:lt cursor (array:len source))
				(body
					(let byte (array:get source cursor))
					(if (u8:eq byte 34u8) (then (return (i32:inc cursor))))
					(set cursor (i32:inc cursor))
					(if
						(:doc `Skip the escaped quote, backslash, or dollar sign emitted by LLVM's argument printer.`)
						(bool:and (u8:eq byte 92u8) (i32:lt cursor (array:len source)))
						(then (set cursor (i32:inc cursor))))))
			(return -1i32)))

	(fn copy_sysroot
		(:doc `Copy the logged argument bytes, decoding the driver's backslash escapes.`)
		(params (source (shared-array u8)) (start i32) (end i32)) (returns (owned-array u8))
		(body
			(let-mut cursor start)
			(let-mut count (i32:sub end start))
			(while
				(:doc `Count escapes to allocate the exact physical path length.`)
				(i32:lt cursor end)
				(body
					(if
						(:doc `Each backslash marks the next byte as literal.`)
						(u8:eq (array:get source cursor) 92u8)
						(then
							(set count (i32:dec count))
							(set cursor (i32:inc cursor))))
					(set cursor (i32:inc cursor))))
			(let-mut output (array:alloc u8 count))
			(set cursor start)
			(let-mut index 0i32)
			(while
				(:doc `Keep every literal byte and remove only the command printer's escapes.`)
				(i32:lt cursor end)
				(body
					(if
						(:doc `Logs escape this byte even when it is part of a filesystem name.`)
						(u8:eq (array:get source cursor) 92u8)
						(then (set cursor (i32:inc cursor))))
					(array:set output index (array:get source cursor))
					(set index (i32:inc index))
					(set cursor (i32:inc cursor))))
			(return (move output))))

	(fn first_job_sysroot
		(:doc `Use the last sysroot option in the first frontend job. This native invocation shares one target environment.`)
		(params (source (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut cursor (call command_start (borrow-shared source)))
			(let-mut start -1i32)
			(let-mut end -1i32)
			(let-mut value (bool false))
			(while
				(:doc `Printed command words are double-quoted and separated by one space.`)
				(bool:and (bool:and (i32:lt -1i32 cursor) (i32:lt cursor (array:len source)))
					(u8:eq (array:get source cursor) 34u8))
				(body
					(let limit (call quoted_end (borrow-shared source) cursor))
					(if (i32:ltz limit) (then (return (call empty_path))))
					(if
						(:doc `The word after the flag is its path even when it happens to look like another option.`)
						value
						(then
							(set start (i32:inc cursor))
							(set end (i32:dec limit))
							(set value (bool false)))
						(else
							(set value (call same_bytes (borrow-shared source) cursor limit
								(borrow-shared sysroot_flag) 0i32 (array:len sysroot_flag)))))
					(set cursor -1i32)
					(if
						(:doc `A newline or end of input ends the first job.`)
						(bool:and (i32:lt limit (array:len source)) (u8:eq (array:get source limit) 32u8))
						(then (set cursor (i32:inc limit))))))
			(if
				(:doc `Clang defaults to the ordinary filesystem root when no sysroot is configured.`)
				(i32:ltz start)
				(then (return (call copy_argument (borrow-shared root_separator)))))
			(return (call copy_sysroot (borrow-shared source) start end))))

	(fn read_job_sysroot
		(:doc `Read Clang's complete private option log before reconstructing filesystem paths.`)
		(params (path (shared-array u8))) (returns (owned-array u8))
		(body
			(let stamp (call file_stamp (borrow-shared path)))
			(let width (struct:get stamp length))
			(if (i32:lt width 1i32) (then (return (call empty_path))))
			(let-mut source (array:alloc u8 width))
			(if
				(:doc `A missing or unusable report gives no additional filesystem prefix.`)
				(bool:not (call read_source_file (borrow-shared path) stamp (borrow-mut source)))
				(then (return (call empty_path))))
			(return (call first_job_sysroot (borrow-shared source)))))
)
