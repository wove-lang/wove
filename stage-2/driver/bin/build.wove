(module native_bin_build
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compile one native C unit and publish the staged executable or shared library.

	The private directory holds an immutable copy of the generated C and
	the embedded runtime. Clang never receives the final executable path.
	Ordinary builds keep checked C after a tool failure. Debug builds
	commit each executable against its own retained source and symbols.`)

	(use (:pragma (cfg (os "linux"))) c-header "<stdlib.h>" (only mkdtemp))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only mkdtemp))
	(use c-header "<unistd.h>" (only access X_OK unlink rmdir close))
	(use c-header "<stdio.h>" (only rename))
	(use c-header "<sys/stat.h>" (only lstat S_ISREG (type Stat)))
	(use wove-file "../clang.wove" (only clang_program))
	(use wove-file "../arguments.wove" (only frontend_capacity write_probe_options write_probe_libraries write_clang_arguments))
	(use wove-file "./image.wove" (only linked_image requires_executable_image linked_executable_image))
	(use wove-file "./library.wove" (only lock_library_directory install_library (value library_stage_header) (value library_stage_exports)))
	(use wove-file "../../source/target.wove" (only (type SelectionContext)))
	(use wove-file "./debug.wove" (only debug_directory name_debug_unit stage_debug_source))
	(use wove-file "./cleanup.wove" (only discard_private_stage (value temporary_name)))
	(use wove-file "./dependencies.wove" (only check_resolved_headers))
	(use wove-file "./jobs.wove" (only clang_trace_environment read_job_sysroot))
	(use wove-file "./parallel_options.wove" (only parallel_partition))
	(use wove-file "./parallel.wove" (only run_parallel_clang (type NativeTool)))
	(use wove-file "../../emit/units.wove" (only write_unit_name (value unit_name_template)))
	(use wove-file "../output.wove" (only retain_checked_unit))
	(use wove-file "../diagnostics.wove" (only report_argv (value project_file)))
	(use wove-file "../protection.wove" (only (type BuildProtection)))
	(use wove-file "../publication.wove" (only ensure_parents stage_file))
	(use wove-file "../files.wove" (only canonical_path path_identity same_path_identity))
	(use wove-file "../paths.wove" (only directory_width join_file_path))
	(use wove-file "../source.wove" (only compile_input))
	(use wove-file "../target.wove" (only effective_selection))
	(use wove-file "../../cli/command/resolve.wove" (only (type CommandInvocation)))
	(use wove-file "../../cli/command/args.wove" (only (type CommandArgument)))
	(use wove-file "../../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../io/process_file.wove" (only run_process_stdout_file))
	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../../text/decimal_write.wove" (only write_decimal_i32))

	(struct NativeBuild (fields (status i32) (retained bool) (numbered bool)))

	(let main_suffix "/main.c")
	(let binary_suffix "/program")
	(let source_suffix "/wove_runtime.c")
	(let header_suffix "/wove_runtime.h")
	(let dependency_suffix "/clang.stdout")
	(let job_suffix "/clang.jobs")
	(let publish_library_failure "could not publish shared library")
	(let publish_binary_failure "could not publish executable")
	(let retained_image_failure "retained C strings require an executable image")
	(let native_argument_failure "could not pack native compiler arguments")
	(let clang_failure "clang failed with status ")
	(let compile_unit " while compiling ")

	(fn empty_path
		(:doc `Return a zero-length owner to mark a failed path operation.`)
		(params) (returns (owned-array u8))
		(body
			(let path (array:alloc u8 0i32))
			(return (move path))))

	(fn empty_bytes
		(:doc `Check an owned byte buffer through its borrowed view.`)
		(params (bytes (shared-array u8))) (returns bool)
		(body (return (i32:eqz (array:len bytes)))))

	(fn append_path
		(:doc `Join a private directory with a fixed filename suffix within the signed byte ABI.`)
		(params (directory (shared-array u8)) (suffix (shared-array u8))) (returns (owned-array u8))
		(body
			(let start (array:len directory))
			(let width (array:len suffix))
			(if
				(:doc `Neither a failed directory nor an unrepresentable path can name a staged file.`)
				(bool:or (i32:eqz start)
					(i32:lt (i32:sub 2147483647i32 width) start))
				(then (return (call empty_path))))
			(let-mut path (array:alloc u8 (i32:add start width)))
			(let first (call append_bytes (borrow-shared directory) (borrow-mut path) 0i32))
			(let end (call append_bytes (borrow-shared suffix) (borrow-mut path) first))
			(return (move path))))

	(fn stage_directory
		(:doc `Create a private sibling directory on the output filesystem.`)
		(params (target (shared-array u8))) (returns (owned-array u8))
		(body
			(if
				(:doc `Prepare only the parent directories before reserving the private stage.`)
				(bool:not (call ensure_parents (borrow-shared target)))
				(then (return (call empty_path))))
			(let parent (call directory_width (borrow-shared target)))
			(let suffix (array:len temporary_name))
			(if
				(:doc `The mkdtemp template must fit one byte slice.`)
				(i32:lt (i32:sub 2147483647i32 suffix) parent)
				(then (return (call empty_path))))
			(let-mut template (array:alloc u8 (i32:add parent suffix)))
			(let copied (call append_bytes (borrow-shared (array:range target 0i32 parent))
				(borrow-mut template) 0i32))
			(let end (call append_bytes (borrow-shared temporary_name) (borrow-mut template) copied))
			(let created (call mkdtemp (borrow-mut template)))
			(if
				(:doc `A failed reservation owns no directory.`)
				(owner:is-null created)
				(then (return (call empty_path))))
			(let directory (move (optional:unwrap created)))
			(let absolute (call canonical_path (borrow-shared directory)))
			(if
				(:doc `Remove the directory if we cannot give Clang an absolute argument path.`)
				(call empty_bytes (borrow-shared absolute))
				(then (let removed (call rmdir (borrow-shared directory)))))
			(return (move absolute))))

	(fn report_clang_status
		(:doc `Make the native status visible in the diagnostic and propagate child exit or signal status.`)
		(params (status i32) (failed_unit i32) (human bool)) (returns i32)
		(body
			(let capacity (i32:add (i32:add (array:len clang_failure) 11i32)
				(i32:add (array:len compile_unit) (array:len unit_name_template))))
			(let-mut message (array:alloc u8 capacity))
			(let start (call append_bytes (borrow-shared clang_failure) (borrow-mut message) 0i32))
			(let-mut end (call write_decimal_i32 (borrow-mut message) start status))
			(if
				(:doc "A failed object adds its deterministic source-unit name to the existing native error.")
				(i32:not-ltz failed_unit)
				(then
					(let at (call append_bytes (borrow-shared compile_unit) (borrow-mut message) end))
					(let width (call write_unit_name failed_unit (borrow-mut (array:range message at capacity))))
					(set end (i32:add at width))))
			(let diagnostic (call report_argv 68u32 0i32 (borrow-shared (array:range message 0i32 end)) human))
			(if (i32:gtz status) (then (return status)))
			(return diagnostic)))

	(fn protected_target
		(:doc `Preserve the entry and project configuration when the output aliases either file.`)
		(params (path (shared-array u8)) (target (shared-array u8))) (returns bool)
		(body
			(let output (call path_identity (borrow-shared target)))
			(return (bool:or (call same_path_identity output (call path_identity (borrow-shared path)))
				(call same_path_identity output (call path_identity (borrow-shared project_file)))))))

	(fn install_binary
		(:doc `Publish only a regular executable present after successful Clang completion.`)
		(params (path (shared-array u8)) (target (shared-array u8)) (binary (shared-array u8)) (target_index i32) (human bool))
		(returns i32)
		(body
			(let-mut info (struct:new Stat))
			(let inspected (call lstat (borrow-shared binary) (borrow-mut info)))
			(let regular (bool:and (i32:eqz inspected) (call S_ISREG (struct:get info st_mode))))
			(if
				(:doc `Only a regular directory entry can remain executable after the rename.`)
				(bool:and regular
					(bool:and (i32:eqz (call access (borrow-shared binary) X_OK))
						(bool:and (bool:not (call protected_target (borrow-shared path) (borrow-shared target)))
							(i32:eqz (call rename (borrow-shared binary) (borrow-shared target))))))
				(then (return 0i32)))
			(return (call report_argv 69u32 target_index (borrow-shared publish_binary_failure) human))))

	(fn run_clang_with_trace
		(:doc `Observe the tool’s complete stdout and effective job settings before publishing its results.`)
		(params (program (shared-array u8)) (packed (shared-array u8)) (trace (shared-array u8))
			(jobs (shared-array u8)) (protection BuildProtection) (target_index i32) (human bool)) (returns NativeTool)
		(body
			(let environment (call clang_trace_environment (borrow-shared jobs)))
			(let status (call run_process_stdout_file (borrow-shared program) (borrow-shared packed)
				(borrow-shared trace) (borrow-shared environment)))
			(let root (call read_job_sysroot (borrow-shared jobs)))
			(let checked (call check_resolved_headers (borrow-shared trace) (borrow-shared root)
				protection status target_index human))
			(return (struct:new NativeTool (status status) (checked checked) (failed_unit -1i32)))))

	(fn native_build_result
		(:doc `Keep the public status with whether optional side outputs may enter the retained tree.`)
		(params (status i32) (retained bool)) (returns NativeBuild)
		(body (return (struct:new NativeBuild (status status) (retained retained) (numbered (bool false))))))

	(fn publish_debug
		(:doc `Make the complete debug directory available before installing the executable that names it.`)
		(params (path (shared-array u8)) (target (shared-array u8)) (directory (shared-array u8))
			(debug (shared-array u8)) (trace (shared-array u8)) (jobs (shared-array u8)) (target_index i32) (human bool))
		(returns i32)
		(body
			(let removed_trace (call unlink (borrow-shared trace)))
			(let removed_jobs (call unlink (borrow-shared jobs)))
			(if
				(:doc `A relocation failure leaves the previous debug build and executable intact.`)
				(bool:not (bool:and (call ensure_parents (borrow-shared debug))
					(i32:eqz (call rename (borrow-shared directory) (borrow-shared debug)))))
				(then (return (call report_argv 69u32 target_index (borrow-shared publish_binary_failure) human))))
			(let binary (call append_path (borrow-shared debug) (borrow-shared binary_suffix)))
			(let status (call install_binary (borrow-shared path) (borrow-shared target)
				(borrow-shared binary) target_index human))
			(if
				(:doc `An unsuccessful executable rename discards only this build's unpublished source and symbols.`)
				(i32:gtz status)
				(then (call discard_private_stage (borrow-shared debug))))
			(return status)))

	(fn stage_runtime_asset
		(:doc `Keep the included runtime file reachable from debug line tables after publication.`)
		(params (path (shared-array u8)) (debug (shared-array u8)) (suffix (shared-array u8))
			(source (shared-array u8))) (returns bool)
		(body
			(if
				(:doc `Ordinary builds stage only the original embedded runtime bytes.`)
				(call empty_bytes (borrow-shared debug))
				(then (return (call stage_file (borrow-shared path) (borrow-shared source)))))
			(let retained (call append_path (borrow-shared debug) (borrow-shared suffix)))
			(return (call stage_debug_source (borrow-shared path) (borrow-shared retained)
				(borrow-shared source)))))

	(fn publish_library
		(:doc "Hold the destination directory lock across retained C and public interface publication.")
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8))
			(unit (shared-array u8)) (binary (shared-array u8)) (public_header (shared-array u8)) (os u8) (target_index i32) (human bool))
		(returns NativeBuild)
		(body
			(let lock (call lock_library_directory (borrow-shared target)))
			(if
				(:doc "A lock failure leaves the old retained and published files untouched.")
				(i32:ltz lock)
				(then (return (call native_build_result
					(call report_argv 69u32 target_index (borrow-shared publish_library_failure) human) (bool false)))))
			(let result (call publish_locked_library (borrow-shared path) (borrow-shared target) (borrow-shared retained)
				(borrow-shared unit) (borrow-shared binary) (borrow-shared public_header) os target_index human))
			(let released (call close lock))
			(return result)))

	(fn publish_locked_library
		(:doc "Verify the staged file before retaining C or publishing the adjacent public ABI.")
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8))
			(unit (shared-array u8)) (binary (shared-array u8)) (public_header (shared-array u8)) (os u8) (target_index i32) (human bool))
		(returns NativeBuild)
		(body
			(if
				(:doc "Require a supported linked image and destinations that are still safe to replace.")
				(bool:or (bool:not (call linked_image (borrow-shared binary) os))
					(call protected_target (borrow-shared path) (borrow-shared target)))
				(then (return (call native_build_result
					(call report_argv 69u32 target_index (borrow-shared publish_library_failure) human) (bool false)))))
			(let status (call install_library (borrow-shared path) (borrow-shared target) (borrow-shared retained)
				(borrow-shared unit) (borrow-shared binary) (borrow-shared public_header) target_index human))
			(if
				(:doc "An image or header publication failure has no separate retained-C diagnostic.")
				(i32:ltz status)
				(then (return (call native_build_result
					(call report_argv 69u32 target_index (borrow-shared publish_library_failure) human) (bool false)))))
			(return (call native_build_result status (i32:eqz status)))))

	(fn build_in_directory
		(:doc `Keep the runtime and executable private until the generated source has compiled successfully.`)
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8))
			(protection BuildProtection) (target_index i32) (library_context SelectionContext)
			(public_header (shared-array u8)) (directory (shared-array u8))
			(debug (shared-array u8)) (unit (shared-array u8))
			(runtime (shared-array u8)) (header (shared-array u8)) (binary (shared-array u8)) (trace (shared-array u8)) (jobs (shared-array u8))
			(bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool)) (returns NativeBuild)
		(body
			(let runtime_source (embed "../../../runtime/wove_runtime.c"))
			(let runtime_header (embed "../../../runtime/wove_runtime.h"))
			(if
				(:doc `Both runtime assets must be available next to the private generated C unit.`)
				(bool:not (bool:and (call stage_runtime_asset (borrow-shared runtime) (borrow-shared debug)
						(borrow-shared source_suffix) (borrow-shared runtime_source))
					(call stage_runtime_asset (borrow-shared header) (borrow-shared debug)
						(borrow-shared header_suffix) (borrow-shared runtime_header))))
				(then (return (call native_build_result
					(call report_argv 69u32 target_index (borrow-shared publish_binary_failure) human) (bool false)))))
			(let library_os (struct:get library_context os))
			(let library (u8:not-eqz library_os))
			(let exports (call join_file_path (borrow-shared unit) (borrow-shared library_stage_exports)))
			(let name (borrow-shared (array:range target (call directory_width (borrow-shared target)) (array:len target))))
			(let-mut paths (u64:add (u64:from-i32 (array:len directory))
				(u64:add (u64:from-i32 (array:len unit)) (u64:from-i32 (array:len binary)))))
			(if
				(:doc "The shared link also carries an allowlist path and the final library basename.")
				library
				(then (set paths (u64:add paths
					(u64:add 256u64 (u64:add (u64:from-i32 (array:len exports)) (u64:from-i32 (array:len name))))))))
			(let capacity (call frontend_capacity (array:len bytes) (array:len config)
				(array:len arguments) paths))
			(let-mut options (array:alloc u8 capacity))
			(let frontend (call write_probe_options (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes)
				(borrow-shared settings) (borrow-shared directory) library (borrow-mut options)))
			(let probe_end (struct:get frontend probe_end))
			(let libraries_end (call write_probe_libraries (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes)
				(borrow-shared settings) (borrow-mut options) probe_end))
			(let-mut context library_context)
			(if
				(:doc "The ordinary binary still resolves its own target from the staged frontend options.")
				(bool:not library)
				(then (set context (call effective_selection (borrow-shared (array:range options 0i32 probe_end))))))
			(let partition (call parallel_partition invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) (borrow-shared (array:range options 0i32 probe_end))))
			(let emitted (call compile_input (borrow-shared path) (borrow-shared retained)
				(borrow-shared unit) (borrow-shared (array:range options 0i32 probe_end))
				(borrow-shared (array:range options probe_end libraries_end))
				context protection target_index (bool false) partition human))
			(if (i32:gtz emitted) (then (return (call native_build_result emitted (bool false)))))
			(let executable_storage (call requires_executable_image (borrow-shared unit)))
			(if
				(:doc "A negative emission result is the complete private numbered stage's unit count.")
				(i32:ltz emitted)
				(then
					(let program (call clang_program))
					(let tool (call run_parallel_clang (borrow-shared program) (borrow-shared unit) (borrow-shared binary)
						(i32:sub 0i32 emitted) partition (struct:get context os) library
						(borrow-shared exports) (borrow-shared name) (borrow-shared bytes) (borrow-shared config)
						invocation (borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)
						protection target_index human))
					(let result (call publish_clang_result (borrow-shared path) (borrow-shared target)
						(borrow-shared retained) (borrow-shared unit) (borrow-shared binary) (borrow-shared public_header)
						(borrow-shared directory) (borrow-shared debug) (borrow-shared trace) (borrow-shared jobs)
						library_os (bool false) executable_storage tool target_index human))
					(return (struct:new NativeBuild (status (struct:get result status))
						(retained (struct:get result retained)) (numbered (bool true))))))
			(let debug_build (bool:and (bool:not library) (u32:eq (struct:get invocation mode) 1u32)))
			(if
				(:doc `Add the final source location while the exact translation unit is still private.`)
				debug_build
				(then
					(let source (call append_path (borrow-shared debug) (borrow-shared main_suffix)))
					(if
						(:doc `Do not invoke Clang with an incomplete debug source.`)
						(bool:not (call name_debug_unit (borrow-shared unit) (borrow-shared source)))
						(then (return (call native_build_result
							(call report_argv 69u32 target_index (borrow-shared publish_binary_failure) human)
							(bool false)))))))
			(let end (call write_clang_arguments (borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)
				(borrow-shared unit) (borrow-shared binary) library_os
				(borrow-shared exports) (borrow-shared name) (borrow-mut options) frontend))
			(if
				(:doc `Reject invalid compiler or linker arguments before starting the native tool.`)
				(i32:ltz end)
				(then (return (call native_build_result
					(call report_argv 70u32 0i32 (borrow-shared native_argument_failure) human) (bool false)))))
			(let program (call clang_program))
			(let tool (call run_clang_with_trace (borrow-shared program)
				(borrow-shared (array:range options 0i32 end)) (borrow-shared trace)
				(borrow-shared jobs) protection target_index human))
			(return (call publish_clang_result (borrow-shared path) (borrow-shared target)
				(borrow-shared retained) (borrow-shared unit) (borrow-shared binary) (borrow-shared public_header)
				(borrow-shared directory) (borrow-shared debug) (borrow-shared trace) (borrow-shared jobs)
				library_os debug_build executable_storage tool target_index human))))

	(fn publish_clang_result
		(:doc "Use the same executable and library publication policy for both native compile paths.")
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8)) (unit (shared-array u8))
			(binary (shared-array u8)) (public_header (shared-array u8)) (directory (shared-array u8)) (debug (shared-array u8))
			(trace (shared-array u8)) (jobs (shared-array u8)) (library_os u8) (debug_build bool) (executable_storage bool)
			(tool NativeTool) (target_index i32) (human bool)) (returns NativeBuild)
		(body
			(let library (u8:gtz library_os))
			(let status (struct:get tool status))
			(let checked (struct:get tool checked))
			(if (i32:gtz checked) (then (return (call native_build_result checked (bool false)))))
			(if
				(:doc "An overridden link must not publish unloadable storage for a retained argument.")
				(bool:and (bool:and executable_storage (i32:eqz status))
					(bool:not (call linked_executable_image (borrow-shared binary))))
				(then (return (call native_build_result
					(call report_argv 69u32 target_index (borrow-shared retained_image_failure) human)
					(bool false)))))
			(if
				(:doc "A failed shared link leaves the last library, header, and retained source intact.")
				library
				(then
					(if (i32:not-eqz status)
						(then (return (call native_build_result (call report_clang_status status (struct:get tool failed_unit) human) (bool false)))))
					(return (call publish_library (borrow-shared path) (borrow-shared target)
						(borrow-shared retained) (borrow-shared unit) (borrow-shared binary)
						(borrow-shared public_header) library_os target_index human))))
			(if
				(:doc `Only a successful debug invocation can publish its own source and symbol directory.`)
				debug_build
				(then
					(if (i32:not-eqz status)
						(then (return (call native_build_result (call report_clang_status status (struct:get tool failed_unit) human) (bool false)))))
					(return (call native_build_result (call publish_debug (borrow-shared path)
						(borrow-shared target) (borrow-shared directory) (borrow-shared debug)
						(borrow-shared trace) (borrow-shared jobs) target_index human) (bool false)))))
			(let published (call retain_checked_unit (borrow-shared path) (borrow-shared retained)
				(borrow-shared unit) target_index human))
			(if (i32:gtz published) (then (return (call native_build_result published (bool false)))))
			(if
				(:doc `An ordinary tool failure still leaves the checked C available for inspection.`)
				(i32:not-eqz status)
				(then (return (call native_build_result (call report_clang_status status (struct:get tool failed_unit) human) (bool true)))))
			(return (call native_build_result (call install_binary (borrow-shared path) (borrow-shared target)
				(borrow-shared binary) target_index human) (bool true)))))

	(fn finish_stage
		(:doc `Remove an empty stage. Retain optional Clang side outputs beside the generated C.`)
		(params (directory (shared-array u8)) (retained (shared-array u8)) (checked bool))
		(returns void)
		(body
			(if
				(:doc `An ordinary build leaves nothing to move after the known files are unlinked.`)
				(i32:eqz (call rmdir (borrow-shared directory)))
				(then (return)))
			(if
				(:doc `A dependency rejection cannot move private side outputs into the retained tree.`)
				(bool:not checked)
				(then
					(call discard_private_stage (borrow-shared directory))
					(return)))
			(let start (call directory_width (borrow-shared directory)))
			(let output (call join_file_path (borrow-shared retained)
				(borrow-shared (array:range directory start (array:len directory)))))
			(let moved (call rename (borrow-shared directory) (borrow-shared output)))))

	(fn compile_binary
		(:doc `Own the private stage across emission, native compilation, and publication.`)
		(:expect (tests "stage-2/cli/native/bin.tsv") (issues "gh:wove-lang/wove:192"))
		(params (path (shared-array u8)) (target (shared-array u8)) (public_header (shared-array u8)) (retained (shared-array u8))
			(protection BuildProtection) (target_index i32) (library_context SelectionContext) (bytes (shared-array u8)) (config (shared-array u8))
			(invocation CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool)) (returns i32)
		(body
			(let directory (call stage_directory (borrow-shared target)))
			(if
				(:doc `Only a reserved directory can receive build artifacts.`)
				(call empty_bytes (borrow-shared directory))
				(then (return (call report_argv 69u32 target_index (borrow-shared publish_binary_failure) human))))
			(let unit (call append_path (borrow-shared directory) (borrow-shared main_suffix)))
			(let runtime (call append_path (borrow-shared directory) (borrow-shared source_suffix)))
			(let header (call append_path (borrow-shared directory) (borrow-shared header_suffix)))
			(let binary (call append_path (borrow-shared directory) (borrow-shared binary_suffix)))
			(let trace (call append_path (borrow-shared directory) (borrow-shared dependency_suffix)))
			(let jobs (call append_path (borrow-shared directory) (borrow-shared job_suffix)))
			(let-mut debug (array:alloc u8 0i32))
			(if
				(:doc "Executable debug source relocation is independent of library interface publication.")
				(u8:eqz (struct:get library_context os))
				(then (set debug (call debug_directory (borrow-shared target) (borrow-shared retained)
					(borrow-shared directory) (struct:get invocation mode)))))
			(let result (call build_in_directory (borrow-shared path) (borrow-shared target) (borrow-shared retained)
				protection target_index library_context (borrow-shared public_header) (borrow-shared directory)
				(borrow-shared debug) (borrow-shared unit)
				(borrow-shared runtime) (borrow-shared header) (borrow-shared binary) (borrow-shared trace) (borrow-shared jobs)
				(borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) human))
			(if
				(:doc "Numbered units, objects, and traces remain private. The canonical serial C is retained separately.")
				(struct:get result numbered)
				(then
					(call discard_private_stage (borrow-shared directory))
					(return (struct:get result status))))
			(if
				(:doc `A published debug directory already owns the private source and runtime files.`)
				(bool:and (bool:and (u8:eqz (struct:get library_context os)) (u32:eq (struct:get invocation mode) 1u32))
					(i32:eqz (struct:get result status)))
				(then (return 0i32)))
			(let removed_binary (call unlink (borrow-shared binary)))
			(let removed_header (call unlink (borrow-shared header)))
			(let removed_runtime (call unlink (borrow-shared runtime)))
			(let removed_unit (call unlink (borrow-shared unit)))
			(let removed_trace (call unlink (borrow-shared trace)))
			(let removed_jobs (call unlink (borrow-shared jobs)))
			(if
				(:doc "Remove the private symbol list and any remaining interface stage on either result.")
				(u8:not-eqz (struct:get library_context os))
				(then
					(let exports (call join_file_path (borrow-shared unit) (borrow-shared library_stage_exports)))
					(let public (call join_file_path (borrow-shared unit) (borrow-shared library_stage_header)))
					(let removed_exports (call unlink (borrow-shared exports)))
					(let removed_public (call unlink (borrow-shared public)))))
			(call finish_stage (borrow-shared directory) (borrow-shared retained) (struct:get result retained))
			(return (struct:get result status))))
)
