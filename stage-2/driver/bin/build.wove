(module native_bin_build
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Build one native executable and install it with a same-filesystem rename.

	The private directory holds an immutable copy of the generated C and
	the embedded runtime. Clang never receives the final executable path.
	Ordinary builds keep checked C after a tool failure. Debug builds
	commit each executable against its own retained source and symbols.`)

	(use (:pragma (cfg (os "linux"))) c-header "<stdlib.h>" (only mkdtemp))
	(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only mkdtemp))
	(use c-header "<unistd.h>" (only access X_OK unlink rmdir))
	(use c-header "<stdio.h>" (only rename))
	(use c-header "<sys/stat.h>" (only lstat S_ISREG (type Stat)))
	(use wove-file "../clang.wove" (only clang_program))
	(use wove-file "../arguments.wove" (only frontend_capacity write_probe_options write_clang_arguments))
	(use wove-file "./debug.wove" (only debug_directory name_debug_unit stage_debug_source))
	(use wove-file "./dependencies.wove" (only check_resolved_headers))
	(use wove-file "./jobs.wove" (only clang_trace_environment read_job_sysroot))
	(use wove-file "../output.wove" (only retain_checked_unit))
	(use wove-file "../diagnostics.wove" (only report_argv (value project_file)))
	(use wove-file "../protection.wove" (only (type BuildProtection)))
	(use wove-file "../publication.wove" (only ensure_parents stage_file))
	(use wove-file "../files.wove" (only canonical_path path_identity same_path_identity))
	(use wove-file "../paths.wove" (only directory_width join_file_path))
	(use wove-file "../source.wove" (only compile_input))
	(use wove-file "../../cli/command/resolve.wove" (only (type CommandInvocation)))
	(use wove-file "../../cli/command/args.wove" (only (type CommandArgument)))
	(use wove-file "../../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../../io/process.wove" (only run_process_capture))
	(use wove-file "../../io/process_file.wove" (only run_process_stdout_file))
	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../../text/decimal_write.wove" (only write_decimal_i32))

	(struct NativeBuild (fields (status i32) (retained bool)))
	(struct NativeTool (fields (status i32) (checked i32)))

	(let temporary_name ".wovec-bin.XXXXXX")
	(let main_suffix "/main.c")
	(let binary_suffix "/program")
	(let source_suffix "/wove_runtime.c")
	(let header_suffix "/wove_runtime.h")
	(let dependency_suffix "/clang.stdout")
	(let job_suffix "/clang.jobs")
	(let remove_program "rm")
	(let remove_arguments "-rf\u0000--\u0000")
	(let publish_binary_failure "could not publish executable")
	(let native_argument_failure "could not pack native compiler arguments")
	(let clang_failure "clang failed with status ")

	(fn empty_path
		(:doc `Return a zero-length owner to mark a failed path operation.`)
		(params) (returns (owned-array u8))
		(body
			(let path (array.alloc u8 0i32))
			(return (move (local path)))))

	(fn empty_bytes
		(:doc `Check an owned byte buffer through its borrowed view.`)
		(params (bytes (shared-array u8))) (returns bool)
		(body (return (i32.eqz (array.len (local bytes))))))

	(fn append_path
		(:doc `Join a private directory with a fixed filename suffix within the signed byte ABI.`)
		(params (directory (shared-array u8)) (suffix (shared-array u8))) (returns (owned-array u8))
		(body
			(let start (array.len (local directory)))
			(let width (array.len (local suffix)))
			(if
				(:doc `Neither a failed directory nor an unrepresentable path can name a staged file.`)
				(bool.or (i32.eqz (local start))
					(i32.lt (i32.sub 2147483647i32 (local width)) (local start)))
				(then (return (call empty_path))))
			(let-mut path (array.alloc u8 (i32.add (local start) (local width))))
			(let first (call append_bytes (borrow-shared (local directory)) (borrow-mut (local path)) 0i32))
			(let end (call append_bytes (borrow-shared (local suffix)) (borrow-mut (local path)) (local first)))
			(return (move (local path)))))

	(fn stage_directory
		(:doc `Create a private sibling directory on the output filesystem.`)
		(params (target (shared-array u8))) (returns (owned-array u8))
		(body
			(if
				(:doc `Prepare only the parent directories before reserving the private stage.`)
				(bool.not (call ensure_parents (borrow-shared (local target))))
				(then (return (call empty_path))))
			(let parent (call directory_width (borrow-shared (local target))))
			(let suffix (array.len (local temporary_name)))
			(if
				(:doc `The mkdtemp template must fit one byte slice.`)
				(i32.lt (i32.sub 2147483647i32 (local suffix)) (local parent))
				(then (return (call empty_path))))
			(let-mut template (array.alloc u8 (i32.add (local parent) (local suffix))))
			(let copied (call append_bytes (borrow-shared (array.range (local target) 0i32 (local parent)))
				(borrow-mut (local template)) 0i32))
			(let end (call append_bytes (borrow-shared (local temporary_name)) (borrow-mut (local template)) (local copied)))
			(let created (call mkdtemp (borrow-mut (local template))))
			(if
				(:doc `A failed reservation owns no directory.`)
				(owner.is-null (local created))
				(then (return (call empty_path))))
			(let directory (move (optional.unwrap (local created))))
			(let absolute (call canonical_path (borrow-shared (local directory))))
			(if
				(:doc `Remove the directory if we cannot give Clang an absolute argument path.`)
				(call empty_bytes (borrow-shared (local absolute)))
				(then (let removed (call rmdir (borrow-shared (local directory))))))
			(return (move (local absolute)))))

	(fn report_clang_status
		(:doc `Make the native status visible in the diagnostic and propagate child exit or signal status.`)
		(params (status i32) (human bool)) (returns i32)
		(body
			(let-mut message (array.alloc u8 (i32.add (array.len (local clang_failure)) 11i32)))
			(let start (call append_bytes (borrow-shared (local clang_failure)) (borrow-mut (local message)) 0i32))
			(let end (call write_decimal_i32 (borrow-mut (local message)) (local start) (local status)))
			(let diagnostic (call report_argv 68u32 0i32 (borrow-shared (array.range (local message) 0i32 (local end))) (local human)))
			(if (i32.gtz (local status)) (then (return (local status))))
			(return (local diagnostic))))

	(fn protected_target
		(:doc `Preserve the entry and project configuration when the output aliases either file.`)
		(params (path (shared-array u8)) (target (shared-array u8))) (returns bool)
		(body
			(let output (call path_identity (borrow-shared (local target))))
			(return (bool.or (call same_path_identity (local output) (call path_identity (borrow-shared (local path))))
				(call same_path_identity (local output) (call path_identity (borrow-shared (local project_file))))))))

	(fn install_binary
		(:doc `Publish only a regular executable present after successful Clang completion.`)
		(params (path (shared-array u8)) (target (shared-array u8)) (binary (shared-array u8)) (target_index i32) (human bool))
		(returns i32)
		(body
			(let-mut info (struct.new Stat))
			(let inspected (call lstat (borrow-shared (local binary)) (borrow-mut (local info))))
			(let regular (bool.and (i32.eqz (local inspected)) (call S_ISREG (struct.get (local info) st_mode))))
			(if
				(:doc `Only a regular directory entry can remain executable after the rename.`)
				(bool.and (local regular)
					(bool.and (i32.eqz (call access (borrow-shared (local binary)) (local X_OK)))
						(bool.and (bool.not (call protected_target (borrow-shared (local path)) (borrow-shared (local target))))
							(i32.eqz (call rename (borrow-shared (local binary)) (borrow-shared (local target)))))))
				(then (return 0i32)))
			(return (call report_argv 69u32 (local target_index) (borrow-shared (local publish_binary_failure)) (local human)))))

	(fn run_clang_with_trace
		(:doc `Observe the tool’s complete stdout and effective job settings before publishing its results.`)
		(params (program (shared-array u8)) (packed (shared-array u8)) (trace (shared-array u8))
			(jobs (shared-array u8)) (protection BuildProtection) (target_index i32) (human bool)) (returns NativeTool)
		(body
			(let environment (call clang_trace_environment (borrow-shared (local jobs))))
			(let status (call run_process_stdout_file (borrow-shared (local program)) (borrow-shared (local packed))
				(borrow-shared (local trace)) (borrow-shared (local environment))))
			(let root (call read_job_sysroot (borrow-shared (local jobs))))
			(let checked (call check_resolved_headers (borrow-shared (local trace)) (borrow-shared (local root))
				(local protection) (local status) (local target_index) (local human)))
			(return (struct.new NativeTool (status (local status)) (checked (local checked))))))

	(fn native_build_result
		(:doc `Keep the public status with whether optional side outputs may enter the retained tree.`)
		(params (status i32) (retained bool)) (returns NativeBuild)
		(body (return (struct.new NativeBuild (status (local status)) (retained (local retained))))))

	(fn discard_private_stage
		(:doc `Remove optional tool output only from the compiler's reserved private directory.`)
		(params (directory (shared-array u8))) (returns void)
		(body
			(let prefix (array.len (local remove_arguments)))
			(let width (array.len (local directory)))
			(if
				(:doc `The absolute stage path and its argument terminator must fit the launcher buffer.`)
				(bool.or (i32.eqz (local width)) (i32.lt (i32.sub 2147483646i32 (local prefix)) (local width)))
				(then (return)))
			(let-mut packed (array.alloc u8 (i32.add (local prefix) (i32.inc (local width)))))
			(let start (call append_bytes (borrow-shared (local remove_arguments)) (borrow-mut (local packed)) 0i32))
			(let end (call append_bytes (borrow-shared (local directory)) (borrow-mut (local packed)) (local start)))
			(array.store (local packed) (local end) 0u8)
			(let-mut output (array.alloc u8 0i32))
			(let removed (call run_process_capture (borrow-shared (local remove_program)) (borrow-shared (local packed)) (borrow-mut (local output))))))

	(fn publish_debug
		(:doc `Make the complete debug directory available before installing the executable that names it.`)
		(params (path (shared-array u8)) (target (shared-array u8)) (directory (shared-array u8))
			(debug (shared-array u8)) (trace (shared-array u8)) (jobs (shared-array u8)) (target_index i32) (human bool))
		(returns i32)
		(body
			(let removed_trace (call unlink (borrow-shared (local trace))))
			(let removed_jobs (call unlink (borrow-shared (local jobs))))
			(if
				(:doc `A relocation failure leaves the previous debug build and executable intact.`)
				(bool.not (bool.and (call ensure_parents (borrow-shared (local debug)))
					(i32.eqz (call rename (borrow-shared (local directory)) (borrow-shared (local debug))))))
				(then (return (call report_argv 69u32 (local target_index) (borrow-shared (local publish_binary_failure)) (local human)))))
			(let binary (call append_path (borrow-shared (local debug)) (borrow-shared (local binary_suffix))))
			(let status (call install_binary (borrow-shared (local path)) (borrow-shared (local target))
				(borrow-shared (local binary)) (local target_index) (local human)))
			(if
				(:doc `An unsuccessful executable rename discards only this build's unpublished source and symbols.`)
				(i32.gtz (local status))
				(then (call discard_private_stage (borrow-shared (local debug)))))
			(return (local status))))

	(fn stage_runtime_asset
		(:doc `Keep the included runtime file reachable from debug line tables after publication.`)
		(params (path (shared-array u8)) (debug (shared-array u8)) (suffix (shared-array u8))
			(source (shared-array u8))) (returns bool)
		(body
			(if
				(:doc `Ordinary builds stage only the original embedded runtime bytes.`)
				(call empty_bytes (borrow-shared (local debug)))
				(then (return (call stage_file (borrow-shared (local path)) (borrow-shared (local source))))))
			(let retained (call append_path (borrow-shared (local debug)) (borrow-shared (local suffix))))
			(return (call stage_debug_source (borrow-shared (local path)) (borrow-shared (local retained))
				(borrow-shared (local source))))))

	(fn build_in_directory
		(:doc `Keep the runtime and executable private until the generated source has compiled successfully.`)
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8))
			(protection BuildProtection) (target_index i32) (directory (shared-array u8))
			(debug (shared-array u8)) (unit (shared-array u8))
			(runtime (shared-array u8)) (header (shared-array u8)) (binary (shared-array u8)) (trace (shared-array u8)) (jobs (shared-array u8))
			(bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool)) (returns NativeBuild)
		(body
			(let runtime_source (embed "../../../runtime/wove_runtime.c"))
			(let runtime_header (embed "../../../runtime/wove_runtime.h"))
			(if
				(:doc `Both runtime assets must be available next to the private generated C unit.`)
				(bool.not (bool.and (call stage_runtime_asset (borrow-shared (local runtime)) (borrow-shared (local debug))
						(borrow-shared (local source_suffix)) (borrow-shared (local runtime_source)))
					(call stage_runtime_asset (borrow-shared (local header)) (borrow-shared (local debug))
						(borrow-shared (local header_suffix)) (borrow-shared (local runtime_header)))))
				(then (return (call native_build_result
					(call report_argv 69u32 (local target_index) (borrow-shared (local publish_binary_failure)) (local human)) (bool false)))))
			(let paths (u64.add (u64.from-i32 (array.len (local directory)))
				(u64.add (u64.from-i32 (array.len (local unit))) (u64.from-i32 (array.len (local binary))))))
			(let capacity (call frontend_capacity (array.len (local bytes)) (array.len (local config))
				(array.len (local arguments)) (local paths)))
			(let-mut options (array.alloc u8 (local capacity)))
			(let frontend (call write_probe_options (borrow-shared (local bytes)) (borrow-shared (local config))
				(local invocation) (borrow-shared (local arguments)) (borrow-shared (local nodes))
				(borrow-shared (local settings)) (borrow-shared (local directory)) (borrow-mut (local options))))
			(let emitted (call compile_input (borrow-shared (local path)) (borrow-shared (local retained))
				(borrow-shared (local unit)) (borrow-shared (array.range (local options) 0i32 (struct.get (local frontend) probe_end)))
				(local protection) (local target_index) (bool false) (local human)))
			(if (i32.not-eqz (local emitted)) (then (return (call native_build_result (local emitted) (bool false)))))
			(let debug_build (u32.eq (struct.get (local invocation) mode) 1u32))
			(if
				(:doc `Add the final source location while the exact translation unit is still private.`)
				(local debug_build)
				(then
					(let source (call append_path (borrow-shared (local debug)) (borrow-shared (local main_suffix))))
					(if
						(:doc `Do not invoke Clang with an incomplete debug source.`)
						(bool.not (call name_debug_unit (borrow-shared (local unit)) (borrow-shared (local source))))
						(then (return (call native_build_result
							(call report_argv 69u32 (local target_index) (borrow-shared (local publish_binary_failure)) (local human))
							(bool false)))))))
			(let end (call write_clang_arguments (borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
				(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings))
				(borrow-shared (local unit)) (borrow-shared (local binary)) (borrow-mut (local options)) (local frontend)))
			(if
				(:doc `Reject invalid compiler or linker arguments before starting the native tool.`)
				(i32.ltz (local end))
				(then (return (call native_build_result
					(call report_argv 70u32 0i32 (borrow-shared (local native_argument_failure)) (local human)) (bool false)))))
			(let program (call clang_program))
			(let tool (call run_clang_with_trace (borrow-shared (local program))
				(borrow-shared (array.range (local options) 0i32 (local end))) (borrow-shared (local trace))
				(borrow-shared (local jobs)) (local protection) (local target_index) (local human)))
			(let status (struct.get (local tool) status))
			(let checked (struct.get (local tool) checked))
			(if (i32.gtz (local checked)) (then (return (call native_build_result (local checked) (bool false)))))
			(if
				(:doc `Only a successful debug invocation can publish its own source and symbol directory.`)
				(local debug_build)
				(then
					(if (i32.not-eqz (local status))
						(then (return (call native_build_result (call report_clang_status (local status) (local human)) (bool false)))))
					(return (call native_build_result (call publish_debug (borrow-shared (local path))
						(borrow-shared (local target)) (borrow-shared (local directory)) (borrow-shared (local debug))
						(borrow-shared (local trace)) (borrow-shared (local jobs)) (local target_index) (local human)) (bool false)))))
			(let published (call retain_checked_unit (borrow-shared (local path)) (borrow-shared (local retained))
				(borrow-shared (local unit)) (local target_index) (local human)))
			(if (i32.gtz (local published)) (then (return (call native_build_result (local published) (bool false)))))
			(if
				(:doc `An ordinary tool failure still leaves the checked C available for inspection.`)
				(i32.not-eqz (local status))
				(then (return (call native_build_result (call report_clang_status (local status) (local human)) (bool true)))))
			(return (call native_build_result (call install_binary (borrow-shared (local path)) (borrow-shared (local target))
				(borrow-shared (local binary)) (local target_index) (local human)) (bool true)))))

	(fn finish_stage
		(:doc `Remove an empty stage. Retain optional Clang side outputs beside the generated C.`)
		(params (directory (shared-array u8)) (retained (shared-array u8)) (checked bool))
		(returns void)
		(body
			(if
				(:doc `An ordinary build leaves nothing to move after the known files are unlinked.`)
				(i32.eqz (call rmdir (borrow-shared (local directory))))
				(then (return)))
			(if
				(:doc `A dependency rejection cannot move private side outputs into the retained tree.`)
				(bool.not (local checked))
				(then
					(call discard_private_stage (borrow-shared (local directory)))
					(return)))
			(let start (call directory_width (borrow-shared (local directory))))
			(let output (call join_file_path (borrow-shared (local retained))
				(borrow-shared (array.range (local directory) (local start) (array.len (local directory))))))
			(let moved (call rename (borrow-shared (local directory)) (borrow-shared (local output))))))

	(fn compile_binary
		(:doc `Own the private stage across emission, native compilation, and publication.`)
		(:expect (tests "stage-2/cli/native/bin.tsv") (issues "gh:wove-lang/wove:192"))
		(params (path (shared-array u8)) (target (shared-array u8)) (retained (shared-array u8))
			(protection BuildProtection) (target_index i32) (bytes (shared-array u8)) (config (shared-array u8))
			(invocation CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool)) (returns i32)
		(body
			(let directory (call stage_directory (borrow-shared (local target))))
			(if
				(:doc `Only a reserved directory can receive build artifacts.`)
				(call empty_bytes (borrow-shared (local directory)))
				(then (return (call report_argv 69u32 (local target_index) (borrow-shared (local publish_binary_failure)) (local human)))))
			(let unit (call append_path (borrow-shared (local directory)) (borrow-shared (local main_suffix))))
			(let runtime (call append_path (borrow-shared (local directory)) (borrow-shared (local source_suffix))))
			(let header (call append_path (borrow-shared (local directory)) (borrow-shared (local header_suffix))))
			(let binary (call append_path (borrow-shared (local directory)) (borrow-shared (local binary_suffix))))
			(let trace (call append_path (borrow-shared (local directory)) (borrow-shared (local dependency_suffix))))
			(let jobs (call append_path (borrow-shared (local directory)) (borrow-shared (local job_suffix))))
			(let debug (call debug_directory (borrow-shared (local target)) (borrow-shared (local retained))
				(borrow-shared (local directory)) (struct.get (local invocation) mode)))
			(let result (call build_in_directory (borrow-shared (local path)) (borrow-shared (local target)) (borrow-shared (local retained))
				(local protection) (local target_index) (borrow-shared (local directory))
				(borrow-shared (local debug)) (borrow-shared (local unit))
				(borrow-shared (local runtime)) (borrow-shared (local header)) (borrow-shared (local binary)) (borrow-shared (local trace)) (borrow-shared (local jobs))
				(borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
				(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings)) (local human)))
			(if
				(:doc `A published debug directory already owns the private source and runtime files.`)
				(bool.and (u32.eq (struct.get (local invocation) mode) 1u32)
					(i32.eqz (struct.get (local result) status)))
				(then (return 0i32)))
			(let removed_binary (call unlink (borrow-shared (local binary))))
			(let removed_header (call unlink (borrow-shared (local header))))
			(let removed_runtime (call unlink (borrow-shared (local runtime))))
			(let removed_unit (call unlink (borrow-shared (local unit))))
			(let removed_trace (call unlink (borrow-shared (local trace))))
			(let removed_jobs (call unlink (borrow-shared (local jobs))))
			(call finish_stage (borrow-shared (local directory)) (borrow-shared (local retained)) (struct.get (local result) retained))
			(return (struct.get (local result) status))))
)
