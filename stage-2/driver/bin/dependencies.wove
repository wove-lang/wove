(module native_include_dependencies
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the actual include graphs obtained from one native Clang invocation.

	Clang writes one DOT graph per frontend job to private stdout without
	changing the caller's make dependency options. The driver checks file
	labels and forwards ordinary tool output outside the graphs.`)

	(use wove-file "../diagnostics.wove" (only report_argv))
	(use wove-file "../files.wove" (only file_stamp file_is_absent path_identity read_source_file))
	(use wove-file "../protection.wove" (only protected_input report_input_collision (type BuildProtection)))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../../io/stdio.wove" (only write_stdout))

	(let dependency_failure "could not verify resolved C headers")
	(let graph_open "digraph \"dependencies\" {")
	(let graph_close "}")
	(let node_prefix "  header_")
	(let label_prefix " [ shape=\"box\", label=\"")
	(let label_suffix "\"];")
	(let edge_prefix " -> header_")

	(fn report_dependency_failure
		(:doc `An unusable trace cannot authorize either publication.`)
		(params (target_index i32) (human bool)) (returns i32)
		(body (return (call report_argv 72u32 (local target_index) (borrow-shared (local dependency_failure)) (local human)))))

	(fn span_starts_with
		(:doc `Check a fixed DOT marker without reading beyond its current line.`)
		(params (trace (shared-array u8)) (start i32) (end i32) (marker (shared-array u8))) (returns bool)
		(body
			(let width (array.len (local marker)))
			(return (bool.and (bool.not (i32.lt (i32.sub.wrapping (local end) (local start)) (local width)))
				(call same_bytes (borrow-shared (local trace)) (local start) (i32.add.wrapping (local start) (local width))
					(borrow-shared (local marker)) 0i32 (local width))))))

	(fn node_id_end
		(:doc `Find the byte following a DOT node's unsigned decimal identifier.`)
		(params (trace (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut at (local start))
			(while
				(:doc `Numeric node IDs stop before the edge or label marker.`)
				(i32.lt (local at) (local end))
				(body
					(let byte (array.load (local trace) (local at)))
					(if (bool.or (u8.lt (local byte) 48u8) (u8.lt 57u8 (local byte))) (then (return (local at))))
					(set (local at) (i32.add.wrapping (local at) 1i32))))
			(return (local at))))

	(fn check_existing_header
		(:doc `A resolved file can alias either exact destination or depend on the retained tree's ancestry.`)
		(params (path (shared-array u8)) (protection BuildProtection) (human bool)) (returns i32)
		(body
			(if (call protected_input (borrow-shared (local path)) (local protection))
				(then (return (call report_input_collision (borrow-shared (local path)) (local human)))))
			(return 0i32)))

	(fn check_header_path
		(:doc `Check every existing identity that can produce a DOT label. Clang strips the sysroot without marking the label.`)
		(params (path (shared-array u8)) (root (shared-array u8)) (protection BuildProtection) (target_index i32) (human bool)) (returns i32)
		(body
			(let present (struct.get (call path_identity (borrow-shared (local path))) present))
			(if
				(:doc `An existing path outside the sysroot remains a candidate even if its prefixed spelling also exists.`)
				(local present)
				(then
					(let conflict (call check_existing_header (borrow-shared (local path)) (local protection) (local human)))
					(if (i32.lt 0i32 (local conflict)) (then (return (local conflict))))))
			(let width (u64.add.wrapping (int.convert u64 (array.len (local path))) (int.convert u64 (array.len (local root)))))
			(if
				(:doc `Clang removes the sysroot prefix literally, so restore it without path normalization.`)
				(bool.and (i32.lt 0i32 (array.len (local root))) (bool.not (u64.lt 2147483647u64 (local width))))
				(then
					(let-mut restored (array.alloc u8 (int.convert i32 (local width))))
					(let prefix (call append_bytes (borrow-shared (local root)) (borrow-mut (local restored)) 0i32))
					(let end (call append_bytes (borrow-shared (local path)) (borrow-mut (local restored)) (local prefix)))
					(if
						(:doc `Check the SDK candidate as well when it names an existing filesystem entry.`)
						(struct.get (call path_identity (borrow-shared (local restored))) present)
						(then (return (call check_existing_header (borrow-shared (local restored)) (local protection) (local human)))))))
			(if (local present) (then (return 0i32)))
			(return (call report_dependency_failure (local target_index) (local human)))))

	(fn decode_dot_label
		(:doc `Decode Clang's escaped quoted file bytes without applying JSON's escape grammar.`)
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8))) (returns i32)
		(body
			(let-mut at (local start))
			(let-mut written 0i32)
			(while
				(:doc `Each input byte, or pair for a DOT escape, produces one path byte.`)
				(i32.lt (local at) (local end))
				(body
					(let-mut byte (array.load (local source) (local at)))
					(set (local at) (i32.add.wrapping (local at) 1i32))
					(if
						(:doc `Remove quoting escapes for backslashes, quotes, and DOT record punctuation.`)
						(u8.eq (local byte) 92u8)
						(then
							(if (bool.not (i32.lt (local at) (local end))) (then (return -1i32)))
							(set (local byte) (array.load (local source) (local at)))
							(set (local at) (i32.add.wrapping (local at) 1i32))
							(if (u8.eq (local byte) 110u8) (then (set (local byte) 10u8)))))
					(if (u8.eq (local byte) 0u8) (then (return -1i32)))
					(array.store (local output) (local written) (local byte))
					(set (local written) (i32.add.wrapping (local written) 1i32))))
			(return (local written))))

	(fn check_graph_row
		(:doc `Validate a DOT edge or decode and protect a DOT node's quoted file label.`)
		(params (trace (shared-array u8)) (start i32) (end i32) (root (shared-array u8)) (protection BuildProtection) (target_index i32) (human bool)) (returns i32)
		(body
			(if
				(:doc `Each interior row declares a header node or an edge between two header nodes.`)
				(bool.not (call span_starts_with (borrow-shared (local trace)) (local start) (local end)
					(borrow-shared (local node_prefix))))
				(then (return (call report_dependency_failure (local target_index) (local human)))))
			(let first (i32.add.wrapping (local start) (array.len (local node_prefix))))
			(let node_end (call node_id_end (borrow-shared (local trace)) (local first) (local end)))
			(if (i32.eq (local first) (local node_end)) (then (return (call report_dependency_failure (local target_index) (local human)))))
			(if
				(:doc `The edge adds no path of its own. Its destination is another numeric node with a semicolon.`)
				(call span_starts_with (borrow-shared (local trace)) (local node_end) (local end)
					(borrow-shared (local edge_prefix)))
				(then
					(let other (i32.add.wrapping (local node_end) (array.len (local edge_prefix))))
					(let last (i32.sub.wrapping (local end) 1i32))
					(if
						(:doc `Check the entire destination and terminator before ignoring a relationship row.`)
						(bool.and (i32.lt (local other) (local last))
							(bool.and (u8.eq (array.load (local trace) (local last)) 59u8)
								(i32.eq (call node_id_end (borrow-shared (local trace)) (local other) (local last)) (local last))))
						(then (return 0i32)))
					(return (call report_dependency_failure (local target_index) (local human)))))
			(if
				(:doc `Keep both quotes within the label span and require the closing DOT punctuation.`)
				(bool.not (call span_starts_with (borrow-shared (local trace)) (local node_end) (local end)
					(borrow-shared (local label_prefix))))
				(then (return (call report_dependency_failure (local target_index) (local human)))))
			(let quote (i32.sub.wrapping (i32.add.wrapping (local node_end) (array.len (local label_prefix))) 1i32))
			(let tail (i32.sub.wrapping (local end) (array.len (local label_suffix))))
			(if
				(:doc `An empty, truncated, or malformed label cannot stand for a resolved file.`)
				(bool.or (bool.not (i32.lt (i32.add.wrapping (local quote) 1i32) (local tail)))
					(bool.not (call span_starts_with (borrow-shared (local trace)) (local tail) (local end)
						(borrow-shared (local label_suffix)))))
				(then (return (call report_dependency_failure (local target_index) (local human)))))
			(let start_label (i32.add.wrapping (local quote) 1i32))
			(let-mut label (array.alloc u8 (i32.sub.wrapping (local tail) (local start_label))))
			(let width (call decode_dot_label (borrow-shared (local trace)) (local start_label) (local tail) (borrow-mut (local label))))
			(if
				(:doc `Use the tool's decoded spelling so characters escaped for DOT still belong to the actual path.`)
				(i32.lt (local width) 1i32)
				(then (return (call report_dependency_failure (local target_index) (local human)))))
			(return (call check_header_path (borrow-shared (array.range (local label) 0i32 (local width)))
				(borrow-shared (local root)) (local protection) (local target_index) (local human)))))

	(fn next_line
		(:doc `Find an LF or the end of the captured output.`)
		(params (trace (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut end (local start))
			(while
				(:doc `The last ordinary stdout line need not have a trailing newline.`)
				(bool.and (i32.lt (local end) (array.len (local trace)))
					(bool.not (u8.eq (array.load (local trace) (local end)) 10u8)))
				(body (set (local end) (i32.add.wrapping (local end) 1i32))))
			(return (local end))))

	(fn forward_line
		(:doc `Preserve the original bounded stdout prefix while excluding the private graph stream.`)
		(params (trace (shared-array u8)) (start i32) (end i32) (forwarded i32)) (returns i32)
		(body
			(let room (i32.sub.wrapping 65536i32 (local forwarded)))
			(let-mut width (i32.sub.wrapping (local end) (local start)))
			(if (i32.lt (local room) (local width)) (then (set (local width) (local room))))
			(if
				(:doc `Only forward initialized bytes that fit the public tool output budget.`)
				(i32.lt 0i32 (local width))
				(then (let written (call write_stdout
					(borrow-shared (array.range (local trace) (local start) (i32.add.wrapping (local start) (local width))))))))
			(return (i32.add.wrapping (local forwarded) (local width)))))

	(fn check_header_graphs
		(:doc `Consume every complete graph and leave ordinary Clang stdout visible to the caller.`)
		(params (trace (shared-array u8)) (root (shared-array u8)) (protection BuildProtection) (tool_status i32) (target_index i32) (human bool)) (returns i32)
		(body
			(let-mut at 0i32)
			(let-mut forwarded 0i32)
			(let-mut inside (bool false))
			(let-mut seen (bool false))
			(while
				(:doc `Each frontend appends its graph to the same output descriptor.`)
				(i32.lt (local at) (array.len (local trace)))
				(body
					(let end (call next_line (borrow-shared (local trace)) (local at)))
					(let-mut after (local end))
					(if (i32.lt (local end) (array.len (local trace))) (then (set (local after) (i32.add.wrapping (local end) 1i32))))
					(if
						(:doc `Inside a graph, accept its terminator or check a complete dependency row.`)
						(local inside)
						(then
							(if
								(:doc `Do not count a partial frontend trace as complete.`)
								(call same_bytes (borrow-shared (local trace)) (local at) (local end)
									(borrow-shared (local graph_close)) 0i32 (array.len (local graph_close)))
								(then (set (local inside) (bool false)) (set (local seen) (bool true)))
								(else
									(let status (call check_graph_row (borrow-shared (local trace)) (local at) (local end)
										(borrow-shared (local root)) (local protection) (local target_index) (local human)))
									(if (i32.lt 0i32 (local status)) (then (return (local status)))))))
						(else
							(if
								(:doc `Recognize only the compiler's complete graph-opening line as private output.`)
								(call same_bytes (borrow-shared (local trace)) (local at) (local end)
									(borrow-shared (local graph_open)) 0i32 (array.len (local graph_open)))
								(then (set (local inside) (bool true)))
								(else (set (local forwarded) (call forward_line (borrow-shared (local trace))
									(local at) (local after) (local forwarded)))))))
					(set (local at) (local after))))
			(if
				(:doc `A successful tool must record a complete graph, and an interrupted graph is unsafe at any exit status.`)
				(bool.or (local inside) (bool.and (i32.eq (local tool_status) 0i32) (bool.not (local seen))))
				(then (return (call report_dependency_failure (local target_index) (local human)))))
			(return 0i32)))

	(fn check_resolved_headers
		(:doc `Read the private stream before publishing any shared output.`)
		(params (path (shared-array u8)) (root (shared-array u8)) (protection BuildProtection) (tool_status i32) (target_index i32) (human bool)) (returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared (local path))))
			(let length (struct.get (local stamp) length))
			(if
				(:doc `A launch failure may precede creation of the private stdout file.`)
				(bool.and (bool.not (i32.eq (local tool_status) 0i32)) (call file_is_absent (local stamp)))
				(then (return 0i32)))
			(if (i32.lt (local length) 0i32) (then (return (call report_dependency_failure (local target_index) (local human)))))
			(let-mut trace (array.alloc u8 (local length)))
			(if
				(:doc `Check all complete output before either shared path is touched.`)
				(bool.not (call read_source_file (borrow-shared (local path)) (local stamp) (borrow-mut (local trace))))
				(then (return (call report_dependency_failure (local target_index) (local human)))))
			(return (call check_header_graphs (borrow-shared (local trace)) (borrow-shared (local root)) (local protection) (local tool_status) (local target_index) (local human)))))
)
