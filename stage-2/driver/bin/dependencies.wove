(module native_include_dependencies
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the actual include graphs obtained from one native Clang invocation.

	Clang writes one DOT graph per frontend job to private stdout without
	changing the caller's make dependency options. The driver checks file
	labels and forwards ordinary tool output outside the graphs.`)

	(use wove-file "../diagnostics.wove" (only report_argv))
	(use wove-file "../files.wove" (only file_stamp file_is_absent path_identity read_source_file))
	(use wove-file "../protection.wove" (only protected_input report_input_collision (type BuildProtection)))
	(use wove-file "../../text/bytes.wove" (only same_bytes))
	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../../io/stdio.wove" (only write_stdout))

	(let dependency_failure "could not verify resolved C headers")
	(let graph_open "digraph \"dependencies\" {")
	(let graph_close "}")
	(let node_prefix "  header_")
	(let label_prefix " [ shape=\"box\", label=\"")
	(let label_suffix "\"];")
	(let edge_prefix " -> header_")

	(fn report_dependency_failure
		(:doc `An unusable trace cannot authorize either publication.`)
		(params (target_index i32) (human bool)) (returns i32)
		(body (return (call report_argv 72u32 target_index (borrow-shared dependency_failure) human))))

	(fn span_starts_with
		(:doc `Check a fixed DOT marker without reading beyond its current line.`)
		(params (trace (shared-array u8)) (start i32) (end i32) (marker (shared-array u8))) (returns bool)
		(body
			(let width (array.len marker))
			(return (bool.and (i32.not-lt (i32.sub end start) width)
				(call same_bytes (borrow-shared trace) start (i32.add start width)
					(borrow-shared marker) 0i32 width)))))

	(fn node_id_end
		(:doc `Find the byte following a DOT node's unsigned decimal identifier.`)
		(params (trace (shared-array u8)) (start i32) (end i32)) (returns i32)
		(body
			(let-mut at start)
			(while
				(:doc `Numeric node IDs stop before the edge or label marker.`)
				(i32.lt at end)
				(body
					(let byte (array.load trace at))
					(if (bool.or (u8.lt byte 48u8) (u8.lt 57u8 byte)) (then (return at)))
					(set at (i32.inc at))))
			(return at)))

	(fn check_existing_header
		(:doc `A resolved file can alias either exact destination or depend on the retained tree's ancestry.`)
		(params (path (shared-array u8)) (protection BuildProtection) (human bool)) (returns i32)
		(body
			(if (call protected_input (borrow-shared path) protection)
				(then (return (call report_input_collision (borrow-shared path) human))))
			(return 0i32)))

	(fn check_header_path
		(:doc `Check every existing identity that can produce a DOT label. Clang strips the sysroot without marking the label.`)
		(params (path (shared-array u8)) (root (shared-array u8)) (protection BuildProtection) (target_index i32) (human bool)) (returns i32)
		(body
			(let present (struct.get (call path_identity (borrow-shared path)) present))
			(if
				(:doc `An existing path outside the sysroot remains a candidate even if its prefixed spelling also exists.`)
				present
				(then
					(let conflict (call check_existing_header (borrow-shared path) protection human))
					(if (i32.gtz conflict) (then (return conflict)))))
			(let width (u64.add (u64.from-i32 (array.len path)) (u64.from-i32 (array.len root))))
			(if
				(:doc `Clang removes the sysroot prefix literally, so restore it without path normalization.`)
				(bool.and (i32.gtz (array.len root)) (u64.not-lt 2147483647u64 width))
				(then
					(let-mut restored (array.alloc u8 (i32.from-u64 width)))
					(let prefix (call append_bytes (borrow-shared root) (borrow-mut restored) 0i32))
					(let end (call append_bytes (borrow-shared path) (borrow-mut restored) prefix))
					(if
						(:doc `Check the SDK candidate as well when it names an existing filesystem entry.`)
						(struct.get (call path_identity (borrow-shared restored)) present)
						(then (return (call check_existing_header (borrow-shared restored) protection human))))))
			(if present (then (return 0i32)))
			(return (call report_dependency_failure target_index human))))

	(fn decode_dot_label
		(:doc `Decode Clang's escaped quoted file bytes without applying JSON's escape grammar.`)
		(params (source (shared-array u8)) (start i32) (end i32) (output (mut-array u8))) (returns i32)
		(body
			(let-mut at start)
			(let-mut written 0i32)
			(while
				(:doc `Each input byte, or pair for a DOT escape, produces one path byte.`)
				(i32.lt at end)
				(body
					(let-mut byte (array.load source at))
					(set at (i32.inc at))
					(if
						(:doc `Remove quoting escapes for backslashes, quotes, and DOT record punctuation.`)
						(u8.eq byte 92u8)
						(then
							(if (i32.not-lt at end) (then (return -1i32)))
							(set byte (array.load source at))
							(set at (i32.inc at))
							(if (u8.eq byte 110u8) (then (set byte 10u8)))))
					(if (u8.eqz byte) (then (return -1i32)))
					(array.store output written byte)
					(set written (i32.inc written))))
			(return written)))

	(fn check_graph_row
		(:doc `Validate a DOT edge or decode and protect a DOT node's quoted file label.`)
		(params (trace (shared-array u8)) (start i32) (end i32) (root (shared-array u8)) (protection BuildProtection) (target_index i32) (human bool)) (returns i32)
		(body
			(if
				(:doc `Each interior row declares a header node or an edge between two header nodes.`)
				(bool.not (call span_starts_with (borrow-shared trace) start end
					(borrow-shared node_prefix)))
				(then (return (call report_dependency_failure target_index human))))
			(let first (i32.add start (array.len node_prefix)))
			(let node_end (call node_id_end (borrow-shared trace) first end))
			(if (i32.eq first node_end) (then (return (call report_dependency_failure target_index human))))
			(if
				(:doc `The edge adds no path of its own. Its destination is another numeric node with a semicolon.`)
				(call span_starts_with (borrow-shared trace) node_end end
					(borrow-shared edge_prefix))
				(then
					(let other (i32.add node_end (array.len edge_prefix)))
					(let last (i32.dec end))
					(if
						(:doc `Check the entire destination and terminator before ignoring a relationship row.`)
						(bool.and (i32.lt other last)
							(bool.and (u8.eq (array.load trace last) 59u8)
								(i32.eq (call node_id_end (borrow-shared trace) other last) last)))
						(then (return 0i32)))
					(return (call report_dependency_failure target_index human))))
			(if
				(:doc `Keep both quotes within the label span and require the closing DOT punctuation.`)
				(bool.not (call span_starts_with (borrow-shared trace) node_end end
					(borrow-shared label_prefix)))
				(then (return (call report_dependency_failure target_index human))))
			(let quote (i32.dec (i32.add node_end (array.len label_prefix))))
			(let tail (i32.sub end (array.len label_suffix)))
			(if
				(:doc `An empty, truncated, or malformed label cannot stand for a resolved file.`)
				(bool.or (i32.not-lt (i32.inc quote) tail)
					(bool.not (call span_starts_with (borrow-shared trace) tail end
						(borrow-shared label_suffix))))
				(then (return (call report_dependency_failure target_index human))))
			(let start_label (i32.inc quote))
			(let-mut label (array.alloc u8 (i32.sub tail start_label)))
			(let width (call decode_dot_label (borrow-shared trace) start_label tail (borrow-mut label)))
			(if
				(:doc `Use the tool's decoded spelling so characters escaped for DOT still belong to the actual path.`)
				(i32.lt width 1i32)
				(then (return (call report_dependency_failure target_index human))))
			(return (call check_header_path (borrow-shared (array.range label 0i32 width))
				(borrow-shared root) protection target_index human))))

	(fn next_line
		(:doc `Find an LF or the end of the captured output.`)
		(params (trace (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut end start)
			(while
				(:doc `The last ordinary stdout line need not have a trailing newline.`)
				(bool.and (i32.lt end (array.len trace))
					(u8.not-eq (array.load trace end) 10u8))
				(body (set end (i32.inc end))))
			(return end)))

	(fn forward_line
		(:doc `Preserve the original bounded stdout prefix while excluding the private graph stream.`)
		(params (trace (shared-array u8)) (start i32) (end i32) (forwarded i32)) (returns i32)
		(body
			(let room (i32.sub 65536i32 forwarded))
			(let-mut width (i32.sub end start))
			(if (i32.lt room width) (then (set width room)))
			(if
				(:doc `Only forward initialized bytes that fit the public tool output budget.`)
				(i32.gtz width)
				(then (let written (call write_stdout
					(borrow-shared (array.range trace start (i32.add start width)))))))
			(return (i32.add forwarded width))))

	(fn check_header_graphs
		(:doc `Consume every complete graph and leave ordinary Clang stdout visible to the caller.`)
		(params (trace (shared-array u8)) (root (shared-array u8)) (protection BuildProtection) (tool_status i32) (target_index i32) (human bool)) (returns i32)
		(body
			(let-mut at 0i32)
			(let-mut forwarded 0i32)
			(let-mut inside (bool false))
			(let-mut seen (bool false))
			(while
				(:doc `Each frontend appends its graph to the same output descriptor.`)
				(i32.lt at (array.len trace))
				(body
					(let end (call next_line (borrow-shared trace) at))
					(let-mut after end)
					(if (i32.lt end (array.len trace)) (then (set after (i32.inc end))))
					(if
						(:doc `Inside a graph, accept its terminator or check a complete dependency row.`)
						inside
						(then
							(if
								(:doc `Do not count a partial frontend trace as complete.`)
								(call same_bytes (borrow-shared trace) at end
									(borrow-shared graph_close) 0i32 (array.len graph_close))
								(then (set inside (bool false)) (set seen (bool true)))
								(else
									(let status (call check_graph_row (borrow-shared trace) at end
										(borrow-shared root) protection target_index human))
									(if (i32.gtz status) (then (return status))))))
						(else
							(if
								(:doc `Recognize only the compiler's complete graph-opening line as private output.`)
								(call same_bytes (borrow-shared trace) at end
									(borrow-shared graph_open) 0i32 (array.len graph_open))
								(then (set inside (bool true)))
								(else (set forwarded (call forward_line (borrow-shared trace)
									at after forwarded))))))
					(set at after)))
			(if
				(:doc `A successful tool must record a complete graph, and an interrupted graph is unsafe at any exit status.`)
				(bool.or inside (bool.and (i32.eqz tool_status) (bool.not seen)))
				(then (return (call report_dependency_failure target_index human))))
			(return 0i32)))

	(fn check_resolved_headers
		(:doc `Read the private stream before publishing any shared output.`)
		(params (path (shared-array u8)) (root (shared-array u8)) (protection BuildProtection) (tool_status i32) (target_index i32) (human bool)) (returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared path)))
			(let length (struct.get stamp length))
			(if
				(:doc `A launch failure may precede creation of the private stdout file.`)
				(bool.and (i32.not-eqz tool_status) (call file_is_absent stamp))
				(then (return 0i32)))
			(if (i32.ltz length) (then (return (call report_dependency_failure target_index human))))
			(let-mut trace (array.alloc u8 length))
			(if
				(:doc `Check all complete output before either shared path is touched.`)
				(bool.not (call read_source_file (borrow-shared path) stamp (borrow-mut trace)))
				(then (return (call report_dependency_failure target_index human))))
			(return (call check_header_graphs (borrow-shared trace) (borrow-shared root) protection tool_status target_index human))))
)
