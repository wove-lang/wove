(module driver_numbered_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Certify a checked include prefix in the private directory that will compile the numbered units.")

	(use wove-file "../clang/run.wove" (only run_clang_replay))
	(use wove-file "../clang/trace.wove" (only include_line trace_length))
	(use wove-file "../clang/replay.wove" (only replay_directives_safe replay_declarations_safe))
	(use wove-file "../clang/native_replay.wove" (only write_native_identities))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../emit/units.wove" (only write_unit_name))
	(use wove-file "../io/write.wove" (only write_new_file))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./files.wove" (only file_stamp same_file_stamp (type FileStamp)))
	(use c-header "<unistd.h>" (only unlink))

	(let common_name "program.h")
	(let common_directive "#include \"program.h\"\n")
	(let runtime_directive "#include \"wove_runtime.h\"\n")
	(let stdint_directive "#include <stdint.h>\n")
	(let implicit_stdint 1u8)
	(let implicit_runtime 2u8)
	(let names_begin "typedef char wove_native_replay_begin;\n")
	(let names_end "typedef char wove_native_replay_end;\n")
	(let common_probe "/* Numbered program header. */\n")
	(let counter_probe "\nenum { wove_header_replay_counter = __COUNTER__ };\n")
	(let capture_capacity 262144i32)
	(let trace_capacity 65536i32)
	(let statement_capacity 16384i32)
	(let native_ast_capacity 4194304i32)
	(let native_node_capacity 65536i32)
	(let include_limit 4096i32)

	(fn numbered_source_path
		(:doc "Use exactly the same unit names as the supplied-graph emitter.")
		(params (serial_path (shared-array u8)) (index i32)) (returns (owned-array u8))
		(body
			(let-mut name (array.alloc u8 14i32))
			(let length (call write_unit_name index (borrow-mut name)))
			(return (call join_file_path (borrow-shared serial_path)
				(borrow-shared (array.range name 0i32 length))))))

	(fn include_identities
		(:doc "Capture or compare device, inode, and extent for each file in the ordered include trace.")
		(params (trace (shared-array u8)) (identities (mut-array FileStamp)) (verify bool)) (returns bool)
		(body
			(let length (call trace_length (borrow-shared trace)))
			(let-mut cursor 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Unknown diagnostic lines or an exhausted identity table make replay uncertain.")
				(i32.lt cursor length)
				(body
					(let entry (call include_line (borrow-shared trace) cursor length))
					(if
						(:doc "Every retained line must identify a real include with a nonempty path.")
						(bool.or (i32.not-lt index (array.len identities))
							(bool.or (i32.eqz (struct.get entry depth))
								(i32.eq (struct.get entry start) (struct.get entry end))))
						(then (return (bool false))))
					(let stamp (call file_stamp (borrow-shared (array.range trace
						(struct.get entry start) (struct.get entry end)))))
					(if (i32.ltz (struct.get stamp length)) (then (return (bool false))))
					(if
						(:doc "A different regular file at the same spelling invalidates the serial observation.")
						verify
						(then
							(if (bool.not (call same_file_stamp (array.load identities index) stamp))
								(then (return (bool false)))))
						(else (array.store identities index stamp)))
					(set index (i32.inc index))
					(set cursor (struct.get entry next))))
			(return (i32.gtz index))))

	(fn baseline_end
		(:doc "Ignore the optional blank output lines after Clang's empty translation unit.")
		(params (source (shared-array u8)) (length i32)) (returns i32)
		(body
			(let-mut end length)
			(while
				(:doc "An empty or whitespace-only capture has no usable compiler baseline.")
				(bool.and (i32.gtz end) (u8.lt (array.load source (i32.dec end)) 33u8))
				(body (set end (i32.dec end))))
			(return end)))

	(fn staged_empty_baseline
		(:doc "Observe the compiler's built-in and configured preface using the exact serial filename.")
		(params (program (shared-array u8)) (options (shared-array u8)) (path (shared-array u8))
			(output (mut-array u8)) (trace (mut-array u8))) (returns i32)
		(body
			(let empty (array.alloc u8 0i32))
			(if (bool.not (call write_new_file (borrow-shared path) (borrow-shared empty))) (then (return -1i32)))
			(let result (call run_clang_replay (borrow-shared program) (borrow-shared options)
				(borrow-shared path) (bool true) (borrow-mut output) (borrow-mut trace)))
			(let removed (call unlink (borrow-shared path)))
			(if
				(:doc "Use only a complete private probe and release its staged path before the serial capture.")
				(bool.or (i32.not-eqz removed) (u32.not-eqz (struct.get result error)))
				(then (return -1i32)))
			(return (call baseline_end (borrow-shared output) (struct.get result length)))))

	(fn serial_snapshot
		(:doc "Check the serial prefix's preprocessing and declarations together before comparing numbered paths.")
		(params (program (shared-array u8)) (options (shared-array u8)) (path (shared-array u8))
			(baseline (shared-array u8)) (preprocessed (mut-array u8)) (trace (mut-array u8))
			(identities (mut-array FileStamp)) (borrowed bool) (writable bool)) (returns i32)
		(body
			(let pp (call run_clang_replay (borrow-shared program) (borrow-shared options)
				(borrow-shared path) (bool true) (borrow-mut preprocessed) (borrow-mut trace)))
			(let base (array.len baseline))
			(let length (struct.get pp length))
			(if
				(:doc "The selected includes must replay the observed compiler preface.")
				(bool.or (bool.or (u32.not-eqz (struct.get pp error)) (i32.not-lt base length))
					(bool.not (call same_bytes (borrow-shared baseline) 0i32 base
						(borrow-shared preprocessed) 0i32 base)))
				(then (return -1i32)))
			(let text (borrow-shared (array.range preprocessed 0i32 length)))
			(if
				(:doc "Ordinary replay can reject unfamiliar directives before paying for the AST query.")
				(bool.not (bool.or borrowed writable))
				(then
					(let no_ast (array.alloc JsonNode 0i32))
					(if
						(:doc "An ordinary plan certifies only the original inert directive grammar.")
						(bool.not (call replay_directives_safe (borrow-shared text) base
							(borrow-shared baseline) (borrow-shared no_ast) (bool false) (bool false)))
						(then (return -1i32)))))
			(if
				(:doc "The trace must identify every header before the JSON AST pass.")
				(bool.not (call include_identities (borrow-shared trace) (borrow-mut identities) (bool false)))
				(then (return -1i32)))
			(let-mut ast (array.alloc u8 capture_capacity))
			(let-mut ast_trace (array.alloc u8 trace_capacity))
			(let declarations (call run_clang_replay (borrow-shared program) (borrow-shared options)
				(borrow-shared path) (bool false) (borrow-mut ast) (borrow-mut ast_trace)))
			(if
				(:doc "AST and preprocessing must agree on the ordered header identities.")
				(bool.or (u32.not-eqz (struct.get declarations error))
					(bool.or (bool.not (call same_bytes (borrow-shared trace) 0i32 (call trace_length (borrow-shared trace))
							(borrow-shared ast_trace) 0i32 (call trace_length (borrow-shared ast_trace))))
						(bool.not (call include_identities (borrow-shared ast_trace) (borrow-mut identities) (bool true)))))
				(then (return -1i32)))
			(let-mut statements (array.alloc JsonNode statement_capacity))
			(let declarations_bytes (borrow-shared (array.range ast 0i32 (struct.get declarations length))))
			(if
				(:doc "Header-local state and function definitions require the serial C unit.")
				(bool.not (call replay_declarations_safe (borrow-shared declarations_bytes) (borrow-mut statements) borrowed writable))
				(then (return -1i32)))
			(if
				(:doc "A borrowed object's new macro may only name an externally declared live slot.")
				(bool.and (bool.or borrowed writable) (bool.not (call replay_directives_safe (borrow-shared text) base
					(borrow-shared declarations_bytes) (borrow-shared statements) borrowed writable)))
				(then (return -1i32)))
			(return length)))

	(fn nested_include_trace_matches
		(:doc "Compare the same header rows and file identities around the one extra generated header.")
		(params (serial (shared-array u8)) (numbered (shared-array u8))
			(identities (shared-array FileStamp)) (boundary i32) (shared (shared-array u8)))
		(returns bool)
		(body
			(let serial_end (call trace_length (borrow-shared serial)))
			(let numbered_end (call trace_length (borrow-shared numbered)))
			(let-mut left 0i32)
			(let-mut right 0i32)
			(let-mut index 0i32)
			(while
				(:doc "Only the generated header and the extra depth of its children may differ.")
				(bool.and (i32.lt left serial_end) (i32.lt right numbered_end))
				(body
					(if
						(:doc "The staged program header must follow the complete selected include trace.")
						(i32.eq left boundary)
						(then
							(let entry (call include_line (borrow-shared numbered) right numbered_end))
							(if
								(:doc "The single extra include must be the exact private program header.")
								(bool.or (i32.not-eq (struct.get entry depth) 1i32)
									(bool.not (call same_bytes (borrow-shared numbered) (struct.get entry start)
										(struct.get entry end) (borrow-shared shared) 0i32 (array.len shared))))
								(then (return (bool false))))
							(set right (struct.get entry next))
							(if (i32.eq right numbered_end) (then (return (bool false))))))
					(let expected (call include_line (borrow-shared serial) left serial_end))
					(let actual (call include_line (borrow-shared numbered) right numbered_end))
					(let depth (i32.add (struct.get expected depth)
						(if (i32.lt left boundary) (then 0i32) (else 1i32))))
					(if
						(:doc "Different lookup paths or nesting can affect future include and macro resolution.")
						(bool.or (i32.not-eq depth (struct.get actual depth))
							(bool.not (call same_bytes (borrow-shared serial) (struct.get expected start)
								(struct.get expected end) (borrow-shared numbered) (struct.get actual start) (struct.get actual end))))
						(then (return (bool false))))
					(let stamp (call file_stamp (borrow-shared (array.range numbered
						(struct.get actual start) (struct.get actual end)))))
					(if
						(:doc "Check the physical file even when its spelling has not changed.")
						(bool.not (call same_file_stamp stamp (array.load identities index)))
						(then (return (bool false))))
					(set left (struct.get expected next))
					(set right (struct.get actual next))
					(set index (i32.inc index))))
			(return (bool.and (i32.eq left serial_end) (i32.eq right numbered_end)))))

	(fn replay_trace_matches
		(:doc "Use the ordinary flat proof or the borrowed proof with the actual runtime include nesting.")
		(params (serial (shared-array u8)) (numbered (shared-array u8)) (identities (mut-array FileStamp))
			(boundary i32) (shared (shared-array u8))) (returns bool)
		(body
			(if
				(:doc "A borrowed runtime replay accounts for the deliberate generated header boundary.")
				(i32.not-ltz boundary)
				(then (return (call nested_include_trace_matches (borrow-shared serial)
					(borrow-shared numbered) (borrow-shared identities) boundary (borrow-shared shared)))))
			(return (bool.and (call same_bytes (borrow-shared serial) 0i32 (call trace_length (borrow-shared serial))
					(borrow-shared numbered) 0i32 (call trace_length (borrow-shared numbered)))
				(call include_identities (borrow-shared numbered) (borrow-mut identities) (bool true))))))

	(fn read_native_identities
		(:doc "Resolve the native link identities in the same include context already witnessed by preprocessing.")
		(params (program (shared-array u8)) (options (shared-array u8)) (path (shared-array u8))
			(serial_trace (shared-array u8)) (identities (mut-array FileStamp)) (boundary i32)
			(shared (shared-array u8)) (output (mut-array u8))) (returns i32)
		(body
			(let-mut ast (array.alloc u8 native_ast_capacity))
			(let-mut trace (array.alloc u8 trace_capacity))
			(let result (call run_clang_replay (borrow-shared program) (borrow-shared options)
				(borrow-shared path) (bool false) (borrow-mut ast) (borrow-mut trace)))
			(if
				(:doc "The identity query must resolve the same ordered headers as the preprocessor.")
				(bool.or (u32.not-eqz (struct.get result error))
					(bool.not (call replay_trace_matches (borrow-shared serial_trace) (borrow-shared trace)
						(borrow-mut identities) boundary (borrow-shared shared))))
				(then (return -1i32)))
			(let-mut statements (array.alloc JsonNode native_node_capacity))
			(return (call write_native_identities (borrow-shared (array.range ast 0i32 (struct.get result length)))
				(borrow-mut statements) (borrow-mut output)))))

	(fn matching_numbered_sources
		(:doc "Require identical effective preprocessing and selected headers at every numbered filename.")
		(params (program (shared-array u8)) (options (shared-array u8)) (serial_path (shared-array u8)) (count i32)
			(serial (shared-array u8)) (serial_trace (shared-array u8)) (identities (mut-array FileStamp))
			(boundary i32) (shared (shared-array u8)) (native_identities (shared-array u8))) (returns bool)
		(body
			(let-mut output (array.alloc u8 capture_capacity))
			(let-mut trace (array.alloc u8 trace_capacity))
			(let-mut native (array.alloc u8 (array.len native_identities)))
			(let-mut unit 0i32)
			(while
				(:doc "Even a later numbered file can take a different header path under the effective options.")
				(i32.lt unit count)
				(body
					(let path (call numbered_source_path (borrow-shared serial_path) unit))
					(let result (call run_clang_replay (borrow-shared program) (borrow-shared options)
						(borrow-shared path) (bool true) (borrow-mut output) (borrow-mut trace)))
					(if
						(:doc "Reject differences in preprocessing, include order, or resolved identity.")
						(bool.or (u32.not-eqz (struct.get result error))
							(bool.or (bool.not (call same_bytes (borrow-shared serial) 0i32 (array.len serial)
									(borrow-shared output) 0i32 (struct.get result length)))
								(bool.not (call replay_trace_matches (borrow-shared serial_trace)
									(borrow-shared trace) (borrow-mut identities) boundary (borrow-shared shared)))))
						(then (return (bool false))))
					(if
						(:doc "Equal expansion bytes must also resolve to the same witnessed native types and linked functions.")
						(i32.gtz (array.len native_identities))
						(then
							(let length (call read_native_identities (borrow-shared program) (borrow-shared options)
								(borrow-shared path) (borrow-shared serial_trace) (borrow-mut identities)
								boundary (borrow-shared shared) (borrow-mut native)))
							(if
								(:doc "Compare only the stable resolved fields from each Clang AST.")
								(bool.or (i32.ltz length)
									(bool.not (call same_bytes (borrow-shared native_identities) 0i32 (array.len native_identities)
										(borrow-shared native) 0i32 length)))
								(then (return (bool false))))))
					(set unit (i32.inc unit))))
			(return (bool true))))

	(fn replay_numbered_context
		(:doc "Stage all numbered names together and remove only the files this audit created.")
		(params (program (shared-array u8)) (options (shared-array u8)) (serial_path (shared-array u8)) (count i32)
			(probe (shared-array u8)) (header (shared-array u8)) (serial (shared-array u8))
			(trace (shared-array u8)) (identities (mut-array FileStamp)) (boundary i32) (native_identities (shared-array u8)))
		(returns bool)
		(body
			(let shared (call join_file_path (borrow-shared serial_path) (borrow-shared common_name)))
			(if (bool.not (call write_new_file (borrow-shared shared) (borrow-shared header))) (then (return (bool false))))
			(let-mut created 0i32)
			(let-mut complete (bool true))
			(while
				(:doc "No header test can depend on a numbered filename being absent during the audit.")
				(bool.and complete (i32.lt created count))
				(body
					(let path (call numbered_source_path (borrow-shared serial_path) created))
					(set complete (call write_new_file (borrow-shared path) (borrow-shared probe)))
					(if complete (then (set created (i32.inc created))))))
			(let matched (bool.and complete
				(call matching_numbered_sources (borrow-shared program) (borrow-shared options)
					(borrow-shared serial_path) count (borrow-shared serial) (borrow-shared trace) (borrow-mut identities)
					boundary (borrow-shared shared) (borrow-shared native_identities))))
			(let-mut cleaned (i32.eqz (call unlink (borrow-shared shared))))
			(while
				(:doc "Release every staged filename on either result even if an earlier removal failed.")
				(i32.gtz created)
				(body
					(set created (i32.dec created))
					(let path (call numbered_source_path (borrow-shared serial_path) created))
					(let removed (call unlink (borrow-shared path)))
					(set cleaned (bool.and cleaned (i32.eqz removed)))))
			(return (bool.and matched cleaned))))

	(fn find_name_marker
		(:doc "Find one complete delimiter line in a bounded preprocessor capture.")
		(params (output (shared-array u8)) (marker (shared-array u8)) (start i32)) (returns i32)
		(body
			(let-mut offset start)
			(let width (array.len marker))
			(let last (i32.sub (array.len output) width))
			(while
				(:doc "Only a delimiter at the start of a preprocessed declaration line can match.")
				(i32.le offset last)
				(body
					(if
						(:doc "The marker is emitted as a single declaration on its own line.")
						(bool.and (bool.and (u8.eq (array.load output offset) 116u8)
								(bool.or (i32.eqz offset) (u8.eq (array.load output (i32.dec offset)) 10u8)))
							(call same_bytes (borrow-shared output) offset (i32.add offset width)
								(borrow-shared marker) 0i32 width))
						(then (return offset)))
					(set offset (i32.inc offset))))
			(return -1i32)))

	(fn native_names_preserved
		(:doc "Require each already certified native expression to expand identically after the implicit headers.")
		(params (output (shared-array u8))) (returns bool)
		(body
			(let first (call find_name_marker (borrow-shared output) (borrow-shared names_begin) 0i32))
			(if (i32.ltz first) (then (return (bool false))))
			(let start (i32.add first (array.len names_begin)))
			(let end (call find_name_marker (borrow-shared output) (borrow-shared names_end) start))
			(if (i32.le end start) (then (return (bool false))))
			(let second (call find_name_marker (borrow-shared output) (borrow-shared names_begin)
				(i32.add end (array.len names_end))))
			(if (i32.ltz second) (then (return (bool false))))
			(let next (i32.add second (array.len names_begin)))
			(let last (call find_name_marker (borrow-shared output) (borrow-shared names_end) next))
			(return (bool.and (i32.lt next last) (call same_bytes (borrow-shared output) start end
				(borrow-shared output) next last)))))

	(fn implicit_replay_source
		(:doc "Place any checked native operands on either side of the implicit include, followed by the counter.")
		(params (prefix (shared-array u8)) (names (shared-array u8)) (directive (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let length (u64.add (u64.from-i32 (array.len prefix))
				(u64.add (u64.mul 2u64 (u64.from-i32 (array.len names)))
					(u64.from-i32 (i32.add (array.len directive) (array.len counter_probe))))))
			(if (u64.gt length 2147483647u64) (then (return (array.alloc u8 0i32))))
			(let-mut output (array.alloc u8 (i32.from-u64 length)))
			(let first (call append_bytes (borrow-shared prefix) (borrow-mut output) 0i32))
			(let before (call append_bytes (borrow-shared names) (borrow-mut output) first))
			(let after (call append_bytes (borrow-shared directive) (borrow-mut output) before))
			(let last (call append_bytes (borrow-shared names) (borrow-mut output) after))
			(let end (call append_bytes (borrow-shared counter_probe) (borrow-mut output) last))
			(return (move output))))

	(fn certify_implicit_context
		(:doc "Replay the actual implicit header at serial and numbered include depth.")
		(params (program (shared-array u8)) (options (shared-array u8)) (serial_path (shared-array u8)) (count i32)
			(prefix (shared-array u8)) (names (shared-array u8)) (explicit_trace (shared-array u8))
			(directive (shared-array u8)) (output (mut-array u8)) (trace (mut-array u8))
			(identities (mut-array FileStamp)) (resolve_native bool))
		(returns bool)
		(body
			(let serial (call implicit_replay_source (borrow-shared prefix) (borrow-shared names)
				(borrow-shared directive)))
			(if
				(:doc "Never overwrite an existing serial source or run with an exhausted probe.")
				(bool.or (i32.eqz (array.len serial))
					(bool.not (call write_new_file (borrow-shared serial_path) (borrow-shared serial))))
				(then (return (bool false))))
			(let result (call run_clang_replay (borrow-shared program) (borrow-shared options)
				(borrow-shared serial_path) (bool true) (borrow-mut output) (borrow-mut trace)))
			(let identified (bool.and (u32.eqz (struct.get result error))
				(call include_identities (borrow-shared trace) (borrow-mut identities) (bool false))))
			(let-mut native (array.alloc u8 (if resolve_native (then capture_capacity) (else 0i32))))
			(let width (if
				(:doc "The actual serial preamble establishes the external identities to compare.")
				(bool.and identified resolve_native)
				(then (call read_native_identities (borrow-shared program) (borrow-shared options)
					(borrow-shared serial_path) (borrow-shared trace) (borrow-mut identities)
					-1i32 (borrow-shared serial_path) (borrow-mut native)))
				(else 0i32)))
			(let removed (call unlink (borrow-shared serial_path)))
			(let boundary (call trace_length (borrow-shared explicit_trace)))
			(if
				(:doc "The implicit header must extend the already certified explicit include trace.")
				(bool.or (bool.or (i32.not-eqz removed) (bool.and resolve_native (i32.not-gtz width)))
					(bool.or (bool.not identified)
					(bool.or (i32.ge boundary (call trace_length (borrow-shared trace)))
						(bool.not (call same_bytes (borrow-shared explicit_trace) 0i32 boundary
							(borrow-shared trace) 0i32 boundary)))))
				(then (return (bool false))))
			(let text (borrow-shared (array.range output 0i32 (struct.get result length))))
			(if
				(:doc "The implicit headers must preserve the checked native operands.")
				(bool.and (i32.gtz (array.len names)) (bool.not (call native_names_preserved (borrow-shared text))))
				(then (return (bool false))))
			(let numbered (call implicit_replay_source (borrow-shared prefix) (borrow-shared names)
				(borrow-shared common_directive)))
			(if (i32.eqz (array.len numbered)) (then (return (bool false))))
			(return (call replay_numbered_context (borrow-shared program) (borrow-shared options)
				(borrow-shared serial_path) count (borrow-shared numbered) (borrow-shared directive)
				(borrow-shared text) (borrow-shared trace) (borrow-mut identities) boundary
				(borrow-shared (array.range native 0i32 width))))))

	(fn certify_numbered_includes
		(:doc `Certify the selected bytes from write_includes for the final staged frontend context.

		Use the actual compiler program, complete packed frontend arguments,
		serial C path in its private build directory, and effective unit count. A true
		result authorizes only these same prefix bytes and context. The caller
		passes the bytes to the emitter immediately and keeps the include inputs
		and compiler options fixed until native compilation. A final counter
		expansion exposes preprocessing state that produces no source of its own.
		An uncertain audit leaves the serial path and its diagnostics available.`)
		(params (program (shared-array u8)) (options (shared-array u8)) (serial_path (shared-array u8))
			(count i32) (prefix (shared-array u8)) (guards (shared-array u8)) (names (shared-array u8))
			(implicit u8) (borrowed bool) (writable bool) (resolve_native bool)) (returns bool)
		(body
			(if
				(:doc "Graphs without selected headers have nothing to replay or query.")
				(i32.eqz (array.len prefix))
				(then (return (bool true))))
			(if
				(:doc "A caller must have planned multiple units in a private directory.")
				(bool.or (i32.not-lt 1i32 count) (i32.eqz (array.len serial_path)))
				(then (return (bool false))))
			(let size (u64.add (u64.from-i32 (array.len guards))
				(u64.add (u64.from-i32 (array.len prefix))
					(u64.add (u64.from-i32 (array.len names)) (u64.from-i32 (array.len counter_probe))))))
			(if (u64.gt size 2147483647u64) (then (return (bool false))))
			(let-mut probe (array.alloc u8 (i32.from-u64 size)))
			(let start (call append_bytes (borrow-shared guards) (borrow-mut probe) 0i32))
			(let next (call append_bytes (borrow-shared prefix) (borrow-mut probe) start))
			(let witnessed (call append_bytes (borrow-shared names) (borrow-mut probe) next))
			(let end (call append_bytes (borrow-shared counter_probe) (borrow-mut probe) witnessed))
			(let-mut baseline (array.alloc u8 capture_capacity))
			(let-mut trace (array.alloc u8 trace_capacity))
			(let base (call staged_empty_baseline (borrow-shared program) (borrow-shared options)
				(borrow-shared serial_path) (borrow-mut baseline) (borrow-mut trace)))
			(if
				(:doc "Do not overwrite an existing serial file or classify a failed compiler invocation.")
				(bool.or (i32.not-lt 0i32 base)
					(bool.not (call write_new_file (borrow-shared serial_path) (borrow-shared probe))))
				(then (return (bool false))))
			(let-mut source (array.alloc u8 capture_capacity))
			(let-mut identities (array.alloc FileStamp include_limit))
			(let width (call serial_snapshot (borrow-shared program) (borrow-shared options) (borrow-shared serial_path)
				(borrow-shared (array.range baseline 0i32 base)) (borrow-mut source) (borrow-mut trace)
				(borrow-mut identities) borrowed writable))
			(let direct (bool.and resolve_native (u8.eqz implicit)))
			(let-mut native (array.alloc u8 (if direct (then capture_capacity) (else 0i32))))
			(let native_width (if
				(:doc "Without an implicit include, the audited serial prefix is the actual identity context.")
				(bool.and direct (i32.not-ltz width))
				(then (call read_native_identities (borrow-shared program) (borrow-shared options)
					(borrow-shared serial_path) (borrow-shared trace) (borrow-mut identities)
					-1i32 (borrow-shared serial_path) (borrow-mut native)))
				(else 0i32)))
			(let removed (call unlink (borrow-shared serial_path)))
			(if
				(:doc "A failed audit or missing required identity leaves the original serial path available.")
				(bool.or (bool.or (i32.ltz width) (i32.not-eqz removed))
					(bool.and direct (i32.not-gtz native_width)))
				(then (return (bool false))))
			(if
				(:doc "Native layouts and operands can depend on the implicit preamble context.")
				(u8.gtz implicit)
				(then
					(let-mut implicit_trace (array.alloc u8 trace_capacity))
					(if
						(:doc "A fixed-width-only preamble includes stdint directly.")
						(u8.eq implicit implicit_stdint)
						(then (return (call certify_implicit_context (borrow-shared program) (borrow-shared options)
							(borrow-shared serial_path) count (borrow-shared (array.range probe 0i32 next))
							(borrow-shared names) (borrow-shared trace) (borrow-shared stdint_directive)
							(borrow-mut source) (borrow-mut implicit_trace) (borrow-mut identities) resolve_native))))
					(return (call certify_implicit_context (borrow-shared program) (borrow-shared options)
						(borrow-shared serial_path) count (borrow-shared (array.range probe 0i32 next))
						(borrow-shared names) (borrow-shared trace) (borrow-shared runtime_directive)
						(borrow-mut source) (borrow-mut implicit_trace) (borrow-mut identities) resolve_native))))
			(return (call replay_numbered_context (borrow-shared program) (borrow-shared options)
				(borrow-shared serial_path) count (borrow-shared probe) (borrow-shared common_probe)
				(borrow-shared (array.range source 0i32 width)) (borrow-shared trace) (borrow-mut identities) -1i32
				(borrow-shared (array.range native 0i32 native_width))))))
)
