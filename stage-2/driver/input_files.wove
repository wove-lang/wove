(module native_resolved_inputs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Protect file paths selected by the checked header and embed plans.`)

	(use wove-file "./assets.wove" (only asset_owner))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./protection.wove" (only protected_input report_input_collision (type BuildProtection)))
	(use wove-file "../source/assets.wove" (only decode_asset_path (type EmbedAsset)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../c/headers.wove" (only c_header_form))
	(use wove-file "../text/match.wove" (only is_byte_at))
	(use wove-file "../emit/headers.wove" (only first_header_binding))

	(fn local_input_path
		(:doc `Join the input to its defining directory, using the canonical entry for row zero.`)
		(params (entry (shared-slice u8)) (source (shared-slice u8)) (files (shared-slice SuppliedFile))
			(origin i32) (path (shared-slice u8))) (returns (owned-array u8))
		(body
			(if
				(:doc `Only imported rows need their path read out of the graph arena.`)
				(i32.lt 0i32 (local origin))
				(then
					(let file (slice.load (local files) (local origin)))
					(return (call join_file_path
						(borrow-shared (slice.range (local source) (struct.get (local file) path_start) (struct.get (local file) path_end)))
						(borrow-shared (local path))))))
			(return (call join_file_path (borrow-shared (local entry)) (borrow-shared (local path))))))

	(fn check_local_path
		(:doc `Check a selected local file before emission can reach either publication path.`)
		(params (entry (shared-slice u8)) (source (shared-slice u8)) (files (shared-slice SuppliedFile))
			(origin i32) (path (shared-slice u8)) (protection BuildProtection)) (returns i32)
		(body
			(let input (call local_input_path (borrow-shared (local entry)) (borrow-shared (local source))
				(borrow-shared (local files)) (local origin) (borrow-shared (local path))))
			(if
				(:doc `Run protection before any C or private build artifact can replace the selected input.`)
				(call protected_input (borrow-shared (local input)) (local protection))
				(then (return (call report_input_collision (borrow-shared (local input))))))
			(return 0i32)))

	(fn check_asset_inputs
		(:doc `Look only at populated requests produced by semantic planning and use the asset reader's path rules.`)
		(params (entry (shared-slice u8)) (source (shared-slice u8)) (files (shared-slice SuppliedFile))
			(requests (shared-slice EmbedAsset)) (protection BuildProtection)) (returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc `Unused rows have no quoted path and never name filesystem inputs.`)
				(i32.lt (local row) (slice.len (local requests)))
				(body
					(let asset (slice.load (local requests) (local row)))
					(let start (struct.get (local asset) path_start))
					(let end (struct.get (local asset) path_end))
					(if
						(:doc `Leave invalid paths to the asset reader's original source diagnostic.`)
						(i32.lt (local start) (local end))
						(then
							(let-mut path (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
							(let width (call decode_asset_path (borrow-shared (local source)) (local start) (local end)
								(borrow-mut (local path))))
							(if
								(:doc `Only an understood path can be checked against a destination.`)
								(i32.lt 0i32 (local width))
								(then
									(let status (call check_local_path (borrow-shared (local entry)) (borrow-shared (local source))
										(borrow-shared (local files)) (call asset_owner (borrow-shared (local files)) (local asset))
										(borrow-shared (slice.range (local path) 0i32 (local width))) (local protection)))
									(if (i32.lt 0i32 (local status)) (then (return (local status))))))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return 0i32)))

	(fn check_header_input
		(:doc `Resolve local include operands against the file that supplied the selected bridge.`)
		(params (entry (shared-slice u8)) (source (shared-slice u8)) (files (shared-slice SuppliedFile))
			(binding GraphBinding) (protection BuildProtection)) (returns i32)
		(body
			(let origin (struct.get (local binding) header_file))
			(let base (struct.get (slice.load (local files) (local origin)) source_start))
			(let start (i32.add.wrapping (local base) (struct.get (local binding) header_start)))
			(let end (i32.add.wrapping (local base) (struct.get (local binding) header_end)))
			(let-mut name (array.alloc u8 (i32.sub.wrapping (local end) (local start))))
			(let decoded (call decode_string (borrow-shared (local source))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local name))))
			(let width (struct.get (local decoded) written))
			(let form (call c_header_form (borrow-shared (slice.range (local name) 0i32 (local width)))))
			(if
				(:doc `System headers belong to the toolchain search path, and invalid operands keep the emitter diagnostic.`)
				(bool.or (u32.eq (local form) 0u32) (call is_byte_at (borrow-shared (local name)) 0i32 0i32 60u8))
				(then (return 0i32)))
			(if
				(:doc `Strip explicit C quote delimiters before resolving the local filename.`)
				(u32.eq (local form) 2u32)
				(then (return (call check_local_path (borrow-shared (local entry)) (borrow-shared (local source))
					(borrow-shared (local files)) (local origin)
					(borrow-shared (slice.range (local name) 1i32 (i32.sub.wrapping (local width) 1i32))) (local protection)))))
			(return (call check_local_path (borrow-shared (local entry)) (borrow-shared (local source))
				(borrow-shared (local files)) (local origin) (borrow-shared (slice.range (local name) 0i32 (local width)))
				(local protection)))))

	(fn check_header_inputs
		(:doc `Visit exactly the selected bridge include literals in emitter order.`)
		(params (entry (shared-slice u8)) (source (shared-slice u8)) (files (shared-slice SuppliedFile))
			(bindings (shared-slice GraphBinding)) (protection BuildProtection)) (returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc `A selected bridge can contribute more than one name but only one include path.`)
				(i32.lt (local row) (slice.len (local bindings)))
				(body
					(let binding (slice.load (local bindings) (local row)))
					(if
						(:doc `The code generator will include only the first selection of this header literal.`)
						(call first_header_binding (borrow-shared (local bindings)) (local row) (local binding))
						(then
							(let status (call check_header_input (borrow-shared (local entry)) (borrow-shared (local source))
								(borrow-shared (local files)) (local binding) (local protection)))
							(if (i32.lt 0i32 (local status)) (then (return (local status))))))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return 0i32))))
