(module native_resolved_inputs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Protect file paths selected by the checked header and embed plans.`)

	(use wove-file "./assets.wove" (only asset_owner))
	(use wove-file "./paths.wove" (only join_file_path))
	(use wove-file "./protection.wove" (only protected_input report_input_collision (type BuildProtection)))
	(use wove-file "../source/assets.wove" (only decode_asset_path (type EmbedAsset)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../c/headers.wove" (only c_header_form))
	(use wove-file "../text/match.wove" (only is_byte_at))
	(use wove-file "../emit/headers.wove" (only first_header_binding))

	(fn local_input_path
		(:doc `Join the input to its defining directory, using the canonical entry for row zero.`)
		(params (entry (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile))
			(origin i32) (path (shared-array u8))) (returns (owned-array u8))
		(body
			(if
				(:doc `Only imported rows need their path read out of the graph arena.`)
				(i32.gtz origin)
				(then
					(let file (array.load files origin))
					(return (call join_file_path
						(borrow-shared (array.range source (struct.get file path_start) (struct.get file path_end)))
						(borrow-shared path)))))
			(return (call join_file_path (borrow-shared entry) (borrow-shared path)))))

	(fn check_local_path
		(:doc `Check a selected local file before emission can reach either publication path.`)
		(params (entry (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile))
			(origin i32) (path (shared-array u8)) (protection BuildProtection) (human bool)) (returns i32)
		(body
			(let input (call local_input_path (borrow-shared entry) (borrow-shared source)
				(borrow-shared files) origin (borrow-shared path)))
			(if
				(:doc `Run protection before any C or private build artifact can replace the selected input.`)
				(call protected_input (borrow-shared input) protection)
				(then (return (call report_input_collision (borrow-shared input) human))))
			(return 0i32)))

	(fn check_asset_inputs
		(:doc `Look only at populated requests produced by semantic planning and use the asset reader's path rules.`)
		(params (entry (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile))
			(requests (shared-array EmbedAsset)) (protection BuildProtection) (human bool)) (returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc `Unused rows have no quoted path and never name filesystem inputs.`)
				(i32.lt row (array.len requests))
				(body
					(let asset (array.load requests row))
					(let start (struct.get asset path_start))
					(let end (struct.get asset path_end))
					(if
						(:doc `Leave invalid paths to the asset reader's original source diagnostic.`)
						(i32.lt start end)
						(then
							(let-mut path (array.alloc u8 (i32.sub end start)))
							(let width (call decode_asset_path (borrow-shared source) start end
								(borrow-mut path)))
							(if
								(:doc `Only an understood path can be checked against a destination.`)
								(i32.gtz width)
								(then
									(let status (call check_local_path (borrow-shared entry) (borrow-shared source)
										(borrow-shared files) (call asset_owner (borrow-shared files) asset)
										(borrow-shared (array.range path 0i32 width)) protection human))
									(if (i32.gtz status) (then (return status)))))))
					(set row (i32.inc row))))
			(return 0i32)))

	(fn check_header_input
		(:doc `Resolve local include operands against the file that supplied the selected bridge.`)
		(params (entry (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile))
			(binding GraphBinding) (protection BuildProtection) (human bool)) (returns i32)
		(body
			(let origin (struct.get binding header_file))
			(let base (struct.get (array.load files origin) source_start))
			(let start (i32.add base (struct.get binding header_start)))
			(let end (i32.add base (struct.get binding header_end)))
			(let-mut name (array.alloc u8 (i32.sub end start)))
			(let decoded (call decode_string (borrow-shared source)
				(struct.new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut name)))
			(let width (struct.get decoded written))
			(let form (call c_header_form (borrow-shared (array.range name 0i32 width))))
			(if
				(:doc `System headers belong to the toolchain search path, and invalid operands keep the emitter diagnostic.`)
				(bool.or (u32.eqz form) (call is_byte_at (borrow-shared name) 0i32 0i32 60u8))
				(then (return 0i32)))
			(if
				(:doc `Strip explicit C quote delimiters before resolving the local filename.`)
				(u32.eq form 2u32)
				(then (return (call check_local_path (borrow-shared entry) (borrow-shared source)
					(borrow-shared files) origin
					(borrow-shared (array.range name 1i32 (i32.dec width))) protection human))))
			(return (call check_local_path (borrow-shared entry) (borrow-shared source)
				(borrow-shared files) origin (borrow-shared (array.range name 0i32 width))
				protection human))))

	(fn check_header_inputs
		(:doc `Visit exactly the selected bridge include literals in emitter order.`)
		(params (entry (shared-array u8)) (source (shared-array u8)) (files (shared-array SuppliedFile))
			(bindings (shared-array GraphBinding)) (protection BuildProtection) (human bool)) (returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc `A selected bridge can contribute more than one name but only one include path.`)
				(i32.lt row (array.len bindings))
				(body
					(let binding (array.load bindings row))
					(if
						(:doc `The code generator will include only the first selection of this header literal.`)
						(call first_header_binding (borrow-shared bindings) 0i32 row binding)
						(then
							(let status (call check_header_input (borrow-shared entry) (borrow-shared source)
								(borrow-shared files) binding protection human))
							(if (i32.gtz status) (then (return status)))))
					(set row (i32.inc row))))
			(return 0i32))))
