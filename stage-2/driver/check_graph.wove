(module native_check_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check the surviving portion of a disk graph after independent failures.

	File rows and byte ranges keep their defining identities in every attempt.
	Failed modules and files that depend on them never enter another plan.`)

	(use wove-file "./graph.wove" (only report_entry_emission))
	(use wove-file "./graph_emit.wove" (only emit_entry_graph))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "../source/graph.wove" (only copy_graph_bindings fail_graph_file (type GraphModule) (type GraphBinding) (type DiskEdge) (type GraphResult)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))

	(fn failed_file
		(:doc "Negative sentinels represent no defining file.")
		(params (modules (shared-array GraphModule)) (file i32))
		(returns bool)
		(body
			(return (bool:and (i32:lt -1i32 file)
				(struct:get (modules.get file) failed)))))

	(fn fail_if_needed
		(:doc "Block one importer after a failed dependency, returning whether its state changed.")
		(params (modules (mut-array GraphModule)) (file i32))
		(returns bool)
		(body
			(let module (modules.get file))
			(if (module.get failed) (then (return (bool false))))
			(call fail_graph_file (borrow-mut modules) file (module.get next_use))
			(return (bool true))))

	(fn failed_binding_target
		(:doc "A native binding can depend on multiple physical provider files through overlays.")
		(params (modules (shared-array GraphModule)) (row GraphBinding))
		(returns bool)
		(body
			(return (bool:or (call failed_file (borrow-shared modules) (row.get file))
				(bool:and (u32:eq (row.get provider) 8u32)
					(bool:or (call failed_file (borrow-shared modules) (row.get header_file))
						(bool:or (call failed_file (borrow-shared modules) (row.get native_file))
							(call failed_file (borrow-shared modules) (row.get default_file)))))))))

	(fn propagate_failed_inputs
		(:doc "Remove all transitive dependents of a failed file before retrying the graph plan.")
		(params (modules (mut-array GraphModule)) (edges (shared-array DiskEdge)) (bindings (shared-array GraphBinding)))
		(returns void)
		(body
			(let-mut changed (bool true))
			(while
				(:doc "Only newly blocked files can make the next pass find another dependent.")
				changed
				(body
					(set changed (bool false))
					(let-mut edge 0i32)
					(while
						(:doc "Even an import with an empty selection depends on the provider.")
						(i32:lt edge edges.len)
						(body
							(let item (edges.get edge))
							(if
								(:doc "Keep an unrelated sibling eligible even if its importer failed.")
								(call failed_file (borrow-shared modules) (item.get target))
								(then (set changed (bool:or (call fail_if_needed (borrow-mut modules)
									(item.get file)) changed))))
							(set edge (i32:inc edge))))
					(let-mut binding 0i32)
					(while
						(:doc "Follow defining-file dependencies that do not have a Wove-file edge.")
						(i32:lt binding bindings.len)
						(body
							(let row (bindings.get binding))
							(if
								(:doc "A dependent C binding also needs its original providers.")
								(call failed_binding_target (borrow-shared modules) row)
								(then (set changed (bool:or (call fail_if_needed (borrow-mut modules)
									(row.get owner)) changed))))
							(set binding (i32:inc binding))))))))

	(fn select_check_modules
		(:doc "Leave a zeroed slot for each failed file so the planner does not parse or check it again.")
		(params (modules (shared-array GraphModule)) (selected (mut-array GraphModule)))
		(returns void)
		(body
			(let-mut file 0i32)
			(while
				(:doc "The selected view retains the canonical file indices.")
				(i32:lt file selected.len)
				(body
					(let module (modules.get file))
					(if
						(:doc "Only valid reached modules contribute declaration trees.")
						(bool:not (module.get failed))
						(then (selected.set file module)))
					(set file (i32:inc file))))))

	(fn select_check_bindings
		(:doc "Copy the surviving binding prefix in its original order.")
		(params (modules (shared-array GraphModule)) (bindings (shared-array GraphBinding)) (selected (mut-array GraphBinding)))
		(returns i32)
		(body
			(let-mut index 0i32)
			(let-mut count 0i32)
			(while
				(:doc "Every binding owned by a failed file has already lost its semantic context.")
				(i32:lt index bindings.len)
				(body
					(let row (bindings.get index))
					(if
						(:doc "Only names from surviving owners are visible to this plan.")
						(bool:not (call failed_file (borrow-shared modules) (row.get owner)))
						(then
							(selected.set count row)
							(set count (i32:inc count))))
					(set index (i32:inc index))))
			(return count)))

	(fn check_resolved_disk_graph
		(:doc "Report semantic failures and retry only while at least one new file can be excluded.")
		(:expect (tests "stage-2/cli/native/check.tsv") (issues "gh:wove-lang/wove:364"))
		(params (path (shared-array u8)) (canonical (shared-array u8)) (probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (resolved GraphResult) (arena (shared-array u8))
			(files (shared-array SuppliedFile)) (edges (shared-array DiskEdge)) (modules (mut-array GraphModule))
			(scratch (shared-array GraphBinding)) (human bool))
		(returns i32)
		(body
			(let prefix (resolved.get bindings))
			(let-mut originals (array:alloc GraphBinding prefix))
			(call copy_graph_bindings (borrow-shared scratch) (borrow-mut originals))
			(let empty (array:alloc u8 0i32))
			(let-mut status 0i32)
			(if
				(:doc "Resolve transitive dependencies before the first plan if import resolution already reported a failure.")
				(call failed_file (borrow-shared modules) 0i32)
				(then
					(set status 1i32)
					(call propagate_failed_inputs (borrow-mut modules) (borrow-shared edges)
						(borrow-shared originals))))
			(while
				(:doc "An entirely healthy graph still needs only one ordinary check plan.")
				(bool true)
				(body
					(let-mut selected (array:alloc GraphModule files.len))
					(let-mut filtered (array:alloc GraphBinding prefix))
					(let uses (call select_check_bindings (borrow-shared modules) (borrow-shared originals)
						(borrow-mut filtered)))
					(let-mut bindings (array:alloc GraphBinding uses))
					(call copy_graph_bindings (borrow-shared filtered) (borrow-mut bindings))
					(call select_check_modules (borrow-shared modules) (borrow-mut selected))
					(let checked (call emit_entry_graph (borrow-shared path) (borrow-shared canonical)
						(borrow-shared empty) (borrow-shared empty) (borrow-shared probe_options) (borrow-shared empty)
						protection target_index (bool true) 0i32 (borrow-shared arena)
						(borrow-shared files) (borrow-shared selected) (borrow-shared bindings)
						resolved human))
					(if
						(:doc "A successful residual plan preserves the status of every earlier failure.")
						(u32:eqz (checked.get error))
						(then
							(if (i32:eqz status) (then (return (checked.get status))))
							(return status)))
					(set status (call report_entry_emission (borrow-shared path) (borrow-shared arena)
						(borrow-shared files) checked human))
					(let failed (checked.get file))
					(if
						(:doc "Capacity or global host errors may have no removable defining file.")
						(bool:or (i32:ltz failed) (i32:not-lt failed files.len))
						(then (return status)))
					(if
						(:doc "A retry must remove at least one new file.")
						(bool:not (call fail_if_needed (borrow-mut modules) failed))
						(then (return status)))
					(call propagate_failed_inputs (borrow-mut modules) (borrow-shared edges)
						(borrow-shared originals))))))
)
