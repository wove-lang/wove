(module native_type_headers
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recognize complete records and native scalar typedefs in the selected header's Clang AST.")

	(use wove-file "./header_origin.wove" (only declaration_in_earlier_include))
	(use wove-file "../clang/fields.wove" (only clang_field clang_inner (value clang_kind_key) (value clang_name_key)))
	(use wove-file "../clang/index.wove" (only clang_matches_declaration (type ClangDeclaration) (type ClangIndex)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../source/c_owners.wove" (only c_type_word_end))
	(use wove-file "../source/scan.wove" (only skip_whitespace))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(let record_kind "\"RecordDecl\"")
	(let typedef_kind "TypedefDecl")
	(let struct_word "struct")
	(let union_word "union")
	(let struct_tag "\"struct\"")
	(let union_tag "\"union\"")
	(let tag_key "tagUsed")
	(let complete_key "completeDefinition")
	(let declaration_key "decl")
	(let id_key "id")
	(let previous_key "previousDecl")
	(let record_type "\"RecordType\"")
	(let elaborated_type "\"ElaboratedType\"")
	(let typedef_type "\"TypedefType\"")
	(let qualified_type "\"QualType\"")
	(let attributed_type "\"AttributedType\"")
	(let typeof_expression "\"TypeOfExprType\"")
	(let typeof_type "\"TypeOfType\"")
	(let builtin_type "\"BuiltinType\"")
	(let bit_int_type "\"BitIntType\"")
	(let enum_type "\"EnumType\"")
	(let void_type "\"void\"")
	(let type_key "type")
	(let qualified_key "qualType")

	(fn value_matches
		(:doc "Compare a known AST string value with its complete quoted representation.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(row i32) (spelling (shared-array u8))) (returns bool)
		(body
			(if (i32:ltz row) (then (return (bool false))))
			(let value (nodes.get row))
			(return (call same_bytes (borrow-shared ast)
				(i32:add base (struct:get value start))
				(i32:add base (struct:get value end))
				(borrow-shared spelling) 0i32 spelling.len))))

	(fn complete_record
		(:doc "A forward declaration has no completeDefinition truth value.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(node i32) (scratch (mut-array u8))) (returns bool)
		(body
			(let complete (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				node (borrow-shared complete_key) (borrow-mut scratch)))
			(return (bool:and (i32:not-ltz complete)
				(u32:eq (struct:get (nodes.get complete) kind) 5u32)))))

	(fn from_selected_header
		(:doc "Recognize declarations parsed after the header marker or from its already included subtree.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(node i32) (boundary i32) (trace (shared-array u8))) (returns bool)
		(body
			(return (bool:or (i32:lt boundary node)
				(call declaration_in_earlier_include (borrow-shared ast) base
					(borrow-shared nodes) node (borrow-shared trace))))))

	(fn typedef_value_node
		(:doc "Unwrap transparent Clang type nodes and return the first concrete value type.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(declaration i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let-mut node (call clang_inner (borrow-shared ast) base
				(borrow-shared nodes) declaration (borrow-mut scratch)))
			(while
				(:doc "Only wrappers that preserve the object type contribute another underlying node.")
				(i32:not-ltz node)
				(body
					(let kind (call clang_field (borrow-shared ast) base (borrow-shared nodes)
						node (borrow-shared clang_kind_key) (borrow-mut scratch)))
					(let expression (call value_matches (borrow-shared ast) base (borrow-shared nodes)
						kind (borrow-shared typeof_expression)))
					(let wrapper (bool:or
						(call value_matches (borrow-shared ast) base (borrow-shared nodes)
							kind (borrow-shared elaborated_type))
						(bool:or
							(call value_matches (borrow-shared ast) base (borrow-shared nodes)
								kind (borrow-shared typedef_type))
							(bool:or
								(call value_matches (borrow-shared ast) base (borrow-shared nodes)
									kind (borrow-shared qualified_type))
								(bool:or
									(call value_matches (borrow-shared ast) base (borrow-shared nodes)
										kind (borrow-shared attributed_type))
									(call value_matches (borrow-shared ast) base (borrow-shared nodes)
										kind (borrow-shared typeof_type)))))))
					(if
						(:doc "A concrete record, enumeration, builtin, pointer, or array ends the walk.")
						(bool:not (bool:or expression wrapper))
						(then (return node)))
					(set node (call clang_inner (borrow-shared ast) base
						(borrow-shared nodes) node (borrow-mut scratch)))
					(if
						(:doc "Clang emits the operand expression before the underlying type in typeof(expression).")
						(bool:and expression (i32:not-ltz node))
						(then (set node (struct:get (nodes.get node) next_sibling))))))
			(return -1i32)))

	(fn typedef_record_id
		(:doc "Return the declaration identity for a typedef with a record value type.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(declaration i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let node (call typedef_value_node (borrow-shared ast) base
				(borrow-shared nodes) declaration (borrow-mut scratch)))
			(let kind (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				node (borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if
				(:doc "A pointer or another non-record type has no record identity.")
				(bool:not (call value_matches (borrow-shared ast) base (borrow-shared nodes)
					kind (borrow-shared record_type)))
				(then (return -1i32)))
			(let tag (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				node (borrow-shared declaration_key) (borrow-mut scratch)))
			(return (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				tag (borrow-shared id_key) (borrow-mut scratch)))))

	(fn scalar_typedef_value
		(:doc "Recognize an arithmetic or enumeration value behind the selected typedef.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(declaration i32) (scratch (mut-array u8))) (returns bool)
		(body
			(let node (call typedef_value_node (borrow-shared ast) base
				(borrow-shared nodes) declaration (borrow-mut scratch)))
			(let kind (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				node (borrow-shared clang_kind_key) (borrow-mut scratch)))
			(if
				(:doc "Enumeration and bit-precise integer types carry scalar values.")
				(bool:or (call value_matches (borrow-shared ast) base (borrow-shared nodes) kind (borrow-shared enum_type))
					(call value_matches (borrow-shared ast) base (borrow-shared nodes) kind (borrow-shared bit_int_type)))
				(then (return (bool true))))
			(if
				(:doc "Records, pointers, and arrays have distinct native bridge contracts.")
				(bool:not (call value_matches (borrow-shared ast) base (borrow-shared nodes) kind (borrow-shared builtin_type)))
				(then (return (bool false))))
			(let type (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				node (borrow-shared type_key) (borrow-mut scratch)))
			(let spelling (call clang_field (borrow-shared ast) base (borrow-shared nodes)
				type (borrow-shared qualified_key) (borrow-mut scratch)))
			(return (bool:and (i32:not-ltz spelling)
				(bool:not (call value_matches (borrow-shared ast) base (borrow-shared nodes)
					spelling (borrow-shared void_type)))))))

	(fn lookup_native_scalar_typedef
		(:doc "Find the exact public scalar typedef in the selected header or its include subtree.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (spelling (shared-array u8))
			(trace (shared-array u8))) (returns bool)
		(body
			(let first (call skip_whitespace (borrow-shared spelling) 0i32))
			(let end (call c_type_word_end (borrow-shared spelling) first))
			(if
				(:doc "Only a single C identifier can name a public typedef.")
				(bool:or (i32:eq first end)
					(i32:not-eq (call skip_whitespace (borrow-shared spelling) end) spelling.len))
				(then (return (bool false))))
			(let name (borrow-shared (spelling.range first end)))
			(let base (struct:get index start))
			(let-mut scratch (array:alloc u8 qualified_key.len))
			(let-mut row (struct:get index entries))
			(while
				(:doc "Repeated declarations are usable only when a matching typedef belongs to the selected header.")
				(i32:gtz row)
				(body
					(set row (i32:dec row))
					(let entry (declarations.get row))
					(let node (struct:get entry node))
					(if
						(:doc "Reject a tag, function, unrelated include, or non-scalar typedef with the same name.")
						(bool:and (call clang_matches_declaration entry (borrow-shared names)
							(borrow-shared typedef_kind) (borrow-shared name))
							(bool:and (call from_selected_header (borrow-shared ast) base (borrow-shared nodes)
								node boundary (borrow-shared trace))
								(call scalar_typedef_value (borrow-shared ast) base
									(borrow-shared nodes) node (borrow-mut scratch))))
						(then (return (bool true))))))
			(return (bool false))))

	(fn next_scope_member
		(:doc "Find the next sibling, climbing out of exhausted record member lists.")
		(params (nodes (shared-array JsonNode)) (node i32)) (returns i32)
		(body
			(let-mut row node)
			(while
				(:doc "The immediate parent is Clang's inner array and its parent is the owning declaration.")
				(i32:gtz row)
				(body
					(let current (nodes.get row))
					(let sibling (struct:get current next_sibling))
					(if (i32:not-ltz sibling) (then (return sibling)))
					(let container (nodes.get (struct:get current parent)))
					(set row (struct:get container parent))))
			(return -1i32)))

	(fn file_scope_records
		(:doc "Collect record declarations in translation-unit order, including nested member tags.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(records (mut-array i32)) (scratch (mut-array u8))) (returns i32)
		(body
			(let-mut row (call clang_inner (borrow-shared ast) base
				(borrow-shared nodes) 0i32 (borrow-mut scratch)))
			(let-mut count 0i32)
			(while
				(:doc "Traverse the translation unit and record members. Function and block scopes cannot supply file-scope C tags.")
				(i32:not-ltz row)
				(body
					(let kind (call clang_field (borrow-shared ast) base (borrow-shared nodes)
						row (borrow-shared clang_kind_key) (borrow-mut scratch)))
					(let-mut next -1i32)
					(if
						(:doc "Only a C RecordDecl makes its member tag declarations part of this walk.")
						(call value_matches (borrow-shared ast) base (borrow-shared nodes)
							kind (borrow-shared record_kind))
						(then
							(records.set count row)
							(set count (i32:inc count))
							(set next (call clang_inner (borrow-shared ast) base
								(borrow-shared nodes) row (borrow-mut scratch)))))
					(if
						(:doc "Once the current record has no members left, continue in the enclosing declaration list.")
						(i32:ltz next)
						(then (set next (call next_scope_member (borrow-shared nodes) row))))
					(set row next)))
			(return count)))

	(fn same_identity
		(:doc "Compare two exact Clang declaration IDs. An absent field has no identity.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (left i32) (right i32))
		(returns bool)
		(body
			(if (i32:ltz right) (then (return (bool false))))
			(let value (nodes.get right))
			(let start (i32:add base (struct:get value start)))
			(let end (i32:add base (struct:get value end)))
			(return (call value_matches (borrow-shared ast) base
				(borrow-shared nodes) left (borrow-shared (ast.range start end))))))

	(fn header_definition
		(:doc "Require a complete record and verify that the selected header supplies it.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(node i32) (boundary i32) (trace (shared-array u8)) (scratch (mut-array u8))) (returns bool)
		(body
			(return (bool:and
				(call complete_record (borrow-shared ast) base (borrow-shared nodes)
					node (borrow-mut scratch))
				(call from_selected_header (borrow-shared ast) base (borrow-shared nodes)
					node boundary (borrow-shared trace))))))

	(fn earliest_record_id
		(:doc "Walk previousDecl links backward in one pass to obtain the record family's first identity.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(records (shared-array i32)) (identity i32) (scratch (mut-array u8))) (returns i32)
		(body
			(let-mut current identity)
			(let-mut row records.len)
			(while
				(:doc "Clang's previousDecl links refer to earlier declarations of the same tag.")
				(i32:gtz row)
				(body
					(set row (i32:dec row))
					(let node (records.get row))
					(let id (call clang_field (borrow-shared ast) base (borrow-shared nodes)
						node (borrow-shared id_key) (borrow-mut scratch)))
					(if
						(:doc "An exact link can make an earlier declaration the starting point.")
						(call same_identity (borrow-shared ast) base (borrow-shared nodes)
							id current)
						(then
							(let prev (call clang_field (borrow-shared ast) base (borrow-shared nodes)
								node (borrow-shared previous_key) (borrow-mut scratch)))
							(if (i32:ltz prev) (then (return current)))
							(set current prev)))))
			(return current)))

	(fn record_id_complete
		(:doc "Follow the record's redeclarations in order until a complete definition from the header is found.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (identity i32)
			(records (shared-array i32)) (boundary i32) (trace (shared-array u8))
			(scratch (mut-array u8))) (returns bool)
		(body
			(let-mut current (call earliest_record_id (borrow-shared ast) base
				(borrow-shared nodes) (borrow-shared records) identity (borrow-mut scratch)))
			(let-mut row 0i32)
			(while
				(:doc "Clang versions may link a typedef to the forward declaration or to the definition.")
				(i32:lt row records.len)
				(body
					(let node (records.get row))
					(let id (call clang_field (borrow-shared ast) base (borrow-shared nodes)
						node (borrow-shared id_key) (borrow-mut scratch)))
					(let prev (call clang_field (borrow-shared ast) base (borrow-shared nodes)
						node (borrow-shared previous_key) (borrow-mut scratch)))
					(if
						(:doc "Only the exact start of the chain or a declared successor identifies this record.")
						(bool:or
							(call same_identity (borrow-shared ast) base (borrow-shared nodes)
								id current)
							(call same_identity (borrow-shared ast) base (borrow-shared nodes)
								prev current))
						(then
							(if
								(:doc "A forward declaration cannot satisfy the record view.")
								(call header_definition (borrow-shared ast) base (borrow-shared nodes)
									node boundary (borrow-shared trace) (borrow-mut scratch))
								(then (return (bool true))))
							(set current id)))
					(set row (i32:inc row))))
			(return (bool false))))

	(fn typedef_complete
		(:doc "Require the exact selected typedef and a complete definition of its underlying record.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8))
			(records (shared-array i32)) (trace (shared-array u8)) (scratch (mut-array u8))) (returns bool)
		(body
			(let base (struct:get index start))
			(let-mut row (struct:get index entries))
			(while
				(:doc "A header may repeat a typedef. Keep checking exact names and declaration origins.")
				(i32:gtz row)
				(body
					(set row (i32:dec row))
					(let entry (declarations.get row))
					(let node (struct:get entry node))
					(if
						(:doc "The selected include subtree must supply the typedef itself.")
						(bool:and
							(call clang_matches_declaration entry (borrow-shared names)
								(borrow-shared typedef_kind) (borrow-shared name))
							(call from_selected_header (borrow-shared ast) base (borrow-shared nodes)
								node boundary (borrow-shared trace)))
						(then
							(let id (call typedef_record_id (borrow-shared ast) base
								(borrow-shared nodes) node (borrow-mut scratch)))
							(if
								(:doc "Only a typedef for a complete record can supply a Wove record view.")
								(bool:and (i32:not-ltz id)
									(call record_id_complete (borrow-shared ast) base (borrow-shared nodes)
										id (borrow-shared records) boundary
										(borrow-shared trace) (borrow-mut scratch)))
								(then (return (bool true))))))))
			(return (bool false))))

	(fn native_tag_matches
		(:doc "Match the file-scope record's exact C tag spelling and kind.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (node i32)
			(name (shared-array u8)) (tag (shared-array u8)) (scratch (mut-array u8))) (returns bool)
		(body
			(let at (call clang_field (borrow-shared ast) base
				(borrow-shared nodes) node (borrow-shared clang_name_key) (borrow-mut scratch)))
			(if (i32:ltz at) (then (return (bool false))))
			(let named (nodes.get at))
			(let start (i32:inc (i32:add base (struct:get named start))))
			(let end (i32:dec (i32:add base (struct:get named end))))
			(if
				(:doc "C tag identifiers are ASCII, so the JSON string contents preserve their bytes.")
				(bool:not (call same_bytes (borrow-shared ast) start end
					(borrow-shared name) 0i32 name.len))
				(then (return (bool false))))
			(let kind (call clang_field (borrow-shared ast) base
				(borrow-shared nodes) node (borrow-shared tag_key) (borrow-mut scratch)))
			(return (call value_matches (borrow-shared ast) base
				(borrow-shared nodes) kind (borrow-shared tag)))))

	(fn tagged_complete
		(:doc "Look for any complete record with the selected native tag and verified origin.")
		(params (ast (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (boundary i32)
			(name (shared-array u8)) (tag (shared-array u8)) (records (shared-array i32))
			(trace (shared-array u8)) (scratch (mut-array u8))) (returns bool)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Both nested and top-level declarations can define this file-scope tag.")
				(i32:lt row records.len)
				(body
					(let node (records.get row))
					(if
						(:doc "A forward declaration or an out-of-scope definition cannot establish availability.")
						(bool:and
							(call native_tag_matches (borrow-shared ast) base (borrow-shared nodes)
								node (borrow-shared name) (borrow-shared tag) (borrow-mut scratch))
							(call header_definition (borrow-shared ast) base (borrow-shared nodes)
								node boundary (borrow-shared trace) (borrow-mut scratch)))
						(then (return (bool true))))
					(set row (i32:inc row))))
			(return (bool false))))

	(fn lookup_native_record
		(:doc "Select a record by its native tag or complete record typedef.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (spelling (shared-array u8))
			(trace (shared-array u8))) (returns bool)
		(body
			(let base (struct:get index start))
			(let-mut scratch (array:alloc u8 complete_key.len))
			(let-mut record_nodes (array:alloc i32 (struct:get index nodes)))
			(let count (call file_scope_records (borrow-shared ast) base
				(borrow-shared nodes) (borrow-mut record_nodes) (borrow-mut scratch)))
			(let records (borrow-shared (record_nodes.range 0i32 count)))
			(let first (call skip_whitespace (borrow-shared spelling) 0i32))
			(let first_end (call c_type_word_end (borrow-shared spelling) first))
			(let second (call skip_whitespace (borrow-shared spelling) first_end))
			(if
				(:doc "A single C identifier names a typedef.")
				(i32:eq second spelling.len)
				(then (return (call typedef_complete (borrow-shared ast) (borrow-shared nodes)
					index boundary (borrow-shared declarations) (borrow-shared names)
					(borrow-shared (spelling.range first first_end))
					(borrow-shared records) (borrow-shared trace) (borrow-mut scratch)))))
			(let end (call c_type_word_end (borrow-shared spelling) second))
			(if
				(:doc "A tagged name ends after its second C word.")
				(i32:not-eq (call skip_whitespace (borrow-shared spelling) end) spelling.len)
				(then (return (bool false))))
			(let name (borrow-shared (spelling.range second end)))
			(if
				(:doc "Match struct declarations independently of the union namespace spelling.")
				(call same_bytes (borrow-shared spelling) first first_end
					(borrow-shared struct_word) 0i32 6i32)
				(then (return (call tagged_complete (borrow-shared ast) base
					(borrow-shared nodes) boundary (borrow-shared name) (borrow-shared struct_tag)
					(borrow-shared records) (borrow-shared trace) (borrow-mut scratch)))))
			(return (bool:and
				(call same_bytes (borrow-shared spelling) first first_end
					(borrow-shared union_word) 0i32 5i32)
				(call tagged_complete (borrow-shared ast) base
					(borrow-shared nodes) boundary (borrow-shared name) (borrow-shared union_tag)
					(borrow-shared records) (borrow-shared trace) (borrow-mut scratch)))))))
