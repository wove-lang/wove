(module native_c_availability
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check selected optional C functions and object-like macros before native graph emission.")

	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "./arguments.wove" (only write_plain_argument))
	(use wove-file "../c/headers.wove" (only c_header_form))
	(use wove-file "../c/probe.wove" (only render_frontend_header_source (value header_begin)))
	(use wove-file "../clang/query.wove" (only query_clang_frontend (type QuerySite)))
	(use wove-file "../clang/run.wove" (only run_clang_macros))
	(use wove-file "../clang/macros.wove" (only macro_header_presence object_macro_value))
	(use wove-file "../clang/index.wove" (only clang_declaration clang_matches_declaration (type ClangIndex) (type ClangDeclaration)))
	(use wove-file "./header_origin.wove" (only declaration_in_earlier_include))
	(use wove-file "../emit/headers.wove" (only include_capacity prepare_includes include_position write_includes (type CInclude)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct Availability (fields (error u32) (file i32) (start i32) (end i32)))
	(let function_kind "FunctionDecl")
	(let enum_kind "EnumDecl")
	(let quote_option "-iquote")

	(fn selected_site
		(:doc "Keep the original requested name when the use gives it a local alias.")
		(params (binding GraphBinding))
		(returns QuerySite)
		(body (return (struct.new QuerySite (file (struct.get (local binding) owner))
			(start (struct.get (local binding) requested_start)) (end (struct.get (local binding) requested_end))))))

	(fn same_header
		(:doc "Bindings referring to one selected header literal share a single observation.")
		(params (left GraphBinding) (right GraphBinding))
		(returns bool)
		(body (return (bool.and (i32.eq (struct.get (local left) header_file) (struct.get (local right) header_file))
			(bool.and (i32.eq (struct.get (local left) header_start) (struct.get (local right) header_start))
				(i32.eq (struct.get (local left) header_end) (struct.get (local right) header_end)))))))

	(fn matching_native_function
		(:doc "Accept a declaration emitted by this header or recovered from its earlier include subtree.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8))
			(trace (shared-array u8))) (returns bool)
		(body
			(let-mut row (struct.get (local index) entries))
			(while
				(:doc "Consider each exact redeclaration until one has the required origin.")
				(i32.gtz (local row))
				(body
					(set (local row) (i32.dec (local row)))
					(let entry (array.load (local declarations) (local row)))
					(if
						(:doc "An unrelated declaration with the same name cannot establish availability.")
						(bool.and (call clang_matches_declaration (local entry) (borrow-shared (local names))
							(borrow-shared (local function_kind)) (borrow-shared (local name)))
							(bool.or (i32.lt (local boundary) (struct.get (local entry) node))
								(call declaration_in_earlier_include (borrow-shared (local ast)) (struct.get (local index) start)
									(borrow-shared (local nodes)) (struct.get (local entry) node) (borrow-shared (local trace)))))
						(then (return (bool true))))))
			(return (bool false))))

	(fn native_function_available
		(:doc "Look up the exact original C symbol, including the spelling selected by c-name.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (binding GraphBinding) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8))
			(ast (shared-array u8)) (nodes (shared-array JsonNode)) (trace (shared-array u8)))
		(returns bool)
		(body
			(let file (array.load (local files) (struct.get (local binding) file)))
			(let base (struct.get (local file) source_start))
			(let start (i32.add (local base) (struct.get (local binding) native_start)))
			(let end (i32.add (local base) (struct.get (local binding) native_end)))
			(return (call matching_native_function (borrow-shared (local ast)) (borrow-shared (local nodes))
				(local index) (local boundary) (borrow-shared (local declarations)) (borrow-shared (local names))
				(borrow-shared (array.range (local arena) (local start) (local end))) (borrow-shared (local trace))))))

	(fn remember_header
		(:doc "Record each selected function's result before releasing the captured AST.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (present bool) (index ClangIndex) (boundary i32) (declarations (shared-array ClangDeclaration))
			(names (shared-array u8)) (ast (shared-array u8)) (nodes (shared-array JsonNode)) (trace (shared-array u8))
			(results (mut-array u8))) (returns void)
		(body
			(let header (array.load (local bindings) (local first)))
			(let-mut row (local first))
			(while
				(:doc "Walk in binding order and leave other headers for their first optional selection.")
				(i32.lt (local row) (array.len (local bindings)))
				(body
					(let candidate (array.load (local bindings) (local row)))
					(if
						(:doc "Ordinary bindings and other headers do not depend on this query.")
						(bool.and (struct.get (local candidate) optional)
							(bool.and (u32.eqz (struct.get (local candidate) namespace))
								(call same_header (local header) (local candidate))))
						(then
							(let-mut status 71u32)
							(if
								(:doc "Only a present header can supply an exact FunctionDecl.")
								(bool.and (local present) (call native_function_available (borrow-shared (local arena))
									(borrow-shared (local files)) (local candidate) (local index) (local boundary)
									(borrow-shared (local declarations)) (borrow-shared (local names)) (borrow-shared (local ast))
									(borrow-shared (local nodes)) (borrow-shared (local trace))))
								(then (set (local status) 1u32)))
							(array.store (local results) (local row) (u8.from-u32 (local status)))))
					(set (local row) (i32.inc (local row)))))))

	(fn lookup_header_ast
		(:doc "Grow bounded capture and reader storage when an otherwise usable header needs more room.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(directory (shared-array u8)) (prefix (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let site (call selected_site (array.load (local bindings) (local first))))
			(let-mut width 1048576i32)
			(while
				(:doc "Each iteration owns its own storage, and growth stops at sixteen mebibytes of stdout.")
				(i32.lt (local width) 33554432i32)
				(body
					(let-mut capture (array.alloc u8 (local width)))
					(let-mut trace (array.alloc u8 (local width)))
					(let-mut nodes (array.alloc JsonNode (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 3i32))))
					(let-mut decls (array.alloc ClangDeclaration (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 6i32))))
					(let-mut names (array.alloc u8 (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 1i32))))
					(let query (call query_clang_frontend (borrow-shared (local program)) (borrow-shared (local options))
						(borrow-shared (local directory)) (borrow-shared (local prefix)) (borrow-shared (local header)) (local site)
						(borrow-mut (local capture)) (borrow-mut (local nodes)) (borrow-mut (local decls)) (borrow-mut (local names)) (borrow-mut (local trace))))
					(let error (struct.get (local query) error))
					(if
						(:doc "A complete observation covers all the selected optional names for this header.")
						(u32.eqz (local error))
						(then
							(let index (struct.get (local query) index))
							(let marker (call clang_declaration (local index) (borrow-shared (local decls)) (borrow-shared (local names))
								(borrow-shared (local enum_kind)) (borrow-shared (local header_begin))))
							(let boundary (struct.get (local marker) node))
							(if
								(:doc "A complete native capture records where the selected header starts.")
								(i32.ltz (local boundary))
								(then (return 73u32)))
							(call remember_header (borrow-shared (local arena)) (borrow-shared (local files))
								(borrow-shared (local bindings)) (local first) (struct.get (local query) present)
								(local index) (local boundary) (borrow-shared (local decls)) (borrow-shared (local names))
								(borrow-shared (local capture)) (borrow-shared (local nodes)) (borrow-shared (local trace))
								(borrow-mut (local results)))
							(return 0u32)))
					(if
						(:doc "A tool failure is separate from a successful query reporting an unavailable declaration.")
						(u32.eq (local error) 4u32)
						(then (return 72u32)))
					(if
						(:doc "A successful child must produce a valid header AST and presence fact.")
						(u32.eq (local error) 6u32)
						(then (return 73u32)))
					(if
						(:doc "Only capture or AST storage exhaustion is recoverable by allocating more space.")
						(bool.not (bool.or (u32.eq (local error) 5u32) (u32.eq (local error) 7u32)))
						(then (return 75u32)))
					(set (local width) (i32.add (local width) (local width)))))
			(return 74u32)))

	(fn remember_macros
		(:doc "Resolve each optional macro by its C spelling against the final macro definitions.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (present bool) (capture (shared-array u8)) (results (mut-array u8)))
		(returns void)
		(body
			(let header (array.load (local bindings) (local first)))
			(let-mut row (local first))
			(while
				(:doc "Optional integer and expression macros from this header share one capture.")
				(i32.lt (local row) (array.len (local bindings)))
				(body
					(let candidate (array.load (local bindings) (local row)))
					(if
						(:doc "Keep function observations in their own capture.")
						(bool.and (struct.get (local candidate) optional)
							(bool.and (u32.eq (struct.get (local candidate) namespace) 2u32)
								(call same_header (local header) (local candidate))))
						(then
							(let file (array.load (local files) (struct.get (local candidate) file)))
							(let base (struct.get (local file) source_start))
							(let start (i32.add (local base) (struct.get (local candidate) native_start)))
							(let end (i32.add (local base) (struct.get (local candidate) native_end)))
							(let value (call object_macro_value (borrow-shared (local capture))
								(borrow-shared (array.range (local arena) (local start) (local end)))))
							(let-mut status 76u8)
							(if
								(:doc "Expression macro diagnostics also cover floating values.")
								(struct.get (local candidate) value_macro)
								(then (set (local status) 77u8)))
							(if
								(:doc "A matching definition is usable when the requested header exists.")
								(bool.and (local present) (i32.lt -1i32 (struct.get (local value) start)))
								(then (set (local status) 1u8)))
							(array.store (local results) (local row) (local status))))
					(set (local row) (i32.inc (local row)))))))

	(fn lookup_header_macros
		(:doc "Capture macro definitions using the same frontend settings as the native unit.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(directory (shared-array u8)) (prefix (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let source (call render_frontend_header_source (borrow-shared (local prefix)) (borrow-shared (local header))))
			(if
				(:doc "Source generation must succeed before launching the frontend.")
				(i32.eqz (array.len (local source)))
				(then (return 75u32)))
			(let-mut width 65536i32)
			(while
				(:doc "Retry exhausted capture storage up to the same output bound as an AST query.")
				(i32.lt (local width) 33554432i32)
				(body
					(let-mut capture (array.alloc u8 (local width)))
					(let-mut trace (array.alloc u8 (local width)))
					(let result (call run_clang_macros (borrow-shared (local program)) (borrow-shared (local options))
						(borrow-shared (local directory)) (borrow-shared (local source))
						(borrow-mut (local capture)) (borrow-mut (local trace))))
					(let error (struct.get (local result) error))
					(if
						(:doc "A complete capture supplies the presence marker and exact object-like names.")
						(u32.eqz (local error))
						(then
							(let length (struct.get (local result) length))
							(let present (call macro_header_presence (borrow-shared (array.range (local capture) 0i32 (local length)))))
							(if
								(:doc "Invalid capture output has its own import diagnostic.")
								(i32.ltz (local present))
								(then (return 73u32)))
							(call remember_macros (borrow-shared (local arena)) (borrow-shared (local files))
								(borrow-shared (local bindings)) (local first) (i32.eq (local present) 1i32)
								(borrow-shared (array.range (local capture) 0i32 (local length))) (borrow-mut (local results)))
							(return 0u32)))
					(if
						(:doc "A frontend failure differs from a successful capture of an absent macro.")
						(u32.eq (local error) 4u32)
						(then (return 72u32)))
					(if
						(:doc "Only exhaustion of capture storage can be retried with a larger buffer.")
						(u32.not-eq (local error) 5u32)
						(then (return 75u32)))
					(set (local width) (i32.add (local width) (local width)))))
			(return 74u32)))

	(fn lookup_header
		(:doc "Probe macros with the provider's declared prerequisites. Function queries use the emitted include order to recover declaration origins.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let selected (array.load (local bindings) (local first)))
			(let macro (u32.eq (struct.get (local selected) namespace) 2u32))
			(let-mut start 0i32)
			(let-mut limit (array.len (local bindings)))
			(if
				(:doc "The graph records the ordered, transitive dependency rows before publishing the selected name.")
				(local macro)
				(then
					(set (local start) (struct.get (local selected) prerequisite_start))
					(set (local limit) (struct.get (local selected) prerequisite_end))))
			(let capacity (call include_capacity (borrow-shared (local bindings)) (local start) (local limit)))
			(if
				(:doc "The include plan must fit in the driver's slices.")
				(i32.ltz (struct.get (local capacity) bytes))
				(then (return 75u32)))
			(let-mut paths (array.alloc u8 (struct.get (local capacity) bytes)))
			(let-mut headers (array.alloc CInclude (struct.get (local capacity) rows)))
			(let plan (call prepare_includes (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (local start) (local limit)
				(borrow-mut (local paths)) (borrow-mut (local headers))))
			(if
				(:doc "An invalid include plan cannot be passed to the frontend.")
				(u32.gtz (struct.get (local plan) error))
				(then (return 75u32)))
			(let-mut before (struct.get (local plan) count))
			(if
				(:doc "A function's AST marker follows the includes preceding its header in the native unit.")
				(bool.not (local macro))
				(then
					(set (local before) (call include_position (borrow-shared (local paths)) (borrow-shared (local headers))
						(local before) (borrow-shared (local header))))
					(if (i32.ltz (local before)) (then (return 75u32)))))
			(let-mut empty (array.alloc u8 0i32))
			(let width (call write_includes (borrow-shared (local paths)) (borrow-shared (local headers))
				(local before) (borrow-mut (local empty)) (bool false)))
			(if
				(:doc "Bound the complete prefix before allocating output storage.")
				(u32.lt 2147483647u32 (local width))
				(then (return 75u32)))
			(let-mut prefix (array.alloc u8 (i32.from-u32 (local width))))
			(let end (call write_includes (borrow-shared (local paths)) (borrow-shared (local headers))
				(local before) (borrow-mut (local prefix)) (bool true)))
			(if
				(:doc "Read object-like definitions after the selected header and its prerequisites have been processed.")
				(local macro)
				(then (return (call lookup_header_macros (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
					(borrow-shared (local options)) (borrow-shared (local header)) (borrow-shared (local directory))
					(borrow-shared (array.range (local prefix) 0i32 (i32.from-u32 (local end)))) (borrow-mut (local results))))))
			(return (call lookup_header_ast (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
				(borrow-shared (local options)) (borrow-shared (local header)) (borrow-shared (local directory))
				(borrow-shared (array.range (local prefix) 0i32 (i32.from-u32 (local end)))) (borrow-mut (local results))))))

	(fn probe_include_path
		(:doc "Use the defining Wove file's directory for project headers in retained-only builds.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(canonical (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(first i32) (program (shared-array u8)) (directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(if
				(:doc "System headers use the selected tool's options; bin uses the native build's include search.")
				(bool.or (i32.gtz (array.len (local directory))) (u8.eq (array.load (local header) 0i32) 60u8))
				(then (return (call lookup_header (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
					(borrow-shared (local options)) (borrow-shared (local header))
					(borrow-shared (local directory)) (borrow-mut (local results))))))
			(let binding (array.load (local bindings) (local first)))
			(if
				(:doc "The entry path may be virtual in the bundled graph; use its canonical input path.")
				(i32.eqz (struct.get (local binding) header_file))
				(then (return (call lookup_quoted_header (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
					(borrow-shared (local options)) (borrow-shared (local header)) (borrow-shared (local canonical))
					(borrow-mut (local results))))))
			(let provider (array.load (local files) (struct.get (local binding) header_file)))
			(return (call lookup_quoted_header (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
				(borrow-shared (local options)) (borrow-shared (local header))
				(borrow-shared (array.range (local arena) (struct.get (local provider) path_start) (struct.get (local provider) path_end)))
				(borrow-mut (local results))))))

	(fn lookup_quoted_header
		(:doc "Lend an additional quote-only search directory for the retained source's project include.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(defining_path (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let size (array.len (local options)))
			(if
				(:doc "The added search option cannot follow an unterminated caller argument.")
				(bool.and (i32.gtz (local size))
					(u8.not-eqz (array.load (local options) (i32.dec (local size)))))
				(then (return 75u32)))
			(let directory (call directory_width (borrow-shared (local defining_path))))
			(let width (u64.add (u64.from-i32 (array.len (local options)))
				(u64.add (u64.from-i32 (local directory)) 9u64)))
			(if
				(:doc "The complete packed list must fit the native slice ABI.")
				(u64.lt 2147483647u64 (local width))
				(then (return 75u32)))
			(let-mut packed (array.alloc u8 (i32.from-u64 (local width))))
			(let start (call append_bytes (borrow-shared (local options)) (borrow-mut (local packed)) 0i32))
			(let path (call write_plain_argument (borrow-shared (local quote_option)) (borrow-mut (local packed)) (local start)))
			(let end (call write_plain_argument (borrow-shared (array.range (local defining_path) 0i32 (local directory)))
				(borrow-mut (local packed)) (local path)))
			(if
				(:doc "Reject a malformed native directory before passing its bytes to Clang.")
				(i32.ltz (local end))
				(then (return 75u32)))
			(let empty (array.alloc u8 0i32))
			(return (call lookup_header (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
				(borrow-shared (array.range (local packed) 0i32 (local end))) (borrow-shared (local header))
				(borrow-shared (local empty)) (borrow-mut (local results))))))

	(fn probe_decoded_header
		(:doc "Apply the same delimiter convention as C emission for a bare project path.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (canonical (shared-array u8)) (options (shared-array u8))
			(header (shared-array u8)) (directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let form (call c_header_form (borrow-shared (local header))))
			(if
				(:doc "A probe accepts the same validated header path forms as emitted includes.")
				(u32.eqz (local form))
				(then (return 75u32)))
			(if
				(:doc "Already-delimited spellings preserve the provided include mode.")
				(u32.eq (local form) 2u32)
				(then (return (call probe_include_path (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local bindings)) (borrow-shared (local canonical))
					(borrow-shared (local options)) (borrow-shared (local header)) (local first)
					(borrow-shared (local program)) (borrow-shared (local directory)) (borrow-mut (local results))))))
			(let length (array.len (local header)))
			(if
				(:doc "Reserve space for both project quotes.")
				(i32.lt 2147483645i32 (local length))
				(then (return 75u32)))
			(let-mut quoted (array.alloc u8 (i32.add (local length) 2i32)))
			(array.store (local quoted) 0i32 34u8)
			(let end (call append_bytes (borrow-shared (local header)) (borrow-mut (local quoted)) 1i32))
			(array.store (local quoted) (local end) 34u8)
			(return (call probe_include_path (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local canonical))
				(borrow-shared (local options)) (borrow-shared (local quoted)) (local first)
				(borrow-shared (local program)) (borrow-shared (local directory)) (borrow-mut (local results))))))

	(fn probe_binding
		(:doc "Decode the header from the selected bridge's own source file.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (canonical (shared-array u8)) (options (shared-array u8))
			(directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let binding (array.load (local bindings) (local first)))
			(let file (array.load (local files) (struct.get (local binding) header_file)))
			(let base (struct.get (local file) source_start))
			(let start (i32.add (local base) (struct.get (local binding) header_start)))
			(let end (i32.add (local base) (struct.get (local binding) header_end)))
			(let-mut spelling (array.alloc u8 (i32.sub (local end) (local start))))
			(let decoded (call decode_string (borrow-shared (local arena))
				(struct.new Token (kind 2u32) (start (local start)) (end (local end)) (error 0u32))
				(borrow-mut (local spelling))))
			(if
				(:doc "Reject a malformed source key before assembling a tool invocation.")
				(u32.gtz (struct.get (local decoded) error))
				(then (return 75u32)))
			(return (call probe_decoded_header (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (local first) (borrow-shared (local program))
				(borrow-shared (local canonical)) (borrow-shared (local options))
				(borrow-shared (array.range (local spelling) 0i32 (struct.get (local decoded) written))) (borrow-shared (local directory))
				(borrow-mut (local results))))))

	(fn cached_status
		(:doc "Read the selected binding's cached availability through a shared loan.")
		(params (results (shared-array u8)) (row i32)) (returns u32)
		(body (return (u32.from-u8 (array.load (local results) (local row))))))

	(fn verify_bindings
		(:doc "Probe each selected header lazily and report the first failed optional selection in original order.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (canonical (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8)))
		(returns Availability)
		(body
			(let program (call clang_program))
			(let-mut results (array.alloc u8 (array.len (local bindings))))
			(let-mut row (local first))
			(while
				(:doc "A zero result has yet to be checked; one means the member was available.")
				(i32.lt (local row) (array.len (local bindings)))
				(body
					(let binding (array.load (local bindings) (local row)))
					(if
						(:doc "Only a selected member with c_optional triggers a query.")
						(struct.get (local binding) optional)
						(then
							(let-mut status (call cached_status (borrow-shared (local results)) (local row)))
							(if
								(:doc "Query at most once per header and probe kind after a successful capture.")
								(u32.eqz (local status))
								(then
									(set (local status) (call probe_binding (borrow-shared (local arena)) (borrow-shared (local files))
										(borrow-shared (local bindings)) (local row) (borrow-shared (local program))
										(borrow-shared (local canonical)) (borrow-shared (local options)) (borrow-shared (local directory))
										(borrow-mut (local results))))
									(if
										(:doc "Use the memoized exact lookup after a successful probe.")
										(u32.eqz (local status))
										(then (set (local status) (call cached_status (borrow-shared (local results)) (local row)))))))
							(if
								(:doc "An absent name and a failed probe both report the requesting source file.")
								(u32.lt 1u32 (local status))
								(then
									(let site (call selected_site (local binding)))
									(return (struct.new Availability (error (local status))
										(file (struct.get (local site) file)) (start (struct.get (local site) start))
										(end (struct.get (local site) end))))))))
					(set (local row) (i32.inc (local row)))))
			(return (struct.new Availability (error 0u32) (file -1i32) (start 0i32) (end 0i32)))))

	(fn check_optional_c_members
		(:doc "Leave graphs without selected optional members on their filesystem-only path.")
		(:expect (tests "stage-2/cli/native/cases.tsv" "stage-2/cli/native/bin.tsv" "stage-2/cli/native/optional-macros.tsv")
			(issues "gh:wove-lang/wove:212" "gh:wove-lang/wove:539" "gh:wove-lang/wove:577"))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(canonical (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8)))
		(returns Availability)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Select the tool and allocate probe storage only if a binding needs availability.")
				(i32.lt (local row) (array.len (local bindings)))
				(body
					(if
						(:doc "Once one optional selection is found, verify the rest of the published prefix in order.")
						(struct.get (array.load (local bindings) (local row)) optional)
						(then (return (call verify_bindings (borrow-shared (local arena)) (borrow-shared (local files))
							(borrow-shared (local bindings)) (local row) (borrow-shared (local canonical))
							(borrow-shared (local options)) (borrow-shared (local directory))))))
					(set (local row) (i32.inc (local row)))))
			(return (struct.new Availability (error 0u32) (file -1i32) (start 0i32) (end 0i32))))))
