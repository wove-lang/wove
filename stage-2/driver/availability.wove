(module native_c_availability
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Check selected C declarations that need a header probe before native graph emission.")

	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "./arguments.wove" (only write_plain_argument))
	(use wove-file "../c/headers.wove" (only c_header_form))
	(use wove-file "../c/probe.wove" (only render_frontend_header_source (value header_begin)))
	(use wove-file "../clang/query.wove" (only query_clang_frontend (type QuerySite)))
	(use wove-file "../clang/run.wove" (only run_clang_macros))
	(use wove-file "../clang/macros.wove" (only macro_header_presence object_macro_value))
	(use wove-file "../clang/index.wove" (only clang_declaration clang_matches_declaration (type ClangIndex) (type ClangDeclaration)))
	(use wove-file "./header_origin.wove" (only declaration_in_earlier_include))
	(use wove-file "./type_headers.wove" (only lookup_native_record lookup_native_scalar_typedef))
	(use wove-file "../emit/headers.wove" (only include_capacity prepare_includes include_position write_includes (type CInclude)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct Availability (fields (error u32) (file i32) (start i32) (end i32)))
	(let function_kind "FunctionDecl")
	(let optional_record_unavailable 91u32)
	(let optional_typedef_unavailable 92u32)
	(let lossless_macro_unavailable 93u32)
	(let enum_kind "EnumDecl")
	(let quote_option "-iquote")

	(fn selected_site
		(:doc "Keep the original requested name when the use gives it a local alias.")
		(params (binding GraphBinding))
		(returns QuerySite)
		(body (return (struct.new QuerySite (file (struct.get binding owner))
			(start (struct.get binding requested_start)) (end (struct.get binding requested_end))))))

	(fn same_header
		(:doc "Bindings referring to one selected header literal share a single observation.")
		(params (left GraphBinding) (right GraphBinding))
		(returns bool)
		(body (return (bool.and (i32.eq (struct.get left header_file) (struct.get right header_file))
			(bool.and (i32.eq (struct.get left header_start) (struct.get right header_start))
				(i32.eq (struct.get left header_end) (struct.get right header_end)))))))

	(fn matching_native_function
		(:doc "Accept a declaration emitted by this header or recovered from its earlier include subtree.")
		(params (ast (shared-array u8)) (nodes (shared-array JsonNode)) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (name (shared-array u8))
			(trace (shared-array u8))) (returns bool)
		(body
			(let-mut row (struct.get index entries))
			(while
				(:doc "Consider each exact redeclaration until one has the required origin.")
				(i32.gtz row)
				(body
					(set row (i32.dec row))
					(let entry (array.load declarations row))
					(if
						(:doc "An unrelated declaration with the same name cannot establish availability.")
						(bool.and (call clang_matches_declaration entry (borrow-shared names)
							(borrow-shared function_kind) (borrow-shared name))
							(bool.or (i32.lt boundary (struct.get entry node))
								(call declaration_in_earlier_include (borrow-shared ast) (struct.get index start)
									(borrow-shared nodes) (struct.get entry node) (borrow-shared trace))))
						(then (return (bool true))))))
			(return (bool false))))

	(fn native_declaration_available
		(:doc "Look up the exact C function, complete native record, or native scalar typedef.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (binding GraphBinding) (index ClangIndex) (boundary i32)
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8))
			(ast (shared-array u8)) (nodes (shared-array JsonNode)) (trace (shared-array u8)))
		(returns bool)
		(body
			(let file (array.load files (struct.get binding file)))
			(let base (struct.get file source_start))
			(let start (i32.add base (struct.get binding native_start)))
			(let end (i32.add base (struct.get binding native_end)))
			(if
				(:doc "Decode the native type operand from its defining bridge before inspecting the header.")
				(u32.eq (struct.get binding namespace) 1u32)
				(then
					(let-mut spelling (array.alloc u8 (i32.sub end start)))
					(let type (call decode_string (borrow-shared arena)
						(struct.new Token (kind 2u32) (start start) (end end) (error 0u32))
						(borrow-mut spelling)))
					(if (u32.not-eqz (struct.get type error)) (then (return (bool false))))
					(let native (borrow-shared (array.range spelling 0i32 (struct.get type written))))
					(if
						(:doc "An ordinary scalar alias needs its exact typedef from the same ordered header query.")
						(struct.get binding scalar_typedef)
						(then (return (call lookup_native_scalar_typedef (borrow-shared ast) (borrow-shared nodes)
							index boundary (borrow-shared declarations) (borrow-shared names)
							(borrow-shared native) (borrow-shared trace)))))
					(return (call lookup_native_record (borrow-shared ast) (borrow-shared nodes)
						index boundary (borrow-shared declarations) (borrow-shared names)
						(borrow-shared native) (borrow-shared trace)))))
			(return (call matching_native_function (borrow-shared ast) (borrow-shared nodes)
				index boundary (borrow-shared declarations) (borrow-shared names)
				(borrow-shared (array.range arena start end)) (borrow-shared trace)))))

	(fn remember_header
		(:doc "Record each selected declaration's result before releasing the captured AST.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (present bool) (index ClangIndex) (boundary i32) (declarations (shared-array ClangDeclaration))
			(names (shared-array u8)) (ast (shared-array u8)) (nodes (shared-array JsonNode)) (trace (shared-array u8))
			(results (mut-array u8))) (returns void)
		(body
			(let header (array.load bindings first))
			(let-mut row first)
			(while
				(:doc "Walk in binding order and leave other headers for their first optional selection.")
				(i32.lt row (array.len bindings))
				(body
					(let candidate (array.load bindings row))
					(if
						(:doc "Ordinary bindings and other headers do not depend on this query.")
						(bool.and (struct.get candidate optional)
							(bool.and (u32.eq (struct.get candidate namespace) (struct.get header namespace))
								(call same_header header candidate)))
						(then
							(let-mut status 71u32)
							(if
								(:doc "Native record and scalar selections have distinct unavailable diagnostics.")
								(u32.eq (struct.get candidate namespace) 1u32)
								(then
									(set status optional_record_unavailable)
									(if (struct.get candidate scalar_typedef) (then (set status optional_typedef_unavailable)))))
							(if
								(:doc "Only a present header can supply a usable declaration.")
								(bool.and present (call native_declaration_available (borrow-shared arena)
									(borrow-shared files) candidate index boundary
									(borrow-shared declarations) (borrow-shared names) (borrow-shared ast)
									(borrow-shared nodes) (borrow-shared trace)))
								(then (set status 1u32)))
							(array.store results row (u8.from-u32 status))))
					(set row (i32.inc row))))))

	(fn lookup_header_ast
		(:doc "Grow bounded capture and reader storage when an otherwise usable header needs more room.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(directory (shared-array u8)) (prefix (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let site (call selected_site (array.load bindings first)))
			(let-mut width 1048576i32)
			(while
				(:doc "Each iteration owns its own storage, and growth stops at sixteen mebibytes of stdout.")
				(i32.lt width 33554432i32)
				(body
					(let-mut capture (array.alloc u8 width))
					(let-mut trace (array.alloc u8 width))
					(let-mut nodes (array.alloc JsonNode (i32.from-u32 (u32.shr (u32.from-i32 width) 3i32))))
					(let-mut decls (array.alloc ClangDeclaration (i32.from-u32 (u32.shr (u32.from-i32 width) 6i32))))
					(let-mut names (array.alloc u8 (i32.from-u32 (u32.shr (u32.from-i32 width) 1i32))))
					(let query (call query_clang_frontend (borrow-shared program) (borrow-shared options)
						(borrow-shared directory) (borrow-shared prefix) (borrow-shared header) site
						(borrow-mut capture) (borrow-mut nodes) (borrow-mut decls) (borrow-mut names) (borrow-mut trace)))
					(let error (struct.get query error))
					(if
						(:doc "A complete observation covers all the selected optional names for this header.")
						(u32.eqz error)
						(then
							(let index (struct.get query index))
							(let marker (call clang_declaration index (borrow-shared decls) (borrow-shared names)
								(borrow-shared enum_kind) (borrow-shared header_begin)))
							(let boundary (struct.get marker node))
							(if
								(:doc "A complete native capture records where the selected header starts.")
								(i32.ltz boundary)
								(then (return 73u32)))
							(call remember_header (borrow-shared arena) (borrow-shared files)
								(borrow-shared bindings) first (struct.get query present)
								index boundary (borrow-shared decls) (borrow-shared names)
								(borrow-shared capture) (borrow-shared nodes) (borrow-shared trace)
								(borrow-mut results))
							(return 0u32)))
					(if
						(:doc "A tool failure is separate from a successful query reporting an unavailable declaration.")
						(u32.eq error 4u32)
						(then (return 72u32)))
					(if
						(:doc "A successful child must produce a valid header AST and presence fact.")
						(u32.eq error 6u32)
						(then (return 73u32)))
					(if
						(:doc "Only capture or AST storage exhaustion is recoverable by allocating more space.")
						(bool.not (bool.or (u32.eq error 5u32) (u32.eq error 7u32)))
						(then (return 75u32)))
					(set width (i32.add width width))))
			(return 74u32)))

	(fn needs_availability
		(:doc "Query optional members and require an object-like definition for lossless macros.")
		(params (binding GraphBinding))
		(returns bool)
		(body (return (bool.or (struct.get binding optional) (struct.get binding value_lossless)))))

	(fn remember_macros
		(:doc "Resolve each selected macro that needs availability checking by its C spelling against the final macro definitions.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (present bool) (capture (shared-array u8)) (results (mut-array u8)))
		(returns void)
		(body
			(let header (array.load bindings first))
			(let-mut row first)
			(while
				(:doc "Integer, expression, and string macros from this header share one capture.")
				(i32.lt row (array.len bindings))
				(body
					(let candidate (array.load bindings row))
					(if
						(:doc "Keep function observations in their own capture.")
						(bool.and (call needs_availability candidate)
							(bool.and (u32.eq (struct.get candidate namespace) 2u32)
								(call same_header header candidate)))
						(then
							(let file (array.load files (struct.get candidate file)))
							(let base (struct.get file source_start))
							(let start (i32.add base (struct.get candidate native_start)))
							(let end (i32.add base (struct.get candidate native_end)))
							(let value (call object_macro_value (borrow-shared capture)
								(borrow-shared (array.range arena start end))))
							(let-mut status 76u8)
							(if
								(:doc "The expression macro diagnostic covers scalar expressions and string literals.")
								(struct.get candidate value_macro)
								(then (set status 77u8)))
							(if
								(:doc "A required lossless macro has a distinct diagnostic if the header does not provide it.")
								(bool.and (struct.get candidate value_lossless) (bool.not (struct.get candidate optional)))
								(then (set status (u8.from-u32 lossless_macro_unavailable))))
							(if
								(:doc "A matching definition is usable when the requested header exists.")
								(bool.and present (i32.lt -1i32 (struct.get value start)))
								(then (set status 1u8)))
							(array.store results row status)))
					(set row (i32.inc row))))))

	(fn lookup_header_macros
		(:doc "Capture macro definitions using the same frontend settings as the native unit.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(directory (shared-array u8)) (prefix (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let source (call render_frontend_header_source (borrow-shared prefix) (borrow-shared header)))
			(if
				(:doc "Source generation must succeed before launching the frontend.")
				(i32.eqz (array.len source))
				(then (return 75u32)))
			(let-mut width 65536i32)
			(while
				(:doc "Retry exhausted capture storage up to the same output bound as an AST query.")
				(i32.lt width 33554432i32)
				(body
					(let-mut capture (array.alloc u8 width))
					(let-mut trace (array.alloc u8 width))
					(let result (call run_clang_macros (borrow-shared program) (borrow-shared options)
						(borrow-shared directory) (borrow-shared source)
						(borrow-mut capture) (borrow-mut trace)))
					(let error (struct.get result error))
					(if
						(:doc "A complete capture supplies the presence marker and exact object-like names.")
						(u32.eqz error)
						(then
							(let length (struct.get result length))
							(let present (call macro_header_presence (borrow-shared (array.range capture 0i32 length))))
							(if
								(:doc "Invalid capture output has its own import diagnostic.")
								(i32.ltz present)
								(then (return 73u32)))
							(call remember_macros (borrow-shared arena) (borrow-shared files)
								(borrow-shared bindings) first (i32.eq present 1i32)
								(borrow-shared (array.range capture 0i32 length)) (borrow-mut results))
							(return 0u32)))
					(if
						(:doc "A frontend failure differs from a successful capture of an absent macro.")
						(u32.eq error 4u32)
						(then (return 72u32)))
					(if
						(:doc "Only exhaustion of capture storage can be retried with a larger buffer.")
						(u32.not-eq error 5u32)
						(then (return 75u32)))
					(set width (i32.add width width))))
			(return 74u32)))

	(fn lookup_header
		(:doc "Probe macros and records with declared prerequisites. Function queries use the emitted include order.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let selected (array.load bindings first))
			(let macro (u32.eq (struct.get selected namespace) 2u32))
			(let function (u32.eqz (struct.get selected namespace)))
			(let-mut start 0i32)
			(let-mut limit (array.len bindings))
			(if
				(:doc "The graph records the ordered, transitive dependency rows before publishing the selected name.")
				(bool.not function)
				(then
					(set start (struct.get selected prerequisite_start))
					(set limit (struct.get selected prerequisite_end))))
			(let capacity (call include_capacity (borrow-shared bindings) start limit))
			(if
				(:doc "The include plan must fit in the driver's slices.")
				(i32.ltz (struct.get capacity bytes))
				(then (return 75u32)))
			(let-mut paths (array.alloc u8 (struct.get capacity bytes)))
			(let-mut headers (array.alloc CInclude (struct.get capacity rows)))
			(let plan (call prepare_includes (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) start limit
				(borrow-mut paths) (borrow-mut headers)))
			(if
				(:doc "An invalid include plan cannot be passed to the frontend.")
				(u32.gtz (struct.get plan error))
				(then (return 75u32)))
			(let-mut before (struct.get plan count))
			(if
				(:doc "A function's AST marker follows the includes preceding its header in the native unit.")
				function
				(then
					(set before (call include_position (borrow-shared paths) (borrow-shared headers)
						before (borrow-shared header)))
					(if (i32.ltz before) (then (return 75u32)))))
			(let-mut empty (array.alloc u8 0i32))
			(let width (call write_includes (borrow-shared paths) (borrow-shared headers)
				before (borrow-mut empty) (bool false)))
			(if
				(:doc "Bound the complete prefix before allocating output storage.")
				(u32.lt 2147483647u32 width)
				(then (return 75u32)))
			(let-mut prefix (array.alloc u8 (i32.from-u32 width)))
			(let end (call write_includes (borrow-shared paths) (borrow-shared headers)
				before (borrow-mut prefix) (bool true)))
			(if
				(:doc "Read object-like definitions after the selected header and its prerequisites have been processed.")
				macro
				(then (return (call lookup_header_macros (borrow-shared arena) (borrow-shared files)
					(borrow-shared bindings) first (borrow-shared program)
					(borrow-shared options) (borrow-shared header) (borrow-shared directory)
					(borrow-shared (array.range prefix 0i32 (i32.from-u32 end))) (borrow-mut results)))))
			(return (call lookup_header_ast (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) first (borrow-shared program)
				(borrow-shared options) (borrow-shared header) (borrow-shared directory)
				(borrow-shared (array.range prefix 0i32 (i32.from-u32 end))) (borrow-mut results)))))

	(fn probe_include_path
		(:doc "Use the defining Wove file's directory for project headers in retained-only builds.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(canonical (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(first i32) (program (shared-array u8)) (directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(if
				(:doc "System headers use the selected tool's options; bin uses the native build's include search.")
				(bool.or (i32.gtz (array.len directory)) (u8.eq (array.load header 0i32) 60u8))
				(then (return (call lookup_header (borrow-shared arena) (borrow-shared files)
					(borrow-shared bindings) first (borrow-shared program)
					(borrow-shared options) (borrow-shared header)
					(borrow-shared directory) (borrow-mut results)))))
			(let binding (array.load bindings first))
			(if
				(:doc "The entry path may be virtual in the bundled graph; use its canonical input path.")
				(i32.eqz (struct.get binding header_file))
				(then (return (call lookup_quoted_header (borrow-shared arena) (borrow-shared files)
					(borrow-shared bindings) first (borrow-shared program)
					(borrow-shared options) (borrow-shared header) (borrow-shared canonical)
					(borrow-mut results)))))
			(let provider (array.load files (struct.get binding header_file)))
			(return (call lookup_quoted_header (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) first (borrow-shared program)
				(borrow-shared options) (borrow-shared header)
				(borrow-shared (array.range arena (struct.get provider path_start) (struct.get provider path_end)))
				(borrow-mut results)))))

	(fn lookup_quoted_header
		(:doc "Lend an additional quote-only search directory for the retained source's project include.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (options (shared-array u8)) (header (shared-array u8))
			(defining_path (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let size (array.len options))
			(if
				(:doc "The added search option cannot follow an unterminated caller argument.")
				(bool.and (i32.gtz size)
					(u8.not-eqz (array.load options (i32.dec size))))
				(then (return 75u32)))
			(let directory (call directory_width (borrow-shared defining_path)))
			(let width (u64.add (u64.from-i32 (array.len options))
				(u64.add (u64.from-i32 directory) 9u64)))
			(if
				(:doc "The complete packed list must fit the native slice ABI.")
				(u64.lt 2147483647u64 width)
				(then (return 75u32)))
			(let-mut packed (array.alloc u8 (i32.from-u64 width)))
			(let start (call append_bytes (borrow-shared options) (borrow-mut packed) 0i32))
			(let path (call write_plain_argument (borrow-shared quote_option) (borrow-mut packed) start))
			(let end (call write_plain_argument (borrow-shared (array.range defining_path 0i32 directory))
				(borrow-mut packed) path))
			(if
				(:doc "Reject a malformed native directory before passing its bytes to Clang.")
				(i32.ltz end)
				(then (return 75u32)))
			(let empty (array.alloc u8 0i32))
			(return (call lookup_header (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) first (borrow-shared program)
				(borrow-shared (array.range packed 0i32 end)) (borrow-shared header)
				(borrow-shared empty) (borrow-mut results)))))

	(fn probe_decoded_header
		(:doc "Apply the same delimiter convention as C emission for a bare project path.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (canonical (shared-array u8)) (options (shared-array u8))
			(header (shared-array u8)) (directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let form (call c_header_form (borrow-shared header)))
			(if
				(:doc "A probe accepts the same validated header path forms as emitted includes.")
				(u32.eqz form)
				(then (return 75u32)))
			(if
				(:doc "Already-delimited spellings preserve the provided include mode.")
				(u32.eq form 2u32)
				(then (return (call probe_include_path (borrow-shared arena) (borrow-shared files)
					(borrow-shared bindings) (borrow-shared canonical)
					(borrow-shared options) (borrow-shared header) first
					(borrow-shared program) (borrow-shared directory) (borrow-mut results)))))
			(let length (array.len header))
			(if
				(:doc "Reserve space for both project quotes.")
				(i32.lt 2147483645i32 length)
				(then (return 75u32)))
			(let-mut quoted (array.alloc u8 (i32.add length 2i32)))
			(array.store quoted 0i32 34u8)
			(let end (call append_bytes (borrow-shared header) (borrow-mut quoted) 1i32))
			(array.store quoted end 34u8)
			(return (call probe_include_path (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared canonical)
				(borrow-shared options) (borrow-shared quoted) first
				(borrow-shared program) (borrow-shared directory) (borrow-mut results)))))

	(fn probe_binding
		(:doc "Decode the header from the selected bridge's own source file.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (program (shared-array u8)) (canonical (shared-array u8)) (options (shared-array u8))
			(directory (shared-array u8)) (results (mut-array u8)))
		(returns u32)
		(body
			(let binding (array.load bindings first))
			(let file (array.load files (struct.get binding header_file)))
			(let base (struct.get file source_start))
			(let start (i32.add base (struct.get binding header_start)))
			(let end (i32.add base (struct.get binding header_end)))
			(let-mut spelling (array.alloc u8 (i32.sub end start)))
			(let decoded (call decode_string (borrow-shared arena)
				(struct.new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut spelling)))
			(if
				(:doc "Reject a malformed source key before assembling a tool invocation.")
				(u32.gtz (struct.get decoded error))
				(then (return 75u32)))
			(return (call probe_decoded_header (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) first (borrow-shared program)
				(borrow-shared canonical) (borrow-shared options)
				(borrow-shared (array.range spelling 0i32 (struct.get decoded written))) (borrow-shared directory)
				(borrow-mut results)))))

	(fn cached_status
		(:doc "Read the selected binding's cached availability through a shared loan.")
		(params (results (shared-array u8)) (row i32)) (returns u32)
		(body (return (u32.from-u8 (array.load results row)))))

	(fn verify_bindings
		(:doc "Probe each selected header lazily and report the first failed selection in original order.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(first i32) (canonical (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8)))
		(returns Availability)
		(body
			(let program (call clang_program))
			(let-mut results (array.alloc u8 (array.len bindings)))
			(let-mut row first)
			(while
				(:doc "A zero result has yet to be checked; one means the member was available.")
				(i32.lt row (array.len bindings))
				(body
					(let binding (array.load bindings row))
					(if
						(:doc "Only a selected member with an availability contract triggers a query.")
						(call needs_availability binding)
						(then
							(let-mut status (call cached_status (borrow-shared results) row))
							(if
								(:doc "Query at most once per header and probe kind after a successful capture.")
								(u32.eqz status)
								(then
									(set status (call probe_binding (borrow-shared arena) (borrow-shared files)
										(borrow-shared bindings) row (borrow-shared program)
										(borrow-shared canonical) (borrow-shared options) (borrow-shared directory)
										(borrow-mut results)))
									(if
										(:doc "Use the memoized exact lookup after a successful probe.")
										(u32.eqz status)
										(then (set status (call cached_status (borrow-shared results) row))))))
							(if
								(:doc "An absent name and a failed probe both report the requesting source file.")
								(u32.lt 1u32 status)
								(then
									(let site (call selected_site binding))
									(return (struct.new Availability (error status)
										(file (struct.get site file)) (start (struct.get site start))
										(end (struct.get site end))))))))
					(set row (i32.inc row))))
			(return (struct.new Availability (error 0u32) (file -1i32) (start 0i32) (end 0i32)))))

	(fn check_optional_c_members
		(:doc "Leave graphs without availability contracts on their filesystem-only path.")
		(:expect (tests "stage-2/cli/native/cases.tsv" "stage-2/cli/native/bin.tsv"
				"stage-2/cli/native/optional-macros.tsv" "stage-2/cli/native/optional-typedefs/cases.tsv"
				"stage-2/cli/native/string-macros/cases.tsv" "stage-2/cli/native/macro-modes.tsv"
				"stage-2/cli/native/lossless-macros/cases.tsv")
			(issues "gh:wove-lang/wove:212" "gh:wove-lang/wove:539" "gh:wove-lang/wove:577" "gh:wove-lang/wove:638"
				"gh:wove-lang/wove:639" "gh:wove-lang/wove:677"))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(canonical (shared-array u8)) (options (shared-array u8)) (directory (shared-array u8)))
		(returns Availability)
		(body
			(let-mut row 0i32)
			(while
				(:doc "Select the tool and allocate probe storage only if a binding needs availability.")
				(i32.lt row (array.len bindings))
				(body
					(if
						(:doc "Once a selection requires availability checking, verify the rest of the published prefix in order.")
						(call needs_availability (array.load bindings row))
						(then (return (call verify_bindings (borrow-shared arena) (borrow-shared files)
							(borrow-shared bindings) row (borrow-shared canonical)
							(borrow-shared options) (borrow-shared directory)))))
					(set row (i32.inc row))))
			(return (struct.new Availability (error 0u32) (file -1i32) (start 0i32) (end 0i32))))))
