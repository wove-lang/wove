(module native_check_reports
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Track primary check diagnostics independently of the importing edge that found them.")

	(use wove-file "../source/graph.wove" (only (type GraphResult)))

	(fn report_capacity
		(:doc "Reserve one possible diagnostic per file admission or import operation. Ordinary builds need no log.")
		(params (files i32) (uses i32) (checking bool))
		(returns i32)
		(body
			(if (bool.not (local checking)) (then (return 0i32)))
			(if
				(:doc "Keep the signed array limit even when the two scratch tables approach it.")
				(i32.lt (i32.sub.wrapping 2147483647i32 (local files)) (local uses))
				(then (return 2147483647i32)))
			(return (i32.add.wrapping (local files) (local uses)))))

	(fn copy_graph_reports
		(:doc "Retain the initialized diagnostic prefix when the driver grows either graph table.")
		(params (source (shared-array GraphResult)) (count i32) (output (mut-array GraphResult)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Diagnostics outside the initialized prefix have not been reported.")
				(i32.lt (local index) (local count))
				(body
					(array.store (local output) (local index) (array.load (local source) (local index)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))))

	(fn remember_graph_report
		(:doc "Append a diagnostic once by its defining file, exact span, and error code.")
		(params (output (mut-array GraphResult)) (count i32) (result GraphResult))
		(returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The log holds only originating diagnostics, regardless of which import reached them.")
				(i32.lt (local index) (local count))
				(body
					(let previous (array.load (local output) (local index)))
					(if
						(:doc "Different spans or codes in the same file remain independently reportable.")
						(bool.and (i32.eq (struct.get (local previous) file) (struct.get (local result) file))
							(bool.and (u32.eq (struct.get (local previous) error) (struct.get (local result) error))
								(bool.and (i32.eq (struct.get (local previous) start) (struct.get (local result) start))
									(i32.eq (struct.get (local previous) end) (struct.get (local result) end)))))
						(then (return (local count))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(array.store (local output) (local count) (local result))
			(return (i32.add.wrapping (local count) 1i32))))
)
