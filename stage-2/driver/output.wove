(module native_cli_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Publish a complete retained C unit for a native command.")

	(use wove-file "./diagnostics.wove" (only report_argv))
	(use c-header "./host.h" (only wove_cli_publish))

	(fn publish_input
		(:doc "Publish the completed unit and attach any write failure to the output operand.")
		(params (path (shared-slice u8)) (target (shared-slice u8)) (profile (shared-slice u8)) (mode u32)
			(target_index i32) (output (shared-slice u8)))
		(returns i32)
		(body
			(let published (call wove_cli_publish (borrow-shared (local target)) (borrow-shared (local profile))
				(local mode) (borrow-shared (local path)) (borrow-shared (local output)) (slice.len (local output))))
			(if
				(:doc "Failure to publish names the original output argument.")
				(i32.lt (local published) (i32 0))
				(then (return (call report_argv (u32 65) (local target_index) (u32 5)))))
			(return (i32 0)))))
