(module native_cli_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Publish a complete retained C unit for a native command.")

	(use wove-file "./diagnostics.wove" (only report_argv
		(value project_file) (value publish_failure)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./files.wove" (only file_stamp read_source_file))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "./publication.wove" (only publish_file stage_file))

	(let cwd_path ".")
	(let cache_directory "/.wovec-cache/")
	(let source_suffix "/bin/main.c")
	(let runtime_include "\n#include \"wove_runtime.c\"\n")
	(let parent_directory "..")
	(let default_profile "default")
	(let debug_profile "debug")
	(let release_profile "release")

	(fn valid_path_component
		(:doc "Check one nonempty filesystem component before building a retained path.")
		(params (name (shared-array u8))) (returns bool)
		(body
			(let width name.len)
			(if
				(:doc "Empty and dot components cannot name a target or profile.")
				(bool:or (i32:eqz width)
					(bool:or (call same_bytes (borrow-shared name) 0i32 width
						(borrow-shared cwd_path) 0i32 1i32)
						(call same_bytes (borrow-shared name) 0i32 width
							(borrow-shared parent_directory) 0i32 2i32)))
				(then (return (bool false))))
			(let-mut index 0i32)
			(while
				(:doc "Reject directory separators and embedded C string terminators.")
				(i32:lt index width)
				(body
					(let byte (name.get index))
					(if
						(:doc "A path component cannot contain a separator or a C string terminator.")
						(bool:or (u8:eq byte 47u8) (u8:eqz byte))
						(then (return (bool false))))
					(set index (i32:inc index))))
			(return (bool true))))

	(fn make_retained_path
		(:doc `Join the validated target components in the retained publication layout.`)
		(params (parent (shared-array u8)) (name (shared-array u8)) (profile (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let width (u64:add (u64:from-i32 parent.len)
				(u64:add (u64:from-i32 name.len)
					(u64:add (u64:from-i32 profile.len)
						(u64:from-i32 (i32:inc (i32:add cache_directory.len source_suffix.len)))))))
			(if
				(:doc "Keep the destination path representable by the native byte ABI.")
				(u64:lt 2147483647u64 width)
				(then
					(let empty (array:alloc u8 0i32))
					(return (move empty))))
			(let-mut path (array:alloc u8 (i32:from-u64 width)))
			(let prefix (call append_bytes (borrow-shared parent) (borrow-mut path) 0i32))
			(let cache (call append_bytes (borrow-shared cache_directory) (borrow-mut path) prefix))
			(let base (call append_bytes (borrow-shared profile) (borrow-mut path) cache))
			(path.set base 47u8)
			(let suffix (call append_bytes (borrow-shared name) (borrow-mut path)
				(i32:inc base)))
			(let done (call append_bytes (borrow-shared source_suffix) (borrow-mut path) suffix))
			(return (move path))))

	(fn retained_path_for_profile
		(:doc `Resolve the profile component of the retained destination.`)
		(params (parent (shared-array u8)) (name (shared-array u8)) (profile (shared-array u8)) (mode u32))
		(returns (owned-array u8))
		(body
			(if
				(:doc "A non-default named profile supplies its own directory.")
				(bool:and (i32:gtz profile.len)
					(bool:not (call same_bytes (borrow-shared profile) 0i32 profile.len
						(borrow-shared default_profile) 0i32 default_profile.len)))
				(then
					(if
						(:doc "An invalid profile leaves an empty destination for publication to diagnose.")
						(bool:not (call valid_path_component (borrow-shared profile)))
						(then
							(let empty (array:alloc u8 0i32))
							(return (move empty))))
					(return (call make_retained_path (borrow-shared parent) (borrow-shared name)
						(borrow-shared profile)))))
			(if
				(:doc "Debug and release are separate built-in cache trees.")
				(u32:eq mode 1u32)
				(then (return (call make_retained_path (borrow-shared parent) (borrow-shared name)
					(borrow-shared debug_profile)))))
			(if
				(:doc "The release mode uses its matching cache directory.")
				(u32:eq mode 2u32)
				(then (return (call make_retained_path (borrow-shared parent) (borrow-shared name)
					(borrow-shared release_profile)))))
			(return (call make_retained_path (borrow-shared parent) (borrow-shared name)
				(borrow-shared default_profile)))))

	(fn valid_output_target
		(:doc "Require a final output name before opening a source file.")
		(params (target (shared-array u8))) (returns bool)
		(body
			(let start (call directory_width (borrow-shared target)))
			(return (call valid_path_component
				(borrow-shared (target.range start target.len))))))

	(fn retained_c_path
		(:doc `Compute one retained destination for collision checks and publication.`)
		(params (target (shared-array u8)) (profile (shared-array u8)) (mode u32)) (returns (owned-array u8))
		(body
			(let slash (i32:dec (call directory_width (borrow-shared target))))
			(if
				(:doc "A bare output name places its cache under the current directory.")
				(i32:ltz slash)
				(then (return (call retained_path_for_profile (borrow-shared cwd_path)
					(borrow-shared target) (borrow-shared profile) mode))))
			(return (call retained_path_for_profile (borrow-shared (target.range 0i32 slash))
				(borrow-shared (target.range (i32:inc slash) target.len))
				(borrow-shared profile) mode))))

	(fn retained_tree_end
		(:doc `Locate the owned retained tree without recomputing its profile or target components.`)
		(params (path (shared-array u8))) (returns i32)
		(body
			(let width path.len)
			(let suffix source_suffix.len)
			(if (i32:lt width suffix) (then (return 0i32)))
			(return (i32:sub width suffix))))

	(fn stage_native_unit
		(:doc `Append the runtime after the emitted unit so its system headers cannot change the bridge preprocessing context.`)
		(params (path (shared-array u8)) (output (shared-array u8))) (returns bool)
		(body
			(let suffix runtime_include.len)
			(let size output.len)
			(if
				(:doc `The private unit has the same signed size limit as retained C.`)
				(i32:lt (i32:sub 2147483647i32 suffix) size)
				(then (return (bool false))))
			(let-mut unit (array:alloc u8 (i32:add suffix size)))
			(let end (call append_bytes (borrow-shared output) (borrow-mut unit) 0i32))
			(let written (call append_bytes (borrow-shared runtime_include) (borrow-mut unit) end))
			(return (call stage_file (borrow-shared path) (borrow-shared unit)))))

	(fn retain_c
		(:doc `Publish one complete C unit after its inputs have cleared all applicable protection checks.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (target_index i32) (output (shared-array u8)) (human bool))
		(returns i32)
		(body
			(let published (call publish_file (borrow-shared destination) (borrow-shared path)
				(borrow-shared project_file) (borrow-shared output)))
			(if
				(:doc `Failure to publish names the original output argument.`)
				(bool:not published)
				(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
			(return 0i32)))

	(fn retain_checked_unit
		(:doc `Publish the staged C without the runtime include after native dependency validation.`)
		(params (path (shared-array u8)) (destination (shared-array u8))
			(staged (shared-array u8)) (target_index i32) (human bool)) (returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared staged)))
			(let width (stamp.get length))
			(let suffix runtime_include.len)
			(if
				(:doc `The private unit must still be readable and have room for the generated suffix.`)
				(i32:lt width suffix)
				(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
			(let-mut unit (array:alloc u8 width))
			(let size (i32:sub width suffix))
			(if
				(:doc `Check the complete read and the generated runtime suffix before retaining the unit.`)
				(bool:not (bool:and (call read_source_file (borrow-shared staged) stamp (borrow-mut unit))
					(call same_bytes (borrow-shared unit) size width
						(borrow-shared runtime_include) 0i32 suffix)))
				(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
			(return (call retain_c (borrow-shared path) (borrow-shared destination) target_index
				(borrow-shared (unit.range 0i32 size)) human))))

	(fn publish_input
		(:doc `Publish cc immediately, or keep the binary build private until Clang reports its dependencies.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (target_index i32) (output (shared-array u8)) (human bool))
		(returns i32)
		(body
			(if
				(:doc `An invalid or unrepresentable retained path cannot be sent to the writer.`)
				(i32:eqz destination.len)
				(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
			(if
				(:doc `Only bin reserves a private translation unit.`)
				(i32:gtz staged.len)
				(then
					(if
						(:doc `No filesystem input may be replaced while emission is still private.`)
						(bool:not (call stage_native_unit (borrow-shared staged) (borrow-shared output)))
						(then (return (call report_argv 65u32 target_index (borrow-shared publish_failure) human))))
					(return 0i32)))
			(return (call retain_c (borrow-shared path) (borrow-shared destination)
				target_index (borrow-shared output) human)))))
