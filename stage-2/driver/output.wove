(module native_cli_output
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Publish a complete retained C unit for a native command.")

	(use wove-file "./diagnostics.wove" (only report_argv
		(value project_file) (value publish_failure)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./files.wove" (only file_stamp read_source_file))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "./publication.wove" (only publish_file stage_file))

	(let cwd_path ".")
	(let cache_directory "/.wovec-cache/")
	(let source_suffix "/bin/main.c")
	(let runtime_include "#include \"wove_runtime.c\"\n")
	(let parent_directory "..")
	(let default_profile "default")
	(let debug_profile "debug")
	(let release_profile "release")

	(fn valid_path_component
		(:doc "Check one nonempty filesystem component before building a retained path.")
		(params (name (shared-array u8))) (returns bool)
		(body
			(let width (array.len (local name)))
			(if
				(:doc "Empty and dot components cannot name a target or profile.")
				(bool.or (i32.eq (local width) 0i32)
					(bool.or (call same_bytes (borrow-shared (local name)) 0i32 (local width)
						(borrow-shared (local cwd_path)) 0i32 1i32)
						(call same_bytes (borrow-shared (local name)) 0i32 (local width)
							(borrow-shared (local parent_directory)) 0i32 2i32)))
				(then (return (bool false))))
			(let-mut index 0i32)
			(while
				(:doc "Reject directory separators and embedded C string terminators.")
				(i32.lt (local index) (local width))
				(body
					(let byte (array.load (local name) (local index)))
					(if
						(:doc "A path component cannot contain a separator or a C string terminator.")
						(bool.or (u8.eq (local byte) 47u8) (u8.eq (local byte) 0u8))
						(then (return (bool false))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (bool true))))

	(fn make_retained_path
		(:doc `Join the validated target components in the retained publication layout.`)
		(params (parent (shared-array u8)) (name (shared-array u8)) (profile (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let width (u64.add (u64.from-i32 (array.len (local parent)))
				(u64.add (u64.from-i32 (array.len (local name)))
					(u64.add (u64.from-i32 (array.len (local profile)))
						(u64.from-i32 (i32.add 1i32
							(i32.add (array.len (local cache_directory)) (array.len (local source_suffix)))))))))
			(if
				(:doc "Keep the destination path representable by the native byte ABI.")
				(u64.lt 2147483647u64 (local width))
				(then
					(let empty (array.alloc u8 0i32))
					(return (move (local empty)))))
			(let-mut path (array.alloc u8 (i32.from-u64 (local width))))
			(let prefix (call append_bytes (borrow-shared (local parent)) (borrow-mut (local path)) 0i32))
			(let cache (call append_bytes (borrow-shared (local cache_directory)) (borrow-mut (local path)) (local prefix)))
			(let base (call append_bytes (borrow-shared (local profile)) (borrow-mut (local path)) (local cache)))
			(array.store (local path) (local base) 47u8)
			(let suffix (call append_bytes (borrow-shared (local name)) (borrow-mut (local path))
				(i32.add (local base) 1i32)))
			(let done (call append_bytes (borrow-shared (local source_suffix)) (borrow-mut (local path)) (local suffix)))
			(return (move (local path)))))

	(fn retained_path_for_profile
		(:doc `Resolve the profile component of the retained destination.`)
		(params (parent (shared-array u8)) (name (shared-array u8)) (profile (shared-array u8)) (mode u32))
		(returns (owned-array u8))
		(body
			(if
				(:doc "A non-default named profile supplies its own directory.")
				(bool.and (i32.lt 0i32 (array.len (local profile)))
					(bool.not (call same_bytes (borrow-shared (local profile)) 0i32 (array.len (local profile))
						(borrow-shared (local default_profile)) 0i32 (array.len (local default_profile)))))
				(then
					(if
						(:doc "An invalid profile leaves an empty destination for publication to diagnose.")
						(bool.not (call valid_path_component (borrow-shared (local profile))))
						(then
							(let empty (array.alloc u8 0i32))
							(return (move (local empty)))))
					(return (call make_retained_path (borrow-shared (local parent)) (borrow-shared (local name))
						(borrow-shared (local profile))))))
			(if
				(:doc "Debug and release are separate built-in cache trees.")
				(u32.eq (local mode) 1u32)
				(then (return (call make_retained_path (borrow-shared (local parent)) (borrow-shared (local name))
					(borrow-shared (local debug_profile))))))
			(if
				(:doc "The release mode uses its matching cache directory.")
				(u32.eq (local mode) 2u32)
				(then (return (call make_retained_path (borrow-shared (local parent)) (borrow-shared (local name))
					(borrow-shared (local release_profile))))))
			(return (call make_retained_path (borrow-shared (local parent)) (borrow-shared (local name))
				(borrow-shared (local default_profile))))))

	(fn valid_output_target
		(:doc "Require a final output name before opening a source file.")
		(params (target (shared-array u8))) (returns bool)
		(body
			(let start (call directory_width (borrow-shared (local target))))
			(return (call valid_path_component
				(borrow-shared (array.range (local target) (local start) (array.len (local target))))))))

	(fn retained_c_path
		(:doc `Compute one retained destination for collision checks and publication.`)
		(params (target (shared-array u8)) (profile (shared-array u8)) (mode u32)) (returns (owned-array u8))
		(body
			(let slash (i32.sub (call directory_width (borrow-shared (local target))) 1i32))
			(if
				(:doc "A bare output name places its cache under the current directory.")
				(i32.lt (local slash) 0i32)
				(then (return (call retained_path_for_profile (borrow-shared (local cwd_path))
					(borrow-shared (local target)) (borrow-shared (local profile)) (local mode)))))
			(return (call retained_path_for_profile (borrow-shared (array.range (local target) 0i32 (local slash)))
				(borrow-shared (array.range (local target) (i32.add (local slash) 1i32) (array.len (local target))))
				(borrow-shared (local profile)) (local mode)))))

	(fn retained_tree_end
		(:doc `Locate the owned retained tree without recomputing its profile or target components.`)
		(params (path (shared-array u8))) (returns i32)
		(body
			(let width (array.len (local path)))
			(let suffix (array.len (local source_suffix)))
			(if (i32.lt (local width) (local suffix)) (then (return 0i32)))
			(return (i32.sub (local width) (local suffix)))))

	(fn stage_native_unit
		(:doc `Include the embedded runtime only in the private unit passed to Clang.`)
		(params (path (shared-array u8)) (output (shared-array u8))) (returns bool)
		(body
			(let prefix (array.len (local runtime_include)))
			(let size (array.len (local output)))
			(if
				(:doc `The private unit has the same signed size limit as retained C.`)
				(i32.lt (i32.sub 2147483647i32 (local prefix)) (local size))
				(then (return (bool false))))
			(let-mut unit (array.alloc u8 (i32.add (local prefix) (local size))))
			(let end (call append_bytes (borrow-shared (local runtime_include)) (borrow-mut (local unit)) 0i32))
			(let written (call append_bytes (borrow-shared (local output)) (borrow-mut (local unit)) (local end)))
			(return (call stage_file (borrow-shared (local path)) (borrow-shared (local unit))))))

	(fn retain_c
		(:doc `Publish one complete C unit after its inputs have cleared all applicable protection checks.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (target_index i32) (output (shared-array u8)) (human bool))
		(returns i32)
		(body
			(let published (call publish_file (borrow-shared (local destination)) (borrow-shared (local path))
				(borrow-shared (local project_file)) (borrow-shared (local output))))
			(if
				(:doc `Failure to publish names the original output argument.`)
				(bool.not (local published))
				(then (return (call report_argv 65u32 (local target_index) (borrow-shared (local publish_failure)) (local human)))))
			(return 0i32)))

	(fn retain_checked_unit
		(:doc `Publish the staged C without the runtime include after native dependency validation.`)
		(params (path (shared-array u8)) (destination (shared-array u8))
			(staged (shared-array u8)) (target_index i32) (human bool)) (returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared (local staged))))
			(let width (struct.get (local stamp) length))
			(let prefix (array.len (local runtime_include)))
			(if
				(:doc `The private unit must still be readable and have room for the generated prefix.`)
				(i32.lt (local width) (local prefix))
				(then (return (call report_argv 65u32 (local target_index) (borrow-shared (local publish_failure)) (local human)))))
			(let-mut unit (array.alloc u8 (local width)))
			(if
				(:doc `Check the complete read and the generated runtime prefix before retaining the unit.`)
				(bool.not (bool.and (call read_source_file (borrow-shared (local staged)) (local stamp) (borrow-mut (local unit)))
					(call same_bytes (borrow-shared (local unit)) 0i32 (local prefix)
						(borrow-shared (local runtime_include)) 0i32 (local prefix))))
				(then (return (call report_argv 65u32 (local target_index) (borrow-shared (local publish_failure)) (local human)))))
			(return (call retain_c (borrow-shared (local path)) (borrow-shared (local destination)) (local target_index)
				(borrow-shared (array.range (local unit) (local prefix) (local width))) (local human)))))

	(fn publish_input
		(:doc `Publish cc immediately, or keep the binary build private until Clang reports its dependencies.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (target_index i32) (output (shared-array u8)) (human bool))
		(returns i32)
		(body
			(if
				(:doc `An invalid or unrepresentable retained path cannot be sent to the writer.`)
				(i32.eq (array.len (local destination)) 0i32)
				(then (return (call report_argv 65u32 (local target_index) (borrow-shared (local publish_failure)) (local human)))))
			(if
				(:doc `Only bin reserves a private translation unit.`)
				(i32.lt 0i32 (array.len (local staged)))
				(then
					(if
						(:doc `No filesystem input may be replaced while emission is still private.`)
						(bool.not (call stage_native_unit (borrow-shared (local staged)) (borrow-shared (local output))))
						(then (return (call report_argv 65u32 (local target_index) (borrow-shared (local publish_failure)) (local human)))))
					(return 0i32)))
			(return (call retain_c (borrow-shared (local path)) (borrow-shared (local destination))
				(local target_index) (borrow-shared (local output)) (local human))))))
