(module native_cli_host
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Bind the native CLI's bounded file operations. Wove owns every passed byte view.`)

	(bridge c-header "./host.h"
		(fn wove_cli_input_size
			(:doc `Size a regular source file. Use -1 for absence and -2 for other failures.`)
			(:pragma (c_cstr path))
			(params (path (shared-slice u8))) (returns i32))
		(fn wove_cli_read_input
			(:doc `Read exactly the expected source length into the caller's storage.`)
			(:pragma (c_cstr path) (c_bytes bytes length))
			(params (path (shared-slice u8)) (bytes (mut-slice u8)) (length i32)) (returns i32))
		(fn wove_cli_project_size
			(:doc `Locate and size the optional project configuration in the current directory.`)
			(params) (returns i32))
		(fn wove_cli_read_project
			(:doc `Read the optional project configuration into the caller's storage.`)
			(:pragma (c_bytes bytes length))
			(params (bytes (mut-slice u8)) (length i32)) (returns i32))
		(fn wove_cli_publish
			(:doc `Publish one C translation unit in the selected retained target tree.`)
			(:pragma (c_cstr target profile input) (c_bytes bytes length))
			(params (target (shared-slice u8)) (profile (shared-slice u8)) (mode u32)
				(input (shared-slice u8)) (bytes (shared-slice u8)) (length i32)) (returns i32))
		(fn wove_cli_stderr
			(:doc `Write the supplied serialized JSON record to stderr.`)
			(:pragma (c_bytes bytes length))
			(params (bytes (shared-slice u8)) (length i32)) (returns i32))
		(fn wove_cli_text
			(:doc `Copy the project name or fixed diagnostic message into caller storage.`)
			(:pragma (c_bytes bytes capacity))
			(params (selector u32) (bytes (mut-slice u8)) (capacity i32)) (returns i32))))
