(module native_cli_host
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Bind the native CLI's bounded file operations. Wove owns every passed byte view.`)

	(bridge c-header "./host.h"
		(fn wove_cli_input_size
			(:doc `Size a regular source file. Use -1 for absence and -2 for other failures.`)
			(:pragma (c_cstr path))
			(params (path (shared-slice u8))) (returns i32))
		(fn wove_cli_read_input
			(:doc `Read exactly the expected source length into the caller's storage.`)
			(:pragma (c_cstr path) (c_bytes bytes length))
			(params (path (shared-slice u8)) (bytes (mut-slice u8)) (length i32)) (returns i32))
		(fn wove_cli_asset_size
			(:doc `Measure a raw asset relative to its defining source path.`)
			(:pragma (c_cstr module request))
			(params (module (shared-slice u8)) (request (shared-slice u8))) (returns i32))
		(fn wove_cli_read_asset
			(:doc `Read a raw asset into its measured extent inside the caller's arena.`)
			(:pragma (c_cstr module request) (c_bytes bytes length))
			(params (module (shared-slice u8)) (request (shared-slice u8))
				(bytes (mut-slice u8)) (length i32) (start i32) (end i32)) (returns i32))
		(fn wove_cli_valid_target
			(:doc `Check that the output operand ends in a valid target name.`)
			(:pragma (c_cstr target))
			(params (target (shared-slice u8))) (returns bool))
		(fn wove_cli_publish
			(:doc `Write one C translation unit at the destination supplied by Wove.`)
			(:pragma (c_cstr destination input) (c_bytes bytes length))
			(params (destination (shared-slice u8)) (input (shared-slice u8)) (bytes (shared-slice u8)) (length i32)) (returns i32))))
