(module native_cli_platform
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Use the platform selected when building this native compiler.`)

	(use wove-file "../source/target.wove" (only (type SelectionContext)))

	(fn host_os
		(:doc `Use the Linux selection code for native input.`)
		(:pragma (cfg (os "linux")))
		(params) (returns u8)
		(body (return 1u8)))

	(fn host_os
		(:doc `Use the macOS selection code for native input.`)
		(:pragma (cfg (os "macos")))
		(params) (returns u8)
		(body (return 2u8)))

	(fn host_arch
		(:doc `Use the AArch64 selection code for native input.`)
		(:pragma (cfg (arch "aarch64")))
		(params) (returns u8)
		(body (return 1u8)))

	(fn host_arch
		(:doc `Use the x86-64 selection code for native input.`)
		(:pragma (cfg (arch "x86_64")))
		(params) (returns u8)
		(body (return 2u8)))

	(fn native_selection
		(:doc `Keep source selection and native header selection on the same host target.`)
		(params) (returns SelectionContext)
		(body (return (record.make SelectionContext (mode 0u32) (os (call host_os)) (arch (call host_arch)) (deployment -1i32)))))
)
