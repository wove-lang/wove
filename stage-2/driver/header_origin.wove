(module native_header_origin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recover declaration origin when Clang skips an already-processed header.")

	(use wove-file "../clang/trace.wove" (only include_line trace_length (type IncludeLine)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./files.wove" (only file_stamp (type FileStamp)))

	(let location_key "\"loc\"")
	(let expansion_key "\"expansionLoc\"")
	(let offset_key "\"offset\"")
	(let file_key "\"file\"")

	(fn key_matches
		(:doc "Match a key as emitted by Clang's JSON dumper.")
		(params (source (shared-array u8)) (base i32) (node JsonNode) (key (shared-array u8)))
		(returns bool)
		(body (return (call same_bytes (borrow-shared source)
			(base.add node/key_start)
			(base.add node/key_end)
			(borrow-shared key) 0i32 key.len))))

	(fn location_field
		(:doc "Find a direct field without confusing includedFrom.file with a physical location.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(owner i32) (key (shared-array u8))) (returns i32)
		(body
			(if
				(:doc "A missing location supplies no fields.")
				owner.ltz
				(then (return -1i32)))
			(let-mut row (struct:get (nodes.get owner) first_child))
			(while
				(:doc "Visit only members of the same object.")
				(i32:lt -1i32 row)
				(body
					(let field (nodes.get row))
					(if
						(:doc "Return the exact member row to preserve its place in the capture.")
						(call key_matches (borrow-shared source) base field (borrow-shared key))
						(then (return row)))
					(set row field/next_sibling)))
			(return -1i32)))

	(fn previous_location_file
		(:doc "Resolve Clang's omitted repeated filename from its closest earlier physical location.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (location i32)) (returns i32)
		(body
			(let-mut row location)
			(while
				(:doc "Physical locations carry an offset as their first key. Include-parent records do not.")
				row.gtz
				(body
					(set row row.dec)
					(let field (nodes.get row))
					(if
						(:doc "Check containing locations only for file-key rows.")
						(bool:and (i32:lt -1i32 field/parent)
							(call key_matches (borrow-shared source) base field (borrow-shared file_key)))
						(then
							(let owner (nodes.get field/parent))
							(let first (nodes.get owner/first_child))
							(if
								(:doc "The last physical spelling is the current file in Clang's serialized state.")
								(call key_matches (borrow-shared source) base first (borrow-shared offset_key))
								(then (return row)))))))
			(return -1i32)))

	(fn declaration_file
		(:doc "Use the declaration's expansion location for macro-generated declarations.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (declaration i32)) (returns i32)
		(body
			(let-mut location (call location_field (borrow-shared source) base (borrow-shared nodes)
				declaration (borrow-shared location_key)))
			(let expansion (call location_field (borrow-shared source) base (borrow-shared nodes)
				location (borrow-shared expansion_key)))
			(if
				(:doc "The expansion site identifies the header that actually introduced a macro-generated declaration.")
				(i32:lt -1i32 expansion)
				(then (set location expansion)))
			(let offset (call location_field (borrow-shared source) base (borrow-shared nodes)
				location (borrow-shared offset_key)))
			(if
				(:doc "An implicit declaration without a physical location cannot establish header membership.")
				offset.ltz
				(then (return -1i32)))
			(let direct (call location_field (borrow-shared source) base (borrow-shared nodes)
				location (borrow-shared file_key)))
			(if
				(:doc "Clang prints a filename when it differs from the previously serialized physical file.")
				(i32:lt -1i32 direct)
				(then (return direct)))
			(return (call previous_location_file (borrow-shared source) base
				(borrow-shared nodes) location))))

	(fn selected_include
		(:doc "The final depth-one include is the selected header, even when its guard skips it.")
		(params (trace (shared-array u8)) (length i32)) (returns IncludeLine)
		(body
			(let-mut selected (struct:new IncludeLine (depth 0i32) (start 0i32) (end 0i32) (next 0i32)))
			(let-mut cursor 0i32)
			(while
				(:doc "Ignore nested includes and ordinary diagnostics after the root include.")
				(cursor.lt length)
				(body
					(let line (call include_line (borrow-shared trace) cursor length))
					(if
						(:doc "Each later depth-one entry supersedes an earlier root include.")
						(line/depth.eq 1i32)
						(then (set selected line)))
					(set cursor line/next)))
			(return selected)))

	(fn same_include_file
		(:doc "Match exact trace spellings and aliases of the same physical file.")
		(params (trace (shared-array u8)) (included IncludeLine)
			(source (shared-array u8)) (start i32) (end i32) (expected FileStamp))
		(returns bool)
		(body
			(let first included/start)
			(let last included/end)
			(if
				(:doc "Exact spellings also work for virtual files supplied by the frontend.")
				(call same_bytes (borrow-shared trace) first last
					(borrow-shared source) start end)
				(then (return (bool true))))
			(if
				(:doc "Physical identity can only disambiguate paths that resolve on this host.")
				expected/length.ltz
				(then (return (bool false))))
			(let other (call file_stamp (borrow-shared (trace.range first last))))
			(return (bool:and (i32:lt -1i32 other/length)
				(bool:and (other/device.eq expected/device)
					(other/inode.eq expected/inode))))))

	(fn include_contains_file
		(:doc "Check whether the physical declaration file occurs in an observed selected-header subtree.")
		(params (trace (shared-array u8)) (length i32) (selected IncludeLine)
			(source (shared-array u8)) (file_start i32) (file_end i32)) (returns bool)
		(body
			(let selected_start selected/start)
			(let selected_end selected/end)
			(let selected_file (call file_stamp (borrow-shared (trace.range selected_start selected_end))))
			(let origin_file (call file_stamp (borrow-shared (source.range file_start file_end))))
			(let-mut selected_depth 0i32)
			(let-mut cursor 0i32)
			(while
				(:doc "Look for the first processing of the selected path and any includes introduced below it.")
				(cursor.lt length)
				(body
					(let line (call include_line (borrow-shared trace) cursor length))
					(let depth line/depth)
					(if
						(:doc "Diagnostics do not change the current include depth.")
						depth.gtz
						(then
							(if
								(:doc "A sibling or ancestor closes the earlier include subtree.")
								(selected_depth.not-lt depth)
								(then (set selected_depth 0i32)))
							(if
								(:doc "Start a subtree whenever Clang names the selected physical include.")
								(call same_include_file (borrow-shared trace) line
									(borrow-shared trace) selected_start selected_end selected_file)
								(then (set selected_depth depth)))
							(if
								(:doc "Earlier declarations only count when their file belongs to an observed selected subtree.")
								(bool:and selected_depth.gtz
									(call same_include_file (borrow-shared trace) line
										(borrow-shared source) file_start file_end origin_file))
								(then (return (bool true))))))
					(set cursor line/next)))
			(return (bool false))))

	(fn declaration_in_earlier_include
		(:doc "Identify an earlier declaration originating from the selected header or its transitive includes.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (declaration i32)
			(trace (shared-array u8))) (returns bool)
		(body
			(let file (call declaration_file (borrow-shared source) base (borrow-shared nodes) declaration))
			(if
				(:doc "An earlier declaration without a physical location has no verifiable origin.")
				file.ltz
				(then (return (bool false))))
			(let length (call trace_length (borrow-shared trace)))
			(let selected (call selected_include (borrow-shared trace) length))
			(if
				(:doc "A missing selected include has no earlier subtree to match.")
				selected/depth.eqz
				(then (return (bool false))))
			(let path (nodes.get file))
			(let first (base.add path/start))
			(let end (base.add path/end))
			(return (call include_contains_file (borrow-shared trace) length selected
				(borrow-shared source) first.inc end.dec)))))
