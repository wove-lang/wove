(module native_header_origin
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Recover declaration origin when Clang skips an already-processed header.")

	(use wove-file "../clang/trace.wove" (only include_line trace_length (type IncludeLine)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../text/bytes.wove" (only same_bytes))
	(use wove-file "./files.wove" (only file_stamp (type FileStamp)))

	(let location_key "\"loc\"")
	(let expansion_key "\"expansionLoc\"")
	(let offset_key "\"offset\"")
	(let file_key "\"file\"")

	(fn key_matches
		(:doc "Match a key as emitted by Clang's JSON dumper.")
		(params (source (shared-array u8)) (base i32) (node JsonNode) (key (shared-array u8)))
		(returns bool)
		(body (return (call same_bytes (borrow-shared (local source))
			(i32.add (local base) (struct.get (local node) key_start))
			(i32.add (local base) (struct.get (local node) key_end))
			(borrow-shared (local key)) 0i32 (array.len (local key))))))

	(fn location_field
		(:doc "Find a direct field without confusing includedFrom.file with a physical location.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode))
			(owner i32) (key (shared-array u8))) (returns i32)
		(body
			(if
				(:doc "A missing location supplies no fields.")
				(i32.lt (local owner) 0i32)
				(then (return -1i32)))
			(let-mut row (struct.get (array.load (local nodes) (local owner)) first_child))
			(while
				(:doc "Visit only members of the same object.")
				(i32.lt -1i32 (local row))
				(body
					(let field (array.load (local nodes) (local row)))
					(if
						(:doc "Return the exact member row to preserve its place in the capture.")
						(call key_matches (borrow-shared (local source)) (local base) (local field) (borrow-shared (local key)))
						(then (return (local row))))
					(set (local row) (struct.get (local field) next_sibling))))
			(return -1i32)))

	(fn previous_location_file
		(:doc "Resolve Clang's omitted repeated filename from its closest earlier physical location.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (location i32)) (returns i32)
		(body
			(let-mut row (local location))
			(while
				(:doc "Physical locations carry an offset as their first key. Include-parent records do not.")
				(i32.lt 0i32 (local row))
				(body
					(set (local row) (i32.sub (local row) 1i32))
					(let field (array.load (local nodes) (local row)))
					(if
						(:doc "Check containing locations only for file-key rows.")
						(bool.and (i32.lt -1i32 (struct.get (local field) parent))
							(call key_matches (borrow-shared (local source)) (local base) (local field) (borrow-shared (local file_key))))
						(then
							(let owner (array.load (local nodes) (struct.get (local field) parent)))
							(let first (array.load (local nodes) (struct.get (local owner) first_child)))
							(if
								(:doc "The last physical spelling is the current file in Clang's serialized state.")
								(call key_matches (borrow-shared (local source)) (local base) (local first) (borrow-shared (local offset_key)))
								(then (return (local row))))))))
			(return -1i32)))

	(fn declaration_file
		(:doc "Use the declaration's expansion location for macro-generated declarations.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (declaration i32)) (returns i32)
		(body
			(let-mut location (call location_field (borrow-shared (local source)) (local base) (borrow-shared (local nodes))
				(local declaration) (borrow-shared (local location_key))))
			(let expansion (call location_field (borrow-shared (local source)) (local base) (borrow-shared (local nodes))
				(local location) (borrow-shared (local expansion_key))))
			(if
				(:doc "The expansion site identifies the header that actually introduced a macro-generated declaration.")
				(i32.lt -1i32 (local expansion))
				(then (set (local location) (local expansion))))
			(let offset (call location_field (borrow-shared (local source)) (local base) (borrow-shared (local nodes))
				(local location) (borrow-shared (local offset_key))))
			(if
				(:doc "An implicit declaration without a physical location cannot establish header membership.")
				(i32.lt (local offset) 0i32)
				(then (return -1i32)))
			(let direct (call location_field (borrow-shared (local source)) (local base) (borrow-shared (local nodes))
				(local location) (borrow-shared (local file_key))))
			(if
				(:doc "Clang prints a filename when it differs from the previously serialized physical file.")
				(i32.lt -1i32 (local direct))
				(then (return (local direct))))
			(return (call previous_location_file (borrow-shared (local source)) (local base)
				(borrow-shared (local nodes)) (local location)))))

	(fn selected_include
		(:doc "The final depth-one include is the selected header, even when its guard skips it.")
		(params (trace (shared-array u8)) (length i32)) (returns IncludeLine)
		(body
			(let-mut selected (struct.new IncludeLine (depth 0i32) (start 0i32) (end 0i32) (next 0i32)))
			(let-mut cursor 0i32)
			(while
				(:doc "Ignore nested includes and ordinary diagnostics after the root include.")
				(i32.lt (local cursor) (local length))
				(body
					(let line (call include_line (borrow-shared (local trace)) (local cursor) (local length)))
					(if
						(:doc "Each later depth-one entry supersedes an earlier root include.")
						(i32.eq (struct.get (local line) depth) 1i32)
						(then (set (local selected) (local line))))
					(set (local cursor) (struct.get (local line) next))))
			(return (local selected))))

	(fn same_include_file
		(:doc "Match exact trace spellings and aliases of the same physical file.")
		(params (trace (shared-array u8)) (included IncludeLine)
			(source (shared-array u8)) (start i32) (end i32) (expected FileStamp))
		(returns bool)
		(body
			(let first (struct.get (local included) start))
			(let last (struct.get (local included) end))
			(if
				(:doc "Exact spellings also work for virtual files supplied by the frontend.")
				(call same_bytes (borrow-shared (local trace)) (local first) (local last)
					(borrow-shared (local source)) (local start) (local end))
				(then (return (bool true))))
			(if
				(:doc "Physical identity can only disambiguate paths that resolve on this host.")
				(i32.lt (struct.get (local expected) length) 0i32)
				(then (return (bool false))))
			(let other (call file_stamp (borrow-shared (array.range (local trace) (local first) (local last)))))
			(return (bool.and (i32.lt -1i32 (struct.get (local other) length))
				(bool.and (u64.eq (struct.get (local other) device) (struct.get (local expected) device))
					(u64.eq (struct.get (local other) inode) (struct.get (local expected) inode)))))))

	(fn include_contains_file
		(:doc "Check whether the physical declaration file occurs in an observed selected-header subtree.")
		(params (trace (shared-array u8)) (length i32) (selected IncludeLine)
			(source (shared-array u8)) (file_start i32) (file_end i32)) (returns bool)
		(body
			(let selected_start (struct.get (local selected) start))
			(let selected_end (struct.get (local selected) end))
			(let selected_file (call file_stamp (borrow-shared (array.range (local trace) (local selected_start) (local selected_end)))))
			(let origin_file (call file_stamp (borrow-shared (array.range (local source) (local file_start) (local file_end)))))
			(let-mut selected_depth 0i32)
			(let-mut cursor 0i32)
			(while
				(:doc "Look for the first processing of the selected path and any includes introduced below it.")
				(i32.lt (local cursor) (local length))
				(body
					(let line (call include_line (borrow-shared (local trace)) (local cursor) (local length)))
					(let depth (struct.get (local line) depth))
					(if
						(:doc "Diagnostics do not change the current include depth.")
						(i32.lt 0i32 (local depth))
						(then
							(if
								(:doc "A sibling or ancestor closes the earlier include subtree.")
								(bool.not (i32.lt (local selected_depth) (local depth)))
								(then (set (local selected_depth) 0i32)))
							(if
								(:doc "Start a subtree whenever Clang names the selected physical include.")
								(call same_include_file (borrow-shared (local trace)) (local line)
									(borrow-shared (local trace)) (local selected_start) (local selected_end) (local selected_file))
								(then (set (local selected_depth) (local depth))))
							(if
								(:doc "Earlier declarations only count when their file belongs to an observed selected subtree.")
								(bool.and (i32.lt 0i32 (local selected_depth))
									(call same_include_file (borrow-shared (local trace)) (local line)
										(borrow-shared (local source)) (local file_start) (local file_end) (local origin_file)))
								(then (return (bool true))))))
					(set (local cursor) (struct.get (local line) next))))
			(return (bool false))))

	(fn declaration_in_earlier_include
		(:doc "Identify an earlier declaration originating from the selected header or its transitive includes.")
		(params (source (shared-array u8)) (base i32) (nodes (shared-array JsonNode)) (declaration i32)
			(trace (shared-array u8))) (returns bool)
		(body
			(let file (call declaration_file (borrow-shared (local source)) (local base) (borrow-shared (local nodes)) (local declaration)))
			(if
				(:doc "An earlier declaration without a physical location has no verifiable origin.")
				(i32.lt (local file) 0i32)
				(then (return (bool false))))
			(let length (call trace_length (borrow-shared (local trace))))
			(let selected (call selected_include (borrow-shared (local trace)) (local length)))
			(if
				(:doc "A missing selected include has no earlier subtree to match.")
				(i32.eq (struct.get (local selected) depth) 0i32)
				(then (return (bool false))))
			(let path (array.load (local nodes) (local file)))
			(let first (i32.add (local base) (struct.get (local path) start)))
			(let end (i32.add (local base) (struct.get (local path) end)))
			(return (call include_contains_file (borrow-shared (local trace)) (local length) (local selected)
				(borrow-shared (local source)) (i32.add (local first) 1i32) (i32.sub (local end) 1i32))))))
