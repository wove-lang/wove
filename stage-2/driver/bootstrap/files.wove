(module bootstrap_disk_files
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read one Bootstrap file into Wove-owned buffers through the fixed host primitive.`)

	(use wove-file "../../text/copy.wove" (only append_bytes))

	(fn measure_file
		(:doc `Read the required regular-file extent without retaining a C allocation.`)
		(params (path (shared-slice u8))) (returns i32)
		(body
			(let-mut empty (array.alloc u8 0i32))
			(return (call bootstrap_file (borrow-shared (local path)) (borrow-mut (local empty))))))

	(fn read_file_range
		(:doc `Read the measured bytes and publish the range only if the current extent still agrees.`)
		(params (path (shared-slice u8)) (start i32) (end i32) (arena (mut-slice u8))) (returns bool)
		(body
			(if
				(:doc `A failed extent must leave the destination untouched.`)
				(bool.or (i32.lt (local start) 0i32)
					(bool.or (i32.lt (local end) (local start)) (i32.lt (slice.len (local arena)) (local end))))
				(then (return (bool false))))
			(let length (i32.sub.wrapping (local end) (local start)))
			(let-mut bytes (array.alloc u8 (local length)))
			(let read (call bootstrap_file (borrow-shared (local path)) (borrow-mut (local bytes))))
			(if
				(:doc `Reject changed or unreadable inputs before committing any bytes to the graph.`)
				(bool.not (i32.eq (local read) (local length)))
				(then (return (bool false))))
			(let written (call append_bytes (borrow-shared (local bytes)) (borrow-mut (local arena)) (local start)))
			(return (i32.eq (local written) (local end)))))
)
