(module bootstrap_graph_emit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Emit the real resolved graph from the seed-built compiler and write one complete C unit.`)

	(use wove-file "../graph_emit.wove" (only emit_bootstrap_entry))
	(use wove-file "../../source/graph.wove" (only (type GraphBinding) (type GraphModule) (type GraphResult)))
	(use wove-file "../../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../../text/copy.wove" (only append_bytes))
	(use wove-file "../../text/bytes.wove" (only write_byte))
	(use wove-file "../../text/decimal_write.wove" (only write_decimal_i32 write_decimal_u32))

	(let failure "wovec bootstrap error ")

	(fn report_bootstrap_path
		(:doc `Write the private compiler's status with the original source path and byte span.`)
		(params (path (shared-array u8)) (code u32) (start i32) (end i32)) (returns i32)
		(body
			(if (i32.lt 2147483583i32 (array.len path)) (then (return 1i32)))
			(let-mut message (array.alloc u8 (i32.add (array.len path) 64i32)))
			(let name (call append_bytes (borrow-shared path) (borrow-mut message) 0i32))
			(let colon (call write_byte (borrow-mut message) name 58u8))
			(let begin (call write_decimal_i32 (borrow-mut message) colon start))
			(let separator (call write_byte (borrow-mut message) begin 45u8))
			(let finish (call write_decimal_i32 (borrow-mut message) separator end))
			(let space (call write_byte (borrow-mut message) finish 32u8))
			(let detail (call append_bytes (borrow-shared failure) (borrow-mut message) space))
			(let last (call write_decimal_u32 (borrow-mut message) detail code))
			(let extent (call write_byte (borrow-mut message) last 10u8))
			(if
				(:doc `Distinguish a failure to write the diagnostic from the graph error.`)
				(bool.not (call bootstrap_write (borrow-shared (array.range message 0i32 extent)) (bool true)))
				(then (return 3i32)))
			(return 1i32)))

	(fn report_bootstrap
		(:doc `Find the defining file's recorded name for an original graph failure.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (identity i32)
			(code u32) (start i32) (end i32)) (returns i32)
		(body
			(let-mut index identity)
			(if
				(:doc `Use the compiler entry for a failure that has no defining row.`)
				(bool.or (i32.ltz index) (i32.not-lt index (array.len files)))
				(then (set index 0i32)))
			(let file (array.load files index))
			(return (call report_bootstrap_path
				(borrow-shared (array.range arena (struct.get file path_start) (struct.get file path_end)))
				code start end))))

	(fn copy_bindings
		(:doc `Seal the initialized binding prefix for the shared emitter.`)
		(params (source (shared-array GraphBinding)) (output (mut-array GraphBinding))) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc `The output size is the exact resolver binding count.`)
				(i32.lt index (array.len output))
				(body
					(array.store output index (array.load source index))
					(set index (i32.inc index))))))

	(fn emit_bootstrap_graph
		(:doc `Seal the graph's used byte prefix and exact binding count before emitting.`)
		(params (arena (shared-array u8)) (length i32) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(scratch (shared-array GraphBinding)) (graph GraphResult)) (returns i32)
		(body
			(let-mut bindings (array.alloc GraphBinding (struct.get graph bindings)))
			(call copy_bindings (borrow-shared scratch) (borrow-mut bindings))
			(let result (call emit_bootstrap_entry (borrow-shared (array.range arena 0i32 length))
				(borrow-shared files) (borrow-shared modules) (borrow-shared bindings) graph))
			(if
				(:doc "Report the checked source or embed failure at its original location.")
				(u32.gtz (struct.get result error))
				(then (return (call report_bootstrap (borrow-shared arena) (borrow-shared files)
					(struct.get result file) (struct.get result error)
					(struct.get result start) (struct.get result end)))))
			(return (struct.get result status))))
)
