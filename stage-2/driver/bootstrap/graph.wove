(module bootstrap_disk_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Load the selected compiler-entry graph with the seed's bounded POSIX file ABI.

	The shared resolver selects every edge. This module supplies file bytes
	and identities, keeps the suspended walk through workspace growth, and
	sends the completed graph to the shared emitter.`)

	(use wove-file "./files.wove" (only measure_file read_file_range))
	(use wove-file "./emit.wove" (only emit_bootstrap_graph report_bootstrap))
	(use wove-file "../graph_storage.wove" (only copy_disk_edges copy_graph_modules copy_graph_imports))
	(use wove-file "../paths.wove" (only directory_width write_file_path))
	(use wove-file "../bundled_paths.wove" (only
		(value stdlib_path) (value stdio_path) (value unistd_path) (value spawn_path)
		(value fcntl_path) (value errno_path) (value sys_stat_path) (value sys_wait_path) (value dirent_path) (value math_path) (value sys_file_path)))
	(use wove-file "../../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../../source/graph.wove" (only resolve_disk_graph (type GraphModule) (type GraphUse)
		(type GraphSelector) (type GraphBinding) (type GraphResult) (type DiskEdge) (type GraphProgress)))
	(use wove-file "../../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../../source/scan.wove" (only (type Token)))
	(use wove-file "../../source/strings.wove" (only decode_string))
	(use wove-file "../../text/copy.wove" (only append_bytes))

	(struct DiskProgress (fields (bytes i32) (files i32) (edges i32) (error u32)))
	(let provider_directory "llvm-libc/")

	(fn load_file
		(:doc `Register one disk snapshot under its canonical or bundled virtual path.`)
		(params (physical (shared-array u8)) (logical (shared-array u8)) (start i32) (index i32) (bundled bool)
			(arena (mut-array u8)) (files (mut-array SuppliedFile))) (returns i32)
		(body
			(if
				(:doc `A short arena or table requests a larger workspace before writing anything.`)
				(bool.or (i32.eq start -2i32) (i32.not-lt index (array.len files)))
				(then (return -2i32)))
			(if (i32.ltz start) (then (return -1i32)))
			(let width (array.len logical))
			(let size (call measure_file (borrow-shared physical)))
			(if (i32.ltz size) (then (return -1i32)))
			(let room (i32.sub (array.len arena) start))
			(if
				(:doc `Subtract each component before computing the end offsets.`)
				(bool.or (i32.lt room width)
					(i32.lt (i32.sub room width) size))
				(then (return -2i32)))
			(let source (i32.add start width))
			(let end (i32.add source size))
			(if
				(:doc `Failed or changed files are never exposed as initialized rows.`)
				(bool.not (call read_file_range (borrow-shared physical) source end
					(borrow-mut arena)))
				(then (return -1i32)))
			(let copied (call append_bytes (borrow-shared logical) (borrow-mut arena) start))
			(array.store files index
				(struct.new SuppliedFile (identity index) (path_start start) (path_end copied)
					(source_start source) (source_end end) (bundled bundled)))
			(return end)))

	(fn load_bundle_file
		(:doc `Read a checked-in C provider beside the compiler entry and retain its virtual identity.`)
		(params (entry (shared-array u8)) (logical (shared-array u8)) (start i32) (index i32)
			(arena (mut-array u8)) (files (mut-array SuppliedFile))) (returns i32)
		(body
			(if (i32.ltz start) (then (return start)))
			(let basename (call directory_width (borrow-shared logical)))
			(let request_size (i32.add (array.len provider_directory)
				(i32.sub (array.len logical) basename)))
			(let-mut request (array.alloc u8 request_size))
			(let end (call write_file_path (borrow-shared provider_directory)
				(borrow-shared (array.range logical basename (array.len logical)))
				(borrow-mut request)))
			(let-mut empty (array.alloc u8 0i32))
			(let width (call write_file_path (borrow-shared entry)
				(borrow-shared (array.range request 0i32 end)) (borrow-mut empty)))
			(if (i32.ltz width) (then (return -1i32)))
			(let-mut path (array.alloc u8 width))
			(let sized (call write_file_path (borrow-shared entry)
				(borrow-shared (array.range request 0i32 end)) (borrow-mut path)))
			(return (call load_file (borrow-shared (array.range path 0i32 sized)) (borrow-shared logical) start
				index (bool true) (borrow-mut arena) (borrow-mut files)))))

	(fn initial_files
		(:doc `Keep the source row and bundled header identities in the same order as the native compiler.`)
		(params (entry (shared-array u8)) (arena (mut-array u8)) (files (mut-array SuppliedFile))) (returns i32)
		(body
			(let root (call load_file (borrow-shared entry) (borrow-shared entry) 0i32 0i32
				(bool false) (borrow-mut arena) (borrow-mut files)))
			(let stdlib (call load_bundle_file (borrow-shared entry) (borrow-shared stdlib_path) root 1i32
				(borrow-mut arena) (borrow-mut files)))
			(let stdio (call load_bundle_file (borrow-shared entry) (borrow-shared stdio_path) stdlib 2i32
				(borrow-mut arena) (borrow-mut files)))
			(let unistd (call load_bundle_file (borrow-shared entry) (borrow-shared unistd_path) stdio 3i32
				(borrow-mut arena) (borrow-mut files)))
			(let spawn (call load_bundle_file (borrow-shared entry) (borrow-shared spawn_path) unistd 4i32
				(borrow-mut arena) (borrow-mut files)))
			(let fcntl (call load_bundle_file (borrow-shared entry) (borrow-shared fcntl_path) spawn 5i32
				(borrow-mut arena) (borrow-mut files)))
			(let errno (call load_bundle_file (borrow-shared entry) (borrow-shared errno_path) fcntl 6i32
				(borrow-mut arena) (borrow-mut files)))
			(let stat (call load_bundle_file (borrow-shared entry) (borrow-shared sys_stat_path) errno 7i32
				(borrow-mut arena) (borrow-mut files)))
			(let wait (call load_bundle_file (borrow-shared entry) (borrow-shared sys_wait_path) stat 8i32
				(borrow-mut arena) (borrow-mut files)))
			(let dirent (call load_bundle_file (borrow-shared entry) (borrow-shared dirent_path) wait 9i32
				(borrow-mut arena) (borrow-mut files)))
			(let math (call load_bundle_file (borrow-shared entry) (borrow-shared math_path) dirent 10i32
				(borrow-mut arena) (borrow-mut files)))
			(return (call load_bundle_file (borrow-shared entry) (borrow-shared sys_file_path) math 11i32
				(borrow-mut arena) (borrow-mut files)))))

	(fn copy_files
		(:doc "Keep published file identities and spans when their table grows.")
		(params (source (shared-array SuppliedFile)) (files (mut-array SuppliedFile)) (count i32)) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Copy exactly the published file rows.")
				(i32.lt index count)
				(body
					(array.store files index (array.load source index))
					(set index (i32.inc index))))))

	(fn find_file
		(:doc `Reuse the first stored identity for hard links and symbolic aliases.`)
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile)) (count i32))
		(returns i32)
		(body
			(let-mut row 0i32)
			(while
				(:doc `Bundled rows name virtual providers and never shadow disk files.`)
				(i32.lt row count)
				(body
					(let file (array.load files row))
					(if
						(:doc `The fixed host operation compares the complete native device and inode.`)
						(bool.and (bool.not (struct.get file bundled))
							(call bootstrap_same_file (borrow-shared path)
								(borrow-shared (array.range arena (struct.get file path_start)
									(struct.get file path_end)))))
						(then (return row)))
					(set row (i32.inc row))))
			(return -1i32)))

	(fn progress
		(:doc `Keep the initialized prefixes and first failure together.`)
		(params (bytes i32) (files i32) (edges i32) (error u32)) (returns DiskProgress)
		(body (return (struct.new DiskProgress (bytes bytes) (files files)
			(edges edges) (error error)))))

	(fn commit_edge
		(:doc `Bind one selected use to a canonical file, loading its bytes only for a new identity.`)
		(params (canonical (shared-array u8)) (request GraphResult) (used DiskProgress) (arena (mut-array u8))
			(files (mut-array SuppliedFile)) (edges (mut-array DiskEdge))) (returns DiskProgress)
		(body
			(let-mut count (struct.get used files))
			(let-mut end (struct.get used bytes))
			(let edge (struct.get used edges))
			(let-mut target (call find_file (borrow-shared canonical) (borrow-shared arena)
				(borrow-shared files) count))
			(if
				(:doc `A new defining file is published only when its full snapshot fits.`)
				(i32.ltz target)
				(then
					(set target count)
					(set end (call load_file (borrow-shared canonical) (borrow-shared canonical)
						end target (bool false) (borrow-mut arena) (borrow-mut files)))
					(if (i32.eq end -2i32) (then (return (call progress 0i32 0i32 0i32 16u32))))
					(if (i32.ltz end) (then (return (call progress 0i32 0i32 0i32 27u32))))
					(set count (i32.inc count))))
			(array.store edges edge
				(struct.new DiskEdge (file (struct.get request file)) (start (struct.get request start))
					(target target) (path_start 0i32) (path_end 0i32) (error_start 0i32) (error_end 0i32) (error 0u32)))
			(return (call progress end count (i32.inc edge) 0u32))))

	(fn load_edge
		(:doc `Decode and resolve the one file path requested by the shared graph walker.`)
		(params (request GraphResult) (used DiskProgress) (arena (mut-array u8))
			(files (mut-array SuppliedFile)) (edges (mut-array DiskEdge))) (returns DiskProgress)
		(body
			(if
				(:doc `Reserve an edge slot before opening the selected provider.`)
				(i32.eq (struct.get used edges) (array.len edges))
				(then (return (call progress 0i32 0i32 0i32 16u32))))
			(let importer (array.load files (struct.get request file)))
			(let start (struct.get request path_start))
			(let finish (struct.get request path_end))
			(let-mut decoded (array.alloc u8 (i32.sub finish start)))
			(let path (call decode_edge_path (borrow-shared arena) importer start finish
				(borrow-mut decoded)))
			(if (i32.ltz path) (then (return (call progress 0i32 0i32 0i32 27u32))))
			(let-mut empty (array.alloc u8 0i32))
			(let size (call edge_path (borrow-shared arena) importer
				(borrow-shared (array.range decoded 0i32 path)) (borrow-mut empty)))
			(if (i32.ltz size) (then (return (call progress 0i32 0i32 0i32 27u32))))
			(let-mut joined (array.alloc u8 size))
			(let written (call edge_path (borrow-shared arena) importer
				(borrow-shared (array.range decoded 0i32 path)) (borrow-mut joined)))
			(let width (call bootstrap_canonical_path (borrow-shared (array.range joined 0i32 written)) (borrow-mut empty)))
			(if (i32.lt width 1i32) (then (return (call progress 0i32 0i32 0i32 27u32))))
			(let-mut canonical (array.alloc u8 width))
			(let resolved (call bootstrap_canonical_path (borrow-shared (array.range joined 0i32 written)) (borrow-mut canonical)))
			(if
				(:doc `Reject a change between measuring and copying the canonical spelling.`)
				(i32.not-eq resolved width)
				(then (return (call progress 0i32 0i32 0i32 27u32))))
			(return (call commit_edge (borrow-shared canonical) request used
				(borrow-mut arena) (borrow-mut files) (borrow-mut edges)))))

	(fn decode_edge_path
		(:doc `Decode the use token in the importing file's own byte view.`)
		(params (arena (shared-array u8)) (importer SuppliedFile) (start i32) (end i32)
			(output (mut-array u8))) (returns i32)
		(body
			(let result (call decode_string
				(borrow-shared (array.range arena (struct.get importer source_start)
					(struct.get importer source_end)))
				(struct.new Token (kind 2u32) (start start) (end end) (error 0u32)) (borrow-mut output)))
			(if (u32.gtz (struct.get result error)) (then (return -1i32)))
			(return (struct.get result written))))

	(fn edge_path
		(:doc `Use the importing path's directory before performing POSIX canonical lookup.`)
		(params (arena (shared-array u8)) (importer SuppliedFile) (request (shared-array u8))
			(output (mut-array u8))) (returns i32)
		(body (return (call write_file_path
			(borrow-shared (array.range arena (struct.get importer path_start) (struct.get importer path_end)))
			(borrow-shared request) (borrow-mut output)))))

	(fn double_capacity
		(:doc "Double a workspace capacity after the caller checks its upper bound.")
		(params (capacity i32)) (returns i32)
		(body (return (i32.add capacity capacity))))

	(fn grow_disk
		(:doc "Copy the disk snapshots and committed resolver rows before continuing the pending operation.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (edges (shared-array DiskEdge)) (used DiskProgress)
			(saved (mut-array GraphProgress)) (modules (shared-array GraphModule)) (bindings (shared-array GraphBinding))
			(uses (shared-array GraphUse)) (selectors (shared-array GraphSelector))) (returns i32)
		(body
			(if
				(:doc "The byte arena is the largest capacity and must retain signed offsets.")
				(i32.lt 1073741823i32 (array.len arena))
				(then (return 1i32)))
			(let-mut next_arena (array.alloc u8 (call double_capacity (array.len arena))))
			(let-mut next_files (array.alloc SuppliedFile (call double_capacity (array.len files))))
			(let-mut next_edges (array.alloc DiskEdge (call double_capacity (array.len edges))))
			(let-mut next_modules (array.alloc GraphModule (array.len next_files)))
			(let capacity (call double_capacity (array.len bindings)))
			(let-mut next_bindings (array.alloc GraphBinding capacity))
			(let-mut next_uses (array.alloc GraphUse capacity))
			(let-mut next_selectors (array.alloc GraphSelector capacity))
			(let copied (call append_bytes
				(borrow-shared (array.range arena 0i32 (struct.get used bytes))) (borrow-mut next_arena) 0i32))
			(call copy_files (borrow-shared files) (borrow-mut next_files) (struct.get used files))
			(call copy_disk_edges (borrow-shared edges) (borrow-mut next_edges) (struct.get used edges))
			(let checkpoint (array.load saved 0i32))
			(call copy_graph_modules checkpoint (borrow-shared modules) (borrow-mut next_modules))
			(call copy_graph_imports checkpoint
				(borrow-shared bindings) (borrow-shared uses) (borrow-shared selectors)
				(borrow-mut next_bindings) (borrow-mut next_uses) (borrow-mut next_selectors))
			(return (call walk_disk (borrow-mut next_arena) (borrow-mut next_files) (borrow-mut next_edges)
				(call progress copied (struct.get used files) (struct.get used edges) 0u32)
				(borrow-mut saved) (borrow-mut next_modules)
				(borrow-mut next_bindings) (borrow-mut next_uses) (borrow-mut next_selectors)))))

	(fn resolve_edges
		(:doc `Use the shared native-selection walker on the initialized source and edge ranges.`)
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (edges (shared-array DiskEdge)) (length i32)
			(saved (mut-array GraphProgress)) (modules (mut-array GraphModule)) (bindings (mut-array GraphBinding))
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))) (returns GraphResult)
		(body (return (call resolve_disk_graph
			(borrow-shared (array.range arena 0i32 length))
			(borrow-shared files) 0i32
			(struct.new SelectionContext (mode 0u32) (os (call bootstrap_os)) (arch (call bootstrap_arch))
				(deployment (call bootstrap_deployment)))
			(borrow-mut modules) (borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)
			(borrow-shared edges) (borrow-mut saved) (bool false)))))

	(fn walk_disk
		(:doc `Add one active edge per successful resolver request and emit only a complete graph.`)
		(params (arena (mut-array u8)) (files (mut-array SuppliedFile)) (edges (mut-array DiskEdge)) (initial DiskProgress)
			(saved (mut-array GraphProgress)) (modules (mut-array GraphModule)) (bindings (mut-array GraphBinding))
			(uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))) (returns i32)
		(body
			(let-mut used_bytes (struct.get initial bytes))
			(let-mut used_files (struct.get initial files))
			(let-mut used_edges (struct.get initial edges))
			(while
				(:doc `Each iteration publishes an edge, grows a workspace, reports a failure, or emits the source.`)
				(bool true)
				(body
					(let used (call progress used_bytes used_files used_edges 0u32))
					(let-mut input (array.alloc SuppliedFile used_files))
					(call copy_files (borrow-shared files) (borrow-mut input) used_files)
					(let-mut targets (array.alloc DiskEdge used_edges))
					(call copy_disk_edges (borrow-shared edges) (borrow-mut targets) used_edges)
					(let result (call resolve_edges (borrow-shared arena) (borrow-shared input)
						(borrow-shared targets) used_bytes (borrow-mut saved) (borrow-mut modules)
						(borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)))
					(let error (struct.get result error))
					(if
						(:doc `The same emitter consumes the same published file and binding identities as native cc.`)
						(u32.eqz error)
						(then (return (call emit_bootstrap_graph (borrow-shared arena) used_bytes
							(borrow-shared input)
							(borrow-shared modules) (borrow-shared bindings) result))))
					(if
						(:doc "Retry the suspended resolver operation after growing its tables.")
						(u32.eq error 16u32)
						(then (return (call grow_disk (borrow-shared arena) (borrow-shared files)
							(borrow-shared edges) used (borrow-mut saved)
							(borrow-shared modules) (borrow-shared bindings)
							(borrow-shared uses) (borrow-shared selectors)))))
					(if
						(:doc `A non-request failure is complete and retains its original source span.`)
						(i32.ltz (struct.get result path_start))
						(then (return (call report_bootstrap (borrow-shared arena)
							(borrow-shared input)
							(struct.get result file) error (struct.get result start) (struct.get result end)))))
					(let next (call load_edge result used
						(borrow-mut arena) (borrow-mut files) (borrow-mut edges)))
					(let loaded (struct.get next error))
					(if
						(:doc "Keep the pending edge and the already loaded files while reserving more disk space.")
						(u32.eq loaded 16u32)
						(then (return (call grow_disk (borrow-shared arena) (borrow-shared files)
							(borrow-shared edges) used (borrow-mut saved)
							(borrow-shared modules) (borrow-shared bindings)
							(borrow-shared uses) (borrow-shared selectors)))))
					(if
						(:doc `A file open failure refers to the use that originally requested the provider.`)
						(u32.gtz loaded)
						(then (return (call report_bootstrap (borrow-shared arena)
							(borrow-shared input)
							(struct.get result file) loaded (struct.get result start) (struct.get result end)))))
					(set used_bytes (struct.get next bytes))
					(set used_files (struct.get next files))
					(set used_edges (struct.get next edges))))
			(return 1i32)))

	(fn compile_bootstrap_graph
		(:doc `Load the entry and bundled providers before starting a resumable disk walk.`)
		(params (entry (shared-array u8))) (returns i32)
		(body
			(let-mut bytes 1048576i32)
			(let-mut file_capacity 128i32)
			(let-mut edge_capacity 1024i32)
			(let-mut table_capacity 8192i32)
			(while
				(:doc "Reserve space for the entry and bundled providers before beginning discovery.")
				(bool true)
				(body
					(let-mut arena (array.alloc u8 bytes))
					(let-mut files (array.alloc SuppliedFile file_capacity))
					(let initial (call initial_files (borrow-shared entry) (borrow-mut arena) (borrow-mut files)))
					(if (i32.eq initial -1i32) (then (return 1i32)))
					(if
						(:doc "The entry and every bundled provider belong to the initial snapshot.")
						(i32.lt -1i32 initial)
						(then
							(let-mut edges (array.alloc DiskEdge edge_capacity))
							(let-mut saved (array.alloc GraphProgress 1i32))
							(let-mut modules (array.alloc GraphModule (array.len files)))
							(let-mut bindings (array.alloc GraphBinding table_capacity))
							(let-mut uses (array.alloc GraphUse table_capacity))
							(let-mut selectors (array.alloc GraphSelector table_capacity))
							(return (call walk_disk (borrow-mut arena) (borrow-mut files) (borrow-mut edges)
								(call progress initial 12i32 0i32 0u32) (borrow-mut saved) (borrow-mut modules)
								(borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)))))
					(if (i32.lt 1073741823i32 bytes) (then (return 1i32)))
					(set bytes (call double_capacity bytes))
					(set file_capacity (call double_capacity file_capacity))
					(set edge_capacity (call double_capacity edge_capacity))
					(set table_capacity (call double_capacity table_capacity))))
			(return 1i32)))
)
