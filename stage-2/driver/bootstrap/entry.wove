(module bootstrap_compiler_entry
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Enter the private seed-built command that emits C for one compiler source entry.`)

	(use wove-file "./graph.wove" (only compile_bootstrap_graph))
	(use wove-file "./emit.wove" (only report_bootstrap_path))

	(fn compile_entry
		(:doc `Give the graph walker the full canonical entry spelling and identity.`)
		(params (path (shared-slice u8))) (returns i32)
		(body
			(let-mut empty (array.alloc u8 0i32))
			(let width (call bootstrap_canonical_path (borrow-shared (local path)) (borrow-mut (local empty))))
			(if
				(:doc `A failed path lookup is diagnosed using the argument spelling.`)
				(i32.lt (local width) 1i32)
				(then (return (call report_bootstrap_path (borrow-shared (local path)) 27u32 0i32 0i32))))
			(let-mut canonical (array.alloc u8 (local width)))
			(let copied (call bootstrap_canonical_path (borrow-shared (local path)) (borrow-mut (local canonical))))
			(if
				(:doc `Use the canonical path only after all measured bytes have been copied.`)
				(bool.not (i32.eq (local copied) (local width)))
				(then (return (call report_bootstrap_path (borrow-shared (local path)) 27u32 0i32 0i32))))
			(return (call compile_bootstrap_graph (borrow-shared (local canonical))))))
)
