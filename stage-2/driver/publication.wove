(module native_cli_publication
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage a complete retained file beside its destination and publish it with one rename.")

	(use c-header "<sys/stat.h>" (only mkdir stat S_ISDIR (type Stat) (type (as Mode DirectoryMode))))
	(use c-header "<fcntl.h>" (only open O_CREAT O_EXCL O_WRONLY O_CLOEXEC (type Mode)))
	(use c-header "<unistd.h>" (only getpid close unlink))
	(use c-header "<stdio.h>" (only rename))
	(use c-header "<errno.h>" (only errno EEXIST))
	(use wove-file "../io/write.wove" (only write_all))
	(use wove-file "./files.wove" (only path_identity same_path_identity))
	(use wove-file "../hashing/base62.wove" (only write_base62_filename))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn ensure_directory
		(:doc "Create one directory or accept an existing directory, including a symbolic alias.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let status (call mkdir (borrow-shared path) (int:convert DirectoryMode 511i32)))
			(if status.eqz (then (return (bool true))))
			(if
				(:doc "Only an existing name can be reused after mkdir fails.")
				(errno.not-eq EEXIST)
				(then (return (bool false))))
			(let-mut info (struct:new Stat))
			(return (bool:and (i32:eqz (call stat (borrow-shared path) (borrow-mut info)))
				(call S_ISDIR info/st_mode)))))

	(fn ensure_parents
		(:doc "Create every directory prefix while leaving the final path component for publication.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let-mut index 1i32)
			(while
				(:doc "A leading slash and repeated separators do not name new directory components.")
				(index.lt path.len)
				(body
					(if
						(:doc "Create the prefix ending immediately before this separator.")
						(bool:and (u8:eq (path.get index) 47u8)
							(u8:not-eq (path.get index.dec) 47u8))
						(then
							(if
								(:doc "A blocked parent prevents any attempt to stage the file.")
								(bool:not (call ensure_directory (borrow-shared (path.range 0i32 index))))
								(then (return (bool false))))))
					(set index index.inc)))
			(return (bool true))))

	(fn publish_staged
		(:doc "Close the stage exactly once and rename only a fully written file. Unlink it on failure.")
		(params (descriptor i32) (stage (shared-array u8)) (path (shared-array u8)) (bytes (shared-array u8))) (returns bool)
		(body
			(let written (call write_all descriptor (borrow-shared bytes)))
			(let closed (i32:eqz (call close descriptor)))
			(if
				(:doc "Only a complete stage can replace the retained destination.")
				(bool:and (written.and closed)
					(i32:eqz (call rename (borrow-shared stage) (borrow-shared path))))
				(then (return (bool true))))
			(let removed (call unlink (borrow-shared stage)))
			(return (bool false))))

	(fn stage_file
		(:doc "Open a private sibling with exclusive creation, retrying only occupied names.")
		(params (path (shared-array u8)) (bytes (shared-array u8))) (returns bool)
		(body
			(let width path.len)
			(if
				(:doc "The suffix reserves a dot and six possibly escaped digits within the signed slice ABI.")
				(i32:lt 2147483634i32 width)
				(then (return (bool false))))
			(let-mut stage (array:alloc u8 (width.add 13i32)))
			(let copied (call append_bytes (borrow-shared path) (borrow-mut stage) 0i32))
			(stage.set width 46u8)
			(let start width.inc)
			(let seed (u32:shl (int:convert u32 (call getpid)) 12i32))
			(let flags (i32:from-u32 (u32:or (u32:or (u32:from-i32 O_CREAT) (u32:from-i32 O_EXCL))
				(u32:or (u32:from-i32 O_WRONLY) (u32:from-i32 O_CLOEXEC)))))
			(let-mut attempt 0u32)
			(while
				(:doc "Separate concurrent processes by PID and never truncate an already occupied staging name.")
				(attempt.lt 4096u32)
				(body
					(let identity (u32:and (seed.add attempt) 1073741823u32))
					(let end (call write_base62_filename identity (borrow-mut stage) start 6i32))
					(let descriptor (call open (borrow-shared (stage.range 0i32 end)) flags (int:convert Mode 384i32)))
					(if
						(:doc "Only a descriptor created by this attempt becomes a publication candidate.")
						(i32:lt -1i32 descriptor)
						(then (return (call publish_staged descriptor (borrow-shared (stage.range 0i32 end))
							(borrow-shared path) (borrow-shared bytes)))))
					(if
						(:doc "Permanent open errors should not trigger repeated staging attempts.")
						(errno.not-eq EEXIST)
						(then (return (bool false))))
					(set attempt attempt.inc)))
			(return (bool false))))

	(fn publish_file
		(:doc "Create retained parents, protect the original source and config identities, and stage the bytes.")
		(params (path (shared-array u8)) (source (shared-array u8)) (project (shared-array u8)) (bytes (shared-array u8))) (returns bool)
		(body
			(if
				(:doc "Skip all publication work if the destination cannot be prepared.")
				(bool:not (call ensure_parents (borrow-shared path)))
				(then (return (bool false))))
			(let destination (call path_identity (borrow-shared path)))
			(if
				(:doc "A retained alias must not replace the source or project input.")
				(bool:or (call same_path_identity destination (call path_identity (borrow-shared source)))
					(call same_path_identity destination (call path_identity (borrow-shared project))))
				(then (return (bool false))))
			(return (call stage_file (borrow-shared path) (borrow-shared bytes))))))
