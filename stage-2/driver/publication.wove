(module native_cli_publication
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage a complete retained file beside its destination and publish it with one rename.")

	(use c-header "<sys/stat.h>" (only mkdir stat S_ISDIR (type Stat) (type (as Mode DirectoryMode))))
	(use c-header "<fcntl.h>" (only open O_CREAT O_EXCL O_WRONLY O_CLOEXEC (type Mode)))
	(use c-header "<unistd.h>" (only getpid close unlink))
	(use c-header "<stdio.h>" (only rename))
	(use c-header "<errno.h>" (only errno EEXIST))
	(use wove-file "../io/write.wove" (only write_all))
	(use wove-file "./files.wove" (only path_identity same_path_identity))
	(use wove-file "../hashing/base32hex.wove" (only encode_base32hex31))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn ensure_directory
		(:doc "Create one directory or accept an existing directory, including a symbolic alias.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let status (call mkdir (borrow-shared (local path)) (int.convert DirectoryMode 511i32)))
			(if (i32.eqz (local status)) (then (return (bool true))))
			(if
				(:doc "Only an existing name can be reused after mkdir fails.")
				(i32.not-eq (local errno) (local EEXIST))
				(then (return (bool false))))
			(let-mut info (struct.new Stat))
			(return (bool.and (i32.eqz (call stat (borrow-shared (local path)) (borrow-mut (local info))))
				(call S_ISDIR (struct.get (local info) st_mode))))))

	(fn ensure_parents
		(:doc "Create every directory prefix while leaving the final path component for publication.")
		(params (path (shared-array u8))) (returns bool)
		(body
			(let-mut index 1i32)
			(while
				(:doc "A leading slash and repeated separators do not name new directory components.")
				(i32.lt (local index) (array.len (local path)))
				(body
					(if
						(:doc "Create the prefix ending immediately before this separator.")
						(bool.and (u8.eq (array.load (local path) (local index)) 47u8)
							(u8.not-eq (array.load (local path) (i32.sub (local index) 1i32)) 47u8))
						(then
							(if
								(:doc "A blocked parent prevents any attempt to stage the file.")
								(bool.not (call ensure_directory (borrow-shared (array.range (local path) 0i32 (local index)))))
								(then (return (bool false))))))
					(set (local index) (i32.add (local index) 1i32))))
			(return (bool true))))

	(fn publish_staged
		(:doc "Close the stage exactly once and rename only a fully written file. Unlink it on failure.")
		(params (descriptor i32) (stage (shared-array u8)) (path (shared-array u8)) (bytes (shared-array u8))) (returns bool)
		(body
			(let written (call write_all (local descriptor) (borrow-shared (local bytes))))
			(let closed (i32.eqz (call close (local descriptor))))
			(if
				(:doc "Only a complete stage can replace the retained destination.")
				(bool.and (bool.and (local written) (local closed))
					(i32.eqz (call rename (borrow-shared (local stage)) (borrow-shared (local path)))))
				(then (return (bool true))))
			(let removed (call unlink (borrow-shared (local stage))))
			(return (bool false))))

	(fn stage_file
		(:doc "Open a private sibling with exclusive creation, retrying only occupied names.")
		(params (path (shared-array u8)) (bytes (shared-array u8))) (returns bool)
		(body
			(let width (array.len (local path)))
			(if
				(:doc "The suffix occupies a dot and six digits within the signed slice ABI.")
				(i32.lt 2147483640i32 (local width))
				(then (return (bool false))))
			(let-mut stage (array.alloc u8 (i32.add (local width) 7i32)))
			(let copied (call append_bytes (borrow-shared (local path)) (borrow-mut (local stage)) 0i32))
			(array.store (local stage) (local width) 46u8)
			(let start (i32.add (local width) 1i32))
			(let-mut digits (array.alloc u8 7i32))
			(let seed (u32.shl (int.convert u32 (call getpid)) 12i32))
			(let flags (i32.from-u32 (u32.or (u32.or (u32.from-i32 (local O_CREAT)) (u32.from-i32 (local O_EXCL)))
				(u32.or (u32.from-i32 (local O_WRONLY)) (u32.from-i32 (local O_CLOEXEC))))))
			(let-mut attempt 0u32)
			(while
				(:doc "Separate concurrent processes by PID and never truncate an already occupied staging name.")
				(u32.lt (local attempt) 4096u32)
				(body
					(let identity (u32.and (u32.add (local seed) (local attempt)) 1073741823u32))
					(let encoded (call encode_base32hex31 (local identity) (borrow-mut (local digits)) 0i32))
					(let suffix (call append_bytes (borrow-shared (array.range (local digits) 1i32 7i32))
						(borrow-mut (local stage)) (local start)))
					(let descriptor (call open (borrow-shared (local stage)) (local flags) (int.convert Mode 384i32)))
					(if
						(:doc "Only a descriptor created by this attempt becomes a publication candidate.")
						(i32.lt -1i32 (local descriptor))
						(then (return (call publish_staged (local descriptor) (borrow-shared (local stage))
							(borrow-shared (local path)) (borrow-shared (local bytes))))))
					(if
						(:doc "Permanent open errors should not trigger repeated staging attempts.")
						(i32.not-eq (local errno) (local EEXIST))
						(then (return (bool false))))
					(set (local attempt) (u32.add (local attempt) 1u32))))
			(return (bool false))))

	(fn publish_file
		(:doc "Create retained parents, protect the original source and config identities, and stage the bytes.")
		(params (path (shared-array u8)) (source (shared-array u8)) (project (shared-array u8)) (bytes (shared-array u8))) (returns bool)
		(body
			(if
				(:doc "Skip all publication work if the destination cannot be prepared.")
				(bool.not (call ensure_parents (borrow-shared (local path))))
				(then (return (bool false))))
			(let destination (call path_identity (borrow-shared (local path))))
			(if
				(:doc "A retained alias must not replace the source or project input.")
				(bool.or (call same_path_identity (local destination) (call path_identity (borrow-shared (local source))))
					(call same_path_identity (local destination) (call path_identity (borrow-shared (local project)))))
				(then (return (bool false))))
			(return (call stage_file (borrow-shared (local path)) (borrow-shared (local bytes)))))))
