(module native_cli_publication
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Stage a complete retained file beside its destination and publish it with one rename.")

	(use c-header "<sys/stat.h>" (only mkdir stat S_ISDIR (type Stat) (type (as Mode DirectoryMode))))
	(use c-header "<fcntl.h>" (only open O_CREAT O_EXCL O_WRONLY O_CLOEXEC (type Mode)))
	(use c-header "<unistd.h>" (only getpid write close unlink (type Size)))
	(use c-header "<stdio.h>" (only rename))
	(use c-header "<errno.h>" (only errno EEXIST EINTR))
	(use wove-file "./files.wove" (only path_identity same_path_identity))
	(use wove-file "../hashing/base32hex.wove" (only encode_base32hex31))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn ensure_directory
		(:doc "Create one directory or accept an existing directory, including a symbolic alias.")
		(params (path (shared-slice u8))) (returns bool)
		(body
			(let status (call mkdir (borrow-shared (local path)) (int.convert DirectoryMode (i32 511))))
			(if (i32.eq (local status) (i32 0)) (then (return (bool true))))
			(if
				(:doc "Only an existing name can be reused after mkdir fails.")
				(bool.not (i32.eq (local errno) (local EEXIST)))
				(then (return (bool false))))
			(let-mut info (record.make Stat))
			(return (bool.and (i32.eq (call stat (borrow-shared (local path)) (borrow-mut (local info))) (i32 0))
				(call S_ISDIR (record.get (local info) st_mode))))))

	(fn ensure_parents
		(:doc "Create every directory prefix while leaving the final path component for publication.")
		(params (path (shared-slice u8))) (returns bool)
		(body
			(let-mut index (i32 1))
			(while
				(:doc "A leading slash and repeated separators do not name new directory components.")
				(i32.lt (local index) (slice.len (local path)))
				(body
					(if
						(:doc "Create the prefix ending immediately before this separator.")
						(bool.and (u8.eq (slice.load (local path) (local index)) (u8 47))
							(bool.not (u8.eq (slice.load (local path) (i32.sub.wrapping (local index) (i32 1))) (u8 47))))
						(then
							(if
								(:doc "A blocked parent prevents any attempt to stage the file.")
								(bool.not (call ensure_directory (borrow-shared (slice.range (local path) (i32 0) (local index)))))
								(then (return (bool false))))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (bool true))))

	(fn write_all
		(:doc "Write each byte once, advancing on short writes and retrying EINTR before any progress.")
		(params (descriptor i32) (bytes (shared-slice u8))) (returns bool)
		(body
			(let end (slice.len (local bytes)))
			(let-mut offset (i32 0))
			(while
				(:doc "Pass only the remaining bytes to the checked native write contract.")
				(i32.lt (local offset) (local end))
				(body
					(let count (int.convert Size (i32.sub.wrapping (local end) (local offset))))
					(let written (int.convert i32 (call write (local descriptor)
						(borrow-shared (slice.range (local bytes) (local offset) (local end))) (local count))))
					(if
						(:doc "A positive result advances the cursor. Zero and permanent errors fail the write.")
						(i32.lt (i32 0) (local written))
						(then (set (local offset) (i32.add.wrapping (local offset) (local written))))
						(else
							(if
								(:doc "An interrupted write made no progress. Retry only that failure.")
								(bool.not (bool.and (i32.lt (local written) (i32 0)) (i32.eq (local errno) (local EINTR))))
								(then (return (bool false))))))))
			(return (bool true))))

	(fn publish_staged
		(:doc "Close the stage exactly once and rename only a fully written file. Unlink it on failure.")
		(params (descriptor i32) (stage (shared-slice u8)) (path (shared-slice u8)) (bytes (shared-slice u8))) (returns bool)
		(body
			(let written (call write_all (local descriptor) (borrow-shared (local bytes))))
			(let closed (i32.eq (call close (local descriptor)) (i32 0)))
			(if
				(:doc "Only a complete stage can replace the retained destination.")
				(bool.and (bool.and (local written) (local closed))
					(i32.eq (call rename (borrow-shared (local stage)) (borrow-shared (local path))) (i32 0)))
				(then (return (bool true))))
			(let removed (call unlink (borrow-shared (local stage))))
			(return (bool false))))

	(fn stage_file
		(:doc "Open a private sibling with exclusive creation, retrying only occupied names.")
		(params (path (shared-slice u8)) (bytes (shared-slice u8))) (returns bool)
		(body
			(let width (slice.len (local path)))
			(if
				(:doc "The suffix occupies a dot and six digits within the signed slice ABI.")
				(i32.lt (i32 2147483640) (local width))
				(then (return (bool false))))
			(let-mut stage (array.alloc u8 (i32.add.wrapping (local width) (i32 7))))
			(let copied (call append_bytes (borrow-shared (local path)) (borrow-mut (local stage)) (i32 0)))
			(slice.store (local stage) (local width) (u8 46))
			(let start (i32.add.wrapping (local width) (i32 1)))
			(let-mut digits (array.alloc u8 (i32 7)))
			(let seed (u32.shl (int.convert u32 (call getpid)) (i32 12)))
			(let flags (int.convert i32 (u32.or (u32.or (int.convert u32 (local O_CREAT)) (int.convert u32 (local O_EXCL)))
				(u32.or (int.convert u32 (local O_WRONLY)) (int.convert u32 (local O_CLOEXEC))))))
			(let-mut attempt (u32 0))
			(while
				(:doc "Separate concurrent processes by PID and never truncate an already occupied staging name.")
				(u32.lt (local attempt) (u32 4096))
				(body
					(let identity (u32.and (u32.add.wrapping (local seed) (local attempt)) (u32 1073741823)))
					(let encoded (call encode_base32hex31 (local identity) (borrow-mut (local digits)) (i32 0)))
					(let suffix (call append_bytes (borrow-shared (slice.range (local digits) (i32 1) (i32 7)))
						(borrow-mut (local stage)) (local start)))
					(let descriptor (call open (borrow-shared (local stage)) (local flags) (int.convert Mode (i32 384))))
					(if
						(:doc "Only a descriptor created by this attempt becomes a publication candidate.")
						(i32.lt (i32 -1) (local descriptor))
						(then (return (call publish_staged (local descriptor) (borrow-shared (local stage))
							(borrow-shared (local path)) (borrow-shared (local bytes))))))
					(if
						(:doc "Permanent open errors should not trigger repeated staging attempts.")
						(bool.not (i32.eq (local errno) (local EEXIST)))
						(then (return (bool false))))
					(set (local attempt) (u32.add.wrapping (local attempt) (u32 1)))))
			(return (bool false))))

	(fn publish_file
		(:doc "Create retained parents, protect the original source and config identities, and stage the bytes.")
		(params (path (shared-slice u8)) (source (shared-slice u8)) (project (shared-slice u8)) (bytes (shared-slice u8))) (returns bool)
		(body
			(if
				(:doc "Skip all publication work if the destination cannot be prepared.")
				(bool.not (call ensure_parents (borrow-shared (local path))))
				(then (return (bool false))))
			(let destination (call path_identity (borrow-shared (local path))))
			(if
				(:doc "A retained alias must not replace the source or project input.")
				(bool.or (call same_path_identity (local destination) (call path_identity (borrow-shared (local source))))
					(call same_path_identity (local destination) (call path_identity (borrow-shared (local project)))))
				(then (return (bool false))))
			(return (call stage_file (borrow-shared (local path)) (borrow-shared (local bytes)))))))
