(module native_cli_command
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve a native invocation to check explicit entries or build one entry.

	Use the resolver's original argument rows to lend the source path,
	output target, and profile to the driver. An optional wovec.jsonc
	in the current directory contributes the selected project profile.`)

	(use wove-file "./diagnostics.wove"
		(only report_argv report_file report_source (value project_file) (value explicit_target_required)
			(value invalid_arguments) (value invalid_config) (value unreadable_file) (value non_utf8_source) (value invalid_target)))
	(use wove-file "./version.wove" (only is_version_argument print_version))
	(use wove-file "./output.wove" (only retained_c_path valid_output_target))
	(use wove-file "./protection.wove" (only protect_destinations no_destination_protection protected_input report_input_collision (type BuildProtection)))
	(use wove-file "../source/scan.wove" (only admit_source))
	(use wove-file "./source.wove" (only compile_input))
	(use wove-file "./arguments.wove" (only frontend_capacity write_probe_options))
	(use wove-file "./bin/build.wove" (only compile_binary))
	(use wove-file "./bin/links.wove" (only check_link_inputs))
	(use wove-file "./files.wove" (only file_stamp file_is_absent read_source_file))
	(use wove-file "../cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "../cli/command/args.wove" (only first_command_argument (type CommandArgument)))
	(use wove-file "../cli/command/resolve.wove" (only resolve_command command_setting (type CommandInvocation)))
	(use wove-file "../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../config/schema.wove" (only project_compiler_rule))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))

	(let explicit_bin_target "bin requires one explicit source and an explicit output target")
	(let explicit_check_source "cc --check requires at least one explicit source")
	(let clang_required "bin currently requires clang")

	(fn report_required_target
		(:doc `Keep the explicit-operand diagnostic specific to the selected command.`)
		(params (bin bool) (index i32) (human bool)) (returns i32)
		(body
			(if (local bin) (then (return (call report_argv 12u32 (local index) (borrow-shared (local explicit_bin_target)) (local human)))))
			(return (call report_argv 12u32 (local index) (borrow-shared (local explicit_target_required)) (local human)))))

	(fn admit_source_path
		(:doc "Require the UTF-8 path spelling used by source and argv diagnostics.")
		(params (path (shared-array u8)) (index i32) (human bool)) (returns i32)
		(body
			(if
				(:doc "Point an invalid path at its original operand before a file read.")
				(i32.lt -1i32 (call admit_source (borrow-shared (local path))))
				(then (return (call report_argv 3u32 (local index) (borrow-shared (local non_utf8_source)) (local human)))))
			(return 0i32)))

	(fn check_entries
		(:doc "Check each explicit entry in operand order and retain the highest reported exit status.")
		(:expect (tests "stage-2/cli/native/check.tsv") (issues "gh:wove-lang/wove:94"))
		(params (bytes (shared-array u8)) (arguments (shared-array CommandArgument)) (first i32) (rows i32)
			(options (shared-array u8)) (no_output (shared-array u8)) (protection BuildProtection) (human bool))
		(returns i32)
		(body
			(let-mut row (local first))
			(let-mut status 0i32)
			(while
				(:doc "Each graph reports its own failure and leaves subsequent entries available for checking.")
				(i32.lt -1i32 (local row))
				(body
					(let input (array.load (local arguments) (local row)))
					(let start (struct.get (local input) start))
					(let end (struct.get (local input) end))
					(let-mut result (call admit_source_path (borrow-shared (array.range (local bytes) (local start) (local end)))
						(struct.get (local input) argv_index) (local human)))
					(if
						(:doc "Only admitted path spellings can be used to open the source graph.")
						(i32.eq (local result) 0i32)
						(then (set (local result) (call compile_input
							(borrow-shared (array.range (local bytes) (local start) (local end)))
							(borrow-shared (local no_output)) (borrow-shared (local no_output))
							(borrow-shared (local options)) (local protection) -1i32 (bool true) (local human)))))
					(if
						(:doc "Preserve a diagnostic stream failure even if later source checks produce ordinary failures.")
						(i32.lt (local status) (local result))
						(then (set (local status) (local result))))
					(set (local row) (call first_command_argument (borrow-shared (local arguments))
						(i32.add.wrapping (local row) 1i32) (local rows) -1i32))))
			(return (local status))))

	(fn execute_cc
		(:doc "Forward the same resolved probe options to cc and check-only compilation.")
		(params (first i32) (retained (shared-array u8)) (protection BuildProtection) (target_index i32)
			(check_only bool) (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool))
		(returns i32)
		(body
			(let no_stage (array.alloc u8 0i32))
			(let capacity (call frontend_capacity (array.len (local bytes)) (array.len (local config)) (struct.get (local invocation) rows) 0u64))
			(let-mut options (array.alloc u8 (local capacity)))
			(let frontend (call write_probe_options (borrow-shared (local bytes)) (borrow-shared (local config))
				(local invocation) (borrow-shared (local arguments)) (borrow-shared (local nodes))
				(borrow-shared (local settings)) (borrow-shared (local no_stage)) (borrow-mut (local options))))
			(let end (struct.get (local frontend) probe_end))
			(if
				(:doc "Every explicit check entry uses the same resolved target and probe options.")
				(local check_only)
				(then (return (call check_entries (borrow-shared (local bytes)) (borrow-shared (local arguments))
					(local first) (struct.get (local invocation) rows)
					(borrow-shared (array.range (local options) 0i32 (local end)))
					(borrow-shared (local no_stage)) (local protection) (local human)))))
			(let input (array.load (local arguments) (local first)))
			(return (call compile_input
				(borrow-shared (array.range (local bytes) (struct.get (local input) start) (struct.get (local input) end)))
				(borrow-shared (local retained)) (borrow-shared (local no_stage))
				(borrow-shared (array.range (local options) 0i32 (local end)))
				(local protection) (local target_index) (bool false) (local human)))))

	(fn execute_build
		(:doc `Pass the resolved source and profile to checking or compilation.`)
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool))
		(returns i32)
		(body
			(let command (struct.get (local invocation) command))
			(let bin (u32.eq (local command) 2u32))
			(let operands (struct.get (local invocation) operands))
			(let rows (struct.get (local invocation) rows))
			(let checked (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -5i32))
			(let check_only (bool.and (i32.lt -1i32 (local checked))
				(u32.eq (struct.get (array.load (local arguments) (local checked)) scalar) 1u32)))
			(let first (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -1i32))
			(if
				(:doc "Check mode accepts every explicit input and has no publication destination.")
				(local check_only)
				(then
					(if
						(:doc "Report the missing source before preparing options for the entry checks.")
						(i32.lt (local first) 0i32)
						(then (return (call report_argv 12u32 0i32 (borrow-shared (local explicit_check_source)) (local human)))))
					(let no_output (array.alloc u8 0i32))
					(return (call execute_cc (local first) (borrow-shared (local no_output))
						(call no_destination_protection) -1i32 (bool true)
						(borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
						(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings)) (local human)))))
			(if
				(:doc "Ordinary compilation takes one explicit source with cc or bin.")
				(bool.or (bool.not (bool.or (u32.eq (local command) 1u32) (local bin)))
					(i32.eq (local operands) 0i32))
				(then (return (call report_required_target (local bin) 0i32 (local human)))))
			(if
				(:doc "Point at the first extra source operand when the caller supplies several.")
				(i32.lt 1i32 (local operands))
				(then
					(let extra (call first_command_argument (borrow-shared (local arguments))
						(i32.add.wrapping (local first) 1i32) (local rows) -1i32))
					(return (call report_required_target (local bin)
						(struct.get (array.load (local arguments) (local extra)) argv_index) (local human)))))
			(let output (call command_setting (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) 3u32 19i32))
			(if
				(:doc "Publication requires an explicit build.output option such as -o.")
				(bool.not (u32.eq (struct.get (local output) origin) 2u32))
				(then (return (call report_required_target (local bin) 0i32 (local human)))))
			(let input (array.load (local arguments) (local first)))
			(let profile (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -2i32))
			(let-mut start 0i32)
			(let-mut end 0i32)
			(if
				(:doc "An omitted profile names the default retained tree. A named profile was validated by resolve_command.")
				(bool.not (i32.lt (local profile) 0i32))
				(then
					(let selection (array.load (local arguments) (local profile)))
					(set (local start) (struct.get (local selection) start))
					(set (local end) (struct.get (local selection) end))))
			(if
				(:doc `The first native build path launches Clang. Diagnose other selections at the option's value.`)
				(local bin)
				(then
					(let tool (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -6i32))
					(if
						(:doc `Only an explicit GCC selection differs from the Clang default.`)
						(bool.and (i32.lt -1i32 (local tool))
							(u32.eq (struct.get (array.load (local arguments) (local tool)) scalar) 1u32))
						(then (return (call report_argv 12u32 (struct.get (array.load (local arguments) (local tool)) argv_index)
							(borrow-shared (local clang_required)) (local human)))))))
			(let path_start (struct.get (local input) start))
			(let path_end (struct.get (local input) end))
			(let admitted (call admit_source_path (borrow-shared (array.range (local bytes) (local path_start) (local path_end)))
				(struct.get (local input) argv_index) (local human)))
			(if (i32.lt 0i32 (local admitted)) (then (return (local admitted))))
			(let target (array.load (local arguments) (struct.get (local output) row)))
			(let target_start (struct.get (local target) start))
			(let target_end (struct.get (local target) end))
			(let target_index (struct.get (local target) argv_index))
			(if
				(:doc `The final target component must fit the retained publication layout.`)
				(bool.not (call valid_output_target (borrow-shared (array.range (local bytes) (local target_start) (local target_end)))))
				(then (return (call report_argv 3u32 (local target_index) (borrow-shared (local invalid_target)) (local human)))))
			(let retained (call retained_c_path (borrow-shared (array.range (local bytes) (local target_start) (local target_end)))
				(borrow-shared (array.range (local bytes) (local start) (local end))) (struct.get (local invocation) mode)))
			(let protection (call protect_destinations
				(borrow-shared (array.range (local bytes) (local target_start) (local target_end))) (borrow-shared (local retained))))
			(if
				(:doc `Both publication paths protect the requested entry and its filesystem aliases.`)
				(call protected_input (borrow-shared (array.range (local bytes) (local path_start) (local path_end))) (local protection))
				(then (return (call report_input_collision (borrow-shared (array.range (local bytes) (local path_start) (local path_end))) (local human)))))
			(if
				(:doc `An existing project file supplies the invocation even when no named profile is selected.`)
				(call protected_input (borrow-shared (local project_file)) (local protection))
				(then (return (call report_input_collision (borrow-shared (local project_file)) (local human)))))
			(if
				(:doc `Use the same checked destinations for native compilation and retained C.`)
				(local bin)
				(then
					(let link_conflict (call check_link_inputs (borrow-shared (local bytes)) (borrow-shared (local config))
						(local invocation) (borrow-shared (local arguments)) (borrow-shared (local nodes))
						(borrow-shared (local settings)) (local protection) (local human)))
					(if (i32.lt 0i32 (local link_conflict)) (then (return (local link_conflict))))
					(return (call compile_binary
						(borrow-shared (array.range (local bytes) (local path_start) (local path_end)))
						(borrow-shared (array.range (local bytes) (local target_start) (local target_end)))
						(borrow-shared (local retained)) (local protection) (local target_index)
						(borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
						(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings)) (local human)))))
			(return (call execute_cc (local first)
				(borrow-shared (local retained)) (local protection) (local target_index) (bool false)
				(borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
				(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings)) (local human)))))

	(fn report_project_read
		(:doc "Report project I/O first, using any explicit diagnostic switch accepted by the argv parser.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan))) (returns i32)
		(body
			(let empty (array.alloc u8 0i32))
			(let-mut nodes (array.alloc JsonNode 0i32))
			(let-mut settings (array.alloc ProjectSetting 0i32))
			(let-mut arguments (array.alloc CommandArgument (array.len (local argv))))
			(let invocation (call resolve_command (borrow-shared (local bytes)) (borrow-shared (local argv))
				(borrow-shared (local empty)) (bool false) (borrow-mut (local nodes)) (borrow-mut (local settings))
				(borrow-mut (local arguments))))
			(return (call report_file (borrow-shared (local project_file)) 64u32 0i32 0i32
				(borrow-shared (local unreadable_file)) (struct.get (local invocation) argv_human)))))

	(fn run_native_build
		(:doc `Read the optional project and resolve the host argv before opening the requested source.`)
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared (local project_file))))
			(let size (struct.get (local stamp) length))
			(let has_config (bool.not (call file_is_absent (local stamp))))
			(if
				(:doc "Only a genuinely absent project falls back to built-in defaults.")
				(bool.and (local has_config) (i32.lt (local size) 0i32))
				(then (return (call report_project_read (borrow-shared (local bytes)) (borrow-shared (local argv))))))
			(let-mut length 0i32)
			(if
				(:doc "Size the Wove-owned config view from the optional file.")
				(local has_config)
				(then (set (local length) (local size))))
			(let-mut config (array.alloc u8 (local length)))
			(if
				(:doc "Read the exact project bytes before passing them to the resolver.")
				(local has_config)
				(then
					(let read (call read_source_file (borrow-shared (local project_file)) (local stamp) (borrow-mut (local config))))
					(if
						(:doc "Read failures belong to the project file.")
						(bool.not (local read))
						(then (return (call report_project_read (borrow-shared (local bytes)) (borrow-shared (local argv))))))))
			(let capacity (i32.add.wrapping (local length) 1i32))
			(let-mut nodes (array.alloc JsonNode (local capacity)))
			(let-mut settings (array.alloc ProjectSetting (local capacity)))
			(let-mut arguments (array.alloc CommandArgument (array.len (local argv))))
			(let invocation (call resolve_command (borrow-shared (local bytes)) (borrow-shared (local argv))
				(borrow-shared (local config)) (local has_config)
				(borrow-mut (local nodes)) (borrow-mut (local settings)) (borrow-mut (local arguments))))
			(let error (struct.get (local invocation) error))
			(if
				(:doc "Preserve either the argv index or the original JSONC span from command resolution.")
				(u32.lt 0u32 (local error))
				(then
					(let human (struct.get (local invocation) argv_human))
					(if
						(:doc "The resolver marks configuration errors with source 1.")
						(u32.eq (struct.get (local invocation) source) 1u32)
						(then (return (call report_source (borrow-shared (local project_file)) (local error) (struct.get (local invocation) start)
							(struct.get (local invocation) end) (borrow-shared (local invalid_config)) (borrow-shared (local config)) (local human)))))
					(return (call report_argv (local error) (struct.get (local invocation) argv_index) (borrow-shared (local invalid_arguments)) (local human)))))
			(let style (call command_setting (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) 1u32 (call project_compiler_rule 0i32)))
			(let human (u32.eq (struct.get (local style) scalar) 1u32))
			(return (call execute_build (borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) (local human)))))

	(fn run_native_command
		(:doc `Handle version directly and send compilation arguments to the native build driver.`)
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(if
				(:doc "With exactly one user argument the host byte arena is its entire spelling.")
				(bool.and (i32.eq (array.len (local argv)) 1i32)
					(call is_version_argument (borrow-shared (local bytes))))
				(then (return (call print_version))))
			(return (call run_native_build (borrow-shared (local bytes)) (borrow-shared (local argv))))))
)
