(module native_cli_command
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve a native invocation and run cc or bin from one explicit entry.

	Use the resolver's original argument rows to lend the source path,
	output target, and profile to the driver. An optional wovec.jsonc
	in the current directory contributes the selected project profile.`)

	(use wove-file "./diagnostics.wove"
		(only report_argv report_project (value project_file) (value explicit_target_required)
			(value invalid_arguments) (value invalid_config) (value unreadable_file)))
	(use wove-file "./version.wove" (only is_version_argument print_version))
	(use wove-file "./source.wove" (only compile_input))
	(use wove-file "./bin/arguments.wove" (only write_probe_options))
	(use wove-file "./bin/build.wove" (only compile_binary))
	(use wove-file "./files.wove" (only file_stamp file_is_absent read_source_file))
	(use wove-file "../cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "../cli/command/args.wove" (only first_command_argument (type CommandArgument)))
	(use wove-file "../cli/command/resolve.wove" (only resolve_command command_setting (type CommandInvocation)))
	(use wove-file "../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))

	(let explicit_bin_target "bin requires one explicit source and an explicit output target")
	(let clang_required "bin currently requires clang")

	(fn report_required_target
		(:doc `Keep the explicit-operand diagnostic specific to the selected command.`)
		(params (bin bool) (index i32)) (returns i32)
		(body
			(if (local bin) (then (return (call report_argv 12u32 (local index) (borrow-shared (local explicit_bin_target))))))
			(return (call report_argv 12u32 (local index) (borrow-shared (local explicit_target_required))))))

	(fn execute_build
		(:doc `Pass the resolved single source, explicit output, and validated profile to compilation.`)
		(params (bytes (shared-slice u8)) (config (shared-slice u8)) (invocation CommandInvocation) (arguments (shared-slice CommandArgument))
			(nodes (shared-slice JsonNode)) (settings (shared-slice ProjectSetting)))
		(returns i32)
		(body
			(let command (record.get (local invocation) command))
			(let bin (u32.eq (local command) 2u32))
			(let operands (record.get (local invocation) operands))
			(let rows (record.get (local invocation) rows))
			(if
				(:doc "Only cc and bin consume one explicit source operand in this driver.")
				(bool.or (bool.not (bool.or (u32.eq (local command) 1u32) (local bin)))
					(i32.eq (local operands) 0i32))
				(then (return (call report_required_target (local bin) 0i32))))
			(let first (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -1i32))
			(if
				(:doc "Point at the first extra source operand when the caller supplies several.")
				(i32.lt 1i32 (local operands))
				(then
					(let extra (call first_command_argument (borrow-shared (local arguments))
						(i32.add.wrapping (local first) 1i32) (local rows) -1i32))
					(return (call report_required_target (local bin)
						(record.get (slice.load (local arguments) (local extra)) argv_index)))))
			(let output (call command_setting (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) 3u32 19i32))
			(if
				(:doc "The target must come from an explicit build.output option such as -o.")
				(bool.not (u32.eq (record.get (local output) origin) 2u32))
				(then (return (call report_required_target (local bin) 0i32))))
			(let checked (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -5i32))
			(if
				(:doc "A check-only invocation must never publish a C unit.")
				(bool.and (bool.not (i32.lt (local checked) 0i32))
					(u32.eq (record.get (slice.load (local arguments) (local checked)) scalar) 1u32))
				(then (return (call report_argv 12u32
					(record.get (slice.load (local arguments) (local checked)) argv_index) (borrow-shared (local explicit_target_required))))))
			(let input (slice.load (local arguments) (local first)))
			(let target (slice.load (local arguments) (record.get (local output) row)))
			(let profile (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -2i32))
			(let-mut start 0i32)
			(let-mut end 0i32)
			(if
				(:doc "An omitted profile names the default retained tree. A named profile was validated by resolve_command.")
				(bool.not (i32.lt (local profile) 0i32))
				(then
					(let selection (slice.load (local arguments) (local profile)))
					(set (local start) (record.get (local selection) start))
					(set (local end) (record.get (local selection) end))))
			(let extent (u64.add.wrapping (int.convert u64 (slice.len (local bytes)))
				(u64.add.wrapping (int.convert u64 (slice.len (local config))) (int.convert u64 (local rows)))))
			(let width (u64.add.wrapping 256u64 (u64.shl (local extent) 2i32)))
			(let-mut capacity 1i32)
			(if
				(:doc "Bound option packing before allocating its native byte view.")
				(bool.not (u64.lt 2147483647u64 (local width)))
				(then (set (local capacity) (int.convert i32 (local width)))))
			(let-mut options (array.alloc u8 (local capacity)))
			(let-mut option_end (call write_probe_options (borrow-shared (local bytes)) (borrow-shared (local config))
				(local invocation) (borrow-shared (local arguments)) (borrow-shared (local nodes))
				(borrow-shared (local settings)) (local bin) (borrow-mut (local options))))
			(if
				(:doc "An unterminated byte preserves a packing failure until an optional selection needs the probe.")
				(i32.lt (local option_end) 0i32)
				(then
					(slice.store (local options) 0i32 1u8)
					(set (local option_end) 1i32)))
			(if
				(:doc `The first native build path launches Clang. Diagnose other selections at the option's value.`)
				(local bin)
				(then
					(let tool (call first_command_argument (borrow-shared (local arguments)) 0i32 (local rows) -6i32))
					(if
						(:doc `Only an explicit GCC selection differs from the Clang default.`)
						(bool.and (i32.lt -1i32 (local tool))
							(u32.eq (record.get (slice.load (local arguments) (local tool)) scalar) 1u32))
						(then (return (call report_argv 12u32 (record.get (slice.load (local arguments) (local tool)) argv_index)
							(borrow-shared (local clang_required))))))
					(return (call compile_binary
						(borrow-shared (slice.range (local bytes) (record.get (local input) start) (record.get (local input) end)))
						(borrow-shared (slice.range (local bytes) (record.get (local target) start) (record.get (local target) end)))
						(borrow-shared (slice.range (local bytes) (local start) (local end)))
						(record.get (local input) argv_index) (record.get (local target) argv_index)
						(borrow-shared (slice.range (local options) 0i32 (local option_end)))
						(borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
						(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings))))))
			(let no_stage (array.alloc u8 0i32))
			(return (call compile_input
				(borrow-shared (slice.range (local bytes) (record.get (local input) start) (record.get (local input) end)))
				(borrow-shared (slice.range (local bytes) (record.get (local target) start) (record.get (local target) end)))
				(borrow-shared (slice.range (local bytes) (local start) (local end))) (record.get (local invocation) mode)
				(borrow-shared (local no_stage)) (borrow-shared (slice.range (local options) 0i32 (local option_end)))
				(record.get (local input) argv_index) (record.get (local target) argv_index)))))

	(fn run_native_build
		(:doc `Read the optional project and resolve the host argv before opening the requested source.`)
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared (local project_file))))
			(let size (record.get (local stamp) length))
			(let has_config (bool.not (call file_is_absent (local stamp))))
			(if
				(:doc "Only a genuinely absent project falls back to built-in defaults.")
				(bool.and (local has_config) (i32.lt (local size) 0i32))
				(then (return (call report_project 64u32 0i32 0i32 (borrow-shared (local unreadable_file))))))
			(let-mut length 0i32)
			(if
				(:doc "Size the Wove-owned config view from the optional file.")
				(local has_config)
				(then (set (local length) (local size))))
			(let-mut config (array.alloc u8 (local length)))
			(if
				(:doc "Read the exact project bytes before passing them to the resolver.")
				(local has_config)
				(then
					(let read (call read_source_file (borrow-shared (local project_file)) (local stamp) (borrow-mut (local config))))
					(if
						(:doc "Read failures belong to the project file.")
						(bool.not (local read))
						(then (return (call report_project 64u32 0i32 0i32 (borrow-shared (local unreadable_file))))))))
			(let capacity (i32.add.wrapping (local length) 1i32))
			(let-mut nodes (array.alloc JsonNode (local capacity)))
			(let-mut settings (array.alloc ProjectSetting (local capacity)))
			(let-mut arguments (array.alloc CommandArgument (slice.len (local argv))))
			(let invocation (call resolve_command (borrow-shared (local bytes)) (borrow-shared (local argv))
				(borrow-shared (local config)) (local has_config)
				(borrow-mut (local nodes)) (borrow-mut (local settings)) (borrow-mut (local arguments))))
			(let error (record.get (local invocation) error))
			(if
				(:doc "Preserve either the argv index or the original JSONC span from command resolution.")
				(u32.lt 0u32 (local error))
				(then
					(if
						(:doc "The resolver marks configuration errors with source 1.")
						(u32.eq (record.get (local invocation) source) 1u32)
						(then (return (call report_project (local error) (record.get (local invocation) start)
							(record.get (local invocation) end) (borrow-shared (local invalid_config))))))
					(return (call report_argv (local error) (record.get (local invocation) argv_index) (borrow-shared (local invalid_arguments))))))
			(return (call execute_build (borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings))))))

	(fn run_native_command
		(:doc `Handle version directly and send compilation arguments to the native build driver.`)
		(params (bytes (shared-slice u8)) (argv (shared-slice ArgSpan)))
		(returns i32)
		(body
			(if
				(:doc "With exactly one user argument the host byte arena is its entire spelling.")
				(bool.and (i32.eq (slice.len (local argv)) 1i32)
					(call is_version_argument (borrow-shared (local bytes))))
				(then (return (call print_version))))
			(return (call run_native_build (borrow-shared (local bytes)) (borrow-shared (local argv))))))
)
