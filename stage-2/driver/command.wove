(module native_cli_command
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve a native invocation to check explicit entries or build one entry.

	Use the resolver's original argument rows to lend the source path,
	output target, and profile to the driver. An optional wovec.jsonc
	in the current directory contributes the selected project profile.`)

	(use wove-file "./diagnostics.wove"
		(only report_argv report_file report_source (value project_file) (value explicit_target_required)
			(value invalid_arguments) (value invalid_config) (value unreadable_file) (value non_utf8_source) (value invalid_target)))
	(use wove-file "./version.wove" (only is_version_argument print_version))
	(use wove-file "./output.wove" (only retained_c_path valid_output_target))
	(use wove-file "./protection.wove" (only protect_destinations no_destination_protection protected_input report_input_collision (type BuildProtection)))
	(use wove-file "../source/scan.wove" (only admit_source))
	(use wove-file "../source/target.wove" (only default_selection (value library_mode) (type SelectionContext)))
	(use wove-file "./source.wove" (only compile_input))
	(use wove-file "./arguments.wove" (only frontend_capacity write_probe_options))
	(use wove-file "./target.wove" (only effective_selection))
	(use wove-file "./bin/library.wove" (only configured_library_entry default_library_path public_header_path public_header_state))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../io/stdio.wove" (only write_stderr_line))
	(use wove-file "./bin/build.wove" (only compile_binary))
	(use wove-file "./bin/links.wove" (only check_link_inputs))
	(use wove-file "./files.wove" (only file_stamp file_is_absent read_source_file path_identity same_path_identity))
	(use wove-file "../cli/argv.wove" (only (type ArgSpan)))
	(use wove-file "../cli/command/args.wove" (only first_command_argument (type CommandArgument)))
	(use wove-file "../cli/command/resolve.wove" (only resolve_command command_setting (type CommandInvocation)))
	(use wove-file "../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../config/schema.wove" (only project_compiler_rule))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))

	(let host_arguments_failed "runtime error: could not capture host arguments")
	(let no_project_source "")
	(let explicit_bin_target "bin requires one explicit source and an explicit output target")
	(let invalid_library_target "shared libraries require a Linux or macOS target")
	(let invalid_public_header "cannot replace the shared library's public header")
	(let explicit_check_source "cc --check requires at least one explicit source")

	(fn report_required_target
		(:doc `Keep the explicit-operand diagnostic specific to the selected command.`)
		(params (bin bool) (index i32) (human bool)) (returns i32)
		(body
			(if bin (then (return (call report_argv 12u32 index (borrow-shared explicit_bin_target) human))))
			(return (call report_argv 12u32 index (borrow-shared explicit_target_required) human))))

	(fn admit_source_path
		(:doc "Require the UTF-8 path spelling used by source and argv diagnostics.")
		(params (path (shared-array u8)) (index i32) (human bool)) (returns i32)
		(body
			(if
				(:doc "Point an invalid path at its original operand before a file read.")
				(i32:lt -1i32 (call admit_source (borrow-shared path)))
				(then (return (call report_argv 3u32 index (borrow-shared non_utf8_source) human))))
			(return 0i32)))

	(fn check_entries
		(:doc "Check each explicit entry in operand order and retain the highest reported exit status.")
		(:expect (tests "stage-2/cli/native/check.tsv") (issues "gh:wove-lang/wove:94"))
		(params (bytes (shared-array u8)) (arguments (shared-array CommandArgument)) (first i32) (rows i32)
			(options (shared-array u8)) (context SelectionContext) (no_output (shared-array u8)) (protection BuildProtection) (human bool))
		(returns i32)
		(body
			(let-mut row first)
			(let-mut status 0i32)
			(while
				(:doc "Each graph reports its own failure and leaves subsequent entries available for checking.")
				(i32:lt -1i32 row)
				(body
					(let input (arguments.get row))
					(let start input/start)
					(let end input/end)
					(let-mut result (call admit_source_path (borrow-shared (bytes.range start end))
						input/argv_index human))
					(if
						(:doc "Only admitted path spellings can be used to open the source graph.")
						(i32:eqz result)
						(then (set result (call compile_input
							(borrow-shared (bytes.range start end))
							(borrow-shared no_output) (borrow-shared no_output) (borrow-shared no_output)
								(borrow-shared options) (borrow-shared no_output) context protection -1i32 (bool true) 0i32 human))))
					(if
						(:doc "Preserve a diagnostic stream failure even if later source checks produce ordinary failures.")
						(i32:lt status result)
						(then (set status result)))
					(set row (call first_command_argument (borrow-shared arguments)
						(i32:inc row) rows -1i32))))
			(return status)))

	(fn execute_cc
		(:doc "Forward the same resolved probe options to cc and check-only compilation.")
		(params (first i32) (retained (shared-array u8)) (protection BuildProtection) (target_index i32)
			(check_only bool) (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool))
		(returns i32)
		(body
			(let no_stage (array:alloc u8 0i32))
			(let capacity (call frontend_capacity bytes.len config.len invocation/rows 0u64))
			(let-mut options (array:alloc u8 capacity))
			(let frontend (call write_probe_options (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes)
				(borrow-shared settings) (borrow-shared no_stage) (bool false) (borrow-mut options)))
			(let end frontend/probe_end)
			(let context (call effective_selection (borrow-shared (options.range 0i32 end))))
			(if
				(:doc "Every explicit check entry uses the same resolved target and probe options.")
				check_only
				(then (return (call check_entries (borrow-shared bytes) (borrow-shared arguments)
					first invocation/rows
					(borrow-shared (options.range 0i32 end)) context
					(borrow-shared no_stage) protection human))))
			(let input (arguments.get first))
			(return (call compile_input
				(borrow-shared (bytes.range input/start input/end))
				(borrow-shared retained) (borrow-shared no_stage) (borrow-shared no_stage)
				(borrow-shared (options.range 0i32 end)) (borrow-shared no_stage) context
				protection target_index (bool false) 0i32 human))))

	(fn select_library_context
		(:doc "Resolve the real frontend target before computing a library's platform-specific destination.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))) (returns SelectionContext)
		(body
			(let no_stage (array:alloc u8 0i32))
			(let capacity (call frontend_capacity bytes.len config.len invocation/rows 0u64))
			(let-mut options (array:alloc u8 capacity))
			(let frontend (call write_probe_options (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes)
				(borrow-shared settings) (borrow-shared no_stage) (bool true) (borrow-mut options)))
			(let context (call effective_selection (borrow-shared (options.range 0i32 frontend/probe_end))))
			(return (struct:new SelectionContext (mode library_mode) (os context/os)
				(arch context/arch) (deployment context/deployment)))))

	(fn execute_build
		(:doc `Pass the resolved source and profile to checking or compilation.`)
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation) (arguments (shared-array CommandArgument))
			(nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting)) (human bool))
		(returns i32)
		(body
			(let command invocation/command)
			(let bin (u32:eq command 2u32))
			(let operands invocation/operands)
			(let rows invocation/rows)
			(let checked (call first_command_argument (borrow-shared arguments) 0i32 rows -5i32))
			(let check_only (bool:and (i32:lt -1i32 checked)
				(u32:eq (struct:get (arguments.get checked) scalar) 1u32)))
			(let first (call first_command_argument (borrow-shared arguments) 0i32 rows -1i32))
			(if
				(:doc "Check mode accepts every explicit input and has no publication destination.")
				check_only
				(then
					(if
						(:doc "Report the missing source before preparing options for the entry checks.")
						(i32:ltz first)
						(then (return (call report_argv 12u32 0i32 (borrow-shared explicit_check_source) human))))
					(let no_output (array:alloc u8 0i32))
					(return (call execute_cc first (borrow-shared no_output)
						(call no_destination_protection) -1i32 (bool true)
						(borrow-shared bytes) (borrow-shared config) invocation
						(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) human))))
			(if
				(:doc "Ordinary compilation takes one explicit source with cc or bin.")
				(bool:or (bool:not (bool:or (u32:eq command 1u32) bin))
					(i32:eqz operands))
				(then (return (call report_required_target bin 0i32 human))))
			(if
				(:doc "Point at the first extra source operand when the caller supplies several.")
				(i32:lt 1i32 operands)
				(then
					(let extra (call first_command_argument (borrow-shared arguments)
						(i32:inc first) rows -1i32))
					(return (call report_required_target bin
						(struct:get (arguments.get extra) argv_index) human))))
			(let output (call command_setting invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) 3u32 19i32))
			(let input (arguments.get first))
			(let path_start input/start)
			(let path_end input/end)
			(let path (borrow-shared (bytes.range path_start path_end)))
			(let library (bool:and bin (call configured_library_entry (borrow-shared path)
				(borrow-shared config) invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings))))
			(let explicit_output (u32:eq output/origin 2u32))
			(if
				(:doc "Only an explicitly configured shared library has an implicit destination.")
				(bool:not (bool:or explicit_output library))
				(then (return (call report_required_target bin 0i32 human))))
			(let profile (call first_command_argument (borrow-shared arguments) 0i32 rows -2i32))
			(let-mut start 0i32)
			(let-mut end 0i32)
			(if
				(:doc "An omitted profile names the default retained tree. A named profile was validated by resolve_command.")
				(i32:not-ltz profile)
				(then
					(let selection (arguments.get profile))
					(set start selection/start)
					(set end selection/end)))
			(let-mut target_index input/argv_index)
			(let admitted (call admit_source_path (borrow-shared path) target_index human))
			(if (i32:gtz admitted) (then (return admitted)))
			(let-mut context (call default_selection 0u32))
			(if
				(:doc "Use the selected build profile and the effective C target for a configured library.")
				library
				(then
					(set context (call select_library_context (borrow-shared bytes) (borrow-shared config)
						invocation (borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)))
					(if
						(:doc "The loader and linker contracts are defined for ELF Linux and Mach-O macOS.")
						(u8:eqz context/os)
						(then (return (call report_argv 70u32 target_index (borrow-shared invalid_library_target) human))))))
			(let-mut target (array:alloc u8 0i32))
			(if
				(:doc "Keep -o authoritative while allowing the platform-specific library default.")
				explicit_output
				(then
					(let slot (arguments.get output/row))
					(set target_index slot/argv_index)
					(let value (borrow-shared (bytes.range slot/start slot/end)))
					(set target (array:alloc u8 value.len))
					(let copied (call append_bytes (borrow-shared value) (borrow-mut target) 0i32)))
				(else (set target (call default_library_path (borrow-shared path) context/os))))
			(if
				(:doc "The final target component must fit the retained publication layout.")
				(bool:not (call valid_output_target (borrow-shared target)))
				(then (return (call report_argv 3u32 target_index (borrow-shared invalid_target) human))))
			(let retained (call retained_c_path (borrow-shared target)
				(borrow-shared (bytes.range start end)) invocation/mode))
			(let-mut header (array:alloc u8 0i32))
			(if
				(:doc "Check the public header destination before opening either output for publication.")
				library
				(then
					(set header (call public_header_path (borrow-shared target) context/os))
					(if
						(:doc "Never replace a handwritten header or merge the header and binary identities.")
						(bool:or (i32:eqz header.len)
							(bool:or (i32:ltz (call public_header_state (borrow-shared header)))
								(call same_path_identity (call path_identity (borrow-shared target))
									(call path_identity (borrow-shared header)))))
						(then (return (call report_argv 69u32 target_index (borrow-shared invalid_public_header) human))))))
			(let protection (call protect_destinations (borrow-shared target) (borrow-shared retained) (borrow-shared header)))
			(if
				(:doc `Both publication paths protect the requested entry and its filesystem aliases.`)
				(call protected_input (borrow-shared (bytes.range path_start path_end)) protection)
				(then (return (call report_input_collision (borrow-shared (bytes.range path_start path_end)) human))))
			(if
				(:doc `An existing project file supplies the invocation even when no named profile is selected.`)
				(call protected_input (borrow-shared project_file) protection)
				(then (return (call report_input_collision (borrow-shared project_file) human))))
			(if
				(:doc `Use the same checked destinations for native compilation and retained C.`)
				bin
				(then
					(let link_conflict (call check_link_inputs (borrow-shared bytes) (borrow-shared config)
						invocation (borrow-shared arguments) (borrow-shared nodes)
						(borrow-shared settings) protection human))
					(if (i32:gtz link_conflict) (then (return link_conflict)))
					(return (call compile_binary
						(borrow-shared (bytes.range path_start path_end))
						(borrow-shared target) (borrow-shared header)
						(borrow-shared retained) protection target_index context
						(borrow-shared bytes) (borrow-shared config) invocation
						(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) human))))
			(return (call execute_cc first
				(borrow-shared retained) protection target_index (bool false)
				(borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) human))))

	(fn report_project_read
		(:doc "Report project I/O first, using any explicit diagnostic switch accepted by the argv parser.")
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan))) (returns i32)
		(body
			(let-mut nodes (array:alloc JsonNode 0i32))
			(let-mut settings (array:alloc ProjectSetting 0i32))
			(let-mut arguments (array:alloc CommandArgument argv.len))
			(let invocation (call resolve_command (borrow-shared bytes) (borrow-shared argv)
				(borrow-shared no_project_source) (bool false) (borrow-mut nodes) (borrow-mut settings)
				(borrow-mut arguments)))
			(return (call report_file (borrow-shared project_file) 64u32 0i32 0i32
				(borrow-shared unreadable_file) invocation/argv_human))))

	(fn run_native_build
		(:doc `Read the optional project and resolve the host argv before opening the requested source.`)
		(params (bytes (shared-array u8)) (argv (shared-array ArgSpan)))
		(returns i32)
		(body
			(let stamp (call file_stamp (borrow-shared project_file)))
			(let size stamp/length)
			(let has_config (bool:not (call file_is_absent stamp)))
			(if
				(:doc "Only a genuinely absent project falls back to built-in defaults.")
				(bool:and has_config (i32:ltz size))
				(then (return (call report_project_read (borrow-shared bytes) (borrow-shared argv)))))
			(let-mut length 0i32)
			(if
				(:doc "Size the Wove-owned config view from the optional file.")
				has_config
				(then (set length size)))
			(let-mut config (array:alloc u8 length))
			(if
				(:doc "Read the exact project bytes before passing them to the resolver.")
				has_config
				(then
					(let read (call read_source_file (borrow-shared project_file) stamp (borrow-mut config)))
					(if
						(:doc "Read failures belong to the project file.")
						(bool:not read)
						(then (return (call report_project_read (borrow-shared bytes) (borrow-shared argv)))))))
			(let capacity (i32:inc length))
			(let-mut nodes (array:alloc JsonNode capacity))
			(let-mut settings (array:alloc ProjectSetting capacity))
			(let-mut arguments (array:alloc CommandArgument argv.len))
			(let invocation (call resolve_command (borrow-shared bytes) (borrow-shared argv)
				(borrow-shared config) has_config
				(borrow-mut nodes) (borrow-mut settings) (borrow-mut arguments)))
			(let error invocation/error)
			(if
				(:doc "Preserve either the argv index or the original JSONC span from command resolution.")
				(u32:gtz error)
				(then
					(let human invocation/argv_human)
					(if
						(:doc "The resolver marks configuration errors with source 1.")
						(u32:eq invocation/source 1u32)
						(then (return (call report_source (borrow-shared project_file) error invocation/start
							invocation/end (borrow-shared invalid_config) (borrow-shared config) human))))
					(return (call report_argv error invocation/argv_index (borrow-shared invalid_arguments) human))))
			(let style (call command_setting invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) 1u32 (call project_compiler_rule 0i32)))
			(let human (u32:eq style/scalar 1u32))
			(return (call execute_build (borrow-shared bytes) (borrow-shared config) invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) human))))

	(fn run_native_command
		(:doc "Preserve the native parser's user-only argument spans by packing its private byte arena.")
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(let count argv.len)
			(let-mut first 0i32)
			(if (i32:gtz count) (then (set first 1i32)))
			(if
				(:doc "Version handling can inspect its sole user argument directly.")
				(i32:eq count 2i32)
				(then
					(let argument (argv.get 1i32))
					(if
						(:doc "The version command needs neither a byte arena nor a project file.")
						(call is_version_argument (borrow-shared argument))
						(then (return (call print_version))))))
			(let-mut index first)
			(let-mut length 0i32)
			(while
				(:doc "Measure only user arguments before reserving the parser's storage.")
				(i32:lt index count)
				(body
					(let width (array:len (argv.get index)))
					(if
						(:doc "The private parser uses signed byte offsets into the combined arena.")
						(i32:lt (i32:sub 2147483647i32 length) width)
						(then
							(let written (call write_stderr_line (borrow-shared host_arguments_failed)))
							(return 1i32)))
					(set length (i32:add length width))
					(set index (i32:inc index))))
			(let-mut bytes (array:alloc u8 length))
			(let-mut spans (array:alloc ArgSpan (i32:sub count first)))
			(let-mut offset 0i32)
			(set index first)
			(while
				(:doc "Each original user argument gets one parser span, including empty strings.")
				(i32:lt index count)
				(body
					(let argument (argv.get index))
					(let end (call append_bytes (borrow-shared argument) (borrow-mut bytes) offset))
					(spans.set (i32:sub index first)
						(struct:new ArgSpan (start offset) (end end)))
					(set offset end)
					(set index (i32:inc index))))
			(return (call run_native_build (borrow-shared bytes) (borrow-shared spans)))))
)
