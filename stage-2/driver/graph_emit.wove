(module driver_graph_emit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Keep one checked entry graph alive through embed loading, C sizing, and publication in both disk drivers.")

	(use (:pragma (cfg (not bootstrap))) wove-file "./bin/library.wove" (only stage_library_abi))
	(use wove-file "./assets.wove" (only load_graph_assets))
	(use (:pragma (cfg (not bootstrap))) wove-file "./input_files.wove" (only check_header_inputs check_asset_inputs))
	(use (:pragma (cfg (not bootstrap))) wove-file "./output.wove" (only publish_input))
	(use (:pragma (cfg (not bootstrap))) wove-file "./protection.wove" (only (type BuildProtection)))
	(use (:pragma (cfg (not bootstrap))) wove-file "./availability.wove" (only check_optional_c_members))
	(use (:pragma (cfg (not bootstrap))) wove-file "./numeric_target.wove" (only check_numeric_targets))
	(use (:pragma (cfg (not bootstrap))) wove-file "./paths.wove" (only directory_width))
	(use wove-file "../scalar/generics/workspace.wove" (only graph_function_workspace can_grow_function_workspace (value function_workspace_full)))
	(use wove-file "../emit/graph.wove" (only check_graph_plan bind_entry_assets write_graph_c (type GraphPlan)))
	(use wove-file "../emit/embeds.wove" (only request_module_embeds))
	(use wove-file "../scalar/graph.wove" (only layout_trees signature_capacity))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../scalar/plan.wove" (only (type CallSite)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "../source/graph.wove" (only copy_graph_bindings (type GraphModule) (type GraphBinding) (type GraphResult)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct
		(:doc "Bootstrap publishes to stdout and has no protected destination identities.")
		(:pragma (cfg bootstrap))
		BuildProtection (fields))
	(struct EntryEmission (fields (status i32) (file i32) (start i32) (end i32) (error u32) (asset bool)))

	(fn entry_status
		(:doc "Return the exit status from complete publication or an already reported input conflict.")
		(params (status i32)) (returns EntryEmission)
		(body (return (struct.new EntryEmission (status (local status)) (file -1i32)
			(start 0i32) (end 0i32) (error 0u32) (asset (bool false))))))

	(fn entry_failure
		(:doc "Return a diagnostic for the driver to report using its original location format.")
		(params (file i32) (start i32) (end i32) (error u32) (asset bool)) (returns EntryEmission)
		(body (return (struct.new EntryEmission (status 1i32) (file (local file)) (start (local start))
			(end (local end)) (error (local error)) (asset (local asset))))))

	(fn asset_failure
		(:doc "Convert a host asset error from arena offsets to its defining file's byte coordinates.")
		(params (files (shared-array SuppliedFile)) (result EmbedCheck)) (returns EntryEmission)
		(body
			(let file (struct.get (local result) file))
			(let base (struct.get (array.load (local files) (local file)) source_start))
			(return (call entry_failure (local file)
				(i32.sub (struct.get (local result) start) (local base))
				(i32.sub (struct.get (local result) end) (local base))
				(struct.get (local result) error) (bool true)))))

	(fn check_entry_inputs
		(:doc "Check native destination aliases after semantic validation and before opening assets.")
		(:pragma (cfg (not bootstrap)))
		(params (canonical (shared-array u8)) (staged (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(bindings (shared-array GraphBinding)) (requests (shared-array EmbedAsset)) (protection BuildProtection) (count i32) (human bool))
		(returns i32)
		(body
			(if
				(:doc "cc checks the selected headers here. bin checks Clang's inputs in the private build.")
				(i32.eqz (array.len (local staged)))
				(then
					(let conflict (call check_header_inputs (borrow-shared (local canonical)) (borrow-shared (local arena))
						(borrow-shared (local files)) (borrow-shared (local bindings)) (local protection) (local human)))
					(if (i32.gtz (local conflict)) (then (return (local conflict))))))
			(if (i32.eqz (local count)) (then (return 0i32)))
			(return (call check_asset_inputs (borrow-shared (local canonical)) (borrow-shared (local arena))
				(borrow-shared (local files)) (borrow-shared (local requests)) (local protection) (local human)))))

	(fn check_entry_inputs
		(:doc "Bootstrap publishes to stdout and has no destination aliases to protect.")
		(:pragma (cfg bootstrap))
		(params (canonical (shared-array u8)) (staged (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(bindings (shared-array GraphBinding)) (requests (shared-array EmbedAsset)) (protection BuildProtection) (count i32) (human bool))
		(returns i32)
		(body (return 0i32)))

	(fn publish_entry
		(:doc "Publish the complete unit through the ordinary native output path.")
		(:pragma (cfg (not bootstrap)))
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (target_index i32)
			(output (shared-array u8)) (human bool)) (returns i32)
		(body (return (call publish_input (borrow-shared (local path)) (borrow-shared (local destination))
			(borrow-shared (local staged)) (local target_index) (borrow-shared (local output)) (local human)))))

	(fn publish_entry
		(:doc "Send the complete Bootstrap unit to stdout.")
		(:pragma (cfg bootstrap))
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (target_index i32)
			(output (shared-array u8)) (human bool)) (returns i32)
		(body
			(if (call bootstrap_write (borrow-shared (local output)) (bool false)) (then (return 0i32)))
			(return 1i32)))

	(fn stage_library_abi
		(:doc "The bootstrap driver never emits a public shared library.")
		(:pragma (cfg bootstrap))
		(params (unit (shared-array u8)) (arena (shared-array u8)) (nodes (shared-array SourceNode))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (os u8))
		(returns bool)
		(body (return (bool false))))

	(fn finish_entry
		(:doc "Bind the loaded asset bytes, size the unit using the checked plan, and publish only complete C.")
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (target_index i32) (check_only bool)
			(arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (tests (shared-array DiscoveredTest)) (plan GraphPlan) (requests (shared-array EmbedAsset)) (human bool))
		(returns EntryEmission)
		(body
			(let embedded (call bind_entry_assets (array.len (local arena)) (borrow-shared (local files))
				(borrow-shared (local requests)) (borrow-mut (local expressions))))
			(if
				(:doc "An invalid loaded range keeps the original embed operand's diagnostic.")
				(u32.gtz (struct.get (local embedded) error))
				(then (return (call entry_failure (struct.get (local embedded) file)
					(struct.get (local embedded) start) (struct.get (local embedded) end) (struct.get (local embedded) error) (bool false)))))
			(let-mut empty (array.alloc u8 0i32))
			(let measured (call write_graph_c (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local trees)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local statements))
				(borrow-shared (local records)) (borrow-shared (local expressions)) 0i32 (local plan)
				(borrow-shared (local tests)) (bool false) (local check_only) (bool true) -1i32 (borrow-mut (local empty))))
			(if
				(:doc "Report an invalid include or an oversized unit before allocating output.")
				(u32.gtz (struct.get (local measured) error))
				(then (return (call entry_failure (struct.get (local measured) file)
					(struct.get (local measured) start) (struct.get (local measured) end) (struct.get (local measured) error) (bool false)))))
			(if
				(:doc "The checked plan, assets, and header declarations complete a check-only run.")
				(local check_only)
				(then (return (call entry_status 0i32))))
			(let size (struct.get (local measured) count))
			(let-mut output (array.alloc u8 (local size)))
			(let written (call write_graph_c (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local trees)) (borrow-shared (local nodes))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local statements))
				(borrow-shared (local records)) (borrow-shared (local expressions)) 0i32 (local plan)
				(borrow-shared (local tests)) (bool false) (bool false) (bool false) (local size) (borrow-mut (local output))))
			(if
				(:doc "Retain the emitter's failure and its original location.")
				(u32.gtz (struct.get (local written) error))
				(then (return (call entry_failure (struct.get (local written) file)
					(struct.get (local written) start) (struct.get (local written) end) (struct.get (local written) error) (bool false)))))
			(if
				(:doc "The native link consumes a checked header and symbol list staged with the same C unit.")
				(bool.and (u8.not-eqz (struct.get (local plan) library_os))
					(bool.not (call stage_library_abi (borrow-shared (local staged)) (borrow-shared (local arena))
						(borrow-shared (local nodes)) (borrow-shared (local functions)) (borrow-shared (local parameters))
						(struct.get (local plan) library_os))))
				(then (return (call entry_failure 0i32 0i32 0i32 69u32 (bool false)))))
			(return (call entry_status (call publish_entry (borrow-shared (local path)) (borrow-shared (local destination))
				(borrow-shared (local staged)) (local target_index)
				(borrow-shared (array.range (local output) 0i32 (struct.get (local written) count))) (local human))))))

	(fn check_entry_frontend
		(:doc "Check target-dependent numeric support before querying optional C declarations that may use those formats.")
		(:pragma (cfg (not bootstrap)))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(options (shared-array u8)) (staged (shared-array u8)) (canonical (shared-array u8)) (checked bool)) (returns EntryEmission)
		(body
			(let width (call directory_width (borrow-shared (local staged))))
			(if
				(:doc "Only a successful semantic plan has checked type rows.")
				(local checked)
				(then
					(let numeric (call check_numeric_targets (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local bindings)) (borrow-shared (local nodes)) (borrow-shared (local expressions))
						(borrow-shared (local statements)) (borrow-shared (local functions)) (borrow-shared (local parameters))
						(borrow-shared (local records)) (borrow-shared (local options))
						(borrow-shared (array.range (local staged) 0i32 (local width)))))
					(if
						(:doc "Report an unsupported format before an optional header can fail to declare it.")
						(u32.gtz (struct.get (local numeric) error))
						(then
							(let site (struct.get (local numeric) site))
							(return (call entry_failure (struct.get (local site) file) (struct.get (local site) start)
								(struct.get (local site) end) (struct.get (local numeric) error) (bool false)))))))
			(let available (call check_optional_c_members (borrow-shared (local arena))
				(borrow-shared (local files)) (borrow-shared (local bindings)) (borrow-shared (local canonical))
				(borrow-shared (local options)) (borrow-shared (array.range (local staged) 0i32 (local width)))))
			(if
				(:doc "Keep the requesting name's span for the existing optional declaration diagnostics.")
				(u32.gtz (struct.get (local available) error))
				(then (return (call entry_failure (struct.get (local available) file) (struct.get (local available) start)
					(struct.get (local available) end) (struct.get (local available) error) (bool false)))))
			(return (call entry_status 0i32))))

	(fn check_entry_frontend
		(:doc "Bootstrap emits the compiler without starting a target frontend.")
		(:pragma (cfg bootstrap))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(options (shared-array u8)) (staged (shared-array u8)) (canonical (shared-array u8)) (checked bool)) (returns EntryEmission)
		(body (return (call entry_status 0i32))))

	(fn emit_entry_graph
		(:doc "Own the checked graph tables while loading embeds and writing the C unit in either disk driver.")
		(:expect
			(tests "stage-2/cli/native/emission/check.py" "stage-2/cli/native/discovery/check.py")
			(issues "gh:wove-lang/wove:354"))
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (bindings (shared-array GraphBinding)) (resolved GraphResult) (human bool))
		(returns EntryEmission)
		(body
			(let-mut trees (array.alloc ScalarTree (array.len (local files))))
			(let layout (call layout_trees (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-shared (local bindings)) (borrow-mut (local trees))))
			(if
				(:doc "A layout limit belongs to the original source file.")
				(u32.gtz (struct.get (local layout) error))
				(then (return (call entry_failure (struct.get (local layout) file) (struct.get (local layout) start)
					(struct.get (local layout) end) (struct.get (local layout) error) (bool false)))))
			(let workspace (call graph_function_workspace (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local trees)) (struct.get (local layout) rows) (call signature_capacity (borrow-shared (local bindings)))))
			(if
				(:doc "The checked arrays must hold each private declaration before emitting C.")
				(u32.gtz (struct.get (local workspace) error))
				(then (return (call entry_failure 0i32 0i32 0i32 (struct.get (local workspace) error) (bool false)))))
			(let-mut rows (struct.get (local workspace) rows))
			(let-mut signatures (struct.get (local workspace) functions))
			(while
				(:doc "Grow only after a checked function request outgrows the initial speculative workspace.")
				(i32.lt -1i32 (local rows))
				(body
					(let result (call emit_entry_workspace (borrow-shared (local path)) (borrow-shared (local canonical))
						(borrow-shared (local destination)) (borrow-shared (local staged)) (borrow-shared (local probe_options))
						(local protection) (local target_index) (local check_only) (borrow-shared (local arena)) (borrow-shared (local files)) (borrow-shared (local modules))
						(borrow-shared (local bindings)) (local resolved) (local human) (borrow-shared (local trees)) (local rows) (local signatures)))
					(if
						(:doc "A clone shortage precedes all embedding and publication side effects.")
						(u32.not-eq (struct.get (local result) error) (local function_workspace_full))
						(then (return (local result))))
					(if
						(:doc "Preserve the application span once the requested capacity no longer fits.")
						(bool.not (call can_grow_function_workspace (local rows) (local signatures)))
						(then (return (call entry_failure (struct.get (local result) file) (struct.get (local result) start)
							(struct.get (local result) end) 16u32 (bool false)))))
					(set (local rows) (i32.add (local rows) (local rows)))
					(set (local signatures) (i32.add (local signatures) (local signatures)))))
			(return (call entry_failure 0i32 0i32 0i32 16u32 (bool false)))))

	(fn emit_entry_workspace
		(:doc "Check and emit the disk graph with one private workspace allocation.")
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (resolved_bindings (shared-array GraphBinding)) (resolved GraphResult) (human bool)
			(trees (shared-array ScalarTree)) (rows i32) (signatures i32)) (returns EntryEmission)
		(body
			(let-mut bindings (array.alloc GraphBinding (array.len (local resolved_bindings))))
			(call copy_graph_bindings (borrow-shared (local resolved_bindings)) (borrow-mut (local bindings)))
			(let test_executable (u32.eq (struct.get (local resolved) mode) 2u32))
			(let-mut test_capacity 0i32)
			(if (local test_executable) (then (set (local test_capacity) (local signatures))))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let-mut functions (array.alloc ScalarFunction (local signatures)))
			(let-mut parameters (array.alloc ScalarParameter (local rows)))
			(let-mut records (array.alloc ScalarRecord (local rows)))
			(let-mut statements (array.alloc ScalarStatement (local rows)))
			(let-mut expressions (array.alloc ScalarExpression (local rows)))
			(let-mut tests (array.alloc DiscoveredTest (local test_capacity)))
			(let-mut sites (array.alloc CallSite (local rows)))
			(let plan (call check_graph_plan (borrow-shared (local arena)) (borrow-shared (local files))
				(borrow-shared (local modules)) (borrow-mut (local bindings)) (local resolved) 0i32 (local test_executable)
				(borrow-shared (local trees)) (borrow-mut (local nodes)) (borrow-mut (local functions)) (borrow-mut (local parameters))
				(borrow-mut (local records)) (borrow-mut (local statements)) (borrow-mut (local expressions))
				(borrow-mut (local sites)) (borrow-mut (local tests))))
			(let error (struct.get (local plan) error))
			(if
				(:doc "Retry a workspace shortage before making any frontend observations.")
				(u32.eq (local error) (local function_workspace_full))
				(then (return (call entry_failure (struct.get (local plan) file) (struct.get (local plan) start)
					(struct.get (local plan) end) (local error) (bool false)))))
			(let frontend (call check_entry_frontend (borrow-shared (local arena)) (borrow-shared (local files)) (borrow-shared (local bindings))
				(borrow-shared (local nodes)) (borrow-shared (local expressions)) (borrow-shared (local statements))
				(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
				(borrow-shared (local probe_options)) (borrow-shared (local staged)) (borrow-shared (local canonical)) (u32.eqz (local error))))
			(if
				(:doc "A failed frontend check stops before opening embeds or writing C.")
				(u32.gtz (struct.get (local frontend) error))
				(then (return (local frontend))))
			(if
				(:doc "Keep semantic diagnostics ahead of all embed and publication effects.")
				(u32.gtz (local error))
				(then (return (call entry_failure (struct.get (local plan) file) (struct.get (local plan) start)
					(struct.get (local plan) end) (local error) (bool false)))))
			(let-mut requests (array.alloc EmbedAsset (local rows)))
			(let count (call request_module_embeds (borrow-shared (local expressions)) (borrow-mut (local requests))))
			(if
				(:doc "Check destination aliases when the driver will publish the unit.")
				(bool.not (local check_only))
				(then
					(let conflict (call check_entry_inputs (borrow-shared (local canonical))
						(borrow-shared (local staged)) (borrow-shared (local arena)) (borrow-shared (local files))
						(borrow-shared (local bindings)) (borrow-shared (local requests)) (local protection) (local count) (local human)))
					(if (i32.gtz (local conflict)) (then (return (call entry_status (local conflict)))))))
			(if
				(:doc "An entry without embeds already has a complete arena.")
				(i32.eqz (local count))
				(then (return (call finish_entry (borrow-shared (local path)) (borrow-shared (local destination))
					(borrow-shared (local staged)) (local target_index) (local check_only) (borrow-shared (local arena)) (borrow-shared (local files))
					(borrow-shared (local bindings)) (borrow-shared (local trees)) (borrow-shared (local nodes)) (borrow-shared (local functions))
					(borrow-shared (local parameters)) (borrow-shared (local records)) (borrow-shared (local statements))
					(borrow-mut (local expressions)) (borrow-shared (local tests)) (local plan) (borrow-shared (local requests)) (local human)))))
			(let-mut empty (array.alloc u8 0i32))
			(let measured (call load_graph_assets (borrow-shared (local canonical)) (borrow-shared (local arena))
				(borrow-shared (local files)) (borrow-mut (local requests)) (borrow-mut (local empty)) (bool false)))
			(if
				(:doc "An unavailable embed keeps the defining file's original operand span.")
				(u32.gtz (struct.get (local measured) error))
				(then (return (call asset_failure (borrow-shared (local files)) (local measured)))))
			(let-mut extended (array.alloc u8 (struct.get (local measured) count)))
			(let copied (call append_bytes (borrow-shared (local arena)) (borrow-mut (local extended)) 0i32))
			(if
				(:doc "Every checked source offset still addresses the original byte prefix.")
				(i32.not-eq (local copied) (array.len (local arena)))
				(then (return (call entry_status 1i32))))
			(let loaded (call load_graph_assets (borrow-shared (local canonical)) (borrow-shared (local arena))
				(borrow-shared (local files)) (borrow-mut (local requests)) (borrow-mut (local extended)) (bool true)))
			(if
				(:doc "A file that changes during the read cannot reach publication.")
				(u32.gtz (struct.get (local loaded) error))
				(then (return (call asset_failure (borrow-shared (local files)) (local loaded)))))
			(return (call finish_entry (borrow-shared (local path)) (borrow-shared (local destination))
				(borrow-shared (local staged)) (local target_index) (local check_only) (borrow-shared (local extended)) (borrow-shared (local files))
				(borrow-shared (local bindings)) (borrow-shared (local trees)) (borrow-shared (local nodes)) (borrow-shared (local functions))
				(borrow-shared (local parameters)) (borrow-shared (local records)) (borrow-shared (local statements))
				(borrow-mut (local expressions)) (borrow-shared (local tests)) (local plan) (borrow-shared (local requests)) (local human)))))

	(fn emit_bootstrap_entry
		(:doc "Use the canonical entry recorded in the arena when publishing a Bootstrap unit.")
		(:pragma (cfg bootstrap))
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(bindings (shared-array GraphBinding)) (resolved GraphResult))
		(returns EntryEmission)
		(body
			(let entry (array.load (local files) 0i32))
			(let start (struct.get (local entry) path_start))
			(let end (struct.get (local entry) path_end))
			(let empty (array.alloc u8 0i32))
			(return (call emit_entry_graph (borrow-shared (array.range (local arena) (local start) (local end)))
				(borrow-shared (array.range (local arena) (local start) (local end)))
				(borrow-shared (local empty)) (borrow-shared (local empty)) (borrow-shared (local empty)) (struct.new BuildProtection) 0i32 (bool false)
				(borrow-shared (local arena)) (borrow-shared (local files)) (borrow-shared (local modules))
				(borrow-shared (local bindings)) (local resolved) (bool false)))))
)
