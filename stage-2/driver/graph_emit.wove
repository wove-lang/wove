(module driver_graph_emit
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Keep one checked entry graph alive through embed loading, C sizing, and publication.")

	(use wove-file "./bin/library.wove" (only stage_library_abi))
	(use wove-file "./graph_units.wove" (only stage_checked_units))
	(use wove-file "../c/arguments.wove" (only (value executable_string_marker)))
	(use wove-file "./assets.wove" (only load_graph_assets))
	(use wove-file "./input_files.wove" (only check_header_inputs check_asset_inputs))
	(use wove-file "./output.wove" (only publish_input))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./availability.wove" (only check_optional_c_members))
	(use wove-file "./numeric_target.wove" (only check_numeric_targets))
	(use wove-file "./null_calls.wove" (only check_serial_nulls check_numbered_nulls))
	(use wove-file "../emit/c_null.wove" (only named_null_argument))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "../scalar/generics/workspace.wove" (only graph_function_workspace can_grow_function_workspace (value function_workspace_full)))
	(use wove-file "../emit/graph.wove" (only check_graph_plan bind_entry_assets write_graph_c (type GraphPlan)))
	(use wove-file "../emit/embeds.wove" (only request_module_embeds))
	(use wove-file "../scalar/graph.wove" (only layout_trees signature_capacity))
	(use wove-file "../scalar/trees.wove" (only (type ScalarTree)))
	(use wove-file "../scalar/plan.wove" (only (type CallSite)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/tests.wove" (only (type DiscoveredTest)))
	(use wove-file "../source/graph.wove" (only copy_graph_bindings (type GraphModule) (type GraphBinding) (type GraphResult)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset) (type EmbedCheck)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct EntryEmission (fields (status i32) (file i32) (start i32) (end i32) (error u32) (asset bool)))

	(fn entry_status
		(:doc "Return the exit status from complete publication or an already reported input conflict.")
		(params (status i32)) (returns EntryEmission)
		(body (return (EntryEmission.new (status status) (file -1i32)
			(start 0i32) (end 0i32) (error 0u32) (asset (bool false))))))

	(fn entry_failure
		(:doc "Return a diagnostic for the driver to report using its original location format.")
		(params (file i32) (start i32) (end i32) (error u32) (asset bool)) (returns EntryEmission)
		(body (return (EntryEmission.new (status 1i32) (file file) (start start)
			(end end) (error error) (asset asset)))))

	(fn asset_failure
		(:doc "Convert a host asset error from arena offsets to its defining file's byte coordinates.")
		(params (files (shared-array SuppliedFile)) (result EmbedCheck)) (returns EntryEmission)
		(body
			(let file result/file)
			(let base (struct:get (files.get file) source_start))
			(return (call entry_failure file
				(result/start.sub base)
				(result/end.sub base)
				result/error (bool true)))))

	(fn check_entry_inputs
		(:doc "Check native destination aliases after semantic validation and before opening assets.")
		(params (canonical (shared-array u8)) (staged (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(bindings (shared-array GraphBinding)) (requests (shared-array EmbedAsset)) (protection BuildProtection) (count i32) (human bool))
		(returns i32)
		(body
			(if
				(:doc "cc checks the selected headers here. bin checks Clang's inputs in the private build.")
				staged.len.eqz
				(then
					(let conflict (call check_header_inputs (borrow-shared canonical) (borrow-shared arena)
						(borrow-shared files) (borrow-shared bindings) protection human))
					(if conflict.gtz (then (return conflict)))))
			(if count.eqz (then (return 0i32)))
			(return (call check_asset_inputs (borrow-shared canonical) (borrow-shared arena)
				(borrow-shared files) (borrow-shared requests) protection human))))

	(fn publish_entry
		(:doc "Publish the complete unit through the ordinary native output path.")
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (target_index i32)
			(output (shared-array u8)) (human bool)) (returns i32)
		(body (return (call publish_input (borrow-shared path) (borrow-shared destination)
			(borrow-shared staged) target_index (borrow-shared output) human))))

	(fn has_named_null_uses
		(:doc "Only a checked native null operand requires generating C and rechecking its use.")
		(params (expressions (shared-array ScalarExpression))) (returns bool)
		(body
			(for
				(:doc "The checked plan records native null operands at their original source rows.")
				(let expression) (borrow-shared expressions)
				(body
					(if (call named_null_argument expression) (then (return (bool true))))))
			(return (bool false))))

	(fn finish_entry
		(:doc "Bind the loaded asset bytes, size the unit using the checked plan, and publish only complete C.")
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (debug_source (shared-array u8))
			(probe_options (shared-array u8)) (target_index i32) (check_only bool) (partition i32)
			(arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(trees (shared-array ScalarTree)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord)) (statements (shared-array ScalarStatement))
			(expressions (mut-array ScalarExpression)) (tests (shared-array DiscoveredTest)) (plan GraphPlan) (requests (shared-array EmbedAsset)) (human bool))
		(returns EntryEmission)
		(body
			(let embedded (call bind_entry_assets arena.len (borrow-shared files)
				(borrow-shared requests) (borrow-mut expressions)))
			(if
				(:doc "An invalid loaded range keeps the original embed operand's diagnostic.")
				embedded/error.gtz
				(then (return (call entry_failure embedded/file
					embedded/start embedded/end embedded/error (bool false)))))
			(let verify_null (call has_named_null_uses (borrow-shared expressions)))
			(let skip_c (check_only.and verify_null.not))
			(let-mut empty (array:alloc u8 0i32))
			(let measured (call write_graph_c (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared trees) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared expressions) 0i32 plan
				(borrow-shared tests) (bool false) skip_c (bool true) -1i32 (borrow-mut empty)))
			(if
				(:doc "Report an invalid include or an oversized unit before allocating output.")
				measured/error.gtz
				(then (return (call entry_failure measured/file
					measured/start measured/end measured/error (bool false)))))
			(if
				(:doc "A check-only run without selected null operands is complete after semantic checking.")
				skip_c
				(then (return (call entry_status 0i32))))
			(let size measured/count)
			(let-mut prefix 0i32)
			(if
				(:doc "Retained strings require the native driver to publish an executable image.")
				plan/retained_strings
				(then (set prefix executable_string_marker.len)))
			(let total (prefix.add size))
			(let-mut output (array:alloc u8 total))
			(if
				(:doc "Keep the lifetime requirement in the generated C preamble.")
				prefix.gtz
				(then
					(set prefix (call append_bytes (borrow-shared executable_string_marker)
						(borrow-mut output) 0i32))))
			(let written (call write_graph_c (borrow-shared arena) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared trees) (borrow-shared nodes)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared statements)
				(borrow-shared records) (borrow-shared expressions) 0i32 plan
				(borrow-shared tests) (bool false) (bool false) (bool false) size
				(borrow-mut (output.range prefix total))))
			(if
				(:doc "Retain the emitter's failure and its original location.")
				written/error.gtz
				(then (return (call entry_failure written/file
					written/start written/end written/error (bool false)))))
			(if
				(:doc "The native link consumes a checked header and symbol list staged with the same C unit.")
				(bool:and (check_only.not.and plan/library_os.not-eqz)
					(bool:not (call stage_library_abi (borrow-shared staged) (borrow-shared arena)
						(borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters)
						plan/library_os)))
				(then (return (call entry_failure 0i32 0i32 0i32 69u32 (bool false)))))
			(let-mut split 0i32)
			(if
				(:doc "The private serial pathname must still be vacant while the opt-in audit observes it.")
				(check_only.not.and (i32:lt 1i32 partition))
				(then
					(set split (call stage_checked_units (borrow-shared staged) (borrow-shared probe_options) partition target_index human
						(borrow-shared arena) (borrow-shared files) (borrow-shared bindings) (borrow-shared trees)
						(borrow-shared nodes) (borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
						(borrow-shared statements) (borrow-shared expressions) (borrow-shared tests) plan))
					(if split.gtz (then (return (call entry_status split))))))
			(if
				(:doc "Verify the native expansion in the unit that will be handed to the frontend.")
				verify_null
				(then
					(let checked (if
						(:doc "A numbered plan supplies its own translation-unit context for each call.")
						split.ltz
						(then (call check_numbered_nulls (borrow-shared probe_options) (borrow-shared staged)
							(i32:sub 0i32 split) plan/library_os.not-eqz
							(borrow-shared files) (borrow-shared nodes)))
						(else (call check_serial_nulls (borrow-shared probe_options) (borrow-shared staged)
							(borrow-shared canonical) (borrow-shared debug_source)
							(borrow-shared (output.range 0i32 (prefix.add written/count)))
							(borrow-shared files) (borrow-shared nodes)))))
					(if
						(:doc "Keep a non-null expansion at the exact original Wove operand.")
						checked/error.gtz
						(then
							(let site checked/site)
							(return (call entry_failure site/file site/start
								site/end checked/error (bool false)))))))
			(if check_only (then (return (call entry_status 0i32))))
			(let published (call publish_entry (borrow-shared path) (borrow-shared destination)
				(borrow-shared staged) target_index
				(borrow-shared (output.range 0i32 (prefix.add written/count))) human))
			(if published.not-eqz (then (return (call entry_status published))))
			(return (call entry_status split))))

	(fn check_entry_frontend
		(:doc "Check target-dependent numeric support before querying optional C declarations that may use those formats.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(options (shared-array u8)) (libraries (shared-array u8)) (staged (shared-array u8)) (canonical (shared-array u8)) (checked bool)) (returns EntryEmission)
		(body
			(let width (call directory_width (borrow-shared staged)))
			(if
				(:doc "Only a successful semantic plan has checked type rows.")
				checked
				(then
					(let numeric (call check_numeric_targets (borrow-shared arena) (borrow-shared files)
						(borrow-shared bindings) (borrow-shared nodes) (borrow-shared expressions)
						(borrow-shared statements) (borrow-shared functions) (borrow-shared parameters)
						(borrow-shared records) (borrow-shared options) (borrow-shared libraries)
						(borrow-shared (staged.range 0i32 width))))
					(if
						(:doc "Report an unsupported format before an optional header can fail to declare it.")
						numeric/error.gtz
						(then
							(let site numeric/site)
							(return (call entry_failure site/file site/start
								site/end numeric/error (bool false)))))))
			(let available (call check_optional_c_members (borrow-shared arena)
				(borrow-shared files) (borrow-shared bindings) (borrow-shared canonical)
				(borrow-shared options) (borrow-shared (staged.range 0i32 width))))
			(if
				(:doc "Keep the requesting name's span for the existing optional declaration diagnostics.")
				available/error.gtz
				(then (return (call entry_failure available/file available/start
					available/end available/error (bool false)))))
			(return (call entry_status 0i32))))

	(fn emit_entry_graph
		(:doc "Own the checked graph tables while loading embeds and writing the C unit.")
		(:expect
			(tests "stage-2/cli/native/emission/check.py" "stage-2/cli/native/discovery/check.py")
			(issues "gh:wove-lang/wove:354"))
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (debug_source (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (partition i32) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (bindings (shared-array GraphBinding)) (resolved GraphResult) (human bool))
		(returns EntryEmission)
		(body
			(let-mut trees (array:alloc ScalarTree files.len))
			(let layout (call layout_trees (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-shared bindings) (borrow-mut trees)))
			(if
				(:doc "A layout limit belongs to the original source file.")
				layout/error.gtz
				(then (return (call entry_failure layout/file layout/start
					layout/end layout/error (bool false)))))
			(let workspace (call graph_function_workspace (borrow-shared arena) (borrow-shared files)
				(borrow-shared trees) layout/rows (call signature_capacity (borrow-shared bindings))))
			(if
				(:doc "The checked arrays must hold each private declaration before emitting C.")
				workspace/error.gtz
				(then (return (call entry_failure 0i32 0i32 0i32 workspace/error (bool false)))))
			(let-mut rows workspace/rows)
			(let-mut signatures workspace/functions)
			(while
				(:doc "Grow only after a checked function request outgrows the initial speculative workspace.")
				(i32:lt -1i32 rows)
				(body
					(let result (call emit_entry_workspace (borrow-shared path) (borrow-shared canonical)
						(borrow-shared destination) (borrow-shared staged) (borrow-shared debug_source) (borrow-shared probe_options)
						(borrow-shared probe_libraries)
						protection target_index check_only partition (borrow-shared arena) (borrow-shared files) (borrow-shared modules)
						(borrow-shared bindings) resolved human (borrow-mut trees) rows signatures))
					(if
						(:doc "A clone shortage precedes all embedding and publication side effects.")
						(result/error.not-eq function_workspace_full)
						(then (return result)))
					(if
						(:doc "Preserve the application span once the requested capacity no longer fits.")
						(bool:not (call can_grow_function_workspace rows signatures))
						(then (return (call entry_failure result/file result/start
							result/end 16u32 (bool false)))))
					(set rows (rows.add rows))
					(set signatures (signatures.add signatures))))
			(return (call entry_failure 0i32 0i32 0i32 16u32 (bool false)))))

	(fn emit_entry_workspace
		(:doc "Check and emit the disk graph with one private workspace allocation.")
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8)) (debug_source (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (partition i32) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(modules (shared-array GraphModule)) (resolved_bindings (shared-array GraphBinding)) (resolved GraphResult) (human bool)
			(trees (mut-array ScalarTree)) (rows i32) (signatures i32)) (returns EntryEmission)
		(body
			(let-mut bindings (array:alloc GraphBinding resolved_bindings.len))
			(call copy_graph_bindings (borrow-shared resolved_bindings) (borrow-mut bindings))
			(let test_executable (resolved/mode.eq 2u32))
			(let-mut test_capacity 0i32)
			(if test_executable (then (set test_capacity signatures)))
			(let-mut nodes (array:alloc SourceNode rows))
			(let-mut functions (array:alloc ScalarFunction signatures))
			(let-mut parameters (array:alloc ScalarParameter rows))
			(let-mut records (array:alloc ScalarRecord rows))
			(let-mut statements (array:alloc ScalarStatement rows))
			(let-mut expressions (array:alloc ScalarExpression rows))
			(let-mut tests (array:alloc DiscoveredTest test_capacity))
			(let-mut sites (array:alloc CallSite rows))
			(let plan (call check_graph_plan (borrow-shared arena) (borrow-shared files)
				(borrow-shared modules) (borrow-mut bindings) resolved 0i32 test_executable
				(borrow-mut trees) (borrow-mut nodes) (borrow-mut functions) (borrow-mut parameters)
				(borrow-mut records) (borrow-mut statements) (borrow-mut expressions)
				(borrow-mut sites) (borrow-mut tests)))
			(let error plan/error)
			(if
				(:doc "Retry a workspace shortage before making any frontend observations.")
				(error.eq function_workspace_full)
				(then (return (call entry_failure plan/file plan/start
					plan/end error (bool false)))))
			(let frontend (call check_entry_frontend (borrow-shared arena) (borrow-shared files) (borrow-shared bindings)
				(borrow-shared nodes) (borrow-shared expressions) (borrow-shared statements)
				(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
				(borrow-shared probe_options) (borrow-shared probe_libraries) (borrow-shared staged) (borrow-shared canonical) error.eqz))
			(if
				(:doc "A failed frontend check stops before opening embeds or writing C.")
				frontend/error.gtz
				(then (return frontend)))
			(if
				(:doc "Keep semantic diagnostics ahead of all embed and publication effects.")
				error.gtz
				(then (return (call entry_failure plan/file plan/start
					plan/end error (bool false)))))
			(let-mut requests (array:alloc EmbedAsset rows))
			(let count (call request_module_embeds (borrow-shared expressions) (borrow-mut requests)))
			(if
				(:doc "Check destination aliases when the driver will publish the unit.")
				check_only.not
				(then
					(let conflict (call check_entry_inputs (borrow-shared canonical)
						(borrow-shared staged) (borrow-shared arena) (borrow-shared files)
						(borrow-shared bindings) (borrow-shared requests) protection count human))
					(if conflict.gtz (then (return (call entry_status conflict))))))
			(if
				(:doc "An entry without embeds already has a complete arena.")
				count.eqz
				(then (return (call finish_entry (borrow-shared path) (borrow-shared canonical) (borrow-shared destination)
					(borrow-shared staged) (borrow-shared debug_source) (borrow-shared probe_options) target_index check_only partition (borrow-shared arena) (borrow-shared files)
					(borrow-shared bindings) (borrow-shared trees) (borrow-shared nodes) (borrow-shared functions)
					(borrow-shared parameters) (borrow-shared records) (borrow-shared statements)
					(borrow-mut expressions) (borrow-shared tests) plan (borrow-shared requests) human))))
			(let-mut empty (array:alloc u8 0i32))
			(let measured (call load_graph_assets (borrow-shared canonical) (borrow-shared arena)
				(borrow-shared files) (borrow-mut requests) (borrow-mut empty) (bool false)))
			(if
				(:doc "An unavailable embed keeps the defining file's original operand span.")
				measured/error.gtz
				(then (return (call asset_failure (borrow-shared files) measured))))
			(let-mut extended (array:alloc u8 measured/count))
			(let copied (call append_bytes (borrow-shared arena) (borrow-mut extended) 0i32))
			(if
				(:doc "Every checked source offset still addresses the original byte prefix.")
				(copied.not-eq arena.len)
				(then (return (call entry_status 1i32))))
			(let loaded (call load_graph_assets (borrow-shared canonical) (borrow-shared arena)
				(borrow-shared files) (borrow-mut requests) (borrow-mut extended) (bool true)))
			(if
				(:doc "A file that changes during the read cannot reach publication.")
				loaded/error.gtz
				(then (return (call asset_failure (borrow-shared files) loaded))))
			(return (call finish_entry (borrow-shared path) (borrow-shared canonical) (borrow-shared destination)
				(borrow-shared staged) (borrow-shared debug_source) (borrow-shared probe_options) target_index check_only partition (borrow-shared extended) (borrow-shared files)
				(borrow-shared bindings) (borrow-shared trees) (borrow-shared nodes) (borrow-shared functions)
				(borrow-shared parameters) (borrow-shared records) (borrow-shared statements)
				(borrow-mut expressions) (borrow-shared tests) plan (borrow-shared requests) human))))
)
