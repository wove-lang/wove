(module driver_prototype_probes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Certify checked native prototypes after the implicit compiler headers.")

	(use wove-file "./snapshot_probes.wove" (only write_field_snapshot_probe))
	(use wove-file "../emit/c_arguments.wove" (only c_symbol_text))
	(use wove-file "../emit/c_prototype.wove" (only write_c_prototype_formals))
	(use wove-file "../emit/owners.wove" (only native_owner_contract write_native_destructor_name write_native_type))
	(use wove-file "../emit/records.wove" (only write_value_type))
	(use wove-file "../emit/runtime.wove" (only write_c_number))
	(use wove-file "../emit/text.wove" (only c_literal_text))
	(use wove-file "../emit/units.wove" (only numbered_field_snapshot_call numbered_fixed_pointer_owner_call numbered_literal_array_call
		numbered_nullable_integer_call numbered_pointer_owner_consume numbered_vector_pair_call))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/native_owner_types.wove" (only native_owner_type))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))

	(let prototype_witness "typedef char wove_native_prototype_probe_")
	(let prototype_match "[_Generic(&(")
	(let prototype_separator "),")
	(let prototype_formals "(*)(")
	(let prototype_end "):1,default:-1)];\n")
	(let pointer_owner_witness 2u8)
	(let owner_probe "typedef char wove_native_pointer_owner_probe_")
	(let owner_pointer_match "[(__builtin_classify_type((")
	(let owner_pointer_end ")0)==5&&_Generic(&(")
	(let owner_drop_type "),__typeof__((")
	(let owner_drop_argument ")((")
	(let owner_drop_formals ")0))(*)(")
	(let owner_probe_end "):1,default:0))?1:-1];\n")

	(fn checked_replay_prototype
		(:doc "Select calls that need both an exact typed prototype and the effective native declaration.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))) (returns bool)
		(body
			(return (bool:or (call numbered_field_snapshot_call (borrow-shared arena) (borrow-shared nodes) function
					(borrow-shared parameters))
				(bool:or (call numbered_literal_array_call function (borrow-shared parameters) (borrow-shared records))
					(bool:or (call numbered_nullable_integer_call function (borrow-shared parameters) (borrow-shared records))
						(bool:or (call numbered_fixed_pointer_owner_call (borrow-shared arena) (borrow-shared nodes)
								function (borrow-shared parameters))
							(bool:or (call numbered_pointer_owner_consume (borrow-shared arena) (borrow-shared nodes)
									function (borrow-shared parameters))
								(call numbered_vector_pair_call (borrow-shared arena) (borrow-shared nodes) function
									(borrow-shared parameters) (borrow-shared records))))))))))

	(fn write_prototype_check
		(:doc "Require the exact adapted C parameter and result types used by the emitted call.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let symbol (nodes.get (struct:get function name)))
			(let-mut width (call c_literal_text (borrow-shared prototype_witness) (borrow-mut output) offset writing))
			(set width (call write_c_number (borrow-mut output) width (struct:get function declaration) writing))
			(set width (call c_literal_text (borrow-shared prototype_match) (borrow-mut output) width writing))
			(set width (call c_symbol_text (borrow-shared arena) symbol (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared prototype_separator) (borrow-mut output) width writing))
			(set width (call write_value_type (borrow-shared arena) (borrow-shared nodes) (borrow-shared records)
				(struct:get function result) (borrow-mut output) width 0i32 writing))
			(set width (call c_literal_text (borrow-shared prototype_formals) (borrow-mut output) width writing))
			(set width (call write_c_prototype_formals (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared parameters) function (borrow-mut output) width 0i32 writing))
			(return (call c_literal_text (borrow-shared prototype_end) (borrow-mut output) width writing))))

	(fn write_prototype_probes
		(:doc "Check each selected native prototype in all serial and numbered header contexts.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width offset)
			(for
				(:doc "Use the same eligible declarations as the independent function address witnesses.")
				(let index) (range 0i32 (call checked_function_count (borrow-shared functions)))
				(body
					(let function (functions.get index))
					(if (i32:not-ltz (struct:get function body)) (then (continue)))
					(if
						(:doc "A snapshot observes its original native result type before copying to the Wove owner.")
						(call numbered_field_snapshot_call (borrow-shared arena) (borrow-shared nodes) function
							(borrow-shared parameters))
						(then
							(set width (call write_field_snapshot_probe (borrow-shared arena) (borrow-shared nodes)
								function (parameters.get (struct:get function params)) (borrow-mut output) width writing))
							(continue)))
					(if
						(:doc "Reject a pointer or qualifier mismatch by making the private typedef ill-formed.")
						(call checked_replay_prototype (borrow-shared arena) (borrow-shared nodes) function
							(borrow-shared parameters) (borrow-shared records))
						(then (set width (call write_prototype_check (borrow-shared arena) (borrow-shared nodes)
							function (borrow-shared parameters) (borrow-shared records) (borrow-mut output) width writing))))))
			(return width)))

	(fn write_pointer_owner_probe
		(:doc "Require an actual pointer type and an exact one-argument destructor with its native result type.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (declaration i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let owner (call native_owner_contract (borrow-shared arena) (borrow-shared nodes)
				(call native_owner_type declaration)))
			(let literal (nodes.get (struct:get owner native)))
			(let-mut width (call c_literal_text (borrow-shared owner_probe) (borrow-mut output) offset writing))
			(set width (call write_c_number (borrow-mut output) width declaration writing))
			(set width (call c_literal_text (borrow-shared owner_pointer_match) (borrow-mut output) width writing))
			(set width (call write_native_type (borrow-shared arena) literal (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared owner_pointer_end) (borrow-mut output) width writing))
			(set width (call write_native_destructor_name (borrow-shared arena) (borrow-shared nodes)
				owner (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared owner_drop_type) (borrow-mut output) width writing))
			(set width (call write_native_destructor_name (borrow-shared arena) (borrow-shared nodes)
				owner (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared owner_drop_argument) (borrow-mut output) width writing))
			(set width (call write_native_type (borrow-shared arena) literal (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared owner_drop_formals) (borrow-mut output) width writing))
			(set width (call write_native_type (borrow-shared arena) literal (borrow-mut output) width writing))
			(return (call c_literal_text (borrow-shared owner_probe_end) (borrow-mut output) width writing))))

	(fn write_pointer_owner_probes
		(:doc "Prove the exact destructor of each distinct native pointer owner selected by the graph.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (owners (shared-array u8))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width offset)
			(for
				(:doc "An alias and multiple constructors share the same original owner declaration.")
				(let declaration) (range 0i32 owners.len)
				(body
					(if
						(:doc "Storage layout and destruction are checked by their existing witnesses.")
						(u8:eq (owners.get declaration) pointer_owner_witness)
						(then (set width (call write_pointer_owner_probe (borrow-shared arena) (borrow-shared nodes)
							declaration (borrow-mut output) width writing))))))
			(return width)))
)
