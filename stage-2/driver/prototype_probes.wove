(module driver_prototype_probes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Certify checked native prototypes after the implicit compiler headers.")

	(use wove-file "../emit/c_arguments.wove" (only c_symbol_text))
	(use wove-file "../emit/c_prototype.wove" (only write_c_prototype_formals))
	(use wove-file "../emit/records.wove" (only write_value_type))
	(use wove-file "../emit/runtime.wove" (only write_c_number))
	(use wove-file "../emit/text.wove" (only c_literal_text))
	(use wove-file "../emit/units.wove" (only numbered_literal_array_call numbered_vector_pair_call))
	(use wove-file "../scalar/function_rows.wove" (only checked_function_count (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))

	(let prototype_witness "typedef char wove_native_prototype_probe_")
	(let prototype_match "[_Generic(&(")
	(let prototype_separator "),")
	(let prototype_formals "(*)(")
	(let prototype_end "):1,default:-1)];\n")

	(fn checked_replay_prototype
		(:doc "Select calls that need both an exact typed prototype and the effective native declaration.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))) (returns bool)
		(body
			(return (bool.or (call numbered_literal_array_call function (borrow-shared parameters) (borrow-shared records))
				(call numbered_vector_pair_call (borrow-shared arena) (borrow-shared nodes) function
					(borrow-shared parameters) (borrow-shared records))))))

	(fn write_prototype_check
		(:doc "Require the exact adapted C parameter and result types used by the emitted call.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let symbol (array.load nodes (struct.get function name)))
			(let-mut width (call c_literal_text (borrow-shared prototype_witness) (borrow-mut output) offset writing))
			(set width (call write_c_number (borrow-mut output) width (struct.get function declaration) writing))
			(set width (call c_literal_text (borrow-shared prototype_match) (borrow-mut output) width writing))
			(set width (call c_symbol_text (borrow-shared arena) symbol (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared prototype_separator) (borrow-mut output) width writing))
			(set width (call write_value_type (borrow-shared arena) (borrow-shared nodes) (borrow-shared records)
				(struct.get function result) (borrow-mut output) width 0i32 writing))
			(set width (call c_literal_text (borrow-shared prototype_formals) (borrow-mut output) width writing))
			(set width (call write_c_prototype_formals (borrow-shared arena) (borrow-shared nodes)
				(borrow-shared records) (borrow-shared parameters) function (borrow-mut output) width 0i32 writing))
			(return (call c_literal_text (borrow-shared prototype_end) (borrow-mut output) width writing))))

	(fn write_prototype_probes
		(:doc "Check each selected native prototype in all serial and numbered header contexts.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (functions (shared-array ScalarFunction))
			(parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width offset)
			(for
				(:doc "Use the same eligible declarations as the independent function address witnesses.")
				(let index) (range 0i32 (call checked_function_count (borrow-shared functions)))
				(body
					(let function (array.load functions index))
					(if (i32.not-ltz (struct.get function body)) (then (continue)))
					(if
						(:doc "Reject a pointer or qualifier mismatch by making the private typedef ill-formed.")
						(call checked_replay_prototype (borrow-shared arena) (borrow-shared nodes) function
							(borrow-shared parameters) (borrow-shared records))
						(then (set width (call write_prototype_check (borrow-shared arena) (borrow-shared nodes)
							function (borrow-shared parameters) (borrow-shared records) (borrow-mut output) width writing))))))
			(return width)))
)
