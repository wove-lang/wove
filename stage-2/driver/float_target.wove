(module native_float_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Locate checked uses of target-dependent floats and verify their native ABI.")

	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "../clang/query.wove" (only query_clang_frontend (type QuerySite)))
	(use wove-file "../clang/index.wove" (only (type ClangDeclaration) (type ClangIndex)))
	(use wove-file "../clang/values.wove" (only clang_probe_value clang_probe_u32))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only form_parts))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only (value f16_type) (value f80_type)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/trees.wove" (only source_span_owner))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/plan.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only array_owner_element is_array_owner is_fixed_array
		is_enum_layout is_payload_enum is_native_record is_place_reference is_record_type is_typed_slice
		member_value_type native_field_type place_reference_target record_index slice_element_type (type ScalarRecord)))
	(use wove-file "../text/match.wove" (only is_three_bytes))

	(struct FloatHints (fields (half bool) (extended bool)))
	(struct FloatSupport (fields (half u32) (extended u32)))
	(struct FloatRejection (fields (site QuerySite) (error u32)))

	(let f16_unavailable 79u32)
	(let f16_probe_failed 80u32)
	(let f80_unavailable 81u32)
	(let f80_probe_failed 82u32)
	(let float_header "<float.h>")
	(let half_fact "wvpr_has_float16")
	(let mantissa_fact "wvpr_long_double_mantissa")

	(fn target_float_keyword
		(:doc "Find a width that depends on the selected frontend's floating ABI.")
		(params (source (shared-array u8)) (start i32)) (returns u32)
		(body
			(if
				(:doc "Binary16 support is independent of the long-double format.")
				(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 49u8 54u8)
				(then (return (local f16_type))))
			(if
				(:doc "Extended precision requires a native long double with a 64-bit significand.")
				(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 56u8 48u8)
				(then (return (local f80_type))))
			(return 0u32)))

	(fn target_float_hints
		(:doc "Find potential floating types, operators, or literals in parsed source atoms.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))) (returns FloatHints)
		(body
			(let-mut index 0i32)
			(let-mut half (bool false))
			(let-mut extended (bool false))
			(while
				(:doc "Hints route candidates through graph checking. Only a checked use can request Clang.")
				(i32.lt (local index) (array.len (local nodes)))
				(body
					(let node (array.load (local nodes) (local index)))
					(let start (struct.get (local node) start))
					(let end (struct.get (local node) end))
					(if
						(:doc "Strings and structured rows cannot themselves name a floating type.")
						(bool.and (u32.eq (struct.get (local node) kind) 1u32)
							(i32.lt 2i32 (i32.sub (local end) (local start))))
						(then
							(let-mut prefix 0u32)
							(if
								(:doc "A leading format is a full type name or the head of a typed operation.")
								(bool.or (i32.eq (i32.sub (local end) (local start)) 3i32)
									(u8.eq (array.load (local source) (i32.add (local start) 3i32)) 46u8))
								(then (set (local prefix) (call target_float_keyword (borrow-shared (local source)) (local start)))))
							(let suffix (call target_float_keyword (borrow-shared (local source)) (i32.sub (local end) 3i32)))
							(set (local half) (bool.or (local half)
								(bool.or (u32.eq (local prefix) (local f16_type)) (u32.eq (local suffix) (local f16_type)))))
							(set (local extended) (bool.or (local extended)
								(bool.or (u32.eq (local prefix) (local f80_type)) (u32.eq (local suffix) (local f80_type)))))
							(if
								(:doc "The graph could require both known facts.")
								(bool.and (local half) (local extended))
								(then (return (struct.new FloatHints (half (bool true)) (extended (bool true))))))))
					(set (local index) (i32.inc (local index)))))
			(return (struct.new FloatHints (half (local half)) (extended (local extended))))))

	(fn has_target_float_hint
		(:doc "Route target-sensitive source atoms through the checked disk graph.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))) (returns bool)
		(body
			(let hints (call target_float_hints (borrow-shared (local source)) (borrow-shared (local nodes))))
			(return (bool.or (struct.get (local hints) half) (struct.get (local hints) extended)))))

	(fn target_float_type
		(:doc "Recognize a required float directly or through a checked array, slice, or reference.")
		(params (records (shared-array ScalarRecord)) (type u32) (wanted u32)) (returns bool)
		(body
			(if (u32.eq (local type) (local wanted)) (then (return (bool true))))
			(if
				(:doc "An owning array carries the type of each aligned element.")
				(call is_array_owner (local type))
				(then (return (call target_float_type (borrow-shared (local records)) (call array_owner_element (local type)) (local wanted)))))
			(if
				(:doc "Typed slices carry their checked element type.")
				(call is_typed_slice (local type))
				(then (return (call target_float_type (borrow-shared (local records))
					(call slice_element_type (borrow-shared (local records)) (local type)) (local wanted)))))
			(if
				(:doc "A native reference retains the exact type of its pointee.")
				(call is_place_reference (local type))
				(then (return (call target_float_type (borrow-shared (local records))
					(call place_reference_target (borrow-shared (local records)) (local type)) (local wanted)))))
			(if
				(:doc "Inspect inline array elements here. Named layout fields have their own original sites.")
				(call is_record_type (local type))
				(then
					(let layout (array.load (local records) (call record_index (local type))))
					(if
						(:doc "Only inline arrays encode element types directly in the layout.")
						(call is_fixed_array (local layout))
						(then (return (call target_float_type (borrow-shared (local records))
							(u32.from-i32 (struct.get (local layout) first)) (local wanted)))))))
			(return (bool false))))

	(fn target_float_field
		(:doc "Find the first emitted member whose checked type requires this format.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(records (shared-array ScalarRecord)) (wanted u32)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Visit checked layouts up to their zero-initialized tail.")
				(i32.lt (local index) (array.len (local records)))
				(body
					(let record (array.load (local records) (local index)))
					(if (i32.eqz (struct.get (local record) name)) (then (return -1i32)))
					(let template (bool.and (i32.lt -1i32 (struct.get (local record) generic))
						(i32.ltz (struct.get (local record) specialization))))
					(let simple_enum (bool.and (call is_enum_layout (local record)) (bool.not (call is_payload_enum (local record)))))
					(if
						(:doc "Only concrete named layouts have source member rows to inspect.")
						(bool.not (bool.or (local template) (bool.or (local simple_enum) (call is_fixed_array (local record)))))
						(then
							(let-mut field (struct.get (local record) first))
							(let-mut ordinal 0i32)
							(while
								(:doc "Use the same checked member types as the C record emitter.")
								(bool.and (i32.lt (local ordinal) (struct.get (local record) count)) (i32.lt -1i32 (local field)))
								(body
									(let node (array.load (local nodes) (local field)))
									(let-mut type 0u32)
									(if
										(:doc "Bridge fields use the resolved C layout instead of the Wove member namespace.")
										(call is_native_record (local record))
										(then (set (local type) (call native_field_type (borrow-shared (local source)) (borrow-shared (local nodes))
											(borrow-shared (local records)) (local record) (local field))))
										(else (set (local type) (call member_value_type (borrow-shared (local source)) (borrow-shared (local nodes))
											(borrow-shared (local records)) (borrow-shared (local bindings)) (local record) (local node)))))
									(if
										(:doc "A type operand preserves the source location even in a specialized layout.")
										(call target_float_type (borrow-shared (local records)) (local type) (local wanted))
										(then
											(let part (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
											(let type_node (struct.get (local part) operands))
											(if (i32.lt -1i32 (local type_node)) (then (return (local type_node))))
											(return (local field))))
									(set (local field) (struct.get (local node) next_sibling))
									(set (local ordinal) (i32.inc (local ordinal)))))))
					(set (local index) (i32.inc (local index)))))
			(return -1i32)))

	(fn target_float_site
		(:doc "Locate the required format in a checked expression, storage declaration, signature, or field.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode)) (bindings (shared-array GraphBinding))
			(expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter))
			(records (shared-array ScalarRecord)) (wanted u32)) (returns i32)
		(body
			(let-mut index 0i32)
			(let-mut storage -1i32)
			(while
				(:doc "Expression and statement rows share their original source node index.")
				(i32.lt (local index) (array.len (local expressions)))
				(body
					(let expr (array.load (local expressions) (local index)))
					(let statement (array.load (local statements) (local index)))
					(if
						(:doc "Prefer a checked expression over its enclosing storage declaration.")
						(call target_float_type (borrow-shared (local records)) (struct.get (local expr) type) (local wanted))
						(then (return (local index))))
					(if
						(:doc "A storage declaration can require the format even with no initializer expression.")
						(bool.and (i32.ltz (local storage))
							(call target_float_type (borrow-shared (local records)) (struct.get (local statement) type) (local wanted)))
						(then (set (local storage) (local index))))
					(set (local index) (i32.inc (local index)))))
			(if (i32.lt -1i32 (local storage)) (then (return (local storage))))
			(set (local index) 0i32)
			(while
				(:doc "An unused function parameter can still require the target ABI.")
				(i32.lt (local index) (array.len (local parameters)))
				(body
					(let param (array.load (local parameters) (local index)))
					(if
						(:doc "The type follows the formal's original name.")
						(call target_float_type (borrow-shared (local records)) (struct.get (local param) type) (local wanted))
						(then
							(let name (struct.get (local param) name))
							(let type (struct.get (array.load (local nodes) (local name)) next_sibling))
							(if (i32.lt -1i32 (local type)) (then (return (local type))))
							(return (local name))))
					(set (local index) (i32.inc (local index)))))
			(set (local index) 0i32)
			(while
				(:doc "Bridge results and unused Wove functions keep their native signatures.")
				(i32.lt (local index) (array.len (local functions)))
				(body
					(let fn_row (array.load (local functions) (local index)))
					(if
						(:doc "Report the original declaration if its result requires the target ABI.")
						(call target_float_type (borrow-shared (local records)) (struct.get (local fn_row) result) (local wanted))
						(then (return (struct.get (local fn_row) declaration))))
					(set (local index) (i32.inc (local index)))))
			(return (call target_float_field (borrow-shared (local source)) (borrow-shared (local nodes))
				(borrow-shared (local bindings)) (borrow-shared (local records)) (local wanted)))))

	(fn target_site
		(:doc "Convert a checked node's arena offsets into its defining file and byte span.")
		(params (files (shared-array SuppliedFile)) (node SourceNode)) (returns QuerySite)
		(body
			(let start (struct.get (local node) start))
			(let file (call source_span_owner (borrow-shared (local files)) (local start) 0i32))
			(let base (struct.get (array.load (local files) (local file)) source_start))
			(return (struct.new QuerySite (file (local file)) (start (i32.sub (local start) (local base)))
				(end (i32.sub (struct.get (local node) end) (local base)))))))

	(fn float_fact_status
		(:doc "Check that the capability enum's exact value describes the required ABI.")
		(params (capture (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (key (shared-array u8))
			(expected u32) (unavailable u32) (failed u32)) (returns u32)
		(body
			(let fact (call clang_probe_u32 (borrow-shared (local capture))
				(call clang_probe_value (borrow-shared (local capture)) (local index) (borrow-shared (local nodes))
					(borrow-shared (local declarations)) (borrow-shared (local names)) (borrow-shared (local key)))))
			(if
				(:doc "Missing or unusable facts cannot decide target support.")
				(bool.or (u32.gtz (struct.get (local fact) error))
					(bool.and (u32.eq (local expected) 1u32) (u32.lt 1u32 (struct.get (local fact) value))))
				(then (return (local failed))))
			(if (u32.eq (struct.get (local fact) value) (local expected)) (then (return 0u32)))
			(return (local unavailable))))

	(fn query_float_support
		(:doc "Read both archive capability facts in one query using the selected frontend options.")
		(params (options (shared-array u8)) (directory (shared-array u8)) (site QuerySite)) (returns FloatSupport)
		(body
			(let program (call clang_program))
			(let empty (array.alloc u8 0i32))
			(let-mut width 1048576i32)
			(while
				(:doc "The same workspace bound as other live Clang probes accommodates forwarded includes.")
				(i32.lt (local width) 33554432i32)
				(body
					(let-mut capture (array.alloc u8 (local width)))
					(let-mut trace (array.alloc u8 (local width)))
					(let-mut nodes (array.alloc JsonNode (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 3i32))))
					(let-mut declarations (array.alloc ClangDeclaration (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 6i32))))
					(let-mut names (array.alloc u8 (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 1i32))))
					(let result (call query_clang_frontend (borrow-shared (local program)) (borrow-shared (local options))
						(borrow-shared (local directory)) (borrow-shared (local empty)) (borrow-shared (local float_header))
						(local site) (borrow-mut (local capture)) (borrow-mut (local nodes))
						(borrow-mut (local declarations)) (borrow-mut (local names)) (borrow-mut (local trace))))
					(let error (struct.get (local result) error))
					(if
						(:doc "Only a successful, indexed capability probe can distinguish availability from failure.")
						(u32.eqz (local error))
						(then
							(let index (struct.get (local result) index))
							(let half (call float_fact_status (borrow-shared (local capture)) (local index)
								(borrow-shared (local nodes)) (borrow-shared (local declarations)) (borrow-shared (local names))
								(borrow-shared (local half_fact)) 1u32 (local f16_unavailable) (local f16_probe_failed)))
							(let extended (call float_fact_status (borrow-shared (local capture)) (local index)
								(borrow-shared (local nodes)) (borrow-shared (local declarations)) (borrow-shared (local names))
								(borrow-shared (local mantissa_fact)) 64u32 (local f80_unavailable) (local f80_probe_failed)))
							(return (struct.new FloatSupport (half (local half)) (extended (local extended))))))
					(if
						(:doc "Only output or index exhaustion can be repaired with a larger workspace.")
						(bool.not (bool.or (u32.eq (local error) 5u32) (u32.eq (local error) 7u32)))
						(then (return (struct.new FloatSupport (half (local f16_probe_failed)) (extended (local f80_probe_failed))))))
					(set (local width) (i32.add (local width) (local width)))))
			(return (struct.new FloatSupport (half (local f16_probe_failed)) (extended (local f80_probe_failed))))))

	(fn check_float_targets
		(:doc "Query Clang once if the checked graph uses any target-sensitive float format.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(options (shared-array u8)) (directory (shared-array u8))) (returns FloatRejection)
		(body
			(let accepted (struct.new FloatRejection (site (struct.new QuerySite (file -1i32) (start 0i32) (end 0i32))) (error 0u32)))
			(let hints (call target_float_hints (borrow-shared (local source)) (borrow-shared (local nodes))))
			(let-mut half -1i32)
			(let-mut extended -1i32)
			(if
				(:doc "A checked binary16 use must resolve on the selected Clang target.")
				(struct.get (local hints) half)
				(then (set (local half) (call target_float_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local f16_type)))))
			(if
				(:doc "An extended-precision use needs a native long double with the requested mantissa.")
				(struct.get (local hints) extended)
				(then (set (local extended) (call target_float_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local f80_type)))))
			(let-mut first (local half))
			(if
				(:doc "Use a real source span to own the shared query, even for a program using only f80.")
				(i32.ltz (local first))
				(then (set (local first) (local extended))))
			(if (i32.ltz (local first)) (then (return (local accepted))))
			(let site (call target_site (borrow-shared (local files)) (array.load (local nodes) (local first))))
			(let support (call query_float_support (borrow-shared (local options)) (borrow-shared (local directory)) (local site)))
			(if
				(:doc "Retain the original binary16 source span when it is the unsupported width.")
				(bool.and (i32.lt -1i32 (local half)) (u32.gtz (struct.get (local support) half)))
				(then (return (struct.new FloatRejection (site (local site)) (error (struct.get (local support) half))))))
			(if
				(:doc "If binary16 passed, report a failed extended-precision check at its own source span.")
				(bool.and (i32.lt -1i32 (local extended)) (u32.gtz (struct.get (local support) extended)))
				(then (return (struct.new FloatRejection (site (call target_site (borrow-shared (local files))
					(array.load (local nodes) (local extended)))) (error (struct.get (local support) extended))))))
			(return (local accepted))))

)
