(module native_cli_disk
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve and emit a native source graph from one entry.

	Let the shared resolver choose the next active Wove edge. Keep the
	loaded snapshots and suspended walk across retries, then emit the
	finished graph after the last edge is resolved.`)

	(use wove-file "./bundled.wove" (only measure_bundled_sources write_bundled_sources))
	(use wove-file "./diagnostics.wove" (only report_source (value invalid_source) (value unreadable_file)))
	(use wove-file "./disk_files.wove" (only load_disk_edge duplicate_disk_failure disk_space (type DiskFile) (type DiskSpace)))
	(use wove-file "./files.wove" (only invalid_file_stamp (type FileStamp)))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./check_reports.wove" (only report_capacity copy_graph_reports remember_graph_report))
	(use wove-file "./graph_storage.wove" (only copy_disk_edges copy_graph_modules copy_graph_imports))
	(use wove-file "./check_graph.wove" (only check_resolved_disk_graph))
	(use wove-file "./graph.wove" (only report_graph_source report_graph_location compile_resolved_graph))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only resolve_disk_graph graph_recoverable (type GraphModule) (type GraphUse)
		(type GraphSelector) (type GraphBinding) (type GraphResult) (type DiskEdge) (type GraphProgress)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn grow_capacity
		(:doc `Choose a geometric capacity covering the complete requested prefix without signed overflow.`)
		(params (current i32) (needed i32)) (returns i32)
		(body
			(let-mut size current)
			(while
				(:doc "Use the exact requirement once another doubling would overflow.")
				(size.lt needed)
				(body
					(if (i32:lt 1073741823i32 size) (then (return needed)))
					(set size (size.add size))))
			(return size)))

	(fn copy_disk_paths
		(:doc `Seal just the initialized source rows for the ordinary resolver and emitter.`)
		(params (staged (shared-array DiskFile)) (files (mut-array SuppliedFile))) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The exact destination length is the published prefix.")
				(index.lt files.len)
				(body
					(files.set index (struct:get (staged.get index) source))
					(set index index.inc)))))

	(fn copy_disk_rows
		(:doc `Keep file identity and byte ranges intact during workspace growth.`)
		(params (staged (shared-array DiskFile)) (files (mut-array DiskFile)) (count i32)) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Uninitialized capacity is never copied or opened.")
				(index.lt count)
				(body
					(files.set index (staged.get index))
					(set index index.inc)))))

	(fn grow_disk
		(:doc `Retain the published snapshots while growing the byte and row storage on demand.

		Recursion is limited to geometric growth. The old owners stay valid
		while their prefixes are copied, then unwind after compilation.`)
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8)) (debug_source (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8)) (context SelectionContext)
			(protection BuildProtection) (target_index i32) (check_only bool) (partition i32) (arena (shared-array u8)) (staged (shared-array DiskFile)) (edges (shared-array DiskEdge))
			(used DiskSpace) (needed DiskSpace) (progress (mut-array GraphProgress)) (modules (shared-array GraphModule))
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(reported (shared-array GraphResult)) (report_count i32) (human bool)) (returns i32)
		(body
			(let-mut bytes (array:alloc u8 (call grow_capacity arena.len needed/bytes)))
			(let-mut files (array:alloc DiskFile (call grow_capacity staged.len needed/files)))
			(let-mut next_edges (array:alloc DiskEdge (call grow_capacity edges.len needed/edges)))
			(let-mut next_modules (array:alloc GraphModule files.len))
			(let-mut next_reports (array:alloc GraphResult (call report_capacity files.len
				uses.len check_only)))
			(call copy_graph_reports (borrow-shared reported) report_count (borrow-mut next_reports))
			(call copy_graph_modules (progress.get 0i32) (borrow-shared modules) (borrow-mut next_modules))
			(let copied (call append_bytes (borrow-shared (arena.range 0i32 used/bytes))
				(borrow-mut bytes) 0i32))
			(call copy_disk_rows (borrow-shared staged) (borrow-mut files) used/files)
			(call copy_disk_edges (borrow-shared edges) (borrow-mut next_edges) used/edges)
			(return (call walk_disk (borrow-shared path) (borrow-shared canonical)
				(borrow-shared destination) (borrow-shared private_c) (borrow-shared debug_source) (borrow-shared probe_options)
				(borrow-shared probe_libraries)
				context protection target_index check_only partition
				(borrow-mut bytes) (borrow-mut files)
				(borrow-mut next_edges)
				(call disk_space copied used/files used/edges)
				(borrow-mut progress)
				(borrow-mut next_modules) (borrow-mut bindings) (borrow-mut uses)
				(borrow-mut selectors) (borrow-mut next_reports) report_count human))))

	(fn grow_tables
		(:doc "Double the import tables while retaining the pending graph operation and disk snapshots.")
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8)) (debug_source (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8)) (context SelectionContext) (protection BuildProtection)
			(target_index i32) (check_only bool) (partition i32)
			(arena (mut-array u8)) (staged (mut-array DiskFile)) (edges (mut-array DiskEdge)) (used DiskSpace)
			(progress (mut-array GraphProgress)) (modules (mut-array GraphModule))
			(bindings (shared-array GraphBinding)) (uses (shared-array GraphUse)) (selectors (shared-array GraphSelector))
			(reported (shared-array GraphResult)) (report_count i32) (human bool)) (returns i32)
		(body
			(let capacity bindings.len)
			(let next (capacity.add capacity))
			(let-mut next_bindings (array:alloc GraphBinding next))
			(let-mut next_uses (array:alloc GraphUse next))
			(let-mut next_selectors (array:alloc GraphSelector next))
			(let-mut next_reports (array:alloc GraphResult (call report_capacity modules.len
				next check_only)))
			(call copy_graph_reports (borrow-shared reported) report_count (borrow-mut next_reports))
			(call copy_graph_imports (progress.get 0i32)
				(borrow-shared bindings) (borrow-shared uses) (borrow-shared selectors)
				(borrow-mut next_bindings) (borrow-mut next_uses) (borrow-mut next_selectors))
			(return (call walk_disk (borrow-shared path) (borrow-shared canonical)
				(borrow-shared destination) (borrow-shared private_c) (borrow-shared debug_source) (borrow-shared probe_options)
				(borrow-shared probe_libraries)
				context protection target_index check_only partition
				(borrow-mut arena) (borrow-mut staged)
				(borrow-mut edges) used (borrow-mut progress) (borrow-mut modules)
				(borrow-mut next_bindings) (borrow-mut next_uses) (borrow-mut next_selectors)
				(borrow-mut next_reports) report_count human))))

	(fn resolve_loaded_edges
		(:doc `Reborrow the arena as shared before exposing its initialized byte prefix to the resolver.`)
		(params (arena (shared-array u8)) (length i32) (files (shared-array SuppliedFile)) (context SelectionContext)
			(modules (mut-array GraphModule)) (bindings (mut-array GraphBinding)) (uses (mut-array GraphUse))
			(selectors (mut-array GraphSelector)) (targets (shared-array DiskEdge))
			(progress (mut-array GraphProgress)) (recover bool)) (returns GraphResult)
		(body
			(return (call resolve_disk_graph (borrow-shared (arena.range 0i32 length))
				(borrow-shared files) 0i32 context (borrow-mut modules)
				(borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)
				(borrow-shared targets) (borrow-mut progress) recover))))

	(fn report_disk_diagnostic
		(:doc "Keep unreadable imports distinct from syntax and selection errors.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(file i32) (error u32) (start i32) (end i32) (human bool))
		(returns i32)
		(body
			(if
				(:doc "An unavailable provider is a file read error at the importing use.")
				(error.eq 27u32)
				(then (return (call report_graph_location (borrow-shared path)
					(borrow-shared arena) (borrow-shared files) file
					error start end (borrow-shared unreadable_file) human))))
			(return (call report_graph_source (borrow-shared path)
				(borrow-shared arena) (borrow-shared files) file
				error start end human))))

	(fn report_recovered_graph_error
		(:doc "Use the missing-file message only for a cached host read failure.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(edges (shared-array DiskEdge)) (result GraphResult) (human bool))
		(returns i32)
		(body
			(let file result/file)
			(let error result/error)
			(let start result/start)
			(let end result/end)
			(if
				(:doc "Other graph failures with the same code keep their ordinary source diagnostic.")
				(error.eq 27u32)
				(then
					(let-mut index 0i32)
					(while
						(:doc "The read cache keeps the importing file and original operand or use span.")
						(index.lt edges.len)
						(body
							(let edge (edges.get index))
							(if
								(:doc "A matching cached read error retains the host message.")
								(bool:and (edge/error.eq error)
									(bool:and (edge/file.eq file)
										(bool:and (edge/error_start.eq start)
											(edge/error_end.eq end))))
								(then
									(if
										(:doc "Two importers can encounter the same unavailable path before it has a file identity.")
										(call duplicate_disk_failure (borrow-shared arena) (borrow-shared files)
											(borrow-shared edges) index)
										(then (return 1i32)))
									(return (call report_disk_diagnostic (borrow-shared path) (borrow-shared arena)
										(borrow-shared files) file error start end human))))
							(set index index.inc)))))
			(return (call report_graph_source (borrow-shared path) (borrow-shared arena)
				(borrow-shared files) file error start end human))))

	(fn walk_disk
		(:doc `Drive the target-aware resolver until emission, a native read error, or a source error.`)
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8)) (debug_source (shared-array u8)) (probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(context SelectionContext) (protection BuildProtection) (target_index i32) (check_only bool) (partition i32)
			(arena (mut-array u8)) (staged (mut-array DiskFile)) (edges (mut-array DiskEdge)) (initial DiskSpace)
			(progress (mut-array GraphProgress)) (modules (mut-array GraphModule))
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(reported (mut-array GraphResult)) (initial_reports i32) (human bool))
		(returns i32)
		(body
			(let-mut length initial/bytes)
			(let-mut file_count initial/files)
			(let-mut edge_count initial/edges)
			(let-mut report_count initial_reports)
			(while
				(:doc "Each pass completes, grows capacity, or publishes one more active edge.")
				(bool true)
				(body
					(let-mut files (array:alloc SuppliedFile file_count))
					(call copy_disk_paths (borrow-shared staged) (borrow-mut files))
					(let-mut targets (array:alloc DiskEdge edge_count))
					(call copy_disk_edges (borrow-shared edges) (borrow-mut targets) edge_count)
					(let resolved (call resolve_loaded_edges (borrow-shared arena) length
						(borrow-shared files) context (borrow-mut modules)
						(borrow-mut bindings) (borrow-mut uses) (borrow-mut selectors)
						(borrow-shared targets) (borrow-mut progress) check_only))
					(let error resolved/error)
					(if
						(:doc "One successful graph feeds one retained C translation unit.")
						error.eqz
						(then
							(if
								(:doc "Check independent files before releasing the source graph's failure state and loaded edges.")
								check_only
								(then (return (call check_resolved_disk_graph (borrow-shared path) (borrow-shared canonical)
									(borrow-shared probe_options) protection target_index resolved
									(borrow-shared (arena.range 0i32 length)) (borrow-shared files)
									(borrow-shared targets) (borrow-mut modules) (borrow-shared bindings) human))))
							(return (call compile_resolved_graph (borrow-shared path) (borrow-shared canonical)
								(borrow-shared destination) (borrow-shared private_c) (borrow-shared debug_source) (borrow-shared probe_options)
								(borrow-shared probe_libraries)
								protection target_index check_only partition (borrow-shared arena)
								(borrow-shared files) (borrow-shared modules) (borrow-shared bindings)
								resolved length human))))
					(let file resolved/file)
					(if
						(:doc "Stream each primary diagnostic from the final header-aware pass and resume its checkpoint.")
						(call graph_recoverable resolved)
						(then
							(if
								(:doc "Discovery records the same failures for the final pass without reporting them twice.")
								(struct:get (progress.get 0i32) binding)
								(then
									(let next (call remember_graph_report (borrow-mut reported) report_count resolved))
									(if
										(:doc "An origin reported through Wove-file and C-header edges keeps only its first diagnostic.")
										(report_count.lt next)
										(then
											(let report_status (call report_recovered_graph_error (borrow-shared path) (borrow-shared arena)
												(borrow-shared files) (borrow-shared targets) resolved human))
											(set report_count next)))))
							(continue)))
					(if
						(:doc "Only the first unresolved active Wove edge may touch disk.")
						(i32:lt -1i32 resolved/path_start)
						(then
							(let used (call disk_space length file_count edge_count))
							(let read (call load_disk_edge used resolved protection (borrow-mut arena)
								(borrow-mut staged) (borrow-mut edges) human))
							(let status read/exit_status)
							(if status.gtz (then (return status)))
							(let next read/space)
							(if
								(:doc "Report the original importing span and avoid publishing a partial unit.")
								read/error.gtz
								(then
									(let read_error read/error)
									(let start read/start)
									(let end read/end)
									(if
										(:doc "A failed read occupies one cached edge, so the final pass can replay its primary diagnostic.")
										(check_only.and (read_error.not-eq 16u32))
										(then
											(edges.set edge_count
												(DiskEdge.new (file file) (start resolved/start)
													(target -1i32) (path_start resolved/path_start)
													(path_end resolved/path_end) (error_start start) (error_end end) (error read_error)))
											(set edge_count edge_count.inc)
											(continue)))
									(return (call report_disk_diagnostic (borrow-shared path) (borrow-shared arena)
										(borrow-shared files) file read_error start end human))))
							(if
								(:doc "Reserve storage before opening the same read request again.")
								read/grow
								(then (return (call grow_disk (borrow-shared path) (borrow-shared canonical)
									(borrow-shared destination) (borrow-shared private_c) (borrow-shared debug_source) (borrow-shared probe_options)
									(borrow-shared probe_libraries)
								context protection target_index check_only partition (borrow-shared arena)
									(borrow-shared staged) (borrow-shared edges) used next
									(borrow-mut progress) (borrow-shared modules) (borrow-mut bindings)
									(borrow-mut uses) (borrow-mut selectors)
									(borrow-shared reported) report_count human))))
							(set length next/bytes)
							(set file_count next/files)
							(set edge_count next/edges))
						(else
							(if
								(:doc "Retry short resolver tables until the signed capacity limit.")
								(bool:and (error.eq 16u32) (bindings.len.lt 1073741824i32))
								(then (return (call grow_tables (borrow-shared path) (borrow-shared canonical)
									(borrow-shared destination) (borrow-shared private_c) (borrow-shared debug_source) (borrow-shared probe_options)
									(borrow-shared probe_libraries)
								context protection target_index check_only partition
								(borrow-mut arena) (borrow-mut staged)
									(borrow-mut edges) (call disk_space length file_count edge_count)
									(borrow-mut progress) (borrow-mut modules) (borrow-shared bindings)
									(borrow-shared uses) (borrow-shared selectors)
									(borrow-shared reported) report_count human)))
								(else (return (call report_graph_source (borrow-shared path)
									(borrow-shared arena) (borrow-shared files) file error
									resolved/start resolved/end human))))))))))

	(fn seed_disk_rows
		(:doc `Store the entry's real identity and mark bundled rows as independent of the filesystem.`)
		(params (bundled (shared-array SuppliedFile)) (entry FileStamp) (staged (mut-array DiskFile))) (returns void)
		(body
			(staged.set 0i32
				(DiskFile.new (source (bundled.get 0i32)) (stamp entry)))
			(let-mut index 1i32)
			(while
				(:doc "Bundle sources are already present in the same arena.")
				(index.lt bundled.len)
				(body
					(staged.set index
						(DiskFile.new (source (bundled.get index))
							(stamp (call invalid_file_stamp))))
					(set index index.inc)))))

	(fn compile_disk_graph
		(:doc `Supply one explicit native entry, then open only its selected transitive Wove imports.`)
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:188"))
		(params (path (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8)) (debug_source (shared-array u8)) (probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(context SelectionContext) (protection BuildProtection) (target_index i32) (check_only bool) (partition i32)
			(canonical (shared-array u8)) (source (shared-array u8)) (stamp FileStamp) (human bool)) (returns i32)
		(body
			(let size (call measure_bundled_sources (borrow-shared canonical) (borrow-shared source)))
			(let total size/width)
			(if
				(:doc "Reject an arena whose offsets exceed the source ABI.")
				total.ltz
				(then (return (call report_source (borrow-shared path) 16u32 0i32 0i32 (borrow-shared invalid_source) (borrow-shared source) human))))
			(let count size/count)
			(let-mut arena (array:alloc u8 (call grow_capacity 4096i32 total)))
			(let-mut bundled (array:alloc SuppliedFile count))
			(let written (call write_bundled_sources (borrow-shared canonical) (borrow-shared source)
				(borrow-mut arena) (borrow-mut bundled)))
			(let-mut staged (array:alloc DiskFile (call grow_capacity 8i32 count)))
			(call seed_disk_rows (borrow-shared bundled) stamp (borrow-mut staged))
			(let-mut edges (array:alloc DiskEdge 8i32))
			(let-mut progress (array:alloc GraphProgress 1i32))
			(let-mut modules (array:alloc GraphModule staged.len))
			(let-mut bindings (array:alloc GraphBinding 64i32))
			(let-mut uses (array:alloc GraphUse 64i32))
			(let-mut selectors (array:alloc GraphSelector 64i32))
			(let-mut reported (array:alloc GraphResult (call report_capacity modules.len
				uses.len check_only)))
			(return (call walk_disk (borrow-shared path) (borrow-shared canonical)
				(borrow-shared destination) (borrow-shared private_c) (borrow-shared debug_source) (borrow-shared probe_options)
				(borrow-shared probe_libraries)
				context protection target_index check_only partition
				(borrow-mut arena) (borrow-mut staged) (borrow-mut edges)
				(call disk_space written count 0i32)
				(borrow-mut progress) (borrow-mut modules) (borrow-mut bindings)
				(borrow-mut uses) (borrow-mut selectors)
				(borrow-mut reported) 0i32 human))))
)
