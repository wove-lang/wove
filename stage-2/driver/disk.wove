(module native_cli_disk
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve and emit a native source graph from one entry.

	Let the shared resolver choose the next active Wove edge. Keep the
	loaded snapshots and suspended walk across retries, then emit the
	finished graph after the last edge is resolved.`)

	(use wove-file "./bundled.wove" (only measure_bundled_sources write_bundled_sources))
	(use wove-file "./diagnostics.wove" (only report_source (value invalid_source) (value unreadable_file)))
	(use wove-file "./disk_files.wove" (only load_disk_edge duplicate_disk_failure disk_space (type DiskFile) (type DiskSpace)))
	(use wove-file "./files.wove" (only invalid_file_stamp (type FileStamp)))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./check_reports.wove" (only report_capacity copy_graph_reports remember_graph_report))
	(use wove-file "./graph_storage.wove" (only copy_disk_edges copy_graph_modules copy_graph_imports))
	(use wove-file "./check_graph.wove" (only check_resolved_disk_graph))
	(use wove-file "./graph.wove" (only report_graph_source report_graph_location compile_resolved_graph))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only resolve_disk_graph graph_recoverable (type GraphModule) (type GraphUse)
		(type GraphSelector) (type GraphBinding) (type GraphResult) (type DiskEdge) (type GraphProgress)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn grow_capacity
		(:doc `Choose a geometric capacity covering the complete requested prefix without signed overflow.`)
		(params (current i32) (needed i32)) (returns i32)
		(body
			(let-mut size (local current))
			(while
				(:doc "Use the exact requirement once another doubling would overflow.")
				(i32.lt (local size) (local needed))
				(body
					(if (i32.lt 1073741823i32 (local size)) (then (return (local needed))))
					(set (local size) (i32.add (local size) (local size)))))
			(return (local size))))

	(fn copy_disk_paths
		(:doc `Seal just the initialized source rows for the ordinary resolver and emitter.`)
		(params (staged (shared-array DiskFile)) (files (mut-array SuppliedFile))) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The exact destination length is the published prefix.")
				(i32.lt (local index) (array.len (local files)))
				(body
					(array.store (local files) (local index) (struct.get (array.load (local staged) (local index)) source))
					(set (local index) (i32.inc (local index)))))))

	(fn copy_disk_rows
		(:doc `Keep file identity and byte ranges intact during workspace growth.`)
		(params (staged (shared-array DiskFile)) (files (mut-array DiskFile)) (count i32)) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Uninitialized capacity is never copied or opened.")
				(i32.lt (local index) (local count))
				(body
					(array.store (local files) (local index) (array.load (local staged) (local index)))
					(set (local index) (i32.inc (local index)))))))

	(fn grow_disk
		(:doc `Retain the published snapshots while growing the byte and row storage on demand.

		Recursion is limited to geometric growth. The old owners stay valid
		while their prefixes are copied, then unwind after compilation.`)
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8)) (context SelectionContext)
			(protection BuildProtection) (target_index i32) (check_only bool) (arena (shared-array u8)) (staged (shared-array DiskFile)) (edges (shared-array DiskEdge))
			(used DiskSpace) (needed DiskSpace) (progress (mut-array GraphProgress)) (modules (shared-array GraphModule))
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(reported (shared-array GraphResult)) (report_count i32) (human bool)) (returns i32)
		(body
			(let-mut bytes (array.alloc u8 (call grow_capacity (array.len (local arena)) (struct.get (local needed) bytes))))
			(let-mut files (array.alloc DiskFile (call grow_capacity (array.len (local staged)) (struct.get (local needed) files))))
			(let-mut next_edges (array.alloc DiskEdge (call grow_capacity (array.len (local edges)) (struct.get (local needed) edges))))
			(let-mut next_modules (array.alloc GraphModule (array.len (local files))))
			(let-mut next_reports (array.alloc GraphResult (call report_capacity (array.len (local files))
				(array.len (local uses)) (local check_only))))
			(call copy_graph_reports (borrow-shared (local reported)) (local report_count) (borrow-mut (local next_reports)))
			(call copy_graph_modules (array.load (local progress) 0i32) (borrow-shared (local modules)) (borrow-mut (local next_modules)))
			(let copied (call append_bytes (borrow-shared (array.range (local arena) 0i32 (struct.get (local used) bytes)))
				(borrow-mut (local bytes)) 0i32))
			(call copy_disk_rows (borrow-shared (local staged)) (borrow-mut (local files)) (struct.get (local used) files))
			(call copy_disk_edges (borrow-shared (local edges)) (borrow-mut (local next_edges)) (struct.get (local used) edges))
			(return (call walk_disk (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local private_c)) (borrow-shared (local probe_options))
				(borrow-shared (local probe_libraries))
				(local context) (local protection) (local target_index) (local check_only)
				(borrow-mut (local bytes)) (borrow-mut (local files))
				(borrow-mut (local next_edges))
				(call disk_space (local copied) (struct.get (local used) files) (struct.get (local used) edges))
				(borrow-mut (local progress))
				(borrow-mut (local next_modules)) (borrow-mut (local bindings)) (borrow-mut (local uses))
				(borrow-mut (local selectors)) (borrow-mut (local next_reports)) (local report_count) (local human)))))

	(fn grow_tables
		(:doc "Double the import tables while retaining the pending graph operation and disk snapshots.")
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8)) (context SelectionContext) (protection BuildProtection)
			(target_index i32) (check_only bool)
			(arena (mut-array u8)) (staged (mut-array DiskFile)) (edges (mut-array DiskEdge)) (used DiskSpace)
			(progress (mut-array GraphProgress)) (modules (mut-array GraphModule))
			(bindings (shared-array GraphBinding)) (uses (shared-array GraphUse)) (selectors (shared-array GraphSelector))
			(reported (shared-array GraphResult)) (report_count i32) (human bool)) (returns i32)
		(body
			(let capacity (array.len (local bindings)))
			(let next (i32.add (local capacity) (local capacity)))
			(let-mut next_bindings (array.alloc GraphBinding (local next)))
			(let-mut next_uses (array.alloc GraphUse (local next)))
			(let-mut next_selectors (array.alloc GraphSelector (local next)))
			(let-mut next_reports (array.alloc GraphResult (call report_capacity (array.len (local modules))
				(local next) (local check_only))))
			(call copy_graph_reports (borrow-shared (local reported)) (local report_count) (borrow-mut (local next_reports)))
			(call copy_graph_imports (array.load (local progress) 0i32)
				(borrow-shared (local bindings)) (borrow-shared (local uses)) (borrow-shared (local selectors))
				(borrow-mut (local next_bindings)) (borrow-mut (local next_uses)) (borrow-mut (local next_selectors)))
			(return (call walk_disk (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local private_c)) (borrow-shared (local probe_options))
				(borrow-shared (local probe_libraries))
				(local context) (local protection) (local target_index) (local check_only)
				(borrow-mut (local arena)) (borrow-mut (local staged))
				(borrow-mut (local edges)) (local used) (borrow-mut (local progress)) (borrow-mut (local modules))
				(borrow-mut (local next_bindings)) (borrow-mut (local next_uses)) (borrow-mut (local next_selectors))
				(borrow-mut (local next_reports)) (local report_count) (local human)))))

	(fn resolve_loaded_edges
		(:doc `Reborrow the arena as shared before exposing its initialized byte prefix to the resolver.`)
		(params (arena (shared-array u8)) (length i32) (files (shared-array SuppliedFile)) (context SelectionContext)
			(modules (mut-array GraphModule)) (bindings (mut-array GraphBinding)) (uses (mut-array GraphUse))
			(selectors (mut-array GraphSelector)) (targets (shared-array DiskEdge))
			(progress (mut-array GraphProgress)) (recover bool)) (returns GraphResult)
		(body
			(return (call resolve_disk_graph (borrow-shared (array.range (local arena) 0i32 (local length)))
				(borrow-shared (local files)) 0i32 (local context) (borrow-mut (local modules))
				(borrow-mut (local bindings)) (borrow-mut (local uses)) (borrow-mut (local selectors))
				(borrow-shared (local targets)) (borrow-mut (local progress)) (local recover)))))

	(fn report_disk_diagnostic
		(:doc "Keep unreadable imports distinct from syntax and selection errors.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(file i32) (error u32) (start i32) (end i32) (human bool))
		(returns i32)
		(body
			(if
				(:doc "An unavailable provider is a file read error at the importing use.")
				(u32.eq (local error) 27u32)
				(then (return (call report_graph_location (borrow-shared (local path))
					(borrow-shared (local arena)) (borrow-shared (local files)) (local file)
					(local error) (local start) (local end) (borrow-shared (local unreadable_file)) (local human)))))
			(return (call report_graph_source (borrow-shared (local path))
				(borrow-shared (local arena)) (borrow-shared (local files)) (local file)
				(local error) (local start) (local end) (local human)))))

	(fn report_recovered_graph_error
		(:doc "Use the missing-file message only for a cached host read failure.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(edges (shared-array DiskEdge)) (result GraphResult) (human bool))
		(returns i32)
		(body
			(let file (struct.get (local result) file))
			(let error (struct.get (local result) error))
			(let start (struct.get (local result) start))
			(let end (struct.get (local result) end))
			(if
				(:doc "Other graph failures with the same code keep their ordinary source diagnostic.")
				(u32.eq (local error) 27u32)
				(then
					(let-mut index 0i32)
					(while
						(:doc "The read cache keeps the importing file and original operand or use span.")
						(i32.lt (local index) (array.len (local edges)))
						(body
							(let edge (array.load (local edges) (local index)))
							(if
								(:doc "A matching cached read error retains the host message.")
								(bool.and (u32.eq (struct.get (local edge) error) (local error))
									(bool.and (i32.eq (struct.get (local edge) file) (local file))
										(bool.and (i32.eq (struct.get (local edge) error_start) (local start))
											(i32.eq (struct.get (local edge) error_end) (local end)))))
								(then
									(if
										(:doc "Two importers can encounter the same unavailable path before it has a file identity.")
										(call duplicate_disk_failure (borrow-shared (local arena)) (borrow-shared (local files))
											(borrow-shared (local edges)) (local index))
										(then (return 1i32)))
									(return (call report_disk_diagnostic (borrow-shared (local path)) (borrow-shared (local arena))
										(borrow-shared (local files)) (local file) (local error) (local start) (local end) (local human)))))
							(set (local index) (i32.inc (local index)))))))
			(return (call report_graph_source (borrow-shared (local path)) (borrow-shared (local arena))
				(borrow-shared (local files)) (local file) (local error) (local start) (local end) (local human)))))

	(fn walk_disk
		(:doc `Drive the target-aware resolver until emission, a native read error, or a source error.`)
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8)) (probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(context SelectionContext) (protection BuildProtection) (target_index i32) (check_only bool)
			(arena (mut-array u8)) (staged (mut-array DiskFile)) (edges (mut-array DiskEdge)) (initial DiskSpace)
			(progress (mut-array GraphProgress)) (modules (mut-array GraphModule))
			(bindings (mut-array GraphBinding)) (uses (mut-array GraphUse)) (selectors (mut-array GraphSelector))
			(reported (mut-array GraphResult)) (initial_reports i32) (human bool))
		(returns i32)
		(body
			(let-mut length (struct.get (local initial) bytes))
			(let-mut file_count (struct.get (local initial) files))
			(let-mut edge_count (struct.get (local initial) edges))
			(let-mut report_count (local initial_reports))
			(while
				(:doc "Each pass completes, grows capacity, or publishes one more active edge.")
				(bool true)
				(body
					(let-mut files (array.alloc SuppliedFile (local file_count)))
					(call copy_disk_paths (borrow-shared (local staged)) (borrow-mut (local files)))
					(let-mut targets (array.alloc DiskEdge (local edge_count)))
					(call copy_disk_edges (borrow-shared (local edges)) (borrow-mut (local targets)) (local edge_count))
					(let resolved (call resolve_loaded_edges (borrow-shared (local arena)) (local length)
						(borrow-shared (local files)) (local context) (borrow-mut (local modules))
						(borrow-mut (local bindings)) (borrow-mut (local uses)) (borrow-mut (local selectors))
						(borrow-shared (local targets)) (borrow-mut (local progress)) (local check_only)))
					(let error (struct.get (local resolved) error))
					(if
						(:doc "One successful graph feeds one retained C translation unit.")
						(u32.eqz (local error))
						(then
							(if
								(:doc "Check independent files before releasing the source graph's failure state and loaded edges.")
								(local check_only)
								(then (return (call check_resolved_disk_graph (borrow-shared (local path)) (borrow-shared (local canonical))
									(borrow-shared (local probe_options)) (local protection) (local target_index) (local resolved)
									(borrow-shared (array.range (local arena) 0i32 (local length))) (borrow-shared (local files))
									(borrow-shared (local targets)) (borrow-mut (local modules)) (borrow-shared (local bindings)) (local human)))))
							(return (call compile_resolved_graph (borrow-shared (local path)) (borrow-shared (local canonical))
								(borrow-shared (local destination)) (borrow-shared (local private_c)) (borrow-shared (local probe_options))
								(borrow-shared (local probe_libraries))
								(local protection) (local target_index) (local check_only) (borrow-shared (local arena))
								(borrow-shared (local files)) (borrow-shared (local modules)) (borrow-shared (local bindings))
								(local resolved) (local length) (local human)))))
					(let file (struct.get (local resolved) file))
					(if
						(:doc "Stream each primary diagnostic from the final header-aware pass and resume its checkpoint.")
						(call graph_recoverable (local resolved))
						(then
							(if
								(:doc "Discovery records the same failures for the final pass without reporting them twice.")
								(struct.get (array.load (local progress) 0i32) binding)
								(then
									(let next (call remember_graph_report (borrow-mut (local reported)) (local report_count) (local resolved)))
									(if
										(:doc "An origin reported through Wove-file and C-header edges keeps only its first diagnostic.")
										(i32.lt (local report_count) (local next))
										(then
											(let report_status (call report_recovered_graph_error (borrow-shared (local path)) (borrow-shared (local arena))
												(borrow-shared (local files)) (borrow-shared (local targets)) (local resolved) (local human)))
											(set (local report_count) (local next))))))
							(continue)))
					(if
						(:doc "Only the first unresolved active Wove edge may touch disk.")
						(i32.lt -1i32 (struct.get (local resolved) path_start))
						(then
							(let used (call disk_space (local length) (local file_count) (local edge_count)))
							(let read (call load_disk_edge (local used) (local resolved) (local protection) (borrow-mut (local arena))
								(borrow-mut (local staged)) (borrow-mut (local edges)) (local human)))
							(let status (struct.get (local read) exit_status))
							(if (i32.gtz (local status)) (then (return (local status))))
							(let next (struct.get (local read) space))
							(if
								(:doc "Report the original importing span and avoid publishing a partial unit.")
								(u32.gtz (struct.get (local read) error))
								(then
									(let read_error (struct.get (local read) error))
									(let start (struct.get (local read) start))
									(let end (struct.get (local read) end))
									(if
										(:doc "A failed read occupies one cached edge, so the final pass can replay its primary diagnostic.")
										(bool.and (local check_only) (u32.not-eq (local read_error) 16u32))
										(then
											(array.store (local edges) (local edge_count)
												(struct.new DiskEdge (file (local file)) (start (struct.get (local resolved) start))
													(target -1i32) (path_start (struct.get (local resolved) path_start))
													(path_end (struct.get (local resolved) path_end)) (error_start (local start)) (error_end (local end)) (error (local read_error))))
											(set (local edge_count) (i32.inc (local edge_count)))
											(continue)))
									(return (call report_disk_diagnostic (borrow-shared (local path)) (borrow-shared (local arena))
										(borrow-shared (local files)) (local file) (local read_error) (local start) (local end) (local human)))))
							(if
								(:doc "Reserve storage before opening the same read request again.")
								(struct.get (local read) grow)
								(then (return (call grow_disk (borrow-shared (local path)) (borrow-shared (local canonical))
									(borrow-shared (local destination)) (borrow-shared (local private_c)) (borrow-shared (local probe_options))
									(borrow-shared (local probe_libraries))
								(local context) (local protection) (local target_index) (local check_only) (borrow-shared (local arena))
									(borrow-shared (local staged)) (borrow-shared (local edges)) (local used) (local next)
									(borrow-mut (local progress)) (borrow-shared (local modules)) (borrow-mut (local bindings))
									(borrow-mut (local uses)) (borrow-mut (local selectors))
									(borrow-shared (local reported)) (local report_count) (local human)))))
							(set (local length) (struct.get (local next) bytes))
							(set (local file_count) (struct.get (local next) files))
							(set (local edge_count) (struct.get (local next) edges)))
						(else
							(if
								(:doc "Retry short resolver tables until the signed capacity limit.")
								(bool.and (u32.eq (local error) 16u32) (i32.lt (array.len (local bindings)) 1073741824i32))
								(then (return (call grow_tables (borrow-shared (local path)) (borrow-shared (local canonical))
									(borrow-shared (local destination)) (borrow-shared (local private_c)) (borrow-shared (local probe_options))
									(borrow-shared (local probe_libraries))
								(local context) (local protection) (local target_index) (local check_only)
								(borrow-mut (local arena)) (borrow-mut (local staged))
									(borrow-mut (local edges)) (call disk_space (local length) (local file_count) (local edge_count))
									(borrow-mut (local progress)) (borrow-mut (local modules)) (borrow-shared (local bindings))
									(borrow-shared (local uses)) (borrow-shared (local selectors))
									(borrow-shared (local reported)) (local report_count) (local human))))
								(else (return (call report_graph_source (borrow-shared (local path))
									(borrow-shared (local arena)) (borrow-shared (local files)) (local file) (local error)
									(struct.get (local resolved) start) (struct.get (local resolved) end) (local human)))))))))))

	(fn seed_disk_rows
		(:doc `Store the entry's real identity and mark bundled rows as independent of the filesystem.`)
		(params (bundled (shared-array SuppliedFile)) (entry FileStamp) (staged (mut-array DiskFile))) (returns void)
		(body
			(array.store (local staged) 0i32
				(struct.new DiskFile (source (array.load (local bundled) 0i32)) (stamp (local entry))))
			(let-mut index 1i32)
			(while
				(:doc "Bundle sources are already present in the same arena.")
				(i32.lt (local index) (array.len (local bundled)))
				(body
					(array.store (local staged) (local index)
						(struct.new DiskFile (source (array.load (local bundled) (local index)))
							(stamp (call invalid_file_stamp))))
					(set (local index) (i32.inc (local index)))))))

	(fn compile_disk_graph
		(:doc `Supply one explicit native entry, then open only its selected transitive Wove imports.`)
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:188"))
		(params (path (shared-array u8)) (destination (shared-array u8)) (private_c (shared-array u8)) (probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(context SelectionContext) (protection BuildProtection) (target_index i32) (check_only bool)
			(canonical (shared-array u8)) (source (shared-array u8)) (stamp FileStamp) (human bool)) (returns i32)
		(body
			(let size (call measure_bundled_sources (borrow-shared (local canonical)) (borrow-shared (local source))))
			(let total (struct.get (local size) width))
			(if
				(:doc "Reject an arena whose offsets exceed the source ABI.")
				(i32.ltz (local total))
				(then (return (call report_source (borrow-shared (local path)) 16u32 0i32 0i32 (borrow-shared (local invalid_source)) (borrow-shared (local source)) (local human)))))
			(let count (struct.get (local size) count))
			(let-mut arena (array.alloc u8 (call grow_capacity 4096i32 (local total))))
			(let-mut bundled (array.alloc SuppliedFile (local count)))
			(let written (call write_bundled_sources (borrow-shared (local canonical)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local bundled))))
			(let-mut staged (array.alloc DiskFile (call grow_capacity 8i32 (local count))))
			(call seed_disk_rows (borrow-shared (local bundled)) (local stamp) (borrow-mut (local staged)))
			(let-mut edges (array.alloc DiskEdge 8i32))
			(let-mut progress (array.alloc GraphProgress 1i32))
			(let-mut modules (array.alloc GraphModule (array.len (local staged))))
			(let-mut bindings (array.alloc GraphBinding 64i32))
			(let-mut uses (array.alloc GraphUse 64i32))
			(let-mut selectors (array.alloc GraphSelector 64i32))
			(let-mut reported (array.alloc GraphResult (call report_capacity (array.len (local modules))
				(array.len (local uses)) (local check_only))))
			(return (call walk_disk (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local private_c)) (borrow-shared (local probe_options))
				(borrow-shared (local probe_libraries))
				(local context) (local protection) (local target_index) (local check_only)
				(borrow-mut (local arena)) (borrow-mut (local staged)) (borrow-mut (local edges))
				(call disk_space (local written) (local count) 0i32)
				(borrow-mut (local progress)) (borrow-mut (local modules)) (borrow-mut (local bindings))
				(borrow-mut (local uses)) (borrow-mut (local selectors))
				(borrow-mut (local reported)) 0i32 (local human)))))
)
