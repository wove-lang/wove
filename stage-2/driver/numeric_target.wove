(module native_numeric_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Locate checked uses of target-dependent numeric types and verify their native ABI.")

	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "./int256_target.wove" (only probe_int256))
	(use wove-file "../clang/query.wove" (only query_clang_frontend (type QuerySite)))
	(use wove-file "../clang/index.wove" (only (type ClangDeclaration) (type ClangIndex)))
	(use wove-file "../clang/values.wove" (only clang_probe_value clang_probe_u32 (type ProbeWord)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only builtin_type_keyword is_128bit_integer is_256bit_integer (value i128_type) (value i256_type) (value f16_type) (value f80_type) (value f128_type)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/trees.wove" (only source_span_owner))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/type_sites.wove" (only target_numeric_site))
	(use wove-file "../text/match.wove" (only is_three_bytes))

	(struct NumericHints (fields (half bool) (extended bool) (quad bool) (wide_integer bool) (bit_integer bool)))
	(struct NumericSupport (fields (half u32) (extended u32) (quad u32) (wide_integer u32)))
	(struct NumericRejection (fields (site QuerySite) (error u32)))

	(let f16_unavailable 79u32)
	(let f16_probe_failed 80u32)
	(let f80_unavailable 81u32)
	(let f80_probe_failed 82u32)
	(let f128_unavailable 83u32)
	(let f128_probe_failed 84u32)
	(let int128_unavailable 85u32)
	(let int128_probe_failed 86u32)
	(let float_header "<float.h>")
	(let half_fact "wvpr_has_float16")
	(let mantissa_fact "wvpr_long_double_mantissa")
	(let quad_fact "wvpr_has_float128")
	(let wide_integer_fact "wvpr_has_int128")

	(fn target_float_keyword
		(:doc "Find a width that depends on the selected frontend's floating ABI.")
		(params (source (shared-array u8)) (start i32)) (returns u32)
		(body
			(if
				(:doc "Binary16 support is independent of the long-double format.")
				(call is_three_bytes (borrow-shared source) start 102u8 49u8 54u8)
				(then (return f16_type)))
			(if
				(:doc "Extended precision requires a native long double with a 64-bit significand.")
				(call is_three_bytes (borrow-shared source) start 102u8 56u8 48u8)
				(then (return f80_type)))
			(return 0u32)))

	(fn target_numeric_hints
		(:doc "Find potential target-dependent numeric types, operators, or literals in source atoms.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))) (returns NumericHints)
		(body
			(let-mut index 0i32)
			(let-mut half (bool false))
			(let-mut extended (bool false))
			(let-mut quad (bool false))
			(let-mut wide_integer (bool false))
			(let-mut bit_integer (bool false))
			(while
				(:doc "Hints route candidates through graph checking. Only a checked use can request Clang.")
				(index.lt nodes.len)
				(body
					(let node (nodes.get index))
					(let start node/start)
					(let end node/end)
					(if
						(:doc "Only source atoms can name a target-dependent numeric type.")
						(bool:and (node/kind.eq 1u32)
							(i32:lt 2i32 (end.sub start)))
						(then
							(let-mut prefix 0u32)
							(if
								(:doc "A leading format is a full type name or the head of a typed operation.")
								(bool:or (i32:eq (end.sub start) 3i32)
									(u8:eq (source.get (start.add 3i32)) 58u8))
								(then (set prefix (call target_float_keyword (borrow-shared source) start))))
							(let suffix (call target_float_keyword (borrow-shared source) (end.sub 3i32)))
							(set half (half.or
								(bool:or (prefix.eq f16_type) (suffix.eq f16_type))))
							(set extended (extended.or
								(bool:or (prefix.eq f80_type) (suffix.eq f80_type))))
							(if
								(:doc "A four-byte format can name a type, start an operation, or end a literal.")
								(i32:lt 3i32 (end.sub start))
								(then
									(let suffix (call builtin_type_keyword (borrow-shared source) (end.sub 4i32) 4i32))
										(let prefix (call builtin_type_keyword (borrow-shared source) start 4i32))
									(let head (bool:or (i32:eq (end.sub start) 4i32)
										(u8:eq (source.get (start.add 4i32)) 58u8)))
									(set quad (quad.or
										(bool:or (suffix.eq f128_type)
											(head.and (prefix.eq f128_type)))))
									(set wide_integer (wide_integer.or
										(bool:or (call is_128bit_integer suffix)
											(head.and (call is_128bit_integer prefix)))))
									(set bit_integer (bit_integer.or
										(bool:or (call is_256bit_integer suffix)
											(head.and (call is_256bit_integer prefix)))))))))
					(set index index.inc)))
			(return (struct:new NumericHints (half half) (extended extended) (quad quad) (wide_integer wide_integer) (bit_integer bit_integer)))))

	(fn has_target_numeric_hint
		(:doc "Route target-sensitive numeric atoms through the checked disk graph.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))) (returns bool)
		(body
			(let hints (call target_numeric_hints (borrow-shared source) (borrow-shared nodes)))
			(return (hints/half.or
				(hints/extended.or
					(hints/quad.or
					(hints/wide_integer.or hints/bit_integer)))))))

	(fn target_site
		(:doc "Convert a checked node's arena offsets into its defining file and byte span.")
		(params (files (shared-array SuppliedFile)) (node SourceNode)) (returns QuerySite)
		(body
			(let start node/start)
			(let file (call source_span_owner (borrow-shared files) start 0i32))
			(let base (struct:get (files.get file) source_start))
			(return (struct:new QuerySite (file file) (start (start.sub base))
				(end (node/end.sub base))))))

	(fn target_numeric_fact
		(:doc "Read one unsigned capability value from the selected Clang AST.")
		(params (capture (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (key (shared-array u8))) (returns ProbeWord)
		(body
			(return (call clang_probe_u32 (borrow-shared capture)
				(call clang_probe_value (borrow-shared capture) index (borrow-shared nodes)
					(borrow-shared declarations) (borrow-shared names) (borrow-shared key))))))

	(fn numeric_fact_status
		(:doc "Check that the capability enum's exact value describes the required ABI.")
		(params (fact ProbeWord) (expected u32) (unavailable u32) (failed u32)) (returns u32)
		(body
			(if
				(:doc "Missing or unusable facts cannot decide target support.")
				(bool:or fact/error.gtz
					(bool:and (expected.eq 1u32) (u32:lt 1u32 fact/value)))
				(then (return failed)))
			(if (fact/value.eq expected) (then (return 0u32)))
			(return unavailable)))

	(fn query_numeric_support
		(:doc "Read the archive's capability facts in one query using the selected frontend options.")
		(params (options (shared-array u8)) (directory (shared-array u8)) (site QuerySite)) (returns NumericSupport)
		(body
			(let program (call clang_program))
			(let empty (array:alloc u8 0i32))
			(let-mut width 1048576i32)
			(while
				(:doc "The same workspace bound as other live Clang probes accommodates forwarded includes.")
				(width.lt 33554432i32)
				(body
					(let-mut capture (array:alloc u8 width))
					(let-mut trace (array:alloc u8 width))
					(let-mut nodes (array:alloc JsonNode (i32:from-u32 (u32:shr (u32:from-i32 width) 3i32))))
					(let-mut declarations (array:alloc ClangDeclaration (i32:from-u32 (u32:shr (u32:from-i32 width) 6i32))))
					(let-mut names (array:alloc u8 (i32:from-u32 (u32:shr (u32:from-i32 width) 1i32))))
					(let result (call query_clang_frontend (borrow-shared program) (borrow-shared options)
						(borrow-shared directory) (borrow-shared empty) (borrow-shared float_header)
						site (borrow-mut capture) (borrow-mut nodes)
						(borrow-mut declarations) (borrow-mut names) (borrow-mut trace)))
					(let error result/error)
					(if
						(:doc "Only a successful, indexed capability probe can distinguish availability from failure.")
						error.eqz
						(then
							(let index result/index)
							(let half_flag (call target_numeric_fact (borrow-shared capture) index
								(borrow-shared nodes) (borrow-shared declarations) (borrow-shared names)
								(borrow-shared half_fact)))
							(let mantissa (call target_numeric_fact (borrow-shared capture) index
								(borrow-shared nodes) (borrow-shared declarations) (borrow-shared names)
								(borrow-shared mantissa_fact)))
							(let quad_flag (call target_numeric_fact (borrow-shared capture) index
								(borrow-shared nodes) (borrow-shared declarations) (borrow-shared names)
								(borrow-shared quad_fact)))
							(let wide_flag (call target_numeric_fact (borrow-shared capture) index
								(borrow-shared nodes) (borrow-shared declarations) (borrow-shared names)
								(borrow-shared wide_integer_fact)))
							(let wide_integer (call numeric_fact_status wide_flag 1u32 int128_unavailable int128_probe_failed))
							(let half (call numeric_fact_status half_flag 1u32 f16_unavailable f16_probe_failed))
							(let extended (call numeric_fact_status mantissa 64u32 f80_unavailable f80_probe_failed))
							(let quad_native (call numeric_fact_status mantissa 113u32 f128_unavailable f128_probe_failed))
							(let quad_extension (call numeric_fact_status quad_flag 1u32 f128_unavailable f128_probe_failed))
							(let-mut quad 0u32)
							(if
								(:doc "Either native spelling suffices. A failed fact matters only when the other spelling is unavailable.")
								(bool:and quad_native.gtz quad_extension.gtz)
								(then
									(set quad f128_unavailable)
									(if
										(:doc "A missing fact prevents a definite unavailable result.")
										(bool:or (quad_native.eq f128_probe_failed)
											(quad_extension.eq f128_probe_failed))
										(then (set quad f128_probe_failed)))))
							(return (struct:new NumericSupport (half half) (extended extended) (quad quad) (wide_integer wide_integer)))))
					(if
						(:doc "Only output or index exhaustion can be repaired with a larger workspace.")
						(bool:not (bool:or (error.eq 5u32) (error.eq 7u32)))
						(then (return (struct:new NumericSupport (half f16_probe_failed) (extended f80_probe_failed) (quad f128_probe_failed) (wide_integer int128_probe_failed)))))
					(set width (width.add width))))
			(return (struct:new NumericSupport (half f16_probe_failed) (extended f80_probe_failed) (quad f128_probe_failed) (wide_integer int128_probe_failed)))))

	(fn check_bit_integer_support
		(:doc "Run the independent link probe only for a checked exact 256-bit type or literal.")
		(params (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode)) (options (shared-array u8))
			(libraries (shared-array u8)) (index i32) (accepted NumericRejection)) (returns NumericRejection)
		(body
			(if index.ltz (then (return accepted)))
			(let error (call probe_int256 (borrow-shared options) (borrow-shared libraries)))
			(return (struct:new NumericRejection (site (call target_site (borrow-shared files)
				(nodes.get index))) (error error)))))

	(fn check_numeric_targets
		(:doc "Query only the target-dependent numeric capabilities required by the checked plan.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(options (shared-array u8)) (libraries (shared-array u8)) (directory (shared-array u8))) (returns NumericRejection)
		(body
			(let accepted (struct:new NumericRejection (site (struct:new QuerySite (file -1i32) (start 0i32) (end 0i32))) (error 0u32)))
			(let hints (call target_numeric_hints (borrow-shared source) (borrow-shared nodes)))
			(let-mut half -1i32)
			(let-mut extended -1i32)
			(let-mut quad -1i32)
			(let-mut wide_integer -1i32)
			(if
				(:doc "A checked binary16 use must resolve on the selected Clang target.")
				hints/half
				(then (set half (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
					(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
					f16_type))))
			(if
				(:doc "An extended-precision use needs a native long double with the requested mantissa.")
				hints/extended
				(then (set extended (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
					(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
					f80_type))))
			(if
				(:doc "A checked binary128 use needs a successful target query.")
				hints/quad
				(then (set quad (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
					(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
					f128_type))))
			(if
				(:doc "Either wide integer type depends on Clang's native int128 ABI.")
				hints/wide_integer
				(then (set wide_integer (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
					(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
					i128_type))))
			(let-mut bit_integer -1i32)
			(if
				(:doc "Either optional C23 signedness requires the archive's compile and link contract.")
				hints/bit_integer
				(then (set bit_integer (call target_numeric_site (borrow-shared source) (borrow-shared nodes)
					(borrow-shared bindings) (borrow-shared expressions) (borrow-shared statements)
					(borrow-shared functions) (borrow-shared parameters) (borrow-shared records)
					i256_type))))
			(let-mut first half)
			(if
				(:doc "Choose the first requested width as the owner of the shared query.")
				first.ltz
				(then (set first extended)))
			(if first.ltz (then (set first quad)))
			(if first.ltz (then (set first wide_integer)))
			(if
				(:doc "The 256-bit link check is independent of the older frontend capability query.")
				first.ltz
				(then (return (call check_bit_integer_support (borrow-shared files) (borrow-shared nodes)
					(borrow-shared options) (borrow-shared libraries) bit_integer accepted))))
			(let site (call target_site (borrow-shared files) (nodes.get first)))
			(let support (call query_numeric_support (borrow-shared options) (borrow-shared directory) site))
			(if
				(:doc "Retain the original binary16 source span when it is the unsupported width.")
				(bool:and (i32:lt -1i32 half) support/half.gtz)
				(then (return (struct:new NumericRejection (site site) (error support/half)))))
			(if
				(:doc "If binary16 passed, report a failed extended-precision check at its own source span.")
				(bool:and (i32:lt -1i32 extended) support/extended.gtz)
				(then (return (struct:new NumericRejection (site (call target_site (borrow-shared files)
					(nodes.get extended))) (error support/extended)))))
			(if
				(:doc "Report unsupported binary128 at the checked occurrence even when other widths pass.")
				(bool:and (i32:lt -1i32 quad) support/quad.gtz)
				(then (return (struct:new NumericRejection (site (call target_site (borrow-shared files)
					(nodes.get quad))) (error support/quad)))))
			(if
				(:doc "Report missing int128 support at its original checked source occurrence.")
				(bool:and wide_integer.not-ltz support/wide_integer.gtz)
				(then (return (struct:new NumericRejection (site (call target_site (borrow-shared files)
					(nodes.get wide_integer))) (error support/wide_integer)))))
			(return (call check_bit_integer_support (borrow-shared files) (borrow-shared nodes)
				(borrow-shared options) (borrow-shared libraries) bit_integer accepted))))
)
