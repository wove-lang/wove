(module native_numeric_target
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Locate checked uses of target-dependent numeric types and verify their native ABI.")

	(use wove-file "./clang.wove" (only clang_program))
	(use wove-file "./int256_target.wove" (only probe_int256))
	(use wove-file "../clang/query.wove" (only query_clang_frontend (type QuerySite)))
	(use wove-file "../clang/index.wove" (only (type ClangDeclaration) (type ClangIndex)))
	(use wove-file "../clang/values.wove" (only clang_probe_value clang_probe_u32 (type ProbeWord)))
	(use wove-file "../json/reader.wove" (only (type JsonNode)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/graph.wove" (only (type GraphBinding)))
	(use wove-file "../source/types.wove" (only builtin_type_keyword is_128bit_integer is_256bit_integer (value i128_type) (value i256_type) (value f16_type) (value f80_type) (value f128_type)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../scalar/trees.wove" (only source_span_owner))
	(use wove-file "../scalar/loans.wove" (only (type ScalarExpression)))
	(use wove-file "../scalar/flow.wove" (only (type ScalarStatement)))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../scalar/records.wove" (only (type ScalarRecord)))
	(use wove-file "../scalar/type_sites.wove" (only target_numeric_site))
	(use wove-file "../text/match.wove" (only is_three_bytes))

	(struct NumericHints (fields (half bool) (extended bool) (quad bool) (wide_integer bool) (bit_integer bool)))
	(struct NumericSupport (fields (half u32) (extended u32) (quad u32) (wide_integer u32)))
	(struct NumericRejection (fields (site QuerySite) (error u32)))

	(let f16_unavailable 79u32)
	(let f16_probe_failed 80u32)
	(let f80_unavailable 81u32)
	(let f80_probe_failed 82u32)
	(let f128_unavailable 83u32)
	(let f128_probe_failed 84u32)
	(let int128_unavailable 85u32)
	(let int128_probe_failed 86u32)
	(let float_header "<float.h>")
	(let half_fact "wvpr_has_float16")
	(let mantissa_fact "wvpr_long_double_mantissa")
	(let quad_fact "wvpr_has_float128")
	(let wide_integer_fact "wvpr_has_int128")

	(fn target_float_keyword
		(:doc "Find a width that depends on the selected frontend's floating ABI.")
		(params (source (shared-array u8)) (start i32)) (returns u32)
		(body
			(if
				(:doc "Binary16 support is independent of the long-double format.")
				(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 49u8 54u8)
				(then (return (local f16_type))))
			(if
				(:doc "Extended precision requires a native long double with a 64-bit significand.")
				(call is_three_bytes (borrow-shared (local source)) (local start) 102u8 56u8 48u8)
				(then (return (local f80_type))))
			(return 0u32)))

	(fn target_numeric_hints
		(:doc "Find potential target-dependent numeric types, operators, or literals in source atoms.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))) (returns NumericHints)
		(body
			(let-mut index 0i32)
			(let-mut half (bool false))
			(let-mut extended (bool false))
			(let-mut quad (bool false))
			(let-mut wide_integer (bool false))
			(let-mut bit_integer (bool false))
			(while
				(:doc "Hints route candidates through graph checking. Only a checked use can request Clang.")
				(i32.lt (local index) (array.len (local nodes)))
				(body
					(let node (array.load (local nodes) (local index)))
					(let start (struct.get (local node) start))
					(let end (struct.get (local node) end))
					(if
						(:doc "Only source atoms can name a target-dependent numeric type.")
						(bool.and (u32.eq (struct.get (local node) kind) 1u32)
							(i32.lt 2i32 (i32.sub (local end) (local start))))
						(then
							(let-mut prefix 0u32)
							(if
								(:doc "A leading format is a full type name or the head of a typed operation.")
								(bool.or (i32.eq (i32.sub (local end) (local start)) 3i32)
									(u8.eq (array.load (local source) (i32.add (local start) 3i32)) 46u8))
								(then (set (local prefix) (call target_float_keyword (borrow-shared (local source)) (local start)))))
							(let suffix (call target_float_keyword (borrow-shared (local source)) (i32.sub (local end) 3i32)))
							(set (local half) (bool.or (local half)
								(bool.or (u32.eq (local prefix) (local f16_type)) (u32.eq (local suffix) (local f16_type)))))
							(set (local extended) (bool.or (local extended)
								(bool.or (u32.eq (local prefix) (local f80_type)) (u32.eq (local suffix) (local f80_type)))))
							(if
								(:doc "A four-byte format can name a type, start an operation, or end a literal.")
								(i32.lt 3i32 (i32.sub (local end) (local start)))
								(then
									(let suffix (call builtin_type_keyword (borrow-shared (local source)) (i32.sub (local end) 4i32) 4i32))
										(let prefix (call builtin_type_keyword (borrow-shared (local source)) (local start) 4i32))
									(let head (bool.or (i32.eq (i32.sub (local end) (local start)) 4i32)
										(u8.eq (array.load (local source) (i32.add (local start) 4i32)) 46u8)))
									(set (local quad) (bool.or (local quad)
										(bool.or (u32.eq (local suffix) (local f128_type))
											(bool.and (local head) (u32.eq (local prefix) (local f128_type))))))
									(set (local wide_integer) (bool.or (local wide_integer)
										(bool.or (call is_128bit_integer (local suffix))
											(bool.and (local head) (call is_128bit_integer (local prefix))))))
									(set (local bit_integer) (bool.or (local bit_integer)
										(bool.or (call is_256bit_integer (local suffix))
											(bool.and (local head) (call is_256bit_integer (local prefix))))))))))
					(set (local index) (i32.inc (local index)))))
			(return (struct.new NumericHints (half (local half)) (extended (local extended)) (quad (local quad)) (wide_integer (local wide_integer)) (bit_integer (local bit_integer))))))

	(fn has_target_numeric_hint
		(:doc "Route target-sensitive numeric atoms through the checked disk graph.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))) (returns bool)
		(body
			(let hints (call target_numeric_hints (borrow-shared (local source)) (borrow-shared (local nodes))))
			(return (bool.or (struct.get (local hints) half)
				(bool.or (struct.get (local hints) extended)
					(bool.or (struct.get (local hints) quad)
					(bool.or (struct.get (local hints) wide_integer) (struct.get (local hints) bit_integer))))))))

	(fn target_site
		(:doc "Convert a checked node's arena offsets into its defining file and byte span.")
		(params (files (shared-array SuppliedFile)) (node SourceNode)) (returns QuerySite)
		(body
			(let start (struct.get (local node) start))
			(let file (call source_span_owner (borrow-shared (local files)) (local start) 0i32))
			(let base (struct.get (array.load (local files) (local file)) source_start))
			(return (struct.new QuerySite (file (local file)) (start (i32.sub (local start) (local base)))
				(end (i32.sub (struct.get (local node) end) (local base)))))))

	(fn target_numeric_fact
		(:doc "Read one unsigned capability value from the selected Clang AST.")
		(params (capture (shared-array u8)) (index ClangIndex) (nodes (shared-array JsonNode))
			(declarations (shared-array ClangDeclaration)) (names (shared-array u8)) (key (shared-array u8))) (returns ProbeWord)
		(body
			(return (call clang_probe_u32 (borrow-shared (local capture))
				(call clang_probe_value (borrow-shared (local capture)) (local index) (borrow-shared (local nodes))
					(borrow-shared (local declarations)) (borrow-shared (local names)) (borrow-shared (local key)))))))

	(fn numeric_fact_status
		(:doc "Check that the capability enum's exact value describes the required ABI.")
		(params (fact ProbeWord) (expected u32) (unavailable u32) (failed u32)) (returns u32)
		(body
			(if
				(:doc "Missing or unusable facts cannot decide target support.")
				(bool.or (u32.gtz (struct.get (local fact) error))
					(bool.and (u32.eq (local expected) 1u32) (u32.lt 1u32 (struct.get (local fact) value))))
				(then (return (local failed))))
			(if (u32.eq (struct.get (local fact) value) (local expected)) (then (return 0u32)))
			(return (local unavailable))))

	(fn query_numeric_support
		(:doc "Read the archive's capability facts in one query using the selected frontend options.")
		(params (options (shared-array u8)) (directory (shared-array u8)) (site QuerySite)) (returns NumericSupport)
		(body
			(let program (call clang_program))
			(let empty (array.alloc u8 0i32))
			(let-mut width 1048576i32)
			(while
				(:doc "The same workspace bound as other live Clang probes accommodates forwarded includes.")
				(i32.lt (local width) 33554432i32)
				(body
					(let-mut capture (array.alloc u8 (local width)))
					(let-mut trace (array.alloc u8 (local width)))
					(let-mut nodes (array.alloc JsonNode (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 3i32))))
					(let-mut declarations (array.alloc ClangDeclaration (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 6i32))))
					(let-mut names (array.alloc u8 (i32.from-u32 (u32.shr (u32.from-i32 (local width)) 1i32))))
					(let result (call query_clang_frontend (borrow-shared (local program)) (borrow-shared (local options))
						(borrow-shared (local directory)) (borrow-shared (local empty)) (borrow-shared (local float_header))
						(local site) (borrow-mut (local capture)) (borrow-mut (local nodes))
						(borrow-mut (local declarations)) (borrow-mut (local names)) (borrow-mut (local trace))))
					(let error (struct.get (local result) error))
					(if
						(:doc "Only a successful, indexed capability probe can distinguish availability from failure.")
						(u32.eqz (local error))
						(then
							(let index (struct.get (local result) index))
							(let half_flag (call target_numeric_fact (borrow-shared (local capture)) (local index)
								(borrow-shared (local nodes)) (borrow-shared (local declarations)) (borrow-shared (local names))
								(borrow-shared (local half_fact))))
							(let mantissa (call target_numeric_fact (borrow-shared (local capture)) (local index)
								(borrow-shared (local nodes)) (borrow-shared (local declarations)) (borrow-shared (local names))
								(borrow-shared (local mantissa_fact))))
							(let quad_flag (call target_numeric_fact (borrow-shared (local capture)) (local index)
								(borrow-shared (local nodes)) (borrow-shared (local declarations)) (borrow-shared (local names))
								(borrow-shared (local quad_fact))))
							(let wide_flag (call target_numeric_fact (borrow-shared (local capture)) (local index)
								(borrow-shared (local nodes)) (borrow-shared (local declarations)) (borrow-shared (local names))
								(borrow-shared (local wide_integer_fact))))
							(let wide_integer (call numeric_fact_status (local wide_flag) 1u32 (local int128_unavailable) (local int128_probe_failed)))
							(let half (call numeric_fact_status (local half_flag) 1u32 (local f16_unavailable) (local f16_probe_failed)))
							(let extended (call numeric_fact_status (local mantissa) 64u32 (local f80_unavailable) (local f80_probe_failed)))
							(let quad_native (call numeric_fact_status (local mantissa) 113u32 (local f128_unavailable) (local f128_probe_failed)))
							(let quad_extension (call numeric_fact_status (local quad_flag) 1u32 (local f128_unavailable) (local f128_probe_failed)))
							(let-mut quad 0u32)
							(if
								(:doc "Either native spelling suffices. A failed fact matters only when the other spelling is unavailable.")
								(bool.and (u32.gtz (local quad_native)) (u32.gtz (local quad_extension)))
								(then
									(set (local quad) (local f128_unavailable))
									(if
										(:doc "A missing fact prevents a definite unavailable result.")
										(bool.or (u32.eq (local quad_native) (local f128_probe_failed))
											(u32.eq (local quad_extension) (local f128_probe_failed)))
										(then (set (local quad) (local f128_probe_failed))))))
							(return (struct.new NumericSupport (half (local half)) (extended (local extended)) (quad (local quad)) (wide_integer (local wide_integer))))))
					(if
						(:doc "Only output or index exhaustion can be repaired with a larger workspace.")
						(bool.not (bool.or (u32.eq (local error) 5u32) (u32.eq (local error) 7u32)))
						(then (return (struct.new NumericSupport (half (local f16_probe_failed)) (extended (local f80_probe_failed)) (quad (local f128_probe_failed)) (wide_integer (local int128_probe_failed))))))
					(set (local width) (i32.add (local width) (local width)))))
			(return (struct.new NumericSupport (half (local f16_probe_failed)) (extended (local f80_probe_failed)) (quad (local f128_probe_failed)) (wide_integer (local int128_probe_failed))))))

	(fn check_bit_integer_support
		(:doc "Run the independent link probe only for a checked exact 256-bit type or literal.")
		(params (files (shared-array SuppliedFile)) (nodes (shared-array SourceNode)) (options (shared-array u8))
			(index i32) (accepted NumericRejection)) (returns NumericRejection)
		(body
			(if (i32.ltz (local index)) (then (return (local accepted))))
			(let error (call probe_int256 (borrow-shared (local options))))
			(return (struct.new NumericRejection (site (call target_site (borrow-shared (local files))
				(array.load (local nodes) (local index)))) (error (local error))))))

	(fn check_numeric_targets
		(:doc "Query only the target-dependent numeric capabilities required by the checked plan.")
		(params (source (shared-array u8)) (files (shared-array SuppliedFile)) (bindings (shared-array GraphBinding))
			(nodes (shared-array SourceNode)) (expressions (shared-array ScalarExpression)) (statements (shared-array ScalarStatement))
			(functions (shared-array ScalarFunction)) (parameters (shared-array ScalarParameter)) (records (shared-array ScalarRecord))
			(options (shared-array u8)) (directory (shared-array u8))) (returns NumericRejection)
		(body
			(let accepted (struct.new NumericRejection (site (struct.new QuerySite (file -1i32) (start 0i32) (end 0i32))) (error 0u32)))
			(let hints (call target_numeric_hints (borrow-shared (local source)) (borrow-shared (local nodes))))
			(let-mut half -1i32)
			(let-mut extended -1i32)
			(let-mut quad -1i32)
			(let-mut wide_integer -1i32)
			(if
				(:doc "A checked binary16 use must resolve on the selected Clang target.")
				(struct.get (local hints) half)
				(then (set (local half) (call target_numeric_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local f16_type)))))
			(if
				(:doc "An extended-precision use needs a native long double with the requested mantissa.")
				(struct.get (local hints) extended)
				(then (set (local extended) (call target_numeric_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local f80_type)))))
			(if
				(:doc "A checked binary128 use needs a successful target query.")
				(struct.get (local hints) quad)
				(then (set (local quad) (call target_numeric_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local f128_type)))))
			(if
				(:doc "Either wide integer type depends on Clang's native int128 ABI.")
				(struct.get (local hints) wide_integer)
				(then (set (local wide_integer) (call target_numeric_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local i128_type)))))
			(let-mut bit_integer -1i32)
			(if
				(:doc "Either optional C23 signedness requires the archive's compile and link contract.")
				(struct.get (local hints) bit_integer)
				(then (set (local bit_integer) (call target_numeric_site (borrow-shared (local source)) (borrow-shared (local nodes))
					(borrow-shared (local bindings)) (borrow-shared (local expressions)) (borrow-shared (local statements))
					(borrow-shared (local functions)) (borrow-shared (local parameters)) (borrow-shared (local records))
					(local i256_type)))))
			(let-mut first (local half))
			(if
				(:doc "Choose the first requested width as the owner of the shared query.")
				(i32.ltz (local first))
				(then (set (local first) (local extended))))
			(if (i32.ltz (local first)) (then (set (local first) (local quad))))
			(if (i32.ltz (local first)) (then (set (local first) (local wide_integer))))
			(if
				(:doc "The 256-bit link check is independent of the older frontend capability query.")
				(i32.ltz (local first))
				(then (return (call check_bit_integer_support (borrow-shared (local files)) (borrow-shared (local nodes))
					(borrow-shared (local options)) (local bit_integer) (local accepted)))))
			(let site (call target_site (borrow-shared (local files)) (array.load (local nodes) (local first))))
			(let support (call query_numeric_support (borrow-shared (local options)) (borrow-shared (local directory)) (local site)))
			(if
				(:doc "Retain the original binary16 source span when it is the unsupported width.")
				(bool.and (i32.lt -1i32 (local half)) (u32.gtz (struct.get (local support) half)))
				(then (return (struct.new NumericRejection (site (local site)) (error (struct.get (local support) half))))))
			(if
				(:doc "If binary16 passed, report a failed extended-precision check at its own source span.")
				(bool.and (i32.lt -1i32 (local extended)) (u32.gtz (struct.get (local support) extended)))
				(then (return (struct.new NumericRejection (site (call target_site (borrow-shared (local files))
					(array.load (local nodes) (local extended)))) (error (struct.get (local support) extended))))))
			(if
				(:doc "Report unsupported binary128 at the checked occurrence even when other widths pass.")
				(bool.and (i32.lt -1i32 (local quad)) (u32.gtz (struct.get (local support) quad)))
				(then (return (struct.new NumericRejection (site (call target_site (borrow-shared (local files))
					(array.load (local nodes) (local quad)))) (error (struct.get (local support) quad))))))
			(if
				(:doc "Report missing int128 support at its original checked source occurrence.")
				(bool.and (i32.not-ltz (local wide_integer)) (u32.gtz (struct.get (local support) wide_integer)))
				(then (return (struct.new NumericRejection (site (call target_site (borrow-shared (local files))
					(array.load (local nodes) (local wide_integer)))) (error (struct.get (local support) wide_integer))))))
			(return (call check_bit_integer_support (borrow-shared (local files)) (borrow-shared (local nodes))
				(borrow-shared (local options)) (local bit_integer) (local accepted)))))
)
