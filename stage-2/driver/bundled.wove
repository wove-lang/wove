(module native_bundled_sources
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Pack the entry and the built-in C providers into the ordinary supplied-source table.")

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/bytes.wove" (only append_bytes))

	(fn bundled_path_width
		(:doc "Reserve the bytes for both canonical paths in the built-in namespace.")
		(params)
		(returns i32)
		(body (return (i32 41))))

	(fn write_provider_path
		(:doc "Write the canonical /c-stdlib/stdlib.wove or /c-stdlib/stdio.wove path.")
		(params (arena (mut-slice u8)) (start i32) (stdio bool))
		(returns i32)
		(body
			(slice.store (local arena) (local start) (u8 47))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 1)) (u8 99))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 2)) (u8 45))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 3)) (u8 115))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 4)) (u8 116))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 5)) (u8 100))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 6)) (u8 108))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 7)) (u8 105))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 8)) (u8 98))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 9)) (u8 47))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 10)) (u8 115))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 11)) (u8 116))
			(slice.store (local arena) (i32.add.wrapping (local start) (i32 12)) (u8 100))
			(let tail (i32.add.wrapping (local start) (i32 13)))
			(let-mut suffix (i32.add.wrapping (local tail) (i32 2)))
			(if
				(:doc "The stdio name has a two-byte tail and stdlib has three.")
				(local stdio)
				(then
					(slice.store (local arena) (local tail) (u8 105))
					(slice.store (local arena) (i32.add.wrapping (local tail) (i32 1)) (u8 111)))
				(else
					(slice.store (local arena) (local tail) (u8 108))
					(slice.store (local arena) (i32.add.wrapping (local tail) (i32 1)) (u8 105))
					(slice.store (local arena) (i32.add.wrapping (local tail) (i32 2)) (u8 98))
					(set (local suffix) (i32.add.wrapping (local tail) (i32 3)))))
			(slice.store (local arena) (local suffix) (u8 46))
			(slice.store (local arena) (i32.add.wrapping (local suffix) (i32 1)) (u8 119))
			(slice.store (local arena) (i32.add.wrapping (local suffix) (i32 2)) (u8 111))
			(slice.store (local arena) (i32.add.wrapping (local suffix) (i32 3)) (u8 118))
			(slice.store (local arena) (i32.add.wrapping (local suffix) (i32 4)) (u8 101))
			(return (i32.add.wrapping (local suffix) (i32 5)))))

	(fn write_supplied_entry
		(:doc "Reserve row zero for the entry and keep all of its source offsets relative to its own view.")
		(params (path (shared-slice u8)) (source (shared-slice u8)) (arena (mut-slice u8))
			(files (mut-slice SuppliedFile)))
		(returns i32)
		(body
			(let path_end (call append_bytes (borrow-shared (local path)) (borrow-mut (local arena)) (i32 0)))
			(let source_end (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local path_end)))
			(slice.store (local files) (i32 0) (record.make SuppliedFile (identity (i32 0))
				(path_start (i32 0)) (path_end (local path_end)) (source_start (local path_end)) (source_end (local source_end))))
			(return (local source_end))))

	(fn write_supplied_provider
		(:doc "Assign one defining row and one byte range to the complete bundled provider.")
		(params (source (shared-slice u8)) (arena (mut-slice u8)) (files (mut-slice SuppliedFile))
			(start i32) (identity i32) (stdio bool))
		(returns i32)
		(body
			(let path_end (call write_provider_path (borrow-mut (local arena)) (local start) (local stdio)))
			(let source_end (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local path_end)))
			(slice.store (local files) (local identity) (record.make SuppliedFile (identity (local identity))
				(path_start (local start)) (path_end (local path_end)) (source_start (local path_end)) (source_end (local source_end))))
			(return (local source_end))))

	(fn write_bundled_sources
		(:doc "Register the entry, stdlib, and stdio at stable identities zero, one, and two.")
		(params (path (shared-slice u8)) (source (shared-slice u8)) (stdlib (shared-slice u8)) (stdio (shared-slice u8))
			(arena (mut-slice u8)) (files (mut-slice SuppliedFile)))
		(returns i32)
		(body
			(let entry_end (call write_supplied_entry (borrow-shared (local path)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local files))))
			(let stdlib_end (call write_supplied_provider (borrow-shared (local stdlib)) (borrow-mut (local arena))
				(borrow-mut (local files)) (local entry_end) (i32 1) (bool false)))
			(return (call write_supplied_provider (borrow-shared (local stdio)) (borrow-mut (local arena))
				(borrow-mut (local files)) (local stdlib_end) (i32 2) (bool true))))))
