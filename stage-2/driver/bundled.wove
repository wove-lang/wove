(module native_bundled_sources
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Pack the entry and the built-in C providers into the ordinary supplied-source table.

	Both native graph paths use the same ordered path and source pairs.
	The entry keeps identity zero and provider identities follow inventory order.`)

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(use wove-file "./bundled_paths.wove" (only
		(value stdlib_path) (value stdio_path) (value unistd_path) (value spawn_path)
		(value fcntl_path) (value errno_path) (value sys_stat_path) (value sys_wait_path) (value dirent_path) (value math_path) (value sys_file_path)))

	(let stdlib_source (embed "../c-stdlib/stdlib.wove"))
	(let stdio_source (embed "../c-stdlib/stdio.wove"))
	(let unistd_source (embed "../c-stdlib/unistd.wove"))
	(let spawn_source (embed "../c-stdlib/spawn.wove"))
	(let fcntl_source (embed "../c-stdlib/fcntl.wove"))
	(let errno_source (embed "../c-stdlib/errno.wove"))
	(let sys_stat_source (embed "../c-stdlib/sys_stat.wove"))
	(let sys_wait_source (embed "../c-stdlib/sys_wait.wove"))
	(let dirent_source (embed "../c-stdlib/dirent.wove"))
	(let math_source (embed "../c-stdlib/math.wove"))
	(let sys_file_source (embed "../c-stdlib/sys_file.wove"))

	(struct
		(:doc "The next file identity and byte offset. A negative width indicates overflow.")
		BundleCursor
		(fields (count i32) (width i32)))

	(fn append_bundled_source
		(:doc "Account for one path and payload and write them when the file table is present.")
		(params (path (shared-array u8)) (source (shared-array u8)) (arena (mut-array u8))
			(files (mut-array SuppliedFile)) (cursor BundleCursor))
		(returns BundleCursor)
		(body
			(let start (struct.get (local cursor) width))
			(if (i32.ltz (local start)) (then (return (local cursor))))
			(let path_width (array.len (local path)))
			(let source_width (array.len (local source)))
			(if
				(:doc "Each path must fit the signed source-offset range.")
				(i32.lt (i32.sub 2147483647i32 (local start)) (local path_width))
				(then (return (struct.new BundleCursor (count 0i32) (width -1i32)))))
			(let path_end (i32.add (local start) (local path_width)))
			(if
				(:doc "The full provider payload must fit after the path.")
				(i32.lt (i32.sub 2147483647i32 (local path_end)) (local source_width))
				(then (return (struct.new BundleCursor (count 0i32) (width -1i32)))))
			(let source_end (i32.add (local path_end) (local source_width)))
			(let identity (struct.get (local cursor) count))
			(if
				(:doc "A sized file table enables one direct copy from each view into the graph arena.")
				(i32.gtz (array.len (local files)))
				(then
					(let copied_path (call append_bytes (borrow-shared (local path)) (borrow-mut (local arena)) (local start)))
					(let copied_source (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local copied_path)))
					(array.store (local files) (local identity) (struct.new SuppliedFile (identity (local identity))
						(path_start (local start)) (path_end (local path_end)) (source_start (local path_end))
						(source_end (local copied_source)) (bundled (i32.gtz (local identity)))))))
			(return (struct.new BundleCursor (count (i32.inc (local identity))) (width (local source_end))))))

	(fn pack_bundled_sources
		(:doc "Visit the entry and each bundled provider in identity order for both sizing and writing.")
		(:expect (tests "stage-2/cli/native/cases.tsv")
			(issues "gh:wove-lang/wove:316" "gh:wove-lang/wove:438" "gh:wove-lang/wove:488"))
		(params (path (shared-array u8)) (source (shared-array u8))
			(arena (mut-array u8)) (files (mut-array SuppliedFile)))
		(returns BundleCursor)
		(body
			(let-mut cursor (call append_bundled_source (borrow-shared (local path)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (struct.new BundleCursor (count 0i32) (width 0i32))))
			(set (local cursor) (call append_bundled_source (borrow-shared (local stdlib_path)) (borrow-shared (local stdlib_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local stdio_path)) (borrow-shared (local stdio_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local unistd_path)) (borrow-shared (local unistd_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local spawn_path)) (borrow-shared (local spawn_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local fcntl_path)) (borrow-shared (local fcntl_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local errno_path)) (borrow-shared (local errno_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local sys_stat_path)) (borrow-shared (local sys_stat_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local sys_wait_path)) (borrow-shared (local sys_wait_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local dirent_path)) (borrow-shared (local dirent_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local math_path)) (borrow-shared (local math_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(set (local cursor) (call append_bundled_source (borrow-shared (local sys_file_path)) (borrow-shared (local sys_file_source))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local cursor)))
			(return (local cursor))))

	(fn measure_bundled_sources
		(:doc "Measure using an empty table, before allocating the graph arena.")
		(params (path (shared-array u8)) (source (shared-array u8)))
		(returns BundleCursor)
		(body
			(let-mut arena (array.new (array u8 0)))
			(let-mut files (array.alloc SuppliedFile 0i32))
			(return (call pack_bundled_sources (borrow-shared (local path)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local files))))))

	(fn write_bundled_sources
		(:doc "Populate the measured arena and file table and return the written length.")
		(params (path (shared-array u8)) (source (shared-array u8))
			(arena (mut-array u8)) (files (mut-array SuppliedFile)))
		(returns i32)
		(body
			(let written (call pack_bundled_sources (borrow-shared (local path)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local files))))
			(return (struct.get (local written) width))))
)
