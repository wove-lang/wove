(module native_bundled_sources
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Pack the entry and the built-in C providers into the ordinary supplied-source table.

	Both native graph paths use the same ordered path and source pairs.
	The entry keeps identity zero and provider identities follow inventory order.`)

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(use wove-file "./bundled_paths.wove" (only
		(value stdlib_path) (value stdio_path) (value unistd_path) (value spawn_path)
		(value fcntl_path) (value errno_path) (value sys_stat_path) (value sys_wait_path)
		(value dirent_path) (value math_path) (value sys_file_path) (value assert_path)
		(value ctype_path) (value locale_path) (value xlocale_path) (value dlfcn_path)
		(value time_path) (value sys_acl_path) (value fenv_path) (value float_path) (value fmtmsg_path) (value fnmatch_path) (value ftw_path) (value glob_path) (value grp_path) (value limits_path) (value cpio_path) (value tar_path) (value utsname_path) (value poll_path) (value times_path) (value resource_path) (value timeval_path) (value statvfs_path) (value signal_path) (value string_path) (value stdint_path) (value inttypes_path)))

	(let stdlib_source (embed "../llvm-libc/stdlib.wove"))
	(let stdio_source (embed "../llvm-libc/stdio.wove"))
	(let unistd_source (embed "../llvm-libc/unistd.wove"))
	(let spawn_source (embed "../llvm-libc/spawn.wove"))
	(let fcntl_source (embed "../llvm-libc/fcntl.h.wove"))
	(let errno_source (embed "../llvm-libc/errno.h.wove"))
	(let sys_stat_source (embed "../llvm-libc/sys/stat.h.wove"))
	(let sys_wait_source (embed "../llvm-libc/sys/wait.h.wove"))
	(let dirent_source (embed "../llvm-libc/dirent.h.wove"))
	(let math_source (embed "../llvm-libc/math.wove"))
	(let sys_file_source (embed "../llvm-libc/sys_file.wove"))
	(let assert_source (embed "../llvm-libc/assert.h.wove"))
	(let ctype_source (embed "../llvm-libc/ctype.h.wove"))
	(let locale_source (embed "../llvm-libc/locale.h.wove"))
	(let xlocale_source (embed "../llvm-libc/xlocale.h.wove"))
	(let dlfcn_source (embed "../llvm-libc/dlfcn.h.wove"))
	(let time_source (embed "../llvm-libc/time.h.wove"))
	(let sys_acl_source (embed "../llvm-libc/sys_acl.h.wove"))
	(let fenv_source (embed "../llvm-libc/fenv.h.wove"))
	(let float_source (embed "../llvm-libc/float.h.wove"))
	(let fmtmsg_source (embed "../llvm-libc/fmtmsg.h.wove"))
	(let fnmatch_source (embed "../llvm-libc/fnmatch.h.wove"))
	(let ftw_source (embed "../llvm-libc/ftw.h.wove"))
	(let glob_source (embed "../llvm-libc/glob.h.wove"))
	(let grp_source (embed "../llvm-libc/grp.h.wove"))
	(let limits_source (embed "../llvm-libc/limits.h.wove"))
	(let cpio_source (embed "../llvm-libc/cpio.h.wove"))
	(let tar_source (embed "../llvm-libc/tar.h.wove"))
	(let utsname_source (embed "../llvm-libc/sys/utsname.h.wove"))
	(let poll_source (embed "../llvm-libc/poll.h.wove"))
	(let times_source (embed "../llvm-libc/sys/times.h.wove"))
	(let resource_source (embed "../llvm-libc/sys/resource.h.wove"))
	(let timeval_source (embed "../llvm-libc/sys/time.h.wove"))
	(let statvfs_source (embed "../llvm-libc/sys/statvfs.h.wove"))
	(let signal_source (embed "../llvm-libc/signal.h.wove"))
	(let string_source (embed "../llvm-libc/string.h.wove"))
	(let stdint_source (embed "../llvm-libc/stdint.h.wove"))
	(let inttypes_source (embed "../llvm-libc/inttypes.h.wove"))

	(struct BundleCursor
		(:doc "The next file identity and byte offset. A negative width indicates overflow.")
		(fields (count i32) (width i32)))

	(fn append_bundled_source
		(:doc "Account for one path and payload and write them when the file table is present.")
		(params (path (shared-array u8)) (source (shared-array u8)) (arena (mut-array u8))
			(files (mut-array SuppliedFile)) (cursor BundleCursor))
		(returns BundleCursor)
		(body
			(let start (struct.get cursor width))
			(if (i32.ltz start) (then (return cursor)))
			(let path_width (array.len path))
			(let source_width (array.len source))
			(if
				(:doc "Each path must fit the signed source-offset range.")
				(i32.lt (i32.sub 2147483647i32 start) path_width)
				(then (return (struct.new BundleCursor (count 0i32) (width -1i32)))))
			(let path_end (i32.add start path_width))
			(if
				(:doc "The full provider payload must fit after the path.")
				(i32.lt (i32.sub 2147483647i32 path_end) source_width)
				(then (return (struct.new BundleCursor (count 0i32) (width -1i32)))))
			(let source_end (i32.add path_end source_width))
			(let identity (struct.get cursor count))
			(if
				(:doc "A sized file table enables one direct copy from each view into the graph arena.")
				(i32.gtz (array.len files))
				(then
					(let copied_path (call append_bytes (borrow-shared path) (borrow-mut arena) start))
					(let copied_source (call append_bytes (borrow-shared source) (borrow-mut arena) copied_path))
					(array.store files identity (struct.new SuppliedFile (identity identity)
						(path_start start) (path_end path_end) (source_start path_end)
						(source_end copied_source) (bundled (i32.gtz identity))))))
			(return (struct.new BundleCursor (count (i32.inc identity)) (width source_end)))))

	(fn pack_bundled_sources
		(:doc "Visit the entry and each bundled provider in identity order for both sizing and writing.")
		(:expect (tests "stage-2/cli/native/cases.tsv")
			(issues "gh:wove-lang/wove:316" "gh:wove-lang/wove:438" "gh:wove-lang/wove:488"))
		(params (path (shared-array u8)) (source (shared-array u8))
			(arena (mut-array u8)) (files (mut-array SuppliedFile)))
		(returns BundleCursor)
		(body
			(let-mut cursor (call append_bundled_source (borrow-shared path) (borrow-shared source)
				(borrow-mut arena) (borrow-mut files) (struct.new BundleCursor (count 0i32) (width 0i32))))
			(set cursor (call append_bundled_source (borrow-shared stdlib_path) (borrow-shared stdlib_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared stdio_path) (borrow-shared stdio_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared unistd_path) (borrow-shared unistd_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared spawn_path) (borrow-shared spawn_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared fcntl_path) (borrow-shared fcntl_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared errno_path) (borrow-shared errno_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared sys_stat_path) (borrow-shared sys_stat_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared sys_wait_path) (borrow-shared sys_wait_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared dirent_path) (borrow-shared dirent_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared math_path) (borrow-shared math_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared sys_file_path) (borrow-shared sys_file_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared assert_path) (borrow-shared assert_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared ctype_path) (borrow-shared ctype_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared locale_path) (borrow-shared locale_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared xlocale_path) (borrow-shared xlocale_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared dlfcn_path) (borrow-shared dlfcn_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared time_path) (borrow-shared time_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared sys_acl_path) (borrow-shared sys_acl_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared fenv_path) (borrow-shared fenv_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared float_path) (borrow-shared float_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared fmtmsg_path) (borrow-shared fmtmsg_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared fnmatch_path) (borrow-shared fnmatch_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared ftw_path) (borrow-shared ftw_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared glob_path) (borrow-shared glob_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared grp_path) (borrow-shared grp_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared limits_path) (borrow-shared limits_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared cpio_path) (borrow-shared cpio_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared tar_path) (borrow-shared tar_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared utsname_path) (borrow-shared utsname_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared poll_path) (borrow-shared poll_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared times_path) (borrow-shared times_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared resource_path) (borrow-shared resource_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared timeval_path) (borrow-shared timeval_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared statvfs_path) (borrow-shared statvfs_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared signal_path) (borrow-shared signal_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared string_path) (borrow-shared string_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared stdint_path) (borrow-shared stdint_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(set cursor (call append_bundled_source (borrow-shared inttypes_path) (borrow-shared inttypes_source)
				(borrow-mut arena) (borrow-mut files) cursor))
			(return cursor)))

	(fn measure_bundled_sources
		(:doc "Measure using an empty table, before allocating the graph arena.")
		(params (path (shared-array u8)) (source (shared-array u8)))
		(returns BundleCursor)
		(body
			(let-mut arena (array.new (array u8 0)))
			(let-mut files (array.alloc SuppliedFile 0i32))
			(return (call pack_bundled_sources (borrow-shared path) (borrow-shared source)
				(borrow-mut arena) (borrow-mut files)))))

	(fn write_bundled_sources
		(:doc "Populate the measured arena and file table and return the written length.")
		(params (path (shared-array u8)) (source (shared-array u8))
			(arena (mut-array u8)) (files (mut-array SuppliedFile)))
		(returns i32)
		(body
			(let written (call pack_bundled_sources (borrow-shared path) (borrow-shared source)
				(borrow-mut arena) (borrow-mut files)))
			(return (struct.get written width))))
)
