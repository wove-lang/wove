(module native_bundled_sources
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Pack the entry and the built-in C providers into the ordinary supplied-source table.")

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(let stdlib_path "/c-stdlib/stdlib.wove")
	(let stdio_path "/c-stdlib/stdio.wove")
	(let unistd_path "/c-stdlib/unistd.wove")

	(fn bundled_file_count
		(:doc "Count the entry and all three bundled C provider rows.")
		(params)
		(returns i32)
		(body (return (i32 4))))

	(fn bundled_provider_width
		(:doc "Reserve the canonical paths and the complete embedded provider sources.")
		(params (stdlib (shared-slice u8)) (stdio (shared-slice u8)) (unistd (shared-slice u8)))
		(returns i32)
		(body
			(let paths (i32.add.wrapping (slice.len (local stdlib_path))
				(i32.add.wrapping (slice.len (local stdio_path)) (slice.len (local unistd_path)))))
			(let sources (i32.add.wrapping (slice.len (local stdlib))
				(i32.add.wrapping (slice.len (local stdio)) (slice.len (local unistd)))))
			(return (i32.add.wrapping (local paths) (local sources)))))

	(fn write_supplied_entry
		(:doc "Reserve row zero for the entry and keep all of its source offsets relative to its own view.")
		(params (path (shared-slice u8)) (source (shared-slice u8)) (arena (mut-slice u8))
			(files (mut-slice SuppliedFile)))
		(returns i32)
		(body
			(let path_end (call append_bytes (borrow-shared (local path)) (borrow-mut (local arena)) (i32 0)))
			(let source_end (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local path_end)))
			(slice.store (local files) (i32 0) (record.make SuppliedFile (identity (i32 0))
				(path_start (i32 0)) (path_end (local path_end)) (source_start (local path_end)) (source_end (local source_end))))
			(return (local source_end))))

	(fn write_supplied_provider
		(:doc "Assign one defining row and one byte range to the complete bundled provider.")
		(params (path (shared-slice u8)) (source (shared-slice u8)) (arena (mut-slice u8))
			(files (mut-slice SuppliedFile)) (start i32) (identity i32))
		(returns i32)
		(body
			(let path_end (call append_bytes (borrow-shared (local path)) (borrow-mut (local arena)) (local start)))
			(let source_end (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local path_end)))
			(slice.store (local files) (local identity) (record.make SuppliedFile (identity (local identity))
				(path_start (local start)) (path_end (local path_end)) (source_start (local path_end)) (source_end (local source_end))))
			(return (local source_end))))

	(fn write_bundled_sources
		(:doc "Register the entry and each C provider at a stable identity.")
		(params (path (shared-slice u8)) (source (shared-slice u8)) (stdlib (shared-slice u8)) (stdio (shared-slice u8))
			(unistd (shared-slice u8)) (arena (mut-slice u8)) (files (mut-slice SuppliedFile)))
		(returns i32)
		(body
			(let entry_end (call write_supplied_entry (borrow-shared (local path)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local files))))
			(let stdlib_end (call write_supplied_provider (borrow-shared (local stdlib_path)) (borrow-shared (local stdlib))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local entry_end) (i32 1)))
			(let stdio_end (call write_supplied_provider (borrow-shared (local stdio_path)) (borrow-shared (local stdio))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local stdlib_end) (i32 2)))
			(return (call write_supplied_provider (borrow-shared (local unistd_path)) (borrow-shared (local unistd))
				(borrow-mut (local arena)) (borrow-mut (local files)) (local stdio_end) (i32 3))))))
