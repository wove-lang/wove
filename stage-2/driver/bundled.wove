(module native_bundled_sources
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Pack the entry and the built-in C providers into the ordinary supplied-source table.

	Both native graph paths use the same ordered path and source pairs.
	The entry keeps identity zero and provider identities follow inventory order.`)

	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(use wove-file "./bundled_paths.wove" (only
		(value stdlib_path) (value stdio_path) (value unistd_path) (value spawn_path)
		(value fcntl_path) (value errno_path) (value sys_stat_path) (value sys_wait_path) (value dirent_path)))

	(fn copy_provider_path
		(:doc `Keep each virtual provider path in the same inventory as its source bytes.`)
		(params (path (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut bytes (array.alloc u8 (array.len (local path))))
			(let end (call append_bytes (borrow-shared (local path)) (borrow-mut (local bytes)) 0i32))
			(return (move (local bytes)))))

	(fn load_bundled_providers
		(:doc `Load path and source pairs in identity order. Append new providers to preserve existing identities.`)
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:316"))
		(params) (returns (owned-array (owned-array u8)))
		(body
			(let-mut rows (array.alloc (owned-array u8) 18i32))
			(array.store (local rows) 0i32 (call copy_provider_path (borrow-shared (local stdlib_path))))
			(let stdlib (embed "../c-stdlib/stdlib.wove"))
			(array.store (local rows) 1i32 (move (local stdlib)))

			(array.store (local rows) 2i32 (call copy_provider_path (borrow-shared (local stdio_path))))
			(let stdio (embed "../c-stdlib/stdio.wove"))
			(array.store (local rows) 3i32 (move (local stdio)))

			(array.store (local rows) 4i32 (call copy_provider_path (borrow-shared (local unistd_path))))
			(let unistd (embed "../c-stdlib/unistd.wove"))
			(array.store (local rows) 5i32 (move (local unistd)))

			(array.store (local rows) 6i32 (call copy_provider_path (borrow-shared (local spawn_path))))
			(let spawn (embed "../c-stdlib/spawn.wove"))
			(array.store (local rows) 7i32 (move (local spawn)))

			(array.store (local rows) 8i32 (call copy_provider_path (borrow-shared (local fcntl_path))))
			(let fcntl (embed "../c-stdlib/fcntl.wove"))
			(array.store (local rows) 9i32 (move (local fcntl)))

			(array.store (local rows) 10i32 (call copy_provider_path (borrow-shared (local errno_path))))
			(let errno (embed "../c-stdlib/errno.wove"))
			(array.store (local rows) 11i32 (move (local errno)))

			(array.store (local rows) 12i32 (call copy_provider_path (borrow-shared (local sys_stat_path))))
			(let sys_stat (embed "../c-stdlib/sys_stat.wove"))
			(array.store (local rows) 13i32 (move (local sys_stat)))

			(array.store (local rows) 14i32 (call copy_provider_path (borrow-shared (local sys_wait_path))))
			(let sys_wait (embed "../c-stdlib/sys_wait.wove"))
			(array.store (local rows) 15i32 (move (local sys_wait)))

			(array.store (local rows) 16i32 (call copy_provider_path (borrow-shared (local dirent_path))))
			(let dirent (embed "../c-stdlib/dirent.wove"))
			(array.store (local rows) 17i32 (move (local dirent)))

			(return (move (local rows)))))

	(fn bundled_file_count
		(:doc `Count the entry plus one file row per provider pair.`)
		(params (providers (shared-array (owned-array u8)))) (returns i32)
		(body (return (i32.inc (i32.div (array.len (local providers)) 2i32)))))

	(fn provider_row_width
		(:doc `Measure one provider path or source through its stored byte owner.`)
		(params (bytes (shared-array u8))) (returns i32)
		(body (return (array.len (local bytes)))))

	(fn bundled_input_width
		(:doc `Measure the complete arena or return -1 if the signed source offsets cannot represent it.`)
		(params (path (shared-array u8)) (source (shared-array u8))
			(providers (shared-array (owned-array u8)))) (returns i32)
		(body
			(let path_width (array.len (local path)))
			(let source_width (array.len (local source)))
			(if
				(:doc `Check the entry range before adding the ordered provider rows.`)
				(i32.lt (i32.sub 2147483647i32 (local path_width)) (local source_width))
				(then (return -1i32)))
			(let-mut total (i32.add (local path_width) (local source_width)))
			(let-mut index 0i32)
			(while
				(:doc `Each path and source range must fit before it can be published.`)
				(i32.lt (local index) (array.len (local providers)))
				(body
					(let width (call provider_row_width (borrow-shared (array.load (local providers) (local index)))))
					(if (i32.lt (i32.sub 2147483647i32 (local total)) (local width)) (then (return -1i32)))
					(set (local total) (i32.add (local total) (local width)))
					(set (local index) (i32.inc (local index)))))
			(return (local total))))

	(fn write_supplied_entry
		(:doc "Reserve row zero for the entry and keep all of its source offsets relative to its own view.")
		(params (path (shared-array u8)) (source (shared-array u8)) (arena (mut-array u8))
			(files (mut-array SuppliedFile)))
		(returns i32)
		(body
			(let path_end (call append_bytes (borrow-shared (local path)) (borrow-mut (local arena)) 0i32))
			(let source_end (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local path_end)))
			(array.store (local files) 0i32 (struct.new SuppliedFile (identity 0i32)
				(path_start 0i32) (path_end (local path_end)) (source_start (local path_end)) (source_end (local source_end)) (bundled (bool false))))
			(return (local source_end))))

	(fn write_supplied_provider
		(:doc "Assign one defining row and one byte range to the complete bundled provider.")
		(params (path (shared-array u8)) (source (shared-array u8)) (arena (mut-array u8))
			(files (mut-array SuppliedFile)) (start i32) (identity i32))
		(returns i32)
		(body
			(let path_end (call append_bytes (borrow-shared (local path)) (borrow-mut (local arena)) (local start)))
			(let source_end (call append_bytes (borrow-shared (local source)) (borrow-mut (local arena)) (local path_end)))
			(array.store (local files) (local identity) (struct.new SuppliedFile (identity (local identity))
				(path_start (local start)) (path_end (local path_end)) (source_start (local path_end)) (source_end (local source_end)) (bundled (bool true))))
			(return (local source_end))))

	(fn write_bundled_sources
		(:doc `Register the entry and all provider pairs through the same file table publication path.`)
		(params (path (shared-array u8)) (source (shared-array u8)) (providers (shared-array (owned-array u8)))
			(arena (mut-array u8)) (files (mut-array SuppliedFile))) (returns i32)
		(body
			(let-mut end (call write_supplied_entry (borrow-shared (local path)) (borrow-shared (local source))
				(borrow-mut (local arena)) (borrow-mut (local files))))
			(let-mut index 0i32)
			(let-mut identity 1i32)
			(while
				(:doc `The inventory keeps the virtual path immediately before its source bytes.`)
				(i32.lt (local index) (array.len (local providers)))
				(body
					(let source_index (i32.inc (local index)))
					(set (local end) (call write_supplied_provider
						(borrow-shared (array.load (local providers) (local index)))
						(borrow-shared (array.load (local providers) (local source_index)))
						(borrow-mut (local arena)) (borrow-mut (local files)) (local end) (local identity)))
					(set (local index) (i32.add (local index) 2i32))
					(set (local identity) (i32.inc (local identity)))))
			(return (local end))))
)
