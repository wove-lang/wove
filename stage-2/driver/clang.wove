(module native_clang_tool
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Select the same Clang executable for header inspection and native compilation.")

	(use c-header "<stdlib.h>" (only getenv))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(let clang "clang")
	(let clang_environment "CLANG")

	(fn empty_program
		(:doc "Check an owned tool name through its borrowed bytes.")
		(params (program (shared-array u8)))
		(returns bool)
		(body (return (i32.eq (array.len (local program)) 0i32))))

	(fn default_clang_program
		(:doc `Copy the default executable name into the same owner type as getenv.`)
		(params) (returns (owned-array u8))
		(body
			(let-mut program (array.alloc u8 (array.len (local clang))))
			(let end (call append_bytes (borrow-shared (local clang)) (borrow-mut (local program)) 0i32))
			(return (move (local program)))))

	(fn clang_program
		(:doc `Use CLANG as one executable name or use clang through PATH.`)
		(params) (returns (owned-array u8))
		(body
			(let configured (call getenv (borrow-shared (local clang_environment))))
			(if
				(:doc `An absent override selects the default executable.`)
				(owner.is-null (local configured))
				(then (return (call default_clang_program))))
			(let program (move (optional.unwrap (local configured))))
			(if
				(:doc `Treat an explicitly empty override as the default executable as well.`)
				(call empty_program (borrow-shared (local program)))
				(then (return (call default_clang_program))))
			(return (move (local program))))))
