(module native_cli_version
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize the native version aliases and print the embedded build metadata.`)

	(use wove-file "../text/bytes.wove" (only write_byte))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_u32))
	(use wove-file "../io/stdio.wove" (only write_stdout))

	(fn is_version_argument
		(:doc `Match exactly version or --version in a single host argument.`)
		(params (bytes (shared-slice u8)))
		(returns bool)
		(body
			(let width (slice.len (local bytes)))
			(let-mut start (i32 0))
			(if
				(:doc "Only the nine-byte alias can begin with two dashes.")
				(i32.eq (local width) (i32 9))
				(then
					(if
						(:doc "Check both dashes before matching the shared suffix.")
						(bool.not (bool.and (call is_byte_at (borrow-shared (local bytes)) (i32 0) (i32 0) (u8 45))
							(call is_byte_at (borrow-shared (local bytes)) (i32 0) (i32 1) (u8 45))))
						(then (return (bool false))))
					(set (local start) (i32 2)))
				(else
					(if
						(:doc "The command spelling is exactly seven bytes.")
						(bool.not (i32.eq (local width) (i32 7)))
						(then (return (bool false))))))
			(return (bool.and
				(call is_three_bytes (borrow-shared (local bytes)) (local start) (u8 118) (u8 101) (u8 114))
				(bool.and
					(call is_three_bytes (borrow-shared (local bytes))
						(i32.add.wrapping (local start) (i32 3)) (u8 115) (u8 105) (u8 111))
					(call is_byte_at (borrow-shared (local bytes)) (local start) (i32 6) (u8 110)))))))

	(fn write_version_line
		(:doc `Format the release numbers independently and append the build line verbatim.`)
		(params (output (mut-slice u8)) (major u32) (minor u32) (build (shared-slice u8)))
		(returns i32)
		(body
			(let w (call write_byte (borrow-mut (local output)) (i32 0) (u8 119)))
			(let o (call write_byte (borrow-mut (local output)) (local w) (u8 111)))
			(let v (call write_byte (borrow-mut (local output)) (local o) (u8 118)))
			(let e (call write_byte (borrow-mut (local output)) (local v) (u8 101)))
			(let c (call write_byte (borrow-mut (local output)) (local e) (u8 99)))
			(let name (call write_byte (borrow-mut (local output)) (local c) (u8 32)))
			(let major_end (call write_decimal_u32 (borrow-mut (local output)) (local name) (local major)))
			(let minor_start (call write_byte (borrow-mut (local output)) (local major_end) (u8 46)))
			(let minor_end (call write_decimal_u32 (borrow-mut (local output)) (local minor_start) (local minor)))
			(let-mut cursor (call write_byte (borrow-mut (local output)) (local minor_end) (u8 46)))
			(let-mut index (i32 0))
			(while
				(:doc "Copy the date, revision, and terminating LF within the supplied destination.")
				(bool.and (bool.not (i32.lt (local cursor) (i32 0))) (i32.lt (local index) (slice.len (local build))))
				(body
					(set (local cursor) (call write_byte (borrow-mut (local output)) (local cursor)
						(slice.load (local build) (local index))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (local cursor))))

	(fn print_version
		(:doc `Print this compiler's release and compiled-in Git metadata to stdout.`)
		(:expect (tests "stage-2/version/cases.tsv") (issues "gh:wove-lang/wove:178"))
		(params)
		(returns i32)
		(body
			(let major (u32 0))
			(let minor (u32 0))
			(let build (embed "../../build/version.txt"))
			(let-mut line (array.alloc u8 (i32 48)))
			(let length (call write_version_line (borrow-mut (local line)) (local major) (local minor)
				(borrow-shared (local build))))
			(if
				(:doc "The output fits two ten-digit release components and the validated build line.")
				(i32.lt (local length) (i32 0))
				(then (return (i32 1))))
			(if
				(:doc "Flush the complete version line before returning success.")
				(call write_stdout (borrow-shared (slice.range (local line) (i32 0) (local length))))
				(then (return (i32 0))))
			(return (i32 1)))))
