(module native_cli_version
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Recognize the native version aliases and print the embedded build metadata.`)

	(use wove-file "../text/bytes.wove" (only write_byte))
	(use wove-file "../text/match.wove" (only is_byte_at is_three_bytes))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_u32))
	(use wove-file "../io/stdio.wove" (only write_stdout))

	(fn is_version_argument
		(:doc `Match exactly version or --version in a single host argument.`)
		(params (bytes (shared-array u8)))
		(returns bool)
		(body
			(let width bytes.len)
			(let-mut start 0i32)
			(if
				(:doc "Only the nine-byte alias can begin with two dashes.")
				(width.eq 9i32)
				(then
					(if
						(:doc "Check both dashes before matching the shared suffix.")
						(bool:not (bool:and (call is_byte_at (borrow-shared bytes) 0i32 0i32 45u8)
							(call is_byte_at (borrow-shared bytes) 0i32 1i32 45u8)))
						(then (return (bool false))))
					(set start 2i32))
				(else
					(if
						(:doc "The command spelling is exactly seven bytes.")
						(width.not-eq 7i32)
						(then (return (bool false))))))
			(return (bool:and
				(call is_three_bytes (borrow-shared bytes) start 118u8 101u8 114u8)
				(bool:and
					(call is_three_bytes (borrow-shared bytes)
						(start.add 3i32) 115u8 105u8 111u8)
					(call is_byte_at (borrow-shared bytes) start 6i32 110u8))))))

	(fn write_version_line
		(:doc `Format the release numbers independently and append the build line verbatim.`)
		(params (output (mut-array u8)) (major u32) (minor u32) (build (shared-array u8)))
		(returns i32)
		(body
			(let w (call write_byte (borrow-mut output) 0i32 119u8))
			(let o (call write_byte (borrow-mut output) w 111u8))
			(let v (call write_byte (borrow-mut output) o 118u8))
			(let e (call write_byte (borrow-mut output) v 101u8))
			(let c (call write_byte (borrow-mut output) e 99u8))
			(let name (call write_byte (borrow-mut output) c 32u8))
			(let major_end (call write_decimal_u32 (borrow-mut output) name major))
			(let minor_start (call write_byte (borrow-mut output) major_end 46u8))
			(let minor_end (call write_decimal_u32 (borrow-mut output) minor_start minor))
			(let-mut cursor (call write_byte (borrow-mut output) minor_end 46u8))
			(let-mut index 0i32)
			(while
				(:doc "Copy the date, revision, and terminating LF within the supplied destination.")
				(cursor.not-ltz.and (index.lt build.len))
				(body
					(set cursor (call write_byte (borrow-mut output) cursor
						(build.get index)))
					(set index index.inc)))
			(return cursor)))

	(fn print_version
		(:doc `Print this compiler's release and compiled-in Git metadata to stdout.`)
		(:expect (tests "stage-2/version/cases.tsv") (issues "gh:wove-lang/wove:178"))
		(params)
		(returns i32)
		(body
			(let major 0u32)
			(let minor 0u32)
			(let build (embed "../../build/version.txt"))
			(let-mut line (array:alloc u8 48i32))
			(let length (call write_version_line (borrow-mut line) major minor
				(borrow-shared build)))
			(if
				(:doc "The output fits two ten-digit release components and the validated build line.")
				length.ltz
				(then (return 1i32)))
			(if
				(:doc "Flush the complete version line before returning success.")
				(call write_stdout (borrow-shared (line.range 0i32 length)))
				(then (return 0i32)))
			(return 1i32))))
