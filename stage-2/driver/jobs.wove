(module compiler_jobs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Compute the worker budget from resolved compiler settings and a supplied online CPU count.")

	(fn compiler_job_budget
		(:doc `Return the budget for resolved parallel and parallelJobs settings.

		Positive explicit counts use the full u32 setting range. Automatic
		budgets use twice the online logical CPU count, with one CPU as the
		fallback for nonpositive counts and 2147483647 as the upper bound.`)
		(:expect
			(tests "stage-2/cli/jobs.wove" "stage-2/cli/command/cases.tsv")
			(issues "gh:wove-lang/wove:204"))
		(params (parallel bool) (parallel_jobs u32) (online_cpus i32))
		(returns u32)
		(body
			(if
				(:doc "Disabling parallel work takes precedence over any job count.")
				(bool.not (local parallel))
				(then (return (u32 1))))
			(if
				(:doc "An explicit positive count sets the budget directly.")
				(u32.lt (u32 0) (local parallel_jobs))
				(then (return (local parallel_jobs))))
			(if
				(:doc "Twice the one-CPU fallback gives two jobs.")
				(i32.lt (local online_cpus) (i32 1))
				(then (return (u32 2))))
			(if
				(:doc "Check the saturation threshold before doubling the CPU count.")
				(i32.lt (i32 1073741823) (local online_cpus))
				(then (return (u32 2147483647))))
			(let count (int.convert u32 (local online_cpus)))
			(return (u32.add.wrapping (local count) (local count))))))
