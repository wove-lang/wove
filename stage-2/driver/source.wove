(module native_cli_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read one explicit source and choose single-file or graph emission.

	Check the entry and use its active selections to choose the emitter. Measure
	and write C with the shared emitter, keeping the file's original spans
	on failure. Publish only a complete emitted translation unit.`)

	(use wove-file "./diagnostics.wove" (only report_source report_file
		(value invalid_source) (value unreadable_file) (value unreadable_asset)))
	(use wove-file "./output.wove" (only publish_input))
	(use wove-file "./input_files.wove" (only check_asset_inputs))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./disk.wove" (only compile_disk_graph))
	(use wove-file "./numeric_target.wove" (only has_target_numeric_hint))
	(use wove-file "./files.wove" (only canonical_path file_stamp read_source_file))
	(use wove-file "../source/target.wove" (only (value library_mode) (type SelectionContext)))
	(use wove-file "./graph.wove" (only needs_provider_graph compile_bundled_input))
	(use wove-file "./assets.wove" (only load_input_assets))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset)))
	(use wove-file "../source/scan.wove" (only check_source_form semantic_tree_rows build_semantic_tree check_source_metadata (type SourceNode)))
	(use wove-file "../source/module.wove" (only read_module_for_target (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../emit/c.wove" (only emit_module))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../scalar/generics/workspace.wove" (only has_selected_function_template))

	(fn emit_input
		(:doc `Retry a short emitter destination, retaining only the first complete unit.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(target_index i32) (source (shared-array u8)) (source_size i32) (nodes (mut-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (assets (mut-array EmbedAsset)) (human bool))
		(returns i32)
		(body
			(let-mut capacity 4096i32)
			(while
				(:doc "Bound buffer growth by the signed slice ABI.")
				(bool true)
				(body
					(let-mut output (array:alloc u8 capacity))
					(let result (call emit_module (borrow-shared source) (borrow-mut nodes)
						module (borrow-shared declarations) 0i32 0i32
						(borrow-mut assets) (bool false) (borrow-mut output)))
					(let error (result.get error))
					(if
						(:doc "Only a successful emitter can publish an artifact.")
						(u32:eqz error)
						(then
							(return (call publish_input (borrow-shared path) (borrow-shared destination) (borrow-shared staged) target_index
								(borrow-shared (output.range 0i32 (result.get written))) human))))
					(if
						(:doc "A source error or exhausted growth limit retains the emitter's span.")
						(bool:or (u32:not-eq error 16u32) (i32:lt 1073741823i32 capacity))
						(then (return (call report_source (borrow-shared path) error
							(result.get start) (result.get end) (borrow-shared invalid_source)
							(borrow-shared (source.range 0i32 source_size)) human))))
					(set capacity (i32:add capacity capacity))))))

	(fn copy_source_prefix
		(:doc `Preserve the complete original source at byte zero before appending asset bytes.`)
		(params (source (shared-array u8)) (arena (mut-array u8)))
		(returns void)
		(body
			(let copied (call append_bytes (borrow-shared source) (borrow-mut arena) 0i32))))

	(fn compile_assets
		(:doc `Collect checked embed requests, load selected assets, and emit from the resulting arena.`)
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool)
			(source (shared-array u8)) (nodes (mut-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (human bool))
		(returns i32)
		(body
			(let-mut requests (array:alloc EmbedAsset nodes.len))
			(let-mut none (array:alloc u8 0i32))
			(let checked (call emit_module (borrow-shared source) (borrow-mut nodes)
				module (borrow-shared declarations) 0i32 0i32
				(borrow-mut requests) (bool true) (borrow-mut none)))
			(if
				(:doc "The semantic plan reports malformed or ill-typed source before requesting any files.")
				(u32:gtz (checked.get error))
				(then (return (call report_source (borrow-shared path) (checked.get error)
					(checked.get start) (checked.get end) (borrow-shared invalid_source)
					(borrow-shared source) human))))
			(if
				(:doc "A module without active embeds already has a complete source arena.")
				(i32:eqz (checked.get written))
				(then
					(if check_only (then (return 0i32)))
					(return (call emit_input (borrow-shared path) (borrow-shared destination) (borrow-shared staged) target_index
					(borrow-shared source) source.len (borrow-mut nodes)
					module (borrow-shared declarations) (borrow-mut requests) human))))
			(if
				(:doc "Check destination aliases when this invocation will publish.")
				(bool:not check_only)
				(then
					(let no_files (array:alloc SuppliedFile 0i32))
					(let conflict (call check_asset_inputs (borrow-shared canonical) (borrow-shared source)
						(borrow-shared no_files) (borrow-shared requests) protection human))
					(if (i32:gtz conflict) (then (return conflict)))))
			(let measured (call load_input_assets (borrow-shared canonical) (borrow-shared source)
				(borrow-mut requests) (borrow-mut none) (bool false)))
			(if
				(:doc "A missing or invalid asset is diagnosed at the selected path token.")
				(u32:gtz (measured.get error))
				(then (return (call report_source (borrow-shared path) (measured.get error)
					(measured.get start) (measured.get end) (borrow-shared unreadable_asset)
					(borrow-shared source) human))))
			(let-mut arena (array:alloc u8 (measured.get count)))
			(call copy_source_prefix (borrow-shared source) (borrow-mut arena))
			(let loaded (call load_input_assets (borrow-shared canonical) (borrow-shared source)
				(borrow-mut requests) (borrow-mut arena) (bool true)))
			(if
				(:doc "A failed or changed file cannot leave partial data in retained C.")
				(u32:gtz (loaded.get error))
				(then (return (call report_source (borrow-shared path) (loaded.get error)
					(loaded.get start) (loaded.get end) (borrow-shared unreadable_asset)
					(borrow-shared source) human))))
			(if
				(:doc "The checked single module and its selected assets are ready.")
				check_only
				(then (return 0i32)))
			(return (call emit_input (borrow-shared path) (borrow-shared destination) (borrow-shared staged) target_index
				(borrow-shared arena) source.len (borrow-mut nodes)
				module (borrow-shared declarations) (borrow-mut requests) human))))

	(fn compile_input
		(:doc `Read the checked entry and select the emitter while carrying its publication protection.

		A successful numbered stage returns its negated unit count. Unsplit
		emission returns zero, and diagnostics return positive exit statuses.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(probe_options (shared-array u8)) (probe_libraries (shared-array u8)) (context SelectionContext) (protection BuildProtection)
			(target_index i32) (check_only bool) (partition i32) (human bool))
		(returns i32)
		(body
			(let canonical (call canonical_path (borrow-shared path)))
			(let stamp (call file_stamp (borrow-shared canonical)))
			(let length (stamp.get length))
			(if
				(:doc "A missing or unreadable file has no source bytes yet.")
				(i32:ltz length)
				(then (return (call report_file (borrow-shared path) 64u32 0i32 0i32 (borrow-shared unreadable_file) human))))
			(let-mut source (array:alloc u8 length))
			(let read (call read_source_file (borrow-shared canonical) stamp (borrow-mut source)))
			(if
				(:doc "Keep a failed read at the input path.")
				(bool:not read)
				(then (return (call report_file (borrow-shared path) 64u32 0i32 0i32 (borrow-shared unreadable_file) human))))
			(let checked (call check_source_form (borrow-shared source)))
			(if
				(:doc "Lexing and form errors already identify their original byte spans.")
				(u32:gtz (checked.get error))
				(then (return (call report_source (borrow-shared path) (checked.get error)
					(checked.get start) (checked.get end) (borrow-shared invalid_source)
					(borrow-shared source) human))))
			(let rows (i32:from-u32 (call semantic_tree_rows checked)))
			(let-mut nodes (array:alloc SourceNode rows))
			(let built (call build_semantic_tree (borrow-shared source) checked (borrow-mut nodes)))
			(let metadata (call check_source_metadata (borrow-shared source) built (borrow-shared nodes)))
			(let-mut declarations (array:alloc SelectedDeclaration rows))
			(let module (call read_module_for_target (borrow-shared source) (borrow-shared nodes)
				metadata context (borrow-mut declarations)))
			(if
				(:doc "The disk graph handles library exports, imports, generics, and native numeric capabilities.")
				(bool:or (u32:eq (context.get mode) library_mode)
					(bool:and (u32:eqz (module.get error))
						(bool:or
							(call needs_provider_graph (borrow-shared source) (borrow-shared nodes)
								(borrow-shared declarations) (module.get count) 3u32)
							(bool:or (call has_selected_function_template (borrow-shared source) (borrow-shared nodes)
								(borrow-shared declarations) (module.get count))
								(call has_target_numeric_hint (borrow-shared source) (borrow-shared nodes))))))
				(then (return (call compile_disk_graph (borrow-shared path) (borrow-shared destination) (borrow-shared staged) (borrow-shared probe_options)
				(borrow-shared probe_libraries)
					context protection target_index check_only partition
					(borrow-shared canonical) (borrow-shared source) stamp human))))
			(if
				(:doc "C-header imports and declarations use the supplied-source graph with the embedded providers.")
				(bool:and (u32:eqz (module.get error))
					(call needs_provider_graph (borrow-shared source) (borrow-shared nodes)
						(borrow-shared declarations) (module.get count) 8u32))
				(then (return (call compile_bundled_input (borrow-shared path) (borrow-shared canonical)
					(borrow-shared destination) (borrow-shared staged) (borrow-shared probe_options)
					(borrow-shared probe_libraries)
					context protection target_index check_only (borrow-shared source) rows human))))
			(return (call compile_assets (borrow-shared path) (borrow-shared canonical)
				(borrow-shared destination) (borrow-shared staged)
				protection target_index check_only (borrow-shared source) (borrow-mut nodes)
				module (borrow-shared declarations) human)))))
