(module native_cli_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read one explicit source and choose single-file or graph emission.

	Check the entry and use its active selections to choose the emitter. Measure
	and write C with the shared emitter, keeping the file's original spans
	on failure. Publish only a complete emitted translation unit.`)

	(use wove-file "./diagnostics.wove" (only report_argv report_source
		(value invalid_source) (value unreadable_file) (value non_utf8_source) (value invalid_target) (value unreadable_asset)))
	(use wove-file "./output.wove" (only valid_output_target retained_c_path publish_input))
	(use wove-file "./disk.wove" (only compile_disk_graph))
	(use wove-file "./files.wove" (only canonical_path file_stamp read_source_file))
	(use wove-file "./platform.wove" (only native_selection))
	(use wove-file "./graph.wove" (only has_active_use compile_bundled_input))
	(use wove-file "./assets.wove" (only copy_source_prefix load_input_assets))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset)))
	(use wove-file "../source/scan.wove" (only admit_source check_source_form build_source_tree check_source_metadata (type SourceNode)))
	(use wove-file "../source/module.wove" (only read_module_for_target (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../emit/c.wove" (only emit_module))

	(fn emit_input
		(:doc `Retry a short emitter destination, retaining only the first complete unit.`)
		(params (path (shared-slice u8)) (destination (shared-slice u8))
			(target_index i32) (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (module ModuleRead)
			(declarations (shared-slice SelectedDeclaration)) (assets (mut-slice EmbedAsset)))
		(returns i32)
		(body
			(let-mut capacity 4096i32)
			(while
				(:doc "Bound buffer growth by the signed slice ABI.")
				(bool true)
				(body
					(let-mut output (array.alloc u8 (local capacity)))
					(let result (call emit_module (borrow-shared (local source)) (borrow-shared (local nodes))
						(local module) (borrow-shared (local declarations)) 0i32 0i32
						(borrow-mut (local assets)) (bool false) (borrow-mut (local output))))
					(let error (record.get (local result) error))
					(if
						(:doc "Only a successful emitter can publish an artifact.")
						(u32.eq (local error) 0u32)
						(then
							(return (call publish_input (borrow-shared (local path)) (borrow-shared (local destination)) (local target_index)
								(borrow-shared (slice.range (local output) 0i32 (record.get (local result) written)))))))
					(if
						(:doc "A source error or exhausted growth limit retains the emitter's span.")
						(bool.or (bool.not (u32.eq (local error) 16u32)) (i32.lt 1073741823i32 (local capacity)))
						(then (return (call report_source (borrow-shared (local path)) (local error)
							(record.get (local result) start) (record.get (local result) end) (borrow-shared (local invalid_source))))))
					(set (local capacity) (i32.add.wrapping (local capacity) (local capacity)))))
			(return 1i32)))

	(fn compile_assets
		(:doc `Collect checked embed requests, load selected assets, and emit from the resulting arena.`)
		(params (path (shared-slice u8)) (canonical (shared-slice u8)) (destination (shared-slice u8))
			(target_index i32) (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (module ModuleRead)
			(declarations (shared-slice SelectedDeclaration)))
		(returns i32)
		(body
			(let-mut requests (array.alloc EmbedAsset (slice.len (local nodes))))
			(let-mut none (array.alloc u8 0i32))
			(let checked (call emit_module (borrow-shared (local source)) (borrow-shared (local nodes))
				(local module) (borrow-shared (local declarations)) 0i32 0i32
				(borrow-mut (local requests)) (bool true) (borrow-mut (local none))))
			(if
				(:doc "The semantic plan reports malformed or ill-typed source before requesting any files.")
				(u32.lt 0u32 (record.get (local checked) error))
				(then (return (call report_source (borrow-shared (local path)) (record.get (local checked) error)
					(record.get (local checked) start) (record.get (local checked) end) (borrow-shared (local invalid_source))))))
			(if
				(:doc "A module without active embeds already has a complete source arena.")
				(i32.eq (record.get (local checked) written) 0i32)
				(then (return (call emit_input (borrow-shared (local path)) (borrow-shared (local destination)) (local target_index)
					(borrow-shared (local source)) (borrow-shared (local nodes))
					(local module) (borrow-shared (local declarations)) (borrow-mut (local requests))))))
			(let measured (call load_input_assets (borrow-shared (local canonical)) (borrow-shared (local source))
				(borrow-mut (local requests)) (borrow-mut (local none)) (bool false)))
			(if
				(:doc "A missing or invalid asset is diagnosed at the selected path token.")
				(u32.lt 0u32 (record.get (local measured) error))
				(then (return (call report_source (borrow-shared (local path)) (record.get (local measured) error)
					(record.get (local measured) start) (record.get (local measured) end) (borrow-shared (local unreadable_asset))))))
			(let-mut arena (array.alloc u8 (record.get (local measured) count)))
			(call copy_source_prefix (borrow-shared (local source)) (borrow-mut (local arena)))
			(let loaded (call load_input_assets (borrow-shared (local canonical)) (borrow-shared (local source))
				(borrow-mut (local requests)) (borrow-mut (local arena)) (bool true)))
			(if
				(:doc "A failed or changed file cannot leave partial data in retained C.")
				(u32.lt 0u32 (record.get (local loaded) error))
				(then (return (call report_source (borrow-shared (local path)) (record.get (local loaded) error)
					(record.get (local loaded) start) (record.get (local loaded) end) (borrow-shared (local unreadable_asset))))))
			(return (call emit_input (borrow-shared (local path)) (borrow-shared (local destination)) (local target_index)
				(borrow-shared (local arena)) (borrow-shared (local nodes))
				(local module) (borrow-shared (local declarations)) (borrow-mut (local requests))))))

	(fn compile_input
		(:doc `Validate both operands before reading the source and selecting the native module.`)
		(params (path (shared-slice u8)) (target (shared-slice u8)) (profile (shared-slice u8)) (mode u32)
			(input_index i32) (target_index i32))
		(returns i32)
		(body
			(if
				(:doc "Only a UTF-8 source path can appear in the JSON source location.")
				(i32.lt -1i32 (call admit_source (borrow-shared (local path))))
				(then (return (call report_argv 3u32 (local input_index) (borrow-shared (local non_utf8_source))))))
			(if
				(:doc "Reject a malformed output operand before opening the source.")
				(bool.not (call valid_output_target (borrow-shared (local target))))
				(then (return (call report_argv 3u32 (local target_index) (borrow-shared (local invalid_target))))))
			(let destination (call retained_c_path (borrow-shared (local target)) (borrow-shared (local profile)) (local mode)))
			(let canonical (call canonical_path (borrow-shared (local path))))
			(let stamp (call file_stamp (borrow-shared (local canonical))))
			(let length (record.get (local stamp) length))
			(if
				(:doc "A missing or unreadable file has no source bytes yet.")
				(i32.lt (local length) 0i32)
				(then (return (call report_source (borrow-shared (local path)) 64u32 0i32 0i32 (borrow-shared (local unreadable_file))))))
			(let-mut source (array.alloc u8 (local length)))
			(let read (call read_source_file (borrow-shared (local canonical)) (local stamp) (borrow-mut (local source))))
			(if
				(:doc "Keep a failed read at the input path.")
				(bool.not (local read))
				(then (return (call report_source (borrow-shared (local path)) 64u32 0i32 0i32 (borrow-shared (local unreadable_file))))))
			(let checked (call check_source_form (borrow-shared (local source))))
			(if
				(:doc "Lexing and form errors already identify their original byte spans.")
				(u32.lt 0u32 (record.get (local checked) error))
				(then (return (call report_source (borrow-shared (local path)) (record.get (local checked) error)
					(record.get (local checked) start) (record.get (local checked) end) (borrow-shared (local invalid_source))))))
			(let rows (int.convert i32 (record.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let metadata (call check_source_metadata (borrow-shared (local source)) (local built) (borrow-shared (local nodes))))
			(let-mut declarations (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes))
				(local metadata) (call native_selection) (borrow-mut (local declarations))))
			(if
				(:doc "Start disk loading only when the selected entry has a Wove-file edge.")
				(bool.and (u32.eq (record.get (local module) error) 0u32)
					(call has_active_use (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local declarations)) (record.get (local module) count) 3u32))
				(then (return (call compile_disk_graph (borrow-shared (local path)) (borrow-shared (local destination)) (local target_index)
					(borrow-shared (local canonical)) (borrow-shared (local source)) (local stamp)))))
			(if
				(:doc "C-header imports use the supplied-source graph with the embedded providers.")
				(bool.and (u32.eq (record.get (local module) error) 0u32)
					(call has_active_use (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local declarations)) (record.get (local module) count) 8u32))
				(then (return (call compile_bundled_input (borrow-shared (local path)) (borrow-shared (local canonical))
					(borrow-shared (local destination)) (local target_index) (borrow-shared (local source)) (local rows)))))
			(return (call compile_assets (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (local target_index) (borrow-shared (local source)) (borrow-shared (local nodes))
				(local module) (borrow-shared (local declarations)))))))
