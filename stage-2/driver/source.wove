(module native_cli_source
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read one explicit source and choose single-file or graph emission.

	Check the entry and use its active selections to choose the emitter. Measure
	and write C with the shared emitter, keeping the file's original spans
	on failure. Publish only a complete emitted translation unit.`)

	(use wove-file "./diagnostics.wove" (only report_source
		(value invalid_source) (value unreadable_file) (value unreadable_asset)))
	(use wove-file "./output.wove" (only publish_input))
	(use wove-file "./input_files.wove" (only check_asset_inputs))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./disk.wove" (only compile_disk_graph))
	(use wove-file "./files.wove" (only canonical_path file_stamp read_source_file))
	(use wove-file "./platform.wove" (only native_selection))
	(use wove-file "./graph.wove" (only needs_provider_graph compile_bundled_input))
	(use wove-file "./assets.wove" (only copy_source_prefix load_input_assets))
	(use wove-file "../source/assets.wove" (only (type EmbedAsset)))
	(use wove-file "../source/scan.wove" (only check_source_form build_source_tree check_source_metadata (type SourceNode)))
	(use wove-file "../source/module.wove" (only read_module_for_target (type ModuleRead) (type SelectedDeclaration)))
	(use wove-file "../emit/c.wove" (only emit_module))

	(fn emit_input
		(:doc `Retry a short emitter destination, retaining only the first complete unit.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(target_index i32) (source (shared-array u8)) (nodes (shared-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)) (assets (mut-array EmbedAsset)))
		(returns i32)
		(body
			(let-mut capacity 4096i32)
			(while
				(:doc "Bound buffer growth by the signed slice ABI.")
				(bool true)
				(body
					(let-mut output (array.alloc u8 (local capacity)))
					(let result (call emit_module (borrow-shared (local source)) (borrow-shared (local nodes))
						(local module) (borrow-shared (local declarations)) 0i32 0i32
						(borrow-mut (local assets)) (bool false) (borrow-mut (local output))))
					(let error (struct.get (local result) error))
					(if
						(:doc "Only a successful emitter can publish an artifact.")
						(u32.eq (local error) 0u32)
						(then
							(return (call publish_input (borrow-shared (local path)) (borrow-shared (local destination)) (borrow-shared (local staged)) (local target_index)
								(borrow-shared (array.range (local output) 0i32 (struct.get (local result) written)))))))
					(if
						(:doc "A source error or exhausted growth limit retains the emitter's span.")
						(bool.or (bool.not (u32.eq (local error) 16u32)) (i32.lt 1073741823i32 (local capacity)))
						(then (return (call report_source (borrow-shared (local path)) (local error)
							(struct.get (local result) start) (struct.get (local result) end) (borrow-shared (local invalid_source))))))
					(set (local capacity) (i32.add.wrapping (local capacity) (local capacity)))))
			(return 1i32)))

	(fn compile_assets
		(:doc `Collect checked embed requests, load selected assets, and emit from the resulting arena.`)
		(params (path (shared-array u8)) (canonical (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool)
			(source (shared-array u8)) (nodes (shared-array SourceNode)) (module ModuleRead)
			(declarations (shared-array SelectedDeclaration)))
		(returns i32)
		(body
			(let-mut requests (array.alloc EmbedAsset (array.len (local nodes))))
			(let-mut none (array.alloc u8 0i32))
			(let checked (call emit_module (borrow-shared (local source)) (borrow-shared (local nodes))
				(local module) (borrow-shared (local declarations)) 0i32 0i32
				(borrow-mut (local requests)) (bool true) (borrow-mut (local none))))
			(if
				(:doc "The semantic plan reports malformed or ill-typed source before requesting any files.")
				(u32.lt 0u32 (struct.get (local checked) error))
				(then (return (call report_source (borrow-shared (local path)) (struct.get (local checked) error)
					(struct.get (local checked) start) (struct.get (local checked) end) (borrow-shared (local invalid_source))))))
			(if
				(:doc "A module without active embeds already has a complete source arena.")
				(i32.eq (struct.get (local checked) written) 0i32)
				(then
					(if (local check_only) (then (return 0i32)))
					(return (call emit_input (borrow-shared (local path)) (borrow-shared (local destination)) (borrow-shared (local staged)) (local target_index)
					(borrow-shared (local source)) (borrow-shared (local nodes))
					(local module) (borrow-shared (local declarations)) (borrow-mut (local requests))))))
			(if
				(:doc "Check destination aliases when this invocation will publish.")
				(bool.not (local check_only))
				(then
					(let no_files (array.alloc SuppliedFile 0i32))
					(let conflict (call check_asset_inputs (borrow-shared (local canonical)) (borrow-shared (local source))
						(borrow-shared (local no_files)) (borrow-shared (local requests)) (local protection)))
					(if (i32.lt 0i32 (local conflict)) (then (return (local conflict))))))
			(let measured (call load_input_assets (borrow-shared (local canonical)) (borrow-shared (local source))
				(borrow-mut (local requests)) (borrow-mut (local none)) (bool false)))
			(if
				(:doc "A missing or invalid asset is diagnosed at the selected path token.")
				(u32.lt 0u32 (struct.get (local measured) error))
				(then (return (call report_source (borrow-shared (local path)) (struct.get (local measured) error)
					(struct.get (local measured) start) (struct.get (local measured) end) (borrow-shared (local unreadable_asset))))))
			(let-mut arena (array.alloc u8 (struct.get (local measured) count)))
			(call copy_source_prefix (borrow-shared (local source)) (borrow-mut (local arena)))
			(let loaded (call load_input_assets (borrow-shared (local canonical)) (borrow-shared (local source))
				(borrow-mut (local requests)) (borrow-mut (local arena)) (bool true)))
			(if
				(:doc "A failed or changed file cannot leave partial data in retained C.")
				(u32.lt 0u32 (struct.get (local loaded) error))
				(then (return (call report_source (borrow-shared (local path)) (struct.get (local loaded) error)
					(struct.get (local loaded) start) (struct.get (local loaded) end) (borrow-shared (local unreadable_asset))))))
			(if
				(:doc "The checked single module and its selected assets are ready.")
				(local check_only)
				(then (return 0i32)))
			(return (call emit_input (borrow-shared (local path)) (borrow-shared (local destination)) (borrow-shared (local staged)) (local target_index)
				(borrow-shared (local arena)) (borrow-shared (local nodes))
				(local module) (borrow-shared (local declarations)) (borrow-mut (local requests))))))

	(fn compile_input
		(:doc `Read the checked entry and select the emitter while carrying its publication protection.`)
		(params (path (shared-array u8)) (destination (shared-array u8)) (staged (shared-array u8))
			(probe_options (shared-array u8)) (protection BuildProtection) (target_index i32) (check_only bool))
		(returns i32)
		(body
			(let canonical (call canonical_path (borrow-shared (local path))))
			(let stamp (call file_stamp (borrow-shared (local canonical))))
			(let length (struct.get (local stamp) length))
			(if
				(:doc "A missing or unreadable file has no source bytes yet.")
				(i32.lt (local length) 0i32)
				(then (return (call report_source (borrow-shared (local path)) 64u32 0i32 0i32 (borrow-shared (local unreadable_file))))))
			(let-mut source (array.alloc u8 (local length)))
			(let read (call read_source_file (borrow-shared (local canonical)) (local stamp) (borrow-mut (local source))))
			(if
				(:doc "Keep a failed read at the input path.")
				(bool.not (local read))
				(then (return (call report_source (borrow-shared (local path)) 64u32 0i32 0i32 (borrow-shared (local unreadable_file))))))
			(let checked (call check_source_form (borrow-shared (local source))))
			(if
				(:doc "Lexing and form errors already identify their original byte spans.")
				(u32.lt 0u32 (struct.get (local checked) error))
				(then (return (call report_source (borrow-shared (local path)) (struct.get (local checked) error)
					(struct.get (local checked) start) (struct.get (local checked) end) (borrow-shared (local invalid_source))))))
			(let rows (int.convert i32 (struct.get (local checked) rows)))
			(let-mut nodes (array.alloc SourceNode (local rows)))
			(let built (call build_source_tree (borrow-shared (local source)) (local checked) (borrow-mut (local nodes))))
			(let metadata (call check_source_metadata (borrow-shared (local source)) (local built) (borrow-shared (local nodes))))
			(let-mut declarations (array.alloc SelectedDeclaration (local rows)))
			(let module (call read_module_for_target (borrow-shared (local source)) (borrow-shared (local nodes))
				(local metadata) (call native_selection) (borrow-mut (local declarations))))
			(if
				(:doc "Start disk loading only when the selected entry has a Wove-file edge.")
				(bool.and (u32.eq (struct.get (local module) error) 0u32)
					(call needs_provider_graph (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local declarations)) (struct.get (local module) count) 3u32))
				(then (return (call compile_disk_graph (borrow-shared (local path)) (borrow-shared (local destination)) (borrow-shared (local staged)) (borrow-shared (local probe_options))
					(local protection) (local target_index) (local check_only)
					(borrow-shared (local canonical)) (borrow-shared (local source)) (local stamp)))))
			(if
				(:doc "C-header imports and declarations use the supplied-source graph with the embedded providers.")
				(bool.and (u32.eq (struct.get (local module) error) 0u32)
					(call needs_provider_graph (borrow-shared (local source)) (borrow-shared (local nodes))
						(borrow-shared (local declarations)) (struct.get (local module) count) 8u32))
				(then (return (call compile_bundled_input (borrow-shared (local path)) (borrow-shared (local canonical))
					(borrow-shared (local destination)) (borrow-shared (local staged)) (borrow-shared (local probe_options))
					(local protection) (local target_index) (local check_only) (borrow-shared (local source)) (local rows)))))
			(return (call compile_assets (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local staged))
				(local protection) (local target_index) (local check_only) (borrow-shared (local source)) (borrow-shared (local nodes))
				(local module) (borrow-shared (local declarations)))))))
