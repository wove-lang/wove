(module native_cli_files
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Snapshot regular source files through the checked-in native POSIX bindings.

	Canonical paths supply an importer's directory. Device and inode
	identify the opened file independently of its spelling. Recheck the
	identity and extent before reading and reject changed lengths.`)

	(use c-header "<stdlib.h>" (only realpath))
	(use c-header "<sys/stat.h>" (only stat fstat S_ISREG (type Stat) (type Device)))
	(use c-header "<fcntl.h>" (only open O_RDONLY O_NONBLOCK O_CLOEXEC (type Mode)))
	(use c-header "<unistd.h>" (only read close (type Size)))
	(use c-header "<errno.h>" (only EINTR ENOENT errno))
	(use wove-file "../source/scan.wove" (only admit_source))
	(use wove-file "../text/copy.wove" (only append_bytes))

	(struct FileStamp (fields (device u64) (inode u64) (length i32)))
	(struct FileIdentity (fields (device u64) (inode u64) (present bool)))

	(fn empty_path
		(:doc `A canonical absolute path is never empty. Use an empty owner for failure.`)
		(params) (returns (owned-array u8))
		(body
			(let empty (array:alloc u8 0i32))
			(return (move empty))))

	(fn canonical_path
		(:doc `Return owned canonical path bytes or an empty owner on lookup failure.`)
		(params (path (shared-array u8))) (returns (owned-array u8))
		(body
			(if path.len.eqz (then (return (call empty_path))))
			(let-mut cursor 0i32)
			(while
				(:doc "Prevent an embedded NUL from changing which path reaches libc.")
				(cursor.lt path.len)
				(body
					(if (u8:eqz (path.get cursor)) (then (return (call empty_path))))
					(set cursor cursor.inc)))
			(let resolved (call realpath (borrow-shared path) null))
			(if resolved.is-null (then (return (call empty_path))))
			(let result (move resolved.unwrap))
			(if
				(:doc "A canonical source must have a UTF-8 path for the graph and JSON diagnostics.")
				(i32:lt -1i32 (call admit_source (borrow-shared result)))
				(then (return (call empty_path))))
			(return (move result))))

	(fn invalid_file_stamp
		(:doc `Use a negative byte extent to mark an unavailable regular source.`)
		(params) (returns FileStamp)
		(body (return (struct:new FileStamp (device 0u64) (inode 0u64) (length -1i32)))))

	(fn device_key
		(:doc `Linux device numbers retain all bits as unsigned native values.`)
		(:pragma (cfg (os "linux")))
		(params (value Device)) (returns u64)
		(body (return (int:convert u64 value))))

	(fn device_key
		(:doc `Map every signed Darwin device number injectively into the unsigned key range.`)
		(:pragma (cfg (os "macos")))
		(params (value Device)) (returns u64)
		(body
			(let signed (int:convert i32 value))
			(if
				(:doc "Bias the signed device range without trapping on a negative native value.")
				signed.ltz
				(then (return (u64:from-i32 (signed.sub -2147483648i32)))))
			(return (u64:add 2147483648u64 (u64:from-i32 signed)))))

	(fn checked_stamp
		(:doc `Accept regular files whose nonnegative POSIX size fits the source arena.`)
		(params (info Stat)) (returns FileStamp)
		(body
			(if
				(:doc "Directory and device contents cannot enter the source graph.")
				(bool:not (call S_ISREG info/st_mode))
				(then (return (call invalid_file_stamp))))
			(let size (int:convert u64 info/st_size))
			(if
				(:doc "Keep room for the checked source tree's sentinel row.")
				(u64:lt 2147483646u64 size)
				(then (return (call invalid_file_stamp))))
			(return (struct:new FileStamp (device (call device_key info/st_dev))
				(inode (int:convert u64 info/st_ino)) (length (i32:from-u64 size))))))

	(fn file_is_absent
		(:doc "Distinguish a missing optional file from other failures to obtain a regular-file snapshot.")
		(params (stamp FileStamp)) (returns bool)
		(body (return (stamp/length.eq -2i32))))

	(fn file_stamp
		(:doc "Identify a regular path. Preserve absence separately from a failed or unsuitable lookup.")
		(params (path (shared-array u8))) (returns FileStamp)
		(body
			(let-mut info (struct:new Stat))
			(if
				(:doc "An unavailable path has no cache key.")
				(i32:not-eqz (call stat (borrow-shared path) (borrow-mut info)))
				(then
					(if
						(:doc "Only ENOENT allows an optional file to be treated as absent.")
						(errno.eq ENOENT)
						(then (return (struct:new FileStamp (device 0u64) (inode 0u64) (length -2i32)))))
					(return (call invalid_file_stamp))))
			(return (call checked_stamp info))))

	(fn descriptor_stamp
		(:doc `Read the identity and size of the exact descriptor acquiring a source snapshot.`)
		(params (descriptor i32)) (returns FileStamp)
		(body
			(let-mut info (struct:new Stat))
			(if
				(:doc "A failed descriptor query cannot validate source bytes.")
				(i32:not-eqz (call fstat descriptor (borrow-mut info)))
				(then (return (call invalid_file_stamp))))
			(return (call checked_stamp info))))

	(fn same_file_stamp
		(:doc `Compare valid device and inode keys without relying on path spelling.`)
		(params (left FileStamp) (right FileStamp)) (returns bool)
		(body (return (bool:and
			(bool:and (i32:lt -1i32 left/length) (i32:lt -1i32 right/length))
			(bool:and (left/device.eq right/device)
				(left/inode.eq right/inode))))))

	(fn path_identity
		(:doc "Read only the identity of an existing path. Size and file kind are irrelevant to collision checks.")
		(params (path (shared-array u8))) (returns FileIdentity)
		(body
			(let-mut info (struct:new Stat))
			(if
				(:doc "A failed stat supplies no identity.")
				(i32:not-eqz (call stat (borrow-shared path) (borrow-mut info)))
				(then (return (struct:new FileIdentity (device 0u64) (inode 0u64) (present (bool false))))))
			(return (struct:new FileIdentity (device (call device_key info/st_dev))
				(inode (int:convert u64 info/st_ino)) (present (bool true))))))

	(fn same_path_identity
		(:doc "Compare two known native file identities, following aliases resolved by stat.")
		(params (left FileIdentity) (right FileIdentity)) (returns bool)
		(body (return (bool:and
			(left/present.and right/present)
			(bool:and (left/device.eq right/device)
				(left/inode.eq right/inode))))))

	(fn read_chunk
		(:doc `Retry a POSIX read interrupted before any bytes were returned.`)
		(params (descriptor i32) (chunk (mut-array u8)) (count i32)) (returns i32)
		(body
			(while
				(:doc "Capture errno immediately when read returns a failure.")
				(bool true)
				(body
					(let amount (int:convert i32 (call read descriptor (borrow-mut chunk)
						(int:convert Size count))))
					(if
						(:doc "Return a short read, EOF, or any permanent error to the exact-length loop.")
						(bool:or (i32:lt -1i32 amount) (errno.not-eq EINTR))
						(then (return amount)))))))

	(fn read_open_file
		(:doc `Read exactly the measured extent and verify that there is no trailing byte.`)
		(params (descriptor i32) (output (mut-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(let allocated (array:try-alloc u8 32768i32))
			(if allocated.is-null (then (return (bool false))))
			(let-mut chunk (move allocated.unwrap))
			(let-mut offset start)
			(while
				(:doc "Advance by the number of bytes actually supplied by each bounded read.")
				(offset.lt end)
				(body
					(let-mut count (end.sub offset))
					(if
						(:doc "Keep the temporary independent of the source size.")
						(i32:lt 32768i32 count)
						(then (set count 32768i32)))
					(let amount (call read_chunk descriptor (borrow-mut chunk) count))
					(if
						(:doc "A permanent failure or early EOF invalidates the measured snapshot.")
						(amount.lt 1i32)
						(then (return (bool false))))
					(set offset (call append_bytes (borrow-shared (chunk.range 0i32 amount))
						(borrow-mut output) offset))))
			(return (i32:eqz (call read_chunk descriptor (borrow-mut chunk) 1i32)))))

	(fn verify_open_file
		(:doc `Verify that opening a path yielded the same regular file and measured length.`)
		(params (descriptor i32) (expected FileStamp) (output (mut-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(let opened (call descriptor_stamp descriptor))
			(if
				(:doc "Reject a replaced file or changed size before copying any bytes.")
				(bool:not (bool:and (call same_file_stamp expected opened)
					(opened/length.eq (end.sub start))))
				(then (return (bool false))))
			(return (call read_open_file descriptor (borrow-mut output) start end))))

	(fn read_file_range
		(:doc "Read a verified regular file into an exact range, closing its descriptor once.")
		(params (path (shared-array u8)) (expected FileStamp) (output (mut-array u8)) (start i32) (end i32)) (returns bool)
		(body
			(if
				(:doc "Reject invalid output spans before opening or writing any bytes.")
				(start.ltz.or
					(bool:or (end.lt start) (output.len.lt end)))
				(then (return (bool false))))
			(let flags (i32:from-u32 (u32:or (u32:from-i32 O_RDONLY)
				(u32:or (u32:from-i32 O_NONBLOCK) (u32:from-i32 O_CLOEXEC)))))
			(let descriptor (call open (borrow-shared path) flags (int:convert Mode 0i32)))
			(if descriptor.ltz (then (return (bool false))))
			(let complete (call verify_open_file descriptor expected (borrow-mut output) start end))
			(let closed (call close descriptor))
			(return (complete.and closed.eqz))))

	(fn read_source_file
		(:doc "Read the verified source snapshot into the full caller-provided view.")
		(params (path (shared-array u8)) (expected FileStamp) (output (mut-array u8))) (returns bool)
		(body
			(let length output.len)
			(return (call read_file_range (borrow-shared path) expected (borrow-mut output)
				0i32 length))))
)
