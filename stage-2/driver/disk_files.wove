(module native_cli_disk_files
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Resolve one requested disk edge and publish its provider only after the source is read.

	Keep a canonical path for relative lookup and compare device and inode
	to reuse an immutable snapshot reached through any other spelling.`)

	(use wove-file "./protection.wove" (only protected_input report_input_collision (type BuildProtection)))
	(use wove-file "./paths.wove" (only join_file_path directory_width))
	(use wove-file "./files.wove" (only canonical_path empty_path file_stamp read_source_file same_file_stamp (type FileStamp)))
	(use wove-file "../source/paths.wove" (only append_component (type SuppliedFile)))
	(use wove-file "../source/scan.wove" (only (type Token)))
	(use wove-file "../source/strings.wove" (only decode_string (type DecodeResult)))
	(use wove-file "../source/graph.wove" (only (type GraphResult) (type DiskEdge)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../text/bytes.wove" (only same_bytes))

	(struct DiskFile (fields (source SuppliedFile) (stamp FileStamp)))
	(struct DiskSpace (fields (bytes i32) (files i32) (edges i32)))
	(struct DiskRead (fields (space DiskSpace) (start i32) (end i32) (error u32) (grow bool) (exit_status i32)))

	(fn disk_space
		(:doc `Keep the initialized byte and table prefixes together.`)
		(params (bytes i32) (files i32) (edges i32)) (returns DiskSpace)
		(body (return (struct:new DiskSpace (bytes bytes) (files files) (edges edges)))))

	(fn disk_read
		(:doc `Return an updated or requested capacity with the originating edge span.`)
		(params (space DiskSpace) (start i32) (end i32) (error u32) (grow bool)) (returns DiskRead)
		(body (return (struct:new DiskRead (space space) (start start) (end end)
			(error error) (grow grow) (exit_status 0i32)))))

	(fn disk_edge_error
		(:doc `Report an unavailable or unrepresentable target at its full importing use.`)
		(params (used DiskSpace) (request GraphResult) (code u32)) (returns DiskRead)
		(body (return (call disk_read used (struct:get request start) (struct:get request end)
			code (bool false)))))

	(fn find_disk_file
		(:doc `Look up a native identity among completed snapshots.`)
		(params (files (shared-array DiskFile)) (count i32) (stamp FileStamp)) (returns i32)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Bundled rows have invalid stamps and cannot shadow a disk file.")
				(i32:lt index count)
				(body
					(let known (struct:get (array:load files index) stamp))
					(if (call same_file_stamp known stamp) (then (return index)))
					(set index (i32:inc index))))
			(return -1i32)))

	(fn store_disk_edge
		(:doc `Associate this exact active use with the provider's canonical row.`)
		(params (edges (mut-array DiskEdge)) (index i32) (request GraphResult) (provider i32)) (returns void)
		(body
			(array:store edges index
				(struct:new DiskEdge (file (struct:get request file)) (start (struct:get request start))
					(target provider) (path_start 0i32) (path_end 0i32) (error_start 0i32) (error_end 0i32) (error 0u32)))))

	(fn empty_view
		(:doc `An empty path owner represents a failed canonical lookup.`)
		(params (bytes (shared-array u8))) (returns bool)
		(body (return (i32:eqz (array:len bytes)))))

	(fn join_disk_path
		(:doc `Join a literal against the canonical importer's directory before letting libc follow symlinks and dot components.`)
		(params (arena (shared-array u8)) (importer SuppliedFile) (literal (shared-array u8))) (returns (owned-array u8))
		(body
			(return (call join_file_path
				(borrow-shared (array:range arena (struct:get importer path_start) (struct:get importer path_end)))
				(borrow-shared literal)))))

	(fn load_new_disk_file
		(:doc `Make the complete immutable source and path visible to the next resolver pass.`)
		(params (canonical (shared-array u8)) (stamp FileStamp) (used DiskSpace) (request GraphResult)
			(arena (mut-array u8)) (files (mut-array DiskFile)) (edges (mut-array DiskEdge))) (returns DiskRead)
		(body
			(let length (struct:get stamp length))
			(let start (struct:get used bytes))
			(let index (struct:get used files))
			(let edge (struct:get used edges))
			(let width (array:len canonical))
			(if
				(:doc "Check aggregate widths before allocating or opening the source.")
				(bool:or (i32:lt (i32:sub 2147483647i32 start) width)
					(i32:lt (i32:sub 2147483647i32 (i32:add start width)) length))
				(then (return (call disk_edge_error used request 16u32))))
			(let path_end (i32:add start width))
			(let finish (i32:add path_end length))
			(let required (call disk_space finish (i32:inc index)
				(i32:inc edge)))
			(if
				(:doc "Grow storage before loading so retries never read the same new source twice.")
				(bool:or (i32:lt (array:len arena) finish) (i32:not-lt index (array:len files)))
				(then (return (call disk_read required 0i32 0i32 0u32 (bool true)))))
			(let-mut source (array:alloc u8 length))
			(if
				(:doc "A changed or unreadable file cannot publish a partial graph row.")
				(bool:not (call read_source_file (borrow-shared canonical) stamp (borrow-mut source)))
				(then (return (call disk_edge_error used request 27u32))))
			(let copy_path (call append_bytes (borrow-shared canonical) (borrow-mut arena) start))
			(let copied (call append_bytes (borrow-shared source) (borrow-mut arena) copy_path))
			(array:store files index
				(struct:new DiskFile (source (struct:new SuppliedFile (identity index)
					(path_start start) (path_end copy_path) (source_start copy_path) (source_end copied) (bundled (bool false))))
					(stamp stamp)))
			(call store_disk_edge (borrow-mut edges) edge request index)
			(return (call disk_read required 0i32 0i32 0u32 (bool false)))))

	(fn decode_use_path
		(:doc `Decode the original quoted token in its importing source view.`)
		(params (arena (shared-array u8)) (importer SuppliedFile) (start i32) (end i32) (output (mut-array u8)))
		(returns DecodeResult)
		(body
			(return (call decode_string
				(borrow-shared (array:range arena (struct:get importer source_start) (struct:get importer source_end)))
				(struct:new Token (kind 2u32) (start start) (end end) (error 0u32))
				(borrow-mut output)))))

	(fn load_disk_edge
		(:doc `Decode the selected use, canonicalize it, and load a new identity only when needed.`)
		(params (used DiskSpace) (request GraphResult) (protection BuildProtection) (arena (mut-array u8)) (files (mut-array DiskFile))
			(edges (mut-array DiskEdge)) (human bool)) (returns DiskRead)
		(body
			(let edge (struct:get used edges))
			(let count (struct:get used files))
			(if
				(:doc "The edge and file tables must retain signed indices.")
				(bool:or (i32:eq edge 2147483647i32) (i32:eq count 2147483647i32))
				(then (return (call disk_edge_error used request 16u32))))
			(if
				(:doc "Reserve the edge row before opening any provider.")
				(i32:eq edge (array:len edges))
				(then (return (call disk_read (call disk_space (struct:get used bytes) count
					(i32:inc edge)) 0i32 0i32 0u32 (bool true)))))
			(let importer (struct:get (array:load files (struct:get request file)) source))
			(let start (struct:get request path_start))
			(let end (struct:get request path_end))
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let value (call decode_use_path (borrow-shared arena) importer start end
				(borrow-mut decoded)))
			(if
				(:doc "Report an invalid escape at the literal before calling libc.")
				(u32:gtz (struct:get value error))
				(then (return (call disk_read used (struct:get value start) (struct:get value end)
					(struct:get value error) (bool false)))))
			(let joined (call join_disk_path (borrow-shared arena) importer
				(borrow-shared (array:range decoded 0i32 (struct:get value written)))))
			(let canonical (call canonical_path (borrow-shared joined)))
			(if
				(:doc "A missing path points to the source use that requested it.")
				(call empty_view (borrow-shared canonical))
				(then (return (call disk_edge_error used request 27u32))))
			(let stamp (call file_stamp (borrow-shared canonical)))
			(if
				(:doc "Only a regular file of representable length can be a source input.")
				(i32:ltz (struct:get stamp length))
				(then (return (call disk_edge_error used request 27u32))))
			(if
				(:doc `Check each active spelling before deduplication can hide an alias inside the retained tree.`)
				(call protected_input (borrow-shared joined) protection)
				(then
					(let status (call report_input_collision (borrow-shared canonical) human))
					(return (struct:new DiskRead (space used) (start 0i32) (end 0i32)
						(error 0u32) (grow (bool false)) (exit_status status)))))
			(let known (call find_disk_file (borrow-shared files) count stamp))
			(if
				(:doc "Alias paths publish an edge to the cached file without reopening its contents.")
				(i32:lt -1i32 known)
				(then
					(call store_disk_edge (borrow-mut edges) edge request known)
					(return (call disk_read (call disk_space (struct:get used bytes) count
						(i32:inc edge)) 0i32 0i32 0u32 (bool false)))))
			(return (call load_new_disk_file (borrow-shared canonical) stamp used request
				(borrow-mut arena) (borrow-mut files) (borrow-mut edges)))))
	(fn failed_path_suffix
		(:doc "Join the physical prefix and unresolved suffix. Retain parent components beyond the first failed lookup.")
		(params (prefix (shared-array u8)) (suffix (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let width (array:len prefix))
			(let tail (array:len suffix))
			(if
				(:doc "An unrepresentable diagnostic key simply cannot be deduplicated.")
				(i32:lt (i32:sub 2147483647i32 width) tail)
				(then (return (call empty_path))))
			(let-mut bytes (array:alloc u8 (i32:add width tail)))
			(let-mut end 0i32)
			(if
				(:doc "The first suffix separator also supplies the slash of a physical root prefix.")
				(i32:not-eq width 1i32)
				(then (set end (call append_bytes (borrow-shared prefix) (borrow-mut bytes) 0i32))))
			(let-mut cursor 0i32)
			(while
				(:doc "Only redundant separators and single dots are interchangeable in the unresolved suffix.")
				(i32:lt cursor tail)
				(body
					(let start cursor)
					(while
						(:doc "Read the current component up to the next slash.")
						(bool:and (i32:lt cursor tail)
							(u8:not-eq (array:load suffix cursor) 47u8))
						(body (set cursor (i32:inc cursor))))
					(let length (i32:sub cursor start))
					(if
						(:doc "A nonempty component other than a dot stays in the diagnostic key.")
						(bool:and (i32:gtz length)
							(bool:not (bool:and (i32:eq length 1i32)
								(u8:eq (array:load suffix start) 46u8))))
						(then (set end (call append_component (borrow-shared suffix)
							start cursor (borrow-mut bytes) end))))
					(if (i32:lt cursor tail) (then (set cursor (i32:inc cursor))))))
			(let-mut exact (array:alloc u8 end))
			(let copied (call append_bytes (borrow-shared (array:range bytes 0i32 end)) (borrow-mut exact) 0i32))
			(return (move exact))))

	(fn disk_failure_key
		(:doc "Identify a failed disk target by its physical ancestor and remaining path components.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (edge DiskEdge))
		(returns (owned-array u8))
		(body
			(let importer (array:load files (struct:get edge file)))
			(let start (struct:get edge path_start))
			(let end (struct:get edge path_end))
			(let-mut decoded (array:alloc u8 (i32:sub end start)))
			(let parsed (call decode_use_path (borrow-shared arena) importer start
				end (borrow-mut decoded)))
			(if (u32:gtz (struct:get parsed error)) (then (return (call empty_path))))
			(let joined (call join_disk_path (borrow-shared arena) importer
				(borrow-shared (array:range decoded 0i32 (struct:get parsed written)))))
			(let length (array:len joined))
			(let file (call canonical_path (borrow-shared joined)))
			(if (i32:gtz (array:len file)) (then (return (move file))))
			(let-mut limit length)
			(while
				(:doc "Resolve the longest existing ancestor through the same filesystem rules as an ordinary import.")
				(i32:gtz limit)
				(body
					(let directory (call directory_width (borrow-shared (array:range joined 0i32 limit))))
					(if (i32:lt directory 2i32) (then (set limit 0i32)))
					(if
						(:doc "The root itself needs no additional canonical prefix in the key.")
						(i32:lt 1i32 directory)
						(then
							(set limit (i32:dec directory))
							(let parent (call canonical_path (borrow-shared (array:range joined 0i32 limit))))
							(if
								(:doc "The suffix still contains the separator before its first unresolved component.")
								(i32:gtz (array:len parent))
								(then (return (call failed_path_suffix (borrow-shared parent)
									(borrow-shared (array:range joined limit length))))))))))
			(let empty (array:alloc u8 0i32))
			(return (call failed_path_suffix (borrow-shared empty) (borrow-shared joined)))))

	(fn duplicate_disk_failure
		(:doc "Report the first importing span for the same unavailable source, even through a different relative spelling.")
		(params (arena (shared-array u8)) (files (shared-array SuppliedFile)) (edges (shared-array DiskEdge)) (current i32))
		(returns bool)
		(body
			(let key (call disk_failure_key (borrow-shared arena) (borrow-shared files)
				(array:load edges current)))
			(let width (array:len key))
			(if (i32:eqz width) (then (return (bool false))))
			(let-mut index 0i32)
			(while
				(:doc "The disk request cache follows the same Wove-edge walk as final binding.")
				(i32:lt index current)
				(body
					(let earlier (array:load edges index))
					(if
						(:doc "Only an earlier unavailable source competes for this diagnostic.")
						(u32:eq (struct:get earlier error) 27u32)
						(then
							(let prior (call disk_failure_key (borrow-shared arena) (borrow-shared files) earlier))
							(if
								(:doc "Equal physical prefixes and unresolved components represent one failed source.")
								(call same_bytes (borrow-shared key) 0i32 width
									(borrow-shared prior) 0i32 (array:len prior))
								(then (return (bool true))))))
					(set index (i32:inc index))))
			(return (bool false))))

)
