(module driver_snapshot_probes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Witness the fixed native call and layout used by an inline field snapshot.")

	(use wove-file "../clang/native_replay.wove" (only (value field_layout_witness_prefix)))
	(use wove-file "../emit/c_arguments.wove" (only c_symbol_text))
	(use wove-file "../emit/c_snapshots.wove" (only write_snapshot_symbol))
	(use wove-file "../emit/owners.wove" (only native_owner_contract write_native_type))
	(use wove-file "../emit/runtime.wove" (only write_c_number))
	(use wove-file "../emit/text.wove" (only c_literal_text))
	(use wove-file "../scalar/function_rows.wove" (only (type ScalarFunction) (type ScalarParameter)))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))

	(let result_type "wove_native_field_result_")
	(let record_type "wove_native_field_record_")
	(let type_start "typedef __typeof__((")
	(let argument_start ")((")
	(let typed_null ")0)) ")
	(let end_declaration ";\n")
	(let prototype_start "typedef char wove_native_field_prototype_")
	(let function_address "[_Generic(&(")
	(let function_result "),")
	(let function_parameter "(*)(")
	(let prototype_end "):1,default:-1)];\n")
	(let record_start "typedef __typeof__(*(")
	(let zero_pointer ")0")
	(let typedef_char "typedef char ")
	(let field_offset_start "[1+__builtin_offsetof(")
	(let comma ",")
	(let offset_end ")];\n")
	(let field_size_start "[sizeof(((")
	(let access_member ")0)->")
	(let member_type_start "typedef __typeof__(((")
	(let member_end ") ")
	(let extent_type_start "[_Generic(((")
	(let extent_type_end ",unsigned char:1,unsigned short:2,unsigned int:3,unsigned long:4,unsigned long long:5,default:-1)];\n")
	(let check_inline_start "[WVRT_C_SNAPSHOT_INLINE_CHAR((")
	(let check_inline_field ")0,")
	(let check_inline_end ")?1:-1];\n")
	(let field_offset_suffix "_field_offset")
	(let extent_offset_suffix "_extent_offset")
	(let extent_width_suffix "_extent_width")
	(let extent_type_suffix "_extent_type")
	(let field_type_suffix "_field_type")
	(let inline_check_suffix "_inline")

	(fn write_named_probe
		(:doc "Use the original declaration row to identify this observation across all native contexts.")
		(params (prefix (shared-array u8)) (declaration i32) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let name (call c_literal_text (borrow-shared prefix) (borrow-mut output) offset writing))
			(return (call write_c_number (borrow-mut output) name declaration writing))))

	(fn write_layout_name
		(:doc "Distinguish the facts of one snapshot by a stable suffix on its original declaration row.")
		(params (declaration i32) (fact (shared-array u8)) (output (mut-array u8)) (offset u32) (writing bool))
		(returns u32)
		(body
			(let prefix (call write_named_probe (borrow-shared field_layout_witness_prefix) declaration
				(borrow-mut output) offset writing))
			(return (call c_literal_text (borrow-shared fact) (borrow-mut output) prefix writing))))

	(fn write_member_offset
		(:doc "Encode the actual member byte offset in a positive folded C array bound.")
		(params (arena (shared-array u8)) (member SourceNode) (declaration i32) (fact (shared-array u8))
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width (call c_literal_text (borrow-shared typedef_char) (borrow-mut output) offset writing))
			(set width (call write_layout_name declaration (borrow-shared fact) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared field_offset_start) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared record_type) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared comma) (borrow-mut output) width writing))
			(set width (call write_snapshot_symbol (borrow-shared arena) member (borrow-mut output) width writing))
			(return (call c_literal_text (borrow-shared offset_end) (borrow-mut output) width writing))))

	(fn write_member_designator
		(:doc "Use the native result pointer in the same unevaluated field selection as the snapshot wrapper.")
		(params (arena (shared-array u8)) (member SourceNode) (declaration i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let pointer (call write_named_probe (borrow-shared result_type) declaration (borrow-mut output) offset writing))
			(let field (call c_literal_text (borrow-shared access_member) (borrow-mut output) pointer writing))
			(return (call write_snapshot_symbol (borrow-shared arena) member (borrow-mut output) field writing))))

	(fn write_snapshot_prototype
		(:doc "Infer the native return and require an exact fixed prototype with the original owner pointer argument.")
		(params (arena (shared-array u8)) (symbol SourceNode) (owner SourceNode) (declaration i32)
			(output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let-mut width (call c_literal_text (borrow-shared type_start) (borrow-mut output) offset writing))
			(set width (call c_symbol_text (borrow-shared arena) symbol (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared argument_start) (borrow-mut output) width writing))
			(set width (call write_native_type (borrow-shared arena) owner (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared typed_null) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared result_type) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared end_declaration) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared prototype_start) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared function_address) (borrow-mut output) width writing))
			(set width (call c_symbol_text (borrow-shared arena) symbol (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared function_result) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared result_type) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared function_parameter) (borrow-mut output) width writing))
			(set width (call write_native_type (borrow-shared arena) owner (borrow-mut output) width writing))
			(return (call c_literal_text (borrow-shared prototype_end) (borrow-mut output) width writing))))

	(fn write_field_snapshot_probe
		(:doc "Check the native member types and capture the offsets and extent width used by the original copy.")
		(params (arena (shared-array u8)) (nodes (shared-array SourceNode)) (function ScalarFunction)
			(parameter ScalarParameter) (output (mut-array u8)) (offset u32) (writing bool)) (returns u32)
		(body
			(let declaration (struct:get function declaration))
			(let symbol (array:get nodes (struct:get function name)))
			(let field (array:get nodes (struct:get function c_snapshot_field)))
			(let extent (array:get nodes (struct:get function c_snapshot_extent)))
			(let owner (call native_owner_contract (borrow-shared arena) (borrow-shared nodes) (struct:get parameter type)))
			(let-mut width (call write_snapshot_prototype (borrow-shared arena) symbol
				(array:get nodes (struct:get owner native)) declaration (borrow-mut output) offset writing))
			(set width (call c_literal_text (borrow-shared record_start) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared result_type) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared zero_pointer) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared member_end) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared record_type) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared end_declaration) (borrow-mut output) width writing))
			(set width (call write_member_offset (borrow-shared arena) field declaration
				(borrow-shared field_offset_suffix) (borrow-mut output) width writing))
			(set width (call write_member_offset (borrow-shared arena) extent declaration
				(borrow-shared extent_offset_suffix) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared typedef_char) (borrow-mut output) width writing))
			(set width (call write_layout_name declaration (borrow-shared extent_width_suffix) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared field_size_start) (borrow-mut output) width writing))
			(set width (call write_member_designator (borrow-shared arena) extent declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared offset_end) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared typedef_char) (borrow-mut output) width writing))
			(set width (call write_layout_name declaration (borrow-shared extent_type_suffix) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared extent_type_start) (borrow-mut output) width writing))
			(set width (call write_member_designator (borrow-shared arena) extent declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared extent_type_end) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared member_type_start) (borrow-mut output) width writing))
			(set width (call write_member_designator (borrow-shared arena) field declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared member_end) (borrow-mut output) width writing))
			(set width (call write_layout_name declaration (borrow-shared field_type_suffix) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared end_declaration) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared prototype_start) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared inline_check_suffix) (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared check_inline_start) (borrow-mut output) width writing))
			(set width (call write_named_probe (borrow-shared result_type) declaration (borrow-mut output) width writing))
			(set width (call c_literal_text (borrow-shared check_inline_field) (borrow-mut output) width writing))
			(set width (call write_snapshot_symbol (borrow-shared arena) field (borrow-mut output) width writing))
			(return (call c_literal_text (borrow-shared check_inline_end) (borrow-mut output) width writing))))
)
