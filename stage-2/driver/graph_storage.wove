(module driver_graph_storage
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Copy the committed prefixes of a suspended graph walk into larger driver workspaces.")

	(use wove-file "../source/graph.wove" (only
		(type GraphProgress) (type GraphModule) (type GraphBinding) (type GraphUse) (type GraphSelector) (type DiskEdge)))

	(fn copy_disk_edges
		(:doc `Copy the initialized edge prefix for the resolver or a larger disk workspace.`)
		(params (source (shared-array DiskEdge)) (output (mut-array DiskEdge)) (count i32)) (returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Unresolved edges have no published row.")
				(i32.lt (local index) (local count))
				(body
					(array.store (local output) (local index) (array.load (local source) (local index)))
					(set (local index) (i32.inc (local index)))))))

	(fn copy_graph_modules
		(:doc "Preserve reached frames and the unseen sentinels for already supplied identities.")
		(params (saved GraphProgress) (source (shared-array GraphModule)) (output (mut-array GraphModule)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Copy exactly the initialized identity rows.")
				(i32.lt (local index) (struct.get (local saved) files))
				(body
					(array.store (local output) (local index) (array.load (local source) (local index)))
					(set (local index) (i32.inc (local index)))))))

	(fn copy_graph_imports
		(:doc "Preserve the bindings, uses, and selectors published by completed steps of the walk.")
		(params (saved GraphProgress)
			(bindings (shared-array GraphBinding)) (uses (shared-array GraphUse)) (selectors (shared-array GraphSelector))
			(next_bindings (mut-array GraphBinding)) (next_uses (mut-array GraphUse)) (next_selectors (mut-array GraphSelector)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Copy the binding prefix from before any partially applied operation.")
				(i32.lt (local index) (struct.get (local saved) bindings))
				(body
					(array.store (local next_bindings) (local index) (array.load (local bindings) (local index)))
					(set (local index) (i32.inc (local index)))))
			(set (local index) 0i32)
			(while
				(:doc "Keep use indices stable for the suspended frames.")
				(i32.lt (local index) (struct.get (local saved) uses))
				(body
					(array.store (local next_uses) (local index) (array.load (local uses) (local index)))
					(set (local index) (i32.inc (local index)))))
			(set (local index) 0i32)
			(while
				(:doc "Keep each checked selector at the index recorded in its use.")
				(i32.lt (local index) (struct.get (local saved) selectors))
				(body
					(array.store (local next_selectors) (local index) (array.load (local selectors) (local index)))
					(set (local index) (i32.inc (local index)))))))
)
