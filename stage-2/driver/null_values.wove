(module driver_null_values
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Share the header macro status and the native include context for null bindings.")

	(use wove-file "../text/copy.wove" (only append_bytes))

	(let invalid_null_value 94u32)
	(let complete_include_marker "#define WVPR_HEADER_PRESENT 1\nenum wvpr_c_probe { wvpr_header_present = 1 };\n")

	(fn null_probe_context
		(:doc "Mark the complete explicit include order for the existing Clang query reader.")
		(params (includes (shared-array u8)))
		(returns (owned-array u8))
		(body
			(let length includes.len)
			(let marker complete_include_marker.len)
			(if
				(:doc "An exhausted include plan cannot produce a partial query.")
				(i32:lt (i32:sub 2147483647i32 marker) length)
				(then (let empty (array:alloc u8 0i32)) (return (move empty))))
			(let-mut source (array:alloc u8 (length.add marker)))
			(let end (call append_bytes (borrow-shared includes) (borrow-mut source) 0i32))
			(let next (call append_bytes (borrow-shared complete_include_marker) (borrow-mut source) end))
			(return (move source))))
)
