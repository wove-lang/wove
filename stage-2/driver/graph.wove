(module native_cli_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve native graphs with the bundled providers and emit one retained C unit.")

	(use wove-file "./availability.wove" (only (type Availability) (value optional_record_unavailable) (value optional_typedef_unavailable)))
	(use wove-file "./int256_target.wove" (only (value int256_unavailable) (value int256_probe_failed)))
	(use wove-file "./numeric_target.wove" (only (value f16_unavailable) (value f16_probe_failed)
		(value f80_unavailable) (value f80_probe_failed) (value f128_unavailable) (value f128_probe_failed) (value int128_unavailable) (value int128_probe_failed)))
	(use wove-file "./graph_emit.wove" (only emit_entry_graph (type EntryEmission)))
	(use wove-file "./diagnostics.wove" (only report_source report_file report_path_location
		(value invalid_source) (value unreadable_asset)))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./files.wove" (only canonical_path))
	(use wove-file "../source/target.wove" (only (type SelectionContext)))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile)))
	(use wove-file "../source/graph.wove" (only (type GraphModule) (type GraphBinding) (type GraphResult) copy_graph_bindings))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only (type SelectedDeclaration) form_parts))
	(use wove-file "../source/imports.wove" (only import_keyword))

	(let unavailable_half "f16 is unavailable on this Clang target")
	(let half_probe_failed "could not determine f16 support for the Clang target")
	(let unavailable_extended "f80 is unavailable on this Clang target")
	(let extended_probe_failed "could not determine f80 support for the Clang target")
	(let unavailable_quad "f128 is unavailable on this Clang target")
	(let quad_probe_failed "could not determine f128 support for the Clang target")
	(let unavailable_wide_integer "i128 and u128 are unavailable on this Clang target")
	(let wide_integer_probe_failed "could not determine i128 and u128 support for the Clang target")
	(let unavailable_bit_integer "i256 and u256 require working C23 _BitInt(256) support")
	(let bit_integer_probe_failed "could not compile and link the C23 _BitInt(256) capability probe")

	(fn needs_provider_graph
		(:doc "Find an active Wove import, C header use, or project bridge that needs graph resolution.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (count i32))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Selection has already discarded inactive declarations.")
				(i32.lt index count)
				(body
					(let row (struct.get (array.load declarations index) node))
					(let parts (call form_parts (borrow-shared source) (borrow-shared nodes)
						(array.load nodes row)))
					(if
						(:doc "A project bridge needs duplicate-key checking even without a header import.")
						(i32.lt -1i32 (struct.get parts header))
						(then (return (bool true))))
					(let head (array.load nodes (struct.get parts head)))
					(let provider (struct.get parts operands))
					(if
						(:doc "The graph resolver will check the full use and its selectors.")
						(bool.and (u32.eq (call import_keyword (borrow-shared source) head) 2u32)
							(i32.not-ltz provider))
						(then
							(let kind (call import_keyword (borrow-shared source) (array.load nodes provider)))
							(if
								(:doc "Wove and C selections both require graph bindings.")
								(bool.or (u32.eq kind 3u32) (u32.eq kind 8u32))
								(then (return (bool true))))))
					(set index (i32.inc index))))
			(return (bool false))))

	(let current_directory ".")
	(let unavailable_c_function "optional C function is unavailable")
	(let unavailable_c_record "optional C record is unavailable or incomplete")
	(let unavailable_c_typedef "optional C scalar typedef is unavailable")
	(let unavailable_c_macro "optional C integer macro is unavailable")
	(let unavailable_c_expression_macro "optional C expression macro is unavailable")
	(let header_tool_failed "Clang header probe failed")
	(let header_output_invalid "Clang header probe output is invalid")
	(let header_workspace_exceeded "Clang header probe exceeded workspace")
	(let header_setup_failed "could not prepare Clang header probe")


	(fn report_graph_location
		(:doc `Use the entry's argv spelling or the identity of the provider where a diagnostic originated.`)
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(file i32) (error u32) (start i32) (end i32) (message (shared-array u8)) (human bool))
		(returns i32)
		(body
			(if
				(:doc "An empty file table has no source view for the entry spelling.")
				(i32.eqz (array.len files))
				(then (return (call report_file (borrow-shared path) error start end
					(borrow-shared message) human))))
			(if
				(:doc "A provider has its own path and byte coordinates.")
				(bool.and (i32.gtz file) (i32.lt file (array.len files)))
				(then
					(let provider (array.load files file))
					(let first (struct.get provider path_start))
					(let last (struct.get provider path_end))
					(let source_start (struct.get provider source_start))
					(let source_end (struct.get provider source_end))
					(if
						(:doc "Preserve absolute output when the entry was supplied as an absolute path.")
						(bool.and (i32.gtz (array.len path)) (u8.eq (array.load path 0i32) 47u8))
						(then (return (call report_source (borrow-shared (array.range arena first last))
							error start end (borrow-shared message)
							(borrow-shared (array.range arena source_start source_end)) human))))
					(let cwd (call canonical_path (borrow-shared current_directory)))
					(return (call report_path_location (borrow-shared (array.range arena first last))
						(borrow-shared cwd) error start end (borrow-shared message)
						(borrow-shared (array.range arena source_start source_end)) (bool true) human))))
			(let entry (array.load files 0i32))
			(return (call report_source (borrow-shared path) error start end (borrow-shared message)
				(borrow-shared (array.range arena (struct.get entry source_start) (struct.get entry source_end)))
				human))))

	(fn report_graph_source
		(:doc `Report a resolver or emitter source diagnostic in its original file.`)
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(file i32) (error u32) (start i32) (end i32) (human bool))
		(returns i32)
		(body
			(if
				(:doc "Unsupported binary16 is a source error at the checked use.")
				(u32.eq error f16_unavailable)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared unavailable_half) human))))
			(if
				(:doc "A failed Clang observation cannot establish whether the target supports half.")
				(u32.eq error f16_probe_failed)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared half_probe_failed) human))))
			(if
				(:doc "An incompatible long-double mantissa is a source error at the checked use.")
				(u32.eq error f80_unavailable)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared unavailable_extended) human))))
			(if
				(:doc "A failed probe cannot establish which long-double format the target uses.")
				(u32.eq error f80_probe_failed)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared extended_probe_failed) human))))
			(if
				(:doc "An unsupported binary128 site keeps the original Wove occurrence.")
				(u32.eq error f128_unavailable)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared unavailable_quad) human))))
			(if
				(:doc "A broken probe cannot establish which binary128 representation is available.")
				(u32.eq error f128_probe_failed)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared quad_probe_failed) human))))
			(if
				(:doc "The selected Clang target does not have native wide integers.")
				(u32.eq error int128_unavailable)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared unavailable_wide_integer) human))))
			(if
				(:doc "A failed capability probe keeps the checked Wove location.")
				(u32.eq error int128_probe_failed)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared wide_integer_probe_failed) human))))
			(if
				(:doc "Report unsupported C23 width at the checked Wove type or literal.")
				(u32.eq error int256_unavailable)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared unavailable_bit_integer) human))))
			(if
				(:doc "A failed compiler or linker invocation cannot decide whether the target implements the width.")
				(u32.eq error int256_probe_failed)
				(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) file error start end
					(borrow-shared bit_integer_probe_failed) human))))
			(return (call report_graph_location (borrow-shared path) (borrow-shared arena) (borrow-shared files)
				file error start end (borrow-shared invalid_source) human))))

	(fn report_availability
		(:doc "Describe the failed probe or absent symbol at the original importing selection.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile)) (result Availability) (human bool))
		(returns i32)
		(body
			(let error (struct.get result error))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq error 71u32)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared unavailable_c_function) human))))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq error 72u32)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared header_tool_failed) human))))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq error 73u32)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared header_output_invalid) human))))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq error 74u32)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared header_workspace_exceeded) human))))
			(if
				(:doc "Report an unavailable macro at its original import spelling.")
				(u32.eq error 76u32)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared unavailable_c_macro) human))))
			(if
				(:doc "An optional expression uses its own availability diagnostic without an integer constraint.")
				(u32.eq error 77u32)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared unavailable_c_expression_macro) human))))
			(if
				(:doc "Report an optional native type at the original selector when its definition is missing.")
				(u32.eq error optional_record_unavailable)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared unavailable_c_record) human))))
			(if
				(:doc "Keep an unavailable scalar typedef at the selector even when it was renamed locally.")
				(u32.eq error optional_typedef_unavailable)
				(then (return (call report_availability_at (borrow-shared path) (borrow-shared arena)
					(borrow-shared files) result (borrow-shared unavailable_c_typedef) human))))
			(return (call report_availability_at (borrow-shared path) (borrow-shared arena)
				(borrow-shared files) result (borrow-shared header_setup_failed) human))))

	(fn report_availability_at
		(:doc "Report a live availability result in the same location format as graph diagnostics.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(result Availability) (message (shared-array u8)) (human bool))
		(returns i32)
		(body (return (call report_graph_location (borrow-shared path) (borrow-shared arena) (borrow-shared files)
			(struct.get result file) (struct.get result error)
			(struct.get result start) (struct.get result end) (borrow-shared message) human))))

	(fn compile_resolved_graph
		(:doc `Pass the exact checked binding prefix and source rows to the graph emitter.`)
		(params (path (shared-array u8)) (canonical (shared-array u8))
			(destination (shared-array u8)) (staged (shared-array u8)) (probe_options (shared-array u8)) (probe_libraries (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (partition i32)
			(arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(scratch (shared-array GraphBinding)) (resolved GraphResult) (length i32) (human bool)) (returns i32)
		(body
			(let-mut bindings (array.alloc GraphBinding (struct.get resolved bindings)))
			(call copy_graph_bindings (borrow-shared scratch) (borrow-mut bindings))
			(let result (call emit_entry_graph (borrow-shared path) (borrow-shared canonical)
				(borrow-shared destination) (borrow-shared staged) (borrow-shared probe_options)
				(borrow-shared probe_libraries)
				protection target_index check_only partition
				(borrow-shared (array.range arena 0i32 length))
				(borrow-shared files) (borrow-shared modules) (borrow-shared bindings)
				resolved human))
			(return (call report_entry_emission (borrow-shared path) (borrow-shared arena)
				(borrow-shared files) result human))))

	(fn report_entry_emission
		(:doc "Report a checked plan or asset diagnostic in its original source coordinates.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile)) (result EntryEmission) (human bool))
		(returns i32)
		(body
			(let error (struct.get result error))
			(if
				(:doc "Keep native source and host asset failures in their existing diagnostic categories.")
				(u32.gtz error)
				(then
					(let file (struct.get result file))
					(let start (struct.get result start))
					(let end (struct.get result end))
					(if
						(:doc "Unavailable host assets use the defining file and quoted operand range.")
						(struct.get result asset)
						(then (return (call report_graph_location (borrow-shared path) (borrow-shared arena)
							(borrow-shared files) file error start end (borrow-shared unreadable_asset) human))))
					(if
						(:doc "Keep the optional declaration diagnostics returned by the frontend check.")
						(bool.or (bool.or (u32.eq error optional_record_unavailable)
							(u32.eq error optional_typedef_unavailable))
							(bool.and (u32.lt 70u32 error) (u32.lt error 78u32)))
						(then (return (call report_availability (borrow-shared path) (borrow-shared arena)
							(borrow-shared files) (struct.new Availability (error error)
								(file (struct.get result file)) (start (struct.get result start))
								(end (struct.get result end))) human))))
					(return (call report_graph_source (borrow-shared path) (borrow-shared arena)
						(borrow-shared files) file error start end human))))
			(return (struct.get result status))))

)
