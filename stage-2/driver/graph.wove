(module native_cli_graph
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Resolve native graphs with the bundled providers and emit one retained C unit.")

	(use wove-file "./availability.wove" (only check_optional_c_functions (type Availability)))
	(use wove-file "./graph_emit.wove" (only emit_entry_graph))
	(use wove-file "./bundled.wove" (only load_bundled_providers bundled_file_count bundled_input_width write_bundled_sources))
	(use wove-file "./diagnostics.wove" (only report_source report_path_location
		(value invalid_source) (value unreadable_asset)))
	(use wove-file "./protection.wove" (only (type BuildProtection)))
	(use wove-file "./files.wove" (only canonical_path))
	(use wove-file "./platform.wove" (only native_selection))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "../source/paths.wove" (only (type SuppliedFile) normalize_path))
	(use wove-file "../source/graph.wove" (only (type GraphModule) (type GraphBinding)
		(type GraphUse) (type GraphSelector) (type GraphResult) resolve_graph_for_target))
	(use wove-file "../source/scan.wove" (only (type SourceNode)))
	(use wove-file "../source/module.wove" (only (type SelectedDeclaration) form_parts))
	(use wove-file "../source/imports.wove" (only import_keyword))

	(fn needs_provider_graph
		(:doc "Find an active use of this provider kind or a C bridge that needs validation.")
		(params (source (shared-array u8)) (nodes (shared-array SourceNode))
			(declarations (shared-array SelectedDeclaration)) (count i32) (kind u32))
		(returns bool)
		(body
			(let-mut index 0i32)
			(while
				(:doc "Selection has already discarded inactive declarations.")
				(i32.lt (local index) (local count))
				(body
					(let row (struct.get (array.load (local declarations) (local index)) node))
					(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes))
						(array.load (local nodes) (local row))))
					(if
						(:doc "A project bridge needs duplicate-key checking even without a header import.")
						(bool.and (u32.eq (local kind) 8u32) (i32.lt -1i32 (struct.get (local parts) header)))
						(then (return (bool true))))
					(let head (array.load (local nodes) (struct.get (local parts) head)))
					(let provider (struct.get (local parts) operands))
					(if
						(:doc "The graph resolver will check the full use and its selectors.")
						(bool.and (u32.eq (call import_keyword (borrow-shared (local source)) (local head)) 2u32)
							(bool.and (i32.lt -1i32 (local provider))
								(u32.eq (call import_keyword (borrow-shared (local source))
									(array.load (local nodes) (local provider))) (local kind))))
						(then (return (bool true))))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(return (bool false))))

	(let current_directory ".")
	(let unavailable_c_function "optional C function is unavailable")
	(let header_tool_failed "Clang header probe failed")
	(let header_output_invalid "Clang header probe output is invalid")
	(let header_workspace_exceeded "Clang header probe exceeded workspace")
	(let header_setup_failed "could not prepare Clang header probe")


	(fn report_graph_location
		(:doc `Use the entry's argv spelling or the identity of the provider where a diagnostic originated.`)
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(file i32) (error u32) (start i32) (end i32) (message (shared-array u8)))
		(returns i32)
		(body
			(if
				(:doc "A provider has its own path and byte coordinates.")
				(bool.and (i32.lt 0i32 (local file)) (i32.lt (local file) (array.len (local files))))
				(then
					(let provider (array.load (local files) (local file)))
					(let first (struct.get (local provider) path_start))
					(let last (struct.get (local provider) path_end))
					(if
						(:doc "Preserve absolute output when the entry was supplied as an absolute path.")
						(bool.and (i32.lt 0i32 (array.len (local path))) (u8.eq (array.load (local path) 0i32) 47u8))
						(then (return (call report_source (borrow-shared (array.range (local arena) (local first) (local last)))
							(local error) (local start) (local end) (borrow-shared (local message))))))
					(let cwd (call canonical_path (borrow-shared (local current_directory))))
					(return (call report_path_location (borrow-shared (array.range (local arena) (local first) (local last)))
						(borrow-shared (local cwd)) (local error) (local start) (local end) (borrow-shared (local message))))))
			(return (call report_source (borrow-shared (local path)) (local error) (local start) (local end) (borrow-shared (local message))))))

	(fn report_graph_source
		(:doc `Report a resolver or emitter source diagnostic in its original file.`)
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(file i32) (error u32) (start i32) (end i32))
		(returns i32)
		(body (return (call report_graph_location (borrow-shared (local path)) (borrow-shared (local arena))
			(borrow-shared (local files)) (local file) (local error) (local start) (local end) (borrow-shared (local invalid_source))))))

	(fn copy_graph_bindings
		(:doc "Seal the initialized binding prefix in the exact view consumed by the scalar graph.")
		(params (source (shared-array GraphBinding)) (bindings (mut-array GraphBinding)))
		(returns void)
		(body
			(let-mut index 0i32)
			(while
				(:doc "The destination size is the published binding count.")
				(i32.lt (local index) (array.len (local bindings)))
				(body
					(array.store (local bindings) (local index) (array.load (local source) (local index)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))))

	(fn report_availability
		(:doc "Describe the failed probe or absent symbol at the original importing selection.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile)) (result Availability))
		(returns i32)
		(body
			(let error (struct.get (local result) error))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq (local error) 71u32)
				(then (return (call report_availability_at (borrow-shared (local path)) (borrow-shared (local arena))
					(borrow-shared (local files)) (local result) (borrow-shared (local unavailable_c_function))))))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq (local error) 72u32)
				(then (return (call report_availability_at (borrow-shared (local path)) (borrow-shared (local arena))
					(borrow-shared (local files)) (local result) (borrow-shared (local header_tool_failed))))))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq (local error) 73u32)
				(then (return (call report_availability_at (borrow-shared (local path)) (borrow-shared (local arena))
					(borrow-shared (local files)) (local result) (borrow-shared (local header_output_invalid))))))
			(if
				(:doc "Forward the distinct availability result at the selected import.")
				(u32.eq (local error) 74u32)
				(then (return (call report_availability_at (borrow-shared (local path)) (borrow-shared (local arena))
					(borrow-shared (local files)) (local result) (borrow-shared (local header_workspace_exceeded))))))
			(return (call report_availability_at (borrow-shared (local path)) (borrow-shared (local arena))
				(borrow-shared (local files)) (local result) (borrow-shared (local header_setup_failed))))))

	(fn report_availability_at
		(:doc "Report a live availability result in the same location format as graph diagnostics.")
		(params (path (shared-array u8)) (arena (shared-array u8)) (files (shared-array SuppliedFile))
			(result Availability) (message (shared-array u8)))
		(returns i32)
		(body (return (call report_graph_location (borrow-shared (local path)) (borrow-shared (local arena)) (borrow-shared (local files))
			(struct.get (local result) file) (struct.get (local result) error)
			(struct.get (local result) start) (struct.get (local result) end) (borrow-shared (local message))))))

	(fn compile_resolved_graph
		(:doc `Pass the exact checked binding prefix and source rows to the graph emitter.`)
		(params (path (shared-array u8)) (canonical (shared-array u8))
			(destination (shared-array u8)) (staged (shared-array u8)) (probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool)
			(arena (shared-array u8)) (files (shared-array SuppliedFile)) (modules (shared-array GraphModule))
			(scratch (shared-array GraphBinding)) (resolved GraphResult) (length i32)) (returns i32)
		(body
			(let-mut bindings (array.alloc GraphBinding (struct.get (local resolved) bindings)))
			(call copy_graph_bindings (borrow-shared (local scratch)) (borrow-mut (local bindings)))
			(let available (call check_optional_c_functions (borrow-shared (local arena))
				(borrow-shared (local files)) (borrow-shared (local bindings)) (borrow-shared (local canonical))
				(borrow-shared (local probe_options))
				(borrow-shared (array.range (local staged) 0i32 (call directory_width (borrow-shared (local staged)))))))
			(if
				(:doc "Reject unavailable optional bindings before emitting a C reference.")
				(u32.lt 0u32 (struct.get (local available) error))
				(then (return (call report_availability (borrow-shared (local path)) (borrow-shared (local arena))
					(borrow-shared (local files)) (local available)))))
			(let result (call emit_entry_graph (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local staged)) (local protection) (local target_index) (local check_only)
				(borrow-shared (array.range (local arena) 0i32 (local length)))
				(borrow-shared (local files)) (borrow-shared (local modules)) (borrow-shared (local bindings))
				(local resolved)))
			(let error (struct.get (local result) error))
			(if
				(:doc "Keep native source and host asset failures in their existing diagnostic categories.")
				(u32.lt 0u32 (local error))
				(then
					(let file (struct.get (local result) file))
					(let start (struct.get (local result) start))
					(let end (struct.get (local result) end))
					(if
						(:doc "Unavailable host assets use the defining file and quoted operand range.")
						(struct.get (local result) asset)
						(then (return (call report_graph_location (borrow-shared (local path)) (borrow-shared (local arena))
							(borrow-shared (local files)) (local file) (local error) (local start) (local end) (borrow-shared (local unreadable_asset))))))
					(return (call report_graph_source (borrow-shared (local path)) (borrow-shared (local arena))
						(borrow-shared (local files)) (local file) (local error) (local start) (local end)))))
			(return (struct.get (local result) status))))

	(fn resolve_c_input
		(:doc "Bind the entry's selections against the three registered sources.")
		(params (path (shared-array u8)) (canonical (shared-array u8))
			(destination (shared-array u8)) (staged (shared-array u8)) (probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (arena (shared-array u8)) (files (shared-array SuppliedFile)) (rows i32))
		(returns i32)
		(body
			(let-mut modules (array.alloc GraphModule (array.len (local files))))
			(let-mut scratch (array.alloc GraphBinding (local rows)))
			(let-mut uses (array.alloc GraphUse (local rows)))
			(let-mut selectors (array.alloc GraphSelector (local rows)))
			(let resolved (call resolve_graph_for_target (borrow-shared (local arena)) (borrow-shared (local files)) 0i32 (call native_selection)
				(borrow-mut (local modules)) (borrow-mut (local scratch)) (borrow-mut (local uses)) (borrow-mut (local selectors))))
			(if
				(:doc "Failed selections retain their original file identity and byte span.")
				(u32.lt 0u32 (struct.get (local resolved) error))
				(then (return (call report_graph_source (borrow-shared (local path)) (borrow-shared (local arena))
					(borrow-shared (local files)) (struct.get (local resolved) file) (struct.get (local resolved) error)
					(struct.get (local resolved) start) (struct.get (local resolved) end)))))
			(return (call compile_resolved_graph (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local staged)) (borrow-shared (local probe_options))
				(local protection) (local target_index) (local check_only) (borrow-shared (local arena))
				(borrow-shared (local files)) (borrow-shared (local modules)) (borrow-shared (local scratch))
				(local resolved) (array.len (local arena))))))

	(fn prepare_bundled_input
		(:doc "Allocate the source and path arena before registering the embedded modules.")
		(params (path (shared-array u8)) (canonical (shared-array u8))
			(destination (shared-array u8)) (staged (shared-array u8)) (probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (source (shared-array u8)) (rows i32) (virtual (shared-array u8)))
		(returns i32)
		(body
			(let providers (call load_bundled_providers))
			(let total (call bundled_input_width (borrow-shared (local virtual)) (borrow-shared (local source))
				(borrow-shared (local providers))))
			(if
				(:doc "Reject an arena whose offsets exceed the source ABI.")
				(i32.lt (local total) 0i32)
				(then (return (call report_source (borrow-shared (local path)) 16u32 0i32 0i32 (borrow-shared (local invalid_source))))))
			(let-mut arena (array.alloc u8 (local total)))
			(let-mut files (array.alloc SuppliedFile (call bundled_file_count (borrow-shared (local providers)))))
			(let written (call write_bundled_sources (borrow-shared (local virtual)) (borrow-shared (local source))
				(borrow-shared (local providers)) (borrow-mut (local arena)) (borrow-mut (local files))))
			(return (call resolve_c_input (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local staged)) (borrow-shared (local probe_options))
				(local protection) (local target_index) (local check_only)
				(borrow-shared (array.range (local arena) 0i32 (local written))) (borrow-shared (local files)) (local rows)))))

	(fn compile_bundled_input
		(:doc "Open the source graph with the checked-in C provider bytes embedded in this compiler.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:221"))
		(params (path (shared-array u8)) (canonical (shared-array u8))
			(destination (shared-array u8)) (staged (shared-array u8)) (probe_options (shared-array u8))
			(protection BuildProtection) (target_index i32) (check_only bool) (source (shared-array u8)) (rows i32))
		(returns i32)
		(body
			(let width (array.len (local path)))
			(if
				(:doc "The virtual path buffer reserves room for a leading slash.")
				(i32.eq (local width) 2147483647i32)
				(then (return (call report_source (borrow-shared (local path)) 16u32 0i32 0i32 (borrow-shared (local invalid_source))))))
			(let-mut virtual (array.alloc u8 (i32.add.wrapping (local width) 1i32)))
			(let end (call normalize_path (borrow-shared (local path)) (borrow-mut (local virtual)) 0i32))
			(if
				(:doc "An entry must have a nonempty normalized source path.")
				(i32.lt (local end) 1i32)
				(then (return (call report_source (borrow-shared (local path)) 27u32 0i32 0i32 (borrow-shared (local invalid_source))))))
			(return (call prepare_bundled_input (borrow-shared (local path)) (borrow-shared (local canonical))
				(borrow-shared (local destination)) (borrow-shared (local staged)) (borrow-shared (local probe_options))
				(local protection) (local target_index) (local check_only) (borrow-shared (local source))
				(local rows) (borrow-shared (array.range (local virtual) 0i32 (local end)))))))
)
