(module native_input_protection
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Check inputs against the exact native output and retained tree before publication.`)

	(use wove-file "./files.wove" (only canonical_path path_identity same_path_identity (type FileIdentity)))
	(use wove-file "./paths.wove" (only directory_width))
	(use wove-file "./output.wove" (only retained_tree_end))
	(use wove-file "./diagnostics.wove" (only report_path_location (value empty_diagnostic_bytes)))

	(struct BuildProtection (fields (target FileIdentity) (retained FileIdentity) (tree FileIdentity) (header FileIdentity)))

	(let current_directory ".")
	(let input_collision "output would overwrite input")

	(fn protect_destinations
		(:doc `Capture existing destination identities, including symlink targets and hard links to exact files.`)
		(:expect (tests "stage-2/cli/native/protection.tsv") (issues "gh:wove-lang/wove:216"))
		(params (target (shared-array u8)) (retained (shared-array u8)) (header (shared-array u8))) (returns BuildProtection)
		(body
			(let tree (call retained_tree_end (borrow-shared (local retained))))
			(return (struct.new BuildProtection
				(target (call path_identity (borrow-shared (local target))))
				(retained (call path_identity (borrow-shared (local retained))))
				(header (call path_identity (borrow-shared (local header))))
				(tree (call path_identity (borrow-shared (array.range (local retained) 0i32 (local tree)))))))))

	(fn no_destination_protection
		(:doc "Supply absent destination identities for a check-only invocation.")
		(params) (returns BuildProtection)
		(body
			(let absent (struct.new FileIdentity (device 0u64) (inode 0u64) (present (bool false))))
			(return (struct.new BuildProtection (target (local absent)) (retained (local absent)) (tree (local absent)) (header (local absent))))))

	(fn path_uses_tree
		(:doc `Check the directory prefixes before resolving a symlink can hide an input's lexical parent.`)
		(params (path (shared-array u8)) (tree FileIdentity)) (returns bool)
		(body
			(let-mut stop (array.len (local path)))
			(while
				(:doc `Each pass tests one prefix and moves to a shorter directory or removes a trailing slash.`)
				(i32.gtz (local stop))
				(body
					(if
						(:doc `Directory identity matches both the requested retained tree and its resolved alias.`)
						(call same_path_identity (local tree)
							(call path_identity (borrow-shared (array.range (local path) 0i32 (local stop)))))
						(then (return (bool true))))
					(let parent (call directory_width (borrow-shared (array.range (local path) 0i32 (local stop)))))
					(if
						(:doc `A trailing slash does not move directory_width past the current prefix.`)
						(i32.eq (local stop) (local parent))
						(then (set (local stop) (i32.dec (local stop))))
						(else (set (local stop) (local parent))))))
			(return (bool false))))

	(fn protected_input
		(:doc `Reject exact file aliases and inputs that rely on the lexical or resolved retained tree.`)
		(params (path (shared-array u8)) (outputs BuildProtection)) (returns bool)
		(body
			(let input (call path_identity (borrow-shared (local path))))
			(if (bool.not (struct.get (local input) present)) (then (return (bool false))))
			(if
				(:doc `A destination hard link or symlink can match even with a different filename.`)
				(bool.or (call same_path_identity (local input) (struct.get (local outputs) target))
					(bool.or (call same_path_identity (local input) (struct.get (local outputs) retained))
						(call same_path_identity (local input) (struct.get (local outputs) header))))
				(then (return (bool true))))
			(let tree (struct.get (local outputs) tree))
			(if (bool.not (struct.get (local tree) present)) (then (return (bool false))))
			(if (call path_uses_tree (borrow-shared (local path)) (local tree)) (then (return (bool true))))
			(let canonical (call canonical_path (borrow-shared (local path))))
			(if (call path_uses_tree (borrow-shared (local canonical)) (local tree)) (then (return (bool true))))
			(if
				(:doc `A relative spelling also relies on its working directory surviving publication.`)
				(bool.and (i32.gtz (array.len (local path)))
					(u8.not-eq (array.load (local path) 0i32) 47u8))
				(then
					(let cwd (call canonical_path (borrow-shared (local current_directory))))
					(return (call path_uses_tree (borrow-shared (local cwd)) (local tree)))))
			(return (bool false))))

	(fn report_input_collision
		(:doc `Name the conflicting filesystem input in the JSON diagnostic.`)
		(params (path (shared-array u8)) (human bool)) (returns i32)
		(body
			(let cwd (call canonical_path (borrow-shared (local current_directory))))
			(return (call report_path_location (borrow-shared (local path)) (borrow-shared (local cwd)) 71u32
				0i32 0i32 (borrow-shared (local input_collision)) (borrow-shared (local empty_diagnostic_bytes)) (bool false) (local human))))))
