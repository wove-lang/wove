(module native_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Pack Clang's arguments from the resolved project and explicit options.

	Keep each decoded option as one argument. The process launcher takes
	NUL-terminated rows and adds the executable name as argv[0].`)

	(use wove-file "../cli/command/args.wove" (only first_command_argument (type CommandArgument)))
	(use wove-file "../cli/command/resolve.wove" (only command_setting (type CommandInvocation) (type CommandSetting)))
	(use wove-file "../config/defaults.wove" (only append_default_cflag))
	(use wove-file "../c/standard.wove" (only write_c_standard))
	(use wove-file "../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../json/reader.wove" (only json_decode_string (type JsonNode)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "./platform.wove" (only host_os))

	(struct FrontendOptions (fields (common_end i32) (probe_end i32) (standard u32)))

	(let no_prefix "")
	(let define_prefix "-D")
	(let library_prefix "-l")
	(let relative_prefix "./")
	(let thin_lto "-flto=thin")
	(let full_lto "-flto=full")
	(let gnu_features "-D_GNU_SOURCE")
	(let darwin_features "-D_DARWIN_C_SOURCE")
	(let include_flag "-I")
	(let output_flag "-o")
	(let clang_frontend_flag "-Xclang")
	(let quiet_unused_probe_inputs "-Qunused-arguments")
	(let include_trace_flag "-dependency-dot")
	(let stdout_path "-")
	(let pic "-fPIC")
	(let hidden_visibility "-fvisibility=hidden")
	(let shared_flag "-shared")
	(let dylib_flag "-dynamiclib")
	(let linker_flag "-Xlinker")
	(let elf_export_flag "--version-script")
	(let darwin_export_flag "-exported_symbols_list")
	(let elf_identity_flag "-soname")
	(let darwin_identity_flag "-install_name")
	(let rpath_prefix "@rpath/")
	(let math_library "-lm")
	(let link_rules (array:new (array i32 3) 15i32 17i32 16i32))

	(fn write_argument
		(:doc `Append one argument and one terminator, rejecting unrepresentable bytes or capacity.`)
		(params (value (shared-array u8)) (prefix (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc `A failed cursor stays failed. Leave room for both byte views and the terminator.`)
				(cursor.ltz.or
					(u64:lt (u64:from-i32 output.len)
						(u64:add (u64:from-i32 value.len)
							(u64:add (u64:from-i32 prefix.len)
								(u64:inc (u64:from-i32 cursor))))))
				(then (return -1i32)))
			(let-mut index 0i32)
			(while
				(:doc `An escaped JSON NUL must never split one configured flag into additional arguments.`)
				(index.lt value.len)
				(body
					(if (u8:eqz (value.get index)) (then (return -1i32)))
					(set index index.inc)))
			(let start (call append_bytes (borrow-shared prefix) (borrow-mut output) cursor))
			(let end (call append_bytes (borrow-shared value) (borrow-mut output) start))
			(output.set end 0u8)
			(return end.inc)))

	(fn write_plain_argument
		(:doc `Forward one argument without adding a prefix.`)
		(params (value (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body (return (call write_argument (borrow-shared value) (borrow-shared no_prefix)
			(borrow-mut output) cursor))))

	(fn write_option
		(:doc `Apply the argument spelling for definitions, named libraries, and relative link files.`)
		(params (rule i32) (value (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc `Definitions must be one joined -D argument even when their value contains spaces.`)
				(bool:or (rule.eq 14i32) (rule.eq 21i32))
				(then (return (call write_argument (borrow-shared value) (borrow-shared define_prefix)
					(borrow-mut output) cursor))))
			(if
				(:doc `Turn a configured library name into a linker search argument.`)
				(rule.eq 16i32)
				(then (return (call write_argument (borrow-shared value) (borrow-shared library_prefix)
					(borrow-mut output) cursor))))
			(if
				(:doc `Disambiguate link filenames from command options and Clang response files.`)
				(bool:and (rule.eq 17i32)
					(value.len.gtz.and
						(bool:or (u8:eq (value.get 0i32) 45u8)
							(u8:eq (value.get 0i32) 64u8))))
				(then (return (call write_argument (borrow-shared value) (borrow-shared relative_prefix)
					(borrow-mut output) cursor))))
			(return (call write_plain_argument (borrow-shared value) (borrow-mut output) cursor))))

	(fn write_argv_options
		(:doc `Walk surviving CLI values in order, including when other rules occur between them.`)
		(params (bytes (shared-array u8)) (arguments (shared-array CommandArgument)) (rows i32) (setting CommandSetting)
			(rule i32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let-mut end cursor)
			(let-mut row setting/row)
			(let-mut remaining setting/count)
			(while
				(:doc `The resolver gives the first effective row and the exact number of values after the last clear.`)
				remaining.gtz
				(body
					(let found (call first_command_argument (borrow-shared arguments) row rows rule))
					(let item (arguments.get found))
					(set end (call write_option rule
						(borrow-shared (bytes.range item/start item/end))
						(borrow-mut output) end))
					(set row found.inc)
					(set remaining remaining.dec)))
			(return end)))

	(fn write_config_options
		(:doc `Decode the selected JSONC list directly from its validated source nodes.`)
		(params (config (shared-array u8)) (nodes (shared-array JsonNode)) (array_node i32)
			(rule i32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let-mut end cursor)
			(let-mut row (struct:get (nodes.get array_node) first_child))
			(while
				(:doc `Every list child is one string, and decoded bytes fit within the raw quoted token's width.`)
				(bool:and (i32:lt -1i32 row) (i32:lt -1i32 end))
				(body
					(let item (nodes.get row))
					(let start item/start)
					(let finish item/end)
					(let-mut scratch (array:alloc u8 (finish.sub start)))
					(let decoded (call json_decode_string (borrow-shared config) start finish
						(borrow-mut scratch)))
					(if decoded/error.gtz (then (return -1i32)))
					(set end (call write_option rule
						(borrow-shared (scratch.range 0i32 decoded/written))
						(borrow-mut output) end))
					(set row item/next_sibling)))
			(return end)))

	(fn write_default_options
		(:doc `Copy the built-in optimization and debugging arguments for the resolved mode.`)
		(params (mode u32) (count i32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let-mut end cursor)
			(let-mut row 0i32)
			(while
				(:doc `Only cflags has a nonempty built-in list.`)
				(row.lt count)
				(body
					(set end (call append_default_cflag
						mode row (borrow-mut output) end (bool true)))
					(set row row.inc)))
			(return end)))

	(fn write_lto
		(:doc `Add the resolved Clang link-time optimization mode when it is enabled.`)
		(params (mode u32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc `Thin LTO is distinct from full-module LTO.`)
				(mode.eq 1u32)
				(then (return (call write_plain_argument (borrow-shared thin_lto) (borrow-mut output) cursor))))
			(if
				(:doc `An explicit full mode reaches both compilation and linking.`)
				(mode.eq 2u32)
				(then (return (call write_plain_argument (borrow-shared full_lto) (borrow-mut output) cursor))))
			(return cursor)))

	(fn write_effective_options
		(:doc "Append the one effective list selected for a compiler or linker rule.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(rule i32) (output (mut-array u8)) (cursor i32))
		(returns i32)
		(body
			(let-mut scope 3u32)
			(if
				(:doc "Retained C takes its definitions from cc, while binary options come from the build mode.")
				(rule.eq 21i32)
				(then (set scope 4u32)))
			(let setting (call command_setting invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) scope rule))
			(let origin setting/origin)
			(if
				(:doc "An explicit list, including an empty clear, wins over the project and built-in lists.")
				(origin.eq 2u32)
				(then (return (call write_argv_options (borrow-shared bytes) (borrow-shared arguments)
					invocation/rows setting rule (borrow-mut output) cursor))))
			(if
				(:doc "Use the selected project list when one was supplied.")
				(origin.eq 1u32)
				(then (return (call write_config_options (borrow-shared config)
					(borrow-shared nodes) setting/row rule (borrow-mut output) cursor))))
			(return (call write_default_options invocation/mode
				setting/count (borrow-mut output) cursor))))

	(fn write_feature_flags
		(:doc "Apply the same feature definitions before generated code and header probes.")
		(params (output (mut-array u8)))
		(returns i32)
		(body
			(let posix (call write_plain_argument (borrow-shared gnu_features) (borrow-mut output) 0i32))
			(return (call write_plain_argument (borrow-shared darwin_features) (borrow-mut output) posix))))

	(fn frontend_capacity
		(:doc "Bound the buffer for decoded flags, terminators, and caller-supplied native paths.")
		(params (bytes i32) (config i32) (arguments i32) (paths u64)) (returns i32)
		(body
			(let extent (u64:add (u64:from-i32 bytes)
				(u64:add (u64:from-i32 config) (u64:from-i32 arguments))))
			(let width (u64:add 256u64
				(paths.add (extent.shl 2i32))))
			(if
				(:doc "Reserve one byte for reporting options that exceed a native slice.")
				(u64:lt 2147483647u64 width)
				(then (return 1i32)))
			(return (i32:from-u64 width))))

	(fn write_frontend_search
		(:doc "Start the frontend argv with platform definitions and the private include directory.")
		(params (directory (shared-array u8)) (output (mut-array u8))) (returns i32)
		(body
			(let start (call write_feature_flags (borrow-mut output)))
			(if
				(:doc "Binary compilation searches the private build directory containing the runtime assets.")
				directory.len.gtz
				(then
					(let include (call write_plain_argument (borrow-shared include_flag) (borrow-mut output) start))
					(return (call write_plain_argument (borrow-shared directory) (borrow-mut output) include))))
			(return start)))

	(fn write_frontend_arguments
		(:doc "Pack the same declaration-affecting arguments for the Clang probe and the build.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(directory (shared-array u8)) (output (mut-array u8)))
		(returns i32)
		(body
			(let start (call write_frontend_search (borrow-shared directory) (borrow-mut output)))
			(let flags (call write_effective_options (borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) 13i32
				(borrow-mut output) start))
			(let bin (invocation/command.eq 2u32))
			(let-mut define_rule 21i32)
			(if
				(:doc "Binary definitions use the selected build mode's list.")
				bin
				(then (set define_rule 14i32)))
			(let defines (call write_effective_options (borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) define_rule
				(borrow-mut output) flags))
			(if
				(:doc "Binary compilation also uses the selected link-time optimization mode.")
				bin
				(then
					(let lto (call command_setting invocation (borrow-shared arguments)
						(borrow-shared nodes) (borrow-shared settings) 3u32 18i32))
					(return (call write_lto lto/scalar (borrow-mut output) defines))))
			(return defines)))

	(fn write_clang_standard
		(:doc "Set the driver and frontend dialects after forwarded options.")
		(params (standard u32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let driver (call write_c_standard standard (borrow-mut output) cursor))
			(let frontend (call write_plain_argument (borrow-shared clang_frontend_flag) (borrow-mut output) driver))
			(return (call write_c_standard standard (borrow-mut output) frontend))))

	(fn write_probe_options
		(:doc "Use the effective Clang option order for selection and header probing.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(directory (shared-array u8)) (library bool) (output (mut-array u8))) (returns FrontendOptions)
		(body
			(let dialect (call command_setting invocation (borrow-shared arguments)
				(borrow-shared nodes) (borrow-shared settings) 4u32 20i32))
			(let standard dialect/scalar)
			(let common_end (call write_frontend_arguments (borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)
				(borrow-shared directory) (borrow-mut output)))
			(let-mut probe_prefix common_end)
			(if
				(:doc "Binary link flags are passed to the same Clang driver and can change its frontend target.")
				(invocation/command.eq 2u32)
				(then (set probe_prefix (call write_effective_options
					(borrow-shared bytes) (borrow-shared config) invocation
					(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) 15i32
					(borrow-mut output) common_end))))
			(let-mut probe_end (call write_clang_standard standard (borrow-mut output) probe_prefix))
			(if
				(:doc "Library frontend-only probes see link flags for target selection. Ignore warnings about unused link inputs while probing.")
				library
				(then (set probe_end (call write_plain_argument (borrow-shared quiet_unused_probe_inputs)
					(borrow-mut output) probe_end))))
			(if
				(:doc "An unterminated byte signals an invalid prefix if a header needs a live probe.")
				probe_end.ltz
				(then
					(output.set 0i32 1u8)
					(return (struct:new FrontendOptions (common_end -1i32) (probe_end 1i32) (standard standard)))))
			(return (struct:new FrontendOptions (common_end common_end) (probe_end probe_end)
				(standard standard)))))

	(fn write_probe_libraries
		(:doc "Append named native libraries for the capability link after the frontend arguments.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(output (mut-array u8)) (start i32)) (returns i32)
		(body
			(if (start.not-lt output.len) (then (return start)))
			(let end (call write_effective_options (borrow-shared bytes) (borrow-shared config)
				invocation (borrow-shared arguments) (borrow-shared nodes)
				(borrow-shared settings) 16i32 (borrow-mut output) start))
			(if
				(:doc "An incomplete library list must fail the capability check before launching Clang.")
				end.ltz
				(then
					(output.set start 1u8)
					(return start.inc)))
			(return end)))

	(fn write_include_trace
		(:doc `Stream all frontend include graphs to private stdout independently of make depfile settings.`)
		(params (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let trace (call write_plain_argument (borrow-shared clang_frontend_flag) (borrow-mut output) cursor))
			(let name (call write_plain_argument (borrow-shared include_trace_flag) (borrow-mut output) trace))
			(let file (call write_plain_argument (borrow-shared clang_frontend_flag) (borrow-mut output) name))
			(return (call write_plain_argument (borrow-shared stdout_path) (borrow-mut output) file))))

	(fn write_linker_value
		(:doc "Forward a linker option and value as separate arguments, preserving spaces and commas.")
		(params (flag (shared-array u8)) (prefix (shared-array u8)) (value (shared-array u8))
			(output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let first (call write_plain_argument (borrow-shared linker_flag) (borrow-mut output) cursor))
			(let key (call write_plain_argument (borrow-shared flag) (borrow-mut output) first))
			(let next (call write_plain_argument (borrow-shared linker_flag) (borrow-mut output) key))
			(return (call write_argument (borrow-shared value) (borrow-shared prefix) (borrow-mut output) next))))

	(fn write_library_compile_options
		(:doc "Build position-independent code and hide definitions unless explicitly exported.")
		(params (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let relocation (call write_plain_argument (borrow-shared pic) (borrow-mut output) cursor))
			(return (call write_plain_argument (borrow-shared hidden_visibility) (borrow-mut output) relocation))))

	(fn write_library_link_options
		(:doc "Link a shared image with an exact export list and the final library identity.")
		(params (os u8) (exports (shared-array u8)) (name (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc "Mach-O advertises the final basename relative to the consumer's runtime search paths.")
				(os.eq 2u8)
				(then
					(let kind (call write_plain_argument (borrow-shared dylib_flag) (borrow-mut output) cursor))
					(let list (call write_linker_value (borrow-shared darwin_export_flag) (borrow-shared no_prefix)
						(borrow-shared exports) (borrow-mut output) kind))
					(return (call write_linker_value (borrow-shared darwin_identity_flag) (borrow-shared rpath_prefix)
						(borrow-shared name) (borrow-mut output) list))))
			(let kind (call write_plain_argument (borrow-shared shared_flag) (borrow-mut output) cursor))
			(let list (call write_linker_value (borrow-shared elf_export_flag) (borrow-shared no_prefix)
				(borrow-shared exports) (borrow-mut output) kind))
			(return (call write_linker_value (borrow-shared elf_identity_flag) (borrow-shared no_prefix)
				(borrow-shared name) (borrow-mut output) list))))

	(fn write_link_inputs
		(:doc "Append the selected linker flags, files and library names after the native objects or sources.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(os u8) (output (mut-array u8)) (cursor i32))
		(returns i32)
		(body
			(let-mut end cursor)
			(let-mut index 0i32)
			(while
				(:doc "Link requests follow the source unit, with named libraries last.")
				(index.lt link_rules.len)
				(body
					(let rule (link_rules.get index))
					(set end (call write_effective_options (borrow-shared bytes) (borrow-shared config)
						invocation (borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings)
						rule (borrow-mut output) end))
					(set index index.inc)))
			(if
				(:doc "Linux keeps the system math library as a separate link dependency.")
				(os.eq 1u8)
				(then (return (call write_plain_argument (borrow-shared math_library) (borrow-mut output) end))))
			(return end)))

	(fn write_native_output
		(:doc "Select the private output path for the native tool.")
		(params (path (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let prefix (call write_plain_argument (borrow-shared output_flag) (borrow-mut output) cursor))
			(return (call write_plain_argument (borrow-shared path) (borrow-mut output) prefix))))

	(fn write_clang_arguments
		(:doc "Append the native input and linker options, then apply the resolved C standard.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(unit (shared-array u8)) (binary (shared-array u8)) (library_os u8) (exports (shared-array u8)) (name (shared-array u8))
			(output (mut-array u8)) (frontend FrontendOptions))
		(returns i32)
		(body
			(let input (call write_plain_argument (borrow-shared unit) (borrow-mut output)
				frontend/common_end))
			(let os (if library_os.eqz (then (call host_os)) (else library_os)))
			(let-mut end (call write_link_inputs (borrow-shared bytes) (borrow-shared config) invocation
				(borrow-shared arguments) (borrow-shared nodes) (borrow-shared settings) os
				(borrow-mut output) input))
			(if
				(:doc "The serial invocation applies both compilation and link settings for a library.")
				library_os.not-eqz
				(then
					(let relocation (call write_library_compile_options (borrow-mut output) end))
					(set end (call write_library_link_options library_os (borrow-shared exports) (borrow-shared name)
						(borrow-mut output) relocation))))
			(let standard (call write_clang_standard frontend/standard (borrow-mut output) end))
			(let binary_end (call write_native_output (borrow-shared binary) (borrow-mut output) standard))
			(return (call write_include_trace (borrow-mut output) binary_end))))
)
