(module native_c_arguments
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Pack Clang's arguments from the resolved project and explicit options.

	Keep each decoded option as one argument. The process launcher takes
	NUL-terminated rows and adds the executable name as argv[0].`)

	(use wove-file "../cli/command/args.wove" (only first_command_argument (type CommandArgument)))
	(use wove-file "../cli/command/resolve.wove" (only command_setting (type CommandInvocation) (type CommandSetting)))
	(use wove-file "../config/defaults.wove" (only write_default_cflag))
	(use wove-file "../c/standard.wove" (only write_c_standard))
	(use wove-file "../config/project.wove" (only (type ProjectSetting)))
	(use wove-file "../json/reader.wove" (only json_decode_string (type JsonNode)))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "./platform.wove" (only host_os))

	(struct FrontendOptions (fields (common_end i32) (probe_end i32) (standard u32)))

	(let no_prefix "")
	(let define_prefix "-D")
	(let library_prefix "-l")
	(let relative_prefix "./")
	(let thin_lto "-flto=thin")
	(let full_lto "-flto=full")
	(let gnu_features "-D_GNU_SOURCE")
	(let darwin_features "-D_DARWIN_C_SOURCE")
	(let include_flag "-I")
	(let output_flag "-o")
	(let clang_frontend_flag "-Xclang")
	(let include_trace_flag "-dependency-dot")
	(let stdout_path "-")
	(let math_library "-lm")

	(fn write_argument
		(:doc `Append one argument and one terminator, rejecting unrepresentable bytes or capacity.`)
		(params (value (shared-array u8)) (prefix (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc `A failed cursor stays failed. Leave room for both byte views and the terminator.`)
				(bool.or (i32.lt (local cursor) 0i32)
					(u64.lt (int.convert u64 (array.len (local output)))
						(u64.add.wrapping (int.convert u64 (array.len (local value)))
							(u64.add.wrapping (int.convert u64 (array.len (local prefix)))
								(u64.add.wrapping (int.convert u64 (local cursor)) 1u64)))))
				(then (return -1i32)))
			(let-mut index 0i32)
			(while
				(:doc `An escaped JSON NUL must never split one configured flag into additional arguments.`)
				(i32.lt (local index) (array.len (local value)))
				(body
					(if (u8.eq (array.load (local value) (local index)) 0u8) (then (return -1i32)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(let start (call append_bytes (borrow-shared (local prefix)) (borrow-mut (local output)) (local cursor)))
			(let end (call append_bytes (borrow-shared (local value)) (borrow-mut (local output)) (local start)))
			(array.store (local output) (local end) 0u8)
			(return (i32.add.wrapping (local end) 1i32))))

	(fn write_plain_argument
		(:doc `Forward one argument without adding a prefix.`)
		(params (value (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body (return (call write_argument (borrow-shared (local value)) (borrow-shared (local no_prefix))
			(borrow-mut (local output)) (local cursor)))))

	(fn write_option
		(:doc `Apply the argument spelling for definitions, named libraries, and relative link files.`)
		(params (rule i32) (value (shared-array u8)) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc `Definitions must be one joined -D argument even when their value contains spaces.`)
				(bool.or (i32.eq (local rule) 14i32) (i32.eq (local rule) 21i32))
				(then (return (call write_argument (borrow-shared (local value)) (borrow-shared (local define_prefix))
					(borrow-mut (local output)) (local cursor)))))
			(if
				(:doc `Turn a configured library name into a linker search argument.`)
				(i32.eq (local rule) 16i32)
				(then (return (call write_argument (borrow-shared (local value)) (borrow-shared (local library_prefix))
					(borrow-mut (local output)) (local cursor)))))
			(if
				(:doc `Disambiguate link filenames from command options and Clang response files.`)
				(bool.and (i32.eq (local rule) 17i32)
					(bool.and (i32.lt 0i32 (array.len (local value)))
						(bool.or (u8.eq (array.load (local value) 0i32) 45u8)
							(u8.eq (array.load (local value) 0i32) 64u8))))
				(then (return (call write_argument (borrow-shared (local value)) (borrow-shared (local relative_prefix))
					(borrow-mut (local output)) (local cursor)))))
			(return (call write_plain_argument (borrow-shared (local value)) (borrow-mut (local output)) (local cursor)))))

	(fn write_argv_options
		(:doc `Walk surviving CLI values in order, including when other rules occur between them.`)
		(params (bytes (shared-array u8)) (arguments (shared-array CommandArgument)) (rows i32) (setting CommandSetting)
			(rule i32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let-mut end (local cursor))
			(let-mut row (struct.get (local setting) row))
			(let-mut remaining (struct.get (local setting) count))
			(while
				(:doc `The resolver gives the first effective row and the exact number of values after the last clear.`)
				(i32.lt 0i32 (local remaining))
				(body
					(let found (call first_command_argument (borrow-shared (local arguments)) (local row) (local rows) (local rule)))
					(let item (array.load (local arguments) (local found)))
					(set (local end) (call write_option (local rule)
						(borrow-shared (array.range (local bytes) (struct.get (local item) start) (struct.get (local item) end)))
						(borrow-mut (local output)) (local end)))
					(set (local row) (i32.add.wrapping (local found) 1i32))
					(set (local remaining) (i32.sub.wrapping (local remaining) 1i32))))
			(return (local end))))

	(fn write_config_options
		(:doc `Decode the selected JSONC list directly from its validated source nodes.`)
		(params (config (shared-array u8)) (nodes (shared-array JsonNode)) (array_node i32)
			(rule i32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let-mut end (local cursor))
			(let-mut row (struct.get (array.load (local nodes) (local array_node)) first_child))
			(while
				(:doc `Every list child is one string, and decoded bytes fit within the raw quoted token's width.`)
				(bool.and (i32.lt -1i32 (local row)) (i32.lt -1i32 (local end)))
				(body
					(let item (array.load (local nodes) (local row)))
					(let start (struct.get (local item) start))
					(let finish (struct.get (local item) end))
					(let-mut scratch (array.alloc u8 (i32.sub.wrapping (local finish) (local start))))
					(let decoded (call json_decode_string (borrow-shared (local config)) (local start) (local finish)
						(borrow-mut (local scratch))))
					(if (u32.lt 0u32 (struct.get (local decoded) error)) (then (return -1i32)))
					(set (local end) (call write_option (local rule)
						(borrow-shared (array.range (local scratch) 0i32 (struct.get (local decoded) written)))
						(borrow-mut (local output)) (local end)))
					(set (local row) (struct.get (local item) next_sibling))))
			(return (local end))))

	(fn write_default_options
		(:doc `Copy the built-in optimization and debugging arguments for the resolved mode.`)
		(params (mode u32) (count i32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let-mut end (local cursor))
			(let-mut row 0i32)
			(let-mut scratch (array.alloc u8 3i32))
			(while
				(:doc `Only cflags has a nonempty built-in list.`)
				(i32.lt (local row) (local count))
				(body
					(let width (call write_default_cflag (local mode) (local row) (borrow-mut (local scratch))))
					(set (local end) (call write_plain_argument (borrow-shared (array.range (local scratch) 0i32 (local width)))
						(borrow-mut (local output)) (local end)))
					(set (local row) (i32.add.wrapping (local row) 1i32))))
			(return (local end))))

	(fn write_lto
		(:doc `Add the resolved Clang link-time optimization mode when it is enabled.`)
		(params (mode u32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(if
				(:doc `Thin LTO is distinct from full-module LTO.`)
				(u32.eq (local mode) 1u32)
				(then (return (call write_plain_argument (borrow-shared (local thin_lto)) (borrow-mut (local output)) (local cursor)))))
			(if
				(:doc `An explicit full mode reaches both compilation and linking.`)
				(u32.eq (local mode) 2u32)
				(then (return (call write_plain_argument (borrow-shared (local full_lto)) (borrow-mut (local output)) (local cursor)))))
			(return (local cursor))))

	(fn write_effective_options
		(:doc "Append the one effective list selected for a compiler or linker rule.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(rule i32) (output (mut-array u8)) (cursor i32))
		(returns i32)
		(body
			(let-mut scope 3u32)
			(if
				(:doc "Retained C takes its definitions from cc, while binary options come from the build mode.")
				(i32.eq (local rule) 21i32)
				(then (set (local scope) 4u32)))
			(let setting (call command_setting (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) (local scope) (local rule)))
			(let origin (struct.get (local setting) origin))
			(if
				(:doc "An explicit list, including an empty clear, wins over the project and built-in lists.")
				(u32.eq (local origin) 2u32)
				(then (return (call write_argv_options (borrow-shared (local bytes)) (borrow-shared (local arguments))
					(struct.get (local invocation) rows) (local setting) (local rule) (borrow-mut (local output)) (local cursor)))))
			(if
				(:doc "Use the selected project list when one was supplied.")
				(u32.eq (local origin) 1u32)
				(then (return (call write_config_options (borrow-shared (local config))
					(borrow-shared (local nodes)) (struct.get (local setting) row) (local rule) (borrow-mut (local output)) (local cursor)))))
			(return (call write_default_options (struct.get (local invocation) mode)
				(struct.get (local setting) count) (borrow-mut (local output)) (local cursor)))))

	(fn write_feature_flags
		(:doc "Apply the same feature definitions before generated code and header probes.")
		(params (output (mut-array u8)))
		(returns i32)
		(body
			(let posix (call write_plain_argument (borrow-shared (local gnu_features)) (borrow-mut (local output)) 0i32))
			(return (call write_plain_argument (borrow-shared (local darwin_features)) (borrow-mut (local output)) (local posix)))))

	(fn frontend_capacity
		(:doc "Bound the buffer for decoded flags, terminators, and caller-supplied native paths.")
		(params (bytes i32) (config i32) (arguments i32) (paths u64)) (returns i32)
		(body
			(let extent (u64.add.wrapping (int.convert u64 (local bytes))
				(u64.add.wrapping (int.convert u64 (local config)) (int.convert u64 (local arguments)))))
			(let width (u64.add.wrapping 256u64
				(u64.add.wrapping (local paths) (u64.shl (local extent) 2i32))))
			(if
				(:doc "Reserve one byte for reporting options that exceed a native slice.")
				(u64.lt 2147483647u64 (local width))
				(then (return 1i32)))
			(return (int.convert i32 (local width)))))

	(fn write_frontend_arguments
		(:doc "Pack the same declaration-affecting arguments for the Clang probe and the build.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(directory (shared-array u8)) (output (mut-array u8)))
		(returns i32)
		(body
			(let-mut start (call write_feature_flags (borrow-mut (local output))))
			(if
				(:doc "Binary compilation searches the private build directory containing the runtime assets.")
				(i32.lt 0i32 (array.len (local directory)))
				(then
					(let include (call write_plain_argument (borrow-shared (local include_flag)) (borrow-mut (local output)) (local start)))
					(set (local start) (call write_plain_argument (borrow-shared (local directory)) (borrow-mut (local output)) (local include)))))
			(let flags (call write_effective_options (borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
				(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings)) 13i32
				(borrow-mut (local output)) (local start)))
			(let bin (u32.eq (struct.get (local invocation) command) 2u32))
			(let-mut define_rule 21i32)
			(if
				(:doc "Binary definitions use the selected build mode's list.")
				(local bin)
				(then (set (local define_rule) 14i32)))
			(let defines (call write_effective_options (borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
				(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings)) (local define_rule)
				(borrow-mut (local output)) (local flags)))
			(if
				(:doc "Binary compilation also uses the selected link-time optimization mode.")
				(local bin)
				(then
					(let lto (call command_setting (local invocation) (borrow-shared (local arguments))
						(borrow-shared (local nodes)) (borrow-shared (local settings)) 3u32 18i32))
					(return (call write_lto (struct.get (local lto) scalar) (borrow-mut (local output)) (local defines)))))
			(return (local defines))))

	(fn write_clang_standard
		(:doc "Set the driver and frontend dialects after forwarded options.")
		(params (standard u32) (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let driver (call write_c_standard (local standard) (borrow-mut (local output)) (local cursor)))
			(let frontend (call write_plain_argument (borrow-shared (local clang_frontend_flag)) (borrow-mut (local output)) (local driver)))
			(return (call write_c_standard (local standard) (borrow-mut (local output)) (local frontend)))))

	(fn write_probe_options
		(:doc "Resolve the dialect once and write it after the shared frontend options for the probe.")
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(directory (shared-array u8)) (output (mut-array u8))) (returns FrontendOptions)
		(body
			(let dialect (call command_setting (local invocation) (borrow-shared (local arguments))
				(borrow-shared (local nodes)) (borrow-shared (local settings)) 4u32 20i32))
			(let standard (struct.get (local dialect) scalar))
			(let common_end (call write_frontend_arguments (borrow-shared (local bytes)) (borrow-shared (local config)) (local invocation)
				(borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings))
				(borrow-shared (local directory)) (borrow-mut (local output))))
			(let probe_end (call write_clang_standard (local standard) (borrow-mut (local output)) (local common_end)))
			(if
				(:doc "An unterminated byte signals an invalid prefix if a header needs a live probe.")
				(i32.lt (local probe_end) 0i32)
				(then
					(array.store (local output) 0i32 1u8)
					(return (struct.new FrontendOptions (common_end -1i32) (probe_end 1i32) (standard (local standard))))))
			(return (struct.new FrontendOptions (common_end (local common_end)) (probe_end (local probe_end))
				(standard (local standard))))))

	(fn write_include_trace
		(:doc `Stream all frontend include graphs to private stdout independently of make depfile settings.`)
		(params (output (mut-array u8)) (cursor i32)) (returns i32)
		(body
			(let trace (call write_plain_argument (borrow-shared (local clang_frontend_flag)) (borrow-mut (local output)) (local cursor)))
			(let name (call write_plain_argument (borrow-shared (local include_trace_flag)) (borrow-mut (local output)) (local trace)))
			(let file (call write_plain_argument (borrow-shared (local clang_frontend_flag)) (borrow-mut (local output)) (local name)))
			(return (call write_plain_argument (borrow-shared (local stdout_path)) (borrow-mut (local output)) (local file)))))

	(fn write_clang_arguments
		(:doc `Append the native input and linker options, then apply the resolved C standard.`)
		(params (bytes (shared-array u8)) (config (shared-array u8)) (invocation CommandInvocation)
			(arguments (shared-array CommandArgument)) (nodes (shared-array JsonNode)) (settings (shared-array ProjectSetting))
			(unit (shared-array u8)) (binary (shared-array u8)) (output (mut-array u8)) (frontend FrontendOptions))
		(returns i32)
		(body
			(let-mut end (call write_plain_argument (borrow-shared (local unit)) (borrow-mut (local output))
				(struct.get (local frontend) common_end)))
			(let rules (array.new (array i32 3) 15i32 17i32 16i32))
			(let-mut index 0i32)
			(while
				(:doc "Link requests follow the source unit, with named libraries last.")
				(i32.lt (local index) 3i32)
				(body
					(let rule (array.load (local rules) (local index)))
					(set (local end) (call write_effective_options (borrow-shared (local bytes)) (borrow-shared (local config))
						(local invocation) (borrow-shared (local arguments)) (borrow-shared (local nodes)) (borrow-shared (local settings))
						(local rule) (borrow-mut (local output)) (local end)))
					(set (local index) (i32.add.wrapping (local index) 1i32))))
			(if
				(:doc `Linux keeps the system math library as a separate link dependency.`)
				(u8.eq (call host_os) 1u8)
				(then
					(set (local end) (call write_plain_argument (borrow-shared (local math_library))
						(borrow-mut (local output)) (local end)))))
			(let standard (call write_clang_standard (struct.get (local frontend) standard) (borrow-mut (local output)) (local end)))
			(let option (call write_plain_argument (borrow-shared (local output_flag)) (borrow-mut (local output)) (local standard)))
			(let binary_end (call write_plain_argument (borrow-shared (local binary)) (borrow-mut (local output)) (local option)))
			(return (call write_include_trace (borrow-mut (local output)) (local binary_end)))))
)
