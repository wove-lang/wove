(module native_cli_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Build filesystem paths for native imports and embeds without discarding components before POSIX lookup.")

	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn directory_width
		(:doc "Return the extent of the directory prefix, including its final slash if present.")
		(params (path (shared-slice u8))) (returns i32)
		(body
			(let-mut cursor (i32.sub.wrapping (slice.len (local path)) (i32 1)))
			(while
				(:doc "A bare filename has an empty directory prefix.")
				(bool.and (i32.lt (i32 -1) (local cursor))
					(bool.not (u8.eq (slice.load (local path) (local cursor)) (u8 47))))
				(body (set (local cursor) (i32.sub.wrapping (local cursor) (i32 1)))))
			(return (i32.add.wrapping (local cursor) (i32 1)))))

	(fn join_file_path
		(:doc "Join a relative file request to its defining path. Leave absolute requests and filesystem components intact.")
		(params (defining_path (shared-slice u8)) (request (shared-slice u8))) (returns (owned-array u8))
		(body
			(let width (slice.len (local request)))
			(let-mut prefix (i32 0))
			(if
				(:doc "Only a nonempty relative request needs the defining directory.")
				(bool.and (i32.lt (i32 0) (local width))
					(bool.not (u8.eq (slice.load (local request) (i32 0)) (u8 47))))
				(then (set (local prefix) (call directory_width (borrow-shared (local defining_path))))))
			(if
				(:doc "An empty or oversized request cannot name a file.")
				(bool.or (i32.eq (local width) (i32 0))
					(i32.lt (i32.sub.wrapping (i32 2147483647) (local prefix)) (local width)))
				(then
					(let empty (array.alloc u8 (i32 0)))
					(return (move (local empty)))))
			(let-mut path (array.alloc u8 (i32.add.wrapping (local prefix) (local width))))
			(let start (call append_bytes (borrow-shared (slice.range (local defining_path) (i32 0) (local prefix)))
				(borrow-mut (local path)) (i32 0)))
			(let end (call append_bytes (borrow-shared (local request)) (borrow-mut (local path)) (local start)))
			(return (move (local path))))))
