(module native_cli_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Build filesystem paths for native imports and embeds without discarding components before POSIX lookup.")

	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn directory_width
		(:doc "Return the extent of the directory prefix, including its final slash if present.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let-mut cursor (i32:dec path.len))
			(while
				(:doc "A bare filename has an empty directory prefix.")
				(bool:and (i32:lt -1i32 cursor)
					(u8:not-eq (path.get cursor) 47u8))
				(body (set cursor cursor.dec)))
			(return cursor.inc)))

	(fn path_directory_width
		(:doc `Use the defining directory only when the requested path is relative.`)
		(params (defining_path (shared-array u8)) (request (shared-array u8))) (returns i32)
		(body
			(if
				(:doc `An absolute or empty path needs no prefix.`)
				(bool:or (i32:eqz request.len)
					(u8:eq (request.get 0i32) 47u8))
				(then (return 0i32)))
			(return (call directory_width (borrow-shared defining_path)))))

	(fn write_file_path
		(:doc `Measure a joined path and copy it only when the complete spelling fits. Preserve POSIX path components.`)
		(params (defining_path (shared-array u8)) (request (shared-array u8)) (output (mut-array u8))) (returns i32)
		(body
			(let width request.len)
			(let prefix (call path_directory_width (borrow-shared defining_path) (borrow-shared request)))
			(if
				(:doc `An empty or oversized request cannot name a file.`)
				(bool:or width.eqz
					(i32:lt (i32:sub 2147483647i32 prefix) width))
				(then (return -1i32)))
			(let length (prefix.add width))
			(if
				(:doc `A short caller view receives the required width without partial output.`)
				(i32:lt output.len length)
				(then (return length)))
			(let start (call append_bytes (borrow-shared (defining_path.range 0i32 prefix))
				(borrow-mut output) 0i32))
			(return (call append_bytes (borrow-shared request) (borrow-mut output) start))))

	(fn join_file_path
		(:doc `Allocate the exact joined path for callers that use byte owners.`)
		(params (defining_path (shared-array u8)) (request (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut empty (array:alloc u8 0i32))
			(let length (call write_file_path (borrow-shared defining_path) (borrow-shared request)
				(borrow-mut empty)))
			(if length.ltz (then (return (move empty))))
			(let-mut path (array:alloc u8 length))
			(let end (call write_file_path (borrow-shared defining_path) (borrow-shared request)
				(borrow-mut path)))
			(return (move path))))
)
