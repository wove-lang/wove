(module native_cli_paths
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Build filesystem paths for native imports and embeds without discarding components before POSIX lookup.")

	(use wove-file "../text/copy.wove" (only append_bytes))

	(fn directory_width
		(:doc "Return the extent of the directory prefix, including its final slash if present.")
		(params (path (shared-array u8))) (returns i32)
		(body
			(let-mut cursor (i32.sub.wrapping (array.len (local path)) 1i32))
			(while
				(:doc "A bare filename has an empty directory prefix.")
				(bool.and (i32.lt -1i32 (local cursor))
					(bool.not (u8.eq (array.load (local path) (local cursor)) 47u8)))
				(body (set (local cursor) (i32.sub.wrapping (local cursor) 1i32))))
			(return (i32.add.wrapping (local cursor) 1i32))))

	(fn path_directory_width
		(:doc `Use the defining directory only when the requested path is relative.`)
		(params (defining_path (shared-array u8)) (request (shared-array u8))) (returns i32)
		(body
			(if
				(:doc `An absolute or empty path needs no prefix.`)
				(bool.or (i32.eq (array.len (local request)) 0i32)
					(u8.eq (array.load (local request) 0i32) 47u8))
				(then (return 0i32)))
			(return (call directory_width (borrow-shared (local defining_path))))))

	(fn write_file_path
		(:doc `Measure a joined path and copy it only when the complete spelling fits. Preserve POSIX path components.`)
		(params (defining_path (shared-array u8)) (request (shared-array u8)) (output (mut-array u8))) (returns i32)
		(body
			(let width (array.len (local request)))
			(let prefix (call path_directory_width (borrow-shared (local defining_path)) (borrow-shared (local request))))
			(if
				(:doc `An empty or oversized request cannot name a file.`)
				(bool.or (i32.eq (local width) 0i32)
					(i32.lt (i32.sub.wrapping 2147483647i32 (local prefix)) (local width)))
				(then (return -1i32)))
			(let length (i32.add.wrapping (local prefix) (local width)))
			(if
				(:doc `A short caller view receives the required width without partial output.`)
				(i32.lt (array.len (local output)) (local length))
				(then (return (local length))))
			(let start (call append_bytes (borrow-shared (array.range (local defining_path) 0i32 (local prefix)))
				(borrow-mut (local output)) 0i32))
			(return (call append_bytes (borrow-shared (local request)) (borrow-mut (local output)) (local start)))))

	(fn join_file_path
		(:doc `Allocate the exact joined path for callers that use byte owners.`)
		(:pragma (cfg (not bootstrap)))
		(params (defining_path (shared-array u8)) (request (shared-array u8))) (returns (owned-array u8))
		(body
			(let-mut empty (array.alloc u8 0i32))
			(let length (call write_file_path (borrow-shared (local defining_path)) (borrow-shared (local request))
				(borrow-mut (local empty))))
			(if (i32.lt (local length) 0i32) (then (return (move (local empty)))))
			(let-mut path (array.alloc u8 (local length)))
			(let end (call write_file_path (borrow-shared (local defining_path)) (borrow-shared (local request))
				(borrow-mut (local path))))
			(return (move (local path)))))
)
