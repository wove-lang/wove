(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Read function names and selective Wove-file imports from checked source rows.

	Return child indices into the same tree. A malformed operand retains its
	original byte span for the graph diagnostic.`)
	source_imports

	(use wove-file "./source_scan.wove" (only is_head_byte is_identifier_head (type SourceNode)))
	(use wove-file "./source_module.wove" (only form_parts select_form))

	(struct ImportRead (fields (first i32) (second i32) (start i32) (end i32) (error u32)))

	(fn
		(:doc `Recognize the graph grammar's bare keywords.

		Return 1 for fn, 2 for use, 3 for wove-file, 4 for only, and 5 for as.`)
		import_keyword
		(params (source (shared-slice u8)) (node SourceNode))
		(returns u32)
		(body
			(if
				(:doc "Only bare atoms have keyword spellings.")
				(bool.not (u32.eq (record.get (local node) kind) (u32 1)))
				(then (return (u32 0))))
			(let start (record.get (local node) start))
			(let width (i32.sub.wrapping (record.get (local node) end) (local start)))
			(if
				(:doc "Match the entire fn spelling.")
				(bool.and (i32.eq (local width) (i32 2))
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 102))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 110))))
				(then (return (u32 1))))
			(if
				(:doc "Match the entire use spelling.")
				(bool.and (i32.eq (local width) (i32 3))
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 117))
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 115))
							(call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 101)))))
				(then (return (u32 2))))
			(if
				(:doc "Match the entire wove-file spelling.")
				(bool.and (i32.eq (local width) (i32 9))
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 119))
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 111))
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 118))
								(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 101))
									(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 4) (u8 45))
										(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 5) (u8 102))
											(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 6) (u8 105))
												(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 7) (u8 108))
													(call is_head_byte (borrow-shared (local source)) (local start) (i32 8) (u8 101)))))))))))
				(then (return (u32 3))))
			(if
				(:doc "Match the entire only spelling.")
				(bool.and (i32.eq (local width) (i32 4))
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 111))
						(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 110))
							(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 2) (u8 108))
								(call is_head_byte (borrow-shared (local source)) (local start) (i32 3) (u8 121))))))
				(then (return (u32 4))))
			(if
				(:doc "Match the entire as spelling.")
				(bool.and (i32.eq (local width) (i32 2))
					(bool.and (call is_head_byte (borrow-shared (local source)) (local start) (i32 0) (u8 97))
						(call is_head_byte (borrow-shared (local source)) (local start) (i32 1) (u8 115))))
				(then (return (u32 5))))
			(return (u32 0))))

	(fn
		(:doc `Check a bare identifier with the seed's name spelling rules.`)
		(:pragma (inline always))
		is_import_name
		(params (source (shared-slice u8)) (node SourceNode))
		(returns bool)
		(body
			(return (bool.and (u32.eq (record.get (local node) kind) (u32 1))
				(call is_identifier_head (borrow-shared (local source))
					(record.get (local node) start) (record.get (local node) end))))))

	(fn
		(:doc `Point a graph grammar result at its originating source node.`)
		import_at
		(params (node SourceNode) (first i32) (second i32) (error u32))
		(returns ImportRead)
		(body
			(return (record.make ImportRead (first (local first)) (second (local second))
				(start (record.get (local node) start)) (end (record.get (local node) end))
				(error (local error))))))

	(fn
		(:doc `Require a known operand form and check its ordinary metadata context.`)
		import_form
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (keyword u32))
		(returns ImportRead)
		(body
			(let parts (call form_parts (borrow-shared (local source)) (borrow-shared (local nodes)) (local node)))
			(let head (record.get (local parts) head))
			(if
				(:doc "An absent or wrong head is an error on the operand form.")
				(bool.or (i32.lt (local head) (i32 0))
					(bool.not (u32.eq (call import_keyword (borrow-shared (local source))
						(slice.load (local nodes) (local head))) (local keyword))))
				(then (return (call import_at (local node) (i32 -1) (i32 -1) (u32 26)))))
			(let selection (call select_form (borrow-shared (local source)) (borrow-shared (local nodes))
				(local node) (local parts) (bool false)))
			(if
				(:doc "An invalid selection pragma keeps its own span.")
				(u32.lt (u32 0) (record.get (local selection) error))
				(then (return (record.make ImportRead (first (i32 -1)) (second (i32 -1))
					(start (record.get (local selection) start)) (end (record.get (local selection) end))
					(error (record.get (local selection) error))))))
			(return (call import_at (local node) (record.get (local parts) operands) (i32 -1) (u32 0)))))

	(fn
		(:doc `Read the file token and the first only selector from an active use.`)
		read_import
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (node SourceNode) (operands i32))
		(returns ImportRead)
		(body
			(if
				(:doc "An empty use is missing all three required operands.")
				(i32.lt (local operands) (i32 0))
				(then (return (call import_at (local node) (i32 -1) (i32 -1) (u32 26)))))
			(let provider (slice.load (local nodes) (local operands)))
			(if
				(:doc "This graph accepts the Wove-file provider.")
				(bool.not (u32.eq (call import_keyword (borrow-shared (local source)) (local provider)) (u32 3)))
				(then (return (call import_at (local provider) (i32 -1) (i32 -1) (u32 26)))))
			(let path (record.get (local provider) next_sibling))
			(if
				(:doc "The provider is followed by a path token.")
				(i32.lt (local path) (i32 0))
				(then (return (call import_at (local node) (i32 -1) (i32 -1) (u32 26)))))
			(let literal (slice.load (local nodes) (local path)))
			(if
				(:doc "The path uses a checked quoted or raw string.")
				(bool.not (u32.eq (record.get (local literal) kind) (u32 2)))
				(then (return (call import_at (local literal) (i32 -1) (i32 -1) (u32 26)))))
			(let list (record.get (local literal) next_sibling))
			(if
				(:doc "The use must end with an explicit selection list, even when it is empty.")
				(i32.lt (local list) (i32 0))
				(then (return (call import_at (local node) (i32 -1) (i32 -1) (u32 26)))))
			(let list_node (slice.load (local nodes) (local list)))
			(let extra (record.get (local list_node) next_sibling))
			(if
				(:doc "An unexpected operand points at its own node.")
				(bool.not (i32.lt (local extra) (i32 0)))
				(then (return (call import_at (slice.load (local nodes) (local extra)) (i32 -1) (i32 -1) (u32 26)))))
			(let only (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local list_node) (u32 4)))
			(if
				(:doc "Return the original error before interpreting the selection list.")
				(u32.lt (u32 0) (record.get (local only) error))
				(then (return (local only))))
			(return (call import_at (local node) (local path) (record.get (local only) first) (u32 0)))))

	(fn
		(:doc `Read a function selector's original and local names, also accepting an as form.`)
		read_selector
		(params (source (shared-slice u8)) (nodes (shared-slice SourceNode)) (index i32))
		(returns ImportRead)
		(body
			(let item (slice.load (local nodes) (local index)))
			(if
				(:doc "An unrenamed selection uses the same spelling in both files.")
				(call is_import_name (borrow-shared (local source)) (local item))
				(then (return (call import_at (local item) (local index) (local index) (u32 0)))))
			(let alias (call import_form (borrow-shared (local source)) (borrow-shared (local nodes)) (local item) (u32 5)))
			(if
				(:doc "An alias must be a checked as form.")
				(u32.lt (u32 0) (record.get (local alias) error))
				(then (return (local alias))))
			(let original (record.get (local alias) first))
			(if
				(:doc "An alias requires both the provider name and local name.")
				(i32.lt (local original) (i32 0))
				(then (return (call import_at (local item) (i32 -1) (i32 -1) (u32 26)))))
			(let original_node (slice.load (local nodes) (local original)))
			(if
				(:doc "Check the provider name at its own spelling.")
				(bool.not (call is_import_name (borrow-shared (local source)) (local original_node)))
				(then (return (call import_at (local original_node) (i32 -1) (i32 -1) (u32 26)))))
			(let local_name (record.get (local original_node) next_sibling))
			(if
				(:doc "An omitted local name leaves the alias form incomplete.")
				(i32.lt (local local_name) (i32 0))
				(then (return (call import_at (local item) (i32 -1) (i32 -1) (u32 26)))))
			(let local_node (slice.load (local nodes) (local local_name)))
			(if
				(:doc "Check the local name at its own spelling.")
				(bool.not (call is_import_name (borrow-shared (local source)) (local local_node)))
				(then (return (call import_at (local local_node) (i32 -1) (i32 -1) (u32 26)))))
			(let extra (record.get (local local_node) next_sibling))
			(if
				(:doc "The alias has exactly two operands.")
				(bool.not (i32.lt (local extra) (i32 0)))
				(then (return (call import_at (slice.load (local nodes) (local extra)) (i32 -1) (i32 -1) (u32 26)))))
			(return (call import_at (local item) (local original) (local local_name) (u32 0))))))
