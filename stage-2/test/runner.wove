(module test_runner
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "List the executable's inline tests and report each isolated child result.")

	(use wove-file "../io/process.wove" (only run_process_capture))
	(use wove-file "../io/stdio.wove" (only write_stdout write_stderr_line))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_u32 write_decimal_i32))


	(let list_argument "--list\u0000")
	(let list_error "could not list Wove tests")
	(let passed "pass\t")
	(let failed "fail\t")

	(fn report_result
		(:doc "Write the escaped label and normalized status in the existing tab-separated format.")
		(params (inventory (shared-array u8)) (start i32) (end i32) (status i32))
		(returns bool)
		(body
			(let-mut prefix_written (bool false))
			(if
				(:doc "Select the report prefix from the child status.")
				(i32:eqz status)
				(then (set prefix_written (call write_stdout (borrow-shared passed))))
				(else (set prefix_written (call write_stdout (borrow-shared failed)))))
			(let label_written (call write_stdout (borrow-shared (inventory.range start end))))
			(let-mut suffix (array:alloc u8 13i32))
			(suffix.set 0i32 9u8)
			(let length (call write_decimal_i32 (borrow-mut suffix) 1i32 status))
			(suffix.set length 10u8)
			(let status_written (call write_stdout
				(borrow-shared (suffix.range 0i32 (i32:inc length)))))
			(return (bool:and prefix_written (bool:and label_written status_written)))))

	(fn listing_failed
		(:doc "Report a child listing or inventory framing failure through inherited stderr.")
		(params)
		(returns i32)
		(body
			(let written (call write_stderr_line (borrow-shared list_error)))
			(return 1i32)))

	(fn execute_inventory
		(:doc "Run each listed test once in discovery order, even after earlier child failures.")
		(params (program (shared-array u8)) (inventory (shared-array u8)))
		(returns i32)
		(body
			(let-mut selection (array:alloc u8 11i32))
			(let-mut discard (array:alloc u8 0i32))
			(let length inventory.len)
			(let-mut start 0i32)
			(let-mut index 0u32)
			(let-mut unsuccessful (bool false))
			(while
				(:doc "One LF terminates each escaped file and name pair.")
				(i32:lt start length)
				(body
					(let-mut end start)
					(while
						(:doc "Find the next record boundary without interpreting escaped label bytes.")
						(bool:and (i32:lt end length)
							(u8:not-eq (inventory.get end) 10u8))
						(body (set end (i32:inc end))))
					(if
						(:doc "A truncated record cannot name a dispatch slot.")
						(i32:eq end length)
						(then (return (call listing_failed))))
					(let width (call write_decimal_u32 (borrow-mut selection) 0i32 index))
					(selection.set width 0u8)
					(let child (call run_process_capture (borrow-shared program)
						(borrow-shared (selection.range 0i32 (i32:inc width)))
						(borrow-mut discard)))
					(let status child/status)
					(let written (call report_result (borrow-shared inventory) start end status))
					(set unsuccessful (bool:or unsuccessful
						(bool:or (bool:not written) (i32:not-eqz status))))
					(set index (u32:inc index))
					(set start (i32:inc end))))
			(if
				(:doc "Any child failure or report write failure makes the aggregate status nonzero.")
				unsuccessful
				(then (return 1i32)))
			(return 0i32)))

	(fn run_inventory
		(:doc "Capture a complete inventory before dispatching any test.")
		(params (program (shared-array u8)))
		(returns i32)
		(body
			(let-mut capacity 256i32)
			(while
				(:doc "A too-small view is dropped before retrying with more room.")
				(bool true)
				(body
					(let-mut inventory (array:alloc u8 capacity))
					(let listed (call run_process_capture (borrow-shared program)
						(borrow-shared list_argument) (borrow-mut inventory)))
					(if
						(:doc "A nonzero list status invalidates even a fully captured prefix.")
						(i32:not-eqz listed/status)
						(then (return (call listing_failed))))
					(if
						(:doc "Execute only a complete list, including an empty one.")
						(bool:not listed/overflow)
						(then (return (call execute_inventory (borrow-shared program)
							(borrow-shared (inventory.range 0i32 listed/length))))))
					(if
						(:doc "Beyond the largest signed view, the inventory cannot be represented.")
						(i32:eq capacity 2147483647i32)
						(then (return (call listing_failed))))
					(if
						(:doc "Double the next view without overflowing the signed length domain.")
						(i32:lt 1073741823i32 capacity)
						(then (set capacity 2147483647i32))
						(else (set capacity (i32:add capacity capacity))))))))

	(fn main
		(:doc "Accept the running executable's resolved path from the generated test entry.")
		(params (argv (shared-array (shared-array u8))))
		(returns i32)
		(body
			(if
				(:doc "The test wrapper passes the display name followed by the resolved executable path.")
				(i32:not-eq argv.len 2i32)
				(then (return 2i32)))
			(let program (argv.get 1i32))
			(if (i32:eqz program.len) (then (return 2i32)))
			(return (call run_inventory (borrow-shared program)))))
)
