(module c_locale
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<locale.h>"
		(:doc "Create an independent C locale for character classification.")
		(:pragma (cfg (any (os "linux") (os "macos"))))
		(type (:doc "An owned locale released through its native destructor.")
			(:pragma (c_owned (drop freelocale)))
			Locale (c-type "locale_t"))
		(const LC_CTYPE_MASK i32)
		(fn newlocale
			(:doc "Create a locale for the requested categories using a null base. A null result reports failure.")
			(:pragma (c_cstr name))
			(params (mask i32) (name (shared-array u8)) (const base (c-type "locale_t") null))
			(returns Locale))))
