(module c_fnmatch
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fnmatch.h>"
		(:doc "Expose filename-pattern matching and each flag or status visible in the selected native header.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(const FNM_PATHNAME i32)
		(const FNM_NOESCAPE i32)
		(const FNM_PERIOD i32)
		(const FNM_NOMATCH i32)

		(let (:pragma (c_optional) (c_macro)) FNM_LEADING_DIR i32)
		(let (:pragma (c_optional) (c_macro)) FNM_CASEFOLD i32)
		(let (:pragma (c_optional) (c_macro)) FNM_FILE_NAME i32)
		(let
			(:doc "This BSD alias is visible in Darwin's extended header profile.")
			(:pragma (cfg (os "macos")) (c_optional) (c_macro))
			FNM_IGNORECASE i32)
		(let
			(:doc "glibc exposes the flag for ksh-style extended patterns.")
			(:pragma (cfg (os "linux")) (c_optional) (c_macro))
			FNM_EXTMATCH i32)
		(let
			(:doc "Legacy status reserved by Darwin and exposed by glibc when _XOPEN_SOURCE is defined.")
			(:pragma (c_optional) (c_macro))
			FNM_NOSYS i32)

		(fn fnmatch
			(:doc "Match a borrowed pattern against a borrowed name and return the native int status.")
			(:pragma (c_cstr pattern name))
			(params (pattern (shared-array u8)) (name (shared-array u8)) (flags i32))
			(returns i32))))
