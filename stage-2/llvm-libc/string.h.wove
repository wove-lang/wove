(module c_string
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<string.h>"
		(:doc "Bind checked C-string inputs and copy native error messages into owned bytes.")
		(:expect (tests "stage-2/cli/native/string/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(type Size (c-type "size_t"))

		(fn strlen
			(:doc "Return the native byte count before the terminating NUL.")
			(:pragma (c_cstr text))
			(params (text (shared-array u8)))
			(returns Size))

		(fn strcmp
			(:doc "Compare two checked C strings and return the native comparison result.")
			(:pragma (c_cstr left right))
			(params (left (shared-array u8)) (right (shared-array u8)))
			(returns i32))

		(fn strncmp
			(:doc "Compare at most count bytes and preserve the header's size_t parameter.")
			(:pragma (c_cstr left right))
			(params (left (shared-array u8)) (right (shared-array u8)) (count Size))
			(returns i32))

		(fn strcoll
			(:doc "Compare two checked C strings using the current native locale.")
			(:pragma (c_cstr left right))
			(params (left (shared-array u8)) (right (shared-array u8)))
			(returns i32))

		(fn strerror
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(:pragma (c_snapshot cstr))
			(params (error i32))
			(returns (optional (owned-array u8))))

		(disabled
			(:doc `Raw memory operations such as memcmp, memcpy, memmove, and memset
		need separate binary-buffer coverage for extents, overlap, and writes.
		The checked C-string copies in this slice do not expose those buffers.`))

		(disabled
			(:doc `strchr, strrchr, strstr, strpbrk, and related searches can return
		pointers into their inputs. Returning a pointer into call-scoped
		C-string scratch needs a result and lifetime contract. Tokenizers also
		need mutable input and state that survives the applicable calls.`))

		(disabled
			(:doc `The XSI strerror_r prototype returns int and writes the caller's
		buffer. GNU glibc returns char * and can select caller storage or
		library storage. Darwin exposes the int form in the profiles where it
		is declared. Keep the profile-selected signatures and result lifetimes
		under a separate contract.`))

		(disabled
			(:doc `The remaining scalar string queries, locale-explicit forms,
		allocating strings, and destination-writing operations need their own
		member and profile coverage.`))))
