(module c_resource
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/resource.h>"
		(:doc "Bind native process priorities, resource-usage accounting, and selected process limits.")
		(:expect (tests "stage-2/cli/native/resource/cases.tsv" "stage-2/cli/native/resource/optional.tsv"
				"stage-2/cli/native/resource/field-cases.tsv")
			(issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:691" "gh:wove-lang/wove:843"))
		(:pragma (cfg (any (os "macos") (os "linux"))))

		(use c-header "<sys/time.h>" (only (type Timeval)))

		(type ResourceWho (:pragma (cfg (os "macos"))) (c-type "int"))
		(type ResourceWho (:pragma (cfg (os "linux"))) (c-type "__rusage_who_t"))
		(type ResourceCount (c-type "long"))
		(struct ResourceUsage
			(c-type "struct rusage")
			(fields (ru_utime Timeval) (ru_stime Timeval)
				(ru_maxrss (:pragma (c_optional)) ResourceCount)
				(ru_ixrss (:pragma (c_optional)) ResourceCount)
				(ru_idrss (:pragma (c_optional)) ResourceCount)
				(ru_isrss (:pragma (c_optional)) ResourceCount)
				(ru_minflt (:pragma (c_optional)) ResourceCount)
				(ru_majflt (:pragma (c_optional)) ResourceCount)
				(ru_nswap (:pragma (c_optional)) ResourceCount)
				(ru_inblock (:pragma (c_optional)) ResourceCount)
				(ru_oublock (:pragma (c_optional)) ResourceCount)
				(ru_msgsnd (:pragma (c_optional)) ResourceCount)
				(ru_msgrcv (:pragma (c_optional)) ResourceCount)
				(ru_nsignals (:pragma (c_optional)) ResourceCount)
				(ru_nvcsw (:pragma (c_optional)) ResourceCount)
				(ru_nivcsw (:pragma (c_optional)) ResourceCount)))

		(const RUSAGE_SELF ResourceWho)
		(const RUSAGE_CHILDREN ResourceWho)
		(const RUSAGE_THREAD (:pragma (c_optional)) ResourceWho)
		(const RUSAGE_LWP (:pragma (c_optional)) ResourceWho)

		(fn getrusage
			(:doc "Fill the borrowed native usage record for the selected process, children, or thread and return C status.")
			(params (who ResourceWho) (usage (mut-ref ResourceUsage)))
			(returns i32))

		(type PriorityId (c-type "id_t"))
		(type PriorityWhich (:pragma (cfg (os "macos"))) (c-type "int"))
		(type PriorityWhich (:pragma (cfg (os "linux"))) (c-type "__priority_which_t"))

		(const PRIO_PROCESS PriorityWhich)
		(const PRIO_PGRP PriorityWhich)
		(const PRIO_USER PriorityWhich)
		(const PRIO_MIN (:pragma (c_optional)) i32)
		(const PRIO_MAX (:pragma (c_optional)) i32)
		(const PRIO_DARWIN_THREAD (:pragma (c_optional)) PriorityWhich)
		(const PRIO_DARWIN_PROCESS (:pragma (c_optional)) PriorityWhich)
		(const PRIO_DARWIN_BG (:pragma (c_optional)) i32)
		(const PRIO_DARWIN_NONUI (:pragma (c_optional)) i32)

		(fn getpriority
			(:doc "Return the native priority. Clear errno before calling to distinguish a valid minus one from failure.")
			(params (which PriorityWhich) (who PriorityId))
			(returns i32))

		(fn setpriority
			(:doc "Pass the requested priority to libc and preserve its native status and errno.")
			(params (which PriorityWhich) (who PriorityId) (priority i32))
			(returns i32))

		(decls
			(:doc "Expose the glibc process-limit call with independent read and write record loans.")
			(:pragma (cfg (os "linux")))
			(type LimitPid (c-type "__pid_t"))
			(type LimitValue (c-type "rlim_t"))
			(type LimitKind (c-type "__rlimit_resource_t"))
			(struct ResourceLimit
				(c-type "struct rlimit")
				(fields (rlim_cur LimitValue) (rlim_max LimitValue)))
			(const RLIMIT_NOFILE LimitKind)
			(fn prlimit
				(:doc "Read or apply the selected limit. Each of the two record slots may be omitted.")
				(:pragma (c_optional) (c_nullable requested previous))
				(params (pid LimitPid) (resource LimitKind) (requested (shared-ref ResourceLimit))
					(previous (mut-ref ResourceLimit)))
				(returns i32)))

		(disabled
			(:doc `Darwin's restricted profiles expose ru_opaque as implementation-defined
			storage. Keep the complete allocation and use the public counter names
			when the native header supplies them. Darwin's ru_first and ru_last
			macros are internal ordering markers.`))
		(disabled
			(:doc `The remaining resource limit selectors, getrlimit,
			setrlimit, and the large-file variants need their own profile selections.
			Glibc uses a GNU enum and a POSIX int for its selectors. The active GNU
			prlimit declaration uses the header typedef and independently nullable
			input and output loans.`))
		(disabled
			(:doc `Darwin's RUSAGE_INFO_V0 through RUSAGE_INFO_V6, RUSAGE_INFO_CURRENT,
			RU_PROC_RUNS_RESLIDE, rusage_info_t, and the versioned rusage_info
			records belong to proc_pid_rusage, which is declared in libproc.h.
			Expose them with that call's flavor-specific record and extent contract.`))
		(disabled
			(:doc `Darwin's getiopolicy_np, setiopolicy_np, IOPOL_* constants,
			RLIMIT_* monitor flavors, WAKEMON_* and CPUMON_MAKE_FATAL flags,
			FOOTPRINT_INTERVAL_RESET, and proc_rlimit_control_wakeupmon are full
			profile extensions. The SDK publishes monitor data and the proc_rlimit_control
			syscall number. The two public I/O policy calls have their own selectors.`))))
