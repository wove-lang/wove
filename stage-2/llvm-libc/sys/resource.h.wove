(module c_resource
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/resource.h>"
		(:doc "Bind native resource-usage accounting and expose its portable CPU time fields.")
		(:expect (tests "stage-2/cli/native/resource/cases.tsv" "stage-2/cli/native/resource/optional.tsv")
			(issues "gh:wove-lang/wove:318"))
		(:pragma (cfg (any (os "macos") (os "linux"))))

		(type ResourceWho (:pragma (cfg (os "macos"))) (c-type "int"))
		(type ResourceWho (:pragma (cfg (os "linux"))) (c-type "__rusage_who_t"))
		(type ResourceSeconds (c-type "long"))
		(type ResourceMicros (:pragma (cfg (os "macos"))) (c-type "int"))
		(type ResourceMicros (:pragma (cfg (os "linux"))) (c-type "long"))

		(struct ResourceTime
			(c-type "struct timeval")
			(fields (tv_sec ResourceSeconds) (tv_usec ResourceMicros)))
		(struct ResourceUsage
			(c-type "struct rusage")
			(fields (ru_utime ResourceTime) (ru_stime ResourceTime)))

		(const RUSAGE_SELF ResourceWho)
		(const RUSAGE_CHILDREN ResourceWho)
		(const RUSAGE_THREAD (:pragma (c_optional)) ResourceWho)
		(const RUSAGE_LWP (:pragma (c_optional)) ResourceWho)

		(fn getrusage
			(:doc "Fill the borrowed native usage record for the selected process, children, or thread and return C status.")
			(params (who ResourceWho) (usage (mut-ref ResourceUsage)))
			(returns i32))

		(disabled
			(:doc `The current view covers ru_utime and ru_stime and retains the entire
			native allocation. The other fourteen counters are named in glibc and in
			Darwin's full feature profile. Strict Darwin headers replace them with
			ru_opaque, so the shared view needs native feature-selected record fields
			before exposing those counters across profiles.`))
		(disabled
			(:doc `The limit and priority selectors, rlim_t and struct rlimit,
			getrlimit, setrlimit, getpriority, and setpriority are a separate group.
			Use the selected glibc selector typedefs to preserve the GNU enum ABI and
			the POSIX int ABI. glibc large-file limit variants also require profile
			selection. prlimit and prlimit64 need independent nullable native record
			loans for the input and output limits.`))
		(disabled
			(:doc `Darwin's RUSAGE_INFO_V0 through RUSAGE_INFO_V6, RUSAGE_INFO_CURRENT,
			RU_PROC_RUNS_RESLIDE, rusage_info_t, and the versioned rusage_info
			records belong to proc_pid_rusage, which is declared in libproc.h.
			Expose them with that call's flavor-specific record and extent contract.`))
		(disabled
			(:doc `Darwin's getiopolicy_np, setiopolicy_np, IOPOL_* constants,
			RLIMIT_* monitor flavors, WAKEMON_* and CPUMON_MAKE_FATAL flags,
			FOOTPRINT_INTERVAL_RESET, and proc_rlimit_control_wakeupmon are full
			profile extensions. The SDK publishes monitor data and the proc_rlimit_control
			syscall number. The two public I/O policy calls have their own selectors.`))))
