(module c_statvfs
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/statvfs.h>"
		(:doc "Query filesystem block and inode capacity using the selected header's native types.")
		(:expect (tests "stage-2/cli/native/statvfs/cases.tsv" "stage-2/cli/native/statvfs/optional.tsv")
			(issues "gh:wove-lang/wove:318"))
		(:pragma (cfg (any (os "macos") (os "linux"))))

		(type FsBlockCount (c-type "fsblkcnt_t"))
		(type FsFileCount (c-type "fsfilcnt_t"))
		(type StatVfsWord (c-type "unsigned long"))
		(struct StatVfs
			(c-type "struct statvfs")
			(fields
				(f_bsize StatVfsWord) (f_frsize StatVfsWord)
				(f_blocks FsBlockCount) (f_bfree FsBlockCount) (f_bavail FsBlockCount)
				(f_files FsFileCount) (f_ffree FsFileCount) (f_favail FsFileCount)
				(f_fsid StatVfsWord) (f_flag StatVfsWord) (f_namemax StatVfsWord)))

		(const ST_RDONLY i32)
		(const ST_NOSUID i32)
		(const ST_NODEV (:pragma (c_optional)) i32)
		(const ST_NOEXEC (:pragma (c_optional)) i32)
		(const ST_SYNCHRONOUS (:pragma (c_optional)) i32)
		(const ST_MANDLOCK (:pragma (c_optional)) i32)
		(const ST_WRITE (:pragma (c_optional)) i32)
		(const ST_APPEND (:pragma (c_optional)) i32)
		(const ST_IMMUTABLE (:pragma (c_optional)) i32)
		(const ST_NOATIME (:pragma (c_optional)) i32)
		(const ST_NODIRATIME (:pragma (c_optional)) i32)
		(const ST_RELATIME (:pragma (c_optional)) i32)
		(const ST_NOSYMFOLLOW (:pragma (c_optional)) i32)

		(fn statvfs
			(:doc "Lend the path and native result record for one filesystem query and preserve the C status.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (result (mut-ref StatVfs)))
			(returns i32))
		(fn fstatvfs
			(:doc "Query the filesystem for the caller's descriptor through a mutable native record loan.")
			(params (fd i32) (result (mut-ref StatVfs)))
			(returns i32))

		(decls (:pragma (cfg (os "linux")))
			(type FsBlockCount64 (c-type "__fsblkcnt64_t"))
			(type FsFileCount64 (c-type "__fsfilcnt64_t"))
			(struct StatVfs64
				(:doc "Use the complete C allocation when the header supplies the explicit large-file record.")
				(:pragma (c_optional))
				(c-type "struct statvfs64")
				(fields
					(f_bsize StatVfsWord) (f_frsize StatVfsWord)
					(f_blocks FsBlockCount64) (f_bfree FsBlockCount64) (f_bavail FsBlockCount64)
					(f_files FsFileCount64) (f_ffree FsFileCount64) (f_favail FsFileCount64)
					(f_fsid StatVfsWord) (f_flag StatVfsWord) (f_namemax StatVfsWord)))
			(fn statvfs64
				(:doc "Lend the path and native result record for one filesystem query and preserve the C status.")
				(:pragma (c_optional) (c_cstr path))
				(params (path (shared-array u8)) (result (mut-ref StatVfs64)))
				(returns i32))
			(fn fstatvfs64
				(:doc "Query the filesystem for the caller's descriptor through a mutable native record loan.")
				(:pragma (c_optional))
				(params (fd i32) (result (mut-ref StatVfs64)))
				(returns i32)))

		(disabled
			(:doc `The optional glibc f_type member is unsigned int where the SDK
			provides it. Earlier headers reserve the same storage. A native
			field availability check lets one record expose it without requiring it
			in other profiles. See gh:wove-lang/wove:691. Native padding and reserved
			storage are retained by the C allocation.`))))
