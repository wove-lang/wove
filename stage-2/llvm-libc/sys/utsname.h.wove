(module c_utsname
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/utsname.h>"
		(:doc "Fill caller-owned storage with native system identification.")
		(:expect (tests "stage-2/cli/native/utsname/cases.tsv" "stage-2/cli/native/utsname/optional.tsv")
			(issues "gh:wove-lang/wove:318"))
		(:pragma (cfg (any (os "macos") (os "linux"))))

		(struct UtsName
			(:pragma (cfg (os "macos")))
			(c-type "struct utsname")
			(fields (sysname (array char 256)) (nodename (array char 256))
				(release (array char 256)) (version (array char 256)) (machine (array char 256))))
		(struct UtsName
			(:pragma (cfg (os "linux")))
			(c-type "struct utsname")
			(fields (sysname (array char 65)) (nodename (array char 65))
				(release (array char 65)) (version (array char 65)) (machine (array char 65))))

		(fn uname
			(:doc "Write the identification fields into the supplied record and return the native status.")
			(params (name (mut-ref UtsName))) (returns i32))
		(const SYS_NMLN
			(:doc "Read the native field width in profiles that expose the glibc extension.")
			(:pragma (c_optional)) i32)

		(disabled
			(:doc `The glibc domain slot has the public name domainname only with GNU
		features. In other profiles glibc names the same native slot __domainname.
		Exposing it needs a native field selection tied to the selected C header's
		feature profile. The C type still supplies storage for the full record.`))))
