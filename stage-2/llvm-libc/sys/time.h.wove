(module c_sys_time
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/time.h>"
		(:doc "Read wall time and process interval timers through their native records.")
		(:expect (tests "stage-2/cli/native/timeval/cases.tsv" "stage-2/cli/native/void-pointer/records.tsv")
			(issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:694"))
		(:pragma (cfg (any (os "macos") (os "linux"))))

		(type TimevalSeconds (c-type "time_t"))
		(type TimevalMicros (c-type "suseconds_t"))
		(struct Timeval
			(c-type "struct timeval")
			(fields (tv_sec TimevalSeconds) (tv_usec TimevalMicros)))

		(fn gettimeofday
			(:doc "Write the current time through a mutable native record loan and pass a typed null timezone.")
			(params (sample (mut-ref Timeval)) (const timezone (c-type "void *") null))
			(returns i32))

		(struct Timezone
			(:pragma (c_optional))
			(c-type "struct timezone")
			(fields (tz_minuteswest i32) (tz_dsttime i32)))
		(fn gettimeofday_timezone
			(:doc "Write wall time and the legacy timezone through disjoint native record loans.")
			(:pragma (c_void_ptr timezone))
			(c-name "gettimeofday")
			(params (sample (mut-ref Timeval)) (timezone (mut-ref Timezone)))
			(returns i32))

		(type IntervalTimerWhich (:pragma (cfg (os "macos"))) (c-type "int"))
		(type IntervalTimerWhich (:pragma (cfg (os "linux"))) (c-type "__itimer_which_t"))
		(struct IntervalTimer
			(c-type "struct itimerval")
			(fields (it_interval Timeval) (it_value Timeval)))
		(const ITIMER_REAL IntervalTimerWhich)
		(const ITIMER_VIRTUAL IntervalTimerWhich)
		(const ITIMER_PROF IntervalTimerWhich)

		(fn getitimer
			(:doc "Write the selected process timer into the caller's native record and return C status.")
			(params (which IntervalTimerWhich) (value (mut-ref IntervalTimer)))
			(returns i32))
		(fn setitimer
			(:doc "Read the new setting and write the previous setting through disjoint native record loans.")
			(params (which IntervalTimerWhich) (setting (shared-ref IntervalTimer))
				(previous (mut-ref IntervalTimer)))
			(returns i32))

		(disabled
			(:doc `The optional previous setting in setitimer and the optional
			record pointers in adjtime, settimeofday, and select need nullable
			native record arguments. See gh:wove-lang/wove:686. select also needs
			the fd_set contract and the related FD_* macro fixtures.`))
		(disabled
			(:doc `utimes, futimes, lutimes, and glibc futimesat accept a borrowed
			native timeval pair or null for the current time. Cover the pair,
			path or descriptor, and the null form together in the file-time slice.`))
		(disabled
			(:doc `The extension profiles also expose time arithmetic and
			timeval/timespec conversion macros. Comparator macros such as timercmp
			and Darwin timevalcmp take a C operator token. The fixed comparison
			contracts need their own coverage. Darwin's timeval64, clockinfo, and
			DST_* names are extension-profile members.`))))
