(module c_times
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/times.h>"
		(:doc "Read process and completed child CPU times through the native clock tick ABI.")
		(:expect (tests "stage-2/cli/native/times/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(type ClockTicks (c-type "clock_t"))
		(struct ProcessTimes
			(c-type "struct tms")
			(fields (tms_utime ClockTicks) (tms_stime ClockTicks)
				(tms_cutime ClockTicks) (tms_cstime ClockTicks)))

		(fn times
			(:doc "Fill caller-owned CPU time fields and return the native tick count or the native (clock_t)-1 error value.")
			(params (sample (mut-ref ProcessTimes)))
			(returns ClockTicks))))
