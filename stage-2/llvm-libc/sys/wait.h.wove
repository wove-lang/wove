(module c_sys_wait
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/wait.h>"
		(:doc "POSIX wait interfaces. Status storage is borrowed for the call and stays with Wove.")
		(:expect (tests "stage-2/cli/native/cases.tsv" "stage-2/cli/native/wait_usage/cases.tsv")
			(issues "gh:wove-lang/wove:641" "gh:wove-lang/wove:318"))
		(use c-header "<sys/resource.h>" (only (type ResourceUsage)))
		(type Pid (c-type "pid_t"))
		(fn wait
			(:doc "Wait for a child with optional caller-owned status storage.")
			(:pragma (c_nullable status))
			(params (status (mut-ref i32)))
			(returns Pid))
		(fn waitpid
			(:doc "Wait for the selected child and optionally store its status.")
			(:pragma (c_nullable status))
			(params (pid Pid) (status (mut-ref i32)) (options i32))
			(returns Pid))

		(const WCONTINUED (:pragma (c_optional)) i32)
		(const WEXITED (:pragma (c_optional)) i32)
		(const WNOHANG i32)
		(const WNOWAIT (:pragma (c_optional)) i32)
		(const WSTOPPED (:pragma (c_optional)) i32)
		(const WUNTRACED i32)

		(fn WEXITSTATUS
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))
		(fn WIFCONTINUED
			(:doc "Interpret a continued child status in profiles that expose the native macro. Older glibc profiles omit it.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WIFEXITED
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WIFSIGNALED
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WIFSTOPPED
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WSTOPSIG
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))
		(fn WTERMSIG
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))

		(type Id (c-type "id_t"))
		(type Uid (c-type "uid_t"))
		(type IdType (c-type "idtype_t"))
		(const P_ALL IdType)
		(const P_PID IdType)
		(const P_PGID IdType)

		(struct SignalInfo
			(:doc "Expose the six child-status fields through the target's complete siginfo_t layout.")
			(:pragma (c_optional))
			(c-type "siginfo_t")
			(fields (si_signo i32) (si_errno i32) (si_code i32) (si_pid Pid) (si_uid Uid) (si_status i32)))
		(fn waitid
			(:doc "Write the selected child's status to caller-owned siginfo_t storage.")
			(:pragma (c_optional))
			(params (kind IdType) (id Id) (info (mut-ref SignalInfo)) (options i32))
			(returns i32))

		(fn wait3
			(:doc "Wait for any child, optionally write its status, and fill caller-owned usage storage.")
			(:pragma (c_optional) (c_nullable status))
			(params (status (mut-ref i32)) (options i32) (usage (mut-ref ResourceUsage)))
			(returns Pid))
		(fn wait4
			(:doc "Wait for the selected child, optionally write its status, and fill caller-owned usage storage.")
			(:pragma (c_optional) (c_nullable status))
			(params (pid Pid) (status (mut-ref i32)) (options i32) (usage (mut-ref ResourceUsage)))
			(returns Pid))
		(fn WCOREDUMP
			(:doc "Return the header's original integer core-dump mask when the macro is visible.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))

		(disabled
			(:doc `The audited macOS and glibc headers expose WCOREDUMP in extension
			profiles. WCORE_DUMPED was absent in every tested C mode and profile.
			The archive's macro sketch is retained here.
	// #[c_macro] fn WCORE_DUMPED(status: i32) -> bool`))
		(disabled
			(:doc `Native wait3 and wait4 also accept a null usage pointer. The current
			binding requires a live ResourceUsage borrow. Nullable mutable native
			record pointers need the existing c_nullable opt-in to support that use.
			See gh:wove-lang/wove:686.`))))
