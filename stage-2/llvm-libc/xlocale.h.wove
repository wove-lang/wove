(module c_xlocale
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<xlocale.h>"
		(:doc "Darwin character classification and conversion with a borrowed locale.")
		(:pragma (cfg (os "macos")))
		(use c-header "<ctype.h>" (only))
		(use c-header "<locale.h>" (only (type Locale)))

		(fn isalnum_l
			(:doc "Classify a letter or digit in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isalpha_l
			(:doc "Classify a letter in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isblank_l
			(:doc "Classify a horizontal blank in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn iscntrl_l
			(:doc "Classify a control character in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isdigit_l
			(:doc "Classify a decimal digit in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isgraph_l
			(:doc "Classify a printing character other than space in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn islower_l
			(:doc "Classify a lowercase letter in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isprint_l
			(:doc "Classify a printing character, including space in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn ispunct_l
			(:doc "Classify punctuation in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isspace_l
			(:doc "Classify whitespace in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isupper_l
			(:doc "Classify an uppercase letter in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isxdigit_l
			(:doc "Classify a hexadecimal digit in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn tolower_l
			(:doc "Apply the lowercase mapping in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn toupper_l
			(:doc "Apply the uppercase mapping in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn digittoint_l
			(:doc "Return the value of a hexadecimal digit in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn ishexnumber_l
			(:doc "Classify a hexadecimal digit in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isideogram_l
			(:doc "Classify an ideogram in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isnumber_l
			(:doc "Classify a numeric character in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isphonogram_l
			(:doc "Classify a phonogram in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isrune_l
			(:doc "Test whether the character is defined in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))

		(fn isspecial_l
			(:doc "Classify a special character in the supplied locale.")
			(params (c i32) (locale (shared-ref Locale))) (returns i32))))
