(module c_time
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<time.h>"
		(:doc "Read the POSIX monotonic clock using the header's native types.")
		(enum Clock (c-type "clockid_t") (members CLOCK_MONOTONIC))
		(type Time (c-type "time_t"))
		(type Long (c-type "long"))
		(struct
			Stamp
			(c-type "struct timespec")
			(fields (tv_sec Time) (tv_nsec Long)))
		(fn clock_gettime
			(:doc "Store the reading in a caller-owned timespec.")
			(params (clock Clock) (stamp (mut-ref Stamp)))
			(returns i32))
		(fn nanosleep
			(:doc "Pause for a native timespec and store any remaining time on interruption.")
			(params (duration (shared-ref Stamp)) (remaining (mut-ref Stamp)))
			(returns i32))))
