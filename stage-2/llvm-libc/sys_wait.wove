(module c_sys_wait
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/wait.h>"
		(:doc "POSIX wait interfaces. Status storage is borrowed for the call and stays with Wove.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:641"))
		(type Pid (c-type "pid_t"))
		(fn wait
			(:doc "Wait for a child with optional caller-owned status storage.")
			(:pragma (c_nullable status))
			(params (status (mut-ref i32)))
			(returns Pid))
		(fn waitpid
			(:doc "Wait for the selected child and optionally store its status.")
			(:pragma (c_nullable status))
			(params (pid Pid) (status (mut-ref i32)) (options i32))
			(returns Pid))

		(const WCONTINUED (:pragma (c_optional)) i32)
		(const WEXITED (:pragma (c_optional)) i32)
		(const WNOHANG i32)
		(const WNOWAIT (:pragma (c_optional)) i32)
		(const WSTOPPED (:pragma (c_optional)) i32)
		(const WUNTRACED i32)

		(fn WEXITSTATUS
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))
		(fn WIFCONTINUED
			(:doc "Interpret a continued child status in profiles that expose the native macro. Older glibc profiles omit it.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WIFEXITED
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WIFSIGNALED
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WIFSTOPPED
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns bool))
		(fn WSTOPSIG
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))
		(fn WTERMSIG
			(:doc "Interpret the child status using the target header's macro.")
			(:pragma (c_macro))
			(params (status i32))
			(returns i32))

		(type Id (c-type "id_t"))
		(type Uid (c-type "uid_t"))
		(type IdType (c-type "idtype_t"))
		(const P_ALL IdType)
		(const P_PID IdType)
		(const P_PGID IdType)

		(struct SignalInfo
			(:doc "Expose the six child-status fields through the target's complete siginfo_t layout.")
			(:pragma (c_optional))
			(c-type "siginfo_t")
			(fields (si_signo i32) (si_errno i32) (si_code i32) (si_pid Pid) (si_uid Uid) (si_status i32)))
		(fn waitid
			(:doc "Write the selected child's status to caller-owned siginfo_t storage.")
			(:pragma (c_optional))
			(params (kind IdType) (id Id) (info (mut-ref SignalInfo)) (options i32))
			(returns i32))

		(disabled
			(:doc `	// Missing: header feature selection for these optional/newer host interfaces.
	// #[c_macro] fn WCOREDUMP(status: i32) -> bool
	// #[c_macro] fn WCORE_DUMPED(status: i32) -> bool
	// type Usage = struct rusage
	// fn wait3(status: &mut i32, options: i32, usage: &mut Usage) -> Pid
	// fn wait4(pid: Pid, status: &mut i32, options: i32, usage: &mut Usage) -> Pid`))))
