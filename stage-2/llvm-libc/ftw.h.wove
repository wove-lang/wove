(module c_ftw
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<ftw.h>"
		(:doc "Expose native walk flags and the available exact traversal record.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(const FTW_F i32)
		(const FTW_D i32)
		(const FTW_DNR i32)
		(const FTW_NS i32)

		(const FTW_SL (:pragma (c_optional)) i32)
		(const FTW_DP (:pragma (c_optional)) i32)
		(const FTW_SLN (:pragma (c_optional)) i32)
		(const FTW_PHYS (:pragma (c_optional)) i32)
		(const FTW_MOUNT (:pragma (c_optional)) i32)
		(const FTW_CHDIR (:pragma (c_optional)) i32)
		(const FTW_DEPTH (:pragma (c_optional)) i32)

		(const FTW_ACTIONRETVAL (:pragma (cfg (os "linux")) (c_optional)) i32)
		(const FTW_CONTINUE (:pragma (cfg (os "linux")) (c_optional)) i32)
		(const FTW_STOP (:pragma (cfg (os "linux")) (c_optional)) i32)
		(const FTW_SKIP_SUBTREE (:pragma (cfg (os "linux")) (c_optional)) i32)
		(const FTW_SKIP_SIBLINGS (:pragma (cfg (os "linux")) (c_optional)) i32)

		(struct Ftw
			(:doc "Expose the native basename byte offset and traversal depth when the header defines the record.")
			(:pragma (c_optional))
			(c-type "struct FTW")
			(fields (base i32) (level i32)))

		(fn ftw
			(:doc "Visit each entry with callback-scoped path and status loans. A nonzero callback result stops traversal.")
			(:pragma (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat FTW_NS) i32) (returns i32)))
				(descriptors i32))
			(returns i32))

		(fn nftw
			(:doc "Lend the native basename offset and recursion level along with each visit.")
			(:pragma (c_optional) (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat FTW_NS) i32 (c-mut-record FTW)) (returns i32)))
				(descriptors i32) (flags i32))
			(returns i32))

		(fn ftw64
			(:doc "Use the glibc large-file status record for each callback invocation.")
			(:pragma (cfg (os "linux")) (c_optional) (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat64 FTW_NS) i32) (returns i32)))
				(descriptors i32))
			(returns i32))

		(fn nftw64
			(:doc "Use the glibc large-file status record and extended traversal information.")
			(:pragma (cfg (os "linux")) (c_optional) (c_cstr path) (c_callback_sync visitor))
			(params (path (shared-array u8))
				(visitor (fn-type (params c-cstr (c-optional-record stat64 FTW_NS) i32 (c-mut-record FTW)) (returns i32)))
				(descriptors i32) (flags i32))
			(returns i32))))
