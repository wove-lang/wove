(module c_ftw
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<ftw.h>"
		(:doc "Expose native walk flags and the available exact traversal record.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(const FTW_F i32)
		(const FTW_D i32)
		(const FTW_DNR i32)
		(const FTW_NS i32)

		(const (:pragma (c_optional)) FTW_SL i32)
		(const (:pragma (c_optional)) FTW_DP i32)
		(const (:pragma (c_optional)) FTW_SLN i32)
		(const (:pragma (c_optional)) FTW_PHYS i32)
		(const (:pragma (c_optional)) FTW_MOUNT i32)
		(const (:pragma (c_optional)) FTW_CHDIR i32)
		(const (:pragma (c_optional)) FTW_DEPTH i32)

		(const (:pragma (cfg (os "linux")) (c_optional)) FTW_ACTIONRETVAL i32)
		(const (:pragma (cfg (os "linux")) (c_optional)) FTW_CONTINUE i32)
		(const (:pragma (cfg (os "linux")) (c_optional)) FTW_STOP i32)
		(const (:pragma (cfg (os "linux")) (c_optional)) FTW_SKIP_SUBTREE i32)
		(const (:pragma (cfg (os "linux")) (c_optional)) FTW_SKIP_SIBLINGS i32)

		(struct
			(:doc "Preserve the native basename byte offset and traversal depth.")
			(:pragma (cfg (os "macos")))
			Ftw
			(c-type "struct FTW")
			(fields (base i32) (level i32)))

		(disabled
			(:doc "glibc defines struct FTW only with extended X/Open enabled. Optional native record selection needs gh:wove-lang/wove:596."))
		(disabled
			(:doc "ftw requires a synchronous callback borrowing the path and usable stat data. A native status pointer can carry undefined data for FTW_NS. See gh:wove-lang/wove:597."))
		(disabled
			(:doc "nftw adds a callback-scoped struct FTW pointer and can interpret GNU FTW_ACTIONRETVAL results. See gh:wove-lang/wove:597."))
		(disabled
			(:doc "glibc ftw64 uses a synchronous callback with a callback-scoped const struct stat64 pointer. See gh:wove-lang/wove:597."))
		(disabled
			(:doc "glibc nftw64 uses the large-file status type and adds the callback-scoped struct FTW pointer. See gh:wove-lang/wove:597."))))
