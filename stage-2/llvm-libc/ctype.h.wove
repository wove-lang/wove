(module c_ctype
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<ctype.h>"
		(:doc `Classification and conversion in the current C locale.
		The standard functions take EOF or a value representable as unsigned char.
		Classification returns zero or a nonzero C int.`)
		(use (:pragma (cfg (os "linux"))) c-header "<locale.h>" (only (type Locale)))

		(fn isalnum
			(:doc "Classify a letter or decimal digit.")
			(params (c i32)) (returns i32))

		(fn isalpha
			(:doc "Classify a letter.")
			(params (c i32)) (returns i32))

		(fn isblank
			(:doc "Classify a horizontal blank.")
			(params (c i32)) (returns i32))

		(fn iscntrl
			(:doc "Classify a control character.")
			(params (c i32)) (returns i32))

		(fn isdigit
			(:doc "Classify a decimal digit.")
			(params (c i32)) (returns i32))

		(fn isgraph
			(:doc "Classify a printing character other than space.")
			(params (c i32)) (returns i32))

		(fn islower
			(:doc "Classify a lowercase letter.")
			(params (c i32)) (returns i32))

		(fn isprint
			(:doc "Classify a printing character, including space.")
			(params (c i32)) (returns i32))

		(fn ispunct
			(:doc "Classify punctuation.")
			(params (c i32)) (returns i32))

		(fn isspace
			(:doc "Classify whitespace.")
			(params (c i32)) (returns i32))

		(fn isupper
			(:doc "Classify an uppercase letter.")
			(params (c i32)) (returns i32))

		(fn isxdigit
			(:doc "Classify a hexadecimal digit.")
			(params (c i32)) (returns i32))

		(fn tolower
			(:doc "Return the lowercase mapping or the original character.")
			(params (c i32)) (returns i32))

		(fn toupper
			(:doc "Return the uppercase mapping or the original character.")
			(params (c i32)) (returns i32))

		(decls
			(:doc "Legacy ASCII helpers and unchecked case conversions on the tested POSIX SDKs.")
			(:pragma (cfg (any (os "linux") (os "macos"))))
			(fn isascii
				(:doc "Test whether an integer lies in the ASCII range.")
				(params (c i32)) (returns i32))

			(fn toascii
				(:doc "Keep the low seven bits of the argument.")
				(params (c i32)) (returns i32))

			(fn _tolower
				(:doc "Convert an uppercase letter to lowercase without checking its class.")
				(:pragma (c_macro))
				(params (c i32)) (returns i32))

			(fn _toupper
				(:doc "Convert a lowercase letter to uppercase without checking its class.")
				(:pragma (c_macro))
				(params (c i32)) (returns i32)))

		(decls
			(:doc "Darwin rune aliases and character classification extensions.")
			(:pragma (cfg (os "macos")))
			(type CTypeRune (c-type "ct_rune_t"))
			(type Rune (c-type "rune_t"))

			(fn digittoint
				(:doc "Return the value of a hexadecimal digit.")
				(params (c i32)) (returns i32))

			(fn ishexnumber
				(:doc "Classify a hexadecimal digit in the current locale.")
				(params (c i32)) (returns i32))

			(fn isideogram
				(:doc "Classify an ideogram in the current locale.")
				(params (c i32)) (returns i32))

			(fn isnumber
				(:doc "Classify a numeric character in the current locale.")
				(params (c i32)) (returns i32))

			(fn isphonogram
				(:doc "Classify a phonogram in the current locale.")
				(params (c i32)) (returns i32))

			(fn isrune
				(:doc "Test whether the current locale defines the character.")
				(params (c i32)) (returns i32))

			(fn isspecial
				(:doc "Classify a special character in the current locale.")
				(params (c i32)) (returns i32)))

		(decls
			(:doc "glibc classifies a character using a mask from the header's native enumeration.")
			(:pragma (cfg (os "linux")))
			(fn isctype
				(:doc "Test a character against a combination of the native classification masks.")
				(params (c i32) (mask i32)) (returns i32))
			(const _ISupper i32)
			(const _ISlower i32)
			(const _ISalpha i32)
			(const _ISdigit i32)
			(const _ISxdigit i32)
			(const _ISspace i32)
			(const _ISprint i32)
			(const _ISgraph i32)
			(const _ISblank i32)
			(const _IScntrl i32)
			(const _ISpunct i32)
			(const _ISalnum i32))

		(decls
			(:doc "glibc character classification and conversion with a borrowed locale.")
			(:pragma (cfg (os "linux")))
			(fn isalnum_l
				(:doc "Classify a letter or digit in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isalpha_l
				(:doc "Classify a letter in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isblank_l
				(:doc "Classify a horizontal blank in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn iscntrl_l
				(:doc "Classify a control character in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isdigit_l
				(:doc "Classify a decimal digit in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isgraph_l
				(:doc "Classify a printing character other than space in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn islower_l
				(:doc "Classify a lowercase letter in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isprint_l
				(:doc "Classify a printing character, including space in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn ispunct_l
				(:doc "Classify punctuation in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isspace_l
				(:doc "Classify whitespace in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isupper_l
				(:doc "Classify an uppercase letter in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isxdigit_l
				(:doc "Classify a hexadecimal digit in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn tolower_l
				(:doc "Apply the lowercase mapping in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn toupper_l
				(:doc "Apply the uppercase mapping in the supplied locale.")
				(params (c i32) (locale (shared-ref Locale))) (returns i32))

			(fn isascii_l
				(:doc "Test the ASCII range. The glibc macro discards its locale operand.")
				(:expect (issues "gh:wove-lang/wove:522"))
				(:pragma (c_macro))
				(params (c i32) (locale (:pragma (c_macro_discard)) (shared-ref Locale))) (returns i32))

			(fn toascii_l
				(:doc "Keep the low seven bits. The glibc macro discards its locale operand.")
				(:expect (issues "gh:wove-lang/wove:522"))
				(:pragma (c_macro))
				(params (c i32) (locale (:pragma (c_macro_discard)) (shared-ref Locale))) (returns i32)))))
