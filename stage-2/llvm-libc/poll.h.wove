(module c_poll
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<poll.h>"
		(:doc "Poll a checked native descriptor array and expose the selected header's event values.")
		(:expect (tests "stage-2/cli/native/poll/cases.tsv" "stage-2/cli/native/poll/optional.tsv"
			"stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(type PollCount (c-type "nfds_t"))
		(struct PollFd (c-type "struct pollfd") (fields (fd i32) (events i16) (revents i16)))

		(fn poll
			(:doc "Poll the requested prefix and update each included record's revents field.")
			(:pragma (c_array descriptors count))
			(params (descriptors (mut-array PollFd)) (count PollCount) (timeout i32))
			(returns i32))

		(const POLLERR i32)
		(const POLLHUP i32)
		(const POLLIN i32)
		(const POLLNVAL i32)
		(const POLLOUT i32)
		(const POLLPRI i32)

		(const POLLATTRIB (:pragma (c_optional)) i32)
		(const POLLEXTEND (:pragma (c_optional)) i32)
		(const POLLMSG (:pragma (c_optional)) i32)
		(const POLLNLINK (:pragma (c_optional)) i32)
		(const POLLRDBAND (:pragma (c_optional)) i32)
		(const POLLRDHUP (:pragma (c_optional)) i32)
		(const POLLRDNORM (:pragma (c_optional)) i32)
		(const POLLREMOVE (:pragma (c_optional)) i32)
		(const POLLSTANDARD (:pragma (c_optional)) i32)
		(const POLLWRBAND (:pragma (c_optional)) i32)
		(const POLLWRITE (:pragma (c_optional)) i32)
		(const POLLWRNORM (:pragma (c_optional)) i32)

		(disabled
			(:doc `Glibc exposes ppoll with GNU features. Its timeout and signal mask
		can each be null or a shared pointer to the exact native object. Concrete
		references compile, but the current call contract rejects a null shared
		native record reference. The audited Darwin header does not declare ppoll. See
		gh:wove-lang/wove:686.`))))
