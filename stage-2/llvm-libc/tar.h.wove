(module c_tar
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<tar.h>"
		(:doc "Expose the native archive field, file type, and mode constants.")
		(:expect (tests "stage-2/cli/native/tar/cases.tsv" "stage-2/cli/native/tar/optional.tsv") (issues "gh:wove-lang/wove:318"))
		(const AREGTYPE i32)
		(const BLKTYPE i32)
		(const CHRTYPE i32)
		(const CONTTYPE i32)
		(const DIRTYPE i32)
		(const FIFOTYPE i32)
		(const LNKTYPE i32)
		(const REGTYPE i32)
		(const SYMTYPE i32)
		(const TGEXEC i32)
		(const TGREAD i32)
		(const TGWRITE i32)
		(const TMAGLEN i32)
		(const TOEXEC i32)
		(const TOREAD i32)
		(const TOWRITE i32)
		(const TSGID i32)
		(const TSUID i32)
		(const TUEXEC i32)
		(const TUREAD i32)
		(const TUWRITE i32)
		(const TVERSLEN i32)
		(const TSVTX
			(:doc "Read the sticky bit in feature profiles where the header publishes it.")
			(:pragma (c_optional)) i32)
		(const TMAGIC (shared-array u8))
		(const TVERSION (shared-array u8))))
