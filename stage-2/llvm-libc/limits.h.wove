		(const MAX_CANON (:pragma (c_optional)) i32)
		(const MAX_INPUT (:pragma (c_optional)) i32)
		(const MQ_PRIO_MAX (:pragma (c_optional)) i32)
		(const NAME_MAX (:pragma (c_optional)) i32)
		(const NGROUPS_MAX (:pragma (c_optional)) i32)
		(const NL_ARGMAX (:pragma (c_optional)) i32)
		(const NL_LANGMAX (:pragma (c_optional)) i32)
		(const NL_MSGMAX (:pragma (c_optional)) i32)
		(const NL_NMAX (:pragma (c_optional)) i32)
		(const NL_SETMAX (:pragma (c_optional)) i32)
		(const NL_TEXTMAX (:pragma (c_optional)) i32)
		(const NZERO (:pragma (c_optional)) i32)
		(const OFF_MAX (:pragma (c_optional)) i64)
		(const OFF_MIN (:pragma (c_optional)) i64)
		(const OPEN_MAX (:pragma (c_optional)) i32)
		(const PASS_MAX (:pragma (c_optional)) i32)
		(const PATH_MAX (:pragma (c_optional)) i32)
		(const PIPE_BUF (:pragma (c_optional)) i32)
		(const PTHREAD_DESTRUCTOR_ITERATIONS (:pragma (c_optional)) i32)
		(const PTHREAD_KEYS_MAX (:pragma (c_optional)) i32)
		(const PTHREAD_STACK_MIN (:pragma (cfg (os "macos")) (c_optional)) i32)
		(let PTHREAD_STACK_MIN (:pragma (cfg (os "linux")) (c_optional) (c_macro_lossless)) i64)
		(const QUAD_MAX (:pragma (c_optional)) i64)
		(const QUAD_MIN (:pragma (c_optional)) i64)
		(const RE_DUP_MAX (:pragma (c_optional)) i32)
		(const RTSIG_MAX (:pragma (c_optional)) i32)
