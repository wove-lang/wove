		(const DELAYTIMER_MAX (:pragma (c_optional)) i32)
		(const EQUIV_CLASS_MAX (:pragma (c_optional)) i32)
		(const EXPR_NEST_MAX (:pragma (c_optional)) i32)
		(const GID_MAX (:pragma (c_optional)) u32)
		(const HOST_NAME_MAX (:pragma (c_optional)) i32)
		(const INT_WIDTH (:pragma (c_optional)) i32)
		(const IOV_MAX (:pragma (c_optional)) i32)
		(const LINE_MAX (:pragma (c_optional)) i32)
