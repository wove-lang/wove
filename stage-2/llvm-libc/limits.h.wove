(module c_limits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<limits.h>"
		(:doc "Read integer limits from the selected C header and feature profile.")
		(:expect (tests "stage-2/cli/native/limits/members.tsv") (issues "gh:wove-lang/wove:318"))

		(const CHAR_BIT i32)
		(const CHAR_MAX i32)
		(const CHAR_MIN i32)
		(const INT_MAX i32)
		(const INT_MIN i32)
		(const LLONG_MAX i64)
		(const LLONG_MIN i64)
		(const LONG_MAX i64)
		(const LONG_MIN i64)
		(const MB_LEN_MAX i32)
		(const SCHAR_MAX i32)
		(const SCHAR_MIN i32)
		(const SHRT_MAX i32)
		(const SHRT_MIN i32)
		(const UCHAR_MAX i32)
		(const UINT_MAX u32)
		(const ULLONG_MAX u64)
		(const ULONG_MAX u64)
		(const USHRT_MAX i32)

		(const AIO_PRIO_DELTA_MAX (:pragma (c_optional)) i32)
		(const ARG_MAX (:pragma (c_optional)) i32)
		(const BC_BASE_MAX (:pragma (c_optional)) i32)
		(const BC_DIM_MAX (:pragma (c_optional)) i32)
		(const BC_SCALE_MAX (:pragma (c_optional)) i32)
		(const BC_STRING_MAX (:pragma (c_optional)) i32)
