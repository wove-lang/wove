		(const _POSIX_FD_SETSIZE (:pragma (c_optional)) i32)
		(const _POSIX_HIWAT (:pragma (c_optional)) i32)
		(const _POSIX_HOST_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_LINK_MAX (:pragma (c_optional)) i32)
		(const _POSIX_LOGIN_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_MAX_CANON (:pragma (c_optional)) i32)
		(const _POSIX_MAX_INPUT (:pragma (c_optional)) i32)
		(const _POSIX_MQ_OPEN_MAX (:pragma (c_optional)) i32)
		(const _POSIX_MQ_PRIO_MAX (:pragma (c_optional)) i32)
		(const _POSIX_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_NGROUPS_MAX (:pragma (c_optional)) i32)
		(const _POSIX_OPEN_MAX (:pragma (c_optional)) i32)
		(const _POSIX_PATH_MAX (:pragma (c_optional)) i32)
		(const _POSIX_PIPE_BUF (:pragma (c_optional)) i32)
		(const _POSIX_QLIMIT (:pragma (c_optional)) i32)
		(const _POSIX_RE_DUP_MAX (:pragma (c_optional)) i32)
		(const _POSIX_RTSIG_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SEM_NSEMS_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SEM_VALUE_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SIGQUEUE_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SSIZE_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SS_REPL_MAX (:pragma (c_optional)) i32)
		(const _POSIX_STREAM_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SYMLINK_MAX (:pragma (c_optional)) i32)
		(const _POSIX_SYMLOOP_MAX (:pragma (c_optional)) i32)
		(const _POSIX_THREAD_DESTRUCTOR_ITERATIONS (:pragma (c_optional)) i32)
		(const _POSIX_THREAD_KEYS_MAX (:pragma (c_optional)) i32)
		(const _POSIX_THREAD_THREADS_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TIMER_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TRACE_EVENT_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TRACE_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TRACE_SYS_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TRACE_USER_EVENT_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TTY_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_TZNAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX_UIO_MAXIOV (:pragma (c_optional)) i32)
		(const _XOPEN_IOV_MAX (:pragma (c_optional)) i32)
		(const _XOPEN_NAME_MAX (:pragma (c_optional)) i32)
		(const _XOPEN_PATH_MAX (:pragma (c_optional)) i32)

		(disabled
			(:doc `The audited Darwin and glibc SDKs do not expose UCHAR_MIN, UINT_MIN,
	ULLONG_MIN, ULONG_MIN, USHRT_MIN, or __STDC_VERSION_LIMITS_H__.`))
		(disabled
			(:doc `The audited glibc <limits.h> can publish _XOPEN_IOV_MAX without
	defining the _POSIX_UIO_MAXIOV name it expands to. In that feature namespace,
	Clang reports the invalid expansion when a C or Wove caller uses it.`))))
