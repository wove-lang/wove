		(const UQUAD_MAX (:pragma (c_optional)) u64)
		(const USHRT_WIDTH (:pragma (c_optional)) i32)
		(const WORD_BIT (:pragma (c_optional)) i32)
		(const XATTR_LIST_MAX (:pragma (c_optional)) i32)
		(const XATTR_NAME_MAX (:pragma (c_optional)) i32)
		(const XATTR_SIZE_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_BC_BASE_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_BC_DIM_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_BC_SCALE_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_BC_STRING_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_CHARCLASS_NAME_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_COLL_WEIGHTS_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_EQUIV_CLASS_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_EXPR_NEST_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_LINE_MAX (:pragma (c_optional)) i32)
		(const _POSIX2_RE_DUP_MAX (:pragma (c_optional)) i32)
		(const _POSIX_AIO_LISTIO_MAX (:pragma (c_optional)) i32)
		(const _POSIX_AIO_MAX (:pragma (c_optional)) i32)
		(const _POSIX_ARG_MAX (:pragma (c_optional)) i32)
		(const _POSIX_CHILD_MAX (:pragma (c_optional)) i32)
		(const _POSIX_CLOCKRES_MIN (:pragma (c_optional)) i32)
