(module c_signal_set
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<signal.h>"
		(:doc "Share the native Linux signal-set type and its initializer with the poll bridge.")
		(:pragma (cfg (os "linux")))
		(struct SignalSet (c-type "sigset_t") (fields))
		(fn sigemptyset
			(:doc "Initialize the caller's native set without exposing its implementation fields.")
			(:pragma (c_optional))
			(params (set (mut-ref SignalSet)))
			(returns i32))))
