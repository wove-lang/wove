(module c_fcntl
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fcntl.h>"
		(:doc "POSIX flags, native lock records, and typed file-opening contracts.")
		(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only (type SignedSize)))
		(use (:pragma (cfg (os "macos"))) c-header "<unistd.h>" (only (type Uid) (type Gid) (type Size)))
		(use (:pragma (cfg (os "macos"))) c-header "<time.h>" (only (type Stamp)))
		(use (:pragma (cfg (os "macos"))) c-header "<sys/acl.h>" (only (type Acl)))
		(type Mode (c-type "mode_t"))
		(type Offset (c-type "off_t"))
		(type Pid (c-type "pid_t"))
		(type Short (c-type "short"))
		(struct
			Lock
			(c-type "struct flock")
			(fields (l_type Short) (l_whence Short) (l_start Offset) (l_len Offset) (l_pid Pid)))

		(const O_RDONLY i32)
		(const O_WRONLY i32)
		(const O_RDWR i32)
		(const O_ACCMODE i32)
		(const O_APPEND i32)
		(const O_CREAT i32)
		(const O_TRUNC i32)
		(const O_EXCL i32)
		(const O_NOCTTY i32)
		(const O_NONBLOCK i32)
		(const O_SYNC i32)
		(const O_DSYNC i32)
		(const O_CLOEXEC i32)
		(const O_DIRECTORY i32)
		(const O_NOFOLLOW i32)
		(const AT_FDCWD i32)
		(const AT_EACCESS i32)
		(const AT_SYMLINK_NOFOLLOW i32)
		(const AT_SYMLINK_FOLLOW i32)
		(const AT_REMOVEDIR i32)
		(const FD_CLOEXEC i32)
		(const F_DUPFD i32)
		(const F_DUPFD_CLOEXEC i32)
		(const F_GETFD i32)
		(const F_SETFD i32)
		(const F_GETFL i32)
		(const F_SETFL i32)
		(const F_GETOWN i32)
		(const F_SETOWN i32)
		(const F_GETLK i32)
		(const F_SETLK i32)
		(const F_SETLKW i32)
		(const F_RDLCK i32)
		(const F_WRLCK i32)
		(const F_UNLCK i32)

		(decls
			(:doc "Use the shared BSD advisory-lock, open-description, lease, and legacy open constants.")
			(:pragma (cfg (any (os "macos") (os "linux"))))
			(const F_GETLEASE i32)
			(const F_OFD_GETLK i32)
			(const F_OFD_SETLK i32)
			(const F_OFD_SETLKW i32)
			(const F_SETLEASE i32)
			(const LOCK_EX i32)
			(const LOCK_NB i32)
			(const LOCK_SH i32)
			(const LOCK_UN i32)
			(const O_ASYNC i32)
			(const O_FSYNC i32)
			(const O_NDELAY i32))

		(decls
			(:doc "Use the Darwin open, path resolution, allocation, and descriptor command constants.")
			(:pragma (cfg (os "macos")))
			(const AT_FDONLY i32)
			(const AT_REALDEV i32)
			(const AT_SYMLINK_NOFOLLOW_ANY i32)
			(const FD_CLOFORK i32)
			(const F_ADDFILESIGS i32)
			(const F_ADDFILESIGS_FOR_DYLD_SIM i32)
			(const F_ADDFILESIGS_INFO i32)
			(const F_ADDFILESIGS_RETURN i32)
			(const F_ADDFILESUPPL i32)
			(const F_ADDSIGS i32)
			(const F_ADDSIGS_MAIN_BINARY i32)
			(const F_ALLOCATEALL i32)
			(const F_ALLOCATECONTIG i32)
			(const F_ALLOCATEPERSIST i32)
			(const F_ATTRIBUTION_TAG i32)
			(const F_BARRIERFSYNC i32)
			(const F_CHECK_LV i32)
			(const F_CHKCLEAN i32)
			(const F_CREATE_TAG i32)
			(const F_DELETE_TAG i32)
			(const F_FINDSIGS i32)
			(const F_FLUSH_DATA i32)
			(const F_FREEZE_FS i32)
			(const F_FULLFSYNC i32)
			(const F_GETCODEDIR i32)
			(const F_GETLKPID i32)
			(const F_GETNOSIGPIPE i32)
			(const F_GETPATH i32)
			(const F_GETPATH_MTMINFO i32)
			(const F_GETPATH_NOFIRMLINK i32)
			(const F_GETPROTECTIONCLASS i32)
			(const F_GETPROTECTIONLEVEL i32)
			(const F_GETSIGSINFO i32)
			(const F_GLOBAL_NOCACHE i32)
			(const F_LOG2PHYS i32)
			(const F_LOG2PHYS_EXT i32)
			(const F_NOCACHE i32)
			(const F_NOCACHE_EXT i32)
			(const F_NODIRECT i32)
			(const F_OFD_SETLKWTIMEOUT i32)
			(const F_PATHPKG_CHECK i32)
			(const F_PEOFPOSMODE i32)
			(const F_PREALLOCATE i32)
			(const F_PUNCHHOLE i32)
			(const F_QUERY_TAG i32)
			(const F_RDADVISE i32)
			(const F_RDAHEAD i32)
			(const F_SETBACKINGSTORE i32)
			(const F_SETLKWTIMEOUT i32)
			(const F_SETNOSIGPIPE i32)
			(const F_SETPROTECTIONCLASS i32)
			(const F_SETSIZE i32)
			(const F_SINGLE_WRITER i32)
			(const F_SPECULATIVE_READ i32)
			(const F_THAW_FS i32)
			(const F_TRANSCODEKEY i32)
			(const F_TRANSFEREXTENTS i32)
			(const F_TRIM_ACTIVE_FILE i32)
			(const F_VOLPOSMODE i32)
			(const O_ALERT i32)
			(const O_CLOFORK i32)
			(const O_DP_AUTHENTICATE i32)
			(const O_DP_GETRAWENCRYPTED i32)
			(const O_DP_GETRAWUNENCRYPTED i32)
			(const O_EVTONLY i32)
			(const O_EXEC i32)
			(const O_EXLOCK i32)
			(const O_NOFOLLOW_ANY i32)
			(const O_POPUP u32)
			(const O_SEARCH i32)
			(const O_SHLOCK i32)
			(const O_SYMLINK i32)

			(fn F_SETLEASE_ARG
				(:doc "Pack a lease type and a nonnegative open count that fits the native command argument.")
				(:pragma (c_macro))
				(params (lease_type i32) (open_count i32))
				(returns i32)))

		(decls
			(:doc "Use the Darwin path, open, and descriptor constants when the selected SDK defines them.")
			(:expect (tests "stage-2/cli/native/fcntl/optional.tsv") (issues "gh:wove-lang/wove:539"))
			(:pragma (cfg (os "macos")))
			(const AT_NODELETEBUSY (:pragma (c_optional)) i32)
			(const AT_RESOLVE_BENEATH (:pragma (c_optional)) i32)
			(const AT_UNIQUE (:pragma (c_optional)) i32)
			(const F_DUPFD_CLOFORK (:pragma (c_optional)) i32)
			(const F_RDADVISEV (:pragma (c_optional)) i32)
			(const F_RDADVISEV_NOAGE (:pragma (c_optional)) i32)
			(const O_RESOLVE_BENEATH (:pragma (c_optional)) i32)
			(const O_UNIQUE (:pragma (c_optional)) i32))

		(decls
			(:doc "Use the glibc path, directory notification, allocation, seal, descriptor, and splice constants.")
			(:pragma (cfg (os "linux")))
			(const AT_EMPTY_PATH i32)
			(const AT_HANDLE_FID i32)
			(const AT_NO_AUTOMOUNT i32)
			(const AT_RECURSIVE i32)
			(const AT_STATX_DONT_SYNC i32)
			(const AT_STATX_FORCE_SYNC i32)
			(const AT_STATX_SYNC_AS_STAT i32)
			(const AT_STATX_SYNC_TYPE i32)
			(const DN_ACCESS i32)
			(const DN_ATTRIB i32)
			(const DN_CREATE i32)
			(const DN_DELETE i32)
			(const DN_MODIFY i32)
			(const DN_MULTISHOT u32)
			(const DN_RENAME i32)
			(const FALLOC_FL_COLLAPSE_RANGE i32)
			(const FALLOC_FL_INSERT_RANGE i32)
			(const FALLOC_FL_KEEP_SIZE i32)
			(const FALLOC_FL_PUNCH_HOLE i32)
			(const FALLOC_FL_UNSHARE_RANGE i32)
			(const FALLOC_FL_ZERO_RANGE i32)
			(const F_ADD_SEALS i32)
			(const F_EXLCK i32)
			(const F_GETLK64 i32)
			(const F_GETOWN_EX i32)
			(const F_GETPIPE_SZ i32)
			(const F_GETSIG i32)
			(const F_GET_FILE_RW_HINT i32)
			(const F_GET_RW_HINT i32)
			(const F_GET_SEALS i32)
			(const F_LOCK i32)
			(const F_NOTIFY i32)
			(const F_SEAL_EXEC i32)
			(const F_SEAL_FUTURE_WRITE i32)
			(const F_SEAL_GROW i32)
			(const F_SEAL_SEAL i32)
			(const F_SEAL_SHRINK i32)
			(const F_SEAL_WRITE i32)
			(const F_SETLK64 i32)
			(const F_SETLKW64 i32)
			(const F_SETOWN_EX i32)
			(const F_SETPIPE_SZ i32)
			(const F_SETSIG i32)
			(const F_SET_FILE_RW_HINT i32)
			(const F_SET_RW_HINT i32)
			(const F_SHLCK i32)
			(const F_TEST i32)
			(const F_TLOCK i32)
			(const F_ULOCK i32)
			(const LOCK_MAND i32)
			(const LOCK_READ i32)
			(const LOCK_RW i32)
			(const LOCK_WRITE i32)
			(const O_DIRECT i32)
			(const O_LARGEFILE i32)
			(const O_NOATIME i32)
			(const O_PATH i32)
			(const O_RSYNC i32)
			(const O_TMPFILE i32)
			(const POSIX_FADV_DONTNEED i32)
			(const POSIX_FADV_NOREUSE i32)
			(const POSIX_FADV_NORMAL i32)
			(const POSIX_FADV_RANDOM i32)
			(const POSIX_FADV_SEQUENTIAL i32)
			(const POSIX_FADV_WILLNEED i32)
			(const SPLICE_F_GIFT i32)
			(const SPLICE_F_MORE i32)
			(const SPLICE_F_MOVE i32)
			(const SPLICE_F_NONBLOCK i32)
			(const SYNC_FILE_RANGE_WAIT_AFTER i32)
			(const SYNC_FILE_RANGE_WAIT_BEFORE i32)
			(const SYNC_FILE_RANGE_WRITE i32)
			(const SYNC_FILE_RANGE_WRITE_AND_WAIT i32))

		(decls
			(:doc "Darwin preallocation and physical mapping use the complete SDK records.")
			(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
			(:pragma (cfg (os "macos")))
			(struct FileStore (c-type "fstore_t")
				(fields (fst_flags u32) (fst_posmode i32) (fst_offset Offset)
					(fst_length Offset) (fst_bytesalloc Offset)))
			(struct Log2Phys (c-type "struct log2phys")
				(fields (l2p_flags u32) (l2p_contigbytes Offset) (l2p_devoffset Offset)))

			(fn fcntl_preallocate
				(:doc "Read the allocation flags, position mode, offset and length, then report bytes allocated in fst_bytesalloc.")
				(:pragma (c_variadic request))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_PREALLOCATE) (request (mut-ref FileStore)))
				(returns i32))

			(fn fcntl_log2phys
				(:doc "Write the device offset for the descriptor's current file position. The legacy command leaves the other fields unspecified.")
				(:pragma (c_variadic output))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_LOG2PHYS) (output (mut-ref Log2Phys)))
				(returns i32))

			(fn fcntl_log2phys_ext
				(:doc "Read the requested byte count and file offset from the packed mapping. Replace them with the contiguous length and device offset.")
				(:pragma (c_variadic mapping))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_LOG2PHYS_EXT) (mapping (mut-ref Log2Phys)))
				(returns i32)))

		(decls
			(:doc "Darwin range commands copy the complete native requests into the kernel.")
			(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
			(:pragma (cfg (os "macos")))
			(struct ReadAdvice (c-type "struct radvisory") (fields (ra_offset Offset) (ra_count i32)))
			(struct FileHole (c-type "fpunchhole_t")
				(fields (fp_flags u32) (reserved u32) (fp_offset Offset) (fp_length Offset)))
			(struct ActiveFileTrim (c-type "ftrimactivefile_t") (fields (fta_offset Offset) (fta_length Offset)))
			(struct SpeculativeRead (c-type "fspecread_t")
				(fields (fsr_flags u32) (reserved u32) (fsr_offset Offset) (fsr_length Offset)))

			(fn fcntl_rdadvise
				(:doc "Advise a read from the file offset and byte count without returning file data.")
				(:pragma (c_variadic range))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_RDADVISE) (range (shared-ref ReadAdvice)))
				(returns i32))

			(fn fcntl_punchhole
				(:doc "Deallocate the specified file range. Set the unused flags and alignment field to zero.")
				(:pragma (c_variadic range))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_PUNCHHOLE) (range (shared-ref FileHole)))
				(returns i32))

			(fn fcntl_trim_active_file
				(:doc "Request that the filesystem trim a range on a writable file. XNU checks trim privilege before using the range.")
				(:pragma (c_variadic range))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_TRIM_ACTIVE_FILE) (range (shared-ref ActiveFileTrim)))
				(returns i32))

			(fn fcntl_speculative_read
				(:doc "Advise a speculative read for a file range. Set the reserved alignment field to zero.")
				(:pragma (c_variadic range))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_SPECULATIVE_READ) (range (shared-ref SpeculativeRead)))
				(returns i32)))

		(decls
			(:doc "Darwin supports a process-filtered lock query and two scalar-field signature records.")
			(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
			(:pragma (cfg (os "macos")))
			(const GETSIGSINFO_PLATFORM_BINARY i32)
			(struct FileSignatureInfo (c-type "fgetsigsinfo_t")
				(fields (fg_file_start Offset) (fg_info_request i32) (fg_sig_is_platform i32)))
			(struct FileSignatureSupplement (c-type "fsupplement_t")
				(fields (fs_file_start Offset) (fs_blob_start Offset) (fs_blob_size Size) (fs_orig_fd i32)))

			(fn fcntl_getlkpid
				(:doc "Find a conflicting lock filtered by l_pid and report the result in the supplied native lock.")
				(:pragma (c_variadic lock))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_GETLKPID) (lock (mut-ref Lock)))
				(returns i32))

			(fn fcntl_getsigsinfo
				(:doc "Read the image offset and information selector. Write the platform-signature flag on a successful platform query.")
				(:pragma (c_variadic query))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_GETSIGSINFO) (query (mut-ref FileSignatureInfo)))
				(returns i32))

			(fn fcntl_addfilesuppl
				(:doc "Read the supplemental signature location and original descriptor from the caller's record.")
				(:pragma (c_variadic supplement))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_ADDFILESUPPL) (supplement (shared-ref FileSignatureSupplement)))
				(returns i32)))

		(decls
			(:doc "Darwin attribution tags contain an exact inline name and an unsigned native hash.")
			(:expect (tests "stage-2/cli/native/cases.tsv")
				(issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:564"))
			(:pragma (cfg (os "macos")))
			(const ATTRIBUTION_NAME_MAX i32)
			(type AttributionHash (c-type "unsigned long long"))
			(struct FileAttributionTag (c-type "fattributiontag_t")
				(fields (ft_flags u32) (ft_hash AttributionHash) (ft_attribution_name (array char 255))))
			(fn fcntl_attribution_tag
				(:doc "Apply the query, create, or delete flags from the native record and preserve the kernel's updated hash and inline name.")
				(:pragma (c_variadic tag))
				(c-name "fcntl")
				(params (fd i32) (const command i32 F_ATTRIBUTION_TAG) (tag (mut-ref FileAttributionTag)))
				(returns i32)))

		(decls
			(:doc "Darwin file-security owners, extended opens, and BSD descriptor locks.")
			(:pragma (cfg (os "macos")))
			(type FileSecurity (:pragma (c_owned (drop filesec_free))) (c-type "filesec_t"))
			(type FileProperty (c-type "filesec_property_t"))
			(const FILESEC_OWNER FileProperty)
			(const FILESEC_GROUP FileProperty)
			(const FILESEC_UUID FileProperty)
			(const FILESEC_GUID FileProperty)
			(const FILESEC_MODE FileProperty)
			(const FILESEC_ACL FileProperty)
			(const FILESEC_GRPUUID FileProperty)

			(fn filesec_init
				(:doc "Create an empty owned file-security descriptor.")
				(params)
				(returns FileSecurity))

			(fn filesec_dup
				(:doc "Copy the properties into a separate native file-security owner.")
				(params (security (shared-ref FileSecurity)))
				(returns FileSecurity))

			(fn filesec_free
				(:doc "Consume the file-security owner and free its native properties.")
				(params (security FileSecurity))
				(returns void))

			(fn filesec_query_property
				(:doc "Write the native presence mask to the caller's slot. Zero means absent and a nonzero mask means present.")
				(params (security (shared-ref FileSecurity)) (property FileProperty) (present (mut-ref i32)))
				(returns i32))

			(fn filesec_unset_property
				(:doc "Clear the selected property through a mutable borrow of the security descriptor.")
				(params (security (mut-ref FileSecurity)) (property FileProperty))
				(returns i32))

			(fn filesec_get_owner
				(:doc "Read the selected owner into the caller's borrowed uid_t slot. Preserve the native status.")
				(:pragma (c_void_ptr output))
				(c-name "filesec_get_property")
				(params (security (shared-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_OWNER) (output (mut-ref Uid)))
				(returns i32))

			(fn filesec_set_owner
				(:doc "Copy the selected owner from the caller's borrowed uid_t slot into the security descriptor.")
				(:pragma (c_void_ptr input))
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_OWNER) (input (shared-ref Uid)))
				(returns i32))

			(fn filesec_get_group
				(:doc "Read the selected group into the caller's borrowed gid_t slot. Preserve the native status.")
				(:pragma (c_void_ptr output))
				(c-name "filesec_get_property")
				(params (security (shared-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_GROUP) (output (mut-ref Gid)))
				(returns i32))

			(fn filesec_set_group
				(:doc "Copy the selected group from the caller's borrowed gid_t slot into the security descriptor.")
				(:pragma (c_void_ptr input))
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_GROUP) (input (shared-ref Gid)))
				(returns i32))

			(fn filesec_get_mode
				(:doc "Read the selected mode into the caller's borrowed mode_t slot. Preserve the native status.")
				(:pragma (c_void_ptr output))
				(c-name "filesec_get_property")
				(params (security (shared-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_MODE) (output (mut-ref Mode)))
				(returns i32))

			(fn filesec_set_mode
				(:doc "Copy the selected mode from the caller's borrowed mode_t slot into the security descriptor.")
				(:pragma (c_void_ptr input))
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_MODE) (input (shared-ref Mode)))
				(returns i32))

			(fn filesec_get_uuid
				(:doc "Read the owner UUID into an exclusive 16-byte view. Preserve the native status.")
				(:pragma (c_void_ptr output))
				(c-name "filesec_get_property")
				(params (security (shared-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_UUID) (output (mut-array u8 16)))
				(returns i32))

			(fn filesec_set_uuid
				(:doc "Copy the owner UUID from a shared 16-byte view into the file-security descriptor.")
				(:pragma (c_void_ptr input))
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_UUID) (input (shared-array u8 16)))
				(returns i32))

			(fn filesec_get_grpuuid
				(:doc "Read the group UUID into an exclusive 16-byte view. Preserve the native status.")
				(:pragma (c_void_ptr output))
				(c-name "filesec_get_property")
				(params (security (shared-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_GRPUUID) (output (mut-array u8 16)))
				(returns i32))

			(fn filesec_set_grpuuid
				(:doc "Copy the group UUID from a shared 16-byte view into the file-security descriptor.")
				(:pragma (c_void_ptr input))
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity))
					(const property (c-type "filesec_property_t") FILESEC_GRPUUID) (input (shared-array u8 16)))
				(returns i32))

			(fn filesec_get_acl
				(:doc "Read an owned ACL copy or report the remove marker. Preserve the native status.")
				(:pragma (c_owner_out output removed _FILESEC_REMOVE_ACL))
				(c-name "filesec_get_property")
				(params (security (shared-ref FileSecurity)) (const property (c-type "filesec_property_t") FILESEC_ACL)
					(output (mut-ref Acl)) (removed (mut-ref bool)))
				(returns i32))

			(fn filesec_set_acl
				(:doc "Copy the selected ACL while the caller retains its original handle.")
				(:pragma (c_void_ptr input))
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity)) (const property (c-type "filesec_property_t") FILESEC_ACL)
					(input (shared-ref Acl)))
				(returns i32))

			(fn filesec_mark_remove_acl
				(:doc "Set the native remove marker on the file-security descriptor.")
				(c-name "filesec_set_property")
				(params (security (mut-ref FileSecurity)) (const property (c-type "filesec_property_t") FILESEC_ACL)
					(const marker (c-type "const void *") _FILESEC_REMOVE_ACL))
				(returns i32))

			(fn openx_np
				(:doc "Open a path with the selected borrowed file-security properties.")
				(:pragma (c_cstr path))
				(params (path (shared-array u8)) (flags i32) (security (shared-ref FileSecurity)))
				(returns i32))

			(fn openx_plain
				(:doc "Use the native null file-security argument when no properties are needed.")
				(:pragma (c_cstr path))
				(c-name "openx_np")
				(params (path (shared-array u8)) (flags i32) (const security (c-type "filesec_t") null))
