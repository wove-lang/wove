(module c_fcntl
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fcntl.h>"
		(:doc "POSIX flags, native lock records, and typed file-opening contracts.")
		(use (:pragma (cfg (os "linux"))) c-header "<unistd.h>" (only (type SignedSize)))
		(type Mode (c-type "mode_t"))
		(type Offset (c-type "off_t"))
		(type Pid (c-type "pid_t"))
		(type Short (c-type "short"))
		(struct
			Lock
			(c-type "struct flock")
			(fields (l_type Short) (l_whence Short) (l_start Offset) (l_len Offset) (l_pid Pid)))

		(const O_RDONLY i32)
		(const O_WRONLY i32)
		(const O_RDWR i32)
		(const O_ACCMODE i32)
		(const O_APPEND i32)
		(const O_CREAT i32)
		(const O_TRUNC i32)
		(const O_EXCL i32)
		(const O_NOCTTY i32)
		(const O_NONBLOCK i32)
		(const O_SYNC i32)
		(const O_DSYNC i32)
		(const O_CLOEXEC i32)
		(const O_DIRECTORY i32)
		(const O_NOFOLLOW i32)
		(const AT_FDCWD i32)
		(const AT_EACCESS i32)
		(const AT_SYMLINK_NOFOLLOW i32)
		(const AT_SYMLINK_FOLLOW i32)
		(const AT_REMOVEDIR i32)
		(const FD_CLOEXEC i32)
		(const F_DUPFD i32)
		(const F_DUPFD_CLOEXEC i32)
		(const F_GETFD i32)
		(const F_SETFD i32)
		(const F_GETFL i32)
		(const F_SETFL i32)
		(const F_GETOWN i32)
		(const F_SETOWN i32)
		(const F_GETLK i32)
		(const F_SETLK i32)
		(const F_SETLKW i32)
		(const F_RDLCK i32)
		(const F_WRLCK i32)
		(const F_UNLCK i32)

		(decls
			(:doc "Use the shared BSD advisory-lock, open-description, lease, and legacy open constants.")
			(:pragma (cfg (any (os "macos") (os "linux"))))
			(const F_GETLEASE i32)
			(const F_OFD_GETLK i32)
			(const F_OFD_SETLK i32)
			(const F_OFD_SETLKW i32)
			(const F_SETLEASE i32)
			(const LOCK_EX i32)
			(const LOCK_NB i32)
			(const LOCK_SH i32)
			(const LOCK_UN i32)
			(const O_ASYNC i32)
			(const O_FSYNC i32)
			(const O_NDELAY i32))

		(decls
			(:doc "Use the Darwin open, path resolution, allocation, and descriptor command constants.")
			(:pragma (cfg (os "macos")))
			(const AT_FDONLY i32)
			(const AT_REALDEV i32)
			(const AT_SYMLINK_NOFOLLOW_ANY i32)
			(const FD_CLOFORK i32)
			(const F_ADDFILESIGS i32)
			(const F_ADDFILESIGS_FOR_DYLD_SIM i32)
			(const F_ADDFILESIGS_INFO i32)
			(const F_ADDFILESIGS_RETURN i32)
			(const F_ADDFILESUPPL i32)
			(const F_ADDSIGS i32)
			(const F_ADDSIGS_MAIN_BINARY i32)
			(const F_ALLOCATEALL i32)
			(const F_ALLOCATECONTIG i32)
			(const F_ALLOCATEPERSIST i32)
			(const F_ATTRIBUTION_TAG i32)
			(const F_BARRIERFSYNC i32)
			(const F_CHECK_LV i32)
			(const F_CHKCLEAN i32)
			(const F_CREATE_TAG i32)
			(const F_DELETE_TAG i32)
			(const F_FINDSIGS i32)
			(const F_FLUSH_DATA i32)
			(const F_FREEZE_FS i32)
			(const F_FULLFSYNC i32)
			(const F_GETCODEDIR i32)
			(const F_GETLKPID i32)
			(const F_GETNOSIGPIPE i32)
			(const F_GETPATH i32)
			(const F_GETPATH_MTMINFO i32)
			(const F_GETPATH_NOFIRMLINK i32)
			(const F_GETPROTECTIONCLASS i32)
			(const F_GETPROTECTIONLEVEL i32)
			(const F_GETSIGSINFO i32)
			(const F_GLOBAL_NOCACHE i32)
			(const F_LOG2PHYS i32)
			(const F_LOG2PHYS_EXT i32)
			(const F_NOCACHE i32)
			(const F_NOCACHE_EXT i32)
			(const F_NODIRECT i32)
			(const F_OFD_SETLKWTIMEOUT i32)
			(const F_PATHPKG_CHECK i32)
			(const F_PEOFPOSMODE i32)
			(const F_PREALLOCATE i32)
			(const F_PUNCHHOLE i32)
			(const F_QUERY_TAG i32)
			(const F_RDADVISE i32)
			(const F_RDAHEAD i32)
			(const F_SETBACKINGSTORE i32)
			(const F_SETLKWTIMEOUT i32)
			(const F_SETNOSIGPIPE i32)
			(const F_SETPROTECTIONCLASS i32)
			(const F_SETSIZE i32)
			(const F_SINGLE_WRITER i32)
			(const F_SPECULATIVE_READ i32)
			(const F_THAW_FS i32)
			(const F_TRANSCODEKEY i32)
			(const F_TRANSFEREXTENTS i32)
			(const F_TRIM_ACTIVE_FILE i32)
			(const F_VOLPOSMODE i32)
			(const O_ALERT i32)
			(const O_CLOFORK i32)
			(const O_DP_AUTHENTICATE i32)
			(const O_DP_GETRAWENCRYPTED i32)
			(const O_DP_GETRAWUNENCRYPTED i32)
			(const O_EVTONLY i32)
			(const O_EXEC i32)
			(const O_EXLOCK i32)
			(const O_NOFOLLOW_ANY i32)
			(const O_POPUP u32)
			(const O_SEARCH i32)
			(const O_SHLOCK i32)
			(const O_SYMLINK i32)

			(fn F_SETLEASE_ARG
				(:doc "Pack a lease type and a nonnegative open count that fits the native command argument.")
				(:pragma (c_macro))
				(params (lease_type i32) (open_count i32))
				(returns i32)))

		(decls
			(:doc "Use the glibc path, directory notification, allocation, seal, descriptor, and splice constants.")
			(:pragma (cfg (os "linux")))
			(const AT_EMPTY_PATH i32)
			(const AT_HANDLE_FID i32)
			(const AT_NO_AUTOMOUNT i32)
			(const AT_RECURSIVE i32)
			(const AT_STATX_DONT_SYNC i32)
			(const AT_STATX_FORCE_SYNC i32)
			(const AT_STATX_SYNC_AS_STAT i32)
			(const AT_STATX_SYNC_TYPE i32)
			(const DN_ACCESS i32)
			(const DN_ATTRIB i32)
			(const DN_CREATE i32)
			(const DN_DELETE i32)
			(const DN_MODIFY i32)
			(const DN_MULTISHOT u32)
			(const DN_RENAME i32)
			(const FALLOC_FL_COLLAPSE_RANGE i32)
			(const FALLOC_FL_INSERT_RANGE i32)
			(const FALLOC_FL_KEEP_SIZE i32)
			(const FALLOC_FL_PUNCH_HOLE i32)
			(const FALLOC_FL_UNSHARE_RANGE i32)
			(const FALLOC_FL_ZERO_RANGE i32)
			(const F_ADD_SEALS i32)
			(const F_EXLCK i32)
			(const F_GETLK64 i32)
			(const F_GETOWN_EX i32)
			(const F_GETPIPE_SZ i32)
			(const F_GETSIG i32)
			(const F_GET_FILE_RW_HINT i32)
			(const F_GET_RW_HINT i32)
			(const F_GET_SEALS i32)
			(const F_LOCK i32)
			(const F_NOTIFY i32)
			(const F_SEAL_EXEC i32)
			(const F_SEAL_FUTURE_WRITE i32)
			(const F_SEAL_GROW i32)
			(const F_SEAL_SEAL i32)
			(const F_SEAL_SHRINK i32)
			(const F_SEAL_WRITE i32)
			(const F_SETLK64 i32)
			(const F_SETLKW64 i32)
			(const F_SETOWN_EX i32)
			(const F_SETPIPE_SZ i32)
			(const F_SETSIG i32)
			(const F_SET_FILE_RW_HINT i32)
			(const F_SET_RW_HINT i32)
			(const F_SHLCK i32)
			(const F_TEST i32)
			(const F_TLOCK i32)
			(const F_ULOCK i32)
			(const LOCK_MAND i32)
			(const LOCK_READ i32)
			(const LOCK_RW i32)
			(const LOCK_WRITE i32)
			(const O_DIRECT i32)
			(const O_LARGEFILE i32)
			(const O_NOATIME i32)
			(const O_PATH i32)
			(const O_RSYNC i32)
			(const O_TMPFILE i32)
			(const POSIX_FADV_DONTNEED i32)
			(const POSIX_FADV_NOREUSE i32)
			(const POSIX_FADV_NORMAL i32)
			(const POSIX_FADV_RANDOM i32)
			(const POSIX_FADV_SEQUENTIAL i32)
			(const POSIX_FADV_WILLNEED i32)
			(const SPLICE_F_GIFT i32)
			(const SPLICE_F_MORE i32)
			(const SPLICE_F_MOVE i32)
			(const SPLICE_F_NONBLOCK i32)
			(const SYNC_FILE_RANGE_WAIT_AFTER i32)
			(const SYNC_FILE_RANGE_WAIT_BEFORE i32)
			(const SYNC_FILE_RANGE_WRITE i32)
			(const SYNC_FILE_RANGE_WRITE_AND_WAIT i32))

		(decls
			(:doc "Darwin file-security owners, extended opens, and BSD descriptor locks.")
			(:pragma (cfg (os "macos")))
			(type (:pragma (c_owned (drop filesec_free))) FileSecurity (c-type "filesec_t"))

			(fn filesec_init
				(:doc "Create an empty owned file-security descriptor.")
				(params)
				(returns FileSecurity))

			(fn filesec_dup
				(:doc "Copy the properties into a separate native file-security owner.")
				(params (security (shared-ref FileSecurity)))
				(returns FileSecurity))

			(fn filesec_free
				(:doc "Consume the file-security owner and free its native properties.")
				(params (security FileSecurity))
				(returns void))

			(fn openx_np
				(:doc "Open a path with the selected borrowed file-security properties.")
				(:pragma (c_cstr path))
				(params (path (shared-array u8)) (flags i32) (security (shared-ref FileSecurity)))
				(returns i32))

			(fn openx_plain
				(:doc "Use the native null file-security argument when no properties are needed.")
				(:pragma (c_cstr path))
				(c-name "openx_np")
				(params (path (shared-array u8)) (flags i32) (const security (c-type "filesec_t") null))
				(returns i32))

			(fn flock
				(:doc "Acquire, change, or release the advisory lock on an open file description.")
				(params (descriptor i32) (operation i32))
				(returns i32)))

		(fn creat
			(:doc "Create or truncate a file and return its descriptor.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (mode Mode))
			(returns i32))
		(fn open
			(:doc "Keep a typed mode argument even when the selected flags do not create a file.")
			(:pragma (c_cstr path) (c_variadic mode))
			(params (path (shared-array u8)) (flags i32) (mode Mode))
			(returns i32))
		(fn openat
			(:doc "The directory descriptor adds one fixed C argument before the same mode tail.")
			(:pragma (c_cstr path) (c_variadic mode))
			(params (fd i32) (path (shared-array u8)) (flags i32) (mode Mode))
			(returns i32))

		(decls
			(:doc "Darwin does not provide the POSIX advisory/allocation interfaces below.")
			(:pragma (cfg (os "linux")))
			(fn posix_fadvise
				(:doc "Supply file-access advice without changing the descriptor offset.")
				(params (fd i32) (offset Offset) (length Offset) (advice i32))
				(returns i32))
			(fn posix_fallocate
				(:doc "Allocate file space through the POSIX interface.")
				(params (fd i32) (offset Offset) (length Offset))
				(returns i32)))

		(decls
			(:doc "glibc large-file opens, descriptor operations, allocation, and byte transfers.")
			(:pragma (cfg (os "linux")))
			(type Offset64 (c-type "off64_t"))
			(type Size (c-type "size_t"))

			(fn creat64
				(:doc "Create or truncate a file through the large-file entry point.")
				(:pragma (c_optional) (c_cstr path))
				(params (path (shared-array u8)) (mode Mode))
				(returns i32))

			(fn open64
				(:doc "Open a file through the glibc large-file interface and keep the typed mode tail.")
				(:pragma (c_optional) (c_cstr path) (c_variadic mode))
				(params (path (shared-array u8)) (flags i32) (mode Mode))
				(returns i32))

			(fn openat64
				(:doc "Open a large file relative to a directory descriptor or AT_FDCWD.")
				(:pragma (c_optional) (c_cstr path) (c_variadic mode))
				(params (fd i32) (path (shared-array u8)) (flags i32) (mode Mode))
				(returns i32))

			(fn fcntl64_getfd
				(:doc "Read descriptor flags using the glibc large-file command entry point.")
				(:pragma (c_optional) (c_variadic))
				(c-name "fcntl64")
				(params (fd i32) (const command i32 F_GETFD))
				(returns i32))

			(fn lockf64
				(:doc "Apply or query the record lock across a large-file length. Either glibc header can supply the declaration.")
				(params (fd i32) (command i32) (length Offset64))
				(returns i32))

			(fn posix_fadvise64
				(:doc "Supply access advice for a range with explicit large-file offsets.")
				(:pragma (c_optional))
				(params (fd i32) (offset Offset64) (length Offset64) (advice i32))
				(returns i32))

			(fn posix_fallocate64
				(:doc "Allocate file storage through the POSIX large-file interface.")
				(:pragma (c_optional))
				(params (fd i32) (offset Offset64) (length Offset64))
				(returns i32))

			(fn fallocate
				(:doc "Allocate or deallocate a file range using the requested Linux mode bits.")
				(:pragma (c_optional))
				(params (fd i32) (mode i32) (offset Offset) (length Offset))
				(returns i32))

			(fn fallocate64
				(:doc "Apply the Linux allocation mode with large-file offsets and lengths.")
				(:pragma (c_optional))
				(params (fd i32) (mode i32) (offset Offset64) (length Offset64))
				(returns i32))

			(fn readahead
				(:doc "Request read-ahead for a byte window at a large-file offset.")
				(:pragma (c_optional))
				(params (fd i32) (offset Offset64) (count Size))
				(returns SignedSize))

			(fn sync_file_range
				(:doc "Schedule or wait for synchronization of the selected large-file byte range.")
				(:pragma (c_optional))
				(params (fd i32) (offset Offset64) (count Offset64) (flags u32))
				(returns i32))

			(fn tee
				(:doc "Copy bytes between pipe buffers while retaining the source bytes.")
				(:pragma (c_optional))
				(params (input i32) (output i32) (count Size) (flags u32))
				(returns SignedSize))

			(fn splice
				(:doc "Transfer bytes using either explicit mutable offsets or the descriptor positions.")
				(:pragma (c_optional) (c_nullable input_offset output_offset))
				(params (input i32) (input_offset (mut-ref Offset64)) (output i32) (output_offset (mut-ref Offset64))
					(count Size) (flags u32))
				(returns SignedSize)))

		(fn fcntl_getfd
			(:doc "Queries fix their native command and supply no variadic tail value.")
			(:pragma (c_variadic))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_GETFD))
			(returns i32))
		(fn fcntl_getfl
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_GETFL))
			(returns i32))
		(fn fcntl_getown
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_GETOWN))
			(returns i32))
		(fn fcntl_setfd
			(:doc "Scalar updates and duplication keep their integer tails behind the matching fixed command.")
			(:pragma (c_variadic flags))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_SETFD) (flags i32))
			(returns i32))
		(fn fcntl_setfl
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic flags))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_SETFL) (flags i32))
			(returns i32))
		(fn fcntl_setown
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic owner))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_SETOWN) (owner i32))
			(returns i32))
		(fn fcntl_dupfd
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic minimum))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_DUPFD) (minimum i32))
			(returns i32))
		(fn fcntl_dupfd_cloexec
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic minimum))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_DUPFD_CLOEXEC) (minimum i32))
			(returns i32))
		(fn fcntl_getlk
			(:doc "Lock pointers can reach only the commands whose contract consumes this complete native layout.")
			(:pragma (c_variadic lock))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_GETLK) (lock (mut-ref Lock)))
			(returns i32))
		(fn fcntl_setlk
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic lock))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_SETLK) (lock (mut-ref Lock)))
			(returns i32))
		(fn fcntl_setlkw
			(:doc "Use the fixed native command and its declared variadic argument contract.")
			(:pragma (c_variadic lock))
			(c-name "fcntl")
			(params (fd i32) (const command i32 F_SETLKW) (lock (mut-ref Lock)))
			(returns i32))

		(disabled
			(:doc `The Darwin constants AT_NODELETEBUSY, AT_RESOLVE_BENEATH, AT_UNIQUE,
			F_DUPFD_CLOFORK, F_RDADVISEV, F_RDADVISEV_NOAGE, O_RESOLVE_BENEATH, and
			O_UNIQUE vary by SDK. F_CREATED_QUERY and F_DUPFD_QUERY vary by glibc
			version, and FALLOC_FL_ALLOCATE_RANGE varies by Linux UAPI headers.
			Select each through live availability of its original macro spelling.`)
			(:expect (issues "gh:wove-lang/wove:539")))

		(disabled
			(:doc `
	// FALLOC_FL_NO_HIDE_STALE is a reserved Linux flag. Access mode constants stay in unistd.
	// O_TTY_INIT is absent from the audited SDKs.
	// Darwin filesec property access needs typed storage for its property selector.
	// glibc vmsplice, name_to_handle_at, and open_by_handle_at need native record buffers.
	// Darwin fstore_t/fbootstraptransfer_t/log2phys and Linux open-description locks,
	// leases, seals, and ownership records need explicit platform contracts.`))))
