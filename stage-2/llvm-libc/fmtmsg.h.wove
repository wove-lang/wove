(module c_fmtmsg
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fmtmsg.h>"
		(:doc "Expose the native message classification, severities, and returned status codes.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
		(type Long (c-type "long"))

		(const MM_HARD i32)
		(const MM_SOFT i32)
		(const MM_FIRM i32)
		(const MM_APPL i32)
		(const MM_UTIL i32)
		(const MM_OPSYS i32)
		(const MM_RECOVER i32)
		(const MM_NRECOV i32)
		(const MM_PRINT i32)
		(const MM_CONSOLE i32)

		(const MM_NOSEV i32)
		(const MM_HALT i32)
		(const MM_ERROR i32)
		(const MM_WARNING i32)
		(const MM_INFO i32)

		(const MM_NULLSEV i32)
		(const MM_NULLMC Long)

		(const MM_OK i32)
		(const MM_NOMSG i32)
		(const MM_NOCON i32)
		(const MM_NOTOK i32)

		(fn fmtmsg
			(:doc "Display the labeled message using the destinations in the native classification.")
			(:pragma (c_cstr label text action tag))
			(params (classification Long) (label (shared-array u8)) (severity i32)
				(text (shared-array u8)) (action (shared-array u8)) (tag (shared-array u8)))
			(returns i32))
		(fn fmtmsg_text
			(:doc "Display text using the native omissions for the label, severity, action, and tag.")
			(:pragma (c_cstr text))
			(params (classification Long) (const label (c-type "const char *") MM_NULLLBL)
				(const severity i32 MM_NULLSEV) (text (shared-array u8))
				(const action (c-type "const char *") MM_NULLACT) (const tag (c-type "const char *") MM_NULLTAG))
			(returns i32) (c-name "fmtmsg"))

		(fn addseverity_remove
			(:doc "Remove a custom GNU severity with the native null string operand.")
			(:pragma (cfg (os "linux")) (c_optional))
			(params (severity i32) (const text (c-type "const char *") null))
			(returns i32) (c-name "addseverity"))

		(disabled
			(:doc `MM_NULLLBL, MM_NULLTXT, MM_NULLACT, and MM_NULLTAG are native null char pointers.
	Fixed operands cover a text-only call. Selecting individual omissions at each
	fmtmsg call requires a nullable shared C-string parameter contract. See gh:wove-lang/wove:584.`))
		(disabled
			(:doc `glibc retains the addseverity string on registration and replacement.
	A call-scoped C-string copy would expire before later fmtmsg calls. See gh:wove-lang/wove:585.`))))
