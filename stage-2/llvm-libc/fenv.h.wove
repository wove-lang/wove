(module c_fenv
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fenv.h>"
		(:doc `Use native floating-point environment and exception snapshots with their original storage.
	Build with Wove's --cflag=-frounding-math so Clang honors the runtime rounding mode.
	Use --cflag=-ffp-model=strict for full floating-point environment access.`)
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
		(struct Environment (c-type "fenv_t") (fields))
		(struct ExceptionFlags (c-type "fexcept_t") (fields))

		(const FE_ALL_EXCEPT i32)
		(const FE_DIVBYZERO i32)
		(const FE_DOWNWARD i32)
		(const FE_INEXACT i32)
		(const FE_INVALID i32)
		(const FE_OVERFLOW i32)
		(const FE_TONEAREST i32)
		(const FE_TOWARDZERO i32)
		(const FE_UNDERFLOW i32)
		(const FE_UPWARD i32)

		(fn feclearexcept
			(:doc "Clear the floating-point exception flags selected by the mask.")
			(params (mask i32)) (returns i32))

		(fn fegetexceptflag
			(:doc "Save the selected exception flags in caller-owned native storage.")
			(params (flags (mut-ref ExceptionFlags)) (mask i32)) (returns i32))

		(fn feraiseexcept
			(:doc "Raise the floating-point exceptions selected by the mask.")
			(params (mask i32)) (returns i32))

		(fn fesetexceptflag
			(:doc "Restore the selected flags from a native snapshot without raising the exceptions.")
			(params (flags (shared-ref ExceptionFlags)) (mask i32)) (returns i32))

		(fn fetestexcept
			(:doc "Return the subset of the selected flags that are currently raised.")
			(params (mask i32)) (returns i32))

		(fn fegetround
			(:doc "Return the current native rounding mode.")
			(params) (returns i32))

		(fn fesetround
			(:doc "Set the rounding mode from a native FE rounding constant.")
			(params (mode i32)) (returns i32))

		(fn fegetenv
			(:doc "Save the current floating-point environment in caller-owned storage.")
			(params (environment (mut-ref Environment))) (returns i32))

		(fn feholdexcept
			(:doc "Save the environment and clear the flags, installing nonstop behavior where available.")
			(params (environment (mut-ref Environment))) (returns i32))

		(fn fesetenv
			(:doc "Install a saved environment without raising its exceptions.")
			(params (environment (shared-ref Environment))) (returns i32))

		(fn feupdateenv
			(:doc "Install a saved environment and raise the exceptions that were active before the call.")
			(params (environment (shared-ref Environment))) (returns i32))

		(fn fesetenv_default
			(:doc "Install the system default environment through the header's exact FE_DFL_ENV operand.")
			(c-name "fesetenv")
			(params (const environment (c-type "const fenv_t *") FE_DFL_ENV)) (returns i32))

		(fn feupdateenv_default
			(:doc "Install the system default environment and raise the previously active exceptions.")
			(c-name "feupdateenv")
			(params (const environment (c-type "const fenv_t *") FE_DFL_ENV)) (returns i32))

		(decls
			(:doc "Expose the Darwin arm64 flush-to-zero mask and alternate environment.")
			(:pragma (cfg (all (os "macos") (arch "aarch64"))))
			(const FE_FLUSHTOZERO i32)

			(fn fesetenv_disable_denorms
				(:doc "Install the Darwin arm64 environment with flush-to-zero enabled.")
				(c-name "fesetenv")
				(params (const environment (c-type "const fenv_t *") FE_DFL_DISABLE_DENORMS_ENV)) (returns i32))

			(fn feupdateenv_disable_denorms
				(:doc "Install the Darwin arm64 flush-to-zero environment and raise the previously active exceptions.")
				(c-name "feupdateenv")
				(params (const environment (c-type "const fenv_t *") FE_DFL_DISABLE_DENORMS_ENV)) (returns i32)))

		(decls
			(:doc "Expose the Darwin x86-64 denormal operand flag and alternate SSE environment.")
			(:pragma (cfg (all (os "macos") (arch "x86_64"))))
			(const FE_DENORMALOPERAND i32)

			(fn fesetenv_disable_sse_denorms
				(:doc "Install the Darwin x86-64 environment that disables denormal handling for SSE.")
				(c-name "fesetenv")
				(params (const environment (c-type "const fenv_t *") FE_DFL_DISABLE_SSE_DENORMS_ENV)) (returns i32))

			(fn feupdateenv_disable_sse_denorms
				(:doc "Install the Darwin x86-64 SSE denormal preset and raise the previously active exceptions.")
				(c-name "feupdateenv")
				(params (const environment (c-type "const fenv_t *") FE_DFL_DISABLE_SSE_DENORMS_ENV)) (returns i32)))

		(decls
			(:doc "Expose the additional environment controls in the GNU feature profile on Linux.")
			(:pragma (cfg (os "linux")))
			(struct ControlModes (c-type "femode_t") (fields))

			(fn fesetexcept
				(:doc "Set the selected floating-point flags without raising their exceptions.")
				(params (mask i32)) (returns i32))

			(fn fetestexceptflag
				(:doc "Return the selected set bits from a saved exception flag snapshot.")
				(params (flags (shared-ref ExceptionFlags)) (mask i32)) (returns i32))

			(fn fegetmode
				(:doc "Save the current control modes in caller-owned native storage.")
				(params (modes (mut-ref ControlModes))) (returns i32))

			(fn fesetmode
				(:doc "Restore the saved control modes while preserving current floating-point status flags.")
				(params (modes (shared-ref ControlModes))) (returns i32))

			(fn fesetmode_default
				(:doc "Install the default control modes while preserving current floating-point status flags.")
				(c-name "fesetmode")
				(params (const modes (c-type "const femode_t *") FE_DFL_MODE)) (returns i32))

			(fn fesetenv_nomask
				(:doc "Install the GNU environment preset that enables traps for the supported exceptions.")
				(c-name "fesetenv")
				(params (const environment (c-type "const fenv_t *") FE_NOMASK_ENV)) (returns i32))

			(fn feupdateenv_nomask
				(:doc "Install the GNU trap-enabled environment and raise previously active exceptions, which may trap.")
				(c-name "feupdateenv")
				(params (const environment (c-type "const fenv_t *") FE_NOMASK_ENV)) (returns i32))

			(fn feenableexcept
				(:doc "Enable traps for selected exceptions and return the previous mask, or -1 on failure.")
				(params (mask i32)) (returns i32))

			(fn fedisableexcept
				(:doc "Disable traps for selected exceptions and return the previous mask, or -1 on failure.")
				(params (mask i32)) (returns i32))

			(fn fegetexcept
				(:doc "Return the mask of exceptions with enabled traps, or -1 on failure.")
				(params) (returns i32)))

		(decls
			(:doc "Expose the offset from exception flag bits to FPCR trap-enable bits on Linux arm64.")
			(:pragma (cfg (all (os "linux") (arch "aarch64"))))
			(const FE_EXCEPT_SHIFT i32))

		(disabled
			(:doc `The audited macOS SDK and glibc headers lack decimal rounding constants and calls,
	FE_TONEARESTFROMZERO, and __STDC_VERSION_FENV_H__. The audited Clang profiles do not
	expose glibc's conditional FE_SNANS_ALWAYS_SIGNAL.`))))
