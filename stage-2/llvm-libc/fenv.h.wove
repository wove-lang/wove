(module c_fenv
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<fenv.h>"
		(:doc `Use native floating-point environment and exception snapshots with their original storage.
	Pass --cflag=-frounding-math to Clang for arithmetic that uses the runtime rounding mode,
	or --cflag=-ffp-model=strict for full floating-point environment access.`)
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
		(struct Environment (c-type "fenv_t") (fields))
		(struct ExceptionFlags (c-type "fexcept_t") (fields))

		(const FE_ALL_EXCEPT i32)
		(const FE_DIVBYZERO i32)
		(const FE_DOWNWARD i32)
		(const FE_INEXACT i32)
		(const FE_INVALID i32)
		(const FE_OVERFLOW i32)
		(const FE_TONEAREST i32)
		(const FE_TOWARDZERO i32)
		(const FE_UNDERFLOW i32)
		(const FE_UPWARD i32)

		(fn feclearexcept
			(:doc "Clear the floating-point exception flags selected by the mask.")
			(params (mask i32)) (returns i32))

		(fn fegetexceptflag
			(:doc "Save the selected exception flags in caller-owned native storage.")
			(params (flags (mut-ref ExceptionFlags)) (mask i32)) (returns i32))

		(fn feraiseexcept
			(:doc "Raise the floating-point exceptions selected by the mask.")
			(params (mask i32)) (returns i32))

		(fn fesetexceptflag
			(:doc "Restore the selected flags from a native snapshot without raising the exceptions.")
			(params (flags (shared-ref ExceptionFlags)) (mask i32)) (returns i32))

		(fn fetestexcept
			(:doc "Return the subset of the selected flags that are currently raised.")
			(params (mask i32)) (returns i32))

		(fn fegetround
			(:doc "Return the current native rounding mode.")
			(params) (returns i32))

		(fn fesetround
			(:doc "Set the rounding mode from a native FE rounding constant.")
			(params (mode i32)) (returns i32))

		(fn fegetenv
			(:doc "Save the current floating-point environment in caller-owned storage.")
			(params (environment (mut-ref Environment))) (returns i32))

		(fn feholdexcept
			(:doc "Save the environment and clear the flags, installing nonstop behavior where available.")
			(params (environment (mut-ref Environment))) (returns i32))

		(fn fesetenv
			(:doc "Install a saved environment without raising its exceptions.")
			(params (environment (shared-ref Environment))) (returns i32))

		(fn feupdateenv
			(:doc "Install a saved environment and raise the exceptions that were active before the call.")
			(params (environment (shared-ref Environment))) (returns i32))

		(fn fesetenv_default
			(:doc "Install the system default environment through the header's exact FE_DFL_ENV operand.")
			(c-name "fesetenv")
			(params (const environment (c-type "const fenv_t *") FE_DFL_ENV)) (returns i32))

		(fn feupdateenv_default
			(:doc "Install the system default environment and raise the previously active exceptions.")
			(c-name "feupdateenv")
			(params (const environment (c-type "const fenv_t *") FE_DFL_ENV)) (returns i32))

		(disabled
			(:doc `Darwin denormal flags and alternate default environments differ between arm64 and x86-64.
	glibc supplies extra exception and control-mode functions, femode_t, FE_DFL_MODE, FE_NOMASK_ENV,
	and the AArch64 FE_EXCEPT_SHIFT macro. These members need target-specific bindings and fixtures.`))

		(disabled
			(:doc `The audited macOS SDK and glibc headers lack decimal rounding constants and calls,
	FE_TONEARESTFROMZERO, and __STDC_VERSION_FENV_H__. The audited Clang profiles do not
	expose glibc's conditional FE_SNANS_ALWAYS_SIGNAL.`))))
