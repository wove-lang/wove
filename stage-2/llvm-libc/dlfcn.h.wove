(module c_dlfcn
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<dlfcn.h>"
		(:doc "Owned dynamic library handles and copied dynamic loader diagnostics.")
		(type Library (:pragma (c_owned (drop dlclose))) (c-type "void *"))
		(const RTLD_LAZY i32)
		(const RTLD_NOW i32)
		(const RTLD_LOCAL i32)
		(const RTLD_GLOBAL i32)
		(const RTLD_NOLOAD i32)
		(const RTLD_NODELETE i32)

		(fn dlopen
			(:doc "Acquire a library handle from the caller's terminated path and loader flags.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (flags i32))
			(returns Library))

		(fn dlopen_self
			(:doc "Use dlopen's null filename form to acquire a handle for the running program.")
			(c-name "dlopen")
			(params (const path (c-type "const char *") null) (flags i32))
			(returns Library))

		(fn dlclose
			(:doc "Release one reference to an opened dynamic object.")
			(params (library Library))
			(returns i32))

		(fn dlerror
			(:doc "Consume the loader diagnostic and copy it before a subsequent loader call can overwrite it.")
			(:pragma (c_snapshot cstr))
			(params)
			(returns (optional (owned-array u8))))

		(decls
			(:doc "Darwin's preflight query and first-image lookup flag.")
			(:pragma (cfg (os "macos")))
			(const RTLD_FIRST i32)

			(fn dlopen_preflight
				(:doc "Test whether the selected path can be loaded without opening it.")
				(:pragma (c_cstr path))
				(params (path (shared-array u8)))
				(returns bool)))

		(decls
			(:doc "glibc loader namespaces, flags, and request codes.")
			(:pragma (cfg (os "linux")))
			(type LoaderNamespace (c-type "Lmid_t"))
			(const LM_ID_BASE i32)
			(const LM_ID_NEWLM i32)
			(const RTLD_BINDING_MASK i32)
			(const RTLD_DEEPBIND i32)
			(const RTLD_DI_CONFIGADDR i32)
			(const RTLD_DI_LINKMAP i32)
			(const RTLD_DI_LMID i32)
			(const RTLD_DI_MAX i32)
			(const RTLD_DI_ORIGIN i32)
			(const RTLD_DI_PHDR i32)
			(const RTLD_DI_PROFILENAME i32)
			(const RTLD_DI_PROFILEOUT i32)
			(const RTLD_DI_SERINFO i32)
			(const RTLD_DI_SERINFOSIZE i32)
			(const RTLD_DI_TLS_DATA i32)
			(const RTLD_DI_TLS_MODID i32)
			(const RTLD_DL_LINKMAP i32)
			(const RTLD_DL_SYMENT i32)
			(const DLFO_STRUCT_HAS_EH_COUNT i32)
			(const DLFO_STRUCT_HAS_EH_DBASE i32)

			(fn dlmopen
				(:doc "Acquire an owned library handle in the selected glibc link-map namespace.")
				(:pragma (c_optional) (c_cstr path))
				(params (namespace LoaderNamespace) (path (shared-array u8)) (flags i32))
				(returns Library)))

		(disabled
			(:doc `RTLD_DEFAULT and RTLD_NEXT on both SDKs and RTLD_SELF and
			RTLD_MAIN_ONLY on Darwin are borrowed pointer sentinels. They must
			keep their native values and never invoke dlclose.`))

		(disabled
			(:doc `dlsym and glibc dlvsym return symbol storage tied to the
			dynamic object's lifetime. The bridge needs typed data and function
			address returns, including a null address distinguished from dlerror.`))

		(disabled
			(:doc `dladdr and glibc dladdr1 return borrowed addresses and names in
			Dl_info. Dl_info_t is a Darwin alias. dladdr1 and dlinfo also need
			request-dependent output pointer types. Dl_serinfo, Dl_serpath, and
			dl_find_object contain native address or flexible-array fields.`))

		(disabled
			(:doc `glibc's DL_CALL_FCT uses the loader's internal profiling hook.
			The reserved _dl_find_object declaration is a loader extension with its
			own native output record. DLFO_EH_SEGMENT_TYPE expands to an ELF
			segment constant and needs <elf.h> visible when used.`))))
