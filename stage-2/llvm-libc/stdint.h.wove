(module c_stdint
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<stdint.h>"
		(:doc "Expose exact-width integer typedefs and the native types of their limit expressions.")
		(:expect (tests "stage-2/cli/native/stdint/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(type Int8 (c-type "int8_t"))
		(type UInt8 (c-type "uint8_t"))
		(type Int16 (c-type "int16_t"))
		(type UInt16 (c-type "uint16_t"))
		(type Int32 (c-type "int32_t"))
		(type UInt32 (c-type "uint32_t"))
		(type Int64 (c-type "int64_t"))
		(type UInt64 (c-type "uint64_t"))

		(const INT8_MIN i32)
		(const INT8_MAX i32)
		(const UINT8_MAX i32)

		(const INT16_MIN i32)
		(const INT16_MAX i32)
		(const UINT16_MAX i32)

		(const INT32_MIN i32)
		(const INT32_MAX i32)
		(const UINT32_MAX u32)

		(const INT64_MIN Int64)
		(const INT64_MAX Int64)
		(const UINT64_MAX UInt64)

		(disabled
			(:doc "The least-width, fast, pointer-width, and maximum-width families need separate native type and limit coverage."))

		(disabled
			(:doc "The INTN_C and UINTN_C macros need separate coverage of their function-like forms and promoted result types."))))
