(module c_dirent
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<dirent.h>"
		(:doc "POSIX directory streams with target-specific native extensions.")
		(type Directory (:pragma (c_owned (drop closedir))) (c-type "DIR *"))
		(type DirectoryPosition (c-type "long"))

		(decls
			(:doc "Directory entry type codes and mode conversions from the Darwin and glibc headers.")
			(:pragma (cfg (any (os "macos") (os "linux"))))
			(const DT_UNKNOWN i32)
			(const DT_FIFO i32)
			(const DT_CHR i32)
			(const DT_DIR i32)
			(const DT_BLK i32)
			(const DT_REG i32)
			(const DT_LNK i32)
			(const DT_SOCK i32)
			(const DT_WHT i32)
			(const MAXNAMLEN i32)

			(fn IFTODT
				(:doc "Extract the entry type code from a file mode.")
				(:pragma (c_macro))
				(params (mode i32))
				(returns i32))

			(fn DTTOIF
				(:doc "Convert a header DT_* value to the file type bits of a mode.")
				(:pragma (c_macro))
				(params (entry_type i32))
				(returns i32)))

		(const (:pragma (cfg (os "macos"))) DIRBLKSIZ i32)

		(fn opendir
			(:doc "Open a directory stream from a call-scoped path.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)))
			(returns Directory))
		(fn fdopendir
			(:doc "A successful open transfers the descriptor to the directory stream.")
			(params (fd i32))
			(returns Directory))
		(fn closedir
			(:doc "Close the owned directory stream.")
			(params (directory Directory))
			(returns i32))
		(fn dirfd
			(:doc "The descriptor belongs to the stream and remains valid until the stream closes.")
			(params (directory (shared-ref Directory)))
			(returns i32))
		(fn rewinddir
			(:doc "Reset the directory stream to the beginning.")
			(params (directory (mut-ref Directory)))
			(returns void))
		(fn seekdir
			(:doc "Restore a directory stream position.")
			(params (directory (mut-ref Directory)) (position DirectoryPosition))
			(returns void))
		(fn telldir
			(:doc "Read the directory stream's native position.")
			(params (directory (shared-ref Directory)))
			(returns DirectoryPosition))

		(fn readdir
			(:doc "Copy the terminated name before the stream can reuse its entry, including extended native records.")
			(:pragma (c_snapshot cstr (field d_name) (extent d_reclen)))
			(params (directory (mut-ref Directory)))
			(returns (optional (owned-array u8))))

		(disabled
			(:doc `Neither glibc 2.41 nor the macOS 27.2 SDK exposes the POSIX.1-2024
			posix_getdents, struct posix_dent, reclen_t, DT_MQ, DT_SEM, DT_SHM, or DT_TMO
			under the compiler's C11, C17, and C23 header flags.`))

		(disabled
			(:doc `The raw struct dirent views need field-accurate bindings and the
			lifetime of a nullable entry borrowed from a mutable stream. glibc
			also exposes struct dirent64 under its large-file feature flags.
			The active readdir binding copies the name, including names in an
			extended entry, before the stream can overwrite it.`))

		(decls
			(:doc "Use the GNU directory entry extensions on the supported Linux ABIs.")
			(:pragma (cfg (all (os "linux") (any (arch "aarch64") (arch "x86_64")))))
			(type Size (c-type "size_t"))
			(type SignedSize (c-type "long"))
			(type Char (c-type "char"))
			(type Offset (c-type "long"))
			(type Offset64 (c-type "long"))

			(fn readdir64
				(:doc "Snapshot the glibc large-file entry's terminated name before the stream can reuse it.")
				(:pragma (c_snapshot cstr (field d_name) (extent d_reclen)))
				(params (directory (mut-ref Directory)))
				(returns (optional (owned-array u8))))

			(fn getdirentries
				(:doc "Read native entry bytes and receive the glibc directory position for the block.")
				(:pragma (c_optional) (c_array buffer count))
				(params (fd i32) (buffer (mut-array Char)) (count Size) (base (mut-ref Offset)))
				(returns SignedSize))

			(fn getdirentries64
				(:doc "Read large-file native entry bytes with an off64_t position output.")
				(:pragma (c_optional) (c_array buffer count))
				(params (fd i32) (buffer (mut-array Char)) (count Size) (base (mut-ref Offset64)))
				(returns SignedSize))

			(fn getdents64
				(:doc "Read at most count bytes from a directory descriptor. glibc 2.30 added this symbol.")
				(:pragma (c_optional) (c_bytes buffer count))
				(params (fd i32) (buffer (mut-array u8)) (count Size))
				(returns SignedSize)))

		(disabled
			(:doc "The macOS descriptor transfer extension requires deployment selection.")
			(fn fdclosedir
				(:doc `macOS 26.4 and later can close the stream while transferring its
				descriptor back. The installed driver currently supplies no macOS
				deployment version for selecting this declaration.`)
				(:pragma (cfg (all (os "macos") dirent_fdclosedir (os_min 260400))))
				(params (directory Directory))
				(returns i32)))

		(disabled
			(:doc `	// readdir_r and readdir64_r are deprecated. They require a native entry allocation
	// sized for the stream's name limit and a nullable result aliasing that allocation.
	// scandir, scandirat, fdscandir, scandir64, and scandirat64 need an owned vector
	// output and borrowed native-record filter and comparator parameters.
	// alphasort, alphasort64, versionsort, and versionsort64 take indirect entry borrows.
	// Darwin's scandir_b, scandirat_b, and fdscandir_b also require C Blocks callbacks.
	// Darwin's getdirentries cannot link with the current 64-bit inode ABI.`))))
