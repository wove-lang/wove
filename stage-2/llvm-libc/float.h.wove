(module c_float
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<float.h>"
		(:doc "Expose floating-point limits from the selected compiler header.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))
		(use c-header "<math.h>" (only (type LongDouble)))

		(const DECIMAL_DIG i32)
		(const FLT_EVAL_METHOD i32)
		(const FLT_RADIX i32)
		(let
			(:doc "Read the current rounding direction through the header's runtime expression.")
			(:pragma (c_macro))
			FLT_ROUNDS
			i32)

		(const FLT_DECIMAL_DIG i32)
		(const FLT_DIG i32)
		(const FLT_HAS_SUBNORM i32)
		(const FLT_MANT_DIG i32)
		(const FLT_MAX_10_EXP i32)
		(const FLT_MAX_EXP i32)
		(const FLT_MIN_10_EXP i32)
		(const FLT_MIN_EXP i32)

		(const DBL_DECIMAL_DIG i32)
		(const DBL_DIG i32)
		(const DBL_HAS_SUBNORM i32)
		(const DBL_MANT_DIG i32)
		(const DBL_MAX_10_EXP i32)
		(const DBL_MAX_EXP i32)
		(const DBL_MIN_10_EXP i32)
		(const DBL_MIN_EXP i32)

		(const LDBL_DECIMAL_DIG i32)
		(const LDBL_DIG i32)
		(const LDBL_HAS_SUBNORM i32)
		(const LDBL_MANT_DIG i32)
		(const LDBL_MAX_10_EXP i32)
		(const LDBL_MAX_EXP i32)
		(const LDBL_MIN_10_EXP i32)
		(const LDBL_MIN_EXP i32)

		(let (:pragma (c_macro)) FLT_EPSILON f32)
		(let (:pragma (c_macro)) FLT_MAX f32)
		(let (:pragma (c_macro)) FLT_MIN f32)
		(let (:pragma (c_macro)) FLT_TRUE_MIN f32)

		(let (:pragma (c_macro)) DBL_EPSILON f64)
		(let (:pragma (c_macro)) DBL_MAX f64)
		(let (:pragma (c_macro)) DBL_MIN f64)
		(let (:pragma (c_macro)) DBL_TRUE_MIN f64)

		(let (:pragma (c_macro)) LDBL_EPSILON LongDouble)
		(let (:pragma (c_macro)) LDBL_MAX LongDouble)
		(let (:pragma (c_macro)) LDBL_MIN LongDouble)
		(let (:pragma (c_macro)) LDBL_TRUE_MIN LongDouble)

		(let
			(:doc "Check the selected header for the mode-dependent C23 expression.")
			(:pragma (c_optional) (c_macro))
			FLT_NORM_MAX
			f32)
		(let (:pragma (c_optional) (c_macro)) DBL_NORM_MAX f64)
		(let (:pragma (c_optional) (c_macro)) LDBL_NORM_MAX LongDouble)
		(let (:pragma (c_optional) (c_macro)) INFINITY f32)
		(let (:pragma (c_optional) (c_macro)) NAN f32)

		(disabled
			(:doc `The audited Clang 21 headers do not expose FLT_IS_IEC_60559,
	DBL_IS_IEC_60559, LDBL_IS_IEC_60559, FLT_SNAN, DBL_SNAN, LDBL_SNAN,
	__STDC_VERSION_FLOAT_H__, or decimal floating-point limit macros.`))))
