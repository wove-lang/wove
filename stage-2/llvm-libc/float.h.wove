(module c_float
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<float.h>"
		(:doc "Expose floating-point limits from the selected compiler header.")
		(:expect (tests "stage-2/cli/native/cases.tsv" "stage-2/cli/native/macro-modes.tsv") (issues "gh:wove-lang/wove:318"))
		(use c-header "<math.h>" (only (type LongDouble)))

		(const DECIMAL_DIG i32)
		(const FLT_EVAL_METHOD i32)
		(const FLT_RADIX i32)
		(let FLT_ROUNDS
			(:doc "Read the current rounding direction through the header's runtime expression.")
			(:pragma (c_macro))
			i32)

		(const FLT_DECIMAL_DIG i32)
		(const FLT_DIG i32)
		(const FLT_HAS_SUBNORM i32)
		(const FLT_MANT_DIG i32)
		(const FLT_MAX_10_EXP i32)
		(const FLT_MAX_EXP i32)
		(const FLT_MIN_10_EXP i32)
		(const FLT_MIN_EXP i32)

		(const DBL_DECIMAL_DIG i32)
		(const DBL_DIG i32)
		(const DBL_HAS_SUBNORM i32)
		(const DBL_MANT_DIG i32)
		(const DBL_MAX_10_EXP i32)
		(const DBL_MAX_EXP i32)
		(const DBL_MIN_10_EXP i32)
		(const DBL_MIN_EXP i32)

		(const LDBL_DECIMAL_DIG i32)
		(const LDBL_DIG i32)
		(const LDBL_HAS_SUBNORM i32)
		(const LDBL_MANT_DIG i32)
		(const LDBL_MAX_10_EXP i32)
		(const LDBL_MAX_EXP i32)
		(const LDBL_MIN_10_EXP i32)
		(const LDBL_MIN_EXP i32)

		(let FLT_EPSILON (:pragma (c_macro)) f32)
		(let FLT_MAX (:pragma (c_macro)) f32)
		(let FLT_MIN (:pragma (c_macro)) f32)
		(let FLT_TRUE_MIN (:pragma (c_macro)) f32)

		(let DBL_EPSILON (:pragma (c_macro)) f64)
		(let DBL_MAX (:pragma (c_macro)) f64)
		(let DBL_MIN (:pragma (c_macro)) f64)
		(let DBL_TRUE_MIN (:pragma (c_macro)) f64)

		(let LDBL_EPSILON (:pragma (c_macro)) LongDouble)
		(let LDBL_MAX (:pragma (c_macro)) LongDouble)
		(let LDBL_MIN (:pragma (c_macro)) LongDouble)
		(let LDBL_TRUE_MIN (:pragma (c_macro)) LongDouble)

		(let FLT_NORM_MAX
			(:doc "Check the selected header for the mode-dependent C23 expression.")
			(:pragma (c_optional) (c_macro))
			f32)
		(let DBL_NORM_MAX (:pragma (c_optional) (c_macro)) f64)
		(let LDBL_NORM_MAX (:pragma (c_optional) (c_macro)) LongDouble)
		(let INFINITY (:pragma (c_optional) (c_macro)) f32)
		(let NAN (:pragma (c_optional) (c_macro)) f32)
		(let FLT_SNAN (:pragma (c_optional) (c_macro)) f32)
		(let DBL_SNAN (:pragma (c_optional) (c_macro)) f64)
		(let LDBL_SNAN (:pragma (c_optional) (c_macro)) LongDouble)

		(disabled
			(:doc `The audited Clang 21 and Clang 22 headers do not expose
	FLT_IS_IEC_60559, DBL_IS_IEC_60559, LDBL_IS_IEC_60559,
	__STDC_VERSION_FLOAT_H__, or decimal floating-point limit macros.`))))
