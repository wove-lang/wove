(module c_stddef
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<stddef.h>"
		(:doc "Expose the native types and macro selected by Clang's stddef header.")
		(:expect (tests "stage-2/cli/native/stddef/cases.tsv" "stage-2/cli/native/inttypes-wide/cases.tsv")
			(issues "gh:wove-lang/wove:781" "gh:wove-lang/wove:757"))

		(type Size (c-type "size_t"))
		(type PtrDiff (c-type "ptrdiff_t"))
		(type WChar (c-type "wchar_t"))
		(type RSize (:pragma (c_optional)) (c-type "rsize_t"))
		(struct MaxAlign
			(:doc "Lend or copy the complete native record without exposing its implementation fields.")
			(:pragma (cfg (os "linux")) (c_optional))
			(c-type "max_align_t") (fields))
		(fn unreachable
			(:doc "Emit the C23 macro on a path the caller proves cannot execute.")
			(:pragma (c_macro))
			(params) (returns void))

		(disabled
			(:doc "Darwin max_align_t is a typedef for long double. A floating alias must preserve the typedef spelling and exact native floating ABI."))
		(disabled
			(:doc "NULL expands to a native null pointer constant. A value contract must preserve that expansion in an admitted nullable C argument slot."))
		(disabled
			(:doc "offsetof needs a checked C type token and member designator as its two macro arguments."))
		(disabled
			(:doc "C23 nullptr_t needs a distinct native null scalar and exact ABI support."))
		(disabled
			(:doc "The audited headers do not expose __STDC_VERSION_STDDEF_H__."))))
