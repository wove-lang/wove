(module c_stddef
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<stddef.h>"
		(:doc "Expose the native wide character type used by C bridge signatures.")
		(:expect (tests "stage-2/cli/native/inttypes-wide/cases.tsv") (issues "gh:wove-lang/wove:757"))
		(type WChar (c-type "wchar_t"))

		(disabled
			(:doc "size_t, ptrdiff_t, and the opt-in rsize_t are deferred to the hosted stddef coverage under #318."))
		(disabled
			(:doc "max_align_t has different Darwin and glibc representations and needs its own layout audit."))
		(disabled
			(:doc "NULL and offsetof, along with the C23 nullptr_t and unreachable entries, are deferred to the hosted stddef coverage under #318."))
		(disabled
			(:doc "The audited headers do not expose __STDC_VERSION_STDDEF_H__."))))
