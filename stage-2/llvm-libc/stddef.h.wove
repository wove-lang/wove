(module c_stddef
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<stddef.h>"
		(:doc "Expose the native types and macros selected by Clang's stddef header.")
		(:expect (tests "stage-2/cli/native/stddef/cases.tsv" "stage-2/cli/native/stddef/activation.tsv"
				"stage-2/cli/native/inttypes-wide/cases.tsv")
			(issues "gh:wove-lang/wove:797" "gh:wove-lang/wove:781" "gh:wove-lang/wove:757"
				"gh:wove-lang/wove:801" "gh:wove-lang/wove:784" "gh:wove-lang/wove:785"
				"gh:wove-lang/wove:827"))

		(type Size (c-type "size_t"))
		(type PtrDiff (c-type "ptrdiff_t"))
		(type WChar (c-type "wchar_t"))
		(type RSize (:pragma (c_optional)) (c-type "rsize_t"))
		(struct MaxAlign
			(:doc "Lend or copy the complete native record without exposing its implementation fields.")
			(:pragma (cfg (os "linux")) (c_optional))
			(c-type "max_align_t") (fields))
		(type MaxAlign (:pragma (cfg (os "macos")) (c_long_double)) (c-type "max_align_t"))
		(fn unreachable
			(:doc "Emit the C23 macro on a path the caller proves cannot execute.")
			(:pragma (c_macro))
			(params) (returns void))

		(const NULL
			(:doc "Pass the header macro to a fixed nullable C parameter.")
			(:pragma (c_null_value)))
		(type Nullptr
			(:doc "Keep the exact native null type when the selected C23 header exposes it.")
			(:pragma (c_nullptr_t) (c_optional))
			(c-type "nullptr_t"))
		(fn offsetof
			(:doc `Return the native byte offset of one directly declared record field.

			Nested fields and array element designators need a checked member path operand.`)
			(:pragma (c_macro))
			(params (record c-type-token) (member c-member-token)) (returns Size))

		(disabled
			(:doc "The audited headers do not expose __STDC_VERSION_STDDEF_H__."))))
