(module c_unistd
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<unistd.h>"
		(:doc "POSIX descriptors, process identity, and call-scoped byte/array operations.")
		(type Pid (c-type "pid_t"))
		(type Uid (c-type "uid_t"))
		(type Gid (c-type "gid_t"))
		(type Offset (c-type "off_t"))
		(type Size (c-type "size_t"))
		(type SignedSize (c-type "ssize_t"))
		(type Long (c-type "long"))

		(const STDIN_FILENO i32)
		(const STDOUT_FILENO i32)
		(const STDERR_FILENO i32)
		(const F_OK i32)
		(const R_OK i32)
		(const W_OK i32)
		(const X_OK i32)
		(const SEEK_SET i32)
		(const SEEK_CUR i32)
		(const SEEK_END i32)
		(const F_ULOCK i32)
		(const F_LOCK i32)
		(const F_TLOCK i32)
		(const F_TEST i32)

		(fn _exit (:doc "Terminate without ordinary C exit handlers.") (params (status i32)) (returns void))
		(fn fork (:doc "Create a process and retain the native pid_t result.") (params) (returns Pid))
		(fn getpid (:doc "Read the current value using the native return type.") (params) (returns Pid))
		(fn getppid (:doc "Read the current value using the native return type.") (params) (returns Pid))
		(fn getpgrp (:doc "Read the current value using the native return type.") (params) (returns Pid))
		(fn getpgid
			(:doc "Read the current value using the native return type.")
			(params (pid Pid))
			(returns Pid))
		(fn getsid
			(:doc "Read the current value using the native return type.")
			(params (pid Pid))
			(returns Pid))
		(fn setpgid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (pid Pid) (group Pid))
			(returns i32))
		(fn setsid
			(:doc "Apply the requested setting and preserve the native result.")
			(params)
			(returns Pid))
		(fn tcgetpgrp
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(params (fd i32))
			(returns Pid))
		(fn tcsetpgrp
			(:doc "Apply the requested setting and preserve the native result.")
			(params (fd i32) (group Pid))
			(returns i32))
		(fn pause
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(params)
			(returns i32))
		(fn alarm
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(params (seconds u32))
			(returns u32))
		(fn sleep
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(params (seconds u32))
			(returns u32))
		(fn getuid (:doc "Read the current value using the native return type.") (params) (returns Uid))
		(fn geteuid (:doc "Read the current value using the native return type.") (params) (returns Uid))
		(fn getgid (:doc "Read the current value using the native return type.") (params) (returns Gid))
		(fn getegid (:doc "Read the current value using the native return type.") (params) (returns Gid))
		(fn setuid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (uid Uid))
			(returns i32))
		(fn seteuid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (uid Uid))
			(returns i32))
		(fn setreuid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (real Uid) (effective Uid))
			(returns i32))
		(fn setgid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (gid Gid))
			(returns i32))
		(fn setegid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (gid Gid))
			(returns i32))
		(fn setregid
			(:doc "Apply the requested setting and preserve the native result.")
			(params (real Gid) (effective Gid))
			(returns i32))
		(fn getgroups
			(:doc "Pass the caller's mutable storage using the native pointee type.")
			(:pragma (c_array groups capacity))
			(params (capacity i32) (groups (mut-array Gid)))
			(returns i32))

		(fn close
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32))
			(returns i32))
		(fn dup
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32))
			(returns i32))
		(fn dup2
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32) (target i32))
			(returns i32))
		(fn pipe
			(:doc "Write both descriptors to a checked two-element output view.")
			(:pragma (c_array descriptors 2))
			(params (descriptors (mut-array i32)))
			(returns i32))
		(fn read
			(:doc "Read into the bounded output byte view.")
			(:pragma (c_bytes output count))
			(params (fd i32) (output (mut-array u8)) (count Size))
			(returns SignedSize))
		(fn write
			(:doc "Write from the bounded input byte view.")
			(:pragma (c_bytes input count))
			(params (fd i32) (input (shared-array u8)) (count Size))
			(returns SignedSize))
		(fn pread
			(:doc "Read into bounded storage at a native file offset.")
			(:pragma (c_bytes output count))
			(params (fd i32) (output (mut-array u8)) (count Size) (offset Offset))
			(returns SignedSize))
		(fn pwrite
			(:doc "Write bounded input at a native file offset.")
			(:pragma (c_bytes input count))
			(params (fd i32) (input (shared-array u8)) (count Size) (offset Offset))
			(returns SignedSize))
		(fn lseek
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32) (offset Offset) (origin i32))
			(returns Offset))
		(fn fsync
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32))
			(returns i32))
		(fn ftruncate
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32) (length Offset))
			(returns i32))
		(fn lockf
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32) (command i32) (length Offset))
			(returns i32))
		(fn sync
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(params)
			(returns void))
		(fn isatty
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32))
			(returns i32))
		(fn nice
			(:doc "Preserve the result and side effects of the header's native declaration.")
			(params (increment i32))
			(returns i32))
		(fn gethostid (:doc "Read the current value using the native return type.") (params) (returns Long))

		(fn access
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (mode i32))
			(returns i32))
		(fn faccessat
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (fd i32) (path (shared-array u8)) (mode i32) (flags i32))
			(returns i32))
		(fn chdir
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)))
			(returns i32))
		(fn fchdir
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32))
			(returns i32))
		(fn chown
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (uid Uid) (gid Gid))
			(returns i32))
		(fn lchown
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (uid Uid) (gid Gid))
			(returns i32))
		(fn fchown
			(:doc "Use the supplied descriptor and preserve the C result.")
			(params (fd i32) (uid Uid) (gid Gid))
			(returns i32))
		(fn fchownat
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (fd i32) (path (shared-array u8)) (uid Uid) (gid Gid) (flags i32))
			(returns i32))
		(fn truncate
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (length Offset))
			(returns i32))
		(fn link
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr existing path))
			(params (existing (shared-array u8)) (path (shared-array u8)))
			(returns i32))
		(fn linkat
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr existing path))
			(params
				(existing_fd i32)
				(existing (shared-array u8))
				(fd i32)
				(path (shared-array u8))
				(flags i32))
			(returns i32))
		(fn symlink
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr target path))
			(params (target (shared-array u8)) (path (shared-array u8)))
			(returns i32))
		(fn symlinkat
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr target path))
			(params (target (shared-array u8)) (fd i32) (path (shared-array u8)))
			(returns i32))
		(fn unlink
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)))
			(returns i32))
		(fn unlinkat
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (fd i32) (path (shared-array u8)) (flags i32))
			(returns i32))
		(fn rmdir
			(:doc "Use the path only for the duration of the C call.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)))
			(returns i32))

		(fn mkdtemp
			(:doc "Darwin's SDK places mkdtemp here; Linux follows stdlib.h.")
			(:pragma (cfg (os "macos")) (c_cstr template) (c_snapshot cstr))
			(params (template (mut-array u8)))
			(returns (optional (owned-array u8))))

		(let-mut optind (:doc "These are live mutable C globals, not snapshots or builtins.") i32)
		(let-mut opterr i32)
		(let-mut optopt i32)

		(let environ
			(:doc "Explicit, read-only snapshots copy C-owned text into ordinary Wove owners.")
			(:pragma (c_snapshot cstrs))
			(owned-array (owned-array u8)))

		(fn sysconf
			(:doc "Configuration queries retain C long. Selectors are checked header values.")
			(params (name i32))
			(returns Long))
		(fn fpathconf
			(:doc "Query a descriptor selector and preserve C long.")
			(params (fd i32) (name i32))
			(returns Long))
		(fn pathconf
			(:doc "Query a path selector and preserve C long.")
			(:pragma (c_cstr path))
			(params (path (shared-array u8)) (name i32))
			(returns Long))
		(const _SC_ARG_MAX i32)
		(const _SC_CHILD_MAX i32)
		(const _SC_CLK_TCK i32)
		(const _SC_NGROUPS_MAX i32)
		(const _SC_OPEN_MAX i32)
		(const _SC_NPROCESSORS_ONLN i32)
		(const _SC_PAGESIZE i32)
		(const _SC_VERSION i32)
		(const _PC_LINK_MAX i32)
		(const _PC_MAX_CANON i32)
		(const _PC_MAX_INPUT i32)
		(const _PC_NAME_MAX i32)
		(const _PC_PATH_MAX i32)
		(const _PC_PIPE_BUF i32)
		(const _PC_CHOWN_RESTRICTED i32)
		(const _PC_NO_TRUNC i32)
		(const _PC_VDISABLE i32)

		(fn fdatasync
			(:doc "Darwin does not declare fdatasync. GNU extensions need header feature selection too.")
			(:pragma (cfg (os "linux")))
			(params (fd i32))
			(returns i32))

		(fn execv
			(:doc "Copied, terminated vectors survive until failure returns or exec replaces this process.")
			(:pragma (c_cstr path) (c_cstrs arguments))
			(params (path (shared-array u8)) (arguments (shared-array (owned-array u8))))
			(returns i32))
		(fn execve
			(:doc "Keep native argument vectors alive until replacement or failure.")
			(:pragma (c_cstr path) (c_cstrs arguments environment))
			(params
				(path (shared-array u8))
				(arguments (shared-array (owned-array u8)))
				(environment (shared-array (owned-array u8))))
			(returns i32))
		(fn execvp
			(:doc "Keep native argument vectors alive until replacement or failure.")
			(:pragma (c_cstr file) (c_cstrs arguments))
			(params (file (shared-array u8)) (arguments (shared-array (owned-array u8))))
			(returns i32))
		(fn fexecve
			(:doc "Keep native argument vectors alive until replacement or failure.")
			(:pragma (cfg (os "linux")) (c_cstrs arguments environment))
			(params
				(fd i32)
				(arguments (shared-array (owned-array u8)))
				(environment (shared-array (owned-array u8))))
			(returns i32))
		(disabled (:doc "\t// execl/execle/execlp need variable-length typed text tails and a terminating null contract."))

		(disabled
			(:doc `	// Missing: char storage views, returned aliases, termination, and text ownership.
	// getcwd, getlogin/getlogin_r, ttyname/ttyname_r, gethostname, readlink/readlinkat,
	// confstr, ctermid, crypt, encrypt, and swab need contracts beyond void byte storage.
	// getopt may retain/reorder the argument vector; optarg aliases its text.
	// static optarg: char *
	// fn getopt(argc: i32, argv: char *const *, options: const char *) -> i32`))

		(disabled
			(:doc `	// Missing: feature/header availability selection for the complete _POSIX_*, _XOPEN_*,
	// _SC_*, _PC_* and _CS_* catalogs. The portable selectors used above are explicit.
	// vfork needs shared-address-space control-flow rules; it cannot use fork's contract.
	// Removed/deprecated setpgrp, ualarm/usleep, getwd, getpagesize/getdtablesize,
	// getpass, brk/sbrk, and host extensions stay outside this default POSIX surface.`))

		(fn pipe2
			(:doc `Create both descriptors with the requested flags before either descriptor can be inherited.
			Darwin declares this operation starting with the macOS 27 deployment target.`)
			(:pragma (cfg (any (os "linux") (all (os "macos") (os_min 270000))))
				(c_array descriptors 2))
			(params (descriptors (mut-array i32)) (flags i32))
			(returns i32))))
