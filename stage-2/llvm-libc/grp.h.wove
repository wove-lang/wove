(module c_grp
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<grp.h>"
		(:doc "Expose checked group database operations with the selected SDK's native types.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(type Gid (:pragma (c_optional)) (c-type "gid_t"))
		(type Size (c-type "size_t"))
		(struct Group
			(:doc "Project the group ID using the unsigned 32-bit field verified on both SDKs.")
			(c-type "struct group")
			(fields (gr_gid u32)))

		(fn setgrent
			(:doc "Reset the native group enumeration stream when the selected profile exposes it.")
			(:pragma (c_optional))
			(params) (returns void))

		(fn endgrent
			(:doc "Close the native group enumeration stream and clear its cached entries.")
			(:pragma (c_optional))
			(params) (returns void))

		(decls (:pragma (cfg (os "macos")))
			(fn setgroupent
				(:doc "Rewind Darwin's existing enumeration cache and return the native status.")
				(:pragma (c_optional))
				(params (stay_open i32)) (returns i32))

			(fn group_from_gid
				(:doc "Copy the native group name or numeric fallback before a later lookup can replace it.")
				(:pragma (c_optional) (c_snapshot cstr))
				(params (gid Gid) (no_fallback i32))
				(returns (optional (owned-array u8)))))

		(decls (:pragma (cfg (os "linux")))
			(const NSS_BUFLEN_GROUP (:pragma (c_optional)) i32)

			(fn initgroups
				(:doc "Pass the checked user name and base group to libc and preserve its status.")
				(:pragma (c_optional) (c_cstr user))
				(params (user (shared-array u8)) (base Gid))
				(returns i32))

			(fn setgroups
				(:doc "Check the shared group array against the native size before changing the process group list.")
				(:pragma (c_optional) (c_array groups count))
				(params (count Size) (groups (shared-array Gid)))
				(returns i32)))

		(disabled
			(:doc "getgrgid, getgrnam, getgrent, Darwin getgruuid, and glibc fgetgrent return nullable libc-managed group records. Their gr_name, gr_passwd, and terminated gr_mem entries require the lifetime or snapshot contract in gh:wove-lang/wove:636."))

		(disabled
			(:doc "getgrgid_r, getgrnam_r, Darwin getgruuid_r, and glibc getgrent_r and fgetgrent_r lend a caller record and byte buffer through an out pointer. Darwin can place gr_mem at an unaligned address. glibc putgrent needs the complete group fields through the same checked record contract. See gh:wove-lang/wove:637."))

		(disabled
			(:doc "Darwin _PATH_GROUP requires the native immutable string macro contract in gh:wove-lang/wove:639."))

		(disabled
			(:doc "glibc getgrouplist borrows a writable gid_t array sized by the incoming int pointer, then returns an updated count. See gh:wove-lang/wove:640."))

		(disabled
			(:doc "The Darwin SDK declares setgrfile in some feature profiles. The symbol fails to link on both audited Darwin architectures."))))
