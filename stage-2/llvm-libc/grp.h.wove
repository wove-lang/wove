(module c_grp
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(struct GroupPassword
		(:doc "Keep a native null password distinct from a present empty string.")
		(:pragma (cfg (os "macos")))
		(fields (present bool) (bytes (owned-array u8))))
	(struct GroupSnapshot
		(:doc "Own all group fields independently of the next libc lookup.")
		(:pragma (cfg (os "macos")))
		(fields (gid u32) (name (owned-array u8)) (password GroupPassword)
			(members (owned-array (owned-array u8)))))
	(enum GroupLookup
		(:doc "Represent a missing native result or the complete copied group.")
		(:pragma (cfg (os "macos")))
		(variants (Missing) (Found GroupSnapshot)))

	(bridge c-header "<grp.h>"
		(:doc "Expose checked group database operations with the selected SDK's native types.")
		(:expect (tests "stage-2/cli/native/cases.tsv" "stage-2/cli/native/macro-modes.tsv") (issues "gh:wove-lang/wove:318" "gh:wove-lang/wove:636" "gh:wove-lang/wove:637"))

		(use (:pragma (cfg (os "linux"))) c-header "<stdio.h>" (only (type File)))

		(type Gid (:pragma (c_optional)) (c-type "gid_t"))
		(type Size (c-type "size_t"))
		(struct Group
			(:doc "Project the native GID and lend the bounded strings and member table of a checked caller-backed result.")
			(c-type "struct group")
			(fields (gr_gid u32) (gr_name cstr) (gr_passwd cstr) (gr_mem cstrs)))

		(fn getgrgid_r
			(:doc "Look up a group ID using the caller's record and byte storage, preserving the native status.")
			(:pragma (cfg (not (os "linux"))) (c_optional) (c_bytes buffer length) (c_record_out buffer status))
			(params (gid Gid) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))

		(fn getgrgid_r
			(:doc "Use the checked unsigned 32-bit glibc group ID even when the public typedef is unavailable.")
			(:pragma (cfg (os "linux")) (c_optional) (c_bytes buffer length) (c_record_out buffer status))
			(params (gid u32) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))

		(fn getgrnam_r
			(:doc "Look up a checked group name and lend the caller-backed result if libc supplies it.")
			(:pragma (c_optional) (c_cstr name) (c_bytes buffer length) (c_record_out buffer status))
			(params (name (shared-array u8)) (entry (mut-ref Group)) (buffer (mut-array u8))
				(length Size) (status (mut-ref i32)))
			(returns (optional (shared-ref Group)) (from entry)))

		(fn setgrent
			(:doc "Reset the native group enumeration stream when the selected profile exposes it.")
			(:pragma (c_optional))
			(params) (returns void))

		(fn endgrent
			(:doc "Close the native group enumeration stream and clear its cached entries.")
			(:pragma (c_optional))
			(params) (returns void))

		(snapshot GroupSnapshot
			(:doc "Copy all fields and terminated member rows of a Darwin group record.")
			(c-type "struct group")
			(fields (gid gr_gid u32) (name gr_name cstr) (password gr_passwd (optional cstr))
				(members gr_mem cstrs)))

		(decls (:pragma (cfg (os "macos")))
			(const _PATH_GROUP (:pragma (c_optional)) (shared-array u8))

			(fn getgrgid
				(:doc "Return an owned copy of the group for this ID, or Missing.")
				(:pragma (c_optional) (c_snapshot record GroupSnapshot (lifetime thread_local)))
				(params (gid Gid)) (returns GroupLookup))

			(fn getgrnam
				(:doc "Find a Darwin group by name and copy its complete record.")
				(:pragma (c_optional) (c_cstr name) (c_snapshot record GroupSnapshot (lifetime thread_local)))
				(params (name (shared-array u8))) (returns GroupLookup))

			(fn getgruuid
				(:doc "Look up a Darwin group using exactly 16 UUID bytes.")
				(:pragma (c_optional) (c_array id 16) (c_snapshot record GroupSnapshot (lifetime thread_local)))
				(params (id (mut-array u8))) (returns GroupLookup))

			(fn getgrent
				(:doc "Advance the group enumeration and copy the returned record before another call.")
				(:pragma (c_optional) (c_snapshot record GroupSnapshot (lifetime thread_local)))
				(params) (returns GroupLookup))

			(fn getgruuid_r
				(:doc "Look up a Darwin group by its sixteen UUID bytes using the caller's record and buffer.")
				(:pragma (c_optional) (c_array uuid 16) (c_bytes buffer length) (c_record_out buffer status))
				(params (uuid (mut-array u8)) (entry (mut-ref Group)) (buffer (mut-array u8))
					(length Size) (status (mut-ref i32)))
				(returns (optional (shared-ref Group)) (from entry)))

			(fn setgroupent
				(:doc "Rewind Darwin's existing enumeration cache and return the native status.")
				(:pragma (c_optional))
				(params (stay_open i32)) (returns i32))

			(fn group_from_gid
				(:doc "Copy the native group name or numeric fallback before a later lookup can replace it.")
				(:pragma (c_optional) (c_snapshot cstr))
				(params (gid Gid) (no_fallback i32))
				(returns (optional (owned-array u8)))))

		(decls (:pragma (cfg (os "linux")))
			(const NSS_BUFLEN_GROUP (:pragma (c_optional)) i32)

			(fn getgrent_r
				(:doc "Advance the glibc group enumeration into the caller's record and byte storage.")
				(:pragma (c_optional) (c_bytes buffer length) (c_record_out buffer status))
				(params (entry (mut-ref Group)) (buffer (mut-array u8)) (length Size) (status (mut-ref i32)))
				(returns (optional (shared-ref Group)) (from entry)))

			(fn fgetgrent_r
				(:doc "Read one entry from the stream and lend the caller-backed result, retaining the native status.")
				(:pragma (c_optional) (c_bytes buffer length) (c_record_out buffer status))
				(params (file (shared-ref File)) (entry (mut-ref Group)) (buffer (mut-array u8))
					(length Size) (status (mut-ref i32)))
				(returns (optional (shared-ref Group)) (from entry)))

			(fn putgrent
				(:doc "Write the complete borrowed group entry to a glibc stream and return the native status.")
				(:pragma (c_optional))
				(params (entry (shared-ref Group)) (file (shared-ref File))) (returns i32))

			(fn initgroups
				(:doc "Pass the checked user name and base group to libc and preserve its status.")
				(:pragma (c_optional) (c_cstr user))
				(params (user (shared-array u8)) (base Gid))
				(returns i32))

			(fn setgroups
				(:doc "Check the shared group array against the native size before changing the process group list.")
				(:pragma (c_optional) (c_array groups count))
				(params (count Size) (groups (shared-array Gid)))
				(returns i32))

			(fn getgrouplist
				(:doc "Check the supplied group capacity and preserve the native status and updated count for retries.")
				(:pragma (c_optional) (c_cstr user) (c_array groups count))
				(params (user (shared-array u8)) (base Gid) (groups (mut-array Gid)) (count (mut-ref i32)))
				(returns i32)))

		(disabled
			(:doc "glibc getgrgid, getgrnam, getgrent, and fgetgrent can overwrite their nullable libc-managed results. Copy the complete result under a contract that accounts for glibc static and stream storage. See gh:wove-lang/wove:636."))

		(disabled
			(:doc "The Darwin SDK declares setgrfile in some feature profiles. The symbol fails to link on both audited Darwin architectures."))))
