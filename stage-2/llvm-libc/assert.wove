(module c_assert
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<assert.h>"
		(:doc "C11 assert.h. NDEBUG controls C's assertion macro; Wove evaluates call arguments first.")
		(fn assert
			(:doc "Evaluate the C assertion macro under the header's NDEBUG policy.")
			(:pragma (c_macro))
			(params (condition bool))
			(returns void))

		(disabled
			(:doc `	// Missing: compile-time expression and diagnostic-text parameters for declaration macros.
	// static_assert(condition, message)`))))
