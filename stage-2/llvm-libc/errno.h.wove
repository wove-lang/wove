(module c_errno
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<errno.h>"
		(:doc "The C error lvalue, standard error codes, and codes exposed by the supported SDKs.")
		(let-mut errno i32)
		(const EDOM i32)
		(const EILSEQ i32)
		(const ERANGE i32)

		(decls
			(:doc "The remaining error codes shared by the audited Darwin and glibc headers.")
			(:pragma (cfg (any (os "linux") (os "macos"))))
			(const E2BIG i32)
			(const EACCES i32)
			(const EADDRINUSE i32)
			(const EADDRNOTAVAIL i32)
			(const EAFNOSUPPORT i32)
			(const EAGAIN i32)
			(const EALREADY i32)
			(const EBADF i32)
			(const EBADMSG i32)
			(const EBUSY i32)
			(const ECANCELED i32)
			(const ECHILD i32)
			(const ECONNABORTED i32)
			(const ECONNREFUSED i32)
			(const ECONNRESET i32)
			(const EDEADLK i32)
			(const EDESTADDRREQ i32)
			(const EDQUOT i32)
			(const EEXIST i32)
			(const EFAULT i32)
			(const EFBIG i32)
			(const EHOSTDOWN i32)
			(const EHOSTUNREACH i32)
			(const EIDRM i32)
			(const EINPROGRESS i32)
			(const EINTR i32)
			(const EINVAL i32)
			(const EIO i32)
			(const EISCONN i32)
			(const EISDIR i32)
			(const ELOOP i32)
			(const EMFILE i32)
			(const EMLINK i32)
			(const EMSGSIZE i32)
			(const EMULTIHOP i32)
			(const ENAMETOOLONG i32)
			(const ENETDOWN i32)
			(const ENETRESET i32)
			(const ENETUNREACH i32)
			(const ENFILE i32)
			(const ENOBUFS i32)
			(const ENODATA i32)
			(const ENODEV i32)
			(const ENOENT i32)
			(const ENOEXEC i32)
			(const ENOLCK i32)
			(const ENOLINK i32)
			(const ENOMEM i32)
			(const ENOMSG i32)
			(const ENOPROTOOPT i32)
			(const ENOSPC i32)
			(const ENOSR i32)
			(const ENOSTR i32)
			(const ENOSYS i32)
			(const ENOTBLK i32)
			(const ENOTCONN i32)
			(const ENOTDIR i32)
			(const ENOTEMPTY i32)
			(const ENOTRECOVERABLE i32)
			(const ENOTSOCK i32)
			(const ENOTSUP i32)
			(const ENOTTY i32)
			(const ENXIO i32)
			(const EOPNOTSUPP i32)
			(const EOVERFLOW i32)
			(const EOWNERDEAD i32)
			(const EPERM i32)
			(const EPFNOSUPPORT i32)
			(const EPIPE i32)
			(const EPROTO i32)
			(const EPROTONOSUPPORT i32)
			(const EPROTOTYPE i32)
			(const EREMOTE i32)
			(const EROFS i32)
			(const ESHUTDOWN i32)
			(const ESOCKTNOSUPPORT i32)
			(const ESPIPE i32)
			(const ESRCH i32)
			(const ESTALE i32)
			(const ETIME i32)
			(const ETIMEDOUT i32)
			(const ETOOMANYREFS i32)
			(const ETXTBSY i32)
			(const EUSERS i32)
			(const EWOULDBLOCK i32)
			(const EXDEV i32))

		(decls
			(:doc "Additional error codes in the Darwin header.")
			(:pragma (cfg (os "macos")))
			(const EAUTH i32)
			(const EBADARCH i32)
			(const EBADEXEC i32)
			(const EBADMACHO i32)
			(const EBADRPC i32)
			(const EDEVERR i32)
			(const EFTYPE i32)
			(const ELAST i32)
			(const ENEEDAUTH i32)
			(const ENOATTR i32)
			(const ENOPOLICY i32)
			(const ENOTCAPABLE i32)
			(const EPROCLIM i32)
			(const EPROCUNAVAIL i32)
			(const EPROGMISMATCH i32)
			(const EPROGUNAVAIL i32)
			(const EPWROFF i32)
			(const EQFULL i32)
			(const ERPCMISMATCH i32)
			(const ESHLIBVERS i32))

		(decls
			(:doc "Additional error codes and aliases in the audited glibc header.")
			(:pragma (cfg (os "linux")))
			(const EADV i32)
			(const EBADE i32)
			(const EBADFD i32)
			(const EBADR i32)
			(const EBADRQC i32)
			(const EBADSLT i32)
			(const EBFONT i32)
			(const ECHRNG i32)
			(const ECOMM i32)
			(const EDEADLOCK i32)
			(const EDOTDOT i32)
			(const EHWPOISON i32)
			(const EISNAM i32)
			(const EKEYEXPIRED i32)
			(const EKEYREJECTED i32)
			(const EKEYREVOKED i32)
			(const EL2HLT i32)
			(const EL2NSYNC i32)
			(const EL3HLT i32)
			(const EL3RST i32)
			(const ELIBACC i32)
			(const ELIBBAD i32)
			(const ELIBEXEC i32)
			(const ELIBMAX i32)
			(const ELIBSCN i32)
			(const ELNRNG i32)
			(const EMEDIUMTYPE i32)
			(const ENAVAIL i32)
			(const ENOANO i32)
			(const ENOCSI i32)
			(const ENOKEY i32)
			(const ENOMEDIUM i32)
			(const ENONET i32)
			(const ENOPKG i32)
			(const ENOTNAM i32)
			(const ENOTUNIQ i32)
			(const EREMCHG i32)
			(const EREMOTEIO i32)
			(const ERESTART i32)
			(const ERFKILL i32)
			(const ESRMNT i32)
			(const ESTRPIPE i32)
			(const EUCLEAN i32)
			(const EUNATCH i32)
			(const EXFULL i32))

		(decls
			(:doc "Bind the GNU program names as native string lvalues under the selected header profile.")
			(:expect (tests "stage-2/cli/native/macro-modes.tsv") (issues "gh:wove-lang/wove:532"))
			(:pragma (cfg (os "linux")))
			(let-mut program_invocation_name
				(:doc "Copy the current complete program name on read and retain writable literal storage on assignment.")
				(:pragma (c_static_mut_cstr) (c_snapshot cstr))
				(optional (owned-array u8)))
			(let-mut program_invocation_short_name
				(:doc "Copy the current short program name on read and retain writable literal storage on assignment.")
				(:pragma (c_static_mut_cstr) (c_snapshot cstr))
				(optional (owned-array u8))))))
