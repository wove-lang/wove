(module c_libproc
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<libproc.h>"
		(:doc "Read Darwin process usage into the complete storage selected by the fixed native flavor.")
		(:expect (tests "stage-2/cli/native/resource/optional.tsv" "stage-2/cli/native/resource/profile-cases.tsv") (issues "gh:wove-lang/wove:866"))
		(:pragma (cfg (os "macos")))

		(use c-header "<sys/resource.h>" (only
			(type RusageInfoV0) (type RusageInfoV1) (type RusageInfoV2) (type RusageInfoV3)
			(type RusageInfoV4) (type RusageInfoV5) (type RusageInfoV6) (type RusageInfoCurrent)))

		(fn proc_pid_rusage_v0
			(:doc "Read the complete V0 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V0) (usage (mut-ref RusageInfoV0)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_v1
			(:doc "Read the complete V1 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V1) (usage (mut-ref RusageInfoV1)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_v2
			(:doc "Read the complete V2 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V2) (usage (mut-ref RusageInfoV2)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_v3
			(:doc "Read the complete V3 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V3) (usage (mut-ref RusageInfoV3)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_v4
			(:doc "Read the complete V4 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V4) (usage (mut-ref RusageInfoV4)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_v5
			(:doc "Read the complete V5 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V5) (usage (mut-ref RusageInfoV5)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_v6
			(:doc "Read the complete V6 record and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_V6) (usage (mut-ref RusageInfoV6)))
			(returns i32)
			(c-name "proc_pid_rusage"))

		(fn proc_pid_rusage_current
			(:doc "Read the record selected by this SDK and return native status.")
			(:pragma (c_optional) (c_record_storage usage (c-type "rusage_info_t *")))
			(params (pid i32) (const flavor i32 RUSAGE_INFO_CURRENT) (usage (mut-ref RusageInfoCurrent)))
			(returns i32)
			(c-name "proc_pid_rusage"))))
