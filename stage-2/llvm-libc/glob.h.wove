(module c_glob
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<glob.h>"
		(:doc "Expose glob flags and statuses with the selected SDK's native values.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(const GLOB_ABORTED i32)
		(const GLOB_APPEND i32)
		(const GLOB_DOOFFS i32)
		(const GLOB_ERR i32)
		(const GLOB_MARK i32)
		(const GLOB_NOCHECK i32)
		(const GLOB_NOESCAPE i32)
		(const GLOB_NOMATCH i32)
		(const GLOB_NOSORT i32)
		(const GLOB_NOSPACE i32)
		(const GLOB_NOSYS i32)

		(const (:pragma (c_optional)) GLOB_ABEND i32)
		(const (:pragma (c_optional)) GLOB_ALTDIRFUNC i32)
		(const (:pragma (c_optional)) GLOB_BRACE i32)
		(const (:pragma (c_optional)) GLOB_MAGCHAR i32)
		(const (:pragma (c_optional)) GLOB_NOMAGIC i32)
		(const (:pragma (c_optional)) GLOB_TILDE i32)

		(decls (:pragma (cfg (os "macos")))
			(const (:pragma (c_optional)) GLOB_LIMIT i32)
			(const (:pragma (c_optional)) GLOB_MAXPATH i32)
			(const (:pragma (c_optional)) GLOB_QUOTE i32))

		(decls (:pragma (cfg (os "linux")))
			(const (:pragma (c_optional)) GLOB_ONLYDIR i32)
			(const (:pragma (c_optional)) GLOB_PERIOD i32)
			(const (:pragma (c_optional)) GLOB_TILDE_CHECK i32))

		(fn glob_pattern_p
			(:doc "Use glibc's pattern classifier and pass the caller's quoting option unchanged.")
			(:pragma (cfg (os "linux")) (c_optional) (c_cstr pattern))
			(params (pattern (shared-array u8)) (quote i32))
			(returns i32))

		(disabled
			(:doc "glob_t and glibc glob64_t own gl_pathv, including partial errors. Safe projection of gl_pathc paths past gl_offs and exact globfree cleanup need gh:wove-lang/wove:624. Darwin also exposes gl_matchc and the gl_errfunc and gl_errblk union."))
		(disabled
			(:doc "glob, globfree, glibc glob64, and globfree64 require the native result owner in gh:wove-lang/wove:624. glob and glob64 also require the nullable synchronous error callback in gh:wove-lang/wove:623."))
		(disabled
			(:doc "Darwin glob_b takes a noescape block when Blocks are enabled. The bridge supports C function pointers."))
		(disabled
			(:doc "GLOB_ALTDIRFUNC requires validated gl_closedir, gl_readdir, gl_opendir, gl_lstat, and gl_stat callbacks. Their native pointer and record types vary by SDK and feature profile."))))
