(module c_glob
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<glob.h>"
		(:doc "Expose glob flags and statuses with the selected SDK's native values.")
		(:expect (tests "stage-2/cli/native/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(const GLOB_ABORTED i32)
		(const GLOB_APPEND i32)
		(const GLOB_DOOFFS i32)
		(const GLOB_ERR i32)
		(const GLOB_MARK i32)
		(const GLOB_NOCHECK i32)
		(const GLOB_NOESCAPE i32)
		(const GLOB_NOMATCH i32)
		(const GLOB_NOSORT i32)
		(const GLOB_NOSPACE i32)
		(const GLOB_NOSYS i32)

		(const (:pragma (c_optional)) GLOB_ABEND i32)
		(const (:pragma (c_optional)) GLOB_ALTDIRFUNC i32)
		(const (:pragma (c_optional)) GLOB_BRACE i32)
		(const (:pragma (c_optional)) GLOB_MAGCHAR i32)
		(const (:pragma (c_optional)) GLOB_NOMAGIC i32)
		(const (:pragma (c_optional)) GLOB_TILDE i32)

		(decls (:pragma (cfg (os "macos")))
			(const (:pragma (c_optional)) GLOB_LIMIT i32)
			(const (:pragma (c_optional)) GLOB_MAXPATH i32)
			(const (:pragma (c_optional)) GLOB_QUOTE i32))

		(decls (:pragma (cfg (os "linux")))
			(const (:pragma (c_optional)) GLOB_ONLYDIR i32)
			(const (:pragma (c_optional)) GLOB_PERIOD i32)
			(const (:pragma (c_optional)) GLOB_TILDE_CHECK i32))

		(fn glob_pattern_p
			(:doc "Use glibc's pattern classifier and pass the caller's quoting option unchanged.")
			(:pragma (cfg (os "linux")) (c_optional) (c_cstr pattern))
			(params (pattern (shared-array u8)) (quote i32))
			(returns i32))

		(type
			(:doc "Own the native glob result, including paths returned before an error.")
			(:pragma (c_owned (drop globfree) storage (cstr-vector gl_pathv gl_pathc gl_offs)))
			Glob (c-type "glob_t"))

		(fn glob
			(:doc "Initialize a fresh result with GLOB_APPEND clear. Use native.alloc with an offset for GLOB_DOOFFS.")
			(:pragma (c_cstr pattern) (c_callback_sync report) (c_nullable report) (c_init_always output))
			(params (pattern (shared-array u8)) (flags i32)
				(report (fn-type (params c-cstr i32) (returns i32))) (output (mut-ref Glob)))
			(returns i32))

		(fn glob_append
			(:doc "Pass GLOB_APPEND and keep the existing GLOB_DOOFFS setting when extending a result after its path loans end.")
			(:pragma (c_cstr pattern) (c_callback_sync report) (c_nullable report))
			(params (pattern (shared-array u8)) (flags i32)
				(report (fn-type (params c-cstr i32) (returns i32))) (output (mut-ref Glob)))
			(returns i32) (c-name "glob"))

		(fn globfree
			(:doc "Consume the checked result and release any remaining native paths.")
			(params (output Glob)) (returns void))

		(decls (:pragma (cfg (os "linux")))
			(type
				(:doc "Own the separate glibc large-file result when the selected header exposes its typedef.")
				(:pragma (c_optional) (c_owned (drop globfree64) storage (cstr-vector gl_pathv gl_pathc gl_offs)))
				Glob64 (c-type "glob64_t"))

			(fn glob64
				(:doc "Initialize a fresh glibc large-file result with GLOB_APPEND clear.")
				(:pragma (c_optional) (c_cstr pattern) (c_callback_sync report) (c_nullable report) (c_init_always output))
				(params (pattern (shared-array u8)) (flags i32)
					(report (fn-type (params c-cstr i32) (returns i32))) (output (mut-ref Glob64)))
				(returns i32))

			(fn glob64_append
				(:doc "Use GLOB_APPEND to extend the large-file result after its path loans end.")
				(:pragma (c_optional) (c_cstr pattern) (c_callback_sync report) (c_nullable report))
				(params (pattern (shared-array u8)) (flags i32)
					(report (fn-type (params c-cstr i32) (returns i32))) (output (mut-ref Glob64)))
				(returns i32) (c-name "glob64"))

			(fn globfree64
				(:doc "Consume the glibc large-file result with its own native destructor.")
				(:pragma (c_optional))
				(params (output Glob64)) (returns void)))

		(disabled
			(:doc "Reading gl_flags and Darwin gl_matchc needs scalar projections from active native storage. Darwin GLOB_LIMIT uses the SDK default path limit until the bridge can initialize gl_matchc."))

		(disabled
			(:doc "Darwin glob_b takes a noescape block when Blocks are enabled. The SDK manages the gl_errfunc and gl_errblk union during the call. Wove lends synchronous C function pointers."))
		(disabled
			(:doc "Use glob and glob64 without GLOB_ALTDIRFUNC. Alternate directory functions require validated gl_closedir, gl_readdir, gl_opendir, gl_lstat, and gl_stat callbacks. Their native pointer and record types vary by SDK and feature profile."))))
