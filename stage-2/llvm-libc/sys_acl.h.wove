(module c_sys_acl
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<sys/acl.h>"
		(:doc "Darwin owns native access control lists through the exact acl_t pointer.")
		(:pragma (cfg (os "macos")))
		(type Acl (:pragma (c_owned (drop acl_free void-pointer))) (c-type "acl_t"))

		(fn acl_init
			(:doc "Allocate an owned empty ACL with room for the requested entries.")
			(params (count i32))
			(returns Acl))

		(fn acl_valid
			(:doc "Check a borrowed native ACL and preserve the native status.")
			(params (acl (shared-ref Acl)))
			(returns i32))))
