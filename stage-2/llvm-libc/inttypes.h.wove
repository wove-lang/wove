		(const PRIdMAX (shared-array u8))
		(const PRIiMAX (shared-array u8))
		(const PRIoMAX (shared-array u8))
		(const PRIuMAX (shared-array u8))
		(const PRIxMAX (shared-array u8))
		(const PRIXMAX (shared-array u8))

		(disabled
			(:doc `strtoimax, strtoumax, wcstoimax, and wcstoumax remain for separate
			coverage of narrow or wide input and an end pointer tied to that input.`))

		(disabled
			(:doc `The binary PRI formats and SCN scanning formats remain for
			separate member-level coverage.
			The audited Darwin and glibc headers omit __STDC_VERSION_INTTYPES_H__.`))))
