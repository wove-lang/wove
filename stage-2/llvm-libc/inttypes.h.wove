(module c_inttypes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<inttypes.h>"
		(:doc "Bind maximum-width integer operations and native integer format strings.")
		(:expect (tests "stage-2/cli/native/inttypes/cases.tsv" "stage-2/cli/native/inttypes-print/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(use c-header "<stdint.h>" (only (type IntMax)))

		(struct Division
			(:doc "The native quotient and remainder in their original intmax_t fields.")
			(c-type "imaxdiv_t")
			(fields (quot IntMax) (rem IntMax)))

		(fn imaxabs
			(:doc "Return the magnitude of a value whose magnitude is representable as intmax_t.")
			(params (value IntMax))
			(returns IntMax))

		(fn imaxdiv
			(:doc "Divide with a nonzero denominator and a representable quotient, truncating toward zero.")
			(:expect (issues "gh:wove-lang/wove:731"))
			(params (numerator IntMax) (denominator IntMax))
			(returns Division))

		(const PRId8 (shared-array u8))
		(const PRIi8 (shared-array u8))
		(const PRIo8 (shared-array u8))
		(const PRIu8 (shared-array u8))
		(const PRIx8 (shared-array u8))
		(const PRIX8 (shared-array u8))

		(const PRId16 (shared-array u8))
		(const PRIi16 (shared-array u8))
		(const PRIo16 (shared-array u8))
		(const PRIu16 (shared-array u8))
		(const PRIx16 (shared-array u8))
		(const PRIX16 (shared-array u8))

		(const PRId32 (shared-array u8))
		(const PRIi32 (shared-array u8))
		(const PRIo32 (shared-array u8))
		(const PRIu32 (shared-array u8))
		(const PRIx32 (shared-array u8))
		(const PRIX32 (shared-array u8))

		(const PRId64 (shared-array u8))
		(const PRIi64 (shared-array u8))
		(const PRIo64 (shared-array u8))
		(const PRIu64 (shared-array u8))
		(const PRIx64 (shared-array u8))
		(const PRIX64 (shared-array u8))

		(const PRIdLEAST8 (shared-array u8))
		(const PRIiLEAST8 (shared-array u8))
		(const PRIoLEAST8 (shared-array u8))
		(const PRIuLEAST8 (shared-array u8))
		(const PRIxLEAST8 (shared-array u8))
		(const PRIXLEAST8 (shared-array u8))

		(const PRIdLEAST16 (shared-array u8))
		(const PRIiLEAST16 (shared-array u8))
		(const PRIoLEAST16 (shared-array u8))
		(const PRIuLEAST16 (shared-array u8))
		(const PRIxLEAST16 (shared-array u8))
		(const PRIXLEAST16 (shared-array u8))

		(const PRIdLEAST32 (shared-array u8))
		(const PRIiLEAST32 (shared-array u8))
		(const PRIoLEAST32 (shared-array u8))
		(const PRIuLEAST32 (shared-array u8))
		(const PRIxLEAST32 (shared-array u8))
		(const PRIXLEAST32 (shared-array u8))

		(const PRIdLEAST64 (shared-array u8))
		(const PRIiLEAST64 (shared-array u8))
		(const PRIoLEAST64 (shared-array u8))
		(const PRIuLEAST64 (shared-array u8))
		(const PRIxLEAST64 (shared-array u8))
		(const PRIXLEAST64 (shared-array u8))

		(const PRIdFAST8 (shared-array u8))
		(const PRIiFAST8 (shared-array u8))
		(const PRIoFAST8 (shared-array u8))
		(const PRIuFAST8 (shared-array u8))
		(const PRIxFAST8 (shared-array u8))
		(const PRIXFAST8 (shared-array u8))

		(const PRIdFAST16 (shared-array u8))
		(const PRIiFAST16 (shared-array u8))
		(const PRIoFAST16 (shared-array u8))
		(const PRIuFAST16 (shared-array u8))
		(const PRIxFAST16 (shared-array u8))
