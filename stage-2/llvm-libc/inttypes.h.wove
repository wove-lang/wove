(module c_inttypes
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")

	(bridge c-header "<inttypes.h>"
		(:doc "Bind maximum-width integer operations using the defining stdint types.")
		(:expect (tests "stage-2/cli/native/inttypes/cases.tsv") (issues "gh:wove-lang/wove:318"))

		(use c-header "<stdint.h>" (only (type IntMax)))

		(struct Division
			(:doc "The native quotient and remainder in their original intmax_t fields.")
			(c-type "imaxdiv_t")
			(fields (quot IntMax) (rem IntMax)))

		(fn imaxabs
			(:doc "Return the magnitude of a value whose magnitude is representable as intmax_t.")
			(params (value IntMax))
			(returns IntMax))

		(fn imaxdiv
			(:doc "Divide with a nonzero denominator and a representable quotient, truncating toward zero.")
			(:expect (issues "gh:wove-lang/wove:731"))
			(params (numerator IntMax) (denominator IntMax))
			(returns Division))

		(disabled
			(:doc `strtoimax, strtoumax, wcstoimax, and wcstoumax remain for separate
			coverage of narrow or wide input and an end pointer tied to that input.`))

		(disabled
			(:doc `The PRI and SCN format string families remain for member-level
			coverage of their target-specific C strings and binary formats.
			The audited Darwin and glibc headers omit __STDC_VERSION_INTTYPES_H__.`))))
