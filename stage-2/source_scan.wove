						(if (u32.eq (record.get (local child) kind) (u32 40))
							(then
								(let child_head_index (call significant_source_node (borrow-shared (local nodes))
									(record.get (local child) first_child)))
								(let head (slice.load (local nodes) (local child_head_index)))
								(let-mut name_start (record.get (local head) start))
								(let first (slice.load (local source) (local name_start)))
								;; The colon belongs to the entry tag, outside its identifier spelling.
								(if (u8.eq (local first) (u8 58))
									(then
										;; Confirm that this direct sibling list is the wrapper's meta operand.
										(if (bool.not (local attached))
											(then
												;; A colon elsewhere cannot designate a metadata entry.
												(if (bool.not (call is_attached_meta
														(borrow-shared (local source)) (borrow-shared (local nodes))
														(local index) (local container)))
													(then (return (call source_node_failure (u32 13) (local head)))))
												(set (local attached) (bool true))))
										(set (local name_start) (i32.add.wrapping (local name_start) (i32 1)))))
								;; Report the complete head atom when its identifier spelling is invalid.
								(if (bool.not (call is_identifier_head (borrow-shared (local source))
										(local name_start) (record.get (local head) end)))
									(then (return (call source_node_failure (u32 12) (local head)))))))
						(set (local child_index) (call significant_source_node (borrow-shared (local nodes))
							(record.get (local child) next_sibling)))))
				(return (local checked)))))

	(with-meta
		(meta
			(:doc "Validate the built tree's heads and metadata attachment while preserving every source row.")
			(:expect parser.metadata_structure
				(issue "https://github.com/wove-lang/wove/issues/46")))
		(fn check_source_metadata
			(params (source (shared-slice u8)) (checked FormCheck) (nodes (shared-slice SourceNode)))
			(returns FormCheck)
			(body
				;; Failed tree construction keeps its original diagnostic.
				(if (u32.lt (u32 0) (record.get (local checked) error))
					(then (return (local checked))))
				(let count (int.convert i32 (record.get (local checked) rows)))
				(let-mut index (i32 0))
				;; Each container owns a sibling list and checks its heads once.
				(while (i32.lt (local index) (local count))
					(body
						(let node (slice.load (local nodes) (local index)))
						(let kind (record.get (local node) kind))
						;; The synthetic root and parenthesized forms are the only containers.
						(if (bool.or (u32.eq (local kind) (u32 0)) (u32.eq (local kind) (u32 40)))
							(then
								(let result (call check_metadata_container
									(borrow-shared (local source)) (borrow-shared (local nodes))
									(local index) (local node) (local checked)))
								;; Leave the rows intact and return the originating diagnostic.
								(if (u32.lt (u32 0) (record.get (local result) error))
									(then (return (local result))))))
						(set (local index) (i32.add.wrapping (local index) (i32 1)))))
				(return (local checked)))))

	(with-meta
		(meta (:doc "Supply the seed entry point while the fixture provides input slices."))
		(fn main
			(params)
			(returns i32)
			(body
				(return (i32 0))))))
