(module source_scan
	(struct Token (fields (kind u32) (start i32) (end i32) (error u32)))
	(struct SourceDiagnostic (fields (error u32) (start i32) (end i32)))
	(struct SourcePosition (fields (line u32) (column u32)))

	;; Match the seed's ASCII separators, U+0009–U+000D and U+001C–U+0020.
	(fn is_ascii_whitespace
		(params (byte u8))
		(returns bool)
		(body
			;; Test the two half-open ranges directly in the raw bytes.
			(return (bool.or
				(bool.and (bool.not (u8.lt (local byte) (u8 9))) (u8.lt (local byte) (u8 14)))
				(bool.and (bool.not (u8.lt (local byte) (u8 28))) (u8.lt (local byte) (u8 33)))))))

	;; Parentheses are both atom boundaries and one-byte tokens.
	(fn is_parenthesis
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 40)) (u8.eq (local byte) (u8 41))))))

	;; Leave comment markers and quote delimiters for their own token scan.
	(fn is_semicolon_or_quote
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 59)) (u8.eq (local byte) (u8 34))))))

	;; Resume at the supplied cursor and leave the first non-whitespace byte unconsumed.
	(fn skip_whitespace
		(params (source (shared-slice u8)) (start i32))
		(returns i32)
		(body
			(let end (slice.len (local source)))
			(let-mut cursor (local start))
			;; The end cursor needs no byte load.
			(while (i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(let width (call whitespace_width (borrow-shared (local source)) (local cursor) (local byte)))
					;; Preserve the offset of the first byte that can start a token.
					(if (i32.eq (local width) (i32 0))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (local width)))))
			(return (local cursor))))

	;; Find the first significant byte or the end of this view.
	(fn source_offset
		(params (source (shared-slice u8)))
		(returns i32)
		(body
			(return (call skip_whitespace (borrow-shared (local source)) (i32 0)))))

	(with-meta
		(meta
			(:expect bootstrap.scan_source_byte
				(issue "https://github.com/wove-lang/wove/issues/13")))
		;; Classify the first significant byte for callers that only need its original byte kind.
		(fn source_kind
			(params (source (shared-slice u8)))
			(returns u32)
			(body
				(let offset (call source_offset (borrow-shared (local source))))
				;; Return the EOF kind before another load can reach the end of the view.
				(if (i32.eq (local offset) (slice.len (local source)))
					(then (return (u32 0))))
				(let byte (slice.load (local source) (local offset)))
				;; Preserve either parenthesis byte code as the kind.
				(if (call is_parenthesis (local byte))
					(then (return (int.convert u32 (local byte)))))
				(return (u32 1)))))

	;; Find the exclusive end of an atom whose first byte has already been accepted.
	(fn bare_atom_end
		(params (source (shared-slice u8)) (next i32))
		(returns i32)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (local next))
			;; The view can end immediately after the last atom byte.
			(while (i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local source) (local cursor)))
					;; Stop before the first byte of any separator or token delimiter.
					(if (bool.or
							(bool.or
								(call is_parenthesis (local byte))
								(call is_semicolon_or_quote (local byte)))
							(i32.lt (i32 0)
								(call whitespace_width (borrow-shared (local source)) (local cursor) (local byte))))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (local cursor))))

	;; Keep line comments bounded by physical CR and LF bytes.
	(fn is_line_ending
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.or (u8.eq (local byte) (u8 13)) (u8.eq (local byte) (u8 10))))))

	;; Scan comment text from just past the opening semicolons.
	(fn line_comment_end
		(params (source (shared-slice u8)) (text_start i32))
		(returns i32)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (local text_start))
			;; A comment can run to the end of the view, even with no text.
			(while (i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local source) (local cursor)))
					;; Leave the line ending outside the raw span for whitespace scanning.
					(if (call is_line_ending (local byte))
						(then (return (local cursor))))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))))
			(return (local cursor))))

	;; Recognize the JSON short escapes after their opening backslash.
	(fn is_short_escape
		(params (byte u8))
		(returns bool)
		(body
			;; Accept escaped punctuation and the five named control characters.
			(return (bool.or
				(bool.or
					(u8.eq (local byte) (u8 34))
					(bool.or (u8.eq (local byte) (u8 92)) (u8.eq (local byte) (u8 47))))
				(bool.or
					(bool.or (u8.eq (local byte) (u8 98)) (u8.eq (local byte) (u8 102)))
					(bool.or
						(u8.eq (local byte) (u8 110))
						(bool.or (u8.eq (local byte) (u8 114)) (u8.eq (local byte) (u8 116)))))))))

	;; Accept ASCII digits and both cases of A through F in Unicode escapes.
	(fn is_hex_digit
		(params (byte u8))
		(returns bool)
		(body
			;; Use half-open byte ranges for decimal, uppercase, and lowercase digits.
			(return (bool.or
				(bool.and (bool.not (u8.lt (local byte) (u8 48))) (u8.lt (local byte) (u8 58)))
				(bool.or
					(bool.and (bool.not (u8.lt (local byte) (u8 65))) (u8.lt (local byte) (u8 71)))
					(bool.and (bool.not (u8.lt (local byte) (u8 97))) (u8.lt (local byte) (u8 103))))))))

	;; Keep the raw extent of a lexical error for the caller.
	(fn lexical_error
		(params (code u32) (start i32) (end i32))
		(returns Token)
		(body
			(return (record.make Token
				(kind (u32 3)) (error (local code)) (start (local start)) (end (local end))))))

	;; Validate quoted bytes while preserving the full spelling for the parser.
	(fn scan_quoted
		(params (source (shared-slice u8)) (start i32))
		(returns Token)
		(body
			(let length (slice.len (local source)))
			(let-mut cursor (i32.add.wrapping (local start) (i32 1)))
			;; Read only bytes inside the supplied view, including while scanning escapes.
			(while (i32.lt (local cursor) (local length))
				(body
					(let byte (slice.load (local source) (local cursor)))
					(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
					;; An unescaped quote completes the span just after the closing byte.
					(if (u8.eq (local byte) (u8 34))
						(then
							(return (record.make Token (kind (u32 2)) (error (u32 0)) (start (local start)) (end (local cursor))))))
					;; Raw ASCII control bytes end the error span just after the offending byte.
					(if (u8.lt (local byte) (u8 32))
						(then (return (call lexical_error (u32 4) (local start) (local cursor)))))
					;; A backslash consumes its escape bytes before the next quote check.
					(if (u8.eq (local byte) (u8 92))
						(then
							;; A trailing backslash reaches the view end without an escape byte.
							(if (i32.eq (local cursor) (local length))
								(then (return (call lexical_error (u32 3) (local start) (local length)))))
							(let escape (slice.load (local source) (local cursor)))
							(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
							;; A Unicode escape must supply exactly four hex digits.
							(if (u8.eq (local escape) (u8 117))
								(then
									(let-mut digits (i32 0))
									;; Check each digit before advancing to the next byte.
									(while (i32.lt (local digits) (i32 4))
										(body
											;; A clipped escape reports the view end.
											(if (i32.eq (local cursor) (local length))
												(then (return (call lexical_error (u32 3) (local start) (local length)))))
											(let digit (slice.load (local source) (local cursor)))
											(set (local cursor) (i32.add.wrapping (local cursor) (i32 1)))
											;; Include the first invalid digit in the error span.
											(if (bool.not (call is_hex_digit (local digit)))
												(then (return (call lexical_error (u32 3) (local start) (local cursor)))))
											(set (local digits) (i32.add.wrapping (local digits) (i32 1))))))
								(else
									;; Every other escape must belong to the short escape set.
									(if (bool.not (call is_short_escape (local escape)))
										(then (return (call lexical_error (u32 3) (local start) (local cursor)))))))))))
			(return (call lexical_error (u32 2) (local start) (local length)))))

	(with-meta
		(meta
			(:expect lexer.token_span
				(issue "https://github.com/wove-lang/wove/issues/29"))
			(:expect lexer.line_comment
				(issue "https://github.com/wove-lang/wove/issues/30"))
			(:expect lexer.quoted_string
				(issue "https://github.com/wove-lang/wove/issues/31"))
			(:expect lexer.unicode_whitespace
				(issue "https://github.com/wove-lang/wove/issues/33"))
			(:expect lexer.stream_parity
				(issue "https://github.com/wove-lang/wove/issues/34")))
		;; Scan one raw token in a view already checked by admit_source.
		(fn scan_token
			(params (source (shared-slice u8)) (cursor i32))
			(returns Token)
			(body
				(let start (call skip_whitespace (borrow-shared (local source)) (local cursor)))
				(let length (slice.len (local source)))
				;; Only the exact end cursor can return EOF without another checked load.
				(if (i32.eq (local start) (local length))
					(then
						(return (record.make Token (kind (u32 0)) (error (u32 0)) (start (local start)) (end (local start))))))
				(let byte (slice.load (local source) (local start)))
				(let next (i32.add.wrapping (local start) (i32 1)))
				;; Parentheses consume one byte and use their byte code as the token kind.
				(if (call is_parenthesis (local byte))
					(then
						(return (record.make Token
							(kind (int.convert u32 (local byte)))
							(error (u32 0))
							(start (local start))
							(end (local next))))))
				;; Recognize a comment opener only when both semicolons are inside this view.
				(if (bool.and
						(u8.eq (local byte) (u8 59))
						(bool.and
							(i32.lt (local next) (local length))
							(u8.eq (slice.load (local source) (local next)) (u8 59))))
					(then
						(let text_start (i32.add.wrapping (local next) (i32 1)))
						(let end (call line_comment_end (borrow-shared (local source)) (local text_start)))
						(return (record.make Token (kind (u32 59)) (error (u32 0)) (start (local start)) (end (local end))))))
				;; The opening quote selects the string scanner before interpreting any content.
				(if (u8.eq (local byte) (u8 34))
					(then (return (call scan_quoted (borrow-shared (local source)) (local start)))))
				;; A semicolon that did not open a comment is a one-byte error.
				(if (u8.eq (local byte) (u8 59))
					(then (return (call lexical_error (u32 1) (local start) (local next)))))
				(let end (call bare_atom_end (borrow-shared (local source)) (local next)))
				(return (record.make Token (kind (u32 1)) (error (u32 0)) (start (local start)) (end (local end)))))))

	;; Classify an ASCII byte or a legal lead byte by the width of its scalar.
	(fn utf8_width
		(params (lead u8))
		(returns i32)
		(body
			;; ASCII scalars occupy a single byte.
			(if (u8.lt (local lead) (u8 128))
				(then (return (i32 1))))
			;; Continuations and the overlong two-byte prefixes cannot start a scalar.
			(if (u8.lt (local lead) (u8 194))
				(then (return (i32 0))))
			;; C2 through DF are the legal two-byte leads.
			(if (u8.lt (local lead) (u8 224))
				(then (return (i32 2))))
			;; E0 through EF start three-byte scalars.
			(if (u8.lt (local lead) (u8 240))
				(then (return (i32 3))))
			;; F4 is the last lead that can encode a Unicode scalar.
			(if (u8.lt (local lead) (u8 245))
				(then (return (i32 4))))
			(return (i32 0))))

	;; A continuation byte has prefix 10 in binary.
	(fn is_utf8_continuation
		(params (byte u8))
		(returns bool)
		(body
			(return (bool.and (bool.not (u8.lt (local byte) (u8 128))) (u8.lt (local byte) (u8 192))))))

	;; Apply the extra restrictions on the first continuation byte.
	(fn valid_utf8_second
		(params (lead u8) (second u8))
		(returns bool)
		(body
			;; Every multibyte scalar needs a continuation at this position.
			(if (bool.not (call is_utf8_continuation (local second)))
				(then (return (bool false))))
			;; E0 requires a high second byte to avoid a three-byte overlong form.
			(if (u8.eq (local lead) (u8 224))
				(then (return (bool.not (u8.lt (local second) (u8 160))))))
			;; ED must stop below the surrogate range.
			(if (u8.eq (local lead) (u8 237))
				(then (return (u8.lt (local second) (u8 160)))))
			;; F0 requires a high second byte to avoid a four-byte overlong form.
			(if (u8.eq (local lead) (u8 240))
				(then (return (bool.not (u8.lt (local second) (u8 144))))))
			;; F4 must stop at U+10FFFF.
			(if (u8.eq (local lead) (u8 244))
				(then (return (u8.lt (local second) (u8 144)))))
			(return (bool true))))

	(with-meta
		(meta
			(:expect lexer.utf8_admission
				(issue "https://github.com/wove-lang/wove/issues/32")))
		;; Admit a source once before tokenization and report the start of its first malformed sequence.
		(fn admit_source
			(params (source (shared-slice u8)))
			(returns i32)
			(body
				(let length (slice.len (local source)))
				(let-mut cursor (i32 0))
				;; Keep the cursor at the lead until the whole scalar has been checked.
				(while (i32.lt (local cursor) (local length))
					(body
						(let lead (slice.load (local source) (local cursor)))
						(let width (call valid_utf8_width (borrow-shared (local source)) (local cursor) (local lead)))
						;; Admission reports the lead of the first invalid sequence.
						(if (i32.eq (local width) (i32 0))
							(then (return (local cursor))))
						(set (local cursor) (i32.add.wrapping (local cursor) (local width)))))
				(return (i32 -1)))))

	;; Return the byte width of a seed separator at the cursor, or zero.
	(fn whitespace_width
		(params (source (shared-slice u8)) (cursor i32) (lead u8))
		(returns i32)
		(body
			;; ASCII uses the seed's two contiguous separator ranges.
			(if (u8.lt (local lead) (u8 128))
				(then
					;; Return a single-byte width for either ASCII range.
					(if (call is_ascii_whitespace (local lead))
						(then (return (i32 1))))
					(return (i32 0))))
			(let remaining (i32.sub.wrapping (slice.len (local source)) (local cursor)))
			;; U+0085 and U+00A0 are the only two-byte separators.
			(if (u8.eq (local lead) (u8 194))
				(then
					;; Keep the second-byte load inside this view.
					(if (i32.lt (local remaining) (i32 2))
						(then (return (i32 0))))
					(let second (slice.load (local source) (i32.add.wrapping (local cursor) (i32 1))))
					;; The C2 prefix has two accepted suffixes.
					(if (bool.or (u8.eq (local second) (u8 133)) (u8.eq (local second) (u8 160)))
						(then (return (i32 2))))
					(return (i32 0))))
			;; Three-byte separators start with E1, E2, or E3 and need both suffix bytes.
			(if (bool.or
					(i32.lt (local remaining) (i32 3))
					(bool.or (u8.lt (local lead) (u8 225)) (u8.lt (u8 227) (local lead))))
				(then (return (i32 0))))
			(let second (slice.load (local source) (i32.add.wrapping (local cursor) (i32 1))))
			(let third (slice.load (local source) (i32.add.wrapping (local cursor) (i32 2))))
			;; E1 9A 80 is U+1680.
			(if (u8.eq (local lead) (u8 225))
				(then
					;; U+1680 occupies all three bytes.
					(if (bool.and (u8.eq (local second) (u8 154)) (u8.eq (local third) (u8 128)))
						(then (return (i32 3))))
					(return (i32 0))))
			;; E3 80 80 is U+3000.
			(if (u8.eq (local lead) (u8 227))
				(then
					;; The E3 prefix has one accepted suffix.
					(if (bool.and (u8.eq (local second) (u8 128)) (u8.eq (local third) (u8 128)))
						(then (return (i32 3))))
					(return (i32 0))))
			;; E2 81 9F is U+205F.
			(if (bool.and (u8.eq (local second) (u8 129)) (u8.eq (local third) (u8 159)))
				(then (return (i32 3))))
			;; E2 80 covers U+2000 through U+200A, U+2028, U+2029, and U+202F.
			(if (bool.and
					(u8.eq (local second) (u8 128))
					(bool.or
						(bool.and (bool.not (u8.lt (local third) (u8 128))) (u8.lt (local third) (u8 139)))
						(bool.or
							(bool.or (u8.eq (local third) (u8 168)) (u8.eq (local third) (u8 169)))
							(u8.eq (local third) (u8 175)))))
				(then (return (i32 3))))
			(return (i32 0))))

	;; Expose admission failures in the same diagnostic code space as lexical errors.
	(fn source_diagnostic
		(params (source (shared-slice u8)))
		(returns SourceDiagnostic)
		(body
			(let start (call admit_source (borrow-shared (local source))))
			;; Successful admission carries no primary span.
			(if (i32.lt (local start) (i32 0))
				(then
					(return (record.make SourceDiagnostic (error (u32 0)) (start (i32 0)) (end (i32 0))))))
			;; Anchor malformed UTF-8 at its lead byte, even when the sequence is clipped.
			(let end (i32.add.wrapping (local start) (i32 1)))
			(return (record.make SourceDiagnostic (error (u32 5)) (start (local start)) (end (local end))))))

	;; Map a view-relative span start to its coordinates in the parent source.
	(fn source_position
		(params (parent (shared-slice u8)) (view_start i32) (span_start i32))
		(returns SourcePosition)
		(body
			(let target (i32.add.wrapping (local view_start) (local span_start)))
			(let-mut cursor (i32 0))
			(let-mut line (u32 1))
			(let-mut column (u32 1))
			(let-mut previous_cr (bool false))
			;; Only bytes before the requested start can advance its coordinates.
			(while (i32.lt (local cursor) (local target))
				(body
					(let byte (slice.load (local parent) (local cursor)))
					;; Count each physical line break once, including a CRLF pair.
					(if (call is_line_ending (local byte))
						(then
							;; An LF paired with the previous CR continues the same break.
							(if (bool.or (u8.eq (local byte) (u8 13)) (bool.not (local previous_cr)))
								(then (set (local line) (u32.add.wrapping (local line) (u32 1)))))
							(set (local column) (u32 1))
							(set (local cursor) (i32.add.wrapping (local cursor) (i32 1))))
						(else
							(let-mut width (call valid_utf8_width (borrow-shared (local parent)) (local cursor) (local byte)))
							;; Count malformed bytes individually to preserve subsequent line breaks.
							(if (i32.eq (local width) (i32 0))
								(then (set (local width) (i32 1))))
							(let remaining (i32.sub.wrapping (local target) (local cursor)))
							;; An offset inside a scalar still belongs to that scalar's column.
							(if (i32.lt (local remaining) (local width))
								(then (set (local cursor) (local target)))
								(else
									(set (local column) (u32.add.wrapping (local column) (u32 1)))
									(set (local cursor) (i32.add.wrapping (local cursor) (local width)))))))
					(set (local previous_cr) (u8.eq (local byte) (u8 13)))))
			(return (record.make SourcePosition (line (local line)) (column (local column))))))

	;; Return the complete UTF-8 scalar width or zero for a malformed sequence.
	(fn valid_utf8_width
		(params (source (shared-slice u8)) (cursor i32) (lead u8))
		(returns i32)
		(body
			(let width (call utf8_width (local lead)))
			(let remaining (i32.sub.wrapping (slice.len (local source)) (local cursor)))
			;; Reject truncation before adding the width or reading any suffix bytes.
			(if (bool.or (i32.eq (local width) (i32 0)) (i32.lt (local remaining) (local width)))
				(then (return (i32 0))))
			;; ASCII needs no continuation loads.
			(if (i32.eq (local width) (i32 1))
				(then (return (i32 1))))
			(let second_index (i32.add.wrapping (local cursor) (i32 1)))
			(let second (slice.load (local source) (local second_index)))
			;; Apply the lead-specific lower and upper bounds on the second byte.
			(if (bool.not (call valid_utf8_second (local lead) (local second)))
				(then (return (i32 0))))
			(let end (i32.add.wrapping (local cursor) (local width)))
			(let-mut tail (i32.add.wrapping (local second_index) (i32 1)))
			;; Check each remaining continuation within the verified span.
			(while (i32.lt (local tail) (local end))
				(body
					(let byte (slice.load (local source) (local tail)))
					;; Reject the whole scalar if a tail byte is not a continuation.
					(if (bool.not (call is_utf8_continuation (local byte)))
						(then (return (i32 0))))
					(set (local tail) (i32.add.wrapping (local tail) (i32 1)))))
			(return (local width))))

	;; Supply the seed entry point while the fixture provides input slices.
	(fn main
		(params)
		(returns i32)
		(body
			(return (i32 0)))))
