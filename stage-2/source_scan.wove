(module source_scan
	;; Recognize the four ASCII bytes skipped between serialized forms.
	(fn is_whitespace
		(params (byte u8))
		(returns bool)
		(body
			;; Skip ordinary spaces between forms.
			(if (u8.eq (local byte) (u8 32))
				(then (return (bool true))))
			;; Accept ASCII tabs as separators.
			(if (u8.eq (local byte) (u8 9))
				(then (return (bool true))))
			;; Treat carriage returns as whitespace in serialized forms.
			(if (u8.eq (local byte) (u8 13))
				(then (return (bool true))))
			(return (u8.eq (local byte) (u8 10)))))

	;; Find the first significant byte or the end of this view.
	(fn source_offset
		(params (source (shared-slice u8)))
		(returns i32)
		(body
			(let end (slice.len (local source)))
			(let-mut cursor (i32 0))
			;; Bound every byte load by the length of the source view.
			(while (i32.lt (local cursor) (local end))
				(body
					(let byte (slice.load (local source) (local cursor)))
					;; Advance past whitespace until the cursor marks a significant byte.
					(if (call is_whitespace (local byte))
						(then
							(set (local cursor) (i32.add.wrapping (local cursor) (i32 1))))
						(else
							(return (local cursor))))))
			(return (local end))))

	;; Classify the first significant byte for the serialized AST scanner.
	(fn source_kind
		(params (source (shared-slice u8)))
		(returns u32)
		(expect bootstrap.scan_source_byte
			(issue "https://github.com/wove-lang/wove/issues/13"))
		(body
			(let offset (call source_offset (borrow-shared (local source))))
			;; Return the EOF kind before another load can reach the end of the view.
			(if (i32.eq (local offset) (slice.len (local source)))
				(then (return (u32 0))))
			(let byte (slice.load (local source) (local offset)))
			;; Preserve the opening parenthesis code for the parser.
			(if (u8.eq (local byte) (u8 40))
				(then (return (u32 40))))
			;; Preserve the closing parenthesis code for the parser.
			(if (u8.eq (local byte) (u8 41))
				(then (return (u32 41))))
			(return (u32 1))))

	;; Supply the seed entry point while the fixture provides input slices.
	(fn main
		(params)
		(returns i32)
		(body
			(return (i32 0)))))
