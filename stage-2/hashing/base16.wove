(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Supply the lowercase ASCII Base16 alphabet.")
	base16

	(fn
		(:doc "Return the digit byte for a nibble from 0 through 15.")
		(:expect
			(tests "stage-2/hashing/base16.wove")
			(issues "gh:wove-lang/wove:171"))
		base16_digit
		(params (nibble u32))
		(returns u8)
		(body
			(if
				(:doc "Values below ten start at ASCII 0. The remaining values start at ASCII a.")
				(u32.lt (local nibble) (u32 10))
				(then (return (int.convert u8 (u32.add.wrapping (u32 48) (local nibble))))))
			(return (int.convert u8 (u32.add.wrapping (u32 87) (local nibble)))))))
