(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Supply the lowercase ASCII Base16 alphabet.")
	base16

	(use wove-file "./digits.wove" (only lowercase_ascii_digit))

	(fn
		(:doc "Return the digit byte for a nibble from 0 through 15.")
		(:expect
			(tests "stage-2/hashing/base16.wove")
			(issues "gh:wove-lang/wove:171"))
		base16_digit
		(params (nibble u32))
		(returns u8)
		(body (return (call lowercase_ascii_digit (local nibble))))))
