(module hashing_bits
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Share word bit operations implemented with the seed's unsigned arithmetic.")

	(fn shift_word
		(:doc `Double a word once per shift, using the Python seed's wrapping addition.`)
		(params (value u32) (bits i32))
		(returns u32)
		(body
			(let-mut word (local value))
			(let-mut remaining (local bits))
			(while
				(:doc "Low zero bits replace the high bits discarded by each doubling.")
				(i32.gtz (local remaining))
				(body
					(set (local word) (u32.add (local word) (local word)))
					(set (local remaining) (i32.sub (local remaining) 1i32))))
			(return (local word))))

	(fn top_bit
		(:doc `Read the top bit of an unsigned word with an exact comparison.`)
		(params (word u32))
		(returns u32)
		(body
			(if
				(:doc "The unsigned high half has its most significant bit set.")
				(u32.lt (local word) 2147483648u32)
				(then (return 0u32)))
			(return 1u32))))
