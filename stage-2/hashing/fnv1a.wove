(module fnv1a
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compute standard 32-bit FNV-1a over bytes, spans, and words.

	Start with fnv1a_seed or resume from a previous state. The caller
	supplies separators and chooses component order.`)

	(let fnv1a_seed 0x811c9dc5u32)

	(fn fnv1a_byte
		(:doc "XOR the input byte and multiply by the FNV prime modulo 2^32.")
		(params (hash u32) (byte u8)) (returns u32)
		(body
			(let mixed (u32:xor hash (u32:from-u8 byte)))
			(return (u32:mul mixed 0x01000193u32))))

	(fn fnv1a_span
		(:doc "Hash a half-open byte span in source order, starting from the incoming state.")
		(params (hash u32) (bytes (shared-array u8)) (start i32) (end i32))
		(returns u32)
		(body
			(let-mut state hash)
			(let-mut cursor start)
			(while
				(:doc "Hash only the supplied span. An empty span leaves the state unchanged.")
				(i32:lt cursor end)
				(body
					(set state (call fnv1a_byte state (bytes.get cursor)))
					(set cursor (i32:inc cursor))))
			(return state)))

	(fn fnv1a_u32_le
		(:doc "Hash all four bytes of a word in little-endian order, including zero bytes.")
		(params (hash u32) (word u32))
		(returns u32)
		(body
			(let first (call fnv1a_byte hash (u8:from-u32 (u32:and word 255u32))))
			(let second (call fnv1a_byte first
				(u8:from-u32 (u32:and (u32:shr word 8i32) 255u32))))
			(let third (call fnv1a_byte second
				(u8:from-u32 (u32:and (u32:shr word 16i32) 255u32))))
			(return (call fnv1a_byte third (u8:from-u32 (u32:shr word 24i32)))))))
