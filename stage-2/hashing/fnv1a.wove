(module fnv1a
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compute standard 32-bit FNV-1a for incremental byte input.

	Start with fnv1a_seed, then feed each raw byte to fnv1a_byte.
	The caller supplies any separators.`)

	(let fnv1a_seed 0x811c9dc5u32)

	(fn fnv1a_byte
		(:doc "XOR the input byte and multiply by the FNV prime modulo 2^32.")
		(params (hash u32) (byte u8)) (returns u32)
		(body
			(let mixed (u32:xor hash (u32:from-u8 byte)))
			(return (u32:mul mixed 0x01000193u32)))))
