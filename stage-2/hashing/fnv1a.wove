(module fnv1a
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Compute the archived 31-bit FNV-1a hash for incremental byte input.

	Start with fnv1a_seed, then feed each raw byte to fnv1a_byte.
	Each state fits in 31 bits. The caller supplies any separators.`)

	(let fnv1a_seed 18652613u32)

	(fn fnv1a_byte
		(:doc "Apply the same FNV-1a recurrence using seed-supported bit operations.")
		(params (hash u32) (byte u8)) (returns u32)
		(body
			(let mixed (u32.xor (local hash) (u32.from-u8 (local byte))))
			(let shifted (u32.add (u32.shl (local mixed) 24i32) (u32.shl (local mixed) 8i32)))
			(let low (u32.add (u32.shl (local mixed) 7i32) (u32.shl (local mixed) 4i32)))
			(return (u32.and
				(u32.add (u32.add (local shifted) (local low)) (u32.add (u32.shl (local mixed) 1i32) (local mixed)))
				0x7fffffffu32)))))
