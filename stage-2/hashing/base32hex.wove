(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Encode a 31-bit ID as seven lowercase Base32hex digits.

	Use ASCII 0 through 9 and a through v. The first digit is 0 or 1
	and leading zeroes are retained. Write into caller-provided bytes.`)
	base32hex

	(fn
		(:doc `Return the fixed width in bytes of a 31-bit ID encoding.`)
		base32hex31_width
		(params)
		(returns i32)
		(body (return (i32 7))))

	(fn
		(:doc `Map a value from zero to 31 into the lowercase Base32hex alphabet.`)
		base32hex_digit
		(params (digit u32))
		(returns u8)
		(body
			(if
				(:doc "The first ten values use the decimal digit bytes.")
				(u32.lt (local digit) (u32 10))
				(then (return (int.convert u8 (u32.add.wrapping (u32 48) (local digit))))))
			(return (int.convert u8 (u32.add.wrapping (u32 87) (local digit))))))

	(fn
		(:doc `Write all seven digits at the requested byte offset.

		Return true on success. An out-of-range ID or output span returns
		false and leaves the destination intact.`)
		encode_base32hex31
		(params (identity u32) (output (mut-slice u8)) (start i32))
		(returns bool)
		(body
			(let width (call base32hex31_width))
			(if
				(:doc "Check the complete encoding range and ID domain before the first write.")
				(bool.or (u32.lt (u32 2147483647) (local identity))
					(bool.or (i32.lt (local start) (i32 0))
						(i32.lt (i32.sub.wrapping (slice.len (local output)) (local start)) (local width))))
				(then (return (bool false))))
			(let-mut first (u8 48))
			(if
				(:doc "Only bit 30 contributes to the leading digit of a 31-bit value.")
				(bool.not (u32.lt (local identity) (u32 1073741824)))
				(then (set (local first) (u8 49))))
			(slice.store (local output) (local start) (local first))
			(let twice (u32.add.wrapping (local identity) (local identity)))
			(let-mut word (u32.add.wrapping (local twice) (local twice)))
			(let-mut index (i32.add.wrapping (local start) (i32 1)))
			(let end (i32.add.wrapping (local start) (local width)))
			(while
				(:doc "Consume the remaining thirty bits as six groups of five, most significant first.")
				(i32.lt (local index) (local end))
				(body
					(let-mut digit (u32 0))
					(let-mut bits (i32 5))
					(while
						(:doc "Shift in the high bit and advance the unconsumed part of the word.")
						(i32.lt (i32 0) (local bits))
						(body
							(set (local digit) (u32.add.wrapping (local digit) (local digit)))
							(if
								(:doc "The unsigned upper half has a set high bit.")
								(bool.not (u32.lt (local word) (u32 2147483648)))
								(then (set (local digit) (u32.add.wrapping (local digit) (u32 1)))))
							(set (local word) (u32.add.wrapping (local word) (local word)))
							(set (local bits) (i32.sub.wrapping (local bits) (i32 1)))))
					(slice.store (local output) (local index) (call base32hex_digit (local digit)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(return (bool true)))))
