(module base32hex
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Encode fixed-width IDs and unpadded digests with lowercase Base32hex.`)

	(let base32_alphabet "0123456789abcdefghijklmnopqrstuv")
	(let base32hex32_width 7i32)

	(fn encode_base32hex32
		(:doc `Write all seven digits at the requested byte offset.

		Return true on success. An out-of-range output span returns
		false and leaves the destination intact.`)
		(params (identity u32) (output (mut-array u8)) (start i32))
		(returns bool)
		(body
			(if
				(:doc "Check the complete output span before the first write.")
				(bool:or (i32:ltz start)
					(i32:lt (i32:sub output.len start) base32hex32_width))
				(then (return (bool false))))
			(output.set start
				(base32_alphabet.get (i32:from-u32 (u32:shr identity 30i32))))
			(output.set (i32:inc start)
				(base32_alphabet.get (i32:from-u32 (u32:and (u32:shr identity 25i32) 31u32))))
			(output.set (i32:add start 2i32)
				(base32_alphabet.get (i32:from-u32 (u32:and (u32:shr identity 20i32) 31u32))))
			(output.set (i32:add start 3i32)
				(base32_alphabet.get (i32:from-u32 (u32:and (u32:shr identity 15i32) 31u32))))
			(output.set (i32:add start 4i32)
				(base32_alphabet.get (i32:from-u32 (u32:and (u32:shr identity 10i32) 31u32))))
			(output.set (i32:add start 5i32)
				(base32_alphabet.get (i32:from-u32 (u32:and (u32:shr identity 5i32) 31u32))))
			(output.set (i32:add start 6i32)
				(base32_alphabet.get (i32:from-u32 (u32:and identity 31u32))))
			(return (bool true))))

	(fn digest_base32hex_width
		(:doc "Return the width in bytes of one unpadded 256-bit digest encoding.")
		(params)
		(returns i32)
		(body (return 52i32)))

	(fn digest_base32hex
		(:doc "Encode eight big-endian words as 52 lowercase Base32hex digits.")
		(params (words (array u32 8)))
		(returns (owned-array u8))
		(body
			(let-mut output (array:alloc u8 (call digest_base32hex_width)))
			(let-mut pair 0i32)
			(while
				(:doc "Read ten bits per digit pair, combining adjacent words when the bits straddle a boundary.")
				(i32:lt pair 25i32)
				(body
					(let bit (i32:mul pair 10i32))
					(let word (i32:div bit 32i32))
					(let shift (i32:sub 22i32 (i32:rem bit 32i32)))
					(let limb (words.get word))
					(let-mut window 0u32)
					(if
						(:doc "A negative shift means that the low bits of the pair come from the next word.")
						(i32:ltz shift)
						(then
							(set window (u32:or
								(u32:shl limb (i32:sub 0i32 shift))
								(u32:shr (words.get (i32:inc word))
									(i32:add 32i32 shift)))))
						(else
							(set window (u32:shr limb shift))))
					(let value (u32:and window 1023u32))
					(let index (i32:mul pair 2i32))
					(output.set index
						(base32_alphabet.get (i32:from-u32 (u32:shr value 5i32))))
					(output.set (i32:inc index)
						(base32_alphabet.get (i32:from-u32 (u32:and value 31u32))))
					(set pair (i32:inc pair))))
			(let tail (u32:and (words.get 7i32) 63u32))
			(output.set 50i32
				(base32_alphabet.get (i32:from-u32 (u32:shr tail 1i32))))
			(output.set 51i32
				(base32_alphabet.get (i32:from-u32 (u32:shl (u32:and tail 1u32) 4i32))))
			(return (move output)))))
