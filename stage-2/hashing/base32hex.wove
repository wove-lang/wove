(module base32hex
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Encode fixed-width IDs and unpadded digests with lowercase Base32hex.`)

	(let base32_alphabet "0123456789abcdefghijklmnopqrstuv")
	(let base32hex31_width 7i32)

	(fn encode_base32hex31
		(:doc `Write all seven digits at the requested byte offset.

		Return true on success. An out-of-range ID or output span returns
		false and leaves the destination intact.`)
		(params (identity u32) (output (mut-array u8)) (start i32))
		(returns bool)
		(body
			(if
				(:doc "Check the complete encoding range and ID domain before the first write.")
				(bool.or (u32.lt 2147483647u32 (local identity))
					(bool.or (i32.lt (local start) 0i32)
						(i32.lt (i32.sub (array.len (local output)) (local start))
							(local base32hex31_width))))
				(then (return (bool false))))
			(array.store (local output) (local start)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.shr (local identity) 30i32))))
			(array.store (local output) (i32.add (local start) 1i32)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.and (u32.shr (local identity) 25i32) 31u32))))
			(array.store (local output) (i32.add (local start) 2i32)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.and (u32.shr (local identity) 20i32) 31u32))))
			(array.store (local output) (i32.add (local start) 3i32)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.and (u32.shr (local identity) 15i32) 31u32))))
			(array.store (local output) (i32.add (local start) 4i32)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.and (u32.shr (local identity) 10i32) 31u32))))
			(array.store (local output) (i32.add (local start) 5i32)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.and (u32.shr (local identity) 5i32) 31u32))))
			(array.store (local output) (i32.add (local start) 6i32)
				(array.load (local base32_alphabet) (i32.from-u32 (u32.and (local identity) 31u32))))
			(return (bool true))))

	(fn digest_base32hex_width
		(:doc "Return the width in bytes of one unpadded 256-bit digest encoding.")
		(:pragma (cfg (not bootstrap)))
		(params)
		(returns i32)
		(body (return 52i32)))

	(fn digest_base32hex
		(:doc "Encode eight big-endian words as 52 lowercase Base32hex digits.")
		(:pragma (cfg (not bootstrap)))
		(params (words (array u32 8)))
		(returns (owned-array u8))
		(body
			(let-mut output (array.alloc u8 (call digest_base32hex_width)))
			(let-mut pair 0i32)
			(while
				(:doc "Read ten bits per digit pair, combining adjacent words when the bits straddle a boundary.")
				(i32.lt (local pair) 25i32)
				(body
					(let bit (i32.mul (local pair) 10i32))
					(let word (i32.div (local bit) 32i32))
					(let shift (i32.sub 22i32 (i32.rem (local bit) 32i32)))
					(let limb (array.load (local words) (local word)))
					(let-mut window 0u32)
					(if
						(:doc "A negative shift means that the low bits of the pair come from the next word.")
						(i32.lt (local shift) 0i32)
						(then
							(set (local window) (u32.or
								(u32.shl (local limb) (i32.sub 0i32 (local shift)))
								(u32.shr (array.load (local words) (i32.add (local word) 1i32))
									(i32.add 32i32 (local shift))))))
						(else
							(set (local window) (u32.shr (local limb) (local shift)))))
					(let value (u32.and (local window) 1023u32))
					(let index (i32.mul (local pair) 2i32))
					(array.store (local output) (local index)
						(array.load (local base32_alphabet) (i32.from-u32 (u32.shr (local value) 5i32))))
					(array.store (local output) (i32.add (local index) 1i32)
						(array.load (local base32_alphabet) (i32.from-u32 (u32.and (local value) 31u32))))
					(set (local pair) (i32.add (local pair) 1i32))))
			(let tail (u32.and (array.load (local words) 7i32) 63u32))
			(array.store (local output) 50i32
				(array.load (local base32_alphabet) (i32.from-u32 (u32.shr (local tail) 1i32))))
			(array.store (local output) 51i32
				(array.load (local base32_alphabet) (i32.from-u32 (u32.shl (u32.and (local tail) 1u32) 4i32))))
			(return (move (local output))))))
