(module base32hex_digest
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Encode a 256-bit digest in the archive's uppercase, unpadded Base32hex format.")

	(use wove-file "../digits.wove" (only lowercase_ascii_digit))
	(use wove-file "../bits.wove" (only shift_word))

	(fn digest_base32hex_width
		(:doc "Return the number of bytes written for a 256-bit digest.")
		(params)
		(returns i32)
		(body (return (i32 52))))

	(fn uppercase_digit
		(:doc "Map a value from zero through 31 to the uppercase Base32hex alphabet.")
		(params (digit u32))
		(returns u8)
		(body
			(let byte (call lowercase_ascii_digit (local digit)))
			(if
				(:doc "Decimal digits have the same spelling in both alphabets.")
				(u32.lt (local digit) (u32 10))
				(then (return (local byte))))
			(return (int.convert u8 (u32.sub.wrapping (int.convert u32 (local byte)) (u32 32))))))

	(fn digest_base32hex
		(:doc `Write the Base32hex encoding of exactly 32 bytes in their supplied order.

		Return false with no writes if the input has another length or the
		output has fewer than 52 bytes. Leave any bytes after the digest intact.`)
		(params (bytes (shared-slice u8)) (output (mut-slice u8)))
		(returns bool)
		(body
			(if
				(:doc "Validate both spans before writing any complete groups.")
				(bool.or (bool.not (i32.eq (slice.len (local bytes)) (i32 32)))
					(i32.lt (slice.len (local output)) (call digest_base32hex_width)))
				(then (return (bool false))))
			(let-mut at (i32 0))
			(let-mut written (i32 0))
			(let-mut digit (u32 0))
			(let-mut gathered (i32 0))
			(while
				(:doc "Consume input bytes in order with the most significant bit first.")
				(i32.lt (local at) (i32 32))
				(body
					(let-mut byte (int.convert u32 (slice.load (local bytes) (local at))))
					(let-mut remaining (i32 8))
					(while
						(:doc "Append one bit to the current five-bit digit.")
						(i32.lt (i32 0) (local remaining))
						(body
							(set (local digit) (u32.add.wrapping (local digit) (local digit)))
							(if
								(:doc "Remove the current high bit before shifting the byte left.")
								(bool.not (u32.lt (local byte) (u32 128)))
								(then
									(set (local digit) (u32.add.wrapping (local digit) (u32 1)))
									(set (local byte) (u32.sub.wrapping (local byte) (u32 128)))))
							(set (local byte) (u32.add.wrapping (local byte) (local byte)))
							(set (local gathered) (i32.add.wrapping (local gathered) (i32 1)))
							(if
								(:doc "Emit each complete group before reading the next bit.")
								(i32.eq (local gathered) (i32 5))
								(then
									(slice.store (local output) (local written) (call uppercase_digit (local digit)))
									(set (local written) (i32.add.wrapping (local written) (i32 1)))
									(set (local digit) (u32 0))
									(set (local gathered) (i32 0))))
							(set (local remaining) (i32.sub.wrapping (local remaining) (i32 1)))))
					(set (local at) (i32.add.wrapping (local at) (i32 1)))))
			(slice.store (local output) (local written) (call uppercase_digit (call shift_word (local digit) (i32 4))))
			(return (bool true)))))
