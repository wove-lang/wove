(module blake2b_compress
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Run the twelve RFC 7693 rounds over a BLAKE2b message block.")

	(use wove-file "./word.wove" (only (type Blake2bWord) word word_add word_xor
		word_rotate_32 word_rotate_cross word_rotate_63 split_limb))
	(use wove-file "../bits.wove" (only shift_word))

	(fn blake2b_iv
		(:doc "Return the RFC 7693 initialization word for an index from zero through seven.")
		(params (index i32))
		(returns Blake2bWord)
		(body
			(if (:doc "IV word 0 is 0x6a09e667f3bcc908.") (i32.eq (local index) (i32 0))
				(then (return (call word (u32 4089235720) (u32 1779033703)))))
			(if (:doc "IV word 1 is 0xbb67ae8584caa73b.") (i32.eq (local index) (i32 1))
				(then (return (call word (u32 2227873595) (u32 3144134277)))))
			(if (:doc "IV word 2 is 0x3c6ef372fe94f82b.") (i32.eq (local index) (i32 2))
				(then (return (call word (u32 4271175723) (u32 1013904242)))))
			(if (:doc "IV word 3 is 0xa54ff53a5f1d36f1.") (i32.eq (local index) (i32 3))
				(then (return (call word (u32 1595750129) (u32 2773480762)))))
			(if (:doc "IV word 4 is 0x510e527fade682d1.") (i32.eq (local index) (i32 4))
				(then (return (call word (u32 2917565137) (u32 1359893119)))))
			(if (:doc "IV word 5 is 0x9b05688c2b3e6c1f.") (i32.eq (local index) (i32 5))
				(then (return (call word (u32 725511199) (u32 2600822924)))))
			(if (:doc "IV word 6 is 0x1f83d9abfb41bd6b.") (i32.eq (local index) (i32 6))
				(then (return (call word (u32 4215389547) (u32 528734635)))))
			(return (call word (u32 327033209) (u32 1541459225)))))

	(fn sigma_row
		(:doc `Return a packed SIGMA row with the first message selector in the most significant nibble.

		The high limb supplies the column selectors. The low limb supplies the diagonal selectors.`)
		(params (index i32))
		(returns Blake2bWord)
		(body
			(if (:doc "SIGMA row 0 selects 0123456789abcdef in order.") (i32.eq (local index) (i32 0))
				(then (return (call word (u32 2309737967) (u32 19088743)))))
			(if (:doc "SIGMA row 1 selects ea489fd61c02b753 in order.") (i32.eq (local index) (i32 1))
				(then (return (call word (u32 469940051) (u32 3930628054)))))
			(if (:doc "SIGMA row 2 selects b8c052fdae367194 in order.") (i32.eq (local index) (i32 2))
				(then (return (call word (u32 2922803604) (u32 3099611901)))))
			(if (:doc "SIGMA row 3 selects 7931dcbe265a40f8 in order.") (i32.eq (local index) (i32 3))
				(then (return (call word (u32 643449080) (u32 2033310910)))))
			(if (:doc "SIGMA row 4 selects 905724afe1bc683d in order.") (i32.eq (local index) (i32 4))
				(then (return (call word (u32 3787221053) (u32 2421630127)))))
			(if (:doc "SIGMA row 5 selects 2c6a0b834d75fe19 in order.") (i32.eq (local index) (i32 5))
				(then (return (call word (u32 1299578393) (u32 745147267)))))
			(if (:doc "SIGMA row 6 selects c51fed4a0763928b in order.") (i32.eq (local index) (i32 6))
				(then (return (call word (u32 123966091) (u32 3307203914)))))
			(if (:doc "SIGMA row 7 selects db7ec13950f4862a in order.") (i32.eq (local index) (i32 7))
				(then (return (call word (u32 1358202410) (u32 3682517305)))))
			(if (:doc "SIGMA row 8 selects 6fe9b308c2d714a5 in order.") (i32.eq (local index) (i32 8))
				(then (return (call word (u32 3268875429) (u32 1877586696)))))
			(return (call word (u32 4221451472) (u32 2726589973)))))

	(fn mix
		(:doc "Mix the selected message pair into one column or diagonal of the work vector.")
		(params (work (mut-slice Blake2bWord)) (ai i32) (bi i32) (ci i32) (di i32)
			(x Blake2bWord) (y Blake2bWord))
		(returns void)
		(body
			(let a0 (slice.load (local work) (local ai)))
			(let b0 (slice.load (local work) (local bi)))
			(let c0 (slice.load (local work) (local ci)))
			(let d0 (slice.load (local work) (local di)))
			(let a1 (call word_add (call word_add (local a0) (local b0)) (local x)))
			(let d1 (call word_rotate_32 (call word_xor (local d0) (local a1))))
			(let c1 (call word_add (local c0) (local d1)))
			(let b1 (call word_rotate_cross (call word_xor (local b0) (local c1)) (i32 8)))
			(let a2 (call word_add (call word_add (local a1) (local b1)) (local y)))
			(let d2 (call word_rotate_cross (call word_xor (local d1) (local a2)) (i32 16)))
			(let c2 (call word_add (local c1) (local d2)))
			(let b2 (call word_rotate_63 (call word_xor (local b1) (local c2))))
			(slice.store (local work) (local ai) (local a2))
			(slice.store (local work) (local bi) (local b2))
			(slice.store (local work) (local ci) (local c2))
			(slice.store (local work) (local di) (local d2))))

	(fn mix_pair
		(:doc "Read the first two selectors in a packed limb and run one mix.")
		(params (work (mut-slice Blake2bWord)) (state (shared-slice Blake2bWord)) (selectors u32)
			(ai i32) (bi i32) (ci i32) (di i32))
		(returns void)
		(body
			(let x (call split_limb (local selectors) (i32 4)))
			(let y (call split_limb (record.get (local x) tail) (i32 4)))
			(let x_index (i32.add.wrapping (i32 8) (int.convert i32 (record.get (local x) head))))
			(let y_index (i32.add.wrapping (i32 8) (int.convert i32 (record.get (local y) head))))
			(call mix (borrow-mut (local work)) (local ai) (local bi) (local ci) (local di)
				(slice.load (local state) (local x_index)) (slice.load (local state) (local y_index)))))

	(fn compress_round
		(:doc "Mix four columns followed by the four diagonals of the RFC work vector.")
		(params (work (mut-slice Blake2bWord)) (state (shared-slice Blake2bWord)) (sigma Blake2bWord))
		(returns void)
		(body
			(let-mut selectors (record.get (local sigma) high))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 0) (i32 4) (i32 8) (i32 12))
			(set (local selectors) (call shift_word (local selectors) (i32 8)))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 1) (i32 5) (i32 9) (i32 13))
			(set (local selectors) (call shift_word (local selectors) (i32 8)))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 2) (i32 6) (i32 10) (i32 14))
			(set (local selectors) (call shift_word (local selectors) (i32 8)))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 3) (i32 7) (i32 11) (i32 15))
			(set (local selectors) (record.get (local sigma) low))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 0) (i32 5) (i32 10) (i32 15))
			(set (local selectors) (call shift_word (local selectors) (i32 8)))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 1) (i32 6) (i32 11) (i32 12))
			(set (local selectors) (call shift_word (local selectors) (i32 8)))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 2) (i32 7) (i32 8) (i32 13))
			(set (local selectors) (call shift_word (local selectors) (i32 8)))
			(call mix_pair (borrow-mut (local work)) (borrow-shared (local state))
				(local selectors) (i32 3) (i32 4) (i32 9) (i32 14))))

	(fn compress_into
		(:doc "Seed the work vector, inject the byte count and final flag, and fold the twelve rounds into the state.")
		(params (state (mut-slice Blake2bWord)) (work (mut-slice Blake2bWord)) (last bool))
		(returns void)
		(body
			(let-mut index (i32 0))
			(while
				(:doc "The work vector starts with eight chaining words followed by eight IV words.")
				(i32.lt (local index) (i32 8))
				(body
					(slice.store (local work) (local index) (slice.load (local state) (local index)))
					(slice.store (local work) (i32.add.wrapping (local index) (i32 8)) (call blake2b_iv (local index)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(slice.store (local work) (i32 12)
				(call word_xor (slice.load (local work) (i32 12)) (slice.load (local state) (i32 24))))
			(slice.store (local work) (i32 13)
				(call word_xor (slice.load (local work) (i32 13)) (slice.load (local state) (i32 25))))
			(if
				(:doc "An all-ones flag marks the one final block.")
				(local last)
				(then
					(slice.store (local work) (i32 14)
						(call word_xor (slice.load (local work) (i32 14)) (call word (u32 4294967295) (u32 4294967295))))))
			(set (local index) (i32 0))
			(while
				(:doc "Run each of the ten SIGMA rows once.")
				(i32.lt (local index) (i32 10))
				(body
					(call compress_round (borrow-mut (local work)) (borrow-shared (local state)) (call sigma_row (local index)))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))
			(call compress_round (borrow-mut (local work)) (borrow-shared (local state)) (call sigma_row (i32 0)))
			(call compress_round (borrow-mut (local work)) (borrow-shared (local state)) (call sigma_row (i32 1)))
			(set (local index) (i32 0))
			(while
				(:doc "Fold the corresponding word from each half into the original chaining word.")
				(i32.lt (local index) (i32 8))
				(body
					(let first (slice.load (local work) (local index)))
					(let second (slice.load (local work) (i32.add.wrapping (local index) (i32 8))))
					(slice.store (local state) (local index)
						(call word_xor (slice.load (local state) (local index)) (call word_xor (local first) (local second))))
					(set (local index) (i32.add.wrapping (local index) (i32 1)))))))

	(fn blake2b_compress
		(:doc "Compress the block in state using one temporary sixteen-word work vector.")
		(params (state (mut-slice Blake2bWord)) (last bool))
		(returns void)
		(body
			(let-mut work (array.alloc Blake2bWord (i32 16)))
			(call compress_into (borrow-mut (local state)) (borrow-mut (local work)) (local last)))))
