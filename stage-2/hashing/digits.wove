(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Share the lowercase ASCII digit mapping used by Base16 and Base32hex.")
	digits

	(fn
		(:doc "Map values from 0 through 31 to ASCII 0 through 9 and a through v.")
		lowercase_ascii_digit
		(params (digit u32))
		(returns u8)
		(body
			(if
				(:doc "Decimal digits start at ASCII 0.")
				(u32.lt (local digit) (u32 10))
				(then (return (int.convert u8 (u32.add.wrapping (u32 48) (local digit))))))
			(return (int.convert u8 (u32.add.wrapping (u32 87) (local digit)))))))
