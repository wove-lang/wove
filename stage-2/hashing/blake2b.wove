(module blake2b
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Unkeyed sequential BLAKE2b-256 as specified in RFC 7693.")

	(use wove-file "./base32hex.wove" (only digest_base32hex))

	(struct Blake2b
		(fields
			(words (array u64 8))
			(block (array u8 128))
			(used i32)
			(bytes_low u64)
			(bytes_high u64)))

	(let blake2b_iv
		(:doc "RFC initialization vector shared by the parameter block and compression.")
		(array.new (array u64 8)
			7640891576956012808u64 13503953896175478587u64
			4354685564936845355u64 11912009170470909681u64
			5840696475078001361u64 11170449401992604703u64
			2270897969802886507u64 6620516959819538809u64))

	(let blake2b_sigma
		(:doc "RFC 7693 SIGMA rows packed with the first selector in the low nibble. Rounds ten and eleven repeat the first two permutations.")
		(array.new (array u64 10)
			18364758544493064720u64 3853709921291437230u64
			5266788149650328715u64 10305543691612001175u64
			15242093322790139145u64 10515720223929181890u64
			13270197634454188380u64 11702690517083809725u64
			6503616966983130870u64 991893350865389610u64))

	(fn blake2b
		(:doc "Set digest size 32, key length zero, fanout one, and depth one in the parameter block.")
		(params)
		(returns Blake2b)
		(body
			(return (struct.new Blake2b
				(words (array.new (array u64 8)
					(u64.xor (array.load (local blake2b_iv) 0i32) 16842784u64)
					(array.load (local blake2b_iv) 1i32)
					(array.load (local blake2b_iv) 2i32)
					(array.load (local blake2b_iv) 3i32)
					(array.load (local blake2b_iv) 4i32)
					(array.load (local blake2b_iv) 5i32)
					(array.load (local blake2b_iv) 6i32)
					(array.load (local blake2b_iv) 7i32)))
				(block (array.repeat (array u8 128) 0u8))
				(used 0i32)
				(bytes_low 0u64)
				(bytes_high 0u64)))))

	(fn blake2b_load
		(:doc "Load one complete message word in the specified byte order on every target.")
		(params (block (shared-array u8)) (at i32))
		(returns u64)
		(body
			(return
				(u64.or
					(u64.or
						(u64.or
							(u64.or
								(u64.or
									(u64.or
										(u64.or
											(u64.from-u8 (array.load (local block) (local at)))
											(u64.shl (u64.from-u8 (array.load (local block)
												(i32.add (local at) 1i32))) 8i32))
										(u64.shl (u64.from-u8 (array.load (local block)
											(i32.add (local at) 2i32))) 16i32))
									(u64.shl (u64.from-u8 (array.load (local block)
										(i32.add (local at) 3i32))) 24i32))
								(u64.shl (u64.from-u8 (array.load (local block)
									(i32.add (local at) 4i32))) 32i32))
							(u64.shl (u64.from-u8 (array.load (local block)
								(i32.add (local at) 5i32))) 40i32))
						(u64.shl (u64.from-u8 (array.load (local block)
							(i32.add (local at) 6i32))) 48i32))
					(u64.shl (u64.from-u8 (array.load (local block)
						(i32.add (local at) 7i32))) 56i32)))))

	(struct
		(:doc "Store one G group as four words, with no dynamic work-vector indices.")
		Blake2bLane
		(fields (a u64) (b u64) (c u64) (d u64)))

	(struct
		(:doc "The work vector's four columns in column order.")
		Blake2bWork
		(fields (c0 Blake2bLane) (c1 Blake2bLane) (c2 Blake2bLane) (c3 Blake2bLane)))

	(fn blake2b_mix
		(:doc "Mix two message words into a column or diagonal.")
		(params (lane Blake2bLane) (x u64) (y u64))
		(returns Blake2bLane)
		(body
			(let-mut next (local lane))
			(set (struct.get (local next) a) (u64.add
				(u64.add (struct.get (local next) a) (struct.get (local next) b)) (local x)))
			(set (struct.get (local next) d) (u64.rotr
				(u64.xor (struct.get (local next) d) (struct.get (local next) a)) 32i32))
			(set (struct.get (local next) c) (u64.add (struct.get (local next) c) (struct.get (local next) d)))
			(set (struct.get (local next) b) (u64.rotr
				(u64.xor (struct.get (local next) b) (struct.get (local next) c)) 24i32))
			(set (struct.get (local next) a) (u64.add
				(u64.add (struct.get (local next) a) (struct.get (local next) b)) (local y)))
			(set (struct.get (local next) d) (u64.rotr
				(u64.xor (struct.get (local next) d) (struct.get (local next) a)) 16i32))
			(set (struct.get (local next) c) (u64.add (struct.get (local next) c) (struct.get (local next) d)))
			(set (struct.get (local next) b) (u64.rotr
				(u64.xor (struct.get (local next) b) (struct.get (local next) c)) 63i32))
			(return (local next))))

	(fn blake2b_pair
		(:doc "Read consecutive message selectors from the round's packed permutation.")
		(params (lane Blake2bLane) (words (shared-array u64)) (permutation u64))
		(returns Blake2bLane)
		(body
			(let x (array.load (local words) (i32.from-u64 (u64.and (local permutation) 15u64))))
			(let y (array.load (local words) (i32.from-u64 (u64.and (u64.shr (local permutation) 4i32) 15u64))))
			(return (call blake2b_mix (local lane) (local x) (local y)))))

	(fn blake2b_round
		(:doc "Gather the diagonals after the column mixes, then restore column order.")
		(params (work Blake2bWork) (words (shared-array u64)) (permutation u64))
		(returns Blake2bWork)
		(body
			(let c0 (call blake2b_pair (struct.get (local work) c0) (borrow-shared (local words)) (local permutation)))
			(let c1 (call blake2b_pair (struct.get (local work) c1) (borrow-shared (local words)) (u64.shr (local permutation) 8i32)))
			(let c2 (call blake2b_pair (struct.get (local work) c2) (borrow-shared (local words)) (u64.shr (local permutation) 16i32)))
			(let c3 (call blake2b_pair (struct.get (local work) c3) (borrow-shared (local words)) (u64.shr (local permutation) 24i32)))
			(let d0 (call blake2b_pair (struct.new Blake2bLane
				(a (struct.get (local c0) a)) (b (struct.get (local c1) b))
				(c (struct.get (local c2) c)) (d (struct.get (local c3) d)))
				(borrow-shared (local words)) (u64.shr (local permutation) 32i32)))
			(let d1 (call blake2b_pair (struct.new Blake2bLane
				(a (struct.get (local c1) a)) (b (struct.get (local c2) b))
				(c (struct.get (local c3) c)) (d (struct.get (local c0) d)))
				(borrow-shared (local words)) (u64.shr (local permutation) 40i32)))
			(let d2 (call blake2b_pair (struct.new Blake2bLane
				(a (struct.get (local c2) a)) (b (struct.get (local c3) b))
				(c (struct.get (local c0) c)) (d (struct.get (local c1) d)))
				(borrow-shared (local words)) (u64.shr (local permutation) 48i32)))
			(let d3 (call blake2b_pair (struct.new Blake2bLane
				(a (struct.get (local c3) a)) (b (struct.get (local c0) b))
				(c (struct.get (local c1) c)) (d (struct.get (local c2) d)))
				(borrow-shared (local words)) (u64.shr (local permutation) 56i32)))
			(return (struct.new Blake2bWork
				(c0 (struct.new Blake2bLane
					(a (struct.get (local d0) a)) (b (struct.get (local d3) b))
					(c (struct.get (local d2) c)) (d (struct.get (local d1) d))))
				(c1 (struct.new Blake2bLane
					(a (struct.get (local d1) a)) (b (struct.get (local d0) b))
					(c (struct.get (local d3) c)) (d (struct.get (local d2) d))))
				(c2 (struct.new Blake2bLane
					(a (struct.get (local d2) a)) (b (struct.get (local d1) b))
					(c (struct.get (local d0) c)) (d (struct.get (local d3) d))))
				(c3 (struct.new Blake2bLane
					(a (struct.get (local d3) a)) (b (struct.get (local d2) b))
					(c (struct.get (local d1) c)) (d (struct.get (local d0) d))))))))

	(fn blake2b_block
		(:doc "Compress one padded or full block with the cumulative count of unpadded bytes.")
		(params (state (mut-array u64)) (block (shared-array u8)) (low u64) (high u64) (last bool))
		(returns void)
		(body
			(let-mut words (array.repeat (array u64 16) 0u64))
			(let-mut i 0i32)
			(while
				(:doc "Decode all sixteen little-endian message words.")
				(i32.lt (local i) 16i32)
				(body
					(array.store (local words) (local i)
						(call blake2b_load (borrow-shared (local block)) (i32.mul (local i) 8i32)))
					(set (local i) (i32.add (local i) 1i32))))
			(let-mut final_word (array.load (local blake2b_iv) 6i32))
			(if
				(:doc "Complement the final flag word for the last block.")
				(local last)
				(then (set (local final_word) (u64.not (local final_word)))))
			(let-mut work (struct.new Blake2bWork
				(c0 (struct.new Blake2bLane
					(a (array.load (local state) 0i32)) (b (array.load (local state) 4i32))
					(c (array.load (local blake2b_iv) 0i32)) (d (u64.xor (array.load (local blake2b_iv) 4i32) (local low)))))
				(c1 (struct.new Blake2bLane
					(a (array.load (local state) 1i32)) (b (array.load (local state) 5i32))
					(c (array.load (local blake2b_iv) 1i32)) (d (u64.xor (array.load (local blake2b_iv) 5i32) (local high)))))
				(c2 (struct.new Blake2bLane
					(a (array.load (local state) 2i32)) (b (array.load (local state) 6i32))
					(c (array.load (local blake2b_iv) 2i32)) (d (local final_word))))
				(c3 (struct.new Blake2bLane
					(a (array.load (local state) 3i32)) (b (array.load (local state) 7i32))
					(c (array.load (local blake2b_iv) 3i32)) (d (array.load (local blake2b_iv) 7i32))))))
			(set (local i) 0i32)
			(while
				(:doc "All twelve rounds mix the same block with a different order of message words.")
				(i32.lt (local i) 12i32)
				(body
					(set (local work) (call blake2b_round (local work) (borrow-shared (local words))
						(array.load (local blake2b_sigma) (i32.rem (local i) 10i32))))
					(set (local i) (i32.add (local i) 1i32))))
			(array.store
				(:doc "Fold both halves back into the original chaining state.")
				(local state) 0i32 (u64.xor (u64.xor
					(array.load (local state) 0i32) (struct.get (struct.get (local work) c0) a))
					(struct.get (struct.get (local work) c0) c)))
			(array.store (local state) 1i32 (u64.xor (u64.xor
				(array.load (local state) 1i32) (struct.get (struct.get (local work) c1) a))
				(struct.get (struct.get (local work) c1) c)))
			(array.store (local state) 2i32 (u64.xor (u64.xor
				(array.load (local state) 2i32) (struct.get (struct.get (local work) c2) a))
				(struct.get (struct.get (local work) c2) c)))
			(array.store (local state) 3i32 (u64.xor (u64.xor
				(array.load (local state) 3i32) (struct.get (struct.get (local work) c3) a))
				(struct.get (struct.get (local work) c3) c)))
			(array.store (local state) 4i32 (u64.xor (u64.xor
				(array.load (local state) 4i32) (struct.get (struct.get (local work) c0) b))
				(struct.get (struct.get (local work) c0) d)))
			(array.store (local state) 5i32 (u64.xor (u64.xor
				(array.load (local state) 5i32) (struct.get (struct.get (local work) c1) b))
				(struct.get (struct.get (local work) c1) d)))
			(array.store (local state) 6i32 (u64.xor (u64.xor
				(array.load (local state) 6i32) (struct.get (struct.get (local work) c2) b))
				(struct.get (struct.get (local work) c2) d)))
			(array.store (local state) 7i32 (u64.xor (u64.xor
				(array.load (local state) 7i32) (struct.get (struct.get (local work) c3) b))
				(struct.get (struct.get (local work) c3) d)))))

	(fn blake2b_count
		(:doc "Advance the byte counter modulo 2^128, carrying out of the low limb.")
		(params (hash (mut-ref Blake2b)) (length i32))
		(returns void)
		(body
			(let low (u64.add (struct.get (local hash) bytes_low) (u64.from-i32 (local length))))
			(if
				(:doc "A wrapped low word carries one into the high word.")
				(u64.lt (local low) (struct.get (local hash) bytes_low))
				(then (set (struct.get (local hash) bytes_high)
					(u64.add (struct.get (local hash) bytes_high) 1u64))))
			(set (struct.get (local hash) bytes_low) (local low))))

	(fn blake2b_update
		(:doc "Keep the final block pending, including a full block when input ends on its boundary.")
		(:expect
			(tests "stage-2/hashing/blake2b/cases.tsv")
			(issues "gh:wove-lang/wove:172" "gh:wove-lang/wove:238"))
		(params (hash (mut-ref Blake2b)) (bytes (shared-array u8)))
		(returns void)
		(body
			(if (i32.eq (array.len (local bytes)) 0i32) (then (return)))
			(let-mut i 0i32)
			(if
				(:doc "A pending block becomes nonfinal only when another byte is known to follow it.")
				(bool.not (i32.eq (struct.get (local hash) used) 0i32))
				(then
					(while
						(:doc "Fill any remaining space in the pending block from the new input.")
						(bool.and (i32.lt (struct.get (local hash) used) 128i32)
							(i32.lt (local i) (array.len (local bytes))))
						(body
							(array.store (struct.get (local hash) block) (struct.get (local hash) used)
								(array.load (local bytes) (local i)))
							(set (struct.get (local hash) used) (i32.add (struct.get (local hash) used) 1i32))
							(set (local i) (i32.add (local i) 1i32))))
					(if (i32.eq (local i) (array.len (local bytes))) (then (return)))
					(call blake2b_count (borrow-mut (local hash)) 128i32)
					(call blake2b_block
						(borrow-mut (struct.get (local hash) words)) (borrow-shared (struct.get (local hash) block))
						(struct.get (local hash) bytes_low) (struct.get (local hash) bytes_high) (bool false))
					(set (struct.get (local hash) used) 0i32)))
			(while
				(:doc "Process complete nonfinal blocks directly from the caller's view.")
				(i32.lt 128i32 (i32.sub (array.len (local bytes)) (local i)))
				(body
					(call blake2b_count (borrow-mut (local hash)) 128i32)
					(call blake2b_block
						(borrow-mut (struct.get (local hash) words))
						(borrow-shared (array.range (local bytes) (local i) (i32.add (local i) 128i32)))
						(struct.get (local hash) bytes_low) (struct.get (local hash) bytes_high) (bool false))
					(set (local i) (i32.add (local i) 128i32))))
			(while
				(:doc "Copy at most one block so callers can release or refill the input buffer.")
				(i32.lt (local i) (array.len (local bytes)))
				(body
					(array.store (struct.get (local hash) block) (struct.get (local hash) used)
						(array.load (local bytes) (local i)))
					(set (struct.get (local hash) used) (i32.add (struct.get (local hash) used) 1i32))
					(set (local i) (i32.add (local i) 1i32))))))

	(fn blake2b_number
		(:doc "Feed one unsigned field in the cache's canonical little-endian representation.")
		(params (hash (mut-ref Blake2b)) (value u64))
		(returns void)
		(body
			(let bytes (u64.to-le-bytes (local value)))
			(call blake2b_update (borrow-mut (local hash)) (borrow-shared (local bytes)))))

	(fn blake2b_field
		(:doc "Prefix every byte field with its length to retain the original field boundaries.")
		(params (hash (mut-ref Blake2b)) (data (shared-array u8)))
		(returns void)
		(body
			(call blake2b_number (borrow-mut (local hash)) (u64.from-i32 (array.len (local data))))
			(call blake2b_update (borrow-mut (local hash)) (borrow-shared (local data)))))

	(fn blake2b_words
		(:doc "Finalize a copy so a caller can continue updating after taking a digest.")
		(params (state Blake2b))
		(returns (array u64 4))
		(body
			(let-mut hash (local state))
			(let-mut i (struct.get (local hash) used))
			(while
				(:doc "The counter excludes padding, including when hashing an empty stream.")
				(i32.lt (local i) 128i32)
				(body
					(array.store (struct.get (local hash) block) (local i) 0u8)
					(set (local i) (i32.add (local i) 1i32))))
			(let used (struct.get (local hash) used))
			(call blake2b_count (borrow-mut (local hash)) (local used))
			(call blake2b_block
				(borrow-mut (struct.get (local hash) words)) (borrow-shared (struct.get (local hash) block))
				(struct.get (local hash) bytes_low) (struct.get (local hash) bytes_high) (bool true))
			(return (array.new (array u64 4)
				(array.load (struct.get (local hash) words) 0i32)
				(array.load (struct.get (local hash) words) 1i32)
				(array.load (struct.get (local hash) words) 2i32)
				(array.load (struct.get (local hash) words) 3i32)))))

	(fn blake2b_base32hex_word
		(:doc "Read the first four little-endian bytes of a chaining word as one base32hex encoder word.")
		(params (word u64))
		(returns u32)
		(body
			(return (u32.from-u64
				(u64.or
					(u64.or
						(u64.or
							(u64.shl (u64.and (local word) 255u64) 24i32)
							(u64.shl (u64.and (local word) 65280u64) 8i32))
						(u64.and (u64.shr (local word) 8i32) 65280u64))
					(u64.and (u64.shr (local word) 24i32) 255u64))))))

	(fn blake2b_finish
		(:doc "Encode the complete checksum once for cache records and filenames.")
		(params (state Blake2b))
		(returns (owned-array u8))
		(body
			(let words (call blake2b_words (local state)))
			(return (call digest_base32hex (array.new (array u32 8)
				(call blake2b_base32hex_word (array.load (local words) 0i32))
				(call blake2b_base32hex_word (u64.shr (array.load (local words) 0i32) 32i32))
				(call blake2b_base32hex_word (array.load (local words) 1i32))
				(call blake2b_base32hex_word (u64.shr (array.load (local words) 1i32) 32i32))
				(call blake2b_base32hex_word (array.load (local words) 2i32))
				(call blake2b_base32hex_word (u64.shr (array.load (local words) 2i32) 32i32))
				(call blake2b_base32hex_word (array.load (local words) 3i32))
				(call blake2b_base32hex_word (u64.shr (array.load (local words) 3i32) 32i32)))))))
)
