(module blake2b
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Unkeyed sequential BLAKE2b-256 as specified in RFC 7693.")

	(use wove-file "./base32hex.wove" (only digest_base32hex))

	(struct Blake2b
		(fields
			(words (array u64 8))
			(block (array u8 128))
			(used i32)
			(bytes_low u64)
			(bytes_high u64)))

	(let blake2b_iv
		(:doc "RFC initialization vector shared by the parameter block and compression.")
		(array:new (array u64 8)
			7640891576956012808u64 13503953896175478587u64
			4354685564936845355u64 11912009170470909681u64
			5840696475078001361u64 11170449401992604703u64
			2270897969802886507u64 6620516959819538809u64))

	(let blake2b_sigma
		(:doc "RFC 7693 SIGMA rows packed with the first selector in the low nibble. Rounds ten and eleven repeat the first two permutations.")
		(array:new (array u64 10)
			18364758544493064720u64 3853709921291437230u64
			5266788149650328715u64 10305543691612001175u64
			15242093322790139145u64 10515720223929181890u64
			13270197634454188380u64 11702690517083809725u64
			6503616966983130870u64 991893350865389610u64))

	(fn blake2b
		(:doc "Set digest size 32, key length zero, fanout one, and depth one in the parameter block.")
		(params)
		(returns Blake2b)
		(body
			(return (struct:new Blake2b
				(words (array:new (array u64 8)
					(u64:xor (array:get blake2b_iv 0i32) 16842784u64)
					(array:get blake2b_iv 1i32)
					(array:get blake2b_iv 2i32)
					(array:get blake2b_iv 3i32)
					(array:get blake2b_iv 4i32)
					(array:get blake2b_iv 5i32)
					(array:get blake2b_iv 6i32)
					(array:get blake2b_iv 7i32)))
				(block (array:repeat (array u8 128) 0u8))
				(used 0i32)
				(bytes_low 0u64)
				(bytes_high 0u64)))))

	(fn blake2b_load
		(:doc "Load one complete message word in the specified byte order on every target.")
		(params (block (shared-array u8)) (at i32))
		(returns u64)
		(body
			(return
				(u64:or
					(u64:or
						(u64:or
							(u64:or
								(u64:or
									(u64:or
										(u64:or
											(u64:from-u8 (array:get block at))
											(u64:shl (u64:from-u8 (array:get block
												(i32:inc at))) 8i32))
										(u64:shl (u64:from-u8 (array:get block
											(i32:add at 2i32))) 16i32))
									(u64:shl (u64:from-u8 (array:get block
										(i32:add at 3i32))) 24i32))
								(u64:shl (u64:from-u8 (array:get block
									(i32:add at 4i32))) 32i32))
							(u64:shl (u64:from-u8 (array:get block
								(i32:add at 5i32))) 40i32))
						(u64:shl (u64:from-u8 (array:get block
							(i32:add at 6i32))) 48i32))
					(u64:shl (u64:from-u8 (array:get block
						(i32:add at 7i32))) 56i32)))))

	(struct Blake2bLane
		(:doc "Store one G group as four words, with no dynamic work-vector indices.")
		(fields (a u64) (b u64) (c u64) (d u64)))

	(struct Blake2bWork
		(:doc "The work vector's four columns in column order.")
		(fields (c0 Blake2bLane) (c1 Blake2bLane) (c2 Blake2bLane) (c3 Blake2bLane)))

	(fn blake2b_mix
		(:doc "Mix two message words into a column or diagonal.")
		(params (lane Blake2bLane) (x u64) (y u64))
		(returns Blake2bLane)
		(body
			(let-mut next lane)
			(set (struct:get next a) (u64:add
				(u64:add (struct:get next a) (struct:get next b)) x))
			(set (struct:get next d) (u64:rotr
				(u64:xor (struct:get next d) (struct:get next a)) 32i32))
			(set (struct:get next c) (u64:add (struct:get next c) (struct:get next d)))
			(set (struct:get next b) (u64:rotr
				(u64:xor (struct:get next b) (struct:get next c)) 24i32))
			(set (struct:get next a) (u64:add
				(u64:add (struct:get next a) (struct:get next b)) y))
			(set (struct:get next d) (u64:rotr
				(u64:xor (struct:get next d) (struct:get next a)) 16i32))
			(set (struct:get next c) (u64:add (struct:get next c) (struct:get next d)))
			(set (struct:get next b) (u64:rotr
				(u64:xor (struct:get next b) (struct:get next c)) 63i32))
			(return next)))

	(fn blake2b_pair
		(:doc "Read consecutive message selectors from the round's packed permutation.")
		(params (lane Blake2bLane) (words (shared-array u64)) (permutation u64))
		(returns Blake2bLane)
		(body
			(let x (array:get words (i32:from-u64 (u64:and permutation 15u64))))
			(let y (array:get words (i32:from-u64 (u64:and (u64:shr permutation 4i32) 15u64))))
			(return (call blake2b_mix lane x y))))

	(fn blake2b_round
		(:doc "Gather the diagonals after the column mixes, then restore column order.")
		(params (work Blake2bWork) (words (shared-array u64)) (permutation u64))
		(returns Blake2bWork)
		(body
			(let c0 (call blake2b_pair (struct:get work c0) (borrow-shared words) permutation))
			(let c1 (call blake2b_pair (struct:get work c1) (borrow-shared words) (u64:shr permutation 8i32)))
			(let c2 (call blake2b_pair (struct:get work c2) (borrow-shared words) (u64:shr permutation 16i32)))
			(let c3 (call blake2b_pair (struct:get work c3) (borrow-shared words) (u64:shr permutation 24i32)))
			(let d0 (call blake2b_pair (struct:new Blake2bLane
				(a (struct:get c0 a)) (b (struct:get c1 b))
				(c (struct:get c2 c)) (d (struct:get c3 d)))
				(borrow-shared words) (u64:shr permutation 32i32)))
			(let d1 (call blake2b_pair (struct:new Blake2bLane
				(a (struct:get c1 a)) (b (struct:get c2 b))
				(c (struct:get c3 c)) (d (struct:get c0 d)))
				(borrow-shared words) (u64:shr permutation 40i32)))
			(let d2 (call blake2b_pair (struct:new Blake2bLane
				(a (struct:get c2 a)) (b (struct:get c3 b))
				(c (struct:get c0 c)) (d (struct:get c1 d)))
				(borrow-shared words) (u64:shr permutation 48i32)))
			(let d3 (call blake2b_pair (struct:new Blake2bLane
				(a (struct:get c3 a)) (b (struct:get c0 b))
				(c (struct:get c1 c)) (d (struct:get c2 d)))
				(borrow-shared words) (u64:shr permutation 56i32)))
			(return (struct:new Blake2bWork
				(c0 (struct:new Blake2bLane
					(a (struct:get d0 a)) (b (struct:get d3 b))
					(c (struct:get d2 c)) (d (struct:get d1 d))))
				(c1 (struct:new Blake2bLane
					(a (struct:get d1 a)) (b (struct:get d0 b))
					(c (struct:get d3 c)) (d (struct:get d2 d))))
				(c2 (struct:new Blake2bLane
					(a (struct:get d2 a)) (b (struct:get d1 b))
					(c (struct:get d0 c)) (d (struct:get d3 d))))
				(c3 (struct:new Blake2bLane
					(a (struct:get d3 a)) (b (struct:get d2 b))
					(c (struct:get d1 c)) (d (struct:get d0 d))))))))

	(fn blake2b_block
		(:doc "Compress one padded or full block with the cumulative count of unpadded bytes.")
		(params (state (mut-array u64)) (block (shared-array u8)) (low u64) (high u64) (last bool))
		(returns void)
		(body
			(let-mut words (array:repeat (array u64 16) 0u64))
			(let-mut i 0i32)
			(while
				(:doc "Decode all sixteen little-endian message words.")
				(i32:lt i 16i32)
				(body
					(array:set words i
						(call blake2b_load (borrow-shared block) (i32:mul i 8i32)))
					(set i (i32:inc i))))
			(let-mut final_word (array:get blake2b_iv 6i32))
			(if
				(:doc "Complement the final flag word for the last block.")
				last
				(then (set final_word (u64:not final_word))))
			(let-mut work (struct:new Blake2bWork
				(c0 (struct:new Blake2bLane
					(a (array:get state 0i32)) (b (array:get state 4i32))
					(c (array:get blake2b_iv 0i32)) (d (u64:xor (array:get blake2b_iv 4i32) low))))
				(c1 (struct:new Blake2bLane
					(a (array:get state 1i32)) (b (array:get state 5i32))
					(c (array:get blake2b_iv 1i32)) (d (u64:xor (array:get blake2b_iv 5i32) high))))
				(c2 (struct:new Blake2bLane
					(a (array:get state 2i32)) (b (array:get state 6i32))
					(c (array:get blake2b_iv 2i32)) (d final_word)))
				(c3 (struct:new Blake2bLane
					(a (array:get state 3i32)) (b (array:get state 7i32))
					(c (array:get blake2b_iv 3i32)) (d (array:get blake2b_iv 7i32))))))
			(set i 0i32)
			(while
				(:doc "All twelve rounds mix the same block with a different order of message words.")
				(i32:lt i 12i32)
				(body
					(set work (call blake2b_round work (borrow-shared words)
						(array:get blake2b_sigma (i32:rem i 10i32))))
					(set i (i32:inc i))))
			(array:set
				(:doc "Fold both halves back into the original chaining state.")
				state 0i32 (u64:xor (u64:xor
					(array:get state 0i32) (struct:get (struct:get work c0) a))
					(struct:get (struct:get work c0) c)))
			(array:set state 1i32 (u64:xor (u64:xor
				(array:get state 1i32) (struct:get (struct:get work c1) a))
				(struct:get (struct:get work c1) c)))
			(array:set state 2i32 (u64:xor (u64:xor
				(array:get state 2i32) (struct:get (struct:get work c2) a))
				(struct:get (struct:get work c2) c)))
			(array:set state 3i32 (u64:xor (u64:xor
				(array:get state 3i32) (struct:get (struct:get work c3) a))
				(struct:get (struct:get work c3) c)))
			(array:set state 4i32 (u64:xor (u64:xor
				(array:get state 4i32) (struct:get (struct:get work c0) b))
				(struct:get (struct:get work c0) d)))
			(array:set state 5i32 (u64:xor (u64:xor
				(array:get state 5i32) (struct:get (struct:get work c1) b))
				(struct:get (struct:get work c1) d)))
			(array:set state 6i32 (u64:xor (u64:xor
				(array:get state 6i32) (struct:get (struct:get work c2) b))
				(struct:get (struct:get work c2) d)))
			(array:set state 7i32 (u64:xor (u64:xor
				(array:get state 7i32) (struct:get (struct:get work c3) b))
				(struct:get (struct:get work c3) d)))))

	(fn blake2b_count
		(:doc "Advance the byte counter modulo 2^128, carrying out of the low limb.")
		(params (hash (mut-ref Blake2b)) (length i32))
		(returns void)
		(body
			(let low (u64:add (struct:get hash bytes_low) (u64:from-i32 length)))
			(if
				(:doc "A wrapped low word carries one into the high word.")
				(u64:lt low (struct:get hash bytes_low))
				(then (set (struct:get hash bytes_high)
					(u64:inc (struct:get hash bytes_high)))))
			(set (struct:get hash bytes_low) low)))

	(fn blake2b_update
		(:doc "Keep the final block pending, including a full block when input ends on its boundary.")
		(:expect
			(tests "stage-2/hashing/blake2b/cases.tsv")
			(issues "gh:wove-lang/wove:172" "gh:wove-lang/wove:238"))
		(params (hash (mut-ref Blake2b)) (bytes (shared-array u8)))
		(returns void)
		(body
			(if (i32:eqz (array:len bytes)) (then (return)))
			(let-mut i 0i32)
			(if
				(:doc "A pending block becomes nonfinal only when another byte is known to follow it.")
				(i32:not-eqz (struct:get hash used))
				(then
					(while
						(:doc "Fill any remaining space in the pending block from the new input.")
						(bool:and (i32:lt (struct:get hash used) 128i32)
							(i32:lt i (array:len bytes)))
						(body
							(array:set (struct:get hash block) (struct:get hash used)
								(array:get bytes i))
							(set (struct:get hash used) (i32:inc (struct:get hash used)))
							(set i (i32:inc i))))
					(if (i32:eq i (array:len bytes)) (then (return)))
					(call blake2b_count (borrow-mut hash) 128i32)
					(call blake2b_block
						(borrow-mut (struct:get hash words)) (borrow-shared (struct:get hash block))
						(struct:get hash bytes_low) (struct:get hash bytes_high) (bool false))
					(set (struct:get hash used) 0i32)))
			(while
				(:doc "Process complete nonfinal blocks directly from the caller's view.")
				(i32:lt 128i32 (i32:sub (array:len bytes) i))
				(body
					(call blake2b_count (borrow-mut hash) 128i32)
					(call blake2b_block
						(borrow-mut (struct:get hash words))
						(borrow-shared (array:range bytes i (i32:add i 128i32)))
						(struct:get hash bytes_low) (struct:get hash bytes_high) (bool false))
					(set i (i32:add i 128i32))))
			(while
				(:doc "Copy at most one block so callers can release or refill the input buffer.")
				(i32:lt i (array:len bytes))
				(body
					(array:set (struct:get hash block) (struct:get hash used)
						(array:get bytes i))
					(set (struct:get hash used) (i32:inc (struct:get hash used)))
					(set i (i32:inc i))))))

	(fn blake2b_number
		(:doc "Feed one unsigned field in the cache's canonical little-endian representation.")
		(params (hash (mut-ref Blake2b)) (value u64))
		(returns void)
		(body
			(let bytes (u64:to-le-bytes value))
			(call blake2b_update (borrow-mut hash) (borrow-shared bytes))))

	(fn blake2b_field
		(:doc "Prefix every byte field with its length to retain the original field boundaries.")
		(params (hash (mut-ref Blake2b)) (data (shared-array u8)))
		(returns void)
		(body
			(call blake2b_number (borrow-mut hash) (u64:from-i32 (array:len data)))
			(call blake2b_update (borrow-mut hash) (borrow-shared data))))

	(fn blake2b_words
		(:doc "Finalize a copy so a caller can continue updating after taking a digest.")
		(params (state Blake2b))
		(returns (array u64 4))
		(body
			(let-mut hash state)
			(let-mut i (struct:get hash used))
			(while
				(:doc "The counter excludes padding, including when hashing an empty stream.")
				(i32:lt i 128i32)
				(body
					(array:set (struct:get hash block) i 0u8)
					(set i (i32:inc i))))
			(let used (struct:get hash used))
			(call blake2b_count (borrow-mut hash) used)
			(call blake2b_block
				(borrow-mut (struct:get hash words)) (borrow-shared (struct:get hash block))
				(struct:get hash bytes_low) (struct:get hash bytes_high) (bool true))
			(return (array:new (array u64 4)
				(array:get (struct:get hash words) 0i32)
				(array:get (struct:get hash words) 1i32)
				(array:get (struct:get hash words) 2i32)
				(array:get (struct:get hash words) 3i32)))))

	(fn blake2b_base32hex_word
		(:doc "Read the first four little-endian bytes of a chaining word as one base32hex encoder word.")
		(params (word u64))
		(returns u32)
		(body
			(return (u32:from-u64
				(u64:or
					(u64:or
						(u64:or
							(u64:shl (u64:and word 255u64) 24i32)
							(u64:shl (u64:and word 65280u64) 8i32))
						(u64:and (u64:shr word 8i32) 65280u64))
					(u64:and (u64:shr word 24i32) 255u64))))))

	(fn blake2b_finish
		(:doc "Encode the complete checksum once for cache records and filenames.")
		(params (state Blake2b))
		(returns (owned-array u8))
		(body
			(let words (call blake2b_words state))
			(return (call digest_base32hex (array:new (array u32 8)
				(call blake2b_base32hex_word (array:get words 0i32))
				(call blake2b_base32hex_word (u64:shr (array:get words 0i32) 32i32))
				(call blake2b_base32hex_word (array:get words 1i32))
				(call blake2b_base32hex_word (u64:shr (array:get words 1i32) 32i32))
				(call blake2b_base32hex_word (array:get words 2i32))
				(call blake2b_base32hex_word (u64:shr (array:get words 2i32) 32i32))
				(call blake2b_base32hex_word (array:get words 3i32))
				(call blake2b_base32hex_word (u64:shr (array:get words 3i32) 32i32)))))))
)
