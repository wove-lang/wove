(module blake2b
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Unkeyed sequential BLAKE2b-256 as specified in RFC 7693.")

	(use wove-file "./base62.wove" (only digest_base62))

	(struct Blake2b
		(fields
			(words (array u64 8))
			(block (array u8 128))
			(used i32)
			(bytes_low u64)
			(bytes_high u64)))

	(let blake2b_iv
		(:doc "RFC initialization vector shared by the parameter block and compression.")
		(array:new (array u64 8)
			7640891576956012808u64 13503953896175478587u64
			4354685564936845355u64 11912009170470909681u64
			5840696475078001361u64 11170449401992604703u64
			2270897969802886507u64 6620516959819538809u64))

	(let blake2b_sigma
		(:doc "RFC 7693 SIGMA rows packed with the first selector in the low nibble. Rounds ten and eleven repeat the first two permutations.")
		(array:new (array u64 10)
			18364758544493064720u64 3853709921291437230u64
			5266788149650328715u64 10305543691612001175u64
			15242093322790139145u64 10515720223929181890u64
			13270197634454188380u64 11702690517083809725u64
			6503616966983130870u64 991893350865389610u64))

	(fn blake2b
		(:doc "Set digest size 32, key length zero, fanout one, and depth one in the parameter block.")
		(params)
		(returns Blake2b)
		(body
			(return (struct:new Blake2b
				(words (array:new (array u64 8)
					(u64:xor (blake2b_iv.get 0i32) 16842784u64)
					(blake2b_iv.get 1i32)
					(blake2b_iv.get 2i32)
					(blake2b_iv.get 3i32)
					(blake2b_iv.get 4i32)
					(blake2b_iv.get 5i32)
					(blake2b_iv.get 6i32)
					(blake2b_iv.get 7i32)))
				(block (array:repeat (array u8 128) 0u8))
				(used 0i32)
				(bytes_low 0u64)
				(bytes_high 0u64)))))

	(fn blake2b_load
		(:doc "Load one complete message word in the specified byte order on every target.")
		(params (block (shared-array u8)) (at i32))
		(returns u64)
		(body
			(return
				(u64:or
					(u64:or
						(u64:or
							(u64:or
								(u64:or
									(u64:or
										(u64:or
											(u64:from-u8 (block.get at))
											(u64:shl (u64:from-u8 (block.get
												(i32:inc at))) 8i32))
										(u64:shl (u64:from-u8 (block.get
											(i32:add at 2i32))) 16i32))
									(u64:shl (u64:from-u8 (block.get
										(i32:add at 3i32))) 24i32))
								(u64:shl (u64:from-u8 (block.get
									(i32:add at 4i32))) 32i32))
							(u64:shl (u64:from-u8 (block.get
								(i32:add at 5i32))) 40i32))
						(u64:shl (u64:from-u8 (block.get
							(i32:add at 6i32))) 48i32))
					(u64:shl (u64:from-u8 (block.get
						(i32:add at 7i32))) 56i32)))))

	(struct Blake2bLane
		(:doc "Store one G group as four words, with no dynamic work-vector indices.")
		(fields (a u64) (b u64) (c u64) (d u64)))

	(struct Blake2bWork
		(:doc "The work vector's four columns in column order.")
		(fields (c0 Blake2bLane) (c1 Blake2bLane) (c2 Blake2bLane) (c3 Blake2bLane)))

	(fn blake2b_mix
		(:doc "Mix two message words into a column or diagonal.")
		(params (lane Blake2bLane) (x u64) (y u64))
		(returns Blake2bLane)
		(body
			(let-mut next lane)
			(set (next.get a) (u64:add
				(u64:add (next.get a) (next.get b)) x))
			(set (next.get d) (u64:rotr
				(u64:xor (next.get d) (next.get a)) 32i32))
			(set (next.get c) (u64:add (next.get c) (next.get d)))
			(set (next.get b) (u64:rotr
				(u64:xor (next.get b) (next.get c)) 24i32))
			(set (next.get a) (u64:add
				(u64:add (next.get a) (next.get b)) y))
			(set (next.get d) (u64:rotr
				(u64:xor (next.get d) (next.get a)) 16i32))
			(set (next.get c) (u64:add (next.get c) (next.get d)))
			(set (next.get b) (u64:rotr
				(u64:xor (next.get b) (next.get c)) 63i32))
			(return next)))

	(fn blake2b_pair
		(:doc "Read consecutive message selectors from the round's packed permutation.")
		(params (lane Blake2bLane) (words (shared-array u64)) (permutation u64))
		(returns Blake2bLane)
		(body
			(let x (words.get (i32:from-u64 (u64:and permutation 15u64))))
			(let y (words.get (i32:from-u64 (u64:and (u64:shr permutation 4i32) 15u64))))
			(return (call blake2b_mix lane x y))))

	(fn blake2b_round
		(:doc "Gather the diagonals after the column mixes, then restore column order.")
		(params (work Blake2bWork) (words (shared-array u64)) (permutation u64))
		(returns Blake2bWork)
		(body
			(let c0 (call blake2b_pair (work.get c0) (borrow-shared words) permutation))
			(let c1 (call blake2b_pair (work.get c1) (borrow-shared words) (u64:shr permutation 8i32)))
			(let c2 (call blake2b_pair (work.get c2) (borrow-shared words) (u64:shr permutation 16i32)))
			(let c3 (call blake2b_pair (work.get c3) (borrow-shared words) (u64:shr permutation 24i32)))
			(let d0 (call blake2b_pair (struct:new Blake2bLane
				(a (c0.get a)) (b (c1.get b))
				(c (c2.get c)) (d (c3.get d)))
				(borrow-shared words) (u64:shr permutation 32i32)))
			(let d1 (call blake2b_pair (struct:new Blake2bLane
				(a (c1.get a)) (b (c2.get b))
				(c (c3.get c)) (d (c0.get d)))
				(borrow-shared words) (u64:shr permutation 40i32)))
			(let d2 (call blake2b_pair (struct:new Blake2bLane
				(a (c2.get a)) (b (c3.get b))
				(c (c0.get c)) (d (c1.get d)))
				(borrow-shared words) (u64:shr permutation 48i32)))
			(let d3 (call blake2b_pair (struct:new Blake2bLane
				(a (c3.get a)) (b (c0.get b))
				(c (c1.get c)) (d (c2.get d)))
				(borrow-shared words) (u64:shr permutation 56i32)))
			(return (struct:new Blake2bWork
				(c0 (struct:new Blake2bLane
					(a (d0.get a)) (b (d3.get b))
					(c (d2.get c)) (d (d1.get d))))
				(c1 (struct:new Blake2bLane
					(a (d1.get a)) (b (d0.get b))
					(c (d3.get c)) (d (d2.get d))))
				(c2 (struct:new Blake2bLane
					(a (d2.get a)) (b (d1.get b))
					(c (d0.get c)) (d (d3.get d))))
				(c3 (struct:new Blake2bLane
					(a (d3.get a)) (b (d2.get b))
					(c (d1.get c)) (d (d0.get d))))))))

	(fn blake2b_block
		(:doc "Compress one padded or full block with the cumulative count of unpadded bytes.")
		(params (state (mut-array u64)) (block (shared-array u8)) (low u64) (high u64) (last bool))
		(returns void)
		(body
			(let-mut words (array:repeat (array u64 16) 0u64))
			(let-mut i 0i32)
			(while
				(:doc "Decode all sixteen little-endian message words.")
				(i32:lt i 16i32)
				(body
					(words.set i
						(call blake2b_load (borrow-shared block) (i32:mul i 8i32)))
					(set i (i32:inc i))))
			(let-mut final_word (blake2b_iv.get 6i32))
			(if
				(:doc "Complement the final flag word for the last block.")
				last
				(then (set final_word (u64:not final_word))))
			(let-mut work (struct:new Blake2bWork
				(c0 (struct:new Blake2bLane
					(a (state.get 0i32)) (b (state.get 4i32))
					(c (blake2b_iv.get 0i32)) (d (u64:xor (blake2b_iv.get 4i32) low))))
				(c1 (struct:new Blake2bLane
					(a (state.get 1i32)) (b (state.get 5i32))
					(c (blake2b_iv.get 1i32)) (d (u64:xor (blake2b_iv.get 5i32) high))))
				(c2 (struct:new Blake2bLane
					(a (state.get 2i32)) (b (state.get 6i32))
					(c (blake2b_iv.get 2i32)) (d final_word)))
				(c3 (struct:new Blake2bLane
					(a (state.get 3i32)) (b (state.get 7i32))
					(c (blake2b_iv.get 3i32)) (d (blake2b_iv.get 7i32))))))
			(set i 0i32)
			(while
				(:doc "All twelve rounds mix the same block with a different order of message words.")
				(i32:lt i 12i32)
				(body
					(set work (call blake2b_round work (borrow-shared words)
						(blake2b_sigma.get (i32:rem i 10i32))))
					(set i (i32:inc i))))
			(state.set
				(:doc "Fold both halves back into the original chaining state.")
				0i32 (u64:xor (u64:xor
					(state.get 0i32) (struct:get (work.get c0) a))
					(struct:get (work.get c0) c)))
			(state.set 1i32 (u64:xor (u64:xor
				(state.get 1i32) (struct:get (work.get c1) a))
				(struct:get (work.get c1) c)))
			(state.set 2i32 (u64:xor (u64:xor
				(state.get 2i32) (struct:get (work.get c2) a))
				(struct:get (work.get c2) c)))
			(state.set 3i32 (u64:xor (u64:xor
				(state.get 3i32) (struct:get (work.get c3) a))
				(struct:get (work.get c3) c)))
			(state.set 4i32 (u64:xor (u64:xor
				(state.get 4i32) (struct:get (work.get c0) b))
				(struct:get (work.get c0) d)))
			(state.set 5i32 (u64:xor (u64:xor
				(state.get 5i32) (struct:get (work.get c1) b))
				(struct:get (work.get c1) d)))
			(state.set 6i32 (u64:xor (u64:xor
				(state.get 6i32) (struct:get (work.get c2) b))
				(struct:get (work.get c2) d)))
			(state.set 7i32 (u64:xor (u64:xor
				(state.get 7i32) (struct:get (work.get c3) b))
				(struct:get (work.get c3) d)))))

	(fn blake2b_count
		(:doc "Advance the byte counter modulo 2^128, carrying out of the low limb.")
		(params (hash (mut-ref Blake2b)) (length i32))
		(returns void)
		(body
			(let low (u64:add (hash.get bytes_low) (u64:from-i32 length)))
			(if
				(:doc "A wrapped low word carries one into the high word.")
				(u64:lt low (hash.get bytes_low))
				(then (set (hash.get bytes_high)
					(u64:inc (hash.get bytes_high)))))
			(set (hash.get bytes_low) low)))

	(fn blake2b_update
		(:doc "Keep the final block pending, including a full block when input ends on its boundary.")
		(:expect
			(tests "stage-2/hashing/blake2b/cases.tsv")
			(issues "gh:wove-lang/wove:172" "gh:wove-lang/wove:238"))
		(params (hash (mut-ref Blake2b)) (bytes (shared-array u8)))
		(returns void)
		(body
			(if (i32:eqz bytes.len) (then (return)))
			(let-mut i 0i32)
			(if
				(:doc "A pending block becomes nonfinal only when another byte is known to follow it.")
				(i32:not-eqz (hash.get used))
				(then
					(while
						(:doc "Fill any remaining space in the pending block from the new input.")
						(bool:and (i32:lt (hash.get used) 128i32)
							(i32:lt i bytes.len))
						(body
							(array:set (hash.get block) (hash.get used)
								(bytes.get i))
							(set (hash.get used) (i32:inc (hash.get used)))
							(set i (i32:inc i))))
					(if (i32:eq i bytes.len) (then (return)))
					(call blake2b_count (borrow-mut hash) 128i32)
					(call blake2b_block
						(borrow-mut (hash.get words)) (borrow-shared (hash.get block))
						(hash.get bytes_low) (hash.get bytes_high) (bool false))
					(set (hash.get used) 0i32)))
			(while
				(:doc "Process complete nonfinal blocks directly from the caller's view.")
				(i32:lt 128i32 (i32:sub bytes.len i))
				(body
					(call blake2b_count (borrow-mut hash) 128i32)
					(call blake2b_block
						(borrow-mut (hash.get words))
						(borrow-shared (bytes.range i (i32:add i 128i32)))
						(hash.get bytes_low) (hash.get bytes_high) (bool false))
					(set i (i32:add i 128i32))))
			(while
				(:doc "Copy at most one block so callers can release or refill the input buffer.")
				(i32:lt i bytes.len)
				(body
					(array:set (hash.get block) (hash.get used)
						(bytes.get i))
					(set (hash.get used) (i32:inc (hash.get used)))
					(set i (i32:inc i))))))

	(fn blake2b_number
		(:doc "Feed one unsigned field in the cache's canonical little-endian representation.")
		(params (hash (mut-ref Blake2b)) (value u64))
		(returns void)
		(body
			(let bytes (u64:to-le-bytes value))
			(call blake2b_update (borrow-mut hash) (borrow-shared bytes))))

	(fn blake2b_field
		(:doc "Prefix every byte field with its length to retain the original field boundaries.")
		(params (hash (mut-ref Blake2b)) (data (shared-array u8)))
		(returns void)
		(body
			(call blake2b_number (borrow-mut hash) (u64:from-i32 data.len))
			(call blake2b_update (borrow-mut hash) (borrow-shared data))))

	(fn blake2b_words
		(:doc "Finalize a copy so a caller can continue updating after taking a digest.")
		(params (state Blake2b))
		(returns (array u64 4))
		(body
			(let-mut hash state)
			(let-mut i (hash.get used))
			(while
				(:doc "The counter excludes padding, including when hashing an empty stream.")
				(i32:lt i 128i32)
				(body
					(array:set (hash.get block) i 0u8)
					(set i (i32:inc i))))
			(let used (hash.get used))
			(call blake2b_count (borrow-mut hash) used)
			(call blake2b_block
				(borrow-mut (hash.get words)) (borrow-shared (hash.get block))
				(hash.get bytes_low) (hash.get bytes_high) (bool true))
			(return (array:new (array u64 4)
				(array:get (hash.get words) 0i32)
				(array:get (hash.get words) 1i32)
				(array:get (hash.get words) 2i32)
				(array:get (hash.get words) 3i32)))))

	(fn blake2b_digest_word
		(:doc "Read the first four little-endian bytes of a chaining word as one big-endian digest encoder word.")
		(params (word u64))
		(returns u32)
		(body
			(return (u32:from-u64
				(u64:or
					(u64:or
						(u64:or
							(u64:shl (u64:and word 255u64) 24i32)
							(u64:shl (u64:and word 65280u64) 8i32))
						(u64:and (u64:shr word 8i32) 65280u64))
					(u64:and (u64:shr word 24i32) 255u64))))))

	(fn blake2b_finish
		(:doc "Encode the complete checksum once for cache records and filenames.")
		(params (state Blake2b))
		(returns (owned-array u8))
		(body
			(let words (call blake2b_words state))
			(return (call digest_base62 (array:new (array u32 8)
				(call blake2b_digest_word (words.get 0i32))
				(call blake2b_digest_word (u64:shr (words.get 0i32) 32i32))
				(call blake2b_digest_word (words.get 1i32))
				(call blake2b_digest_word (u64:shr (words.get 1i32) 32i32))
				(call blake2b_digest_word (words.get 2i32))
				(call blake2b_digest_word (u64:shr (words.get 2i32) 32i32))
				(call blake2b_digest_word (words.get 3i32))
				(call blake2b_digest_word (u64:shr (words.get 3i32) 32i32)))))))
)
