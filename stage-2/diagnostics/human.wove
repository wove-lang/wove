(module diagnostic_human
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Render a structured diagnostic and its original source line for stderr.")

	(use wove-file "./record.wove" (only (type Diagnostic)))
	(use wove-file "../source/scan.wove" (only source_position is_line_ending))
	(use wove-file "../text/utf8.wove" (only valid_utf8_width))
	(use wove-file "../text/display_width.wove" (only utf8_cells))
	(use wove-file "../text/bytes.wove" (only write_byte))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_u32 write_decimal_i32))

	(struct SourceExcerpt
		(fields (available bool) (line u32) (column u32) (first i32) (last i32) (mark_end i32) (continues bool)))

	(let error_label ": error[")
	(let message_label "]: ")
	(let argv_label "argv[")
	(let excerpt_indent "\n  ")
	(let continuation " ...")

	(fn source_excerpt
		(:doc "Find the physical line containing the primary span and intersect it with that line.")
		(params (diagnostic Diagnostic) (source (shared-array u8)) (available bool)) (returns SourceExcerpt)
		(body
			(let start (struct:get diagnostic start))
			(let end (struct:get diagnostic end))
			(let length (array:len source))
			(if
				(:doc "An unavailable source or out-of-range start has only its path to display.")
				(bool:or (bool:not available) (bool:or (i32:ltz start) (i32:lt length start)))
				(then (return (struct:new SourceExcerpt (available (bool false)) (line 0u32) (column 0u32)
					(first 0i32) (last 0i32) (mark_end 0i32) (continues (bool false))))))
			(let position (call source_position (borrow-shared source) 0i32 start))
			(let-mut point start)
			(if
				(:doc "The LF following CR belongs to the next line according to source_position.")
				(bool:and (bool:and (i32:gtz point) (i32:lt point length))
					(bool:and (u8:eq (array:load source point) 10u8)
						(u8:eq (array:load source (i32:dec point)) 13u8)))
				(then (set point (i32:inc point))))
			(let-mut first point)
			(while
				(:doc "Stop at the nearest preceding CR or LF.")
				(bool:and (i32:gtz first)
					(bool:not (call is_line_ending (array:load source (i32:dec first)))))
				(body (set first (i32:dec first))))
			(let-mut last point)
			(while
				(:doc "The displayed line excludes its physical line ending.")
				(bool:and (i32:lt last length)
					(bool:not (call is_line_ending (array:load source last))))
				(body (set last (i32:inc last))))
			(let-mut mark_end end)
			(if (i32:lt last mark_end) (then (set mark_end last)))
			(return (struct:new SourceExcerpt (available (bool true)) (line (struct:get position line))
				(column (struct:get position column)) (first first) (last last)
				(mark_end mark_end) (continues (bool:and (i32:lt last length) (i32:lt last end)))))))

	(fn scalar_width
		(:doc "Count malformed source bytes individually, as source_position does.")
		(params (text (shared-array u8)) (index i32)) (returns i32)
		(body
			(let width (call valid_utf8_width (borrow-shared text) index (array:load text index)))
			(if (i32:eqz width) (then (return 1i32)))
			(return width)))

	(fn write_visible
		(:doc "Write printable UTF-8 and substitute a visible character for control or malformed bytes.")
		(params (text (shared-array u8)) (first i32) (last i32) (tabs bool) (output (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(let-mut index first)
			(let-mut next offset)
			(while
				(:doc "Copy a complete printable scalar or write a question mark for the invalid byte.")
				(i32:lt index last)
				(body
					(let byte (array:load text index))
					(let width (call valid_utf8_width (borrow-shared text) index byte))
					(let printable (bool:or
						(bool:and (u8:not-lt byte 32u8) (u8:lt byte 127u8))
						(bool:and tabs (u8:eq byte 9u8))))
					(let-mut finish (i32:inc index))
					(if
						(:doc "Keep complete multibyte characters inside the selected line or text.")
						(bool:and (i32:lt 1i32 width) (i32:not-lt (i32:sub last index) width))
						(then
							(set finish (i32:add index width))
							(set next (call append_bytes (borrow-shared (array:range text index finish))
								(borrow-mut output) next)))
						(else
							(let-mut visible 63u8)
							(if printable (then (set visible byte)))
							(set next (call write_byte (borrow-mut output) next visible))))
					(set index finish)))
			(return next)))

	(fn displayed_cells
		(:doc "Match the excerpt's printable scalar or one-cell replacement.")
		(params (source (shared-array u8)) (start i32) (bytes i32)) (returns i32)
		(body
			(if (i32:eq bytes 1i32) (then (return 1i32)))
			(return (call utf8_cells (borrow-shared source) start bytes))))

	(fn write_marker_cells
		(:doc "Write the marker once per display cell or preserve a tab's next stop.")
		(params (output (mut-array u8)) (offset i32) (mark u8) (cells i32)) (returns i32)
		(body
			(if (i32:eqz cells) (then (return offset)))
			(let next (call write_byte (borrow-mut output) offset mark))
			(if (i32:eq cells 2i32) (then (return (call write_byte (borrow-mut output) next mark))))
			(return next)))

	(fn write_excerpt
		(:doc "Place a caret and underline at the excerpt's display cells while retaining scalar coordinates in the heading.")
		(params (source (shared-array u8)) (excerpt SourceExcerpt) (output (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(let first (struct:get excerpt first))
			(let last (struct:get excerpt last))
			(let line (call append_bytes (borrow-shared excerpt_indent) (borrow-mut output) offset))
			(let text (call write_visible (borrow-shared source) first last
				(bool true) (borrow-mut output) line))
			(let-mut next (call append_bytes (borrow-shared excerpt_indent) (borrow-mut output) text))
			(let-mut cursor first)
			(let-mut column 1u32)
			(while
				(:doc "Advance to the scanner column and reserve as many cells as each preceding scalar displays.")
				(bool:and (i32:lt cursor last) (u32:lt column (struct:get excerpt column)))
				(body
					(let bytes (call scalar_width (borrow-shared source) cursor))
					(let cells (call displayed_cells (borrow-shared source) cursor bytes))
					(let-mut space 32u8)
					(if (u8:eq (array:load source cursor) 9u8) (then (set space 9u8)))
					(set next (call write_marker_cells (borrow-mut output) next space cells))
					(set cursor (i32:add cursor bytes))
					(set column (u32:inc column))))
			(set next (call write_byte (borrow-mut output) next 94u8))
			(let limit (struct:get excerpt mark_end))
			(if
				(:doc "The initial caret covers the first display cell. Empty spans still get one caret.")
				(i32:lt cursor limit)
				(then
					(let bytes (call scalar_width (borrow-shared source) cursor))
					(let cells (call displayed_cells (borrow-shared source) cursor bytes))
					(if
						(:doc "Include the other cell of a wide starting scalar.")
						(i32:eq cells 2i32)
						(then (set next (call write_byte (borrow-mut output) next 126u8))))
					(set cursor (i32:add cursor bytes))
					(while
						(:doc "Extend the underline across the remaining visible cells on the first line.")
						(i32:lt cursor limit)
						(body
							(let bytes (call scalar_width (borrow-shared source) cursor))
							(let cells (call displayed_cells (borrow-shared source) cursor bytes))
							(let-mut marker 126u8)
							(if (u8:eq (array:load source cursor) 9u8) (then (set marker 9u8)))
							(set next (call write_marker_cells (borrow-mut output) next marker cells))
							(set cursor (i32:add cursor bytes))))))
			(if
				(:doc "Indicate a span that continues past the displayed line.")
				(struct:get excerpt continues)
				(then (return (call append_bytes (borrow-shared continuation) (borrow-mut output) next))))
			(return next)))

	(fn write_human_location
		(:doc "Write the original path and readable coordinates, or the original argv index.")
		(params (diagnostic Diagnostic) (file (shared-array u8)) (excerpt SourceExcerpt) (output (mut-array u8)))
		(returns i32)
		(body
			(if
				(:doc "Argument diagnostics have no source line.")
				(u32:eq (struct:get diagnostic location) 2u32)
				(then
					(let begin (call append_bytes (borrow-shared argv_label) (borrow-mut output) 0i32))
					(let index (call write_decimal_i32 (borrow-mut output) begin
						(struct:get diagnostic argv_index)))
					(return (call write_byte (borrow-mut output) index 93u8))))
			(let name (call write_visible (borrow-shared file) 0i32 (array:len file)
				(bool false) (borrow-mut output) 0i32))
			(if
				(:doc "When source bytes could not be read, the filename still identifies the failure.")
				(bool:not (struct:get excerpt available))
				(then (return name)))
			(let separator (call write_byte (borrow-mut output) name 58u8))
			(let line (call write_decimal_u32 (borrow-mut output) separator (struct:get excerpt line)))
			(let colon (call write_byte (borrow-mut output) line 58u8))
			(return (call write_decimal_u32 (borrow-mut output) colon (struct:get excerpt column)))))

	(fn render_diagnostic_human
		(:doc "Return a complete human diagnostic without the final stderr line terminator.")
		(params (diagnostic Diagnostic) (message (shared-array u8)) (file (shared-array u8))
			(source (shared-array u8)) (available bool))
		(returns (owned-array u8))
		(body
			(let excerpt (call source_excerpt diagnostic (borrow-shared source) available))
			(let width (u64:from-i32 (i32:sub (struct:get excerpt last) (struct:get excerpt first))))
			(let names (u64:add (u64:from-i32 (array:len file)) (u64:from-i32 (array:len message))))
			(let capacity (u64:add 128u64 (u64:add names (u64:add width width))))
			(if
				(:doc "The header, one line, and its marker must fit the signed output extent.")
				(u64:lt 2147483647u64 capacity)
				(then
					(let empty (array:alloc u8 0i32))
					(return (move empty))))
			(let-mut output (array:alloc u8 (i32:from-u64 capacity)))
			(let location (call write_human_location diagnostic (borrow-shared file) excerpt
				(borrow-mut output)))
			(let error (call append_bytes (borrow-shared error_label) (borrow-mut output) location))
			(let code (call write_decimal_u32 (borrow-mut output) error (struct:get diagnostic code)))
			(let label (call append_bytes (borrow-shared message_label) (borrow-mut output) code))
			(let-mut end (call write_visible (borrow-shared message) 0i32 (array:len message)
				(bool false) (borrow-mut output) label))
			(if
				(:doc "Only source diagnostics with available bytes have an excerpt.")
				(struct:get excerpt available)
				(then (set end (call write_excerpt (borrow-shared source) excerpt
					(borrow-mut output) end))))
			(let-mut result (array:alloc u8 end))
			(let copied (call append_bytes (borrow-shared (array:range output 0i32 end)) (borrow-mut result) 0i32))
			(return (move result))))
)
