(module diagnostic_human
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc "Render a structured diagnostic and its original source line for stderr.")

	(use wove-file "./record.wove" (only (type Diagnostic)))
	(use wove-file "../source/scan.wove" (only source_position is_line_ending))
	(use wove-file "../text/utf8.wove" (only valid_utf8_width))
	(use wove-file "../text/display_width.wove" (only width_transitions utf8_cells))
	(use wove-file "../text/bytes.wove" (only write_byte))
	(use wove-file "../text/copy.wove" (only append_bytes))
	(use wove-file "../text/decimal_write.wove" (only write_decimal_u32 write_decimal_i32))

	(struct SourceExcerpt
		(fields (available bool) (line u32) (column u32) (first i32) (last i32) (mark_end i32) (continues bool)))

	(let error_label ": error[")
	(let message_label "]: ")
	(let argv_label "argv[")
	(let excerpt_indent "\n  ")
	(let continuation " ...")

	(fn source_excerpt
		(:doc "Find the physical line containing the primary span and intersect it with that line.")
		(params (diagnostic Diagnostic) (source (shared-array u8)) (available bool)) (returns SourceExcerpt)
		(body
			(let start (struct.get (local diagnostic) start))
			(let end (struct.get (local diagnostic) end))
			(let length (array.len (local source)))
			(if
				(:doc "An unavailable source or out-of-range start has only its path to display.")
				(bool.or (bool.not (local available)) (bool.or (i32.lt (local start) 0i32) (i32.lt (local length) (local start))))
				(then (return (struct.new SourceExcerpt (available (bool false)) (line 0u32) (column 0u32)
					(first 0i32) (last 0i32) (mark_end 0i32) (continues (bool false))))))
			(let position (call source_position (borrow-shared (local source)) 0i32 (local start)))
			(let-mut point (local start))
			(if
				(:doc "The LF following CR belongs to the next line according to source_position.")
				(bool.and (bool.and (i32.lt 0i32 (local point)) (i32.lt (local point) (local length)))
					(bool.and (u8.eq (array.load (local source) (local point)) 10u8)
						(u8.eq (array.load (local source) (i32.sub.wrapping (local point) 1i32)) 13u8)))
				(then (set (local point) (i32.add.wrapping (local point) 1i32))))
			(let-mut first (local point))
			(while
				(:doc "Stop at the nearest preceding CR or LF.")
				(bool.and (i32.lt 0i32 (local first))
					(bool.not (call is_line_ending (array.load (local source) (i32.sub.wrapping (local first) 1i32)))))
				(body (set (local first) (i32.sub.wrapping (local first) 1i32))))
			(let-mut last (local point))
			(while
				(:doc "The displayed line excludes its physical line ending.")
				(bool.and (i32.lt (local last) (local length))
					(bool.not (call is_line_ending (array.load (local source) (local last)))))
				(body (set (local last) (i32.add.wrapping (local last) 1i32))))
			(let-mut mark_end (local end))
			(if (i32.lt (local last) (local mark_end)) (then (set (local mark_end) (local last))))
			(return (struct.new SourceExcerpt (available (bool true)) (line (struct.get (local position) line))
				(column (struct.get (local position) column)) (first (local first)) (last (local last))
				(mark_end (local mark_end)) (continues (bool.and (i32.lt (local last) (local length)) (i32.lt (local last) (local end))))))))

	(fn scalar_width
		(:doc "Count malformed source bytes individually, as source_position does.")
		(params (text (shared-array u8)) (index i32)) (returns i32)
		(body
			(let width (call valid_utf8_width (borrow-shared (local text)) (local index) (array.load (local text) (local index))))
			(if (i32.eq (local width) 0i32) (then (return 1i32)))
			(return (local width))))

	(fn write_visible
		(:doc "Write printable UTF-8 and substitute a visible character for control or malformed bytes.")
		(params (text (shared-array u8)) (first i32) (last i32) (tabs bool) (output (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(let-mut index (local first))
			(let-mut next (local offset))
			(while
				(:doc "Copy a complete printable scalar or write a question mark for the invalid byte.")
				(i32.lt (local index) (local last))
				(body
					(let byte (array.load (local text) (local index)))
					(let width (call valid_utf8_width (borrow-shared (local text)) (local index) (local byte)))
					(let printable (bool.or
						(bool.and (bool.not (u8.lt (local byte) 32u8)) (u8.lt (local byte) 127u8))
						(bool.and (local tabs) (u8.eq (local byte) 9u8))))
					(let-mut finish (i32.add.wrapping (local index) 1i32))
					(if
						(:doc "Keep complete multibyte characters inside the selected line or text.")
						(bool.and (i32.lt 1i32 (local width)) (bool.not (i32.lt (i32.sub.wrapping (local last) (local index)) (local width))))
						(then
							(set (local finish) (i32.add.wrapping (local index) (local width)))
							(set (local next) (call append_bytes (borrow-shared (array.range (local text) (local index) (local finish)))
								(borrow-mut (local output)) (local next))))
						(else
							(let-mut visible 63u8)
							(if (local printable) (then (set (local visible) (local byte))))
							(set (local next) (call write_byte (borrow-mut (local output)) (local next) (local visible)))))
					(set (local index) (local finish))))
			(return (local next))))

	(fn displayed_cells
		(:doc "Match the excerpt's printable scalar or one-cell replacement.")
		(params (source (shared-array u8)) (start i32) (bytes i32) (transitions (shared-array u32))) (returns i32)
		(body
			(if (i32.eq (local bytes) 1i32) (then (return 1i32)))
			(return (call utf8_cells (borrow-shared (local source)) (local start) (local bytes)
				(borrow-shared (local transitions))))))

	(fn write_marker_cells
		(:doc "Write the marker once per display cell or preserve a tab's next stop.")
		(params (output (mut-array u8)) (offset i32) (mark u8) (cells i32)) (returns i32)
		(body
			(if (i32.eq (local cells) 0i32) (then (return (local offset))))
			(let next (call write_byte (borrow-mut (local output)) (local offset) (local mark)))
			(if (i32.eq (local cells) 2i32) (then (return (call write_byte (borrow-mut (local output)) (local next) (local mark)))))
			(return (local next))))

	(fn write_excerpt
		(:doc "Place a caret and underline at the excerpt's display cells while retaining scalar coordinates in the heading.")
		(params (source (shared-array u8)) (excerpt SourceExcerpt) (output (mut-array u8)) (offset i32))
		(returns i32)
		(body
			(let first (struct.get (local excerpt) first))
			(let last (struct.get (local excerpt) last))
			(let line (call append_bytes (borrow-shared (local excerpt_indent)) (borrow-mut (local output)) (local offset)))
			(let text (call write_visible (borrow-shared (local source)) (local first) (local last)
				(bool true) (borrow-mut (local output)) (local line)))
			(let-mut next (call append_bytes (borrow-shared (local excerpt_indent)) (borrow-mut (local output)) (local text)))
			(let transitions (call width_transitions))
			(let-mut cursor (local first))
			(let-mut column 1u32)
			(while
				(:doc "Advance to the scanner column and reserve as many cells as each preceding scalar displays.")
				(bool.and (i32.lt (local cursor) (local last)) (u32.lt (local column) (struct.get (local excerpt) column)))
				(body
					(let bytes (call scalar_width (borrow-shared (local source)) (local cursor)))
					(let cells (call displayed_cells (borrow-shared (local source)) (local cursor) (local bytes)
						(borrow-shared (local transitions))))
					(let-mut space 32u8)
					(if (u8.eq (array.load (local source) (local cursor)) 9u8) (then (set (local space) 9u8)))
					(set (local next) (call write_marker_cells (borrow-mut (local output)) (local next) (local space) (local cells)))
					(set (local cursor) (i32.add.wrapping (local cursor) (local bytes)))
					(set (local column) (u32.add.wrapping (local column) 1u32))))
			(set (local next) (call write_byte (borrow-mut (local output)) (local next) 94u8))
			(let limit (struct.get (local excerpt) mark_end))
			(if
				(:doc "The initial caret covers the first display cell. Empty spans still get one caret.")
				(i32.lt (local cursor) (local limit))
				(then
					(let bytes (call scalar_width (borrow-shared (local source)) (local cursor)))
					(let cells (call displayed_cells (borrow-shared (local source)) (local cursor) (local bytes)
						(borrow-shared (local transitions))))
					(if
						(:doc "Include the other cell of a wide starting scalar.")
						(i32.eq (local cells) 2i32)
						(then (set (local next) (call write_byte (borrow-mut (local output)) (local next) 126u8))))
					(set (local cursor) (i32.add.wrapping (local cursor) (local bytes)))
					(while
						(:doc "Extend the underline across the remaining visible cells on the first line.")
						(i32.lt (local cursor) (local limit))
						(body
							(let bytes (call scalar_width (borrow-shared (local source)) (local cursor)))
							(let cells (call displayed_cells (borrow-shared (local source)) (local cursor) (local bytes)
								(borrow-shared (local transitions))))
							(let-mut marker 126u8)
							(if (u8.eq (array.load (local source) (local cursor)) 9u8) (then (set (local marker) 9u8)))
							(set (local next) (call write_marker_cells (borrow-mut (local output)) (local next) (local marker) (local cells)))
							(set (local cursor) (i32.add.wrapping (local cursor) (local bytes)))))))
			(if
				(:doc "Indicate a span that continues past the displayed line.")
				(struct.get (local excerpt) continues)
				(then (return (call append_bytes (borrow-shared (local continuation)) (borrow-mut (local output)) (local next)))))
			(return (local next))))

	(fn write_human_location
		(:doc "Write the original path and readable coordinates, or the original argv index.")
		(params (diagnostic Diagnostic) (file (shared-array u8)) (excerpt SourceExcerpt) (output (mut-array u8)))
		(returns i32)
		(body
			(if
				(:doc "Argument diagnostics have no source line.")
				(u32.eq (struct.get (local diagnostic) location) 2u32)
				(then
					(let begin (call append_bytes (borrow-shared (local argv_label)) (borrow-mut (local output)) 0i32))
					(let index (call write_decimal_i32 (borrow-mut (local output)) (local begin)
						(struct.get (local diagnostic) argv_index)))
					(return (call write_byte (borrow-mut (local output)) (local index) 93u8))))
			(let name (call write_visible (borrow-shared (local file)) 0i32 (array.len (local file))
				(bool false) (borrow-mut (local output)) 0i32))
			(if
				(:doc "When source bytes could not be read, the filename still identifies the failure.")
				(bool.not (struct.get (local excerpt) available))
				(then (return (local name))))
			(let separator (call write_byte (borrow-mut (local output)) (local name) 58u8))
			(let line (call write_decimal_u32 (borrow-mut (local output)) (local separator) (struct.get (local excerpt) line)))
			(let colon (call write_byte (borrow-mut (local output)) (local line) 58u8))
			(return (call write_decimal_u32 (borrow-mut (local output)) (local colon) (struct.get (local excerpt) column)))))

	(fn render_diagnostic_human
		(:doc "Return a complete human diagnostic without the final stderr line terminator.")
		(params (diagnostic Diagnostic) (message (shared-array u8)) (file (shared-array u8))
			(source (shared-array u8)) (available bool))
		(returns (owned-array u8))
		(body
			(let excerpt (call source_excerpt (local diagnostic) (borrow-shared (local source)) (local available)))
			(let width (int.convert u64 (i32.sub.wrapping (struct.get (local excerpt) last) (struct.get (local excerpt) first))))
			(let names (u64.add.wrapping (int.convert u64 (array.len (local file))) (int.convert u64 (array.len (local message)))))
			(let capacity (u64.add.wrapping 128u64 (u64.add.wrapping (local names) (u64.add.wrapping (local width) (local width)))))
			(if
				(:doc "The header, one line, and its marker must fit the signed output extent.")
				(u64.lt 2147483647u64 (local capacity))
				(then
					(let empty (array.alloc u8 0i32))
					(return (move (local empty)))))
			(let-mut output (array.alloc u8 (int.convert i32 (local capacity))))
			(let location (call write_human_location (local diagnostic) (borrow-shared (local file)) (local excerpt)
				(borrow-mut (local output))))
			(let error (call append_bytes (borrow-shared (local error_label)) (borrow-mut (local output)) (local location)))
			(let code (call write_decimal_u32 (borrow-mut (local output)) (local error) (struct.get (local diagnostic) code)))
			(let label (call append_bytes (borrow-shared (local message_label)) (borrow-mut (local output)) (local code)))
			(let-mut end (call write_visible (borrow-shared (local message)) 0i32 (array.len (local message))
				(bool false) (borrow-mut (local output)) (local label)))
			(if
				(:doc "Only source diagnostics with available bytes have an excerpt.")
				(struct.get (local excerpt) available)
				(then (set (local end) (call write_excerpt (borrow-shared (local source)) (local excerpt)
					(borrow-mut (local output)) (local end)))))
			(let-mut result (array.alloc u8 (local end)))
			(let copied (call append_bytes (borrow-shared (array.range (local output) 0i32 (local end))) (borrow-mut (local result)) 0i32))
			(return (move (local result)))))
)
