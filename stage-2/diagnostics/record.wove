(module diagnostic_record
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Carry one diagnostic code and its original input coordinates.

	Location 1 names a source file and uses a half-open byte span.
	Location 2 uses an index in the user argv, excluding the executable.
	The caller supplies borrowed UTF-8 message and source-name text
	when rendering this copyable scalar record.`)

	(struct Diagnostic (fields (code u32) (location u32) (start i32) (end i32) (argv_index i32)))

	(fn diagnostic_source
		(:doc `Keep the originating half-open span in its source file.`)
		(params (code u32) (start i32) (end i32))
		(returns Diagnostic)
		(body
			(return (record.make Diagnostic (code (local code)) (location (u32 1))
				(start (local start)) (end (local end)) (argv_index (i32 -1))))))

	(fn diagnostic_argv
		(:doc `Keep the original zero-based user argv index.`)
		(params (code u32) (index i32))
		(returns Diagnostic)
		(body
			(return (record.make Diagnostic (code (local code)) (location (u32 2))
				(start (i32 -1)) (end (i32 -1)) (argv_index (local index)))))))
