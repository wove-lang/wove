(module diagnostic_json
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Serialize one structured diagnostic into caller-owned JSON bytes.

	Preserve the caller’s numeric code and original coordinates. The
	location object tags either a source file and its half-open byte span
	or a zero-based user argv index. The shared JSON writer handles UTF-8,
	escaping, and the caller’s output and nesting capacities.`)

	(use wove-file "./record.wove" (only (type Diagnostic)))
	(use wove-file "../json/writer.wove"
		(only (type JsonWriter) json_writer writer_error json_begin_object json_end_object
			json_key json_string json_u32 json_i32 json_finish))

	(let code_name "code")
	(let message_name "message")
	(let location_name "location")
	(let kind_name "kind")
	(let source_tag "source")
	(let argv_tag "argv")
	(let file_name "file")
	(let start_name "start")
	(let end_name "end")
	(let index_name "index")

	(fn write_source_members
		(:doc `Write the source tag, source name, and original half-open byte span.`)
		(params (writer JsonWriter) (diagnostic Diagnostic) (source_name (shared-array u8))
			(output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body
			(let kind (call json_string writer (borrow-mut output) (borrow-mut stack)
				(borrow-shared source_tag)))
			(let file_key (call json_key kind (borrow-mut output) (borrow-mut stack)
				(borrow-shared file_name)))
			(let file (call json_string file_key (borrow-mut output) (borrow-mut stack)
				(borrow-shared source_name)))
			(let start_key (call json_key file (borrow-mut output) (borrow-mut stack)
				(borrow-shared start_name)))
			(let start (call json_i32 start_key (borrow-mut output) (borrow-mut stack)
				diagnostic/start))
			(let end_key (call json_key start (borrow-mut output) (borrow-mut stack)
				(borrow-shared end_name)))
			(return (call json_i32 end_key (borrow-mut output) (borrow-mut stack)
				diagnostic/end))))

	(fn write_location
		(:doc `Open the location object and write the fields belonging to the chosen tag.`)
		(params (writer JsonWriter) (diagnostic Diagnostic) (source_name (shared-array u8))
			(output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body
			(let object (call json_begin_object writer (borrow-mut output) (borrow-mut stack)))
			(let kind_key (call json_key object (borrow-mut output) (borrow-mut stack)
				(borrow-shared kind_name)))
			(if
				(:doc "A source location includes its file and byte span.")
				(u32:eq diagnostic/location 1u32)
				(then (return (call write_source_members kind_key diagnostic
					(borrow-shared source_name)
					(borrow-mut output) (borrow-mut stack)))))
			(let kind (call json_string kind_key (borrow-mut output) (borrow-mut stack)
				(borrow-shared argv_tag)))
			(let index_key (call json_key kind (borrow-mut output) (borrow-mut stack)
				(borrow-shared index_name)))
			(return (call json_i32 index_key (borrow-mut output) (borrow-mut stack)
				diagnostic/argv_index))))

	(fn write_diagnostic_json
		(:doc `Write a standalone JSON object and return the writer status and byte count.

		Supply the diagnostic's message and, for a source location, its
		source name as UTF-8 views. Supply two nesting bytes and enough
		output for the document. Use the output prefix on success. Error 1
		means output capacity, 2 nesting capacity, 3 an unknown location
		tag, and 4 invalid UTF-8. Discard the output on error.`)
		(:expect
			(tests "stage-2/diagnostics/json.wove")
			(issues "gh:wove-lang/wove:137"))
		(params (diagnostic Diagnostic) (message (shared-array u8)) (source_name (shared-array u8))
			(output (mut-array u8)) (stack (mut-array u8)))
		(returns JsonWriter)
		(body
			(let writer (call json_writer))
			(let location diagnostic/location)
			(if
				(:doc "Only recognized location tags select an output shape.")
				(bool:not (bool:or (u32:eq location 1u32) (u32:eq location 2u32)))
				(then (return (call writer_error writer 3u32))))
			(let object (call json_begin_object writer (borrow-mut output) (borrow-mut stack)))
			(let code_key (call json_key object (borrow-mut output) (borrow-mut stack)
				(borrow-shared code_name)))
			(let code (call json_u32 code_key (borrow-mut output) (borrow-mut stack)
				diagnostic/code))
			(let message_key (call json_key code (borrow-mut output) (borrow-mut stack)
				(borrow-shared message_name)))
			(let text (call json_string message_key (borrow-mut output) (borrow-mut stack)
				(borrow-shared message)))
			(let location_key (call json_key text (borrow-mut output) (borrow-mut stack)
				(borrow-shared location_name)))
			(let fields (call write_location location_key diagnostic
				(borrow-shared source_name)
				(borrow-mut output) (borrow-mut stack)))
			(let closed (call json_end_object fields (borrow-mut output) (borrow-shared stack)))
			(return (call json_finish
				(call json_end_object closed (borrow-mut output) (borrow-shared stack)))))))
