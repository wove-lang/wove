(module
	(:copyright "Copyright (c) 2026 wove contributors")
	(:license "SPDX-License-Identifier: MIT OR Apache-2.0")
	(:doc `Serialize one structured diagnostic into caller-owned JSON bytes.

	Preserve the caller’s numeric code and original coordinates. The
	location object tags either a source file and its half-open byte span
	or a zero-based user argv index. The shared JSON writer handles UTF-8,
	escaping, and the caller’s output and nesting capacities.`)
	diagnostic_json

	(use wove-file "./record.wove" (only (type Diagnostic)))
	(use wove-file "../json/writer.wove"
		(only (type JsonWriter) json_writer writer_error json_begin_object json_end_object
			json_key json_string json_u32 json_i32 json_finish))

	(fn
		(:doc `Pack the fixed JSON keys and location tags into one byte view.`)
		write_diagnostic_names
		(params (names (mut-slice u8)))
		(returns void)
		(body
			(slice.store (:doc "code") (local names) (i32 0) (u8 99))
			(slice.store (local names) (i32 1) (u8 111))
			(slice.store (local names) (i32 2) (u8 100))
			(slice.store (local names) (i32 3) (u8 101))
			(slice.store (:doc "message") (local names) (i32 4) (u8 109))
			(slice.store (local names) (i32 5) (u8 101))
			(slice.store (local names) (i32 6) (u8 115))
			(slice.store (local names) (i32 7) (u8 115))
			(slice.store (local names) (i32 8) (u8 97))
			(slice.store (local names) (i32 9) (u8 103))
			(slice.store (local names) (i32 10) (u8 101))
			(slice.store (:doc "location") (local names) (i32 11) (u8 108))
			(slice.store (local names) (i32 12) (u8 111))
			(slice.store (local names) (i32 13) (u8 99))
			(slice.store (local names) (i32 14) (u8 97))
			(slice.store (local names) (i32 15) (u8 116))
			(slice.store (local names) (i32 16) (u8 105))
			(slice.store (local names) (i32 17) (u8 111))
			(slice.store (local names) (i32 18) (u8 110))
			(slice.store (:doc "kind") (local names) (i32 19) (u8 107))
			(slice.store (local names) (i32 20) (u8 105))
			(slice.store (local names) (i32 21) (u8 110))
			(slice.store (local names) (i32 22) (u8 100))
			(slice.store (:doc "source") (local names) (i32 23) (u8 115))
			(slice.store (local names) (i32 24) (u8 111))
			(slice.store (local names) (i32 25) (u8 117))
			(slice.store (local names) (i32 26) (u8 114))
			(slice.store (local names) (i32 27) (u8 99))
			(slice.store (local names) (i32 28) (u8 101))
			(slice.store (:doc "argv") (local names) (i32 29) (u8 97))
			(slice.store (local names) (i32 30) (u8 114))
			(slice.store (local names) (i32 31) (u8 103))
			(slice.store (local names) (i32 32) (u8 118))
			(slice.store (:doc "file") (local names) (i32 33) (u8 102))
			(slice.store (local names) (i32 34) (u8 105))
			(slice.store (local names) (i32 35) (u8 108))
			(slice.store (local names) (i32 36) (u8 101))
			(slice.store (:doc "start") (local names) (i32 37) (u8 115))
			(slice.store (local names) (i32 38) (u8 116))
			(slice.store (local names) (i32 39) (u8 97))
			(slice.store (local names) (i32 40) (u8 114))
			(slice.store (local names) (i32 41) (u8 116))
			(slice.store (:doc "end") (local names) (i32 42) (u8 101))
			(slice.store (local names) (i32 43) (u8 110))
			(slice.store (local names) (i32 44) (u8 100))
			(slice.store (:doc "index") (local names) (i32 45) (u8 105))
			(slice.store (local names) (i32 46) (u8 110))
			(slice.store (local names) (i32 47) (u8 100))
			(slice.store (local names) (i32 48) (u8 101))
			(slice.store (local names) (i32 49) (u8 120))))

	(fn
		(:doc `Write the source tag, source name, and original half-open byte span.`)
		write_source_members
		(params (writer JsonWriter) (diagnostic Diagnostic) (names (shared-slice u8)) (source_name (shared-slice u8))
			(output (mut-slice u8)) (stack (mut-slice u8)))
		(returns JsonWriter)
		(body
			(let kind (call json_string (local writer) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 23) (i32 29)))))
			(let file_key (call json_key (local kind) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 33) (i32 37)))))
			(let file (call json_string (local file_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (local source_name))))
			(let start_key (call json_key (local file) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 37) (i32 42)))))
			(let start (call json_i32 (local start_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(record.get (local diagnostic) start)))
			(let end_key (call json_key (local start) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 42) (i32 45)))))
			(return (call json_i32 (local end_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(record.get (local diagnostic) end)))))

	(fn
		(:doc `Open the location object and write the fields belonging to the chosen tag.`)
		write_location
		(params (writer JsonWriter) (diagnostic Diagnostic) (names (shared-slice u8)) (source_name (shared-slice u8))
			(output (mut-slice u8)) (stack (mut-slice u8)))
		(returns JsonWriter)
		(body
			(let object (call json_begin_object (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let kind_key (call json_key (local object) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 19) (i32 23)))))
			(if
				(:doc "A source location includes its file and byte span.")
				(u32.eq (record.get (local diagnostic) location) (u32 1))
				(then (return (call write_source_members (local kind_key) (local diagnostic)
					(borrow-shared (local names)) (borrow-shared (local source_name))
					(borrow-mut (local output)) (borrow-mut (local stack))))))
			(let kind (call json_string (local kind_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 29) (i32 33)))))
			(let index_key (call json_key (local kind) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 45) (i32 50)))))
			(return (call json_i32 (local index_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(record.get (local diagnostic) argv_index)))))

	(fn
		(:doc `Write a standalone JSON object and return the writer status and byte count.

		Supply the diagnostic's message and, for a source location, its
		source name as UTF-8 views. Supply two nesting bytes and enough
		output for the document. Use the output prefix on success. Error 1
		means output capacity, 2 nesting capacity, 3 an unknown location
		tag, and 4 invalid UTF-8. Discard the output on error.`)
		(:expect
			(tests "stage-2/diagnostics/json.wove")
			(issues "gh:wove-lang/wove:137"))
		write_diagnostic_json
		(params (diagnostic Diagnostic) (message (shared-slice u8)) (source_name (shared-slice u8))
			(output (mut-slice u8)) (stack (mut-slice u8)))
		(returns JsonWriter)
		(body
			(let writer (call json_writer))
			(let location (record.get (local diagnostic) location))
			(if
				(:doc "Only recognized location tags select an output shape.")
				(bool.not (bool.or (u32.eq (local location) (u32 1)) (u32.eq (local location) (u32 2))))
				(then (return (call writer_error (local writer) (u32 3)))))
			(let-mut names (array.alloc u8 (i32 50)))
			(call write_diagnostic_names (borrow-mut (local names)))
			(let object (call json_begin_object (local writer) (borrow-mut (local output)) (borrow-mut (local stack))))
			(let code_key (call json_key (local object) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 0) (i32 4)))))
			(let code (call json_u32 (local code_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(record.get (local diagnostic) code)))
			(let message_key (call json_key (local code) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 4) (i32 11)))))
			(let text (call json_string (local message_key) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (local message))))
			(let location_key (call json_key (local text) (borrow-mut (local output)) (borrow-mut (local stack))
				(borrow-shared (slice.range (local names) (i32 11) (i32 19)))))
			(let fields (call write_location (local location_key) (local diagnostic)
				(borrow-shared (local names)) (borrow-shared (local source_name))
				(borrow-mut (local output)) (borrow-mut (local stack))))
			(let closed (call json_end_object (local fields) (borrow-mut (local output)) (borrow-shared (local stack))))
			(return (call json_finish
				(call json_end_object (local closed) (borrow-mut (local output)) (borrow-shared (local stack))))))))
