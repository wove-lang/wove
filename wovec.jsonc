// Named profiles inherit omitted settings from the default profile.
{
	"profiles": [
		{
			"name": "default",
			"parallel": true,
			// Zero selects automatic sizing.
			"parallelJobs": 0,
			"time": false,
			"human": false,
			"max-errors": 20,
			"color": true,
			"build": {
				"default": {
					"cache": true,
					"cflags": ["-O1"],
					"defines": [],
					"ldflags": [],
					"ldlibs": [],
					"links": [],
					"lto": "off",
					"output": null,
				},
				"debug": {
					"cache": true,
					"cflags": ["-O0", "-g"],
					"defines": [],
					"ldflags": [],
					"ldlibs": [],
					"links": [],
					"lto": "off",
					"output": null,
				},
				"release": {
					"cache": true,
					"cflags": ["-O3"],
					"defines": [],
					"ldflags": [],
					"ldlibs": [],
					"links": [],
					"lto": "thin",
					"output": null,
				},
			},
			"cc": {
				"checkTests": false,
				"cstd": "c11",
				"defines": [],
				"flat": true,
				"skip": ["build", "tests"],
				"warn": {
					"blockComments": true,
					"inlineBlockComments": false,
					"unusedImports": true,
					"unwrapComments": true,
				},
				"warningsAsErrors": true,
			},
			"entry": {
				"bin": ["stage-2/wovec.wove"],
				"lib": [],
			},
			"fmt": {
				"blankLines": 1,
				"bridgeComments": false,
				"caseSensitive": false,
				// Set checkFormatting to override the command's default check policy.
				"checkWidth": false,
				"delimiterLayout": false,
				"duplicateImports": true,
				"expandInlineBlocks": false,
				"finalNewline": true,
				"functionComments": true,
				"guardedImportsGrouping": true,
				"guardedImportsLast": true,
				"importOrder": ["system-headers", "local-headers", "standard-modules", "local-modules"],
				"indent": "tabs",
				"indentWidth": 4,
				"inlineBlocks": false,
				"leadingTernaryOperators": false,
				"lineEndings": "lf",
				// Zero selects automatic sizing.
				"lineWidth": 0,
				"multilineFunctions": false,
				"noFail": false,
				"normalizeSpacing": false,
				"packImportMembers": false,
				"reflowContinuations": false,
				"removeImportBlankLines": true,
				// Omit semicolons to retain the source's existing separators.
				"separateBlocks": false,
				"separateImportGroups": false,
				"separateLocalDeclarations": false,
				"separateTopLevelDeclarations": false,
				"skip": ["build", "tests"],
				"sortImportMembers": false,
				"sortImports": false,
				"trimTrailingWhitespace": true,
			},
		},
		{
			"name": "bootstrap",
			"build": {
				"default": {
					"cache": false,
					"cflags": ["-O1", "-fno-inline-functions"],
					"lto": "off",
				},
			},
			"cc": {
				"flat": true,
			},
			"entry": {
				"bin": ["stage-2/wovec.wove"],
			},
		},
		{
			"name": "tests",
			"cc": {
				"checkTests": true,
				"skip": [
					"build",
					"stage-1",
					"stage-2",
					"examples",
					"tests/bootstrap",
					"tests/cases",
					"tests/fixtures",
					"tests/language/configuration.wove",
				],
				"warn": {
					"blockComments": false,
				},
				"warningsAsErrors": false,
			},
			"entry": {
				"bin": [],
				"lib": [],
			},
			"fmt": {
				"functionComments": false,
				"skip": [
					"build",
					"stage-1",
					"stage-2",
					"examples",
					"tests/bootstrap",
					"tests/cases",
					"tests/fixtures",
					"tests/language/configuration.wove",
				],
			},
		},
	],
}
