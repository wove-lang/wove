// Named profiles inherit omitted settings from the default profile.
// Uncomment a setting to supply it explicitly.
//
// Invocation controls
// --profile NAME selects a named profile.
// --debug and --release select a build mode. Omitting both selects default.
// bin --compiler clang selects the native compiler used by the current driver.
// wovec cc --check entry.wove checks the selected source and imports.
// Check-only invocations need no output target.
// --clear-defines clears inherited and earlier definitions.
// -- ends option parsing. wovec --version displays the compiler version.
{
	"profiles": [
		{
			"name": "default",
			// "parallel": true,
			// Zero selects automatic sizing.
			// "parallelJobs": 0,
			// "time": false,
			// "human": false,
			// --max-errors overrides max-errors.
			// "max-errors": 20,
			// color is config-only.
			// "color": true,
			"build": {
				"default": {
					// "cache": true,
					// "cflags": ["-O1"],
					// "defines": [],
					// "ldflags": [],
					// "ldlibs": [],
					// "links": [],
					// "lto": "off",
					// "output": null,
				},
				"debug": {
					// "cache": true,
					// "cflags": ["-O0", "-g"],
					// "defines": [],
					// "ldflags": [],
					// "ldlibs": [],
					// "links": [],
					// "lto": "off",
					// "output": null,
				},
				"release": {
					// "cache": true,
					// "cflags": ["-O3"],
					// "defines": [],
					// "ldflags": [],
					// "ldlibs": [],
					// "links": [],
					// "lto": "thin",
					// "output": null,
				},
			},
			"cc": {
				// "cstd": "c11",
				// "defines": [],
				// "flat": true,
			},
			"entry": {
				// Built-in "bin": [],
				"bin": ["stage-2/wovec.wove"],
				// "lib": [],
			},
			"fmt": {
				// fmt --line-width overrides lineWidth. Zero selects automatic sizing.
				// "lineWidth": 0,
			},
		},
		{
			"name": "bootstrap",
			"build": {
				"default": {
					// Built-in "cache": true,
					"cache": false,
					// Built-in "cflags": ["-O1"],
					"cflags": ["-O1", "-fno-inline-functions"],
				},
			},
		},
		{
			"name": "tests",
			"entry": {
				// Built-in "bin": [],
				// An empty override clears the default profile's entry.
				"bin": [],
			},
		},
	],
}
