// Named profiles inherit omitted settings from the default profile.
// Uncomment a setting to supply it explicitly.
//
// Invocation controls
// --profile NAME selects a named profile.
// --debug and --release select a build mode. Omitting both selects default.
// CLANG selects the Clang executable for native builds and C-header discovery.
// cc and bin take an explicit source and output target (-o).
// wovec cc --check first.wove second.wove checks each entry and its imports.
// Check-only invocations accept one or more entries and need no output target.
// --clear-defines clears inherited and earlier definitions.
// -- ends option parsing. wovec --version displays the compiler version.
{
	"profiles": [
		{
			"name": "default",
			// Builds run serially.
			// "parallel": false,
			// --human shows source excerpts. --no-human selects JSON Lines.
			// "human": false,
			"build": {
				"default": {
					// "cflags": ["-O1"],
					// "defines": [],
					// "ldflags": [],
					// "ldlibs": [],
					// "links": [],
					// "lto": "off",
				},
				"debug": {
					// "cflags": ["-O0", "-g"],
					// "defines": [],
					// "ldflags": [],
					// "ldlibs": [],
					// "links": [],
					// "lto": "off",
				},
				"release": {
					// "cflags": ["-O3"],
					// "defines": [],
					// "ldflags": [],
					// "ldlibs": [],
					// "links": [],
					// "lto": "thin",
				},
			},
			"cc": {
				// "cstd": "c11",
				// "defines": [],
			},
		},
		{
			"name": "bootstrap",
			"build": {
				"default": {
					// Built-in "cflags": ["-O1"],
					"cflags": ["-O1", "-fno-inline-functions"],
				},
			},
		},
		{ "name": "tests", },
	],
}
