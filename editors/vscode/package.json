{
	"name": "wove-language",
	"displayName": "Wove Language",
	"description": "Syntax highlighting and delimiter pairing for Wove source files.",
	"version": "0.1.0",
	"publisher": "wove-lang",
	"license": "MIT OR Apache-2.0",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Programming Languages"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/wove-lang/wove.git",
		"directory": "editors/vscode"
	},
	"files": [
		"language-configuration.json",
		"language-configuration.json.license",
		"package.json.license",
		"syntaxes/",
		"LICENSE",
		"LICENSE-MIT",
		"LICENSE-APACHE"
	],
	"contributes": {
		"languages": [
			{
				"id": "wove",
				"aliases": [
					"Wove",
					"wove"
				],
				"extensions": [
					".wove"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "wove",
				"scopeName": "source.wove",
				"path": "./syntaxes/wove.tmLanguage.json"
			}
		]
	}
}
