{
	"name": "Wove",
	"scopeName": "source.wove",
	"patterns": [
		{
			"include": "#form-heads"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#literals"
		},
		{
			"include": "#atoms"
		},
		{
			"name": "punctuation.section.parens.end.wove",
			"match": "\\)"
		},
		{
			"name": "invalid.illegal.wove",
			"match": ";"
		}
	],
	"repository": {
		"form-heads": {
			"comment": "Consume one head after each opening parenthesis. The fixed module and function name slots may continue on a later line.",
			"patterns": [
				{
					"begin": "(\\()\\s*(module)(?=$|[\\s()\"'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "([A-Za-z_][A-Za-z0-9_]*)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "entity.name.namespace.wove"
						}
					}
				},
				{
					"begin": "(\\()\\s*(fn)(?=$|[\\s()\"'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "([A-Za-z_][A-Za-z0-9_]*)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "entity.name.function.wove"
						}
					}
				},
				{
					"begin": "(\\()\\s*(bool)(?=$|[\\s()\"'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "(true|false)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "constant.language.wove"
						}
					}
				},
				{
					"begin": "(\\()",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						}
					},
					"end": "(:[A-Za-z_][A-Za-z0-9_.-]*)(?=$|[\\s()\"'`;])|((?:[iu](?:8|16|32|64|128|256)|f(?:16|32|64|80|128)|bool|void))(?=$|[\\s()\"'`;])|([A-Za-z_][A-Za-z0-9_.-]*)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "storage.modifier.annotation.wove"
						},
						"2": {
							"name": "storage.type.wove"
						},
						"3": {
							"name": "keyword.control.wove"
						}
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.wove",
					"begin": "(\")",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.wove"
						}
					},
					"end": "(\")|(?=$)",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.wove"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.wove",
							"match": "\\\\(?:[\"\\\\/bfnrt0]|u[0-9A-Fa-f]{4})"
						}
					]
				},
				{
					"name": "string.quoted.single.wove",
					"begin": "(')",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.wove"
						}
					},
					"end": "(')|(?=$)",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.wove"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.wove",
							"match": "\\\\(?:[0abtnvfr'\\\\]|x[0-9A-Fa-f]{2})"
						}
					]
				},
				{
					"name": "string.quoted.other.raw.wove",
					"begin": "(`)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.wove"
						}
					},
					"end": "(`)(?!`)",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.wove"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.wove",
							"match": "``"
						}
					]
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"name": "constant.numeric.float.wove",
					"match": "-?[0-9]+(?:(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)(?:f(?:16|32|64|80|128))?|f(?:16|32|64|80|128))(?=$|[\\s()\"'`;])"
				},
				{
					"name": "constant.numeric.integer.wove",
					"match": "-?(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|[0-9](?:_?[0-9])*)(?:[iu](?:8|16|32|64|128|256))?(?=$|[\\s()\"'`;])"
				}
			]
		},
		"atoms": {
			"comment": "Consume any remaining atom whole so an invalid spelling cannot accidentally color only a suffix.",
			"patterns": [
				{
					"name": "storage.type.wove",
					"match": "(?:[iu](?:8|16|32|64|128|256)|f(?:16|32|64|80|128)|bool|void)(?=$|[\\s()\"'`;])"
				},
				{
					"name": "variable.other.wove",
					"match": "[A-Za-z_][A-Za-z0-9_]*(?=$|[\\s()\"'`;])"
				},
				{
					"match": "[^\\s()\"'`;]+"
				}
			]
		}
	}
}
