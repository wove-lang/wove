{
	"name": "Wove",
	"scopeName": "source.wove",
	"patterns": [
		{
			"include": "#form-heads"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#literals"
		},
		{
			"name": "meta.constructor.wove",
			"match": "(?<![A-Za-z0-9_./:-])([A-Za-z_][A-Za-z0-9_]*)(\\.)(new)(?=$|[\\s()\"'`;])",
			"captures": {
				"1": { "name": "entity.name.type.wove" },
				"2": { "name": "punctuation.accessor.wove" },
				"3": { "name": "support.function.builtin.wove" }
			}
		},
		{
			"name": "meta.receiver.wove",
			"match": "(?<![A-Za-z0-9_./:-])([A-Za-z_][A-Za-z0-9_]*)((?:/[A-Za-z_][A-Za-z0-9_]*)*)((?:\\.[A-Za-z_][A-Za-z0-9_-]*)+)(?=$|[\\s()\"'`;])",
			"captures": {
				"1": { "name": "variable.other.wove" },
				"2": { "name": "variable.other.member.wove" },
				"3": { "patterns": [{ "include": "#receiver-operations" }] }
			}
		},
		{
			"name": "meta.field-path.wove",
			"match": "(?<![A-Za-z0-9_./:-])([A-Za-z_][A-Za-z0-9_]*)((?:/[A-Za-z_][A-Za-z0-9_]*)+)(?=$|[\\s()\"'`;])",
			"captures": {
				"1": { "name": "variable.other.wove" },
				"2": { "name": "variable.other.member.wove" }
			}
		},
		{
			"include": "#atoms"
		},
		{
			"name": "punctuation.section.parens.end.wove",
			"match": "\\)"
		},
		{
			"name": "invalid.illegal.wove",
			"match": ";"
		}
	],
	"repository": {
		"receiver-operations": {
			"patterns": [
				{ "match": "\\.", "name": "punctuation.accessor.wove" },
				{ "match": "[A-Za-z_][A-Za-z0-9_-]*", "name": "support.function.builtin.wove" }
			]
		},
		"form-heads": {
			"comment": "Consume one head after each opening parenthesis. Fixed name slots may continue on a later line.",
			"patterns": [
				{
					"begin": "(\\()\\s*(module)(?=$|[\\s()\"'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "([A-Za-z_][A-Za-z0-9_]*)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "entity.name.namespace.wove"
						}
					}
				},
				{
					"begin": "(\\()\\s*(fn)(?=$|[\\s()\"'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "([A-Za-z_][A-Za-z0-9_]*)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "entity.name.function.wove"
						}
					}
				},
				{
					"begin": "(\\()\\s*(const|let-mut|let)(?=$|[\\s()\"\\'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "([A-Za-z_][A-Za-z0-9_]*)(?=$|[\\s()\"\\'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "variable.other.definition.wove"
						}
					}
				},
				{
					"begin": "(\\()\\s*(struct|enum|type)(?=$|[\\s()\"\\'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "([A-Za-z_][A-Za-z0-9_]*)(?=$|[\\s()\"\\'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "entity.name.type.wove"
						}
					}
				},
				{
					"begin": "(\\()\\s*(bool)(?=$|[\\s()\"'`;])",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						},
						"2": {
							"name": "keyword.control.wove"
						}
					},
					"end": "(true|false)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "constant.language.wove"
						}
					}
				},
				{
					"begin": "(\\()",
					"beginCaptures": {
						"1": {
							"name": "punctuation.section.parens.begin.wove"
						}
					},
					"end": "(:[A-Za-z_][A-Za-z0-9_.-]*)(?=$|[\\s()\"'`;])|((?:[iu](?:8|16|32|64|128|256)|f(?:16|32|64|80|128)|bool|void))(?=$|[\\s()\"'`;])|(array:(?:load|store))(?=$|[\\s()\"'`;])|([A-Za-z_][A-Za-z0-9_-]*:[A-Za-z_][A-Za-z0-9_-]*)(?=$|[\\s()\"'`;])|([A-Za-z_][A-Za-z0-9_]*)(\\.)(new)(?=$|[\\s()\"'`;])|([A-Za-z_][A-Za-z0-9_]*)((?:/[A-Za-z_][A-Za-z0-9_]*)*)((?:\\.[A-Za-z_][A-Za-z0-9_-]*)+)(?=$|[\\s()\"'`;])|([A-Za-z_][A-Za-z0-9_.-]*)(?=$|[\\s()\"'`;])|(?=\\S)",
					"endCaptures": {
						"1": {
							"name": "storage.modifier.annotation.wove"
						},
						"2": {
							"name": "storage.type.wove"
						},
						"3": {
							"name": "invalid.illegal.wove"
						},
						"4": {
							"name": "support.function.builtin.wove"
						},
						"5": {
							"name": "entity.name.type.wove"
						},
						"6": {
							"name": "punctuation.accessor.wove"
						},
						"7": {
							"name": "support.function.builtin.wove"
						},
						"8": {
							"name": "variable.other.wove"
						},
						"9": {
							"name": "variable.other.member.wove"
						},
						"10": {
							"patterns": [{ "include": "#receiver-operations" }]
						},
						"11": {
							"name": "keyword.control.wove"
						}
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.wove",
					"begin": "(\")",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.wove"
						}
					},
					"end": "(\")|(?=$)",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.wove"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.wove",
							"match": "\\\\(?:[\"\\\\/bfnrt0]|u[0-9A-Fa-f]{4})"
						}
					]
				},
				{
					"name": "string.quoted.single.wove",
					"begin": "(')",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.wove"
						}
					},
					"end": "(')|(?=$)",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.wove"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.wove",
							"match": "\\\\(?:[0abtnvfr'\\\\]|x[0-9A-Fa-f]{2})"
						}
					]
				},
				{
					"name": "string.quoted.other.raw.wove",
					"begin": "(`)",
					"beginCaptures": {
						"1": {
							"name": "punctuation.definition.string.begin.wove"
						}
					},
					"end": "(`)(?!`)",
					"endCaptures": {
						"1": {
							"name": "punctuation.definition.string.end.wove"
						}
					},
					"patterns": [
						{
							"name": "constant.character.escape.wove",
							"match": "``"
						}
					]
				}
			]
		},
		"literals": {
			"patterns": [
				{
					"name": "constant.numeric.float.wove",
					"match": "-?[0-9]+(?:(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)(?:f(?:16|32|64|80|128))?|f(?:16|32|64|80|128))(?=$|[\\s()\"'`;])"
				},
				{
					"name": "constant.numeric.integer.wove",
					"match": "-?(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|[0-9](?:_?[0-9])*)(?:[iu](?:8|16|32|64|128|256))?(?=$|[\\s()\"'`;])"
				}
			]
		},
		"atoms": {
			"comment": "Consume any remaining atom whole so an invalid spelling cannot accidentally color only a suffix.",
			"patterns": [
				{
					"name": "storage.type.wove",
					"match": "(?:[iu](?:8|16|32|64|128|256)|f(?:16|32|64|80|128)|bool|void)(?=$|[\\s()\"'`;])"
				},
				{
					"name": "variable.other.wove",
					"match": "[A-Za-z_][A-Za-z0-9_]*(?=$|[\\s()\"'`;])"
				},
				{
					"match": "[^\\s()\"'`;]+"
				}
			]
		}
	}
}
